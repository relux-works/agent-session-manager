{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c605","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":349,"recorded_at":1780531400000693,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"task_stream":{"kind":"task","id":"01a087d3-4fea-74b2-b2f3-b0d5063be36b"},"task_id":"01a087d3-4fea-74b2-b2f3-b0d5063be36b","event":{"kind":"output","task_id":"01a087d3-4fea-74b2-b2f3-b0d5063be36b","chunk":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|)\n61|\n62|// PeerIndex binds a peer identity to its already persisted learned index.\n63|// Transport/authentication and installing peer indexes are upstream owners;\n64|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n65|type PeerIndex struct {\n66|\tHostID string\n67|\tRepo   *sessrepo.Repository\n68|}\n69|\n70|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n71|// configuration layer, separately from the learned indexes. An unlisted source\n72|// is never read. Failed reads from listed sources are errors, never\n73|// empty indexes that let resolution fall through to a lower-priority UUID.\n74|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n75|//\n76|// Aliases carries the exact configured peer-alias mapping (host ID to\n77|// alias) from the same configuration owner, kept separate from the\n78|// learned index handles: a mapping without a handle contributes no\n79|// learned names, and a handle without a mapping stays reachable through\n80|// the bare union and the \"id:\" host form but never through \"peer:\".\n81|// Alias comparison is always exact, never folded, trimmed, or decoded.\n82|type Reader struct {\n83|\tLocal              *sessrepo.Repository\n84|\tLocalHostID        string\n85|\tAllowlistedPeerIDs []string\n86|\tPeers              []PeerIndex\n87|\tAliases            map[string]string\n88|}\n89|\n90|// Summary contains only facts derived from verified session records and events.\n91|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n92|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n93|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n94|// process liveness and sync timestamps require their respective observation\n95|// owners and are deliberately not inferred from a record or a successful read.\n96|type Summary struct {\n97|\tProjection sessstate.Projection\n98|}\n99|\n100|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n101|// visible with their blocking reason and retry; failure to enumerate the index\n102|// fails the read. No durable state is written, even for an interrupted create.\n103|func (reader *Reader) List() ([]Summary, error) {\n104|\tif reader == nil || reader.Local == nil {\n105|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n106|\t}\n107|\treturn reader.read(reader.Local)\n108|}\n109|\n110|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n111|\trows, err := repo.ListSessions()\n112|\tif err != nil {\n113|\t\treturn nil, err\n114|\t}\n115|\tout := make([]Summary, 0, len(rows))\n116|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n117|\tfor _, row := range rows {\n118|\t\tprojection, err := projector.Project(row.SessionID)\n119|\t\tif err != nil {\n120|\t\t\treturn nil, err\n121|\t\t}\n122|\t\tout = append(out, Summary{Projection: projection})\n123|\t}\n124|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n125|\treturn out, nil\n126|}\n127|\n128|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n129|// the same path as Resolve, then projects from the selected repository. It\n130|// never treats a failed read as not found. Parked sessions can be inspected\n131|// by ID through InspectLocal, independently of live-name routing, so\n132|// operators retain access to the recovery diagnostics.\n133|func (reader *Reader) Status(selector string) (Summary, error) {\n134|\tselected, err := reader.Resolve(selector)\n135|\tif err != nil {\n136|\t\treturn Summary{}, err\n137|\t}\n138|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n139|\tif err != nil {\n140|\t\treturn Summary{}, err\n141|\t}\n142|\treturn Summary{Projection: projection}, nil\n143|}\n144|\n145|// InspectLocal reads one local ID, including a parked or tombstoned session.\n146|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n147|\tif reader == nil || reader.Local == nil {\n148|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n149|\t}\n150|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n151|\tif err != nil {\n152|\t\treturn Summary{}, err\n153|\t}\n154|\treturn Summary{Projection: projection}, nil\n155|}\n156|\n157|// Selection identifies the session and source index, never an attach or mutation\n158|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n159|type Selection struct {\n160|\tSessionID  string\n161|\tPeerHostID string\n162|\trepo       *sessrepo.Repository\n163|}\n164|\n165|type candidate struct {\n166|\tsummary   Summary\n167|\tselection Selection\n168|}\n169|\n170|// Resolve applies one parsed selector through the single shared path:\n171|// grammar first, then effective-configuration validation, then the\n172|// source tier. A bare selector retains the exact Section 2.3 tiers:\n173|// local exact live name, allowlisted peer exact live name, exact UUID,\n174|// not found. An \"id:\" key bypasses names for the durable UUID in the\n175|// local and allowed-peer union. A qualified selector resolves its key\n176|// in exactly one source index with no fallback. ASCII folding detects\n177|// collisions within each name tier; it does not turn a unique case\n178|// variant into an exact match. Repository-parked entries (failed reads,\n179|// never tombstone evidence) and tombstoned entries (authoritative\n180|// tombstone evidence) are not live candidates. A tier that must be\n181|// read but cannot be read is a read failure, not permission to proceed\n182|// to a lower tier. This is logical index eligibility, not proof of\n183|// process liveness or safe attach/resume readiness; those decisions\n184|// belong to the action planner invoking plans at its boundaries.\n185|func (reader *Reader) Resolve(selector string) (Selection, error) {\n186|\tparsed, err := ParseSelector(selector)\n187|\tif err != nil {\n188|\t\treturn Selection{}, err\n189|\t}\n190|\tif reader == nil || reader.Local == nil {\n191|\t\treturn Selection{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n192|\t}\n193|\tconfig, err := reader.validatedConfiguration()\n194|\tif err != nil {\n195|\t\treturn Selection{}, err\n196|\t}\n197|\tif parsed.Source != SourceBare {\n198|\t\treturn reader.resolveExplicit(parsed, config)\n199|\t}\n200|\treturn reader.resolveBare(parsed, config)\n201|}\n202|\n203|// resolveBare applies the Section 2.3 tiers over the local and\n204|// allowed-peer union. Unread lower tiers are never consulted after a\n205|// unique higher-tier match; a tier that must be read but cannot be\n206|// read fails the resolution instead of falling through.\n207|func (reader *Reader) resolveBare(parsed Selector, config validatedConfig) (Selection, error) {\n208|\tlocal, err := reader.read(reader.Local)\n209|\tif err != nil {\n210|\t\treturn Selection{}, err\n211|\t}\n212|\tlocalLive := liveCandidates(local, reader.Local, \"\")\n213|\t// Peer tiers read lazily: a unique local name match never depends\n214|\t// on lower-tier reads, but any tier that must be read and cannot\n215|\t// be read fails instead of falling through.\n216|\tpeers, peersRead := []candidate(nil), false\n217|\treadPeers := func() ([]candidate, error) {\n218|\t\tif !peersRead {\n219|\t\t\tpeersRead = true\n220|\t\t\tvar err error\n221|\t\t\tpeers, err = reader.peerCandidates()\n222|\t\t\tif err != nil {\n223|\t\t\t\treturn nil, err\n224|\t\t\t}\n225|\t\t}\n226|\t\treturn peers, nil\n227|\t}\n228|\tif parsed.IDKey {\n229|\t\tunion, err := readPeers()\n230|\t\tif err != nil {\n231|\t\t\treturn Selection{}, err\n232|\t\t}\n233|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), append(localLive, union...), config)\n234|\t}\n235|\tif match, found, err := matchName(localLive, parsed.Key); found || err != nil {\n236|\t\treturn match, err\n237|\t}\n238|\tunion, err := readPeers()\n239|\tif err != nil {\n240|\t\treturn Selection{}, err\n241|\t}\n242|\tif match, found, err := matchName(union, parsed.Key); found || err != nil {\n243|\t\tif err != nil {\n244|\t\t\treturn Selection{}, err\n245|\t\t}\n246|\t\tif err := checkRecordAgreement(append(append([]candidate(nil), localLive...), union...), match); err != nil {\n247|\t\t\treturn Selection{}, err\n248|\t\t}\n249|\t\treturn match, nil\n250|\t}\n251|\tif parsed.UUIDShaped {\n252|\t\treturn selectIdentity(parsed.Key, append(localLive, union...), config)\n253|\t}\n254|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, parsed.Raw)\n255|}\n256|\n257|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n258|\tout := make([]candidate, 0, len(rows))\n259|\tfor _, row := range rows {\n260|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n264|\t}\n265|\treturn out\n266|}\n267|\n268|// resolveExplicit selects a key in exactly one configured source index.\n269|// An explicit source never falls back to the local index, another peer,\n270|// a cached index from another source, or a union search, even when the\n271|// same name or UUID exists there: a miss in the selected source is not\n272|// found, and a source that cannot be completely read is a read failure.\n273|func (reader *Reader) resolveExplicit(parsed Selector, config validatedConfig) (Selection, error) {\n274|\trepo, peerHost, err := reader.locateSource(parsed, config)\n275|\tif err != nil {\n276|\t\treturn Selection{}, err\n277|\t}\n278|\trows, err := reader.readSource(repo, peerHost)\n279|\tif err != nil {\n280|\t\treturn Selection{}, err\n281|\t}\n282|\tlive := liveCandidates(rows, repo, peerHost)\n283|\tif parsed.IDKey {\n284|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)\n285|\t}\n286|\tif match, found, err := matchName(live, parsed.Key); found || err != nil {\n287|\t\treturn match, err\n288|\t}\n289|\tif parsed.UUIDShaped {\n290|\t\treturn selectIdentity(parsed.Key, live, config)\n291|\t}\n292|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))\n293|}\n294|\n295|// locateSource maps an explicit source to its index handle. An explicit\n296|// unknown alias or host is selector_source_not_found; a known but\n297|// disallowed peer is peer_not_allowlisted. The local source is always\n298|// admitted and needs no allowlist entry.\n299|func (reader *Reader) locateSource(parsed Selector, config validatedConfig) (*sessrepo.Repository, string, error) {\n300|\tswitch parsed.Source {\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"task_stream":{"kind":"task","id":"01a087d3-4fea-74b2-b2f3-b0d5063be36b"},"task_id":"01a087d3-4fea-74b2-b2f3-b0d5063be36b","event":{"kind":"completed","task_id":"01a087d3-4fea-74b2-b2f3-b0d5063be36b"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c609","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":351,"recorded_at":1780531400000697,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"task_stream":{"kind":"task","id":"01a087d3-5012-7811-bd08-e2cc203d5ca3"},"task_id":"01a087d3-5012-7811-bd08-e2cc203d5ca3","event":{"kind":"output","task_id":"01a087d3-5012-7811-bd08-e2cc203d5ca3","chunk":"Read text file `internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability.\n13|//\n14|// One member of the sixteen-row contract table stays unbound in this\n15|// story boundary, and the plan carries no placeholder for it: there\n16|// are no Lease Record objects in this stack, so lease_record_id has no\n17|// validated digest to bind. Authority heads bind the validated\n18|// event-head digests of the plan source only. The winning lease triple (epoch, lease ID,\n19|// owner) binds from the validated envelope derivation instead. The\n20|// lease-record runtime owns extending this binding; the plan shape\n21|// documents the exact delta so a future member without a row fails its\n22|// publication gate closed instead of falling into a default.\n23|//\n24|// Revalidation rereads the current configuration and the plan's source,\n25|// validates the same immutable record, the current winning lease, and\n26|// the action prerequisites this leaf can check, and compares every\n27|// bound plan fact in a fixed order. A changed mapping, alias,\n28|// allowlist, transport, source index, record, authority head, lease,\n29|// action, destination, or expectation invalidates the plan with\n30|// selector_plan_stale naming the first diverged member; explicit\n31|// authorization revocation returns peer_not_allowlisted; failed reads\n32|// retain their read-failure classification. Revalidation never\n33|// re-resolves by name, substitutes a same-named session, silently\n34|// replans, transfers a lease, or reuses confirmation for new facts.\n35|//\n36|// Effect authorization beyond read projection — fencing, commit,\n37|// retry, recovery, remote dispatch/admission, and transport-resume\n38|// prerequisites, and the composed per-endpoint invocation bindings —\n39|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n40|// every boundary in BoundariesFor for their action. A plan built here\n41|// authorizes read projection only.\n42|package sessquery\n43|\n44|import (\n45|\t\"fmt\"\n46|\n47|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n48|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n49|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n50|)\n51|\n52|// SelectorVersion is the exact selector contract version every plan binds.\n53|const SelectorVersion = \"1.0.0\"\n54|\n55|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n56|// an existing command/action tag; binding one selects it, never an\n57|// umbrella bypass.\n58|const (\n59|\tActionStatus      = \"status\"\n60|\tActionAttach      = \"attach\"\n61|\tActionTakeover    = \"takeover\"\n62|\tActionFork        = \"fork\"\n63|\tActionStop        = \"stop\"\n64|\tActionResume      = \"resume\"\n65|\tActionSync        = \"sync\"\n66|\tActionDiff        = \"diff\"\n67|\tActionMaterialize = \"materialize\"\n68|\tActionSetProfile  = \"session.set-profile\"\n69|\tActionLogs        = \"logs\"\n70|\tActionCancel      = \"cancel\"\n71|)\n72|\n73|// Plan boundaries from the normative action/boundary matrix. A boundary\n74|// is reached only when the existing operation reaches that phase; these\n75|// rows introduce no new effects.\n76|const (\n77|\tBoundaryProjection      = \"projection\"\n78|\tBoundaryPreEffect       = \"pre-effect\"\n79|\tBoundaryFencing         = \"fencing\"\n80|\tBoundaryCommit          = \"commit\"\n81|\tBoundaryRetry           = \"retry\"\n82|\tBoundaryRecovery        = \"recovery\"\n83|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n84|\tBoundaryRemoteAdmission = \"remote-admission\"\n85|\tBoundaryTransportResume = \"transport-resume\"\n86|)\n87|\n88|// planBoundaries is the closed action/boundary matrix: every action has\n89|// exactly its normative row, and an unknown action has none.\n90|var planBoundaries = map[string][]string{\n91|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n92|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n93|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n94|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n95|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n96|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n97|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n98|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n99|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n100|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n101|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n102|\tActionCancel:      {BoundaryProjection},\n103|}\n104|\n105|// BoundariesFor returns the required boundary classes for a plan\n106|// action. The boolean reports whether the action is a known tag; an\n107|// unknown action binds no boundary and builds no plan.\n108|func BoundariesFor(action string) ([]string, bool) {\n109|\tboundaries, ok := planBoundaries[action]\n110|\tif !ok {\n111|\t\treturn nil, false\n112|\t}\n113|\treturn append([]string(nil), boundaries...), true\n114|}\n115|\n116|// SelectionPlan is the machine-local immutable binding of one selector\n117|// resolution. All members are values, never references: there is no\n118|// mutator, and Marshal carries the locally verified canonical digest\n119|// so a persisted plan is tamper-evident. Caller-supplied digest\n120|// equality alone is never evidence of authority; only Revalidate\n121|// against current facts decides currency.\n122|type SelectionPlan struct {\n123|\t// SelectorVersion is exactly SelectorVersion.\n124|\tSelectorVersion string\n125|\t// Selector is the original single argument, at most\n126|\t// MaxSelectorRunes characters.\n127|\tSelector string\n128|\t// SessionID is the selected UUIDv7, never resolved again by name.\n129|\tSessionID string\n130|\t// SessionRecordID is the validated immutable Session Record digest.\n131|\tSessionRecordID string\n132|\t// SourceHostID is the UUIDv7 of the selected source, or empty\n133|\t// while the local host identity stays unknown.\n134|\tSourceHostID string\n135|\t// SourceAlias is the exact configured alias, or nil for local. It\n136|\t// is a diagnostic label, never identity.\n137|\tSourceAlias *string\n138|\t// SourceIndexDigest is the digest of the complete validated index\n139|\t// read used for selection.\n140|\tSourceIndexDigest string\n141|\t// ConfigurationDigest is the digest of the effective validated\n142|\t// configuration, including peer mapping, allowlist, and transport.\n143|\tConfigurationDigest string\n144|\t// LeaseEpoch, LeaseID, and OwnerHostID come from the validated\n145|\t// winning envelope lease: positive uint53, UUIDv4, and UUIDv7. All\n146|\t// three stay empty together while no winning lease is observed;\n147|\t// unknown is unknown, never a placeholder.\n148|\tLeaseEpoch  uint64\n149|\tLeaseID     string\n150|\tOwnerHostID string\n151|\t// AuthorityHeads is the sorted unique digest array of the\n152|\t// validated event heads used for the decision: the tail event\n153|\t// digest of the selected validated chain.\n154|\tAuthorityHeads []string\n155|\t// Action is the explicit command/action tag bound at build time.\n156|\tAction string\n157|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n158|\t// when the action takes no destination.\n159|\tDestinationHostID *string\n160|\t// ExpectationDigest binds the caller-declared action expectations\n161|\t// (canonically encoded JSON) for change detection. It does not\n162|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n163|\t// or confirmation contracts, which have no owners in this leaf.\n164|\tExpectationDigest string\n165|}\n166|\n167|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n168|// selector, the explicit action tag, the explicit destination (empty\n169|// for none), and the opaque caller expectations (nil for none).\n170|type PlanArgs struct {\n171|\tSelector     string\n172|\tAction       string\n173|\tDestination  string\n174|\tExpectations []byte\n175|}\n176|\n177|// BuildPlan resolves the selector once through the shared path and\n178|// binds the current facts into an immutable plan. The destination is\n179|// independently validated as a UUIDv7; expectations must be canonically\n180|// encodable JSON and bind by digest for change detection only.\n181|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n182|\tparsed, err := ParseSelector(args.Selector)\n183|\tif err != nil {\n184|\t\treturn SelectionPlan{}, err\n185|\t}\n186|\tif reader == nil || reader.Local == nil {\n187|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n188|\t}\n189|\tconfig, err := reader.validatedConfiguration()\n190|\tif err != nil {\n191|\t\treturn SelectionPlan{}, err\n192|\t}\n193|\tif _, ok := BoundariesFor(args.Action); !ok {\n194|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n195|\t}\n196|\tvar destination *string\n197|\tif args.Destination != \"\" {\n198|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n199|\t\tif err != nil {\n200|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n201|\t\t}\n202|\t\tvalue := id.String()\n203|\t\tdestination = &value\n204|\t}\n205|\texpectations, err := fingerprintExpectations(args.Expectations)\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tvar selected Selection\n210|\tif parsed.Source != SourceBare {\n211|\t\tselected, err = reader.resolveExplicit(parsed, config)\n212|\t} else {\n213|\t\tselected, err = reader.resolveBare(parsed, config)\n214|\t}\n215|\tif err != nil {\n216|\t\treturn SelectionPlan{}, err\n217|\t}\n218|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n219|}\n220|\n221|// bindPlan reads the winning source completely and binds every plan\n222|// member from validated current facts. The session is located by its\n223|// UUID in the winning source only, never re-resolved by name.\n224|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n225|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n226|\tif err != nil {\n227|\t\treturn SelectionPlan{}, err\n228|\t}\n229|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n230|\tif err != nil {\n231|\t\treturn SelectionPlan{}, err\n232|\t}\n233|\tconfiguration, err := fingerprintConfiguration(reader, config)\n234|\tif err != nil {\n235|\t\treturn SelectionPlan{}, err\n236|\t}\n237|\tvar recordID string\n238|\tfound := false\n239|\tfor _, row := range rows {\n240|\t\tif row.Projection.SessionID == selected.SessionID {\n241|\t\t\trecordID, found = row.Projection.RecordID, true\n242|\t\t\tbreak\n243|\t\t}\n244|\t}\n245|\tif !found {\n246|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n247|\t}\n248|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\ttail, err := chainTail(selected.repo, selected.SessionID)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tplan := SelectionPlan{\n257|\t\tSelectorVersion:     SelectorVersion,\n258|\t\tSelector:            parsed.Raw,\n259|\t\tSessionID:           selected.SessionID,\n260|\t\tSessionRecordID:     recordID,\n261|\t\tSourceIndexDigest:   index,\n262|\t\tConfigurationDigest: configuration,\n263|\t\tLeaseEpoch:          projection.Winner.Epoch,\n264|\t\tLeaseID:             projection.Winner.LeaseID,\n265|\t\tOwnerHostID:         projection.OwnerHostID,\n266|\t\tAction:              action,\n267|\t\tDestinationHostID:   destination,\n268|\t\tExpectationDigest:   expectations,\n269|\t}\n270|\tif selected.PeerHostID == \"\" {\n271|\t\tif config.localHost != \"\" {\n272|\t\t\tplan.SourceHostID = config.localHost\n273|\t\t}\n274|\t} else {\n275|\t\tplan.SourceHostID = selected.PeerHostID\n276|\t\t// Null marks the local source only. An alias-less peer binds\n277|\t\t// empty: the host still distinguishes it from local.\n278|\t\talias := config.aliasFor(selected.PeerHostID)\n279|\t\taliasCopy := alias\n280|\t\tplan.SourceAlias = &aliasCopy\n281|\t}\n282|\tif tail != \"\" {\n283|\t\tplan.AuthorityHeads = []string{tail}\n284|\t} else {\n285|\t\tplan.AuthorityHeads = []string{}\n286|\t}\n287|\tif err := checkPlanShapes(plan); err != nil {\n288|\t\treturn SelectionPlan{}, err\n289|\t}\n290|\treturn plan, nil\n291|}\n292|\n293|// chainTail returns the tail event digest of a validated session chain,\n294|// or empty when the chain carries no events yet.\n295|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n296|\tevents, err := repo.ListEvents(sessionID)\n297|\tif err != nil {\n298|\t\treturn \"\", err\n299|\t}\n300|\tif len(events) == 0 {\n301|\t\treturn \"\", nil\n302|\t}\n303|\treturn events[len(events)-1].EventID, nil\n304|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60b","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":352,"recorded_at":1780531400000699,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"task_stream":{"kind":"task","id":"01a087d3-5012-7811-bd08-e2cc203d5ca3"},"task_id":"01a087d3-5012-7811-bd08-e2cc203d5ca3","event":{"kind":"completed","task_id":"01a087d3-5012-7811-bd08-e2cc203d5ca3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60d","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":353,"recorded_at":1780531400000701,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"call_id":"call_01a087d34bea7170867cde9b216863f8","text":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|)\n61|\n62|// PeerIndex binds a peer identity to its already persisted learned index.\n63|// Transport/authentication and installing peer indexes are upstream owners;\n64|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n65|type PeerIndex struct {\n66|\tHostID string\n67|\tRepo   *sessrepo.Repository\n68|}\n69|\n70|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n71|// configuration layer, separately from the learned indexes. An unlisted source\n72|// is never read. Failed reads from listed sources are errors, never\n73|// empty indexes that let resolution fall through to a lower-priority UUID.\n74|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n75|//\n76|// Aliases carries the exact configured peer-alias mapping (host ID to\n77|// alias) from the same configuration owner, kept separate from the\n78|// learned index handles: a mapping without a handle contributes no\n79|// learned names, and a handle without a mapping stays reachable through\n80|// the bare union and the \"id:\" host form but never through \"peer:\".\n81|// Alias comparison is always exact, never folded, trimmed, or decoded.\n82|type Reader struct {\n83|\tLocal              *sessrepo.Repository\n84|\tLocalHostID        string\n85|\tAllowlistedPeerIDs []string\n86|\tPeers              []PeerIndex\n87|\tAliases            map[string]string\n88|}\n89|\n90|// Summary contains only facts derived from verified session records and events.\n91|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n92|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n93|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n94|// process liveness and sync timestamps require their respective observation\n95|// owners and are deliberately not inferred from a record or a successful read.\n96|type Summary struct {\n97|\tProjection sessstate.Projection\n98|}\n99|\n100|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n101|// visible with their blocking reason and retry; failure to enumerate the index\n102|// fails the read. No durable state is written, even for an interrupted create.\n103|func (reader *Reader) List() ([]Summary, error) {\n104|\tif reader == nil || reader.Local == nil {\n105|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n106|\t}\n107|\treturn reader.read(reader.Local)\n108|}\n109|\n110|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n111|\trows, err := repo.ListSessions()\n112|\tif err != nil {\n113|\t\treturn nil, err\n114|\t}\n115|\tout := make([]Summary, 0, len(rows))\n116|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n117|\tfor _, row := range rows {\n118|\t\tprojection, err := projector.Project(row.SessionID)\n119|\t\tif err != nil {\n120|\t\t\treturn nil, err\n121|\t\t}\n122|\t\tout = append(out, Summary{Projection: projection})\n123|\t}\n124|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n125|\treturn out, nil\n126|}\n127|\n128|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n129|// the same path as Resolve, then projects from the selected repository. It\n130|// never treats a failed read as not found. Parked sessions can be inspected\n131|// by ID through InspectLocal, independently of live-name routing, so\n132|// operators retain access to the recovery diagnostics.\n133|func (reader *Reader) Status(selector string) (Summary, error) {\n134|\tselected, err := reader.Resolve(selector)\n135|\tif err != nil {\n136|\t\treturn Summary{}, err\n137|\t}\n138|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n139|\tif err != nil {\n140|\t\treturn Summary{}, err\n141|\t}\n142|\treturn Summary{Projection: projection}, nil\n143|}\n144|\n145|// InspectLocal reads one local ID, including a parked or tombstoned session.\n146|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n147|\tif reader == nil || reader.Local == nil {\n148|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n149|\t}\n150|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n151|\tif err != nil {\n152|\t\treturn Summary{}, err\n153|\t}\n154|\treturn Summary{Projection: projection}, nil\n155|}\n156|\n157|// Selection identifies the session and source index, never an attach or mutation\n158|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n159|type Selection struct {\n160|\tSessionID  string\n161|\tPeerHostID string\n162|\trepo       *sessrepo.Repository\n163|}\n164|\n165|type candidate struct {\n166|\tsummary   Summary\n167|\tselection Selection\n168|}\n169|\n170|// Resolve applies one parsed selector through the single shared path:\n171|// grammar first, then effective-configuration validation, then the\n172|// source tier. A bare selector retains the exact Section 2.3 tiers:\n173|// local exact live name, allowlisted peer exact live name, exact UUID,\n174|// not found. An \"id:\" key bypasses names for the durable UUID in the\n175|// local and allowed-peer union. A qualified selector resolves its key\n176|// in exactly one source index with no fallback. ASCII folding detects\n177|// collisions within each name tier; it does not turn a unique case\n178|// variant into an exact match. Repository-parked entries (failed reads,\n179|// never tombstone evidence) and tombstoned entries (authoritative\n180|// tombstone evidence) are not live candidates. A tier that must be\n181|// read but cannot be read is a read failure, not permission to proceed\n182|// to a lower tier. This is logical index eligibility, not proof of\n183|// process liveness or safe attach/resume readiness; those decisions\n184|// belong to the action planner invoking plans at its boundaries.\n185|func (reader *Reader) Resolve(selector string) (Selection, error) {\n186|\tparsed, err := ParseSelector(selector)\n187|\tif err != nil {\n188|\t\treturn Selection{}, err\n189|\t}\n190|\tif reader == nil || reader.Local == nil {\n191|\t\treturn Selection{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n192|\t}\n193|\tconfig, err := reader.validatedConfiguration()\n194|\tif err != nil {\n195|\t\treturn Selection{}, err\n196|\t}\n197|\tif parsed.Source != SourceBare {\n198|\t\treturn reader.resolveExplicit(parsed, config)\n199|\t}\n200|\treturn reader.resolveBare(parsed, config)\n201|}\n202|\n203|// resolveBare applies the Section 2.3 tiers over the local and\n204|// allowed-peer union. Unread lower tiers are never consulted after a\n205|// unique higher-tier match; a tier that must be read but cannot be\n206|// read fails the resolution instead of falling through.\n207|func (reader *Reader) resolveBare(parsed Selector, config validatedConfig) (Selection, error) {\n208|\tlocal, err := reader.read(reader.Local)\n209|\tif err != nil {\n210|\t\treturn Selection{}, err\n211|\t}\n212|\tlocalLive := liveCandidates(local, reader.Local, \"\")\n213|\t// Peer tiers read lazily: a unique local name match never depends\n214|\t// on lower-tier reads, but any tier that must be read and cannot\n215|\t// be read fails instead of falling through.\n216|\tpeers, peersRead := []candidate(nil), false\n217|\treadPeers := func() ([]candidate, error) {\n218|\t\tif !peersRead {\n219|\t\t\tpeersRead = true\n220|\t\t\tvar err error\n221|\t\t\tpeers, err = reader.peerCandidates()\n222|\t\t\tif err != nil {\n223|\t\t\t\treturn nil, err\n224|\t\t\t}\n225|\t\t}\n226|\t\treturn peers, nil\n227|\t}\n228|\tif parsed.IDKey {\n229|\t\tunion, err := readPeers()\n230|\t\tif err != nil {\n231|\t\t\treturn Selection{}, err\n232|\t\t}\n233|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), append(localLive, union...), config)\n234|\t}\n235|\tif match, found, err := matchName(localLive, parsed.Key); found || err != nil {\n236|\t\treturn match, err\n237|\t}\n238|\tunion, err := readPeers()\n239|\tif err != nil {\n240|\t\treturn Selection{}, err\n241|\t}\n242|\tif match, found, err := matchName(union, parsed.Key); found || err != nil {\n243|\t\tif err != nil {\n244|\t\t\treturn Selection{}, err\n245|\t\t}\n246|\t\tif err := checkRecordAgreement(append(append([]candidate(nil), localLive...), union...), match); err != nil {\n247|\t\t\treturn Selection{}, err\n248|\t\t}\n249|\t\treturn match, nil\n250|\t}\n251|\tif parsed.UUIDShaped {\n252|\t\treturn selectIdentity(parsed.Key, append(localLive, union...), config)\n253|\t}\n254|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, parsed.Raw)\n255|}\n256|\n257|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n258|\tout := make([]candidate, 0, len(rows))\n259|\tfor _, row := range rows {\n260|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n264|\t}\n265|\treturn out\n266|}\n267|\n268|// resolveExplicit selects a key in exactly one configured source index.\n269|// An explicit source never falls back to the local index, another peer,\n270|// a cached index from another source, or a union search, even when the\n271|// same name or UUID exists there: a miss in the selected source is not\n272|// found, and a source that cannot be completely read is a read failure.\n273|func (reader *Reader) resolveExplicit(parsed Selector, config validatedConfig) (Selection, error) {\n274|\trepo, peerHost, err := reader.locateSource(parsed, config)\n275|\tif err != nil {\n276|\t\treturn Selection{}, err\n277|\t}\n278|\trows, err := reader.readSource(repo, peerHost)\n279|\tif err != nil {\n280|\t\treturn Selection{}, err\n281|\t}\n282|\tlive := liveCandidates(rows, repo, peerHost)\n283|\tif parsed.IDKey {\n284|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)\n285|\t}\n286|\tif match, found, err := matchName(live, parsed.Key); found || err != nil {\n287|\t\treturn match, err\n288|\t}\n289|\tif parsed.UUIDShaped {\n290|\t\treturn selectIdentity(parsed.Key, live, config)\n291|\t}\n292|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))\n293|}\n294|\n295|// locateSource maps an explicit source to its index handle. An explicit\n296|// unknown alias or host is selector_source_not_found; a known but\n297|// disallowed peer is peer_not_allowlisted. The local source is always\n298|// admitted and needs no allowlist entry.\n299|func (reader *Reader) locateSource(parsed Selector, config validatedConfig) (*sessrepo.Repository, string, error) {\n300|\tswitch parsed.Source {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60f","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":354,"recorded_at":1780531400000703,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"call_id":"call_01a087d34c807a10931a70ee0bc09884","text":"Read text file `internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability.\n13|//\n14|// One member of the sixteen-row contract table stays unbound in this\n15|// story boundary, and the plan carries no placeholder for it: there\n16|// are no Lease Record objects in this stack, so lease_record_id has no\n17|// validated digest to bind. Authority heads bind the validated\n18|// event-head digests of the plan source only. The winning lease triple (epoch, lease ID,\n19|// owner) binds from the validated envelope derivation instead. The\n20|// lease-record runtime owns extending this binding; the plan shape\n21|// documents the exact delta so a future member without a row fails its\n22|// publication gate closed instead of falling into a default.\n23|//\n24|// Revalidation rereads the current configuration and the plan's source,\n25|// validates the same immutable record, the current winning lease, and\n26|// the action prerequisites this leaf can check, and compares every\n27|// bound plan fact in a fixed order. A changed mapping, alias,\n28|// allowlist, transport, source index, record, authority head, lease,\n29|// action, destination, or expectation invalidates the plan with\n30|// selector_plan_stale naming the first diverged member; explicit\n31|// authorization revocation returns peer_not_allowlisted; failed reads\n32|// retain their read-failure classification. Revalidation never\n33|// re-resolves by name, substitutes a same-named session, silently\n34|// replans, transfers a lease, or reuses confirmation for new facts.\n35|//\n36|// Effect authorization beyond read projection — fencing, commit,\n37|// retry, recovery, remote dispatch/admission, and transport-resume\n38|// prerequisites, and the composed per-endpoint invocation bindings —\n39|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n40|// every boundary in BoundariesFor for their action. A plan built here\n41|// authorizes read projection only.\n42|package sessquery\n43|\n44|import (\n45|\t\"fmt\"\n46|\n47|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n48|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n49|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n50|)\n51|\n52|// SelectorVersion is the exact selector contract version every plan binds.\n53|const SelectorVersion = \"1.0.0\"\n54|\n55|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n56|// an existing command/action tag; binding one selects it, never an\n57|// umbrella bypass.\n58|const (\n59|\tActionStatus      = \"status\"\n60|\tActionAttach      = \"attach\"\n61|\tActionTakeover    = \"takeover\"\n62|\tActionFork        = \"fork\"\n63|\tActionStop        = \"stop\"\n64|\tActionResume      = \"resume\"\n65|\tActionSync        = \"sync\"\n66|\tActionDiff        = \"diff\"\n67|\tActionMaterialize = \"materialize\"\n68|\tActionSetProfile  = \"session.set-profile\"\n69|\tActionLogs        = \"logs\"\n70|\tActionCancel      = \"cancel\"\n71|)\n72|\n73|// Plan boundaries from the normative action/boundary matrix. A boundary\n74|// is reached only when the existing operation reaches that phase; these\n75|// rows introduce no new effects.\n76|const (\n77|\tBoundaryProjection      = \"projection\"\n78|\tBoundaryPreEffect       = \"pre-effect\"\n79|\tBoundaryFencing         = \"fencing\"\n80|\tBoundaryCommit          = \"commit\"\n81|\tBoundaryRetry           = \"retry\"\n82|\tBoundaryRecovery        = \"recovery\"\n83|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n84|\tBoundaryRemoteAdmission = \"remote-admission\"\n85|\tBoundaryTransportResume = \"transport-resume\"\n86|)\n87|\n88|// planBoundaries is the closed action/boundary matrix: every action has\n89|// exactly its normative row, and an unknown action has none.\n90|var planBoundaries = map[string][]string{\n91|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n92|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n93|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n94|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n95|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n96|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n97|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n98|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n99|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n100|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n101|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n102|\tActionCancel:      {BoundaryProjection},\n103|}\n104|\n105|// BoundariesFor returns the required boundary classes for a plan\n106|// action. The boolean reports whether the action is a known tag; an\n107|// unknown action binds no boundary and builds no plan.\n108|func BoundariesFor(action string) ([]string, bool) {\n109|\tboundaries, ok := planBoundaries[action]\n110|\tif !ok {\n111|\t\treturn nil, false\n112|\t}\n113|\treturn append([]string(nil), boundaries...), true\n114|}\n115|\n116|// SelectionPlan is the machine-local immutable binding of one selector\n117|// resolution. All members are values, never references: there is no\n118|// mutator, and Marshal carries the locally verified canonical digest\n119|// so a persisted plan is tamper-evident. Caller-supplied digest\n120|// equality alone is never evidence of authority; only Revalidate\n121|// against current facts decides currency.\n122|type SelectionPlan struct {\n123|\t// SelectorVersion is exactly SelectorVersion.\n124|\tSelectorVersion string\n125|\t// Selector is the original single argument, at most\n126|\t// MaxSelectorRunes characters.\n127|\tSelector string\n128|\t// SessionID is the selected UUIDv7, never resolved again by name.\n129|\tSessionID string\n130|\t// SessionRecordID is the validated immutable Session Record digest.\n131|\tSessionRecordID string\n132|\t// SourceHostID is the UUIDv7 of the selected source, or empty\n133|\t// while the local host identity stays unknown.\n134|\tSourceHostID string\n135|\t// SourceAlias is the exact configured alias, or nil for local. It\n136|\t// is a diagnostic label, never identity.\n137|\tSourceAlias *string\n138|\t// SourceIndexDigest is the digest of the complete validated index\n139|\t// read used for selection.\n140|\tSourceIndexDigest string\n141|\t// ConfigurationDigest is the digest of the effective validated\n142|\t// configuration, including peer mapping, allowlist, and transport.\n143|\tConfigurationDigest string\n144|\t// LeaseEpoch, LeaseID, and OwnerHostID come from the validated\n145|\t// winning envelope lease: positive uint53, UUIDv4, and UUIDv7. All\n146|\t// three stay empty together while no winning lease is observed;\n147|\t// unknown is unknown, never a placeholder.\n148|\tLeaseEpoch  uint64\n149|\tLeaseID     string\n150|\tOwnerHostID string\n151|\t// AuthorityHeads is the sorted unique digest array of the\n152|\t// validated event heads used for the decision: the tail event\n153|\t// digest of the selected validated chain.\n154|\tAuthorityHeads []string\n155|\t// Action is the explicit command/action tag bound at build time.\n156|\tAction string\n157|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n158|\t// when the action takes no destination.\n159|\tDestinationHostID *string\n160|\t// ExpectationDigest binds the caller-declared action expectations\n161|\t// (canonically encoded JSON) for change detection. It does not\n162|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n163|\t// or confirmation contracts, which have no owners in this leaf.\n164|\tExpectationDigest string\n165|}\n166|\n167|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n168|// selector, the explicit action tag, the explicit destination (empty\n169|// for none), and the opaque caller expectations (nil for none).\n170|type PlanArgs struct {\n171|\tSelector     string\n172|\tAction       string\n173|\tDestination  string\n174|\tExpectations []byte\n175|}\n176|\n177|// BuildPlan resolves the selector once through the shared path and\n178|// binds the current facts into an immutable plan. The destination is\n179|// independently validated as a UUIDv7; expectations must be canonically\n180|// encodable JSON and bind by digest for change detection only.\n181|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n182|\tparsed, err := ParseSelector(args.Selector)\n183|\tif err != nil {\n184|\t\treturn SelectionPlan{}, err\n185|\t}\n186|\tif reader == nil || reader.Local == nil {\n187|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n188|\t}\n189|\tconfig, err := reader.validatedConfiguration()\n190|\tif err != nil {\n191|\t\treturn SelectionPlan{}, err\n192|\t}\n193|\tif _, ok := BoundariesFor(args.Action); !ok {\n194|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n195|\t}\n196|\tvar destination *string\n197|\tif args.Destination != \"\" {\n198|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n199|\t\tif err != nil {\n200|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n201|\t\t}\n202|\t\tvalue := id.String()\n203|\t\tdestination = &value\n204|\t}\n205|\texpectations, err := fingerprintExpectations(args.Expectations)\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tvar selected Selection\n210|\tif parsed.Source != SourceBare {\n211|\t\tselected, err = reader.resolveExplicit(parsed, config)\n212|\t} else {\n213|\t\tselected, err = reader.resolveBare(parsed, config)\n214|\t}\n215|\tif err != nil {\n216|\t\treturn SelectionPlan{}, err\n217|\t}\n218|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n219|}\n220|\n221|// bindPlan reads the winning source completely and binds every plan\n222|// member from validated current facts. The session is located by its\n223|// UUID in the winning source only, never re-resolved by name.\n224|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n225|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n226|\tif err != nil {\n227|\t\treturn SelectionPlan{}, err\n228|\t}\n229|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n230|\tif err != nil {\n231|\t\treturn SelectionPlan{}, err\n232|\t}\n233|\tconfiguration, err := fingerprintConfiguration(reader, config)\n234|\tif err != nil {\n235|\t\treturn SelectionPlan{}, err\n236|\t}\n237|\tvar recordID string\n238|\tfound := false\n239|\tfor _, row := range rows {\n240|\t\tif row.Projection.SessionID == selected.SessionID {\n241|\t\t\trecordID, found = row.Projection.RecordID, true\n242|\t\t\tbreak\n243|\t\t}\n244|\t}\n245|\tif !found {\n246|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n247|\t}\n248|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\ttail, err := chainTail(selected.repo, selected.SessionID)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tplan := SelectionPlan{\n257|\t\tSelectorVersion:     SelectorVersion,\n258|\t\tSelector:            parsed.Raw,\n259|\t\tSessionID:           selected.SessionID,\n260|\t\tSessionRecordID:     recordID,\n261|\t\tSourceIndexDigest:   index,\n262|\t\tConfigurationDigest: configuration,\n263|\t\tLeaseEpoch:          projection.Winner.Epoch,\n264|\t\tLeaseID:             projection.Winner.LeaseID,\n265|\t\tOwnerHostID:         projection.OwnerHostID,\n266|\t\tAction:              action,\n267|\t\tDestinationHostID:   destination,\n268|\t\tExpectationDigest:   expectations,\n269|\t}\n270|\tif selected.PeerHostID == \"\" {\n271|\t\tif config.localHost != \"\" {\n272|\t\t\tplan.SourceHostID = config.localHost\n273|\t\t}\n274|\t} else {\n275|\t\tplan.SourceHostID = selected.PeerHostID\n276|\t\t// Null marks the local source only. An alias-less peer binds\n277|\t\t// empty: the host still distinguishes it from local.\n278|\t\talias := config.aliasFor(selected.PeerHostID)\n279|\t\taliasCopy := alias\n280|\t\tplan.SourceAlias = &aliasCopy\n281|\t}\n282|\tif tail != \"\" {\n283|\t\tplan.AuthorityHeads = []string{tail}\n284|\t} else {\n285|\t\tplan.AuthorityHeads = []string{}\n286|\t}\n287|\tif err := checkPlanShapes(plan); err != nil {\n288|\t\treturn SelectionPlan{}, err\n289|\t}\n290|\treturn plan, nil\n291|}\n292|\n293|// chainTail returns the tail event digest of a validated session chain,\n294|// or empty when the chain carries no events yet.\n295|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n296|\tevents, err := repo.ListEvents(sessionID)\n297|\tif err != nil {\n298|\t\treturn \"\", err\n299|\t}\n300|\tif len(events) == 0 {\n301|\t\treturn \"\", nil\n302|\t}\n303|\treturn events[len(events)-1].EventID, nil\n304|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
