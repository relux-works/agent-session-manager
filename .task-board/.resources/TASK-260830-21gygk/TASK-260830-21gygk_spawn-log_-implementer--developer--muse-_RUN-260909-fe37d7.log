{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a1","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":427,"recorded_at":1780531400000849,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"task_stream":{"kind":"task","id":"01a087d3-727b-7e23-ab38-23d945bbb8ac"},"task_id":"01a087d3-727b-7e23-ab38-23d945bbb8ac","event":{"kind":"output","task_id":"01a087d3-727b-7e23-ab38-23d945bbb8ac","chunk":"Read text file `internal/sessquery/bounds_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/cliresult\"\n8|)\n9|\n10|// This is a measured integration bound, not a successful public list claim.\n11|// Pinned Section 5.7 defines creating as a Session Record AND an\n12|// authoritative initial lease, and Section 13.1 step 2 persists the\n13|// initial Lease Record and session.created before process creation: a\n14|// record alone proves identity and provenance, never creation of an\n15|// owner or a creating lifecycle. A record-only chain is therefore an\n16|// interrupted persistence prefix awaiting the bootstrap-recovery leaf\n17|// (Section 14.7.4), not a completed bootstrap prefix, and the wire\n18|// owner still requires known owner/lease fields. The read layer must\n19|// not invent them to obtain green JSON, and no nullable or placeholder\n20|// owner or lease field is authorized to close the gap.\n21|func TestCreatingSummaryCannotClaimClosedCLIResult(t *testing.T) {\n22|\trepo, _ := repository(t)\n23|\tcreate(t, repo, idA, \"Creating\")\n24|\trows, err := (&Reader{Local: repo}).List()\n25|\tif err != nil || len(rows) != 1 {\n26|\t\tt.Fatalf(\"List: %+v %v\", rows, err)\n27|\t}\n28|\tp := rows[0].Projection\n29|\tbody := map[string]any{\n30|\t\t\"session_id\": p.SessionID, \"name\": p.Name, \"kind\": p.Kind, \"provider_id\": p.Provider.ID,\n31|\t\t\"owner_host_id\": p.OwnerHostID, \"owner_host_name\": \"\", \"lease_epoch\": p.Winner.Epoch, \"lease_id\": p.Winner.LeaseID,\n32|\t\t\"local_role\": p.LocalRole, \"state\": string(p.State), \"newest_checkpoint_id\": nil, \"newest_checkpoint_created_at\": nil,\n33|\t\t\"workspace_status\": \"absent\", \"capabilities\": map[string]any{}, \"warnings\": []string{},\n34|\t}\n35|\t// The fixture's absent workspace is controlled only for this shape probe;\n36|\t// it is not a production observation or a default in Reader.\n37|\tif _, err := cliresult.New(cliresult.Spec{Command: cliresult.CommandList, Body: map[string]any{\n38|\t\t\"sessions\": []any{body}, \"partial\": false, \"unreachable_peer_ids\": []string{},\n39|\t}}); !errors.Is(err, cliresult.ErrInvalidResult) {\n40|\t\tt.Fatalf(\"unknown owner represented as CLI success: %v\", err)\n41|\t}\n42|}","final_result":true}}}
