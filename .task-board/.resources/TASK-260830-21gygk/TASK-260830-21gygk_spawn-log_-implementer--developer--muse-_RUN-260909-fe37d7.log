{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"call_id":"call_01a087d3588776c186bb71f5b8bd4299","text":"Read text file `internal/sessquery/query.go`.\n(299 line(s) above)\n300|\tswitch parsed.Source {\n301|\tcase SourceLocal:\n302|\t\treturn reader.Local, \"\", nil\n303|\tcase SourcePeerAlias:\n304|\t\thost, ok := config.hostForAlias(reader, parsed.SourceValue)\n305|\t\tif !ok {\n306|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)\n307|\t\t}\n308|\t\tif _, allowed := config.allowed[host]; !allowed {\n309|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)\n310|\t\t}\n311|\t\treturn reader.peerRepo(host)\n312|\tcase SourcePeerHost:\n313|\t\tif config.localHost != \"\" && parsed.SourceValue == config.localHost {\n314|\t\t\treturn reader.Local, \"\", nil\n315|\t\t}\n316|\t\tif !knownPeer(reader, parsed.SourceValue) {\n317|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for host %s\", ErrSourceNotFound, parsed.SourceValue)\n318|\t\t}\n319|\t\tif _, allowed := config.allowed[parsed.SourceValue]; !allowed {\n320|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, parsed.SourceValue)\n321|\t\t}\n322|\t\treturn reader.peerRepo(parsed.SourceValue)\n323|\tdefault:\n324|\t\treturn nil, \"\", fmt.Errorf(\"%w: unknown selector source\", ErrInvalidArgument)\n325|\t}\n326|}\n327|\n328|// knownPeer reports whether a host carries a configured learned index,\n329|// regardless of allowlisting or readability.\n330|func knownPeer(reader *Reader, host string) bool {\n331|\tfor _, peer := range reader.Peers {\n332|\t\tif peer.HostID == host {\n333|\t\t\treturn true\n334|\t\t}\n335|\t}\n336|\treturn false\n337|}\n338|\n339|// peerRepo binds one allowlisted peer host to its learned index handle.\n340|// A peer with no advertised index cannot be completely read, so\n341|// explicit selection refuses with the read-failure class instead of\n342|// treating the source as absent; union tiers simply learn nothing from\n343|// it. A listed index with an unavailable repository is the same failed\n344|// observation.\n345|func (reader *Reader) peerRepo(host string) (*sessrepo.Repository, string, error) {\n346|\tseen := false\n347|\tvar repo *sessrepo.Repository\n348|\tfor _, peer := range reader.Peers {\n349|\t\tif peer.HostID != host {\n350|\t\t\tcontinue\n351|\t\t}\n352|\t\tif seen {\n353|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, host)\n354|\t\t}\n355|\t\tseen = true\n356|\t\trepo = peer.Repo\n357|\t}\n358|\tif !seen {\n359|\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s advertises no learned index\", ErrSourceReadFailed, host)\n360|\t}\n361|\tif repo == nil {\n362|\t\treturn nil, \"\", peerReadFailed(host, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, host))\n363|\t}\n364|\treturn repo, host, nil\n365|}\n366|\n367|// readSource completes one source read. Local I-O failures keep their\n368|// repository error; remote failures carry the read-failure class while\n369|// preserving the underlying cause for errors.Is.\n370|func (reader *Reader) readSource(repo *sessrepo.Repository, peerHost string) ([]Summary, error) {\n371|\trows, err := reader.read(repo)\n372|\tif err != nil {\n373|\t\tif peerHost == \"\" {\n374|\t\t\treturn nil, err\n375|\t\t}\n376|\t\treturn nil, peerReadFailed(peerHost, err)\n377|\t}\n378|\treturn rows, nil\n379|}\n380|\n381|// peerReadFailed marks a remote-source read failure with its contract\n382|// class while preserving the underlying cause: a failed read is never\n383|// an absence that lets resolution fall through to another source.\n384|func peerReadFailed(host string, err error) error {\n385|\treturn errors.Join(fmt.Errorf(\"%w: peer %s index read failed\", ErrSourceReadFailed, host), err)\n386|}\n387|\n388|// describeSource names the selected source for refusal evidence: exact\n389|// literal alias or host, never a display name.\n390|func describeSource(parsed Selector) string {\n391|\tswitch parsed.Source {\n392|\tcase SourceLocal:\n393|\t\treturn \"local\"\n394|\tcase SourcePeerAlias:\n395|\t\treturn fmt.Sprintf(\"peer:%s\", parsed.SourceValue)\n396|\tcase SourcePeerHost:\n397|\t\treturn fmt.Sprintf(\"id:%s\", parsed.SourceValue)\n398|\tdefault:\n399|\t\treturn \"bare\"\n400|\t}\n401|}\n402|\n403|// selectIdentity selects a durable session UUID from live candidates\n404|// independent of names: the \"id:\" key form and the UUID tier. Copies\n405|// of one UUID deduplicate only when their immutable record digests\n406|// agree; disagreeing copies are inconsistent authority\n407|// (integrity_failure), not an ambiguity. Identical copies select the\n408|// bytewise smallest holder host.\n409|func selectIdentity(uuid string, pool []candidate, config validatedConfig) (Selection, error) {\n410|\tid, err := scalar.ParseUUIDv7(uuid)\n411|\tif err != nil {\n412|\t\treturn Selection{}, fmt.Errorf(\"%w: malformed session UUID: %v\", ErrInvalidArgument, err)\n413|\t}\n414|\tvar matches []candidate\n415|\tfor _, item := range pool {\n416|\t\tif item.selection.SessionID == id.String() {\n417|\t\t\tmatches = append(matches, item)\n418|\t\t}\n419|\t}\n420|\tif len(matches) == 0 {\n421|\t\treturn Selection{}, fmt.Errorf(\"%w: no live session with ID %q\", ErrNotFound, id.String())\n422|\t}\n423|\tfor _, item := range matches[1:] {\n424|\t\tif item.summary.Projection.RecordID != matches[0].summary.Projection.RecordID {\n425|\t\t\treturn Selection{}, fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, id.String())\n426|\t\t}\n427|\t}\n428|\tbest := matches[0]\n429|\tfor _, item := range matches[1:] {\n430|\t\tif holderHost(item.selection.PeerHostID, config.localHost) < holderHost(best.selection.PeerHostID, config.localHost) {\n431|\t\t\tbest = item\n432|\t\t}\n433|\t}\n434|\treturn best.selection, nil\n435|}\n436|\n437|// holderHost orders copy holders bytewise for the deterministic tie\n438|// break. PeerHostID is empty for local copies; while the local host\n439|// identity is unknown the local copy sorts before every peer,\n440|// preserving local priority there.\n441|func holderHost(peerHost, localHost string) string {\n442|\tif peerHost == \"\" {\n443|\t\tif localHost == \"\" {\n444|\t\t\treturn \"\"\n445|\t\t}\n446|\t\treturn localHost\n447|\t}\n448|\treturn peerHost\n449|}\n450|\n451|// checkRecordAgreement refuses inconsistent authority behind a name\n452|// match: every consulted live copy of the won UUID must carry the same\n453|// immutable record digest. Replicated identical copies stay one\n454|// identity; disagreeing copies are integrity failure, not ambiguity.\n455|func checkRecordAgreement(pool []candidate, won Selection) error {\n456|\tdigest := \"\"\n457|\tseen := false\n458|\tfor _, item := range pool {\n459|\t\tif item.selection.SessionID != won.SessionID {\n460|\t\t\tcontinue\n461|\t\t}\n462|\t\tif !seen {\n463|\t\t\tdigest, seen = item.summary.Projection.RecordID, true\n464|\t\t\tcontinue\n465|\t\t}\n466|\t\tif item.summary.Projection.RecordID != digest {\n467|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, won.SessionID)\n468|\t\t}\n469|\t}\n470|\treturn nil\n471|}\n472|\n473|func (reader *Reader) peerCandidates() ([]candidate, error) {\n474|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n475|\tsort.Strings(ids)\n476|\tvar out []candidate\n477|\tfor index, id := range ids {\n478|\t\tif index > 0 && id == ids[index-1] {\n479|\t\t\tcontinue\n480|\t\t}\n481|\t\tvar repo *sessrepo.Repository\n482|\t\tfound := false\n483|\t\tfor _, peer := range reader.Peers {\n484|\t\t\tif peer.HostID != id {\n485|\t\t\t\tcontinue\n486|\t\t\t}\n487|\t\t\tif found {\n488|\t\t\t\treturn nil, fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, id)\n489|\t\t\t}\n490|\t\t\tfound = true\n491|\t\t\trepo = peer.Repo\n492|\t\t}\n493|\t\t// An allowlisted peer with no learned index contributes no learned names.\n494|\t\t// A listed index with an unavailable repository is a failed observation.\n495|\t\tif !found {\n496|\t\t\tcontinue\n497|\t\t}\n498|\t\tif repo == nil {\n499|\t\t\treturn nil, peerReadFailed(id, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, id))\n500|\t\t}\n501|\t\trows, err := reader.read(repo)\n502|\t\tif err != nil {\n503|\t\t\treturn nil, peerReadFailed(id, err)\n504|\t\t}\n505|\t\tout = append(out, liveCandidates(rows, repo, id)...)\n506|\t}\n507|\treturn out, nil\n508|}\n509|\n510|func matchName(items []candidate, selector string) (Selection, bool, error) {\n511|\t// A replicated session is one identity, regardless of how many peers learned\n512|\t// it. Distinct session IDs in the folded bucket are an ambiguity.\n513|\tids := make(map[string]struct{})\n514|\tvar exact *Selection\n515|\tfor _, item := range items {\n516|\t\tif asciiFold(item.summary.Projection.Name) != asciiFold(selector) {\n517|\t\t\tcontinue\n518|\t\t}\n519|\t\tids[item.selection.SessionID] = struct{}{}\n520|\t\tif item.summary.Projection.Name == selector && exact == nil {\n521|\t\t\tselection := item.selection\n522|\t\t\texact = &selection\n523|\t\t}\n524|\t}\n525|\tif len(ids) > 1 {\n526|\t\treturn Selection{}, false, fmt.Errorf(\"%w: name %q collides across %d sessions\", ErrAmbiguous, selector, len(ids))\n527|\t}\n528|\tif exact != nil {\n529|\t\treturn *exact, true, nil\n530|\t}\n531|\treturn Selection{}, false, nil\n532|}\n533|\n534|func asciiFold(value string) string {\n535|\tfolded := []byte(value)\n536|\tfor index, character := range folded {\n537|\t\tif character >= 'A' && character <= 'Z' {\n538|\t\t\tfolded[index] += 'a' - 'A'\n539|\t\t}\n540|\t}\n541|\treturn string(folded)\n542|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65f","stream":{"kind":"session","id":"01a087d2-9daf-73e3-b07e-db877510bb42"},"sequence":394,"recorded_at":1780531400000783,"record_type":"event","durability":"durable","causation_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"fda6e67f-23f9-4e20-b038-550a69885ec5","run_stream":{"kind":"run","id":"fda6e67f-23f9-4e20-b038-550a69885ec5"},"call_id":"call_01a087d359947c1286a88e9325271f43","text":"Read text file `internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation and\n6|// failures): caller shapes, current configuration validation,\n7|// authorization revocation, source binding, configuration digest,\n8|// source read, selection absence, current projection, session record,\n9|// winning lease, authority heads, and finally the source index digest.\n10|// Fine-grained reasons distinguish the checks without splitting the\n11|// class; tests assert both.\n12|package sessquery\n13|\n14|import (\n15|\t\"encoding/json\"\n16|\t\"fmt\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n20|)\n21|\n22|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n23|const uint53Ceiling = uint64(1<<53 - 1)\n24|\n25|// Revalidate compares every bound plan fact against current\n26|// configuration and freshly reread source data. The session is located\n27|// by its UUID in the plan's source only, never re-resolved by name. A\n28|// nil return means the plan is current; any error classifies exactly:\n29|// selector_plan_stale (with the first diverged member named),\n30|// peer_not_allowlisted on explicit authorization revocation,\n31|// invalid_config on current configuration failures, invalid_arguments\n32|// on a malformed caller plan, and the read or projection failure class\n33|// when a required read or validation fails.\n34|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n35|\tif err := checkPlanShapes(plan); err != nil {\n36|\t\treturn err\n37|\t}\n38|\tif reader == nil || reader.Local == nil {\n39|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n40|\t}\n41|\tconfig, err := reader.validatedConfiguration()\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tpeerHost, isPeer := planSourceBinding(plan, config)\n46|\tif isPeer {\n47|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n48|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n49|\t\t}\n50|\t}\n51|\tif !bindingHolds(plan, config, reader) {\n52|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n53|\t}\n54|\tconfiguration, err := fingerprintConfiguration(reader, config)\n55|\tif err != nil {\n56|\t\treturn err\n57|\t}\n58|\tif configuration != plan.ConfigurationDigest {\n59|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n60|\t}\n61|\tvar repo = reader.Local\n62|\tsourcePeer := \"\"\n63|\tif isPeer {\n64|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n65|\t\tif err != nil {\n66|\t\t\treturn err\n67|\t\t}\n68|\t}\n69|\trows, err := reader.readSource(repo, sourcePeer)\n70|\tif err != nil {\n71|\t\treturn err\n72|\t}\n73|\tvar recordID string\n74|\tabsent := true\n75|\tfor _, row := range rows {\n76|\t\tif row.Projection.SessionID == plan.SessionID {\n77|\t\t\trecordID, absent = row.Projection.RecordID, false\n78|\t\t\tbreak\n79|\t\t}\n80|\t}\n81|\tif absent {\n82|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n83|\t}\n84|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n85|\tif err != nil {\n86|\t\treturn err\n87|\t}\n88|\tif recordID != plan.SessionRecordID {\n89|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n90|\t}\n91|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\n92|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n93|\t}\n94|\ttail, err := chainTail(repo, plan.SessionID)\n95|\tif err != nil {\n96|\t\tif sourcePeer == \"\" {\n97|\t\t\treturn err\n98|\t\t}\n99|\t\treturn peerReadFailed(sourcePeer, err)\n100|\t}\n101|\theads := []string{}\n102|\tif tail != \"\" {\n103|\t\theads = []string{tail}\n104|\t}\n105|\tif !equalStrings(heads, plan.AuthorityHeads) {\n106|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n107|\t}\n108|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n109|\tif err != nil {\n110|\t\treturn err\n111|\t}\n112|\tif index != plan.SourceIndexDigest {\n113|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n114|\t}\n115|\treturn nil\n116|}\n117|\n118|// planSourceBinding resolves the plan's bound source: a local plan\n119|// carries a null alias with an empty or local host, while any other\n120|// binding selects a peer source by host. The second return reports\n121|// whether the plan selects a peer source.\n122|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n123|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n124|\t\treturn \"\", false\n125|\t}\n126|\treturn plan.SourceHostID, true\n127|}\n128|\n129|// bindingHolds reports whether the plan's bound (host, alias) source\n130|// still resolves to the same source in the current configuration. A\n131|// local plan holds while its host is empty or the current local host;\n132|// a peer plan holds while its host is still a known peer carrying the\n133|// exact bound alias.\n134|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n135|\tif plan.SourceAlias == nil {\n136|\t\tif plan.SourceHostID == \"\" {\n137|\t\t\treturn true\n138|\t\t}\n139|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n140|\t\t\treturn true\n141|\t\t}\n142|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n143|\t\t\treturn true\n144|\t\t}\n145|\t\treturn false\n146|\t}\n147|\tif !knownPeer(reader, plan.SourceHostID) {\n148|\t\treturn false\n149|\t}\n150|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n151|}\n152|\n153|// equalStrings compares sorted unique string slices element-wise.\n154|func equalStrings(first, second []string) bool {\n155|\tif len(first) != len(second) {\n156|\t\treturn false\n157|\t}\n158|\tfor index := range first {\n159|\t\tif first[index] != second[index] {\n160|\t\t\treturn false\n161|\t\t}\n162|\t}\n163|\treturn true\n164|}\n165|\n166|// checkPlanShapes validates the caller-supplied plan members without\n167|// consulting any authority: exact contract version, grammatical\n168|// selector, canonical UUIDs and digests, exact alias bound, sorted\n169|// unique authority heads, a consistent lease triple (all empty while\n170|// no winning lease is observed, otherwise positive uint53 epoch with a\n171|// UUIDv4 lease and a UUIDv7 owner), a known action tag, and a null or\n172|// UUIDv7 destination. Authority comes only from Revalidate.\n173|func checkPlanShapes(plan SelectionPlan) error {\n174|\tif plan.SelectorVersion != SelectorVersion {\n175|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n176|\t}\n177|\tif _, err := ParseSelector(plan.Selector); err != nil {\n178|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n179|\t}\n180|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n181|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n182|\t}\n183|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n184|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n185|\t}\n186|\tif plan.SourceHostID != \"\" {\n187|\t\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n188|\t\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n189|\t\t}\n190|\t}\n191|\tif plan.SourceAlias != nil {\n192|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n193|\t\t\t// An alias-less peer binds empty, which never passes the\n194|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n195|\t\t\tif *plan.SourceAlias != \"\" {\n196|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n197|\t\t\t}\n198|\t\t}\n199|\t}\n200|\tfor _, member := range []struct {\n201|\t\tname   string\n202|\t\tdigest string\n203|\t}{\n204|\t\t{\"source index\", plan.SourceIndexDigest},\n205|\t\t{\"configuration\", plan.ConfigurationDigest},\n206|\t\t{\"expectation\", plan.ExpectationDigest},\n207|\t} {\n208|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n209|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n210|\t\t}\n211|\t}\n212|\t// The lease triple is all empty while no winning lease is observed;\n213|\t// otherwise the epoch is a positive uint53 with a UUIDv4 lease and a\n214|\t// UUIDv7 owner. Partial triples and placeholders are refused.\n215|\tswitch {\n216|\tcase plan.LeaseEpoch == 0 && plan.LeaseID == \"\" && plan.OwnerHostID == \"\":\n217|\tcase plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling:\n218|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n219|\tdefault:\n220|\t\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n221|\t\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n222|\t\t}\n223|\t\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n225|\t\t}\n226|\t}\n227|\tfor index, head := range plan.AuthorityHeads {\n228|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n229|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n230|\t\t}\n231|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n232|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n233|\t\t}\n234|\t}\n235|\tif _, ok := BoundariesFor(plan.Action); !ok {\n236|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n237|\t}\n238|\tif plan.DestinationHostID != nil {\n239|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n240|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n241|\t\t}\n242|\t}\n243|\treturn nil\n244|}\n245|\n246|// planWire is the tamper-evident persistence encoding: every bound\n247|// member plus the locally verified canonical digest over all of them.\n248|type planWire struct {\n249|\tSelectorVersion     string   `json:\"selector_version\"`\n250|\tSelector            string   `json:\"selector\"`\n251|\tSessionID           string   `json:\"session_id\"`\n252|\tSessionRecordID     string   `json:\"session_record_id\"`\n253|\tSourceHostID        string   `json:\"source_host_id\"`\n254|\tSourceAlias         *string  `json:\"source_alias\"`\n255|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n256|\tConfigurationDigest string   `json:\"configuration_digest\"`\n257|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n258|\tLeaseID             string   `json:\"lease_id\"`\n259|\tOwnerHostID         string   `json:\"owner_host_id\"`\n260|\tAuthorityHeads      []string `json:\"authority_heads\"`\n261|\tAction              string   `json:\"action\"`\n262|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n263|\tExpectationDigest   string   `json:\"expectation_digest\"`\n264|\tPlanDigest          string   `json:\"plan_digest\"`\n265|}\n266|\n267|// Digest returns the locally verified canonical digest over all bound\n268|// plan members. It is recomputed on every call and never trusted from\n269|// caller bytes.\n270|func (plan SelectionPlan) Digest() (string, error) {\n271|\theads := append([]string(nil), plan.AuthorityHeads...)\n272|\tif heads == nil {\n273|\t\theads = []string{}\n274|\t}\n275|\treturn fingerprint(map[string]any{\n276|\t\t\"action\":               plan.Action,\n277|\t\t\"authority_heads\":      heads,\n278|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n279|\t\t\"destination_host_id\":  plan.DestinationHostID,\n280|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n281|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n282|\t\t\"lease_id\":             plan.LeaseID,\n283|\t\t\"owner_host_id\":        plan.OwnerHostID,\n284|\t\t\"selector\":             plan.Selector,\n285|\t\t\"selector_version\":     plan.SelectorVersion,\n286|\t\t\"session_id\":           plan.SessionID,\n287|\t\t\"session_record_id\":    plan.SessionRecordID,\n288|\t\t\"source_alias\":         plan.SourceAlias,\n289|\t\t\"source_host_id\":       plan.SourceHostID,\n290|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n291|\t})\n292|}\n293|\n294|// Marshal encodes the plan with its locally verified digest. The\n295|// encoding keeps null alias and destination distinct from empty.\n296|func (plan SelectionPlan) Marshal() ([]byte, error) {\n297|\tdigest, err := plan.Digest()\n298|\tif err != nil {\n299|\t\treturn nil, err\n300|\t}\n301|\theads := append([]string(nil), plan.AuthorityHeads...)\n302|\tif heads == nil {\n303|\t\theads = []string{}\n304|\t}\n305|\treturn json.Marshal(planWire{\n306|\t\tSelectorVersion:     plan.SelectorVersion,\n307|\t\tSelector:            plan.Selector,\n308|\t\tSessionID:           plan.SessionID,\n309|\t\tSessionRecordID:     plan.SessionRecordID,\n310|\t\tSourceHostID:        plan.SourceHostID,\n311|\t\tSourceAlias:         plan.SourceAlias,\n312|\t\tSourceIndexDigest:   plan.SourceIndexDigest,\n313|\t\tConfigurationDigest: plan.ConfigurationDigest,\n314|\t\tLeaseEpoch:          plan.LeaseEpoch,\n315|\t\tLeaseID:             plan.LeaseID,\n316|\t\tOwnerHostID:         plan.OwnerHostID,\n317|\t\tAuthorityHeads:      heads,\n318|\t\tAction:              plan.Action,\n319|\t\tDestinationHostID:   plan.DestinationHostID,\n320|\t\tExpectationDigest:   plan.ExpectationDigest,\n321|\t\tPlanDigest:          digest,\n322|\t})\n323|}\n324|\n325|// ParsePlan decodes a persisted plan, validates every member shape,\n326|// and verifies the tamper-evident digest. A verified encoding is still\n327|// not authority: only Revalidate against current facts decides\n328|// currency, and digest equality alone never substitutes for it.\n329|func ParsePlan(raw []byte) (SelectionPlan, error) {\n330|\tvar wire planWire\n331|\tif err := json.Unmarshal(raw, &wire); err != nil {\n332|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed plan encoding: %v\", ErrInvalidArgument, err)\n333|\t}\n334|\tplan := SelectionPlan{\n335|\t\tSelectorVersion:     wire.SelectorVersion,\n336|\t\tSelector:            wire.Selector,\n337|\t\tSessionID:           wire.SessionID,\n338|\t\tSessionRecordID:     wire.SessionRecordID,\n339|\t\tSourceHostID:        wire.SourceHostID,\n340|\t\tSourceAlias:         wire.SourceAlias,\n341|\t\tSourceIndexDigest:   wire.SourceIndexDigest,\n342|\t\tConfigurationDigest: wire.ConfigurationDigest,\n343|\t\tLeaseEpoch:          wire.LeaseEpoch,\n344|\t\tLeaseID:             wire.LeaseID,\n345|\t\tOwnerHostID:         wire.OwnerHostID,\n346|\t\tAuthorityHeads:      wire.AuthorityHeads,\n347|\t\tAction:              wire.Action,\n348|\t\tDestinationHostID:   wire.DestinationHostID,\n349|\t\tExpectationDigest:   wire.ExpectationDigest,\n350|\t}\n351|\tif plan.AuthorityHeads == nil {\n352|\t\tplan.AuthorityHeads = []string{}\n353|\t}\n354|\tif err := checkPlanShapes(plan); err != nil {\n355|\t\treturn SelectionPlan{}, err\n356|\t}\n357|\tdigest, err := plan.Digest()\n358|\tif err != nil {\n359|\t\treturn SelectionPlan{}, err\n360|\t}\n361|\tif digest != wire.PlanDigest {\n362|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: plan digest mismatch\", ErrInvalidArgument)\n363|\t}\n364|\treturn plan, nil\n365|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
