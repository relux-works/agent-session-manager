x',selector_source,'\\\\tcase source == \\\"local\\\":','\\\\tcase strings.HasPrefix(source, \\\"local\\\"):','Admit local-prefixed sources while keeping the local token; localX then selects local.')\\n74:run('N-id-case',selector_source,'\\\\tif id, ok := strings.CutPrefix(key, \\\"id:\\\"); ok {\\\\n\\\\t\\\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','\\\\tlowered := strings.ToLower(key)\\\\n\\\\tif id, ok := strings.CutPrefix(lowered, \\\"id:\\\"); ok {\\\\n\\\\t\\\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','Fold the id: key prefix while keeping its token; ID: then bypasses names.')\\n75:run('N-peer-alias-fold',selector_source,'if config.aliasOf[peer.HostID] == alias && alias != \\\"\\\" {','if asciiFold(config.aliasOf[peer.HostID]) == asciiFold(alias) && alias != \\\"\\\" {','Fold alias comparison while keeping exact mapping storage; WORK then selects Work.')\\n76:run('N-id-through-names',source,'\\\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \\\"id:\\\"), live, config)','\\\\tif match, found, err := matchName(live, strings.TrimPrefix(parsed.Key, \\\"id:\\\")); found || err != nil {\\\\n\\\\t\\\\treturn match, err\\\\n\\\\t}\\\\n\\\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \\\"id:\\\"), live, config)','Route one explicit id: key through the name tier first; a UUID-shaped name then shadows the identity.')\\n77:run('N-explicit-fallback',source,'\\\\treturn Selection{}, fmt.Errorf(\\\"%w: no live session named %q in source %s\\\", ErrNotFound, parsed.Key, describeSource(parsed))','\\\\treturn reader.resolveBare(Selector{Raw: parsed.Raw, Key: parsed.Key, UUIDShaped: parsed.UUIDShaped, Source: SourceBare}, config)','Fall back to the bare union on exactly an explicit-source miss; a locally present name then resolves.')\\n78:run('N-unknown-alias-local',source,'\\\\t\\\\t\\\\treturn nil, \\\"\\\", fmt.Errorf(\\\"%w: no configured source for alias %q\\\", ErrSourceNotFound, parsed.SourceValue)','\\\\t\\\\t\\\\treturn reader.Local, \\\"\\\", nil','Treat exactly an unknown alias as the local source; a locally present name then resolves.')\\n79:run('N-disallowed-admit',source,'\\\\t\\\\t\\\\treturn nil, \\\"\\\", fmt.Errorf(\\\"%w: peer %s is not allowlisted\\\", ErrPeerNotAllowlisted, host)','\\\\t\\\\t\\\\treturn reader.peerRepo(host)','Admit exactly one disallowed peer past the allowlist into its index read.')\\n80:run('N-dup-alias',selector_source,'\\\\t\\\\t\\\\treturn config, fmt.Errorf(\\\"%w: duplicate source mapping for alias %q\\\", ErrInvalidConfig, alias)','\\\\t\\\\t\\\\tseenAliases[alias] = struct{}{}','Admit exactly duplicate alias mappings with last-write-wins instead of refusing them.')\\n81:run('N-rev-revocation',revalidate_source,'\\\\t\\\\tif _, allowed := config.allowed[peerHost]; !allowed {','\\\\t\\\\tif _, allowed := config.allowed[peerHost]; !allowed && false {','Skip exactly the revocation check; a revoked plan then fails as stale configuration instead of peer_not_allowlisted.')\\n82:run('N-rev-config',revalidate_source,'\\\\tif configuration != plan.ConfigurationDigest {','\\\\tif configuration != plan.ConfigurationDigest && false {','Skip exactly the configuration digest compare; an unrelated mapping change then validates.')\\n83:run('N-rev-binding',revalidate_source,'\\\\tif !bindingHolds(plan, config, reader) {','\\\\tif !bindingHolds(plan, config, reader) && false {','Skip exactly the source binding compare; a remapped alias over identical copies then validates.')\\n84:run('N-rev-index',revalidate_source,'\\\\tif index != plan.SourceIndexDigest {','\\\\tif index != plan.SourceIndexDigest && false {','Skip exactly the index digest compare; an unrelated session change then validates.')\\n85:run('N-rev-record',revalidate_source,'\\\\tif recordID != plan.SessionRecordID {','\\\\tif recordID != plan.SessionRecordID && false {','Skip exactly the record compare; a replaced record then reports the lease reason instead.')\\n86:run('N-rev-lease',revalidate_source,'\\\\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {','\\\\tif (projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID) && false {','Skip exactly the lease compare; a successor lease then reports the heads reason instead.')\\n87:run('N-rev-heads',revalidate_source,'\\\\tif !equalStrings(heads, plan.AuthorityHeads) {','\\\\tif !equalStrings(heads, plan.AuthorityHeads) && false {','Skip exactly the heads compare; a same-lease event then reports the index reason instead.')\\n88:run('N-rev-absent-substitute',revalidate_source,'\\\\tif absent {','\\\\tif absent && len(rows) > 0 {\\\\n\\\\t\\\\trecordID = rows[0].Projection.RecordID\\\\n\\\\t\\\\tplan.SessionID = rows[0].Projection.SessionID\\\\n\\\\t}\\\\n\\\\tif absent && len(rows) == 0 {','Substitute the first listed sibling for exactly a deleted selection instead of reporting its absence.')\\n89:run('B-peer-order',source,'sort.Strings(ids)','sort.Sort(sort.Reverse(sort.StringSlice(ids)))','Reverse peer-source tie ordering; behavioral determinism fixture must fail.')\\n90:run('B-session-order',source,'return out[i].Projection.SessionID < out[j].Projection.SessionID','return out[i].Projection.SessionID > out[j].Projection.SessionID','Reverse session output order; behavioral list fixture must fail.')\\n91:run('B-tie-break',source,') < holderHost(best.selection',') > holderHost(best.selection','Reverse the identical-copy host tie break; the deterministic selection fixture must fail.')\\n92:run('C-not-applied',source,'TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\\n93:run('C-compile-failure',source,'package sessquery','package sessquery\\\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\\n\",\n  \"original_output_bytes\": 8489,\n  \"original_output_tokens\": 2123,\