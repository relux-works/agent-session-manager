onfig local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\n{\\\"description\\\":\\\"Add a text resource to an element\\\",\\\"destructive\\\":false,\\\"examples\\\":[\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"idempotent\\\":false,\\\"kind\\\":\\\"mutation\\\",\\\"name\\\":\\\"add_resource\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Resource content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"signature\\\":\\\"add_resource(id:string, name:string, content?:string, path?:string, type?:string{precondition|outcome}, description?:string)\\\",\\\"syntax\\\":\\\"OPERATION(element-or-identifier, key=value, key=\\\\\\\"quoted string\\\\\\\") { field preset }; statements separated by ';'; the first bare positional value is the element/identifier argument; remaining arguments use key=value (no operators or lists); string escapes: \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\"}\\n\",\n  \"original_output_bytes\": 2889,\n  \"original_output_tokens\": 723,\n  \"truncated\": false\n}","final_result":true}}}
