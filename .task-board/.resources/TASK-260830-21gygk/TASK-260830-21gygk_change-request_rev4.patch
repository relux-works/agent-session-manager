+func TestBuildPlanValidatesUnionAtBuild(t *testing.T) {
+	local, _ := repository(t)
+	peer, _ := repository(t)
+	leasedPeerSession(t, peer, idB, "beta")
+	create(t, local, idB, "different-record")
+	reader := unionReader(t, local, peer)
