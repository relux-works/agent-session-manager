+func TestRevalidateUnionUnreadablePeerRefuses(t *testing.T) {
+	reader, _, _, _ := plannedSession(t)
+	peer, peerRoot := repository(t)
+	reader.AllowlistedPeerIDs = []string{hostC}
+	reader.Peers = []PeerIndex{{hostC, peer}}
