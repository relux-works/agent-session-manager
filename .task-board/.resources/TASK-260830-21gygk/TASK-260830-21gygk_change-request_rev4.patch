+	if _, err := reader.BuildPlan(PlanArgs{Selector: "alpha", Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {
+		t.Fatalf("record-only build = %v, want selector_bootstrap_incomplete", err)
