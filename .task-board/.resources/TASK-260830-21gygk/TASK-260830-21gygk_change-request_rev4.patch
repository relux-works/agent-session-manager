+	if p.Name != "Alpha" || p.Kind != "direct" || p.Provider.ID != "codex" || p.State != sessstate.StateCreating || p.OwnerHostID != hostA || p.LocalRole != "owner" || p.Winner.LeaseID != lease || p.Winner.Epoch != 1 {
+		t.Fatalf("derived summary: %+v", p)
