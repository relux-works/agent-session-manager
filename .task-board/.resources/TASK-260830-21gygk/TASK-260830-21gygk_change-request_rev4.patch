+// openTestRepository opens a repository under a test-temporary data root.
+func openTestRepository(t *testing.T) *Repository {
+	t.Helper()
+	repository, err := Open(t.TempDir())
+	if err != nil {
+		t.Fatalf("Open(test root) error = %v", err)
+	}
