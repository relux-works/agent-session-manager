+	case *types.Slice:
+		return rev14SealedTypeIdentityContains(current.Elem(), seal, token, seen)
+	case *types.Map:
+		return rev14SealedTypeIdentityContains(current.Key(), seal, token, seen) || rev14SealedTypeIdentityContains(current.Elem(), seal, token, seen)
+	case *types.Chan:
