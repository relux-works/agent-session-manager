+			return true
+		}
+	}
+	return false
+}
+
+func rev14SealedTypeParamListContainsIdentity(list *types.TypeParamList, seal, token *types.TypeName, seen map[types.Type]bool) bool {
+	for index := 0; index < list.Len(); index++ {
