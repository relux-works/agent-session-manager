diff --git a/internal/sessquery/rev15_regression_test.go b/internal/sessquery/rev15_regression_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f0a0f39ff40a20638b0ea36456b1516adc4888fb
--- /dev/null
