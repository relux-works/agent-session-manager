func uint64String(value uint64) string {
	return json.Number(fmtSprintUint64(value)).String()
}

func fmtSprintUint64(value uint64) string {
	if value == 0 {
		return "0"
	}
	var digits []byte
	for value > 0 {
		digits = append([]byte{byte('0' + value%10)}, digits...)
		value /= 10
	}
	return string(digits)
}

