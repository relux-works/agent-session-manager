{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bb","stream":{"kind":"session","id":"01a087db-0be4-7a23-ba18-805dbea24dd0"},"sequence":568,"recorded_at":1780531400001131,"record_type":"event","durability":"durable","causation_id":"b19050a7-f678-4536-a7fd-908686507d31","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b19050a7-f678-4536-a7fd-908686507d31","run_stream":{"kind":"run","id":"b19050a7-f678-4536-a7fd-908686507d31"},"task_stream":{"kind":"task","id":"01a087dd-46ba-72f2-a191-278a1f44a76b"},"task_id":"01a087dd-46ba-72f2-a191-278a1f44a76b","event":{"kind":"output","task_id":"01a087dd-46ba-72f2-a191-278a1f44a76b","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|)\n61|\n62|// PeerIndex binds a peer identity to its already persisted learned index.\n63|// Transport/authentication and installing peer indexes are upstream owners;\n64|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n65|type PeerIndex struct {\n66|\tHostID string\n67|\tRepo   *sessrepo.Repository\n68|}\n69|\n70|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n71|// configuration layer, separately from the learned indexes. An unlisted source\n72|// is never read. Failed reads from listed sources are errors, never\n73|// empty indexes that let resolution fall through to a lower-priority UUID.\n74|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n75|//\n76|// Aliases carries the exact configured peer-alias mapping (host ID to\n77|// alias) from the same configuration owner, kept separate from the\n78|// learned index handles: a mapping without a handle contributes no\n79|// learned names, and a handle without a mapping stays reachable through\n80|// the bare union and the \"id:\" host form but never through \"peer:\".\n81|// Alias comparison is always exact, never folded, trimmed, or decoded.\n82|type Reader struct {\n83|\tLocal              *sessrepo.Repository\n84|\tLocalHostID        string\n85|\tAllowlistedPeerIDs []string\n86|\tPeers              []PeerIndex\n87|\tAliases            map[string]string\n88|}\n89|\n90|// Summary contains only facts derived from verified session records and events.\n91|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n92|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n93|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n94|// process liveness and sync timestamps require their respective observation\n95|// owners and are deliberately not inferred from a record or a successful read.\n96|type Summary struct {\n97|\tProjection sessstate.Projection\n98|}\n99|\n100|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n101|// visible with their blocking reason and retry; failure to enumerate the index\n102|// fails the read. No durable state is written, even for an interrupted create.\n103|func (reader *Reader) List() ([]Summary, error) {\n104|\tif reader == nil || reader.Local == nil {\n105|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n106|\t}\n107|\treturn reader.read(reader.Local)\n108|}\n109|\n110|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n111|\trows, err := repo.ListSessions()\n112|\tif err != nil {\n113|\t\treturn nil, err\n114|\t}\n115|\tout := make([]Summary, 0, len(rows))\n116|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n117|\tfor _, row := range rows {\n118|\t\tprojection, err := projector.Project(row.SessionID)\n119|\t\tif err != nil {\n120|\t\t\treturn nil, err\n(more lines below)","final_result":true}}}
