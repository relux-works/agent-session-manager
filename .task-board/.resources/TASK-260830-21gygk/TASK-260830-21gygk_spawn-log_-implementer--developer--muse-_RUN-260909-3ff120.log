{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a9","stream":{"kind":"session","id":"01a087db-0be4-7a23-ba18-805dbea24dd0"},"sequence":431,"recorded_at":1780531400000857,"record_type":"event","durability":"durable","causation_id":"b19050a7-f678-4536-a7fd-908686507d31","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b19050a7-f678-4536-a7fd-908686507d31","run_stream":{"kind":"run","id":"b19050a7-f678-4536-a7fd-908686507d31"},"task_stream":{"kind":"task","id":"01a087dc-0fa4-76f1-9602-0f1d41e04fa4"},"task_id":"01a087dc-0fa4-76f1-9602-0f1d41e04fa4","event":{"kind":"output","task_id":"01a087dc-0fa4-76f1-9602-0f1d41e04fa4","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/selector.go`.\n1|// Selector grammar and configured source validation for the v0.6.0\n2|// session selector contract (SPEC Section 14.7.1, refining Section 2.3).\n3|//\n4|// A selector is one CLI argument. The split is at the FIRST literal \"@\"\n5|// only: the key is a session NAME, a bare UUID, or \"id:SESSION_UUID\", and\n6|// the source is empty (bare Section 2.3 tiers), \"local\",\n7|// \"peer:ALIAS\" (the entire remaining suffix, literal), or\n8|// \"id:HOST_UUID\". The parser never joins arguments, decodes percent\n9|// escapes, normalizes Unicode, trims, or case-folds aliases: a percent\n10|// sign, surrounding spaces, or a second \"@\" inside a peer alias are\n11|// literal characters of that alias.\n12|//\n13|// Configuration (local host identity, peer alias/host mappings, peer\n14|// allowlist) arrives from the owning configuration layer together with\n15|// the learned index handles, exactly as Reader documents. The selector\n16|// validates the effective configuration it is given — including exact\n17|// alias and host-ID uniqueness — because a caller-supplied mapping is\n18|// not independently attested here. Duplicate source mappings are\n19|// invalid configuration, never first-match selection.\n20|package sessquery\n21|\n22|import (\n23|\t\"fmt\"\n24|\t\"sort\"\n25|\t\"strings\"\n26|\t\"unicode\"\n27|\t\"unicode/utf8\"\n28|\n29|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n30|)\n31|\n32|// MaxSelectorRunes bounds one selector argument: 64 NAME characters plus\n33|// \"@\" plus \"peer:\" plus a 64-character alias, counted in runes so a\n34|// Unicode alias keeps its configured 64-character allowance.\n35|const MaxSelectorRunes = 134\n36|\n37|// MaxAliasRunes is the existing configured peer-name bound (1-64\n38|// printable characters) this grammar reuses without adding an alias\n39|// encoding, normalization, or registration path.\n40|const MaxAliasRunes = 64\n41|\n42|// Selector source kinds. SourceBare retains the exact Section 2.3\n43|// tiers; every other kind selects in exactly one source index with no\n44|// fallback to any other source.\n45|type SelectorSource int\n46|\n47|const (\n48|\t// SourceBare resolves local exact name, allowlisted peer exact\n49|\t// name, exact UUID, then not found.\n50|\tSourceBare SelectorSource = iota\n51|\t// SourceLocal selects only in the local derived source index.\n52|\tSourceLocal\n53|\t// SourcePeerAlias selects only in the configured peer source\n54|\t// whose entire remaining suffix is the literal alias.\n55|\tSourcePeerAlias\n56|\t// SourcePeerHost selects only in the source whose canonical host\n57|\t// UUID is given; the local UUID selects local, otherwise exactly\n58|\t// one allowlisted configured peer.\n59|\tSourcePeerHost\n60|)\n61|\n62|// Selector is one parsed selector argument: the literal raw text, the\n63|// key before the first \"@\", and the source after it.\n64|type Selector struct {\n65|\t// Raw is the original single argument, preserved verbatim for plan\n66|\t// binding: another spelling that resolves to the same session never\n67|\t// authorizes the same plan.\n68|\tRaw string\n69|\t// Key is the literal text before the first \"@\", or the whole\n70|\t// argument when it carries no \"@\".\n71|\tKey string\n72|\t// IDKey reports the \"id:\" key form, which bypasses names and never\n73|\t// denotes a provider-native ID, directory instance ID, lease ID,\n74|\t// or UUID prefix.\n75|\tIDKey bool\n76|\t// UUIDShaped reports a key that parses as a canonical UUIDv7. A\n77|\t// bare UUID-shaped key still tries exact names first (Section 2.3\n78|\t// name-first precedence); a qualified UUID-shaped NAME tries the\n79|\t// exact name in its source first, then the UUID.\n80|\tUUIDShaped bool\n81|\t// Source is the selector source kind.\n82|\tSource SelectorSource\n83|\t// SourceValue is the literal peer alias (SourcePeerAlias) or the\n84|\t// canonical host UUID (SourcePeerHost), and empty otherwise.\n85|\tSourceValue string\n86|}\n87|\n88|// ParseSelector applies the literal grammar to one selector argument.\n89|// A percent sign in an alias is literal. \"peer:\" with an empty alias,\n90|// unknown source prefixes, malformed durable IDs, an empty key, and an\n91|// overlong argument are invalid arguments, never silent names.\n92|func ParseSelector(argument string) (Selector, error) {\n93|\tif utf8.RuneCountInString(argument) > MaxSelectorRunes {\n94|\t\treturn Selector{}, fmt.Errorf(\"%w: selector exceeds %d characters\", ErrInvalidArgument, MaxSelectorRunes)\n95|\t}\n96|\tkey, source, qualified := strings.Cut(argument, \"@\")\n97|\tif key == \"\" {\n98|\t\treturn Selector{}, fmt.Errorf(\"%w: selector carries an empty key\", ErrInvalidArgument)\n99|\t}\n100|\tparsed := Selector{Raw: argument, Key: key}\n101|\tif id, ok := strings.CutPrefix(key, \"id:\"); ok {\n102|\t\tif _, err := scalar.ParseUUIDv7(id); err != nil {\n103|\t\t\treturn Selector{}, fmt.Errorf(\"%w: malformed id: session UUID: %v\", ErrInvalidArgument, err)\n104|\t\t}\n105|\t\tparsed.IDKey = true\n106|\t\tparsed.UUIDShaped = true\n107|\t} else if _, err := scalar.ParseUUIDv7(key); err == nil {\n108|\t\tparsed.UUIDShaped = true\n109|\t}\n110|\tif !qualified {\n111|\t\tparsed.Source = SourceBare\n112|\t\treturn parsed, nil\n113|\t}\n114|\tswitch {\n115|\tcase source == \"local\":\n116|\t\tparsed.Source = SourceLocal\n117|\tcase strings.HasPrefix(source, \"peer:\"):\n118|\t\talias := strings.TrimPrefix(source, \"peer:\")\n119|\t\tif err := checkAlias(alias); err != nil {\n120|\t\t\treturn Selector{}, fmt.Errorf(\"%w: malformed peer alias: %v\", ErrInvalidArgument, err)\n121|\t\t}\n122|\t\tparsed.Source = SourcePeerAlias\n123|\t\tparsed.SourceValue = alias\n124|\tcase strings.HasPrefix(source, \"id:\"):\n125|\t\thost := strings.TrimPrefix(source, \"id:\")\n126|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n127|\t\t\treturn Selector{}, fmt.Errorf(\"%w: malformed id: host UUID: %v\", ErrInvalidArgument, err)\n128|\t\t}\n129|\t\tparsed.Source = SourcePeerHost\n130|\t\tparsed.SourceValue = host\n131|\tdefault:\n132|\t\treturn Selector{}, fmt.Errorf(\"%w: unknown selector source %q\", ErrInvalidArgument, source)\n133|\t}\n134|\treturn parsed, nil\n135|}\n136|\n137|// checkAlias enforces the existing configured peer-name bound without\n138|// normalizing: valid UTF-8, 1-64 printable non-control runes, compared\n139|// exactly everywhere it is used.\n140|func checkAlias(alias string) error {\n141|\tif !utf8.ValidString(alias) {\n142|\t\treturn fmt.Errorf(\"alias is not valid UTF-8\")\n143|\t}\n144|\tcount := utf8.RuneCountInString(alias)\n145|\tif count < 1 || count > MaxAliasRunes {\n146|\t\treturn fmt.Errorf(\"alias carries %d characters, want 1-%d\", count, MaxAliasRunes)\n147|\t}\n148|\tfor _, character := range alias {\n149|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n150|\t\t\treturn fmt.Errorf(\"alias carries a non-printable character\")\n151|\t\t}\n152|\t}\n153|\treturn nil\n154|}\n155|\n156|// validatedConfig is the effective source configuration every selector\n157|// entry validates before reading any index: the local host, the\n158|// allowlist as a set, and the alias mapping restricted to known peer\n159|// hosts. Indexes and mappings stay separate inputs; this type only\n160|// records that the mapping shapes and uniqueness hold.\n161|type validatedConfig struct {\n162|\tlocalHost string\n163|\tallowed   map[string]struct{}\n164|\taliasOf   map[string]string\n165|}\n166|\n167|// validatedConfiguration validates the effective configuration the\n168|// caller supplied: local host shape, peer host shapes and alias\n169|// shapes, exact uniqueness of host-ID and alias mappings (including\n170|// against the local host), and allowlist ID shapes. Duplicate source\n171|// mappings are invalid configuration, never first-match selection. An\n172|// allowlisted ID without a learned index stays absence in union tiers;\n173|// it is validated for shape here and resolved at read time.\n174|func (reader *Reader) validatedConfiguration() (validatedConfig, error) {\n175|\tconfig := validatedConfig{allowed: map[string]struct{}{}, aliasOf: map[string]string{}}\n176|\tif reader == nil {\n177|\t\treturn config, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n178|\t}\n179|\tif reader.LocalHostID != \"\" {\n180|\t\tif _, err := scalar.ParseUUIDv7(reader.LocalHostID); err != nil {\n181|\t\t\treturn config, fmt.Errorf(\"%w: malformed local host ID: %v\", ErrInvalidConfig, err)\n182|\t\t}\n183|\t\tconfig.localHost = reader.LocalHostID\n184|\t}\n185|\t// Duplicate learned-index observations for one peer host keep their\n186|\t// existing read-time duplicate-index refusal (peerCandidates owns\n187|\t// it); configuration validation polices the mapping plane only, so\n188|\t// a peer host colliding with the local host is the duplicate\n189|\t// source mapping refused here.\n190|\tseenAliases := map[string]struct{}{}\n191|\tfor _, peer := range reader.Peers {\n192|\t\tif _, err := scalar.ParseUUIDv7(peer.HostID); err != nil {\n193|\t\t\treturn config, fmt.Errorf(\"%w: malformed peer host ID: %v\", ErrInvalidConfig, err)\n194|\t\t}\n195|\t\tif peer.HostID == config.localHost && config.localHost != \"\" {\n196|\t\t\treturn config, fmt.Errorf(\"%w: duplicate source mapping for host %s\", ErrInvalidConfig, peer.HostID)\n197|\t\t}\n198|\t}\n199|\tfor host, alias := range reader.Aliases {\n200|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n201|\t\t\treturn config, fmt.Errorf(\"%w: malformed alias host ID: %v\", ErrInvalidConfig, err)\n202|\t\t}\n203|\t\tif err := checkAlias(alias); err != nil {\n204|\t\t\treturn config, fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n205|\t\t}\n206|\t\tif _, duplicate := seenAliases[alias]; duplicate {\n207|\t\t\treturn config, fmt.Errorf(\"%w: duplicate source mapping for alias %q\", ErrInvalidConfig, alias)\n208|\t\t}\n209|\t\tseenAliases[alias] = struct{}{}\n210|\t\tconfig.aliasOf[host] = alias\n211|\t}\n212|\tfor _, id := range reader.AllowlistedPeerIDs {\n213|\t\tif _, err := scalar.ParseUUIDv7(id); err != nil {\n214|\t\t\treturn config, fmt.Errorf(\"%w: malformed allowlisted peer ID: %v\", ErrInvalidConfig, err)\n215|\t\t}\n216|\t\tconfig.allowed[id] = struct{}{}\n217|\t}\n218|\treturn config, nil\n219|}\n220|\n221|// aliasFor reports the exact configured alias for a known peer host,\n222|// or empty when the source carries no alias mapping.\n223|func (config validatedConfig) aliasFor(host string) string {\n224|\treturn config.aliasOf[host]\n225|}\n226|\n227|// hostForAlias resolves an exact literal alias to its single host. The\n228|// comparison is exact: folding, trimming, or decoding never applies.\n229|func (config validatedConfig) hostForAlias(reader *Reader, alias string) (string, bool) {\n230|\tfor _, peer := range reader.Peers {\n231|\t\tif config.aliasOf[peer.HostID] == alias && alias != \"\" {\n232|\t\t\treturn peer.HostID, true\n233|\t\t}\n234|\t}\n235|\treturn \"\", false\n236|}\n237|\n238|// sortedPeerHosts returns the known peer hosts in bytewise order so\n239|// configuration digests and tie breaks stay deterministic.\n240|func (config validatedConfig) sortedPeerHosts(reader *Reader) []string {\n241|\thosts := make([]string, 0, len(reader.Peers))\n242|\tfor _, peer := range reader.Peers {\n243|\t\thosts = append(hosts, peer.HostID)\n244|\t}\n245|\tsort.Strings(hosts)\n246|\treturn hosts\n247|}","final_result":true}}}
