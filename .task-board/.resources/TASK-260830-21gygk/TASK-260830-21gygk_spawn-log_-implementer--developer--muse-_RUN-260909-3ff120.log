l\":\n116|\t\tparsed.Source = SourceLocal\n117|\tcase strings.HasPrefix(source, \"peer:\"):\n118|\t\talias := strings.TrimPrefix(source, \"peer:\")\n119|\t\tif err := checkAlias(alias); err != nil {\n120|\t\t\treturn Selector{}, fmt.Errorf(\"%w: malformed peer alias: %v\", ErrInvalidArgument, err)\n121|\t\t}\n122|\t\tparsed.Source = SourcePeerAlias\n123|\t\tparsed.SourceValue = alias\n124|\tcase strings.HasPrefix(source, \"id:\"):\n125|\t\thost := strings.TrimPrefix(source, \"id:\")\n126|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n127|\t\t\treturn Selector{}, fmt.Errorf(\"%w: malformed id: host UUID: %v\", ErrInvalidArgument, err)\n128|\t\t}\n129|\t\tparsed.Source = SourcePeerHost\n130|\t\tparsed.SourceValue = host\n131|\tdefault:\n132|\t\treturn Selector{}, fmt.Errorf(\"%w: unknown selector source %q\", ErrInvalidArgument, source)\n133|\t}\n134|\treturn parsed, nil\n135|}\n136|\n137|// checkAlias enforces the existing configured peer-name bound without\n138|// normalizing: valid UTF-8, 1-64 printable non-control runes, compared\n139|// exactly everywhere it is used.\n140|func checkAlias(alias string) error {\n141|\tif !utf8.ValidString(alias) {\n142|\t\treturn fmt.Errorf(\"alias is not valid UTF-8\")\n143|\t}\n144|\tcount := utf8.RuneCountInString(alias)\n145|\tif count < 1 || count > MaxAliasRunes {\n146|\t\treturn fmt.Errorf(\"alias carries %d characters, want 1-%d\", count, MaxAliasRunes)\n147|\t}\n148|\tfor _, character := range alias {\n149|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n150|\t\t\treturn fmt.Errorf(\"alias carries a non-printable character\")\n151|\t\t}\n152|\t}\n153|\treturn nil\n154|}\n155|\n156|// validatedConfig is the effective source configuration every selector\n157|// entry validates before reading any index: the local host, the\n158|// allowlist as a set, and the alias mapping restricted to known peer\n159|// hosts. Indexes and mappings stay separate inputs; this type only\n160|// records that the mapping shapes and uniqueness hold.\n161|type validatedConfig struct {\n162|\tlocalHost string\n163|\tallowed   map[string]struct{}\n164|\taliasOf   map[string]string\n165|}\n166|\n167|// validatedConfiguration validates the effective configuration the\n168|// caller supplied: local host shape, peer host shapes and alias\n169|// shapes, exact uniqueness of host-ID and alias mappings (including\n170|// against the local host), and allowlist ID shapes. Duplicate source\n171|// mappings are invalid configuration, never first-match selection. An\n172|// allowlisted ID without a learned index stays absence in union tiers;\n173|// it is validated for shape here and resolved at read time.\n174|func (reader *Reader) validatedConfiguration() (validatedConfig, error) {\n175|\tconfig := validatedConfig{allowed: map[string]struct{}{}, aliasOf: map[string]string{}}\n176|\tif reader == nil {\n177|\t\treturn config, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n178|\t}\n179|\tif reader.LocalHostID != \"\" {\n180|\t\tif _, err := scalar.ParseUUIDv7(reader.LocalHostID); err != nil {\n181|\t\t\treturn config, fmt.Errorf(\"%w: malformed local host ID: %v\", ErrInvalidConfig, err)\n182|\t\t}\n183|\t\tconfig.localHost = reader.LocalHostID\n184|\t}\n185|\t// Duplicate learned-index observations for one peer host keep their\n186|\t// existing read-time duplicate-index refusal (peerCandidates owns\n187|\t// it); configuration validation polices the mapping plane only, so\n188|\t// a peer host colliding with the local host is the duplicate\n189|\t// source mapping refused here.\n190|\tseenAliases := map[string]struct{}{}\n191|\tfor _, peer := range reader.Peers {\n192|\t\tif _, err := scalar.ParseUUIDv7(peer.HostID); err != nil {\n193|\t\t\treturn config, fmt.Errorf(\"%w: malformed peer host ID: %v\", ErrInvalidConfig, err)\n194|\t\t}\n195|\t\tif peer.HostID == config.localHost && config.localHost != \"\" {\n196|\t\t\treturn config, fmt.Errorf(\"%w: duplicate source mapping for host %s\", ErrInvalidConfig, peer.HostID)\n197|\t\t}\n198|\t}\n199|\tfor host, alias := range reader.Aliases {\n200|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n201|\t\t\treturn config, fmt.Errorf(\"%w: malformed alias host ID: %v\", ErrInvalidConfig, err)\n202|\t\t}\n203|\t\tif err := checkAlias(alias); err != nil {\n204|\t\t\treturn config, fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n205|\t\t}\n206|\t\tif _, duplicate := seenAliases[alias]; duplicate {\n207|\t\t\treturn config, fmt.Errorf(\"%w: duplicate source mapping for alias %q\", ErrInvalidConfig, alias)\n208|\t\t}\n209|\t\tseenAliases[alias] = struct{}{}\n210|\t\tconfig.aliasOf[host] = alias\n211|\t}\n212|\tfor _, id := range reader.AllowlistedPeerIDs {\n213|\t\tif _, err := scalar.ParseUUIDv7(id); err != nil {\n214|\t\t\treturn config, fmt.Errorf(\"%w: malformed allowlisted peer ID: %v\", ErrInvalidConfig, err)\n215|\t\t}\n216|\t\tconfig.allowed[id] = struct{}{}\n217|\t}\n218|\treturn config, nil\n219|}\n220|\n221|// aliasFor reports the exact configured alias for a known peer host,\n222|// or empty when the source carries no alias mapping.\n223|func (config validatedConfig) aliasFor(host string) string {\n224|\treturn config.aliasOf[host]\n225|}\n226|\n227|// hostForAlias resolves an exact literal alias to its single host. The\n228|// comparison is exact: folding, trimming, or decoding never applies.\n229|func (config validatedConfig) hostForAlias(reader *Reader, alias string) (string, bool) {\n230|\tfor _, peer := range reader.Peers {\n231|\t\tif config.aliasOf[peer.HostID] == alias && alias != \"\" {\n232|\t\t\treturn peer.HostID, true\n233|\t\t}\n234|\t}\n235|\treturn \"\", false\n236|}\n237|\n238|// sortedPeerHosts returns the known peer hosts in bytewise order so\n239|// configuration digests and tie breaks stay deterministic.\n240|func (config validatedConfig) sortedPeerHosts(reader *Reader) []string {\n241|\thosts := make([]string, 0, len(reader.Peers))\n242|\tfor _, peer := range reader.Peers {\n243|\t\thosts = append(hosts, peer.HostID)\n244|\t}\n245|\tsort.Strings(hosts)\n246|\treturn hosts\n247|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
