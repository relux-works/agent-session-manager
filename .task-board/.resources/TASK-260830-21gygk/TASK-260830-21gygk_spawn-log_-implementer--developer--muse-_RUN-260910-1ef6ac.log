{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d39d","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":2089,"recorded_at":1780531400004173,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a08935f22f722380e57fc00dbc413d","text":"Read text file `internal/sessquery/rev5_regression_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"testing\"\n6|)\n7|\n8|func rev5CheckEntries(t *testing.T, r *Reader, refuse bool) {\n9|\tt.Helper()\n10|\tmetadata := summaryReader(t)\n11|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n12|\tp, buildErr := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n13|\tif refuse && buildErr == nil {\n14|\t\tt.Errorf(\"BuildPlan admitted invalid lease/checkpoint authority; Revalidate=%v\", r.Revalidate(p))\n15|\t}\n16|\tif !refuse && buildErr != nil {\n17|\t\tt.Fatalf(\"positive BuildPlan: %v\", buildErr)\n18|\t}\n19|\tif !refuse {\n20|\t\tif err := r.Revalidate(p); err != nil {\n21|\t\t\tt.Errorf(\"positive Revalidate: %v\", err)\n22|\t\t}\n23|\t}\n24|\t_, statusErr := r.AuthoritativeStatus(\"alpha\")\n25|\t_, listErr := r.AuthoritativeList()\n26|\tif refuse && statusErr == nil {\n27|\t\tt.Error(\"AuthoritativeStatus admitted invalid lease/checkpoint authority\")\n28|\t}\n29|\tif refuse && listErr == nil {\n30|\t\tt.Error(\"AuthoritativeList admitted invalid lease/checkpoint authority\")\n31|\t}\n32|\tif !refuse && (statusErr != nil || listErr != nil) {\n33|\t\tt.Errorf(\"positive summaries: status=%v list=%v\", statusErr, listErr)\n34|\t}\n35|}\n36|\n37|func TestRev5AncestorCheckpointAuthority(t *testing.T) {\n38|\tfor _, missing := range []bool{false, true} {\n39|\t\tname := \"complete\"\n40|\t\tif missing {\n41|\t\t\tname = \"missing_ancestor_checkpoint\"\n42|\t\t}\n43|\t\tt.Run(name, func(t *testing.T) {\n44|\t\t\tr, _, _, created := plannedSession(t)\n45|\t\t\tlaunched := appendEvent(t, r.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n46|\t\t\tcp1 := checkpointRecordBytes(t, idA, 1, lease, hostA)\n47|\t\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n48|\t\t\twithCheckpoints(r, cp2)\n49|\t\t\tif !missing {\n50|\t\t\t\twithCheckpoints(r, cp1)\n51|\t\t\t}\n52|\t\t\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp1)), leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n53|\t\t\tvar forceRecord map[string]any\n54|\t\t\tif err := json.Unmarshal(r.LeaseRecords[len(r.LeaseRecords)-1], &forceRecord); err != nil {\n55|\t\t\t\tt.Fatal(err)\n56|\t\t\t}\n57|\t\t\tforceRecord[\"reason\"] = \"force_takeover\"\n58|\t\t\tr.LeaseRecords[len(r.LeaseRecords)-1] = identity(t, forceRecord, \"record_id\")\n59|\t\t\tappendEventAs(t, r.Local, idA, launched, \"lease.forced\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"expected_owner_host_id\": hostA, \"expected_epoch\": 2, \"new_lease_id\": leaseCycleB, \"checkpoint_id\": checkpointDigestOf(t, cp2)})\n60|\t\t\tif missing {\n61|\t\t\t\twithCheckpoints(r, cp1)\n62|\t\t\t\toldPlan := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n63|\t\t\t\tr.CheckpointRecords = r.CheckpointRecords[:len(r.CheckpointRecords)-1]\n64|\t\t\t\tif err := r.Revalidate(oldPlan); err == nil {\n65|\t\t\t\t\tt.Error(\"Revalidate retained an originally valid plan after ancestor checkpoint authority became unavailable\")\n66|\t\t\t\t}\n67|\t\t\t}\n68|\t\t\trev5CheckEntries(t, r, missing)\n69|\t\t})\n70|\t}\n71|}\n72|\n73|func TestRev5CheckpointCreatorMustBeHolder(t *testing.T) {\n74|\tfor _, wrong := range []bool{false, true} {\n75|\t\tname := \"holder\"\n76|\t\tcreator := hostA\n77|\t\tif wrong {\n78|\t\t\tname = \"non_holder\"\n79|\t\t\tcreator = hostB\n80|\t\t}\n81|\t\tt.Run(name, func(t *testing.T) {\n82|\t\t\tr := successorFixture(t)\n83|\t\t\tcp := checkpointRecordBytes(t, idA, 1, lease, creator)\n84|\t\t\twithCheckpoints(r, cp)\n85|\t\t\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n86|\t\t\trev5CheckEntries(t, r, wrong)\n87|\t\t})\n88|\t}\n89|}\n90|\n91|// rev5AncestorFixture builds the three-generation winning ancestry the\n92|// ancestor-authority negatives share: epoch-1/2/3 canonical Lease\n93|// Records with legal predecessor IDs and epochs, an event chain\n94|// observing the epoch-3 force takeover, and a valid epoch-2\n95|// checkpoint. The caller supplies the epoch-1 checkpoint the epoch-2\n96|// ancestor references; only a checkpoint bound to (idA, 1, lease)\n97|// and created by hostA is admissible.\n98|func rev5AncestorFixture(t *testing.T, cp1 []byte) *Reader {\n99|\tt.Helper()\n100|\tr, _, _, created := plannedSession(t)\n101|\tlaunched := appendEvent(t, r.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n102|\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n103|\twithCheckpoints(r, cp1, cp2)\n104|\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp1)), leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n105|\tvar forceRecord map[string]any\n106|\tif err := json.Unmarshal(r.LeaseRecords[len(r.LeaseRecords)-1], &forceRecord); err != nil {\n107|\t\tt.Fatal(err)\n108|\t}\n109|\tforceRecord[\"reason\"] = \"force_takeover\"\n110|\tr.LeaseRecords[len(r.LeaseRecords)-1] = identity(t, forceRecord, \"record_id\")\n111|\tappendEventAs(t, r.Local, idA, launched, \"lease.forced\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"expected_owner_host_id\": hostA, \"expected_epoch\": 2, \"new_lease_id\": leaseCycleB, \"checkpoint_id\": checkpointDigestOf(t, cp2)})\n112|\treturn r\n113|}\n114|\n115|// TestRev5AncestorCheckpointBinding proves the ancestor gate binds\n116|// the required checkpoint relationship instead of admitting any\n117|// canonically identified record: an ancestor checkpoint bound to\n118|// another session, another lease, or another creator refuses\n119|// through BuildPlan, Revalidate, AuthoritativeStatus, and\n120|// AuthoritativeList alike.\n121|func TestRev5AncestorCheckpointBinding(t *testing.T) {\n122|\tcases := []struct {\n123|\t\tname string\n124|\t\tcp1  func(t *testing.T) []byte\n125|\t}{\n126|\t\t{\"wrong_session\", func(t *testing.T) []byte { return checkpointRecordBytes(t, idB, 1, lease, hostA) }},\n127|\t\t{\"wrong_lease\", func(t *testing.T) []byte { return checkpointRecordBytes(t, idA, 1, leaseCycleB, hostA) }},\n128|\t\t{\"wrong_creator\", func(t *testing.T) []byte { return checkpointRecordBytes(t, idA, 1, lease, hostB) }},\n129|\t}\n130|\tfor _, tc := range cases {\n131|\t\tt.Run(tc.name, func(t *testing.T) {\n132|\t\t\trev5CheckEntries(t, rev5AncestorFixture(t, tc.cp1(t)), true)\n133|\t\t})\n134|\t}\n135|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
