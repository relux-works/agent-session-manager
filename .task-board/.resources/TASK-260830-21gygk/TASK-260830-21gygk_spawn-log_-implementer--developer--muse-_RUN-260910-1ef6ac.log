{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cde3","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":1356,"recorded_at":1780531400002707,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0893356c57fe3a950404a6b8b31c7","text":"Read text file `internal/sessquery/lease.go`.\n(423 line(s) above)\n424|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n425|// against the admitted Checkpoint Records. Section 5.3 requires\n426|// every epoch above 1 to reference a validated checkpoint for its\n427|// session and predecessor lease; an epoch-1 root without a\n428|// predecessor may carry no checkpoint before the first provider\n429|// boundary exists. A non-null reference must resolve to an admitted\n430|// record for the same session bound to the lease it was taken\n431|// under: the predecessor for a successor, the winner itself at\n432|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n433|// unresolvable reference is incomplete authority\n434|// (observation_unavailable), never absence or a minted fact.\n435|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string) error {\n436|\tif !winner.HasCheckpoint {\n437|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n438|\t\t\treturn nil\n439|\t\t}\n440|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n441|\t}\n442|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n443|\tif err != nil {\n444|\t\treturn err\n445|\t}\n446|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n447|\tif !ok {\n448|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n449|\t}\n450|\tif checkpoint.SessionID != winner.SessionID {\n451|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n452|\t}\n453|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n454|\tif winner.Epoch > 1 {\n455|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n456|\t}\n457|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n458|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n459|\t}\n460|\towner := winner\n461|\tif winner.Epoch > 1 {\n462|\t\towner = predecessor\n463|\t}\n464|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n465|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n466|\t}\n467|\tif err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {\n468|\t\treturn err\n469|\t}\n470|\treturn nil\n471|}\n472|\n473|// checkAncestorCheckpoints validates the checkpoint references of\n474|// every non-winner lease in the winning ancestry: Section 5.3\n475|// requires each epoch above 1 to reference a validated checkpoint\n476|// for its session and predecessor lease, and Section 5.4 requires\n477|// that checkpoint to be created by the owning lease holder. The\n478|// winner itself is covered by checkWinnerCheckpoint. Only the\n479|// winner's own ancestry is admitted: sibling branches off that\n480|// chain are never consulted, so legal branching is preserved. An\n481|// epoch-1 root without a reference stays admissible before the\n482|// first provider boundary exists; a reference it does carry must\n483|// resolve to a checkpoint bound to itself and created by its own\n484|// holder. An unresolvable reference or a binding to another\n485|// session, lease, or holder is incomplete authority\n486|// (observation_unavailable), never absence or a minted fact.\n487|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string) error {\n488|\tif len(chain) < 2 {\n489|\t\treturn nil\n490|\t}\n491|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n492|\tif err != nil {\n493|\t\treturn err\n494|\t}\n495|\tfor index := 1; index < len(chain); index++ {\n496|\t\tcurrent := chain[index]\n497|\t\tif current.Epoch == 1 {\n498|\t\t\tif !current.HasCheckpoint {\n499|\t\t\t\tcontinue\n500|\t\t\t}\n501|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind); err != nil {\n502|\t\t\t\treturn err\n503|\t\t\t}\n504|\t\t\tcontinue\n505|\t\t}\n506|\t\tif !current.HasCheckpoint {\n507|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n508|\t\t}\n509|\t\tif index+1 >= len(chain) {\n510|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n511|\t\t}\n512|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind); err != nil {\n513|\t\t\treturn err\n514|\t\t}\n515|\t}\n516|\treturn nil\n517|}\n518|\n519|// checkCheckpointBinding resolves one lease's checkpoint reference\n520|// against the admitted Checkpoint Records and validates its Section\n521|// 5.3 session and predecessor-lease binding with its Section 5.4\n522|// holder binding: the checkpoint must name this session and the\n523|// owning lease, and its creator must be that lease's holder.\n524|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string) error {\n525|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n526|\tif !ok {\n527|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n528|\t}\n529|\tif checkpoint.SessionID != current.SessionID {\n530|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n531|\t}\n532|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n533|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n534|\t}\n535|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n536|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n537|\t}\n538|\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n539|\t\treturn err\n540|\t}\n541|\treturn nil\n542|}\n543|\n544|// checkCheckpointPersistence binds an admitted Checkpoint Record to\n545|// the persistence variant the referenced Session Record selects\n546|// (Section 5.4): a direct session requires a non-null\n547|// provider_manifest_id with a null task_board_bundle_id, while a\n548|// task_board session requires the reverse. Canonical shape proves\n549|// exactly one variant is present but cannot select which one is\n550|// valid, so a swapped variant keeps canonical identity, session,\n551|// lease, epoch, and creator yet refuses here with incomplete\n552|// authority (observation_unavailable), never absence or a minted\n553|// fact. An unknown session kind is malformed configuration: valid\n554|// Session Records admit only the two kinds.\n555|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n556|\tswitch sessionKind {\n557|\tcase \"direct\":\n558|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n559|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n560|\t\t}\n561|\t\treturn nil\n562|\tcase \"task_board\":\n563|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n564|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n565|\t\t}\n566|\t\treturn nil\n567|\tdefault:\n568|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n569|\t}\n570|}\n571|\n572|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n573|// greatest epoch wins, ties break by bytewise lease-ID order.\n574|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n575|\treturn sessstate.Compare(\n576|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n577|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n578|\t)\n579|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
