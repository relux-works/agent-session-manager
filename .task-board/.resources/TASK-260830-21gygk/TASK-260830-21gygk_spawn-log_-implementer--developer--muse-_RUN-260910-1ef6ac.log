{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca03","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":860,"recorded_at":1780531400001715,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a08930798d7f639ccfdbf3bc93c57d","text":"Read text file `internal/sessquery/plan_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n16|)\n17|\n18|func sortStringsForTest(values []string) {\n19|\tsort.Strings(values)\n20|}\n21|\n22|// appendEventAs chains one event under an explicit envelope lease,\n23|// unlike the epoch-1-only fixtures helper.\n24|func appendEventAs(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, epoch uint64, leaseID string, payload map[string]any) string {\n25|\tt.Helper()\n26|\tvalue := map[string]any{\n27|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n28|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n29|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n30|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n31|\t}\n32|\traw := identity(t, value, \"event_id\")\n33|\tref, err := repo.AppendEvent(id, raw)\n34|\tif err != nil {\n35|\t\tt.Fatal(err)\n36|\t}\n37|\treturn ref.EventID\n38|}\n39|\n40|// copySessionDir replicates one persisted session directory byte for\n41|// byte, so two sources hold the same identity with agreeing digests.\n42|func copySessionDir(t *testing.T, srcRoot, dstRoot, sessionID string) {\n43|\tt.Helper()\n44|\tsrc := filepath.Join(srcRoot, \"sessions\", sessionID)\n45|\tdst := filepath.Join(dstRoot, \"sessions\", sessionID)\n46|\tentries, err := os.ReadDir(src)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tif err := os.MkdirAll(filepath.Join(dst, \"events\"), 0o700); err != nil {\n51|\t\tt.Fatal(err)\n52|\t}\n53|\tfor _, entry := range entries {\n54|\t\tif entry.IsDir() {\n55|\t\t\tblobs, err := os.ReadDir(filepath.Join(src, entry.Name()))\n56|\t\t\tif err != nil {\n57|\t\t\t\tt.Fatal(err)\n58|\t\t\t}\n59|\t\t\tfor _, blob := range blobs {\n60|\t\t\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name(), blob.Name()))\n61|\t\t\t\tif err != nil {\n62|\t\t\t\t\tt.Fatal(err)\n63|\t\t\t\t}\n64|\t\t\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name(), blob.Name()), bytes, 0o600); err != nil {\n65|\t\t\t\t\tt.Fatal(err)\n66|\t\t\t\t}\n67|\t\t\t}\n68|\t\t\tcontinue\n69|\t\t}\n70|\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name()))\n71|\t\tif err != nil {\n72|\t\t\tt.Fatal(err)\n73|\t\t}\n74|\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name()), bytes, 0o600); err != nil {\n75|\t\t\tt.Fatal(err)\n76|\t\t}\n77|\t}\n78|}\n79|\n80|// plannedSession builds a local session with its bootstrap event and\n81|// validated initial Lease Record, returning the reader, roots, record\n82|// digest, and created event ID. The reader carries the known local\n83|// host identity every local plan requires for its source binding, plus\n84|// the winning lease authority every plan requires.\n85|func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n86|\tt.Helper()\n87|\tlocal, root := repository(t)\n88|\tref := create(t, local, idA, \"alpha\")\n89|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n90|\treader := &Reader{Local: local, LocalHostID: hostA}\n91|\twithLeases(reader, leaseCreate(t, idA, hostA))\n92|\treturn reader, root, ref, created\n93|}\n94|\n95|func mustBuild(t *testing.T, reader *Reader, args PlanArgs) SelectionPlan {\n96|\tt.Helper()\n97|\tplan, err := reader.BuildPlan(args)\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\treturn plan\n102|}\n103|\n104|func mustStale(t *testing.T, err error, reason string) {\n105|\tt.Helper()\n106|\tif !errors.Is(err, ErrPlanStale) {\n107|\t\tt.Fatalf(\"error = %v, want selector_plan_stale\", err)\n108|\t}\n109|\tif !strings.Contains(err.Error(), reason) {\n110|\t\tt.Fatalf(\"error = %v, want reason %q\", err, reason)\n111|\t}\n112|}\n113|\n114|func TestBuildPlanBindsCurrentFacts(t *testing.T) {\n115|\treader, _, ref, created := plannedSession(t)\n116|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n117|\tif plan.SelectorVersion != SelectorVersion || plan.Selector != \"alpha\" || plan.SessionID != idA {\n118|\t\tt.Fatalf(\"identity: %+v\", plan)\n119|\t}\n120|\tif plan.SessionRecordID != ref.RecordID {\n121|\t\tt.Fatalf(\"record digest = %q, want %q\", plan.SessionRecordID, ref.RecordID)\n122|\t}\n123|\tif plan.SourceHostID != hostA || plan.SourceAlias != nil {\n124|\t\tt.Fatalf(\"local source: host %q alias %+v\", plan.SourceHostID, plan.SourceAlias)\n125|\t}\n126|\tfor _, digest := range []string{plan.SourceIndexDigest, plan.ConfigurationDigest, plan.ExpectationDigest} {\n127|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n128|\t\t\tt.Fatalf(\"digest %q: %v\", digest, err)\n129|\t\t}\n130|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca05","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":861,"recorded_at":1780531400001717,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a089307a8e7fd3a8c81b08a6294bd3","text":"Read text file `internal/sessquery/summary_test.go`.\n1|// Authoritative summary tests for TASK-260830-21gygk (SPEC 14.7.3):\n2|// bootstrap refusal, whole-list refusal, validated host and\n3|// observation inputs, and observation-unavailable classification,\n4|// all driven through the production summary entries.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"reflect\"\n10|\t\"testing\"\n11|)\n12|\n13|// summaryReader builds a leased local session with host metadata,\n14|// winning Lease Record, and required observations for its owner.\n15|func summaryReader(t *testing.T) *Reader {\n16|\tt.Helper()\n17|\trepo, _ := repository(t)\n18|\tref := create(t, repo, idA, \"alpha\")\n19|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n20|\tpresent := true\n21|\tworkspace := WorkspaceAbsent\n22|\treader := &Reader{\n23|\t\tLocal:        repo,\n24|\t\tLocalHostID:  hostA,\n25|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n26|\t\tObservations: map[string]SessionObservations{idA: {\n27|\t\t\tProcessPresent:  &present,\n28|\t\t\tCapabilities:    map[string]CapabilitySummary{},\n29|\t\t\tWorkspaceStatus: &workspace,\n30|\t\t}},\n31|\t}\n32|\twithLeases(reader, leaseCreate(t, idA, hostA))\n33|\treturn reader\n34|}\n35|\n36|func TestSummaryBootstrapRefusals(t *testing.T) {\n37|\tlocal, _ := repository(t)\n38|\tcreate(t, local, idA, \"alpha\")\n39|\treader := &Reader{Local: local, LocalHostID: hostA}\n40|\tfor _, selector := range []string{\"alpha\", idA, \"id:\" + idA, \"alpha@local\"} {\n41|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n42|\t\t\tt.Fatalf(\"Status(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n43|\t\t}\n44|\t\tif _, err := reader.AuthoritativeStatus(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n45|\t\t\tt.Fatalf(\"AuthoritativeStatus(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n46|\t\t}\n47|\t}\n48|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrBootstrapIncomplete) {\n49|\t\tt.Fatalf(\"AuthoritativeList = %v, want selector_bootstrap_incomplete\", err)\n50|\t}\n51|\t// Explicit local inspection keeps raw access to the recovery\n52|\t// diagnostics: it is not a public summary entry.\n53|\tinspected, err := reader.InspectLocal(idA)\n54|\tif err != nil || inspected.Projection.SessionID != idA {\n55|\t\tt.Fatalf(\"InspectLocal = %+v, %v\", inspected, err)\n56|\t}\n57|}\n58|\n59|func TestSummaryMixedListRefusesWhole(t *testing.T) {\n60|\trepo, _ := repository(t)\n61|\thealthy := create(t, repo, idA, \"alpha\")\n62|\tappendEvent(t, repo, idA, healthy.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": healthy.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n63|\tcreate(t, repo, idB, \"Zed\")\n64|\treader := &Reader{\n65|\t\tLocal:        repo,\n66|\t\tLocalHostID:  hostA,\n67|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n68|\t}\n69|\t// One unrepresentable record refuses the whole document: no\n70|\t// partial rows escape, and the healthy entry is not silently\n71|\t// kept while the incomplete one is omitted.\n72|\trows, err := reader.List()\n73|\tif !errors.Is(err, ErrBootstrapIncomplete) || rows != nil {\n74|\t\tt.Fatalf(\"List = %d rows, %v, want whole selector_bootstrap_incomplete refusal\", len(rows), err)\n75|\t}\n76|\tauthorized, err := reader.AuthoritativeList()\n77|\tif !errors.Is(err, ErrBootstrapIncomplete) || authorized != nil {\n78|\t\tt.Fatalf(\"AuthoritativeList = %d rows, %v, want whole refusal\", len(authorized), err)\n79|\t}\n80|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca07","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":862,"recorded_at":1780531400001719,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a089307b6a7bf3a7484d910e9a5a4f","text":"Read text file `internal/sessquery/succession_test.go`.\n1|// Winning-lease succession tests for TASK-260830-21gygk (SPEC 5.3,\n2|// 14.7.2): the greatest (epoch, lease_id) winner must chain by epoch\n3|// plus one to an epoch-1 root and reference a validated checkpoint\n4|// for its session and predecessor lease. All cases drive the shared\n5|// production entries (BuildPlan/Revalidate/AuthoritativeStatus),\n6|// never the validators directly.\n7|package sessquery\n8|\n9|import (\n10|\t\"encoding/json\"\n11|\t\"errors\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// leaseCycleB is a third fencing token for cycle fixtures.\n18|const leaseCycleB = \"dddddddd-eeee-4fff-8000-222222222222\"\n19|\n20|// danglingLeaseID names no admitted record.\n21|const danglingLeaseID = \"aaaaaaaa-1111-4111-8111-111111111111\"\n22|\n23|// successorFixture builds a local session with the epoch-1 to\n24|// epoch-2 transfer event chain, ready for successor lease fixtures.\n25|func successorFixture(t *testing.T) *Reader {\n26|\tt.Helper()\n27|\treader, _, _, created := plannedSession(t)\n28|\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n29|\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n30|\treturn reader\n31|}\n32|\n33|// leaseEpochOneWithCheckpoint builds an epoch-1 non-create lease\n34|// with no predecessor and a non-null checkpoint reference.\n35|func leaseEpochOneWithCheckpoint(t *testing.T, sessionID, leaseID, holder, checkpoint string) []byte {\n36|\tt.Helper()\n37|\tvalue := map[string]any{\n38|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n39|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"lease_id\": leaseID, \"epoch\": json.Number(uint64String(1)),\n40|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": nil, \"reason\": \"recovery\",\n41|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n42|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n43|\t}\n44|\treturn identity(t, value, \"record_id\")\n45|}\n46|\n47|func TestValidSuccessorBuildsAndRevalidates(t *testing.T) {\n48|\treader := successorFixture(t)\n49|\tcheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n50|\twithCheckpoints(reader, checkpoint)\n51|\tsuccessor := leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, checkpoint))\n52|\twithLeases(reader, successor)\n53|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n54|\tif plan.LeaseEpoch != 2 || plan.LeaseID != leaseB || plan.OwnerHostID != hostA {\n55|\t\tt.Fatalf(\"successor triple: %+v\", plan)\n56|\t}\n57|\twinner, err := reader.winningLeaseFor(idA, \"direct\")\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tif plan.LeaseRecordID != winner.Digest {\n62|\t\tt.Fatalf(\"lease_record_id = %q, want successor %q\", plan.LeaseRecordID, winner.Digest)\n63|\t}\n64|\tif err := reader.Revalidate(plan); err != nil {\n65|\t\tt.Fatalf(\"valid successor plan is not current: %v\", err)\n66|\t}\n67|}\n68|\n69|func TestSuccessorCycleMustRefuse(t *testing.T) {\n70|\treader := successorFixture(t)\n71|\tfirstCheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n72|\tsecondCheckpoint := checkpointRecordBytes(t, idA, 2, leaseCycleB, hostA)\n73|\twithCheckpoints(reader, firstCheckpoint, secondCheckpoint)\n74|\t// Epoch-3 winner names the epoch-2 record, which names the\n75|\t// winner back: epochs cannot decrease around the cycle, so the\n76|\t// second link refuses.\n77|\tcycle := leaseSuccessorBytes(t, idA, 2, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, firstCheckpoint))\n78|\twinner := leaseSuccessorBytes(t, idA, 3, leaseB, hostA, leaseCycleB, checkpointDigestOf(t, secondCheckpoint))\n79|\twithLeases(reader, cycle, winner)\n80|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
