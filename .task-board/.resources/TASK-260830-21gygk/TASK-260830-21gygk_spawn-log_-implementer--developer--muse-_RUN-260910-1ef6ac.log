{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d23d","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":1913,"recorded_at":1780531400003821,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a08935-63a8-7832-b8f0-127c7ffdc3ac"},"task_id":"01a08935-63a8-7832-b8f0-127c7ffdc3ac","event":{"kind":"output","task_id":"01a08935-63a8-7832-b8f0-127c7ffdc3ac","chunk":"Read text file `internal/sessquery/union_test.go`.\n(239 line(s) above)\n240|// on the local winner succeeds, retaining the losing history.\n241|func TestBuildWithLaggingLeaseCopy(t *testing.T) {\n242|\tlocal, _ := repository(t)\n243|\tpeer, _ := repository(t)\n244|\t// Peer holds the epoch-1 replica with the same immutable record.\n245|\tpeerRef := create(t, peer, idB, \"beta\")\n246|\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n247|\t// Local holds the same record at epoch 2 with a successor lease.\n248|\tlocalRef := create(t, local, idB, \"beta\")\n249|\tif localRef.RecordID != peerRef.RecordID {\n250|\t\t// Records with the same name and session ID share the digest;\n251|\t\t// a divergence here is a fixture error, not a union case.\n252|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", localRef.RecordID, peerRef.RecordID)\n253|\t}\n254|\tcreated := appendEvent(t, local, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n255|\tlaunched := appendEvent(t, local, idB, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n256|\tappendEventAs(t, local, idB, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n257|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n258|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n259|\t})\n260|\treader := &Reader{\n261|\t\tLocal:              local,\n262|\t\tLocalHostID:        hostB,\n263|\t\tAllowlistedPeerIDs: []string{hostA},\n264|\t\tPeers:              []PeerIndex{{hostA, peer}},\n265|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n266|\t}\n267|\t// The epoch-2 winner carries complete validated succession: the\n268|\t// epoch-1 predecessor record plus the Checkpoint Record taken\n269|\t// under that predecessor which the successor references.\n270|\twithSuccessor(t, reader, idB, hostA, leaseB)\n271|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@local\", Action: ActionStatus})\n272|\tif plan.LeaseEpoch != 2 || plan.LeaseID != leaseB {\n273|\t\tt.Fatalf(\"lagging union winner: %+v\", plan)\n274|\t}\n275|\tif err := reader.Revalidate(plan); err != nil {\n276|\t\tt.Fatalf(\"lagging replica invalidated winner plan: %v\", err)\n277|\t}\n278|\t// The union still refuses a greater lease appearing elsewhere: a\n279|\t// same-epoch successor on the peer with a greater lease ID is stale.\n280|\tpeerCreated, err := chainTail(peer, idB)\n281|\tif err != nil {\n282|\t\tt.Fatal(err)\n283|\t}\n284|\tpeerLaunched := appendEvent(t, peer, idB, peerCreated, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n285|\tleaseC := \"cccccccc-dddd-4eee-8fff-111111111111\"\n286|\tappendEventAs(t, peer, idB, peerLaunched, \"lease.transferred\", 1, 2, leaseC, map[string]any{\n287|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n288|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseC,\n289|\t})\n290|\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n291|}","final_result":true}}}
