{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc2f","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":1138,"recorded_at":1780531400002271,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a08932bbb678839e484921446694b8","text":"Read text file `internal/sessquery/plan_test.go`.\n(129 line(s) above)\n130|\t}\n131|\tif plan.SourceIndexDigest == plan.ConfigurationDigest {\n132|\t\tt.Fatalf(\"index and configuration digests collide\")\n133|\t}\n134|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n135|\t\tt.Fatalf(\"lease: %+v\", plan)\n136|\t}\n137|\t// The plan binds the canonical digest of the admitted winning\n138|\t// Lease Record, never an envelope fingerprint.\n139|\twantLease, err := reader.winningLeaseFor(idA, \"direct\")\n140|\tif err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tif plan.LeaseRecordID != wantLease.Digest {\n144|\t\tt.Fatalf(\"lease_record_id = %q, want %q\", plan.LeaseRecordID, wantLease.Digest)\n145|\t}\n146|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n147|\t\tt.Fatalf(\"lease_record_id %q: %v\", plan.LeaseRecordID, err)\n148|\t}\n149|\twantHeads := append([]string{wantLease.Digest, created}, []string{}...)\n150|\tsortStringsForTest(wantHeads)\n151|\tif !reflect.DeepEqual(plan.AuthorityHeads, wantHeads) {\n152|\t\tt.Fatalf(\"heads: %+v, want %+v\", plan.AuthorityHeads, wantHeads)\n153|\t}\n154|\tif plan.Action != ActionStatus || plan.DestinationHostID != nil {\n155|\t\tt.Fatalf(\"action: %+v\", plan)\n156|\t}\n157|\tif plan.ExpectationDigest != \"sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a\" {\n158|\t\tt.Fatalf(\"empty expectations digest = %q\", plan.ExpectationDigest)\n159|\t}\n160|\tagain := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n161|\tif !reflect.DeepEqual(plan, again) {\n162|\t\tt.Fatalf(\"rebuild diverged:\\n%+v\\n%+v\", plan, again)\n163|\t}\n164|\tif err := reader.Revalidate(plan); err != nil {\n165|\t\tt.Fatalf(\"fresh plan is not current: %v\", err)\n166|\t}\n167|}\n168|\n169|func TestBuildPlanPeerSourceFacts(t *testing.T) {\n170|\tlocal, _ := repository(t)\n171|\tpeer, _ := repository(t)\n172|\tcreate(t, local, idA, \"alpha\")\n173|\tref := create(t, peer, idB, \"beta\")\n174|\tcreated := appendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n175|\t_ = created\n176|\treader := &Reader{\n177|\t\tLocal:              local,\n178|\t\tLocalHostID:        hostB,\n179|\t\tAllowlistedPeerIDs: []string{hostA},\n180|\t\tPeers:              []PeerIndex{{hostA, peer}},\n181|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n182|\t}\n183|\twithLeases(reader, leaseCreate(t, idB, hostA))\n184|\tplan := mustBuild(t, reader, PlanArgs{\n185|\t\tSelector:     \"beta@peer:workstation\",\n186|\t\tAction:       ActionAttach,\n187|\t\tDestination:  hostB,\n188|\t\tExpectations: []byte(`{\"checkpoint_id\":null}`),\n189|\t})\n190|\tif plan.SourceHostID != hostA || plan.SourceAlias == nil || *plan.SourceAlias != \"workstation\" {\n191|\t\tt.Fatalf(\"source: %+v\", plan)\n192|\t}\n193|\tif plan.SessionID != idB || plan.SessionRecordID != ref.RecordID {\n194|\t\tt.Fatalf(\"identity: %+v\", plan)\n195|\t}\n196|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n197|\t\tt.Fatalf(\"lease: %+v\", plan)\n198|\t}\n199|\tleaseWinner, err := reader.winningLeaseFor(idB, \"direct\")\n200|\tif err != nil {\n201|\t\tt.Fatal(err)\n202|\t}\n203|\tif plan.LeaseRecordID != leaseWinner.Digest {\n204|\t\tt.Fatalf(\"lease_record_id = %q, want %q\", plan.LeaseRecordID, leaseWinner.Digest)\n205|\t}\n206|\tif len(plan.AuthorityHeads) == 0 {\n207|\t\tt.Fatalf(\"heads are empty: %+v\", plan.AuthorityHeads)\n208|\t}\n209|\tif plan.DestinationHostID == nil || *plan.DestinationHostID != hostB {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc31","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":1139,"recorded_at":1780531400002273,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a08932bcbb7613945fda5aabbad822","text":"Read text file `internal/sessquery/review_test.go`.\n1|// Independent-review regression tests for TASK-260830-21gygk,\n2|// carried from the CR revision 2 review bundle\n3|// (reviewer_regression_test.go) into the candidate: cross-source\n4|// authority divergence must refuse revalidation, record-only\n5|// bootstraps must refuse summaries, and every marshalled plan must\n6|// carry the required lease attestation.\n7|package sessquery\n8|\n9|import (\n10|\t\"encoding/json\"\n11|\t\"errors\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n15|)\n16|\n17|func TestReviewerOtherSourceDivergenceMustRefuse(t *testing.T) {\n18|\tlocal, _ := repository(t)\n19|\tpeer, _ := repository(t)\n20|\tref := create(t, peer, idB, \"beta\")\n21|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n22|\treader := &Reader{Local: local, LocalHostID: hostB, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{HostID: hostA, Repo: peer}}}\n23|\twithLeases(reader, leaseCreate(t, idB, hostA))\n24|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n25|\tif err := reader.Revalidate(plan); err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tcreate(t, local, idB, \"different-record\")\n29|\tif _, err := reader.Resolve(\"id:\" + idB); err == nil {\n30|\t\tt.Fatal(\"diagnostic premise: expected record divergence\")\n31|\t} else {\n32|\t\tt.Logf(\"fresh Resolve: %v\", err)\n33|\t}\n34|\tif err := reader.Revalidate(plan); err == nil {\n35|\t\tt.Fatal(\"Revalidate accepted conflicting immutable record for the selected UUID in another allowed source\")\n36|\t}\n37|}\n38|func TestReviewerBootstrapSummaryMustRefuse(t *testing.T) {\n39|\tlocal, _ := repository(t)\n40|\tcreate(t, local, idA, \"alpha\")\n41|\treader := &Reader{Local: local, LocalHostID: hostA}\n42|\tt.Run(\"list\", func(t *testing.T) {\n43|\t\trows, err := reader.List()\n44|\t\tif err == nil {\n45|\t\t\tt.Fatalf(\"List accepted record-only bootstrap: rows=%d epoch=%d owner=%q\", len(rows), rows[0].Projection.Winner.Epoch, rows[0].Projection.OwnerHostID)\n46|\t\t}\n47|\t})\n48|\tt.Run(\"status\", func(t *testing.T) {\n49|\t\trow, err := reader.Status(\"alpha\")\n50|\t\tif err == nil {\n51|\t\t\tt.Fatalf(\"Status accepted record-only bootstrap: epoch=%d owner=%q\", row.Projection.Winner.Epoch, row.Projection.OwnerHostID)\n52|\t\t}\n53|\t})\n54|}\n55|func TestReviewerPlanRequiresLeaseRecord(t *testing.T) {\n56|\treader, _, _, _ := plannedSession(t)\n57|\t// plannedSession already carries the winning Lease Record; this\n58|\t// gate proves the plan binds its canonical digest, never an\n59|\t// envelope fingerprint, and refuses when the record is absent.\n60|\treader.LocalHostID = hostA\n61|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n62|\traw, err := plan.Marshal()\n63|\tif err != nil {\n64|\t\tt.Fatal(err)\n65|\t}\n66|\tvar fields map[string]any\n67|\tif err := json.Unmarshal(raw, &fields); err != nil {\n68|\t\tt.Fatal(err)\n69|\t}\n70|\tif _, ok := fields[\"lease_record_id\"]; !ok {\n71|\t\tt.Fatal(\"plan omits required validated lease_record_id\")\n72|\t}\n73|\twinner, err := reader.winningLeaseFor(idA, \"direct\")\n74|\tif err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\tif plan.LeaseRecordID != winner.Digest {\n78|\t\tt.Fatalf(\"lease_record_id = %q, want winning record %q\", plan.LeaseRecordID, winner.Digest)\n79|\t}\n80|\t// Absence refuses rather than binding a placeholder.\n81|\tbare, _ := repository(t)\n82|\tbareRef := create(t, bare, idA, \"alpha\")\n83|\tappendEvent(t, bare, idA, bareRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": bareRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n84|\tbareReader := &Reader{Local: bare, LocalHostID: hostA}\n85|\tif _, err := bareReader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n86|\t\tt.Fatalf(\"missing lease build = %v, want selector_observation_unavailable\", err)\n87|\t}\n88|}\n89|\n90|// TestRev3RealLeaseRecordIdentity proves the plan binds the canonical\n91|// digest of an actual validated Lease Record, never a four-field\n92|// envelope fingerprint. The fixture is validated through the\n93|// canonicaljson owner before driving the production BuildPlan entry.\n94|func TestRev3RealLeaseRecordIdentity(t *testing.T) {\n95|\tlocal, _ := repository(t)\n96|\tref := create(t, local, idA, \"alpha\")\n97|\tappendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n98|\tleaseBytes := leaseCreate(t, idA, hostA)\n99|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(leaseBytes)\n100|\tif err != nil {\n101|\t\tt.Fatal(err)\n102|\t}\n103|\tif string(field) != \"record_id\" {\n104|\t\tt.Fatalf(\"lease identity field = %q, want record_id\", string(field))\n105|\t}\n106|\treader := &Reader{Local: local, LocalHostID: hostA}\n107|\twithLeases(reader, leaseBytes)\n108|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n109|\tif plan.LeaseRecordID != digest.String() {\n110|\t\tt.Fatalf(\"lease_record_id = %q, want validated record %q\", plan.LeaseRecordID, digest.String())\n111|\t}\n112|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n113|\t\tt.Fatalf(\"lease triple not from winning record: %+v\", plan)\n114|\t}\n115|}\n116|\n117|// TestRev3DifferentAttestationMustNotAuthorize proves a different\n118|// envelope attestation never authorizes without its Lease Record: a\n119|// plan carrying a substituted digest refuses at revalidation, and a\n120|// build with no admitted record refuses instead of binding.\n121|func TestRev3DifferentAttestationMustNotAuthorize(t *testing.T) {\n122|\treader, _, _, _ := plannedSession(t)\n123|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n124|\traw, err := plan.Marshal()\n125|\tif err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\tparsed, err := ParsePlan(raw)\n129|\tif err != nil {\n130|\t\tt.Fatal(err)\n131|\t}\n132|\tif err := reader.Revalidate(parsed); err != nil {\n133|\t\tt.Fatalf(\"fresh plan with its admitted record is not current: %v\", err)\n134|\t}\n135|\t// A substituted attestation digest with no supporting record is\n136|\t// caught at shape time when malformed and at revalidation when\n137|\t// well-formed but disagreeing: hand-forge a well-formed digest for\n138|\t// another lease and prove it does not validate.\n139|\tforged := plan\n140|\tforged.LeaseID = leaseB\n141|\tforged.LeaseRecordID = plan.LeaseRecordID\n142|\tif err := reader.Revalidate(forged); !errors.Is(err, ErrPlanStale) {\n143|\t\tt.Fatalf(\"substituted lease triple = %v, want selector_plan_stale\", err)\n144|\t}\n145|\tempty, _ := repository(t)\n146|\temptyRef := create(t, empty, idA, \"alpha\")\n147|\tappendEvent(t, empty, idA, emptyRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": emptyRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n148|\temptyReader := &Reader{Local: empty, LocalHostID: hostA}\n149|\tif _, err := emptyReader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n150|\t\tt.Fatalf(\"record without lease build = %v, want selector_observation_unavailable\", err)\n151|\t}\n152|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
