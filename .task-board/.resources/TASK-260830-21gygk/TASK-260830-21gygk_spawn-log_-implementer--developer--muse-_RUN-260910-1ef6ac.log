{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b7","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":566,"recorded_at":1780531400001127,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0892fed4d75929647087c091ab8e0","text":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|\t// ErrBootstrapIncomplete reports a complete authority read proving\n61|\t// a Session Record without any valid lease: an interrupted\n62|\t// persistence prefix for the bootstrap-recovery leaf (Section\n63|\t// 14.7.4), never a public summary. A failed read keeps its\n64|\t// read-failure class instead; corrupt authority is integrity\n65|\t// failure. Wire exit binding for a CLI surface belongs to that\n66|\t// surface's leaf; this library keeps the refusal class distinct\n67|\t// and stable.\n68|\tErrBootstrapIncomplete = errors.New(\"selector_bootstrap_incomplete\")\n69|\t// ErrObservationUnavailable reports a required summary observation\n70|\t// or host metadata fact that cannot be established from validated\n71|\t// inputs. Nothing is inferred in its place: no source alias stands\n72|\t// in for host metadata, and no absent observation mints liveness,\n73|\t// capability, workspace, or timestamp facts.\n74|\tErrObservationUnavailable = errors.New(\"selector_observation_unavailable\")\n75|)\n76|\n77|// PeerIndex binds a peer identity to its already persisted learned index.\n78|// Transport/authentication and installing peer indexes are upstream owners;\n79|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n80|type PeerIndex struct {\n81|\tHostID string\n82|\tRepo   *sessrepo.Repository\n83|}\n84|\n85|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n86|// configuration layer, separately from the learned indexes. An unlisted source\n87|// is never read. Failed reads from listed sources are errors, never\n88|// empty indexes that let resolution fall through to a lower-priority UUID.\n89|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n90|//\n91|// Aliases carries the exact configured peer-alias mapping (host ID to\n92|// alias) from the same configuration owner, kept separate from the\n93|// learned index handles: a mapping without a handle contributes no\n94|// learned names, and a handle without a mapping stays reachable through\n95|// the bare union and the \"id:\" host form but never through \"peer:\".\n96|// Alias comparison is always exact, never folded, trimmed, or decoded.\n97|//\n98|// HostMetadata and Observations carry the validated host and observation\n99|// facts the authoritative summary layer requires, from their respective\n100|// owners. They are consulted only by that layer: List and Status keep\n101|// the internal read model and refuse only the unrepresentable\n102|// record-only bootstrap.\n103|//\n104|// LeaseRecords carries the validated winning-lease authority for plan\n105|// construction and revalidation, from the lease owner. Each entry is\n106|// canonical JSON for one urn:ax:schema:lease Lease Record; the reader\n107|// validates the closed shape and canonical self identity through the\n108|// canonicaljson owner, selects the greatest (epoch, lease_id) winner\n109|// per session, and binds that record digest with its tuple and holder.\n110|// Absence for a session refuses observation_unavailable; malformed\n111|// bytes refuse invalid_config. Envelope observations never substitute\n112|// for these records.\n113|//\n114|// CheckpointRecords carries the validated checkpoint authority the\n115|// winning-lease succession gate requires, from the checkpoint owner.\n116|// Each entry is canonical JSON for one urn:ax:schema:checkpoint\n117|// Checkpoint Record; the reader validates the closed shape and\n118|// canonical self identity through the sessrepo owner. Every successor\n119|// winner must reference an admitted record for its session and\n120|// predecessor lease, carrying the persistence variant the referenced\n121|// Session Record kind selects; an unresolvable, misbound, or\n122|// wrong-variant reference refuses observation_unavailable, and\n123|// malformed bytes refuse invalid_config.\n124|type Reader struct {\n125|\tLocal              *sessrepo.Repository\n126|\tLocalHostID        string\n127|\tAllowlistedPeerIDs []string\n128|\tPeers              []PeerIndex\n129|\tAliases            map[string]string\n130|\tHostMetadata       map[string]HostMetadata\n131|\tObservations       map[string]SessionObservations\n132|\tLeaseRecords       [][]byte\n133|\tCheckpointRecords  [][]byte\n134|}\n135|\n136|// Summary contains only facts derived from verified session records and events.\n137|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n138|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n139|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n140|// process liveness and sync timestamps require their respective observation\n141|// owners and are deliberately not inferred from a record or a successful read.\n142|type Summary struct {\n143|\tProjection sessstate.Projection\n144|}\n145|\n146|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n147|// visible with their blocking reason and retry; failure to enumerate the index\n148|// fails the read. No durable state is written, even for an interrupted create.\n149|// A complete read proving a record without any valid lease refuses the whole\n150|// list with selector_bootstrap_incomplete: the interrupted prefix is never\n151|// silently omitted and never returned as a public summary.\n152|func (reader *Reader) List() ([]Summary, error) {\n153|\tif reader == nil || reader.Local == nil {\n154|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n155|\t}\n156|\trows, err := reader.read(reader.Local)\n157|\tif err != nil {\n158|\t\treturn nil, err\n159|\t}\n160|\tfor _, row := range rows {\n161|\t\tif err := checkSummaryRepresentable(row); err != nil {\n162|\t\t\treturn nil, err\n163|\t\t}\n164|\t}\n165|\treturn rows, nil\n166|}\n167|\n168|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n169|\trows, err := repo.ListSessions()\n170|\tif err != nil {\n171|\t\treturn nil, err\n172|\t}\n173|\tout := make([]Summary, 0, len(rows))\n174|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n175|\tfor _, row := range rows {\n176|\t\tprojection, err := projector.Project(row.SessionID)\n177|\t\tif err != nil {\n178|\t\t\treturn nil, err\n179|\t\t}\n180|\t\tout = append(out, Summary{Projection: projection})\n181|\t}\n182|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n183|\treturn out, nil\n184|}\n185|\n186|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n187|// the same path as Resolve, then projects from the selected repository. It\n188|// never treats a failed read as not found. Parked sessions can be inspected\n189|// by ID through InspectLocal, independently of live-name routing, so\n190|// operators retain access to the recovery diagnostics.\n191|func (reader *Reader) Status(selector string) (Summary, error) {\n192|\tselected, err := reader.Resolve(selector)\n193|\tif err != nil {\n194|\t\treturn Summary{}, err\n195|\t}\n196|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n197|\tif err != nil {\n198|\t\treturn Summary{}, err\n199|\t}\n200|\tsummary := Summary{Projection: projection}\n201|\tif err := checkSummaryRepresentable(summary); err != nil {\n202|\t\treturn Summary{}, err\n203|\t}\n204|\treturn summary, nil\n205|}\n206|\n207|// InspectLocal reads one local ID, including a parked or tombstoned session.\n208|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n209|\tif reader == nil || reader.Local == nil {\n210|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n211|\t}\n212|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n213|\tif err != nil {\n214|\t\treturn Summary{}, err\n215|\t}\n216|\treturn Summary{Projection: projection}, nil\n217|}\n218|\n219|// Selection identifies the session and source index, never an attach or mutation\n220|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n221|type Selection struct {\n222|\tSessionID  string\n223|\tPeerHostID string\n224|\trepo       *sessrepo.Repository\n225|}\n226|\n227|type candidate struct {\n228|\tsummary   Summary\n229|\tselection Selection\n230|}\n231|\n232|// Resolve applies one parsed selector through the single shared path:\n233|// grammar first, then effective-configuration validation, then the\n234|// source tier. A bare selector retains the exact Section 2.3 tiers:\n235|// local exact live name, allowlisted peer exact live name, exact UUID,\n236|// not found. An \"id:\" key bypasses names for the durable UUID in the\n237|// local and allowed-peer union. A qualified selector resolves its key\n238|// in exactly one source index with no fallback. ASCII folding detects\n239|// collisions within each name tier; it does not turn a unique case\n240|// variant into an exact match. Repository-parked entries (failed reads,\n241|// never tombstone evidence) and tombstoned entries (authoritative\n242|// tombstone evidence) are not live candidates. A tier that must be\n243|// read but cannot be read is a read failure, not permission to proceed\n244|// to a lower tier. This is logical index eligibility, not proof of\n245|// process liveness or safe attach/resume readiness; those decisions\n246|// belong to the action planner invoking plans at its boundaries.\n247|func (reader *Reader) Resolve(selector string) (Selection, error) {\n248|\tparsed, err := ParseSelector(selector)\n249|\tif err != nil {\n250|\t\treturn Selection{}, err\n251|\t}\n252|\tif reader == nil || reader.Local == nil {\n253|\t\treturn Selection{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n254|\t}\n255|\tconfig, err := reader.validatedConfiguration()\n256|\tif err != nil {\n257|\t\treturn Selection{}, err\n258|\t}\n259|\tif parsed.Source != SourceBare {\n260|\t\treturn reader.resolveExplicit(parsed, config)\n261|\t}\n262|\treturn reader.resolveBare(parsed, config)\n263|}\n264|\n265|// resolveBare applies the Section 2.3 tiers over the local and\n266|// allowed-peer union. Unread lower tiers are never consulted after a\n267|// unique higher-tier match; a tier that must be read but cannot be\n268|// read fails the resolution instead of falling through.\n269|func (reader *Reader) resolveBare(parsed Selector, config validatedConfig) (Selection, error) {\n270|\tlocal, err := reader.read(reader.Local)\n271|\tif err != nil {\n272|\t\treturn Selection{}, err\n273|\t}\n274|\tlocalLive := liveCandidates(local, reader.Local, \"\")\n275|\t// Peer tiers read lazily: a unique local name match never depends\n276|\t// on lower-tier reads, but any tier that must be read and cannot\n277|\t// be read fails instead of falling through.\n278|\tpeers, peersRead := []candidate(nil), false\n279|\treadPeers := func() ([]candidate, error) {\n280|\t\tif !peersRead {\n281|\t\t\tpeersRead = true\n282|\t\t\tvar err error\n283|\t\t\tpeers, err = reader.peerCandidates()\n284|\t\t\tif err != nil {\n285|\t\t\t\treturn nil, err\n286|\t\t\t}\n287|\t\t}\n288|\t\treturn peers, nil\n289|\t}\n290|\tif parsed.IDKey {\n291|\t\tunion, err := readPeers()\n292|\t\tif err != nil {\n293|\t\t\treturn Selection{}, err\n294|\t\t}\n295|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), append(localLive, union...), config)\n296|\t}\n297|\tif match, found, err := matchName(localLive, parsed.Key); found || err != nil {\n298|\t\treturn match, err\n299|\t}\n300|\tunion, err := readPeers()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
