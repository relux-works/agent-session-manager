{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc93","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":1188,"recorded_at":1780531400002371,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a08933-0389-7912-a17a-4e52877375cf"},"task_id":"01a08933-0389-7912-a17a-4e52877375cf","event":{"kind":"output","task_id":"01a08933-0389-7912-a17a-4e52877375cf","chunk":"Read text file `internal/sessquery/lease.go`.\n(185 line(s) above)\n186|// parseCheckpointRecord validates one canonical Checkpoint Record\n187|// through the sessrepo owner (closed shape plus canonical self\n188|// identity) and extracts the bound members. Closed-shape and\n189|// identity failures refuse invalid_config; the caller maps an\n190|// unresolvable reference to observation_unavailable.\n191|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n192|\tvar checkpoint validatedCheckpoint\n193|\tmembers, fault := environ.DecodeStrictObject(raw)\n194|\tif fault != nil {\n195|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n196|\t}\n197|\tschema, err := leaseStringMember(members, \"schema\")\n198|\tif err != nil || schema != checkpointRecordSchema {\n199|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n200|\t}\n201|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n202|\tif err != nil {\n203|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n204|\t}\n205|\tif field != canonicaljson.SelfCheckpointID {\n206|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n207|\t}\n208|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n209|\tif !ok {\n210|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n211|\t}\n212|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n213|\tif !ok {\n214|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n215|\t}\n216|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n217|\tif err != nil {\n218|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n219|\t}\n220|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n221|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n222|\t}\n223|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n224|\tif !ok {\n225|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n226|\t}\n227|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n228|\tif err != nil {\n229|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n230|\t}\n231|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n232|\tif err != nil {\n233|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n234|\t}\n235|\tcheckpoint = validatedCheckpoint{\n236|\t\tDigest:              digest.String(),\n237|\t\tSessionID:           sessionID.String(),\n238|\t\tLeaseEpoch:          epoch,\n239|\t\tLeaseID:             leaseID,\n240|\t\tCreatorHostID:       creator.String(),\n241|\t\tHasProviderManifest: hasProvider,\n242|\t\tHasTaskBoardBundle:  hasBoard,\n243|\t\tRaw:                 append([]byte(nil), raw...),\n244|\t}\n245|\treturn checkpoint, nil\n246|}\n247|\n248|// validatedLeasesBySession validates every supplied Lease Record and\n249|// groups the admitted records by session UUID.\n250|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n251|\tout := map[string][]validatedLease{}\n252|\tif reader == nil {\n253|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n254|\t}\n255|\tfor _, raw := range reader.LeaseRecords {\n256|\t\tlease, err := parseLeaseRecord(raw)\n257|\t\tif err != nil {\n258|\t\t\treturn nil, err\n259|\t\t}\n260|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n261|\t}\n262|\treturn out, nil\n263|}\n264|\n265|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n266|// Record for one session and validates its succession: the\n267|// predecessor ancestry must chain by epoch plus one down to an\n268|// epoch-1 root, and every lease in that winning ancestry above\n269|// epoch 1 must reference a validated checkpoint for its session and\n270|// predecessor lease (Section 5.3), each created by the owning lease\n271|// holder (Section 5.4). Every required checkpoint must additionally\n272|// carry the persistence variant the referenced Session Record\n273|// selects: sessionKind is that record's kind as projected from the\n274|// winning source, and a variant mismatch refuses\n275|// observation_unavailable even when canonical identity, session,\n276|// lease, epoch, and creator all agree. Absence refuses\n277|// observation_unavailable; a lease above epoch 1 without its named\n278|// predecessor in the admitted set refuses the same class rather than\n279|// binding a dangling successor, while an illegal predecessor link is\n280|// malformed authority (integrity failure).\n281|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string) (validatedLease, error) {\n282|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n283|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n284|\t}\n285|\tbySession, err := reader.validatedLeasesBySession()\n286|\tif err != nil {\n287|\t\treturn validatedLease{}, err\n288|\t}\n289|\tcandidates := bySession[sessionID]\n290|\tif len(candidates) == 0 {\n291|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n292|\t}\n293|\twinner := candidates[0]\n294|\tfor _, candidate := range candidates[1:] {\n295|\t\tif sessstate.Compare(\n296|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n297|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n298|\t\t) > 0 {\n299|\t\t\twinner = candidate\n300|\t\t}\n301|\t}\n302|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n303|\tif err != nil {\n304|\t\treturn validatedLease{}, err\n305|\t}\n(more lines below)","final_result":true}}}
