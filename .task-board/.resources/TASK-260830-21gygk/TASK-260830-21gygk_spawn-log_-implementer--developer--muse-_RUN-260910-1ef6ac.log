umber(fmtSprintUint64(value)).String()\n134|}\n135|\n136|func fmtSprintUint64(value uint64) string {\n137|\tif value == 0 {\n138|\t\treturn \"0\"\n139|\t}\n140|\tvar digits []byte\n141|\tfor value > 0 {\n142|\t\tdigits = append([]byte{byte('0' + value%10)}, digits...)\n143|\t\tvalue /= 10\n144|\t}\n145|\treturn string(digits)\n146|}\n147|\n148|// leaseCreate returns an epoch-1 create Lease Record for the standard\n149|// test lease and holder.\n150|func leaseCreate(t *testing.T, sessionID, holder string) []byte {\n151|\tt.Helper()\n152|\treturn leaseRecordBytes(t, sessionID, 1, lease, holder, \"\", false)\n153|}\n154|\n155|// checkpointRecordBytes builds one validated Checkpoint Record bound\n156|// to (sessionID, epoch, leaseID): the checkpoint a successor lease\n157|// references for its session and predecessor lease. The record is\n158|// identified through the canonicaljson owner before return, so a\n159|// fixture failure surfaces here, never as a production admission.\n160|func checkpointRecordBytes(t *testing.T, sessionID string, epoch uint64, leaseID, creator string) []byte {\n161|\tt.Helper()\n162|\tvalue := map[string]any{\n163|\t\t\"schema\": \"urn:ax:schema:checkpoint\", \"schema_version\": \"1.0.0\", \"checkpoint_id\": zeroDigest,\n164|\t\t\"subject_id\": sessionID, \"session_id\": sessionID,\n165|\t\t\"lease_epoch\": json.Number(uint64String(epoch)), \"lease_id\": leaseID,\n166|\t\t\"safe_boundary\": map[string]any{\n167|\t\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"evidence\": \"accepted_test\",\n168|\t\t\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true,\n169|\t\t\t\"open_processes\": json.Number(\"0\"), \"open_database_handles\": json.Number(\"0\"),\n170|\t\t},\n171|\t\t\"event_heads\":           []string{zeroDigest},\n172|\t\t\"workspace_manifest_id\": zeroDigest,\n173|\t\t\"provider_manifest_id\":  zeroDigest,\n174|\t\t\"task_board_bundle_id\":  nil,\n175|\t\t\"created_by_host_id\":    creator,