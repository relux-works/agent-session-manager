/summary_test.go:144:func TestAuthoritativeUnknownLocalHostRefuses(t *testing.T) {\\ninternal/sessquery/summary_test.go:152:func TestAuthoritativeCheckpointRequiresTimestamp(t *testing.T) {\\ninternal/sessquery/summary_test.go:200:func TestAuthoritativeInputValidation(t *testing.T) {\\ninternal/sessquery/summary_test.go:290:func TestAuthoritativeOptionalObservations(t *testing.T) {\\ninternal/sessquery/summary_test.go:325:func TestAuthoritativeAdmitsFullCapabilityRegistry(t *testing.T) {\\ninternal/sessquery/summary_test.go:362:func TestAuthoritativeUnknownObservationsRefuse(t *testing.T) {\\ninternal/sessquery/summary_test.go:388:func TestAuthoritativeMissingCapabilitiesRefuses(t *testing.T) {\\ninternal/sessquery/summary_test.go:406:func TestAuthoritativeMissingProcessRefusesStatus(t *testing.T) {\\ninternal/sessquery/summary_test.go:424:func TestAuthoritativeMissingWorkspaceRefuses(t *testing.T) {\\ninternal/sessquery/summary_test.go:441:func TestAuthoritativeHostNameBound64(t *testing.T) {\\n\",\n  \"original_output_bytes\": 1857,\n  \"original_output_tokens\": 465,\n  \"truncated\": false\n}","final_result":true}}}
