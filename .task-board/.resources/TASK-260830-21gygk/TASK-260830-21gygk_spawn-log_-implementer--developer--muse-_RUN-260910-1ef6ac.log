{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c867","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":654,"recorded_at":1780531400001303,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a08930-20b8-7d82-a8da-853f25c2feb3"},"task_id":"01a08930-20b8-7d82-a8da-853f25c2feb3","event":{"kind":"output","task_id":"01a08930-20b8-7d82-a8da-853f25c2feb3","chunk":"Read text file `internal/sessrepo/sessrepo.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|)\n11|\n12|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6. It is\n13|// passed to the environ bound checker, never re-enforced here.\n14|const uint53Max = uint64(1<<53 - 1)\n15|\n16|const (\n17|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n18|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n19|)\n20|\n21|var (\n22|\tErrInvalidRecord   = errors.New(\"invalid session record\")\n23|\tErrSessionExists   = errors.New(\"session already exists\")\n24|\tErrUnknownSession  = errors.New(\"unknown session\")\n25|\tErrInvalidEvent    = errors.New(\"invalid session event\")\n26|\tErrSequenceGap     = errors.New(\"event source sequence gap\")\n27|\tErrSequenceRepeat  = errors.New(\"event source sequence repeat\")\n28|\tErrPredecessorLink = errors.New(\"event predecessor link mismatch\")\n29|\tErrDivergentBranch = errors.New(\"divergent lease branch preserved without application\")\n30|\tErrStaleLease      = errors.New(\"event lease epoch precedes the chain head\")\n31|\tErrChainCorrupt    = errors.New(\"session event chain is corrupt\")\n32|\tErrUnknownEvent    = errors.New(\"unknown session event\")\n33|\tErrNameAmbiguous   = errors.New(\"name_ambiguous\")\n34|\tErrNameNotFound    = errors.New(\"session name not found\")\n35|\tErrRepositoryPath  = errors.New(\"invalid session repository path\")\n36|)\n37|\n38|// refuse is the single refusal funnel every sessrepo rejection flows\n39|// through. It is a var so the census TestMain can wrap it and record the\n40|// production file:line behind each exercised refusal. No production path\n41|// wraps a sentinel with fmt.Errorf directly.\n42|var refuse = func(sentinel error, format string, arguments ...any) error {\n43|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n44|}\n45|\n46|// SessionRef names one persisted session: its Session Record digest and ID.\n47|type SessionRef struct {\n48|\tSessionID string\n49|\tRecordID  string\n50|}\n51|\n52|// EventRef names one chained event: its digest, lease sequence, and position.\n53|type EventRef struct {\n54|\tSessionID     string\n55|\tEventID       string\n56|\tLeaseSequence uint64\n57|\tPosition      int\n58|}\n59|\n60|// EventSummary is the chain-index entry for one event, derived from the\n61|// validated event bytes at append time and re-verified against them on load.\n62|type EventSummary struct {\n63|\tEventID       string   `json:\"event_id\"`\n64|\tEventType     string   `json:\"event_type\"`\n65|\tLeaseEpoch    uint64   `json:\"lease_epoch\"`\n66|\tLeaseID       string   `json:\"lease_id\"`\n67|\tLeaseSequence uint64   `json:\"lease_sequence\"`\n68|\tPredecessors  []string `json:\"predecessors\"`\n69|}\n70|\n71|// SessionSummary is the Section 14.4 list projection this leaf owns: stored\n72|// identity plus chain-head facts for a healthy session, or the per-session\n73|// parked channel for an interrupted create or a torn store. Owner host,\n74|// checkpoint age, capability status, and rendered warnings are derived\n75|// downstream, never here; the parked fields below are the facts the\n76|// Section 5.7 reducer and the Section 14.4 rendering leaves project from.\n77|//\n78|// A healthy entry carries Parked=false with empty BlockingReason and\n79|// RetryHint. A parked entry carries Parked=true, SessionID set to the\n80|// session directory name, BlockingReason naming the load failure (a\n81|// recoverable_parked_state block with its per-session cause), and RetryHint\n82|// naming the same-operation retry. Identity members (RecordID, Name, Kind,\n83|// ProviderID) are filled from the parked record when it still verifies;\n84|// a bare directory with no verifiable record leaves them empty.\n85|type SessionSummary struct {\n86|\tSessionID      string\n87|\tRecordID       string\n88|\tName           string\n89|\tKind           string\n90|\tProviderID     string\n91|\tEventCount     int\n92|\tTailEvent      string\n93|\tParked         bool\n94|\tBlockingReason string\n95|\tRetryHint      string\n96|}\n97|\n98|// retryHintForParkedRecord names the same-operation retry for a parked\n99|// session: a record is already parked, so only the byte-identical record\n100|// resumes through CreateSession.\n101|const retryHintForParkedRecord = \"retry CreateSession with the byte-identical session record\"\n102|\n103|// retryHintForBareDirectory names the same-operation retry for a bare\n104|// session directory: no record is parked yet, so CreateSession with the\n105|// session record for this session ID resumes.\n106|const retryHintForBareDirectory = \"retry CreateSession with the session record for this session ID\"\n107|\n108|// CreateStep names one durable boundary inside CreateSession's four-step\n109|// span: the session directory, the record install, the events directory,\n110|// and the chain index install, in that order.\n111|type CreateStep string\n112|\n113|const (\n114|\tCreateStepSessionDir CreateStep = \"session-dir\"\n115|\tCreateStepRecord     CreateStep = \"record\"\n116|\tCreateStepEventsDir  CreateStep = \"events-dir\"\n117|\tCreateStepChain      CreateStep = \"chain\"\n118|)\n119|\n120|// Repository persists Session Records and per-session event chains under\n121|// one data root. All mutating entries serialize on one mutex; files are\n122|// content-addressed and installed no-replace, so the chain is append-only\n123|// by construction and there is no update or delete entry to test.\n124|//\n125|// BeforeWrite fires after validation and before the first durable byte;\n126|// AfterCommit fires after the chain index is durable. AfterCreateStep\n127|// fires after each CreateStep inside CreateSession's four-step span, so\n128|// an interrupted create — not only a fault outside it — is drivable.\n129|// All three are nil in normal operation. Tests connect them to a\n130|// secconftest Injector firing the owner's own points: a fault before\n131|// any durable byte carries safe_retry, and a fault past any durable\n132|// step — including every interior boundary, whose parked state the\n133|// identical retry resumes — carries recoverable_parked_state.\n134|type Repository struct {\n135|\troot            string\n136|\tmutex           sync.Mutex\n137|\tBeforeWrite     func() error\n138|\tAfterCommit     func() error\n139|\tAfterCreateStep func(CreateStep) error\n140|}\n141|\n142|// Open binds a repository to the sessions namespace beneath dataRoot,\n143|// creating it owner-only when absent. The root must be absolute.\n144|func Open(dataRoot string) (*Repository, error) {\n145|\tif !filepath.IsAbs(dataRoot) {\n146|\t\treturn nil, refuse(ErrRepositoryPath, \"data root %q is not absolute\", dataRoot)\n147|\t}\n148|\troot := filepath.Join(dataRoot, \"sessions\")\n149|\tif err := os.MkdirAll(root, 0o700); err != nil {\n150|\t\treturn nil, refuse(ErrRepositoryPath, \"create sessions root %q: %v\", root, err)\n151|\t}\n152|\treturn &Repository{root: root}, nil\n153|}\n154|\n155|// CreateSession validates recordJSON through the canonical owner and\n156|// persists it as a new session. The bytes are stored verbatim.\n157|func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\n158|\trecord, err := decodeSessionRecord(recordJSON)\n159|\tif err != nil {\n160|\t\treturn SessionRef{}, err\n161|\t}\n162|\trepository.mutex.Lock()\n163|\tdefer repository.mutex.Unlock()\n164|\tif repository.BeforeWrite != nil {\n165|\t\tif err := repository.BeforeWrite(); err != nil {\n166|\t\t\treturn SessionRef{}, err\n167|\t\t}\n168|\t}\n169|\tdirectory := repository.sessionDir(record.sessionID)\n170|\tif _, err := os.Stat(directory); err == nil {\n171|\t\tresumed, resumeErr := repository.resumeCreateLocked(directory, record, recordJSON)\n172|\t\tif resumeErr != nil {\n173|\t\t\treturn SessionRef{}, resumeErr\n174|\t\t}\n175|\t\tif !resumed {\n176|\t\t\treturn SessionRef{}, refuse(ErrSessionExists, \"session %s already exists\", record.sessionID)\n177|\t\t}\n178|\t} else {\n179|\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n180|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session directory: %w\", err)\n181|\t\t}\n182|\t\tif err := repository.crashCreateStep(CreateStepSessionDir); err != nil {\n183|\t\t\treturn SessionRef{}, err\n184|\t\t}\n185|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n186|\t\t\treturn SessionRef{}, fmt.Errorf(\"install session record: %w\", err)\n187|\t\t}\n188|\t\tif err := repository.crashCreateStep(CreateStepRecord); err != nil {\n189|\t\t\treturn SessionRef{}, err\n190|\t\t}\n191|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n192|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session events directory: %w\", err)\n193|\t\t}\n194|\t\tif err := repository.crashCreateStep(CreateStepEventsDir); err != nil {\n195|\t\t\treturn SessionRef{}, err\n196|\t\t}\n197|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n198|\t\t\treturn SessionRef{}, err\n199|\t\t}\n200|\t\tif err := repository.crashCreateStep(CreateStepChain); err != nil {\n201|\t\t\treturn SessionRef{}, err\n202|\t\t}\n203|\t}\n204|\tif repository.AfterCommit != nil {\n205|\t\tif err := repository.AfterCommit(); err != nil {\n206|\t\t\treturn SessionRef{}, err\n207|\t\t}\n208|\t}\n209|\treturn SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil\n210|}\n211|\n212|// crashCreateStep fires the AfterCreateStep hook after one durable create\n213|// step. It is nil-safe: unhooked production never faults. A hook error —\n214|// the injected secconftest fault in tests — propagates unwrapped so the\n215|// caller observes the owner's point and outcome.\n216|func (repository *Repository) crashCreateStep(step CreateStep) error {\n217|\tif repository.AfterCreateStep == nil {\n218|\t\treturn nil\n219|\t}\n220|\treturn repository.AfterCreateStep(step)\n221|}\n222|\n223|// resumeCreateLocked completes a create that crashed inside the four-step\n224|// span. Two parked states resume:\n225|//\n226|//   - record absent: the crash landed after the session directory and\n227|//     before the record install, so nothing committed. The chain index\n228|//     must also be absent — a chain without a record is torn foreign\n229|//     state, never a resume — and the retry's bytes become the record.\n230|//   - record present with the retried bytes and the chain still absent:\n231|//     the crash landed between the record write and the chain write, and\n232|//     the retry completes the index.\n233|//\n234|// Anything else is not a resume — a completed create, or a colliding\n235|// record under a live session ID — and the caller refuses it as an\n236|// existing session. It returns plain operational errors; refusal\n237|// attribution stays at the caller.\n238|func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {\n239|\texisting, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n240|\tif err != nil {\n241|\t\tif !os.IsNotExist(err) {\n242|\t\t\treturn false, fmt.Errorf(\"read session record for resume: %w\", err)\n243|\t\t}\n244|\t\tif _, statErr := os.Stat(filepath.Join(directory, \"chain.json\")); statErr == nil {\n245|\t\t\treturn false, nil\n246|\t\t}\n247|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n248|\t\t\treturn false, fmt.Errorf(\"install session record on resume: %w\", err)\n249|\t\t}\n250|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n251|\t\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n252|\t\t}\n253|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n254|\t\t\treturn false, err\n255|\t\t}\n256|\t\treturn true, nil\n257|\t}\n258|\tif !bytes.Equal(existing, recordJSON) {\n259|\t\treturn false, nil\n260|\t}\n261|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); err == nil {\n262|\t\treturn false, nil\n263|\t}\n264|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n265|\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n266|\t}\n267|\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n268|\t\treturn false, err\n269|\t}\n270|\treturn true, nil\n271|}\n272|\n273|// AppendEvent validates eventJSON through the canonical owner and links it\n274|// onto the session chain after the continuity checks. A byte-identical\n275|// retry of an already chained event returns its existing reference without\n276|// duplicating the chain, so a retry after a crashed commit is safe.\n277|func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\n278|\tevent, err := decodeSessionEvent(eventJSON)\n279|\tif err != nil {\n280|\t\treturn EventRef{}, err\n281|\t}\n282|\tif event.sessionID != sessionID {\n283|\t\treturn EventRef{}, refuse(ErrInvalidEvent, \"event session %s does not match target session %s\", event.sessionID, sessionID)\n284|\t}\n285|\trepository.mutex.Lock()\n286|\tdefer repository.mutex.Unlock()\n287|\tview, err := repository.loadSessionLocked(sessionID)\n288|\tif err != nil {\n289|\t\treturn EventRef{}, err\n290|\t}\n291|\tfor position, existing := range view.chain.Events {\n292|\t\tif existing.EventID == event.eventID {\n293|\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n294|\t\t}\n295|\t}\n296|\tif repository.BeforeWrite != nil {\n297|\t\tif err := repository.BeforeWrite(); err != nil {\n298|\t\t\treturn EventRef{}, err\n299|\t\t}\n300|\t}\n301|\tvar tail *EventSummary\n302|\tif len(view.chain.Events) > 0 {\n303|\t\tprevious := view.chain.Events[len(view.chain.Events)-1]\n304|\t\ttail = &previous\n305|\t}\n306|\tif err := checkAppend(view.chain.RecordID, tail, event); err != nil {\n307|\t\t// Losing-lease branches are preserved as immutable blobs but never\n308|\t\t// applied: the bytes stay addressable while the chain is untouched.\n309|\t\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\n310|\t\t\tif preserveErr := installEventBlob(filepath.Join(view.directory, \"events\", blobFileName(event.eventID)), eventJSON); preserveErr != nil {\n311|\t\t\t\treturn EventRef{}, fmt.Errorf(\"preserve unapplied branch: %v: %w\", preserveErr, err)\n312|\t\t\t}\n313|\t\t}\n314|\t\treturn EventRef{}, err\n315|\t}\n316|\tblobPath := filepath.Join(view.directory, \"events\", blobFileName(event.eventID))\n317|\tif err := installEventBlob(blobPath, eventJSON); err != nil {\n318|\t\tif errors.Is(err, errDigestDisagreement) {\n319|\t\t\treturn EventRef{}, refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for event\")\n320|\t\t}\n321|\t\treturn EventRef{}, err\n322|\t}\n323|\tnext := append(append([]EventSummary(nil), view.chain.Events...), eventSummary(event))\n324|\tif err := repository.writeChain(view.directory, storedChain{RecordID: view.chain.RecordID, Events: next}); err != nil {\n325|\t\treturn EventRef{}, err\n326|\t}\n327|\tif repository.AfterCommit != nil {\n328|\t\tif err := repository.AfterCommit(); err != nil {\n329|\t\t\treturn EventRef{}, err\n330|\t\t}\n331|\t}\n332|\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: event.leaseSeq, Position: len(next) - 1}, nil\n333|}\n334|\n335|// eventSummary projects the validated routing members into the chain index.\n336|func eventSummary(event eventView) EventSummary {\n337|\treturn EventSummary{EventID: event.eventID, EventType: event.eventType, LeaseEpoch: event.leaseEpoch, LeaseID: event.leaseID, LeaseSequence: event.leaseSeq, Predecessors: append([]string(nil), event.predecessors...)}\n338|}","final_result":true}}}
