{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d45f","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":2186,"recorded_at":1780531400004367,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a08936-4219-7bf1-82ec-9513333b1431"},"task_id":"01a08936-4219-7bf1-82ec-9513333b1431","event":{"kind":"output","task_id":"01a08936-4219-7bf1-82ec-9513333b1431","chunk":"Read text file `internal/sessquery/rev6_regression_test.go`.\n1|// Checkpoint persistence-variant regression tests for TASK-260830-21gygk\n2|// (SPEC 5.4, CR6 P1): the referenced Session Record selects the\n3|// persistence variant. A direct session admits only a provider-manifest\n4|// checkpoint; a task_board session admits only a task-board-bundle\n5|// checkpoint. Canonical identity, session, lease, epoch, and creator\n6|// agreement alone never admit a swapped variant. Every case drives\n7|// the four shared production entries (BuildPlan, Revalidate fresh and\n8|// old-plan, AuthoritativeStatus, AuthoritativeList), never the\n9|// validators directly.\n10|package sessquery\n11|\n12|import (\n13|\t\"encoding/json\"\n14|\t\"errors\"\n15|\t\"testing\"\n16|)\n17|\n18|// TestRev6CheckpointPersistenceMustMatchSession ports the CR6 reviewer\n19|// regression: a task_board-bundle checkpoint for a direct session\n20|// refuses on the winner path and on a necessary-ancestor path,\n21|// including old-plan revalidation after only the ancestor variant\n22|// changes. Both direct controls pass.\n23|func TestRev6CheckpointPersistenceMustMatchSession(t *testing.T) {\n24|\tfor _, ancestor := range []bool{false, true} {\n25|\t\tpath := \"winner\"\n26|\t\tif ancestor {\n27|\t\t\tpath = \"ancestor\"\n28|\t\t}\n29|\t\tfor _, wrong := range []bool{false, true} {\n30|\t\t\tmode := \"direct_control\"\n31|\t\t\tif wrong {\n32|\t\t\t\tmode = \"task_board_checkpoint_for_direct_session\"\n33|\t\t\t}\n34|\t\t\tt.Run(path+\"/\"+mode, func(t *testing.T) {\n35|\t\t\t\tgood := checkpointRecordBytes(t, idA, 1, lease, hostA)\n36|\t\t\t\tcp := good\n37|\t\t\t\tif wrong {\n38|\t\t\t\t\tvar value map[string]any\n39|\t\t\t\t\tif err := json.Unmarshal(good, &value); err != nil {\n40|\t\t\t\t\t\tt.Fatal(err)\n41|\t\t\t\t\t}\n42|\t\t\t\t\tvalue[\"task_board_bundle_id\"] = value[\"provider_manifest_id\"]\n43|\t\t\t\t\tvalue[\"provider_manifest_id\"] = nil\n44|\t\t\t\t\tcp = identity(t, value, \"checkpoint_id\")\n45|\t\t\t\t}\n46|\t\t\t\tvar r *Reader\n47|\t\t\t\tif ancestor {\n48|\t\t\t\t\tr = rev5AncestorFixture(t, good)\n49|\t\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n50|\t\t\t\t\tif wrong {\n51|\t\t\t\t\t\t// Preserve the winner digest and event bytes; alter only the\n52|\t\t\t\t\t\t// ancestor's checkpoint variant, retaining canonical identities.\n53|\t\t\t\t\t\tr.CheckpointRecords[0] = cp\n54|\t\t\t\t\t\tfor i, raw := range r.LeaseRecords {\n55|\t\t\t\t\t\t\tvar value map[string]any\n56|\t\t\t\t\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n57|\t\t\t\t\t\t\t\tt.Fatal(err)\n58|\t\t\t\t\t\t\t}\n59|\t\t\t\t\t\t\tif value[\"lease_id\"] == leaseB {\n60|\t\t\t\t\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, cp)\n61|\t\t\t\t\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n62|\t\t\t\t\t\t\t}\n63|\t\t\t\t\t\t}\n64|\t\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n65|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admits wrong persistence variant in necessary ancestor\")\n66|\t\t\t\t\t\t}\n67|\t\t\t\t\t}\n68|\t\t\t\t} else {\n69|\t\t\t\t\tr = successorFixture(t)\n70|\t\t\t\t\tgoodCp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n71|\t\t\t\t\twithCheckpoints(r, goodCp)\n72|\t\t\t\t\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, goodCp)))\n73|\t\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n74|\t\t\t\t\tif wrong {\n75|\t\t\t\t\t\t// Swap only the winner checkpoint variant, keeping the\n76|\t\t\t\t\t\t// lease tuple, event bytes, and canonical identities.\n77|\t\t\t\t\t\tr.CheckpointRecords[0] = cp\n78|\t\t\t\t\t\tfor i, raw := range r.LeaseRecords {\n79|\t\t\t\t\t\t\tvar value map[string]any\n80|\t\t\t\t\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n81|\t\t\t\t\t\t\t\tt.Fatal(err)\n82|\t\t\t\t\t\t\t}\n83|\t\t\t\t\t\t\tif value[\"lease_id\"] == leaseB {\n84|\t\t\t\t\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, cp)\n85|\t\t\t\t\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n86|\t\t\t\t\t\t\t}\n87|\t\t\t\t\t\t}\n88|\t\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n89|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admits wrong persistence variant in winner checkpoint\")\n90|\t\t\t\t\t\t}\n91|\t\t\t\t\t}\n92|\t\t\t\t}\n93|\t\t\t\trev5CheckEntries(t, r, wrong)\n94|\t\t\t})\n95|\t\t}\n96|\t}\n97|}\n98|\n99|// taskBoardRecordBytes builds one validated task_board Session Record\n100|// for tests, following the SPEC 5.1 task_board example with a\n(more lines below)","final_result":true}}}
