{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d1","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":451,"recorded_at":1780531400000897,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a0892f-c282-7fe1-a51b-23fe0e96b20d"},"task_id":"01a0892f-c282-7fe1-a51b-23fe0e96b20d","event":{"kind":"output","task_id":"01a0892f-c282-7fe1-a51b-23fe0e96b20d","chunk":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is one admitted Checkpoint Record: its canonical\n48|// digest with the session and lease it was taken under, plus the host\n49|// that created it. Section 5.4 binds lease_epoch/lease_id to the\n50|// referenced winning lease, so a successor's checkpoint names its\n51|// predecessor lease, and binds created_by_host_id to the current\n52|// lease holder: the holder of the lease the checkpoint names. The\n53|// persistence presence members carry which variant the record uses;\n54|// the referenced Session Record selects which variant is valid\n55|// (checkCheckpointPersistence), because canonical shape alone admits\n56|// either variant.\n57|type validatedCheckpoint struct {\n58|\tDigest              string\n59|\tSessionID           string\n60|\tLeaseEpoch          uint64\n61|\tLeaseID             string\n62|\tCreatorHostID       string\n63|\tHasProviderManifest bool\n64|\tHasTaskBoardBundle  bool\n65|\tRaw                 []byte\n66|}\n67|\n68|// parseLeaseRecord validates one canonical Lease Record through the\n69|// canonicaljson owner and extracts the bound members. Closed-shape and\n70|// identity failures refuse invalid_config; the caller maps absence to\n71|// observation_unavailable.\n72|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n73|\tvar lease validatedLease\n74|\tmembers, fault := environ.DecodeStrictObject(raw)\n75|\tif fault != nil {\n76|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n77|\t}\n78|\tschema, err := leaseStringMember(members, \"schema\")\n79|\tif err != nil || schema != leaseRecordSchema {\n80|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n81|\t}\n82|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n83|\tif err != nil {\n84|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n85|\t}\n86|\tif field != canonicaljson.SelfRecordID {\n87|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n88|\t}\n89|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n90|\tif !ok {\n91|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n92|\t}\n93|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n94|\tif err != nil {\n95|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n96|\t}\n97|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n98|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n99|\t}\n100|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n101|\tif !ok {\n102|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n103|\t}\n104|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n105|\tif !ok {\n106|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n107|\t}\n108|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n109|\tif err != nil {\n110|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n111|\t}\n112|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n113|\tif err != nil {\n114|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n115|\t}\n116|\tlease = validatedLease{\n117|\t\tDigest:         digest.String(),\n118|\t\tSessionID:      sessionID.String(),\n119|\t\tLeaseID:        leaseID,\n120|\t\tEpoch:          epoch,\n121|\t\tHolderHostID:   holder.String(),\n122|\t\tPredecessor:    predecessor,\n123|\t\tHasPredecessor: hasPredecessor,\n124|\t\tCheckpoint:     checkpoint,\n125|\t\tHasCheckpoint:  hasCheckpoint,\n126|\t\tRaw:            append([]byte(nil), raw...),\n127|\t}\n128|\treturn lease, nil\n129|}\n130|\n131|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n132|\treturn members[name]\n133|}\n134|\n135|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n136|\traw, ok := members[name]\n137|\tif !ok {\n138|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n139|\t}\n140|\tvar value string\n141|\tif err := json.Unmarshal(raw, &value); err != nil {\n142|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n143|\t}\n144|\treturn value, nil\n145|}\n146|\n147|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n148|\traw, ok := members[name]\n149|\tif !ok {\n150|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n151|\t}\n152|\tif string(raw) == \"null\" {\n153|\t\treturn \"\", false, nil\n154|\t}\n155|\tvar value string\n156|\tif err := json.Unmarshal(raw, &value); err != nil {\n157|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n158|\t}\n159|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n160|\t\treturn \"\", false, err\n161|\t}\n162|\treturn value, true, nil\n163|}\n164|\n165|// leaseNullableDigest reads a nullable digest member: null binds\n166|// absence, a string must parse as a canonical digest.\n167|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n168|\traw, ok := members[name]\n169|\tif !ok {\n170|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n171|\t}\n172|\tif string(raw) == \"null\" {\n173|\t\treturn \"\", false, nil\n174|\t}\n175|\tvar value string\n176|\tif err := json.Unmarshal(raw, &value); err != nil {\n177|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n178|\t}\n179|\tdigest, err := scalar.ParseDigest(value)\n180|\tif err != nil {\n181|\t\treturn \"\", false, err\n182|\t}\n183|\treturn digest.String(), true, nil\n184|}\n185|\n186|// parseCheckpointRecord validates one canonical Checkpoint Record\n187|// through the sessrepo owner (closed shape plus canonical self\n188|// identity) and extracts the bound members. Closed-shape and\n189|// identity failures refuse invalid_config; the caller maps an\n190|// unresolvable reference to observation_unavailable.\n191|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n192|\tvar checkpoint validatedCheckpoint\n193|\tmembers, fault := environ.DecodeStrictObject(raw)\n194|\tif fault != nil {\n195|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n196|\t}\n197|\tschema, err := leaseStringMember(members, \"schema\")\n198|\tif err != nil || schema != checkpointRecordSchema {\n199|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n200|\t}\n201|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n202|\tif err != nil {\n203|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n204|\t}\n205|\tif field != canonicaljson.SelfCheckpointID {\n206|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n207|\t}\n208|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n209|\tif !ok {\n210|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n211|\t}\n212|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n213|\tif !ok {\n214|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n215|\t}\n216|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n217|\tif err != nil {\n218|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n219|\t}\n220|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n221|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n222|\t}\n223|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n224|\tif !ok {\n225|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n226|\t}\n227|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n228|\tif err != nil {\n229|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n230|\t}\n231|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n232|\tif err != nil {\n233|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n234|\t}\n235|\tcheckpoint = validatedCheckpoint{\n236|\t\tDigest:              digest.String(),\n237|\t\tSessionID:           sessionID.String(),\n238|\t\tLeaseEpoch:          epoch,\n239|\t\tLeaseID:             leaseID,\n240|\t\tCreatorHostID:       creator.String(),\n241|\t\tHasProviderManifest: hasProvider,\n242|\t\tHasTaskBoardBundle:  hasBoard,\n243|\t\tRaw:                 append([]byte(nil), raw...),\n244|\t}\n245|\treturn checkpoint, nil\n246|}\n247|\n248|// validatedLeasesBySession validates every supplied Lease Record and\n249|// groups the admitted records by session UUID.\n250|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n251|\tout := map[string][]validatedLease{}\n252|\tif reader == nil {\n253|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n254|\t}\n255|\tfor _, raw := range reader.LeaseRecords {\n256|\t\tlease, err := parseLeaseRecord(raw)\n257|\t\tif err != nil {\n258|\t\t\treturn nil, err\n259|\t\t}\n260|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n261|\t}\n262|\treturn out, nil\n263|}\n264|\n265|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n266|// Record for one session and validates its succession: the\n267|// predecessor ancestry must chain by epoch plus one down to an\n268|// epoch-1 root, and every lease in that winning ancestry above\n269|// epoch 1 must reference a validated checkpoint for its session and\n270|// predecessor lease (Section 5.3), each created by the owning lease\n271|// holder (Section 5.4). Every required checkpoint must additionally\n272|// carry the persistence variant the referenced Session Record\n273|// selects: sessionKind is that record's kind as projected from the\n274|// winning source, and a variant mismatch refuses\n275|// observation_unavailable even when canonical identity, session,\n276|// lease, epoch, and creator all agree. Absence refuses\n277|// observation_unavailable; a lease above epoch 1 without its named\n278|// predecessor in the admitted set refuses the same class rather than\n279|// binding a dangling successor, while an illegal predecessor link is\n280|// malformed authority (integrity failure).\n281|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string) (validatedLease, error) {\n282|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n283|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n284|\t}\n285|\tbySession, err := reader.validatedLeasesBySession()\n286|\tif err != nil {\n287|\t\treturn validatedLease{}, err\n288|\t}\n289|\tcandidates := bySession[sessionID]\n290|\tif len(candidates) == 0 {\n291|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n292|\t}\n293|\twinner := candidates[0]\n294|\tfor _, candidate := range candidates[1:] {\n295|\t\tif sessstate.Compare(\n296|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n297|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n298|\t\t) > 0 {\n299|\t\t\twinner = candidate\n300|\t\t}\n301|\t}\n302|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n303|\tif err != nil {\n304|\t\treturn validatedLease{}, err\n305|\t}\n306|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind); err != nil {\n307|\t\treturn validatedLease{}, err\n308|\t}\n309|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind); err != nil {\n310|\t\treturn validatedLease{}, err\n311|\t}\n312|\treturn winner, nil\n313|}\n314|\n315|// checkLeaseChain validates the winner's predecessor ancestry within\n316|// the admitted records for its session. Section 5.3 requires every\n317|// epoch above 1 to name a known predecessor for the same session\n318|// with an epoch exactly one below, down to an epoch-1 root with a\n319|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n320|// lease naming any predecessor is malformed. A self, cyclic,\n321|// skipped, contradictory, or duplicated link is malformed authority\n322|// (integrity failure); a missing predecessor name or record is\n323|// incomplete authority (observation_unavailable). Epochs strictly\n324|// decrease along the walk, so the walk always terminates. It\n325|// returns the winning ancestry from the winner down to the epoch-1\n326|// root, plus the winner's direct predecessor, or the zero lease at\n327|// epoch 1.\n328|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n329|\tbyLease := make(map[string]validatedLease, len(candidates))\n330|\tfor _, candidate := range candidates {\n331|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n332|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n333|\t\t}\n334|\t\tbyLease[candidate.LeaseID] = candidate\n335|\t}\n336|\tvar predecessor validatedLease\n337|\tvar chain []validatedLease\n338|\tcurrent := winner\n339|\tfor {\n340|\t\tchain = append(chain, current)\n341|\t\tif current.Epoch == 1 {\n342|\t\t\tif current.HasPredecessor {\n343|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n344|\t\t\t}\n345|\t\t\treturn chain, predecessor, nil\n346|\t\t}\n347|\t\tif !current.HasPredecessor {\n348|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n349|\t\t}\n350|\t\tparent, ok := byLease[current.Predecessor]\n351|\t\tif !ok {\n352|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n353|\t\t}\n354|\t\tif parent.Epoch+1 != current.Epoch {\n355|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n356|\t\t}\n357|\t\tif current.LeaseID == winner.LeaseID {\n358|\t\t\tpredecessor = parent\n359|\t\t}\n360|\t\tcurrent = parent\n361|\t}\n362|}\n363|\n364|// validatedCheckpointsByDigest validates every supplied Checkpoint\n365|// Record and indexes the admitted records by canonical digest.\n366|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n367|\tout := map[string]validatedCheckpoint{}\n368|\tif reader == nil {\n369|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n370|\t}\n371|\tfor _, raw := range reader.CheckpointRecords {\n372|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n373|\t\tif err != nil {\n374|\t\t\treturn nil, err\n375|\t\t}\n376|\t\tout[checkpoint.Digest] = checkpoint\n377|\t}\n378|\treturn out, nil\n379|}\n380|\n381|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n382|// against the admitted Checkpoint Records. Section 5.3 requires\n383|// every epoch above 1 to reference a validated checkpoint for its\n384|// session and predecessor lease; an epoch-1 root without a\n385|// predecessor may carry no checkpoint before the first provider\n386|// boundary exists. A non-null reference must resolve to an admitted\n387|// record for the same session bound to the lease it was taken\n388|// under: the predecessor for a successor, the winner itself at\n389|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n390|// unresolvable reference is incomplete authority\n391|// (observation_unavailable), never absence or a minted fact.\n392|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string) error {\n393|\tif !winner.HasCheckpoint {\n394|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n395|\t\t\treturn nil\n396|\t\t}\n397|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n398|\t}\n399|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n400|\tif err != nil {\n401|\t\treturn err\n402|\t}\n403|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n404|\tif !ok {\n405|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n406|\t}\n407|\tif checkpoint.SessionID != winner.SessionID {\n408|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n409|\t}\n410|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n411|\tif winner.Epoch > 1 {\n412|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n413|\t}\n414|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n415|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n416|\t}\n417|\towner := winner\n418|\tif winner.Epoch > 1 {\n419|\t\towner = predecessor\n420|\t}\n421|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n422|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n423|\t}\n424|\tif err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {\n425|\t\treturn err\n426|\t}\n427|\treturn nil\n428|}\n429|\n430|// checkAncestorCheckpoints validates the checkpoint references of\n431|// every non-winner lease in the winning ancestry: Section 5.3\n432|// requires each epoch above 1 to reference a validated checkpoint\n433|// for its session and predecessor lease, and Section 5.4 requires\n434|// that checkpoint to be created by the owning lease holder. The\n435|// winner itself is covered by checkWinnerCheckpoint. Only the\n436|// winner's own ancestry is admitted: sibling branches off that\n437|// chain are never consulted, so legal branching is preserved. An\n438|// epoch-1 root without a reference stays admissible before the\n439|// first provider boundary exists; a reference it does carry must\n440|// resolve to a checkpoint bound to itself and created by its own\n441|// holder. An unresolvable reference or a binding to another\n442|// session, lease, or holder is incomplete authority\n443|// (observation_unavailable), never absence or a minted fact.\n444|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string) error {\n445|\tif len(chain) < 2 {\n446|\t\treturn nil\n447|\t}\n448|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n449|\tif err != nil {\n450|\t\treturn err\n451|\t}\n452|\tfor index := 1; index < len(chain); index++ {\n453|\t\tcurrent := chain[index]\n454|\t\tif current.Epoch == 1 {\n455|\t\t\tif !current.HasCheckpoint {\n456|\t\t\t\tcontinue\n457|\t\t\t}\n458|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind); err != nil {\n459|\t\t\t\treturn err\n460|\t\t\t}\n461|\t\t\tcontinue\n462|\t\t}\n463|\t\tif !current.HasCheckpoint {\n464|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n465|\t\t}\n466|\t\tif index+1 >= len(chain) {\n467|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n468|\t\t}\n469|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind); err != nil {\n470|\t\t\treturn err\n471|\t\t}\n472|\t}\n473|\treturn nil\n474|}\n475|\n476|// checkCheckpointBinding resolves one lease's checkpoint reference\n477|// against the admitted Checkpoint Records and validates its Section\n478|// 5.3 session and predecessor-lease binding with its Section 5.4\n479|// holder binding: the checkpoint must name this session and the\n480|// owning lease, and its creator must be that lease's holder.\n481|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string) error {\n482|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n483|\tif !ok {\n484|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n485|\t}\n486|\tif checkpoint.SessionID != current.SessionID {\n487|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n488|\t}\n489|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n490|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n491|\t}\n492|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n493|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n494|\t}\n495|\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n496|\t\treturn err\n497|\t}\n498|\treturn nil\n499|}\n500|\n501|// checkCheckpointPersistence binds an admitted Checkpoint Record to\n502|// the persistence variant the referenced Session Record selects\n503|// (Section 5.4): a direct session requires a non-null\n504|// provider_manifest_id with a null task_board_bundle_id, while a\n505|// task_board session requires the reverse. Canonical shape proves\n506|// exactly one variant is present but cannot select which one is\n507|// valid, so a swapped variant keeps canonical identity, session,\n508|// lease, epoch, and creator yet refuses here with incomplete\n509|// authority (observation_unavailable), never absence or a minted\n510|// fact. An unknown session kind is malformed configuration: valid\n511|// Session Records admit only the two kinds.\n512|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n513|\tswitch sessionKind {\n514|\tcase \"direct\":\n515|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n516|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n517|\t\t}\n518|\t\treturn nil\n519|\tcase \"task_board\":\n520|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n521|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n522|\t\t}\n523|\t\treturn nil\n524|\tdefault:\n525|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n526|\t}\n527|}\n528|\n529|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n530|// greatest epoch wins, ties break by bytewise lease-ID order.\n531|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n532|\treturn sessstate.Compare(\n533|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n534|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n535|\t)\n536|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d3","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":452,"recorded_at":1780531400000899,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a0892f-c282-7fe1-a51b-23fe0e96b20d"},"task_id":"01a0892f-c282-7fe1-a51b-23fe0e96b20d","event":{"kind":"completed","task_id":"01a0892f-c282-7fe1-a51b-23fe0e96b20d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d5","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":453,"recorded_at":1780531400000901,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0892fbdae7d93bf5f7044157f5d98","text":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is one admitted Checkpoint Record: its canonical\n48|// digest with the session and lease it was taken under, plus the host\n49|// that created it. Section 5.4 binds lease_epoch/lease_id to the\n50|// referenced winning lease, so a successor's checkpoint names its\n51|// predecessor lease, and binds created_by_host_id to the current\n52|// lease holder: the holder of the lease the checkpoint names. The\n53|// persistence presence members carry which variant the record uses;\n54|// the referenced Session Record selects which variant is valid\n55|// (checkCheckpointPersistence), because canonical shape alone admits\n56|// either variant.\n57|type validatedCheckpoint struct {\n58|\tDigest              string\n59|\tSessionID           string\n60|\tLeaseEpoch          uint64\n61|\tLeaseID             string\n62|\tCreatorHostID       string\n63|\tHasProviderManifest bool\n64|\tHasTaskBoardBundle  bool\n65|\tRaw                 []byte\n66|}\n67|\n68|// parseLeaseRecord validates one canonical Lease Record through the\n69|// canonicaljson owner and extracts the bound members. Closed-shape and\n70|// identity failures refuse invalid_config; the caller maps absence to\n71|// observation_unavailable.\n72|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n73|\tvar lease validatedLease\n74|\tmembers, fault := environ.DecodeStrictObject(raw)\n75|\tif fault != nil {\n76|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n77|\t}\n78|\tschema, err := leaseStringMember(members, \"schema\")\n79|\tif err != nil || schema != leaseRecordSchema {\n80|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n81|\t}\n82|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n83|\tif err != nil {\n84|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n85|\t}\n86|\tif field != canonicaljson.SelfRecordID {\n87|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n88|\t}\n89|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n90|\tif !ok {\n91|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n92|\t}\n93|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n94|\tif err != nil {\n95|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n96|\t}\n97|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n98|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n99|\t}\n100|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n101|\tif !ok {\n102|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n103|\t}\n104|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n105|\tif !ok {\n106|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n107|\t}\n108|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n109|\tif err != nil {\n110|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n111|\t}\n112|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n113|\tif err != nil {\n114|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n115|\t}\n116|\tlease = validatedLease{\n117|\t\tDigest:         digest.String(),\n118|\t\tSessionID:      sessionID.String(),\n119|\t\tLeaseID:        leaseID,\n120|\t\tEpoch:          epoch,\n121|\t\tHolderHostID:   holder.String(),\n122|\t\tPredecessor:    predecessor,\n123|\t\tHasPredecessor: hasPredecessor,\n124|\t\tCheckpoint:     checkpoint,\n125|\t\tHasCheckpoint:  hasCheckpoint,\n126|\t\tRaw:            append([]byte(nil), raw...),\n127|\t}\n128|\treturn lease, nil\n129|}\n130|\n131|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n132|\treturn members[name]\n133|}\n134|\n135|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n136|\traw, ok := members[name]\n137|\tif !ok {\n138|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n139|\t}\n140|\tvar value string\n141|\tif err := json.Unmarshal(raw, &value); err != nil {\n142|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n143|\t}\n144|\treturn value, nil\n145|}\n146|\n147|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n148|\traw, ok := members[name]\n149|\tif !ok {\n150|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n151|\t}\n152|\tif string(raw) == \"null\" {\n153|\t\treturn \"\", false, nil\n154|\t}\n155|\tvar value string\n156|\tif err := json.Unmarshal(raw, &value); err != nil {\n157|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n158|\t}\n159|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n160|\t\treturn \"\", false, err\n161|\t}\n162|\treturn value, true, nil\n163|}\n164|\n165|// leaseNullableDigest reads a nullable digest member: null binds\n166|// absence, a string must parse as a canonical digest.\n167|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n168|\traw, ok := members[name]\n169|\tif !ok {\n170|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n171|\t}\n172|\tif string(raw) == \"null\" {\n173|\t\treturn \"\", false, nil\n174|\t}\n175|\tvar value string\n176|\tif err := json.Unmarshal(raw, &value); err != nil {\n177|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n178|\t}\n179|\tdigest, err := scalar.ParseDigest(value)\n180|\tif err != nil {\n181|\t\treturn \"\", false, err\n182|\t}\n183|\treturn digest.String(), true, nil\n184|}\n185|\n186|// parseCheckpointRecord validates one canonical Checkpoint Record\n187|// through the sessrepo owner (closed shape plus canonical self\n188|// identity) and extracts the bound members. Closed-shape and\n189|// identity failures refuse invalid_config; the caller maps an\n190|// unresolvable reference to observation_unavailable.\n191|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n192|\tvar checkpoint validatedCheckpoint\n193|\tmembers, fault := environ.DecodeStrictObject(raw)\n194|\tif fault != nil {\n195|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n196|\t}\n197|\tschema, err := leaseStringMember(members, \"schema\")\n198|\tif err != nil || schema != checkpointRecordSchema {\n199|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n200|\t}\n201|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n202|\tif err != nil {\n203|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n204|\t}\n205|\tif field != canonicaljson.SelfCheckpointID {\n206|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n207|\t}\n208|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n209|\tif !ok {\n210|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n211|\t}\n212|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n213|\tif !ok {\n214|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n215|\t}\n216|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n217|\tif err != nil {\n218|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n219|\t}\n220|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n221|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n222|\t}\n223|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n224|\tif !ok {\n225|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n226|\t}\n227|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n228|\tif err != nil {\n229|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n230|\t}\n231|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n232|\tif err != nil {\n233|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n234|\t}\n235|\tcheckpoint = validatedCheckpoint{\n236|\t\tDigest:              digest.String(),\n237|\t\tSessionID:           sessionID.String(),\n238|\t\tLeaseEpoch:          epoch,\n239|\t\tLeaseID:             leaseID,\n240|\t\tCreatorHostID:       creator.String(),\n241|\t\tHasProviderManifest: hasProvider,\n242|\t\tHasTaskBoardBundle:  hasBoard,\n243|\t\tRaw:                 append([]byte(nil), raw...),\n244|\t}\n245|\treturn checkpoint, nil\n246|}\n247|\n248|// validatedLeasesBySession validates every supplied Lease Record and\n249|// groups the admitted records by session UUID.\n250|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n251|\tout := map[string][]validatedLease{}\n252|\tif reader == nil {\n253|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n254|\t}\n255|\tfor _, raw := range reader.LeaseRecords {\n256|\t\tlease, err := parseLeaseRecord(raw)\n257|\t\tif err != nil {\n258|\t\t\treturn nil, err\n259|\t\t}\n260|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n261|\t}\n262|\treturn out, nil\n263|}\n264|\n265|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n266|// Record for one session and validates its succession: the\n267|// predecessor ancestry must chain by epoch plus one down to an\n268|// epoch-1 root, and every lease in that winning ancestry above\n269|// epoch 1 must reference a validated checkpoint for its session and\n270|// predecessor lease (Section 5.3), each created by the owning lease\n271|// holder (Section 5.4). Every required checkpoint must additionally\n272|// carry the persistence variant the referenced Session Record\n273|// selects: sessionKind is that record's kind as projected from the\n274|// winning source, and a variant mismatch refuses\n275|// observation_unavailable even when canonical identity, session,\n276|// lease, epoch, and creator all agree. Absence refuses\n277|// observation_unavailable; a lease above epoch 1 without its named\n278|// predecessor in the admitted set refuses the same class rather than\n279|// binding a dangling successor, while an illegal predecessor link is\n280|// malformed authority (integrity failure).\n281|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string) (validatedLease, error) {\n282|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n283|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n284|\t}\n285|\tbySession, err := reader.validatedLeasesBySession()\n286|\tif err != nil {\n287|\t\treturn validatedLease{}, err\n288|\t}\n289|\tcandidates := bySession[sessionID]\n290|\tif len(candidates) == 0 {\n291|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n292|\t}\n293|\twinner := candidates[0]\n294|\tfor _, candidate := range candidates[1:] {\n295|\t\tif sessstate.Compare(\n296|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n297|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n298|\t\t) > 0 {\n299|\t\t\twinner = candidate\n300|\t\t}\n301|\t}\n302|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n303|\tif err != nil {\n304|\t\treturn validatedLease{}, err\n305|\t}\n306|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind); err != nil {\n307|\t\treturn validatedLease{}, err\n308|\t}\n309|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind); err != nil {\n310|\t\treturn validatedLease{}, err\n311|\t}\n312|\treturn winner, nil\n313|}\n314|\n315|// checkLeaseChain validates the winner's predecessor ancestry within\n316|// the admitted records for its session. Section 5.3 requires every\n317|// epoch above 1 to name a known predecessor for the same session\n318|// with an epoch exactly one below, down to an epoch-1 root with a\n319|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n320|// lease naming any predecessor is malformed. A self, cyclic,\n321|// skipped, contradictory, or duplicated link is malformed authority\n322|// (integrity failure); a missing predecessor name or record is\n323|// incomplete authority (observation_unavailable). Epochs strictly\n324|// decrease along the walk, so the walk always terminates. It\n325|// returns the winning ancestry from the winner down to the epoch-1\n326|// root, plus the winner's direct predecessor, or the zero lease at\n327|// epoch 1.\n328|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n329|\tbyLease := make(map[string]validatedLease, len(candidates))\n330|\tfor _, candidate := range candidates {\n331|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n332|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n333|\t\t}\n334|\t\tbyLease[candidate.LeaseID] = candidate\n335|\t}\n336|\tvar predecessor validatedLease\n337|\tvar chain []validatedLease\n338|\tcurrent := winner\n339|\tfor {\n340|\t\tchain = append(chain, current)\n341|\t\tif current.Epoch == 1 {\n342|\t\t\tif current.HasPredecessor {\n343|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n344|\t\t\t}\n345|\t\t\treturn chain, predecessor, nil\n346|\t\t}\n347|\t\tif !current.HasPredecessor {\n348|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n349|\t\t}\n350|\t\tparent, ok := byLease[current.Predecessor]\n351|\t\tif !ok {\n352|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n353|\t\t}\n354|\t\tif parent.Epoch+1 != current.Epoch {\n355|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n356|\t\t}\n357|\t\tif current.LeaseID == winner.LeaseID {\n358|\t\t\tpredecessor = parent\n359|\t\t}\n360|\t\tcurrent = parent\n361|\t}\n362|}\n363|\n364|// validatedCheckpointsByDigest validates every supplied Checkpoint\n365|// Record and indexes the admitted records by canonical digest.\n366|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n367|\tout := map[string]validatedCheckpoint{}\n368|\tif reader == nil {\n369|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n370|\t}\n371|\tfor _, raw := range reader.CheckpointRecords {\n372|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n373|\t\tif err != nil {\n374|\t\t\treturn nil, err\n375|\t\t}\n376|\t\tout[checkpoint.Digest] = checkpoint\n377|\t}\n378|\treturn out, nil\n379|}\n380|\n381|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n382|// against the admitted Checkpoint Records. Section 5.3 requires\n383|// every epoch above 1 to reference a validated checkpoint for its\n384|// session and predecessor lease; an epoch-1 root without a\n385|// predecessor may carry no checkpoint before the first provider\n386|// boundary exists. A non-null reference must resolve to an admitted\n387|// record for the same session bound to the lease it was taken\n388|// under: the predecessor for a successor, the winner itself at\n389|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n390|// unresolvable reference is incomplete authority\n391|// (observation_unavailable), never absence or a minted fact.\n392|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string) error {\n393|\tif !winner.HasCheckpoint {\n394|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n395|\t\t\treturn nil\n396|\t\t}\n397|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n398|\t}\n399|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n400|\tif err != nil {\n401|\t\treturn err\n402|\t}\n403|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n404|\tif !ok {\n405|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n406|\t}\n407|\tif checkpoint.SessionID != winner.SessionID {\n408|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n409|\t}\n410|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n411|\tif winner.Epoch > 1 {\n412|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n413|\t}\n414|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n415|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n416|\t}\n417|\towner := winner\n418|\tif winner.Epoch > 1 {\n419|\t\towner = predecessor\n420|\t}\n421|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n422|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n423|\t}\n424|\tif err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {\n425|\t\treturn err\n426|\t}\n427|\treturn nil\n428|}\n429|\n430|// checkAncestorCheckpoints validates the checkpoint references of\n431|// every non-winner lease in the winning ancestry: Section 5.3\n432|// requires each epoch above 1 to reference a validated checkpoint\n433|// for its session and predecessor lease, and Section 5.4 requires\n434|// that checkpoint to be created by the owning lease holder. The\n435|// winner itself is covered by checkWinnerCheckpoint. Only the\n436|// winner's own ancestry is admitted: sibling branches off that\n437|// chain are never consulted, so legal branching is preserved. An\n438|// epoch-1 root without a reference stays admissible before the\n439|// first provider boundary exists; a reference it does carry must\n440|// resolve to a checkpoint bound to itself and created by its own\n441|// holder. An unresolvable reference or a binding to another\n442|// session, lease, or holder is incomplete authority\n443|// (observation_unavailable), never absence or a minted fact.\n444|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string) error {\n445|\tif len(chain) < 2 {\n446|\t\treturn nil\n447|\t}\n448|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n449|\tif err != nil {\n450|\t\treturn err\n451|\t}\n452|\tfor index := 1; index < len(chain); index++ {\n453|\t\tcurrent := chain[index]\n454|\t\tif current.Epoch == 1 {\n455|\t\t\tif !current.HasCheckpoint {\n456|\t\t\t\tcontinue\n457|\t\t\t}\n458|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind); err != nil {\n459|\t\t\t\treturn err\n460|\t\t\t}\n461|\t\t\tcontinue\n462|\t\t}\n463|\t\tif !current.HasCheckpoint {\n464|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n465|\t\t}\n466|\t\tif index+1 >= len(chain) {\n467|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n468|\t\t}\n469|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind); err != nil {\n470|\t\t\treturn err\n471|\t\t}\n472|\t}\n473|\treturn nil\n474|}\n475|\n476|// checkCheckpointBinding resolves one lease's checkpoint reference\n477|// against the admitted Checkpoint Records and validates its Section\n478|// 5.3 session and predecessor-lease binding with its Section 5.4\n479|// holder binding: the checkpoint must name this session and the\n480|// owning lease, and its creator must be that lease's holder.\n481|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string) error {\n482|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n483|\tif !ok {\n484|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n485|\t}\n486|\tif checkpoint.SessionID != current.SessionID {\n487|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n488|\t}\n489|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n490|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n491|\t}\n492|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n493|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n494|\t}\n495|\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n496|\t\treturn err\n497|\t}\n498|\treturn nil\n499|}\n500|\n501|// checkCheckpointPersistence binds an admitted Checkpoint Record to\n502|// the persistence variant the referenced Session Record selects\n503|// (Section 5.4): a direct session requires a non-null\n504|// provider_manifest_id with a null task_board_bundle_id, while a\n505|// task_board session requires the reverse. Canonical shape proves\n506|// exactly one variant is present but cannot select which one is\n507|// valid, so a swapped variant keeps canonical identity, session,\n508|// lease, epoch, and creator yet refuses here with incomplete\n509|// authority (observation_unavailable), never absence or a minted\n510|// fact. An unknown session kind is malformed configuration: valid\n511|// Session Records admit only the two kinds.\n512|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n513|\tswitch sessionKind {\n514|\tcase \"direct\":\n515|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n516|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n517|\t\t}\n518|\t\treturn nil\n519|\tcase \"task_board\":\n520|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n521|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n522|\t\t}\n523|\t\treturn nil\n524|\tdefault:\n525|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n526|\t}\n527|}\n528|\n529|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n530|// greatest epoch wins, ties break by bytewise lease-ID order.\n531|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n532|\treturn sessstate.Compare(\n533|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n534|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n535|\t)\n536|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d7","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":454,"recorded_at":1780531400000903,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0892fbed07b10b4431a9b2f6e7b16","text":"Read text file `internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, the complete authority\n10|// union for the pinned session across the remaining allowed sources,\n11|// authority heads, and the source index digest.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n27|const uint53Ceiling = uint64(1<<53 - 1)\n28|\n29|// Revalidate compares every bound plan fact against current\n30|// configuration and freshly reread source data, then validates the\n31|// complete authority union for the pinned session UUID across the\n32|// remaining allowed sources. The session is located by its UUID in\n33|// each source, never re-resolved by name. A nil return means the plan\n34|// is current; any error classifies exactly: selector_plan_stale (with\n35|// the first diverged member named), integrity_failure on contradictory\n36|// cross-source immutable records, peer_not_allowlisted on explicit\n37|// authorization revocation, invalid_config on current configuration\n38|// failures, invalid_arguments on a malformed caller plan, and the read\n39|// or projection failure class when a required read or validation\n40|// fails.\n41|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n42|\tif err := checkPlanShapes(plan); err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif reader == nil || reader.Local == nil {\n46|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n47|\t}\n48|\tconfig, err := reader.validatedConfiguration()\n49|\tif err != nil {\n50|\t\treturn err\n51|\t}\n52|\tpeerHost, isPeer := planSourceBinding(plan, config)\n53|\tif isPeer {\n54|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n55|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n56|\t\t}\n57|\t}\n58|\tif !bindingHolds(plan, config, reader) {\n59|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n60|\t}\n61|\tconfiguration, err := fingerprintConfiguration(reader, config)\n62|\tif err != nil {\n63|\t\treturn err\n64|\t}\n65|\tif configuration != plan.ConfigurationDigest {\n66|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n67|\t}\n68|\tvar repo = reader.Local\n69|\tsourcePeer := \"\"\n70|\tif isPeer {\n71|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n72|\t\tif err != nil {\n73|\t\t\treturn err\n74|\t\t}\n75|\t}\n76|\trows, err := reader.readSource(repo, sourcePeer)\n77|\tif err != nil {\n78|\t\treturn err\n79|\t}\n80|\tvar recordID string\n81|\tabsent := true\n82|\tfor _, row := range rows {\n83|\t\tif row.Projection.SessionID == plan.SessionID {\n84|\t\t\trecordID, absent = row.Projection.RecordID, false\n85|\t\t\tbreak\n86|\t\t}\n87|\t}\n88|\tif absent {\n89|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n90|\t}\n91|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n92|\tif err != nil {\n93|\t\treturn err\n94|\t}\n95|\tif recordID != plan.SessionRecordID {\n96|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n97|\t}\n98|\tif projection.Winner.IsZero() {\n99|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n100|\t}\n101|\tlease, err := reader.winningLeaseFor(plan.SessionID, projection.Kind)\n102|\tif err != nil {\n103|\t\treturn err\n104|\t}\n105|\tif lease.Digest != plan.LeaseRecordID || lease.Epoch != plan.LeaseEpoch || lease.LeaseID != plan.LeaseID || lease.HolderHostID != plan.OwnerHostID {\n106|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n107|\t}\n108|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID {\n109|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n110|\t}\n111|\tif projection.OwnerHostID != lease.HolderHostID {\n112|\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, plan.SessionID)\n113|\t}\n114|\t// The union reports specific lease and tombstone divergence before\n115|\t// the generic head and index comparisons: heads include union tails,\n116|\t// so a union change would otherwise mask as a head change.\n117|\tif err := reader.validateAuthorityUnion(plan, config, sourcePeer); err != nil {\n118|\t\treturn err\n119|\t}\n120|\theads, err := reader.collectAuthorityHeads(config, plan.SessionID, lease.Digest, sourcePeer)\n121|\tif err != nil {\n122|\t\treturn err\n123|\t}\n124|\tif !equalStrings(heads, plan.AuthorityHeads) {\n125|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n126|\t}\n127|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif index != plan.SourceIndexDigest {\n132|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n133|\t}\n134|\treturn nil\n135|}\n136|\n137|// validateAuthorityUnion validates the complete current authority for\n138|// the pinned session UUID across every allowed source except the\n139|// already validated plan source. The session is located by UUID in\n140|// each source; names are never re-resolved and no selection is\n141|// substituted. A non-parked copy carrying a disagreeing immutable\n142|// record digest is inconsistent authority (integrity_failure, the same\n143|// class Resolve reports for disagreeing copies). Authoritative\n144|// tombstone evidence or a greater observed winning lease (Section 5.3\n145|// greatest (epoch, lease_id) tuple) in another source invalidates the\n146|// live plan (selector_plan_stale); a lagging copy with a smaller tuple\n147|// is a preserved losing history and stays current, and an agreeing\n148|// replica stays current. A copy that observes no winning lease yet\n149|// cannot contradict the bound lease and is skipped for the lease\n150|// check, while its record digest still binds. A parked copy of the\n151|// pinned session is incomplete authority and fails the union closed\n152|// (selector_observation_unavailable); only a genuinely absent\n153|// session is not contradiction. A source that must be read but\n154|// cannot be read keeps its read-failure class: without the complete\n155|// union the plan cannot be shown current.\n156|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n157|\tif sourcePeer != \"\" {\n158|\t\trows, err := reader.read(reader.Local)\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n163|\t\t\treturn err\n164|\t\t}\n165|\t}\n166|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n167|\tsort.Strings(ids)\n168|\tfor index, id := range ids {\n169|\t\tif index > 0 && id == ids[index-1] {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tif id == sourcePeer {\n173|\t\t\tcontinue\n174|\t\t}\n175|\t\t// An allowlisted peer with no advertised learned index\n176|\t\t// contributes no authority; a known handle that cannot be\n177|\t\t// read is a failed observation of a source that must be\n178|\t\t// read, never absence.\n179|\t\tif isAbsentPeerIndex(reader, id) {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\trepo, peerHost, err := reader.peerRepo(id)\n183|\t\tif err != nil {\n184|\t\t\treturn err\n185|\t\t}\n186|\t\trows, err := reader.readSource(repo, peerHost)\n187|\t\tif err != nil {\n188|\t\t\treturn err\n189|\t\t}\n190|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n191|\t\t\treturn err\n192|\t\t}\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n198|// learned index handle at all: absence, never a failed read.\n199|func isAbsentPeerIndex(reader *Reader, host string) bool {\n200|\tfor _, peer := range reader.Peers {\n201|\t\tif peer.HostID == host {\n202|\t\t\treturn false\n203|\t\t}\n204|\t}\n205|\treturn true\n206|}\n207|\n208|// checkUnionCopy validates one non-plan source's rows for the pinned\n209|// session UUID as validateAuthorityUnion documents. A parked copy of\n210|// the pinned session is incomplete authority (unknown), never\n211|// evidence and never absence: the union cannot be shown current\n212|// without it, so the plan fails closed with\n213|// selector_observation_unavailable naming the blocking reason. The\n214|// union winner is the greatest (epoch, lease_id) tuple: only a\n215|// greater tuple in another source invalidates the plan; smaller\n216|// tuples are preserved losing histories and equal tuples are\n217|// agreeing replicas.\n218|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n219|\tfor _, row := range rows {\n220|\t\tif row.Projection.SessionID != plan.SessionID {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tif row.Projection.Parked != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: required authority for session %s is unknown: %s\", ErrObservationUnavailable, plan.SessionID, row.Projection.Parked.BlockingReason)\n225|\t\t}\n226|\t\tif row.Projection.State == sessstate.StateTombstoned {\n227|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n228|\t\t}\n229|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n230|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n231|\t\t}\n232|\t\tif row.Projection.Winner.IsZero() {\n233|\t\t\tcontinue\n234|\t\t}\n235|\t\tordering := compareLeaseTuple(\n236|\t\t\trow.Projection.Winner.Epoch, row.Projection.Winner.LeaseID,\n237|\t\t\tplan.LeaseEpoch, plan.LeaseID,\n238|\t\t)\n239|\t\tif ordering > 0 {\n240|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n241|\t\t}\n242|\t\tif ordering == 0 && row.Projection.OwnerHostID != plan.OwnerHostID {\n243|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across sources\", sessstate.ErrIntegrity, plan.SessionID)\n244|\t\t}\n245|\t}\n246|\treturn nil\n247|}\n248|\n249|// collectAuthorityHeads binds the sorted unique lease, event, and\n250|// tombstone heads used for the decision: the winning Lease Record\n251|// digest plus the tail event digest of every allowed source holding a\n252|// non-parked copy of the pinned session. A parked copy of the pinned\n253|// session never reaches this binding: the union gate fails closed\n254|// first, so the skip below only documents that parked rows carry no\n255|// tail; absent sessions contribute none. A source that must be read\n256|// but cannot be read keeps its read-failure class.\n257|func (reader *Reader) collectAuthorityHeads(config validatedConfig, sessionID, leaseDigest, sourcePeer string) ([]string, error) {\n258|\tset := map[string]struct{}{leaseDigest: {}}\n259|\tcollect := func(repo *sessrepo.Repository, peerHost string) error {\n260|\t\trows, err := reader.readSource(repo, peerHost)\n261|\t\tif err != nil {\n262|\t\t\treturn err\n263|\t\t}\n264|\t\tfor _, row := range rows {\n265|\t\t\tif row.Projection.SessionID != sessionID {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tif row.Projection.Parked != nil {\n269|\t\t\t\tcontinue\n270|\t\t\t}\n271|\t\t\ttail, err := chainTail(repo, sessionID)\n272|\t\t\tif err != nil {\n273|\t\t\t\tif peerHost == \"\" {\n274|\t\t\t\t\treturn err\n275|\t\t\t\t}\n276|\t\t\t\treturn peerReadFailed(peerHost, err)\n277|\t\t\t}\n278|\t\t\tif tail != \"\" {\n279|\t\t\t\tset[tail] = struct{}{}\n280|\t\t\t}\n281|\t\t\tbreak\n282|\t\t}\n283|\t\treturn nil\n284|\t}\n285|\tvar planRepo *sessrepo.Repository\n286|\tif sourcePeer == \"\" {\n287|\t\tplanRepo = reader.Local\n288|\t} else {\n289|\t\tvar err error\n290|\t\tplanRepo, _, err = reader.peerRepo(sourcePeer)\n291|\t\tif err != nil {\n292|\t\t\treturn nil, err\n293|\t\t}\n294|\t}\n295|\tif err := collect(planRepo, sourcePeer); err != nil {\n296|\t\treturn nil, err\n297|\t}\n298|\tif sourcePeer != \"\" {\n299|\t\tif err := collect(reader.Local, \"\"); err != nil {\n300|\t\t\treturn nil, err\n301|\t\t}\n302|\t}\n303|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n304|\tsort.Strings(ids)\n305|\tfor index, id := range ids {\n306|\t\tif index > 0 && id == ids[index-1] {\n307|\t\t\tcontinue\n308|\t\t}\n309|\t\tif id == sourcePeer {\n310|\t\t\tcontinue\n311|\t\t}\n312|\t\tif isAbsentPeerIndex(reader, id) {\n313|\t\t\tcontinue\n314|\t\t}\n315|\t\trepo, peerHost, err := reader.peerRepo(id)\n316|\t\tif err != nil {\n317|\t\t\treturn nil, err\n318|\t\t}\n319|\t\tif err := collect(repo, peerHost); err != nil {\n320|\t\t\treturn nil, err\n321|\t\t}\n322|\t}\n323|\theads := make([]string, 0, len(set))\n324|\tfor digest := range set {\n325|\t\theads = append(heads, digest)\n326|\t}\n327|\tsort.Strings(heads)\n328|\treturn heads, nil\n329|}\n330|\n331|// planSourceBinding resolves the plan's bound source: a local plan\n332|// carries a null alias with an empty or local host, while any other\n333|// binding selects a peer source by host. The second return reports\n334|// whether the plan selects a peer source.\n335|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n336|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n337|\t\treturn \"\", false\n338|\t}\n339|\treturn plan.SourceHostID, true\n340|}\n341|\n342|// bindingHolds reports whether the plan's bound (host, alias) source\n343|// still resolves to the same source in the current configuration. A\n344|// local plan holds while its host is empty or the current local host;\n345|// a peer plan holds while its host is still a known peer carrying the\n346|// exact bound alias.\n347|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n348|\tif plan.SourceAlias == nil {\n349|\t\tif plan.SourceHostID == \"\" {\n350|\t\t\treturn true\n351|\t\t}\n352|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n353|\t\t\treturn true\n354|\t\t}\n355|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n356|\t\t\treturn true\n357|\t\t}\n358|\t\treturn false\n359|\t}\n360|\tif !knownPeer(reader, plan.SourceHostID) {\n361|\t\treturn false\n362|\t}\n363|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n364|}\n365|\n366|// equalStrings compares sorted unique string slices element-wise.\n367|func equalStrings(first, second []string) bool {\n368|\tif len(first) != len(second) {\n369|\t\treturn false\n370|\t}\n371|\tfor index := range first {\n372|\t\tif first[index] != second[index] {\n373|\t\t\treturn false\n374|\t\t}\n375|\t}\n376|\treturn true\n377|}\n378|\n379|// checkPlanShapes validates the caller-supplied plan members without\n380|// consulting any authority: exact contract version, grammatical\n381|// selector, canonical UUIDs and digests, a bound source host, the\n382|// required lease attestation with its full positive triple, exact\n383|// alias bound, sorted unique authority heads, a known action tag, and\n384|// a null or UUIDv7 destination. Authority comes only from Revalidate.\n385|func checkPlanShapes(plan SelectionPlan) error {\n386|\tif plan.SelectorVersion != SelectorVersion {\n387|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n388|\t}\n389|\tif _, err := ParseSelector(plan.Selector); err != nil {\n390|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n391|\t}\n392|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n393|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n394|\t}\n395|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n396|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n397|\t}\n398|\t// The source host is always bound: no plan observes a source it\n399|\t// cannot name, and empty never substitutes for unknown.\n400|\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
