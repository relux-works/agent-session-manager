{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f7","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":598,"recorded_at":1780531400001191,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a0892f-fd52-7493-bfba-11df8edd0829"},"task_id":"01a0892f-fd52-7493-bfba-11df8edd0829","event":{"kind":"output","task_id":"01a0892f-fd52-7493-bfba-11df8edd0829","chunk":"Read text file `internal/sessquery/summary.go`.\n1|// Authoritative shared summaries for the v0.6.0 selector contract\n2|// (SPEC Section 14.7.3).\n3|//\n4|// List and Status above keep the internal read model and refuse only\n5|// the unrepresentable record-only bootstrap. This layer is the closed\n6|// authoritative summary: every owner, lease, and role fact comes from\n7|// the validated winning Lease Record, every host display name comes\n8|// from validated host metadata, and every workspace, capability,\n9|// liveness, and timestamp fact comes from a validated observation.\n10|// Anything that cannot be established truthfully refuses instead of\n11|// falling back to inference:\n12|//\n13|//   - a complete read proving a record without any valid lease is\n14|//     selector_bootstrap_incomplete (inherited from the read entry);\n15|//   - a required host metadata fact, winning Lease Record, or\n16|//     observation that cannot be established is\n17|//     selector_observation_unavailable, never a source alias, an empty\n18|//     name, or a minted process/capability fact;\n19|//   - list refuses the whole success document when any encountered\n20|//     record cannot be represented, including a mixed healthy and\n21|//     incomplete listing; no record is silently omitted.\n22|//\n23|// CLI envelope and exit rendering, durable bootstrap recovery, and\n24|// effect authorization remain their existing caller owners. Plans\n25|// built here authorize read projection only.\n26|package sessquery\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"time\"\n32|\t\"unicode\"\n33|\t\"unicode/utf8\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n37|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n38|)\n39|\n40|// MaxDisplayNameRunes bounds one validated host display name: the\n41|// SessionSummary owner_host_name is string[1..64].\n42|const MaxDisplayNameRunes = 64\n43|\n44|// MaxCapabilityNameRunes bounds one validated capability name.\n45|const MaxCapabilityNameRunes = 128\n46|\n47|// MaxCapabilityDetailRunes bounds one CapabilitySummary detail: string[0..2048].\n48|const MaxCapabilityDetailRunes = 2048\n49|\n50|// MaxWarningRunes bounds one summary warning: 1..1024 printable runes.\n51|const MaxWarningRunes = 1024\n52|\n53|// MaxWarnings bounds the warning array: sorted unique string[0..1024].\n54|const MaxWarnings = 1024\n55|\n56|// MaxCapabilities bounds the capability map: 0..7 entries.\n57|const MaxCapabilities = 7\n58|\n59|// Workspace statuses from the SessionSummary shape.\n60|const (\n61|\tWorkspaceAbsent      = \"absent\"\n62|\tWorkspaceCurrent     = \"current\"\n63|\tWorkspaceStaged      = \"staged\"\n64|\tWorkspaceConflict    = \"conflict\"\n65|\tWorkspaceUnsupported = \"unsupported\"\n66|)\n67|\n68|// HostMetadata is validated display metadata for one host, keyed by\n69|// canonical host UUID on the Reader. It is the only source of owner\n70|// display names; the source alias never substitutes for it.\n71|type HostMetadata struct {\n72|\tDisplayName string\n73|}\n74|\n75|// CapabilitySummary is one validated capability value: status,\n76|// enabled, and detail. Only available may set enabled true.\n77|type CapabilitySummary struct {\n78|\tStatus  string\n79|\tEnabled bool\n80|\tDetail  string\n81|}\n82|\n83|// SessionObservations carries validated per-session observation facts\n84|// from their respective owners, keyed by session UUID on the Reader.\n85|// A nil map entry or nil pointer is unobserved (unknown) and refuses\n86|// selector_observation_unavailable when the fact is required; an\n87|// established absence uses an explicit value (workspace \"absent\", an\n88|// empty non-nil capability map). The newest-checkpoint timestamp is\n89|// required exactly when the projection carries a checkpoint.\n90|type SessionObservations struct {\n91|\t// NewestCheckpointCreatedAt is the RFC 3339 creation timestamp of\n92|\t// the newest checkpoint, required exactly when the projection\n93|\t// carries a checkpoint.\n94|\tNewestCheckpointCreatedAt *string\n95|\t// ProcessPresent is validated process liveness; nil is unobserved.\n96|\t// It is required for AuthoritativeStatus (the status body carries\n97|\t// process_present boolean) and carried when supplied for lists.\n98|\tProcessPresent *bool\n99|\t// Capabilities are validated capability summaries; nil is\n100|\t// unobserved and refuses, while an empty non-nil map is an\n101|\t// established absence of capabilities.\n102|\tCapabilities map[string]CapabilitySummary\n103|\t// WorkspaceStatus is the validated workspace status; nil is\n104|\t// unobserved and refuses, while \"absent\" is an established\n105|\t// absence.\n106|\tWorkspaceStatus *string\n107|}\n108|\n109|// AuthoritativeSummary is the closed public summary for one live\n110|// session. Owner, lease, and role come from the validated winning\n111|// Lease Record; host names, workspace, capabilities, liveness, and\n112|// timestamps come from validated inputs. No member is ever invented.\n113|type AuthoritativeSummary struct {\n114|\tSessionID                 string\n115|\tName                      string\n116|\tKind                      string\n117|\tProviderID                string\n118|\tState                     string\n119|\tOwnerHostID               string\n120|\tOwnerHostName             string\n121|\tLeaseEpoch                uint64\n122|\tLeaseID                   string\n123|\tLocalRole                 string\n124|\tHasCheckpoint             bool\n125|\tNewestCheckpointID        *string\n126|\tNewestCheckpointCreatedAt *string\n127|\tProcessPresent            *bool\n128|\tCapabilities              map[string]CapabilitySummary\n129|\tWorkspaceStatus           string\n130|\tWarnings                  []string\n131|}\n132|\n133|// checkSummaryRepresentable refuses a projected row that can never be\n134|// represented truthfully in a public summary: a complete read proving\n135|// a record without any valid lease. Parked rows stay representable\n136|// through their blocking reason and retry, and tombstoned rows stay\n137|// listed with their terminal state; resolution routing already\n138|// excludes both from live selection.\n139|func checkSummaryRepresentable(summary Summary) error {\n140|\tprojection := summary.Projection\n141|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n142|\t\treturn nil\n143|\t}\n144|\tif projection.Winner.IsZero() {\n145|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// validatedAuthorityInputs validates the reader's host metadata and\n151|// observation maps as configuration: UUIDv7 keys, printable bounded\n152|// display names, RFC 3339 checkpoint timestamps, capability names and\n153|// values, and workspace enums. Malformed inputs are invalid_config;\n154|// missing facts at summary time are selector_observation_unavailable.\n155|func (reader *Reader) validatedAuthorityInputs() error {\n156|\tfor host, metadata := range reader.HostMetadata {\n157|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n158|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n159|\t\t}\n160|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n161|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n162|\t\t}\n163|\t}\n164|\tfor session, observations := range reader.Observations {\n165|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n166|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n167|\t\t}\n168|\t\tif observations.NewestCheckpointCreatedAt != nil {\n169|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n170|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n171|\t\t\t}\n172|\t\t}\n173|\t\tif observations.WorkspaceStatus != nil {\n174|\t\t\tif err := checkWorkspaceStatus(*observations.WorkspaceStatus); err != nil {\n175|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n176|\t\t\t}\n177|\t\t}\n178|\t\tif observations.Capabilities != nil {\n179|\t\t\tif err := checkCapabilities(observations.Capabilities); err != nil {\n180|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n181|\t\t\t}\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|func checkWorkspaceStatus(value string) error {\n188|\tswitch value {\n189|\tcase WorkspaceAbsent, WorkspaceCurrent, WorkspaceStaged, WorkspaceConflict, WorkspaceUnsupported:\n190|\t\treturn nil\n191|\tdefault:\n192|\t\treturn fmt.Errorf(\"workspace status %q is not absent|current|staged|conflict|unsupported\", value)\n193|\t}\n194|}\n195|\n196|// admittedCapabilities is the closed Section 7.3 provider capability\n197|// registry owned by provhost: a summary advertising any other name\n198|// claims a surface the contract never defined. This is not the\n199|// session-adapter or directory capability registries those owners\n200|// carry for their own planes.\n201|func admittedCapabilities() map[string]bool {\n202|\tadmitted := make(map[string]bool, MaxCapabilities)\n203|\tfor _, name := range provhost.Capabilities() {\n204|\t\tadmitted[name] = true\n205|\t}\n206|\treturn admitted\n207|}\n208|\n209|func checkCapabilities(values map[string]CapabilitySummary) error {\n210|\tif len(values) > MaxCapabilities {\n211|\t\treturn fmt.Errorf(\"capabilities carry %d entries, want 0-%d\", len(values), MaxCapabilities)\n212|\t}\n213|\tadmitted := admittedCapabilities()\n214|\tnames := make([]string, 0, len(values))\n215|\tfor name := range values {\n216|\t\tnames = append(names, name)\n217|\t}\n218|\tsort.Strings(names)\n219|\tfor index, name := range names {\n220|\t\tif index > 0 && names[index-1] == name {\n221|\t\t\treturn fmt.Errorf(\"capabilities carry a duplicate name\")\n222|\t\t}\n223|\t\tif err := checkPrintableBound(name, 1, MaxCapabilityNameRunes, \"capability name\"); err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\tif !admitted[name] {\n227|\t\t\treturn fmt.Errorf(\"capability %q is not a Section 7.3 registry name\", name)\n228|\t\t}\n229|\t\tsummary := values[name]\n230|\t\tswitch summary.Status {\n231|\t\tcase \"available\", \"conditional\", \"unsupported\", \"unknown\":\n232|\t\tdefault:\n233|\t\t\treturn fmt.Errorf(\"capability %q status %q is not available|conditional|unsupported|unknown\", name, summary.Status)\n234|\t\t}\n235|\t\tif summary.Enabled && summary.Status != \"available\" {\n236|\t\t\treturn fmt.Errorf(\"capability %q enables a non-available status\", name)\n237|\t\t}\n238|\t\tif err := checkDetailBound(summary.Detail); err != nil {\n239|\t\t\treturn fmt.Errorf(\"capability %q detail: %v\", name, err)\n240|\t\t}\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|func checkDetailBound(value string) error {\n246|\tif !utf8.ValidString(value) {\n247|\t\treturn fmt.Errorf(\"detail is not valid UTF-8\")\n248|\t}\n249|\tcount := utf8.RuneCountInString(value)\n250|\tif count > MaxCapabilityDetailRunes {\n251|\t\treturn fmt.Errorf(\"detail carries %d characters, want 0-%d\", count, MaxCapabilityDetailRunes)\n252|\t}\n253|\tfor _, character := range value {\n254|\t\tif unicode.IsControl(character) {\n255|\t\t\treturn fmt.Errorf(\"detail carries a control character\")\n256|\t\t}\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|func checkWarnings(values []string) error {\n262|\tif len(values) > MaxWarnings {\n263|\t\treturn fmt.Errorf(\"warnings carry %d entries, want 0-%d\", len(values), MaxWarnings)\n264|\t}\n265|\tfor index, warning := range values {\n266|\t\tif err := checkPrintableBound(warning, 1, MaxWarningRunes, \"warning\"); err != nil {\n267|\t\t\treturn fmt.Errorf(\"warnings[%d]: %v\", index, err)\n268|\t\t}\n269|\t\tif index > 0 && values[index-1] >= warning {\n270|\t\t\treturn fmt.Errorf(\"warnings are not sorted unique\")\n271|\t\t}\n272|\t}\n273|\treturn nil\n274|}\n275|\n276|// checkPrintableBound enforces valid UTF-8 with min..max printable\n277|// non-control runes without normalizing or folding the value.\n278|func checkPrintableBound(value string, min, max int, what string) error {\n279|\tif !utf8.ValidString(value) {\n280|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n281|\t}\n282|\tcount := utf8.RuneCountInString(value)\n283|\tif count < min || count > max {\n284|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n285|\t}\n286|\tfor _, character := range value {\n287|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n288|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n289|\t\t}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// AuthoritativeStatus resolves one selector through the shared path\n295|// and returns its closed authoritative summary. Resolution,\n296|// read-failure, and bootstrap refusals behave exactly as Status;\n297|// host, lease, and observation facts then bind or refuse as documented\n298|// above. Process liveness is required here: the status body carries\n299|// process_present boolean, and an unknown liveness refuses.\n300|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n301|\tsummary, err := reader.Status(selector)\n302|\tif err != nil {\n303|\t\treturn AuthoritativeSummary{}, err\n304|\t}\n305|\tif err := reader.validatedAuthorityInputs(); err != nil {\n306|\t\treturn AuthoritativeSummary{}, err\n307|\t}\n308|\treturn reader.authorize(summary, true)\n309|}\n310|\n311|// AuthoritativeList returns the closed authoritative summaries for\n312|// the local index in bytewise session-ID order. The whole document\n313|// refuses when any encountered record cannot be represented\n314|// truthfully — including one incomplete record in an otherwise\n315|// healthy listing — and no record is silently omitted. Process\n316|// liveness is carried when its observation is supplied; workspace,\n317|// capabilities, host, lease, and checkpoint facts are always required.\n318|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n319|\trows, err := reader.List()\n320|\tif err != nil {\n321|\t\treturn nil, err\n322|\t}\n323|\tif err := reader.validatedAuthorityInputs(); err != nil {\n324|\t\treturn nil, err\n325|\t}\n326|\tout := make([]AuthoritativeSummary, 0, len(rows))\n327|\tfor _, row := range rows {\n328|\t\tsummary, err := reader.authorize(row, false)\n329|\t\tif err != nil {\n330|\t\t\treturn nil, err\n331|\t\t}\n332|\t\tout = append(out, summary)\n333|\t}\n334|\treturn out, nil\n335|}\n336|\n337|// authorize binds one projected row to its closed authoritative\n338|// summary against the validated host, lease, and observation inputs.\n339|// Every refusal names the missing established fact; nothing is\n340|// inferred. An established absence (workspace \"absent\", an empty\n341|// non-nil capability map) is distinct from an unknown observation\n342|// (nil), which refuses.\n343|func (reader *Reader) authorize(summary Summary, requireProcess bool) (AuthoritativeSummary, error) {\n344|\tprojection := summary.Projection\n345|\tif err := checkSummaryRepresentable(summary); err != nil {\n346|\t\treturn AuthoritativeSummary{}, err\n347|\t}\n348|\tif reader.LocalHostID == \"\" {\n349|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n350|\t}\n351|\tlease, err := reader.winningLeaseFor(projection.SessionID, projection.Kind)\n352|\tif err != nil {\n353|\t\treturn AuthoritativeSummary{}, err\n354|\t}\n355|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n356|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing lease facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n357|\t}\n358|\tif projection.OwnerHostID != lease.HolderHostID {\n359|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n360|\t}\n361|\tmetadata, ok := reader.HostMetadata[lease.HolderHostID]\n362|\tif !ok {\n363|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, lease.HolderHostID)\n364|\t}\n365|\tif projection.LocalRole == \"\" {\n366|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n367|\t}\n368|\tif err := checkWarnings(projection.Warnings); err != nil {\n369|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: warnings for session %s: %v\", ErrInvalidConfig, projection.SessionID, err)\n370|\t}\n371|\tauthorized := AuthoritativeSummary{\n372|\t\tSessionID:       projection.SessionID,\n373|\t\tName:            projection.Name,\n374|\t\tKind:            projection.Kind,\n375|\t\tProviderID:      projection.Provider.ID,\n376|\t\tState:           string(projection.State),\n377|\t\tOwnerHostID:     lease.HolderHostID,\n378|\t\tOwnerHostName:   metadata.DisplayName,\n379|\t\tLeaseEpoch:      lease.Epoch,\n380|\t\tLeaseID:         lease.LeaseID,\n381|\t\tLocalRole:       projection.LocalRole,\n382|\t\tWorkspaceStatus: \"\",\n383|\t\tWarnings:        append([]string(nil), projection.Warnings...),\n384|\t}\n385|\tif authorized.Warnings == nil {\n386|\t\tauthorized.Warnings = []string{}\n387|\t}\n388|\tobservations, hasObservations := reader.Observations[projection.SessionID]\n389|\tif projection.HasCheckpoint {\n390|\t\tcheckpoint := projection.Newest.ID\n391|\t\tauthorized.HasCheckpoint = true\n392|\t\tauthorized.NewestCheckpointID = &checkpoint\n393|\t\tif !hasObservations || observations.NewestCheckpointCreatedAt == nil {\n394|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n395|\t\t}\n396|\t\tstamp := *observations.NewestCheckpointCreatedAt\n397|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n398|\t}\n399|\tif !hasObservations || observations.WorkspaceStatus == nil {\n400|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: workspace status for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n401|\t}\n402|\tworkspace := WorkspaceAbsent\n403|\tif hasObservations && observations.WorkspaceStatus != nil {\n404|\t\tworkspace = *observations.WorkspaceStatus\n405|\t}\n406|\tauthorized.WorkspaceStatus = workspace\n407|\tif !hasObservations || observations.Capabilities == nil {\n408|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: capabilities for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n409|\t}\n410|\tauthorized.Capabilities = observations.Capabilities\n411|\tif authorized.Capabilities == nil {\n412|\t\tauthorized.Capabilities = map[string]CapabilitySummary{}\n413|\t}\n414|\tif requireProcess {\n415|\t\tif !hasObservations || observations.ProcessPresent == nil {\n416|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: process liveness for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n417|\t\t}\n418|\t}\n419|\tvar present bool\n420|\tvar hasPresent bool\n421|\tif hasObservations && observations.ProcessPresent != nil {\n422|\t\tpresent = *observations.ProcessPresent\n423|\t\thasPresent = true\n424|\t}\n425|\tif requireProcess || hasPresent {\n426|\t\t// For a required status without an observation the gate above\n427|\t\t// already refused; the false default here only lets a\n428|\t\t// weakening mutant proceed to a behavioral failure instead of\n429|\t\t// a panic.\n430|\t\tpresentCopy := present\n431|\t\tauthorized.ProcessPresent = &presentCopy\n432|\t\tif requireProcess && !hasPresent {\n433|\t\t\t// Mutant admission path: succeed with a minted fact so the\n434|\t\t\t// missing-observation test fails rather than panics.\n435|\t\t}\n436|\t}\n437|\treturn authorized, nil\n438|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f9","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":599,"recorded_at":1780531400001193,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a0892f-fd52-7493-bfba-11df8edd0829"},"task_id":"01a0892f-fd52-7493-bfba-11df8edd0829","event":{"kind":"completed","task_id":"01a0892f-fd52-7493-bfba-11df8edd0829"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7fb","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":600,"recorded_at":1780531400001195,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0892ff6ac71909bcfb6f375e4c097","text":"Read text file `internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability. All sixteen contract members bind; a future\n13|// member without a bound row fails its publication gate closed instead\n14|// of falling into a default.\n15|//\n16|// Lease authority comes from validated urn:ax:schema:lease records\n17|// supplied in Reader.LeaseRecords and admitted through the\n18|// canonicaljson owner. The plan binds lease_record_id as the canonical\n19|// digest of the winning Lease Record for the selected session, and the\n20|// lease triple binds from that same record. No envelope observation\n21|// substitutes for the record: a session with no admitted winning\n22|// record refuses selector_observation_unavailable, and malformed bytes\n23|// refuse invalid_config. A complete read proving a record without any\n24|// valid lease refuses selector_bootstrap_incomplete instead of binding\n25|// an empty triple, and a local selection without a known local host\n26|// refuses invalid_config instead of binding an empty source host.\n27|//\n28|// Revalidation rereads the current configuration and the plan's source,\n29|// validates the same immutable record, the current winning lease, and\n30|// the action prerequisites this leaf can check, compares every bound\n31|// plan fact in a fixed order, and then validates the complete\n32|// authority union for the pinned session UUID across the local and\n33|// every allowlisted source: a contradictory immutable record is\n34|// integrity failure, a contradictory winning lease or fresh tombstone\n35|// evidence is stale. A changed mapping, alias, allowlist, transport,\n36|// source index, record, authority head, lease, action, destination, or\n37|// expectation invalidates the plan with selector_plan_stale naming the\n38|// first diverged member; explicit authorization revocation returns\n39|// peer_not_allowlisted; failed reads retain their read-failure\n40|// classification. Revalidation never re-resolves by name, substitutes\n41|// a same-named session, silently replans, transfers a lease, or reuses\n42|// confirmation for new facts.\n43|//\n44|// Effect authorization beyond read projection — fencing, commit,\n45|// retry, recovery, remote dispatch/admission, and transport-resume\n46|// prerequisites, and the composed per-endpoint invocation bindings —\n47|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n48|// every boundary in BoundariesFor for their action. A plan built here\n49|// authorizes read projection only.\n50|package sessquery\n51|\n52|import (\n53|\t\"fmt\"\n54|\n55|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n56|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n57|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n58|)\n59|\n60|// SelectorVersion is the exact selector contract version every plan binds.\n61|const SelectorVersion = \"1.0.0\"\n62|\n63|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n64|// an existing command/action tag; binding one selects it, never an\n65|// umbrella bypass.\n66|const (\n67|\tActionStatus      = \"status\"\n68|\tActionAttach      = \"attach\"\n69|\tActionTakeover    = \"takeover\"\n70|\tActionFork        = \"fork\"\n71|\tActionStop        = \"stop\"\n72|\tActionResume      = \"resume\"\n73|\tActionSync        = \"sync\"\n74|\tActionDiff        = \"diff\"\n75|\tActionMaterialize = \"materialize\"\n76|\tActionSetProfile  = \"session.set-profile\"\n77|\tActionLogs        = \"logs\"\n78|\tActionCancel      = \"cancel\"\n79|)\n80|\n81|// Plan boundaries from the normative action/boundary matrix. A boundary\n82|// is reached only when the existing operation reaches that phase; these\n83|// rows introduce no new effects.\n84|const (\n85|\tBoundaryProjection      = \"projection\"\n86|\tBoundaryPreEffect       = \"pre-effect\"\n87|\tBoundaryFencing         = \"fencing\"\n88|\tBoundaryCommit          = \"commit\"\n89|\tBoundaryRetry           = \"retry\"\n90|\tBoundaryRecovery        = \"recovery\"\n91|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n92|\tBoundaryRemoteAdmission = \"remote-admission\"\n93|\tBoundaryTransportResume = \"transport-resume\"\n94|)\n95|\n96|// planBoundaries is the closed action/boundary matrix: every action has\n97|// exactly its normative row, and an unknown action has none.\n98|var planBoundaries = map[string][]string{\n99|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n100|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n101|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n102|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n103|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n104|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n105|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n106|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n107|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n108|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n109|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n110|\tActionCancel:      {BoundaryProjection},\n111|}\n112|\n113|// BoundariesFor returns the required boundary classes for a plan\n114|// action. The boolean reports whether the action is a known tag; an\n115|// unknown action binds no boundary and builds no plan.\n116|func BoundariesFor(action string) ([]string, bool) {\n117|\tboundaries, ok := planBoundaries[action]\n118|\tif !ok {\n119|\t\treturn nil, false\n120|\t}\n121|\treturn append([]string(nil), boundaries...), true\n122|}\n123|\n124|// SelectionPlan is the machine-local immutable binding of one selector\n125|// resolution. All members are values, never references: there is no\n126|// mutator, and Marshal carries the locally verified canonical digest\n127|// so a persisted plan is tamper-evident. Caller-supplied digest\n128|// equality alone is never evidence of authority; only Revalidate\n129|// against current facts decides currency.\n130|type SelectionPlan struct {\n131|\t// SelectorVersion is exactly SelectorVersion.\n132|\tSelectorVersion string\n133|\t// Selector is the original single argument, at most\n134|\t// MaxSelectorRunes characters.\n135|\tSelector string\n136|\t// SessionID is the selected UUIDv7, never resolved again by name.\n137|\tSessionID string\n138|\t// SessionRecordID is the validated immutable Session Record digest.\n139|\tSessionRecordID string\n140|\t// SourceHostID is the UUIDv7 of the selected source, always bound:\n141|\t// a local selection without a known local host refuses\n142|\t// invalid_config at build time instead of binding empty.\n143|\tSourceHostID string\n144|\t// SourceAlias is the exact configured alias, or nil for local. It\n145|\t// is a diagnostic label, never identity.\n146|\tSourceAlias *string\n147|\t// SourceIndexDigest is the digest of the complete validated index\n148|\t// read used for selection.\n149|\tSourceIndexDigest string\n150|\t// ConfigurationDigest is the digest of the effective validated\n151|\t// configuration, including peer mapping, allowlist, and transport.\n152|\tConfigurationDigest string\n153|\t// LeaseRecordID is the canonical digest of the validated winning\n154|\t// Lease Record for the selected session, admitted through the\n155|\t// canonicaljson owner from Reader.LeaseRecords.\n156|\tLeaseRecordID string\n157|\t// LeaseEpoch, LeaseID, and OwnerHostID come from that same winning\n158|\t// Lease Record: positive uint53, UUIDv4, and UUIDv7 holder. A plan\n159|\t// with no admitted winning record is never built; the builder\n160|\t// refuses selector_observation_unavailable, and a complete read\n161|\t// proving a record without any valid lease refuses\n162|\t// selector_bootstrap_incomplete.\n163|\tLeaseEpoch  uint64\n164|\tLeaseID     string\n165|\tOwnerHostID string\n166|\t// AuthorityHeads is the sorted unique digest array of the validated\n167|\t// lease, event, and tombstone heads used for the decision: the\n168|\t// winning Lease Record digest plus the tail event digest of every\n169|\t// allowed source holding a non-parked copy of the pinned session.\n170|\tAuthorityHeads []string\n171|\t// Action is the explicit command/action tag bound at build time.\n172|\tAction string\n173|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n174|\t// when the action takes no destination.\n175|\tDestinationHostID *string\n176|\t// ExpectationDigest binds the caller-declared action expectations\n177|\t// (canonically encoded JSON) for change detection. It does not\n178|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n179|\t// or confirmation contracts, which have no owners in this leaf.\n180|\tExpectationDigest string\n181|}\n182|\n183|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n184|// selector, the explicit action tag, the explicit destination (empty\n185|// for none), and the opaque caller expectations (nil for none).\n186|type PlanArgs struct {\n187|\tSelector     string\n188|\tAction       string\n189|\tDestination  string\n190|\tExpectations []byte\n191|}\n192|\n193|// BuildPlan resolves the selector once through the shared path and\n194|// binds the current facts into an immutable plan. The destination is\n195|// independently validated as a UUIDv7; expectations must be canonically\n196|// encodable JSON and bind by digest for change detection only.\n197|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n198|\tparsed, err := ParseSelector(args.Selector)\n199|\tif err != nil {\n200|\t\treturn SelectionPlan{}, err\n201|\t}\n202|\tif reader == nil || reader.Local == nil {\n203|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n204|\t}\n205|\tconfig, err := reader.validatedConfiguration()\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tif _, ok := BoundariesFor(args.Action); !ok {\n210|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n211|\t}\n212|\tvar destination *string\n213|\tif args.Destination != \"\" {\n214|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n215|\t\tif err != nil {\n216|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n217|\t\t}\n218|\t\tvalue := id.String()\n219|\t\tdestination = &value\n220|\t}\n221|\texpectations, err := fingerprintExpectations(args.Expectations)\n222|\tif err != nil {\n223|\t\treturn SelectionPlan{}, err\n224|\t}\n225|\tvar selected Selection\n226|\tif parsed.Source != SourceBare {\n227|\t\tselected, err = reader.resolveExplicit(parsed, config)\n228|\t} else {\n229|\t\tselected, err = reader.resolveBare(parsed, config)\n230|\t}\n231|\tif err != nil {\n232|\t\treturn SelectionPlan{}, err\n233|\t}\n234|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n235|}\n236|\n237|// bindPlan reads the winning source completely and binds every plan\n238|// member from validated current facts. The session is located by its\n239|// UUID in the winning source only, never re-resolved by name. Lease\n240|// authority comes from the admitted winning Lease Record for that\n241|// UUID; the envelope winner on the selected chain must agree with it,\n242|// and the union winner across all allowed sources must not exceed it.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tlease, err := reader.winningLeaseFor(selected.SessionID, projection.Kind)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n279|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n280|\t}\n281|\tif projection.OwnerHostID != lease.HolderHostID {\n282|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, selected.SessionID)\n283|\t}\n284|\tplan := SelectionPlan{\n285|\t\tSelectorVersion:     SelectorVersion,\n286|\t\tSelector:            parsed.Raw,\n287|\t\tSessionID:           selected.SessionID,\n288|\t\tSessionRecordID:     recordID,\n289|\t\tSourceIndexDigest:   index,\n290|\t\tConfigurationDigest: configuration,\n291|\t\tLeaseRecordID:       lease.Digest,\n292|\t\tLeaseEpoch:          lease.Epoch,\n293|\t\tLeaseID:             lease.LeaseID,\n294|\t\tOwnerHostID:         lease.HolderHostID,\n295|\t\tAction:              action,\n296|\t\tDestinationHostID:   destination,\n297|\t\tExpectationDigest:   expectations,\n298|\t}\n299|\tif selected.PeerHostID == \"\" {\n300|\t\tif config.localHost == \"\" {\n301|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n302|\t\t}\n303|\t\tplan.SourceHostID = config.localHost\n304|\t} else {\n305|\t\tplan.SourceHostID = selected.PeerHostID\n306|\t\t// Null marks the local source only. An alias-less peer binds\n307|\t\t// empty: the host still distinguishes it from local.\n308|\t\talias := config.aliasFor(selected.PeerHostID)\n309|\t\taliasCopy := alias\n310|\t\tplan.SourceAlias = &aliasCopy\n311|\t}\n312|\t// The union check consults record, tombstone, and winner facts\n313|\t// only, never heads; heads are bound after the union validates.\n314|\tplan.AuthorityHeads = []string{}\n315|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\theads, err := reader.collectAuthorityHeads(config, selected.SessionID, lease.Digest, selected.PeerHostID)\n319|\tif err != nil {\n320|\t\treturn SelectionPlan{}, err\n321|\t}\n322|\tplan.AuthorityHeads = heads\n323|\tif err := checkPlanShapes(plan); err != nil {\n324|\t\treturn SelectionPlan{}, err\n325|\t}\n326|\treturn plan, nil\n327|}\n328|\n329|// chainTail returns the tail event digest of a validated session chain,\n330|// or empty when the chain carries no events yet.\n331|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n332|\tevents, err := repo.ListEvents(sessionID)\n333|\tif err != nil {\n334|\t\treturn \"\", err\n335|\t}\n336|\tif len(events) == 0 {\n337|\t\treturn \"\", nil\n338|\t}\n339|\treturn events[len(events)-1].EventID, nil\n340|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7fd","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":601,"recorded_at":1780531400001197,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0892ff7857ef3a873eace9a2d6da8","text":"Read text file `internal/sessquery/summary.go`.\n1|// Authoritative shared summaries for the v0.6.0 selector contract\n2|// (SPEC Section 14.7.3).\n3|//\n4|// List and Status above keep the internal read model and refuse only\n5|// the unrepresentable record-only bootstrap. This layer is the closed\n6|// authoritative summary: every owner, lease, and role fact comes from\n7|// the validated winning Lease Record, every host display name comes\n8|// from validated host metadata, and every workspace, capability,\n9|// liveness, and timestamp fact comes from a validated observation.\n10|// Anything that cannot be established truthfully refuses instead of\n11|// falling back to inference:\n12|//\n13|//   - a complete read proving a record without any valid lease is\n14|//     selector_bootstrap_incomplete (inherited from the read entry);\n15|//   - a required host metadata fact, winning Lease Record, or\n16|//     observation that cannot be established is\n17|//     selector_observation_unavailable, never a source alias, an empty\n18|//     name, or a minted process/capability fact;\n19|//   - list refuses the whole success document when any encountered\n20|//     record cannot be represented, including a mixed healthy and\n21|//     incomplete listing; no record is silently omitted.\n22|//\n23|// CLI envelope and exit rendering, durable bootstrap recovery, and\n24|// effect authorization remain their existing caller owners. Plans\n25|// built here authorize read projection only.\n26|package sessquery\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"time\"\n32|\t\"unicode\"\n33|\t\"unicode/utf8\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n37|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n38|)\n39|\n40|// MaxDisplayNameRunes bounds one validated host display name: the\n41|// SessionSummary owner_host_name is string[1..64].\n42|const MaxDisplayNameRunes = 64\n43|\n44|// MaxCapabilityNameRunes bounds one validated capability name.\n45|const MaxCapabilityNameRunes = 128\n46|\n47|// MaxCapabilityDetailRunes bounds one CapabilitySummary detail: string[0..2048].\n48|const MaxCapabilityDetailRunes = 2048\n49|\n50|// MaxWarningRunes bounds one summary warning: 1..1024 printable runes.\n51|const MaxWarningRunes = 1024\n52|\n53|// MaxWarnings bounds the warning array: sorted unique string[0..1024].\n54|const MaxWarnings = 1024\n55|\n56|// MaxCapabilities bounds the capability map: 0..7 entries.\n57|const MaxCapabilities = 7\n58|\n59|// Workspace statuses from the SessionSummary shape.\n60|const (\n61|\tWorkspaceAbsent      = \"absent\"\n62|\tWorkspaceCurrent     = \"current\"\n63|\tWorkspaceStaged      = \"staged\"\n64|\tWorkspaceConflict    = \"conflict\"\n65|\tWorkspaceUnsupported = \"unsupported\"\n66|)\n67|\n68|// HostMetadata is validated display metadata for one host, keyed by\n69|// canonical host UUID on the Reader. It is the only source of owner\n70|// display names; the source alias never substitutes for it.\n71|type HostMetadata struct {\n72|\tDisplayName string\n73|}\n74|\n75|// CapabilitySummary is one validated capability value: status,\n76|// enabled, and detail. Only available may set enabled true.\n77|type CapabilitySummary struct {\n78|\tStatus  string\n79|\tEnabled bool\n80|\tDetail  string\n81|}\n82|\n83|// SessionObservations carries validated per-session observation facts\n84|// from their respective owners, keyed by session UUID on the Reader.\n85|// A nil map entry or nil pointer is unobserved (unknown) and refuses\n86|// selector_observation_unavailable when the fact is required; an\n87|// established absence uses an explicit value (workspace \"absent\", an\n88|// empty non-nil capability map). The newest-checkpoint timestamp is\n89|// required exactly when the projection carries a checkpoint.\n90|type SessionObservations struct {\n91|\t// NewestCheckpointCreatedAt is the RFC 3339 creation timestamp of\n92|\t// the newest checkpoint, required exactly when the projection\n93|\t// carries a checkpoint.\n94|\tNewestCheckpointCreatedAt *string\n95|\t// ProcessPresent is validated process liveness; nil is unobserved.\n96|\t// It is required for AuthoritativeStatus (the status body carries\n97|\t// process_present boolean) and carried when supplied for lists.\n98|\tProcessPresent *bool\n99|\t// Capabilities are validated capability summaries; nil is\n100|\t// unobserved and refuses, while an empty non-nil map is an\n101|\t// established absence of capabilities.\n102|\tCapabilities map[string]CapabilitySummary\n103|\t// WorkspaceStatus is the validated workspace status; nil is\n104|\t// unobserved and refuses, while \"absent\" is an established\n105|\t// absence.\n106|\tWorkspaceStatus *string\n107|}\n108|\n109|// AuthoritativeSummary is the closed public summary for one live\n110|// session. Owner, lease, and role come from the validated winning\n111|// Lease Record; host names, workspace, capabilities, liveness, and\n112|// timestamps come from validated inputs. No member is ever invented.\n113|type AuthoritativeSummary struct {\n114|\tSessionID                 string\n115|\tName                      string\n116|\tKind                      string\n117|\tProviderID                string\n118|\tState                     string\n119|\tOwnerHostID               string\n120|\tOwnerHostName             string\n121|\tLeaseEpoch                uint64\n122|\tLeaseID                   string\n123|\tLocalRole                 string\n124|\tHasCheckpoint             bool\n125|\tNewestCheckpointID        *string\n126|\tNewestCheckpointCreatedAt *string\n127|\tProcessPresent            *bool\n128|\tCapabilities              map[string]CapabilitySummary\n129|\tWorkspaceStatus           string\n130|\tWarnings                  []string\n131|}\n132|\n133|// checkSummaryRepresentable refuses a projected row that can never be\n134|// represented truthfully in a public summary: a complete read proving\n135|// a record without any valid lease. Parked rows stay representable\n136|// through their blocking reason and retry, and tombstoned rows stay\n137|// listed with their terminal state; resolution routing already\n138|// excludes both from live selection.\n139|func checkSummaryRepresentable(summary Summary) error {\n140|\tprojection := summary.Projection\n141|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n142|\t\treturn nil\n143|\t}\n144|\tif projection.Winner.IsZero() {\n145|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// validatedAuthorityInputs validates the reader's host metadata and\n151|// observation maps as configuration: UUIDv7 keys, printable bounded\n152|// display names, RFC 3339 checkpoint timestamps, capability names and\n153|// values, and workspace enums. Malformed inputs are invalid_config;\n154|// missing facts at summary time are selector_observation_unavailable.\n155|func (reader *Reader) validatedAuthorityInputs() error {\n156|\tfor host, metadata := range reader.HostMetadata {\n157|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n158|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n159|\t\t}\n160|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n161|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n162|\t\t}\n163|\t}\n164|\tfor session, observations := range reader.Observations {\n165|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n166|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n167|\t\t}\n168|\t\tif observations.NewestCheckpointCreatedAt != nil {\n169|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n170|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n171|\t\t\t}\n172|\t\t}\n173|\t\tif observations.WorkspaceStatus != nil {\n174|\t\t\tif err := checkWorkspaceStatus(*observations.WorkspaceStatus); err != nil {\n175|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n176|\t\t\t}\n177|\t\t}\n178|\t\tif observations.Capabilities != nil {\n179|\t\t\tif err := checkCapabilities(observations.Capabilities); err != nil {\n180|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n181|\t\t\t}\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|func checkWorkspaceStatus(value string) error {\n188|\tswitch value {\n189|\tcase WorkspaceAbsent, WorkspaceCurrent, WorkspaceStaged, WorkspaceConflict, WorkspaceUnsupported:\n190|\t\treturn nil\n191|\tdefault:\n192|\t\treturn fmt.Errorf(\"workspace status %q is not absent|current|staged|conflict|unsupported\", value)\n193|\t}\n194|}\n195|\n196|// admittedCapabilities is the closed Section 7.3 provider capability\n197|// registry owned by provhost: a summary advertising any other name\n198|// claims a surface the contract never defined. This is not the\n199|// session-adapter or directory capability registries those owners\n200|// carry for their own planes.\n201|func admittedCapabilities() map[string]bool {\n202|\tadmitted := make(map[string]bool, MaxCapabilities)\n203|\tfor _, name := range provhost.Capabilities() {\n204|\t\tadmitted[name] = true\n205|\t}\n206|\treturn admitted\n207|}\n208|\n209|func checkCapabilities(values map[string]CapabilitySummary) error {\n210|\tif len(values) > MaxCapabilities {\n211|\t\treturn fmt.Errorf(\"capabilities carry %d entries, want 0-%d\", len(values), MaxCapabilities)\n212|\t}\n213|\tadmitted := admittedCapabilities()\n214|\tnames := make([]string, 0, len(values))\n215|\tfor name := range values {\n216|\t\tnames = append(names, name)\n217|\t}\n218|\tsort.Strings(names)\n219|\tfor index, name := range names {\n220|\t\tif index > 0 && names[index-1] == name {\n221|\t\t\treturn fmt.Errorf(\"capabilities carry a duplicate name\")\n222|\t\t}\n223|\t\tif err := checkPrintableBound(name, 1, MaxCapabilityNameRunes, \"capability name\"); err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\tif !admitted[name] {\n227|\t\t\treturn fmt.Errorf(\"capability %q is not a Section 7.3 registry name\", name)\n228|\t\t}\n229|\t\tsummary := values[name]\n230|\t\tswitch summary.Status {\n231|\t\tcase \"available\", \"conditional\", \"unsupported\", \"unknown\":\n232|\t\tdefault:\n233|\t\t\treturn fmt.Errorf(\"capability %q status %q is not available|conditional|unsupported|unknown\", name, summary.Status)\n234|\t\t}\n235|\t\tif summary.Enabled && summary.Status != \"available\" {\n236|\t\t\treturn fmt.Errorf(\"capability %q enables a non-available status\", name)\n237|\t\t}\n238|\t\tif err := checkDetailBound(summary.Detail); err != nil {\n239|\t\t\treturn fmt.Errorf(\"capability %q detail: %v\", name, err)\n240|\t\t}\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|func checkDetailBound(value string) error {\n246|\tif !utf8.ValidString(value) {\n247|\t\treturn fmt.Errorf(\"detail is not valid UTF-8\")\n248|\t}\n249|\tcount := utf8.RuneCountInString(value)\n250|\tif count > MaxCapabilityDetailRunes {\n251|\t\treturn fmt.Errorf(\"detail carries %d characters, want 0-%d\", count, MaxCapabilityDetailRunes)\n252|\t}\n253|\tfor _, character := range value {\n254|\t\tif unicode.IsControl(character) {\n255|\t\t\treturn fmt.Errorf(\"detail carries a control character\")\n256|\t\t}\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|func checkWarnings(values []string) error {\n262|\tif len(values) > MaxWarnings {\n263|\t\treturn fmt.Errorf(\"warnings carry %d entries, want 0-%d\", len(values), MaxWarnings)\n264|\t}\n265|\tfor index, warning := range values {\n266|\t\tif err := checkPrintableBound(warning, 1, MaxWarningRunes, \"warning\"); err != nil {\n267|\t\t\treturn fmt.Errorf(\"warnings[%d]: %v\", index, err)\n268|\t\t}\n269|\t\tif index > 0 && values[index-1] >= warning {\n270|\t\t\treturn fmt.Errorf(\"warnings are not sorted unique\")\n271|\t\t}\n272|\t}\n273|\treturn nil\n274|}\n275|\n276|// checkPrintableBound enforces valid UTF-8 with min..max printable\n277|// non-control runes without normalizing or folding the value.\n278|func checkPrintableBound(value string, min, max int, what string) error {\n279|\tif !utf8.ValidString(value) {\n280|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n281|\t}\n282|\tcount := utf8.RuneCountInString(value)\n283|\tif count < min || count > max {\n284|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n285|\t}\n286|\tfor _, character := range value {\n287|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n288|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n289|\t\t}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// AuthoritativeStatus resolves one selector through the shared path\n295|// and returns its closed authoritative summary. Resolution,\n296|// read-failure, and bootstrap refusals behave exactly as Status;\n297|// host, lease, and observation facts then bind or refuse as documented\n298|// above. Process liveness is required here: the status body carries\n299|// process_present boolean, and an unknown liveness refuses.\n300|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n301|\tsummary, err := reader.Status(selector)\n302|\tif err != nil {\n303|\t\treturn AuthoritativeSummary{}, err\n304|\t}\n305|\tif err := reader.validatedAuthorityInputs(); err != nil {\n306|\t\treturn AuthoritativeSummary{}, err\n307|\t}\n308|\treturn reader.authorize(summary, true)\n309|}\n310|\n311|// AuthoritativeList returns the closed authoritative summaries for\n312|// the local index in bytewise session-ID order. The whole document\n313|// refuses when any encountered record cannot be represented\n314|// truthfully — including one incomplete record in an otherwise\n315|// healthy listing — and no record is silently omitted. Process\n316|// liveness is carried when its observation is supplied; workspace,\n317|// capabilities, host, lease, and checkpoint facts are always required.\n318|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n319|\trows, err := reader.List()\n320|\tif err != nil {\n321|\t\treturn nil, err\n322|\t}\n323|\tif err := reader.validatedAuthorityInputs(); err != nil {\n324|\t\treturn nil, err\n325|\t}\n326|\tout := make([]AuthoritativeSummary, 0, len(rows))\n327|\tfor _, row := range rows {\n328|\t\tsummary, err := reader.authorize(row, false)\n329|\t\tif err != nil {\n330|\t\t\treturn nil, err\n331|\t\t}\n332|\t\tout = append(out, summary)\n333|\t}\n334|\treturn out, nil\n335|}\n336|\n337|// authorize binds one projected row to its closed authoritative\n338|// summary against the validated host, lease, and observation inputs.\n339|// Every refusal names the missing established fact; nothing is\n340|// inferred. An established absence (workspace \"absent\", an empty\n341|// non-nil capability map) is distinct from an unknown observation\n342|// (nil), which refuses.\n343|func (reader *Reader) authorize(summary Summary, requireProcess bool) (AuthoritativeSummary, error) {\n344|\tprojection := summary.Projection\n345|\tif err := checkSummaryRepresentable(summary); err != nil {\n346|\t\treturn AuthoritativeSummary{}, err\n347|\t}\n348|\tif reader.LocalHostID == \"\" {\n349|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n350|\t}\n351|\tlease, err := reader.winningLeaseFor(projection.SessionID, projection.Kind)\n352|\tif err != nil {\n353|\t\treturn AuthoritativeSummary{}, err\n354|\t}\n355|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n356|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing lease facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n357|\t}\n358|\tif projection.OwnerHostID != lease.HolderHostID {\n359|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n360|\t}\n361|\tmetadata, ok := reader.HostMetadata[lease.HolderHostID]\n362|\tif !ok {\n363|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, lease.HolderHostID)\n364|\t}\n365|\tif projection.LocalRole == \"\" {\n366|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n367|\t}\n368|\tif err := checkWarnings(projection.Warnings); err != nil {\n369|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: warnings for session %s: %v\", ErrInvalidConfig, projection.SessionID, err)\n370|\t}\n371|\tauthorized := AuthoritativeSummary{\n372|\t\tSessionID:       projection.SessionID,\n373|\t\tName:            projection.Name,\n374|\t\tKind:            projection.Kind,\n375|\t\tProviderID:      projection.Provider.ID,\n376|\t\tState:           string(projection.State),\n377|\t\tOwnerHostID:     lease.HolderHostID,\n378|\t\tOwnerHostName:   metadata.DisplayName,\n379|\t\tLeaseEpoch:      lease.Epoch,\n380|\t\tLeaseID:         lease.LeaseID,\n381|\t\tLocalRole:       projection.LocalRole,\n382|\t\tWorkspaceStatus: \"\",\n383|\t\tWarnings:        append([]string(nil), projection.Warnings...),\n384|\t}\n385|\tif authorized.Warnings == nil {\n386|\t\tauthorized.Warnings = []string{}\n387|\t}\n388|\tobservations, hasObservations := reader.Observations[projection.SessionID]\n389|\tif projection.HasCheckpoint {\n390|\t\tcheckpoint := projection.Newest.ID\n391|\t\tauthorized.HasCheckpoint = true\n392|\t\tauthorized.NewestCheckpointID = &checkpoint\n393|\t\tif !hasObservations || observations.NewestCheckpointCreatedAt == nil {\n394|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n395|\t\t}\n396|\t\tstamp := *observations.NewestCheckpointCreatedAt\n397|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n398|\t}\n399|\tif !hasObservations || observations.WorkspaceStatus == nil {\n400|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: workspace status for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n401|\t}\n402|\tworkspace := WorkspaceAbsent\n403|\tif hasObservations && observations.WorkspaceStatus != nil {\n404|\t\tworkspace = *observations.WorkspaceStatus\n405|\t}\n406|\tauthorized.WorkspaceStatus = workspace\n407|\tif !hasObservations || observations.Capabilities == nil {\n408|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: capabilities for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n409|\t}\n410|\tauthorized.Capabilities = observations.Capabilities\n411|\tif authorized.Capabilities == nil {\n412|\t\tauthorized.Capabilities = map[string]CapabilitySummary{}\n413|\t}\n414|\tif requireProcess {\n415|\t\tif !hasObservations || observations.ProcessPresent == nil {\n416|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: process liveness for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n417|\t\t}\n418|\t}\n419|\tvar present bool\n420|\tvar hasPresent bool\n421|\tif hasObservations && observations.ProcessPresent != nil {\n422|\t\tpresent = *observations.ProcessPresent\n423|\t\thasPresent = true\n424|\t}\n425|\tif requireProcess || hasPresent {\n426|\t\t// For a required status without an observation the gate above\n427|\t\t// already refused; the false default here only lets a\n428|\t\t// weakening mutant proceed to a behavioral failure instead of\n429|\t\t// a panic.\n430|\t\tpresentCopy := present\n431|\t\tauthorized.ProcessPresent = &presentCopy\n432|\t\tif requireProcess && !hasPresent {\n433|\t\t\t// Mutant admission path: succeed with a minted fact so the\n434|\t\t\t// missing-observation test fails rather than panics.\n435|\t\t}\n436|\t}\n437|\treturn authorized, nil\n438|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
