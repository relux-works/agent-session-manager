{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c96d","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":785,"recorded_at":1780531400001565,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a08930-69f9-7253-9042-48d0e5e6ff19"},"task_id":"01a08930-69f9-7253-9042-48d0e5e6ff19","event":{"kind":"output","task_id":"01a08930-69f9-7253-9042-48d0e5e6ff19","chunk":"Read text file `internal/sessquery/rev6_regression_test.go`.\n1|// Checkpoint persistence-variant regression tests for TASK-260830-21gygk\n2|// (SPEC 5.4, CR6 P1): the referenced Session Record selects the\n3|// persistence variant. A direct session admits only a provider-manifest\n4|// checkpoint; a task_board session admits only a task-board-bundle\n5|// checkpoint. Canonical identity, session, lease, epoch, and creator\n6|// agreement alone never admit a swapped variant. Every case drives\n7|// the four shared production entries (BuildPlan, Revalidate fresh and\n8|// old-plan, AuthoritativeStatus, AuthoritativeList), never the\n9|// validators directly.\n10|package sessquery\n11|\n12|import (\n13|\t\"encoding/json\"\n14|\t\"errors\"\n15|\t\"testing\"\n16|)\n17|\n18|// TestRev6CheckpointPersistenceMustMatchSession ports the CR6 reviewer\n19|// regression: a task_board-bundle checkpoint for a direct session\n20|// refuses on the winner path and on a necessary-ancestor path,\n21|// including old-plan revalidation after only the ancestor variant\n22|// changes. Both direct controls pass.\n23|func TestRev6CheckpointPersistenceMustMatchSession(t *testing.T) {\n24|\tfor _, ancestor := range []bool{false, true} {\n25|\t\tpath := \"winner\"\n26|\t\tif ancestor {\n27|\t\t\tpath = \"ancestor\"\n28|\t\t}\n29|\t\tfor _, wrong := range []bool{false, true} {\n30|\t\t\tmode := \"direct_control\"\n31|\t\t\tif wrong {\n32|\t\t\t\tmode = \"task_board_checkpoint_for_direct_session\"\n33|\t\t\t}\n34|\t\t\tt.Run(path+\"/\"+mode, func(t *testing.T) {\n35|\t\t\t\tgood := checkpointRecordBytes(t, idA, 1, lease, hostA)\n36|\t\t\t\tcp := good\n37|\t\t\t\tif wrong {\n38|\t\t\t\t\tvar value map[string]any\n39|\t\t\t\t\tif err := json.Unmarshal(good, &value); err != nil {\n40|\t\t\t\t\t\tt.Fatal(err)\n41|\t\t\t\t\t}\n42|\t\t\t\t\tvalue[\"task_board_bundle_id\"] = value[\"provider_manifest_id\"]\n43|\t\t\t\t\tvalue[\"provider_manifest_id\"] = nil\n44|\t\t\t\t\tcp = identity(t, value, \"checkpoint_id\")\n45|\t\t\t\t}\n46|\t\t\t\tvar r *Reader\n47|\t\t\t\tif ancestor {\n48|\t\t\t\t\tr = rev5AncestorFixture(t, good)\n49|\t\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n50|\t\t\t\t\tif wrong {\n51|\t\t\t\t\t\t// Preserve the winner digest and event bytes; alter only the\n52|\t\t\t\t\t\t// ancestor's checkpoint variant, retaining canonical identities.\n53|\t\t\t\t\t\tr.CheckpointRecords[0] = cp\n54|\t\t\t\t\t\tfor i, raw := range r.LeaseRecords {\n55|\t\t\t\t\t\t\tvar value map[string]any\n56|\t\t\t\t\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n57|\t\t\t\t\t\t\t\tt.Fatal(err)\n58|\t\t\t\t\t\t\t}\n59|\t\t\t\t\t\t\tif value[\"lease_id\"] == leaseB {\n60|\t\t\t\t\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, cp)\n61|\t\t\t\t\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n62|\t\t\t\t\t\t\t}\n63|\t\t\t\t\t\t}\n64|\t\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n65|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admits wrong persistence variant in necessary ancestor\")\n66|\t\t\t\t\t\t}\n67|\t\t\t\t\t}\n68|\t\t\t\t} else {\n69|\t\t\t\t\tr = successorFixture(t)\n70|\t\t\t\t\tgoodCp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n71|\t\t\t\t\twithCheckpoints(r, goodCp)\n72|\t\t\t\t\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, goodCp)))\n73|\t\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n74|\t\t\t\t\tif wrong {\n75|\t\t\t\t\t\t// Swap only the winner checkpoint variant, keeping the\n76|\t\t\t\t\t\t// lease tuple, event bytes, and canonical identities.\n77|\t\t\t\t\t\tr.CheckpointRecords[0] = cp\n78|\t\t\t\t\t\tfor i, raw := range r.LeaseRecords {\n79|\t\t\t\t\t\t\tvar value map[string]any\n80|\t\t\t\t\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n81|\t\t\t\t\t\t\t\tt.Fatal(err)\n82|\t\t\t\t\t\t\t}\n83|\t\t\t\t\t\t\tif value[\"lease_id\"] == leaseB {\n84|\t\t\t\t\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, cp)\n85|\t\t\t\t\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n86|\t\t\t\t\t\t\t}\n87|\t\t\t\t\t\t}\n88|\t\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n89|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admits wrong persistence variant in winner checkpoint\")\n90|\t\t\t\t\t\t}\n91|\t\t\t\t\t}\n92|\t\t\t\t}\n93|\t\t\t\trev5CheckEntries(t, r, wrong)\n94|\t\t\t})\n95|\t\t}\n96|\t}\n97|}\n98|\n99|// taskBoardRecordBytes builds one validated task_board Session Record\n100|// for tests, following the SPEC 5.1 task_board example with a\n101|// tracked_prompt reference and no board goal.\n102|func taskBoardRecordBytes(t *testing.T, id, name string) []byte {\n103|\tt.Helper()\n104|\tvar value map[string]any\n105|\tif err := json.Unmarshal([]byte(specRecordExample), &value); err != nil {\n106|\t\tt.Fatal(err)\n107|\t}\n108|\tvalue[\"session_id\"], value[\"subject_id\"], value[\"name\"] = id, id, name\n109|\tvalue[\"kind\"] = \"task_board\"\n110|\tvalue[\"task_board\"] = map[string]any{\n111|\t\t\"bridge_protocol_version\": \"1.0.0\",\n112|\t\t\"board\": map[string]any{\n113|\t\t\t\"kind\": \"local\", \"logical_id\": \"agent-session-manager-spec\",\n114|\t\t\t\"remote_url\": nil, \"extensions\": map[string]any{},\n115|\t\t},\n116|\t\t\"task_element_id\": \"TASK-260819-example\", \"launch_mode\": \"tracked_prompt\",\n117|\t\t\"manager_session_ref\": nil, \"board_goal\": nil,\n118|\t\t\"native_goal_binding\": \"prompt\", \"extensions\": map[string]any{},\n119|\t}\n120|\treturn identity(t, value, \"record_id\")\n121|}\n122|\n123|// taskBoardCheckpointBytes builds one validated Checkpoint Record\n124|// carrying the task_board persistence variant: null provider manifest\n125|// with a non-null task-board bundle.\n126|func taskBoardCheckpointBytes(t *testing.T, sessionID string, epoch uint64, leaseID, creator string) []byte {\n127|\tt.Helper()\n128|\tvalue := map[string]any{\n129|\t\t\"schema\": \"urn:ax:schema:checkpoint\", \"schema_version\": \"1.0.0\", \"checkpoint_id\": zeroDigest,\n130|\t\t\"subject_id\": sessionID, \"session_id\": sessionID,\n131|\t\t\"lease_epoch\": json.Number(uint64String(epoch)), \"lease_id\": leaseID,\n132|\t\t\"safe_boundary\": map[string]any{\n133|\t\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"evidence\": \"accepted_test\",\n134|\t\t\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true,\n135|\t\t\t\"open_processes\": json.Number(\"0\"), \"open_database_handles\": json.Number(\"0\"),\n136|\t\t},\n137|\t\t\"event_heads\":           []string{zeroDigest},\n138|\t\t\"workspace_manifest_id\": zeroDigest,\n139|\t\t\"provider_manifest_id\":  nil,\n140|\t\t\"task_board_bundle_id\":  zeroDigest,\n141|\t\t\"created_by_host_id\":    creator,\n142|\t\t\"created_at\":            \"2026-08-19T04:09:30.000Z\",\n143|\t\t\"status\":                \"validated\",\n144|\t\t\"extensions\":            map[string]any{},\n145|\t}\n146|\treturn identity(t, value, \"checkpoint_id\")\n147|}\n148|\n149|// taskBoardSuccessorFixture builds a task_board session with the\n150|// epoch-1 to epoch-2 transfer chain and a task_board-variant\n151|// checkpoint bound to the predecessor lease. The caller supplies no\n152|// variant: the only admissible checkpoint is the task_board one.\n153|func taskBoardSuccessorFixture(t *testing.T) *Reader {\n154|\tt.Helper()\n155|\tlocal, _ := repository(t)\n156|\traw := taskBoardRecordBytes(t, idA, \"alpha\")\n157|\tref, err := local.CreateSession(raw)\n158|\tif err != nil {\n159|\t\tt.Fatal(err)\n160|\t}\n161|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n162|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n163|\tappendEventAs(t, local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n164|\treader := &Reader{Local: local, LocalHostID: hostA}\n165|\tcp := taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n166|\twithCheckpoints(reader, cp)\n167|\twithLeases(reader,\n168|\t\tleaseCreate(t, idA, hostA),\n169|\t\tleaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)),\n170|\t)\n171|\treturn reader\n172|}\n173|\n174|// TestRev6TaskBoardPersistenceControl proves the variant gate selects\n175|// by session kind instead of admitting one hard-coded variant: the\n176|// task_board session with its task_board checkpoint passes all four\n177|// entries, while a provider-manifest checkpoint for that same session\n178|// refuses through all four entries including old-plan revalidation.\n179|func TestRev6TaskBoardPersistenceControl(t *testing.T) {\n180|\tt.Run(\"task_board_control\", func(t *testing.T) {\n181|\t\trev5CheckEntries(t, taskBoardSuccessorFixture(t), false)\n182|\t})\n183|\tt.Run(\"provider_checkpoint_for_task_board_session\", func(t *testing.T) {\n184|\t\tr := taskBoardSuccessorFixture(t)\n185|\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n186|\t\tprovider := checkpointRecordBytes(t, idA, 1, lease, hostA)\n187|\t\tr.CheckpointRecords[0] = provider\n188|\t\tfor i, raw := range r.LeaseRecords {\n189|\t\t\tvar value map[string]any\n190|\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n191|\t\t\t\tt.Fatal(err)\n192|\t\t\t}\n193|\t\t\tif value[\"lease_id\"] == leaseB {\n194|\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, provider)\n195|\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n196|\t\t\t}\n197|\t\t}\n198|\t\tif err := r.Revalidate(old); err == nil {\n199|\t\t\tt.Error(\"old-plan Revalidate admits provider persistence variant for task_board session\")\n200|\t\t}\n201|\t\trev5CheckEntries(t, r, true)\n202|\t})\n203|}\n204|\n205|// TestRev6PersistenceMismatchIsObservationUnavailable pins the refusal\n206|// class: a swapped variant is incomplete authority, never a missing\n207|// lease, a bootstrap prefix, or a minted fact.\n208|func TestRev6PersistenceMismatchIsObservationUnavailable(t *testing.T) {\n209|\tr := successorFixture(t)\n210|\twrong := taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n211|\twithCheckpoints(r, wrong)\n212|\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, wrong)))\n213|\tif _, err := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n214|\t\tt.Fatalf(\"BuildPlan variant mismatch = %v, want selector_observation_unavailable\", err)\n215|\t}\n216|}","final_result":true}}}
