s); decodeErr == nil {\n202|\t\t\tsummary.RecordID = record.recordID\n203|\t\t\tsummary.Name = record.name\n204|\t\t\tsummary.Kind = record.kind\n205|\t\t\tsummary.ProviderID = record.provider\n206|\t\t}\n207|\t\tsummary.RetryHint = retryHintForParkedRecord\n208|\t\treturn summary\n209|\t}\n210|\tsummary.RetryHint = retryHintForTornStore\n211|\treturn summary\n212|}\n213|\n214|// asciiFold folds ASCII uppercase to lowercase and passes every other byte\n215|// through. Session names match [A-Za-z0-9][A-Za-z0-9._-]{0,63} under the\n216|// shape owner, so the fold domain is ASCII by construction and a Unicode\n217|// fold table would be an unowned duplicate, not a reuse.\n218|func asciiFold(value string) string {\n219|\tfolded := make([]byte, 0, len(value))\n220|\tfor index := 0; index < len(value); index++ {\n221|\t\tcharacter := value[index]\n222|\t\tif character >= 'A' && character <= 'Z' {\n223|\t\t\tcharacter += 'a' - 'A'\n224|\t\t}\n225|\t\tfolded = append(folded, character)\n226|\t}\n227|\treturn string(folded)\n228|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
