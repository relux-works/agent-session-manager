{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d489","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":2207,"recorded_at":1780531400004409,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"task_stream":{"kind":"task","id":"01a08936-5fa6-7ab2-8a9a-ce808e3b4abc"},"task_id":"01a08936-5fa6-7ab2-8a9a-ce808e3b4abc","event":{"kind":"output","task_id":"01a08936-5fa6-7ab2-8a9a-ce808e3b4abc","chunk":"Read text file `internal/sessquery/rev6_regression_test.go`.\n(148 line(s) above)\n149|// taskBoardSuccessorFixture builds a task_board session with the\n150|// epoch-1 to epoch-2 transfer chain and a task_board-variant\n151|// checkpoint bound to the predecessor lease. The caller supplies no\n152|// variant: the only admissible checkpoint is the task_board one.\n153|func taskBoardSuccessorFixture(t *testing.T) *Reader {\n154|\tt.Helper()\n155|\tlocal, _ := repository(t)\n156|\traw := taskBoardRecordBytes(t, idA, \"alpha\")\n157|\tref, err := local.CreateSession(raw)\n158|\tif err != nil {\n159|\t\tt.Fatal(err)\n160|\t}\n161|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n162|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n163|\tappendEventAs(t, local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n164|\treader := &Reader{Local: local, LocalHostID: hostA}\n165|\tcp := taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n166|\twithCheckpoints(reader, cp)\n167|\twithLeases(reader,\n168|\t\tleaseCreate(t, idA, hostA),\n169|\t\tleaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)),\n170|\t)\n171|\treturn reader\n172|}\n173|\n174|// TestRev6TaskBoardPersistenceControl proves the variant gate selects\n175|// by session kind instead of admitting one hard-coded variant: the\n176|// task_board session with its task_board checkpoint passes all four\n177|// entries, while a provider-manifest checkpoint for that same session\n178|// refuses through all four entries including old-plan revalidation.\n179|func TestRev6TaskBoardPersistenceControl(t *testing.T) {\n180|\tt.Run(\"task_board_control\", func(t *testing.T) {\n181|\t\trev5CheckEntries(t, taskBoardSuccessorFixture(t), false)\n182|\t})\n183|\tt.Run(\"provider_checkpoint_for_task_board_session\", func(t *testing.T) {\n184|\t\tr := taskBoardSuccessorFixture(t)\n185|\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n186|\t\tprovider := checkpointRecordBytes(t, idA, 1, lease, hostA)\n187|\t\tr.CheckpointRecords[0] = provider\n188|\t\tfor i, raw := range r.LeaseRecords {\n189|\t\t\tvar value map[string]any\n190|\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n191|\t\t\t\tt.Fatal(err)\n192|\t\t\t}\n193|\t\t\tif value[\"lease_id\"] == leaseB {\n194|\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, provider)\n195|\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n196|\t\t\t}\n197|\t\t}\n198|\t\tif err := r.Revalidate(old); err == nil {\n199|\t\t\tt.Error(\"old-plan Revalidate admits provider persistence variant for task_board session\")\n200|\t\t}\n201|\t\trev5CheckEntries(t, r, true)\n202|\t})\n203|}\n204|\n205|// TestRev6PersistenceMismatchIsObservationUnavailable pins the refusal\n206|// class: a swapped variant is incomplete authority, never a missing\n207|// lease, a bootstrap prefix, or a minted fact.\n208|func TestRev6PersistenceMismatchIsObservationUnavailable(t *testing.T) {\n209|\tr := successorFixture(t)\n210|\twrong := taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n211|\twithCheckpoints(r, wrong)\n212|\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, wrong)))\n213|\tif _, err := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n214|\t\tt.Fatalf(\"BuildPlan variant mismatch = %v, want selector_observation_unavailable\", err)\n215|\t}\n216|}","final_result":true}}}
