{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d20d","stream":{"kind":"session","id":"01a0892e-c94e-7771-b9cd-b99166499f5d"},"sequence":1889,"recorded_at":1780531400003773,"record_type":"event","durability":"durable","causation_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"23d6464a-2d0b-430c-994a-f34a5b1772f2","run_stream":{"kind":"run","id":"23d6464a-2d0b-430c-994a-f34a5b1772f2"},"call_id":"call_01a0893524cd720084df6e196e7ceb3c","text":"Read text file `internal/sessquery/succession_test.go`.\n1|// Winning-lease succession tests for TASK-260830-21gygk (SPEC 5.3,\n2|// 14.7.2): the greatest (epoch, lease_id) winner must chain by epoch\n3|// plus one to an epoch-1 root and reference a validated checkpoint\n4|// for its session and predecessor lease. All cases drive the shared\n5|// production entries (BuildPlan/Revalidate/AuthoritativeStatus),\n6|// never the validators directly.\n7|package sessquery\n8|\n9|import (\n10|\t\"encoding/json\"\n11|\t\"errors\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// leaseCycleB is a third fencing token for cycle fixtures.\n18|const leaseCycleB = \"dddddddd-eeee-4fff-8000-222222222222\"\n19|\n20|// danglingLeaseID names no admitted record.\n21|const danglingLeaseID = \"aaaaaaaa-1111-4111-8111-111111111111\"\n22|\n23|// successorFixture builds a local session with the epoch-1 to\n24|// epoch-2 transfer event chain, ready for successor lease fixtures.\n25|func successorFixture(t *testing.T) *Reader {\n26|\tt.Helper()\n27|\treader, _, _, created := plannedSession(t)\n28|\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n29|\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n30|\treturn reader\n31|}\n32|\n33|// leaseEpochOneWithCheckpoint builds an epoch-1 non-create lease\n34|// with no predecessor and a non-null checkpoint reference.\n35|func leaseEpochOneWithCheckpoint(t *testing.T, sessionID, leaseID, holder, checkpoint string) []byte {\n36|\tt.Helper()\n37|\tvalue := map[string]any{\n38|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n39|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"lease_id\": leaseID, \"epoch\": json.Number(uint64String(1)),\n40|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": nil, \"reason\": \"recovery\",\n41|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n42|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n43|\t}\n44|\treturn identity(t, value, \"record_id\")\n45|}\n46|\n47|func TestValidSuccessorBuildsAndRevalidates(t *testing.T) {\n48|\treader := successorFixture(t)\n49|\tcheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n50|\twithCheckpoints(reader, checkpoint)\n51|\tsuccessor := leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, checkpoint))\n52|\twithLeases(reader, successor)\n53|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n54|\tif plan.LeaseEpoch != 2 || plan.LeaseID != leaseB || plan.OwnerHostID != hostA {\n55|\t\tt.Fatalf(\"successor triple: %+v\", plan)\n56|\t}\n57|\twinner, err := reader.winningLeaseFor(idA, \"direct\", reader.Local)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tif plan.LeaseRecordID != winner.Digest {\n62|\t\tt.Fatalf(\"lease_record_id = %q, want successor %q\", plan.LeaseRecordID, winner.Digest)\n63|\t}\n64|\tif err := reader.Revalidate(plan); err != nil {\n65|\t\tt.Fatalf(\"valid successor plan is not current: %v\", err)\n66|\t}\n67|}\n68|\n69|func TestSuccessorCycleMustRefuse(t *testing.T) {\n70|\treader := successorFixture(t)\n71|\tfirstCheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n72|\tsecondCheckpoint := checkpointRecordBytes(t, idA, 2, leaseCycleB, hostA)\n73|\twithCheckpoints(reader, firstCheckpoint, secondCheckpoint)\n74|\t// Epoch-3 winner names the epoch-2 record, which names the\n75|\t// winner back: epochs cannot decrease around the cycle, so the\n76|\t// second link refuses.\n77|\tcycle := leaseSuccessorBytes(t, idA, 2, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, firstCheckpoint))\n78|\twinner := leaseSuccessorBytes(t, idA, 3, leaseB, hostA, leaseCycleB, checkpointDigestOf(t, secondCheckpoint))\n79|\twithLeases(reader, cycle, winner)\n80|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n81|\t\tt.Fatalf(\"cyclic succession build = %v, want integrity_failure\", err)\n82|\t}\n83|}\n84|\n85|func TestSkippedEpochMustRefuse(t *testing.T) {\n86|\treader := successorFixture(t)\n87|\tcheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n88|\twithCheckpoints(reader, checkpoint)\n89|\t// Epoch 3 directly names the epoch-1 predecessor, skipping\n90|\t// epoch 2: the takeover did not use max_observed_epoch + 1.\n91|\tskipped := leaseSuccessorBytes(t, idA, 3, leaseB, hostA, lease, checkpointDigestOf(t, checkpoint))\n92|\twithLeases(reader, skipped)\n93|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n94|\t\tt.Fatalf(\"skipped-epoch succession build = %v, want integrity_failure\", err)\n95|\t}\n96|}\n97|\n98|func TestEpochOneWithPredecessorMustRefuse(t *testing.T) {\n99|\treader, _, _, _ := plannedSession(t)\n100|\treader.LeaseRecords = nil\n101|\t// An epoch-1 lease cannot name a predecessor: no epoch 0\n102|\t// exists, so the link is malformed authority.\n103|\tepochOne := leaseRecordBytes(t, idA, 1, lease, hostA, leaseB, true)\n104|\twithLeases(reader, epochOne)\n105|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n106|\t\tt.Fatalf(\"epoch-1 with predecessor build = %v, want integrity_failure\", err)\n107|\t}\n108|}\n109|\n110|// TestSelfPredecessorWithCheckpointMustRefuse isolates the chain\n111|// gate from the checkpoint gate: the self-predecessor lease carries\n112|// a fully valid checkpoint bound to its own tuple, so only the\n113|// predecessor-legality check can refuse. A mutant admitting the\n114|// self link must fail this test by building successfully.\n115|func TestSelfPredecessorWithCheckpointMustRefuse(t *testing.T) {\n116|\treader := successorFixture(t)\n117|\tcheckpoint := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n118|\twithCheckpoints(reader, checkpoint)\n119|\twithLeases(reader, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, leaseB, checkpointDigestOf(t, checkpoint)))\n120|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n121|\t\tt.Fatalf(\"self predecessor with valid checkpoint build = %v, want integrity_failure\", err)\n122|\t}\n123|}\n124|\n125|func TestDanglingPredecessorMustRefuse(t *testing.T) {\n126|\treader := successorFixture(t)\n127|\tdangling := leaseRecordBytes(t, idA, 2, leaseB, hostA, danglingLeaseID, true)\n128|\twithLeases(reader, dangling)\n129|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n130|\t\tt.Fatalf(\"dangling predecessor build = %v, want selector_observation_unavailable\", err)\n131|\t}\n132|}\n133|\n134|func TestWrongSessionCheckpointMustRefuse(t *testing.T) {\n135|\treader := successorFixture(t)\n136|\t// The referenced checkpoint is validated but carries another\n137|\t// session: the winner's reference cannot be established.\n138|\tforeign := checkpointRecordBytes(t, idB, 1, lease, hostA)\n139|\twithCheckpoints(reader, foreign)\n140|\tsuccessor := leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, foreign))\n141|\twithLeases(reader, successor)\n142|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n143|\t\tt.Fatalf(\"wrong-session checkpoint build = %v, want selector_observation_unavailable\", err)\n144|\t}\n145|}\n146|\n147|func TestWrongPredecessorCheckpointMustRefuse(t *testing.T) {\n148|\treader := successorFixture(t)\n149|\t// The referenced checkpoint is validated for this session but\n150|\t// bound to another lease, not the winner's predecessor.\n151|\tmisbound := checkpointRecordBytes(t, idA, 1, leaseCycleB, hostA)\n152|\twithCheckpoints(reader, misbound)\n153|\tsuccessor := leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, misbound))\n154|\twithLeases(reader, successor)\n155|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n156|\t\tt.Fatalf(\"wrong-predecessor checkpoint build = %v, want selector_observation_unavailable\", err)\n157|\t}\n158|}\n159|\n160|func TestMalformedCheckpointBytesRefuseConfig(t *testing.T) {\n161|\treader := successorFixture(t)\n162|\tcheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n163|\twithCheckpoints(reader, checkpoint)\n164|\tsuccessor := leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, checkpoint))\n165|\twithLeases(reader, successor)\n166|\treader.CheckpointRecords = append(reader.CheckpointRecords, []byte(`{broken`))\n167|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrInvalidConfig) {\n168|\t\tt.Fatalf(\"malformed checkpoint build = %v, want invalid_config\", err)\n169|\t}\n170|}\n171|\n172|func TestEpochOneWithSelfBoundCheckpointBuilds(t *testing.T) {\n173|\treader, _, _, _ := plannedSession(t)\n174|\treader.LeaseRecords = nil\n175|\t// An epoch-1 lease past the first provider boundary references\n176|\t// a validated checkpoint taken under itself: the only lease a\n177|\t// root can name.\n178|\tcheckpoint := checkpointRecordBytes(t, idA, 1, lease, hostA)\n179|\twithCheckpoints(reader, checkpoint)\n180|\twithLeases(reader, leaseEpochOneWithCheckpoint(t, idA, lease, hostA, checkpointDigestOf(t, checkpoint)))\n181|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n182|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease {\n183|\t\tt.Fatalf(\"epoch-1 checkpointed triple: %+v\", plan)\n184|\t}\n185|\tif err := reader.Revalidate(plan); err != nil {\n186|\t\tt.Fatalf(\"epoch-1 checkpointed plan is not current: %v\", err)\n187|\t}\n188|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
