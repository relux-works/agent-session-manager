rd, the epoch-2 successor naming\n216|// it, and the Checkpoint Record taken under the predecessor that the\n217|// successor references. It returns the successor Lease Record digest\n218|// for plan assertions.\n219|func withSuccessor(t *testing.T, reader *Reader, sessionID, holder, successorLeaseID string) string {\n220|\tt.Helper()\n221|\tcheckpoint := checkpointRecordBytes(t, sessionID, 1, lease, holder)\n222|\tdigest := checkpointDigestOf(t, checkpoint)\n223|\twithCheckpoints(reader, checkpoint)\n224|\twithLeases(reader,\n225|\t\tleaseCreate(t, sessionID, holder),\n226|\t\tleaseSuccessorBytes(t, sessionID, 2, successorLeaseID, holder, lease, digest),\n227|\t)\n228|\treturn digest\n229|}\n230|\n231|// withCheckpoints attaches validated Checkpoint Records to a reader.\n232|func withCheckpoints(reader *Reader, checkpoints ...[]byte) *Reader {\n233|\treader.CheckpointRecords = append(append([][]byte(nil), reader.CheckpointRecords...), checkpoints...)\n234|\treturn reader\n235|}\n236|\n237|// withLeases attaches validated Lease Records to a reader.\n238|func withLeases(reader *Reader, leases ...[]byte) *Reader {\n239|\treader.LeaseRecords = append(append([][]byte(nil), reader.LeaseRecords...), leases...)\n240|\treturn reader\n241|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
