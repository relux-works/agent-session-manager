{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ff","stream":{"kind":"session","id":"01a0882f-8c55-77c0-a926-2dcd5f0e317e"},"sequence":218,"recorded_at":1780531400000431,"record_type":"event","durability":"durable","causation_id":"b1162590-3555-4533-a62e-f38ed0b51836","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b1162590-3555-4533-a62e-f38ed0b51836","run_stream":{"kind":"run","id":"b1162590-3555-4533-a62e-f38ed0b51836"},"task_stream":{"kind":"task","id":"01a08830-0cc2-77f1-b48c-2ef579299d65"},"task_id":"01a08830-0cc2-77f1-b48c-2ef579299d65","event":{"kind":"output","task_id":"01a08830-0cc2-77f1-b48c-2ef579299d65","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|)\n61|\n62|// PeerIndex binds a peer identity to its already persisted learned index.\n63|// Transport/authentication and installing peer indexes are upstream owners;\n64|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n65|type PeerIndex struct {\n66|\tHostID string\n67|\tRepo   *sessrepo.Repository\n68|}\n69|\n70|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n71|// configuration layer, separately from the learned indexes. An unlisted source\n72|// is never read. Failed reads from listed sources are errors, never\n73|// empty indexes that let resolution fall through to a lower-priority UUID.\n74|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n75|//\n76|// Aliases carries the exact configured peer-alias mapping (host ID to\n77|// alias) from the same configuration owner, kept separate from the\n78|// learned index handles: a mapping without a handle contributes no\n79|// learned names, and a handle without a mapping stays reachable through\n80|// the bare union and the \"id:\" host form but never through \"peer:\".\n81|// Alias comparison is always exact, never folded, trimmed, or decoded.\n82|type Reader struct {\n83|\tLocal              *sessrepo.Repository\n84|\tLocalHostID        string\n85|\tAllowlistedPeerIDs []string\n86|\tPeers              []PeerIndex\n87|\tAliases            map[string]string\n88|}\n89|\n90|// Summary contains only facts derived from verified session records and events.\n91|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n92|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n93|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n94|// process liveness and sync timestamps require their respective observation\n95|// owners and are deliberately not inferred from a record or a successful read.\n96|type Summary struct {\n97|\tProjection sessstate.Projection\n98|}\n99|\n100|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n101|// visible with their blocking reason and retry; failure to enumerate the index\n102|// fails the read. No durable state is written, even for an interrupted create.\n103|func (reader *Reader) List() ([]Summary, error) {\n104|\tif reader == nil || reader.Local == nil {\n105|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n106|\t}\n107|\treturn reader.read(reader.Local)\n108|}\n109|\n110|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n111|\trows, err := repo.ListSessions()\n112|\tif err != nil {\n113|\t\treturn nil, err\n114|\t}\n115|\tout := make([]Summary, 0, len(rows))\n116|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n117|\tfor _, row := range rows {\n118|\t\tprojection, err := projector.Project(row.SessionID)\n119|\t\tif err != nil {\n120|\t\t\treturn nil, err\n121|\t\t}\n122|\t\tout = append(out, Summary{Projection: projection})\n123|\t}\n124|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n125|\treturn out, nil\n126|}\n127|\n128|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n129|// the same path as Resolve, then projects from the selected repository. It\n130|// never treats a failed read as not found. Parked sessions can be inspected\n131|// by ID through InspectLocal, independently of live-name routing, so\n132|// operators retain access to the recovery diagnostics.\n133|func (reader *Reader) Status(selector string) (Summary, error) {\n134|\tselected, err := reader.Resolve(selector)\n135|\tif err != nil {\n136|\t\treturn Summary{}, err\n137|\t}\n138|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n139|\tif err != nil {\n140|\t\treturn Summary{}, err\n141|\t}\n142|\treturn Summary{Projection: projection}, nil\n143|}\n144|\n145|// InspectLocal reads one local ID, including a parked or tombstoned session.\n146|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n147|\tif reader == nil || reader.Local == nil {\n148|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n149|\t}\n150|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n151|\tif err != nil {\n152|\t\treturn Summary{}, err\n153|\t}\n154|\treturn Summary{Projection: projection}, nil\n155|}\n156|\n157|// Selection identifies the session and source index, never an attach or mutation\n158|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n159|type Selection struct {\n160|\tSessionID  string\n161|\tPeerHostID string\n162|\trepo       *sessrepo.Repository\n163|}\n164|\n165|type candidate struct {\n166|\tsummary   Summary\n167|\tselection Selection\n168|}\n169|\n170|// Resolve applies one parsed selector through the single shared path:\n171|// grammar first, then effective-configuration validation, then the\n172|// source tier. A bare selector retains the exact Section 2.3 tiers:\n173|// local exact live name, allowlisted peer exact live name, exact UUID,\n174|// not found. An \"id:\" key bypasses names for the durable UUID in the\n175|// local and allowed-peer union. A qualified selector resolves its key\n176|// in exactly one source index with no fallback. ASCII folding detects\n177|// collisions within each name tier; it does not turn a unique case\n178|// variant into an exact match. Repository-parked entries (failed reads,\n179|// never tombstone evidence) and tombstoned entries (authoritative\n180|// tombstone evidence) are not live candidates. A tier that must be\n181|// read but cannot be read is a read failure, not permission to proceed\n182|// to a lower tier. This is logical index eligibility, not proof of\n183|// process liveness or safe attach/resume readiness; those decisions\n184|// belong to the action planner invoking plans at its boundaries.\n185|func (reader *Reader) Resolve(selector string) (Selection, error) {\n186|\tparsed, err := ParseSelector(selector)\n187|\tif err != nil {\n188|\t\treturn Selection{}, err\n189|\t}\n190|\tif reader == nil || reader.Local == nil {\n191|\t\treturn Selection{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n192|\t}\n193|\tconfig, err := reader.validatedConfiguration()\n194|\tif err != nil {\n195|\t\treturn Selection{}, err\n196|\t}\n197|\tif parsed.Source != SourceBare {\n198|\t\treturn reader.resolveExplicit(parsed, config)\n199|\t}\n200|\treturn reader.resolveBare(parsed, config)\n201|}\n202|\n203|// resolveBare applies the Section 2.3 tiers over the local and\n204|// allowed-peer union. Unread lower tiers are never consulted after a\n205|// unique higher-tier match; a tier that must be read but cannot be\n206|// read fails the resolution instead of falling through.\n207|func (reader *Reader) resolveBare(parsed Selector, config validatedConfig) (Selection, error) {\n208|\tlocal, err := reader.read(reader.Local)\n209|\tif err != nil {\n210|\t\treturn Selection{}, err\n211|\t}\n212|\tlocalLive := liveCandidates(local, reader.Local, \"\")\n213|\t// Peer tiers read lazily: a unique local name match never depends\n214|\t// on lower-tier reads, but any tier that must be read and cannot\n215|\t// be read fails instead of falling through.\n216|\tpeers, peersRead := []candidate(nil), false\n217|\treadPeers := func() ([]candidate, error) {\n218|\t\tif !peersRead {\n219|\t\t\tpeersRead = true\n220|\t\t\tvar err error\n221|\t\t\tpeers, err = reader.peerCandidates()\n222|\t\t\tif err != nil {\n223|\t\t\t\treturn nil, err\n224|\t\t\t}\n225|\t\t}\n226|\t\treturn peers, nil\n227|\t}\n228|\tif parsed.IDKey {\n229|\t\tunion, err := readPeers()\n230|\t\tif err != nil {\n231|\t\t\treturn Selection{}, err\n232|\t\t}\n233|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), append(localLive, union...), config)\n234|\t}\n235|\tif match, found, err := matchName(localLive, parsed.Key); found || err != nil {\n236|\t\treturn match, err\n237|\t}\n238|\tunion, err := readPeers()\n239|\tif err != nil {\n240|\t\treturn Selection{}, err\n241|\t}\n242|\tif match, found, err := matchName(union, parsed.Key); found || err != nil {\n243|\t\tif err != nil {\n244|\t\t\treturn Selection{}, err\n245|\t\t}\n246|\t\tif err := checkRecordAgreement(append(append([]candidate(nil), localLive...), union...), match); err != nil {\n247|\t\t\treturn Selection{}, err\n248|\t\t}\n249|\t\treturn match, nil\n250|\t}\n251|\tif parsed.UUIDShaped {\n252|\t\treturn selectIdentity(parsed.Key, append(localLive, union...), config)\n253|\t}\n254|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, parsed.Raw)\n255|}\n256|\n257|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n258|\tout := make([]candidate, 0, len(rows))\n259|\tfor _, row := range rows {\n260|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n264|\t}\n265|\treturn out\n266|}\n267|\n268|// resolveExplicit selects a key in exactly one configured source index.\n269|// An explicit source never falls back to the local index, another peer,\n270|// a cached index from another source, or a union search, even when the\n271|// same name or UUID exists there: a miss in the selected source is not\n272|// found, and a source that cannot be completely read is a read failure.\n273|func (reader *Reader) resolveExplicit(parsed Selector, config validatedConfig) (Selection, error) {\n274|\trepo, peerHost, err := reader.locateSource(parsed, config)\n275|\tif err != nil {\n276|\t\treturn Selection{}, err\n277|\t}\n278|\trows, err := reader.readSource(repo, peerHost)\n279|\tif err != nil {\n280|\t\treturn Selection{}, err\n281|\t}\n282|\tlive := liveCandidates(rows, repo, peerHost)\n283|\tif parsed.IDKey {\n284|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)\n285|\t}\n286|\tif match, found, err := matchName(live, parsed.Key); found || err != nil {\n287|\t\treturn match, err\n288|\t}\n289|\tif parsed.UUIDShaped {\n290|\t\treturn selectIdentity(parsed.Key, live, config)\n291|\t}\n292|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))\n293|}\n294|\n295|// locateSource maps an explicit source to its index handle. An explicit\n296|// unknown alias or host is selector_source_not_found; a known but\n297|// disallowed peer is peer_not_allowlisted. The local source is always\n298|// admitted and needs no allowlist entry.\n299|func (reader *Reader) locateSource(parsed Selector, config validatedConfig) (*sessrepo.Repository, string, error) {\n300|\tswitch parsed.Source {\n301|\tcase SourceLocal:\n302|\t\treturn reader.Local, \"\", nil\n303|\tcase SourcePeerAlias:\n304|\t\thost, ok := config.hostForAlias(reader, parsed.SourceValue)\n305|\t\tif !ok {\n306|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)\n307|\t\t}\n308|\t\tif _, allowed := config.allowed[host]; !allowed {\n309|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)\n310|\t\t}\n311|\t\treturn reader.peerRepo(host)\n312|\tcase SourcePeerHost:\n313|\t\tif config.localHost != \"\" && parsed.SourceValue == config.localHost {\n314|\t\t\treturn reader.Local, \"\", nil\n315|\t\t}\n316|\t\tif !knownPeer(reader, parsed.SourceValue) {\n317|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for host %s\", ErrSourceNotFound, parsed.SourceValue)\n318|\t\t}\n319|\t\tif _, allowed := config.allowed[parsed.SourceValue]; !allowed {\n320|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, parsed.SourceValue)\n321|\t\t}\n322|\t\treturn reader.peerRepo(parsed.SourceValue)\n323|\tdefault:\n324|\t\treturn nil, \"\", fmt.Errorf(\"%w: unknown selector source\", ErrInvalidArgument)\n325|\t}\n326|}\n327|\n328|// knownPeer reports whether a host carries a configured learned index,\n329|// regardless of allowlisting or readability.\n330|func knownPeer(reader *Reader, host string) bool {\n331|\tfor _, peer := range reader.Peers {\n332|\t\tif peer.HostID == host {\n333|\t\t\treturn true\n334|\t\t}\n335|\t}\n336|\treturn false\n337|}\n338|\n339|// peerRepo binds one allowlisted peer host to its learned index handle.\n340|// A peer with no advertised index cannot be completely read, so\n341|// explicit selection refuses with the read-failure class instead of\n342|// treating the source as absent; union tiers simply learn nothing from\n343|// it. A listed index with an unavailable repository is the same failed\n344|// observation.\n345|func (reader *Reader) peerRepo(host string) (*sessrepo.Repository, string, error) {\n346|\tseen := false\n347|\tvar repo *sessrepo.Repository\n348|\tfor _, peer := range reader.Peers {\n349|\t\tif peer.HostID != host {\n350|\t\t\tcontinue\n351|\t\t}\n352|\t\tif seen {\n353|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, host)\n354|\t\t}\n355|\t\tseen = true\n356|\t\trepo = peer.Repo\n357|\t}\n358|\tif !seen {\n359|\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s advertises no learned index\", ErrSourceReadFailed, host)\n360|\t}\n361|\tif repo == nil {\n362|\t\treturn nil, \"\", peerReadFailed(host, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, host))\n363|\t}\n364|\treturn repo, host, nil\n365|}\n366|\n367|// readSource completes one source read. Local I-O failures keep their\n368|// repository error; remote failures carry the read-failure class while\n369|// preserving the underlying cause for errors.Is.\n370|func (reader *Reader) readSource(repo *sessrepo.Repository, peerHost string) ([]Summary, error) {\n371|\trows, err := reader.read(repo)\n372|\tif err != nil {\n373|\t\tif peerHost == \"\" {\n374|\t\t\treturn nil, err\n375|\t\t}\n376|\t\treturn nil, peerReadFailed(peerHost, err)\n377|\t}\n378|\treturn rows, nil\n379|}\n380|\n381|// peerReadFailed marks a remote-source read failure with its contract\n382|// class while preserving the underlying cause: a failed read is never\n383|// an absence that lets resolution fall through to another source.\n384|func peerReadFailed(host string, err error) error {\n385|\treturn errors.Join(fmt.Errorf(\"%w: peer %s index read failed\", ErrSourceReadFailed, host), err)\n386|}\n387|\n388|// describeSource names the selected source for refusal evidence: exact\n389|// literal alias or host, never a display name.\n390|func describeSource(parsed Selector) string {\n391|\tswitch parsed.Source {\n392|\tcase SourceLocal:\n393|\t\treturn \"local\"\n394|\tcase SourcePeerAlias:\n395|\t\treturn fmt.Sprintf(\"peer:%s\", parsed.SourceValue)\n396|\tcase SourcePeerHost:\n397|\t\treturn fmt.Sprintf(\"id:%s\", parsed.SourceValue)\n398|\tdefault:\n399|\t\treturn \"bare\"\n400|\t}\n401|}\n402|\n403|// selectIdentity selects a durable session UUID from live candidates\n404|// independent of names: the \"id:\" key form and the UUID tier. Copies\n405|// of one UUID deduplicate only when their immutable record digests\n406|// agree; disagreeing copies are inconsistent authority\n407|// (integrity_failure), not an ambiguity. Identical copies select the\n408|// bytewise smallest holder host.\n409|func selectIdentity(uuid string, pool []candidate, config validatedConfig) (Selection, error) {\n410|\tid, err := scalar.ParseUUIDv7(uuid)\n411|\tif err != nil {\n412|\t\treturn Selection{}, fmt.Errorf(\"%w: malformed session UUID: %v\", ErrInvalidArgument, err)\n413|\t}\n414|\tvar matches []candidate\n415|\tfor _, item := range pool {\n416|\t\tif item.selection.SessionID == id.String() {\n417|\t\t\tmatches = append(matches, item)\n418|\t\t}\n419|\t}\n420|\tif len(matches) == 0 {\n421|\t\treturn Selection{}, fmt.Errorf(\"%w: no live session with ID %q\", ErrNotFound, id.String())\n422|\t}\n423|\tfor _, item := range matches[1:] {\n424|\t\tif item.summary.Projection.RecordID != matches[0].summary.Projection.RecordID {\n425|\t\t\treturn Selection{}, fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, id.String())\n426|\t\t}\n427|\t}\n428|\tbest := matches[0]\n429|\tfor _, item := range matches[1:] {\n430|\t\tif holderHost(item.selection.PeerHostID, config.localHost) < holderHost(best.selection.PeerHostID, config.localHost) {\n431|\t\t\tbest = item\n432|\t\t}\n433|\t}\n434|\treturn best.selection, nil\n435|}\n436|\n437|// holderHost orders copy holders bytewise for the deterministic tie\n438|// break. PeerHostID is empty for local copies; while the local host\n439|// identity is unknown the local copy sorts before every peer,\n440|// preserving local priority there.\n441|func holderHost(peerHost, localHost string) string {\n442|\tif peerHost == \"\" {\n443|\t\tif localHost == \"\" {\n444|\t\t\treturn \"\"\n445|\t\t}\n446|\t\treturn localHost\n447|\t}\n448|\treturn peerHost\n449|}\n450|\n451|// checkRecordAgreement refuses inconsistent authority behind a name\n452|// match: every consulted live copy of the won UUID must carry the same\n453|// immutable record digest. Replicated identical copies stay one\n454|// identity; disagreeing copies are integrity failure, not ambiguity.\n455|func checkRecordAgreement(pool []candidate, won Selection) error {\n456|\tdigest := \"\"\n457|\tseen := false\n458|\tfor _, item := range pool {\n459|\t\tif item.selection.SessionID != won.SessionID {\n460|\t\t\tcontinue\n461|\t\t}\n462|\t\tif !seen {\n463|\t\t\tdigest, seen = item.summary.Projection.RecordID, true\n464|\t\t\tcontinue\n465|\t\t}\n466|\t\tif item.summary.Projection.RecordID != digest {\n467|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, won.SessionID)\n468|\t\t}\n469|\t}\n470|\treturn nil\n471|}\n472|\n473|func (reader *Reader) peerCandidates() ([]candidate, error) {\n474|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n475|\tsort.Strings(ids)\n476|\tvar out []candidate\n477|\tfor index, id := range ids {\n478|\t\tif index > 0 && id == ids[index-1] {\n479|\t\t\tcontinue\n480|\t\t}\n481|\t\tvar repo *sessrepo.Repository\n482|\t\tfound := false\n483|\t\tfor _, peer := range reader.Peers {\n484|\t\t\tif peer.HostID != id {\n485|\t\t\t\tcontinue\n486|\t\t\t}\n487|\t\t\tif found {\n488|\t\t\t\treturn nil, fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, id)\n489|\t\t\t}\n490|\t\t\tfound = true\n491|\t\t\trepo = peer.Repo\n492|\t\t}\n493|\t\t// An allowlisted peer with no learned index contributes no learned names.\n494|\t\t// A listed index with an unavailable repository is a failed observation.\n495|\t\tif !found {\n496|\t\t\tcontinue\n497|\t\t}\n498|\t\tif repo == nil {\n499|\t\t\treturn nil, peerReadFailed(id, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, id))\n500|\t\t}\n(more lines below)","final_result":true}}}
