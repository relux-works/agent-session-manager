{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c543","stream":{"kind":"session","id":"01a0882f-8c55-77c0-a926-2dcd5f0e317e"},"sequence":252,"recorded_at":1780531400000499,"record_type":"event","durability":"durable","causation_id":"b1162590-3555-4533-a62e-f38ed0b51836","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b1162590-3555-4533-a62e-f38ed0b51836","run_stream":{"kind":"run","id":"b1162590-3555-4533-a62e-f38ed0b51836"},"task_stream":{"kind":"task","id":"01a08830-19c1-7973-a5c0-45c6dfc6d18c"},"task_id":"01a08830-19c1-7973-a5c0-45c6dfc6d18c","event":{"kind":"output","task_id":"01a08830-19c1-7973-a5c0-45c6dfc6d18c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation and\n6|// failures): caller shapes, current configuration validation,\n7|// authorization revocation, source binding, configuration digest,\n8|// source read, selection absence, current projection, session record,\n9|// winning lease, authority heads, and finally the source index digest.\n10|// Fine-grained reasons distinguish the checks without splitting the\n11|// class; tests assert both.\n12|package sessquery\n13|\n14|import (\n15|\t\"encoding/json\"\n16|\t\"fmt\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n20|)\n21|\n22|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n23|const uint53Ceiling = uint64(1<<53 - 1)\n24|\n25|// Revalidate compares every bound plan fact against current\n26|// configuration and freshly reread source data. The session is located\n27|// by its UUID in the plan's source only, never re-resolved by name. A\n28|// nil return means the plan is current; any error classifies exactly:\n29|// selector_plan_stale (with the first diverged member named),\n30|// peer_not_allowlisted on explicit authorization revocation,\n31|// invalid_config on current configuration failures, invalid_arguments\n32|// on a malformed caller plan, and the read or projection failure class\n33|// when a required read or validation fails.\n34|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n35|\tif err := checkPlanShapes(plan); err != nil {\n36|\t\treturn err\n37|\t}\n38|\tif reader == nil || reader.Local == nil {\n39|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n40|\t}\n41|\tconfig, err := reader.validatedConfiguration()\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tpeerHost, isPeer := planSourceBinding(plan, config)\n46|\tif isPeer {\n47|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n48|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n49|\t\t}\n50|\t}\n51|\tif !bindingHolds(plan, config, reader) {\n52|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n53|\t}\n54|\tconfiguration, err := fingerprintConfiguration(reader, config)\n55|\tif err != nil {\n56|\t\treturn err\n57|\t}\n58|\tif configuration != plan.ConfigurationDigest {\n59|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n60|\t}\n61|\tvar repo = reader.Local\n62|\tsourcePeer := \"\"\n63|\tif isPeer {\n64|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n65|\t\tif err != nil {\n66|\t\t\treturn err\n67|\t\t}\n68|\t}\n69|\trows, err := reader.readSource(repo, sourcePeer)\n70|\tif err != nil {\n71|\t\treturn err\n72|\t}\n73|\tvar recordID string\n74|\tabsent := true\n75|\tfor _, row := range rows {\n76|\t\tif row.Projection.SessionID == plan.SessionID {\n77|\t\t\trecordID, absent = row.Projection.RecordID, false\n78|\t\t\tbreak\n79|\t\t}\n80|\t}\n81|\tif absent {\n82|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n83|\t}\n84|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n85|\tif err != nil {\n86|\t\treturn err\n87|\t}\n88|\tif recordID != plan.SessionRecordID {\n89|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n90|\t}\n91|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\n92|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n93|\t}\n94|\ttail, err := chainTail(repo, plan.SessionID)\n95|\tif err != nil {\n96|\t\tif sourcePeer == \"\" {\n97|\t\t\treturn err\n98|\t\t}\n99|\t\treturn peerReadFailed(sourcePeer, err)\n100|\t}\n101|\theads := []string{}\n102|\tif tail != \"\" {\n103|\t\theads = []string{tail}\n104|\t}\n105|\tif !equalStrings(heads, plan.AuthorityHeads) {\n106|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n107|\t}\n108|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n109|\tif err != nil {\n110|\t\treturn err\n111|\t}\n112|\tif index != plan.SourceIndexDigest {\n113|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n114|\t}\n115|\treturn nil\n116|}\n117|\n118|// planSourceBinding resolves the plan's bound source: a local plan\n119|// carries a null alias with an empty or local host, while any other\n120|// binding selects a peer source by host. The second return reports\n121|// whether the plan selects a peer source.\n122|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n123|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n124|\t\treturn \"\", false\n125|\t}\n126|\treturn plan.SourceHostID, true\n127|}\n128|\n129|// bindingHolds reports whether the plan's bound (host, alias) source\n130|// still resolves to the same source in the current configuration. A\n131|// local plan holds while its host is empty or the current local host;\n132|// a peer plan holds while its host is still a known peer carrying the\n133|// exact bound alias.\n134|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n135|\tif plan.SourceAlias == nil {\n136|\t\tif plan.SourceHostID == \"\" {\n137|\t\t\treturn true\n138|\t\t}\n139|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n140|\t\t\treturn true\n141|\t\t}\n142|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n143|\t\t\treturn true\n144|\t\t}\n145|\t\treturn false\n146|\t}\n147|\tif !knownPeer(reader, plan.SourceHostID) {\n148|\t\treturn false\n149|\t}\n150|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n151|}\n152|\n153|// equalStrings compares sorted unique string slices element-wise.\n154|func equalStrings(first, second []string) bool {\n155|\tif len(first) != len(second) {\n156|\t\treturn false\n157|\t}\n158|\tfor index := range first {\n159|\t\tif first[index] != second[index] {\n160|\t\t\treturn false\n161|\t\t}\n162|\t}\n163|\treturn true\n164|}\n165|\n166|// checkPlanShapes validates the caller-supplied plan members without\n167|// consulting any authority: exact contract version, grammatical\n168|// selector, canonical UUIDs and digests, exact alias bound, sorted\n169|// unique authority heads, a consistent lease triple (all empty while\n170|// no winning lease is observed, otherwise positive uint53 epoch with a\n171|// UUIDv4 lease and a UUIDv7 owner), a known action tag, and a null or\n172|// UUIDv7 destination. Authority comes only from Revalidate.\n173|func checkPlanShapes(plan SelectionPlan) error {\n174|\tif plan.SelectorVersion != SelectorVersion {\n175|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n176|\t}\n177|\tif _, err := ParseSelector(plan.Selector); err != nil {\n178|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n179|\t}\n180|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n181|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n182|\t}\n183|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n184|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n185|\t}\n186|\tif plan.SourceHostID != \"\" {\n187|\t\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n188|\t\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n189|\t\t}\n190|\t}\n191|\tif plan.SourceAlias != nil {\n192|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n193|\t\t\t// An alias-less peer binds empty, which never passes the\n194|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n195|\t\t\tif *plan.SourceAlias != \"\" {\n196|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n197|\t\t\t}\n198|\t\t}\n199|\t}\n200|\tfor _, member := range []struct {\n201|\t\tname   string\n202|\t\tdigest string\n203|\t}{\n204|\t\t{\"source index\", plan.SourceIndexDigest},\n205|\t\t{\"configuration\", plan.ConfigurationDigest},\n206|\t\t{\"expectation\", plan.ExpectationDigest},\n207|\t} {\n208|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n209|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n210|\t\t}\n211|\t}\n212|\t// The lease triple is all empty while no winning lease is observed;\n213|\t// otherwise the epoch is a positive uint53 with a UUIDv4 lease and a\n214|\t// UUIDv7 owner. Partial triples and placeholders are refused.\n215|\tswitch {\n216|\tcase plan.LeaseEpoch == 0 && plan.LeaseID == \"\" && plan.OwnerHostID == \"\":\n217|\tcase plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling:\n218|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n219|\tdefault:\n220|\t\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n221|\t\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n222|\t\t}\n223|\t\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n225|\t\t}\n226|\t}\n227|\tfor index, head := range plan.AuthorityHeads {\n228|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n229|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n230|\t\t}\n231|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n232|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n233|\t\t}\n234|\t}\n235|\tif _, ok := BoundariesFor(plan.Action); !ok {\n236|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n237|\t}\n238|\tif plan.DestinationHostID != nil {\n239|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n240|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n241|\t\t}\n242|\t}\n243|\treturn nil\n244|}\n245|\n246|// planWire is the tamper-evident persistence encoding: every bound\n247|// member plus the locally verified canonical digest over all of them.\n248|type planWire struct {\n249|\tSelectorVersion     string   `json:\"selector_version\"`\n250|\tSelector            string   `json:\"selector\"`\n251|\tSessionID           string   `json:\"session_id\"`\n252|\tSessionRecordID     string   `json:\"session_record_id\"`\n253|\tSourceHostID        string   `json:\"source_host_id\"`\n254|\tSourceAlias         *string  `json:\"source_alias\"`\n255|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n256|\tConfigurationDigest string   `json:\"configuration_digest\"`\n257|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n258|\tLeaseID             string   `json:\"lease_id\"`\n259|\tOwnerHostID         string   `json:\"owner_host_id\"`\n260|\tAuthorityHeads      []string `json:\"authority_heads\"`\n261|\tAction              string   `json:\"action\"`\n262|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n263|\tExpectationDigest   string   `json:\"expectation_digest\"`\n264|\tPlanDigest          string   `json:\"plan_digest\"`\n265|}\n266|\n267|// Digest returns the locally verified canonical digest over all bound\n268|// plan members. It is recomputed on every call and never trusted from\n269|// caller bytes.\n270|func (plan SelectionPlan) Digest() (string, error) {\n271|\theads := append([]string(nil), plan.AuthorityHeads...)\n272|\tif heads == nil {\n273|\t\theads = []string{}\n274|\t}\n275|\treturn fingerprint(map[string]any{\n276|\t\t\"action\":               plan.Action,\n277|\t\t\"authority_heads\":      heads,\n278|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n279|\t\t\"destination_host_id\":  plan.DestinationHostID,\n280|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n281|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n282|\t\t\"lease_id\":             plan.LeaseID,\n283|\t\t\"owner_host_id\":        plan.OwnerHostID,\n284|\t\t\"selector\":             plan.Selector,\n285|\t\t\"selector_version\":     plan.SelectorVersion,\n286|\t\t\"session_id\":           plan.SessionID,\n287|\t\t\"session_record_id\":    plan.SessionRecordID,\n288|\t\t\"source_alias\":         plan.SourceAlias,\n289|\t\t\"source_host_id\":       plan.SourceHostID,\n290|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n291|\t})\n292|}\n293|\n294|// Marshal encodes the plan with its locally verified digest. The\n295|// encoding keeps null alias and destination distinct from empty.\n296|func (plan SelectionPlan) Marshal() ([]byte, error) {\n297|\tdigest, err := plan.Digest()\n298|\tif err != nil {\n299|\t\treturn nil, err\n300|\t}\n301|\theads := append([]string(nil), plan.AuthorityHeads...)\n302|\tif heads == nil {\n303|\t\theads = []string{}\n304|\t}\n305|\treturn json.Marshal(planWire{\n306|\t\tSelectorVersion:     plan.SelectorVersion,\n307|\t\tSelector:            plan.Selector,\n308|\t\tSessionID:           plan.SessionID,\n309|\t\tSessionRecordID:     plan.SessionRecordID,\n310|\t\tSourceHostID:        plan.SourceHostID,\n311|\t\tSourceAlias:         plan.SourceAlias,\n312|\t\tSourceIndexDigest:   plan.SourceIndexDigest,\n313|\t\tConfigurationDigest: plan.ConfigurationDigest,\n314|\t\tLeaseEpoch:          plan.LeaseEpoch,\n315|\t\tLeaseID:             plan.LeaseID,\n316|\t\tOwnerHostID:         plan.OwnerHostID,\n317|\t\tAuthorityHeads:      heads,\n318|\t\tAction:              plan.Action,\n319|\t\tDestinationHostID:   plan.DestinationHostID,\n320|\t\tExpectationDigest:   plan.ExpectationDigest,\n321|\t\tPlanDigest:          digest,\n322|\t})\n323|}\n324|\n325|// ParsePlan decodes a persisted plan, validates every member shape,\n326|// and verifies the tamper-evident digest. A verified encoding is still\n327|// not authority: only Revalidate against current facts decides\n328|// currency, and digest equality alone never substitutes for it.\n329|func ParsePlan(raw []byte) (SelectionPlan, error) {\n330|\tvar wire planWire\n331|\tif err := json.Unmarshal(raw, &wire); err != nil {\n332|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed plan encoding: %v\", ErrInvalidArgument, err)\n333|\t}\n334|\tplan := SelectionPlan{\n335|\t\tSelectorVersion:     wire.SelectorVersion,\n336|\t\tSelector:            wire.Selector,\n337|\t\tSessionID:           wire.SessionID,\n338|\t\tSessionRecordID:     wire.SessionRecordID,\n339|\t\tSourceHostID:        wire.SourceHostID,\n340|\t\tSourceAlias:         wire.SourceAlias,\n341|\t\tSourceIndexDigest:   wire.SourceIndexDigest,\n342|\t\tConfigurationDigest: wire.ConfigurationDigest,\n343|\t\tLeaseEpoch:          wire.LeaseEpoch,\n344|\t\tLeaseID:             wire.LeaseID,\n345|\t\tOwnerHostID:         wire.OwnerHostID,\n346|\t\tAuthorityHeads:      wire.AuthorityHeads,\n347|\t\tAction:              wire.Action,\n348|\t\tDestinationHostID:   wire.DestinationHostID,\n349|\t\tExpectationDigest:   wire.ExpectationDigest,\n350|\t}\n351|\tif plan.AuthorityHeads == nil {\n352|\t\tplan.AuthorityHeads = []string{}\n353|\t}\n354|\tif err := checkPlanShapes(plan); err != nil {\n355|\t\treturn SelectionPlan{}, err\n356|\t}\n357|\tdigest, err := plan.Digest()\n358|\tif err != nil {\n359|\t\treturn SelectionPlan{}, err\n360|\t}\n361|\tif digest != wire.PlanDigest {\n362|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: plan digest mismatch\", ErrInvalidArgument)\n363|\t}\n364|\treturn plan, nil\n365|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c545","stream":{"kind":"session","id":"01a0882f-8c55-77c0-a926-2dcd5f0e317e"},"sequence":253,"recorded_at":1780531400000501,"record_type":"event","durability":"durable","causation_id":"b1162590-3555-4533-a62e-f38ed0b51836","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b1162590-3555-4533-a62e-f38ed0b51836","run_stream":{"kind":"run","id":"b1162590-3555-4533-a62e-f38ed0b51836"},"task_stream":{"kind":"task","id":"01a08830-19c1-7973-a5c0-45c6dfc6d18c"},"task_id":"01a08830-19c1-7973-a5c0-45c6dfc6d18c","event":{"kind":"completed","task_id":"01a08830-19c1-7973-a5c0-45c6dfc6d18c"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c547","stream":{"kind":"session","id":"01a0882f-8c55-77c0-a926-2dcd5f0e317e"},"sequence":254,"recorded_at":1780531400000503,"record_type":"event","durability":"durable","causation_id":"b1162590-3555-4533-a62e-f38ed0b51836","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b1162590-3555-4533-a62e-f38ed0b51836","run_stream":{"kind":"run","id":"b1162590-3555-4533-a62e-f38ed0b51836"},"call_id":"call_01a0883016257e219d0994f40dfd2a02","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability.\n13|//\n14|// One member of the sixteen-row contract table stays unbound in this\n15|// story boundary, and the plan carries no placeholder for it: there\n16|// are no Lease Record objects in this stack, so lease_record_id has no\n17|// validated digest to bind. Authority heads bind the validated\n18|// event-head digests of the plan source only. The winning lease triple (epoch, lease ID,\n19|// owner) binds from the validated envelope derivation instead. The\n20|// lease-record runtime owns extending this binding; the plan shape\n21|// documents the exact delta so a future member without a row fails its\n22|// publication gate closed instead of falling into a default.\n23|//\n24|// Revalidation rereads the current configuration and the plan's source,\n25|// validates the same immutable record, the current winning lease, and\n26|// the action prerequisites this leaf can check, and compares every\n27|// bound plan fact in a fixed order. A changed mapping, alias,\n28|// allowlist, transport, source index, record, authority head, lease,\n29|// action, destination, or expectation invalidates the plan with\n30|// selector_plan_stale naming the first diverged member; explicit\n31|// authorization revocation returns peer_not_allowlisted; failed reads\n32|// retain their read-failure classification. Revalidation never\n33|// re-resolves by name, substitutes a same-named session, silently\n34|// replans, transfers a lease, or reuses confirmation for new facts.\n35|//\n36|// Effect authorization beyond read projection — fencing, commit,\n37|// retry, recovery, remote dispatch/admission, and transport-resume\n38|// prerequisites, and the composed per-endpoint invocation bindings —\n39|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n40|// every boundary in BoundariesFor for their action. A plan built here\n41|// authorizes read projection only.\n42|package sessquery\n43|\n44|import (\n45|\t\"fmt\"\n46|\n47|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n48|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n49|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n50|)\n51|\n52|// SelectorVersion is the exact selector contract version every plan binds.\n53|const SelectorVersion = \"1.0.0\"\n54|\n55|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n56|// an existing command/action tag; binding one selects it, never an\n57|// umbrella bypass.\n58|const (\n59|\tActionStatus      = \"status\"\n60|\tActionAttach      = \"attach\"\n61|\tActionTakeover    = \"takeover\"\n62|\tActionFork        = \"fork\"\n63|\tActionStop        = \"stop\"\n64|\tActionResume      = \"resume\"\n65|\tActionSync        = \"sync\"\n66|\tActionDiff        = \"diff\"\n67|\tActionMaterialize = \"materialize\"\n68|\tActionSetProfile  = \"session.set-profile\"\n69|\tActionLogs        = \"logs\"\n70|\tActionCancel      = \"cancel\"\n71|)\n72|\n73|// Plan boundaries from the normative action/boundary matrix. A boundary\n74|// is reached only when the existing operation reaches that phase; these\n75|// rows introduce no new effects.\n76|const (\n77|\tBoundaryProjection      = \"projection\"\n78|\tBoundaryPreEffect       = \"pre-effect\"\n79|\tBoundaryFencing         = \"fencing\"\n80|\tBoundaryCommit          = \"commit\"\n81|\tBoundaryRetry           = \"retry\"\n82|\tBoundaryRecovery        = \"recovery\"\n83|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n84|\tBoundaryRemoteAdmission = \"remote-admission\"\n85|\tBoundaryTransportResume = \"transport-resume\"\n86|)\n87|\n88|// planBoundaries is the closed action/boundary matrix: every action has\n89|// exactly its normative row, and an unknown action has none.\n90|var planBoundaries = map[string][]string{\n91|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n92|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n93|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n94|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n95|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n96|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n97|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n98|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n99|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n100|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n101|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n102|\tActionCancel:      {BoundaryProjection},\n103|}\n104|\n105|// BoundariesFor returns the required boundary classes for a plan\n106|// action. The boolean reports whether the action is a known tag; an\n107|// unknown action binds no boundary and builds no plan.\n108|func BoundariesFor(action string) ([]string, bool) {\n109|\tboundaries, ok := planBoundaries[action]\n110|\tif !ok {\n111|\t\treturn nil, false\n112|\t}\n113|\treturn append([]string(nil), boundaries...), true\n114|}\n115|\n116|// SelectionPlan is the machine-local immutable binding of one selector\n117|// resolution. All members are values, never references: there is no\n118|// mutator, and Marshal carries the locally verified canonical digest\n119|// so a persisted plan is tamper-evident. Caller-supplied digest\n120|// equality alone is never evidence of authority; only Revalidate\n121|// against current facts decides currency.\n122|type SelectionPlan struct {\n123|\t// SelectorVersion is exactly SelectorVersion.\n124|\tSelectorVersion string\n125|\t// Selector is the original single argument, at most\n126|\t// MaxSelectorRunes characters.\n127|\tSelector string\n128|\t// SessionID is the selected UUIDv7, never resolved again by name.\n129|\tSessionID string\n130|\t// SessionRecordID is the validated immutable Session Record digest.\n131|\tSessionRecordID string\n132|\t// SourceHostID is the UUIDv7 of the selected source, or empty\n133|\t// while the local host identity stays unknown.\n134|\tSourceHostID string\n135|\t// SourceAlias is the exact configured alias, or nil for local. It\n136|\t// is a diagnostic label, never identity.\n137|\tSourceAlias *string\n138|\t// SourceIndexDigest is the digest of the complete validated index\n139|\t// read used for selection.\n140|\tSourceIndexDigest string\n141|\t// ConfigurationDigest is the digest of the effective validated\n142|\t// configuration, including peer mapping, allowlist, and transport.\n143|\tConfigurationDigest string\n144|\t// LeaseEpoch, LeaseID, and OwnerHostID come from the validated\n145|\t// winning envelope lease: positive uint53, UUIDv4, and UUIDv7. All\n146|\t// three stay empty together while no winning lease is observed;\n147|\t// unknown is unknown, never a placeholder.\n148|\tLeaseEpoch  uint64\n149|\tLeaseID     string\n150|\tOwnerHostID string\n151|\t// AuthorityHeads is the sorted unique digest array of the\n152|\t// validated event heads used for the decision: the tail event\n153|\t// digest of the selected validated chain.\n154|\tAuthorityHeads []string\n155|\t// Action is the explicit command/action tag bound at build time.\n156|\tAction string\n157|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n158|\t// when the action takes no destination.\n159|\tDestinationHostID *string\n160|\t// ExpectationDigest binds the caller-declared action expectations\n161|\t// (canonically encoded JSON) for change detection. It does not\n162|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n163|\t// or confirmation contracts, which have no owners in this leaf.\n164|\tExpectationDigest string\n165|}\n166|\n167|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n168|// selector, the explicit action tag, the explicit destination (empty\n169|// for none), and the opaque caller expectations (nil for none).\n170|type PlanArgs struct {\n171|\tSelector     string\n172|\tAction       string\n173|\tDestination  string\n174|\tExpectations []byte\n175|}\n176|\n177|// BuildPlan resolves the selector once through the shared path and\n178|// binds the current facts into an immutable plan. The destination is\n179|// independently validated as a UUIDv7; expectations must be canonically\n180|// encodable JSON and bind by digest for change detection only.\n181|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n182|\tparsed, err := ParseSelector(args.Selector)\n183|\tif err != nil {\n184|\t\treturn SelectionPlan{}, err\n185|\t}\n186|\tif reader == nil || reader.Local == nil {\n187|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n188|\t}\n189|\tconfig, err := reader.validatedConfiguration()\n190|\tif err != nil {\n191|\t\treturn SelectionPlan{}, err\n192|\t}\n193|\tif _, ok := BoundariesFor(args.Action); !ok {\n194|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n195|\t}\n196|\tvar destination *string\n197|\tif args.Destination != \"\" {\n198|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n199|\t\tif err != nil {\n200|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n201|\t\t}\n202|\t\tvalue := id.String()\n203|\t\tdestination = &value\n204|\t}\n205|\texpectations, err := fingerprintExpectations(args.Expectations)\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tvar selected Selection\n210|\tif parsed.Source != SourceBare {\n211|\t\tselected, err = reader.resolveExplicit(parsed, config)\n212|\t} else {\n213|\t\tselected, err = reader.resolveBare(parsed, config)\n214|\t}\n215|\tif err != nil {\n216|\t\treturn SelectionPlan{}, err\n217|\t}\n218|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n219|}\n220|\n221|// bindPlan reads the winning source completely and binds every plan\n222|// member from validated current facts. The session is located by its\n223|// UUID in the winning source only, never re-resolved by name.\n224|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n225|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n226|\tif err != nil {\n227|\t\treturn SelectionPlan{}, err\n228|\t}\n229|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n230|\tif err != nil {\n231|\t\treturn SelectionPlan{}, err\n232|\t}\n233|\tconfiguration, err := fingerprintConfiguration(reader, config)\n234|\tif err != nil {\n235|\t\treturn SelectionPlan{}, err\n236|\t}\n237|\tvar recordID string\n238|\tfound := false\n239|\tfor _, row := range rows {\n240|\t\tif row.Projection.SessionID == selected.SessionID {\n241|\t\t\trecordID, found = row.Projection.RecordID, true\n242|\t\t\tbreak\n243|\t\t}\n244|\t}\n245|\tif !found {\n246|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n247|\t}\n248|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\ttail, err := chainTail(selected.repo, selected.SessionID)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tplan := SelectionPlan{\n257|\t\tSelectorVersion:     SelectorVersion,\n258|\t\tSelector:            parsed.Raw,\n259|\t\tSessionID:           selected.SessionID,\n260|\t\tSessionRecordID:     recordID,\n261|\t\tSourceIndexDigest:   index,\n262|\t\tConfigurationDigest: configuration,\n263|\t\tLeaseEpoch:          projection.Winner.Epoch,\n264|\t\tLeaseID:             projection.Winner.LeaseID,\n265|\t\tOwnerHostID:         projection.OwnerHostID,\n266|\t\tAction:              action,\n267|\t\tDestinationHostID:   destination,\n268|\t\tExpectationDigest:   expectations,\n269|\t}\n270|\tif selected.PeerHostID == \"\" {\n271|\t\tif config.localHost != \"\" {\n272|\t\t\tplan.SourceHostID = config.localHost\n273|\t\t}\n274|\t} else {\n275|\t\tplan.SourceHostID = selected.PeerHostID\n276|\t\t// Null marks the local source only. An alias-less peer binds\n277|\t\t// empty: the host still distinguishes it from local.\n278|\t\talias := config.aliasFor(selected.PeerHostID)\n279|\t\taliasCopy := alias\n280|\t\tplan.SourceAlias = &aliasCopy\n281|\t}\n282|\tif tail != \"\" {\n283|\t\tplan.AuthorityHeads = []string{tail}\n284|\t} else {\n285|\t\tplan.AuthorityHeads = []string{}\n286|\t}\n287|\tif err := checkPlanShapes(plan); err != nil {\n288|\t\treturn SelectionPlan{}, err\n289|\t}\n290|\treturn plan, nil\n291|}\n292|\n293|// chainTail returns the tail event digest of a validated session chain,\n294|// or empty when the chain carries no events yet.\n295|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n296|\tevents, err := repo.ListEvents(sessionID)\n297|\tif err != nil {\n298|\t\treturn \"\", err\n299|\t}\n300|\tif len(events) == 0 {\n301|\t\treturn \"\", nil\n302|\t}\n303|\treturn events[len(events)-1].EventID, nil\n304|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c549","stream":{"kind":"session","id":"01a0882f-8c55-77c0-a926-2dcd5f0e317e"},"sequence":255,"recorded_at":1780531400000505,"record_type":"event","durability":"durable","causation_id":"b1162590-3555-4533-a62e-f38ed0b51836","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b1162590-3555-4533-a62e-f38ed0b51836","run_stream":{"kind":"run","id":"b1162590-3555-4533-a62e-f38ed0b51836"},"call_id":"call_01a08830171f71a0a0ef439b10f8b574","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation and\n6|// failures): caller shapes, current configuration validation,\n7|// authorization revocation, source binding, configuration digest,\n8|// source read, selection absence, current projection, session record,\n9|// winning lease, authority heads, and finally the source index digest.\n10|// Fine-grained reasons distinguish the checks without splitting the\n11|// class; tests assert both.\n12|package sessquery\n13|\n14|import (\n15|\t\"encoding/json\"\n16|\t\"fmt\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n20|)\n21|\n22|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n23|const uint53Ceiling = uint64(1<<53 - 1)\n24|\n25|// Revalidate compares every bound plan fact against current\n26|// configuration and freshly reread source data. The session is located\n27|// by its UUID in the plan's source only, never re-resolved by name. A\n28|// nil return means the plan is current; any error classifies exactly:\n29|// selector_plan_stale (with the first diverged member named),\n30|// peer_not_allowlisted on explicit authorization revocation,\n31|// invalid_config on current configuration failures, invalid_arguments\n32|// on a malformed caller plan, and the read or projection failure class\n33|// when a required read or validation fails.\n34|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n35|\tif err := checkPlanShapes(plan); err != nil {\n36|\t\treturn err\n37|\t}\n38|\tif reader == nil || reader.Local == nil {\n39|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n40|\t}\n41|\tconfig, err := reader.validatedConfiguration()\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tpeerHost, isPeer := planSourceBinding(plan, config)\n46|\tif isPeer {\n47|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n48|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n49|\t\t}\n50|\t}\n51|\tif !bindingHolds(plan, config, reader) {\n52|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n53|\t}\n54|\tconfiguration, err := fingerprintConfiguration(reader, config)\n55|\tif err != nil {\n56|\t\treturn err\n57|\t}\n58|\tif configuration != plan.ConfigurationDigest {\n59|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n60|\t}\n61|\tvar repo = reader.Local\n62|\tsourcePeer := \"\"\n63|\tif isPeer {\n64|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n65|\t\tif err != nil {\n66|\t\t\treturn err\n67|\t\t}\n68|\t}\n69|\trows, err := reader.readSource(repo, sourcePeer)\n70|\tif err != nil {\n71|\t\treturn err\n72|\t}\n73|\tvar recordID string\n74|\tabsent := true\n75|\tfor _, row := range rows {\n76|\t\tif row.Projection.SessionID == plan.SessionID {\n77|\t\t\trecordID, absent = row.Projection.RecordID, false\n78|\t\t\tbreak\n79|\t\t}\n80|\t}\n81|\tif absent {\n82|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n83|\t}\n84|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n85|\tif err != nil {\n86|\t\treturn err\n87|\t}\n88|\tif recordID != plan.SessionRecordID {\n89|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n90|\t}\n91|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\n92|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n93|\t}\n94|\ttail, err := chainTail(repo, plan.SessionID)\n95|\tif err != nil {\n96|\t\tif sourcePeer == \"\" {\n97|\t\t\treturn err\n98|\t\t}\n99|\t\treturn peerReadFailed(sourcePeer, err)\n100|\t}\n101|\theads := []string{}\n102|\tif tail != \"\" {\n103|\t\theads = []string{tail}\n104|\t}\n105|\tif !equalStrings(heads, plan.AuthorityHeads) {\n106|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n107|\t}\n108|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n109|\tif err != nil {\n110|\t\treturn err\n111|\t}\n112|\tif index != plan.SourceIndexDigest {\n113|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n114|\t}\n115|\treturn nil\n116|}\n117|\n118|// planSourceBinding resolves the plan's bound source: a local plan\n119|// carries a null alias with an empty or local host, while any other\n120|// binding selects a peer source by host. The second return reports\n121|// whether the plan selects a peer source.\n122|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n123|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n124|\t\treturn \"\", false\n125|\t}\n126|\treturn plan.SourceHostID, true\n127|}\n128|\n129|// bindingHolds reports whether the plan's bound (host, alias) source\n130|// still resolves to the same source in the current configuration. A\n131|// local plan holds while its host is empty or the current local host;\n132|// a peer plan holds while its host is still a known peer carrying the\n133|// exact bound alias.\n134|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n135|\tif plan.SourceAlias == nil {\n136|\t\tif plan.SourceHostID == \"\" {\n137|\t\t\treturn true\n138|\t\t}\n139|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n140|\t\t\treturn true\n141|\t\t}\n142|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n143|\t\t\treturn true\n144|\t\t}\n145|\t\treturn false\n146|\t}\n147|\tif !knownPeer(reader, plan.SourceHostID) {\n148|\t\treturn false\n149|\t}\n150|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n151|}\n152|\n153|// equalStrings compares sorted unique string slices element-wise.\n154|func equalStrings(first, second []string) bool {\n155|\tif len(first) != len(second) {\n156|\t\treturn false\n157|\t}\n158|\tfor index := range first {\n159|\t\tif first[index] != second[index] {\n160|\t\t\treturn false\n161|\t\t}\n162|\t}\n163|\treturn true\n164|}\n165|\n166|// checkPlanShapes validates the caller-supplied plan members without\n167|// consulting any authority: exact contract version, grammatical\n168|// selector, canonical UUIDs and digests, exact alias bound, sorted\n169|// unique authority heads, a consistent lease triple (all empty while\n170|// no winning lease is observed, otherwise positive uint53 epoch with a\n171|// UUIDv4 lease and a UUIDv7 owner), a known action tag, and a null or\n172|// UUIDv7 destination. Authority comes only from Revalidate.\n173|func checkPlanShapes(plan SelectionPlan) error {\n174|\tif plan.SelectorVersion != SelectorVersion {\n175|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n176|\t}\n177|\tif _, err := ParseSelector(plan.Selector); err != nil {\n178|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n179|\t}\n180|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n181|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n182|\t}\n183|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n184|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n185|\t}\n186|\tif plan.SourceHostID != \"\" {\n187|\t\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n188|\t\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n189|\t\t}\n190|\t}\n191|\tif plan.SourceAlias != nil {\n192|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n193|\t\t\t// An alias-less peer binds empty, which never passes the\n194|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n195|\t\t\tif *plan.SourceAlias != \"\" {\n196|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n197|\t\t\t}\n198|\t\t}\n199|\t}\n200|\tfor _, member := range []struct {\n201|\t\tname   string\n202|\t\tdigest string\n203|\t}{\n204|\t\t{\"source index\", plan.SourceIndexDigest},\n205|\t\t{\"configuration\", plan.ConfigurationDigest},\n206|\t\t{\"expectation\", plan.ExpectationDigest},\n207|\t} {\n208|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n209|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n210|\t\t}\n211|\t}\n212|\t// The lease triple is all empty while no winning lease is observed;\n213|\t// otherwise the epoch is a positive uint53 with a UUIDv4 lease and a\n214|\t// UUIDv7 owner. Partial triples and placeholders are refused.\n215|\tswitch {\n216|\tcase plan.LeaseEpoch == 0 && plan.LeaseID == \"\" && plan.OwnerHostID == \"\":\n217|\tcase plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling:\n218|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n219|\tdefault:\n220|\t\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n221|\t\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n222|\t\t}\n223|\t\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n225|\t\t}\n226|\t}\n227|\tfor index, head := range plan.AuthorityHeads {\n228|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n229|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n230|\t\t}\n231|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n232|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n233|\t\t}\n234|\t}\n235|\tif _, ok := BoundariesFor(plan.Action); !ok {\n236|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n237|\t}\n238|\tif plan.DestinationHostID != nil {\n239|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n240|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n241|\t\t}\n242|\t}\n243|\treturn nil\n244|}\n245|\n246|// planWire is the tamper-evident persistence encoding: every bound\n247|// member plus the locally verified canonical digest over all of them.\n248|type planWire struct {\n249|\tSelectorVersion     string   `json:\"selector_version\"`\n250|\tSelector            string   `json:\"selector\"`\n251|\tSessionID           string   `json:\"session_id\"`\n252|\tSessionRecordID     string   `json:\"session_record_id\"`\n253|\tSourceHostID        string   `json:\"source_host_id\"`\n254|\tSourceAlias         *string  `json:\"source_alias\"`\n255|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n256|\tConfigurationDigest string   `json:\"configuration_digest\"`\n257|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n258|\tLeaseID             string   `json:\"lease_id\"`\n259|\tOwnerHostID         string   `json:\"owner_host_id\"`\n260|\tAuthorityHeads      []string `json:\"authority_heads\"`\n261|\tAction              string   `json:\"action\"`\n262|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n263|\tExpectationDigest   string   `json:\"expectation_digest\"`\n264|\tPlanDigest          string   `json:\"plan_digest\"`\n265|}\n266|\n267|// Digest returns the locally verified canonical digest over all bound\n268|// plan members. It is recomputed on every call and never trusted from\n269|// caller bytes.\n270|func (plan SelectionPlan) Digest() (string, error) {\n271|\theads := append([]string(nil), plan.AuthorityHeads...)\n272|\tif heads == nil {\n273|\t\theads = []string{}\n274|\t}\n275|\treturn fingerprint(map[string]any{\n276|\t\t\"action\":               plan.Action,\n277|\t\t\"authority_heads\":      heads,\n278|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n279|\t\t\"destination_host_id\":  plan.DestinationHostID,\n280|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n281|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n282|\t\t\"lease_id\":             plan.LeaseID,\n283|\t\t\"owner_host_id\":        plan.OwnerHostID,\n284|\t\t\"selector\":             plan.Selector,\n285|\t\t\"selector_version\":     plan.SelectorVersion,\n286|\t\t\"session_id\":           plan.SessionID,\n287|\t\t\"session_record_id\":    plan.SessionRecordID,\n288|\t\t\"source_alias\":         plan.SourceAlias,\n289|\t\t\"source_host_id\":       plan.SourceHostID,\n290|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n291|\t})\n292|}\n293|\n294|// Marshal encodes the plan with its locally verified digest. The\n295|// encoding keeps null alias and destination distinct from empty.\n296|func (plan SelectionPlan) Marshal() ([]byte, error) {\n297|\tdigest, err := plan.Digest()\n298|\tif err != nil {\n299|\t\treturn nil, err\n300|\t}\n301|\theads := append([]string(nil), plan.AuthorityHeads...)\n302|\tif heads == nil {\n303|\t\theads = []string{}\n304|\t}\n305|\treturn json.Marshal(planWire{\n306|\t\tSelectorVersion:     plan.SelectorVersion,\n307|\t\tSelector:            plan.Selector,\n308|\t\tSessionID:           plan.SessionID,\n309|\t\tSessionRecordID:     plan.SessionRecordID,\n310|\t\tSourceHostID:        plan.SourceHostID,\n311|\t\tSourceAlias:         plan.SourceAlias,\n312|\t\tSourceIndexDigest:   plan.SourceIndexDigest,\n313|\t\tConfigurationDigest: plan.ConfigurationDigest,\n314|\t\tLeaseEpoch:          plan.LeaseEpoch,\n315|\t\tLeaseID:             plan.LeaseID,\n316|\t\tOwnerHostID:         plan.OwnerHostID,\n317|\t\tAuthorityHeads:      heads,\n318|\t\tAction:              plan.Action,\n319|\t\tDestinationHostID:   plan.DestinationHostID,\n320|\t\tExpectationDigest:   plan.ExpectationDigest,\n321|\t\tPlanDigest:          digest,\n322|\t})\n323|}\n324|\n325|// ParsePlan decodes a persisted plan, validates every member shape,\n326|// and verifies the tamper-evident digest. A verified encoding is still\n327|// not authority: only Revalidate against current facts decides\n328|// currency, and digest equality alone never substitutes for it.\n329|func ParsePlan(raw []byte) (SelectionPlan, error) {\n330|\tvar wire planWire\n331|\tif err := json.Unmarshal(raw, &wire); err != nil {\n332|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed plan encoding: %v\", ErrInvalidArgument, err)\n333|\t}\n334|\tplan := SelectionPlan{\n335|\t\tSelectorVersion:     wire.SelectorVersion,\n336|\t\tSelector:            wire.Selector,\n337|\t\tSessionID:           wire.SessionID,\n338|\t\tSessionRecordID:     wire.SessionRecordID,\n339|\t\tSourceHostID:        wire.SourceHostID,\n340|\t\tSourceAlias:         wire.SourceAlias,\n341|\t\tSourceIndexDigest:   wire.SourceIndexDigest,\n342|\t\tConfigurationDigest: wire.ConfigurationDigest,\n343|\t\tLeaseEpoch:          wire.LeaseEpoch,\n344|\t\tLeaseID:             wire.LeaseID,\n345|\t\tOwnerHostID:         wire.OwnerHostID,\n346|\t\tAuthorityHeads:      wire.AuthorityHeads,\n347|\t\tAction:              wire.Action,\n348|\t\tDestinationHostID:   wire.DestinationHostID,\n349|\t\tExpectationDigest:   wire.ExpectationDigest,\n350|\t}\n351|\tif plan.AuthorityHeads == nil {\n352|\t\tplan.AuthorityHeads = []string{}\n353|\t}\n354|\tif err := checkPlanShapes(plan); err != nil {\n355|\t\treturn SelectionPlan{}, err\n356|\t}\n357|\tdigest, err := plan.Digest()\n358|\tif err != nil {\n359|\t\treturn SelectionPlan{}, err\n360|\t}\n361|\tif digest != wire.PlanDigest {\n362|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: plan digest mismatch\", ErrInvalidArgument)\n363|\t}\n364|\treturn plan, nil\n365|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
