\n221|\t\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n222|\t\t}\n223|\t\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n225|\t\t}\n226|\t}\n227|\tfor index, head := range plan.AuthorityHeads {\n228|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n229|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n230|\t\t}\n231|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n232|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n233|\t\t}\n234|\t}\n235|\tif _, ok := BoundariesFor(plan.Action); !ok {\n236|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n237|\t}\n238|\tif plan.DestinationHostID != nil {\n239|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n240|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n241|\t\t}\n242|\t}\n243|\treturn nil\n244|}\n245|\n246|// planWire is the tamper-evident persistence encoding: every bound\n247|// member plus the locally verified canonical digest over all of them.\n248|type planWire struct {\n249|\tSelectorVersion     string   `json:\"selector_version\"`\n250|\tSelector            string   `json:\"selector\"`\n251|\tSessionID           string   `json:\"session_id\"`\n252|\tSessionRecordID     string   `json:\"session_record_id\"`\n253|\tSourceHostID        string   `json:\"source_host_id\"`\n254|\tSourceAlias         *string  `json:\"source_alias\"`\n255|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n256|\tConfigurationDigest string   `json:\"configuration_digest\"`\n257|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n258|\tLeaseID             string   `json:\"lease_id\"`\n259|\tOwnerHostID         string   `json:\"owner_host_id\"`\n260|\tAuthorityHeads      []string `json:\"authority_heads\"`\n261|\tAction              string   `json:\"action\"`\n262|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n263|\tExpectationDigest   string   `json:\"expectation_digest\"`\n264|\tPlanDigest          string   `json:\"plan_digest\"`\n265|}\n266|\n267|// Digest returns the locally verified canonical digest over all bound\n268|// plan members. It is recomputed on every call and never trusted from\n269|// caller bytes.\n270|func (plan SelectionPlan) Digest() (string, error) {\n271|\theads := append([]string(nil), plan.AuthorityHeads...)\n272|\tif heads == nil {\n273|\t\theads = []string{}\n274|\t}\n275|\treturn fingerprint(map[string]any{\n276|\t\t\"action\":               plan.Action,\n277|\t\t\"authority_heads\":      heads,\n278|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n279|\t\t\"destination_host_id\":  plan.DestinationHostID,\n280|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n281|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n282|\t\t\"lease_id\":             plan.LeaseID,\n283|\t\t\"owner_host_id\":        plan.OwnerHostID,\n284|\t\t\"selector\":             plan.Selector,\n285|\t\t\"selector_version\":     plan.SelectorVersion,\n286|\t\t\"session_id\":           plan.SessionID,\n287|\t\t\"session_record_id\":    plan.SessionRecordID,\n288|\t\t\"source_alias\":         plan.SourceAlias,\n289|\t\t\"source_host_id\":       plan.SourceHostID,\n290|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n291|\t})\n292|}\n293|\n294|// Marshal encodes the plan with its locally verified digest. The\n295|// encoding keeps null alias and destination distinct from empty.\n296|func (plan SelectionPlan) Marshal() ([]byte, error) {\n297|\tdigest, err := plan.Digest()\n298|\tif err != nil {\n299|\t\treturn nil, err\n300|\t}\n301|\theads := append([]string(nil), plan.AuthorityHeads...)\n302|\tif heads == nil {\n303|\t\theads = []string{}\n304|\t}\n305|\treturn json.Marshal(planWire{\n306|\t\tSelectorVersion:     plan.SelectorVersion,\n307|\t\tSelector:            plan.Selector,\n308|\t\tSessionID:           plan.SessionID,\n309|\t\tSessionRecordID:     plan.SessionRecordID,\n310|\t\tSourceHostID:        plan.SourceHostID,\n311|\t\tSourceAlias:         plan.SourceAlias,\n312|\t\tSourceIndexDigest:   plan.SourceIndexDigest,\n313|\t\tConfigurationDigest: plan.ConfigurationDigest,\n314|\t\tLeaseEpoch:          plan.LeaseEpoch,\n315|\t\tLeaseID:             plan.LeaseID,\n316|\t\tOwnerHostID:         plan.OwnerHostID,\n317|\t\tAuthorityHeads:      heads,\n318|\t\tAction:              plan.Action,\n319|\t\tDestinationHostID:   plan.DestinationHostID,\n320|\t\tExpectationDigest:   plan.ExpectationDigest,\n321|\t\tPlanDigest:          digest,\n322|\t})\n323|}\n324|\n325|// ParsePlan decodes a persisted plan, validates every member shape,\n326|// and verifies the tamper-evident digest. A verified encoding is still\n327|// not authority: only Revalidate against current facts decides\n328|// currency, and digest equality alone never substitutes for it.\n329|func ParsePlan(raw []byte) (SelectionPlan, error) {\n330|\tvar wire planWire\n331|\tif err := json.Unmarshal(raw, &wire); err != nil {\n332|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed plan encoding: %v\", ErrInvalidArgument, err)\n333|\t}\n334|\tplan := SelectionPlan{\n335|\t\tSelectorVersion:     wire.SelectorVersion,\n336|\t\tSelector:            wire.Selector,\n337|\t\tSessionID:           wire.SessionID,\n338|\t\tSessionRecordID:     wire.SessionRecordID,\n339|\t\tSourceHostID:        wire.SourceHostID,\n340|\t\tSourceAlias:         wire.SourceAlias,\n341|\t\tSourceIndexDigest:   wire.SourceIndexDigest,\n342|\t\tConfigurationDigest: wire.ConfigurationDigest,\n343|\t\tLeaseEpoch:          wire.LeaseEpoch,\n344|\t\tLeaseID:             wire.LeaseID,\n345|\t\tOwnerHostID:         wire.OwnerHostID,\n346|\t\tAuthorityHeads:      wire.AuthorityHeads,\n347|\t\tAction:              wire.Action,\n348|\t\tDestinationHostID:   wire.DestinationHostID,\n349|\t\tExpectationDigest:   wire.ExpectationDigest,\n350|\t}\n351|\tif plan.AuthorityHeads == nil {\n352|\t\tplan.AuthorityHeads = []string{}\n353|\t}\n354|\tif err := checkPlanShapes(plan); err != nil {\n355|\t\treturn SelectionPlan{}, err\n356|\t}\n357|\tdigest, err := plan.Digest()\n358|\tif err != nil {\n359|\t\treturn SelectionPlan{}, err\n360|\t}\n361|\tif digest != wire.PlanDigest {\n362|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: plan digest mismatch\", ErrInvalidArgument)\n363|\t}\n364|\treturn plan, nil\n365|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a087ac-8190-7860-a965-76aada06b809"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"9c1f678b-1069-494d-85eb-0c4fd7d0aad7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9c1f678b-1069-494d-85eb-0c4fd7d0aad7","run_stream":{"kind":"run","id":"9c1f678b-1069-494d-85eb-0c4fd7d0aad7"},"call_id":"call_01a087ae0fcb7bc0847d2663b7ea1e32","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/digest.go`.\n1|// Local attestation digests for selector plans: canonical fingerprints\n2|// over validated reads, never over caller claims.\n3|//\n4|// fingerprint canonicalizes its input through the canonical-JSON owner\n5|// and digests the canonical bytes, so equal facts always produce equal\n6|// digests and any fact change invalidates the plans bound to them. The\n7|// resulting \"sha256:\" digests are self-checked through the scalar\n8|// digest grammar before use.\n9|package sessquery\n10|\n11|import (\n12|\t\"crypto/sha256\"\n13|\t\"encoding/hex\"\n14|\t\"encoding/json\"\n15|\t\"fmt\"\n16|\t\"sort\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n21|)\n22|\n23|// transportLabel names the index-read mechanism this stack uses: direct\n24|// local repository reads with no mesh transport. Binding the label into\n25|// the configuration digest invalidates every plan if a transport is\n26|// ever introduced, instead of silently reusing facts read another way.\n27|const transportLabel = \"local-direct\"\n28|\n29|// fingerprint canonicalizes value and returns the \"sha256:\" digest of\n30|// the canonical bytes.\n31|func fingerprint(value any) (string, error) {\n32|\traw, err := json.Marshal(value)\n33|\tif err != nil {\n34|\t\treturn \"\", err\n35|\t}\n36|\tcanonical, err := canonicaljson.Canonicalize(raw)\n37|\tif err != nil {\n38|\t\treturn \"\", err\n39|\t}\n40|\tsum := sha256.Sum256(canonical)\n41|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n42|\tif _, err := scalar.ParseDigest(digest); err != nil {\n43|\t\treturn \"\", err\n44|\t}\n45|\treturn digest, nil\n46|}\n47|\n48|// peerFingerprint is one configured peer mapping in the configuration\n49|// digest: exact alias with its host, in bytewise host order.\n50|type peerFingerprint struct {\n51|\tAlias  string `json:\"alias\"`\n52|\tHostID string `json:\"host_id\"`\n53|}\n54|\n55|// fingerprintConfiguration digests the effective validated\n56|// configuration: the local host, the peer mapping, the allowlist, and\n57|// the transport label. Handles are not configuration and stay out:\n58|// swapping a learned index without changing the mapping still changes\n59|// the index digest at read time.\n60|func fingerprintConfiguration(reader *Reader, config validatedConfig) (string, error) {\n61|\tpeers := make([]peerFingerprint, 0, len(reader.Peers))\n62|\tfor _, host := range config.sortedPeerHosts(reader) {\n63|\t\tpeers = append(peers, peerFingerprint{Alias: config.aliasFor(host), HostID: host})\n64|\t}\n65|\tallowlist := make([]string, 0, len(config.allowed))\n66|\tfor id := range config.allowed {\n67|\t\tallowlist = append(allowlist, id)\n68|\t}\n69|\tsort.Strings(allowlist)\n70|\treturn fingerprint(map[string]any{\n71|\t\t\"allowlist\":     allowlist,\n72|\t\t\"local_host_id\": config.localHost,\n73|\t\t\"peers\":         peers,\n74|\t\t\"transport\":     transportLabel,\n75|\t})\n76|}\n77|\n78|// indexRowFingerprint is one validated index row in the source index\n79|// digest: identity, liveness, lifecycle, tail, and winning lease facts\n80|// for every session the complete read returned, in bytewise session\n81|// order. Any index change — a new, removed, parked, tombstoned, or\n82|// advanced session — changes this digest.\n83|type indexRowFingerprint struct {\n84|\tSessionID     string `json:\"session_id\"`\n85|\tRecordID      string `json:\"record_id\"`\n86|\tName          string `json:\"name\"`\n87|\tParked        bool   `json:\"parked\"`\n88|\tState         string `json:\"state\"`\n89|\tTailEvent     string `json:\"tail_event\"`\n90|\tWinnerEpoch   uint64 `json:\"winner_epoch\"`\n91|\tWinnerLeaseID string `json:\"winner_lease_id\"`\n92|\tOwnerHostID   string `json:\"owner_host_id\"`\n93|}\n94|\n95|// fingerprintIndex digests the complete validated index read used for\n96|// selection: every row the listing returned with its validated tail.\n97|// A tail read failure keeps its read-failure class: local errors stay\n98|// repository errors, peer errors carry the read-failure class.\n99|func fingerprintIndex(reader *Reader, repo *sessrepo.Repository, rows []Summary, peerHost string) (string, error) {\n100|\tfinger := make([]indexRowFingerprint, 0, len(rows))\n101|\tfor _, row := range rows {\n102|\t\tentry := indexRowFingerprint{\n103|\t\t\tSessionID:     row.Projection.SessionID,\n104|\t\t\tRecordID:      row.Projection.RecordID,\n105|\t\t\tName:          row.Projection.Name,\n106|\t\t\tState:         string(row.Projection.State),\n107|\t\t\tWinnerEpoch:   row.Projection.Winner.Epoch,\n108|\t\t\tWinnerLeaseID: row.Projection.Winner.LeaseID,\n109|\t\t\tOwnerHostID:   row.Projection.OwnerHostID,\n110|\t\t}\n111|\t\tif row.Projection.Parked != nil {\n112|\t\t\tentry.Parked = true\n113|\t\t} else {\n114|\t\t\ttail, err := chainTail(repo, row.Projection.SessionID)\n115|\t\t\tif err != nil {\n116|\t\t\t\tif peerHost == \"\" {\n117|\t\t\t\t\treturn \"\", err\n118|\t\t\t\t}\n119|\t\t\t\treturn \"\", peerReadFailed(peerHost, err)\n120|\t\t\t}\n121|\t\t\tentry.TailEvent = tail\n122|\t\t}\n123|\t\tfinger = append(finger, entry)\n124|\t}\n125|\treturn fingerprint(finger)\n126|}\n127|\n128|// fingerprintExpectations binds caller-declared action expectations for\n129|// change detection only. Expectations must be one canonically encoded\n130|// JSON object; the digest never replaces the checkpoint, workspace,\n131|// cohort, provider, terminal, or confirmation contracts, which have no\n132|// owners in this leaf. Empty expectations bind the empty-object digest.\n133|func fingerprintExpectations(expectations []byte) (string, error) {\n134|\tif len(expectations) == 0 {\n135|\t\treturn fingerprint(map[string]any{})\n136|\t}\n137|\tcanonical, err := canonicaljson.Canonicalize(expectations)\n138|\tif err != nil {\n139|\t\treturn \"\", fmt.Errorf(\"%w: malformed plan expectations: %v\", ErrInvalidArgument, err)\n140|\t}\n141|\tif len(canonical) == 0 || canonical[0] != '{' {\n142|\t\treturn \"\", fmt.Errorf(\"%w: plan expectations must be a JSON object\", ErrInvalidArgument)\n143|\t}\n144|\tsum := sha256.Sum256(canonical)\n145|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n146|\tif _, err := scalar.ParseDigest(digest); err != nil {\n147|\t\treturn \"\", err\n148|\t}\n149|\treturn digest, nil\n150|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
