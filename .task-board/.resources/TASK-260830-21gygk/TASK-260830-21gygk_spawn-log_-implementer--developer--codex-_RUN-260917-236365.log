+	}
+	if context == nil {
+		return false
+	}
+	if profileEntries[context.object] || rev14RawOwner(context, rawOwners, functions, buildAdmission) {
+		return true
+	}
+	return context.isClosure && rev14ContextInFunction(context, buildAdmission, functions)
