+
+func rev14SealedValueContainsSeen(typ types.Type, seal, token *types.TypeName, seen map[types.Type]bool) bool {
+	if typ == nil || seen[typ] {
+		return false
+	}
+	seen[typ] = true
+	if named, ok := typ.(*types.Named); ok {
+		if named.Obj() == seal || named.Obj() == token {
+			return true
