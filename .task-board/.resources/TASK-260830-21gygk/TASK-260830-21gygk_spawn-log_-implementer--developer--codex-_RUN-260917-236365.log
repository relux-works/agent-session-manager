+				t.Fatal(err)
+			}
 			if err := rev12CheckRecordConsumptionSource(dir); err == nil {
 				t.Fatalf("record-consumption gate admitted %s", name)
+			} else if strings.Contains(err.Error(), "type-check") {
+				t.Fatalf("%s did not reach the census: %v", name, err)
