+		if signature == nil {
+			continue
+		}
+		for index := 0; index < signature.Params().Len(); index++ {
+			parameter := signature.Params().At(index)
+			if types.Identical(parameter.Type(), want.Type()) {
+				parameters[function][parameter] = true
+			}
+		}
+	}
+	return parameters
