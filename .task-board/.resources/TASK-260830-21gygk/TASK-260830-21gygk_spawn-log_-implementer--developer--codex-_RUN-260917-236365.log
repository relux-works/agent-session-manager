+func rev14CheckpointAdmissionParameters(profileEntries map[*types.Func]bool, want *types.TypeName) map[*types.Func]map[*types.Var]bool {
+	parameters := make(map[*types.Func]map[*types.Var]bool, len(profileEntries))
