   893	
   894	func rev14CollectFunctionContexts(files []*ast.File, info *types.Info) []rev14FunctionContext {
   895		var functions []rev14FunctionContext
   896		for _, file := range files {
   897			ast.Inspect(file, func(node ast.Node) bool {
   898				switch function := node.(type) {
   899				case *ast.FuncDecl:
   900					object, _ := info.Defs[function.Name].(*types.Func)
   901					functions = append(functions, rev14FunctionContext{
   902						object: object,
   903						name:   function.Name.Name,
   904						start:  function.Pos(),
   905						end:    function.End(),
   906					})
   907				case *ast.FuncLit:
   908					functions = append(functions, rev14FunctionContext{
   909						name:      "<closure>",
   910						start:     function.Pos(),
   911						end:       function.End(),
   912						isClosure: true,
   913					})
   914				}
   915				return true
   916			})
   917		}
   918		return functions
   919	}
