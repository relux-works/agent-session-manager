{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c909","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":735,"recorded_at":1780531400001465,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc4-89be-7731-9869-5b7d1fcdd8c9"},"task_id":"01a0abc4-89be-7731-9869-5b7d1fcdd8c9","event":{"kind":"output","task_id":"01a0abc4-89be-7731-9869-5b7d1fcdd8c9","chunk":"Read text file `internal/sessquery/query.go`.\n(119 line(s) above)\n120|// predecessor lease, carrying the persistence variant the referenced\n121|// Session Record kind selects; an unresolvable, misbound, or\n122|// wrong-variant reference refuses observation_unavailable, and\n123|// malformed bytes refuse invalid_config.\n124|type Reader struct {\n125|\tLocal              *sessrepo.Repository\n126|\tLocalHostID        string\n127|\tAllowlistedPeerIDs []string\n128|\tPeers              []PeerIndex\n129|\tAliases            map[string]string\n130|\tHostMetadata       map[string]HostMetadata\n131|\tObservations       map[string]SessionObservations\n132|\tLeaseRecords       [][]byte\n133|\tCheckpointRecords  [][]byte\n134|}\n135|\n136|// Summary contains only facts derived from verified session records and events.\n137|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n138|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n139|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n140|// process liveness and sync timestamps require their respective observation\n141|// owners and are deliberately not inferred from a record or a successful read.\n142|type Summary struct {\n143|\tProjection sessstate.Projection\n144|}\n145|\n146|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n147|// visible with their blocking reason and retry; failure to enumerate the index\n148|// fails the read. No durable state is written, even for an interrupted create.\n149|// A complete read proving a record without any valid lease refuses the whole\n150|// list with selector_bootstrap_incomplete: the interrupted prefix is never\n151|// silently omitted and never returned as a public summary.\n152|func (reader *Reader) List() ([]Summary, error) {\n153|\tif reader == nil || reader.Local == nil {\n154|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n155|\t}\n156|\trows, err := reader.read(reader.Local)\n157|\tif err != nil {\n158|\t\treturn nil, err\n159|\t}\n160|\tfor _, row := range rows {\n161|\t\tif err := checkSummaryRepresentable(row); err != nil {\n162|\t\t\treturn nil, err\n163|\t\t}\n164|\t}\n165|\treturn rows, nil\n166|}\n167|\n168|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n169|\trows, err := repo.ListSessions()\n170|\tif err != nil {\n171|\t\treturn nil, err\n172|\t}\n173|\tout := make([]Summary, 0, len(rows))\n174|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n175|\tfor _, row := range rows {\n176|\t\tprojection, err := projector.Project(row.SessionID)\n177|\t\tif err != nil {\n178|\t\t\treturn nil, err\n179|\t\t}\n180|\t\tout = append(out, Summary{Projection: projection})\n181|\t}\n182|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n183|\treturn out, nil\n184|}\n185|\n186|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n187|// the same path as Resolve, then projects from the selected repository. It\n188|// never treats a failed read as not found. Parked sessions can be inspected\n189|// by ID through InspectLocal, independently of live-name routing, so\n190|// operators retain access to the recovery diagnostics.\n191|func (reader *Reader) Status(selector string) (Summary, error) {\n192|\tselected, err := reader.Resolve(selector)\n193|\tif err != nil {\n194|\t\treturn Summary{}, err\n195|\t}\n196|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n197|\tif err != nil {\n198|\t\treturn Summary{}, err\n199|\t}\n(more lines below)","final_result":true}}}
