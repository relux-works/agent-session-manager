{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d5f3","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":2388,"recorded_at":1780531400004771,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abd0-aea3-7ce0-8208-8754685deeb2"},"task_id":"01a0abd0-aea3-7ce0-8208-8754685deeb2","event":{"kind":"output","task_id":"01a0abd0-aea3-7ce0-8208-8754685deeb2","chunk":"{\n  \"chunk_id\": \"exec-53-1\",\n  \"command\": \"cat > /tmp/check_rev11_mutants.py <<'PY'\\nimport pathlib, shutil, subprocess, sys\\nroot = pathlib.Path.cwd()\\nplants = [\\n  ('N-referenced-creator',\\n   '\\\\tif ref.CreatorHostID != owner.HolderHostID {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\\\", ErrObservationUnavailable, checkpointID, ref.CreatorHostID, owner.HolderHostID)\\\\n\\\\t}\\\\n',\\n   '\\\\tif ref.CreatorHostID != owner.HolderHostID && ref.CreatorHostID != \\\"0198f4c8-4a10-7b22-8b3c-1234567890ac\\\" {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\\\", ErrObservationUnavailable, checkpointID, ref.CreatorHostID, owner.HolderHostID)\\\\n\\\\t}\\\\n'),\\n  ('N-referenced-variant',\\n   '\\\\tif err := checkCheckpointPersistence(ref, sessionID, sessionKind); err != nil {\\\\n\\\\t\\\\treturn err\\\\n\\\\t}\\\\n',\\n   '\\\\tif err := checkCheckpointPersistence(ref, sessionID, sessionKind); err != nil && sessionID != \\\"0198f4c8-3e70-7a11-8a2b-1234567890ab\\\" {\\\\n\\\\t\\\\treturn err\\\\n\\\\t}\\\\n'),\\n  ('N-referenced-lease',\\n   '\\\\tif !found {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is bound to lease %s at epoch %d without an admitted owning lease\\\", ErrObservationUnavailable, checkpointID, ref.LeaseID, ref.LeaseEpoch)\\\\n\\\\t}\\\\n',\\n   '\\\\tif !found && ref.LeaseID != \\\"dddddddd-eeee-4fff-8000-222222222222\\\" {\\\\n\\\\t\\\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is bound to lease %s at epoch %d without an admitted owning lease\\\", ErrObservationUnavailable, checkpointID, ref.LeaseID, ref.LeaseEpoch)\\\\n\\\\t}\\\\n'),\\n]\\nfor name, old, new in plants:\\n    dest = pathlib.Path(f\\\"/tmp/mutcheck_{name}\\\")\\n    if dest.exists():\\n        shutil.rmtree(dest)\\n    shutil.copytree(root / \\\"internal\\\", dest / \\\"internal\\\")\\n    for f in (\\\"go.mod\\\",\\\"go.sum\\\"):\\n        shutil.copy2(root / f, dest / f)\\n    p = dest / \\\"internal/sessquery/lease.go\\\"\\n    txt = p.read_text()\\n    assert txt.count(old)==1, (name, txt.count(old))\\n    p.write_text(txt.replace(old,new))\\n    # Run census (should PASS) + behavioral (should FAIL)\\n    cmd_census = [\\\"go\\\",\\\"test\\\",\\\"./internal/sessquery\\\",\\\"-count=1\\\",\\\"-run\\\",\\\"^TestRev11RecordConsumptionCensus$\\\",\\\"-v\\\"]\\n    r1 = subprocess.run(cmd_census, cwd=dest, capture_output=True, text=True, timeout=120)\\n    cmd_behav = [\\\"go\\\",\\\"test\\\",\\\"./internal/sessquery\\\",\\\"-count=1\\\",\\\"-run\\\",\\\"TestReview10ReferencedCheckpointAdmission|TestRev11ReferencedCheckpointAdmissionRefusalClass\\\",\\\"-v\\\"]\\n    r2 = subprocess.run(cmd_behav, cwd=dest, capture_output=True, text=True, timeout=300)\\n    print(f\\\"{name}: census_exit={r1.returncode} behav_exit={r2.returncode}\\\")\\n    # Show census result line and first FAIL lines\\n    for line in (r1.stdout+r1.stderr).splitlines():\\n        if \\\"PASS:\\\" in line or \\\"FAIL:\\\" in line or \\\"ok \\\" in line or \\\"FAIL\\\" in line:\\n            print(\\\"  census:\\\",line)\\n            break\\n    fails=[l for l in (r2.stdout+r2.stderr).splitlines() if \\\"--- FAIL:\\\" in l][:6]\\n    for l in fails:\\n        print(\\\"  behav:\\\",l)\\n    if r1.returncode!=0:\\n        print(f\\\"  WARNING: census should PASS for token-preserving {name}\\\")\\n    if r2.returncode==0:\\n        print(f\\\"  ERROR: behavioral should FAIL for {name}\\\")\\n        sys.exit(1)\\nprint(\\\"ALL_NEW_PLANTS_BEHAVIORAL_KILL_OK\\\")\\nPY\\npython3 /tmp/check_rev11_mutants.py 2>&1 | tail -n 40; echo EXIT:${PIPESTATUS[0]}\",\n  \"description\": \"Verify new mutants kill behaviorally\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"N-referenced-creator: census_exit=0 behav_exit=1\\n  census: --- PASS: TestRev11RecordConsumptionCensus (0.00s)\\n  behav: --- FAIL: TestReview10ReferencedCheckpointAdmission (20.46s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/direct/ancestor=false/wrong_creator (1.35s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/direct/ancestor=true/wrong_creator (2.11s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/task_board/ancestor=false/wrong_creator (1.32s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/task_board/ancestor=true/wrong_creator (1.71s)\\n  behav: --- FAIL: TestRev11ReferencedCheckpointAdmissionRefusalClass (6.69s)\\nN-referenced-variant: census_exit=0 behav_exit=1\\n  census: --- PASS: TestRev11RecordConsumptionCensus (0.00s)\\n  behav: --- FAIL: TestReview10ReferencedCheckpointAdmission (17.05s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/direct/ancestor=false/wrong_variant (1.12s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/direct/ancestor=true/wrong_variant (1.55s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/task_board/ancestor=false/wrong_variant (1.04s)\\n  behav:     --- FAIL: TestReview10ReferencedCheckpointAdmission/task_board/ancestor=true/wrong_variant (1.47s)\\n  behav: --- FAIL: TestRev11ReferencedCheckpointAdmissionRefusalClass (5.46s)\\nN-referenced-lease: census_exit=0 behav_exit=0\\n  census: --- PASS: TestRev11RecordConsumptionCensus (0.00s)\\n  ERROR: behavioral should FAIL for N-referenced-lease\\nEXIT:1\\n\",\n  \"original_output_bytes\": 1570,\n  \"original_output_tokens\": 393,\n  \"truncated\": false\n}","final_result":true}}}
