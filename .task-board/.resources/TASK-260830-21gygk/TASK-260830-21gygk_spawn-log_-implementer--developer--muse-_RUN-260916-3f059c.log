{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c965","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":781,"recorded_at":1780531400001557,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc4-9cc5-7580-bb8e-d3f436b73804"},"task_id":"01a0abc4-9cc5-7580-bb8e-d3f436b73804","event":{"kind":"output","task_id":"01a0abc4-9cc5-7580-bb8e-d3f436b73804","chunk":"Read text file `internal/sessquery/summary.go`.\n(339 line(s) above)\n340|\t\tsummary, err := reader.authorize(row, reader.Local, false)\n341|\t\tif err != nil {\n342|\t\t\treturn nil, err\n343|\t\t}\n344|\t\tout = append(out, summary)\n345|\t}\n346|\treturn out, nil\n347|}\n348|\n349|// authorize binds one projected row to its closed authoritative\n350|// summary against the validated host, lease, and observation inputs.\n351|// The winning lease checkpoint event-head closure is admitted\n352|// against the row's source chain (repo, the winning source for\n353|// plans and the local index for lists), including its Section 2.4\n354|// profile authority. Every refusal names the\n355|// missing established fact; nothing is inferred. An established\n356|// absence (workspace \"absent\", an empty non-nil capability map) is\n357|// distinct from an unknown observation (nil), which refuses.\n358|func (reader *Reader) authorize(summary Summary, repo *sessrepo.Repository, requireProcess bool) (AuthoritativeSummary, error) {\n359|\tprojection := summary.Projection\n360|\tif err := checkSummaryRepresentable(summary); err != nil {\n361|\t\treturn AuthoritativeSummary{}, err\n362|\t}\n363|\tif reader.LocalHostID == \"\" {\n364|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n365|\t}\n366|\tlease, err := reader.winningLeaseFor(projection.SessionID, projection.Kind, repo)\n367|\tif err != nil {\n368|\t\treturn AuthoritativeSummary{}, err\n369|\t}\n370|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n371|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing lease facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n372|\t}\n373|\tif projection.OwnerHostID != lease.HolderHostID {\n374|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n375|\t}\n376|\tmetadata, ok := reader.HostMetadata[lease.HolderHostID]\n377|\tif !ok {\n378|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, lease.HolderHostID)\n379|\t}\n380|\tif projection.LocalRole == \"\" {\n381|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n382|\t}\n383|\tif err := checkWarnings(projection.Warnings); err != nil {\n384|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: warnings for session %s: %v\", ErrInvalidConfig, projection.SessionID, err)\n385|\t}\n386|\tauthorized := AuthoritativeSummary{\n387|\t\tSessionID:       projection.SessionID,\n388|\t\tName:            projection.Name,\n389|\t\tKind:            projection.Kind,\n390|\t\tProviderID:      projection.Provider.ID,\n391|\t\tState:           string(projection.State),\n392|\t\tOwnerHostID:     lease.HolderHostID,\n393|\t\tOwnerHostName:   metadata.DisplayName,\n394|\t\tLeaseEpoch:      lease.Epoch,\n395|\t\tLeaseID:         lease.LeaseID,\n396|\t\tLocalRole:       projection.LocalRole,\n397|\t\tWorkspaceStatus: \"\",\n398|\t\tWarnings:        append([]string(nil), projection.Warnings...),\n399|\t}\n400|\tif authorized.Warnings == nil {\n401|\t\tauthorized.Warnings = []string{}\n402|\t}\n403|\tobservations, hasObservations := reader.Observations[projection.SessionID]\n404|\tif projection.HasCheckpoint {\n405|\t\tcheckpoint := projection.Newest.ID\n406|\t\tauthorized.HasCheckpoint = true\n407|\t\tauthorized.NewestCheckpointID = &checkpoint\n408|\t\tif !hasObservations || observations.NewestCheckpointCreatedAt == nil {\n409|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n410|\t\t}\n411|\t\tstamp := *observations.NewestCheckpointCreatedAt\n412|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n413|\t}\n414|\tif !hasObservations || observations.WorkspaceStatus == nil {\n415|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: workspace status for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n416|\t}\n417|\tworkspace := WorkspaceAbsent\n418|\tif hasObservations && observations.WorkspaceStatus != nil {\n419|\t\tworkspace = *observations.WorkspaceStatus\n420|\t}\n421|\tauthorized.WorkspaceStatus = workspace\n422|\tif !hasObservations || observations.Capabilities == nil {\n423|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: capabilities for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n424|\t}\n425|\tauthorized.Capabilities = observations.Capabilities\n426|\tif authorized.Capabilities == nil {\n427|\t\tauthorized.Capabilities = map[string]CapabilitySummary{}\n428|\t}\n429|\tif requireProcess {\n430|\t\tif !hasObservations || observations.ProcessPresent == nil {\n431|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: process liveness for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n432|\t\t}\n433|\t}\n434|\tvar present bool\n435|\tvar hasPresent bool\n436|\tif hasObservations && observations.ProcessPresent != nil {\n437|\t\tpresent = *observations.ProcessPresent\n438|\t\thasPresent = true\n439|\t}\n440|\tif requireProcess || hasPresent {\n441|\t\t// For a required status without an observation the gate above\n442|\t\t// already refused; the false default here only lets a\n443|\t\t// weakening mutant proceed to a behavioral failure instead of\n444|\t\t// a panic.\n445|\t\tpresentCopy := present\n446|\t\tauthorized.ProcessPresent = &presentCopy\n447|\t\tif requireProcess && !hasPresent {\n448|\t\t\t// Mutant admission path: succeed with a minted fact so the\n449|\t\t\t// missing-observation test fails rather than panics.\n450|\t\t}\n451|\t}\n452|\treturn authorized, nil\n453|}","final_result":true}}}
