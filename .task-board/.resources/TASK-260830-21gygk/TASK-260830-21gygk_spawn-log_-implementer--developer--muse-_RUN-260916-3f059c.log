\"yolo\", \"standard\"))\n386|\t\t\tloser := rev8PreservedLoser(t, local, idA, changed)\n387|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", loser))\n388|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n389|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n390|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n391|\t\t\twithCheckpoints(r, cp)\n392|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n393|\t\t\treturn r\n394|\t\t},\n395|\t\t\"dangling_predecessor\": func(t *testing.T) *Reader {\n396|\t\t\tlocal, _ := repository(t)\n397|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n398|\t\t\tif err != nil {\n399|\t\t\t\tt.Fatal(err)\n400|\t\t\t}\n401|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n402|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n403|\t\t\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n404|\t\t\tmerged := rev8AppendPreds(t, local, idA, []string{zeroDigest, idle}, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n405|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{merged}})\n406|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n407|\t\t\twithCheckpoints(r, cp)\n408|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n409|\t\t\treturn r\n410|\t\t},\n411|\t}\n412|\torder := []string{\"wrong_type\", \"non_newest\", \"stale_value\", \"first_wrong_profile\", \"dangling_resume_source\", \"cross_session\", \"losing_branch\", \"dangling_predecessor\"}\n413|\tfor _, name := range order {\n414|\t\tt.Run(name, func(t *testing.T) {\n415|\t\t\trev8CheckIntegrityRefusal(t, builders[name](t))\n416|\t\t})\n417|\t}\n418|}\n419|\n420|// rev8AppendPreds chains one event with an explicit predecessor\n421|// list, unlike the single-predecessor fixture helpers. The chain\n422|// owner still requires the prior tail inside the list, so a merge\n423|// naming a dangling digest appends and reaches the profile gate.\n424|func rev8AppendPreds(t *testing.T, repo *sessrepo.Repository, sessionID string, predecessors []string, typ string, sequence int, payload map[string]any) string {\n425|\tt.Helper()\n426|\tvalue := map[string]any{\n427|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n428|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"event_type\": typ, \"created_by_host_id\": hostA,\n429|\t\t\"lease_epoch\": 1, \"lease_id\": lease, \"lease_sequence\": sequence, \"predecessors\": predecessors,\n430|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n431|\t}\n432|\tref, err := repo.AppendEvent(sessionID, identity(t, value, \"event_id\"))\n433|\tif err != nil {\n434|\t\tt.Fatal(err)\n435|\t}\n436|\treturn ref.EventID\n437|}\n438|\n439|// rev8PreservedLoser appends one profile.changed event under a\n440|// losing same-epoch lease and returns its digest. The repository\n441|// preserves the blob without indexing it, so the digest is\n442|// well-formed and provider-signed yet outside the authoritative\n443|// chain: exactly the losing-lease member the profile gate must\n444|// reject.\n445|func rev8PreservedLoser(t *testing.T, repo *sessrepo.Repository, sessionID, predecessor string) string {\n446|\tt.Helper()\n447|\tvalue := map[string]any{\n448|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n449|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"event_type\": \"profile.changed\", \"created_by_host_id\": hostA,\n450|\t\t\"lease_epoch\": 1, \"lease_id\": leaseLoser, \"lease_sequence\": 1, \"predecessors\": []string{predecessor},\n451|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": rev8ChangedPayload(\"yolo\", \"standard\"), \"extensions\": map[string]any{},\n452|\t}\n453|\traw := identity(t, value, \"event_id\")\n454|\tvar decoded map[string]any\n455|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n456|\t\tt.Fatal(err)\n457|\t}\n458|\tdigest, _ := decoded[\"event_id\"].(string)\n459|\tif _, err := repo.AppendEvent(sessionID, raw); !errors.Is(err, sessrepo.ErrDivergentBranch) {\n460|\t\tt.Fatalf(\"losing-lease change append = %v, want divergent branch preservation\", err)\n461|\t}\n462|\tindexed, err := repo.ListEvents(sessionID)\n463|\tif err != nil {\n464|\t\tt.Fatal(err)\n465|\t}\n466|\tfor _, summary := range indexed {\n467|\t\tif summary.EventID == digest {\n468|\t\t\tt.Fatalf(\"losing-lease change %s entered the authoritative index\", digest)\n469|\t\t}\n470|\t}\n471|\treturn digest\n472|}\n473|\n474|// TestRev8ProfileHistoricalClosureAdmits proves the closure fixes\n475|// the effective pair: a later local-only change past the heads is\n476|// never consulted, so the checkpoint still admits with (standard,\n477|// E1) while the tail already moved on.\n478|func TestRev8ProfileHistoricalClosureAdmits(t *testing.T) {\n479|\tlocal, _ := repository(t)\n480|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n481|\tif err != nil {\n482|\t\tt.Fatal(err)\n483|\t}\n484|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n485|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n486|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n487|\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", changed))\n488|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n489|\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n490|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n491|\ttransferred := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n492|\tlater := appendEventAs(t, local, idA, transferred, \"profile.changed\", 2, 2, leaseB, rev8ChangedPayload(\"standard\", \"yolo\"))\n493|\tr := &Reader{Local: local, LocalHostID: hostA}\n494|\twithCheckpoints(r, cp)\n495|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n496|\t_ = later\n497|\trev7CheckEntries(t, r, false)\n498|}\n499|\n500|// TestRev8ProfileOldPlanSubstitution proves an old plan revalidates\n501|// profile authority instead of trusting its bound lease: the plan\n502|// builds over the E1 checkpoint, then the reader substitutes a\n503|// checkpoint whose valid heads cover a stale creation pair, and\n504|// the old plan refuses with integrity failure while heads alone\n505|// would still admit it.\n506|func TestRev8ProfileOldPlanSubstitution(t *testing.T) {\n507|\tlocal, _ := repository(t)\n508|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n509|\tif err != nil {\n510|\t\tt.Fatal(err)\n511|\t}\n512|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n513|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n514|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n515|\tstale := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"yolo\", nil))\n516|\tidle := appendEvent(t, local, idA, stale, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n517|\tgood := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{changed}})\n518|\tbad := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n519|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, good), \"kind\": \"manual\"})\n520|\t_ = announced\n521|\tappendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n522|\tr := &Reader{Local: local, LocalHostID: hostA}\n523|\twithCheckpoints(r, good)\n524|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, good)))\n525|\trev7CheckEntries(t, r, false)\n526|\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n527|\trev7SwapCheckpoint(t, r, bad)\n528|\tif err := r.Revalidate(old); err == nil {\n529|\t\tt.Fatal(\"old-plan Revalidate admitted substituted profile authority\")\n530|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n531|\t\tt.Fatalf(\"old-plan Revalidate refusal = %v, want integrity_failure\", err)\n532|\t}\n533|\trev8CheckIntegrityRefusal(t, r)\n534|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
