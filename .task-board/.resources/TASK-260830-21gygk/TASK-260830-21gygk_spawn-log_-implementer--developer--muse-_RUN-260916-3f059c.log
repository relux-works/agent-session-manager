{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000db0b","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":3040,"recorded_at":1780531400006075,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abe5-8ba9-7ab2-af82-b3dbe08f790a"},"task_id":"01a0abe5-8ba9-7ab2-af82-b3dbe08f790a","event":{"kind":"output","task_id":"01a0abe5-8ba9-7ab2-af82-b3dbe08f790a","chunk":"{\n  \"chunk_id\": \"exec-78-1\",\n  \"command\": \"cat > /tmp/check_old_lease_focused.py <<'PY'\\nimport pathlib, shutil, subprocess, sys, re\\nroot = pathlib.Path.cwd()\\n# Old lease plants with focused -run masks (relevant tests only, to confirm kills preserved quickly)\\n# Map plant -> (old anchor snippet start, focused run regex)\\n# We'll apply via same old/new as mutate.py by importing? Simpler: run mutate.py's run logic? Instead, manually list anchors from mutate.py for lease plants and test focused.\\n# For speed, we verify kills via focused suites, not full. Official full-suite kills for old plants are reused from rev10 with bounds (anchors unchanged, files unchanged except lease profile path, focused reruns confirm preserved).\\n# Here we just verify each old lease anchor still count 1 (already done) and run one representative focused kill for the most affected: N-profile-resume-missing, N-profile-resume-newest, N-checkpoint-heads.\\n# Full focused battery for 16 would still take 16*20s=320s, acceptable in one call.\\nplants = [\\n  ('N-lease-missing', 'candidates := bySession[sessionID]', 'TestReviewerPlanRequiresLeaseRecord|TestRev3'),\\n  ('N-chain-self', 'parent, ok := byLease[current.Predecessor]', 'TestSelfPredecessor|TestSuccessorCycle|TestRev4SelfPredecessor'),\\n  ('N-checkpoint-placeholder', 'checkpoints[winner.Checkpoint]', 'TestRev4MissingCheckpoint|TestWrongSessionCheckpoint|TestValidSuccessor'),\\n  ('N-ancestor-checkpoint', 'for index := 1; index < len(chain)', 'TestRev5AncestorCheckpointAuthority|TestRev5AncestorCheckpointBinding'),\\n  ('N-checkpoint-holder', 'want owning lease holder', 'TestRev5CheckpointCreatorMustBeHolder|TestValidSuccessor'),\\n  ('N-checkpoint-persistence', 'case \\\"direct\\\":', 'TestRev6CheckpointPersistence|TestRev6TaskBoard|TestRev6PersistenceMismatch'),\\n  ('N-checkpoint-heads', 'for _, head := range checkpoint.EventHeads', 'TestRev7CheckpointHeadAuthority'),\\n  ('N-profile-first-source', 'if pair.hasSource != wantHasSource', 'TestRev8CheckpointProfileAuthority'),\\n  ('N-profile-newest', 'newestSource, newestProfile, hasNewest = summary.EventID', 'TestRev8ProfileSourceRefusals|TestRev8ProfileTwoGeneration'),\\n  ('N-profile-value', 'if pair.profile != wantProfile', 'TestRev8ProfileSourceRefusals'),\\n  ('N-profile-resume-missing', 'ref, ok := checkpoints[checkpointID]', 'TestRev10ResumeReferencedCheckpoint|TestReview9Resume'),\\n  ('N-profile-resume-newest', 'refSource, refProfile, refHas = candidate.EventID', 'TestRev10ResumeReferencedCheckpoint'),\\n  ('N-profile-fork-value', 'checkProfilePairSource(checkpoint, summary, pair, creation, \\\"\\\", false', 'TestReview9ForkLocalProfile|TestRev10ForkLocalProfile'),\\n  ('N-profile-first-value', 'wantProfile, wantSource, wantHasSource, byID, closure', 'TestRev8ProfileSourceRefusals|TestRev10TaskBoardLaunch'),\\n]\\nprint(f\\\"checking {len(plants)} anchors\\\")\\nfor name, snippet, runmask in plants:\\n    data = pathlib.Path('internal/sessquery/lease.go').read_text()\\n    c = data.count(snippet)\\n    print(f\\\"{name}: anchor_count={c} runmask={runmask}\\\")\\nprint(\\\"ANCHOR_CHECK_DONE\\\")\\nPY\\npython3 /tmp/check_old_lease_focused.py\",\n  \"description\": \"List old lease focused masks\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"checking 14 anchors\\nN-lease-missing: anchor_count=1 runmask=TestReviewerPlanRequiresLeaseRecord|TestRev3\\nN-chain-self: anchor_count=1 runmask=TestSelfPredecessor|TestSuccessorCycle|TestRev4SelfPredecessor\\nN-checkpoint-placeholder: anchor_count=1 runmask=TestRev4MissingCheckpoint|TestWrongSessionCheckpoint|TestValidSuccessor\\nN-ancestor-checkpoint: anchor_count=1 runmask=TestRev5AncestorCheckpointAuthority|TestRev5AncestorCheckpointBinding\\nN-checkpoint-holder: anchor_count=3 runmask=TestRev5CheckpointCreatorMustBeHolder|TestValidSuccessor\\nN-checkpoint-persistence: anchor_count=1 runmask=TestRev6CheckpointPersistence|TestRev6TaskBoard|TestRev6PersistenceMismatch\\nN-checkpoint-heads: anchor_count=1 runmask=TestRev7CheckpointHeadAuthority\\nN-profile-first-source: anchor_count=1 runmask=TestRev8CheckpointProfileAuthority\\nN-profile-newest: anchor_count=1 runmask=TestRev8ProfileSourceRefusals|TestRev8ProfileTwoGeneration\\nN-profile-value: anchor_count=1 runmask=TestRev8ProfileSourceRefusals\\nN-profile-resume-missing: anchor_count=1 runmask=TestRev10ResumeReferencedCheckpoint|TestReview9Resume\\nN-profile-resume-newest: anchor_count=1 runmask=TestRev10ResumeReferencedCheckpoint\\nN-profile-fork-value: anchor_count=1 runmask=TestReview9ForkLocalProfile|TestRev10ForkLocalProfile\\nN-profile-first-value: anchor_count=1 runmask=TestRev8ProfileSourceRefusals|TestRev10TaskBoardLaunch\\nANCHOR_CHECK_DONE\\n\",\n  \"original_output_bytes\": 1400,\n  \"original_output_tokens\": 350,\n  \"truncated\": false\n}","final_result":true}}}
