{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6ab","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":2480,"recorded_at":1780531400004955,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abd2-65d6-77e0-8f46-a5dcee1aed9f"},"task_id":"01a0abd2-65d6-77e0-8f46-a5dcee1aed9f","event":{"kind":"output","task_id":"01a0abd2-65d6-77e0-8f46-a5dcee1aed9f","chunk":"Read text file `internal/sessquery/testdata/mutate.py`.\n(130 line(s) above)\n131|run('N-profile-first-value',lease_source,'if err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil {','if err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil && (pair.profile != \"standard\" || pair.hasSource || wantProfile != \"yolo\" || wantHasSource) {','Admit exactly a standard-valued sourceless pair where the creation pair wants yolo/null; the first-profile negatives must fail by admission.')\n132|run('N-referenced-creator',lease_source,'\\tif ref.CreatorHostID != owner.HolderHostID {\\n\\t\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\\\", ErrObservationUnavailable, checkpointID, ref.CreatorHostID, owner.HolderHostID)\\n\\t}\\n','\\tif ref.CreatorHostID != owner.HolderHostID && ref.CreatorHostID != \\\"' + HOSTB + '\\\" {\\n\\t\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\\\", ErrObservationUnavailable, checkpointID, ref.CreatorHostID, owner.HolderHostID)\\n\\t}\\n','Admit exactly a hostB-created referenced checkpoint past the shared creator gate; the census call tokens stay present so the static gate passes while the wrong_creator behavioral negatives must fail by admission.')\n133|run('N-referenced-variant',lease_source,'\\tif err := checkCheckpointPersistence(ref, sessionID, sessionKind); err != nil {\\n\\t\\treturn err\\n\\t}\\n','\\tif err := checkCheckpointPersistence(ref, sessionID, sessionKind); err != nil && sessionID != \\\"' + IDA + '\\\" {\\n\\t\\treturn err\\n\\t}\\n','Admit exactly the idA wrong persistence variant on the referenced path; the census call tokens stay present so the static gate passes while the wrong_variant behavioral negatives must fail by admission.')\n134|run('N-referenced-lease',lease_source,'\\tif !found {\\n\\t\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is bound to lease %s at epoch %d without an admitted owning lease\\\", ErrObservationUnavailable, checkpointID, ref.LeaseID, ref.LeaseEpoch)\\n\\t}\\n','\\tif !found && ref.LeaseID != \\\"' + LEASECYCLEB + '\\\" {\\n\\t\\treturn fmt.Errorf(\\\"%w: validated checkpoint %s is bound to lease %s at epoch %d without an admitted owning lease\\\", ErrObservationUnavailable, checkpointID, ref.LeaseID, ref.LeaseEpoch)\\n\\t}\\n','Admit exactly the leaseCycleB fencing token without an admitted owning lease; the census call tokens stay present so the static gate passes while the wrong_lease behavioral negatives must fail by admission.')\n135|run('N-parked-union-refusal',revalidate_source,'\\t\\tif row.Projection.Parked != nil {\\n\\t\\t\\treturn fmt.Errorf(\"%w: required authority for session %s is unknown: %s\", ErrObservationUnavailable, plan.SessionID, row.Projection.Parked.BlockingReason)\\n','\\t\\tif row.Projection.Parked != nil && row.Projection.RecordID == \"\" {\\n\\t\\t\\treturn fmt.Errorf(\"%w: required authority for session %s is unknown: %s\", ErrObservationUnavailable, plan.SessionID, row.Projection.Parked.BlockingReason)\\n','Admit parked union copies with a nonempty record; the agreeing-record member validates over unknown authority while the divergent member shifts to the record-agreement refusal.')\n136|run('N-capability-name',summary_source,'\\t\\tif !admitted[name] {','\\t\\tif !admitted[name] && name != \"invented_capability\" {','Admit exactly the invented_capability name past the closed Section 7.3 vocabulary; every registry name and every other invented name still behave.')\n137|run('B-peer-order',source,'\\tsort.Strings(ids)\\n\\tvar out []candidate','\\tsort.Sort(sort.Reverse(sort.StringSlice(ids)))\\n\\tvar out []candidate','Reverse peer-source tie ordering; behavioral determinism fixture must fail.')\n138|run('B-session-order',source,'return out[i].Projection.SessionID < out[j].Projection.SessionID','return out[i].Projection.SessionID > out[j].Projection.SessionID','Reverse session output order; behavioral list fixture must fail.')\n139|run('B-tie-break',source,') < holderHost(best.selection',') > holderHost(best.selection','Reverse the identical-copy host tie break; the deterministic selection fixture must fail.')\n140|run('C-harmless-comment',lease_source,'// checkLeaseChain validates the winner','// checkLeaseChain validates the winner\\n// classifier control: comment only, no behavior change.','Applied control: a behavior-preserving plant survives through the same instrument.')\n(more lines below)","final_result":true}}}
