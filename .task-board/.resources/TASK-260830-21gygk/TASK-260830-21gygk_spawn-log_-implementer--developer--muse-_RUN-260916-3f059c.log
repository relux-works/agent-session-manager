{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d7","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":710,"recorded_at":1780531400001415,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc4-809c-7650-9305-9f59c3dd140f"},"task_id":"01a0abc4-809c-7650-9305-9f59c3dd140f","event":{"kind":"output","task_id":"01a0abc4-809c-7650-9305-9f59c3dd140f","chunk":"{\n  \"chunk_id\": \"exec-24-1\",\n  \"command\": \"grep -n \\\"type Reader\\\\|CheckpointRecords\\\\|LeaseRecords\\\\|HostMetadata\\\\|Observations\\\\|Local \\\\|Peers\\\\|func (.*Reader.*) BuildPlan\\\\|func (.*Reader.*) Revalidate\\\\|func (.*Reader.*) Authoritative\\\" internal/sessquery/*.go | head -n 60\\necho ===; sed -n '1,120p' internal/sessquery/query.go\",\n  \"description\": \"Map Reader struct and entries\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/sessquery/digest.go:1:// Local attestation digests for selector plans: canonical fingerprints\\ninternal/sessquery/digest.go:61:\\tpeers := make([]peerFingerprint, 0, len(reader.Peers))\\ninternal/sessquery/fixtures_test.go:234:\\treader.CheckpointRecords = append(append([][]byte(nil), reader.CheckpointRecords...), checkpoints...)\\ninternal/sessquery/fixtures_test.go:240:\\treader.LeaseRecords = append(append([][]byte(nil), reader.LeaseRecords...), leases...)\\ninternal/sessquery/lease.go:5:// in Reader.LeaseRecords. Each record is validated through the\\ninternal/sessquery/lease.go:294:\\tfor _, raw := range reader.LeaseRecords {\\ninternal/sessquery/lease.go:424:\\tfor _, raw := range reader.CheckpointRecords {\\ninternal/sessquery/plan_test.go:180:\\t\\tPeers:              []PeerIndex{{hostA, peer}},\\ninternal/sessquery/plan_test.go:247:\\treader.Peers = []PeerIndex{{hostA, peer}}\\ninternal/sessquery/plan_test.go:417:\\t\\t\\tPeers:              []PeerIndex{{hostA, repoA}, {hostB, repoB}},\\ninternal/sessquery/plan_test.go:431:\\t\\treader.Peers = []PeerIndex{{hostC, peer}}\\ninternal/sessquery/plan_test.go:447:\\t\\t\\tPeers:              []PeerIndex{{hostA, peer}},\\ninternal/sessquery/plan_test.go:527:\\t\\t\\tPeers:              []PeerIndex{{hostA, peer}},\\ninternal/sessquery/plan_test.go:564:\\t\\t\\tPeers:              []PeerIndex{{hostA, peer}},\\ninternal/sessquery/plan.go:17:// supplied in Reader.LeaseRecords and admitted through the\\ninternal/sessquery/plan.go:155:\\t// canonicaljson owner from Reader.LeaseRecords.\\ninternal/sessquery/plan.go:197:func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\\ninternal/sessquery/plan.go:202:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query_test.go:23:\\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\\ninternal/sessquery/query_test.go:36:\\t// Local exact name wins even if a peer learned the same name for another ID.\\ninternal/sessquery/query_test.go:39:\\treader.Peers = []PeerIndex{{hostA, other}}\\ninternal/sessquery/query_test.go:63:\\t\\t\\t\\tr.Peers = []PeerIndex{{hostA, source}}\\ninternal/sessquery/query_test.go:103:\\tr := &Reader{Local: local, Peers: []PeerIndex{{hostA, peer}}}\\ninternal/sessquery/query_test.go:121:\\t// Local exact name does not depend on lower-tier reads.\\ninternal/sessquery/query_test.go:131:\\tr.Peers = []PeerIndex{{hostA, nil}}\\ninternal/sessquery/query_test.go:135:\\tr.Peers = []PeerIndex{{hostA, nil}, {hostA, peer}}\\ninternal/sessquery/query_test.go:156:\\tr := &Reader{Local: local, AllowlistedPeerIDs: []string{hostB, hostA, hostB}, Peers: []PeerIndex{{hostB, b}, {hostA, a}}}\\ninternal/sessquery/query_test.go:161:\\tr.Peers[0], r.Peers[1] = r.Peers[1], r.Peers[0]\\ninternal/sessquery/query.go:98:// HostMetadata and Observations carry the validated host and observation\\ninternal/sessquery/query.go:104:// LeaseRecords carries the validated winning-lease authority for plan\\ninternal/sessquery/query.go:114:// CheckpointRecords carries the validated checkpoint authority the\\ninternal/sessquery/query.go:124:type Reader struct {\\ninternal/sessquery/query.go:125:\\tLocal              *sessrepo.Repository\\ninternal/sessquery/query.go:128:\\tPeers              []PeerIndex\\ninternal/sessquery/query.go:130:\\tHostMetadata       map[string]HostMetadata\\ninternal/sessquery/query.go:131:\\tObservations       map[string]SessionObservations\\ninternal/sessquery/query.go:132:\\tLeaseRecords       [][]byte\\ninternal/sessquery/query.go:133:\\tCheckpointRecords  [][]byte\\ninternal/sessquery/query.go:153:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query.go:207:// InspectLocal reads one local ID, including a parked or tombstoned session.\\ninternal/sessquery/query.go:209:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query.go:252:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query.go:279:\\treadPeers := func() ([]candidate, error) {\\ninternal/sessquery/query.go:291:\\t\\tunion, err := readPeers()\\ninternal/sessquery/query.go:300:\\tunion, err := readPeers()\\ninternal/sessquery/query.go:393:\\tfor _, peer := range reader.Peers {\\ninternal/sessquery/query.go:410:\\tfor _, peer := range reader.Peers {\\ninternal/sessquery/query.go:429:// readSource completes one source read. Local I-O failures keep their\\ninternal/sessquery/query.go:545:\\t\\tfor _, peer := range reader.Peers {\\ninternal/sessquery/resolve_test.go:38:\\t\\tPeers:              []PeerIndex{{hostA, peer}},\\ninternal/sessquery/resolve_test.go:168:\\t// Local needs no allowlist entry and survives revocation.\\ninternal/sessquery/resolve_test.go:189:\\treader.Peers = []PeerIndex{{hostA, nil}}\\ninternal/sessquery/resolve_test.go:195:\\treader.Peers = nil\\ninternal/sessquery/resolve_test.go:199:\\treader.Peers = []PeerIndex{{hostA, peer}}\\ninternal/sessquery/resolve_test.go:214:\\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\\ninternal/sessquery/resolve_test.go:240:\\treader.Peers = []PeerIndex{{hostA, peer}, {hostC, other}}\\ninternal/sessquery/resolve_test.go:250:\\treader.Peers = []PeerIndex{{hostA, other}}\\ninternal/sessquery/rev10_regression_test.go:54:\\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\\ninternal/sessquery/rev10_regression_test.go:56:\\tobservation := r.Observations[idA]\\ninternal/sessquery/rev10_regression_test.go:58:\\tr.Observations[idA] = observation\\n===\\n// Package sessquery is the single shared selector API over the session\\n// repository and state projector: read-only selector resolution\\n// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\\n// list/status summaries, and immutable SelectionPlan construction with\\n// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\\n// own invoking this API at every required boundary; no second resolver\\n// exists. Unknown owner/lease facts and parked diagnostics stay explicit\\n// in Projection: host display names, checkpoint timestamps/age,\\n// workspace state, capabilities, process liveness and sync timestamps\\n// require their respective observation owners and are never inferred\\n// from a record or a successful read.\\npackage sessquery\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"sort\\\"\\n\\t\\\"strings\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/sessrepo\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/sessstate\\\"\\n)\\n\\nvar (\\n\\tErrUnavailable = errors.New(\\\"session index unavailable\\\")\\n\\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\\n\\tErrNotFound    = sessrepo.ErrNameNotFound\\n\\t// ErrInvalidArgument refuses a malformed caller argument: selector\\n\\t// grammar violations (empty key, unknown source prefix, malformed\\n\\t// durable IDs, overlong argument), malformed plan members, unknown\\n\\t// action tags, and malformed destinations or expectations. Wire\\n\\t// exit binding for a CLI surface belongs to that surface's leaf;\\n\\t// this library keeps the refusal class distinct and stable.\\n\\tErrInvalidArgument = errors.New(\\\"invalid_arguments\\\")\\n\\t// ErrSourceNotFound reports that complete valid configuration has\\n\\t// no requested explicit source.\\n\\tErrSourceNotFound = errors.New(\\\"selector_source_not_found\\\")\\n\\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\\n\\t// is configured but not allowlisted, including authorization\\n\\t// revoked after a plan was built.\\n\\tErrPeerNotAllowlisted = errors.New(\\\"peer_not_allowlisted\\\")\\n\\t// ErrSourceReadFailed reports a remote source transport/I-O read\\n\\t// failure with no fallback. The underlying cause stays attached\\n\\t// for errors.Is, so a repository-path failure remains visible as\\n\\t// such. A local source/store I-O failure keeps its repository\\n\\t// error, which the CLI Result 5 leaf maps to\\n\\t// local_precondition_failed; a partial or malformed index or\\n\\t// authority response is integrity failure, not absence.\\n\\tErrSourceReadFailed = errors.New(\\\"selector_source_read_failed\\\")\\n\\t// ErrInvalidConfig reports duplicate or malformed effective source\\n\\t// mappings: duplicate exact aliases or host IDs, a peer host that\\n\\t// collides with the local host, malformed host IDs, or aliases\\n\\t// outside the configured 1-64 printable-character bound.\\n\\tErrInvalidConfig = errors.New(\\\"invalid_config\\\")\\n\\t// ErrPlanStale reports bound selection facts that changed after a\\n\\t// plan was built; a fresh plan and confirmation are required. The\\n\\t// wrapped reason names the first diverged member in compare order.\\n\\tErrPlanStale = errors.New(\\\"selector_plan_stale\\\")\\n\\t// ErrBootstrapIncomplete reports a complete authority read proving\\n\\t// a Session Record without any valid lease: an interrupted\\n\\t// persistence prefix for the bootstrap-recovery leaf (Section\\n\\t// 14.7.4), never a public summary. A failed read keeps its\\n\\t// read-failure class instead; corrupt authority is integrity\\n\\t// failure. Wire exit binding for a CLI surface belongs to that\\n\\t// surface's leaf; this library keeps the refusal class distinct\\n\\t// and stable.\\n\\tErrBootstrapIncomplete = errors.New(\\\"selector_bootstrap_incomplete\\\")\\n\\t// ErrObservationUnavailable reports a required summary observation\\n\\t// or host metadata fact that cannot be established from validated\\n\\t// inputs. Nothing is inferred in its place: no source alias stands\\n\\t// in for host metadata, and no absent observation mints liveness,\\n\\t// capability, workspace, or timestamp facts.\\n\\tErrObservationUnavailable = errors.New(\\\"selector_observation_unavailable\\\")\\n)\\n\\n// PeerIndex binds a peer identity to its already persisted learned index.\\n// Transport/authentication and installing peer indexes are upstream owners;\\n// this reader does not fetch, authenticate, or attest a caller-supplied index.\\ntype PeerIndex struct {\\n\\tHostID string\\n\\tRepo   *sessrepo.Repository\\n}\\n\\n// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\\n// configuration layer, separately from the learned indexes. An unlisted source\\n// is never read. Failed reads from listed sources are errors, never\\n// empty indexes that let resolution fall through to a lower-priority UUID.\\n// LocalHostID comes from the local host identity owner; empty preserves unknown.\\n//\\n// Aliases carries the exact configured peer-alias mapping (host ID to\\n// alias) from the same configuration owner, kept separate from the\\n// learned index handles: a mapping without a handle contributes no\\n// learned names, and a handle without a mapping stays reachable through\\n// the bare union and the \\\"id:\\\" host form but never through \\\"peer:\\\".\\n// Alias comparison is always exact, never folded, trimmed, or decoded.\\n//\\n// HostMetadata and Observations carry the validated host and observation\\n// facts the authoritative summary layer requires, from their respective\\n// owners. They are consulted only by that layer: List and Status keep\\n// the internal read model and refuse only the unrepresentable\\n// record-only bootstrap.\\n//\\n// LeaseRecords carries the validated winning-lease authority for plan\\n// construction and revalidation, from the lease owner. Each entry is\\n// canonical JSON for one urn:ax:schema:lease Lease Record; the reader\\n// validates the closed shape and canonical self identity through the\\n// canonicaljson owner, selects the greatest (epoch, lease_id) winner\\n// per session, and binds that record digest with its tuple and holder.\\n// Absence for a session refuses observation_unavailable; malformed\\n// bytes refuse invalid_config. Envelope observations never substitute\\n// for these records.\\n//\\n// CheckpointRecords carries the validated checkpoint authority the\\n// winning-lease succession gate requires, from the checkpoint owner.\\n// Each entry is canonical JSON for one urn:ax:schema:checkpoint\\n// Checkpoint Record; the reader validates the closed shape and\\n// canonical self identity through the sessrepo owner. Every successor\\n// winner must reference an admitted record for its session and\\n// predecessor lease, carrying the persistence variant the referenced\\n\",\n  \"original_output_bytes\": 11819,\n  \"original_output_tokens\": 2955,\n  \"truncated\": false\n}","final_result":true}}}
