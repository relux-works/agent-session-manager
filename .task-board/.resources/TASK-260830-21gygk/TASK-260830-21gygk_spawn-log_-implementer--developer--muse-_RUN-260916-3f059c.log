 := appendEvent(t, local, idA, created, \"provider.launched\", next(), rev8LaunchPayload(\"yolo\", nil))\n350|\tbeforeChangeIdle := appendEvent(t, local, idA, launched, \"session.idle\", next(), map[string]any{\"boundary_ref\": \"before-change\", \"foreground_idle\": true, \"background_idle\": true})\n351|\tchanged := appendEvent(t, local, idA, beforeChangeIdle, \"profile.changed\", next(), rev8ChangedPayload(\"yolo\", \"standard\"))\n352|\tvar changed2 string\n353|\tif mode == \"bad_non_newest\" {\n354|\t\tchanged2 = appendEvent(t, local, idA, changed, \"profile.changed\", next(), rev8ChangedPayload(\"standard\", \"yolo\"))\n355|\t}\n356|\tvar loser string\n357|\tif mode == \"bad_losing\" || mode == \"good_divergent\" {\n358|\t\tloser = rev8PreservedLoser(t, local, idA, changed)\n359|\t}\n360|\tquiescePred := changed\n361|\tif mode == \"bad_non_newest\" {\n362|\t\tquiescePred = changed2\n363|\t}\n364|\tquiesced := appendEvent(t, local, idA, quiescePred, \"session.idle\", next(), map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n365|\thead := quiesced\n366|\tif mode == \"good_prechange\" || mode == \"bad_stale\" {\n367|\t\thead = beforeChangeIdle\n368|\t}\n369|\tcpA := rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{head}})\n370|\tstoppedRef := checkpointDigestOf(t, cpA)\n371|\treference := stoppedRef\n372|\tprofile, source := \"standard\", any(changed)\n373|\tvar extra []byte\n374|\tswitch mode {\n375|\tcase \"good\", \"good_divergent\":\n376|\tcase \"good_prechange\":\n377|\t\tprofile, source = \"yolo\", nil\n378|\tcase \"bad_stale\":\n379|\tcase \"bad_missing\":\n380|\t\treference = zeroDigest\n381|\t\tprofile, source = \"yolo\", nil\n382|\tcase \"bad_missing_stale\":\n383|\t\treference = zeroDigest\n384|\tcase \"bad_wrong_session\":\n385|\t\textra = checkpointRecordBytes(t, idB, 1, lease, hostA)\n386|\t\treference = checkpointDigestOf(t, extra)\n387|\tcase \"bad_unknown_head\":\n388|\t\textra = rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{zeroDigest}})\n389|\t\treference = checkpointDigestOf(t, extra)\n390|\tcase \"bad_non_newest\":\n391|\tcase \"bad_losing\":\n392|\t\tsource = loser\n393|\tcase \"bad_creation_fallback\":\n394|\t\tprofile, source = \"yolo\", nil\n395|\tdefault:\n396|\t\tt.Fatalf(\"unknown resume mode %q\", mode)\n397|\t}\n398|\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", next(), map[string]any{\"checkpoint_id\": stoppedRef, \"kind\": \"manual\"})\n399|\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", next(), map[string]any{\"graceful\": true, \"checkpoint_id\": stoppedRef, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n400|\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", next(), rev10ResumePayload(reference, profile, source))\n401|\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", next(), map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n402|\tcpB := rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n403|\tannouncedB := appendEvent(t, local, idA, idle, \"checkpoint.created\", next(), map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpB), \"kind\": \"manual\"})\n404|\ttail := appendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n405|\tr := &Reader{Local: local, LocalHostID: hostA}\n406|\tswitch mode {\n407|\tcase \"bad_missing\", \"bad_missing_stale\":\n408|\t\twithCheckpoints(r, cpB)\n409|\tcase \"bad_wrong_session\", \"bad_unknown_head\":\n410|\t\twithCheckpoints(r, cpB, extra)\n411|\tdefault:\n412|\t\twithCheckpoints(r, cpB, cpA)\n413|\t}\n414|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cpB)))\n415|\tif ancestor {\n416|\t\tlaunchProfile, launchSource := \"standard\", any(changed)\n417|\t\tif mode == \"bad_non_newest\" {\n418|\t\t\tlaunchProfile, launchSource = \"yolo\", changed2\n419|\t\t}\n420|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, rev8LaunchPayload(launchProfile, launchSource))\n421|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n422|\t\tcp2 := rev7Replace(t, checkpoint(t, idA, 2, leaseB, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n423|\t\twithCheckpoints(r, cp2)\n424|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n425|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n426|\t}\n427|\t_ = tail\n428|\treturn r\n429|}\n430|\n431|// TestRev10ResumeReferencedCheckpoint drives the session.resumed\n432|// referenced-closure pair across persistence kinds,\n433|// winner/necessary-ancestor paths, and refusal classes: a pair that\n434|// contradicts its referenced closure refuses integrity failure,\n435|// while a missing, wrong-session, or unresolvable reference refuses\n436|// observation_unavailable. The good_prechange mode is the historical\n437|// control: the resume cites its pre-change checkpoint pair while a\n438|// later outer change exists and is never consulted.\n439|func TestRev10ResumeReferencedCheckpoint(t *testing.T) {\n440|\tintegrity := map[string]bool{\"bad_stale\": true, \"bad_non_newest\": true, \"bad_losing\": true, \"bad_creation_fallback\": true}\n441|\tunavailable := map[string]bool{\"bad_missing\": true, \"bad_missing_stale\": true, \"bad_wrong_session\": true, \"bad_unknown_head\": true}\n442|\tmodes := []string{\"good\", \"good_prechange\", \"good_divergent\", \"bad_stale\", \"bad_missing\", \"bad_missing_stale\", \"bad_wrong_session\", \"bad_unknown_head\", \"bad_non_newest\", \"bad_losing\", \"bad_creation_fallback\"}\n443|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n444|\t\tfor _, ancestor := range []bool{false, true} {\n445|\t\t\tfor _, mode := range modes {\n446|\t\t\t\tt.Run(fmt.Sprintf(\"%s/ancestor=%t/%s\", kind, ancestor, mode), func(t *testing.T) {\n447|\t\t\t\t\tr := rev10ResumeFixture(t, kind, ancestor, mode)\n448|\t\t\t\t\tswitch {\n449|\t\t\t\t\tcase integrity[mode]:\n450|\t\t\t\t\t\trev8CheckIntegrityRefusal(t, r)\n451|\t\t\t\t\tcase unavailable[mode]:\n452|\t\t\t\t\t\trev10CheckUnavailableRefusal(t, r)\n453|\t\t\t\t\tdefault:\n454|\t\t\t\t\t\trev7CheckEntries(t, r, false)\n455|\t\t\t\t\t}\n456|\t\t\t\t})\n457|\t\t\t}\n458|\t\t}\n459|\t}\n460|}\n461|\n462|// TestRev10ResumeOldPlanSubstitution proves an old plan revalidates\n463|// resume authority instead of trusting its bound lease: the plan\n464|// builds over a checkpoint whose closure covers only a valid resume,\n465|// then the reader substitutes a checkpoint whose valid heads cover a\n466|// second resume with a stale referenced pair, and the old plan\n467|// refuses with integrity failure.\n468|func TestRev10ResumeOldPlanSubstitution(t *testing.T) {\n469|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n470|\t\tt.Run(kind, func(t *testing.T) {\n471|\t\t\tlocal, _ := repository(t)\n472|\t\t\traw := record(t, idA, \"alpha\")\n473|\t\t\tif kind == \"task_board\" {\n474|\t\t\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n475|\t\t\t}\n476|\t\t\tcheckpoint := checkpointRecordBytes\n477|\t\t\tif kind == \"task_board\" {\n478|\t\t\t\tcheckpoint = taskBoardCheckpointBytes\n479|\t\t\t}\n480|\t\t\tref, err := local.CreateSession(raw)\n481|\t\t\tif err != nil {\n482|\t\t\t\tt.Fatal(err)\n483|\t\t\t}\n484|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n485|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n486|\t\t\tbeforeChangeIdle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"before-change\", \"foreground_idle\": true, \"background_idle\": true})\n487|\t\t\tchanged := appendEvent(t, local, idA, beforeChangeIdle, \"profile.changed\", 4, rev8ChangedPayload(\"yolo\", \"standard\"))\n488|\t\t\tquiesced := appendEvent(t, local, idA, changed, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n489|\t\t\tcpA := rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{quiesced}})\n490|\t\t\tcpA0 := rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{beforeChangeIdle}})\n491|\t\t\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"kind\": \"manual\"})\n492|\t\t\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", 7, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n493|\t\t\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", 8, rev10ResumePayload(checkpointDigestOf(t, cpA), \"standard\", changed))\n494|\t\t\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 9, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n495|\t\t\tstopped2 := appendEvent(t, local, idA, idle, \"session.stopped\", 10, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA0), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n496|\t\t\tresumed2 := appendEvent(t, local, idA, stopped2, \"session.resumed\", 11, rev10ResumePayload(checkpointDigestOf(t, cpA0), \"standard\", changed))\n497|\t\t\tidle2 := appendEvent(t, local, idA, resumed2, \"session.idle\", 12, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n498|\t\t\tnarrow := rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n499|\t\t\tcovered := rev7Replace(t, checkpoint(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle2}})\n500|\t\t\tannouncedB := appendEvent(t, local, idA, idle2, \"checkpoint.created\", 13, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, narrow), \"kind\": \"manual\"})\n501|\t\t\t_ = announcedB\n502|\t\t\tappendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n503|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n504|\t\t\twithCheckpoints(r, narrow, cpA, cpA0)\n505|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, narrow)))\n506|\t\t\trev7CheckEntries(t, r, false)\n507|\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n508|\t\t\trev7SwapCheckpoint(t, r, covered)\n509|\t\t\tif err := r.Revalidate(old); err == nil {\n510|\t\t\t\tt.Fatal(\"old-plan Revalidate admitted substituted resume authority\")\n511|\t\t\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n512|\t\t\t\tt.Fatalf(\"old-plan Revalidate refusal = %v, want integrity_failure\", err)\n513|\t\t\t}\n514|\t\t\trev8CheckIntegrityRefusal(t, r)\n515|\t\t})\n516|\t}\n517|}\n518|\n519|// TestRev10ResumeReferencedWithdrawal proves an old plan re-resolves\n520|// referenced resume authority instead of trusting its bound facts:\n521|// withdrawing the referenced checkpoint record after the build makes\n522|// the old plan refuse with observation_unavailable.\n523|func TestRev10ResumeReferencedWithdrawal(t *testing.T) {\n524|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n525|\t\tt.Run(kind, func(t *testing.T) {\n526|\t\t\tr := rev10ResumeFixture(t, kind, false, \"good\")\n527|\t\t\trev7CheckEntries(t, r, false)\n528|\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n529|\t\t\tr.CheckpointRecords = append([][]byte(nil), r.CheckpointRecords[0])\n530|\t\t\tif err := r.Revalidate(old); err == nil {\n531|\t\t\t\tt.Fatal(\"old-plan Revalidate admitted withdrawn referenced authority\")\n532|\t\t\t} else if !errors.Is(err, ErrObservationUnavailable) {\n533|\t\t\t\tt.Fatalf(\"old-plan Revalidate refusal = %v, want observation_unavailable\", err)\n534|\t\t\t}\n535|\t\t\trev10CheckUnavailableRefusal(t, r)\n536|\t\t})\n537|\t}\n538|}\n539|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
