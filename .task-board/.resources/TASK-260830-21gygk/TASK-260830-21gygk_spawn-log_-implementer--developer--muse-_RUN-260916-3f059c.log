{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c3","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":572,"recorded_at":1780531400001139,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc4-17b8-7121-8d22-66f523500ab6"},"task_id":"01a0abc4-17b8-7121-8d22-66f523500ab6","event":{"kind":"output","task_id":"01a0abc4-17b8-7121-8d22-66f523500ab6","chunk":"Read text file `internal/sessquery/lease.go`.\n(249 line(s) above)\n250|\t\tDigest:              digest.String(),\n251|\t\tSessionID:           sessionID.String(),\n252|\t\tLeaseEpoch:          epoch,\n253|\t\tLeaseID:             leaseID,\n254|\t\tCreatorHostID:       creator.String(),\n255|\t\tHasProviderManifest: hasProvider,\n256|\t\tHasTaskBoardBundle:  hasBoard,\n257|\t\tEventHeads:          heads,\n258|\t\tRaw:                 append([]byte(nil), raw...),\n259|\t}\n260|\treturn checkpoint, nil\n261|}\n262|\n263|// checkpointEventHeads extracts the sorted unique event-head digests\n264|// the canonical checkpoint owner already shape-validated (1..64\n265|// entries). Grammar failures refuse invalid_config; resolution\n266|// against the session chain belongs to checkCheckpointEventHeads.\n267|func checkpointEventHeads(members map[string]json.RawMessage) ([]string, error) {\n268|\traw, ok := members[\"event_heads\"]\n269|\tif !ok {\n270|\t\treturn nil, fmt.Errorf(\"member %q is absent\", \"event_heads\")\n271|\t}\n272|\tvar values []string\n273|\tif err := json.Unmarshal(raw, &values); err != nil {\n274|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", \"event_heads\", err)\n275|\t}\n276|\tout := make([]string, 0, len(values))\n277|\tfor _, value := range values {\n278|\t\tdigest, err := scalar.ParseDigest(value)\n279|\t\tif err != nil {\n280|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", \"event_heads\", value, err)\n281|\t\t}\n282|\t\tout = append(out, digest.String())\n283|\t}\n284|\treturn out, nil\n285|}\n286|\n287|// validatedLeasesBySession validates every supplied Lease Record and\n288|// groups the admitted records by session UUID.\n289|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n290|\tout := map[string][]validatedLease{}\n291|\tif reader == nil {\n292|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n293|\t}\n294|\tfor _, raw := range reader.LeaseRecords {\n295|\t\tlease, err := parseLeaseRecord(raw)\n296|\t\tif err != nil {\n297|\t\t\treturn nil, err\n298|\t\t}\n299|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n300|\t}\n301|\treturn out, nil\n302|}\n303|\n304|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n305|// Record for one session and validates its succession: the\n306|// predecessor ancestry must chain by epoch plus one down to an\n307|// epoch-1 root, and every lease in that winning ancestry above\n308|// epoch 1 must reference a validated checkpoint for its session and\n309|// predecessor lease (Section 5.3), each created by the owning lease\n310|// holder (Section 5.4). Every required checkpoint must additionally\n311|// carry the persistence variant the referenced Session Record\n312|// selects: sessionKind is that record's kind as projected from the\n313|// winning source, and a variant mismatch refuses\n314|// observation_unavailable even when canonical identity, session,\n315|// lease, epoch, and creator all agree. Every required checkpoint\n316|// must also resolve each event head to a chained event for its\n317|// session at or before its bound lease in the winning source chain\n318|// (repo, Section 5.4 event-head closure): a head naming an absent\n319|// event or an event under a later lease cannot establish current\n320|// complete authority, so it refuses observation_unavailable;\n321|// historical heads stay admissible and are never required to equal\n322|// the current tail. Every required checkpoint must also admit its\n323|// Section 2.4 profile authority over the same closure\n324|// (checkCheckpointProfileAuthority): a first launch outside the\n325|// creation pair, a later launch outside the newest authoritative\n326|// change at or before it, a resume outside its referenced\n327|// checkpoint's closure pair, or a fork outside the new record\n328|// pair, contradicts the admitted history (integrity failure).\n329|// Absence refuses observation_unavailable; a\n330|// lease above epoch 1 without its named predecessor in the admitted\n331|// set refuses the same class rather than binding a dangling\n332|// successor, while an illegal predecessor link is malformed\n333|// authority (integrity failure).\n334|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {\n335|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n336|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n337|\t}\n338|\tbySession, err := reader.validatedLeasesBySession()\n339|\tif err != nil {\n340|\t\treturn validatedLease{}, err\n341|\t}\n342|\tcandidates := bySession[sessionID]\n343|\tif len(candidates) == 0 {\n344|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n345|\t}\n346|\twinner := candidates[0]\n347|\tfor _, candidate := range candidates[1:] {\n348|\t\tif sessstate.Compare(\n349|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n350|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n351|\t\t) > 0 {\n352|\t\t\twinner = candidate\n353|\t\t}\n354|\t}\n355|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n356|\tif err != nil {\n357|\t\treturn validatedLease{}, err\n358|\t}\n359|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo); err != nil {\n360|\t\treturn validatedLease{}, err\n361|\t}\n362|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {\n363|\t\treturn validatedLease{}, err\n364|\t}\n365|\treturn winner, nil\n366|}\n367|\n368|// checkLeaseChain validates the winner's predecessor ancestry within\n369|// the admitted records for its session. Section 5.3 requires every\n370|// epoch above 1 to name a known predecessor for the same session\n371|// with an epoch exactly one below, down to an epoch-1 root with a\n372|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n373|// lease naming any predecessor is malformed. A self, cyclic,\n374|// skipped, contradictory, or duplicated link is malformed authority\n375|// (integrity failure); a missing predecessor name or record is\n376|// incomplete authority (observation_unavailable). Epochs strictly\n377|// decrease along the walk, so the walk always terminates. It\n378|// returns the winning ancestry from the winner down to the epoch-1\n379|// root, plus the winner's direct predecessor, or the zero lease at\n380|// epoch 1.\n381|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n382|\tbyLease := make(map[string]validatedLease, len(candidates))\n383|\tfor _, candidate := range candidates {\n384|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n385|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n386|\t\t}\n387|\t\tbyLease[candidate.LeaseID] = candidate\n388|\t}\n389|\tvar predecessor validatedLease\n390|\tvar chain []validatedLease\n391|\tcurrent := winner\n392|\tfor {\n393|\t\tchain = append(chain, current)\n394|\t\tif current.Epoch == 1 {\n395|\t\t\tif current.HasPredecessor {\n396|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n397|\t\t\t}\n398|\t\t\treturn chain, predecessor, nil\n399|\t\t}\n400|\t\tif !current.HasPredecessor {\n401|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n402|\t\t}\n403|\t\tparent, ok := byLease[current.Predecessor]\n404|\t\tif !ok {\n405|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n406|\t\t}\n407|\t\tif parent.Epoch+1 != current.Epoch {\n408|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n409|\t\t}\n410|\t\tif current.LeaseID == winner.LeaseID {\n411|\t\t\tpredecessor = parent\n412|\t\t}\n413|\t\tcurrent = parent\n414|\t}\n415|}\n416|\n417|// validatedCheckpointsByDigest validates every supplied Checkpoint\n418|// Record and indexes the admitted records by canonical digest.\n419|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n420|\tout := map[string]validatedCheckpoint{}\n421|\tif reader == nil {\n422|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n423|\t}\n424|\tfor _, raw := range reader.CheckpointRecords {\n425|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n426|\t\tif err != nil {\n427|\t\t\treturn nil, err\n428|\t\t}\n429|\t\tout[checkpoint.Digest] = checkpoint\n430|\t}\n431|\treturn out, nil\n432|}\n433|\n434|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n435|// against the admitted Checkpoint Records. Section 5.3 requires\n436|// every epoch above 1 to reference a validated checkpoint for its\n437|// session and predecessor lease; an epoch-1 root without a\n438|// predecessor may carry no checkpoint before the first provider\n439|// boundary exists. A non-null reference must resolve to an admitted\n440|// record for the same session bound to the lease it was taken\n441|// under: the predecessor for a successor, the winner itself at\n442|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n443|// unresolvable reference is incomplete authority\n444|// (observation_unavailable), never absence or a minted fact. The\n445|// admitted checkpoint must also resolve its event-head closure in\n446|// the winning source chain (repo); see checkCheckpointEventHeads.\n447|// The same closure must then admit its Section 2.4 profile\n448|// authority; see checkCheckpointProfileAuthority.\n449|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n450|\tif !winner.HasCheckpoint {\n451|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n452|\t\t\treturn nil\n453|\t\t}\n454|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n455|\t}\n456|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n457|\tif err != nil {\n458|\t\treturn err\n459|\t}\n460|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n461|\tif !ok {\n462|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n463|\t}\n464|\tif checkpoint.SessionID != winner.SessionID {\n465|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n466|\t}\n467|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n468|\tif winner.Epoch > 1 {\n469|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n470|\t}\n471|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n472|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n473|\t}\n474|\towner := winner\n475|\tif winner.Epoch > 1 {\n476|\t\towner = predecessor\n477|\t}\n478|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n479|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n480|\t}\n481|\tif err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {\n482|\t\treturn err\n483|\t}\n484|\tif err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {\n485|\t\treturn err\n486|\t}\n487|\tif err := checkCheckpointProfileAuthority(checkpoint, repo, checkpoints); err != nil {\n488|\t\treturn err\n489|\t}\n490|\treturn nil\n491|}\n492|\n493|// checkAncestorCheckpoints validates the checkpoint references of\n494|// every non-winner lease in the winning ancestry: Section 5.3\n495|// requires each epoch above 1 to reference a validated checkpoint\n496|// for its session and predecessor lease, and Section 5.4 requires\n497|// that checkpoint to be created by the owning lease holder. The\n498|// winner itself is covered by checkWinnerCheckpoint. Only the\n499|// winner's own ancestry is admitted: sibling branches off that\n500|// chain are never consulted, so legal branching is preserved. An\n501|// epoch-1 root without a reference stays admissible before the\n502|// first provider boundary exists; a reference it does carry must\n503|// resolve to a checkpoint bound to itself and created by its own\n504|// holder. An unresolvable reference or a binding to another\n505|// session, lease, or holder is incomplete authority\n506|// (observation_unavailable), never absence or a minted fact. Every\n507|// admitted ancestor checkpoint must also resolve its event-head\n508|// closure in the winning source chain (repo) and admit its Section\n509|// 2.4 profile authority over that closure.\n510|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n511|\tif len(chain) < 2 {\n512|\t\treturn nil\n513|\t}\n514|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n515|\tif err != nil {\n516|\t\treturn err\n517|\t}\n518|\tfor index := 1; index < len(chain); index++ {\n519|\t\tcurrent := chain[index]\n520|\t\tif current.Epoch == 1 {\n521|\t\t\tif !current.HasCheckpoint {\n522|\t\t\t\tcontinue\n523|\t\t\t}\n524|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo); err != nil {\n525|\t\t\t\treturn err\n526|\t\t\t}\n527|\t\t\tcontinue\n528|\t\t}\n529|\t\tif !current.HasCheckpoint {\n530|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n531|\t\t}\n532|\t\tif index+1 >= len(chain) {\n533|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n534|\t\t}\n535|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo); err != nil {\n536|\t\t\treturn err\n537|\t\t}\n538|\t}\n539|\treturn nil\n540|}\n541|\n542|// checkCheckpointBinding resolves one lease's checkpoint reference\n543|// against the admitted Checkpoint Records and validates its Section\n544|// 5.3 session and predecessor-lease binding with its Section 5.4\n545|// holder binding: the checkpoint must name this session and the\n546|// owning lease, and its creator must be that lease's holder. The\n547|// admitted checkpoint must also resolve its event-head closure in\n548|// the winning source chain (repo); see checkCheckpointEventHeads.\n549|// The same closure must then admit its Section 2.4 profile\n550|// authority; see checkCheckpointProfileAuthority.\n551|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository) error {\n552|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n553|\tif !ok {\n554|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n555|\t}\n556|\tif checkpoint.SessionID != current.SessionID {\n557|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n558|\t}\n559|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n560|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n561|\t}\n562|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n563|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n564|\t}\n565|\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n566|\t\treturn err\n567|\t}\n568|\tif err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {\n569|\t\treturn err\n570|\t}\n571|\tif err := checkCheckpointProfileAuthority(checkpoint, repo, checkpoints); err != nil {\n572|\t\treturn err\n573|\t}\n574|\treturn nil\n575|}\n576|\n577|// checkCheckpointEventHeads resolves every event head of one admitted\n578|// Checkpoint Record against the winning source chain for its session\n579|// (Section 5.4 event-head closure). Each head must name a chained\n580|// event for the same session at or before the owning lease: a head\n581|// naming an absent event (including a cross-session digest, a\n582|// losing-lease preserved blob outside the authoritative chain, or a\n583|// synthetic placeholder) is incomplete authority\n584|// (observation_unavailable), and a head under a later lease (a\n585|// greater epoch, or the same epoch under a different fencing token)\n586|// is likewise incomplete authority because the checkpoint cannot fix\n587|// authority over events that postdate it. Historical heads stay\n588|// admissible and are never required to equal the current tail, so\n589|// valid branching and lagging copies are preserved. A failed chain\n590|// read keeps its cause inside the same incomplete-authority refusal\n591|// instead of minting a fact, and a nil chain handle refuses the same\n592|// class rather than skipping the gate.\n593|func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {\n594|\tif repo == nil {\n595|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n596|\t}\n597|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n598|\tif err != nil {\n599|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n(more lines below)","final_result":true}}}
