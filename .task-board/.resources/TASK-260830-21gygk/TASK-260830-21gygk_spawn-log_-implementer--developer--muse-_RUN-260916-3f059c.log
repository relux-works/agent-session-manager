{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d46f","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":2194,"recorded_at":1780531400004383,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abcf-a517-7870-85ee-a3691d776414"},"task_id":"01a0abcf-a517-7870-85ee-a3691d776414","event":{"kind":"output","task_id":"01a0abcf-a517-7870-85ee-a3691d776414","chunk":"Read text file `internal/sessquery/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessquery/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each gate by narrowing, never by deletion: every N-\n6|mutant keeps its gate present and weakens it to admit exactly one member\n7|of the class the gate must reject, and a named behavioral test must fail.\n8|Grammar mutants preserve the searched-for token while changing behavior,\n9|and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessquery/query.go'\n30|base = source.read_text()\n31|selector_source = copy / 'internal/sessquery/selector.go'\n32|selector_base = selector_source.read_text()\n33|revalidate_source = copy / 'internal/sessquery/revalidate.go'\n34|revalidate_base = revalidate_source.read_text()\n35|plan_source = copy / 'internal/sessquery/plan.go'\n36|plan_base = plan_source.read_text()\n37|summary_source = copy / 'internal/sessquery/summary.go'\n38|summary_base = summary_source.read_text()\n39|lease_source = copy / 'internal/sessquery/lease.go'\n40|lease_base = lease_source.read_text()\n41|repo_source = copy / 'internal/sessrepo/store.go'\n42|repo_base = repo_source.read_text()\n43|results = []\n44|\n45|IDA = '0198f4c8-3e70-7a11-8a2b-1234567890ab'\n46|IDB = '0198f4c8-3e70-7a11-8a2b-1234567890ac'\n47|HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\n48|HOSTB = '0198f4c8-4a10-7b22-8b3c-1234567890ac'\n49|HOSTC = '0198f4c8-4a10-7b22-8b3c-1234567890ad'\n50|LEASEB = 'bbbbbbbb-cccc-4ddd-8eee-ffffffffffff'\n51|\n52|def run(name, path, old, new, narrow):\n53|    original = path.read_text()\n54|    if original.count(old) != 1:\n55|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n56|        return\n57|    path.write_text(original.replace(old, new))\n58|    command = ['go', 'test', './internal/sessquery', './internal/sessrepo', '-count=1', '-v']\n59|    try:\n60|        with (output / (name + '.log')).open('w') as log:\n(more lines below)","final_result":true}}}
