{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ed","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":593,"recorded_at":1780531400001181,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc4-21b1-7130-9650-eeb04e25cd38"},"task_id":"01a0abc4-21b1-7130-9650-eeb04e25cd38","event":{"kind":"output","task_id":"01a0abc4-21b1-7130-9650-eeb04e25cd38","chunk":"Read text file `internal/sessquery/lease.go`.\n(599 line(s) above)\n600|\t}\n601|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n602|\tfor _, summary := range events {\n603|\t\tbyID[summary.EventID] = summary\n604|\t}\n605|\tfor _, head := range checkpoint.EventHeads {\n606|\t\tsummary, ok := byID[head]\n607|\t\tif !ok {\n608|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)\n609|\t\t}\n610|\t\tif summary.LeaseEpoch > owner.Epoch {\n611|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)\n612|\t\t}\n613|\t\tif summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {\n614|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)\n615|\t\t}\n616|\t}\n617|\treturn nil\n618|}\n619|\n620|// checkCheckpointProfileAuthority admits the Section 2.4 effective\n621|// execution profile and its nullable source event for one required\n622|// checkpoint against the winning source chain (repo, SPEC 5.4\n623|// event-head closure). The transitive predecessor closure of the\n624|// checkpoint heads fixes the launch values: the Session Record\n625|// carries the creation profile, the first launch in the closure\n626|// carries that profile with a null source, and every later\n627|// provider/task-board launch carries the newest authoritative\n628|// profile.changed event at or before it with the profile it\n629|// targets (launches carry no checkpoint_id member, so the closure\n630|// under admission evaluated in lease/sequence order is their only\n631|// referenced authority). Every session resume instead carries the\n632|// effective pair of ITS referenced checkpoint (SPEC 5.2),\n633|// resolved through the admitted Checkpoint Records (checkpoints)\n634|// and derived from that checkpoint's own event-head closure, never\n635|// from the position in the outer walk. Every fork carries the\n636|// newly persisted Session Record profile with a null source (SPEC\n637|// 2.4/5.2 new-session authority); only its source_profile_event_id\n638|// provenance stays outside this closure. A non-null source must\n639|// name a chained profile.changed event inside the governing\n640|// closure; a missing (dangling, cross-session, or preserved\n641|// outside the authoritative index), out-of-closure (later\n642|// local-only or losing-lease), wrong-type, or non-newest reference\n643|// is contradictory authority (integrity failure), as is a pair\n644|// whose profile value does not equal the derived effective\n645|// profile — consumers MUST NOT consult a later local-only event or\n646|// fall back to the creation value. Historical heads stay admissible\n647|// because derivation reads only closures, never the current tail.\n648|// A missing or misbound referenced checkpoint, an unresolvable\n649|// referenced head, a failed chain read, and a nil chain handle\n650|// refuse incomplete authority (observation_unavailable) with the\n651|// cause kept instead of minting a fact. Payloads are fetched only\n652|// for pair and change events in the closures; the index already\n653|// carries every other routing member the walk needs.\n654|func checkCheckpointProfileAuthority(checkpoint validatedCheckpoint, repo *sessrepo.Repository, checkpoints map[string]validatedCheckpoint) error {\n655|\tif repo == nil {\n656|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n657|\t}\n658|\trecordBytes, err := repo.GetRecord(checkpoint.SessionID)\n659|\tif err != nil {\n660|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n661|\t}\n662|\tcreation, recordID, err := sessionCreationProfile(checkpoint, recordBytes)\n663|\tif err != nil {\n664|\t\treturn err\n665|\t}\n666|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n667|\tif err != nil {\n668|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n669|\t}\n670|\tclosure, err := profileClosure(checkpoint, recordID, events)\n671|\tif err != nil {\n672|\t\treturn err\n673|\t}\n674|\treturn checkClosureProfilePairs(checkpoint, creation, recordID, events, closure, checkpoints, repo)\n675|}\n676|\n677|// sessionCreationProfile reads the immutable creation profile and\n678|// the canonical record digest from the winning-source Session\n679|// Record bytes. The closed shape owner requires execution_profile\n680|// standard|yolo, so any other value contradicts the admitted\n681|// record (integrity failure).\n682|func sessionCreationProfile(checkpoint validatedCheckpoint, recordBytes []byte) (string, string, error) {\n683|\tmembers, fault := environ.DecodeStrictObject(recordBytes)\n684|\tif fault != nil {\n685|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no decodable session record for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, fault)\n686|\t}\n687|\tcreation, err := leaseStringMember(members, \"execution_profile\")\n688|\tif err != nil || (creation != \"standard\" && creation != \"yolo\") {\n689|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid creation profile for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID)\n690|\t}\n691|\trecordID, err := leaseStringMember(members, \"record_id\")\n692|\tif err != nil {\n693|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid record digest for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID)\n694|\t}\n695|\tdigest, err := scalar.ParseDigest(recordID)\n696|\tif err != nil {\n697|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries malformed record digest %q for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, recordID)\n698|\t}\n699|\treturn creation, digest.String(), nil\n700|}\n701|\n702|// profileClosure resolves the transitive predecessor closure of the\n703|// checkpoint heads against the winning source chain index. The\n704|// genesis link names the Session Record digest rather than an\n705|// event; every other predecessor must name a chained event, so a\n706|// dangling reference contradicts the admitted closure (integrity\n707|// failure). Divergent blobs preserved outside the authoritative\n708|// index never enter the closure: index membership is authority.\n709|func profileClosure(checkpoint validatedCheckpoint, recordID string, events []sessrepo.EventSummary) (map[string]bool, error) {\n710|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n711|\tfor _, summary := range events {\n712|\t\tbyID[summary.EventID] = summary\n713|\t}\n714|\tclosure := make(map[string]bool, len(events))\n715|\tstack := append([]string(nil), checkpoint.EventHeads...)\n716|\tfor len(stack) > 0 {\n717|\t\tid := stack[len(stack)-1]\n718|\t\tstack = stack[:len(stack)-1]\n719|\t\tif closure[id] {\n720|\t\t\tcontinue\n721|\t\t}\n722|\t\tsummary, ok := byID[id]\n723|\t\tif !ok {\n724|\t\t\tif id == recordID {\n725|\t\t\t\tcontinue\n726|\t\t\t}\n727|\t\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile closure names unknown event %s for session %s\", sessstate.ErrIntegrity, checkpoint.Digest, id, checkpoint.SessionID)\n728|\t\t}\n729|\t\tclosure[id] = true\n730|\t\tstack = append(stack, summary.Predecessors...)\n731|\t}\n732|\treturn closure, nil\n733|}\n734|\n735|// profilePair is one decoded Section 2.4 pair from a launch or\n736|// resume event payload.\n737|type profilePair struct {\n738|\tprofile   string\n739|\tsource    string\n740|\thasSource bool\n741|}\n742|\n743|// eventProfilePair decodes the pair from one chained launch or\n744|// resume event. Chained bytes passed the closed payload shape at\n745|// append time, so a member that no longer decodes contradicts the\n746|// attested chain (integrity failure).\n747|func eventProfilePair(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (profilePair, error) {\n748|\tvar pair profilePair\n749|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n750|\tif err != nil {\n751|\t\treturn pair, err\n752|\t}\n753|\tprofile, err := leaseStringMember(payload, \"execution_profile\")\n754|\tif err != nil || (profile != \"standard\" && profile != \"yolo\") {\n755|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid execution profile for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)\n756|\t}\n757|\tsource, hasSource, err := leaseNullableDigest(payload, \"profile_source_event_id\")\n758|\tif err != nil {\n759|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid profile source for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, err)\n760|\t}\n761|\treturn profilePair{profile: profile, source: source, hasSource: hasSource}, nil\n762|}\n763|\n764|// eventProfileTarget decodes the target profile of one chained\n765|// profile.changed event. Only the target feeds the derivation: the\n766|// source value and the confirmation history belong to the\n767|// publication flow that admitted the event, never to this\n768|// admission.\n769|func eventProfileTarget(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (string, error) {\n770|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n771|\tif err != nil {\n772|\t\treturn \"\", err\n773|\t}\n774|\ttarget, err := leaseStringMember(payload, \"to\")\n775|\tif err != nil || (target != \"standard\" && target != \"yolo\") {\n776|\t\treturn \"\", fmt.Errorf(\"%w: session %s event %s carries no valid profile target for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)\n777|\t}\n778|\treturn target, nil\n779|}\n780|\n781|// eventPayloadMembers returns the decoded payload object of one\n782|// chained event. A failed blob read keeps its cause inside the\n783|// incomplete-authority refusal; bytes that no longer decode\n784|// contradict the attested chain.\n785|func eventPayloadMembers(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (map[string]json.RawMessage, error) {\n786|\traw, err := repo.GetEvent(checkpoint.SessionID, summary.EventID)\n787|\tif err != nil {\n788|\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n789|\t}\n790|\tmembers, fault := environ.DecodeStrictObject(raw)\n791|\tif fault != nil {\n792|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable event frame for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, fault)\n793|\t}\n794|\tpayloadRaw, ok := members[\"payload\"]\n795|\tif !ok || string(payloadRaw) == \"null\" {\n796|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no payload for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)\n797|\t}\n798|\tpayload, fault := environ.DecodeStrictObject([]byte(payloadRaw))\n799|\tif fault != nil {\n800|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable payload for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, fault)\n801|\t}\n802|\treturn payload, nil\n803|}\n804|\n805|// checkClosureProfilePairs walks the closure in authoritative chain\n806|// order and binds every launch, resume, and fork pair to its\n807|// Section 2.4 derivation: the first launch carries the creation\n808|// profile with a null source, and every later launch carries the\n809|// newest authoritative profile.changed event at or before it with\n810|// that change's target profile (the creation pair while no change\n811|// exists). Every resume carries the effective pair of its own\n812|// referenced checkpoint (referencedCheckpointProfile), never the\n813|// outer-walk prefix. Every fork carries the newly persisted\n814|// Session Record profile with a null source: the fork event lives\n815|// in the new session chain, so creation here is already the new\n816|// record; its source_profile_event_id provenance is never read.\n817|// Each pair mismatch, each unexpected or missing source, and each\n818|// source that fails the governing-closure resolution below refuses\n819|// integrity failure.\n820|func checkClosureProfilePairs(checkpoint validatedCheckpoint, creation, recordID string, events []sessrepo.EventSummary, closure map[string]bool, checkpoints map[string]validatedCheckpoint, repo *sessrepo.Repository) error {\n821|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n822|\tfor _, summary := range events {\n823|\t\tbyID[summary.EventID] = summary\n824|\t}\n825|\tnewestSource, newestProfile := \"\", \"\"\n826|\thasNewest := false\n827|\tfirstLaunch := true\n828|\tfor _, summary := range events {\n829|\t\tif !closure[summary.EventID] {\n830|\t\t\tcontinue\n831|\t\t}\n832|\t\tswitch summary.EventType {\n833|\t\tcase \"profile.changed\":\n834|\t\t\ttarget, err := eventProfileTarget(checkpoint, repo, summary)\n835|\t\t\tif err != nil {\n836|\t\t\t\treturn err\n837|\t\t\t}\n838|\t\t\tnewestSource, newestProfile, hasNewest = summary.EventID, target, true\n839|\t\tcase \"provider.launched\", \"task_board.launched\":\n840|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n841|\t\t\tif err != nil {\n842|\t\t\t\treturn err\n843|\t\t\t}\n844|\t\t\twantProfile, wantSource, wantHasSource := creation, \"\", false\n845|\t\t\tif !firstLaunch && hasNewest {\n846|\t\t\t\twantProfile, wantSource, wantHasSource = newestProfile, newestSource, true\n847|\t\t\t}\n848|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil {\n849|\t\t\t\treturn err\n850|\t\t\t}\n851|\t\t\tfirstLaunch = false\n852|\t\tcase \"session.resumed\":\n853|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n854|\t\t\tif err != nil {\n855|\t\t\t\treturn err\n856|\t\t\t}\n857|\t\t\twantProfile, wantSource, wantHasSource, refClosure, err := referencedCheckpointProfile(checkpoint, summary, creation, recordID, events, byID, checkpoints, repo)\n858|\t\t\tif err != nil {\n859|\t\t\t\treturn err\n860|\t\t\t}\n861|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, refClosure); err != nil {\n862|\t\t\t\treturn err\n863|\t\t\t}\n864|\t\tcase \"fork.created\":\n865|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n866|\t\t\tif err != nil {\n867|\t\t\t\treturn err\n868|\t\t\t}\n869|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, creation, \"\", false, byID, closure); err != nil {\n870|\t\t\t\treturn err\n871|\t\t\t}\n872|\t\t}\n873|\t}\n874|\treturn nil\n875|}\n876|\n877|// referencedCheckpointProfile derives the Section 2.4 effective\n878|// pair one session.resumed event must carry (SPEC 5.2): the newest\n879|// authoritative profile.changed event in its referenced\n880|// checkpoint's own event-head closure with that change's target\n881|// profile, or the creation pair while that closure holds no\n882|// change. The checkpoint_id member resolves through the admitted\n883|// Checkpoint Records; the closure walks the same winning-source\n884|// chain index, so a later local-only change outside the referenced\n885|// heads is never consulted and branching history stays admissible.\n886|// A missing or wrong-session reference, or a referenced head that\n887|// names no chained event, is incomplete referenced authority\n888|// (observation_unavailable); a dangling predecessor inside the\n889|// referenced closure or a pair the closure contradicts refuses\n890|// integrity failure. Read failures keep their cause inside the\n891|// incomplete-authority refusal.\n892|func referencedCheckpointProfile(checkpoint validatedCheckpoint, summary sessrepo.EventSummary, creation, recordID string, events []sessrepo.EventSummary, byID map[string]sessrepo.EventSummary, checkpoints map[string]validatedCheckpoint, repo *sessrepo.Repository) (string, string, bool, map[string]bool, error) {\n893|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n894|\tif err != nil {\n895|\t\treturn \"\", \"\", false, nil, err\n896|\t}\n897|\trawID, err := leaseStringMember(payload, \"checkpoint_id\")\n898|\tif err != nil {\n899|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: session %s event %s carries no valid resume checkpoint for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, err)\n900|\t}\n901|\treference, err := scalar.ParseDigest(rawID)\n902|\tif err != nil {\n903|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: session %s event %s carries malformed resume checkpoint %q for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, rawID)\n904|\t}\n905|\tcheckpointID := reference.String()\n906|\tref, ok := checkpoints[checkpointID]\n907|\tif !ok {\n908|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, checkpointID, checkpoint.SessionID)\n909|\t}\n910|\tif ref.SessionID != checkpoint.SessionID {\n911|\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, checkpointID, ref.SessionID, checkpoint.SessionID)\n912|\t}\n913|\tfor _, head := range ref.EventHeads {\n914|\t\tif _, ok := byID[head]; !ok {\n915|\t\t\treturn \"\", \"\", false, nil, fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpointID, head, checkpoint.SessionID)\n916|\t\t}\n917|\t}\n918|\trefClosure, err := profileClosure(ref, recordID, events)\n919|\tif err != nil {\n920|\t\treturn \"\", \"\", false, nil, err\n921|\t}\n922|\trefSource, refProfile := \"\", \"\"\n923|\trefHas := false\n924|\tfor _, candidate := range events {\n925|\t\tif !refClosure[candidate.EventID] {\n926|\t\t\tcontinue\n927|\t\t}\n928|\t\tif candidate.EventType != \"profile.changed\" {\n929|\t\t\tcontinue\n930|\t\t}\n931|\t\ttarget, err := eventProfileTarget(checkpoint, repo, candidate)\n932|\t\tif err != nil {\n933|\t\t\treturn \"\", \"\", false, nil, err\n934|\t\t}\n935|\t\trefSource, refProfile, refHas = candidate.EventID, target, true\n936|\t}\n937|\tif !refHas {\n938|\t\treturn creation, \"\", false, refClosure, nil\n939|\t}\n940|\treturn refProfile, refSource, true, refClosure, nil\n941|}\n942|\n943|// checkProfilePairSource binds one decoded pair to its derived\n944|// expectation. The profile value must equal the derived effective\n945|// profile, so falling back to the creation value past a change\n946|// refuses; the source presence must match, so a first launch with\n947|// any source refuses; and a present source must resolve to the\n948|// newest authoritative profile.changed event in the closure —\n949|// missing, out-of-closure (later local-only or losing-lease),\n950|// wrong-type, and non-newest references each refuse with the\n951|// violated expectation named.\n952|func checkProfilePairSource(checkpoint validatedCheckpoint, summary sessrepo.EventSummary, pair profilePair, wantProfile, wantSource string, wantHasSource bool, byID map[string]sessrepo.EventSummary, closure map[string]bool) error {\n953|\tif pair.profile != wantProfile {\n954|\t\treturn fmt.Errorf(\"%w: session %s event %s carries execution profile %q, want effective profile %q for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.profile, wantProfile)\n955|\t}\n956|\tif pair.hasSource != wantHasSource {\n957|\t\tif pair.hasSource {\n958|\t\t\treturn fmt.Errorf(\"%w: session %s event %s carries profile source %s, want no profile source for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)\n959|\t\t}\n960|\t\treturn fmt.Errorf(\"%w: session %s event %s carries no profile source, want newest authoritative source %s for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, wantSource)\n961|\t}\n962|\tif !wantHasSource {\n963|\t\treturn nil\n964|\t}\n965|\tsourced, ok := byID[pair.source]\n966|\tif !ok {\n967|\t\treturn fmt.Errorf(\"%w: session %s event %s names unknown profile source %s for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)\n968|\t}\n969|\tif !closure[pair.source] {\n970|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s outside the checkpoint closure for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)\n971|\t}\n972|\tif sourced.EventType != \"profile.changed\" {\n973|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s of type %q, want a profile.changed event for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, sourced.EventType)\n974|\t}\n975|\tif pair.source != wantSource {\n976|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s, want newest authoritative source %s for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, wantSource)\n977|\t}\n978|\treturn nil\n979|}\n980|\n981|// checkCheckpointPersistence binds an admitted Checkpoint Record to\n982|// the persistence variant the referenced Session Record selects\n983|// (Section 5.4): a direct session requires a non-null\n984|// provider_manifest_id with a null task_board_bundle_id, while a\n985|// task_board session requires the reverse. Canonical shape proves\n986|// exactly one variant is present but cannot select which one is\n987|// valid, so a swapped variant keeps canonical identity, session,\n988|// lease, epoch, and creator yet refuses here with incomplete\n989|// authority (observation_unavailable), never absence or a minted\n990|// fact. An unknown session kind is malformed configuration: valid\n991|// Session Records admit only the two kinds.\n992|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n993|\tswitch sessionKind {\n994|\tcase \"direct\":\n995|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n996|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n997|\t\t}\n998|\t\treturn nil\n999|\tcase \"task_board\":\n1000|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n1001|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n1002|\t\t}\n1003|\t\treturn nil\n1004|\tdefault:\n1005|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n1006|\t}\n1007|}\n1008|\n1009|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n1010|// greatest epoch wins, ties break by bytewise lease-ID order.\n1011|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n1012|\treturn sessstate.Compare(\n1013|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n1014|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n1015|\t)\n1016|}","final_result":true}}}
