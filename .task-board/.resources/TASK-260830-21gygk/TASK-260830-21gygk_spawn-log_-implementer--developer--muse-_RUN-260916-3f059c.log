se, err := reader.winningLeaseFor(selected.SessionID, projection.Kind, selected.repo)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n279|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n280|\t}\n281|\tif projection.OwnerHostID != lease.HolderHostID {\n282|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, selected.SessionID)\n283|\t}\n284|\tplan := SelectionPlan{\n285|\t\tSelectorVersion:     SelectorVersion,\n286|\t\tSelector:            parsed.Raw,\n287|\t\tSessionID:           selected.SessionID,\n288|\t\tSessionRecordID:     recordID,\n289|\t\tSourceIndexDigest:   index,\n290|\t\tConfigurationDigest: configuration,\n291|\t\tLeaseRecordID:       lease.Digest,\n292|\t\tLeaseEpoch:          lease.Epoch,\n293|\t\tLeaseID:             lease.LeaseID,\n294|\t\tOwnerHostID:         lease.HolderHostID,\n295|\t\tAction:              action,\n296|\t\tDestinationHostID:   destination,\n297|\t\tExpectationDigest:   expectations,\n298|\t}\n299|\tif selected.PeerHostID == \"\" {\n300|\t\tif config.localHost == \"\" {\n301|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n302|\t\t}\n303|\t\tplan.SourceHostID = config.localHost\n304|\t} else {\n305|\t\tplan.SourceHostID = selected.PeerHostID\n306|\t\t// Null marks the local source only. An alias-less peer binds\n307|\t\t// empty: the host still distinguishes it from local.\n308|\t\talias := config.aliasFor(selected.PeerHostID)\n309|\t\taliasCopy := alias\n310|\t\tplan.SourceAlias = &aliasCopy\n311|\t}\n312|\t// The union check consults record, tombstone, and winner facts\n313|\t// only, never heads; heads are bound after the union validates.\n314|\tplan.AuthorityHeads = []string{}\n315|\tif err := reader.validate