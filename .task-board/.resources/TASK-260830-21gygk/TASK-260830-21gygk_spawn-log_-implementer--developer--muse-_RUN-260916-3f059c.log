d.\n268|func TestRev8ProfileSourceRefusals(t *testing.T) {\n269|\tbuilders := map[string]func(t *testing.T) *Reader{\n270|\t\t\"wrong_type\": func(t *testing.T) *Reader {\n271|\t\t\tlocal, _ := repository(t)\n272|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n273|\t\t\tif err != nil {\n274|\t\t\t\tt.Fatal(err)\n275|\t\t\t}\n276|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n277|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n278|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n279|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", created))\n280|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n281|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n282|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n283|\t\t\twithCheckpoints(r, cp)\n284|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n285|\t\t\treturn r\n286|\t\t},\n287|\t\t\"non_newest\": func(t *testing.T) *Reader {\n288|\t\t\tlocal, _ := repository(t)\n289|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n290|\t\t\tif err != nil {\n291|\t\t\t\tt.Fatal(err)\n292|\t\t\t}\n293|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n294|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n295|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n296|\t\t\tchanged2 := appendEvent(t, local, idA, changed, \"profile.changed\", 4, rev8ChangedPayload(\"standard\", \"yolo\"))\n297|\t\t\tlaunched2 := appendEvent(t, local, idA, changed2, \"provider.launched\", 5, rev8LaunchPayload(\"standard\", changed))\n298|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 6, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n299|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n300|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n301|\t\t\twithCheckpoints(r, cp)\n302|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n303|\t\t\treturn r\n304|\t\t},\n305|\t\t\"stale_value\": func(t *testing.T) *Reader {\n306|\t\t\tlocal, _ := repository(t)\n307|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n308|\t\t\tif err != nil {\n309|\t\t\t\tt.Fatal(err)\n310|\t\t\t}\n311|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n312|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n313|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n314|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"yolo\", changed))\n315|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_