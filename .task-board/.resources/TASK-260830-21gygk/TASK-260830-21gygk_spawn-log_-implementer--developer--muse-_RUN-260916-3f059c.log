{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d20d","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":1889,"recorded_at":1780531400003773,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abcc-67ab-72b2-bf74-610297054a07"},"task_id":"01a0abcc-67ab-72b2-bf74-610297054a07","event":{"kind":"output","task_id":"01a0abcc-67ab-72b2-bf74-610297054a07","chunk":"Read text file `internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, the complete authority\n10|// union for the pinned session across the remaining allowed sources,\n11|// authority heads, and the source index digest.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n27|const uint53Ceiling = uint64(1<<53 - 1)\n28|\n29|// Revalidate compares every bound plan fact against current\n30|// configuration and freshly reread source data, then validates the\n31|// complete authority union for the pinned session UUID across the\n32|// remaining allowed sources. The session is located by its UUID in\n33|// each source, never re-resolved by name. A nil return means the plan\n34|// is current; any error classifies exactly: selector_plan_stale (with\n35|// the first diverged member named), integrity_failure on contradictory\n36|// cross-source immutable records, peer_not_allowlisted on explicit\n37|// authorization revocation, invalid_config on current configuration\n38|// failures, invalid_arguments on a malformed caller plan, and the read\n39|// or projection failure class when a required read or validation\n40|// fails.\n41|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n42|\tif err := checkPlanShapes(plan); err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif reader == nil || reader.Local == nil {\n46|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n47|\t}\n48|\tconfig, err := reader.validatedConfiguration()\n49|\tif err != nil {\n50|\t\treturn err\n51|\t}\n52|\tpeerHost, isPeer := planSourceBinding(plan, config)\n53|\tif isPeer {\n54|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n55|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n56|\t\t}\n57|\t}\n58|\tif !bindingHolds(plan, config, reader) {\n59|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n60|\t}\n61|\tconfiguration, err := fingerprintConfiguration(reader, config)\n62|\tif err != nil {\n63|\t\treturn err\n64|\t}\n65|\tif configuration != plan.ConfigurationDigest {\n66|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n67|\t}\n68|\tvar repo = reader.Local\n69|\tsourcePeer := \"\"\n70|\tif isPeer {\n71|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n72|\t\tif err != nil {\n73|\t\t\treturn err\n74|\t\t}\n75|\t}\n76|\trows, err := reader.readSource(repo, sourcePeer)\n77|\tif err != nil {\n78|\t\treturn err\n79|\t}\n80|\tvar recordID string\n81|\tabsent := true\n82|\tfor _, row := range rows {\n83|\t\tif row.Projection.SessionID == plan.SessionID {\n84|\t\t\trecordID, absent = row.Projection.RecordID, false\n85|\t\t\tbreak\n86|\t\t}\n87|\t}\n88|\tif absent {\n89|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n90|\t}\n91|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n92|\tif err != nil {\n93|\t\treturn err\n94|\t}\n95|\tif recordID != plan.SessionRecordID {\n96|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n97|\t}\n98|\tif projection.Winner.IsZero() {\n99|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n100|\t}\n101|\tlease, err := reader.winningLeaseFor(plan.SessionID, projection.Kind, repo)\n102|\tif err != nil {\n103|\t\treturn err\n104|\t}\n105|\tif lease.Digest != plan.LeaseRecordID || lease.Epoch != plan.LeaseEpoch || lease.LeaseID != plan.LeaseID || lease.HolderHostID != plan.OwnerHostID {\n106|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n107|\t}\n108|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID {\n109|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n110|\t}\n111|\tif projection.OwnerHostID != lease.HolderHostID {\n112|\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, plan.SessionID)\n113|\t}\n114|\t// The union reports specific lease and tombstone divergence before\n115|\t// the generic head and index comparisons: heads include union tails,\n116|\t// so a union change would otherwise mask as a head change.\n117|\tif err := reader.validateAuthorityUnion(plan, config, sourcePeer); err != nil {\n118|\t\treturn err\n119|\t}\n120|\theads, err := reader.collectAuthorityHeads(config, plan.SessionID, lease.Digest, sourcePeer)\n121|\tif err != nil {\n122|\t\treturn err\n123|\t}\n124|\tif !equalStrings(heads, plan.AuthorityHeads) {\n125|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n126|\t}\n127|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif index != plan.SourceIndexDigest {\n132|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n133|\t}\n134|\treturn nil\n135|}\n136|\n137|// validateAuthorityUnion validates the complete current authority for\n138|// the pinned session UUID across every allowed source except the\n139|// already validated plan source. The session is located by UUID in\n140|// each source; names are never re-resolved and no selection is\n141|// substituted. A non-parked copy carrying a disagreeing immutable\n142|// record digest is inconsistent authority (integrity_failure, the same\n143|// class Resolve reports for disagreeing copies). Authoritative\n144|// tombstone evidence or a greater observed winning lease (Section 5.3\n145|// greatest (epoch, lease_id) tuple) in another source invalidates the\n146|// live plan (selector_plan_stale); a lagging copy with a smaller tuple\n147|// is a preserved losing history and stays current, and an agreeing\n148|// replica stays current. A copy that observes no winning lease yet\n149|// cannot contradict the bound lease and is skipped for the lease\n150|// check, while its record digest still binds. A parked copy of the\n(more lines below)","final_result":true}}}
