ery.go:104:// LeaseRecords carries the validated winning-lease authority for plan\\ninternal/sessquery/query.go:114:// CheckpointRecords carries the validated checkpoint authority the\\ninternal/sessquery/query.go:124:type Reader struct {\\ninternal/sessquery/query.go:125:\\tLocal              *sessrepo.Repository\\ninternal/sessquery/query.go:128:\\tPeers              []PeerIndex\\ninternal/sessquery/query.go:130:\\tHostMetadata       map[string]HostMetadata\\ninternal/sessquery/query.go:131:\\tObservations       map[string]SessionObservations\\ninternal/sessquery/query.go:132:\\tLeaseRecords       [][]byte\\ninternal/sessquery/query.go:133:\\tCheckpointRecords  [][]byte\\ninternal/sessquery/query.go:153:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query.go:207:// InspectLocal reads one local ID, including a parked or tombstoned session.\\ninternal/sessquery/query.go:209:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query.go:252:\\tif reader == nil || reader.Local == nil {\\ninternal/sessquery/query.go:279:\\treadPeers := func() ([]candidate, error) {\\ninternal/sessquery/query.go:291:\\t\\tunion, err := readPeers()\\ninternal/sessquery/query.go:300:\\tunion, err := readPeers()\\ninternal/sessquery/query.go:393:\\tfor _, peer := range reader.Peers {\\ninternal/sessquery/query.go:410:\\tfor _, peer := range reader.Peers {\\ninternal/sessquery/query.go:429:// readSource completes one source read. Local I-O failures keep their\\ninternal/sessquery/query.go:545:\\t\\tfor _, peer := range reader.Peers {\\ninternal/sessquery/resolve_test.go:38:\\t\\tPeers:              []PeerIndex{{hostA, peer}},\\ninternal/sessquery/resolve_test.go:168:\\t// Local needs no allowlist entry and survives revocation.\\ninternal/sessquery/resolve_test.go:189:\\treader.Peers = []PeerIndex{{hostA, nil}}\\ninternal/sessquery/resolve_test.go:195:\\treader.Peers = nil\\ninternal/sessquery/resolve_test.go:199:\\treader.Peers = []PeerIndex{{hostA, peer}}\\ni