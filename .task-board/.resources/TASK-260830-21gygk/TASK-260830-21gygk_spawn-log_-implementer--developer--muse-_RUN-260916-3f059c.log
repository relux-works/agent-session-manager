{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c933","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":756,"recorded_at":1780531400001507,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc4-92b0-7090-a92d-a4f432e0753f"},"task_id":"01a0abc4-92b0-7090-a92d-a4f432e0753f","event":{"kind":"output","task_id":"01a0abc4-92b0-7090-a92d-a4f432e0753f","chunk":"Read text file `internal/sessquery/plan.go`.\n(196 line(s) above)\n197|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n198|\tparsed, err := ParseSelector(args.Selector)\n199|\tif err != nil {\n200|\t\treturn SelectionPlan{}, err\n201|\t}\n202|\tif reader == nil || reader.Local == nil {\n203|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n204|\t}\n205|\tconfig, err := reader.validatedConfiguration()\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tif _, ok := BoundariesFor(args.Action); !ok {\n210|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n211|\t}\n212|\tvar destination *string\n213|\tif args.Destination != \"\" {\n214|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n215|\t\tif err != nil {\n216|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n217|\t\t}\n218|\t\tvalue := id.String()\n219|\t\tdestination = &value\n220|\t}\n221|\texpectations, err := fingerprintExpectations(args.Expectations)\n222|\tif err != nil {\n223|\t\treturn SelectionPlan{}, err\n224|\t}\n225|\tvar selected Selection\n226|\tif parsed.Source != SourceBare {\n227|\t\tselected, err = reader.resolveExplicit(parsed, config)\n228|\t} else {\n229|\t\tselected, err = reader.resolveBare(parsed, config)\n230|\t}\n231|\tif err != nil {\n232|\t\treturn SelectionPlan{}, err\n233|\t}\n234|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n235|}\n236|\n237|// bindPlan reads the winning source completely and binds every plan\n238|// member from validated current facts. The session is located by its\n239|// UUID in the winning source only, never re-resolved by name. Lease\n240|// authority comes from the admitted winning Lease Record for that\n241|// UUID; the envelope winner on the selected chain must agree with it,\n242|// and the union winner across all allowed sources must not exceed it.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tlease, err := reader.winningLeaseFor(selected.SessionID, projection.Kind, selected.repo)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n279|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n280|\t}\n281|\tif projection.OwnerHostID != lease.HolderHostID {\n282|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, selected.SessionID)\n283|\t}\n284|\tplan := SelectionPlan{\n285|\t\tSelectorVersion:     SelectorVersion,\n286|\t\tSelector:            parsed.Raw,\n287|\t\tSessionID:           selected.SessionID,\n288|\t\tSessionRecordID:     recordID,\n289|\t\tSourceIndexDigest:   index,\n290|\t\tConfigurationDigest: configuration,\n291|\t\tLeaseRecordID:       lease.Digest,\n292|\t\tLeaseEpoch:          lease.Epoch,\n293|\t\tLeaseID:             lease.LeaseID,\n294|\t\tOwnerHostID:         lease.HolderHostID,\n295|\t\tAction:              action,\n296|\t\tDestinationHostID:   destination,\n297|\t\tExpectationDigest:   expectations,\n298|\t}\n299|\tif selected.PeerHostID == \"\" {\n300|\t\tif config.localHost == \"\" {\n301|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n302|\t\t}\n303|\t\tplan.SourceHostID = config.localHost\n304|\t} else {\n305|\t\tplan.SourceHostID = selected.PeerHostID\n306|\t\t// Null marks the local source only. An alias-less peer binds\n307|\t\t// empty: the host still distinguishes it from local.\n308|\t\talias := config.aliasFor(selected.PeerHostID)\n309|\t\taliasCopy := alias\n310|\t\tplan.SourceAlias = &aliasCopy\n311|\t}\n312|\t// The union check consults record, tombstone, and winner facts\n313|\t// only, never heads; heads are bound after the union validates.\n314|\tplan.AuthorityHeads = []string{}\n315|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\theads, err := reader.collectAuthorityHeads(config, selected.SessionID, lease.Digest, selected.PeerHostID)\n319|\tif err != nil {\n320|\t\treturn SelectionPlan{}, err\n321|\t}\n322|\tplan.AuthorityHeads = heads\n323|\tif err := checkPlanShapes(plan); err != nil {\n324|\t\treturn SelectionPlan{}, err\n325|\t}\n326|\treturn plan, nil\n327|}\n328|\n329|// chainTail returns the tail event digest of a validated session chain,\n330|// or empty when the chain carries no events yet.\n331|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n332|\tevents, err := repo.ListEvents(sessionID)\n333|\tif err != nil {\n334|\t\treturn \"\", err\n335|\t}\n336|\tif len(events) == 0 {\n337|\t\treturn \"\", nil\n338|\t}\n339|\treturn events[len(events)-1].EventID, nil\n340|}","final_result":true}}}
