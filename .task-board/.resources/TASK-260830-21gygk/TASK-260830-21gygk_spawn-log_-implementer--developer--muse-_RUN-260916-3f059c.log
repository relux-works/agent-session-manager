{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dc65","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":3213,"recorded_at":1780531400006421,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"call_id":"call_01a0abed9e4d75878a7b977f16a8dd32","text":"{\n  \"chunk_id\": \"exec-84-1\",\n  \"command\": \"task-board resource --help 2>&1 | head -n 60\\necho ===ADD-HELP===; task-board resource add --help 2>&1 | head -n 80\",\n  \"description\": \"Check resource attach usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board resource [command] --help\\\" for more information about a command.\\n===ADD-HELP===\\nAttach a new file resource to a board element.\\n\\nSOURCE may be:\\n  - a local filesystem path\\n  - a file:// URL\\n  - an http:// or https:// URL\\n\\nExamples:\\n  task-board resource add TASK-260311-abc ./screenshot.png --type precondition\\n  task-board resource add TASK-260311-abc file:///tmp/report.pdf --name ui-report.pdf\\n  task-board resource add TASK-260311-abc ./report.md --name reports/review/report.md\\n  task-board resource add TASK-260311-abc https://example.com/spec.pdf --type outcome\\n\\nUsage:\\n  task-board resource add <ELEMENT-ID> <SOURCE> [flags]\\n\\nFlags:\\n  -d, --description string   Optional one-line description\\n  -h, --help                 help for add\\n      --name string          Override stored resource filename\\n      --type string          Resource type: precondition or outcome (default \\\"outcome\\\")\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2944,\n  \"original_output_tokens\": 736,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
