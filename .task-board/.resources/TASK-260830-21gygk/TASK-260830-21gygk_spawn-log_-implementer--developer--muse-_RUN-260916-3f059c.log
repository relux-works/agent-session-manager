{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca81","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":923,"recorded_at":1780531400001841,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc5-5cb9-73e0-9857-b8376deb8d10"},"task_id":"01a0abc5-5cb9-73e0-9857-b8376deb8d10","event":{"kind":"output","task_id":"01a0abc5-5cb9-73e0-9857-b8376deb8d10","chunk":"Read text file `internal/sessquery/rev8_regression_test.go`.\n1|// Checkpoint profile-authority regression tests for\n2|// TASK-260830-21gygk (SPEC 5.4 event-head closure plus referenced\n3|// 2.4 and 5.2, CR8 P1): every required checkpoint in the winning\n4|// ancestry must admit its transitive event-head closure as Section\n5|// 2.4 profile authority. The first launch carries the Session Record\n6|// creation profile with a null source; every later launch, resume,\n7|// or fork event carries the newest authoritative profile.changed\n8|// event at or before it, and no consumer consults a later\n9|// local-only event or falls back to the creation value. Every case\n10|// drives the four shared production entries (BuildPlan, Revalidate\n11|// fresh and old-plan, AuthoritativeStatus, AuthoritativeList),\n12|// never the validators directly. The rev8 fixture is ported from\n13|// the CR8 independent reviewer regression.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"errors\"\n19|\t\"fmt\"\n20|\t\"testing\"\n21|\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// leaseLoser is a second epoch-1 fencing token: events under it\n27|// diverge from the chain head lease, so the repository preserves\n28|// their blobs without indexing them (losing-lease branch).\n29|const leaseLoser = \"cccccccc-dddd-4eee-8fff-111111111111\"\n30|\n31|func rev8ProfileFixture(t *testing.T, kind string, ancestor bool, bad bool) (*Reader, string) {\n32|\tt.Helper()\n33|\tlocal, _ := repository(t)\n34|\traw := record(t, idA, \"alpha\")\n35|\tif kind == \"task_board\" {\n36|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n37|\t}\n38|\tref, err := local.CreateSession(raw)\n39|\tif err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n43|\tvar source any\n44|\tif bad {\n45|\t\tsource = zeroDigest\n46|\t}\n47|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": source, \"profile_mapping\": \"default\"})\n48|\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n49|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n50|\tif kind == \"task_board\" {\n51|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n52|\t}\n53|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n54|\tr := &Reader{Local: local, LocalHostID: hostA}\n55|\twithCheckpoints(r, cp)\n56|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n57|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 4, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n58|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n59|\tif ancestor {\n60|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n61|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n62|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n63|\t\tif kind == \"task_board\" {\n64|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n65|\t\t}\n66|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n67|\t\twithCheckpoints(r, cp2)\n68|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n69|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n70|\t}\n71|\treturn r, tail\n72|}\n73|\n74|func TestRev8CheckpointProfileAuthority(t *testing.T) {\n75|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n76|\t\tfor _, ancestor := range []bool{false, true} {\n77|\t\t\tfor _, bad := range []bool{false, true} {\n78|\t\t\t\tt.Run(fmt.Sprintf(\"%s/ancestor=%t/missing_source=%t\", kind, ancestor, bad), func(t *testing.T) {\n79|\t\t\t\t\tr, _ := rev8ProfileFixture(t, kind, ancestor, bad)\n80|\t\t\t\t\trev7CheckEntries(t, r, bad)\n81|\t\t\t\t})\n82|\t\t\t}\n83|\t\t}\n84|\t}\n85|}\n86|\n87|// rev8LaunchPayload builds one provider.launched payload carrying\n88|// the given Section 2.4 pair. A nil source renders the required\n89|// null for the creation pair.\n90|func rev8LaunchPayload(profile string, source any) map[string]any {\n91|\treturn map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": profile, \"profile_source_event_id\": source, \"profile_mapping\": \"default\"}\n92|}\n93|\n94|// rev8ChangedPayload builds one authoritative profile.changed\n95|// payload moving from one profile to the other.\n96|func rev8ChangedPayload(from, to string) map[string]any {\n97|\treturn map[string]any{\"from\": from, \"to\": to, \"confirmed\": true}\n98|}\n99|\n100|// rev8ChangeFixture builds a session whose closure carries a real\n101|// authoritative change: created(1) -> launch(2, yolo/null) ->\n102|// E1(3, yolo->standard) -> launch2(4, standard/E1) -> idle(5) with\n103|// the checkpoint over idle, then the epoch-2 transfer. The ancestor\n104|// variant extends the winning ancestry with a second launch under\n105|// the successor lease that still cites E1. Both closures derive\n106|// (standard, E1) with no fallback to the creation value.\n107|func rev8ChangeFixture(t *testing.T, kind string, ancestor bool) *Reader {\n108|\tt.Helper()\n109|\tlocal, _ := repository(t)\n110|\traw := record(t, idA, \"alpha\")\n111|\tif kind == \"task_board\" {\n112|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n113|\t}\n114|\tref, err := local.CreateSession(raw)\n115|\tif err != nil {\n116|\t\tt.Fatal(err)\n117|\t}\n118|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n119|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n120|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n121|\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", changed))\n122|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n123|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n124|\tif kind == \"task_board\" {\n125|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n126|\t}\n127|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n128|\tr := &Reader{Local: local, LocalHostID: hostA}\n129|\twithCheckpoints(r, cp)\n130|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n131|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n132|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n133|\tif ancestor {\n134|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, rev8LaunchPayload(\"standard\", changed))\n135|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n136|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n137|\t\tif kind == \"task_board\" {\n138|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n139|\t\t}\n140|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n141|\t\twithCheckpoints(r, cp2)\n142|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n143|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n144|\t}\n145|\t_ = tail\n146|\treturn r\n147|}\n148|\n149|// rev8CheckIntegrityRefusal drives the four shared production\n150|// entries and requires each to refuse with integrity failure: the\n151|// profile gate contradicts corrupt history, it never reports it\n152|// merely unavailable.\n153|func rev8CheckIntegrityRefusal(t *testing.T, r *Reader) {\n154|\tt.Helper()\n155|\tmetadata := summaryReader(t)\n156|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n157|\tstamp := \"2026-08-19T04:09:30.000Z\"\n158|\tobservation := r.Observations[idA]\n159|\tobservation.NewestCheckpointCreatedAt = &stamp\n160|\tr.Observations[idA] = observation\n161|\tplan, buildErr := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n162|\tif buildErr == nil {\n163|\t\tt.Fatalf(\"BuildPlan admitted corrupt profile authority; Revalidate=%v\", r.Revalidate(plan))\n164|\t}\n165|\tif !errors.Is(buildErr, sessstate.ErrIntegrity) {\n166|\t\tt.Errorf(\"BuildPlan refusal = %v, want integrity_failure\", buildErr)\n167|\t}\n168|\tif _, err := r.AuthoritativeStatus(\"alpha\"); err == nil {\n169|\t\tt.Error(\"AuthoritativeStatus admitted corrupt profile authority\")\n170|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n171|\t\tt.Errorf(\"AuthoritativeStatus refusal = %v, want integrity_failure\", err)\n172|\t}\n173|\tif _, err := r.AuthoritativeList(); err == nil {\n174|\t\tt.Error(\"AuthoritativeList admitted corrupt profile authority\")\n175|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n176|\t\tt.Errorf(\"AuthoritativeList refusal = %v, want integrity_failure\", err)\n177|\t}\n178|}\n179|\n180|func TestRev8ProfileChangedPositiveControl(t *testing.T) {\n181|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n182|\t\tfor _, ancestor := range []bool{false, true} {\n183|\t\t\tname := fmt.Sprintf(\"%s/ancestor=%t\", kind, ancestor)\n184|\t\t\tt.Run(name, func(t *testing.T) {\n185|\t\t\t\tr := rev8ChangeFixture(t, kind, ancestor)\n186|\t\t\t\trev7CheckEntries(t, r, false)\n187|\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n188|\t\t\t\tif err := r.Revalidate(old); err != nil {\n189|\t\t\t\t\tt.Errorf(\"fresh Revalidate refused valid profile authority: %v\", err)\n190|\t\t\t\t}\n191|\t\t\t})\n192|\t\t}\n193|\t}\n194|}\n195|\n196|// TestRev8ProfileResumePositiveControl proves a resume carries the\n197|// checkpoint effective pair instead of falling back to the\n198|// creation value: E1 moves the closure to standard, and the resume\n199|// from the E1 checkpoint carries (standard, E1). Both the admitting\n200|// checkpoint and the resume's referenced checkpoint are supplied,\n201|// because the resume expectation resolves through the referenced\n202|// record's own closure.\n203|func TestRev8ProfileResumePositiveControl(t *testing.T) {\n204|\tlocal, _ := repository(t)\n205|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n206|\tif err != nil {\n207|\t\tt.Fatal(err)\n208|\t}\n209|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n210|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n211|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n212|\tquiesced := appendEvent(t, local, idA, changed, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n213|\tcpA := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{quiesced}})\n214|\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", 5, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"kind\": \"manual\"})\n215|\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", 6, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n216|\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", 7, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"execution_profile\": \"standard\", \"profile_source_event_id\": changed, \"terminal_backend\": \"tmux\", \"native_session_id\": \"sess-1\"})\n217|\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 8, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n218|\tcpB := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n219|\tannouncedB := appendEvent(t, local, idA, idle, \"checkpoint.created\", 9, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpB), \"kind\": \"manual\"})\n220|\ttail := appendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n221|\tr := &Reader{Local: local, LocalHostID: hostA}\n222|\twithCheckpoints(r, cpB, cpA)\n223|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cpB)))\n224|\t_ = announced\n225|\t_ = tail\n226|\trev7CheckEntries(t, r, false)\n227|\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n228|\tif err := r.Revalidate(old); err != nil {\n229|\t\tt.Errorf(\"fresh Revalidate refused valid resume profile authority: %v\", err)\n230|\t}\n231|}\n232|\n233|// TestRev8ProfileTwoGenerationControl proves the derivation tracks\n234|// the newest change across generations: E2 supersedes E1, and the\n235|// later launch cites (yolo, E2).\n236|func TestRev8ProfileTwoGenerationControl(t *testing.T) {\n237|\tlocal, _ := repository(t)\n238|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n239|\tif err != nil {\n240|\t\tt.Fatal(err)\n241|\t}\n242|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n243|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n244|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n245|\tchanged2 := appendEvent(t, local, idA, changed, \"profile.changed\", 4, rev8ChangedPayload(\"standard\", \"yolo\"))\n246|\tlaunched2 := appendEvent(t, local, idA, changed2, \"provider.launched\", 5, rev8LaunchPayload(\"yolo\", changed2))\n247|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 6, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n248|\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n249|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 7, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n250|\t_ = announced\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca83","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":924,"recorded_at":1780531400001843,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"task_stream":{"kind":"task","id":"01a0abc5-5cb9-73e0-9857-b8376deb8d10"},"task_id":"01a0abc5-5cb9-73e0-9857-b8376deb8d10","event":{"kind":"completed","task_id":"01a0abc5-5cb9-73e0-9857-b8376deb8d10"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca85","stream":{"kind":"session","id":"01a0abc2-42f2-7250-afbe-0f50f97f1bdf"},"sequence":925,"recorded_at":1780531400001845,"record_type":"event","durability":"durable","causation_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad","run_stream":{"kind":"run","id":"e1f5c30b-1aa7-4c3a-b177-a44d7d5421ad"},"call_id":"call_01a0abc5580470a796d577b76056160f","text":"Read text file `internal/sessquery/rev8_regression_test.go`.\n1|// Checkpoint profile-authority regression tests for\n2|// TASK-260830-21gygk (SPEC 5.4 event-head closure plus referenced\n3|// 2.4 and 5.2, CR8 P1): every required checkpoint in the winning\n4|// ancestry must admit its transitive event-head closure as Section\n5|// 2.4 profile authority. The first launch carries the Session Record\n6|// creation profile with a null source; every later launch, resume,\n7|// or fork event carries the newest authoritative profile.changed\n8|// event at or before it, and no consumer consults a later\n9|// local-only event or falls back to the creation value. Every case\n10|// drives the four shared production entries (BuildPlan, Revalidate\n11|// fresh and old-plan, AuthoritativeStatus, AuthoritativeList),\n12|// never the validators directly. The rev8 fixture is ported from\n13|// the CR8 independent reviewer regression.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"errors\"\n19|\t\"fmt\"\n20|\t\"testing\"\n21|\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// leaseLoser is a second epoch-1 fencing token: events under it\n27|// diverge from the chain head lease, so the repository preserves\n28|// their blobs without indexing them (losing-lease branch).\n29|const leaseLoser = \"cccccccc-dddd-4eee-8fff-111111111111\"\n30|\n31|func rev8ProfileFixture(t *testing.T, kind string, ancestor bool, bad bool) (*Reader, string) {\n32|\tt.Helper()\n33|\tlocal, _ := repository(t)\n34|\traw := record(t, idA, \"alpha\")\n35|\tif kind == \"task_board\" {\n36|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n37|\t}\n38|\tref, err := local.CreateSession(raw)\n39|\tif err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n43|\tvar source any\n44|\tif bad {\n45|\t\tsource = zeroDigest\n46|\t}\n47|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": source, \"profile_mapping\": \"default\"})\n48|\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n49|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n50|\tif kind == \"task_board\" {\n51|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n52|\t}\n53|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n54|\tr := &Reader{Local: local, LocalHostID: hostA}\n55|\twithCheckpoints(r, cp)\n56|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n57|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 4, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n58|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n59|\tif ancestor {\n60|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n61|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n62|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n63|\t\tif kind == \"task_board\" {\n64|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n65|\t\t}\n66|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n67|\t\twithCheckpoints(r, cp2)\n68|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n69|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n70|\t}\n71|\treturn r, tail\n72|}\n73|\n74|func TestRev8CheckpointProfileAuthority(t *testing.T) {\n75|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n76|\t\tfor _, ancestor := range []bool{false, true} {\n77|\t\t\tfor _, bad := range []bool{false, true} {\n78|\t\t\t\tt.Run(fmt.Sprintf(\"%s/ancestor=%t/missing_source=%t\", kind, ancestor, bad), func(t *testing.T) {\n79|\t\t\t\t\tr, _ := rev8ProfileFixture(t, kind, ancestor, bad)\n80|\t\t\t\t\trev7CheckEntries(t, r, bad)\n81|\t\t\t\t})\n82|\t\t\t}\n83|\t\t}\n84|\t}\n85|}\n86|\n87|// rev8LaunchPayload builds one provider.launched payload carrying\n88|// the given Section 2.4 pair. A nil source renders the required\n89|// null for the creation pair.\n90|func rev8LaunchPayload(profile string, source any) map[string]any {\n91|\treturn map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": profile, \"profile_source_event_id\": source, \"profile_mapping\": \"default\"}\n92|}\n93|\n94|// rev8ChangedPayload builds one authoritative profile.changed\n95|// payload moving from one profile to the other.\n96|func rev8ChangedPayload(from, to string) map[string]any {\n97|\treturn map[string]any{\"from\": from, \"to\": to, \"confirmed\": true}\n98|}\n99|\n100|// rev8ChangeFixture builds a session whose closure carries a real\n101|// authoritative change: created(1) -> launch(2, yolo/null) ->\n102|// E1(3, yolo->standard) -> launch2(4, standard/E1) -> idle(5) with\n103|// the checkpoint over idle, then the epoch-2 transfer. The ancestor\n104|// variant extends the winning ancestry with a second launch under\n105|// the successor lease that still cites E1. Both closures derive\n106|// (standard, E1) with no fallback to the creation value.\n107|func rev8ChangeFixture(t *testing.T, kind string, ancestor bool) *Reader {\n108|\tt.Helper()\n109|\tlocal, _ := repository(t)\n110|\traw := record(t, idA, \"alpha\")\n111|\tif kind == \"task_board\" {\n112|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n113|\t}\n114|\tref, err := local.CreateSession(raw)\n115|\tif err != nil {\n116|\t\tt.Fatal(err)\n117|\t}\n118|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n119|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n120|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n121|\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", changed))\n122|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n123|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n124|\tif kind == \"task_board\" {\n125|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n126|\t}\n127|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n128|\tr := &Reader{Local: local, LocalHostID: hostA}\n129|\twithCheckpoints(r, cp)\n130|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n131|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n132|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n133|\tif ancestor {\n134|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, rev8LaunchPayload(\"standard\", changed))\n135|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n136|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n137|\t\tif kind == \"task_board\" {\n138|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n139|\t\t}\n140|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n141|\t\twithCheckpoints(r, cp2)\n142|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n143|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n144|\t}\n145|\t_ = tail\n146|\treturn r\n147|}\n148|\n149|// rev8CheckIntegrityRefusal drives the four shared production\n150|// entries and requires each to refuse with integrity failure: the\n151|// profile gate contradicts corrupt history, it never reports it\n152|// merely unavailable.\n153|func rev8CheckIntegrityRefusal(t *testing.T, r *Reader) {\n154|\tt.Helper()\n155|\tmetadata := summaryReader(t)\n156|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n157|\tstamp := \"2026-08-19T04:09:30.000Z\"\n158|\tobservation := r.Observations[idA]\n159|\tobservation.NewestCheckpointCreatedAt = &stamp\n160|\tr.Observations[idA] = observation\n161|\tplan, buildErr := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n162|\tif buildErr == nil {\n163|\t\tt.Fatalf(\"BuildPlan admitted corrupt profile authority; Revalidate=%v\", r.Revalidate(plan))\n164|\t}\n165|\tif !errors.Is(buildErr, sessstate.ErrIntegrity) {\n166|\t\tt.Errorf(\"BuildPlan refusal = %v, want integrity_failure\", buildErr)\n167|\t}\n168|\tif _, err := r.AuthoritativeStatus(\"alpha\"); err == nil {\n169|\t\tt.Error(\"AuthoritativeStatus admitted corrupt profile authority\")\n170|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n171|\t\tt.Errorf(\"AuthoritativeStatus refusal = %v, want integrity_failure\", err)\n172|\t}\n173|\tif _, err := r.AuthoritativeList(); err == nil {\n174|\t\tt.Error(\"AuthoritativeList admitted corrupt profile authority\")\n175|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n176|\t\tt.Errorf(\"AuthoritativeList refusal = %v, want integrity_failure\", err)\n177|\t}\n178|}\n179|\n180|func TestRev8ProfileChangedPositiveControl(t *testing.T) {\n181|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n182|\t\tfor _, ancestor := range []bool{false, true} {\n183|\t\t\tname := fmt.Sprintf(\"%s/ancestor=%t\", kind, ancestor)\n184|\t\t\tt.Run(name, func(t *testing.T) {\n185|\t\t\t\tr := rev8ChangeFixture(t, kind, ancestor)\n186|\t\t\t\trev7CheckEntries(t, r, false)\n187|\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n188|\t\t\t\tif err := r.Revalidate(old); err != nil {\n189|\t\t\t\t\tt.Errorf(\"fresh Revalidate refused valid profile authority: %v\", err)\n190|\t\t\t\t}\n191|\t\t\t})\n192|\t\t}\n193|\t}\n194|}\n195|\n196|// TestRev8ProfileResumePositiveControl proves a resume carries the\n197|// checkpoint effective pair instead of falling back to the\n198|// creation value: E1 moves the closure to standard, and the resume\n199|// from the E1 checkpoint carries (standard, E1). Both the admitting\n200|// checkpoint and the resume's referenced checkpoint are supplied,\n201|// because the resume expectation resolves through the referenced\n202|// record's own closure.\n203|func TestRev8ProfileResumePositiveControl(t *testing.T) {\n204|\tlocal, _ := repository(t)\n205|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n206|\tif err != nil {\n207|\t\tt.Fatal(err)\n208|\t}\n209|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n210|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n211|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n212|\tquiesced := appendEvent(t, local, idA, changed, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n213|\tcpA := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{quiesced}})\n214|\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", 5, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"kind\": \"manual\"})\n215|\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", 6, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n216|\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", 7, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"execution_profile\": \"standard\", \"profile_source_event_id\": changed, \"terminal_backend\": \"tmux\", \"native_session_id\": \"sess-1\"})\n217|\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 8, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n218|\tcpB := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n219|\tannouncedB := appendEvent(t, local, idA, idle, \"checkpoint.created\", 9, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpB), \"kind\": \"manual\"})\n220|\ttail := appendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n221|\tr := &Reader{Local: local, LocalHostID: hostA}\n222|\twithCheckpoints(r, cpB, cpA)\n223|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cpB)))\n224|\t_ = announced\n225|\t_ = tail\n226|\trev7CheckEntries(t, r, false)\n227|\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n228|\tif err := r.Revalidate(old); err != nil {\n229|\t\tt.Errorf(\"fresh Revalidate refused valid resume profile authority: %v\", err)\n230|\t}\n231|}\n232|\n233|// TestRev8ProfileTwoGenerationControl proves the derivation tracks\n234|// the newest change across generations: E2 supersedes E1, and the\n235|// later launch cites (yolo, E2).\n236|func TestRev8ProfileTwoGenerationControl(t *testing.T) {\n237|\tlocal, _ := repository(t)\n238|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n239|\tif err != nil {\n240|\t\tt.Fatal(err)\n241|\t}\n242|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n243|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n244|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n245|\tchanged2 := appendEvent(t, local, idA, changed, \"profile.changed\", 4, rev8ChangedPayload(\"standard\", \"yolo\"))\n246|\tlaunched2 := appendEvent(t, local, idA, changed2, \"provider.launched\", 5, rev8LaunchPayload(\"yolo\", changed2))\n247|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 6, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n248|\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n249|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 7, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n250|\t_ = announced\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
