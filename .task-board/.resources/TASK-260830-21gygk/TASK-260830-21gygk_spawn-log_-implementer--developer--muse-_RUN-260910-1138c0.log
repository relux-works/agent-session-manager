{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc5f","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":1162,"recorded_at":1780531400002319,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a0891b-278b-7823-a352-595c790cb835"},"task_id":"01a0891b-278b-7823-a352-595c790cb835","event":{"kind":"output","task_id":"01a0891b-278b-7823-a352-595c790cb835","chunk":"edited\nchanged lines: lines 481-496\n--- original\n+++ updated\n@@\n-func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint) error {\n-\tcheckpoint, ok := checkpoints[current.Checkpoint]\n-\tif !ok {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n-\t}\n-\tif checkpoint.SessionID != current.SessionID {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n-\t}\n-\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n-\t}\n-\tif checkpoint.CreatorHostID != owner.HolderHostID {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n-\t}\n-\treturn nil\n-}\n+func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string) error {\n+\tcheckpoint, ok := checkpoints[current.Checkpoint]\n+\tif !ok {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n+\t}\n+\tif checkpoint.SessionID != current.SessionID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n+\t}\n+\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n+\t}\n+\tif checkpoint.CreatorHostID != owner.HolderHostID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n+\t}\n+\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n+\t\treturn err\n+\t}\n+\treturn nil\n+}\n+\n+// checkCheckpointPersistence binds an admitted Checkpoint Record to\n+// the persistence variant the referenced Session Record selects\n+// (Section 5.4): a direct session requires a non-null\n+// provider_manifest_id with a null task_board_bundle_id, while a\n+// task_board session requires the reverse. Canonical shape proves\n+// exactly one variant is present but cannot select which one is\n+// valid, so a swapped variant keeps canonical identity, session,\n+// lease, epoch, and creator yet refuses here with incomplete\n+// authority (observation_unavailable), never absence or a minted\n+// fact. An unknown session kind is malformed configuration: valid\n+// Session Records admit only the two kinds.\n+func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n+\tswitch sessionKind {\n+\tcase \"direct\":\n+\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n+\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n+\t\t}\n+\t\treturn nil\n+\tcase \"task_board\":\n+\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n+\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n+\t\t}\n+\t\treturn nil\n+\tdefault:\n+\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n+\t}\n+}\n","final_result":true}}}
