{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c701","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":475,"recorded_at":1780531400000945,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08918-36bc-7441-9f54-5175878ed0d0"},"task_id":"01a08918-36bc-7441-9f54-5175878ed0d0","event":{"kind":"output","task_id":"01a08918-36bc-7441-9f54-5175878ed0d0","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, the complete authority\n10|// union for the pinned session across the remaining allowed sources,\n11|// authority heads, and the source index digest.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n27|const uint53Ceiling = uint64(1<<53 - 1)\n28|\n29|// Revalidate compares every bound plan fact against current\n30|// configuration and freshly reread source data, then validates the\n31|// complete authority union for the pinned session UUID across the\n32|// remaining allowed sources. The session is located by its UUID in\n33|// each source, never re-resolved by name. A nil return means the plan\n34|// is current; any error classifies exactly: selector_plan_stale (with\n35|// the first diverged member named), integrity_failure on contradictory\n36|// cross-source immutable records, peer_not_allowlisted on explicit\n37|// authorization revocation, invalid_config on current configuration\n38|// failures, invalid_arguments on a malformed caller plan, and the read\n39|// or projection failure class when a required read or validation\n40|// fails.\n41|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n42|\tif err := checkPlanShapes(plan); err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif reader == nil || reader.Local == nil {\n46|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n47|\t}\n48|\tconfig, err := reader.validatedConfiguration()\n49|\tif err != nil {\n50|\t\treturn err\n51|\t}\n52|\tpeerHost, isPeer := planSourceBinding(plan, config)\n53|\tif isPeer {\n54|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n55|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n56|\t\t}\n57|\t}\n58|\tif !bindingHolds(plan, config, reader) {\n59|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n60|\t}\n61|\tconfiguration, err := fingerprintConfiguration(reader, config)\n62|\tif err != nil {\n63|\t\treturn err\n64|\t}\n65|\tif configuration != plan.ConfigurationDigest {\n66|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n67|\t}\n68|\tvar repo = reader.Local\n69|\tsourcePeer := \"\"\n70|\tif isPeer {\n71|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n72|\t\tif err != nil {\n73|\t\t\treturn err\n74|\t\t}\n75|\t}\n76|\trows, err := reader.readSource(repo, sourcePeer)\n77|\tif err != nil {\n78|\t\treturn err\n79|\t}\n80|\tvar recordID string\n81|\tabsent := true\n82|\tfor _, row := range rows {\n83|\t\tif row.Projection.SessionID == plan.SessionID {\n84|\t\t\trecordID, absent = row.Projection.RecordID, false\n85|\t\t\tbreak\n86|\t\t}\n87|\t}\n88|\tif absent {\n89|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n90|\t}\n91|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n92|\tif err != nil {\n93|\t\treturn err\n94|\t}\n95|\tif recordID != plan.SessionRecordID {\n96|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n97|\t}\n98|\tif projection.Winner.IsZero() {\n99|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n100|\t}\n101|\tlease, err := reader.winningLeaseFor(plan.SessionID)\n102|\tif err != nil {\n103|\t\treturn err\n104|\t}\n105|\tif lease.Digest != plan.LeaseRecordID || lease.Epoch != plan.LeaseEpoch || lease.LeaseID != plan.LeaseID || lease.HolderHostID != plan.OwnerHostID {\n106|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n107|\t}\n108|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID {\n109|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n110|\t}\n111|\tif projection.OwnerHostID != lease.HolderHostID {\n112|\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, plan.SessionID)\n113|\t}\n114|\t// The union reports specific lease and tombstone divergence before\n115|\t// the generic head and index comparisons: heads include union tails,\n116|\t// so a union change would otherwise mask as a head change.\n117|\tif err := reader.validateAuthorityUnion(plan, config, sourcePeer); err != nil {\n118|\t\treturn err\n119|\t}\n120|\theads, err := reader.collectAuthorityHeads(config, plan.SessionID, lease.Digest, sourcePeer)\n121|\tif err != nil {\n122|\t\treturn err\n123|\t}\n124|\tif !equalStrings(heads, plan.AuthorityHeads) {\n125|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n126|\t}\n127|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif index != plan.SourceIndexDigest {\n132|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n133|\t}\n134|\treturn nil\n135|}\n136|\n137|// validateAuthorityUnion validates the complete current authority for\n138|// the pinned session UUID across every allowed source except the\n139|// already validated plan source. The session is located by UUID in\n140|// each source; names are never re-resolved and no selection is\n141|// substituted. A non-parked copy carrying a disagreeing immutable\n142|// record digest is inconsistent authority (integrity_failure, the same\n143|// class Resolve reports for disagreeing copies). Authoritative\n144|// tombstone evidence or a greater observed winning lease (Section 5.3\n145|// greatest (epoch, lease_id) tuple) in another source invalidates the\n146|// live plan (selector_plan_stale); a lagging copy with a smaller tuple\n147|// is a preserved losing history and stays current, and an agreeing\n148|// replica stays current. A copy that observes no winning lease yet\n149|// cannot contradict the bound lease and is skipped for the lease\n150|// check, while its record digest still binds. A parked copy of the\n151|// pinned session is incomplete authority and fails the union closed\n152|// (selector_observation_unavailable); only a genuinely absent\n153|// session is not contradiction. A source that must be read but\n154|// cannot be read keeps its read-failure class: without the complete\n155|// union the plan cannot be shown current.\n156|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n157|\tif sourcePeer != \"\" {\n158|\t\trows, err := reader.read(reader.Local)\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n163|\t\t\treturn err\n164|\t\t}\n165|\t}\n166|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n167|\tsort.Strings(ids)\n168|\tfor index, id := range ids {\n169|\t\tif index > 0 && id == ids[index-1] {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tif id == sourcePeer {\n173|\t\t\tcontinue\n174|\t\t}\n175|\t\t// An allowlisted peer with no advertised learned index\n176|\t\t// contributes no authority; a known handle that cannot be\n177|\t\t// read is a failed observation of a source that must be\n178|\t\t// read, never absence.\n179|\t\tif isAbsentPeerIndex(reader, id) {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\trepo, peerHost, err := reader.peerRepo(id)\n183|\t\tif err != nil {\n184|\t\t\treturn err\n185|\t\t}\n186|\t\trows, err := reader.readSource(repo, peerHost)\n187|\t\tif err != nil {\n188|\t\t\treturn err\n189|\t\t}\n190|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n191|\t\t\treturn err\n192|\t\t}\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n198|// learned index handle at all: absence, never a failed read.\n199|func isAbsentPeerIndex(reader *Reader, host string) bool {\n200|\tfor _, peer := range reader.Peers {\n201|\t\tif peer.HostID == host {\n202|\t\t\treturn false\n203|\t\t}\n204|\t}\n205|\treturn true\n206|}\n207|\n208|// checkUnionCopy validates one non-plan source's rows for the pinned\n209|// session UUID as validateAuthorityUnion documents. A parked copy of\n210|// the pinned session is incomplete authority (unknown), never\n211|// evidence and never absence: the union cannot be shown current\n212|// without it, so the plan fails closed with\n213|// selector_observation_unavailable naming the blocking reason. The\n214|// union winner is the greatest (epoch, lease_id) tuple: only a\n215|// greater tuple in another source invalidates the plan; smaller\n216|// tuples are preserved losing histories and equal tuples are\n217|// agreeing replicas.\n218|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n219|\tfor _, row := range rows {\n220|\t\tif row.Projection.SessionID != plan.SessionID {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tif row.Projection.Parked != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: required authority for session %s is unknown: %s\", ErrObservationUnavailable, plan.SessionID, row.Projection.Parked.BlockingReason)\n225|\t\t}\n226|\t\tif row.Projection.State == sessstate.StateTombstoned {\n227|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n228|\t\t}\n229|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n230|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n231|\t\t}\n232|\t\tif row.Projection.Winner.IsZero() {\n233|\t\t\tcontinue\n234|\t\t}\n235|\t\tordering := compareLeaseTuple(\n236|\t\t\trow.Projection.Winner.Epoch, row.Projection.Winner.LeaseID,\n237|\t\t\tplan.LeaseEpoch, plan.LeaseID,\n238|\t\t)\n239|\t\tif ordering > 0 {\n240|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n241|\t\t}\n242|\t\tif ordering == 0 && row.Projection.OwnerHostID != plan.OwnerHostID {\n243|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across sources\", sessstate.ErrIntegrity, plan.SessionID)\n244|\t\t}\n245|\t}\n246|\treturn nil\n247|}\n248|\n249|// collectAuthorityHeads binds the sorted unique lease, event, and\n250|// tombstone heads used for the decision: the winning Lease Record\n251|// digest plus the tail event digest of every allowed source holding a\n252|// non-parked copy of the pinned session. A parked copy of the pinned\n253|// session never reaches this binding: the union gate fails closed\n254|// first, so the skip below only documents that parked rows carry no\n255|// tail; absent sessions contribute none. A source that must be read\n256|// but cannot be read keeps its read-failure class.\n257|func (reader *Reader) collectAuthorityHeads(config validatedConfig, sessionID, leaseDigest, sourcePeer string) ([]string, error) {\n258|\tset := map[string]struct{}{leaseDigest: {}}\n259|\tcollect := func(repo *sessrepo.Repository, peerHost string) error {\n260|\t\trows, err := reader.readSource(repo, peerHost)\n261|\t\tif err != nil {\n262|\t\t\treturn err\n263|\t\t}\n264|\t\tfor _, row := range rows {\n265|\t\t\tif row.Projection.SessionID != sessionID {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tif row.Projection.Parked != nil {\n269|\t\t\t\tcontinue\n270|\t\t\t}\n271|\t\t\ttail, err := chainTail(repo, sessionID)\n272|\t\t\tif err != nil {\n273|\t\t\t\tif peerHost == \"\" {\n274|\t\t\t\t\treturn err\n275|\t\t\t\t}\n276|\t\t\t\treturn peerReadFailed(peerHost, err)\n277|\t\t\t}\n278|\t\t\tif tail != \"\" {\n279|\t\t\t\tset[tail] = struct{}{}\n280|\t\t\t}\n281|\t\t\tbreak\n282|\t\t}\n283|\t\treturn nil\n284|\t}\n285|\tvar planRepo *sessrepo.Repository\n286|\tif sourcePeer == \"\" {\n287|\t\tplanRepo = reader.Local\n288|\t} else {\n289|\t\tvar err error\n290|\t\tplanRepo, _, err = reader.peerRepo(sourcePeer)\n291|\t\tif err != nil {\n292|\t\t\treturn nil, err\n293|\t\t}\n294|\t}\n295|\tif err := collect(planRepo, sourcePeer); err != nil {\n296|\t\treturn nil, err\n297|\t}\n298|\tif sourcePeer != \"\" {\n299|\t\tif err := collect(reader.Local, \"\"); err != nil {\n300|\t\t\treturn nil, err\n301|\t\t}\n302|\t}\n303|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n304|\tsort.Strings(ids)\n305|\tfor index, id := range ids {\n306|\t\tif index > 0 && id == ids[index-1] {\n307|\t\t\tcontinue\n308|\t\t}\n309|\t\tif id == sourcePeer {\n310|\t\t\tcontinue\n311|\t\t}\n312|\t\tif isAbsentPeerIndex(reader, id) {\n313|\t\t\tcontinue\n314|\t\t}\n315|\t\trepo, peerHost, err := reader.peerRepo(id)\n316|\t\tif err != nil {\n317|\t\t\treturn nil, err\n318|\t\t}\n319|\t\tif err := collect(repo, peerHost); err != nil {\n320|\t\t\treturn nil, err\n321|\t\t}\n322|\t}\n323|\theads := make([]string, 0, len(set))\n324|\tfor digest := range set {\n325|\t\theads = append(heads, digest)\n326|\t}\n327|\tsort.Strings(heads)\n328|\treturn heads, nil\n329|}\n330|\n331|// planSourceBinding resolves the plan's bound source: a local plan\n332|// carries a null alias with an empty or local host, while any other\n333|// binding selects a peer source by host. The second return reports\n334|// whether the plan selects a peer source.\n335|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n336|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n337|\t\treturn \"\", false\n338|\t}\n339|\treturn plan.SourceHostID, true\n340|}\n341|\n342|// bindingHolds reports whether the plan's bound (host, alias) source\n343|// still resolves to the same source in the current configuration. A\n344|// local plan holds while its host is empty or the current local host;\n345|// a peer plan holds while its host is still a known peer carrying the\n346|// exact bound alias.\n347|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n348|\tif plan.SourceAlias == nil {\n349|\t\tif plan.SourceHostID == \"\" {\n350|\t\t\treturn true\n351|\t\t}\n352|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n353|\t\t\treturn true\n354|\t\t}\n355|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n356|\t\t\treturn true\n357|\t\t}\n358|\t\treturn false\n359|\t}\n360|\tif !knownPeer(reader, plan.SourceHostID) {\n361|\t\treturn false\n362|\t}\n363|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n364|}\n365|\n366|// equalStrings compares sorted unique string slices element-wise.\n367|func equalStrings(first, second []string) bool {\n368|\tif len(first) != len(second) {\n369|\t\treturn false\n370|\t}\n371|\tfor index := range first {\n372|\t\tif first[index] != second[index] {\n373|\t\t\treturn false\n374|\t\t}\n375|\t}\n376|\treturn true\n377|}\n378|\n379|// checkPlanShapes validates the caller-supplied plan members without\n380|// consulting any authority: exact contract version, grammatical\n381|// selector, canonical UUIDs and digests, a bound source host, the\n382|// required lease attestation with its full positive triple, exact\n383|// alias bound, sorted unique authority heads, a known action tag, and\n384|// a null or UUIDv7 destination. Authority comes only from Revalidate.\n385|func checkPlanShapes(plan SelectionPlan) error {\n386|\tif plan.SelectorVersion != SelectorVersion {\n387|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n388|\t}\n389|\tif _, err := ParseSelector(plan.Selector); err != nil {\n390|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n391|\t}\n392|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n393|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n394|\t}\n395|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n396|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n397|\t}\n398|\t// The source host is always bound: no plan observes a source it\n399|\t// cannot name, and empty never substitutes for unknown.\n400|\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n401|\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n402|\t}\n403|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n404|\t\treturn fmt.Errorf(\"%w: malformed plan lease record digest: %v\", ErrInvalidArgument, err)\n405|\t}\n406|\tif plan.SourceAlias != nil {\n407|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n408|\t\t\t// An alias-less peer binds empty, which never passes the\n409|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n410|\t\t\tif *plan.SourceAlias != \"\" {\n411|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n412|\t\t\t}\n413|\t\t}\n414|\t}\n415|\tfor _, member := range []struct {\n416|\t\tname   string\n417|\t\tdigest string\n418|\t}{\n419|\t\t{\"source index\", plan.SourceIndexDigest},\n420|\t\t{\"configuration\", plan.ConfigurationDigest},\n421|\t\t{\"expectation\", plan.ExpectationDigest},\n422|\t} {\n423|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n424|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n425|\t\t}\n426|\t}\n427|\t// The lease triple is always fully bound from the same winning\n428|\t// observation as the lease attestation: a positive uint53 epoch\n429|\t// with a UUIDv4 lease and a UUIDv7 owner. Empty and partial\n430|\t// triples, out-of-range epochs, and placeholders are refused; a\n431|\t// session with no observed winning lease builds no plan.\n432|\tif plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling {\n433|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n434|\t}\n435|\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n436|\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n437|\t}\n438|\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n439|\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n440|\t}\n441|\tfor index, head := range plan.AuthorityHeads {\n442|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n443|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n444|\t\t}\n445|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n446|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n447|\t\t}\n448|\t}\n449|\tif _, ok := BoundariesFor(plan.Action); !ok {\n450|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n451|\t}\n452|\tif plan.DestinationHostID != nil {\n453|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n454|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n455|\t\t}\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// planWire is the tamper-evident persistence encoding: every bound\n461|// member plus the locally verified canonical digest over all of them.\n462|type planWire struct {\n463|\tSelectorVersion     string   `json:\"selector_version\"`\n464|\tSelector            string   `json:\"selector\"`\n465|\tSessionID           string   `json:\"session_id\"`\n466|\tSessionRecordID     string   `json:\"session_record_id\"`\n467|\tSourceHostID        string   `json:\"source_host_id\"`\n468|\tSourceAlias         *string  `json:\"source_alias\"`\n469|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n470|\tConfigurationDigest string   `json:\"configuration_digest\"`\n471|\tLeaseRecordID       string   `json:\"lease_record_id\"`\n472|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n473|\tLeaseID             string   `json:\"lease_id\"`\n474|\tOwnerHostID         string   `json:\"owner_host_id\"`\n475|\tAuthorityHeads      []string `json:\"authority_heads\"`\n476|\tAction              string   `json:\"action\"`\n477|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n478|\tExpectationDigest   string   `json:\"expectation_digest\"`\n479|\tPlanDigest          string   `json:\"plan_digest\"`\n480|}\n481|\n482|// Digest returns the locally verified canonical digest over all bound\n483|// plan members. It is recomputed on every call and never trusted from\n484|// caller bytes.\n485|func (plan SelectionPlan) Digest() (string, error) {\n486|\theads := append([]string(nil), plan.AuthorityHeads...)\n487|\tif heads == nil {\n488|\t\theads = []string{}\n489|\t}\n490|\treturn fingerprint(map[string]any{\n491|\t\t\"action\":               plan.Action,\n492|\t\t\"authority_heads\":      heads,\n493|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n494|\t\t\"destination_host_id\":  plan.DestinationHostID,\n495|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n496|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n497|\t\t\"lease_id\":             plan.LeaseID,\n498|\t\t\"lease_record_id\":      plan.LeaseRecordID,\n499|\t\t\"owner_host_id\":        plan.OwnerHostID,\n500|\t\t\"selector\":             plan.Selector,\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c703","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":476,"recorded_at":1780531400000947,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08918-36bc-7441-9f54-5175878ed0d0"},"task_id":"01a08918-36bc-7441-9f54-5175878ed0d0","event":{"kind":"completed","task_id":"01a08918-36bc-7441-9f54-5175878ed0d0"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c705","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":477,"recorded_at":1780531400000949,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08918-3638-7eb2-aac6-143e65b3f2da"},"task_id":"01a08918-3638-7eb2-aac6-143e65b3f2da","event":{"kind":"output","task_id":"01a08918-3638-7eb2-aac6-143e65b3f2da","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability. All sixteen contract members bind; a future\n13|// member without a bound row fails its publication gate closed instead\n14|// of falling into a default.\n15|//\n16|// Lease authority comes from validated urn:ax:schema:lease records\n17|// supplied in Reader.LeaseRecords and admitted through the\n18|// canonicaljson owner. The plan binds lease_record_id as the canonical\n19|// digest of the winning Lease Record for the selected session, and the\n20|// lease triple binds from that same record. No envelope observation\n21|// substitutes for the record: a session with no admitted winning\n22|// record refuses selector_observation_unavailable, and malformed bytes\n23|// refuse invalid_config. A complete read proving a record without any\n24|// valid lease refuses selector_bootstrap_incomplete instead of binding\n25|// an empty triple, and a local selection without a known local host\n26|// refuses invalid_config instead of binding an empty source host.\n27|//\n28|// Revalidation rereads the current configuration and the plan's source,\n29|// validates the same immutable record, the current winning lease, and\n30|// the action prerequisites this leaf can check, compares every bound\n31|// plan fact in a fixed order, and then validates the complete\n32|// authority union for the pinned session UUID across the local and\n33|// every allowlisted source: a contradictory immutable record is\n34|// integrity failure, a contradictory winning lease or fresh tombstone\n35|// evidence is stale. A changed mapping, alias, allowlist, transport,\n36|// source index, record, authority head, lease, action, destination, or\n37|// expectation invalidates the plan with selector_plan_stale naming the\n38|// first diverged member; explicit authorization revocation returns\n39|// peer_not_allowlisted; failed reads retain their read-failure\n40|// classification. Revalidation never re-resolves by name, substitutes\n41|// a same-named session, silently replans, transfers a lease, or reuses\n42|// confirmation for new facts.\n43|//\n44|// Effect authorization beyond read projection — fencing, commit,\n45|// retry, recovery, remote dispatch/admission, and transport-resume\n46|// prerequisites, and the composed per-endpoint invocation bindings —\n47|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n48|// every boundary in BoundariesFor for their action. A plan built here\n49|// authorizes read projection only.\n50|package sessquery\n51|\n52|import (\n53|\t\"fmt\"\n54|\n55|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n56|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n57|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n58|)\n59|\n60|// SelectorVersion is the exact selector contract version every plan binds.\n61|const SelectorVersion = \"1.0.0\"\n62|\n63|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n64|// an existing command/action tag; binding one selects it, never an\n65|// umbrella bypass.\n66|const (\n67|\tActionStatus      = \"status\"\n68|\tActionAttach      = \"attach\"\n69|\tActionTakeover    = \"takeover\"\n70|\tActionFork        = \"fork\"\n71|\tActionStop        = \"stop\"\n72|\tActionResume      = \"resume\"\n73|\tActionSync        = \"sync\"\n74|\tActionDiff        = \"diff\"\n75|\tActionMaterialize = \"materialize\"\n76|\tActionSetProfile  = \"session.set-profile\"\n77|\tActionLogs        = \"logs\"\n78|\tActionCancel      = \"cancel\"\n79|)\n80|\n81|// Plan boundaries from the normative action/boundary matrix. A boundary\n82|// is reached only when the existing operation reaches that phase; these\n83|// rows introduce no new effects.\n84|const (\n85|\tBoundaryProjection      = \"projection\"\n86|\tBoundaryPreEffect       = \"pre-effect\"\n87|\tBoundaryFencing         = \"fencing\"\n88|\tBoundaryCommit          = \"commit\"\n89|\tBoundaryRetry           = \"retry\"\n90|\tBoundaryRecovery        = \"recovery\"\n91|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n92|\tBoundaryRemoteAdmission = \"remote-admission\"\n93|\tBoundaryTransportResume = \"transport-resume\"\n94|)\n95|\n96|// planBoundaries is the closed action/boundary matrix: every action has\n97|// exactly its normative row, and an unknown action has none.\n98|var planBoundaries = map[string][]string{\n99|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n100|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n101|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n102|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n103|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n104|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n105|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n106|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n107|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n108|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n109|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n110|\tActionCancel:      {BoundaryProjection},\n111|}\n112|\n113|// BoundariesFor returns the required boundary classes for a plan\n114|// action. The boolean reports whether the action is a known tag; an\n115|// unknown action binds no boundary and builds no plan.\n116|func BoundariesFor(action string) ([]string, bool) {\n117|\tboundaries, ok := planBoundaries[action]\n118|\tif !ok {\n119|\t\treturn nil, false\n120|\t}\n121|\treturn append([]string(nil), boundaries...), true\n122|}\n123|\n124|// SelectionPlan is the machine-local immutable binding of one selector\n125|// resolution. All members are values, never references: there is no\n126|// mutator, and Marshal carries the locally verified canonical digest\n127|// so a persisted plan is tamper-evident. Caller-supplied digest\n128|// equality alone is never evidence of authority; only Revalidate\n129|// against current facts decides currency.\n130|type SelectionPlan struct {\n131|\t// SelectorVersion is exactly SelectorVersion.\n132|\tSelectorVersion string\n133|\t// Selector is the original single argument, at most\n134|\t// MaxSelectorRunes characters.\n135|\tSelector string\n136|\t// SessionID is the selected UUIDv7, never resolved again by name.\n137|\tSessionID string\n138|\t// SessionRecordID is the validated immutable Session Record digest.\n139|\tSessionRecordID string\n140|\t// SourceHostID is the UUIDv7 of the selected source, always bound:\n141|\t// a local selection without a known local host refuses\n142|\t// invalid_config at build time instead of binding empty.\n143|\tSourceHostID string\n144|\t// SourceAlias is the exact configured alias, or nil for local. It\n145|\t// is a diagnostic label, never identity.\n146|\tSourceAlias *string\n147|\t// SourceIndexDigest is the digest of the complete validated index\n148|\t// read used for selection.\n149|\tSourceIndexDigest string\n150|\t// ConfigurationDigest is the digest of the effective validated\n151|\t// configuration, including peer mapping, allowlist, and transport.\n152|\tConfigurationDigest string\n153|\t// LeaseRecordID is the canonical digest of the validated winning\n154|\t// Lease Record for the selected session, admitted through the\n155|\t// canonicaljson owner from Reader.LeaseRecords.\n156|\tLeaseRecordID string\n157|\t// LeaseEpoch, LeaseID, and OwnerHostID come from that same winning\n158|\t// Lease Record: positive uint53, UUIDv4, and UUIDv7 holder. A plan\n159|\t// with no admitted winning record is never built; the builder\n160|\t// refuses selector_observation_unavailable, and a complete read\n161|\t// proving a record without any valid lease refuses\n162|\t// selector_bootstrap_incomplete.\n163|\tLeaseEpoch  uint64\n164|\tLeaseID     string\n165|\tOwnerHostID string\n166|\t// AuthorityHeads is the sorted unique digest array of the validated\n167|\t// lease, event, and tombstone heads used for the decision: the\n168|\t// winning Lease Record digest plus the tail event digest of every\n169|\t// allowed source holding a non-parked copy of the pinned session.\n170|\tAuthorityHeads []string\n171|\t// Action is the explicit command/action tag bound at build time.\n172|\tAction string\n173|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n174|\t// when the action takes no destination.\n175|\tDestinationHostID *string\n176|\t// ExpectationDigest binds the caller-declared action expectations\n177|\t// (canonically encoded JSON) for change detection. It does not\n178|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n179|\t// or confirmation contracts, which have no owners in this leaf.\n180|\tExpectationDigest string\n181|}\n182|\n183|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n184|// selector, the explicit action tag, the explicit destination (empty\n185|// for none), and the opaque caller expectations (nil for none).\n186|type PlanArgs struct {\n187|\tSelector     string\n188|\tAction       string\n189|\tDestination  string\n190|\tExpectations []byte\n191|}\n192|\n193|// BuildPlan resolves the selector once through the shared path and\n194|// binds the current facts into an immutable plan. The destination is\n195|// independently validated as a UUIDv7; expectations must be canonically\n196|// encodable JSON and bind by digest for change detection only.\n197|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n198|\tparsed, err := ParseSelector(args.Selector)\n199|\tif err != nil {\n200|\t\treturn SelectionPlan{}, err\n201|\t}\n202|\tif reader == nil || reader.Local == nil {\n203|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n204|\t}\n205|\tconfig, err := reader.validatedConfiguration()\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tif _, ok := BoundariesFor(args.Action); !ok {\n210|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n211|\t}\n212|\tvar destination *string\n213|\tif args.Destination != \"\" {\n214|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n215|\t\tif err != nil {\n216|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n217|\t\t}\n218|\t\tvalue := id.String()\n219|\t\tdestination = &value\n220|\t}\n221|\texpectations, err := fingerprintExpectations(args.Expectations)\n222|\tif err != nil {\n223|\t\treturn SelectionPlan{}, err\n224|\t}\n225|\tvar selected Selection\n226|\tif parsed.Source != SourceBare {\n227|\t\tselected, err = reader.resolveExplicit(parsed, config)\n228|\t} else {\n229|\t\tselected, err = reader.resolveBare(parsed, config)\n230|\t}\n231|\tif err != nil {\n232|\t\treturn SelectionPlan{}, err\n233|\t}\n234|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n235|}\n236|\n237|// bindPlan reads the winning source completely and binds every plan\n238|// member from validated current facts. The session is located by its\n239|// UUID in the winning source only, never re-resolved by name. Lease\n240|// authority comes from the admitted winning Lease Record for that\n241|// UUID; the envelope winner on the selected chain must agree with it,\n242|// and the union winner across all allowed sources must not exceed it.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tlease, err := reader.winningLeaseFor(selected.SessionID)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n279|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n280|\t}\n281|\tif projection.OwnerHostID != lease.HolderHostID {\n282|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, selected.SessionID)\n283|\t}\n284|\tplan := SelectionPlan{\n285|\t\tSelectorVersion:     SelectorVersion,\n286|\t\tSelector:            parsed.Raw,\n287|\t\tSessionID:           selected.SessionID,\n288|\t\tSessionRecordID:     recordID,\n289|\t\tSourceIndexDigest:   index,\n290|\t\tConfigurationDigest: configuration,\n291|\t\tLeaseRecordID:       lease.Digest,\n292|\t\tLeaseEpoch:          lease.Epoch,\n293|\t\tLeaseID:             lease.LeaseID,\n294|\t\tOwnerHostID:         lease.HolderHostID,\n295|\t\tAction:              action,\n296|\t\tDestinationHostID:   destination,\n297|\t\tExpectationDigest:   expectations,\n298|\t}\n299|\tif selected.PeerHostID == \"\" {\n300|\t\tif config.localHost == \"\" {\n301|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n302|\t\t}\n303|\t\tplan.SourceHostID = config.localHost\n304|\t} else {\n305|\t\tplan.SourceHostID = selected.PeerHostID\n306|\t\t// Null marks the local source only. An alias-less peer binds\n307|\t\t// empty: the host still distinguishes it from local.\n308|\t\talias := config.aliasFor(selected.PeerHostID)\n309|\t\taliasCopy := alias\n310|\t\tplan.SourceAlias = &aliasCopy\n311|\t}\n312|\t// The union check consults record, tombstone, and winner facts\n313|\t// only, never heads; heads are bound after the union validates.\n314|\tplan.AuthorityHeads = []string{}\n315|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\theads, err := reader.collectAuthorityHeads(config, selected.SessionID, lease.Digest, selected.PeerHostID)\n319|\tif err != nil {\n320|\t\treturn SelectionPlan{}, err\n321|\t}\n322|\tplan.AuthorityHeads = heads\n323|\tif err := checkPlanShapes(plan); err != nil {\n324|\t\treturn SelectionPlan{}, err\n325|\t}\n326|\treturn plan, nil\n327|}\n328|\n329|// chainTail returns the tail event digest of a validated session chain,\n330|// or empty when the chain carries no events yet.\n331|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n332|\tevents, err := repo.ListEvents(sessionID)\n333|\tif err != nil {\n334|\t\treturn \"\", err\n335|\t}\n336|\tif len(events) == 0 {\n337|\t\treturn \"\", nil\n338|\t}\n339|\treturn events[len(events)-1].EventID, nil\n340|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c707","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":478,"recorded_at":1780531400000951,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08918-3638-7eb2-aac6-143e65b3f2da"},"task_id":"01a08918-3638-7eb2-aac6-143e65b3f2da","event":{"kind":"completed","task_id":"01a08918-3638-7eb2-aac6-143e65b3f2da"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c709","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":479,"recorded_at":1780531400000953,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08918-3682-7c73-9779-c37458369ded"},"task_id":"01a08918-3682-7c73-9779-c37458369ded","event":{"kind":"output","task_id":"01a08918-3682-7c73-9779-c37458369ded","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/summary.go`.\n1|// Authoritative shared summaries for the v0.6.0 selector contract\n2|// (SPEC Section 14.7.3).\n3|//\n4|// List and Status above keep the internal read model and refuse only\n5|// the unrepresentable record-only bootstrap. This layer is the closed\n6|// authoritative summary: every owner, lease, and role fact comes from\n7|// the validated winning Lease Record, every host display name comes\n8|// from validated host metadata, and every workspace, capability,\n9|// liveness, and timestamp fact comes from a validated observation.\n10|// Anything that cannot be established truthfully refuses instead of\n11|// falling back to inference:\n12|//\n13|//   - a complete read proving a record without any valid lease is\n14|//     selector_bootstrap_incomplete (inherited from the read entry);\n15|//   - a required host metadata fact, winning Lease Record, or\n16|//     observation that cannot be established is\n17|//     selector_observation_unavailable, never a source alias, an empty\n18|//     name, or a minted process/capability fact;\n19|//   - list refuses the whole success document when any encountered\n20|//     record cannot be represented, including a mixed healthy and\n21|//     incomplete listing; no record is silently omitted.\n22|//\n23|// CLI envelope and exit rendering, durable bootstrap recovery, and\n24|// effect authorization remain their existing caller owners. Plans\n25|// built here authorize read projection only.\n26|package sessquery\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"time\"\n32|\t\"unicode\"\n33|\t\"unicode/utf8\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n37|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n38|)\n39|\n40|// MaxDisplayNameRunes bounds one validated host display name: the\n41|// SessionSummary owner_host_name is string[1..64].\n42|const MaxDisplayNameRunes = 64\n43|\n44|// MaxCapabilityNameRunes bounds one validated capability name.\n45|const MaxCapabilityNameRunes = 128\n46|\n47|// MaxCapabilityDetailRunes bounds one CapabilitySummary detail: string[0..2048].\n48|const MaxCapabilityDetailRunes = 2048\n49|\n50|// MaxWarningRunes bounds one summary warning: 1..1024 printable runes.\n51|const MaxWarningRunes = 1024\n52|\n53|// MaxWarnings bounds the warning array: sorted unique string[0..1024].\n54|const MaxWarnings = 1024\n55|\n56|// MaxCapabilities bounds the capability map: 0..7 entries.\n57|const MaxCapabilities = 7\n58|\n59|// Workspace statuses from the SessionSummary shape.\n60|const (\n61|\tWorkspaceAbsent      = \"absent\"\n62|\tWorkspaceCurrent     = \"current\"\n63|\tWorkspaceStaged      = \"staged\"\n64|\tWorkspaceConflict    = \"conflict\"\n65|\tWorkspaceUnsupported = \"unsupported\"\n66|)\n67|\n68|// HostMetadata is validated display metadata for one host, keyed by\n69|// canonical host UUID on the Reader. It is the only source of owner\n70|// display names; the source alias never substitutes for it.\n71|type HostMetadata struct {\n72|\tDisplayName string\n73|}\n74|\n75|// CapabilitySummary is one validated capability value: status,\n76|// enabled, and detail. Only available may set enabled true.\n77|type CapabilitySummary struct {\n78|\tStatus  string\n79|\tEnabled bool\n80|\tDetail  string\n81|}\n82|\n83|// SessionObservations carries validated per-session observation facts\n84|// from their respective owners, keyed by session UUID on the Reader.\n85|// A nil map entry or nil pointer is unobserved (unknown) and refuses\n86|// selector_observation_unavailable when the fact is required; an\n87|// established absence uses an explicit value (workspace \"absent\", an\n88|// empty non-nil capability map). The newest-checkpoint timestamp is\n89|// required exactly when the projection carries a checkpoint.\n90|type SessionObservations struct {\n91|\t// NewestCheckpointCreatedAt is the RFC 3339 creation timestamp of\n92|\t// the newest checkpoint, required exactly when the projection\n93|\t// carries a checkpoint.\n94|\tNewestCheckpointCreatedAt *string\n95|\t// ProcessPresent is validated process liveness; nil is unobserved.\n96|\t// It is required for AuthoritativeStatus (the status body carries\n97|\t// process_present boolean) and carried when supplied for lists.\n98|\tProcessPresent *bool\n99|\t// Capabilities are validated capability summaries; nil is\n100|\t// unobserved and refuses, while an empty non-nil map is an\n101|\t// established absence of capabilities.\n102|\tCapabilities map[string]CapabilitySummary\n103|\t// WorkspaceStatus is the validated workspace status; nil is\n104|\t// unobserved and refuses, while \"absent\" is an established\n105|\t// absence.\n106|\tWorkspaceStatus *string\n107|}\n108|\n109|// AuthoritativeSummary is the closed public summary for one live\n110|// session. Owner, lease, and role come from the validated winning\n111|// Lease Record; host names, workspace, capabilities, liveness, and\n112|// timestamps come from validated inputs. No member is ever invented.\n113|type AuthoritativeSummary struct {\n114|\tSessionID                 string\n115|\tName                      string\n116|\tKind                      string\n117|\tProviderID                string\n118|\tState                     string\n119|\tOwnerHostID               string\n120|\tOwnerHostName             string\n121|\tLeaseEpoch                uint64\n122|\tLeaseID                   string\n123|\tLocalRole                 string\n124|\tHasCheckpoint             bool\n125|\tNewestCheckpointID        *string\n126|\tNewestCheckpointCreatedAt *string\n127|\tProcessPresent            *bool\n128|\tCapabilities              map[string]CapabilitySummary\n129|\tWorkspaceStatus           string\n130|\tWarnings                  []string\n131|}\n132|\n133|// checkSummaryRepresentable refuses a projected row that can never be\n134|// represented truthfully in a public summary: a complete read proving\n135|// a record without any valid lease. Parked rows stay representable\n136|// through their blocking reason and retry, and tombstoned rows stay\n137|// listed with their terminal state; resolution routing already\n138|// excludes both from live selection.\n139|func checkSummaryRepresentable(summary Summary) error {\n140|\tprojection := summary.Projection\n141|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n142|\t\treturn nil\n143|\t}\n144|\tif projection.Winner.IsZero() {\n145|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// validatedAuthorityInputs validates the reader's host metadata and\n151|// observation maps as configuration: UUIDv7 keys, printable bounded\n152|// display names, RFC 3339 checkpoint timestamps, capability names and\n153|// values, and workspace enums. Malformed inputs are invalid_config;\n154|// missing facts at summary time are selector_observation_unavailable.\n155|func (reader *Reader) validatedAuthorityInputs() error {\n156|\tfor host, metadata := range reader.HostMetadata {\n157|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n158|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n159|\t\t}\n160|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n161|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n162|\t\t}\n163|\t}\n164|\tfor session, observations := range reader.Observations {\n165|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n166|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n167|\t\t}\n168|\t\tif observations.NewestCheckpointCreatedAt != nil {\n169|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n170|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n171|\t\t\t}\n172|\t\t}\n173|\t\tif observations.WorkspaceStatus != nil {\n174|\t\t\tif err := checkWorkspaceStatus(*observations.WorkspaceStatus); err != nil {\n175|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n176|\t\t\t}\n177|\t\t}\n178|\t\tif observations.Capabilities != nil {\n179|\t\t\tif err := checkCapabilities(observations.Capabilities); err != nil {\n180|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n181|\t\t\t}\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|func checkWorkspaceStatus(value string) error {\n188|\tswitch value {\n189|\tcase WorkspaceAbsent, WorkspaceCurrent, WorkspaceStaged, WorkspaceConflict, WorkspaceUnsupported:\n190|\t\treturn nil\n191|\tdefault:\n192|\t\treturn fmt.Errorf(\"workspace status %q is not absent|current|staged|conflict|unsupported\", value)\n193|\t}\n194|}\n195|\n196|// admittedCapabilities is the closed Section 7.3 provider capability\n197|// registry owned by provhost: a summary advertising any other name\n198|// claims a surface the contract never defined. This is not the\n199|// session-adapter or directory capability registries those owners\n200|// carry for their own planes.\n201|func admittedCapabilities() map[string]bool {\n202|\tadmitted := make(map[string]bool, MaxCapabilities)\n203|\tfor _, name := range provhost.Capabilities() {\n204|\t\tadmitted[name] = true\n205|\t}\n206|\treturn admitted\n207|}\n208|\n209|func checkCapabilities(values map[string]CapabilitySummary) error {\n210|\tif len(values) > MaxCapabilities {\n211|\t\treturn fmt.Errorf(\"capabilities carry %d entries, want 0-%d\", len(values), MaxCapabilities)\n212|\t}\n213|\tadmitted := admittedCapabilities()\n214|\tnames := make([]string, 0, len(values))\n215|\tfor name := range values {\n216|\t\tnames = append(names, name)\n217|\t}\n218|\tsort.Strings(names)\n219|\tfor index, name := range names {\n220|\t\tif index > 0 && names[index-1] == name {\n221|\t\t\treturn fmt.Errorf(\"capabilities carry a duplicate name\")\n222|\t\t}\n223|\t\tif err := checkPrintableBound(name, 1, MaxCapabilityNameRunes, \"capability name\"); err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\tif !admitted[name] {\n227|\t\t\treturn fmt.Errorf(\"capability %q is not a Section 7.3 registry name\", name)\n228|\t\t}\n229|\t\tsummary := values[name]\n230|\t\tswitch summary.Status {\n231|\t\tcase \"available\", \"conditional\", \"unsupported\", \"unknown\":\n232|\t\tdefault:\n233|\t\t\treturn fmt.Errorf(\"capability %q status %q is not available|conditional|unsupported|unknown\", name, summary.Status)\n234|\t\t}\n235|\t\tif summary.Enabled && summary.Status != \"available\" {\n236|\t\t\treturn fmt.Errorf(\"capability %q enables a non-available status\", name)\n237|\t\t}\n238|\t\tif err := checkDetailBound(summary.Detail); err != nil {\n239|\t\t\treturn fmt.Errorf(\"capability %q detail: %v\", name, err)\n240|\t\t}\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|func checkDetailBound(value string) error {\n246|\tif !utf8.ValidString(value) {\n247|\t\treturn fmt.Errorf(\"detail is not valid UTF-8\")\n248|\t}\n249|\tcount := utf8.RuneCountInString(value)\n250|\tif count > MaxCapabilityDetailRunes {\n251|\t\treturn fmt.Errorf(\"detail carries %d characters, want 0-%d\", count, MaxCapabilityDetailRunes)\n252|\t}\n253|\tfor _, character := range value {\n254|\t\tif unicode.IsControl(character) {\n255|\t\t\treturn fmt.Errorf(\"detail carries a control character\")\n256|\t\t}\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|func checkWarnings(values []string) error {\n262|\tif len(values) > MaxWarnings {\n263|\t\treturn fmt.Errorf(\"warnings carry %d entries, want 0-%d\", len(values), MaxWarnings)\n264|\t}\n265|\tfor index, warning := range values {\n266|\t\tif err := checkPrintableBound(warning, 1, MaxWarningRunes, \"warning\"); err != nil {\n267|\t\t\treturn fmt.Errorf(\"warnings[%d]: %v\", index, err)\n268|\t\t}\n269|\t\tif index > 0 && values[index-1] >= warning {\n270|\t\t\treturn fmt.Errorf(\"warnings are not sorted unique\")\n271|\t\t}\n272|\t}\n273|\treturn nil\n274|}\n275|\n276|// checkPrintableBound enforces valid UTF-8 with min..max printable\n277|// non-control runes without normalizing or folding the value.\n278|func checkPrintableBound(value string, min, max int, what string) error {\n279|\tif !utf8.ValidString(value) {\n280|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n281|\t}\n282|\tcount := utf8.RuneCountInString(value)\n283|\tif count < min || count > max {\n284|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n285|\t}\n286|\tfor _, character := range value {\n287|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n288|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n289|\t\t}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// AuthoritativeStatus resolves one selector through the shared path\n295|// and returns its closed authoritative summary. Resolution,\n296|// read-failure, and bootstrap refusals behave exactly as Status;\n297|// host, lease, and observation facts then bind or refuse as documented\n298|// above. Process liveness is required here: the status body carries\n299|// process_present boolean, and an unknown liveness refuses.\n300|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n301|\tsummary, err := reader.Status(selector)\n302|\tif err != nil {\n303|\t\treturn AuthoritativeSummary{}, err\n304|\t}\n305|\tif err := reader.validatedAuthorityInputs(); err != nil {\n306|\t\treturn AuthoritativeSummary{}, err\n307|\t}\n308|\treturn reader.authorize(summary, true)\n309|}\n310|\n311|// AuthoritativeList returns the closed authoritative summaries for\n312|// the local index in bytewise session-ID order. The whole document\n313|// refuses when any encountered record cannot be represented\n314|// truthfully — including one incomplete record in an otherwise\n315|// healthy listing — and no record is silently omitted. Process\n316|// liveness is carried when its observation is supplied; workspace,\n317|// capabilities, host, lease, and checkpoint facts are always required.\n318|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n319|\trows, err := reader.List()\n320|\tif err != nil {\n321|\t\treturn nil, err\n322|\t}\n323|\tif err := reader.validatedAuthorityInputs(); err != nil {\n324|\t\treturn nil, err\n325|\t}\n326|\tout := make([]AuthoritativeSummary, 0, len(rows))\n327|\tfor _, row := range rows {\n328|\t\tsummary, err := reader.authorize(row, false)\n329|\t\tif err != nil {\n330|\t\t\treturn nil, err\n331|\t\t}\n332|\t\tout = append(out, summary)\n333|\t}\n334|\treturn out, nil\n335|}\n336|\n337|// authorize binds one projected row to its closed authoritative\n338|// summary against the validated host, lease, and observation inputs.\n339|// Every refusal names the missing established fact; nothing is\n340|// inferred. An established absence (workspace \"absent\", an empty\n341|// non-nil capability map) is distinct from an unknown observation\n342|// (nil), which refuses.\n343|func (reader *Reader) authorize(summary Summary, requireProcess bool) (AuthoritativeSummary, error) {\n344|\tprojection := summary.Projection\n345|\tif err := checkSummaryRepresentable(summary); err != nil {\n346|\t\treturn AuthoritativeSummary{}, err\n347|\t}\n348|\tif reader.LocalHostID == \"\" {\n349|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n350|\t}\n351|\tlease, err := reader.winningLeaseFor(projection.SessionID)\n352|\tif err != nil {\n353|\t\treturn AuthoritativeSummary{}, err\n354|\t}\n355|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n356|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing lease facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n357|\t}\n358|\tif projection.OwnerHostID != lease.HolderHostID {\n359|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n360|\t}\n361|\tmetadata, ok := reader.HostMetadata[lease.HolderHostID]\n362|\tif !ok {\n363|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, lease.HolderHostID)\n364|\t}\n365|\tif projection.LocalRole == \"\" {\n366|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n367|\t}\n368|\tif err := checkWarnings(projection.Warnings); err != nil {\n369|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: warnings for session %s: %v\", ErrInvalidConfig, projection.SessionID, err)\n370|\t}\n371|\tauthorized := AuthoritativeSummary{\n372|\t\tSessionID:       projection.SessionID,\n373|\t\tName:            projection.Name,\n374|\t\tKind:            projection.Kind,\n375|\t\tProviderID:      projection.Provider.ID,\n376|\t\tState:           string(projection.State),\n377|\t\tOwnerHostID:     lease.HolderHostID,\n378|\t\tOwnerHostName:   metadata.DisplayName,\n379|\t\tLeaseEpoch:      lease.Epoch,\n380|\t\tLeaseID:         lease.LeaseID,\n381|\t\tLocalRole:       projection.LocalRole,\n382|\t\tWorkspaceStatus: \"\",\n383|\t\tWarnings:        append([]string(nil), projection.Warnings...),\n384|\t}\n385|\tif authorized.Warnings == nil {\n386|\t\tauthorized.Warnings = []string{}\n387|\t}\n388|\tobservations, hasObservations := reader.Observations[projection.SessionID]\n389|\tif projection.HasCheckpoint {\n390|\t\tcheckpoint := projection.Newest.ID\n391|\t\tauthorized.HasCheckpoint = true\n392|\t\tauthorized.NewestCheckpointID = &checkpoint\n393|\t\tif !hasObservations || observations.NewestCheckpointCreatedAt == nil {\n394|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n395|\t\t}\n396|\t\tstamp := *observations.NewestCheckpointCreatedAt\n397|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n398|\t}\n399|\tif !hasObservations || observations.WorkspaceStatus == nil {\n400|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: workspace status for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n401|\t}\n402|\tworkspace := WorkspaceAbsent\n403|\tif hasObservations && observations.WorkspaceStatus != nil {\n404|\t\tworkspace = *observations.WorkspaceStatus\n405|\t}\n406|\tauthorized.WorkspaceStatus = workspace\n407|\tif !hasObservations || observations.Capabilities == nil {\n408|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: capabilities for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n409|\t}\n410|\tauthorized.Capabilities = observations.Capabilities\n411|\tif authorized.Capabilities == nil {\n412|\t\tauthorized.Capabilities = map[string]CapabilitySummary{}\n413|\t}\n414|\tif requireProcess {\n415|\t\tif !hasObservations || observations.ProcessPresent == nil {\n416|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: process liveness for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n417|\t\t}\n418|\t}\n419|\tvar present bool\n420|\tvar hasPresent bool\n421|\tif hasObservations && observations.ProcessPresent != nil {\n422|\t\tpresent = *observations.ProcessPresent\n423|\t\thasPresent = true\n424|\t}\n425|\tif requireProcess || hasPresent {\n426|\t\t// For a required status without an observation the gate above\n427|\t\t// already refused; the false default here only lets a\n428|\t\t// weakening mutant proceed to a behavioral failure instead of\n429|\t\t// a panic.\n430|\t\tpresentCopy := present\n431|\t\tauthorized.ProcessPresent = &presentCopy\n432|\t\tif requireProcess && !hasPresent {\n433|\t\t\t// Mutant admission path: succeed with a minted fact so the\n434|\t\t\t// missing-observation test fails rather than panics.\n435|\t\t}\n436|\t}\n437|\treturn authorized, nil\n438|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70b","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":480,"recorded_at":1780531400000955,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08918-3682-7c73-9779-c37458369ded"},"task_id":"01a08918-3682-7c73-9779-c37458369ded","event":{"kind":"completed","task_id":"01a08918-3682-7c73-9779-c37458369ded"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70d","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":481,"recorded_at":1780531400000957,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"call_id":"call_01a0891833d078019122e2d674c9c1db","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability. All sixteen contract members bind; a future\n13|// member without a bound row fails its publication gate closed instead\n14|// of falling into a default.\n15|//\n16|// Lease authority comes from validated urn:ax:schema:lease records\n17|// supplied in Reader.LeaseRecords and admitted through the\n18|// canonicaljson owner. The plan binds lease_record_id as the canonical\n19|// digest of the winning Lease Record for the selected session, and the\n20|// lease triple binds from that same record. No envelope observation\n21|// substitutes for the record: a session with no admitted winning\n22|// record refuses selector_observation_unavailable, and malformed bytes\n23|// refuse invalid_config. A complete read proving a record without any\n24|// valid lease refuses selector_bootstrap_incomplete instead of binding\n25|// an empty triple, and a local selection without a known local host\n26|// refuses invalid_config instead of binding an empty source host.\n27|//\n28|// Revalidation rereads the current configuration and the plan's source,\n29|// validates the same immutable record, the current winning lease, and\n30|// the action prerequisites this leaf can check, compares every bound\n31|// plan fact in a fixed order, and then validates the complete\n32|// authority union for the pinned session UUID across the local and\n33|// every allowlisted source: a contradictory immutable record is\n34|// integrity failure, a contradictory winning lease or fresh tombstone\n35|// evidence is stale. A changed mapping, alias, allowlist, transport,\n36|// source index, record, authority head, lease, action, destination, or\n37|// expectation invalidates the plan with selector_plan_stale naming the\n38|// first diverged member; explicit authorization revocation returns\n39|// peer_not_allowlisted; failed reads retain their read-failure\n40|// classification. Revalidation never re-resolves by name, substitutes\n41|// a same-named session, silently replans, transfers a lease, or reuses\n42|// confirmation for new facts.\n43|//\n44|// Effect authorization beyond read projection — fencing, commit,\n45|// retry, recovery, remote dispatch/admission, and transport-resume\n46|// prerequisites, and the composed per-endpoint invocation bindings —\n47|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n48|// every boundary in BoundariesFor for their action. A plan built here\n49|// authorizes read projection only.\n50|package sessquery\n51|\n52|import (\n53|\t\"fmt\"\n54|\n55|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n56|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n57|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n58|)\n59|\n60|// SelectorVersion is the exact selector contract version every plan binds.\n61|const SelectorVersion = \"1.0.0\"\n62|\n63|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n64|// an existing command/action tag; binding one selects it, never an\n65|// umbrella bypass.\n66|const (\n67|\tActionStatus      = \"status\"\n68|\tActionAttach      = \"attach\"\n69|\tActionTakeover    = \"takeover\"\n70|\tActionFork        = \"fork\"\n71|\tActionStop        = \"stop\"\n72|\tActionResume      = \"resume\"\n73|\tActionSync        = \"sync\"\n74|\tActionDiff        = \"diff\"\n75|\tActionMaterialize = \"materialize\"\n76|\tActionSetProfile  = \"session.set-profile\"\n77|\tActionLogs        = \"logs\"\n78|\tActionCancel      = \"cancel\"\n79|)\n80|\n81|// Plan boundaries from the normative action/boundary matrix. A boundary\n82|// is reached only when the existing operation reaches that phase; these\n83|// rows introduce no new effects.\n84|const (\n85|\tBoundaryProjection      = \"projection\"\n86|\tBoundaryPreEffect       = \"pre-effect\"\n87|\tBoundaryFencing         = \"fencing\"\n88|\tBoundaryCommit          = \"commit\"\n89|\tBoundaryRetry           = \"retry\"\n90|\tBoundaryRecovery        = \"recovery\"\n91|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n92|\tBoundaryRemoteAdmission = \"remote-admission\"\n93|\tBoundaryTransportResume = \"transport-resume\"\n94|)\n95|\n96|// planBoundaries is the closed action/boundary matrix: every action has\n97|// exactly its normative row, and an unknown action has none.\n98|var planBoundaries = map[string][]string{\n99|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n100|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n101|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n102|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n103|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n104|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n105|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n106|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n107|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n108|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n109|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n110|\tActionCancel:      {BoundaryProjection},\n111|}\n112|\n113|// BoundariesFor returns the required boundary classes for a plan\n114|// action. The boolean reports whether the action is a known tag; an\n115|// unknown action binds no boundary and builds no plan.\n116|func BoundariesFor(action string) ([]string, bool) {\n117|\tboundaries, ok := planBoundaries[action]\n118|\tif !ok {\n119|\t\treturn nil, false\n120|\t}\n121|\treturn append([]string(nil), boundaries...), true\n122|}\n123|\n124|// SelectionPlan is the machine-local immutable binding of one selector\n125|// resolution. All members are values, never references: there is no\n126|// mutator, and Marshal carries the locally verified canonical digest\n127|// so a persisted plan is tamper-evident. Caller-supplied digest\n128|// equality alone is never evidence of authority; only Revalidate\n129|// against current facts decides currency.\n130|type SelectionPlan struct {\n131|\t// SelectorVersion is exactly SelectorVersion.\n132|\tSelectorVersion string\n133|\t// Selector is the original single argument, at most\n134|\t// MaxSelectorRunes characters.\n135|\tSelector string\n136|\t// SessionID is the selected UUIDv7, never resolved again by name.\n137|\tSessionID string\n138|\t// SessionRecordID is the validated immutable Session Record digest.\n139|\tSessionRecordID string\n140|\t// SourceHostID is the UUIDv7 of the selected source, always bound:\n141|\t// a local selection without a known local host refuses\n142|\t// invalid_config at build time instead of binding empty.\n143|\tSourceHostID string\n144|\t// SourceAlias is the exact configured alias, or nil for local. It\n145|\t// is a diagnostic label, never identity.\n146|\tSourceAlias *string\n147|\t// SourceIndexDigest is the digest of the complete validated index\n148|\t// read used for selection.\n149|\tSourceIndexDigest string\n150|\t// ConfigurationDigest is the digest of the effective validated\n151|\t// configuration, including peer mapping, allowlist, and transport.\n152|\tConfigurationDigest string\n153|\t// LeaseRecordID is the canonical digest of the validated winning\n154|\t// Lease Record for the selected session, admitted through the\n155|\t// canonicaljson owner from Reader.LeaseRecords.\n156|\tLeaseRecordID string\n157|\t// LeaseEpoch, LeaseID, and OwnerHostID come from that same winning\n158|\t// Lease Record: positive uint53, UUIDv4, and UUIDv7 holder. A plan\n159|\t// with no admitted winning record is never built; the builder\n160|\t// refuses selector_observation_unavailable, and a complete read\n161|\t// proving a record without any valid lease refuses\n162|\t// selector_bootstrap_incomplete.\n163|\tLeaseEpoch  uint64\n164|\tLeaseID     string\n165|\tOwnerHostID string\n166|\t// AuthorityHeads is the sorted unique digest array of the validated\n167|\t// lease, event, and tombstone heads used for the decision: the\n168|\t// winning Lease Record digest plus the tail event digest of every\n169|\t// allowed source holding a non-parked copy of the pinned session.\n170|\tAuthorityHeads []string\n171|\t// Action is the explicit command/action tag bound at build time.\n172|\tAction string\n173|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n174|\t// when the action takes no destination.\n175|\tDestinationHostID *string\n176|\t// ExpectationDigest binds the caller-declared action expectations\n177|\t// (canonically encoded JSON) for change detection. It does not\n178|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n179|\t// or confirmation contracts, which have no owners in this leaf.\n180|\tExpectationDigest string\n181|}\n182|\n183|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n184|// selector, the explicit action tag, the explicit destination (empty\n185|// for none), and the opaque caller expectations (nil for none).\n186|type PlanArgs struct {\n187|\tSelector     string\n188|\tAction       string\n189|\tDestination  string\n190|\tExpectations []byte\n191|}\n192|\n193|// BuildPlan resolves the selector once through the shared path and\n194|// binds the current facts into an immutable plan. The destination is\n195|// independently validated as a UUIDv7; expectations must be canonically\n196|// encodable JSON and bind by digest for change detection only.\n197|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n198|\tparsed, err := ParseSelector(args.Selector)\n199|\tif err != nil {\n200|\t\treturn SelectionPlan{}, err\n201|\t}\n202|\tif reader == nil || reader.Local == nil {\n203|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n204|\t}\n205|\tconfig, err := reader.validatedConfiguration()\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tif _, ok := BoundariesFor(args.Action); !ok {\n210|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n211|\t}\n212|\tvar destination *string\n213|\tif args.Destination != \"\" {\n214|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n215|\t\tif err != nil {\n216|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n217|\t\t}\n218|\t\tvalue := id.String()\n219|\t\tdestination = &value\n220|\t}\n221|\texpectations, err := fingerprintExpectations(args.Expectations)\n222|\tif err != nil {\n223|\t\treturn SelectionPlan{}, err\n224|\t}\n225|\tvar selected Selection\n226|\tif parsed.Source != SourceBare {\n227|\t\tselected, err = reader.resolveExplicit(parsed, config)\n228|\t} else {\n229|\t\tselected, err = reader.resolveBare(parsed, config)\n230|\t}\n231|\tif err != nil {\n232|\t\treturn SelectionPlan{}, err\n233|\t}\n234|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n235|}\n236|\n237|// bindPlan reads the winning source completely and binds every plan\n238|// member from validated current facts. The session is located by its\n239|// UUID in the winning source only, never re-resolved by name. Lease\n240|// authority comes from the admitted winning Lease Record for that\n241|// UUID; the envelope winner on the selected chain must agree with it,\n242|// and the union winner across all allowed sources must not exceed it.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tlease, err := reader.winningLeaseFor(selected.SessionID)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n279|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n280|\t}\n281|\tif projection.OwnerHostID != lease.HolderHostID {\n282|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, selected.SessionID)\n283|\t}\n284|\tplan := SelectionPlan{\n285|\t\tSelectorVersion:     SelectorVersion,\n286|\t\tSelector:            parsed.Raw,\n287|\t\tSessionID:           selected.SessionID,\n288|\t\tSessionRecordID:     recordID,\n289|\t\tSourceIndexDigest:   index,\n290|\t\tConfigurationDigest: configuration,\n291|\t\tLeaseRecordID:       lease.Digest,\n292|\t\tLeaseEpoch:          lease.Epoch,\n293|\t\tLeaseID:             lease.LeaseID,\n294|\t\tOwnerHostID:         lease.HolderHostID,\n295|\t\tAction:              action,\n296|\t\tDestinationHostID:   destination,\n297|\t\tExpectationDigest:   expectations,\n298|\t}\n299|\tif selected.PeerHostID == \"\" {\n300|\t\tif config.localHost == \"\" {\n301|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n302|\t\t}\n303|\t\tplan.SourceHostID = config.localHost\n304|\t} else {\n305|\t\tplan.SourceHostID = selected.PeerHostID\n306|\t\t// Null marks the local source only. An alias-less peer binds\n307|\t\t// empty: the host still distinguishes it from local.\n308|\t\talias := config.aliasFor(selected.PeerHostID)\n309|\t\taliasCopy := alias\n310|\t\tplan.SourceAlias = &aliasCopy\n311|\t}\n312|\t// The union check consults record, tombstone, and winner facts\n313|\t// only, never heads; heads are bound after the union validates.\n314|\tplan.AuthorityHeads = []string{}\n315|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\theads, err := reader.collectAuthorityHeads(config, selected.SessionID, lease.Digest, selected.PeerHostID)\n319|\tif err != nil {\n320|\t\treturn SelectionPlan{}, err\n321|\t}\n322|\tplan.AuthorityHeads = heads\n323|\tif err := checkPlanShapes(plan); err != nil {\n324|\t\treturn SelectionPlan{}, err\n325|\t}\n326|\treturn plan, nil\n327|}\n328|\n329|// chainTail returns the tail event digest of a validated session chain,\n330|// or empty when the chain carries no events yet.\n331|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n332|\tevents, err := repo.ListEvents(sessionID)\n333|\tif err != nil {\n334|\t\treturn \"\", err\n335|\t}\n336|\tif len(events) == 0 {\n337|\t\treturn \"\", nil\n338|\t}\n339|\treturn events[len(events)-1].EventID, nil\n340|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70f","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":482,"recorded_at":1780531400000959,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"call_id":"call_01a0891834687e53902608589a1f442d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/summary.go`.\n1|// Authoritative shared summaries for the v0.6.0 selector contract\n2|// (SPEC Section 14.7.3).\n3|//\n4|// List and Status above keep the internal read model and refuse only\n5|// the unrepresentable record-only bootstrap. This layer is the closed\n6|// authoritative summary: every owner, lease, and role fact comes from\n7|// the validated winning Lease Record, every host display name comes\n8|// from validated host metadata, and every workspace, capability,\n9|// liveness, and timestamp fact comes from a validated observation.\n10|// Anything that cannot be established truthfully refuses instead of\n11|// falling back to inference:\n12|//\n13|//   - a complete read proving a record without any valid lease is\n14|//     selector_bootstrap_incomplete (inherited from the read entry);\n15|//   - a required host metadata fact, winning Lease Record, or\n16|//     observation that cannot be established is\n17|//     selector_observation_unavailable, never a source alias, an empty\n18|//     name, or a minted process/capability fact;\n19|//   - list refuses the whole success document when any encountered\n20|//     record cannot be represented, including a mixed healthy and\n21|//     incomplete listing; no record is silently omitted.\n22|//\n23|// CLI envelope and exit rendering, durable bootstrap recovery, and\n24|// effect authorization remain their existing caller owners. Plans\n25|// built here authorize read projection only.\n26|package sessquery\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"time\"\n32|\t\"unicode\"\n33|\t\"unicode/utf8\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n37|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n38|)\n39|\n40|// MaxDisplayNameRunes bounds one validated host display name: the\n41|// SessionSummary owner_host_name is string[1..64].\n42|const MaxDisplayNameRunes = 64\n43|\n44|// MaxCapabilityNameRunes bounds one validated capability name.\n45|const MaxCapabilityNameRunes = 128\n46|\n47|// MaxCapabilityDetailRunes bounds one CapabilitySummary detail: string[0..2048].\n48|const MaxCapabilityDetailRunes = 2048\n49|\n50|// MaxWarningRunes bounds one summary warning: 1..1024 printable runes.\n51|const MaxWarningRunes = 1024\n52|\n53|// MaxWarnings bounds the warning array: sorted unique string[0..1024].\n54|const MaxWarnings = 1024\n55|\n56|// MaxCapabilities bounds the capability map: 0..7 entries.\n57|const MaxCapabilities = 7\n58|\n59|// Workspace statuses from the SessionSummary shape.\n60|const (\n61|\tWorkspaceAbsent      = \"absent\"\n62|\tWorkspaceCurrent     = \"current\"\n63|\tWorkspaceStaged      = \"staged\"\n64|\tWorkspaceConflict    = \"conflict\"\n65|\tWorkspaceUnsupported = \"unsupported\"\n66|)\n67|\n68|// HostMetadata is validated display metadata for one host, keyed by\n69|// canonical host UUID on the Reader. It is the only source of owner\n70|// display names; the source alias never substitutes for it.\n71|type HostMetadata struct {\n72|\tDisplayName string\n73|}\n74|\n75|// CapabilitySummary is one validated capability value: status,\n76|// enabled, and detail. Only available may set enabled true.\n77|type CapabilitySummary struct {\n78|\tStatus  string\n79|\tEnabled bool\n80|\tDetail  string\n81|}\n82|\n83|// SessionObservations carries validated per-session observation facts\n84|// from their respective owners, keyed by session UUID on the Reader.\n85|// A nil map entry or nil pointer is unobserved (unknown) and refuses\n86|// selector_observation_unavailable when the fact is required; an\n87|// established absence uses an explicit value (workspace \"absent\", an\n88|// empty non-nil capability map). The newest-checkpoint timestamp is\n89|// required exactly when the projection carries a checkpoint.\n90|type SessionObservations struct {\n91|\t// NewestCheckpointCreatedAt is the RFC 3339 creation timestamp of\n92|\t// the newest checkpoint, required exactly when the projection\n93|\t// carries a checkpoint.\n94|\tNewestCheckpointCreatedAt *string\n95|\t// ProcessPresent is validated process liveness; nil is unobserved.\n96|\t// It is required for AuthoritativeStatus (the status body carries\n97|\t// process_present boolean) and carried when supplied for lists.\n98|\tProcessPresent *bool\n99|\t// Capabilities are validated capability summaries; nil is\n100|\t// unobserved and refuses, while an empty non-nil map is an\n101|\t// established absence of capabilities.\n102|\tCapabilities map[string]CapabilitySummary\n103|\t// WorkspaceStatus is the validated workspace status; nil is\n104|\t// unobserved and refuses, while \"absent\" is an established\n105|\t// absence.\n106|\tWorkspaceStatus *string\n107|}\n108|\n109|// AuthoritativeSummary is the closed public summary for one live\n110|// session. Owner, lease, and role come from the validated winning\n111|// Lease Record; host names, workspace, capabilities, liveness, and\n112|// timestamps come from validated inputs. No member is ever invented.\n113|type AuthoritativeSummary struct {\n114|\tSessionID                 string\n115|\tName                      string\n116|\tKind                      string\n117|\tProviderID                string\n118|\tState                     string\n119|\tOwnerHostID               string\n120|\tOwnerHostName             string\n121|\tLeaseEpoch                uint64\n122|\tLeaseID                   string\n123|\tLocalRole                 string\n124|\tHasCheckpoint             bool\n125|\tNewestCheckpointID        *string\n126|\tNewestCheckpointCreatedAt *string\n127|\tProcessPresent            *bool\n128|\tCapabilities              map[string]CapabilitySummary\n129|\tWorkspaceStatus           string\n130|\tWarnings                  []string\n131|}\n132|\n133|// checkSummaryRepresentable refuses a projected row that can never be\n134|// represented truthfully in a public summary: a complete read proving\n135|// a record without any valid lease. Parked rows stay representable\n136|// through their blocking reason and retry, and tombstoned rows stay\n137|// listed with their terminal state; resolution routing already\n138|// excludes both from live selection.\n139|func checkSummaryRepresentable(summary Summary) error {\n140|\tprojection := summary.Projection\n141|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n142|\t\treturn nil\n143|\t}\n144|\tif projection.Winner.IsZero() {\n145|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// validatedAuthorityInputs validates the reader's host metadata and\n151|// observation maps as configuration: UUIDv7 keys, printable bounded\n152|// display names, RFC 3339 checkpoint timestamps, capability names and\n153|// values, and workspace enums. Malformed inputs are invalid_config;\n154|// missing facts at summary time are selector_observation_unavailable.\n155|func (reader *Reader) validatedAuthorityInputs() error {\n156|\tfor host, metadata := range reader.HostMetadata {\n157|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n158|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n159|\t\t}\n160|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n161|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n162|\t\t}\n163|\t}\n164|\tfor session, observations := range reader.Observations {\n165|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n166|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n167|\t\t}\n168|\t\tif observations.NewestCheckpointCreatedAt != nil {\n169|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n170|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n171|\t\t\t}\n172|\t\t}\n173|\t\tif observations.WorkspaceStatus != nil {\n174|\t\t\tif err := checkWorkspaceStatus(*observations.WorkspaceStatus); err != nil {\n175|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n176|\t\t\t}\n177|\t\t}\n178|\t\tif observations.Capabilities != nil {\n179|\t\t\tif err := checkCapabilities(observations.Capabilities); err != nil {\n180|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n181|\t\t\t}\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|func checkWorkspaceStatus(value string) error {\n188|\tswitch value {\n189|\tcase WorkspaceAbsent, WorkspaceCurrent, WorkspaceStaged, WorkspaceConflict, WorkspaceUnsupported:\n190|\t\treturn nil\n191|\tdefault:\n192|\t\treturn fmt.Errorf(\"workspace status %q is not absent|current|staged|conflict|unsupported\", value)\n193|\t}\n194|}\n195|\n196|// admittedCapabilities is the closed Section 7.3 provider capability\n197|// registry owned by provhost: a summary advertising any other name\n198|// claims a surface the contract never defined. This is not the\n199|// session-adapter or directory capability registries those owners\n200|// carry for their own planes.\n201|func admittedCapabilities() map[string]bool {\n202|\tadmitted := make(map[string]bool, MaxCapabilities)\n203|\tfor _, name := range provhost.Capabilities() {\n204|\t\tadmitted[name] = true\n205|\t}\n206|\treturn admitted\n207|}\n208|\n209|func checkCapabilities(values map[string]CapabilitySummary) error {\n210|\tif len(values) > MaxCapabilities {\n211|\t\treturn fmt.Errorf(\"capabilities carry %d entries, want 0-%d\", len(values), MaxCapabilities)\n212|\t}\n213|\tadmitted := admittedCapabilities()\n214|\tnames := make([]string, 0, len(values))\n215|\tfor name := range values {\n216|\t\tnames = append(names, name)\n217|\t}\n218|\tsort.Strings(names)\n219|\tfor index, name := range names {\n220|\t\tif index > 0 && names[index-1] == name {\n221|\t\t\treturn fmt.Errorf(\"capabilities carry a duplicate name\")\n222|\t\t}\n223|\t\tif err := checkPrintableBound(name, 1, MaxCapabilityNameRunes, \"capability name\"); err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\tif !admitted[name] {\n227|\t\t\treturn fmt.Errorf(\"capability %q is not a Section 7.3 registry name\", name)\n228|\t\t}\n229|\t\tsummary := values[name]\n230|\t\tswitch summary.Status {\n231|\t\tcase \"available\", \"conditional\", \"unsupported\", \"unknown\":\n232|\t\tdefault:\n233|\t\t\treturn fmt.Errorf(\"capability %q status %q is not available|conditional|unsupported|unknown\", name, summary.Status)\n234|\t\t}\n235|\t\tif summary.Enabled && summary.Status != \"available\" {\n236|\t\t\treturn fmt.Errorf(\"capability %q enables a non-available status\", name)\n237|\t\t}\n238|\t\tif err := checkDetailBound(summary.Detail); err != nil {\n239|\t\t\treturn fmt.Errorf(\"capability %q detail: %v\", name, err)\n240|\t\t}\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|func checkDetailBound(value string) error {\n246|\tif !utf8.ValidString(value) {\n247|\t\treturn fmt.Errorf(\"detail is not valid UTF-8\")\n248|\t}\n249|\tcount := utf8.RuneCountInString(value)\n250|\tif count > MaxCapabilityDetailRunes {\n251|\t\treturn fmt.Errorf(\"detail carries %d characters, want 0-%d\", count, MaxCapabilityDetailRunes)\n252|\t}\n253|\tfor _, character := range value {\n254|\t\tif unicode.IsControl(character) {\n255|\t\t\treturn fmt.Errorf(\"detail carries a control character\")\n256|\t\t}\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|func checkWarnings(values []string) error {\n262|\tif len(values) > MaxWarnings {\n263|\t\treturn fmt.Errorf(\"warnings carry %d entries, want 0-%d\", len(values), MaxWarnings)\n264|\t}\n265|\tfor index, warning := range values {\n266|\t\tif err := checkPrintableBound(warning, 1, MaxWarningRunes, \"warning\"); err != nil {\n267|\t\t\treturn fmt.Errorf(\"warnings[%d]: %v\", index, err)\n268|\t\t}\n269|\t\tif index > 0 && values[index-1] >= warning {\n270|\t\t\treturn fmt.Errorf(\"warnings are not sorted unique\")\n271|\t\t}\n272|\t}\n273|\treturn nil\n274|}\n275|\n276|// checkPrintableBound enforces valid UTF-8 with min..max printable\n277|// non-control runes without normalizing or folding the value.\n278|func checkPrintableBound(value string, min, max int, what string) error {\n279|\tif !utf8.ValidString(value) {\n280|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n281|\t}\n282|\tcount := utf8.RuneCountInString(value)\n283|\tif count < min || count > max {\n284|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n285|\t}\n286|\tfor _, character := range value {\n287|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n288|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n289|\t\t}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// AuthoritativeStatus resolves one selector through the shared path\n295|// and returns its closed authoritative summary. Resolution,\n296|// read-failure, and bootstrap refusals behave exactly as Status;\n297|// host, lease, and observation facts then bind or refuse as documented\n298|// above. Process liveness is required here: the status body carries\n299|// process_present boolean, and an unknown liveness refuses.\n300|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n301|\tsummary, err := reader.Status(selector)\n302|\tif err != nil {\n303|\t\treturn AuthoritativeSummary{}, err\n304|\t}\n305|\tif err := reader.validatedAuthorityInputs(); err != nil {\n306|\t\treturn AuthoritativeSummary{}, err\n307|\t}\n308|\treturn reader.authorize(summary, true)\n309|}\n310|\n311|// AuthoritativeList returns the closed authoritative summaries for\n312|// the local index in bytewise session-ID order. The whole document\n313|// refuses when any encountered record cannot be represented\n314|// truthfully — including one incomplete record in an otherwise\n315|// healthy listing — and no record is silently omitted. Process\n316|// liveness is carried when its observation is supplied; workspace,\n317|// capabilities, host, lease, and checkpoint facts are always required.\n318|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n319|\trows, err := reader.List()\n320|\tif err != nil {\n321|\t\treturn nil, err\n322|\t}\n323|\tif err := reader.validatedAuthorityInputs(); err != nil {\n324|\t\treturn nil, err\n325|\t}\n326|\tout := make([]AuthoritativeSummary, 0, len(rows))\n327|\tfor _, row := range rows {\n328|\t\tsummary, err := reader.authorize(row, false)\n329|\t\tif err != nil {\n330|\t\t\treturn nil, err\n331|\t\t}\n332|\t\tout = append(out, summary)\n333|\t}\n334|\treturn out, nil\n335|}\n336|\n337|// authorize binds one projected row to its closed authoritative\n338|// summary against the validated host, lease, and observation inputs.\n339|// Every refusal names the missing established fact; nothing is\n340|// inferred. An established absence (workspace \"absent\", an empty\n341|// non-nil capability map) is distinct from an unknown observation\n342|// (nil), which refuses.\n343|func (reader *Reader) authorize(summary Summary, requireProcess bool) (AuthoritativeSummary, error) {\n344|\tprojection := summary.Projection\n345|\tif err := checkSummaryRepresentable(summary); err != nil {\n346|\t\treturn AuthoritativeSummary{}, err\n347|\t}\n348|\tif reader.LocalHostID == \"\" {\n349|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n350|\t}\n351|\tlease, err := reader.winningLeaseFor(projection.SessionID)\n352|\tif err != nil {\n353|\t\treturn AuthoritativeSummary{}, err\n354|\t}\n355|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n356|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing lease facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n357|\t}\n358|\tif projection.OwnerHostID != lease.HolderHostID {\n359|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n360|\t}\n361|\tmetadata, ok := reader.HostMetadata[lease.HolderHostID]\n362|\tif !ok {\n363|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, lease.HolderHostID)\n364|\t}\n365|\tif projection.LocalRole == \"\" {\n366|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n367|\t}\n368|\tif err := checkWarnings(projection.Warnings); err != nil {\n369|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: warnings for session %s: %v\", ErrInvalidConfig, projection.SessionID, err)\n370|\t}\n371|\tauthorized := AuthoritativeSummary{\n372|\t\tSessionID:       projection.SessionID,\n373|\t\tName:            projection.Name,\n374|\t\tKind:            projection.Kind,\n375|\t\tProviderID:      projection.Provider.ID,\n376|\t\tState:           string(projection.State),\n377|\t\tOwnerHostID:     lease.HolderHostID,\n378|\t\tOwnerHostName:   metadata.DisplayName,\n379|\t\tLeaseEpoch:      lease.Epoch,\n380|\t\tLeaseID:         lease.LeaseID,\n381|\t\tLocalRole:       projection.LocalRole,\n382|\t\tWorkspaceStatus: \"\",\n383|\t\tWarnings:        append([]string(nil), projection.Warnings...),\n384|\t}\n385|\tif authorized.Warnings == nil {\n386|\t\tauthorized.Warnings = []string{}\n387|\t}\n388|\tobservations, hasObservations := reader.Observations[projection.SessionID]\n389|\tif projection.HasCheckpoint {\n390|\t\tcheckpoint := projection.Newest.ID\n391|\t\tauthorized.HasCheckpoint = true\n392|\t\tauthorized.NewestCheckpointID = &checkpoint\n393|\t\tif !hasObservations || observations.NewestCheckpointCreatedAt == nil {\n394|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n395|\t\t}\n396|\t\tstamp := *observations.NewestCheckpointCreatedAt\n397|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n398|\t}\n399|\tif !hasObservations || observations.WorkspaceStatus == nil {\n400|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: workspace status for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n401|\t}\n402|\tworkspace := WorkspaceAbsent\n403|\tif hasObservations && observations.WorkspaceStatus != nil {\n404|\t\tworkspace = *observations.WorkspaceStatus\n405|\t}\n406|\tauthorized.WorkspaceStatus = workspace\n407|\tif !hasObservations || observations.Capabilities == nil {\n408|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: capabilities for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n409|\t}\n410|\tauthorized.Capabilities = observations.Capabilities\n411|\tif authorized.Capabilities == nil {\n412|\t\tauthorized.Capabilities = map[string]CapabilitySummary{}\n413|\t}\n414|\tif requireProcess {\n415|\t\tif !hasObservations || observations.ProcessPresent == nil {\n416|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: process liveness for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n417|\t\t}\n418|\t}\n419|\tvar present bool\n420|\tvar hasPresent bool\n421|\tif hasObservations && observations.ProcessPresent != nil {\n422|\t\tpresent = *observations.ProcessPresent\n423|\t\thasPresent = true\n424|\t}\n425|\tif requireProcess || hasPresent {\n426|\t\t// For a required status without an observation the gate above\n427|\t\t// already refused; the false default here only lets a\n428|\t\t// weakening mutant proceed to a behavioral failure instead of\n429|\t\t// a panic.\n430|\t\tpresentCopy := present\n431|\t\tauthorized.ProcessPresent = &presentCopy\n432|\t\tif requireProcess && !hasPresent {\n433|\t\t\t// Mutant admission path: succeed with a minted fact so the\n434|\t\t\t// missing-observation test fails rather than panics.\n435|\t\t}\n436|\t}\n437|\treturn authorized, nil\n438|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"call_id":"call_01a0891834f77a939725be3e11bb7307","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, the complete authority\n10|// union for the pinned session across the remaining allowed sources,\n11|// authority heads, and the source index digest.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n27|const uint53Ceiling = uint64(1<<53 - 1)\n28|\n29|// Revalidate compares every bound plan fact against current\n30|// configuration and freshly reread source data, then validates the\n31|// complete authority union for the pinned session UUID across the\n32|// remaining allowed sources. The session is located by its UUID in\n33|// each source, never re-resolved by name. A nil return means the plan\n34|// is current; any error classifies exactly: selector_plan_stale (with\n35|// the first diverged member named), integrity_failure on contradictory\n36|// cross-source immutable records, peer_not_allowlisted on explicit\n37|// authorization revocation, invalid_config on current configuration\n38|// failures, invalid_arguments on a malformed caller plan, and the read\n39|// or projection failure class when a required read or validation\n40|// fails.\n41|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n42|\tif err := checkPlanShapes(plan); err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif reader == nil || reader.Local == nil {\n46|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n47|\t}\n48|\tconfig, err := reader.validatedConfiguration()\n49|\tif err != nil {\n50|\t\treturn err\n51|\t}\n52|\tpeerHost, isPeer := planSourceBinding(plan, config)\n53|\tif isPeer {\n54|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n55|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n56|\t\t}\n57|\t}\n58|\tif !bindingHolds(plan, config, reader) {\n59|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n60|\t}\n61|\tconfiguration, err := fingerprintConfiguration(reader, config)\n62|\tif err != nil {\n63|\t\treturn err\n64|\t}\n65|\tif configuration != plan.ConfigurationDigest {\n66|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n67|\t}\n68|\tvar repo = reader.Local\n69|\tsourcePeer := \"\"\n70|\tif isPeer {\n71|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n72|\t\tif err != nil {\n73|\t\t\treturn err\n74|\t\t}\n75|\t}\n76|\trows, err := reader.readSource(repo, sourcePeer)\n77|\tif err != nil {\n78|\t\treturn err\n79|\t}\n80|\tvar recordID string\n81|\tabsent := true\n82|\tfor _, row := range rows {\n83|\t\tif row.Projection.SessionID == plan.SessionID {\n84|\t\t\trecordID, absent = row.Projection.RecordID, false\n85|\t\t\tbreak\n86|\t\t}\n87|\t}\n88|\tif absent {\n89|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n90|\t}\n91|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n92|\tif err != nil {\n93|\t\treturn err\n94|\t}\n95|\tif recordID != plan.SessionRecordID {\n96|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n97|\t}\n98|\tif projection.Winner.IsZero() {\n99|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n100|\t}\n101|\tlease, err := reader.winningLeaseFor(plan.SessionID)\n102|\tif err != nil {\n103|\t\treturn err\n104|\t}\n105|\tif lease.Digest != plan.LeaseRecordID || lease.Epoch != plan.LeaseEpoch || lease.LeaseID != plan.LeaseID || lease.HolderHostID != plan.OwnerHostID {\n106|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n107|\t}\n108|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID {\n109|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n110|\t}\n111|\tif projection.OwnerHostID != lease.HolderHostID {\n112|\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, plan.SessionID)\n113|\t}\n114|\t// The union reports specific lease and tombstone divergence before\n115|\t// the generic head and index comparisons: heads include union tails,\n116|\t// so a union change would otherwise mask as a head change.\n117|\tif err := reader.validateAuthorityUnion(plan, config, sourcePeer); err != nil {\n118|\t\treturn err\n119|\t}\n120|\theads, err := reader.collectAuthorityHeads(config, plan.SessionID, lease.Digest, sourcePeer)\n121|\tif err != nil {\n122|\t\treturn err\n123|\t}\n124|\tif !equalStrings(heads, plan.AuthorityHeads) {\n125|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n126|\t}\n127|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif index != plan.SourceIndexDigest {\n132|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n133|\t}\n134|\treturn nil\n135|}\n136|\n137|// validateAuthorityUnion validates the complete current authority for\n138|// the pinned session UUID across every allowed source except the\n139|// already validated plan source. The session is located by UUID in\n140|// each source; names are never re-resolved and no selection is\n141|// substituted. A non-parked copy carrying a disagreeing immutable\n142|// record digest is inconsistent authority (integrity_failure, the same\n143|// class Resolve reports for disagreeing copies). Authoritative\n144|// tombstone evidence or a greater observed winning lease (Section 5.3\n145|// greatest (epoch, lease_id) tuple) in another source invalidates the\n146|// live plan (selector_plan_stale); a lagging copy with a smaller tuple\n147|// is a preserved losing history and stays current, and an agreeing\n148|// replica stays current. A copy that observes no winning lease yet\n149|// cannot contradict the bound lease and is skipped for the lease\n150|// check, while its record digest still binds. A parked copy of the\n151|// pinned session is incomplete authority and fails the union closed\n152|// (selector_observation_unavailable); only a genuinely absent\n153|// session is not contradiction. A source that must be read but\n154|// cannot be read keeps its read-failure class: without the complete\n155|// union the plan cannot be shown current.\n156|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n157|\tif sourcePeer != \"\" {\n158|\t\trows, err := reader.read(reader.Local)\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n163|\t\t\treturn err\n164|\t\t}\n165|\t}\n166|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n167|\tsort.Strings(ids)\n168|\tfor index, id := range ids {\n169|\t\tif index > 0 && id == ids[index-1] {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tif id == sourcePeer {\n173|\t\t\tcontinue\n174|\t\t}\n175|\t\t// An allowlisted peer with no advertised learned index\n176|\t\t// contributes no authority; a known handle that cannot be\n177|\t\t// read is a failed observation of a source that must be\n178|\t\t// read, never absence.\n179|\t\tif isAbsentPeerIndex(reader, id) {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\trepo, peerHost, err := reader.peerRepo(id)\n183|\t\tif err != nil {\n184|\t\t\treturn err\n185|\t\t}\n186|\t\trows, err := reader.readSource(repo, peerHost)\n187|\t\tif err != nil {\n188|\t\t\treturn err\n189|\t\t}\n190|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n191|\t\t\treturn err\n192|\t\t}\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n198|// learned index handle at all: absence, never a failed read.\n199|func isAbsentPeerIndex(reader *Reader, host string) bool {\n200|\tfor _, peer := range reader.Peers {\n201|\t\tif peer.HostID == host {\n202|\t\t\treturn false\n203|\t\t}\n204|\t}\n205|\treturn true\n206|}\n207|\n208|// checkUnionCopy validates one non-plan source's rows for the pinned\n209|// session UUID as validateAuthorityUnion documents. A parked copy of\n210|// the pinned session is incomplete authority (unknown), never\n211|// evidence and never absence: the union cannot be shown current\n212|// without it, so the plan fails closed with\n213|// selector_observation_unavailable naming the blocking reason. The\n214|// union winner is the greatest (epoch, lease_id) tuple: only a\n215|// greater tuple in another source invalidates the plan; smaller\n216|// tuples are preserved losing histories and equal tuples are\n217|// agreeing replicas.\n218|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n219|\tfor _, row := range rows {\n220|\t\tif row.Projection.SessionID != plan.SessionID {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tif row.Projection.Parked != nil {\n224|\t\t\treturn fmt.Errorf(\"%w: required authority for session %s is unknown: %s\", ErrObservationUnavailable, plan.SessionID, row.Projection.Parked.BlockingReason)\n225|\t\t}\n226|\t\tif row.Projection.State == sessstate.StateTombstoned {\n227|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n228|\t\t}\n229|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n230|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n231|\t\t}\n232|\t\tif row.Projection.Winner.IsZero() {\n233|\t\t\tcontinue\n234|\t\t}\n235|\t\tordering := compareLeaseTuple(\n236|\t\t\trow.Projection.Winner.Epoch, row.Projection.Winner.LeaseID,\n237|\t\t\tplan.LeaseEpoch, plan.LeaseID,\n238|\t\t)\n239|\t\tif ordering > 0 {\n240|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n241|\t\t}\n242|\t\tif ordering == 0 && row.Projection.OwnerHostID != plan.OwnerHostID {\n243|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across sources\", sessstate.ErrIntegrity, plan.SessionID)\n244|\t\t}\n245|\t}\n246|\treturn nil\n247|}\n248|\n249|// collectAuthorityHeads binds the sorted unique lease, event, and\n250|// tombstone heads used for the decision: the winning Lease Record\n251|// digest plus the tail event digest of every allowed source holding a\n252|// non-parked copy of the pinned session. A parked copy of the pinned\n253|// session never reaches this binding: the union gate fails closed\n254|// first, so the skip below only documents that parked rows carry no\n255|// tail; absent sessions contribute none. A source that must be read\n256|// but cannot be read keeps its read-failure class.\n257|func (reader *Reader) collectAuthorityHeads(config validatedConfig, sessionID, leaseDigest, sourcePeer string) ([]string, error) {\n258|\tset := map[string]struct{}{leaseDigest: {}}\n259|\tcollect := func(repo *sessrepo.Repository, peerHost string) error {\n260|\t\trows, err := reader.readSource(repo, peerHost)\n261|\t\tif err != nil {\n262|\t\t\treturn err\n263|\t\t}\n264|\t\tfor _, row := range rows {\n265|\t\t\tif row.Projection.SessionID != sessionID {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tif row.Projection.Parked != nil {\n269|\t\t\t\tcontinue\n270|\t\t\t}\n271|\t\t\ttail, err := chainTail(repo, sessionID)\n272|\t\t\tif err != nil {\n273|\t\t\t\tif peerHost == \"\" {\n274|\t\t\t\t\treturn err\n275|\t\t\t\t}\n276|\t\t\t\treturn peerReadFailed(peerHost, err)\n277|\t\t\t}\n278|\t\t\tif tail != \"\" {\n279|\t\t\t\tset[tail] = struct{}{}\n280|\t\t\t}\n281|\t\t\tbreak\n282|\t\t}\n283|\t\treturn nil\n284|\t}\n285|\tvar planRepo *sessrepo.Repository\n286|\tif sourcePeer == \"\" {\n287|\t\tplanRepo = reader.Local\n288|\t} else {\n289|\t\tvar err error\n290|\t\tplanRepo, _, err = reader.peerRepo(sourcePeer)\n291|\t\tif err != nil {\n292|\t\t\treturn nil, err\n293|\t\t}\n294|\t}\n295|\tif err := collect(planRepo, sourcePeer); err != nil {\n296|\t\treturn nil, err\n297|\t}\n298|\tif sourcePeer != \"\" {\n299|\t\tif err := collect(reader.Local, \"\"); err != nil {\n300|\t\t\treturn nil, err\n301|\t\t}\n302|\t}\n303|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n304|\tsort.Strings(ids)\n305|\tfor index, id := range ids {\n306|\t\tif index > 0 && id == ids[index-1] {\n307|\t\t\tcontinue\n308|\t\t}\n309|\t\tif id == sourcePeer {\n310|\t\t\tcontinue\n311|\t\t}\n312|\t\tif isAbsentPeerIndex(reader, id) {\n313|\t\t\tcontinue\n314|\t\t}\n315|\t\trepo, peerHost, err := reader.peerRepo(id)\n316|\t\tif err != nil {\n317|\t\t\treturn nil, err\n318|\t\t}\n319|\t\tif err := collect(repo, peerHost); err != nil {\n320|\t\t\treturn nil, err\n321|\t\t}\n322|\t}\n323|\theads := make([]string, 0, len(set))\n324|\tfor digest := range set {\n325|\t\theads = append(heads, digest)\n326|\t}\n327|\tsort.Strings(heads)\n328|\treturn heads, nil\n329|}\n330|\n331|// planSourceBinding resolves the plan's bound source: a local plan\n332|// carries a null alias with an empty or local host, while any other\n333|// binding selects a peer source by host. The second return reports\n334|// whether the plan selects a peer source.\n335|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n336|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n337|\t\treturn \"\", false\n338|\t}\n339|\treturn plan.SourceHostID, true\n340|}\n341|\n342|// bindingHolds reports whether the plan's bound (host, alias) source\n343|// still resolves to the same source in the current configuration. A\n344|// local plan holds while its host is empty or the current local host;\n345|// a peer plan holds while its host is still a known peer carrying the\n346|// exact bound alias.\n347|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n348|\tif plan.SourceAlias == nil {\n349|\t\tif plan.SourceHostID == \"\" {\n350|\t\t\treturn true\n351|\t\t}\n352|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n353|\t\t\treturn true\n354|\t\t}\n355|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n356|\t\t\treturn true\n357|\t\t}\n358|\t\treturn false\n359|\t}\n360|\tif !knownPeer(reader, plan.SourceHostID) {\n361|\t\treturn false\n362|\t}\n363|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n364|}\n365|\n366|// equalStrings compares sorted unique string slices element-wise.\n367|func equalStrings(first, second []string) bool {\n368|\tif len(first) != len(second) {\n369|\t\treturn false\n370|\t}\n371|\tfor index := range first {\n372|\t\tif first[index] != second[index] {\n373|\t\t\treturn false\n374|\t\t}\n375|\t}\n376|\treturn true\n377|}\n378|\n379|// checkPlanShapes validates the caller-supplied plan members without\n380|// consulting any authority: exact contract version, grammatical\n381|// selector, canonical UUIDs and digests, a bound source host, the\n382|// required lease attestation with its full positive triple, exact\n383|// alias bound, sorted unique authority heads, a known action tag, and\n384|// a null or UUIDv7 destination. Authority comes only from Revalidate.\n385|func checkPlanShapes(plan SelectionPlan) error {\n386|\tif plan.SelectorVersion != SelectorVersion {\n387|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n388|\t}\n389|\tif _, err := ParseSelector(plan.Selector); err != nil {\n390|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n391|\t}\n392|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n393|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n394|\t}\n395|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n396|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n397|\t}\n398|\t// The source host is always bound: no plan observes a source it\n399|\t// cannot name, and empty never substitutes for unknown.\n400|\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n401|\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n402|\t}\n403|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n404|\t\treturn fmt.Errorf(\"%w: malformed plan lease record digest: %v\", ErrInvalidArgument, err)\n405|\t}\n406|\tif plan.SourceAlias != nil {\n407|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n408|\t\t\t// An alias-less peer binds empty, which never passes the\n409|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n410|\t\t\tif *plan.SourceAlias != \"\" {\n411|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n412|\t\t\t}\n413|\t\t}\n414|\t}\n415|\tfor _, member := range []struct {\n416|\t\tname   string\n417|\t\tdigest string\n418|\t}{\n419|\t\t{\"source index\", plan.SourceIndexDigest},\n420|\t\t{\"configuration\", plan.ConfigurationDigest},\n421|\t\t{\"expectation\", plan.ExpectationDigest},\n422|\t} {\n423|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n424|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n425|\t\t}\n426|\t}\n427|\t// The lease triple is always fully bound from the same winning\n428|\t// observation as the lease attestation: a positive uint53 epoch\n429|\t// with a UUIDv4 lease and a UUIDv7 owner. Empty and partial\n430|\t// triples, out-of-range epochs, and placeholders are refused; a\n431|\t// session with no observed winning lease builds no plan.\n432|\tif plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling {\n433|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n434|\t}\n435|\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n436|\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n437|\t}\n438|\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n439|\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n440|\t}\n441|\tfor index, head := range plan.AuthorityHeads {\n442|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n443|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n444|\t\t}\n445|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n446|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n447|\t\t}\n448|\t}\n449|\tif _, ok := BoundariesFor(plan.Action); !ok {\n450|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n451|\t}\n452|\tif plan.DestinationHostID != nil {\n453|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n454|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n455|\t\t}\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// planWire is the tamper-evident persistence encoding: every bound\n461|// member plus the locally verified canonical digest over all of them.\n462|type planWire struct {\n463|\tSelectorVersion     string   `json:\"selector_version\"`\n464|\tSelector            string   `json:\"selector\"`\n465|\tSessionID           string   `json:\"session_id\"`\n466|\tSessionRecordID     string   `json:\"session_record_id\"`\n467|\tSourceHostID        string   `json:\"source_host_id\"`\n468|\tSourceAlias         *string  `json:\"source_alias\"`\n469|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n470|\tConfigurationDigest string   `json:\"configuration_digest\"`\n471|\tLeaseRecordID       string   `json:\"lease_record_id\"`\n472|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n473|\tLeaseID             string   `json:\"lease_id\"`\n474|\tOwnerHostID         string   `json:\"owner_host_id\"`\n475|\tAuthorityHeads      []string `json:\"authority_heads\"`\n476|\tAction              string   `json:\"action\"`\n477|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n478|\tExpectationDigest   string   `json:\"expectation_digest\"`\n479|\tPlanDigest          string   `json:\"plan_digest\"`\n480|}\n481|\n482|// Digest returns the locally verified canonical digest over all bound\n483|// plan members. It is recomputed on every call and never trusted from\n484|// caller bytes.\n485|func (plan SelectionPlan) Digest() (string, error) {\n486|\theads := append([]string(nil), plan.AuthorityHeads...)\n487|\tif heads == nil {\n488|\t\theads = []string{}\n489|\t}\n490|\treturn fingerprint(map[string]any{\n491|\t\t\"action\":               plan.Action,\n492|\t\t\"authority_heads\":      heads,\n493|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n494|\t\t\"destination_host_id\":  plan.DestinationHostID,\n495|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n496|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n497|\t\t\"lease_id\":             plan.LeaseID,\n498|\t\t\"lease_record_id\":      plan.LeaseRecordID,\n499|\t\t\"owner_host_id\":        plan.OwnerHostID,\n500|\t\t\"selector\":             plan.Selector,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
