rror) {\\n\\trepository.mutex.Lock()\\n\\tdefer repository.mutex.Unlock()\\n\\tsummaries, err := repository.listSessionsLocked()\\n\\tif err != nil {\\n\\t\\treturn SessionSummary{}, err\\n\\t}\\n\\tvar live []SessionSummary\\n===\\ninternal/sessrepo/chain.go:24:\\tkind      string\\ninternal/sessrepo/chain.go:81:\\tkind, _ := stringMember(members, \\\"kind\\\")\\ninternal/sessrepo/chain.go:83:\\treturn sessionRecord{raw: raw, recordID: digest.String(), sessionID: sessionID.String(), name: name, kind: kind, provider: provider}, nil\\ninternal/sessrepo/sessrepo.go:157:func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\\ninternal/sessrepo/store.go:166:\\t\\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\\ninternal/sessrepo/store.go:204:\\t\\t\\tsummary.Kind = record.kind\\n\",\n  \"original_output_bytes\": 5548,\n  \"original_output_tokens\": 1387,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
