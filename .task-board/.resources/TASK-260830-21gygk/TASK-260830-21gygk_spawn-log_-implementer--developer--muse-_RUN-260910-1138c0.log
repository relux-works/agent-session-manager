{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c47f","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":154,"recorded_at":1780531400000303,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"call_id":"call_01a0891792997802ad0220bc297b22d3","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is one admitted Checkpoint Record: its canonical\n48|// digest with the session and lease it was taken under, plus the host\n49|// that created it. Section 5.4 binds lease_epoch/lease_id to the\n50|// referenced winning lease, so a successor's checkpoint names its\n51|// predecessor lease, and binds created_by_host_id to the current\n52|// lease holder: the holder of the lease the checkpoint names.\n53|type validatedCheckpoint struct {\n54|\tDigest        string\n55|\tSessionID     string\n56|\tLeaseEpoch    uint64\n57|\tLeaseID       string\n58|\tCreatorHostID string\n59|\tRaw           []byte\n60|}\n61|\n62|// parseLeaseRecord validates one canonical Lease Record through the\n63|// canonicaljson owner and extracts the bound members. Closed-shape and\n64|// identity failures refuse invalid_config; the caller maps absence to\n65|// observation_unavailable.\n66|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n67|\tvar lease validatedLease\n68|\tmembers, fault := environ.DecodeStrictObject(raw)\n69|\tif fault != nil {\n70|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n71|\t}\n72|\tschema, err := leaseStringMember(members, \"schema\")\n73|\tif err != nil || schema != leaseRecordSchema {\n74|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n75|\t}\n76|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n77|\tif err != nil {\n78|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n79|\t}\n80|\tif field != canonicaljson.SelfRecordID {\n81|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n82|\t}\n83|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n84|\tif !ok {\n85|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n86|\t}\n87|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n88|\tif err != nil {\n89|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n90|\t}\n91|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n92|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n93|\t}\n94|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n95|\tif !ok {\n96|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n97|\t}\n98|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n99|\tif !ok {\n100|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n101|\t}\n102|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n103|\tif err != nil {\n104|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n105|\t}\n106|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n107|\tif err != nil {\n108|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n109|\t}\n110|\tlease = validatedLease{\n111|\t\tDigest:         digest.String(),\n112|\t\tSessionID:      sessionID.String(),\n113|\t\tLeaseID:        leaseID,\n114|\t\tEpoch:          epoch,\n115|\t\tHolderHostID:   holder.String(),\n116|\t\tPredecessor:    predecessor,\n117|\t\tHasPredecessor: hasPredecessor,\n118|\t\tCheckpoint:     checkpoint,\n119|\t\tHasCheckpoint:  hasCheckpoint,\n120|\t\tRaw:            append([]byte(nil), raw...),\n121|\t}\n122|\treturn lease, nil\n123|}\n124|\n125|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n126|\treturn members[name]\n127|}\n128|\n129|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n130|\traw, ok := members[name]\n131|\tif !ok {\n132|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n133|\t}\n134|\tvar value string\n135|\tif err := json.Unmarshal(raw, &value); err != nil {\n136|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n137|\t}\n138|\treturn value, nil\n139|}\n140|\n141|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n142|\traw, ok := members[name]\n143|\tif !ok {\n144|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n145|\t}\n146|\tif string(raw) == \"null\" {\n147|\t\treturn \"\", false, nil\n148|\t}\n149|\tvar value string\n150|\tif err := json.Unmarshal(raw, &value); err != nil {\n151|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n152|\t}\n153|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n154|\t\treturn \"\", false, err\n155|\t}\n156|\treturn value, true, nil\n157|}\n158|\n159|// leaseNullableDigest reads a nullable digest member: null binds\n160|// absence, a string must parse as a canonical digest.\n161|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n162|\traw, ok := members[name]\n163|\tif !ok {\n164|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n165|\t}\n166|\tif string(raw) == \"null\" {\n167|\t\treturn \"\", false, nil\n168|\t}\n169|\tvar value string\n170|\tif err := json.Unmarshal(raw, &value); err != nil {\n171|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n172|\t}\n173|\tdigest, err := scalar.ParseDigest(value)\n174|\tif err != nil {\n175|\t\treturn \"\", false, err\n176|\t}\n177|\treturn digest.String(), true, nil\n178|}\n179|\n180|// parseCheckpointRecord validates one canonical Checkpoint Record\n181|// through the sessrepo owner (closed shape plus canonical self\n182|// identity) and extracts the bound members. Closed-shape and\n183|// identity failures refuse invalid_config; the caller maps an\n184|// unresolvable reference to observation_unavailable.\n185|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n186|\tvar checkpoint validatedCheckpoint\n187|\tmembers, fault := environ.DecodeStrictObject(raw)\n188|\tif fault != nil {\n189|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n190|\t}\n191|\tschema, err := leaseStringMember(members, \"schema\")\n192|\tif err != nil || schema != checkpointRecordSchema {\n193|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n194|\t}\n195|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n196|\tif err != nil {\n197|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n198|\t}\n199|\tif field != canonicaljson.SelfCheckpointID {\n200|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n201|\t}\n202|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n203|\tif !ok {\n204|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n205|\t}\n206|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n207|\tif !ok {\n208|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n209|\t}\n210|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n211|\tif err != nil {\n212|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n213|\t}\n214|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n215|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n216|\t}\n217|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n218|\tif !ok {\n219|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n220|\t}\n221|\tcheckpoint = validatedCheckpoint{\n222|\t\tDigest:        digest.String(),\n223|\t\tSessionID:     sessionID.String(),\n224|\t\tLeaseEpoch:    epoch,\n225|\t\tLeaseID:       leaseID,\n226|\t\tCreatorHostID: creator.String(),\n227|\t\tRaw:           append([]byte(nil), raw...),\n228|\t}\n229|\treturn checkpoint, nil\n230|}\n231|\n232|// validatedLeasesBySession validates every supplied Lease Record and\n233|// groups the admitted records by session UUID.\n234|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n235|\tout := map[string][]validatedLease{}\n236|\tif reader == nil {\n237|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n238|\t}\n239|\tfor _, raw := range reader.LeaseRecords {\n240|\t\tlease, err := parseLeaseRecord(raw)\n241|\t\tif err != nil {\n242|\t\t\treturn nil, err\n243|\t\t}\n244|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n245|\t}\n246|\treturn out, nil\n247|}\n248|\n249|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n250|// Record for one session and validates its succession: the\n251|// predecessor ancestry must chain by epoch plus one down to an\n252|// epoch-1 root, and every lease in that winning ancestry above\n253|// epoch 1 must reference a validated checkpoint for its session and\n254|// predecessor lease (Section 5.3), each created by the owning lease\n255|// holder (Section 5.4). Absence refuses observation_unavailable; a\n256|// lease above epoch 1 without its named predecessor in the admitted\n257|// set refuses the same class rather than binding a dangling\n258|// successor, while an illegal predecessor link is malformed\n259|// authority (integrity failure).\n260|func (reader *Reader) winningLeaseFor(sessionID string) (validatedLease, error) {\n261|\tbySession, err := reader.validatedLeasesBySession()\n262|\tif err != nil {\n263|\t\treturn validatedLease{}, err\n264|\t}\n265|\tcandidates := bySession[sessionID]\n266|\tif len(candidates) == 0 {\n267|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n268|\t}\n269|\twinner := candidates[0]\n270|\tfor _, candidate := range candidates[1:] {\n271|\t\tif sessstate.Compare(\n272|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n273|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n274|\t\t) > 0 {\n275|\t\t\twinner = candidate\n276|\t\t}\n277|\t}\n278|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n279|\tif err != nil {\n280|\t\treturn validatedLease{}, err\n281|\t}\n282|\tif err := reader.checkWinnerCheckpoint(winner, predecessor); err != nil {\n283|\t\treturn validatedLease{}, err\n284|\t}\n285|\tif err := reader.checkAncestorCheckpoints(chain); err != nil {\n286|\t\treturn validatedLease{}, err\n287|\t}\n288|\treturn winner, nil\n289|}\n290|\n291|// checkLeaseChain validates the winner's predecessor ancestry within\n292|// the admitted records for its session. Section 5.3 requires every\n293|// epoch above 1 to name a known predecessor for the same session\n294|// with an epoch exactly one below, down to an epoch-1 root with a\n295|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n296|// lease naming any predecessor is malformed. A self, cyclic,\n297|// skipped, contradictory, or duplicated link is malformed authority\n298|// (integrity failure); a missing predecessor name or record is\n299|// incomplete authority (observation_unavailable). Epochs strictly\n300|// decrease along the walk, so the walk always terminates. It\n301|// returns the winning ancestry from the winner down to the epoch-1\n302|// root, plus the winner's direct predecessor, or the zero lease at\n303|// epoch 1.\n304|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n305|\tbyLease := make(map[string]validatedLease, len(candidates))\n306|\tfor _, candidate := range candidates {\n307|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n308|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n309|\t\t}\n310|\t\tbyLease[candidate.LeaseID] = candidate\n311|\t}\n312|\tvar predecessor validatedLease\n313|\tvar chain []validatedLease\n314|\tcurrent := winner\n315|\tfor {\n316|\t\tchain = append(chain, current)\n317|\t\tif current.Epoch == 1 {\n318|\t\t\tif current.HasPredecessor {\n319|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n320|\t\t\t}\n321|\t\t\treturn chain, predecessor, nil\n322|\t\t}\n323|\t\tif !current.HasPredecessor {\n324|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n325|\t\t}\n326|\t\tparent, ok := byLease[current.Predecessor]\n327|\t\tif !ok {\n328|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n329|\t\t}\n330|\t\tif parent.Epoch+1 != current.Epoch {\n331|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n332|\t\t}\n333|\t\tif current.LeaseID == winner.LeaseID {\n334|\t\t\tpredecessor = parent\n335|\t\t}\n336|\t\tcurrent = parent\n337|\t}\n338|}\n339|\n340|// validatedCheckpointsByDigest validates every supplied Checkpoint\n341|// Record and indexes the admitted records by canonical digest.\n342|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n343|\tout := map[string]validatedCheckpoint{}\n344|\tif reader == nil {\n345|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n346|\t}\n347|\tfor _, raw := range reader.CheckpointRecords {\n348|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n349|\t\tif err != nil {\n350|\t\t\treturn nil, err\n351|\t\t}\n352|\t\tout[checkpoint.Digest] = checkpoint\n353|\t}\n354|\treturn out, nil\n355|}\n356|\n357|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n358|// against the admitted Checkpoint Records. Section 5.3 requires\n359|// every epoch above 1 to reference a validated checkpoint for its\n360|// session and predecessor lease; an epoch-1 root without a\n361|// predecessor may carry no checkpoint before the first provider\n362|// boundary exists. A non-null reference must resolve to an admitted\n363|// record for the same session bound to the lease it was taken\n364|// under: the predecessor for a successor, the winner itself at\n365|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n366|// unresolvable reference is incomplete authority\n367|// (observation_unavailable), never absence or a minted fact.\n368|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease) error {\n369|\tif !winner.HasCheckpoint {\n370|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n371|\t\t\treturn nil\n372|\t\t}\n373|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n374|\t}\n375|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n376|\tif err != nil {\n377|\t\treturn err\n378|\t}\n379|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n380|\tif !ok {\n381|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n382|\t}\n383|\tif checkpoint.SessionID != winner.SessionID {\n384|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n385|\t}\n386|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n387|\tif winner.Epoch > 1 {\n388|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n389|\t}\n390|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n391|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n392|\t}\n393|\towner := winner\n394|\tif winner.Epoch > 1 {\n395|\t\towner = predecessor\n396|\t}\n397|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n398|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n399|\t}\n400|\treturn nil\n401|}\n402|\n403|// checkAncestorCheckpoints validates the checkpoint references of\n404|// every non-winner lease in the winning ancestry: Section 5.3\n405|// requires each epoch above 1 to reference a validated checkpoint\n406|// for its session and predecessor lease, and Section 5.4 requires\n407|// that checkpoint to be created by the owning lease holder. The\n408|// winner itself is covered by checkWinnerCheckpoint. Only the\n409|// winner's own ancestry is admitted: sibling branches off that\n410|// chain are never consulted, so legal branching is preserved. An\n411|// epoch-1 root without a reference stays admissible before the\n412|// first provider boundary exists; a reference it does carry must\n413|// resolve to a checkpoint bound to itself and created by its own\n414|// holder. An unresolvable reference or a binding to another\n415|// session, lease, or holder is incomplete authority\n416|// (observation_unavailable), never absence or a minted fact.\n417|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease) error {\n418|\tif len(chain) < 2 {\n419|\t\treturn nil\n420|\t}\n421|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n422|\tif err != nil {\n423|\t\treturn err\n424|\t}\n425|\tfor index := 1; index < len(chain); index++ {\n426|\t\tcurrent := chain[index]\n427|\t\tif current.Epoch == 1 {\n428|\t\t\tif !current.HasCheckpoint {\n429|\t\t\t\tcontinue\n430|\t\t\t}\n431|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints); err != nil {\n432|\t\t\t\treturn err\n433|\t\t\t}\n434|\t\t\tcontinue\n435|\t\t}\n436|\t\tif !current.HasCheckpoint {\n437|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n438|\t\t}\n439|\t\tif index+1 >= len(chain) {\n440|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n441|\t\t}\n442|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints); err != nil {\n443|\t\t\treturn err\n444|\t\t}\n445|\t}\n446|\treturn nil\n447|}\n448|\n449|// checkCheckpointBinding resolves one lease's checkpoint reference\n450|// against the admitted Checkpoint Records and validates its Section\n451|// 5.3 session and predecessor-lease binding with its Section 5.4\n452|// holder binding: the checkpoint must name this session and the\n453|// owning lease, and its creator must be that lease's holder.\n454|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint) error {\n455|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n456|\tif !ok {\n457|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n458|\t}\n459|\tif checkpoint.SessionID != current.SessionID {\n460|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n461|\t}\n462|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n463|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n464|\t}\n465|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n466|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n467|\t}\n468|\treturn nil\n469|}\n470|\n471|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n472|// greatest epoch wins, ties break by bytewise lease-ID order.\n473|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n474|\treturn sessstate.Compare(\n475|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n476|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n477|\t)\n478|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
