{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c595","stream":{"kind":"session","id":"01a08917-49c2-7bc0-a7b5-22c36c1af078"},"sequence":293,"recorded_at":1780531400000581,"record_type":"event","durability":"durable","causation_id":"727d1962-de67-4017-b172-583d47fe4c9d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"727d1962-de67-4017-b172-583d47fe4c9d","run_stream":{"kind":"run","id":"727d1962-de67-4017-b172-583d47fe4c9d"},"task_stream":{"kind":"task","id":"01a08917-da11-7823-a636-badf9c6e1332"},"task_id":"01a08917-da11-7823-a636-badf9c6e1332","event":{"kind":"output","task_id":"01a08917-da11-7823-a636-badf9c6e1332","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/.temp/TASK-260830-21gygk/review6/reviewer_rev6_executed_test.go`.\n1|package sessquery\n2|\n3|import (\n4| \"encoding/json\"\n5| \"testing\"\n6|)\n7|\n8|// The direct Session Record must select the provider persistence variant,\n9|// including in the ancestor checkpoint which establishes the winning lease.\n10|func TestRev6CheckpointPersistenceMustMatchSession(t *testing.T) {\n11| for _, ancestor := range []bool{false, true} {\n12|  path := \"winner\"; if ancestor { path = \"ancestor\" }\n13|  for _, wrong := range []bool{false, true} {\n14|   mode := \"direct_control\"; if wrong { mode = \"task_board_checkpoint_for_direct_session\" }\n15|   t.Run(path+\"/\"+mode, func(t *testing.T) {\n16|    good := checkpointRecordBytes(t,idA,1,lease,hostA)\n17|    cp := good\n18|    if wrong {\n19|     var value map[string]any\n20|     if err:=json.Unmarshal(good,&value);err!=nil {t.Fatal(err)}\n21|     value[\"task_board_bundle_id\"] = value[\"provider_manifest_id\"]\n22|     value[\"provider_manifest_id\"] = nil\n23|     cp = identity(t,value,\"checkpoint_id\")\n24|    }\n25|    var r *Reader\n26|    if ancestor {\n27|     r = rev5AncestorFixture(t,good)\n28|     old := mustBuild(t,r,PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n29|     if wrong {\n30|      // Preserve the winner digest and event bytes; alter only the\n31|      // ancestor's checkpoint variant, retaining canonical identities.\n32|      r.CheckpointRecords[0]=cp\n33|      for i,raw:=range r.LeaseRecords {\n34|       var value map[string]any\n35|       if err:=json.Unmarshal(raw,&value);err!=nil {t.Fatal(err)}\n36|       if value[\"lease_id\"]==leaseB {\n37|        value[\"checkpoint_id\"]=checkpointDigestOf(t,cp)\n38|        r.LeaseRecords[i]=identity(t,value,\"record_id\")\n39|       }\n40|      }\n41|      if err:=r.Revalidate(old);err==nil {t.Error(\"old-plan Revalidate admits wrong persistence variant in necessary ancestor\")}\n42|     }\n43|    } else {\n44|     r=successorFixture(t)\n45|     withCheckpoints(r,cp)\n46|     withLeases(r,leaseSuccessorBytes(t,idA,2,leaseB,hostA,lease,checkpointDigestOf(t,cp)))\n47|    }\n48|    rev5CheckEntries(t,r,wrong)\n49|   })\n50|  }\n51| }\n52|}","final_result":true}}}
