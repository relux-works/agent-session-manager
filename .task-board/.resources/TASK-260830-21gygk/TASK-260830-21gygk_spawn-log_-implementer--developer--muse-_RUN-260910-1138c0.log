on\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by parent ID\\\"},{\\\"name\\\":\\\"assignee\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by assignee\\\"},{\\\"name\\\":\\\"blocked\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by hard or advisory blocked scheduling state\\\"}],\\\"examples\\\":[\\\"count()\\\",\\\"count(type=task, status=done)\\\"]},\\\"get\\\":{\\\"description\\\":\\\"Get a single element by ID\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\"}],\\\"examples\\\":[\\\"get(TASK-XX) { overview }\\\"]},\\\"list\\\":{\\\"description\\\":\\\"List elements with optional filters and pagination\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by parent ID\\\"},{\\\"name\\\":\\\"assignee\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by assignee\\\"},{\\\"name\\\":\\\"blocked\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by hard or advisory blocked scheduling state\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Number of items to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Maximum number of items to return\\\"}],\\\"examples\\\":[\\\"list(type=task, status=development) { overview }\\\",\\\"list(take=5) { minimal }\\\",\\\"list(type=story, skip=10, take=5) { overview }\\\"]},\\\"plan\\\":{\\\"description\\\":\\\"Get execution plan with dependency phases and critical path\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"scope\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Scope to an element ID, or a set of IDs: scope=[ID,ID,...] (union of their subtrees)\\\"},{\\\"name\\\":\\\"mode\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Planning mode: children or related\\\"},{\\\"name\\\":\\\"active\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Exclude done/closed elements before building phases\\\"}],\\\"examples\\\":[\\\"plan()\\\",\\\"plan(EPIC-XX)\\\",\\\"plan(STORY-XX, mode=related)\\\",\\\"plan(EPIC-XX, active=true)\\\",\\\"plan(scope=[EPIC-XX, STORY-YY, TASK-ZZ], mode=children)\\\"]},\\\"summary\\\":{\\\"description\\\":\\\"Get board summary with counts by type and status\\\",\\\"examples\\\":[\\\"summary()\\\"]}},\\\"operations\\\":[\\\"activity\\\",\\\"agents\\\",\\\"context\\\",\\\"context_boundary\\\",\\\"context_candidates\\\",\\\"context_retention\\\",\\\"contexts\\\",\\\"count\\\",\\\"get\\\",\\\"list\\\",\\\"plan\\\",\\\"schema\\\",\\\"summary\\\"],\\\"presets\\\":{\\\"context-full\\\":[\\\"identity\\\",\\\"binding\\\",\\\"lineage\\\",\\\"lifecycle\\\",\\\"freshness\\\",\\\"actualization\\\",\\\"security\\\",\\\"payload\\\"],\\\"default\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\"],\\\"full\\\":[\\\"id\\\",\\\"type\\\",\\\"name\\\",\\\"title\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"review\\\",\\\"task_class\\\",\\\"estimate\\\",\\\"observability\\\",\\\"parent\\\",\\\"assignee\\\",\\\"description\\\",\\\"scope\\\",\\\"ac\\\",\\\"blockedBy\\\",\\\"blocks\\\",\\\"derivedBlockedBy\\\",\\\"derivedBlocks\\\",\\\"checklist\\\",\\\"notes\\\",\\\"created\\\",\\\"updated\\\",\\\"isBlocked\\\",\\\"isAdvisoryBlocked\\\",\\\"children\\\",\\\"preconditionResources\\\",\\\"outcomeResources\\\"],\\\"minimal\\\":[\\\"id\\\",\\\"status\\\"],\\\"observability-epic\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\",\\\"observability\\\"],\\\"observability-project\\\":[\\\"observability\\\"],\\\"observability-story\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\",\\\"observability\\\"],\\\"observability-task\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\",\\\"observability\\\"],\\\"overview\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\",\\\"assignee\\\",\\\"parent\\\"],\\\"planning\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"blockedBy\\\",\\\"blocks\\\",\\\"derivedBlockedBy\\\",\\\"derivedBlocks\\\",\\\"parent\\\"],\\\"progress\\\":[\\\"id\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"review\\\",\\\"task_class\\\",\\\"estimate\\\",\\\"checklist\\\",\\\"notes\\\",\\\"blockedBy\\\",\\\"derivedBlockedBy\\\",\\\"isBlocked\\\",\\\"isAdvisoryBlocked\\\"],\\\"selection\\\":[\\\"identity\\\",\\\"binding\\\",\\\"lineage\\\",\\\"lifecycle\\\",\\\"security\\\"]}}\\n===\\nIGNORED\\n\",\n  \"original_output_bytes\": 40000,\n  \"original_output_tokens\": 10000,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
