\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Comma-separated activity operation kinds\\\"},{\\\"name\\\":\\\"view\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"raw\\\",\\\"description\\\":\\\"History view: raw or effective\\\"}],\\\"examples\\\":[\\\"activity(TASK-XX, limit=50, order=ascending, view=raw)\\\",\\\"activity(TASK-XX, cursor=opaque-cursor, limit=25, kinds=progress, view=effective)\\\"]},\\\"agents\\\":{\\\"description\\\":\\\"List agents and their assigned elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"stale\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Stale threshold in minutes for done items\\\"}],\\\"examples\\\":[\\\"agents()\\\",\\\"agents(stale=60)\\\"]},\\\"context\\\":{\\\"description\\\":\\\"Get one Context Registry record by CTX id\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"}],\\\"examples\\\":[\\\"context(CTX-260728-a1b2c3) { selection }\\\",\\\"context(CTX-260728-a1b2c3) { identity binding lineage freshness security payload lifecycle }\\\"]},\\\"context_boundary\\\":{\\\"description\\\":\\\"Project one context's declared coverage boundary\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"},{\\\"name\\\":\\\"detail\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"banner\\\",\\\"description\\\":\\\"manifest includes the full boundary document\\\",\\\"enum\\\":[\\\"banner\\\",\\\"manifest\\\"]}],\\\"examples\\\":[\\\"context_boundary(CTX-260728-a1b2c3, detail=manifest)\\\"]},\\\"context_candidates\\\":{\\\"description\\\":\\\"Board-side context candidate projection for one target element and target role, ordered by scope distance then role affinity\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"element\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Target board element\\\"},{\\\"name\\\":\\\"role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Target role the run will execute as; keeps same-role, allowed predecessor, and project-producer snapshots and ranks them by affinity\\\"},{\\\"name\\\":\\\"producer_role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Opt-in exact producer-role filter\\\"},{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"ready\\\",\\\"description\\\":\\\"Comma-separated lifecycle states\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Candidates to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum candidates to return\\\"}],\\\"examples\\\":[\\\"context_candidates(element=TASK-260728-abc123, role=developer, provider=codex) { selection }\\\",\\\"context_candidates(element=TASK-260728-abc123, producer_role=solution-architect) { selection }\\\"]},\\\"context_retention\\\":{\\\"description\\\":\\\"Retention outlook: contexts a provider is about to delete on its own timer, and payloads only the board will ever delete\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"warn_days\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":7,\\\"description\\\":\\\"Expiry warning horizon\\\"},{\\\"name\\\":\\\"include_pinned\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"default\\\":false,\\\"description\\\":\\\"Consider pinned contexts for collection\\\