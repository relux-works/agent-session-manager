{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de19","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":3431,"recorded_at":1780531400006857,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088e2-fe15-7691-85c8-4dfe3be84a54"},"task_id":"01a088e2-fe15-7691-85c8-4dfe3be84a54","event":{"kind":"output","task_id":"01a088e2-fe15-7691-85c8-4dfe3be84a54","chunk":"Read text file `internal/sessquery/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessquery/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each gate by narrowing, never by deletion: every N-\n6|mutant keeps its gate present and weakens it to admit exactly one member\n7|of the class the gate must reject, and a named behavioral test must fail.\n8|Grammar mutants preserve the searched-for token while changing behavior,\n9|and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessquery/query.go'\n30|base = source.read_text()\n31|selector_source = copy / 'internal/sessquery/selector.go'\n32|selector_base = selector_source.read_text()\n33|revalidate_source = copy / 'internal/sessquery/revalidate.go'\n34|revalidate_base = revalidate_source.read_text()\n35|plan_source = copy / 'internal/sessquery/plan.go'\n36|plan_base = plan_source.read_text()\n37|summary_source = copy / 'internal/sessquery/summary.go'\n38|summary_base = summary_source.read_text()\n39|lease_source = copy / 'internal/sessquery/lease.go'\n40|lease_base = lease_source.read_text()\n41|repo_source = copy / 'internal/sessrepo/store.go'\n42|repo_base = repo_source.read_text()\n43|results = []\n44|\n45|IDA = '0198f4c8-3e70-7a11-8a2b-1234567890ab'\n46|IDB = '0198f4c8-3e70-7a11-8a2b-1234567890ac'\n47|HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\n48|HOSTB = '0198f4c8-4a10-7b22-8b3c-1234567890ac'\n49|HOSTC = '0198f4c8-4a10-7b22-8b3c-1234567890ad'\n50|LEASEB = 'bbbbbbbb-cccc-4ddd-8eee-ffffffffffff'\n51|\n52|def run(name, path, old, new, narrow):\n53|    original = path.read_text()\n54|    if original.count(old) != 1:\n55|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n56|        return\n57|    path.write_text(original.replace(old, new))\n58|    command = ['go', 'test', './internal/sessquery', './internal/sessrepo', '-count=1', '-v']\n59|    try:\n60|        with (output / (name + '.log')).open('w') as log:\n61|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n62|        text = (output / (name + '.log')).read_text()\n63|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n64|        classification = 'SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE')\n65|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n66|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n67|    finally:\n68|        path.write_text(original)\n69|        assert hashlib.sha256(path.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n70|\n71|with (output / 'control-before.log').open('w') as log:\n72|    before = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=180)\n73|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n74|if before.returncode:\n75|    raise SystemExit('baseline failed')\n76|run('N-collision-pair',source,'if len(ids) > 1 {','if len(ids) > 2 {','Allow exactly a two-identity folded bucket; larger buckets still refuse.')\n77|run('N-case-variant',source,'if item.summary.Projection.Name == selector && exact == nil {','if (item.summary.Projection.Name == selector || selector == \"az-09._\") && exact == nil {','Allow the sole non-exact query az-09._ within its folded bucket.')\n78|run('N-parked-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if (row.Projection.Parked != nil && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") || row.Projection.State == sessstate.StateTombstoned {','Allow one parked session identity into live resolution.')\n79|run('N-tombstoned-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if row.Projection.Parked != nil || (row.Projection.State == sessstate.StateTombstoned && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") {','Allow one tombstoned session identity into live resolution.')\n80|run('N-unlisted-peer',source,'ids := append([]string(nil), reader.AllowlistedPeerIDs...)\\n\\tsort.Strings(ids)\\n\\tvar out []candidate','ids := append([]string(nil), reader.AllowlistedPeerIDs...)\\n\\tids = append(ids, \"0198f4c8-4a10-7b22-8b3c-1234567890ab\")\\n\\tsort.Strings(ids)\\n\\tvar out []candidate','Read one peer outside the allowlist; all other peer identities still filtered.')\n81|run('N-duplicate-peer',source,'if found {','if found && id != \"0198f4c8-4a10-7b22-8b3c-1234567890ab\" {','Permit duplicate sources for one peer identity, retain duplicate refusal for other identities.')\n82|run('N-read-failure-fallback',source,'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}', 'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, sessrepo.ErrRepositoryPath) { return []Summary{}, nil }; return nil, err\\n\\t}', 'Treat repository-path read failure as empty, while retaining other read refusals.')\n83|run('N-projection-failure-fallback',source,'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}', 'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\tif row.SessionID == \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" { continue }; return nil, err\\n\\t\\t}', 'Omit one identity on failed projection instead of propagating its failure.')\n84|run('N-repository-case-variant',repo_source,'if len(folded) == 1 && folded[0].Name == query {','if len(folded) == 1 && (folded[0].Name == query || query == \"Payments-API\") {','Allow one non-exact query at the retained repository Resolve entry.')\n85|run('N-first-at-split',selector_source,'key, source, qualified := strings.Cut(argument, \"@\")','key, source, qualified := argument, \"\", false\\n\\tif at := strings.LastIndexByte(argument, \\'@\\'); at >= 0 {\\n\\t\\tkey, source, qualified = argument[:at], argument[at+1:], true\\n\\t}','Split at the last @ while keeping the @ token; an alias containing @ then misroutes.')\n86|run('N-local-prefix',selector_source,'\\tcase source == \"local\":','\\tcase strings.HasPrefix(source, \"local\"):','Admit local-prefixed sources while keeping the local token; localX then selects local.')\n87|run('N-id-case',selector_source,'\\tif id, ok := strings.CutPrefix(key, \"id:\"); ok {\\n\\t\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','\\tlowered := strings.ToLower(key)\\n\\tif id, ok := strings.CutPrefix(lowered, \"id:\"); ok {\\n\\t\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','Fold the id: key prefix while keeping its token; ID: then bypasses names.')\n88|run('N-peer-alias-fold',selector_source,'if config.aliasOf[peer.HostID] == alias && alias != \"\" {','if asciiFold(config.aliasOf[peer.HostID]) == asciiFold(alias) && alias != \"\" {','Fold alias comparison while keeping exact mapping storage; WORK then selects Work.')\n89|run('N-id-through-names',source,'\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)','\\tif match, found, err := matchName(live, strings.TrimPrefix(parsed.Key, \"id:\")); found || err != nil {\\n\\t\\treturn match, err\\n\\t}\\n\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)','Route one explicit id: key through the name tier first; a UUID-shaped name then shadows the identity.')\n90|run('N-explicit-fallback',source,'\\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))','\\treturn reader.resolveBare(Selector{Raw: parsed.Raw, Key: parsed.Key, UUIDShaped: parsed.UUIDShaped, Source: SourceBare}, config)','Fall back to the bare union on exactly an explicit-source miss; a locally present name then resolves.')\n91|run('N-unknown-alias-local',source,'\\t\\t\\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)','\\t\\t\\treturn reader.Local, \"\", nil','Treat exactly an unknown alias as the local source; a locally present name then resolves.')\n92|run('N-disallowed-admit',source,'\\t\\t\\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)','