{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c859","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":647,"recorded_at":1780531400001289,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d6-45b0-7511-90f4-d939e5f0c479"},"task_id":"01a088d6-45b0-7511-90f4-d939e5f0c479","event":{"kind":"output","task_id":"01a088d6-45b0-7511-90f4-d939e5f0c479","chunk":"Read text file `internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, the complete authority\n10|// union for the pinned session across the remaining allowed sources,\n11|// authority heads, and the source index digest.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n27|const uint53Ceiling = uint64(1<<53 - 1)\n28|\n29|// Revalidate compares every bound plan fact against current\n30|// configuration and freshly reread source data, then validates the\n31|// complete authority union for the pinned session UUID across the\n32|// remaining allowed sources. The session is located by its UUID in\n33|// each source, never re-resolved by name. A nil return means the plan\n34|// is current; any error classifies exactly: selector_plan_stale (with\n35|// the first diverged member named), integrity_failure on contradictory\n36|// cross-source immutable records, peer_not_allowlisted on explicit\n37|// authorization revocation, invalid_config on current configuration\n38|// failures, invalid_arguments on a malformed caller plan, and the read\n39|// or projection failure class when a required read or validation\n40|// fails.\n41|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n42|\tif err := checkPlanShapes(plan); err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif reader == nil || reader.Local == nil {\n46|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n47|\t}\n48|\tconfig, err := reader.validatedConfiguration()\n49|\tif err != nil {\n50|\t\treturn err\n51|\t}\n52|\tpeerHost, isPeer := planSourceBinding(plan, config)\n53|\tif isPeer {\n54|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n55|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n56|\t\t}\n57|\t}\n58|\tif !bindingHolds(plan, config, reader) {\n59|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n60|\t}\n61|\tconfiguration, err := fingerprintConfiguration(reader, config)\n62|\tif err != nil {\n63|\t\treturn err\n64|\t}\n65|\tif configuration != plan.ConfigurationDigest {\n66|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n67|\t}\n68|\tvar repo = reader.Local\n69|\tsourcePeer := \"\"\n70|\tif isPeer {\n71|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n72|\t\tif err != nil {\n73|\t\t\treturn err\n74|\t\t}\n75|\t}\n76|\trows, err := reader.readSource(repo, sourcePeer)\n77|\tif err != nil {\n78|\t\treturn err\n79|\t}\n80|\tvar recordID string\n81|\tabsent := true\n82|\tfor _, row := range rows {\n83|\t\tif row.Projection.SessionID == plan.SessionID {\n84|\t\t\trecordID, absent = row.Projection.RecordID, false\n85|\t\t\tbreak\n86|\t\t}\n87|\t}\n88|\tif absent {\n89|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n90|\t}\n91|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n92|\tif err != nil {\n93|\t\treturn err\n94|\t}\n95|\tif recordID != plan.SessionRecordID {\n96|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n97|\t}\n98|\tif projection.Winner.IsZero() {\n99|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n100|\t}\n101|\tlease, err := reader.winningLeaseFor(plan.SessionID)\n102|\tif err != nil {\n103|\t\treturn err\n104|\t}\n105|\tif lease.Digest != plan.LeaseRecordID || lease.Epoch != plan.LeaseEpoch || lease.LeaseID != plan.LeaseID || lease.HolderHostID != plan.OwnerHostID {\n106|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n107|\t}\n108|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID {\n109|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n110|\t}\n111|\tif projection.OwnerHostID != lease.HolderHostID {\n112|\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, plan.SessionID)\n113|\t}\n114|\t// The union reports specific lease and tombstone divergence before\n115|\t// the generic head and index comparisons: heads include union tails,\n116|\t// so a union change would otherwise mask as a head change.\n117|\tif err := reader.validateAuthorityUnion(plan, config, sourcePeer); err != nil {\n118|\t\treturn err\n119|\t}\n120|\theads, err := reader.collectAuthorityHeads(config, plan.SessionID, lease.Digest, sourcePeer)\n121|\tif err != nil {\n122|\t\treturn err\n123|\t}\n124|\tif !equalStrings(heads, plan.AuthorityHeads) {\n125|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n126|\t}\n127|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif index != plan.SourceIndexDigest {\n132|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n133|\t}\n134|\treturn nil\n135|}\n136|\n137|// validateAuthorityUnion validates the complete current authority for\n138|// the pinned session UUID across every allowed source except the\n139|// already validated plan source. The session is located by UUID in\n140|// each source; names are never re-resolved and no selection is\n141|// substituted. A non-parked copy carrying a disagreeing immutable\n142|// record digest is inconsistent authority (integrity_failure, the same\n143|// class Resolve reports for disagreeing copies). Authoritative\n144|// tombstone evidence or a greater observed winning lease (Section 5.3\n145|// greatest (epoch, lease_id) tuple) in another source invalidates the\n146|// live plan (selector_plan_stale); a lagging copy with a smaller tuple\n147|// is a preserved losing history and stays current, and an agreeing\n148|// replica stays current. A copy that observes no winning lease yet\n149|// cannot contradict the bound lease and is skipped for the lease\n150|// check, while its record digest still binds. Parked copies are failed\n151|// observations, never evidence, and absence in a source is not\n152|// contradiction. A source that must be read but cannot be read keeps\n153|// its read-failure class: without the complete union the plan cannot\n154|// be shown current.\n155|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n156|\tif sourcePeer != \"\" {\n157|\t\trows, err := reader.read(reader.Local)\n158|\t\tif err != nil {\n159|\t\t\treturn err\n160|\t\t}\n161|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n162|\t\t\treturn err\n163|\t\t}\n164|\t}\n165|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n166|\tsort.Strings(ids)\n167|\tfor index, id := range ids {\n168|\t\tif index > 0 && id == ids[index-1] {\n169|\t\t\tcontinue\n170|\t\t}\n171|\t\tif id == sourcePeer {\n172|\t\t\tcontinue\n173|\t\t}\n174|\t\t// An allowlisted peer with no advertised learned index\n175|\t\t// contributes no authority; a known handle that cannot be\n176|\t\t// read is a failed observation of a source that must be\n177|\t\t// read, never absence.\n178|\t\tif isAbsentPeerIndex(reader, id) {\n179|\t\t\tcontinue\n180|\t\t}\n181|\t\trepo, peerHost, err := reader.peerRepo(id)\n182|\t\tif err != nil {\n183|\t\t\treturn err\n184|\t\t}\n185|\t\trows, err := reader.readSource(repo, peerHost)\n186|\t\tif err != nil {\n187|\t\t\treturn err\n188|\t\t}\n189|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n190|\t\t\treturn err\n191|\t\t}\n192|\t}\n193|\treturn nil\n194|}\n195|\n196|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n197|// learned index handle at all: absence, never a failed read.\n198|func isAbsentPeerIndex(reader *Reader, host string) bool {\n199|\tfor _, peer := range reader.Peers {\n200|\t\tif peer.HostID == host {\n201|\t\t\treturn false\n202|\t\t}\n203|\t}\n204|\treturn true\n205|}\n206|\n207|// checkUnionCopy validates one non-plan source's rows for the pinned\n208|// session UUID as validateAuthorityUnion documents. The union winner\n209|// is the greatest (epoch, lease_id) tuple: only a greater tuple in\n210|// another source invalidates the plan; smaller tuples are preserved\n211|// losing histories and equal tuples are agreeing replicas.\n212|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n213|\tfor _, row := range rows {\n214|\t\tif row.Projection.SessionID != plan.SessionID {\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\tif row.Projection.Parked != nil {\n218|\t\t\tcontinue\n219|\t\t}\n220|\t\tif row.Projection.State == sessstate.StateTombstoned {\n221|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n222|\t\t}\n223|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n224|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n225|\t\t}\n226|\t\tif row.Projection.Winner.IsZero() {\n227|\t\t\tcontinue\n228|\t\t}\n229|\t\tordering := compareLeaseTuple(\n230|\t\t\trow.Projection.Winner.Epoch, row.Projection.Winner.LeaseID,\n231|\t\t\tplan.LeaseEpoch, plan.LeaseID,\n232|\t\t)\n233|\t\tif ordering > 0 {\n234|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n235|\t\t}\n236|\t\tif ordering == 0 && row.Projection.OwnerHostID != plan.OwnerHostID {\n237|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing owner facts across sources\", sessstate.ErrIntegrity, plan.SessionID)\n238|\t\t}\n239|\t}\n240|\treturn nil\n241|}\n242|\n243|// collectAuthorityHeads binds the sorted unique lease, event, and\n244|// tombstone heads used for the decision: the winning Lease Record\n245|// digest plus the tail event digest of every allowed source holding a\n246|// non-parked copy of the pinned session. Parked copies are failed\n247|// observations and contribute no head; absent sessions contribute\n248|// none. A source that must be read but cannot be read keeps its\n249|// read-failure class.\n250|func (reader *Reader) collectAuthorityHeads(config validatedConfig, sessionID, leaseDigest, sourcePeer string) ([]string, error) {\n251|\tset := map[string]struct{}{leaseDigest: {}}\n252|\tcollect := func(repo *sessrepo.Repository, peerHost string) error {\n253|\t\trows, err := reader.readSource(repo, peerHost)\n254|\t\tif err != nil {\n255|\t\t\treturn err\n256|\t\t}\n257|\t\tfor _, row := range rows {\n258|\t\t\tif row.Projection.SessionID != sessionID {\n259|\t\t\t\tcontinue\n260|\t\t\t}\n261|\t\t\tif row.Projection.Parked != nil {\n262|\t\t\t\tcontinue\n263|\t\t\t}\n264|\t\t\ttail, err := chainTail(repo, sessionID)\n265|\t\t\tif err != nil {\n266|\t\t\t\tif peerHost == \"\" {\n267|\t\t\t\t\treturn err\n268|\t\t\t\t}\n269|\t\t\t\treturn peerReadFailed(peerHost, err)\n270|\t\t\t}\n271|\t\t\tif tail != \"\" {\n272|\t\t\t\tset[tail] = struct{}{}\n273|\t\t\t}\n274|\t\t\tbreak\n275|\t\t}\n276|\t\treturn nil\n277|\t}\n278|\tvar planRepo *sessrepo.Repository\n279|\tif sourcePeer == \"\" {\n280|\t\tplanRepo = reader.Local\n281|\t} else {\n282|\t\tvar err error\n283|\t\tplanRepo, _, err = reader.peerRepo(sourcePeer)\n284|\t\tif err != nil {\n285|\t\t\treturn nil, err\n286|\t\t}\n287|\t}\n288|\tif err := collect(planRepo, sourcePeer); err != nil {\n289|\t\treturn nil, err\n290|\t}\n291|\tif sourcePeer != \"\" {\n292|\t\tif err := collect(reader.Local, \"\"); err != nil {\n293|\t\t\treturn nil, err\n294|\t\t}\n295|\t}\n296|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n297|\tsort.Strings(ids)\n298|\tfor index, id := range ids {\n299|\t\tif index > 0 && id == ids[index-1] {\n300|\t\t\tcontinue\n301|\t\t}\n302|\t\tif id == sourcePeer {\n303|\t\t\tcontinue\n304|\t\t}\n305|\t\tif isAbsentPeerIndex(reader, id) {\n306|\t\t\tcontinue\n307|\t\t}\n308|\t\trepo, peerHost, err := reader.peerRepo(id)\n309|\t\tif err != nil {\n310|\t\t\treturn nil, err\n311|\t\t}\n312|\t\tif err := collect(repo, peerHost); err != nil {\n313|\t\t\treturn nil, err\n314|\t\t}\n315|\t}\n316|\theads := make([]string, 0, len(set))\n317|\tfor digest := range set {\n318|\t\theads = append(heads, digest)\n319|\t}\n320|\tsort.Strings(heads)\n321|\treturn heads, nil\n322|}\n323|\n324|// planSourceBinding resolves the plan's bound source: a local plan\n325|// carries a null alias with an empty or local host, while any other\n326|// binding selects a peer source by host. The second return reports\n327|// whether the plan selects a peer source.\n328|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n329|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n330|\t\treturn \"\", false\n331|\t}\n332|\treturn plan.SourceHostID, true\n333|}\n334|\n335|// bindingHolds reports whether the plan's bound (host, alias) source\n336|// still resolves to the same source in the current configuration. A\n337|// local plan holds while its host is empty or the current local host;\n338|// a peer plan holds while its host is still a known peer carrying the\n339|// exact bound alias.\n340|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n341|\tif plan.SourceAlias == nil {\n342|\t\tif plan.SourceHostID == \"\" {\n343|\t\t\treturn true\n344|\t\t}\n345|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n346|\t\t\treturn true\n347|\t\t}\n348|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n349|\t\t\treturn true\n350|\t\t}\n351|\t\treturn false\n352|\t}\n353|\tif !knownPeer(reader, plan.SourceHostID) {\n354|\t\treturn false\n355|\t}\n356|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n357|}\n358|\n359|// equalStrings compares sorted unique string slices element-wise.\n360|func equalStrings(first, second []string) bool {\n361|\tif len(first) != len(second) {\n362|\t\treturn false\n363|\t}\n364|\tfor index := range first {\n365|\t\tif first[index] != second[index] {\n366|\t\t\treturn false\n367|\t\t}\n368|\t}\n369|\treturn true\n370|}\n371|\n372|// checkPlanShapes validates the caller-supplied plan members without\n373|// consulting any authority: exact contract version, grammatical\n374|// selector, canonical UUIDs and digests, a bound source host, the\n375|// required lease attestation with its full positive triple, exact\n376|// alias bound, sorted unique authority heads, a known action tag, and\n377|// a null or UUIDv7 destination. Authority comes only from Revalidate.\n378|func checkPlanShapes(plan SelectionPlan) error {\n379|\tif plan.SelectorVersion != SelectorVersion {\n380|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n381|\t}\n382|\tif _, err := ParseSelector(plan.Selector); err != nil {\n383|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n384|\t}\n385|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n386|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n387|\t}\n388|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n389|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n390|\t}\n391|\t// The source host is always bound: no plan observes a source it\n392|\t// cannot name, and empty never substitutes for unknown.\n393|\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n394|\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n395|\t}\n396|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n397|\t\treturn fmt.Errorf(\"%w: malformed plan lease record digest: %v\", ErrInvalidArgument, err)\n398|\t}\n399|\tif plan.SourceAlias != nil {\n400|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n401|\t\t\t// An alias-less peer binds empty, which never passes the\n402|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n403|\t\t\tif *plan.SourceAlias != \"\" {\n404|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n405|\t\t\t}\n406|\t\t}\n407|\t}\n408|\tfor _, member := range []struct {\n409|\t\tname   string\n410|\t\tdigest string\n411|\t}{\n412|\t\t{\"source index\", plan.SourceIndexDigest},\n413|\t\t{\"configuration\", plan.ConfigurationDigest},\n414|\t\t{\"expectation\", plan.ExpectationDigest},\n415|\t} {\n416|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n417|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n418|\t\t}\n419|\t}\n420|\t// The lease triple is always fully bound from the same winning\n421|\t// observation as the lease attestation: a positive uint53 epoch\n422|\t// with a UUIDv4 lease and a UUIDv7 owner. Empty and partial\n423|\t// triples, out-of-range epochs, and placeholders are refused; a\n424|\t// session with no observed winning lease builds no plan.\n425|\tif plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling {\n426|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n427|\t}\n428|\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n429|\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n430|\t}\n431|\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n432|\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n433|\t}\n434|\tfor index, head := range plan.AuthorityHeads {\n435|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n436|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n437|\t\t}\n438|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n439|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n440|\t\t}\n441|\t}\n442|\tif _, ok := BoundariesFor(plan.Action); !ok {\n443|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n444|\t}\n445|\tif plan.DestinationHostID != nil {\n446|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n447|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n448|\t\t}\n449|\t}\n450|\treturn nil\n451|}\n452|\n453|// planWire is the tamper-evident persistence encoding: every bound\n454|// member plus the locally verified canonical digest over all of them.\n455|type planWire struct {\n456|\tSelectorVersion     string   `json:\"selector_version\"`\n457|\tSelector            string   `json:\"selector\"`\n458|\tSessionID           string   `json:\"session_id\"`\n459|\tSessionRecordID     string   `json:\"session_record_id\"`\n460|\tSourceHostID        string   `json:\"source_host_id\"`\n461|\tSourceAlias         *string  `json:\"source_alias\"`\n462|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n463|\tConfigurationDigest string   `json:\"configuration_digest\"`\n464|\tLeaseRecordID       string   `json:\"lease_record_id\"`\n465|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n466|\tLeaseID             string   `json:\"lease_id\"`\n467|\tOwnerHostID         string   `json:\"owner_host_id\"`\n468|\tAuthorityHeads      []string `json:\"authority_heads\"`\n469|\tAction              string   `json:\"action\"`\n470|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n471|\tExpectationDigest   string   `json:\"expectation_digest\"`\n472|\tPlanDigest          string   `json:\"plan_digest\"`\n473|}\n474|\n475|// Digest returns the locally verified canonical digest over all bound\n476|// plan members. It is recomputed on every call and never trusted from\n477|// caller bytes.\n478|func (plan SelectionPlan) Digest() (string, error) {\n479|\theads := append([]string(nil), plan.AuthorityHeads...)\n480|\tif heads == nil {\n481|\t\theads = []string{}\n482|\t}\n483|\treturn fingerprint(map[string]any{\n484|\t\t\"action\":               plan.Action,\n485|\t\t\"authority_heads\":      heads,\n486|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n487|\t\t\"destination_host_id\":  plan.DestinationHostID,\n488|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n489|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n490|\t\t\"lease_id\":             plan.LeaseID,\n491|\t\t\"lease_record_id\":      plan.LeaseRecordID,\n492|\t\t\"owner_host_id\":        plan.OwnerHostID,\n493|\t\t\"selector\":             plan.Selector,\n494|\t\t\"selector_version\":     plan.SelectorVersion,\n495|\t\t\"session_id\":           plan.SessionID,\n496|\t\t\"session_record_id\":    plan.SessionRecordID,\n497|\t\t\"source_alias\":         plan.SourceAlias,\n498|\t\t\"source_host_id\":       plan.SourceHostID,\n499|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n500|\t})\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85b","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":648,"recorded_at":1780531400001291,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d6-45b0-7511-90f4-d939e5f0c479"},"task_id":"01a088d6-45b0-7511-90f4-d939e5f0c479","event":{"kind":"completed","task_id":"01a088d6-45b0-7511-90f4-d939e5f0c479"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c85d","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":649,"recorded_at":1780531400001293,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d6-45dc-79f1-a677-3eec4f7c0f14"},"task_id":"01a088d6-45dc-79f1-a677-3eec4f7c0f14","event":{"kind":"output","task_id":"01a088d6-45dc-79f1-a677-3eec4f7c0f14","chunk":"Read text file `internal/sessquery/summary.go`.\n1|// Authoritative shared summaries for the v0.6.0 selector contract\n2|// (SPEC Section 14.7.3).\n3|//\n4|// List and Status above keep the internal read model and refuse only\n5|// the unrepresentable record-only bootstrap. This layer is the closed\n6|// authoritative summary: every owner, lease, and role fact comes from\n7|// the validated winning Lease Record, every host display name comes\n8|// from validated host metadata, and every workspace, capability,\n9|// liveness, and timestamp fact comes from a validated observation.\n10|// Anything that cannot be established truthfully refuses instead of\n11|// falling back to inference:\n12|//\n13|//   - a complete read proving a record without any valid lease is\n14|//     selector_bootstrap_incomplete (inherited from the read entry);\n15|//   - a required host metadata fact, winning Lease Record, or\n16|//     observation that cannot be established is\n17|//     selector_observation_unavailable, never a source alias, an empty\n18|//     name, or a minted process/capability fact;\n19|//   - list refuses the whole success document when any encountered\n20|//     record cannot be represented, including a mixed healthy and\n21|//     incomplete listing; no record is silently omitted.\n22|//\n23|// CLI envelope and exit rendering, durable bootstrap recovery, and\n24|// effect authorization remain their existing caller owners. Plans\n25|// built here authorize read projection only.\n26|package sessquery\n27|\n28|import (\n29|\t\"fmt\"\n30|\t\"sort\"\n31|\t\"time\"\n32|\t\"unicode\"\n33|\t\"unicode/utf8\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n37|)\n38|\n39|// MaxDisplayNameRunes bounds one validated host display name: the\n40|// SessionSummary owner_host_name is string[1..64].\n41|const MaxDisplayNameRunes = 64\n42|\n43|// MaxCapabilityNameRunes bounds one validated capability name.\n44|const MaxCapabilityNameRunes = 128\n45|\n46|// MaxCapabilityDetailRunes bounds one CapabilitySummary detail: string[0..2048].\n47|const MaxCapabilityDetailRunes = 2048\n48|\n49|// MaxWarningRunes bounds one summary warning: 1..1024 printable runes.\n50|const MaxWarningRunes = 1024\n51|\n52|// MaxWarnings bounds the warning array: sorted unique string[0..1024].\n53|const MaxWarnings = 1024\n54|\n55|// MaxCapabilities bounds the capability map: 0..7 entries.\n56|const MaxCapabilities = 7\n57|\n58|// Workspace statuses from the SessionSummary shape.\n59|const (\n60|\tWorkspaceAbsent      = \"absent\"\n61|\tWorkspaceCurrent     = \"current\"\n62|\tWorkspaceStaged      = \"staged\"\n63|\tWorkspaceConflict    = \"conflict\"\n64|\tWorkspaceUnsupported = \"unsupported\"\n65|)\n66|\n67|// HostMetadata is validated display metadata for one host, keyed by\n68|// canonical host UUID on the Reader. It is the only source of owner\n69|// display names; the source alias never substitutes for it.\n70|type HostMetadata struct {\n71|\tDisplayName string\n72|}\n73|\n74|// CapabilitySummary is one validated capability value: status,\n75|// enabled, and detail. Only available may set enabled true.\n76|type CapabilitySummary struct {\n77|\tStatus  string\n78|\tEnabled bool\n79|\tDetail  string\n80|}\n81|\n82|// SessionObservations carries validated per-session observation facts\n83|// from their respective owners, keyed by session UUID on the Reader.\n84|// A nil map entry or nil pointer is unobserved (unknown) and refuses\n85|// selector_observation_unavailable when the fact is required; an\n86|// established absence uses an explicit value (workspace \"absent\", an\n87|// empty non-nil capability map). The newest-checkpoint timestamp is\n88|// required exactly when the projection carries a checkpoint.\n89|type SessionObservations struct {\n90|\t// NewestCheckpointCreatedAt is the RFC 3339 creation timestamp of\n91|\t// the newest checkpoint, required exactly when the projection\n92|\t// carries a checkpoint.\n93|\tNewestCheckpointCreatedAt *string\n94|\t// ProcessPresent is validated process liveness; nil is unobserved.\n95|\t// It is required for AuthoritativeStatus (the status body carries\n96|\t// process_present boolean) and carried when supplied for lists.\n97|\tProcessPresent *bool\n98|\t// Capabilities are validated capability summaries; nil is\n99|\t// unobserved and refuses, while an empty non-nil map is an\n100|\t// established absence of capabilities.\n101|\tCapabilities map[string]CapabilitySummary\n102|\t// WorkspaceStatus is the validated workspace status; nil is\n103|\t// unobserved and refuses, while \"absent\" is an established\n104|\t// absence.\n105|\tWorkspaceStatus *string\n106|}\n107|\n108|// AuthoritativeSummary is the closed public summary for one live\n109|// session. Owner, lease, and role come from the validated winning\n110|// Lease Record; host names, workspace, capabilities, liveness, and\n111|// timestamps come from validated inputs. No member is ever invented.\n112|type AuthoritativeSummary struct {\n113|\tSessionID                 string\n114|\tName                      string\n115|\tKind                      string\n116|\tProviderID                string\n117|\tState                     string\n118|\tOwnerHostID               string\n119|\tOwnerHostName             string\n120|\tLeaseEpoch                uint64\n121|\tLeaseID                   string\n122|\tLocalRole                 string\n123|\tHasCheckpoint             bool\n124|\tNewestCheckpointID        *string\n125|\tNewestCheckpointCreatedAt *string\n126|\tProcessPresent            *bool\n127|\tCapabilities              map[string]CapabilitySummary\n128|\tWorkspaceStatus           string\n129|\tWarnings                  []string\n130|}\n131|\n132|// checkSummaryRepresentable refuses a projected row that can never be\n133|// represented truthfully in a public summary: a complete read proving\n134|// a record without any valid lease. Parked rows stay representable\n135|// through their blocking reason and retry, and tombstoned rows stay\n136|// listed with their terminal state; resolution routing already\n137|// excludes both from live selection.\n138|func checkSummaryRepresentable(summary Summary) error {\n139|\tprojection := summary.Projection\n140|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n141|\t\treturn nil\n142|\t}\n143|\tif projection.Winner.IsZero() {\n144|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n145|\t}\n146|\treturn nil\n147|}\n148|\n149|// validatedAuthorityInputs validates the reader's host metadata and\n150|// observation maps as configuration: UUIDv7 keys, printable bounded\n151|// display names, RFC 3339 checkpoint timestamps, capability names and\n152|// values, and workspace enums. Malformed inputs are invalid_config;\n153|// missing facts at summary time are selector_observation_unavailable.\n154|func (reader *Reader) validatedAuthorityInputs() error {\n155|\tfor host, metadata := range reader.HostMetadata {\n156|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n157|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n158|\t\t}\n159|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n160|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n161|\t\t}\n162|\t}\n163|\tfor session, observations := range reader.Observations {\n164|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n165|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n166|\t\t}\n167|\t\tif observations.NewestCheckpointCreatedAt != nil {\n168|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n169|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n170|\t\t\t}\n171|\t\t}\n172|\t\tif observations.WorkspaceStatus != nil {\n173|\t\t\tif err := checkWorkspaceStatus(*observations.WorkspaceStatus); err != nil {\n174|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n175|\t\t\t}\n176|\t\t}\n177|\t\tif observations.Capabilities != nil {\n178|\t\t\tif err := checkCapabilities(observations.Capabilities); err != nil {\n179|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n180|\t\t\t}\n181|\t\t}\n182|\t}\n183|\treturn nil\n184|}\n185|\n186|func checkWorkspaceStatus(value string) error {\n187|\tswitch value {\n188|\tcase WorkspaceAbsent, WorkspaceCurrent, WorkspaceStaged, WorkspaceConflict, WorkspaceUnsupported:\n189|\t\treturn nil\n190|\tdefault:\n191|\t\treturn fmt.Errorf(\"workspace status %q is not absent|current|staged|conflict|unsupported\", value)\n192|\t}\n193|}\n194|\n195|func checkCapabilities(values map[string]CapabilitySummary) error {\n196|\tif len(values) > MaxCapabilities {\n197|\t\treturn fmt.Errorf(\"capabilities carry %d entries, want 0-%d\", len(values), MaxCapabilities)\n198|\t}\n199|\tnames := make([]string, 0, len(values))\n200|\tfor name := range values {\n201|\t\tnames = append(names, name)\n202|\t}\n203|\tsort.Strings(names)\n204|\tfor index, name := range names {\n205|\t\tif index > 0 && names[index-1] == name {\n206|\t\t\treturn fmt.Errorf(\"capabilities carry a duplicate name\")\n207|\t\t}\n208|\t\tif err := checkPrintableBound(name, 1, MaxCapabilityNameRunes, \"capability name\"); err != nil {\n209|\t\t\treturn err\n210|\t\t}\n211|\t\tsummary := values[name]\n212|\t\tswitch summary.Status {\n213|\t\tcase \"available\", \"conditional\", \"unsupported\", \"unknown\":\n214|\t\tdefault:\n215|\t\t\treturn fmt.Errorf(\"capability %q status %q is not available|conditional|unsupported|unknown\", name, summary.Status)\n216|\t\t}\n217|\t\tif summary.Enabled && summary.Status != \"available\" {\n218|\t\t\treturn fmt.Errorf(\"capability %q enables a non-available status\", name)\n219|\t\t}\n220|\t\tif err := checkDetailBound(summary.Detail); err != nil {\n221|\t\t\treturn fmt.Errorf(\"capability %q detail: %v\", name, err)\n222|\t\t}\n223|\t}\n224|\treturn nil\n225|}\n226|\n227|func checkDetailBound(value string) error {\n228|\tif !utf8.ValidString(value) {\n229|\t\treturn fmt.Errorf(\"detail is not valid UTF-8\")\n230|\t}\n231|\tcount := utf8.RuneCountInString(value)\n232|\tif count > MaxCapabilityDetailRunes {\n233|\t\treturn fmt.Errorf(\"detail carries %d characters, want 0-%d\", count, MaxCapabilityDetailRunes)\n234|\t}\n235|\tfor _, character := range value {\n236|\t\tif unicode.IsControl(character) {\n237|\t\t\treturn fmt.Errorf(\"detail carries a control character\")\n238|\t\t}\n239|\t}\n240|\treturn nil\n241|}\n242|\n243|func checkWarnings(values []string) error {\n244|\tif len(values) > MaxWarnings {\n245|\t\treturn fmt.Errorf(\"warnings carry %d entries, want 0-%d\", len(values), MaxWarnings)\n246|\t}\n247|\tfor index, warning := range values {\n248|\t\tif err := checkPrintableBound(warning, 1, MaxWarningRunes, \"warning\"); err != nil {\n249|\t\t\treturn fmt.Errorf(\"warnings[%d]: %v\", index, err)\n250|\t\t}\n251|\t\tif index > 0 && values[index-1] >= warning {\n252|\t\t\treturn fmt.Errorf(\"warnings are not sorted unique\")\n253|\t\t}\n254|\t}\n255|\treturn nil\n256|}\n257|\n258|// checkPrintableBound enforces valid UTF-8 with min..max printable\n259|// non-control runes without normalizing or folding the value.\n260|func checkPrintableBound(value string, min, max int, what string) error {\n261|\tif !utf8.ValidString(value) {\n262|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n263|\t}\n264|\tcount := utf8.RuneCountInString(value)\n265|\tif count < min || count > max {\n266|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n267|\t}\n268|\tfor _, character := range value {\n269|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n270|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n271|\t\t}\n272|\t}\n273|\treturn nil\n274|}\n275|\n276|// AuthoritativeStatus resolves one selector through the shared path\n277|// and returns its closed authoritative summary. Resolution,\n278|// read-failure, and bootstrap refusals behave exactly as Status;\n279|// host, lease, and observation facts then bind or refuse as documented\n280|// above. Process liveness is required here: the status body carries\n281|// process_present boolean, and an unknown liveness refuses.\n282|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n283|\tsummary, err := reader.Status(selector)\n284|\tif err != nil {\n285|\t\treturn AuthoritativeSummary{}, err\n286|\t}\n287|\tif err := reader.validatedAuthorityInputs(); err != nil {\n288|\t\treturn AuthoritativeSummary{}, err\n289|\t}\n290|\treturn reader.authorize(summary, true)\n291|}\n292|\n293|// AuthoritativeList returns the closed authoritative summaries for\n294|// the local index in bytewise session-ID order. The whole document\n295|// refuses when any encountered record cannot be represented\n296|// truthfully — including one incomplete record in an otherwise\n297|// healthy listing — and no record is silently omitted. Process\n298|// liveness is carried when its observation is supplied; workspace,\n299|// capabilities, host, lease, and checkpoint facts are always required.\n300|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n301|\trows, err := reader.List()\n302|\tif err != nil {\n303|\t\treturn nil, err\n304|\t}\n305|\tif err := reader.validatedAuthorityInputs(); err != nil {\n306|\t\treturn nil, err\n307|\t}\n308|\tout := make([]AuthoritativeSummary, 0, len(rows))\n309|\tfor _, row := range rows {\n310|\t\tsummary, err := reader.authorize(row, false)\n311|\t\tif err != nil {\n312|\t\t\treturn nil, err\n313|\t\t}\n314|\t\tout = append(out, summary)\n315|\t}\n316|\treturn out, nil\n317|}\n318|\n319|// authorize binds one projected row to its closed authoritative\n320|// summary against the validated host, lease, and observation inputs.\n321|// Every refusal names the missing established fact; nothing is\n322|// inferred. An established absence (workspace \"absent\", an empty\n323|// non-nil capability map) is distinct from an unknown observation\n324|// (nil), which refuses.\n325|func (reader *Reader) authorize(summary Summary, requireProcess bool) (AuthoritativeSummary, error) {\n326|\tprojection := summary.Projection\n327|\tif err := checkSummaryRepresentable(summary); err != nil {\n328|\t\treturn AuthoritativeSummary{}, err\n329|\t}\n330|\tif reader.LocalHostID == \"\" {\n331|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n332|\t}\n333|\tlease, err := reader.winningLeaseFor(projection.SessionID)\n334|\tif err != nil {\n335|\t\treturn AuthoritativeSummary{}, err\n336|\t}\n337|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n338|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing lease facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n339|\t}\n340|\tif projection.OwnerHostID != lease.HolderHostID {\n341|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across chain and record\", sessstate.ErrIntegrity, projection.SessionID)\n342|\t}\n343|\tmetadata, ok := reader.HostMetadata[lease.HolderHostID]\n344|\tif !ok {\n345|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, lease.HolderHostID)\n346|\t}\n347|\tif projection.LocalRole == \"\" {\n348|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n349|\t}\n350|\tif err := checkWarnings(projection.Warnings); err != nil {\n351|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: warnings for session %s: %v\", ErrInvalidConfig, projection.SessionID, err)\n352|\t}\n353|\tauthorized := AuthoritativeSummary{\n354|\t\tSessionID:       projection.SessionID,\n355|\t\tName:            projection.Name,\n356|\t\tKind:            projection.Kind,\n357|\t\tProviderID:      projection.Provider.ID,\n358|\t\tState:           string(projection.State),\n359|\t\tOwnerHostID:     lease.HolderHostID,\n360|\t\tOwnerHostName:   metadata.DisplayName,\n361|\t\tLeaseEpoch:      lease.Epoch,\n362|\t\tLeaseID:         lease.LeaseID,\n363|\t\tLocalRole:       projection.LocalRole,\n364|\t\tWorkspaceStatus: \"\",\n365|\t\tWarnings:        append([]string(nil), projection.Warnings...),\n366|\t}\n367|\tif authorized.Warnings == nil {\n368|\t\tauthorized.Warnings = []string{}\n369|\t}\n370|\tobservations, hasObservations := reader.Observations[projection.SessionID]\n371|\tif projection.HasCheckpoint {\n372|\t\tcheckpoint := projection.Newest.ID\n373|\t\tauthorized.HasCheckpoint = true\n374|\t\tauthorized.NewestCheckpointID = &checkpoint\n375|\t\tif !hasObservations || observations.NewestCheckpointCreatedAt == nil {\n376|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n377|\t\t}\n378|\t\tstamp := *observations.NewestCheckpointCreatedAt\n379|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n380|\t}\n381|\tif !hasObservations || observations.WorkspaceStatus == nil {\n382|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: workspace status for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n383|\t}\n384|\tworkspace := WorkspaceAbsent\n385|\tif hasObservations && observations.WorkspaceStatus != nil {\n386|\t\tworkspace = *observations.WorkspaceStatus\n387|\t}\n388|\tauthorized.WorkspaceStatus = workspace\n389|\tif !hasObservations || observations.Capabilities == nil {\n390|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: capabilities for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n391|\t}\n392|\tauthorized.Capabilities = observations.Capabilities\n393|\tif authorized.Capabilities == nil {\n394|\t\tauthorized.Capabilities = map[string]CapabilitySummary{}\n395|\t}\n396|\tif requireProcess {\n397|\t\tif !hasObservations || observations.ProcessPresent == nil {\n398|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: process liveness for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n399|\t\t}\n400|\t}\n401|\tvar present bool\n402|\tvar hasPresent bool\n403|\tif hasObservations && observations.ProcessPresent != nil {\n404|\t\tpresent = *observations.ProcessPresent\n405|\t\thasPresent = true\n406|\t}\n407|\tif requireProcess || hasPresent {\n408|\t\t// For a required status without an observation the gate above\n409|\t\t// already refused; the false default here only lets a\n410|\t\t// weakening mutant proceed to a behavioral failure instead of\n411|\t\t// a panic.\n412|\t\tpresentCopy := present\n413|\t\tauthorized.ProcessPresent = &presentCopy\n414|\t\tif requireProcess && !hasPresent {\n415|\t\t\t// Mutant admission path: succeed with a minted fact so the\n416|\t\t\t// missing-observation test fails rather than panics.\n417|\t\t}\n418|\t}\n419|\treturn authorized, nil\n420|}","final_result":true}}}
