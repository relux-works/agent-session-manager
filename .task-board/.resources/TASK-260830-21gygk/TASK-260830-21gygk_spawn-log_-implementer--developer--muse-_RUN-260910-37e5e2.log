+ idB); err == nil {\n30|\t\tt.Fatal(\"diagnostic premise: expected record divergence\")\n31|\t} else {\n32|\t\tt.Logf(\"fresh Resolve: %v\", err)\n33|\t}\n34|\tif err := reader.Revalidate(plan); err == nil {\n35|\t\tt.Fatal(\"Revalidate accepted conflicting immutable record for the selected UUID in another allowed source\")\n36|\t}\n37|}\n38|func TestReviewerBootstrapSummaryMustRefuse(t *testing.T) {\n39|\tlocal, _ := repository(t)\n40|\tcreate(t, local, idA, \"alpha\")\n41|\treader := &Reader{Local: local, LocalHostID: hostA}\n42|\tt.Run(\"list\", func(t *testing.T) {\n43|\t\trows, err := reader.List()\n44|\t\tif err == nil {\n45|\t\t\tt.Fatalf(\"List accepted record-only bootstrap: rows=%d epoch=%d owner=%q\", len(rows), rows[0].Projection.Winner.Epoch, rows[0].Projection.OwnerHostID)\n46|\t\t}\n47|\t})\n48|\tt.Run(\"status\", func(t *testing.T) {\n49|\t\trow, err := reader.Status(\"alpha\")\n50|\t\tif err == nil {\n51|\t\t\tt.Fatalf(\"Status accepted record-only bootstrap: epoch=%d owner=%q\", row.Projection.Winner.Epoch, row.Projection.OwnerHostID)\n52|\t\t}\n53|\t})\n54|}\n55|func TestReviewerPlanRequiresLeaseRecord(t *testing.T) {\n56|\treader, _, _, _ := plannedSession(t)\n57|\t// plannedSession already carries the winning Lease Record; this\n58|\t// gate proves the plan binds its canonical digest, never an\n59|\t// envelope fingerprint, and refuses when the record is absent.\n60|\treader.LocalHostID = hostA\n61|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n62|\traw, err := plan.Marshal()\n63|\tif err != nil {\n64|\t\tt.Fatal(err)\n65|\t}\n66|\tvar fields map[string]any\n67|\tif err := json.Unmarshal(raw, &fields); err != nil {\n68|\t\tt.Fatal(err)\n69|\t}\n70|\tif _, ok := fields[\"lease_record_id\"]; !ok {\n71|\t\tt.Fatal(\"plan omits required validated lease_record_id\")\n72|\t}\n73|\twinner, err := reader.winningLeaseFor(idA)\n74|\tif err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\tif plan.LeaseRecordID != winner.Digest {\n78|\t\tt.Fatalf(\"lease_record_id = %q, want winning record %q\", plan.LeaseRecordID, winner.Digest)\n79|\t}\n80|\t// Absence refuses rather than binding a placeholder.\n81|\tbare, _ := repository(t)\n82|\tbareRef := create(t, bare, idA, \"alpha\")\n83|\tappendEvent(t, bare, idA, bareRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": bareRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n84|\tbareReader := &Reader{Local: bare, LocalHostID: hostA}\n85|\tif _, err := bareReader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n86|\t\tt.Fatalf(\"missing lease build = %v, want selector_observation_unavailable\", err)\n87|\t}\n88|}\n89|\n90|// TestRev3RealLeaseRecordIdentity proves the plan binds the canonical\n91|// digest of an actual validated Lease Record, never a four-field\n92|// envelope fingerprint. The fixture is validated through the\n93|// canonicaljson owner before driving the production BuildPlan entry.\n94|func TestRev3RealLeaseRecordIdentity(t *testing.T) {\n95|\tlocal, _ := repository(t)\n96|\tref := create(t, local, idA, \"alpha\")\n97|\tappendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n98|\tleaseBytes := leaseCreate(t, idA, hostA)\n99|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(leaseBytes)\n100|\tif err != nil {\n101|\t\tt.Fatal(err)\n102|\t}\n103|\tif string(field) != \"record_id\" {\n104|\t\tt.Fatalf(\"lease identity field = %q, want record_id\", string(field))\n105|\t}\n106|\treader := &Reader{Local: local, LocalHostID: hostA}\n107|\twithLeases(reader, leaseBytes)\n108|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n109|\tif plan.LeaseRecordID != digest.String() {\n110|\t\tt.Fatalf(\"lease_record_id = %q, want validated record %q\", plan.LeaseRecordID, digest.String())\n111|\t}\n112|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n113|\t\tt.Fatalf(\"lease triple not from winning record: %+v\", plan)\n114|\t}\n115|}\n116|\n117|// TestRev3DifferentAttestationMustNotAuthorize proves a different\n118|// envelope attestation never authorizes without its Lease Record: a\n119|// plan carrying a substituted digest refuses at revalidation, and a\n120|// build with no admitted record refuses instead of binding.\n121|func TestRev3DifferentAttestationMustNotAuthorize(t *testing.T) {\n122|\treader, _, _, _ := plannedSession(t)\n123|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n124|\traw, err := plan.Marshal()\n125|\tif err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\tparsed, err := ParsePlan(raw)\n129|\tif err != nil {\n130|\t\tt.Fatal(err)\n131|\t}\n132|\tif err := reader.Revalidate(parsed); err != nil {\n133|\t\tt.Fatalf(\"fresh plan with its admitted record is not current: %v\", err)\n134|\t}\n135|\t// A substituted attestation digest with no supporting record is\n136|\t// caught at shape time when malformed and at revalidation when\n137|\t// well-formed but disagreeing: hand-forge a well-formed digest for\n138|\t// another lease and prove it does not validate.\n139|\tforged := plan\n140|\tforged.LeaseID = leaseB\n141|\tforged.LeaseRecordID = plan.LeaseRecordID\n142|\tif err := reader.Revalidate(forged); !errors.Is(err, ErrPlanStale) {\n143|\t\tt.Fatalf(\"substituted lease triple = %v, want selector_plan_stale\", err)\n144|\t}\n145|\tempty, _ := repository(t)\n146|\temptyRef := create(t, empty, idA, \"alpha\")\n147|\tappendEvent(t, empty, idA, emptyRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": emptyRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n148|\temptyReader := &Reader{Local: empty, LocalHostID: hostA}\n149|\tif _, err := emptyReader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n150|\t\tt.Fatalf(\"record without lease build = %v, want selector_observation_unavailable\", err)\n151|\t}\n152|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccdb","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1224,"recorded_at":1780531400002443,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"call_id":"call_01a088d8532479a08c6452c75bcec3f6","text":"Read text file `internal/sessquery/summary_test.go`.\n1|// Authoritative summary tests for TASK-260830-21gygk (SPEC 14.7.3):\n2|// bootstrap refusal, whole-list refusal, validated host and\n3|// observation inputs, and observation-unavailable classification,\n4|// all driven through the production summary entries.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"reflect\"\n10|\t\"testing\"\n11|)\n12|\n13|// summaryReader builds a leased local session with host metadata,\n14|// winning Lease Record, and required observations for its owner.\n15|func summaryReader(t *testing.T) *Reader {\n16|\tt.Helper()\n17|\trepo, _ := repository(t)\n18|\tref := create(t, repo, idA, \"alpha\")\n19|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n20|\tpresent := true\n21|\tworkspace := WorkspaceAbsent\n22|\treader := &Reader{\n23|\t\tLocal:        repo,\n24|\t\tLocalHostID:  hostA,\n25|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n26|\t\tObservations: map[string]SessionObservations{idA: {\n27|\t\t\tProcessPresent:  &present,\n28|\t\t\tCapabilities:    map[string]CapabilitySummary{},\n29|\t\t\tWorkspaceStatus: &workspace,\n30|\t\t}},\n31|\t}\n32|\twithLeases(reader, leaseCreate(t, idA, hostA))\n33|\treturn reader\n34|}\n35|\n36|func TestSummaryBootstrapRefusals(t *testing.T) {\n37|\tlocal, _ := repository(t)\n38|\tcreate(t, local, idA, \"alpha\")\n39|\treader := &Reader{Local: local, LocalHostID: hostA}\n40|\tfor _, selector := range []string{\"alpha\", idA, \"id:\" + idA, \"alpha@local\"} {\n41|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n42|\t\t\tt.Fatalf(\"Status(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n43|\t\t}\n44|\t\tif _, err := reader.AuthoritativeStatus(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n45|\t\t\tt.Fatalf(\"AuthoritativeStatus(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n46|\t\t}\n47|\t}\n48|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrBootstrapIncomplete) {\n49|\t\tt.Fatalf(\"AuthoritativeList = %v, want selector_bootstrap_incomplete\", err)\n50|\t}\n51|\t// Explicit local inspection keeps raw access to the recovery\n52|\t// diagnostics: it is not a public summary entry.\n53|\tinspected, err := reader.InspectLocal(idA)\n54|\tif err != nil || inspected.Projection.SessionID != idA {\n55|\t\tt.Fatalf(\"InspectLocal = %+v, %v\", inspected, err)\n56|\t}\n57|}\n58|\n59|func TestSummaryMixedListRefusesWhole(t *testing.T) {\n60|\trepo, _ := repository(t)\n61|\thealthy := create(t, repo, idA, \"alpha\")\n62|\tappendEvent(t, repo, idA, healthy.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": healthy.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n63|\tcreate(t, repo, idB, \"Zed\")\n64|\treader := &Reader{\n65|\t\tLocal:        repo,\n66|\t\tLocalHostID:  hostA,\n67|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n68|\t}\n69|\t// One unrepresentable record refuses the whole document: no\n70|\t// partial rows escape, and the healthy entry is not silently\n71|\t// kept while the incomplete one is omitted.\n72|\trows, err := reader.List()\n73|\tif !errors.Is(err, ErrBootstrapIncomplete) || rows != nil {\n74|\t\tt.Fatalf(\"List = %d rows, %v, want whole selector_bootstrap_incomplete refusal\", len(rows), err)\n75|\t}\n76|\tauthorized, err := reader.AuthoritativeList()\n77|\tif !errors.Is(err, ErrBootstrapIncomplete) || authorized != nil {\n78|\t\tt.Fatalf(\"AuthoritativeList = %d rows, %v, want whole refusal\", len(authorized), err)\n79|\t}\n80|}\n81|\n82|func TestAuthoritativeStatusHealthy(t *testing.T) {\n83|\treader := summaryReader(t)\n84|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n85|\tif err != nil {\n86|\t\tt.Fatal(err)\n87|\t}\n88|\tif summary.SessionID != idA || summary.Name != \"alpha\" || summary.Kind != \"direct\" || summary.ProviderID != \"codex\" || summary.State != \"creating\" {\n89|\t\tt.Fatalf(\"identity: %+v\", summary)\n90|\t}\n91|\tif summary.OwnerHostID != hostA || summary.OwnerHostName != \"primary\" || summary.LeaseEpoch != 1 || summary.LeaseID != lease || summary.LocalRole != \"owner\" {\n92|\t\tt.Fatalf(\"authority: %+v\", summary)\n93|\t}\n94|\t// Before the first checkpoint both checkpoint members are null.\n95|\tif summary.HasCheckpoint || summary.NewestCheckpointID != nil || summary.NewestCheckpointCreatedAt != nil {\n96|\t\tt.Fatalf(\"checkpoint before first checkpoint: %+v\", summary)\n97|\t}\n98|\t// Required observations bind explicitly: workspace absent is an\n99|\t// established absence, capabilities empty is established empty,\n100|\t// and process liveness is required for status.\n101|\tif summary.WorkspaceStatus != WorkspaceAbsent {\n102|\t\tt.Fatalf(\"workspace: %+v\", summary)\n103|\t}\n104|\tif summary.Capabilities == nil || len(summary.Capabilities) != 0 {\n105|\t\tt.Fatalf(\"capabilities: %+v\", summary)\n106|\t}\n107|\tif summary.ProcessPresent == nil || !*summary.ProcessPresent {\n108|\t\tt.Fatalf(\"process: %+v\", summary)\n109|\t}\n110|\tif len(summary.Warnings) != 0 {\n111|\t\tt.Fatalf(\"warnings: %+v\", summary)\n112|\t}\n113|\tlist, err := reader.AuthoritativeList()\n114|\tif err != nil || len(list) != 1 {\n115|\t\tt.Fatalf(\"list/status disagreement: %+v %v\", list, err)\n116|\t}\n117|\tif !reflect.DeepEqual(list[0].Capabilities, summary.Capabilities) || list[0].WorkspaceStatus != summary.WorkspaceStatus {\n118|\t\tt.Fatalf(\"list/status observation disagreement: %+v vs %+v\", list[0], summary)\n119|\t}\n120|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
