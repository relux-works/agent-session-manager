{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccd1","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1219,"recorded_at":1780531400002433,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d8-5601-7522-bba4-dcb5066da5a0"},"task_id":"01a088d8-5601-7522-bba4-dcb5066da5a0","event":{"kind":"output","task_id":"01a088d8-5601-7522-bba4-dcb5066da5a0","chunk":"Read text file `internal/sessquery/summary_test.go`.\n1|// Authoritative summary tests for TASK-260830-21gygk (SPEC 14.7.3):\n2|// bootstrap refusal, whole-list refusal, validated host and\n3|// observation inputs, and observation-unavailable classification,\n4|// all driven through the production summary entries.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"reflect\"\n10|\t\"testing\"\n11|)\n12|\n13|// summaryReader builds a leased local session with host metadata,\n14|// winning Lease Record, and required observations for its owner.\n15|func summaryReader(t *testing.T) *Reader {\n16|\tt.Helper()\n17|\trepo, _ := repository(t)\n18|\tref := create(t, repo, idA, \"alpha\")\n19|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n20|\tpresent := true\n21|\tworkspace := WorkspaceAbsent\n22|\treader := &Reader{\n23|\t\tLocal:        repo,\n24|\t\tLocalHostID:  hostA,\n25|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n26|\t\tObservations: map[string]SessionObservations{idA: {\n27|\t\t\tProcessPresent:  &present,\n28|\t\t\tCapabilities:    map[string]CapabilitySummary{},\n29|\t\t\tWorkspaceStatus: &workspace,\n30|\t\t}},\n31|\t}\n32|\twithLeases(reader, leaseCreate(t, idA, hostA))\n33|\treturn reader\n34|}\n35|\n36|func TestSummaryBootstrapRefusals(t *testing.T) {\n37|\tlocal, _ := repository(t)\n38|\tcreate(t, local, idA, \"alpha\")\n39|\treader := &Reader{Local: local, LocalHostID: hostA}\n40|\tfor _, selector := range []string{\"alpha\", idA, \"id:\" + idA, \"alpha@local\"} {\n41|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n42|\t\t\tt.Fatalf(\"Status(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n43|\t\t}\n44|\t\tif _, err := reader.AuthoritativeStatus(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n45|\t\t\tt.Fatalf(\"AuthoritativeStatus(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n46|\t\t}\n47|\t}\n48|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrBootstrapIncomplete) {\n49|\t\tt.Fatalf(\"AuthoritativeList = %v, want selector_bootstrap_incomplete\", err)\n50|\t}\n51|\t// Explicit local inspection keeps raw access to the recovery\n52|\t// diagnostics: it is not a public summary entry.\n53|\tinspected, err := reader.InspectLocal(idA)\n54|\tif err != nil || inspected.Projection.SessionID != idA {\n55|\t\tt.Fatalf(\"InspectLocal = %+v, %v\", inspected, err)\n56|\t}\n57|}\n58|\n59|func TestSummaryMixedListRefusesWhole(t *testing.T) {\n60|\trepo, _ := repository(t)\n61|\thealthy := create(t, repo, idA, \"alpha\")\n62|\tappendEvent(t, repo, idA, healthy.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": healthy.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n63|\tcreate(t, repo, idB, \"Zed\")\n64|\treader := &Reader{\n65|\t\tLocal:        repo,\n66|\t\tLocalHostID:  hostA,\n67|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n68|\t}\n69|\t// One unrepresentable record refuses the whole document: no\n70|\t// partial rows escape, and the healthy entry is not silently\n71|\t// kept while the incomplete one is omitted.\n72|\trows, err := reader.List()\n73|\tif !errors.Is(err, ErrBootstrapIncomplete) || rows != nil {\n74|\t\tt.Fatalf(\"List = %d rows, %v, want whole selector_bootstrap_incomplete refusal\", len(rows), err)\n75|\t}\n76|\tauthorized, err := reader.AuthoritativeList()\n77|\tif !errors.Is(err, ErrBootstrapIncomplete) || authorized != nil {\n78|\t\tt.Fatalf(\"AuthoritativeList = %d rows, %v, want whole refusal\", len(authorized), err)\n79|\t}\n80|}\n81|\n82|func TestAuthoritativeStatusHealthy(t *testing.T) {\n83|\treader := summaryReader(t)\n84|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n85|\tif err != nil {\n86|\t\tt.Fatal(err)\n87|\t}\n88|\tif summary.SessionID != idA || summary.Name != \"alpha\" || summary.Kind != \"direct\" || summary.ProviderID != \"codex\" || summary.State != \"creating\" {\n89|\t\tt.Fatalf(\"identity: %+v\", summary)\n90|\t}\n91|\tif summary.OwnerHostID != hostA || summary.OwnerHostName != \"primary\" || summary.LeaseEpoch != 1 || summary.LeaseID != lease || summary.LocalRole != \"owner\" {\n92|\t\tt.Fatalf(\"authority: %+v\", summary)\n93|\t}\n94|\t// Before the first checkpoint both checkpoint members are null.\n95|\tif summary.HasCheckpoint || summary.NewestCheckpointID != nil || summary.NewestCheckpointCreatedAt != nil {\n96|\t\tt.Fatalf(\"checkpoint before first checkpoint: %+v\", summary)\n97|\t}\n98|\t// Required observations bind explicitly: workspace absent is an\n99|\t// established absence, capabilities empty is established empty,\n100|\t// and process liveness is required for status.\n101|\tif summary.WorkspaceStatus != WorkspaceAbsent {\n102|\t\tt.Fatalf(\"workspace: %+v\", summary)\n103|\t}\n104|\tif summary.Capabilities == nil || len(summary.Capabilities) != 0 {\n105|\t\tt.Fatalf(\"capabilities: %+v\", summary)\n106|\t}\n107|\tif summary.ProcessPresent == nil || !*summary.ProcessPresent {\n108|\t\tt.Fatalf(\"process: %+v\", summary)\n109|\t}\n110|\tif len(summary.Warnings) != 0 {\n111|\t\tt.Fatalf(\"warnings: %+v\", summary)\n112|\t}\n113|\tlist, err := reader.AuthoritativeList()\n114|\tif err != nil || len(list) != 1 {\n115|\t\tt.Fatalf(\"list/status disagreement: %+v %v\", list, err)\n116|\t}\n117|\tif !reflect.DeepEqual(list[0].Capabilities, summary.Capabilities) || list[0].WorkspaceStatus != summary.WorkspaceStatus {\n118|\t\tt.Fatalf(\"list/status observation disagreement: %+v vs %+v\", list[0], summary)\n119|\t}\n120|}\n(more lines below)","final_result":true}}}
