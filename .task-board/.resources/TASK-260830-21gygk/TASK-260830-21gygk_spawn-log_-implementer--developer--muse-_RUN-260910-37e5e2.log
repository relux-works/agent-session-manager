{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e173","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":3860,"recorded_at":1780531400007715,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"call_id":"call_01a088e95d527b00a4aa4a8c6f842078","text":"Read text file `internal/sessquery/lease.go`.\n(240 line(s) above)\n241|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n242|// Record for one session and validates its succession: the\n243|// predecessor ancestry must chain by epoch plus one down to an\n244|// epoch-1 root, and the winner must reference a validated checkpoint\n245|// for its session and predecessor lease. Absence refuses\n246|// observation_unavailable; a winner above epoch 1 without its named\n247|// predecessor in the admitted set refuses the same class rather\n248|// than binding a dangling successor, while an illegal predecessor\n249|// link is malformed authority (integrity failure).\n250|func (reader *Reader) winningLeaseFor(sessionID string) (validatedLease, error) {\n251|\tbySession, err := reader.validatedLeasesBySession()\n252|\tif err != nil {\n253|\t\treturn validatedLease{}, err\n254|\t}\n255|\tcandidates := bySession[sessionID]\n256|\tif len(candidates) == 0 {\n257|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n258|\t}\n259|\twinner := candidates[0]\n260|\tfor _, candidate := range candidates[1:] {\n261|\t\tif sessstate.Compare(\n262|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n263|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n264|\t\t) > 0 {\n265|\t\t\twinner = candidate\n266|\t\t}\n267|\t}\n268|\tpredecessor, err := checkLeaseChain(candidates, winner)\n269|\tif err != nil {\n270|\t\treturn validatedLease{}, err\n271|\t}\n272|\tif err := reader.checkWinnerCheckpoint(winner, predecessor); err != nil {\n273|\t\treturn validatedLease{}, err\n274|\t}\n275|\treturn winner, nil\n276|}\n277|\n278|// checkLeaseChain validates the winner's predecessor ancestry within\n279|// the admitted records for its session. Section 5.3 requires every\n280|// epoch above 1 to name a known predecessor for the same session\n281|// with an epoch exactly one below, down to an epoch-1 root with a\n282|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n283|// lease naming any predecessor is malformed. A self, cyclic,\n284|// skipped, dangling, contradictory, or duplicated link is malformed\n285|// authority (integrity failure): epochs strictly decrease along the\n286|// walk, so the walk always terminates. It returns the winner's\n287|// direct predecessor, or the zero lease at epoch 1.\n288|func checkLeaseChain(candidates []validatedLease, winner validatedLease) (validatedLease, error) {\n289|\tbyLease := make(map[string]validatedLease, len(candidates))\n290|\tfor _, candidate := range candidates {\n291|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n292|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n293|\t\t}\n294|\t\tbyLease[candidate.LeaseID] = candidate\n295|\t}\n296|\tvar predecessor validatedLease\n297|\tcurrent := winner\n298|\tfor {\n299|\t\tif current.Epoch == 1 {\n300|\t\t\tif current.HasPredecessor {\n301|\t\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n302|\t\t\t}\n303|\t\t\treturn predecessor, nil\n304|\t\t}\n305|\t\tif !current.HasPredecessor {\n306|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n307|\t\t}\n308|\t\tparent, ok := byLease[current.Predecessor]\n309|\t\tif !ok {\n310|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n311|\t\t}\n312|\t\tif parent.Epoch+1 != current.Epoch {\n313|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n314|\t\t}\n315|\t\tif current.LeaseID == winner.LeaseID {\n316|\t\t\tpredecessor = parent\n317|\t\t}\n318|\t\tcurrent = parent\n319|\t}\n320|}\n321|\n322|// validatedCheckpointsByDigest validates every supplied Checkpoint\n323|// Record and indexes the admitted records by canonical digest.\n324|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n325|\tout := map[string]validatedCheckpoint{}\n326|\tif reader == nil {\n327|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n328|\t}\n329|\tfor _, raw := range reader.CheckpointRecords {\n330|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n331|\t\tif err != nil {\n332|\t\t\treturn nil, err\n333|\t\t}\n334|\t\tout[checkpoint.Digest] = checkpoint\n335|\t}\n336|\treturn out, nil\n337|}\n338|\n339|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n340|// against the admitted Checkpoint Records. Section 5.3 requires\n341|// every epoch above 1 to reference a validated checkpoint for its\n342|// session and predecessor lease; an epoch-1 root without a\n343|// predecessor may carry no checkpoint before the first provider\n344|// boundary exists. A non-null reference must resolve to an admitted\n345|// record for the same session bound to the lease it was taken\n346|// under: the predecessor for a successor, the winner itself at\n347|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n348|// unresolvable reference is incomplete authority\n349|// (observation_unavailable), never absence or a minted fact.\n350|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease) error {\n351|\tif !winner.HasCheckpoint {\n352|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n353|\t\t\treturn nil\n354|\t\t}\n355|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n356|\t}\n357|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n358|\tif err != nil {\n359|\t\treturn err\n360|\t}\n361|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n362|\tif !ok {\n363|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n364|\t}\n365|\tif checkpoint.SessionID != winner.SessionID {\n366|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n367|\t}\n368|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n369|\tif winner.Epoch > 1 {\n370|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
