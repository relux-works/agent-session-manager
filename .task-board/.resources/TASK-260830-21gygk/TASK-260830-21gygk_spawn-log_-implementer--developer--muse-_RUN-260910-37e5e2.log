{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d041","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1659,"recorded_at":1780531400003313,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088da-7994-7970-ac5b-cd7659de1220"},"task_id":"01a088da-7994-7970-ac5b-cd7659de1220","event":{"kind":"output","task_id":"01a088da-7994-7970-ac5b-cd7659de1220","chunk":"Read text file `internal/provhost/identity_test.go`.\n(129 line(s) above)\n130|// segment, so internal/provhost/sessrepo/plant.go (same leaf name,\n131|// foreign owner) and internal/xsessrepo/plant.go (near-miss name) both\n132|// land outside the allowlist while the leaf's own files stay admitted.\n133|func isSessrepoLeafFile(root, path string) bool {\n134|\tleaf := filepath.Join(root, \"internal\", \"sessrepo\") + string(filepath.Separator)\n135|\treturn strings.HasPrefix(path, leaf)\n136|}\n137|\n138|// scanAttestationSites walks the production trees beneath root and\n139|// classifies every VerifyObjectIdentity call: inside the owning leaf it\n140|// is allowlisted, anywhere else it contradicts the bound. It returns\n141|// the allowlisted entries, the contradicting entries, and the scanned\n142|// and parsed file counts.\n143|func scanAttestationSites(t *testing.T, root string) (allowed, callers []string, scanned, parsed int) {\n144|\tt.Helper()\n145|\tfor _, tree := range []string{\"internal\", \"cmd\"} {\n146|\t\tbase := filepath.Join(root, tree)\n147|\t\tif _, err := os.Stat(base); err != nil {\n148|\t\t\tcontinue\n149|\t\t}\n150|\t\t// Recursion stays local: the core selects single-package\n151|\t\t// production files, while this attestation spans trees.\n152|\t\t// Fail-closed parsing is the core's.\n153|\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\n154|\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n155|\t\t\t\treturn err\n156|\t\t\t}\n157|\t\t\tscanned++\n158|\t\t\tsource, err := os.ReadFile(path)\n159|\t\t\tif err != nil {\n(more lines below)","final_result":true}}}
