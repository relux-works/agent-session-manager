{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c821","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":619,"recorded_at":1780531400001233,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"call_id":"call_01a088d6336471508d78619e1408b233","text":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tRaw            []byte\n39|}\n40|\n41|// parseLeaseRecord validates one canonical Lease Record through the\n42|// canonicaljson owner and extracts the bound members. Closed-shape and\n43|// identity failures refuse invalid_config; the caller maps absence to\n44|// observation_unavailable.\n45|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n46|\tvar lease validatedLease\n47|\tmembers, fault := environ.DecodeStrictObject(raw)\n48|\tif fault != nil {\n49|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n50|\t}\n51|\tschema, err := leaseStringMember(members, \"schema\")\n52|\tif err != nil || schema != leaseRecordSchema {\n53|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n54|\t}\n55|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n56|\tif err != nil {\n57|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n58|\t}\n59|\tif field != canonicaljson.SelfRecordID {\n60|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n61|\t}\n62|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n63|\tif !ok {\n64|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n65|\t}\n66|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n67|\tif err != nil {\n68|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n69|\t}\n70|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n71|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n72|\t}\n73|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n74|\tif !ok {\n75|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n76|\t}\n77|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n78|\tif !ok {\n79|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n80|\t}\n81|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n82|\tif err != nil {\n83|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n84|\t}\n85|\tlease = validatedLease{\n86|\t\tDigest:         digest.String(),\n87|\t\tSessionID:      sessionID.String(),\n88|\t\tLeaseID:        leaseID,\n89|\t\tEpoch:          epoch,\n90|\t\tHolderHostID:   holder.String(),\n91|\t\tPredecessor:    predecessor,\n92|\t\tHasPredecessor: hasPredecessor,\n93|\t\tRaw:            append([]byte(nil), raw...),\n94|\t}\n95|\treturn lease, nil\n96|}\n97|\n98|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n99|\treturn members[name]\n100|}\n101|\n102|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n103|\traw, ok := members[name]\n104|\tif !ok {\n105|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n106|\t}\n107|\tvar value string\n108|\tif err := json.Unmarshal(raw, &value); err != nil {\n109|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n110|\t}\n111|\treturn value, nil\n112|}\n113|\n114|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n115|\traw, ok := members[name]\n116|\tif !ok {\n117|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n118|\t}\n119|\tif string(raw) == \"null\" {\n120|\t\treturn \"\", false, nil\n121|\t}\n122|\tvar value string\n123|\tif err := json.Unmarshal(raw, &value); err != nil {\n124|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n125|\t}\n126|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n127|\t\treturn \"\", false, err\n128|\t}\n129|\treturn value, true, nil\n130|}\n131|\n132|// validatedLeasesBySession validates every supplied Lease Record and\n133|// groups the admitted records by session UUID.\n134|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n135|\tout := map[string][]validatedLease{}\n136|\tif reader == nil {\n137|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n138|\t}\n139|\tfor _, raw := range reader.LeaseRecords {\n140|\t\tlease, err := parseLeaseRecord(raw)\n141|\t\tif err != nil {\n142|\t\t\treturn nil, err\n143|\t\t}\n144|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n145|\t}\n146|\treturn out, nil\n147|}\n148|\n149|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n150|// Record for one session. Absence refuses observation_unavailable; a\n151|// winner above epoch 1 without its named predecessor in the admitted\n152|// set refuses the same class rather than binding a dangling successor.\n153|func (reader *Reader) winningLeaseFor(sessionID string) (validatedLease, error) {\n154|\tbySession, err := reader.validatedLeasesBySession()\n155|\tif err != nil {\n156|\t\treturn validatedLease{}, err\n157|\t}\n158|\tcandidates := bySession[sessionID]\n159|\tif len(candidates) == 0 {\n160|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n161|\t}\n162|\twinner := candidates[0]\n163|\tfor _, candidate := range candidates[1:] {\n164|\t\tif sessstate.Compare(\n165|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n166|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n167|\t\t) > 0 {\n168|\t\t\twinner = candidate\n169|\t\t}\n170|\t}\n171|\tif winner.Epoch > 1 {\n172|\t\tif !winner.HasPredecessor {\n173|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, sessionID)\n174|\t\t}\n175|\t\tfound := false\n176|\t\tfor _, candidate := range candidates {\n177|\t\t\tif candidate.LeaseID == winner.Predecessor {\n178|\t\t\t\tfound = true\n179|\t\t\t\tbreak\n180|\t\t\t}\n181|\t\t}\n182|\t\tif !found {\n183|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n184|\t\t}\n185|\t}\n186|\treturn winner, nil\n187|}\n188|\n189|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n190|// greatest epoch wins, ties break by bytewise lease-ID order.\n191|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n192|\treturn sessstate.Compare(\n193|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n194|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n195|\t)\n196|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c823","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":620,"recorded_at":1780531400001235,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"call_id":"call_01a088d633e77a13b181ed2d28fe6518","text":"Read text file `internal/sessrepo/lease.go`.\n1|// Lease Record attestation for the session-persistence leaf.\n2|//\n3|// Lease Records (urn:ax:schema:lease) are session-persistence objects\n4|// alongside Session Records and Session Events. This helper owns their\n5|// canonical identity attestation through the canonicaljson owner, so\n6|// query-layer admission (internal/sessquery) never attests the binding\n7|// itself: it calls AttestLeaseRecord and then extracts the already\n8|// validated members. The provhost identity bound allowlists this site\n9|// with the three session record/event sites.\n10|package sessrepo\n11|\n12|import (\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// AttestLeaseRecord validates one canonical Lease Record frame through\n18|// the canonicaljson owner and returns its canonical digest with the\n19|// self-identity field. Closed-shape and self-identity failures are\n20|// returned for the caller to map to its refusal class.\n21|func AttestLeaseRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\n22|\treturn canonicaljson.VerifyObjectIdentity(raw)\n23|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c825","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":621,"recorded_at":1780531400001237,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"call_id":"call_01a088d6348b7462a708ccc905b96046","text":"Read text file `internal/sessquery/plan.go`.\n1|// Immutable SelectionPlan construction and current-fact revalidation\n2|// for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Resolve the key to a session UUID once per invocation or confirmed\n5|// plan, then bind the selection facts into a machine-local immutable\n6|// plan: the literal selector, the selected session and its validated\n7|// immutable record digest, the selected source (host and exact alias),\n8|// the digests of the complete validated index read and the effective\n9|// validated configuration, the validated winning lease facts, the\n10|// validated authority heads, and the caller-declared action,\n11|// destination, and expectations. No plan hash, name, source, or display\n12|// field is a capability. All sixteen contract members bind; a future\n13|// member without a bound row fails its publication gate closed instead\n14|// of falling into a default.\n15|//\n16|// Lease authority comes from validated urn:ax:schema:lease records\n17|// supplied in Reader.LeaseRecords and admitted through the\n18|// canonicaljson owner. The plan binds lease_record_id as the canonical\n19|// digest of the winning Lease Record for the selected session, and the\n20|// lease triple binds from that same record. No envelope observation\n21|// substitutes for the record: a session with no admitted winning\n22|// record refuses selector_observation_unavailable, and malformed bytes\n23|// refuse invalid_config. A complete read proving a record without any\n24|// valid lease refuses selector_bootstrap_incomplete instead of binding\n25|// an empty triple, and a local selection without a known local host\n26|// refuses invalid_config instead of binding an empty source host.\n27|//\n28|// Revalidation rereads the current configuration and the plan's source,\n29|// validates the same immutable record, the current winning lease, and\n30|// the action prerequisites this leaf can check, compares every bound\n31|// plan fact in a fixed order, and then validates the complete\n32|// authority union for the pinned session UUID across the local and\n33|// every allowlisted source: a contradictory immutable record is\n34|// integrity failure, a contradictory winning lease or fresh tombstone\n35|// evidence is stale. A changed mapping, alias, allowlist, transport,\n36|// source index, record, authority head, lease, action, destination, or\n37|// expectation invalidates the plan with selector_plan_stale naming the\n38|// first diverged member; explicit authorization revocation returns\n39|// peer_not_allowlisted; failed reads retain their read-failure\n40|// classification. Revalidation never re-resolves by name, substitutes\n41|// a same-named session, silently replans, transfers a lease, or reuses\n42|// confirmation for new facts.\n43|//\n44|// Effect authorization beyond read projection — fencing, commit,\n45|// retry, recovery, remote dispatch/admission, and transport-resume\n46|// prerequisites, and the composed per-endpoint invocation bindings —\n47|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n48|// every boundary in BoundariesFor for their action. A plan built here\n49|// authorizes read projection only.\n50|package sessquery\n51|\n52|import (\n53|\t\"fmt\"\n54|\n55|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n56|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n57|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n58|)\n59|\n60|// SelectorVersion is the exact selector contract version every plan binds.\n61|const SelectorVersion = \"1.0.0\"\n62|\n63|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n64|// an existing command/action tag; binding one selects it, never an\n65|// umbrella bypass.\n66|const (\n67|\tActionStatus      = \"status\"\n68|\tActionAttach      = \"attach\"\n69|\tActionTakeover    = \"takeover\"\n70|\tActionFork        = \"fork\"\n71|\tActionStop        = \"stop\"\n72|\tActionResume      = \"resume\"\n73|\tActionSync        = \"sync\"\n74|\tActionDiff        = \"diff\"\n75|\tActionMaterialize = \"materialize\"\n76|\tActionSetProfile  = \"session.set-profile\"\n77|\tActionLogs        = \"logs\"\n78|\tActionCancel      = \"cancel\"\n79|)\n80|\n81|// Plan boundaries from the normative action/boundary matrix. A boundary\n82|// is reached only when the existing operation reaches that phase; these\n83|// rows introduce no new effects.\n84|const (\n85|\tBoundaryProjection      = \"projection\"\n86|\tBoundaryPreEffect       = \"pre-effect\"\n87|\tBoundaryFencing         = \"fencing\"\n88|\tBoundaryCommit          = \"commit\"\n89|\tBoundaryRetry           = \"retry\"\n90|\tBoundaryRecovery        = \"recovery\"\n91|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n92|\tBoundaryRemoteAdmission = \"remote-admission\"\n93|\tBoundaryTransportResume = \"transport-resume\"\n94|)\n95|\n96|// planBoundaries is the closed action/boundary matrix: every action has\n97|// exactly its normative row, and an unknown action has none.\n98|var planBoundaries = map[string][]string{\n99|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n100|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n101|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n102|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n103|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n104|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n105|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n106|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n107|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n108|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n109|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n110|\tActionCancel:      {BoundaryProjection},\n111|}\n112|\n113|// BoundariesFor returns the required boundary classes for a plan\n114|// action. The boolean reports whether the action is a known tag; an\n115|// unknown action binds no boundary and builds no plan.\n116|func BoundariesFor(action string) ([]string, bool) {\n117|\tboundaries, ok := planBoundaries[action]\n118|\tif !ok {\n119|\t\treturn nil, false\n120|\t}\n121|\treturn append([]string(nil), boundaries...), true\n122|}\n123|\n124|// SelectionPlan is the machine-local immutable binding of one selector\n125|// resolution. All members are values, never references: there is no\n126|// mutator, and Marshal carries the locally verified canonical digest\n127|// so a persisted plan is tamper-evident. Caller-supplied digest\n128|// equality alone is never evidence of authority; only Revalidate\n129|// against current facts decides currency.\n130|type SelectionPlan struct {\n131|\t// SelectorVersion is exactly SelectorVersion.\n132|\tSelectorVersion string\n133|\t// Selector is the original single argument, at most\n134|\t// MaxSelectorRunes characters.\n135|\tSelector string\n136|\t// SessionID is the selected UUIDv7, never resolved again by name.\n137|\tSessionID string\n138|\t// SessionRecordID is the validated immutable Session Record digest.\n139|\tSessionRecordID string\n140|\t// SourceHostID is the UUIDv7 of the selected source, always bound:\n141|\t// a local selection without a known local host refuses\n142|\t// invalid_config at build time instead of binding empty.\n143|\tSourceHostID string\n144|\t// SourceAlias is the exact configured alias, or nil for local. It\n145|\t// is a diagnostic label, never identity.\n146|\tSourceAlias *string\n147|\t// SourceIndexDigest is the digest of the complete validated index\n148|\t// read used for selection.\n149|\tSourceIndexDigest string\n150|\t// ConfigurationDigest is the digest of the effective validated\n151|\t// configuration, including peer mapping, allowlist, and transport.\n152|\tConfigurationDigest string\n153|\t// LeaseRecordID is the canonical digest of the validated winning\n154|\t// Lease Record for the selected session, admitted through the\n155|\t// canonicaljson owner from Reader.LeaseRecords.\n156|\tLeaseRecordID string\n157|\t// LeaseEpoch, LeaseID, and OwnerHostID come from that same winning\n158|\t// Lease Record: positive uint53, UUIDv4, and UUIDv7 holder. A plan\n159|\t// with no admitted winning record is never built; the builder\n160|\t// refuses selector_observation_unavailable, and a complete read\n161|\t// proving a record without any valid lease refuses\n162|\t// selector_bootstrap_incomplete.\n163|\tLeaseEpoch  uint64\n164|\tLeaseID     string\n165|\tOwnerHostID string\n166|\t// AuthorityHeads is the sorted unique digest array of the validated\n167|\t// lease, event, and tombstone heads used for the decision: the\n168|\t// winning Lease Record digest plus the tail event digest of every\n169|\t// allowed source holding a non-parked copy of the pinned session.\n170|\tAuthorityHeads []string\n171|\t// Action is the explicit command/action tag bound at build time.\n172|\tAction string\n173|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n174|\t// when the action takes no destination.\n175|\tDestinationHostID *string\n176|\t// ExpectationDigest binds the caller-declared action expectations\n177|\t// (canonically encoded JSON) for change detection. It does not\n178|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n179|\t// or confirmation contracts, which have no owners in this leaf.\n180|\tExpectationDigest string\n181|}\n182|\n183|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n184|// selector, the explicit action tag, the explicit destination (empty\n185|// for none), and the opaque caller expectations (nil for none).\n186|type PlanArgs struct {\n187|\tSelector     string\n188|\tAction       string\n189|\tDestination  string\n190|\tExpectations []byte\n191|}\n192|\n193|// BuildPlan resolves the selector once through the shared path and\n194|// binds the current facts into an immutable plan. The destination is\n195|// independently validated as a UUIDv7; expectations must be canonically\n196|// encodable JSON and bind by digest for change detection only.\n197|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n198|\tparsed, err := ParseSelector(args.Selector)\n199|\tif err != nil {\n200|\t\treturn SelectionPlan{}, err\n201|\t}\n202|\tif reader == nil || reader.Local == nil {\n203|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n204|\t}\n205|\tconfig, err := reader.validatedConfiguration()\n206|\tif err != nil {\n207|\t\treturn SelectionPlan{}, err\n208|\t}\n209|\tif _, ok := BoundariesFor(args.Action); !ok {\n210|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n211|\t}\n212|\tvar destination *string\n213|\tif args.Destination != \"\" {\n214|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n215|\t\tif err != nil {\n216|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n217|\t\t}\n218|\t\tvalue := id.String()\n219|\t\tdestination = &value\n220|\t}\n221|\texpectations, err := fingerprintExpectations(args.Expectations)\n222|\tif err != nil {\n223|\t\treturn SelectionPlan{}, err\n224|\t}\n225|\tvar selected Selection\n226|\tif parsed.Source != SourceBare {\n227|\t\tselected, err = reader.resolveExplicit(parsed, config)\n228|\t} else {\n229|\t\tselected, err = reader.resolveBare(parsed, config)\n230|\t}\n231|\tif err != nil {\n232|\t\treturn SelectionPlan{}, err\n233|\t}\n234|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n235|}\n236|\n237|// bindPlan reads the winning source completely and binds every plan\n238|// member from validated current facts. The session is located by its\n239|// UUID in the winning source only, never re-resolved by name. Lease\n240|// authority comes from the admitted winning Lease Record for that\n241|// UUID; the envelope winner on the selected chain must agree with it,\n242|// and the union winner across all allowed sources must not exceed it.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tlease, err := reader.winningLeaseFor(selected.SessionID)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\tif projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {\n279|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n280|\t}\n281|\tif projection.OwnerHostID != lease.HolderHostID {\n282|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: session %s carries disagreeing owner facts across lease and chain\", sessstate.ErrIntegrity, selected.SessionID)\n283|\t}\n284|\tplan := SelectionPlan{\n285|\t\tSelectorVersion:     SelectorVersion,\n286|\t\tSelector:            parsed.Raw,\n287|\t\tSessionID:           selected.SessionID,\n288|\t\tSessionRecordID:     recordID,\n289|\t\tSourceIndexDigest:   index,\n290|\t\tConfigurationDigest: configuration,\n291|\t\tLeaseRecordID:       lease.Digest,\n292|\t\tLeaseEpoch:          lease.Epoch,\n293|\t\tLeaseID:             lease.LeaseID,\n294|\t\tOwnerHostID:         lease.HolderHostID,\n295|\t\tAction:              action,\n296|\t\tDestinationHostID:   destination,\n297|\t\tExpectationDigest:   expectations,\n298|\t}\n299|\tif selected.PeerHostID == \"\" {\n300|\t\tif config.localHost == \"\" {\n301|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n302|\t\t}\n303|\t\tplan.SourceHostID = config.localHost\n304|\t} else {\n305|\t\tplan.SourceHostID = selected.PeerHostID\n306|\t\t// Null marks the local source only. An alias-less peer binds\n307|\t\t// empty: the host still distinguishes it from local.\n308|\t\talias := config.aliasFor(selected.PeerHostID)\n309|\t\taliasCopy := alias\n310|\t\tplan.SourceAlias = &aliasCopy\n311|\t}\n312|\t// The union check consults record, tombstone, and winner facts\n313|\t// only, never heads; heads are bound after the union validates.\n314|\tplan.AuthorityHeads = []string{}\n315|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\theads, err := reader.collectAuthorityHeads(config, selected.SessionID, lease.Digest, selected.PeerHostID)\n319|\tif err != nil {\n320|\t\treturn SelectionPlan{}, err\n321|\t}\n322|\tplan.AuthorityHeads = heads\n323|\tif err := checkPlanShapes(plan); err != nil {\n324|\t\treturn SelectionPlan{}, err\n325|\t}\n326|\treturn plan, nil\n327|}\n328|\n329|// chainTail returns the tail event digest of a validated session chain,\n330|// or empty when the chain carries no events yet.\n331|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n332|\tevents, err := repo.ListEvents(sessionID)\n333|\tif err != nil {\n334|\t\treturn \"\", err\n335|\t}\n336|\tif len(events) == 0 {\n337|\t\treturn \"\", nil\n338|\t}\n339|\treturn events[len(events)-1].EventID, nil\n340|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
