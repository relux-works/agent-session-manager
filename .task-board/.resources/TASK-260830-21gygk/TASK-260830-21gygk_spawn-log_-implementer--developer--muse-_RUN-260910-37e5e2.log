7890ab\",\n28|  \"provider_id\": \"codex\",\n29|  \"workspace_group_id\": \"0198f4c8-5b20-7c33-8c4d-1234567890ab\",\n30|  \"execution_profile\": \"yolo\",\n31|  \"launch_plan\": {\n32|    \"argv\": [\"codex\"],\n33|    \"cwd_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n34|    \"cwd_relative\": \"src\",\n35|    \"env_names\": [\"OPENAI_API_KEY\"],\n36|    \"env_literals\": {},\n37|    \"contains_secrets\": false,\n38|    \"extensions\": {}\n39|  },\n40|  \"task_board\": null,\n41|  \"fork_provenance\": null,\n42|  \"extensions\": {}\n43|}`\n44|\n45|func identity(t *testing.T, value map[string]any, field string) []byte {\n46|\tt.Helper()\n47|\tvalue[field] = zeroDigest\n48|\traw, err := json.Marshal(value)\n49|\tif err != nil {\n50|\t\tt.Fatal(err)\n51|\t}\n52|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(raw)\n53|\tif err != nil {\n54|\t\tt.Fatal(err)\n55|\t}\n56|\tvalue[field] = digest.String()\n57|\traw, err = json.Marshal(value)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\treturn raw\n62|}\n63|func record(t *testing.T, id, name string) []byte {\n64|\tt.Helper()\n65|\tvar value map[string]any\n66|\tif err := json.Unmarshal([]byte(specRecordExample), &value); err != nil {\n67|\t\tt.Fatal(err)\n68|\t}\n69|\tvalue[\"session_id\"], value[\"subject_id\"], value[\"name\"] = id, id, name\n70|\treturn identity(t, value, \"record_id\")\n71|}\n72|func repository(t *testing.T) (*sessrepo.Repository, string) {\n73|\tt.Helper()\n74|\troot := t.TempDir()\n75|\trepo, err := sessrepo.Open(root)\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\treturn repo, root\n80|}\n81|func create(t *testing.T, repo *sessrepo.Repository, id, name string) sessrepo.SessionRef {\n82|\tt.Helper()\n83|\tref, err := repo.CreateSession(record(t, id, name))\n84|\tif err != nil {\n85|\t\tt.Fatal(err)\n86|\t}\n87|\treturn ref\n88|}\n89|func appendEvent(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, payload map[string]any) string {\n90|\tt.Helper()\n91|\tvalue := map[string]any{\n92|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n93|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n94|\t\t\"lease_epoch\": 1, \"lease_id\": lease, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n95|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n96|\t}\n97|\tref, err := repo.AppendEvent(id, identity(t, value, \"event_id\"))\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\treturn ref.EventID\n102|}\n103|\n104|// leaseRecordBytes builds one validated Lease Record for tests: an\n105|// epoch-1 create lease uses a null predecessor and null checkpoint,\n106|// while a successor names its predecessor and a checkpoint. The holder\n107|// is the winning owner; issued_by and created_by equal the holder.\n108|func leaseRecordBytes(t *testing.T, sessionID string, epoch uint64, leaseID, holder, predecessor string, hasPredecessor bool) []byte {\n109|\tt.Helper()\n110|\tvar predecessorValue any\n111|\tif hasPredecessor {\n112|\t\tpredecessorValue = predecessor\n113|\t}\n114|\tvar checkpointValue any\n115|\tvar reason string\n116|\tif epoch == 1 && !hasPredecessor {\n117|\t\treason = \"create\"\n118|\t} else {\n119|\t\treason = \"graceful_takeover\"\n120|\t\tcheckpointValue = zeroDigest\n121|\t}\n122|\tvalue := map[string]any{\n123|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n124|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"lease_id\": leaseID, \"epoch\": json.Number(uint64String(epoch)),\n125|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": predecessorValue, \"reason\": reason,\n126|\t\t\"checkpoint_id\": checkpointValue, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n127|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n128|\t}\n129|\treturn identity(t, value, \"record_id\")\n130|}\n131|\n132|func uint64String(value uint64) string {\n133|\treturn json.Number(fmtSprintUint64(value)).String()\n134|}\n135|\n136|func fmtSprintUint64(value uint64) string {\n137|\tif value == 0 {\n138|\t\treturn \"0\"\n139|\t}\n140|\tvar digits []byte\n141|\tfor value > 0 {\n142|\t\tdigits = append([]byte{byte('0' + value%10)}, digits...)\n143|\t\tvalue /= 10\n144|\t}\n145|\treturn string(digits)\n146|}\n147|\n148|// leaseCreate returns an epoch-1 create Lease Record for the standard\n149|// test lease and holder.\n150|func leaseCreate(t *testing.T, sessionID, holder string) []byte {\n151|\tt.Helper()\n152|\treturn leaseRecordBytes(t, sessionID, 1, lease, holder, \"\", false)\n153|}\n154|\n155|// withLeases attaches validated Lease Records to a reader.\n156|func withLeases(reader *Reader, leases ...[]byte) *Reader {\n157|\treader.LeaseRecords = append(append([][]byte(nil), reader.LeaseRecords...), leases...)\n158|\treturn reader\n159|}","final_result":true}}}
