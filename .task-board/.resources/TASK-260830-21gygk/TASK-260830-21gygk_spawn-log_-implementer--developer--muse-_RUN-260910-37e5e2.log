{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc5f","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1162,"recorded_at":1780531400002319,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d8-1b89-7d82-82a9-e50c3309653f"},"task_id":"01a088d8-1b89-7d82-82a9-e50c3309653f","event":{"kind":"output","task_id":"01a088d8-1b89-7d82-82a9-e50c3309653f","chunk":"Read text file `internal/sessquery/plan_test.go`.\n(219 line(s) above)\n220|\treader := &Reader{Local: local, LocalHostID: hostA}\n221|\t// A complete read proving a record without any valid lease is an\n222|\t// interrupted persistence prefix for the bootstrap-recovery leaf:\n223|\t// no plan binds an empty lease triple or placeholder, and there is\n224|\t// nothing current to revalidate.\n225|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n226|\t\tt.Fatalf(\"record-only build = %v, want selector_bootstrap_incomplete\", err)\n227|\t}\n228|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"id:\" + idA, Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n229|\t\tt.Fatalf(\"record-only id build = %v, want selector_bootstrap_incomplete\", err)\n230|\t}\n231|}\n232|\n233|func TestBuildPlanLocalSourceRequiresKnownHost(t *testing.T) {\n234|\treader, _, _, _ := plannedSession(t)\n235|\treader.LocalHostID = \"\"\n236|\t// The local source cannot be named without the local host\n237|\t// identity: the plan binds a UUIDv7 source host or refuses.\n238|\t// Peer selections still bind their own known host.\n239|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrInvalidConfig) {\n240|\t\tt.Fatalf(\"unknown-host local build = %v, want invalid_config\", err)\n241|\t}\n242|\tpeer, _ := repository(t)\n243|\tref := create(t, peer, idB, \"beta\")\n244|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n245|\twithLeases(reader, leaseCreate(t, idB, hostA))\n246|\treader.AllowlistedPeerIDs = []string{hostA}\n247|\treader.Peers = []PeerIndex{{hostA, peer}}\n248|\treader.Aliases = map[string]string{hostA: \"workstation\"}\n249|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus})\n250|\tif plan.SourceHostID != hostA {\n251|\t\tt.Fatalf(\"peer source without local host: %+v\", plan)\n252|\t}\n253|\tif err := reader.Revalidate(plan); err != nil {\n254|\t\tt.Fatalf(\"peer plan without local host is not current: %v\", err)\n255|\t}\n256|}\n257|\n258|func TestBuildPlanArgumentGates(t *testing.T) {\n259|\treader, _, _, _ := plannedSession(t)\n260|\tfor _, args := range []PlanArgs{\n261|\t\t{Selector: \"alpha\", Action: \"launch\"},\n262|\t\t{Selector: \"alpha\", Action: \"\"},\n263|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: \"not-a-uuid\"},\n264|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: lease},\n265|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`{bad`)},\n266|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`[1]`)},\n267|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`\"str\"`)},\n268|\t\t{Selector: \"alpha@unknown\", Action: ActionStatus},\n269|\t\t{Selector: \"\", Action: ActionStatus},\n270|\t} {\n271|\t\tif _, err := reader.BuildPlan(args); !errors.Is(err, ErrInvalidArgument) {\n272|\t\t\tt.Fatalf(\"BuildPlan(%+v) = %v, want invalid_arguments\", args, err)\n273|\t\t}\n274|\t}\n275|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\"}); !errors.Is(err, ErrInvalidArgument) {\n276|\t\tt.Fatalf(\"missing action: %v\", err)\n277|\t}\n278|}\n279|\n280|func TestPlanDigestAndMarshalRoundTrip(t *testing.T) {\n281|\treader, _, _, _ := plannedSession(t)\n282|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionDiff})\n283|\tfirst, err := plan.Digest()\n284|\tif err != nil {\n285|\t\tt.Fatal(err)\n286|\t}\n287|\tsecond, err := plan.Digest()\n288|\tif err != nil || first != second {\n289|\t\tt.Fatalf(\"digest unstable: %q %q %v\", first, second, err)\n290|\t}\n291|\traw, err := plan.Marshal()\n292|\tif err != nil {\n293|\t\tt.Fatal(err)\n294|\t}\n295|\tparsed, err := ParsePlan(raw)\n296|\tif err != nil {\n297|\t\tt.Fatal(err)\n298|\t}\n299|\tif !reflect.DeepEqual(plan, parsed) {\n300|\t\tt.Fatalf(\"round trip diverged:\\n%+v\\n%+v\", plan, parsed)\n301|\t}\n302|\t// Tampering with any member breaks the locally verified digest.\n303|\tvar wire map[string]any\n304|\tif err := json.Unmarshal(raw, &wire); err != nil {\n305|\t\tt.Fatal(err)\n306|\t}\n307|\twire[\"action\"] = ActionAttach\n308|\ttampered, err := json.Marshal(wire)\n309|\tif err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\tif _, err := ParsePlan(tampered); !errors.Is(err, ErrInvalidArgument) {\n313|\t\tt.Fatalf(\"tampered plan parsed: %v\", err)\n314|\t}\n315|\tif _, err := ParsePlan([]byte(`{broken`)); !errors.Is(err, ErrInvalidArgument) {\n316|\t\tt.Fatalf(\"malformed encoding: %v\", err)\n317|\t}\n318|\t// A valid persisted encoding is never authority by itself: current\n319|\t// facts still decide through Revalidate.\n320|\traw, err = plan.Marshal()\n321|\tif err != nil {\n322|\t\tt.Fatal(err)\n323|\t}\n324|\tparsed, err = ParsePlan(raw)\n325|\tif err != nil {\n326|\t\tt.Fatal(err)\n327|\t}\n328|\ttailForRoundTrip, err := chainTail(reader.Local, idA)\n329|\tif err != nil {\n330|\t\tt.Fatal(err)\n331|\t}\n332|\tappendEvent(t, reader.Local, idA, tailForRoundTrip, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n333|\tif err := reader.Revalidate(parsed); !errors.Is(err, ErrPlanStale) {\n334|\t\tt.Fatalf(\"persisted digest overrode current facts: %v\", err)\n335|\t}\n336|}\n337|\n338|func TestRevalidateDetectsEachFactChange(t *testing.T) {\n339|\tt.Run(\"same lease event changes heads\", func(t *testing.T) {\n340|\t\treader, _, _, _ := plannedSession(t)\n341|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n342|\t\ttail, err := chainTail(reader.Local, idA)\n343|\t\tif err != nil {\n344|\t\t\tt.Fatal(err)\n345|\t\t}\n346|\t\tappendEvent(t, reader.Local, idA, tail, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n347|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n348|\t})\n349|\tt.Run(\"successor lease changes winner\", func(t *testing.T) {\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc61","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1163,"recorded_at":1780531400002321,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d8-1b89-7d82-82a9-e50c3309653f"},"task_id":"01a088d8-1b89-7d82-82a9-e50c3309653f","event":{"kind":"completed","task_id":"01a088d8-1b89-7d82-82a9-e50c3309653f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc63","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1164,"recorded_at":1780531400002323,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d8-1bae-77a0-9bc1-41d4dbe342f5"},"task_id":"01a088d8-1bae-77a0-9bc1-41d4dbe342f5","event":{"kind":"output","task_id":"01a088d8-1bae-77a0-9bc1-41d4dbe342f5","chunk":"Read text file `internal/sessquery/union_test.go`.\n1|// Complete-authority union tests for TASK-260830-21gygk: revalidation\n2|// and construction validate the pinned session UUID across the local\n3|// and every allowlisted source without re-resolving names or\n4|// substituting selections.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// leasedPeerSession creates a leased session on a peer repository for\n18|// union fixtures.\n19|func leasedPeerSession(t *testing.T, peer *sessrepo.Repository, id, name string) sessrepo.SessionRef {\n20|\tt.Helper()\n21|\tref := create(t, peer, id, name)\n22|\tappendEvent(t, peer, id, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n23|\treturn ref\n24|}\n25|\n26|// unionReader builds a local/peer reader whose peer holds a leased\n27|// session and whose local side starts empty. The reader carries the\n28|// winning Lease Record for the peer session.\n29|func unionReader(t *testing.T, local, peer *sessrepo.Repository) *Reader {\n30|\tt.Helper()\n31|\treader := &Reader{\n32|\t\tLocal:              local,\n33|\t\tLocalHostID:        hostB,\n34|\t\tAllowlistedPeerIDs: []string{hostA},\n35|\t\tPeers:              []PeerIndex{{hostA, peer}},\n36|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n37|\t}\n38|\twithLeases(reader, leaseCreate(t, idB, hostA))\n39|\treturn reader\n40|}\n41|\n42|func TestRevalidateUnionLeaseDivergenceRefusesStale(t *testing.T) {\n43|\tlocal, _ := repository(t)\n44|\tpeer, _ := repository(t)\n45|\tleasedPeerSession(t, peer, idB, \"beta\")\n46|\treader := unionReader(t, local, peer)\n47|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n48|\tif err := reader.Revalidate(plan); err != nil {\n49|\t\tt.Fatal(err)\n50|\t}\n51|\t// The local source learns the same immutable record, then observes\n52|\t// a successor winning lease the plan source has not seen.\n53|\tref := create(t, local, idB, \"beta\")\n54|\tif ref.RecordID != plan.SessionRecordID {\n55|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", ref.RecordID, plan.SessionRecordID)\n56|\t}\n57|\tcreated := appendEvent(t, local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n58|\tlaunched := appendEvent(t, local, idB, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n59|\tappendEventAs(t, local, idB, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n60|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n61|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n62|\t})\n63|\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n64|}\n65|\n66|func TestRevalidateUnionTombstoneRefusesStale(t *testing.T) {\n67|\tlocal, _ := repository(t)\n68|\tpeer, _ := repository(t)\n69|\tleasedPeerSession(t, peer, idB, \"beta\")\n70|\treader := unionReader(t, local, peer)\n71|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n72|\tref := create(t, local, idB, \"beta\")\n73|\tif ref.RecordID != plan.SessionRecordID {\n74|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", ref.RecordID, plan.SessionRecordID)\n75|\t}\n76|\tevent := appendEvent(t, local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n77|\tevent = appendEvent(t, local, idB, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n78|\tappendEvent(t, local, idB, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n79|\tmustStale(t, reader.Revalidate(plan), \"tombstone evidence changed\")\n80|}\n81|\n82|func TestRevalidateUnionAgreeingReplicaStaysCurrent(t *testing.T) {\n83|\tlocal, _ := repository(t)\n84|\tpeer, _ := repository(t)\n85|\tref := leasedPeerSession(t, peer, idB, \"beta\")\n86|\treader := unionReader(t, local, peer)\n87|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n88|\t// A lagging source replicating the same record and the identical\n89|\t// bootstrap event observes agreeing authority: no refusal.\n90|\tlocalRef := create(t, local, idB, \"beta\")\n91|\tif localRef.RecordID != ref.RecordID {\n92|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", localRef.RecordID, ref.RecordID)\n93|\t}\n94|\tappendEvent(t, local, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n95|\tif err := reader.Revalidate(plan); err != nil {\n96|\t\tt.Fatalf(\"agreeing replica invalidated plan: %v\", err)\n97|\t}\n98|}\n99|\n100|func TestRevalidateUnionParkedCopyIgnored(t *testing.T) {\n101|\tlocal, _ := repository(t)\n102|\tpeer, _ := repository(t)\n103|\tleasedPeerSession(t, peer, idB, \"beta\")\n104|\treader := unionReader(t, local, peer)\n105|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n106|\t// A parked copy is a failed observation, never tombstone or\n107|\t// record evidence: it cannot contradict the plan.\n108|\tlocal.AfterCreateStep = func(step sessrepo.CreateStep) error {\n109|\t\tif step == sessrepo.CreateStepRecord {\n110|\t\t\treturn errors.New(\"crash\")\n111|\t\t}\n112|\t\treturn nil\n113|\t}\n114|\tif _, err := local.CreateSession(record(t, idB, \"different-record\")); err == nil {\n115|\t\tt.Fatal(\"fault did not fire\")\n116|\t}\n117|\tlocal.AfterCreateStep = nil\n118|\tif err := reader.Revalidate(plan); err != nil {\n119|\t\tt.Fatalf(\"parked copy invalidated plan: %v\", err)\n120|\t}\n121|}\n122|\n123|func TestRevalidateUnionUnreadablePeerRefuses(t *testing.T) {\n124|\treader, _, _, _ := plannedSession(t)\n125|\tpeer, peerRoot := repository(t)\n126|\treader.AllowlistedPeerIDs = []string{hostC}\n127|\treader.Peers = []PeerIndex{{hostC, peer}}\n128|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n129|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n130|\t\tt.Fatal(err)\n131|\t}\n132|\t// The complete authority union cannot be validated without the\n133|\t// allowlisted peer read: the failure keeps its class.\n134|\terr := reader.Revalidate(plan)\n135|\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n136|\t\tt.Fatalf(\"unreadable union peer = %v\", err)\n137|\t}\n138|}\n139|\n140|func TestBuildPlanValidatesUnionAtBuild(t *testing.T) {\n141|\tlocal, _ := repository(t)\n142|\tpeer, _ := repository(t)\n143|\tleasedPeerSession(t, peer, idB, \"beta\")\n144|\tcreate(t, local, idB, \"different-record\")\n145|\treader := unionReader(t, local, peer)\n146|\t// The explicit peer selection never falls back, and the build\n147|\t// still validates the pinned UUID union: the contradictory local\n148|\t// record is integrity failure at construction.\n149|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n150|\t\tt.Fatalf(\"explicit build over divergent union = %v\", err)\n151|\t}\n152|\t// The mirror direction behaves the same: a leased local selection\n153|\t// against a divergent peer copy refuses without substituting it.\n154|\tlocalOnly, _ := repository(t)\n155|\tlocalRef := create(t, localOnly, idB, \"beta\")\n156|\tappendEvent(t, localOnly, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n157|\tdivergent, _ := repository(t)\n158|\tcreate(t, divergent, idB, \"different-record\")\n159|\tmirror := &Reader{\n160|\t\tLocal:              localOnly,\n161|\t\tLocalHostID:        hostB,\n162|\t\tAllowlistedPeerIDs: []string{hostA},\n163|\t\tPeers:              []PeerIndex{{hostA, divergent}},\n164|\t}\n165|\twithLeases(mirror, leaseCreate(t, idB, hostA))\n166|\tif _, err := mirror.BuildPlan(PlanArgs{Selector: \"beta@local\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n167|\t\tt.Fatalf(\"local build over divergent union = %v\", err)\n168|\t}\n169|}\n170|\n171|func TestRevalidateUnionNameDriftStaysCurrent(t *testing.T) {\n172|\tlocal, _ := repository(t)\n173|\tpeer, _ := repository(t)\n174|\tleasedPeerSession(t, peer, idB, \"beta\")\n175|\treader := unionReader(t, local, peer)\n176|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta\", Action: ActionStatus})\n177|\tif plan.SourceHostID != hostA {\n178|\t\tt.Fatalf(\"source: %+v\", plan)\n179|\t}\n180|\t// A different UUID gaining the same live name locally moves fresh\n181|\t// name resolution but never retargets the pinned plan: names are\n182|\t// not re-resolved and the drift alone is not a defect.\n183|\tdrift := create(t, local, idC, \"beta\")\n184|\tappendEvent(t, local, idC, drift.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": drift.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n185|\tif err := reader.Revalidate(plan); err != nil {\n186|\t\tt.Fatalf(\"same-name gain invalidated pinned plan: %v\", err)\n187|\t}\n188|}\n189|\n190|// TestBuildWithLaggingLeaseCopy proves the union winner is the\n191|// greatest (epoch, lease_id) tuple, not copy equality: a lagging\n192|// epoch-1 replica beside an epoch-2 local is valid and a fresh build\n193|// on the local winner succeeds, retaining the losing history.\n194|func TestBuildWithLaggingLeaseCopy(t *testing.T) {\n195|\tlocal, _ := repository(t)\n196|\tpeer, _ := repository(t)\n197|\t// Peer holds the epoch-1 replica with the same immutable record.\n198|\tpeerRef := create(t, peer, idB, \"beta\")\n199|\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n200|\t// Local holds the same record at epoch 2 with a successor lease.\n201|\tlocalRef := create(t, local, idB, \"beta\")\n202|\tif localRef.RecordID != peerRef.RecordID {\n203|\t\t// Records with the same name and session ID share the digest;\n204|\t\t// a divergence here is a fixture error, not a union case.\n205|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", localRef.RecordID, peerRef.RecordID)\n206|\t}\n207|\tcreated := appendEvent(t, local, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n208|\tlaunched := appendEvent(t, local, idB, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n209|\tappendEventAs(t, local, idB, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n210|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n211|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n212|\t})\n213|\treader := &Reader{\n214|\t\tLocal:              local,\n215|\t\tLocalHostID:        hostB,\n216|\t\tAllowlistedPeerIDs: []string{hostA},\n217|\t\tPeers:              []PeerIndex{{hostA, peer}},\n218|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n219|\t}\n220|\twithLeases(reader,\n221|\t\tleaseCreate(t, idB, hostA),\n222|\t\tleaseRecordBytes(t, idB, 2, leaseB, hostA, lease, true),\n223|\t)\n224|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@local\", Action: ActionStatus})\n225|\tif plan.LeaseEpoch != 2 || plan.LeaseID != leaseB {\n226|\t\tt.Fatalf(\"lagging union winner: %+v\", plan)\n227|\t}\n228|\tif err := reader.Revalidate(plan); err != nil {\n229|\t\tt.Fatalf(\"lagging replica invalidated winner plan: %v\", err)\n230|\t}\n231|\t// The union still refuses a greater lease appearing elsewhere: a\n232|\t// same-epoch successor on the peer with a greater lease ID is stale.\n233|\tpeerCreated, err := chainTail(peer, idB)\n234|\tif err != nil {\n235|\t\tt.Fatal(err)\n236|\t}\n237|\tpeerLaunched := appendEvent(t, peer, idB, peerCreated, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n238|\tleaseC := \"cccccccc-dddd-4eee-8fff-111111111111\"\n239|\tappendEventAs(t, peer, idB, peerLaunched, \"lease.transferred\", 1, 2, leaseC, map[string]any{\n240|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n241|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseC,\n242|\t})\n243|\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n244|}","final_result":true}}}
