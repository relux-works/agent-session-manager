{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc93","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1188,"recorded_at":1780531400002371,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"call_id":"call_01a088d82f5077118bc6000c124f8504","text":"Read text file `internal/sessquery/plan_test.go`.\n(337 line(s) above)\n338|func TestRevalidateDetectsEachFactChange(t *testing.T) {\n339|\tt.Run(\"same lease event changes heads\", func(t *testing.T) {\n340|\t\treader, _, _, _ := plannedSession(t)\n341|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n342|\t\ttail, err := chainTail(reader.Local, idA)\n343|\t\tif err != nil {\n344|\t\t\tt.Fatal(err)\n345|\t\t}\n346|\t\tappendEvent(t, reader.Local, idA, tail, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n347|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n348|\t})\n349|\tt.Run(\"successor lease changes winner\", func(t *testing.T) {\n350|\t\treader, _, _, created := plannedSession(t)\n351|\t\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n352|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n353|\t\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n354|\t\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n355|\t\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n356|\t\t})\n357|\t\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n358|\t})\n359|\tt.Run(\"record replacement changes digest\", func(t *testing.T) {\n360|\t\treader, root, _, _ := plannedSession(t)\n361|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n362|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), record(t, idA, \"renamed\"), 0o600); err != nil {\n363|\t\t\tt.Fatal(err)\n364|\t\t}\n365|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n366|\t})\n367|\tt.Run(\"changed nonempty record refuses\", func(t *testing.T) {\n368|\t\treader, root, _, _ := plannedSession(t)\n369|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n370|\t\t// Rewrite both the record and its chain index so the session\n371|\t\t// stays live with a different nonempty digest: a narrowing\n372|\t\t// that admits one changed nonempty digest must still fail.\n373|\t\trenamed := record(t, idA, \"renamed-live\")\n374|\t\tvar renamedMembers map[string]json.RawMessage\n375|\t\tif err := json.Unmarshal(renamed, &renamedMembers); err != nil {\n376|\t\t\tt.Fatal(err)\n377|\t\t}\n378|\t\tvar renamedID string\n379|\t\tif err := json.Unmarshal(renamedMembers[\"record_id\"], &renamedID); err != nil {\n380|\t\t\tt.Fatal(err)\n381|\t\t}\n382|\t\tif renamedID == plan.SessionRecordID || renamedID == zeroDigest {\n383|\t\t\tt.Fatalf(\"renamed fixture did not change the digest: %q\", renamedID)\n384|\t\t}\n385|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), renamed, 0o600); err != nil {\n386|\t\t\tt.Fatal(err)\n387|\t\t}\n388|\t\tchainPath := filepath.Join(root, \"sessions\", idA, \"chain.json\")\n389|\t\tchainBytes, err := os.ReadFile(chainPath)\n390|\t\tif err != nil {\n391|\t\t\tt.Fatal(err)\n392|\t\t}\n393|\t\tvar chain map[string]any\n394|\t\tif err := json.Unmarshal(chainBytes, &chain); err != nil {\n395|\t\t\tt.Fatal(err)\n396|\t\t}\n397|\t\tchain[\"record_id\"] = renamedID\n398|\t\trewritten, err := json.Marshal(chain)\n399|\t\tif err != nil {\n400|\t\t\tt.Fatal(err)\n401|\t\t}\n402|\t\tif err := os.WriteFile(chainPath, rewritten, 0o600); err != nil {\n403|\t\t\tt.Fatal(err)\n404|\t\t}\n405|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n406|\t})\n407|\tt.Run(\"alias remap changes binding\", func(t *testing.T) {\n408|\t\tlocal, _ := repository(t)\n409|\t\trepoA, rootA := repository(t)\n410|\t\trepoB, rootB := repository(t)\n411|\t\tref := create(t, repoA, idA, \"shared\")\n412|\t\tappendEvent(t, repoA, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n413|\t\tcopySessionDir(t, rootA, rootB, idA)\n414|\t\treader := &Reader{\n415|\t\t\tLocal:              local,\n416|\t\t\tAllowlistedPeerIDs: []string{hostA, hostB},\n417|\t\t\tPeers:              []PeerIndex{{hostA, repoA}, {hostB, repoB}},\n418|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n419|\t\t}\n420|\t\twithLeases(reader, leaseCreate(t, idA, hostA))\n421|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"shared@peer:ws\", Action: ActionStatus})\n422|\t\tif plan.SourceHostID != hostA {\n423|\t\t\tt.Fatalf(\"source: %+v\", plan)\n424|\t\t}\n425|\t\treader.Aliases = map[string]string{hostB: \"ws\"}\n426|\t\tmustStale(t, reader.Revalidate(plan), \"source binding changed\")\n427|\t})\n428|\tt.Run(\"unrelated mapping change changes configuration\", func(t *testing.T) {\n429|\t\treader, _, _, _ := plannedSession(t)\n430|\t\tpeer, _ := repository(t)\n431|\t\treader.Peers = []PeerIndex{{hostC, peer}}\n432|\t\treader.AllowlistedPeerIDs = []string{hostC}\n433|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n434|\t\treader.Aliases = map[string]string{hostC: \"ws\"}\n435|\t\tmustStale(t, reader.Revalidate(plan), \"configuration changed\")\n436|\t})\n437|\tt.Run(\"revocation refuses allowlist\", func(t *testing.T) {\n438|\t\tlocal, _ := repository(t)\n439|\t\tpeer, _ := repository(t)\n440|\t\tlocalRef := create(t, local, idA, \"alpha\")\n441|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n442|\t\tpeerRef := create(t, peer, idB, \"beta\")\n443|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n444|\t\treader := &Reader{\n445|\t\t\tLocal:              local,\n446|\t\t\tAllowlistedPeerIDs: []string{hostA},\n447|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n448|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n449|\t\t}\n450|\t\twithLeases(reader, leaseCreate(t, idA, hostA), leaseCreate(t, idB, hostA))\n451|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n452|\t\treader.AllowlistedPeerIDs = nil\n453|\t\terr := reader.Revalidate(plan)\n454|\t\tif !errors.Is(err, ErrPeerNotAllowlisted) {\n455|\t\t\tt.Fatalf(\"revocation = %v, want peer_not_allowlisted\", err)\n456|\t\t}\n457|\t})\n458|\tt.Run(\"tombstone invalidates live plan\", func(t *testing.T) {\n459|\t\treader, _, ref, created := plannedSession(t)\n460|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n461|\t\tfailed := appendEvent(t, reader.Local, idA, created, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n462|\t\t_ = ref\n463|\t\tappendEvent(t, reader.Local, idA, failed, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n464|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n465|\t})\n466|\tt.Run(\"deletion empties selection\", func(t *testing.T) {\n467|\t\treader, root, _, _ := plannedSession(t)\n468|\t\t// A surviving sibling keeps the index readable, so only the\n469|\t\t// absence check can report the planned identity: substituting\n470|\t\t// the sibling must never validate.\n471|\t\tcreate(t, reader.Local, idB, \"bravo\")\n472|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n473|\t\tif err := os.RemoveAll(filepath.Join(root, \"sessions\", idA)); err != nil {\n474|\t\t\tt.Fatal(err)\n475|\t\t}\n476|\t\tmustStale(t, reader.Revalidate(plan), \"selection absent from source index\")\n477|\t})\n478|\tt.Run(\"unrelated session change changes index\", func(t *testing.T) {\n479|\t\treader, _, _, _ := plannedSession(t)\n480|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n481|\t\tref := create(t, reader.Local, idB, \"bravo\")\n482|\t\tappendEvent(t, reader.Local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n483|\t\tmustStale(t, reader.Revalidate(plan), \"source index changed\")\n484|\t})\n485|\tt.Run(\"invalid projection propagates\", func(t *testing.T) {\n486|\t\treader, _, ref, created := plannedSession(t)\n487|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n488|\t\t// A terminal close followed by a second bootstrap is\n489|\t\t// continuity-admitted by the repository and refused by the\n490|\t\t// state owner: the failure reaches revalidation unchanged,\n491|\t\t// never as absence or staleness.\n492|\t\tprevious := created\n493|\t\tfor index, row := range []struct {\n494|\t\t\ttyp     string\n495|\t\t\tpayload map[string]any\n496|\t\t}{\n497|\t\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n498|\t\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n499|\t\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n500|\t\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n501|\t\t\t{\"session.stopped\", map[string]any{\"graceful\": true, \"checkpoint_id\": zeroDigest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}},\n502|\t\t} {\n503|\t\t\tprevious = appendEvent(t, reader.Local, idA, previous, row.typ, index+2, row.payload)\n504|\t\t}\n505|\t\tappendEvent(t, reader.Local, idA, previous, \"session.created\", 7, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n506|\t\terr := reader.Revalidate(plan)\n507|\t\tif err == nil || errors.Is(err, ErrPlanStale) || errors.Is(err, ErrNotFound) {\n508|\t\t\tt.Fatalf(\"projection failure became %v\", err)\n509|\t\t}\n510|\t\tif !errors.Is(err, sessstate.ErrInvalidTransition) {\n511|\t\t\tt.Fatalf(\"projection failure = %v\", err)\n512|\t\t}\n513|\t})\n514|}\n515|\n516|func TestRevalidateReadFailures(t *testing.T) {\n517|\tt.Run(\"peer read failure keeps class\", func(t *testing.T) {\n518|\t\tlocal, _ := repository(t)\n519|\t\tpeer, peerRoot := repository(t)\n520|\t\tlocalRef := create(t, local, idA, \"alpha\")\n521|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n522|\t\tpeerRef := create(t, peer, idB, \"beta\")\n523|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n524|\t\treader := &Reader{\n525|\t\t\tLocal:              local,\n526|\t\t\tAllowlistedPeerIDs: []string{hostA},\n527|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n528|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n529|\t\t}\n530|\t\twithLeases(reader, leaseCreate(t, idA, hostA), leaseCreate(t, idB, hostA))\n531|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n532|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n533|\t\t\tt.Fatal(err)\n534|\t\t}\n535|\t\terr := reader.Revalidate(plan)\n536|\t\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n537|\t\t\tt.Fatalf(\"peer revalidation failure = %v\", err)\n538|\t\t}\n539|\t})\n540|\tt.Run(\"local read failure keeps repository error\", func(t *testing.T) {\n541|\t\treader, root, _, _ := plannedSession(t)\n542|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n543|\t\tif err := os.Rename(filepath.Join(root, \"sessions\"), filepath.Join(root, \"saved\")); err != nil {\n544|\t\t\tt.Fatal(err)\n545|\t\t}\n546|\t\terr := reader.Revalidate(plan)\n547|\t\tif !errors.Is(err, sessrepo.ErrRepositoryPath) {\n548|\t\t\tt.Fatalf(\"local revalidation failure = %v\", err)\n549|\t\t}\n550|\t\tif errors.Is(err, ErrSourceReadFailed) {\n551|\t\t\tt.Fatalf(\"local failure misclassified as remote: %v\", err)\n552|\t\t}\n553|\t})\n554|\tt.Run(\"never falls back to another source\", func(t *testing.T) {\n555|\t\tlocal, _ := repository(t)\n556|\t\tpeer, peerRoot := repository(t)\n557|\t\tlocalRef := create(t, local, idA, \"beta\")\n558|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n559|\t\tpeerRef := create(t, peer, idB, \"beta\")\n560|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n561|\t\treader := &Reader{\n562|\t\t\tLocal:              local,\n563|\t\t\tAllowlistedPeerIDs: []string{hostA},\n564|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n565|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n566|\t\t}\n567|\t\twithLeases(reader, leaseCreate(t, idA, hostA), leaseCreate(t, idB, hostA))\n568|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n569|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n570|\t\t\tt.Fatal(err)\n571|\t\t}\n572|\t\t// The local index holds a live \"beta\" under another UUID, but\n573|\t\t// revalidation rereads the plan source only: no substitution.\n574|\t\tif err := reader.Revalidate(plan); !errors.Is(err, ErrSourceReadFailed) {\n575|\t\t\tt.Fatalf(\"revalidation fell back: %v\", err)\n576|\t\t}\n577|\t})\n578|}\n579|\n580|func TestRevalidateMalformedPlans(t *testing.T) {\n581|\treader, _, _, _ := plannedSession(t)\n582|\tvalid := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n583|\tcases := []struct {\n584|\t\tname   string\n585|\t\tmutate func(plan *SelectionPlan)\n586|\t}{\n587|\t\t{\"version\", func(plan *SelectionPlan) { plan.SelectorVersion = \"2.0.0\" }},\n588|\t\t{\"selector\", func(plan *SelectionPlan) { plan.Selector = \"alpha@unknown\" }},\n589|\t\t{\"session\", func(plan *SelectionPlan) { plan.SessionID = \"nope\" }},\n590|\t\t{\"record\", func(plan *SelectionPlan) { plan.SessionRecordID = \"nope\" }},\n591|\t\t{\"source host\", func(plan *SelectionPlan) { plan.SourceHostID = \"nope\" }},\n592|\t\t{\"empty source host\", func(plan *SelectionPlan) { plan.SourceHostID = \"\" }},\n593|\t\t{\"lease record\", func(plan *SelectionPlan) { plan.LeaseRecordID = \"nope\" }},\n594|\t\t{\"empty lease record\", func(plan *SelectionPlan) { plan.LeaseRecordID = \"\" }},\n595|\t\t{\"empty lease triple\", func(plan *SelectionPlan) {\n596|\t\t\tplan.LeaseEpoch, plan.LeaseID, plan.OwnerHostID = 0, \"\", \"\"\n597|\t\t}},\n598|\t\t{\"alias control\", func(plan *SelectionPlan) {\n599|\t\t\tbad := \"a\\tb\"\n600|\t\t\tplan.SourceAlias = &bad\n601|\t\t}},\n602|\t\t{\"index digest\", func(plan *SelectionPlan) { plan.SourceIndexDigest = \"nope\" }},\n603|\t\t{\"configuration digest\", func(plan *SelectionPlan) { plan.ConfigurationDigest = \"nope\" }},\n604|\t\t{\"expectation digest\", func(plan *SelectionPlan) { plan.ExpectationDigest = \"nope\" }},\n605|\t\t{\"partial lease\", func(plan *SelectionPlan) { plan.LeaseID = \"\" }},\n606|\t\t{\"epoch zero with lease\", func(plan *SelectionPlan) { plan.LeaseEpoch = 0 }},\n607|\t\t{\"epoch overflow\", func(plan *SelectionPlan) { plan.LeaseEpoch = 1 << 53 }},\n608|\t\t{\"lease shape\", func(plan *SelectionPlan) { plan.LeaseID = \"nope\" }},\n609|\t\t{\"owner shape\", func(plan *SelectionPlan) { plan.OwnerHostID = \"nope\" }},\n610|\t\t{\"head shape\", func(plan *SelectionPlan) { plan.AuthorityHeads = []string{\"nope\"} }},\n611|\t\t{\"heads unsorted\", func(plan *SelectionPlan) {\n612|\t\t\tplan.AuthorityHeads = []string{\"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\", zeroDigest}\n613|\t\t}},\n614|\t\t{\"heads duplicated\", func(plan *SelectionPlan) {\n615|\t\t\tplan.AuthorityHeads = []string{zeroDigest, zeroDigest}\n616|\t\t}},\n617|\t\t{\"action\", func(plan *SelectionPlan) { plan.Action = \"launch\" }},\n618|\t\t{\"destination\", func(plan *SelectionPlan) {\n619|\t\t\tbad := \"nope\"\n620|\t\t\tplan.DestinationHostID = &bad\n621|\t\t}},\n622|\t}\n623|\tfor _, row := range cases {\n624|\t\tt.Run(row.name, func(t *testing.T) {\n625|\t\t\tplan := valid\n626|\t\t\trow.mutate(&plan)\n627|\t\t\tif err := reader.Revalidate(plan); !errors.Is(err, ErrInvalidArgument) {\n628|\t\t\t\tt.Fatalf(\"Revalidate = %v, want invalid_arguments\", err)\n629|\t\t\t}\n630|\t\t\tif _, err := plan.Digest(); err != nil {\n631|\t\t\t\tt.Fatalf(\"Digest = %v\", err)\n632|\t\t\t}\n633|\t\t})\n634|\t}\n635|\tif err := reader.Revalidate(SelectionPlan{}); !errors.Is(err, ErrInvalidArgument) {\n636|\t\tt.Fatalf(\"empty plan accepted\")\n637|\t}\n638|\tif err := (&Reader{}).Revalidate(valid); !errors.Is(err, ErrUnavailable) {\n639|\t\tt.Fatalf(\"reader without index accepted\")\n640|\t}\n641|}\n642|\n643|func TestActionBoundaryTable(t *testing.T) {\n644|\tmatrix := map[string][]string{\n645|\t\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n646|\t\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n647|\t\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n648|\t\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n649|\t\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n650|\t\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n651|\t\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n652|\t\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n653|\t\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n654|\t\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n655|\t\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n656|\t\tActionCancel:      {BoundaryProjection},\n657|\t}\n658|\tif len(planBoundaries) != len(matrix) {\n659|\t\tt.Fatalf(\"boundary table covers %d actions, want %d\", len(planBoundaries), len(matrix))\n660|\t}\n661|\tfor action, want := range matrix {\n662|\t\tgot, ok := BoundariesFor(action)\n663|\t\tif !ok || !reflect.DeepEqual(got, want) {\n664|\t\t\tt.Fatalf(\"BoundariesFor(%q) = %v, %v\", action, got, ok)\n665|\t\t}\n666|\t}\n667|\tfor _, action := range []string{\"\", \"launch\", \"STATUS\", \"attach --local\"} {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
