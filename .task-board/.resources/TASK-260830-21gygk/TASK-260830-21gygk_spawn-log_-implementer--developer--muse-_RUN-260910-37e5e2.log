ace := WorkspaceAbsent\n225|\t\t\treader.Observations = map[string]SessionObservations{idA: {\n226|\t\t\t\tNewestCheckpointCreatedAt: &badStamp,\n227|\t\t\t\tProcessPresent:            &present,\n228|\t\t\t\tCapabilities:              map[string]CapabilitySummary{},\n229|\t\t\t\tWorkspaceStatus:           &workspace,\n(more lines below)","final_result":true}}}
