{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb8d","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":1057,"recorded_at":1780531400002109,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d7-9dcc-71a2-bcf7-22729563b507"},"task_id":"01a088d7-9dcc-71a2-bcf7-22729563b507","event":{"kind":"output","task_id":"01a088d7-9dcc-71a2-bcf7-22729563b507","chunk":"Read text file `internal/sessquery/plan_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n16|)\n17|\n18|func sortStringsForTest(values []string) {\n19|\tsort.Strings(values)\n20|}\n21|\n22|// appendEventAs chains one event under an explicit envelope lease,\n23|// unlike the epoch-1-only fixtures helper.\n24|func appendEventAs(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, epoch uint64, leaseID string, payload map[string]any) string {\n25|\tt.Helper()\n26|\tvalue := map[string]any{\n27|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n28|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n29|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n30|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n31|\t}\n32|\traw := identity(t, value, \"event_id\")\n33|\tref, err := repo.AppendEvent(id, raw)\n34|\tif err != nil {\n35|\t\tt.Fatal(err)\n36|\t}\n37|\treturn ref.EventID\n38|}\n39|\n40|// copySessionDir replicates one persisted session directory byte for\n41|// byte, so two sources hold the same identity with agreeing digests.\n42|func copySessionDir(t *testing.T, srcRoot, dstRoot, sessionID string) {\n43|\tt.Helper()\n44|\tsrc := filepath.Join(srcRoot, \"sessions\", sessionID)\n45|\tdst := filepath.Join(dstRoot, \"sessions\", sessionID)\n46|\tentries, err := os.ReadDir(src)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tif err := os.MkdirAll(filepath.Join(dst, \"events\"), 0o700); err != nil {\n51|\t\tt.Fatal(err)\n52|\t}\n53|\tfor _, entry := range entries {\n54|\t\tif entry.IsDir() {\n55|\t\t\tblobs, err := os.ReadDir(filepath.Join(src, entry.Name()))\n56|\t\t\tif err != nil {\n57|\t\t\t\tt.Fatal(err)\n58|\t\t\t}\n59|\t\t\tfor _, blob := range blobs {\n60|\t\t\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name(), blob.Name()))\n61|\t\t\t\tif err != nil {\n62|\t\t\t\t\tt.Fatal(err)\n63|\t\t\t\t}\n64|\t\t\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name(), blob.Name()), bytes, 0o600); err != nil {\n65|\t\t\t\t\tt.Fatal(err)\n66|\t\t\t\t}\n67|\t\t\t}\n68|\t\t\tcontinue\n69|\t\t}\n70|\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name()))\n71|\t\tif err != nil {\n72|\t\t\tt.Fatal(err)\n73|\t\t}\n74|\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name()), bytes, 0o600); err != nil {\n75|\t\t\tt.Fatal(err)\n76|\t\t}\n77|\t}\n78|}\n79|\n80|// plannedSession builds a local session with its bootstrap event and\n81|// validated initial Lease Record, returning the reader, roots, record\n82|// digest, and created event ID. The reader carries the known local\n83|// host identity every local plan requires for its source binding, plus\n84|// the winning lease authority every plan requires.\n85|func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n86|\tt.Helper()\n87|\tlocal, root := repository(t)\n88|\tref := create(t, local, idA, \"alpha\")\n89|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n90|\treader := &Reader{Local: local, LocalHostID: hostA}\n91|\twithLeases(reader, leaseCreate(t, idA, hostA))\n92|\treturn reader, root, ref, created\n93|}\n94|\n95|func mustBuild(t *testing.T, reader *Reader, args PlanArgs) SelectionPlan {\n96|\tt.Helper()\n97|\tplan, err := reader.BuildPlan(args)\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\treturn plan\n102|}\n103|\n104|func mustStale(t *testing.T, err error, reason string) {\n105|\tt.Helper()\n106|\tif !errors.Is(err, ErrPlanStale) {\n107|\t\tt.Fatalf(\"error = %v, want selector_plan_stale\", err)\n108|\t}\n109|\tif !strings.Contains(err.Error(), reason) {\n110|\t\tt.Fatalf(\"error = %v, want reason %q\", err, reason)\n111|\t}\n112|}\n113|\n114|func TestBuildPlanBindsCurrentFacts(t *testing.T) {\n115|\treader, _, ref, created := plannedSession(t)\n116|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n117|\tif plan.SelectorVersion != SelectorVersion || plan.Selector != \"alpha\" || plan.SessionID != idA {\n118|\t\tt.Fatalf(\"identity: %+v\", plan)\n119|\t}\n120|\tif plan.SessionRecordID != ref.RecordID {\n121|\t\tt.Fatalf(\"record digest = %q, want %q\", plan.SessionRecordID, ref.RecordID)\n122|\t}\n123|\tif plan.SourceHostID != hostA || plan.SourceAlias != nil {\n124|\t\tt.Fatalf(\"local source: host %q alias %+v\", plan.SourceHostID, plan.SourceAlias)\n125|\t}\n126|\tfor _, digest := range []string{plan.SourceIndexDigest, plan.ConfigurationDigest, plan.ExpectationDigest} {\n127|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n128|\t\t\tt.Fatalf(\"digest %q: %v\", digest, err)\n129|\t\t}\n130|\t}\n131|\tif plan.SourceIndexDigest == plan.ConfigurationDigest {\n132|\t\tt.Fatalf(\"index and configuration digests collide\")\n133|\t}\n134|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n135|\t\tt.Fatalf(\"lease: %+v\", plan)\n136|\t}\n137|\t// The plan binds the canonical digest of the admitted winning\n138|\t// Lease Record, never an envelope fingerprint.\n139|\twantLease, err := reader.winningLeaseFor(idA)\n140|\tif err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tif plan.LeaseRecordID != wantLease.Digest {\n144|\t\tt.Fatalf(\"lease_record_id = %q, want %q\", plan.LeaseRecordID, wantLease.Digest)\n145|\t}\n146|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n147|\t\tt.Fatalf(\"lease_record_id %q: %v\", plan.LeaseRecordID, err)\n148|\t}\n149|\twantHeads := append([]string{wantLease.Digest, created}, []string{}...)\n150|\tsortStringsForTest(wantHeads)\n151|\tif !reflect.DeepEqual(plan.AuthorityHeads, wantHeads) {\n152|\t\tt.Fatalf(\"heads: %+v, want %+v\", plan.AuthorityHeads, wantHeads)\n153|\t}\n154|\tif plan.Action != ActionStatus || plan.DestinationHostID != nil {\n155|\t\tt.Fatalf(\"action: %+v\", plan)\n156|\t}\n157|\tif plan.ExpectationDigest != \"sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a\" {\n158|\t\tt.Fatalf(\"empty expectations digest = %q\", plan.ExpectationDigest)\n159|\t}\n160|\tagain := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n161|\tif !reflect.DeepEqual(plan, again) {\n162|\t\tt.Fatalf(\"rebuild diverged:\\n%+v\\n%+v\", plan, again)\n163|\t}\n164|\tif err := reader.Revalidate(plan); err != nil {\n165|\t\tt.Fatalf(\"fresh plan is not current: %v\", err)\n166|\t}\n167|}\n168|\n169|func TestBuildPlanPeerSourceFacts(t *testing.T) {\n170|\tlocal, _ := repository(t)\n171|\tpeer, _ := repository(t)\n172|\tcreate(t, local, idA, \"alpha\")\n173|\tref := create(t, peer, idB, \"beta\")\n174|\tcreated := appendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n175|\t_ = created\n176|\treader := &Reader{\n177|\t\tLocal:              local,\n178|\t\tLocalHostID:        hostB,\n179|\t\tAllowlistedPeerIDs: []string{hostA},\n180|\t\tPeers:              []PeerIndex{{hostA, peer}},\n181|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n182|\t}\n183|\twithLeases(reader, leaseCreate(t, idB, hostA))\n184|\tplan := mustBuild(t, reader, PlanArgs{\n185|\t\tSelector:     \"beta@peer:workstation\",\n186|\t\tAction:       ActionAttach,\n187|\t\tDestination:  hostB,\n188|\t\tExpectations: []byte(`{\"checkpoint_id\":null}`),\n189|\t})\n190|\tif plan.SourceHostID != hostA || plan.SourceAlias == nil || *plan.SourceAlias != \"workstation\" {\n191|\t\tt.Fatalf(\"source: %+v\", plan)\n192|\t}\n193|\tif plan.SessionID != idB || plan.SessionRecordID != ref.RecordID {\n194|\t\tt.Fatalf(\"identity: %+v\", plan)\n195|\t}\n196|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n197|\t\tt.Fatalf(\"lease: %+v\", plan)\n198|\t}\n199|\tleaseWinner, err := reader.winningLeaseFor(idB)\n200|\tif err != nil {\n201|\t\tt.Fatal(err)\n202|\t}\n203|\tif plan.LeaseRecordID != leaseWinner.Digest {\n204|\t\tt.Fatalf(\"lease_record_id = %q, want %q\", plan.LeaseRecordID, leaseWinner.Digest)\n205|\t}\n206|\tif len(plan.AuthorityHeads) == 0 {\n207|\t\tt.Fatalf(\"heads are empty: %+v\", plan.AuthorityHeads)\n208|\t}\n209|\tif plan.DestinationHostID == nil || *plan.DestinationHostID != hostB {\n210|\t\tt.Fatalf(\"destination: %+v\", plan)\n211|\t}\n212|\tif err := reader.Revalidate(plan); err != nil {\n213|\t\tt.Fatalf(\"fresh peer plan is not current: %v\", err)\n214|\t}\n215|}\n216|\n217|func TestBuildPlanRecordOnlySessionRefusesBootstrap(t *testing.T) {\n218|\tlocal, _ := repository(t)\n219|\tcreate(t, local, idA, \"alpha\")\n220|\treader := &Reader{Local: local, LocalHostID: hostA}\n(more lines below)","final_result":true}}}
