{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c795","stream":{"kind":"session","id":"01a088d5-4507-7282-8481-779aad88dbd7"},"sequence":549,"recorded_at":1780531400001093,"record_type":"event","durability":"durable","causation_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d","run_stream":{"kind":"run","id":"12839350-e4ee-4c62-b8d1-5671ff3adc6d"},"task_stream":{"kind":"task","id":"01a088d6-22f0-7a12-84f2-5e563485d270"},"task_id":"01a088d6-22f0-7a12-84f2-5e563485d270","event":{"kind":"output","task_id":"01a088d6-22f0-7a12-84f2-5e563485d270","chunk":"Read text file `/tmp/rev4ev/reviewer_rev4_test.go`.\n1|package sessquery\n2|\n3|import (\n4| \"encoding/json\"\n5| \"errors\"\n6| \"strings\"\n7| \"testing\"\n8| \"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|)\n10|func rev4Successor(t *testing.T) *Reader {\n11| r, _, _, created := plannedSession(t)\n12| launched := appendEvent(t,r.Local,idA,created,\"provider.launched\",2,map[string]any{\"provider_id\":\"codex\",\"provider_version\":\"0.147.0\",\"execution_profile\":\"yolo\",\"profile_source_event_id\":nil,\"profile_mapping\":\"default\"})\n13| appendEventAs(t,r.Local,idA,launched,\"lease.transferred\",1,2,leaseB,map[string]any{\"operation_id\":hostB,\"from_host_id\":hostA,\"to_host_id\":hostA,\"predecessor_lease_id\":lease,\"new_lease_id\":leaseB})\n14| return r\n15|}\n16|func TestRev4SelfPredecessorMustRefuse(t *testing.T) {\n17| r:=rev4Successor(t)\n18| withLeases(r,leaseRecordBytes(t,idA,2,leaseB,hostA,leaseB,true))\n19| p,err:=r.BuildPlan(PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n20| if err==nil { t.Fatalf(\"BuildPlan accepted epoch-2 self predecessor; Revalidate=%v lease=%s\",r.Revalidate(p),p.LeaseRecordID) }\n21|}\n22|func TestRev4MissingCheckpointMustRefuse(t *testing.T) {\n23| r:=rev4Successor(t)\n24| withLeases(r,leaseRecordBytes(t,idA,2,leaseB,hostA,lease,true))\n25| p,err:=r.BuildPlan(PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n26| if err==nil { t.Fatalf(\"BuildPlan accepted successor with placeholder checkpoint and no validated checkpoint supplied; Revalidate=%v lease=%s\",r.Revalidate(p),p.LeaseRecordID) }\n27|}\n28|func TestRev4ParkedAuthorityMustRefuse(t *testing.T) {\n29| local,_:=repository(t);peer,_:=repository(t)\n30| leasedPeerSession(t,peer,idB,\"beta\")\n31| r:=unionReader(t,local,peer)\n32| p:=mustBuild(t,r,PlanArgs{Selector:\"id:\"+idB,Action:ActionStatus})\n33| local.AfterCreateStep=func(step sessrepo.CreateStep)error{if step==sessrepo.CreateStepRecord{return errors.New(\"interrupted creation\")};return nil}\n34| if _,err:=local.CreateSession(record(t,idB,\"conflicting-record\"));err==nil{t.Fatal(\"fault did not fire\")}\n35| local.AfterCreateStep=nil\n36| rows,err:=r.InspectLocal(idB);if err!=nil{t.Fatal(err)}\n37| if rows.Projection.Parked==nil{t.Fatal(\"premise: copy must be parked\")}\n38| t.Logf(\"required source parked: %+v\",rows.Projection.Parked)\n39| if err:=r.Revalidate(p);err==nil{t.Fatal(\"Revalidate accepted while required same-UUID authority is unknown/parked\")}\n40|}\n41|func TestRev4UnknownCapabilityMustRefuse(t *testing.T) {\n42| r:=summaryReader(t);o:=r.Observations[idA];o.Capabilities=map[string]CapabilitySummary{\"invented_capability\":{Status:\"available\",Enabled:true}};r.Observations[idA]=o\n43| for _,list:=range []bool{false,true}{\n44|  if list {if rows,err:=r.AuthoritativeList();err==nil{t.Errorf(\"AuthoritativeList advertises unsupported name: %+v\",rows[0].Capabilities)}} else {if row,err:=r.AuthoritativeStatus(\"alpha\");err==nil{t.Errorf(\"AuthoritativeStatus advertises unsupported name: %+v\",row.Capabilities)}}\n45| }\n46|}\n47|func TestRev4ChangedLiveRecordRefuses(t *testing.T) {\n48| r,_,_,_:=plannedSession(t);p:=mustBuild(t,r,PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n49| replacement,_:=repository(t);ref:=create(t,replacement,idA,\"renamed\")\n50| appendEvent(t,replacement,idA,ref.RecordID,\"session.created\",1,map[string]any{\"session_record_id\":ref.RecordID,\"bootstrap_operation_id\":hostA,\"first_checkpoint_operation_id\":hostB})\n51| r.Local=replacement\n52| s,err:=r.InspectLocal(idA);if err!=nil{t.Fatal(err)}\n53| if s.Projection.Parked!=nil || s.Projection.RecordID==\"\" || s.Projection.RecordID==p.SessionRecordID {t.Fatal(\"invalid live changed-record witness\")}\n54| err=r.Revalidate(p);if !errors.Is(err,ErrPlanStale){t.Fatalf(\"changed live record = %v\",err)}\n55| t.Logf(\"live record change refused: %v\",err)\n56|}\n57|func TestRev4DifferentLeaseDigestRefuses(t *testing.T) {\n58| r,_,_,_:=plannedSession(t);p:=mustBuild(t,r,PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n59| var value map[string]any;if err:=json.Unmarshal(r.LeaseRecords[0],&value);err!=nil{t.Fatal(err)}\n60| value[\"created_at\"]=\"2026-08-19T04:10:00.000Z\";r.LeaseRecords=[][]byte{identity(t,value,\"record_id\")}\n61| if err:=r.Revalidate(p);!errors.Is(err,ErrPlanStale)||!strings.Contains(err.Error(),\"winning lease\"){t.Fatalf(\"changed canonical lease identity = %v\",err)}\n62|}","final_result":true}}}
