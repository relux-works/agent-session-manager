  1067			}
  1068			if candidate.EventType != "profile.changed" {
  1069				continue
  1070			}
  1116			return fmt.Errorf("%w: session %s event %s names profile source %s, want newest authoritative source %s for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, wantSource)
  1117		}
