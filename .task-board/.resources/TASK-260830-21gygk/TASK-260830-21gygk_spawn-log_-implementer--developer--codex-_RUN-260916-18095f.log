+			if err := rev12CheckRecordConsumptionSource(dir); err == nil {
+				t.Fatalf("type-level record-consumption gate admitted %s", name)
+			} else {
+				t.Logf("rejected %s: %v", name, err)
+			}
+		})
+	}
+}
