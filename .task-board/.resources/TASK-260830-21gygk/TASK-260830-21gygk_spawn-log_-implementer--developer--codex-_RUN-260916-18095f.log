+		tail = appendEventAs(t, local, idA, tail, "lease.transferred", 1, 3, leaseCycleB, map[string]any{
+			"operation_id":        hostB,
+			"from_host_id":         hostA,
+			"to_host_id":           hostA,
+			"predecessor_lease_id": leaseB,
+			"new_lease_id":          leaseCycleB,
+		})
+	}
+	_ = tail
