   282	// TestRev11RecordConsumptionCensus is the call-graph gate for the
   283	// record-consumption table: every record the shared profile owner
   284	// consumes must pass its semantic admission owner before its bytes
   285	// are derived. It parses the shipped lease.go and requires that the
   286	// resume path calls the shared referenced admission owner, that the
   287	// owner calls the shared persistence and head helpers, that the
   288	// outer walk calls the resume derivation, and that admission runs
   289	// before closure derivation in source order. A token-preserving
   290	// narrowing mutant keeps these call tokens while admitting one
   291	// invalid member, so this static gate alone never proves the
   292	// behavior; the TestReview10/TestRev11 behavioral suites must fail.
   293	func TestRev11RecordConsumptionCensus(t *testing.T) {
   294		_, file, _, ok := runtime.Caller(0)
   295		if !ok {
   296			t.Fatal("cannot locate test file")
   297		}
   298		leasePath := filepath.Join(filepath.Dir(file), "lease.go")
   299		src, err := os.ReadFile(leasePath)
   300		if err != nil {
   301			t.Fatal(err)
   302		}
   303		fset := token.NewFileSet()
   304		parsed, err := parser.ParseFile(fset, leasePath, src, 0)
   305		if err != nil {
   306			t.Fatal(err)
   307		}
   308		callsOf := func(funcName string) map[string][]token.Pos {
   309			out := map[string][]token.Pos{}
   310			for _, decl := range parsed.Decls {
   311				fn, ok := decl.(*ast.FuncDecl)
   312				if !ok || fn.Name.Name != funcName || fn.Body == nil {
   313					continue
   314				}
   315				ast.Inspect(fn.Body, func(n ast.Node) bool {
   316					call, ok := n.(*ast.CallExpr)
   317					if !ok {
   318						return true
   319					}
   320					var name string
   321					switch fun := call.Fun.(type) {
   322					case *ast.Ident:
   323						name = fun.Name
   324					case *ast.SelectorExpr:
   325						name = fun.Sel.Name
   326					}
   327					if name != "" {
   328						out[name] = append(out[name], call.Pos())
   329					}
   330					return true
   331				})
   332			}
   333			return out
   334		}
   335		requireCall := func(caller, callee string) {
   336			t.Helper()
   337			calls := callsOf(caller)
   338			if len(calls[callee]) == 0 {
   339				t.Errorf("%s must call shared admission owner %s", caller, callee)
   340			}
   341		}
   342		requireCall("checkClosureProfilePairs", "referencedCheckpointProfile")
   343		requireCall("referencedCheckpointProfile", "checkReferencedCheckpointBinding")
   344		requireCall("checkReferencedCheckpointBinding", "checkCheckpointPersistence")
   345		requireCall("checkReferencedCheckpointBinding", "checkCheckpointEventHeads")
   346		requireCall("checkWinnerCheckpoint", "checkCheckpointProfileAuthority")
   347		requireCall("checkCheckpointBinding", "checkCheckpointProfileAuthority")
   348		requireCall("checkCheckpointProfileAuthority", "checkClosureProfilePairs")
   349		// Admission must precede derivation in source order: the
   350		// referenced binding call must appear before the referenced
   351		// closure derivation in the same function body.
   352		derived := callsOf("referencedCheckpointProfile")
   353		admitPos := derived["checkReferencedCheckpointBinding"]
   354		closurePos := derived["profileClosure"]
   355		if len(admitPos) > 0 && len(closurePos) > 0 {
   356			if fset.Position(admitPos[0]).Line > fset.Position(closurePos[0]).Line {
   357				t.Errorf("referencedCheckpointProfile must admit before deriving: binding at line %d, closure at line %d",
   358					fset.Position(admitPos[0]).Line, fset.Position(closurePos[0]).Line)
   359			}
   360		} else {
   361			if len(admitPos) == 0 {
   362				t.Errorf("referencedCheckpointProfile must call checkReferencedCheckpointBinding before profileClosure")
   363			}
   364			if len(closurePos) == 0 {
   365				t.Errorf("referencedCheckpointProfile must derive via profileClosure after admission")
   366			}
   367		}
   368	}

