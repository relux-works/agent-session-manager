     1	// Validated Lease Record admission for the v0.6.0 selector contract
     2	// (SPEC Sections 5.3 and 14.7.2).
     3	//
     4	// The reader carries canonical Lease Record bytes from the lease owner
     5	// in Reader.LeaseRecords. Each record is validated through the
     6	// canonicaljson owner (closed shape plus canonical self identity), and
     7	// the greatest (epoch, lease_id) winner per session supplies the plan
     8	// lease_record_id digest with its epoch, lease ID, and holder. Envelope
     9	// triples observed on event chains never substitute for these records:
    10	// a session with no admitted winning record refuses
    11	// selector_observation_unavailable, and malformed bytes refuse
    12	// invalid_config.
    13	package sessquery
    14	
    15	import (
    16		"encoding/json"
    17		"fmt"
    18	
    19		"github.com/relux-works/agent-session-manager/internal/canonicaljson"
    20		"github.com/relux-works/agent-session-manager/internal/environ"
    21		"github.com/relux-works/agent-session-manager/internal/scalar"
    22		"github.com/relux-works/agent-session-manager/internal/sessrepo"
    23		"github.com/relux-works/agent-session-manager/internal/sessstate"
    24	)
    25	
    26	const leaseRecordSchema = "urn:ax:schema:lease"
    27	
    28	// validatedLease is one admitted Lease Record: its canonical digest and
    29	// the members the selector binds.
    30	type validatedLease struct {
    31		Digest         string
    32		SessionID      string
    33		LeaseID        string
    34		Epoch          uint64
    35		HolderHostID   string
    36		Predecessor    string
    37		HasPredecessor bool
    38		Checkpoint     string
    39		HasCheckpoint  bool
    40		Raw            []byte
    41	}
    42	
    43	// checkpointRecordSchema is the exact Checkpoint Record schema the
    44	// winning-lease checkpoint gate admits.
    45	const checkpointRecordSchema = "urn:ax:schema:checkpoint"
    46	
    47	// validatedCheckpoint is one admitted Checkpoint Record: its canonical
    48	// digest with the session and lease it was taken under, plus the host
    49	// that created it. Section 5.4 binds lease_epoch/lease_id to the
    50	// referenced winning lease, so a successor's checkpoint names its
    51	// predecessor lease, and binds created_by_host_id to the current
    52	// lease holder: the holder of the lease the checkpoint names. The
    53	// persistence presence members carry which variant the record uses;
    54	// the referenced Session Record selects which variant is valid
    55	// (checkCheckpointPersistence), because canonical shape alone admits
    56	// either variant. EventHeads carries the authoritative event DAG
    57	// heads immediately before the checkpoint object; every required
    58	// checkpoint must resolve each head to a chained event for its
    59	// session at or before its bound lease
    60	// (checkCheckpointEventHeads), because a canonical checkpoint
    61	// naming an absent event or an event under a later lease cannot
    62	// establish Section 5.3/14.7.2 current complete authority. The same
    63	// closure must then admit the Section 2.4 profile authority
    64	// (checkCheckpointProfileAuthority), because a canonical checkpoint
    65	// over a corrupt profile history cannot fix the effective profile.
    66	type validatedCheckpoint struct {
    67		Digest              string
    68		SessionID           string
    69		LeaseEpoch          uint64
    70		LeaseID             string
    71		CreatorHostID       string
    72		HasProviderManifest bool
    73		HasTaskBoardBundle  bool
    74		EventHeads          []string
    75		Raw                 []byte
    76	}
    77	
    78	// parseLeaseRecord validates one canonical Lease Record through the
    79	// canonicaljson owner and extracts the bound members. Closed-shape and
    80	// identity failures refuse invalid_config; the caller maps absence to
    81	// observation_unavailable.
    82	func parseLeaseRecord(raw []byte) (validatedLease, error) {
    83		var lease validatedLease
    84		members, fault := environ.DecodeStrictObject(raw)
    85		if fault != nil {
    86			return lease, fmt.Errorf("%w: decode lease record frame: %v", ErrInvalidConfig, fault)
    87		}
    88		schema, err := leaseStringMember(members, "schema")
    89		if err != nil || schema != leaseRecordSchema {
    90			return lease, fmt.Errorf("%w: lease record schema %q, want %q", ErrInvalidConfig, schema, leaseRecordSchema)
    91		}
    92		digest, field, err := sessrepo.AttestLeaseRecord(raw)
    93		if err != nil {
    94			return lease, fmt.Errorf("%w: verify lease record identity: %v", ErrInvalidConfig, err)
    95		}
    96		if field != canonicaljson.SelfRecordID {
    97			return lease, fmt.Errorf("%w: lease record identity field %q, want record_id", ErrInvalidConfig, string(field))
    98		}
    99		sessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, "session_id"))
   100		if !ok {
   101			return lease, fmt.Errorf("%w: lease record carries no valid session_id member", ErrInvalidConfig)
   102		}
   103		leaseID, err := leaseStringMember(members, "lease_id")
   104		if err != nil {
   105			return lease, fmt.Errorf("%w: lease record carries no lease_id member: %v", ErrInvalidConfig, err)
   106		}
   107		if _, err := scalar.ParseUUIDv4(leaseID); err != nil {
   108			return lease, fmt.Errorf("%w: lease record lease_id: %v", ErrInvalidConfig, err)
   109		}
   110		epoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, "epoch"), 1, uint53Ceiling)
   111		if !ok {
   112			return lease, fmt.Errorf("%w: lease record carries no epoch at or above 1", ErrInvalidConfig)
   113		}
   114		holder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, "holder_host_id"))
   115		if !ok {
   116			return lease, fmt.Errorf("%w: lease record carries no valid holder_host_id member", ErrInvalidConfig)
   117		}
   118		predecessor, hasPredecessor, err := leaseNullableUUIDv4(members, "predecessor_lease_id")
   119		if err != nil {
   120			return lease, fmt.Errorf("%w: lease record predecessor_lease_id: %v", ErrInvalidConfig, err)
   121		}
   122		checkpoint, hasCheckpoint, err := leaseNullableDigest(members, "checkpoint_id")
   123		if err != nil {
   124			return lease, fmt.Errorf("%w: lease record checkpoint_id: %v", ErrInvalidConfig, err)
   125		}
   126		lease = validatedLease{
   127			Digest:         digest.String(),
   128			SessionID:      sessionID.String(),
   129			LeaseID:        leaseID,
