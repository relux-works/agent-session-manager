   368	// checkLeaseChain validates the winner's predecessor ancestry within
   369	// the admitted records for its session. Section 5.3 requires every
   370	// epoch above 1 to name a known predecessor for the same session
   371	// with an epoch exactly one below, down to an epoch-1 root with a
   372	// null predecessor; epochs below 1 cannot exist, so an epoch-1
   373	// lease naming any predecessor is malformed. A self, cyclic,
   374	// skipped, contradictory, or duplicated link is malformed authority
   375	// (integrity failure); a missing predecessor name or record is
   376	// incomplete authority (observation_unavailable). Epochs strictly
   377	// decrease along the walk, so the walk always terminates. It
   378	// returns the winning ancestry from the winner down to the epoch-1
   379	// root, plus the winner's direct predecessor, or the zero lease at
   380	// epoch 1.
   381	func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {
   382		byLease := make(map[string]validatedLease, len(candidates))
   383		for _, candidate := range candidates {
   384			if previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {
   385				return nil, validatedLease{}, fmt.Errorf("%w: session %s carries contradictory lease records for lease %s", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)
   386			}
   387			byLease[candidate.LeaseID] = candidate
   388		}
   389		var predecessor validatedLease
   390		var chain []validatedLease
   391		current := winner
   392		for {
   393			chain = append(chain, current)
   394			if current.Epoch == 1 {
   395				if current.HasPredecessor {
   396					return nil, validatedLease{}, fmt.Errorf("%w: session %s epoch-1 lease %s names a predecessor", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)
   397				}
   398				return chain, predecessor, nil
   399			}
   400			if !current.HasPredecessor {
   401				return nil, validatedLease{}, fmt.Errorf("%w: winning lease record for session %s names no predecessor", ErrObservationUnavailable, current.SessionID)
   402			}
   403			parent, ok := byLease[current.Predecessor]
   404			if !ok {
   405				return nil, validatedLease{}, fmt.Errorf("%w: predecessor lease record for session %s cannot be established", ErrObservationUnavailable, current.SessionID)
   406			}
   407			if parent.Epoch+1 != current.Epoch {
   408				return nil, validatedLease{}, fmt.Errorf("%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)
   409			}
   410			if current.LeaseID == winner.LeaseID {
   411				predecessor = parent
   412			}
   413			current = parent
   414		}
   415	}
