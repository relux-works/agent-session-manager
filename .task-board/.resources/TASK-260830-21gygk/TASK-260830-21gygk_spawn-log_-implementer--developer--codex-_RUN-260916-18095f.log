+}
+`,
+	}
+	for name, plant := range plants {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			rev12CopyProductionSources(t, packageDir, dir)
+			if err := os.WriteFile(filepath.Join(dir, name), []byte(plant), 0o600); err != nil {
+				t.Fatal(err)
