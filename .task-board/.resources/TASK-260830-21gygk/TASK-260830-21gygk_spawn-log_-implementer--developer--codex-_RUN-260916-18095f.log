+var rev12RawAdmissionOwners = map[string]bool{
+	"parseCheckpointRecord":             true,
+	"validatedCheckpointsByDigest":      true,
+	"checkWinnerCheckpoint":             true,
+	"checkAncestorCheckpoints":          true,
+	"checkCheckpointBinding":            true,
