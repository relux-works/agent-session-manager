+					r.CheckpointRecords = originalCP
+					r.LeaseRecords = originalLeases
+					oldErr := r.Revalidate(old)
+					t.Logf("old-plan refusal: %v", oldErr)
+					if oldErr == nil {
+						t.Error("old-plan admitted invalid temporal authority")
+					}
+					rev7CheckEntries(t, r, true)
+				})
+			}
+		}
+	}
+}
