   270			return nil, fmt.Errorf("member %q is absent", "event_heads")
   271		}
   272		var values []string
   273		if err := json.Unmarshal(raw, &values); err != nil {
   274			return nil, fmt.Errorf("member %q is not a string array: %v", "event_heads", err)
   275		}
   276		out := make([]string, 0, len(values))
   277		for _, value := range values {
   278			digest, err := scalar.ParseDigest(value)
   279			if err != nil {
   280				return nil, fmt.Errorf("member %q holds malformed digest %q: %v", "event_heads", value, err)
   281			}
   282			out = append(out, digest.String())
   283		}
   284		return out, nil
   285	}
   286	
   287	// validatedLeasesBySession validates every supplied Lease Record and
   288	// groups the admitted records by session UUID.
   289	func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {
   290		out := map[string][]validatedLease{}
   291		if reader == nil {
   292			return out, fmt.Errorf("%w: reader carries no configuration", ErrInvalidConfig)
   293		}
   294		for _, raw := range reader.LeaseRecords {
   295			lease, err := parseLeaseRecord(raw)
   296			if err != nil {
   297				return nil, err
   298			}
   299			out[lease.SessionID] = append(out[lease.SessionID], lease)
   300		}
   301		return out, nil
   302	}
   303	
   304	// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease
   305	// Record for one session and validates its succession: the
   306	// predecessor ancestry must chain by epoch plus one down to an
   307	// epoch-1 root, and every lease in that winning ancestry above
   308	// epoch 1 must reference a validated checkpoint for its session and
   309	// predecessor lease (Section 5.3), each created by the owning lease
   310	// holder (Section 5.4). Every required checkpoint must additionally
   311	// carry the persistence variant the referenced Session Record
   312	// selects: sessionKind is that record's kind as projected from the
   313	// winning source, and a variant mismatch refuses
   314	// observation_unavailable even when canonical identity, session,
   315	// lease, epoch, and creator all agree. Every required checkpoint
   316	// must also resolve each event head to a chained event for its
   317	// session at or before its bound lease in the winning source chain
   318	// (repo, Section 5.4 event-head closure): a head naming an absent
   319	// event or an event under a later lease cannot establish current
   320	// complete authority, so it refuses observation_unavailable;
   321	// historical heads stay admissible and are never required to equal
   322	// the current tail. Every required checkpoint must also admit its
   323	// Section 2.4 profile authority over the same closure
   324	// (checkCheckpointProfileAuthority): a first launch outside the
   325	// creation pair, a later launch outside the newest authoritative
   326	// change at or before it, a resume outside its referenced
   327	// checkpoint's closure pair, or a fork outside the new record
   328	// pair, contradicts the admitted history (integrity failure).
   329	// Absence refuses observation_unavailable; a
   330	// lease above epoch 1 without its named predecessor in the admitted
   331	// set refuses the same class rather than binding a dangling
   332	// successor, while an illegal predecessor link is malformed
   333	// authority (integrity failure).
   334	func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {
   335		if sessionKind != "direct" && sessionKind != "task_board" {
   336			return validatedLease{}, fmt.Errorf("%w: session %s carries unknown kind %q for checkpoint persistence", ErrInvalidConfig, sessionID, sessionKind)
   337		}
   338		bySession, err := reader.validatedLeasesBySession()
   339		if err != nil {
   340			return validatedLease{}, err
   341		}
   342		candidates := bySession[sessionID]
   343		if len(candidates) == 0 {
   344			return validatedLease{}, fmt.Errorf("%w: winning lease record for session %s cannot be established", ErrObservationUnavailable, sessionID)
   345		}
   346		winner := candidates[0]
   347		for _, candidate := range candidates[1:] {
   348			if sessstate.Compare(
   349				sessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},
   350				sessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},
   351			) > 0 {
   352				winner = candidate
   353			}
   354		}
   355		chain, predecessor, err := checkLeaseChain(candidates, winner)
   356		if err != nil {
   357			return validatedLease{}, err
   358		}
   359		if err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo, chain); err != nil {
   360			return validatedLease{}, err
   361		}
   362		if err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {
   363			return validatedLease{}, err
   364		}
   365		return winner, nil
   366	}
   367	
   368	// checkLeaseChain validates the winner's predecessor ancestry within
   369	// the admitted records for its session. Section 5.3 requires every
   370	// epoch above 1 to name a known predecessor for the same session
   371	// with an epoch exactly one below, down to an epoch-1 root with a
   372	// null predecessor; epochs below 1 cannot exist, so an epoch-1
   373	// lease naming any predecessor is malformed. A self, cyclic,
   374	// skipped, contradictory, or duplicated link is malformed authority
   375	// (integrity failure); a missing predecessor name or record is
   376	// incomplete authority (observation_unavailable). Epochs strictly
   377	// decrease along the walk, so the walk always terminates. It
   378	// returns the winning ancestry from the winner down to the epoch-1
   379	// root, plus the winner's direct predecessor, or the zero lease at
   380	// epoch 1.
   381	func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {
   382		byLease := make(map[string]validatedLease, len(candidates))
   383		for _, candidate := range candidates {
   384			if previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {
   385				return nil, validatedLease{}, fmt.Errorf("%w: session %s carries contradictory lease records for lease %s", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)
   386			}
   387			byLease[candidate.LeaseID] = candidate
   388		}
   389		var predecessor validatedLease
   390		var chain []validatedLease
   391		current := winner
   392		for {
   393			chain = append(chain, current)
   394			if current.Epoch == 1 {
   395				if current.HasPredecessor {
   396					return nil, validatedLease{}, fmt.Errorf("%w: session %s epoch-1 lease %s names a predecessor", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)
   397				}
   398				return chain, predecessor, nil
   399			}
   400			if !current.HasPredecessor {
   401				return nil, validatedLease{}, fmt.Errorf("%w: winning lease record for session %s names no predecessor", ErrObservationUnavailable, current.SessionID)
   402			}
   403			parent, ok := byLease[current.Predecessor]
   404			if !ok {
   405				return nil, validatedLease{}, fmt.Errorf("%w: predecessor lease record for session %s cannot be established", ErrObservationUnavailable, current.SessionID)
   406			}
   407			if parent.Epoch+1 != current.Epoch {
   408				return nil, validatedLease{}, fmt.Errorf("%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)
   409			}
   410			if current.LeaseID == winner.LeaseID {
   411				predecessor = parent
   412			}
   413			current = parent
   414		}
   415	}
   416	
   417	// validatedCheckpointsByDigest validates every supplied Checkpoint
   418	// Record and indexes the admitted records by canonical digest.
   419	func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {
   420		out := map[string]validatedCheckpoint{}
   421		if reader == nil {
   422			return out, fmt.Errorf("%w: reader carries no configuration", ErrInvalidConfig)
   423		}
   424		for _, raw := range reader.CheckpointRecords {
   425			checkpoint, err := parseCheckpointRecord(raw)
   426			if err != nil {
   427				return nil, err
   428			}
   429			out[checkpoint.Digest] = checkpoint
   430		}
   431		return out, nil
   432	}
   433	
   434	// checkWinnerCheckpoint resolves the winner's checkpoint reference
   435	// against the admitted Checkpoint Records. Section 5.3 requires
   436	// every epoch above 1 to reference a validated checkpoint for its
   437	// session and predecessor lease; an epoch-1 root without a
   438	// predecessor may carry no checkpoint before the first provider
   439	// boundary exists. A non-null reference must resolve to an admitted
   440	// record for the same session bound to the lease it was taken
   441	// under: the predecessor for a successor, the winner itself at
   442	// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An
   443	// unresolvable reference is incomplete authority
   444	// (observation_unavailable), never absence or a minted fact. The
   445	// admitted checkpoint must also resolve its event-head closure in
   446	// the winning source chain (repo); see checkCheckpointEventHeads.
   447	// The same closure must then admit its Section 2.4 profile
   448	// authority; see checkCheckpointProfileAuthority.
   449	func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {
   450		if !winner.HasCheckpoint {
   451			if winner.Epoch == 1 && !winner.HasPredecessor {
   452				return nil
   453			}
   454			return fmt.Errorf("%w: validated checkpoint for session %s lease %s cannot be established", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)
   455		}
   456		checkpoints, err := reader.validatedCheckpointsByDigest()
   457		if err != nil {
   458			return err
   459		}
   460		checkpoint, ok := checkpoints[winner.Checkpoint]
   461		if !ok {
   462			return fmt.Errorf("%w: validated checkpoint %s for session %s cannot be established", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)
   463		}
   464		if checkpoint.SessionID != winner.SessionID {
   465			return fmt.Errorf("%w: validated checkpoint %s carries session %s, want %s", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)
   466		}
   467		wantEpoch, wantLease := winner.Epoch, winner.LeaseID
   468		if winner.Epoch > 1 {
   469			wantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID
   470		}
   470		}
   471		if checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {
   472			return fmt.Errorf("%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)
   473		}
   474		owner := winner
   475		if winner.Epoch > 1 {
   476			owner = predecessor
   477		}
   478		if checkpoint.CreatorHostID != owner.HolderHostID {
   479			return fmt.Errorf("%w: validated checkpoint %s is created by host %s, want owning lease holder %s", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)
   480		}
   481		if err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {
   482			return err
   483		}
   484		if err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {
   485			return err
   486		}
   487		if err := checkCheckpointProfileAuthority(checkpoint, repo, checkpoints, chain, sessionKind); err != nil {
   488			return err
   489		}
   490		return nil
   491	}
   492	
   493	// checkAncestorCheckpoints validates the checkpoint references of
   494	// every non-winner lease in the winning ancestry: Section 5.3
   495	// requires each epoch above 1 to reference a validated checkpoint
   496	// for its session and predecessor lease, and Section 5.4 requires
   497	// that checkpoint to be created by the owning lease holder. The
   498	// winner itself is covered by checkWinnerCheckpoint. Only the
   499	// winner's own ancestry is admitted: sibling branches off that
   500	// chain are never consulted, so legal branching is preserved. An
   501	// epoch-1 root without a reference stays admissible before the
   502	// first provider boundary exists; a reference it does carry must
   503	// resolve to a checkpoint bound to itself and created by its own
   504	// holder. An unresolvable reference or a binding to another
   505	// session, lease, or holder is incomplete authority
   506	// (observation_unavailable), never absence or a minted fact. Every
   507	// admitted ancestor checkpoint must also resolve its event-head
   508	// closure in the winning source chain (repo) and admit its Section
   509	// 2.4 profile authority over that closure.
   510	func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {
   511		if len(chain) < 2 {
   512			return nil
   513		}
   514		checkpoints, err := reader.validatedCheckpointsByDigest()
   515		if err != nil {
   516			return err
   517		}
   518		for index := 1; index < len(chain); index++ {
   519			current := chain[index]
   520			if current.Epoch == 1 {
   521				if !current.HasCheckpoint {
   522					continue
   523				}
   524				if err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo, chain); err != nil {
   525					return err
   526				}
   527				continue
   528			}
   529			if !current.HasCheckpoint {
   530				return fmt.Errorf("%w: validated checkpoint for session %s lease %s cannot be established", ErrObservationUnavailable, current.SessionID, current.LeaseID)
   531			}
   532			if index+1 >= len(chain) {
   533				return fmt.Errorf("%w: predecessor lease record for session %s cannot be established", ErrObservationUnavailable, current.SessionID)
   534			}
   535			if err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo, chain); err != nil {
   536				return err
   537			}
   538		}
   539		return nil
   540	}
   541	
   542	// checkCheckpointBinding resolves one lease's checkpoint reference
   543	// against the admitted Checkpoint Records and validates its Section
   544	// 5.3 session and predecessor-lease binding with its Section 5.4
   545	// holder binding: the checkpoint must name this session and the
   546	// owning lease, and its creator must be that lease's holder. The
   547	// admitted checkpoint must also resolve its event-head closure in
   548	// the winning source chain (repo); see checkCheckpointEventHeads.
   549	// The same closure must then admit its Section 2.4 profile
   550	// authority; see checkCheckpointProfileAuthority.
   551	func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository, chain []validatedLease) error {
   552		checkpoint, ok := checkpoints[current.Checkpoint]
   553		if !ok {
   554			return fmt.Errorf("%w: validated checkpoint %s for session %s cannot be established", ErrObservationUnavailable, current.Checkpoint, current.SessionID)
   555		}
   556		if checkpoint.SessionID != current.SessionID {
   557			return fmt.Errorf("%w: validated checkpoint %s carries session %s, want %s", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)
   558		}
   559		if checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {
   560			return fmt.Errorf("%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)
   561		}
   562		if checkpoint.CreatorHostID != owner.HolderHostID {
   563			return fmt.Errorf("%w: validated checkpoint %s is created by host %s, want owning lease holder %s", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)
   564		}
   565		if err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {
   566			return err
   567		}
   568		if err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {
   569			return err
   570		}
   571		if err := checkCheckpointProfileAuthority(checkpoint, repo, checkpoints, chain, sessionKind); err != nil {
   572			return err
   573		}
   574		return nil
   575	}
   576	
   577	// checkCheckpointEventHeads resolves every event head of one admitted
   578	// Checkpoint Record against the winning source chain for its session
   579	// (Section 5.4 event-head closure). Each head must name a chained
   580	// event for the same session at or before the owning lease: a head
   581	// naming an absent event (including a cross-session digest, a
   582	// losing-lease preserved blob outside the authoritative chain, or a
   583	// synthetic placeholder) is incomplete authority
   584	// (observation_unavailable), and a head under a later lease (a
   585	// greater epoch, or the same epoch under a different fencing token)
   586	// is likewise incomplete authority because the checkpoint cannot fix
   587	// authority over events that postdate it. Historical heads stay
   588	// admissible and are never required to equal the current tail, so
   589	// valid branching and lagging copies are preserved. A failed chain
   590	// read keeps its cause inside the same incomplete-authority refusal
   591	// instead of minting a fact, and a nil chain handle refuses the same
   592	// class rather than skipping the gate.
   593	func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {
   594		if repo == nil {
   595			return fmt.Errorf("%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)
   596		}
   597		events, err := repo.ListEvents(checkpoint.SessionID)
   598		if err != nil {
   599			return fmt.Errorf("%w: validated checkpoint %s event-head authority for session %s cannot be established: %v", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)
   600		}
   601		byID := make(map[string]sessrepo.EventSummary, len(events))
   602		for _, summary := range events {
   603			byID[summary.EventID] = summary
   604		}
   605		for _, head := range checkpoint.EventHeads {
   606			summary, ok := byID[head]
   607			if !ok {
   608				return fmt.Errorf("%w: validated checkpoint %s names unknown event head %s for session %s", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)
   609			}
   610			if summary.LeaseEpoch > owner.Epoch {
   611				return fmt.Errorf("%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)
   612			}
   613			if summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {
   614				return fmt.Errorf("%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)
   615			}
   616		}
   617		return nil
   618	}
   619	
   620	// checkCheckpointProfileAuthority admits the Section 2.4 effective
   621	// execution profile and its nullable source event for one required
   622	// checkpoint against the winning source chain (repo, SPEC 5.4
   623	// event-head closure). The transitive predecessor closure of the
   624	// checkpoint heads fixes the launch values: the Session Record
   625	// carries the creation profile, the first launch in the closure
   626	// carries that profile with a null source, and every later
   627	// provider/task-board launch carries the newest authoritative
   628	// profile.changed event at or before it with the profile it
   629	// targets (launches carry no checkpoint_id member, so the closure
   630	// under admission evaluated in lease/sequence order is their only
   631	// referenced authority). Every session resume instead carries the
   632	// effective pair of ITS referenced checkpoint (SPEC 5.2),
   633	// resolved through the admitted Checkpoint Records (checkpoints)
   634	// and derived from that checkpoint's own event-head closure, never
   635	// from the position in the outer walk. Every fork carries the
   636	// newly persisted Session Record profile with a null source (SPEC
   637	// 2.4/5.2 new-session authority); only its source_profile_event_id
   638	// provenance stays outside this closure. A non-null source must
   639	// name a chained profile.changed event inside the governing
   640	// closure; a missing (dangling, cross-session, or preserved
   641	// outside the authoritative index), out-of-closure (later
   642	// local-only or losing-lease), wrong-type, or non-newest reference
   643	// is contradictory authority (integrity failure), as is a pair
   644	// whose profile value does not equal the derived effective
   645	// profile — consumers MUST NOT consult a later local-only event or
   646	// fall back to the creation value. Historical heads stay admissible
   647	// because derivation reads only closures, never the current tail.
   648	// A missing or misbound referenced checkpoint, an unresolvable
   649	// referenced head, a failed chain read, and a nil chain handle
   650	// refuse incomplete authority (observation_unavailable) with the
   651	// cause kept instead of minting a fact. Payloads are fetched only
   652	// for pair and change events in the closures; the index already
   653	// carries every other routing member the walk needs.
   654	func checkCheckpointProfileAuthority(checkpoint validatedCheckpoint, repo *sessrepo.Repository, checkpoints map[string]validatedCheckpoint, chain []validatedLease, sessionKind string) error {
   655		if repo == nil {
   656			return fmt.Errorf("%w: validated checkpoint %s profile authority for session %s cannot be established: no winning source chain", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)
   657		}
   658		recordBytes, err := repo.GetRecord(checkpoint.SessionID)
   659		if err != nil {
   660			return fmt.Errorf("%w: validated checkpoint %s profile authority for session %s cannot be established: %v", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)
   661		}
   662		creation, recordID, err := sessionCreationProfile(checkpoint, recordBytes)
   663		if err != nil {
   664			return err
   665		}
   666		events, err := repo.ListEvents(checkpoint.SessionID)
   667		if err != nil {
   668			return fmt.Errorf("%w: validated checkpoint %s profile authority for session %s cannot be established: %v", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)
   669		}
   670		closure, err := profileClosure(checkpoint, recordID, events)
   671		if err != nil {
   672			return err
   673		}
   674		return checkClosureProfilePairs(checkpoint, creation, recordID, events, closure, checkpoints, repo, chain, sessionKind)
   675	}
   676	
   677	// sessionCreationProfile reads the immutable creation profile and
   678	// the canonical record digest from the winning-source Session
   679	// Record bytes. The closed shape owner requires execution_profile
   680	// standard|yolo, so any other value contradicts the admitted
   681	// record (integrity failure).
   682	func sessionCreationProfile(checkpoint validatedCheckpoint, recordBytes []byte) (string, string, error) {
   683		members, fault := environ.DecodeStrictObject(recordBytes)
   684		if fault != nil {
   685			return "", "", fmt.Errorf("%w: session %s carries no decodable session record for profile authority: %v", sessstate.ErrIntegrity, checkpoint.SessionID, fault)
   686		}
   687		creation, err := leaseStringMember(members, "execution_profile")
   688		if err != nil || (creation != "standard" && creation != "yolo") {
   689			return "", "", fmt.Errorf("%w: session %s carries no valid creation profile for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID)
   690		}
   691		recordID, err := leaseStringMember(members, "record_id")
   692		if err != nil {
   693			return "", "", fmt.Errorf("%w: session %s carries no valid record digest for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID)
   694		}
   695		digest, err := scalar.ParseDigest(recordID)
   696		if err != nil {
   697			return "", "", fmt.Errorf("%w: session %s carries malformed record digest %q for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, recordID)
   698		}
   699		return creation, digest.String(), nil
   700	}
   701	
   702	// profileClosure resolves the transitive predecessor closure of the
   703	// checkpoint heads against the winning source chain index. The
   704	// genesis link names the Session Record digest rather than an
   705	// event; every other predecessor must name a chained event, so a
   706	// dangling reference contradicts the admitted closure (integrity
   707	// failure). Divergent blobs preserved outside the authoritative
   708	// index never enter the closure: index membership is authority.
   709	func profileClosure(checkpoint validatedCheckpoint, recordID string, events []sessrepo.EventSummary) (map[string]bool, error) {
   710		byID := make(map[string]sessrepo.EventSummary, len(events))
   711		for _, summary := range events {
   712			byID[summary.EventID] = summary
   713		}
   714		closure := make(map[string]bool, len(events))
   715		stack := append([]string(nil), checkpoint.EventHeads...)
   716		for len(stack) > 0 {
   717			id := stack[len(stack)-1]
   718			stack = stack[:len(stack)-1]
   719			if closure[id] {
   720				continue
   721			}
   722			summary, ok := byID[id]
   723			if !ok {
   724				if id == recordID {
   725					continue
   726				}
   727				return nil, fmt.Errorf("%w: validated checkpoint %s profile closure names unknown event %s for session %s", sessstate.ErrIntegrity, checkpoint.Digest, id, checkpoint.SessionID)
   728			}
   729			closure[id] = true
   730			stack = append(stack, summary.Predecessors...)
   731		}
   732		return closure, nil
   733	}
   734	
   735	// profilePair is one decoded Section 2.4 pair from a launch or
   736	// resume event payload.
   737	type profilePair struct {
   738		profile   string
   739		source    string
   740		hasSource bool
   741	}
   742	
   743	// eventProfilePair decodes the pair from one chained launch or
   744	// resume event. Chained bytes passed the closed payload shape at
   745	// append time, so a member that no longer decodes contradicts the
   746	// attested chain (integrity failure).
   747	func eventProfilePair(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (profilePair, error) {
   748		var pair profilePair
   749		payload, err := eventPayloadMembers(checkpoint, repo, summary)
   750		if err != nil {
   751			return pair, err
   752		}
   753		profile, err := leaseStringMember(payload, "execution_profile")
   754		if err != nil || (profile != "standard" && profile != "yolo") {
   755			return pair, fmt.Errorf("%w: session %s event %s carries no valid execution profile for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)
   756		}
   757		source, hasSource, err := leaseNullableDigest(payload, "profile_source_event_id")
   758		if err != nil {
   759			return pair, fmt.Errorf("%w: session %s event %s carries no valid profile source for profile authority: %v", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, err)
   760		}
   760		}
   761		return profilePair{profile: profile, source: source, hasSource: hasSource}, nil
   762	}
   763	
   764	// eventProfileTarget decodes the target profile of one chained
   765	// profile.changed event. Only the target feeds the derivation: the
   766	// source value and the confirmation history belong to the
   767	// publication flow that admitted the event, never to this
   768	// admission.
   769	func eventProfileTarget(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (string, error) {
   770		payload, err := eventPayloadMembers(checkpoint, repo, summary)
   771		if err != nil {
   772			return "", err
   773		}
   774		target, err := leaseStringMember(payload, "to")
   775		if err != nil || (target != "standard" && target != "yolo") {
   776			return "", fmt.Errorf("%w: session %s event %s carries no valid profile target for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)
   777		}
   778		return target, nil
   779	}
   780	
   781	// eventPayloadMembers returns the decoded payload object of one
   782	// chained event. A failed blob read keeps its cause inside the
   783	// incomplete-authority refusal; bytes that no longer decode
   784	// contradict the attested chain.
   785	func eventPayloadMembers(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (map[string]json.RawMessage, error) {
   786		raw, err := repo.GetEvent(checkpoint.SessionID, summary.EventID)
   787		if err != nil {
   788			return nil, fmt.Errorf("%w: validated checkpoint %s profile authority for session %s cannot be established: %v", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)
   789		}
   790		members, fault := environ.DecodeStrictObject(raw)
   791		if fault != nil {
   792			return nil, fmt.Errorf("%w: session %s event %s carries no decodable event frame for profile authority: %v", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, fault)
   793		}
   794		payloadRaw, ok := members["payload"]
   795		if !ok || string(payloadRaw) == "null" {
   796			return nil, fmt.Errorf("%w: session %s event %s carries no payload for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)
   797		}
   798		payload, fault := environ.DecodeStrictObject([]byte(payloadRaw))
   799		if fault != nil {
   800			return nil, fmt.Errorf("%w: session %s event %s carries no decodable payload for profile authority: %v", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, fault)
   801		}
   802		return payload, nil
   803	}
   804	
   805	// checkClosureProfilePairs walks the closure in authoritative chain
   806	// order and binds every launch, resume, and fork pair to its
   807	// Section 2.4 derivation: the first launch carries the creation
   808	// profile with a null source, and every later launch carries the
   809	// newest authoritative profile.changed event at or before it with
   810	// that change's target profile (the creation pair while no change
   811	// exists). Every resume carries the effective pair of its own
   812	// referenced checkpoint (referencedCheckpointProfile), never the
   813	// outer-walk prefix. Every fork carries the newly persisted
   814	// Session Record profile with a null source: the fork event lives
   815	// in the new session chain, so creation here is already the new
   816	// record; its source_profile_event_id provenance is never read.
   817	// Each pair mismatch, each unexpected or missing source, and each
   818	// source that fails the governing-closure resolution below refuses
   819	// integrity failure.
   820	func checkClosureProfilePairs(checkpoint validatedCheckpoint, creation, recordID string, events []sessrepo.EventSummary, closure map[string]bool, checkpoints map[string]validatedCheckpoint, repo *sessrepo.Repository, chain []validatedLease, sessionKind string) error {
   821		byID := make(map[string]sessrepo.EventSummary, len(events))
   822		for _, summary := range events {
   823			byID[summary.EventID] = summary
   824		}
   825		newestSource, newestProfile := "", ""
   826		hasNewest := false
   827		firstLaunch := true
   828		for _, summary := range events {
   829			if !closure[summary.EventID] {
   830				continue
   831			}
   832			switch summary.EventType {
   833			case "profile.changed":
   834				target, err := eventProfileTarget(checkpoint, repo, summary)
   835				if err != nil {
   836					return err
   837				}
   838				newestSource, newestProfile, hasNewest = summary.EventID, target, true
   839			case "provider.launched", "task_board.launched":
   840				pair, err := eventProfilePair(checkpoint, repo, summary)
   841				if err != nil {
   842					return err
   843				}
   844				wantProfile, wantSource, wantHasSource := creation, "", false
   845				if !firstLaunch && hasNewest {
   846					wantProfile, wantSource, wantHasSource = newestProfile, newestSource, true
   847				}
   848				if err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil {
   849					return err
   850				}
   851				firstLaunch = false
   852			case "session.resumed":
   853				pair, err := eventProfilePair(checkpoint, repo, summary)
   854				if err != nil {
   855					return err
   856				}
   857				wantProfile, wantSource, wantHasSource, refClosure, err := referencedCheckpointProfile(checkpoint, summary, creation, recordID, events, checkpoints, repo, chain, sessionKind)
   858				if err != nil {
   859					return err
   860				}
   861				if err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, refClosure); err != nil {
   862					return err
   863				}
   864			case "fork.created":
   865				pair, err := eventProfilePair(checkpoint, repo, summary)
   866				if err != nil {
   867					return err
   868				}
   869				if err := checkProfilePairSource(checkpoint, summary, pair, creation, "", false, byID, closure); err != nil {
   870					return err
   871				}
   872			}
   873		}
   874		return nil
   875	}
   876	
   877	// checkReferencedCheckpointBinding admits one resume-referenced
   878	// Checkpoint Record through the same semantic owner the winner and
   879	// necessary-ancestor checkpoints use. The owning lease is resolved
   880	// by (epoch, lease_id) tuple within the winning ancestry chain for
   881	// the session; historical leases stay admissible because the chain
   882	// covers every epoch from the winner down to the root, while a
   883	// fencing token without an admitted owning lease at that epoch is
   884	// incomplete authority. The creator must be that lease's holder,
   885	// the persistence variant must match the Session Record kind, and
   886	// every head must resolve at or before the owning lease in the
   887	// winning source chain, all through the shared helpers. A missing,
   888	// misbound, or unresolvable reference refuses
   889	// observation_unavailable, never a minted fact.
   890	func checkReferencedCheckpointBinding(ref validatedCheckpoint, checkpointID, sessionID, sessionKind string, chain []validatedLease, repo *sessrepo.Repository) error {
   891		var owner validatedLease
   892		found := false
   893		for _, lease := range chain {
   894			if lease.SessionID == ref.SessionID && lease.Epoch == ref.LeaseEpoch && lease.LeaseID == ref.LeaseID {
   895				owner = lease
   896				found = true
   897				break
   898			}
   899		}
   900		if !found {
   901			return fmt.Errorf("%w: validated checkpoint %s is bound to lease %s at epoch %d without an admitted owning lease", ErrObservationUnavailable, checkpointID, ref.LeaseID, ref.LeaseEpoch)
   902		}
   903		if ref.CreatorHostID != owner.HolderHostID {
   904			return fmt.Errorf("%w: validated checkpoint %s is created by host %s, want owning lease holder %s", ErrObservationUnavailable, checkpointID, ref.CreatorHostID, owner.HolderHostID)
   905		}
   906		if err := checkCheckpointPersistence(ref, sessionID, sessionKind); err != nil {
   907			return err
   908		}
   909		if err := checkCheckpointEventHeads(ref, owner, repo); err != nil {
   910			return err
   911		}
   912		return nil
   913	}
   914	
   915	// referencedCheckpointProfile derives the Section 2.4 effective
   916	// pair one session.resumed event must carry (SPEC 5.2): the newest
   917	// authoritative profile.changed event in its referenced
   918	// checkpoint's own event-head closure with that change's target
   919	// profile, or the creation pair while that closure holds no
   920	// change. The checkpoint_id member resolves through the admitted
   921	// Checkpoint Records and is admitted through the shared semantic
   922	// owner (checkReferencedCheckpointBinding) before its closure is
   923	// consumed; the closure walks the same winning-source chain index,
   924	// so a later local-only change outside the referenced heads is
   925	// never consulted and branching history stays admissible. A
   926	// missing, wrong-session, wrong-lease, wrong-creator,
   927	// wrong-variant, or unresolvable-head reference is incomplete
   928	// referenced authority (observation_unavailable); a dangling
   929	// predecessor inside the referenced closure or a pair the closure
   930	// contradicts refuses integrity failure. Read failures keep their
   931	// cause inside the incomplete-authority refusal.
   932	func referencedCheckpointProfile(checkpoint validatedCheckpoint, summary sessrepo.EventSummary, creation, recordID string, events []sessrepo.EventSummary, checkpoints map[string]validatedCheckpoint, repo *sessrepo.Repository, chain []validatedLease, sessionKind string) (string, string, bool, map[string]bool, error) {
   933		payload, err := eventPayloadMembers(checkpoint, repo, summary)
   934		if err != nil {
   935			return "", "", false, nil, err
   936		}
   937		rawID, err := leaseStringMember(payload, "checkpoint_id")
   938		if err != nil {
   939			return "", "", false, nil, fmt.Errorf("%w: session %s event %s carries no valid resume checkpoint for profile authority: %v", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, err)
   940		}
   941		reference, err := scalar.ParseDigest(rawID)
   942		if err != nil {
   943			return "", "", false, nil, fmt.Errorf("%w: session %s event %s carries malformed resume checkpoint %q for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, rawID)
   944		}
   945		checkpointID := reference.String()
   946		ref, ok := checkpoints[checkpointID]
   947		if !ok {
   948			return "", "", false, nil, fmt.Errorf("%w: validated checkpoint %s for session %s cannot be established", ErrObservationUnavailable, checkpointID, checkpoint.SessionID)
   949		}
   950		if ref.SessionID != checkpoint.SessionID {
   951			return "", "", false, nil, fmt.Errorf("%w: validated checkpoint %s carries session %s, want %s", ErrObservationUnavailable, checkpointID, ref.SessionID, checkpoint.SessionID)
   952		}
   953		if err := checkReferencedCheckpointBinding(ref, checkpointID, checkpoint.SessionID, sessionKind, chain, repo); err != nil {
   954			return "", "", false, nil, err
   955		}
   956		refClosure, err := profileClosure(ref, recordID, events)
   957		if err != nil {
   958			return "", "", false, nil, err
   959		}
   960		refSource, refProfile := "", ""
   961		refHas := false
   962		for _, candidate := range events {
   963			if !refClosure[candidate.EventID] {
   964				continue
   965			}
   966			if candidate.EventType != "profile.changed" {
   967				continue
   968			}
   969			target, err := eventProfileTarget(checkpoint, repo, candidate)
   970			if err != nil {
   971				return "", "", false, nil, err
   972			}
   973			refSource, refProfile, refHas = candidate.EventID, target, true
   974		}
   975		if !refHas {
   976			return creation, "", false, refClosure, nil
   977		}
   978		return refProfile, refSource, true, refClosure, nil
   979	}
   980	
   981	// checkProfilePairSource binds one decoded pair to its derived
   982	// expectation. The profile value must equal the derived effective
   983	// profile, so falling back to the creation value past a change
   984	// refuses; the source presence must match, so a first launch with
   985	// any source refuses; and a present source must resolve to the
   986	// newest authoritative profile.changed event in the closure —
   987	// missing, out-of-closure (later local-only or losing-lease),
   988	// wrong-type, and non-newest references each refuse with the
   989	// violated expectation named.
   990	func checkProfilePairSource(checkpoint validatedCheckpoint, summary sessrepo.EventSummary, pair profilePair, wantProfile, wantSource string, wantHasSource bool, byID map[string]sessrepo.EventSummary, closure map[string]bool) error {
   991		if pair.profile != wantProfile {
   992			return fmt.Errorf("%w: session %s event %s carries execution profile %q, want effective profile %q for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.profile, wantProfile)
   993		}
   994		if pair.hasSource != wantHasSource {
   995			if pair.hasSource {
   996				return fmt.Errorf("%w: session %s event %s carries profile source %s, want no profile source for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)
   997			}
   998			return fmt.Errorf("%w: session %s event %s carries no profile source, want newest authoritative source %s for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, wantSource)
   999		}
  1000		if !wantHasSource {
  1001			return nil
  1002		}
  1003		sourced, ok := byID[pair.source]
  1004		if !ok {
  1005			return fmt.Errorf("%w: session %s event %s names unknown profile source %s for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)
  1006		}
  1007		if !closure[pair.source] {
  1008			return fmt.Errorf("%w: session %s event %s names profile source %s outside the checkpoint closure for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)
  1009		}
  1010		if sourced.EventType != "profile.changed" {
  1011			return fmt.Errorf("%w: session %s event %s names profile source %s of type %q, want a profile.changed event for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, sourced.EventType)
  1012		}
  1013		if pair.source != wantSource {
  1014			return fmt.Errorf("%w: session %s event %s names profile source %s, want newest authoritative source %s for profile authority", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, wantSource)
  1015		}
  1016		return nil
  1017	}
  1018	
  1019	// checkCheckpointPersistence binds an admitted Checkpoint Record to
  1020	// the persistence variant the referenced Session Record selects
  1021	// (Section 5.4): a direct session requires a non-null
  1022	// provider_manifest_id with a null task_board_bundle_id, while a
  1023	// task_board session requires the reverse. Canonical shape proves
  1024	// exactly one variant is present but cannot select which one is
  1025	// valid, so a swapped variant keeps canonical identity, session,
  1026	// lease, epoch, and creator yet refuses here with incomplete
  1027	// authority (observation_unavailable), never absence or a minted
  1028	// fact. An unknown session kind is malformed configuration: valid
  1029	// Session Records admit only the two kinds.
  1030	func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {
  1031		switch sessionKind {
  1032		case "direct":
  1033			if !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {
  1034				return fmt.Errorf("%w: validated checkpoint %s carries a task-board persistence variant for direct session %s", ErrObservationUnavailable, checkpoint.Digest, sessionID)
  1035			}
  1036			return nil
  1037		case "task_board":
  1038			if checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {
  1039				return fmt.Errorf("%w: validated checkpoint %s carries a provider persistence variant for task_board session %s", ErrObservationUnavailable, checkpoint.Digest, sessionID)
  1040			}

diff --git a/internal/sessquery/rev11_regression_test.go b/internal/sessquery/rev11_regression_test.go
index ac18b0474e1f15b6bb690fecd1bfa9f6f1f5a73d..f25bcec7c2e65fdedd85c02c95abe7caf69c9131
