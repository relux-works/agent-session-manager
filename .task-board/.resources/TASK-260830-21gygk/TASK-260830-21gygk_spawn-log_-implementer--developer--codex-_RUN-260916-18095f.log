+	"checkReferencedCheckpointBinding":  true,
+	"checkReferencedCheckpointTemporal": true,
+	"admitCheckpoint":                   true,
+	"checkCheckpointEventHeads":         true,
+	"checkCheckpointPersistence":        true,
+}
