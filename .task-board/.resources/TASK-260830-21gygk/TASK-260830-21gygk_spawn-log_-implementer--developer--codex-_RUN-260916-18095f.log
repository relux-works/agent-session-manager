}

// TestRev11RecordConsumptionCensus is the call-graph gate for the
// record-consumption table: every record the shared profile owner
// consumes must pass its semantic admission owner before its bytes
// are derived. It parses the shipped lease.go and requires that the
// resume path calls the shared referenced admission owner, that the
// owner calls the shared persistence and head helpers, that the
// outer walk calls the resume derivation, and that admission runs
// before closure derivation in source order. A token-preserving
// narrowing mutant keeps these call tokens while admitting one
// invalid member, so this static gate alone never proves the
// behavior; the TestReview10/TestRev11 behavioral suites must fail.
func TestRev11RecordConsumptionCensus(t *testing.T) {
	_, file, _, ok := runtime.Caller(0)
	if !ok {
		t.Fatal("cannot locate test file")
	}
	leasePath := filepath.Join(filepath.Dir(file), "lease.go")
	src, err := os.ReadFile(leasePath)
	if err != nil {
		t.Fatal(err)
	}
	fset := token.NewFileSet()
	parsed, err := parser.ParseFile(fset, leasePath, src, 0)
	if err != nil {
		t.Fatal(err)
	}
	callsOf := func(funcName string) map[string][]token.Pos {
		out := map[string][]token.Pos{}
		for _, decl := range parsed.Decls {
			fn, ok := decl.(*ast.FuncDecl)
			if !ok || fn.Name.Name != funcName || fn.Body == nil {
				continue
			}
			ast.Inspect(fn.Body, func(n ast.Node) bool {
				call, ok := n.(*ast.CallExpr)
				if !ok {
					return true
				}
				var name string
				switch fun := call.Fun.(type) {
				case *ast.Ident:
					name = fun.Name
				case *ast.SelectorExpr:
					name = fun.Sel.Name
				}
				if name != "" {
					out[name] = append(out[name], call.Pos())
				}
				return true
			})
		}
		return out
	}
	requireCall := func(caller, callee string) {
		t.Helper()
		calls := callsOf(caller)
		if len(calls[callee]) == 0 {
			t.Errorf("%s must call shared admission owner %s", caller, callee)
		}
	}
	requireCall("checkClosureProfilePairs", "referencedCheckpointProfile")
	requireCall("referencedCheckpointProfile", "checkReferencedCheckpointBinding")
	requireCall("checkReferencedCheckpointBinding", "checkCheckpointPersistence")
	requireCall("checkReferencedCheckpointBinding", "checkCheckpointEventHeads")
	requireCall("checkWinnerCheckpoint", "checkCheckpointProfileAuthority")
	requireCall("checkCheckpointBinding", "checkCheckpointProfileAuthority")
	requireCall("checkCheckpointProfileAuthority", "checkClosureProfilePairs")
	// Admission must precede derivation in source order: the
	// referenced binding call must appear before the referenced
	// closure derivation in the same function body.
	derived := callsOf("referencedCheckpointProfile")
	admitPos := derived["checkReferencedCheckpointBinding"]
	closurePos := derived["profileClosure"]
	if len(admitPos) > 0 && len(closurePos) > 0 {
		if fset.Position(admitPos[0]).Line > fset.Position(closurePos[0]).Line {
			t.Errorf("referencedCheckpointProfile must admit before deriving: binding at line %d, closure at line %d",
				fset.Position(admitPos[0]).Line, fset.Position(closurePos[0]).Line)
		}
	} else {
		if len(admitPos) == 0 {
			t.Errorf("referencedCheckpointProfile must call checkReferencedCheckpointBinding before profileClosure")
		}
		if len(closurePos) == 0 {
			t.Errorf("referencedCheckpointProfile must derive via profileClosure after admission")
		}
	}
}

