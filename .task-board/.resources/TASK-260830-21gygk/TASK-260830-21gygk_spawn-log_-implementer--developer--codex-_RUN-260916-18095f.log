+	tail := appendEventAs(t, local, idA, announcedB, "lease.transferred", 1, 2, leaseB, map[string]any{
+		"operation_id":         hostB,
+		"from_host_id":         hostA,
+		"to_host_id":           hostA,
+		"predecessor_lease_id": lease,
+		"new_lease_id":         leaseB,
