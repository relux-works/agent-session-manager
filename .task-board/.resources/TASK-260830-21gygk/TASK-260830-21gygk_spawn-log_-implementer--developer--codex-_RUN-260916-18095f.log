   304	// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease
   305	// Record for one session and validates its succession: the
   306	// predecessor ancestry must chain by epoch plus one down to an
   307	// epoch-1 root, and every lease in that winning ancestry above
   308	// epoch 1 must reference a validated checkpoint for its session and
   309	// predecessor lease (Section 5.3), each created by the owning lease
   310	// holder (Section 5.4). Every required checkpoint must additionally
   311	// carry the persistence variant the referenced Session Record
   312	// selects: sessionKind is that record's kind as projected from the
   313	// winning source, and a variant mismatch refuses
   314	// observation_unavailable even when canonical identity, session,
   315	// lease, epoch, and creator all agree. Every required checkpoint
   316	// must also resolve each event head to a chained event for its
   317	// session at or before its bound lease in the winning source chain
   318	// (repo, Section 5.4 event-head closure): a head naming an absent
   319	// event or an event under a later lease cannot establish current
   320	// complete authority, so it refuses observation_unavailable;
   321	// historical heads stay admissible and are never required to equal
   322	// the current tail. Every required checkpoint must also admit its
   323	// Section 2.4 profile authority over the same closure
   324	// (checkCheckpointProfileAuthority): a first launch outside the
   325	// creation pair, a later launch outside the newest authoritative
   326	// change at or before it, a resume outside its referenced
   327	// checkpoint's closure pair, or a fork outside the new record
   328	// pair, contradicts the admitted history (integrity failure).
   329	// Absence refuses observation_unavailable; a
   330	// lease above epoch 1 without its named predecessor in the admitted
   331	// set refuses the same class rather than binding a dangling
   332	// successor, while an illegal predecessor link is malformed
   333	// authority (integrity failure).
   334	func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {
   335		if sessionKind != "direct" && sessionKind != "task_board" {
   336			return validatedLease{}, fmt.Errorf("%w: session %s carries unknown kind %q for checkpoint persistence", ErrInvalidConfig, sessionID, sessionKind)
   337		}
   338		bySession, err := reader.validatedLeasesBySession()
   339		if err != nil {
   340			return validatedLease{}, err
   341		}
   342		candidates := bySession[sessionID]
   343		if len(candidates) == 0 {
   344			return validatedLease{}, fmt.Errorf("%w: winning lease record for session %s cannot be established", ErrObservationUnavailable, sessionID)
   345		}
   346		winner := candidates[0]
   347		for _, candidate := range candidates[1:] {
   348			if sessstate.Compare(
   349				sessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},
   350				sessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},
   351			) > 0 {
   352				winner = candidate
   353			}
   354		}
   355		chain, predecessor, err := checkLeaseChain(candidates, winner)
   356		if err != nil {
   357			return validatedLease{}, err
   358		}
   359		if err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo, chain); err != nil {
   360			return validatedLease{}, err
   361		}
   362		if err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {
   363			return validatedLease{}, err
   364		}
   365		return winner, nil
   366	}
