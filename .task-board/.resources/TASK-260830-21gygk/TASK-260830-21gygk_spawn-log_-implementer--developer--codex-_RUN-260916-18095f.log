+						if err := json.Unmarshal(raw, &value); err != nil {
+							t.Fatal(err)
+						}
+						if cp, ok := value["checkpoint_id"].(string); ok {
+							if next, ok := replacements[cp]; ok {
+								r.LeaseRecords[i] = rev7Replace(t, raw, "record_id", map[string]any{"checkpoint_id": next})
+							}
+						}
