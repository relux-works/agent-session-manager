   143	func TestReview10ReferencedCheckpointAdmission(t *testing.T) {
   144		for _, kind := range []string{"direct", "task_board"} {
   145			for _, ancestor := range []bool{false, true} {
   146				for _, mode := range []string{"good", "wrong_creator", "wrong_variant", "wrong_lease"} {
   147					t.Run(fmt.Sprintf("%s/ancestor=%t/%s", kind, ancestor, mode), func(t *testing.T) {
   148						r := review10ReferenceFixture(t, kind, ancestor, mode)
   149						if mode == "good" {
   150							rev7CheckEntries(t, r, false)
   151							return
   152						}
   153						// Bind an old plan before the admitting closure reaches the resume.
   154						originalCP := append([][]byte(nil), r.CheckpointRecords...)
   155						originalLeases := append([][]byte(nil), r.LeaseRecords...)
   156						events, err := r.Local.ListEvents(idA)
   157						if err != nil {
   158							t.Fatal(err)
   159						}
   160						head := ""
   161						for _, e := range events {
   162							if e.EventType == "session.stopped" {
   163								head = e.EventID
   164								break
   165							}
   166						}
   167						replacements := map[string]string{}
   168						for i, cp := range r.CheckpointRecords {
   169							if i == 1 {
   170								continue
   171							}
   172							oldID := checkpointDigestOf(t, cp)
   173							narrow := rev7Replace(t, cp, "checkpoint_id", map[string]any{"event_heads": []string{head}})
   174							r.CheckpointRecords[i] = narrow
   175							replacements[oldID] = checkpointDigestOf(t, narrow)
   176						}
   177						for i, raw := range r.LeaseRecords {
   178							var v map[string]any
   179							if err := json.Unmarshal(raw, &v); err != nil {
   180								t.Fatal(err)
   181							}
   182							if cp, ok := v["checkpoint_id"].(string); ok {
   183								if next, ok := replacements[cp]; ok {
   184									r.LeaseRecords[i] = rev7Replace(t, raw, "record_id", map[string]any{"checkpoint_id": next})
   185								}
   186							}
   187						}
   188						rev7CheckEntries(t, r, false)
   189						old := mustBuild(t, r, PlanArgs{Selector: "alpha", Action: ActionStatus})
   190						r.CheckpointRecords = originalCP
   191						r.LeaseRecords = originalLeases
   192						t.Logf("old-plan Revalidate: %v", r.Revalidate(old))
   193						rev7CheckEntries(t, r, true)
   194					})
   195				}
   196			}
   197		}
