     2	
     3	import (
     4		"bytes"
     5		"encoding/json"
     6		"errors"
     7		"fmt"
     8		"io"
     9		"os"
    10		"path/filepath"
    11	
    12		"github.com/relux-works/agent-session-manager/internal/canonicaljson"
    13		"github.com/relux-works/agent-session-manager/internal/environ"
    14		"github.com/relux-works/agent-session-manager/internal/scalar"
    15	)
    16	
    17	// sessionRecord is the validated identity of one Session Record: the exact
    18	// bytes plus the members the repository must bind (SPEC.md Section 5.1).
    19	type sessionRecord struct {
    20		raw       []byte
    21		recordID  string
    22		sessionID string
    23		name      string
    24		kind      string
    25		provider  string
    26	}
    27	
    28	// eventView is the validated routing surface of one Session Event: the
    29	// exact bytes plus the members the chain rules must read (SPEC.md 5.2).
    30	type eventView struct {
    31		raw          []byte
    32		eventID      string
    33		eventType    string
    34		sessionID    string
    35		leaseEpoch   uint64
    36		leaseID      string
    37		leaseSeq     uint64
    38		predecessors []string
    39	}
    40	
    41	// storedChain is the chain index: the record digest plus one entry per
    42	// chained event in authoritative order. The blobs are truth; the index is
    43	// a verified cache rebound to them on every load.
    44	type storedChain struct {
    45		RecordID string
    46		Events   []EventSummary
    47	}
    48	
    49	// sessionView is one loaded session: record, index, directory, and name facts.
    50	type sessionView struct {
    51		directory string
    52		record    sessionRecord
    53		chain     storedChain
    54	}
    55	
    56	// decodeSessionRecord runs the three validation layers in order: strict
    57	// frame (environ owner), member shape, then canonical identity and closed
    58	// shape (canonicaljson owner). Each layer refuses before the next runs,
    59	// so every site below is reachable with a vector that clears the earlier
    60	// layers and fails exactly this one.
    61	func decodeSessionRecord(raw []byte) (sessionRecord, error) {
    62		members, fault := environ.DecodeStrictObject(raw)
    63		if fault != nil {
    64			return sessionRecord{}, refuse(ErrInvalidRecord, "decode session record frame: %v", fault)
    65		}
    66		if schema, err := stringMember(members, "schema"); err != nil || schema != sessionRecordSchema {
    67			return sessionRecord{}, refuse(ErrInvalidRecord, "session record schema %q, want %q", schema, sessionRecordSchema)
    68		}
    69		sessionID, ok := environ.CheckUUIDv7(memberRaw(members, "session_id"))
    70		if !ok {
    71			return sessionRecord{}, refuse(ErrInvalidRecord, "session record carries no valid session_id member")
    72		}
    73		digest, field, err := canonicaljson.VerifyObjectIdentity(raw)
    74		if err != nil {
    75			return sessionRecord{}, refuse(ErrInvalidRecord, "verify session record identity: %v", err)
    76		}
    77		if field != canonicaljson.SelfRecordID {
    78			return sessionRecord{}, fmt.Errorf("session record identity field %q, want record_id", string(field))
    79		}
    80		name, _ := stringMember(members, "name")
    81		kind, _ := stringMember(members, "kind")
    82		provider, _ := stringMember(members, "provider_id")
    83		return sessionRecord{raw: raw, recordID: digest.String(), sessionID: sessionID.String(), name: name, kind: kind, provider: provider}, nil
    84	}
    85	
    86	// decodeSessionEvent runs the same three layers for Session Events: strict
    87	// frame, member shape, then canonical identity and closed payload shape.
    88	func decodeSessionEvent(raw []byte) (eventView, error) {
    89		members, fault := environ.DecodeStrictObject(raw)
    90		if fault != nil {
    91			return eventView{}, refuse(ErrInvalidEvent, "decode session event frame: %v", fault)
    92		}
    93		if schema, err := stringMember(members, "schema"); err != nil || schema != sessionEventSchema {
    94			return eventView{}, refuse(ErrInvalidEvent, "session event schema %q, want %q", schema, sessionEventSchema)
    95		}
    96		event, err := extractEventMembers(members)
    97		if err != nil {
    98			return eventView{}, refuse(ErrInvalidEvent, "session event member: %v", err)
    99		}
   100		digest, field, err := canonicaljson.VerifyObjectIdentity(raw)
   101		if err != nil {
   102			return eventView{}, refuse(ErrInvalidEvent, "verify session event identity: %v", err)
   103		}
   104		if field != canonicaljson.SelfEventID {
   105			return eventView{}, fmt.Errorf("session event identity field %q, want event_id", string(field))
   106		}
   107		event.raw = raw
   108		event.eventID = digest.String()
   109		return event, nil
   110	}
   111	
   112	// extractEventMembers reads the routing members after the frame gate. It
   113	// returns plain errors; the caller attributes them through its one member
   114	// site. Grammar and range rules stay with their owners: UUIDv7 and uint53
   115	// with environ, digests and UUIDv4 with scalar.
   116	func extractEventMembers(members map[string]json.RawMessage) (eventView, error) {
   117		var event eventView
   118		sessionID, ok := environ.CheckUUIDv7(memberRaw(members, "session_id"))
   119		if !ok {
   120			return eventView{}, fmt.Errorf("member %q is not a UUIDv7", "session_id")
   121		}
   122		event.sessionID = sessionID.String()
   123		eventType, err := stringMember(members, "event_type")
   124		if err != nil {
   125			return eventView{}, err
   126		}
   127		event.eventType = eventType
   128		epoch, ok := environ.CheckUint53Bounds(memberRaw(members, "lease_epoch"), 1, uint53Max)
   129		if !ok {
   130			return eventView{}, fmt.Errorf("member %q is not a uint53 at or above 1", "lease_epoch")
   131		}
   132		event.leaseEpoch = epoch
   133		leaseID, err := stringMember(members, "lease_id")
   134		if err != nil {
   135			return eventView{}, err
   136		}
   137		if _, err := scalar.ParseUUIDv4(leaseID); err != nil {
   138			return eventView{}, fmt.Errorf("member %q is not a UUIDv4: %v", "lease_id", err)
   139		}
   140		event.leaseID = leaseID
   141		sequence, ok := environ.CheckUint53Bounds(memberRaw(members, "lease_sequence"), 1, uint53Max)
   142		if !ok {
   143			return eventView{}, fmt.Errorf("member %q is not a uint53 at or above 1", "lease_sequence")
   144		}
   145		event.leaseSeq = sequence
   146		predecessors, err := digestMembers(members, "predecessors")
   147		if err != nil {
   148			return eventView{}, err
   149		}
   150		if len(predecessors) == 0 {
   151			return eventView{}, fmt.Errorf("member %q names no predecessor", "predecessors")
   152		}
   153		event.predecessors = predecessors
   154		return event, nil
   155	}
   156	
   157	// checkAppend enforces the SPEC.md Section 5.2 chain rules for one event
   158	// against the record and the current tail: the first event links exactly
   159	// the Session Record at sequence 1 with no gap; within one lease the
   160	// sequence increases by exactly one with no repeat and each event
   161	// references the immediately prior authoritative event; a successor lease
   162	// restarts at 1 referencing the predecessor head; a same-epoch second
   163	// lease diverges and a lower epoch is stale. The reload audit folds this
   164	// same check over the stored index, so weakening any arm breaks both the
   165	// append and the reload evidence.
   166	func checkAppend(recordID string, tail *EventSummary, event eventView) error {
   167		if tail != nil && event.leaseID != tail.LeaseID {
   168			if event.leaseEpoch < tail.LeaseEpoch {
   169				return refuse(ErrStaleLease, "event lease epoch %d precedes chain head epoch %d", event.leaseEpoch, tail.LeaseEpoch)
   170			}
   171			if event.leaseEpoch == tail.LeaseEpoch {
   172				return refuse(ErrDivergentBranch, "event under lease %s diverges from chain head lease %s at epoch %d", event.leaseID, tail.LeaseID, tail.LeaseEpoch)
   173			}
   174		}
   175		want := uint64(1)
   176		if tail != nil && event.leaseID == tail.LeaseID {
   177			want = tail.LeaseSequence + 1
   178		}
   179		if event.leaseSeq < want {
   180			return refuse(ErrSequenceRepeat, "event lease sequence %d repeats chained sequence through %d", event.leaseSeq, want-1)
   181		}
   182		if event.leaseSeq > want {
   183			return refuse(ErrSequenceGap, "event lease sequence %d skips chained sequence %d", event.leaseSeq, want)
   184		}
   185		if tail == nil {
   186			if len(event.predecessors) != 1 || event.predecessors[0] != recordID {
   187				return refuse(ErrPredecessorLink, "first event must link exactly the session record")
   188			}
   189			return nil
   190		}
   191		if !containsDigest(event.predecessors, tail.EventID) {
   192			return refuse(ErrPredecessorLink, "event predecessors omit prior authoritative event")
   193		}
   194		return nil
   195	}
   196	
   197	func containsDigest(haystack []string, needle string) bool {
   198		for _, candidate := range haystack {
   199			if candidate == needle {
   200				return true
   201			}
   202		}
   203		return false
   204	}
   205	
   206	// memberRaw reports the raw member for the environ bound checkers. A
   207	// missing member yields nil, which every checker refuses.
   208	func memberRaw(members map[string]json.RawMessage, name string) json.RawMessage {
   209		return members[name]
   210	}
   211	
   212	// stringMember reads one string member with the language decoder. Grammar
   213	// rules for the value stay with the shape owner; this only accesses it.
   214	func stringMember(members map[string]json.RawMessage, name string) (string, error) {
   215		raw, ok := members[name]
   216		if !ok {
   217			return "", fmt.Errorf("member %q is absent", name)
   218		}
   219		var value string
   220		if err := json.Unmarshal(raw, &value); err != nil {
   221			return "", fmt.Errorf("member %q is not a string: %v", name, err)
   222		}
   223		return value, nil
   224	}
   225	
   226	// digestMembers reads one array of digest strings. Digest grammar stays
   227	// with the scalar owner.
   228	func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {
   229		raw, ok := members[name]
   230		if !ok {
   231			return nil, fmt.Errorf("member %q is absent", name)
   232		}
   233		var values []string
   234		if err := json.Unmarshal(raw, &values); err != nil {
   235			return nil, fmt.Errorf("member %q is not a string array: %v", name, err)
   236		}
   237		for _, value := range values {
   238			if _, err := scalar.ParseDigest(value); err != nil {
   239				return nil, fmt.Errorf("member %q holds malformed digest %q: %v", name, value, err)
   240			}
   241		}
   242		return values, nil
   243	}
   244	
   245	// sessionDir joins a caller-supplied session ID with no grammar check: a
   246	// traversal ID escapes the sessions root, and the escape refuses at load
   247	// time through the record/session binding, which it can never satisfy.
   248	func (repository *Repository) sessionDir(sessionID string) string {
   249		return filepath.Join(repository.root, sessionID)
   250	}
   251	
   252	// loadSessionLocked loads and fully re-verifies one session: the chain
   253	// index decodes, the record bytes re-verify against the indexed digest,
   254	// every indexed event blob re-verifies, and the index folds clean through
   255	// the append rules. Callers hold the repository mutex.
   256	func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {
   257		directory := repository.sessionDir(sessionID)
   258		if _, err := os.Stat(directory); err != nil {
   259			return nil, refuse(ErrUnknownSession, "unknown session %s", sessionID)
   260		}
     1	package sessrepo
     2	
     3	import (
     4		"bytes"
     5		"errors"
     6		"fmt"
     7		"os"
     8		"path/filepath"
     9		"sync"
    10	)
    11	
    12	// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6. It is
    13	// passed to the environ bound checker, never re-enforced here.
    14	const uint53Max = uint64(1<<53 - 1)
    15	
    16	const (
    17		sessionRecordSchema = "urn:ax:schema:session-record"
    18		sessionEventSchema  = "urn:ax:schema:session-event"
    19	)
    20	
    21	var (
    22		ErrInvalidRecord   = errors.New("invalid session record")
    23		ErrSessionExists   = errors.New("session already exists")
    24		ErrUnknownSession  = errors.New("unknown session")
    25		ErrInvalidEvent    = errors.New("invalid session event")
    26		ErrSequenceGap     = errors.New("event source sequence gap")
    27		ErrSequenceRepeat  = errors.New("event source sequence repeat")
    28		ErrPredecessorLink = errors.New("event predecessor link mismatch")
    29		ErrDivergentBranch = errors.New("divergent lease branch preserved without application")
    30		ErrStaleLease      = errors.New("event lease epoch precedes the chain head")
    31		ErrChainCorrupt    = errors.New("session event chain is corrupt")
    32		ErrUnknownEvent    = errors.New("unknown session event")
    33		ErrNameAmbiguous   = errors.New("name_ambiguous")
    34		ErrNameNotFound    = errors.New("session name not found")
    35		ErrRepositoryPath  = errors.New("invalid session repository path")
    36	)
    37	
    38	// refuse is the single refusal funnel every sessrepo rejection flows
    39	// through. It is a var so the census TestMain can wrap it and record the
    40	// production file:line behind each exercised refusal. No production path
    41	// wraps a sentinel with fmt.Errorf directly.
    42	var refuse = func(sentinel error, format string, arguments ...any) error {
    43		return fmt.Errorf("%w: %s", sentinel, fmt.Sprintf(format, arguments...))
    44	}
    45	
    46	// SessionRef names one persisted session: its Session Record digest and ID.
    47	type SessionRef struct {
    48		SessionID string
    49		RecordID  string
    50	}
    51	
    52	// EventRef names one chained event: its digest, lease sequence, and position.
    53	type EventRef struct {
    54		SessionID     string
    55		EventID       string
    56		LeaseSequence uint64
    57		Position      int
    58	}
    59	
    60	// EventSummary is the chain-index entry for one event, derived from the
    61	// validated event bytes at append time and re-verified against them on load.
    62	type EventSummary struct {
    63		EventID       string   `json:"event_id"`
    64		EventType     string   `json:"event_type"`
    65		LeaseEpoch    uint64   `json:"lease_epoch"`
    66		LeaseID       string   `json:"lease_id"`
    67		LeaseSequence uint64   `json:"lease_sequence"`
    68		Predecessors  []string `json:"predecessors"`
    69	}
    70	
    71	// SessionSummary is the Section 14.4 list projection this leaf owns: stored
    72	// identity plus chain-head facts for a healthy session, or the per-session
    73	// parked channel for an interrupted create or a torn store. Owner host,
    74	// checkpoint age, capability status, and rendered warnings are derived
    75	// downstream, never here; the parked fields below are the facts the
    76	// Section 5.7 reducer and the Section 14.4 rendering leaves project from.
    77	//
    78	// A healthy entry carries Parked=false with empty BlockingReason and
    79	// RetryHint. A parked entry carries Parked=true, SessionID set to the
    80	// session directory name, BlockingReason naming the load failure (a
    81	// recoverable_parked_state block with its per-session cause), and RetryHint
    82	// naming the same-operation retry. Identity members (RecordID, Name, Kind,
    83	// ProviderID) are filled from the parked record when it still verifies;
    84	// a bare directory with no verifiable record leaves them empty.
    85	type SessionSummary struct {
    86		SessionID      string
    87		RecordID       string
    88		Name           string
    89		Kind           string
    90		ProviderID     string
    91		EventCount     int
    92		TailEvent      string
    93		Parked         bool
    94		BlockingReason string
    95		RetryHint      string
    96	}
    97	
    98	// retryHintForParkedRecord names the same-operation retry for a parked
    99	// session: a record is already parked, so only the byte-identical record
   100	// resumes through CreateSession.
   101	const retryHintForParkedRecord = "retry CreateSession with the byte-identical session record"
   102	
   103	// retryHintForBareDirectory names the same-operation retry for a bare
   104	// session directory: no record is parked yet, so CreateSession with the
   105	// session record for this session ID resumes.
   106	const retryHintForBareDirectory = "retry CreateSession with the session record for this session ID"
   107	
   108	// CreateStep names one durable boundary inside CreateSession's four-step
   109	// span: the session directory, the record install, the events directory,
   110	// and the chain index install, in that order.
   111	type CreateStep string
   112	
   113	const (
   114		CreateStepSessionDir CreateStep = "session-dir"
   115		CreateStepRecord     CreateStep = "record"
   116		CreateStepEventsDir  CreateStep = "events-dir"
   117		CreateStepChain      CreateStep = "chain"
   118	)
   119	
   120	// Repository persists Session Records and per-session event chains under
   121	// one data root. All mutating entries serialize on one mutex; files are
   122	// content-addressed and installed no-replace, so the chain is append-only
   123	// by construction and there is no update or delete entry to test.
   124	//
   125	// BeforeWrite fires after validation and before the first durable byte;
   126	// AfterCommit fires after the chain index is durable. AfterCreateStep
   127	// fires after each CreateStep inside CreateSession's four-step span, so
   128	// an interrupted create — not only a fault outside it — is drivable.
   129	// All three are nil in normal operation. Tests connect them to a
   130	// secconftest Injector firing the owner's own points: a fault before
   131	// any durable byte carries safe_retry, and a fault past any durable
   132	// step — including every interior boundary, whose parked state the
   133	// identical retry resumes — carries recoverable_parked_state.
   134	type Repository struct {
   135		root            string
   136		mutex           sync.Mutex
   137		BeforeWrite     func() error
   138		AfterCommit     func() error
   139		AfterCreateStep func(CreateStep) error
   140	}
   141	
   142	// Open binds a repository to the sessions namespace beneath dataRoot,
   143	// creating it owner-only when absent. The root must be absolute.
   144	func Open(dataRoot string) (*Repository, error) {
   145		if !filepath.IsAbs(dataRoot) {
   146			return nil, refuse(ErrRepositoryPath, "data root %q is not absolute", dataRoot)
   147		}
   148		root := filepath.Join(dataRoot, "sessions")
   149		if err := os.MkdirAll(root, 0o700); err != nil {
   150			return nil, refuse(ErrRepositoryPath, "create sessions root %q: %v", root, err)
   151		}
   152		return &Repository{root: root}, nil
   153	}
   154	
   155	// CreateSession validates recordJSON through the canonical owner and
   156	// persists it as a new session. The bytes are stored verbatim.
   157	func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {
   158		record, err := decodeSessionRecord(recordJSON)
   159		if err != nil {
   160			return SessionRef{}, err
   161		}
   162		repository.mutex.Lock()
   163		defer repository.mutex.Unlock()
   164		if repository.BeforeWrite != nil {
   165			if err := repository.BeforeWrite(); err != nil {
   166				return SessionRef{}, err
   167			}
   168		}
   169		directory := repository.sessionDir(record.sessionID)
   170		if _, err := os.Stat(directory); err == nil {
   171			resumed, resumeErr := repository.resumeCreateLocked(directory, record, recordJSON)
   172			if resumeErr != nil {
   173				return SessionRef{}, resumeErr
   174			}
   175			if !resumed {
   176				return SessionRef{}, refuse(ErrSessionExists, "session %s already exists", record.sessionID)
   177			}
   178		} else {
   179			if err := os.MkdirAll(directory, 0o700); err != nil {
   180				return SessionRef{}, fmt.Errorf("create session directory: %w", err)
   181			}
   182			if err := repository.crashCreateStep(CreateStepSessionDir); err != nil {
   183				return SessionRef{}, err
   184			}
   185			if err := writeExclusive(filepath.Join(directory, "record.json"), recordJSON); err != nil {
   186				return SessionRef{}, fmt.Errorf("install session record: %w", err)
   187			}
   188			if err := repository.crashCreateStep(CreateStepRecord); err != nil {
   189				return SessionRef{}, err
   190			}
   191			if err := os.MkdirAll(filepath.Join(directory, "events"), 0o700); err != nil {
   192				return SessionRef{}, fmt.Errorf("create session events directory: %w", err)
   193			}
   194			if err := repository.crashCreateStep(CreateStepEventsDir); err != nil {
   195				return SessionRef{}, err
   196			}
   197			if err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {
   198				return SessionRef{}, err
   199			}
   200			if err := repository.crashCreateStep(CreateStepChain); err != nil {
   201				return SessionRef{}, err
   202			}
   203		}
   204		if repository.AfterCommit != nil {
   205			if err := repository.AfterCommit(); err != nil {
   206				return SessionRef{}, err
   207			}
   208		}
   209		return SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil
   210	}
   211	
   212	// crashCreateStep fires the AfterCreateStep hook after one durable create
   213	// step. It is nil-safe: unhooked production never faults. A hook error —
   214	// the injected secconftest fault in tests — propagates unwrapped so the
   215	// caller observes the owner's point and outcome.
   216	func (repository *Repository) crashCreateStep(step CreateStep) error {
   217		if repository.AfterCreateStep == nil {
   218			return nil
   219		}
   220		return repository.AfterCreateStep(step)
   221	}
   222	
   223	// resumeCreateLocked completes a create that crashed inside the four-step
   224	// span. Two parked states resume:
   225	//
   226	//   - record absent: the crash landed after the session directory and
   227	//     before the record install, so nothing committed. The chain index
   228	//     must also be absent — a chain without a record is torn foreign
   229	//     state, never a resume — and the retry's bytes become the record.
   230	//   - record present with the retried bytes and the chain still absent:
   231	//     the crash landed between the record write and the chain write, and
   232	//     the retry completes the index.
   233	//
   234	// Anything else is not a resume — a completed create, or a colliding
   235	// record under a live session ID — and the caller refuses it as an
   236	// existing session. It returns plain operational errors; refusal
   237	// attribution stays at the caller.
   238	func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {
   239		existing, err := os.ReadFile(filepath.Join(directory, "record.json"))
   240		if err != nil {
   241			if !os.IsNotExist(err) {
   242				return false, fmt.Errorf("read session record for resume: %w", err)
   243			}
   244			if _, statErr := os.Stat(filepath.Join(directory, "chain.json")); statErr == nil {
   245				return false, nil
   246			}
   247			if err := writeExclusive(filepath.Join(directory, "record.json"), recordJSON); err != nil {
   248				return false, fmt.Errorf("install session record on resume: %w", err)
   249			}
   250			if err := os.MkdirAll(filepath.Join(directory, "events"), 0o700); err != nil {
   251				return false, fmt.Errorf("recreate session events directory: %w", err)
   252			}
   253			if err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {
   254				return false, err
   255			}
   256			return true, nil
   257		}
   258		if !bytes.Equal(existing, recordJSON) {
   259			return false, nil
   260		}
     1	// Immutable SelectionPlan construction and current-fact revalidation
     2	// for the v0.6.0 selector contract (SPEC Section 14.7.2).
     3	//
     4	// Resolve the key to a session UUID once per invocation or confirmed
     5	// plan, then bind the selection facts into a machine-local immutable
     6	// plan: the literal selector, the selected session and its validated
     7	// immutable record digest, the selected source (host and exact alias),
     8	// the digests of the complete validated index read and the effective
     9	// validated configuration, the validated winning lease facts, the
    10	// validated authority heads, and the caller-declared action,
    11	// destination, and expectations. No plan hash, name, source, or display
    12	// field is a capability. All sixteen contract members bind; a future
    13	// member without a bound row fails its publication gate closed instead
    14	// of falling into a default.
    15	//
    16	// Lease authority comes from validated urn:ax:schema:lease records
    17	// supplied in Reader.LeaseRecords and admitted through the
    18	// canonicaljson owner. The plan binds lease_record_id as the canonical
    19	// digest of the winning Lease Record for the selected session, and the
    20	// lease triple binds from that same record. No envelope observation
    21	// substitutes for the record: a session with no admitted winning
    22	// record refuses selector_observation_unavailable, and malformed bytes
    23	// refuse invalid_config. A complete read proving a record without any
    24	// valid lease refuses selector_bootstrap_incomplete instead of binding
    25	// an empty triple, and a local selection without a known local host
    26	// refuses invalid_config instead of binding an empty source host.
    27	//
    28	// Revalidation rereads the current configuration and the plan's source,
    29	// validates the same immutable record, the current winning lease, and
    30	// the action prerequisites this leaf can check, compares every bound
    31	// plan fact in a fixed order, and then validates the complete
    32	// authority union for the pinned session UUID across the local and
    33	// every allowlisted source: a contradictory immutable record is
    34	// integrity failure, a contradictory winning lease or fresh tombstone
    35	// evidence is stale. A changed mapping, alias, allowlist, transport,
    36	// source index, record, authority head, lease, action, destination, or
    37	// expectation invalidates the plan with selector_plan_stale naming the
    38	// first diverged member; explicit authorization revocation returns
    39	// peer_not_allowlisted; failed reads retain their read-failure
    40	// classification. Revalidation never re-resolves by name, substitutes
    41	// a same-named session, silently replans, transfers a lease, or reuses
    42	// confirmation for new facts.
    43	//
    44	// Effect authorization beyond read projection — fencing, commit,
    45	// retry, recovery, remote dispatch/admission, and transport-resume
    46	// prerequisites, and the composed per-endpoint invocation bindings —
    47	// belongs to the CLI and lifecycle owners, which invoke Revalidate at
    48	// every boundary in BoundariesFor for their action. A plan built here
    49	// authorizes read projection only.
    50	package sessquery
    51	
    52	import (
    53		"fmt"
    54	
    55		"github.com/relux-works/agent-session-manager/internal/scalar"
    56		"github.com/relux-works/agent-session-manager/internal/sessrepo"
    57		"github.com/relux-works/agent-session-manager/internal/sessstate"
    58	)
    59	
    60	// SelectorVersion is the exact selector contract version every plan binds.
    61	const SelectorVersion = "1.0.0"
    62	
    63	// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is
    64	// an existing command/action tag; binding one selects it, never an
    65	// umbrella bypass.
    66	const (
    67		ActionStatus      = "status"
    68		ActionAttach      = "attach"
    69		ActionTakeover    = "takeover"
    70		ActionFork        = "fork"
    71		ActionStop        = "stop"
    72		ActionResume      = "resume"
    73		ActionSync        = "sync"
    74		ActionDiff        = "diff"
    75		ActionMaterialize = "materialize"
    76		ActionSetProfile  = "session.set-profile"
    77		ActionLogs        = "logs"
    78		ActionCancel      = "cancel"
    79	)
    80	
    81	// Plan boundaries from the normative action/boundary matrix. A boundary
    82	// is reached only when the existing operation reaches that phase; these
    83	// rows introduce no new effects.
    84	const (
    85		BoundaryProjection      = "projection"
    86		BoundaryPreEffect       = "pre-effect"
    87		BoundaryFencing         = "fencing"
    88		BoundaryCommit          = "commit"
    89		BoundaryRetry           = "retry"
    90		BoundaryRecovery        = "recovery"
    91		BoundaryRemoteDispatch  = "remote-dispatch"
    92		BoundaryRemoteAdmission = "remote-admission"
    93		BoundaryTransportResume = "transport-resume"
    94	)
    95	
    96	// planBoundaries is the closed action/boundary matrix: every action has
    97	// exactly its normative row, and an unknown action has none.
    98	var planBoundaries = map[string][]string{
    99		ActionStatus:      {BoundaryProjection, BoundaryRetry},
   100		ActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},
   101		ActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},
   102		ActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},
   103		ActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},
   104		ActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},
   105		ActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},
   106		ActionDiff:        {BoundaryProjection, BoundaryRetry},
   107		ActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},
   108		ActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},
   109		ActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},
   110		ActionCancel:      {BoundaryProjection},
   111	}
   112	
   113	// BoundariesFor returns the required boundary classes for a plan
   114	// action. The boolean reports whether the action is a known tag; an
   115	// unknown action binds no boundary and builds no plan.
   116	func BoundariesFor(action string) ([]string, bool) {
   117		boundaries, ok := planBoundaries[action]
   118		if !ok {
   119			return nil, false
   120		}
   121		return append([]string(nil), boundaries...), true
   122	}
   123	
   124	// SelectionPlan is the machine-local immutable binding of one selector
   125	// resolution. All members are values, never references: there is no
   126	// mutator, and Marshal carries the locally verified canonical digest
   127	// so a persisted plan is tamper-evident. Caller-supplied digest
   128	// equality alone is never evidence of authority; only Revalidate
   129	// against current facts decides currency.
   130	type SelectionPlan struct {
   131		// SelectorVersion is exactly SelectorVersion.
   132		SelectorVersion string
   133		// Selector is the original single argument, at most
   134		// MaxSelectorRunes characters.
   135		Selector string
   136		// SessionID is the selected UUIDv7, never resolved again by name.
   137		SessionID string
   138		// SessionRecordID is the validated immutable Session Record digest.
   139		SessionRecordID string
   140		// SourceHostID is the UUIDv7 of the selected source, always bound:
   141		// a local selection without a known local host refuses
   142		// invalid_config at build time instead of binding empty.
   143		SourceHostID string
   144		// SourceAlias is the exact configured alias, or nil for local. It
   145		// is a diagnostic label, never identity.
   146		SourceAlias *string
   147		// SourceIndexDigest is the digest of the complete validated index
   148		// read used for selection.
   149		SourceIndexDigest string
   150		// ConfigurationDigest is the digest of the effective validated
   151		// configuration, including peer mapping, allowlist, and transport.
   152		ConfigurationDigest string
   153		// LeaseRecordID is the canonical digest of the validated winning
   154		// Lease Record for the selected session, admitted through the
   155		// canonicaljson owner from Reader.LeaseRecords.
   156		LeaseRecordID string
   157		// LeaseEpoch, LeaseID, and OwnerHostID come from that same winning
   158		// Lease Record: positive uint53, UUIDv4, and UUIDv7 holder. A plan
   159		// with no admitted winning record is never built; the builder
   160		// refuses selector_observation_unavailable, and a complete read
   161		// proving a record without any valid lease refuses
   162		// selector_bootstrap_incomplete.
   163		LeaseEpoch  uint64
   164		LeaseID     string
   165		OwnerHostID string
   166		// AuthorityHeads is the sorted unique digest array of the validated
   167		// lease, event, and tombstone heads used for the decision: the
   168		// winning Lease Record digest plus the tail event digest of every
   169		// allowed source holding a non-parked copy of the pinned session.
   170		AuthorityHeads []string
   171		// Action is the explicit command/action tag bound at build time.
   172		Action string
   173		// DestinationHostID is the explicit destination UUIDv7, or nil
   174		// when the action takes no destination.
   175		DestinationHostID *string
   176		// ExpectationDigest binds the caller-declared action expectations
   177		// (canonically encoded JSON) for change detection. It does not
   178		// replace the checkpoint, workspace, cohort, provider, terminal,
   179		// or confirmation contracts, which have no owners in this leaf.
   180		ExpectationDigest string
   181	}
   182	
   183	// PlanArgs declares the invocation facts BuildPlan binds: the literal
   184	// selector, the explicit action tag, the explicit destination (empty
   185	// for none), and the opaque caller expectations (nil for none).
   186	type PlanArgs struct {
   187		Selector     string
   188		Action       string
   189		Destination  string
   190		Expectations []byte
   191	}
   192	
   193	// BuildPlan resolves the selector once through the shared path and
   194	// binds the current facts into an immutable plan. The destination is
   195	// independently validated as a UUIDv7; expectations must be canonically
   196	// encodable JSON and bind by digest for change detection only.
   197	func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {
   198		parsed, err := ParseSelector(args.Selector)
   199		if err != nil {
   200			return SelectionPlan{}, err
   201		}
   202		if reader == nil || reader.Local == nil {
   203			return SelectionPlan{}, fmt.Errorf("%w: local repository is required", ErrUnavailable)
   204		}
   205		config, err := reader.validatedConfiguration()
   206		if err != nil {
   207			return SelectionPlan{}, err
   208		}
   209		if _, ok := BoundariesFor(args.Action); !ok {
   210			return SelectionPlan{}, fmt.Errorf("%w: unknown plan action %q", ErrInvalidArgument, args.Action)
   211		}
   212		var destination *string
   213		if args.Destination != "" {
   214			id, err := scalar.ParseUUIDv7(args.Destination)
   215			if err != nil {
   216				return SelectionPlan{}, fmt.Errorf("%w: malformed destination host ID: %v", ErrInvalidArgument, err)
   217			}
   218			value := id.String()
   219			destination = &value
   220		}
   221		expectations, err := fingerprintExpectations(args.Expectations)
   222		if err != nil {
   223			return SelectionPlan{}, err
   224		}
   225		var selected Selection
   226		if parsed.Source != SourceBare {
   227			selected, err = reader.resolveExplicit(parsed, config)
   228		} else {
   229			selected, err = reader.resolveBare(parsed, config)
   230		}
   231		if err != nil {
   232			return SelectionPlan{}, err
   233		}
   234		return reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)
   235	}
   236	
   237	// bindPlan reads the winning source completely and binds every plan
   238	// member from validated current facts. The session is located by its
   239	// UUID in the winning source only, never re-resolved by name. Lease
   240	// authority comes from the admitted winning Lease Record for that
   241	// UUID; the envelope winner on the selected chain must agree with it,
   242	// and the union winner across all allowed sources must not exceed it.
   243	func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {
   244		rows, err := reader.readSource(selected.repo, selected.PeerHostID)
   245		if err != nil {
   246			return SelectionPlan{}, err
   247		}
   248		index, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)
   249		if err != nil {
   250			return SelectionPlan{}, err
   251		}
   252		configuration, err := fingerprintConfiguration(reader, config)
   253		if err != nil {
   254			return SelectionPlan{}, err
   255		}
   256		var recordID string
   257		found := false
   258		for _, row := range rows {
   259			if row.Projection.SessionID == selected.SessionID {
   260				recordID, found = row.Projection.RecordID, true
   261				break
   262			}
   263		}
   264		if !found {
   265			return SelectionPlan{}, fmt.Errorf("%w: selection absent from source index", ErrPlanStale)
   266		}
   267		projection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)
   268		if err != nil {
   269			return SelectionPlan{}, err
   270		}
   271		if projection.Winner.IsZero() {
   272			return SelectionPlan{}, fmt.Errorf("%w: complete authority read proves record %s without any valid lease", ErrBootstrapIncomplete, selected.SessionID)
   273		}
   274		lease, err := reader.winningLeaseFor(selected.SessionID, projection.Kind, selected.repo)
   275		if err != nil {
   276			return SelectionPlan{}, err
   277		}
   278		if projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {
   279			return SelectionPlan{}, fmt.Errorf("%w: winning lease changed", ErrPlanStale)
   280		}
   281		if projection.OwnerHostID != lease.HolderHostID {
   282			return SelectionPlan{}, fmt.Errorf("%w: session %s carries disagreeing owner facts across lease and chain", sessstate.ErrIntegrity, selected.SessionID)
   283		}
   284		plan := SelectionPlan{
   285			SelectorVersion:     SelectorVersion,
   286			Selector:            parsed.Raw,
   287			SessionID:           selected.SessionID,
   288			SessionRecordID:     recordID,
   289			SourceIndexDigest:   index,
   290			ConfigurationDigest: configuration,
   291			LeaseRecordID:       lease.Digest,
   292			LeaseEpoch:          lease.Epoch,
   293			LeaseID:             lease.LeaseID,
   294			OwnerHostID:         lease.HolderHostID,
   295			Action:              action,
   296			DestinationHostID:   destination,
   297			ExpectationDigest:   expectations,
   298		}
   299		if selected.PeerHostID == "" {
   300			if config.localHost == "" {
   301				return SelectionPlan{}, fmt.Errorf("%w: local host identity is required to bind a local plan source", ErrInvalidConfig)
   302			}
   303			plan.SourceHostID = config.localHost
   304		} else {
   305			plan.SourceHostID = selected.PeerHostID
   306			// Null marks the local source only. An alias-less peer binds
   307			// empty: the host still distinguishes it from local.
   308			alias := config.aliasFor(selected.PeerHostID)
   309			aliasCopy := alias
   310			plan.SourceAlias = &aliasCopy
   311		}
   312		// The union check consults record, tombstone, and winner facts
   313		// only, never heads; heads are bound after the union validates.
   314		plan.AuthorityHeads = []string{}
   315		if err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {
   316			return SelectionPlan{}, err
   317		}
   318		heads, err := reader.collectAuthorityHeads(config, selected.SessionID, lease.Digest, selected.PeerHostID)
   319		if err != nil {
   320			return SelectionPlan{}, err
   321		}
   322		plan.AuthorityHeads = heads
   323		if err := checkPlanShapes(plan); err != nil {
   324			return SelectionPlan{}, err
   325		}
   326		return plan, nil
   327	}
