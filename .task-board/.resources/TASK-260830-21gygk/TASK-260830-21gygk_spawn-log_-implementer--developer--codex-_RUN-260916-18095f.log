     1	// Package sessquery is the single shared selector API over the session
     2	// repository and state projector: read-only selector resolution
     3	// (Section 14.7.1 literal grammar over Section 2.3 tiers), local
     4	// list/status summaries, and immutable SelectionPlan construction with
     5	// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers
     6	// own invoking this API at every required boundary; no second resolver
     7	// exists. Unknown owner/lease facts and parked diagnostics stay explicit
     8	// in Projection: host display names, checkpoint timestamps/age,
     9	// workspace state, capabilities, process liveness and sync timestamps
    10	// require their respective observation owners and are never inferred
    11	// from a record or a successful read.
    12	package sessquery
    13	
    14	import (
    15		"errors"
    16		"fmt"
    17		"sort"
    18		"strings"
    19	
    20		"github.com/relux-works/agent-session-manager/internal/scalar"
    21		"github.com/relux-works/agent-session-manager/internal/sessrepo"
    22		"github.com/relux-works/agent-session-manager/internal/sessstate"
    23	)
    24	
    25	var (
    26		ErrUnavailable = errors.New("session index unavailable")
    27		ErrAmbiguous   = sessrepo.ErrNameAmbiguous
    28		ErrNotFound    = sessrepo.ErrNameNotFound
    29		// ErrInvalidArgument refuses a malformed caller argument: selector
    30		// grammar violations (empty key, unknown source prefix, malformed
    31		// durable IDs, overlong argument), malformed plan members, unknown
    32		// action tags, and malformed destinations or expectations. Wire
    33		// exit binding for a CLI surface belongs to that surface's leaf;
    34		// this library keeps the refusal class distinct and stable.
    35		ErrInvalidArgument = errors.New("invalid_arguments")
    36		// ErrSourceNotFound reports that complete valid configuration has
    37		// no requested explicit source.
    38		ErrSourceNotFound = errors.New("selector_source_not_found")
    39		// ErrPeerNotAllowlisted reports an explicitly selected peer that
    40		// is configured but not allowlisted, including authorization
    41		// revoked after a plan was built.
    42		ErrPeerNotAllowlisted = errors.New("peer_not_allowlisted")
    43		// ErrSourceReadFailed reports a remote source transport/I-O read
    44		// failure with no fallback. The underlying cause stays attached
    45		// for errors.Is, so a repository-path failure remains visible as
    46		// such. A local source/store I-O failure keeps its repository
    47		// error, which the CLI Result 5 leaf maps to
    48		// local_precondition_failed; a partial or malformed index or
    49		// authority response is integrity failure, not absence.
    50		ErrSourceReadFailed = errors.New("selector_source_read_failed")
    51		// ErrInvalidConfig reports duplicate or malformed effective source
    52		// mappings: duplicate exact aliases or host IDs, a peer host that
    53		// collides with the local host, malformed host IDs, or aliases
    54		// outside the configured 1-64 printable-character bound.
    55		ErrInvalidConfig = errors.New("invalid_config")
    56		// ErrPlanStale reports bound selection facts that changed after a
    57		// plan was built; a fresh plan and confirmation are required. The
    58		// wrapped reason names the first diverged member in compare order.
    59		ErrPlanStale = errors.New("selector_plan_stale")
    60		// ErrBootstrapIncomplete reports a complete authority read proving
    61		// a Session Record without any valid lease: an interrupted
    62		// persistence prefix for the bootstrap-recovery leaf (Section
    63		// 14.7.4), never a public summary. A failed read keeps its
    64		// read-failure class instead; corrupt authority is integrity
    65		// failure. Wire exit binding for a CLI surface belongs to that
    66		// surface's leaf; this library keeps the refusal class distinct
    67		// and stable.
    68		ErrBootstrapIncomplete = errors.New("selector_bootstrap_incomplete")
    69		// ErrObservationUnavailable reports a required summary observation
    70		// or host metadata fact that cannot be established from validated
    71		// inputs. Nothing is inferred in its place: no source alias stands
    72		// in for host metadata, and no absent observation mints liveness,
    73		// capability, workspace, or timestamp facts.
    74		ErrObservationUnavailable = errors.New("selector_observation_unavailable")
    75	)
    76	
    77	// PeerIndex binds a peer identity to its already persisted learned index.
    78	// Transport/authentication and installing peer indexes are upstream owners;
    79	// this reader does not fetch, authenticate, or attest a caller-supplied index.
    80	type PeerIndex struct {
    81		HostID string
    82		Repo   *sessrepo.Repository
    83	}
    84	
    85	// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning
    86	// configuration layer, separately from the learned indexes. An unlisted source
    87	// is never read. Failed reads from listed sources are errors, never
    88	// empty indexes that let resolution fall through to a lower-priority UUID.
    89	// LocalHostID comes from the local host identity owner; empty preserves unknown.
    90	//
    91	// Aliases carries the exact configured peer-alias mapping (host ID to
    92	// alias) from the same configuration owner, kept separate from the
    93	// learned index handles: a mapping without a handle contributes no
    94	// learned names, and a handle without a mapping stays reachable through
    95	// the bare union and the "id:" host form but never through "peer:".
    96	// Alias comparison is always exact, never folded, trimmed, or decoded.
    97	//
    98	// HostMetadata and Observations carry the validated host and observation
    99	// facts the authoritative summary layer requires, from their respective
   100	// owners. They are consulted only by that layer: List and Status keep
   101	// the internal read model and refuse only the unrepresentable
   102	// record-only bootstrap.
   103	//
   104	// LeaseRecords carries the validated winning-lease authority for plan
   105	// construction and revalidation, from the lease owner. Each entry is
   106	// canonical JSON for one urn:ax:schema:lease Lease Record; the reader
   107	// validates the closed shape and canonical self identity through the
   108	// canonicaljson owner, selects the greatest (epoch, lease_id) winner
   109	// per session, and binds that record digest with its tuple and holder.
   110	// Absence for a session refuses observation_unavailable; malformed
   111	// bytes refuse invalid_config. Envelope observations never substitute
   112	// for these records.
   113	//
   114	// CheckpointRecords carries the validated checkpoint authority the
   115	// winning-lease succession gate requires, from the checkpoint owner.
   116	// Each entry is canonical JSON for one urn:ax:schema:checkpoint
   117	// Checkpoint Record; the reader validates the closed shape and
   118	// canonical self identity through the sessrepo owner. Every successor
   119	// winner must reference an admitted record for its session and
   120	// predecessor lease, carrying the persistence variant the referenced
   121	// Session Record kind selects; an unresolvable, misbound, or
   122	// wrong-variant reference refuses observation_unavailable, and
   123	// malformed bytes refuse invalid_config.
   124	type Reader struct {
   125		Local              *sessrepo.Repository
   126		LocalHostID        string
   127		AllowlistedPeerIDs []string
   128		Peers              []PeerIndex
   129		Aliases            map[string]string
   130		HostMetadata       map[string]HostMetadata
   131		Observations       map[string]SessionObservations
   132		LeaseRecords       [][]byte
   133		CheckpointRecords  [][]byte
   134	}
   135	
   136	// Summary contains only facts derived from verified session records and events.
   137	// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.
   138	// Unknown owner/lease and parked diagnostics remain explicit in Projection.
   139	// Host display names, checkpoint timestamps/age, workspace state, capabilities,
   140	// process liveness and sync timestamps require their respective observation
   141	// owners and are deliberately not inferred from a record or a successful read.
   142	type Summary struct {
   143		Projection sessstate.Projection
   144	}
   145	
   146	// List reads local summaries in bytewise session-ID order. Parked sessions stay
   147	// visible with their blocking reason and retry; failure to enumerate the index
   148	// fails the read. No durable state is written, even for an interrupted create.
   149	// A complete read proving a record without any valid lease refuses the whole
   150	// list with selector_bootstrap_incomplete: the interrupted prefix is never
   151	// silently omitted and never returned as a public summary.
   152	func (reader *Reader) List() ([]Summary, error) {
   153		if reader == nil || reader.Local == nil {
   154			return nil, fmt.Errorf("%w: local repository is required", ErrUnavailable)
   155		}
   156		rows, err := reader.read(reader.Local)
   157		if err != nil {
   158			return nil, err
   159		}
   160		for _, row := range rows {
   161			if err := checkSummaryRepresentable(row); err != nil {
   162				return nil, err
   163			}
   164		}
   165		return rows, nil
   166	}
   167	
   168	func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {
   169		rows, err := repo.ListSessions()
   170		if err != nil {
   171			return nil, err
   172		}
   173		out := make([]Summary, 0, len(rows))
   174		projector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}
   175		for _, row := range rows {
   176			projection, err := projector.Project(row.SessionID)
   177			if err != nil {
   178				return nil, err
   179			}
   180			out = append(out, Summary{Projection: projection})
   181		}
   182		sort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })
   183		return out, nil
   184	}
   185	
   186	// Status resolves any selector — bare, "id:", or source-qualified — through
   187	// the same path as Resolve, then projects from the selected repository. It
   188	// never treats a failed read as not found. Parked sessions can be inspected
   189	// by ID through InspectLocal, independently of live-name routing, so
   190	// operators retain access to the recovery diagnostics.
   191	func (reader *Reader) Status(selector string) (Summary, error) {
   192		selected, err := reader.Resolve(selector)
   193		if err != nil {
   194			return Summary{}, err
   195		}
   196		projection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)
   197		if err != nil {
   198			return Summary{}, err
   199		}
   200		summary := Summary{Projection: projection}
   201		if err := checkSummaryRepresentable(summary); err != nil {
   202			return Summary{}, err
   203		}
   204		return summary, nil
   205	}
   206	
   207	// InspectLocal reads one local ID, including a parked or tombstoned session.
   208	func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {
   209		if reader == nil || reader.Local == nil {
   210			return Summary{}, fmt.Errorf("%w: local repository is required", ErrUnavailable)
   211		}
   212		projection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)
   213		if err != nil {
   214			return Summary{}, err
   215		}
   216		return Summary{Projection: projection}, nil
   217	}
   218	
   219	// Selection identifies the session and source index, never an attach or mutation
   220	// plan. PeerHostID is empty for local resolution; it is not the winning owner.
   221	type Selection struct {
   222		SessionID  string
   223		PeerHostID string
   224		repo       *sessrepo.Repository
   225	}
   226	
   227	type candidate struct {
   228		summary   Summary
   229		selection Selection
   230	}
   231	
   232	// Resolve applies one parsed selector through the single shared path:
   233	// grammar first, then effective-configuration validation, then the
   234	// source tier. A bare selector retains the exact Section 2.3 tiers:
   235	// local exact live name, allowlisted peer exact live name, exact UUID,
   236	// not found. An "id:" key bypasses names for the durable UUID in the
   237	// local and allowed-peer union. A qualified selector resolves its key
   238	// in exactly one source index with no fallback. ASCII folding detects
   239	// collisions within each name tier; it does not turn a unique case
   240	// variant into an exact match. Repository-parked entries (failed reads,
   241	// never tombstone evidence) and tombstoned entries (authoritative
   242	// tombstone evidence) are not live candidates. A tier that must be
   243	// read but cannot be read is a read failure, not permission to proceed
   244	// to a lower tier. This is logical index eligibility, not proof of
   245	// process liveness or safe attach/resume readiness; those decisions
   246	// belong to the action planner invoking plans at its boundaries.
   247	func (reader *Reader) Resolve(selector string) (Selection, error) {
   248		parsed, err := ParseSelector(selector)
   249		if err != nil {
   250			return Selection{}, err
   251		}
   252		if reader == nil || reader.Local == nil {
   253			return Selection{}, fmt.Errorf("%w: local repository is required", ErrUnavailable)
   254		}
   255		config, err := reader.validatedConfiguration()
   256		if err != nil {
   257			return Selection{}, err
   258		}
   259		if parsed.Source != SourceBare {
   260			return reader.resolveExplicit(parsed, config)
   270			if index > 0 && values[index-1] >= warning {
   271				return fmt.Errorf("warnings are not sorted unique")
   272			}
   273		}
   274		return nil
   275	}
   276	
   277	// checkPrintableBound enforces valid UTF-8 with min..max printable
   278	// non-control runes without normalizing or folding the value.
   279	func checkPrintableBound(value string, min, max int, what string) error {
   280		if !utf8.ValidString(value) {
   281			return fmt.Errorf("%s is not valid UTF-8", what)
   282		}
   283		count := utf8.RuneCountInString(value)
   284		if count < min || count > max {
   285			return fmt.Errorf("%s carries %d characters, want %d-%d", what, count, min, max)
   286		}
   287		for _, character := range value {
   288			if unicode.IsControl(character) || !unicode.IsPrint(character) {
   289				return fmt.Errorf("%s carries a non-printable character", what)
   290			}
   291		}
   292		return nil
   293	}
   294	
   295	// AuthoritativeStatus resolves one selector through the shared path
   296	// and returns its closed authoritative summary. Resolution,
   297	// read-failure, and bootstrap refusals behave exactly as Status;
   298	// host, lease, and observation facts then bind or refuse as documented
   299	// above. The winning lease checkpoint event-head closure is admitted
   300	// against the selected source chain, so a peer selection validates
   301	// against its own chain rather than the local one. Process liveness
   302	// is required here: the status body carries process_present boolean,
   303	// and an unknown liveness refuses.
   304	func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {
   305		selected, err := reader.Resolve(selector)
   306		if err != nil {
   307			return AuthoritativeSummary{}, err
   308		}
   309		projection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)
   310		if err != nil {
   311			return AuthoritativeSummary{}, err
   312		}
   313		summary := Summary{Projection: projection}
   314		if err := checkSummaryRepresentable(summary); err != nil {
   315			return AuthoritativeSummary{}, err
   316		}
   317		if err := reader.validatedAuthorityInputs(); err != nil {
   318			return AuthoritativeSummary{}, err
   319		}
   320		return reader.authorize(summary, selected.repo, true)
   321	}
   322	
   323	// AuthoritativeList returns the closed authoritative summaries for
   324	// the local index in bytewise session-ID order. The whole document
   325	// refuses when any encountered record cannot be represented
   326	// truthfully — including one incomplete record in an otherwise
   327	// healthy listing — and no record is silently omitted. Process
   328	// liveness is carried when its observation is supplied; workspace,
   329	// capabilities, host, lease, and checkpoint facts are always required.
   330	func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {
   331		rows, err := reader.List()
   332		if err != nil {
   333			return nil, err
   334		}
   335		if err := reader.validatedAuthorityInputs(); err != nil {
   336			return nil, err
   337		}
   338		out := make([]AuthoritativeSummary, 0, len(rows))
   339		for _, row := range rows {
   340			summary, err := reader.authorize(row, reader.Local, false)
   341			if err != nil {
   342				return nil, err
   343			}
   344			out = append(out, summary)
   345		}
   346		return out, nil
   347	}
   348	
   349	// authorize binds one projected row to its closed authoritative
   350	// summary against the validated host, lease, and observation inputs.
   351	// The winning lease checkpoint event-head closure is admitted
   352	// against the row's source chain (repo, the winning source for
   353	// plans and the local index for lists), including its Section 2.4
   354	// profile authority. Every refusal names the
   355	// missing established fact; nothing is inferred. An established
   356	// absence (workspace "absent", an empty non-nil capability map) is
   357	// distinct from an unknown observation (nil), which refuses.
   358	func (reader *Reader) authorize(summary Summary, repo *sessrepo.Repository, requireProcess bool) (AuthoritativeSummary, error) {
   359		projection := summary.Projection
   360		if err := checkSummaryRepresentable(summary); err != nil {
   361			return AuthoritativeSummary{}, err
   362		}
   363		if reader.LocalHostID == "" {
   364			return AuthoritativeSummary{}, fmt.Errorf("%w: local host identity is required to establish the local role", ErrObservationUnavailable)
   365		}
   366		lease, err := reader.winningLeaseFor(projection.SessionID, projection.Kind, repo)
   367		if err != nil {
   368			return AuthoritativeSummary{}, err
   369		}
   370		if projection.Winner.Epoch != lease.Epoch || projection.Winner.LeaseID != lease.LeaseID {
   371			return AuthoritativeSummary{}, fmt.Errorf("%w: session %s carries disagreeing lease facts across chain and record", sessstate.ErrIntegrity, projection.SessionID)
   372		}
   373		if projection.OwnerHostID != lease.HolderHostID {
   374			return AuthoritativeSummary{}, fmt.Errorf("%w: session %s carries disagreeing owner facts across chain and record", sessstate.ErrIntegrity, projection.SessionID)
   375		}
   376		metadata, ok := reader.HostMetadata[lease.HolderHostID]
   377		if !ok {
   378			return AuthoritativeSummary{}, fmt.Errorf("%w: host metadata for owner %s cannot be established", ErrObservationUnavailable, lease.HolderHostID)
   379		}
   380		if projection.LocalRole == "" {
   381			return AuthoritativeSummary{}, fmt.Errorf("%w: local role for session %s cannot be established", ErrObservationUnavailable, projection.SessionID)
   382		}
   383		if err := checkWarnings(projection.Warnings); err != nil {
   384			return AuthoritativeSummary{}, fmt.Errorf("%w: warnings for session %s: %v", ErrInvalidConfig, projection.SessionID, err)
   385		}
   386		authorized := AuthoritativeSummary{
   387			SessionID:       projection.SessionID,
   388			Name:            projection.Name,
   389			Kind:            projection.Kind,
   390			ProviderID:      projection.Provider.ID,
   391			State:           string(projection.State),
   392			OwnerHostID:     lease.HolderHostID,
   393			OwnerHostName:   metadata.DisplayName,
   394			LeaseEpoch:      lease.Epoch,
   395			LeaseID:         lease.LeaseID,
   396			LocalRole:       projection.LocalRole,
   397			WorkspaceStatus: "",
   398			Warnings:        append([]string(nil), projection.Warnings...),
   399		}
   400		if authorized.Warnings == nil {
   401			authorized.Warnings = []string{}
   402		}
   403		observations, hasObservations := reader.Observations[projection.SessionID]
   404		if projection.HasCheckpoint {
   405			checkpoint := projection.Newest.ID
   406			authorized.HasCheckpoint = true
   407			authorized.NewestCheckpointID = &checkpoint
   408			if !hasObservations || observations.NewestCheckpointCreatedAt == nil {
   409				return AuthoritativeSummary{}, fmt.Errorf("%w: checkpoint timestamp for session %s cannot be established", ErrObservationUnavailable, projection.SessionID)
   410			}
   411			stamp := *observations.NewestCheckpointCreatedAt
   412			authorized.NewestCheckpointCreatedAt = &stamp
   413		}
   414		if !hasObservations || observations.WorkspaceStatus == nil {
   415			return AuthoritativeSummary{}, fmt.Errorf("%w: workspace status for session %s cannot be established", ErrObservationUnavailable, projection.SessionID)
   416		}
   417		workspace := WorkspaceAbsent
   418		if hasObservations && observations.WorkspaceStatus != nil {
   419			workspace = *observations.WorkspaceStatus
   420		}
   421		authorized.WorkspaceStatus = workspace
   422		if !hasObservations || observations.Capabilities == nil {
   423			return AuthoritativeSummary{}, fmt.Errorf("%w: capabilities for session %s cannot be established", ErrObservationUnavailable, projection.SessionID)
   424		}
   425		authorized.Capabilities = observations.Capabilities
   426		if authorized.Capabilities == nil {
   427			authorized.Capabilities = map[string]CapabilitySummary{}
   428		}
   429		if requireProcess {
   430			if !hasObservations || observations.ProcessPresent == nil {
   431				return AuthoritativeSummary{}, fmt.Errorf("%w: process liveness for session %s cannot be established", ErrObservationUnavailable, projection.SessionID)
   432			}
   433		}
   434		var present bool
