  1121	// checkCheckpointPersistence binds an admitted Checkpoint Record to
  1122	// the persistence variant the referenced Session Record selects
  1123	// (Section 5.4): a direct session requires a non-null
  1124	// provider_manifest_id with a null task_board_bundle_id, while a
  1125	// task_board session requires the reverse. Canonical shape proves
  1126	// exactly one variant is present but cannot select which one is
  1127	// valid, so a swapped variant keeps canonical identity, session,
  1128	// lease, epoch, and creator yet refuses here with incomplete
  1129	// authority (observation_unavailable), never absence or a minted
  1130	// fact. An unknown session kind is malformed configuration: valid
  1131	// Session Records admit only the two kinds.
  1132	func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {
  1133		switch sessionKind {
  1134		case "direct":
  1135			if !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {
  1136				return fmt.Errorf("%w: validated checkpoint %s carries a task-board persistence variant for direct session %s", ErrObservationUnavailable, checkpoint.Digest, sessionID)
  1137			}
  1138			return nil
  1139		case "task_board":
  1140			if checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {
  1141				return fmt.Errorf("%w: validated checkpoint %s carries a provider persistence variant for task_board session %s", ErrObservationUnavailable, checkpoint.Digest, sessionID)
  1142			}
  1143			return nil
  1144		default:
  1145			return fmt.Errorf("%w: session %s carries unknown kind %q for checkpoint persistence", ErrInvalidConfig, sessionID, sessionKind)
  1146		}
  1147	}
  1148	
  1149	// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:
  1150	// greatest epoch wins, ties break by bytewise lease-ID order.
  1151	func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {
