+			"operation_id":        hostB,
+			"from_host_id":         hostA,
+			"to_host_id":           hostA,
+			"predecessor_lease_id": leaseB,
+			"new_lease_id":          leaseCycleB,
+		})
+	}
+	_ = tail
+	return r
+}
