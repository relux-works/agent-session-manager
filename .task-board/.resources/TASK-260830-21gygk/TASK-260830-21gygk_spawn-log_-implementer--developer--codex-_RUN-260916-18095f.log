    96				for _, wrong := range []bool{false, true} {
    97					mode := "control"
    98					if wrong {
    99						mode = "wrong_variant"
   100					}
   101					t.Run(kind+"/"+path+"/"+mode, func(t *testing.T) {
   102						r, _ := rev7Fixture(t, kind, ancestor)
   103						old := mustBuild(t, r, PlanArgs{Selector: "alpha", Action: ActionStatus})
   104						if wrong {
   105							change := map[string]any{"provider_manifest_id": nil, "task_board_bundle_id": zeroDigest}
   106							if kind == "task_board" {
   107								change = map[string]any{"provider_manifest_id": zeroDigest, "task_board_bundle_id": nil}
   108							}
   109							rev7SwapCheckpoint(t, r, rev7Replace(t, r.CheckpointRecords[0], "checkpoint_id", change))
   110							if err := r.Revalidate(old); err == nil {
