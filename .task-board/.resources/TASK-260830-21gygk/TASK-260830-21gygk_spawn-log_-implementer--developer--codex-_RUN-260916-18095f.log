+	"admitCheckpoint":                   true,
+	"checkCheckpointEventHeads":         true,
+	"checkCheckpointPersistence":        true,
+}
+
+var rev12ProfileDerivationEntries = []string{
+	"checkCheckpointProfileAuthority",
+	"sessionCreationProfile",
+	"profileClosure",
+	"eventProfilePair",
+	"eventProfileTarget",
