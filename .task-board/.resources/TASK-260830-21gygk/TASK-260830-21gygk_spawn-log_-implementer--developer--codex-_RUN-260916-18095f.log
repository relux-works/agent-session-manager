+							}
+						}
+					}
+					rev7CheckEntries(t, r, false)
+					old := mustBuild(t, r, PlanArgs{Selector: "alpha", Action: ActionStatus})
+					r.CheckpointRecords = originalCP
+					r.LeaseRecords = originalLeases
+					oldErr := r.Revalidate(old)
