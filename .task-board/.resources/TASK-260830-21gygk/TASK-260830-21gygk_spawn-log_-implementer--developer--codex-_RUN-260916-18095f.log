+// rev12CheckRecordConsumptionSource parses and type-checks all production
+// files in one package, then enforces the raw-to-admitted boundary using
+// *types.TypeName identity and expression types. It deliberately does not
+// rely on function names in one source file for derivation: a new file,
+// receiver method, closure, or inferred raw loader result is still inside the
+// checked package and is rejected.
+func rev12CheckRecordConsumptionSource(packageDir string) error {
+	archives, err := rev12LoadImportArchives()
+	if err != nil {
+		return err
+	}
+	entries, err := os.ReadDir(packageDir)
