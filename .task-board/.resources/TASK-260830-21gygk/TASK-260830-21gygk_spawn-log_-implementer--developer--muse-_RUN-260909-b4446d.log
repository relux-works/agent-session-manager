{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d49f","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":2218,"recorded_at":1780531400004431,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a08871-d9d8-70c0-8dc8-4aea463248cf"},"task_id":"01a08871-d9d8-70c0-8dc8-4aea463248cf","event":{"kind":"output","task_id":"01a08871-d9d8-70c0-8dc8-4aea463248cf","chunk":"Read text file `internal/sessquery/union_test.go`.\n1|// Complete-authority union tests for TASK-260830-21gygk: revalidation\n2|// and construction validate the pinned session UUID across the local\n3|// and every allowlisted source without re-resolving names or\n4|// substituting selections.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// leasedPeerSession creates a leased session on a peer repository for\n18|// union fixtures.\n19|func leasedPeerSession(t *testing.T, peer *sessrepo.Repository, id, name string) sessrepo.SessionRef {\n20|\tt.Helper()\n21|\tref := create(t, peer, id, name)\n22|\tappendEvent(t, peer, id, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n23|\treturn ref\n24|}\n25|\n26|// unionReader builds a local/peer reader whose peer holds a leased\n27|// session and whose local side starts empty.\n28|func unionReader(t *testing.T, local, peer *sessrepo.Repository) *Reader {\n29|\tt.Helper()\n30|\treturn &Reader{\n31|\t\tLocal:              local,\n32|\t\tLocalHostID:        hostB,\n33|\t\tAllowlistedPeerIDs: []string{hostA},\n34|\t\tPeers:              []PeerIndex{{hostA, peer}},\n35|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n36|\t}\n37|}\n38|\n39|func TestRevalidateUnionLeaseDivergenceRefusesStale(t *testing.T) {\n40|\tlocal, _ := repository(t)\n41|\tpeer, _ := repository(t)\n42|\tleasedPeerSession(t, peer, idB, \"beta\")\n43|\treader := unionReader(t, local, peer)\n44|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n45|\tif err := reader.Revalidate(plan); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\t// The local source learns the same immutable record, then observes\n49|\t// a successor winning lease the plan source has not seen.\n50|\tref := create(t, local, idB, \"beta\")\n51|\tif ref.RecordID != plan.SessionRecordID {\n52|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", ref.RecordID, plan.SessionRecordID)\n53|\t}\n54|\tcreated := appendEvent(t, local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n55|\tlaunched := appendEvent(t, local, idB, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n56|\tappendEventAs(t, local, idB, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n57|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n58|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n59|\t})\n60|\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n61|}\n62|\n63|func TestRevalidateUnionTombstoneRefusesStale(t *testing.T) {\n64|\tlocal, _ := repository(t)\n65|\tpeer, _ := repository(t)\n66|\tleasedPeerSession(t, peer, idB, \"beta\")\n67|\treader := unionReader(t, local, peer)\n68|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n69|\tref := create(t, local, idB, \"beta\")\n70|\tif ref.RecordID != plan.SessionRecordID {\n71|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", ref.RecordID, plan.SessionRecordID)\n72|\t}\n73|\tevent := appendEvent(t, local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n74|\tevent = appendEvent(t, local, idB, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n75|\tappendEvent(t, local, idB, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n76|\tmustStale(t, reader.Revalidate(plan), \"tombstone evidence changed\")\n77|}\n78|\n79|func TestRevalidateUnionAgreeingReplicaStaysCurrent(t *testing.T) {\n80|\tlocal, _ := repository(t)\n81|\tpeer, _ := repository(t)\n82|\tref := leasedPeerSession(t, peer, idB, \"beta\")\n83|\treader := unionReader(t, local, peer)\n84|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n85|\t// A lagging source replicating the same record and the identical\n86|\t// bootstrap event observes agreeing authority: no refusal.\n87|\tlocalRef := create(t, local, idB, \"beta\")\n88|\tif localRef.RecordID != ref.RecordID {\n89|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", localRef.RecordID, ref.RecordID)\n90|\t}\n91|\tappendEvent(t, local, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n92|\tif err := reader.Revalidate(plan); err != nil {\n93|\t\tt.Fatalf(\"agreeing replica invalidated plan: %v\", err)\n94|\t}\n95|}\n96|\n97|func TestRevalidateUnionParkedCopyIgnored(t *testing.T) {\n98|\tlocal, _ := repository(t)\n99|\tpeer, _ := repository(t)\n100|\tleasedPeerSession(t, peer, idB, \"beta\")\n101|\treader := unionReader(t, local, peer)\n102|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n103|\t// A parked copy is a failed observation, never tombstone or\n104|\t// record evidence: it cannot contradict the plan.\n105|\tlocal.AfterCreateStep = func(step sessrepo.CreateStep) error {\n106|\t\tif step == sessrepo.CreateStepRecord {\n107|\t\t\treturn errors.New(\"crash\")\n108|\t\t}\n109|\t\treturn nil\n110|\t}\n111|\tif _, err := local.CreateSession(record(t, idB, \"different-record\")); err == nil {\n112|\t\tt.Fatal(\"fault did not fire\")\n113|\t}\n114|\tlocal.AfterCreateStep = nil\n115|\tif err := reader.Revalidate(plan); err != nil {\n116|\t\tt.Fatalf(\"parked copy invalidated plan: %v\", err)\n117|\t}\n118|}\n119|\n120|func TestRevalidateUnionUnreadablePeerRefuses(t *testing.T) {\n121|\treader, _, _, _ := plannedSession(t)\n122|\tpeer, peerRoot := repository(t)\n123|\treader.AllowlistedPeerIDs = []string{hostC}\n124|\treader.Peers = []PeerIndex{{hostC, peer}}\n125|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n126|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n127|\t\tt.Fatal(err)\n128|\t}\n129|\t// The complete authority union cannot be validated without the\n130|\t// allowlisted peer read: the failure keeps its class.\n131|\terr := reader.Revalidate(plan)\n132|\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n133|\t\tt.Fatalf(\"unreadable union peer = %v\", err)\n134|\t}\n135|}\n136|\n137|func TestBuildPlanValidatesUnionAtBuild(t *testing.T) {\n138|\tlocal, _ := repository(t)\n139|\tpeer, _ := repository(t)\n140|\tleasedPeerSession(t, peer, idB, \"beta\")\n141|\tcreate(t, local, idB, \"different-record\")\n142|\treader := unionReader(t, local, peer)\n143|\t// The explicit peer selection never falls back, and the build\n144|\t// still validates the pinned UUID union: the contradictory local\n145|\t// record is integrity failure at construction.\n146|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n147|\t\tt.Fatalf(\"explicit build over divergent union = %v\", err)\n148|\t}\n149|\t// The mirror direction behaves the same: a leased local selection\n150|\t// against a divergent peer copy refuses without substituting it.\n151|\tlocalOnly, _ := repository(t)\n152|\tlocalRef := create(t, localOnly, idB, \"beta\")\n153|\tappendEvent(t, localOnly, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n154|\tdivergent, _ := repository(t)\n155|\tcreate(t, divergent, idB, \"different-record\")\n156|\tmirror := &Reader{\n157|\t\tLocal:              localOnly,\n158|\t\tLocalHostID:        hostB,\n159|\t\tAllowlistedPeerIDs: []string{hostA},\n160|\t\tPeers:              []PeerIndex{{hostA, divergent}},\n161|\t}\n162|\tif _, err := mirror.BuildPlan(PlanArgs{Selector: \"beta@local\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n163|\t\tt.Fatalf(\"local build over divergent union = %v\", err)\n164|\t}\n165|}\n166|\n167|func TestRevalidateUnionNameDriftStaysCurrent(t *testing.T) {\n168|\tlocal, _ := repository(t)\n169|\tpeer, _ := repository(t)\n170|\tleasedPeerSession(t, peer, idB, \"beta\")\n171|\treader := unionReader(t, local, peer)\n172|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta\", Action: ActionStatus})\n173|\tif plan.SourceHostID != hostA {\n174|\t\tt.Fatalf(\"source: %+v\", plan)\n175|\t}\n176|\t// A different UUID gaining the same live name locally moves fresh\n177|\t// name resolution but never retargets the pinned plan: names are\n178|\t// not re-resolved and the drift alone is not a defect.\n179|\tdrift := create(t, local, idC, \"beta\")\n180|\tappendEvent(t, local, idC, drift.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": drift.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n181|\tif err := reader.Revalidate(plan); err != nil {\n182|\t\tt.Fatalf(\"same-name gain invalidated pinned plan: %v\", err)\n183|\t}\n184|}","final_result":true}}}
