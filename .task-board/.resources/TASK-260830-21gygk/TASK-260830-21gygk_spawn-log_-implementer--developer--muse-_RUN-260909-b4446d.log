{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdc3","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":1340,"recorded_at":1780531400002675,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886f461b7de198227709b612d930","text":"Read text file `internal/sessquery/plan.go`.\n(239 line(s) above)\n240|// bindPlan reads the winning source completely and binds every plan\n241|// member from validated current facts. The session is located by its\n242|// UUID in the winning source only, never re-resolved by name.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tleaseRecordID, err := fingerprintWinningLease(selected.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\ttail, err := chainTail(selected.repo, selected.SessionID)\n279|\tif err != nil {\n280|\t\treturn SelectionPlan{}, err\n281|\t}\n282|\tplan := SelectionPlan{\n283|\t\tSelectorVersion:     SelectorVersion,\n284|\t\tSelector:            parsed.Raw,\n285|\t\tSessionID:           selected.SessionID,\n286|\t\tSessionRecordID:     recordID,\n287|\t\tSourceIndexDigest:   index,\n288|\t\tConfigurationDigest: configuration,\n289|\t\tLeaseRecordID:       leaseRecordID,\n290|\t\tLeaseEpoch:          projection.Winner.Epoch,\n291|\t\tLeaseID:             projection.Winner.LeaseID,\n292|\t\tOwnerHostID:         projection.OwnerHostID,\n293|\t\tAction:              action,\n294|\t\tDestinationHostID:   destination,\n295|\t\tExpectationDigest:   expectations,\n296|\t}\n297|\tif selected.PeerHostID == \"\" {\n298|\t\tif config.localHost == \"\" {\n299|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n300|\t\t}\n301|\t\tplan.SourceHostID = config.localHost\n302|\t} else {\n303|\t\tplan.SourceHostID = selected.PeerHostID\n304|\t\t// Null marks the local source only. An alias-less peer binds\n305|\t\t// empty: the host still distinguishes it from local.\n306|\t\talias := config.aliasFor(selected.PeerHostID)\n307|\t\taliasCopy := alias\n308|\t\tplan.SourceAlias = &aliasCopy\n309|\t}\n310|\tif tail != \"\" {\n311|\t\tplan.AuthorityHeads = []string{tail}\n312|\t} else {\n313|\t\tplan.AuthorityHeads = []string{}\n314|\t}\n315|\tif err := checkPlanShapes(plan); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n319|\t\treturn SelectionPlan{}, err\n320|\t}\n321|\treturn plan, nil\n322|}\n323|\n324|// chainTail returns the tail event digest of a validated session chain,\n325|// or empty when the chain carries no events yet.\n326|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n327|\tevents, err := repo.ListEvents(sessionID)\n328|\tif err != nil {\n329|\t\treturn \"\", err\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
