{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c605","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":349,"recorded_at":1780531400000693,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886b-8206-7702-aac2-865b4610e147"},"task_id":"01a0886b-8206-7702-aac2-865b4610e147","event":{"kind":"output","task_id":"01a0886b-8206-7702-aac2-865b4610e147","chunk":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|\t// ErrBootstrapIncomplete reports a complete authority read proving\n61|\t// a Session Record without any valid lease: an interrupted\n62|\t// persistence prefix for the bootstrap-recovery leaf (Section\n63|\t// 14.7.4), never a public summary. A failed read keeps its\n64|\t// read-failure class instead; corrupt authority is integrity\n65|\t// failure. Wire exit binding for a CLI surface belongs to that\n66|\t// surface's leaf; this library keeps the refusal class distinct\n67|\t// and stable.\n68|\tErrBootstrapIncomplete = errors.New(\"selector_bootstrap_incomplete\")\n69|\t// ErrObservationUnavailable reports a required summary observation\n70|\t// or host metadata fact that cannot be established from validated\n71|\t// inputs. Nothing is inferred in its place: no source alias stands\n72|\t// in for host metadata, and no absent observation mints liveness,\n73|\t// capability, workspace, or timestamp facts.\n74|\tErrObservationUnavailable = errors.New(\"selector_observation_unavailable\")\n75|)\n76|\n77|// PeerIndex binds a peer identity to its already persisted learned index.\n78|// Transport/authentication and installing peer indexes are upstream owners;\n79|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n80|type PeerIndex struct {\n81|\tHostID string\n82|\tRepo   *sessrepo.Repository\n83|}\n84|\n85|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n86|// configuration layer, separately from the learned indexes. An unlisted source\n87|// is never read. Failed reads from listed sources are errors, never\n88|// empty indexes that let resolution fall through to a lower-priority UUID.\n89|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n90|//\n91|// Aliases carries the exact configured peer-alias mapping (host ID to\n92|// alias) from the same configuration owner, kept separate from the\n93|// learned index handles: a mapping without a handle contributes no\n94|// learned names, and a handle without a mapping stays reachable through\n95|// the bare union and the \"id:\" host form but never through \"peer:\".\n96|// Alias comparison is always exact, never folded, trimmed, or decoded.\n97|//\n98|// HostMetadata and Observations carry the validated host and observation\n99|// facts the authoritative summary layer requires, from their respective\n100|// owners. They are consulted only by that layer: List and Status keep\n101|// the internal read model and refuse only the unrepresentable\n102|// record-only bootstrap.\n103|type Reader struct {\n104|\tLocal              *sessrepo.Repository\n105|\tLocalHostID        string\n106|\tAllowlistedPeerIDs []string\n107|\tPeers              []PeerIndex\n108|\tAliases            map[string]string\n109|\tHostMetadata       map[string]HostMetadata\n110|\tObservations       map[string]SessionObservations\n111|}\n112|\n113|// Summary contains only facts derived from verified session records and events.\n114|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n115|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n116|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n117|// process liveness and sync timestamps require their respective observation\n118|// owners and are deliberately not inferred from a record or a successful read.\n119|type Summary struct {\n120|\tProjection sessstate.Projection\n121|}\n122|\n123|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n124|// visible with their blocking reason and retry; failure to enumerate the index\n125|// fails the read. No durable state is written, even for an interrupted create.\n126|// A complete read proving a record without any valid lease refuses the whole\n127|// list with selector_bootstrap_incomplete: the interrupted prefix is never\n128|// silently omitted and never returned as a public summary.\n129|func (reader *Reader) List() ([]Summary, error) {\n130|\tif reader == nil || reader.Local == nil {\n131|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n132|\t}\n133|\trows, err := reader.read(reader.Local)\n134|\tif err != nil {\n135|\t\treturn nil, err\n136|\t}\n137|\tfor _, row := range rows {\n138|\t\tif err := checkSummaryRepresentable(row); err != nil {\n139|\t\t\treturn nil, err\n140|\t\t}\n141|\t}\n142|\treturn rows, nil\n143|}\n144|\n145|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n146|\trows, err := repo.ListSessions()\n147|\tif err != nil {\n148|\t\treturn nil, err\n149|\t}\n150|\tout := make([]Summary, 0, len(rows))\n151|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n152|\tfor _, row := range rows {\n153|\t\tprojection, err := projector.Project(row.SessionID)\n154|\t\tif err != nil {\n155|\t\t\treturn nil, err\n156|\t\t}\n157|\t\tout = append(out, Summary{Projection: projection})\n158|\t}\n159|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n160|\treturn out, nil\n161|}\n162|\n163|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n164|// the same path as Resolve, then projects from the selected repository. It\n165|// never treats a failed read as not found. Parked sessions can be inspected\n166|// by ID through InspectLocal, independently of live-name routing, so\n167|// operators retain access to the recovery diagnostics.\n168|func (reader *Reader) Status(selector string) (Summary, error) {\n169|\tselected, err := reader.Resolve(selector)\n170|\tif err != nil {\n171|\t\treturn Summary{}, err\n172|\t}\n173|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n174|\tif err != nil {\n175|\t\treturn Summary{}, err\n176|\t}\n177|\tsummary := Summary{Projection: projection}\n178|\tif err := checkSummaryRepresentable(summary); err != nil {\n179|\t\treturn Summary{}, err\n180|\t}\n181|\treturn summary, nil\n182|}\n183|\n184|// InspectLocal reads one local ID, including a parked or tombstoned session.\n185|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n186|\tif reader == nil || reader.Local == nil {\n187|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n188|\t}\n189|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n190|\tif err != nil {\n191|\t\treturn Summary{}, err\n192|\t}\n193|\treturn Summary{Projection: projection}, nil\n194|}\n195|\n196|// Selection identifies the session and source index, never an attach or mutation\n197|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n198|type Selection struct {\n199|\tSessionID  string\n200|\tPeerHostID string\n201|\trepo       *sessrepo.Repository\n202|}\n203|\n204|type candidate struct {\n205|\tsummary   Summary\n206|\tselection Selection\n207|}\n208|\n209|// Resolve applies one parsed selector through the single shared path:\n210|// grammar first, then effective-configuration validation, then the\n211|// source tier. A bare selector retains the exact Section 2.3 tiers:\n212|// local exact live name, allowlisted peer exact live name, exact UUID,\n213|// not found. An \"id:\" key bypasses names for the durable UUID in the\n214|// local and allowed-peer union. A qualified selector resolves its key\n215|// in exactly one source index with no fallback. ASCII folding detects\n216|// collisions within each name tier; it does not turn a unique case\n217|// variant into an exact match. Repository-parked entries (failed reads,\n218|// never tombstone evidence) and tombstoned entries (authoritative\n219|// tombstone evidence) are not live candidates. A tier that must be\n220|// read but cannot be read is a read failure, not permission to proceed\n221|// to a lower tier. This is logical index eligibility, not proof of\n222|// process liveness or safe attach/resume readiness; those decisions\n223|// belong to the action planner invoking plans at its boundaries.\n224|func (reader *Reader) Resolve(selector string) (Selection, error) {\n225|\tparsed, err := ParseSelector(selector)\n226|\tif err != nil {\n227|\t\treturn Selection{}, err\n228|\t}\n229|\tif reader == nil || reader.Local == nil {\n230|\t\treturn Selection{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n231|\t}\n232|\tconfig, err := reader.validatedConfiguration()\n233|\tif err != nil {\n234|\t\treturn Selection{}, err\n235|\t}\n236|\tif parsed.Source != SourceBare {\n237|\t\treturn reader.resolveExplicit(parsed, config)\n238|\t}\n239|\treturn reader.resolveBare(parsed, config)\n240|}\n241|\n242|// resolveBare applies the Section 2.3 tiers over the local and\n243|// allowed-peer union. Unread lower tiers are never consulted after a\n244|// unique higher-tier match; a tier that must be read but cannot be\n245|// read fails the resolution instead of falling through.\n246|func (reader *Reader) resolveBare(parsed Selector, config validatedConfig) (Selection, error) {\n247|\tlocal, err := reader.read(reader.Local)\n248|\tif err != nil {\n249|\t\treturn Selection{}, err\n250|\t}\n251|\tlocalLive := liveCandidates(local, reader.Local, \"\")\n252|\t// Peer tiers read lazily: a unique local name match never depends\n253|\t// on lower-tier reads, but any tier that must be read and cannot\n254|\t// be read fails instead of falling through.\n255|\tpeers, peersRead := []candidate(nil), false\n256|\treadPeers := func() ([]candidate, error) {\n257|\t\tif !peersRead {\n258|\t\t\tpeersRead = true\n259|\t\t\tvar err error\n260|\t\t\tpeers, err = reader.peerCandidates()\n261|\t\t\tif err != nil {\n262|\t\t\t\treturn nil, err\n263|\t\t\t}\n264|\t\t}\n265|\t\treturn peers, nil\n266|\t}\n267|\tif parsed.IDKey {\n268|\t\tunion, err := readPeers()\n269|\t\tif err != nil {\n270|\t\t\treturn Selection{}, err\n271|\t\t}\n272|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), append(localLive, union...), config)\n273|\t}\n274|\tif match, found, err := matchName(localLive, parsed.Key); found || err != nil {\n275|\t\treturn match, err\n276|\t}\n277|\tunion, err := readPeers()\n278|\tif err != nil {\n279|\t\treturn Selection{}, err\n280|\t}\n281|\tif match, found, err := matchName(union, parsed.Key); found || err != nil {\n282|\t\tif err != nil {\n283|\t\t\treturn Selection{}, err\n284|\t\t}\n285|\t\tif err := checkRecordAgreement(append(append([]candidate(nil), localLive...), union...), match); err != nil {\n286|\t\t\treturn Selection{}, err\n287|\t\t}\n288|\t\treturn match, nil\n289|\t}\n290|\tif parsed.UUIDShaped {\n291|\t\treturn selectIdentity(parsed.Key, append(localLive, union...), config)\n292|\t}\n293|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, parsed.Raw)\n294|}\n295|\n296|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n297|\tout := make([]candidate, 0, len(rows))\n298|\tfor _, row := range rows {\n299|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n300|\t\t\tcontinue\n301|\t\t}\n302|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n303|\t}\n304|\treturn out\n305|}\n306|\n307|// resolveExplicit selects a key in exactly one configured source index.\n308|// An explicit source never falls back to the local index, another peer,\n309|// a cached index from another source, or a union search, even when the\n310|// same name or UUID exists there: a miss in the selected source is not\n311|// found, and a source that cannot be completely read is a read failure.\n312|func (reader *Reader) resolveExplicit(parsed Selector, config validatedConfig) (Selection, error) {\n313|\trepo, peerHost, err := reader.locateSource(parsed, config)\n314|\tif err != nil {\n315|\t\treturn Selection{}, err\n316|\t}\n317|\trows, err := reader.readSource(repo, peerHost)\n318|\tif err != nil {\n319|\t\treturn Selection{}, err\n320|\t}\n321|\tlive := liveCandidates(rows, repo, peerHost)\n322|\tif parsed.IDKey {\n323|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)\n324|\t}\n325|\tif match, found, err := matchName(live, parsed.Key); found || err != nil {\n326|\t\treturn match, err\n327|\t}\n328|\tif parsed.UUIDShaped {\n329|\t\treturn selectIdentity(parsed.Key, live, config)\n330|\t}\n331|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))\n332|}\n333|\n334|// locateSource maps an explicit source to its index handle. An explicit\n335|// unknown alias or host is selector_source_not_found; a known but\n336|// disallowed peer is peer_not_allowlisted. The local source is always\n337|// admitted and needs no allowlist entry.\n338|func (reader *Reader) locateSource(parsed Selector, config validatedConfig) (*sessrepo.Repository, string, error) {\n339|\tswitch parsed.Source {\n340|\tcase SourceLocal:\n341|\t\treturn reader.Local, \"\", nil\n342|\tcase SourcePeerAlias:\n343|\t\thost, ok := config.hostForAlias(reader, parsed.SourceValue)\n344|\t\tif !ok {\n345|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)\n346|\t\t}\n347|\t\tif _, allowed := config.allowed[host]; !allowed {\n348|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)\n349|\t\t}\n350|\t\treturn reader.peerRepo(host)\n351|\tcase SourcePeerHost:\n352|\t\tif config.localHost != \"\" && parsed.SourceValue == config.localHost {\n353|\t\t\treturn reader.Local, \"\", nil\n354|\t\t}\n355|\t\tif !knownPeer(reader, parsed.SourceValue) {\n356|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for host %s\", ErrSourceNotFound, parsed.SourceValue)\n357|\t\t}\n358|\t\tif _, allowed := config.allowed[parsed.SourceValue]; !allowed {\n359|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, parsed.SourceValue)\n360|\t\t}\n361|\t\treturn reader.peerRepo(parsed.SourceValue)\n362|\tdefault:\n363|\t\treturn nil, \"\", fmt.Errorf(\"%w: unknown selector source\", ErrInvalidArgument)\n364|\t}\n365|}\n366|\n367|// knownPeer reports whether a host carries a configured learned index,\n368|// regardless of allowlisting or readability.\n369|func knownPeer(reader *Reader, host string) bool {\n370|\tfor _, peer := range reader.Peers {\n371|\t\tif peer.HostID == host {\n372|\t\t\treturn true\n373|\t\t}\n374|\t}\n375|\treturn false\n376|}\n377|\n378|// peerRepo binds one allowlisted peer host to its learned index handle.\n379|// A peer with no advertised index cannot be completely read, so\n380|// explicit selection refuses with the read-failure class instead of\n381|// treating the source as absent; union tiers simply learn nothing from\n382|// it. A listed index with an unavailable repository is the same failed\n383|// observation.\n384|func (reader *Reader) peerRepo(host string) (*sessrepo.Repository, string, error) {\n385|\tseen := false\n386|\tvar repo *sessrepo.Repository\n387|\tfor _, peer := range reader.Peers {\n388|\t\tif peer.HostID != host {\n389|\t\t\tcontinue\n390|\t\t}\n391|\t\tif seen {\n392|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, host)\n393|\t\t}\n394|\t\tseen = true\n395|\t\trepo = peer.Repo\n396|\t}\n397|\tif !seen {\n398|\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s advertises no learned index\", ErrSourceReadFailed, host)\n399|\t}\n400|\tif repo == nil {\n401|\t\treturn nil, \"\", peerReadFailed(host, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, host))\n402|\t}\n403|\treturn repo, host, nil\n404|}\n405|\n406|// readSource completes one source read. Local I-O failures keep their\n407|// repository error; remote failures carry the read-failure class while\n408|// preserving the underlying cause for errors.Is.\n409|func (reader *Reader) readSource(repo *sessrepo.Repository, peerHost string) ([]Summary, error) {\n410|\trows, err := reader.read(repo)\n411|\tif err != nil {\n412|\t\tif peerHost == \"\" {\n413|\t\t\treturn nil, err\n414|\t\t}\n415|\t\treturn nil, peerReadFailed(peerHost, err)\n416|\t}\n417|\treturn rows, nil\n418|}\n419|\n420|// peerReadFailed marks a remote-source read failure with its contract\n421|// class while preserving the underlying cause: a failed read is never\n422|// an absence that lets resolution fall through to another source.\n423|func peerReadFailed(host string, err error) error {\n424|\treturn errors.Join(fmt.Errorf(\"%w: peer %s index read failed\", ErrSourceReadFailed, host), err)\n425|}\n426|\n427|// describeSource names the selected source for refusal evidence: exact\n428|// literal alias or host, never a display name.\n429|func describeSource(parsed Selector) string {\n430|\tswitch parsed.Source {\n431|\tcase SourceLocal:\n432|\t\treturn \"local\"\n433|\tcase SourcePeerAlias:\n434|\t\treturn fmt.Sprintf(\"peer:%s\", parsed.SourceValue)\n435|\tcase SourcePeerHost:\n436|\t\treturn fmt.Sprintf(\"id:%s\", parsed.SourceValue)\n437|\tdefault:\n438|\t\treturn \"bare\"\n439|\t}\n440|}\n441|\n442|// selectIdentity selects a durable session UUID from live candidates\n443|// independent of names: the \"id:\" key form and the UUID tier. Copies\n444|// of one UUID deduplicate only when their immutable record digests\n445|// agree; disagreeing copies are inconsistent authority\n446|// (integrity_failure), not an ambiguity. Identical copies select the\n447|// bytewise smallest holder host.\n448|func selectIdentity(uuid string, pool []candidate, config validatedConfig) (Selection, error) {\n449|\tid, err := scalar.ParseUUIDv7(uuid)\n450|\tif err != nil {\n451|\t\treturn Selection{}, fmt.Errorf(\"%w: malformed session UUID: %v\", ErrInvalidArgument, err)\n452|\t}\n453|\tvar matches []candidate\n454|\tfor _, item := range pool {\n455|\t\tif item.selection.SessionID == id.String() {\n456|\t\t\tmatches = append(matches, item)\n457|\t\t}\n458|\t}\n459|\tif len(matches) == 0 {\n460|\t\treturn Selection{}, fmt.Errorf(\"%w: no live session with ID %q\", ErrNotFound, id.String())\n461|\t}\n462|\tfor _, item := range matches[1:] {\n463|\t\tif item.summary.Projection.RecordID != matches[0].summary.Projection.RecordID {\n464|\t\t\treturn Selection{}, fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, id.String())\n465|\t\t}\n466|\t}\n467|\tbest := matches[0]\n468|\tfor _, item := range matches[1:] {\n469|\t\tif holderHost(item.selection.PeerHostID, config.localHost) < holderHost(best.selection.PeerHostID, config.localHost) {\n470|\t\t\tbest = item\n471|\t\t}\n472|\t}\n473|\treturn best.selection, nil\n474|}\n475|\n476|// holderHost orders copy holders bytewise for the deterministic tie\n477|// break. PeerHostID is empty for local copies; while the local host\n478|// identity is unknown the local copy sorts before every peer,\n479|// preserving local priority there.\n480|func holderHost(peerHost, localHost string) string {\n481|\tif peerHost == \"\" {\n482|\t\tif localHost == \"\" {\n483|\t\t\treturn \"\"\n484|\t\t}\n485|\t\treturn localHost\n486|\t}\n487|\treturn peerHost\n488|}\n489|\n490|// checkRecordAgreement refuses inconsistent authority behind a name\n491|// match: every consulted live copy of the won UUID must carry the same\n492|// immutable record digest. Replicated identical copies stay one\n493|// identity; disagreeing copies are integrity failure, not ambiguity.\n494|func checkRecordAgreement(pool []candidate, won Selection) error {\n495|\tdigest := \"\"\n496|\tseen := false\n497|\tfor _, item := range pool {\n498|\t\tif item.selection.SessionID != won.SessionID {\n499|\t\t\tcontinue\n500|\t\t}\n(more lines below)","final_result":true}}}
