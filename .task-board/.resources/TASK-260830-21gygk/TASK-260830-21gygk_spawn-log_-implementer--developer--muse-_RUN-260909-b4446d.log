ties: []string{\"\"}}}\n191|\t\t}},\n192|\t}\n193|\tfor _, row := range cases {\n194|\t\tt.Run(row.name, func(t *testing.T) {\n195|\t\t\tsnapshotHosts, snapshotObs := reader.HostMetadata, reader.Observations\n196|\t\t\trow.mutate()\n197|\t\t\tdefer func() { reader.HostMetadata, reader.Observations = snapshotHosts, snapshotObs }()\n198|\t\t\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrInvalidConfig) {\n199|\t\t\t\tt.Fatalf(\"malformed authority input = %v, want invalid_config\", err)\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|func TestAuthoritativeOptionalObservations(t *testing.T) {\n206|\treader := summaryReader(t)\n207|\tpresent, workspace := true, false\n208|\treader.Observations = map[string]SessionObservations{idA: {\n209|\t\tProcessPresent:   &present,\n210|\t\tCapabilities:     []string{\"exec\", \"net\"},\n211|\t\tWorkspacePresent: &workspace,\n212|\t}}\n213|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n214|\tif err != nil {\n215|\t\tt.Fatal(err)\n216|\t}\n217|\tif summary.ProcessPresent == nil || !*summary.ProcessPresent {\n218|\t\tt.Fatalf(\"liveness: %+v\", summary)\n219|\t}\n220|\tif !reflect.DeepEqual(summary.Capabilities, []string{\"exec\", \"net\"}) {\n221|\t\tt.Fatalf(\"capabilities: %+v\", summary)\n222|\t}\n223|\tif summary.WorkspacePresent == nil || *summary.WorkspacePresent {\n224|\t\tt.Fatalf(\"workspace: %+v\", summary)\n225|\t}\n226|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
