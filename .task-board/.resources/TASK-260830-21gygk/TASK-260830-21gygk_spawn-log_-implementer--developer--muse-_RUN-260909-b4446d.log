ersion == \"4.0.0\" {\n727|\t\t\treturn terminalV4Payload()\n728|\t\t}\n729|\t\treturn map[string]any{\"backend\": \"tmux\", \"terminal_id\": \"ax-session\"}\n730|\tcase \"provider.launched\":\n731|\t\treturn map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"--dangerously-bypass-approvals-and-sandbox\"}\n732|\tcase \"provider.identified\":\n733|\t\treturn map[string]any{\"provider_identity_record_id\": digest, \"confidence\": \"exact\"}\n734|\tcase \"session.idle\":\n735|\t\treturn map[string]any{\"boundary_ref\": \"provider-event-1\", \"foreground_idle\": true, \"background_idle\": true}\n736|\tcase \"session.quiescing\":\n737|\t\treturn map[string]any{\"operation_id\": uuid, \"reason\": \"checkpoint\", \"input_blocked\": true}\n738|\tcase \"checkpoint.created\":\n739|\t\treturn map[string]any{\"checkpoint_id\": digest, \"kind\": \"manual\"}\n740|\tcase \"sync.completed\":\n741|\t\treturn map[string]any{\"peer_host_id\": peerHostID, \"checkpoint_id\": digest, \"manifest_ids\": []any{digest}, \"materialized\": true}\n742|\tcase \"session.stopped\":\n743|\t\treturn map[string]any{\"graceful\": true, \"checkpoint_id\": digest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}\n744|\tcase \"session.resumed\":\n745|\t\tif version == \"4.0.0\" {\n746|\t\t\tp := terminalV4Payload()\n747|\t\t\tp[\"checkpoint_id\"] = digest\n748|\t\t\tp[\"execution_profile\"] = \"yolo\"\n749|\t\t\tp[\"profile_source_event_id\"] = nil\n750|\t\t\treturn p\n751|\t\t}\n752|\t\treturn map[string]any{\"checkpoint_id\": digest, \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session\"}\n753|\tcase \"session.bootstrap_aborted\":\n754|\t\treturn map[string]any{\"operation_id\": uuid, \"failure_phase\": \"after_identity\", \"provider_identity_record_id\": digest, \"manager_session_ref\": nil, \"process_closed\": true, \"store_closed\": true, \"resume_allowed\": false}\n755|\tcase \"lease.transferred\":\n756|\t\treturn map[string]any{\"operation_id\": uuid, \"from_host_id\": hostID, \"to_host_id\": peerHostID, \"predecessor_lease_id\": priorLease, \"new_lease_id\": leaseID}\n757|\tcase \"lease.forced\":\n758|\t\treturn map[string]any{\"operation_id\": uuid, \"expected_owner_host_id\": hostID, \"expected_epoch\": json.Number(\"3\"), \"new_lease_id\": leaseID, \"checkpoint_id\": digest}\n759|\tcase \"session.parked\":\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8af","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":690,"recorded_at":1780531400001375,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886c10a77920a9f5dd53d42e8202","text":"Read text file `internal/sessquery/review_test.go`.\n1|// Independent-review regression tests for TASK-260830-21gygk,\n2|// carried from the CR revision 2 review bundle\n3|// (reviewer_regression_test.go) into the candidate: cross-source\n4|// authority divergence must refuse revalidation, record-only\n5|// bootstraps must refuse summaries, and every marshalled plan must\n6|// carry the required lease attestation.\n7|package sessquery\n8|\n9|import (\n10|\t\"encoding/json\"\n11|\t\"testing\"\n12|)\n13|\n14|func TestReviewerOtherSourceDivergenceMustRefuse(t *testing.T) {\n15|\tlocal, _ := repository(t)\n16|\tpeer, _ := repository(t)\n17|\tref := create(t, peer, idB, \"beta\")\n18|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n19|\treader := &Reader{Local: local, LocalHostID: hostB, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{HostID: hostA, Repo: peer}}}\n20|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n21|\tif err := reader.Revalidate(plan); err != nil {\n22|\t\tt.Fatal(err)\n23|\t}\n24|\tcreate(t, local, idB, \"different-record\")\n25|\tif _, err := reader.Resolve(\"id:\" + idB); err == nil {\n26|\t\tt.Fatal(\"diagnostic premise: expected record divergence\")\n27|\t} else {\n28|\t\tt.Logf(\"fresh Resolve: %v\", err)\n29|\t}\n30|\tif err := reader.Revalidate(plan); err == nil {\n31|\t\tt.Fatal(\"Revalidate accepted conflicting immutable record for the selected UUID in another allowed source\")\n32|\t}\n33|}\n34|func TestReviewerBootstrapSummaryMustRefuse(t *testing.T) {\n35|\tlocal, _ := repository(t)\n36|\tcreate(t, local, idA, \"alpha\")\n37|\treader := &Reader{Local: local, LocalHostID: hostA}\n38|\tt.Run(\"list\", func(t *testing.T) {\n39|\t\trows, err := reader.List()\n40|\t\tif err == nil {\n41|\t\t\tt.Fatalf(\"List accepted record-only bootstrap: rows=%d epoch=%d owner=%q\", len(rows), rows[0].Projection.Winner.Epoch, rows[0].Projection.OwnerHostID)\n42|\t\t}\n43|\t})\n44|\tt.Run(\"status\", func(t *testing.T) {\n45|\t\trow, err := reader.Status(\"alpha\")\n46|\t\tif err == nil {\n47|\t\t\tt.Fatalf(\"Status accepted record-only bootstrap: epoch=%d owner=%q\", row.Projection.Winner.Epoch, row.Projection.OwnerHostID)\n48|\t\t}\n49|\t})\n50|}\n51|func TestReviewerPlanRequiresLeaseRecord(t *testing.T) {\n52|\treader, _, _, _ := plannedSession(t)\n53|\treader.LocalHostID = hostA\n54|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n55|\traw, err := plan.Marshal()\n56|\tif err != nil {\n57|\t\tt.Fatal(err)\n58|\t}\n59|\tvar fields map[string]any\n60|\tif err := json.Unmarshal(raw, &fields); err != nil {\n61|\t\tt.Fatal(err)\n62|\t}\n63|\tif _, ok := fields[\"lease_record_id\"]; !ok {\n64|\t\tt.Fatal(\"plan omits required validated lease_record_id\")\n65|\t}\n66|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
