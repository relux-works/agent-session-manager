{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d631","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":2419,"recorded_at":1780531400004833,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a08872-b3bf-7992-b1c1-b11bf8279889"},"task_id":"01a08872-b3bf-7992-b1c1-b11bf8279889","event":{"kind":"output","task_id":"01a08872-b3bf-7992-b1c1-b11bf8279889","chunk":"Read text file `internal/sessquery/plan_test.go`.\n(358 line(s) above)\n359|\tt.Run(\"record replacement changes digest\", func(t *testing.T) {\n360|\t\treader, root, _, _ := plannedSession(t)\n361|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n362|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), record(t, idA, \"renamed\"), 0o600); err != nil {\n363|\t\t\tt.Fatal(err)\n364|\t\t}\n365|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n366|\t})\n367|\tt.Run(\"alias remap changes binding\", func(t *testing.T) {\n368|\t\tlocal, _ := repository(t)\n369|\t\trepoA, rootA := repository(t)\n370|\t\trepoB, rootB := repository(t)\n371|\t\tref := create(t, repoA, idA, \"shared\")\n372|\t\tappendEvent(t, repoA, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n373|\t\tcopySessionDir(t, rootA, rootB, idA)\n374|\t\treader := &Reader{\n375|\t\t\tLocal:              local,\n376|\t\t\tAllowlistedPeerIDs: []string{hostA, hostB},\n377|\t\t\tPeers:              []PeerIndex{{hostA, repoA}, {hostB, repoB}},\n378|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n379|\t\t}\n380|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"shared@peer:ws\", Action: ActionStatus})\n381|\t\tif plan.SourceHostID != hostA {\n382|\t\t\tt.Fatalf(\"source: %+v\", plan)\n383|\t\t}\n384|\t\treader.Aliases = map[string]string{hostB: \"ws\"}\n385|\t\tmustStale(t, reader.Revalidate(plan), \"source binding changed\")\n386|\t})\n387|\tt.Run(\"unrelated mapping change changes configuration\", func(t *testing.T) {\n388|\t\treader, _, _, _ := plannedSession(t)\n389|\t\tpeer, _ := repository(t)\n390|\t\treader.Peers = []PeerIndex{{hostC, peer}}\n391|\t\treader.AllowlistedPeerIDs = []string{hostC}\n392|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n393|\t\treader.Aliases = map[string]string{hostC: \"ws\"}\n394|\t\tmustStale(t, reader.Revalidate(plan), \"configuration changed\")\n395|\t})\n396|\tt.Run(\"revocation refuses allowlist\", func(t *testing.T) {\n397|\t\tlocal, _ := repository(t)\n398|\t\tpeer, _ := repository(t)\n399|\t\tlocalRef := create(t, local, idA, \"alpha\")\n400|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n401|\t\tpeerRef := create(t, peer, idB, \"beta\")\n402|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n403|\t\treader := &Reader{\n404|\t\t\tLocal:              local,\n405|\t\t\tAllowlistedPeerIDs: []string{hostA},\n406|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n407|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n408|\t\t}\n409|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n410|\t\treader.AllowlistedPeerIDs = nil\n411|\t\terr := reader.Revalidate(plan)\n412|\t\tif !errors.Is(err, ErrPeerNotAllowlisted) {\n413|\t\t\tt.Fatalf(\"revocation = %v, want peer_not_allowlisted\", err)\n414|\t\t}\n415|\t})\n416|\tt.Run(\"tombstone invalidates live plan\", func(t *testing.T) {\n417|\t\treader, _, ref, created := plannedSession(t)\n418|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n419|\t\tfailed := appendEvent(t, reader.Local, idA, created, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n420|\t\t_ = ref\n421|\t\tappendEvent(t, reader.Local, idA, failed, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n422|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n423|\t})\n424|\tt.Run(\"deletion empties selection\", func(t *testing.T) {\n425|\t\treader, root, _, _ := plannedSession(t)\n426|\t\t// A surviving sibling keeps the index readable, so only the\n427|\t\t// absence check can report the planned identity: substituting\n428|\t\t// the sibling must never validate.\n429|\t\tcreate(t, reader.Local, idB, \"bravo\")\n430|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n431|\t\tif err := os.RemoveAll(filepath.Join(root, \"sessions\", idA)); err != nil {\n432|\t\t\tt.Fatal(err)\n433|\t\t}\n434|\t\tmustStale(t, reader.Revalidate(plan), \"selection absent from source index\")\n435|\t})\n436|\tt.Run(\"unrelated session change changes index\", func(t *testing.T) {\n437|\t\treader, _, _, _ := plannedSession(t)\n438|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n(more lines below)","final_result":true}}}
