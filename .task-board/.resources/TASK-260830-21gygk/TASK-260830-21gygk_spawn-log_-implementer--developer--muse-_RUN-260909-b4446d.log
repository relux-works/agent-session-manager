{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f5","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":725,"recorded_at":1780531400001445,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886c-1eb4-7bf3-9c92-55a6840aea30"},"task_id":"01a0886c-1eb4-7bf3-9c92-55a6840aea30","event":{"kind":"output","task_id":"01a0886c-1eb4-7bf3-9c92-55a6840aea30","chunk":"Read text file `internal/sessquery/summary_test.go`.\n1|// Authoritative summary tests for TASK-260830-21gygk (SPEC 14.7.3):\n2|// bootstrap refusal, whole-list refusal, validated host and\n3|// observation inputs, and observation-unavailable classification,\n4|// all driven through the production summary entries.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"reflect\"\n10|\t\"testing\"\n11|)\n12|\n13|// summaryReader builds a leased local session with host metadata for\n14|// its owner and returns the reader.\n15|func summaryReader(t *testing.T) *Reader {\n16|\tt.Helper()\n17|\trepo, _ := repository(t)\n18|\tref := create(t, repo, idA, \"alpha\")\n19|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n20|\treturn &Reader{\n21|\t\tLocal:        repo,\n22|\t\tLocalHostID:  hostA,\n23|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n24|\t}\n25|}\n26|\n27|func TestSummaryBootstrapRefusals(t *testing.T) {\n28|\tlocal, _ := repository(t)\n29|\tcreate(t, local, idA, \"alpha\")\n30|\treader := &Reader{Local: local, LocalHostID: hostA}\n31|\tfor _, selector := range []string{\"alpha\", idA, \"id:\" + idA, \"alpha@local\"} {\n32|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n33|\t\t\tt.Fatalf(\"Status(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n34|\t\t}\n35|\t\tif _, err := reader.AuthoritativeStatus(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n36|\t\t\tt.Fatalf(\"AuthoritativeStatus(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n37|\t\t}\n38|\t}\n39|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrBootstrapIncomplete) {\n40|\t\tt.Fatalf(\"AuthoritativeList = %v, want selector_bootstrap_incomplete\", err)\n41|\t}\n42|\t// Explicit local inspection keeps raw access to the recovery\n43|\t// diagnostics: it is not a public summary entry.\n44|\tinspected, err := reader.InspectLocal(idA)\n45|\tif err != nil || inspected.Projection.SessionID != idA {\n46|\t\tt.Fatalf(\"InspectLocal = %+v, %v\", inspected, err)\n47|\t}\n48|}\n49|\n50|func TestSummaryMixedListRefusesWhole(t *testing.T) {\n51|\trepo, _ := repository(t)\n52|\thealthy := create(t, repo, idA, \"alpha\")\n53|\tappendEvent(t, repo, idA, healthy.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": healthy.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n54|\tcreate(t, repo, idB, \"Zed\")\n55|\treader := &Reader{\n56|\t\tLocal:        repo,\n57|\t\tLocalHostID:  hostA,\n58|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n59|\t}\n60|\t// One unrepresentable record refuses the whole document: no\n61|\t// partial rows escape, and the healthy entry is not silently\n62|\t// kept while the incomplete one is omitted.\n63|\trows, err := reader.List()\n64|\tif !errors.Is(err, ErrBootstrapIncomplete) || rows != nil {\n65|\t\tt.Fatalf(\"List = %d rows, %v, want whole selector_bootstrap_incomplete refusal\", len(rows), err)\n66|\t}\n67|\tauthorized, err := reader.AuthoritativeList()\n68|\tif !errors.Is(err, ErrBootstrapIncomplete) || authorized != nil {\n69|\t\tt.Fatalf(\"AuthoritativeList = %d rows, %v, want whole refusal\", len(authorized), err)\n70|\t}\n71|}\n72|\n73|func TestAuthoritativeStatusHealthy(t *testing.T) {\n74|\treader := summaryReader(t)\n75|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\tif summary.SessionID != idA || summary.Name != \"alpha\" || summary.Kind != \"direct\" || summary.ProviderID != \"codex\" || summary.State != \"creating\" {\n80|\t\tt.Fatalf(\"identity: %+v\", summary)\n81|\t}\n82|\tif summary.OwnerHostID != hostA || summary.OwnerHostName != \"primary\" || summary.LeaseEpoch != 1 || summary.LeaseID != lease || summary.LocalRole != \"owner\" {\n83|\t\tt.Fatalf(\"authority: %+v\", summary)\n84|\t}\n85|\t// Before the first checkpoint both checkpoint members are null;\n86|\t// unobserved optionals stay nil instead of minted facts.\n87|\tif !summary.HasCheckpoint && (summary.NewestCheckpointID != nil || summary.NewestCheckpointCreatedAt != nil) {\n88|\t\tt.Fatalf(\"checkpoint before first checkpoint: %+v\", summary)\n89|\t}\n90|\tif summary.ProcessPresent != nil || summary.Capabilities != nil || summary.WorkspacePresent != nil {\n91|\t\tt.Fatalf(\"minted observations: %+v\", summary)\n92|\t}\n93|\tlist, err := reader.AuthoritativeList()\n94|\tif err != nil || len(list) != 1 || !reflect.DeepEqual(list[0], summary) {\n95|\t\tt.Fatalf(\"list/status disagreement: %+v %v\", list, err)\n96|\t}\n97|}\n98|\n99|func TestAuthoritativeMissingHostMetadataRefuses(t *testing.T) {\n100|\treader := summaryReader(t)\n101|\t// The internal status stays representable: only the authoritative\n102|\t// layer requires the validated owner name.\n103|\tif _, err := reader.Status(\"alpha\"); err != nil {\n104|\t\tt.Fatal(err)\n105|\t}\n106|\treader.HostMetadata = nil\n107|\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrObservationUnavailable) {\n108|\t\tt.Fatalf(\"missing host metadata = %v, want selector_observation_unavailable\", err)\n109|\t}\n110|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrObservationUnavailable) {\n111|\t\tt.Fatalf(\"missing host metadata list = %v, want selector_observation_unavailable\", err)\n112|\t}\n113|\t// The source alias never substitutes for host metadata.\n114|\treader.HostMetadata = map[string]HostMetadata{hostB: {DisplayName: \"workstation\"}}\n115|\treader.Aliases = map[string]string{hostB: \"workstation\"}\n116|\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrObservationUnavailable) {\n117|\t\tt.Fatalf(\"alias-substituted metadata = %v, want selector_observation_unavailable\", err)\n118|\t}\n119|}\n120|\n121|func TestAuthoritativeUnknownLocalHostRefuses(t *testing.T) {\n122|\treader := summaryReader(t)\n123|\treader.LocalHostID = \"\"\n124|\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrObservationUnavailable) {\n125|\t\tt.Fatalf(\"unknown local host = %v, want selector_observation_unavailable\", err)\n126|\t}\n127|}\n128|\n129|func TestAuthoritativeCheckpointRequiresTimestamp(t *testing.T) {\n130|\trepo, _ := repository(t)\n131|\tref := create(t, repo, idA, \"Checkpointed\")\n132|\tprevious := ref.RecordID\n133|\trows := []struct {\n134|\t\ttyp     string\n135|\t\tpayload map[string]any\n136|\t}{\n137|\t\t{\"session.created\", map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB}},\n138|\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n139|\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n140|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n141|\t}\n142|\tfor index, row := range rows {\n143|\t\tprevious = appendEvent(t, repo, idA, previous, row.typ, index+1, row.payload)\n144|\t}\n145|\treader := &Reader{\n146|\t\tLocal:        repo,\n147|\t\tLocalHostID:  hostA,\n148|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n149|\t}\n150|\tif _, err := reader.AuthoritativeStatus(\"Checkpointed\"); !errors.Is(err, ErrObservationUnavailable) {\n151|\t\tt.Fatalf(\"checkpoint without timestamp observation = %v, want selector_observation_unavailable\", err)\n152|\t}\n153|\tstamp := \"2026-08-19T04:09:30.000Z\"\n154|\treader.Observations = map[string]SessionObservations{idA: {NewestCheckpointCreatedAt: &stamp}}\n155|\tsummary, err := reader.AuthoritativeStatus(\"Checkpointed\")\n156|\tif err != nil {\n157|\t\tt.Fatal(err)\n158|\t}\n159|\tif !summary.HasCheckpoint || summary.NewestCheckpointID == nil || *summary.NewestCheckpointID != zeroDigest {\n160|\t\tt.Fatalf(\"checkpoint id: %+v\", summary)\n161|\t}\n162|\tif summary.NewestCheckpointCreatedAt == nil || *summary.NewestCheckpointCreatedAt != stamp {\n163|\t\tt.Fatalf(\"checkpoint timestamp: %+v\", summary)\n164|\t}\n165|}\n166|\n167|func TestAuthoritativeInputValidation(t *testing.T) {\n168|\treader := summaryReader(t)\n169|\tbadStamp := \"not-a-timestamp\"\n170|\tcases := []struct {\n171|\t\tname   string\n172|\t\tmutate func()\n173|\t}{\n174|\t\t{\"host key\", func() {\n175|\t\t\treader.HostMetadata = map[string]HostMetadata{\"nope\": {DisplayName: \"primary\"}}\n176|\t\t}},\n177|\t\t{\"empty display name\", func() {\n178|\t\t\treader.HostMetadata = map[string]HostMetadata{hostA: {}}\n179|\t\t}},\n180|\t\t{\"control display name\", func() {\n181|\t\t\treader.HostMetadata = map[string]HostMetadata{hostA: {DisplayName: \"a\\tb\"}}\n182|\t\t}},\n183|\t\t{\"observation key\", func() {\n184|\t\t\treader.Observations = map[string]SessionObservations{\"nope\": {}}\n185|\t\t}},\n186|\t\t{\"malformed timestamp\", func() {\n187|\t\t\treader.Observations = map[string]SessionObservations{idA: {NewestCheckpointCreatedAt: &badStamp}}\n188|\t\t}},\n189|\t\t{\"empty capability\", func() {\n190|\t\t\treader.Observations = map[string]SessionObservations{idA: {Capabilities: []string{\"\"}}}\n191|\t\t}},\n192|\t}\n193|\tfor _, row := range cases {\n194|\t\tt.Run(row.name, func(t *testing.T) {\n195|\t\t\tsnapshotHosts, snapshotObs := reader.HostMetadata, reader.Observations\n196|\t\t\trow.mutate()\n197|\t\t\tdefer func() { reader.HostMetadata, reader.Observations = snapshotHosts, snapshotObs }()\n198|\t\t\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrInvalidConfig) {\n199|\t\t\t\tt.Fatalf(\"malformed authority input = %v, want invalid_config\", err)\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|func TestAuthoritativeOptionalObservations(t *testing.T) {\n206|\treader := summaryReader(t)\n207|\tpresent, workspace := true, false\n208|\treader.Observations = map[string]SessionObservations{idA: {\n209|\t\tProcessPresent:   &present,\n210|\t\tCapabilities:     []string{\"exec\", \"net\"},\n211|\t\tWorkspacePresent: &workspace,\n212|\t}}\n213|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n214|\tif err != nil {\n215|\t\tt.Fatal(err)\n216|\t}\n217|\tif summary.ProcessPresent == nil || !*summary.ProcessPresent {\n218|\t\tt.Fatalf(\"liveness: %+v\", summary)\n219|\t}\n220|\tif !reflect.DeepEqual(summary.Capabilities, []string{\"exec\", \"net\"}) {\n221|\t\tt.Fatalf(\"capabilities: %+v\", summary)\n222|\t}\n223|\tif summary.WorkspacePresent == nil || *summary.WorkspacePresent {\n224|\t\tt.Fatalf(\"workspace: %+v\", summary)\n225|\t}\n226|}","final_result":true}}}
