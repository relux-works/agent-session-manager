yObjectIdentity(raw)\\ninternal/sessrepo/chain.go:86:// decodeSessionEvent runs the same three layers for Session Events: strict\\ninternal/sessrepo/chain.go:88:func decodeSessionEvent(raw []byte) (eventView, error) {\\ninternal/sessrepo/chain.go:100:\\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\\ninternal/sessrepo/chain.go:273:\\trecord, err := decodeSessionRecord(recordBytes)\\ninternal/sessrepo/chain.go:286:\\t\\tdigest, field, err := canonicaljson.VerifyObjectIdentity(blob)\\ninternal/sessrepo/doc.go:15://     production VerifyObjectIdentity entry. Entry decodes refuse a foreign\\ninternal/sessrepo/sessrepo.go:158:\\trecord, err := decodeSessionRecord(recordJSON)\\ninternal/sessrepo/sessrepo.go:278:\\tevent, err := decodeSessionEvent(eventJSON)\\ninternal/sessrepo/sessrepo_test.go:115:\\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\\ninternal/sessrepo/sessrepo_test.go:117:\\t\\tt.Fatalf(\\\"CalculateObjectIdentity(staged record) error = %v\\\", err)\\ninternal/sessrepo/sessrepo_test.go:124:\\tif _, _, err := canonicaljson.VerifyObjectIdentity(out); err != nil {\\ninternal/sessrepo/sessrepo_test.go:125:\\t\\tt.Fatalf(\\\"VerifyObjectIdentity(built record) error = %v\\\", err)\\ninternal/sessrepo/sessrepo_test.go:157:\\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\\ninternal/sessrepo/sessrepo_test.go:159:\\t\\tt.Fatalf(\\\"CalculateObjectIdentity(staged event) error = %v\\\", err)\\ninternal/sessrepo/sessrepo_test.go:166:\\tif _, _, err := canonicaljson.VerifyObjectIdentity(out); err != nil {\\ninternal/sessrepo/sessrepo_test.go:167:\\t\\tt.Fatalf(\\\"VerifyObjectIdentity(built event) error = %v\\\", err)\\ninternal/sessrepo/sessrepo_test.go:521:\\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\\ninternal/sessrepo/sessrepo_test.go:555:// them one arm later with the same sentinel — decodeSessionEvent runs the\\ninternal/sessrepo/sessrepo_test.go:639:\\t\\tif _, _, err := canonicaljson.VerifyO