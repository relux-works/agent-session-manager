{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68b","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":416,"recorded_at":1780531400000827,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886b-9728-7af2-bcd3-2413ad8b77a1"},"task_id":"01a0886b-9728-7af2-bcd3-2413ad8b77a1","event":{"kind":"output","task_id":"01a0886b-9728-7af2-bcd3-2413ad8b77a1","chunk":"Read text file `internal/sessquery/query.go`.\n(499 line(s) above)\n500|\t\t}\n501|\t\tif !seen {\n502|\t\t\tdigest, seen = item.summary.Projection.RecordID, true\n503|\t\t\tcontinue\n504|\t\t}\n505|\t\tif item.summary.Projection.RecordID != digest {\n506|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, won.SessionID)\n507|\t\t}\n508|\t}\n509|\treturn nil\n510|}\n511|\n512|func (reader *Reader) peerCandidates() ([]candidate, error) {\n513|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n514|\tsort.Strings(ids)\n515|\tvar out []candidate\n516|\tfor index, id := range ids {\n517|\t\tif index > 0 && id == ids[index-1] {\n518|\t\t\tcontinue\n519|\t\t}\n520|\t\tvar repo *sessrepo.Repository\n521|\t\tfound := false\n522|\t\tfor _, peer := range reader.Peers {\n523|\t\t\tif peer.HostID != id {\n524|\t\t\t\tcontinue\n525|\t\t\t}\n526|\t\t\tif found {\n527|\t\t\t\treturn nil, fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, id)\n528|\t\t\t}\n529|\t\t\tfound = true\n530|\t\t\trepo = peer.Repo\n531|\t\t}\n532|\t\t// An allowlisted peer with no learned index contributes no learned names.\n533|\t\t// A listed index with an unavailable repository is a failed observation.\n534|\t\tif !found {\n535|\t\t\tcontinue\n536|\t\t}\n537|\t\tif repo == nil {\n538|\t\t\treturn nil, peerReadFailed(id, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, id))\n539|\t\t}\n540|\t\trows, err := reader.read(repo)\n541|\t\tif err != nil {\n542|\t\t\treturn nil, peerReadFailed(id, err)\n543|\t\t}\n544|\t\tout = append(out, liveCandidates(rows, repo, id)...)\n545|\t}\n546|\treturn out, nil\n547|}\n548|\n549|func matchName(items []candidate, selector string) (Selection, bool, error) {\n550|\t// A replicated session is one identity, regardless of how many peers learned\n551|\t// it. Distinct session IDs in the folded bucket are an ambiguity.\n552|\tids := make(map[string]struct{})\n553|\tvar exact *Selection\n554|\tfor _, item := range items {\n555|\t\tif asciiFold(item.summary.Projection.Name) != asciiFold(selector) {\n556|\t\t\tcontinue\n557|\t\t}\n558|\t\tids[item.selection.SessionID] = struct{}{}\n559|\t\tif item.summary.Projection.Name == selector && exact == nil {\n560|\t\t\tselection := item.selection\n561|\t\t\texact = &selection\n562|\t\t}\n563|\t}\n564|\tif len(ids) > 1 {\n565|\t\treturn Selection{}, false, fmt.Errorf(\"%w: name %q collides across %d sessions\", ErrAmbiguous, selector, len(ids))\n566|\t}\n567|\tif exact != nil {\n568|\t\treturn *exact, true, nil\n569|\t}\n570|\treturn Selection{}, false, nil\n571|}\n572|\n573|func asciiFold(value string) string {\n574|\tfolded := []byte(value)\n575|\tfor index, character := range folded {\n576|\t\tif character >= 'A' && character <= 'Z' {\n577|\t\t\tfolded[index] += 'a' - 'A'\n578|\t\t}\n579|\t}\n580|\treturn string(folded)\n581|}","final_result":true}}}
