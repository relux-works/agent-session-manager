, err := reader.readSource(repo, sourcePeer)\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\tvar recordID string\n80|\tabsent := true\n81|\tfor _, row := range rows {\n82|\t\tif row.Projection.SessionID == plan.SessionID {\n83|\t\t\trecordID, absent = row.Projection.RecordID, false\n84|\t\t\tbreak\n85|\t\t}\n86|\t}\n87|\tif absent {\n88|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n89|\t}\n90|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n91|\tif err != nil {\n92|\t\treturn err\n93|\t}\n94|\tif recordID != plan.SessionRecordID {\n95|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n96|\t}\n97|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\n98|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n99|\t}\n100|\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\n101|\tif err != nil {\n102|\t\treturn err\n103|\t}\n104|\tif leaseRecordID != plan.LeaseRecordID {\n105|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n106|\t}\n107|\ttail, err := chainTail(repo, plan.SessionID)\n108|\tif err != nil {\n109|\t\tif sourcePeer == \"\" {\n110|\t\t\treturn err\n111|\t\t}\n112|\t\treturn peerReadFailed(sourcePeer, err)\n113|\t}\n114|\theads := []string{}\n115|\tif tail != \"\" {\n116|\t\theads = []string{tail}\n117|\t}\n118|\tif !equalStrings(heads, plan.AuthorityHeads) {\n119|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n120|\t}\n121|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n122|\tif err != nil {\n123|\t\treturn err\n124|\t}\n125|\tif index != plan.SourceIndexDigest {\n126|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n127|\t}\n128|\treturn reader.validateAuthorityUnion(plan, config, sourcePeer)\n129|}\n130|\n131|// validateAuthorityUnion validates the complete current authority for\n132|// the pinned session UUID across every allowed source except the\n133|// already validated plan source. The session is located by UUID in\n134|// each source; names are never re-resolved and no selection is\n135|// substituted. A non-parked copy carrying a disagreeing immutable\n136|// record digest is inconsistent authority (integrity_failure, the same\n137|// class Resolve reports for disagreeing copies). Authoritative\n138|// tombstone evidence or a contradictory observed winning lease in\n139|// another source invalidates the live plan (selector_plan_stale). A\n140|// copy that observes no winning lease yet cannot contradict the bound\n141|// lease and is skipped for the lease check, while its record digest\n142|// still binds. Parked copies are failed observations, never evidence,\n143|// and absence in a source is not contradiction. A source that must be\n144|// read but cannot be read keeps its read-failure class: without the\n145|// complete union the plan cannot be shown current.\n146|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n147|\tif sourcePeer != \"\" {\n148|\t\trows, err := reader.read(reader.Local)\n149|\t\tif err != nil {\n150|\t\t\treturn err\n151|\t\t}\n152|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n153|\t\t\treturn err\n154|\t\t}\n155|\t}\n156|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n157|\tsort.Strings(ids)\n158|\tfor index, id := range ids {\n159|\t\tif index > 0 && id == ids[index-1] {\n160|\t\t\tcontinue\n161|\t\t}\n162|\t\tif id == sourcePeer {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\t// An allowlisted peer with no advertised learned index\n166|\t\t// contributes no authority; a known handle that cannot be\n167|\t\t// read is a failed observation of a source that must be\n168|\t\t// read, never absence.\n169|\t\tif isAbsentPeerIndex(reader, id) {\n(more lines below)","final_result":true}}}
