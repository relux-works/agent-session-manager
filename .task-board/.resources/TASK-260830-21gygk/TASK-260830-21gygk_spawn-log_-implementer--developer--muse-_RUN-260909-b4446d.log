eated\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n520|\t\treader := &Reader{\n521|\t\t\tLocal:              local,\n522|\t\t\tAllowlistedPeerIDs: []string{hostA},\n523|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n524|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n525|\t\t}\n526|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n527|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n528|\t\t\tt.Fatal(err)\n529|\t\t}\n530|\t\t// The local index holds a live \"beta\" under another UUID, but\n531|\t\t// revalidation rereads the plan source only: no substitution.\n532|\t\tif err := reader.Revalidate(plan); !errors.Is(err, ErrSourceReadFailed) {\n533|\t\t\tt.Fatalf(\"revalidation fell back: %v\", err)\n534|\t\t}\n535|\t})\n536|}\n537|\n538|func TestRevalidateMalformedPlans(t *testing.T) {\n539|\treader, _, _, _ := plannedSession(t)\n540|\tvalid := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n541|\tcases := []struct {\n542|\t\tname   string\n543|\t\tmutate func(plan *SelectionPlan)\n544|\t}{\n(more lines below)","final_result":true}}}
