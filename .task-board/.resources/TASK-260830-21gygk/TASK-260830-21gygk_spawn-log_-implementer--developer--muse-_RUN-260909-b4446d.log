he same\n23|// observation. The digest is recomputed from validated facts on every\n24|// build and revalidation; no digest is fabricated and no placeholder\n25|// stands in for a missing lease. A complete read proving a record\n26|// without any valid lease refuses selector_bootstrap_incomplete\n27|// instead of binding an empty triple, and a local selection without a\n28|// known local host refuses invalid_config instead of binding an empty\n29|// source host.\n30|//\n31|// Revalidation rereads the current configuration and the plan's source,\n32|// validates the same immutable record, the current winning lease, and\n33|// the action prerequisites this leaf can check, compares every bound\n34|// plan fact in a fixed order, and then validates the complete\n35|// authority union for the pinned session UUID across the local and\n36|// every allowlisted source: a contradictory immutable record is\n37|// integrity failure, a contradictory winning lease or fresh tombstone\n38|// evidence is stale. A changed mapping, alias, allowlist, transport,\n39|// source index, record, authority head, lease, action, destination, or\n40|// expectation invalidates the plan with selector_plan_stale naming the\n41|// first diverged member; explicit authorization revocation returns\n42|// peer_not_allowlisted; failed reads retain their read-failure\n43|// classification. Revalidation never re-resolves by name, substitutes\n44|// a same-named session, silently replans, transfers a lease, or reuses\n45|// confirmation for new facts.\n46|//\n47|// Effect authorization beyond read projection — fencing, commit,\n48|// retry, recovery, remote dispatch/admission, and transport-resume\n49|// prerequisites, and the composed per-endpoint invocation bindings —\n50|// belongs to the CLI and lifecycle owners, which invoke Revalidate at\n51|// every boundary in BoundariesFor for their action. A plan built here\n52|// authorizes read projection only.\n53|package sessquery\n54|\n55|import (\n56|\t\"fmt\"\n57|\n58|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n59|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n60|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n61|)\n62|\n63|// SelectorVersion is the exact selector contract version every plan binds.\n64|const SelectorVersion = \"1.0.0\"\n65|\n66|// Plan actions admitted by the Section 14.7.2 boundary matrix. Each is\n67|// an existing command/action tag; binding one selects it, never an\n68|// umbrella bypass.\n69|const (\n70|\tActionStatus      = \"status\"\n71|\tActionAttach      = \"attach\"\n72|\tActionTakeover    = \"takeover\"\n73|\tActionFork        = \"fork\"\n74|\tActionStop        = \"stop\"\n75|\tActionResume      = \"resume\"\n76|\tActionSync        = \"sync\"\n77|\tActionDiff        = \"diff\"\n78|\tActionMaterialize = \"materialize\"\n79|\tActionSetProfile  = \"session.set-profile\"\n80|\tActionLogs        = \"logs\"\n81|\tActionCancel      = \"cancel\"\n82|)\n83|\n84|// Plan boundaries from the normative action/boundary matrix. A boundary\n85|// is reached only when the existing operation reaches that phase; these\n86|// rows introduce no new effects.\n87|const (\n88|\tBoundaryProjection      = \"projection\"\n89|\tBoundaryPreEffect       = \"pre-effect\"\n90|\tBoundaryFencing         = \"fencing\"\n91|\tBoundaryCommit          = \"commit\"\n92|\tBoundaryRetry           = \"retry\"\n93|\tBoundaryRecovery        = \"recovery\"\n94|\tBoundaryRemoteDispatch  = \"remote-dispatch\"\n95|\tBoundaryRemoteAdmission = \"remote-admission\"\n96|\tBoundaryTransportResume = \"transport-resume\"\n97|)\n98|\n99|// planBoundaries is the closed action/boundary matrix: every action has\n100|// exactly its normative row, and an unknown action has none.\n101|var planBoundaries = map[string][]string{\n102|\tActionStatus:      {BoundaryProjection, BoundaryRetry},\n103|\tActionAttach:      {BoundaryPreEffect, BoundaryFencing, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n104|\tActionTakeover:    {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n105|\tActionFork:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n106|\tActionStop:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n107|\tActionResume:      {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n108|\tActionSync:        {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n109|\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n110|\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n111|\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n112|\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n113|\tActionCancel:      {BoundaryProjection},\n114|}\n115|\n116|// BoundariesFor returns the required boundary classes for a plan\n117|// action. The boolean reports whether the action is a known tag; an\n118|// unknown action binds no boundary and builds no plan.\n119|func BoundariesFor(action string) ([]string, bool) {\n120|\tboundaries, ok := planBoundaries[action]\n121|\tif !ok {\n122|\t\treturn nil, false\n123|\t}\n124|\treturn append([]string(nil), boundaries...), true\n125|}\n126|\n127|// SelectionPlan is the machine-local immutable binding of one selector\n128|// resolution. All members are values, never references: there is no\n129|// mutator, and Marshal carries the locally verified canonical digest\n130|// so a persisted plan is tamper-evident. Caller-supplied digest\n131|// equality alone is never evidence of authority; only Revalidate\n132|// against current facts decides currency.\n133|type SelectionPlan struct {\n134|\t// SelectorVersion is exactly SelectorVersion.\n135|\tSelectorVersion string\n136|\t// Selector is the original single argument, at most\n137|\t// MaxSelectorRunes characters.\n138|\tSelector string\n139|\t// SessionID is the selected UUIDv7, never resolved again by name.\n140|\tSessionID string\n141|\t// SessionRecordID is the validated immutable Session Record digest.\n142|\tSessionRecordID string\n143|\t// SourceHostID is the UUIDv7 of the selected source, always bound:\n144|\t// a local selection without a known local host refuses\n145|\t// invalid_config at build time instead of binding empty.\n146|\tSourceHostID string\n147|\t// SourceAlias is the exact configured alias, or nil for local. It\n148|\t// is a diagnostic label, never identity.\n149|\tSourceAlias *string\n150|\t// SourceIndexDigest is the digest of the complete validated index\n151|\t// read used for selection.\n152|\tSourceIndexDigest string\n153|\t// ConfigurationDigest is the digest of the effective validated\n154|\t// configuration, including peer mapping, allowlist, and transport.\n155|\tConfigurationDigest string\n156|\t// LeaseRecordID is the locally attested canonical digest of the\n157|\t// validated winning-lease observation (session, epoch, lease ID,\n158|\t// owner). This stack persists no standalone Lease Record objects;\n159|\t// the observation is the envelope triple on the authoritative\n160|\t// event chain, and the digest is recomputed from validated facts,\n161|\t// never fabricated and never a placeholder.\n162|\tLeaseRecordID string\n163|\t// LeaseEpoch, LeaseID, and OwnerHostID come from the same validated\n164|\t// winning-lease observation as LeaseRecordID: positive uint53,\n165|\t// UUIDv4, and UUIDv7. A plan with no observed winning lease is\n166|\t// never built; the builder refuses selector_bootstrap_incomplete.\n167|\tLeaseEpoch  uint64\n168|\tLeaseID     string\n169|\tOwnerHostID string\n170|\t// AuthorityHeads is the sorted unique digest array of the\n171|\t// validated event heads used for the decision: the tail event\n172|\t// digest of the selected validated chain.\n173|\tAuthorityHeads []string\n174|\t// Action is the explicit command/action tag bound at build time.\n175|\tAction string\n176|\t// DestinationHostID is the explicit destination UUIDv7, or nil\n177|\t// when the action takes no destination.\n178|\tDestinationHostID *string\n179|\t// ExpectationDigest binds the caller-declared action expectations\n180|\t// (canonically encoded JSON) for change detection. It does not\n181|\t// replace the checkpoint, workspace, cohort, provider, terminal,\n182|\t// or confirmation contracts, which have no owners in this leaf.\n183|\tExpectationDigest string\n184|}\n185|\n186|// PlanArgs declares the invocation facts BuildPlan binds: the literal\n187|// selector, the explicit action tag, the explicit destination (empty\n188|// for none), and the opaque caller expectations (nil for none).\n189|type PlanArgs struct {\n190|\tSelector     string\n191|\tAction       string\n192|\tDestination  string\n193|\tExpectations []byte\n194|}\n195|\n196|// BuildPlan resolves the selector once through the shared path and\n197|// binds the current facts into an immutable plan. The destination is\n198|// independently validated as a UUIDv7; expectations must be canonically\n199|// encodable JSON and bind by digest for change detection only.\n200|func (reader *Reader) BuildPlan(args PlanArgs) (SelectionPlan, error) {\n201|\tparsed, err := ParseSelector(args.Selector)\n202|\tif err != nil {\n203|\t\treturn SelectionPlan{}, err\n204|\t}\n205|\tif reader == nil || reader.Local == nil {\n206|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n207|\t}\n208|\tconfig, err := reader.validatedConfiguration()\n209|\tif err != nil {\n210|\t\treturn SelectionPlan{}, err\n211|\t}\n212|\tif _, ok := BoundariesFor(args.Action); !ok {\n213|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, args.Action)\n214|\t}\n215|\tvar destination *string\n216|\tif args.Destination != \"\" {\n217|\t\tid, err := scalar.ParseUUIDv7(args.Destination)\n218|\t\tif err != nil {\n219|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed destination host ID: %v\", ErrInvalidArgument, err)\n220|\t\t}\n221|\t\tvalue := id.String()\n222|\t\tdestination = &value\n223|\t}\n224|\texpectations, err := fingerprintExpectations(args.Expectations)\n225|\tif err != nil {\n226|\t\treturn SelectionPlan{}, err\n227|\t}\n228|\tvar selected Selection\n229|\tif parsed.Source != SourceBare {\n230|\t\tselected, err = reader.resolveExplicit(parsed, config)\n231|\t} else {\n232|\t\tselected, err = reader.resolveBare(parsed, config)\n233|\t}\n234|\tif err != nil {\n235|\t\treturn SelectionPlan{}, err\n236|\t}\n237|\treturn reader.bindPlan(parsed, config, selected, args.Action, destination, expectations)\n238|}\n239|\n240|// bindPlan reads the winning source completely and binds every plan\n241|// member from validated current facts. The session is located by its\n242|// UUID in the winning source only, never re-resolved by name.\n243|func (reader *Reader) bindPlan(parsed Selector, config validatedConfig, selected Selection, action string, destination *string, expectations string) (SelectionPlan, error) {\n244|\trows, err := reader.readSource(selected.repo, selected.PeerHostID)\n245|\tif err != nil {\n246|\t\treturn SelectionPlan{}, err\n247|\t}\n248|\tindex, err := fingerprintIndex(reader, selected.repo, rows, selected.PeerHostID)\n249|\tif err != nil {\n250|\t\treturn SelectionPlan{}, err\n251|\t}\n252|\tconfiguration, err := fingerprintConfiguration(reader, config)\n253|\tif err != nil {\n254|\t\treturn SelectionPlan{}, err\n255|\t}\n256|\tvar recordID string\n257|\tfound := false\n258|\tfor _, row := range rows {\n259|\t\tif row.Projection.SessionID == selected.SessionID {\n260|\t\t\trecordID, found = row.Projection.RecordID, true\n261|\t\t\tbreak\n262|\t\t}\n263|\t}\n264|\tif !found {\n265|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n266|\t}\n267|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n268|\tif err != nil {\n269|\t\treturn SelectionPlan{}, err\n270|\t}\n271|\tif projection.Winner.IsZero() {\n272|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)\n273|\t}\n274|\tleaseRecordID, err := fingerprintWinningLease(selected.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\n275|\tif err != nil {\n276|\t\treturn SelectionPlan{}, err\n277|\t}\n278|\ttail, err := chainTail(selected.repo, selected.SessionID)\n279|\tif err != nil {\n280|\t\treturn SelectionPlan{}, err\n281|\t}\n282|\tplan := SelectionPlan{\n283|\t\tSelectorVersion:     SelectorVersion,\n284|\t\tSelector:            parsed.Raw,\n285|\t\tSessionID:           selected.SessionID,\n286|\t\tSessionRecordID:     recordID,\n287|\t\tSourceIndexDigest:   index,\n288|\t\tConfigurationDigest: configuration,\n289|\t\tLeaseRecordID:       leaseRecordID,\n290|\t\tLeaseEpoch:          projection.Winner.Epoch,\n291|\t\tLeaseID:             projection.Winner.LeaseID,\n292|\t\tOwnerHostID:         projection.OwnerHostID,\n293|\t\tAction:              action,\n294|\t\tDestinationHostID:   destination,\n295|\t\tExpectationDigest:   expectations,\n296|\t}\n297|\tif selected.PeerHostID == \"\" {\n298|\t\tif config.localHost == \"\" {\n299|\t\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)\n300|\t\t}\n301|\t\tplan.SourceHostID = config.localHost\n302|\t} else {\n303|\t\tplan.SourceHostID = selected.PeerHostID\n304|\t\t// Null marks the local source only. An alias-less peer binds\n305|\t\t// empty: the host still distinguishes it from local.\n306|\t\talias := config.aliasFor(selected.PeerHostID)\n307|\t\taliasCopy := alias\n308|\t\tplan.SourceAlias = &aliasCopy\n309|\t}\n310|\tif tail != \"\" {\n311|\t\tplan.AuthorityHeads = []string{tail}\n312|\t} else {\n313|\t\tplan.AuthorityHeads = []string{}\n314|\t}\n315|\tif err := checkPlanShapes(plan); err != nil {\n316|\t\treturn SelectionPlan{}, err\n317|\t}\n318|\tif err := reader.validateAuthorityUnion(plan, config, selected.PeerHostID); err != nil {\n319|\t\treturn SelectionPlan{}, err\n320|\t}\n321|\treturn plan, nil\n322|}\n323|\n324|// chainTail returns the tail event digest of a validated session chain,\n325|// or empty when the chain carries no events yet.\n326|func chainTail(repo *sessrepo.Repository, sessionID string) (string, error) {\n327|\tevents, err := repo.ListEvents(sessionID)\n328|\tif err != nil {\n329|\t\treturn \"\", err\n330|\t}\n331|\tif len(events) == 0 {\n332|\t\treturn \"\", nil\n333|\t}\n334|\treturn events[len(events)-1].EventID, nil\n335|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60f","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":354,"recorded_at":1780531400000703,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886b7e137211a9eed9e22d390a56","text":"Read text file `internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, authority heads, the\n10|// source index digest, and finally the complete authority union for\n11|// the pinned session across the remaining allowed sources.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n26|const uint53Ceiling = uint64(1<<53 - 1)\n27|\n28|// Revalidate compares every bound plan fact against current\n29|// configuration and freshly reread source data, then validates the\n30|// complete authority union for the pinned session UUID across the\n31|// remaining allowed sources. The session is located by its UUID in\n32|// each source, never re-resolved by name. A nil return means the plan\n33|// is current; any error classifies exactly: selector_plan_stale (with\n34|// the first diverged member named), integrity_failure on contradictory\n35|// cross-source immutable records, peer_not_allowlisted on explicit\n36|// authorization revocation, invalid_config on current configuration\n37|// failures, invalid_arguments on a malformed caller plan, and the read\n38|// or projection failure class when a required read or validation\n39|// fails.\n40|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n41|\tif err := checkPlanShapes(plan); err != nil {\n42|\t\treturn err\n43|\t}\n44|\tif reader == nil || reader.Local == nil {\n45|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n46|\t}\n47|\tconfig, err := reader.validatedConfiguration()\n48|\tif err != nil {\n49|\t\treturn err\n50|\t}\n51|\tpeerHost, isPeer := planSourceBinding(plan, config)\n52|\tif isPeer {\n53|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n54|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n55|\t\t}\n56|\t}\n57|\tif !bindingHolds(plan, config, reader) {\n58|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n59|\t}\n60|\tconfiguration, err := fingerprintConfiguration(reader, config)\n61|\tif err != nil {\n62|\t\treturn err\n63|\t}\n64|\tif configuration != plan.ConfigurationDigest {\n65|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n66|\t}\n67|\tvar repo = reader.Local\n68|\tsourcePeer := \"\"\n69|\tif isPeer {\n70|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n71|\t\tif err != nil {\n72|\t\t\treturn err\n73|\t\t}\n74|\t}\n75|\trows, err := reader.readSource(repo, sourcePeer)\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\tvar recordID string\n80|\tabsent := true\n81|\tfor _, row := range rows {\n82|\t\tif row.Projection.SessionID == plan.SessionID {\n83|\t\t\trecordID, absent = row.Projection.RecordID, false\n84|\t\t\tbreak\n85|\t\t}\n86|\t}\n87|\tif absent {\n88|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n89|\t}\n90|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n91|\tif err != nil {\n92|\t\treturn err\n93|\t}\n94|\tif recordID != plan.SessionRecordID {\n95|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n96|\t}\n97|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\n98|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n99|\t}\n100|\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\n101|\tif err != nil {\n102|\t\treturn err\n103|\t}\n104|\tif leaseRecordID != plan.LeaseRecordID {\n105|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n106|\t}\n107|\ttail, err := chainTail(repo, plan.SessionID)\n108|\tif err != nil {\n109|\t\tif sourcePeer == \"\" {\n110|\t\t\treturn err\n111|\t\t}\n112|\t\treturn peerReadFailed(sourcePeer, err)\n113|\t}\n114|\theads := []string{}\n115|\tif tail != \"\" {\n116|\t\theads = []string{tail}\n117|\t}\n118|\tif !equalStrings(heads, plan.AuthorityHeads) {\n119|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n120|\t}\n121|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n122|\tif err != nil {\n123|\t\treturn err\n124|\t}\n125|\tif index != plan.SourceIndexDigest {\n126|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n127|\t}\n128|\treturn reader.validateAuthorityUnion(plan, config, sourcePeer)\n129|}\n130|\n131|// validateAuthorityUnion validates the complete current authority for\n132|// the pinned session UUID across every allowed source except the\n133|// already validated plan source. The session is located by UUID in\n134|// each source; names are never re-resolved and no selection is\n135|// substituted. A non-parked copy carrying a disagreeing immutable\n136|// record digest is inconsistent authority (integrity_failure, the same\n137|// class Resolve reports for disagreeing copies). Authoritative\n138|// tombstone evidence or a contradictory observed winning lease in\n139|// another source invalidates the live plan (selector_plan_stale). A\n140|// copy that observes no winning lease yet cannot contradict the bound\n141|// lease and is skipped for the lease check, while its record digest\n142|// still binds. Parked copies are failed observations, never evidence,\n143|// and absence in a source is not contradiction. A source that must be\n144|// read but cannot be read keeps its read-failure class: without the\n145|// complete union the plan cannot be shown current.\n146|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n147|\tif sourcePeer != \"\" {\n148|\t\trows, err := reader.read(reader.Local)\n149|\t\tif err != nil {\n150|\t\t\treturn err\n151|\t\t}\n152|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n153|\t\t\treturn err\n154|\t\t}\n155|\t}\n156|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n157|\tsort.Strings(ids)\n158|\tfor index, id := range ids {\n159|\t\tif index > 0 && id == ids[index-1] {\n160|\t\t\tcontinue\n161|\t\t}\n162|\t\tif id == sourcePeer {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\t// An allowlisted peer with no advertised learned index\n166|\t\t// contributes no authority; a known handle that cannot be\n167|\t\t// read is a failed observation of a source that must be\n168|\t\t// read, never absence.\n169|\t\tif isAbsentPeerIndex(reader, id) {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\trepo, peerHost, err := reader.peerRepo(id)\n173|\t\tif err != nil {\n174|\t\t\treturn err\n175|\t\t}\n176|\t\trows, err := reader.readSource(repo, peerHost)\n177|\t\tif err != nil {\n178|\t\t\treturn err\n179|\t\t}\n180|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n181|\t\t\treturn err\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n188|// learned index handle at all: absence, never a failed read.\n189|func isAbsentPeerIndex(reader *Reader, host string) bool {\n190|\tfor _, peer := range reader.Peers {\n191|\t\tif peer.HostID == host {\n192|\t\t\treturn false\n193|\t\t}\n194|\t}\n195|\treturn true\n196|}\n197|\n198|// checkUnionCopy validates one non-plan source's rows for the pinned\n199|// session UUID as validateAuthorityUnion documents.\n200|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n201|\tfor _, row := range rows {\n202|\t\tif row.Projection.SessionID != plan.SessionID {\n203|\t\t\tcontinue\n204|\t\t}\n205|\t\tif row.Projection.Parked != nil {\n206|\t\t\tcontinue\n207|\t\t}\n208|\t\tif row.Projection.State == sessstate.StateTombstoned {\n209|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n210|\t\t}\n211|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n212|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n213|\t\t}\n214|\t\tif row.Projection.Winner.IsZero() {\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\tif row.Projection.Winner.Epoch != plan.LeaseEpoch || row.Projection.Winner.LeaseID != plan.LeaseID || row.Projection.OwnerHostID != plan.OwnerHostID {\n218|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n219|\t\t}\n220|\t\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, row.Projection.Winner.Epoch, row.Projection.Winner.LeaseID, row.Projection.OwnerHostID)\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\tif leaseRecordID != plan.LeaseRecordID {\n225|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n226|\t\t}\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// planSourceBinding resolves the plan's bound source: a local plan\n232|// carries a null alias with an empty or local host, while any other\n233|// binding selects a peer source by host. The second return reports\n234|// whether the plan selects a peer source.\n235|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n236|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n237|\t\treturn \"\", false\n238|\t}\n239|\treturn plan.SourceHostID, true\n240|}\n241|\n242|// bindingHolds reports whether the plan's bound (host, alias) source\n243|// still resolves to the same source in the current configuration. A\n244|// local plan holds while its host is empty or the current local host;\n245|// a peer plan holds while its host is still a known peer carrying the\n246|// exact bound alias.\n247|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n248|\tif plan.SourceAlias == nil {\n249|\t\tif plan.SourceHostID == \"\" {\n250|\t\t\treturn true\n251|\t\t}\n252|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n253|\t\t\treturn true\n254|\t\t}\n255|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n256|\t\t\treturn true\n257|\t\t}\n258|\t\treturn false\n259|\t}\n260|\tif !knownPeer(reader, plan.SourceHostID) {\n261|\t\treturn false\n262|\t}\n263|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n264|}\n265|\n266|// equalStrings compares sorted unique string slices element-wise.\n267|func equalStrings(first, second []string) bool {\n268|\tif len(first) != len(second) {\n269|\t\treturn false\n270|\t}\n271|\tfor index := range first {\n272|\t\tif first[index] != second[index] {\n273|\t\t\treturn false\n274|\t\t}\n275|\t}\n276|\treturn true\n277|}\n278|\n279|// checkPlanShapes validates the caller-supplied plan members without\n280|// consulting any authority: exact contract version, grammatical\n281|// selector, canonical UUIDs and digests, a bound source host, the\n282|// required lease attestation with its full positive triple, exact\n283|// alias bound, sorted unique authority heads, a known action tag, and\n284|// a null or UUIDv7 destination. Authority comes only from Revalidate.\n285|func checkPlanShapes(plan SelectionPlan) error {\n286|\tif plan.SelectorVersion != SelectorVersion {\n287|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n288|\t}\n289|\tif _, err := ParseSelector(plan.Selector); err != nil {\n290|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n291|\t}\n292|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n293|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n294|\t}\n295|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n296|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n297|\t}\n298|\t// The source host is always bound: no plan observes a source it\n299|\t// cannot name, and empty never substitutes for unknown.\n300|\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n301|\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n302|\t}\n303|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n304|\t\treturn fmt.Errorf(\"%w: malformed plan lease record digest: %v\", ErrInvalidArgument, err)\n305|\t}\n306|\tif plan.SourceAlias != nil {\n307|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n308|\t\t\t// An alias-less peer binds empty, which never passes the\n309|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n310|\t\t\tif *plan.SourceAlias != \"\" {\n311|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n312|\t\t\t}\n313|\t\t}\n314|\t}\n315|\tfor _, member := range []struct {\n316|\t\tname   string\n317|\t\tdigest string\n318|\t}{\n319|\t\t{\"source index\", plan.SourceIndexDigest},\n320|\t\t{\"configuration\", plan.ConfigurationDigest},\n321|\t\t{\"expectation\", plan.ExpectationDigest},\n322|\t} {\n323|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n324|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n325|\t\t}\n326|\t}\n327|\t// The lease triple is always fully bound from the same winning\n328|\t// observation as the lease attestation: a positive uint53 epoch\n329|\t// with a UUIDv4 lease and a UUIDv7 owner. Empty and partial\n330|\t// triples, out-of-range epochs, and placeholders are refused; a\n331|\t// session with no observed winning lease builds no plan.\n332|\tif plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling {\n333|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n334|\t}\n335|\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n336|\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n337|\t}\n338|\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n339|\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n340|\t}\n341|\tfor index, head := range plan.AuthorityHeads {\n342|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n343|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n344|\t\t}\n345|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n346|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n347|\t\t}\n348|\t}\n349|\tif _, ok := BoundariesFor(plan.Action); !ok {\n350|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n351|\t}\n352|\tif plan.DestinationHostID != nil {\n353|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n354|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n355|\t\t}\n356|\t}\n357|\treturn nil\n358|}\n359|\n360|// planWire is the tamper-evident persistence encoding: every bound\n361|// member plus the locally verified canonical digest over all of them.\n362|type planWire struct {\n363|\tSelectorVersion     string   `json:\"selector_version\"`\n364|\tSelector            string   `json:\"selector\"`\n365|\tSessionID           string   `json:\"session_id\"`\n366|\tSessionRecordID     string   `json:\"session_record_id\"`\n367|\tSourceHostID        string   `json:\"source_host_id\"`\n368|\tSourceAlias         *string  `json:\"source_alias\"`\n369|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n370|\tConfigurationDigest string   `json:\"configuration_digest\"`\n371|\tLeaseRecordID       string   `json:\"lease_record_id\"`\n372|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n373|\tLeaseID             string   `json:\"lease_id\"`\n374|\tOwnerHostID         string   `json:\"owner_host_id\"`\n375|\tAuthorityHeads      []string `json:\"authority_heads\"`\n376|\tAction              string   `json:\"action\"`\n377|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n378|\tExpectationDigest   string   `json:\"expectation_digest\"`\n379|\tPlanDigest          string   `json:\"plan_digest\"`\n380|}\n381|\n382|// Digest returns the locally verified canonical digest over all bound\n383|// plan members. It is recomputed on every call and never trusted from\n384|// caller bytes.\n385|func (plan SelectionPlan) Digest() (string, error) {\n386|\theads := append([]string(nil), plan.AuthorityHeads...)\n387|\tif heads == nil {\n388|\t\theads = []string{}\n389|\t}\n390|\treturn fingerprint(map[string]any{\n391|\t\t\"action\":               plan.Action,\n392|\t\t\"authority_heads\":      heads,\n393|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n394|\t\t\"destination_host_id\":  plan.DestinationHostID,\n395|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n396|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n397|\t\t\"lease_id\":             plan.LeaseID,\n398|\t\t\"lease_record_id\":      plan.LeaseRecordID,\n399|\t\t\"owner_host_id\":        plan.OwnerHostID,\n400|\t\t\"selector\":             plan.Selector,\n401|\t\t\"selector_version\":     plan.SelectorVersion,\n402|\t\t\"session_id\":           plan.SessionID,\n403|\t\t\"session_record_id\":    plan.SessionRecordID,\n404|\t\t\"source_alias\":         plan.SourceAlias,\n405|\t\t\"source_host_id\":       plan.SourceHostID,\n406|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n407|\t})\n408|}\n409|\n410|// Marshal encodes the plan with its locally verified digest. The\n411|// encoding keeps null alias and destination distinct from empty.\n412|func (plan SelectionPlan) Marshal() ([]byte, error) {\n413|\tdigest, err := plan.Digest()\n414|\tif err != nil {\n415|\t\treturn nil, err\n416|\t}\n417|\theads := append([]string(nil), plan.AuthorityHeads...)\n418|\tif heads == nil {\n419|\t\theads = []string{}\n420|\t}\n421|\treturn json.Marshal(planWire{\n422|\t\tSelectorVersion:     plan.SelectorVersion,\n423|\t\tSelector:            plan.Selector,\n424|\t\tSessionID:           plan.SessionID,\n425|\t\tSessionRecordID:     plan.SessionRecordID,\n426|\t\tSourceHostID:        plan.SourceHostID,\n427|\t\tSourceAlias:         plan.SourceAlias,\n428|\t\tSourceIndexDigest:   plan.SourceIndexDigest,\n429|\t\tConfigurationDigest: plan.ConfigurationDigest,\n430|\t\tLeaseRecordID:       plan.LeaseRecordID,\n431|\t\tLeaseEpoch:          plan.LeaseEpoch,\n432|\t\tLeaseID:             plan.LeaseID,\n433|\t\tOwnerHostID:         plan.OwnerHostID,\n434|\t\tAuthorityHeads:      heads,\n435|\t\tAction:              plan.Action,\n436|\t\tDestinationHostID:   plan.DestinationHostID,\n437|\t\tExpectationDigest:   plan.ExpectationDigest,\n438|\t\tPlanDigest:          digest,\n439|\t})\n440|}\n441|\n442|// ParsePlan decodes a persisted plan, validates every member shape,\n443|// and verifies the tamper-evident digest. A verified encoding is still\n444|// not authority: only Revalidate against current facts decides\n445|// currency, and digest equality alone never substitutes for it.\n446|func ParsePlan(raw []byte) (SelectionPlan, error) {\n447|\tvar wire planWire\n448|\tif err := json.Unmarshal(raw, &wire); err != nil {\n449|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed plan encoding: %v\", ErrInvalidArgument, err)\n450|\t}\n451|\tplan := SelectionPlan{\n452|\t\tSelectorVersion:     wire.SelectorVersion,\n453|\t\tSelector:            wire.Selector,\n454|\t\tSessionID:           wire.SessionID,\n455|\t\tSessionRecordID:     wire.SessionRecordID,\n456|\t\tSourceHostID:        wire.SourceHostID,\n457|\t\tSourceAlias:         wire.SourceAlias,\n458|\t\tSourceIndexDigest:   wire.SourceIndexDigest,\n459|\t\tConfigurationDigest: wire.ConfigurationDigest,\n460|\t\tLeaseRecordID:       wire.LeaseRecordID,\n461|\t\tLeaseEpoch:          wire.LeaseEpoch,\n462|\t\tLeaseID:             wire.LeaseID,\n463|\t\tOwnerHostID:         wire.OwnerHostID,\n464|\t\tAuthorityHeads:      wire.AuthorityHeads,\n465|\t\tAction:              wire.Action,\n466|\t\tDestinationHostID:   wire.DestinationHostID,\n467|\t\tExpectationDigest:   wire.ExpectationDigest,\n468|\t}\n469|\tif plan.AuthorityHeads == nil {\n470|\t\tplan.AuthorityHeads = []string{}\n471|\t}\n472|\tif err := checkPlanShapes(plan); err != nil {\n473|\t\treturn SelectionPlan{}, err\n474|\t}\n475|\tdigest, err := plan.Digest()\n476|\tif err != nil {\n477|\t\treturn SelectionPlan{}, err\n478|\t}\n479|\tif digest != wire.PlanDigest {\n480|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: plan digest mismatch\", ErrInvalidArgument)\n481|\t}\n482|\treturn plan, nil\n483|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c611","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":355,"recorded_at":1780531400000705,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886b7ea37350aaa5a66c91ceb2cc","text":"Read text file `internal/sessquery/digest.go`.\n1|// Local attestation digests for selector plans: canonical fingerprints\n2|// over validated reads, never over caller claims.\n3|//\n4|// fingerprint canonicalizes its input through the canonical-JSON owner\n5|// and digests the canonical bytes, so equal facts always produce equal\n6|// digests and any fact change invalidates the plans bound to them. The\n7|// resulting \"sha256:\" digests are self-checked through the scalar\n8|// digest grammar before use.\n9|package sessquery\n10|\n11|import (\n12|\t\"crypto/sha256\"\n13|\t\"encoding/hex\"\n14|\t\"encoding/json\"\n15|\t\"fmt\"\n16|\t\"sort\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n21|)\n22|\n23|// transportLabel names the index-read mechanism this stack uses: direct\n24|// local repository reads with no mesh transport. Binding the label into\n25|// the configuration digest invalidates every plan if a transport is\n26|// ever introduced, instead of silently reusing facts read another way.\n27|const transportLabel = \"local-direct\"\n28|\n29|// fingerprint canonicalizes value and returns the \"sha256:\" digest of\n30|// the canonical bytes.\n31|func fingerprint(value any) (string, error) {\n32|\traw, err := json.Marshal(value)\n33|\tif err != nil {\n34|\t\treturn \"\", err\n35|\t}\n36|\tcanonical, err := canonicaljson.Canonicalize(raw)\n37|\tif err != nil {\n38|\t\treturn \"\", err\n39|\t}\n40|\tsum := sha256.Sum256(canonical)\n41|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n42|\tif _, err := scalar.ParseDigest(digest); err != nil {\n43|\t\treturn \"\", err\n44|\t}\n45|\treturn digest, nil\n46|}\n47|\n48|// peerFingerprint is one configured peer mapping in the configuration\n49|// digest: exact alias with its host, in bytewise host order.\n50|type peerFingerprint struct {\n51|\tAlias  string `json:\"alias\"`\n52|\tHostID string `json:\"host_id\"`\n53|}\n54|\n55|// fingerprintConfiguration digests the effective validated\n56|// configuration: the local host, the peer mapping, the allowlist, and\n57|// the transport label. Handles are not configuration and stay out:\n58|// swapping a learned index without changing the mapping still changes\n59|// the index digest at read time.\n60|func fingerprintConfiguration(reader *Reader, config validatedConfig) (string, error) {\n61|\tpeers := make([]peerFingerprint, 0, len(reader.Peers))\n62|\tfor _, host := range config.sortedPeerHosts(reader) {\n63|\t\tpeers = append(peers, peerFingerprint{Alias: config.aliasFor(host), HostID: host})\n64|\t}\n65|\tallowlist := make([]string, 0, len(config.allowed))\n66|\tfor id := range config.allowed {\n67|\t\tallowlist = append(allowlist, id)\n68|\t}\n69|\tsort.Strings(allowlist)\n70|\treturn fingerprint(map[string]any{\n71|\t\t\"allowlist\":     allowlist,\n72|\t\t\"local_host_id\": config.localHost,\n73|\t\t\"peers\":         peers,\n74|\t\t\"transport\":     transportLabel,\n75|\t})\n76|}\n77|\n78|// indexRowFingerprint is one validated index row in the source index\n79|// digest: identity, liveness, lifecycle, tail, and winning lease facts\n80|// for every session the complete read returned, in bytewise session\n81|// order. Any index change — a new, removed, parked, tombstoned, or\n82|// advanced session — changes this digest.\n83|type indexRowFingerprint struct {\n84|\tSessionID     string `json:\"session_id\"`\n85|\tRecordID      string `json:\"record_id\"`\n86|\tName          string `json:\"name\"`\n87|\tParked        bool   `json:\"parked\"`\n88|\tState         string `json:\"state\"`\n89|\tTailEvent     string `json:\"tail_event\"`\n90|\tWinnerEpoch   uint64 `json:\"winner_epoch\"`\n91|\tWinnerLeaseID string `json:\"winner_lease_id\"`\n92|\tOwnerHostID   string `json:\"owner_host_id\"`\n93|}\n94|\n95|// fingerprintIndex digests the complete validated index read used for\n96|// selection: every row the listing returned with its validated tail.\n97|// A tail read failure keeps its read-failure class: local errors stay\n98|// repository errors, peer errors carry the read-failure class.\n99|func fingerprintIndex(reader *Reader, repo *sessrepo.Repository, rows []Summary, peerHost string) (string, error) {\n100|\tfinger := make([]indexRowFingerprint, 0, len(rows))\n101|\tfor _, row := range rows {\n102|\t\tentry := indexRowFingerprint{\n103|\t\t\tSessionID:     row.Projection.SessionID,\n104|\t\t\tRecordID:      row.Projection.RecordID,\n105|\t\t\tName:          row.Projection.Name,\n106|\t\t\tState:         string(row.Projection.State),\n107|\t\t\tWinnerEpoch:   row.Projection.Winner.Epoch,\n108|\t\t\tWinnerLeaseID: row.Projection.Winner.LeaseID,\n109|\t\t\tOwnerHostID:   row.Projection.OwnerHostID,\n110|\t\t}\n111|\t\tif row.Projection.Parked != nil {\n112|\t\t\tentry.Parked = true\n113|\t\t} else {\n114|\t\t\ttail, err := chainTail(repo, row.Projection.SessionID)\n115|\t\t\tif err != nil {\n116|\t\t\t\tif peerHost == \"\" {\n117|\t\t\t\t\treturn \"\", err\n118|\t\t\t\t}\n119|\t\t\t\treturn \"\", peerReadFailed(peerHost, err)\n120|\t\t\t}\n121|\t\t\tentry.TailEvent = tail\n122|\t\t}\n123|\t\tfinger = append(finger, entry)\n124|\t}\n125|\treturn fingerprint(finger)\n126|}\n127|\n128|// fingerprintWinningLease attests the validated winning-lease\n129|// observation: the session, the positive envelope epoch, the fencing\n130|// lease ID, and the owner host. This stack persists no standalone\n131|// Lease Record objects, so the observation is the envelope triple on\n132|// the authoritative event chain as derived by the accepted projector;\n133|// the digest is recomputed from those validated facts on every build\n134|// and revalidation. Callers must refuse a missing winning lease\n135|// before calling: a zero observation has no attestation.\n136|func fingerprintWinningLease(sessionID string, epoch uint64, leaseID, ownerHostID string) (string, error) {\n137|\treturn fingerprint(map[string]any{\n138|\t\t\"lease_epoch\":   epoch,\n139|\t\t\"lease_id\":      leaseID,\n140|\t\t\"owner_host_id\": ownerHostID,\n141|\t\t\"session_id\":    sessionID,\n142|\t})\n143|}\n144|\n145|// fingerprintExpectations binds caller-declared action expectations for\n146|// change detection only. Expectations must be one canonically encoded\n147|// JSON object; the digest never replaces the checkpoint, workspace,\n148|// cohort, provider, terminal, or confirmation contracts, which have no\n149|// owners in this leaf. Empty expectations bind the empty-object digest.\n150|func fingerprintExpectations(expectations []byte) (string, error) {\n151|\tif len(expectations) == 0 {\n152|\t\treturn fingerprint(map[string]any{})\n153|\t}\n154|\tcanonical, err := canonicaljson.Canonicalize(expectations)\n155|\tif err != nil {\n156|\t\treturn \"\", fmt.Errorf(\"%w: malformed plan expectations: %v\", ErrInvalidArgument, err)\n157|\t}\n158|\tif len(canonical) == 0 || canonical[0] != '{' {\n159|\t\treturn \"\", fmt.Errorf(\"%w: plan expectations must be a JSON object\", ErrInvalidArgument)\n160|\t}\n161|\tsum := sha256.Sum256(canonical)\n162|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n163|\tif _, err := scalar.ParseDigest(digest); err != nil {\n164|\t\treturn \"\", err\n165|\t}\n166|\treturn digest, nil\n167|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c613","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":356,"recorded_at":1780531400000707,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886b7f597ce1ab78728ee7fe9b38","text":"Read text file `internal/sessquery/summary.go`.\n1|// Authoritative shared summaries for the v0.6.0 selector contract\n2|// (SPEC Section 14.7.3).\n3|//\n4|// List and Status above keep the internal read model and refuse only\n5|// the unrepresentable record-only bootstrap. This layer is the closed\n6|// authoritative summary: every owner, lease, role, and checkpoint\n7|// fact comes from validated authority, every host display name comes\n8|// from validated host metadata, and every liveness, capability,\n9|// workspace, and timestamp fact comes from a validated observation.\n10|// Anything that cannot be established truthfully refuses instead of\n11|// falling back to inference:\n12|//\n13|//   - a complete read proving a record without any valid lease is\n14|//     selector_bootstrap_incomplete (inherited from the read entry);\n15|//   - a required host metadata fact or observation that cannot be\n16|//     established is selector_observation_unavailable, never a source\n17|//     alias, an empty name, or a minted process/capability fact;\n18|//   - list refuses the whole success document when any encountered\n19|//     record cannot be represented, including a mixed healthy and\n20|//     incomplete listing; no record is silently omitted.\n21|//\n22|// CLI envelope and exit rendering, durable bootstrap recovery, and\n23|// effect authorization remain their existing caller owners. Plans\n24|// built here authorize read projection only.\n25|package sessquery\n26|\n27|import (\n28|\t\"fmt\"\n29|\t\"time\"\n30|\t\"unicode\"\n31|\t\"unicode/utf8\"\n32|\n33|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n34|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n35|)\n36|\n37|// MaxDisplayNameRunes bounds one validated host display name.\n38|const MaxDisplayNameRunes = 128\n39|\n40|// MaxCapabilityRunes bounds one validated capability name.\n41|const MaxCapabilityRunes = 128\n42|\n43|// HostMetadata is validated display metadata for one host, keyed by\n44|// canonical host UUID on the Reader. It is the only source of owner\n45|// display names; the source alias never substitutes for it.\n46|type HostMetadata struct {\n47|\tDisplayName string\n48|}\n49|\n50|// SessionObservations carries validated per-session observation facts\n51|// from their respective owners, keyed by session UUID on the Reader.\n52|// A nil member is unobserved and stays unknown in the summary; only\n53|// the newest-checkpoint timestamp is required when its checkpoint\n54|// exists, because a checkpointed summary without it cannot be\n55|// represented truthfully.\n56|type SessionObservations struct {\n57|\t// NewestCheckpointCreatedAt is the RFC 3339 creation timestamp of\n58|\t// the newest checkpoint, required exactly when the projection\n59|\t// carries a checkpoint.\n60|\tNewestCheckpointCreatedAt *string\n61|\t// ProcessPresent is validated process liveness; nil is unobserved.\n62|\tProcessPresent *bool\n63|\t// Capabilities are validated capability names; nil is unobserved.\n64|\tCapabilities []string\n65|\t// WorkspacePresent is validated workspace presence; nil is\n66|\t// unobserved.\n67|\tWorkspacePresent *bool\n68|}\n69|\n70|// AuthoritativeSummary is the closed public summary for one live\n71|// session. Pointer members are null exactly when the fact is absent:\n72|// no checkpoint exists yet, or the observation was not supplied. No\n73|// member is ever invented to complete the shape.\n74|type AuthoritativeSummary struct {\n75|\tSessionID                 string\n76|\tName                      string\n77|\tKind                      string\n78|\tProviderID                string\n79|\tState                     string\n80|\tOwnerHostID               string\n81|\tOwnerHostName             string\n82|\tLeaseEpoch                uint64\n83|\tLeaseID                   string\n84|\tLocalRole                 string\n85|\tHasCheckpoint             bool\n86|\tNewestCheckpointID        *string\n87|\tNewestCheckpointCreatedAt *string\n88|\tProcessPresent            *bool\n89|\tCapabilities              []string\n90|\tWorkspacePresent          *bool\n91|}\n92|\n93|// checkSummaryRepresentable refuses a projected row that can never be\n94|// represented truthfully in a public summary: a complete read proving\n95|// a record without any valid lease. Parked rows stay representable\n96|// through their blocking reason and retry, and tombstoned rows stay\n97|// listed with their terminal state; resolution routing already\n98|// excludes both from live selection.\n99|func checkSummaryRepresentable(summary Summary) error {\n100|\tprojection := summary.Projection\n101|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n102|\t\treturn nil\n103|\t}\n104|\tif projection.Winner.IsZero() {\n105|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n106|\t}\n107|\treturn nil\n108|}\n109|\n110|// validatedAuthorityInputs validates the reader's host metadata and\n111|// observation maps as configuration: UUIDv7 keys, printable bounded\n112|// display names, RFC 3339 checkpoint timestamps, and printable\n113|// bounded capability names. Malformed inputs are invalid_config;\n114|// missing facts at summary time are selector_observation_unavailable.\n115|func (reader *Reader) validatedAuthorityInputs() error {\n116|\tfor host, metadata := range reader.HostMetadata {\n117|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n118|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n119|\t\t}\n120|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n121|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n122|\t\t}\n123|\t}\n124|\tfor session, observations := range reader.Observations {\n125|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n126|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n127|\t\t}\n128|\t\tif observations.NewestCheckpointCreatedAt != nil {\n129|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n130|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n131|\t\t\t}\n132|\t\t}\n133|\t\tfor _, capability := range observations.Capabilities {\n134|\t\t\tif err := checkPrintableBound(capability, 1, MaxCapabilityRunes, \"capability\"); err != nil {\n135|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n136|\t\t\t}\n137|\t\t}\n138|\t}\n139|\treturn nil\n140|}\n141|\n142|// checkPrintableBound enforces valid UTF-8 with 1..max printable\n143|// non-control runes without normalizing or folding the value.\n144|func checkPrintableBound(value string, min, max int, what string) error {\n145|\tif !utf8.ValidString(value) {\n146|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n147|\t}\n148|\tcount := utf8.RuneCountInString(value)\n149|\tif count < min || count > max {\n150|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n151|\t}\n152|\tfor _, character := range value {\n153|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n154|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n155|\t\t}\n156|\t}\n157|\treturn nil\n158|}\n159|\n160|// AuthoritativeStatus resolves one selector through the shared path\n161|// and returns its closed authoritative summary. Resolution,\n162|// read-failure, and bootstrap refusals behave exactly as Status;\n163|// host and observation facts then bind or refuse as documented above.\n164|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n165|\tsummary, err := reader.Status(selector)\n166|\tif err != nil {\n167|\t\treturn AuthoritativeSummary{}, err\n168|\t}\n169|\tif err := reader.validatedAuthorityInputs(); err != nil {\n170|\t\treturn AuthoritativeSummary{}, err\n171|\t}\n172|\treturn reader.authorize(summary)\n173|}\n174|\n175|// AuthoritativeList returns the closed authoritative summaries for\n176|// the local index in bytewise session-ID order. The whole document\n177|// refuses when any encountered record cannot be represented\n178|// truthfully — including one incomplete record in an otherwise\n179|// healthy listing — and no record is silently omitted.\n180|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n181|\trows, err := reader.List()\n182|\tif err != nil {\n183|\t\treturn nil, err\n184|\t}\n185|\tif err := reader.validatedAuthorityInputs(); err != nil {\n186|\t\treturn nil, err\n187|\t}\n188|\tout := make([]AuthoritativeSummary, 0, len(rows))\n189|\tfor _, row := range rows {\n190|\t\tsummary, err := reader.authorize(row)\n191|\t\tif err != nil {\n192|\t\t\treturn nil, err\n193|\t\t}\n194|\t\tout = append(out, summary)\n195|\t}\n196|\treturn out, nil\n197|}\n198|\n199|// authorize binds one projected row to its closed authoritative\n200|// summary against the validated host and observation inputs. Every\n201|// refusal names the missing established fact; nothing is inferred.\n202|func (reader *Reader) authorize(summary Summary) (AuthoritativeSummary, error) {\n203|\tprojection := summary.Projection\n204|\tif err := checkSummaryRepresentable(summary); err != nil {\n205|\t\treturn AuthoritativeSummary{}, err\n206|\t}\n207|\tif reader.LocalHostID == \"\" {\n208|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n209|\t}\n210|\tmetadata, ok := reader.HostMetadata[projection.OwnerHostID]\n211|\tif !ok {\n212|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, projection.OwnerHostID)\n213|\t}\n214|\tif projection.LocalRole == \"\" {\n215|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n216|\t}\n217|\tauthorized := AuthoritativeSummary{\n218|\t\tSessionID:     projection.SessionID,\n219|\t\tName:          projection.Name,\n220|\t\tKind:          projection.Kind,\n221|\t\tProviderID:    projection.Provider.ID,\n222|\t\tState:         string(projection.State),\n223|\t\tOwnerHostID:   projection.OwnerHostID,\n224|\t\tOwnerHostName: metadata.DisplayName,\n225|\t\tLeaseEpoch:    projection.Winner.Epoch,\n226|\t\tLeaseID:       projection.Winner.LeaseID,\n227|\t\tLocalRole:     projection.LocalRole,\n228|\t}\n229|\tobservations := reader.Observations[projection.SessionID]\n230|\tif projection.HasCheckpoint {\n231|\t\tcheckpoint := projection.Newest.ID\n232|\t\tauthorized.HasCheckpoint = true\n233|\t\tauthorized.NewestCheckpointID = &checkpoint\n234|\t\tif observations.NewestCheckpointCreatedAt == nil {\n235|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n236|\t\t}\n237|\t\tstamp := *observations.NewestCheckpointCreatedAt\n238|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n239|\t}\n240|\tauthorized.ProcessPresent = observations.ProcessPresent\n241|\tauthorized.Capabilities = observations.Capabilities\n242|\tauthorized.WorkspacePresent = observations.WorkspacePresent\n243|\treturn authorized, nil\n244|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c615","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":357,"recorded_at":1780531400000709,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886b800e7fa09958c8e0b5d39d59","text":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|\t// ErrBootstrapIncomplete reports a complete authority read proving\n61|\t// a Session Record without any valid lease: an interrupted\n62|\t// persistence prefix for the bootstrap-recovery leaf (Section\n63|\t// 14.7.4), never a public summary. A failed read keeps its\n64|\t// read-failure class instead; corrupt authority is integrity\n65|\t// failure. Wire exit binding for a CLI surface belongs to that\n66|\t// surface's leaf; this library keeps the refusal class distinct\n67|\t// and stable.\n68|\tErrBootstrapIncomplete = errors.New(\"selector_bootstrap_incomplete\")\n69|\t// ErrObservationUnavailable reports a required summary observation\n70|\t// or host metadata fact that cannot be established from validated\n71|\t// inputs. Nothing is inferred in its place: no source alias stands\n72|\t// in for host metadata, and no absent observation mints liveness,\n73|\t// capability, workspace, or timestamp facts.\n74|\tErrObservationUnavailable = errors.New(\"selector_observation_unavailable\")\n75|)\n76|\n77|// PeerIndex binds a peer identity to its already persisted learned index.\n78|// Transport/authentication and installing peer indexes are upstream owners;\n79|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n80|type PeerIndex struct {\n81|\tHostID string\n82|\tRepo   *sessrepo.Repository\n83|}\n84|\n85|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n86|// configuration layer, separately from the learned indexes. An unlisted source\n87|// is never read. Failed reads from listed sources are errors, never\n88|// empty indexes that let resolution fall through to a lower-priority UUID.\n89|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n90|//\n91|// Aliases carries the exact configured peer-alias mapping (host ID to\n92|// alias) from the same configuration owner, kept separate from the\n93|// learned index handles: a mapping without a handle contributes no\n94|// learned names, and a handle without a mapping stays reachable through\n95|// the bare union and the \"id:\" host form but never through \"peer:\".\n96|// Alias comparison is always exact, never folded, trimmed, or decoded.\n97|//\n98|// HostMetadata and Observations carry the validated host and observation\n99|// facts the authoritative summary layer requires, from their respective\n100|// owners. They are consulted only by that layer: List and Status keep\n101|// the internal read model and refuse only the unrepresentable\n102|// record-only bootstrap.\n103|type Reader struct {\n104|\tLocal              *sessrepo.Repository\n105|\tLocalHostID        string\n106|\tAllowlistedPeerIDs []string\n107|\tPeers              []PeerIndex\n108|\tAliases            map[string]string\n109|\tHostMetadata       map[string]HostMetadata\n110|\tObservations       map[string]SessionObservations\n111|}\n112|\n113|// Summary contains only facts derived from verified session records and events.\n114|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n115|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n116|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n117|// process liveness and sync timestamps require their respective observation\n118|// owners and are deliberately not inferred from a record or a successful read.\n119|type Summary struct {\n120|\tProjection sessstate.Projection\n121|}\n122|\n123|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n124|// visible with their blocking reason and retry; failure to enumerate the index\n125|// fails the read. No durable state is written, even for an interrupted create.\n126|// A complete read proving a record without any valid lease refuses the whole\n127|// list with selector_bootstrap_incomplete: the interrupted prefix is never\n128|// silently omitted and never returned as a public summary.\n129|func (reader *Reader) List() ([]Summary, error) {\n130|\tif reader == nil || reader.Local == nil {\n131|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n132|\t}\n133|\trows, err := reader.read(reader.Local)\n134|\tif err != nil {\n135|\t\treturn nil, err\n136|\t}\n137|\tfor _, row := range rows {\n138|\t\tif err := checkSummaryRepresentable(row); err != nil {\n139|\t\t\treturn nil, err\n140|\t\t}\n141|\t}\n142|\treturn rows, nil\n143|}\n144|\n145|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n146|\trows, err := repo.ListSessions()\n147|\tif err != nil {\n148|\t\treturn nil, err\n149|\t}\n150|\tout := make([]Summary, 0, len(rows))\n151|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n152|\tfor _, row := range rows {\n153|\t\tprojection, err := projector.Project(row.SessionID)\n154|\t\tif err != nil {\n155|\t\t\treturn nil, err\n156|\t\t}\n157|\t\tout = append(out, Summary{Projection: projection})\n158|\t}\n159|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n160|\treturn out, nil\n161|}\n162|\n163|// Status resolves any selector — bare, \"id:\", or source-qualified — through\n164|// the same path as Resolve, then projects from the selected repository. It\n165|// never treats a failed read as not found. Parked sessions can be inspected\n166|// by ID through InspectLocal, independently of live-name routing, so\n167|// operators retain access to the recovery diagnostics.\n168|func (reader *Reader) Status(selector string) (Summary, error) {\n169|\tselected, err := reader.Resolve(selector)\n170|\tif err != nil {\n171|\t\treturn Summary{}, err\n172|\t}\n173|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n174|\tif err != nil {\n175|\t\treturn Summary{}, err\n176|\t}\n177|\tsummary := Summary{Projection: projection}\n178|\tif err := checkSummaryRepresentable(summary); err != nil {\n179|\t\treturn Summary{}, err\n180|\t}\n181|\treturn summary, nil\n182|}\n183|\n184|// InspectLocal reads one local ID, including a parked or tombstoned session.\n185|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n186|\tif reader == nil || reader.Local == nil {\n187|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n188|\t}\n189|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n190|\tif err != nil {\n191|\t\treturn Summary{}, err\n192|\t}\n193|\treturn Summary{Projection: projection}, nil\n194|}\n195|\n196|// Selection identifies the session and source index, never an attach or mutation\n197|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n198|type Selection struct {\n199|\tSessionID  string\n200|\tPeerHostID string\n201|\trepo       *sessrepo.Repository\n202|}\n203|\n204|type candidate struct {\n205|\tsummary   Summary\n206|\tselection Selection\n207|}\n208|\n209|// Resolve applies one parsed selector through the single shared path:\n210|// grammar first, then effective-configuration validation, then the\n211|// source tier. A bare selector retains the exact Section 2.3 tiers:\n212|// local exact live name, allowlisted peer exact live name, exact UUID,\n213|// not found. An \"id:\" key bypasses names for the durable UUID in the\n214|// local and allowed-peer union. A qualified selector resolves its key\n215|// in exactly one source index with no fallback. ASCII folding detects\n216|// collisions within each name tier; it does not turn a unique case\n217|// variant into an exact match. Repository-parked entries (failed reads,\n218|// never tombstone evidence) and tombstoned entries (authoritative\n219|// tombstone evidence) are not live candidates. A tier that must be\n220|// read but cannot be read is a read failure, not permission to proceed\n221|// to a lower tier. This is logical index eligibility, not proof of\n222|// process liveness or safe attach/resume readiness; those decisions\n223|// belong to the action planner invoking plans at its boundaries.\n224|func (reader *Reader) Resolve(selector string) (Selection, error) {\n225|\tparsed, err := ParseSelector(selector)\n226|\tif err != nil {\n227|\t\treturn Selection{}, err\n228|\t}\n229|\tif reader == nil || reader.Local == nil {\n230|\t\treturn Selection{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n231|\t}\n232|\tconfig, err := reader.validatedConfiguration()\n233|\tif err != nil {\n234|\t\treturn Selection{}, err\n235|\t}\n236|\tif parsed.Source != SourceBare {\n237|\t\treturn reader.resolveExplicit(parsed, config)\n238|\t}\n239|\treturn reader.resolveBare(parsed, config)\n240|}\n241|\n242|// resolveBare applies the Section 2.3 tiers over the local and\n243|// allowed-peer union. Unread lower tiers are never consulted after a\n244|// unique higher-tier match; a tier that must be read but cannot be\n245|// read fails the resolution instead of falling through.\n246|func (reader *Reader) resolveBare(parsed Selector, config validatedConfig) (Selection, error) {\n247|\tlocal, err := reader.read(reader.Local)\n248|\tif err != nil {\n249|\t\treturn Selection{}, err\n250|\t}\n251|\tlocalLive := liveCandidates(local, reader.Local, \"\")\n252|\t// Peer tiers read lazily: a unique local name match never depends\n253|\t// on lower-tier reads, but any tier that must be read and cannot\n254|\t// be read fails instead of falling through.\n255|\tpeers, peersRead := []candidate(nil), false\n256|\treadPeers := func() ([]candidate, error) {\n257|\t\tif !peersRead {\n258|\t\t\tpeersRead = true\n259|\t\t\tvar err error\n260|\t\t\tpeers, err = reader.peerCandidates()\n261|\t\t\tif err != nil {\n262|\t\t\t\treturn nil, err\n263|\t\t\t}\n264|\t\t}\n265|\t\treturn peers, nil\n266|\t}\n267|\tif parsed.IDKey {\n268|\t\tunion, err := readPeers()\n269|\t\tif err != nil {\n270|\t\t\treturn Selection{}, err\n271|\t\t}\n272|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), append(localLive, union...), config)\n273|\t}\n274|\tif match, found, err := matchName(localLive, parsed.Key); found || err != nil {\n275|\t\treturn match, err\n276|\t}\n277|\tunion, err := readPeers()\n278|\tif err != nil {\n279|\t\treturn Selection{}, err\n280|\t}\n281|\tif match, found, err := matchName(union, parsed.Key); found || err != nil {\n282|\t\tif err != nil {\n283|\t\t\treturn Selection{}, err\n284|\t\t}\n285|\t\tif err := checkRecordAgreement(append(append([]candidate(nil), localLive...), union...), match); err != nil {\n286|\t\t\treturn Selection{}, err\n287|\t\t}\n288|\t\treturn match, nil\n289|\t}\n290|\tif parsed.UUIDShaped {\n291|\t\treturn selectIdentity(parsed.Key, append(localLive, union...), config)\n292|\t}\n293|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, parsed.Raw)\n294|}\n295|\n296|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n297|\tout := make([]candidate, 0, len(rows))\n298|\tfor _, row := range rows {\n299|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n300|\t\t\tcontinue\n301|\t\t}\n302|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n303|\t}\n304|\treturn out\n305|}\n306|\n307|// resolveExplicit selects a key in exactly one configured source index.\n308|// An explicit source never falls back to the local index, another peer,\n309|// a cached index from another source, or a union search, even when the\n310|// same name or UUID exists there: a miss in the selected source is not\n311|// found, and a source that cannot be completely read is a read failure.\n312|func (reader *Reader) resolveExplicit(parsed Selector, config validatedConfig) (Selection, error) {\n313|\trepo, peerHost, err := reader.locateSource(parsed, config)\n314|\tif err != nil {\n315|\t\treturn Selection{}, err\n316|\t}\n317|\trows, err := reader.readSource(repo, peerHost)\n318|\tif err != nil {\n319|\t\treturn Selection{}, err\n320|\t}\n321|\tlive := liveCandidates(rows, repo, peerHost)\n322|\tif parsed.IDKey {\n323|\t\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)\n324|\t}\n325|\tif match, found, err := matchName(live, parsed.Key); found || err != nil {\n326|\t\treturn match, err\n327|\t}\n328|\tif parsed.UUIDShaped {\n329|\t\treturn selectIdentity(parsed.Key, live, config)\n330|\t}\n331|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))\n332|}\n333|\n334|// locateSource maps an explicit source to its index handle. An explicit\n335|// unknown alias or host is selector_source_not_found; a known but\n336|// disallowed peer is peer_not_allowlisted. The local source is always\n337|// admitted and needs no allowlist entry.\n338|func (reader *Reader) locateSource(parsed Selector, config validatedConfig) (*sessrepo.Repository, string, error) {\n339|\tswitch parsed.Source {\n340|\tcase SourceLocal:\n341|\t\treturn reader.Local, \"\", nil\n342|\tcase SourcePeerAlias:\n343|\t\thost, ok := config.hostForAlias(reader, parsed.SourceValue)\n344|\t\tif !ok {\n345|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)\n346|\t\t}\n347|\t\tif _, allowed := config.allowed[host]; !allowed {\n348|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)\n349|\t\t}\n350|\t\treturn reader.peerRepo(host)\n351|\tcase SourcePeerHost:\n352|\t\tif config.localHost != \"\" && parsed.SourceValue == config.localHost {\n353|\t\t\treturn reader.Local, \"\", nil\n354|\t\t}\n355|\t\tif !knownPeer(reader, parsed.SourceValue) {\n356|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for host %s\", ErrSourceNotFound, parsed.SourceValue)\n357|\t\t}\n358|\t\tif _, allowed := config.allowed[parsed.SourceValue]; !allowed {\n359|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, parsed.SourceValue)\n360|\t\t}\n361|\t\treturn reader.peerRepo(parsed.SourceValue)\n362|\tdefault:\n363|\t\treturn nil, \"\", fmt.Errorf(\"%w: unknown selector source\", ErrInvalidArgument)\n364|\t}\n365|}\n366|\n367|// knownPeer reports whether a host carries a configured learned index,\n368|// regardless of allowlisting or readability.\n369|func knownPeer(reader *Reader, host string) bool {\n370|\tfor _, peer := range reader.Peers {\n371|\t\tif peer.HostID == host {\n372|\t\t\treturn true\n373|\t\t}\n374|\t}\n375|\treturn false\n376|}\n377|\n378|// peerRepo binds one allowlisted peer host to its learned index handle.\n379|// A peer with no advertised index cannot be completely read, so\n380|// explicit selection refuses with the read-failure class instead of\n381|// treating the source as absent; union tiers simply learn nothing from\n382|// it. A listed index with an unavailable repository is the same failed\n383|// observation.\n384|func (reader *Reader) peerRepo(host string) (*sessrepo.Repository, string, error) {\n385|\tseen := false\n386|\tvar repo *sessrepo.Repository\n387|\tfor _, peer := range reader.Peers {\n388|\t\tif peer.HostID != host {\n389|\t\t\tcontinue\n390|\t\t}\n391|\t\tif seen {\n392|\t\t\treturn nil, \"\", fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, host)\n393|\t\t}\n394|\t\tseen = true\n395|\t\trepo = peer.Repo\n396|\t}\n397|\tif !seen {\n398|\t\treturn nil, \"\", fmt.Errorf(\"%w: peer %s advertises no learned index\", ErrSourceReadFailed, host)\n399|\t}\n400|\tif repo == nil {\n401|\t\treturn nil, \"\", peerReadFailed(host, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, host))\n402|\t}\n403|\treturn repo, host, nil\n404|}\n405|\n406|// readSource completes one source read. Local I-O failures keep their\n407|// repository error; remote failures carry the read-failure class while\n408|// preserving the underlying cause for errors.Is.\n409|func (reader *Reader) readSource(repo *sessrepo.Repository, peerHost string) ([]Summary, error) {\n410|\trows, err := reader.read(repo)\n411|\tif err != nil {\n412|\t\tif peerHost == \"\" {\n413|\t\t\treturn nil, err\n414|\t\t}\n415|\t\treturn nil, peerReadFailed(peerHost, err)\n416|\t}\n417|\treturn rows, nil\n418|}\n419|\n420|// peerReadFailed marks a remote-source read failure with its contract\n421|// class while preserving the underlying cause: a failed read is never\n422|// an absence that lets resolution fall through to another source.\n423|func peerReadFailed(host string, err error) error {\n424|\treturn errors.Join(fmt.Errorf(\"%w: peer %s index read failed\", ErrSourceReadFailed, host), err)\n425|}\n426|\n427|// describeSource names the selected source for refusal evidence: exact\n428|// literal alias or host, never a display name.\n429|func describeSource(parsed Selector) string {\n430|\tswitch parsed.Source {\n431|\tcase SourceLocal:\n432|\t\treturn \"local\"\n433|\tcase SourcePeerAlias:\n434|\t\treturn fmt.Sprintf(\"peer:%s\", parsed.SourceValue)\n435|\tcase SourcePeerHost:\n436|\t\treturn fmt.Sprintf(\"id:%s\", parsed.SourceValue)\n437|\tdefault:\n438|\t\treturn \"bare\"\n439|\t}\n440|}\n441|\n442|// selectIdentity selects a durable session UUID from live candidates\n443|// independent of names: the \"id:\" key form and the UUID tier. Copies\n444|// of one UUID deduplicate only when their immutable record digests\n445|// agree; disagreeing copies are inconsistent authority\n446|// (integrity_failure), not an ambiguity. Identical copies select the\n447|// bytewise smallest holder host.\n448|func selectIdentity(uuid string, pool []candidate, config validatedConfig) (Selection, error) {\n449|\tid, err := scalar.ParseUUIDv7(uuid)\n450|\tif err != nil {\n451|\t\treturn Selection{}, fmt.Errorf(\"%w: malformed session UUID: %v\", ErrInvalidArgument, err)\n452|\t}\n453|\tvar matches []candidate\n454|\tfor _, item := range pool {\n455|\t\tif item.selection.SessionID == id.String() {\n456|\t\t\tmatches = append(matches, item)\n457|\t\t}\n458|\t}\n459|\tif len(matches) == 0 {\n460|\t\treturn Selection{}, fmt.Errorf(\"%w: no live session with ID %q\", ErrNotFound, id.String())\n461|\t}\n462|\tfor _, item := range matches[1:] {\n463|\t\tif item.summary.Projection.RecordID != matches[0].summary.Projection.RecordID {\n464|\t\t\treturn Selection{}, fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, id.String())\n465|\t\t}\n466|\t}\n467|\tbest := matches[0]\n468|\tfor _, item := range matches[1:] {\n469|\t\tif holderHost(item.selection.PeerHostID, config.localHost) < holderHost(best.selection.PeerHostID, config.localHost) {\n470|\t\t\tbest = item\n471|\t\t}\n472|\t}\n473|\treturn best.selection, nil\n474|}\n475|\n476|// holderHost orders copy holders bytewise for the deterministic tie\n477|// break. PeerHostID is empty for local copies; while the local host\n478|// identity is unknown the local copy sorts before every peer,\n479|// preserving local priority there.\n480|func holderHost(peerHost, localHost string) string {\n481|\tif peerHost == \"\" {\n482|\t\tif localHost == \"\" {\n483|\t\t\treturn \"\"\n484|\t\t}\n485|\t\treturn localHost\n486|\t}\n487|\treturn peerHost\n488|}\n489|\n490|// checkRecordAgreement refuses inconsistent authority behind a name\n491|// match: every consulted live copy of the won UUID must carry the same\n492|// immutable record digest. Replicated identical copies stay one\n493|// identity; disagreeing copies are integrity failure, not ambiguity.\n494|func checkRecordAgreement(pool []candidate, won Selection) error {\n495|\tdigest := \"\"\n496|\tseen := false\n497|\tfor _, item := range pool {\n498|\t\tif item.selection.SessionID != won.SessionID {\n499|\t\t\tcontinue\n500|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
