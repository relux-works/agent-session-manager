tring {\n90|\tt.Helper()\n91|\tvalue := map[string]any{\n92|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n93|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n94|\t\t\"lease_epoch\": 1, \"lease_id\": lease, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n95|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n96|\t}\n97|\tref, err := repo.AppendEvent(id, identity(t, value, \"event_id\"))\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\treturn ref.EventID\n102|}","final_result":true}}}
