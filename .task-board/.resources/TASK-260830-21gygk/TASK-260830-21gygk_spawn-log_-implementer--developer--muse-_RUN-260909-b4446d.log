{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f9","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":727,"recorded_at":1780531400001449,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886c1b3a7783b45f41ba252f5a06","text":"Read text file `internal/sessquery/plan_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"reflect\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// appendEventAs chains one event under an explicit envelope lease,\n18|// unlike the epoch-1-only fixtures helper.\n19|func appendEventAs(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, epoch uint64, leaseID string, payload map[string]any) string {\n20|\tt.Helper()\n21|\tvalue := map[string]any{\n22|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n23|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n24|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n25|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n26|\t}\n27|\traw := identity(t, value, \"event_id\")\n28|\tref, err := repo.AppendEvent(id, raw)\n29|\tif err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\treturn ref.EventID\n33|}\n34|\n35|// copySessionDir replicates one persisted session directory byte for\n36|// byte, so two sources hold the same identity with agreeing digests.\n37|func copySessionDir(t *testing.T, srcRoot, dstRoot, sessionID string) {\n38|\tt.Helper()\n39|\tsrc := filepath.Join(srcRoot, \"sessions\", sessionID)\n40|\tdst := filepath.Join(dstRoot, \"sessions\", sessionID)\n41|\tentries, err := os.ReadDir(src)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tif err := os.MkdirAll(filepath.Join(dst, \"events\"), 0o700); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tfor _, entry := range entries {\n49|\t\tif entry.IsDir() {\n50|\t\t\tblobs, err := os.ReadDir(filepath.Join(src, entry.Name()))\n51|\t\t\tif err != nil {\n52|\t\t\t\tt.Fatal(err)\n53|\t\t\t}\n54|\t\t\tfor _, blob := range blobs {\n55|\t\t\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name(), blob.Name()))\n56|\t\t\t\tif err != nil {\n57|\t\t\t\t\tt.Fatal(err)\n58|\t\t\t\t}\n59|\t\t\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name(), blob.Name()), bytes, 0o600); err != nil {\n60|\t\t\t\t\tt.Fatal(err)\n61|\t\t\t\t}\n62|\t\t\t}\n63|\t\t\tcontinue\n64|\t\t}\n65|\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name()))\n66|\t\tif err != nil {\n67|\t\t\tt.Fatal(err)\n68|\t\t}\n69|\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name()), bytes, 0o600); err != nil {\n70|\t\t\tt.Fatal(err)\n71|\t\t}\n72|\t}\n73|}\n74|\n75|// plannedSession builds a local session with its bootstrap event and\n76|// returns the reader, roots, record digest, and created event ID. The\n77|// reader carries the known local host identity every local plan\n78|// requires for its source binding.\n79|func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n80|\tt.Helper()\n81|\tlocal, root := repository(t)\n82|\tref := create(t, local, idA, \"alpha\")\n83|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n84|\treader := &Reader{Local: local, LocalHostID: hostA}\n85|\treturn reader, root, ref, created\n86|}\n87|\n88|func mustBuild(t *testing.T, reader *Reader, args PlanArgs) SelectionPlan {\n89|\tt.Helper()\n90|\tplan, err := reader.BuildPlan(args)\n91|\tif err != nil {\n92|\t\tt.Fatal(err)\n93|\t}\n94|\treturn plan\n95|}\n96|\n97|func mustStale(t *testing.T, err error, reason string) {\n98|\tt.Helper()\n99|\tif !errors.Is(err, ErrPlanStale) {\n100|\t\tt.Fatalf(\"error = %v, want selector_plan_stale\", err)\n101|\t}\n102|\tif !strings.Contains(err.Error(), reason) {\n103|\t\tt.Fatalf(\"error = %v, want reason %q\", err, reason)\n104|\t}\n105|}\n106|\n107|func TestBuildPlanBindsCurrentFacts(t *testing.T) {\n108|\treader, _, ref, created := plannedSession(t)\n109|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n110|\tif plan.SelectorVersion != SelectorVersion || plan.Selector != \"alpha\" || plan.SessionID != idA {\n111|\t\tt.Fatalf(\"identity: %+v\", plan)\n112|\t}\n113|\tif plan.SessionRecordID != ref.RecordID {\n114|\t\tt.Fatalf(\"record digest = %q, want %q\", plan.SessionRecordID, ref.RecordID)\n115|\t}\n116|\tif plan.SourceHostID != hostA || plan.SourceAlias != nil {\n117|\t\tt.Fatalf(\"local source: host %q alias %+v\", plan.SourceHostID, plan.SourceAlias)\n118|\t}\n119|\tfor _, digest := range []string{plan.SourceIndexDigest, plan.ConfigurationDigest, plan.ExpectationDigest} {\n120|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n121|\t\t\tt.Fatalf(\"digest %q: %v\", digest, err)\n122|\t\t}\n123|\t}\n124|\tif plan.SourceIndexDigest == plan.ConfigurationDigest {\n125|\t\tt.Fatalf(\"index and configuration digests collide\")\n126|\t}\n127|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n128|\t\tt.Fatalf(\"lease: %+v\", plan)\n129|\t}\n130|\t// The lease attestation binds the same validated winning-lease\n131|\t// observation deterministically: no standalone Lease Record\n132|\t// object is read, and no digest is fabricated.\n133|\twantLeaseRecord, err := fingerprintWinningLease(idA, 1, lease, hostA)\n134|\tif err != nil {\n135|\t\tt.Fatal(err)\n136|\t}\n137|\tif plan.LeaseRecordID != wantLeaseRecord {\n138|\t\tt.Fatalf(\"lease_record_id = %q, want %q\", plan.LeaseRecordID, wantLeaseRecord)\n139|\t}\n140|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n141|\t\tt.Fatalf(\"lease_record_id %q: %v\", plan.LeaseRecordID, err)\n142|\t}\n143|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n144|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n145|\t}\n146|\tif plan.Action != ActionStatus || plan.DestinationHostID != nil {\n147|\t\tt.Fatalf(\"action: %+v\", plan)\n148|\t}\n149|\tif plan.ExpectationDigest != \"sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a\" {\n150|\t\tt.Fatalf(\"empty expectations digest = %q\", plan.ExpectationDigest)\n151|\t}\n152|\tagain := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n153|\tif !reflect.DeepEqual(plan, again) {\n154|\t\tt.Fatalf(\"rebuild diverged:\\n%+v\\n%+v\", plan, again)\n155|\t}\n156|\tif err := reader.Revalidate(plan); err != nil {\n157|\t\tt.Fatalf(\"fresh plan is not current: %v\", err)\n158|\t}\n159|}\n160|\n161|func TestBuildPlanPeerSourceFacts(t *testing.T) {\n162|\tlocal, _ := repository(t)\n163|\tpeer, _ := repository(t)\n164|\tcreate(t, local, idA, \"alpha\")\n165|\tref := create(t, peer, idB, \"beta\")\n166|\tcreated := appendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n167|\treader := &Reader{\n168|\t\tLocal:              local,\n169|\t\tLocalHostID:        hostB,\n170|\t\tAllowlistedPeerIDs: []string{hostA},\n171|\t\tPeers:              []PeerIndex{{hostA, peer}},\n172|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n173|\t}\n174|\tplan := mustBuild(t, reader, PlanArgs{\n175|\t\tSelector:     \"beta@peer:workstation\",\n176|\t\tAction:       ActionAttach,\n177|\t\tDestination:  hostB,\n178|\t\tExpectations: []byte(`{\"checkpoint_id\":null}`),\n179|\t})\n180|\tif plan.SourceHostID != hostA || plan.SourceAlias == nil || *plan.SourceAlias != \"workstation\" {\n181|\t\tt.Fatalf(\"source: %+v\", plan)\n182|\t}\n183|\tif plan.SessionID != idB || plan.SessionRecordID != ref.RecordID {\n184|\t\tt.Fatalf(\"identity: %+v\", plan)\n185|\t}\n186|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n187|\t\tt.Fatalf(\"lease: %+v\", plan)\n188|\t}\n189|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n190|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n191|\t}\n192|\tif plan.DestinationHostID == nil || *plan.DestinationHostID != hostB {\n193|\t\tt.Fatalf(\"destination: %+v\", plan)\n194|\t}\n195|\tif err := reader.Revalidate(plan); err != nil {\n196|\t\tt.Fatalf(\"fresh peer plan is not current: %v\", err)\n197|\t}\n198|}\n199|\n200|func TestBuildPlanRecordOnlySessionRefusesBootstrap(t *testing.T) {\n201|\tlocal, _ := repository(t)\n202|\tcreate(t, local, idA, \"alpha\")\n203|\treader := &Reader{Local: local, LocalHostID: hostA}\n204|\t// A complete read proving a record without any valid lease is an\n205|\t// interrupted persistence prefix for the bootstrap-recovery leaf:\n206|\t// no plan binds an empty lease triple or placeholder, and there is\n207|\t// nothing current to revalidate.\n208|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n209|\t\tt.Fatalf(\"record-only build = %v, want selector_bootstrap_incomplete\", err)\n210|\t}\n211|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"id:\" + idA, Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n212|\t\tt.Fatalf(\"record-only id build = %v, want selector_bootstrap_incomplete\", err)\n213|\t}\n214|}\n215|\n216|func TestBuildPlanLocalSourceRequiresKnownHost(t *testing.T) {\n217|\treader, _, _, _ := plannedSession(t)\n218|\treader.LocalHostID = \"\"\n219|\t// The local source cannot be named without the local host\n220|\t// identity: the plan binds a UUIDv7 source host or refuses.\n221|\t// Peer selections still bind their own known host.\n222|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrInvalidConfig) {\n223|\t\tt.Fatalf(\"unknown-host local build = %v, want invalid_config\", err)\n224|\t}\n225|\tpeer, _ := repository(t)\n226|\tref := create(t, peer, idB, \"beta\")\n227|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n228|\treader.AllowlistedPeerIDs = []string{hostA}\n229|\treader.Peers = []PeerIndex{{hostA, peer}}\n230|\treader.Aliases = map[string]string{hostA: \"workstation\"}\n231|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus})\n232|\tif plan.SourceHostID != hostA {\n233|\t\tt.Fatalf(\"peer source without local host: %+v\", plan)\n234|\t}\n235|\tif err := reader.Revalidate(plan); err != nil {\n236|\t\tt.Fatalf(\"peer plan without local host is not current: %v\", err)\n237|\t}\n238|}\n239|\n240|func TestBuildPlanArgumentGates(t *testing.T) {\n241|\treader, _, _, _ := plannedSession(t)\n242|\tfor _, args := range []PlanArgs{\n243|\t\t{Selector: \"alpha\", Action: \"launch\"},\n244|\t\t{Selector: \"alpha\", Action: \"\"},\n245|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: \"not-a-uuid\"},\n246|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: lease},\n247|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`{bad`)},\n248|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`[1]`)},\n249|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`\"str\"`)},\n250|\t\t{Selector: \"alpha@unknown\", Action: ActionStatus},\n251|\t\t{Selector: \"\", Action: ActionStatus},\n252|\t} {\n253|\t\tif _, err := reader.BuildPlan(args); !errors.Is(err, ErrInvalidArgument) {\n254|\t\t\tt.Fatalf(\"BuildPlan(%+v) = %v, want invalid_arguments\", args, err)\n255|\t\t}\n256|\t}\n257|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\"}); !errors.Is(err, ErrInvalidArgument) {\n258|\t\tt.Fatalf(\"missing action: %v\", err)\n259|\t}\n260|}\n261|\n262|func TestPlanDigestAndMarshalRoundTrip(t *testing.T) {\n263|\treader, _, _, _ := plannedSession(t)\n264|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionDiff})\n265|\tfirst, err := plan.Digest()\n266|\tif err != nil {\n267|\t\tt.Fatal(err)\n268|\t}\n269|\tsecond, err := plan.Digest()\n270|\tif err != nil || first != second {\n271|\t\tt.Fatalf(\"digest unstable: %q %q %v\", first, second, err)\n272|\t}\n273|\traw, err := plan.Marshal()\n274|\tif err != nil {\n275|\t\tt.Fatal(err)\n276|\t}\n277|\tparsed, err := ParsePlan(raw)\n278|\tif err != nil {\n279|\t\tt.Fatal(err)\n280|\t}\n281|\tif !reflect.DeepEqual(plan, parsed) {\n282|\t\tt.Fatalf(\"round trip diverged:\\n%+v\\n%+v\", plan, parsed)\n283|\t}\n284|\t// Tampering with any member breaks the locally verified digest.\n285|\tvar wire map[string]any\n286|\tif err := json.Unmarshal(raw, &wire); err != nil {\n287|\t\tt.Fatal(err)\n288|\t}\n289|\twire[\"action\"] = ActionAttach\n290|\ttampered, err := json.Marshal(wire)\n291|\tif err != nil {\n292|\t\tt.Fatal(err)\n293|\t}\n294|\tif _, err := ParsePlan(tampered); !errors.Is(err, ErrInvalidArgument) {\n295|\t\tt.Fatalf(\"tampered plan parsed: %v\", err)\n296|\t}\n297|\tif _, err := ParsePlan([]byte(`{broken`)); !errors.Is(err, ErrInvalidArgument) {\n298|\t\tt.Fatalf(\"malformed encoding: %v\", err)\n299|\t}\n300|\t// A valid persisted encoding is never authority by itself: current\n301|\t// facts still decide through Revalidate.\n302|\traw, err = plan.Marshal()\n303|\tif err != nil {\n304|\t\tt.Fatal(err)\n305|\t}\n306|\tparsed, err = ParsePlan(raw)\n307|\tif err != nil {\n308|\t\tt.Fatal(err)\n309|\t}\n310|\tappendEvent(t, reader.Local, idA, parsed.AuthorityHeads[0], \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n311|\tif err := reader.Revalidate(parsed); !errors.Is(err, ErrPlanStale) {\n312|\t\tt.Fatalf(\"persisted digest overrode current facts: %v\", err)\n313|\t}\n314|}\n315|\n316|func TestRevalidateDetectsEachFactChange(t *testing.T) {\n317|\tt.Run(\"same lease event changes heads\", func(t *testing.T) {\n318|\t\treader, _, _, _ := plannedSession(t)\n319|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n320|\t\ttail := plan.AuthorityHeads[0]\n321|\t\tappendEvent(t, reader.Local, idA, tail, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n322|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n323|\t})\n324|\tt.Run(\"successor lease changes winner\", func(t *testing.T) {\n325|\t\treader, _, _, created := plannedSession(t)\n326|\t\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n327|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n328|\t\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n329|\t\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n330|\t\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n331|\t\t})\n332|\t\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n333|\t})\n334|\tt.Run(\"record replacement changes digest\", func(t *testing.T) {\n335|\t\treader, root, _, _ := plannedSession(t)\n336|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n337|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), record(t, idA, \"renamed\"), 0o600); err != nil {\n338|\t\t\tt.Fatal(err)\n339|\t\t}\n340|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n341|\t})\n342|\tt.Run(\"alias remap changes binding\", func(t *testing.T) {\n343|\t\tlocal, _ := repository(t)\n344|\t\trepoA, rootA := repository(t)\n345|\t\trepoB, rootB := repository(t)\n346|\t\tref := create(t, repoA, idA, \"shared\")\n347|\t\tappendEvent(t, repoA, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n348|\t\tcopySessionDir(t, rootA, rootB, idA)\n349|\t\treader := &Reader{\n350|\t\t\tLocal:              local,\n351|\t\t\tAllowlistedPeerIDs: []string{hostA, hostB},\n352|\t\t\tPeers:              []PeerIndex{{hostA, repoA}, {hostB, repoB}},\n353|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n354|\t\t}\n355|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"shared@peer:ws\", Action: ActionStatus})\n356|\t\tif plan.SourceHostID != hostA {\n357|\t\t\tt.Fatalf(\"source: %+v\", plan)\n358|\t\t}\n359|\t\treader.Aliases = map[string]string{hostB: \"ws\"}\n360|\t\tmustStale(t, reader.Revalidate(plan), \"source binding changed\")\n361|\t})\n362|\tt.Run(\"unrelated mapping change changes configuration\", func(t *testing.T) {\n363|\t\treader, _, _, _ := plannedSession(t)\n364|\t\tpeer, _ := repository(t)\n365|\t\treader.Peers = []PeerIndex{{hostC, peer}}\n366|\t\treader.AllowlistedPeerIDs = []string{hostC}\n367|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n368|\t\treader.Aliases = map[string]string{hostC: \"ws\"}\n369|\t\tmustStale(t, reader.Revalidate(plan), \"configuration changed\")\n370|\t})\n371|\tt.Run(\"revocation refuses allowlist\", func(t *testing.T) {\n372|\t\tlocal, _ := repository(t)\n373|\t\tpeer, _ := repository(t)\n374|\t\tlocalRef := create(t, local, idA, \"alpha\")\n375|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n376|\t\tpeerRef := create(t, peer, idB, \"beta\")\n377|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n378|\t\treader := &Reader{\n379|\t\t\tLocal:              local,\n380|\t\t\tAllowlistedPeerIDs: []string{hostA},\n381|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n382|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n383|\t\t}\n384|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n385|\t\treader.AllowlistedPeerIDs = nil\n386|\t\terr := reader.Revalidate(plan)\n387|\t\tif !errors.Is(err, ErrPeerNotAllowlisted) {\n388|\t\t\tt.Fatalf(\"revocation = %v, want peer_not_allowlisted\", err)\n389|\t\t}\n390|\t})\n391|\tt.Run(\"tombstone invalidates live plan\", func(t *testing.T) {\n392|\t\treader, _, ref, created := plannedSession(t)\n393|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n394|\t\tfailed := appendEvent(t, reader.Local, idA, created, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n395|\t\t_ = ref\n396|\t\tappendEvent(t, reader.Local, idA, failed, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n397|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n398|\t})\n399|\tt.Run(\"deletion empties selection\", func(t *testing.T) {\n400|\t\treader, root, _, _ := plannedSession(t)\n401|\t\t// A surviving sibling keeps the index readable, so only the\n402|\t\t// absence check can report the planned identity: substituting\n403|\t\t// the sibling must never validate.\n404|\t\tcreate(t, reader.Local, idB, \"bravo\")\n405|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n406|\t\tif err := os.RemoveAll(filepath.Join(root, \"sessions\", idA)); err != nil {\n407|\t\t\tt.Fatal(err)\n408|\t\t}\n409|\t\tmustStale(t, reader.Revalidate(plan), \"selection absent from source index\")\n410|\t})\n411|\tt.Run(\"unrelated session change changes index\", func(t *testing.T) {\n412|\t\treader, _, _, _ := plannedSession(t)\n413|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n414|\t\tref := create(t, reader.Local, idB, \"bravo\")\n415|\t\tappendEvent(t, reader.Local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n416|\t\tmustStale(t, reader.Revalidate(plan), \"source index changed\")\n417|\t})\n418|\tt.Run(\"invalid projection propagates\", func(t *testing.T) {\n419|\t\treader, _, ref, created := plannedSession(t)\n420|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n421|\t\t// A terminal close followed by a second bootstrap is\n422|\t\t// continuity-admitted by the repository and refused by the\n423|\t\t// state owner: the failure reaches revalidation unchanged,\n424|\t\t// never as absence or staleness.\n425|\t\tprevious := created\n426|\t\tfor index, row := range []struct {\n427|\t\t\ttyp     string\n428|\t\t\tpayload map[string]any\n429|\t\t}{\n430|\t\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n431|\t\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n432|\t\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n433|\t\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n434|\t\t\t{\"session.stopped\", map[string]any{\"graceful\": true, \"checkpoint_id\": zeroDigest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}},\n435|\t\t} {\n436|\t\t\tprevious = appendEvent(t, reader.Local, idA, previous, row.typ, index+2, row.payload)\n437|\t\t}\n438|\t\tappendEvent(t, reader.Local, idA, previous, \"session.created\", 7, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n439|\t\terr := reader.Revalidate(plan)\n440|\t\tif err == nil || errors.Is(err, ErrPlanStale) || errors.Is(err, ErrNotFound) {\n441|\t\t\tt.Fatalf(\"projection failure became %v\", err)\n442|\t\t}\n443|\t\tif !errors.Is(err, sessstate.ErrInvalidTransition) {\n444|\t\t\tt.Fatalf(\"projection failure = %v\", err)\n445|\t\t}\n446|\t})\n447|}\n448|\n449|func TestRevalidateReadFailures(t *testing.T) {\n450|\tt.Run(\"peer read failure keeps class\", func(t *testing.T) {\n451|\t\tlocal, _ := repository(t)\n452|\t\tpeer, peerRoot := repository(t)\n453|\t\tlocalRef := create(t, local, idA, \"alpha\")\n454|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n455|\t\tpeerRef := create(t, peer, idB, \"beta\")\n456|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n457|\t\treader := &Reader{\n458|\t\t\tLocal:              local,\n459|\t\t\tAllowlistedPeerIDs: []string{hostA},\n460|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n461|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n462|\t\t}\n463|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n464|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n465|\t\t\tt.Fatal(err)\n466|\t\t}\n467|\t\terr := reader.Revalidate(plan)\n468|\t\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n469|\t\t\tt.Fatalf(\"peer revalidation failure = %v\", err)\n470|\t\t}\n471|\t})\n472|\tt.Run(\"local read failure keeps repository error\", func(t *testing.T) {\n473|\t\treader, root, _, _ := plannedSession(t)\n474|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n475|\t\tif err := os.Rename(filepath.Join(root, \"sessions\"), filepath.Join(root, \"saved\")); err != nil {\n476|\t\t\tt.Fatal(err)\n477|\t\t}\n478|\t\terr := reader.Revalidate(plan)\n479|\t\tif !errors.Is(err, sessrepo.ErrRepositoryPath) {\n480|\t\t\tt.Fatalf(\"local revalidation failure = %v\", err)\n481|\t\t}\n482|\t\tif errors.Is(err, ErrSourceReadFailed) {\n483|\t\t\tt.Fatalf(\"local failure misclassified as remote: %v\", err)\n484|\t\t}\n485|\t})\n486|\tt.Run(\"never falls back to another source\", func(t *testing.T) {\n487|\t\tlocal, _ := repository(t)\n488|\t\tpeer, peerRoot := repository(t)\n489|\t\tlocalRef := create(t, local, idA, \"beta\")\n490|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n491|\t\tpeerRef := create(t, peer, idB, \"beta\")\n492|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n493|\t\treader := &Reader{\n494|\t\t\tLocal:              local,\n495|\t\t\tAllowlistedPeerIDs: []string{hostA},\n496|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n497|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n498|\t\t}\n499|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n500|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8fb","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":728,"recorded_at":1780531400001451,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886c1bd27080a9ae1a5452ec0b42","text":"Read text file `internal/sessquery/union_test.go`.\n1|// Complete-authority union tests for TASK-260830-21gygk: revalidation\n2|// and construction validate the pinned session UUID across the local\n3|// and every allowlisted source without re-resolving names or\n4|// substituting selections.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// leasedPeerSession creates a leased session on a peer repository for\n18|// union fixtures.\n19|func leasedPeerSession(t *testing.T, peer *sessrepo.Repository, id, name string) sessrepo.SessionRef {\n20|\tt.Helper()\n21|\tref := create(t, peer, id, name)\n22|\tappendEvent(t, peer, id, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n23|\treturn ref\n24|}\n25|\n26|// unionReader builds a local/peer reader whose peer holds a leased\n27|// session and whose local side starts empty.\n28|func unionReader(t *testing.T, local, peer *sessrepo.Repository) *Reader {\n29|\tt.Helper()\n30|\treturn &Reader{\n31|\t\tLocal:              local,\n32|\t\tLocalHostID:        hostB,\n33|\t\tAllowlistedPeerIDs: []string{hostA},\n34|\t\tPeers:              []PeerIndex{{hostA, peer}},\n35|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n36|\t}\n37|}\n38|\n39|func TestRevalidateUnionLeaseDivergenceRefusesStale(t *testing.T) {\n40|\tlocal, _ := repository(t)\n41|\tpeer, _ := repository(t)\n42|\tleasedPeerSession(t, peer, idB, \"beta\")\n43|\treader := unionReader(t, local, peer)\n44|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n45|\tif err := reader.Revalidate(plan); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\t// The local source learns the same immutable record, then observes\n49|\t// a successor winning lease the plan source has not seen.\n50|\tref := create(t, local, idB, \"beta\")\n51|\tif ref.RecordID != plan.SessionRecordID {\n52|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", ref.RecordID, plan.SessionRecordID)\n53|\t}\n54|\tcreated := appendEvent(t, local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n55|\tlaunched := appendEvent(t, local, idB, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n56|\tappendEventAs(t, local, idB, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n57|\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n58|\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n59|\t})\n60|\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n61|}\n62|\n63|func TestRevalidateUnionTombstoneRefusesStale(t *testing.T) {\n64|\tlocal, _ := repository(t)\n65|\tpeer, _ := repository(t)\n66|\tleasedPeerSession(t, peer, idB, \"beta\")\n67|\treader := unionReader(t, local, peer)\n68|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n69|\tref := create(t, local, idB, \"beta\")\n70|\tif ref.RecordID != plan.SessionRecordID {\n71|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", ref.RecordID, plan.SessionRecordID)\n72|\t}\n73|\tevent := appendEvent(t, local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n74|\tevent = appendEvent(t, local, idB, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n75|\tappendEvent(t, local, idB, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n76|\tmustStale(t, reader.Revalidate(plan), \"tombstone evidence changed\")\n77|}\n78|\n79|func TestRevalidateUnionAgreeingReplicaStaysCurrent(t *testing.T) {\n80|\tlocal, _ := repository(t)\n81|\tpeer, _ := repository(t)\n82|\tref := leasedPeerSession(t, peer, idB, \"beta\")\n83|\treader := unionReader(t, local, peer)\n84|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n85|\t// A lagging source replicating the same record and the identical\n86|\t// bootstrap event observes agreeing authority: no refusal.\n87|\tlocalRef := create(t, local, idB, \"beta\")\n88|\tif localRef.RecordID != ref.RecordID {\n89|\t\tt.Fatalf(\"fixture records diverged: %q vs %q\", localRef.RecordID, ref.RecordID)\n90|\t}\n91|\tappendEvent(t, local, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n92|\tif err := reader.Revalidate(plan); err != nil {\n93|\t\tt.Fatalf(\"agreeing replica invalidated plan: %v\", err)\n94|\t}\n95|}\n96|\n97|func TestRevalidateUnionParkedCopyIgnored(t *testing.T) {\n98|\tlocal, _ := repository(t)\n99|\tpeer, _ := repository(t)\n100|\tleasedPeerSession(t, peer, idB, \"beta\")\n101|\treader := unionReader(t, local, peer)\n102|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n103|\t// A parked copy is a failed observation, never tombstone or\n104|\t// record evidence: it cannot contradict the plan.\n105|\tlocal.AfterCreateStep = func(step sessrepo.CreateStep) error {\n106|\t\tif step == sessrepo.CreateStepRecord {\n107|\t\t\treturn errors.New(\"crash\")\n108|\t\t}\n109|\t\treturn nil\n110|\t}\n111|\tif _, err := local.CreateSession(record(t, idB, \"different-record\")); err == nil {\n112|\t\tt.Fatal(\"fault did not fire\")\n113|\t}\n114|\tlocal.AfterCreateStep = nil\n115|\tif err := reader.Revalidate(plan); err != nil {\n116|\t\tt.Fatalf(\"parked copy invalidated plan: %v\", err)\n117|\t}\n118|}\n119|\n120|func TestRevalidateUnionUnreadablePeerRefuses(t *testing.T) {\n121|\treader, _, _, _ := plannedSession(t)\n122|\tpeer, peerRoot := repository(t)\n123|\treader.AllowlistedPeerIDs = []string{hostC}\n124|\treader.Peers = []PeerIndex{{hostC, peer}}\n125|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n126|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n127|\t\tt.Fatal(err)\n128|\t}\n129|\t// The complete authority union cannot be validated without the\n130|\t// allowlisted peer read: the failure keeps its class.\n131|\terr := reader.Revalidate(plan)\n132|\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n133|\t\tt.Fatalf(\"unreadable union peer = %v\", err)\n134|\t}\n135|}\n136|\n137|func TestBuildPlanValidatesUnionAtBuild(t *testing.T) {\n138|\tlocal, _ := repository(t)\n139|\tpeer, _ := repository(t)\n140|\tleasedPeerSession(t, peer, idB, \"beta\")\n141|\tcreate(t, local, idB, \"different-record\")\n142|\treader := unionReader(t, local, peer)\n143|\t// The explicit peer selection never falls back, and the build\n144|\t// still validates the pinned UUID union: the contradictory local\n145|\t// record is integrity failure at construction.\n146|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n147|\t\tt.Fatalf(\"explicit build over divergent union = %v\", err)\n148|\t}\n149|\t// The mirror direction behaves the same: a leased local selection\n150|\t// against a divergent peer copy refuses without substituting it.\n151|\tlocalOnly, _ := repository(t)\n152|\tlocalRef := create(t, localOnly, idB, \"beta\")\n153|\tappendEvent(t, localOnly, idB, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n154|\tdivergent, _ := repository(t)\n155|\tcreate(t, divergent, idB, \"different-record\")\n156|\tmirror := &Reader{\n157|\t\tLocal:              localOnly,\n158|\t\tLocalHostID:        hostB,\n159|\t\tAllowlistedPeerIDs: []string{hostA},\n160|\t\tPeers:              []PeerIndex{{hostA, divergent}},\n161|\t}\n162|\tif _, err := mirror.BuildPlan(PlanArgs{Selector: \"beta@local\", Action: ActionStatus}); !errors.Is(err, sessstate.ErrIntegrity) {\n163|\t\tt.Fatalf(\"local build over divergent union = %v\", err)\n164|\t}\n165|}\n166|\n167|func TestRevalidateUnionNameDriftStaysCurrent(t *testing.T) {\n168|\tlocal, _ := repository(t)\n169|\tpeer, _ := repository(t)\n170|\tleasedPeerSession(t, peer, idB, \"beta\")\n171|\treader := unionReader(t, local, peer)\n172|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta\", Action: ActionStatus})\n173|\tif plan.SourceHostID != hostA {\n174|\t\tt.Fatalf(\"source: %+v\", plan)\n175|\t}\n176|\t// A different UUID gaining the same live name locally moves fresh\n177|\t// name resolution but never retargets the pinned plan: names are\n178|\t// not re-resolved and the drift alone is not a defect.\n179|\tdrift := create(t, local, idC, \"beta\")\n180|\tappendEvent(t, local, idC, drift.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": drift.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n181|\tif err := reader.Revalidate(plan); err != nil {\n182|\t\tt.Fatalf(\"same-name gain invalidated pinned plan: %v\", err)\n183|\t}\n184|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8fd","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":729,"recorded_at":1780531400001453,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886c1c6b7032b8f0bfbdb8541706","text":"Read text file `internal/sessquery/summary_test.go`.\n1|// Authoritative summary tests for TASK-260830-21gygk (SPEC 14.7.3):\n2|// bootstrap refusal, whole-list refusal, validated host and\n3|// observation inputs, and observation-unavailable classification,\n4|// all driven through the production summary entries.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"reflect\"\n10|\t\"testing\"\n11|)\n12|\n13|// summaryReader builds a leased local session with host metadata for\n14|// its owner and returns the reader.\n15|func summaryReader(t *testing.T) *Reader {\n16|\tt.Helper()\n17|\trepo, _ := repository(t)\n18|\tref := create(t, repo, idA, \"alpha\")\n19|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n20|\treturn &Reader{\n21|\t\tLocal:        repo,\n22|\t\tLocalHostID:  hostA,\n23|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n24|\t}\n25|}\n26|\n27|func TestSummaryBootstrapRefusals(t *testing.T) {\n28|\tlocal, _ := repository(t)\n29|\tcreate(t, local, idA, \"alpha\")\n30|\treader := &Reader{Local: local, LocalHostID: hostA}\n31|\tfor _, selector := range []string{\"alpha\", idA, \"id:\" + idA, \"alpha@local\"} {\n32|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n33|\t\t\tt.Fatalf(\"Status(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n34|\t\t}\n35|\t\tif _, err := reader.AuthoritativeStatus(selector); !errors.Is(err, ErrBootstrapIncomplete) {\n36|\t\t\tt.Fatalf(\"AuthoritativeStatus(%q) = %v, want selector_bootstrap_incomplete\", selector, err)\n37|\t\t}\n38|\t}\n39|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrBootstrapIncomplete) {\n40|\t\tt.Fatalf(\"AuthoritativeList = %v, want selector_bootstrap_incomplete\", err)\n41|\t}\n42|\t// Explicit local inspection keeps raw access to the recovery\n43|\t// diagnostics: it is not a public summary entry.\n44|\tinspected, err := reader.InspectLocal(idA)\n45|\tif err != nil || inspected.Projection.SessionID != idA {\n46|\t\tt.Fatalf(\"InspectLocal = %+v, %v\", inspected, err)\n47|\t}\n48|}\n49|\n50|func TestSummaryMixedListRefusesWhole(t *testing.T) {\n51|\trepo, _ := repository(t)\n52|\thealthy := create(t, repo, idA, \"alpha\")\n53|\tappendEvent(t, repo, idA, healthy.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": healthy.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n54|\tcreate(t, repo, idB, \"Zed\")\n55|\treader := &Reader{\n56|\t\tLocal:        repo,\n57|\t\tLocalHostID:  hostA,\n58|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n59|\t}\n60|\t// One unrepresentable record refuses the whole document: no\n61|\t// partial rows escape, and the healthy entry is not silently\n62|\t// kept while the incomplete one is omitted.\n63|\trows, err := reader.List()\n64|\tif !errors.Is(err, ErrBootstrapIncomplete) || rows != nil {\n65|\t\tt.Fatalf(\"List = %d rows, %v, want whole selector_bootstrap_incomplete refusal\", len(rows), err)\n66|\t}\n67|\tauthorized, err := reader.AuthoritativeList()\n68|\tif !errors.Is(err, ErrBootstrapIncomplete) || authorized != nil {\n69|\t\tt.Fatalf(\"AuthoritativeList = %d rows, %v, want whole refusal\", len(authorized), err)\n70|\t}\n71|}\n72|\n73|func TestAuthoritativeStatusHealthy(t *testing.T) {\n74|\treader := summaryReader(t)\n75|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\tif summary.SessionID != idA || summary.Name != \"alpha\" || summary.Kind != \"direct\" || summary.ProviderID != \"codex\" || summary.State != \"creating\" {\n80|\t\tt.Fatalf(\"identity: %+v\", summary)\n81|\t}\n82|\tif summary.OwnerHostID != hostA || summary.OwnerHostName != \"primary\" || summary.LeaseEpoch != 1 || summary.LeaseID != lease || summary.LocalRole != \"owner\" {\n83|\t\tt.Fatalf(\"authority: %+v\", summary)\n84|\t}\n85|\t// Before the first checkpoint both checkpoint members are null;\n86|\t// unobserved optionals stay nil instead of minted facts.\n87|\tif !summary.HasCheckpoint && (summary.NewestCheckpointID != nil || summary.NewestCheckpointCreatedAt != nil) {\n88|\t\tt.Fatalf(\"checkpoint before first checkpoint: %+v\", summary)\n89|\t}\n90|\tif summary.ProcessPresent != nil || summary.Capabilities != nil || summary.WorkspacePresent != nil {\n91|\t\tt.Fatalf(\"minted observations: %+v\", summary)\n92|\t}\n93|\tlist, err := reader.AuthoritativeList()\n94|\tif err != nil || len(list) != 1 || !reflect.DeepEqual(list[0], summary) {\n95|\t\tt.Fatalf(\"list/status disagreement: %+v %v\", list, err)\n96|\t}\n97|}\n98|\n99|func TestAuthoritativeMissingHostMetadataRefuses(t *testing.T) {\n100|\treader := summaryReader(t)\n101|\t// The internal status stays representable: only the authoritative\n102|\t// layer requires the validated owner name.\n103|\tif _, err := reader.Status(\"alpha\"); err != nil {\n104|\t\tt.Fatal(err)\n105|\t}\n106|\treader.HostMetadata = nil\n107|\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrObservationUnavailable) {\n108|\t\tt.Fatalf(\"missing host metadata = %v, want selector_observation_unavailable\", err)\n109|\t}\n110|\tif _, err := reader.AuthoritativeList(); !errors.Is(err, ErrObservationUnavailable) {\n111|\t\tt.Fatalf(\"missing host metadata list = %v, want selector_observation_unavailable\", err)\n112|\t}\n113|\t// The source alias never substitutes for host metadata.\n114|\treader.HostMetadata = map[string]HostMetadata{hostB: {DisplayName: \"workstation\"}}\n115|\treader.Aliases = map[string]string{hostB: \"workstation\"}\n116|\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrObservationUnavailable) {\n117|\t\tt.Fatalf(\"alias-substituted metadata = %v, want selector_observation_unavailable\", err)\n118|\t}\n119|}\n120|\n121|func TestAuthoritativeUnknownLocalHostRefuses(t *testing.T) {\n122|\treader := summaryReader(t)\n123|\treader.LocalHostID = \"\"\n124|\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrObservationUnavailable) {\n125|\t\tt.Fatalf(\"unknown local host = %v, want selector_observation_unavailable\", err)\n126|\t}\n127|}\n128|\n129|func TestAuthoritativeCheckpointRequiresTimestamp(t *testing.T) {\n130|\trepo, _ := repository(t)\n131|\tref := create(t, repo, idA, \"Checkpointed\")\n132|\tprevious := ref.RecordID\n133|\trows := []struct {\n134|\t\ttyp     string\n135|\t\tpayload map[string]any\n136|\t}{\n137|\t\t{\"session.created\", map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB}},\n138|\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n139|\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n140|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n141|\t}\n142|\tfor index, row := range rows {\n143|\t\tprevious = appendEvent(t, repo, idA, previous, row.typ, index+1, row.payload)\n144|\t}\n145|\treader := &Reader{\n146|\t\tLocal:        repo,\n147|\t\tLocalHostID:  hostA,\n148|\t\tHostMetadata: map[string]HostMetadata{hostA: {DisplayName: \"primary\"}},\n149|\t}\n150|\tif _, err := reader.AuthoritativeStatus(\"Checkpointed\"); !errors.Is(err, ErrObservationUnavailable) {\n151|\t\tt.Fatalf(\"checkpoint without timestamp observation = %v, want selector_observation_unavailable\", err)\n152|\t}\n153|\tstamp := \"2026-08-19T04:09:30.000Z\"\n154|\treader.Observations = map[string]SessionObservations{idA: {NewestCheckpointCreatedAt: &stamp}}\n155|\tsummary, err := reader.AuthoritativeStatus(\"Checkpointed\")\n156|\tif err != nil {\n157|\t\tt.Fatal(err)\n158|\t}\n159|\tif !summary.HasCheckpoint || summary.NewestCheckpointID == nil || *summary.NewestCheckpointID != zeroDigest {\n160|\t\tt.Fatalf(\"checkpoint id: %+v\", summary)\n161|\t}\n162|\tif summary.NewestCheckpointCreatedAt == nil || *summary.NewestCheckpointCreatedAt != stamp {\n163|\t\tt.Fatalf(\"checkpoint timestamp: %+v\", summary)\n164|\t}\n165|}\n166|\n167|func TestAuthoritativeInputValidation(t *testing.T) {\n168|\treader := summaryReader(t)\n169|\tbadStamp := \"not-a-timestamp\"\n170|\tcases := []struct {\n171|\t\tname   string\n172|\t\tmutate func()\n173|\t}{\n174|\t\t{\"host key\", func() {\n175|\t\t\treader.HostMetadata = map[string]HostMetadata{\"nope\": {DisplayName: \"primary\"}}\n176|\t\t}},\n177|\t\t{\"empty display name\", func() {\n178|\t\t\treader.HostMetadata = map[string]HostMetadata{hostA: {}}\n179|\t\t}},\n180|\t\t{\"control display name\", func() {\n181|\t\t\treader.HostMetadata = map[string]HostMetadata{hostA: {DisplayName: \"a\\tb\"}}\n182|\t\t}},\n183|\t\t{\"observation key\", func() {\n184|\t\t\treader.Observations = map[string]SessionObservations{\"nope\": {}}\n185|\t\t}},\n186|\t\t{\"malformed timestamp\", func() {\n187|\t\t\treader.Observations = map[string]SessionObservations{idA: {NewestCheckpointCreatedAt: &badStamp}}\n188|\t\t}},\n189|\t\t{\"empty capability\", func() {\n190|\t\t\treader.Observations = map[string]SessionObservations{idA: {Capabilities: []string{\"\"}}}\n191|\t\t}},\n192|\t}\n193|\tfor _, row := range cases {\n194|\t\tt.Run(row.name, func(t *testing.T) {\n195|\t\t\tsnapshotHosts, snapshotObs := reader.HostMetadata, reader.Observations\n196|\t\t\trow.mutate()\n197|\t\t\tdefer func() { reader.HostMetadata, reader.Observations = snapshotHosts, snapshotObs }()\n198|\t\t\tif _, err := reader.AuthoritativeStatus(\"alpha\"); !errors.Is(err, ErrInvalidConfig) {\n199|\t\t\t\tt.Fatalf(\"malformed authority input = %v, want invalid_config\", err)\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|func TestAuthoritativeOptionalObservations(t *testing.T) {\n206|\treader := summaryReader(t)\n207|\tpresent, workspace := true, false\n208|\treader.Observations = map[string]SessionObservations{idA: {\n209|\t\tProcessPresent:   &present,\n210|\t\tCapabilities:     []string{\"exec\", \"net\"},\n211|\t\tWorkspacePresent: &workspace,\n212|\t}}\n213|\tsummary, err := reader.AuthoritativeStatus(\"alpha\")\n214|\tif err != nil {\n215|\t\tt.Fatal(err)\n216|\t}\n217|\tif summary.ProcessPresent == nil || !*summary.ProcessPresent {\n218|\t\tt.Fatalf(\"liveness: %+v\", summary)\n219|\t}\n220|\tif !reflect.DeepEqual(summary.Capabilities, []string{\"exec\", \"net\"}) {\n221|\t\tt.Fatalf(\"capabilities: %+v\", summary)\n222|\t}\n223|\tif summary.WorkspacePresent == nil || *summary.WorkspacePresent {\n224|\t\tt.Fatalf(\"workspace: %+v\", summary)\n225|\t}\n226|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
