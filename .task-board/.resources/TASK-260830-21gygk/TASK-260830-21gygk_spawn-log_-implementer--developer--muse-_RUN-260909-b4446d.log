any{\"session_record_id\": digest, \"bootstrap_operation_id\": uuid, \"first_checkpoint_operation_id\": bundleID}\n725|\tcase \"terminal.created\":\n726|\t\tif version == \"4.0.0\" {\n727|\t\t\treturn terminalV4Payload()\n728|\t\t}\n729|\t\treturn map[string]any{\"backend\": \"tmux\", \"terminal_id\": \"ax-session\"}\n730|\tcase \"provider.launched\":\n731|\t\treturn map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"--dangerously-bypass-approvals-and-sandbox\"}\n732|\tcase \"provider.identified\":\n733|\t\treturn map[string]any{\"provider_identity_record_id\": digest, \"confidence\": \"exact\"}\n734|\tcase \"session.idle\":\n735|\t\treturn map[string]any{\"boundary_ref\": \"provider-event-1\", \"foreground_idle\": true, \"background_idle\": true}\n736|\tcase \"session.quiescing\":\n737|\t\treturn map[string]any{\"operation_id\": uuid, \"reason\": \"checkpoint\", \"input_blocked\": true}\n738|\tcase \"checkpoint.created\":\n739|\t\treturn map[string]any{\"checkpoint_id\": digest, \"kind\": \"manual\"}\n740|\tcase \"sync.completed\":\n741|\t\treturn map[string]any{\"peer_host_id\": peerHostID, \"checkpoint_id\": digest, \"manifest_ids\": []any{digest}, \"materialized\": true}\n742|\tcase \"session.stopped\":\n743|\t\treturn map[string]any{\"graceful\": true, \"checkpoint_id\": digest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}\n744|\tcase \"session.resumed\":\n745|\t\tif version == \"4.0.0\" {\n746|\t\t\tp := terminalV4Payload()\n747|\t\t\tp[\"checkpoint_id\"] = digest\n748|\t\t\tp[\"execution_profile\"] = \"yolo\"\n749|\t\t\tp[\"profile_source_event_id\"] = nil\n750|\t\t\treturn p\n751|\t\t}\n752|\t\treturn map[string]any{\"checkpoint_id\": digest, \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session\"}\n753|\tcase \"session.bootstrap_aborted\":\n754|\t\treturn map[string]any{\"operation_id\": uuid, \"failure_phase\": \"after_identity\", \"provider_identity_record_id\": digest, \"manager_session_ref\": nil, \"process_closed\": true, \"store_closed\": true, \"resume_allowed\": false}\n755|\tcase \"lease.transferred\":\n756|\t\treturn map[string]any{\"operation_id\": uuid, \"from_host_id\": hostID, \"to_host_id\": peerHostID, \"predecessor_lease_id\": priorLease, \"new_lease_id\": leaseID}\n757|\tcase \"lease.forced\":\n758|\t\treturn map[string]any{\"operation_id\": uuid, \"expected_owner_host_id\": hostID, \"expected_epoch\": json.Number(\"3\"), \"new_lease_id\": leaseID, \"checkpoint_id\": digest}\n759|\tcase \"session.parked\":\n(more lines below)","final_result":true}}}
