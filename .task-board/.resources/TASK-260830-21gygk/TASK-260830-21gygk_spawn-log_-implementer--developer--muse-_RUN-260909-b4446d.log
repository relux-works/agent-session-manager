{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fd","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":345,"recorded_at":1780531400000685,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886b-81ae-7542-9e18-ba93b99b6e4e"},"task_id":"01a0886b-81ae-7542-9e18-ba93b99b6e4e","event":{"kind":"output","task_id":"01a0886b-81ae-7542-9e18-ba93b99b6e4e","chunk":"Read text file `internal/sessquery/revalidate.go`.\n1|// SelectionPlan revalidation, shape checks, and tamper-evident\n2|// persistence for the v0.6.0 selector contract (SPEC Section 14.7.2).\n3|//\n4|// Compare order is normative for refusal evidence (every refusal keeps\n5|// the single selector_plan_stale class, except revocation,\n6|// cross-source integrity, and failures): caller shapes, current\n7|// configuration validation, authorization revocation, source binding,\n8|// configuration digest, source read, selection absence, current\n9|// projection, session record, winning lease, authority heads, the\n10|// source index digest, and finally the complete authority union for\n11|// the pinned session across the remaining allowed sources.\n12|// Fine-grained reasons distinguish the checks without splitting the\n13|// class; tests assert both.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"fmt\"\n19|\t\"sort\"\n20|\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|// uint53Ceiling is the AX safe-integer ceiling for lease epochs.\n26|const uint53Ceiling = uint64(1<<53 - 1)\n27|\n28|// Revalidate compares every bound plan fact against current\n29|// configuration and freshly reread source data, then validates the\n30|// complete authority union for the pinned session UUID across the\n31|// remaining allowed sources. The session is located by its UUID in\n32|// each source, never re-resolved by name. A nil return means the plan\n33|// is current; any error classifies exactly: selector_plan_stale (with\n34|// the first diverged member named), integrity_failure on contradictory\n35|// cross-source immutable records, peer_not_allowlisted on explicit\n36|// authorization revocation, invalid_config on current configuration\n37|// failures, invalid_arguments on a malformed caller plan, and the read\n38|// or projection failure class when a required read or validation\n39|// fails.\n40|func (reader *Reader) Revalidate(plan SelectionPlan) error {\n41|\tif err := checkPlanShapes(plan); err != nil {\n42|\t\treturn err\n43|\t}\n44|\tif reader == nil || reader.Local == nil {\n45|\t\treturn fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n46|\t}\n47|\tconfig, err := reader.validatedConfiguration()\n48|\tif err != nil {\n49|\t\treturn err\n50|\t}\n51|\tpeerHost, isPeer := planSourceBinding(plan, config)\n52|\tif isPeer {\n53|\t\tif _, allowed := config.allowed[peerHost]; !allowed {\n54|\t\t\treturn fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, peerHost)\n55|\t\t}\n56|\t}\n57|\tif !bindingHolds(plan, config, reader) {\n58|\t\treturn fmt.Errorf(\"%w: source binding changed\", ErrPlanStale)\n59|\t}\n60|\tconfiguration, err := fingerprintConfiguration(reader, config)\n61|\tif err != nil {\n62|\t\treturn err\n63|\t}\n64|\tif configuration != plan.ConfigurationDigest {\n65|\t\treturn fmt.Errorf(\"%w: configuration changed\", ErrPlanStale)\n66|\t}\n67|\tvar repo = reader.Local\n68|\tsourcePeer := \"\"\n69|\tif isPeer {\n70|\t\trepo, sourcePeer, err = reader.peerRepo(peerHost)\n71|\t\tif err != nil {\n72|\t\t\treturn err\n73|\t\t}\n74|\t}\n75|\trows, err := reader.readSource(repo, sourcePeer)\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\tvar recordID string\n80|\tabsent := true\n81|\tfor _, row := range rows {\n82|\t\tif row.Projection.SessionID == plan.SessionID {\n83|\t\t\trecordID, absent = row.Projection.RecordID, false\n84|\t\t\tbreak\n85|\t\t}\n86|\t}\n87|\tif absent {\n88|\t\treturn fmt.Errorf(\"%w: selection absent from source index\", ErrPlanStale)\n89|\t}\n90|\tprojection, err := (&sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}).Project(plan.SessionID)\n91|\tif err != nil {\n92|\t\treturn err\n93|\t}\n94|\tif recordID != plan.SessionRecordID {\n95|\t\treturn fmt.Errorf(\"%w: session record changed\", ErrPlanStale)\n96|\t}\n97|\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\n98|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n99|\t}\n100|\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\n101|\tif err != nil {\n102|\t\treturn err\n103|\t}\n104|\tif leaseRecordID != plan.LeaseRecordID {\n105|\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n106|\t}\n107|\ttail, err := chainTail(repo, plan.SessionID)\n108|\tif err != nil {\n109|\t\tif sourcePeer == \"\" {\n110|\t\t\treturn err\n111|\t\t}\n112|\t\treturn peerReadFailed(sourcePeer, err)\n113|\t}\n114|\theads := []string{}\n115|\tif tail != \"\" {\n116|\t\theads = []string{tail}\n117|\t}\n118|\tif !equalStrings(heads, plan.AuthorityHeads) {\n119|\t\treturn fmt.Errorf(\"%w: authority heads changed\", ErrPlanStale)\n120|\t}\n121|\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n122|\tif err != nil {\n123|\t\treturn err\n124|\t}\n125|\tif index != plan.SourceIndexDigest {\n126|\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n127|\t}\n128|\treturn reader.validateAuthorityUnion(plan, config, sourcePeer)\n129|}\n130|\n131|// validateAuthorityUnion validates the complete current authority for\n132|// the pinned session UUID across every allowed source except the\n133|// already validated plan source. The session is located by UUID in\n134|// each source; names are never re-resolved and no selection is\n135|// substituted. A non-parked copy carrying a disagreeing immutable\n136|// record digest is inconsistent authority (integrity_failure, the same\n137|// class Resolve reports for disagreeing copies). Authoritative\n138|// tombstone evidence or a contradictory observed winning lease in\n139|// another source invalidates the live plan (selector_plan_stale). A\n140|// copy that observes no winning lease yet cannot contradict the bound\n141|// lease and is skipped for the lease check, while its record digest\n142|// still binds. Parked copies are failed observations, never evidence,\n143|// and absence in a source is not contradiction. A source that must be\n144|// read but cannot be read keeps its read-failure class: without the\n145|// complete union the plan cannot be shown current.\n146|func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n147|\tif sourcePeer != \"\" {\n148|\t\trows, err := reader.read(reader.Local)\n149|\t\tif err != nil {\n150|\t\t\treturn err\n151|\t\t}\n152|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n153|\t\t\treturn err\n154|\t\t}\n155|\t}\n156|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n157|\tsort.Strings(ids)\n158|\tfor index, id := range ids {\n159|\t\tif index > 0 && id == ids[index-1] {\n160|\t\t\tcontinue\n161|\t\t}\n162|\t\tif id == sourcePeer {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\t// An allowlisted peer with no advertised learned index\n166|\t\t// contributes no authority; a known handle that cannot be\n167|\t\t// read is a failed observation of a source that must be\n168|\t\t// read, never absence.\n169|\t\tif isAbsentPeerIndex(reader, id) {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\trepo, peerHost, err := reader.peerRepo(id)\n173|\t\tif err != nil {\n174|\t\t\treturn err\n175|\t\t}\n176|\t\trows, err := reader.readSource(repo, peerHost)\n177|\t\tif err != nil {\n178|\t\t\treturn err\n179|\t\t}\n180|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n181|\t\t\treturn err\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n188|// learned index handle at all: absence, never a failed read.\n189|func isAbsentPeerIndex(reader *Reader, host string) bool {\n190|\tfor _, peer := range reader.Peers {\n191|\t\tif peer.HostID == host {\n192|\t\t\treturn false\n193|\t\t}\n194|\t}\n195|\treturn true\n196|}\n197|\n198|// checkUnionCopy validates one non-plan source's rows for the pinned\n199|// session UUID as validateAuthorityUnion documents.\n200|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n201|\tfor _, row := range rows {\n202|\t\tif row.Projection.SessionID != plan.SessionID {\n203|\t\t\tcontinue\n204|\t\t}\n205|\t\tif row.Projection.Parked != nil {\n206|\t\t\tcontinue\n207|\t\t}\n208|\t\tif row.Projection.State == sessstate.StateTombstoned {\n209|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n210|\t\t}\n211|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n212|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n213|\t\t}\n214|\t\tif row.Projection.Winner.IsZero() {\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\tif row.Projection.Winner.Epoch != plan.LeaseEpoch || row.Projection.Winner.LeaseID != plan.LeaseID || row.Projection.OwnerHostID != plan.OwnerHostID {\n218|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n219|\t\t}\n220|\t\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, row.Projection.Winner.Epoch, row.Projection.Winner.LeaseID, row.Projection.OwnerHostID)\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\tif leaseRecordID != plan.LeaseRecordID {\n225|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n226|\t\t}\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// planSourceBinding resolves the plan's bound source: a local plan\n232|// carries a null alias with an empty or local host, while any other\n233|// binding selects a peer source by host. The second return reports\n234|// whether the plan selects a peer source.\n235|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n236|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n237|\t\treturn \"\", false\n238|\t}\n239|\treturn plan.SourceHostID, true\n240|}\n241|\n242|// bindingHolds reports whether the plan's bound (host, alias) source\n243|// still resolves to the same source in the current configuration. A\n244|// local plan holds while its host is empty or the current local host;\n245|// a peer plan holds while its host is still a known peer carrying the\n246|// exact bound alias.\n247|func bindingHolds(plan SelectionPlan, config validatedConfig, reader *Reader) bool {\n248|\tif plan.SourceAlias == nil {\n249|\t\tif plan.SourceHostID == \"\" {\n250|\t\t\treturn true\n251|\t\t}\n252|\t\tif config.localHost != \"\" && plan.SourceHostID == config.localHost {\n253|\t\t\treturn true\n254|\t\t}\n255|\t\tif knownPeer(reader, plan.SourceHostID) && config.aliasFor(plan.SourceHostID) == \"\" {\n256|\t\t\treturn true\n257|\t\t}\n258|\t\treturn false\n259|\t}\n260|\tif !knownPeer(reader, plan.SourceHostID) {\n261|\t\treturn false\n262|\t}\n263|\treturn config.aliasFor(plan.SourceHostID) == *plan.SourceAlias\n264|}\n265|\n266|// equalStrings compares sorted unique string slices element-wise.\n267|func equalStrings(first, second []string) bool {\n268|\tif len(first) != len(second) {\n269|\t\treturn false\n270|\t}\n271|\tfor index := range first {\n272|\t\tif first[index] != second[index] {\n273|\t\t\treturn false\n274|\t\t}\n275|\t}\n276|\treturn true\n277|}\n278|\n279|// checkPlanShapes validates the caller-supplied plan members without\n280|// consulting any authority: exact contract version, grammatical\n281|// selector, canonical UUIDs and digests, a bound source host, the\n282|// required lease attestation with its full positive triple, exact\n283|// alias bound, sorted unique authority heads, a known action tag, and\n284|// a null or UUIDv7 destination. Authority comes only from Revalidate.\n285|func checkPlanShapes(plan SelectionPlan) error {\n286|\tif plan.SelectorVersion != SelectorVersion {\n287|\t\treturn fmt.Errorf(\"%w: unknown selector version %q\", ErrInvalidArgument, plan.SelectorVersion)\n288|\t}\n289|\tif _, err := ParseSelector(plan.Selector); err != nil {\n290|\t\treturn fmt.Errorf(\"%w: malformed plan selector: %v\", ErrInvalidArgument, err)\n291|\t}\n292|\tif _, err := scalar.ParseUUIDv7(plan.SessionID); err != nil {\n293|\t\treturn fmt.Errorf(\"%w: malformed plan session ID: %v\", ErrInvalidArgument, err)\n294|\t}\n295|\tif _, err := scalar.ParseDigest(plan.SessionRecordID); err != nil {\n296|\t\treturn fmt.Errorf(\"%w: malformed plan session record digest: %v\", ErrInvalidArgument, err)\n297|\t}\n298|\t// The source host is always bound: no plan observes a source it\n299|\t// cannot name, and empty never substitutes for unknown.\n300|\tif _, err := scalar.ParseUUIDv7(plan.SourceHostID); err != nil {\n301|\t\treturn fmt.Errorf(\"%w: malformed plan source host ID: %v\", ErrInvalidArgument, err)\n302|\t}\n303|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n304|\t\treturn fmt.Errorf(\"%w: malformed plan lease record digest: %v\", ErrInvalidArgument, err)\n305|\t}\n306|\tif plan.SourceAlias != nil {\n307|\t\tif err := checkAlias(*plan.SourceAlias); err != nil {\n308|\t\t\t// An alias-less peer binds empty, which never passes the\n309|\t\t\t// configured 1-64 bound: admit exactly that encoding here.\n310|\t\t\tif *plan.SourceAlias != \"\" {\n311|\t\t\t\treturn fmt.Errorf(\"%w: malformed plan source alias: %v\", ErrInvalidArgument, err)\n312|\t\t\t}\n313|\t\t}\n314|\t}\n315|\tfor _, member := range []struct {\n316|\t\tname   string\n317|\t\tdigest string\n318|\t}{\n319|\t\t{\"source index\", plan.SourceIndexDigest},\n320|\t\t{\"configuration\", plan.ConfigurationDigest},\n321|\t\t{\"expectation\", plan.ExpectationDigest},\n322|\t} {\n323|\t\tif _, err := scalar.ParseDigest(member.digest); err != nil {\n324|\t\t\treturn fmt.Errorf(\"%w: malformed plan %s digest: %v\", ErrInvalidArgument, member.name, err)\n325|\t\t}\n326|\t}\n327|\t// The lease triple is always fully bound from the same winning\n328|\t// observation as the lease attestation: a positive uint53 epoch\n329|\t// with a UUIDv4 lease and a UUIDv7 owner. Empty and partial\n330|\t// triples, out-of-range epochs, and placeholders are refused; a\n331|\t// session with no observed winning lease builds no plan.\n332|\tif plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling {\n333|\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n334|\t}\n335|\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n336|\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n337|\t}\n338|\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n339|\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n340|\t}\n341|\tfor index, head := range plan.AuthorityHeads {\n342|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n343|\t\t\treturn fmt.Errorf(\"%w: malformed plan authority head: %v\", ErrInvalidArgument, err)\n344|\t\t}\n345|\t\tif index > 0 && plan.AuthorityHeads[index-1] >= head {\n346|\t\t\treturn fmt.Errorf(\"%w: plan authority heads are not sorted unique\", ErrInvalidArgument)\n347|\t\t}\n348|\t}\n349|\tif _, ok := BoundariesFor(plan.Action); !ok {\n350|\t\treturn fmt.Errorf(\"%w: unknown plan action %q\", ErrInvalidArgument, plan.Action)\n351|\t}\n352|\tif plan.DestinationHostID != nil {\n353|\t\tif _, err := scalar.ParseUUIDv7(*plan.DestinationHostID); err != nil {\n354|\t\t\treturn fmt.Errorf(\"%w: malformed plan destination host ID: %v\", ErrInvalidArgument, err)\n355|\t\t}\n356|\t}\n357|\treturn nil\n358|}\n359|\n360|// planWire is the tamper-evident persistence encoding: every bound\n361|// member plus the locally verified canonical digest over all of them.\n362|type planWire struct {\n363|\tSelectorVersion     string   `json:\"selector_version\"`\n364|\tSelector            string   `json:\"selector\"`\n365|\tSessionID           string   `json:\"session_id\"`\n366|\tSessionRecordID     string   `json:\"session_record_id\"`\n367|\tSourceHostID        string   `json:\"source_host_id\"`\n368|\tSourceAlias         *string  `json:\"source_alias\"`\n369|\tSourceIndexDigest   string   `json:\"source_index_digest\"`\n370|\tConfigurationDigest string   `json:\"configuration_digest\"`\n371|\tLeaseRecordID       string   `json:\"lease_record_id\"`\n372|\tLeaseEpoch          uint64   `json:\"lease_epoch\"`\n373|\tLeaseID             string   `json:\"lease_id\"`\n374|\tOwnerHostID         string   `json:\"owner_host_id\"`\n375|\tAuthorityHeads      []string `json:\"authority_heads\"`\n376|\tAction              string   `json:\"action\"`\n377|\tDestinationHostID   *string  `json:\"destination_host_id\"`\n378|\tExpectationDigest   string   `json:\"expectation_digest\"`\n379|\tPlanDigest          string   `json:\"plan_digest\"`\n380|}\n381|\n382|// Digest returns the locally verified canonical digest over all bound\n383|// plan members. It is recomputed on every call and never trusted from\n384|// caller bytes.\n385|func (plan SelectionPlan) Digest() (string, error) {\n386|\theads := append([]string(nil), plan.AuthorityHeads...)\n387|\tif heads == nil {\n388|\t\theads = []string{}\n389|\t}\n390|\treturn fingerprint(map[string]any{\n391|\t\t\"action\":               plan.Action,\n392|\t\t\"authority_heads\":      heads,\n393|\t\t\"configuration_digest\": plan.ConfigurationDigest,\n394|\t\t\"destination_host_id\":  plan.DestinationHostID,\n395|\t\t\"expectation_digest\":   plan.ExpectationDigest,\n396|\t\t\"lease_epoch\":          plan.LeaseEpoch,\n397|\t\t\"lease_id\":             plan.LeaseID,\n398|\t\t\"lease_record_id\":      plan.LeaseRecordID,\n399|\t\t\"owner_host_id\":        plan.OwnerHostID,\n400|\t\t\"selector\":             plan.Selector,\n401|\t\t\"selector_version\":     plan.SelectorVersion,\n402|\t\t\"session_id\":           plan.SessionID,\n403|\t\t\"session_record_id\":    plan.SessionRecordID,\n404|\t\t\"source_alias\":         plan.SourceAlias,\n405|\t\t\"source_host_id\":       plan.SourceHostID,\n406|\t\t\"source_index_digest\":  plan.SourceIndexDigest,\n407|\t})\n408|}\n409|\n410|// Marshal encodes the plan with its locally verified digest. The\n411|// encoding keeps null alias and destination distinct from empty.\n412|func (plan SelectionPlan) Marshal() ([]byte, error) {\n413|\tdigest, err := plan.Digest()\n414|\tif err != nil {\n415|\t\treturn nil, err\n416|\t}\n417|\theads := append([]string(nil), plan.AuthorityHeads...)\n418|\tif heads == nil {\n419|\t\theads = []string{}\n420|\t}\n421|\treturn json.Marshal(planWire{\n422|\t\tSelectorVersion:     plan.SelectorVersion,\n423|\t\tSelector:            plan.Selector,\n424|\t\tSessionID:           plan.SessionID,\n425|\t\tSessionRecordID:     plan.SessionRecordID,\n426|\t\tSourceHostID:        plan.SourceHostID,\n427|\t\tSourceAlias:         plan.SourceAlias,\n428|\t\tSourceIndexDigest:   plan.SourceIndexDigest,\n429|\t\tConfigurationDigest: plan.ConfigurationDigest,\n430|\t\tLeaseRecordID:       plan.LeaseRecordID,\n431|\t\tLeaseEpoch:          plan.LeaseEpoch,\n432|\t\tLeaseID:             plan.LeaseID,\n433|\t\tOwnerHostID:         plan.OwnerHostID,\n434|\t\tAuthorityHeads:      heads,\n435|\t\tAction:              plan.Action,\n436|\t\tDestinationHostID:   plan.DestinationHostID,\n437|\t\tExpectationDigest:   plan.ExpectationDigest,\n438|\t\tPlanDigest:          digest,\n439|\t})\n440|}\n441|\n442|// ParsePlan decodes a persisted plan, validates every member shape,\n443|// and verifies the tamper-evident digest. A verified encoding is still\n444|// not authority: only Revalidate against current facts decides\n445|// currency, and digest equality alone never substitutes for it.\n446|func ParsePlan(raw []byte) (SelectionPlan, error) {\n447|\tvar wire planWire\n448|\tif err := json.Unmarshal(raw, &wire); err != nil {\n449|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: malformed plan encoding: %v\", ErrInvalidArgument, err)\n450|\t}\n451|\tplan := SelectionPlan{\n452|\t\tSelectorVersion:     wire.SelectorVersion,\n453|\t\tSelector:            wire.Selector,\n454|\t\tSessionID:           wire.SessionID,\n455|\t\tSessionRecordID:     wire.SessionRecordID,\n456|\t\tSourceHostID:        wire.SourceHostID,\n457|\t\tSourceAlias:         wire.SourceAlias,\n458|\t\tSourceIndexDigest:   wire.SourceIndexDigest,\n459|\t\tConfigurationDigest: wire.ConfigurationDigest,\n460|\t\tLeaseRecordID:       wire.LeaseRecordID,\n461|\t\tLeaseEpoch:          wire.LeaseEpoch,\n462|\t\tLeaseID:             wire.LeaseID,\n463|\t\tOwnerHostID:         wire.OwnerHostID,\n464|\t\tAuthorityHeads:      wire.AuthorityHeads,\n465|\t\tAction:              wire.Action,\n466|\t\tDestinationHostID:   wire.DestinationHostID,\n467|\t\tExpectationDigest:   wire.ExpectationDigest,\n468|\t}\n469|\tif plan.AuthorityHeads == nil {\n470|\t\tplan.AuthorityHeads = []string{}\n471|\t}\n472|\tif err := checkPlanShapes(plan); err != nil {\n473|\t\treturn SelectionPlan{}, err\n474|\t}\n475|\tdigest, err := plan.Digest()\n476|\tif err != nil {\n477|\t\treturn SelectionPlan{}, err\n478|\t}\n479|\tif digest != wire.PlanDigest {\n480|\t\treturn SelectionPlan{}, fmt.Errorf(\"%w: plan digest mismatch\", ErrInvalidArgument)\n481|\t}\n482|\treturn plan, nil\n483|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ff","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":346,"recorded_at":1780531400000687,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886b-81ae-7542-9e18-ba93b99b6e4e"},"task_id":"01a0886b-81ae-7542-9e18-ba93b99b6e4e","event":{"kind":"completed","task_id":"01a0886b-81ae-7542-9e18-ba93b99b6e4e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c601","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":347,"recorded_at":1780531400000689,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886b-81cb-7780-a309-a7e139d770a4"},"task_id":"01a0886b-81cb-7780-a309-a7e139d770a4","event":{"kind":"output","task_id":"01a0886b-81cb-7780-a309-a7e139d770a4","chunk":"Read text file `internal/sessquery/digest.go`.\n1|// Local attestation digests for selector plans: canonical fingerprints\n2|// over validated reads, never over caller claims.\n3|//\n4|// fingerprint canonicalizes its input through the canonical-JSON owner\n5|// and digests the canonical bytes, so equal facts always produce equal\n6|// digests and any fact change invalidates the plans bound to them. The\n7|// resulting \"sha256:\" digests are self-checked through the scalar\n8|// digest grammar before use.\n9|package sessquery\n10|\n11|import (\n12|\t\"crypto/sha256\"\n13|\t\"encoding/hex\"\n14|\t\"encoding/json\"\n15|\t\"fmt\"\n16|\t\"sort\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n21|)\n22|\n23|// transportLabel names the index-read mechanism this stack uses: direct\n24|// local repository reads with no mesh transport. Binding the label into\n25|// the configuration digest invalidates every plan if a transport is\n26|// ever introduced, instead of silently reusing facts read another way.\n27|const transportLabel = \"local-direct\"\n28|\n29|// fingerprint canonicalizes value and returns the \"sha256:\" digest of\n30|// the canonical bytes.\n31|func fingerprint(value any) (string, error) {\n32|\traw, err := json.Marshal(value)\n33|\tif err != nil {\n34|\t\treturn \"\", err\n35|\t}\n36|\tcanonical, err := canonicaljson.Canonicalize(raw)\n37|\tif err != nil {\n38|\t\treturn \"\", err\n39|\t}\n40|\tsum := sha256.Sum256(canonical)\n41|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n42|\tif _, err := scalar.ParseDigest(digest); err != nil {\n43|\t\treturn \"\", err\n44|\t}\n45|\treturn digest, nil\n46|}\n47|\n48|// peerFingerprint is one configured peer mapping in the configuration\n49|// digest: exact alias with its host, in bytewise host order.\n50|type peerFingerprint struct {\n51|\tAlias  string `json:\"alias\"`\n52|\tHostID string `json:\"host_id\"`\n53|}\n54|\n55|// fingerprintConfiguration digests the effective validated\n56|// configuration: the local host, the peer mapping, the allowlist, and\n57|// the transport label. Handles are not configuration and stay out:\n58|// swapping a learned index without changing the mapping still changes\n59|// the index digest at read time.\n60|func fingerprintConfiguration(reader *Reader, config validatedConfig) (string, error) {\n61|\tpeers := make([]peerFingerprint, 0, len(reader.Peers))\n62|\tfor _, host := range config.sortedPeerHosts(reader) {\n63|\t\tpeers = append(peers, peerFingerprint{Alias: config.aliasFor(host), HostID: host})\n64|\t}\n65|\tallowlist := make([]string, 0, len(config.allowed))\n66|\tfor id := range config.allowed {\n67|\t\tallowlist = append(allowlist, id)\n68|\t}\n69|\tsort.Strings(allowlist)\n70|\treturn fingerprint(map[string]any{\n71|\t\t\"allowlist\":     allowlist,\n72|\t\t\"local_host_id\": config.localHost,\n73|\t\t\"peers\":         peers,\n74|\t\t\"transport\":     transportLabel,\n75|\t})\n76|}\n77|\n78|// indexRowFingerprint is one validated index row in the source index\n79|// digest: identity, liveness, lifecycle, tail, and winning lease facts\n80|// for every session the complete read returned, in bytewise session\n81|// order. Any index change — a new, removed, parked, tombstoned, or\n82|// advanced session — changes this digest.\n83|type indexRowFingerprint struct {\n84|\tSessionID     string `json:\"session_id\"`\n85|\tRecordID      string `json:\"record_id\"`\n86|\tName          string `json:\"name\"`\n87|\tParked        bool   `json:\"parked\"`\n88|\tState         string `json:\"state\"`\n89|\tTailEvent     string `json:\"tail_event\"`\n90|\tWinnerEpoch   uint64 `json:\"winner_epoch\"`\n91|\tWinnerLeaseID string `json:\"winner_lease_id\"`\n92|\tOwnerHostID   string `json:\"owner_host_id\"`\n93|}\n94|\n95|// fingerprintIndex digests the complete validated index read used for\n96|// selection: every row the listing returned with its validated tail.\n97|// A tail read failure keeps its read-failure class: local errors stay\n98|// repository errors, peer errors carry the read-failure class.\n99|func fingerprintIndex(reader *Reader, repo *sessrepo.Repository, rows []Summary, peerHost string) (string, error) {\n100|\tfinger := make([]indexRowFingerprint, 0, len(rows))\n101|\tfor _, row := range rows {\n102|\t\tentry := indexRowFingerprint{\n103|\t\t\tSessionID:     row.Projection.SessionID,\n104|\t\t\tRecordID:      row.Projection.RecordID,\n105|\t\t\tName:          row.Projection.Name,\n106|\t\t\tState:         string(row.Projection.State),\n107|\t\t\tWinnerEpoch:   row.Projection.Winner.Epoch,\n108|\t\t\tWinnerLeaseID: row.Projection.Winner.LeaseID,\n109|\t\t\tOwnerHostID:   row.Projection.OwnerHostID,\n110|\t\t}\n111|\t\tif row.Projection.Parked != nil {\n112|\t\t\tentry.Parked = true\n113|\t\t} else {\n114|\t\t\ttail, err := chainTail(repo, row.Projection.SessionID)\n115|\t\t\tif err != nil {\n116|\t\t\t\tif peerHost == \"\" {\n117|\t\t\t\t\treturn \"\", err\n118|\t\t\t\t}\n119|\t\t\t\treturn \"\", peerReadFailed(peerHost, err)\n120|\t\t\t}\n121|\t\t\tentry.TailEvent = tail\n122|\t\t}\n123|\t\tfinger = append(finger, entry)\n124|\t}\n125|\treturn fingerprint(finger)\n126|}\n127|\n128|// fingerprintWinningLease attests the validated winning-lease\n129|// observation: the session, the positive envelope epoch, the fencing\n130|// lease ID, and the owner host. This stack persists no standalone\n131|// Lease Record objects, so the observation is the envelope triple on\n132|// the authoritative event chain as derived by the accepted projector;\n133|// the digest is recomputed from those validated facts on every build\n134|// and revalidation. Callers must refuse a missing winning lease\n135|// before calling: a zero observation has no attestation.\n136|func fingerprintWinningLease(sessionID string, epoch uint64, leaseID, ownerHostID string) (string, error) {\n137|\treturn fingerprint(map[string]any{\n138|\t\t\"lease_epoch\":   epoch,\n139|\t\t\"lease_id\":      leaseID,\n140|\t\t\"owner_host_id\": ownerHostID,\n141|\t\t\"session_id\":    sessionID,\n142|\t})\n143|}\n144|\n145|// fingerprintExpectations binds caller-declared action expectations for\n146|// change detection only. Expectations must be one canonically encoded\n147|// JSON object; the digest never replaces the checkpoint, workspace,\n148|// cohort, provider, terminal, or confirmation contracts, which have no\n149|// owners in this leaf. Empty expectations bind the empty-object digest.\n150|func fingerprintExpectations(expectations []byte) (string, error) {\n151|\tif len(expectations) == 0 {\n152|\t\treturn fingerprint(map[string]any{})\n153|\t}\n154|\tcanonical, err := canonicaljson.Canonicalize(expectations)\n155|\tif err != nil {\n156|\t\treturn \"\", fmt.Errorf(\"%w: malformed plan expectations: %v\", ErrInvalidArgument, err)\n157|\t}\n158|\tif len(canonical) == 0 || canonical[0] != '{' {\n159|\t\treturn \"\", fmt.Errorf(\"%w: plan expectations must be a JSON object\", ErrInvalidArgument)\n160|\t}\n161|\tsum := sha256.Sum256(canonical)\n162|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n163|\tif _, err := scalar.ParseDigest(digest); err != nil {\n164|\t\treturn \"\", err\n165|\t}\n166|\treturn digest, nil\n167|}","final_result":true}}}
