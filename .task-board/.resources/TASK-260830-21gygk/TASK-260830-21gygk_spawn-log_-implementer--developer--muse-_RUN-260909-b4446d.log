lan.SessionRecordID != ref.RecordID {\n192|\t\tt.Fatalf(\"identity: %+v\", plan)\n193|\t}\n194|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n195|\t\tt.Fatalf(\"lease: %+v\", plan)\n196|\t}\n197|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n198|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n199|\t}\n200|\tif plan.DestinationHostID == nil || *plan.DestinationHostID != hostB {\n201|\t\tt.Fatalf(\"destination: %+v\", plan)\n202|\t}\n203|\tif err := reader.Revalidate(plan); err != nil {\n204|\t\tt.Fatalf(\"fresh peer plan is not current: %v\", err)\n205|\t}\n206|}\n207|\n208|func TestBuildPlanRecordOnlySessionRefusesBootstrap(t *testing.T) {\n209|\tlocal, _ := repository(t)\n210|\tcreate(t, local, idA, \"alpha\")\n211|\treader := &Reader{Local: local, LocalHostID: hostA}\n212|\t// A complete read proving a record without any valid lease is an\n213|\t// interrupted persistence prefix for the bootstrap-recovery leaf:\n214|\t// no plan binds an empty lease triple or placeholder, and there is\n215|\t// nothing current to revalidate.\n216|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n217|\t\tt.Fatalf(\"record-only build = %v, want selector_bootstrap_incomplete\", err)\n218|\t}\n219|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"id:\" + idA, Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n220|\t\tt.Fatalf(\"record-only id build = %v, want selector_bootstrap_incomplete\", err)\n221|\t}\n222|}\n223|\n224|func TestBuildPlanLocalSourceRequiresKnownHost(t *testing.T) {\n225|\treader, _, _, _ := plannedSession(t)\n226|\treader.LocalHostID = \"\"\n227|\t// The local source cannot be named without the local host\n228|\t// identity: the plan binds a UUIDv7 source host or refuses.\n229|\t// Peer selections still bind their own known host.\n230|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrInvalidConfig) {\n231|\t\tt.Fatalf(\"unknown-host local build = %v, want invalid_config\", err)\n232|\t}\n233|\tpeer, _ := repository(t)\n234|\tref := create(t, peer, idB, \"beta\")\n235|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n236|\treader.AllowlistedPeerIDs = []string{hostA}\n237|\treader.Peers = []PeerIndex{{hostA, peer}}\n238|\treader.Aliases = map[string]string{hostA: \"workstation\"}\n239|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus})\n240|\tif plan.SourceHostID != hostA {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
