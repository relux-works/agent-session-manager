{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb17","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":998,"recorded_at":1780531400001991,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886e05287690a00815af2e2a5aba","text":"Read text file `internal/sessquery/query_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"reflect\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n12|)\n13|\n14|func TestResolvePinnedPrecedence(t *testing.T) {\n15|\tlocal, _ := repository(t)\n16|\tpeer, _ := repository(t)\n17|\t// Both sessions carry their authoritative initial lease so the\n18|\t// status half of each precedence row stays representable.\n19|\tlocalRef := create(t, local, idA, \"Local\")\n20|\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n21|\tpeerRef := create(t, peer, idB, idA)\n22|\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n23|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n24|\tfor _, row := range []struct{ selector, id, peer string }{\n25|\t\t{\"Local\", idA, \"\"}, {idA, idB, hostA}, {idB, idB, hostA},\n26|\t} {\n27|\t\tgot, err := reader.Resolve(row.selector)\n28|\t\tif err != nil || got.SessionID != row.id || got.PeerHostID != row.peer {\n29|\t\t\tt.Fatalf(\"Resolve(%q) = %+v, %v\", row.selector, got, err)\n30|\t\t}\n31|\t\tstatus, err := reader.Status(row.selector)\n32|\t\tif err != nil || status.Projection.SessionID != row.id {\n33|\t\t\tt.Fatalf(\"Status(%q) = %+v, %v\", row.selector, status, err)\n34|\t\t}\n35|\t}\n36|\t// Local exact name wins even if a peer learned the same name for another ID.\n37|\tother, _ := repository(t)\n38|\tcreate(t, other, idB, \"Local\")\n39|\treader.Peers = []PeerIndex{{hostA, other}}\n40|\tgot, err := reader.Resolve(\"Local\")\n41|\tif err != nil || got.SessionID != idA || got.PeerHostID != \"\" {\n42|\t\tt.Fatalf(\"local priority: %+v %v\", got, err)\n43|\t}\n44|\t// A local UUID-shaped name also wins over the UUID identity.\n45|\tlocal2, _ := repository(t)\n46|\tcreate(t, local2, idA, \"Original\")\n47|\tcreate(t, local2, idB, idA)\n48|\tgot, err = (&Reader{Local: local2}).Resolve(idA)\n49|\tif err != nil || got.SessionID != idB {\n50|\t\tt.Fatalf(\"local name before UUID: %+v %v\", got, err)\n51|\t}\n52|}\n53|\n54|func TestResolveExactNamesAndASCIICollisions(t *testing.T) {\n55|\tfor _, peers := range []bool{false, true} {\n56|\t\tt.Run(map[bool]string{false: \"local\", true: \"peers\"}[peers], func(t *testing.T) {\n57|\t\t\tlocal, _ := repository(t)\n58|\t\t\tsource := local\n59|\t\t\tr := &Reader{Local: local}\n60|\t\t\tif peers {\n61|\t\t\t\tsource, _ = repository(t)\n62|\t\t\t\tr.AllowlistedPeerIDs = []string{hostA}\n63|\t\t\t\tr.Peers = []PeerIndex{{hostA, source}}\n64|\t\t\t}\n65|\t\t\tcreate(t, source, idA, \"Az-09._\")\n66|\t\t\tfor _, query := range []string{\"az-09._\", \"AZ-09._\", \"Ａz-09._\", \"no-such-session\", \"host/Name\"} {\n67|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrNotFound) {\n68|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n69|\t\t\t\t}\n70|\t\t\t}\n71|\t\t\t// v0.6.0 Section 14.7.1 decides the qualified-selector\n72|\t\t\t// grammar the partial leaf left open: \"Name@host\" is a\n73|\t\t\t// qualified selector with an unknown source, and the empty\n74|\t\t\t// argument carries no key, so both are invalid arguments,\n75|\t\t\t// never silent names. \"host/Name\" carries no \"@\" and stays\n76|\t\t\t// not found.\n77|\t\t\tfor _, query := range []string{\"Name@host\", \"\", \"Az-09._@unknown\", \"Az-09._@\", \"@local\"} {\n78|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrInvalidArgument) {\n79|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n80|\t\t\t\t}\n81|\t\t\t}\n82|\t\t\tif _, err := r.Resolve(\"Az-09._\"); err != nil {\n83|\t\t\t\tt.Fatal(err)\n84|\t\t\t}\n85|\t\t\tcreate(t, source, idB, \"aZ-09._\")\n86|\t\t\tfor _, query := range []string{\"Az-09._\", \"aZ-09._\", \"AZ-09._\"} {\n87|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrAmbiguous) {\n88|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n89|\t\t\t\t}\n90|\t\t\t\tif _, err := r.Status(query); !errors.Is(err, ErrAmbiguous) {\n91|\t\t\t\t\tt.Fatalf(\"status %q: %v\", query, err)\n92|\t\t\t\t}\n93|\t\t\t}\n94|\t\t})\n95|\t}\n96|}\n97|\n98|func TestResolveAllowlistAndReadFailures(t *testing.T) {\n99|\tlocal, root := repository(t)\n100|\tpeer, peerRoot := repository(t)\n101|\tcreate(t, local, idA, \"Local\")\n102|\tcreate(t, peer, idB, idA)\n103|\tr := &Reader{Local: local, Peers: []PeerIndex{{hostA, peer}}}\n104|\tgot, err := r.Resolve(idA)\n105|\tif err != nil || got.SessionID != idA {\n106|\t\tt.Fatalf(\"unallowlisted peer affected UUID: %+v %v\", got, err)\n107|\t}\n108|\t// No learned index is absence; a known index whose read fails is not.\n109|\tr.AllowlistedPeerIDs = []string{hostB}\n110|\tgot, err = r.Resolve(idA)\n111|\tif err != nil || got.SessionID != idA {\n112|\t\tt.Fatalf(\"absent learned index: %+v %v\", got, err)\n113|\t}\n114|\tr.AllowlistedPeerIDs = []string{hostA}\n115|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n116|\t\tt.Fatal(err)\n117|\t}\n118|\tif _, err := r.Resolve(idA); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n119|\t\tt.Fatalf(\"failed peer read fell through: %v\", err)\n120|\t}\n121|\t// Local exact name does not depend on lower-tier reads.\n122|\tif _, err := r.Resolve(\"Local\"); err != nil {\n123|\t\tt.Fatal(err)\n124|\t}\n125|\tif err := os.WriteFile(filepath.Join(peerRoot, \"sessions\"), []byte(\"not a directory\"), 0600); err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\tif _, err := r.Status(idA); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n129|\t\tt.Fatalf(\"non-directory read: %v\", err)\n130|\t}\n131|\tr.Peers = []PeerIndex{{hostA, nil}}\n132|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrUnavailable) {\n133|\t\tt.Fatalf(\"nil learned index: %v\", err)\n134|\t}\n135|\tr.Peers = []PeerIndex{{hostA, nil}, {hostA, peer}}\n136|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrUnavailable) {\n137|\t\tt.Fatalf(\"duplicate learned index: %v\", err)\n138|\t}\n139|\tif err := os.RemoveAll(filepath.Join(root, \"sessions\")); err != nil {\n140|\t\tt.Fatal(err)\n141|\t}\n142|\tif _, err := r.List(); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n143|\t\tt.Fatalf(\"missing local root: %v\", err)\n144|\t}\n145|\tif _, err := r.Resolve(\"Local\"); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n146|\t\tt.Fatalf(\"missing root became not found: %v\", err)\n147|\t}\n148|}\n149|\n150|func TestResolvePeerOrderAndReplicatedIdentity(t *testing.T) {\n151|\tlocal, _ := repository(t)\n152|\ta, _ := repository(t)\n153|\tb, _ := repository(t)\n154|\tcreate(t, a, idA, \"Shared\")\n155|\tcreate(t, b, idA, \"Shared\")\n156|\tr := &Reader{Local: local, AllowlistedPeerIDs: []string{hostB, hostA, hostB}, Peers: []PeerIndex{{hostB, b}, {hostA, a}}}\n157|\tfirst, err := r.Resolve(\"Shared\")\n158|\tif err != nil || first.PeerHostID != hostA {\n159|\t\tt.Fatalf(\"replicated identity: %+v %v\", first, err)\n160|\t}\n161|\tr.Peers[0], r.Peers[1] = r.Peers[1], r.Peers[0]\n162|\tsecond, err := r.Resolve(\"Shared\")\n163|\tif err != nil || !reflect.DeepEqual(first, second) {\n164|\t\tt.Fatalf(\"permutation changed selection: %+v %v\", second, err)\n165|\t}\n166|\tcreate(t, b, idB, \"sHARED\")\n167|\tif _, err := r.Resolve(\"Shared\"); !errors.Is(err, ErrAmbiguous) {\n168|\t\tt.Fatalf(\"cross-peer collision: %v\", err)\n169|\t}\n170|}\n171|\n172|func TestListStatusDerivedFactsAndStableOrder(t *testing.T) {\n173|\trepo, _ := repository(t)\n174|\t// Both listed sessions carry their authoritative initial lease:\n175|\t// a record without any valid lease is an interrupted prefix the\n176|\t// list refuses (see the bootstrap refusal tests), never a row\n177|\t// with invented owner facts.\n178|\tzed := create(t, repo, idB, \"Zed\")\n179|\tappendEvent(t, repo, idB, zed.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": zed.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n180|\tref := create(t, repo, idA, \"Alpha\")\n181|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n182|\tr := &Reader{Local: repo, LocalHostID: hostA}\n183|\tlist, err := r.List()\n184|\tif err != nil || len(list) != 2 {\n185|\t\tt.Fatalf(\"List: %+v %v\", list, err)\n186|\t}\n187|\tif list[0].Projection.SessionID != idA || list[1].Projection.SessionID != idB {\n188|\t\tt.Fatalf(\"order: %+v\", list)\n189|\t}\n190|\tp := list[0].Projection\n191|\tif p.Name != \"Alpha\" || p.Kind != \"direct\" || p.Provider.ID != \"codex\" || p.State != sessstate.StateCreating || p.OwnerHostID != hostA || p.LocalRole != \"owner\" || p.Winner.LeaseID != lease || p.Winner.Epoch != 1 {\n192|\t\tt.Fatalf(\"derived summary: %+v\", p)\n193|\t}\n194|\tsecond := list[1].Projection\n195|\tif second.Name != \"Zed\" || second.OwnerHostID != hostA || second.Winner.LeaseID != lease || second.Winner.Epoch != 1 {\n196|\t\tt.Fatalf(\"second summary: %+v\", second)\n197|\t}\n198|\tfor _, selector := range []string{\"Alpha\", idA} {\n199|\t\tstatus, err := r.Status(selector)\n200|\t\tif err != nil || !reflect.DeepEqual(status, list[0]) {\n201|\t\t\tt.Fatalf(\"status disagrees: %+v %v\", status, err)\n202|\t\t}\n203|\t}\n204|\tagain, err := r.List()\n205|\tif err != nil || !reflect.DeepEqual(list, again) {\n206|\t\tt.Fatalf(\"read is not idempotent: %+v %v\", again, err)\n207|\t}\n208|\tr.LocalHostID = hostB\n209|\tstatus, err := r.Status(idA)\n210|\tif err != nil || status.Projection.LocalRole != \"replica\" {\n211|\t\tt.Fatalf(\"replica: %+v %v\", status, err)\n212|\t}\n213|}\n214|\n215|func TestParkedReadRecoveryAndMissingVsMalformed(t *testing.T) {\n216|\trepo, root := repository(t)\n217|\traw := record(t, idA, \"Parked\")\n218|\trepo.AfterCreateStep = func(step sessrepo.CreateStep) error {\n219|\t\tif step == sessrepo.CreateStepRecord {\n220|\t\t\treturn errors.New(\"crash\")\n221|\t\t}\n222|\t\treturn nil\n223|\t}\n224|\tif _, err := repo.CreateSession(raw); err == nil {\n225|\t\tt.Fatal(\"fault did not fire\")\n226|\t}\n227|\tcreateHealthy := func() {\n228|\t\trepo.AfterCreateStep = nil\n229|\t\thealthy := create(t, repo, idB, \"Healthy\")\n230|\t\tappendEvent(t, repo, idB, healthy.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": healthy.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n231|\t}\n232|\tcreateHealthy()\n233|\tr := &Reader{Local: repo}\n234|\tlist, err := r.List()\n235|\tif err != nil || len(list) != 2 || list[0].Projection.Parked == nil {\n236|\t\tt.Fatalf(\"parked omitted: %+v %v\", list, err)\n237|\t}\n238|\t// A parked row carries no invented owner: the read failed, so no\n239|\t// winning lease was observed and none is claimed.\n240|\tif parked := list[0].Projection; parked.OwnerHostID != \"\" || parked.LocalRole != \"\" || !parked.Winner.IsZero() {\n241|\t\tt.Fatalf(\"invented parked owner: %+v\", parked)\n242|\t}\n243|\tif _, err := r.Resolve(\"Parked\"); !errors.Is(err, ErrNotFound) {\n244|\t\tt.Fatalf(\"parked routed: %v\", err)\n245|\t}\n246|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrNotFound) {\n247|\t\tt.Fatalf(\"parked UUID routed: %v\", err)\n248|\t}\n249|\tif _, err := r.Resolve(\"Healthy\"); err != nil {\n250|\t\tt.Fatal(err)\n251|\t}\n252|\tparked, err := r.InspectLocal(idA)\n253|\tif err != nil || parked.Projection.Parked == nil || parked.Projection.Parked.RetryHint == \"\" {\n254|\t\tt.Fatalf(\"parked status: %+v %v\", parked, err)\n255|\t}\n256|\tif _, err := repo.CreateSession(raw); err != nil {\n257|\t\tt.Fatal(err)\n258|\t}\n259|\t// The healed record alone is still an interrupted prefix: only\n260|\t// its authoritative initial lease makes it a status again. The\n261|\t// retried record is byte-identical, so the parked row's digest\n262|\t// still names it.\n263|\tif _, err := r.Status(\"Parked\"); !errors.Is(err, ErrBootstrapIncomplete) {\n264|\t\tt.Fatalf(\"healed record-only status: %v\", err)\n265|\t}\n266|\trecordID := list[0].Projection.RecordID\n267|\tappendEvent(t, repo, idA, recordID, \"session.created\", 1, map[string]any{\"session_record_id\": recordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n268|\tif _, err := r.Status(\"Parked\"); err != nil {\n269|\t\tt.Fatal(err)\n270|\t}\n271|\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), []byte(\"malformed\"), 0600); err != nil {\n272|\t\tt.Fatal(err)\n273|\t}\n274|\tdamaged, err := r.InspectLocal(idA)\n275|\tif err != nil || damaged.Projection.State != sessstate.StateParked || damaged.Projection.Parked.BlockingReason == \"\" {\n276|\t\tt.Fatalf(\"malformed treated as absent: %+v %v\", damaged, err)\n277|\t}\n278|\tif _, err := r.InspectLocal(hostA); !errors.Is(err, sessstate.ErrUnknownSession) {\n279|\t\tt.Fatalf(\"missing: %v\", err)\n280|\t}\n281|}\n282|\n283|func TestReaderAbsentAndNil(t *testing.T) {\n284|\tfor _, r := range []*Reader{nil, {}} {\n285|\t\tif _, err := r.List(); !errors.Is(err, ErrUnavailable) {\n286|\t\t\tt.Fatal(err)\n287|\t\t}\n288|\t\tif _, err := r.InspectLocal(idA); !errors.Is(err, ErrUnavailable) {\n289|\t\t\tt.Fatal(err)\n290|\t\t}\n291|\t\tif _, err := r.Status(idA); !errors.Is(err, ErrUnavailable) {\n292|\t\t\tt.Fatal(err)\n293|\t\t}\n294|\t}\n295|\trepo, _ := repository(t)\n296|\trows, err := (&Reader{Local: repo}).List()\n297|\tif err != nil || rows == nil || len(rows) != 0 {\n298|\t\tt.Fatalf(\"empty: %+v %v\", rows, err)\n299|\t}\n300|\tif _, err := (&Reader{Local: repo}).Status(idA); !errors.Is(err, ErrNotFound) {\n301|\t\tt.Fatal(err)\n302|\t}\n303|}\n304|\n305|func TestResolveExcludesTombstonedButListsIt(t *testing.T) {\n306|\trepo, _ := repository(t)\n307|\tref := create(t, repo, idA, \"Deleted\")\n308|\tevent := appendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n309|\tevent = appendEvent(t, repo, idA, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n310|\tappendEvent(t, repo, idA, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n311|\tr := &Reader{Local: repo}\n312|\trows, err := r.List()\n313|\tif err != nil || len(rows) != 1 || rows[0].Projection.State != sessstate.StateTombstoned {\n314|\t\tt.Fatalf(\"tombstone lost: %+v %v\", rows, err)\n315|\t}\n316|\tfor _, selector := range []string{\"Deleted\", idA} {\n317|\t\tif _, err := r.Resolve(selector); !errors.Is(err, ErrNotFound) {\n318|\t\t\tt.Fatalf(\"tombstone routed: %v\", err)\n319|\t\t}\n320|\t}\n321|}\n322|\n323|func TestListStatusCheckpointAndProjectionFailure(t *testing.T) {\n324|\trepo, _ := repository(t)\n325|\tref := create(t, repo, idA, \"Checkpointed\")\n326|\tprevious := ref.RecordID\n327|\trows := []struct {\n328|\t\ttyp     string\n329|\t\tpayload map[string]any\n330|\t}{\n331|\t\t{\"session.created\", map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB}},\n332|\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n333|\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n334|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n335|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n336|\t\t{\"session.stopped\", map[string]any{\"graceful\": true, \"checkpoint_id\": zeroDigest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}},\n337|\t}\n338|\tfor index, row := range rows {\n339|\t\tprevious = appendEvent(t, repo, idA, previous, row.typ, index+1, row.payload)\n340|\t}\n341|\tr := &Reader{Local: repo, LocalHostID: hostA}\n342|\tstatus, err := r.Status(\"Checkpointed\")\n343|\tif err != nil || status.Projection.State != sessstate.StateStopped || !status.Projection.HasCheckpoint || status.Projection.Newest.ID != zeroDigest || status.Projection.Provider.Version != \"0.147.0\" {\n344|\t\tt.Fatalf(\"checkpoint summary: %+v %v\", status, err)\n345|\t}\n346|\tlist, err := r.List()\n347|\tif err != nil || len(list) != 1 || !reflect.DeepEqual(list[0], status) {\n348|\t\tt.Fatalf(\"checkpoint list/status disagreement: %+v %v\", list, err)\n349|\t}\n350|\t// Repository continuity admits this event; the state owner's terminal-state\n351|\t// transition gate refuses it. That failure must reach the read entry unchanged.\n352|\tappendEvent(t, repo, idA, previous, \"session.created\", 7, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n353|\tif _, err := r.List(); err == nil {\n354|\t\tt.Fatal(\"invalid projection was returned as a summary\")\n355|\t}\n356|\tif _, err := r.Status(idA); err == nil || errors.Is(err, ErrNotFound) {\n357|\t\tt.Fatalf(\"invalid projection became absence: %v\", err)\n358|\t}\n359|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb19","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":999,"recorded_at":1780531400001993,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886e05c57e23a565404f818a932f","text":"Read text file `internal/sessquery/resolve_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n11|)\n12|\n13|// idC and idD are further session identities for cross-source\n14|// fixtures; hostC is a third peer host.\n15|const idC = \"0198f4c8-3e70-7a11-8a2b-1234567890ad\"\n16|const idD = \"0198f4c8-3e70-7a11-8a2b-1234567890ae\"\n17|const hostC = \"0198f4c8-4a10-7b22-8b3c-1234567890ad\"\n18|\n19|// leaseB is a second fencing token for successor-lease fixtures.\n20|const leaseB = \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\"\n21|\n22|// qualifiedReader builds a local session and a peer session with an\n23|// aliased, allowlisted source, returning the reader, both handles, and\n24|// the peer data root for failure injection. Both sessions carry their\n25|// authoritative initial lease so status entries stay representable.\n26|func qualifiedReader(t *testing.T) (*Reader, *sessrepo.Repository, *sessrepo.Repository, string) {\n27|\tt.Helper()\n28|\tlocal, _ := repository(t)\n29|\tpeer, peerRoot := repository(t)\n30|\tlocalRef := create(t, local, idA, \"alpha\")\n31|\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n32|\tpeerRef := create(t, peer, idB, \"beta\")\n33|\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n34|\treader := &Reader{\n35|\t\tLocal:              local,\n36|\t\tLocalHostID:        hostB,\n37|\t\tAllowlistedPeerIDs: []string{hostA},\n38|\t\tPeers:              []PeerIndex{{hostA, peer}},\n39|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n40|\t}\n41|\treturn reader, local, peer, peerRoot\n42|}\n43|\n44|func TestResolveQualifiedSourcesSelectOneIndex(t *testing.T) {\n45|\treader, _, _, _ := qualifiedReader(t)\n46|\tfor _, row := range []struct {\n47|\t\tselector string\n48|\t\tid       string\n49|\t\tpeer     string\n50|\t}{\n51|\t\t{\"alpha@local\", idA, \"\"},\n52|\t\t{\"beta@peer:workstation\", idB, hostA},\n53|\t\t{\"beta@id:\" + hostA, idB, hostA},\n54|\t\t{\"alpha@id:\" + hostB, idA, \"\"},\n55|\t\t{idA + \"@local\", idA, \"\"},\n56|\t\t{idB + \"@peer:workstation\", idB, hostA},\n57|\t\t{\"id:\" + idB + \"@peer:workstation\", idB, hostA},\n58|\t\t{\"id:\" + idA + \"@local\", idA, \"\"},\n59|\t} {\n60|\t\tgot, err := reader.Resolve(row.selector)\n61|\t\tif err != nil || got.SessionID != row.id || got.PeerHostID != row.peer {\n62|\t\t\tt.Fatalf(\"Resolve(%q) = %+v, %v\", row.selector, got, err)\n63|\t\t}\n64|\t\tstatus, err := reader.Status(row.selector)\n65|\t\tif err != nil || status.Projection.SessionID != row.id {\n66|\t\t\tt.Fatalf(\"Status(%q) = %+v, %v\", row.selector, status, err)\n67|\t\t}\n68|\t}\n69|}\n70|\n71|func TestResolveQualifiedSourceNeverFallsBack(t *testing.T) {\n72|\treader, _, _, _ := qualifiedReader(t)\n73|\t// Each name exists in exactly one source; selecting the other\n74|\t// source misses, even though the union holds the name.\n75|\tfor _, selector := range []string{\"beta@local\", \"alpha@peer:workstation\", \"id:\" + idA + \"@peer:workstation\", \"id:\" + idB + \"@local\"} {\n76|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrNotFound) {\n77|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want not_found without fallback\", selector, err)\n78|\t\t}\n79|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrNotFound) {\n80|\t\t\tt.Fatalf(\"Status(%q) = %v, want not_found without fallback\", selector, err)\n81|\t\t}\n82|\t}\n83|}\n84|\n85|func TestResolveQualifiedNameBeforeUUIDInSource(t *testing.T) {\n86|\treader, _, peer, _ := qualifiedReader(t)\n87|\t// The peer learns a session whose NAME is shaped like a UUID. A\n88|\t// qualified NAME tries the exact name first; only \"id:\" bypasses it.\n89|\tcreate(t, peer, idC, idA)\n90|\tgot, err := reader.Resolve(idA + \"@peer:workstation\")\n91|\tif err != nil || got.SessionID != idC {\n92|\t\tt.Fatalf(\"qualified name-first: %+v %v\", got, err)\n93|\t}\n94|\tbypass, err := reader.Resolve(\"id:\" + idA + \"@peer:workstation\")\n95|\tif err == nil || !errors.Is(err, ErrNotFound) {\n96|\t\tt.Fatalf(\"id: bypass selected a name: %+v %v\", bypass, err)\n97|\t}\n98|\tcreate(t, peer, idA, \"alpha-peer\")\n99|\tgot, err = reader.Resolve(\"id:\" + idA + \"@peer:workstation\")\n100|\tif err != nil || got.SessionID != idA {\n101|\t\tt.Fatalf(\"id: identity: %+v %v\", got, err)\n102|\t}\n103|}\n104|\n105|func TestResolveQualifiedAmbiguityAndExclusions(t *testing.T) {\n106|\treader, local, peer, _ := qualifiedReader(t)\n107|\tcreate(t, peer, idC, \"BETA\")\n108|\tfor _, selector := range []string{\"beta@peer:workstation\", \"BETA@peer:workstation\"} {\n109|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrAmbiguous) {\n110|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want name_ambiguous\", selector, err)\n111|\t\t}\n112|\t}\n113|\t// Tombstoned and parked entries stay excluded under qualification:\n114|\t// tombstones need authoritative tombstone evidence, and a failed\n115|\t// record read is never that evidence.\n116|\tref := create(t, local, idC, \"doomed\")\n117|\tevent := appendEvent(t, local, idC, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n118|\tevent = appendEvent(t, local, idC, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n119|\tappendEvent(t, local, idC, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n120|\tfor _, selector := range []string{\"doomed@local\", idC + \"@local\", \"id:\" + idC + \"@local\"} {\n121|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrNotFound) {\n122|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want tombstone exclusion\", selector, err)\n123|\t\t}\n124|\t}\n125|\traw := record(t, idD, \"ParkedPeer\")\n126|\tpeer.AfterCreateStep = func(step sessrepo.CreateStep) error {\n127|\t\tif step == sessrepo.CreateStepRecord {\n128|\t\t\treturn errors.New(\"crash\")\n129|\t\t}\n130|\t\treturn nil\n131|\t}\n132|\tif _, err := peer.CreateSession(raw); err == nil {\n133|\t\tt.Fatal(\"fault did not fire\")\n134|\t}\n135|\tpeer.AfterCreateStep = nil\n136|\tfor _, selector := range []string{\"ParkedPeer@peer:workstation\", idD + \"@peer:workstation\", \"id:\" + idD + \"@peer:workstation\"} {\n137|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrNotFound) {\n138|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want parked exclusion\", selector, err)\n139|\t\t}\n140|\t}\n141|}\n142|\n143|func TestResolveExplicitSourceRefusals(t *testing.T) {\n144|\treader, _, _, _ := qualifiedReader(t)\n145|\t// Unknown aliases and hosts are not found; known but disallowed\n146|\t// peers are refused as not allowlisted. The unknown-source probes\n147|\t// use locally present names so a fallback to the local index would\n148|\t// succeed and fail the test.\n149|\tif _, err := reader.Resolve(\"alpha@peer:elsewhere\"); !errors.Is(err, ErrSourceNotFound) {\n150|\t\tt.Fatalf(\"unknown alias: %v\", err)\n151|\t}\n152|\tif _, err := reader.Resolve(\"alpha@id:\" + idC); !errors.Is(err, ErrSourceNotFound) {\n153|\t\tt.Fatalf(\"unknown host: %v\", err)\n154|\t}\n155|\treader.AllowlistedPeerIDs = nil\n156|\t// \"alpha\" resolves locally, so refusing it here proves revocation\n157|\t// never degrades into a local fallback either.\n158|\tfor _, selector := range []string{\"beta@peer:workstation\", \"beta@id:\" + hostA, \"id:\" + idB + \"@peer:workstation\", \"alpha@peer:workstation\"} {\n159|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrPeerNotAllowlisted) {\n160|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want peer_not_allowlisted\", selector, err)\n161|\t\t}\n162|\t}\n163|\t// The bare union still resolves the sessions it may reach; only the\n164|\t// explicit peer route is revoked.\n165|\tif _, err := reader.Resolve(\"beta\"); !errors.Is(err, ErrNotFound) {\n166|\t\tt.Fatalf(\"revoked bare union: %v\", err)\n167|\t}\n168|\t// Local needs no allowlist entry and survives revocation.\n169|\tif _, err := reader.Resolve(\"alpha@local\"); err != nil {\n170|\t\tt.Fatalf(\"local after revocation: %v\", err)\n171|\t}\n172|}\n173|\n174|func TestResolveExplicitSourceReadFailures(t *testing.T) {\n175|\treader, _, peer, peerRoot := qualifiedReader(t)\n176|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n177|\t\tt.Fatal(err)\n178|\t}\n179|\t// The peer failure carries the read-failure class while preserving\n180|\t// the underlying repository cause, and never falls back to the\n181|\t// local index even though \"alpha\" resolves there.\n182|\t_, err := reader.Resolve(\"beta@peer:workstation\")\n183|\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n184|\t\tt.Fatalf(\"explicit peer failure: %v\", err)\n185|\t}\n186|\tif _, err := reader.Resolve(\"alpha@peer:workstation\"); !errors.Is(err, ErrSourceReadFailed) {\n187|\t\tt.Fatalf(\"explicit miss behind failed read fell back: %v\", err)\n188|\t}\n189|\treader.Peers = []PeerIndex{{hostA, nil}}\n190|\tif _, err := reader.Resolve(\"beta@peer:workstation\"); !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, ErrUnavailable) {\n191|\t\tt.Fatalf(\"nil learned index: %v\", err)\n192|\t}\n193|\t// An allowlisted peer with no advertised index at all cannot\n194|\t// complete the required read either.\n195|\treader.Peers = nil\n196|\tif _, err := reader.Resolve(\"beta@peer:workstation\"); !errors.Is(err, ErrSourceNotFound) {\n197|\t\tt.Fatalf(\"unmapped alias: %v\", err)\n198|\t}\n199|\treader.Peers = []PeerIndex{{hostA, peer}}\n200|\treader.Aliases = nil\n201|\tif _, err := reader.Resolve(\"beta@id:\" + hostA); !errors.Is(err, ErrSourceReadFailed) {\n202|\t\tt.Fatalf(\"handle-less explicit host: %v\", err)\n203|\t}\n204|}\n205|\n206|func TestResolveBareIdentityUnion(t *testing.T) {\n207|\tlocal, _ := repository(t)\n208|\tpeer, _ := repository(t)\n209|\tcreate(t, local, idA, \"alpha\")\n210|\t// A UUID-shaped local name wins over the UUID identity on the bare\n211|\t// path, while \"id:\" bypasses names for the durable identity.\n212|\tcreate(t, local, idC, idB)\n213|\tcreate(t, peer, idB, \"remote\")\n214|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n215|\tbyName, err := reader.Resolve(idB)\n216|\tif err != nil || byName.SessionID != idC || byName.PeerHostID != \"\" {\n217|\t\tt.Fatalf(\"bare name-first: %+v %v\", byName, err)\n218|\t}\n219|\tbyID, err := reader.Resolve(\"id:\" + idB)\n220|\tif err != nil || byID.SessionID != idB || byID.PeerHostID != hostA {\n221|\t\tt.Fatalf(\"id: bypass: %+v %v\", byID, err)\n222|\t}\n223|\t// Replicated identical copies are one identity. While the local\n224|\t// host identity is unknown the local copy wins; once configured,\n225|\t// the bytewise smallest holder wins deterministically.\n226|\tcreate(t, peer, idA, \"alpha\")\n227|\tidentical, err := reader.Resolve(\"id:\" + idA)\n228|\tif err != nil || identical.SessionID != idA || identical.PeerHostID != \"\" {\n229|\t\tt.Fatalf(\"replicated unknown-local: %+v %v\", identical, err)\n230|\t}\n231|\treader.LocalHostID = hostB\n232|\ttiebreak, err := reader.Resolve(\"id:\" + idA)\n233|\tif err != nil || tiebreak.SessionID != idA || tiebreak.PeerHostID != hostA {\n234|\t\tt.Fatalf(\"replicated tie break: %+v %v\", tiebreak, err)\n235|\t}\n236|\t// Disagreeing copies of one UUID are inconsistent authority, not an\n237|\t// ambiguity and not a silent first match.\n238|\tother, _ := repository(t)\n239|\tcreate(t, other, idA, \"renamed\")\n240|\treader.Peers = []PeerIndex{{hostA, peer}, {hostC, other}}\n241|\treader.AllowlistedPeerIDs = []string{hostA, hostC}\n242|\tif _, err := reader.Resolve(\"id:\" + idA); !errors.Is(err, sessstate.ErrIntegrity) {\n243|\t\tt.Fatalf(\"disagreeing copies: %v\", err)\n244|\t}\n245|\tif _, err := reader.Resolve(\"renamed\"); !errors.Is(err, sessstate.ErrIntegrity) {\n246|\t\tt.Fatalf(\"disagreeing name win: %v\", err)\n247|\t}\n248|\t// A unique local name win never consults lower tiers, so an\n249|\t// unreadable peer copy behind it is not a conflict.\n250|\treader.Peers = []PeerIndex{{hostA, other}}\n251|\tif _, err := reader.Resolve(\"alpha\"); err != nil {\n252|\t\tt.Fatalf(\"local win with divergent peer copy: %v\", err)\n253|\t}\n254|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
