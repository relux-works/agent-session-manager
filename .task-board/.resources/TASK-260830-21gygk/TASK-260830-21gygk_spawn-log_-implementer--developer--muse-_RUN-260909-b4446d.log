{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb91","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":1059,"recorded_at":1780531400002113,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886e-3a61-7cd2-9034-5c372f13da89"},"task_id":"01a0886e-3a61-7cd2-9034-5c372f13da89","event":{"kind":"output","task_id":"01a0886e-3a61-7cd2-9034-5c372f13da89","chunk":"{\n  \"chunk_id\": \"exec-18-1\",\n  \"command\": \"grep -n \\\"lease_record_id\\\\|Lease Record\\\\|workspace\\\\|capabilit\\\\|authority_heads\\\" README.md | head -n 40; echo \\\"===\\\"; grep -n \\\"lease_record_id\\\\|workspace\\\\|capabilit\\\" internal/sessquery/TRACEABILITY.md | head -n 20\",\n  \"description\": \"Check docs for lease claims\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"11:contract, operation, capability-vocabulary, event, and error catalogs from\\n95:command, `doctor` result, conformance-target declaration, or runtime capability\\n138:mutates no durable state, and advertises no runtime capability.\\n169:availability claim, or runtime capability advertisement.\\n246:The v3 terminal capability vocabulary is derived from the pinned catalog's\\n248:property of the pinned Configuration catalog, so neither a new capability nor a\\n257:`required_capabilities` remains marked as contextual default provenance; this\\n291:runtime capability/backend availability. Existing selected roots are checked\\n390:Section 6.5 additionally names the `required_capabilities` default defect. See\\n416:availability, status, or capability claim, and the package is an internal M0\\n476:the Section 7.4 probe with its seven capability val