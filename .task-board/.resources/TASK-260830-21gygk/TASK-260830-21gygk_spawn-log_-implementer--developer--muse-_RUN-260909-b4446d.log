{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c80b","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":608,"recorded_at":1780531400001211,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886b-e85d-7123-9deb-3ff4695a6101"},"task_id":"01a0886b-e85d-7123-9deb-3ff4695a6101","event":{"kind":"output","task_id":"01a0886b-e85d-7123-9deb-3ff4695a6101","chunk":"Read text file `internal/sessstate/decode.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|const (\n12|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n13|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n14|)\n15|\n16|// DecodeRecord projects the reducer's record members from recordJSON:\n17|// strict frame (environ) then member grammars (scalar, environ). It\n18|// deliberately does not attest canonical identity: attestation is\n19|// owned by internal/sessrepo at the durable boundary (and pinned\n20|// there by the provhost no-attestation-outside-the-leaf gate), so a\n21|// second Verify here would fork the attestation owner. Production\n22|// bytes always arrive attested through the repository entries; the\n23|// digest below is the grammar-checked self member of those bytes,\n24|// never a recomputation.\n25|func DecodeRecord(recordJSON []byte) (Record, error) {\n26|\tmembers, fault := environ.DecodeStrictObject(recordJSON)\n27|\tif fault != nil {\n28|\t\treturn Record{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n29|\t}\n30|\tschema, err := stringMember(members, \"schema\")\n31|\tif err != nil || schema != sessionRecordSchema {\n32|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n33|\t}\n34|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n35|\tif !ok {\n36|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n37|\t}\n38|\trecordID, err := stringMember(members, \"record_id\")\n39|\tif err != nil {\n40|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record carries no record_id member\")\n41|\t}\n42|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n43|\t\treturn Record{}, refuse(ErrInvalidRecord, \"session record record_id: %v\", err)\n44|\t}\n45|\t// Identity members below were admitted by the canonical closed\n46|\t// shape above through the same owners, so these reads cannot fail\n47|\t// on bytes Verify accepted. The plain errors keep the refusal\n48|\t// funnel for reachable arms only.\n49|\tname, err := stringMember(members, \"name\")\n50|\tif err != nil {\n51|\t\treturn Record{}, fmt.Errorf(\"session record carries no name member: %v\", err)\n52|\t}\n53|\tkind, err := stringMember(members, \"kind\")\n54|\tif err != nil {\n55|\t\treturn Record{}, fmt.Errorf(\"session record carries no kind member: %v\", err)\n56|\t}\n57|\tprovider, err := stringMember(members, \"provider_id\")\n58|\tif err != nil {\n59|\t\treturn Record{}, fmt.Errorf(\"session record carries no provider_id member: %v\", err)\n60|\t}\n61|\tif _, err := scalar.ParseProviderID(provider); err != nil {\n62|\t\treturn Record{}, fmt.Errorf(\"session record provider_id: %v\", err)\n63|\t}\n64|\treturn Record{\n65|\t\tSessionID:  sessionID.String(),\n66|\t\tRecordID:   recordID,\n67|\t\tName:       name,\n68|\t\tKind:       kind,\n69|\t\tProviderID: provider,\n70|\t}, nil\n71|}\n72|\n73|// DecodeEvent projects the routing members plus the payload object the\n74|// reducer reads, under the same no-attestation division as\n75|// DecodeRecord: the closed payload shape was admitted by the canonical\n76|// owner at the sessrepo boundary, and a member that no longer decodes\n77|// refuses the derivation instead of reading as absent.\n78|func DecodeEvent(eventJSON []byte) (Event, error) {\n79|\tmembers, fault := environ.DecodeStrictObject(eventJSON)\n80|\tif fault != nil {\n81|\t\treturn Event{}, refuse(ErrInvalidEvent, \"decode session event frame: %v\", fault)\n82|\t}\n83|\tschema, err := stringMember(members, \"schema\")\n84|\tif err != nil || schema != sessionEventSchema {\n85|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event schema %q, want %q\", schema, sessionEventSchema)\n86|\t}\n87|\tversion, err := stringMember(members, \"schema_version\")\n88|\tif err != nil {\n89|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no schema_version member\")\n90|\t}\n91|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n92|\tif !ok {\n93|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no valid session_id member\")\n94|\t}\n95|\teventType, err := stringMember(members, \"event_type\")\n96|\tif err != nil {\n97|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no event_type member\")\n98|\t}\n99|\tepoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, uint53Max)\n100|\tif !ok {\n101|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_epoch at or above 1\")\n102|\t}\n103|\tleaseID, err := stringMember(members, \"lease_id\")\n104|\tif err != nil {\n105|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_id member\")\n106|\t}\n107|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n108|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event lease_id: %v\", err)\n109|\t}\n110|\tsequence, ok := environ.CheckUint53Bounds(members[\"lease_sequence\"], 1, uint53Max)\n111|\tif !ok {\n112|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no lease_sequence at or above 1\")\n113|\t}\n114|\towner, ok := environ.CheckUUIDv7(members[\"created_by_host_id\"])\n115|\tif !ok {\n116|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no valid created_by_host_id member\")\n117|\t}\n118|\tpredecessors, err := digestMembers(members, \"predecessors\")\n119|\tif err != nil {\n120|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event predecessors: %v\", err)\n121|\t}\n122|\tif len(predecessors) == 0 {\n123|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event names no predecessor\")\n124|\t}\n125|\teventID, err := stringMember(members, \"event_id\")\n126|\tif err != nil {\n127|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event carries no event_id member\")\n128|\t}\n129|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n130|\t\treturn Event{}, refuse(ErrInvalidEvent, \"session event event_id: %v\", err)\n131|\t}\n132|\t// The payload object was admitted by the canonical per-type union\n133|\t// at the sessrepo boundary; a non-object here is unreachable on\n134|\t// attested bytes. Plain for the same reason as the record\n135|\t// identity members.\n136|\tpayload, err := objectMember(members, \"payload\")\n137|\tif err != nil {\n138|\t\treturn Event{}, fmt.Errorf(\"session event carries no payload object: %v\", err)\n139|\t}\n140|\treturn Event{\n141|\t\tID:              eventID,\n142|\t\tType:            eventType,\n143|\t\tSchemaVersion:   version,\n144|\t\tSessionID:       sessionID.String(),\n145|\t\tCreatedByHostID: owner.String(),\n146|\t\tLeaseEpoch:      epoch,\n147|\t\tLeaseID:         leaseID,\n148|\t\tSequence:        sequence,\n149|\t\tPredecessors:    predecessors,\n150|\t\tPayload:         payload,\n151|\t}, nil\n152|}\n153|\n154|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6.\n155|// It is passed to the environ bound checker, never re-enforced here.\n156|const uint53Max = uint64(1<<53 - 1)\n157|\n158|// stringMember reads one string member with the language decoder.\n159|// Grammar rules for the value stay with the shape owner. Failures are\n160|// plain errors; the caller attributes them through its own site, so\n161|// the refusal census sees one site per boundary arm, not per helper.\n162|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n163|\traw, ok := members[name]\n164|\tif !ok {\n165|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n166|\t}\n167|\tvar value string\n168|\tif err := json.Unmarshal(raw, &value); err != nil {\n169|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n170|\t}\n171|\treturn value, nil\n172|}\n173|\n174|// digestMembers reads one array of digest strings. Digest grammar stays\n175|// with the scalar owner. Failures are plain errors for the caller to\n176|// attribute.\n177|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n178|\traw, ok := members[name]\n179|\tif !ok {\n180|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n181|\t}\n182|\tvar values []string\n183|\tif err := json.Unmarshal(raw, &values); err != nil {\n184|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n185|\t}\n186|\tfor _, value := range values {\n187|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n188|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n189|\t\t}\n190|\t}\n191|\treturn values, nil\n192|}\n193|\n194|// objectMember reads one object member into a decoded map. Failures\n195|// are plain errors for the caller to attribute.\n196|func objectMember(members map[string]json.RawMessage, name string) (map[string]any, error) {\n197|\traw, ok := members[name]\n198|\tif !ok {\n199|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n200|\t}\n201|\tvar object map[string]any\n202|\tif err := json.Unmarshal(raw, &object); err != nil || object == nil {\n203|\t\treturn nil, fmt.Errorf(\"member %q is not an object\", name)\n204|\t}\n205|\treturn object, nil\n206|}\n207|\n208|// payloadString reads one required string from an admitted payload.\n209|func payloadString(payload map[string]any, name string) (string, error) {\n210|\tvalue, ok := payload[name]\n211|\tif !ok {\n212|\t\treturn \"\", refuse(ErrDerivation, \"payload member %q is absent\", name)\n213|\t}\n214|\ttext, ok := value.(string)\n215|\tif !ok {\n216|\t\treturn \"\", refuse(ErrDerivation, \"payload member %q is not a string\", name)\n217|\t}\n218|\treturn text, nil\n219|}\n220|\n221|// payloadBool reads one required boolean from an admitted payload.\n222|func payloadBool(payload map[string]any, name string) (bool, error) {\n223|\tvalue, ok := payload[name]\n224|\tif !ok {\n225|\t\treturn false, refuse(ErrDerivation, \"payload member %q is absent\", name)\n226|\t}\n227|\tflag, ok := value.(bool)\n228|\tif !ok {\n229|\t\treturn false, refuse(ErrDerivation, \"payload member %q is not a boolean\", name)\n230|\t}\n231|\treturn flag, nil\n232|}\n233|\n234|// payloadUint reads one required uint53-range number from an admitted\n235|// payload. JSON numbers decode as float64; range and integrality stay\n236|// with this check, which refuses what the grammar cannot carry.\n237|func payloadUint(payload map[string]any, name string) (uint64, error) {\n238|\tvalue, ok := payload[name]\n239|\tif !ok {\n240|\t\treturn 0, refuse(ErrDerivation, \"payload member %q is absent\", name)\n241|\t}\n242|\tnumber, ok := value.(float64)\n243|\tif !ok || number != float64(uint64(number)) || uint64(number) == 0 || uint64(number) > uint53Max {\n244|\t\treturn 0, refuse(ErrDerivation, \"payload member %q is not a uint53 at or above 1\", name)\n245|\t}\n246|\treturn uint64(number), nil\n247|}\n248|\n249|// payloadNullableDigest reads one required nullable digest from an\n250|// admitted payload: null reports absent without failing, a string must\n251|// parse through the scalar owner.\n252|func payloadNullableDigest(payload map[string]any, name string) (string, bool, error) {\n253|\tvalue, ok := payload[name]\n254|\tif !ok {\n255|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q is absent\", name)\n256|\t}\n257|\tif value == nil {\n258|\t\treturn \"\", false, nil\n259|\t}\n260|\ttext, ok := value.(string)\n261|\tif !ok {\n262|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q is neither a digest nor null\", name)\n263|\t}\n264|\tif _, err := scalar.ParseDigest(text); err != nil {\n265|\t\treturn \"\", false, refuse(ErrDerivation, \"payload member %q holds malformed digest %q: %v\", name, text, err)\n266|\t}\n267|\treturn text, true, nil\n268|}","final_result":true}}}
