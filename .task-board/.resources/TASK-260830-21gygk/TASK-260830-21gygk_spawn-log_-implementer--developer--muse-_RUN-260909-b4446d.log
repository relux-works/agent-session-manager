{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f1","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":723,"recorded_at":1780531400001441,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886c-1e57-75c1-b9bc-f09997639949"},"task_id":"01a0886c-1e57-75c1-b9bc-f09997639949","event":{"kind":"output","task_id":"01a0886c-1e57-75c1-b9bc-f09997639949","chunk":"Read text file `internal/sessquery/plan_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"reflect\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// appendEventAs chains one event under an explicit envelope lease,\n18|// unlike the epoch-1-only fixtures helper.\n19|func appendEventAs(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, epoch uint64, leaseID string, payload map[string]any) string {\n20|\tt.Helper()\n21|\tvalue := map[string]any{\n22|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n23|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n24|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n25|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n26|\t}\n27|\traw := identity(t, value, \"event_id\")\n28|\tref, err := repo.AppendEvent(id, raw)\n29|\tif err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\treturn ref.EventID\n33|}\n34|\n35|// copySessionDir replicates one persisted session directory byte for\n36|// byte, so two sources hold the same identity with agreeing digests.\n37|func copySessionDir(t *testing.T, srcRoot, dstRoot, sessionID string) {\n38|\tt.Helper()\n39|\tsrc := filepath.Join(srcRoot, \"sessions\", sessionID)\n40|\tdst := filepath.Join(dstRoot, \"sessions\", sessionID)\n41|\tentries, err := os.ReadDir(src)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tif err := os.MkdirAll(filepath.Join(dst, \"events\"), 0o700); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tfor _, entry := range entries {\n49|\t\tif entry.IsDir() {\n50|\t\t\tblobs, err := os.ReadDir(filepath.Join(src, entry.Name()))\n51|\t\t\tif err != nil {\n52|\t\t\t\tt.Fatal(err)\n53|\t\t\t}\n54|\t\t\tfor _, blob := range blobs {\n55|\t\t\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name(), blob.Name()))\n56|\t\t\t\tif err != nil {\n57|\t\t\t\t\tt.Fatal(err)\n58|\t\t\t\t}\n59|\t\t\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name(), blob.Name()), bytes, 0o600); err != nil {\n60|\t\t\t\t\tt.Fatal(err)\n61|\t\t\t\t}\n62|\t\t\t}\n63|\t\t\tcontinue\n64|\t\t}\n65|\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name()))\n66|\t\tif err != nil {\n67|\t\t\tt.Fatal(err)\n68|\t\t}\n69|\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name()), bytes, 0o600); err != nil {\n70|\t\t\tt.Fatal(err)\n71|\t\t}\n72|\t}\n73|}\n74|\n75|// plannedSession builds a local session with its bootstrap event and\n76|// returns the reader, roots, record digest, and created event ID. The\n77|// reader carries the known local host identity every local plan\n78|// requires for its source binding.\n79|func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n80|\tt.Helper()\n81|\tlocal, root := repository(t)\n82|\tref := create(t, local, idA, \"alpha\")\n83|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n84|\treader := &Reader{Local: local, LocalHostID: hostA}\n85|\treturn reader, root, ref, created\n86|}\n87|\n88|func mustBuild(t *testing.T, reader *Reader, args PlanArgs) SelectionPlan {\n89|\tt.Helper()\n90|\tplan, err := reader.BuildPlan(args)\n91|\tif err != nil {\n92|\t\tt.Fatal(err)\n93|\t}\n94|\treturn plan\n95|}\n96|\n97|func mustStale(t *testing.T, err error, reason string) {\n98|\tt.Helper()\n99|\tif !errors.Is(err, ErrPlanStale) {\n100|\t\tt.Fatalf(\"error = %v, want selector_plan_stale\", err)\n101|\t}\n102|\tif !strings.Contains(err.Error(), reason) {\n103|\t\tt.Fatalf(\"error = %v, want reason %q\", err, reason)\n104|\t}\n105|}\n106|\n107|func TestBuildPlanBindsCurrentFacts(t *testing.T) {\n108|\treader, _, ref, created := plannedSession(t)\n109|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n110|\tif plan.SelectorVersion != SelectorVersion || plan.Selector != \"alpha\" || plan.SessionID != idA {\n111|\t\tt.Fatalf(\"identity: %+v\", plan)\n112|\t}\n113|\tif plan.SessionRecordID != ref.RecordID {\n114|\t\tt.Fatalf(\"record digest = %q, want %q\", plan.SessionRecordID, ref.RecordID)\n115|\t}\n116|\tif plan.SourceHostID != hostA || plan.SourceAlias != nil {\n117|\t\tt.Fatalf(\"local source: host %q alias %+v\", plan.SourceHostID, plan.SourceAlias)\n118|\t}\n119|\tfor _, digest := range []string{plan.SourceIndexDigest, plan.ConfigurationDigest, plan.ExpectationDigest} {\n120|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n121|\t\t\tt.Fatalf(\"digest %q: %v\", digest, err)\n122|\t\t}\n123|\t}\n124|\tif plan.SourceIndexDigest == plan.ConfigurationDigest {\n125|\t\tt.Fatalf(\"index and configuration digests collide\")\n126|\t}\n127|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n128|\t\tt.Fatalf(\"lease: %+v\", plan)\n129|\t}\n130|\t// The lease attestation binds the same validated winning-lease\n131|\t// observation deterministically: no standalone Lease Record\n132|\t// object is read, and no digest is fabricated.\n133|\twantLeaseRecord, err := fingerprintWinningLease(idA, 1, lease, hostA)\n134|\tif err != nil {\n135|\t\tt.Fatal(err)\n136|\t}\n137|\tif plan.LeaseRecordID != wantLeaseRecord {\n138|\t\tt.Fatalf(\"lease_record_id = %q, want %q\", plan.LeaseRecordID, wantLeaseRecord)\n139|\t}\n140|\tif _, err := scalar.ParseDigest(plan.LeaseRecordID); err != nil {\n141|\t\tt.Fatalf(\"lease_record_id %q: %v\", plan.LeaseRecordID, err)\n142|\t}\n143|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n144|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n145|\t}\n146|\tif plan.Action != ActionStatus || plan.DestinationHostID != nil {\n147|\t\tt.Fatalf(\"action: %+v\", plan)\n148|\t}\n149|\tif plan.ExpectationDigest != \"sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a\" {\n150|\t\tt.Fatalf(\"empty expectations digest = %q\", plan.ExpectationDigest)\n151|\t}\n152|\tagain := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n153|\tif !reflect.DeepEqual(plan, again) {\n154|\t\tt.Fatalf(\"rebuild diverged:\\n%+v\\n%+v\", plan, again)\n155|\t}\n156|\tif err := reader.Revalidate(plan); err != nil {\n157|\t\tt.Fatalf(\"fresh plan is not current: %v\", err)\n158|\t}\n159|}\n160|\n161|func TestBuildPlanPeerSourceFacts(t *testing.T) {\n162|\tlocal, _ := repository(t)\n163|\tpeer, _ := repository(t)\n164|\tcreate(t, local, idA, \"alpha\")\n165|\tref := create(t, peer, idB, \"beta\")\n166|\tcreated := appendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n167|\treader := &Reader{\n168|\t\tLocal:              local,\n169|\t\tLocalHostID:        hostB,\n170|\t\tAllowlistedPeerIDs: []string{hostA},\n171|\t\tPeers:              []PeerIndex{{hostA, peer}},\n172|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n173|\t}\n174|\tplan := mustBuild(t, reader, PlanArgs{\n175|\t\tSelector:     \"beta@peer:workstation\",\n176|\t\tAction:       ActionAttach,\n177|\t\tDestination:  hostB,\n178|\t\tExpectations: []byte(`{\"checkpoint_id\":null}`),\n179|\t})\n180|\tif plan.SourceHostID != hostA || plan.SourceAlias == nil || *plan.SourceAlias != \"workstation\" {\n181|\t\tt.Fatalf(\"source: %+v\", plan)\n182|\t}\n183|\tif plan.SessionID != idB || plan.SessionRecordID != ref.RecordID {\n184|\t\tt.Fatalf(\"identity: %+v\", plan)\n185|\t}\n186|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n187|\t\tt.Fatalf(\"lease: %+v\", plan)\n188|\t}\n189|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n190|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n191|\t}\n192|\tif plan.DestinationHostID == nil || *plan.DestinationHostID != hostB {\n193|\t\tt.Fatalf(\"destination: %+v\", plan)\n194|\t}\n195|\tif err := reader.Revalidate(plan); err != nil {\n196|\t\tt.Fatalf(\"fresh peer plan is not current: %v\", err)\n197|\t}\n198|}\n199|\n200|func TestBuildPlanRecordOnlySessionRefusesBootstrap(t *testing.T) {\n201|\tlocal, _ := repository(t)\n202|\tcreate(t, local, idA, \"alpha\")\n203|\treader := &Reader{Local: local, LocalHostID: hostA}\n204|\t// A complete read proving a record without any valid lease is an\n205|\t// interrupted persistence prefix for the bootstrap-recovery leaf:\n206|\t// no plan binds an empty lease triple or placeholder, and there is\n207|\t// nothing current to revalidate.\n208|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n209|\t\tt.Fatalf(\"record-only build = %v, want selector_bootstrap_incomplete\", err)\n210|\t}\n211|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"id:\" + idA, Action: ActionStatus}); !errors.Is(err, ErrBootstrapIncomplete) {\n212|\t\tt.Fatalf(\"record-only id build = %v, want selector_bootstrap_incomplete\", err)\n213|\t}\n214|}\n215|\n216|func TestBuildPlanLocalSourceRequiresKnownHost(t *testing.T) {\n217|\treader, _, _, _ := plannedSession(t)\n218|\treader.LocalHostID = \"\"\n219|\t// The local source cannot be named without the local host\n220|\t// identity: the plan binds a UUIDv7 source host or refuses.\n221|\t// Peer selections still bind their own known host.\n222|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrInvalidConfig) {\n223|\t\tt.Fatalf(\"unknown-host local build = %v, want invalid_config\", err)\n224|\t}\n225|\tpeer, _ := repository(t)\n226|\tref := create(t, peer, idB, \"beta\")\n227|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n228|\treader.AllowlistedPeerIDs = []string{hostA}\n229|\treader.Peers = []PeerIndex{{hostA, peer}}\n230|\treader.Aliases = map[string]string{hostA: \"workstation\"}\n231|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus})\n232|\tif plan.SourceHostID != hostA {\n233|\t\tt.Fatalf(\"peer source without local host: %+v\", plan)\n234|\t}\n235|\tif err := reader.Revalidate(plan); err != nil {\n236|\t\tt.Fatalf(\"peer plan without local host is not current: %v\", err)\n237|\t}\n238|}\n239|\n240|func TestBuildPlanArgumentGates(t *testing.T) {\n241|\treader, _, _, _ := plannedSession(t)\n242|\tfor _, args := range []PlanArgs{\n243|\t\t{Selector: \"alpha\", Action: \"launch\"},\n244|\t\t{Selector: \"alpha\", Action: \"\"},\n245|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: \"not-a-uuid\"},\n246|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: lease},\n247|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`{bad`)},\n248|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`[1]`)},\n249|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`\"str\"`)},\n250|\t\t{Selector: \"alpha@unknown\", Action: ActionStatus},\n251|\t\t{Selector: \"\", Action: ActionStatus},\n252|\t} {\n253|\t\tif _, err := reader.BuildPlan(args); !errors.Is(err, ErrInvalidArgument) {\n254|\t\t\tt.Fatalf(\"BuildPlan(%+v) = %v, want invalid_arguments\", args, err)\n255|\t\t}\n256|\t}\n257|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\"}); !errors.Is(err, ErrInvalidArgument) {\n258|\t\tt.Fatalf(\"missing action: %v\", err)\n259|\t}\n260|}\n261|\n262|func TestPlanDigestAndMarshalRoundTrip(t *testing.T) {\n263|\treader, _, _, _ := plannedSession(t)\n264|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionDiff})\n265|\tfirst, err := plan.Digest()\n266|\tif err != nil {\n267|\t\tt.Fatal(err)\n268|\t}\n269|\tsecond, err := plan.Digest()\n270|\tif err != nil || first != second {\n271|\t\tt.Fatalf(\"digest unstable: %q %q %v\", first, second, err)\n272|\t}\n273|\traw, err := plan.Marshal()\n274|\tif err != nil {\n275|\t\tt.Fatal(err)\n276|\t}\n277|\tparsed, err := ParsePlan(raw)\n278|\tif err != nil {\n279|\t\tt.Fatal(err)\n280|\t}\n281|\tif !reflect.DeepEqual(plan, parsed) {\n282|\t\tt.Fatalf(\"round trip diverged:\\n%+v\\n%+v\", plan, parsed)\n283|\t}\n284|\t// Tampering with any member breaks the locally verified digest.\n285|\tvar wire map[string]any\n286|\tif err := json.Unmarshal(raw, &wire); err != nil {\n287|\t\tt.Fatal(err)\n288|\t}\n289|\twire[\"action\"] = ActionAttach\n290|\ttampered, err := json.Marshal(wire)\n291|\tif err != nil {\n292|\t\tt.Fatal(err)\n293|\t}\n294|\tif _, err := ParsePlan(tampered); !errors.Is(err, ErrInvalidArgument) {\n295|\t\tt.Fatalf(\"tampered plan parsed: %v\", err)\n296|\t}\n297|\tif _, err := ParsePlan([]byte(`{broken`)); !errors.Is(err, ErrInvalidArgument) {\n298|\t\tt.Fatalf(\"malformed encoding: %v\", err)\n299|\t}\n300|\t// A valid persisted encoding is never authority by itself: current\n301|\t// facts still decide through Revalidate.\n302|\traw, err = plan.Marshal()\n303|\tif err != nil {\n304|\t\tt.Fatal(err)\n305|\t}\n306|\tparsed, err = ParsePlan(raw)\n307|\tif err != nil {\n308|\t\tt.Fatal(err)\n309|\t}\n310|\tappendEvent(t, reader.Local, idA, parsed.AuthorityHeads[0], \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n311|\tif err := reader.Revalidate(parsed); !errors.Is(err, ErrPlanStale) {\n312|\t\tt.Fatalf(\"persisted digest overrode current facts: %v\", err)\n313|\t}\n314|}\n315|\n316|func TestRevalidateDetectsEachFactChange(t *testing.T) {\n317|\tt.Run(\"same lease event changes heads\", func(t *testing.T) {\n318|\t\treader, _, _, _ := plannedSession(t)\n319|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n320|\t\ttail := plan.AuthorityHeads[0]\n321|\t\tappendEvent(t, reader.Local, idA, tail, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n322|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n323|\t})\n324|\tt.Run(\"successor lease changes winner\", func(t *testing.T) {\n325|\t\treader, _, _, created := plannedSession(t)\n326|\t\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n327|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n328|\t\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n329|\t\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n330|\t\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n331|\t\t})\n332|\t\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n333|\t})\n334|\tt.Run(\"record replacement changes digest\", func(t *testing.T) {\n335|\t\treader, root, _, _ := plannedSession(t)\n336|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n337|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), record(t, idA, \"renamed\"), 0o600); err != nil {\n338|\t\t\tt.Fatal(err)\n339|\t\t}\n340|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n341|\t})\n342|\tt.Run(\"alias remap changes binding\", func(t *testing.T) {\n343|\t\tlocal, _ := repository(t)\n344|\t\trepoA, rootA := repository(t)\n345|\t\trepoB, rootB := repository(t)\n346|\t\tref := create(t, repoA, idA, \"shared\")\n347|\t\tappendEvent(t, repoA, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n348|\t\tcopySessionDir(t, rootA, rootB, idA)\n349|\t\treader := &Reader{\n350|\t\t\tLocal:              local,\n351|\t\t\tAllowlistedPeerIDs: []string{hostA, hostB},\n352|\t\t\tPeers:              []PeerIndex{{hostA, repoA}, {hostB, repoB}},\n353|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n354|\t\t}\n355|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"shared@peer:ws\", Action: ActionStatus})\n356|\t\tif plan.SourceHostID != hostA {\n357|\t\t\tt.Fatalf(\"source: %+v\", plan)\n358|\t\t}\n359|\t\treader.Aliases = map[string]string{hostB: \"ws\"}\n360|\t\tmustStale(t, reader.Revalidate(plan), \"source binding changed\")\n361|\t})\n362|\tt.Run(\"unrelated mapping change changes configuration\", func(t *testing.T) {\n363|\t\treader, _, _, _ := plannedSession(t)\n364|\t\tpeer, _ := repository(t)\n365|\t\treader.Peers = []PeerIndex{{hostC, peer}}\n366|\t\treader.AllowlistedPeerIDs = []string{hostC}\n367|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n368|\t\treader.Aliases = map[string]string{hostC: \"ws\"}\n369|\t\tmustStale(t, reader.Revalidate(plan), \"configuration changed\")\n370|\t})\n371|\tt.Run(\"revocation refuses allowlist\", func(t *testing.T) {\n372|\t\tlocal, _ := repository(t)\n373|\t\tpeer, _ := repository(t)\n374|\t\tlocalRef := create(t, local, idA, \"alpha\")\n375|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n376|\t\tpeerRef := create(t, peer, idB, \"beta\")\n377|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n378|\t\treader := &Reader{\n379|\t\t\tLocal:              local,\n380|\t\t\tAllowlistedPeerIDs: []string{hostA},\n381|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n382|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n383|\t\t}\n384|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n385|\t\treader.AllowlistedPeerIDs = nil\n386|\t\terr := reader.Revalidate(plan)\n387|\t\tif !errors.Is(err, ErrPeerNotAllowlisted) {\n388|\t\t\tt.Fatalf(\"revocation = %v, want peer_not_allowlisted\", err)\n389|\t\t}\n390|\t})\n391|\tt.Run(\"tombstone invalidates live plan\", func(t *testing.T) {\n392|\t\treader, _, ref, created := plannedSession(t)\n393|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n394|\t\tfailed := appendEvent(t, reader.Local, idA, created, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n395|\t\t_ = ref\n396|\t\tappendEvent(t, reader.Local, idA, failed, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n397|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n398|\t})\n399|\tt.Run(\"deletion empties selection\", func(t *testing.T) {\n400|\t\treader, root, _, _ := plannedSession(t)\n401|\t\t// A surviving sibling keeps the index readable, so only the\n402|\t\t// absence check can report the planned identity: substituting\n403|\t\t// the sibling must never validate.\n404|\t\tcreate(t, reader.Local, idB, \"bravo\")\n405|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n406|\t\tif err := os.RemoveAll(filepath.Join(root, \"sessions\", idA)); err != nil {\n407|\t\t\tt.Fatal(err)\n408|\t\t}\n409|\t\tmustStale(t, reader.Revalidate(plan), \"selection absent from source index\")\n410|\t})\n411|\tt.Run(\"unrelated session change changes index\", func(t *testing.T) {\n412|\t\treader, _, _, _ := plannedSession(t)\n413|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n414|\t\tref := create(t, reader.Local, idB, \"bravo\")\n415|\t\tappendEvent(t, reader.Local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n416|\t\tmustStale(t, reader.Revalidate(plan), \"source index changed\")\n417|\t})\n418|\tt.Run(\"invalid projection propagates\", func(t *testing.T) {\n419|\t\treader, _, ref, created := plannedSession(t)\n420|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n421|\t\t// A terminal close followed by a second bootstrap is\n422|\t\t// continuity-admitted by the repository and refused by the\n423|\t\t// state owner: the failure reaches revalidation unchanged,\n424|\t\t// never as absence or staleness.\n425|\t\tprevious := created\n426|\t\tfor index, row := range []struct {\n427|\t\t\ttyp     string\n428|\t\t\tpayload map[string]any\n429|\t\t}{\n430|\t\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n431|\t\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n432|\t\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n433|\t\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n434|\t\t\t{\"session.stopped\", map[string]any{\"graceful\": true, \"checkpoint_id\": zeroDigest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}},\n435|\t\t} {\n436|\t\t\tprevious = appendEvent(t, reader.Local, idA, previous, row.typ, index+2, row.payload)\n437|\t\t}\n438|\t\tappendEvent(t, reader.Local, idA, previous, \"session.created\", 7, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n439|\t\terr := reader.Revalidate(plan)\n440|\t\tif err == nil || errors.Is(err, ErrPlanStale) || errors.Is(err, ErrNotFound) {\n441|\t\t\tt.Fatalf(\"projection failure became %v\", err)\n442|\t\t}\n443|\t\tif !errors.Is(err, sessstate.ErrInvalidTransition) {\n444|\t\t\tt.Fatalf(\"projection failure = %v\", err)\n445|\t\t}\n446|\t})\n447|}\n448|\n449|func TestRevalidateReadFailures(t *testing.T) {\n450|\tt.Run(\"peer read failure keeps class\", func(t *testing.T) {\n451|\t\tlocal, _ := repository(t)\n452|\t\tpeer, peerRoot := repository(t)\n453|\t\tlocalRef := create(t, local, idA, \"alpha\")\n454|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n455|\t\tpeerRef := create(t, peer, idB, \"beta\")\n456|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n457|\t\treader := &Reader{\n458|\t\t\tLocal:              local,\n459|\t\t\tAllowlistedPeerIDs: []string{hostA},\n460|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n461|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n462|\t\t}\n463|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n464|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n465|\t\t\tt.Fatal(err)\n466|\t\t}\n467|\t\terr := reader.Revalidate(plan)\n468|\t\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n469|\t\t\tt.Fatalf(\"peer revalidation failure = %v\", err)\n470|\t\t}\n471|\t})\n472|\tt.Run(\"local read failure keeps repository error\", func(t *testing.T) {\n473|\t\treader, root, _, _ := plannedSession(t)\n474|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n475|\t\tif err := os.Rename(filepath.Join(root, \"sessions\"), filepath.Join(root, \"saved\")); err != nil {\n476|\t\t\tt.Fatal(err)\n477|\t\t}\n478|\t\terr := reader.Revalidate(plan)\n479|\t\tif !errors.Is(err, sessrepo.ErrRepositoryPath) {\n480|\t\t\tt.Fatalf(\"local revalidation failure = %v\", err)\n481|\t\t}\n482|\t\tif errors.Is(err, ErrSourceReadFailed) {\n483|\t\t\tt.Fatalf(\"local failure misclassified as remote: %v\", err)\n484|\t\t}\n485|\t})\n486|\tt.Run(\"never falls back to another source\", func(t *testing.T) {\n487|\t\tlocal, _ := repository(t)\n488|\t\tpeer, peerRoot := repository(t)\n489|\t\tlocalRef := create(t, local, idA, \"beta\")\n490|\t\tappendEvent(t, local, idA, localRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": localRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n491|\t\tpeerRef := create(t, peer, idB, \"beta\")\n492|\t\tappendEvent(t, peer, idB, peerRef.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peerRef.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n493|\t\treader := &Reader{\n494|\t\t\tLocal:              local,\n495|\t\t\tAllowlistedPeerIDs: []string{hostA},\n496|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n497|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n498|\t\t}\n499|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n500|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n(more lines below)","final_result":true}}}
