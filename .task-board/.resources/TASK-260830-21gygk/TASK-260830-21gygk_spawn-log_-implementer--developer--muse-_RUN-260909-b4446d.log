{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d861","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":2699,"recorded_at":1780531400005393,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a08873-97aa-78d0-a75c-0491518b180a"},"task_id":"01a08873-97aa-78d0-a75c-0491518b180a","event":{"kind":"output","task_id":"01a08873-97aa-78d0-a75c-0491518b180a","chunk":"Read text file `internal/sessquery/review_test.go`.\n1|// Independent-review regression tests for TASK-260830-21gygk,\n2|// carried from the CR revision 2 review bundle\n3|// (reviewer_regression_test.go) into the candidate: cross-source\n4|// authority divergence must refuse revalidation, record-only\n5|// bootstraps must refuse summaries, and every marshalled plan must\n6|// carry the required lease attestation.\n7|package sessquery\n8|\n9|import (\n10|\t\"encoding/json\"\n11|\t\"testing\"\n12|)\n13|\n14|func TestReviewerOtherSourceDivergenceMustRefuse(t *testing.T) {\n15|\tlocal, _ := repository(t)\n16|\tpeer, _ := repository(t)\n17|\tref := create(t, peer, idB, \"beta\")\n18|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n19|\treader := &Reader{Local: local, LocalHostID: hostB, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{HostID: hostA, Repo: peer}}}\n20|\twithLeases(reader, leaseCreate(t, idB, hostA))\n21|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"id:\" + idB, Action: ActionStatus})\n22|\tif err := reader.Revalidate(plan); err != nil {\n23|\t\tt.Fatal(err)\n24|\t}\n25|\tcreate(t, local, idB, \"different-record\")\n26|\tif _, err := reader.Resolve(\"id:\" + idB); err == nil {\n27|\t\tt.Fatal(\"diagnostic premise: expected record divergence\")\n28|\t} else {\n29|\t\tt.Logf(\"fresh Resolve: %v\", err)\n30|\t}\n31|\tif err := reader.Revalidate(plan); err == nil {\n32|\t\tt.Fatal(\"Revalidate accepted conflicting immutable record for the selected UUID in another allowed source\")\n33|\t}\n34|}\n35|func TestReviewerBootstrapSummaryMustRefuse(t *testing.T) {\n36|\tlocal, _ := repository(t)\n37|\tcreate(t, local, idA, \"alpha\")\n38|\treader := &Reader{Local: local, LocalHostID: hostA}\n39|\tt.Run(\"list\", func(t *testing.T) {\n40|\t\trows, err := reader.List()\n41|\t\tif err == nil {\n42|\t\t\tt.Fatalf(\"List accepted record-only bootstrap: rows=%d epoch=%d owner=%q\", len(rows), rows[0].Projection.Winner.Epoch, rows[0].Projection.OwnerHostID)\n43|\t\t}\n44|\t})\n45|\tt.Run(\"status\", func(t *testing.T) {\n46|\t\trow, err := reader.Status(\"alpha\")\n47|\t\tif err == nil {\n48|\t\t\tt.Fatalf(\"Status accepted record-only bootstrap: epoch=%d owner=%q\", row.Projection.Winner.Epoch, row.Projection.OwnerHostID)\n49|\t\t}\n50|\t})\n51|}\n52|func TestReviewerPlanRequiresLeaseRecord(t *testing.T) {\n53|\treader, _, _, _ := plannedSession(t)\n54|\t// plannedSession already carries the winning Lease Record; this\n55|\t// gate proves the plan binds its canonical digest, never an\n56|\t// envelope fingerprint, and refuses when the record is absent.\n57|\treader.LocalHostID = hostA\n58|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n59|\traw, err := plan.Marshal()\n60|\tif err != nil {\n61|\t\tt.Fatal(err)\n62|\t}\n63|\tvar fields map[string]any\n64|\tif err := json.Unmarshal(raw, &fields); err != nil {\n65|\t\tt.Fatal(err)\n66|\t}\n67|\tif _, ok := fields[\"lease_record_id\"]; !ok {\n68|\t\tt.Fatal(\"plan omits required validated lease_record_id\")\n69|\t}\n70|}","final_result":true}}}
