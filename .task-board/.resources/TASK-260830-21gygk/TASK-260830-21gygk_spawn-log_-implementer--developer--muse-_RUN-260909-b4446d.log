{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cee9","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":1487,"recorded_at":1780531400002969,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886f-a8fe-7782-9542-7f23d4bcf1fa"},"task_id":"01a0886f-a8fe-7782-9542-7f23d4bcf1fa","event":{"kind":"output","task_id":"01a0886f-a8fe-7782-9542-7f23d4bcf1fa","chunk":"Read text file `internal/sessquery/revalidate.go`.\n(168 line(s) above)\n169|\t\tif isAbsentPeerIndex(reader, id) {\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\trepo, peerHost, err := reader.peerRepo(id)\n173|\t\tif err != nil {\n174|\t\t\treturn err\n175|\t\t}\n176|\t\trows, err := reader.readSource(repo, peerHost)\n177|\t\tif err != nil {\n178|\t\t\treturn err\n179|\t\t}\n180|\t\tif err := checkUnionCopy(plan, rows); err != nil {\n181|\t\t\treturn err\n182|\t\t}\n183|\t}\n184|\treturn nil\n185|}\n186|\n187|// isAbsentPeerIndex reports an allowlisted peer with no advertised\n188|// learned index handle at all: absence, never a failed read.\n189|func isAbsentPeerIndex(reader *Reader, host string) bool {\n190|\tfor _, peer := range reader.Peers {\n191|\t\tif peer.HostID == host {\n192|\t\t\treturn false\n193|\t\t}\n194|\t}\n195|\treturn true\n196|}\n197|\n198|// checkUnionCopy validates one non-plan source's rows for the pinned\n199|// session UUID as validateAuthorityUnion documents.\n200|func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n201|\tfor _, row := range rows {\n202|\t\tif row.Projection.SessionID != plan.SessionID {\n203|\t\t\tcontinue\n204|\t\t}\n205|\t\tif row.Projection.Parked != nil {\n206|\t\t\tcontinue\n207|\t\t}\n208|\t\tif row.Projection.State == sessstate.StateTombstoned {\n209|\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n210|\t\t}\n211|\t\tif row.Projection.RecordID != plan.SessionRecordID {\n212|\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n213|\t\t}\n214|\t\tif row.Projection.Winner.IsZero() {\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\tif row.Projection.Winner.Epoch != plan.LeaseEpoch || row.Projection.Winner.LeaseID != plan.LeaseID || row.Projection.OwnerHostID != plan.OwnerHostID {\n218|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n219|\t\t}\n220|\t\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, row.Projection.Winner.Epoch, row.Projection.Winner.LeaseID, row.Projection.OwnerHostID)\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\tif leaseRecordID != plan.LeaseRecordID {\n225|\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n226|\t\t}\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// planSourceBinding resolves the plan's bound source: a local plan\n232|// carries a null alias with an empty or local host, while any other\n233|// binding selects a peer source by host. The second return reports\n234|// whether the plan selects a peer source.\n235|func planSourceBinding(plan SelectionPlan, config validatedConfig) (string, bool) {\n236|\tif plan.SourceAlias == nil && (plan.SourceHostID == \"\" || plan.SourceHostID == config.localHost) {\n237|\t\treturn \"\", false\n238|\t}\n(more lines below)","final_result":true}}}
