mplete the shape.\n74|type AuthoritativeSummary struct {\n75|\tSessionID                 string\n76|\tName                      string\n77|\tKind                      string\n78|\tProviderID                string\n79|\tState                     string\n80|\tOwnerHostID               string\n81|\tOwnerHostName             string\n82|\tLeaseEpoch                uint64\n83|\tLeaseID                   string\n84|\tLocalRole                 string\n85|\tHasCheckpoint             bool\n86|\tNewestCheckpointID        *string\n87|\tNewestCheckpointCreatedAt *string\n88|\tProcessPresent            *bool\n89|\tCapabilities              []string\n90|\tWorkspacePresent          *bool\n91|}\n92|\n93|// checkSummaryRepresentable refuses a projected row that can never be\n94|// represented truthfully in a public summary: a complete read proving\n95|// a record without any valid lease. Parked rows stay representable\n96|// through their blocking reason and retry, and tombstoned rows stay\n97|// listed with their terminal state; resolution routing already\n98|// excludes both from live selection.\n99|func checkSummaryRepresentable(summary Summary) error {\n100|\tprojection := summary.Projection\n101|\tif projection.Parked != nil || projection.State == sessstate.StateTombstoned {\n102|\t\treturn nil\n103|\t}\n104|\tif projection.Winner.IsZero() {\n105|\t\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)\n106|\t}\n107|\treturn nil\n108|}\n109|\n110|// validatedAuthorityInputs validates the reader's host metadata and\n111|// observation maps as configuration: UUIDv7 keys, printable bounded\n112|// display names, RFC 3339 checkpoint timestamps, and printable\n113|// bounded capability names. Malformed inputs are invalid_config;\n114|// missing facts at summary time are selector_observation_unavailable.\n115|func (reader *Reader) validatedAuthorityInputs() error {\n116|\tfor host, metadata := range reader.HostMetadata {\n117|\t\tif _, err := scalar.ParseUUIDv7(host); err != nil {\n118|\t\t\treturn fmt.Errorf(\"%w: malformed host metadata ID: %v\", ErrInvalidConfig, err)\n119|\t\t}\n120|\t\tif err := checkPrintableBound(metadata.DisplayName, 1, MaxDisplayNameRunes, \"host display name\"); err != nil {\n121|\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n122|\t\t}\n123|\t}\n124|\tfor session, observations := range reader.Observations {\n125|\t\tif _, err := scalar.ParseUUIDv7(session); err != nil {\n126|\t\t\treturn fmt.Errorf(\"%w: malformed observation session ID: %v\", ErrInvalidConfig, err)\n127|\t\t}\n128|\t\tif observations.NewestCheckpointCreatedAt != nil {\n129|\t\t\tif _, err := time.Parse(time.RFC3339, *observations.NewestCheckpointCreatedAt); err != nil {\n130|\t\t\t\treturn fmt.Errorf(\"%w: malformed checkpoint timestamp: %v\", ErrInvalidConfig, err)\n131|\t\t\t}\n132|\t\t}\n133|\t\tfor _, capability := range observations.Capabilities {\n134|\t\t\tif err := checkPrintableBound(capability, 1, MaxCapabilityRunes, \"capability\"); err != nil {\n135|\t\t\t\treturn fmt.Errorf(\"%w: %v\", ErrInvalidConfig, err)\n136|\t\t\t}\n137|\t\t}\n138|\t}\n139|\treturn nil\n140|}\n141|\n142|// checkPrintableBound enforces valid UTF-8 with 1..max printable\n143|// non-control runes without normalizing or folding the value.\n144|func checkPrintableBound(value string, min, max int, what string) error {\n145|\tif !utf8.ValidString(value) {\n146|\t\treturn fmt.Errorf(\"%s is not valid UTF-8\", what)\n147|\t}\n148|\tcount := utf8.RuneCountInString(value)\n149|\tif count < min || count > max {\n150|\t\treturn fmt.Errorf(\"%s carries %d characters, want %d-%d\", what, count, min, max)\n151|\t}\n152|\tfor _, character := range value {\n153|\t\tif unicode.IsControl(character) || !unicode.IsPrint(character) {\n154|\t\t\treturn fmt.Errorf(\"%s carries a non-printable character\", what)\n155|\t\t}\n156|\t}\n157|\treturn nil\n158|}\n159|\n160|// AuthoritativeStatus resolves one selector through the shared path\n161|// and returns its closed authoritative summary. Resolution,\n162|// read-failure, and bootstrap refusals behave exactly as Status;\n163|// host and observation facts then bind or refuse as documented above.\n164|func (reader *Reader) AuthoritativeStatus(selector string) (AuthoritativeSummary, error) {\n165|\tsummary, err := reader.Status(selector)\n166|\tif err != nil {\n167|\t\treturn AuthoritativeSummary{}, err\n168|\t}\n169|\tif err := reader.validatedAuthorityInputs(); err != nil {\n170|\t\treturn AuthoritativeSummary{}, err\n171|\t}\n172|\treturn reader.authorize(summary)\n173|}\n174|\n175|// AuthoritativeList returns the closed authoritative summaries for\n176|// the local index in bytewise session-ID order. The whole document\n177|// refuses when any encountered record cannot be represented\n178|// truthfully — including one incomplete record in an otherwise\n179|// healthy listing — and no record is silently omitted.\n180|func (reader *Reader) AuthoritativeList() ([]AuthoritativeSummary, error) {\n181|\trows, err := reader.List()\n182|\tif err != nil {\n183|\t\treturn nil, err\n184|\t}\n185|\tif err := reader.validatedAuthorityInputs(); err != nil {\n186|\t\treturn nil, err\n187|\t}\n188|\tout := make([]AuthoritativeSummary, 0, len(rows))\n189|\tfor _, row := range rows {\n190|\t\tsummary, err := reader.authorize(row)\n191|\t\tif err != nil {\n192|\t\t\treturn nil, err\n193|\t\t}\n194|\t\tout = append(out, summary)\n195|\t}\n196|\treturn out, nil\n197|}\n198|\n199|// authorize binds one projected row to its closed authoritative\n200|// summary against the validated host and observation inputs. Every\n201|// refusal names the missing established fact; nothing is inferred.\n202|func (reader *Reader) authorize(summary Summary) (AuthoritativeSummary, error) {\n203|\tprojection := summary.Projection\n204|\tif err := checkSummaryRepresentable(summary); err != nil {\n205|\t\treturn AuthoritativeSummary{}, err\n206|\t}\n207|\tif reader.LocalHostID == \"\" {\n208|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local host identity is required to establish the local role\", ErrObservationUnavailable)\n209|\t}\n210|\tmetadata, ok := reader.HostMetadata[projection.OwnerHostID]\n211|\tif !ok {\n212|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: host metadata for owner %s cannot be established\", ErrObservationUnavailable, projection.OwnerHostID)\n213|\t}\n214|\tif projection.LocalRole == \"\" {\n215|\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: local role for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n216|\t}\n217|\tauthorized := AuthoritativeSummary{\n218|\t\tSessionID:     projection.SessionID,\n219|\t\tName:          projection.Name,\n220|\t\tKind:          projection.Kind,\n221|\t\tProviderID:    projection.Provider.ID,\n222|\t\tState:         string(projection.State),\n223|\t\tOwnerHostID:   projection.OwnerHostID,\n224|\t\tOwnerHostName: metadata.DisplayName,\n225|\t\tLeaseEpoch:    projection.Winner.Epoch,\n226|\t\tLeaseID:       projection.Winner.LeaseID,\n227|\t\tLocalRole:     projection.LocalRole,\n228|\t}\n229|\tobservations := reader.Observations[projection.SessionID]\n230|\tif projection.HasCheckpoint {\n231|\t\tcheckpoint := projection.Newest.ID\n232|\t\tauthorized.HasCheckpoint = true\n233|\t\tauthorized.NewestCheckpointID = &checkpoint\n234|\t\tif observations.NewestCheckpointCreatedAt == nil {\n235|\t\t\treturn AuthoritativeSummary{}, fmt.Errorf(\"%w: checkpoint timestamp for session %s cannot be established\", ErrObservationUnavailable, projection.SessionID)\n236|\t\t}\n237|\t\tstamp := *observations.NewestCheckpointCreatedAt\n238|\t\tauthorized.NewestCheckpointCreatedAt = &stamp\n239|\t}\n240|\tauthorized.ProcessPresent = observations.ProcessPresent\n241|\tauthorized.Capabilities = observations.Capabilities\n242|\tauthorized.WorkspacePresent = observations.WorkspacePresent\n243|\treturn authorized, nil\n244|}"