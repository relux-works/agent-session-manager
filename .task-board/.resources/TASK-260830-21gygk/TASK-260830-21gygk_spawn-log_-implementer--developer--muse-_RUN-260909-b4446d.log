{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb57","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":1030,"recorded_at":1780531400002055,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a0886e-2da1-75b1-ab57-e3b50dd56867"},"task_id":"01a0886e-2da1-75b1-ab57-e3b50dd56867","event":{"kind":"output","task_id":"01a0886e-2da1-75b1-ab57-e3b50dd56867","chunk":"Read text file `internal/canonicaljson/core_records_test.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n13|)\n14|\n15|const (\n16|\thostID      = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n17|\tpeerHostID  = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n18|\tworkspaceID = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n19|\tgroupID     = \"0198f4c8-5b20-7c33-8c4d-1234567890ab\"\n20|\tleaseID     = \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"\n21|\tpriorLease  = \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\"\n22|)\n23|\n24|func TestCoreRecordFixturesReachBothIdentityProductionEntries(t *testing.T) {\n25|\tfixtures := []struct {\n26|\t\tname      string\n27|\t\tselfField SelfField\n28|\t\tobject    map[string]any\n29|\t}{\n30|\t\t{\"lease\", SelfRecordID, validLeaseRecordObject()},\n31|\t\t{\"checkpoint direct\", SelfCheckpointID, validCheckpointRecordObject(true)},\n32|\t\t{\"checkpoint task board\", SelfCheckpointID, validCheckpointRecordObject(false)},\n33|\t\t{\"provider identity\", SelfRecordID, validProviderIdentityRecordObject()},\n34|\t\t{\"workspace group\", SelfRecordID, validWorksp