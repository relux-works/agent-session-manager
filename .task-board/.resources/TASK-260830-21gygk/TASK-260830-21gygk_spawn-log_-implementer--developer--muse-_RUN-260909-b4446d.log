{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d3a5","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":2093,"recorded_at":1780531400004181,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a08871-9b29-7330-a528-dbebcdd4eb86"},"task_id":"01a08871-9b29-7330-a528-dbebcdd4eb86","event":{"kind":"output","task_id":"01a08871-9b29-7330-a528-dbebcdd4eb86","chunk":"Read text file `internal/sessquery/plan_test.go`.\n(239 line(s) above)\n240|\t\tt.Fatalf(\"unknown-host local build = %v, want invalid_config\", err)\n241|\t}\n242|\tpeer, _ := repository(t)\n243|\tref := create(t, peer, idB, \"beta\")\n244|\tappendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n245|\treader.AllowlistedPeerIDs = []string{hostA}\n246|\treader.Peers = []PeerIndex{{hostA, peer}}\n247|\treader.Aliases = map[string]string{hostA: \"workstation\"}\n248|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:workstation\", Action: ActionStatus})\n249|\tif plan.SourceHostID != hostA {\n250|\t\tt.Fatalf(\"peer source without local host: %+v\", plan)\n251|\t}\n252|\tif err := reader.Revalidate(plan); err != nil {\n253|\t\tt.Fatalf(\"peer plan without local host is not current: %v\", err)\n254|\t}\n255|}\n256|\n257|func TestBuildPlanArgumentGates(t *testing.T) {\n258|\treader, _, _, _ := plannedSession(t)\n259|\tfor _, args := range []PlanArgs{\n260|\t\t{Selector: \"alpha\", Action: \"launch\"},\n261|\t\t{Selector: \"alpha\", Action: \"\"},\n262|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: \"not-a-uuid\"},\n263|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: lease},\n264|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`{bad`)},\n265|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`[1]`)},\n266|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`\"str\"`)},\n267|\t\t{Selector: \"alpha@unknown\", Action: ActionStatus},\n268|\t\t{Selector: \"\", Action: ActionStatus},\n269|\t} {\n270|\t\tif _, err := reader.BuildPlan(args); !errors.Is(err, ErrInvalidArgument) {\n271|\t\t\tt.Fatalf(\"BuildPlan(%+v) = %v, want invalid_arguments\", args, err)\n272|\t\t}\n273|\t}\n274|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\"}); !errors.Is(err, ErrInvalidArgument) {\n275|\t\tt.Fatalf(\"missing action: %v\", err)\n276|\t}\n277|}\n278|\n279|func TestPlanDigestAndMarshalRoundTrip(t *testing.T) {\n280|\treader, _, _, _ := plannedSession(t)\n281|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionDiff})\n282|\tfirst, err := plan.Digest()\n283|\tif err != nil {\n284|\t\tt.Fatal(err)\n285|\t}\n286|\tsecond, err := plan.Digest()\n287|\tif err != nil || first != second {\n288|\t\tt.Fatalf(\"digest unstable: %q %q %v\", first, second, err)\n289|\t}\n290|\traw, err := plan.Marshal()\n291|\tif err != nil {\n292|\t\tt.Fatal(err)\n293|\t}\n294|\tparsed, err := ParsePlan(raw)\n295|\tif err != nil {\n296|\t\tt.Fatal(err)\n297|\t}\n298|\tif !reflect.DeepEqual(plan, parsed) {\n299|\t\tt.Fatalf(\"round trip diverged:\\n%+v\\n%+v\", plan, parsed)\n300|\t}\n301|\t// Tampering with any member breaks the locally verified digest.\n302|\tvar wire map[string]any\n303|\tif err := json.Unmarshal(raw, &wire); err != nil {\n304|\t\tt.Fatal(err)\n305|\t}\n306|\twire[\"action\"] = ActionAttach\n307|\ttampered, err := json.Marshal(wire)\n308|\tif err != nil {\n309|\t\tt.Fatal(err)\n310|\t}\n311|\tif _, err := ParsePlan(tampered); !errors.Is(err, ErrInvalidArgument) {\n312|\t\tt.Fatalf(\"tampered plan parsed: %v\", err)\n313|\t}\n314|\tif _, err := ParsePlan([]byte(`{broken`)); !errors.Is(err, ErrInvalidArgument) {\n315|\t\tt.Fatalf(\"malformed encoding: %v\", err)\n316|\t}\n317|\t// A valid persisted encoding is never authority by itself: current\n318|\t// facts still decide through Revalidate.\n319|\traw, err = plan.Marshal()\n320|\tif err != nil {\n321|\t\tt.Fatal(err)\n322|\t}\n323|\tparsed, err = ParsePlan(raw)\n324|\tif err != nil {\n325|\t\tt.Fatal(err)\n326|\t}\n327|\tappendEvent(t, reader.Local, idA, parsed.AuthorityHeads[0], \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n328|\tif err := reader.Revalidate(parsed); !errors.Is(err, ErrPlanStale) {\n329|\t\tt.Fatalf(\"persisted digest overrode current facts: %v\", err)\n330|\t}\n331|}\n332|\n333|func TestRevalidateDetectsEachFactChange(t *testing.T) {\n334|\tt.Run(\"same lease event changes heads\", func(t *testing.T) {\n335|\t\treader, _, _, _ := plannedSession(t)\n336|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n337|\t\ttail := plan.AuthorityHeads[0]\n338|\t\tappendEvent(t, reader.Local, idA, tail, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n339|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n340|\t})\n341|\tt.Run(\"successor lease changes winner\", func(t *testing.T) {\n342|\t\treader, _, _, created := plannedSession(t)\n343|\t\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n344|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n345|\t\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n346|\t\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n347|\t\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n348|\t\t})\n349|\t\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n350|\t})\n351|\tt.Run(\"record replacement changes digest\", func(t *testing.T) {\n352|\t\treader, root, _, _ := plannedSession(t)\n353|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n354|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), record(t, idA, \"renamed\"), 0o600); err != nil {\n355|\t\t\tt.Fatal(err)\n356|\t\t}\n357|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n358|\t})\n359|\tt.Run(\"alias remap changes binding\", func(t *testing.T) {\n(more lines below)","final_result":true}}}
