{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9f1","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":851,"recorded_at":1780531400001697,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886c9905795087aa789ce4fd5439","text":"Read text file `internal/sessquery/bounds_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/cliresult\"\n8|)\n9|\n10|// This is a measured integration bound, not a successful public list claim.\n11|// Pinned Section 5.7 defines creating as a Session Record AND an\n12|// authoritative initial lease, and Section 13.1 step 2 persists the\n13|// initial Lease Record and session.created before process creation: a\n14|// record alone proves identity and provenance, never creation of an\n15|// owner or a creating lifecycle. A record-only chain is therefore an\n16|// interrupted persistence prefix awaiting the bootstrap-recovery leaf\n17|// (Section 14.7.4), not a completed bootstrap prefix, and the list\n18|// entry refuses it with selector_bootstrap_incomplete instead of\n19|// returning a row with empty owner/lease facts. The wire owner still\n20|// requires known owner/lease fields: the read layer must not invent\n21|// them to obtain green JSON, and no nullable or placeholder owner or\n22|// lease field is authorized to close the gap.\n23|func TestCreatingSummaryCannotClaimClosedCLIResult(t *testing.T) {\n24|\trepo, _ := repository(t)\n25|\tcreate(t, repo, idA, \"Creating\")\n26|\t// The production list entry refuses the interrupted prefix; no\n27|\t// partial row escapes for a caller to render.\n28|\tif _, err := (&Reader{Local: repo}).List(); !errors.Is(err, ErrBootstrapIncomplete) {\n29|\t\tt.Fatalf(\"record-only list = %v, want selector_bootstrap_incomplete\", err)\n30|\t}\n31|\tif _, err := (&Reader{Local: repo}).Status(\"Creating\"); !errors.Is(err, ErrBootstrapIncomplete) {\n32|\t\tt.Fatalf(\"record-only status = %v, want selector_bootstrap_incomplete\", err)\n33|\t}\n34|\t// The ownerless shape still cannot satisfy the mandatory CLI\n35|\t// owner/lease fields, even hand-built outside the refused entry.\n36|\tbody := map[string]any{\n37|\t\t\"session_id\": idA, \"name\": \"Creating\", \"kind\": \"direct\", \"provider_id\": \"codex\",\n38|\t\t\"owner_host_id\": \"\", \"owner_host_name\": \"\", \"lease_epoch\": uint64(0), \"lease_id\": \"\",\n39|\t\t\"local_role\": \"\", \"state\": \"creating\", \"newest_checkpoint_id\": nil, \"newest_checkpoint_created_at\": nil,\n40|\t\t\"workspace_status\": \"absent\", \"capabilities\": map[string]any{}, \"warnings\": []string{},\n41|\t}\n42|\t// The fixture's absent workspace is controlled only for this shape probe;\n43|\t// it is not a production observation or a default in Reader.\n44|\tif _, err := cliresult.New(cliresult.Spec{Command: cliresult.CommandList, Body: map[string]any{\n45|\t\t\"sessions\": []any{body}, \"partial\": false, \"unreachable_peer_ids\": []string{},\n46|\t}}); !errors.Is(err, cliresult.ErrInvalidResult) {\n47|\t\tt.Fatalf(\"unknown owner represented as CLI success: %v\", err)\n48|\t}\n49|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9f3","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":852,"recorded_at":1780531400001699,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886c99c176c2a306ddbde466969d","text":"Read text file `internal/sessquery/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessquery/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each gate by narrowing, never by deletion: every N-\n6|mutant keeps its gate present and weakens it to admit exactly one member\n7|of the class the gate must reject, and a named behavioral test must fail.\n8|Grammar mutants preserve the searched-for token while changing behavior,\n9|and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessquery/query.go'\n30|base = source.read_text()\n31|selector_source = copy / 'internal/sessquery/selector.go'\n32|selector_base = selector_source.read_text()\n33|revalidate_source = copy / 'internal/sessquery/revalidate.go'\n34|revalidate_base = revalidate_source.read_text()\n35|plan_source = copy / 'internal/sessquery/plan.go'\n36|plan_base = plan_source.read_text()\n37|summary_source = copy / 'internal/sessquery/summary.go'\n38|summary_base = summary_source.read_text()\n39|repo_source = copy / 'internal/sessrepo/store.go'\n40|repo_base = repo_source.read_text()\n41|results = []\n42|\n43|IDA = '0198f4c8-3e70-7a11-8a2b-1234567890ab'\n44|IDB = '0198f4c8-3e70-7a11-8a2b-1234567890ac'\n45|HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\n46|HOSTB = '0198f4c8-4a10-7b22-8b3c-1234567890ac'\n47|HOSTC = '0198f4c8-4a10-7b22-8b3c-1234567890ad'\n48|LEASEB = 'bbbbbbbb-cccc-4ddd-8eee-ffffffffffff'\n49|\n50|def run(name, path, old, new, narrow):\n51|    original = path.read_text()\n52|    if original.count(old) != 1:\n53|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n54|        return\n55|    path.write_text(original.replace(old, new))\n56|    command = ['go', 'test', './internal/sessquery', './internal/sessrepo', '-count=1', '-v']\n57|    try:\n58|        with (output / (name + '.log')).open('w') as log:\n59|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n60|        text = (output / (name + '.log')).read_text()\n61|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n62|        classification = 'SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE')\n63|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n64|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n65|    finally:\n66|        path.write_text(original)\n67|        assert hashlib.sha256(path.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n68|\n69|with (output / 'control-before.log').open('w') as log:\n70|    before = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=180)\n71|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n72|if before.returncode:\n73|    raise SystemExit('baseline failed')\n74|run('N-collision-pair',source,'if len(ids) > 1 {','if len(ids) > 2 {','Allow exactly a two-identity folded bucket; larger buckets still refuse.')\n75|run('N-case-variant',source,'if item.summary.Projection.Name == selector && exact == nil {','if (item.summary.Projection.Name == selector || selector == \"az-09._\") && exact == nil {','Allow the sole non-exact query az-09._ within its folded bucket.')\n76|run('N-parked-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if (row.Projection.Parked != nil && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") || row.Projection.State == sessstate.StateTombstoned {','Allow one parked session identity into live resolution.')\n77|run('N-tombstoned-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if row.Projection.Parked != nil || (row.Projection.State == sessstate.StateTombstoned && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") {','Allow one tombstoned session identity into live resolution.')\n78|run('N-unlisted-peer',source,'ids := append([]string(nil), reader.AllowlistedPeerIDs...)\\n\\tsort.Strings(ids)\\n\\tvar out []candidate','ids := append([]string(nil), reader.AllowlistedPeerIDs...)\\n\\tids = append(ids, \"0198f4c8-4a10-7b22-8b3c-1234567890ab\")\\n\\tsort.Strings(ids)\\n\\tvar out []candidate','Read one peer outside the allowlist; all other peer identities still filtered.')\n79|run('N-duplicate-peer',source,'if found {','if found && id != \"0198f4c8-4a10-7b22-8b3c-1234567890ab\" {','Permit duplicate sources for one peer identity, retain duplicate refusal for other identities.')\n80|run('N-read-failure-fallback',source,'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}', 'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, sessrepo.ErrRepositoryPath) { return []Summary{}, nil }; return nil, err\\n\\t}', 'Treat repository-path read failure as empty, while retaining other read refusals.')\n81|run('N-projection-failure-fallback',source,'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}', 'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\tif row.SessionID == \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" { continue }; return nil, err\\n\\t\\t}', 'Omit one identity on failed projection instead of propagating its failure.')\n82|run('N-repository-case-variant',repo_source,'if len(folded) == 1 && folded[0].Name == query {','if len(folded) == 1 && (folded[0].Name == query || query == \"Payments-API\") {','Allow one non-exact query at the retained repository Resolve entry.')\n83|run('N-first-at-split',selector_source,'key, source, qualified := strings.Cut(argument, \"@\")','key, source, qualified := argument, \"\", false\\n\\tif at := strings.LastIndexByte(argument, \\'@\\'); at >= 0 {\\n\\t\\tkey, source, qualified = argument[:at], argument[at+1:], true\\n\\t}','Split at the last @ while keeping the @ token; an alias containing @ then misroutes.')\n84|run('N-local-prefix',selector_source,'\\tcase source == \"local\":','\\tcase strings.HasPrefix(source, \"local\"):','Admit local-prefixed sources while keeping the local token; localX then selects local.')\n85|run('N-id-case',selector_source,'\\tif id, ok := strings.CutPrefix(key, \"id:\"); ok {\\n\\t\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','\\tlowered := strings.ToLower(key)\\n\\tif id, ok := strings.CutPrefix(lowered, \"id:\"); ok {\\n\\t\\tif _, err := scalar.ParseUUIDv7(id); err != nil {','Fold the id: key prefix while keeping its token; ID: then bypasses names.')\n86|run('N-peer-alias-fold',selector_source,'if config.aliasOf[peer.HostID] == alias && alias != \"\" {','if asciiFold(config.aliasOf[peer.HostID]) == asciiFold(alias) && alias != \"\" {','Fold alias comparison while keeping exact mapping storage; WORK then selects Work.')\n87|run('N-id-through-names',source,'\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)','\\tif match, found, err := matchName(live, strings.TrimPrefix(parsed.Key, \"id:\")); found || err != nil {\\n\\t\\treturn match, err\\n\\t}\\n\\treturn selectIdentity(strings.TrimPrefix(parsed.Key, \"id:\"), live, config)','Route one explicit id: key through the name tier first; a UUID-shaped name then shadows the identity.')\n88|run('N-explicit-fallback',source,'\\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q in source %s\", ErrNotFound, parsed.Key, describeSource(parsed))','\\treturn reader.resolveBare(Selector{Raw: parsed.Raw, Key: parsed.Key, UUIDShaped: parsed.UUIDShaped, Source: SourceBare}, config)','Fall back to the bare union on exactly an explicit-source miss; a locally present name then resolves.')\n89|run('N-unknown-alias-local',source,'\\t\\t\\treturn nil, \"\", fmt.Errorf(\"%w: no configured source for alias %q\", ErrSourceNotFound, parsed.SourceValue)','\\t\\t\\treturn reader.Local, \"\", nil','Treat exactly an unknown alias as the local source; a locally present name then resolves.')\n90|run('N-disallowed-admit',source,'\\t\\t\\treturn nil, \"\", fmt.Errorf(\"%w: peer %s is not allowlisted\", ErrPeerNotAllowlisted, host)','\\t\\t\\treturn reader.peerRepo(host)','Admit exactly one disallowed peer past the allowlist into its index read.')\n91|run('N-dup-alias',selector_source,'\\t\\t\\treturn config, fmt.Errorf(\"%w: duplicate source mapping for alias %q\", ErrInvalidConfig, alias)','\\t\\t\\tseenAliases[alias] = struct{}{}','Admit exactly duplicate alias mappings with last-write-wins instead of refusing them.')\n92|run('N-identity-diverge',source,'\\tfor _, item := range matches[1:] {\\n\\t\\tif item.summary.Projection.RecordID != matches[0].summary.Projection.RecordID {','\\tfor _, item := range matches[1:] {\\n\\t\\tif item.summary.Projection.RecordID != matches[0].summary.Projection.RecordID && id.String() != \"' + IDA + '\" {','Admit exactly the idA cross-copy record disagreement in the identity tier; other identities still refuse integrity_failure.')\n93|run('N-agreement-name',source,'\\t\\tif item.summary.Projection.RecordID != digest {','\\t\\tif item.summary.Projection.RecordID != digest && item.selection.SessionID != \"' + IDA + '\" {','Admit exactly the idA cross-copy record disagreement behind a name win; other identities still refuse integrity_failure.')\n94|run('N-rev-revocation',revalidate_source,'\\t\\tif _, allowed := config.allowed[peerHost]; !allowed {','\\t\\tif _, allowed := config.allowed[peerHost]; !allowed && peerHost != \"' + HOSTA + '\" {','Admit exactly the revoked hostA peer past revocation; the refusal degrades to stale configuration.')\n95|run('N-rev-config',revalidate_source,'\\tif configuration != plan.ConfigurationDigest {','\\tif configuration != plan.ConfigurationDigest && reader.Aliases[\"' + HOSTC + '\"] != \"ws\" {','Admit exactly the ws-alias configuration for hostC; other configuration changes still refuse.')\n96|run('N-rev-binding',revalidate_source,'\\tif !bindingHolds(plan, config, reader) {','\\tif !bindingHolds(plan, config, reader) && config.aliasFor(\"' + HOSTB + '\") != \"ws\" {','Admit exactly the ws remap onto hostB; other binding changes still refuse.')\n97|run('N-rev-index',revalidate_source,'\\tif index != plan.SourceIndexDigest {','\\tindexAdmitted := false\\n\\tfor _, row := range rows {\\n\\t\\tif row.Projection.SessionID == \"' + IDB + '\" {\\n\\t\\t\\tindexAdmitted = true\\n\\t\\t}\\n\\t}\\n\\tif index != plan.SourceIndexDigest && !indexAdmitted {','Admit exactly an index containing session idB; other index changes still refuse.')\n98|run('N-rev-record',revalidate_source,'\\tif recordID != plan.SessionRecordID {','\\trecordParked := false\\n\\tfor _, row := range rows {\\n\\t\\tif row.Projection.SessionID == plan.SessionID && row.Projection.Parked != nil {\\n\\t\\t\\trecordParked = true\\n\\t\\t}\\n\\t}\\n\\tif recordID != plan.SessionRecordID && !recordParked {','Admit exactly the parked chain-mismatch record presented by the replacement fixture; the refusal degrades to the lease reason.')\n99|run('N-rev-lease',revalidate_source,'\\tif projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID {\\n\\t\\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\\n\\t}\\n\\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif leaseRecordID != plan.LeaseRecordID {','\\tif (projection.Winner.Epoch != plan.LeaseEpoch || projection.Winner.LeaseID != plan.LeaseID || projection.OwnerHostID != plan.OwnerHostID) && projection.Winner.LeaseID != \"' + LEASEB + '\" {\\n\\t\\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\\n\\t}\\n\\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, projection.Winner.Epoch, projection.Winner.LeaseID, projection.OwnerHostID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif leaseRecordID != plan.LeaseRecordID && projection.Winner.LeaseID != \"' + LEASEB + '\" {','Admit exactly the leaseB successor at the plan source, triple and attestation together; the refusal degrades to the heads reason.')\n100|run('N-rev-heads',revalidate_source,'\\tif !equalStrings(heads, plan.AuthorityHeads) {','\\tchain, _ := repo.ListEvents(plan.SessionID)\\n\\tif !equalStrings(heads, plan.AuthorityHeads) && len(chain) != 2 {','Admit exactly a two-event chain at the heads compare; the refusal degrades to the index reason.')\n101|run('N-rev-absent-substitute',revalidate_source,'\\tif absent {','\\tif absent && len(rows) > 0 {\\n\\t\\trecordID = rows[0].Projection.RecordID\\n\\t\\tplan.SessionID = rows[0].Projection.SessionID\\n\\t}\\n\\tif absent && len(rows) == 0 {','Substitute the first listed sibling for exactly a deleted selection instead of reporting its absence.')\n102|run('N-union-record',revalidate_source,'\\t\\tif row.Projection.State == sessstate.StateTombstoned {\\n\\t\\t\\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\\n\\t\\t}\\n\\t\\tif row.Projection.RecordID != plan.SessionRecordID {','\\t\\tif row.Projection.State == sessstate.StateTombstoned {\\n\\t\\t\\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\\n\\t\\t}\\n\\t\\tif row.Projection.RecordID != plan.SessionRecordID && row.Projection.SessionID != \"' + IDB + '\" {','Admit exactly the idB cross-source record disagreement in the union check; other contradictions still refuse.')\n103|run('N-union-lease',revalidate_source,'\\t\\tif row.Projection.Winner.Epoch != plan.LeaseEpoch || row.Projection.Winner.LeaseID != plan.LeaseID || row.Projection.OwnerHostID != plan.OwnerHostID {\\n\\t\\t\\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\\n\\t\\t}\\n\\t\\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, row.Projection.Winner.Epoch, row.Projection.Winner.LeaseID, row.Projection.OwnerHostID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tif leaseRecordID != plan.LeaseRecordID {','\\t\\tif (row.Projection.Winner.Epoch != plan.LeaseEpoch || row.Projection.Winner.LeaseID != plan.LeaseID || row.Projection.OwnerHostID != plan.OwnerHostID) && row.Projection.Winner.LeaseID != \"' + LEASEB + '\" {\\n\\t\\t\\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\\n\\t\\t}\\n\\t\\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, row.Projection.Winner.Epoch, row.Projection.Winner.LeaseID, row.Projection.OwnerHostID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tif leaseRecordID != plan.LeaseRecordID && row.Projection.Winner.LeaseID != \"' + LEASEB + '\" {','Admit exactly the leaseB cross-source successor, triple and attestation together; other lease contradictions still refuse.')\n104|run('N-union-tombstone',revalidate_source,'\\t\\t\\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)','\\t\\tif row.Projection.SessionID != \"' + IDB + '\" {\\n\\t\\t\\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\\n\\t\\t}','Admit exactly the idB cross-source tombstone; other tombstone evidence still refuses.')\n105|run('N-plan-bootstrap',plan_source,'\\tif projection.Winner.IsZero() {\\n\\t\\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)','\\tif projection.Winner.IsZero() && selected.SessionID != \"' + IDA + '\" {\\n\\t\\treturn SelectionPlan{}, fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, selected.SessionID)','Admit exactly record-only idA past the build bootstrap gate; the shape backstop still refuses it with invalid_arguments.')\n106|run('N-plan-source-host',plan_source,'\\t\\tif config.localHost == \"\" {\\n\\t\\t\\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)','\\t\\tif config.localHost == \"\" && selected.SessionID != \"' + IDA + '\" {\\n\\t\\t\\treturn SelectionPlan{}, fmt.Errorf(\"%w: local host identity is required to bind a local plan source\", ErrInvalidConfig)','Admit exactly idA past the local-host gate; the shape backstop still refuses the empty source host with invalid_arguments.')\n107|run('N-summary-bootstrap',summary_source,'\\tif projection.Winner.IsZero() {\\n\\t\\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)','\\tif projection.Winner.IsZero() && projection.SessionID != \"' + IDA + '\" {\\n\\t\\treturn fmt.Errorf(\"%w: complete authority read proves record %s without any valid lease\", ErrBootstrapIncomplete, projection.SessionID)','Admit exactly record-only idA into list/status summaries; other interrupted prefixes still refuse.')\n108|run('N-observation-host',summary_source,'\\tmetadata, ok := reader.HostMetadata[projection.OwnerHostID]\\n\\tif !ok {','\\tmetadata, ok := reader.HostMetadata[projection.OwnerHostID]\\n\\tif !ok && projection.OwnerHostID != \"' + HOSTA + '\" {','Admit exactly owner hostA without host metadata; other missing owners still refuse observation_unavailable.')\n109|run('B-peer-order',source,'\\tsort.Strings(ids)\\n\\tvar out []candidate','\\tsort.Sort(sort.Reverse(sort.StringSlice(ids)))\\n\\tvar out []candidate','Reverse peer-source tie ordering; behavioral determinism fixture must fail.')\n110|run('B-session-order',source,'return out[i].Projection.SessionID < out[j].Projection.SessionID','return out[i].Projection.SessionID > out[j].Projection.SessionID','Reverse session output order; behavioral list fixture must fail.')\n111|run('B-tie-break',source,') < holderHost(best.selection',') > holderHost(best.selection','Reverse the identical-copy host tie break; the deterministic selection fixture must fail.')\n112|run('C-not-applied',source,'TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n113|run('C-compile-failure',source,'package sessquery','package sessquery\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n114|with (output / 'control-after.log').open('w') as log:\n115|    after = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,ti