{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d227","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":1902,"recorded_at":1780531400003799,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"task_stream":{"kind":"task","id":"01a08871-3b82-7450-af65-af4e9a1742c4"},"task_id":"01a08871-3b82-7450-af65-af4e9a1742c4","event":{"kind":"output","task_id":"01a08871-3b82-7450-af65-af4e9a1742c4","chunk":"edited\nchanged lines: lines 75-86\n--- original\n+++ updated\n@@\n-// plannedSession builds a local session with its bootstrap event and\n-// returns the reader, roots, record digest, and created event ID. The\n-// reader carries the known local host identity every local plan\n-// requires for its source binding.\n-func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n-\tt.Helper()\n-\tlocal, root := repository(t)\n-\tref := create(t, local, idA, \"alpha\")\n-\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n-\treader := &Reader{Local: local, LocalHostID: hostA}\n-\treturn reader, root, ref, created\n-}\n+// plannedSession builds a local session with its bootstrap event and\n+// validated initial Lease Record, returning the reader, roots, record\n+// digest, and created event ID. The reader carries the known local\n+// host identity every local plan requires for its source binding, plus\n+// the winning lease authority every plan requires.\n+func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n+\tt.Helper()\n+\tlocal, root := repository(t)\n+\tref := create(t, local, idA, \"alpha\")\n+\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n+\treader := &Reader{Local: local, LocalHostID: hostA}\n+\twithLeases(reader, leaseCreate(t, idA, hostA))\n+\treturn reader, root, ref, created\n+}\n","final_result":true}}}
