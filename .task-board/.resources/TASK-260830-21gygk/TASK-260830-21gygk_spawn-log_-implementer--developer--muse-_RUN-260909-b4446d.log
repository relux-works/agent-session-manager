{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c1","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":571,"recorded_at":1780531400001137,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886bd6f9785099588d85d09d8c2d","text":"Read text file `internal/sessstate/sessstate.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// SessionState spellings in SPEC.md Section 5.7 declared order. Every\n13|// RPC and CLI field typed SessionState uses exactly this registry; the\n14|// spellings created, starting, and quiesced are not session lifecycle\n15|// states. The const block below is the single production source of the\n16|// registry: no other production literal may name a state spelling, so\n17|// the census derives the state space from these lines.\n18|const (\n19|\tStateCreating      State = \"creating\"\n20|\tStateRunning       State = \"running\"\n21|\tStateIdle          State = \"idle\"\n22|\tStateQuiescing     State = \"quiescing\"\n23|\tStateCheckpointing State = \"checkpointing\"\n24|\tStateStopped       State = \"stopped\"\n25|\tStateMaterializing State = \"materializing\"\n26|\tStateParked        State = \"parked\"\n27|\tStateFailed        State = \"failed\"\n28|\tStateStale         State = \"stale\"\n29|\tStateTombstoned    State = \"tombstoned\"\n30|)\n31|\n32|// State is one Section 5.7 lifecycle value.\n33|type State string\n34|\n35|// States returns the SessionState registry in Section 5.7 declared\n36|// order. It converts the const block above instead of retyping the\n37|// spellings, so every state literal lives exactly once in production\n38|// and the census can require that single source. Callers must not\n39|// invent spellings beside this list.\n40|func States() []string {\n41|\treturn []string{\n42|\t\tstring(StateCreating), string(StateRunning), string(StateIdle),\n43|\t\tstring(StateQuiescing), string(StateCheckpointing),\n44|\t\tstring(StateStopped), string(StateMaterializing),\n45|\t\tstring(StateParked), string(StateFailed), string(StateStale),\n46|\t\tstring(StateTombstoned),\n47|\t}\n48|}\n49|\n50|// allowedTransitions is the Section 5.7 transition table, the single\n51|// source the step gate enforces. A same-state restatement (a confirming\n52|// event while already in the target state) is not a transition and\n53|// needs no edge; every other move needs exactly the edge below.\n54|var allowedTransitions = map[State]map[State]struct{}{\n55|\tStateCreating: {\n56|\t\tStateRunning: {}, StateIdle: {}, StateFailed: {},\n57|\t},\n58|\tStateRunning: {\n59|\t\tStateIdle: {}, StateQuiescing: {}, StateFailed: {}, StateStale: {},\n60|\t},\n61|\tStateIdle: {\n62|\t\tStateRunning: {}, StateQuiescing: {}, StateCheckpointing: {},\n63|\t\tStateStopped: {}, StateStale: {},\n64|\t},\n65|\tStateQuiescing: {\n66|\t\tStateIdle: {}, StateCheckpointing: {}, StateFailed: {}, StateStale: {},\n67|\t},\n68|\tStateCheckpointing: {\n69|\t\tStateIdle: {}, StateStopped: {}, StateMaterializing: {}, StateFailed: {},\n70|\t},\n71|\tStateMaterializing: {\n72|\t\tStateStopped: {}, StateRunning: {}, StateParked: {}, StateFailed: {},\n73|\t},\n74|\tStateStopped: {\n75|\t\tStateMaterializing: {}, StateRunning: {}, StateParked: {}, StateTombstoned: {},\n76|\t},\n77|\tStateParked: {\n78|\t\tStateMaterializing: {}, StateRunning: {}, StateStopped: {}, StateStale: {},\n79|\t},\n80|\tStateFailed: {\n81|\t\tStateCreating: {}, StateStopped: {}, StateParked: {},\n82|\t\tStateMaterializing: {}, StateStale: {}, StateTombstoned: {},\n83|\t},\n84|\tStateStale: {\n85|\t\tStateStopped: {}, StateTombstoned: {},\n86|\t},\n87|}\n88|\n89|// initialTargets bounds the first event of a chain: a session opens in\n90|// one of these states, and only through its bootstrap event. Any other\n91|// first event is invalid_state_transition, not a silent default.\n92|var initialTargets = map[State]struct{}{\n93|\tStateCreating: {}, StateRunning: {}, StateIdle: {}, StateFailed: {},\n94|}\n95|\n96|// staleSources bounds the local-stale override the same way the table\n97|// bounds every other move into stale: the override applies only when\n98|// the winner projection stands in a state the table lets go stale,\n99|// otherwise the winner state stands with the lease conflict recorded.\n100|var staleSources = map[State]struct{}{\n101|\tStateRunning: {}, StateIdle: {}, StateQuiescing: {},\n102|\tStateFailed: {}, StateParked: {},\n103|}\n104|\n105|var (\n106|\tErrInvalidRecord     = errors.New(\"invalid session record\")\n107|\tErrInvalidEvent      = errors.New(\"invalid session event\")\n108|\tErrInvalidTransition = errors.New(\"invalid_state_transition\")\n109|\tErrIntegrity         = errors.New(\"integrity_failure\")\n110|\tErrDerivation        = errors.New(\"derivation input is corrupt\")\n111|\tErrUnknownSession    = errors.New(\"unknown session\")\n112|\tErrStaleLease        = errors.New(\"event lease epoch precedes the chain head\")\n113|\tErrDivergentLease    = errors.New(\"divergent lease branch cannot be authoritative\")\n114|)\n115|\n116|// refuse is the single refusal funnel every sessstate rejection flows\n117|// through. It is a var so the census TestMain can wrap it and record\n118|// the production file:line behind each exercised refusal. No production\n119|// path wraps a sentinel with fmt.Errorf directly.\n120|var refuse = func(sentinel error, format string, arguments ...any) error {\n121|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n122|}\n123|\n124|// LeaseHead is one observed fencing token: the winning-lease pair\n125|// carried by every owner-authored event and mutation.\n126|type LeaseHead struct {\n127|\tEpoch   uint64\n128|\tLeaseID string\n129|}\n130|\n131|// IsZero reports an unset lease head: no local lease was supplied.\n132|func (head LeaseHead) IsZero() bool {\n133|\treturn head.Epoch == 0 && head.LeaseID == \"\"\n134|}\n135|\n136|// Compare orders two lease heads by the Section 5.3 tuple rule: the\n137|// greatest (epoch, lease_id) wins, where lease_id uses bytewise UUID\n138|// order. Lease IDs are canonical lowercase UUIDv4, so string order is\n139|// bytewise order.\n140|func Compare(a, b LeaseHead) int {\n141|\tif a.Epoch != b.Epoch {\n142|\t\tif a.Epoch < b.Epoch {\n143|\t\t\treturn -1\n144|\t\t}\n145|\t\treturn 1\n146|\t}\n147|\tswitch {\n148|\tcase a.LeaseID < b.LeaseID:\n149|\t\treturn -1\n150|\tcase a.LeaseID > b.LeaseID:\n151|\t\treturn 1\n152|\t}\n153|\treturn 0\n154|}\n155|\n156|// Conflict kinds. A conflict is reported data, never an error: both\n157|// sides were individually admittable, so the projection names the rule\n158|// that resolved them.\n159|const (\n160|\t// ConflictSameEpochTie ResolveRuleGreatestLeaseIDWins: two distinct\n161|\t// leases share the winning epoch (concurrent force takeovers under\n162|\t// partition); the bytewise-greater lease ID wins.\n163|\tConflictSameEpochTie = \"same_epoch_tie\"\n164|\t// ConflictEpochGap ResolveRuleGreatestTupleWins: a successor epoch\n165|\t// skips its predecessor (epoch N to N+2 or more); the greatest\n166|\t// tuple still wins, and only an explicit takeover checkpoint heals\n167|\t// the gap.\n168|\tConflictEpochGap = \"epoch_gap\"\n169|\t// ConflictLosingBranchPreserved ResolveRulePreservedNeverApplied:\n170|\t// an observed lease loses the tuple comparison; its history stays\n171|\t// preserved but never affects authoritative state.\n172|\tConflictLosingBranchPreserved = \"losing_branch_preserved\"\n173|\t// ConflictProviderMismatch ResolveRuleRecordPinnedProviderWins:\n174|\t// a launch event names a provider other than the immutable Session\n175|\t// Record provider; the record value stays authoritative.\n176|\tConflictProviderMismatch = \"provider_mismatch\"\n177|\t// ConflictUnionSupersedesChain\n178|\t// ResolveRuleAuthoritativeStateUnchanged: the union winner is not\n179|\t// among the authoritative chain leases; the reported winner moves\n180|\t// but derived state does not until an explicit takeover lands.\n181|\tConflictUnionSupersedesChain = \"union_supersedes_chain\"\n182|)\n183|\n184|// Resolution rules named by conflicts.\n185|const (\n186|\tResolveRuleGreatestLeaseIDWins         = \"greatest-lease-id-wins\"\n187|\tResolveRuleGreatestTupleWins           = \"greatest-tuple-wins\"\n188|\tResolveRulePreservedNeverApplied       = \"preserved-never-applied\"\n189|\tResolveRuleRecordPinnedProviderWins    = \"record-pinned-provider-wins\"\n190|\tResolveRuleAuthoritativeStateUnchanged = \"authoritative-state-unchanged\"\n191|)\n192|\n193|// Conflict is one resolved lease or identity conflict.\n194|type Conflict struct {\n195|\tKind   string\n196|\tRule   string\n197|\tDetail string\n198|}\n199|\n200|// Checkpoint is the newest validated checkpoint the projection knows.\n201|type Checkpoint struct {\n202|\tID      string\n203|\tKind    string\n204|\tEventID string\n205|}\n206|\n207|// ProviderIdentity is the derived provider surface: the immutable\n208|// record provider, the newest launched version, and the newest\n209|// identified record with its confidence.\n210|type ProviderIdentity struct {\n211|\tID               string\n212|\tVersion          string\n213|\tIdentityRecordID string\n214|\tConfidence       string\n215|}\n216|\n217|// TerminalBinding is the current terminal surface: the newest\n218|// terminal.created or session.resumed binding. V1 bindings carry the\n219|// backend with the terminal or native session handle; v4 bindings\n220|// carry the binding digest with the backend and versions.\n221|type TerminalBinding struct {\n222|\tBackend         string\n223|\tBindingID       string\n224|\tTerminalID      string\n225|\tNativeSessionID string\n226|\tEventID         string\n227|}\n228|\n229|// ParkedFacts carries the per-session parked channel from sessrepo\n230|// into the projection: the recoverable_parked_state blocking reason\n231|// and the same-operation retry.\n232|type ParkedFacts struct {\n233|\tBlockingReason string\n234|\tRetryHint      string\n235|}\n236|\n237|// Record is the decoded Session Record surface the reducer reads.\n238|type Record struct {\n239|\tSessionID  string\n240|\tRecordID   string\n241|\tName       string\n242|\tKind       string\n243|\tProviderID string\n244|}\n245|\n246|// Event is one decoded authoritative Session Event: the routing\n247|// members plus the closed payload object admitted by the canonical\n248|// owner at decode time.\n249|type Event struct {\n250|\tID              string\n251|\tType            string\n252|\tSchemaVersion   string\n253|\tSessionID       string\n254|\tCreatedByHostID string\n255|\tLeaseEpoch      uint64\n256|\tLeaseID         string\n257|\tSequence        uint64\n258|\tPredecessors    []string\n259|\tPayload         map[string]any\n260|}\n261|\n262|// Input is the complete pure-reducer input: the record, the\n263|// authoritative events in chain order, the competing off-chain leases\n264|// observed at union, the lease the local host acts under (zero when\n265|// unknown), the local host ID (empty when unknown), and the parked\n266|// channel (non-nil when sessrepo reports the session parked).\n267|type Input struct {\n268|\tRecord      Record\n269|\tEvents      []Event\n270|\tUnion       []LeaseHead\n271|\tLocal       LeaseHead\n272|\tLocalHostID string\n273|\tParked      *ParkedFacts\n274|}\n275|\n276|// Projection is the derived session surface: lifecycle state, winning\n277|// lease, conflicts, current checkpoint, provider identity, terminal\n278|// binding, owner and role, the parked channel when set, and warnings.\n279|type Projection struct {\n280|\tSessionID     string\n281|\tRecordID      string\n282|\tName          string\n283|\tKind          string\n284|\tState         State\n285|\tWinner        LeaseHead\n286|\tConflicts     []Conflict\n287|\tHasCheckpoint bool\n288|\tNewest        Checkpoint\n289|\tProvider      ProviderIdentity\n290|\tHasTerminal   bool\n291|\tTerminal      TerminalBinding\n292|\tOwnerHostID   string\n293|\tLocalRole     string\n294|\tParked        *ParkedFacts\n295|\tWarnings      []string\n296|}\n297|\n298|// Reduce folds one record with its authoritative events into a\n299|// Projection. It is pure: no I/O, no clock, no cache. Chain continuity\n300|// is re-checked over the input, so a chain-forbidden reordering\n301|// refuses with invalid_state_transition instead of silently deriving a\n302|// different state.\n303|func Reduce(input Input) (Projection, error) {\n304|\tprojection := Projection{\n305|\t\tSessionID: input.Record.SessionID,\n306|\t\tRecordID:  input.Record.RecordID,\n307|\t\tName:      input.Record.Name,\n308|\t\tKind:      input.Record.Kind,\n309|\t\tProvider:  ProviderIdentity{ID: input.Record.ProviderID},\n310|\t}\n311|\tif input.Parked != nil {\n312|\t\tprojection.State = StateParked\n313|\t\tprojection.Parked = &ParkedFacts{\n314|\t\t\tBlockingReason: input.Parked.BlockingReason,\n315|\t\t\tRetryHint:      input.Parked.RetryHint,\n316|\t\t}\n317|\t\tprojection.Warnings = []string{\"parked: \" + input.Parked.BlockingReason}\n318|\t\treturn projection, nil\n319|\t}\n320|\tif input.Record.SessionID == \"\" || input.Record.RecordID == \"\" {\n321|\t\treturn Projection{}, refuse(ErrInvalidRecord, \"reducer input carries no session identity\")\n322|\t}\n323|\tfold := &chainFold{\n324|\t\trecordID:       input.Record.RecordID,\n325|\t\trecordProvider: input.Record.ProviderID,\n326|\t\tprojection:     &projection,\n327|\t}\n328|\tfor index := range input.Events {\n329|\t\tif err := fold.apply(input.Events[index]); err != nil {\n330|\t\t\treturn Projection{}, err\n331|\t\t}\n332|\t}\n333|\tif len(input.Events) == 0 {\n334|\t\t// An empty chain derives creating, but the union still\n335|\t\t// passes through resolveWinner below: a malformed union\n336|\t\t// refuses here exactly as on a non-empty chain, and a\n337|\t\t// well-formed union moves only the reported winner while\n338|\t\t// authoritative state stays creating.\n339|\t\tfold.state = StateCreating\n340|\t}\n341|\tif err := fold.resolveWinner(input.Union); err != nil {\n342|\t\treturn Projection{}, err\n343|\t}\n344|\tfold.applyLocalLease(input.Local, input.LocalHostID)\n345|\tfold.emitWarnings()\n346|\treturn projection, nil\n347|}\n348|\n349|// chainFold carries the mutable fold state across one Reduce call. It\n350|// never escapes Reduce.\n351|type chainFold struct {\n352|\trecordID       string\n353|\trecordProvider string\n354|\tprojection     *Projection\n355|\tstate          State\n356|\tcurrent        LeaseHead\n357|\tcreateLease    LeaseHead\n358|\thaveLease      bool\n359|\tseenCheckpoint bool\n360|\tseenAbort      bool\n361|\tonChain        map[string]struct{}\n362|\ttailID         string\n363|\ttailSeq        uint64\n364|\tleases         []LeaseHead\n365|\tprevious       LeaseHead\n366|}\n367|\n368|// apply folds one event: continuity first, then the type effect.\n369|func (fold *chainFold) apply(event Event) error {\n370|\tif err := fold.checkContinuity(event); err != nil {\n371|\t\treturn err\n372|\t}\n373|\tif event.SchemaVersion != \"1.0.0\" && event.SchemaVersion != \"2.0.0\" &&\n374|\t\tevent.SchemaVersion != \"3.0.0\" && event.SchemaVersion != \"4.0.0\" {\n375|\t\treturn refuse(ErrInvalidEvent, \"event %s carries unregistered schema version %q\", event.ID, event.SchemaVersion)\n376|\t}\n377|\tif event.SessionID != fold.projection.SessionID {\n378|\t\treturn refuse(ErrInvalidEvent, \"event %s session %s does not belong to session %s\", event.ID, event.SessionID, fold.projection.SessionID)\n379|\t}\n380|\tlease := LeaseHead{Epoch: event.LeaseEpoch, LeaseID: event.LeaseID}\n381|\tsuccession, err := fold.trackLease(event, lease)\n382|\tif err != nil {\n383|\t\treturn err\n384|\t}\n385|\tif succession {\n386|\t\tif err := fold.successionMove(what(event)); err != nil {\n387|\t\t\treturn err\n388|\t\t}\n389|\t}\n390|\tfold.projection.OwnerHostID = event.CreatedByHostID\n391|\treturn fold.effect(event, lease, succession)\n392|}\n393|\n394|// what names one event for refusal evidence.\n395|func what(event Event) string {\n396|\treturn \"event \" + event.Type + \" \" + event.ID\n397|}\n398|\n399|// successionMove folds a successor lease arrival before the event's own\n400|// effect: a takeover while the winner is active stales the old host's\n401|// projection under the force-takeover rule, and from a checkpoint, a\n402|// stop, a failure, or a park the destination stages into\n403|// materializing. The move composes through step, so the arriving\n404|// event's own effect still applies after it.\n405|func (fold *chainFold) successionMove(name string) error {\n406|\tswitch fold.state {\n407|\tcase StateRunning, StateIdle, StateQuiescing:\n408|\t\treturn fold.step(StateStale, name)\n409|\tdefault:\n410|\t\treturn fold.step(StateMaterializing, name)\n411|\t}\n412|}\n413|\n414|// checkContinuity re-enforces the Section 5.2 chain rules over the\n415|// reducer input: the first event links exactly the Session Record at\n416|// sequence 1, within one lease the sequence increases by exactly one\n417|// and each event references the prior authoritative event, and a\n418|// successor lease restarts at 1 referencing the prior head. A\n419|// violation is invalid_state_transition: the input is not a chain the\n420|// repository could have authored.\n421|func (fold *chainFold) checkContinuity(event Event) error {\n422|\tif event.Sequence == 0 {\n423|\t\treturn refuse(ErrInvalidTransition, \"event %s carries no lease sequence\", event.ID)\n424|\t}\n425|\tif len(event.Predecessors) == 0 {\n426|\t\treturn refuse(ErrInvalidTransition, \"event %s names no predecessor\", event.ID)\n427|\t}\n428|\tif fold.onChain == nil {\n429|\t\tif len(event.Predecessors) != 1 || event.Predecessors[0] != fold.recordID {\n430|\t\t\treturn refuse(ErrInvalidTransition, \"first event %s must link exactly the session record\", event.ID)\n431|\t\t}\n432|\t\tif event.Sequence != 1 {\n433|\t\t\treturn refuse(ErrInvalidTransition, \"first event %s must open its lease at sequence 1\", event.ID)\n434|\t\t}\n435|\t\tfold.onChain = map[string]struct{}{event.ID: {}}\n436|\t\treturn nil\n437|\t}\n438|\ttail := fold.tailEventID()\n439|\tif event.LeaseID == fold.current.LeaseID && event.LeaseEpoch == fold.current.Epoch {\n440|\t\tif event.Sequence != fold.tailSequence()+1 {\n441|\t\t\tif event.Sequence <= fold.tailSequence() {\n442|\t\t\t\treturn refuse(ErrInvalidTransition, \"event %s repeats chained sequence through %d\", event.ID, fold.tailSequence())\n443|\t\t\t}\n444|\t\t\treturn refuse(ErrInvalidTransition, \"event %s skips chained sequence %d\", event.ID, fold.tailSequence()+1)\n445|\t\t}\n446|\t} else {\n447|\t\tif event.Sequence != 1 {\n448|\t\t\treturn refuse(ErrInvalidTransition, \"successor-lease event %s must restart at sequence 1\", event.ID)\n449|\t\t}\n450|\t}\n451|\tif !containsString(event.Predecessors, tail) {\n452|\t\treturn refuse(ErrInvalidTransition, \"event %s predecessors omit prior authoritative event\", event.ID)\n453|\t}\n454|\tfold.onChain[event.ID] = struct{}{}\n455|\treturn nil\n456|}\n457|\n458|// tail tracking: the fold remembers the last applied event ID and its\n459|// sequence alongside the current lease.\n460|func (fold *chainFold) trackTail(event Event) {\n461|\tfold.tailID = event.ID\n462|\tfold.tailSeq = event.Sequence\n463|}\n464|\n465|func (fold *chainFold) tailEventID() string { return fold.tailID }\n466|\n467|func (fold *chainFold) tailSequence() uint64 { return fold.tailSeq }\n468|\n469|// trackLease observes the envelope lease: same-lease events continue,\n470|// a greater tuple succeeds (recording an epoch gap past plus one), a\n471|// same-epoch second lease diverges, and a lower epoch is stale. The\n472|// chain cannot hold the losing cases, so they refuse here for direct\n473|// Reduce inputs; the union path reports them as conflicts instead.\n474|func (fold *chainFold) trackLease(event Event, lease LeaseHead) (bool, error) {\n475|\tif !fold.haveLease {\n476|\t\tfold.current = lease\n477|\t\tfold.createLease = lease\n478|\t\tfold.haveLease = true\n479|\t\tfold.leases = append(fold.leases, lease)\n480|\t\tfold.trackTail(event)\n481|\t\treturn false, nil\n482|\t}\n483|\tswitch Compare(lease, fold.current) {\n484|\tcase 0:\n485|\t\tfold.trackTail(event)\n486|\t\treturn false, nil\n487|\tcase 1:\n488|\t\tif lease.Epoch == fold.current.Epoch {\n489|\t\t\treturn false, refuse(ErrDivergentLease, \"event %s under lease %s diverges from chain head lease %s at epoch %d\", event.ID, lease.LeaseID, fold.current.LeaseID, fold.current.Epoch)\n490|\t\t}\n491|\t\tif lease.Epoch > fold.current.Epoch+1 {\n492|\t\t\tfold.conflict(ConflictEpochGap, ResolveRuleGreatestTupleWins,\n493|\t\t\t\t\"lease epoch jumps from %d to %d at event %s; only an explicit takeover checkpoint heals the gap\",\n494|\t\t\t\tfold.current.Epoch, lease.Epoch, event.ID)\n495|\t\t}\n496|\t\tfold.previous = fold.current\n497|\t\tfold.current = lease\n498|\t\tfold.leases = append(fold.leases, lease)\n499|\t\tfold.trackTail(event)\n500|\t\treturn true, nil\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c3","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":572,"recorded_at":1780531400001139,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886bd7937e9293c7402e0e972ab9","text":"Read text file `internal/sessstate/project.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n5|)\n6|\n7|// Projector binds the pure reducer to one repository. It only reads:\n8|// ListSessions locates the session (and its parked channel), GetRecord\n9|// and ListEvents with GetEvent load the authoritative bytes, and\n10|// Decode plus Reduce derive the projection. No entry here mutates\n11|// durable state, so there is no crash window to arm: placing\n12|// secconftest points around reads would measure nothing, and a crashed\n13|// read retries as the same read. Idempotency is the reducer's purity —\n14|// projecting twice yields the identical projection — pinned by\n15|// TestProjectIsIdempotentAcrossReads.\n16|type Projector struct {\n17|\t// Repo is the session repository to project from. It is required.\n18|\tRepo *sessrepo.Repository\n19|\t// LocalHostID selects the local role: the owner host of the\n20|\t// newest authoritative event decides owner against replica. Empty\n21|\t// leaves the role unknown rather than guessing.\n22|\tLocalHostID string\n23|\t// Union carries competing off-chain leases observed at mesh union\n24|\t// for winner resolution. Nil projects the chain alone.\n25|\tUnion []LeaseHead\n26|\t// Local is the lease the local host acts under for the stale\n27|\t// projection. Zero disables the stale override.\n28|\tLocal LeaseHead\n29|}\n30|\n31|// Project derives the session projection for one session ID. A parked\n32|// session returns the parked state with its blocking reason and retry,\n33|// never an error or an omission; an ID with no listing entry refuses\n34|// unknown. The listing therefore tells a parked name apart from a\n35|// missing one with no sessrepo interface change.\n36|func (projector *Projector) Project(sessionID string) (Projection, error) {\n37|\tif projector == nil || projector.Repo == nil {\n38|\t\treturn Projection{}, refuse(ErrDerivation, \"projector carries no repository\")\n39|\t}\n40|\tsummaries, err := projector.Repo.ListSessions()\n41|\tif err != nil {\n42|\t\treturn Projection{}, err\n43|\t}\n44|\tvar found *sessrepo.SessionSummary\n45|\tfor index := range summaries {\n46|\t\tif summaries[index].SessionID == sessionID {\n47|\t\t\tfound = &summaries[index]\n48|\t\t\tbreak\n49|\t\t}\n50|\t}\n51|\tif found == nil {\n52|\t\treturn Projection{}, refuse(ErrUnknownSession, \"no session %s\", sessionID)\n53|\t}\n54|\tif found.Parked {\n55|\t\treturn Reduce(Input{\n56|\t\t\tRecord: Record{\n57|\t\t\t\tSessionID:  found.SessionID,\n58|\t\t\t\tRecordID:   found.RecordID,\n59|\t\t\t\tName:       found.Name,\n60|\t\t\t\tKind:       found.Kind,\n61|\t\t\t\tProviderID: found.ProviderID,\n62|\t\t\t},\n63|\t\t\tParked: &ParkedFacts{\n64|\t\t\t\tBlockingReason: found.BlockingReason,\n65|\t\t\t\tRetryHint:      found.RetryHint,\n66|\t\t\t},\n67|\t\t})\n68|\t}\n69|\trecordBytes, err := projector.Repo.GetRecord(sessionID)\n70|\tif err != nil {\n71|\t\treturn Projection{}, err\n72|\t}\n73|\trecord, err := DecodeRecord(recordBytes)\n74|\tif err != nil {\n75|\t\treturn Projection{}, err\n76|\t}\n77|\tindexed, err := projector.Repo.ListEvents(sessionID)\n78|\tif err != nil {\n79|\t\treturn Projection{}, err\n80|\t}\n81|\tevents := make([]Event, 0, len(indexed))\n82|\tfor _, summary := range indexed {\n83|\t\tblob, err := projector.Repo.GetEvent(sessionID, summary.EventID)\n84|\t\tif err != nil {\n85|\t\t\treturn Projection{}, err\n86|\t\t}\n87|\t\tevent, err := DecodeEvent(blob)\n88|\t\tif err != nil {\n89|\t\t\treturn Projection{}, err\n90|\t\t}\n91|\t\tevents = append(events, event)\n92|\t}\n93|\treturn Reduce(Input{\n94|\t\tRecord:      record,\n95|\t\tEvents:      events,\n96|\t\tUnion:       append([]LeaseHead(nil), projector.Union...),\n97|\t\tLocal:       projector.Local,\n98|\t\tLocalHostID: projector.LocalHostID,\n99|\t})\n100|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c5","stream":{"kind":"session","id":"01a0886a-f946-7ee0-9ec1-744b6874e305"},"sequence":573,"recorded_at":1780531400001141,"record_type":"event","durability":"durable","causation_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19","run_stream":{"kind":"run","id":"a5c7b7f2-5904-46fe-8e20-ce6e123abb19"},"call_id":"call_01a0886bd812790296732ea854188998","text":"Read text file `internal/sessrepo/sessrepo.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|)\n11|\n12|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6. It is\n13|// passed to the environ bound checker, never re-enforced here.\n14|const uint53Max = uint64(1<<53 - 1)\n15|\n16|const (\n17|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n18|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n19|)\n20|\n21|var (\n22|\tErrInvalidRecord   = errors.New(\"invalid session record\")\n23|\tErrSessionExists   = errors.New(\"session already exists\")\n24|\tErrUnknownSession  = errors.New(\"unknown session\")\n25|\tErrInvalidEvent    = errors.New(\"invalid session event\")\n26|\tErrSequenceGap     = errors.New(\"event source sequence gap\")\n27|\tErrSequenceRepeat  = errors.New(\"event source sequence repeat\")\n28|\tErrPredecessorLink = errors.New(\"event predecessor link mismatch\")\n29|\tErrDivergentBranch = errors.New(\"divergent lease branch preserved without application\")\n30|\tErrStaleLease      = errors.New(\"event lease epoch precedes the chain head\")\n31|\tErrChainCorrupt    = errors.New(\"session event chain is corrupt\")\n32|\tErrUnknownEvent    = errors.New(\"unknown session event\")\n33|\tErrNameAmbiguous   = errors.New(\"name_ambiguous\")\n34|\tErrNameNotFound    = errors.New(\"session name not found\")\n35|\tErrRepositoryPath  = errors.New(\"invalid session repository path\")\n36|)\n37|\n38|// refuse is the single refusal funnel every sessrepo rejection flows\n39|// through. It is a var so the census TestMain can wrap it and record the\n40|// production file:line behind each exercised refusal. No production path\n41|// wraps a sentinel with fmt.Errorf directly.\n42|var refuse = func(sentinel error, format string, arguments ...any) error {\n43|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n44|}\n45|\n46|// SessionRef names one persisted session: its Session Record digest and ID.\n47|type SessionRef struct {\n48|\tSessionID string\n49|\tRecordID  string\n50|}\n51|\n52|// EventRef names one chained event: its digest, lease sequence, and position.\n53|type EventRef struct {\n54|\tSessionID     string\n55|\tEventID       string\n56|\tLeaseSequence uint64\n57|\tPosition      int\n58|}\n59|\n60|// EventSummary is the chain-index entry for one event, derived from the\n61|// validated event bytes at append time and re-verified against them on load.\n62|type EventSummary struct {\n63|\tEventID       string   `json:\"event_id\"`\n64|\tEventType     string   `json:\"event_type\"`\n65|\tLeaseEpoch    uint64   `json:\"lease_epoch\"`\n66|\tLeaseID       string   `json:\"lease_id\"`\n67|\tLeaseSequence uint64   `json:\"lease_sequence\"`\n68|\tPredecessors  []string `json:\"predecessors\"`\n69|}\n70|\n71|// SessionSummary is the Section 14.4 list projection this leaf owns: stored\n72|// identity plus chain-head facts for a healthy session, or the per-session\n73|// parked channel for an interrupted create or a torn store. Owner host,\n74|// checkpoint age, capability status, and rendered warnings are derived\n75|// downstream, never here; the parked fields below are the facts the\n76|// Section 5.7 reducer and the Section 14.4 rendering leaves project from.\n77|//\n78|// A healthy entry carries Parked=false with empty BlockingReason and\n79|// RetryHint. A parked entry carries Parked=true, SessionID set to the\n80|// session directory name, BlockingReason naming the load failure (a\n81|// recoverable_parked_state block with its per-session cause), and RetryHint\n82|// naming the same-operation retry. Identity members (RecordID, Name, Kind,\n83|// ProviderID) are filled from the parked record when it still verifies;\n84|// a bare directory with no verifiable record leaves them empty.\n85|type SessionSummary struct {\n86|\tSessionID      string\n87|\tRecordID       string\n88|\tName           string\n89|\tKind           string\n90|\tProviderID     string\n91|\tEventCount     int\n92|\tTailEvent      string\n93|\tParked         bool\n94|\tBlockingReason string\n95|\tRetryHint      string\n96|}\n97|\n98|// retryHintForParkedRecord names the same-operation retry for a parked\n99|// session: a record is already parked, so only the byte-identical record\n100|// resumes through CreateSession.\n101|const retryHintForParkedRecord = \"retry CreateSession with the byte-identical session record\"\n102|\n103|// retryHintForBareDirectory names the same-operation retry for a bare\n104|// session directory: no record is parked yet, so CreateSession with the\n105|// session record for this session ID resumes.\n106|const retryHintForBareDirectory = \"retry CreateSession with the session record for this session ID\"\n107|\n108|// CreateStep names one durable boundary inside CreateSession's four-step\n109|// span: the session directory, the record install, the events directory,\n110|// and the chain index install, in that order.\n111|type CreateStep string\n112|\n113|const (\n114|\tCreateStepSessionDir CreateStep = \"session-dir\"\n115|\tCreateStepRecord     CreateStep = \"record\"\n116|\tCreateStepEventsDir  CreateStep = \"events-dir\"\n117|\tCreateStepChain      CreateStep = \"chain\"\n118|)\n119|\n120|// Repository persists Session Records and per-session event chains under\n121|// one data root. All mutating entries serialize on one mutex; files are\n122|// content-addressed and installed no-replace, so the chain is append-only\n123|// by construction and there is no update or delete entry to test.\n124|//\n125|// BeforeWrite fires after validation and before the first durable byte;\n126|// AfterCommit fires after the chain index is durable. AfterCreateStep\n127|// fires after each CreateStep inside CreateSession's four-step span, so\n128|// an interrupted create — not only a fault outside it — is drivable.\n129|// All three are nil in normal operation. Tests connect them to a\n130|// secconftest Injector firing the owner's own points: a fault before\n131|// any durable byte carries safe_retry, and a fault past any durable\n132|// step — including every interior boundary, whose parked state the\n133|// identical retry resumes — carries recoverable_parked_state.\n134|type Repository struct {\n135|\troot            string\n136|\tmutex           sync.Mutex\n137|\tBeforeWrite     func() error\n138|\tAfterCommit     func() error\n139|\tAfterCreateStep func(CreateStep) error\n140|}\n141|\n142|// Open binds a repository to the sessions namespace beneath dataRoot,\n143|// creating it owner-only when absent. The root must be absolute.\n144|func Open(dataRoot string) (*Repository, error) {\n145|\tif !filepath.IsAbs(dataRoot) {\n146|\t\treturn nil, refuse(ErrRepositoryPath, \"data root %q is not absolute\", dataRoot)\n147|\t}\n148|\troot := filepath.Join(dataRoot, \"sessions\")\n149|\tif err := os.MkdirAll(root, 0o700); err != nil {\n150|\t\treturn nil, refuse(ErrRepositoryPath, \"create sessions root %q: %v\", root, err)\n151|\t}\n152|\treturn &Repository{root: root}, nil\n153|}\n154|\n155|// CreateSession validates recordJSON through the canonical owner and\n156|// persists it as a new session. The bytes are stored verbatim.\n157|func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\n158|\trecord, err := decodeSessionRecord(recordJSON)\n159|\tif err != nil {\n160|\t\treturn SessionRef{}, err\n161|\t}\n162|\trepository.mutex.Lock()\n163|\tdefer repository.mutex.Unlock()\n164|\tif repository.BeforeWrite != nil {\n165|\t\tif err := repository.BeforeWrite(); err != nil {\n166|\t\t\treturn SessionRef{}, err\n167|\t\t}\n168|\t}\n169|\tdirectory := repository.sessionDir(record.sessionID)\n170|\tif _, err := os.Stat(directory); err == nil {\n171|\t\tresumed, resumeErr := repository.resumeCreateLocked(directory, record, recordJSON)\n172|\t\tif resumeErr != nil {\n173|\t\t\treturn SessionRef{}, resumeErr\n174|\t\t}\n175|\t\tif !resumed {\n176|\t\t\treturn SessionRef{}, refuse(ErrSessionExists, \"session %s already exists\", record.sessionID)\n177|\t\t}\n178|\t} else {\n179|\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n180|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session directory: %w\", err)\n181|\t\t}\n182|\t\tif err := repository.crashCreateStep(CreateStepSessionDir); err != nil {\n183|\t\t\treturn SessionRef{}, err\n184|\t\t}\n185|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n186|\t\t\treturn SessionRef{}, fmt.Errorf(\"install session record: %w\", err)\n187|\t\t}\n188|\t\tif err := repository.crashCreateStep(CreateStepRecord); err != nil {\n189|\t\t\treturn SessionRef{}, err\n190|\t\t}\n191|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n192|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session events directory: %w\", err)\n193|\t\t}\n194|\t\tif err := repository.crashCreateStep(CreateStepEventsDir); err != nil {\n195|\t\t\treturn SessionRef{}, err\n196|\t\t}\n197|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n198|\t\t\treturn SessionRef{}, err\n199|\t\t}\n200|\t\tif err := repository.crashCreateStep(CreateStepChain); err != nil {\n201|\t\t\treturn SessionRef{}, err\n202|\t\t}\n203|\t}\n204|\tif repository.AfterCommit != nil {\n205|\t\tif err := repository.AfterCommit(); err != nil {\n206|\t\t\treturn SessionRef{}, err\n207|\t\t}\n208|\t}\n209|\treturn SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil\n210|}\n211|\n212|// crashCreateStep fires the AfterCreateStep hook after one durable create\n213|// step. It is nil-safe: unhooked production never faults. A hook error —\n214|// the injected secconftest fault in tests — propagates unwrapped so the\n215|// caller observes the owner's point and outcome.\n216|func (repository *Repository) crashCreateStep(step CreateStep) error {\n217|\tif repository.AfterCreateStep == nil {\n218|\t\treturn nil\n219|\t}\n220|\treturn repository.AfterCreateStep(step)\n221|}\n222|\n223|// resumeCreateLocked completes a create that crashed inside the four-step\n224|// span. Two parked states resume:\n225|//\n226|//   - record absent: the crash landed after the session directory and\n227|//     before the record install, so nothing committed. The chain index\n228|//     must also be absent — a chain without a record is torn foreign\n229|//     state, never a resume — and the retry's bytes become the record.\n230|//   - record present with the retried bytes and the chain still absent:\n231|//     the crash landed between the record write and the chain write, and\n232|//     the retry completes the index.\n233|//\n234|// Anything else is not a resume — a completed create, or a colliding\n235|// record under a live session ID — and the caller refuses it as an\n236|// existing session. It returns plain operational errors; refusal\n237|// attribution stays at the caller.\n238|func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {\n239|\texisting, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n240|\tif err != nil {\n241|\t\tif !os.IsNotExist(err) {\n242|\t\t\treturn false, fmt.Errorf(\"read session record for resume: %w\", err)\n243|\t\t}\n244|\t\tif _, statErr := os.Stat(filepath.Join(directory, \"chain.json\")); statErr == nil {\n245|\t\t\treturn false, nil\n246|\t\t}\n247|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n248|\t\t\treturn false, fmt.Errorf(\"install session record on resume: %w\", err)\n249|\t\t}\n250|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n251|\t\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n252|\t\t}\n253|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n254|\t\t\treturn false, err\n255|\t\t}\n256|\t\treturn true, nil\n257|\t}\n258|\tif !bytes.Equal(existing, recordJSON) {\n259|\t\treturn false, nil\n260|\t}\n261|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); err == nil {\n262|\t\treturn false, nil\n263|\t}\n264|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n265|\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n266|\t}\n267|\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n268|\t\treturn false, err\n269|\t}\n270|\treturn true, nil\n271|}\n272|\n273|// AppendEvent validates eventJSON through the canonical owner and links it\n274|// onto the session chain after the continuity checks. A byte-identical\n275|// retry of an already chained event returns its existing reference without\n276|// duplicating the chain, so a retry after a crashed commit is safe.\n277|func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\n278|\tevent, err := decodeSessionEvent(eventJSON)\n279|\tif err != nil {\n280|\t\treturn EventRef{}, err\n281|\t}\n282|\tif event.sessionID != sessionID {\n283|\t\treturn EventRef{}, refuse(ErrInvalidEvent, \"event session %s does not match target session %s\", event.sessionID, sessionID)\n284|\t}\n285|\trepository.mutex.Lock()\n286|\tdefer repository.mutex.Unlock()\n287|\tview, err := repository.loadSessionLocked(sessionID)\n288|\tif err != nil {\n289|\t\treturn EventRef{}, err\n290|\t}\n291|\tfor position, existing := range view.chain.Events {\n292|\t\tif existing.EventID == event.eventID {\n293|\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n294|\t\t}\n295|\t}\n296|\tif repository.BeforeWrite != nil {\n297|\t\tif err := repository.BeforeWrite(); err != nil {\n298|\t\t\treturn EventRef{}, err\n299|\t\t}\n300|\t}\n301|\tvar tail *EventSummary\n302|\tif len(view.chain.Events) > 0 {\n303|\t\tprevious := view.chain.Events[len(view.chain.Events)-1]\n304|\t\ttail = &previous\n305|\t}\n306|\tif err := checkAppend(view.chain.RecordID, tail, event); err != nil {\n307|\t\t// Losing-lease branches are preserved as immutable blobs but never\n308|\t\t// applied: the bytes stay addressable while the chain is untouched.\n309|\t\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\n310|\t\t\tif preserveErr := installEventBlob(filepath.Join(view.directory, \"events\", blobFileName(event.eventID)), eventJSON); preserveErr != nil {\n311|\t\t\t\treturn EventRef{}, fmt.Errorf(\"preserve unapplied branch: %v: %w\", preserveErr, err)\n312|\t\t\t}\n313|\t\t}\n314|\t\treturn EventRef{}, err\n315|\t}\n316|\tblobPath := filepath.Join(view.directory, \"events\", blobFileName(event.eventID))\n317|\tif err := installEventBlob(blobPath, eventJSON); err != nil {\n318|\t\tif errors.Is(err, errDigestDisagreement) {\n319|\t\t\treturn EventRef{}, refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for event\")\n320|\t\t}\n321|\t\treturn EventRef{}, err\n322|\t}\n323|\tnext := append(append([]EventSummary(nil), view.chain.Events...), eventSummary(event))\n324|\tif err := repository.writeChain(view.directory, storedChain{RecordID: view.chain.RecordID, Events: next}); err != nil {\n325|\t\treturn EventRef{}, err\n326|\t}\n327|\tif repository.AfterCommit != nil {\n328|\t\tif err := repository.AfterCommit(); err != nil {\n329|\t\t\treturn EventRef{}, err\n330|\t\t}\n331|\t}\n332|\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: event.leaseSeq, Position: len(next) - 1}, nil\n333|}\n334|\n335|// eventSummary projects the validated routing members into the chain index.\n336|func eventSummary(event eventView) EventSummary {\n337|\treturn EventSummary{EventID: event.eventID, EventType: event.eventType, LeaseEpoch: event.leaseEpoch, LeaseID: event.leaseID, LeaseSequence: event.leaseSeq, Predecessors: append([]string(nil), event.predecessors...)}\n338|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
