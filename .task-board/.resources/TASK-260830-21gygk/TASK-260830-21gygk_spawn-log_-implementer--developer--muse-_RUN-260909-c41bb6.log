{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d061","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":1675,"recorded_at":1780531400003345,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a08797-9862-7dd1-a0a6-cf778ca6d2b4"},"task_id":"01a08797-9862-7dd1-a0a6-cf778ca6d2b4","event":{"kind":"output","task_id":"01a08797-9862-7dd1-a0a6-cf778ca6d2b4","chunk":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery composes the session repository and state projector for\n2|// read-only NAME/UUID resolution and local list/status summaries. It implements\n3|// the specified portions of TASK-260830-21gygk against SPEC v0.5.0 Sections 2.3,\n4|// 5.1–5.2, 5.7 and 14.4. It defines no qualified-selector grammar or action route.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"sort\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|var (\n18|\tErrUnavailable = errors.New(\"session index unavailable\")\n19|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n20|\tErrNotFound    = sessrepo.ErrNameNotFound\n21|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n22|\t// grammar violations (empty key, unknown source prefix, malformed\n23|\t// durable IDs, overlong argument), malformed plan members, unknown\n24|\t// action tags, and malformed destinations or expectations. Wire\n25|\t// exit binding for a CLI surface belongs to that surface's leaf;\n26|\t// this library keeps the refusal class distinct and stable.\n27|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n28|\t// ErrSourceNotFound reports that complete valid configuration has\n29|\t// no requested explicit source.\n30|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n31|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n32|\t// is configured but not allowlisted, including authorization\n33|\t// revoked after a plan was built.\n34|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n35|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n36|\t// failure with no fallback. The underlying cause stays attached\n37|\t// for errors.Is, so a repository-path failure remains visible as\n38|\t// such. A local source/store I-O failure keeps its repository\n39|\t// error, which the CLI Result 5 leaf maps to\n40|\t// local_precondition_failed; a partial or malformed index or\n41|\t// authority response is integrity failure, not absence.\n42|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n43|\t// ErrInvalidConfig reports duplicate or malformed effective source\n44|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n45|\t// collides with the local host, malformed host IDs, or aliases\n46|\t// outside the configured 1-64 printable-character bound.\n47|\tErrInvalidConfig = errors.New(\"invalid_config\")\n48|\t// ErrPlanStale reports bound selection facts that changed after a\n49|\t// plan was built; a fresh plan and confirmation are required. The\n50|\t// wrapped reason names the first diverged member in compare order.\n51|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n52|)\n53|\n54|// PeerIndex binds a peer identity to its already persisted learned index.\n55|// Transport/authentication and installing peer indexes are upstream owners;\n56|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n57|type PeerIndex struct {\n58|\tHostID string\n59|\tRepo   *sessrepo.Repository\n60|}\n61|\n62|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n63|// configuration layer, separately from the learned indexes. An unlisted source\n64|// is never read. Failed reads from listed sources are errors, never\n65|// empty indexes that let resolution fall through to a lower-priority UUID.\n66|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n67|//\n68|// Aliases carries the exact configured peer-alias mapping (host ID to\n69|// alias) from the same configuration owner, kept separate from the\n70|// learned index handles: a mapping without a handle contributes no\n71|// learned names, and a handle without a mapping stays reachable through\n72|// the bare union and the \"id:\" host form but never through \"peer:\".\n73|// Alias comparison is always exact, never folded, trimmed, or decoded.\n74|type Reader struct {\n75|\tLocal              *sessrepo.Repository\n76|\tLocalHostID        string\n77|\tAllowlistedPeerIDs []string\n78|\tPeers              []PeerIndex\n79|\tAliases            map[string]string\n80|}\n81|\n82|// Summary contains only facts derived from verified session records and events.\n83|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n84|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n85|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n86|// process liveness and sync timestamps require their respective observation\n87|// owners and are deliberately not inferred from a record or a successful read.\n88|type Summary struct {\n89|\tProjection sessstate.Projection\n90|}\n91|\n92|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n93|// visible with their blocking reason and retry; failure to enumerate the index\n94|// fails the read. No durable state is written, even for an interrupted create.\n95|func (reader *Reader) List() ([]Summary, error) {\n96|\tif reader == nil || reader.Local == nil {\n97|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n98|\t}\n99|\treturn reader.read(reader.Local)\n100|}\n(more lines below)","final_result":true}}}
