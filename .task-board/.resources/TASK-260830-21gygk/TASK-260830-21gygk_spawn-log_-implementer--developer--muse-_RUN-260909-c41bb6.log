{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d5","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":197,"recorded_at":1780531400000389,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a08788-2d7a-7c82-acf4-aff0d3168d86"},"task_id":"01a08788-2d7a-7c82-acf4-aff0d3168d86","event":{"kind":"output","task_id":"01a08788-2d7a-7c82-acf4-aff0d3168d86","chunk":"Read text file `internal/sessquery/query_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"reflect\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n12|)\n13|\n14|func TestResolvePinnedPrecedence(t *testing.T) {\n15|\tlocal, _ := repository(t)\n16|\tpeer, _ := repository(t)\n17|\tcreate(t, local, idA, \"Local\")\n18|\tcreate(t, peer, idB, idA)\n19|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n20|\tfor _, row := range []struct{ selector, id, peer string }{\n21|\t\t{\"Local\", idA, \"\"}, {idA, idB, hostA}, {idB, idB, hostA},\n22|\t} {\n23|\t\tgot, err := reader.Resolve(row.selector)\n24|\t\tif err != nil || got.SessionID != row.id || got.PeerHostID != row.peer {\n25|\t\t\tt.Fatalf(\"Resolve(%q) = %+v, %v\", row.selector, got, err)\n26|\t\t}\n27|\t\tstatus, err := reader.Status(row.selector)\n28|\t\tif err != nil || status.Projection.SessionID != row.id {\n29|\t\t\tt.Fatalf(\"Status(%q) = %+v, %v\", row.selector, status, err)\n30|\t\t}\n31|\t}\n32|\t// Local exact name wins even if a peer learned the same name for another ID.\n33|\tother, _ := repository(t)\n34|\tcreate(t, other, idB, \"Local\")\n35|\treader.Peers = []PeerIndex{{hostA, other}}\n36|\tgot, err := reader.Resolve(\"Local\")\n37|\tif err != nil || got.SessionID != idA || got.PeerHostID != \"\" {\n38|\t\tt.Fatalf(\"local priority: %+v %v\", got, err)\n39|\t}\n40|\t// A local UUID-shaped name also wins over the UUID identity.\n41|\tlocal2, _ := repository(t)\n42|\tcreate(t, local2, idA, \"Original\")\n43|\tcreate(t, local2, idB, idA)\n44|\tgot, err = (&Reader{Local: local2}).Resolve(idA)\n45|\tif err != nil || got.SessionID != idB {\n46|\t\tt.Fatalf(\"local name before UUID: %+v %v\", got, err)\n47|\t}\n48|}\n49|\n50|func TestResolveExactNamesAndASCIICollisions(t *testing.T) {\n51|\tfor _, peers := range []bool{false, true} {\n52|\t\tt.Run(map[bool]string{false: \"local\", true: \"peers\"}[peers], func(t *testing.T) {\n53|\t\t\tlocal, _ := repository(t)\n54|\t\t\tsource := local\n55|\t\t\tr := &Reader{Local: local}\n56|\t\t\tif peers {\n57|\t\t\t\tsource, _ = repository(t)\n58|\t\t\t\tr.AllowlistedPeerIDs = []string{hostA}\n59|\t\t\t\tr.Peers = []PeerIndex{{hostA, source}}\n60|\t\t\t}\n61|\t\t\tcreate(t, source, idA, \"Az-09._\")\n62|\t\t\tfor _, query := range []string{\"az-09._\", \"AZ-09._\", \"Ａz-09._\", \"no-such-session\", \"Name@host\", \"host/Name\", \"\"} {\n63|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrNotFound) {\n64|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n65|\t\t\t\t}\n66|\t\t\t}\n67|\t\t\tif _, err := r.Resolve(\"Az-09._\"); err != nil {\n68|\t\t\t\tt.Fatal(err)\n69|\t\t\t}\n70|\t\t\tcreate(t, source, idB, \"aZ-09._\")\n71|\t\t\tfor _, query := range []string{\"Az-09._\", \"aZ-09._\", \"AZ-09._\"} {\n72|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrAmbiguous) {\n73|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n74|\t\t\t\t}\n75|\t\t\t\tif _, err := r.Status(query); !errors.Is(err, ErrAmbiguous) {\n76|\t\t\t\t\tt.Fatalf(\"status %q: %v\", query, err)\n77|\t\t\t\t}\n78|\t\t\t}\n79|\t\t})\n80|\t}\n81|}\n82|\n83|func TestResolveAllowlistAndReadFailures(t *testing.T) {\n84|\tlocal, root := repository(t)\n85|\tpeer, peerRoot := repository(t)\n86|\tcreate(t, local, idA, \"Local\")\n87|\tcreate(t, peer, idB, idA)\n88|\tr := &Reader{Local: local, Peers: []PeerIndex{{hostA, peer}}}\n89|\tgot, err := r.Resolve(idA)\n90|\tif err != nil || got.SessionID != idA {\n91|\t\tt.Fatalf(\"unallowlisted peer affected UUID: %+v %v\", got, err)\n92|\t}\n93|\t// No learned index is absence; a known index whose read fails is not.\n94|\tr.AllowlistedPeerIDs = []string{hostB}\n95|\tgot, err = r.Resolve(idA)\n96|\tif err != nil || got.SessionID != idA {\n97|\t\tt.Fatalf(\"absent learned index: %+v %v\", got, err)\n98|\t}\n99|\tr.AllowlistedPeerIDs = []string{hostA}\n100|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n101|\t\tt.Fatal(err)\n102|\t}\n103|\tif _, err := r.Resolve(idA); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n104|\t\tt.Fatalf(\"failed peer read fell through: %v\", err)\n105|\t}\n106|\t// Local exact name does not depend on lower-tier reads.\n107|\tif _, err := r.Resolve(\"Local\"); err != nil {\n108|\t\tt.Fatal(err)\n109|\t}\n110|\tif err := os.WriteFile(filepath.Join(peerRoot, \"sessions\"), []byte(\"not a directory\"), 0600); err != nil {\n111|\t\tt.Fatal(err)\n112|\t}\n113|\tif _, err := r.Status(idA); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n114|\t\tt.Fatalf(\"non-directory read: %v\", err)\n115|\t}\n116|\tr.Peers = []PeerIndex{{hostA, nil}}\n117|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrUnavailable) {\n118|\t\tt.Fatalf(\"nil learned index: %v\", err)\n119|\t}\n120|\tr.Peers = []PeerIndex{{hostA, nil}, {hostA, peer}}\n121|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrUnavailable) {\n122|\t\tt.Fatalf(\"duplicate learned index: %v\", err)\n123|\t}\n124|\tif err := os.RemoveAll(filepath.Join(root, \"sessions\")); err != nil {\n125|\t\tt.Fatal(err)\n126|\t}\n127|\tif _, err := r.List(); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n128|\t\tt.Fatalf(\"missing local root: %v\", err)\n129|\t}\n130|\tif _, err := r.Resolve(\"Local\"); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n131|\t\tt.Fatalf(\"missing root became not found: %v\", err)\n132|\t}\n133|}\n134|\n135|func TestResolvePeerOrderAndReplicatedIdentity(t *testing.T) {\n136|\tlocal, _ := repository(t)\n137|\ta, _ := repository(t)\n138|\tb, _ := repository(t)\n139|\tcreate(t, a, idA, \"Shared\")\n140|\tcreate(t, b, idA, \"Shared\")\n141|\tr := &Reader{Local: local, AllowlistedPeerIDs: []string{hostB, hostA, hostB}, Peers: []PeerIndex{{hostB, b}, {hostA, a}}}\n142|\tfirst, err := r.Resolve(\"Shared\")\n143|\tif err != nil || first.PeerHostID != hostA {\n144|\t\tt.Fatalf(\"replicated identity: %+v %v\", first, err)\n145|\t}\n146|\tr.Peers[0], r.Peers[1] = r.Peers[1], r.Peers[0]\n147|\tsecond, err := r.Resolve(\"Shared\")\n148|\tif err != nil || !reflect.DeepEqual(first, second) {\n149|\t\tt.Fatalf(\"permutation changed selection: %+v %v\", second, err)\n150|\t}\n151|\tcreate(t, b, idB, \"sHARED\")\n152|\tif _, err := r.Resolve(\"Shared\"); !errors.Is(err, ErrAmbiguous) {\n153|\t\tt.Fatalf(\"cross-peer collision: %v\", err)\n154|\t}\n155|}\n156|\n157|func TestListStatusDerivedFactsAndStableOrder(t *testing.T) {\n158|\trepo, _ := repository(t)\n159|\tcreate(t, repo, idB, \"Zed\")\n160|\tref := create(t, repo, idA, \"Alpha\")\n161|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n162|\tr := &Reader{Local: repo, LocalHostID: hostA}\n163|\tlist, err := r.List()\n164|\tif err != nil || len(list) != 2 {\n165|\t\tt.Fatalf(\"List: %+v %v\", list, err)\n166|\t}\n167|\tif list[0].Projection.SessionID != idA || list[1].Projection.SessionID != idB {\n168|\t\tt.Fatalf(\"order: %+v\", list)\n169|\t}\n170|\tp := list[0].Projection\n171|\tif p.Name != \"Alpha\" || p.Kind != \"direct\" || p.Provider.ID != \"codex\" || p.State != sessstate.StateCreating || p.OwnerHostID != hostA || p.LocalRole != \"owner\" || p.Winner.LeaseID != lease || p.Winner.Epoch != 1 {\n172|\t\tt.Fatalf(\"derived summary: %+v\", p)\n173|\t}\n174|\tunknown := list[1].Projection\n175|\tif unknown.OwnerHostID != \"\" || unknown.LocalRole != \"\" || !unknown.Winner.IsZero() {\n176|\t\tt.Fatalf(\"invented unknown owner: %+v\", unknown)\n177|\t}\n178|\tfor _, selector := range []string{\"Alpha\", idA} {\n179|\t\tstatus, err := r.Status(selector)\n180|\t\tif err != nil || !reflect.DeepEqual(status, list[0]) {\n181|\t\t\tt.Fatalf(\"status disagrees: %+v %v\", status, err)\n182|\t\t}\n183|\t}\n184|\tagain, err := r.List()\n185|\tif err != nil || !reflect.DeepEqual(list, again) {\n186|\t\tt.Fatalf(\"read is not idempotent: %+v %v\", again, err)\n187|\t}\n188|\tr.LocalHostID = hostB\n189|\tstatus, err := r.Status(idA)\n190|\tif err != nil || status.Projection.LocalRole != \"replica\" {\n191|\t\tt.Fatalf(\"replica: %+v %v\", status, err)\n192|\t}\n193|}\n194|\n195|func TestParkedReadRecoveryAndMissingVsMalformed(t *testing.T) {\n196|\trepo, root := repository(t)\n197|\traw := record(t, idA, \"Parked\")\n198|\trepo.AfterCreateStep = func(step sessrepo.CreateStep) error {\n199|\t\tif step == sessrepo.CreateStepRecord {\n200|\t\t\treturn errors.New(\"crash\")\n201|\t\t}\n202|\t\treturn nil\n203|\t}\n204|\tif _, err := repo.CreateSession(raw); err == nil {\n205|\t\tt.Fatal(\"fault did not fire\")\n206|\t}\n207|\tcreateHealthy := func() { repo.AfterCreateStep = nil; create(t, repo, idB, \"Healthy\") }\n208|\tcreateHealthy()\n209|\tr := &Reader{Local: repo}\n210|\tlist, err := r.List()\n211|\tif err != nil || len(list) != 2 || list[0].Projection.Parked == nil {\n212|\t\tt.Fatalf(\"parked omitted: %+v %v\", list, err)\n213|\t}\n214|\tif _, err := r.Resolve(\"Parked\"); !errors.Is(err, ErrNotFound) {\n215|\t\tt.Fatalf(\"parked routed: %v\", err)\n216|\t}\n217|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrNotFound) {\n218|\t\tt.Fatalf(\"parked UUID routed: %v\", err)\n219|\t}\n220|\tif _, err := r.Resolve(\"Healthy\"); err != nil {\n221|\t\tt.Fatal(err)\n222|\t}\n223|\tparked, err := r.InspectLocal(idA)\n224|\tif err != nil || parked.Projection.Parked == nil || parked.Projection.Parked.RetryHint == \"\" {\n225|\t\tt.Fatalf(\"parked status: %+v %v\", parked, err)\n226|\t}\n227|\tif _, err := repo.CreateSession(raw); err != nil {\n228|\t\tt.Fatal(err)\n229|\t}\n230|\tif _, err := r.Status(\"Parked\"); err != nil {\n231|\t\tt.Fatal(err)\n232|\t}\n233|\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), []byte(\"malformed\"), 0600); err != nil {\n234|\t\tt.Fatal(err)\n235|\t}\n236|\tdamaged, err := r.InspectLocal(idA)\n237|\tif err != nil || damaged.Projection.State != sessstate.StateParked || damaged.Projection.Parked.BlockingReason == \"\" {\n238|\t\tt.Fatalf(\"malformed treated as absent: %+v %v\", damaged, err)\n239|\t}\n240|\tif _, err := r.InspectLocal(hostA); !errors.Is(err, sessstate.ErrUnknownSession) {\n241|\t\tt.Fatalf(\"missing: %v\", err)\n242|\t}\n243|}\n244|\n245|func TestReaderAbsentAndNil(t *testing.T) {\n246|\tfor _, r := range []*Reader{nil, {}} {\n247|\t\tif _, err := r.List(); !errors.Is(err, ErrUnavailable) {\n248|\t\t\tt.Fatal(err)\n249|\t\t}\n250|\t\tif _, err := r.InspectLocal(idA); !errors.Is(err, ErrUnavailable) {\n251|\t\t\tt.Fatal(err)\n252|\t\t}\n253|\t\tif _, err := r.Status(idA); !errors.Is(err, ErrUnavailable) {\n254|\t\t\tt.Fatal(err)\n255|\t\t}\n256|\t}\n257|\trepo, _ := repository(t)\n258|\trows, err := (&Reader{Local: repo}).List()\n259|\tif err != nil || rows == nil || len(rows) != 0 {\n260|\t\tt.Fatalf(\"empty: %+v %v\", rows, err)\n261|\t}\n262|\tif _, err := (&Reader{Local: repo}).Status(idA); !errors.Is(err, ErrNotFound) {\n263|\t\tt.Fatal(err)\n264|\t}\n265|}\n266|\n267|func TestResolveExcludesTombstonedButListsIt(t *testing.T) {\n268|\trepo, _ := repository(t)\n269|\tref := create(t, repo, idA, \"Deleted\")\n270|\tevent := appendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n271|\tevent = appendEvent(t, repo, idA, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n272|\tappendEvent(t, repo, idA, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n273|\tr := &Reader{Local: repo}\n274|\trows, err := r.List()\n275|\tif err != nil || len(rows) != 1 || rows[0].Projection.State != sessstate.StateTombstoned {\n276|\t\tt.Fatalf(\"tombstone lost: %+v %v\", rows, err)\n277|\t}\n278|\tfor _, selector := range []string{\"Deleted\", idA} {\n279|\t\tif _, err := r.Resolve(selector); !errors.Is(err, ErrNotFound) {\n280|\t\t\tt.Fatalf(\"tombstone routed: %v\", err)\n281|\t\t}\n282|\t}\n283|}\n284|\n285|func TestListStatusCheckpointAndProjectionFailure(t *testing.T) {\n286|\trepo, _ := repository(t)\n287|\tref := create(t, repo, idA, \"Checkpointed\")\n288|\tprevious := ref.RecordID\n289|\trows := []struct {\n290|\t\ttyp     string\n291|\t\tpayload map[string]any\n292|\t}{\n293|\t\t{\"session.created\", map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB}},\n294|\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n295|\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n296|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n297|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n298|\t\t{\"session.stopped\", map[string]any{\"graceful\": true, \"checkpoint_id\": zeroDigest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}},\n299|\t}\n300|\tfor index, row := range rows {\n301|\t\tprevious = appendEvent(t, repo, idA, previous, row.typ, index+1, row.payload)\n302|\t}\n303|\tr := &Reader{Local: repo, LocalHostID: hostA}\n304|\tstatus, err := r.Status(\"Checkpointed\")\n305|\tif err != nil || status.Projection.State != sessstate.StateStopped || !status.Projection.HasCheckpoint || status.Projection.Newest.ID != zeroDigest || status.Projection.Provider.Version != \"0.147.0\" {\n306|\t\tt.Fatalf(\"checkpoint summary: %+v %v\", status, err)\n307|\t}\n308|\tlist, err := r.List()\n309|\tif err != nil || len(list) != 1 || !reflect.DeepEqual(list[0], status) {\n310|\t\tt.Fatalf(\"checkpoint list/status disagreement: %+v %v\", list, err)\n311|\t}\n312|\t// Repository continuity admits this event; the state owner's terminal-state\n313|\t// transition gate refuses it. That failure must reach the read entry unchanged.\n314|\tappendEvent(t, repo, idA, previous, \"session.created\", 7, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n315|\tif _, err := r.List(); err == nil {\n316|\t\tt.Fatal(\"invalid projection was returned as a summary\")\n317|\t}\n318|\tif _, err := r.Status(idA); err == nil || errors.Is(err, ErrNotFound) {\n319|\t\tt.Fatalf(\"invalid projection became absence: %v\", err)\n320|\t}\n321|}","final_result":true}}}
