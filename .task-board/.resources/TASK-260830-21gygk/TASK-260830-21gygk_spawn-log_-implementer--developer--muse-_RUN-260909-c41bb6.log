n179|\t}\n180|\tif match, found, err := matchName(peers, selector); found || err != nil {\n181|\t\treturn match, err\n182|\t}\n183|\tif id, err := scalar.ParseUUIDv7(selector); err == nil {\n184|\t\tfor _, item := range append(candidates, peers...) {\n185|\t\t\tif item.selection.SessionID == id.String() {\n186|\t\t\t\treturn item.selection, nil\n187|\t\t\t}\n188|\t\t}\n189|\t}\n190|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, selector)\n191|}\n192|\n193|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n194|\tout := make([]candidate, 0, len(rows))\n195|\tfor _, row := range rows {\n196|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n197|\t\t\tcontinue\n198|\t\t}\n199|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n200|\t}\n201|\treturn out\n202|}\n203|\n204|func (reader *Reader) peerCandidates() ([]candidate, error) {\n205|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n206|\tsort.Strings(ids)\n207|\tvar out []candidate\n208|\tfor index, id := range ids {\n209|\t\tif index > 0 && id == ids[index-1] {\n210|\t\t\tcontinue\n211|\t\t}\n212|\t\tvar repo *sessrepo.Repository\n213|\t\tfound := false\n214|\t\tfor _, peer := range reader.Peers {\n215|\t\t\tif peer.HostID != id {\n216|\t\t\t\tcontinue\n217|\t\t\t}\n218|\t\t\tif found {\n219|\t\t\t\treturn nil, fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, id)\n220|\t\t\t}\n221|\t\t\tfound = true\n222|\t\t\trepo = peer.Repo\n223|\t\t}\n224|\t\t// An allowlisted peer with no learned index contributes no learned names.\n225|\t\t// A listed index with an unavailable repository is a failed observation.\n226|\t\tif !found {\n227|\t\t\tcontinue\n228|\t\t}\n229|\t\tif repo == nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
