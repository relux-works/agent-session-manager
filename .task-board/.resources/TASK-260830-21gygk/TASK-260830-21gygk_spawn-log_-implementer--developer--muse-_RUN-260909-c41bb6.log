[string]string{hostA: \"workstation\"},\n+\t}\n+\treturn reader, peerRoot, peerRoot\n+}\n+\n+// peerRepository reopens the peer handle from a qualified reader for\n+// failure injection. The reader keeps its original handle; the root\n+// lets the test break the underlying store.\n+func reopenPeer(t *testing.T, root string) *sessrepo.Repository {\n+\tt.Helper()\n+\tpeer, err := sessrepo.Open(root)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\treturn peer\n+}\n","final_result":true}}}
