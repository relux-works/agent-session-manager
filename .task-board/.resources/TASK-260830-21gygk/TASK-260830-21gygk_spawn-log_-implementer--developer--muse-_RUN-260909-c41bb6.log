{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca5f","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":906,"recorded_at":1780531400001807,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a0878a-dab8-7ce3-92a8-2714df4eb450"},"task_id":"01a0878a-dab8-7ce3-92a8-2714df4eb450","event":{"kind":"output","task_id":"01a0878a-dab8-7ce3-92a8-2714df4eb450","chunk":"Read text file `internal/sessstate/project.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n5|)\n6|\n7|// Projector binds the pure reducer to one repository. It only reads:\n8|// ListSessions locates the session (and its parked channel), GetRecord\n9|// and ListEvents with GetEvent load the authoritative bytes, and\n10|// Decode plus Reduce derive the projection. No entry here mutates\n11|// durable state, so there is no crash window to arm: placing\n12|// secconftest points around reads would measure nothing, and a crashed\n13|// read retries as the same read. Idempotency is the reducer's purity —\n14|// projecting twice yields the identical projection — pinned by\n15|// TestProjectIsIdempotentAcrossReads.\n16|type Projector struct {\n17|\t// Repo is the session repository to project from. It is required.\n18|\tRepo *sessrepo.Repository\n19|\t// LocalHostID selects the local role: the owner host of the\n20|\t// newest authoritative event decides owner against replica. Empty\n21|\t// leaves the role unknown rather than guessing.\n22|\tLocalHostID string\n23|\t// Union carries competing off-chain leases observed at mesh union\n24|\t// for winner resolution. Nil projects the chain alone.\n25|\tUnion []LeaseHead\n26|\t// Local is the lease the local host acts under for the stale\n27|\t// projection. Zero disables the stale override.\n28|\tLocal LeaseHead\n29|}\n30|\n31|// Project derives the session projection for one session ID. A parked\n32|// session returns the parked state with its blocking reason and retry,\n33|// never an error or an omission; an ID with no listing entry refuses\n34|// unknown. The listing therefore tells a parked name apart from a\n35|// missing one with no sessrepo interface change.\n36|func (projector *Projector) Project(sessionID string) (Projection, error) {\n37|\tif projector == nil || projector.Repo == nil {\n38|\t\treturn Projection{}, refuse(ErrDerivation, \"projector carries no repository\")\n39|\t}\n40|\tsummaries, err := projector.Repo.ListSessions()\n41|\tif err != nil {\n42|\t\treturn Projection{}, err\n43|\t}\n44|\tvar found *sessrepo.SessionSummary\n45|\tfor index := range summaries {\n46|\t\tif summaries[index].SessionID == sessionID {\n47|\t\t\tfound = &summaries[index]\n48|\t\t\tbreak\n49|\t\t}\n50|\t}\n51|\tif found == nil {\n52|\t\treturn Projection{}, refuse(ErrUnknownSession, \"no session %s\", sessionID)\n53|\t}\n54|\tif found.Parked {\n55|\t\treturn Reduce(Input{\n56|\t\t\tRecord: Record{\n57|\t\t\t\tSessionID:  found.SessionID,\n58|\t\t\t\tRecordID:   found.RecordID,\n59|\t\t\t\tName:       found.Name,\n60|\t\t\t\tKind:       found.Kind,\n61|\t\t\t\tProviderID: found.ProviderID,\n62|\t\t\t},\n63|\t\t\tParked: &ParkedFacts{\n64|\t\t\t\tBlockingReason: found.BlockingReason,\n65|\t\t\t\tRetryHint:      found.RetryHint,\n66|\t\t\t},\n67|\t\t})\n68|\t}\n69|\trecordBytes, err := projector.Repo.GetRecord(sessionID)\n70|\tif err != nil {\n71|\t\treturn Projection{}, err\n72|\t}\n73|\trecord, err := DecodeRecord(recordBytes)\n74|\tif err != nil {\n75|\t\treturn Projection{}, err\n76|\t}\n77|\tindexed, err := projector.Repo.ListEvents(sessionID)\n78|\tif err != nil {\n79|\t\treturn Projection{}, err\n80|\t}\n81|\tevents := make([]Event, 0, len(indexed))\n82|\tfor _, summary := range indexed {\n83|\t\tblob, err := projector.Repo.GetEvent(sessionID, summary.EventID)\n84|\t\tif err != nil {\n85|\t\t\treturn Projection{}, err\n86|\t\t}\n87|\t\tevent, err := DecodeEvent(blob)\n88|\t\tif err != nil {\n89|\t\t\treturn Projection{}, err\n90|\t\t}\n91|\t\tevents = append(events, event)\n92|\t}\n93|\treturn Reduce(Input{\n94|\t\tRecord:      record,\n95|\t\tEvents:      events,\n96|\t\tUnion:       append([]LeaseHead(nil), projector.Union...),\n97|\t\tLocal:       projector.Local,\n98|\t\tLocalHostID: projector.LocalHostID,\n99|\t})\n100|}","final_result":true}}}
