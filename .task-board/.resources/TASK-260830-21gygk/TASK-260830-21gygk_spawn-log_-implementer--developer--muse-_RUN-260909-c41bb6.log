{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d9","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":199,"recorded_at":1780531400000393,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a08788-2d26-7352-8f15-7b56f84a91ed"},"task_id":"01a08788-2d26-7352-8f15-7b56f84a91ed","event":{"kind":"output","task_id":"01a08788-2d26-7352-8f15-7b56f84a91ed","chunk":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery composes the session repository and state projector for\n2|// read-only NAME/UUID resolution and local list/status summaries. It implements\n3|// the specified portions of TASK-260830-21gygk against SPEC v0.5.0 Sections 2.3,\n4|// 5.1–5.2, 5.7 and 14.4. It defines no qualified-selector grammar or action route.\n5|package sessquery\n6|\n7|import (\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"sort\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|var (\n18|\tErrUnavailable = errors.New(\"session index unavailable\")\n19|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n20|\tErrNotFound    = sessrepo.ErrNameNotFound\n21|)\n22|\n23|// PeerIndex binds a peer identity to its already persisted learned index.\n24|// Transport/authentication and installing peer indexes are upstream owners;\n25|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n26|type PeerIndex struct {\n27|\tHostID string\n28|\tRepo   *sessrepo.Repository\n29|}\n30|\n31|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n32|// configuration layer, separately from the learned indexes. An unlisted source\n33|// is never read. Failed reads from listed sources are errors, never\n34|// empty indexes that let resolution fall through to a lower-priority UUID.\n35|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n36|type Reader struct {\n37|\tLocal              *sessrepo.Repository\n38|\tLocalHostID        string\n39|\tAllowlistedPeerIDs []string\n40|\tPeers              []PeerIndex\n41|}\n42|\n43|// Summary contains only facts derived from verified session records and events.\n44|// It is an internal read model, not the closed Section 14.2 CLI SessionSummary.\n45|// Unknown owner/lease and parked diagnostics remain explicit in Projection.\n46|// Host display names, checkpoint timestamps/age, workspace state, capabilities,\n47|// process liveness and sync timestamps require their respective observation\n48|// owners and are deliberately not inferred from a record or a successful read.\n49|type Summary struct {\n50|\tProjection sessstate.Projection\n51|}\n52|\n53|// List reads local summaries in bytewise session-ID order. Parked sessions stay\n54|// visible with their blocking reason and retry; failure to enumerate the index\n55|// fails the read. No durable state is written, even for an interrupted create.\n56|func (reader *Reader) List() ([]Summary, error) {\n57|\tif reader == nil || reader.Local == nil {\n58|\t\treturn nil, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n59|\t}\n60|\treturn reader.read(reader.Local)\n61|}\n62|\n63|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n64|\trows, err := repo.ListSessions()\n65|\tif err != nil {\n66|\t\treturn nil, err\n67|\t}\n68|\tout := make([]Summary, 0, len(rows))\n69|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n70|\tfor _, row := range rows {\n71|\t\tprojection, err := projector.Project(row.SessionID)\n72|\t\tif err != nil {\n73|\t\t\treturn nil, err\n74|\t\t}\n75|\t\tout = append(out, Summary{Projection: projection})\n76|\t}\n77|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n78|\treturn out, nil\n79|}\n80|\n81|// Status resolves a NAME/UUID through the same path as Resolve, then projects\n82|// from the selected repository. It never treats a failed read as not found.\n83|// Parked sessions can be inspected by ID through InspectLocal, independently of\n84|// live-name routing, so operators retain access to the recovery diagnostics.\n85|func (reader *Reader) Status(selector string) (Summary, error) {\n86|\tselected, err := reader.Resolve(selector)\n87|\tif err != nil {\n88|\t\treturn Summary{}, err\n89|\t}\n90|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n91|\tif err != nil {\n92|\t\treturn Summary{}, err\n93|\t}\n94|\treturn Summary{Projection: projection}, nil\n95|}\n96|\n97|// InspectLocal reads one local ID, including a parked or tombstoned session.\n98|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n99|\tif reader == nil || reader.Local == nil {\n100|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n101|\t}\n102|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n103|\tif err != nil {\n104|\t\treturn Summary{}, err\n105|\t}\n106|\treturn Summary{Projection: projection}, nil\n107|}\n108|\n109|// Selection identifies the session and source index, never an attach or mutation\n110|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n111|type Selection struct {\n112|\tSessionID  string\n113|\tPeerHostID string\n114|\trepo       *sessrepo.Repository\n115|}\n116|\n117|type candidate struct {\n118|\tsummary   Summary\n119|\tselection Selection\n120|}\n121|\n122|// Resolve applies the Section 2.3 tiers: local exact live name, allowlisted\n123|// peer exact live name, exact UUID, not found. ASCII folding detects collisions\n124|// within each name tier; it does not turn a unique case variant into an exact\n125|// match. Repository-parked and tombstoned entries are not live-name candidates.\n126|// This is logical index eligibility, not proof of process liveness or safe\n127|// attach/resume readiness; those decisions belong to the action planner.\n128|func (reader *Reader) Resolve(selector string) (Selection, error) {\n129|\tlocal, err := reader.List()\n130|\tif err != nil {\n131|\t\treturn Selection{}, err\n132|\t}\n133|\tcandidates := liveCandidates(local, reader.Local, \"\")\n134|\tif match, found, err := matchName(candidates, selector); found || err != nil {\n135|\t\treturn match, err\n136|\t}\n137|\tpeers, err := reader.peerCandidates()\n138|\tif err != nil {\n139|\t\treturn Selection{}, err\n140|\t}\n141|\tif match, found, err := matchName(peers, selector); found || err != nil {\n142|\t\treturn match, err\n143|\t}\n144|\tif id, err := scalar.ParseUUIDv7(selector); err == nil {\n145|\t\tfor _, item := range append(candidates, peers...) {\n146|\t\t\tif item.selection.SessionID == id.String() {\n147|\t\t\t\treturn item.selection, nil\n148|\t\t\t}\n149|\t\t}\n150|\t}\n151|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, selector)\n152|}\n153|\n154|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n155|\tout := make([]candidate, 0, len(rows))\n156|\tfor _, row := range rows {\n157|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n158|\t\t\tcontinue\n159|\t\t}\n160|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n161|\t}\n162|\treturn out\n163|}\n164|\n165|func (reader *Reader) peerCandidates() ([]candidate, error) {\n166|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n167|\tsort.Strings(ids)\n168|\tvar out []candidate\n169|\tfor index, id := range ids {\n170|\t\tif index > 0 && id == ids[index-1] {\n171|\t\t\tcontinue\n172|\t\t}\n173|\t\tvar repo *sessrepo.Repository\n174|\t\tfound := false\n175|\t\tfor _, peer := range reader.Peers {\n176|\t\t\tif peer.HostID != id {\n177|\t\t\t\tcontinue\n178|\t\t\t}\n179|\t\t\tif found {\n180|\t\t\t\treturn nil, fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, id)\n181|\t\t\t}\n182|\t\t\tfound = true\n183|\t\t\trepo = peer.Repo\n184|\t\t}\n185|\t\t// An allowlisted peer with no learned index contributes no learned names.\n186|\t\t// A listed index with an unavailable repository is a failed observation.\n187|\t\tif !found {\n188|\t\t\tcontinue\n189|\t\t}\n190|\t\tif repo == nil {\n191|\t\t\treturn nil, fmt.Errorf(\"%w: unreadable index for peer %s\", ErrUnavailable, id)\n192|\t\t}\n193|\t\trows, err := reader.read(repo)\n194|\t\tif err != nil {\n195|\t\t\treturn nil, err\n196|\t\t}\n197|\t\tout = append(out, liveCandidates(rows, repo, id)...)\n198|\t}\n199|\treturn out, nil\n200|}\n201|\n202|func matchName(items []candidate, selector string) (Selection, bool, error) {\n203|\t// A replicated session is one identity, regardless of how many peers learned\n204|\t// it. Distinct session IDs in the folded bucket are an ambiguity.\n205|\tids := make(map[string]struct{})\n206|\tvar exact *Selection\n207|\tfor _, item := range items {\n208|\t\tif asciiFold(item.summary.Projection.Name) != asciiFold(selector) {\n209|\t\t\tcontinue\n210|\t\t}\n211|\t\tids[item.selection.SessionID] = struct{}{}\n212|\t\tif item.summary.Projection.Name == selector && exact == nil {\n213|\t\t\tselection := item.selection\n214|\t\t\texact = &selection\n215|\t\t}\n216|\t}\n217|\tif len(ids) > 1 {\n218|\t\treturn Selection{}, false, fmt.Errorf(\"%w: name %q collides across %d sessions\", ErrAmbiguous, selector, len(ids))\n219|\t}\n220|\tif exact != nil {\n221|\t\treturn *exact, true, nil\n222|\t}\n223|\treturn Selection{}, false, nil\n224|}\n225|\n226|func asciiFold(value string) string {\n227|\tfolded := []byte(value)\n228|\tfor index, character := range folded {\n229|\t\tif character >= 'A' && character <= 'Z' {\n230|\t\t\tfolded[index] += 'a' - 'A'\n231|\t\t}\n232|\t}\n233|\treturn string(folded)\n234|}","final_result":true}}}
