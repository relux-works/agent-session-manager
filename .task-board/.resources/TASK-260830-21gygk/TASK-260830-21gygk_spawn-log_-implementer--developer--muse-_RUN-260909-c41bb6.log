{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a1","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":811,"recorded_at":1780531400001617,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a0878a-8aec-7092-8862-fced9ae358f1"},"task_id":"01a0878a-8aec-7092-8862-fced9ae358f1","event":{"kind":"output","task_id":"01a0878a-8aec-7092-8862-fced9ae358f1","chunk":"Read text file `internal/sessrepo/store.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// syncDirectory fsyncs a directory so a rename inside it survives a crash.\n14|// Opening a directory fails on Windows, where the rename itself is the\n15|// durability boundary; there the sync is skipped, never faked.\n16|func syncDirectory(path string) error {\n17|\tif runtime.GOOS == \"windows\" {\n18|\t\treturn nil\n19|\t}\n20|\tdirectory, err := os.Open(path)\n21|\tif err != nil {\n22|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n23|\t}\n24|\tdefer func() { _ = directory.Close() }()\n25|\tif err := directory.Sync(); err != nil {\n26|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n27|\t}\n28|\treturn nil\n29|}\n30|\n31|// GetRecord returns the byte-identical Session Record for a session,\n32|// re-verified through the canonical owner on every read.\n33|func (repository *Repository) GetRecord(sessionID string) ([]byte, error) {\n34|\trepository.mutex.Lock()\n35|\tdefer repository.mutex.Unlock()\n36|\tview, err := repository.loadSessionLocked(sessionID)\n37|\tif err != nil {\n38|\t\treturn nil, err\n39|\t}\n40|\treturn append([]byte(nil), view.record.raw...), nil\n41|}\n42|\n43|// GetEvent returns the byte-identical chained event for its digest.\n44|func (repository *Repository) GetEvent(sessionID, eventID string) ([]byte, error) {\n45|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n46|\t\treturn nil, refuse(ErrUnknownEvent, \"malformed event id %q\", eventID)\n47|\t}\n48|\trepository.mutex.Lock()\n49|\tdefer repository.mutex.Unlock()\n50|\tview, err := repository.loadSessionLocked(sessionID)\n51|\tif err != nil {\n52|\t\treturn nil, err\n53|\t}\n54|\tfor _, indexed := range view.chain.Events {\n55|\t\tif indexed.EventID == eventID {\n56|\t\t\tblob, err := os.ReadFile(filepath.Join(view.directory, \"events\", blobFileName(eventID)))\n57|\t\t\tif err != nil {\n58|\t\t\t\treturn nil, fmt.Errorf(\"read chained event for session %s: %w\", sessionID, err)\n59|\t\t\t}\n60|\t\t\treturn blob, nil\n61|\t\t}\n62|\t}\n63|\treturn nil, refuse(ErrUnknownEvent, \"unknown event %q in session %s\", eventID, sessionID)\n64|}\n65|\n66|// ListEvents returns the chain summaries in authoritative order.\n67|func (repository *Repository) ListEvents(sessionID string) ([]EventSummary, error) {\n68|\trepository.mutex.Lock()\n69|\tdefer repository.mutex.Unlock()\n70|\tview, err := repository.loadSessionLocked(sessionID)\n71|\tif err != nil {\n72|\t\treturn nil, err\n73|\t}\n74|\treturn append([]EventSummary(nil), view.chain.Events...), nil\n75|}\n76|\n77|// ListSessions returns one summary per stored session in session-ID order,\n78|// healthy sessions first-class and parked sessions on the per-session\n79|// parked channel. A session whose bytes no longer verify never fails the\n80|// listing for its siblings: it is returned as a parked entry (Parked=true)\n81|// carrying the blocking reason and the same-operation retry the Section\n82|// 5.7 reducer and the Section 14.4 rendering leaves project into the\n83|// parked lifecycle state and its warnings. Only a failure to read the\n84|// sessions root itself is a listing error.\n85|//\n86|// Decision record (SPEC.md:9082, Section 13.13 recoverable_parked_state;\n87|// Section 14.4 per-session warnings): the prior closed-listing rule failed\n88|// the whole repository — one parked session removed every healthy sibling\n89|// from listing and name resolution, and only the byte-identical original\n90|// record healed it, so lost bytes bricked the repository permanently with\n91|// no per-session channel for downstream leaves to render. Per-session\n92|// parked reporting keeps healthy sessions listable and resolvable while\n93|// the parked session stays visible with its reason and retry. The tradeoff\n94|// is that callers must check Parked instead of relying on an error: a\n95|// listing with parked entries returns nil error by design. See doc.go for\n96|// the retry table and the operator remedy when no retry heals.\n97|func (repository *Repository) ListSessions() ([]SessionSummary, error) {\n98|\trepository.mutex.Lock()\n99|\tdefer repository.mutex.Unlock()\n100|\treturn repository.listSessionsLocked()\n101|}\n102|\n103|// Resolve implements the local steps of SPEC.md Section 2.3: an exact live\n104|// session name in the local index wins first; a UUID query routes to its\n105|// session; anything else is not found. Names display with original case\n106|// but collide under ASCII case folding because the allowed alphabet is\n107|// ASCII, and a colliding query fails with ErrNameAmbiguous. Parked\n108|// sessions never participate: listing reports them per session, but name\n109|// resolution routes only healthy sessions, so one parked sibling cannot\n110|// deny service to the rest. A query naming only a parked session is not\n111|// found. Peer-learned names and the interactive choice surface belong to\n112|// the name-resolution leaf, which builds on this entry.\n113|func (repository *Repository) Resolve(query string) (SessionSummary, error) {\n114|\trepository.mutex.Lock()\n115|\tdefer repository.mutex.Unlock()\n116|\tsummaries, err := repository.listSessionsLocked()\n117|\tif err != nil {\n118|\t\treturn SessionSummary{}, err\n119|\t}\n120|\tvar live []SessionSummary\n121|\tfor _, summary := range summaries {\n122|\t\tif !summary.Parked {\n123|\t\t\tlive = append(live, summary)\n124|\t\t}\n125|\t}\n126|\tvar folded []SessionSummary\n127|\tfor _, summary := range live {\n128|\t\tif asciiFold(summary.Name) == asciiFold(query) {\n129|\t\t\tfolded = append(folded, summary)\n130|\t\t}\n131|\t}\n132|\tif len(folded) > 1 {\n133|\t\treturn SessionSummary{}, refuse(ErrNameAmbiguous, \"name %q collides across %d sessions\", query, len(folded))\n134|\t}\n135|\tif len(folded) == 1 && folded[0].Name == query {\n136|\t\treturn folded[0], nil\n137|\t}\n138|\tif id, err := scalar.ParseUUIDv7(query); err == nil {\n139|\t\tfor _, summary := range live {\n140|\t\t\tif summary.SessionID == id.String() {\n141|\t\t\t\treturn summary, nil\n142|\t\t\t}\n143|\t\t}\n144|\t}\n145|\treturn SessionSummary{}, refuse(ErrNameNotFound, \"no live session named %q\", query)\n146|}\n147|\n148|// listSessionsLocked shares the listing scan with Resolve without\n149|// re-locking. Per-session load failures become parked entries; only the\n150|// root read is an error. Callers hold the repository mutex.\n151|func (repository *Repository) listSessionsLocked() ([]SessionSummary, error) {\n152|\tentries, err := os.ReadDir(repository.root)\n153|\tif err != nil {\n154|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n155|\t}\n156|\tvar summaries []SessionSummary\n157|\tfor _, entry := range entries {\n158|\t\tif !entry.IsDir() {\n159|\t\t\tcontinue\n160|\t\t}\n161|\t\tview, err := repository.loadSessionLocked(entry.Name())\n162|\t\tif err != nil {\n163|\t\t\tsummaries = append(summaries, parkedSummary(repository.sessionDir(entry.Name()), entry.Name(), err))\n164|\t\t\tcontinue\n165|\t\t}\n166|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n167|\t\tif len(view.chain.Events) > 0 {\n168|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n169|\t\t}\n170|\t\tsummaries = append(summaries, summary)\n171|\t}\n172|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n173|\treturn summaries, nil\n174|}\n175|\n176|// retryHintForTornStore names the remedy when no same-operation retry can\n177|// heal: the parked bytes are not an interrupted create (the chain index is\n178|// present but the store no longer verifies), so CreateSession cannot\n179|// resume it. The operator remedy is documented in doc.go.\n180|const retryHintForTornStore = \"no CreateSession retry heals this state; see the operator remedy for parked sessions\"\n181|\n182|// parkedSummary builds the per-session parked channel for one load\n183|// failure: the session directory name is always reported, the blocking\n184|// reason names the recoverable_parked_state block with its per-session\n185|// cause, and the retry hint names the same-operation retry when one\n186|// exists. Identity members are filled from the parked record when it\n187|// still verifies; otherwise they stay empty. It reports parked state as\n188|// data and refuses nothing, so the refusal census is unchanged.\n189|func parkedSummary(directory, sessionID string, loadErr error) SessionSummary {\n190|\tsummary := SessionSummary{SessionID: sessionID, Parked: true, BlockingReason: \"recoverable_parked_state: \" + loadErr.Error()}\n191|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); os.IsNotExist(err) {\n192|\t\trecordBytes, readErr := os.ReadFile(filepath.Join(directory, \"record.json\"))\n193|\t\tif readErr != nil {\n194|\t\t\tif !os.IsNotExist(readErr) {\n195|\t\t\t\tsummary.RetryHint = retryHintForTornStore\n196|\t\t\t\treturn summary\n197|\t\t\t}\n198|\t\t\tsummary.RetryHint = retryHintForBareDirectory\n199|\t\t\treturn summary\n200|\t\t}\n201|\t\tif record, decodeErr := decodeSessionRecord(recordBytes); decodeErr == nil {\n202|\t\t\tsummary.RecordID = record.recordID\n203|\t\t\tsummary.Name = record.name\n204|\t\t\tsummary.Kind = record.kind\n205|\t\t\tsummary.ProviderID = record.provider\n206|\t\t}\n207|\t\tsummary.RetryHint = retryHintForParkedRecord\n208|\t\treturn summary\n209|\t}\n210|\tsummary.RetryHint = retryHintForTornStore\n211|\treturn summary\n212|}\n213|\n214|// asciiFold folds ASCII uppercase to lowercase and passes every other byte\n215|// through. Session names match [A-Za-z0-9][A-Za-z0-9._-]{0,63} under the\n216|// shape owner, so the fold domain is ASCII by construction and a Unicode\n217|// fold table would be an unowned duplicate, not a reuse.\n218|func asciiFold(value string) string {\n219|\tfolded := make([]byte, 0, len(value))\n220|\tfor index := 0; index < len(value); index++ {\n221|\t\tcharacter := value[index]\n222|\t\tif character >= 'A' && character <= 'Z' {\n223|\t\t\tcharacter += 'a' - 'A'\n224|\t\t}\n225|\t\tfolded = append(folded, character)\n226|\t}\n227|\treturn string(folded)\n228|}","final_result":true}}}
