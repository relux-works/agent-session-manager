{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d925","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":2797,"recorded_at":1780531400005589,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a0879c-8815-7821-a5b7-a23b1c1e76e8"},"task_id":"01a0879c-8815-7821-a5b7-a23b1c1e76e8","event":{"kind":"output","task_id":"01a0879c-8815-7821-a5b7-a23b1c1e76e8","chunk":"Read text file `internal/sessquery/resolve_test.go`.\n(196 line(s) above)\n197|\tlocal, _ := repository(t)\n198|\tpeer, peerRoot := repository(t)\n199|\t_ = peerRoot\n200|\tcreate(t, local, idA, \"alpha\")\n201|\tcreate(t, local, idB, \"bravo\")\n202|\t// A UUID-shaped local name wins over the UUID identity on the bare\n203|\t// path, while \"id:\" bypasses names for the durable identity.\n204|\tcreate(t, peer, idB, \"remote\")\n205|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n206|\tbyName, err := reader.Resolve(idB)\n207|\tif err != nil || byName.SessionID != idB || byName.PeerHostID != \"\" {\n208|\t\tt.Fatalf(\"bare name-first: %+v %v\", byName, err)\n209|\t}\n210|\t_ = byName\n211|\tbyID, err := reader.Resolve(\"id:\" + idA)\n212|\tif err != nil || byID.SessionID != idA || byID.PeerHostID != \"\" {\n213|\t\tt.Fatalf(\"id: bypass: %+v %v\", byID, err)\n214|\t}\n215|\t// Replicated identical copies are one identity. While the local\n216|\t// host identity is unknown the local copy wins; once configured,\n217|\t// the bytewise smallest holder wins deterministically.\n218|\tcreate(t, peer, idA, \"alpha\")\n219|\tidentical, err := reader.Resolve(\"id:\" + idA)\n220|\tif err != nil || identical.SessionID != idA || identical.PeerHostID != \"\" {\n221|\t\tt.Fatalf(\"replicated unknown-local: %+v %v\", identical, err)\n222|\t}\n223|\treader.LocalHostID = hostB\n224|\ttiebreak, err := reader.Resolve(\"id:\" + idA)\n225|\tif err != nil || tiebreak.SessionID != idA || tiebreak.PeerHostID != hostA {\n226|\t\tt.Fatalf(\"replicated tie break: %+v %v\", tiebreak, err)\n227|\t}\n228|\t// Disagreeing copies of one UUID are inconsistent authority, not an\n229|\t// ambiguity and not a silent first match.\n230|\tother, _ := repository(t)\n231|\tcreate(t, other, idA, \"renamed\")\n232|\treader.Peers = []PeerIndex{{hostA, peer}, {hostB, other}}\n233|\treader.AllowlistedPeerIDs = []string{hostA, hostB}\n234|\tif _, err := reader.Resolve(\"id:\" + idA); !errors.Is(err, sessstate.ErrIntegrity) {\n235|\t\tt.Fatalf(\"disagreeing copies: %v\", err)\n236|\t}\n237|\tif _, err := reader.Resolve(\"renamed\"); !errors.Is(err, sessstate.ErrIntegrity) {\n238|\t\tt.Fatalf(\"disagreeing name win: %v\", err)\n239|\t}\n240|\t// A unique local name win never consults lower tiers, so an\n241|\t// unreadable peer copy behind it is not a conflict.\n242|\treader.Peers = []PeerIndex{{hostA, other}}\n243|\tif _, err := reader.Resolve(\"alpha\"); err != nil {\n244|\t\tt.Fatalf(\"local win with divergent peer copy: %v\", err)\n245|\t}\n246|}","final_result":true}}}
