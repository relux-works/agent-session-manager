{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c523","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":236,"recorded_at":1780531400000467,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a08788-38f9-7a31-bbae-2c2d98c339f5"},"task_id":"01a08788-38f9-7a31-bbae-2c2d98c339f5","event":{"kind":"output","task_id":"01a08788-38f9-7a31-bbae-2c2d98c339f5","chunk":"Read text file `internal/sessquery/bounds_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/cliresult\"\n8|)\n9|\n10|// This is a measured integration bound, not a successful public list claim.\n11|// A valid creating session has no owner event; the wire owner requires known\n12|// owner/lease fields. The read layer must not invent them to obtain green JSON.\n13|func TestCreatingSummaryCannotClaimClosedCLIResult(t *testing.T) {\n14|\trepo, _ := repository(t)\n15|\tcreate(t, repo, idA, \"Creating\")\n16|\trows, err := (&Reader{Local: repo}).List()\n17|\tif err != nil || len(rows) != 1 {\n18|\t\tt.Fatalf(\"List: %+v %v\", rows, err)\n19|\t}\n20|\tp := rows[0].Projection\n21|\tbody := map[string]any{\n22|\t\t\"session_id\": p.SessionID, \"name\": p.Name, \"kind\": p.Kind, \"provider_id\": p.Provider.ID,\n23|\t\t\"owner_host_id\": p.OwnerHostID, \"owner_host_name\": \"\", \"lease_epoch\": p.Winner.Epoch, \"lease_id\": p.Winner.LeaseID,\n24|\t\t\"local_role\": p.LocalRole, \"state\": string(p.State), \"newest_checkpoint_id\": nil, \"newest_checkpoint_created_at\": nil,\n25|\t\t\"workspace_status\": \"absent\", \"capabilities\": map[string]any{}, \"warnings\": []string{},\n26|\t}\n27|\t// The fixture's absent workspace is controlled only for this shape probe;\n28|\t// it is not a production observation or a default in Reader.\n29|\tif _, err := cliresult.New(cliresult.Spec{Command: cliresult.CommandList, Body: map[string]any{\n30|\t\t\"sessions\": []any{body}, \"partial\": false, \"unreachable_peer_ids\": []string{},\n31|\t}}); !errors.Is(err, cliresult.ErrInvalidResult) {\n32|\t\tt.Fatalf(\"unknown owner represented as CLI success: %v\", err)\n33|\t}\n34|}","final_result":true}}}
