{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc9b","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":1192,"recorded_at":1780531400002379,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"call_id":"call_01a0878e2df17882bb6694c3e8f0575b","text":"Read text file `internal/sessquery/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessquery/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|\"\"\"\n6|import hashlib\n7|import json\n8|from pathlib import Path\n9|import re\n10|import shutil\n11|import subprocess\n12|import sys\n13|\n14|root = Path(__file__).resolve().parents[3]\n15|output = Path(sys.argv[1]).resolve()\n16|output.mkdir(parents=True, exist_ok=True)\n17|copy = output / 'mutation-source'\n18|if copy.exists():\n19|    raise SystemExit('refusing to overwrite an existing mutation source')\n20|copy.mkdir()\n21|shutil.copytree(root / 'internal', copy / 'internal')\n22|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n23|    shutil.copy2(root / name, copy / name)\n24|source = copy / 'internal/sessquery/query.go'\n25|base = source.read_text()\n26|repo_source = copy / 'internal/sessrepo/store.go'\n27|repo_base = repo_source.read_text()\n28|results = []\n29|\n30|def run(name, path, old, new, narrow):\n31|    original = path.read_text()\n32|    if original.count(old) != 1:\n33|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n34|        return\n35|    path.write_text(original.replace(old, new))\n36|    command = ['go', 'test', './internal/sessquery', './internal/sessrepo', '-count=1', '-v']\n37|    try:\n38|        with (output / (name + '.log')).open('w') as log:\n39|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=120)\n40|        text = (output / (name + '.log')).read_text()\n41|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n42|        classification = 'SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE')\n43|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n44|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n45|    finally:\n46|        path.write_text(original)\n47|        assert hashlib.sha256(path.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n48|\n49|with (output / 'control-before.log').open('w') as log:\n50|    before = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=120)\n51|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n52|if before.returncode:\n53|    raise SystemExit('baseline failed')\n54|run('N-collision-pair',source,'if len(ids) > 1 {','if len(ids) > 2 {','Allow exactly a two-identity folded bucket; larger buckets still refuse.')\n55|run('N-case-variant',source,'if item.summary.Projection.Name == selector && exact == nil {','if (item.summary.Projection.Name == selector || selector == \"az-09._\") && exact == nil {','Allow the sole non-exact query az-09._ within its folded bucket.')\n56|run('N-parked-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if (row.Projection.Parked != nil && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") || row.Projection.State == sessstate.StateTombstoned {','Allow one parked session identity into live resolution.')\n57|run('N-tombstoned-id',source,'if row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {','if row.Projection.Parked != nil || (row.Projection.State == sessstate.StateTombstoned && row.Projection.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\") {','Allow one tombstoned session identity into live resolution.')\n58|run('N-unlisted-peer',source,'sort.Strings(ids)','ids = append(ids, \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"); sort.Strings(ids)','Read one peer outside the allowlist; all other peer identities still filtered.')\n59|run('N-duplicate-peer',source,'if found {','if found && id != \"0198f4c8-4a10-7b22-8b3c-1234567890ab\" {','Permit duplicate sources for one peer identity, retain duplicate refusal for other identities.')\n60|run('N-read-failure-fallback',source,'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}', 'rows, err := repo.ListSessions()\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, sessrepo.ErrRepositoryPath) { return []Summary{}, nil }; return nil, err\\n\\t}', 'Treat repository-path read failure as empty, while retaining other read refusals.')\n61|run('N-projection-failure-fallback',source,'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}', 'projection, err := projector.Project(row.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\tif row.SessionID == \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" { continue }; return nil, err\\n\\t\\t}', 'Omit one identity on failed projection instead of propagating its failure.')\n62|run('N-repository-case-variant',repo_source,'if len(folded) == 1 && folded[0].Name == query {','if len(folded) == 1 && (folded[0].Name == query || query == \"Payments-API\") {','Allow one non-exact query at the retained repository Resolve entry.')\n63|run('B-peer-order',source,'sort.Strings(ids)','sort.Sort(sort.Reverse(sort.StringSlice(ids)))','Reverse peer-source tie ordering; behavioral determinism fixture must fail.')\n64|run('B-session-order',source,'return out[i].Projection.SessionID < out[j].Projection.SessionID','return out[i].Projection.SessionID > out[j].Projection.SessionID','Reverse session output order; behavioral list fixture must fail.')\n65|run('C-not-applied',source,'TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n66|run('C-compile-failure',source,'package sessquery','package sessquery\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n67|with (output / 'control-after.log').open('w') as log:\n68|    after = subprocess.run(['go','test','./internal/sessquery','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=120)\n69|results.append(dict(mutant='control-after',classification='CONTROL',exit=after.returncode))\n70|assert source.read_text() == base and repo_source.read_text() == repo_base\n71|(output / 'mutants.json').write_text(json.dumps(results,indent=2)+'\\n')\n72|# Controls are reported separately from the applied behavioral denominator.\n73|bad = [row for row in results if row['mutant'].startswith(('N-','B-')) and row['classification'] != 'KILLED']\n74|raise SystemExit(1 if bad or after.returncode else 0)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
