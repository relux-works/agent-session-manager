{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d86b","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":2704,"recorded_at":1780531400005403,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a0879c-50ff-7533-95d1-81f685cc6e8f"},"task_id":"01a0879c-50ff-7533-95d1-81f685cc6e8f","event":{"kind":"output","task_id":"01a0879c-50ff-7533-95d1-81f685cc6e8f","chunk":"Read text file `internal/sessquery/resolve_test.go`.\n(135 line(s) above)\n136|\n137|func TestResolveExplicitSourceRefusals(t *testing.T) {\n138|\treader, _, _, _ := qualifiedReader(t)\n139|\t// Unknown aliases and hosts are not found; known but disallowed\n140|\t// peers are refused as not allowlisted.\n141|\tfor _, selector := range []string{\"beta@peer:elsewhere\", \"beta@id:\" + hostB} {\n142|\t\t_ = selector\n143|\t}\n144|\tif _, err := reader.Resolve(\"beta@peer:elsewhere\"); !errors.Is(err, ErrSourceNotFound) {\n145|\t\tt.Fatalf(\"unknown alias: %v\", err)\n146|\t}\n147|\tif _, err := reader.Resolve(\"beta@id:\" + idC); !errors.Is(err, ErrSourceNotFound) {\n148|\t\tt.Fatalf(\"unknown host: %v\", err)\n149|\t}\n150|\treader.AllowlistedPeerIDs = nil\n151|\tfor _, selector := range []string{\"beta@peer:workstation\", \"beta@id:\" + hostA, \"id:\" + idB + \"@peer:workstation\"} {\n152|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrPeerNotAllowlisted) {\n153|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want peer_not_allowlisted\", selector, err)\n154|\t\t}\n155|\t}\n156|\t// The bare union still resolves the sessions it may reach; only the\n157|\t// explicit peer route is revoked.\n158|\tif _, err := reader.Resolve(\"beta\"); !errors.Is(err, ErrNotFound) {\n159|\t\tt.Fatalf(\"revoked bare union: %v\", err)\n160|\t}\n161|\t// Local needs no allowlist entry and survives revocation.\n162|\tif _, err := reader.Resolve(\"alpha@local\"); err != nil {\n163|\t\tt.Fatalf(\"local after revocation: %v\", err)\n164|\t}\n165|}\n166|\n167|func TestResolveExplicitSourceReadFailures(t *testing.T) {\n168|\treader, local, peer, peerRoot := qualifiedReader(t)\n169|\tpeerRoot := peerRootOf(t, peer)\n170|\t_ = local\n171|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n172|\t\tt.Fatal(err)\n173|\t}\n174|\t// The peer failure carries the read-failure class while preserving\n175|\t// the underlying repository cause, and never falls back to the\n176|\t// local index even though \"alpha\" resolves there.\n177|\t_, err := reader.Resolve(\"beta@peer:workstation\")\n178|\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n179|\t\tt.Fatalf(\"explicit peer failure: %v\", err)\n180|\t}\n181|\tif _, err := reader.Resolve(\"alpha@peer:workstation\"); !errors.Is(err, ErrSourceReadFailed) {\n182|\t\tt.Fatalf(\"explicit miss behind failed read fell back: %v\", err)\n183|\t}\n184|\treader.Peers = []PeerIndex{{hostA, nil}}\n185|\tif _, err := reader.Resolve(\"beta@peer:workstation\"); !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, ErrUnavailable) {\n186|\t\tt.Fatalf(\"nil learned index: %v\", err)\n187|\t}\n188|\t// An allowlisted peer with no advertised index at all cannot\n189|\t// complete the required read either.\n190|\treader.Peers = nil\n191|\tif _, err := reader.Resolve(\"beta@peer:workstation\"); !errors.Is(err, ErrSourceNotFound) {\n192|\t\tt.Fatalf(\"unmapped alias: %v\", err)\n193|\t}\n194|\treader.Peers = []PeerIndex{{hostA, peer}}\n195|\treader.Aliases = nil\n196|\tif _, err := reader.Resolve(\"beta@id:\" + hostA); !errors.Is(err, ErrSourceReadFailed) {\n197|\t\tt.Fatalf(\"handle-less explicit host: %v\", err)\n198|\t}\n199|}\n200|\n(more lines below)","final_result":true}}}
