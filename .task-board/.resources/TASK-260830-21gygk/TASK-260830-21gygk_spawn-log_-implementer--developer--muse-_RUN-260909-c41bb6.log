{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d005","stream":{"kind":"session","id":"01a08787-bf24-7b40-897c-97ffe37e976a"},"sequence":1629,"recorded_at":1780531400003253,"record_type":"event","durability":"durable","causation_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137","run_stream":{"kind":"run","id":"11672cdc-602f-4a3f-b0dc-7d57f3c36137"},"task_stream":{"kind":"task","id":"01a08797-1dde-7631-a450-cf6e7da70743"},"task_id":"01a08797-1dde-7631-a450-cf6e7da70743","event":{"kind":"output","task_id":"01a08797-1dde-7631-a450-cf6e7da70743","chunk":"Read text file `internal/sessquery/query.go`.\n(99 line(s) above)\n100|}\n101|\n102|func (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\n103|\trows, err := repo.ListSessions()\n104|\tif err != nil {\n105|\t\treturn nil, err\n106|\t}\n107|\tout := make([]Summary, 0, len(rows))\n108|\tprojector := sessstate.Projector{Repo: repo, LocalHostID: reader.LocalHostID}\n109|\tfor _, row := range rows {\n110|\t\tprojection, err := projector.Project(row.SessionID)\n111|\t\tif err != nil {\n112|\t\t\treturn nil, err\n113|\t\t}\n114|\t\tout = append(out, Summary{Projection: projection})\n115|\t}\n116|\tsort.Slice(out, func(i, j int) bool { return out[i].Projection.SessionID < out[j].Projection.SessionID })\n117|\treturn out, nil\n118|}\n119|\n120|// Status resolves a NAME/UUID through the same path as Resolve, then projects\n121|// from the selected repository. It never treats a failed read as not found.\n122|// Parked sessions can be inspected by ID through InspectLocal, independently of\n123|// live-name routing, so operators retain access to the recovery diagnostics.\n124|func (reader *Reader) Status(selector string) (Summary, error) {\n125|\tselected, err := reader.Resolve(selector)\n126|\tif err != nil {\n127|\t\treturn Summary{}, err\n128|\t}\n129|\tprojection, err := (&sessstate.Projector{Repo: selected.repo, LocalHostID: reader.LocalHostID}).Project(selected.SessionID)\n130|\tif err != nil {\n131|\t\treturn Summary{}, err\n132|\t}\n133|\treturn Summary{Projection: projection}, nil\n134|}\n135|\n136|// InspectLocal reads one local ID, including a parked or tombstoned session.\n137|func (reader *Reader) InspectLocal(sessionID string) (Summary, error) {\n138|\tif reader == nil || reader.Local == nil {\n139|\t\treturn Summary{}, fmt.Errorf(\"%w: local repository is required\", ErrUnavailable)\n140|\t}\n141|\tprojection, err := (&sessstate.Projector{Repo: reader.Local, LocalHostID: reader.LocalHostID}).Project(sessionID)\n142|\tif err != nil {\n143|\t\treturn Summary{}, err\n144|\t}\n145|\treturn Summary{Projection: projection}, nil\n146|}\n147|\n148|// Selection identifies the session and source index, never an attach or mutation\n149|// plan. PeerHostID is empty for local resolution; it is not the winning owner.\n150|type Selection struct {\n151|\tSessionID  string\n152|\tPeerHostID string\n153|\trepo       *sessrepo.Repository\n154|}\n155|\n156|type candidate struct {\n157|\tsummary   Summary\n158|\tselection Selection\n159|}\n160|\n161|// Resolve applies the Section 2.3 tiers: local exact live name, allowlisted\n162|// peer exact live name, exact UUID, not found. ASCII folding detects collisions\n163|// within each name tier; it does not turn a unique case variant into an exact\n164|// match. Repository-parked and tombstoned entries are not live-name candidates.\n165|// This is logical index eligibility, not proof of process liveness or safe\n166|// attach/resume readiness; those decisions belong to the action planner.\n167|func (reader *Reader) Resolve(selector string) (Selection, error) {\n168|\tlocal, err := reader.List()\n169|\tif err != nil {\n170|\t\treturn Selection{}, err\n171|\t}\n172|\tcandidates := liveCandidates(local, reader.Local, \"\")\n173|\tif match, found, err := matchName(candidates, selector); found || err != nil {\n174|\t\treturn match, err\n175|\t}\n176|\tpeers, err := reader.peerCandidates()\n177|\tif err != nil {\n178|\t\treturn Selection{}, err\n179|\t}\n180|\tif match, found, err := matchName(peers, selector); found || err != nil {\n181|\t\treturn match, err\n182|\t}\n183|\tif id, err := scalar.ParseUUIDv7(selector); err == nil {\n184|\t\tfor _, item := range append(candidates, peers...) {\n185|\t\t\tif item.selection.SessionID == id.String() {\n186|\t\t\t\treturn item.selection, nil\n187|\t\t\t}\n188|\t\t}\n189|\t}\n190|\treturn Selection{}, fmt.Errorf(\"%w: no live session named %q\", ErrNotFound, selector)\n191|}\n192|\n193|func liveCandidates(rows []Summary, repo *sessrepo.Repository, peer string) []candidate {\n194|\tout := make([]candidate, 0, len(rows))\n195|\tfor _, row := range rows {\n196|\t\tif row.Projection.Parked != nil || row.Projection.State == sessstate.StateTombstoned {\n197|\t\t\tcontinue\n198|\t\t}\n199|\t\tout = append(out, candidate{row, Selection{row.Projection.SessionID, peer, repo}})\n200|\t}\n201|\treturn out\n202|}\n203|\n204|func (reader *Reader) peerCandidates() ([]candidate, error) {\n205|\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n206|\tsort.Strings(ids)\n207|\tvar out []candidate\n208|\tfor index, id := range ids {\n209|\t\tif index > 0 && id == ids[index-1] {\n210|\t\t\tcontinue\n211|\t\t}\n212|\t\tvar repo *sessrepo.Repository\n213|\t\tfound := false\n214|\t\tfor _, peer := range reader.Peers {\n215|\t\t\tif peer.HostID != id {\n216|\t\t\t\tcontinue\n217|\t\t\t}\n218|\t\t\tif found {\n219|\t\t\t\treturn nil, fmt.Errorf(\"%w: multiple indexes for peer %s\", ErrUnavailable, id)\n220|\t\t\t}\n221|\t\t\tfound = true\n222|\t\t\trepo = peer.Repo\n223|\t\t}\n224|\t\t// An allowlisted peer with no learned index contributes no learned names.\n225|\t\t// A listed index with an unavailable repository is a failed observation.\n226|\t\tif !found {\n227|\t\t\tcontinue\n228|\t\t}\n229|\t\tif repo == nil {\n(more lines below)","final_result":true}}}
