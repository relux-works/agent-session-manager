{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c743","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":508,"recorded_at":1780531400001011,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"call_id":"call_01a0aa4e5ae1724a92844e538ac6822c","text":"Read text file `internal/sessquery/lease.go`.\n(648 line(s) above)\n649|\trecordBytes, err := repo.GetRecord(checkpoint.SessionID)\n650|\tif err != nil {\n651|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n652|\t}\n653|\tcreation, recordID, err := sessionCreationProfile(checkpoint, recordBytes)\n654|\tif err != nil {\n655|\t\treturn err\n656|\t}\n657|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n658|\tif err != nil {\n659|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n660|\t}\n661|\tclosure, err := profileClosure(checkpoint, recordID, events)\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\treturn checkClosureProfilePairs(checkpoint, creation, events, closure, repo)\n666|}\n667|\n668|// sessionCreationProfile reads the immutable creation profile and\n669|// the canonical record digest from the winning-source Session\n670|// Record bytes. The closed shape owner requires execution_profile\n671|// standard|yolo, so any other value contradicts the admitted\n672|// record (integrity failure).\n673|func sessionCreationProfile(checkpoint validatedCheckpoint, recordBytes []byte) (string, string, error) {\n674|\tmembers, fault := environ.DecodeStrictObject(recordBytes)\n675|\tif fault != nil {\n676|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no decodable session record for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, fault)\n677|\t}\n678|\tcreation, err := leaseStringMember(members, \"execution_profile\")\n679|\tif err != nil || (creation != \"standard\" && creation != \"yolo\") {\n680|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid creation profile for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID)\n681|\t}\n682|\trecordID, err := leaseStringMember(members, \"record_id\")\n683|\tif err != nil {\n684|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries no valid record digest for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID)\n685|\t}\n686|\tdigest, err := scalar.ParseDigest(recordID)\n687|\tif err != nil {\n688|\t\treturn \"\", \"\", fmt.Errorf(\"%w: session %s carries malformed record digest %q for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, recordID)\n689|\t}\n690|\treturn creation, digest.String(), nil\n691|}\n692|\n693|// profileClosure resolves the transitive predecessor closure of the\n694|// checkpoint heads against the winning source chain index. The\n695|// genesis link names the Session Record digest rather than an\n696|// event; every other predecessor must name a chained event, so a\n697|// dangling reference contradicts the admitted closure (integrity\n698|// failure). Divergent blobs preserved outside the authoritative\n699|// index never enter the closure: index membership is authority.\n700|func profileClosure(checkpoint validatedCheckpoint, recordID string, events []sessrepo.EventSummary) (map[string]bool, error) {\n701|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n702|\tfor _, summary := range events {\n703|\t\tbyID[summary.EventID] = summary\n704|\t}\n705|\tclosure := make(map[string]bool, len(events))\n706|\tstack := append([]string(nil), checkpoint.EventHeads...)\n707|\tfor len(stack) > 0 {\n708|\t\tid := stack[len(stack)-1]\n709|\t\tstack = stack[:len(stack)-1]\n710|\t\tif closure[id] {\n711|\t\t\tcontinue\n712|\t\t}\n713|\t\tsummary, ok := byID[id]\n714|\t\tif !ok {\n715|\t\t\tif id == recordID {\n716|\t\t\t\tcontinue\n717|\t\t\t}\n718|\t\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile closure names unknown event %s for session %s\", sessstate.ErrIntegrity, checkpoint.Digest, id, checkpoint.SessionID)\n719|\t\t}\n720|\t\tclosure[id] = true\n721|\t\tstack = append(stack, summary.Predecessors...)\n722|\t}\n723|\treturn closure, nil\n724|}\n725|\n726|// profilePair is one decoded Section 2.4 pair from a launch or\n727|// resume event payload.\n728|type profilePair struct {\n729|\tprofile   string\n730|\tsource    string\n731|\thasSource bool\n732|}\n733|\n734|// eventProfilePair decodes the pair from one chained launch or\n735|// resume event. Chained bytes passed the closed payload shape at\n736|// append time, so a member that no longer decodes contradicts the\n737|// attested chain (integrity failure).\n738|func eventProfilePair(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (profilePair, error) {\n739|\tvar pair profilePair\n740|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n741|\tif err != nil {\n742|\t\treturn pair, err\n743|\t}\n744|\tprofile, err := leaseStringMember(payload, \"execution_profile\")\n745|\tif err != nil || (profile != \"standard\" && profile != \"yolo\") {\n746|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid execution profile for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)\n747|\t}\n748|\tsource, hasSource, err := leaseNullableDigest(payload, \"profile_source_event_id\")\n749|\tif err != nil {\n750|\t\treturn pair, fmt.Errorf(\"%w: session %s event %s carries no valid profile source for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, err)\n751|\t}\n752|\treturn profilePair{profile: profile, source: source, hasSource: hasSource}, nil\n753|}\n754|\n755|// eventProfileTarget decodes the target profile of one chained\n756|// profile.changed event. Only the target feeds the derivation: the\n757|// source value and the confirmation history belong to the\n758|// publication flow that admitted the event, never to this\n759|// admission.\n760|func eventProfileTarget(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (string, error) {\n761|\tpayload, err := eventPayloadMembers(checkpoint, repo, summary)\n762|\tif err != nil {\n763|\t\treturn \"\", err\n764|\t}\n765|\ttarget, err := leaseStringMember(payload, \"to\")\n766|\tif err != nil || (target != \"standard\" && target != \"yolo\") {\n767|\t\treturn \"\", fmt.Errorf(\"%w: session %s event %s carries no valid profile target for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)\n768|\t}\n769|\treturn target, nil\n770|}\n771|\n772|// eventPayloadMembers returns the decoded payload object of one\n773|// chained event. A failed blob read keeps its cause inside the\n774|// incomplete-authority refusal; bytes that no longer decode\n775|// contradict the attested chain.\n776|func eventPayloadMembers(checkpoint validatedCheckpoint, repo *sessrepo.Repository, summary sessrepo.EventSummary) (map[string]json.RawMessage, error) {\n777|\traw, err := repo.GetEvent(checkpoint.SessionID, summary.EventID)\n778|\tif err != nil {\n779|\t\treturn nil, fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n780|\t}\n781|\tmembers, fault := environ.DecodeStrictObject(raw)\n782|\tif fault != nil {\n783|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable event frame for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, fault)\n784|\t}\n785|\tpayloadRaw, ok := members[\"payload\"]\n786|\tif !ok || string(payloadRaw) == \"null\" {\n787|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no payload for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID)\n788|\t}\n789|\tpayload, fault := environ.DecodeStrictObject([]byte(payloadRaw))\n790|\tif fault != nil {\n791|\t\treturn nil, fmt.Errorf(\"%w: session %s event %s carries no decodable payload for profile authority: %v\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, fault)\n792|\t}\n793|\treturn payload, nil\n794|}\n795|\n796|// checkClosureProfilePairs walks the closure in authoritative chain\n797|// order and binds every launch and resume pair to the Section 2.4\n798|// derivation: the first launch carries the creation profile with a\n799|// null source, and every later pair carries the newest\n800|// authoritative profile.changed event at or before it with that\n801|// change's target profile (the creation pair while no change\n802|// exists). Each pair mismatch, each unexpected or missing source,\n803|// and each source that fails the closure resolution below refuses\n804|// integrity failure.\n805|func checkClosureProfilePairs(checkpoint validatedCheckpoint, creation string, events []sessrepo.EventSummary, closure map[string]bool, repo *sessrepo.Repository) error {\n806|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n807|\tfor _, summary := range events {\n808|\t\tbyID[summary.EventID] = summary\n809|\t}\n810|\tnewestSource, newestProfile := \"\", \"\"\n811|\thasNewest := false\n812|\tfirstLaunch := true\n813|\tfor _, summary := range events {\n814|\t\tif !closure[summary.EventID] {\n815|\t\t\tcontinue\n816|\t\t}\n817|\t\tswitch summary.EventType {\n818|\t\tcase \"profile.changed\":\n819|\t\t\ttarget, err := eventProfileTarget(checkpoint, repo, summary)\n820|\t\t\tif err != nil {\n821|\t\t\t\treturn err\n822|\t\t\t}\n823|\t\t\tnewestSource, newestProfile, hasNewest = summary.EventID, target, true\n824|\t\tcase \"provider.launched\", \"task_board.launched\":\n825|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n826|\t\t\tif err != nil {\n827|\t\t\t\treturn err\n828|\t\t\t}\n829|\t\t\twantProfile, wantSource, wantHasSource := creation, \"\", false\n830|\t\t\tif !firstLaunch && hasNewest {\n831|\t\t\t\twantProfile, wantSource, wantHasSource = newestProfile, newestSource, true\n832|\t\t\t}\n833|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil {\n834|\t\t\t\treturn err\n835|\t\t\t}\n836|\t\t\tfirstLaunch = false\n837|\t\tcase \"session.resumed\":\n838|\t\t\tpair, err := eventProfilePair(checkpoint, repo, summary)\n839|\t\t\tif err != nil {\n840|\t\t\t\treturn err\n841|\t\t\t}\n842|\t\t\twantProfile, wantSource, wantHasSource := creation, \"\", false\n843|\t\t\tif hasNewest {\n844|\t\t\t\twantProfile, wantSource, wantHasSource = newestProfile, newestSource, true\n845|\t\t\t}\n846|\t\t\tif err := checkProfilePairSource(checkpoint, summary, pair, wantProfile, wantSource, wantHasSource, byID, closure); err != nil {\n847|\t\t\t\treturn err\n848|\t\t\t}\n849|\t\t}\n850|\t}\n851|\treturn nil\n852|}\n853|\n854|// checkProfilePairSource binds one decoded pair to its derived\n855|// expectation. The profile value must equal the derived effective\n856|// profile, so falling back to the creation value past a change\n857|// refuses; the source presence must match, so a first launch with\n858|// any source refuses; and a present source must resolve to the\n859|// newest authoritative profile.changed event in the closure —\n860|// missing, out-of-closure (later local-only or losing-lease),\n861|// wrong-type, and non-newest references each refuse with the\n862|// violated expectation named.\n863|func checkProfilePairSource(checkpoint validatedCheckpoint, summary sessrepo.EventSummary, pair profilePair, wantProfile, wantSource string, wantHasSource bool, byID map[string]sessrepo.EventSummary, closure map[string]bool) error {\n864|\tif pair.profile != wantProfile {\n865|\t\treturn fmt.Errorf(\"%w: session %s event %s carries execution profile %q, want effective profile %q for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.profile, wantProfile)\n866|\t}\n867|\tif pair.hasSource != wantHasSource {\n868|\t\tif pair.hasSource {\n869|\t\t\treturn fmt.Errorf(\"%w: session %s event %s carries profile source %s, want no profile source for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)\n870|\t\t}\n871|\t\treturn fmt.Errorf(\"%w: session %s event %s carries no profile source, want newest authoritative source %s for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, wantSource)\n872|\t}\n873|\tif !wantHasSource {\n874|\t\treturn nil\n875|\t}\n876|\tsourced, ok := byID[pair.source]\n877|\tif !ok {\n878|\t\treturn fmt.Errorf(\"%w: session %s event %s names unknown profile source %s for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)\n879|\t}\n880|\tif !closure[pair.source] {\n881|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s outside the checkpoint closure for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source)\n882|\t}\n883|\tif sourced.EventType != \"profile.changed\" {\n884|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s of type %q, want a profile.changed event for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, sourced.EventType)\n885|\t}\n886|\tif pair.source != wantSource {\n887|\t\treturn fmt.Errorf(\"%w: session %s event %s names profile source %s, want newest authoritative source %s for profile authority\", sessstate.ErrIntegrity, checkpoint.SessionID, summary.EventID, pair.source, wantSource)\n888|\t}\n889|\treturn nil\n890|}\n891|\n892|// checkCheckpointPersistence binds an admitted Checkpoint Record to\n893|// the persistence variant the referenced Session Record selects\n894|// (Section 5.4): a direct session requires a non-null\n895|// provider_manifest_id with a null task_board_bundle_id, while a\n896|// task_board session requires the reverse. Canonical shape proves\n897|// exactly one variant is present but cannot select which one is\n898|// valid, so a swapped variant keeps canonical identity, session,\n899|// lease, epoch, and creator yet refuses here with incomplete\n900|// authority (observation_unavailable), never absence or a minted\n901|// fact. An unknown session kind is malformed configuration: valid\n902|// Session Records admit only the two kinds.\n903|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n904|\tswitch sessionKind {\n905|\tcase \"direct\":\n906|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n907|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n908|\t\t}\n909|\t\treturn nil\n910|\tcase \"task_board\":\n911|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n912|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n913|\t\t}\n914|\t\treturn nil\n915|\tdefault:\n916|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n917|\t}\n918|}\n919|\n920|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n921|// greatest epoch wins, ties break by bytewise lease-ID order.\n922|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n923|\treturn sessstate.Compare(\n924|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n925|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n926|\t)\n927|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
