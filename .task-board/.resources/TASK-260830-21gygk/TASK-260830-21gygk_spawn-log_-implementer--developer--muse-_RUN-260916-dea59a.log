{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c971","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":787,"recorded_at":1780531400001569,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"task_stream":{"kind":"task","id":"01a0aa4f-10ce-7f40-b24c-749f5ecf8d35"},"task_id":"01a0aa4f-10ce-7f40-b24c-749f5ecf8d35","event":{"kind":"output","task_id":"01a0aa4f-10ce-7f40-b24c-749f5ecf8d35","chunk":"Read text file `internal/sessquery/rev6_regression_test.go`.\n(99 line(s) above)\n100|\t\t\t})\n101|\t\t}\n102|\t}\n103|}\n104|\n105|// taskBoardRecordBytes builds one validated task_board Session Record\n106|// for tests, following the SPEC 5.1 task_board example with a\n107|// tracked_prompt reference and no board goal.\n108|func taskBoardRecordBytes(t *testing.T, id, name string) []byte {\n109|\tt.Helper()\n110|\tvar value map[string]any\n111|\tif err := json.Unmarshal([]byte(specRecordExample), &value); err != nil {\n112|\t\tt.Fatal(err)\n113|\t}\n114|\tvalue[\"session_id\"], value[\"subject_id\"], value[\"name\"] = id, id, name\n115|\tvalue[\"kind\"] = \"task_board\"\n116|\tvalue[\"task_board\"] = map[string]any{\n117|\t\t\"bridge_protocol_version\": \"1.0.0\",\n118|\t\t\"board\": map[string]any{\n119|\t\t\t\"kind\": \"local\", \"logical_id\": \"agent-session-manager-spec\",\n120|\t\t\t\"remote_url\": nil, \"extensions\": map[string]any{},\n121|\t\t},\n122|\t\t\"task_element_id\": \"TASK-260819-example\", \"launch_mode\": \"tracked_prompt\",\n123|\t\t\"manager_session_ref\": nil, \"board_goal\": nil,\n124|\t\t\"native_goal_binding\": \"prompt\", \"extensions\": map[string]any{},\n125|\t}\n126|\treturn identity(t, value, \"record_id\")\n127|}\n128|\n129|// taskBoardCheckpointBytes builds one validated Checkpoint Record\n130|// carrying the task_board persistence variant: null provider manifest\n131|// with a non-null task-board bundle.\n132|func taskBoardCheckpointBytes(t *testing.T, sessionID string, epoch uint64, leaseID, creator string) []byte {\n133|\tt.Helper()\n134|\tvalue := map[string]any{\n135|\t\t\"schema\": \"urn:ax:schema:checkpoint\", \"schema_version\": \"1.0.0\", \"checkpoint_id\": zeroDigest,\n136|\t\t\"subject_id\": sessionID, \"session_id\": sessionID,\n137|\t\t\"lease_epoch\": json.Number(uint64String(epoch)), \"lease_id\": leaseID,\n138|\t\t\"safe_boundary\": map[string]any{\n139|\t\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"evidence\": \"accepted_test\",\n140|\t\t\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true,\n141|\t\t\t\"open_processes\": json.Number(\"0\"), \"open_database_handles\": json.Number(\"0\"),\n142|\t\t},\n143|\t\t\"event_heads\":           []string{zeroDigest},\n144|\t\t\"workspace_manifest_id\": zeroDigest,\n145|\t\t\"provider_manifest_id\":  nil,\n146|\t\t\"task_board_bundle_id\":  zeroDigest,\n147|\t\t\"created_by_host_id\":    creator,\n148|\t\t\"created_at\":            \"2026-08-19T04:09:30.000Z\",\n149|\t\t\"status\":                \"validated\",\n150|\t\t\"extensions\":            map[string]any{},\n151|\t}\n152|\treturn identity(t, value, \"checkpoint_id\")\n153|}\n154|\n155|// taskBoardSuccessorFixture builds a task_board session with the\n156|// epoch-1 to epoch-2 transfer chain and a task_board-variant\n157|// checkpoint bound to the predecessor lease. The caller supplies no\n158|// variant: the only admissible checkpoint is the task_board one. The\n159|// checkpoint names the real launch head so the head-authority gate\n160|// does not mask the persistence gate.\n161|func taskBoardSuccessorFixture(t *testing.T) *Reader {\n162|\tt.Helper()\n163|\tlocal, _ := repository(t)\n164|\traw := taskBoardRecordBytes(t, idA, \"alpha\")\n165|\tref, err := local.CreateSession(raw)\n166|\tif err != nil {\n167|\t\tt.Fatal(err)\n168|\t}\n169|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n170|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n171|\tappendEventAs(t, local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n172|\treader := &Reader{Local: local, LocalHostID: hostA}\n173|\tcp := checkpointWithHeads(t, taskBoardCheckpointBytes(t, idA, 1, lease, hostA), launched)\n174|\twithCheckpoints(reader, cp)\n175|\twithLeases(reader,\n176|\t\tleaseCreate(t, idA, hostA),\n177|\t\tleaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)),\n178|\t)\n179|\treturn reader\n180|}\n181|\n182|// TestRev6TaskBoardPersistenceControl proves the variant gate selects\n183|// by session kind instead of admitting one hard-coded variant: the\n184|// task_board session with its task_board checkpoint passes all four\n185|// entries, while a provider-manifest checkpoint for that same session\n186|// refuses through all four entries including old-plan revalidation.\n187|func TestRev6TaskBoardPersistenceControl(t *testing.T) {\n188|\tt.Run(\"task_board_control\", func(t *testing.T) {\n189|\t\trev5CheckEntries(t, taskBoardSuccessorFixture(t), false)\n190|\t})\n191|\tt.Run(\"provider_checkpoint_for_task_board_session\", func(t *testing.T) {\n192|\t\tr := taskBoardSuccessorFixture(t)\n193|\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n194|\t\tprovider := checkpointWithHeads(t, checkpointRecordBytes(t, idA, 1, lease, hostA), headAtOrBefore(t, r, idA, 1))\n195|\t\tr.CheckpointRecords[0] = provider\n196|\t\tfor i, raw := range r.LeaseRecords {\n197|\t\t\tvar value map[string]any\n198|\t\t\tif err := json.Unmarshal(raw, &value); err != nil {\n199|\t\t\t\tt.Fatal(err)\n200|\t\t\t}\n201|\t\t\tif value[\"lease_id\"] == leaseB {\n202|\t\t\t\tvalue[\"checkpoint_id\"] = checkpointDigestOf(t, provider)\n203|\t\t\t\tr.LeaseRecords[i] = identity(t, value, \"record_id\")\n204|\t\t\t}\n205|\t\t}\n206|\t\tif err := r.Revalidate(old); err == nil {\n207|\t\t\tt.Error(\"old-plan Revalidate admits provider persistence variant for task_board session\")\n208|\t\t}\n209|\t\trev5CheckEntries(t, r, true)\n210|\t})\n211|}\n212|\n213|// TestRev6PersistenceMismatchIsObservationUnavailable pins the refusal\n214|// class: a swapped variant is incomplete authority, never a missing\n215|// lease, a bootstrap prefix, or a minted fact. The swapped record\n216|// keeps a real head so the class proves the persistence gate.\n217|func TestRev6PersistenceMismatchIsObservationUnavailable(t *testing.T) {\n218|\tr := successorFixture(t)\n219|\twrong := checkpointWithHeads(t, taskBoardCheckpointBytes(t, idA, 1, lease, hostA), headAtOrBefore(t, r, idA, 1))\n220|\twithCheckpoints(r, wrong)\n221|\twithLeases(r, leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, wrong)))\n222|\tif _, err := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); !errors.Is(err, ErrObservationUnavailable) {\n223|\t\tt.Fatalf(\"BuildPlan variant mismatch = %v, want selector_observation_unavailable\", err)\n224|\t}\n225|}","final_result":true}}}
