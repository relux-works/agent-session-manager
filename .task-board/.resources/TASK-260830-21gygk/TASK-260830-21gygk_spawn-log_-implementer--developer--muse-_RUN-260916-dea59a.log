{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf3b","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":1528,"recorded_at":1780531400003051,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"task_stream":{"kind":"task","id":"01a0aa5a-e2a6-76a3-8040-df89ebf4d093"},"task_id":"01a0aa5a-e2a6-76a3-8040-df89ebf4d093","event":{"kind":"output","task_id":"01a0aa5a-e2a6-76a3-8040-df89ebf4d093","chunk":"Read text file `internal/sessquery/rev10_probe_red_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestReview9ForkLocalProfile(t *testing.T) {\n9|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n10|\t\tfor _, bad := range []bool{false, true} {\n11|\t\t\tt.Run(fmt.Sprintf(\"%s/bad=%t\", kind, bad), func(t *testing.T) {\n12|\t\t\t\tlocal, _ := repository(t)\n13|\t\t\t\traw := record(t, idA, \"alpha\")\n14|\t\t\t\tif kind == \"task_board\" {\n15|\t\t\t\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n16|\t\t\t\t}\n17|\t\t\t\tref, err := local.CreateSession(raw)\n18|\t\t\t\tif err != nil {\n19|\t\t\t\t\tt.Fatal(err)\n20|\t\t\t\t}\n21|\t\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n22|\t\t\t\tprofile := \"yolo\"\n23|\t\t\t\tif bad {\n24|\t\t\t\t\tprofile = \"standard\"\n25|\t\t\t\t}\n26|\t\t\t\tfork := appendEvent(t, local, idA, created, \"fork.created\", 2, map[string]any{\"source_session_id\": idB, \"source_checkpoint_id\": zeroDigest, \"new_session_record_id\": ref.RecordID, \"provider_fork_mode\": \"native\", \"execution_profile\": profile, \"profile_source_event_id\": nil, \"source_profile_event_id\": nil})\n27|\t\t\t\tlaunched := appendEvent(t, local, idA, fork, \"provider.launched\", 3, rev8LaunchPayload(\"yolo\", nil))\n28|\t\t\t\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n29|\t\t\t\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n30|\t\t\t\tif kind == \"task_board\" {\n31|\t\t\t\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n32|\t\t\t\t}\n33|\t\t\t\tgood := rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{created}})\n34|\t\t\t\tcovered := rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n35|\t\t\t\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 5, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, good), \"kind\": \"manual\"})\n36|\t\t\t\tappendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n37|\t\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n38|\t\t\t\twithCheckpoints(r, good)\n39|\t\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, good)))\n40|\t\t\t\trev7CheckEntries(t, r, false)\n41|\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n42|\t\t\t\trev7SwapCheckpoint(t, r, covered)\n43|\t\t\t\terr = r.Revalidate(old)\n44|\t\t\t\tt.Logf(\"old-plan substitution refusal: %v\", err)\n45|\t\t\t\tif bad && err == nil {\n46|\t\t\t\t\tt.Error(\"old-plan substitution admitted\")\n47|\t\t\t\t}\n48|\t\t\t\trev7CheckEntries(t, r, bad)\n49|\t\t\t})\n50|\t\t}\n51|\t}\n52|}\n53|func TestReview9ResumeReferencedCheckpoint(t *testing.T) {\n54|\tfor _, bad := range []bool{false, true} {\n55|\t\tt.Run(fmt.Sprintf(\"wrong_checkpoint_pair=%t\", bad), func(t *testing.T) {\n56|\t\t\tlocal, _ := repository(t)\n57|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n58|\t\t\tif err != nil {\n59|\t\t\t\tt.Fatal(err)\n60|\t\t\t}\n61|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n62|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n63|\t\t\tbeforeChangeIdle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"before-change\", \"foreground_idle\": true, \"background_idle\": true})\n64|\t\t\tchanged := appendEvent(t, local, idA, beforeChangeIdle, \"profile.changed\", 4, rev8ChangedPayload(\"yolo\", \"standard\"))\n65|\t\t\tquiesced := appendEvent(t, local, idA, changed, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n66|\t\t\thead := quiesced\n67|\t\t\tif bad {\n68|\t\t\t\thead = beforeChangeIdle\n69|\t\t\t}\n70|\t\t\tcpA := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{head}})\n71|\t\t\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"kind\": \"manual\"})\n72|\t\t\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", 7, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n73|\t\t\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", 8, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"execution_profile\": \"standard\", \"profile_source_event_id\": changed, \"terminal_backend\": \"tmux\", \"native_session_id\": \"sess-1\"})\n74|\t\t\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 9, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n75|\t\t\tcpB := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n76|\t\t\tannouncedB := appendEvent(t, local, idA, idle, \"checkpoint.created\", 10, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpB), \"kind\": \"manual\"})\n77|\t\t\ttail := appendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n78|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n79|\t\t\twithCheckpoints(r, cpB, cpA)\n80|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cpB)))\n81|\t\t\t_ = announced\n82|\t\t\t_ = tail\n83|\t\t\trev7CheckEntries(t, r, bad)\n84|\t\t\tif bad {\n85|\t\t\t\treturn\n86|\t\t\t}\n87|\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n88|\t\t\tif err := r.Revalidate(old); err != nil {\n89|\t\t\t\tt.Errorf(\"fresh Revalidate refused valid resume profile authority: %v\", err)\n90|\t\t\t}\n91|\t\t})\n92|\t}\n93|}","final_result":true}}}
