{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"call_id":"call_01a0aa4e442b73dda408623b369d6eaa","text":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is one admitted Checkpoint Record: its canonical\n48|// digest with the session and lease it was taken under, plus the host\n49|// that created it. Section 5.4 binds lease_epoch/lease_id to the\n50|// referenced winning lease, so a successor's checkpoint names its\n51|// predecessor lease, and binds created_by_host_id to the current\n52|// lease holder: the holder of the lease the checkpoint names. The\n53|// persistence presence members carry which variant the record uses;\n54|// the referenced Session Record selects which variant is valid\n55|// (checkCheckpointPersistence), because canonical shape alone admits\n56|// either variant. EventHeads carries the authoritative event DAG\n57|// heads immediately before the checkpoint object; every required\n58|// checkpoint must resolve each head to a chained event for its\n59|// session at or before its bound lease\n60|// (checkCheckpointEventHeads), because a canonical checkpoint\n61|// naming an absent event or an event under a later lease cannot\n62|// establish Section 5.3/14.7.2 current complete authority. The same\n63|// closure must then admit the Section 2.4 profile authority\n64|// (checkCheckpointProfileAuthority), because a canonical checkpoint\n65|// over a corrupt profile history cannot fix the effective profile.\n66|type validatedCheckpoint struct {\n67|\tDigest              string\n68|\tSessionID           string\n69|\tLeaseEpoch          uint64\n70|\tLeaseID             string\n71|\tCreatorHostID       string\n72|\tHasProviderManifest bool\n73|\tHasTaskBoardBundle  bool\n74|\tEventHeads          []string\n75|\tRaw                 []byte\n76|}\n77|\n78|// parseLeaseRecord validates one canonical Lease Record through the\n79|// canonicaljson owner and extracts the bound members. Closed-shape and\n80|// identity failures refuse invalid_config; the caller maps absence to\n81|// observation_unavailable.\n82|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n83|\tvar lease validatedLease\n84|\tmembers, fault := environ.DecodeStrictObject(raw)\n85|\tif fault != nil {\n86|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n87|\t}\n88|\tschema, err := leaseStringMember(members, \"schema\")\n89|\tif err != nil || schema != leaseRecordSchema {\n90|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n91|\t}\n92|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n93|\tif err != nil {\n94|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n95|\t}\n96|\tif field != canonicaljson.SelfRecordID {\n97|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n98|\t}\n99|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n100|\tif !ok {\n101|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n102|\t}\n103|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n104|\tif err != nil {\n105|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n106|\t}\n107|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n108|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n109|\t}\n110|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n111|\tif !ok {\n112|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n113|\t}\n114|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n115|\tif !ok {\n116|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n117|\t}\n118|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n119|\tif err != nil {\n120|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n121|\t}\n122|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n123|\tif err != nil {\n124|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n125|\t}\n126|\tlease = validatedLease{\n127|\t\tDigest:         digest.String(),\n128|\t\tSessionID:      sessionID.String(),\n129|\t\tLeaseID:        leaseID,\n130|\t\tEpoch:          epoch,\n131|\t\tHolderHostID:   holder.String(),\n132|\t\tPredecessor:    predecessor,\n133|\t\tHasPredecessor: hasPredecessor,\n134|\t\tCheckpoint:     checkpoint,\n135|\t\tHasCheckpoint:  hasCheckpoint,\n136|\t\tRaw:            append([]byte(nil), raw...),\n137|\t}\n138|\treturn lease, nil\n139|}\n140|\n141|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n142|\treturn members[name]\n143|}\n144|\n145|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n146|\traw, ok := members[name]\n147|\tif !ok {\n148|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n149|\t}\n150|\tvar value string\n151|\tif err := json.Unmarshal(raw, &value); err != nil {\n152|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n153|\t}\n154|\treturn value, nil\n155|}\n156|\n157|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n158|\traw, ok := members[name]\n159|\tif !ok {\n160|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n161|\t}\n162|\tif string(raw) == \"null\" {\n163|\t\treturn \"\", false, nil\n164|\t}\n165|\tvar value string\n166|\tif err := json.Unmarshal(raw, &value); err != nil {\n167|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n168|\t}\n169|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n170|\t\treturn \"\", false, err\n171|\t}\n172|\treturn value, true, nil\n173|}\n174|\n175|// leaseNullableDigest reads a nullable digest member: null binds\n176|// absence, a string must parse as a canonical digest.\n177|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n178|\traw, ok := members[name]\n179|\tif !ok {\n180|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n181|\t}\n182|\tif string(raw) == \"null\" {\n183|\t\treturn \"\", false, nil\n184|\t}\n185|\tvar value string\n186|\tif err := json.Unmarshal(raw, &value); err != nil {\n187|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n188|\t}\n189|\tdigest, err := scalar.ParseDigest(value)\n190|\tif err != nil {\n191|\t\treturn \"\", false, err\n192|\t}\n193|\treturn digest.String(), true, nil\n194|}\n195|\n196|// parseCheckpointRecord validates one canonical Checkpoint Record\n197|// through the sessrepo owner (closed shape plus canonical self\n198|// identity) and extracts the bound members. Closed-shape and\n199|// identity failures refuse invalid_config; the caller maps an\n200|// unresolvable reference to observation_unavailable.\n201|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n202|\tvar checkpoint validatedCheckpoint\n203|\tmembers, fault := environ.DecodeStrictObject(raw)\n204|\tif fault != nil {\n205|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n206|\t}\n207|\tschema, err := leaseStringMember(members, \"schema\")\n208|\tif err != nil || schema != checkpointRecordSchema {\n209|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n210|\t}\n211|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n212|\tif err != nil {\n213|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n214|\t}\n215|\tif field != canonicaljson.SelfCheckpointID {\n216|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n217|\t}\n218|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n219|\tif !ok {\n220|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n221|\t}\n222|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n223|\tif !ok {\n224|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n225|\t}\n226|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n227|\tif err != nil {\n228|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n229|\t}\n230|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n231|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n232|\t}\n233|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n234|\tif !ok {\n235|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n236|\t}\n237|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n238|\tif err != nil {\n239|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n240|\t}\n241|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n242|\tif err != nil {\n243|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n244|\t}\n245|\theads, err := checkpointEventHeads(members)\n246|\tif err != nil {\n247|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record event_heads: %v\", ErrInvalidConfig, err)\n248|\t}\n249|\tcheckpoint = validatedCheckpoint{\n250|\t\tDigest:              digest.String(),\n251|\t\tSessionID:           sessionID.String(),\n252|\t\tLeaseEpoch:          epoch,\n253|\t\tLeaseID:             leaseID,\n254|\t\tCreatorHostID:       creator.String(),\n255|\t\tHasProviderManifest: hasProvider,\n256|\t\tHasTaskBoardBundle:  hasBoard,\n257|\t\tEventHeads:          heads,\n258|\t\tRaw:                 append([]byte(nil), raw...),\n259|\t}\n260|\treturn checkpoint, nil\n261|}\n262|\n263|// checkpointEventHeads extracts the sorted unique event-head digests\n264|// the canonical checkpoint owner already shape-validated (1..64\n265|// entries). Grammar failures refuse invalid_config; resolution\n266|// against the session chain belongs to checkCheckpointEventHeads.\n267|func checkpointEventHeads(members map[string]json.RawMessage) ([]string, error) {\n268|\traw, ok := members[\"event_heads\"]\n269|\tif !ok {\n270|\t\treturn nil, fmt.Errorf(\"member %q is absent\", \"event_heads\")\n271|\t}\n272|\tvar values []string\n273|\tif err := json.Unmarshal(raw, &values); err != nil {\n274|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", \"event_heads\", err)\n275|\t}\n276|\tout := make([]string, 0, len(values))\n277|\tfor _, value := range values {\n278|\t\tdigest, err := scalar.ParseDigest(value)\n279|\t\tif err != nil {\n280|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", \"event_heads\", value, err)\n281|\t\t}\n282|\t\tout = append(out, digest.String())\n283|\t}\n284|\treturn out, nil\n285|}\n286|\n287|// validatedLeasesBySession validates every supplied Lease Record and\n288|// groups the admitted records by session UUID.\n289|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n290|\tout := map[string][]validatedLease{}\n291|\tif reader == nil {\n292|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n293|\t}\n294|\tfor _, raw := range reader.LeaseRecords {\n295|\t\tlease, err := parseLeaseRecord(raw)\n296|\t\tif err != nil {\n297|\t\t\treturn nil, err\n298|\t\t}\n299|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n300|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
