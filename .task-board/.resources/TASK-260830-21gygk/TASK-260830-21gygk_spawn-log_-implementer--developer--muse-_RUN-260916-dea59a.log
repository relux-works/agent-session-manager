{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"task_stream":{"kind":"task","id":"01a0aa4d-f4fa-7951-9c8c-035b9aad8d63"},"task_id":"01a0aa4d-f4fa-7951-9c8c-035b9aad8d63","event":{"kind":"output","task_id":"01a0aa4d-f4fa-7951-9c8c-035b9aad8d63","chunk":"Read text file `/tmp/rev9ev/review9_probe_test.go`.\n1|package sessquery\n2|import (\n3| \"testing\"\n4| \"fmt\"\n5|)\n6|func TestReview9ForkLocalProfile(t *testing.T) {\n7| for _,kind:=range []string{\"direct\",\"task_board\"} { for _,bad:=range []bool{false,true} {\n8| t.Run(fmt.Sprintf(\"%s/bad=%t\",kind,bad),func(t *testing.T){\n9| local,_:=repository(t)\n10| raw:=record(t,idA,\"alpha\"); if kind==\"task_board\" {raw=taskBoardRecordBytes(t,idA,\"alpha\")}\n11| ref,err:=local.CreateSession(raw); if err!=nil {t.Fatal(err)}\n12| created:=appendEvent(t,local,idA,ref.RecordID,\"session.created\",1,map[string]any{\"session_record_id\":ref.RecordID,\"bootstrap_operation_id\":hostA,\"first_checkpoint_operation_id\":hostB})\n13| profile:=\"yolo\"; if bad {profile=\"standard\"}\n14| fork:=appendEvent(t,local,idA,created,\"fork.created\",2,map[string]any{\"source_session_id\":idB,\"source_checkpoint_id\":zeroDigest,\"new_session_record_id\":ref.RecordID,\"provider_fork_mode\":\"native\",\"execution_profile\":profile,\"profile_source_event_id\":nil,\"source_profile_event_id\":nil})\n15| launched:=appendEvent(t,local,idA,fork,\"provider.launched\",3,rev8LaunchPayload(\"yolo\",nil))\n16| idle:=appendEvent(t,local,idA,launched,\"session.idle\",4,map[string]any{\"boundary_ref\":\"turn-1\",\"foreground_idle\":true,\"background_idle\":true})\n17| cp:=checkpointRecordBytes(t,idA,1,lease,hostA); if kind==\"task_board\" {cp=taskBoardCheckpointBytes(t,idA,1,lease,hostA)}\n18| good:=rev7Replace(t,cp,\"checkpoint_id\",map[string]any{\"event_heads\":[]string{created}})\n19| covered:=rev7Replace(t,cp,\"checkpoint_id\",map[string]any{\"event_heads\":[]string{idle}})\n20| announced:=appendEvent(t,local,idA,idle,\"checkpoint.created\",5,map[string]any{\"checkpoint_id\":checkpointDigestOf(t,good),\"kind\":\"manual\"})\n21| appendEventAs(t,local,idA,announced,\"lease.transferred\",1,2,leaseB,map[string]any{\"operation_id\":hostB,\"from_host_id\":hostA,\"to_host_id\":hostA,\"predecessor_lease_id\":lease,\"new_lease_id\":leaseB})\n22| r:=&Reader{Local:local,LocalHostID:hostA}; withCheckpoints(r,good); withLeases(r,leaseCreate(t,idA,hostA),leaseSuccessorBytes(t,idA,2,leaseB,hostA,lease,checkpointDigestOf(t,good)))\n23| rev7CheckEntries(t,r,false)\n24| old:=mustBuild(t,r,PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n25| rev7SwapCheckpoint(t,r,covered)\n26| err=r.Revalidate(old)\n27| t.Logf(\"old-plan substitution refusal: %v\",err)\n28| if bad && err == nil {t.Error(\"old-plan substitution admitted\")}\n29| rev7CheckEntries(t,r,bad)\n30| }) }\n31| }\n32|}\n33|func TestReview9ResumeReferencedCheckpoint(t *testing.T) {\n34|for _, bad := range []bool{false,true} { t.Run(fmt.Sprintf(\"wrong_checkpoint_pair=%t\",bad),func(t *testing.T) {\n35|\tlocal, _ := repository(t)\n36|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n37|\tif err != nil {\n38|\t\tt.Fatal(err)\n39|\t}\n40|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n41|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n42|\tbeforeChangeIdle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\":\"before-change\",\"foreground_idle\":true,\"background_idle\":true})\n43| changed := appendEvent(t, local, idA, beforeChangeIdle, \"profile.changed\", 4, rev8ChangedPayload(\"yolo\", \"standard\"))\n44|\tquiesced := appendEvent(t, local, idA, changed, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n45|\thead := quiesced; if bad { head = beforeChangeIdle };\n46| cpA := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{head}})\n47|\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"kind\": \"manual\"})\n48|\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", 7, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n49|\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", 8, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"execution_profile\": \"standard\", \"profile_source_event_id\": changed, \"terminal_backend\": \"tmux\", \"native_session_id\": \"sess-1\"})\n50|\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 9, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n51|\tcpB := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n52|\tannouncedB := appendEvent(t, local, idA, idle, \"checkpoint.created\", 10, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpB), \"kind\": \"manual\"})\n53|\ttail := appendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n54|\tr := &Reader{Local: local, LocalHostID: hostA}\n55|\twithCheckpoints(r, cpB, cpA)\n56|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cpB)))\n57|\t_ = announced\n58|\t_ = tail\n59|\trev7CheckEntries(t, r, bad)\n60|\tif bad {return}; old := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n61|\tif err := r.Revalidate(old); err != nil {\n62|\t\tt.Errorf(\"fresh Revalidate refused valid resume profile authority: %v\", err)\n63|\t}\n64|}) }\n65|}","final_result":true}}}
