{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c715","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":485,"recorded_at":1780531400000965,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"task_stream":{"kind":"task","id":"01a0aa4e-54ed-7991-9ed6-b3ef61652d06"},"task_id":"01a0aa4e-54ed-7991-9ed6-b3ef61652d06","event":{"kind":"output","task_id":"01a0aa4e-54ed-7991-9ed6-b3ef61652d06","chunk":"Read text file `internal/sessquery/lease.go`.\n(299 line(s) above)\n300|\t}\n301|\treturn out, nil\n302|}\n303|\n304|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n305|// Record for one session and validates its succession: the\n306|// predecessor ancestry must chain by epoch plus one down to an\n307|// epoch-1 root, and every lease in that winning ancestry above\n308|// epoch 1 must reference a validated checkpoint for its session and\n309|// predecessor lease (Section 5.3), each created by the owning lease\n310|// holder (Section 5.4). Every required checkpoint must additionally\n311|// carry the persistence variant the referenced Session Record\n312|// selects: sessionKind is that record's kind as projected from the\n313|// winning source, and a variant mismatch refuses\n314|// observation_unavailable even when canonical identity, session,\n315|// lease, epoch, and creator all agree. Every required checkpoint\n316|// must also resolve each event head to a chained event for its\n317|// session at or before its bound lease in the winning source chain\n318|// (repo, Section 5.4 event-head closure): a head naming an absent\n319|// event or an event under a later lease cannot establish current\n320|// complete authority, so it refuses observation_unavailable;\n321|// historical heads stay admissible and are never required to equal\n322|// the current tail. Every required checkpoint must also admit its\n323|// Section 2.4 profile authority over the same closure\n324|// (checkCheckpointProfileAuthority): a first launch outside the\n325|// creation pair, or a later pair outside the newest authoritative\n326|// change, contradicts the admitted history (integrity failure).\n327|// Absence refuses observation_unavailable; a\n328|// lease above epoch 1 without its named predecessor in the admitted\n329|// set refuses the same class rather than binding a dangling\n330|// successor, while an illegal predecessor link is malformed\n331|// authority (integrity failure).\n332|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {\n333|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n334|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n335|\t}\n336|\tbySession, err := reader.validatedLeasesBySession()\n337|\tif err != nil {\n338|\t\treturn validatedLease{}, err\n339|\t}\n340|\tcandidates := bySession[sessionID]\n341|\tif len(candidates) == 0 {\n342|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n343|\t}\n344|\twinner := candidates[0]\n345|\tfor _, candidate := range candidates[1:] {\n346|\t\tif sessstate.Compare(\n347|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n348|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n349|\t\t) > 0 {\n350|\t\t\twinner = candidate\n351|\t\t}\n352|\t}\n353|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n354|\tif err != nil {\n355|\t\treturn validatedLease{}, err\n356|\t}\n357|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo); err != nil {\n358|\t\treturn validatedLease{}, err\n359|\t}\n360|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {\n361|\t\treturn validatedLease{}, err\n362|\t}\n363|\treturn winner, nil\n364|}\n365|\n366|// checkLeaseChain validates the winner's predecessor ancestry within\n367|// the admitted records for its session. Section 5.3 requires every\n368|// epoch above 1 to name a known predecessor for the same session\n369|// with an epoch exactly one below, down to an epoch-1 root with a\n370|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n371|// lease naming any predecessor is malformed. A self, cyclic,\n372|// skipped, contradictory, or duplicated link is malformed authority\n373|// (integrity failure); a missing predecessor name or record is\n374|// incomplete authority (observation_unavailable). Epochs strictly\n375|// decrease along the walk, so the walk always terminates. It\n376|// returns the winning ancestry from the winner down to the epoch-1\n377|// root, plus the winner's direct predecessor, or the zero lease at\n378|// epoch 1.\n379|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n380|\tbyLease := make(map[string]validatedLease, len(candidates))\n381|\tfor _, candidate := range candidates {\n382|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n383|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n384|\t\t}\n385|\t\tbyLease[candidate.LeaseID] = candidate\n386|\t}\n387|\tvar predecessor validatedLease\n388|\tvar chain []validatedLease\n389|\tcurrent := winner\n390|\tfor {\n391|\t\tchain = append(chain, current)\n392|\t\tif current.Epoch == 1 {\n393|\t\t\tif current.HasPredecessor {\n394|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n395|\t\t\t}\n396|\t\t\treturn chain, predecessor, nil\n397|\t\t}\n398|\t\tif !current.HasPredecessor {\n399|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n400|\t\t}\n401|\t\tparent, ok := byLease[current.Predecessor]\n402|\t\tif !ok {\n403|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n404|\t\t}\n405|\t\tif parent.Epoch+1 != current.Epoch {\n406|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n407|\t\t}\n408|\t\tif current.LeaseID == winner.LeaseID {\n409|\t\t\tpredecessor = parent\n410|\t\t}\n411|\t\tcurrent = parent\n412|\t}\n413|}\n414|\n415|// validatedCheckpointsByDigest validates every supplied Checkpoint\n416|// Record and indexes the admitted records by canonical digest.\n417|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n418|\tout := map[string]validatedCheckpoint{}\n419|\tif reader == nil {\n420|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n421|\t}\n422|\tfor _, raw := range reader.CheckpointRecords {\n423|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n424|\t\tif err != nil {\n425|\t\t\treturn nil, err\n426|\t\t}\n427|\t\tout[checkpoint.Digest] = checkpoint\n428|\t}\n429|\treturn out, nil\n430|}\n431|\n432|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n433|// against the admitted Checkpoint Records. Section 5.3 requires\n434|// every epoch above 1 to reference a validated checkpoint for its\n435|// session and predecessor lease; an epoch-1 root without a\n436|// predecessor may carry no checkpoint before the first provider\n437|// boundary exists. A non-null reference must resolve to an admitted\n438|// record for the same session bound to the lease it was taken\n439|// under: the predecessor for a successor, the winner itself at\n440|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n441|// unresolvable reference is incomplete authority\n442|// (observation_unavailable), never absence or a minted fact. The\n443|// admitted checkpoint must also resolve its event-head closure in\n444|// the winning source chain (repo); see checkCheckpointEventHeads.\n445|// The same closure must then admit its Section 2.4 profile\n446|// authority; see checkCheckpointProfileAuthority.\n447|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n448|\tif !winner.HasCheckpoint {\n449|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n450|\t\t\treturn nil\n451|\t\t}\n452|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n453|\t}\n454|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n455|\tif err != nil {\n456|\t\treturn err\n457|\t}\n458|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n459|\tif !ok {\n460|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n461|\t}\n462|\tif checkpoint.SessionID != winner.SessionID {\n463|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n464|\t}\n465|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n466|\tif winner.Epoch > 1 {\n467|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n468|\t}\n469|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n470|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n471|\t}\n472|\towner := winner\n473|\tif winner.Epoch > 1 {\n474|\t\towner = predecessor\n475|\t}\n476|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n477|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n478|\t}\n479|\tif err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {\n480|\t\treturn err\n481|\t}\n482|\tif err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {\n483|\t\treturn err\n484|\t}\n485|\tif err := checkCheckpointProfileAuthority(checkpoint, repo); err != nil {\n486|\t\treturn err\n487|\t}\n488|\treturn nil\n489|}\n490|\n491|// checkAncestorCheckpoints validates the checkpoint references of\n492|// every non-winner lease in the winning ancestry: Section 5.3\n493|// requires each epoch above 1 to reference a validated checkpoint\n494|// for its session and predecessor lease, and Section 5.4 requires\n495|// that checkpoint to be created by the owning lease holder. The\n496|// winner itself is covered by checkWinnerCheckpoint. Only the\n497|// winner's own ancestry is admitted: sibling branches off that\n498|// chain are never consulted, so legal branching is preserved. An\n499|// epoch-1 root without a reference stays admissible before the\n500|// first provider boundary exists; a reference it does carry must\n501|// resolve to a checkpoint bound to itself and created by its own\n502|// holder. An unresolvable reference or a binding to another\n503|// session, lease, or holder is incomplete authority\n504|// (observation_unavailable), never absence or a minted fact. Every\n505|// admitted ancestor checkpoint must also resolve its event-head\n506|// closure in the winning source chain (repo) and admit its Section\n507|// 2.4 profile authority over that closure.\n508|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n509|\tif len(chain) < 2 {\n510|\t\treturn nil\n511|\t}\n512|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n513|\tif err != nil {\n514|\t\treturn err\n515|\t}\n516|\tfor index := 1; index < len(chain); index++ {\n517|\t\tcurrent := chain[index]\n518|\t\tif current.Epoch == 1 {\n519|\t\t\tif !current.HasCheckpoint {\n520|\t\t\t\tcontinue\n521|\t\t\t}\n522|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo); err != nil {\n523|\t\t\t\treturn err\n524|\t\t\t}\n525|\t\t\tcontinue\n526|\t\t}\n527|\t\tif !current.HasCheckpoint {\n528|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n529|\t\t}\n530|\t\tif index+1 >= len(chain) {\n531|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n532|\t\t}\n533|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo); err != nil {\n534|\t\t\treturn err\n535|\t\t}\n536|\t}\n537|\treturn nil\n538|}\n539|\n540|// checkCheckpointBinding resolves one lease's checkpoint reference\n541|// against the admitted Checkpoint Records and validates its Section\n542|// 5.3 session and predecessor-lease binding with its Section 5.4\n543|// holder binding: the checkpoint must name this session and the\n544|// owning lease, and its creator must be that lease's holder. The\n545|// admitted checkpoint must also resolve its event-head closure in\n546|// the winning source chain (repo); see checkCheckpointEventHeads.\n547|// The same closure must then admit its Section 2.4 profile\n548|// authority; see checkCheckpointProfileAuthority.\n549|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository) error {\n550|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n551|\tif !ok {\n552|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n553|\t}\n554|\tif checkpoint.SessionID != current.SessionID {\n555|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n556|\t}\n557|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n558|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n559|\t}\n560|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n561|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n562|\t}\n563|\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n564|\t\treturn err\n565|\t}\n566|\tif err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {\n567|\t\treturn err\n568|\t}\n569|\tif err := checkCheckpointProfileAuthority(checkpoint, repo); err != nil {\n570|\t\treturn err\n571|\t}\n572|\treturn nil\n573|}\n574|\n575|// checkCheckpointEventHeads resolves every event head of one admitted\n576|// Checkpoint Record against the winning source chain for its session\n577|// (Section 5.4 event-head closure). Each head must name a chained\n578|// event for the same session at or before the owning lease: a head\n579|// naming an absent event (including a cross-session digest, a\n580|// losing-lease preserved blob outside the authoritative chain, or a\n581|// synthetic placeholder) is incomplete authority\n582|// (observation_unavailable), and a head under a later lease (a\n583|// greater epoch, or the same epoch under a different fencing token)\n584|// is likewise incomplete authority because the checkpoint cannot fix\n585|// authority over events that postdate it. Historical heads stay\n586|// admissible and are never required to equal the current tail, so\n587|// valid branching and lagging copies are preserved. A failed chain\n588|// read keeps its cause inside the same incomplete-authority refusal\n589|// instead of minting a fact, and a nil chain handle refuses the same\n590|// class rather than skipping the gate.\n591|func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {\n592|\tif repo == nil {\n593|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n594|\t}\n595|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n596|\tif err != nil {\n597|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n598|\t}\n599|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n600|\tfor _, summary := range events {\n601|\t\tbyID[summary.EventID] = summary\n602|\t}\n603|\tfor _, head := range checkpoint.EventHeads {\n604|\t\tsummary, ok := byID[head]\n605|\t\tif !ok {\n606|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)\n607|\t\t}\n608|\t\tif summary.LeaseEpoch > owner.Epoch {\n609|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)\n610|\t\t}\n611|\t\tif summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {\n612|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)\n613|\t\t}\n614|\t}\n615|\treturn nil\n616|}\n617|\n618|// checkCheckpointProfileAuthority admits the Section 2.4 effective\n619|// execution profile and its nullable source event for one required\n620|// checkpoint against the winning source chain (repo, SPEC 5.4\n621|// event-head closure). The transitive predecessor closure of the\n622|// checkpoint heads fixes both values: the Session Record carries the\n623|// creation profile, the first launch in the closure carries that\n624|// profile with a null source, and every later provider/task-board\n625|// launch or session resume carries the newest authoritative\n626|// profile.changed event at or before it with the profile it\n627|// targets. A non-null source must name a chained profile.changed\n628|// event inside the closure; a missing (dangling, cross-session, or\n629|// preserved outside the authoritative index), out-of-closure\n630|// (later local-only or losing-lease), wrong-type, or non-newest\n631|// reference is contradictory authority (integrity failure), as is a\n632|// pair whose profile value does not equal the derived effective\n633|// profile — consumers MUST NOT consult a later local-only event or\n634|// fall back to the creation value. Historical heads stay admissible\n635|// because derivation reads only the closure, never the current\n636|// tail. fork.created carries new-session authority plus\n637|// cross-session provenance (Section 2.4), which this closure cannot\n638|// derive, so the canonical shape owner pins its null source and\n639|// this gate does not re-derive it. A failed chain read keeps its\n640|// cause inside the incomplete-authority refusal instead of minting\n641|// a fact, and a nil chain handle refuses the same class rather\n642|// than skipping the gate. Payloads are fetched only for pair and\n643|// change events in the closure; the index already carries every\n644|// other routing member the walk needs.\n645|func checkCheckpointProfileAuthority(checkpoint validatedCheckpoint, repo *sessrepo.Repository) error {\n646|\tif repo == nil {\n647|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s profile authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n648|\t}\n649|\trecordBytes, err := repo.GetRecord(checkpoint.SessionID)\n(more lines below)","final_result":true}}}
