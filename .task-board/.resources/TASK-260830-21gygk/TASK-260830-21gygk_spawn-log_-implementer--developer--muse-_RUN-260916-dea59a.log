{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f7","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":726,"recorded_at":1780531400001447,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"task_stream":{"kind":"task","id":"01a0aa4e-e9a9-70a0-b01a-4b4eb6db77aa"},"task_id":"01a0aa4e-e9a9-70a0-b01a-4b4eb6db77aa","event":{"kind":"started","task_id":"01a0aa4e-e9a9-70a0-b01a-4b4eb6db77aa","span_id":"882b3a60894ce345"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f9","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":727,"recorded_at":1780531400001449,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"task_stream":{"kind":"task","id":"01a0aa4e-e97f-7951-9d7f-a7790598e0da"},"task_id":"01a0aa4e-e97f-7951-9d7f-a7790598e0da","event":{"kind":"output","task_id":"01a0aa4e-e97f-7951-9d7f-a7790598e0da","chunk":"Read text file `internal/sessquery/rev7_regression_test.go`.\n1|// Checkpoint event-head authority regression tests for\n2|// TASK-260830-21gygk (SPEC 5.4, CR7 P1): every required checkpoint\n3|// in the winning ancestry must resolve each event head to a chained\n4|// event for its session at or before its bound lease in the winning\n5|// source chain. A head naming an absent event or an event under a\n6|// later lease cannot establish current complete authority. Every\n7|// case drives the four shared production entries (BuildPlan,\n8|// Revalidate fresh and old-plan, AuthoritativeStatus,\n9|// AuthoritativeList), never the validators directly. Ported from the\n10|// CR7 independent reviewer regression and retained as the candidate\n11|// positive/negative control for the shared admission path.\n12|package sessquery\n13|\n14|import (\n15|\t\"encoding/json\"\n16|\t\"errors\"\n17|\t\"testing\"\n18|)\n19|\n20|func rev7Replace(t *testing.T, raw []byte, self string, values map[string]any) []byte {\n21|\tt.Helper()\n22|\tvar v map[string]any\n23|\tif err := json.Unmarshal(raw, &v); err != nil {\n24|\t\tt.Fatal(err)\n25|\t}\n26|\tfor k, value := range values {\n27|\t\tv[k] = value\n28|\t}\n29|\treturn identity(t, v, self)\n30|}\n31|\n32|// Complete local event histories give the checkpoint a real idle head under\n33|// its owning predecessor, rather than the shipped fixture's zero digest.\n34|// Manifest publication/storage is the accepted external fixture boundary.\n35|func rev7Fixture(t *testing.T, kind string, ancestor bool) (*Reader, string) {\n36|\tt.Helper()\n37|\tlocal, _ := repository(t)\n38|\traw := record(t, idA, \"alpha\")\n39|\tif kind == \"task_board\" {\n40|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n41|\t}\n42|\tref, err := local.CreateSession(raw)\n43|\tif err != nil {\n44|\t\tt.Fatal(err)\n45|\t}\n46|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n47|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n48|\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n49|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n50|\tif kind == \"task_board\" {\n51|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n52|\t}\n53|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n54|\tr := &Reader{Local: local, LocalHostID: hostA}\n55|\twithCheckpoints(r, cp)\n56|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n57|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 4, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n58|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n59|\tif ancestor {\n60|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n61|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n62|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n63|\t\tif kind == \"task_board\" {\n64|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n65|\t\t}\n66|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n67|\t\twithCheckpoints(r, cp2)\n68|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n69|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n70|\t}\n71|\trev7CheckEntries(t, r, false)\n72|\treturn r, tail\n73|}\n74|\n75|func rev7SwapCheckpoint(t *testing.T, r *Reader, cp []byte) {\n76|\tt.Helper()\n77|\tr.CheckpointRecords[0] = cp\n78|\tfor i, raw := range r.LeaseRecords {\n79|\t\tvar v map[string]any\n80|\t\tif err := json.Unmarshal(raw, &v); err != nil {\n81|\t\t\tt.Fatal(err)\n82|\t\t}\n83|\t\tif v[\"lease_id\"] == leaseB {\n84|\t\t\tr.LeaseRecords[i] = rev7Replace(t, raw, \"record_id\", map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp)})\n85|\t\t}\n86|\t}\n87|}\n88|\n89|func TestRev7IndependentPersistence(t *testing.T) {\n90|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n91|\t\tfor _, ancestor := range []bool{false, true} {\n92|\t\t\tpath := \"winner\"\n93|\t\t\tif ancestor {\n94|\t\t\t\tpath = \"ancestor\"\n95|\t\t\t}\n96|\t\t\tfor _, wrong := range []bool{false, true} {\n97|\t\t\t\tmode := \"control\"\n98|\t\t\t\tif wrong {\n99|\t\t\t\t\tmode = \"wrong_variant\"\n100|\t\t\t\t}\n101|\t\t\t\tt.Run(kind+\"/\"+path+\"/\"+mode, func(t *testing.T) {\n102|\t\t\t\t\tr, _ := rev7Fixture(t, kind, ancestor)\n103|\t\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n104|\t\t\t\t\tif wrong {\n105|\t\t\t\t\t\tchange := map[string]any{\"provider_manifest_id\": nil, \"task_board_bundle_id\": zeroDigest}\n106|\t\t\t\t\t\tif kind == \"task_board\" {\n107|\t\t\t\t\t\t\tchange = map[string]any{\"provider_manifest_id\": zeroDigest, \"task_board_bundle_id\": nil}\n108|\t\t\t\t\t\t}\n109|\t\t\t\t\t\trev7SwapCheckpoint(t, r, rev7Replace(t, r.CheckpointRecords[0], \"checkpoint_id\", change))\n110|\t\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n111|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admitted wrong persistence variant\")\n112|\t\t\t\t\t\t}\n113|\t\t\t\t\t}\n114|\t\t\t\t\trev7CheckEntries(t, r, wrong)\n115|\t\t\t\t})\n116|\t\t\t}\n117|\t\t}\n118|\t}\n119|}\n120|\n121|func TestRev7CheckpointHeadAuthority(t *testing.T) {\n122|\tfor _, ancestor := range []bool{false, true} {\n123|\t\tpath := \"winner\"\n124|\t\tif ancestor {\n125|\t\t\tpath = \"ancestor\"\n126|\t\t}\n127|\t\tfor _, mode := range []string{\"control\", \"missing_head\", \"later_lease_head\"} {\n128|\t\t\tt.Run(path+\"/\"+mode, func(t *testing.T) {\n129|\t\t\t\tr, future := rev7Fixture(t, \"direct\", ancestor)\n130|\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n131|\t\t\t\tif mode != \"control\" {\n132|\t\t\t\t\thead := zeroDigest\n133|\t\t\t\t\tif mode == \"later_lease_head\" {\n134|\t\t\t\t\t\thead = future\n135|\t\t\t\t\t}\n136|\t\t\t\t\trev7SwapCheckpoint(t, r, rev7Replace(t, r.CheckpointRecords[0], \"checkpoint_id\", map[string]any{\"event_heads\": []string{head}}))\n137|\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n138|\t\t\t\t\t\tt.Error(\"old-plan Revalidate admitted invalid checkpoint event-head authority\")\n139|\t\t\t\t\t} else if !errors.Is(err, ErrObservationUnavailable) {\n140|\t\t\t\t\t\tt.Errorf(\"old-plan Revalidate refusal = %v, want observation_unavailable\", err)\n141|\t\t\t\t\t}\n142|\t\t\t\t}\n143|\t\t\t\trev7CheckEntries(t, r, mode != \"control\")\n144|\t\t\t\tif mode != \"control\" {\n145|\t\t\t\t\trev7CheckHeadRefusalClass(t, r)\n146|\t\t\t\t}\n147|\t\t\t})\n148|\t\t}\n149|\t}\n150|}\n151|\n152|// rev7CheckHeadRefusalClass pins the head-authority refusal to the\n153|// incomplete-authority class: resolvability is admitted before\n154|// profile derivation, so a missing or later-lease head refuses\n155|// observation_unavailable even though the Section 2.4 profile\n156|// closure would independently contradict it. The pin keeps the\n157|// CR8 profile gate from masking the CR7 heads gate in mutant\n158|// attribution: weakening the heads gate surfaces here as the wrong\n159|// class, never as silent admission.\n160|func rev7CheckHeadRefusalClass(t *testing.T, r *Reader) {\n161|\tt.Helper()\n162|\tmetadata := summaryReader(t)\n163|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n164|\tif _, err := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus}); err == nil {\n165|\t\tt.Fatal(\"BuildPlan admitted invalid checkpoint event-head authority\")\n166|\t} else if !errors.Is(err, ErrObservationUnavailable) {\n167|\t\tt.Fatalf(\"BuildPlan refusal = %v, want observation_unavailable\", err)\n168|\t}\n169|\tif _, err := r.AuthoritativeStatus(\"alpha\"); err == nil {\n170|\t\tt.Fatal(\"AuthoritativeStatus admitted invalid checkpoint event-head authority\")\n171|\t} else if !errors.Is(err, ErrObservationUnavailable) {\n172|\t\tt.Fatalf(\"AuthoritativeStatus refusal = %v, want observation_unavailable\", err)\n173|\t}\n174|\tif _, err := r.AuthoritativeList(); err == nil {\n175|\t\tt.Fatal(\"AuthoritativeList admitted invalid checkpoint event-head authority\")\n176|\t} else if !errors.Is(err, ErrObservationUnavailable) {\n177|\t\tt.Fatalf(\"AuthoritativeList refusal = %v, want observation_unavailable\", err)\n178|\t}\n179|}\n180|\n181|func rev7CheckEntries(t *testing.T, r *Reader, refuse bool) {\n182|\tt.Helper()\n183|\tmetadata := summaryReader(t)\n184|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n185|\tstamp := \"2026-08-19T04:09:30.000Z\"\n186|\tobservation := r.Observations[idA]\n187|\tobservation.NewestCheckpointCreatedAt = &stamp\n188|\tr.Observations[idA] = observation\n189|\tp, buildErr := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n190|\tif refuse && buildErr == nil {\n191|\t\tt.Errorf(\"BuildPlan admitted invalid lease/checkpoint authority; Revalidate=%v\", r.Revalidate(p))\n192|\t}\n193|\tif !refuse && buildErr != nil {\n194|\t\tt.Fatalf(\"positive BuildPlan: %v\", buildErr)\n195|\t}\n196|\tif !refuse {\n197|\t\tif err := r.Revalidate(p); err != nil {\n198|\t\t\tt.Errorf(\"positive Revalidate: %v\", err)\n199|\t\t}\n200|\t}\n201|\t_, statusErr := r.AuthoritativeStatus(\"alpha\")\n202|\t_, listErr := r.AuthoritativeList()\n203|\tif refuse && statusErr == nil {\n204|\t\tt.Error(\"AuthoritativeStatus admitted invalid lease/checkpoint authority\")\n205|\t}\n206|\tif refuse && listErr == nil {\n207|\t\tt.Error(\"AuthoritativeList admitted invalid lease/checkpoint authority\")\n208|\t}\n209|\tif !refuse && (statusErr != nil || listErr != nil) {\n210|\t\tt.Errorf(\"positive summaries: status=%v list=%v\", statusErr, listErr)\n211|\t}\n212|}","final_result":true}}}
