{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8bb","stream":{"kind":"session","id":"01a0aa4d-35aa-7773-97f7-293f4760a2d6"},"sequence":696,"recorded_at":1780531400001387,"record_type":"event","durability":"durable","causation_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a1715be3-1f15-4a95-87f8-c19d8786aea9","run_stream":{"kind":"run","id":"a1715be3-1f15-4a95-87f8-c19d8786aea9"},"call_id":"call_01a0aa4ed50c7172aecbf6e03d3591e0","text":"Read text file `internal/sessquery/rev8_regression_test.go`.\n1|// Checkpoint profile-authority regression tests for\n2|// TASK-260830-21gygk (SPEC 5.4 event-head closure plus referenced\n3|// 2.4 and 5.2, CR8 P1): every required checkpoint in the winning\n4|// ancestry must admit its transitive event-head closure as Section\n5|// 2.4 profile authority. The first launch carries the Session Record\n6|// creation profile with a null source; every later launch, resume,\n7|// or fork event carries the newest authoritative profile.changed\n8|// event at or before it, and no consumer consults a later\n9|// local-only event or falls back to the creation value. Every case\n10|// drives the four shared production entries (BuildPlan, Revalidate\n11|// fresh and old-plan, AuthoritativeStatus, AuthoritativeList),\n12|// never the validators directly. The rev8 fixture is ported from\n13|// the CR8 independent reviewer regression.\n14|package sessquery\n15|\n16|import (\n17|\t\"encoding/json\"\n18|\t\"errors\"\n19|\t\"fmt\"\n20|\t\"testing\"\n21|\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|// leaseLoser is a second epoch-1 fencing token: events under it\n27|// diverge from the chain head lease, so the repository preserves\n28|// their blobs without indexing them (losing-lease branch).\n29|const leaseLoser = \"cccccccc-dddd-4eee-8fff-111111111111\"\n30|\n31|func rev8ProfileFixture(t *testing.T, kind string, ancestor bool, bad bool) (*Reader, string) {\n32|\tt.Helper()\n33|\tlocal, _ := repository(t)\n34|\traw := record(t, idA, \"alpha\")\n35|\tif kind == \"task_board\" {\n36|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n37|\t}\n38|\tref, err := local.CreateSession(raw)\n39|\tif err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n43|\tvar source any\n44|\tif bad {\n45|\t\tsource = zeroDigest\n46|\t}\n47|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": source, \"profile_mapping\": \"default\"})\n48|\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n49|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n50|\tif kind == \"task_board\" {\n51|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n52|\t}\n53|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n54|\tr := &Reader{Local: local, LocalHostID: hostA}\n55|\twithCheckpoints(r, cp)\n56|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n57|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 4, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n58|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n59|\tif ancestor {\n60|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n61|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n62|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n63|\t\tif kind == \"task_board\" {\n64|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n65|\t\t}\n66|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n67|\t\twithCheckpoints(r, cp2)\n68|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n69|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n70|\t}\n71|\treturn r, tail\n72|}\n73|\n74|func TestRev8CheckpointProfileAuthority(t *testing.T) {\n75|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n76|\t\tfor _, ancestor := range []bool{false, true} {\n77|\t\t\tfor _, bad := range []bool{false, true} {\n78|\t\t\t\tt.Run(fmt.Sprintf(\"%s/ancestor=%t/missing_source=%t\", kind, ancestor, bad), func(t *testing.T) {\n79|\t\t\t\t\tr, _ := rev8ProfileFixture(t, kind, ancestor, bad)\n80|\t\t\t\t\trev7CheckEntries(t, r, bad)\n81|\t\t\t\t})\n82|\t\t\t}\n83|\t\t}\n84|\t}\n85|}\n86|\n87|// rev8LaunchPayload builds one provider.launched payload carrying\n88|// the given Section 2.4 pair. A nil source renders the required\n89|// null for the creation pair.\n90|func rev8LaunchPayload(profile string, source any) map[string]any {\n91|\treturn map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": profile, \"profile_source_event_id\": source, \"profile_mapping\": \"default\"}\n92|}\n93|\n94|// rev8ChangedPayload builds one authoritative profile.changed\n95|// payload moving from one profile to the other.\n96|func rev8ChangedPayload(from, to string) map[string]any {\n97|\treturn map[string]any{\"from\": from, \"to\": to, \"confirmed\": true}\n98|}\n99|\n100|// rev8ChangeFixture builds a session whose closure carries a real\n101|// authoritative change: created(1) -> launch(2, yolo/null) ->\n102|// E1(3, yolo->standard) -> launch2(4, standard/E1) -> idle(5) with\n103|// the checkpoint over idle, then the epoch-2 transfer. The ancestor\n104|// variant extends the winning ancestry with a second launch under\n105|// the successor lease that still cites E1. Both closures derive\n106|// (standard, E1) with no fallback to the creation value.\n107|func rev8ChangeFixture(t *testing.T, kind string, ancestor bool) *Reader {\n108|\tt.Helper()\n109|\tlocal, _ := repository(t)\n110|\traw := record(t, idA, \"alpha\")\n111|\tif kind == \"task_board\" {\n112|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n113|\t}\n114|\tref, err := local.CreateSession(raw)\n115|\tif err != nil {\n116|\t\tt.Fatal(err)\n117|\t}\n118|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n119|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n120|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n121|\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", changed))\n122|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n123|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n124|\tif kind == \"task_board\" {\n125|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n126|\t}\n127|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n128|\tr := &Reader{Local: local, LocalHostID: hostA}\n129|\twithCheckpoints(r, cp)\n130|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n131|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n132|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n133|\tif ancestor {\n134|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, rev8LaunchPayload(\"standard\", changed))\n135|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n136|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n137|\t\tif kind == \"task_board\" {\n138|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n139|\t\t}\n140|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n141|\t\twithCheckpoints(r, cp2)\n142|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n143|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n144|\t}\n145|\t_ = tail\n146|\treturn r\n147|}\n148|\n149|// rev8CheckIntegrityRefusal drives the four shared production\n150|// entries and requires each to refuse with integrity failure: the\n151|// profile gate contradicts corrupt history, it never reports it\n152|// merely unavailable.\n153|func rev8CheckIntegrityRefusal(t *testing.T, r *Reader) {\n154|\tt.Helper()\n155|\tmetadata := summaryReader(t)\n156|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n157|\tstamp := \"2026-08-19T04:09:30.000Z\"\n158|\tobservation := r.Observations[idA]\n159|\tobservation.NewestCheckpointCreatedAt = &stamp\n160|\tr.Observations[idA] = observation\n161|\tplan, buildErr := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n162|\tif buildErr == nil {\n163|\t\tt.Fatalf(\"BuildPlan admitted corrupt profile authority; Revalidate=%v\", r.Revalidate(plan))\n164|\t}\n165|\tif !errors.Is(buildErr, sessstate.ErrIntegrity) {\n166|\t\tt.Errorf(\"BuildPlan refusal = %v, want integrity_failure\", buildErr)\n167|\t}\n168|\tif _, err := r.AuthoritativeStatus(\"alpha\"); err == nil {\n169|\t\tt.Error(\"AuthoritativeStatus admitted corrupt profile authority\")\n170|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n171|\t\tt.Errorf(\"AuthoritativeStatus refusal = %v, want integrity_failure\", err)\n172|\t}\n173|\tif _, err := r.AuthoritativeList(); err == nil {\n174|\t\tt.Error(\"AuthoritativeList admitted corrupt profile authority\")\n175|\t} else if !errors.Is(err, sessstate.ErrIntegrity) {\n176|\t\tt.Errorf(\"AuthoritativeList refusal = %v, want integrity_failure\", err)\n177|\t}\n178|}\n179|\n180|func TestRev8ProfileChangedPositiveControl(t *testing.T) {\n181|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n182|\t\tfor _, ancestor := range []bool{false, true} {\n183|\t\t\tname := fmt.Sprintf(\"%s/ancestor=%t\", kind, ancestor)\n184|\t\t\tt.Run(name, func(t *testing.T) {\n185|\t\t\t\tr := rev8ChangeFixture(t, kind, ancestor)\n186|\t\t\t\trev7CheckEntries(t, r, false)\n187|\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n188|\t\t\t\tif err := r.Revalidate(old); err != nil {\n189|\t\t\t\t\tt.Errorf(\"fresh Revalidate refused valid profile authority: %v\", err)\n190|\t\t\t\t}\n191|\t\t\t})\n192|\t\t}\n193|\t}\n194|}\n195|\n196|// TestRev8ProfileResumePositiveControl proves a resume carries the\n197|// checkpoint effective pair instead of falling back to the\n198|// creation value: E1 moves the closure to standard, and the resume\n199|// from the E1 checkpoint carries (standard, E1).\n200|func TestRev8ProfileResumePositiveControl(t *testing.T) {\n201|\tlocal, _ := repository(t)\n202|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n203|\tif err != nil {\n204|\t\tt.Fatal(err)\n205|\t}\n206|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n207|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n208|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n209|\tquiesced := appendEvent(t, local, idA, changed, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-0\", \"foreground_idle\": true, \"background_idle\": true})\n210|\tcpA := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{quiesced}})\n211|\tannounced := appendEvent(t, local, idA, quiesced, \"checkpoint.created\", 5, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"kind\": \"manual\"})\n212|\tstopped := appendEvent(t, local, idA, announced, \"session.stopped\", 6, map[string]any{\"graceful\": true, \"checkpoint_id\": checkpointDigestOf(t, cpA), \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true})\n213|\tresumed := appendEvent(t, local, idA, stopped, \"session.resumed\", 7, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpA), \"execution_profile\": \"standard\", \"profile_source_event_id\": changed, \"terminal_backend\": \"tmux\", \"native_session_id\": \"sess-1\"})\n214|\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 8, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n215|\tcpB := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n216|\tannouncedB := appendEvent(t, local, idA, idle, \"checkpoint.created\", 9, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cpB), \"kind\": \"manual\"})\n217|\ttail := appendEventAs(t, local, idA, announcedB, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n218|\tr := &Reader{Local: local, LocalHostID: hostA}\n219|\twithCheckpoints(r, cpB)\n220|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cpB)))\n221|\t_ = announced\n222|\t_ = tail\n223|\trev7CheckEntries(t, r, false)\n224|\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n225|\tif err := r.Revalidate(old); err != nil {\n226|\t\tt.Errorf(\"fresh Revalidate refused valid resume profile authority: %v\", err)\n227|\t}\n228|}\n229|\n230|// TestRev8ProfileTwoGenerationControl proves the derivation tracks\n231|// the newest change across generations: E2 supersedes E1, and the\n232|// later launch cites (yolo, E2).\n233|func TestRev8ProfileTwoGenerationControl(t *testing.T) {\n234|\tlocal, _ := repository(t)\n235|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n236|\tif err != nil {\n237|\t\tt.Fatal(err)\n238|\t}\n239|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n240|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n241|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n242|\tchanged2 := appendEvent(t, local, idA, changed, \"profile.changed\", 4, rev8ChangedPayload(\"standard\", \"yolo\"))\n243|\tlaunched2 := appendEvent(t, local, idA, changed2, \"provider.launched\", 5, rev8LaunchPayload(\"yolo\", changed2))\n244|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 6, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n245|\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n246|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 7, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n247|\t_ = announced\n248|\tappendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n249|\tr := &Reader{Local: local, LocalHostID: hostA}\n250|\twithCheckpoints(r, cp)\n251|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n252|\trev7CheckEntries(t, r, false)\n253|}\n254|\n255|// TestRev8ProfileSourceRefusals drives one corrupt history per\n256|// rejected source class through all four shared entries: a source\n257|// naming a non-change event, a superseded change, a stale creation\n258|// value, a wrong first-launch profile, a dangling resume source, a\n259|// cross-session change, a losing-lease preserved change, and a\n260|// dangling closure predecessor. A citation of a well-formed later\n261|// local-only digest from inside the closure has no fixture: chain\n262|// continuity forces every prior event into the closure, so a\n263|// writer cannot cite its future; the historical control below\n264|// proves later events are never consulted instead.\n265|func TestRev8ProfileSourceRefusals(t *testing.T) {\n266|\tbuilders := map[string]func(t *testing.T) *Reader{\n267|\t\t\"wrong_type\": func(t *testing.T) *Reader {\n268|\t\t\tlocal, _ := repository(t)\n269|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n270|\t\t\tif err != nil {\n271|\t\t\t\tt.Fatal(err)\n272|\t\t\t}\n273|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n274|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n275|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n276|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", created))\n277|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n278|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n279|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n280|\t\t\twithCheckpoints(r, cp)\n281|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n282|\t\t\treturn r\n283|\t\t},\n284|\t\t\"non_newest\": func(t *testing.T) *Reader {\n285|\t\t\tlocal, _ := repository(t)\n286|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n287|\t\t\tif err != nil {\n288|\t\t\t\tt.Fatal(err)\n289|\t\t\t}\n290|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n291|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n292|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n293|\t\t\tchanged2 := appendEvent(t, local, idA, changed, \"profile.changed\", 4, rev8ChangedPayload(\"standard\", \"yolo\"))\n294|\t\t\tlaunched2 := appendEvent(t, local, idA, changed2, \"provider.launched\", 5, rev8LaunchPayload(\"standard\", changed))\n295|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 6, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n296|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n297|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n298|\t\t\twithCheckpoints(r, cp)\n299|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n300|\t\t\treturn r\n301|\t\t},\n302|\t\t\"stale_value\": func(t *testing.T) *Reader {\n303|\t\t\tlocal, _ := repository(t)\n304|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n305|\t\t\tif err != nil {\n306|\t\t\t\tt.Fatal(err)\n307|\t\t\t}\n308|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n309|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n310|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n311|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"yolo\", changed))\n312|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n313|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n314|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n315|\t\t\twithCheckpoints(r, cp)\n316|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n317|\t\t\treturn r\n318|\t\t},\n319|\t\t\"first_wrong_profile\": func(t *testing.T) *Reader {\n320|\t\t\tlocal, _ := repository(t)\n321|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n322|\t\t\tif err != nil {\n323|\t\t\t\tt.Fatal(err)\n324|\t\t\t}\n325|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n326|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"standard\", nil))\n327|\t\t\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n328|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n329|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n330|\t\t\twithCheckpoints(r, cp)\n331|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n332|\t\t\treturn r\n333|\t\t},\n334|\t\t\"dangling_resume_source\": func(t *testing.T) *Reader {\n335|\t\t\tlocal, _ := repository(t)\n336|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n337|\t\t\tif err != nil {\n338|\t\t\t\tt.Fatal(err)\n339|\t\t\t}\n340|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n341|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n342|\t\t\tresumed := appendEvent(t, local, idA, launched, \"session.resumed\", 3, map[string]any{\"checkpoint_id\": zeroDigest, \"execution_profile\": \"yolo\", \"profile_source_event_id\": zeroDigest, \"terminal_backend\": \"tmux\", \"native_session_id\": \"sess-1\"})\n343|\t\t\tidle := appendEvent(t, local, idA, resumed, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n344|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n345|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n346|\t\t\twithCheckpoints(r, cp)\n347|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n348|\t\t\treturn r\n349|\t\t},\n350|\t\t\"cross_session\": func(t *testing.T) *Reader {\n351|\t\t\tlocal, _ := repository(t)\n352|\t\t\tpeer := create(t, local, idB, \"beta\")\n353|\t\t\tpeerCreated := appendEvent(t, local, idB, peer.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": peer.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n354|\t\t\tpeerLaunched := appendEvent(t, local, idB, peerCreated, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n355|\t\t\tpeerChanged := appendEvent(t, local, idB, peerLaunched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n356|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n357|\t\t\tif err != nil {\n358|\t\t\t\tt.Fatal(err)\n359|\t\t\t}\n360|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n361|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n362|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n363|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", peerChanged))\n364|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n365|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n366|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n367|\t\t\twithCheckpoints(r, cp)\n368|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)), leaseCreate(t, idB, hostA))\n369|\t\t\treturn r\n370|\t\t},\n371|\t\t\"losing_branch\": func(t *testing.T) *Reader {\n372|\t\t\tlocal, _ := repository(t)\n373|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n374|\t\t\tif err != nil {\n375|\t\t\t\tt.Fatal(err)\n376|\t\t\t}\n377|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n378|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n379|\t\t\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n380|\t\t\tloser := rev8PreservedLoser(t, local, idA, changed)\n381|\t\t\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", loser))\n382|\t\t\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n383|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n384|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n385|\t\t\twithCheckpoints(r, cp)\n386|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n387|\t\t\treturn r\n388|\t\t},\n389|\t\t\"dangling_predecessor\": func(t *testing.T) *Reader {\n390|\t\t\tlocal, _ := repository(t)\n391|\t\t\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n392|\t\t\tif err != nil {\n393|\t\t\t\tt.Fatal(err)\n394|\t\t\t}\n395|\t\t\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n396|\t\t\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n397|\t\t\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n398|\t\t\tmerged := rev8AppendPreds(t, local, idA, []string{zeroDigest, idle}, \"session.idle\", 4, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n399|\t\t\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{merged}})\n400|\t\t\tr := &Reader{Local: local, LocalHostID: hostA}\n401|\t\t\twithCheckpoints(r, cp)\n402|\t\t\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n403|\t\t\treturn r\n404|\t\t},\n405|\t}\n406|\torder := []string{\"wrong_type\", \"non_newest\", \"stale_value\", \"first_wrong_profile\", \"dangling_resume_source\", \"cross_session\", \"losing_branch\", \"dangling_predecessor\"}\n407|\tfor _, name := range order {\n408|\t\tt.Run(name, func(t *testing.T) {\n409|\t\t\trev8CheckIntegrityRefusal(t, builders[name](t))\n410|\t\t})\n411|\t}\n412|}\n413|\n414|// rev8AppendPreds chains one event with an explicit predecessor\n415|// list, unlike the single-predecessor fixture helpers. The chain\n416|// owner still requires the prior tail inside the list, so a merge\n417|// naming a dangling digest appends and reaches the profile gate.\n418|func rev8AppendPreds(t *testing.T, repo *sessrepo.Repository, sessionID string, predecessors []string, typ string, sequence int, payload map[string]any) string {\n419|\tt.Helper()\n420|\tvalue := map[string]any{\n421|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n422|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"event_type\": typ, \"created_by_host_id\": hostA,\n423|\t\t\"lease_epoch\": 1, \"lease_id\": lease, \"lease_sequence\": sequence, \"predecessors\": predecessors,\n424|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n425|\t}\n426|\tref, err := repo.AppendEvent(sessionID, identity(t, value, \"event_id\"))\n427|\tif err != nil {\n428|\t\tt.Fatal(err)\n429|\t}\n430|\treturn ref.EventID\n431|}\n432|\n433|// rev8PreservedLoser appends one profile.changed event under a\n434|// losing same-epoch lease and returns its digest. The repository\n435|// preserves the blob without indexing it, so the digest is\n436|// well-formed and provider-signed yet outside the authoritative\n437|// chain: exactly the losing-lease member the profile gate must\n438|// reject.\n439|func rev8PreservedLoser(t *testing.T, repo *sessrepo.Repository, sessionID, predecessor string) string {\n440|\tt.Helper()\n441|\tvalue := map[string]any{\n442|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n443|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"event_type\": \"profile.changed\", \"created_by_host_id\": hostA,\n444|\t\t\"lease_epoch\": 1, \"lease_id\": leaseLoser, \"lease_sequence\": 1, \"predecessors\": []string{predecessor},\n445|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": rev8ChangedPayload(\"yolo\", \"standard\"), \"extensions\": map[string]any{},\n446|\t}\n447|\traw := identity(t, value, \"event_id\")\n448|\tvar decoded map[string]any\n449|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n450|\t\tt.Fatal(err)\n451|\t}\n452|\tdigest, _ := decoded[\"event_id\"].(string)\n453|\tif _, err := repo.AppendEvent(sessionID, raw); !errors.Is(err, sessrepo.ErrDivergentBranch) {\n454|\t\tt.Fatalf(\"losing-lease change append = %v, want divergent branch preservation\", err)\n455|\t}\n456|\tindexed, err := repo.ListEvents(sessionID)\n457|\tif err != nil {\n458|\t\tt.Fatal(err)\n459|\t}\n460|\tfor _, summary := range indexed {\n461|\t\tif summary.EventID == digest {\n462|\t\t\tt.Fatalf(\"losing-lease change %s entered the authoritative index\", digest)\n463|\t\t}\n464|\t}\n465|\treturn digest\n466|}\n467|\n468|// TestRev8ProfileHistoricalClosureAdmits proves the closure fixes\n469|// the effective pair: a later local-only change past the heads is\n470|// never consulted, so the checkpoint still admits with (standard,\n471|// E1) while the tail already moved on.\n472|func TestRev8ProfileHistoricalClosureAdmits(t *testing.T) {\n473|\tlocal, _ := repository(t)\n474|\tref, err := local.CreateSession(record(t, idA, \"alpha\"))\n475|\tif err != nil {\n476|\t\tt.Fatal(err)\n477|\t}\n478|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n479|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, rev8LaunchPayload(\"yolo\", nil))\n480|\tchanged := appendEvent(t, local, idA, launched, \"profile.changed\", 3, rev8ChangedPayload(\"yolo\", \"standard\"))\n481|\tlaunched2 := appendEvent(t, local, idA, changed, \"provider.launched\", 4, rev8LaunchPayload(\"standard\", changed))\n482|\tidle := appendEvent(t, local, idA, launched2, \"session.idle\", 5, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n483|\tcp := rev7Replace(t, checkpointRecordBytes(t, idA, 1, lease, hostA), \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n484|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 6, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n485|\ttransferred := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n486|\tlater := appendEventAs(t, local, idA, transferred, \"profile.changed\", 2, 2, leaseB, rev8ChangedPayload(\"standard\", \"yolo\"))\n487|\tr := &Reader{Local: local, LocalHostID: hostA}\n488|\twithCheckpoints(r, cp)\n489|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n490|\t_ = later\n491|\trev7CheckEntries(t, r, false)\n492|}\n493|\n494|// TestRev8ProfileOldPlanSubstitution proves an old plan revalidates\n495|// profile authority instead of trusting its bound lease: the plan\n496|// builds over the E1 checkpoint, then the reader substitutes a\n497|// checkpoint whose valid heads cover a stale creation pair, and\n498|// the old plan refuses with integrity failure while heads alone\n499|// would still admit it.\n500|func TestRev8ProfileOldPlanSubstitution(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
