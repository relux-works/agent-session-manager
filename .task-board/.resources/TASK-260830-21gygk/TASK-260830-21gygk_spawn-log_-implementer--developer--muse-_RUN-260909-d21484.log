{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c929","stream":{"kind":"session","id":"01a087bb-8c16-7c41-9df2-bf65e2d2e1e6"},"sequence":751,"recorded_at":1780531400001497,"record_type":"event","durability":"durable","causation_id":"a5a4bafa-7c8c-485e-ade1-b2a300d515d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5a4bafa-7c8c-485e-ade1-b2a300d515d9","run_stream":{"kind":"run","id":"a5a4bafa-7c8c-485e-ade1-b2a300d515d9"},"task_stream":{"kind":"task","id":"01a087bd-8ffc-7200-a477-f654f297ecce"},"task_id":"01a087bd-8ffc-7200-a477-f654f297ecce","event":{"kind":"output","task_id":"01a087bd-8ffc-7200-a477-f654f297ecce","chunk":"Read text file `internal/sessquery/digest.go`.\n1|// Local attestation digests for selector plans: canonical fingerprints\n2|// over validated reads, never over caller claims.\n3|//\n4|// fingerprint canonicalizes its input through the canonical-JSON owner\n5|// and digests the canonical bytes, so equal facts always produce equal\n6|// digests and any fact change invalidates the plans bound to them. The\n7|// resulting \"sha256:\" digests are self-checked through the scalar\n8|// digest grammar before use.\n9|package sessquery\n10|\n11|import (\n12|\t\"crypto/sha256\"\n13|\t\"encoding/hex\"\n14|\t\"encoding/json\"\n15|\t\"fmt\"\n16|\t\"sort\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n21|)\n22|\n23|// transportLabel names the index-read mechanism this stack uses: direct\n24|// local repository reads with no mesh transport. Binding the label into\n25|// the configuration digest invalidates every plan if a transport is\n26|// ever introduced, instead of silently reusing facts read another way.\n27|const transportLabel = \"local-direct\"\n28|\n29|// fingerprint canonicalizes value and returns the \"sha256:\" digest of\n30|// the canonical bytes.\n31|func fingerprint(value any) (string, error) {\n32|\traw, err := json.Marshal(value)\n33|\tif err != nil {\n34|\t\treturn \"\", err\n35|\t}\n36|\tcanonical, err := canonicaljson.Canonicalize(raw)\n37|\tif err != nil {\n38|\t\treturn \"\", err\n39|\t}\n40|\tsum := sha256.Sum256(canonical)\n41|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n42|\tif _, err := scalar.ParseDigest(digest); err != nil {\n43|\t\treturn \"\", err\n44|\t}\n45|\treturn digest, nil\n46|}\n47|\n48|// peerFingerprint is one configured peer mapping in the configuration\n49|// digest: exact alias with its host, in bytewise host order.\n50|type peerFingerprint struct {\n51|\tAlias  string `json:\"alias\"`\n52|\tHostID string `json:\"host_id\"`\n53|}\n54|\n55|// fingerprintConfiguration digests the effective validated\n56|// configuration: the local host, the peer mapping, the allowlist, and\n57|// the transport label. Handles are not configuration and stay out:\n58|// swapping a learned index without changing the mapping still changes\n59|// the index digest at read time.\n60|func fingerprintConfiguration(reader *Reader, config validatedConfig) (string, error) {\n61|\tpeers := make([]peerFingerprint, 0, len(reader.Peers))\n62|\tfor _, host := range config.sortedPeerHosts(reader) {\n63|\t\tpeers = append(peers, peerFingerprint{Alias: config.aliasFor(host), HostID: host})\n64|\t}\n65|\tallowlist := make([]string, 0, len(config.allowed))\n66|\tfor id := range config.allowed {\n67|\t\tallowlist = append(allowlist, id)\n68|\t}\n69|\tsort.Strings(allowlist)\n70|\treturn fingerprint(map[string]any{\n71|\t\t\"allowlist\":     allowlist,\n72|\t\t\"local_host_id\": config.localHost,\n73|\t\t\"peers\":         peers,\n74|\t\t\"transport\":     transportLabel,\n75|\t})\n76|}\n77|\n78|// indexRowFingerprint is one validated index row in the source index\n79|// digest: identity, liveness, lifecycle, tail, and winning lease facts\n80|// for every session the complete read returned, in bytewise session\n81|// order. Any index change — a new, removed, parked, tombstoned, or\n82|// advanced session — changes this digest.\n83|type indexRowFingerprint struct {\n84|\tSessionID     string `json:\"session_id\"`\n85|\tRecordID      string `json:\"record_id\"`\n86|\tName          string `json:\"name\"`\n87|\tParked        bool   `json:\"parked\"`\n88|\tState         string `json:\"state\"`\n89|\tTailEvent     string `json:\"tail_event\"`\n90|\tWinnerEpoch   uint64 `json:\"winner_epoch\"`\n91|\tWinnerLeaseID string `json:\"winner_lease_id\"`\n92|\tOwnerHostID   string `json:\"owner_host_id\"`\n93|}\n94|\n95|// fingerprintIndex digests the complete validated index read used for\n96|// selection: every row the listing returned with its validated tail.\n97|// A tail read failure keeps its read-failure class: local errors stay\n98|// repository errors, peer errors carry the read-failure class.\n99|func fingerprintIndex(reader *Reader, repo *sessrepo.Repository, rows []Summary, peerHost string) (string, error) {\n100|\tfinger := make([]indexRowFingerprint, 0, len(rows))\n101|\tfor _, row := range rows {\n102|\t\tentry := indexRowFingerprint{\n103|\t\t\tSessionID:     row.Projection.SessionID,\n104|\t\t\tRecordID:      row.Projection.RecordID,\n105|\t\t\tName:          row.Projection.Name,\n106|\t\t\tState:         string(row.Projection.State),\n107|\t\t\tWinnerEpoch:   row.Projection.Winner.Epoch,\n108|\t\t\tWinnerLeaseID: row.Projection.Winner.LeaseID,\n109|\t\t\tOwnerHostID:   row.Projection.OwnerHostID,\n110|\t\t}\n111|\t\tif row.Projection.Parked != nil {\n112|\t\t\tentry.Parked = true\n113|\t\t} else {\n114|\t\t\ttail, err := chainTail(repo, row.Projection.SessionID)\n115|\t\t\tif err != nil {\n116|\t\t\t\tif peerHost == \"\" {\n117|\t\t\t\t\treturn \"\", err\n118|\t\t\t\t}\n119|\t\t\t\treturn \"\", peerReadFailed(peerHost, err)\n120|\t\t\t}\n121|\t\t\tentry.TailEvent = tail\n122|\t\t}\n123|\t\tfinger = append(finger, entry)\n124|\t}\n125|\treturn fingerprint(finger)\n126|}\n127|\n128|// fingerprintExpectations binds caller-declared action expectations for\n129|// change detection only. Expectations must be one canonically encoded\n130|// JSON object; the digest never replaces the checkpoint, workspace,\n131|// cohort, provider, terminal, or confirmation contracts, which have no\n132|// owners in this leaf. Empty expectations bind the empty-object digest.\n133|func fingerprintExpectations(expectations []byte) (string, error) {\n134|\tif len(expectations) == 0 {\n135|\t\treturn fingerprint(map[string]any{})\n136|\t}\n137|\tcanonical, err := canonicaljson.Canonicalize(expectations)\n138|\tif err != nil {\n139|\t\treturn \"\", fmt.Errorf(\"%w: malformed plan expectations: %v\", ErrInvalidArgument, err)\n140|\t}\n141|\tif len(canonical) == 0 || canonical[0] != '{' {\n142|\t\treturn \"\", fmt.Errorf(\"%w: plan expectations must be a JSON object\", ErrInvalidArgument)\n143|\t}\n144|\tsum := sha256.Sum256(canonical)\n145|\tdigest := \"sha256:\" + hex.EncodeToString(sum[:])\n146|\tif _, err := scalar.ParseDigest(digest); err != nil {\n147|\t\treturn \"\", err\n148|\t}\n149|\treturn digest, nil\n150|}","final_result":true}}}
