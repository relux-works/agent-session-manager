{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d3","stream":{"kind":"session","id":"01a087bb-8c16-7c41-9df2-bf65e2d2e1e6"},"sequence":324,"recorded_at":1780531400000643,"record_type":"event","durability":"durable","causation_id":"a5a4bafa-7c8c-485e-ade1-b2a300d515d9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5a4bafa-7c8c-485e-ade1-b2a300d515d9","run_stream":{"kind":"run","id":"a5a4bafa-7c8c-485e-ade1-b2a300d515d9"},"task_stream":{"kind":"task","id":"01a087bc-34f9-74e1-bbbb-18977014240b"},"task_id":"01a087bc-34f9-74e1-bbbb-18977014240b","event":{"kind":"output","task_id":"01a087bc-34f9-74e1-bbbb-18977014240b","chunk":"Read text file `internal/sessquery/query.go`.\n(499 line(s) above)\n500|\t\t}\n501|\t\trows, err := reader.read(repo)\n502|\t\tif err != nil {\n503|\t\t\treturn nil, peerReadFailed(id, err)\n504|\t\t}\n505|\t\tout = append(out, liveCandidates(rows, repo, id)...)\n506|\t}\n507|\treturn out, nil\n508|}\n509|\n510|func matchName(items []candidate, selector string) (Selection, bool, error) {\n511|\t// A replicated session is one identity, regardless of how many peers learned\n512|\t// it. Distinct session IDs in the folded bucket are an ambiguity.\n513|\tids := make(map[string]struct{})\n514|\tvar exact *Selection\n515|\tfor _, item := range items {\n516|\t\tif asciiFold(item.summary.Projection.Name) != asciiFold(selector) {\n517|\t\t\tcontinue\n518|\t\t}\n519|\t\tids[item.selection.SessionID] = struct{}{}\n520|\t\tif item.summary.Projection.Name == selector && exact == nil {\n521|\t\t\tselection := item.selection\n522|\t\t\texact = &selection\n523|\t\t}\n524|\t}\n525|\tif len(ids) > 1 {\n526|\t\treturn Selection{}, false, fmt.Errorf(\"%w: name %q collides across %d sessions\", ErrAmbiguous, selector, len(ids))\n527|\t}\n528|\tif exact != nil {\n529|\t\treturn *exact, true, nil\n530|\t}\n531|\treturn Selection{}, false, nil\n532|}\n533|\n534|func asciiFold(value string) string {\n535|\tfolded := []byte(value)\n536|\tfor index, character := range folded {\n537|\t\tif character >= 'A' && character <= 'Z' {\n538|\t\t\tfolded[index] += 'a' - 'A'\n539|\t\t}\n540|\t}\n541|\treturn string(folded)\n542|}","final_result":true}}}
