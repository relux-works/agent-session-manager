{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d5","stream":{"kind":"session","id":"01a08902-6908-7901-ad83-4a5ad2f4cb7e"},"sequence":581,"recorded_at":1780531400001157,"record_type":"event","durability":"durable","causation_id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c","run_stream":{"kind":"run","id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c"},"task_stream":{"kind":"task","id":"01a08903-a01f-7022-9882-2a3b516b0cc4"},"task_id":"01a08903-a01f-7022-9882-2a3b516b0cc4","event":{"kind":"output","task_id":"01a08903-a01f-7022-9882-2a3b516b0cc4","chunk":"Read text file `internal/sessquery/query.go`.\n1|// Package sessquery is the single shared selector API over the session\n2|// repository and state projector: read-only selector resolution\n3|// (Section 14.7.1 literal grammar over Section 2.3 tiers), local\n4|// list/status summaries, and immutable SelectionPlan construction with\n5|// current-fact revalidation (Section 14.7.2). CLI and lifecycle callers\n6|// own invoking this API at every required boundary; no second resolver\n7|// exists. Unknown owner/lease facts and parked diagnostics stay explicit\n8|// in Projection: host display names, checkpoint timestamps/age,\n9|// workspace state, capabilities, process liveness and sync timestamps\n10|// require their respective observation owners and are never inferred\n11|// from a record or a successful read.\n12|package sessquery\n13|\n14|import (\n15|\t\"errors\"\n16|\t\"fmt\"\n17|\t\"sort\"\n18|\t\"strings\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n23|)\n24|\n25|var (\n26|\tErrUnavailable = errors.New(\"session index unavailable\")\n27|\tErrAmbiguous   = sessrepo.ErrNameAmbiguous\n28|\tErrNotFound    = sessrepo.ErrNameNotFound\n29|\t// ErrInvalidArgument refuses a malformed caller argument: selector\n30|\t// grammar violations (empty key, unknown source prefix, malformed\n31|\t// durable IDs, overlong argument), malformed plan members, unknown\n32|\t// action tags, and malformed destinations or expectations. Wire\n33|\t// exit binding for a CLI surface belongs to that surface's leaf;\n34|\t// this library keeps the refusal class distinct and stable.\n35|\tErrInvalidArgument = errors.New(\"invalid_arguments\")\n36|\t// ErrSourceNotFound reports that complete valid configuration has\n37|\t// no requested explicit source.\n38|\tErrSourceNotFound = errors.New(\"selector_source_not_found\")\n39|\t// ErrPeerNotAllowlisted reports an explicitly selected peer that\n40|\t// is configured but not allowlisted, including authorization\n41|\t// revoked after a plan was built.\n42|\tErrPeerNotAllowlisted = errors.New(\"peer_not_allowlisted\")\n43|\t// ErrSourceReadFailed reports a remote source transport/I-O read\n44|\t// failure with no fallback. The underlying cause stays attached\n45|\t// for errors.Is, so a repository-path failure remains visible as\n46|\t// such. A local source/store I-O failure keeps its repository\n47|\t// error, which the CLI Result 5 leaf maps to\n48|\t// local_precondition_failed; a partial or malformed index or\n49|\t// authority response is integrity failure, not absence.\n50|\tErrSourceReadFailed = errors.New(\"selector_source_read_failed\")\n51|\t// ErrInvalidConfig reports duplicate or malformed effective source\n52|\t// mappings: duplicate exact aliases or host IDs, a peer host that\n53|\t// collides with the local host, malformed host IDs, or aliases\n54|\t// outside the configured 1-64 printable-character bound.\n55|\tErrInvalidConfig = errors.New(\"invalid_config\")\n56|\t// ErrPlanStale reports bound selection facts that changed after a\n57|\t// plan was built; a fresh plan and confirmation are required. The\n58|\t// wrapped reason names the first diverged member in compare order.\n59|\tErrPlanStale = errors.New(\"selector_plan_stale\")\n60|\t// ErrBootstrapIncomplete reports a complete authority read proving\n61|\t// a Session Record without any valid lease: an interrupted\n62|\t// persistence prefix for the bootstrap-recovery leaf (Section\n63|\t// 14.7.4), never a public summary. A failed read keeps its\n64|\t// read-failure class instead; corrupt authority is integrity\n65|\t// failure. Wire exit binding for a CLI surface belongs to that\n66|\t// surface's leaf; this library keeps the refusal class distinct\n67|\t// and stable.\n68|\tErrBootstrapIncomplete = errors.New(\"selector_bootstrap_incomplete\")\n69|\t// ErrObservationUnavailable reports a required summary observation\n70|\t// or host metadata fact that cannot be established from validated\n71|\t// inputs. Nothing is inferred in its place: no source alias stands\n72|\t// in for host metadata, and no absent observation mints liveness,\n73|\t// capability, workspace, or timestamp facts.\n74|\tErrObservationUnavailable = errors.New(\"selector_observation_unavailable\")\n75|)\n76|\n77|// PeerIndex binds a peer identity to its already persisted learned index.\n78|// Transport/authentication and installing peer indexes are upstream owners;\n79|// this reader does not fetch, authenticate, or attest a caller-supplied index.\n80|type PeerIndex struct {\n81|\tHostID string\n82|\tRepo   *sessrepo.Repository\n83|}\n84|\n85|// Reader reads existing indexes. AllowlistedPeerIDs must come from the owning\n86|// configuration layer, separately from the learned indexes. An unlisted source\n87|// is never read. Failed reads from listed sources are errors, never\n88|// empty indexes that let resolution fall through to a lower-priority UUID.\n89|// LocalHostID comes from the local host identity owner; empty preserves unknown.\n90|//\n91|// Aliases carries the exact configured peer-alias mapping (host ID to\n92|// alias) from the same configuration owner, kept separate from the\n93|// learned index handles: a mapping without a handle contributes no\n94|// learned names, and a handle without a mapping stays reachable through\n95|// the bare union and the \"id:\" host form but never through \"peer:\".\n96|// Alias comparison is always exact, never folded, trimmed, or decoded.\n97|//\n98|// HostMetadata and Observations carry the validated host and observation\n99|// facts the authoritative summary layer requires, from their respective\n100|// owners. They are consulted only by that layer: List and Status keep\n101|// the internal read model and refuse only the unrepresentable\n102|// record-only bootstrap.\n103|//\n104|// LeaseRecords carries the validated winning-lease authority for plan\n105|// construction and revalidation, from the lease owner. Each entry is\n106|// canonical JSON for one urn:ax:schema:lease Lease Record; the reader\n107|// validates the closed shape and canonical self identity through the\n108|// canonicaljson owner, selects the greatest (epoch, lease_id) winner\n109|// per session, and binds that record digest with its tuple and holder.\n110|// Absence for a session refuses observation_unavailable; malformed\n111|// bytes refuse invalid_config. Envelope observations never substitute\n112|// for these records.\n113|//\n114|// CheckpointRecords carries the validated checkpoint authority the\n115|// winning-lease succession gate requires, from the checkpoint owner.\n116|// Each entry is canonical JSON for one urn:ax:schema:checkpoint\n117|// Checkpoint Record; the reader validates the closed shape and\n118|// canonical self identity through the sessrepo owner. Every successor\n119|// winner must reference an admitted record for its session and\n120|// predecessor lease; an unresolvable reference refuses\n(more lines below)","final_result":true}}}
