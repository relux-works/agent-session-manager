{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca1d","stream":{"kind":"session","id":"01a08902-6908-7901-ad83-4a5ad2f4cb7e"},"sequence":873,"recorded_at":1780531400001741,"record_type":"event","durability":"durable","causation_id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c","run_stream":{"kind":"run","id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c"},"task_stream":{"kind":"task","id":"01a08905-2b9c-7553-bc94-a2e222e05d8f"},"task_id":"01a08905-2b9c-7553-bc94-a2e222e05d8f","event":{"kind":"output","task_id":"01a08905-2b9c-7553-bc94-a2e222e05d8f","chunk":"edited\nchanged lines: lines 379-394\n--- original\n+++ updated\n@@\n-\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n-\tif !ok {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n-\t}\n-\tif checkpoint.SessionID != winner.SessionID {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n-\t}\n-\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n-\tif winner.Epoch > 1 {\n-\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n-\t}\n-\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n-\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n-\t}\n-\treturn nil\n-}\n+\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n+\tif !ok {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n+\t}\n+\tif checkpoint.SessionID != winner.SessionID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n+\t}\n+\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n+\tif winner.Epoch > 1 {\n+\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n+\t}\n+\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n+\t}\n+\towner := winner\n+\tif winner.Epoch > 1 {\n+\t\towner = predecessor\n+\t}\n+\tif checkpoint.CreatorHostID != owner.HolderHostID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n+\t}\n+\treturn nil\n+}\n+\n+// checkAncestorCheckpoints validates the checkpoint references of\n+// every non-winner lease in the winning ancestry: Section 5.3\n+// requires each epoch above 1 to reference a validated checkpoint\n+// for its session and predecessor lease, and Section 5.4 requires\n+// that checkpoint to be created by the owning lease holder. The\n+// winner itself is covered by checkWinnerCheckpoint. Only the\n+// winner's own ancestry is admitted: sibling branches off that\n+// chain are never consulted, so legal branching is preserved. An\n+// epoch-1 root without a reference stays admissible before the\n+// first provider boundary exists; a reference it does carry must\n+// resolve to a checkpoint bound to itself and created by its own\n+// holder. An unresolvable reference or a binding to another\n+// session, lease, or holder is incomplete authority\n+// (observation_unavailable), never absence or a minted fact.\n+func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease) error {\n+\tif len(chain) < 2 {\n+\t\treturn nil\n+\t}\n+\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tfor index := 1; index < len(chain); index++ {\n+\t\tcurrent := chain[index]\n+\t\tif current.Epoch == 1 {\n+\t\t\tif !current.HasCheckpoint {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif err := checkCheckpointBinding(current, current, checkpoints); err != nil {\n+\t\t\t\treturn err\n+\t\t\t}\n+\t\t\tcontinue\n+\t\t}\n+\t\tif !current.HasCheckpoint {\n+\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n+\t\t}\n+\t\tif index+1 >= len(chain) {\n+\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n+\t\t}\n+\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+// checkCheckpointBinding resolves one lease's checkpoint reference\n+// against the admitted Checkpoint Records and validates its Section\n+// 5.3 session and predecessor-lease binding with its Section 5.4\n+// holder binding: the checkpoint must name this session and the\n+// owning lease, and its creator must be that lease's holder.\n+func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint) error {\n+\tcheckpoint, ok := checkpoints[current.Checkpoint]\n+\tif !ok {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n+\t}\n+\tif checkpoint.SessionID != current.SessionID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n+\t}\n+\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n+\t}\n+\tif checkpoint.CreatorHostID != owner.HolderHostID {\n+\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
