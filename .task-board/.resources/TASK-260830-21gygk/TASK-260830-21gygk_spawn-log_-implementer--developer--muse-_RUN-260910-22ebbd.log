{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bf","stream":{"kind":"session","id":"01a08902-6908-7901-ad83-4a5ad2f4cb7e"},"sequence":314,"recorded_at":1780531400000623,"record_type":"event","durability":"durable","causation_id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c","run_stream":{"kind":"run","id":"c06b7799-3d10-4fbc-bddd-7d86f5813b0c"},"task_stream":{"kind":"task","id":"01a08902-fd26-7112-8801-81b6b07e0544"},"task_id":"01a08902-fd26-7112-8801-81b6b07e0544","event":{"kind":"output","task_id":"01a08902-fd26-7112-8801-81b6b07e0544","chunk":"Read text file `internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is one admitted Checkpoint Record: its canonical\n48|// digest with the session and lease it was taken under. Section 5.4\n49|// binds lease_epoch/lease_id to the referenced winning lease, so a\n50|// successor's checkpoint names its predecessor lease.\n51|type validatedCheckpoint struct {\n52|\tDigest     string\n53|\tSessionID  string\n54|\tLeaseEpoch uint64\n55|\tLeaseID    string\n56|\tRaw        []byte\n57|}\n58|\n59|// parseLeaseRecord validates one canonical Lease Record through the\n60|// canonicaljson owner and extracts the bound members. Closed-shape and\n61|// identity failures refuse invalid_config; the caller maps absence to\n62|// observation_unavailable.\n63|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n64|\tvar lease validatedLease\n65|\tmembers, fault := environ.DecodeStrictObject(raw)\n66|\tif fault != nil {\n67|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n68|\t}\n69|\tschema, err := leaseStringMember(members, \"schema\")\n70|\tif err != nil || schema != leaseRecordSchema {\n71|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n72|\t}\n73|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n74|\tif err != nil {\n75|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n76|\t}\n77|\tif field != canonicaljson.SelfRecordID {\n78|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n79|\t}\n80|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n81|\tif !ok {\n82|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n83|\t}\n84|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n85|\tif err != nil {\n86|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n87|\t}\n88|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n89|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n90|\t}\n91|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n92|\tif !ok {\n93|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n94|\t}\n95|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n96|\tif !ok {\n97|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n98|\t}\n99|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n100|\tif err != nil {\n101|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n102|\t}\n103|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n104|\tif err != nil {\n105|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n106|\t}\n107|\tlease = validatedLease{\n108|\t\tDigest:         digest.String(),\n109|\t\tSessionID:      sessionID.String(),\n110|\t\tLeaseID:        leaseID,\n111|\t\tEpoch:          epoch,\n112|\t\tHolderHostID:   holder.String(),\n113|\t\tPredecessor:    predecessor,\n114|\t\tHasPredecessor: hasPredecessor,\n115|\t\tCheckpoint:     checkpoint,\n116|\t\tHasCheckpoint:  hasCheckpoint,\n117|\t\tRaw:            append([]byte(nil), raw...),\n118|\t}\n119|\treturn lease, nil\n120|}\n121|\n122|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n123|\treturn members[name]\n124|}\n125|\n126|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n127|\traw, ok := members[name]\n128|\tif !ok {\n129|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n130|\t}\n131|\tvar value string\n132|\tif err := json.Unmarshal(raw, &value); err != nil {\n133|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n134|\t}\n135|\treturn value, nil\n136|}\n137|\n138|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n139|\traw, ok := members[name]\n140|\tif !ok {\n141|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n142|\t}\n143|\tif string(raw) == \"null\" {\n144|\t\treturn \"\", false, nil\n145|\t}\n146|\tvar value string\n147|\tif err := json.Unmarshal(raw, &value); err != nil {\n148|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n149|\t}\n150|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n151|\t\treturn \"\", false, err\n152|\t}\n153|\treturn value, true, nil\n154|}\n155|\n156|// leaseNullableDigest reads a nullable digest member: null binds\n157|// absence, a string must parse as a canonical digest.\n158|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n159|\traw, ok := members[name]\n160|\tif !ok {\n161|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n162|\t}\n163|\tif string(raw) == \"null\" {\n164|\t\treturn \"\", false, nil\n165|\t}\n166|\tvar value string\n167|\tif err := json.Unmarshal(raw, &value); err != nil {\n168|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n169|\t}\n170|\tdigest, err := scalar.ParseDigest(value)\n171|\tif err != nil {\n172|\t\treturn \"\", false, err\n173|\t}\n174|\treturn digest.String(), true, nil\n175|}\n176|\n177|// parseCheckpointRecord validates one canonical Checkpoint Record\n178|// through the sessrepo owner (closed shape plus canonical self\n179|// identity) and extracts the bound members. Closed-shape and\n180|// identity failures refuse invalid_config; the caller maps an\n181|// unresolvable reference to observation_unavailable.\n182|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n183|\tvar checkpoint validatedCheckpoint\n184|\tmembers, fault := environ.DecodeStrictObject(raw)\n185|\tif fault != nil {\n186|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n187|\t}\n188|\tschema, err := leaseStringMember(members, \"schema\")\n189|\tif err != nil || schema != checkpointRecordSchema {\n190|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n191|\t}\n192|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n193|\tif err != nil {\n194|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n195|\t}\n196|\tif field != canonicaljson.SelfCheckpointID {\n197|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n198|\t}\n199|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n200|\tif !ok {\n201|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n202|\t}\n203|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n204|\tif !ok {\n205|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n206|\t}\n207|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n208|\tif err != nil {\n209|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n210|\t}\n211|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n212|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n213|\t}\n214|\tcheckpoint = validatedCheckpoint{\n215|\t\tDigest:     digest.String(),\n216|\t\tSessionID:  sessionID.String(),\n217|\t\tLeaseEpoch: epoch,\n218|\t\tLeaseID:    leaseID,\n219|\t\tRaw:        append([]byte(nil), raw...),\n220|\t}\n221|\treturn checkpoint, nil\n222|}\n223|\n224|// validatedLeasesBySession validates every supplied Lease Record and\n225|// groups the admitted records by session UUID.\n226|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n227|\tout := map[string][]validatedLease{}\n228|\tif reader == nil {\n229|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n230|\t}\n231|\tfor _, raw := range reader.LeaseRecords {\n232|\t\tlease, err := parseLeaseRecord(raw)\n233|\t\tif err != nil {\n234|\t\t\treturn nil, err\n235|\t\t}\n236|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n237|\t}\n238|\treturn out, nil\n239|}\n240|\n241|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n242|// Record for one session and validates its succession: the\n243|// predecessor ancestry must chain by epoch plus one down to an\n244|// epoch-1 root, and the winner must reference a validated checkpoint\n245|// for its session and predecessor lease. Absence refuses\n246|// observation_unavailable; a winner above epoch 1 without its named\n247|// predecessor in the admitted set refuses the same class rather\n248|// than binding a dangling successor, while an illegal predecessor\n249|// link is malformed authority (integrity failure).\n250|func (reader *Reader) winningLeaseFor(sessionID string) (validatedLease, error) {\n251|\tbySession, err := reader.validatedLeasesBySession()\n252|\tif err != nil {\n253|\t\treturn validatedLease{}, err\n254|\t}\n255|\tcandidates := bySession[sessionID]\n256|\tif len(candidates) == 0 {\n257|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n258|\t}\n259|\twinner := candidates[0]\n260|\tfor _, candidate := range candidates[1:] {\n261|\t\tif sessstate.Compare(\n262|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n263|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n264|\t\t) > 0 {\n265|\t\t\twinner = candidate\n266|\t\t}\n267|\t}\n268|\tpredecessor, err := checkLeaseChain(candidates, winner)\n269|\tif err != nil {\n270|\t\treturn validatedLease{}, err\n271|\t}\n272|\tif err := reader.checkWinnerCheckpoint(winner, predecessor); err != nil {\n273|\t\treturn validatedLease{}, err\n274|\t}\n275|\treturn winner, nil\n276|}\n277|\n278|// checkLeaseChain validates the winner's predecessor ancestry within\n279|// the admitted records for its session. Section 5.3 requires every\n280|// epoch above 1 to name a known predecessor for the same session\n281|// with an epoch exactly one below, down to an epoch-1 root with a\n282|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n283|// lease naming any predecessor is malformed. A self, cyclic,\n284|// skipped, contradictory, or duplicated link is malformed authority\n285|// (integrity failure); a missing predecessor name or record is\n286|// incomplete authority (observation_unavailable). Epochs strictly\n287|// decrease along the walk, so the walk always terminates. It\n288|// returns the winner's direct predecessor, or the zero lease at\n289|// epoch 1.\n290|func checkLeaseChain(candidates []validatedLease, winner validatedLease) (validatedLease, error) {\n291|\tbyLease := make(map[string]validatedLease, len(candidates))\n292|\tfor _, candidate := range candidates {\n293|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n294|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n295|\t\t}\n296|\t\tbyLease[candidate.LeaseID] = candidate\n297|\t}\n298|\tvar predecessor validatedLease\n299|\tcurrent := winner\n300|\tfor {\n301|\t\tif current.Epoch == 1 {\n302|\t\t\tif current.HasPredecessor {\n303|\t\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n304|\t\t\t}\n305|\t\t\treturn predecessor, nil\n306|\t\t}\n307|\t\tif !current.HasPredecessor {\n308|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n309|\t\t}\n310|\t\tparent, ok := byLease[current.Predecessor]\n311|\t\tif !ok {\n312|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n313|\t\t}\n314|\t\tif parent.Epoch+1 != current.Epoch {\n315|\t\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n316|\t\t}\n317|\t\tif current.LeaseID == winner.LeaseID {\n318|\t\t\tpredecessor = parent\n319|\t\t}\n320|\t\tcurrent = parent\n321|\t}\n322|}\n323|\n324|// validatedCheckpointsByDigest validates every supplied Checkpoint\n325|// Record and indexes the admitted records by canonical digest.\n326|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n327|\tout := map[string]validatedCheckpoint{}\n328|\tif reader == nil {\n329|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n330|\t}\n331|\tfor _, raw := range reader.CheckpointRecords {\n332|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n333|\t\tif err != nil {\n334|\t\t\treturn nil, err\n335|\t\t}\n336|\t\tout[checkpoint.Digest] = checkpoint\n337|\t}\n338|\treturn out, nil\n339|}\n340|\n341|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n342|// against the admitted Checkpoint Records. Section 5.3 requires\n343|// every epoch above 1 to reference a validated checkpoint for its\n344|// session and predecessor lease; an epoch-1 root without a\n345|// predecessor may carry no checkpoint before the first provider\n346|// boundary exists. A non-null reference must resolve to an admitted\n347|// record for the same session bound to the lease it was taken\n348|// under: the predecessor for a successor, the winner itself at\n349|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n350|// unresolvable reference is incomplete authority\n351|// (observation_unavailable), never absence or a minted fact.\n352|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease) error {\n353|\tif !winner.HasCheckpoint {\n354|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n355|\t\t\treturn nil\n356|\t\t}\n357|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n358|\t}\n359|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n360|\tif err != nil {\n361|\t\treturn err\n362|\t}\n363|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n364|\tif !ok {\n365|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n366|\t}\n367|\tif checkpoint.SessionID != winner.SessionID {\n368|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n369|\t}\n370|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n371|\tif winner.Epoch > 1 {\n372|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n373|\t}\n374|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n375|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n376|\t}\n377|\treturn nil\n378|}\n379|\n380|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n381|// greatest epoch wins, ties break by bytewise lease-ID order.\n382|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n383|\treturn sessstate.Compare(\n384|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n385|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n386|\t)\n387|}","final_result":true}}}
