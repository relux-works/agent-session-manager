{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca41","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":891,"recorded_at":1780531400001777,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"task_stream":{"kind":"task","id":"01a0894e-3922-74b1-ba42-0da14c0e42f3"},"task_id":"01a0894e-3922-74b1-ba42-0da14c0e42f3","event":{"kind":"output","task_id":"01a0894e-3922-74b1-ba42-0da14c0e42f3","chunk":"{\n  \"chunk_id\": \"exec-25-1\",\n  \"command\": \"sed -n '195,300p' internal/canonicaljson/closed_shapes.go; echo =====; sed -n '795,860p' internal/canonicaljson/core_records.go\",\n  \"description\": \"Read session record profile shape rules\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t}\\n\\n\\tvalidator, ok := immutableObjectShapeValidators[schemaIdentityKey{schema: schema, version: version}]\\n\\tif !ok || validator == nil {\\n\\t\\treturn invalidIdentity(\\\"no immutable-object shape validator for %s@%s\\\", schema, version)\\n\\t}\\n\\treturn validator(object)\\n}\\n\\nfunc validateSessionRecordV1(object map[string]any) error {\\n\\tif err := requireExactMembers(\\\"Session Record 1.0.0\\\", object,\\n\\t\\t\\\"schema\\\", \\\"schema_version\\\", \\\"record_id\\\", \\\"subject_id\\\", \\\"session_id\\\", \\\"name\\\", \\\"kind\\\",\\n\\t\\t\\\"created_at\\\", \\\"created_by_host_id\\\", \\\"provider_id\\\", \\\"workspace_group_id\\\", \\\"execution_profile\\\",\\n\\t\\t\\\"launch_plan\\\", \\\"task_board\\\", \\\"fork_provenance\\\", \\\"extensions\\\"); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tsessionID, _, _, err := validateSessionRecordCommon(object, \\\"1.0.0\\\")\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\t