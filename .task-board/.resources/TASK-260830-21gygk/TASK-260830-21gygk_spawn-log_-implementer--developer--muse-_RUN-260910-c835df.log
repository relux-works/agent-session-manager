26-08-19T04:00:00.000Z\",\n27|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n28|  \"provider_id\": \"codex\",\n29|  \"workspace_group_id\": \"0198f4c8-5b20-7c33-8c4d-1234567890ab\",\n30|  \"execution_profile\": \"yolo\",\n31|  \"launch_plan\": {\n32|    \"argv\": [\"codex\"],\n33|    \"cwd_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n34|    \"cwd_relative\": \"src\",\n35|    \"env_names\": [\"OPENAI_API_KEY\"],\n36|    \"env_literals\": {},\n37|    \"contains_secrets\": false,\n38|    \"extensions\": {}\n39|  },\n40|  \"task_board\": null,\n41|  \"fork_provenance\": null,\n42|  \"extensions\": {}\n43|}`\n44|\n45|func identity(t *testing.T, value map[string]any, field string) []byte {\n46|\tt.Helper()\n47|\tvalue[field] = zeroDigest\n48|\traw, err := json.Marshal(value)\n49|\tif err != nil {\n50|\t\tt.Fatal(err)\n51|\t}\n52|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(raw)\n53|\tif err != nil {\n54|\t\tt.Fatal(err)\n55|\t}\n56|\tvalue[field] = digest.String()\n57|\traw, err = json.Marshal(value)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\treturn raw\n62|}\n63|func record(t *testing.T, id, name string) []byte {\n64|\tt.Helper()\n65|\tvar value map[string]any\n66|\tif err := json.Unmarshal([]byte(specRecordExample), &value); err != nil {\n67|\t\tt.Fatal(err)\n68|\t}\n69|\tvalue[\"session_id\"], value[\"subject_id\"], value[\"name\"] = id, id, name\n70|\treturn identity(t, value, \"record_id\")\n71|}\n72|func repository(t *testing.T) (*sessrepo.Repository, string) {\n73|\tt.Helper()\n74|\troot := t.TempDir()\n75|\trepo, err := sessrepo.Open(root)\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\treturn repo, root\n80|}\n81|func create(t *testing.T, repo *sessrepo.Repository, id, name string) sessrepo.SessionRef {\n82|\tt.Helper()\n83|\tref, err := repo.CreateSession(record(t, id, name))\n84|\tif err != nil {\n85|\t\tt.Fatal(err)\n86|\t}\n87|\treturn ref\n88|}\n89|func appendEvent(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, payload map[string]any) string {\n90|\tt.Helper()\n91|\tvalue := map[string]any{\n92|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n93|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n94|\t\t\"lease_epoch\": 1, \"lease_id\": lease, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n95|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n96|\t}\n97|\tref, err := repo.AppendEvent(id, identity(t, value, \"event_id\"))\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\treturn ref.EventID\n102|}\n103|\n104|// leaseRecordBytes builds one validated Lease Record for tests: an\n105|// epoch-1 create lease uses a null predecessor and null checkpoint,\n106|// while a successor names its predecessor and a checkpoint. The holder\n107|// is the winning owner; issued_by and created_by equal the holder.\n108|func leaseRecordBytes(t *testing.T, sessionID string, epoch uint64, leaseID, holder, predecessor string, hasPredecessor bool) []byte {\n109|\tt.Helper()\n110|\tvar predecessorValue any\n111|\tif hasPredecessor {\n112|\t\tpredecessorValue = predecessor\n113|\t}\n114|\tvar checkpointValue any\n115|\tvar reason string\n116|\tif epoch == 1 && !hasPredecessor {\n117|\t\treason = \"create\"\n118|\t} else {\n119|\t\treason = \"graceful_takeover\"\n120|\t\tcheckpointValue = zeroDigest\n121|\t}\n122|\tvalue := map[string]any{\n123|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n124|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"lease_id\": leaseID, \"epoch\": json.Number(uint64String(epoch)),\n125|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": predecessorValue, \"reason\": reason,\n126|\t\t\"checkpoint_id\": checkpointValue, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n127|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n128|\t}\n129|\treturn identity(t, value, \"record_id\")\n130|}\n131|\n132|func uint64String(value uint64) string {\n133|\treturn json.Number(fmtSprintUint64(value)).String()\n134|}\n135|\n136|func fmtSprintUint64(value uint64) string {\n137|\tif value == 0 {\n138|\t\treturn \"0\"\n139|\t}\n140|\tvar digits []byte\n141|\tfor value > 0 {\n142|\t\tdigits = append([]byte{byte('0' + value%10)}, digits...)\n143|\t\tvalue /= 10\n144|\t}\n145|\treturn string(digits)\n146|}\n147|\n148|// leaseCreate returns an epoch-1 create Lease Record for the standard\n149|// test lease and holder.\n150|func leaseCreate(t *testing.T, sessionID, holder string) []byte {\n151|\tt.Helper()\n152|\treturn leaseRecordBytes(t, sessionID, 1, lease, holder, \"\", false)\n153|}\n154|\n155|// checkpointRecordBytes builds one validated Checkpoint Record bound\n156|// to (sessionID, epoch, leaseID): the checkpoint a successor lease\n157|// references for its session and predecessor lease. The record is\n158|// identified through the canonicaljson owner before return, so a\n159|// fixture failure surfaces here, never as a production admission.\n160|func checkpointRecordBytes(t *testing.T, sessionID string, epoch uint64, leaseID, creator string) []byte {\n161|\tt.Helper()\n162|\tvalue := map[string]any{\n163|\t\t\"schema\": \"urn:ax:schema:checkpoint\", \"schema_version\": \"1.0.0\", \"checkpoint_id\": zeroDigest,\n164|\t\t\"subject_id\": sessionID, \"session_id\": sessionID,\n165|\t\t\"lease_epoch\": json.Number(uint64String(epoch)), \"lease_id\": leaseID,\n166|\t\t\"safe_boundary\": map[string]any{\n167|\t\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"evidence\": \"accepted_test\",\n168|\t\t\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true,\n169|\t\t\t\"open_processes\": json.Number(\"0\"), \"open_database_handles\": json.Number(\"0\"),\n170|\t\t},\n171|\t\t\"event_heads\":           []string{zeroDigest},\n172|\t\t\"workspace_manifest_id\": zeroDigest,\n173|\t\t\"provider_manifest_id\":  zeroDigest,\n174|\t\t\"task_board_bundle_id\":  nil,\n175|\t\t\"created_by_host_id\":    creator,\n176|\t\t\"created_at\":            \"2026-08-19T04:09:30.000Z\",\n177|\t\t\"status\":                \"validated\",\n178|\t\t\"extensions\":            map[string]any{},\n179|\t}\n180|\treturn identity(t, value, \"checkpoint_id\")\n181|}\n182|\n183|// checkpointDigestOf returns the canonical digest of one validated\n184|// Checkpoint Record without attaching it: successor leases name this\n185|// digest in checkpoint_id.\n186|func checkpointDigestOf(t *testing.T, checkpoint []byte) string {\n187|\tt.Helper()\n188|\tvar value map[string]any\n189|\tif err := json.Unmarshal(checkpoint, &value); err != nil {\n190|\t\tt.Fatal(err)\n191|\t}\n192|\tdigest, ok := value[\"checkpoint_id\"].(string)\n193|\tif !ok || digest == \"\" || digest == zeroDigest {\n194|\t\tt.Fatalf(\"checkpoint fixture carries no identified digest: %v\", value[\"checkpoint_id\"])\n195|\t}\n196|\treturn digest\n197|}\n198|\n199|// leaseSuccessorBytes builds one validated epoch>1 Lease Record\n200|// naming its predecessor lease and the digest of the validated\n201|// Checkpoint Record taken under that predecessor.\n202|func leaseSuccessorBytes(t *testing.T, sessionID string, epoch uint64, leaseID, holder, predecessor, checkpoint string) []byte {\n203|\tt.Helper()\n204|\tvalue := map[string]any{\n205|\t\t\"schema\": \"urn:ax:schema:lease\", \"schema_version\": \"1.0.0\", \"record_id\": zeroDigest,\n206|\t\t\"subject_id\": sessionID, \"session_id\": sessionID, \"lease_id\": leaseID, \"epoch\": json.Number(uint64String(epoch)),\n207|\t\t\"holder_host_id\": holder, \"predecessor_lease_id\": predecessor, \"reason\": \"graceful_takeover\",\n208|\t\t\"checkpoint_id\": checkpoint, \"issued_by_host_id\": holder, \"created_by_host_id\": holder,\n209|\t\t\"created_at\": \"2026-08-19T04:09:00.000Z\", \"extensions\": map[string]any{},\n210|\t}\n211|\treturn identity(t, value, \"record_id\")\n212|}\n213|\n214|// withSuccessor attaches a complete validated succession for one\n215|// session: the epoch-1 create record, the epoch-2 successor naming\n216|// it, and the Checkpoint Record taken under the predecessor that the\n217|// successor references. The checkpoint names the latest real epoch-1\n218|// head from the reader chain so the head-authority gate admits it.\n219|// It returns the successor Lease Record digest for plan assertions.\n220|func withSuccessor(t *testing.T, reader *Reader, sessionID, holder, successorLeaseID string) string {\n221|\tt.Helper()\n222|\tcheckpoint := checkpointWithHeads(t, checkpointRecordBytes(t, sessionID, 1, lease, holder), headAtOrBefore(t, reader, sessionID, 1))\n223|\tdigest := checkpointDigestOf(t, checkpoint)\n224|\twithCheckpoints(reader, checkpoint)\n225|\twithLeases(reader,\n226|\t\tleaseCreate(t, sessionID, holder),\n227|\t\tleaseSuccessorBytes(t, sessionID, 2, successorLeaseID, holder, lease, digest),\n228|\t)\n229|\treturn digest\n230|}\n231|\n232|// withCheckpoints attaches validated Checkpoint Records to a reader.\n233|func withCheckpoints(reader *Reader, checkpoints ...[]byte) *Reader {\n234|\treader.CheckpointRecords = append(append([][]byte(nil), reader.CheckpointRecords...), checkpoints...)\n235|\treturn reader\n236|}\n237|\n238|// withLeases attaches validated Lease Records to a reader.\n239|func withLeases(reader *Reader, leases ...[]byte) *Reader {\n240|\treader.LeaseRecords = append(append([][]byte(nil), reader.LeaseRecords...), leases...)\n241|\treturn reader\n242|}\n243|\n244|// checkpointWithHeads rebinds one validated Checkpoint Record to the\n245|// given event heads and re-identifies it through the canonicaljson\n246|// owner. Section 5.4 requires every required checkpoint to resolve\n247|// each head to a chained event at or before its bound lease, so\n248|// valid fixtures must name a real head from their session chain,\n249|// never the zero placeholder.\n250|func checkpointWithHeads(t *testing.T, base []byte, heads ...string) []byte {\n251|\tt.Helper()\n252|\tvar value map[string]any\n253|\tif err := json.Unmarshal(base, &value); err != nil {\n254|\t\tt.Fatal(err)\n255|\t}\n256|\tvalue[\"event_heads\"] = heads\n257|\treturn identity(t, value, \"checkpoint_id\")\n258|}\n259|\n260|// headAtOrBefore returns the latest chained event for one session at\n261|// or before the given lease epoch: the valid historical head a\n262|// checkpoint bound to that epoch may name. It prefers the newest\n263|// such event, so an epoch-1 checkpoint names the latest epoch-1\n264|// event (never a later-lease tail), while a successor-epoch\n265|// checkpoint may name its own-lease transfer event.\n266|func headAtOrBefore(t *testing.T, reader *Reader, sessionID string, epoch uint64) string {\n267|\tt.Helper()\n268|\tevents, err := reader.Local.ListEvents(sessionID)\n269|\tif err != nil {\n270|\t\tt.Fatal(err)\n271|\t}\n272|\tbest := \"\"\n273|\tfor _, summary := range events {\n274|\t\tif summary.LeaseEpoch <= epoch {\n275|\t\t\tbest = summary.EventID\n276|\t\t}\n277|\t}\n278|\tif best == \"\" {\n279|\t\tt.Fatalf(\"no chained event at or before epoch %d for session %s\", epoch, sessionID)\n280|\t}\n281|\treturn best\n282|}","final_result":true}}}
