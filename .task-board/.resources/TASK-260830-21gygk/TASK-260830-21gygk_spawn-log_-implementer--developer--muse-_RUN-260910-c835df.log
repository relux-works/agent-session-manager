{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e5","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":205,"recorded_at":1780531400000405,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"task_stream":{"kind":"task","id":"01a0894a-6928-7dc0-840a-ee53b44c5777"},"task_id":"01a0894a-6928-7dc0-840a-ee53b44c5777","event":{"kind":"output","task_id":"01a0894a-6928-7dc0-840a-ee53b44c5777","chunk":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"task-board --help 2>&1 | head -n 60; echo ===; task-board m 'schema()' 2>&1 | head -c 3000\",\n  \"description\": \"Inspect task-board CLI usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n===\\n{\\\"defaultFields\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\"],\\\"fields\\\":[\\\"id\\\",\\\"type\\\",\\\"name\\\",\\\"title\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"review\\\",\\\"task_class\\\",\\\"estimate\\\",\\\"observability\\\",\\\"parent\\\",\\\"assignee\\\",\\\"description\\\",\\\"scope\\\",\\\"ac\\\",\\\"blockedBy\\\",\\\"blocks\\\",\\\"derivedBlockedBy\\\",\\\"derivedBlocks\\\",\\\"checklist\\\",\\\"notes\\\",\\\"created\\\",\\\"updated\\\",\\\"isBlocked\\\",\\\"isAdvisoryBlocked\\\",\\\"children\\\",\\\"preconditionResources\\\",\\\"outcomeResources\\\",\\\"identity\\\",\\\"binding\\\",\\\"lineage\\\",\\\"lifecycle\\\",\\\"freshness\\\",\\\"actualization\\\",\\\"security\\\",\\\"payload\\\"],\\\"grammar\\\":{\\\"statement\\\":\\\"OPERATION(ARGUMENTS) { PROJECTION }; the projection block is optional\\\",\\\"batch\\\":\\\"STATEMENT; STATEMENT — statements separated by ';', results keep source order\\\",\\\"arguments\\\":\\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\\"values\\\":\\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\\"escapes\\\":[\\\"\\\\\\\\\\\\\\\"\\\",\\\"\\\\\\\\\\\\\\\\\\\",\\\"\\\\\\\\n\\\",\\\"\\\\\\\\t\\\"],\\\"projection\\\":\\\"field projection: { field preset ... } — space-separated field names and preset names inside braces; omitted means the default fields\\\",\\\"tokens\\\":[\\\"identifier\\\",\\\"string\\\",\\\"'('\\\",\\\"')'\\\",\\\"'{'\\\",\\\"'}'\\\",\\\"'='\\\",\\\"','\\\",\\\"';'\\\",\\\"end of input\\\"],\\\"examples\\\":[\\\"op()\\\",\\\"op(key=value)\\\",\\\"op(key=value, other=42, flag=true)\\\",\\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\\"op(positional)\\\",\\\"op() { field preset }\\\",\\\"op(key=value) { field }; other()\\\"]},\\\"mutationMetadata\\\":{\\\"accept_cr\\\":{\\\"description\\\":\\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being accepted (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"evidence\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Task-scoped outcome resource name carrying the verdict evidence\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"accept_cr(TASK-260803-323q82, revision=2, evidence=TASK-260803-323q82_review-verdict-rev2.md)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_checklist_item\\\":{\\\"description\\\":\\\"Add a new checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"text\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item text\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"add_checklist_item(TASK-260218-abc123, text=\\\\\\\"Write unit tests\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_resource\\\":{\\\"description\\\":\\\"Add a text resource to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",