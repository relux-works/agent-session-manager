(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n+\t\t\treturn r\n+\t\t},\n+\t\t\"dangling_predecessor\": func(t *testing.T) *Reader {\n","edit_facts":{"tool_name":"edit_file","path":"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/rev8_regression_test.go","added":19,"removed":1},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
