{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c97f","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":794,"recorded_at":1780531400001583,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"task_stream":{"kind":"task","id":"01a0894d-7c5a-72e1-aba3-44ec4d4d97eb"},"task_id":"01a0894d-7c5a-72e1-aba3-44ec4d4d97eb","event":{"kind":"output","task_id":"01a0894d-7c5a-72e1-aba3-44ec4d4d97eb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/rev6_regression_test.go`.\n(94 line(s) above)\n95|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admits wrong persistence variant in winner checkpoint\")\n96|\t\t\t\t\t\t}\n97|\t\t\t\t\t}\n98|\t\t\t\t}\n99|\t\t\t\trev5CheckEntries(t, r, wrong)\n100|\t\t\t})\n101|\t\t}\n102|\t}\n103|}\n104|\n105|// taskBoardRecordBytes builds one validated task_board Session Record\n106|// for tests, following the SPEC 5.1 task_board example with a\n107|// tracked_prompt reference and no board goal.\n108|func taskBoardRecordBytes(t *testing.T, id, name string) []byte {\n109|\tt.Helper()\n110|\tvar value map[string]any\n111|\tif err := json.Unmarshal([]byte(specRecordExample), &value); err != nil {\n112|\t\tt.Fatal(err)\n113|\t}\n114|\tvalue[\"session_id\"], value[\"subject_id\"], value[\"name\"] = id, id, name\n115|\tvalue[\"kind\"] = \"task_board\"\n116|\tvalue[\"task_board\"] = map[string]any{\n117|\t\t\"bridge_protocol_version\": \"1.0.0\",\n118|\t\t\"board\": map[string]any{\n119|\t\t\t\"kind\": \"local\", \"logical_id\": \"agent-session-manager-spec\",\n120|\t\t\t\"remote_url\": nil, \"extensions\": map[string]any{},\n121|\t\t},\n122|\t\t\"task_element_id\": \"TASK-260819-example\", \"launch_mode\": \"tracked_prompt\",\n123|\t\t\"manager_session_ref\": nil, \"board_goal\": nil,\n124|\t\t\"native_goal_binding\": \"prompt\", \"extensions\": map[string]any{},\n125|\t}\n126|\treturn identity(t, value, \"record_id\")\n127|}\n128|\n129|// taskBoardCheckpointBytes builds one validated Checkpoint Record\n130|// carrying the task_board persistence variant: null provider manifest\n131|// with a non-null task-board bundle.\n132|func taskBoardCheckpointBytes(t *testing.T, sessionID string, epoch uint64, leaseID, creator string) []byte {\n133|\tt.Helper()\n134|\tvalue := map[string]any{\n135|\t\t\"schema\": \"urn:ax:schema:checkpoint\", \"schema_version\": \"1.0.0\", \"checkpoint_id\": zeroDigest,\n136|\t\t\"subject_id\": sessionID, \"session_id\": sessionID,\n137|\t\t\"lease_epoch\": json.Number(uint64String(epoch)), \"lease_id\": leaseID,\n138|\t\t\"safe_boundary\": map[string]any{\n139|\t\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"evidence\": \"accepted_test\",\n140|\t\t\t\"input_blocked\": true, \"foreground_idle\": true, \"background_idle\": true,\n141|\t\t\t\"open_processes\": json.Number(\"0\"), \"open_database_handles\": json.Number(\"0\"),\n142|\t\t},\n143|\t\t\"event_heads\":           []string{zeroDigest},\n144|\t\t\"workspace_manifest_id\": zeroDigest,\n145|\t\t\"provider_manifest_id\":  nil,\n146|\t\t\"task_board_bundle_id\":  zeroDigest,\n147|\t\t\"created_by_host_id\":    creator,\n148|\t\t\"created_at\":            \"2026-08-19T04:09:30.000Z\",\n149|\t\t\"status\":                \"validated\",\n150|\t\t\"extensions\":            map[string]any{},\n151|\t}\n152|\treturn identity(t, value, \"checkpoint_id\")\n153|}\n154|\n155|// taskBoardSuccessorFixture builds a task_board session with the\n156|// epoch-1 to epoch-2 transfer chain and a task_board-variant\n157|// checkpoint bound to the predecessor lease. The caller supplies no\n158|// variant: the only admissible checkpoint is the task_board one