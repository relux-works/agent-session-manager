{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83b","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":632,"recorded_at":1780531400001259,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"call_id":"call_01a0894b4e1b7340b930ba15b0042617","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/rev7_regression_test.go`.\n1|// Checkpoint event-head authority regression tests for\n2|// TASK-260830-21gygk (SPEC 5.4, CR7 P1): every required checkpoint\n3|// in the winning ancestry must resolve each event head to a chained\n4|// event for its session at or before its bound lease in the winning\n5|// source chain. A head naming an absent event or an event under a\n6|// later lease cannot establish current complete authority. Every\n7|// case drives the four shared production entries (BuildPlan,\n8|// Revalidate fresh and old-plan, AuthoritativeStatus,\n9|// AuthoritativeList), never the validators directly. Ported from the\n10|// CR7 independent reviewer regression and retained as the candidate\n11|// positive/negative control for the shared admission path.\n12|package sessquery\n13|\n14|import (\n15|\t\"encoding/json\"\n16|\t\"testing\"\n17|)\n18|\n19|func rev7Replace(t *testing.T, raw []byte, self string, values map[string]any) []byte {\n20|\tt.Helper()\n21|\tvar v map[string]any\n22|\tif err := json.Unmarshal(raw, &v); err != nil {\n23|\t\tt.Fatal(err)\n24|\t}\n25|\tfor k, value := range values {\n26|\t\tv[k] = value\n27|\t}\n28|\treturn identity(t, v, self)\n29|}\n30|\n31|// Complete local event histories give the checkpoint a real idle head under\n32|// its owning predecessor, rather than the shipped fixture's zero digest.\n33|// Manifest publication/storage is the accepted external fixture boundary.\n34|func rev7Fixture(t *testing.T, kind string, ancestor bool) (*Reader, string) {\n35|\tt.Helper()\n36|\tlocal, _ := repository(t)\n37|\traw := record(t, idA, \"alpha\")\n38|\tif kind == \"task_board\" {\n39|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n40|\t}\n41|\tref, err := local.CreateSession(raw)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n46|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n47|\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n48|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n49|\tif kind == \"task_board\" {\n50|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n51|\t}\n52|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n53|\tr := &Reader{Local: local, LocalHostID: hostA}\n54|\twithCheckpoints(r, cp)\n55|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n56|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 4, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n57|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n58|\tif ancestor {\n59|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n60|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n61|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n62|\t\tif kind == \"task_board\" {\n63|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n64|\t\t}\n65|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n66|\t\twithCheckpoints(r, cp2)\n67|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n68|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n69|\t}\n70|\trev7CheckEntries(t, r, false)\n71|\treturn r, tail\n72|}\n73|\n74|func rev7SwapCheckpoint(t *testing.T, r *Reader, cp []byte) {\n75|\tt.Helper()\n76|\tr.CheckpointRecords[0] = cp\n77|\tfor i, raw := range r.LeaseRecords {\n78|\t\tvar v map[string]any\n79|\t\tif err := json.Unmarshal(raw, &v); err != nil {\n80|\t\t\tt.Fatal(err)\n81|\t\t}\n82|\t\tif v[\"lease_id\"] == leaseB {\n83|\t\t\tr.LeaseRecords[i] = rev7Replace(t, raw, \"record_id\", map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp)})\n84|\t\t}\n85|\t}\n86|}\n87|\n88|func TestRev7IndependentPersistence(t *testing.T) {\n89|\tfor _, kind := range []string{\"direct\", \"task_board\"} {\n90|\t\tfor _, ancestor := range []bool{false, true} {\n91|\t\t\tpath := \"winner\"\n92|\t\t\tif ancestor {\n93|\t\t\t\tpath = \"ancestor\"\n94|\t\t\t}\n95|\t\t\tfor _, wrong := range []bool{false, true} {\n96|\t\t\t\tmode := \"control\"\n97|\t\t\t\tif wrong {\n98|\t\t\t\t\tmode = \"wrong_variant\"\n99|\t\t\t\t}\n100|\t\t\t\tt.Run(kind+\"/\"+path+\"/\"+mode, func(t *testing.T) {\n101|\t\t\t\t\tr, _ := rev7Fixture(t, kind, ancestor)\n102|\t\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n103|\t\t\t\t\tif wrong {\n104|\t\t\t\t\t\tchange := map[string]any{\"provider_manifest_id\": nil, \"task_board_bundle_id\": zeroDigest}\n105|\t\t\t\t\t\tif kind == \"task_board\" {\n106|\t\t\t\t\t\t\tchange = map[string]any{\"provider_manifest_id\": zeroDigest, \"task_board_bundle_id\": nil}\n107|\t\t\t\t\t\t}\n108|\t\t\t\t\t\trev7SwapCheckpoint(t, r, rev7Replace(t, r.CheckpointRecords[0], \"checkpoint_id\", change))\n109|\t\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n110|\t\t\t\t\t\t\tt.Error(\"old-plan Revalidate admitted wrong persistence variant\")\n111|\t\t\t\t\t\t}\n112|\t\t\t\t\t}\n113|\t\t\t\t\trev7CheckEntries(t, r, wrong)\n114|\t\t\t\t})\n115|\t\t\t}\n116|\t\t}\n117|\t}\n118|}\n119|\n120|func TestRev7CheckpointHeadAuthority(t *testing.T) {\n121|\tfor _, ancestor := range []bool{false, true} {\n122|\t\tpath := \"winner\"\n123|\t\tif ancestor {\n124|\t\t\tpath = \"ancestor\"\n125|\t\t}\n126|\t\tfor _, mode := range []string{\"control\", \"missing_head\", \"later_lease_head\"} {\n127|\t\t\tt.Run(path+\"/\"+mode, func(t *testing.T) {\n128|\t\t\t\tr, future := rev7Fixture(t, \"direct\", ancestor)\n129|\t\t\t\told := mustBuild(t, r, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n130|\t\t\t\tif mode != \"control\" {\n131|\t\t\t\t\thead := zeroDigest\n132|\t\t\t\t\tif mode == \"later_lease_head\" {\n133|\t\t\t\t\t\thead = future\n134|\t\t\t\t\t}\n135|\t\t\t\t\trev7SwapCheckpoint(t, r, rev7Replace(t, r.CheckpointRecords[0], \"checkpoint_id\", map[string]any{\"event_heads\": []string{head}}))\n136|\t\t\t\t\tif err := r.Revalidate(old); err == nil {\n137|\t\t\t\t\t\tt.Error(\"old-plan Revalidate admitted invalid checkpoint event-head authority\")\n138|\t\t\t\t\t}\n139|\t\t\t\t}\n140|\t\t\t\trev7CheckEntries(t, r, mode != \"control\")\n141|\t\t\t})\n142|\t\t}\n143|\t}\n144|}\n145|\n146|func rev7CheckEntries(t *testing.T, r *Reader, refuse bool) {\n147|\tt.Helper()\n148|\tmetadata := summaryReader(t)\n149|\tr.HostMetadata, r.Observations = metadata.HostMetadata, metadata.Observations\n150|\tstamp := \"2026-08-19T04:09:30.000Z\"\n151|\tobservation := r.Observations[idA]\n152|\tobservation.NewestCheckpointCreatedAt = &stamp\n153|\tr.Observations[idA] = observation\n154|\tp, buildErr := r.BuildPlan(PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n155|\tif refuse && buildErr == nil {\n156|\t\tt.Errorf(\"BuildPlan admitted invalid lease/checkpoint authority; Revalidate=%v\", r.Revalidate(p))\n157|\t}\n158|\tif !refuse && buildErr != nil {\n159|\t\tt.Fatalf(\"positive BuildPlan: %v\", buildErr)\n160|\t}\n161|\tif !refuse {\n162|\t\tif err := r.Revalidate(p); err != nil {\n163|\t\t\tt.Errorf(\"positive Revalidate: %v\", err)\n164|\t\t}\n165|\t}\n166|\t_, statusErr := r.AuthoritativeStatus(\"alpha\")\n167|\t_, listErr := r.AuthoritativeList()\n168|\tif refuse && statusErr == nil {\n169|\t\tt.Error(\"AuthoritativeStatus admitted invalid lease/checkpoint authority\")\n170|\t}\n171|\tif refuse && listErr == nil {\n172|\t\tt.Error(\"AuthoritativeList admitted invalid lease/checkpoint authority\")\n173|\t}\n174|\tif !refuse && (statusErr != nil || listErr != nil) {\n175|\t\tt.Errorf(\"positive summaries: status=%v list=%v\", statusErr, listErr)\n176|\t}\n177|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
