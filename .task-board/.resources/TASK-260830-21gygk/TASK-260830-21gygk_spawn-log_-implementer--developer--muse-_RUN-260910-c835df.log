{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d467","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":2190,"recorded_at":1780531400004375,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"task_stream":{"kind":"task","id":"01a08961-3915-72f1-b0aa-609c16552336"},"task_id":"01a08961-3915-72f1-b0aa-609c16552336","event":{"kind":"output","task_id":"01a08961-3915-72f1-b0aa-609c16552336","chunk":"{\n  \"chunk_id\": \"exec-56-1\",\n  \"command\": \"sed -n '1,20p' internal/sessquery/rev7_regression_test.go; python3 -c \\\"import json; d=json.load(open('/tmp/mutB-out/mutants.json')); print([ (r['mutant'], r['classification'], r.get('exit')) for r in d if r['mutant'] in ('N-checkpoint-heads','control-before','control-after','C-harmless-comment') ])\\\"\",\n  \"description\": \"Check rev7 imports and mutant record\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"// Checkpoint event-head authority regression tests for\\n// TASK-260830-21gygk (SPEC 5.4, CR7 P1): every required checkpoint\\n// in the winning ancestry must resolve each event head to a chained\\n// event for its session at or before its bound lease in the winning\\n// source chain. A head naming an absent event or an event under a\\n// later lease cannot establish current complete authority. Every\\n// case drives the four shared production entries (BuildPlan,\\n// Revalidate fresh and old-plan, AuthoritativeStatus,\\n// AuthoritativeList), never the validators directly. Ported from the\\n// CR7 independent reviewer regression and retained as the candidate\\n// positive/negative control for the shared admission path.\\npackage sessquery\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"testing\\\"\\n)\\n\\nfunc rev7Replace(t *testing.T, raw []byte, self string, values map[string]any) []byte {\\n\\tt.Helper()\\n[('control-before', 'CONTROL', 0), ('N-checkpoint-heads', 'SURVIVED', 0), ('C-harmless-comment', 'SURVIVED', 0), ('control-after', 'CONTROL', 0)]\\n\",\n  \"original_output_bytes\": 1016,\n  \"original_output_tokens\": 254,\n  \"truncated\": false\n}","final_result":true}}}
