{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c659","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":391,"recorded_at":1780531400000777,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"task_stream":{"kind":"task","id":"01a0894a-d294-7912-a817-8da7c194621e"},"task_id":"01a0894a-d294-7912-a817-8da7c194621e","event":{"kind":"output","task_id":"01a0894a-d294-7912-a817-8da7c194621e","chunk":"Read text file `/tmp/rev8ev/reviewer_rev8_test.go`.\n1|package sessquery\n2|import(\"testing\"; \"fmt\")\n3|func rev8ProfileFixture(t *testing.T, kind string, ancestor bool, bad bool) (*Reader, string) {\n4|\tt.Helper()\n5|\tlocal, _ := repository(t)\n6|\traw := record(t, idA, \"alpha\")\n7|\tif kind == \"task_board\" {\n8|\t\traw = taskBoardRecordBytes(t, idA, \"alpha\")\n9|\t}\n10|\tref, err := local.CreateSession(raw)\n11|\tif err != nil {\n12|\t\tt.Fatal(err)\n13|\t}\n14|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n15|\tvar source any\n16|\tif bad { source = zeroDigest }\n17|\tlaunched := appendEvent(t, local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": source, \"profile_mapping\": \"default\"})\n18|\tidle := appendEvent(t, local, idA, launched, \"session.idle\", 3, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n19|\tcp := checkpointRecordBytes(t, idA, 1, lease, hostA)\n20|\tif kind == \"task_board\" {\n21|\t\tcp = taskBoardCheckpointBytes(t, idA, 1, lease, hostA)\n22|\t}\n23|\tcp = rev7Replace(t, cp, \"checkpoint_id\", map[string]any{\"event_heads\": []string{idle}})\n24|\tr := &Reader{Local: local, LocalHostID: hostA}\n25|\twithCheckpoints(r, cp)\n26|\twithLeases(r, leaseCreate(t, idA, hostA), leaseSuccessorBytes(t, idA, 2, leaseB, hostA, lease, checkpointDigestOf(t, cp)))\n27|\tannounced := appendEvent(t, local, idA, idle, \"checkpoint.created\", 4, map[string]any{\"checkpoint_id\": checkpointDigestOf(t, cp), \"kind\": \"manual\"})\n28|\ttail := appendEventAs(t, local, idA, announced, \"lease.transferred\", 1, 2, leaseB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": lease, \"new_lease_id\": leaseB})\n29|\tif ancestor {\n30|\t\ttail = appendEventAs(t, local, idA, tail, \"provider.launched\", 2, 2, leaseB, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n31|\t\ttail = appendEventAs(t, local, idA, tail, \"session.idle\", 3, 2, leaseB, map[string]any{\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true})\n32|\t\tcp2 := checkpointRecordBytes(t, idA, 2, leaseB, hostA)\n33|\t\tif kind == \"task_board\" {\n34|\t\t\tcp2 = taskBoardCheckpointBytes(t, idA, 2, leaseB, hostA)\n35|\t\t}\n36|\t\tcp2 = rev7Replace(t, cp2, \"checkpoint_id\", map[string]any{\"event_heads\": []string{tail}})\n37|\t\twithCheckpoints(r, cp2)\n38|\t\twithLeases(r, leaseSuccessorBytes(t, idA, 3, leaseCycleB, hostA, leaseB, checkpointDigestOf(t, cp2)))\n39|\t\ttail = appendEventAs(t, local, idA, tail, \"lease.transferred\", 1, 3, leaseCycleB, map[string]any{\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA, \"predecessor_lease_id\": leaseB, \"new_lease_id\": leaseCycleB})\n40|\t}\n41|\treturn r, tail\n42|}\n43|\n44|func TestRev8CheckpointProfileAuthority(t *testing.T) {\n45| for _, kind := range []string{\"direct\", \"task_board\"} {\n46|  for _, ancestor := range []bool{false,true} {\n47|   for _, bad := range []bool{false,true} {\n48|    t.Run(fmt.Sprintf(\"%s/ancestor=%t/missing_source=%t\",kind,ancestor,bad),func(t *testing.T){\n49|      r,_:=rev8ProfileFixture(t,kind,ancestor,bad)\n50|      rev7CheckEntries(t,r,bad)\n51|    })\n52|   }\n53|  }\n54| }\n55|}","final_result":true}}}
