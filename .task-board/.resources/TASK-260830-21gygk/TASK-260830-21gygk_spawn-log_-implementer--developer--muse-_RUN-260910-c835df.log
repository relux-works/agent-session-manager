string{predecessor},\n30|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n31|\t}\n32|\traw := identity(t, value, \"event_id\")\n33|\tref, err := repo.AppendEvent(id, raw)\n34|\tif err != nil {\n35|\t\tt.Fatal(err)\n36|\t}\n37|\treturn ref.EventID\n38|}\n39|\n40|// copySessionDir replicates one persisted session directory byte for\n41|// byte, so two sources hold the same identity with agreeing digests.\n42|func copySessionDir(t *testing.T, srcRoot, dstRoot, sessionID string) {\n43|\tt.Helper()\n44|\tsrc := filepath.Join(srcRoot, \"sessions\", sessionID)\n45|\tdst := filepath.Join(dstRoot, \"sessions\", sessionID)\n46|\tentries, err := os.ReadDir(src)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tif err := os.MkdirAll(filepath.Join(dst, \"events\"), 0o700); err != nil {\n51|\t\tt.Fatal(err)\n52|\t}\n53|\tfor _, entry := range entries {\n54|\t\tif entry.IsDir() {\n55|\t\t\tblobs, err := os.ReadDir(filepath.Join(src, entry.Name()))\n56|\t\t\tif err != nil {\n57|\t\t\t\tt.Fatal(err)\n58|\t\t\t}\n59|\t\t\tfor _, blob := range blobs {\n60|\t\t\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name(), blob.Name()))\n61|\t\t\t\tif err != nil {\n62|\t\t\t\t\tt.Fatal(err)\n63|\t\t\t\t}\n64|\t\t\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name(), blob.Name()), bytes, 0o600); err != nil {\n65|\t\t\t\t\tt.Fatal(err)\n66|\t\t\t\t}\n67|\t\t\t}\n68|\t\t\tcontinue\n69|\t\t}\n70|\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name()))\n71|\t\tif err != nil {\n72|\t\t\tt.Fatal(err)\n73|\t\t}\n74|\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name()), bytes, 0o600); err != nil {\n75|\t\t\tt.Fatal(err)\n76|\t\t}\n77|\t}\n78|}\n79|\n80|// plannedSession builds a local session with its bootstrap event and\n81|// validated initial Lease Record, returning the reader, roots, record\n82|// digest, and created event ID. The reader carries the known local\n83|// host identity every local plan requires for its source binding, plus\n84|// the winning lease authority every plan requires.\n85|func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n86|\tt.Helper()\n87|\tlocal, root := repository(t)\n88|\tref := create(t, local, idA, \"alpha\")\n89|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n90|\treader := &Reader{Local: local, LocalHostID: hostA}\n91|\twithLeases(reader, leaseCreate(t, idA, hostA))\n92|\treturn reader, root, ref, created\n93|}\n94|\n95|func mustBuild(t *testing.T, reader *Reader, args PlanArgs) SelectionPlan {\n96|\tt.Helper()\n97|\tplan, err := reader.BuildPlan(args)\n98|\tif err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\treturn plan\n102|}\n103|\n104|func mustStale(t *testing.T, err error, reason string) {\n105|\tt.Helper()\n106|\tif !errors.Is(err, ErrPlanStale) {\n107|\t\tt.Fatalf(\"error = %v, want selector_plan_stale\", err)\n108|\t}\n109|\tif !strings.Contains(err.Error(), reason) {\n110|\t\tt.Fatalf(\"error = %v, want reason %q\", err, reason)\n111|\t}\n112|}\n113|\n114|func TestBuildPlanBindsCurrentFacts(t *testing.T) {\n115|\treader, _, ref, created := plannedSession(t)\n116|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n117|\tif plan.SelectorVersion != SelectorVersion || plan.Selector != \"alpha\" || plan.SessionID != idA {\n118|\t\tt.Fatalf(\"identity: %+v\", plan)\n119|\t}\n120|\tif plan.SessionRecordID != ref.RecordID {\n121|\t\tt.Fatalf(\"record digest = %q, want %q\", plan.SessionRecordID, ref.RecordID)\n122|\t}\n123|\tif plan.SourceHostID != hostA || plan.SourceAlias != nil {\n124|\t\tt.Fatalf(\"local source: host %q alias %+v\", plan.SourceHostID, plan.SourceAlias)\n125|\t}\n126|\tfor _, digest := range []string{plan.SourceIndexDigest, plan.ConfigurationDigest, plan.ExpectationDigest} {\n127|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n128|\t\t\tt.Fatalf(\"digest %q: %v\", digest, err)\n129|\t\t}\n130|\t}\n(more lines below)","final_result":true}}}
