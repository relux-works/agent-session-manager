{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b5","stream":{"kind":"session","id":"01a0894a-0cb5-7fb2-a6c2-26593f708551"},"sequence":565,"recorded_at":1780531400001125,"record_type":"event","durability":"durable","causation_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc","run_stream":{"kind":"run","id":"6ef794f5-c8fc-4d82-b028-da1c8560a2dc"},"task_stream":{"kind":"task","id":"01a0894b-3d9c-7922-83d3-9ed63d4dd5a8"},"task_id":"01a0894b-3d9c-7922-83d3-9ed63d4dd5a8","event":{"kind":"output","task_id":"01a0894b-3d9c-7922-83d3-9ed63d4dd5a8","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessquery/lease.go`.\n1|// Validated Lease Record admission for the v0.6.0 selector contract\n2|// (SPEC Sections 5.3 and 14.7.2).\n3|//\n4|// The reader carries canonical Lease Record bytes from the lease owner\n5|// in Reader.LeaseRecords. Each record is validated through the\n6|// canonicaljson owner (closed shape plus canonical self identity), and\n7|// the greatest (epoch, lease_id) winner per session supplies the plan\n8|// lease_record_id digest with its epoch, lease ID, and holder. Envelope\n9|// triples observed on event chains never substitute for these records:\n10|// a session with no admitted winning record refuses\n11|// selector_observation_unavailable, and malformed bytes refuse\n12|// invalid_config.\n13|package sessquery\n14|\n15|import (\n16|\t\"encoding/json\"\n17|\t\"fmt\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n21|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n22|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n23|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n24|)\n25|\n26|const leaseRecordSchema = \"urn:ax:schema:lease\"\n27|\n28|// validatedLease is one admitted Lease Record: its canonical digest and\n29|// the members the selector binds.\n30|type validatedLease struct {\n31|\tDigest         string\n32|\tSessionID      string\n33|\tLeaseID        string\n34|\tEpoch          uint64\n35|\tHolderHostID   string\n36|\tPredecessor    string\n37|\tHasPredecessor bool\n38|\tCheckpoint     string\n39|\tHasCheckpoint  bool\n40|\tRaw            []byte\n41|}\n42|\n43|// checkpointRecordSchema is the exact Checkpoint Record schema the\n44|// winning-lease checkpoint gate admits.\n45|const checkpointRecordSchema = \"urn:ax:schema:checkpoint\"\n46|\n47|// validatedCheckpoint is one admitted Checkpoint Record: its canonical\n48|// digest with the session and lease it was taken under, plus the host\n49|// that created it. Section 5.4 binds lease_epoch/lease_id to the\n50|// referenced winning lease, so a successor's checkpoint names its\n51|// predecessor lease, and binds created_by_host_id to the current\n52|// lease holder: the holder of the lease the checkpoint names. The\n53|// persistence presence members carry which variant the record uses;\n54|// the referenced Session Record selects which variant is valid\n55|// (checkCheckpointPersistence), because canonical shape alone admits\n56|// either variant. EventHeads carries the authoritative event DAG\n57|// heads immediately before the checkpoint object; every required\n58|// checkpoint must resolve each head to a chained event for its\n59|// session at or before its bound lease\n60|// (checkCheckpointEventHeads), because a canonical checkpoint\n61|// naming an absent event or an event under a later lease cannot\n62|// establish Section 5.3/14.7.2 current complete authority.\n63|type validatedCheckpoint struct {\n64|\tDigest              string\n65|\tSessionID           string\n66|\tLeaseEpoch          uint64\n67|\tLeaseID             string\n68|\tCreatorHostID       string\n69|\tHasProviderManifest bool\n70|\tHasTaskBoardBundle  bool\n71|\tEventHeads          []string\n72|\tRaw                 []byte\n73|}\n74|\n75|// parseLeaseRecord validates one canonical Lease Record through the\n76|// canonicaljson owner and extracts the bound members. Closed-shape and\n77|// identity failures refuse invalid_config; the caller maps absence to\n78|// observation_unavailable.\n79|func parseLeaseRecord(raw []byte) (validatedLease, error) {\n80|\tvar lease validatedLease\n81|\tmembers, fault := environ.DecodeStrictObject(raw)\n82|\tif fault != nil {\n83|\t\treturn lease, fmt.Errorf(\"%w: decode lease record frame: %v\", ErrInvalidConfig, fault)\n84|\t}\n85|\tschema, err := leaseStringMember(members, \"schema\")\n86|\tif err != nil || schema != leaseRecordSchema {\n87|\t\treturn lease, fmt.Errorf(\"%w: lease record schema %q, want %q\", ErrInvalidConfig, schema, leaseRecordSchema)\n88|\t}\n89|\tdigest, field, err := sessrepo.AttestLeaseRecord(raw)\n90|\tif err != nil {\n91|\t\treturn lease, fmt.Errorf(\"%w: verify lease record identity: %v\", ErrInvalidConfig, err)\n92|\t}\n93|\tif field != canonicaljson.SelfRecordID {\n94|\t\treturn lease, fmt.Errorf(\"%w: lease record identity field %q, want record_id\", ErrInvalidConfig, string(field))\n95|\t}\n96|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n97|\tif !ok {\n98|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid session_id member\", ErrInvalidConfig)\n99|\t}\n100|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n101|\tif err != nil {\n102|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no lease_id member: %v\", ErrInvalidConfig, err)\n103|\t}\n104|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n105|\t\treturn lease, fmt.Errorf(\"%w: lease record lease_id: %v\", ErrInvalidConfig, err)\n106|\t}\n107|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"epoch\"), 1, uint53Ceiling)\n108|\tif !ok {\n109|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no epoch at or above 1\", ErrInvalidConfig)\n110|\t}\n111|\tholder, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"holder_host_id\"))\n112|\tif !ok {\n113|\t\treturn lease, fmt.Errorf(\"%w: lease record carries no valid holder_host_id member\", ErrInvalidConfig)\n114|\t}\n115|\tpredecessor, hasPredecessor, err := leaseNullableUUIDv4(members, \"predecessor_lease_id\")\n116|\tif err != nil {\n117|\t\treturn lease, fmt.Errorf(\"%w: lease record predecessor_lease_id: %v\", ErrInvalidConfig, err)\n118|\t}\n119|\tcheckpoint, hasCheckpoint, err := leaseNullableDigest(members, \"checkpoint_id\")\n120|\tif err != nil {\n121|\t\treturn lease, fmt.Errorf(\"%w: lease record checkpoint_id: %v\", ErrInvalidConfig, err)\n122|\t}\n123|\tlease = validatedLease{\n124|\t\tDigest:         digest.String(),\n125|\t\tSessionID:      sessionID.String(),\n126|\t\tLeaseID:        leaseID,\n127|\t\tEpoch:          epoch,\n128|\t\tHolderHostID:   holder.String(),\n129|\t\tPredecessor:    predecessor,\n130|\t\tHasPredecessor: hasPredecessor,\n131|\t\tCheckpoint:     checkpoint,\n132|\t\tHasCheckpoint:  hasCheckpoint,\n133|\t\tRaw:            append([]byte(nil), raw...),\n134|\t}\n135|\treturn lease, nil\n136|}\n137|\n138|func leaseMemberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n139|\treturn members[name]\n140|}\n141|\n142|func leaseStringMember(members map[string]json.RawMessage, name string) (string, error) {\n143|\traw, ok := members[name]\n144|\tif !ok {\n145|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n146|\t}\n147|\tvar value string\n148|\tif err := json.Unmarshal(raw, &value); err != nil {\n149|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n150|\t}\n151|\treturn value, nil\n152|}\n153|\n154|func leaseNullableUUIDv4(members map[string]json.RawMessage, name string) (string, bool, error) {\n155|\traw, ok := members[name]\n156|\tif !ok {\n157|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n158|\t}\n159|\tif string(raw) == \"null\" {\n160|\t\treturn \"\", false, nil\n161|\t}\n162|\tvar value string\n163|\tif err := json.Unmarshal(raw, &value); err != nil {\n164|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n165|\t}\n166|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n167|\t\treturn \"\", false, err\n168|\t}\n169|\treturn value, true, nil\n170|}\n171|\n172|// leaseNullableDigest reads a nullable digest member: null binds\n173|// absence, a string must parse as a canonical digest.\n174|func leaseNullableDigest(members map[string]json.RawMessage, name string) (string, bool, error) {\n175|\traw, ok := members[name]\n176|\tif !ok {\n177|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n178|\t}\n179|\tif string(raw) == \"null\" {\n180|\t\treturn \"\", false, nil\n181|\t}\n182|\tvar value string\n183|\tif err := json.Unmarshal(raw, &value); err != nil {\n184|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n185|\t}\n186|\tdigest, err := scalar.ParseDigest(value)\n187|\tif err != nil {\n188|\t\treturn \"\", false, err\n189|\t}\n190|\treturn digest.String(), true, nil\n191|}\n192|\n193|// parseCheckpointRecord validates one canonical Checkpoint Record\n194|// through the sessrepo owner (closed shape plus canonical self\n195|// identity) and extracts the bound members. Closed-shape and\n196|// identity failures refuse invalid_config; the caller maps an\n197|// unresolvable reference to observation_unavailable.\n198|func parseCheckpointRecord(raw []byte) (validatedCheckpoint, error) {\n199|\tvar checkpoint validatedCheckpoint\n200|\tmembers, fault := environ.DecodeStrictObject(raw)\n201|\tif fault != nil {\n202|\t\treturn checkpoint, fmt.Errorf(\"%w: decode checkpoint record frame: %v\", ErrInvalidConfig, fault)\n203|\t}\n204|\tschema, err := leaseStringMember(members, \"schema\")\n205|\tif err != nil || schema != checkpointRecordSchema {\n206|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record schema %q, want %q\", ErrInvalidConfig, schema, checkpointRecordSchema)\n207|\t}\n208|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n209|\tif err != nil {\n210|\t\treturn checkpoint, fmt.Errorf(\"%w: verify checkpoint record identity: %v\", ErrInvalidConfig, err)\n211|\t}\n212|\tif field != canonicaljson.SelfCheckpointID {\n213|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record identity field %q, want checkpoint_id\", ErrInvalidConfig, string(field))\n214|\t}\n215|\tsessionID, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"session_id\"))\n216|\tif !ok {\n217|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid session_id member\", ErrInvalidConfig)\n218|\t}\n219|\tepoch, ok := environ.CheckUint53Bounds(leaseMemberRaw(members, \"lease_epoch\"), 1, uint53Ceiling)\n220|\tif !ok {\n221|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_epoch at or above 1\", ErrInvalidConfig)\n222|\t}\n223|\tleaseID, err := leaseStringMember(members, \"lease_id\")\n224|\tif err != nil {\n225|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no lease_id member: %v\", ErrInvalidConfig, err)\n226|\t}\n227|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n228|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record lease_id: %v\", ErrInvalidConfig, err)\n229|\t}\n230|\tcreator, ok := environ.CheckUUIDv7(leaseMemberRaw(members, \"created_by_host_id\"))\n231|\tif !ok {\n232|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record carries no valid created_by_host_id member\", ErrInvalidConfig)\n233|\t}\n234|\t_, hasProvider, err := leaseNullableDigest(members, \"provider_manifest_id\")\n235|\tif err != nil {\n236|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record provider_manifest_id: %v\", ErrInvalidConfig, err)\n237|\t}\n238|\t_, hasBoard, err := leaseNullableDigest(members, \"task_board_bundle_id\")\n239|\tif err != nil {\n240|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record task_board_bundle_id: %v\", ErrInvalidConfig, err)\n241|\t}\n242|\theads, err := checkpointEventHeads(members)\n243|\tif err != nil {\n244|\t\treturn checkpoint, fmt.Errorf(\"%w: checkpoint record event_heads: %v\", ErrInvalidConfig, err)\n245|\t}\n246|\tcheckpoint = validatedCheckpoint{\n247|\t\tDigest:              digest.String(),\n248|\t\tSessionID:           sessionID.String(),\n249|\t\tLeaseEpoch:          epoch,\n250|\t\tLeaseID:             leaseID,\n251|\t\tCreatorHostID:       creator.String(),\n252|\t\tHasProviderManifest: hasProvider,\n253|\t\tHasTaskBoardBundle:  hasBoard,\n254|\t\tEventHeads:          heads,\n255|\t\tRaw:                 append([]byte(nil), raw...),\n256|\t}\n257|\treturn checkpoint, nil\n258|}\n259|\n260|// checkpointEventHeads extracts the sorted unique event-head digests\n261|// the canonical checkpoint owner already shape-validated (1..64\n262|// entries). Grammar failures refuse invalid_config; resolution\n263|// against the session chain belongs to checkCheckpointEventHeads.\n264|func checkpointEventHeads(members map[string]json.RawMessage) ([]string, error) {\n265|\traw, ok := members[\"event_heads\"]\n266|\tif !ok {\n267|\t\treturn nil, fmt.Errorf(\"member %q is absent\", \"event_heads\")\n268|\t}\n269|\tvar values []string\n270|\tif err := json.Unmarshal(raw, &values); err != nil {\n271|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", \"event_heads\", err)\n272|\t}\n273|\tout := make([]string, 0, len(values))\n274|\tfor _, value := range values {\n275|\t\tdigest, err := scalar.ParseDigest(value)\n276|\t\tif err != nil {\n277|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", \"event_heads\", value, err)\n278|\t\t}\n279|\t\tout = append(out, digest.String())\n280|\t}\n281|\treturn out, nil\n282|}\n283|\n284|// validatedLeasesBySession validates every supplied Lease Record and\n285|// groups the admitted records by session UUID.\n286|func (reader *Reader) validatedLeasesBySession() (map[string][]validatedLease, error) {\n287|\tout := map[string][]validatedLease{}\n288|\tif reader == nil {\n289|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n290|\t}\n291|\tfor _, raw := range reader.LeaseRecords {\n292|\t\tlease, err := parseLeaseRecord(raw)\n293|\t\tif err != nil {\n294|\t\t\treturn nil, err\n295|\t\t}\n296|\t\tout[lease.SessionID] = append(out[lease.SessionID], lease)\n297|\t}\n298|\treturn out, nil\n299|}\n300|\n301|// winningLeaseFor selects the greatest (epoch, lease_id) validated Lease\n302|// Record for one session and validates its succession: the\n303|// predecessor ancestry must chain by epoch plus one down to an\n304|// epoch-1 root, and every lease in that winning ancestry above\n305|// epoch 1 must reference a validated checkpoint for its session and\n306|// predecessor lease (Section 5.3), each created by the owning lease\n307|// holder (Section 5.4). Every required checkpoint must additionally\n308|// carry the persistence variant the referenced Session Record\n309|// selects: sessionKind is that record's kind as projected from the\n310|// winning source, and a variant mismatch refuses\n311|// observation_unavailable even when canonical identity, session,\n312|// lease, epoch, and creator all agree. Every required checkpoint\n313|// must also resolve each event head to a chained event for its\n314|// session at or before its bound lease in the winning source chain\n315|// (repo, Section 5.4 event-head closure): a head naming an absent\n316|// event or an event under a later lease cannot establish current\n317|// complete authority, so it refuses observation_unavailable;\n318|// historical heads stay admissible and are never required to equal\n319|// the current tail. Absence refuses observation_unavailable; a\n320|// lease above epoch 1 without its named predecessor in the admitted\n321|// set refuses the same class rather than binding a dangling\n322|// successor, while an illegal predecessor link is malformed\n323|// authority (integrity failure).\n324|func (reader *Reader) winningLeaseFor(sessionID, sessionKind string, repo *sessrepo.Repository) (validatedLease, error) {\n325|\tif sessionKind != \"direct\" && sessionKind != \"task_board\" {\n326|\t\treturn validatedLease{}, fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n327|\t}\n328|\tbySession, err := reader.validatedLeasesBySession()\n329|\tif err != nil {\n330|\t\treturn validatedLease{}, err\n331|\t}\n332|\tcandidates := bySession[sessionID]\n333|\tif len(candidates) == 0 {\n334|\t\treturn validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s cannot be established\", ErrObservationUnavailable, sessionID)\n335|\t}\n336|\twinner := candidates[0]\n337|\tfor _, candidate := range candidates[1:] {\n338|\t\tif sessstate.Compare(\n339|\t\t\tsessstate.LeaseHead{Epoch: candidate.Epoch, LeaseID: candidate.LeaseID},\n340|\t\t\tsessstate.LeaseHead{Epoch: winner.Epoch, LeaseID: winner.LeaseID},\n341|\t\t) > 0 {\n342|\t\t\twinner = candidate\n343|\t\t}\n344|\t}\n345|\tchain, predecessor, err := checkLeaseChain(candidates, winner)\n346|\tif err != nil {\n347|\t\treturn validatedLease{}, err\n348|\t}\n349|\tif err := reader.checkWinnerCheckpoint(winner, predecessor, sessionKind, repo); err != nil {\n350|\t\treturn validatedLease{}, err\n351|\t}\n352|\tif err := reader.checkAncestorCheckpoints(chain, sessionKind, repo); err != nil {\n353|\t\treturn validatedLease{}, err\n354|\t}\n355|\treturn winner, nil\n356|}\n357|\n358|// checkLeaseChain validates the winner's predecessor ancestry within\n359|// the admitted records for its session. Section 5.3 requires every\n360|// epoch above 1 to name a known predecessor for the same session\n361|// with an epoch exactly one below, down to an epoch-1 root with a\n362|// null predecessor; epochs below 1 cannot exist, so an epoch-1\n363|// lease naming any predecessor is malformed. A self, cyclic,\n364|// skipped, contradictory, or duplicated link is malformed authority\n365|// (integrity failure); a missing predecessor name or record is\n366|// incomplete authority (observation_unavailable). Epochs strictly\n367|// decrease along the walk, so the walk always terminates. It\n368|// returns the winning ancestry from the winner down to the epoch-1\n369|// root, plus the winner's direct predecessor, or the zero lease at\n370|// epoch 1.\n371|func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {\n372|\tbyLease := make(map[string]validatedLease, len(candidates))\n373|\tfor _, candidate := range candidates {\n374|\t\tif previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {\n375|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s carries contradictory lease records for lease %s\", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)\n376|\t\t}\n377|\t\tbyLease[candidate.LeaseID] = candidate\n378|\t}\n379|\tvar predecessor validatedLease\n380|\tvar chain []validatedLease\n381|\tcurrent := winner\n382|\tfor {\n383|\t\tchain = append(chain, current)\n384|\t\tif current.Epoch == 1 {\n385|\t\t\tif current.HasPredecessor {\n386|\t\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s epoch-1 lease %s names a predecessor\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)\n387|\t\t\t}\n388|\t\t\treturn chain, predecessor, nil\n389|\t\t}\n390|\t\tif !current.HasPredecessor {\n391|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: winning lease record for session %s names no predecessor\", ErrObservationUnavailable, current.SessionID)\n392|\t\t}\n393|\t\tparent, ok := byLease[current.Predecessor]\n394|\t\tif !ok {\n395|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n396|\t\t}\n397|\t\tif parent.Epoch+1 != current.Epoch {\n398|\t\t\treturn nil, validatedLease{}, fmt.Errorf(\"%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d\", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)\n399|\t\t}\n400|\t\tif current.LeaseID == winner.LeaseID {\n401|\t\t\tpredecessor = parent\n402|\t\t}\n403|\t\tcurrent = parent\n404|\t}\n405|}\n406|\n407|// validatedCheckpointsByDigest validates every supplied Checkpoint\n408|// Record and indexes the admitted records by canonical digest.\n409|func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {\n410|\tout := map[string]validatedCheckpoint{}\n411|\tif reader == nil {\n412|\t\treturn out, fmt.Errorf(\"%w: reader carries no configuration\", ErrInvalidConfig)\n413|\t}\n414|\tfor _, raw := range reader.CheckpointRecords {\n415|\t\tcheckpoint, err := parseCheckpointRecord(raw)\n416|\t\tif err != nil {\n417|\t\t\treturn nil, err\n418|\t\t}\n419|\t\tout[checkpoint.Digest] = checkpoint\n420|\t}\n421|\treturn out, nil\n422|}\n423|\n424|// checkWinnerCheckpoint resolves the winner's checkpoint reference\n425|// against the admitted Checkpoint Records. Section 5.3 requires\n426|// every epoch above 1 to reference a validated checkpoint for its\n427|// session and predecessor lease; an epoch-1 root without a\n428|// predecessor may carry no checkpoint before the first provider\n429|// boundary exists. A non-null reference must resolve to an admitted\n430|// record for the same session bound to the lease it was taken\n431|// under: the predecessor for a successor, the winner itself at\n432|// epoch 1 (Section 5.4 binds a checkpoint to its winning lease). An\n433|// unresolvable reference is incomplete authority\n434|// (observation_unavailable), never absence or a minted fact. The\n435|// admitted checkpoint must also resolve its event-head closure in\n436|// the winning source chain (repo); see checkCheckpointEventHeads.\n437|func (reader *Reader) checkWinnerCheckpoint(winner validatedLease, predecessor validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n438|\tif !winner.HasCheckpoint {\n439|\t\tif winner.Epoch == 1 && !winner.HasPredecessor {\n440|\t\t\treturn nil\n441|\t\t}\n442|\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, winner.SessionID, winner.LeaseID)\n443|\t}\n444|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n445|\tif err != nil {\n446|\t\treturn err\n447|\t}\n448|\tcheckpoint, ok := checkpoints[winner.Checkpoint]\n449|\tif !ok {\n450|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, winner.Checkpoint, winner.SessionID)\n451|\t}\n452|\tif checkpoint.SessionID != winner.SessionID {\n453|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.SessionID, winner.SessionID)\n454|\t}\n455|\twantEpoch, wantLease := winner.Epoch, winner.LeaseID\n456|\tif winner.Epoch > 1 {\n457|\t\twantEpoch, wantLease = predecessor.Epoch, predecessor.LeaseID\n458|\t}\n459|\tif checkpoint.LeaseEpoch != wantEpoch || checkpoint.LeaseID != wantLease {\n460|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, wantLease, wantEpoch)\n461|\t}\n462|\towner := winner\n463|\tif winner.Epoch > 1 {\n464|\t\towner = predecessor\n465|\t}\n466|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n467|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, winner.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n468|\t}\n469|\tif err := checkCheckpointPersistence(checkpoint, winner.SessionID, sessionKind); err != nil {\n470|\t\treturn err\n471|\t}\n472|\tif err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {\n473|\t\treturn err\n474|\t}\n475|\treturn nil\n476|}\n477|\n478|// checkAncestorCheckpoints validates the checkpoint references of\n479|// every non-winner lease in the winning ancestry: Section 5.3\n480|// requires each epoch above 1 to reference a validated checkpoint\n481|// for its session and predecessor lease, and Section 5.4 requires\n482|// that checkpoint to be created by the owning lease holder. The\n483|// winner itself is covered by checkWinnerCheckpoint. Only the\n484|// winner's own ancestry is admitted: sibling branches off that\n485|// chain are never consulted, so legal branching is preserved. An\n486|// epoch-1 root without a reference stays admissible before the\n487|// first provider boundary exists; a reference it does carry must\n488|// resolve to a checkpoint bound to itself and created by its own\n489|// holder. An unresolvable reference or a binding to another\n490|// session, lease, or holder is incomplete authority\n491|// (observation_unavailable), never absence or a minted fact. Every\n492|// admitted ancestor checkpoint must also resolve its event-head\n493|// closure in the winning source chain (repo).\n494|func (reader *Reader) checkAncestorCheckpoints(chain []validatedLease, sessionKind string, repo *sessrepo.Repository) error {\n495|\tif len(chain) < 2 {\n496|\t\treturn nil\n497|\t}\n498|\tcheckpoints, err := reader.validatedCheckpointsByDigest()\n499|\tif err != nil {\n500|\t\treturn err\n501|\t}\n502|\tfor index := 1; index < len(chain); index++ {\n503|\t\tcurrent := chain[index]\n504|\t\tif current.Epoch == 1 {\n505|\t\t\tif !current.HasCheckpoint {\n506|\t\t\t\tcontinue\n507|\t\t\t}\n508|\t\t\tif err := checkCheckpointBinding(current, current, checkpoints, sessionKind, repo); err != nil {\n509|\t\t\t\treturn err\n510|\t\t\t}\n511|\t\t\tcontinue\n512|\t\t}\n513|\t\tif !current.HasCheckpoint {\n514|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint for session %s lease %s cannot be established\", ErrObservationUnavailable, current.SessionID, current.LeaseID)\n515|\t\t}\n516|\t\tif index+1 >= len(chain) {\n517|\t\t\treturn fmt.Errorf(\"%w: predecessor lease record for session %s cannot be established\", ErrObservationUnavailable, current.SessionID)\n518|\t\t}\n519|\t\tif err := checkCheckpointBinding(current, chain[index+1], checkpoints, sessionKind, repo); err != nil {\n520|\t\t\treturn err\n521|\t\t}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// checkCheckpointBinding resolves one lease's checkpoint reference\n527|// against the admitted Checkpoint Records and validates its Section\n528|// 5.3 session and predecessor-lease binding with its Section 5.4\n529|// holder binding: the checkpoint must name this session and the\n530|// owning lease, and its creator must be that lease's holder. The\n531|// admitted checkpoint must also resolve its event-head closure in\n532|// the winning source chain (repo); see checkCheckpointEventHeads.\n533|func checkCheckpointBinding(current, owner validatedLease, checkpoints map[string]validatedCheckpoint, sessionKind string, repo *sessrepo.Repository) error {\n534|\tcheckpoint, ok := checkpoints[current.Checkpoint]\n535|\tif !ok {\n536|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s for session %s cannot be established\", ErrObservationUnavailable, current.Checkpoint, current.SessionID)\n537|\t}\n538|\tif checkpoint.SessionID != current.SessionID {\n539|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries session %s, want %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.SessionID, current.SessionID)\n540|\t}\n541|\tif checkpoint.LeaseEpoch != owner.Epoch || checkpoint.LeaseID != owner.LeaseID {\n542|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is bound to lease %s at epoch %d, want lease %s at epoch %d\", ErrObservationUnavailable, current.Checkpoint, checkpoint.LeaseID, checkpoint.LeaseEpoch, owner.LeaseID, owner.Epoch)\n543|\t}\n544|\tif checkpoint.CreatorHostID != owner.HolderHostID {\n545|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s is created by host %s, want owning lease holder %s\", ErrObservationUnavailable, current.Checkpoint, checkpoint.CreatorHostID, owner.HolderHostID)\n546|\t}\n547|\tif err := checkCheckpointPersistence(checkpoint, current.SessionID, sessionKind); err != nil {\n548|\t\treturn err\n549|\t}\n550|\tif err := checkCheckpointEventHeads(checkpoint, owner, repo); err != nil {\n551|\t\treturn err\n552|\t}\n553|\treturn nil\n554|}\n555|\n556|// checkCheckpointEventHeads resolves every event head of one admitted\n557|// Checkpoint Record against the winning source chain for its session\n558|// (Section 5.4 event-head closure). Each head must name a chained\n559|// event for the same session at or before the owning lease: a head\n560|// naming an absent event (including a cross-session digest, a\n561|// losing-lease preserved blob outside the authoritative chain, or a\n562|// synthetic placeholder) is incomplete authority\n563|// (observation_unavailable), and a head under a later lease (a\n564|// greater epoch, or the same epoch under a different fencing token)\n565|// is likewise incomplete authority because the checkpoint cannot fix\n566|// authority over events that postdate it. Historical heads stay\n567|// admissible and are never required to equal the current tail, so\n568|// valid branching and lagging copies are preserved. A failed chain\n569|// read keeps its cause inside the same incomplete-authority refusal\n570|// instead of minting a fact, and a nil chain handle refuses the same\n571|// class rather than skipping the gate.\n572|func checkCheckpointEventHeads(checkpoint validatedCheckpoint, owner validatedLease, repo *sessrepo.Repository) error {\n573|\tif repo == nil {\n574|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: no winning source chain\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID)\n575|\t}\n576|\tevents, err := repo.ListEvents(checkpoint.SessionID)\n577|\tif err != nil {\n578|\t\treturn fmt.Errorf(\"%w: validated checkpoint %s event-head authority for session %s cannot be established: %v\", ErrObservationUnavailable, checkpoint.Digest, checkpoint.SessionID, err)\n579|\t}\n580|\tbyID := make(map[string]sessrepo.EventSummary, len(events))\n581|\tfor _, summary := range events {\n582|\t\tbyID[summary.EventID] = summary\n583|\t}\n584|\tfor _, head := range checkpoint.EventHeads {\n585|\t\tsummary, ok := byID[head]\n586|\t\tif !ok {\n587|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names unknown event head %s for session %s\", ErrObservationUnavailable, checkpoint.Digest, head, checkpoint.SessionID)\n588|\t\t}\n589|\t\tif summary.LeaseEpoch > owner.Epoch {\n590|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under later lease epoch %d, want at or before epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseEpoch, owner.Epoch)\n591|\t\t}\n592|\t\tif summary.LeaseEpoch == owner.Epoch && summary.LeaseID != owner.LeaseID {\n593|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s names event head %s under lease %s, want owning lease %s at epoch %d\", ErrObservationUnavailable, checkpoint.Digest, head, summary.LeaseID, owner.LeaseID, owner.Epoch)\n594|\t\t}\n595|\t}\n596|\treturn nil\n597|}\n598|\n599|// checkCheckpointPersistence binds an admitted Checkpoint Record to\n600|// the persistence variant the referenced Session Record selects\n601|// (Section 5.4): a direct session requires a non-null\n602|// provider_manifest_id with a null task_board_bundle_id, while a\n603|// task_board session requires the reverse. Canonical shape proves\n604|// exactly one variant is present but cannot select which one is\n605|// valid, so a swapped variant keeps canonical identity, session,\n606|// lease, epoch, and creator yet refuses here with incomplete\n607|// authority (observation_unavailable), never absence or a minted\n608|// fact. An unknown session kind is malformed configuration: valid\n609|// Session Records admit only the two kinds.\n610|func checkCheckpointPersistence(checkpoint validatedCheckpoint, sessionID, sessionKind string) error {\n611|\tswitch sessionKind {\n612|\tcase \"direct\":\n613|\t\tif !checkpoint.HasProviderManifest || checkpoint.HasTaskBoardBundle {\n614|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a task-board persistence variant for direct session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n615|\t\t}\n616|\t\treturn nil\n617|\tcase \"task_board\":\n618|\t\tif checkpoint.HasProviderManifest || !checkpoint.HasTaskBoardBundle {\n619|\t\t\treturn fmt.Errorf(\"%w: validated checkpoint %s carries a provider persistence variant for task_board session %s\", ErrObservationUnavailable, checkpoint.Digest, sessionID)\n620|\t\t}\n621|\t\treturn nil\n622|\tdefault:\n623|\t\treturn fmt.Errorf(\"%w: session %s carries unknown kind %q for checkpoint persistence\", ErrInvalidConfig, sessionID, sessionKind)\n624|\t}\n625|}\n626|\n627|// compareLeaseTuple orders (epoch, lease_id) with the Section 5.3 rule:\n628|// greatest epoch wins, ties break by bytewise lease-ID order.\n629|func compareLeaseTuple(epochA uint64, leaseA string, epochB uint64, leaseB string) int {\n630|\treturn sessstate.Compare(\n631|\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n632|\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n633|\t)\n634|}","final_result":true}}}
