+def test_command(name, path):
+    pattern = TEST_PATTERNS.get(name)
+    if pattern is None:
+        raise SystemExit(f'no behavioral test mapping for {name}')
+    packages = ['./internal/sessrepo'] if path == repo_source else ['./internal/sessquery']
