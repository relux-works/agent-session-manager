@@ -0,0 +1,168 @@
+package sessquery
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/relux-works/agent-session-manager/internal/sessrepo"
