   817	// rev12LoadImportArchives asks the module-aware Go tool for export data, then
   818	// gives go/types an explicit lookup table. importer.Default alone searches
   819	// GOPATH and cannot resolve this module's internal packages from a temporary
   820	// hostile-plant directory.
   821	func rev12LoadImportArchives() (map[string]string, error) {
   822		_, file, _, ok := runtime.Caller(0)
   823		if !ok {
   824			return nil, fmt.Errorf("cannot locate test file for module root")
   825		}
   826		moduleRoot := filepath.Dir(filepath.Dir(filepath.Dir(file)))
   827		command := exec.Command("go", "list", "-deps", "-export", "-json", "./internal/sessquery")
   828		command.Dir = moduleRoot
   829		output, err := command.Output()
   830		if err != nil {
   831			return nil, fmt.Errorf("load Go export archives: %w", err)
   832		}
   833		archives := map[string]string{}
   834		decoder := json.NewDecoder(bytes.NewReader(output))
   835		for {
   836			var item struct {
   837				ImportPath string
   838				Export     string
   839			}
   840			if err := decoder.Decode(&item); err != nil {
   841				if errors.Is(err, io.EOF) {
   842					break
   843				}
   844				return nil, fmt.Errorf("decode Go export archive list: %w", err)
   845			}
   846			if item.ImportPath != "" && item.Export != "" {
   847				archives[item.ImportPath] = item.Export
   848			}
   849		}
   850		return archives, nil

