   389	// checkLeaseChain validates the winner's predecessor ancestry within
   390	// the admitted records for its session. Section 5.3 requires every
   391	// epoch above 1 to name a known predecessor for the same session
   392	// with an epoch exactly one below, down to an epoch-1 root with a
   393	// null predecessor; epochs below 1 cannot exist, so an epoch-1
   394	// lease naming any predecessor is malformed. A self, cyclic,
   395	// skipped, contradictory, or duplicated link is malformed authority
   396	// (integrity failure); a missing predecessor name or record is
   397	// incomplete authority (observation_unavailable). Epochs strictly
   398	// decrease along the walk, so the walk always terminates. It
   399	// returns the winning ancestry from the winner down to the epoch-1
   400	// root, plus the winner's direct predecessor, or the zero lease at
   401	// epoch 1.
   402	func checkLeaseChain(candidates []validatedLease, winner validatedLease) ([]validatedLease, validatedLease, error) {
   403		byLease := make(map[string]validatedLease, len(candidates))
   404		for _, candidate := range candidates {
   405			if previous, ok := byLease[candidate.LeaseID]; ok && previous.Digest != candidate.Digest {
   406				return nil, validatedLease{}, fmt.Errorf("%w: session %s carries contradictory lease records for lease %s", sessstate.ErrIntegrity, winner.SessionID, candidate.LeaseID)
   407			}
   408			byLease[candidate.LeaseID] = candidate
   409		}
   410		var predecessor validatedLease
   411		var chain []validatedLease
   412		current := winner
   413		for {
   414			chain = append(chain, current)
   415			if current.Epoch == 1 {
   416				if current.HasPredecessor {
   417					return nil, validatedLease{}, fmt.Errorf("%w: session %s epoch-1 lease %s names a predecessor", sessstate.ErrIntegrity, current.SessionID, current.LeaseID)
   418				}
   419				return chain, predecessor, nil
   420			}
   421			if !current.HasPredecessor {
   422				return nil, validatedLease{}, fmt.Errorf("%w: winning lease record for session %s names no predecessor", ErrObservationUnavailable, current.SessionID)
   423			}
   424			parent, ok := byLease[current.Predecessor]
   425			if !ok {
   426				return nil, validatedLease{}, fmt.Errorf("%w: predecessor lease record for session %s cannot be established", ErrObservationUnavailable, current.SessionID)
   427			}
   428			if parent.Epoch+1 != current.Epoch {
   429				return nil, validatedLease{}, fmt.Errorf("%w: session %s lease %s at epoch %d does not succeed its predecessor %s at epoch %d", sessstate.ErrIntegrity, current.SessionID, current.LeaseID, current.Epoch, parent.LeaseID, parent.Epoch)
   430			}
   431			if current.LeaseID == winner.LeaseID {
   432				predecessor = parent
   433			}
   434			current = parent
   435		}
   436	}
