   438	// validatedCheckpointsByDigest validates every supplied Checkpoint
   439	// Record and indexes the parsed records by canonical digest. Semantic
   440	// admission happens only at the shared admission owners below.
   441	func (reader *Reader) validatedCheckpointsByDigest() (map[string]validatedCheckpoint, error) {
   442		out := map[string]validatedCheckpoint{}
   443		if reader == nil {
   444			return out, fmt.Errorf("%w: reader carries no configuration", ErrInvalidConfig)
   445		}
   446		for _, raw := range reader.CheckpointRecords {
