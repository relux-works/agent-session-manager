+        return
+    census_source.write_text(original.replace(old, new))
+    command = ['go', 'test', './internal/sessquery', '-run', '^TestRev14RecordConsumptionCensusRejectsAlternatePaths$', '-count=1', '-v']
+    try:
+        with (output / (name + '.log')).open('w') as log:
