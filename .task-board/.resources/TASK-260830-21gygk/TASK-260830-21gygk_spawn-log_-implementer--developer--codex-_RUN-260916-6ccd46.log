diff --git a/internal/sessquery/rev14_regression_test.go b/internal/sessquery/rev14_regression_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a5ff15529827b9678489b7b0d59bbd7449afcab7
--- /dev/null
