{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e1","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":843,"recorded_at":1780531400001681,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"call_id":"call_01a0884641897af29840dd3224a7098f","text":"Read text file `internal/sessquery/resolve_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n11|)\n12|\n13|// idC and idD are further session identities for cross-source\n14|// fixtures; hostC is a third peer host.\n15|const idC = \"0198f4c8-3e70-7a11-8a2b-1234567890ad\"\n16|const idD = \"0198f4c8-3e70-7a11-8a2b-1234567890ae\"\n17|const hostC = \"0198f4c8-4a10-7b22-8b3c-1234567890ad\"\n18|\n19|// leaseB is a second fencing token for successor-lease fixtures.\n20|const leaseB = \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\"\n21|\n22|// qualifiedReader builds a local session and a peer session with an\n23|// aliased, allowlisted source, returning the reader, both handles, and\n24|// the peer data root for failure injection.\n25|func qualifiedReader(t *testing.T) (*Reader, *sessrepo.Repository, *sessrepo.Repository, string) {\n26|\tt.Helper()\n27|\tlocal, _ := repository(t)\n28|\tpeer, peerRoot := repository(t)\n29|\tcreate(t, local, idA, \"alpha\")\n30|\tcreate(t, peer, idB, \"beta\")\n31|\treader := &Reader{\n32|\t\tLocal:              local,\n33|\t\tLocalHostID:        hostB,\n34|\t\tAllowlistedPeerIDs: []string{hostA},\n35|\t\tPeers:              []PeerIndex{{hostA, peer}},\n36|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n37|\t}\n38|\treturn reader, local, peer, peerRoot\n39|}\n40|\n41|func TestResolveQualifiedSourcesSelectOneIndex(t *testing.T) {\n42|\treader, _, _, _ := qualifiedReader(t)\n43|\tfor _, row := range []struct {\n44|\t\tselector string\n45|\t\tid       string\n46|\t\tpeer     string\n47|\t}{\n48|\t\t{\"alpha@local\", idA, \"\"},\n49|\t\t{\"beta@peer:workstation\", idB, hostA},\n50|\t\t{\"beta@id:\" + hostA, idB, hostA},\n51|\t\t{\"alpha@id:\" + hostB, idA, \"\"},\n52|\t\t{idA + \"@local\", idA, \"\"},\n53|\t\t{idB + \"@peer:workstation\", idB, hostA},\n54|\t\t{\"id:\" + idB + \"@peer:workstation\", idB, hostA},\n55|\t\t{\"id:\" + idA + \"@local\", idA, \"\"},\n56|\t} {\n57|\t\tgot, err := reader.Resolve(row.selector)\n58|\t\tif err != nil || got.SessionID != row.id || got.PeerHostID != row.peer {\n59|\t\t\tt.Fatalf(\"Resolve(%q) = %+v, %v\", row.selector, got, err)\n60|\t\t}\n61|\t\tstatus, err := reader.Status(row.selector)\n62|\t\tif err != nil || status.Projection.SessionID != row.id {\n63|\t\t\tt.Fatalf(\"Status(%q) = %+v, %v\", row.selector, status, err)\n64|\t\t}\n65|\t}\n66|}\n67|\n68|func TestResolveQualifiedSourceNeverFallsBack(t *testing.T) {\n69|\treader, _, _, _ := qualifiedReader(t)\n70|\t// Each name exists in exactly one source; selecting the other\n71|\t// source misses, even though the union holds the name.\n72|\tfor _, selector := range []string{\"beta@local\", \"alpha@peer:workstation\", \"id:\" + idA + \"@peer:workstation\", \"id:\" + idB + \"@local\"} {\n73|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrNotFound) {\n74|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want not_found without fallback\", selector, err)\n75|\t\t}\n76|\t\tif _, err := reader.Status(selector); !errors.Is(err, ErrNotFound) {\n77|\t\t\tt.Fatalf(\"Status(%q) = %v, want not_found without fallback\", selector, err)\n78|\t\t}\n79|\t}\n80|}\n81|\n82|func TestResolveQualifiedNameBeforeUUIDInSource(t *testing.T) {\n83|\treader, _, peer, _ := qualifiedReader(t)\n84|\t// The peer learns a session whose NAME is shaped like a UUID. A\n85|\t// qualified NAME tries the exact name first; only \"id:\" bypasses it.\n86|\tcreate(t, peer, idC, idA)\n87|\tgot, err := reader.Resolve(idA + \"@peer:workstation\")\n88|\tif err != nil || got.SessionID != idC {\n89|\t\tt.Fatalf(\"qualified name-first: %+v %v\", got, err)\n90|\t}\n91|\tbypass, err := reader.Resolve(\"id:\" + idA + \"@peer:workstation\")\n92|\tif err == nil || !errors.Is(err, ErrNotFound) {\n93|\t\tt.Fatalf(\"id: bypass selected a name: %+v %v\", bypass, err)\n94|\t}\n95|\tcreate(t, peer, idA, \"alpha-peer\")\n96|\tgot, err = reader.Resolve(\"id:\" + idA + \"@peer:workstation\")\n97|\tif err != nil || got.SessionID != idA {\n98|\t\tt.Fatalf(\"id: identity: %+v %v\", got, err)\n99|\t}\n100|}\n101|\n102|func TestResolveQualifiedAmbiguityAndExclusions(t *testing.T) {\n103|\treader, local, peer, _ := qualifiedReader(t)\n104|\tcreate(t, peer, idC, \"BETA\")\n105|\tfor _, selector := range []string{\"beta@peer:workstation\", \"BETA@peer:workstation\"} {\n106|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrAmbiguous) {\n107|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want name_ambiguous\", selector, err)\n108|\t\t}\n109|\t}\n110|\t// Tombstoned and parked entries stay excluded under qualification:\n111|\t// tombstones need authoritative tombstone evidence, and a failed\n112|\t// record read is never that evidence.\n113|\tref := create(t, local, idC, \"doomed\")\n114|\tevent := appendEvent(t, local, idC, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n115|\tevent = appendEvent(t, local, idC, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n116|\tappendEvent(t, local, idC, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n117|\tfor _, selector := range []string{\"doomed@local\", idC + \"@local\", \"id:\" + idC + \"@local\"} {\n118|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrNotFound) {\n119|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want tombstone exclusion\", selector, err)\n120|\t\t}\n121|\t}\n122|\traw := record(t, idD, \"ParkedPeer\")\n123|\tpeer.AfterCreateStep = func(step sessrepo.CreateStep) error {\n124|\t\tif step == sessrepo.CreateStepRecord {\n125|\t\t\treturn errors.New(\"crash\")\n126|\t\t}\n127|\t\treturn nil\n128|\t}\n129|\tif _, err := peer.CreateSession(raw); err == nil {\n130|\t\tt.Fatal(\"fault did not fire\")\n131|\t}\n132|\tpeer.AfterCreateStep = nil\n133|\tfor _, selector := range []string{\"ParkedPeer@peer:workstation\", idD + \"@peer:workstation\", \"id:\" + idD + \"@peer:workstation\"} {\n134|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrNotFound) {\n135|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want parked exclusion\", selector, err)\n136|\t\t}\n137|\t}\n138|}\n139|\n140|func TestResolveExplicitSourceRefusals(t *testing.T) {\n141|\treader, _, _, _ := qualifiedReader(t)\n142|\t// Unknown aliases and hosts are not found; known but disallowed\n143|\t// peers are refused as not allowlisted. The unknown-source probes\n144|\t// use locally present names so a fallback to the local index would\n145|\t// succeed and fail the test.\n146|\tif _, err := reader.Resolve(\"alpha@peer:elsewhere\"); !errors.Is(err, ErrSourceNotFound) {\n147|\t\tt.Fatalf(\"unknown alias: %v\", err)\n148|\t}\n149|\tif _, err := reader.Resolve(\"alpha@id:\" + idC); !errors.Is(err, ErrSourceNotFound) {\n150|\t\tt.Fatalf(\"unknown host: %v\", err)\n151|\t}\n152|\treader.AllowlistedPeerIDs = nil\n153|\t// \"alpha\" resolves locally, so refusing it here proves revocation\n154|\t// never degrades into a local fallback either.\n155|\tfor _, selector := range []string{\"beta@peer:workstation\", \"beta@id:\" + hostA, \"id:\" + idB + \"@peer:workstation\", \"alpha@peer:workstation\"} {\n156|\t\tif _, err := reader.Resolve(selector); !errors.Is(err, ErrPeerNotAllowlisted) {\n157|\t\t\tt.Fatalf(\"Resolve(%q) = %v, want peer_not_allowlisted\", selector, err)\n158|\t\t}\n159|\t}\n160|\t// The bare union still resolves the sessions it may reach; only the\n161|\t// explicit peer route is revoked.\n162|\tif _, err := reader.Resolve(\"beta\"); !errors.Is(err, ErrNotFound) {\n163|\t\tt.Fatalf(\"revoked bare union: %v\", err)\n164|\t}\n165|\t// Local needs no allowlist entry and survives revocation.\n166|\tif _, err := reader.Resolve(\"alpha@local\"); err != nil {\n167|\t\tt.Fatalf(\"local after revocation: %v\", err)\n168|\t}\n169|}\n170|\n171|func TestResolveExplicitSourceReadFailures(t *testing.T) {\n172|\treader, _, peer, peerRoot := qualifiedReader(t)\n173|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n174|\t\tt.Fatal(err)\n175|\t}\n176|\t// The peer failure carries the read-failure class while preserving\n177|\t// the underlying repository cause, and never falls back to the\n178|\t// local index even though \"alpha\" resolves there.\n179|\t_, err := reader.Resolve(\"beta@peer:workstation\")\n180|\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n181|\t\tt.Fatalf(\"explicit peer failure: %v\", err)\n182|\t}\n183|\tif _, err := reader.Resolve(\"alpha@peer:workstation\"); !errors.Is(err, ErrSourceReadFailed) {\n184|\t\tt.Fatalf(\"explicit miss behind failed read fell back: %v\", err)\n185|\t}\n186|\treader.Peers = []PeerIndex{{hostA, nil}}\n187|\tif _, err := reader.Resolve(\"beta@peer:workstation\"); !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, ErrUnavailable) {\n188|\t\tt.Fatalf(\"nil learned index: %v\", err)\n189|\t}\n190|\t// An allowlisted peer with no advertised index at all cannot\n191|\t// complete the required read either.\n192|\treader.Peers = nil\n193|\tif _, err := reader.Resolve(\"beta@peer:workstation\"); !errors.Is(err, ErrSourceNotFound) {\n194|\t\tt.Fatalf(\"unmapped alias: %v\", err)\n195|\t}\n196|\treader.Peers = []PeerIndex{{hostA, peer}}\n197|\treader.Aliases = nil\n198|\tif _, err := reader.Resolve(\"beta@id:\" + hostA); !errors.Is(err, ErrSourceReadFailed) {\n199|\t\tt.Fatalf(\"handle-less explicit host: %v\", err)\n200|\t}\n201|}\n202|\n203|func TestResolveBareIdentityUnion(t *testing.T) {\n204|\tlocal, _ := repository(t)\n205|\tpeer, _ := repository(t)\n206|\tcreate(t, local, idA, \"alpha\")\n207|\t// A UUID-shaped local name wins over the UUID identity on the bare\n208|\t// path, while \"id:\" bypasses names for the durable identity.\n209|\tcreate(t, local, idC, idB)\n210|\tcreate(t, peer, idB, \"remote\")\n211|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n212|\tbyName, err := reader.Resolve(idB)\n213|\tif err != nil || byName.SessionID != idC || byName.PeerHostID != \"\" {\n214|\t\tt.Fatalf(\"bare name-first: %+v %v\", byName, err)\n215|\t}\n216|\tbyID, err := reader.Resolve(\"id:\" + idB)\n217|\tif err != nil || byID.SessionID != idB || byID.PeerHostID != hostA {\n218|\t\tt.Fatalf(\"id: bypass: %+v %v\", byID, err)\n219|\t}\n220|\t// Replicated identical copies are one identity. While the local\n221|\t// host identity is unknown the local copy wins; once configured,\n222|\t// the bytewise smallest holder wins deterministically.\n223|\tcreate(t, peer, idA, \"alpha\")\n224|\tidentical, err := reader.Resolve(\"id:\" + idA)\n225|\tif err != nil || identical.SessionID != idA || identical.PeerHostID != \"\" {\n226|\t\tt.Fatalf(\"replicated unknown-local: %+v %v\", identical, err)\n227|\t}\n228|\treader.LocalHostID = hostB\n229|\ttiebreak, err := reader.Resolve(\"id:\" + idA)\n230|\tif err != nil || tiebreak.SessionID != idA || tiebreak.PeerHostID != hostA {\n231|\t\tt.Fatalf(\"replicated tie break: %+v %v\", tiebreak, err)\n232|\t}\n233|\t// Disagreeing copies of one UUID are inconsistent authority, not an\n234|\t// ambiguity and not a silent first match.\n235|\tother, _ := repository(t)\n236|\tcreate(t, other, idA, \"renamed\")\n237|\treader.Peers = []PeerIndex{{hostA, peer}, {hostC, other}}\n238|\treader.AllowlistedPeerIDs = []string{hostA, hostC}\n239|\tif _, err := reader.Resolve(\"id:\" + idA); !errors.Is(err, sessstate.ErrIntegrity) {\n240|\t\tt.Fatalf(\"disagreeing copies: %v\", err)\n241|\t}\n242|\tif _, err := reader.Resolve(\"renamed\"); !errors.Is(err, sessstate.ErrIntegrity) {\n243|\t\tt.Fatalf(\"disagreeing name win: %v\", err)\n244|\t}\n245|\t// A unique local name win never consults lower tiers, so an\n246|\t// unreadable peer copy behind it is not a conflict.\n247|\treader.Peers = []PeerIndex{{hostA, other}}\n248|\tif _, err := reader.Resolve(\"alpha\"); err != nil {\n249|\t\tt.Fatalf(\"local win with divergent peer copy: %v\", err)\n250|\t}\n251|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
