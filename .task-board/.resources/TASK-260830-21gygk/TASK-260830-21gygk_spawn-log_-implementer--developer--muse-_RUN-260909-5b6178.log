undaryCommit, BoundaryRetry, BoundaryRecovery, BoundaryTransportResume},\n523|\t\tActionDiff:        {BoundaryProjection, BoundaryRetry},\n524|\t\tActionMaterialize: {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n525|\t\tActionSetProfile:  {BoundaryPreEffect, BoundaryFencing, BoundaryCommit, BoundaryRetry, BoundaryRecovery},\n526|\t\tActionLogs:        {BoundaryProjection, BoundaryRetry, BoundaryRemoteDispatch, BoundaryRemoteAdmission, BoundaryTransportResume},\n527|\t\tActionCancel:      {BoundaryProjection},\n528|\t}\n529|\tif len(planBoundaries) != len(matrix) {\n530|\t\tt.Fatalf(\"boundary table covers %d actions, want %d\", len(planBoundaries), len(matrix))\n531|\t}\n532|\tfor action, want := range matrix {\n533|\t\tgot, ok := BoundariesFor(action)\n534|\t\tif !ok || !reflect.DeepEqual(got, want) {\n535|\t\t\tt.Fatalf(\"BoundariesFor(%q) = %v, %v\", action, got, ok)\n536|\t\t}\n537|\t}\n538|\tfor _, action := range []string{\"\", \"launch\", \"STATUS\", \"attach --local\"} {\n539|\t\tif _, ok := BoundariesFor(action); ok {\n540|\t\t\tt.Fatalf(\"BoundariesFor(%q) admitted\", action)\n541|\t\t}\n542|\t}\n543|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c865","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":653,"recorded_at":1780531400001301,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"call_id":"call_01a0884357ad78b1adc6390607b47ffa","text":"Read text file `internal/sessquery/query_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"reflect\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n12|)\n13|\n14|func TestResolvePinnedPrecedence(t *testing.T) {\n15|\tlocal, _ := repository(t)\n16|\tpeer, _ := repository(t)\n17|\tcreate(t, local, idA, \"Local\")\n18|\tcreate(t, peer, idB, idA)\n19|\treader := &Reader{Local: local, AllowlistedPeerIDs: []string{hostA}, Peers: []PeerIndex{{hostA, peer}}}\n20|\tfor _, row := range []struct{ selector, id, peer string }{\n21|\t\t{\"Local\", idA, \"\"}, {idA, idB, hostA}, {idB, idB, hostA},\n22|\t} {\n23|\t\tgot, err := reader.Resolve(row.selector)\n24|\t\tif err != nil || got.SessionID != row.id || got.PeerHostID != row.peer {\n25|\t\t\tt.Fatalf(\"Resolve(%q) = %+v, %v\", row.selector, got, err)\n26|\t\t}\n27|\t\tstatus, err := reader.Status(row.selector)\n28|\t\tif err != nil || status.Projection.SessionID != row.id {\n29|\t\t\tt.Fatalf(\"Status(%q) = %+v, %v\", row.selector, status, err)\n30|\t\t}\n31|\t}\n32|\t// Local exact name wins even if a peer learned the same name for another ID.\n33|\tother, _ := repository(t)\n34|\tcreate(t, other, idB, \"Local\")\n35|\treader.Peers = []PeerIndex{{hostA, other}}\n36|\tgot, err := reader.Resolve(\"Local\")\n37|\tif err != nil || got.SessionID != idA || got.PeerHostID != \"\" {\n38|\t\tt.Fatalf(\"local priority: %+v %v\", got, err)\n39|\t}\n40|\t// A local UUID-shaped name also wins over the UUID identity.\n41|\tlocal2, _ := repository(t)\n42|\tcreate(t, local2, idA, \"Original\")\n43|\tcreate(t, local2, idB, idA)\n44|\tgot, err = (&Reader{Local: local2}).Resolve(idA)\n45|\tif err != nil || got.SessionID != idB {\n46|\t\tt.Fatalf(\"local name before UUID: %+v %v\", got, err)\n47|\t}\n48|}\n49|\n50|func TestResolveExactNamesAndASCIICollisions(t *testing.T) {\n51|\tfor _, peers := range []bool{false, true} {\n52|\t\tt.Run(map[bool]string{false: \"local\", true: \"peers\"}[peers], func(t *testing.T) {\n53|\t\t\tlocal, _ := repository(t)\n54|\t\t\tsource := local\n55|\t\t\tr := &Reader{Local: local}\n56|\t\t\tif peers {\n57|\t\t\t\tsource, _ = repository(t)\n58|\t\t\t\tr.AllowlistedPeerIDs = []string{hostA}\n59|\t\t\t\tr.Peers = []PeerIndex{{hostA, source}}\n60|\t\t\t}\n61|\t\t\tcreate(t, source, idA, \"Az-09._\")\n62|\t\t\tfor _, query := range []string{\"az-09._\", \"AZ-09._\", \"Ａz-09._\", \"no-such-session\", \"host/Name\"} {\n63|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrNotFound) {\n64|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n65|\t\t\t\t}\n66|\t\t\t}\n67|\t\t\t// v0.6.0 Section 14.7.1 decides the qualified-selector\n68|\t\t\t// grammar the partial leaf left open: \"Name@host\" is a\n69|\t\t\t// qualified selector with an unknown source, and the empty\n70|\t\t\t// argument carries no key, so both are invalid arguments,\n71|\t\t\t// never silent names. \"host/Name\" carries no \"@\" and stays\n72|\t\t\t// not found.\n73|\t\t\tfor _, query := range []string{\"Name@host\", \"\", \"Az-09._@unknown\", \"Az-09._@\", \"@local\"} {\n74|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrInvalidArgument) {\n75|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n76|\t\t\t\t}\n77|\t\t\t}\n78|\t\t\tif _, err := r.Resolve(\"Az-09._\"); err != nil {\n79|\t\t\t\tt.Fatal(err)\n80|\t\t\t}\n81|\t\t\tcreate(t, source, idB, \"aZ-09._\")\n82|\t\t\tfor _, query := range []string{\"Az-09._\", \"aZ-09._\", \"AZ-09._\"} {\n83|\t\t\t\tif _, err := r.Resolve(query); !errors.Is(err, ErrAmbiguous) {\n84|\t\t\t\t\tt.Fatalf(\"%q: %v\", query, err)\n85|\t\t\t\t}\n86|\t\t\t\tif _, err := r.Status(query); !errors.Is(err, ErrAmbiguous) {\n87|\t\t\t\t\tt.Fatalf(\"status %q: %v\", query, err)\n88|\t\t\t\t}\n89|\t\t\t}\n90|\t\t})\n91|\t}\n92|}\n93|\n94|func TestResolveAllowlistAndReadFailures(t *testing.T) {\n95|\tlocal, root := repository(t)\n96|\tpeer, peerRoot := repository(t)\n97|\tcreate(t, local, idA, \"Local\")\n98|\tcreate(t, peer, idB, idA)\n99|\tr := &Reader{Local: local, Peers: []PeerIndex{{hostA, peer}}}\n100|\tgot, err := r.Resolve(idA)\n101|\tif err != nil || got.SessionID != idA {\n102|\t\tt.Fatalf(\"unallowlisted peer affected UUID: %+v %v\", got, err)\n103|\t}\n104|\t// No learned index is absence; a known index whose read fails is not.\n105|\tr.AllowlistedPeerIDs = []string{hostB}\n106|\tgot, err = r.Resolve(idA)\n107|\tif err != nil || got.SessionID != idA {\n108|\t\tt.Fatalf(\"absent learned index: %+v %v\", got, err)\n109|\t}\n110|\tr.AllowlistedPeerIDs = []string{hostA}\n111|\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n112|\t\tt.Fatal(err)\n113|\t}\n114|\tif _, err := r.Resolve(idA); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n115|\t\tt.Fatalf(\"failed peer read fell through: %v\", err)\n116|\t}\n117|\t// Local exact name does not depend on lower-tier reads.\n118|\tif _, err := r.Resolve(\"Local\"); err != nil {\n119|\t\tt.Fatal(err)\n120|\t}\n121|\tif err := os.WriteFile(filepath.Join(peerRoot, \"sessions\"), []byte(\"not a directory\"), 0600); err != nil {\n122|\t\tt.Fatal(err)\n123|\t}\n124|\tif _, err := r.Status(idA); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n125|\t\tt.Fatalf(\"non-directory read: %v\", err)\n126|\t}\n127|\tr.Peers = []PeerIndex{{hostA, nil}}\n128|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrUnavailable) {\n129|\t\tt.Fatalf(\"nil learned index: %v\", err)\n130|\t}\n131|\tr.Peers = []PeerIndex{{hostA, nil}, {hostA, peer}}\n132|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrUnavailable) {\n133|\t\tt.Fatalf(\"duplicate learned index: %v\", err)\n134|\t}\n135|\tif err := os.RemoveAll(filepath.Join(root, \"sessions\")); err != nil {\n136|\t\tt.Fatal(err)\n137|\t}\n138|\tif _, err := r.List(); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n139|\t\tt.Fatalf(\"missing local root: %v\", err)\n140|\t}\n141|\tif _, err := r.Resolve(\"Local\"); !errors.Is(err, sessrepo.ErrRepositoryPath) {\n142|\t\tt.Fatalf(\"missing root became not found: %v\", err)\n143|\t}\n144|}\n145|\n146|func TestResolvePeerOrderAndReplicatedIdentity(t *testing.T) {\n147|\tlocal, _ := repository(t)\n148|\ta, _ := repository(t)\n149|\tb, _ := repository(t)\n150|\tcreate(t, a, idA, \"Shared\")\n151|\tcreate(t, b, idA, \"Shared\")\n152|\tr := &Reader{Local: local, AllowlistedPeerIDs: []string{hostB, hostA, hostB}, Peers: []PeerIndex{{hostB, b}, {hostA, a}}}\n153|\tfirst, err := r.Resolve(\"Shared\")\n154|\tif err != nil || first.PeerHostID != hostA {\n155|\t\tt.Fatalf(\"replicated identity: %+v %v\", first, err)\n156|\t}\n157|\tr.Peers[0], r.Peers[1] = r.Peers[1], r.Peers[0]\n158|\tsecond, err := r.Resolve(\"Shared\")\n159|\tif err != nil || !reflect.DeepEqual(first, second) {\n160|\t\tt.Fatalf(\"permutation changed selection: %+v %v\", second, err)\n161|\t}\n162|\tcreate(t, b, idB, \"sHARED\")\n163|\tif _, err := r.Resolve(\"Shared\"); !errors.Is(err, ErrAmbiguous) {\n164|\t\tt.Fatalf(\"cross-peer collision: %v\", err)\n165|\t}\n166|}\n167|\n168|func TestListStatusDerivedFactsAndStableOrder(t *testing.T) {\n169|\trepo, _ := repository(t)\n170|\tcreate(t, repo, idB, \"Zed\")\n171|\tref := create(t, repo, idA, \"Alpha\")\n172|\tappendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n173|\tr := &Reader{Local: repo, LocalHostID: hostA}\n174|\tlist, err := r.List()\n175|\tif err != nil || len(list) != 2 {\n176|\t\tt.Fatalf(\"List: %+v %v\", list, err)\n177|\t}\n178|\tif list[0].Projection.SessionID != idA || list[1].Projection.SessionID != idB {\n179|\t\tt.Fatalf(\"order: %+v\", list)\n180|\t}\n181|\tp := list[0].Projection\n182|\tif p.Name != \"Alpha\" || p.Kind != \"direct\" || p.Provider.ID != \"codex\" || p.State != sessstate.StateCreating || p.OwnerHostID != hostA || p.LocalRole != \"owner\" || p.Winner.LeaseID != lease || p.Winner.Epoch != 1 {\n183|\t\tt.Fatalf(\"derived summary: %+v\", p)\n184|\t}\n185|\tunknown := list[1].Projection\n186|\tif unknown.OwnerHostID != \"\" || unknown.LocalRole != \"\" || !unknown.Winner.IsZero() {\n187|\t\tt.Fatalf(\"invented unknown owner: %+v\", unknown)\n188|\t}\n189|\tfor _, selector := range []string{\"Alpha\", idA} {\n190|\t\tstatus, err := r.Status(selector)\n191|\t\tif err != nil || !reflect.DeepEqual(status, list[0]) {\n192|\t\t\tt.Fatalf(\"status disagrees: %+v %v\", status, err)\n193|\t\t}\n194|\t}\n195|\tagain, err := r.List()\n196|\tif err != nil || !reflect.DeepEqual(list, again) {\n197|\t\tt.Fatalf(\"read is not idempotent: %+v %v\", again, err)\n198|\t}\n199|\tr.LocalHostID = hostB\n200|\tstatus, err := r.Status(idA)\n201|\tif err != nil || status.Projection.LocalRole != \"replica\" {\n202|\t\tt.Fatalf(\"replica: %+v %v\", status, err)\n203|\t}\n204|}\n205|\n206|func TestParkedReadRecoveryAndMissingVsMalformed(t *testing.T) {\n207|\trepo, root := repository(t)\n208|\traw := record(t, idA, \"Parked\")\n209|\trepo.AfterCreateStep = func(step sessrepo.CreateStep) error {\n210|\t\tif step == sessrepo.CreateStepRecord {\n211|\t\t\treturn errors.New(\"crash\")\n212|\t\t}\n213|\t\treturn nil\n214|\t}\n215|\tif _, err := repo.CreateSession(raw); err == nil {\n216|\t\tt.Fatal(\"fault did not fire\")\n217|\t}\n218|\tcreateHealthy := func() { repo.AfterCreateStep = nil; create(t, repo, idB, \"Healthy\") }\n219|\tcreateHealthy()\n220|\tr := &Reader{Local: repo}\n221|\tlist, err := r.List()\n222|\tif err != nil || len(list) != 2 || list[0].Projection.Parked == nil {\n223|\t\tt.Fatalf(\"parked omitted: %+v %v\", list, err)\n224|\t}\n225|\tif _, err := r.Resolve(\"Parked\"); !errors.Is(err, ErrNotFound) {\n226|\t\tt.Fatalf(\"parked routed: %v\", err)\n227|\t}\n228|\tif _, err := r.Resolve(idA); !errors.Is(err, ErrNotFound) {\n229|\t\tt.Fatalf(\"parked UUID routed: %v\", err)\n230|\t}\n231|\tif _, err := r.Resolve(\"Healthy\"); err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tparked, err := r.InspectLocal(idA)\n235|\tif err != nil || parked.Projection.Parked == nil || parked.Projection.Parked.RetryHint == \"\" {\n236|\t\tt.Fatalf(\"parked status: %+v %v\", parked, err)\n237|\t}\n238|\tif _, err := repo.CreateSession(raw); err != nil {\n239|\t\tt.Fatal(err)\n240|\t}\n241|\tif _, err := r.Status(\"Parked\"); err != nil {\n242|\t\tt.Fatal(err)\n243|\t}\n244|\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), []byte(\"malformed\"), 0600); err != nil {\n245|\t\tt.Fatal(err)\n246|\t}\n247|\tdamaged, err := r.InspectLocal(idA)\n248|\tif err != nil || damaged.Projection.State != sessstate.StateParked || damaged.Projection.Parked.BlockingReason == \"\" {\n249|\t\tt.Fatalf(\"malformed treated as absent: %+v %v\", damaged, err)\n250|\t}\n251|\tif _, err := r.InspectLocal(hostA); !errors.Is(err, sessstate.ErrUnknownSession) {\n252|\t\tt.Fatalf(\"missing: %v\", err)\n253|\t}\n254|}\n255|\n256|func TestReaderAbsentAndNil(t *testing.T) {\n257|\tfor _, r := range []*Reader{nil, {}} {\n258|\t\tif _, err := r.List(); !errors.Is(err, ErrUnavailable) {\n259|\t\t\tt.Fatal(err)\n260|\t\t}\n261|\t\tif _, err := r.InspectLocal(idA); !errors.Is(err, ErrUnavailable) {\n262|\t\t\tt.Fatal(err)\n263|\t\t}\n264|\t\tif _, err := r.Status(idA); !errors.Is(err, ErrUnavailable) {\n265|\t\t\tt.Fatal(err)\n266|\t\t}\n267|\t}\n268|\trepo, _ := repository(t)\n269|\trows, err := (&Reader{Local: repo}).List()\n270|\tif err != nil || rows == nil || len(rows) != 0 {\n271|\t\tt.Fatalf(\"empty: %+v %v\", rows, err)\n272|\t}\n273|\tif _, err := (&Reader{Local: repo}).Status(idA); !errors.Is(err, ErrNotFound) {\n274|\t\tt.Fatal(err)\n275|\t}\n276|}\n277|\n278|func TestResolveExcludesTombstonedButListsIt(t *testing.T) {\n279|\trepo, _ := repository(t)\n280|\tref := create(t, repo, idA, \"Deleted\")\n281|\tevent := appendEvent(t, repo, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n282|\tevent = appendEvent(t, repo, idA, event, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n283|\tappendEvent(t, repo, idA, event, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n284|\tr := &Reader{Local: repo}\n285|\trows, err := r.List()\n286|\tif err != nil || len(rows) != 1 || rows[0].Projection.State != sessstate.StateTombstoned {\n287|\t\tt.Fatalf(\"tombstone lost: %+v %v\", rows, err)\n288|\t}\n289|\tfor _, selector := range []string{\"Deleted\", idA} {\n290|\t\tif _, err := r.Resolve(selector); !errors.Is(err, ErrNotFound) {\n291|\t\t\tt.Fatalf(\"tombstone routed: %v\", err)\n292|\t\t}\n293|\t}\n294|}\n295|\n296|func TestListStatusCheckpointAndProjectionFailure(t *testing.T) {\n297|\trepo, _ := repository(t)\n298|\tref := create(t, repo, idA, \"Checkpointed\")\n299|\tprevious := ref.RecordID\n300|\trows := []struct {\n301|\t\ttyp     string\n302|\t\tpayload map[string]any\n303|\t}{\n304|\t\t{\"session.created\", map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB}},\n305|\t\t{\"provider.launched\", map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"}},\n306|\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n307|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n308|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"}},\n309|\t\t{\"session.stopped\", map[string]any{\"graceful\": true, \"checkpoint_id\": zeroDigest, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true}},\n310|\t}\n311|\tfor index, row := range rows {\n312|\t\tprevious = appendEvent(t, repo, idA, previous, row.typ, index+1, row.payload)\n313|\t}\n314|\tr := &Reader{Local: repo, LocalHostID: hostA}\n315|\tstatus, err := r.Status(\"Checkpointed\")\n316|\tif err != nil || status.Projection.State != sessstate.StateStopped || !status.Projection.HasCheckpoint || status.Projection.Newest.ID != zeroDigest || status.Projection.Provider.Version != \"0.147.0\" {\n317|\t\tt.Fatalf(\"checkpoint summary: %+v %v\", status, err)\n318|\t}\n319|\tlist, err := r.List()\n320|\tif err != nil || len(list) != 1 || !reflect.DeepEqual(list[0], status) {\n321|\t\tt.Fatalf(\"checkpoint list/status disagreement: %+v %v\", list, err)\n322|\t}\n323|\t// Repository continuity admits this event; the state owner's terminal-state\n324|\t// transition gate refuses it. That failure must reach the read entry unchanged.\n325|\tappendEvent(t, repo, idA, previous, \"session.created\", 7, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n326|\tif _, err := r.List(); err == nil {\n327|\t\tt.Fatal(\"invalid projection was returned as a summary\")\n328|\t}\n329|\tif _, err := r.Status(idA); err == nil || errors.Is(err, ErrNotFound) {\n330|\t\tt.Fatalf(\"invalid projection became absence: %v\", err)\n331|\t}\n332|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
