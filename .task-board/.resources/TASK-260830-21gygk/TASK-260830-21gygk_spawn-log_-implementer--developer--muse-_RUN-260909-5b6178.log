{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c825","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":621,"recorded_at":1780531400001237,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a08843-3fb8-7800-8220-107b9a2dfda3"},"task_id":"01a08843-3fb8-7800-8220-107b9a2dfda3","event":{"kind":"output","task_id":"01a08843-3fb8-7800-8220-107b9a2dfda3","chunk":"Read text file `internal/sessquery/plan_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"reflect\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// appendEventAs chains one event under an explicit envelope lease,\n18|// unlike the epoch-1-only fixtures helper.\n19|func appendEventAs(t *testing.T, repo *sessrepo.Repository, id, predecessor, typ string, sequence int, epoch uint64, leaseID string, payload map[string]any) string {\n20|\tt.Helper()\n21|\tvalue := map[string]any{\n22|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\", \"event_id\": zeroDigest,\n23|\t\t\"subject_id\": id, \"session_id\": id, \"event_type\": typ, \"created_by_host_id\": hostA,\n24|\t\t\"lease_epoch\": epoch, \"lease_id\": leaseID, \"lease_sequence\": sequence, \"predecessors\": []string{predecessor},\n25|\t\t\"created_at\": \"2026-08-19T04:00:00.000Z\", \"payload\": payload, \"extensions\": map[string]any{},\n26|\t}\n27|\traw := identity(t, value, \"event_id\")\n28|\tref, err := repo.AppendEvent(id, raw)\n29|\tif err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\treturn ref.EventID\n33|}\n34|\n35|// copySessionDir replicates one persisted session directory byte for\n36|// byte, so two sources hold the same identity with agreeing digests.\n37|func copySessionDir(t *testing.T, srcRoot, dstRoot, sessionID string) {\n38|\tt.Helper()\n39|\tsrc := filepath.Join(srcRoot, \"sessions\", sessionID)\n40|\tdst := filepath.Join(dstRoot, \"sessions\", sessionID)\n41|\tentries, err := os.ReadDir(src)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tif err := os.MkdirAll(filepath.Join(dst, \"events\"), 0o700); err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tfor _, entry := range entries {\n49|\t\tif entry.IsDir() {\n50|\t\t\tblobs, err := os.ReadDir(filepath.Join(src, entry.Name()))\n51|\t\t\tif err != nil {\n52|\t\t\t\tt.Fatal(err)\n53|\t\t\t}\n54|\t\t\tfor _, blob := range blobs {\n55|\t\t\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name(), blob.Name()))\n56|\t\t\t\tif err != nil {\n57|\t\t\t\t\tt.Fatal(err)\n58|\t\t\t\t}\n59|\t\t\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name(), blob.Name()), bytes, 0o600); err != nil {\n60|\t\t\t\t\tt.Fatal(err)\n61|\t\t\t\t}\n62|\t\t\t}\n63|\t\t\tcontinue\n64|\t\t}\n65|\t\tbytes, err := os.ReadFile(filepath.Join(src, entry.Name()))\n66|\t\tif err != nil {\n67|\t\t\tt.Fatal(err)\n68|\t\t}\n69|\t\tif err := os.WriteFile(filepath.Join(dst, entry.Name()), bytes, 0o600); err != nil {\n70|\t\t\tt.Fatal(err)\n71|\t\t}\n72|\t}\n73|}\n74|\n75|// plannedSession builds a local session with its bootstrap event and\n76|// returns the reader, roots, record digest, and created event ID.\n77|func plannedSession(t *testing.T) (*Reader, string, sessrepo.SessionRef, string) {\n78|\tt.Helper()\n79|\tlocal, root := repository(t)\n80|\tref := create(t, local, idA, \"alpha\")\n81|\tcreated := appendEvent(t, local, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n82|\treader := &Reader{Local: local}\n83|\treturn reader, root, ref, created\n84|}\n85|\n86|func mustBuild(t *testing.T, reader *Reader, args PlanArgs) SelectionPlan {\n87|\tt.Helper()\n88|\tplan, err := reader.BuildPlan(args)\n89|\tif err != nil {\n90|\t\tt.Fatal(err)\n91|\t}\n92|\treturn plan\n93|}\n94|\n95|func mustStale(t *testing.T, err error, reason string) {\n96|\tt.Helper()\n97|\tif !errors.Is(err, ErrPlanStale) {\n98|\t\tt.Fatalf(\"error = %v, want selector_plan_stale\", err)\n99|\t}\n100|\tif !strings.Contains(err.Error(), reason) {\n101|\t\tt.Fatalf(\"error = %v, want reason %q\", err, reason)\n102|\t}\n103|}\n104|\n105|func TestBuildPlanBindsCurrentFacts(t *testing.T) {\n106|\treader, _, ref, created := plannedSession(t)\n107|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n108|\tif plan.SelectorVersion != SelectorVersion || plan.Selector != \"alpha\" || plan.SessionID != idA {\n109|\t\tt.Fatalf(\"identity: %+v\", plan)\n110|\t}\n111|\tif plan.SessionRecordID != ref.RecordID {\n112|\t\tt.Fatalf(\"record digest = %q, want %q\", plan.SessionRecordID, ref.RecordID)\n113|\t}\n114|\tif plan.SourceHostID != \"\" || plan.SourceAlias != nil {\n115|\t\tt.Fatalf(\"local source: host %q alias %+v\", plan.SourceHostID, plan.SourceAlias)\n116|\t}\n117|\tfor _, digest := range []string{plan.SourceIndexDigest, plan.ConfigurationDigest, plan.ExpectationDigest} {\n118|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n119|\t\t\tt.Fatalf(\"digest %q: %v\", digest, err)\n120|\t\t}\n121|\t}\n122|\tif plan.SourceIndexDigest == plan.ConfigurationDigest {\n123|\t\tt.Fatalf(\"index and configuration digests collide\")\n124|\t}\n125|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n126|\t\tt.Fatalf(\"lease: %+v\", plan)\n127|\t}\n128|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n129|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n130|\t}\n131|\tif plan.Action != ActionStatus || plan.DestinationHostID != nil {\n132|\t\tt.Fatalf(\"action: %+v\", plan)\n133|\t}\n134|\tif plan.ExpectationDigest != \"sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a\" {\n135|\t\tt.Fatalf(\"empty expectations digest = %q\", plan.ExpectationDigest)\n136|\t}\n137|\tagain := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n138|\tif !reflect.DeepEqual(plan, again) {\n139|\t\tt.Fatalf(\"rebuild diverged:\\n%+v\\n%+v\", plan, again)\n140|\t}\n141|\tif err := reader.Revalidate(plan); err != nil {\n142|\t\tt.Fatalf(\"fresh plan is not current: %v\", err)\n143|\t}\n144|}\n145|\n146|func TestBuildPlanPeerSourceFacts(t *testing.T) {\n147|\tlocal, _ := repository(t)\n148|\tpeer, _ := repository(t)\n149|\tcreate(t, local, idA, \"alpha\")\n150|\tref := create(t, peer, idB, \"beta\")\n151|\tcreated := appendEvent(t, peer, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n152|\treader := &Reader{\n153|\t\tLocal:              local,\n154|\t\tLocalHostID:        hostB,\n155|\t\tAllowlistedPeerIDs: []string{hostA},\n156|\t\tPeers:              []PeerIndex{{hostA, peer}},\n157|\t\tAliases:            map[string]string{hostA: \"workstation\"},\n158|\t}\n159|\tplan := mustBuild(t, reader, PlanArgs{\n160|\t\tSelector:     \"beta@peer:workstation\",\n161|\t\tAction:       ActionAttach,\n162|\t\tDestination:  hostB,\n163|\t\tExpectations: []byte(`{\"checkpoint_id\":null}`),\n164|\t})\n165|\tif plan.SourceHostID != hostA || plan.SourceAlias == nil || *plan.SourceAlias != \"workstation\" {\n166|\t\tt.Fatalf(\"source: %+v\", plan)\n167|\t}\n168|\tif plan.SessionID != idB || plan.SessionRecordID != ref.RecordID {\n169|\t\tt.Fatalf(\"identity: %+v\", plan)\n170|\t}\n171|\tif plan.LeaseEpoch != 1 || plan.LeaseID != lease || plan.OwnerHostID != hostA {\n172|\t\tt.Fatalf(\"lease: %+v\", plan)\n173|\t}\n174|\tif !reflect.DeepEqual(plan.AuthorityHeads, []string{created}) {\n175|\t\tt.Fatalf(\"heads: %+v\", plan.AuthorityHeads)\n176|\t}\n177|\tif plan.DestinationHostID == nil || *plan.DestinationHostID != hostB {\n178|\t\tt.Fatalf(\"destination: %+v\", plan)\n179|\t}\n180|\tif err := reader.Revalidate(plan); err != nil {\n181|\t\tt.Fatalf(\"fresh peer plan is not current: %v\", err)\n182|\t}\n183|}\n184|\n185|func TestBuildPlanRecordOnlySessionBindsEmptyLease(t *testing.T) {\n186|\tlocal, _ := repository(t)\n187|\tcreate(t, local, idA, \"alpha\")\n188|\treader := &Reader{Local: local}\n189|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n190|\t// A record without any valid lease observes no winning lease: the\n191|\t// triple stays empty together, never a placeholder. Recovery of\n192|\t// this interrupted prefix belongs to the bootstrap leaf.\n193|\tif plan.LeaseEpoch != 0 || plan.LeaseID != \"\" || plan.OwnerHostID != \"\" {\n194|\t\tt.Fatalf(\"invented lease: %+v\", plan)\n195|\t}\n196|\tif len(plan.AuthorityHeads) != 0 {\n197|\t\tt.Fatalf(\"heads without events: %+v\", plan.AuthorityHeads)\n198|\t}\n199|\tif err := reader.Revalidate(plan); err != nil {\n200|\t\tt.Fatalf(\"record-only plan is not current: %v\", err)\n201|\t}\n202|}\n203|\n204|func TestBuildPlanArgumentGates(t *testing.T) {\n205|\treader, _, _, _ := plannedSession(t)\n206|\tfor _, args := range []PlanArgs{\n207|\t\t{Selector: \"alpha\", Action: \"launch\"},\n208|\t\t{Selector: \"alpha\", Action: \"\"},\n209|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: \"not-a-uuid\"},\n210|\t\t{Selector: \"alpha\", Action: ActionStatus, Destination: lease},\n211|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`{bad`)},\n212|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`[1]`)},\n213|\t\t{Selector: \"alpha\", Action: ActionStatus, Expectations: []byte(`\"str\"`)},\n214|\t\t{Selector: \"alpha@unknown\", Action: ActionStatus},\n215|\t\t{Selector: \"\", Action: ActionStatus},\n216|\t} {\n217|\t\tif _, err := reader.BuildPlan(args); !errors.Is(err, ErrInvalidArgument) {\n218|\t\t\tt.Fatalf(\"BuildPlan(%+v) = %v, want invalid_arguments\", args, err)\n219|\t\t}\n220|\t}\n221|\tif _, err := reader.BuildPlan(PlanArgs{Selector: \"alpha\"}); !errors.Is(err, ErrInvalidArgument) {\n222|\t\tt.Fatalf(\"missing action: %v\", err)\n223|\t}\n224|}\n225|\n226|func TestPlanDigestAndMarshalRoundTrip(t *testing.T) {\n227|\treader, _, _, _ := plannedSession(t)\n228|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionDiff})\n229|\tfirst, err := plan.Digest()\n230|\tif err != nil {\n231|\t\tt.Fatal(err)\n232|\t}\n233|\tsecond, err := plan.Digest()\n234|\tif err != nil || first != second {\n235|\t\tt.Fatalf(\"digest unstable: %q %q %v\", first, second, err)\n236|\t}\n237|\traw, err := plan.Marshal()\n238|\tif err != nil {\n239|\t\tt.Fatal(err)\n240|\t}\n241|\tparsed, err := ParsePlan(raw)\n242|\tif err != nil {\n243|\t\tt.Fatal(err)\n244|\t}\n245|\tif !reflect.DeepEqual(plan, parsed) {\n246|\t\tt.Fatalf(\"round trip diverged:\\n%+v\\n%+v\", plan, parsed)\n247|\t}\n248|\t// Tampering with any member breaks the locally verified digest.\n249|\tvar wire map[string]any\n250|\tif err := json.Unmarshal(raw, &wire); err != nil {\n251|\t\tt.Fatal(err)\n252|\t}\n253|\twire[\"action\"] = ActionAttach\n254|\ttampered, err := json.Marshal(wire)\n255|\tif err != nil {\n256|\t\tt.Fatal(err)\n257|\t}\n258|\tif _, err := ParsePlan(tampered); !errors.Is(err, ErrInvalidArgument) {\n259|\t\tt.Fatalf(\"tampered plan parsed: %v\", err)\n260|\t}\n261|\tif _, err := ParsePlan([]byte(`{broken`)); !errors.Is(err, ErrInvalidArgument) {\n262|\t\tt.Fatalf(\"malformed encoding: %v\", err)\n263|\t}\n264|\t// A valid persisted encoding is never authority by itself: current\n265|\t// facts still decide through Revalidate.\n266|\traw, err = plan.Marshal()\n267|\tif err != nil {\n268|\t\tt.Fatal(err)\n269|\t}\n270|\tparsed, err = ParsePlan(raw)\n271|\tif err != nil {\n272|\t\tt.Fatal(err)\n273|\t}\n274|\tappendEvent(t, reader.Local, idA, parsed.AuthorityHeads[0], \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n275|\tif err := reader.Revalidate(parsed); !errors.Is(err, ErrPlanStale) {\n276|\t\tt.Fatalf(\"persisted digest overrode current facts: %v\", err)\n277|\t}\n278|}\n279|\n280|func TestRevalidateDetectsEachFactChange(t *testing.T) {\n281|\tt.Run(\"same lease event changes heads\", func(t *testing.T) {\n282|\t\treader, _, _, _ := plannedSession(t)\n283|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n284|\t\ttail := plan.AuthorityHeads[0]\n285|\t\tappendEvent(t, reader.Local, idA, tail, \"session.idle\", 2, map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true})\n286|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n287|\t})\n288|\tt.Run(\"successor lease changes winner\", func(t *testing.T) {\n289|\t\treader, _, _, created := plannedSession(t)\n290|\t\tlaunched := appendEvent(t, reader.Local, idA, created, \"provider.launched\", 2, map[string]any{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"execution_profile\": \"yolo\", \"profile_source_event_id\": nil, \"profile_mapping\": \"default\"})\n291|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n292|\t\tappendEventAs(t, reader.Local, idA, launched, \"lease.transferred\", 1, 2, leaseB, map[string]any{\n293|\t\t\t\"operation_id\": hostB, \"from_host_id\": hostA, \"to_host_id\": hostA,\n294|\t\t\t\"predecessor_lease_id\": lease, \"new_lease_id\": leaseB,\n295|\t\t})\n296|\t\tmustStale(t, reader.Revalidate(plan), \"winning lease changed\")\n297|\t})\n298|\tt.Run(\"record replacement changes digest\", func(t *testing.T) {\n299|\t\treader, root, _, _ := plannedSession(t)\n300|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n301|\t\tif err := os.WriteFile(filepath.Join(root, \"sessions\", idA, \"record.json\"), record(t, idA, \"renamed\"), 0o600); err != nil {\n302|\t\t\tt.Fatal(err)\n303|\t\t}\n304|\t\tmustStale(t, reader.Revalidate(plan), \"session record changed\")\n305|\t})\n306|\tt.Run(\"alias remap changes binding\", func(t *testing.T) {\n307|\t\tlocal, _ := repository(t)\n308|\t\trepoA, rootA := repository(t)\n309|\t\trepoB, rootB := repository(t)\n310|\t\tref := create(t, repoA, idA, \"shared\")\n311|\t\tappendEvent(t, repoA, idA, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n312|\t\tcopySessionDir(t, rootA, rootB, idA)\n313|\t\treader := &Reader{\n314|\t\t\tLocal:              local,\n315|\t\t\tAllowlistedPeerIDs: []string{hostA, hostB},\n316|\t\t\tPeers:              []PeerIndex{{hostA, repoA}, {hostB, repoB}},\n317|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n318|\t\t}\n319|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"shared@peer:ws\", Action: ActionStatus})\n320|\t\tif plan.SourceHostID != hostA {\n321|\t\t\tt.Fatalf(\"source: %+v\", plan)\n322|\t\t}\n323|\t\treader.Aliases = map[string]string{hostB: \"ws\"}\n324|\t\tmustStale(t, reader.Revalidate(plan), \"source binding changed\")\n325|\t})\n326|\tt.Run(\"unrelated mapping change changes configuration\", func(t *testing.T) {\n327|\t\treader, _, _, _ := plannedSession(t)\n328|\t\tpeer, _ := repository(t)\n329|\t\treader.Peers = []PeerIndex{{hostA, peer}}\n330|\t\treader.AllowlistedPeerIDs = []string{hostA}\n331|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n332|\t\treader.Aliases = map[string]string{hostA: \"ws\"}\n333|\t\tmustStale(t, reader.Revalidate(plan), \"configuration changed\")\n334|\t})\n335|\tt.Run(\"revocation refuses allowlist\", func(t *testing.T) {\n336|\t\tlocal, _ := repository(t)\n337|\t\tpeer, _ := repository(t)\n338|\t\tcreate(t, local, idA, \"alpha\")\n339|\t\tcreate(t, peer, idB, \"beta\")\n340|\t\treader := &Reader{\n341|\t\t\tLocal:              local,\n342|\t\t\tAllowlistedPeerIDs: []string{hostA},\n343|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n344|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n345|\t\t}\n346|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n347|\t\treader.AllowlistedPeerIDs = nil\n348|\t\terr := reader.Revalidate(plan)\n349|\t\tif !errors.Is(err, ErrPeerNotAllowlisted) {\n350|\t\t\tt.Fatalf(\"revocation = %v, want peer_not_allowlisted\", err)\n351|\t\t}\n352|\t})\n353|\tt.Run(\"tombstone invalidates live plan\", func(t *testing.T) {\n354|\t\treader, _, ref, created := plannedSession(t)\n355|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n356|\t\tfailed := appendEvent(t, reader.Local, idA, created, \"session.failed\", 2, map[string]any{\"error_code\": \"E_LAUNCH\", \"retryable\": true, \"operation_id\": nil})\n357|\t\t_ = ref\n358|\t\tappendEvent(t, reader.Local, idA, failed, \"session.tombstoned\", 3, map[string]any{\"tombstone_id\": zeroDigest})\n359|\t\tmustStale(t, reader.Revalidate(plan), \"authority heads changed\")\n360|\t})\n361|\tt.Run(\"deletion empties selection\", func(t *testing.T) {\n362|\t\treader, root, _, _ := plannedSession(t)\n363|\t\t// A surviving sibling keeps the index readable, so only the\n364|\t\t// absence check can report the planned identity: substituting\n365|\t\t// the sibling must never validate.\n366|\t\tcreate(t, reader.Local, idB, \"bravo\")\n367|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n368|\t\tif err := os.RemoveAll(filepath.Join(root, \"sessions\", idA)); err != nil {\n369|\t\t\tt.Fatal(err)\n370|\t\t}\n371|\t\tmustStale(t, reader.Revalidate(plan), \"selection absent from source index\")\n372|\t})\n373|\tt.Run(\"unrelated session change changes index\", func(t *testing.T) {\n374|\t\treader, _, _, _ := plannedSession(t)\n375|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n376|\t\tref := create(t, reader.Local, idB, \"bravo\")\n377|\t\tappendEvent(t, reader.Local, idB, ref.RecordID, \"session.created\", 1, map[string]any{\"session_record_id\": ref.RecordID, \"bootstrap_operation_id\": hostA, \"first_checkpoint_operation_id\": hostB})\n378|\t\tmustStale(t, reader.Revalidate(plan), \"source index changed\")\n379|\t})\n380|\tt.Run(\"invalid projection propagates\", func(t *testing.T) {\n381|\t\tlocal, _ := repository(t)\n382|\t\tref := create(t, local, idA, \"alpha\")\n383|\t\treader := &Reader{Local: local}\n384|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n385|\t\t// A checkpoint before any bootstrap is continuity-admitted by\n386|\t\t// the repository and refused by the state owner: the failure\n387|\t\t// reaches revalidation unchanged, never as absence or staleness.\n388|\t\tappendEvent(t, local, idA, ref.RecordID, \"checkpoint.created\", 1, map[string]any{\"checkpoint_id\": zeroDigest, \"kind\": \"manual\"})\n389|\t\terr := reader.Revalidate(plan)\n390|\t\tif err == nil || errors.Is(err, ErrPlanStale) || errors.Is(err, ErrNotFound) {\n391|\t\t\tt.Fatalf(\"projection failure became %v\", err)\n392|\t\t}\n393|\t\tif !errors.Is(err, sessstate.ErrInvalidTransition) {\n394|\t\t\tt.Fatalf(\"projection failure = %v\", err)\n395|\t\t}\n396|\t})\n397|}\n398|\n399|func TestRevalidateReadFailures(t *testing.T) {\n400|\tt.Run(\"peer read failure keeps class\", func(t *testing.T) {\n401|\t\tlocal, _ := repository(t)\n402|\t\tpeer, peerRoot := repository(t)\n403|\t\tcreate(t, local, idA, \"alpha\")\n404|\t\tcreate(t, peer, idB, \"beta\")\n405|\t\treader := &Reader{\n406|\t\t\tLocal:              local,\n407|\t\t\tAllowlistedPeerIDs: []string{hostA},\n408|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n409|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n410|\t\t}\n411|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n412|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n413|\t\t\tt.Fatal(err)\n414|\t\t}\n415|\t\terr := reader.Revalidate(plan)\n416|\t\tif !errors.Is(err, ErrSourceReadFailed) || !errors.Is(err, sessrepo.ErrRepositoryPath) {\n417|\t\t\tt.Fatalf(\"peer revalidation failure = %v\", err)\n418|\t\t}\n419|\t})\n420|\tt.Run(\"local read failure keeps repository error\", func(t *testing.T) {\n421|\t\treader, root, _, _ := plannedSession(t)\n422|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n423|\t\tif err := os.Rename(filepath.Join(root, \"sessions\"), filepath.Join(root, \"saved\")); err != nil {\n424|\t\t\tt.Fatal(err)\n425|\t\t}\n426|\t\terr := reader.Revalidate(plan)\n427|\t\tif !errors.Is(err, sessrepo.ErrRepositoryPath) {\n428|\t\t\tt.Fatalf(\"local revalidation failure = %v\", err)\n429|\t\t}\n430|\t\tif errors.Is(err, ErrSourceReadFailed) {\n431|\t\t\tt.Fatalf(\"local failure misclassified as remote: %v\", err)\n432|\t\t}\n433|\t})\n434|\tt.Run(\"never falls back to another source\", func(t *testing.T) {\n435|\t\tlocal, _ := repository(t)\n436|\t\tpeer, peerRoot := repository(t)\n437|\t\tcreate(t, local, idA, \"beta\")\n438|\t\tcreate(t, peer, idB, \"beta\")\n439|\t\treader := &Reader{\n440|\t\t\tLocal:              local,\n441|\t\t\tAllowlistedPeerIDs: []string{hostA},\n442|\t\t\tPeers:              []PeerIndex{{hostA, peer}},\n443|\t\t\tAliases:            map[string]string{hostA: \"ws\"},\n444|\t\t}\n445|\t\tplan := mustBuild(t, reader, PlanArgs{Selector: \"beta@peer:ws\", Action: ActionStatus})\n446|\t\tif err := os.Rename(filepath.Join(peerRoot, \"sessions\"), filepath.Join(peerRoot, \"saved\")); err != nil {\n447|\t\t\tt.Fatal(err)\n448|\t\t}\n449|\t\t// The local index holds a live \"beta\" under another UUID, but\n450|\t\t// revalidation rereads the plan source only: no substitution.\n451|\t\tif err := reader.Revalidate(plan); !errors.Is(err, ErrSourceReadFailed) {\n452|\t\t\tt.Fatalf(\"revalidation fell back: %v\", err)\n453|\t\t}\n454|\t})\n455|}\n456|\n457|func TestRevalidateMalformedPlans(t *testing.T) {\n458|\treader, _, _, _ := plannedSession(t)\n459|\tvalid := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n460|\tcases := []struct {\n461|\t\tname   string\n462|\t\tmutate func(plan *SelectionPlan)\n463|\t}{\n464|\t\t{\"version\", func(plan *SelectionPlan) { plan.SelectorVersion = \"2.0.0\" }},\n465|\t\t{\"selector\", func(plan *SelectionPlan) { plan.Selector = \"alpha@unknown\" }},\n466|\t\t{\"session\", func(plan *SelectionPlan) { plan.SessionID = \"nope\" }},\n467|\t\t{\"record\", func(plan *SelectionPlan) { plan.SessionRecordID = \"nope\" }},\n468|\t\t{\"source host\", func(plan *SelectionPlan) { plan.SourceHostID = \"nope\" }},\n469|\t\t{\"alias control\", func(plan *SelectionPlan) {\n470|\t\t\tbad := \"a\\tb\"\n471|\t\t\tplan.SourceAlias = &bad\n472|\t\t}},\n473|\t\t{\"index digest\", func(plan *SelectionPlan) { plan.SourceIndexDigest = \"nope\" }},\n474|\t\t{\"configuration digest\", func(plan *SelectionPlan) { plan.ConfigurationDigest = \"nope\" }},\n475|\t\t{\"expectation digest\", func(plan *SelectionPlan) { plan.ExpectationDigest = \"nope\" }},\n476|\t\t{\"partial lease\", func(plan *SelectionPlan) { plan.LeaseID = \"\" }},\n477|\t\t{\"epoch zero with lease\", func(plan *SelectionPlan) { plan.LeaseEpoch = 0 }},\n478|\t\t{\"epoch overflow\", func(plan *SelectionPlan) { plan.LeaseEpoch = 1 << 53 }},\n479|\t\t{\"lease shape\", func(plan *SelectionPlan) { plan.LeaseID = \"nope\" }},\n480|\t\t{\"owner shape\", func(plan *SelectionPlan) { plan.OwnerHostID = \"nope\" }},\n481|\t\t{\"head shape\", func(plan *SelectionPlan) { plan.AuthorityHeads = []string{\"nope\"} }},\n482|\t\t{\"heads unsorted\", func(plan *SelectionPlan) {\n483|\t\t\tplan.AuthorityHeads = []string{\"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\", zeroDigest}\n484|\t\t}},\n485|\t\t{\"heads duplicated\", func(plan *SelectionPlan) {\n486|\t\t\tplan.AuthorityHeads = []string{zeroDigest, zeroDigest}\n487|\t\t}},\n488|\t\t{\"action\", func(plan *SelectionPlan) { plan.Action = \"launch\" }},\n489|\t\t{\"destination\", func(plan *SelectionPlan) {\n490|\t\t\tbad := \"nope\"\n491|\t\t\tplan.DestinationHostID = &bad\n492|\t\t}},\n493|\t}\n494|\tfor _, row := range cases {\n495|\t\tt.Run(row.name, func(t *testing.T) {\n496|\t\t\tplan := valid\n497|\t\t\trow.mutate(&plan)\n498|\t\t\tif err := reader.Revalidate(plan); !errors.Is(err, ErrInvalidArgument) {\n499|\t\t\t\tt.Fatalf(\"Revalidate = %v, want invalid_arguments\", err)\n500|\t\t\t}\n(more lines below)","final_result":true}}}
