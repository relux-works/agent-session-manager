{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cddd","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":1353,"recorded_at":1780531400002701,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a08849-5770-7dd2-8191-a06ef98410f0"},"task_id":"01a08849-5770-7dd2-8191-a06ef98410f0","event":{"kind":"output","task_id":"01a08849-5770-7dd2-8191-a06ef98410f0","chunk":"edited\nchanged lines: lines 317-331\n--- original\n+++ updated\n@@\n-\t// The lease triple is all empty while no winning lease is observed;\n-\t// otherwise the epoch is a positive uint53 with a UUIDv4 lease and a\n-\t// UUIDv7 owner. Partial triples and placeholders are refused.\n-\tswitch {\n-\tcase plan.LeaseEpoch == 0 && plan.LeaseID == \"\" && plan.OwnerHostID == \"\":\n-\tcase plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling:\n-\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n-\tdefault:\n-\t\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n-\t\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n-\t\t}\n-\t\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n-\t\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n-\t\t}\n-\t}\n+\t// The lease triple is always fully bound from the same winning\n+\t// observation as the lease attestation: a positive uint53 epoch\n+\t// with a UUIDv4 lease and a UUIDv7 owner. Empty and partial\n+\t// triples, out-of-range epochs, and placeholders are refused; a\n+\t// session with no observed winning lease builds no plan.\n+\tif plan.LeaseEpoch < 1 || plan.LeaseEpoch > uint53Ceiling {\n+\t\treturn fmt.Errorf(\"%w: plan lease epoch out of range\", ErrInvalidArgument)\n+\t}\n+\tif _, err := scalar.ParseUUIDv4(plan.LeaseID); err != nil {\n+\t\treturn fmt.Errorf(\"%w: malformed plan lease ID: %v\", ErrInvalidArgument, err)\n+\t}\n+\tif _, err := scalar.ParseUUIDv7(plan.OwnerHostID); err != nil {\n+\t\treturn fmt.Errorf(\"%w: malformed plan owner host ID: %v\", ErrInvalidArgument, err)\n+\t}\n","final_result":true}}}
