{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d15d","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":1801,"recorded_at":1780531400003597,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a0884b-4c3c-7c21-9417-989cf41746cd"},"task_id":"01a0884b-4c3c-7c21-9417-989cf41746cd","event":{"kind":"output","task_id":"01a0884b-4c3c-7c21-9417-989cf41746cd","chunk":"Read text file `internal/sessquery/bounds_test.go`.\n1|package sessquery\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/cliresult\"\n8|)\n9|\n10|// This is a measured integration bound, not a successful public list claim.\n11|// Pinned Section 5.7 defines creating as a Session Record AND an\n12|// authoritative initial lease, and Section 13.1 step 2 persists the\n13|// initial Lease Record and session.created before process creation: a\n14|// record alone proves identity and provenance, never creation of an\n15|// owner or a creating lifecycle. A record-only chain is therefore an\n16|// interrupted persistence prefix awaiting the bootstrap-recovery leaf\n17|// (Section 14.7.4), not a completed bootstrap prefix, and the list\n18|// entry refuses it with selector_bootstrap_incomplete instead of\n19|// returning a row with empty owner/lease facts. The wire owner still\n20|// requires known owner/lease fields: the read layer must not invent\n21|// them to obtain green JSON, and no nullable or placeholder owner or\n22|// lease field is authorized to close the gap.\n23|func TestCreatingSummaryCannotClaimClosedCLIResult(t *testing.T) {\n24|\trepo, _ := repository(t)\n25|\tcreate(t, repo, idA, \"Creating\")\n26|\t// The production list entry refuses the interrupted prefix; no\n27|\t// partial row escapes for a caller to render.\n28|\tif _, err := (&Reader{Local: repo}).List(); !errors.Is(err, ErrBootstrapIncomplete) {\n29|\t\tt.Fatalf(\"record-only list = %v, want selector_bootstrap_incomplete\", err)\n30|\t}\n31|\tif _, err := (&Reader{Local: repo}).Status(\"Creating\"); !errors.Is(err, ErrBootstrapIncomplete) {\n32|\t\tt.Fatalf(\"record-only status = %v, want selector_bootstrap_incomplete\", err)\n33|\t}\n34|\tp := sessstate.Projection{}\n35|\t_ = p\n36|\tbody := map[string]any{\n37|\t\t\"session_id\": idA, \"name\": \"Creating\", \"kind\": \"direct\", \"provider_id\": \"codex\",\n38|\t\t\"owner_host_id\": \"\", \"owner_host_name\": \"\", \"lease_epoch\": uint64(0), \"lease_id\": \"\",\n39|\t\t\"local_role\": \"\", \"state\": \"creating\", \"newest_checkpoint_id\": nil, \"newest_checkpoint_created_at\": nil,\n40|\t\t\"workspace_status\": \"absent\", \"capabilities\": map[string]any{}, \"warnings\": []string{},\n41|\t}\n42|\t// The fixture's absent workspace is controlled only for this shape probe;\n43|\t// it is not a production observation or a default in Reader.\n44|\tif _, err := cliresult.New(cliresult.Spec{Command: cliresult.CommandList, Body: map[string]any{\n45|\t\t\"sessions\": []any{body}, \"partial\": false, \"unreachable_peer_ids\": []string{},\n46|\t}}); !errors.Is(err, cliresult.ErrInvalidResult) {\n47|\t\tt.Fatalf(\"unknown owner represented as CLI success: %v\", err)\n48|\t}\n49|}","final_result":true}}}
