Provider.ID,\n31|\t\t\"owner_host_id\": p.OwnerHostID, \"owner_host_name\": \"\", \"lease_epoch\": p.Winner.Epoch, \"lease_id\": p.Winner.LeaseID,\n32|\t\t\"local_role\": p.LocalRole, \"state\": string(p.State), \"newest_checkpoint_id\": nil, \"newest_checkpoint_created_at\": nil,\n33|\t\t\"workspace_status\": \"absent\", \"capabilities\": map[string]any{}, \"warnings\": []string{},\n34|\t}\n35|\t// The fixture's absent workspace is controlled only for this shape probe;\n36|\t// it is not a production observation or a default in Reader.\n37|\tif _, err := cliresult.New(cliresult.Spec{Command: cliresult.CommandList, Body: map[string]any{\n38|\t\t\"sessions\": []any{body}, \"partial\": false, \"unreachable_peer_ids\": []string{},\n39|\t}}); !errors.Is(err, cliresult.ErrInvalidResult) {\n40|\t\tt.Fatalf(\"unknown owner represented as CLI success: %v\", err)\n41|\t}\n42|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
