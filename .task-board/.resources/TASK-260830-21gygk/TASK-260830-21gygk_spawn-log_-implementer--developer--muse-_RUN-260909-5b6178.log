l:local,LocalHostID:hostA}\n20| t.Run(\"list\",func(t *testing.T){rows,err:=reader.List();if err==nil {t.Fatalf(\"List accepted record-only bootstrap: rows=%d epoch=%d owner=%q\",len(rows),rows[0].Projection.Winner.Epoch,rows[0].Projection.OwnerHostID)}})\n21| t.Run(\"status\",func(t *testing.T){row,err:=reader.Status(\"alpha\");if err==nil {t.Fatalf(\"Status accepted record-only bootstrap: epoch=%d owner=%q\",row.Projection.Winner.Epoch,row.Projection.OwnerHostID)}})\n22|}\n23|func TestReviewerPlanRequiresLeaseRecord(t *testing.T) {\n24| reader,_,_,_:=plannedSession(t);reader.LocalHostID=hostA\n25| plan:=mustBuild(t,reader,PlanArgs{Selector:\"alpha\",Action:ActionStatus})\n26| raw,err:=plan.Marshal();if err!=nil {t.Fatal(err)}\n27| var fields map[string]any;if err:=json.Unmarshal(raw,&fields);err!=nil {t.Fatal(err)}\n28| if _,ok:=fields[\"lease_record_id\"];!ok {t.Fatal(\"plan omits required validated lease_record_id\")}\n29|}","final_result":true}}}
