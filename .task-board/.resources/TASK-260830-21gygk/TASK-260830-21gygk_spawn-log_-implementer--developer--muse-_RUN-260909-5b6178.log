{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6b7","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":2486,"recorded_at":1780531400004967,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a08855-a107-74f0-a039-39a618220d81"},"task_id":"01a08855-a107-74f0-a039-39a618220d81","event":{"kind":"output","task_id":"01a08855-a107-74f0-a039-39a618220d81","chunk":"Read text file `internal/sessrepo/store.go`.\n(150 line(s) above)\n151|func (repository *Repository) listSessionsLocked() ([]SessionSummary, error) {\n152|\tentries, err := os.ReadDir(repository.root)\n153|\tif err != nil {\n154|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n155|\t}\n156|\tvar summaries []SessionSummary\n157|\tfor _, entry := range entries {\n158|\t\tif !entry.IsDir() {\n159|\t\t\tcontinue\n160|\t\t}\n161|\t\tview, err := repository.loadSessionLocked(entry.Name())\n162|\t\tif err != nil {\n163|\t\t\tsummaries = append(summaries, parkedSummary(repository.sessionDir(entry.Name()), entry.Name(), err))\n164|\t\t\tcontinue\n165|\t\t}\n166|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n167|\t\tif len(view.chain.Events) > 0 {\n168|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n169|\t\t}\n170|\t\tsummaries = append(summaries, summary)\n171|\t}\n172|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n173|\treturn summaries, nil\n174|}\n175|\n176|// retryHintForTornStore names the remedy when no same-operation retry can\n177|// heal: the parked bytes are not an interrupted create (the chain index is\n178|// present but the store no longer verifies), so CreateSession cannot\n179|// resume it. The operator remedy is documented in doc.go.\n180|const retryHintForTornStore = \"no CreateSession retry heals this state; see the operator remedy for parked sessions\"\n181|\n182|// parkedSummary builds the per-session parked channel for one load\n183|// failure: the session directory name is always reported, the blocking\n184|// reason names the recoverable_parked_state block with its per-session\n185|// cause, and the retry hint names the same-operation retry when one\n186|// exists. Identity members are filled from the parked record when it\n187|// still verifies; otherwise they stay empty. It reports parked state as\n188|// data and refuses nothing, so the refusal census is unchanged.\n189|func parkedSummary(directory, sessionID string, loadErr error) SessionSummary {\n190|\tsummary := SessionSummary{SessionID: sessionID, Parked: true, BlockingReason: \"recoverable_parked_state: \" + loadErr.Error()}\n191|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); os.IsNotExist(err) {\n192|\t\trecordBytes, readErr := os.ReadFile(filepath.Join(directory, \"record.json\"))\n193|\t\tif readErr != nil {\n194|\t\t\tif !os.IsNotExist(readErr) {\n195|\t\t\t\tsummary.RetryHint = retryHintForTornStore\n196|\t\t\t\treturn summary\n197|\t\t\t}\n198|\t\t\tsummary.RetryHint = retryHintForBareDirectory\n199|\t\t\treturn summary\n200|\t\t}\n201|\t\tif record, decodeErr := decodeSessionRecord(recordBytes); decodeErr == nil {\n202|\t\t\tsummary.RecordID = record.recordID\n203|\t\t\tsummary.Name = record.name\n204|\t\t\tsummary.Kind = record.kind\n205|\t\t\tsummary.ProviderID = record.provider\n206|\t\t}\n207|\t\tsummary.RetryHint = retryHintForParkedRecord\n208|\t\treturn summary\n209|\t}\n210|\tsummary.RetryHint = retryHintForTornStore\n211|\treturn summary\n212|}\n213|\n214|// asciiFold folds ASCII uppercase to lowercase and passes every other byte\n215|// through. Session names match [A-Za-z0-9][A-Za-z0-9._-]{0,63} under the\n216|// shape owner, so the fold domain is ASCII by construction and a Unicode\n217|// fold table would be an unowned duplicate, not a reuse.\n218|func asciiFold(value string) string {\n219|\tfolded := make([]byte, 0, len(value))\n220|\tfor index := 0; index < len(value); index++ {\n(more lines below)","final_result":true}}}
