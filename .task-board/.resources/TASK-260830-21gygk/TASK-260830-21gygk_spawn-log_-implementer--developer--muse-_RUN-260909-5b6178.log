{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6e9","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":2511,"recorded_at":1780531400005017,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a08855-b181-7483-8da8-fa7e2ca04b5e"},"task_id":"01a08855-b181-7483-8da8-fa7e2ca04b5e","event":{"kind":"output","task_id":"01a08855-b181-7483-8da8-fa7e2ca04b5e","chunk":"Read text file `internal/sessrepo/chain.go`.\n(255 line(s) above)\n256|func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {\n257|\tdirectory := repository.sessionDir(sessionID)\n258|\tif _, err := os.Stat(directory); err != nil {\n259|\t\treturn nil, refuse(ErrUnknownSession, \"unknown session %s\", sessionID)\n260|\t}\n261|\tchainBytes, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n262|\tif err != nil {\n263|\t\treturn nil, refuse(ErrChainCorrupt, \"read chain index for session %s: %v\", sessionID, err)\n264|\t}\n265|\tchain, err := decodeChainIndex(chainBytes)\n266|\tif err != nil {\n267|\t\treturn nil, refuse(ErrChainCorrupt, \"decode chain index for session %s: %v\", sessionID, err)\n268|\t}\n269|\trecordBytes, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n270|\tif err != nil {\n271|\t\treturn nil, refuse(ErrChainCorrupt, \"read session record for session %s: %v\", sessionID, err)\n272|\t}\n273|\trecord, err := decodeSessionRecord(recordBytes)\n274|\tif err != nil {\n275|\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify session record for session %s: %v\", sessionID, err)\n276|\t}\n277|\tif record.recordID != chain.RecordID || record.sessionID != sessionID {\n278|\t\treturn nil, refuse(ErrChainCorrupt, \"chain index does not describe stored session record for session %s\", sessionID)\n279|\t}\n280|\tevents := filepath.Join(directory, \"events\")\n281|\tfor position, indexed := range chain.Events {\n282|\t\tblob, err := os.ReadFile(filepath.Join(events, blobFileName(indexed.EventID)))\n283|\t\tif err != nil {\n284|\t\t\treturn nil, refuse(ErrChainCorrupt, \"read chained event %d for session %s: %v\", position, sessionID, err)\n285|\t\t}\n286|\t\tdigest, field, err := canonicaljson.VerifyObjectIdentity(blob)\n287|\t\tif err != nil {\n288|\t\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)\n289|\t\t}\n290|\t\tif field != canonicaljson.SelfEventID {\n291|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chained event %d for session %s carries self field %q, want event_id\", position, sessionID, string(field))\n292|\t\t}\n293|\t\tif digest.String() != indexed.EventID {\n294|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chained event %d for session %s digest %s disagrees with indexed event %s\", position, sessionID, digest.String(), indexed.EventID)\n295|\t\t}\n296|\t\tvar tail *EventSummary\n297|\t\tif position > 0 {\n298|\t\t\ttail = &chain.Events[position-1]\n299|\t\t}\n300|\t\treplay := eventView{eventID: indexed.EventID, eventType: indexed.EventType, sessionID: sessionID, leaseEpoch: indexed.LeaseEpoch, leaseID: indexed.LeaseID, leaseSeq: indexed.LeaseSequence, predecessors: indexed.Predecessors}\n301|\t\tif err := checkAppend(chain.RecordID, tail, replay); err != nil {\n302|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chain index order breaks continuity at event %d for session %s: %v\", position, sessionID, err)\n303|\t\t}\n304|\t}\n305|\treturn &sessionView{directory: directory, record: record, chain: chain}, nil\n306|}\n307|\n308|// decodeChainIndex decodes the internal chain index. It is not an AX wire\n309|// object, so the canonical owner does not validate it; member grammars\n310|// still stay with environ and scalar.\n311|func decodeChainIndex(raw []byte) (storedChain, error) {\n312|\tmembers, fault := environ.DecodeStrictObject(raw)\n313|\tif fault != nil {\n314|\t\treturn storedChain{}, fmt.Errorf(\"decode chain frame: %v\", fault)\n315|\t}\n(more lines below)","final_result":true}}}
