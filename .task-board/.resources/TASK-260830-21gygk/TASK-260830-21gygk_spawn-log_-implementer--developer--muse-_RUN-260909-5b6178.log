{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd2b","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":1264,"recorded_at":1780531400002523,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a08849-1606-78d1-9585-9bac0ad72b7d"},"task_id":"01a08849-1606-78d1-9585-9bac0ad72b7d","event":{"kind":"output","task_id":"01a08849-1606-78d1-9585-9bac0ad72b7d","chunk":"edited\nchanged lines: lines 112-120\n--- original\n+++ updated\n@@\n-\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n-\tif err != nil {\n-\t\treturn err\n-\t}\n-\tif index != plan.SourceIndexDigest {\n-\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n-\t}\n-\treturn nil\n-}\n+\tindex, err := fingerprintIndex(reader, repo, rows, sourcePeer)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif index != plan.SourceIndexDigest {\n+\t\treturn fmt.Errorf(\"%w: source index changed\", ErrPlanStale)\n+\t}\n+\treturn reader.validateAuthorityUnion(plan, config, sourcePeer)\n+}\n+\n+// validateAuthorityUnion validates the complete current authority for\n+// the pinned session UUID across every allowed source except the\n+// already validated plan source. The session is located by UUID in\n+// each source; names are never re-resolved and no selection is\n+// substituted. A non-parked copy carrying a disagreeing immutable\n+// record digest is inconsistent authority (integrity_failure, the same\n+// class Resolve reports for disagreeing copies). Authoritative\n+// tombstone evidence or a contradictory observed winning lease in\n+// another source invalidates the live plan (selector_plan_stale). A\n+// copy that observes no winning lease yet cannot contradict the bound\n+// lease and is skipped for the lease check, while its record digest\n+// still binds. Parked copies are failed observations, never evidence,\n+// and absence in a source is not contradiction. A source that must be\n+// read but cannot be read keeps its read-failure class: without the\n+// complete union the plan cannot be shown current.\n+func (reader *Reader) validateAuthorityUnion(plan SelectionPlan, config validatedConfig, sourcePeer string) error {\n+\tif sourcePeer != \"\" {\n+\t\trows, err := reader.read(reader.Local)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tif err := checkUnionCopy(plan, rows); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\tids := append([]string(nil), reader.AllowlistedPeerIDs...)\n+\tsort.Strings(ids)\n+\tfor index, id := range ids {\n+\t\tif index > 0 && id == ids[index-1] {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif id == sourcePeer {\n+\t\t\tcontinue\n+\t\t}\n+\t\trepo, peerHost, err := reader.peerRepo(id)\n+\t\tif err != nil {\n+\t\t\t// An allowlisted peer with no advertised learned index\n+\t\t\t// contributes no authority; anything else is a failed\n+\t\t\t// observation of a source that must be read.\n+\t\t\tif isAbsentPeerIndex(reader, id) {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\treturn err\n+\t\t}\n+\t\trows, err := reader.readSource(repo, peerHost)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tif err := checkUnionCopy(plan, rows); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n+\treturn nil\n+}\n+\n+// isAbsentPeerIndex reports an allowlisted peer with no advertised\n+// learned index handle at all: absence, never a failed read.\n+func isAbsentPeerIndex(reader *Reader, host string) bool {\n+\tfor _, peer := range reader.Peers {\n+\t\tif peer.HostID == host {\n+\t\t\treturn false\n+\t\t}\n+\t}\n+\treturn true\n+}\n+\n+// checkUnionCopy validates one non-plan source's rows for the pinned\n+// session UUID as validateAuthorityUnion documents.\n+func checkUnionCopy(plan SelectionPlan, rows []Summary) error {\n+\tfor _, row := range rows {\n+\t\tif row.Projection.SessionID != plan.SessionID {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif row.Projection.Parked != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif row.Projection.State == sessstate.StateTombstoned {\n+\t\t\treturn fmt.Errorf(\"%w: tombstone evidence changed\", ErrPlanStale)\n+\t\t}\n+\t\tif row.Projection.RecordID != plan.SessionRecordID {\n+\t\t\treturn fmt.Errorf(\"%w: session %s carries disagreeing record digests across sources\", sessstate.ErrIntegrity, plan.SessionID)\n+\t\t}\n+\t\tif row.Projection.Winner.IsZero() {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif row.Projection.Winner.Epoch != plan.LeaseEpoch || row.Projection.Winner.LeaseID != plan.LeaseID || row.Projection.OwnerHostID != plan.OwnerHostID {\n+\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n+\t\t}\n+\t\tleaseRecordID, err := fingerprintWinningLease(plan.SessionID, row.Projection.Winner.Epoch, row.Projection.Winner.LeaseID, row.Projection.OwnerHostID)\n+\t\tif err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t\tif leaseRecordID != plan.LeaseRecordID {\n+\t\t\treturn fmt.Errorf(\"%w: winning lease changed\", ErrPlanStale)\n+\t\t}\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
