{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d681","stream":{"kind":"session","id":"01a08841-b416-7e52-96f7-950fb1e6ed56"},"sequence":2459,"recorded_at":1780531400004913,"record_type":"event","durability":"durable","causation_id":"82802766-dfb1-4d49-b692-3924c0687d9f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"82802766-dfb1-4d49-b692-3924c0687d9f","run_stream":{"kind":"run","id":"82802766-dfb1-4d49-b692-3924c0687d9f"},"task_stream":{"kind":"task","id":"01a08855-83d9-7af1-ae3b-f6316bdee184"},"task_id":"01a08855-83d9-7af1-ae3b-f6316bdee184","event":{"kind":"output","task_id":"01a08855-83d9-7af1-ae3b-f6316bdee184","chunk":"Read text file `internal/sessstate/project.go`.\n(27 line(s) above)\n28|\tLocal LeaseHead\n29|}\n30|\n31|// Project derives the session projection for one session ID. A parked\n32|// session returns the parked state with its blocking reason and retry,\n33|// never an error or an omission; an ID with no listing entry refuses\n34|// unknown. The listing therefore tells a parked name apart from a\n35|// missing one with no sessrepo interface change.\n36|func (projector *Projector) Project(sessionID string) (Projection, error) {\n37|\tif projector == nil || projector.Repo == nil {\n38|\t\treturn Projection{}, refuse(ErrDerivation, \"projector carries no repository\")\n39|\t}\n40|\tsummaries, err := projector.Repo.ListSessions()\n41|\tif err != nil {\n42|\t\treturn Projection{}, err\n43|\t}\n44|\tvar found *sessrepo.SessionSummary\n45|\tfor index := range summaries {\n46|\t\tif summaries[index].SessionID == sessionID {\n47|\t\t\tfound = &summaries[index]\n48|\t\t\tbreak\n49|\t\t}\n50|\t}\n51|\tif found == nil {\n52|\t\treturn Projection{}, refuse(ErrUnknownSession, \"no session %s\", sessionID)\n53|\t}\n54|\tif found.Parked {\n55|\t\treturn Reduce(Input{\n56|\t\t\tRecord: Record{\n57|\t\t\t\tSessionID:  found.SessionID,\n58|\t\t\t\tRecordID:   found.RecordID,\n59|\t\t\t\tName:       found.Name,\n60|\t\t\t\tKind:       found.Kind,\n61|\t\t\t\tProviderID: found.ProviderID,\n62|\t\t\t},\n63|\t\t\tParked: &ParkedFacts{\n64|\t\t\t\tBlockingReason: found.BlockingReason,\n65|\t\t\t\tRetryHint:      found.RetryHint,\n66|\t\t\t},\n67|\t\t})\n68|\t}\n69|\trecordBytes, err := projector.Repo.GetRecord(sessionID)\n70|\tif err != nil {\n71|\t\treturn Projection{}, err\n72|\t}\n73|\trecord, err := DecodeRecord(recordBytes)\n74|\tif err != nil {\n75|\t\treturn Projection{}, err\n76|\t}\n77|\tindexed, err := projector.Repo.ListEvents(sessionID)\n78|\tif err != nil {\n79|\t\treturn Projection{}, err\n80|\t}\n81|\tevents := make([]Event, 0, len(indexed))\n82|\tfor _, summary := range indexed {\n83|\t\tblob, err := projector.Repo.GetEvent(sessionID, summary.EventID)\n84|\t\tif err != nil {\n85|\t\t\treturn Projection{}, err\n86|\t\t}\n87|\t\tevent, err := DecodeEvent(blob)\n88|\t\tif err != nil {\n89|\t\t\treturn Projection{}, err\n90|\t\t}\n91|\t\tevents = append(events, event)\n92|\t}\n93|\treturn Reduce(Input{\n94|\t\tRecord:      record,\n95|\t\tEvents:      events,\n96|\t\tUnion:       append([]LeaseHead(nil), projector.Union...),\n97|\t\tLocal:       projector.Local,\n(more lines below)","final_result":true}}}
