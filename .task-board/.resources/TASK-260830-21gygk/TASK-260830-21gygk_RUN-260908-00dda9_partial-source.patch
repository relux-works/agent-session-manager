+	again, err := r.List()
+	if err != nil || !reflect.DeepEqual(list, again) {
+		t.Fatalf("read is not idempotent: %+v %v", again, err)
+	}
+	r.LocalHostID = hostB
+	status, err := r.Status(idA)
