func TestUnknownReleaseIsRefused(t *testing.T) {
	t.Parallel()

	if _, err := catalog.ForRelease("v0.5.1"); !errors.Is(err, catalog.ErrUnsupportedRelease) {
		t.Fatalf("ForRelease(v0.5.1) error = %v, want ErrUnsupportedRelease", err)
