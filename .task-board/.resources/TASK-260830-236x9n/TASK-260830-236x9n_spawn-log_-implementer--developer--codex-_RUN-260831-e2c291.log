+func TestGenerateRejectsInvalidOrNarrowedSelfIdentityContracts(t *testing.T) {
+	t.Parallel()
+
+	metadata, lock := sourceInputs(t)
+	tests := []struct {
+		name   string
+		mutate func(map[string]any)
+	}{
+		{
+			name: "deleted reviewed contract",
+			mutate: func(document map[string]any) {
