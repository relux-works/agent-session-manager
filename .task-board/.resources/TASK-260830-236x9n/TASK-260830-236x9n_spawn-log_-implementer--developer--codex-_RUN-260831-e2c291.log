+			candidate := mutateMetadata(t, metadata, test.mutate)
+			if _, err := cataloggen.Generate(candidate, lock); !errors.Is(err, cataloggen.ErrInvalidMetadata) {
+				t.Fatalf("Generate() error = %v, want ErrInvalidMetadata", err)
+			}
+		})
+	}
+}
