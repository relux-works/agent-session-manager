   298		second := []byte(" { \n  \"schema_version\" : \"1.0.0\", \"schema\" : \"urn:ax:schema:session-record\", \"record_id\" : \"" + calculated.String() + "\", \"z\" : [ { \"a\" : 1, \"b\" : 2 } ] } \n")
   299		recalculated, secondField, err := CalculateObjectIdentity(second)
   300		if err != nil || recalculated != calculated || secondField != field {
   301			t.Fatalf("CalculateObjectIdentity(reordered) = %q, %q, %v; want %q, %q", recalculated, secondField, err, calculated, field)
   302		}
   303		verified, verifiedField, err := VerifyObjectIdentity(second)
   304		if err != nil || verified != calculated || verifiedField != SelfRecordID {
   305			t.Fatalf("VerifyObjectIdentity(reordered) = %q, %q, %v", verified, verifiedField, err)
   306		}
   307		for attempt := 0; attempt < 3; attempt++ {
   308			again, _, err := CalculateObjectIdentity(second)
   309			if err != nil || again != calculated {
   310				t.Fatalf("CalculateObjectIdentity idempotent attempt %d = %q, %v; want %q", attempt, again, err, calculated)
   311			}
   312		}
   313	}
