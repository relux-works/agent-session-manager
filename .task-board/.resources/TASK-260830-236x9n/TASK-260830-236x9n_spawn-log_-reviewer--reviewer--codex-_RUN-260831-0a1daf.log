   389	func validateSurrogateEscapes(input []byte) error {
   390		for index := 0; index < len(input); index++ {
   391			if input[index] != '"' {
   392				continue
   393			}
   394			for index++; index < len(input); index++ {
   395				switch input[index] {
   396				case '"':
   397					goto stringComplete
   398				case '\\':
   399					index++
   400					if index >= len(input) {
   401						return invalidJSON("unterminated string escape")
   402					}
   403					if input[index] != 'u' {
   404						continue
   405					}
   406					codeUnit, end, err := readUTF16Escape(input, index-1)
   407					if err != nil {
   408						return err
   409					}
   410					index = end - 1
   411					switch {
   412					case codeUnit >= 0xd800 && codeUnit <= 0xdbff:
   413						second, secondEnd, err := readUTF16Escape(input, end)
   414						if err != nil || second < 0xdc00 || second > 0xdfff {
   415							return invalidJSON("high surrogate escape must be followed by a low surrogate escape")
   416						}
   417						index = secondEnd - 1
   418					case codeUnit >= 0xdc00 && codeUnit <= 0xdfff:
   419						return invalidJSON("lone low surrogate escape is forbidden")
   420					}
   421				case 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
   422					0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
   423					0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
   424					0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:
   425					return invalidJSON("unescaped control character in string")
   426				}
   427			}
   428			return invalidJSON("unterminated JSON string")
   429		stringComplete:
   430		}
   431		return nil
   432	}
   433	
   434	func readUTF16Escape(input []byte, start int) (uint16, int, error) {
   435		if start < 0 || start+6 > len(input) || input[start] != '\\' || input[start+1] != 'u' {
   436			return 0, start, invalidJSON("expected UTF-16 escape")
   437		}
   438		value, err := strconv.ParseUint(string(input[start+2:start+6]), 16, 16)
   439		if err != nil {
   440			return 0, start, invalidJSON("malformed UTF-16 escape")
   441		}
   442		return uint16(value), start + 6, nil
   443	}
   444	
   445	func invalidJSON(format string, arguments ...any) error {
   446		return fmt.Errorf("%w: %s", ErrInvalidJSON, fmt.Sprintf(format, arguments...))
   447	}
   448	
   449	func invalidIdentity(format string, arguments ...any) error {
   450		return fmt.Errorf("%w: %s", ErrInvalidIdentity, fmt.Sprintf(format, arguments...))
   451	}
