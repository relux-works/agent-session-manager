   147	// CalculateObjectIdentity validates the AX common logical number model,
   148	// resolves the one self field from the object's trusted schema/version
   149	// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256
   150	// identity. Callers cannot select an arbitrary field to omit, which prevents
   151	// self inclusion and digest cycles.
   152	func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {
   153		value, err := decodeStrict(input)
   154		if err != nil {
   155			return scalar.Digest{}, "", err
   156		}
   157		if err := validateAXNumbers(value); err != nil {
   158			return scalar.Digest{}, "", err
   159		}
   160		object, ok := value.(map[string]any)
   161		if !ok {
   162			return scalar.Digest{}, "", invalidIdentity("identity input must be a JSON object")
   163		}
   164	
   165		selfField, _, err := resolveSelfField(object)
   166		if err != nil {
   167			return scalar.Digest{}, "", err
   168		}
   169		omitted := make(map[string]any, len(object)-1)
   170		for name, member := range object {
   171			if name != string(selfField) {
   172				omitted[name] = member
   173			}
   174		}
   175		serialized, err := json.Marshal(omitted)
   176		if err != nil {
   177			return scalar.Digest{}, "", invalidIdentity("serialize omit-self object: %v", err)
   178		}
   179		canonical, err := jcs.Transform(serialized)
   180		if err != nil {
   181			return scalar.Digest{}, "", invalidIdentity("canonicalize omit-self object: %v", err)
   182		}
   183		return scalar.SHA256Digest(canonical), selfField, nil
   184	}
