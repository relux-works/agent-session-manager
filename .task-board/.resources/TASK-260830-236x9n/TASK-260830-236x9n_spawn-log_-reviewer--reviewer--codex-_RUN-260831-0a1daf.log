   362	func validateAXNumbers(value any) error {
   363		switch typed := value.(type) {
   364		case json.Number:
   365			literal := typed.String()
   366			if strings.ContainsAny(literal, ".eE") {
   367				return invalidIdentity("floating-point number %q is forbidden by the AX common model", literal)
   368			}
   369			integer, err := strconv.ParseInt(literal, 10, 64)
   370			if err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {
   371				return invalidIdentity("integer %q is outside the AX safe-integer interval", literal)
   372			}
   373		case []any:
   374			for _, element := range typed {
   375				if err := validateAXNumbers(element); err != nil {
   376					return err
   377				}
   378			}
   379		case map[string]any:
   380			for _, member := range typed {
   381				if err := validateAXNumbers(member); err != nil {
   382					return err
   383				}
   384			}
   385		}
   386		return nil
   387	}
