   186	// VerifyObjectIdentity drives the same production calculation and refuses a
   187	// malformed, self-included, or otherwise mismatched claimed identity.
   188	func VerifyObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {
   189		value, err := decodeStrict(input)
   190		if err != nil {
   191			return scalar.Digest{}, "", err
   192		}
   193		object, ok := value.(map[string]any)
   194		if !ok {
   195			return scalar.Digest{}, "", invalidIdentity("identity input must be a JSON object")
   196		}
   197		selfField, claimed, err := resolveSelfField(object)
   198		if err != nil {
   199			return scalar.Digest{}, "", err
   200		}
   201		calculated, calculatedField, err := CalculateObjectIdentity(input)
   202		if err != nil {
   203			return scalar.Digest{}, "", err
   204		}
   205		if calculatedField != selfField || claimed != calculated {
   206			return scalar.Digest{}, "", invalidIdentity(
   207				"%s claim %q does not match omit-self digest %q",
   208				selfField,
   209				claimed,
   210				calculated,
   211			)
   212		}
   213		return calculated, selfField, nil
   214	}
