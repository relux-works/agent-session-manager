   281	func decodeStrict(input []byte) (any, error) {
   282		if len(input) == 0 {
   283			return nil, invalidJSON("input is empty")
   284		}
   285		if !utf8.Valid(input) {
   286			return nil, invalidJSON("input is not valid UTF-8")
   287		}
   288		if err := validateSurrogateEscapes(input); err != nil {
   289			return nil, err
   290		}
   291	
   292		decoder := json.NewDecoder(bytes.NewReader(input))
   293		decoder.UseNumber()
   294		value, err := decodeValue(decoder)
   295		if err != nil {
   296			return nil, err
   297		}
   298		if token, err := decoder.Token(); !errors.Is(err, io.EOF) {
   299			if err != nil {
   300				return nil, invalidJSON("read trailing JSON data: %v", err)
   301			}
   302			return nil, invalidJSON("unexpected trailing JSON token %v", token)
   303		}
   304		return value, nil
   305	}
