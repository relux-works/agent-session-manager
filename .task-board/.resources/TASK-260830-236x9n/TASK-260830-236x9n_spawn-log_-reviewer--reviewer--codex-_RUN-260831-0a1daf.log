   125	// Canonicalize is the production RFC 8785 entry point. It rejects malformed
   126	// UTF-8, invalid surrogate escapes, duplicate object names, and non-I-JSON
   127	// input before producing the canonical UTF-8 byte sequence.
   128	func Canonicalize(input []byte) ([]byte, error) {
   129		value, err := decodeStrict(input)
   130		if err != nil {
   131			return nil, err
   132		}
   133		// Re-encode the parsed logical value before the JCS transform. This removes
   134		// leading/trailing whitespace around primitive top-level values without
   135		// changing json.Number tokens or string data.
   136		normalized, err := json.Marshal(value)
   137		if err != nil {
   138			return nil, invalidJSON("serialize logical JSON value: %v", err)
   139		}
   140		canonical, err := jcs.Transform(normalized)
   141		if err != nil {
   142			return nil, invalidJSON("canonicalize RFC 8785 value: %v", err)
   143		}
   144		return canonical, nil
   145	}
