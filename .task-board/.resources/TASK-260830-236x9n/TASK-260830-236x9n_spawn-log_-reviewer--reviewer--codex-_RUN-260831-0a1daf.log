    16	func TestCanonicalizeMatchesPublishedRFC8785PrimitiveAndStringVector(t *testing.T) {
    17		input := []byte(`{
    18	  "numbers": [333333333.33333329, 1E30, 4.50, 2e-3, 0.000000000000000000000000001],
    19	  "string": "\u20ac$\u000F\u000aA'\u0042\u0022\u005c\\\"\/",
    20	  "literals": [null, true, false]
    21	}`)
    22		want := `{"literals":[null,true,false],"numbers":[333333333.3333333,1e+30,4.5,0.002,1e-27],"string":"€$\u000f\nA'B\"\\\\\"/"}`
    23	
    24		got, err := Canonicalize(input)
    25		if err != nil {
    26			t.Fatalf("Canonicalize(RFC 8785 Section 3.2.2 vector) error = %v", err)
    27		}
    28		if string(got) != want {
    29			t.Fatalf("Canonicalize(RFC 8785 Section 3.2.2 vector) = %q, want %q", got, want)
    30		}
    31	
    32		again, err := Canonicalize(got)
    33		if err != nil || string(again) != want {
    34			t.Fatalf("Canonicalize(canonical vector) = %q, %v; want identical %q", again, err, want)
    35		}
    36	
    37		primitive, err := Canonicalize([]byte(" \n -0 \t"))
    38		if err != nil || string(primitive) != "0" {
    39			t.Fatalf("Canonicalize(whitespace-wrapped minus zero) = %q, %v; want RFC value 0", primitive, err)
    40		}
    41	}
