   228				"schema %q version %q has no supported immutable self-identity contract",
   229				schema,
   230				version,
   231			)
   232		}
   233		if contract.discriminatorName != "" {
   234			discriminator, err := requiredStringMember(object, contract.discriminatorName)
   235			if err != nil {
   236				return "", scalar.Digest{}, err
   237			}
   238			if discriminator != contract.discriminatorValue {
   239				return "", scalar.Digest{}, invalidIdentity(
   240					"schema %q version %q variant %s=%q is not an immutable self-identity contract",
   241					schema,
   242					version,
   243					contract.discriminatorName,
   244					discriminator,
   245				)
   246			}
   247		}
