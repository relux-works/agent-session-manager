   307	func decodeValue(decoder *json.Decoder) (any, error) {
   308		token, err := decoder.Token()
   309		if err != nil {
   310			return nil, invalidJSON("decode JSON token: %v", err)
   311		}
   312		delimiter, ok := token.(json.Delim)
   313		if !ok {
   314			return token, nil
   315		}
   316	
   317		switch delimiter {
   318		case '{':
   319			object := make(map[string]any)
   320			for decoder.More() {
   321				nameToken, err := decoder.Token()
   322				if err != nil {
   323					return nil, invalidJSON("decode object name: %v", err)
   324				}
   325				name, ok := nameToken.(string)
   326				if !ok {
   327					return nil, invalidJSON("object name is not a string")
   328				}
   329				if _, duplicate := object[name]; duplicate {
   330					return nil, invalidJSON("duplicate object member %q", name)
   331				}
   332				value, err := decodeValue(decoder)
   333				if err != nil {
   334					return nil, err
   335				}
   336				object[name] = value
   337			}
   338			end, err := decoder.Token()
   339			if err != nil || end != json.Delim('}') {
   340				return nil, invalidJSON("decode object terminator: %v", err)
   341			}
   342			return object, nil
   343		case '[':
   344			array := make([]any, 0)
   345			for decoder.More() {
   346				value, err := decodeValue(decoder)
   347				if err != nil {
   348					return nil, err
   349				}
   350				array = append(array, value)
   351			}
   352			end, err := decoder.Token()
   353			if err != nil || end != json.Delim(']') {
   354				return nil, invalidJSON("decode array terminator: %v", err)
   355			}
   356			return array, nil
   357		default:
   358			return nil, invalidJSON("unexpected delimiter %q", delimiter)
   359		}
   360	}
