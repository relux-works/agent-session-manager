+type schemaIdentityKey struct {
+	schema  string
+	version string
+}
+
+type schemaIdentityContract struct {
+	selfField          SelfField
+	discriminatorName  string
+	discriminatorValue string
+}
+
+// schemaIdentityContracts is the trusted v0.5.0 schema/version projection for
+// the Section 1.6 self-field namespaces. A schema may legitimately carry a
+// differently named ID as a reference, so field-name counting is not an
