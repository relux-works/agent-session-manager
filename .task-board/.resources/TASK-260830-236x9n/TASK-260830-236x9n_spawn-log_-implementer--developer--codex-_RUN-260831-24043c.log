+					zeroDigest,
+				))
+				if _, gotField, err := CalculateObjectIdentity(input); err != nil || gotField != test.selfField {
+					t.Fatalf("CalculateObjectIdentity(%s) field = %q, error = %v; want %q", name, gotField, err, test.selfField)
+				}
+			})
+		}
+	}
