+	SelfPlanID             SelfField = "plan_id"
+	SelfTombstoneID        SelfField = "tombstone_id"
+	SelfAckID              SelfField = "ack_id"
+	SelfBundleID           SelfField = "bundle_id"
+	SelfMarkerID           SelfField = "marker_id"
+	SelfObservationID      SelfField = "observation_id"
