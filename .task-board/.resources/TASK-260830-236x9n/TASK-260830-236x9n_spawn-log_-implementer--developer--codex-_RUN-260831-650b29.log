exec
/bin/zsh -lc 'cat /Users/iv/.claude/skills/project-management/references/statuses.md /Users/iv/.claude/skills/project-management/references/resources-and-bugs.md /Users/iv/.claude/skills/project-management/references/roles.md /Users/iv/.claude/skills/project-management/references/negative-evidence.md && task-board q --help' in /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2wdm5e/worktree
