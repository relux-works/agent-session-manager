+func TestCalculateObjectIdentityOmitsEveryNormativeSelfField(t *testing.T) {
+	want := digestHex(`{"a":1,"schema":"urn:ax:test"}`)
+	expectedSelfFields := []SelfField{
+		SelfRecordID,
+		SelfEventID,
+		SelfCheckpointID,
+		SelfDescriptorID,
+		SelfManifestID,
+		SelfPlanID,
+		SelfTombstoneID,
+		SelfAckID,
+		SelfBundleID,
+		SelfMarkerID,
+		SelfObservationID,
+		SelfBatchID,
+		SelfLineageLinkID,
+		SelfAnnotationID,
+		SelfProfileID,
+		SelfJobRequestID,
+		SelfJobReceiptID,
+		SelfDirectoryReceiptID,
+	}
+	if len(selfFields) != len(expectedSelfFields) {
+		t.Fatalf("production self-field registry has %d entries, want exact normative %d", len(selfFields), len(expectedSelfFields))
+	}
+	for _, selfField := range expectedSelfFields {
+		t.Run(string(selfField), func(t *testing.T) {
+			input := []byte(fmt.Sprintf(`{"schema":"urn:ax:test","%s":"%s","a":1}`, selfField, zeroDigest))
+			got, gotField, err := CalculateObjectIdentity(input)
+			if err != nil {
+				t.Fatalf("CalculateObjectIdentity(%s) error = %v", selfField, err)
+			}
+			if gotField != selfField || got.String() != want {
+				t.Fatalf("CalculateObjectIdentity(%s) = %q, %q; want %q, %q", selfField, got, gotField, want, selfField)
+			}
+		})
+	}
+}
