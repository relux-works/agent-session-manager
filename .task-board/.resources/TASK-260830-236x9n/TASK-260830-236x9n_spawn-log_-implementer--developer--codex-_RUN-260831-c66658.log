+func checkUnchanged(path string, content []byte) error {
+	existing, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(existing, content) {
+		return fmt.Errorf("generated catalog is stale; run go generate ./internal/catalog")
+	}
+	return nil
