+func TestRunCheckRefusesStaleOutputWithoutRewritingIt(t *testing.T) {
+	t.Parallel()
+
+	output := filepath.Join(t.TempDir(), "catalog_gen.go")
+	stale := []byte("package catalog\n\n// stale\n")
