+		t.Fatalf("check run() error = %v, want stale-output refusal", err)
+	}
+	got, readErr := os.ReadFile(output)
+	if readErr != nil {
+		t.Fatalf("read stale output after refusal: %v", readErr)
+	}
+	if !bytes.Equal(got, stale) {
+		t.Fatal("check run rewrote stale output")
+	}
+}
