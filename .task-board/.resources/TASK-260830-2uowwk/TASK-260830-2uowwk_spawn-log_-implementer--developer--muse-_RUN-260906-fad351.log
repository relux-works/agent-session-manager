{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44f","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":130,"recorded_at":1780531400000255,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0c0e47c438ececb6706823bdd","text":"Read text file `internal/catalog/catalog.go`.\n1|// Package catalog exposes generated, typed vocabularies from the reviewed AX\n2|// implementation metadata. Catalog membership defines a contract vocabulary;\n3|// it never advertises runtime availability or implementation support.\n4|package catalog\n5|\n6|import (\n7|\t\"errors\"\n8|\t\"fmt\"\n9|)\n10|\n11|const (\n12|\tFormat        = \"ax-implementation-catalog\"\n13|\tFormatVersion = 1\n14|\n15|\tReleaseV043 Release = \"v0.4.3\"\n16|\tReleaseV050 Release = \"v0.5.0\"\n17|)\n18|\n19|var ErrUnsupportedRelease = errors.New(\"unsupported catalog release\")\n20|\n21|// Release identifies a specification package release represented by the\n22|// reviewed implementation metadata.\n23|type Release string\n24|\n25|// ContractID is a registered AX schema or protocol identifier.\n26|type ContractID string\n27|\n28|// Family scopes operation, capability, and event names that may otherwise\n29|// overlap across independent contracts.\n30|type Family string\n31|\n32|// OperationName is one closed operation-registry member.\n33|type OperationName string\n34|\n35|// CapabilityName is one manifest/probe capability-vocabulary member. It does\n36|// not imply that the capability is available.\n37|type CapabilityName string\n38|\n39|// EventName is one closed Session Event or required Observation Event member.\n40|type EventName string\n41|\n42|// ErrorName is one stable Structured Error code.\n43|type ErrorName string\n44|\n45|// Source binds every generated definition to the immutable normative source.\n46|type Source struct {\n47|\tRepository     string\n48|\tRelease        Release\n49|\tCommit         string\n50|\tDocumentPath   string\n51|\tDocumentSHA256 string\n52|\tNormativeScope []string\n53|}\n54|\n55|// Contract is one independently versioned schema or protocol contract.\n56|type Contract struct {\n57|\tName     string\n58|\tID       ContractID\n59|\tVersions []string\n60|}\n61|\n62|// SelfIdentityContract defines the schema-directed JCS omit-self rule for an\n63|// immutable logical object. Membership is reviewed metadata from the pinned\n64|// specification; it does not imply that any wider schema behavior is\n65|// implemented.\n66|type SelfIdentityContract struct {\n67|\tContractID         ContractID\n68|\tContractVersions   []string\n69|\tSelfField          string\n70|\tDiscriminatorName  string\n71|\tDiscriminatorValue string\n72|\tNormativeSection   string\n73|}\n74|\n75|// OperationEffect classifies whether an operation mutates authoritative\n76|// durable state. Isolated output is restricted to caller-created sinks and is\n77|// not an authoritative state transition.\n78|type OperationEffect string\n79|\n80|const (\n81|\t// EffectNoDurableMutation makes no stronger read-only claim: an operation\n82|\t// may still plan work or control an ephemeral process.\n83|\tEffectNoDurableMutation OperationEffect = \"no_durable_mutation\"\n84|\tEffectIsolatedOutput    OperationEffect = \"isolated_output\"\n85|\tEffectDurableMutation   OperationEffect = \"durable_mutation\"\n86|)\n87|\n88|// Operation is a typed protocol/query operation definition. Durable mutations\n89|// always carry both an exact idempotency scope and recovery evidence.\n90|type Operation struct {\n91|\tFamily           Family\n92|\tName             OperationName\n93|\tContractID       ContractID\n94|\tContractVersions []string\n95|\tEffect           OperationEffect\n96|\tIdempotencyKey   string\n97|\tRecoveryEvidence []string\n98|\tNormativeSection string\n99|\tFixtureFamilies  []string\n100|}\n101|\n102|// Capability is a vocabulary definition only. Availability, status, enabled,\n103|// and support claims deliberately do not exist in this type.\n104|type Capability struct {\n105|\tFamily           Family\n106|\tName             CapabilityName\n107|\tContractID       ContractID\n108|\tContractVersions []string\n109|\tNormativeSection string\n110|\tFixtureFamilies  []string\n111|}\n112|\n113|// Event is a required event name and the exact contract versions that define\n114|// it. Session Events and Observation Events remain separate families.\n115|type Event struct {\n116|\tFamily           Family\n117|\tName             EventName\n118|\tContractID       ContractID\n119|\tContractVersions []string\n120|\tNormativeSection string\n121|\tFixtureFamilies  []string\n122|}\n123|\n124|// ErrorCode is one stable Structured Error code-to-exit mapping.\n125|type ErrorCode struct {\n126|\tCode             ErrorName\n127|\tExitCode         int\n128|\tContractID       ContractID\n129|\tContractVersions []string\n130|\tNormativeSection string\n131|\tFixtureFamilies  []string\n132|}\n133|\n134|// Catalog is an isolated release projection of the generated definitions.\n135|type Catalog struct {\n136|\tSource         Source\n137|\tRelease        Release\n138|\tMetadataSHA256 string\n139|\tContracts      []Contract\n140|\tSelfIdentities []SelfIdentityContract\n141|\tOperations     []Operation\n142|\tCapabilities   []Capability\n143|\tEvents         []Event\n144|\tErrors         []ErrorCode\n145|}\n146|\n147|type catalogDefinition struct {\n148|\tSource         Source\n149|\tMetadataSHA256 string\n150|\tContracts      map[Release][]Contract\n151|\tSelfIdentities []scopedSelfIdentityContract\n152|\tOperations     []scopedOperation\n153|\tCapabilities   []scopedCapability\n154|\tEvents         []scopedEvent\n155|\tErrors         []scopedError\n156|}\n157|\n158|type scopedSelfIdentityContract struct {\n159|\tDefinition SelfIdentityContract\n160|\tReleases   []Release\n161|}\n162|\n163|type scopedOperation struct {\n164|\tDefinition Operation\n165|\tReleases   []Release\n166|}\n167|\n168|type scopedCapability struct {\n169|\tDefinition Capability\n170|\tReleases   []Release\n171|}\n172|\n173|type scopedEvent struct {\n174|\tDefinition Event\n175|\tReleases   []Release\n176|}\n177|\n178|type scopedError struct {\n179|\tDefinition ErrorCode\n180|\tReleases   []Release\n181|}\n182|\n183|//go:generate go run ./cmd/cataloggen -metadata catalog.v0.5.0.json -contracts ../specpin/v0.5.0.lock.json -output catalog_gen.go\n184|\n185|// Current returns an isolated v0.5.0 catalog.\n186|func Current() Catalog {\n187|\tcatalog, err := ForRelease(ReleaseV050)\n188|\tif err != nil {\n189|\t\tpanic(fmt.Sprintf(\"generated current catalog is invalid: %v\", err))\n190|\t}\n191|\treturn catalog\n192|}\n193|\n194|// ForRelease returns an isolated exact catalog projection for a represented\n195|// release. It never coerces or guesses an unsupported release.\n196|func ForRelease(release Release) (Catalog, error) {\n197|\tcontracts, ok := generatedDefinition.Contracts[release]\n198|\tif !ok {\n199|\t\treturn Catalog{}, fmt.Errorf(\"%w: %s\", ErrUnsupportedRelease, release)\n200|\t}\n201|\n202|\tallowedVersions := make(map[ContractID]map[string]struct{}, len(contracts))\n203|\tfor _, contract := range contracts {\n204|\t\tversions := allowedVersions[contract.ID]\n205|\t\tif versions == nil {\n206|\t\t\tversions = make(map[string]struct{}, len(contract.Versions))\n207|\t\t\tallowedVersions[contract.ID] = versions\n208|\t\t}\n209|\t\tfor _, version := range contract.Versions {\n210|\t\t\tversions[version] = struct{}{}\n211|\t\t}\n212|\t}\n213|\n214|\tresult := Catalog{\n215|\t\tSource:         cloneSource(generatedDefinition.Source),\n216|\t\tRelease:        release,\n217|\t\tMetadataSHA256: generatedDefinition.MetadataSHA256,\n218|\t\tContracts:      cloneContracts(contracts),\n219|\t}\n220|\tfor _, scoped := range generatedDefinition.SelfIdentities {\n221|\t\tif !containsRelease(scoped.Releases, release) {\n222|\t\t\tcontinue\n223|\t\t}\n224|\t\tdefinition := cloneSelfIdentityContract(scoped.Definition)\n225|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n226|\t\tif len(definition.ContractVersions) != 0 {\n227|\t\t\tresult.SelfIdentities = append(result.SelfIdentities, definition)\n228|\t\t}\n229|\t}\n230|\tfor _, scoped := range generatedDefinition.Operations {\n231|\t\tif !containsRelease(scoped.Releases, release) {\n232|\t\t\tcontinue\n233|\t\t}\n234|\t\tdefinition := cloneOperation(scoped.Definition)\n235|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n236|\t\tif len(definition.ContractVersions) != 0 {\n237|\t\t\tresult.Operations = append(result.Operations, definition)\n238|\t\t}\n239|\t}\n240|\tfor _, scoped := range generatedDefinition.Capabilities {\n241|\t\tif !containsRelease(scoped.Releases, release) {\n242|\t\t\tcontinue\n243|\t\t}\n244|\t\tdefinition := cloneCapability(scoped.Definition)\n245|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n246|\t\tif len(definition.ContractVersions) != 0 {\n247|\t\t\tresult.Capabilities = append(result.Capabilities, definition)\n248|\t\t}\n249|\t}\n250|\tfor _, scoped := range generatedDefinition.Events {\n251|\t\tif !containsRelease(scoped.Releases, release) {\n252|\t\t\tcontinue\n253|\t\t}\n254|\t\tdefinition := cloneEvent(scoped.Definition)\n255|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n256|\t\tif len(definition.ContractVersions) != 0 {\n257|\t\t\tresult.Events = append(result.Events, definition)\n258|\t\t}\n259|\t}\n260|\tfor _, scoped := range generatedDefinition.Errors {\n261|\t\tif !containsRelease(scoped.Releases, release) {\n262|\t\t\tcontinue\n263|\t\t}\n264|\t\tdefinition := cloneError(scoped.Definition)\n265|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n266|\t\tif len(definition.ContractVersions) != 0 {\n267|\t\t\tresult.Errors = append(result.Errors, definition)\n268|\t\t}\n269|\t}\n270|\treturn result, nil\n271|}\n272|\n273|func containsRelease(releases []Release, wanted Release) bool {\n274|\tfor _, release := range releases {\n275|\t\tif release == wanted {\n276|\t\t\treturn true\n277|\t\t}\n278|\t}\n279|\treturn false\n280|}\n281|\n282|func filterVersions(versions []string, allowed map[string]struct{}) []string {\n283|\tfiltered := make([]string, 0, len(versions))\n284|\tfor _, version := range versions {\n285|\t\tif _, ok := allowed[version]; ok {\n286|\t\t\tfiltered = append(filtered, version)\n287|\t\t}\n288|\t}\n289|\treturn filtered\n290|}\n291|\n292|func cloneSource(source Source) Source {\n293|\tsource.NormativeScope = append([]string(nil), source.NormativeScope...)\n294|\treturn source\n295|}\n296|\n297|func cloneContracts(contracts []Contract) []Contract {\n298|\tresult := make([]Contract, len(contracts))\n299|\tfor index, contract := range contracts {\n300|\t\tcontract.Versions = append([]string(nil), contract.Versions...)\n301|\t\tresult[index] = contract\n302|\t}\n303|\treturn result\n304|}\n305|\n306|func cloneSelfIdentityContract(contract SelfIdentityContract) SelfIdentityContract {\n307|\tcontract.ContractVersions = append([]string(nil), contract.ContractVersions...)\n308|\treturn contract\n309|}\n310|\n311|func cloneOperation(operation Operation) Operation {\n312|\toperation.ContractVersions = append([]string(nil), operation.ContractVersions...)\n313|\toperation.RecoveryEvidence = append([]string(nil), operation.RecoveryEvidence...)\n314|\toperation.FixtureFamilies = append([]string(nil), operation.FixtureFamilies...)\n315|\treturn operation\n316|}\n317|\n318|func cloneCapability(capability Capability) Capability {\n319|\tcapability.ContractVersions = append([]string(nil), capability.ContractVersions...)\n320|\tcapability.FixtureFamilies = append([]string(nil), capability.FixtureFamilies...)\n321|\treturn capability\n322|}\n323|\n324|func cloneEvent(event Event) Event {\n325|\tevent.ContractVersions = append([]string(nil), event.ContractVersions...)\n326|\tevent.FixtureFamilies = append([]string(nil), event.FixtureFamilies...)\n327|\treturn event\n328|}\n329|\n330|func cloneError(item ErrorCode) ErrorCode {\n331|\titem.ContractVersions = append([]string(nil), item.ContractVersions...)\n332|\titem.FixtureFamilies = append([]string(nil), item.FixtureFamilies...)\n333|\treturn item\n334|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c451","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":131,"recorded_at":1780531400000257,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0c15e7720b5b242cf86cf2601","text":"Read text file `internal/secconftest/doc.go`.\n1|// Package secconftest is the conformance-test instrument for the\n2|// security-primitives-and-conformance-ci story: deterministic fixture\n3|// runners, fake clocks, crash points, protocol fuzz drivers, hostile\n4|// strings, and platform capability skips over the Section 16 production\n5|// gates (internal/secprim).\n6|//\n7|// It is an instrument, not a second authority. Every behavior it covers\n8|// is decided by an existing owner; this package only drives those\n9|// decisions deterministically and proves the drive reaches them:\n10|//\n11|//   - path grammars and bounds stay in internal/scalar;\n12|//   - wire decoding, string measure, and bound checks stay in\n13|//     internal/environ;\n14|//   - argv, environment, redaction, escaping, and containment refusals\n15|//     stay in internal/secprim, whose production code this package must\n16|//     not change;\n17|//   - the pinned specification text stays in internal/specdoc, which\n18|//     this package reads only to derive hostile classes, never to\n19|//     advertise product capabilities.\n20|//\n21|// Normative scope: AX v0.5.0 Sections 16, 19.2-19.5, 20.2, Appendix D.\n22|// Section 19.3 provider suites and Section 19.4 lifecycle cases outside\n23|// Section 16 are not driven here; the per-mechanism tests name that\n24|// bound where it bites.\n25|//\n26|// Stated bounds. The crash Transactor is a test model of a three-phase\n27|// durable commit, not the product journal: it proves the injector and\n28|// the outcome vocabulary work, not that any product recovery path\n29|// works. Finalization is terminal for clean and crashed Commits alike\n30|// (a commit-apply fault already performed the durable write, so\n31|// rollback is forbidden and the bytes survive); a pre-commit Rollback\n32|// forgets the operation so a fresh Prepare restages the recovery\n33|// retry, while Prepare/Commit past finalization name the terminal\n34|// state instead of inheriting ENOENT. The five crash-point names are\n35|// instrument-local phase boundaries, not the SPEC CR-MAT-01..08\n36|// registry: registry-style names are refused as unknown, and a new\n37|// crash site added without an arm is outside this model. Every arm\n38|// the suite sets is consumption-checked through RemainingArmed, so an\n39|// armed point the drive never reaches fails its test instead of\n40|// passing silently; all five points are armed through the Transactor,\n41|// including rollback-enter. The fuzz drivers cover the Section 16\n42|// string and vector gates only; containment races and TOCTOU behavior\n43|// are out of scope for byte-mutating fuzz. The IsEnvName and Redact\n44|// fuzz properties pin the two poles a no-op gate fails (refused\n45|// empty/admitted well-formed name; rewritten secret/passing innocuous\n46|// line); the interior grammar and per-class markers stay covered by\n47|// the hostile corpus tests named on each property. Hostile members\n48|// derive from the specification text plus package-unicode tables and\n49|// internal/scalar predicates, so deleting a secprim gate arm keeps\n50|// the corpus and reddens the gate test instead of shrinking the\n51|// witness with it. Require takes a minimal testing handle so the\n52|// skip and fail arms are driven through the real function with a\n53|// recording fake (both recordVerdict call sites pinned); TestMain\n54|// prints the process-wide Report after every test, including the\n55|// parallel ones, so a real parallel verdict is observable there.\n56|// The per-test skip datum is still the `--- SKIP` lines under\n57|// `go test -v`: on a host where every probe passes no verdict is\n58|// recorded and the final counters honestly read zero.\n59|package secconftest","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c453","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":132,"recorded_at":1780531400000259,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0c1f27ad3831e811600d3d6fb","text":"Read text file `internal/secprim/doc.go`.\n1|// Package secprim implements the AX shared safe process and filesystem\n2|// primitives of pinned specification Sections 16.3, 16.4, and 16.7: no-follow\n3|// path handling, staging containment, structured argv, environment\n4|// allowlists, terminal control-string escaping, and secret redaction for\n5|// free-text streams.\n6|//\n7|// The package is a library behind production launch and rendering paths,\n8|// not a second authority beside them:\n9|//\n10|//   - path grammars stay in internal/scalar: CheckMemberPath admits exactly\n11|//     the scalar relative-path grammar plus the Windows alternate-stream,\n12|//     trailing-dot/space, and reserved-device rules Section 16.3 names, and\n13|//     delegates every shared rule to scalar rather than retyping it;\n14|//   - byte-counted exec rules (Provider SpawnPlan argv and env literals,\n15|//     Section 5.1) stay in internal/provhost: that package validates the\n16|//     wire plan, while this package builds the launch environment and\n17|//     validates the argv vector at process start;\n18|//   - environment-name grammar is owned here and internal/provhost delegates\n19|//     to it, so the two packages cannot drift on what a name is;\n20|//   - Structured Error detail redaction stays in internal/axerror: that\n21|//     package refuses exact credential keys and causal leaks on the error\n22|//     wire, while this package scrubs free-text streams (stderr, logs,\n23|//     terminal rendering) where no key gate can see;\n24|//   - SSH argv admission stays in internal/config and the provider entry\n25|//     point rule (`ax pane SESSION_ID`) stays in internal/terminalbackend:\n26|//     both are closed vocabularies over their own domain, not instances of\n27|//     the generic argv rule here;\n28|//   - the five-variable AX_* path registry stays in internal/config and\n29|//     internal/localstore, which already implement AC-PATH-001.\n30|//\n31|// Trust for external executables is deliberately not implemented here.\n32|// internal/provider.trustCandidate and internal/terminalbackend.DigestFile\n33|// already establish trust with different fact sets because their\n34|// specifications differ: Section 7.1 requires the approving owner identity\n35|// beside the canonical path and digest for provider plugins, while the\n36|// Section 4.B trust tuple carries platform, adapter identity, manifest and\n37|// probe digests with no owner fact. A third path here would be another\n38|// copy, not convergence; the difference is contractual, not accidental.\n39|//\n40|// Every refusal is a plain *Error naming the kind, rule, and member:\n41|// facades keep their own refusal dialects, so this package names rules\n42|// instead of minting codes, following internal/environ.\n43|//\n44|// Stated bounds. This package mutates no durable state and keeps no cache:\n45|// Guard resolution is lexical, OpenNoFollowFile opens read-only, and every\n46|// other entry point is a pure function of its input. Crash and idempotency\n47|// handling therefore have no surface here: there is no journal to recover\n48|// and no second actor to collide with. Tombstone deletion scope (Section\n49|// 16.3 \"broad deletion from tombstones\") has no implementation in this\n50|// repository yet and is not modeled. The operator default for which\n51|// environment names a provider plugin inherits is product policy with no\n52|// in-repo provider implementation to derive needs from, so BuildEnv takes\n53|// the allowlist explicitly and ExecRunner inherits the parent environment\n54|// until the operator supplies one. Grapheme-width policing stops at the\n55|// enumerated invisible controls: full East-Asian/emoji width measurement\n56|// needs terminal width tables this package does not carry. Content-level\n57|// secret scrubbing is best-effort by specification (Section 16.2 claims no\n58|// reliable scrubbing), and Redact states exactly the three shapes it\n59|// decides.\n60|package secprim","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
