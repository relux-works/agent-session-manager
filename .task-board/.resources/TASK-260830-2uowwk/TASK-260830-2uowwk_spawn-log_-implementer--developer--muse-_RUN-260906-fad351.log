{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf27","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":1518,"recorded_at":1780531400003031,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"ffb43dfc-db47-42d8-8783-07e6642bbcbe"},"task_id":"ffb43dfc-db47-42d8-8783-07e6642bbcbe","event":{"kind":"output","task_id":"ffb43dfc-db47-42d8-8783-07e6642bbcbe","chunk":"Read text file `internal/specdoc/embed_reach_test.go`.\n1|package specdoc_test\n2|\n3|import (\n4|\t\"go/parser\"\n5|\t\"go/token\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|)\n14|\n15|const modulePath = \"github.com/relux-works/agent-session-manager\"\n16|\n17|// TestEmbeddedDocumentNeverReachesAProductBinary is the guard behind the claim\n18|// this package's documentation and README.md both make: the embedded SPEC.md is\n19|// a verification input for repository gates and never ships inside a product\n20|// command.\n21|//\n22|// The claim was true by accident until internal/traceability began measuring a\n23|// section's clause inventory from this package, which put it on the import path\n24|// of non-test code for the first time. There is no ax main package yet, so the\n25|// property still holds today; this test is what makes it stay true the moment\n26|// one exists, instead of an 883 KiB embed reaching the product silently.\n27|//\n28|// The import graph is read from the source tree with go/parser rather than from\n29|// the toolchain, so the test needs no network, no build cache and no external\n30|// command. Build constraints are ignored deliberately: counting every file's\n31|// imports over-approximates reachability, which is the safe direction for a\n32|// guard.\n33|func TestEmbeddedDocumentNeverReachesAProductBinary(t *testing.T) {\n34|\tt.Parallel()\n35|\n36|\troot := filepath.Join(\"..\", \"..\")\n37|\tpackages, mains := parseModulePackages(t, root)\n38|\n39|\t// The only main package allowed to reach the embedded document. tracecheck\n40|\t// is the specification-to-code ownership gate; cataloggen touches the\n41|\t// document from its test binary only, which never ships.\n42|\tallowed := map[string]struct{}{\n43|\t\tmodulePath + \"/internal/traceability/cmd/tracecheck\": {},\n44|\t}\n45|\n46|\ttarget := modulePath + \"/internal/specdoc\"\n47|\tif _, ok := packages[target]; !ok {\n48|\t\tt.Fatalf(\"package graph does not contain %q; the walk found %d packages\", target, len(packages))\n49|\t}\n50|\n51|\tsort.Strings(mains)\n52|\tif len(mains) == 0 {\n53|\t\tt.Fatal(\"package graph found no main package; the walk is not reaching the command tree\")\n54|\t}\n55|\tfor _, violation := range unauthorizedReaches(packages, mains, allowed, target) {\n56|\t\tt.Errorf(\"%s; the embedded specification document must not ship in a product command\", violation)\n57|\t}\n58|\n59|\t// Anti-vacuity, two ways. The walk has to be able to see a real path, and\n60|\t// the detector has to report one when a disallowed main has it.\n61|\tgate := modulePath + \"/internal/traceability/cmd/tracecheck\"\n62|\tpath, reaches := importPathTo(packages, gate, target)\n63|\tif !reaches {\n64|\t\tt.Fatalf(\"import walk found no path from %q to %q, so it cannot detect one either\", gate, target)\n65|\t}\n66|\tif len(path) < 2 {\n67|\t\tt.Fatalf(\"import path %v from %q is degenerate\", path, gate)\n68|\t}\n69|\tif _, permitted := allowed[gate]; !permitted {\n70|\t\tt.Fatalf(\"allow list no longer contains %q, so the real path above would already be a violation\", gate)\n71|\t}\n72|\n73|\t// Plant the command this guard exists for. cmd/ax does not exist yet, so it\n74|\t// is introduced into a copy of the real graph, importing a real package that\n75|\t// really reaches specdoc.\n76|\tplanted := make(map[string][]string, len(packages)+1)\n77|\tfor importPath, imports := range packages {\n78|\t\tplanted[importPath] = imports\n79|\t}\n80|\tproduct := modulePath + \"/cmd/ax\"\n81|\tplanted[product] = []string{modulePath + \"/internal/traceability\"}\n82|\tviolations := unauthorizedReaches(planted, append(append([]string(nil), mains...), product), allowed, target)\n83|\tif len(violations) != 1 || !strings.Contains(violations[0], product) {\n84|\t\tt.Fatalf(\"planted cmd/ax violations = %v, want exactly one naming %q\", violations, product)\n85|\t}\n86|\tif !strings.Contains(violations[0], target) {\n87|\t\tt.Fatalf(\"planted violation %q does not name the reached package %q\", violations[0], target)\n88|\t}\n89|}\n90|\n91|// unauthorizedReaches is the detector both the real graph and the planted\n92|// mutant drive. It returns one message per main package outside allowed that\n93|// can reach target.\n94|func unauthorizedReaches(packages map[string][]string, mains []string, allowed map[string]struct{}, target string) []string {\n95|\tvar violations []string\n96|\tfor _, main := range mains {\n97|\t\tif _, permitted := allowed[main]; permitted {\n98|\t\t\tcontinue\n99|\t\t}\n100|\t\tpath, reaches := importPathTo(packages, main, target)\n101|\t\tif !reaches {\n102|\t\t\tcontinue\n103|\t\t}\n104|\t\tviolations = append(violations, \"main package \"+main+\" reaches \"+target+\" through \"+strings.Join(path, \" -> \"))\n105|\t}\n106|\tsort.Strings(violations)\n107|\treturn violations\n108|}\n109|\n110|// parseModulePackages reads every non-test Go file in the module and returns\n111|// the import graph keyed by import path, plus every main package's import path.\n112|func parseModulePackages(t *testing.T, root string) (map[string][]string, []string) {\n113|\tt.Helper()\n114|\tpackages := make(map[string][]string)\n115|\tnames := make(map[string]string)\n116|\tfileSet := token.NewFileSet()\n117|\n118|\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n119|\t\tif err != nil {\n120|\t\t\treturn err\n121|\t\t}\n122|\t\tif entry.IsDir() {\n123|\t\t\tbase := entry.Name()\n124|\t\t\tif path != root && (strings.HasPrefix(base, \".\") || base == \"testdata\" || base == \"vendor\") {\n125|\t\t\t\treturn filepath.SkipDir\n126|\t\t\t}\n127|\t\t\treturn nil\n128|\t\t}\n129|\t\tif !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n130|\t\t\treturn nil\n131|\t\t}\n132|\t\tfile, parseErr := parser.ParseFile(fileSet, path, nil, parser.ImportsOnly)\n133|\t\tif parseErr != nil {\n134|\t\t\treturn parseErr\n135|\t\t}\n136|\t\trelative, relErr := filepath.Rel(root, filepath.Dir(path))\n137|\t\tif relErr != nil {\n138|\t\t\treturn relErr\n139|\t\t}\n140|\t\timportPath := modulePath\n141|\t\tif relative != \".\" {\n142|\t\t\timportPath = modulePath + \"/\" + filepath.ToSlash(relative)\n143|\t\t}\n144|\t\tnames[importPath] = file.Name.Name\n145|\t\tfor _, specification := range file.Imports {\n146|\t\t\tvalue, unquoteErr := strconv.Unquote(specification.Path.Value)\n147|\t\t\tif unquoteErr != nil {\n148|\t\t\t\treturn unquoteErr\n149|\t\t\t}\n150|\t\t\tif strings.HasPrefix(value, modulePath) {\n151|\t\t\t\tpackages[importPath] = append(packages[importPath], value)\n152|\t\t\t}\n153|\t\t}\n154|\t\tif _, seen := packages[importPath]; !seen {\n155|\t\t\tpackages[importPath] = nil\n156|\t\t}\n157|\t\treturn nil\n158|\t})\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"walk module source: %v\", err)\n161|\t}\n162|\tif len(packages) == 0 {\n163|\t\tt.Fatalf(\"walk of %q found no Go packages\", root)\n164|\t}\n165|\n166|\tvar mains []string\n167|\tfor importPath, name := range names {\n168|\t\tif name == \"main\" {\n169|\t\t\tmains = append(mains, importPath)\n170|\t\t}\n171|\t}\n172|\treturn packages, mains\n173|}\n174|\n175|// importPathTo returns the first import chain from source to target, if any.\n176|func importPathTo(packages map[string][]string, source, target string) ([]string, bool) {\n177|\tvisited := map[string]struct{}{source: {}}\n178|\ttype entry struct {\n179|\t\timportPath string\n180|\t\tchain      []string\n181|\t}\n182|\tqueue := []entry{{importPath: source, chain: []string{source}}}\n183|\tfor len(queue) > 0 {\n184|\t\tcurrent := queue[0]\n185|\t\tqueue = queue[1:]\n186|\t\tfor _, next := range packages[current.importPath] {\n187|\t\t\tif next == target {\n188|\t\t\t\treturn append(append([]string(nil), current.chain...), next), true\n189|\t\t\t}\n190|\t\t\tif _, seen := visited[next]; seen {\n191|\t\t\t\tcontinue\n192|\t\t\t}\n193|\t\t\tvisited[next] = struct{}{}\n194|\t\t\tqueue = append(queue, entry{importPath: next, chain: append(append([]string(nil), current.chain...), next)})\n195|\t\t}\n196|\t}\n197|\treturn nil, false\n198|}\n199|\n200|// TestModuleHasNoProductCommandYet records the fact the guard above depends on\n201|// for its present-tense claim. When an ax command lands this fails, and whoever\n202|// lands it has to decide deliberately whether the guard's allow list changes.\n203|func TestModuleHasNoProductCommandYet(t *testing.T) {\n204|\tt.Parallel()\n205|\n206|\t_, mains := parseModulePackages(t, filepath.Join(\"..\", \"..\"))\n207|\tsort.Strings(mains)\n208|\twant := []string{\n209|\t\tmodulePath + \"/internal/catalog/cmd/cataloggen\",\n210|\t\tmodulePath + \"/internal/traceability/cmd/tracecheck\",\n211|\t}\n212|\tif len(mains) != len(want) {\n213|\t\tt.Fatalf(\"module main packages = %v, want exactly the two repository gates %v\", mains, want)\n214|\t}\n215|\tfor index := range want {\n216|\t\tif mains[index] != want[index] {\n217|\t\t\tt.Fatalf(\"module main packages = %v, want exactly the two repository gates %v\", mains, want)\n218|\t\t}\n219|\t}\n220|\tif _, err := os.Stat(filepath.Join(\"..\", \"..\", \"cmd\", \"ax\")); err == nil {\n221|\t\tt.Fatal(\"cmd/ax exists; re-decide whether the embedded specification document may reach it\")\n222|\t}\n223|}"}}}
