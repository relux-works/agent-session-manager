{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a7","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":174,"recorded_at":1780531400000343,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0cbe87e6089d3dc57935b5965","text":"Read text file `internal/secconftest/runner.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"hash/fnv\"\n6|\t\"sort\"\n7|\t\"sync/atomic\"\n8|)\n9|\n10|// Calls counts production entry-point invocations. A fixture receives a\n11|// counter and must record every production call it makes; the Runner\n12|// refuses fixtures that record none, so a corpus that never reaches the\n13|// entry point cannot pass as coverage.\n14|type Calls struct {\n15|\tcount atomic.Int64\n16|}\n17|\n18|// Add records n production calls.\n19|func (calls *Calls) Add(n int64) {\n20|\tcalls.count.Add(n)\n21|}\n22|\n23|// Count reports the recorded calls.\n24|func (calls *Calls) Count() int64 {\n25|\treturn calls.count.Load()\n26|}\n27|\n28|// Fixture is one named deterministic case. Run must be a pure function\n29|// of Seed: same seed, same report string. It receives a fresh Calls\n30|// counter and must record each production entry-point invocation it\n31|// performs.\n32|type Fixture struct {\n33|\tName string\n34|\tRun  func(seed uint64, calls *Calls) (report string, err error)\n35|}\n36|\n37|// Result is the executed record of one fixture.\n38|type Result struct {\n39|\tName   string\n40|\tReport string\n41|\tCalls  int64\n42|}\n43|\n44|// Runner executes fixtures in sorted name order over an explicit seed.\n45|// Registration order and Go map iteration order never affect execution:\n46|// names are sorted before every run, so identical inputs produce one\n47|// answer no matter how the caller stored the fixtures.\n48|type Runner struct {\n49|\t// AllowUnreached disables the arrival check. It exists only so the\n50|\t// suite can prove the check is load-bearing: with it set, an\n51|\t// unreached fixture passes, and TestRunnerRefusesUnreachedFixture\n52|\t// pins that the default refuses. Production use leaves the zero\n53|\t// value.\n54|\tAllowUnreached bool\n55|}\n56|\n57|// Run executes every fixture once and returns results in sorted name\n58|// order. A fixture that records zero production calls is refused with\n59|// an error naming it, unless AllowUnreached is set.\n60|func (runner Runner) Run(fixtures []Fixture, seed uint64) ([]Result, error) {\n61|\tordered := append([]Fixture(nil), fixtures...)\n62|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Name < ordered[j].Name })\n63|\tresults := make([]Result, 0, len(ordered))\n64|\tfor _, fixture := range ordered {\n65|\t\tvar calls Calls\n66|\t\treport, err := fixture.Run(seed, &calls)\n67|\t\tif err != nil {\n68|\t\t\treturn nil, fmt.Errorf(\"secconftest runner: fixture %q: %w\", fixture.Name, err)\n69|\t\t}\n70|\t\tif !runner.AllowUnreached && calls.Count() == 0 {\n71|\t\t\treturn nil, fmt.Errorf(\"secconftest runner: fixture %q recorded no production call\", fixture.Name)\n72|\t\t}\n73|\t\tresults = append(results, Result{Name: fixture.Name, Report: report, Calls: calls.Count()})\n74|\t}\n75|\treturn results, nil\n76|}\n77|\n78|// Digest folds the execution log into one FNV-64 hex value: fixture\n79|// names, reports, and call counts in execution order. Two runs with\n80|// identical inputs produce identical digests; any dropped, reordered,\n81|// or altered fixture changes it.\n82|func Digest(results []Result) string {\n83|\tsum := fnv.New64a()\n84|\tfor _, result := range results {\n85|\t\t_, _ = fmt.Fprintf(sum, \"%s\\x00%s\\x00%d\\x00\", result.Name, result.Report, result.Calls)\n86|\t}\n87|\treturn fmt.Sprintf(\"%016x\", sum.Sum64())\n88|}\n89|\n90|// SortedNames reports the execution order for a fixture list. It shares\n91|// the sort with Run so the order claim is testable in isolation.\n92|func SortedNames(fixtures []Fixture) []string {\n93|\tordered := append([]Fixture(nil), fixtures...)\n94|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i].Name < ordered[j].Name })\n95|\tnames := make([]string, 0, len(ordered))\n96|\tfor _, fixture := range ordered {\n97|\t\tnames = append(names, fixture.Name)\n98|\t}\n99|\treturn names\n100|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a9","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":175,"recorded_at":1780531400000345,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0cc6f7b419de384efcfb4e8e6","text":"Read text file `internal/secconftest/hostile.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n8|)\n9|\n10|// HostileClass is one spec-derived hostile-input class: the exact\n11|// specification phrase it comes from, the section that phrase lives\n12|// in, and the production gate that decides its members.\n13|//\n14|// The roster is derived, not listed: TestHostileRosterQuotesResolve\n15|// requires every Quote to occur in its Section in the pinned document,\n16|// so a class added to or removed from the specification fails the\n17|// roster instead of passing silently. Members are generated from\n18|// Unicode tables and internal/scalar predicates, never from the\n19|// secprim tables under test, so deleting a gate arm keeps the corpus\n20|// and reddens the gate test instead of shrinking the witness with it.\n21|type HostileClass struct {\n22|\t// ID is the stable slug naming the class in test output.\n23|\tID string\n24|\t// Section is the AX specification section the Quote is drawn from.\n25|\tSection string\n26|\t// Quote is the exact specification phrase deriving this class.\n27|\tQuote string\n28|\t// Gate names the production entry point deciding the members.\n29|\tGate string\n30|}\n31|\n32|// Roster lists every hostile class this instrument drives.\n33|func Roster() []HostileClass {\n34|\treturn []HostileClass{\n35|\t\t{ID: \"path-traversal\", Section: \"16.3\", Quote: \"path traversal\", Gate: \"secprim.CheckMemberPath\"},\n36|\t\t{ID: \"path-absolute\", Section: \"16.3\", Quote: \"absolute paths\", Gate: \"secprim.CheckMemberPath\"},\n37|\t\t{ID: \"path-drive-unc\", Section: \"16.3\", Quote: \"drive/UNC injection\", Gate: \"secprim.CheckMemberPath\"},\n38|\t\t{ID: \"path-altstream\", Section: \"16.3\", Quote: \"alternate streams\", Gate: \"secprim.CheckMemberPath\"},\n39|\t\t{ID: \"path-encoded-separator\", Section: \"16.3\", Quote: \"repeatedly encoded separators\", Gate: \"secprim.CheckMemberPath\"},\n40|\t\t{ID: \"path-symlink-escape\", Section: \"16.3\", Quote: \"symlink/reparse escape during both validation and commit\", Gate: \"secprim.Guard.Open\"},\n41|\t\t{ID: \"path-case-collision\", Section: \"16.3\", Quote: \"case-fold collisions on case-insensitive destinations\", Gate: \"secprim.DetectCaseCollision\"},\n42|\t\t{ID: \"path-unmanaged\", Section: \"16.3\", Quote: \"replacement of unmanaged paths\", Gate: \"secprim.Guard.Resolve\"},\n43|\t\t{ID: \"path-device\", Section: \"16.3\", Quote: \"device/FIFO/socket creation\", Gate: \"secprim.CheckMemberPath\"},\n44|\t\t{ID: \"argv-vector\", Section: \"16.4\", Quote: \"Shell command construction from names, paths, provider output, or peer data is forbidden\", Gate: \"secprim.CheckArgv\"},\n45|\t\t{ID: \"env-allowlist\", Section: \"16.7\", Quote: \"minimal environment allowlists\", Gate: \"secprim.IsEnvName\"},\n46|\t\t{ID: \"render-ansi-osc\", Section: \"16.7\", Quote: \"ANSI/OSC sequences\", Gate: \"secprim.EscapeForTerminal\"},\n47|\t\t{ID: \"render-controls\", Section: \"16.7\", Quote: \"control characters\", Gate: \"secprim.EscapeForTerminal\"},\n48|\t\t{ID: \"render-bidi\", Section: \"16.7\", Quote: \"bidi overrides\", Gate: \"secprim.EscapeForTerminal\"},\n49|\t\t{ID: \"render-encoding\", Section: \"16.7\", Quote: \"invalid encodings\", Gate: \"secprim.EscapeForTerminal\"},\n50|\t\t{ID: \"render-width\", Section: \"16.7\", Quote: \"hostile-width graphemes\", Gate: \"secprim.EscapeForTerminal\"},\n51|\t\t{ID: \"redact-persisted\", Section: \"16.4\", Quote: \"redacted before persistence\", Gate: \"secprim.Redact\"},\n52|\t\t{ID: \"redact-credentials\", Section: \"16.2\", Quote: \"API keys, OAuth tokens\", Gate: \"secprim.Redact\"},\n53|\t}\n54|}\n55|\n56|// QuoteInSection reports whether quote occurs on at least one document\n57|// line inside section. The section check is load-bearing, not\n58|// ceremony: TestQuoteInSectionRejectsWrongSection drives a real quote\n59|// against a wrong section and requires refusal, so a mutant that\n60|// preserves the token match but drops the section check fails. The\n61|// mutant harness for that test executes the full behavioral hostile\n62|// battery, not only this checker.\n63|func QuoteInSection(document *specdoc.Document, quote, section string) error {\n64|\tif document == nil {\n65|\t\treturn fmt.Errorf(\"secconftest: nil specification document is never a legitimate absence\")\n66|\t}\n67|\tif strings.TrimSpace(quote) == \"\" {\n68|\t\treturn fmt.Errorf(\"secconftest: empty quote matches nothing\")\n69|\t}\n70|\tlines := document.QuoteLines(quote)\n71|\tif len(lines) == 0 {\n72|\t\treturn fmt.Errorf(\"secconftest: quote %q occurs nowhere in the pinned document\", quote)\n73|\t}\n74|\tfor _, line := range lines {\n75|\t\tif got, ok := document.SectionID(line); ok && got == section {\n76|\t\t\treturn nil\n77|\t\t}\n78|\t}\n79|\treturn fmt.Errorf(\"secconftest: quote %q occurs but never in section %s\", quote, section)\n80|}\n81|\n82|// bidiOverrideRunes enumerates the Section 16.7 bidi class from the\n83|// Unicode code chart, not from the gate under test: embeddings and\n84|// overrides U+202A-U+202E, isolates U+2066-U+2069, directional marks\n85|// U+200E, U+200F, U+061C, and zero-width U+200B-U+200D plus U+FEFF.\n86|// The static list is the point: a gate arm deleted with its test row\n87|// still faces every rune here.\n88|func bidiOverrideRunes() []rune {\n89|\treturn []rune{\n90|\t\t0x202a, 0x202b, 0x202c, 0x202d, 0x202e,\n91|\t\t0x2066, 0x2067, 0x2068, 0x2069,\n92|\t\t0x200e, 0x200f, 0x061c,\n93|\t\t0x200b, 0x200c, 0x200d,\n94|\t\t0xfeff,\n95|\t}\n96|}\n97|\n98|// Members generates the hostile inputs for a roster class ID. Every\n99|// member carries the class token (for example \"..\" for traversal):\n100|// the gates must refuse behavior, not merely match the token, and the\n101|// per-class gate tests assert refusal of every member, so a\n102|// token-preserving behavior change still reddens.\n103|func Members(id string) []string {\n104|\twrap := func(runes []rune) []string {\n105|\t\tmembers := make([]string, 0, len(runes))\n106|\t\tfor _, character := range runes {\n107|\t\t\tmembers = append(members, \"a\"+string(character)+\"b\")\n108|\t\t}\n109|\t\treturn members\n110|\t}\n111|\tswitch id {\n112|\tcase \"path-traversal\":\n113|\t\treturn []string{\"../evil\", \"a/../../evil\", \"..\", \"a/../b\", \"a/b/../../../../c\", \"....//evil\"}\n114|\tcase \"path-absolute\":\n115|\t\treturn []string{\"/etc/passwd\", \"/\", \"/a/b\"}\n116|\tcase \"path-drive-unc\":\n117|\t\treturn []string{\"C:/Windows\", \"C:relative\", \"d:foo\", \"//server/share\", `\\\\server\\share`}\n118|\tcase \"path-altstream\":\n119|\t\treturn []string{\"file:stream\", \"dir/file:ads\", \"file:$DATA\"}\n120|\tcase \"path-encoded-separator\":\n121|\t\treturn []string{\"a%2fb\", \"a%5cb\", \"a%252fb\", \"a%2F..%2Fb\", \"%2e%2e/evil\", \"a/%2e%2e/b\", \"%2E%2E\", \"a%c0%afb\", \"a%C0%AFb\"}\n122|\tcase \"path-case-collision\":\n123|\t\treturn []string{\"readme.md\", \"README.MD\", \"ReadMe.Md\", \"STAGING/MEMBER\", \"Staging/Member\"}\n124|\tcase \"path-unmanaged\":\n125|\t\treturn []string{\"outside-managed\", \"staging/other\", \"secret\"}\n126|\tcase \"path-device\":\n127|\t\treturn []string{\"NUL\", \"CON\", \"COM1\", \"LPT1.txt\", \"aux.log\", \"dir/PRN\", \"COM9\", \"nul\"}\n128|\tcase \"argv-vector\":\n129|\t\treturn []string{\"; rm -rf /\", \"$(evil)\", \"`evil`\", \"a|b\", \"a&&b\", \"a\\nb\", \"--flag=value with spaces\"}\n130|\tcase \"env-allowlist\":\n131|\t\treturn []string{\"\", \"0\", \"1ABC\", \"A-B\", \"A B\", \"A.B\", \"A/B\", \"A\\x00B\", strings.Repeat(\"A\", 129)}\n132|\tcase \"render-ansi-osc\":\n133|\t\treturn []string{\"a\\x1b[31mb\", \"a\\x1b[0mb\", \"a\\x1b]8;;https://evil\\x07b\", \"a\\x9bb\"}\n134|\tcase \"render-controls\":\n135|\t\t// C0 controls except newline and tab (which the gate keeps),\n136|\t\t// DEL, and C1 controls: the exact refused set the section\n137|\t\t// names as \"control characters\". Printable runes are not\n138|\t\t// hostile and are not members.\n139|\t\tvar runes []rune\n140|\t\tfor character := rune(0); character < 0x20; character++ {\n141|\t\t\tif character == '\\n' || character == '\\t' {\n142|\t\t\t\tcontinue\n143|\t\t\t}\n144|\t\t\trunes = append(runes, character)\n145|\t\t}\n146|\t\trunes = append(runes, 0x7f)\n147|\t\tfor character := rune(0x80); character < 0xa0; character++ {\n148|\t\t\trunes = append(runes, character)\n149|\t\t}\n150|\t\treturn wrap(runes)\n151|\tcase \"render-bidi\":\n152|\t\treturn wrap([]rune{0x202a, 0x202b, 0x202c, 0x202d, 0x202e, 0x2066, 0x2067, 0x2068, 0x2069})\n153|\tcase \"render-encoding\":\n154|\t\treturn []string{\"a\\xffb\", \"a\\xfeb\", \"\\xff\", \"\\xfe\", \"a\\xed\\xa0\\x80b\"}\n155|\tcase \"render-width\":\n156|\t\treturn wrap([]rune{0x200e, 0x200f, 0x061c, 0x200b, 0x200c, 0x200d, 0xfeff})\n157|\tcase \"redact-persisted\":\n158|\t\treturn []string{\n159|\t\t\t\"-----BEGIN RSA PRIVATE KEY-----\\nMIIB\\n-----END RSA PRIVATE KEY-----\",\n160|\t\t\t\"key without end -----BEGIN RSA PRIVATE KEY-----\\nMIIB\",\n161|\t\t\t\"https://deploy:s3cret@example.com/repo\",\n162|\t\t\t\"password=hunter2\",\n163|\t\t}\n164|\tcase \"redact-credentials\":\n165|\t\treturn []string{\n166|\t\t\t\"api_key=[REDACTED]\",\n167|\t\t\t\"authorization: Bearer [REDACTED]\",\n168|\t\t\t`\"token\": \"[REDACTED]\"`,\n169|\t\t\t\"cookie=sessionid=abc123\",\n170|\t\t\t\"subscription_token=st_live_42\",\n171|\t\t}\n172|\tdefault:\n173|\t\treturn nil\n174|\t}\n175|}\n176|\n177|// BidiRunes exposes the full bidi/zero-width rune list for gate tests\n178|// that must assert the enumerated set without retyping it.\n179|func BidiRunes() []rune {\n180|\treturn bidiOverrideRunes()\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ab","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":176,"recorded_at":1780531400000347,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0cd047600a06c4d294f1dabaf","text":"Read text file `internal/secconftest/skip.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|)\n13|\n14|// Capability is one platform capability a test may need. Probe reports\n15|// whether it holds here and now; StrictGOOS lists the GOOS values\n16|// where absence is a failure rather than a skip. A skip asserts \"this\n17|// cannot run here\": the probe must really attempt the capability, and\n18|// an unexpected skip on a strict platform must fail rather than pass\n19|// quietly.\n20|type Capability struct {\n21|\t// ID is the stable slug naming the capability in reports.\n22|\tID string\n23|\t// Detail explains what the probe attempts.\n24|\tDetail string\n25|\t// Probe attempts the capability and reports availability.\n26|\tProbe func() (ok bool, reason string)\n27|\t// StrictGOOS names platforms where unavailability fails the test.\n28|\tStrictGOOS []string\n29|}\n30|\n31|// Verdict is the outcome of requiring one capability.\n32|type Verdict struct {\n33|\tID      string\n34|\tSkipped bool\n35|\tFailed  bool\n36|\tReason  string\n37|}\n38|\n39|// decision is the testable core of Require: pass, skip, or fail for a\n40|// probed capability. It carries no testing handle so the table test\n41|// can drive every arm, including the failing ones, without failing\n42|// the suite.\n43|type decision int\n44|\n45|const (\n46|\tdecisionPass decision = iota\n47|\tdecisionSkip\n48|\tdecisionFail\n49|)\n50|\n51|func decide(capability Capability, ok bool) decision {\n52|\tif capability.ID == \"\" || capability.Probe == nil {\n53|\t\treturn decisionFail\n54|\t}\n55|\tif ok {\n56|\t\treturn decisionPass\n57|\t}\n58|\tif strictOn(capability) {\n59|\t\treturn decisionFail\n60|\t}\n61|\treturn decisionSkip\n62|}\n63|\n64|// SymlinkCapability probes symlink creation and Lstat identification\n65|// in a fresh temporary directory. Symlink-escape commit tests require\n66|// it; Windows hosts without privilege report unavailable.\n67|func SymlinkCapability() Capability {\n68|\treturn Capability{\n69|\t\tID:     \"symlink\",\n70|\t\tDetail: \"create a symlink in a temp dir and identify it with Lstat\",\n71|\t\tProbe: func() (bool, string) {\n72|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-symlink\")\n73|\t\t\tif err != nil {\n74|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n75|\t\t\t}\n76|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n77|\t\t\ttarget := filepath.Join(dir, \"target\")\n78|\t\t\tlink := filepath.Join(dir, \"link\")\n79|\t\t\tif err := os.WriteFile(target, []byte(\"x\"), 0o600); err != nil {\n80|\t\t\t\treturn false, fmt.Sprintf(\"write target: %v\", err)\n81|\t\t\t}\n82|\t\t\tif err := os.Symlink(target, link); err != nil {\n83|\t\t\t\treturn false, fmt.Sprintf(\"symlink: %v\", err)\n84|\t\t\t}\n85|\t\t\tinfo, err := os.Lstat(link)\n86|\t\t\tif err != nil {\n87|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n88|\t\t\t}\n89|\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n90|\t\t\t\treturn false, \"created link is not a symlink\"\n91|\t\t\t}\n92|\t\t\treturn true, \"symlink create+identify works\"\n93|\t\t},\n94|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n95|\t}\n96|}\n97|\n98|// FifoCapability probes named-pipe creation: it builds a real FIFO\n99|// in a fresh temporary directory and identifies it with Lstat. It is\n100|// unavailable on Windows by construction, so Windows is not strict:\n101|// the special-file gate there is covered by other means, stated on\n102|// the callers. A probe that returned true without creating anything\n103|// would advertise an unbuilt capability; TestSkipFifoFixtureExchangesBytes\n104|// drives a second FIFO through the same helper so the probe cannot\n105|// pass while fixtures cannot build.\n106|func FifoCapability() Capability {\n107|\treturn Capability{\n108|\t\tID:     \"fifo\",\n109|\t\tDetail: \"create a named pipe in a temp dir and identify it with Lstat\",\n110|\t\tProbe: func() (bool, string) {\n111|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-fifo\")\n112|\t\t\tif err != nil {\n113|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n114|\t\t\t}\n115|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n116|\t\t\tpath, err := makeFifo(dir, \"probe\")\n117|\t\t\tif err != nil {\n118|\t\t\t\treturn false, fmt.Sprintf(\"mkfifo: %v\", err)\n119|\t\t\t}\n120|\t\t\tinfo, err := os.Lstat(path)\n121|\t\t\tif err != nil {\n122|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n123|\t\t\t}\n124|\t\t\tif info.Mode()&os.ModeNamedPipe == 0 {\n125|\t\t\t\treturn false, \"created file is not a named pipe\"\n126|\t\t\t}\n127|\t\t\treturn true, \"named-pipe create+identify works\"\n128|\t\t},\n129|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n130|\t}\n131|}\n132|\n133|// ModeBitsCapability probes whether permission bits are enforceable:\n134|// it removes all permissions from a temp file and checks the open\n135|// fails. Root bypasses mode bits and Windows ACLs do not express\n136|// them, so neither is strict.\n137|func ModeBitsCapability() Capability {\n138|\treturn Capability{\n139|\t\tID:     \"mode-bits\",\n140|\t\tDetail: \"chmod 000 a temp file and require the open to fail\",\n141|\t\tProbe: func() (bool, string) {\n142|\t\t\tif runtime.GOOS == \"windows\" {\n143|\t\t\t\treturn false, \"Windows ACLs do not express mode bits\"\n144|\t\t\t}\n145|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-modebits\")\n146|\t\t\tif err != nil {\n147|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n148|\t\t\t}\n149|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n150|\t\t\tpath := filepath.Join(dir, \"guarded\")\n151|\t\t\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n152|\t\t\t\treturn false, fmt.Sprintf(\"write: %v\", err)\n153|\t\t\t}\n154|\t\t\tif err := os.Chmod(path, 0); err != nil {\n155|\t\t\t\treturn false, fmt.Sprintf(\"chmod: %v\", err)\n156|\t\t\t}\n157|\t\t\tfile, err := os.Open(path)\n158|\t\t\tif err != nil {\n159|\t\t\t\treturn true, \"mode bits enforced\"\n160|\t\t\t}\n161|\t\t\t_ = file.Close()\n162|\t\t\treturn false, \"open succeeded despite mode 000 (root or unenforceable bits)\"\n163|\t\t},\n164|\t}\n165|}\n166|\n167|// NonRootCapability probes that the suite does not run as superuser.\n168|// Permission-refusal vectors that need denial require it.\n169|func NonRootCapability() Capability {\n170|\treturn Capability{\n171|\t\tID:     \"nonroot\",\n172|\t\tDetail: \"require a non-privileged uid on unix\",\n173|\t\tProbe: func() (bool, string) {\n174|\t\t\tif runtime.GOOS == \"windows\" {\n175|\t\t\t\treturn true, \"Windows: no unix superuser\"\n176|\t\t\t}\n177|\t\t\tif os.Geteuid() == 0 {\n178|\t\t\t\treturn false, \"running as root: permission denials are untestable\"\n179|\t\t\t}\n180|\t\t\treturn true, \"non-root user\"\n181|\t\t},\n182|\t}\n183|}\n184|\n185|// DefaultCapabilities lists every capability this instrument probes.\n186|func DefaultCapabilities() []Capability {\n187|\treturn []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability(), NonRootCapability()}\n188|}\n189|\n190|// strictOn reports whether id is strict on this host's GOOS.\n191|func strictOn(capability Capability) bool {\n192|\tfor _, goos := range capability.StrictGOOS {\n193|\t\tif goos == runtime.GOOS {\n194|\t\t\treturn true\n195|\t\t}\n196|\t}\n197|\treturn false\n198|}\n199|\n200|// report aggregates verdicts with a process-wide skip counter the\n201|// suite logs once, so the skip count on the host is evidence rather\n202|// than prose.\n203|var report struct {\n204|\tmutex   sync.Mutex\n205|\tskipped []string\n206|\tfailed  []string\n207|}\n208|\n209|func recordVerdict(verdict Verdict) {\n210|\treport.mutex.Lock()\n211|\tdefer report.mutex.Unlock()\n212|\tif verdict.Skipped {\n213|\t\treport.skipped = append(report.skipped, verdict.ID)\n214|\t}\n215|\tif verdict.Failed {\n216|\t\treport.failed = append(report.failed, verdict.ID)\n217|\t}\n218|}\n219|\n220|// SkippedIDs reports capability IDs skipped so far, sorted.\n221|func SkippedIDs() []string {\n222|\treport.mutex.Lock()\n223|\tdefer report.mutex.Unlock()\n224|\tout := append([]string(nil), report.skipped...)\n225|\tsort.Strings(out)\n226|\treturn out\n227|}\n228|\n229|// requireT is the minimal testing handle Require needs. *testing.T\n230|// satisfies it, and the wiring tests pass a fake that records Skipf\n231|// and Fatalf without aborting the suite — so both the skip and the\n232|// fail arms are driven through the real Require and their\n233|// recordVerdict calls are pinned (M04/M05). A fake that never sees\n234|// the verdict while the counters stay empty fails its test.\n235|type requireT interface {\n236|\tHelper()\n237|\tSkipf(format string, args ...any)\n238|\tFatalf(format string, args ...any)\n239|}\n240|\n241|// Require enforces one capability: it returns a passing verdict when\n242|// the probe holds, skips the test when the probe fails on a\n243|// non-strict platform, and fails the test when the probe fails on a\n244|// strict platform or the probe result contradicts a strict\n245|// expectation the caller states. Every skip and failure is recorded\n246|// for the final count.\n247|func Require(t requireT, capability Capability) Verdict {\n248|\tt.Helper()\n249|\tif capability.ID == \"\" || capability.Probe == nil {\n250|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: \"capability without identity or probe is unusable\"}\n251|\t\trecordVerdict(verdict)\n252|\t\tt.Fatalf(\"secconftest: capability %q has no identity or probe\", capability.ID)\n253|\t\treturn verdict\n254|\t}\n255|\tok, reason := capability.Probe()\n256|\tswitch decide(capability, ok) {\n257|\tcase decisionPass:\n258|\t\treturn Verdict{ID: capability.ID, Reason: reason}\n259|\tcase decisionFail:\n260|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: reason}\n261|\t\trecordVerdict(verdict)\n262|\t\tt.Fatalf(\"secconftest: capability %q unavailable on strict platform %s: %s\", capability.ID, runtime.GOOS, reason)\n263|\t\treturn verdict\n264|\tdefault:\n265|\t\tverdict := Verdict{ID: capability.ID, Skipped: true, Reason: reason}\n266|\t\trecordVerdict(verdict)\n267|\t\tt.Skipf(\"secconftest: capability %q unavailable here: %s\", capability.ID, reason)\n268|\t\treturn verdict\n269|\t}\n270|}\n271|\n272|// Report formats the capability skip/fail counts recorded so far on\n273|// this host. It reads the live counters: an empty suite records\n274|// nothing and reports zeros, and every recorded skip or failure moves\n275|// the numbers. Citing a Report line as host evidence is only honest\n276|// for verdicts the suite really recorded; the per-test skip datum is\n277|// the `--- SKIP` lines under `go test -v`, which reproduce without\n278|// any counter.\n279|func Report() string {\n280|\treport.mutex.Lock()\n281|\tskipped := append([]string(nil), report.skipped...)\n282|\tfailed := append([]string(nil), report.failed...)\n283|\treport.mutex.Unlock()\n284|\tsort.Strings(skipped)\n285|\tsort.Strings(failed)\n286|\treturn fmt.Sprintf(\"secconftest capabilities on %s: skipped=%d %q failed=%d %q\",\n287|\t\truntime.GOOS, len(skipped), strings.Join(skipped, \",\"), len(failed), strings.Join(failed, \",\"))\n288|}\n289|\n290|// snapshotReport copies the process-wide counters so a test can\n291|// record synthetic verdicts and restore the suite state afterwards.\n292|func snapshotReport() (skipped, failed []string) {\n293|\treport.mutex.Lock()\n294|\tdefer report.mutex.Unlock()\n295|\treturn append([]string(nil), report.skipped...), append([]string(nil), report.failed...)\n296|}\n297|\n298|// restoreReport replaces the process-wide counters, undoing synthetic\n299|// verdicts a test recorded. It exists only for test isolation.\n300|func restoreReport(skipped, failed []string) {\n301|\treport.mutex.Lock()\n302|\tdefer report.mutex.Unlock()\n303|\treport.skipped = append([]string(nil), skipped...)\n304|\treport.failed = append([]string(nil), failed...)\n305|}\n306|\n307|// LogReport logs the capability skip/fail counts on this host. Call\n308|// it after the suite recorded its verdicts so the line carries real\n309|// counters. It never skips or fails: it reports.\n310|func LogReport(t *testing.T) {\n311|\tt.Helper()\n312|\tt.Log(Report())\n313|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ad","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":177,"recorded_at":1780531400000349,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"call_id":"call_01a077f0cd6f79d2b63ae4f969e39187","text":"Read text file `internal/traceability/cmd/tracecheck/main.go`.\n1|// tracecheck is the headless CI entry point for AX specification-to-code\n2|// ownership verification. It reports inventory coverage, not runtime support.\n3|package main\n4|\n5|import (\n6|\t\"flag\"\n7|\t\"fmt\"\n8|\t\"io\"\n9|\t\"os\"\n10|\t\"strings\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/traceability\"\n13|)\n14|\n15|func main() {\n16|\tif err := run(os.Args[1:], os.Stdout); err != nil {\n17|\t\tfmt.Fprintln(os.Stderr, err)\n18|\t\tos.Exit(1)\n19|\t}\n20|}\n21|\n22|func run(arguments []string, stdout io.Writer) error {\n23|\tflags := flag.NewFlagSet(\"tracecheck\", flag.ContinueOnError)\n24|\tflags.SetOutput(io.Discard)\n25|\troot := flags.String(\"root\", \".\", \"repository root\")\n26|\tvar sections sectionFlags\n27|\tflags.Var(&sections, \"section\", \"assigned normative section or same-section range; repeat for multiple scopes\")\n28|\tif err := flags.Parse(arguments); err != nil {\n29|\t\treturn err\n30|\t}\n31|\tif flags.NArg() != 0 {\n32|\t\treturn fmt.Errorf(\"unexpected positional arguments: %v\", flags.Args())\n33|\t}\n34|\n35|\tvar report traceability.Report\n36|\tvar err error\n37|\tif len(sections) == 0 {\n38|\t\treport, err = traceability.VerifyRepository(os.DirFS(*root))\n39|\t} else {\n40|\t\treport, err = traceability.VerifyAssignedSections(os.DirFS(*root), sections)\n41|\t}\n42|\tif err != nil {\n43|\t\treturn err\n44|\t}\n45|\tif _, err = fmt.Fprintf(\n46|\t\tstdout,\n47|\t\t\"traceability ok: contracts=%d normative_sections=%d acceptance_cases=%d fixtures=%d compatibility_contracts=%d assigned_scopes=%d\\n\",\n48|\t\treport.Contracts,\n49|\t\treport.NormativeSections,\n50|\t\treport.AcceptanceCases,\n51|\t\treport.Fixtures,\n52|\t\treport.CompatibilityContracts,\n53|\t\treport.AssignedScopes,\n54|\t); err != nil {\n55|\t\treturn err\n56|\t}\n57|\t// Coverage is printed as the measured ratio it was computed from. A gate\n58|\t// that reported \"sections owned\" would repeat the claim this line exists to\n59|\t// contradict.\n60|\t_, err = fmt.Fprintf(\n61|\t\tstdout,\n62|\t\t\"section coverage: bindings=%d full=%d partial=%d sliver=%d unevidenced=%d unmeasured=%d unowned=%d clauses_discharged=%d/%d\\n\",\n63|\t\treport.SectionBindings,\n64|\t\treport.FullCoverage,\n65|\t\treport.PartialCoverage,\n66|\t\treport.SliverCoverage,\n67|\t\treport.UnevidencedCoverage,\n68|\t\treport.UnmeasuredCoverage,\n69|\t\treport.UnownedSections,\n70|\t\treport.DischargedClauses,\n71|\t\treport.NormativeClauses,\n72|\t)\n73|\treturn err\n74|}\n75|\n76|type sectionFlags []string\n77|\n78|func (sections *sectionFlags) String() string {\n79|\treturn strings.Join(*sections, \",\")\n80|}\n81|\n82|func (sections *sectionFlags) Set(value string) error {\n83|\t*sections = append(*sections, value)\n84|\treturn nil\n85|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
