{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fd","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":217,"recorded_at":1780531400000429,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"f1998126-35bb-40f9-aaea-f4635c4107be"},"task_id":"f1998126-35bb-40f9-aaea-f4635c4107be","event":{"kind":"output","task_id":"f1998126-35bb-40f9-aaea-f4635c4107be","chunk":"Read text file `internal/traceability/traceability.go`.\n1|// Package traceability verifies that the pinned AX specification inventory\n2|// remains bound to concrete production declarations and executable acceptance\n3|// cases. It is a read-only repository gate; it does not advertise runtime\n4|// capabilities or mutate implementation state.\n5|package traceability\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"crypto/sha256\"\n10|\t\"encoding/hex\"\n11|\t\"encoding/json\"\n12|\t\"errors\"\n13|\t\"fmt\"\n14|\t\"go/ast\"\n15|\t\"go/parser\"\n16|\t\"go/token\"\n17|\t\"io\"\n18|\t\"io/fs\"\n19|\t\"path\"\n20|\t\"regexp\"\n21|\t\"strings\"\n22|\t\"unicode\"\n23|\t\"unicode/utf8\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n29|)\n30|\n31|const (\n32|\townershipRegistryPath = \"internal/traceability/ownership.v0.5.0.json\"\n33|\tcontractLockPath      = \"internal/specpin/v0.5.0.lock.json\"\n34|\tcatalogMetadataPath   = \"internal/catalog/catalog.v0.5.0.json\"\n35|\tgeneratedCatalogPath  = \"internal/catalog/catalog_gen.go\"\n36|\n37|\townershipFormat        = \"ax-spec-to-code-ownership\"\n38|\townershipFormatVersion = 1\n39|\n40|\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\n41|\t// formatting may change, but ownership claims cannot be self-minted without\n42|\t// an explicit review of this binding.\n43|\treviewedOwnershipCanonicalSHA256 = \"fbdbb5b62e5dc4cf2f509e4424448ce8cac7f3c04c5a1a4d3ac88103b9754299\"\n44|)\n45|\n46|var ErrTraceability = errors.New(\"spec-to-code traceability check failed\")\n47|\n48|// Report contains inventory coverage only. These counts do not claim that any\n49|// runtime capability is available, enabled, or supported.\n50|type Report struct {\n51|\tContracts              int\n52|\tNormativeSections      int\n53|\tAcceptanceCases        int\n54|\tFixtures               int\n55|\tCompatibilityContracts int\n56|\tAssignedScopes         int\n57|\n58|\t// SectionBindings and the coverage counters below are a measured ratio over\n59|\t// the registered section bindings, not a prose claim. NormativeClauses is\n60|\t// the number of RFC 2119 clause lines the pinned document itself carries in\n61|\t// the bound sections; DischargedClauses is how many of those a binding\n62|\t// enumerates with a verified excerpt and an acceptance owner.\n63|\tSectionBindings     int\n64|\tFullCoverage        int\n65|\tPartialCoverage     int\n66|\tSliverCoverage      int\n67|\tUnevidencedCoverage int\n68|\tUnmeasuredCoverage  int\n69|\tUnownedSections     int\n70|\tNormativeClauses    int\n71|\tDischargedClauses   int\n72|}\n73|\n74|type ownershipKind string\n75|\n76|const (\n77|\townershipContract         ownershipKind = \"contract\"\n78|\townershipNormativeSection ownershipKind = \"normative_section\"\n79|\townershipSectionBinding   ownershipKind = \"section_binding\"\n80|\townershipFixture          ownershipKind = \"fixture\"\n81|)\n82|\n83|type ownershipRegistry struct {\n84|\tFormat          string           `json:\"format\"`\n85|\tFormatVersion   int              `json:\"format_version\"`\n86|\tSource          registrySource   `json:\"source\"`\n87|\tAcceptanceCases []acceptanceCase `json:\"acceptance_cases\"`\n88|\tOwnership       []ownershipGroup `json:\"ownership\"`\n89|\tUnownedSections []unownedSection `json:\"unowned_sections\"`\n90|}\n91|\n92|// unownedSection records a real v0.5.0 section that this repository does not\n93|// implement. It exists so an unimplemented section is disclosed by name rather\n94|// than bound to a symbol from a neighbouring package, which is what an owned\n95|// key would otherwise assert. It is a disclosure, never an exemption: a section\n96|// the generated catalog requires an owner for may not be declared here, and\n97|// assigned-scope admission refuses an unowned section and prints its gap.\n98|type unownedSection struct {\n99|\tKey      string `json:\"key\"`\n100|\tGap      string `json:\"gap\"`\n101|\tEvidence string `json:\"evidence\"`\n102|}\n103|\n104|type registrySource struct {\n105|\tRepository     string `json:\"repository\"`\n106|\tRelease        string `json:\"release\"`\n107|\tCommit         string `json:\"commit\"`\n108|\tDocumentPath   string `json:\"document_path\"`\n109|\tDocumentSHA256 string `json:\"document_sha256\"`\n110|}\n111|\n112|type acceptanceCase struct {\n113|\tID         string          `json:\"id\"`\n114|\tProduction codeReference   `json:\"production\"`\n115|\tTests      []codeReference `json:\"tests\"`\n116|}\n117|\n118|type ownershipGroup struct {\n119|\tKind            ownershipKind      `json:\"kind\"`\n120|\tKeys            []string           `json:\"keys\"`\n121|\tProduction      codeReference      `json:\"production\"`\n122|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n123|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n124|\tGap             string             `json:\"gap,omitempty\"`\n125|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n126|}\n127|\n128|// coverageLevel is how much of a bound section a binding claims to discharge.\n129|// The claim is not taken on trust: the level is recomputed from the clauses the\n130|// binding enumerates against the clause inventory the pinned specification\n131|// itself carries for that section, and a claim that differs from the measured\n132|// level is refused.\n133|type coverageLevel string\n134|\n135|const (\n136|\t// coverageFull means every normative clause the pinned section carries is\n137|\t// enumerated with a verified excerpt and an acceptance owner.\n138|\tcoverageFull coverageLevel = \"full\"\n139|\t// coveragePartial means at least half of them are.\n140|\tcoveragePartial coverageLevel = \"partial\"\n141|\t// coverageSliver means fewer than half are: the binding implements a corner\n142|\t// of the section it is registered against.\n143|\tcoverageSliver coverageLevel = \"sliver\"\n144|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n145|\t// the registry makes no clause-level claim, not that the implementation\n146|\t// covers nothing.\n147|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n148|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n149|\t// under the section's heading or its subheadings, so the gate cannot\n150|\t// measure the section's obligations at all.\n151|\t//\n152|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n153|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n154|\t// this class and every one of them has a substantive body: Section 15.2 is a\n155|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n156|\t// Provider Manifest, both of which state their obligations as tables rather\n157|\t// than in uppercase RFC 2119 keywords. Treating that silence as \"nothing to\n158|\t// discharge\" is the same free pass this gate exists to remove, reached\n159|\t// through the scanner instead of through the label, so an unmeasured binding\n160|\t// carries the same mandatory gap as every other level below full and is\n161|\t// refused for assigned-scope admission.\n162|\tcoverageUnmeasured coverageLevel = \"unmeasured\"\n163|)\n164|\n165|// dischargedClause binds one normative clause of the pinned section to the\n166|// acceptance cases that discharge it. Every field is checked against the\n167|// hash-verified document: the identifier must index the section's own clause\n168|// inventory, the line must be the line that clause occupies, and the excerpt\n169|// must be that clause's text quoted verbatim, so a clause cannot be claimed\n170|// with a true sentence about something else.\n171|type dischargedClause struct {\n172|\tID              string   `json:\"id\"`\n173|\tLine            int      `json:\"line\"`\n174|\tExcerpt         string   `json:\"excerpt\"`\n175|\tAcceptanceCases []string `json:\"acceptance_cases\"`\n176|}\n177|\n178|// normativeClause is one RFC 2119 clause line of the pinned specification,\n179|// measured from the document rather than declared by the registry.\n180|type normativeClause struct {\n181|\tID   string\n182|\tLine int\n183|\tText string\n184|}\n185|\n186|type codeReference struct {\n187|\tPath        string `json:\"path\"`\n188|\tDeclaration string `json:\"declaration\"`\n189|}\n190|\n191|type assignedSectionBinding struct {\n192|\tScope string\n193|\tKeys  []string\n194|}\n195|\n196|var assignedSectionPattern = regexp.MustCompile(`^((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*)(?:-((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*))?$`)\n197|var catalogAppendixPattern = regexp.MustCompile(`(?i)^Appendix ([A-D]):`)\n198|\n199|// VerifyRepository is the production CI entry point. It verifies exact pinned\n200|// inputs, stale generated output, compatibility coverage, and every registered\n201|// ownership reference against the supplied repository filesystem.\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.Verify(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV050)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n255|\tif err != nil {\n256|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n257|\t}\n258|\n259|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n260|\tif err != nil {\n261|\t\treturn Report{}, err\n262|\t}\n263|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n264|\tif err != nil {\n265|\t\treturn Report{}, err\n266|\t}\n267|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n268|\tif err != nil {\n269|\t\treturn Report{}, err\n270|\t}\n271|\tdocument, err := specdoc.Load()\n272|\tif err != nil {\n273|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n274|\t}\n275|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256 {\n276|\t\treturn Report{}, fail(\n277|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n278|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256)\n279|\t}\n280|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n281|}\n282|\n283|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n284|\tvalue, err := fs.ReadFile(repository, filename)\n285|\tif err != nil {\n286|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n287|\t}\n288|\treturn value, nil\n289|}\n290|\n291|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n292|\tvar decoded ownershipRegistry\n293|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n294|\tdecoder.DisallowUnknownFields()\n295|\tif err := decoder.Decode(&decoded); err != nil {\n296|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n297|\t}\n298|\tvar trailing any\n299|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n300|\t\tif err == nil {\n301|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n302|\t\t}\n303|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n304|\t}\n305|\treturn decoded, nil\n306|}\n307|\n308|func verifyOwnership(\n309|\trepository fs.FS,\n310|\tdocument *specdoc.Document,\n311|\tregistry ownershipRegistry,\n312|\tmanifest specpin.Manifest,\n313|\tcurrentCatalog catalog.Catalog,\n314|\tcompatibilityCatalog catalog.Catalog,\n315|\tassignedBindings []assignedSectionBinding,\n316|) (Report, error) {\n317|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n318|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n319|\t}\n320|\tsource := registry.Source\n321|\tif source.Repository != manifest.Source.Repository ||\n322|\t\tsource.Release != manifest.Source.Release ||\n323|\t\tsource.Commit != manifest.Source.Commit ||\n324|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n325|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n326|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n327|\t}\n328|\n329|\texpected := map[ownershipKind]map[string]struct{}{\n330|\t\townershipContract:         expectedContracts(manifest.Contracts),\n331|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n332|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n333|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n334|\t}\n335|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n336|\tif err != nil {\n337|\t\treturn Report{}, err\n338|\t}\n339|\trequired := map[ownershipKind]map[string]struct{}{\n340|\t\townershipContract:         expected[ownershipContract],\n341|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n342|\t\townershipSectionBinding:   requiredSectionBindings,\n343|\t\townershipFixture:          expected[ownershipFixture],\n344|\t}\n345|\tselectedSectionBindings := map[string]struct{}(nil)\n346|\tif assignedBindings != nil {\n347|\t\trequired = cloneOwnershipSets(expected)\n348|\t\tselectedSectionBindings = make(map[string]struct{})\n349|\t\tfor _, binding := range assignedBindings {\n350|\t\t\tfor _, key := range binding.Keys {\n351|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n352|\t\t\t}\n353|\t\t}\n354|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n355|\t}\n356|\tchecker := newSourceChecker(repository)\n357|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n358|\tif err != nil {\n359|\t\treturn Report{}, err\n360|\t}\n361|\t// Coverage is measured over every registered section binding, not only the\n362|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n363|\t// production entry points rather than only the repository-wide one. It is\n364|\t// measured before ownership resolution so that a section moved to the\n365|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n366|\t// as that dodge rather than as an ordinary missing owner.\n367|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n368|\tif err != nil {\n369|\t\treturn Report{}, err\n370|\t}\n371|\townedSections := make(map[string]struct{}, len(coverage))\n372|\tfor key := range coverage {\n373|\t\townedSections[key] = struct{}{}\n374|\t}\n375|\tunowned, err := verifyUnownedSections(\n376|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n377|\tif err != nil {\n378|\t\treturn Report{}, err\n379|\t}\n380|\n381|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n382|\tif err != nil {\n383|\t\treturn Report{}, err\n384|\t}\n385|\n386|\tfor _, binding := range assignedBindings {\n387|\t\tfor _, key := range binding.Keys {\n388|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n389|\t\t\t\treturn Report{}, fail(\n390|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n391|\t\t\t}\n392|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n393|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n394|\t\t\t}\n395|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n396|\t\t\t// deliberately not admitted: the gate cannot see the section's\n397|\t\t\t// obligations, and admitting on an unverifiable justification\n398|\t\t\t// sentence would be self-minted evidence for exactly the class this\n399|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n400|\t\t\t// failure to measure, not a measured absence of obligation.\n401|\t\t\tmeasured := coverage[key]\n402|\t\t\tif measured.Level != coverageFull {\n403|\t\t\t\treturn Report{}, fail(\n404|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n405|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n406|\t\t\t}\n407|\t\t}\n408|\t}\n409|\tfor _, contract := range compatibilityCatalog.Contracts {\n410|\t\tkey := contractKey(contract.Name, string(contract.ID))\n411|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n412|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n413|\t\t}\n414|\t}\n415|\n416|\tcanonical, err := json.Marshal(registry)\n417|\tif err != nil {\n418|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n419|\t}\n420|\tdigest := sha256.Sum256(canonical)\n421|\tgotDigest := hex.EncodeToString(digest[:])\n422|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n423|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n424|\t}\n425|\n426|\treport := Report{\n427|\t\tContracts:              len(expected[ownershipContract]),\n428|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n429|\t\tAcceptanceCases:        len(acceptanceIDs),\n430|\t\tFixtures:               len(expected[ownershipFixture]),\n431|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n432|\t\tAssignedScopes:         len(assignedBindings),\n433|\t\tSectionBindings:        len(coverage),\n434|\t\tUnownedSections:        len(unowned),\n435|\t}\n436|\tfor _, measured := range coverage {\n437|\t\treport.NormativeClauses += measured.Total\n438|\t\treport.DischargedClauses += measured.Discharged\n439|\t\tswitch measured.Level {\n440|\t\tcase coverageFull:\n441|\t\t\treport.FullCoverage++\n442|\t\tcase coveragePartial:\n443|\t\t\treport.PartialCoverage++\n444|\t\tcase coverageSliver:\n445|\t\t\treport.SliverCoverage++\n446|\t\tcase coverageUnevidenced:\n447|\t\t\treport.UnevidencedCoverage++\n448|\t\tcase coverageUnmeasured:\n449|\t\t\treport.UnmeasuredCoverage++\n450|\t\t}\n451|\t}\n452|\treturn report, nil\n453|}\n454|\n455|// verifySectionCoverage measures every registered section binding against the\n456|// pinned document and refuses a coverage claim on any other ownership kind. A\n457|// contract or fixture owner has no section to be measured against, so a\n458|// coverage field there would be a claim the gate cannot check.\n459|func verifySectionCoverage(\n460|\tdocument *specdoc.Document,\n461|\tgroups []ownershipGroup,\n462|\tacceptanceIDs map[string]struct{},\n463|) (map[string]sectionCoverage, error) {\n464|\tresult := make(map[string]sectionCoverage)\n465|\tfor index, group := range groups {\n466|\t\tif group.Kind != ownershipSectionBinding {\n467|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n468|\t\t\t\treturn nil, fail(\n469|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n470|\t\t\t\t\tindex, group.Kind)\n471|\t\t\t}\n472|\t\t\tcontinue\n473|\t\t}\n474|\t\tif len(group.Keys) != 1 {\n475|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n476|\t\t}\n477|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n478|\t\tif err != nil {\n479|\t\t\treturn nil, err\n480|\t\t}\n481|\t\tif _, duplicate := result[measured.Key]; duplicate {\n482|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n483|\t\t}\n484|\t\tresult[measured.Key] = measured\n485|\t}\n486|\treturn result, nil\n487|}\n488|\n489|func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\n490|\tif len(cases) == 0 {\n491|\t\treturn nil, fail(\"acceptance case registry is empty\")\n492|\t}\n493|\tseen := make(map[string]struct{}, len(cases))\n494|\tfor index, acceptance := range cases {\n495|\t\tif acceptance.ID == \"\" {\n496|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n497|\t\t}\n498|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n499|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n500|\t\t}\n(more lines below)"}}}
