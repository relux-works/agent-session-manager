{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a3","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":172,"recorded_at":1780531400000339,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"89af5b58-d11b-4c98-98a9-b2f85276816e"},"task_id":"89af5b58-d11b-4c98-98a9-b2f85276816e","event":{"kind":"output","task_id":"89af5b58-d11b-4c98-98a9-b2f85276816e","chunk":"Read text file `internal/secconftest/skip.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|)\n13|\n14|// Capability is one platform capability a test may need. Probe reports\n15|// whether it holds here and now; StrictGOOS lists the GOOS values\n16|// where absence is a failure rather than a skip. A skip asserts \"this\n17|// cannot run here\": the probe must really attempt the capability, and\n18|// an unexpected skip on a strict platform must fail rather than pass\n19|// quietly.\n20|type Capability struct {\n21|\t// ID is the stable slug naming the capability in reports.\n22|\tID string\n23|\t// Detail explains what the probe attempts.\n24|\tDetail string\n25|\t// Probe attempts the capability and reports availability.\n26|\tProbe func() (ok bool, reason string)\n27|\t// StrictGOOS names platforms where unavailability fails the test.\n28|\tStrictGOOS []string\n29|}\n30|\n31|// Verdict is the outcome of requiring one capability.\n32|type Verdict struct {\n33|\tID      string\n34|\tSkipped bool\n35|\tFailed  bool\n36|\tReason  string\n37|}\n38|\n39|// decision is the testable core of Require: pass, skip, or fail for a\n40|// probed capability. It carries no testing handle so the table test\n41|// can drive every arm, including the failing ones, without failing\n42|// the suite.\n43|type decision int\n44|\n45|const (\n46|\tdecisionPass decision = iota\n47|\tdecisionSkip\n48|\tdecisionFail\n49|)\n50|\n51|func decide(capability Capability, ok bool) decision {\n52|\tif capability.ID == \"\" || capability.Probe == nil {\n53|\t\treturn decisionFail\n54|\t}\n55|\tif ok {\n56|\t\treturn decisionPass\n57|\t}\n58|\tif strictOn(capability) {\n59|\t\treturn decisionFail\n60|\t}\n61|\treturn decisionSkip\n62|}\n63|\n64|// SymlinkCapability probes symlink creation and Lstat identification\n65|// in a fresh temporary directory. Symlink-escape commit tests require\n66|// it; Windows hosts without privilege report unavailable.\n67|func SymlinkCapability() Capability {\n68|\treturn Capability{\n69|\t\tID:     \"symlink\",\n70|\t\tDetail: \"create a symlink in a temp dir and identify it with Lstat\",\n71|\t\tProbe: func() (bool, string) {\n72|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-symlink\")\n73|\t\t\tif err != nil {\n74|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n75|\t\t\t}\n76|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n77|\t\t\ttarget := filepath.Join(dir, \"target\")\n78|\t\t\tlink := filepath.Join(dir, \"link\")\n79|\t\t\tif err := os.WriteFile(target, []byte(\"x\"), 0o600); err != nil {\n80|\t\t\t\treturn false, fmt.Sprintf(\"write target: %v\", err)\n81|\t\t\t}\n82|\t\t\tif err := os.Symlink(target, link); err != nil {\n83|\t\t\t\treturn false, fmt.Sprintf(\"symlink: %v\", err)\n84|\t\t\t}\n85|\t\t\tinfo, err := os.Lstat(link)\n86|\t\t\tif err != nil {\n87|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n88|\t\t\t}\n89|\t\t\tif info.Mode()&os.ModeSymlink == 0 {\n90|\t\t\t\treturn false, \"created link is not a symlink\"\n91|\t\t\t}\n92|\t\t\treturn true, \"symlink create+identify works\"\n93|\t\t},\n94|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n95|\t}\n96|}\n97|\n98|// FifoCapability probes named-pipe creation: it builds a real FIFO\n99|// in a fresh temporary directory and identifies it with Lstat. It is\n100|// unavailable on Windows by construction, so Windows is not strict:\n101|// the special-file gate there is covered by other means, stated on\n102|// the callers. A probe that returned true without creating anything\n103|// would advertise an unbuilt capability; TestSkipFifoFixtureExchangesBytes\n104|// drives a second FIFO through the same helper so the probe cannot\n105|// pass while fixtures cannot build.\n106|func FifoCapability() Capability {\n107|\treturn Capability{\n108|\t\tID:     \"fifo\",\n109|\t\tDetail: \"create a named pipe in a temp dir and identify it with Lstat\",\n110|\t\tProbe: func() (bool, string) {\n111|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-fifo\")\n112|\t\t\tif err != nil {\n113|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n114|\t\t\t}\n115|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n116|\t\t\tpath, err := makeFifo(dir, \"probe\")\n117|\t\t\tif err != nil {\n118|\t\t\t\treturn false, fmt.Sprintf(\"mkfifo: %v\", err)\n119|\t\t\t}\n120|\t\t\tinfo, err := os.Lstat(path)\n121|\t\t\tif err != nil {\n122|\t\t\t\treturn false, fmt.Sprintf(\"lstat: %v\", err)\n123|\t\t\t}\n124|\t\t\tif info.Mode()&os.ModeNamedPipe == 0 {\n125|\t\t\t\treturn false, \"created file is not a named pipe\"\n126|\t\t\t}\n127|\t\t\treturn true, \"named-pipe create+identify works\"\n128|\t\t},\n129|\t\tStrictGOOS: []string{\"linux\", \"darwin\"},\n130|\t}\n131|}\n132|\n133|// ModeBitsCapability probes whether permission bits are enforceable:\n134|// it removes all permissions from a temp file and checks the open\n135|// fails. Root bypasses mode bits and Windows ACLs do not express\n136|// them, so neither is strict.\n137|func ModeBitsCapability() Capability {\n138|\treturn Capability{\n139|\t\tID:     \"mode-bits\",\n140|\t\tDetail: \"chmod 000 a temp file and require the open to fail\",\n141|\t\tProbe: func() (bool, string) {\n142|\t\t\tif runtime.GOOS == \"windows\" {\n143|\t\t\t\treturn false, \"Windows ACLs do not express mode bits\"\n144|\t\t\t}\n145|\t\t\tdir, err := os.MkdirTemp(\"\", \"secconftest-modebits\")\n146|\t\t\tif err != nil {\n147|\t\t\t\treturn false, fmt.Sprintf(\"temp dir: %v\", err)\n148|\t\t\t}\n149|\t\t\tdefer func() { _ = os.RemoveAll(dir) }()\n150|\t\t\tpath := filepath.Join(dir, \"guarded\")\n151|\t\t\tif err := os.WriteFile(path, []byte(\"x\"), 0o600); err != nil {\n152|\t\t\t\treturn false, fmt.Sprintf(\"write: %v\", err)\n153|\t\t\t}\n154|\t\t\tif err := os.Chmod(path, 0); err != nil {\n155|\t\t\t\treturn false, fmt.Sprintf(\"chmod: %v\", err)\n156|\t\t\t}\n157|\t\t\tfile, err := os.Open(path)\n158|\t\t\tif err != nil {\n159|\t\t\t\treturn true, \"mode bits enforced\"\n160|\t\t\t}\n161|\t\t\t_ = file.Close()\n162|\t\t\treturn false, \"open succeeded despite mode 000 (root or unenforceable bits)\"\n163|\t\t},\n164|\t}\n165|}\n166|\n167|// NonRootCapability probes that the suite does not run as superuser.\n168|// Permission-refusal vectors that need denial require it.\n169|func NonRootCapability() Capability {\n170|\treturn Capability{\n171|\t\tID:     \"nonroot\",\n172|\t\tDetail: \"require a non-privileged uid on unix\",\n173|\t\tProbe: func() (bool, string) {\n174|\t\t\tif runtime.GOOS == \"windows\" {\n175|\t\t\t\treturn true, \"Windows: no unix superuser\"\n176|\t\t\t}\n177|\t\t\tif os.Geteuid() == 0 {\n178|\t\t\t\treturn false, \"running as root: permission denials are untestable\"\n179|\t\t\t}\n180|\t\t\treturn true, \"non-root user\"\n181|\t\t},\n182|\t}\n183|}\n184|\n185|// DefaultCapabilities lists every capability this instrument probes.\n186|func DefaultCapabilities() []Capability {\n187|\treturn []Capability{SymlinkCapability(), FifoCapability(), ModeBitsCapability(), NonRootCapability()}\n188|}\n189|\n190|// strictOn reports whether id is strict on this host's GOOS.\n191|func strictOn(capability Capability) bool {\n192|\tfor _, goos := range capability.StrictGOOS {\n193|\t\tif goos == runtime.GOOS {\n194|\t\t\treturn true\n195|\t\t}\n196|\t}\n197|\treturn false\n198|}\n199|\n200|// report aggregates verdicts with a process-wide skip counter the\n201|// suite logs once, so the skip count on the host is evidence rather\n202|// than prose.\n203|var report struct {\n204|\tmutex   sync.Mutex\n205|\tskipped []string\n206|\tfailed  []string\n207|}\n208|\n209|func recordVerdict(verdict Verdict) {\n210|\treport.mutex.Lock()\n211|\tdefer report.mutex.Unlock()\n212|\tif verdict.Skipped {\n213|\t\treport.skipped = append(report.skipped, verdict.ID)\n214|\t}\n215|\tif verdict.Failed {\n216|\t\treport.failed = append(report.failed, verdict.ID)\n217|\t}\n218|}\n219|\n220|// SkippedIDs reports capability IDs skipped so far, sorted.\n221|func SkippedIDs() []string {\n222|\treport.mutex.Lock()\n223|\tdefer report.mutex.Unlock()\n224|\tout := append([]string(nil), report.skipped...)\n225|\tsort.Strings(out)\n226|\treturn out\n227|}\n228|\n229|// requireT is the minimal testing handle Require needs. *testing.T\n230|// satisfies it, and the wiring tests pass a fake that records Skipf\n231|// and Fatalf without aborting the suite — so both the skip and the\n232|// fail arms are driven through the real Require and their\n233|// recordVerdict calls are pinned (M04/M05). A fake that never sees\n234|// the verdict while the counters stay empty fails its test.\n235|type requireT interface {\n236|\tHelper()\n237|\tSkipf(format string, args ...any)\n238|\tFatalf(format string, args ...any)\n239|}\n240|\n241|// Require enforces one capability: it returns a passing verdict when\n242|// the probe holds, skips the test when the probe fails on a\n243|// non-strict platform, and fails the test when the probe fails on a\n244|// strict platform or the probe result contradicts a strict\n245|// expectation the caller states. Every skip and failure is recorded\n246|// for the final count.\n247|func Require(t requireT, capability Capability) Verdict {\n248|\tt.Helper()\n249|\tif capability.ID == \"\" || capability.Probe == nil {\n250|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: \"capability without identity or probe is unusable\"}\n251|\t\trecordVerdict(verdict)\n252|\t\tt.Fatalf(\"secconftest: capability %q has no identity or probe\", capability.ID)\n253|\t\treturn verdict\n254|\t}\n255|\tok, reason := capability.Probe()\n256|\tswitch decide(capability, ok) {\n257|\tcase decisionPass:\n258|\t\treturn Verdict{ID: capability.ID, Reason: reason}\n259|\tcase decisionFail:\n260|\t\tverdict := Verdict{ID: capability.ID, Failed: true, Reason: reason}\n261|\t\trecordVerdict(verdict)\n262|\t\tt.Fatalf(\"secconftest: capability %q unavailable on strict platform %s: %s\", capability.ID, runtime.GOOS, reason)\n263|\t\treturn verdict\n264|\tdefault:\n265|\t\tverdict := Verdict{ID: capability.ID, Skipped: true, Reason: reason}\n266|\t\trecordVerdict(verdict)\n267|\t\tt.Skipf(\"secconftest: capability %q unavailable here: %s\", capability.ID, reason)\n268|\t\treturn verdict\n269|\t}\n270|}\n271|\n272|// Report formats the capability skip/fail counts recorded so far on\n273|// this host. It reads the live counters: an empty suite records\n274|// nothing and reports zeros, and every recorded skip or failure moves\n275|// the numbers. Citing a Report line as host evidence is only honest\n276|// for verdicts the suite really recorded; the per-test skip datum is\n277|// the `--- SKIP` lines under `go test -v`, which reproduce without\n278|// any counter.\n279|func Report() string {\n280|\treport.mutex.Lock()\n281|\tskipped := append([]string(nil), report.skipped...)\n282|\tfailed := append([]string(nil), report.failed...)\n283|\treport.mutex.Unlock()\n284|\tsort.Strings(skipped)\n285|\tsort.Strings(failed)\n286|\treturn fmt.Sprintf(\"secconftest capabilities on %s: skipped=%d %q failed=%d %q\",\n287|\t\truntime.GOOS, len(skipped), strings.Join(skipped, \",\"), len(failed), strings.Join(failed, \",\"))\n288|}\n289|\n290|// snapshotReport copies the process-wide counters so a test can\n291|// record synthetic verdicts and restore the suite state afterwards.\n292|func snapshotReport() (skipped, failed []string) {\n293|\treport.mutex.Lock()\n294|\tdefer report.mutex.Unlock()\n295|\treturn append([]string(nil), report.skipped...), append([]string(nil), report.failed...)\n296|}\n297|\n298|// restoreReport replaces the process-wide counters, undoing synthetic\n299|// verdicts a test recorded. It exists only for test isolation.\n300|func restoreReport(skipped, failed []string) {\n301|\treport.mutex.Lock()\n302|\tdefer report.mutex.Unlock()\n303|\treport.skipped = append([]string(nil), skipped...)\n304|\treport.failed = append([]string(nil), failed...)\n305|}\n306|\n307|// LogReport logs the capability skip/fail counts on this host. Call\n308|// it after the suite recorded its verdicts so the line carries real\n309|// counters. It never skips or fails: it reports.\n310|func LogReport(t *testing.T) {\n311|\tt.Helper()\n312|\tt.Log(Report())\n313|}"}}}
