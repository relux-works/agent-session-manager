3\\\"\\n  need_clean \\\"$id\\\" \\\"$file\\\"''')\\ns = s.replace('''  git checkout -- \\\"$file\\\"\\n  need_clean \\\"$id-reverted\\\"''', '''  cp \\\"$BACKUP_DIR/$(echo \\\"$file\\\" | tr '/' '_')\\\" \\\"$file\\\"\\n  verify_reverted \\\"$file\\\" \\\"$id\\\"''')\\ns = s.replace('''echo \\\"=== results ===\\\"\\ncat \\\"$RESULTS\\\"\\nneed_clean final\\ngit status --short -- \\\"$PKG\\\" internal/cigate; echo \\\"TREE_CLEAN_IF_EMPTY_ABOVE\\\"''', '''echo \\\"=== results ===\\\"\\ncat \\\"$RESULTS\\\"\\nfor f in internal/cigate/claims.go internal/cigate/contracts.go internal/cigate/targets.go; do\\n  verify_reverted \\\"$f\\\" final\\ndone\\necho \\\"ALL_REVERTED_CLEAN\\\"''')\\nopen('/tmp/mutant-harness.sh','w').write(s)\\nprint(\\\"harness fixed\\\")\\nEOF\\nbash -n /tmp/mutant-harness.sh && echo \\\"SYNTAX_OK\\\"\",\n  \"description\": \"Fix harness revert for untracked files\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"harness fixed\\nSYNTAX_OK\\n\",\n  \"original_output_bytes\": 24,\n  \"original_output_tokens\": 6,\n  \"truncated\": false\n}"}}}
