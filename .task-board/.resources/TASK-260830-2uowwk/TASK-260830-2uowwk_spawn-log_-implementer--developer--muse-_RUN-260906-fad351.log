{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c631","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":371,"recorded_at":1780531400000737,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"ae7dc155-e201-449b-89a2-4a49c324be66"},"task_id":"ae7dc155-e201-449b-89a2-4a49c324be66","event":{"kind":"output","task_id":"ae7dc155-e201-449b-89a2-4a49c324be66","chunk":"Read text file `internal/secconftest/main_test.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"testing\"\n7|)\n8|\n9|// TestMain runs the suite and then prints the process-wide capability\n10|// counters, so a real verdict recorded by a parallel Require is\n11|// observable in the output. Sequential tests (including\n12|// TestSkipReportReadsRecordedVerdicts and the fake-Require wiring\n13|// tests) print before the first parallel CONT, so without this hook\n14|// no printed report can carry a parallel verdict under any host\n15|// condition. The per-test --- SKIP / --- FAIL lines under go test -v\n16|// remain the primary skip datum; this line witnesses the counters\n17|// after every test, including the parallel ones.\n18|func TestMain(m *testing.M) {\n19|\tcode := m.Run()\n20|\tfmt.Printf(\"%s\\n\", Report())\n21|\tos.Exit(code)\n22|}"}}}
