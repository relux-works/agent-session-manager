{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"a412dad4-53f7-449f-8728-57b85c8179bf"},"task_id":"a412dad4-53f7-449f-8728-57b85c8179bf","event":{"kind":"output","task_id":"a412dad4-53f7-449f-8728-57b85c8179bf","chunk":"Read text file `internal/secconftest/skip_fifo_unix.go`.\n1|//go:build !windows\n2|\n3|package secconftest\n4|\n5|import (\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"syscall\"\n9|)\n10|\n11|// makeFifo creates a named pipe at dir/name with mode 0600. Unix-only:\n12|// Windows has no Mkfifo and its file carries the unavailable stub, so\n13|// the fifo probe fails (and skips, since Windows is not strict)\n14|// instead of pretending.\n15|func makeFifo(dir, name string) (string, error) {\n16|\treturn fifoBuild(dir, name)\n17|}\n18|\n19|// fifoBuild is the seam the probe-honesty test faults: it swaps in a\n20|// failing build, drives FifoCapability().Probe(), and requires\n21|// failure. A probe closure hardened to constant true ignores the\n22|// fault and fails the test.\n23|var fifoBuild = func(dir, name string) (string, error) {\n24|\tpath := filepath.Join(dir, name)\n25|\tif err := syscall.Mkfifo(path, 0o600); err != nil {\n26|\t\treturn \"\", fmt.Errorf(\"secconftest: mkfifo %q: %w\", path, err)\n27|\t}\n28|\treturn path, nil\n29|}"}}}
