{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d533","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":2292,"recorded_at":1780531400004579,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"17f98f85-56ac-49b1-b04a-f97c39e164a9"},"task_id":"17f98f85-56ac-49b1-b04a-f97c39e164a9","event":{"kind":"output","task_id":"17f98f85-56ac-49b1-b04a-f97c39e164a9","chunk":"Read text file `internal/traceability/traceability_test.go`.\n(419 line(s) above)\n420|\t\t}\n421|\t\tgroup := document[\"ownership\"].([]any)[0].(map[string]any)\n422|\t\tgroup[\"supported\"] = true\n423|\t\tcandidate, err := json.Marshal(document)\n424|\t\tif err != nil {\n425|\t\t\tt.Fatalf(\"encode forged registry: %v\", err)\n426|\t\t}\n427|\t\trepository[ownershipRegistryPath] = &fstest.MapFile{Data: candidate}\n428|\t\t_, err = VerifyRepository(repository)\n429|\t\tif err == nil || !strings.Contains(err.Error(), \"unknown field \\\"supported\\\"\") {\n430|\t\t\tt.Fatalf(\"VerifyRepository(capability claim) error = %v, want unknown-field refusal\", err)\n431|\t\t}\n432|\t})\n433|}\n434|\n435|func TestVerifyRepositoryIsIdempotentAndReadOnly(t *testing.T) {\n436|\tt.Parallel()\n437|\n438|\trepository := repositorySnapshot(t)\n439|\tbefore := snapshotDigest(repository)\n440|\tfirst, err := VerifyRepository(repository)\n441|\tif err != nil {\n442|\t\tt.Fatalf(\"first VerifyRepository() error = %v\", err)\n443|\t}\n444|\tsecond, err := VerifyRepository(repository)\n445|\tif err != nil {\n446|\t\tt.Fatalf(\"second VerifyRepository() error = %v\", err)\n447|\t}\n448|\tif !reflect.DeepEqual(first, second) {\n449|\t\tt.Fatalf(\"identical verification reports differ: first=%#v second=%#v\", first, second)\n450|\t}\n451|\tafter := snapshotDigest(repository)\n452|\tif before != after {\n453|\t\tt.Fatalf(\"read-only verification mutated repository evidence: before=%x after=%x\", before, after)\n454|\t}\n455|}\n456|\n457|func TestCIWorkflowInvokesTraceabilityGate(t *testing.T) {\n458|\tt.Parallel()\n459|\n460|\tworkflow, err := os.ReadFile(filepath.Join(\"..\", \"..\", \".github\", \"workflows\", \"ci.yml\"))\n461|\tif err != nil {\n462|\t\tt.Fatalf(\"read CI workflow: %v\", err)\n463|\t}\n464|\tfor _, command := range []string{\n465|\t\t\"go run ./internal/traceability/cmd/tracecheck\",\n466|\t\t\"go test ./... -v\",\n467|\t\t\"go vet ./...\",\n468|\t\t\"go build ./...\",\n469|\t} {\n470|\t\tif !bytes.Contains(workflow, []byte(command)) {\n471|\t\t\tt.Errorf(\"CI workflow does not invoke %q\", command)\n472|\t\t}\n473|\t}\n474|}\n475|\n476|func repositorySnapshot(t *testing.T) fstest.MapFS {\n477|\tt.Helper()\n478|\n479|\troot := os.DirFS(filepath.Join(\"..\", \"..\"))\n480|\tregistryBytes, err := fs.ReadFile(root, ownershipRegistryPath)\n481|\tif err != nil {\n482|\t\tt.Fatalf(\"read ownership registry: %v\", err)\n483|\t}\n484|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n485|\tif err != nil {\n486|\t\tt.Fatalf(\"decode ownership registry: %v\", err)\n487|\t}\n488|\trequired := map[string]struct{}{\n489|\t\tcontractLockPath:      {},\n490|\t\tcatalogMetadataPath:   {},\n491|\t\tgeneratedCatalogPath:  {},\n492|\t\townershipRegistryPath: {},\n493|\t}\n494|\tfor _, acceptance := range registry.AcceptanceCases {\n495|\t\trequired[acceptance.Production.Path] = struct{}{}\n496|\t\tfor _, test := range acceptance.Tests {\n497|\t\t\trequired[test.Path] = struct{}{}\n498|\t\t}\n499|\t}\n500|\tfor _, group := range registry.Ownership {\n501|\t\trequired[group.Production.Path] = struct{}{}\n502|\t}\n503|\n504|\tresult := make(fstest.MapFS, len(required))\n505|\tfor filename := range required {\n506|\t\tvalue, err := fs.ReadFile(root, filename)\n507|\t\tif err != nil {\n508|\t\t\tt.Fatalf(\"read repository fixture %q: %v\", filename, err)\n509|\t\t}\n510|\t\tresult[filename] = &fstest.MapFile{Data: bytes.Clone(value)}\n511|\t}\n512|\treturn result\n513|}\n514|\n515|func rewriteRegistry(t *testing.T, repository fstest.MapFS, mutate func(*ownershipRegistry)) {\n516|\tt.Helper()\n517|\n518|\tregistry, err := decodeOwnershipRegistry(repository[ownershipRegistryPath].Data)\n519|\tif err != nil {\n520|\t\tt.Fatalf(\"decode ownership registry: %v\", err)\n521|\t}\n522|\tmutate(&registry)\n523|\tvalue, err := json.MarshalIndent(registry, \"\", \"  \")\n524|\tif err != nil {\n525|\t\tt.Fatalf(\"encode ownership registry: %v\", err)\n526|\t}\n527|\trepository[ownershipRegistryPath] = &fstest.MapFile{Data: value}\n528|}\n529|\n530|func replaceRepositorySourceOnce(t *testing.T, repository fstest.MapFS, filename, from, to string) {\n531|\tt.Helper()\n532|\n533|\tfile, ok := repository[filename]\n534|\tif !ok {\n535|\t\tt.Fatalf(\"repository fixture %q not found\", filename)\n536|\t}\n537|\tif count := bytes.Count(file.Data, []byte(from)); count != 1 {\n538|\t\tt.Fatalf(\"repository fixture %q contains source declaration %q %d times, want exactly once\", filename, from, count)\n539|\t}\n(more lines below)"}}}
