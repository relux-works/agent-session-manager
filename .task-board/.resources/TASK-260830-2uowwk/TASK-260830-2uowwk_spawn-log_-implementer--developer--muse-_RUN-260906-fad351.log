te(current, historical, pinned, projected)\n188|\t\t\terr := checkAgreement(pinned, projected)\n189|\t\t\tif err == nil {\n190|\t\t\t\tt.Fatalf(\"checkAgreement() admitted %s\", kase.name)\n191|\t\t\t}\n192|\t\t\tif !strings.Contains(err.Error(), kase.want) {\n193|\t\t\t\tt.Fatalf(\"checkAgreement() error = %q, want substring %q\", err, kase.want)\n194|\t\t\t}\n195|\t\t})\n196|\t}\n197|}"}}}
