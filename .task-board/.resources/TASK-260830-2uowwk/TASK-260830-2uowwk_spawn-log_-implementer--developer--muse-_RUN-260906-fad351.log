{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c877","stream":{"kind":"session","id":"01a077f0-8368-79b0-a394-00901144f8f0"},"sequence":662,"recorded_at":1780531400001319,"record_type":"event","durability":"durable","causation_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b71aae24-19f3-441e-b3e1-6dada05f93d3","run_stream":{"kind":"run","id":"b71aae24-19f3-441e-b3e1-6dada05f93d3"},"task_stream":{"kind":"task","id":"3f5b9143-2a07-457b-94e1-1e5567437548"},"task_id":"3f5b9143-2a07-457b-94e1-1e5567437548","event":{"kind":"output","task_id":"3f5b9143-2a07-457b-94e1-1e5567437548","chunk":"Read text file `internal/secprim/argv_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"go/parser\"\n5|\t\"go/token\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|func TestCheckArgvAdmits(t *testing.T) {\n13|\tt.Parallel()\n14|\tfor _, argv := range [][]string{\n15|\t\t{\"/plugins/ax-provider-pi\"},\n16|\t\t{\"ax\", \"pane\", \"0193e2c0-9c9c-7b1e-9c9c-7b1e9c9c7b1e\"},\n17|\t\t{`C:\\tools\\ax.exe`, \"--non-interactive\"},\n18|\t\t{\"/bin/echo\", \"hello world\"},\n19|\t} {\n20|\t\tif err := CheckArgv(argv); err != nil {\n21|\t\t\tt.Errorf(\"CheckArgv(%q) = %v, want admission\", argv, err)\n22|\t\t}\n23|\t}\n24|}\n25|\n26|func TestCheckArgvRefuses(t *testing.T) {\n27|\tt.Parallel()\n28|\tcases := []struct {\n29|\t\tname string\n30|\t\targv []string\n31|\t\twant string\n32|\t}{\n33|\t\t{\"empty vector\", nil, \"secprim unsafe argv: argv empty: no executable\"},\n34|\t\t{\"empty executable\", []string{\"\"}, \"secprim unsafe argv: argv executable empty: argv[0]\"},\n35|\t\t{\"empty element\", []string{\"ax\", \"\"}, \"secprim unsafe argv: argv element empty: argv[1]\"},\n36|\t\t{\"nul executable\", []string{\"a\\x00b\"}, \"secprim unsafe argv: argv NUL: argv[0]\"},\n37|\t\t{\"nul argument\", []string{\"ax\", \"a\\x00b\"}, \"secprim unsafe argv: argv NUL: argv[1]\"},\n38|\t\t{\"invalid utf8\", []string{\"ax\", \"a\\xffb\"}, \"secprim unsafe argv: argv encoding: argv[1]\"},\n39|\t}\n40|\tfor _, kase := range cases {\n41|\t\tt.Run(kase.name, func(t *testing.T) {\n42|\t\t\tt.Parallel()\n43|\t\t\trequireRefusal(t, CheckArgv(kase.argv), ErrUnsafeArgv, kase.want)\n44|\t\t})\n45|\t}\n46|}\n47|\n48|func TestCommandCopiesOnBothSides(t *testing.T) {\n49|\tt.Parallel()\n50|\targv := []string{\"ax\", \"pane\", \"session\"}\n51|\tcommand, err := NewCommand(argv)\n52|\tif err != nil {\n53|\t\tt.Fatalf(\"NewCommand = %v\", err)\n54|\t}\n55|\targv[1] = \"MUTATED\"\n56|\tif got := command.Argv()[1]; got != \"pane\" {\n57|\t\tt.Fatalf(\"constructor aliases the caller slice: %q\", got)\n58|\t}\n59|\tout := command.Argv()\n60|\tout[0] = \"MUTATED\"\n61|\tif command.Executable() != \"ax\" {\n62|\t\tt.Fatalf(\"accessor aliases the admitted vector: %q\", command.Executable())\n63|\t}\n64|\tif _, err := NewCommand(nil); err == nil {\n65|\t\tt.Fatal(\"NewCommand(nil) admitted an empty vector\")\n66|\t}\n67|}\n68|\n69|// shellTokens are the shell-construction shapes this package must never\n70|// contain outside a comment. The list is pinned by the instrument test\n71|// below, which proves each token fires in code position and stays silent\n72|// in comment position.\n73|var shellTokens = []string{\n74|\t\"sh -c\", \"/bin/sh\", \"cmd /c\", \"cmd.exe\", \"powershell\",\n75|\t\"ShellExecute\", \"system(\", \"popen(\", \"/bin/bash\",\n76|}\n77|\n78|// codeWithoutComments strips line comments so tokens named to explain the\n79|// gate do not trip it.\n80|func codeWithoutComments(contents string) string {\n81|\tvar code []string\n82|\tfor _, line := range strings.Split(contents, \"\\n\") {\n83|\t\tif index := strings.Index(line, \"//\"); index >= 0 {\n84|\t\t\tline = line[:index]\n85|\t\t}\n86|\t\tcode = append(code, line)\n87|\t}\n88|\treturn strings.Join(code, \"\\n\")\n89|}\n90|\n91|// TestShellTokenInstrumentIsProven proves the token scanner against one\n92|// synthetic file per token: each token fires in code position (so a live\n93|// token is never dead ceremony) and stays silent in comment position (so\n94|// the gate's own documentation does not trip it).\n95|func TestShellTokenInstrumentIsProven(t *testing.T) {\n96|\tt.Parallel()\n97|\tfor _, token := range shellTokens {\n98|\t\tcode := \"package x\\nvar s = \\\"\" + token + \"\\\"\\n\"\n99|\t\tif found := shellTokensIn(codeWithoutComments(code)); len(found) == 0 {\n100|\t\t\tt.Errorf(\"token %q does not fire in code position; the scanner is blind to it\", token)\n101|\t\t}\n102|\t\tdocumented := \"package x\\n// forbidden: \" + token + \" must never appear\\n\"\n103|\t\tif found := shellTokensIn(codeWithoutComments(documented)); len(found) != 0 {\n104|\t\t\tt.Errorf(\"token %q fires in comment position; the gate cannot document itself\", token)\n105|\t\t}\n106|\t}\n107|}\n108|\n109|func shellTokensIn(code string) []string {\n110|\tvar found []string\n111|\tfor _, token := range shellTokens {\n112|\t\tif strings.Contains(code, token) {\n113|\t\t\tfound = append(found, token)\n114|\t\t}\n115|\t}\n116|\treturn found\n117|}\n118|\n119|// TestPackageHasNoShellString scans production source for shell\n120|// construction tokens. It is the static half of the no-shell gate; the\n121|// behavioral half below catches the token-preserving mutant that builds\n122|// the shell name without a literal.\n123|func TestPackageHasNoShellString(t *testing.T) {\n124|\tt.Parallel()\n125|\tdirectory, err := os.Getwd()\n126|\tif err != nil {\n127|\t\tt.Fatal(err)\n128|\t}\n129|\tentries, err := os.ReadDir(directory)\n130|\tif err != nil {\n131|\t\tt.Fatal(err)\n132|\t}\n133|\tscanned := 0\n134|\tfor _, entry := range entries {\n135|\t\tname := entry.Name()\n136|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n137|\t\t\tcontinue\n138|\t\t}\n139|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n140|\t\tif err != nil {\n141|\t\t\tt.Fatal(err)\n142|\t\t}\n143|\t\tscanned++\n144|\t\tfor _, found := range shellTokensIn(codeWithoutComments(string(contents))) {\n145|\t\t\tt.Errorf(\"%s carries shell token %q outside a comment\", name, found)\n146|\t\t}\n147|\t}\n148|\tif scanned == 0 {\n149|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n150|\t}\n151|}\n152|\n153|// TestPackageLaunchesNoProcess is the behavioral half of the no-shell\n154|// gate: this package validates argv vectors but never starts a process,\n155|// so importing os/exec here is a defect no token scan can excuse. The\n156|// token-preserving mutant adds an os/exec import with the shell name\n157|// assembled from variables (no literal token to scan for); this test\n158|// fails on the import, not on the token.\n159|func TestPackageLaunchesNoProcess(t *testing.T) {\n160|\tt.Parallel()\n161|\tdirectory, err := os.Getwd()\n162|\tif err != nil {\n163|\t\tt.Fatal(err)\n164|\t}\n165|\tentries, err := os.ReadDir(directory)\n166|\tif err != nil {\n167|\t\tt.Fatal(err)\n168|\t}\n169|\tscanned := 0\n170|\tfor _, entry := range entries {\n171|\t\tname := entry.Name()\n172|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n173|\t\t\tcontinue\n174|\t\t}\n175|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n176|\t\tif err != nil {\n177|\t\t\tt.Fatal(err)\n178|\t\t}\n179|\t\tscanned++\n180|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), name, contents, parser.ImportsOnly)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatal(err)\n183|\t\t}\n184|\t\tfor _, imported := range syntax.Imports {\n185|\t\t\tif strings.Trim(imported.Path.Value, `\"`) == \"os/exec\" {\n186|\t\t\t\tt.Fatalf(\"%s imports os/exec: this package validates argv but never launches\", name)\n187|\t\t\t}\n188|\t\t}\n189|\t}\n190|\tif scanned == 0 {\n191|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n192|\t}\n193|}"}}}
