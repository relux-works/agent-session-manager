{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c443","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":124,"recorded_at":1780531400000243,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"da573840-c778-4d5c-9e01-74ddbcc6b70f"},"task_id":"da573840-c778-4d5c-9e01-74ddbcc6b70f","event":{"kind":"output","task_id":"da573840-c778-4d5c-9e01-74ddbcc6b70f","chunk":"Read text file `internal/cigate/targets_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"sort\"\n6|\t\"testing\"\n7|)\n8|\n9|func TestFuzzTargetsAreDerivedSorted(t *testing.T) {\n10|\tt.Parallel()\n11|\ttargets, err := FuzzTargets()\n12|\tif err != nil {\n13|\t\tt.Fatalf(\"FuzzTargets() error = %v\", err)\n14|\t}\n15|\tif len(targets) == 0 {\n16|\t\tt.Fatal(\"FuzzTargets() is empty; CI would pass on an empty matrix\")\n17|\t}\n18|\tsorted := append([]string(nil), targets...)\n19|\tsort.Strings(sorted)\n20|\tif !reflect.DeepEqual(targets, sorted) {\n21|\t\tt.Fatalf(\"FuzzTargets() = %v, want sorted\", targets)\n22|\t}\n23|\tfor _, target := range targets {\n24|\t\tif len(target) < 5 || target[:4] != \"Fuzz\" {\n25|\t\t\tt.Errorf(\"target %q is not a Fuzz entry point\", target)\n26|\t\t}\n27|\t}\n28|}\n29|\n30|func TestSortedTargetsRefusals(t *testing.T) {\n31|\tt.Parallel()\n32|\tif _, err := sortedTargets(map[string]string{}); err == nil {\n33|\t\tt.Error(\"empty derivation admitted; CI would expand an empty matrix\")\n34|\t}\n35|\tif _, err := sortedTargets(map[string]string{\"NotAFuzz\": \"secprim.X\"}); err == nil {\n36|\t\tt.Error(\"non-Fuzz target admitted\")\n37|\t}\n38|\tif _, err := sortedTargets(map[string]string{\"FuzzX\": \"\"}); err == nil {\n39|\t\tt.Error(\"target without an entry admitted\")\n40|\t}\n41|\tgot, err := sortedTargets(map[string]string{\"FuzzB\": \"e\", \"FuzzA\": \"e\"})\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"sortedTargets() error = %v\", err)\n44|\t}\n45|\tif !reflect.DeepEqual(got, []string{\"FuzzA\", \"FuzzB\"}) {\n46|\t\tt.Fatalf(\"sortedTargets() = %v, want sorted\", got)\n47|\t}\n48|}"}}}
