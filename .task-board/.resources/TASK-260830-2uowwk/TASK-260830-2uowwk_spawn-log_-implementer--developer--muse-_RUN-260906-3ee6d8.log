{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c781","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":539,"recorded_at":1780531400001073,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"83d1c4f9-09ed-4b71-8b4b-4e92f2661073"},"task_id":"83d1c4f9-09ed-4b71-8b4b-4e92f2661073","event":{"kind":"output","task_id":"83d1c4f9-09ed-4b71-8b4b-4e92f2661073","chunk":"edited\nchanged lines: lines 238-256\n--- original\n+++ updated\n@@\n-      # Targets are derived from the compiled test binary, never retyped:\n-      # only names starting with Fuzz are fuzz targets. An empty derivation\n-      # fails the grep and the explicit size check alike.\n-      - name: Derive fuzz targets\n-        run: |\n-          go test ./internal/secconftest -list 'Fuzz' > fuzz-targets.log 2>&1\n-          grep '^Fuzz' fuzz-targets.log > fuzz-targets.clean\n-          test -s fuzz-targets.clean\n-          cat fuzz-targets.clean\n-\n-      # A -fuzz selector that matches nothing exits 0 with \"no fuzz tests\n-      # to fuzz\", so exit status alone cannot prove execution. The\n-      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\n-      - name: Smoke each target\n-        run: |\n-          while IFS= read -r target; do\n-            go test ./internal/secconftest -run='^$' -fuzz=\"^${target}$\" -fuzztime=100x -parallel=1 -count=1 > \"fuzz-${target}.log\" 2>&1\n-            grep -q '^fuzz: elapsed' \"fuzz-${target}.log\"\n-          done < fuzz-targets.clean\n+      # Targets are derived per package from the compiled test binaries,\n+      # never retyped: only names starting with Fuzz are fuzz targets. An\n+      # empty derivation fails the grep and the explicit size check alike,\n+      # and the total count is pinned: a new fuzz target without a CI\n+      # update reddens here instead of going unsmoked.\n+      - name: Derive fuzz targets\n+        run: |\n+          rm -f fuzz-targets.clean\n+          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\n+            go test \"./${pkg}\" -list '^Fuzz' > \"fuzz-targets-$(basename \"${pkg}\").log\" 2>&1\n+            grep '^Fuzz' \"fuzz-targets-$(basename \"${pkg}\").log\" | sed \"s|^|${pkg} |\" >> fuzz-targets.clean\n+          done\n+          test -s fuzz-targets.clean\n+          test \"$(wc -l < fuzz-targets.clean | tr -d ' ')\" -eq 13\n+          cat fuzz-targets.clean\n+\n+      # The secconftest leg of that list must equal the cigate.FuzzTargets\n+      # derivation, which maps each target to the production entry it\n+      # drives. Either side drifting — a target without an entry, or an\n+      # entry without a target — fails the diff before any smoke runs.\n+      - name: Check secconftest list matches the target derivation\n+        run: |\n+          set +e\n+          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\n+          code=$?\n+          set -e\n+          cat cigate-targets.log\n+          test $code -eq 0\n+          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\n+            grep -q \"^--- PASS: ${gate}\" cigate-targets.log\n+          done\n+\n+      # A -fuzz selector that matches nothing exits 0 with \"no fuzz tests\n+      # to fuzz\", so exit status alone cannot prove execution. The\n+      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\n+      - name: Smoke each target\n+        run: |\n+          while read -r pkg target; do\n+            go test \"./${pkg}\" -run='^$' -fuzz=\"^${target}$\" -fuzztime=100x -parallel=1 -count=1 > \"fuzz-$(basename \"${pkg}\")-${target}.log\" 2>&1\n+            grep -q '^fuzz: elapsed' \"fuzz-$(basename \"${pkg}\")-${target}.log\"\n+          done < fuzz-targets.clean\n"}}}
