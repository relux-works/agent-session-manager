{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ff","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":90,"recorded_at":1780531400000175,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"64ba4093-1c86-44bd-b93a-89d01e2fa48e"},"task_id":"64ba4093-1c86-44bd-b93a-89d01e2fa48e","event":{"kind":"output","task_id":"64ba4093-1c86-44bd-b93a-89d01e2fa48e","chunk":"Read text file `internal/cigate/claims.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n10|)\n11|\n12|// ProbeState is one platform-capability probe outcome. IDs always come from\n13|// secconftest.DefaultCapabilities; this package defines no capability of its\n14|// own.\n15|type ProbeState struct {\n16|\tID        string\n17|\tAvailable bool\n18|}\n19|\n20|// Finding is one refused advertisement mention: a backticked probe ID in a\n21|// sentence the gate cannot admit.\n22|type Finding struct {\n23|\tID     string\n24|\tLine   int\n25|\tText   string\n26|\tReason string\n27|}\n28|\n29|// positiveAvailability are the verb phrases that state a capability is\n30|// provided. Each is pinned by a dedicated claim row: dropping one admits the\n31|// matching claim silently.\n32|var positiveAvailability = []string{\n33|\t\"available\",\n34|\t\"supported\",\n35|\t\"enabled\",\n36|\t\"works\",\n37|\t\"passes\",\n38|}\n39|\n40|// negations flip a positive phrase into a non-claim. Each is pinned by a\n41|// dedicated row: dropping one refuses an honestly conditional sentence.\n42|var negations = []string{\n43|\t\"not\",\n44|\t\"never\",\n45|\t\"no\",\n46|\t\"without\",\n47|\t\"cannot\",\n48|\t\"can't\",\n49|\t\"n't\",\n50|\t\"unavailable\",\n51|\t\"disabled\",\n52|\t\"conditional\",\n53|\t\"pending\",\n54|\t\"unless\",\n55|\t\"only\",\n56|}\n57|\n58|// nonClaimMarkers are descriptive words showing a sentence documents the\n59|// instrument (probes, skips, gates, tests) rather than advertising a\n60|// capability. Every marker must occur in at least one scanned corpus sentence\n61|// (see TestEveryNonClaimMarkerOccursInCorpus): a marker that fires nowhere is\n62|// either dead weight or an admission hole waiting for future text.\n63|var nonClaimMarkers = []string{\n64|\t\"probes\",\n65|\t\"capability\",\n66|\t\"attempt\",\n67|\t\"gates\",\n68|\t\"test\",\n69|\t\"witness\",\n70|\t\"skip\",\n71|\t\"strict\",\n72|\t\"platform\",\n73|\t\"lstat\",\n74|\t\"mkfifo\",\n75|\t\"chmod\",\n76|\t\"uid\",\n77|\t\"pinned\",\n78|\t\"rejected\",\n79|\t\"fixture\",\n80|\t\"denial\",\n81|\t\"fail\",\n82|\t\"check\",\n83|\t\"scan\",\n84|}\n85|\n86|// wordPatterns precompiles every gate word once at init. The compiled set is\n87|// read-only afterwards, so parallel checks share it without a lock; a lazily\n88|// filled cache here would race under t.Parallel.\n89|var wordPatterns = func() map[string]*regexp.Regexp {\n90|\tpatterns := map[string]*regexp.Regexp{}\n91|\tfor _, word := range append(append(append([]string(nil), positiveAvailability...), negations...), nonClaimMarkers...) {\n92|\t\tpatterns[word] = regexp.MustCompile(`\\b` + regexp.QuoteMeta(word) + `\\b`)\n93|\t}\n94|\treturn patterns\n95|}()\n96|\n97|func wordMatches(word, text string) bool {\n98|\tpattern, ok := wordPatterns[word]\n99|\tif !ok {\n100|\t\treturn false\n101|\t}\n102|\treturn pattern.MatchString(text)\n103|}\n104|\n105|func containsAnyFold(words []string, text string) bool {\n106|\tlowered := strings.ToLower(text)\n107|\tfor _, word := range words {\n108|\t\tif wordMatches(word, lowered) {\n109|\t\t\treturn true\n110|\t\t}\n111|\t}\n112|\treturn false\n113|}\n114|\n115|// ProbeStates runs every secconftest capability probe on this host and\n116|// returns the outcomes. IDs are derived, never retyped; an empty derivation\n117|// is refused rather than treated as nothing to check.\n118|func ProbeStates() ([]ProbeState, error) {\n119|\tcapabilities := secconftest.DefaultCapabilities()\n120|\tif len(capabilities) == 0 {\n121|\t\treturn nil, fmt.Errorf(\"cigate: capability probe derivation is empty\")\n122|\t}\n123|\tstates := make([]ProbeState, 0, len(capabilities))\n124|\tfor _, capability := range capabilities {\n125|\t\tif capability.ID == \"\" || capability.Probe == nil {\n126|\t\t\treturn nil, fmt.Errorf(\"cigate: capability without identity or probe is unusable\")\n127|\t\t}\n128|\t\tavailable, _ := capability.Probe()\n129|\t\tstates = append(states, ProbeState{ID: capability.ID, Available: available})\n130|\t}\n131|\tsort.Slice(states, func(i, j int) bool { return states[i].ID < states[j].ID })\n132|\treturn states, nil\n133|}\n134|\n135|// CapabilityIDs derives the probe vocabulary: the sorted IDs of every\n136|// secconftest capability. It is the only vocabulary the advertisement check\n137|// may name.\n138|func CapabilityIDs() ([]string, error) {\n139|\tstates, err := ProbeStates()\n140|\tif err != nil {\n141|\t\treturn nil, err\n142|\t}\n143|\tids := make([]string, 0, len(states))\n144|\tfor _, state := range states {\n145|\t\tids = append(ids, state.ID)\n146|\t}\n147|\treturn ids, nil\n148|}\n149|\n150|// sentence is one classified unit with its 1-based starting line.\n151|type sentence struct {\n152|\ttext string\n153|\tline int\n154|}\n155|\n156|// splitSentences unwraps blank-line-separated blocks onto single lines and\n157|// splits them at sentence-terminal punctuation. Offsets are approximate by\n158|// construction; findings carry the starting line so a human can locate the\n159|// mention exactly.\n160|func splitSentences(document string) []sentence {\n161|\tvar sentences []sentence\n162|\tnormalized := strings.ReplaceAll(document, \"\\r\\n\", \"\\n\")\n163|\traw := strings.Split(normalized, \"\\n\")\n164|\tfor start := 0; start < len(raw); {\n165|\t\tif strings.TrimSpace(raw[start]) == \"\" {\n166|\t\t\tstart++\n167|\t\t\tcontinue\n168|\t\t}\n169|\t\tend := start\n170|\t\tfor end < len(raw) && strings.TrimSpace(raw[end]) != \"\" {\n171|\t\t\tend++\n172|\t\t}\n173|\t\tvar cleaned []string\n174|\t\tvar rows []int\n175|\t\tfor row := start; row < end; row++ {\n176|\t\t\ttrimmed := strings.TrimSpace(raw[row])\n177|\t\t\tif trimmed == \"\" {\n178|\t\t\t\tcontinue\n179|\t\t\t}\n180|\t\t\tcleaned = append(cleaned, trimmed)\n181|\t\t\trows = append(rows, row+1)\n182|\t\t}\n183|\t\tstart = end\n184|\t\tif len(cleaned) == 0 {\n185|\t\t\tcontinue\n186|\t\t}\n187|\t\tjoined := strings.Join(cleaned, \" \")\n188|\t\tlineOf := make([]int, len(joined))\n189|\t\toffset := 0\n190|\t\tfor index, line := range cleaned {\n191|\t\t\tfor range line {\n192|\t\t\t\tif offset < len(lineOf) {\n193|\t\t\t\t\tlineOf[offset] = rows[index]\n194|\t\t\t\t}\n195|\t\t\t\toffset++\n196|\t\t\t}\n197|\t\t\tif offset < len(lineOf) {\n198|\t\t\t\tlineOf[offset] = rows[index]\n199|\t\t\t\toffset++\n200|\t\t\t}\n201|\t\t}\n202|\t\tstart := 0\n203|\t\tfor index := 0; index < len(joined); index++ {\n204|\t\t\tend := index == len(joined)-1\n205|\t\t\tboundary := end ||\n206|\t\t\t\t((joined[index] == '.' || joined[index] == '!' || joined[index] == '?') &&\n207|\t\t\t\t\t(index+1 >= len(joined) || joined[index+1] == ' ' || joined[index+1] == '\\t'))\n208|\t\t\tif !boundary {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\ttext := strings.TrimSpace(joined[start : index+1])\n212|\t\t\tif text != \"\" {\n213|\t\t\t\tsentences = append(sentences, sentence{text: text, line: lineOf[start]})\n214|\t\t\t}\n215|\t\t\tstart = index + 1\n216|\t\t}\n217|\t}\n218|\treturn sentences\n219|}\n220|\n221|// CheckAdvertisements refuses every sentence that advertises a capability the\n222|// probes report unavailable. An empty probe set or an empty document is\n223|// refused outright: a gate that finds nothing to check, or nothing to check\n224|// against, passes on an empty result set, which is the defect class this\n225|// story removes.\n226|func CheckAdvertisements(document string, states []ProbeState) ([]Finding, error) {\n227|\tif len(states) == 0 {\n228|\t\treturn nil, fmt.Errorf(\"cigate: no probe outcomes to check advertisements against\")\n229|\t}\n230|\tif strings.TrimSpace(document) == \"\" {\n231|\t\treturn nil, fmt.Errorf(\"cigate: empty document proves no advertisement claim\")\n232|\t}\n233|\tavailability := make(map[string]bool, len(states))\n234|\tfor _, state := range states {\n235|\t\tavailability[state.ID] = state.Available\n236|\t}\n237|\tvar findings []Finding\n238|\tfor _, part := range splitSentences(document) {\n239|\t\tvar mentioned []string\n240|\t\tfor id := range availability {\n241|\t\t\tif strings.Contains(part.text, \"`\"+id+\"`\") {\n242|\t\t\t\tmentioned = append(mentioned, id)\n243|\t\t\t}\n244|\t\t}\n245|\t\tif len(mentioned) == 0 {\n246|\t\t\tcontinue\n247|\t\t}\n248|\t\tsort.Strings(mentioned)\n249|\t\tvar unavailable []string\n250|\t\tfor _, id := range mentioned {\n251|\t\t\tif !availability[id] {\n252|\t\t\t\tunavailable = append(unavailable, id)\n253|\t\t\t}\n254|\t\t}\n255|\t\tif len(unavailable) == 0 {\n256|\t\t\tcontinue\n257|\t\t}\n258|\t\tif containsAnyFold(positiveAvailability, part.text) &&\n259|\t\t\t!containsAnyFold(negations, part.text) {\n260|\t\t\tfor _, id := range unavailable {\n261|\t\t\t\tfindings = append(findings, Finding{\n262|\t\t\t\t\tID:     id,\n263|\t\t\t\t\tLine:   part.line,\n264|\t\t\t\t\tText:   part.text,\n265|\t\t\t\t\tReason: \"positive availability claim for an unavailable capability\",\n266|\t\t\t\t})\n267|\t\t\t}\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif !containsAnyFold(append(append([]string(nil), negations...), nonClaimMarkers...), part.text) {\n271|\t\t\tfor _, id := range unavailable {\n272|\t\t\t\tfindings = append(findings, Finding{\n273|\t\t\t\t\tID:     id,\n274|\t\t\t\t\tLine:   part.line,\n275|\t\t\t\t\tText:   part.text,\n276|\t\t\t\t\tReason: \"unclassified mention of an unavailable capability\",\n277|\t\t\t\t})\n278|\t\t\t}\n279|\t\t}\n280|\t}\n281|\treturn findings, nil\n282|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c401","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":91,"recorded_at":1780531400000177,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"64ba4093-1c86-44bd-b93a-89d01e2fa48e"},"task_id":"64ba4093-1c86-44bd-b93a-89d01e2fa48e","event":{"kind":"completed","task_id":"64ba4093-1c86-44bd-b93a-89d01e2fa48e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c403","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":92,"recorded_at":1780531400000179,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782c97ad7a53b19b9ce91509cb7b","text":"Read text file `.github/workflows/ci.yml`.\n1|name: CI\n2|\n3|on:\n4|  pull_request:\n5|  push:\n6|    branches:\n7|      - main\n8|\n9|permissions:\n10|  contents: read\n11|\n12|# What green means. Every job below proves its selection matched something:\n13|# a grep, glob, file scan, matrix expansion, or test selector that finds\n14|# nothing fails closed instead of passing on an empty result set. No job\n15|# declares an `if:` condition, so no job can skip quietly; gates-verdict\n16|# additionally refuses any skipped, failed, or cancelled dependency.\n17|#\n18|# GOOS=windows work is compile-and-vet only. A green windows-compile-only job\n19|# proves the tree type-checks for Windows; it never implies executed\n20|# behaviour. Coverage is reported as numbers, not enforced as a floor.\n21|jobs:\n22|  contract-preservation:\n23|    name: Contract preservation (v0.5.0 current, v0.4.3 historical)\n24|    runs-on: ubuntu-latest\n25|    timeout-minutes: 10\n26|    steps:\n27|      - name: Check out repository\n28|        uses: actions/checkout@v7\n29|\n30|      - name: Set up Go\n31|        uses: actions/setup-go@v7\n32|        with:\n33|          go-version-file: go.mod\n34|\n35|      - name: Verify specification-to-code ownership\n36|        run: go run ./internal/traceability/cmd/tracecheck\n37|\n38|      - name: Verify generated catalog is current\n39|        run: |\n40|          go generate ./internal/catalog\n41|          git diff --exit-code -- internal/catalog/catalog_gen.go\n42|\n43|      # The release roots are derived from internal/specpin and\n44|      # internal/catalog inside the gate, never retyped here. Each -- PASS\n45|      # guard below must match: a selector that runs nothing fails here\n46|      # instead of passing silently.\n47|      - name: Run pinned contract-version gates\n48|        run: |\n49|          set +e\n50|          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\n51|          code=$?\n52|          set -e\n53|          cat cigate-contracts.log\n54|          test $code -eq 0\n55|          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do\n56|            grep -q \"^--- PASS: ${gate}\" cigate-contracts.log\n57|          done\n58|\n59|  lint:\n60|    name: Linters (vet, Windows vet, gofmt)\n61|    runs-on: ubuntu-latest\n62|    timeout-minutes: 10\n63|    steps:\n64|      - name: Check out repository\n65|        uses: actions/checkout@v7\n66|\n67|      - name: Set up Go\n68|        uses: actions/setup-go@v7\n69|        with:\n70|          go-version-file: go.mod\n71|\n72|      - name: Vet\n73|        run: go vet ./...\n74|\n75|      - name: Vet Windows build-tagged sources\n76|        run: GOOS=windows go vet ./...\n77|\n78|      # gofmt lists only offending files, so a clean tree prints nothing.\n79|      # The file count proves the scan was not empty; the log must then be.\n80|      - name: Check formatting\n81|        run: |\n82|          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\n83|          echo \"go files scanned: ${count}\"\n84|          test \"${count}\" -gt 0\n85|          set +e\n86|          gofmt -l internal > gofmt.log 2>&1\n87|          code=$?\n88|          set -e\n89|          cat gofmt.log\n90|          test $code -eq 0\n91|          test ! -s gofmt.log\n92|\n93|  test:\n94|    name: Build and test (no cache)\n95|    runs-on: ubuntu-latest\n96|    timeout-minutes: 15\n97|    steps:\n98|      - name: Check out repository\n99|        uses: actions/checkout@v7\n100|\n101|      - name: Set up Go\n102|        uses: actions/setup-go@v7\n103|        with:\n104|          go-version-file: go.mod\n105|\n106|      - name: Build\n107|        run: go build ./...\n108|\n109|      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\n110|      # datum. At least one package must report ok: a suite that matched\n111|      # nothing is a failure, not a pass.\n112|      - name: Test\n113|        run: |\n114|          set +e\n115|          go test ./... -v -count=1 > test.log 2>&1\n116|          code=$?\n117|          set -e\n118|          cat test.log\n119|          test $code -eq 0\n120|          test \"$(grep -c '^ok' test.log)\" -gt 0\n121|          test \"$(grep -c '^FAIL' test.log || true)\" -eq 0\n122|          {\n123|            echo \"## Suite skips\"\n124|            echo \"\"\n125|            echo \"Skipped: $(grep -c '^--- SKIP' test.log || true)\"\n126|            grep '^--- SKIP' test.log || echo \"none\"\n127|          } >> \"$GITHUB_STEP_SUMMARY\"\n128|\n129|  race:\n130|    name: Race detector\n131|    runs-on: ubuntu-latest\n132|    timeout-minutes: 15\n133|    steps:\n134|      - name: Check out repository\n135|        uses: actions/checkout@v7\n136|\n137|      - name: Set up Go\n138|        uses: actions/setup-go@v7\n139|        with:\n140|          go-version-file: go.mod\n141|\n142|      - name: Test with race detector\n143|        run: |\n144|          set +e\n145|          go test -race ./... -count=1 > race.log 2>&1\n146|          code=$?\n147|          set -e\n148|          cat race.log\n149|          test $code -eq 0\n150|          test \"$(grep -c '^ok' race.log)\" -gt 0\n151|\n152|  coverage:\n153|    name: Coverage numbers (reported, no floor)\n154|    runs-on: ubuntu-latest\n155|    timeout-minutes: 15\n156|    steps:\n157|      - name: Check out repository\n158|        uses: actions/checkout@v7\n159|\n160|      - name: Set up Go\n161|        uses: actions/setup-go@v7\n162|        with:\n163|          go-version-file: go.mod\n164|\n165|      # Coverage is a number, not a gate: this job reports per-package\n166|      # percentages and refuses only an unreadable or empty result.\n167|      - name: Test with coverage\n168|        run: |\n169|          set +e\n170|          go test ./... -cover -count=1 > cover.log 2>&1\n171|          code=$?\n172|          set -e\n173|          cat cover.log\n174|          test $code -eq 0\n175|          test \"$(grep -c 'coverage: ' cover.log)\" -gt 0\n176|          {\n177|            echo \"## Coverage\"\n178|            echo \"\"\n179|            echo \"| Package | Coverage |\"\n180|            echo \"| --- | --- |\"\n181|            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\2` | \\3 |/' || true\n182|            echo \"\"\n183|            echo \"Packages without test files (stated bounds, not failures):\"\n184|            echo \"\"\n185|            grep 'no test files' cover.log || echo \"none\"\n186|          } >> \"$GITHUB_STEP_SUMMARY\"\n187|\n188|  fixture-matrix:\n189|    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\n190|    runs-on: ${{ matrix.os }}\n191|    timeout-minutes: 15\n192|    strategy:\n193|      fail-fast: false\n194|      matrix:\n195|        os: [ubuntu-latest, macos-latest]\n196|        package: [internal/secprim, internal/secconftest]\n197|    steps:\n198|      - name: Check out repository\n199|        uses: actions/checkout@v7\n200|\n201|      - name: Set up Go\n202|        uses: actions/setup-go@v7\n203|        with:\n204|          go-version-file: go.mod\n205|\n206|      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\n207|      # secconftest capabilities line witnesses the probe counters after the\n208|      # whole suite. Skips are loud here by construction.\n209|      - name: Run fixture package\n210|        run: |\n211|          set +e\n212|          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\n213|          code=$?\n214|          set -e\n215|          grep '^--- SKIP' fixture.log || echo \"no skipped tests\"\n216|          grep 'secconftest capabilities on' fixture.log || true\n217|          {\n218|            echo \"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\"\n219|            echo \"\"\n220|            echo \"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\"\n221|          } >> \"$GITHUB_STEP_SUMMARY\"\n222|          test $code -eq 0\n223|          test \"$(grep -c '^--- PASS' fixture.log)\" -gt 0\n224|\n225|  fuzz-smoke:\n226|    name: Fuzz smoke (derived targets)\n227|    runs-on: ubuntu-latest\n228|    timeout-minutes: 15\n229|    steps:\n230|      - name: Check out repository\n231|        uses: actions/checkout@v7\n232|\n233|      - name: Set up Go\n234|        uses: actions/setup-go@v7\n235|        with:\n236|          go-version-file: go.mod\n237|\n238|      # Targets are derived from the compiled test binary, never retyped:\n239|      # only names starting with Fuzz are fuzz targets. An empty derivation\n240|      # fails the grep and the explicit size check alike.\n241|      - name: Derive fuzz targets\n242|        run: |\n243|          go test ./internal/secconftest -list 'Fuzz' > fuzz-targets.log 2>&1\n244|          grep '^Fuzz' fuzz-targets.log > fuzz-targets.clean\n245|          test -s fuzz-targets.clean\n246|          cat fuzz-targets.clean\n247|\n248|      # A -fuzz selector that matches nothing exits 0 with \"no fuzz tests\n249|      # to fuzz\", so exit status alone cannot prove execution. The\n250|      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\n251|      - name: Smoke each target\n252|        run: |\n253|          while IFS= read -r target; do\n254|            go test ./internal/secconftest -run='^$' -fuzz=\"^${target}$\" -fuzztime=100x -parallel=1 -count=1 > \"fuzz-${target}.log\" 2>&1\n255|            grep -q '^fuzz: elapsed' \"fuzz-${target}.log\"\n256|          done < fuzz-targets.clean\n257|\n258|  capability-claims:\n259|    name: Unsupported-capability claim check\n260|    runs-on: ubuntu-latest\n261|    timeout-minutes: 10\n262|    steps:\n263|      - name: Check out repository\n264|        uses: actions/checkout@v7\n265|\n266|      - name: Set up Go\n267|        uses: actions/setup-go@v7\n268|        with:\n269|          go-version-file: go.mod\n270|\n271|      # The vocabulary is secconftest's probe set; the gate admits a mention\n272|      # only in probe/skip/gate/test context, and refuses any positive\n273|      # availability claim about a capability the probes report unavailable.\n274|      # README prose is never capability evidence either way.\n275|      - name: Check README against live probes\n276|        run: |\n277|          set +e\n278|          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\n279|          code=$?\n280|          set -e\n281|          cat cigate-claims.log\n282|          test $code -eq 0\n283|          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\n284|            grep -q \"^--- PASS: ${gate}\" cigate-claims.log\n285|          done\n286|\n287|      # The probe counters on this host are evidence, not prose: TestMain\n288|      # prints them after every test, including the parallel ones. The last\n289|      # capabilities line is the datum: the wiring test above records\n290|      # synthetic verdicts mid-test and restores them, so only the final\n291|      # line reports this host. Skips are legitimate on some hosts and are\n292|      # audited loudly in the fixture matrix, never required to be zero.\n293|      - name: Record live probe verdicts\n294|        run: |\n295|          go test ./internal/secconftest -run 'TestSkipReportReadsRecordedVerdicts' -count=1 -v > probes.log 2>&1\n296|          cat probes.log\n297|          grep -q '^--- PASS: TestSkipReportReadsRecordedVerdicts' probes.log\n298|          grep 'secconftest capabilities on' probes.log | tail -n 1\n299|\n300|  windows-compile-only:\n301|    name: Windows compile-only (no execution implied)\n302|    runs-on: ubuntu-latest\n303|    timeout-minutes: 10\n304|    steps:\n305|      - name: Check out repository\n306|        uses: actions/checkout@v7\n307|\n308|      - name: Set up Go\n309|        uses: actions/setup-go@v7\n310|        with:\n311|          go-version-file: go.mod\n312|\n313|      # Compile-and-vet only: go vet type-checks test files as well, and no\n314|      # step here executes a Windows binary. A green here must never be read\n315|      # as behaviour executed on Windows.\n316|      - name: Compile for Windows\n317|        run: GOOS=windows go build ./...\n318|\n319|      - name: Vet Windows build (includes test files)\n320|        run: GOOS=windows go vet ./...\n321|\n322|  gates-verdict:\n323|    name: All gates green, none skipped\n324|    runs-on: ubuntu-latest\n325|    timeout-minutes: 5\n326|    needs:\n327|      - contract-preservation\n328|      - lint\n329|      - test\n330|      - race\n331|      - coverage\n332|      - fixture-matrix\n333|      - fuzz-smoke\n334|      - capability-claims\n335|      - windows-compile-only\n336|    if: always()\n337|    steps:\n338|      - name: Refuse any non-success dependency\n339|        run: |\n340|          echo '${{ toJSON(needs) }}' > needs.json\n341|          jq . needs.json\n342|          jq -e 'to_entries | map(select(.value.result != \"success\")) | length == 0' needs.json","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c405","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":93,"recorded_at":1780531400000181,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782c98167d308e9b41328a31d027","text":"Read text file `internal/cigate/doc.go`.\n1|// Package cigate implements the M0 continuous-conformance CI gates for the\n2|// security-primitives-and-conformance-ci story: historical and current\n3|// contract preservation, fixture-target derivation, and the\n4|// unsupported-capability advertisement check.\n5|//\n6|// It is a gate, not a second authority. Every behavior it constrains is\n7|// decided by an existing owner; this package only re-derives those decisions\n8|// from their owners and refuses drift:\n9|//\n10|//   - pinned contract versions stay in internal/specpin; the typed release\n11|//     projections stay in internal/catalog. VerifyContractPreservation\n12|//     requires the two authorities to agree exactly and fails closed on a\n13|//     version either side cannot account for;\n14|//   - platform capability availability stays in internal/secconftest probes.\n15|//     CheckAdvertisements takes probe outcomes as input and never defines a\n16|//     capability of its own;\n17|//   - fuzz entry points stay in internal/secconftest. FuzzTargets derives the\n18|//     committed target list from FuzzTargetEntry rather than retyping it.\n19|//\n20|// Normative scope: AX v0.5.0 Sections 16, 19.2-19.5, 20.2, Appendix D. The\n21|// Section 19.3 provider suites and Section 19.4 lifecycle cases outside\n22|// Section 16 are not driven here; CI runs them only where their owning\n23|// packages already implement them, and this gate claims nothing about the\n24|// rest.\n25|//\n26|// Stated bounds. The gates are read-only: they parse the pinned authorities\n27|// and repository text and write only their verdict to the caller. They mutate\n28|// no durable state, keep no cache, and carry no crash or idempotency surface\n29|// of their own; crash/idempotency evidence for the story is the secconftest\n30|// Transactor battery, which CI executes but which lives outside this package.\n31|// Availability is evaluated on the host that runs the check: a positive claim\n32|// about a capability available here is admitted even when the same sentence\n33|// would be refused on a host where the probe fails. Cross-host claim truth is\n34|// outside this gate. The advertisement scanner reads prose only; it classifies\n35|// sentences, not intent, and any sentence it cannot classify is refused rather\n36|// than ignored.\n37|//\n38|// Deliberate shape decision: this package ships no main package. Its library\n39|// entry points import internal/secconftest for the probe vocabulary, and\n40|// secconftest reads internal/specdoc, which the specdoc guard forbids any new\n41|// main from reaching (TestEmbeddedDocumentNeverReachesAProductBinary and\n42|// TestModuleHasNoProductCommandYet). A cigate command would need either a\n43|// foreign allowlist widening or a second probe vocabulary, both of which this\n44|// story exists to refuse. CI therefore drives these gates through focused,\n45|// name-guarded go test selections; the guards prove the selection matched.\n46|package cigate","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782c989c7ba3a09bbf02e59237c5","text":"Read text file `internal/cigate/targets.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n9|)\n10|\n11|// FuzzTargets derives the committed fuzz-target list from the instrument's\n12|// own FuzzTargetEntry map, sorted. CI iterates this derivation rather than a\n13|// retyped copy, so a target added without an entry — or an entry without a\n14|// target — breaks the derivation's own pin before CI can pass on an empty or\n15|// stale list.\n16|func FuzzTargets() ([]string, error) {\n17|\tentries := make(map[string]string, len(secconftest.FuzzTargetEntry))\n18|\tfor target, entry := range secconftest.FuzzTargetEntry {\n19|\t\tentries[target] = string(entry)\n20|\t}\n21|\treturn sortedTargets(entries)\n22|}\n23|\n24|// sortedTargets is the testable core of FuzzTargets: production passes the\n25|// instrument's own map, tests pass synthetic ones.\n26|func sortedTargets(entries map[string]string) ([]string, error) {\n27|\ttargets := make([]string, 0, len(entries))\n28|\tfor target, entry := range entries {\n29|\t\tif !strings.HasPrefix(target, \"Fuzz\") || entry == \"\" {\n30|\t\t\treturn nil, fmt.Errorf(\"cigate: fuzz target entry %q is malformed\", target)\n31|\t\t}\n32|\t\ttargets = append(targets, target)\n33|\t}\n34|\tif len(targets) == 0 {\n35|\t\treturn nil, fmt.Errorf(\"cigate: fuzz target derivation is empty\")\n36|\t}\n37|\tsort.Strings(targets)\n38|\treturn targets, nil\n39|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c409","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":95,"recorded_at":1780531400000185,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782c993d71408a9f265d47f20974","text":"Read text file `internal/cigate/claims.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n10|)\n11|\n12|// ProbeState is one platform-capability probe outcome. IDs always come from\n13|// secconftest.DefaultCapabilities; this package defines no capability of its\n14|// own.\n15|type ProbeState struct {\n16|\tID        string\n17|\tAvailable bool\n18|}\n19|\n20|// Finding is one refused advertisement mention: a backticked probe ID in a\n21|// sentence the gate cannot admit.\n22|type Finding struct {\n23|\tID     string\n24|\tLine   int\n25|\tText   string\n26|\tReason string\n27|}\n28|\n29|// positiveAvailability are the verb phrases that state a capability is\n30|// provided. Each is pinned by a dedicated claim row: dropping one admits the\n31|// matching claim silently.\n32|var positiveAvailability = []string{\n33|\t\"available\",\n34|\t\"supported\",\n35|\t\"enabled\",\n36|\t\"works\",\n37|\t\"passes\",\n38|}\n39|\n40|// negations flip a positive phrase into a non-claim. Each is pinned by a\n41|// dedicated row: dropping one refuses an honestly conditional sentence.\n42|var negations = []string{\n43|\t\"not\",\n44|\t\"never\",\n45|\t\"no\",\n46|\t\"without\",\n47|\t\"cannot\",\n48|\t\"can't\",\n49|\t\"n't\",\n50|\t\"unavailable\",\n51|\t\"disabled\",\n52|\t\"conditional\",\n53|\t\"pending\",\n54|\t\"unless\",\n55|\t\"only\",\n56|}\n57|\n58|// nonClaimMarkers are descriptive words showing a sentence documents the\n59|// instrument (probes, skips, gates, tests) rather than advertising a\n60|// capability. Every marker must occur in at least one scanned corpus sentence\n61|// (see TestEveryNonClaimMarkerOccursInCorpus): a marker that fires nowhere is\n62|// either dead weight or an admission hole waiting for future text.\n63|var nonClaimMarkers = []string{\n64|\t\"probes\",\n65|\t\"capability\",\n66|\t\"attempt\",\n67|\t\"gates\",\n68|\t\"test\",\n69|\t\"witness\",\n70|\t\"skip\",\n71|\t\"strict\",\n72|\t\"platform\",\n73|\t\"lstat\",\n74|\t\"mkfifo\",\n75|\t\"chmod\",\n76|\t\"uid\",\n77|\t\"pinned\",\n78|\t\"rejected\",\n79|\t\"fixture\",\n80|\t\"denial\",\n81|\t\"fail\",\n82|\t\"check\",\n83|\t\"scan\",\n84|}\n85|\n86|// wordPatterns precompiles every gate word once at init. The compiled set is\n87|// read-only afterwards, so parallel checks share it without a lock; a lazily\n88|// filled cache here would race under t.Parallel.\n89|var wordPatterns = func() map[string]*regexp.Regexp {\n90|\tpatterns := map[string]*regexp.Regexp{}\n91|\tfor _, word := range append(append(append([]string(nil), positiveAvailability...), negations...), nonClaimMarkers...) {\n92|\t\tpatterns[word] = regexp.MustCompile(`\\b` + regexp.QuoteMeta(word) + `\\b`)\n93|\t}\n94|\treturn patterns\n95|}()\n96|\n97|func wordMatches(word, text string) bool {\n98|\tpattern, ok := wordPatterns[word]\n99|\tif !ok {\n100|\t\treturn false\n101|\t}\n102|\treturn pattern.MatchString(text)\n103|}\n104|\n105|func containsAnyFold(words []string, text string) bool {\n106|\tlowered := strings.ToLower(text)\n107|\tfor _, word := range words {\n108|\t\tif wordMatches(word, lowered) {\n109|\t\t\treturn true\n110|\t\t}\n111|\t}\n112|\treturn false\n113|}\n114|\n115|// ProbeStates runs every secconftest capability probe on this host and\n116|// returns the outcomes. IDs are derived, never retyped; an empty derivation\n117|// is refused rather than treated as nothing to check.\n118|func ProbeStates() ([]ProbeState, error) {\n119|\tcapabilities := secconftest.DefaultCapabilities()\n120|\tif len(capabilities) == 0 {\n121|\t\treturn nil, fmt.Errorf(\"cigate: capability probe derivation is empty\")\n122|\t}\n123|\tstates := make([]ProbeState, 0, len(capabilities))\n124|\tfor _, capability := range capabilities {\n125|\t\tif capability.ID == \"\" || capability.Probe == nil {\n126|\t\t\treturn nil, fmt.Errorf(\"cigate: capability without identity or probe is unusable\")\n127|\t\t}\n128|\t\tavailable, _ := capability.Probe()\n129|\t\tstates = append(states, ProbeState{ID: capability.ID, Available: available})\n130|\t}\n131|\tsort.Slice(states, func(i, j int) bool { return states[i].ID < states[j].ID })\n132|\treturn states, nil\n133|}\n134|\n135|// CapabilityIDs derives the probe vocabulary: the sorted IDs of every\n136|// secconftest capability. It is the only vocabulary the advertisement check\n137|// may name.\n138|func CapabilityIDs() ([]string, error) {\n139|\tstates, err := ProbeStates()\n140|\tif err != nil {\n141|\t\treturn nil, err\n142|\t}\n143|\tids := make([]string, 0, len(states))\n144|\tfor _, state := range states {\n145|\t\tids = append(ids, state.ID)\n146|\t}\n147|\treturn ids, nil\n148|}\n149|\n150|// sentence is one classified unit with its 1-based starting line.\n151|type sentence struct {\n152|\ttext string\n153|\tline int\n154|}\n155|\n156|// splitSentences unwraps blank-line-separated blocks onto single lines and\n157|// splits them at sentence-terminal punctuation. Offsets are approximate by\n158|// construction; findings carry the starting line so a human can locate the\n159|// mention exactly.\n160|func splitSentences(document string) []sentence {\n161|\tvar sentences []sentence\n162|\tnormalized := strings.ReplaceAll(document, \"\\r\\n\", \"\\n\")\n163|\traw := strings.Split(normalized, \"\\n\")\n164|\tfor start := 0; start < len(raw); {\n165|\t\tif strings.TrimSpace(raw[start]) == \"\" {\n166|\t\t\tstart++\n167|\t\t\tcontinue\n168|\t\t}\n169|\t\tend := start\n170|\t\tfor end < len(raw) && strings.TrimSpace(raw[end]) != \"\" {\n171|\t\t\tend++\n172|\t\t}\n173|\t\tvar cleaned []string\n174|\t\tvar rows []int\n175|\t\tfor row := start; row < end; row++ {\n176|\t\t\ttrimmed := strings.TrimSpace(raw[row])\n177|\t\t\tif trimmed == \"\" {\n178|\t\t\t\tcontinue\n179|\t\t\t}\n180|\t\t\tcleaned = append(cleaned, trimmed)\n181|\t\t\trows = append(rows, row+1)\n182|\t\t}\n183|\t\tstart = end\n184|\t\tif len(cleaned) == 0 {\n185|\t\t\tcontinue\n186|\t\t}\n187|\t\tjoined := strings.Join(cleaned, \" \")\n188|\t\tlineOf := make([]int, len(joined))\n189|\t\toffset := 0\n190|\t\tfor index, line := range cleaned {\n191|\t\t\tfor range line {\n192|\t\t\t\tif offset < len(lineOf) {\n193|\t\t\t\t\tlineOf[offset] = rows[index]\n194|\t\t\t\t}\n195|\t\t\t\toffset++\n196|\t\t\t}\n197|\t\t\tif offset < len(lineOf) {\n198|\t\t\t\tlineOf[offset] = rows[index]\n199|\t\t\t\toffset++\n200|\t\t\t}\n201|\t\t}\n202|\t\tstart := 0\n203|\t\tfor index := 0; index < len(joined); index++ {\n204|\t\t\tend := index == len(joined)-1\n205|\t\t\tboundary := end ||\n206|\t\t\t\t((joined[index] == '.' || joined[index] == '!' || joined[index] == '?') &&\n207|\t\t\t\t\t(index+1 >= len(joined) || joined[index+1] == ' ' || joined[index+1] == '\\t'))\n208|\t\t\tif !boundary {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\ttext := strings.TrimSpace(joined[start : index+1])\n212|\t\t\tif text != \"\" {\n213|\t\t\t\tsentences = append(sentences, sentence{text: text, line: lineOf[start]})\n214|\t\t\t}\n215|\t\t\tstart = index + 1\n216|\t\t}\n217|\t}\n218|\treturn sentences\n219|}\n220|\n221|// CheckAdvertisements refuses every sentence that advertises a capability the\n222|// probes report unavailable. An empty probe set or an empty document is\n223|// refused outright: a gate that finds nothing to check, or nothing to check\n224|// against, passes on an empty result set, which is the defect class this\n225|// story removes.\n226|func CheckAdvertisements(document string, states []ProbeState) ([]Finding, error) {\n227|\tif len(states) == 0 {\n228|\t\treturn nil, fmt.Errorf(\"cigate: no probe outcomes to check advertisements against\")\n229|\t}\n230|\tif strings.TrimSpace(document) == \"\" {\n231|\t\treturn nil, fmt.Errorf(\"cigate: empty document proves no advertisement claim\")\n232|\t}\n233|\tavailability := make(map[string]bool, len(states))\n234|\tfor _, state := range states {\n235|\t\tavailability[state.ID] = state.Available\n236|\t}\n237|\tvar findings []Finding\n238|\tfor _, part := range splitSentences(document) {\n239|\t\tvar mentioned []string\n240|\t\tfor id := range availability {\n241|\t\t\tif strings.Contains(part.text, \"`\"+id+\"`\") {\n242|\t\t\t\tmentioned = append(mentioned, id)\n243|\t\t\t}\n244|\t\t}\n245|\t\tif len(mentioned) == 0 {\n246|\t\t\tcontinue\n247|\t\t}\n248|\t\tsort.Strings(mentioned)\n249|\t\tvar unavailable []string\n250|\t\tfor _, id := range mentioned {\n251|\t\t\tif !availability[id] {\n252|\t\t\t\tunavailable = append(unavailable, id)\n253|\t\t\t}\n254|\t\t}\n255|\t\tif len(unavailable) == 0 {\n256|\t\t\tcontinue\n257|\t\t}\n258|\t\tif containsAnyFold(positiveAvailability, part.text) &&\n259|\t\t\t!containsAnyFold(negations, part.text) {\n260|\t\t\tfor _, id := range unavailable {\n261|\t\t\t\tfindings = append(findings, Finding{\n262|\t\t\t\t\tID:     id,\n263|\t\t\t\t\tLine:   part.line,\n264|\t\t\t\t\tText:   part.text,\n265|\t\t\t\t\tReason: \"positive availability claim for an unavailable capability\",\n266|\t\t\t\t})\n267|\t\t\t}\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif !containsAnyFold(append(append([]string(nil), negations...), nonClaimMarkers...), part.text) {\n271|\t\t\tfor _, id := range unavailable {\n272|\t\t\t\tfindings = append(findings, Finding{\n273|\t\t\t\t\tID:     id,\n274|\t\t\t\t\tLine:   part.line,\n275|\t\t\t\t\tText:   part.text,\n276|\t\t\t\t\tReason: \"unclassified mention of an unavailable capability\",\n277|\t\t\t\t})\n278|\t\t\t}\n279|\t\t}\n280|\t}\n281|\treturn findings, nil\n282|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40b","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":96,"recorded_at":1780531400000187,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782c99a873f198c0bb05c40642f6","text":"Read text file `internal/cigate/claims_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|func unavailableStates(ids ...string) []ProbeState {\n11|\tstates := make([]ProbeState, 0, len(ids))\n12|\tfor _, id := range ids {\n13|\t\tstates = append(states, ProbeState{ID: id, Available: false})\n14|\t}\n15|\treturn states\n16|}\n17|\n18|func availableStates(ids ...string) []ProbeState {\n19|\tstates := make([]ProbeState, 0, len(ids))\n20|\tfor _, id := range ids {\n21|\t\tstates = append(states, ProbeState{ID: id, Available: true})\n22|\t}\n23|\treturn states\n24|}\n25|\n26|func TestCapabilityIDsAreDerivedSorted(t *testing.T) {\n27|\tt.Parallel()\n28|\tids, err := CapabilityIDs()\n29|\tif err != nil {\n30|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n31|\t}\n32|\tif len(ids) == 0 {\n33|\t\tt.Fatal(\"CapabilityIDs() is empty; the check would pass on an empty vocabulary\")\n34|\t}\n35|\tfor index, id := range ids {\n36|\t\tif id == \"\" {\n37|\t\t\tt.Fatalf(\"CapabilityIDs()[%d] is empty\", index)\n38|\t\t}\n39|\t\tif index > 0 && ids[index-1] >= id {\n40|\t\t\tt.Fatalf(\"CapabilityIDs() = %v, want sorted\", ids)\n41|\t\t}\n42|\t}\n43|}\n44|\n45|// TestPositiveClaimsAreRefused drives one claim per positive verb: dropping a\n46|// verb from the gate must admit exactly its row (NARROWING battery).\n47|func TestPositiveClaimsAreRefused(t *testing.T) {\n48|\tt.Parallel()\n49|\tclaims := map[string]string{\n50|\t\t\"available\": \"The `fifo` capability is available on Windows.\",\n51|\t\t\"supported\": \"This release keeps `fifo` supported on every platform.\",\n52|\t\t\"enabled\":   \"The runner has `fifo` enabled by default.\",\n53|\t\t\"works\":     \"The `fifo` lane works on Windows.\",\n54|\t\t\"passes\":    \"The `fifo` fixture passes on Windows.\",\n55|\t\t\"capital\":   \"The `fifo` capability is Available on Windows.\",\n56|\t}\n57|\tif len(claims)-1 != len(positiveAvailability) {\n58|\t\tt.Fatalf(\"claim battery covers %d verbs, gate lists %d\", len(claims)-1, len(positiveAvailability))\n59|\t}\n60|\tfor verb, claim := range claims {\n61|\t\tt.Run(verb, func(t *testing.T) {\n62|\t\t\tt.Parallel()\n63|\t\t\tfindings, err := CheckAdvertisements(claim, unavailableStates(\"fifo\"))\n64|\t\t\tif err != nil {\n65|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n66|\t\t\t}\n67|\t\t\tif len(findings) != 1 {\n68|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want exactly one\", findings)\n69|\t\t\t}\n70|\t\t\tif findings[0].ID != \"fifo\" {\n71|\t\t\t\tt.Errorf(\"finding ID = %q, want fifo\", findings[0].ID)\n72|\t\t\t}\n73|\t\t\tif !strings.Contains(findings[0].Reason, \"positive availability claim\") {\n74|\t\t\t\tt.Errorf(\"finding reason = %q, want the positive-claim refusal\", findings[0].Reason)\n75|\t\t\t}\n76|\t\t})\n77|\t}\n78|}\n79|\n80|// TestNegatedClaimsAreAdmitted drives one row per negation: dropping a\n81|// negation must refuse exactly its honestly conditional sentence.\n82|func TestNegatedClaimsAreAdmitted(t *testing.T) {\n83|\tt.Parallel()\n84|\tsentences := map[string]string{\n85|\t\t\"not\":         \"The `fifo` capability is not available on Windows.\",\n86|\t\t\"never\":       \"The `fifo` lane never passes on Windows.\",\n87|\t\t\"no\":          \"No host reports the `fifo` capability as available.\",\n88|\t\t\"without\":     \"The suite runs without the `fifo` capability available.\",\n89|\t\t\"cannot\":      \"The `fifo` probe cannot report available on Windows.\",\n90|\t\t\"can't\":       \"The `fifo` capability can't be enabled on Windows.\",\n91|\t\t\"n't\":         \"Hosts without systemd don't advertise `fifo` as supported.\",\n92|\t\t\"unavailable\": \"The `fifo` capability is unavailable on Windows.\",\n93|\t\t\"disabled\":    \"The `fifo` capability stays disabled on Windows.\",\n94|\t\t\"conditional\": \"The `fifo` capability is available conditional on the Linux lane.\",\n95|\t\t\"pending\":     \"`fifo` support is pending and not available on Windows.\",\n96|\t\t\"unless\":      \"The `fifo` lane is not available on Windows unless the platform provides it.\",\n97|\t\t\"only\":        \"The `fifo` capability is available only on Linux.\",\n98|\t}\n99|\tif len(sentences) != len(negations) {\n100|\t\tt.Fatalf(\"negation battery covers %d words, gate lists %d\", len(sentences), len(negations))\n101|\t}\n102|\tfor word, document := range sentences {\n103|\t\tt.Run(word, func(t *testing.T) {\n104|\t\t\tt.Parallel()\n105|\t\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n106|\t\t\tif err != nil {\n107|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n108|\t\t\t}\n109|\t\t\tif len(findings) != 0 {\n110|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want none\", findings)\n111|\t\t\t}\n112|\t\t})\n113|\t}\n114|}\n115|\n116|// TestUnclassifiedMentionIsRefused is the fail-closed arm: a sentence that\n117|// names an unavailable capability without any classified context is refused\n118|// rather than ignored. It is also the net for the token-preserving mutant\n119|// that phrases a claim without any listed verb.\n120|func TestUnclassifiedMentionIsRefused(t *testing.T) {\n121|\tt.Parallel()\n122|\tfor _, document := range []string{\n123|\t\t\"Ship the `fifo` driver tomorrow.\",\n124|\t\t\"The `fifo` lane is up on every host.\",\n125|\t} {\n126|\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n127|\t\tif err != nil {\n128|\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n129|\t\t}\n130|\t\tif len(findings) != 1 {\n131|\t\t\tt.Fatalf(\"CheckAdvertisements(%q) findings = %v, want exactly one\", document, findings)\n132|\t\t}\n133|\t\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n134|\t\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n135|\t\t}\n136|\t}\n137|}\n138|\n139|func TestAvailableCapabilityAdmitsPositiveClaim(t *testing.T) {\n140|\tt.Parallel()\n141|\tfindings, err := CheckAdvertisements(\n142|\t\t\"The `fifo` capability is available on Linux.\",\n143|\t\tavailableStates(\"fifo\"))\n144|\tif err != nil {\n145|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n146|\t}\n147|\tif len(findings) != 0 {\n148|\t\tt.Fatalf(\"available capability drew findings = %v\", findings)\n149|\t}\n150|}\n151|\n152|func TestMixedAvailabilityFindsOnlyUnavailable(t *testing.T) {\n153|\tt.Parallel()\n154|\tfindings, err := CheckAdvertisements(\n155|\t\t\"The `symlink` and `fifo` lanes are available on Windows, and `mode-bits` stays up too.\",\n156|\t\t[]ProbeState{\n157|\t\t\t{ID: \"symlink\", Available: true},\n158|\t\t\t{ID: \"fifo\", Available: false},\n159|\t\t\t{ID: \"mode-bits\", Available: false},\n160|\t\t})\n161|\tif err != nil {\n162|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n163|\t}\n164|\t// Asserted as a set: finding order is presentation, not verdict.\n165|\trefused := map[string]bool{}\n166|\tfor _, finding := range findings {\n167|\t\trefused[finding.ID] = true\n168|\t}\n169|\twant := map[string]bool{\"fifo\": true, \"mode-bits\": true}\n170|\tif len(refused) != len(want) {\n171|\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n172|\t}\n173|\tfor id := range want {\n174|\t\tif !refused[id] {\n175|\t\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n176|\t\t}\n177|\t}\n178|}\n179|\n180|func TestEmptyInputsAreRefused(t *testing.T) {\n181|\tt.Parallel()\n182|\tif _, err := CheckAdvertisements(\"The `fifo` lane is up.\", nil); err == nil {\n183|\t\tt.Error(\"empty probe set admitted; the gate would pass on an empty vocabulary\")\n184|\t}\n185|\tif _, err := CheckAdvertisements(\"   \\n  \", unavailableStates(\"fifo\")); err == nil {\n186|\t\tt.Error(\"empty document admitted; the gate would pass on nothing scanned\")\n187|\t}\n188|}\n189|\n190|// TestSubstringIsNotAMarker pins boundary anchoring: \"protest\" carries the\n191|// letters t-e-s-t without the word test, and must not classify the sentence.\n192|// A gate matching substrings would admit this claim-shaped mention.\n193|func TestSubstringIsNotAMarker(t *testing.T) {\n194|\tt.Parallel()\n195|\tfindings, err := CheckAdvertisements(\"Citizens protest the `fifo` cut.\", unavailableStates(\"fifo\"))\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n198|\t}\n199|\tif len(findings) != 1 {\n200|\t\tt.Fatalf(\"findings = %v, want exactly the unclassified refusal\", findings)\n201|\t}\n202|\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n203|\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n204|\t}\n205|}\n206|\n207|func TestFindingCarriesLine(t *testing.T) {\n208|\tt.Parallel()\n209|\tdocument := \"First line.\\n\\nThe `fifo` capability is available on Windows.\\n\"\n210|\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n211|\tif err != nil {\n212|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n213|\t}\n214|\tif len(findings) != 1 {\n215|\t\tt.Fatalf(\"findings = %v, want exactly one\", findings)\n216|\t}\n217|\tif findings[0].Line != 3 {\n218|\t\tt.Errorf(\"finding line = %d, want 3\", findings[0].Line)\n219|\t}\n220|}\n221|\n222|func readREADME(t *testing.T) string {\n223|\tt.Helper()\n224|\tcontents, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"README.md\"))\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"read README.md: %v\", err)\n227|\t}\n228|\treturn string(contents)\n229|}\n230|\n231|func allUnavailable(t *testing.T) []ProbeState {\n232|\tt.Helper()\n233|\tids, err := CapabilityIDs()\n234|\tif err != nil {\n235|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n236|\t}\n237|\treturn unavailableStates(ids...)\n238|}\n239|\n240|// TestRealREADMECarriesNoPositiveClaim runs the gate over the real\n241|// advertisement surface with every probe forced unavailable — the strongest\n242|// posture: every backticked capability mention must already be classified\n243|// non-claim, or a future edit away from refusal.\n244|func TestRealREADMECarriesNoPositiveClaim(t *testing.T) {\n245|\tt.Parallel()\n246|\tfindings, err := CheckAdvertisements(readREADME(t), allUnavailable(t))\n247|\tif err != nil {\n248|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n249|\t}\n250|\tif len(findings) != 0 {\n251|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n252|\t}\n253|}\n254|\n255|func TestRealREADMEAdmitsWhenAllAvailable(t *testing.T) {\n256|\tt.Parallel()\n257|\tids, err := CapabilityIDs()\n258|\tif err != nil {\n259|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n260|\t}\n261|\tfindings, err := CheckAdvertisements(readREADME(t), availableStates(ids...))\n262|\tif err != nil {\n263|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n264|\t}\n265|\tif len(findings) != 0 {\n266|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n267|\t}\n268|}\n269|\n270|// TestEveryNonClaimMarkerOccursInCorpus keeps the marker list honest: a\n271|// marker that fires on no real sentence is either dead weight or an admission\n272|// hole reserved for future text.\n273|func TestEveryNonClaimMarkerOccursInCorpus(t *testing.T) {\n274|\tt.Parallel()\n275|\tdocument := readREADME(t)\n276|\tids, err := CapabilityIDs()\n277|\tif err != nil {\n278|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n279|\t}\n280|\tprobed := map[string]bool{}\n281|\tfor _, id := range ids {\n282|\t\tprobed[\"`\"+id+\"`\"] = true\n283|\t}\n284|\tvar mentioning []string\n285|\tfor _, part := range splitSentences(document) {\n286|\t\tfor token := range probed {\n287|\t\t\tif strings.Contains(part.text, token) {\n288|\t\t\t\tmentioning = append(mentioning, part.text)\n289|\t\t\t\tbreak\n290|\t\t\t}\n291|\t\t}\n292|\t}\n293|\tif len(mentioning) == 0 {\n294|\t\tt.Fatal(\"no corpus sentence mentions a probe ID; the marker census is vacuous\")\n295|\t}\n296|\tfor _, marker := range nonClaimMarkers {\n297|\t\tfound := false\n298|\t\tfor _, text := range mentioning {\n299|\t\t\tif wordMatches(marker, strings.ToLower(text)) {\n300|\t\t\t\tfound = true\n301|\t\t\t\tbreak\n302|\t\t\t}\n303|\t\t}\n304|\t\tif !found {\n305|\t\t\tt.Errorf(\"marker %q occurs in no probe-mentioning sentence; remove it or classify with it\", marker)\n306|\t\t}\n307|\t}\n308|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
