ring, error) {\n38|\tif pinCurrent != catalogCurrent {\n39|\t\treturn nil, fmt.Errorf(\"cigate: current release root drift: specpin %q catalog %q\",\n40|\t\t\tpinCurrent, catalogCurrent)\n41|\t}\n42|\tif pinHistorical != catalogHistorical {\n43|\t\treturn nil, fmt.Errorf(\"cigate: historical release root drift: specpin %q catalog %q\",\n44|\t\t\tpinHistorical, catalogHistorical)\n45|\t}\n46|\tif pinCurrent == \"\" || pinHistorical == \"\" || pinCurrent == pinHistorical {\n47|\t\treturn nil, fmt.Errorf(\"cigate: release roots are empty or indistinct\")\n48|\t}\n49|\treturn []string{pinCurrent, pinHistorical}, nil\n50|}\n51|\n52|// PinContractSets derives every pinned (contract, version) set from the\n53|// embedded specification lock, keyed by release. The historical projection\n54|// comes from ContractsForRelease, so absent contracts and version overrides\n55|// are the lock's own, not a retyped copy.\n56|func PinContractSets() (map[string][]ContractVersions, error) {\n57|\tmanifest, err := specpin.Current()\n58|\tif err != nil {\n59|\t\treturn nil, fmt.Errorf(\"cigate: load pinned source: %w\", err)\n60|\t}\n61|\treturn pinContractSets(manifest)\n62|}\n63|\n64|// pinContractSets is the testable core over an explicit manifest: production\n65|// passes the embedded one, tests pass synthetic ones.\n66|func pinContractSets(manifest specpin.Manifest) (map[string][]ContractVersions, error) {\n67|\treleases, err := PinnedReleases()\n68|\tif err != nil {\n69|\t\treturn nil, err\n70|\t}\n71|\tsets := make(map[string][]ContractVersions, len(releases))\n72|\tfor _, release := range releases {\n73|\t\tcontracts, err := manifest.ContractsForRelease(release)\n74|\t\tif err != nil {\n75|\t\t\treturn nil, fmt.Errorf(\"cigate: derive pinned %s contracts: %w\", release, err)\n76|\t\t}\n77|\t\tsets[release] = fromPinContracts(contracts)\n78|\t}\n79|\treturn sets, nil\n80|}\n81|\n82|// CatalogContractSets derives every (contract, version) set from the\n83|// generated catalog projections, keyed by release.\n84|func CatalogContractSets() (map[string][]ContractVersions, error) {\n85|\treleases, err := PinnedReleases()\n86|\tif err != nil {\n87|\t\treturn nil, err\n88|\t}\n89|\tsets := make(map[string][]ContractVersions, len(releases))\n90|\tfor _, release := range releases {\n91|\t\tprojected, err := catalog.ForRelease(catalog.Release(release))\n92|\t\tif err != nil {\n93|\t\t\treturn nil, fmt.Errorf(\"cigate: derive catalog %s contracts: %w\", release, err)\n94|\t\t}\n95|\t\tconverted := make([]ContractVersions, 0, len(projected.Contracts))\n96|\t\tfor _, contract := range projected.Contracts {\n97|\t\t\tconverted = append(converted, ContractVersions{\n98|\t\t\t\tName:     contract.Name,\n99|\t\t\t\tID:       string(contract.ID),\n100|\t\t\t\tVersions: append([]string(nil), contract.Versions...),\n101|\t\t\t})\n102|\t\t}\n103|\t\tsets[release] = converted\n104|\t}\n105|\treturn sets, nil\n106|}\n107|\n108|// VerifyContractPreservation requires the pinned lock and the generated\n109|// catalog to agree exactly on every release: same contracts, same\n110|// identifiers, same ordered versions. A version either side cannot account\n111|// for is refused with its name, not averaged away. It reports the first\n112|// disagreement; CI reruns are cheap and deterministic.\n113|func VerifyContractPreservation() error {\n114|\tpinned, err := PinContractSets()\n115|\tif err != nil {\n116|\t\treturn err\n117|\t}\n118|\tprojected, err := CatalogContractSets()\n119|\tif err != nil {\n120|\t\treturn err\n121|\t}\n122|\treturn checkAgreement(pinned, projected)\n123|}\n124|\n125|// checkAgreement is the testable core over explicit sets: production passes\n126|// the derived ones, tests pass synthetic ones.\n127|func checkAgreement(pinned, projected map[string][]ContractVersions) error {\n128|\treleases, err := PinnedReleases()\n129|\tif err != nil {\n130|\t\treturn err\n131|\t}\n132|\tfor _, release := range releases {\n133|\t\twant, ok := pinned[release]\n134|\t\tif !ok {\n135|\t\t\treturn fmt.Errorf(\"cigate: pinned authority accounts for no %s set\", release)\n136|\t\t}\n137|\t\tgot, ok := projected[release]\n138|\t\tif !ok {\n139|\t\t\treturn fmt.Errorf(\"cigate: catalog authority accounts for no %s set\", release)\n140|\t\t}\n141|\t\tif err := checkReleaseSet(release, want, got); err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t}\n145|\treturn nil\n146|}\n147|\n148|func checkReleaseSet(release string, pinned, projected []ContractVersions) error {\n149|\twant := indexContracts(pinned)\n150|\tgot := indexContracts(projected)\n151|\tfor key, wantContract := range want {\n152|\t\tgotContract, ok := got[key]\n153|\t\tif !ok {\n154|\t\t\treturn fmt.Errorf(\"cigate: %s contract %q (%s) is pinned but absent from the catalog\",\n155|\t\t\t\trelease, wantContract.Name, wantContract.ID)\n156|\t\t}\n157|\t\tif len(wantContract.Versions) != len(gotContract.Versions) {\n158|\t\t\treturn fmt.Errorf(\"cigate: %s contract %q (%s) pins %d versions, catalog carries %d\",\n159|\t\t\t\trelease, wantContract.Name, wantContract.ID,\n160|\t\t\t\tlen(wantContract.Versions), len(gotContract.Versions))\n161|\t\t}\n162|\t\tfor index, version := range wantContract.Versions {\n163|\t\t\tif gotContract.Versions[index] != version {\n164|\t\t\t\treturn fmt.Errorf(\"cigate: %s contract %q (%s) version %d is pinned %q, catalog carries %q\",\n165|\t\t\t\t\trelease, wantContract.Name, wantContract.ID,\n166|\t\t\t\t\tindex, version, gotContract.Versions[index])\n167|\t\t\t}\n168|\t\t}\n169|\t}\n170|\tfor key, gotContract := range got {\n171|\t\tif _, ok := want[key]; !ok {\n172|\t\t\treturn fmt.Errorf(\"cigate: %s contract %q (%s) is in the catalog but no pin accounts for it\",\n173|\t\t\t\trelease, gotContract.Name, gotContract.ID)\n174|\t\t}\n175|\t}\n176|\treturn nil\n177|}\n178|\n179|func indexContracts(contracts []ContractVersions) map[string]ContractVersions {\n180|\tindexed := make(map[string]ContractVersions, len(contracts))\n181|\tfor _, contract := range contracts {\n182|\t\tindexed[contract.Name+\"\\x00\"+contract.ID] = contract\n183|\t}\n184|\treturn indexed\n185|}\n186|\n187|func fromPinContracts(contracts []specpin.ContractPin) []ContractVersions {\n188|\tconverted := make([]ContractVersions, 0, len(contracts))\n189|\tfor _, contract := range contracts {\n190|\t\tconverted = append(converted, ContractVersions{\n191|\t\t\tName:     contract.Name,\n192|\t\t\tID:       contract.ID,\n193|\t\t\tVersions: append([]string(nil), contract.Versions...),\n194|\t\t})\n195|\t}\n196|\treturn converted\n197|}\n198|\n199|// SortedReleases reports the release keys of a derived set in sorted order,\n200|// so command output is deterministic.\n201|func SortedReleases(sets map[string][]ContractVersions) []string {\n202|\treleases := make([]string, 0, len(sets))\n203|\tfor release := range sets {\n204|\t\treleases = append(releases, release)\n205|\t}\n206|\tsort.Strings(releases)\n207|\treturn releases\n208|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
