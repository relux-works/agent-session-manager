{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb17","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":998,"recorded_at":1780531400001991,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"bf8c7540-7fa6-4932-bd0e-9608e0a2c3b7"},"task_id":"bf8c7540-7fa6-4932-bd0e-9608e0a2c3b7","event":{"kind":"output","task_id":"bf8c7540-7fa6-4932-bd0e-9608e0a2c3b7","chunk":"Read text file `internal/cigate/contracts_test.go`.\n(112 line(s) above)\n113|func TestCheckAgreementAdmitsIdenticalSets(t *testing.T) {\n114|\tt.Parallel()\n115|\t_, _, pinned, projected := syntheticSets(t)\n116|\tif err := checkAgreement(pinned, projected); err != nil {\n117|\t\tt.Fatalf(\"checkAgreement() error = %v\", err)\n118|\t}\n119|}\n120|\n121|func TestCheckAgreementRefusals(t *testing.T) {\n122|\tt.Parallel()\n123|\tcases := []struct {\n124|\t\tname   string\n125|\t\tmutate func(current, historical string, pinned, projected map[string][]ContractVersions)\n126|\t\twant   func(current, historical string) string\n127|\t}{\n128|\t\t{\n129|\t\t\tname: \"contract missing from catalog\",\n130|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n131|\t\t\t\tprojected[current] = projected[current][:1]\n132|\t\t\t},\n133|\t\t\twant: func(_, _ string) string { return \"absent from the catalog\" },\n134|\t\t},\n135|\t\t{\n136|\t\t\tname: \"contract unaccounted by pin\",\n137|\t\t\tmutate: func(current, _ string, pinned, _ map[string][]ContractVersions) {\n138|\t\t\t\tpinned[current] = pinned[current][:1]\n139|\t\t\t},\n140|\t\t\twant: func(_, _ string) string { return \"no pin accounts for it\" },\n141|\t\t},\n142|\t\t{\n143|\t\t\t// NARROWING row: the catalog admits exactly one version fewer.\n144|\t\t\t// A gate that compared only contract presence would admit this.\n145|\t\t\tname: \"single version dropped\",\n146|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n147|\t\t\t\tprojected[current][0].Versions = []string{\"1.0.0\"}\n148|\t\t\t},\n149|\t\t\twant: func(_, _ string) string { return \"pins 2 versions, catalog carries 1\" },\n150|\t\t},\n151|\t\t{\n152|\t\t\tname: \"single version added\",\n153|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n154|\t\t\t\tprojected[current][1].Versions = []string{\"2.0.0\", \"3.0.0\"}\n155|\t\t\t},\n156|\t\t\twant: func(_, _ string) string { return \"pins 1 versions, catalog carries 2\" },\n157|\t\t},\n158|\t\t{\n159|\t\t\t// NARROWING row: same versions, different order. A gate that\n160|\t\t\t// compared version sets without order would admit this, and\n161|\t\t\t// version order selects the negotiated baseline.\n162|\t\t\tname: \"version order changed\",\n163|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n164|\t\t\t\tprojected[current][0].Versions = []string{\"2.0.0\", \"1.0.0\"}\n165|\t\t\t},\n166|\t\t\twant: func(_, _ string) string { return `version 0 is pinned \"1.0.0\", catalog carries \"2.0.0\"` },\n167|\t\t},\n168|\t\t{\n169|\t\t\tname: \"release missing from catalog\",\n170|\t\t\tmutate: func(_, historical string, _, projected map[string][]ContractVersions) {\n171|\t\t\t\tdelete(projected, historical)\n172|\t\t\t},\n173|\t\t\twant: func(_, historical string) string { return \"accounts for no \" + historical + \" set\" },\n174|\t\t},\n175|\t\t{\n176|\t\t\tname: \"release missing from pin\",\n177|\t\t\tmutate: func(_, historical string, pinned, _ map[string][]ContractVersions) {\n178|\t\t\t\tdelete(pinned, historical)\n179|\t\t\t},\n180|\t\t\twant: func(_, historical string) string { return \"accounts for no \" + historical + \" set\" },\n181|\t\t},\n182|\t}\n183|\tfor _, kase := range cases {\n184|\t\tt.Run(kase.name, func(t *testing.T) {\n185|\t\t\tt.Parallel()\n186|\t\t\tcurrent, historical, pinned, projected := syntheticSets(t)\n187|\t\t\tkase.mutate(current, historical, pinned, projected)\n188|\t\t\terr := checkAgreement(pinned, projected)\n189|\t\t\tif err == nil {\n190|\t\t\t\tt.Fatalf(\"checkAgreement() admitted %s\", kase.name)\n191|\t\t\t}\n192|\t\t\twant := kase.want(current, historical)\n193|\t\t\tif !strings.Contains(err.Error(), want) {\n194|\t\t\t\tt.Fatalf(\"checkAgreement() error = %q, want substring %q\", err, want)\n195|\t\t\t}\n196|\t\t})\n197|\t}\n(more lines below)"}}}
