.7/Frameworks/Python.framework/Versions/3.14/lib/python3.14/json/decoder.py\\\", line 363, in raw_decode\\n    raise JSONDecodeError(\\\"Expecting value\\\", s, err.value) from None\\njson.decoder.JSONDecodeError: Expecting value: line 1 column 1 (char 0)\\n\",\n  \"original_output_bytes\": 1300,\n  \"original_output_tokens\": 325,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
