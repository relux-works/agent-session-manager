{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c7","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":446,"recorded_at":1780531400000887,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"b0bbad19-8cd8-411d-b3d8-fa36243229ce"},"task_id":"b0bbad19-8cd8-411d-b3d8-fa36243229ce","event":{"kind":"output","task_id":"b0bbad19-8cd8-411d-b3d8-fa36243229ce","chunk":"Read text file `internal/secconftest/skip.go`.\n(264 line(s) above)\n265|\t\tverdict := Verdict{ID: capability.ID, Skipped: true, Reason: reason}\n266|\t\trecordVerdict(verdict)\n267|\t\tt.Skipf(\"secconftest: capability %q unavailable here: %s\", capability.ID, reason)\n268|\t\treturn verdict\n269|\t}\n270|}\n271|\n272|// Report formats the capability skip/fail counts recorded so far on\n273|// this host. It reads the live counters: an empty suite records\n274|// nothing and reports zeros, and every recorded skip or failure moves\n275|// the numbers. Citing a Report line as host evidence is only honest\n276|// for verdicts the suite really recorded; the per-test skip datum is\n277|// the `--- SKIP` lines under `go test -v`, which reproduce without\n278|// any counter.\n279|func Report() string {\n280|\treport.mutex.Lock()\n281|\tskipped := append([]string(nil), report.skipped...)\n282|\tfailed := append([]string(nil), report.failed...)\n283|\treport.mutex.Unlock()\n284|\tsort.Strings(skipped)\n285|\tsort.Strings(failed)\n286|\treturn fmt.Sprintf(\"secconftest capabilities on %s: skipped=%d %q failed=%d %q\",\n287|\t\truntime.GOOS, len(skipped), strings.Join(skipped, \",\"), len(failed), strings.Join(failed, \",\"))\n288|}\n289|\n290|// snapshotReport copies the process-wide counters so a test can\n291|// record synthetic verdicts and restore the suite state afterwards.\n292|func snapshotReport() (skipped, failed []string) {\n293|\treport.mutex.Lock()\n294|\tdefer report.mutex.Unlock()\n295|\treturn append([]string(nil), report.skipped...), append([]string(nil), report.failed...)\n296|}\n297|\n298|// restoreReport replaces the process-wide counters, undoing synthetic\n299|// verdicts a test recorded. It exists only for test isolation.\n300|func restoreReport(skipped, failed []string) {\n301|\treport.mutex.Lock()\n302|\tdefer report.mutex.Unlock()\n303|\treport.skipped = append([]string(nil), skipped...)\n304|\treport.failed = append([]string(nil), failed...)\n305|}\n306|\n307|// LogReport logs the capability skip/fail counts on this host. Call\n308|// it after the suite recorded its verdicts so the line carries real\n309|// counters. It never skips or fails: it reports.\n310|func LogReport(t *testing.T) {\n311|\tt.Helper()\n312|\tt.Log(Report())\n313|}"}}}
