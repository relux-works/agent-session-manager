{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c49d","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":169,"recorded_at":1780531400000333,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782cb5337b939ef3ec8c275fa59d","text":"Read text file `internal/secconftest/fuzz.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"sync/atomic\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n8|)\n9|\n10|// FuzzEntry identifies one production entry point a fuzz driver\n11|// reaches. FuzzTargetEntry maps each fuzz target to its entry so the\n12|// suite can assert the mapping instead of claiming it in prose.\n13|type FuzzEntry string\n14|\n15|const (\n16|\tEntryCheckArgv           FuzzEntry = \"secprim.CheckArgv\"\n17|\tEntryCheckMemberPath     FuzzEntry = \"secprim.CheckMemberPath\"\n18|\tEntryIsEnvName           FuzzEntry = \"secprim.IsEnvName\"\n19|\tEntryRedact              FuzzEntry = \"secprim.Redact\"\n20|\tEntryEscapeForTerminal   FuzzEntry = \"secprim.EscapeForTerminal\"\n21|\tEntryRenderForTerminal   FuzzEntry = \"secprim.RenderForTerminal\"\n22|\tEntryGuardResolve        FuzzEntry = \"secprim.Guard.Resolve\"\n23|\tEntryDetectCaseCollision FuzzEntry = \"secprim.DetectCaseCollision\"\n24|)\n25|\n26|// FuzzTargetEntry maps each committed fuzz target to the production\n27|// entry point it drives. Every target in fuzz_test.go must appear\n28|// here, and TestFuzzTargetsReachProduction pins both directions: no\n29|// target without an entry, no entry in the map without a target that\n30|// fires it.\n31|var FuzzTargetEntry = map[string]FuzzEntry{\n32|\t\"FuzzCheckArgv\":           EntryCheckArgv,\n33|\t\"FuzzCheckMemberPath\":     EntryCheckMemberPath,\n34|\t\"FuzzIsEnvName\":           EntryIsEnvName,\n35|\t\"FuzzRedactCorpus\":        EntryRedact,\n36|\t\"FuzzEscapeForTerminal\":   EntryEscapeForTerminal,\n37|\t\"FuzzRenderForTerminal\":   EntryRenderForTerminal,\n38|\t\"FuzzGuardResolve\":        EntryGuardResolve,\n39|\t\"FuzzDetectCaseCollision\": EntryDetectCaseCollision,\n40|}\n41|\n42|// Driver is the shared path from seed-corpus tests and fuzz targets\n43|// into the Section 16 production gates. Both call these methods, so\n44|// the seed tests prove arrival at the same entry points the fuzzer\n45|// mutates against. Every method records its call before delegating,\n46|// so a driver that stopped reaching production shows a zero count.\n47|type Driver struct {\n48|\tcalls map[FuzzEntry]*atomic.Int64\n49|}\n50|\n51|// NewDriver builds a Driver with zeroed arrival counters.\n52|func NewDriver() *Driver {\n53|\tdriver := &Driver{calls: map[FuzzEntry]*atomic.Int64{}}\n54|\tfor _, entry := range []FuzzEntry{\n55|\t\tEntryCheckArgv, EntryCheckMemberPath, EntryIsEnvName,\n56|\t\tEntryRedact, EntryEscapeForTerminal, EntryRenderForTerminal,\n57|\t\tEntryGuardResolve, EntryDetectCaseCollision,\n58|\t} {\n59|\t\tdriver.calls[entry] = &atomic.Int64{}\n60|\t}\n61|\treturn driver\n62|}\n63|\n64|func (driver *Driver) record(entry FuzzEntry) {\n65|\tdriver.calls[entry].Add(1)\n66|}\n67|\n68|// Count reports arrivals at entry.\n69|func (driver *Driver) Count(entry FuzzEntry) int64 {\n70|\tcounter, ok := driver.calls[entry]\n71|\tif !ok {\n72|\t\treturn 0\n73|\t}\n74|\treturn counter.Load()\n75|}\n76|\n77|// DriveArgv drives secprim.CheckArgv and reports admission.\n78|func (driver *Driver) DriveArgv(argv []string) bool {\n79|\tdriver.record(EntryCheckArgv)\n80|\treturn secprim.CheckArgv(argv) == nil\n81|}\n82|\n83|// DriveMemberPath drives secprim.CheckMemberPath on the linux member\n84|// grammar and reports admission.\n85|func (driver *Driver) DriveMemberPath(member string) bool {\n86|\tdriver.record(EntryCheckMemberPath)\n87|\treturn secprim.CheckMemberPath(scalar.PlatformLinux, member) == nil\n88|}\n89|\n90|// DriveEnvName drives secprim.IsEnvName.\n91|func (driver *Driver) DriveEnvName(name string) bool {\n92|\tdriver.record(EntryIsEnvName)\n93|\treturn secprim.IsEnvName(name)\n94|}\n95|\n96|// DriveRedact drives secprim.Redact with no caller corpus and reports\n97|// whether the output still carries the input's non-secret marker. The\n98|// fixed marker keeps the driver deterministic: corpus secrets come\n99|// from the caller in TestFuzzDriversReachProduction, not from the\n100|// fuzzer.\n101|func (driver *Driver) DriveRedact(line string) bool {\n102|\tdriver.record(EntryRedact)\n103|\tout := secprim.Redact(line, nil)\n104|\treturn len(out) > 0 || len(line) == 0\n105|}\n106|\n107|// DriveEscape drives secprim.EscapeForTerminal.\n108|func (driver *Driver) DriveEscape(text string) string {\n109|\tdriver.record(EntryEscapeForTerminal)\n110|\treturn secprim.EscapeForTerminal(text)\n111|}\n112|\n113|// DriveRender drives secprim.RenderForTerminal with no caller corpus.\n114|func (driver *Driver) DriveRender(line string) string {\n115|\tdriver.record(EntryRenderForTerminal)\n116|\treturn secprim.RenderForTerminal(line, nil)\n117|}\n118|\n119|// DriveGuardResolve drives secprim.Guard.Resolve against a fixed\n120|// in-memory root and reports admission. The guard construction cannot\n121|// fail for the fixed root; a construction failure refuses the input\n122|// the same way a resolution refusal does.\n123|func (driver *Driver) DriveGuardResolve(member string) bool {\n124|\tdriver.record(EntryGuardResolve)\n125|\tguard, err := secprim.NewGuard(\"/stage\", scalar.PlatformLinux, nil)\n126|\tif err != nil {\n127|\t\treturn false\n128|\t}\n129|\t_, err = guard.Resolve(member)\n130|\treturn err == nil\n131|}\n132|\n133|// DriveCaseCollision drives secprim.DetectCaseCollision against a\n134|// fixed sibling set and reports whether a collision fired.\n135|func (driver *Driver) DriveCaseCollision(candidate string) bool {\n136|\tdriver.record(EntryDetectCaseCollision)\n137|\t_, collided := secprim.DetectCaseCollision([]string{\"README.md\", \"staging/member\"}, candidate)\n138|\treturn collided\n139|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c49f","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":170,"recorded_at":1780531400000335,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"call_id":"call_01a0782cb5af725287407c84c32d74a0","text":"{\n  \"chunk_id\": \"exec-4-1\",\n  \"command\": \"grep -n \\\"cigate\\\\|capabilit\\\\|live probe\\\\|scanned against\\\\|fuzz\\\\|FuzzTargets\\\\|secconftest\\\" README.md | head -40\",\n  \"description\": \"Find README CI claims\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"11:contract, operation, capability-vocabulary, event, and error catalogs from\\n87:command, `doctor` result, conformance-target declaration, or runtime capability\\n126:mutates no durable state, and advertises no runtime capability.\\n157:availability claim, or runtime capability advertisement.\\n172:  -fuzz=^FuzzScalarProductionEntries$ -fuzztime=100x -parallel=1\\n234:The v3 terminal capability vocabulary is derived from the pinned catalog's\\n236:property of the pinned Configuration catalog, so neither a new capability nor a\\n245:`required_capabilities` remains marked as contextual default provenance; this\\n279:runtime capability/backend availability. Existing selected roots are checked\\n378:Section 6.5 additionally names the `required_capabilities` default defect. See\\n404:availability, status, or capability claim, and the package is an internal M0\\n464:the Section 7.4 probe with its seven capability values (only\\n465:`available` may be `enabled`), the host-side capability gate\\n612:[`internal/secconftest`](internal/secconftest) is the test instrument\\n614:runners, fake clocks, crash points, protocol fuzz drivers, hostile\\n615:strings, and platform capability skips. It decides nothing itself —\\n659:witness gated on a probed capability. Capability probes (`symlink`,\\n661:capability — symlink create+Lstat, `mkfifo`+Lstat, `chmod 000`\\n675:Run the focused tests, race, coverage, and fuzz smoke with:\\n678:go test ./internal/secconftest -count=1\\n679:go test ./internal/secconftest -race -count=1\\n680:go test ./internal/secconftest -cover -count=1\\n681:go test ./internal/secconftest -run='^$' -fuzz='^FuzzCheckArgv$' -fuzztime=100x -parallel=1\\n688:vector gates, not containment races; the env-name/redact fuzz pins\\n697:capability is advertised: the instrument cannot enable a platform\\n711:| Contract preservation | `tracecheck`, catalog freshness, focused `internal/cigate` contract gates | The pinned lock and the generated catalog agree on every historical and current contract version, and each gate selection matched its named test |\\n718:| Unsupported-capability claim check | README scanned against live probe verdicts | No unsupported capability is advertised: mentions resolve to probe, skip, gate, or test context, never to a positive availability claim about an unavailable capability |\\n722:[`internal/cigate`](internal/cigate) holds the CI-facing gate library:\\n725:fuzz-target derivation from the instrument's own target map, and the\\n726:advertisement check wired to the `internal/secconftest` probe set rather\\n910:replication, materialization, tombstone, capability, bridge, sync, or takeover\\n934:capability is claimed by this package.\\n1126:fuzz corpora, and `tracecheck` — still green, because 91 runtime refusal\\n1343:Native fuzz targets recursively attack malformed member syntax, duplicate\\n1355:worker per fuzz target so the gate is bounded by an input count rather than\\n1364:creation, clone, adoption, or any runtime capability. Schema acceptance alone\\n1374:  -fuzz=^FuzzCanonicalizeRoundTrip$ -fuzztime=100x -parallel=1\\n1376:  -fuzz=^FuzzObjectIdentityRepresentationInvariant$ -fuzztime=100x -parallel=1\\n1378:  -fuzz=^FuzzClosedIdentityShapeRefusal$ -fuzztime=100x -parallel=1\\n1380:  -fuzz=^FuzzObservationEventRefusal$ -fuzztime=100x -parallel=1\\n\",\n  \"original_output_bytes\": 3265,\n  \"original_output_tokens\": 817,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
