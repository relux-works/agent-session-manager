{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6cb","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":448,"recorded_at":1780531400000891,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"e306d36a-57d3-44de-86d9-64f11ce0c535"},"task_id":"e306d36a-57d3-44de-86d9-64f11ce0c535","event":{"kind":"output","task_id":"e306d36a-57d3-44de-86d9-64f11ce0c535","chunk":"Read text file `internal/traceability/traceability_test.go`.\n(439 line(s) above)\n440|\tfirst, err := VerifyRepository(repository)\n441|\tif err != nil {\n442|\t\tt.Fatalf(\"first VerifyRepository() error = %v\", err)\n443|\t}\n444|\tsecond, err := VerifyRepository(repository)\n445|\tif err != nil {\n446|\t\tt.Fatalf(\"second VerifyRepository() error = %v\", err)\n447|\t}\n448|\tif !reflect.DeepEqual(first, second) {\n449|\t\tt.Fatalf(\"identical verification reports differ: first=%#v second=%#v\", first, second)\n450|\t}\n451|\tafter := snapshotDigest(repository)\n452|\tif before != after {\n453|\t\tt.Fatalf(\"read-only verification mutated repository evidence: before=%x after=%x\", before, after)\n454|\t}\n455|}\n456|\n457|func TestCIWorkflowInvokesTraceabilityGate(t *testing.T) {\n458|\tt.Parallel()\n459|\n460|\tworkflow, err := os.ReadFile(filepath.Join(\"..\", \"..\", \".github\", \"workflows\", \"ci.yml\"))\n461|\tif err != nil {\n462|\t\tt.Fatalf(\"read CI workflow: %v\", err)\n463|\t}\n464|\tfor _, command := range []string{\n465|\t\t\"go run ./internal/traceability/cmd/tracecheck\",\n466|\t\t\"go test ./... -v\",\n467|\t\t\"go vet ./...\",\n468|\t\t\"go build ./...\",\n469|\t} {\n470|\t\tif !bytes.Contains(workflow, []byte(command)) {\n471|\t\t\tt.Errorf(\"CI workflow does not invoke %q\", command)\n472|\t\t}\n473|\t}\n474|}\n475|\n476|func repositorySnapshot(t *testing.T) fstest.MapFS {\n477|\tt.Helper()\n478|\n479|\troot := os.DirFS(filepath.Join(\"..\", \"..\"))\n480|\tregistryBytes, err := fs.ReadFile(root, ownershipRegistryPath)\n481|\tif err != nil {\n482|\t\tt.Fatalf(\"read ownership registry: %v\", err)\n483|\t}\n484|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n485|\tif err != nil {\n486|\t\tt.Fatalf(\"decode ownership registry: %v\", err)\n487|\t}\n488|\trequired := map[string]struct{}{\n489|\t\tcontractLockPath:      {},\n490|\t\tcatalogMetadataPath:   {},\n491|\t\tgeneratedCatalogPath:  {},\n492|\t\townershipRegistryPath: {},\n493|\t}\n494|\tfor _, acceptance := range registry.AcceptanceCases {\n495|\t\trequired[acceptance.Production.Path] = struct{}{}\n496|\t\tfor _, test := range acceptance.Tests {\n497|\t\t\trequired[test.Path] = struct{}{}\n498|\t\t}\n499|\t}\n500|\tfor _, group := range registry.Ownership {\n501|\t\trequired[group.Production.Path] = struct{}{}\n502|\t}\n503|\n504|\tresult := make(fstest.MapFS, len(required))\n505|\tfor filename := range required {\n506|\t\tvalue, err := fs.ReadFile(root, filename)\n507|\t\tif err != nil {\n508|\t\t\tt.Fatalf(\"read repository fixture %q: %v\", filename, err)\n509|\t\t}\n(more lines below)"}}}
