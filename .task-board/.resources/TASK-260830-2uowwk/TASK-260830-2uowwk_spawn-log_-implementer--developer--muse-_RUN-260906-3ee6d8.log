{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f3","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":84,"recorded_at":1780531400000163,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"bace53b6-4537-4320-be0d-17f0b4c3f8ed"},"task_id":"bace53b6-4537-4320-be0d-17f0b4c3f8ed","event":{"kind":"output","task_id":"bace53b6-4537-4320-be0d-17f0b4c3f8ed","chunk":"Read text file `internal/cigate/claims_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|func unavailableStates(ids ...string) []ProbeState {\n11|\tstates := make([]ProbeState, 0, len(ids))\n12|\tfor _, id := range ids {\n13|\t\tstates = append(states, ProbeState{ID: id, Available: false})\n14|\t}\n15|\treturn states\n16|}\n17|\n18|func availableStates(ids ...string) []ProbeState {\n19|\tstates := make([]ProbeState, 0, len(ids))\n20|\tfor _, id := range ids {\n21|\t\tstates = append(states, ProbeState{ID: id, Available: true})\n22|\t}\n23|\treturn states\n24|}\n25|\n26|func TestCapabilityIDsAreDerivedSorted(t *testing.T) {\n27|\tt.Parallel()\n28|\tids, err := CapabilityIDs()\n29|\tif err != nil {\n30|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n31|\t}\n32|\tif len(ids) == 0 {\n33|\t\tt.Fatal(\"CapabilityIDs() is empty; the check would pass on an empty vocabulary\")\n34|\t}\n35|\tfor index, id := range ids {\n36|\t\tif id == \"\" {\n37|\t\t\tt.Fatalf(\"CapabilityIDs()[%d] is empty\", index)\n38|\t\t}\n39|\t\tif index > 0 && ids[index-1] >= id {\n40|\t\t\tt.Fatalf(\"CapabilityIDs() = %v, want sorted\", ids)\n41|\t\t}\n42|\t}\n43|}\n44|\n45|// TestPositiveClaimsAreRefused drives one claim per positive verb: dropping a\n46|// verb from the gate must admit exactly its row (NARROWING battery).\n47|func TestPositiveClaimsAreRefused(t *testing.T) {\n48|\tt.Parallel()\n49|\tclaims := map[string]string{\n50|\t\t\"available\": \"The `fifo` capability is available on Windows.\",\n51|\t\t\"supported\": \"This release keeps `fifo` supported on every platform.\",\n52|\t\t\"enabled\":   \"The runner has `fifo` enabled by default.\",\n53|\t\t\"works\":     \"The `fifo` lane works on Windows.\",\n54|\t\t\"passes\":    \"The `fifo` fixture passes on Windows.\",\n55|\t\t\"capital\":   \"The `fifo` capability is Available on Windows.\",\n56|\t}\n57|\tif len(claims)-1 != len(positiveAvailability) {\n58|\t\tt.Fatalf(\"claim battery covers %d verbs, gate lists %d\", len(claims)-1, len(positiveAvailability))\n59|\t}\n60|\tfor verb, claim := range claims {\n61|\t\tt.Run(verb, func(t *testing.T) {\n62|\t\t\tt.Parallel()\n63|\t\t\tfindings, err := CheckAdvertisements(claim, unavailableStates(\"fifo\"))\n64|\t\t\tif err != nil {\n65|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n66|\t\t\t}\n67|\t\t\tif len(findings) != 1 {\n68|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want exactly one\", findings)\n69|\t\t\t}\n70|\t\t\tif findings[0].ID != \"fifo\" {\n71|\t\t\t\tt.Errorf(\"finding ID = %q, want fifo\", findings[0].ID)\n72|\t\t\t}\n73|\t\t\tif !strings.Contains(findings[0].Reason, \"positive availability claim\") {\n74|\t\t\t\tt.Errorf(\"finding reason = %q, want the positive-claim refusal\", findings[0].Reason)\n75|\t\t\t}\n76|\t\t})\n77|\t}\n78|}\n79|\n80|// TestNegatedClaimsAreAdmitted drives one row per negation: dropping a\n81|// negation must refuse exactly its honestly conditional sentence.\n82|func TestNegatedClaimsAreAdmitted(t *testing.T) {\n83|\tt.Parallel()\n84|\tsentences := map[string]string{\n85|\t\t\"not\":         \"The `fifo` capability is not available on Windows.\",\n86|\t\t\"never\":       \"The `fifo` lane never passes on Windows.\",\n87|\t\t\"no\":          \"No host reports the `fifo` capability as available.\",\n88|\t\t\"without\":     \"The suite runs without the `fifo` capability available.\",\n89|\t\t\"cannot\":      \"The `fifo` probe cannot report available on Windows.\",\n90|\t\t\"can't\":       \"The `fifo` capability can't be enabled on Windows.\",\n91|\t\t\"n't\":         \"Hosts without systemd don't advertise `fifo` as supported.\",\n92|\t\t\"unavailable\": \"The `fifo` capability is unavailable on Windows.\",\n93|\t\t\"disabled\":    \"The `fifo` capability stays disabled on Windows.\",\n94|\t\t\"conditional\": \"The `fifo` capability is available conditional on the Linux lane.\",\n95|\t\t\"pending\":     \"`fifo` support is pending and not available on Windows.\",\n96|\t\t\"unless\":      \"The `fifo` lane is not available on Windows unless the platform provides it.\",\n97|\t\t\"only\":        \"The `fifo` capability is available only on Linux.\",\n98|\t}\n99|\tif len(sentences) != len(negations) {\n100|\t\tt.Fatalf(\"negation battery covers %d words, gate lists %d\", len(sentences), len(negations))\n101|\t}\n102|\tfor word, document := range sentences {\n103|\t\tt.Run(word, func(t *testing.T) {\n104|\t\t\tt.Parallel()\n105|\t\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n106|\t\t\tif err != nil {\n107|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n108|\t\t\t}\n109|\t\t\tif len(findings) != 0 {\n110|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want none\", findings)\n111|\t\t\t}\n112|\t\t})\n113|\t}\n114|}\n115|\n116|// TestUnclassifiedMentionIsRefused is the fail-closed arm: a sentence that\n117|// names an unavailable capability without any classified context is refused\n118|// rather than ignored. It is also the net for the token-preserving mutant\n119|// that phrases a claim without any listed verb.\n120|func TestUnclassifiedMentionIsRefused(t *testing.T) {\n121|\tt.Parallel()\n122|\tfor _, document := range []string{\n123|\t\t\"Ship the `fifo` driver tomorrow.\",\n124|\t\t\"The `fifo` lane is up on every host.\",\n125|\t} {\n126|\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n127|\t\tif err != nil {\n128|\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n129|\t\t}\n130|\t\tif len(findings) != 1 {\n131|\t\t\tt.Fatalf(\"CheckAdvertisements(%q) findings = %v, want exactly one\", document, findings)\n132|\t\t}\n133|\t\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n134|\t\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n135|\t\t}\n136|\t}\n137|}\n138|\n139|func TestAvailableCapabilityAdmitsPositiveClaim(t *testing.T) {\n140|\tt.Parallel()\n141|\tfindings, err := CheckAdvertisements(\n142|\t\t\"The `fifo` capability is available on Linux.\",\n143|\t\tavailableStates(\"fifo\"))\n144|\tif err != nil {\n145|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n146|\t}\n147|\tif len(findings) != 0 {\n148|\t\tt.Fatalf(\"available capability drew findings = %v\", findings)\n149|\t}\n150|}\n151|\n152|func TestMixedAvailabilityFindsOnlyUnavailable(t *testing.T) {\n153|\tt.Parallel()\n154|\tfindings, err := CheckAdvertisements(\n155|\t\t\"The `symlink` and `fifo` lanes are available on Windows, and `mode-bits` stays up too.\",\n156|\t\t[]ProbeState{\n157|\t\t\t{ID: \"symlink\", Available: true},\n158|\t\t\t{ID: \"fifo\", Available: false},\n159|\t\t\t{ID: \"mode-bits\", Available: false},\n160|\t\t})\n161|\tif err != nil {\n162|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n163|\t}\n164|\t// Asserted as a set: finding order is presentation, not verdict.\n165|\trefused := map[string]bool{}\n166|\tfor _, finding := range findings {\n167|\t\trefused[finding.ID] = true\n168|\t}\n169|\twant := map[string]bool{\"fifo\": true, \"mode-bits\": true}\n170|\tif len(refused) != len(want) {\n171|\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n172|\t}\n173|\tfor id := range want {\n174|\t\tif !refused[id] {\n175|\t\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n176|\t\t}\n177|\t}\n178|}\n179|\n180|func TestEmptyInputsAreRefused(t *testing.T) {\n181|\tt.Parallel()\n182|\tif _, err := CheckAdvertisements(\"The `fifo` lane is up.\", nil); err == nil {\n183|\t\tt.Error(\"empty probe set admitted; the gate would pass on an empty vocabulary\")\n184|\t}\n185|\tif _, err := CheckAdvertisements(\"   \\n  \", unavailableStates(\"fifo\")); err == nil {\n186|\t\tt.Error(\"empty document admitted; the gate would pass on nothing scanned\")\n187|\t}\n188|}\n189|\n190|// TestSubstringIsNotAMarker pins boundary anchoring: \"protest\" carries the\n191|// letters t-e-s-t without the word test, and must not classify the sentence.\n192|// A gate matching substrings would admit this claim-shaped mention.\n193|func TestSubstringIsNotAMarker(t *testing.T) {\n194|\tt.Parallel()\n195|\tfindings, err := CheckAdvertisements(\"Citizens protest the `fifo` cut.\", unavailableStates(\"fifo\"))\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n198|\t}\n199|\tif len(findings) != 1 {\n200|\t\tt.Fatalf(\"findings = %v, want exactly the unclassified refusal\", findings)\n201|\t}\n202|\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n203|\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n204|\t}\n205|}\n206|\n207|func TestFindingCarriesLine(t *testing.T) {\n208|\tt.Parallel()\n209|\tdocument := \"First line.\\n\\nThe `fifo` capability is available on Windows.\\n\"\n210|\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n211|\tif err != nil {\n212|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n213|\t}\n214|\tif len(findings) != 1 {\n215|\t\tt.Fatalf(\"findings = %v, want exactly one\", findings)\n216|\t}\n217|\tif findings[0].Line != 3 {\n218|\t\tt.Errorf(\"finding line = %d, want 3\", findings[0].Line)\n219|\t}\n220|}\n221|\n222|func readREADME(t *testing.T) string {\n223|\tt.Helper()\n224|\tcontents, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"README.md\"))\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"read README.md: %v\", err)\n227|\t}\n228|\treturn string(contents)\n229|}\n230|\n231|func allUnavailable(t *testing.T) []ProbeState {\n232|\tt.Helper()\n233|\tids, err := CapabilityIDs()\n234|\tif err != nil {\n235|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n236|\t}\n237|\treturn unavailableStates(ids...)\n238|}\n239|\n240|// TestRealREADMECarriesNoPositiveClaim runs the gate over the real\n241|// advertisement surface with every probe forced unavailable — the strongest\n242|// posture: every backticked capability mention must already be classified\n243|// non-claim, or a future edit away from refusal.\n244|func TestRealREADMECarriesNoPositiveClaim(t *testing.T) {\n245|\tt.Parallel()\n246|\tfindings, err := CheckAdvertisements(readREADME(t), allUnavailable(t))\n247|\tif err != nil {\n248|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n249|\t}\n250|\tif len(findings) != 0 {\n251|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n252|\t}\n253|}\n254|\n255|func TestRealREADMEAdmitsWhenAllAvailable(t *testing.T) {\n256|\tt.Parallel()\n257|\tids, err := CapabilityIDs()\n258|\tif err != nil {\n259|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n260|\t}\n261|\tfindings, err := CheckAdvertisements(readREADME(t), availableStates(ids...))\n262|\tif err != nil {\n263|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n264|\t}\n265|\tif len(findings) != 0 {\n266|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n267|\t}\n268|}\n269|\n270|// TestEveryNonClaimMarkerOccursInCorpus keeps the marker list honest: a\n271|// marker that fires on no real sentence is either dead weight or an admission\n272|// hole reserved for future text.\n273|func TestEveryNonClaimMarkerOccursInCorpus(t *testing.T) {\n274|\tt.Parallel()\n275|\tdocument := readREADME(t)\n276|\tids, err := CapabilityIDs()\n277|\tif err != nil {\n278|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n279|\t}\n280|\tprobed := map[string]bool{}\n281|\tfor _, id := range ids {\n282|\t\tprobed[\"`\"+id+\"`\"] = true\n283|\t}\n284|\tvar mentioning []string\n285|\tfor _, part := range splitSentences(document) {\n286|\t\tfor token := range probed {\n287|\t\t\tif strings.Contains(part.text, token) {\n288|\t\t\t\tmentioning = append(mentioning, part.text)\n289|\t\t\t\tbreak\n290|\t\t\t}\n291|\t\t}\n292|\t}\n293|\tif len(mentioning) == 0 {\n294|\t\tt.Fatal(\"no corpus sentence mentions a probe ID; the marker census is vacuous\")\n295|\t}\n296|\tfor _, marker := range nonClaimMarkers {\n297|\t\tfound := false\n298|\t\tfor _, text := range mentioning {\n299|\t\t\tif wordMatches(marker, strings.ToLower(text)) {\n300|\t\t\t\tfound = true\n301|\t\t\t\tbreak\n302|\t\t\t}\n303|\t\t}\n304|\t\tif !found {\n305|\t\t\tt.Errorf(\"marker %q occurs in no probe-mentioning sentence; remove it or classify with it\", marker)\n306|\t\t}\n307|\t}\n308|}"}}}
