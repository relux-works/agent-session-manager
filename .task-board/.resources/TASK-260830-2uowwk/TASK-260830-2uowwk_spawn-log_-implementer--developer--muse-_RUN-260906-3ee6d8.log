{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3ef","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":82,"recorded_at":1780531400000159,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"82cd5e41-4e93-45b4-a1d3-68a882ec3de2"},"task_id":"82cd5e41-4e93-45b4-a1d3-68a882ec3de2","event":{"kind":"output","task_id":"82cd5e41-4e93-45b4-a1d3-68a882ec3de2","chunk":"Read text file `internal/cigate/targets.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n9|)\n10|\n11|// FuzzTargets derives the committed fuzz-target list from the instrument's\n12|// own FuzzTargetEntry map, sorted. CI iterates this derivation rather than a\n13|// retyped copy, so a target added without an entry — or an entry without a\n14|// target — breaks the derivation's own pin before CI can pass on an empty or\n15|// stale list.\n16|func FuzzTargets() ([]string, error) {\n17|\tentries := make(map[string]string, len(secconftest.FuzzTargetEntry))\n18|\tfor target, entry := range secconftest.FuzzTargetEntry {\n19|\t\tentries[target] = string(entry)\n20|\t}\n21|\treturn sortedTargets(entries)\n22|}\n23|\n24|// sortedTargets is the testable core of FuzzTargets: production passes the\n25|// instrument's own map, tests pass synthetic ones.\n26|func sortedTargets(entries map[string]string) ([]string, error) {\n27|\ttargets := make([]string, 0, len(entries))\n28|\tfor target, entry := range entries {\n29|\t\tif !strings.HasPrefix(target, \"Fuzz\") || entry == \"\" {\n30|\t\t\treturn nil, fmt.Errorf(\"cigate: fuzz target entry %q is malformed\", target)\n31|\t\t}\n32|\t\ttargets = append(targets, target)\n33|\t}\n34|\tif len(targets) == 0 {\n35|\t\treturn nil, fmt.Errorf(\"cigate: fuzz target derivation is empty\")\n36|\t}\n37|\tsort.Strings(targets)\n38|\treturn targets, nil\n39|}"}}}
