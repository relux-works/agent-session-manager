{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c553","stream":{"kind":"session","id":"01a0782c-6f74-7fc3-a546-73229f09b865"},"sequence":260,"recorded_at":1780531400000515,"record_type":"event","durability":"durable","causation_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d5642b5c-8a5c-4554-a722-903669c33bb0","run_stream":{"kind":"run","id":"d5642b5c-8a5c-4554-a722-903669c33bb0"},"task_stream":{"kind":"task","id":"910762ea-190d-4c25-94c1-6acbdba9c47e"},"task_id":"910762ea-190d-4c25-94c1-6acbdba9c47e","event":{"kind":"output","task_id":"910762ea-190d-4c25-94c1-6acbdba9c47e","chunk":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"task-board --help 2>&1 | head -50\",\n  \"description\": \"Show task-board help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n\",\n  \"original_output_bytes\": 2982,\n  \"original_output_tokens\": 746,\n  \"truncated\": false\n}"}}}
