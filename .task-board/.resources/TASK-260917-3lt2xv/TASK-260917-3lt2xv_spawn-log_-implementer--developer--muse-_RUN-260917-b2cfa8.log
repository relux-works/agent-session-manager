\n891|\n892|func assertFamilyNames(t *testing.T, got, want map[string][]string) {\n893|\tt.Helper()\n894|\tif reflect.DeepEqual(got, want) {\n895|\t\treturn\n896|\t}\n897|\tgotFamilies := make([]string, 0, len(got))\n898|\tfor family := range got {\n899|\t\tgotFamilies = append(gotFamilies, family)\n900|\t}\n901|\tsort.Strings(gotFamilies)\n902|\tt.Fatalf(\"catalog family names differ\\ngot families: %v\\ngot: %#v\\nwant: %#v\", gotFamilies, got, want)\n903|}","final_result":true}}}
