  \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckArgv$ -fuzztime=100x -parallel=1\",\n391|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzCheckMemberPath$ -fuzztime=100x -parallel=1\",\n392|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzIsEnvName$ -fuzztime=100x -parallel=1\",\n393|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzRedactCorpus$ -fuzztime=100x -parallel=1\",\n394|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzEscapeForTerminal$ -fuzztime=100x -parallel=1\",\n395|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzRenderForTerminal$ -fuzztime=100x -parallel=1\",\n396|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzGuardResolve$ -fuzztime=100x -parallel=1\",\n397|          \"go test ./internal/secconftest -run=^$ -fuzz=^FuzzDetectCaseCollision$ -fuzztime=100x -parallel=1\",\n398|          \"go run ./internal/traceability/cmd/tracecheck\",\n399|          \"go run ./internal/catalog/cmd/cataloggen -metadata internal/catalog/catalog.v0.6.0.json -contracts internal/specpin/v0.6.0.lock.json -output internal/catalog/catalog_gen.go -check\",\n400|          \"GOOS=linux GOARCH=amd64 go build ./...\",\n401|          \"GOOS=windows GOARCH=amd64 go build ./...\",\n402|          \"git ls-files -z '*.json' | xargs -0 -n1 python3 -c 'import json,sys;json.load(open(sys.argv[1]))'\",\n403|          \"task-board validate\",\n404|          \"git diff --check\"\n405|        ]\n406|      }\n407|    }\n408|  },\n409|  \"features\": {\n410|    \"agent_context\": {\n411|      \"enabled\": true,\n412|      \"profile\": \"full\"\n413|    },\n414|    \"context_sharing\": {\n415|      \"enabled\": false\n416|    },\n417|    \"primary_session_goals\": {\n418|      \"enabled\": true\n419|    },\n420|    \"spawned_run_goals\": {\n421|      \"enabled\": true\n422|    }\n423|  }\n424|}","final_result":true}}}
