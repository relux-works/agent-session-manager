ckendFixtureID  = \"ax-terminal-backend-conformance-v1\"\n35|\tRoadmapV043FixtureID      = \"ax-v0.4.3-roadmap-terminal-realm-v1\"\n36|\n37|\t// ManifestSHA256 pins the exact bytes embedded in this package.\n38|\tManifestSHA256 = \"6fa3a22be22525b4a0146fe9f995aad63c49c2230e86c7039f8eacb87df1ab8c\"\n39|)\n40|\n41|// The v0.6.0 constants below adopt the independently accepted signed release\n42|// agent-session-manager-spec v0.6.0 (annotated tag object\n43|// 40c123eb8399efa8e05cbc009110940ed861a785 peeling to commit\n44|// 0cbdf100dbf84df50c64f792b1f940e3a67859a6) as the adopted normative source\n45|// authority. Every v0.5.0 constant above keeps its historical meaning: nothing\n46|// here relabels the old lock, document, or inventory. Current/Verify still\n47|// serve the v0.5.0 baseline for the intentionally-historical platform-path\n48|// registry; the catalogue, traceability, and CI gates consume v0.6.0 through\n49|// CurrentV060/VerifyV060 and derive the historical projections from it.\n50|const (\n51|\tReleaseV060 = \"v0.6.0\"\n52|\tTagV060     = \"v0.6.0\"\n53|\t// TagObjectV060 is the verified annotated tag object; CommitV060 is the\n54|\t// peeled commit it points to. Both were verified with git verify-tag and\n55|\t// git verify-commit before adoption.\n56|\tTagObjectV060 = \"40c123eb8399efa8e05cbc009110940ed861a785\"\n57|\tCommitV060    = \"0cbdf100dbf84df50c64f792b1f940e3a67859a6\"\n58|\t// DocumentSHA256V060 is the SHA-256 of the 1150005-byte SPEC.md blob at\n59|\t// the peeled commit, measured from the tagged blob, not the worktree.\n60|\tDocumentSHA256V060 = \"74504539fb43c28ae3450622bc1002e643f116cd3e14df4567a882231e90896b\"\n61|\n62|\t// HostChannelFixtureID is the fixture discriminator the upstream\n63|\t// host_channel_conformance.json file declares for itself.\n64|\tHostChannelFixtureID = \"ax-host-channel-conformance-v1\"\n65|\t// SessionSelectorFixtureID is pin-local: the upstream\n66|\t// session_selector_conformance.json file carries no fixture\n67|\t// discriminator (it binds specification_version 0.6.0 with contract\n68|\t// 1.0.0 instead), so the identifier follows the mechanical\n69|\t// path-stem convention of the other rows and is bound by the pinned\n70|\t// path and SHA-256 below.\n71|\tSessionSelectorFixtureID = \"ax-session-selector-conformance-v1\"\n72|\n73|\t// ManifestSHA256V060 pins the exact v0.6.0 lock bytes embedded below.\n74|\tManifestSHA256V060 = \"005cd4ffb5aba6792786727bf7d9fa59305191c81b210aae8d3d564d80661fb3\"\n75|)\n76|\n77|var (\n78|\t// ErrPinMismatch reports malformed, partial, drifted, or substituted pin data.\n79|\tErrPinMismatch = errors.New(\"normative source pin mismatch\")\n80|\n81|\t// ErrUnsupportedRelease reports a release outside the pinned compatibility set.\n82|\tErrUnsupportedRelease = errors.New(\"unsupported specification release\")\n83|)\n84|\n85|//go:embed v0.5.0.lock.json\n86|var embeddedPin []byte\n87|\n88|//go:embed v0.6.0.lock.json\n89|var embeddedPinV060 []byte\n90|\n91|var (\n92|\thex40  = regexp.MustCompile(`^[0-9a-f]{40}$`)\n93|\thex64  = regexp.MustCompile(`^[0-9a-f]{64}$`)\n94|\tsemver = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$`)\n95|)\n96|\n97|// Manifest is implementation metadata, not an independently versioned AX wire\n98|// contract. Its only accepted instance is the embedded release lock.\n99|type Manifest struct {\n100|\tFormat        string           `json:\"format\"`\n101|\tFormatVersion int              `json:\"format_version\"`\n102|\tSource        SourcePin        `json:\"source\"`\n103|\tContracts     []ContractPin    `json:\"contracts\"`\n104|\tCompatibility CompatibilityPin `json:\"compatibility\"`\n105|\tFixtures      []FixturePin     `json:\"fixtures\"`\n106|}\n107|\n108|type SourcePin struct {\n109|\tRepository             string      `json:\"repository\"`\n110|\tRelease                string      `json:\"release\"`\n111|\tTag                    string      `json:\"tag\"`\n112|\tTagObject              string      `json:\"tag_object\"`\n113|\tCommit                 string      `json:\"commit\"`\n114|\tDocument               DocumentPin `json:\"document\"`\n115|\tSectionInventorySHA256 string      `json:\"section_inventory_sha256\"`\n116|\tNormativeScope         []string    `json:\"normative_scope\"`\n117|}\n118|\n119|type DocumentPin struct {\n120|\tPath   string `json:\"path\"`\n121|\tSHA256 string `json:\"sha256\"`\n122|}\n123|\n124|type ContractPin struct {\n125|\tName     string   `json:\"name\"`\n126|\tID       string   `json:\"id\"`\n127|\tVersions []string `json:\"versions\"`\n128|}\n129|\n130|type CompatibilityPin struct {\n131|\tBaselineRelease  string        `json:\"baseline_release\"`\n132|\tRegistrySHA256   string        `json:\"registry_sha256\"`\n133|\tAbsentContracts  []string      `json:\"absent_contracts\"`\n134|\tVersionOverrides []ContractPin `json:\"version_overrides\"`\n135|}\n136|\n137|type FixturePin struct {\n138|\tID     string `json:\"id\"`\n139|\tPath   string `json:\"path\"`\n140|\tSHA256 string `json:\"sha256\"`\n141|}\n142|\n143|// Bytes returns an isolated copy of the exact embedded lock bytes.\n144|func Bytes() []byte {\n145|\treturn bytes.Clone(embeddedPin)\n146|}\n147|\n148|// BytesV060 returns an isolated copy of the exact embedded v0.6.0 lock bytes.\n149|func BytesV060() []byte {\n150|\treturn bytes.Clone(embeddedPinV060)\n(more lines below)","final_result":true}}}
