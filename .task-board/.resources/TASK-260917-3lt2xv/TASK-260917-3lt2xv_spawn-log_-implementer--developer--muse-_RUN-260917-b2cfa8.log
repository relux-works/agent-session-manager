{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c485","stream":{"kind":"session","id":"01a0adf6-85aa-70c2-bc58-c12e2d2660fd"},"sequence":157,"recorded_at":1780531400000309,"record_type":"event","durability":"durable","causation_id":"fd38f806-c210-492a-8285-9e843f4a64a5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fd38f806-c210-492a-8285-9e843f4a64a5","run_stream":{"kind":"run","id":"fd38f806-c210-492a-8285-9e843f4a64a5"},"task_stream":{"kind":"task","id":"01a0adf6-e61a-7641-a967-1760ebb7bda6"},"task_id":"01a0adf6-e61a-7641-a967-1760ebb7bda6","event":{"kind":"output","task_id":"01a0adf6-e61a-7641-a967-1760ebb7bda6","chunk":"Read text file `internal/catalog/catalog.go`.\n1|// Package catalog exposes generated, typed vocabularies from the reviewed AX\n2|// implementation metadata. Catalog membership defines a contract vocabulary;\n3|// it never advertises runtime availability or implementation support.\n4|package catalog\n5|\n6|import (\n7|\t\"errors\"\n8|\t\"fmt\"\n9|)\n10|\n11|const (\n12|\tFormat        = \"ax-implementation-catalog\"\n13|\tFormatVersion = 1\n14|\n15|\tReleaseV043 Release = \"v0.4.3\"\n16|\tReleaseV050 Release = \"v0.5.0\"\n17|\tReleaseV060 Release = \"v0.6.0\"\n18|)\n19|\n20|var ErrUnsupportedRelease = errors.New(\"unsupported catalog release\")\n21|\n22|// Release identifies a specification package release represented by the\n23|// reviewed implementation metadata.\n24|type Release string\n25|\n26|// ContractID is a registered AX schema or protocol identifier.\n27|type ContractID string\n28|\n29|// Family scopes operation, capability, and event names that may otherwise\n30|// overlap across independent contracts.\n31|type Family string\n32|\n33|// OperationName is one closed operation-registry member.\n34|type OperationName string\n35|\n36|// CapabilityName is one manifest/probe capability-vocabulary member. It does\n37|// not imply that the capability is available.\n38|type CapabilityName string\n39|\n40|// EventName is one closed Session Event or required Observation Event member.\n41|type EventName string\n42|\n43|// ErrorName is one stable Structured Error code.\n44|type ErrorName string\n45|\n46|// Source binds every generated definition to the immutable normative source.\n47|type Source struct {\n48|\tRepository     string\n49|\tRelease        Release\n50|\tCommit         string\n51|\tDocumentPath   string\n52|\tDocumentSHA256 string\n53|\tNormativeScope []string\n54|}\n55|\n56|// Contract is one independently versioned schema or protocol contract.\n57|type Contract struct {\n58|\tName     string\n59|\tID       ContractID\n60|\tVersions []string\n61|}\n62|\n63|// SelfIdentityContract defines the schema-directed JCS omit-self rule for an\n64|// immutable logical object. Membership is reviewed metadata from the pinned\n65|// specification; it does not imply that any wider schema behavior is\n66|// implemented.\n67|type SelfIdentityContract struct {\n68|\tContractID         ContractID\n69|\tContractVersions   []string\n70|\tSelfField          string\n71|\tDiscriminatorName  string\n72|\tDiscriminatorValue string\n73|\tNormativeSection   string\n74|}\n75|\n76|// OperationEffect classifies whether an operation mutates authoritative\n77|// durable state. Isolated output is restricted to caller-created sinks and is\n78|// not an authoritative state transition.\n79|type OperationEffect string\n80|\n81|const (\n82|\t// EffectNoDurableMutation makes no stronger read-only claim: an operation\n83|\t// may still plan work or control an ephemeral process.\n84|\tEffectNoDurableMutation OperationEffect = \"no_durable_mutation\"\n85|\tEffectIsolatedOutput    OperationEffect = \"isolated_output\"\n86|\tEffectDurableMutation   OperationEffect = \"durable_mutation\"\n87|)\n88|\n89|// Operation is a typed protocol/query operation definition. Durable mutations\n90|// always carry both an exact idempotency scope and recovery evidence.\n91|type Operation struct {\n92|\tFamily           Family\n93|\tName             OperationName\n94|\tContractID       ContractID\n95|\tContractVersions []string\n96|\tEffect           OperationEffect\n97|\tIdempotencyKey   string\n98|\tRecoveryEvidence []string\n99|\tNormativeSection string\n100|\tFixtureFamilies  []string\n101|}\n102|\n103|// Capability is a vocabulary definition only. Availability, status, enabled,\n104|// and support claims deliberately do not exist in this type.\n105|type Capability struct {\n106|\tFamily           Family\n107|\tName             CapabilityName\n108|\tContractID       ContractID\n109|\tContractVersions []string\n110|\tNormativeSection string\n111|\tFixtureFamilies  []string\n112|}\n113|\n114|// Event is a required event name and the exact contract versions that define\n115|// it. Session Events and Observation Events remain separate families.\n116|type Event struct {\n117|\tFamily           Family\n118|\tName             EventName\n119|\tContractID       ContractID\n120|\tContractVersions []string\n121|\tNormativeSection string\n122|\tFixtureFamilies  []string\n123|}\n124|\n125|// ErrorCode is one stable Structured Error code-to-exit mapping.\n126|type ErrorCode struct {\n127|\tCode             ErrorName\n128|\tExitCode         int\n129|\tContractID       ContractID\n130|\tContractVersions []string\n131|\tNormativeSection string\n132|\tFixtureFamilies  []string\n133|}\n134|\n135|// Catalog is an isolated release projection of the generated definitions.\n136|type Catalog struct {\n137|\tSource         Source\n138|\tRelease        Release\n139|\tMetadataSHA256 string\n140|\tContracts      []Contract\n141|\tSelfIdentities []SelfIdentityContract\n142|\tOperations     []Operation\n143|\tCapabilities   []Capability\n144|\tEvents         []Event\n145|\tErrors         []ErrorCode\n146|}\n147|\n148|type catalogDefinition struct {\n149|\tSource         Source\n150|\tMetadataSHA256 string\n151|\tContracts      map[Release][]Contract\n152|\tSelfIdentities []scopedSelfIdentityContract\n153|\tOperations     []scopedOperation\n154|\tCapabilities   []scopedCapability\n155|\tEvents         []scopedEvent\n156|\tErrors         []scopedError\n157|}\n158|\n159|type scopedSelfIdentityContract struct {\n160|\tDefinition SelfIdentityContract\n161|\tReleases   []Release\n162|}\n163|\n164|type scopedOperation struct {\n165|\tDefinition Operation\n166|\tReleases   []Release\n167|}\n168|\n169|type scopedCapability struct {\n170|\tDefinition Capability\n171|\tReleases   []Release\n172|}\n173|\n174|type scopedEvent struct {\n175|\tDefinition Event\n176|\tReleases   []Release\n177|}\n178|\n179|type scopedError struct {\n180|\tDefinition ErrorCode\n181|\tReleases   []Release\n182|}\n183|\n184|//go:generate go run ./cmd/cataloggen -metadata catalog.v0.6.0.json -contracts ../specpin/v0.6.0.lock.json -output catalog_gen.go\n185|\n186|// Current returns an isolated catalog for the adopted v0.6.0 source. The\n187|// exact historical v0.5.0 and v0.4.3 projections remain available through\n188|// ForRelease; they are derived from the adopted lock, never retyped.\n189|func Current() Catalog {\n190|\tcatalog, err := ForRelease(ReleaseV060)\n191|\tif err != nil {\n192|\t\tpanic(fmt.Sprintf(\"generated current catalog is invalid: %v\", err))\n193|\t}\n194|\treturn catalog\n195|}\n196|\n197|// ForRelease returns an isolated exact catalog projection for a represented\n198|// release. It never coerces or guesses an unsupported release.\n199|func ForRelease(release Release) (Catalog, error) {\n200|\tcontracts, ok := generatedDefinition.Contracts[release]\n201|\tif !ok {\n202|\t\treturn Catalog{}, fmt.Errorf(\"%w: %s\", ErrUnsupportedRelease, release)\n203|\t}\n204|\n205|\tallowedVersions := make(map[ContractID]map[string]struct{}, len(contracts))\n206|\tfor _, contract := range contracts {\n207|\t\tversions := allowedVersions[contract.ID]\n208|\t\tif versions == nil {\n209|\t\t\tversions = make(map[string]struct{}, len(contract.Versions))\n210|\t\t\tallowedVersions[contract.ID] = versions\n211|\t\t}\n212|\t\tfor _, version := range contract.Versions {\n213|\t\t\tversions[version] = struct{}{}\n214|\t\t}\n215|\t}\n216|\n217|\tresult := Catalog{\n218|\t\tSource:         cloneSource(generatedDefinition.Source),\n219|\t\tRelease:        release,\n220|\t\tMetadataSHA256: generatedDefinition.MetadataSHA256,\n221|\t\tContracts:      cloneContracts(contracts),\n222|\t}\n223|\tfor _, scoped := range generatedDefinition.SelfIdentities {\n224|\t\tif !containsRelease(scoped.Releases, release) {\n225|\t\t\tcontinue\n226|\t\t}\n227|\t\tdefinition := cloneSelfIdentityContract(scoped.Definition)\n228|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n229|\t\tif len(definition.ContractVersions) != 0 {\n230|\t\t\tresult.SelfIdentities = append(result.SelfIdentities, definition)\n231|\t\t}\n232|\t}\n233|\tfor _, scoped := range generatedDefinition.Operations {\n234|\t\tif !containsRelease(scoped.Releases, release) {\n235|\t\t\tcontinue\n236|\t\t}\n237|\t\tdefinition := cloneOperation(scoped.Definition)\n238|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n239|\t\tif len(definition.ContractVersions) != 0 {\n240|\t\t\tresult.Operations = append(result.Operations, definition)\n241|\t\t}\n242|\t}\n243|\tfor _, scoped := range generatedDefinition.Capabilities {\n244|\t\tif !containsRelease(scoped.Releases, release) {\n245|\t\t\tcontinue\n246|\t\t}\n247|\t\tdefinition := cloneCapability(scoped.Definition)\n248|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n249|\t\tif len(definition.ContractVersions) != 0 {\n250|\t\t\tresult.Capabilities = append(result.Capabilities, definition)\n251|\t\t}\n252|\t}\n253|\tfor _, scoped := range generatedDefinition.Events {\n254|\t\tif !containsRelease(scoped.Releases, release) {\n255|\t\t\tcontinue\n256|\t\t}\n257|\t\tdefinition := cloneEvent(scoped.Definition)\n258|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n259|\t\tif len(definition.ContractVersions) != 0 {\n260|\t\t\tresult.Events = append(result.Events, definition)\n261|\t\t}\n262|\t}\n263|\tfor _, scoped := range generatedDefinition.Errors {\n264|\t\tif !containsRelease(scoped.Releases, release) {\n265|\t\t\tcontinue\n266|\t\t}\n267|\t\tdefinition := cloneError(scoped.Definition)\n268|\t\tdefinition.ContractVersions = filterVersions(definition.ContractVersions, allowedVersions[definition.ContractID])\n269|\t\tif len(definition.ContractVersions) != 0 {\n270|\t\t\tresult.Errors = append(result.Errors, definition)\n271|\t\t}\n272|\t}\n273|\treturn result, nil\n274|}\n275|\n276|func containsRelease(releases []Release, wanted Release) bool {\n277|\tfor _, release := range releases {\n278|\t\tif release == wanted {\n279|\t\t\treturn true\n280|\t\t}\n281|\t}\n282|\treturn false\n283|}\n284|\n285|func filterVersions(versions []string, allowed map[string]struct{}) []string {\n286|\tfiltered := make([]string, 0, len(versions))\n287|\tfor _, version := range versions {\n288|\t\tif _, ok := allowed[version]; ok {\n289|\t\t\tfiltered = append(filtered, version)\n290|\t\t}\n291|\t}\n292|\treturn filtered\n293|}\n294|\n295|func cloneSource(source Source) Source {\n296|\tsource.NormativeScope = append([]string(nil), source.NormativeScope...)\n297|\treturn source\n298|}\n299|\n300|func cloneContracts(contracts []Contract) []Contract {\n301|\tresult := make([]Contract, len(contracts))\n302|\tfor index, contract := range contracts {\n303|\t\tcontract.Versions = append([]string(nil), contract.Versions...)\n304|\t\tresult[index] = contract\n305|\t}\n306|\treturn result\n307|}\n308|\n309|func cloneSelfIdentityContract(contract SelfIdentityContract) SelfIdentityContract {\n310|\tcontract.ContractVersions = append([]string(nil), contract.ContractVersions...)\n311|\treturn contract\n312|}\n313|\n314|func cloneOperation(operation Operation) Operation {\n315|\toperation.ContractVersions = append([]string(nil), operation.ContractVersions...)\n316|\toperation.RecoveryEvidence = append([]string(nil), operation.RecoveryEvidence...)\n317|\toperation.FixtureFamilies = append([]string(nil), operation.FixtureFamilies...)\n318|\treturn operation\n319|}\n320|\n321|func cloneCapability(capability Capability) Capability {\n322|\tcapability.ContractVersions = append([]string(nil), capability.ContractVersions...)\n323|\tcapability.FixtureFamilies = append([]string(nil), capability.FixtureFamilies...)\n324|\treturn capability\n325|}\n326|\n327|func cloneEvent(event Event) Event {\n328|\tevent.ContractVersions = append([]string(nil), event.ContractVersions...)\n329|\tevent.FixtureFamilies = append([]string(nil), event.FixtureFamilies...)\n330|\treturn event\n331|}\n332|\n333|func cloneError(item ErrorCode) ErrorCode {\n334|\titem.ContractVersions = append([]string(nil), item.ContractVersions...)\n335|\titem.FixtureFamilies = append([]string(nil), item.FixtureFamilies...)\n336|\treturn item\n337|}","final_result":true}}}
