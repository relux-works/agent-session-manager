{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a0adf6-85aa-70c2-bc58-c12e2d2660fd"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"fd38f806-c210-492a-8285-9e843f4a64a5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fd38f806-c210-492a-8285-9e843f4a64a5","run_stream":{"kind":"run","id":"fd38f806-c210-492a-8285-9e843f4a64a5"},"task_stream":{"kind":"task","id":"01a0adf6-eefd-73a1-bd77-1b839c27224f"},"task_id":"01a0adf6-eefd-73a1-bd77-1b839c27224f","event":{"kind":"output","task_id":"01a0adf6-eefd-73a1-bd77-1b839c27224f","chunk":"Read text file `internal/cataloggen/generate.go`.\n1|// Package cataloggen validates reviewed AX implementation metadata and emits\n2|// the deterministic typed Go catalog consumed by internal/catalog.\n3|package cataloggen\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"crypto/sha256\"\n8|\t\"encoding/hex\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\t\"fmt\"\n12|\t\"go/format\"\n13|\t\"io\"\n14|\t\"regexp\"\n15|\t\"strconv\"\n16|\t\"strings\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n19|)\n20|\n21|const (\n22|\tmetadataFormat        = \"ax-implementation-catalog\"\n23|\tmetadataFormatVersion = 1\n24|\n25|\t// reviewedMetadataCanonicalSHA256 pins the v0.6.0 reviewed metadata:\n26|\t// the v0.5.0 families carried onto the adopted v0.6.0 source with Mesh\n27|\t// RPC 5.0.0 (SPEC 11.10.1: RPC 5 carries the exact RPC-4 operations).\n28|\t// No family gains operations, capabilities, events, or sections beyond\n29|\t// the adopted delta. Structured Error 1.4.0 stays out of the error\n30|\t// vocabulary on purpose: the axerror registry is closed over 1.0-1.3\n31|\t// and the 1.4.0 code-to-exit mapping has no Go owner yet, so minting\n32|\t// the codes here would panic every axerror consumer at init. The 1.4.0\n33|\t// contract version itself is adopted at the census level through the\n34|\t// verified lock, and Section 14.7.3 is disclosed unowned.\n35|\treviewedMetadataCanonicalSHA256 = \"5788d45d89a7f7a39f91130e4758d86697d22097a39e0a86cb32a0e9de87b963\"\n36|)\n37|\n38|var ErrInvalidMetadata = errors.New(\"invalid implementation catalog metadata\")\n39|\n40|type metadata struct {\n41|\tFormat             string                 `json:\"format\"`\n42|\tFormatVersion      int                    `json:\"format_version\"`\n43|\tSource             sourceMetadata         `json:\"source\"`\n44|\tNormativeScope     []string               `json:\"normative_scope\"`\n45|\tSelfIdentities     []selfIdentityContract `json:\"self_identity_contracts\"`\n46|\tOperationFamilies  []operationFamily      `json:\"operation_families\"`\n47|\tCapabilityFamilies []capabilityFamily     `json:\"capability_families\"`\n48|\tEventFamilies      []eventFamily          `json:\"event_families\"`\n49|\tErrorCatalog       errorCatalog           `json:\"error_catalog\"`\n50|}\n51|\n52|type selfIdentityContract struct {\n53|\tContractID         string   `json:\"contract_id\"`\n54|\tContractVersions   []string `json:\"contract_versions\"`\n55|\tSelfField          string   `json:\"self_field\"`\n56|\tReleases           []string `json:\"releases\"`\n57|\tDiscriminatorName  string   `json:\"discriminator_name,omitempty\"`\n58|\tDiscriminatorValue string   `json:\"discriminator_value,omitempty\"`\n59|\tNormativeSection   string   `json:\"normative_section\"`\n60|}\n61|\n62|type sourceMetadata struct {\n63|\tRepository     string `json:\"repository\"`\n64|\tRelease        string `json:\"release\"`\n65|\tCommit         string `json:\"commit\"`\n66|\tDocumentPath   string `json:\"document_path\"`\n67|\tDocumentSHA256 string `json:\"document_sha256\"`\n68|}\n69|\n70|type operationFamily struct {\n71|\tFamily           string          `json:\"family\"`\n72|\tContractID       string          `json:\"contract_id\"`\n73|\tContractVersions []string        `json:\"contract_versions\"`\n74|\tReleases         []string        `json:\"releases\"`\n75|\tNormativeSection string          `json:\"normative_section\"`\n76|\tFixtureFamilies  []string        `json:\"fixture_families\"`\n77|\tOperations       []string        `json:\"operations\"`\n78|\tIsolatedOutputs  []string        `json:\"isolated_outputs\"`\n79|\tMutationGroups   []mutationGroup `json:\"mutation_groups\"`\n80|}\n81|\n82|type mutationGroup struct {\n83|\tOperations       []string `json:\"operations\"`\n84|\tIdempotencyKey   string   `json:\"idempotency_key\"`\n85|\tRecoveryEvidence []string `json:\"recovery_evidence\"`\n86|}\n87|\n88|type capabilityFamily struct {\n89|\tFamily           string   `json:\"family\"`\n90|\tContractID       string   `json:\"contract_id\"`\n91|\tContractVersions []string `json:\"contract_versions\"`\n92|\tReleases         []string `json:\"releases\"`\n93|\tNormativeSection string   `json:\"normative_section\"`\n94|\tFixtureFamilies  []string `json:\"fixture_families\"`\n95|\tCapabilities     []string `json:\"capabilities\"`\n96|}\n97|\n98|type eventFamily struct {\n99|\tFamily           string       `json:\"family\"`\n100|\tContractID       string       `json:\"contract_id\"`\n101|\tReleases         []string     `json:\"releases\"`\n102|\tNormativeSection string       `json:\"normative_section\"`\n103|\tFixtureFamilies  []string     `json:\"fixture_families\"`\n104|\tGroups           []eventGroup `json:\"groups\"`\n105|}\n106|\n107|type eventGroup struct {\n108|\tContractVersions []string `json:\"contract_versions\"`\n109|\tEvents           []string `json:\"events\"`\n110|}\n111|\n112|type errorCatalog struct {\n113|\tContractID       string       `json:\"contract_id\"`\n114|\tContractVersions []string     `json:\"contract_versions\"`\n115|\tNormativeSection string       `json:\"normative_section\"`\n116|\tFixtureFamilies  []string     `json:\"fixture_families\"`\n117|\tGroups           []errorGroup `json:\"groups\"`\n118|}\n119|\n120|type errorGroup struct {\n121|\tIntroducedVersion string         `json:\"introduced_version\"`\n122|\tReleases          []string       `json:\"releases\"`\n123|\tMappings          []errorMapping `json:\"mappings\"`\n124|}\n125|\n126|type errorMapping struct {\n127|\tExitCode int      `json:\"exit_code\"`\n128|\tCodes    []string `json:\"codes\"`\n129|}\n130|\n131|type expandedOperation struct {\n132|\tFamily           string\n133|\tName             string\n134|\tContractID       string\n135|\tContractVersions []string\n136|\tEffect           string\n137|\tIdempotencyKey   string\n138|\tRecoveryEvidence []string\n139|\tNormativeSection string\n140|\tFixtureFamilies  []string\n141|\tReleases         []string\n142|}\n143|\n144|type expandedCapability struct {\n145|\tFamily           string\n146|\tName             string\n147|\tContractID       string\n148|\tContractVersions []string\n149|\tNormativeSection string\n150|\tFixtureFamilies  []string\n151|\tReleases         []string\n152|}\n153|\n154|type expandedEvent struct {\n155|\tFamily           string\n156|\tName             string\n157|\tContractID       string\n158|\tContractVersions []string\n159|\tNormativeSection string\n160|\tFixtureFamilies  []string\n161|\tReleases         []string\n162|}\n163|\n164|type expandedError struct {\n165|\tCode             string\n166|\tExitCode         int\n167|\tContractID       string\n168|\tContractVersions []string\n169|\tNormativeSection string\n170|\tFixtureFamilies  []string\n171|\tReleases         []string\n172|}\n173|\n174|var (\n175|\tnamePattern       = regexp.MustCompile(`^[a-z][a-z0-9_.-]*$`)\n176|\tcapabilityPattern = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n177|\terrorPattern      = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n178|)\n179|\n180|// Generate is the production generation entry point. It is pure: callers own\n181|// any output write and receive no partial artifact on validation failure.\n182|//\n183|// Generate verifies the adopted v0.6.0 normative lock and derives every\n184|// release projection the lock represents: the v0.6.0 current registry and\n185|// the exact historical v0.5.0 and v0.4.3 projections. A stale v0.5.0 lock or\n186|// metadata bound to it is refused, so the committed catalog cannot be\n187|// regenerated against superseded authority.\n188|func Generate(metadataBytes, contractLock []byte) ([]byte, error) {\n189|\tmanifest, err := specpin.VerifyV060(contractLock)\n190|\tif err != nil {\n191|\t\treturn nil, invalid(\"verify normative lock: %v\", err)\n192|\t}\n193|\tdecoded, err := decodeMetadata(metadataBytes)\n194|\tif err != nil {\n195|\t\treturn nil, err\n196|\t}\n197|\tif err := validateMetadata(decoded, manifest); err != nil {\n198|\t\treturn nil, err\n199|\t}\n200|\n201|\toperations := expandOperations(decoded.OperationFamilies)\n202|\tcapabilities := expandCapabilities(decoded.CapabilityFamilies)\n203|\tevents := expandEvents(decoded.EventFamilies)\n204|\terrorsCatalog := expandErrors(decoded.ErrorCatalog)\n205|\tdigest := sha256.Sum256(metadataBytes)\n206|\n207|\tvar output bytes.Buffer\n208|\toutput.WriteString(\"// Code generated by go generate ./internal/catalog; DO NOT EDIT.\\n\")\n209|\tfmt.Fprintf(&output, \"// Metadata SHA-256: %s\\n\\n\", hex.EncodeToString(digest[:]))\n210|\toutput.WriteString(\"package catalog\\n\\n\")\n211|\toutput.WriteString(\"var generatedDefinition = catalogDefinition{\\n\")\n212|\twriteSource(&output, decoded)\n213|\tfmt.Fprintf(&output, \"\\tMetadataSHA256: %q,\\n\", hex.EncodeToString(digest[:]))\n214|\twriteContracts(&output, manifest)\n215|\twriteSelfIdentities(&output, decoded.SelfIdentities)\n216|\twriteOperations(&output, operations)\n217|\twriteCapabilities(&output, capabilities)\n218|\twriteEvents(&output, events)\n219|\twriteErrors(&output, errorsCatalog)\n220|\toutput.WriteString(\"}\\n\")\n221|\n222|\tformatted, err := format.Source(output.Bytes())\n223|\tif err != nil {\n224|\t\treturn nil, invalid(\"format generated Go: %v\", err)\n225|\t}\n226|\treturn formatted, nil\n227|}\n228|\n229|func decodeMetadata(candidate []byte) (metadata, error) {\n230|\tvar decoded metadata\n231|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n232|\tdecoder.DisallowUnknownFields()\n233|\tif err := decoder.Decode(&decoded); err != nil {\n234|\t\treturn metadata{}, invalid(\"decode metadata: %v\", err)\n235|\t}\n236|\tvar trailing any\n237|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n238|\t\tif err == nil {\n239|\t\t\treturn metadata{}, invalid(\"multiple JSON values\")\n240|\t\t}\n241|\t\treturn metadata{}, invalid(\"trailing JSON: %v\", err)\n242|\t}\n243|\treturn decoded, nil\n244|}\n245|\n246|func validateMetadata(value metadata, manifest specpin.Manifest) error {\n247|\tif value.Format != metadataFormat || value.FormatVersion != metadataFormatVersion {\n248|\t\treturn invalid(\"unsupported format %q version %d\", value.Format, value.FormatVersion)\n249|\t}\n250|\tif value.Source.Repository != manifest.Source.Repository ||\n251|\t\tvalue.Source.Release != manifest.Source.Release ||\n252|\t\tvalue.Source.Commit != manifest.Source.Commit ||\n253|\t\tvalue.Source.DocumentPath != manifest.Source.Document.Path ||\n254|\t\tvalue.Source.DocumentSHA256 != manifest.Source.Document.SHA256 {\n255|\t\treturn invalid(\"source identity differs from verified normative lock\")\n256|\t}\n257|\tif !equalStrings(value.NormativeScope, manifest.Source.NormativeScope) {\n258|\t\treturn invalid(\"normative scope differs from verified source pin\")\n259|\t}\n260|\tif len(value.OperationFamilies) == 0 || len(value.CapabilityFamilies) == 0 || len(value.EventFamilies) == 0 {\n261|\t\treturn invalid(\"operation, capability, and event catalogs must all be present\")\n262|\t}\n263|\n264|\tcontracts := make(map[string]map[string]struct{})\n265|\tfor _, contract := range manifest.Contracts {\n266|\t\tversions := contracts[contract.ID]\n267|\t\tif versions == nil {\n268|\t\t\tversions = make(map[string]struct{})\n269|\t\t\tcontracts[contract.ID] = versions\n270|\t\t}\n271|\t\tfor _, version := range contract.Versions {\n272|\t\t\tversions[version] = struct{}{}\n273|\t\t}\n274|\t}\n275|\treleaseContracts, err := releaseContractVersions(manifest)\n276|\tif err != nil {\n277|\t\treturn invalid(\"build release contract projections: %v\", err)\n278|\t}\n279|\tif len(value.SelfIdentities) == 0 {\n280|\t\treturn invalid(\"self-identity contract catalog must be present\")\n281|\t}\n282|\tseenSelfIdentities := make(map[string]struct{})\n283|\tfor index, identity := range value.SelfIdentities {\n284|\t\tif err := validateContractBinding(identity.ContractID, identity.ContractVersions, contracts); err != nil {\n285|\t\t\treturn invalid(\"self-identity contract %d: %v\", index, err)\n286|\t\t}\n287|\t\tif err := validateReleases(identity.Releases); err != nil {\n288|\t\t\treturn invalid(\"self-identity contract %d: %v\", index, err)\n289|\t\t}\n290|\t\tif err := validateReleaseBinding(identity.ContractID, identity.ContractVersions, identity.Releases, releaseContracts); err != nil {\n291|\t\t\treturn invalid(\"self-identity contract %d: %v\", index, err)\n292|\t\t}\n293|\t\tif !capabilityPattern.MatchString(identity.SelfField) || identity.NormativeSection == \"\" {\n294|\t\t\treturn invalid(\"self-identity contract %d has invalid self field or normative section\", index)\n295|\t\t}\n296|\t\tif (identity.DiscriminatorName == \"\") != (identity.DiscriminatorValue == \"\") ||\n297|\t\t\t(identity.DiscriminatorName != \"\" && !capabilityPattern.MatchString(identity.DiscriminatorName)) {\n298|\t\t\treturn invalid(\"self-identity contract %d has incomplete or invalid discriminator\", index)\n299|\t\t}\n300|\t\tfor _, version := range identity.ContractVersions {\n301|\t\t\tkey := identity.ContractID + \"\\x00\" + version\n302|\t\t\tif _, duplicate := seenSelfIdentities[key]; duplicate {\n303|\t\t\t\treturn invalid(\"self-identity catalog repeats contract %q version %q\", identity.ContractID, version)\n304|\t\t\t}\n305|\t\t\tseenSelfIdentities[key] = struct{}{}\n306|\t\t}\n307|\t}\n308|\n309|\tseenFamilies := make(map[string]struct{})\n310|\tfor index, family := range value.OperationFamilies {\n311|\t\tif err := validateFamilyHeader(\"operation\", index, family.Family, family.ContractID, family.ContractVersions, family.Releases, family.NormativeSection, family.FixtureFamilies, contracts, releaseContracts, seenFamilies); err != nil {\n312|\t\t\treturn err\n313|\t\t}\n314|\t\tif len(family.Operations) == 0 {\n315|\t\t\treturn invalid(\"operation family %q is empty\", family.Family)\n316|\t\t}\n317|\t\toperationSet, err := uniqueNames(\"operation \"+family.Family, family.Operations, namePattern)\n318|\t\tif err != nil {\n319|\t\t\treturn err\n320|\t\t}\n321|\t\tisolated, err := uniqueNames(\"isolated output \"+family.Family, family.IsolatedOutputs, namePattern)\n322|\t\tif err != nil {\n323|\t\t\treturn err\n324|\t\t}\n325|\t\tfor name := range isolated {\n326|\t\t\tif _, ok := operationSet[name]; !ok {\n327|\t\t\t\treturn invalid(\"operation family %q isolates unknown operation %q\", family.Family, name)\n328|\t\t\t}\n329|\t\t}\n330|\t\tmutations := make(map[string]struct{})\n331|\t\tfor groupIndex, group := range family.MutationGroups {\n332|\t\t\tif len(group.Operations) == 0 || group.IdempotencyKey == \"\" || len(group.RecoveryEvidence) == 0 {\n333|\t\t\t\treturn invalid(\"operation family %q mutation group %d lacks operations, idempotency, or recovery evidence\", family.Family, groupIndex)\n334|\t\t\t}\n335|\t\t\tif hasEmpty(group.RecoveryEvidence) {\n336|\t\t\t\treturn invalid(\"operation family %q mutation group %d has empty recovery evidence\", family.Family, groupIndex)\n337|\t\t\t}\n338|\t\t\tfor _, name := range group.Operations {\n339|\t\t\t\tif _, ok := operationSet[name]; !ok {\n340|\t\t\t\t\treturn invalid(\"operation family %q marks unknown operation %q durable\", family.Family, name)\n341|\t\t\t\t}\n342|\t\t\t\tif _, ok := isolated[name]; ok {\n343|\t\t\t\t\treturn invalid(\"operation family %q operation %q is both isolated and durable\", family.Family, name)\n344|\t\t\t\t}\n345|\t\t\t\tif _, duplicate := mutations[name]; duplicate {\n346|\t\t\t\t\treturn invalid(\"operation family %q repeats durable operation %q\", family.Family, name)\n347|\t\t\t\t}\n348|\t\t\t\tmutations[name] = struct{}{}\n349|\t\t\t}\n350|\t\t}\n351|\t}\n352|\n353|\tseenFamilies = make(map[string]struct{})\n354|\tfor index, family := range value.CapabilityFamilies {\n355|\t\tif err := validateFamilyHeader(\"capability\", index, family.Family, family.ContractID, family.ContractVersions, family.Releases, family.NormativeSection, family.FixtureFamilies, contracts, releaseContracts, seenFamilies); err != nil {\n356|\t\t\treturn err\n357|\t\t}\n358|\t\tif len(family.Capabilities) == 0 {\n359|\t\t\treturn invalid(\"capability family %q is empty\", family.Family)\n360|\t\t}\n361|\t\tif _, err := uniqueNames(\"capability \"+family.Family, family.Capabilities, capabilityPattern); err != nil {\n362|\t\t\treturn err\n363|\t\t}\n364|\t}\n365|\n366|\tseenFamilies = make(map[string]struct{})\n367|\tfor index, family := range value.EventFamilies {\n368|\t\tif family.Family == \"\" || family.ContractID == \"\" || family.NormativeSection == \"\" || len(family.FixtureFamilies) == 0 {\n369|\t\t\treturn invalid(\"event family %d has incomplete header\", index)\n370|\t\t}\n371|\t\tif _, duplicate := seenFamilies[family.Family]; duplicate {\n372|\t\t\treturn invalid(\"duplicate event family %q\", family.Family)\n373|\t\t}\n374|\t\tseenFamilies[family.Family] = struct{}{}\n375|\t\tif err := validateReleases(family.Releases); err != nil {\n376|\t\t\treturn invalid(\"event family %q: %v\", family.Family, err)\n377|\t\t}\n378|\t\tseenEvents := make(map[string]struct{})\n379|\t\tif len(family.Groups) == 0 {\n380|\t\t\treturn invalid(\"event family %q is empty\", family.Family)\n381|\t\t}\n382|\t\tfor groupIndex, group := range family.Groups {\n383|\t\t\tif err := validateContractBinding(family.ContractID, group.ContractVersions, contracts); err != nil {\n384|\t\t\t\treturn invalid(\"event family %q group %d: %v\", family.Family, groupIndex, err)\n385|\t\t\t}\n386|\t\t\tif err := validateReleaseBinding(family.ContractID, group.ContractVersions, family.Releases, releaseContracts); err != nil {\n387|\t\t\t\treturn invalid(\"event family %q group %d: %v\", family.Family, groupIndex, err)\n388|\t\t\t}\n389|\t\t\tif len(group.Events) == 0 {\n390|\t\t\t\treturn invalid(\"event family %q group %d is empty\", family.Family, groupIndex)\n391|\t\t\t}\n392|\t\t\tfor _, name := range group.Events {\n393|\t\t\t\tif !namePattern.MatchString(name) {\n394|\t\t\t\t\treturn invalid(\"event family %q has invalid event %q\", family.Family, name)\n395|\t\t\t\t}\n396|\t\t\t\tif _, duplicate := seenEvents[name]; duplicate {\n397|\t\t\t\t\treturn invalid(\"event family %q repeats event %q\", family.Family, name)\n398|\t\t\t\t}\n399|\t\t\t\tseenEvents[name] = struct{}{}\n400|\t\t\t}\n401|\t\t}\n402|\t}\n403|\n404|\tif value.ErrorCatalog.ContractID == \"\" || value.ErrorCatalog.NormativeSection == \"\" || len(value.ErrorCatalog.FixtureFamilies) == 0 {\n405|\t\treturn invalid(\"error catalog has incomplete header\")\n406|\t}\n407|\tif err := validateContractBinding(value.ErrorCatalog.ContractID, value.ErrorCatalog.ContractVersions, contracts); err != nil {\n408|\t\treturn invalid(\"error catalog: %v\", err)\n409|\t}\n410|\tversionIndex := make(map[string]int, len(value.ErrorCatalog.ContractVersions))\n411|\tfor index, version := range value.ErrorCatalog.ContractVersions {\n412|\t\tversionIndex[version] = index\n413|\t}\n414|\tif len(value.ErrorCatalog.Groups) != len(value.ErrorCatalog.ContractVersions) {\n415|\t\treturn invalid(\"error catalog must define one introduced-code group per contract version\")\n416|\t}\n417|\tseenCodes := make(map[string]struct{})\n418|\tfor groupIndex, group := range value.ErrorCatalog.Groups {\n419|\t\tif group.IntroducedVersion != value.ErrorCatalog.ContractVersions[groupIndex] {\n420|\t\t\treturn invalid(\"error group %d is not the ordered contract version %q\", groupIndex, value.ErrorCatalog.ContractVersions[groupIndex])\n421|\t\t}\n422|\t\tif _, ok := versionIndex[group.IntroducedVersion]; !ok {\n423|\t\t\treturn invalid(\"error group %d introduces unsupported version %q\", groupIndex, group.IntroducedVersion)\n424|\t\t}\n425|\t\tif err := validateReleases(group.Releases); err != nil {\n426|\t\t\treturn invalid(\"error group %d: %v\", groupIndex, err)\n427|\t\t}\n428|\t\tintroducedVersions := value.ErrorCatalog.ContractVersions[versionIndex[group.IntroducedVersion]:]\n429|\t\tif err := validateReleaseBinding(value.ErrorCatalog.ContractID, introducedVersions, group.Releases, releaseContracts); err != nil {\n430|\t\t\treturn invalid(\"error group %d: %v\", groupIndex, err)\n431|\t\t}\n432|\t\tif len(group.Mappings) == 0 {\n433|\t\t\treturn invalid(\"error group %d is empty\", groupIndex)\n434|\t\t}\n435|\t\tfor _, mapping := range group.Mappings {\n436|\t\t\tif mapping.ExitCode <= 0 || len(mapping.Codes) == 0 {\n437|\t\t\t\treturn invalid(\"error group %d has invalid exit mapping\", groupIndex)\n438|\t\t\t}\n439|\t\t\tfor _, code := range mapping.Codes {\n440|\t\t\t\tif !errorPattern.MatchString(code) {\n441|\t\t\t\t\treturn invalid(\"invalid error code %q\", code)\n442|\t\t\t\t}\n443|\t\t\t\tif _, duplicate := seenCodes[code]; duplicate {\n444|\t\t\t\t\treturn invalid(\"duplicate error code %q\", code)\n445|\t\t\t\t}\n446|\t\t\t\tseenCodes[code] = struct{}{}\n447|\t\t\t}\n448|\t\t}\n449|\t}\n450|\tcanonical, err := json.Marshal(value)\n451|\tif err != nil {\n452|\t\treturn invalid(\"encode canonical metadata: %v\", err)\n453|\t}\n454|\tdigest := sha256.Sum256(canonical)\n455|\tgotDigest := hex.EncodeToString(digest[:])\n456|\tif gotDigest != reviewedMetadataCanonicalSHA256 {\n457|\t\treturn invalid(\"metadata projection digest %s differs from reviewed %s\", gotDigest, reviewedMetadataCanonicalSHA256)\n458|\t}\n459|\treturn nil\n460|}\n461|\n462|func validateFamilyHeader(kind string, index int, family, contractID string, versions, releases []string, section string, fixtures []string, contracts map[string]map[string]struct{}, releaseContracts map[string]map[string]map[string]struct{}, seen map[string]struct{}) error {\n463|\tif family == \"\" || contractID == \"\" || section == \"\" || len(fixtures) == 0 {\n464|\t\treturn invalid(\"%s family %d has incomplete header\", kind, index)\n465|\t}\n466|\tif _, duplicate := seen[family]; duplicate {\n467|\t\treturn invalid(\"duplicate %s family %q\", kind, family)\n468|\t}\n469|\tseen[family] = struct{}{}\n470|\tif err := validateContractBinding(contractID, versions, contracts); err != nil {\n471|\t\treturn invalid(\"%s family %q: %v\", kind, family, err)\n472|\t}\n473|\tif err := validateReleases(releases); err != nil {\n474|\t\treturn invalid(\"%s family %q: %v\", kind, family, err)\n475|\t}\n476|\tif err := validateReleaseBinding(contractID, versions, releases, releaseContracts); err != nil {\n477|\t\treturn invalid(\"%s family %q: %v\", kind, family, err)\n478|\t}\n479|\tif hasEmpty(fixtures) {\n480|\t\treturn invalid(\"%s family %q has empty fixture reference\", kind, family)\n481|\t}\n482|\treturn nil\n483|}\n484|\n485|func releaseContractVersions(manifest specpin.Manifest) (map[string]map[string]map[string]struct{}, error) {\n486|\tresult := make(map[string]map[string]map[string]struct{}, 3)\n487|\tfor _, release := range []string{specpin.ReleaseV043, specpin.ReleaseV050, specpin.ReleaseV060} {\n488|\t\tcontracts, err := manifest.ContractsForRelease(release)\n489|\t\tif err != nil {\n490|\t\t\treturn nil, err\n491|\t\t}\n492|\t\tbyID := make(map[string]map[string]struct{})\n493|\t\tfor _, contract := range contracts {\n494|\t\t\tversions := byID[contract.ID]\n495|\t\t\tif versions == nil {\n496|\t\t\t\tversions = make(map[string]struct{})\n497|\t\t\t\tbyID[contract.ID] = versions\n498|\t\t\t}\n499|\t\t