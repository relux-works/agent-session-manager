{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cb","stream":{"kind":"session","id":"01a0adf6-85aa-70c2-bc58-c12e2d2660fd"},"sequence":192,"recorded_at":1780531400000379,"record_type":"event","durability":"durable","causation_id":"fd38f806-c210-492a-8285-9e843f4a64a5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"fd38f806-c210-492a-8285-9e843f4a64a5","run_stream":{"kind":"run","id":"fd38f806-c210-492a-8285-9e843f4a64a5"},"task_stream":{"kind":"task","id":"01a0adf6-ef4e-72e1-9458-c689137e64f6"},"task_id":"01a0adf6-ef4e-72e1-9458-c689137e64f6","event":{"kind":"output","task_id":"01a0adf6-ef4e-72e1-9458-c689137e64f6","chunk":"Read text file `internal/catalog/cmd/cataloggen/main_test.go`.\n1|package main\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|)\n12|\n13|func TestRunGeneratesCommittedCatalogAndSupportsIdenticalRetry(t *testing.T) {\n14|\tt.Parallel()\n15|\n16|\toutput := filepath.Join(t.TempDir(), \"catalog_gen.go\")\n17|\targuments := []string{\n18|\t\t\"-metadata\", filepath.Join(\"..\", \"..\", \"catalog.v0.6.0.json\"),\n19|\t\t\"-contracts\", filepath.Join(\"..\", \"..\", \"..\", \"specpin\", \"v0.6.0.lock.json\"),\n20|\t\t\"-output\", output,\n21|\t}\n22|\tif err := run(arguments); err != nil {\n23|\t\tt.Fatalf(\"first run() error = %v\", err)\n24|\t}\n25|\tgot, err := os.ReadFile(output)\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"read run output: %v\", err)\n28|\t}\n29|\twant, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"catalog_gen.go\"))\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"read committed catalog: %v\", err)\n32|\t}\n33|\tif !bytes.Equal(got, want) {\n34|\t\tt.Fatal(\"run output differs from committed generated catalog\")\n35|\t}\n36|\tif err := run(append(append([]string(nil), arguments...), \"-check\")); err != nil {\n37|\t\tt.Fatalf(\"check run() error = %v\", err)\n38|\t}\n39|\n40|\tstableTime := time.Unix(1_700_000_000, 0)\n41|\tif err := os.Chtimes(output, stableTime, stableTime); err != nil {\n42|\t\tt.Fatalf(\"set stable run output time: %v\", err)\n43|\t}\n44|\tif err := run(arguments); err != nil {\n45|\t\tt.Fatalf(\"identical retry run() error = %v\", err)\n46|\t}\n47|\tinfo, err := os.Stat(output)\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"stat run output: %v\", err)\n50|\t}\n51|\tif !info.ModTime().Equal(stableTime) {\n52|\t\tt.Fatalf(\"identical run retry replaced output: modtime = %v, want %v\", info.ModTime(), stableTime)\n53|\t}\n54|}\n55|\n56|func TestRunCheckRefusesStaleOutputWithoutRewritingIt(t *testing.T) {\n57|\tt.Parallel()\n58|\n59|\toutput := filepath.Join(t.TempDir(), \"catalog_gen.go\")\n60|\tstale := []byte(\"package catalog\\n\\n// stale\\n\")\n61|\tif err := os.WriteFile(output, stale, 0o600); err != nil {\n62|\t\tt.Fatalf(\"write stale output: %v\", err)\n63|\t}\n64|\targuments := []string{\n65|\t\t\"-metadata\", filepath.Join(\"..\", \"..\", \"catalog.v0.6.0.json\"),\n66|\t\t\"-contracts\", filepath.Join(\"..\", \"..\", \"..\", \"specpin\", \"v0.6.0.lock.json\"),\n67|\t\t\"-output\", output,\n68|\t\t\"-check\",\n69|\t}\n70|\terr := run(arguments)\n71|\tif err == nil || !strings.Contains(err.Error(), \"generated catalog is stale\") {\n72|\t\tt.Fatalf(\"check run() error = %v, want stale-output refusal\", err)\n73|\t}\n74|\tgot, readErr := os.ReadFile(output)\n75|\tif readErr != nil {\n76|\t\tt.Fatalf(\"read stale output after refusal: %v\", readErr)\n77|\t}\n78|\tif !bytes.Equal(got, stale) {\n79|\t\tt.Fatal(\"check run rewrote stale output\")\n80|\t}\n81|}\n82|\n83|func TestRunRefusesInvalidArgumentsInputsAndOutput(t *testing.T) {\n84|\tt.Parallel()\n85|\n86|\tmetadata := filepath.Join(\"..\", \"..\", \"catalog.v0.6.0.json\")\n87|\tcontracts := filepath.Join(\"..\", \"..\", \"..\", \"specpin\", \"v0.6.0.lock.json\")\n88|\ttests := []struct {\n89|\t\tname      string\n90|\t\targuments func(string) []string\n91|\t\tcontains  string\n92|\t}{\n93|\t\t{name: \"missing flags\", arguments: func(string) []string { return nil }, contains: \"required\"},\n94|\t\t{name: \"unknown flag\", arguments: func(string) []string { return []string{\"-unknown\"} }, contains: \"flag provided but not defined\"},\n95|\t\t{name: \"missing metadata\", arguments: func(output string) []string {\n96|\t\t\treturn []string{\"-metadata\", filepath.Join(t.TempDir(), \"absent.json\"), \"-contracts\", contracts, \"-output\", output}\n97|\t\t}, contains: \"read metadata\"},\n98|\t\t{name: \"missing contracts\", arguments: func(output string) []string {\n99|\t\t\treturn []string{\"-metadata\", metadata, \"-contracts\", filepath.Join(t.TempDir(), \"absent.json\"), \"-output\", output}\n100|\t\t}, contains: \"read contract lock\"},\n101|\t\t{name: \"invalid metadata\", arguments: func(output string) []string {\n102|\t\t\tinvalid := filepath.Join(t.TempDir(), \"invalid.json\")\n103|\t\t\tif err := os.WriteFile(invalid, []byte(\"{}\"), 0o600); err != nil {\n104|\t\t\t\tt.Fatalf(\"write invalid metadata: %v\", err)\n105|\t\t\t}\n106|\t\t\treturn []string{\"-metadata\", invalid, \"-contracts\", contracts, \"-output\", output}\n107|\t\t}, contains: \"generate catalog\"},\n108|\t\t{name: \"unwritable output\", arguments: func(output string) []string {\n109|\t\t\tif err := os.Mkdir(output, 0o755); err != nil {\n110|\t\t\t\tt.Fatalf(\"create output directory: %v\", err)\n111|\t\t\t}\n112|\t\t\treturn []string{\"-metadata\", metadata, \"-contracts\", contracts, \"-output\", output}\n113|\t\t}, contains: \"write catalog\"},\n114|\t}\n115|\tfor _, test := range tests {\n116|\t\tt.Run(test.name, func(t *testing.T) {\n117|\t\t\toutput := filepath.Join(t.TempDir(), \"catalog_gen.go\")\n118|\t\t\terr := run(test.arguments(output))\n119|\t\t\tif err == nil || !strings.Contains(err.Error(), test.contains) {\n120|\t\t\t\tt.Fatalf(\"run() error = %v, want containing %q\", err, test.contains)\n121|\t\t\t}\n122|\t\t})\n123|\t}\n124|}\n125|\n126|func TestWriteIfChangedPublishesAtomicallyAndSkipsIdenticalRetry(t *testing.T) {\n127|\tt.Parallel()\n128|\n129|\tpath := filepath.Join(t.TempDir(), \"catalog_gen.go\")\n130|\twant := []byte(\"package catalog\\n\")\n131|\tif err := writeIfChanged(path, want); err != nil {\n132|\t\tt.Fatalf(\"first writeIfChanged() error = %v\", err)\n133|\t}\n134|\tgot, err := os.ReadFile(path)\n135|\tif err != nil {\n136|\t\tt.Fatalf(\"read generated output: %v\", err)\n137|\t}\n138|\tif string(got) != string(want) {\n139|\t\tt.Fatalf(\"generated output = %q, want %q\", got, want)\n140|\t}\n141|\n142|\tstableTime := time.Unix(1_700_000_000, 0)\n143|\tif err := os.Chtimes(path, stableTime, stableTime); err != nil {\n144|\t\tt.Fatalf(\"set stable output time: %v\", err)\n145|\t}\n146|\tif err := writeIfChanged(path, want); err != nil {\n147|\t\tt.Fatalf(\"identical retry writeIfChanged() error = %v\", err)\n148|\t}\n149|\tinfo, err := os.Stat(path)\n150|\tif err != nil {\n151|\t\tt.Fatalf(\"stat generated output: %v\", err)\n152|\t}\n153|\tif !info.ModTime().Equal(stableTime) {\n154|\t\tt.Fatalf(\"identical retry replaced output: modtime = %v, want %v\", info.ModTime(), stableTime)\n155|\t}\n156|}\n157|\n158|func TestWriteIfChangedRefusesUnreadableDestinationWithoutReplacement(t *testing.T) {\n159|\tt.Parallel()\n160|\n161|\tdestination := filepath.Join(t.TempDir(), \"catalog_gen.go\")\n162|\tif err := os.Mkdir(destination, 0o755); err != nil {\n163|\t\tt.Fatalf(\"create destination directory: %v\", err)\n164|\t}\n165|\tif err := writeIfChanged(destination, []byte(\"replacement\")); err == nil {\n166|\t\tt.Fatal(\"writeIfChanged() error = nil, want unreadable-destination refusal\")\n167|\t}\n168|\tinfo, err := os.Stat(destination)\n169|\tif err != nil {\n170|\t\tt.Fatalf(\"stat destination after refusal: %v\", err)\n171|\t}\n172|\tif !info.IsDir() {\n173|\t\tt.Fatal(\"failed write replaced the original destination\")\n174|\t}\n175|}\n176|\n177|// Drive the command taken from the CR configuration through the real CLI entry.\n178|// A recognizable generator token alone cannot prove its selected authority.\n179|func TestConfiguredCRCatalogGateConsumesAdoptedAuthority(t *testing.T) {\n180|\troot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n181|\tdata, err := os.ReadFile(filepath.Join(root, \"task-board.config.json\"))\n182|\tif err != nil {\n183|\t\tt.Fatal(err)\n184|\t}\n185|\tvar config struct {\n186|\t\tSpawn struct {\n187|\t\t\tWorktreeIsolation struct {\n188|\t\t\t\tValidation struct {\n189|\t\t\t\t\tCommands []string `json:\"commands\"`\n190|\t\t\t\t} `json:\"validation\"`\n191|\t\t\t} `json:\"worktree_isolation\"`\n192|\t\t} `json:\"spawn\"`\n193|\t}\n194|\tif err := json.Unmarshal(data, &config); err != nil {\n195|\t\tt.Fatal(err)\n196|\t}\n197|\tvar commands []string\n198|\tfor _, command := range config.Spawn.WorktreeIsolation.Validation.Commands {\n199|\t\tif strings.Contains(command, \"./internal/catalog/cmd/cataloggen\") {\n200|\t\t\tcommands = append(commands, command)\n201|\t\t}\n202|\t}\n203|\tif len(commands) != 1 {\n204|\t\tt.Fatalf(\"configured catalog gates = %d, want exactly 1\", len(commands))\n205|\t}\n206|\tfields := strings.Fields(commands[0])\n207|\tif len(fields) != 10 || strings.Join(fields[:3], \" \") != \"go run ./internal/catalog/cmd/cataloggen\" || fields[9] != \"-check\" {\n208|\t\tt.Fatalf(\"unexpected gate command shape: %q\", commands[0])\n209|\t}\n210|\targs := append([]string(nil), fields[3:]...)\n211|\tfor i := 1; i < 6; i += 2 {\n212|\t\targs[i] = filepath.Join(root, args[i])\n213|\t}\n214|\tif err := run(args); err != nil {\n215|\t\tt.Fatalf(\"configured cataloggen run: %v\", err)\n216|\t}\n217|\tstale := append([]string(nil), args...)\n218|\tstale[1] = strings.ReplaceAll(stale[1], \"v0.6.0\", \"v0.5.0\")\n219|\tstale[3] = strings.ReplaceAll(stale[3], \"v0.6.0\", \"v0.5.0\")\n220|\tif err := run(stale); err == nil || !strings.Contains(err.Error(), \"verify normative lock\") {\n221|\t\tt.Fatalf(\"stale configured cataloggen run = %v, want normative-lock refusal\", err)\n222|\t}\n223|}\n224|\n225|func TestGenerateDirectiveConsumesAdoptedAuthority(t *testing.T) {\n226|\tdata, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"catalog.go\"))\n227|\tif err != nil {\n228|\t\tt.Fatal(err)\n229|\t}\n230|\tvar directives []string\n231|\tfor _, line := range strings.Split(string(data), \"\\n\") {\n232|\t\tif strings.HasPrefix(line, \"//go:generate \") {\n233|\t\t\tdirectives = append(directives, strings.TrimPrefix(line, \"//go:generate \"))\n234|\t\t}\n235|\t}\n236|\tif len(directives) != 1 {\n237|\t\tt.Fatalf(\"active directives = %d, want 1\", len(directives))\n238|\t}\n239|\tfields := strings.Fields(directives[0])\n240|\tif len(fields) != 9 || strings.Join(fields[:3], \" \") != \"go run ./cmd/cataloggen\" {\n241|\t\tt.Fatalf(\"unexpected directive: %q\", directives[0])\n242|\t}\n243|\targs := append([]string(nil), fields[3:]...)\n244|\tfor i := 1; i < 6; i += 2 {\n245|\t\targs[i] = filepath.Join(\"..\", \"..\", args[i])\n246|\t}\n247|\t// Check mode drives the same Generate entry without writing the source tree.\n248|\tif err := run(append(args, \"-check\")); err != nil {\n249|\t\tt.Fatalf(\"directive cataloggen run: %v\", err)\n250|\t}\n251|}","final_result":true}}}
