{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb35","stream":{"kind":"session","id":"01a0ae20-8568-7b60-9562-eee7c66138af"},"sequence":1013,"recorded_at":1780531400002021,"record_type":"event","durability":"durable","causation_id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa","run_stream":{"kind":"run","id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa"},"task_stream":{"kind":"task","id":"01a0ae2c-b999-7f73-a706-208094224f8f"},"task_id":"01a0ae2c-b999-7f73-a706-208094224f8f","event":{"kind":"output","task_id":"01a0ae2c-b999-7f73-a706-208094224f8f","chunk":"{\n  \"chunk_id\": \"exec-40-1\",\n  \"command\": \"sed -n 1,120p /Users/iv/Developer/ReluxWorks/skill-project-management/tools/board-cli/internal/integration/reviewed_suite.go; echo \\\"=====VALIDATION.GO=====\\\"; grep -n \\\"SuiteChanged\\\\|suite_sha256\\\\|SuiteSha\\\\|configured suite\\\\|candidate.*suite\\\\|control.*root.*suite\\\" /Users/iv/Developer/ReluxWorks/skill-project-management/tools/board-cli/internal/integration/validation.go | head -n 30\",\n  \"description\": \"Read suite-guard logic\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package integration\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"strings\\\"\\n\\n\\t\\\"github.com/aagrigore/task-board/internal/changerequest\\\"\\n\\t\\\"github.com/relux-works/skill-project-management/pkg/remoteconfig\\\"\\n)\\n\\n// selectReviewedValidationSuite recognizes a reviewed change to the policy\\n// source itself. The old suite must still be authoritative on the control side,\\n// and the new suite must be precisely the one proven on the accepted tree.\\n// It never loads signing, authority, spawn or board policy from the candidate.\\nfunc (s *session) selectReviewedValidationSuite(record *changerequest.Record) error {\\n\\tif record.Validation == nil || record.Validation.SuiteSHA256 == s.req.ValidationSuiteSHA {\\n\\t\\treturn nil\\n\\t}\\n\\trefuse := func() error {\\n\\t\\treturn newError(ErrorValidationSuiteChanged, \\\"validation suite drift is not an exact reviewed change of its configured source\\\", nil)\\n\\t}\\n\\tif record.State != changerequest.StateAccepted || record.Validation.ExitStatus != 0 {\\n\\t\\treturn refuse()\\n\\t}\\n\\tpath := s.req.ValidationConfigPath\\n\\tif path == \\\"\\\" {\\n\\t\\treturn refuse()\\n\\t}\\n\\trel, err := filepath.Rel(s.req.ControlRoot, path)\\n\\tif err != nil || filepath.IsAbs(rel) || rel == \\\"..\\\" || strings.HasPrefix(rel, \\\"..\\\"+string(filepath.Separator)) {\\n\\t\\treturn refuse()\\n\\t}\\n\\trel = filepath.ToSlash(rel)\\n\\tchanged := false\\n\\tfor _, p := range record.ChangedPaths {\\n\\t\\tif p == rel {\\n\\t\\t\\tchanged = true\\n\\t\\t}\\n\\t}\\n\\tif !changed {\\n\\t\\treturn refuse()\\n\\t}\\n\\tread := func(rev string) ([]byte, error) {\\n\\t\\t// Symlinks and trees cannot masquerade as the reviewed config file.\\n\\t\\tentry, err := s.g.run(\\\"ls-tree\\\", rev, \\\"--\\\", rel)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tif !strings.HasPrefix(entry, \\\"100644 blob \\\") && !strings.HasPrefix(entry, \\\"100755 blob \\\") {\\n\\t\\t\\treturn nil, refuse()\\n\\t\\t}\\n\\t\\tdata, present, err := s.g.at(rev).headBlob(rel)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t\\tif !present {\\n\\t\\t\\treturn nil, refuse()\\n\\t\\t}\\n\\t\\treturn data, nil\\n\\t}\\n\\tbase, err := read(record.BaseOID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tcandidate, err := read(record.CandidateTreeOID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\t// After a durable reparent the tree binding is intentionally broken until\\n\\t// revalidation. Only an unchanged reviewed config blob can retain the\\n\\t// accepted suite; the ordinary tree gate still forces actual execution.\\n\\tevidenceConfig, err := read(record.Validation.TreeOID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif !bytes.Equal(evidenceConfig, candidate) {\\n\\t\\treturn refuse()\\n\\t}\\n\\tif bytes.Equal(base, candidate) {\\n\\t\\treturn refuse()\\n\\t}\\n\\toldSuite, oldProfile, err := remoteconfig.ParseWorktreeValidation(path, base)\\n\\tif err != nil || oldSuite == nil || oldSuite.SuiteSHA256() != s.req.ValidationSuiteSHA {\\n\\t\\treturn refuse()\\n\\t}\\n\\tnewSuite, newProfile, err := remoteconfig.ParseWorktreeValidation(path, candidate)\\n\\tif err != nil || newSuite == nil || newProfile != oldProfile || newSuite.SuiteSHA256() != record.Validation.SuiteSHA256 {\\n\\t\\treturn refuse()\\n\\t}\\n\\tif record.Validation.SuiteID != newProfile+\\\".worktree_isolation.validation.commands\\\" {\\n\\t\\treturn refuse()\\n\\t}\\n\\ts.req.ValidationCommands = append([]string(nil), newSuite.Commands...)\\n\\ts.req.ValidationSuiteSHA = newSuite.SuiteSHA256()\\n\\treturn nil\\n}\\n=====VALIDATION.GO=====\\n31:// configured suite, which is a recorded decision rather than an absent one.\\n70:\\t\\treturn newError(ErrorValidationSuiteChanged,\\n73:\\t\\t\\t\\t\\\"evidence_suite_sha256\\\":   validation.SuiteSHA256,\\n74:\\t\\t\\t\\t\\\"configured_suite_sha256\\\": configuredSuiteSHA256,\\n\",\n  \"original_output_bytes\": 3404,\n  \"original_output_tokens\": 851,\n  \"truncated\": false\n}","final_result":true}}}
