licitMetadata {' 'TestRunAdoptedRefusesMixedAndMissingInputs/mixed_contracts'\\nplant N5 'if lock.Source.Release != string(catalog.Adopted) {' 'if lock.Source.Release != \\\"v0.5.0\\\" {' 'TestRunAdoptedRefusesLockReleaseMismatch'\\nplant N6 '\\\"catalog.\\\"+string(catalog.Adopted)+\\\".json\\\"' '\\\"catalog.v0.5.0.json\\\"' 'TestRunAdoptedIsByteIdenticalToExplicit'\\nplant N7 'if !bytes.Equal(existing, content) {' 'if len(existing) != len(content) {' 'TestRunAdoptedCheckRefusesStaleOutput'\\nrestore\\ntrap - EXIT\\ndiff -q \\\"$TARGET\\\" \\\"$BACKUP\\\" && echo \\\"restored-ok\\\"\\nEOS\\nchmod +x /tmp/rerun_killed_twice.sh\\nbash /tmp/rerun_killed_twice.sh 2>&1 | tee /tmp/revidence/logs/rerun-twice.log\",\n  \"description\": \"Rerun subset of kills twice deterministically\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"N1 run1 exit=1 mask=TestRunAdoptedRefusesMixedAndMissingInputs/mixed_metadata\\nN1 run2 exit=1 mask=TestRunAdoptedRefusesMixedAndMissingInputs/mixed_metadata\\nN2 run1 exit=1 mask=TestRunAdoptedRefusesMixedAndMissingInputs/mixed_contracts\\nN2 run2 exit=1 mask=TestRunAdoptedRefusesMixedAndMissingInputs/mixed_contracts\\nN5 run1 exit=1 mask=TestRunAdoptedRefusesLockReleaseMismatch\\nN5 run2 exit=1 mask=TestRunAdoptedRefusesLockReleaseMismatch\\nN6 run1 exit=1 mask=TestRunAdoptedIsByteIdenticalToExplicit\\nN6 run2 exit=1 mask=TestRunAdoptedIsByteIdenticalToExplicit\\nN7 run1 exit=1 mask=TestRunAdoptedCheckRefusesStaleOutput\\nN7 run2 exit=1 mask=TestRunAdoptedCheckRefusesStaleOutput\\nrestored-ok\\n\",\n  \"original_output_bytes\": 684,\n  \"original_output_tokens\": 171,\n  \"truncated\": false\n}","final_result":true}}}
