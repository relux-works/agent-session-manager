{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c563","stream":{"kind":"session","id":"01a0ae20-8568-7b60-9562-eee7c66138af"},"sequence":268,"recorded_at":1780531400000531,"record_type":"event","durability":"durable","causation_id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa","run_stream":{"kind":"run","id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa"},"task_stream":{"kind":"task","id":"01a0ae21-329c-74c0-b139-907fa7ec050b"},"task_id":"01a0ae21-329c-74c0-b139-907fa7ec050b","event":{"kind":"output","task_id":"01a0ae21-329c-74c0-b139-907fa7ec050b","chunk":"Read text file `internal/catalog/cmd/cataloggen/main.go`.\n1|package main\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"flag\"\n7|\t\"fmt\"\n8|\t\"io\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n14|)\n15|\n16|func main() {\n17|\tif err := run(os.Args[1:]); err != nil {\n18|\t\tfmt.Fprintln(os.Stderr, err)\n19|\t\tos.Exit(1)\n20|\t}\n21|}\n22|\n23|func run(arguments []string) error {\n24|\tflags := flag.NewFlagSet(\"cataloggen\", flag.ContinueOnError)\n25|\tflags.SetOutput(io.Discard)\n26|\tmetadataPath := flags.String(\"metadata\", \"\", \"reviewed catalog metadata JSON\")\n27|\tcontractsPath := flags.String(\"contracts\", \"\", \"verified normative contract lock\")\n28|\toutputPath := flags.String(\"output\", \"\", \"generated Go output\")\n29|\tcheck := flags.Bool(\"check\", false, \"verify generated Go output without rewriting it\")\n30|\tadopted := flags.Bool(\"adopted\", false, \"derive metadata and contract lock from the adopted release\")\n31|\troot := flags.String(\"root\", \".\", \"repository root the adopted inputs are resolved against\")\n32|\tif err := flags.Parse(arguments); err != nil {\n33|\t\treturn err\n34|\t}\n35|\tif *adopted {\n36|\t\treturn runAdopted(*root, *outputPath, *check, *metadataPath != \"\", *contractsPath != \"\")\n37|\t}\n38|\tif *metadataPath == \"\" || *contractsPath == \"\" || *outputPath == \"\" {\n39|\t\treturn fmt.Errorf(\"-metadata, -contracts, and -output are required\")\n40|\t}\n41|\n42|\tmetadata, err := os.ReadFile(*metadataPath)\n43|\tif err != nil {\n44|\t\treturn fmt.Errorf(\"read metadata: %w\", err)\n45|\t}\n46|\tcontracts, err := os.ReadFile(*contractsPath)\n47|\tif err != nil {\n48|\t\treturn fmt.Errorf(\"read contract lock: %w\", err)\n49|\t}\n50|\tgenerated, err := cataloggen.Generate(metadata, contracts)\n51|\tif err != nil {\n52|\t\treturn fmt.Errorf(\"generate catalog: %w\", err)\n53|\t}\n54|\tif *check {\n55|\t\tif err := checkUnchanged(*outputPath, generated); err != nil {\n56|\t\t\treturn fmt.Errorf(\"check catalog: %w\", err)\n57|\t\t}\n58|\t\treturn nil\n59|\t}\n60|\tif err := writeIfChanged(*outputPath, generated); err != nil {\n61|\t\treturn fmt.Errorf(\"write catalog: %w\", err)\n62|\t}\n63|\treturn nil\n64|}\n65|\n66|// runAdopted derives the catalog metadata and normative lock inputs from the\n67|// code-level adopted release and otherwise behaves exactly like the explicit\n68|// invocation: same Generate call, same -check/-output semantics.\n69|func runAdopted(root, output string, check, explicitMetadata, explicitContracts bool) error {\n70|\tif explicitMetadata || explicitContracts {\n71|\t\treturn fmt.Errorf(\"-adopted cannot be combined with -metadata or -contracts\")\n72|\t}\n73|\tif output == \"\" {\n74|\t\treturn fmt.Errorf(\"-output is required with -adopted\")\n75|\t}\n76|\tmetadataPath := filepath.Join(root, \"internal\", \"catalog\", \"catalog.\"+string(catalog.Adopted)+\".json\")\n77|\tcontractsPath := filepath.Join(root, \"internal\", \"specpin\", string(catalog.Adopted)+\".lock.json\")\n78|\n79|\tmetadata, err := os.ReadFile(metadataPath)\n80|\tif err != nil {\n81|\t\treturn fmt.Errorf(\"read adopted metadata %q: %w\", metadataPath, err)\n82|\t}\n83|\tcontracts, err := os.ReadFile(contractsPath)\n84|\tif err != nil {\n85|\t\treturn fmt.Errorf(\"read adopted contract lock %q: %w\", contractsPath, err)\n86|\t}\n87|\tif err := checkAdoptedLockRelease(contracts); err != nil {\n88|\t\treturn err\n89|\t}\n90|\tgenerated, err := cataloggen.Generate(metadata, contracts)\n91|\tif err != nil {\n92|\t\treturn fmt.Errorf(\"generate catalog: %w\", err)\n93|\t}\n94|\tif check {\n95|\t\tif err := checkUnchanged(output, generated); err != nil {\n96|\t\t\treturn fmt.Errorf(\"check catalog: %w\", err)\n97|\t\t}\n98|\t\treturn nil\n99|\t}\n100|\tif err := writeIfChanged(output, generated); err != nil {\n101|\t\treturn fmt.Errorf(\"write catalog: %w\", err)\n102|\t}\n103|\treturn nil\n104|}\n105|\n106|// adoptedLockRelease extracts the source release claim of a contract lock\n107|// without verifying it; verification stays the job of Generate.\n108|type adoptedLockRelease struct {\n109|\tSource struct {\n110|\t\tRelease string `json:\"release\"`\n111|\t} `json:\"source\"`\n112|}\n113|\n114|// checkAdoptedLockRelease refuses a lock whose source release differs from\n115|// the adopted release before generation. A lock that does not even decode\n116|// falls through to Generate, which reports the verification failure.\n117|func checkAdoptedLockRelease(contracts []byte) error {\n118|\tvar lock adoptedLockRelease\n119|\tif err := json.Unmarshal(contracts, &lock); err != nil {\n120|\t\treturn nil\n(more lines below)","final_result":true}}}
