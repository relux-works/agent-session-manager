{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56f","stream":{"kind":"session","id":"01a0ae20-8568-7b60-9562-eee7c66138af"},"sequence":274,"recorded_at":1780531400000543,"record_type":"event","durability":"durable","causation_id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa","run_stream":{"kind":"run","id":"298248eb-2a9d-4aad-8474-d54f3cbb9bfa"},"call_id":"call_01a0ae212dfe75749b675e309fd5a87b","text":"Read text file `internal/catalog/catalog.go`.\n1|// Package catalog exposes generated, typed vocabularies from the reviewed AX\n2|// implementation metadata. Catalog membership defines a contract vocabulary;\n3|// it never advertises runtime availability or implementation support.\n4|package catalog\n5|\n6|import (\n7|\t\"errors\"\n8|\t\"fmt\"\n9|)\n10|\n11|const (\n12|\tFormat        = \"ax-implementation-catalog\"\n13|\tFormatVersion = 1\n14|\n15|\tReleaseV043 Release = \"v0.4.3\"\n16|\tReleaseV050 Release = \"v0.5.0\"\n17|\tReleaseV060 Release = \"v0.6.0\"\n18|)\n19|\n20|// Adopted is the single code-level declaration of the adopted catalog\n21|// release. Current is defined through it so the two cannot diverge;\n22|// release-agnostic tooling derives its inputs from this constant.\n23|const Adopted Release = ReleaseV060\n24|\n25|var ErrUnsupportedRelease = errors.New(\"unsupported catalog release\")\n26|\n27|// Release identifies a specification package release represented by the\n28|// reviewed implementation metadata.\n29|type Release string\n30|\n31|// ContractID is a registered AX schema or protocol identifier.\n32|type ContractID string\n33|\n34|// Family scopes operation, capability, and event names that may otherwise\n35|// overlap across independent contracts.\n36|type Family string\n37|\n38|// OperationName is one closed operation-registry member.\n39|type OperationName string\n40|\n41|// CapabilityName is one manifest/probe capability-vocabulary member. It does\n42|// not imply that the capability is available.\n43|type CapabilityName string\n44|\n45|// EventName is one closed Session Event or required Observation Event member.\n46|type EventName string\n47|\n48|// ErrorName is one stable Structured Error code.\n49|type ErrorName string\n50|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
