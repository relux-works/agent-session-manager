{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"call_id":"call_01a0b3c74a5374d697fd40d58aea1b85","text":"Read text file `internal/cloneproject/normalize.go`.\n1|package cloneproject\n2|\n3|// This file owns the Normalize production entry: manifest closure,\n4|// blob verification, native dispatch, tool/instruction/usage folds,\n5|// event and session construction through the landed builders, and\n6|// the re-decode of every sealed byte before return.\n7|\n8|import (\n9|\t\"bytes\"\n10|\t\"encoding/json\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// Stable reason codes this projection emits. They are the closed\n19|// core reasons Section 13.14.2 registers for exactly these causes,\n20|// reused here as Source Evidence reason codes.\n21|const (\n22|\t// reasonUnknownNative marks records whose native type or member\n23|\t// class the projection does not register.\n24|\treasonUnknownNative = \"unknown_native_event\"\n25|\t// reasonForeignEncrypted marks foreign encrypted records\n26|\t// preserved opaque.\n27|\treasonForeignEncrypted = \"foreign_encrypted_payload\"\n28|\t// reasonForeignSigned marks foreign signed records preserved\n29|\t// opaque.\n30|\treasonForeignSigned = \"foreign_signature_unverifiable\"\n31|\t// reasonUnsafePending marks incomplete tool history that blocks\n32|\t// pending action.\n33|\treasonUnsafePending = \"unsafe_pending_action\"\n34|)\n35|\n36|// NormalizeRequest is one projection candidate over captured bytes.\n37|type NormalizeRequest struct {\n38|\t// CaptureManifest and RawManifest carry the sealed manifests\n39|\t// clonesnap.Capture produced.\n40|\tCaptureManifest []byte\n41|\tRawManifest     []byte\n42|\t// Fetch reads one installed blob by content digest. Tests wire\n43|\t// it to the real capture store; every fetched byte is\n44|\t// digest- and size-verified before use.\n45|\tFetch func(blobID string) ([]byte, error)\n46|\t// CanonicalSink receives overflow content blobs through the\n47|\t// landed no-replace discipline.\n48|\tCanonicalSink *localstore.ObjectStore\n49|\t// LogicalSessionID and MainActorID identify the projected\n50|\t// session and its main actor.\n51|\tLogicalSessionID string\n52|\tMainActorID      string\n53|\t// Actors maps extra actor selectors\n54|\t// (external, subagent:<name>) to actor UUIDv7. Every mapped\n55|\t// selector must be referenced, and every referenced selector\n56|\t// must be mapped.\n57|\tActors map[string]string\n58|\t// Title stamps the session title; nil seals a null title.\n59|\tTitle *string\n60|\t// Workspace carries the sealed Workspace Binding bytes (the\n61|\t// capture's workspace checkpoint, passed through).\n62|\tWorkspace []byte\n63|}\n64|\n65|// NormalizeResult is one projected bundle: sealed bytes, their\n66|// decoded forms, and the derived folds.\n67|type NormalizeResult struct {\n68|\t// Session carries the sealed Canonical Session bytes.\n69|\tSession []byte\n70|\t// DecodedSession is the re-decoded session.\n71|\tDecodedSession clonebundle.CanonicalSession\n72|\t// Events carries the sealed Canonical Event bytes in ordinal\n73|\t// order.\n74|\tEvents [][]byte\n75|\t// DecodedEvents are the re-decoded events in ordinal order.\n76|\tDecodedEvents []clonebundle.CanonicalEvent\n77|\t// ToolResolutions carries the completed/aborted fold in call\n78|\t// order with orphan results after calls.\n79|\tToolResolutions []ToolResolution\n80|\t// Live is the live surface: always empty from capture.\n81|\tLive LiveSurface\n82|\t// Instruction is the effective instruction snapshot: native\n83|\t// history only.\n84|\tInstruction EffectiveInstruction\n85|\t// Usage separates source usage from zero target accounting.\n86|\tUsage UsageLedger\n87|\t// Overflows names every installed overflow blob in event\n88|\t// order, so content references resolve.\n89|\tOverflows []OverflowBlob\n90|}\n91|\n92|// Normalize derives a Canonical Session and Canonical Events from\n93|// captured bytes. The unstable_archive form cannot enter: target\n94|// projection refuses it through the landed G2 gate. Every sealed\n95|// event and the session re-decode through the landed decoders before\n96|// return; a failure anywhere returns no partial bundle.\n97|func Normalize(request NormalizeRequest) (*NormalizeResult, error) {\n98|\tif request.Fetch == nil {\n99|\t\treturn nil, invalid(\"projection requires a blob fetcher\")\n100|\t}\n101|\tif request.CanonicalSink == nil {\n102|\t\treturn nil, invalid(\"projection requires a canonical sink\")\n103|\t}\n104|\tif len(request.Workspace) == 0 {\n105|\t\treturn nil, invalid(\"projection requires workspace binding bytes\")\n106|\t}\n107|\tlogical, err := scalar.ParseUUIDv7(request.LogicalSessionID)\n108|\tif err != nil {\n109|\t\treturn nil, invalid(\"projection logical_session_id is not a UUIDv7: %v\", err)\n110|\t}\n111|\tmainActor, err := scalar.ParseUUIDv7(request.MainActorID)\n112|\tif err != nil {\n113|\t\treturn nil, invalid(\"projection main actor is not a UUIDv7: %v\", err)\n114|\t}\n115|\textraActors := map[string]scalar.UUIDv7{}\n116|\tfor selector, value := range request.Actors {\n117|\t\tif err := checkActorSelector(selector); err != nil {\n118|\t\t\treturn nil, err\n119|\t\t}\n120|\t\tif selector == \"main\" {\n121|\t\t\treturn nil, invalid(\"projection actor map carries main, which is request.MainActorID\")\n122|\t\t}\n123|\t\tparsed, err := scalar.ParseUUIDv7(value)\n124|\t\tif err != nil {\n125|\t\t\treturn nil, invalid(\"projection actor %q is not a UUIDv7: %v\", selector, err)\n126|\t\t}\n127|\t\textraActors[selector] = parsed\n128|\t}\n129|\tcapture, err := clonebundle.DecodeCaptureManifest(request.CaptureManifest)\n130|\tif err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\tif err := clonebundle.RefuseUnstableForTarget(capture.CaptureBoundary); err != nil {\n134|\t\treturn nil, err\n135|\t}\n136|\traw, err := clonebundle.DecodeRawObjectManifest(request.RawManifest)\n137|\tif err != nil {\n138|\t\treturn nil, err\n139|\t}\n140|\tif raw.ManifestID.String() != capture.SourceRawObjectManifest.String() {\n141|\t\treturn nil, invalid(\"capture manifest links raw manifest %q, sealed raw manifest is %q\",\n142|\t\t\tcapture.SourceRawObjectManifest.String(), raw.ManifestID.String())\n143|\t}\n144|\tenvironment, err := sealedEnvironment(request.RawManifest, request.CaptureManifest)\n145|\tif err != nil {\n146|\t\treturn nil, err\n147|\t}\n148|\tentries := map[string]clonebundle.RawObjectEntry{}\n149|\tfor _, entry := range raw.Entries {\n150|\t\tentries[entry.NativeItemKey] = entry\n151|\t}\n152|\tplan := &projectionPlan{\n153|\t\trequest:     request,\n154|\t\traw:         raw,\n155|\t\tentries:     entries,\n156|\t\tenvironment: environment,\n157|\t\tlogical:     logical,\n158|\t\tmainActor:   mainActor,\n159|\t\textraActors: extraActors,\n160|\t}\n161|\tif err := plan.collectMembers(capture); err != nil {\n162|\t\treturn nil, err\n163|\t}\n164|\tif len(plan.units) == 0 {\n165|\t\treturn nil, invalid(\"projection holds no events\")\n166|\t}\n167|\tif err := plan.foldTools(); err != nil {\n168|\t\treturn nil, err\n169|\t}\n170|\tif err := plan.foldInstructions(); err != nil {\n171|\t\treturn nil, err\n172|\t}\n173|\tif err := plan.foldUsage(); err != nil {\n174|\t\treturn nil, err\n175|\t}\n176|\tsurface, err := deriveLiveSurface(plan.definitions, plan.resolutions, nil)\n177|\tif err != nil {\n178|\t\treturn nil, err\n179|\t}\n180|\tplan.surface = surface\n181|\tif err := plan.checkActors(); err != nil {\n182|\t\treturn nil, err\n183|\t}\n184|\tif err := plan.buildEvents(); err != nil {\n185|\t\treturn nil, err\n186|\t}\n187|\treturn plan.buildResult()\n188|}\n189|\n190|// sealedEnvironment extracts the exact source_environment member\n191|// from both sealed manifests and refuses closure drift: the two\n192|// sealed tuples must agree byte-for-byte after canonicalization, so\n193|// the evidence environment is unambiguous.\n194|func sealedEnvironment(rawManifest, captureManifest []byte) ([]byte, error) {\n195|\traw, err := sealedMember(rawManifest, \"source_environment\")\n196|\tif err != nil {\n197|\t\treturn nil, err\n198|\t}\n199|\tcaptured, err := sealedMember(captureManifest, \"source_environment\")\n200|\tif err != nil {\n201|\t\treturn nil, err\n202|\t}\n203|\trawCanonical, err := canonicaljson.Canonicalize(raw)\n204|\tif err != nil {\n205|\t\treturn nil, invalid(\"raw manifest source_environment is not canonical JSON: %v\", err)\n206|\t}\n207|\tcapturedCanonical, err := canonicaljson.Canonicalize(captured)\n208|\tif err != nil {\n209|\t\treturn nil, invalid(\"capture manifest source_environment is not canonical JSON: %v\", err)\n210|\t}\n211|\tif !bytes.Equal(rawCanonical, capturedCanonical) {\n212|\t\treturn nil, invalid(\"capture closure drifts: raw and capture source_environment disagree\")\n213|\t}\n214|\treturn rawCanonical, nil\n215|}\n216|\n217|// sealedMember extracts one raw member from sealed bytes. Both\n218|// manifests decoded clean before this runs, so the bytes are\n219|// canonical and duplicate-free.\n220|func sealedMember(sealed []byte, name string) ([]byte, error) {\n221|\tvar members map[string]json.RawMessage\n222|\tif err := json.Unmarshal(sealed, &members); err != nil {\n223|\t\treturn nil, invalid(\"sealed manifest is not a JSON object: %v\", err)\n224|\t}\n225|\traw, ok := members[name]\n226|\tif !ok {\n227|\t\treturn nil, invalid(\"sealed manifest misses member %q\", name)\n228|\t}\n229|\treturn raw, nil\n230|}\n231|\n232|// projectionUnit is one projectable unit: a parsed record or a\n233|// whole unknown-class member.\n234|type projectionUnit struct {\n235|\trecord NativeRecord\n236|\t// memberOpaque marks a whole-member opaque_event: Offset is 0\n237|\t// and Length is the member byte count.\n238|\tmemberOpaque bool\n239|\t// descriptorID is the raw entry's descriptor; blob bytes are\n240|\t// verified before the unit is admitted.\n241|\tdescriptorID string\n242|\t// definition, call, result, instruction, and usage cache the\n243|\t// decoded bodies the folds validated, so dispatch never\n244|\t// re-decodes and never swallows a decode failure.\n245|\tdefinition  *toolDefinitionBody\n246|\tcall        *toolCallBody\n247|\tresult      *toolResultBody\n248|\tinstruction *instructionBody\n249|\tusage       *usageBody\n250|\t// kind, visibility, payload, and reasons are the dispatch.\n251|\tkind       string\n252|\tvisibility string\n253|\tpayload    map[string]any\n254|\treasons    []string\n255|}\n256|\n257|// projectionPlan accumulates one normalization.\n258|type projectionPlan struct {\n259|\trequest     NormalizeRequest\n260|\traw         clonebundle.RawObjectManifest\n261|\tentries     map[string]clonebundle.RawObjectEntry\n262|\tenvironment []byte\n263|\tlogical     scalar.UUIDv7\n264|\tmainActor   scalar.UUIDv7\n265|\textraActors map[string]scalar.UUIDv7\n266|\n267|\tunits        []projectionUnit\n268|\tcalls        []toolCall\n269|\tresults      []toolResult\n270|\tdefinitions  []toolDefinition\n271|\tinstructions []instructionObservation\n272|\tusages       []usageObservation\n273|\n274|\tresolutions []ToolResolution\n275|\tsurface     LiveSurface\n276|\tinstruction EffectiveInstruction\n277|\tusage       UsageLedger\n278|\n279|\tevents        [][]byte\n280|\tdecodedEvents []clonebundle.CanonicalEvent\n281|\tordinals      []uint64\n282|\toverflows     []OverflowBlob\n283|}\n284|\n285|// collectMembers verifies every included member's blob and parses\n286|// its records in capture order.\n287|func (plan *projectionPlan) collectMembers(capture clonebundle.CaptureManifest) error {\n288|\tfor _, item := range capture.Items {\n289|\t\tif !item.Included() {\n290|\t\t\tcontinue\n291|\t\t}\n292|\t\tentry, ok := plan.entries[item.NativeItemKey]\n293|\t\tif !ok {\n294|\t\t\treturn invalid(\"capture item %q is included with no raw object entry\", item.NativeItemKey)\n295|\t\t}\n296|\t\tpayload, err := plan.request.Fetch(entry.BlobID.String())\n297|\t\tif err != nil {\n298|\t\t\treturn invalid(\"projection cannot fetch blob %q for member %q: %v\", entry.BlobID.String(), item.NativeItemKey, err)\n299|\t\t}\n300|\t\tif uint64(len(payload)) != entry.ByteCount {\n301|\t\t\treturn invalid(\"member %q blob size %d disagrees with raw count %d\", item.NativeItemKey, len(payload), entry.ByteCount)\n302|\t\t}\n303|\t\tif scalar.SHA256Digest(payload).String() != entry.BlobID.String() {\n304|\t\t\treturn invalid(\"member %q blob digest disagrees with raw entry\", item.NativeItemKey)\n305|\t\t}\n306|\t\tif item.Class == \"unknown\" {\n307|\t\t\tplan.units = append(plan.units, projectionUnit{\n308|\t\t\t\trecord: NativeRecord{\n309|\t\t\t\t\tMemberKey:     item.NativeItemKey,\n310|\t\t\t\t\tOffset:        0,\n311|\t\t\t\t\tLength:        entry.ByteCount,\n312|\t\t\t\t\tNativeEventID: \"\",\n313|\t\t\t\t\tNativeType:    \"\",\n314|\t\t\t\t\tOrigin:        \"native\",\n315|\t\t\t\t\tProtection:    \"none\",\n316|\t\t\t\t\tActor:         \"main\",\n317|\t\t\t\t\tLineBytes:     append([]byte(nil), payload...),\n318|\t\t\t\t},\n319|\t\t\t\tmemberOpaque: true,\n320|\t\t\t\tdescriptorID: entry.BlobDescriptorID.String(),\n321|\t\t\t})\n322|\t\t\tcontinue\n323|\t\t}\n324|\t\tlines, err := splitRecordLines(item.NativeItemKey, payload)\n325|\t\tif err != nil {\n326|\t\t\treturn err\n327|\t\t}\n328|\t\tfor _, line := range lines {\n329|\t\t\trecord, err := parseNativeLine(item.NativeItemKey, line.number, line.offset, line.raw)\n330|\t\t\tif err != nil {\n331|\t\t\t\treturn err\n332|\t\t\t}\n333|\t\t\tplan.units = append(plan.units, projectionUnit{\n334|\t\t\t\trecord:       record,\n335|\t\t\t\tdescriptorID: entry.BlobDescriptorID.String(),\n336|\t\t\t})\n337|\t\t}\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|// foldTools collects tool observations in record order and resolves\n343|// the completed/aborted fold.\n344|func (plan *projectionPlan) foldTools() error {\n345|\tfor index := range plan.units {\n346|\t\tunit := &plan.units[index]\n347|\t\tif unit.memberOpaque {\n348|\t\t\tcontinue\n349|\t\t}\n350|\t\trecord := unit.record\n351|\t\tif record.Protection != \"none\" && !isReasoningType(record.NativeType) {\n352|\t\t\tcontinue\n353|\t\t}\n354|\t\tswitch record.NativeType {\n355|\t\tcase nativeToolDefinition:\n356|\t\t\tbody, err := decodeToolDefinitionBody(record)\n357|\t\t\tif err != nil {\n358|\t\t\t\treturn err\n359|\t\t\t}\n360|\t\t\tif _, err := scalar.ParseDigest(body.DefinitionHash); err != nil {\n361|\t\t\t\treturn invalid(\"record %s line %s body definition_digest is not a digest: %v\",\n362|\t\t\t\t\trecord.MemberKey, itoa(record.Line), err)\n363|\t\t\t}\n364|\t\t\tunit.definition = &body\n365|\t\t\tplan.definitions = append(plan.definitions, toolDefinition{record: record, body: body})\n366|\t\tcase nativeToolCall:\n367|\t\t\tbody, err := decodeToolCallBody(record)\n368|\t\t\tif err != nil {\n369|\t\t\t\treturn err\n370|\t\t\t}\n371|\t\t\tunit.call = &body\n372|\t\t\tplan.calls = append(plan.calls, toolCall{record: record, body: body})\n373|\t\tcase nativeToolResult:\n374|\t\t\tbody, err := decodeToolResultBody(record)\n375|\t\t\tif err != nil {\n376|\t\t\t\treturn err\n377|\t\t\t}\n378|\t\t\tunit.result = &body\n379|\t\t\tplan.results = append(plan.results, toolResult{record: record, body: body})\n380|\t\t}\n381|\t}\n382|\tresolutions, err := resolveToolCalls(plan.calls, plan.results)\n383|\tif err != nil {\n384|\t\treturn err\n385|\t}\n386|\tplan.resolutions = resolutions\n387|\treturn nil\n388|}\n389|\n390|// foldInstructions collects instruction observations in record\n391|// order and folds the effective snapshot.\n392|func (plan *projectionPlan) foldInstructions() error {\n393|\tfor index := range plan.units {\n394|\t\tunit := &plan.units[index]\n395|\t\tif unit.memberOpaque {\n396|\t\t\tcontinue\n397|\t\t}\n398|\t\trecord := unit.record\n399|\t\tif record.NativeType != nativeInstruction || record.Protection != \"none\" {\n400|\t\t\tcontinue\n401|\t\t}\n402|\t\tbody, err := decodeInstructionBody(record)\n403|\t\tif err != nil {\n404|\t\t\treturn err\n405|\t\t}\n406|\t\tunit.instruction = &body\n407|\t\tplan.instructions = append(plan.instructions, instructionObservation{record: record, body: body})\n408|\t}\n409|\tplan.instruction = foldInstructions(plan.instructions)\n410|\treturn nil\n411|}\n412|\n413|// foldUsage collects usage observations in record order and folds\n414|// the source ledger.\n415|func (plan *projectionPlan) foldUsage() error {\n416|\tfor index := range plan.units {\n417|\t\tunit := &plan.units[index]\n418|\t\tif unit.memberOpaque {\n419|\t\t\tcontinue\n420|\t\t}\n421|\t\trecord := unit.record\n422|\t\tif record.NativeType != nativeUsage || record.Protection != \"none\" {\n423|\t\t\tcontinue\n424|\t\t}\n425|\t\tbody, err := decodeUsageBody(record)\n426|\t\tif err != nil {\n427|\t\t\treturn err\n428|\t\t}\n429|\t\tunit.usage = &body\n430|\t\tplan.usages = append(plan.usages, usageObservation{record: record, body: body})\n431|\t}\n432|\tledger, err := foldUsage(plan.usages)\n433|\tif err != nil {\n434|\t\treturn err\n435|\t}\n436|\tplan.usage = ledger\n437|\treturn nil\n438|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"call_id":"call_01a0b3c74b897025aade4f7dfd33239c","text":"Read text file `internal/environ/decode.go`.\n1|package environ\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"io\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// maxUint53 is the largest exactly representable JSON integer:\n17|// counts and limits are uint53 throughout the pinned\n18|// specification.\n19|const maxUint53 = uint64(1<<53 - 1)\n20|\n21|// Fault is one strict-decode failure: what was wrong and which\n22|// member it was found in, if any. It never carries foreign bytes.\n23|// The five details are the complete fault space: every body this\n24|// package refuses at the frame layer carries exactly one of them,\n25|// and the frame-agreement battery derives its denominator from\n26|// this list, so a sixth fault shape fails the census instead of\n27|// passing silently.\n28|type Fault struct {\n29|\tDetail string\n30|\tMember string\n31|}\n32|\n33|func (fault *Fault) Error() string {\n34|\tif fault.Member == \"\" {\n35|\t\treturn \"environment frame \" + fault.Detail\n36|\t}\n37|\treturn \"environment frame \" + fault.Detail + \" in member \" + fault.Member\n38|}\n39|\n40|// Frame fault details. Each is a constant so the agreement battery\n41|// derives the fault space from production source instead of\n42|// retyping it: a reworded fault fails its row rather than passing\n43|// against a stale copy.\n44|const (\n45|\tFaultNotUTF8       = \"not valid UTF-8\"\n46|\tFaultLoneSurrogate = \"lone surrogate escape\"\n47|\tFaultNotObject     = \"not a JSON object\"\n48|\tFaultDuplicate     = \"duplicate member\"\n49|\tFaultTrailing      = \"trailing data after the object\"\n50|)\n51|\n52|// DecodeStrictObject parses one complete JSON object with\n53|// duplicate member rejection. It is the only JSON entry point in\n54|// this package: every body crosses it before any member is read.\n55|// A non-UTF-8 frame, a lone surrogate escape, a non-object top\n56|// level, a duplicated member, or trailing data is a fault, never\n57|// a partial object the caller could mistake for a result.\n58|func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\n59|\tif !utf8.Valid(data) {\n60|\t\treturn nil, &Fault{Detail: FaultNotUTF8}\n61|\t}\n62|\tif HasLoneSurrogateEscape(data) {\n63|\t\treturn nil, &Fault{Detail: FaultLoneSurrogate}\n64|\t}\n65|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n66|\ttoken, err := decoder.Token()\n67|\tif err != nil {\n68|\t\treturn nil, &Fault{Detail: FaultNotObject}\n69|\t}\n70|\tdelim, ok := token.(json.Delim)\n71|\tif !ok || delim != '{' {\n72|\t\treturn nil, &Fault{Detail: FaultNotObject}\n73|\t}\n74|\tmembers := map[string]json.RawMessage{}\n75|\tfor decoder.More() {\n76|\t\tkeyToken, err := decoder.Token()\n77|\t\tif err != nil {\n78|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n79|\t\t}\n80|\t\tkey, ok := keyToken.(string)\n81|\t\tif !ok {\n82|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n83|\t\t}\n84|\t\tif _, duplicate := members[key]; duplicate {\n85|\t\t\treturn nil, &Fault{Detail: FaultDuplicate, Member: key}\n86|\t\t}\n87|\t\tvar raw json.RawMessage\n88|\t\tif err := decoder.Decode(&raw); err != nil {\n89|\t\t\treturn nil, &Fault{Detail: FaultNotObject, Member: key}\n90|\t\t}\n91|\t\tmembers[key] = raw\n92|\t}\n93|\tif token, err := decoder.Token(); err != nil {\n94|\t\treturn nil, &Fault{Detail: FaultNotObject}\n95|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n96|\t\treturn nil, &Fault{Detail: FaultNotObject}\n97|\t}\n98|\tif _, err := decoder.Token(); err != io.EOF {\n99|\t\treturn nil, &Fault{Detail: FaultTrailing}\n100|\t}\n101|\treturn members, nil\n102|}\n103|\n104|// HasLoneSurrogateEscape reports whether the raw frame carries a\n105|// UTF-16 escape the JSON string grammar cannot pair. Go's\n106|// encoding/json would otherwise replace the lone escape with\n107|// U+FFFD silently, so wire bodies carrying lone surrogates would\n108|// be admitted with rewritten bytes.\n109|//\n110|// The walk is string-aware: only escapes inside JSON strings\n111|// count, and a backslash escape consumes both bytes, so the text\n112|// \"\\\\ud800\" (backslash-plus-text, JSON source `\"\\\\ud800\"`) is\n113|// not an escape and is admitted at the frame gate. A scanner\n114|// that matches every `\\u` byte pair regardless of string context\n115|// refuses that text, and worse, misreads it as a high surrogate\n116|// paired with a following real escape — admitting a real lone\n117|// escape the string walk refuses. The sessadapter and dirnode\n118|// facades once carried that raw scan and diverged in both\n119|// directions; they now delegate their frame verdict to\n120|// DecodeStrictObject, and the frame-agreement battery proves\n121|// both directions with run-parity rows plus even-run-plus-real-\n122|// escape compositions, so any change to this walk fails there in\n123|// either direction.\n124|func HasLoneSurrogateEscape(data []byte) bool {\n125|\tfor index := 0; index < len(data); index++ {\n126|\t\tif data[index] != '\"' {\n127|\t\t\tcontinue\n128|\t\t}\n129|\t\tfor index++; index < len(data); index++ {\n130|\t\t\tswitch data[index] {\n131|\t\t\tcase '\"':\n132|\t\t\t\tgoto stringComplete\n133|\t\t\tcase '\\\\':\n134|\t\t\t\tindex++\n135|\t\t\t\tif index >= len(data) || data[index] != 'u' {\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tunit, end, ok := readUTF16Escape(data, index-1)\n139|\t\t\t\tif !ok {\n140|\t\t\t\t\t// Not a well-formed \\uXXXX escape: the\n141|\t\t\t\t\t// JSON-syntax arms own it, not this gate.\n142|\t\t\t\t\tcontinue\n143|\t\t\t\t}\n144|\t\t\t\tindex = end - 1\n145|\t\t\t\tswitch {\n146|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n147|\t\t\t\t\tsecond, _, ok := readUTF16Escape(data, end)\n148|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n149|\t\t\t\t\t\treturn true\n150|\t\t\t\t\t}\n151|\t\t\t\t\tindex = end + 6 - 1\n152|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n153|\t\t\t\t\treturn true\n154|\t\t\t\t}\n155|\t\t\t}\n156|\t\t}\n157|\t\t// An unterminated string owns no surrogate verdict: the\n158|\t\t// frame is not JSON at all, so the syntax arms refuse it\n159|\t\t// as not-a-JSON-object rather than misattributing it\n160|\t\t// here.\n161|\t\treturn false\n162|\tstringComplete:\n163|\t}\n164|\treturn false\n165|}\n166|\n167|// readUTF16Escape reads one \\uXXXX escape starting at the offset.\n168|// It reports the unit value and the offset just past the escape,\n169|// or false when the escape is truncated or not hexadecimal.\n170|func readUTF16Escape(data []byte, offset int) (uint16, int, bool) {\n171|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n172|\t\treturn 0, offset, false\n173|\t}\n174|\tvalue, err := strconv.ParseUint(string(data[offset+2:offset+6]), 16, 16)\n175|\tif err != nil {\n176|\t\treturn 0, offset, false\n177|\t}\n178|\treturn uint16(value), offset + 6, true\n179|}\n180|\n181|// unknownMember names a member outside the closed set, if any.\n182|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n183|\tfor name := range members {\n184|\t\tif !allowed[name] {\n185|\t\t\treturn name, true\n186|\t\t}\n187|\t}\n188|\treturn \"\", false\n189|}\n190|\n191|// missingMember names the first required member with no value, if\n192|// any. The required list is fixed order, so the verdict is\n193|// deterministic for every missing combination.\n194|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n195|\tfor _, name := range required {\n196|\t\tif _, present := members[name]; !present {\n197|\t\t\treturn name, true\n198|\t\t}\n199|\t}\n200|\treturn \"\", false\n201|}\n202|\n203|// rawString reads a JSON string member.\n204|func rawString(raw json.RawMessage) (string, bool) {\n205|\tvar value string\n206|\tif err := json.Unmarshal(raw, &value); err != nil {\n207|\t\treturn \"\", false\n208|\t}\n209|\treturn value, true\n210|}\n211|\n212|// rawUint53 reads an unsigned integral JSON number in [0,\n213|// 2^53-1]. A fraction, exponent, sign, or out-of-range magnitude\n214|// is not a uint53, even when it names the same mathematical\n215|// value: the bodies carry counts, never measurements.\n216|func rawUint53(raw json.RawMessage) (uint64, bool) {\n217|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n218|\tdecoder.UseNumber()\n219|\tvar value any\n220|\tif err := decoder.Decode(&value); err != nil {\n221|\t\treturn 0, false\n222|\t}\n223|\t// Decode reads one value and stops: without the trailing\n224|\t// check a hostile slice like `12a` would read as 12. Member\n225|\t// slices arriving through DecodeStrictObject can never carry\n226|\t// trailing data, but this entry takes raw slices and must\n227|\t// not trust them.\n228|\tif _, err := decoder.Token(); err != io.EOF {\n229|\t\treturn 0, false\n230|\t}\n231|\tnumber, ok := value.(json.Number)\n232|\tif !ok {\n233|\t\treturn 0, false\n234|\t}\n235|\tliteral := number.String()\n236|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n237|\t\treturn 0, false\n238|\t}\n239|\treturn parseUint53Literal(literal)\n240|}\n241|\n242|// parseUint53Literal reads a digit-only literal without trusting\n243|// a float conversion: the magnitude bound is checked on the digit\n244|// string, so 2^53 is refused even on platforms that could hold\n245|// it.\n246|func parseUint53Literal(literal string) (uint64, bool) {\n247|\tif literal == \"\" {\n248|\t\treturn 0, false\n249|\t}\n250|\tvar value uint64\n251|\tfor index := 0; index < len(literal); index++ {\n252|\t\tdigit := literal[index]\n253|\t\tif digit < '0' || digit > '9' {\n254|\t\t\treturn 0, false\n255|\t\t}\n256|\t\tvalue = value*10 + uint64(digit-'0')\n257|\t\tif value > maxUint53 {\n258|\t\t\treturn 0, false\n259|\t\t}\n260|\t}\n261|\treturn value, true\n262|}\n263|\n264|// StringLength is the Section 1.6 string measure in characters,\n265|// not bytes: a bound of string[1..128] admits 128 characters of\n266|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n267|// env literals, Section 5.1) do not go through here; the measure\n268|// battery ledgers that split.\n269|func StringLength(value string) int {\n270|\treturn utf8.RuneCountInString(value)\n271|}\n272|\n273|// CheckStringBounds reports whether the member is a JSON string\n274|// whose character count falls in the inclusive bound.\n275|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n276|\tvalue, ok := rawString(raw)\n277|\tif !ok {\n278|\t\treturn \"\", false\n279|\t}\n280|\tlength := StringLength(value)\n281|\tif length < minimum || length > maximum {\n282|\t\treturn \"\", false\n283|\t}\n284|\treturn value, true\n285|}\n286|\n287|// CheckUint53Bounds reports whether the member is a uint53 in the\n288|// inclusive bound. Both edges are checked: a one-sided check\n289|// would admit the open side.\n290|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n291|\tvalue, ok := rawUint53(raw)\n292|\tif !ok {\n293|\t\treturn 0, false\n294|\t}\n295|\tif value < minimum || value > maximum {\n296|\t\treturn 0, false\n297|\t}\n298|\treturn value, true\n299|}\n300|\n301|// CheckDigest reports whether the member is a digest of the\n302|// pinned sha256 form.\n303|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Digest{}, false\n307|\t}\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Digest{}, false\n311|\t}\n312|\treturn digest, true\n313|}\n314|\n315|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n316|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n317|\tvalue, ok := rawString(raw)\n318|\tif !ok {\n319|\t\treturn scalar.UUIDv7{}, false\n320|\t}\n321|\tidentifier, err := scalar.ParseUUIDv7(value)\n322|\tif err != nil {\n323|\t\treturn scalar.UUIDv7{}, false\n324|\t}\n325|\treturn identifier, true\n326|}\n327|\n328|// CheckTimestamp reports whether the member is a pinned\n329|// timestamp.\n330|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n331|\tvalue, ok := rawString(raw)\n332|\tif !ok {\n333|\t\treturn scalar.Timestamp{}, false\n334|\t}\n335|\tinstant, err := scalar.ParseTimestamp(value)\n336|\tif err != nil {\n337|\t\treturn scalar.Timestamp{}, false\n338|\t}\n339|\treturn instant, true\n340|}\n341|\n342|// isNull reports whether the member is an explicit JSON null.\n343|func isNull(raw json.RawMessage) bool {\n344|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n345|}\n346|\n347|func bytesTrimSpace(raw json.RawMessage) []byte {\n348|\treturn bytes.TrimSpace(raw)\n349|}\n350|\n351|// reverseDNSPattern is the extensions-key grammar: at least two\n352|// dot-separated labels, each starting with a lowercase letter.\n353|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n354|\n355|// CheckExtensions reports whether the member is an object whose\n356|// every key is reverse-DNS. Extensions never add operations,\n357|// capabilities, or trust facts; the key grammar is the part of\n358|// that rule decidable from one body.\n359|func CheckExtensions(raw json.RawMessage) bool {\n360|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n361|\tif fault != nil {\n362|\t\treturn false\n363|\t}\n364|\tfor name := range members {\n365|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n366|\t\t\treturn false\n367|\t\t}\n368|\t}\n369|\treturn true\n370|}\n371|\n372|// decodeArray reads a JSON array member into its raw elements. A\n373|// non-array — including null — is not an empty array.\n374|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n375|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n376|\ttoken, err := decoder.Token()\n377|\tif err != nil {\n378|\t\treturn nil, false\n379|\t}\n380|\tdelim, ok := token.(json.Delim)\n381|\tif !ok || delim != '[' {\n382|\t\treturn nil, false\n383|\t}\n384|\tvar elements []json.RawMessage\n385|\tfor decoder.More() {\n386|\t\tvar element json.RawMessage\n387|\t\tif err := decoder.Decode(&element); err != nil {\n388|\t\t\treturn nil, false\n389|\t\t}\n390|\t\telements = append(elements, element)\n391|\t}\n392|\tif token, err := decoder.Token(); err != nil {\n393|\t\treturn nil, false\n394|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n395|\t\treturn nil, false\n396|\t}\n397|\tif _, err := decoder.Token(); err != io.EOF {\n398|\t\treturn nil, false\n399|\t}\n400|\treturn elements, true\n401|}\n402|\n403|// CheckSortedUniqueStrings reports whether the member is an array\n404|// of strings in the item bound whose JCS encodings order strictly\n405|// increasingly with no duplicates. Bytewise JCS order over\n406|// strings is plain lexicographic order, so the check compares\n407|// directly; the count bound is checked on both edges.\n408|//\n409|// Ordering and uniqueness are two obligations, not one: an\n410|// unsorted-but-unique vector and a sorted-but-duplicated vector\n411|// are separate rows in this package's sorted-strings battery\n412|// (TestCheckSortedUniqueStringsHalves drives this function\n413|// directly), so a check that enforced only one half could not\n414|// pass both. The observation battery covers the digest twin,\n415|// not this function.\n416|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n417|\telements, ok := decodeArray(raw)\n418|\tif !ok {\n419|\t\treturn nil, false\n420|\t}\n421|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n422|\t\treturn nil, false\n423|\t}\n424|\tvalues := make([]string, 0, len(elements))\n425|\tfor _, element := range elements {\n426|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n427|\t\tif !ok {\n428|\t\t\treturn nil, false\n429|\t\t}\n430|\t\tvalues = append(values, value)\n431|\t}\n432|\tfor index := 1; index < len(values); index++ {\n433|\t\tif values[index-1] >= values[index] {\n434|\t\t\treturn nil, false\n435|\t\t}\n436|\t}\n437|\treturn values, true\n438|}\n439|\n440|// CheckSortedUniqueDigests reports whether the member is an array\n441|// of digests in the count bound, ordered strictly increasingly\n442|// with no duplicates.\n443|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n444|\telements, ok := decodeArray(raw)\n445|\tif !ok {\n446|\t\treturn nil, false\n447|\t}\n448|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n449|\t\treturn nil, false\n450|\t}\n451|\tvalues := make([]scalar.Digest, 0, len(elements))\n452|\tfor _, element := range elements {\n453|\t\tdigest, ok := CheckDigest(element)\n454|\t\tif !ok {\n455|\t\t\treturn nil, false\n456|\t\t}\n457|\t\tvalues = append(values, digest)\n458|\t}\n459|\tfor index := 1; index < len(values); index++ {\n460|\t\tif values[index-1].String() >= values[index].String() {\n461|\t\t\treturn nil, false\n462|\t\t}\n463|\t}\n464|\treturn values, true\n465|}\n466|\n467|// refuse builds the package error for one refused member: the\n468|// rule in human text automation must never branch on, naming the\n469|// member. Tests assert the full text, so a reworded rule fails\n470|// its row instead of passing against a stale copy.\n471|//\n472|// refuse is a variable, not a function, so the refusal-site audit\n473|// (refusal_site_audit_test.go) can swap it in TestMain and record\n474|// the production file:line behind every exercised refusal. Every\n475|// call site invokes it directly; an aliased call records its real\n476|// use site and fails the reverse direction of the audit.\n477|var refuse = func(rule, member string) error {\n478|\tif member == \"\" {\n479|\t\treturn fmt.Errorf(\"environment %s\", rule)\n480|\t}\n481|\treturn fmt.Errorf(\"environment %s: %s\", rule, member)\n482|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
