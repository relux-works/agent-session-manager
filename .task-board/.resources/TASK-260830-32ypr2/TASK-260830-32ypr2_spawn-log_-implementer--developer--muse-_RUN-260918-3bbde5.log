{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e7","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":334,"recorded_at":1780531400000663,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"task_stream":{"kind":"task","id":"01a0b3c7-40f2-7ad1-867b-323cef643b70"},"task_id":"01a0b3c7-40f2-7ad1-867b-323cef643b70","event":{"kind":"output","task_id":"01a0b3c7-40f2-7ad1-867b-323cef643b70","chunk":"Read text file `internal/cloneproject/dispatch.go`.\n1|package cloneproject\n2|\n3|// This file dispatches projection units to Canonical Event kinds,\n4|// builds every event and the session through the landed builders,\n5|// and re-decodes each sealed byte before it enters the result.\n6|\n7|import (\n8|\t\"encoding/json\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// isReasoningType reports whether the native type is a reasoning\n17|// type. Protected reasoning becomes opaque_reasoning; protected\n18|// anything else becomes opaque_event.\n19|func isReasoningType(nativeType string) bool {\n20|\tswitch nativeType {\n21|\tcase nativeReasoningSummary, nativeReasoningCrypt, nativeReasoningSigned:\n22|\t\treturn true\n23|\tdefault:\n24|\t\treturn false\n25|\t}\n26|}\n27|\n28|// dispatchUnits selects kind, visibility, payload, and reasons for\n29|// every unit. Protection is decided before type: unreadable content\n30|// never reaches a semantic kind.\n31|func (plan *projectionPlan) dispatchUnits() error {\n32|\tresolutions := map[string]ToolResolution{}\n33|\tfor _, resolution := range plan.resolutions {\n34|\t\tresolutions[resolution.CallID] = resolution\n35|\t}\n36|\tfor index := range plan.units {\n37|\t\tunit := &plan.units[index]\n38|\t\tif unit.memberOpaque {\n39|\t\t\tunit.kind = \"opaque_event\"\n40|\t\t\tunit.visibility = \"opaque\"\n41|\t\t\tunit.payload = map[string]any{\n42|\t\t\t\t\"native_item_key\":    unit.record.MemberKey,\n43|\t\t\t\t\"byte_count\":         unit.record.Length,\n44|\t\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n45|\t\t\t\t\"extensions\":         map[string]any{},\n46|\t\t\t}\n47|\t\t\tunit.reasons = []string{reasonUnknownNative}\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\tif err := plan.dispatchRecord(unit, resolutions); err != nil {\n51|\t\t\treturn err\n52|\t\t}\n53|\t}\n54|\treturn nil\n55|}\n56|\n57|// dispatchRecord dispatches one parsed record.\n58|func (plan *projectionPlan) dispatchRecord(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n59|\trecord := unit.record\n60|\tif record.Protection != \"none\" {\n61|\t\treturn plan.dispatchProtected(unit)\n62|\t}\n63|\tswitch record.NativeType {\n64|\tcase nativeMessageUser, nativeMessageAssistant:\n65|\t\treturn plan.dispatchMessage(unit)\n66|\tcase nativeReasoningSummary:\n67|\t\treturn plan.dispatchMessage(unit)\n68|\tcase nativeReasoningCrypt, nativeReasoningSigned:\n69|\t\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n70|\t\treturn invalid(\"%s declares %s with no protection\", where, record.NativeType)\n71|\tcase nativeInstruction:\n72|\t\treturn plan.dispatchInstruction(unit)\n73|\tcase nativeToolDefinition:\n74|\t\treturn plan.dispatchDefinition(unit)\n75|\tcase nativeToolCall:\n76|\t\treturn plan.dispatchCall(unit, resolutions)\n77|\tcase nativeToolResult:\n78|\t\treturn plan.dispatchResult(unit, resolutions)\n79|\tcase nativeUsage:\n80|\t\treturn plan.dispatchUsage(unit)\n81|\tdefault:\n82|\t\tunit.kind = \"opaque_event\"\n83|\t\tunit.visibility = \"opaque\"\n84|\t\tunit.payload = map[string]any{\n85|\t\t\t\"native_type\":        record.NativeType,\n86|\t\t\t\"byte_count\":         record.Length,\n87|\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n88|\t\t\t\"extensions\":         map[string]any{},\n89|\t\t}\n90|\t\tunit.reasons = []string{reasonUnknownNative}\n91|\t\treturn nil\n92|\t}\n93|}\n94|\n95|// dispatchProtected dispatches a protected record: protection\n96|// defines the body shape (exactly ciphertext, never interpreted),\n97|// and the kind is opaque. Reasoning stays opaque_reasoning;\n98|// anything else becomes opaque_event.\n99|func (plan *projectionPlan) dispatchProtected(unit *projectionUnit) error {\n100|\trecord := unit.record\n101|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n102|\tif _, err := decodeProtectedBody(record); err != nil {\n103|\t\treturn err\n104|\t}\n105|\tswitch record.NativeType {\n106|\tcase nativeReasoningCrypt:\n107|\t\tif record.Protection != \"encrypted\" {\n108|\t\t\treturn invalid(\"%s declares reasoning/encrypted with protection %q\", where, record.Protection)\n109|\t\t}\n110|\tcase nativeReasoningSigned:\n111|\t\tif record.Protection != \"signed\" {\n112|\t\t\treturn invalid(\"%s declares reasoning/signed with protection %q\", where, record.Protection)\n113|\t\t}\n114|\t}\n115|\treasons := cryptoReasons(record)\n116|\tif !knownNativeType(record.NativeType) {\n117|\t\treasons = append(reasons, reasonUnknownNative)\n118|\t\tsort.Strings(reasons)\n119|\t}\n120|\tif isReasoningType(record.NativeType) {\n121|\t\tunit.kind = \"opaque_reasoning\"\n122|\t\tunit.visibility = \"opaque\"\n123|\t\tunit.payload = map[string]any{\n124|\t\t\t\"protection\":         record.Protection,\n125|\t\t\t\"byte_count\":         record.Length,\n126|\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n127|\t\t\t\"extensions\":         map[string]any{},\n128|\t\t}\n129|\t\tunit.reasons = reasons\n130|\t\treturn nil\n131|\t}\n132|\tunit.kind = \"opaque_event\"\n133|\tunit.visibility = \"opaque\"\n134|\tunit.payload = map[string]any{\n135|\t\t\"native_type\":        record.NativeType,\n136|\t\t\"protection\":         record.Protection,\n137|\t\t\"byte_count\":         record.Length,\n138|\t\t\"blob_descriptor_id\": unit.descriptorID,\n139|\t\t\"extensions\":         map[string]any{},\n140|\t}\n141|\tunit.reasons = reasons\n142|\treturn nil\n143|}\n144|\n145|// cryptoReasons selects the stable reason for a protected record:\n146|// the foreign core reason when the origin is foreign, no reason\n147|// when native (no core code fits native-protected content; the\n148|// payload protection fact carries the cause).\n149|func cryptoReasons(record NativeRecord) []string {\n150|\tif record.Origin != \"foreign\" {\n151|\t\treturn nil\n152|\t}\n153|\tif record.Protection == \"signed\" {\n154|\t\treturn []string{reasonForeignSigned}\n155|\t}\n156|\treturn []string{reasonForeignEncrypted}\n157|}\n158|\n159|// dispatchMessage dispatches a message or reasoning summary: the\n160|// exact text body becomes one text content block, inline or\n161|// overflow-referenced.\n162|func (plan *projectionPlan) dispatchMessage(unit *projectionUnit) error {\n163|\trecord := unit.record\n164|\tbody, err := decodeMessageBody(record)\n165|\tif err != nil {\n166|\t\treturn err\n167|\t}\n168|\tblock, installed, err := contentBlockForText(body.Text, plan.request.CanonicalSink)\n169|\tif err != nil {\n170|\t\treturn err\n171|\t}\n172|\tplan.overflows = append(plan.overflows, installed...)\n173|\tswitch record.NativeType {\n174|\tcase nativeMessageUser:\n175|\t\tunit.kind = \"user_message\"\n176|\t\tunit.visibility = \"public\"\n177|\tcase nativeMessageAssistant:\n178|\t\tunit.kind = \"assistant_message\"\n179|\t\tunit.visibility = \"public\"\n180|\tdefault:\n181|\t\tunit.kind = \"reasoning_summary\"\n182|\t\tunit.visibility = \"internal\"\n183|\t}\n184|\tunit.payload = map[string]any{\n185|\t\t\"content_blocks\": []any{block},\n186|\t\t\"extensions\":     map[string]any{},\n187|\t}\n188|\treturn nil\n189|}\n190|\n191|// dispatchInstruction dispatches an instruction snapshot: foreign\n192|// instructions pin low authority, native instructions carry their\n193|// claimed authority.\n194|func (plan *projectionPlan) dispatchInstruction(unit *projectionUnit) error {\n195|\trecord := unit.record\n196|\tbody := unit.instruction\n197|\tauthority := body.Authority\n198|\tif record.Origin != \"native\" {\n199|\t\tauthority = \"low\"\n200|\t}\n201|\tdirectives := make([]any, 0, len(body.Directives))\n202|\tfor _, directive := range body.Directives {\n203|\t\tdirectives = append(directives, directive)\n204|\t}\n205|\tunit.kind = \"instruction_snapshot\"\n206|\tunit.visibility = \"internal\"\n207|\tunit.payload = map[string]any{\n208|\t\t\"authority\":  authority,\n209|\t\t\"directives\": directives,\n210|\t\t\"extensions\": map[string]any{},\n211|\t}\n212|\treturn nil\n213|}\n214|\n215|// dispatchDefinition dispatches a tool definition snapshot: history\n216|// with callable pinned false. Registration never happens here; the\n217|// live surface refused live claims before dispatch ran.\n218|func (plan *projectionPlan) dispatchDefinition(unit *projectionUnit) error {\n219|\tbody := unit.definition\n220|\tunit.kind = \"tool_definition_snapshot\"\n221|\tunit.visibility = \"internal\"\n222|\tunit.payload = map[string]any{\n223|\t\t\"tool_name\":         body.ToolName,\n224|\t\t\"definition_digest\": body.DefinitionHash,\n225|\t\t\"callable\":          false,\n226|\t\t\"extensions\":        map[string]any{},\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// dispatchCall dispatches a tool call with its folded resolution.\n232|func (plan *projectionPlan) dispatchCall(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n233|\tbody := unit.call\n234|\tresolution, ok := resolutions[body.CallID]\n235|\tif !ok {\n236|\t\treturn invalid(\"tool call %q has no folded resolution\", body.CallID)\n237|\t}\n238|\tunit.kind = \"tool_call\"\n239|\tunit.visibility = \"internal\"\n240|\tunit.payload = map[string]any{\n241|\t\t\"call_id\":    body.CallID,\n242|\t\t\"tool_name\":  body.ToolName,\n243|\t\t\"resolution\": resolution.Status,\n244|\t\t\"extensions\": map[string]any{},\n245|\t}\n246|\tif resolution.Status == StatusAborted {\n247|\t\tunit.reasons = []string{reasonUnsafePending}\n248|\t}\n249|\treturn nil\n250|}\n251|\n252|// dispatchResult dispatches a tool result with its folded\n253|// resolution: completed when paired, aborted history when orphaned.\n254|func (plan *projectionPlan) dispatchResult(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n255|\tbody := unit.result\n256|\tresolution, ok := resolutions[body.CallID]\n257|\tif !ok {\n258|\t\treturn invalid(\"tool result %q has no folded resolution\", body.CallID)\n259|\t}\n260|\tunit.kind = \"tool_result\"\n261|\tunit.visibility = \"internal\"\n262|\tunit.payload = map[string]any{\n263|\t\t\"call_id\":    body.CallID,\n264|\t\t\"status\":     body.Status,\n265|\t\t\"resolution\": resolution.Status,\n266|\t\t\"extensions\": map[string]any{},\n267|\t}\n268|\tif resolution.Status == StatusAborted {\n269|\t\tunit.reasons = []string{reasonUnsafePending}\n270|\t}\n271|\treturn nil\n272|}\n273|\n274|// dispatchUsage dispatches a usage report: source tokens into the\n275|// payload; target accounting is never written anywhere.\n276|func (plan *projectionPlan) dispatchUsage(unit *projectionUnit) error {\n277|\tbody := unit.usage\n278|\tunit.kind = \"usage\"\n279|\tunit.visibility = \"internal\"\n280|\tunit.payload = map[string]any{\n281|\t\t\"input_tokens\":  body.InputTokens,\n282|\t\t\"output_tokens\": body.OutputTokens,\n283|\t\t\"extensions\":    map[string]any{},\n284|\t}\n285|\treturn nil\n286|}\n287|\n288|// actorSet is the resolved actor UUIDs by selector.\n289|type actorSet struct {\n290|\tmain  scalar.UUIDv7\n291|\textra map[string]scalar.UUIDv7\n292|}\n293|\n294|// checkActors resolves every referenced selector: main plus exactly\n295|// the mapped extras. A referenced selector without a mapping, or a\n296|// mapping without a reference, refuses.\n297|func (plan *projectionPlan) checkActors() error {\n298|\treferenced := map[string]bool{}\n299|\tfor _, unit := range plan.units {\n300|\t\treferenced[unit.record.Actor] = true\n301|\t}\n302|\tfor selector := range referenced {\n303|\t\tif selector == \"main\" {\n304|\t\t\tcontinue\n305|\t\t}\n306|\t\tif _, ok := plan.extraActors[selector]; !ok {\n307|\t\t\treturn invalid(\"projection references actor %q with no mapped UUID\", selector)\n308|\t\t}\n309|\t}\n310|\tfor selector := range plan.extraActors {\n311|\t\tif !referenced[selector] {\n312|\t\t\treturn invalid(\"projection maps actor %q with no referencing record\", selector)\n313|\t\t}\n314|\t}\n315|\treturn nil\n316|}\n317|\n318|// buildEvents dispatches every unit and seals the events in record\n319|// order: contiguous ordinals from zero, each event parented on its\n320|// predecessor, each sealed byte re-decoded before use.\n321|func (plan *projectionPlan) buildEvents() error {\n322|\tif err := plan.dispatchUnits(); err != nil {\n323|\t\treturn err\n324|\t}\n325|\tactors := actorSet{main: plan.mainActor, extra: plan.extraActors}\n326|\tvar previous *scalar.Digest\n327|\tfor index := range plan.units {\n328|\t\tunit := &plan.units[index]\n329|\t\tactor, ok := actors.extra[unit.record.Actor]\n330|\t\tif unit.record.Actor == \"main\" {\n331|\t\t\tactor, ok = actors.main, true\n332|\t\t}\n333|\t\tif !ok {\n334|\t\t\treturn invalid(\"projection cannot resolve actor %q to a mapped UUID\", unit.record.Actor)\n335|\t\t}\n336|\t\tparents := []string{}\n337|\t\tif previous != nil {\n338|\t\t\tparents = []string{previous.String()}\n339|\t\t}\n340|\t\tpayload, err := json.Marshal(unit.payload)\n341|\t\tif err != nil {\n342|\t\t\treturn invalid(\"projection cannot marshal event payload: %v\", err)\n343|\t\t}\n344|\t\tinput := clonebundle.CanonicalEventInput{\n345|\t\t\tLogicalSessionID: plan.logical.String(),\n346|\t\t\tOrdinal:          uint64(index),\n347|\t\t\tParents:          parents,\n348|\t\t\tActorID:          actor.String(),\n349|\t\t\tKind:             unit.kind,\n350|\t\t\tVisibility:       unit.visibility,\n351|\t\t\tPayload:          payload,\n352|\t\t\tEvidence:         plan.evidenceFor(unit),\n353|\t\t\tExtensions:       map[string]any{},\n354|\t\t}\n355|\t\tsealed, err := clonebundle.BuildCanonicalEvent(input)\n356|\t\tif err != nil {\n357|\t\t\treturn invalid(\"projection cannot seal ordinal %d (%s): %v\", index, unit.kind, err)\n358|\t\t}\n359|\t\tdecoded, err := clonebundle.DecodeCanonicalEvent(sealed)\n360|\t\tif err != nil {\n361|\t\t\treturn invalid(\"sealed ordinal %d refused: %v\", index, err)\n362|\t\t}\n363|\t\tplan.events = append(plan.events, sealed)\n364|\t\tplan.decodedEvents = append(plan.decodedEvents, decoded)\n365|\t\tplan.ordinals = append(plan.ordinals, uint64(index))\n366|\t\tidentifier := decoded.EventID\n367|\t\tprevious = &identifier\n368|\t}\n369|\tif err := clonebundle.CheckOrdinalContiguity(plan.ordinals); err != nil {\n370|\t\treturn err\n371|\t}\n372|\treturn nil\n373|}\n374|\n375|// evidenceFor builds the Source Evidence input for one unit: exact\n376|// capture status with the record's byte range inside its member\n377|// blob, so every reference resolves back to captured bytes.\n378|func (plan *projectionPlan) evidenceFor(unit *projectionUnit) clonebundle.EvidenceInput {\n379|\trecord := unit.record\n380|\tinput := clonebundle.EvidenceInput{\n381|\t\tEnvironment:     plan.environment,\n382|\t\tNativeSessionID: plan.raw.SourceNativeSessionID,\n383|\t\tRawRefs: []clonebundle.RawRefInput{{\n384|\t\t\tManifestID:       plan.raw.ManifestID.String(),\n385|\t\t\tBlobDescriptorID: unit.descriptorID,\n386|\t\t\tOffset:           record.Offset,\n387|\t\t\tLength:           record.Length,\n388|\t\t}},\n389|\t\tCaptureStatus: \"exact\",\n390|\t\tReasonCodes:   append([]string(nil), unit.reasons...),\n391|\t}\n392|\tif !unit.memberOpaque {\n393|\t\teventID := record.NativeEventID\n394|\t\tnativeType := record.NativeType\n395|\t\tinput.NativeEventID = &eventID\n396|\t\tinput.NativeType = &nativeType\n397|\t}\n398|\treturn input\n399|}\n400|\n401|// buildResult seals the Canonical Session over the projected\n402|// events: main plus exactly the referenced extras (parented on\n403|// main), ordinal-ordered event IDs, the last event as head.\n404|func (plan *projectionPlan) buildResult() (*NormalizeResult, error) {\n405|\tmain := plan.mainActor.String()\n406|\tinputs := []clonebundle.ActorInput{{\n407|\t\tActorID: main,\n408|\t\tKind:    \"main\",\n409|\t}}\n410|\tselectors := make([]string, 0, len(plan.extraActors))\n411|\tfor selector := range plan.extraActors {\n412|\t\tselectors = append(selectors, selector)\n413|\t}\n414|\tsort.Strings(selectors)\n415|\tfor _, selector := range selectors {\n416|\t\tname := selector\n417|\t\tkind := \"external\"\n418|\t\tif strings.HasPrefix(selector, \"subagent:\") {\n419|\t\t\tkind = \"subagent\"\n420|\t\t}\n421|\t\tparent := main\n422|\t\tinputs = append(inputs, clonebundle.ActorInput{\n423|\t\t\tActorID:        plan.extraActors[selector].String(),\n424|\t\t\tKind:           kind,\n425|\t\t\tParentActorID:  &parent,\n426|\t\t\tName:           &name,\n427|\t\t\tSourceNativeID: &name,\n428|\t\t})\n429|\t}\n430|\teventIDs := make([]string, 0, len(plan.decodedEvents))\n431|\tfor _, decoded := range plan.decodedEvents {\n432|\t\teventIDs = append(eventIDs, decoded.EventID.String())\n433|\t}\n434|\t// Unreachable: Normalize refused the empty projection before\n435|\t// dispatch ran. The guard keeps a headless build a builder\n436|\t// refusal instead of an index panic.\n437|\theads := []string{}\n438|\tif len(eventIDs) > 0 {\n439|\t\theads = []string{eventIDs[len(eventIDs)-1]}\n440|\t}\n441|\tsession, err := clonebundle.BuildCanonicalSession(clonebundle.CanonicalSessionInput{\n442|\t\tLogicalSessionID:      plan.logical.String(),\n443|\t\tSourceEnvironment:     plan.environment,\n444|\t\tSourceNativeSessionID: plan.raw.SourceNativeSessionID,\n445|\t\tTitle:                 plan.request.Title,\n446|\t\tWorkspace:             plan.request.Workspace,\n447|\t\tActors:                inputs,\n448|\t\tEventIDs:              eventIDs,\n449|\t\tHeadEventIDs:          heads,\n450|\t\tExtensions:            map[string]any{},\n451|\t})\n452|\tif err != nil {\n453|\t\treturn nil, invalid(\"projection cannot seal its session: %v\", err)\n454|\t}\n455|\tdecoded, err := clonebundle.DecodeCanonicalSession(session)\n456|\tif err != nil {\n457|\t\treturn nil, invalid(\"sealed session refused: %v\", err)\n458|\t}\n459|\treturn &NormalizeResult{\n460|\t\tSession:         session,\n461|\t\tDecodedSession:  decoded,\n462|\t\tEvents:          plan.events,\n463|\t\tDecodedEvents:   plan.decodedEvents,\n464|\t\tToolResolutions: plan.resolutions,\n465|\t\tLive:            plan.surface,\n466|\t\tInstruction:     plan.instruction,\n467|\t\tUsage:           plan.usage,\n468|\t\tOverflows:       plan.overflows,\n469|\t}, nil\n470|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e9","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":335,"recorded_at":1780531400000665,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"task_stream":{"kind":"task","id":"01a0b3c7-40f2-7ad1-867b-323cef643b70"},"task_id":"01a0b3c7-40f2-7ad1-867b-323cef643b70","event":{"kind":"completed","task_id":"01a0b3c7-40f2-7ad1-867b-323cef643b70"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5eb","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":336,"recorded_at":1780531400000667,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"task_stream":{"kind":"task","id":"01a0b3c7-4077-70b2-bec9-df161b4e9777"},"task_id":"01a0b3c7-4077-70b2-bec9-df161b4e9777","event":{"kind":"output","task_id":"01a0b3c7-4077-70b2-bec9-df161b4e9777","chunk":"Read text file `internal/cloneproject/native.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"unicode/utf8\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|)\n12|\n13|// This file parses the fixture-native record envelope. The envelope\n14|// is test-defined framing, not a specification shape: its only job\n15|// is to carry attributable bytes (native ID, native type, origin,\n16|// protection, actor, body) from captured members to the projection.\n17|// Every per-kind body shape below is exact: unknown body members\n18|// refuse rather than silently drop, so a projection can never claim\n19|// a faithful kind while ignoring a fact it does not understand. Type\n20|// level unknowns become opaque_event; field level unknowns inside a\n21|// known type refuse (see doc.go).\n22|\n23|// NativeRecord is one parsed fixture-native record with its byte\n24|// range inside the member blob.\n25|type NativeRecord struct {\n26|\t// MemberKey is the capture native item key holding the record.\n27|\tMemberKey string\n28|\t// Line is the one-based line number inside the member.\n29|\tLine int\n30|\t// Offset and Length are the record's byte range: the line\n31|\t// without its newline terminator.\n32|\tOffset uint64\n33|\tLength uint64\n34|\t// NativeEventID and NativeType attribute the record.\n35|\tNativeEventID string\n36|\tNativeType    string\n37|\t// Origin is native or foreign.\n38|\tOrigin string\n39|\t// Protection is none, encrypted, or signed.\n40|\tProtection string\n41|\t// Actor is main, external, or subagent:<name>.\n42|\tActor string\n43|\t// Body carries the raw body value; kind code reads only its\n44|\t// registered members.\n45|\tBody json.RawMessage\n46|\t// LineBytes are the exact record bytes preserved for opaque kinds.\n47|\tLineBytes []byte\n48|}\n49|\n50|// nativeEnvelope is the decoded envelope shape. Body stays raw:\n51|// each known type validates its own exact members.\n52|type nativeEnvelope struct {\n53|\tVersion       json.Number     `json:\"v\"`\n54|\tNativeEventID string          `json:\"native_event_id\"`\n55|\tNativeType    string          `json:\"native_type\"`\n56|\tOrigin        string          `json:\"origin\"`\n57|\tProtection    string          `json:\"protection\"`\n58|\tActor         string          `json:\"actor\"`\n59|\tBody          json.RawMessage `json:\"body\"`\n60|}\n61|\n62|// parseNativeLine parses one record line. A line that is not valid\n63|// UTF-8, not a JSON object, or misses an envelope member refuses\n64|// with the member and line named: malformed framing is an error,\n65|// never an absent or guessed record.\n66|func parseNativeLine(memberKey string, line int, offset uint64, raw []byte) (NativeRecord, error) {\n67|\twhere := func() string {\n68|\t\treturn \"record \" + memberKey + \" line \" + itoa(line)\n69|\t}\n70|\tif !utf8.Valid(raw) {\n71|\t\treturn NativeRecord{}, invalid(\"%s is not valid UTF-8\", where())\n72|\t}\n73|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n74|\tdecoder.UseNumber()\n75|\tvar members map[string]json.RawMessage\n76|\tif err := decoder.Decode(&members); err != nil {\n77|\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n78|\t}\n79|\tif decoder.More() {\n80|\t\treturn NativeRecord{}, invalid(\"%s carries trailing bytes\", where())\n81|\t}\n82|\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\n83|\t\tif _, ok := members[name]; !ok {\n84|\t\t\treturn NativeRecord{}, invalid(\"%s misses envelope member %q\", where(), name)\n85|\t\t}\n86|\t}\n87|\tvar envelope nativeEnvelope\n88|\tstrict := json.NewDecoder(bytes.NewReader(raw))\n89|\tstrict.UseNumber()\n90|\tif err := strict.Decode(&envelope); err != nil {\n91|\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n92|\t}\n93|\tif envelope.Version.String() != \"1\" {\n94|\t\treturn NativeRecord{}, invalid(\"%s carries envelope version %q, want 1\", where(), envelope.Version.String())\n95|\t}\n96|\tif environ.StringLength(envelope.NativeEventID) < 1 || environ.StringLength(envelope.NativeEventID) > 512 {\n97|\t\treturn NativeRecord{}, invalid(\"%s native_event_id is not a string[1..512]\", where())\n98|\t}\n99|\tif environ.StringLength(envelope.NativeType) < 1 || environ.StringLength(envelope.NativeType) > 512 {\n100|\t\treturn NativeRecord{}, invalid(\"%s native_type is not a string[1..512]\", where())\n101|\t}\n102|\tif envelope.Origin != \"native\" && envelope.Origin != \"foreign\" {\n103|\t\treturn NativeRecord{}, invalid(\"%s origin %q is outside native|foreign\", where(), envelope.Origin)\n104|\t}\n105|\tif envelope.Protection != \"none\" && envelope.Protection != \"encrypted\" && envelope.Protection != \"signed\" {\n106|\t\treturn NativeRecord{}, invalid(\"%s protection %q is outside none|encrypted|signed\", where(), envelope.Protection)\n107|\t}\n108|\tif err := checkActorSelector(envelope.Actor); err != nil {\n109|\t\treturn NativeRecord{}, invalid(\"%s %v\", where(), err)\n110|\t}\n111|\treturn NativeRecord{\n112|\t\tMemberKey:     memberKey,\n113|\t\tLine:          line,\n114|\t\tOffset:        offset,\n115|\t\tLength:        uint64(len(raw)),\n116|\t\tNativeEventID: envelope.NativeEventID,\n117|\t\tNativeType:    envelope.NativeType,\n118|\t\tOrigin:        envelope.Origin,\n119|\t\tProtection:    envelope.Protection,\n120|\t\tActor:         envelope.Actor,\n121|\t\tBody:          envelope.Body,\n122|\t\tLineBytes:     append([]byte(nil), raw...),\n123|\t}, nil\n124|}\n125|\n126|// checkActorSelector validates main, external, or subagent:<name>\n127|// with a bounded non-empty name.\n128|func checkActorSelector(selector string) error {\n129|\tif selector == \"main\" || selector == \"external\" {\n130|\t\treturn nil\n131|\t}\n132|\tname, ok := strings.CutPrefix(selector, \"subagent:\")\n133|\tif !ok || name == \"\" {\n134|\t\treturn invalid(\"actor %q is outside main|external|subagent:<name>\", selector)\n135|\t}\n136|\tif environ.StringLength(name) > 128 {\n137|\t\treturn invalid(\"actor %q names a subagent past 128 characters\", selector)\n138|\t}\n139|\treturn nil\n140|}\n141|\n142|// splitRecordLines splits member bytes into record lines with byte\n143|// offsets. A zero-byte member holds zero records; otherwise one\n144|// trailing newline is the terminator and every remaining line must\n145|// be non-empty: a blank line is malformed framing, never an absent\n146|// record.\n147|func splitRecordLines(memberKey string, payload []byte) ([]recordLine, error) {\n148|\tif len(payload) == 0 {\n149|\t\treturn nil, nil\n150|\t}\n151|\trest := payload\n152|\tif rest[len(rest)-1] == '\\n' {\n153|\t\trest = rest[:len(rest)-1]\n154|\t}\n155|\tvar lines []recordLine\n156|\toffset := uint64(0)\n157|\tnumber := 1\n158|\tfor {\n159|\t\tend := bytes.IndexByte(rest, '\\n')\n160|\t\tvar raw []byte\n161|\t\tif end < 0 {\n162|\t\t\traw = rest\n163|\t\t\trest = nil\n164|\t\t} else {\n165|\t\t\traw = rest[:end]\n166|\t\t\trest = rest[end+1:]\n167|\t\t}\n168|\t\tif len(raw) == 0 {\n169|\t\t\treturn nil, invalid(\"record %s line %d is empty\", memberKey, number)\n170|\t\t}\n171|\t\tlines = append(lines, recordLine{number: number, offset: offset, raw: raw})\n172|\t\toffset += uint64(len(raw)) + 1\n173|\t\tnumber++\n174|\t\tif rest == nil {\n175|\t\t\tbreak\n176|\t\t}\n177|\t}\n178|\treturn lines, nil\n179|}\n180|\n181|// recordLine is one split line with its number and byte offset.\n182|type recordLine struct {\n183|\tnumber int\n184|\toffset uint64\n185|\traw    []byte\n186|}\n187|\n188|// itoa renders a line number for refusal messages.\n189|func itoa(value int) string {\n190|\treturn strconv.Itoa(value)\n191|}\n192|\n193|// Known fixture-native types. Every other native_type projects as\n194|// opaque_event.\n195|const (\n196|\tnativeMessageUser      = \"message/user\"\n197|\tnativeMessageAssistant = \"message/assistant\"\n198|\tnativeReasoningSummary = \"reasoning/summary\"\n199|\tnativeReasoningCrypt   = \"reasoning/encrypted\"\n200|\tnativeReasoningSigned  = \"reasoning/signed\"\n201|\tnativeInstruction      = \"instruction/snapshot\"\n202|\tnativeToolDefinition   = \"tool/definition\"\n203|\tnativeToolCall         = \"tool/call\"\n204|\tnativeToolResult       = \"tool/result\"\n205|\tnativeUsage            = \"usage/report\"\n206|)\n207|\n208|// knownNativeType reports whether the native type selects a\n209|// registered projection. Unknown types become opaque_event.\n210|func knownNativeType(nativeType string) bool {\n211|\tswitch nativeType {\n212|\tcase nativeMessageUser,\n213|\t\tnativeMessageAssistant,\n214|\t\tnativeReasoningSummary,\n215|\t\tnativeReasoningCrypt,\n216|\t\tnativeReasoningSigned,\n217|\t\tnativeInstruction,\n218|\t\tnativeToolDefinition,\n219|\t\tnativeToolCall,\n220|\t\tnativeToolResult,\n221|\t\tnativeUsage:\n222|\t\treturn true\n223|\tdefault:\n224|\t\treturn false\n225|\t}\n226|}\n227|\n228|// decodeBodyObject decodes a body object with exact members: every\n229|// member must be registered for the type, and every required member\n230|// must be present. Unknown members refuse.\n231|func decodeBodyObject(record NativeRecord, required []string, allowed map[string]bool) (map[string]json.RawMessage, error) {\n232|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n233|\tdecoder := json.NewDecoder(bytes.NewReader(bytes.TrimSpace(record.Body)))\n234|\tdecoder.UseNumber()\n235|\tvar members map[string]json.RawMessage\n236|\tif err := decoder.Decode(&members); err != nil {\n237|\t\treturn nil, invalid(\"%s body is not a JSON object: %v\", where, err)\n238|\t}\n239|\tfor name := range members {\n240|\t\tif !allowed[name] {\n241|\t\t\treturn nil, invalid(\"%s body carries unknown member %q\", where, name)\n242|\t\t}\n243|\t}\n244|\tfor _, name := range required {\n245|\t\tif _, ok := members[name]; !ok {\n246|\t\t\treturn nil, invalid(\"%s body misses member %q\", where, name)\n247|\t\t}\n248|\t}\n249|\treturn members, nil\n250|}\n251|\n252|// bodyString reads one required string body member.\n253|func bodyString(record NativeRecord, members map[string]json.RawMessage, name string) (string, error) {\n254|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n255|\tvar value string\n256|\tif err := json.Unmarshal(members[name], &value); err != nil {\n257|\t\treturn \"\", invalid(\"%s body member %q is not a string\", where, name)\n258|\t}\n259|\treturn value, nil\n260|}\n261|\n262|// bodyOptionalBool reads one optional boolean body member.\n263|func bodyOptionalBool(record NativeRecord, members map[string]json.RawMessage, name string) (bool, error) {\n264|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n265|\traw, ok := members[name]\n266|\tif !ok {\n267|\t\treturn false, nil\n268|\t}\n269|\tvar value bool\n270|\tif err := json.Unmarshal(raw, &value); err != nil {\n271|\t\treturn false, invalid(\"%s body member %q is not a boolean\", where, name)\n272|\t}\n273|\treturn value, nil\n274|}\n275|\n276|// bodyUint53 reads one required uint53 body member: an integer\n277|// literal in [0..2^53-1], never a fraction, exponent, or string.\n278|func bodyUint53(record NativeRecord, members map[string]json.RawMessage, name string) (uint64, error) {\n279|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n280|\tdecoder := json.NewDecoder(bytes.NewReader(members[name]))\n281|\tdecoder.UseNumber()\n282|\tvar value json.Number\n283|\tif err := decoder.Decode(&value); err != nil {\n284|\t\treturn 0, invalid(\"%s body member %q is not a number\", where, name)\n285|\t}\n286|\ttext := value.String()\n287|\tif len(text) == 0 {\n288|\t\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\n289|\t}\n290|\tfor i := 0; i < len(text); i++ {\n291|\t\tif text[i] < '0' || text[i] > '9' {\n292|\t\t\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\n293|\t\t}\n294|\t}\n295|\tparsed, err := strconv.ParseUint(text, 10, 53)\n296|\tif err != nil {\n297|\t\treturn 0, invalid(\"%s body member %q exceeds uint53\", where, name)\n298|\t}\n299|\treturn parsed, nil\n300|}\n301|\n302|// maxUint53 is 2^53-1, the AX safe-integer ceiling.\n303|const maxUint53 = uint64(1<<53 - 1)\n304|\n305|// messageBody is the exact message/reasoning-summary body: text only.\n306|type messageBody struct {\n307|\tText string\n308|}\n309|\n310|// decodeMessageBody validates the exact {\"text\"} body.\n311|func decodeMessageBody(record NativeRecord) (messageBody, error) {\n312|\tmembers, err := decodeBodyObject(record, []string{\"text\"}, map[string]bool{\"text\": true})\n313|\tif err != nil {\n314|\t\treturn messageBody{}, err\n315|\t}\n316|\ttext, err := bodyString(record, members, \"text\")\n317|\tif err != nil {\n318|\t\treturn messageBody{}, err\n319|\t}\n320|\treturn messageBody{Text: text}, nil\n321|}\n322|\n323|// protectedBody is the exact protected-reasoning body: ciphertext\n324|// the projection never reads, only preserves byte-exact.\n325|type protectedBody struct {\n326|\tCiphertext string\n327|}\n328|\n329|// decodeProtectedBody validates the exact {\"ciphertext\"} body. The\n330|// value is framing-checked as a string and never interpreted.\n331|func decodeProtectedBody(record NativeRecord) (protectedBody, error) {\n332|\tmembers, err := decodeBodyObject(record, []string{\"ciphertext\"}, map[string]bool{\"ciphertext\": true})\n333|\tif err != nil {\n334|\t\treturn protectedBody{}, err\n335|\t}\n336|\tciphertext, err := bodyString(record, members, \"ciphertext\")\n337|\tif err != nil {\n338|\t\treturn protectedBody{}, err\n339|\t}\n340|\treturn protectedBody{Ciphertext: ciphertext}, nil\n341|}\n342|\n343|// instructionBody is the exact instruction-snapshot body.\n344|type instructionBody struct {\n345|\tAuthority  string\n346|\tDirectives []string\n347|}\n348|\n349|// decodeInstructionBody validates authority high|low and up to 1024\n350|// directives of 1..4096 characters each.\n351|func decodeInstructionBody(record NativeRecord) (instructionBody, error) {\n352|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n353|\tmembers, err := decodeBodyObject(record, []string{\"authority\", \"directives\"}, map[string]bool{\"authority\": true, \"directives\": true})\n354|\tif err != nil {\n355|\t\treturn instructionBody{}, err\n356|\t}\n357|\tauthority, err := bodyString(record, members, \"authority\")\n358|\tif err != nil {\n359|\t\treturn instructionBody{}, err\n360|\t}\n361|\tif authority != \"high\" && authority != \"low\" {\n362|\t\treturn instructionBody{}, invalid(\"%s body authority %q is outside high|low\", where, authority)\n363|\t}\n364|\tvar directives []string\n365|\tif err := json.Unmarshal(members[\"directives\"], &directives); err != nil {\n366|\t\treturn instructionBody{}, invalid(\"%s body member %q is not an array of strings\", where, \"directives\")\n367|\t}\n368|\tif len(directives) > 1024 {\n369|\t\treturn instructionBody{}, invalid(\"%s body carries %d directives, maximum is 1024\", where, len(directives))\n370|\t}\n371|\tfor index, directive := range directives {\n372|\t\tif environ.StringLength(directive) < 1 || environ.StringLength(directive) > 4096 {\n373|\t\t\treturn instructionBody{}, invalid(\"%s body directive[%d] is not a string[1..4096]\", where, index)\n374|\t\t}\n375|\t}\n376|\treturn instructionBody{Authority: authority, Directives: directives}, nil\n377|}\n378|\n379|// toolDefinitionBody is the exact tool-definition body.\n380|type toolDefinitionBody struct {\n381|\tToolName       string\n382|\tDefinitionHash string\n383|\tLiveClaim      bool\n384|}\n385|\n386|// decodeToolDefinitionBody validates the exact definition body. A\n387|// live_attestation claim is parsed so the live-surface gate can\n388|// refuse it: captured history can never self-promote.\n389|func decodeToolDefinitionBody(record NativeRecord) (toolDefinitionBody, error) {\n390|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n391|\tmembers, err := decodeBodyObject(record,\n392|\t\t[]string{\"tool_name\", \"definition_digest\"},\n393|\t\tmap[string]bool{\"tool_name\": true, \"definition_digest\": true, \"live_attestation\": true})\n394|\tif err != nil {\n395|\t\treturn toolDefinitionBody{}, err\n396|\t}\n397|\tname, err := bodyString(record, members, \"tool_name\")\n398|\tif err != nil {\n399|\t\treturn toolDefinitionBody{}, err\n400|\t}\n401|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n402|\t\treturn toolDefinitionBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n403|\t}\n404|\tdigest, err := bodyString(record, members, \"definition_digest\")\n405|\tif err != nil {\n406|\t\treturn toolDefinitionBody{}, err\n407|\t}\n408|\tlive, err := bodyOptionalBool(record, members, \"live_attestation\")\n409|\tif err != nil {\n410|\t\treturn toolDefinitionBody{}, err\n411|\t}\n412|\treturn toolDefinitionBody{ToolName: name, DefinitionHash: digest, LiveClaim: live}, nil\n413|}\n414|\n415|// toolCallBody is the exact tool-call body.\n416|type toolCallBody struct {\n417|\tCallID   string\n418|\tToolName string\n419|}\n420|\n421|// decodeToolCallBody validates the exact call body.\n422|func decodeToolCallBody(record NativeRecord) (toolCallBody, error) {\n423|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n424|\tmembers, err := decodeBodyObject(record,\n425|\t\t[]string{\"call_id\", \"tool_name\"},\n426|\t\tmap[string]bool{\"call_id\": true, \"tool_name\": true})\n427|\tif err != nil {\n428|\t\treturn toolCallBody{}, err\n429|\t}\n430|\tcallID, err := bodyString(record, members, \"call_id\")\n431|\tif err != nil {\n432|\t\treturn toolCallBody{}, err\n433|\t}\n434|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n435|\t\treturn toolCallBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n436|\t}\n437|\tname, err := bodyString(record, members, \"tool_name\")\n438|\tif err != nil {\n439|\t\treturn toolCallBody{}, err\n440|\t}\n441|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n442|\t\treturn toolCallBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n443|\t}\n444|\treturn toolCallBody{CallID: callID, ToolName: name}, nil\n445|}\n446|\n447|// toolResultBody is the exact tool-result body.\n448|type toolResultBody struct {\n449|\tCallID       string\n450|\tStatus       string\n451|\tLiveFollowup bool\n452|}\n453|\n454|// decodeToolResultBody validates the exact result body. A\n455|// live_followup claim is parsed so the resolution gate can refuse\n456|// it: captured history can never request a live action.\n457|func decodeToolResultBody(record NativeRecord) (toolResultBody, error) {\n458|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n459|\tmembers, err := decodeBodyObject(record,\n460|\t\t[]string{\"call_id\", \"status\"},\n461|\t\tmap[string]bool{\"call_id\": true, \"status\": true, \"live_followup\": true})\n462|\tif err != nil {\n463|\t\treturn toolResultBody{}, err\n464|\t}\n465|\tcallID, err := bodyString(record, members, \"call_id\")\n466|\tif err != nil {\n467|\t\treturn toolResultBody{}, err\n468|\t}\n469|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n470|\t\treturn toolResultBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n471|\t}\n472|\tstatus, err := bodyString(record, members, \"status\")\n473|\tif err != nil {\n474|\t\treturn toolResultBody{}, err\n475|\t}\n476|\tif status != \"ok\" && status != \"error\" {\n477|\t\treturn toolResultBody{}, invalid(\"%s body status %q is outside ok|error\", where, status)\n478|\t}\n479|\tfollowup, err := bodyOptionalBool(record, members, \"live_followup\")\n480|\tif err != nil {\n481|\t\treturn toolResultBody{}, err\n482|\t}\n483|\treturn toolResultBody{CallID: callID, Status: status, LiveFollowup: followup}, nil\n484|}\n485|\n486|// usageBody is the exact usage-report body.\n487|type usageBody struct {\n488|\tInputTokens  uint64\n489|\tOutputTokens uint64\n490|}\n491|\n492|// decodeUsageBody validates the exact token body.\n493|func decodeUsageBody(record NativeRecord) (usageBody, error) {\n494|\tmembers, err := decodeBodyObject(record,\n495|\t\t[]string{\"input_tokens\", \"output_tokens\"},\n496|\t\tmap[string]bool{\"input_tokens\": true, \"output_tokens\": true})\n497|\tif err != nil {\n498|\t\treturn usageBody{}, err\n499|\t}\n500|\tinput, err := bodyUint53(record, members, \"input_tokens\")\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ed","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":337,"recorded_at":1780531400000669,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"task_stream":{"kind":"task","id":"01a0b3c7-4077-70b2-bec9-df161b4e9777"},"task_id":"01a0b3c7-4077-70b2-bec9-df161b4e9777","event":{"kind":"completed","task_id":"01a0b3c7-4077-70b2-bec9-df161b4e9777"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ef","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":338,"recorded_at":1780531400000671,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"call_id":"call_01a0b3c73c4d71eebd04c8cd6634f391","text":"Read text file `internal/cloneproject/native.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"unicode/utf8\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|)\n12|\n13|// This file parses the fixture-native record envelope. The envelope\n14|// is test-defined framing, not a specification shape: its only job\n15|// is to carry attributable bytes (native ID, native type, origin,\n16|// protection, actor, body) from captured members to the projection.\n17|// Every per-kind body shape below is exact: unknown body members\n18|// refuse rather than silently drop, so a projection can never claim\n19|// a faithful kind while ignoring a fact it does not understand. Type\n20|// level unknowns become opaque_event; field level unknowns inside a\n21|// known type refuse (see doc.go).\n22|\n23|// NativeRecord is one parsed fixture-native record with its byte\n24|// range inside the member blob.\n25|type NativeRecord struct {\n26|\t// MemberKey is the capture native item key holding the record.\n27|\tMemberKey string\n28|\t// Line is the one-based line number inside the member.\n29|\tLine int\n30|\t// Offset and Length are the record's byte range: the line\n31|\t// without its newline terminator.\n32|\tOffset uint64\n33|\tLength uint64\n34|\t// NativeEventID and NativeType attribute the record.\n35|\tNativeEventID string\n36|\tNativeType    string\n37|\t// Origin is native or foreign.\n38|\tOrigin string\n39|\t// Protection is none, encrypted, or signed.\n40|\tProtection string\n41|\t// Actor is main, external, or subagent:<name>.\n42|\tActor string\n43|\t// Body carries the raw body value; kind code reads only its\n44|\t// registered members.\n45|\tBody json.RawMessage\n46|\t// LineBytes are the exact record bytes preserved for opaque kinds.\n47|\tLineBytes []byte\n48|}\n49|\n50|// nativeEnvelope is the decoded envelope shape. Body stays raw:\n51|// each known type validates its own exact members.\n52|type nativeEnvelope struct {\n53|\tVersion       json.Number     `json:\"v\"`\n54|\tNativeEventID string          `json:\"native_event_id\"`\n55|\tNativeType    string          `json:\"native_type\"`\n56|\tOrigin        string          `json:\"origin\"`\n57|\tProtection    string          `json:\"protection\"`\n58|\tActor         string          `json:\"actor\"`\n59|\tBody          json.RawMessage `json:\"body\"`\n60|}\n61|\n62|// parseNativeLine parses one record line. A line that is not valid\n63|// UTF-8, not a JSON object, or misses an envelope member refuses\n64|// with the member and line named: malformed framing is an error,\n65|// never an absent or guessed record.\n66|func parseNativeLine(memberKey string, line int, offset uint64, raw []byte) (NativeRecord, error) {\n67|\twhere := func() string {\n68|\t\treturn \"record \" + memberKey + \" line \" + itoa(line)\n69|\t}\n70|\tif !utf8.Valid(raw) {\n71|\t\treturn NativeRecord{}, invalid(\"%s is not valid UTF-8\", where())\n72|\t}\n73|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n74|\tdecoder.UseNumber()\n75|\tvar members map[string]json.RawMessage\n76|\tif err := decoder.Decode(&members); err != nil {\n77|\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n78|\t}\n79|\tif decoder.More() {\n80|\t\treturn NativeRecord{}, invalid(\"%s carries trailing bytes\", where())\n81|\t}\n82|\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\n83|\t\tif _, ok := members[name]; !ok {\n84|\t\t\treturn NativeRecord{}, invalid(\"%s misses envelope member %q\", where(), name)\n85|\t\t}\n86|\t}\n87|\tvar envelope nativeEnvelope\n88|\tstrict := json.NewDecoder(bytes.NewReader(raw))\n89|\tstrict.UseNumber()\n90|\tif err := strict.Decode(&envelope); err != nil {\n91|\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n92|\t}\n93|\tif envelope.Version.String() != \"1\" {\n94|\t\treturn NativeRecord{}, invalid(\"%s carries envelope version %q, want 1\", where(), envelope.Version.String())\n95|\t}\n96|\tif environ.StringLength(envelope.NativeEventID) < 1 || environ.StringLength(envelope.NativeEventID) > 512 {\n97|\t\treturn NativeRecord{}, invalid(\"%s native_event_id is not a string[1..512]\", where())\n98|\t}\n99|\tif environ.StringLength(envelope.NativeType) < 1 || environ.StringLength(envelope.NativeType) > 512 {\n100|\t\treturn NativeRecord{}, invalid(\"%s native_type is not a string[1..512]\", where())\n101|\t}\n102|\tif envelope.Origin != \"native\" && envelope.Origin != \"foreign\" {\n103|\t\treturn NativeRecord{}, invalid(\"%s origin %q is outside native|foreign\", where(), envelope.Origin)\n104|\t}\n105|\tif envelope.Protection != \"none\" && envelope.Protection != \"encrypted\" && envelope.Protection != \"signed\" {\n106|\t\treturn NativeRecord{}, invalid(\"%s protection %q is outside none|encrypted|signed\", where(), envelope.Protection)\n107|\t}\n108|\tif err := checkActorSelector(envelope.Actor); err != nil {\n109|\t\treturn NativeRecord{}, invalid(\"%s %v\", where(), err)\n110|\t}\n111|\treturn NativeRecord{\n112|\t\tMemberKey:     memberKey,\n113|\t\tLine:          line,\n114|\t\tOffset:        offset,\n115|\t\tLength:        uint64(len(raw)),\n116|\t\tNativeEventID: envelope.NativeEventID,\n117|\t\tNativeType:    envelope.NativeType,\n118|\t\tOrigin:        envelope.Origin,\n119|\t\tProtection:    envelope.Protection,\n120|\t\tActor:         envelope.Actor,\n121|\t\tBody:          envelope.Body,\n122|\t\tLineBytes:     append([]byte(nil), raw...),\n123|\t}, nil\n124|}\n125|\n126|// checkActorSelector validates main, external, or subagent:<name>\n127|// with a bounded non-empty name.\n128|func checkActorSelector(selector string) error {\n129|\tif selector == \"main\" || selector == \"external\" {\n130|\t\treturn nil\n131|\t}\n132|\tname, ok := strings.CutPrefix(selector, \"subagent:\")\n133|\tif !ok || name == \"\" {\n134|\t\treturn invalid(\"actor %q is outside main|external|subagent:<name>\", selector)\n135|\t}\n136|\tif environ.StringLength(name) > 128 {\n137|\t\treturn invalid(\"actor %q names a subagent past 128 characters\", selector)\n138|\t}\n139|\treturn nil\n140|}\n141|\n142|// splitRecordLines splits member bytes into record lines with byte\n143|// offsets. A zero-byte member holds zero records; otherwise one\n144|// trailing newline is the terminator and every remaining line must\n145|// be non-empty: a blank line is malformed framing, never an absent\n146|// record.\n147|func splitRecordLines(memberKey string, payload []byte) ([]recordLine, error) {\n148|\tif len(payload) == 0 {\n149|\t\treturn nil, nil\n150|\t}\n151|\trest := payload\n152|\tif rest[len(rest)-1] == '\\n' {\n153|\t\trest = rest[:len(rest)-1]\n154|\t}\n155|\tvar lines []recordLine\n156|\toffset := uint64(0)\n157|\tnumber := 1\n158|\tfor {\n159|\t\tend := bytes.IndexByte(rest, '\\n')\n160|\t\tvar raw []byte\n161|\t\tif end < 0 {\n162|\t\t\traw = rest\n163|\t\t\trest = nil\n164|\t\t} else {\n165|\t\t\traw = rest[:end]\n166|\t\t\trest = rest[end+1:]\n167|\t\t}\n168|\t\tif len(raw) == 0 {\n169|\t\t\treturn nil, invalid(\"record %s line %d is empty\", memberKey, number)\n170|\t\t}\n171|\t\tlines = append(lines, recordLine{number: number, offset: offset, raw: raw})\n172|\t\toffset += uint64(len(raw)) + 1\n173|\t\tnumber++\n174|\t\tif rest == nil {\n175|\t\t\tbreak\n176|\t\t}\n177|\t}\n178|\treturn lines, nil\n179|}\n180|\n181|// recordLine is one split line with its number and byte offset.\n182|type recordLine struct {\n183|\tnumber int\n184|\toffset uint64\n185|\traw    []byte\n186|}\n187|\n188|// itoa renders a line number for refusal messages.\n189|func itoa(value int) string {\n190|\treturn strconv.Itoa(value)\n191|}\n192|\n193|// Known fixture-native types. Every other native_type projects as\n194|// opaque_event.\n195|const (\n196|\tnativeMessageUser      = \"message/user\"\n197|\tnativeMessageAssistant = \"message/assistant\"\n198|\tnativeReasoningSummary = \"reasoning/summary\"\n199|\tnativeReasoningCrypt   = \"reasoning/encrypted\"\n200|\tnativeReasoningSigned  = \"reasoning/signed\"\n201|\tnativeInstruction      = \"instruction/snapshot\"\n202|\tnativeToolDefinition   = \"tool/definition\"\n203|\tnativeToolCall         = \"tool/call\"\n204|\tnativeToolResult       = \"tool/result\"\n205|\tnativeUsage            = \"usage/report\"\n206|)\n207|\n208|// knownNativeType reports whether the native type selects a\n209|// registered projection. Unknown types become opaque_event.\n210|func knownNativeType(nativeType string) bool {\n211|\tswitch nativeType {\n212|\tcase nativeMessageUser,\n213|\t\tnativeMessageAssistant,\n214|\t\tnativeReasoningSummary,\n215|\t\tnativeReasoningCrypt,\n216|\t\tnativeReasoningSigned,\n217|\t\tnativeInstruction,\n218|\t\tnativeToolDefinition,\n219|\t\tnativeToolCall,\n220|\t\tnativeToolResult,\n221|\t\tnativeUsage:\n222|\t\treturn true\n223|\tdefault:\n224|\t\treturn false\n225|\t}\n226|}\n227|\n228|// decodeBodyObject decodes a body object with exact members: every\n229|// member must be registered for the type, and every required member\n230|// must be present. Unknown members refuse.\n231|func decodeBodyObject(record NativeRecord, required []string, allowed map[string]bool) (map[string]json.RawMessage, error) {\n232|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n233|\tdecoder := json.NewDecoder(bytes.NewReader(bytes.TrimSpace(record.Body)))\n234|\tdecoder.UseNumber()\n235|\tvar members map[string]json.RawMessage\n236|\tif err := decoder.Decode(&members); err != nil {\n237|\t\treturn nil, invalid(\"%s body is not a JSON object: %v\", where, err)\n238|\t}\n239|\tfor name := range members {\n240|\t\tif !allowed[name] {\n241|\t\t\treturn nil, invalid(\"%s body carries unknown member %q\", where, name)\n242|\t\t}\n243|\t}\n244|\tfor _, name := range required {\n245|\t\tif _, ok := members[name]; !ok {\n246|\t\t\treturn nil, invalid(\"%s body misses member %q\", where, name)\n247|\t\t}\n248|\t}\n249|\treturn members, nil\n250|}\n251|\n252|// bodyString reads one required string body member.\n253|func bodyString(record NativeRecord, members map[string]json.RawMessage, name string) (string, error) {\n254|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n255|\tvar value string\n256|\tif err := json.Unmarshal(members[name], &value); err != nil {\n257|\t\treturn \"\", invalid(\"%s body member %q is not a string\", where, name)\n258|\t}\n259|\treturn value, nil\n260|}\n261|\n262|// bodyOptionalBool reads one optional boolean body member.\n263|func bodyOptionalBool(record NativeRecord, members map[string]json.RawMessage, name string) (bool, error) {\n264|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n265|\traw, ok := members[name]\n266|\tif !ok {\n267|\t\treturn false, nil\n268|\t}\n269|\tvar value bool\n270|\tif err := json.Unmarshal(raw, &value); err != nil {\n271|\t\treturn false, invalid(\"%s body member %q is not a boolean\", where, name)\n272|\t}\n273|\treturn value, nil\n274|}\n275|\n276|// bodyUint53 reads one required uint53 body member: an integer\n277|// literal in [0..2^53-1], never a fraction, exponent, or string.\n278|func bodyUint53(record NativeRecord, members map[string]json.RawMessage, name string) (uint64, error) {\n279|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n280|\tdecoder := json.NewDecoder(bytes.NewReader(members[name]))\n281|\tdecoder.UseNumber()\n282|\tvar value json.Number\n283|\tif err := decoder.Decode(&value); err != nil {\n284|\t\treturn 0, invalid(\"%s body member %q is not a number\", where, name)\n285|\t}\n286|\ttext := value.String()\n287|\tif len(text) == 0 {\n288|\t\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\n289|\t}\n290|\tfor i := 0; i < len(text); i++ {\n291|\t\tif text[i] < '0' || text[i] > '9' {\n292|\t\t\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\n293|\t\t}\n294|\t}\n295|\tparsed, err := strconv.ParseUint(text, 10, 53)\n296|\tif err != nil {\n297|\t\treturn 0, invalid(\"%s body member %q exceeds uint53\", where, name)\n298|\t}\n299|\treturn parsed, nil\n300|}\n301|\n302|// maxUint53 is 2^53-1, the AX safe-integer ceiling.\n303|const maxUint53 = uint64(1<<53 - 1)\n304|\n305|// messageBody is the exact message/reasoning-summary body: text only.\n306|type messageBody struct {\n307|\tText string\n308|}\n309|\n310|// decodeMessageBody validates the exact {\"text\"} body.\n311|func decodeMessageBody(record NativeRecord) (messageBody, error) {\n312|\tmembers, err := decodeBodyObject(record, []string{\"text\"}, map[string]bool{\"text\": true})\n313|\tif err != nil {\n314|\t\treturn messageBody{}, err\n315|\t}\n316|\ttext, err := bodyString(record, members, \"text\")\n317|\tif err != nil {\n318|\t\treturn messageBody{}, err\n319|\t}\n320|\treturn messageBody{Text: text}, nil\n321|}\n322|\n323|// protectedBody is the exact protected-reasoning body: ciphertext\n324|// the projection never reads, only preserves byte-exact.\n325|type protectedBody struct {\n326|\tCiphertext string\n327|}\n328|\n329|// decodeProtectedBody validates the exact {\"ciphertext\"} body. The\n330|// value is framing-checked as a string and never interpreted.\n331|func decodeProtectedBody(record NativeRecord) (protectedBody, error) {\n332|\tmembers, err := decodeBodyObject(record, []string{\"ciphertext\"}, map[string]bool{\"ciphertext\": true})\n333|\tif err != nil {\n334|\t\treturn protectedBody{}, err\n335|\t}\n336|\tciphertext, err := bodyString(record, members, \"ciphertext\")\n337|\tif err != nil {\n338|\t\treturn protectedBody{}, err\n339|\t}\n340|\treturn protectedBody{Ciphertext: ciphertext}, nil\n341|}\n342|\n343|// instructionBody is the exact instruction-snapshot body.\n344|type instructionBody struct {\n345|\tAuthority  string\n346|\tDirectives []string\n347|}\n348|\n349|// decodeInstructionBody validates authority high|low and up to 1024\n350|// directives of 1..4096 characters each.\n351|func decodeInstructionBody(record NativeRecord) (instructionBody, error) {\n352|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n353|\tmembers, err := decodeBodyObject(record, []string{\"authority\", \"directives\"}, map[string]bool{\"authority\": true, \"directives\": true})\n354|\tif err != nil {\n355|\t\treturn instructionBody{}, err\n356|\t}\n357|\tauthority, err := bodyString(record, members, \"authority\")\n358|\tif err != nil {\n359|\t\treturn instructionBody{}, err\n360|\t}\n361|\tif authority != \"high\" && authority != \"low\" {\n362|\t\treturn instructionBody{}, invalid(\"%s body authority %q is outside high|low\", where, authority)\n363|\t}\n364|\tvar directives []string\n365|\tif err := json.Unmarshal(members[\"directives\"], &directives); err != nil {\n366|\t\treturn instructionBody{}, invalid(\"%s body member %q is not an array of strings\", where, \"directives\")\n367|\t}\n368|\tif len(directives) > 1024 {\n369|\t\treturn instructionBody{}, invalid(\"%s body carries %d directives, maximum is 1024\", where, len(directives))\n370|\t}\n371|\tfor index, directive := range directives {\n372|\t\tif environ.StringLength(directive) < 1 || environ.StringLength(directive) > 4096 {\n373|\t\t\treturn instructionBody{}, invalid(\"%s body directive[%d] is not a string[1..4096]\", where, index)\n374|\t\t}\n375|\t}\n376|\treturn instructionBody{Authority: authority, Directives: directives}, nil\n377|}\n378|\n379|// toolDefinitionBody is the exact tool-definition body.\n380|type toolDefinitionBody struct {\n381|\tToolName       string\n382|\tDefinitionHash string\n383|\tLiveClaim      bool\n384|}\n385|\n386|// decodeToolDefinitionBody validates the exact definition body. A\n387|// live_attestation claim is parsed so the live-surface gate can\n388|// refuse it: captured history can never self-promote.\n389|func decodeToolDefinitionBody(record NativeRecord) (toolDefinitionBody, error) {\n390|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n391|\tmembers, err := decodeBodyObject(record,\n392|\t\t[]string{\"tool_name\", \"definition_digest\"},\n393|\t\tmap[string]bool{\"tool_name\": true, \"definition_digest\": true, \"live_attestation\": true})\n394|\tif err != nil {\n395|\t\treturn toolDefinitionBody{}, err\n396|\t}\n397|\tname, err := bodyString(record, members, \"tool_name\")\n398|\tif err != nil {\n399|\t\treturn toolDefinitionBody{}, err\n400|\t}\n401|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n402|\t\treturn toolDefinitionBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n403|\t}\n404|\tdigest, err := bodyString(record, members, \"definition_digest\")\n405|\tif err != nil {\n406|\t\treturn toolDefinitionBody{}, err\n407|\t}\n408|\tlive, err := bodyOptionalBool(record, members, \"live_attestation\")\n409|\tif err != nil {\n410|\t\treturn toolDefinitionBody{}, err\n411|\t}\n412|\treturn toolDefinitionBody{ToolName: name, DefinitionHash: digest, LiveClaim: live}, nil\n413|}\n414|\n415|// toolCallBody is the exact tool-call body.\n416|type toolCallBody struct {\n417|\tCallID   string\n418|\tToolName string\n419|}\n420|\n421|// decodeToolCallBody validates the exact call body.\n422|func decodeToolCallBody(record NativeRecord) (toolCallBody, error) {\n423|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n424|\tmembers, err := decodeBodyObject(record,\n425|\t\t[]string{\"call_id\", \"tool_name\"},\n426|\t\tmap[string]bool{\"call_id\": true, \"tool_name\": true})\n427|\tif err != nil {\n428|\t\treturn toolCallBody{}, err\n429|\t}\n430|\tcallID, err := bodyString(record, members, \"call_id\")\n431|\tif err != nil {\n432|\t\treturn toolCallBody{}, err\n433|\t}\n434|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n435|\t\treturn toolCallBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n436|\t}\n437|\tname, err := bodyString(record, members, \"tool_name\")\n438|\tif err != nil {\n439|\t\treturn toolCallBody{}, err\n440|\t}\n441|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n442|\t\treturn toolCallBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n443|\t}\n444|\treturn toolCallBody{CallID: callID, ToolName: name}, nil\n445|}\n446|\n447|// toolResultBody is the exact tool-result body.\n448|type toolResultBody struct {\n449|\tCallID       string\n450|\tStatus       string\n451|\tLiveFollowup bool\n452|}\n453|\n454|// decodeToolResultBody validates the exact result body. A\n455|// live_followup claim is parsed so the resolution gate can refuse\n456|// it: captured history can never request a live action.\n457|func decodeToolResultBody(record NativeRecord) (toolResultBody, error) {\n458|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n459|\tmembers, err := decodeBodyObject(record,\n460|\t\t[]string{\"call_id\", \"status\"},\n461|\t\tmap[string]bool{\"call_id\": true, \"status\": true, \"live_followup\": true})\n462|\tif err != nil {\n463|\t\treturn toolResultBody{}, err\n464|\t}\n465|\tcallID, err := bodyString(record, members, \"call_id\")\n466|\tif err != nil {\n467|\t\treturn toolResultBody{}, err\n468|\t}\n469|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n470|\t\treturn toolResultBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n471|\t}\n472|\tstatus, err := bodyString(record, members, \"status\")\n473|\tif err != nil {\n474|\t\treturn toolResultBody{}, err\n475|\t}\n476|\tif status != \"ok\" && status != \"error\" {\n477|\t\treturn toolResultBody{}, invalid(\"%s body status %q is outside ok|error\", where, status)\n478|\t}\n479|\tfollowup, err := bodyOptionalBool(record, members, \"live_followup\")\n480|\tif err != nil {\n481|\t\treturn toolResultBody{}, err\n482|\t}\n483|\treturn toolResultBody{CallID: callID, Status: status, LiveFollowup: followup}, nil\n484|}\n485|\n486|// usageBody is the exact usage-report body.\n487|type usageBody struct {\n488|\tInputTokens  uint64\n489|\tOutputTokens uint64\n490|}\n491|\n492|// decodeUsageBody validates the exact token body.\n493|func decodeUsageBody(record NativeRecord) (usageBody, error) {\n494|\tmembers, err := decodeBodyObject(record,\n495|\t\t[]string{\"input_tokens\", \"output_tokens\"},\n496|\t\tmap[string]bool{\"input_tokens\": true, \"output_tokens\": true})\n497|\tif err != nil {\n498|\t\treturn usageBody{}, err\n499|\t}\n500|\tinput, err := bodyUint53(record, members, \"input_tokens\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"call_id":"call_01a0b3c73d94727b88560bbee540f161","text":"Read text file `internal/cloneproject/dispatch.go`.\n1|package cloneproject\n2|\n3|// This file dispatches projection units to Canonical Event kinds,\n4|// builds every event and the session through the landed builders,\n5|// and re-decodes each sealed byte before it enters the result.\n6|\n7|import (\n8|\t\"encoding/json\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// isReasoningType reports whether the native type is a reasoning\n17|// type. Protected reasoning becomes opaque_reasoning; protected\n18|// anything else becomes opaque_event.\n19|func isReasoningType(nativeType string) bool {\n20|\tswitch nativeType {\n21|\tcase nativeReasoningSummary, nativeReasoningCrypt, nativeReasoningSigned:\n22|\t\treturn true\n23|\tdefault:\n24|\t\treturn false\n25|\t}\n26|}\n27|\n28|// dispatchUnits selects kind, visibility, payload, and reasons for\n29|// every unit. Protection is decided before type: unreadable content\n30|// never reaches a semantic kind.\n31|func (plan *projectionPlan) dispatchUnits() error {\n32|\tresolutions := map[string]ToolResolution{}\n33|\tfor _, resolution := range plan.resolutions {\n34|\t\tresolutions[resolution.CallID] = resolution\n35|\t}\n36|\tfor index := range plan.units {\n37|\t\tunit := &plan.units[index]\n38|\t\tif unit.memberOpaque {\n39|\t\t\tunit.kind = \"opaque_event\"\n40|\t\t\tunit.visibility = \"opaque\"\n41|\t\t\tunit.payload = map[string]any{\n42|\t\t\t\t\"native_item_key\":    unit.record.MemberKey,\n43|\t\t\t\t\"byte_count\":         unit.record.Length,\n44|\t\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n45|\t\t\t\t\"extensions\":         map[string]any{},\n46|\t\t\t}\n47|\t\t\tunit.reasons = []string{reasonUnknownNative}\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\tif err := plan.dispatchRecord(unit, resolutions); err != nil {\n51|\t\t\treturn err\n52|\t\t}\n53|\t}\n54|\treturn nil\n55|}\n56|\n57|// dispatchRecord dispatches one parsed record.\n58|func (plan *projectionPlan) dispatchRecord(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n59|\trecord := unit.record\n60|\tif record.Protection != \"none\" {\n61|\t\treturn plan.dispatchProtected(unit)\n62|\t}\n63|\tswitch record.NativeType {\n64|\tcase nativeMessageUser, nativeMessageAssistant:\n65|\t\treturn plan.dispatchMessage(unit)\n66|\tcase nativeReasoningSummary:\n67|\t\treturn plan.dispatchMessage(unit)\n68|\tcase nativeReasoningCrypt, nativeReasoningSigned:\n69|\t\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n70|\t\treturn invalid(\"%s declares %s with no protection\", where, record.NativeType)\n71|\tcase nativeInstruction:\n72|\t\treturn plan.dispatchInstruction(unit)\n73|\tcase nativeToolDefinition:\n74|\t\treturn plan.dispatchDefinition(unit)\n75|\tcase nativeToolCall:\n76|\t\treturn plan.dispatchCall(unit, resolutions)\n77|\tcase nativeToolResult:\n78|\t\treturn plan.dispatchResult(unit, resolutions)\n79|\tcase nativeUsage:\n80|\t\treturn plan.dispatchUsage(unit)\n81|\tdefault:\n82|\t\tunit.kind = \"opaque_event\"\n83|\t\tunit.visibility = \"opaque\"\n84|\t\tunit.payload = map[string]any{\n85|\t\t\t\"native_type\":        record.NativeType,\n86|\t\t\t\"byte_count\":         record.Length,\n87|\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n88|\t\t\t\"extensions\":         map[string]any{},\n89|\t\t}\n90|\t\tunit.reasons = []string{reasonUnknownNative}\n91|\t\treturn nil\n92|\t}\n93|}\n94|\n95|// dispatchProtected dispatches a protected record: protection\n96|// defines the body shape (exactly ciphertext, never interpreted),\n97|// and the kind is opaque. Reasoning stays opaque_reasoning;\n98|// anything else becomes opaque_event.\n99|func (plan *projectionPlan) dispatchProtected(unit *projectionUnit) error {\n100|\trecord := unit.record\n101|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n102|\tif _, err := decodeProtectedBody(record); err != nil {\n103|\t\treturn err\n104|\t}\n105|\tswitch record.NativeType {\n106|\tcase nativeReasoningCrypt:\n107|\t\tif record.Protection != \"encrypted\" {\n108|\t\t\treturn invalid(\"%s declares reasoning/encrypted with protection %q\", where, record.Protection)\n109|\t\t}\n110|\tcase nativeReasoningSigned:\n111|\t\tif record.Protection != \"signed\" {\n112|\t\t\treturn invalid(\"%s declares reasoning/signed with protection %q\", where, record.Protection)\n113|\t\t}\n114|\t}\n115|\treasons := cryptoReasons(record)\n116|\tif !knownNativeType(record.NativeType) {\n117|\t\treasons = append(reasons, reasonUnknownNative)\n118|\t\tsort.Strings(reasons)\n119|\t}\n120|\tif isReasoningType(record.NativeType) {\n121|\t\tunit.kind = \"opaque_reasoning\"\n122|\t\tunit.visibility = \"opaque\"\n123|\t\tunit.payload = map[string]any{\n124|\t\t\t\"protection\":         record.Protection,\n125|\t\t\t\"byte_count\":         record.Length,\n126|\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n127|\t\t\t\"extensions\":         map[string]any{},\n128|\t\t}\n129|\t\tunit.reasons = reasons\n130|\t\treturn nil\n131|\t}\n132|\tunit.kind = \"opaque_event\"\n133|\tunit.visibility = \"opaque\"\n134|\tunit.payload = map[string]any{\n135|\t\t\"native_type\":        record.NativeType,\n136|\t\t\"protection\":         record.Protection,\n137|\t\t\"byte_count\":         record.Length,\n138|\t\t\"blob_descriptor_id\": unit.descriptorID,\n139|\t\t\"extensions\":         map[string]any{},\n140|\t}\n141|\tunit.reasons = reasons\n142|\treturn nil\n143|}\n144|\n145|// cryptoReasons selects the stable reason for a protected record:\n146|// the foreign core reason when the origin is foreign, no reason\n147|// when native (no core code fits native-protected content; the\n148|// payload protection fact carries the cause).\n149|func cryptoReasons(record NativeRecord) []string {\n150|\tif record.Origin != \"foreign\" {\n151|\t\treturn nil\n152|\t}\n153|\tif record.Protection == \"signed\" {\n154|\t\treturn []string{reasonForeignSigned}\n155|\t}\n156|\treturn []string{reasonForeignEncrypted}\n157|}\n158|\n159|// dispatchMessage dispatches a message or reasoning summary: the\n160|// exact text body becomes one text content block, inline or\n161|// overflow-referenced.\n162|func (plan *projectionPlan) dispatchMessage(unit *projectionUnit) error {\n163|\trecord := unit.record\n164|\tbody, err := decodeMessageBody(record)\n165|\tif err != nil {\n166|\t\treturn err\n167|\t}\n168|\tblock, installed, err := contentBlockForText(body.Text, plan.request.CanonicalSink)\n169|\tif err != nil {\n170|\t\treturn err\n171|\t}\n172|\tplan.overflows = append(plan.overflows, installed...)\n173|\tswitch record.NativeType {\n174|\tcase nativeMessageUser:\n175|\t\tunit.kind = \"user_message\"\n176|\t\tunit.visibility = \"public\"\n177|\tcase nativeMessageAssistant:\n178|\t\tunit.kind = \"assistant_message\"\n179|\t\tunit.visibility = \"public\"\n180|\tdefault:\n181|\t\tunit.kind = \"reasoning_summary\"\n182|\t\tunit.visibility = \"internal\"\n183|\t}\n184|\tunit.payload = map[string]any{\n185|\t\t\"content_blocks\": []any{block},\n186|\t\t\"extensions\":     map[string]any{},\n187|\t}\n188|\treturn nil\n189|}\n190|\n191|// dispatchInstruction dispatches an instruction snapshot: foreign\n192|// instructions pin low authority, native instructions carry their\n193|// claimed authority.\n194|func (plan *projectionPlan) dispatchInstruction(unit *projectionUnit) error {\n195|\trecord := unit.record\n196|\tbody := unit.instruction\n197|\tauthority := body.Authority\n198|\tif record.Origin != \"native\" {\n199|\t\tauthority = \"low\"\n200|\t}\n201|\tdirectives := make([]any, 0, len(body.Directives))\n202|\tfor _, directive := range body.Directives {\n203|\t\tdirectives = append(directives, directive)\n204|\t}\n205|\tunit.kind = \"instruction_snapshot\"\n206|\tunit.visibility = \"internal\"\n207|\tunit.payload = map[string]any{\n208|\t\t\"authority\":  authority,\n209|\t\t\"directives\": directives,\n210|\t\t\"extensions\": map[string]any{},\n211|\t}\n212|\treturn nil\n213|}\n214|\n215|// dispatchDefinition dispatches a tool definition snapshot: history\n216|// with callable pinned false. Registration never happens here; the\n217|// live surface refused live claims before dispatch ran.\n218|func (plan *projectionPlan) dispatchDefinition(unit *projectionUnit) error {\n219|\tbody := unit.definition\n220|\tunit.kind = \"tool_definition_snapshot\"\n221|\tunit.visibility = \"internal\"\n222|\tunit.payload = map[string]any{\n223|\t\t\"tool_name\":         body.ToolName,\n224|\t\t\"definition_digest\": body.DefinitionHash,\n225|\t\t\"callable\":          false,\n226|\t\t\"extensions\":        map[string]any{},\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// dispatchCall dispatches a tool call with its folded resolution.\n232|func (plan *projectionPlan) dispatchCall(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n233|\tbody := unit.call\n234|\tresolution, ok := resolutions[body.CallID]\n235|\tif !ok {\n236|\t\treturn invalid(\"tool call %q has no folded resolution\", body.CallID)\n237|\t}\n238|\tunit.kind = \"tool_call\"\n239|\tunit.visibility = \"internal\"\n240|\tunit.payload = map[string]any{\n241|\t\t\"call_id\":    body.CallID,\n242|\t\t\"tool_name\":  body.ToolName,\n243|\t\t\"resolution\": resolution.Status,\n244|\t\t\"extensions\": map[string]any{},\n245|\t}\n246|\tif resolution.Status == StatusAborted {\n247|\t\tunit.reasons = []string{reasonUnsafePending}\n248|\t}\n249|\treturn nil\n250|}\n251|\n252|// dispatchResult dispatches a tool result with its folded\n253|// resolution: completed when paired, aborted history when orphaned.\n254|func (plan *projectionPlan) dispatchResult(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n255|\tbody := unit.result\n256|\tresolution, ok := resolutions[body.CallID]\n257|\tif !ok {\n258|\t\treturn invalid(\"tool result %q has no folded resolution\", body.CallID)\n259|\t}\n260|\tunit.kind = \"tool_result\"\n261|\tunit.visibility = \"internal\"\n262|\tunit.payload = map[string]any{\n263|\t\t\"call_id\":    body.CallID,\n264|\t\t\"status\":     body.Status,\n265|\t\t\"resolution\": resolution.Status,\n266|\t\t\"extensions\": map[string]any{},\n267|\t}\n268|\tif resolution.Status == StatusAborted {\n269|\t\tunit.reasons = []string{reasonUnsafePending}\n270|\t}\n271|\treturn nil\n272|}\n273|\n274|// dispatchUsage dispatches a usage report: source tokens into the\n275|// payload; target accounting is never written anywhere.\n276|func (plan *projectionPlan) dispatchUsage(unit *projectionUnit) error {\n277|\tbody := unit.usage\n278|\tunit.kind = \"usage\"\n279|\tunit.visibility = \"internal\"\n280|\tunit.payload = map[string]any{\n281|\t\t\"input_tokens\":  body.InputTokens,\n282|\t\t\"output_tokens\": body.OutputTokens,\n283|\t\t\"extensions\":    map[string]any{},\n284|\t}\n285|\treturn nil\n286|}\n287|\n288|// actorSet is the resolved actor UUIDs by selector.\n289|type actorSet struct {\n290|\tmain  scalar.UUIDv7\n291|\textra map[string]scalar.UUIDv7\n292|}\n293|\n294|// checkActors resolves every referenced selector: main plus exactly\n295|// the mapped extras. A referenced selector without a mapping, or a\n296|// mapping without a reference, refuses.\n297|func (plan *projectionPlan) checkActors() error {\n298|\treferenced := map[string]bool{}\n299|\tfor _, unit := range plan.units {\n300|\t\treferenced[unit.record.Actor] = true\n301|\t}\n302|\tfor selector := range referenced {\n303|\t\tif selector == \"main\" {\n304|\t\t\tcontinue\n305|\t\t}\n306|\t\tif _, ok := plan.extraActors[selector]; !ok {\n307|\t\t\treturn invalid(\"projection references actor %q with no mapped UUID\", selector)\n308|\t\t}\n309|\t}\n310|\tfor selector := range plan.extraActors {\n311|\t\tif !referenced[selector] {\n312|\t\t\treturn invalid(\"projection maps actor %q with no referencing record\", selector)\n313|\t\t}\n314|\t}\n315|\treturn nil\n316|}\n317|\n318|// buildEvents dispatches every unit and seals the events in record\n319|// order: contiguous ordinals from zero, each event parented on its\n320|// predecessor, each sealed byte re-decoded before use.\n321|func (plan *projectionPlan) buildEvents() error {\n322|\tif err := plan.dispatchUnits(); err != nil {\n323|\t\treturn err\n324|\t}\n325|\tactors := actorSet{main: plan.mainActor, extra: plan.extraActors}\n326|\tvar previous *scalar.Digest\n327|\tfor index := range plan.units {\n328|\t\tunit := &plan.units[index]\n329|\t\tactor, ok := actors.extra[unit.record.Actor]\n330|\t\tif unit.record.Actor == \"main\" {\n331|\t\t\tactor, ok = actors.main, true\n332|\t\t}\n333|\t\tif !ok {\n334|\t\t\treturn invalid(\"projection cannot resolve actor %q to a mapped UUID\", unit.record.Actor)\n335|\t\t}\n336|\t\tparents := []string{}\n337|\t\tif previous != nil {\n338|\t\t\tparents = []string{previous.String()}\n339|\t\t}\n340|\t\tpayload, err := json.Marshal(unit.payload)\n341|\t\tif err != nil {\n342|\t\t\treturn invalid(\"projection cannot marshal event payload: %v\", err)\n343|\t\t}\n344|\t\tinput := clonebundle.CanonicalEventInput{\n345|\t\t\tLogicalSessionID: plan.logical.String(),\n346|\t\t\tOrdinal:          uint64(index),\n347|\t\t\tParents:          parents,\n348|\t\t\tActorID:          actor.String(),\n349|\t\t\tKind:             unit.kind,\n350|\t\t\tVisibility:       unit.visibility,\n351|\t\t\tPayload:          payload,\n352|\t\t\tEvidence:         plan.evidenceFor(unit),\n353|\t\t\tExtensions:       map[string]any{},\n354|\t\t}\n355|\t\tsealed, err := clonebundle.BuildCanonicalEvent(input)\n356|\t\tif err != nil {\n357|\t\t\treturn invalid(\"projection cannot seal ordinal %d (%s): %v\", index, unit.kind, err)\n358|\t\t}\n359|\t\tdecoded, err := clonebundle.DecodeCanonicalEvent(sealed)\n360|\t\tif err != nil {\n361|\t\t\treturn invalid(\"sealed ordinal %d refused: %v\", index, err)\n362|\t\t}\n363|\t\tplan.events = append(plan.events, sealed)\n364|\t\tplan.decodedEvents = append(plan.decodedEvents, decoded)\n365|\t\tplan.ordinals = append(plan.ordinals, uint64(index))\n366|\t\tidentifier := decoded.EventID\n367|\t\tprevious = &identifier\n368|\t}\n369|\tif err := clonebundle.CheckOrdinalContiguity(plan.ordinals); err != nil {\n370|\t\treturn err\n371|\t}\n372|\treturn nil\n373|}\n374|\n375|// evidenceFor builds the Source Evidence input for one unit: exact\n376|// capture status with the record's byte range inside its member\n377|// blob, so every reference resolves back to captured bytes.\n378|func (plan *projectionPlan) evidenceFor(unit *projectionUnit) clonebundle.EvidenceInput {\n379|\trecord := unit.record\n380|\tinput := clonebundle.EvidenceInput{\n381|\t\tEnvironment:     plan.environment,\n382|\t\tNativeSessionID: plan.raw.SourceNativeSessionID,\n383|\t\tRawRefs: []clonebundle.RawRefInput{{\n384|\t\t\tManifestID:       plan.raw.ManifestID.String(),\n385|\t\t\tBlobDescriptorID: unit.descriptorID,\n386|\t\t\tOffset:           record.Offset,\n387|\t\t\tLength:           record.Length,\n388|\t\t}},\n389|\t\tCaptureStatus: \"exact\",\n390|\t\tReasonCodes:   append([]string(nil), unit.reasons...),\n391|\t}\n392|\tif !unit.memberOpaque {\n393|\t\teventID := record.NativeEventID\n394|\t\tnativeType := record.NativeType\n395|\t\tinput.NativeEventID = &eventID\n396|\t\tinput.NativeType = &nativeType\n397|\t}\n398|\treturn input\n399|}\n400|\n401|// buildResult seals the Canonical Session over the projected\n402|// events: main plus exactly the referenced extras (parented on\n403|// main), ordinal-ordered event IDs, the last event as head.\n404|func (plan *projectionPlan) buildResult() (*NormalizeResult, error) {\n405|\tmain := plan.mainActor.String()\n406|\tinputs := []clonebundle.ActorInput{{\n407|\t\tActorID: main,\n408|\t\tKind:    \"main\",\n409|\t}}\n410|\tselectors := make([]string, 0, len(plan.extraActors))\n411|\tfor selector := range plan.extraActors {\n412|\t\tselectors = append(selectors, selector)\n413|\t}\n414|\tsort.Strings(selectors)\n415|\tfor _, selector := range selectors {\n416|\t\tname := selector\n417|\t\tkind := \"external\"\n418|\t\tif strings.HasPrefix(selector, \"subagent:\") {\n419|\t\t\tkind = \"subagent\"\n420|\t\t}\n421|\t\tparent := main\n422|\t\tinputs = append(inputs, clonebundle.ActorInput{\n423|\t\t\tActorID:        plan.extraActors[selector].String(),\n424|\t\t\tKind:           kind,\n425|\t\t\tParentActorID:  &parent,\n426|\t\t\tName:           &name,\n427|\t\t\tSourceNativeID: &name,\n428|\t\t})\n429|\t}\n430|\teventIDs := make([]string, 0, len(plan.decodedEvents))\n431|\tfor _, decoded := range plan.decodedEvents {\n432|\t\teventIDs = append(eventIDs, decoded.EventID.String())\n433|\t}\n434|\t// Unreachable: Normalize refused the empty projection before\n435|\t// dispatch ran. The guard keeps a headless build a builder\n436|\t// refusal instead of an index panic.\n437|\theads := []string{}\n438|\tif len(eventIDs) > 0 {\n439|\t\theads = []string{eventIDs[len(eventIDs)-1]}\n440|\t}\n441|\tsession, err := clonebundle.BuildCanonicalSession(clonebundle.CanonicalSessionInput{\n442|\t\tLogicalSessionID:      plan.logical.String(),\n443|\t\tSourceEnvironment:     plan.environment,\n444|\t\tSourceNativeSessionID: plan.raw.SourceNativeSessionID,\n445|\t\tTitle:                 plan.request.Title,\n446|\t\tWorkspace:             plan.request.Workspace,\n447|\t\tActors:                inputs,\n448|\t\tEventIDs:              eventIDs,\n449|\t\tHeadEventIDs:          heads,\n450|\t\tExtensions:            map[string]any{},\n451|\t})\n452|\tif err != nil {\n453|\t\treturn nil, invalid(\"projection cannot seal its session: %v\", err)\n454|\t}\n455|\tdecoded, err := clonebundle.DecodeCanonicalSession(session)\n456|\tif err != nil {\n457|\t\treturn nil, invalid(\"sealed session refused: %v\", err)\n458|\t}\n459|\treturn &NormalizeResult{\n460|\t\tSession:         session,\n461|\t\tDecodedSession:  decoded,\n462|\t\tEvents:          plan.events,\n463|\t\tDecodedEvents:   plan.decodedEvents,\n464|\t\tToolResolutions: plan.resolutions,\n465|\t\tLive:            plan.surface,\n466|\t\tInstruction:     plan.instruction,\n467|\t\tUsage:           plan.usage,\n468|\t\tOverflows:       plan.overflows,\n469|\t}, nil\n470|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
