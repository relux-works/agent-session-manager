{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8dd","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":713,"recorded_at":1780531400001421,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"call_id":"call_01a0b3c86c2d707cb8217cb8d6075eb8","text":"Read text file `internal/cloneproject/refusal_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonesnap\"\n10|)\n11|\n12|// Negative tests: every refusal below drives the production\n13|// Normalize entry and fails when the gate admits what it must\n14|// reject. Each row names the offending input and the refusal\n15|// fragment the gate must emit.\n16|\n17|func TestNormalizeRefusesUnstableCapture(t *testing.T) {\n18|\tmembers := []fixtureMember{\n19|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n20|\t\t\trec(\"evt-u-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"unstable\"}`),\n21|\t\t)},\n22|\t}\n23|\troot := writeFixtureStore(t, members)\n24|\tstore := openTestStore(t)\n25|\trequest := validCaptureRequest(t, root, store, members)\n26|\trequest.OnRace = clonesnap.RaceArchive\n27|\trequest.OperatorExplicit = true\n28|\trequest.Hooks.AfterWalk = func(storeRoot string) error {\n29|\t\treturn writeStoreFile(storeRoot, \"store/session.jsonl\", jsonl(\n30|\t\t\trec(\"evt-u-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"mutated\"}`),\n31|\t\t))\n32|\t}\n33|\tcapture, err := clonesnap.Capture(request)\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"Capture() error = %v\", err)\n36|\t}\n37|\tif capture.BoundaryKind != \"unstable_archive\" {\n38|\t\tt.Fatalf(\"BoundaryKind = %q, want unstable_archive\", capture.BoundaryKind)\n39|\t}\n40|\t_, err = Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n41|\tif err == nil {\n42|\t\tt.Fatal(\"Normalize() admitted an unstable_archive capture to target projection\")\n43|\t}\n44|\tif !errors.Is(err, ErrInvalid) && !strings.Contains(err.Error(), \"cannot enter a target branch\") {\n45|\t\tt.Fatalf(\"Normalize() error = %v, want the target-branch refusal\", err)\n46|\t}\n47|}\n48|\n49|func TestNormalizeRefusesEnvironmentDrift(t *testing.T) {\n50|\t// Both manifests seal clean and the ID link holds, but the\n51|\t// sealed environments differ: the evidence environment would be\n52|\t// ambiguous, so projection refuses. The real capture entry\n53|\t// cannot produce this pair (one tuple seals both sides), so the\n54|\t// test builds it through the landed builders instead.\n55|\tenvA := fixtureTupleJSON()\n56|\tenvB := `{\"environment_id\":\"project.evw\",\"environment_version\":\"3.0.1\",\"platform\":\"linux\",\"architecture\":\"arm64\",\"store_schema_fingerprint\":` +\n57|\t\t`\"` + fixtureDigest(\"project-store-fingerprint\") + `\",\"adapter_version\":\"2.0.0\"}`\n58|\tidentity := fixtureNativeIdentity(t)\n59|\tidentityDigest, err := clonebundle.IdentityDigest(identity, nil)\n60|\tif err != nil {\n61|\t\tt.Fatalf(\"IdentityDigest() error = %v\", err)\n62|\t}\n63|\trawBytes, err := clonebundle.BuildRawObjectManifest(\n64|\t\tfixtureOperationID, []byte(envA), \"native-session-project\",\n65|\t\tidentityDigest.String(), fixtureDigest(\"project-capture-plan\"), nil, nil)\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"BuildRawObjectManifest() error = %v\", err)\n68|\t}\n69|\traw, err := clonebundle.DecodeRawObjectManifest(rawBytes)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"DecodeRawObjectManifest() error = %v\", err)\n72|\t}\n73|\tpre := fixtureDigest(\"drift-pre\")\n74|\tcaptureBytes, err := clonebundle.BuildCaptureManifest(clonebundle.CaptureManifestInput{\n75|\t\tOperationID: fixtureOperationID,\n76|\t\tBundleID:    fixtureBundleID,\n77|\t\tSourceBasis: clonebundle.SourceBasisInput{\n78|\t\t\tKind:                     \"ax_session\",\n79|\t\t\tSourceSessionID:          fixtureSessionID,\n80|\t\t\tSourceSessionRecordID:    fixtureDigest(\"project-session-record\"),\n81|\t\t\tSourceCheckpointID:       fixtureDigest(\"project-checkpoint\"),\n82|\t\t\tSourceProviderIdentityID: fixtureDigest(\"project-provider-identity\"),\n83|\t\t},\n84|\t\tSourceEnvironment: []byte(envB),\n85|\t\tSourceIdentity:    identity,\n86|\t\tCapturePlanDigest: fixtureDigest(\"project-capture-plan\"),\n87|\t\tBoundary: clonebundle.BoundaryInput{\n88|\t\t\tKind:              \"stable\",\n89|\t\t\tProofKind:         \"closed_store\",\n90|\t\t\tGeneration:        \"generation-11\",\n91|\t\t\tPreCaptureDigest:  pre,\n92|\t\t\tPostCaptureDigest: pre,\n93|\t\t\tInputBlocked:      true,\n94|\t\t\tForegroundIdle:    true,\n95|\t\t\tBackgroundIdle:    true,\n96|\t\t},\n97|\t\tSourceRawManifestID: raw.ManifestID.String(),\n98|\t\tCreatedByHostID:     fixtureHostID,\n99|\t\tCreatedAt:           fixtureCreatedAt,\n100|\t})\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n103|\t}\n104|\t_, probeStore := captureMembers(t, []fixtureMember{\n105|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n106|\t\t\trec(\"evt-drift-ws\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`),\n107|\t\t)},\n108|\t})\n109|\trequest := NormalizeRequest{\n110|\t\tCaptureManifest:  captureBytes,\n111|\t\tRawManifest:      rawBytes,\n112|\t\tFetch:            storeFetch(t, probeStore),\n113|\t\tCanonicalSink:    openTestStore(t),\n114|\t\tLogicalSessionID: fixtureLogicalID,\n115|\t\tMainActorID:      fixtureMainActor,\n116|\t\tWorkspace:        mustWorkspaceBytes(t),\n117|\t}\n118|\t_, err = Normalize(request)\n119|\tif err == nil {\n120|\t\tt.Fatal(\"Normalize() admitted a capture whose sealed environments drift\")\n121|\t}\n122|\tif !strings.Contains(err.Error(), \"source_environment disagree\") {\n123|\t\tt.Fatalf(\"Normalize() error = %v, want the closure-drift refusal\", err)\n124|\t}\n125|}\n126|\n127|func TestNormalizeRefusalTable(t *testing.T) {\n128|\t// refuseMembers projects members that must refuse and asserts\n129|\t// the refusal fragment.\n130|\trefuseMembers := func(t *testing.T, members []fixtureMember, fragment string) {\n131|\t\tt.Helper()\n132|\t\tcapture, store := captureMembers(t, members)\n133|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n134|\t\tif err == nil {\n135|\t\t\tt.Fatalf(\"Normalize() admitted members that must refuse with %q\", fragment)\n136|\t\t}\n137|\t\tif !errors.Is(err, ErrInvalid) && !strings.Contains(err.Error(), fragment) {\n138|\t\t\tt.Fatalf(\"Normalize() error = %v, want fragment %q\", err, fragment)\n139|\t\t}\n140|\t\tif !strings.Contains(err.Error(), fragment) {\n141|\t\t\tt.Fatalf(\"Normalize() error = %v, want fragment %q\", err, fragment)\n142|\t\t}\n143|\t}\n144|\tmessage := func(id, body string) string {\n145|\t\treturn rec(id, \"message/user\", \"native\", \"none\", \"main\", body)\n146|\t}\n147|\tcall := func(id, body string) string {\n148|\t\treturn rec(\"evt-\"+id, \"tool/call\", \"native\", \"none\", \"main\", body)\n149|\t}\n150|\n151|\tt.Run(\"malformed_json_line\", func(t *testing.T) {\n152|\t\trefuseMembers(t, []fixtureMember{\n153|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: []byte(\"{not-json\\n\")},\n154|\t\t}, \"is not a JSON object\")\n155|\t})\n156|\tt.Run(\"missing_envelope_member\", func(t *testing.T) {\n157|\t\trefuseMembers(t, []fixtureMember{\n158|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n159|\t\t\t\t`{\"v\":1,\"native_event_id\":\"x\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\"}`,\n160|\t\t\t)},\n161|\t\t}, \"misses envelope member\")\n162|\t})\n163|\tt.Run(\"bad_envelope_version\", func(t *testing.T) {\n164|\t\trefuseMembers(t, []fixtureMember{\n165|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n166|\t\t\t\t`{\"v\":2,\"native_event_id\":\"x\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`,\n167|\t\t\t)},\n168|\t\t}, \"envelope version\")\n169|\t})\n170|\tt.Run(\"bad_origin\", func(t *testing.T) {\n171|\t\trefuseMembers(t, []fixtureMember{\n172|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n173|\t\t\t\trec(\"evt-bad-origin\", \"message/user\", \"sideways\", \"none\", \"main\", `{\"text\":\"x\"}`),\n174|\t\t\t)},\n175|\t\t}, \"outside native|foreign\")\n176|\t})\n177|\tt.Run(\"bad_protection\", func(t *testing.T) {\n178|\t\trefuseMembers(t, []fixtureMember{\n179|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n180|\t\t\t\trec(\"evt-bad-prot\", \"message/user\", \"native\", \"rot13\", \"main\", `{\"text\":\"x\"}`),\n181|\t\t\t)},\n182|\t\t}, \"outside none|encrypted|signed\")\n183|\t})\n184|\tt.Run(\"bad_actor_shape\", func(t *testing.T) {\n185|\t\trefuseMembers(t, []fixtureMember{\n186|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n187|\t\t\t\trec(\"evt-bad-actor\", \"message/user\", \"native\", \"none\", \"boss\", `{\"text\":\"x\"}`),\n188|\t\t\t)},\n189|\t\t}, \"outside main|external|subagent\")\n190|\t})\n191|\tt.Run(\"long_subagent_name\", func(t *testing.T) {\n192|\t\trefuseMembers(t, []fixtureMember{\n193|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n194|\t\t\t\trec(\"evt-long-sub\", \"message/user\", \"native\", \"none\", \"subagent:\"+strings.Repeat(\"s\", 129), `{\"text\":\"x\"}`),\n195|\t\t\t)},\n196|\t\t}, \"past 128 characters\")\n197|\t})\n198|\tt.Run(\"too_many_directives\", func(t *testing.T) {\n199|\t\tdirectives := `\"` + strings.Repeat(`d\",\"`, 1024) + `d\"`\n200|\t\trefuseMembers(t, []fixtureMember{\n201|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n202|\t\t\t\trec(\"evt-many-dir\", \"instruction/snapshot\", \"native\", \"none\", \"main\",\n203|\t\t\t\t\t`{\"authority\":\"low\",\"directives\":[`+directives+`]}`),\n204|\t\t\t)},\n205|\t\t}, \"maximum is 1024\")\n206|\t})\n207|\tt.Run(\"usage_ledger_overflow\", func(t *testing.T) {\n208|\t\trefuseMembers(t, []fixtureMember{\n209|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n210|\t\t\t\trec(\"evt-big-1\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":9007199254740991,\"output_tokens\":0}`),\n211|\t\t\t\trec(\"evt-big-2\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":1,\"output_tokens\":0}`),\n212|\t\t\t)},\n213|\t\t}, \"exceeds uint53\")\n214|\t})\n215|\tt.Run(\"bad_actor_uuid\", func(t *testing.T) {\n216|\t\tcapture, store := captureMembers(t, []fixtureMember{\n217|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n218|\t\t\t\trec(\"evt-bad-uuid\", \"message/user\", \"native\", \"none\", \"external\", `{\"text\":\"x\"}`),\n219|\t\t\t)},\n220|\t\t})\n221|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n222|\t\trequest.Actors = map[string]string{\"external\": \"not-a-uuid\"}\n223|\t\t_, err := Normalize(request)\n224|\t\tif err == nil {\n225|\t\t\tt.Fatal(\"Normalize() admitted a non-UUIDv7 actor mapping\")\n226|\t\t}\n227|\t\tif !strings.Contains(err.Error(), \"is not a UUIDv7\") {\n228|\t\t\tt.Fatalf(\"Normalize() error = %v, want the UUID refusal\", err)\n229|\t\t}\n230|\t})\n231|\tt.Run(\"blank_line\", func(t *testing.T) {\n232|\t\trefuseMembers(t, []fixtureMember{\n233|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: []byte(message(\"a\", `{\"text\":\"x\"}`) + \"\\n\\n\")},\n234|\t\t}, \"is empty\")\n235|\t})\n236|\tt.Run(\"unknown_body_member\", func(t *testing.T) {\n237|\t\trefuseMembers(t, []fixtureMember{\n238|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n239|\t\t\t\tmessage(\"evt-body-extra\", `{\"text\":\"x\",\"escalate\":true}`),\n240|\t\t\t)},\n241|\t\t}, \"unknown member\")\n242|\t})\n243|\tt.Run(\"contradictory_protection\", func(t *testing.T) {\n244|\t\trefuseMembers(t, []fixtureMember{\n245|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n246|\t\t\t\trec(\"evt-contra\", \"reasoning/encrypted\", \"native\", \"none\", \"main\", `{\"ciphertext\":\"x\"}`),\n247|\t\t\t)},\n248|\t\t}, \"with no protection\")\n249|\t})\n250|\tt.Run(\"protected_plaintext_body\", func(t *testing.T) {\n251|\t\trefuseMembers(t, []fixtureMember{\n252|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n253|\t\t\t\trec(\"evt-contra-body\", \"reasoning/summary\", \"native\", \"encrypted\", \"main\", `{\"text\":\"x\"}`),\n254|\t\t\t)},\n255|\t\t}, \"unknown member\")\n256|\t})\n257|\tt.Run(\"live_attestation_claim\", func(t *testing.T) {\n258|\t\trefuseMembers(t, []fixtureMember{\n259|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n260|\t\t\t\trec(\"evt-evil-def\", \"tool/definition\", \"native\", \"none\", \"main\",\n261|\t\t\t\t\t`{\"tool_name\":\"evil-tool\",\"definition_digest\":\"`+fixtureDigest(\"evil\")+`\",\"live_attestation\":true}`),\n262|\t\t\t)},\n263|\t\t}, \"claims live authority\")\n264|\t})\n265|\tt.Run(\"live_followup_claim\", func(t *testing.T) {\n266|\t\trefuseMembers(t, []fixtureMember{\n267|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n268|\t\t\t\tcall(\"call-live\", `{\"call_id\":\"call-live\",\"tool_name\":\"write\"}`),\n269|\t\t\t\trec(\"evt-call-live-result\", \"tool/result\", \"native\", \"none\", \"main\",\n270|\t\t\t\t\t`{\"call_id\":\"call-live\",\"status\":\"ok\",\"live_followup\":true}`),\n271|\t\t\t)},\n272|\t\t}, \"claims a live followup\")\n273|\t})\n274|\tt.Run(\"duplicate_call_id\", func(t *testing.T) {\n275|\t\trefuseMembers(t, []fixtureMember{\n276|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n277|\t\t\t\tcall(\"call-dup\", `{\"call_id\":\"call-dup\",\"tool_name\":\"read\"}`),\n278|\t\t\t\tcall(\"call-dup-again\", `{\"call_id\":\"call-dup\",\"tool_name\":\"write\"}`),\n279|\t\t\t)},\n280|\t\t}, \"is not unique\")\n281|\t})\n282|\tt.Run(\"duplicate_result_id\", func(t *testing.T) {\n283|\t\trefuseMembers(t, []fixtureMember{\n284|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n285|\t\t\t\tcall(\"call-r\", `{\"call_id\":\"call-r\",\"tool_name\":\"read\"}`),\n286|\t\t\t\trec(\"evt-r1\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-r\",\"status\":\"ok\"}`),\n287|\t\t\t\trec(\"evt-r2\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-r\",\"status\":\"error\"}`),\n288|\t\t\t)},\n289|\t\t}, \"is not unique\")\n290|\t})\n291|\tt.Run(\"bad_instruction_authority\", func(t *testing.T) {\n292|\t\trefuseMembers(t, []fixtureMember{\n293|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n294|\t\t\t\trec(\"evt-bad-auth\", \"instruction/snapshot\", \"native\", \"none\", \"main\",\n295|\t\t\t\t\t`{\"authority\":\"absolute\",\"directives\":[]}`),\n296|\t\t\t)},\n297|\t\t}, \"outside high|low\")\n298|\t})\n299|\tt.Run(\"fractional_usage\", func(t *testing.T) {\n300|\t\trefuseMembers(t, []fixtureMember{\n301|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n302|\t\t\t\trec(\"evt-bad-use\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":1.5,\"output_tokens\":2}`),\n303|\t\t\t)},\n304|\t\t}, \"is not a uint53\")\n305|\t})\n306|\tt.Run(\"unsafe_usage_magnitude\", func(t *testing.T) {\n307|\t\trefuseMembers(t, []fixtureMember{\n308|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n309|\t\t\t\trec(\"evt-big-use\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":9007199254740992,\"output_tokens\":2}`),\n310|\t\t\t)},\n311|\t\t}, \"exceeds uint53\")\n312|\t})\n313|\tt.Run(\"bad_definition_digest\", func(t *testing.T) {\n314|\t\trefuseMembers(t, []fixtureMember{\n315|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n316|\t\t\t\trec(\"evt-bad-def\", \"tool/definition\", \"native\", \"none\", \"main\",\n317|\t\t\t\t\t`{\"tool_name\":\"write\",\"definition_digest\":\"not-a-digest\"}`),\n318|\t\t\t)},\n319|\t\t}, \"is not a digest\")\n320|\t})\n321|\tt.Run(\"unmapped_actor\", func(t *testing.T) {\n322|\t\trefuseMembers(t, []fixtureMember{\n323|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n324|\t\t\t\trec(\"evt-stray\", \"message/user\", \"native\", \"none\", \"subagent:stray\", `{\"text\":\"x\"}`),\n325|\t\t\t)},\n326|\t\t}, \"with no mapped UUID\")\n327|\t})\n328|\tt.Run(\"invalid_utf8_line\", func(t *testing.T) {\n329|\t\traw := append([]byte(`{\"v\":1,\"native_event_id\":\"evt-utf8\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"`), 0xff)\n330|\t\traw = append(raw, []byte(`\"}}`+\"\\n\")...)\n331|\t\trefuseMembers(t, []fixtureMember{\n332|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: raw},\n333|\t\t}, \"is not valid UTF-8\")\n334|\t})\n335|\tt.Run(\"empty_projection\", func(t *testing.T) {\n336|\t\tcapture, store := captureMembers(t, []fixtureMember{\n337|\t\t\t{key: \"store/sidecar\", class: \"durable_sidecar\", content: []byte{}},\n338|\t\t})\n339|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n340|\t\tif err == nil {\n341|\t\t\tt.Fatal(\"Normalize() admitted a projection with no events\")\n342|\t\t}\n343|\t\tif !strings.Contains(err.Error(), \"holds no events\") 