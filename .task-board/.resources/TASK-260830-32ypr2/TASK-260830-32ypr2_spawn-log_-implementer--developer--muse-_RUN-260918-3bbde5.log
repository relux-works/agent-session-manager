g\\\"\\n    },\\n    \\\"board_source\\\": \\\"local\\\",\\n    \\\"config_authority_schema\\\": {\\n        \\\"id\\\": \\\"task-board-project-config-v1\\\",\\n        \\\"version\\\": 1\\n    },\\n    \\\"config_exists\\\": true,\\n    \\\"config_path\\\": \\\"/Users/iv/Developer/ReluxWorks/agent-session-manager/task-board.config.json\\\",\\n    \\\"configured_mode\\\": \\\"local\\\",\\n    \\\"contexts\\\": {\\n        \\\"authority\\\": \\\"project_policy\\\",\\n        \\\"fallback_reason\\\": \\\"missing_uses_fail_closed_default\\\",\\n        \\\"schema_version\\\": 1,\\n        \\\"server_capability\\\": null,\\n        \\\"source_path\\\": \\\"contexts\\\",\\n        \\\"value\\\": {\\n            \\\"builder_allowlist\\\": [],\\n            \\\"clearance\\\": {},\\n            \\\"payloads\\\": {\\n                \\\"mode\\\": \\\"off\\\"\\n            },\\n            \\\"retention\\\": null\\n        }\\n    },\\n    \\\"effective_mode\\\": \\\"local\\\",\\n    \\\"explicit_remote_override\\\": false,\\n    \\\"features\\\": {\\n        \\\"agent_context\\\": {\\n            \\\"config_key\\\": \\\"features.agent_context\\\",\\n            \\\"description\\\": \\\"Controls agent prompt, query, and response shaping: full keeps the complete context, lite uses compact defaults, and enabled=false applies built-in full defaults with no agent-context shaping.\\\",\\n            \\\"description_source\\\": \\\"canonical\\\",\\n            \\\"disabled_semantics\\\": \\\"built-in full defaults; no configured agent-context shaping is applied\\\",\\n            \\\"effective_profile\\\": \\\"full\\\",\\n            \\\"enabled\\\": true,\\n            \\\"implementation_status\\\": \\\"implemented\\\",\\n            \\\"runtime_active\\\": true,\\n            \\\"source\\\": \\\"config\\\"\\n        },\\n        \\\"context_sharing\\\": {\\n            \\\"config_key\\\": \\\"features.context_sharing\\\",\\n            \\\"description\\\": \\\"Selects, forks, and publishes shared agent contexts for spawned runs. Turning it off leaves registered contexts readable but unused: every spawn starts cold and no run publishes.\\\",\\n            \\\"description_source\\\": \\\"canonical\\\",\\n            \\\"disabled_semantics\\\": \\\"registered contexts remain readable and are not used\\\",\\n            \\\"enabled\\\": false,\\n            \\\"implementation_status\\\": \\\"implemented\\\",\\n            \\\"runtime_active\\\": false,\\n            \\\"source\\\": \\\"config\\\"\\n        },\\n        \\\"legacy_agent_context\\\": {\\n            \\\"compatibility_window\\\": \\\"one-release\\\",\\n            \\\"config_key\\\": null,\\n            \\\"implicit_migration\\\": false,\\n            \\\"state\\\": \\\"none\\\"\\n        },\\n        \\\"primary_session_goals\\\": {\\n            \\\"config_key\\\": \\\"features.primary_session_goals\\\",\\n            \\\"description\\\": \\\"Binds the board parent/primary goal into the parent session (native reflection, primary-goal actualization). Needs a manager-held session: start it with openai-board / anthropic-board (task-board codex|claude); a direct agents-infra launch (openai-infra / anthropic-infra) gets no goals whatever this flag says. Off refuses primary-goal mutations and binds nothing; stored revisions stay readable and re-enabling resumes from the head.\\\",\\n            \\\"description_source\\\": \\\"canonical\\\",\\n            \\\"disabled_semantics\\\": \\\"primary-goal mutations and native binding are refused; stored revisions stay readable\\\",\\n            \\\"enabled\\\": true,\\n            \\\"implementation_status\\\": \\\"implemented\\\",\\n            \\\"runtime_active\\\": true,\\n            \\\"source\\\": \\\"config\\\"\\n        },\\n        \\\"spawned_run_goals\\\": {\\n            \\\"config_key\\\": \\\"features.spawned_run_goals\\\",\\n            \\\"description\\\": \\\"Binds run/RUN-* owner goals for tracked spawns (goal-bound launch, native binding, goal-gated delivery). Needs a manager-held session: start it with openai-board / anthropic-board (task-board codex|claude); a direct agents-infra launch (openai-infra / anthropic-infra) gets no goals whatever this flag says. Off refuses goal-bound launches and run-goal mutations; bound runs keep their acceptance gate and re-enabling resumes from the head.\\\",\\n            \\\"description_source\\\": \\\"canonical\\\",\\n            \\\"disabled_semantics\\\": \\\"goal-bound launches and run-goal mutations are refused; bound runs keep their acceptance gate\\\",\\n            \\\"enabled\\\": true,\\n            \\\"implementation_status\\\": \\\"implemented\\\",\\n            \\\"runtime_active\\\": true,\\n            \\\"source\\\": \\\"config\\\"\\n        }\\n    },\\n    \\\"goals\\\": {\\n        \\\"adapters\\\": [\\n            \\\"primary-goal-v1\\\",\\n            \\\"board-goal-v1\\\"\\n        ],\\n        \\\"contract\\\": \\\"board-goal-v2\\\",\\n        \\\"launch_prerequisite\\\": \\\"Needs a manager-held session: start it with openai-board / anthropic-board (task-board codex|claude); a direct agents-infra launch (openai-infra / anthropic-infra) gets no goals whatever this flag says.\\\",\\n        \\\"native_reflection\\\": \\\"session-manager-required\\\",\\n        \\\"planes\\\": {\\n            \\\"primary\\\": {\\n                \\\"config_key\\\": \\\"features.primary_session_goals\\\",\\n                \\\"enabled\\\": true,\\n                \\\"see\\\": \\\"goals.launch_prerequisite\\\",\\n                \\\"state\\\": \\\"enabled-session-not-manager-held\\\"\\n            },\\n            \\\"spawned_run\\\": {\\n                \\\"config_key\\\": \\\"features.spawned_run_goals\\\",\\n                \\\"enabled\\\": true,\\n                \\\"see\\\": \\\"goals.launch_prerequisite\\\",\\n                \\\"state\\\": \\\"enabled-session-not-manager-held\\\"\\n            }\\n        },\\n        \\\"primary\\\": 