{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bd","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":441,"recorded_at":1780531400000877,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"task_stream":{"kind":"task","id":"01a0b3c7-76a2-7722-b720-600956c22591"},"task_id":"01a0b3c7-76a2-7722-b720-600956c22591","event":{"kind":"output","task_id":"01a0b3c7-76a2-7722-b720-600956c22591","chunk":"Read text file `internal/clonesnap/project.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file owns target-branch admission and the projection output\n14|// whose existence pins the race-before-projection ordering.\n15|// CaptureAndProject runs the capture pipeline, then admits the\n16|// sealed capture manifest: the unstable_archive form can never enter\n17|// a target branch (the landed G2 gate decides), and the maximal_safe\n18|// fidelity profile requires a reconciled complete manifest (the\n19|// landed maximal-safe gate decides). Admission emits one admission\n20|// receipt into the target sink. Projection planning past admission\n21|// is the final leaf's scope; this receipt exists to prove admission\n22|// and ordering, not to plan a projection.\n23|\n24|// FidelityProfile is one Section 7.8 fidelity profile:\n25|// strict_exact|maximal_safe|compact|messages_only.\n26|type FidelityProfile string\n27|\n28|const (\n29|\t// FidelityStrictExact requests exact projection.\n30|\tFidelityStrictExact FidelityProfile = \"strict_exact\"\n31|\t// FidelityMaximalSafe requests maximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary. Bound (P3-ζ′): sessadapter owns an\n42|// unexported copy of this four-profile table; the Story FINAL leaf\n43|// unifies or exports one owner. This package keeps its own closed\n44|// switch so the leaf boundary stays narrow.\n45|func validFidelityProfile(profile string) bool {\n46|\tswitch FidelityProfile(profile) {\n47|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n48|\t\treturn true\n49|\tdefault:\n50|\t\treturn false\n51|\t}\n52|}\n53|\n54|// ProjectRequest is one capture-and-project candidate: the capture\n55|// request, the target sink that receives the admission receipt, and\n56|// the fidelity profile admission decides.\n57|type ProjectRequest struct {\n58|\tCapture CaptureRequest\n59|\t// TargetSink receives the admission receipt. It stays empty\n60|\t// when capture refuses, races, or seals archive-only output.\n61|\tTargetSink *localstore.ObjectStore\n62|\t// FidelityProfile is the requested Section 7.8 profile.\n63|\tFidelityProfile string\n64|}\n65|\n66|// ProjectResult is one admitted capture: the capture result plus the\n67|// sealed admission receipt.\n68|type ProjectResult struct {\n69|\tCapture *CaptureResult\n70|\t// Receipt carries the sealed admission receipt bytes.\n71|\tReceipt []byte\n72|\t// ReceiptDigest is the blob identity of the receipt.\n73|\tReceiptDigest scalar.Digest\n74|\t// ReceiptInstalled reports whether this run installed the\n75|\t// receipt blob (a replay verifies and reuses).\n76|\tReceiptInstalled bool\n77|}\n78|\n79|// CaptureAndProject runs capture, then admits the sealed capture to\n80|// a target branch and emits the admission receipt. The race gate\n81|// precedes admission and emission (see ORDER-PIN below): a mutated\n82|// source refuses, or seals archive-only output that admission\n83|// rejects — no projection output is produced before the race is\n84|// decided.\n85|func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\n86|\tif request.TargetSink == nil {\n87|\t\treturn nil, invalid(\"capture projection requires a target sink\")\n88|\t}\n89|\tstate, err := newPipeline(request.Capture)\n90|\tif err != nil {\n91|\t\treturn nil, err\n92|\t}\n93|\tdefer state.close()\n94|\tif err := state.walkAndMeasure(); err != nil {\n95|\t\treturn nil, err\n96|\t}\n97|\t// ORDER-PIN: the source-race gate precedes any seal, admission,\n98|\t// or projection output. N-race-order-project moves this gate\n99|\t// after admitAndEmit: the early seal then refuses with a seal\n100|\t// error instead of the race refusal, so that row's killer\n101|\t// reddens on the wrong error (the seal error message, not a\n102|\t// sink). N-race-order-project-seal keeps the race error while\n103|\t// sealing first: its killer reddens on the sealed raw manifest\n104|\t// in the capture store.\n105|\tif err := state.gateSourceRace(); err != nil {\n106|\t\tcaptured, raceErr := state.raceOutcome(err)\n107|\t\tif raceErr != nil {\n108|\t\t\treturn nil, raceErr\n109|\t\t}\n110|\t\t// Archive-only output never enters a target branch: the\n111|\t\t// admission gate below refuses it, so no receipt exists.\n112|\t\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\n113|\t\t\treturn nil, err\n114|\t\t}\n115|\t\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\n116|\t}\n117|\tsealed, err := state.sealAndPublish(false)\n118|\tif err != nil {\n119|\t\treturn nil, err\n120|\t}\n121|\treturn state.admitAndEmit(request, sealed)\n122|}\n123|\n124|// admitAndEmit admits one sealed capture to the target branch and\n125|// emits its admission receipt into the target sink.\n126|func (state *pipeline) admitAndEmit(request ProjectRequest, sealed *CaptureResult) (*ProjectResult, error) {\n127|\tif _, err := AdmitForTarget(sealed.CaptureManifest, request.FidelityProfile); err != nil {\n128|\t\treturn nil, err\n129|\t}\n130|\treceipt, err := BuildAdmissionReceipt(sealed.Raw.ManifestID, sealed.Capture.ManifestID, request.FidelityProfile)\n131|\tif err != nil {\n132|\t\treturn nil, err\n133|\t}\n134|\tdigest := scalar.SHA256Digest(receipt)\n135|\tput, err := request.TargetSink.PutBlob(digest, uint64(len(receipt)), bytes.NewReader(receipt))\n136|\tif err != nil {\n137|\t\treturn nil, invalid(\"capture projection cannot publish the admission receipt: %v\", err)\n138|\t}\n139|\treturn &ProjectResult{\n140|\t\tCapture:          sealed,\n141|\t\tReceipt:          receipt,\n142|\t\tReceiptDigest:    digest,\n143|\t\tReceiptInstalled: put.Installed,\n144|\t}, nil\n145|}\n146|\n147|// AdmitForTarget admits one sealed capture manifest to a target\n148|// branch under the requested fidelity profile. The unstable_archive\n149|// form is archive-only output and always refuses; an unknown\n150|// fidelity profile refuses; maximal_safe requires a reconciled\n151|// complete manifest with no unknown class.\n152|func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\n153|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureManifest)\n154|\tif err != nil {\n155|\t\treturn clonebundle.CaptureManifest{}, err\n156|\t}\n157|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\n158|\t\treturn clonebundle.CaptureManifest{}, err\n159|\t}\n160|\tif !validFidelityProfile(profile) {\n161|\t\treturn clonebundle.CaptureManifest{}, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n162|\t}\n163|\tif profile == \"maximal_safe\" {\n164|\t\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n165|\t\t\treturn clonebundle.CaptureManifest{}, err\n166|\t\t}\n167|\t}\n168|\treturn manifest, nil\n169|}\n170|\n171|// admissionReceiptSchema pins the admission receipt envelope\n172|// identity.\n173|const admissionReceiptSchema = \"urn:ax:internal:clonesnap-admission-receipt\"\n174|\n175|// BuildAdmissionReceipt seals one target admission receipt: the\n176|// admitted raw and capture manifest identities, the stable boundary\n177|// kind, and the fidelity profile. Only stable captures reach it;\n178|// AdmitForTarget refused everything else before this seal ran.\n179|func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\n180|\tif !validFidelityProfile(profile) {\n181|\t\treturn nil, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n182|\t}\n183|\tobject := map[string]any{\n184|\t\t\"schema\":                 admissionReceiptSchema,\n185|\t\t\"schema_version\":         \"1.0.0\",\n186|\t\t\"raw_object_manifest_id\": rawManifestID.String(),\n187|\t\t\"capture_manifest_id\":    captureManifestID.String(),\n188|\t\t\"boundary_kind\":          \"stable\",\n189|\t\t\"fidelity_profile\":       profile,\n190|\t\t\"extensions\":             map[string]any{},\n191|\t}\n192|\tplain, err := json.Marshal(object)\n193|\tif err != nil {\n194|\t\treturn nil, invalid(\"serialize admission receipt: %v\", err)\n195|\t}\n196|\tsealed, err := canonicaljson.Canonicalize(plain)\n197|\tif err != nil {\n198|\t\treturn nil, invalid(\"canonicalize admission receipt: %v\", err)\n199|\t}\n200|\treturn sealed, nil\n201|}","final_result":true}}}
