912,\\n   \\\"excerpt\\\": \\\"target mutation, these facts MUST equal freshly read trusted-candidate facts and the Journal binding.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"session-adapter-call-binding\\\"\\n   ]\\n  }\\n ]\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:10.2\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/clonesnap/capture.go\\\",\\n  \\\"declaration\\\": \\\"Capture\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"clone-capture-contracts\\\",\\n  \\\"clone-native-capture\\\",\\n  \\\"clone-projection-fidelity\\\"\\n ],\\n \\\"coverage\\\": \\\"full\\\",\\n \\\"clauses\\\": [\\n  {\\n   \\\"id\\\": \\\"10.2#1\\\",\\n   \\\"line\\\": 4854,\\n   \\\"excerpt\\\": \\\"MUST live in a manifest, not in the blob path.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"clone-capture-contracts\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"10.2#2\\\",\\n   \\\"line\\\": 4855,\\n   \\\"excerpt\\\": \\\"references a blob, the writer MUST fsync the blob, verify its size and digest, and atomically install it in the object store.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"clone-native-capture\\\",\\n    \\\"clone-projection-fidelity\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"10.2#3\\\",\\n   \\\"line\\\": 4859,\\n   \\\"excerpt\\\": \\\"metrics MUST record digest, size, and media type only, never blob contents.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"clone-native-capture\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"10.2#4\\\",\\n   \\\"line\\\": 4862,\\n   \\\"excerpt\\\": \\\"<code>urn:ax:schema:blob</code> version <code>1.0.0</code>. Chunks MUST be sorted, contiguous, non-overlapping, start at offset zero, and cover exactly <code>size</code> bytes:\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"clone-native-capture\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"10.2#5\\\",\\n   \\\"line\\\": 4902,\\n   \\\"excerpt\\\": \\\"A larger file MUST fail capture with <code>capability_unavailable</code> before publishing a partial manifest.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"clone-native-capture\\\"\\n   ]\\n  }\\n ]\\n}\\n======\\n\",\n  \"original_output_bytes\": 2230,\n  \"original_output_tokens\": 558,\n  \"truncated\": false\n}","final_result":true}}}
