\"TestNormalizeUnknownProtectedRecordCarriesBothReasons\",\n523|        expect=\"KILLED\",\n524|        note=\"Admits exactly the frobnicate signed record with a single reason; every other unknown protected type still carries both.\",\n525|    ),\n526|    Mutant(\n527|        name=\"N-native-reason-foreign\",\n528|        path=f\"{PACKAGE}/dispatch.go\",\n529|        find='''\\tif record.Origin != \"foreign\" {\\n\\t\\treturn nil\\n\\t}\\n''',\n530|        replace='''\\tif record.Origin != \"foreign\" && record.NativeEventID != \"evt-enc-native\" {\\n\\t\\treturn nil\\n\\t}\\n''',\n531|        count=1,\n532|        run=\"TestNormalizeNativeProtectedReasoningStaysOpaque\",\n533|        expect=\"KILLED\",\n534|        note=\"Admits exactly the native encrypted record to a foreign reason; every other native record still carries none.\",\n535|    ),\n536|    Mutant(\n537|        name=\"N-main-parent\",\n538|        path=f\"{PACKAGE}/dispatch.go\",\n539|        find='''\\tinputs := []clonebundle.ActorInput{{\\n\\t\\tActorID: main,\\n\\t\\tKind:    \"main\",\\n\\t}}\\n''',\n540|        replace='''\\tinputs := []clonebundle.ActorInput{{\\n\\t\\tActorID: main,\\n\\t\\tKind:    \"main\",\\n\\t\\tParentActorID: &main,\\n\\t}}\\n''',\n541|        count=1,\n542|        run=\"TestNormalizeSealsSessionShape\",\n543|        expect=\"KILLED\",\n544|        note=\"Admits exactly main to the parented class; the landed builder refuses a main actor with a parent.\",\n545|    ),\n546|    Mutant(\n547|        name=\"C-doc-comment\",\n548|        path=f\"{PACKAGE}/doc.go\",\n549|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n550|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n551|        count=1,\n552|        run=\"TestNormalizeSourceUsageIsNotTargetAccounting\",\n553|        expect=\"SURVIVED\",\n554|        note=\"Harmless control: a comment-only edit must survive.\",\n555|    ),\n556|]\n557|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n558|    target = REPO / mutant.path\n559|    original = target.read_text()\n560|    found = original.count(mutant.find)\n561|    if found != mutant.count:\n562|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n563|    with tempfile.TemporaryDirectory() as staging:\n564|        backup = Path(staging) / \"backup\"\n565|        shutil.copy2(target, backup)\n566|        try:\n567|            target.write_text(original.replace(mutant.find, mutant.replace))\n568|            started = time.time()\n569|            run = subprocess.run(\n570|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n571|                cwd=REPO,\n572|                capture_output=True,\n573|                text=True,\n574|                timeout=300,\n575|            )\n576|            elapsed = time.time() - started\n577|        finally:\n578|            shutil.copy2(backup, target)\n579|    output = (run.stdout + run.stderr).strip()\n580|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n581|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n582|    if run.returncode == 0:\n583|        verdict = \"SURVIVED\"\n584|    elif '--- FAIL' in output or 'FAIL:' in output:\n585|        verdict = \"KILLED\"\n586|    else:\n587|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n588|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n589|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n590|\n591|\n592|def main(argv: list[str]) -> int:\n593|    log_dir: Path | None = None\n594|    selected_names: list[str] = []\n595|    args = list(argv)\n596|    while args:\n597|        if args[0] == \"--log-dir\":\n598|            if len(args) < 2:\n599|                print(\"missing directory for --log-dir\")\n600|                return 2\n601|            log_dir = Path(args[1])\n602|            args = args[2:]\n603|        else:\n604|            selected_names.append(args[0])\n605|            args = args[1:]\n606|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n607|    if selected_names and len(selected) != len(selected_names):\n608|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n609|        print(f\"unknown mutants: {', '.join(unknown)}\")\n610|        return 2\n611|    if log_dir is not None:\n612|        log_dir.mkdir(parents=True, exist_ok=True)\n613|    failures = 0\n614|    for mutant in selected:\n615|        try:\n616|            line, output, exit_code, elapsed = run_mutant(mutant)\n617|        except subprocess.TimeoutExpired:\n618|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n619|        print(line, flush=True)\n620|        if log_dir is not None:\n621|            (log_dir / f\"{mutant.name}.log\").write_text(\n622|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n623|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n624|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n625|            )\n626|        if not line.startswith(\"ok:\"):\n627|            failures += 1\n628|    return 1 if failures else 0\n629|\n630|\n631|if __name__ == \"__main__\":\n632|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
