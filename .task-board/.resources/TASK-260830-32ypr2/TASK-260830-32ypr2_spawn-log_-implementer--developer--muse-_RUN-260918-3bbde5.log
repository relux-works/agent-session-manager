}, \"is not a uint53\")\n305|\t})\n306|\tt.Run(\"unsafe_usage_magnitude\", func(t *testing.T) {\n307|\t\trefuseMembers(t, []fixtureMember{\n308|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n309|\t\t\t\trec(\"evt-big-use\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":9007199254740992,\"output_tokens\":2}`),\n310|\t\t\t)},\n311|\t\t}, \"exceeds uint53\")\n312|\t})\n313|\tt.Run(\"bad_definition_digest\", func(t *testing.T) {\n314|\t\trefuseMembers(t, []fixtureMember{\n315|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n316|\t\t\t\trec(\"evt-bad-def\", \"tool/definition\", \"native\", \"none\", \"main\",\n317|\t\t\t\t\t`{\"tool_name\":\"write\",\"definition_digest\":\"not-a-digest\"}`),\n318|\t\t\t)},\n319|\t\t}, \"is not a digest\")\n320|\t})\n321|\tt.Run(\"unmapped_actor\", func(t *testing.T) {\n322|\t\trefuseMembers(t, []fixtureMember{\n323|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n324|\t\t\t\trec(\"evt-stray\", \"message/user\", \"native\", \"none\", \"subagent:stray\", `{\"text\":\"x\"}`),\n325|\t\t\t)},\n326|\t\t}, \"with no mapped UUID\")\n327|\t})\n328|\tt.Run(\"invalid_utf8_line\", func(t *testing.T) {\n329|\t\traw := append([]byte(`{\"v\":1,\"native_event_id\":\"evt-utf8\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"`), 0xff)\n330|\t\traw = append(raw, []byte(`\"}}`+\"\\n\")...)\n331|\t\trefuseMembers(t, []fixtureMember{\n332|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: raw},\n333|\t\t}, \"is not valid UTF-8\")\n334|\t})\n335|\tt.Run(\"empty_projection\", func(t *testing.T) {\n336|\t\tcapture, store := captureMembers(t, []fixtureMember{\n337|\t\t\t{key: \"store/sidecar\", class: \"durable_sidecar\", content: []byte{}},\n338|\t\t})\n339|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n340|\t\tif err == nil {\n341|\t\t\tt.Fatal(\"Normalize() admitted a projection with no events\")\n342|\t\t}\n343|\t\tif !strings.Contains(err.Error(), \"holds no events\") {\n344|\t\t\tt.Fatalf(\"Normalize() error = %v, want the empty-projection refusal\", err)\n345|\t\t}\n346|\t})\n347|\tt.Run(\"tampered_blob\", func(t *testing.T) {\n348|\t\tcapture, store := captureMembers(t, []fixtureMember{\n349|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n350|\t\t\t\tmessage(\"evt-tamper\", `{\"text\":\"x\"}`),\n351|\t\t\t)},\n352|\t\t})\n353|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n354|\t\thealthy := request.Fetch\n355|\t\trequest.Fetch = func(blobID string) ([]byte, error) {\n356|\t\t\tpayload, err := healthy(blobID)\n357|\t\t\tif err != nil {\n358|\t\t\t\treturn nil, err\n359|\t\t\t}\n360|\t\t\tpayload[0] ^= 0xff\n361|\t\t\treturn payload, nil\n362|\t\t}\n363|\t\t_, err := Normalize(request)\n364|\t\tif err == nil {\n365|\t\t\tt.Fatal(\"Normalize() admitted tampered blob bytes\")\n366|\t\t}\n367|\t\tif !strings.Contains(err.Error(), \"disagrees\") {\n368|\t\t\tt.Fatalf(\"Normalize() error = %v, want the digest disagreement refusal\", err)\n369|\t\t}\n370|\t})\n371|\tt.Run(\"missing_blob\", func(t *testing.T) {\n372|\t\tcapture, store := captureMembers(t, []fixtureMember{\n373|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n374|\t\t\t\tmessage(\"evt-missing\", `{\"text\":\"x\"}`),\n375|\t\t\t)},\n376|\t\t})\n377|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n378|\t\trequest.Fetch = func(blobID string) ([]byte, error) {\n379|\t\t\treturn nil, errFixtureGone\n380|\t\t}\n381|\t\t_, err := Normalize(request)\n382|\t\tif err == nil {\n383|\t\t\tt.Fatal(\"Normalize() admitted a missing blob\")\n384|\t\t}\n385|\t\tif !strings.Contains(err.Error(), \"cannot fetch blob\") {\n386|\t\t\tt.Fatalf(\"Normalize() error = %v, want the fetch refusal\", err)\n387|\t\t}\n388|\t})\n389|\tt.Run(\"manifest_closure_drift\", func(t *testing.T) {\n390|\t\tfirst, _ := captureMembers(t, []fixtureMember{\n391|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n392|\t\t\t\tmessage(\"evt-drift-a\", `{\"text\":\"a\"}`),\n393|\t\t\t)},\n394|\t\t})\n395|\t\tsecond, secondStore := captureMembers(t, []fixtureMember{\n396|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n397|\t\t\t\tmessage(\"evt-drift-b\", `{\"text\":\"b\"}`),\n398|\t\t\t)},\n399|\t\t})\n400|\t\trequest := normalizeRequest(t, second, secondStore, openTestStore(t))\n401|\t\trequest.RawManifest = first.RawManifest\n402|\t\t_, err := Normalize(request)\n403|\t\tif err == nil {\n404|\t\t\tt.Fatal(\"Normalize() admitted a capture whose raw manifest is not its sealed raw manifest\")\n405|\t\t}\n406|\t\tif !strings.Contains(err.Error(), \"links raw manifest\") {\n407|\t\t\tt.Fatalf(\"Normalize() error = %v, want the closure refusal\", err)\n408|\t\t}\n409|\t})\n410|\tt.Run(\"unmapped_extra_actor\", func(t *testing.T) {\n411|\t\tcapture, store := captureMembers(t, []fixtureMember{\n412|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n413|\t\t\t\tmessage(\"evt-extra\", `{\"text\":\"x\"}`),\n414|\t\t\t)},\n415|\t\t})\n416|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n417|\t\trequest.Actors = map[string]string{\"subagent:idle\": fixtureSubActor}\n418|\t\t_, err := Normalize(request)\n419|\t\tif err == nil {\n420|\t\t\tt.Fatal(\"Normalize() admitted an unreferenced actor mapping\")\n421|\t\t}\n422|\t\tif !strings.Contains(err.Error(), \"with no referencing record\") {\n423|\t\t\tt.Fatalf(\"Normalize() error = %v, want the unreferenced-actor refusal\", err)\n424|\t\t}\n425|\t})\n426|\tt.Run(\"main_actor_in_map\", func(t *testing.T) {\n427|\t\tcapture, store := captureMembers(t, []fixtureMember{\n428|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n429|\t\t\t