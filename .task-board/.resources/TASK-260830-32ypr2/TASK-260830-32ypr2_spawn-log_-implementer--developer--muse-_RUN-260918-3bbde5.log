{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9cb","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":832,"recorded_at":1780531400001659,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"task_stream":{"kind":"task","id":"01a0b3c8-adb4-7f70-beeb-bf922f7e2a2f"},"task_id":"01a0b3c8-adb4-7f70-beeb-bf922f7e2a2f","event":{"kind":"output","task_id":"01a0b3c8-adb4-7f70-beeb-bf922f7e2a2f","chunk":"Read text file `internal/cloneproject/foreign_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// Invariant 2: foreign signed/encrypted reasoning stays opaque,\n8|// foreign instructions stay low-authority history, and source usage\n9|// never becomes target accounting. Every test drives Normalize over\n10|// bytes the real capture entry sealed.\n11|\n12|func TestNormalizeForeignEncryptedReasoningStaysOpaque(t *testing.T) {\n13|\tline := rec(\"evt-enc-1\", \"reasoning/encrypted\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"TOP-SECRET-THOUGHTS\"}`)\n14|\tbundle := projectMembers(t, []fixtureMember{\n15|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n16|\t})\n17|\tif len(bundle.result.DecodedEvents) != 1 {\n18|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1\", len(bundle.result.DecodedEvents))\n19|\t}\n20|\tevent := bundle.result.DecodedEvents[0]\n21|\tif event.Kind != \"opaque_reasoning\" {\n22|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n23|\t}\n24|\tif event.Kind == \"reasoning_summary\" {\n25|\t\tt.Fatal(\"foreign encrypted reasoning was promoted to reasoning_summary\")\n26|\t}\n27|\tif event.Visibility != \"opaque\" {\n28|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n29|\t}\n30|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"foreign_encrypted_payload\" {\n31|\t\tt.Fatalf(\"ReasonCodes = %q, want [foreign_encrypted_payload]\", event.Evidence.ReasonCodes)\n32|\t}\n33|\tif payloadText(t, event, \"protection\") != \"encrypted\" {\n34|\t\tt.Fatalf(\"payload protection = %q, want encrypted\", payloadText(t, event, \"protection\"))\n35|\t}\n36|\tif payloadInt(t, event, \"byte_count\") != int64(len(line)) {\n37|\t\tt.Fatalf(\"payload byte_count = %d, want %d\", payloadInt(t, event, \"byte_count\"), len(line))\n38|\t}\n39|\tsealed := sealedPayload(t, bundle.result.Events[0])\n40|\tfor _, forbidden := range []string{\"content_blocks\", \"content\", \"text\", \"ciphertext\", \"summary\"} {\n41|\t\tif _, present := sealed[forbidden]; present {\n42|\t\t\tt.Fatalf(\"sealed payload carries %q: decrypted, summarized, or re-encoded\", forbidden)\n43|\t\t}\n44|\t}\n45|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n46|\tif string(resolved) != line {\n47|\t\tt.Fatal(\"encrypted bytes did not survive the blob round trip byte-exact\")\n48|\t}\n49|}\n50|\n51|func TestNormalizeForeignSignedReasoningStaysOpaque(t *testing.T) {\n52|\tline := rec(\"evt-sig-1\", \"reasoning/signed\", \"foreign\", \"signed\", \"main\", `{\"ciphertext\":\"SIGNED-BYTES\"}`)\n53|\tbundle := projectMembers(t, []fixtureMember{\n54|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n55|\t})\n56|\tevent := bundle.result.DecodedEvents[0]\n57|\tif event.Kind != \"opaque_reasoning\" {\n58|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n59|\t}\n60|\tif event.Visibility != \"opaque\" {\n61|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n62|\t}\n63|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"foreign_signature_unverifiable\" {\n64|\t\tt.Fatalf(\"ReasonCodes = %q, want [foreign_signature_unverifiable]\", event.Evidence.ReasonCodes)\n65|\t}\n66|\tif payloadText(t, event, \"protection\") != \"signed\" {\n67|\t\tt.Fatalf(\"payload protection = %q, want signed\", payloadText(t, event, \"protection\"))\n68|\t}\n69|\tsealed := sealedPayload(t, bundle.result.Events[0])\n70|\tfor _, forbidden := range []string{\"content_blocks\", \"content\", \"text\", \"ciphertext\", \"summary\"} {\n71|\t\tif _, present := sealed[forbidden]; present {\n72|\t\t\tt.Fatalf(\"sealed payload carries %q: decrypted, summarized, or re-encoded\", forbidden)\n73|\t\t}\n74|\t}\n75|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n76|\tif string(resolved) != line {\n77|\t\tt.Fatal(\"signed bytes did not survive the blob round trip byte-exact\")\n78|\t}\n79|}\n80|\n81|func TestNormalizeNativeProtectedReasoningStaysOpaque(t *testing.T) {\n82|\tline := rec(\"evt-enc-native\", \"reasoning/encrypted\", \"native\", \"encrypted\", \"main\", `{\"ciphertext\":\"NATIVE-SECRET\"}`)\n83|\tbundle := projectMembers(t, []fixtureMember{\n84|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n85|\t})\n86|\tevent := bundle.result.DecodedEvents[0]\n87|\tif event.Kind != \"opaque_reasoning\" {\n88|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n89|\t}\n90|\tif len(event.Evidence.ReasonCodes) != 0 {\n91|\t\tt.Fatalf(\"ReasonCodes = %q, want empty: no foreign core code fits native-protected content\", event.Evidence.ReasonCodes)\n92|\t}\n93|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n94|\tif string(resolved) != line {\n95|\t\tt.Fatal(\"native protected bytes did not survive byte-exact\")\n96|\t}\n97|}\n98|\n99|func TestNormalizeProtectedMessageBecomesOpaqueEvent(t *testing.T) {\n100|\tline := rec(\"evt-prot-msg\", \"message/assistant\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"HIDDEN\"}`)\n101|\tbundle := projectMembers(t, []fixtureMember{\n102|\t\t{key: \"s