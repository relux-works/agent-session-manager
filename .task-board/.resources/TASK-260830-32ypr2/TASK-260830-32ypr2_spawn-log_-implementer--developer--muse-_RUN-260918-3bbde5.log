{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c931","stream":{"kind":"session","id":"01a0b3c6-628c-70a3-ad39-75274b1adfea"},"sequence":755,"recorded_at":1780531400001505,"record_type":"event","durability":"durable","causation_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24","run_stream":{"kind":"run","id":"94f324ce-ad7a-4eb7-9c54-86bfc93d2b24"},"call_id":"call_01a0b3c8849876d5add65f523e592c5b","text":"Read text file `internal/cloneproject/normalize_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// Invariant 1: unknown native records become raw-addressable opaque\n10|// events. Every test below drives the production Normalize entry\n11|// over bytes the real clonesnap.Capture entry sealed.\n12|\n13|func TestNormalizeUnknownRecordBecomesOpaqueEvent(t *testing.T) {\n14|\tline := rec(\"evt-unknown-1\", \"frobnicate\", \"native\", \"none\", \"main\", `{\"mystery\":true}`)\n15|\tbundle := projectMembers(t, []fixtureMember{\n16|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n17|\t})\n18|\tresult := bundle.result\n19|\tif len(result.DecodedEvents) != 1 {\n20|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1: unknown record was dropped or split\", len(result.DecodedEvents))\n21|\t}\n22|\tevent := result.DecodedEvents[0]\n23|\tif event.Kind != \"opaque_event\" {\n24|\t\tt.Fatalf(\"Kind = %q, want opaque_event\", event.Kind)\n25|\t}\n26|\tif event.Visibility != \"opaque\" {\n27|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n28|\t}\n29|\tif event.Evidence.NativeEventID == nil || *event.Evidence.NativeEventID != \"evt-unknown-1\" {\n30|\t\tt.Fatalf(\"NativeEventID = %v, want evt-unknown-1\", event.Evidence.NativeEventID)\n31|\t}\n32|\tif event.Evidence.NativeType == nil || *event.Evidence.NativeType != \"frobnicate\" {\n33|\t\tt.Fatalf(\"NativeType = %v, want frobnicate\", event.Evidence.NativeType)\n34|\t}\n35|\tif event.Evidence.CaptureStatus != \"exact\" {\n36|\t\tt.Fatalf(\"CaptureStatus = %q, want exact\", event.Evidence.CaptureStatus)\n37|\t}\n38|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"unknown_native_event\" {\n39|\t\tt.Fatalf(\"ReasonCodes = %q, want [unknown_native_event]\", event.Evidence.ReasonCodes)\n40|\t}\n41|\tif len(event.Evidence.RawRefs) != 1 {\n42|\t\tt.Fatalf(\"len(RawRefs) = %d, want 1\", len(event.Evidence.RawRefs))\n43|\t}\n44|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n45|\tif string(resolved) != line {\n46|\t\tt.Fatalf(\"resolved bytes = %q, want the exact record line\", string(resolved))\n47|\t}\n48|\tif payloadText(t, event, \"native_type\") != \"frobnicate\" {\n49|\t\tt.Fatalf(\"payload native_type = %q, want frobnicate\", payloadText(t, event, \"native_type\"))\n50|\t}\n51|\tif payloadInt(t, event, \"byte_count\") != int64(len(line)) {\n52|\t\tt.Fatalf(\"payload byte_count = %d, want %d\", payloadInt(t, event, \"byte_count\"), len(line))\n53|\t}\n54|}\n55|\n56|func TestNormalizeAlmostKnownRecordBecomesOpaqueEvent(t *testing.T) {\n57|\t// Right envelope, unknown inner type: message/smoke shares the\n58|\t// message/ prefix with known types but registers nothing.\n59|\tline := rec(\"evt-almost-1\", \"message/smoke\", \"native\", \"none\", \"main\", `{\"text\":\"smoke\"}`)\n60|\tbundle := projectMembers(t, []fixtureMember{\n61|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n62|\t})\n63|\tif len(bundle.result.DecodedEvents) != 1 {\n64|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1\", len(bundle.result.DecodedEvents))\n65|\t}\n66|\tevent := bundle.result.DecodedEvents[0]\n67|\tif event.Kind != \"opaque_event\" {\n68|\t\tt.Fatalf(\"Kind = %q, want opaque_event: almost-known type was coerced into a neighbouring kind\", event.Kind)\n69|\t}\n70|\tif event.Kind == \"user_message\" || event.Kind == \"assistant_message\" {\n71|\t\tt.Fatalf(\"Kind = %q: prefix match coerced the record into a known kind\", event.Kind)\n72|\t}\n73|\tif event.Visibility != \"opaque\" {\n74|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n75|\t}\n76|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"unknown_native_event\" {\n77|\t\tt.Fatalf(\"ReasonCodes = %q, want [unknown_native_event]\", event.Evidence.ReasonCodes)\n78|\t}\n79|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n80|\tif string(resolved) != line {\n81|\t\tt.Fatalf(\"resolved bytes differ from the exact record line\")\n82|\t}\n83|}\n84|\n85|func TestNormalizeUnknownMemberBecomesWholeMemberOpaque(t *testing.T) {\n86|\tcontent := []byte(\"\\x00\\x01binary-\\xff-not-jsonl\")\n87|\tbundle := projectMembers(t, []fixtureMember{\n88|\t\t{key: \"store/mystery\", class: \"unknown\", content: content},\n89|\t})\n90|\tif len(bundle.result.DecodedEvents) != 1 {\n91|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1\", len(bundle.result.DecodedEvents))\n92|\t}\n93|\tevent := bundle.result.DecodedEvents[0]\n94|\tif event.Kind != \"opaque_event\" {\n95|\t\tt.Fatalf(\"Kind = %q, want opaque_event\", event.Kind)\n96|\t}\n97|\tif event.Visibility != \"opaque\" {\n98|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n99|\t}\n100|\tif event.Evidence.NativeEventID != nil {\n101|\t\tt.Fatalf(\"NativeEventID = %q, want null for a member-level opaque\", *event.Evidence.NativeEventID)\n102|\t}\n103|\tif event.Evidence.NativeType != nil {\n104|\t\tt.Fatalf(\"NativeType = %q, want null for a member-level opaque\", *event.Evidence.NativeType)\n105|\t}\n106|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"unknown_native_event\" {\n107|\t\tt.Fatalf(\"ReasonCodes = %q, want [unknown_native_event]\", event.Evidence.ReasonCodes)\n108|\t}\n109|\tref := event.Evidence.RawRefs[0]\n110|\tif ref.Offset != 0 || ref.Length != uint64(len(content)) {\n111|\t\tt.Fatalf(\"raw range = [%d:%d], want the whole %d-byte member\", ref.Offset, ref.Offset+ref.Length, len(content))\n112|\t}\n113|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, ref)\n114|\tif !bytes.Equal(resolved, content) {\n115|\t\tt.Fatal(\"resolved bytes differ from the whole member\")\n116|\t}\n117|\tif payloadText(t, event, \"native_item_key\") != \"store/mystery\" {\n118|\t\tt.Fatalf(\"payload native_item_key = %q, want store/mystery\", payloadText(t, event, \"native_item_key\"))\n119|\t}\n120|}\n121|\n122|func TestNormalizeOpaqueIsStableAcrossProjections(t *testing.T) {\n123|\tlines := []string{\n124|\t\trec(\"evt-opaque-a\", \"frobnicate\", \"native\", \"none\", \"main\", `{\"n\":1}`),\n125|\t\trec(\"evt-opaque-b\", \"message/smoke\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`),\n126|\t}\n127|\tmembers := []fixtureMember{\n128|\t\t{key: \"store/mystery\", class: \"unknown\", content: []byte(\"mystery-bytes\")},\n129|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(lines...)},\n130|\t}\n131|\tcapture, store := captureMembers(t, members)\n132|\tfirst, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n133|\tif err != nil {\n134|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n135|\t}\n136|\tsecond, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n137|\tif err != nil {\n138|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n139|\t}\n140|\tif len(first.Events) != 3 || len(second.Events) != 3 {\n141|\t\tt.Fatalf(\"event counts = %d/%d, want 3/3: a second projection dropped or split\", len(first.Events), len(second.Events))\n142|\t}\n143|\tfor index := range first.Events {\n144|\t\tif !bytes.Equal(first.Events[index], second.Events[index]) {\n145|\t\t\tt.Fatalf(\"event[%d] differs across projections: re-typed on the second pass\", index)\n146|\t\t}\n147|\t\tif first.DecodedEvents[index].Kind != \"opaque_event\" {\n148|\t\t\tt.Fatalf(\"event[%d].Kind = %q, want opaque_event\", index, first.DecodedEvents[index].Kind)\n149|\t\t}\n150|\t\tif second.DecodedEvents[index].Kind != \"opaque_event\" {\n151|\t\t\tt.Fatalf(\"event[%d].Kind = %q, want opaque_event\", index, second.DecodedEvents[index].Kind)\n152|\t\t}\n153|\t}\n154|}\n155|\n156|func TestNormalizeSealsSessionShape(t *testing.T) {\n157|\tbundle := projectMembers(t, []fixtureMember{\n158|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n159|\t\t\trec(\"evt-s-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"hello\"}`),\n160|\t\t\trec(\"evt-s-2\", \"message/assistant\", \"native\", \"none\", \"main\", `{\"text\":\"world\"}`),\n161|\t\t)},\n162|\t})\n163|\tresult := bundle.result\n164|\tsession := result.DecodedSession\n165|\tif session.LogicalSessionID.String() != fixtureLogicalID {\n166|\t\tt.Fatalf(\"LogicalSessionID = %q, want %q\", session.LogicalSessionID.String(), fixtureLogicalID)\n167|\t}\n168|\tif len(session.Actors) != 1 {\n169|\t\tt.Fatalf(\"len(Actors) = %d, want 1\", len(session.Actors))\n170|\t}\n171|\tif session.Actors[0].Kind != \"main\" {\n172|\t\tt.Fatalf(\"Actors[0].Kind = %q, want main\", session.Actors[0].Kind)\n173|\t}\n174|\tif session.Actors[0].ActorID.String() != fixtureMainActor {\n175|\t\tt.Fatalf(\"Actors[0] = %q, want %q\", session.Actors[0].ActorID.String(), fixtureMainActor)\n176|\t}\n177|\tif session.Actors[0].ParentActorID != nil {\n178|\t\tt.Fatalf(\"Actors[0].ParentActorID = %v, want null for main\", session.Actors[0].ParentActorID)\n179|\t}\n180|\tif len(session.EventIDs) != 2 {\n181|\t\tt.Fatalf(\"len(EventIDs) = %d, want 2\", len(session.EventIDs))\n182|\t}\n183|\tfor index, decoded := range result.DecodedEvents {\n184|\t\tif session.EventIDs[index].String() != decoded.EventID.String() {\n185|\t\t\tt.Fatalf(\"EventIDs[%d] = %q, want the ordinal event %q\", index, session.EventIDs[index], decoded.EventID)\n186|\t\t}\n187|\t\tif decoded.Ordinal != uint64(index) {\n188|\t\t\tt.Fatalf(\"Ordinal = %d, want %d\", decoded.Ordinal, index)\n189|\t\t}\n190|\t}\n191|\tif len(session.HeadEventIDs) != 1 || session.HeadEventIDs[0].String() != session.EventIDs[1].String() {\n192|\t\tt.Fatalf(\"HeadEventIDs = %v, want the last event only\", session.HeadEventIDs)\n193|\t}\n194|\tif len(result.DecodedEvents[0].Parents) != 0 {\n195|\t\tt.Fatalf(\"event[0] parents = %d, want none\", len(result.DecodedEvents[0].Parents))\n196|\t}\n197|\tif len(result.DecodedEvents[1].Parents) != 1 ||\n198|\t\tresult.DecodedEvents[1].Parents[0].String() != result.DecodedEvents[0].EventID.String() {\n199|\t\tt.Fatal(\"event[1] is not parented on event[0]\")\n200|\t}\n201|\tif result.DecodedEvents[0].Kind != \"user_message\" || result.DecodedEvents[1].Kind != \"assistant_message\" {\n202|\t\tt.Fatalf(\"kinds = %q/%q, want user_message/assistant_message\",\n203|\t\t\tresult.DecodedEvents[0].Kind, result.DecodedEvents[1].Kind)\n204|\t}\n205|\tif result.DecodedEvents[0].Visibility != \"public\" || result.DecodedEvents[1].Visibility != \"public\" {\n206|\t\tt.Fatal(\"message visibility is not public\")\n207|\t}\n208|}\n209|\n210|func TestNormalizeInlineContentBoundary(t *testing.T) {\n211|\tinline := strings.Repeat(\"i\", 65536)\n212|\toverflow := strings.Repeat(\"o\", 65537)\n213|\tbundle := projectMembers(t, []fixtureMember{\n214|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n215|\t\t\trec(\"evt-inline\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+inline+`\"}`),\n216|\t\t\trec(\"evt-overflow\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+overflow+`\"}`),\n217|\t\t\trec(\"evt-empty\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"\"}`),\n218|\t\t)},\n219|\t})\n220|\tresult := bundle.result\n221|\tsealed := map[string][]byte{}\n222|\tfor index, decoded := range result.DecodedEvents {\n223|\t\tsealed[*decoded.Evidence.NativeEventID] = result.Events[index]\n224|\t}\n225|\tinlinePayload := sealedPayload(t, sealed[\"evt-inline\"])\n226|\tblocks, ok := inlinePayload[\"content_blocks\"].([]any)\n227|\tif !ok || len(blocks) != 1 {\n228|\t\tt.Fatalf(\"inline content_blocks = %v, want one block\", inlinePayload[\"content_blocks\"])\n229|\t}\n230|\tblock := blocks[0].(map[string]any)\n231|\tif block[\"content\"] != inline {\n232|\t\tt.Fatal(\"65536-byte text did not seal inline\")\n233|\t}\n234|\tif _, present := block[\"blob_descriptor_id\"]; present {\n235|\t\tt.Fatal(\"65536-byte text sealed a descriptor reference instead of inline content\")\n236|\t}\n237|\toverflowPayload := sealedPayload(t, sealed[\"evt-overflow\"])\n238|\toverBlocks, ok := overflowPayload[\"content_blocks\"].([]any)\n239|\tif !ok || len(overBlocks) != 1 {\n240|\t\tt.Fatalf(\"overflow content_blocks = %v, want one block\", overflowPayload[\"content_blocks\"])\n241|\t}\n242|\toverBlock := overBlocks[0].(map[string]any)\n243|\tif _, present := overBlock[\"content\"]; present {\n244|\t\tt.Fatal(\"65537-byte text sealed inline past the 64 KiB bound\")\n245|\t}\n246|\tdescriptor, ok := overBlock[\"blob_descriptor_id\"].(string)\n247|\tif !ok || descriptor == \"\" {\n248|\t\tt.Fatalf(\"overflow block misses its blob_descriptor_id: %v\", overBlock)\n249|\t}\n250|\tresolved := mustResolveOverflow(t, bundle.sink, descriptor)\n251|\tif string(resolved) != overflow {\n252|\t\tt.Fatal(\"overflow reference does not resolve to the exact 65537 bytes: truncated or re-encoded\")\n253|\t}\n254|\temptyPayload := sealedPayload(t, sealed[\"evt-empty\"])\n255|\temptyBlocks := emptyPayload[\"content_blocks\"].([]any)\n256|\tif emptyBlocks[0].(map[string]any)[\"content\"] != \"\" {\n257|\t\tt.Fatal(\"empty text did not seal inline\")\n258|\t}\n259|\tif len(result.Overflows) != 1 {\n260|\t\tt.Fatalf(\"len(Overflows) = %d, want 1\", len(result.Overflows))\n261|\t}\n262|\tif result.Overflows[0].DescriptorID.String() != descriptor {\n263|\t\tt.Fatal(\"reported overflow descriptor differs from the sealed reference\")\n264|\t}\n265|}\n266|\n267|func TestNormalizeMultibyteStringMeasure(t *testing.T) {\n268|\twide512 := strings.Repeat(\"\\u00e9\", 512)\n269|\tbundle := projectMembers(t, []fixtureMember{\n270|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n271|\t\t\trec(wide512, \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"wide\"}`),\n272|\t\t)},\n273|\t})\n274|\tif len(bundle.result.DecodedEvents) != 1 {\n275|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1: 512 characters measured as bytes refused\", len(bundle.result.DecodedEvents))\n276|\t}\n277|\twide513 := strings.Repeat(\"\\u00e9\", 513)\n278|\tcapture, store := captureMembers(t, []fixtureMember{\n279|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n280|\t\t\trec(wide513, \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"wide\"}`),\n281|\t\t)},\n282|\t})\n283|\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n284|\tif err == nil {\n285|\t\tt.Fatal(\"Normalize() admitted a 513-character native event ID\")\n286|\t}\n287|\tif !strings.Contains(err.Error(), \"line 1 native_event_id\") {\n288|\t\tt.Fatalf(\"Normalize() error = %v, want the record-level width refusal\", err)\n289|\t}\n290|}\n291|\n292|func TestNormalizeIsDeterministic(t *testing.T) {\n293|\tmembers := []fixtureMember{\n294|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n295|\t\t\trec(\"evt-d-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"determinism\"}`),\n296|\t\t\trec(\"evt-d-2\", \"frobnicate\", \"native\", \"none\", \"main\", `{\"n\":2}`),\n297|\t\t\trec(\"evt-d-3\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":7,\"output_tokens\":9}`),\n298|\t\t)},\n299|\t}\n300|\tcapture, store := captureMembers(t, members)\n301|\tfirst, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n302|\tif err != nil {\n303|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n304|\t}\n305|\tsecond, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n306|\tif err != nil {\n307|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n308|\t}\n309|\tif !bytes.Equal(first.Session, second.Session) {\n310|\t\tt.Fatal(\"same captured bytes did not seal byte-identical sessions\")\n311|\t}\n312|\tif len(first.Events) != len(second.Events) {\n313|\t\tt.Fatalf(\"event counts %d != %d\", len(first.Events), len(second.Events))\n314|\t}\n315|\tfor index := range first.Events {\n316|\t\tif !bytes.Equal(first.Events[index], second.Events[index]) {\n317|\t\t\tt.Fatalf(\"event[%d] differs across identical projections\", index)\n318|\t\t}\n319|\t}\n320|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
