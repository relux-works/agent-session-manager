claim\",\n199|        expect=\"KILLED\",\n200|        note=\"Admits exactly the call-live followup claim; every other live followup still refuses.\",\n201|    ),\n202|    Mutant(\n203|        name=\"N-duplicate-call\",\n204|        path=f\"{PACKAGE}/tools.go\",\n205|        find='''\\t\\tif _, duplicate := seenCalls[call.body.CallID]; duplicate {\\n''',\n206|        replace='''\\t\\tif _, duplicate := seenCalls[call.body.CallID]; duplicate && call.body.CallID != \"call-dup\" {\\n''',\n207|        count=1,\n208|        run=\"TestNormalizeRefusalTable/duplicate_call_id\",\n209|        expect=\"KILLED\",\n210|        note=\"Admits exactly the duplicated call-dup ID; every other duplicate call still refuses.\",\n211|    ),\n212|    Mutant(\n213|        name=\"N-usage-target\",\n214|        path=f\"{PACKAGE}/tools.go\",\n215|        find='''\\t\\tledger.SourceInputTokens = input\\n\\t\\tledger.SourceOutputTokens = output\\n''',\n216|        replace='''\\t\\tledger.SourceInputTokens = input\\n\\t\\tledger.SourceOutputTokens = output\\n\\t\\tif observation.record.NativeEventID == \"evt-use-1\" {\\n\\t\\t\\tledger.TargetInputTokens += observation.body.InputTokens\\n\\t\\t}\\n''',\n217|        count=1,\n218|        run=\"TestNormalizeSourceUsageIsNotTargetAccounting\",\n219|        expect=\"KILLED\",\n220|        note=\"Funds the target ledger from exactly evt-use-1; every other source record still counts source-only.\",\n221|    ),\n222|    Mutant(\n223|        name=\"N-overflow-bound\",\n224|        path=f\"{PACKAGE}/overflow.go\",\n225|        find='''\\tif len(text) > maxInlineContentBytes {\\n''',\n226|        replace='''\\tif len(text) > maxInlineContentBytes+1 {\\n''',\n227|        count=1,\n228|        run=\"TestNormalizeInlineContentBoundary\",\n229|        expect=\"KILLED\",\n230|        note=\"Admits exactly 65537-byte text inline past the 64 KiB bound; 65538+ still becomes a blob reference.\",\n231|    ),\n232|    Mutant(\n233|        name=\"N-overflow-truncate\",\n234|        path=f\"{PACKAGE}/overflow.go\",\n235|        find='''\\tif len(text) > maxInlineContentBytes {\\n\\t\\tinstalled, err := installOverflow(sink, text)\\n''',\n236|        replace='''\\tif len(text) > maxInlineContentBytes {\\n\\t\\ttext = text[:maxInlineContentBytes]\\n\\t}\\n\\tif false {\\n\\t\\tinstalled, err := installOverflow(sink, text)\\n''',\n237|        count=1,\n238|        run=\"TestNormalizeInlineContentBoundary\",\n239|        expect=\"KILLED\",\n240|        note=\"Behaviour swap (labelled, not a narrowing): silently truncates oversized text to 64 KiB instead of installing a blob reference; the byte-exactness killer reddens.\",\n241|    ),\n242|    Mutant(\n243|        name=\"N-unstable\",\n244|        path=f\"{PACKAGE}/normalize.go\",\n245|        find='''\\tif err := clonebundle.RefuseUnstableForTarget(capture.CaptureBoundary); err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n''',\n246|        replace='''\\tif err := clonebundle.RefuseUnstableForTarget(capture.CaptureBoundary); err != nil && capture.OperationID.String() != \"0198f4d1-9e60-7a11-8a31-abcdef012345\" {\\n\\t\\treturn nil, err\\n\\t}\\n''',\n247|        count=1,\n248|        run=\"TestNormalizeRefusesUnstableCapture\",\n249|        expect=\"KILLED\",\n250|        note=\"Admits exactly the fixture unstable archive to target projection; every other unstable capture still refuses.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-digest-verify\",\n254|        path=f\"{PACKAGE}/normalize.go\",\n255|        find='''\\t\\tif scalar.SHA256Digest(payload).String() != entry.BlobID.String() {\\n''',\n256|        replace='''\\t\\tif scalar.SHA256Digest(payload).String() != entry.BlobID.String() && item.NativeItemKey != \"store/session.jsonl\" {\\n''',\n257|        count=1,\n258|        run=\"TestNormalizeRefusalTable/tampered_blob\",\n259|        expect=\"KILLED\",\n260|        note=\"Skips the digest check for exactly store/session.jsonl; the tampered bytes then fail framing instead of the digest refusal.\",\n261|    ),\n262|    Mutant(\n263|        name=\"N-subagent-actor\",\n264|        path=f\"{PACKAGE}/dispatch.go\",\n265|        find='''\\t\\tif unit.record.Actor == \"main\" {\\n''',\n266|        replace='''\\t\\tif unit.record.Actor == \"main\" || unit.record.Actor == \"subagent:fetch\" {\\n''',\n267|        count=1,\n268|        run=\"TestNormalizeToolMatrix/nested_subagent_call\",\n269|        expect=\"KILLED\",\n270|        note=\"Attributes exactly the nested fetch call to main; every other non-main selector still resolves to its mapped actor.\",\n271|    ),\n272|    Mutant(\n273|        name=\"N-instruction-authority\",\n274|        path=f\"{PACKAGE}/native.go\",\n275|        find='''\\tif authority != \"high\" && authority != \"low\" {\\n''',\n276|        replace='''\\tif authority != \"high\" && authority != \"low\" && authority != \"absolute\" {\\n''',\n277|        count=1,\n278|        run=\"TestNormalizeRefusalTable/bad_instruction_authority\",\n279|        expect=\"KILLED\",\n280|        note=\"Admits exactly the absolute authority claim; every other non-high/low claim still refuses.\",\n281|    ),\n282|    Mutant(\n283|        name=\"N-definition-digest\",\n284|        path=f\"{PACKAGE}/normalize.go\",\n285|        find='''\\t\\t\\tif _, err := scalar.ParseDigest(body.DefinitionHash); err != nil {\\n''',\n286|        replace='''\\t\\t\\tif _, err := scalar.ParseDigest(body.DefinitionHash); err != nil && body.DefinitionHash != \"not-a-digest\" {\\n''',\n287|        count=1,\n288|        run=\"TestNormalizeRefusalTable/bad_definition_digest\",\n289|        expect=\"KILLED\",\n290|        note=\"Admits exactly the not-a-digest definition hash; every other malformed digest still refuses.\",\n291|    ),\n292|    Mutant(\n293|        name=\"N-parents-chain\",\n294|        path=f\"{PACKAGE}/dispatch.go\",\n295|        find='''\\t\\tparents := []string{}\\n\\t\\tif previous != nil {\\n\\t\\t\\tparents = []string{previous.String()}\\n\\t\\t}\\n''',\n296|        replace='''\\t\\tparents := []string{}\\n\\t\\tif previous != nil && index != 1 {\\n\\t\\t\\tparents = []string{previous.String()}\\n\\t\\t}\\n''',\n297|        count=1,\n298|        run=\"TestNormalizeSealsSessionShape\",\n299|        expect=\"KILLED\",\n300|        note=\"Leaves exactly ordinal 1 unparented; every other ordinal still chains to its predecessor.\",\n301|    ),\n302|    Mutant(\n303|        name=\"N-string-bound\",\n304|        path=f\"{PACKAGE}/native.go\",\n305|        find='''\\tif environ.StringLength(envelope.NativeEventID) < 1 || environ.StringLength(envelope.NativeEventID) > 512 {\\n''',\n306|        replace='''\\tif environ.StringLength(envelope.NativeEventID) < 1 || environ.StringLength(envelope.NativeEventID) > 513 {\\n''',\n307|        count=1,\n308|        run=\"TestNormalizeMultibyteStringMeasure\",\n309|        expect=\"KILLED\",\n310|        note=\"Admits exactly a 513-character native event ID; 514+ still refuses. Pins the envelope ID edge only; per-edge rows for directives, call IDs, and tool names are stated bounds.\",\n311|    ),\n312|    Mutant(\n313|        name=\"N-envelope-version\",\n314|        path=f\"{PACKAGE}/native.go\",\n315|        find='''\\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok {\\n''',\n316|        replace='''\\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok && string(members[\"v\"]) != \"2\" {\\n''',\n317|        count=1,\n318|        run=\"TestNormalizeRefusalTable/bad_envelope_version\",\n319|        expect=\"KILLED\",\n320|        note=\"Admits exactly envelope version 2 past the landed uint53 gate; every other non-1 version still refuses.\",\n321|    ),\n322|    Mutant(\n323|        name=\"N-origin\",\n324|        path=f\"{PACKAGE}/native.go\",\n325|        find='''\\tif envelope.Origin != \"native\" && envelope.Origin != \"foreign\" {\\n''',\n326|        replace='''\\tif envelope.Origin != \"native\" && envelope.Origin != \"foreign\" && envelope.Origin != \"sideways\" {\\n''',\n327|        count=1,\n328|        run=\"TestNormalizeRefusalTable/bad_origin\",\n329|        expect=\"KILLED\",\n330|        note=\"Admits exactly the sideways origin; every other non-native/foreign origin still refuses.\",\n331|    ),\n332|    Mutant(\n333|        name=\"N-protection-value\",\n334|        path=f\"{PACKAGE}/native.go\",\n335|        find='''\\tif envelope.Protection != \"none\" && envelope.Protection != \"encrypted\" && envelope.Protection != \"signed\" {\\n''',\n336|        replace='''\\tif envelope.Protection != \"none\" && envelope.Protection != \"encrypted\" && envelope.Protection != \"signed\" && envelope.Protection != \"rot13\" {\\n''',\n337|        count=1,\n338|        run=\"TestNormalizeRefusalTable/bad_protection\",\n339|        expect=\"KILLED\",\n340|        note=\"Admits exactly the rot13 protection; every other out-of-vocabulary protection still refuses.\",\n341|    ),\n342|    Mutant(\n343|        name=\"N-actor-selector\",\n344|        path=f\"{PACKAGE}/native.go\",\n345|        find='''\\tname, ok := strings.CutPrefix(selector, \"subagent:\")\\n\\tif !ok || name == \"\" {\\n''',\n346|        replace='''\\tname, ok := strings.CutPrefix(selector, \"subagent:\")\\n\\tif (!ok || name == \"\") && selector != \"boss\" {\\n''',\n347|        count=1,\n348|        run=\"TestNormalizeRefusalTable/bad_actor_shape\",\n349|        expect=\"KILLED\",\n350|        note=\"Admits exactly the boss selector; every other malformed selector still refuses.\",\n351|    ),\n352|    Mutant(\n353|        name=\"N-subagent-name\",\n354|        path=f\"{PACKAGE}/native.go\",\n355|        find='''\\tif environ.StringLength(name) > 128 {\\n''',\n356|        replace='''\\tif environ.StringLength(name) > 129 {\\n''',\n357|        count=1,\n358|        run=\"TestNormalizeRefusalTable/long_subagent_name\",\n359|        expect=\"KILLED\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f1","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":595,"recorded_at":1780531400001185,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"call_id":"call_01a0b42e27e575eca22bdc7bb9fcea30","text":"Read text file `internal/cloneproject/fixtures_test.go`.\n(199 line(s) above)\n200|\t\tStore:             store,\n201|\t}\n202|}\n203|\n204|// storeFetch returns a blob fetcher reading through the store's real\n205|// digest-to-path layout: the bytes Normalize sees are the bytes the\n206|// capture installed, addressed by content digest.\n207|func storeFetch(t *testing.T, store *localstore.ObjectStore) func(blobID string) ([]byte, error) {\n208|\tt.Helper()\n209|\tstyle := localstore.PathStylePOSIX\n210|\tif runtime.GOOS == \"windows\" {\n211|\t\tstyle = localstore.PathStyleWindows\n212|\t}\n213|\treturn func(blobID string) ([]byte, error) {\n214|\t\tdigest, err := scalar.ParseDigest(blobID)\n215|\t\tif err != nil {\n216|\t\t\treturn nil, err\n217|\t\t}\n218|\t\trelative, err := localstore.DigestPathV1(digest, style)\n219|\t\tif err != nil {\n220|\t\t\treturn nil, err\n221|\t\t}\n222|\t\treturn os.ReadFile(filepath.Join(store.DataRoot(), \"objects\", filepath.FromSlash(relative)))\n223|\t}\n224|}\n225|\n226|// normalizeRequest wires a Normalize request over a real capture\n227|// result: the sealed manifests, the capture store fetcher, a fresh\n228|// canonical sink, and the capture's workspace checkpoint.\n229|func normalizeRequest(t *testing.T, capture *clonesnap.CaptureResult, captureStore, canonicalSink *localstore.ObjectStore) NormalizeRequest {\n230|\tt.Helper()\n231|\treturn NormalizeRequest{\n232|\t\tCaptureManifest:  capture.CaptureManifest,\n233|\t\tRawManifest:      capture.RawManifest,\n234|\t\tFetch:            storeFetch(t, captureStore),\n235|\t\tCanonicalSink:    canonicalSink,\n236|\t\tLogicalSessionID: fixtureLogicalID,\n237|\t\tMainActorID:      fixtureMainActor,\n238|\t\tWorkspace:        capture.WorkspaceBinding,\n239|\t}\n240|}\n241|\n242|// captureMembers runs the real capture entry over the given members\n243|// and returns the result with its store.\n244|func captureMembers(t *testing.T, members []fixtureMember) (*clonesnap.CaptureResult, *localstore.ObjectStore) {\n245|\tt.Helper()\n246|\troot := writeFixtureStore(t, members)\n247|\tstore := openTestStore(t)\n248|\tresult, err := clonesnap.Capture(validCaptureRequest(t, root, store, members))\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"Capture() error = %v\", err)\n251|\t}\n252|\treturn result, store\n253|}\n254|\n255|// projectionBundle bundles one full real-path run: the capture result,\n256|// its store, the canonical sink, the member bytes, and the\n257|// normalized bundle.\n258|type projectionBundle struct {\n259|\tcapture *clonesnap.CaptureResult\n260|\tstore   *localstore.ObjectStore\n261|\tsink    *localstore.ObjectStore\n262|\tmembers []fixtureMember\n263|\tresult  *NormalizeResult\n264|}\n265|\n266|// projectMembers runs the full real path: capture, then Normalize\n267|// over the sealed manifests with a fresh canonical sink.\n268|func projectMembers(t *testing.T, members []fixtureMember) projectionBundle {\n269|\tt.Helper()\n270|\tcapture, store := captureMembers(t, members)\n271|\tsink := openTestStore(t)\n272|\tresult, err := Normalize(normalizeRequest(t, capture, store, sink))\n273|\tif err != nil {\n274|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n275|\t}\n276|\treturn projectionBundle{capture: capture, store: store, sink: sink, members: members, result: result}\n277|}\n278|\n279|// mustWorkspaceBytes captures one throwaway member and returns its\n280|// sealed workspace checkpoint for builder-constructed requests.\n281|func mustWorkspaceBytes(t *testing.T) []byte {\n282|\tt.Helper()\n283|\tcapture, _ := captureMembers(t, []fixtureMember{\n284|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n285|\t\t\trec(\"evt-ws\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`),\n286|\t\t)},\n287|\t})\n288|\treturn capture.WorkspaceBinding\n289|}\n290|\n291|// memberBytes returns the original bytes of one fixture member.\n292|func (bundle projectionBundle) memberBytes(t *testing.T, key string) []byte {\n293|\tt.Helper()\n294|\tfor _, member := range bundle.members {\n295|\t\tif member.key == key {\n296|\t\t\treturn member.content\n297|\t\t}\n298|\t}\n299|\tt.Fatalf(\"no fixture member %q\", key)\n300|\treturn nil\n301|}\n302|\n303|// rec builds one fixture-native record line.\n304|func rec(id, nativeType, origin, protection, actor, body string) string {\n305|\treturn `{\"v\":1,\"native_event_id\":\"` + id + `\",\"native_type\":\"` + nativeType + `\",\"origin\":\"` + origin +\n306|\t\t`\",\"protection\":\"` + protection + `\",\"actor\":\"` + actor + `\",\"body\":` + body + `}`\n307|}\n308|\n309|// jsonl joins record lines into member bytes with a trailing newline.\n310|func jsonl(lines ...string) []byte {\n311|\treturn []byte(strings.Join(lines, \"\\n\") + \"\\n\")\n312|}\n313|\n314|// eventByNativeID finds the decoded event carrying a native event ID.\n315|func eventByNativeID(t *testing.T, result *NormalizeResult, id string) clonebundle.CanonicalEvent {\n316|\tt.Helper()\n317|\tfor _, decoded := range result.DecodedEvents {\n318|\t\tif decoded.Evidence.NativeEventID != nil && *decoded.Evidence.NativeEventID == id {\n319|\t\t\treturn decoded\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
