{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca7d","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":921,"recorded_at":1780531400001837,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"task_stream":{"kind":"task","id":"01a0b430-c2a6-7f62-a9ef-61836af81710"},"task_id":"01a0b430-c2a6-7f62-a9ef-61836af81710","event":{"kind":"output","task_id":"01a0b430-c2a6-7f62-a9ef-61836af81710","chunk":"Read text file `internal/environ/decode.go`.\n(259 line(s) above)\n260|\t}\n261|\treturn value, true\n262|}\n263|\n264|// StringLength is the Section 1.6 string measure in characters,\n265|// not bytes: a bound of string[1..128] admits 128 characters of\n266|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n267|// env literals, Section 5.1) do not go through here; the measure\n268|// battery ledgers that split.\n269|func StringLength(value string) int {\n270|\treturn utf8.RuneCountInString(value)\n271|}\n272|\n273|// CheckStringBounds reports whether the member is a JSON string\n274|// whose character count falls in the inclusive bound.\n275|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n276|\tvalue, ok := rawString(raw)\n277|\tif !ok {\n278|\t\treturn \"\", false\n279|\t}\n280|\tlength := StringLength(value)\n281|\tif length < minimum || length > maximum {\n282|\t\treturn \"\", false\n283|\t}\n284|\treturn value, true\n285|}\n286|\n287|// CheckUint53Bounds reports whether the member is a uint53 in the\n288|// inclusive bound. Both edges are checked: a one-sided check\n289|// would admit the open side.\n290|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n291|\tvalue, ok := rawUint53(raw)\n292|\tif !ok {\n293|\t\treturn 0, false\n294|\t}\n295|\tif value < minimum || value > maximum {\n296|\t\treturn 0, false\n297|\t}\n298|\treturn value, true\n299|}\n300|\n301|// CheckDigest reports whether the member is a digest of the\n302|// pinned sha256 form.\n303|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Digest{}, false\n307|\t}\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n(more lines below)","final_result":true}}}
