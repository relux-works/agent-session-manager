{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a5","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":685,"recorded_at":1780531400001365,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"task_stream":{"kind":"task","id":"01a0b42e-5f60-7712-8f22-706f5e5c6123"},"task_id":"01a0b42e-5f60-7712-8f22-706f5e5c6123","event":{"kind":"output","task_id":"01a0b42e-5f60-7712-8f22-706f5e5c6123","chunk":"Read text file `internal/cloneproject/refusal_test.go`.\n(126 line(s) above)\n127|func TestNormalizeRefusalTable(t *testing.T) {\n128|\t// refuseMembers projects members that must refuse and asserts\n129|\t// the refusal fragment.\n130|\trefuseMembers := func(t *testing.T, members []fixtureMember, fragment string) {\n131|\t\tt.Helper()\n132|\t\tcapture, store := captureMembers(t, members)\n133|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n134|\t\tif err == nil {\n135|\t\t\tt.Fatalf(\"Normalize() admitted members that must refuse with %q\", fragment)\n136|\t\t}\n137|\t\tif !errors.Is(err, ErrInvalid) && !strings.Contains(err.Error(), fragment) {\n138|\t\t\tt.Fatalf(\"Normalize() error = %v, want fragment %q\", err, fragment)\n139|\t\t}\n140|\t\tif !strings.Contains(err.Error(), fragment) {\n141|\t\t\tt.Fatalf(\"Normalize() error = %v, want fragment %q\", err, fragment)\n142|\t\t}\n143|\t}\n144|\tmessage := func(id, body string) string {\n145|\t\treturn rec(id, \"message/user\", \"native\", \"none\", \"main\", body)\n146|\t}\n147|\tcall := func(id, body string) string {\n148|\t\treturn rec(\"evt-\"+id, \"tool/call\", \"native\", \"none\", \"main\", body)\n149|\t}\n150|\n151|\tt.Run(\"malformed_json_line\", func(t *testing.T) {\n152|\t\trefuseMembers(t, []fixtureMember{\n153|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: []byte(\"{not-json\\n\")},\n154|\t\t}, \"is not a JSON object\")\n155|\t})\n156|\tt.Run(\"missing_envelope_member\", func(t *testing.T) {\n157|\t\trefuseMembers(t, []fixtureMember{\n158|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n159|\t\t\t\t`{\"v\":1,\"native_event_id\":\"x\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\"}`,\n160|\t\t\t)},\n161|\t\t}, \"misses envelope member\")\n162|\t})\n163|\tt.Run(\"bad_envelope_version\", func(t *testing.T) {\n164|\t\trefuseMembers(t, []fixtureMember{\n165|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n166|\t\t\t\t`{\"v\":2,\"native_event_id\":\"x\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`,\n167|\t\t\t)},\n168|\t\t}, \"envelope version\")\n169|\t})\n170|\tt.Run(\"bad_origin\", func(t *testing.T) {\n171|\t\trefuseMembers(t, []fixtureMember{\n172|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n173|\t\t\t\trec(\"evt-bad-origin\", \"message/user\", \"sideways\", \"none\", \"main\", `{\"text\":\"x\"}`),\n174|\t\t\t)},\n175|\t\t}, \"outside native|foreign\")\n176|\t})\n177|\tt.Run(\"bad_protection\", func(t *testing.T) {\n178|\t\trefuseMembers(t, []fixtureMember{\n179|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n180|\t\t\t\trec(\"evt-bad-prot\", \"message/user\", \"native\", \"rot13\", \"main\", `{\"text\":\"x\"}`),\n181|\t\t\t)},\n182|\t\t}, \"outside none|encrypted|signed\")\n183|\t})\n184|\tt.Run(\"bad_actor_shape\", func(t *testing.T) {\n185|\t\trefuseMembers(t, []fixtureMember{\n186|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n187|\t\t\t\trec(\"evt-bad-actor\", \"message/user\", \"native\", \"none\", \"boss\", `{\"text\":\"x\"}`),\n188|\t\t\t)},\n189|\t\t}, \"outside main|external|subagent\")\n190|\t})\n191|\tt.Run(\"long_subagent_name\", func(t *testing.T) {\n192|\t\trefuseMembers(t, []fixtureMember{\n193|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n194|\t\t\t\trec(\"evt-long-sub\", \"message/user\", \"native\", \"none\", \"subagent:\"+strings.Repeat(\"s\", 129), `{\"text\":\"x\"}`),\n195|\t\t\t)},\n196|\t\t}, \"past 128 characters\")\n197|\t})\n198|\tt.Run(\"too_many_directives\", func(t *testing.T) {\n199|\t\tdirectives := `\"` + strings.Repeat(`d\",\"`, 1024) + `d\"`\n200|\t\trefuseMembers(t, []fixtureMember{\n201|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n202|\t\t\t\trec(\"evt-many-dir\", \"instruction/snapshot\", \"native\", \"none\", \"main\",\n203|\t\t\t\t\t`{\"authority\":\"low\",\"directives\":[`+directives+`]}`),\n204|\t\t\t)},\n205|\t\t}, \"maximum is 1024\")\n206|\t})\n207|\tt.Run(\"usage_ledger_overflow\", func(t *testing.T) {\n208|\t\trefuseMembers(t, []fixtureMember{\n209|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n210|\t\t\t\trec(\"evt-big-1\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":9007199254740991,\"output_tokens\":0}`),\n211|\t\t\t\trec(\"evt-big-2\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":1,\"output_tokens\":0}`),\n212|\t\t\t)},\n213|\t\t}, \"exceeds uint53\")\n214|\t})\n215|\tt.Run(\"bad_actor_uuid\", func(t *testing.T) {\n216|\t\tcapture, store := captureMembers(t, []fixtureMember{\n217|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n218|\t\t\t\trec(\"evt-bad-uuid\", \"message/user\", \"native\", \"none\", \"external\", `{\"text\":\"x\"}`),\n219|\t\t\t)},\n220|\t\t})\n221|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n222|\t\trequest.Actors = map[string]string{\"external\": \"not-a-uuid\"}\n223|\t\t_, err := Normalize(request)\n224|\t\tif err == nil {\n225|\t\t\tt.Fatal(\"Normalize() admitted a non-UUIDv7 actor mapping\")\n226|\t\t}\n227|\t\tif !strings.Contains(err.Error(), \"is not a UUIDv7\") {\n228|\t\t\tt.Fatalf(\"Normalize() error = %v, want the UUID refusal\", err)\n229|\t\t}\n230|\t})\n231|\tt.Run(\"blank_line\", func(t *testing.T) {\n232|\t\trefuseMembers(t, []fixtureMember{\n233|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: []byte(message(\"a\", `{\"text\":\"x\"}`) + \"\\n\\n\")},\n234|\t\t}, \"is empty\")\n235|\t})\n236|\tt.Run(\"unknown_body_member\", func(t *testing.T) {\n237|\t\trefuseMembers(t, []fixtureMember{\n238|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n239|\t\t\t\tmessage(\"evt-body-extra\", `{\"text\":\"x\",\"escalate\":true}`),\n240|\t\t\t)},\n241|\t\t}, \"unknown member\")\n242|\t})\n243|\tt.Run(\"contradictory_protection\", func(t *testing.T) {\n244|\t\trefuseMembers(t, []fixtureMember{\n245|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n246|\t\t\t\trec(\"evt-contra\", \"reasoning/encrypted\", \"native\", \"none\", \"main\", `{\"ciphertext\":\"x\"}`),\n247|\t\t\t)},\n248|\t\t}, \"with no protection\")\n249|\t})\n250|\tt.Run(\"protected_plaintext_body\", func(t *testing.T) {\n251|\t\trefuseMembers(t, []fixtureMember{\n252|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n253|\t\t\t\trec(\"evt-contra-body\", \"reasoning/summary\", \"native\", \"encrypted\", \"main\", `{\"text\":\"x\"}`),\n254|\t\t\t)},\n255|\t\t}, \"unknown member\")\n256|\t})\n(more lines below)","final_result":true}}}
