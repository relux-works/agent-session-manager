getOutputTokens)\\n\\t}\\n\\tfirst := eventByNativeID(t, bundle.result, \\\"evt-use-1\\\")\\n\\tif first.Kind != \\\"usage\\\" {\\n\\t\\tt.Fatalf(\\\"Kind = %q, want usage\\\", first.Kind)\\n\\t}\\n\\tif payloadInt(t, first, \\\"input_tokens\\\") != 100 || payloadInt(t, first, \\\"output_tokens\\\") != 40 {\\n\\t\\tt.Fatal(\\\"usage payload does not carry the exact token counts\\\")\\n\\t}\\n}\\n======\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"Normalize() error = %v\\\", err)\\n\\t}\\n\\tif !bytes.Equal(first.Session, second.Session) {\\n\\t\\tt.Fatal(\\\"same captured bytes did not seal byte-identical sessions\\\")\\n\\t}\\n\\tif len(first.Events) != len(second.Events) {\\n\\t\\tt.Fatalf(\\\"event counts %d != %d\\\", len(first.Events), len(second.Events))\\n\\t}\\n\\tfor index := range first.Events {\\n\\t\\tif !bytes.Equal(first.Events[index], second.Events[index]) {\\n\\t\\t\\tt.Fatalf(\\\"event[%d] differs across identical projections\\\", index)\\n\\t\\t}\\n\\t}\\n}\\n======\\n572:\\tt.Run(\\\"bad_result_status\\\", func(t *testing.T) {\\n580:\\tt.Run(\\\"unknown_protected_plaintext_body\\\", func(t *testing.T) {\\n\",\n  \"original_output_bytes\": 1755,\n  \"original_output_tokens\": 439,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
