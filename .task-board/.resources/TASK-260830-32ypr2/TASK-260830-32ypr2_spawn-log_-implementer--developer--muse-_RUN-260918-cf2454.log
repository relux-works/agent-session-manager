{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c653","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":388,"recorded_at":1780531400000771,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"task_stream":{"kind":"task","id":"01a0b42d-b73f-7d82-8fbc-a1c252d4be62"},"task_id":"01a0b42d-b73f-7d82-8fbc-a1c252d4be62","event":{"kind":"output","task_id":"01a0b42d-b73f-7d82-8fbc-a1c252d4be62","chunk":"Read text file `.temp/TASK-260830-32ypr2/rev2-review/reviewer_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing plants for TASK-260830-32ypr2 rev2 (RUN-260918-a4ffef).\n3|\n4|Each row mutates one production file in an isolated copy of the exact\n5|candidate tree, runs the committed cloneproject suite through the real\n6|Normalize entry (-run TestNormalize, i.e. the whole committed suite, not\n7|one killer), records the subprocess exit and verdict, restores the file.\n8|Rows are on gates the producer's harness does not mutate. RC-control is\n9|the applied harmless SURVIVED control.\n10|\"\"\"\n11|import shutil, subprocess, sys, tempfile, time\n12|from dataclasses import dataclass\n13|from pathlib import Path\n14|\n15|REPO = Path(sys.argv[1]).resolve()\n16|LOG_DIR = Path(sys.argv[2]).resolve()\n17|PACKAGE = \"internal/cloneproject\"\n18|\n19|@dataclass(frozen=True)\n20|class Mutant:\n21|    name: str; path: str; find: str; replace: str; run: str; note: str\n22|\n23|M = [\n24|    Mutant(\"R1-required-member-body-dropped\", f\"{PACKAGE}/native.go\",\n25|        '''\\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\\n''',\n26|        '''\\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\"} {\\n''',\n27|        \"TestNormalize\",\n28|        \"Member check dropped: body is no longer a required envelope member. A known type still refuses at the body decode (different message); an unknown type without a body is admitted as opaque_event.\"),\n29|    Mutant(\"R2-native-type-width-513\", f\"{PACKAGE}/native.go\",\n30|        '''\\tif environ.StringLength(envelope.NativeType) < 1 || environ.StringLength(envelope.NativeType) > 512 {\\n''',\n31|        '''\\tif environ.StringLength(envelope.NativeType) < 1 || environ.StringLength(envelope.NativeType) > 513 {\\n''',\n32|        \"TestNormalize\",\n33|        \"Bound widened by one: a 513-character native_type is admitted; 514+ still refuses.\"),\n34|    Mutant(\"R3-reasons-unsorted\", f\"{PACKAGE}/dispatch.go\",\n35|        '''\\t\\treasons = append(reasons, reasonUnknownNative)\\n\\t\\tsort.Strings(reasons)\\n''',\n36|        '''\\t\\treasons = append([]string{reasonUnknownNative}, reasons...)\\n''',\n37|        \"TestNormalize\",\n38|        \"Unsorted array admitted: the two-reason list is emitted in reverse order with no sort.\"),\n39|    Mutant(\"R4-capture-status-partial-messages\", f\"{PACKAGE}/dispatch.go\",\n40|        '''\\t\\tCaptureStatus: \"exact\",\\n''',\n41|        '''\\t\\tCaptureStatus: map[bool]string{true: \"partial\", false: \"exact\"}[record.NativeType == nativeMessageUser],\\n''',\n42|        \"TestNormalize\",\n43|        \"Capture status stamped partial for exactly message/user records while nothing is partial; every other record still stamps exact.\"),\n44|    Mutant(\"R5-reasoning-summary-routed-public\", f\"{PACKAGE}/dispatch.go\",\n45|        '''\\tdefault:\\n\\t\\tunit.kind = \"reasoning_summary\"\\n\\t\\tunit.visibility = \"internal\"\\n''',\n46|        '''\\tdefault:\\n\\t\\tunit.kind = \"user_message\"\\n\\t\\tunit.visibility = \"public\"\\n''',\n47|        \"TestNormalize\",\n48|        \"Kind/visibility swap on the one emitted kind with no positive row: unprotected reasoning/summary projects user_message with public visibility.\"),\n49|    Mutant(\"R6-first-native-instruction-wins\", f\"{PACKAGE}/tools.go\",\n50|        '''\\t\\tif observation.record.Origin != \"native\" {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n''',\n51|        '''\\t\\tif observation.record.Origin != \"native\" || effective.Found {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n''',\n52|        \"TestNormalize\",\n53|        \"Fold order swap: the first native instruction wins instead of the last (doc comment claims last-wins).\"),\n54|    Mutant(\"R7-external-actor-kind-subagent\", f\"{PACKAGE}/dispatch.go\",\n55|        '''\\t\\tkind := \"external\"\\n''',\n56|        '''\\t\\tkind := \"subagent\"\\n''',\n57|        \"TestNormalize\",\n58|        \"Actor kind swap for exactly the external selector: it seals as a subagent actor parented on main.\"),\n59|    Mutant(\"RC-control-comment\", f\"{PACKAGE}/normalize.go\",\n60|        '''// Stable reason codes this projection emits.''',\n61|        '''// Stable reason codes this projection emits (reviewer control).''',\n62|        \"TestNormalize\",\n63|        \"Harmless control: comment-only edit must SURVIVE.\"),\n64|]\n65|\n66|def run(m: Mutant):\n67|    target = REPO / m.path\n68|    original = target.read_text()\n69|    if original.count(m.find) != 1:\n70|        return \"ERROR\", f\"anchors={original.count(m.find)}\", -1, 0.0\n71|    with tempfile.TemporaryDirectory() as staging:\n72|        backup = Path(staging) / \"b\"; shutil.copy2(target, backup)\n73|        try:\n74|            target.write_text(original.replace(m.find, m.replace))\n75|            started = time.time()\n76|            r = subprocess.run([\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", m.run, \"-count=1\"], cwd=REPO, capture_output=True, text=True, timeout=600)\n77|            elapsed = time.time() - started\n78|        finally:\n79|            shutil.copy2(backup, target)\n80|    out = (r.stdout + r.stderr).strip()\n81|    if 'build failed' in out or '\\n# ' in out or out.startswith('# '):\n82|        return \"ERROR\", out, r.returncode, elapsed\n83|    if r.returncode == 0:\n84|        return \"SURVIVED\", out, 0, elapsed\n85|    if '--- FAIL' in out or 'FAIL:' in out:\n86|        return \"KILLED\", out, r.returncode, elapsed\n87|    return \"ERROR\", out, r.returncode, elapsed\n88|\n89|LOG_DIR.mkdir(parents=True, exist_ok=True)\n90|for m in M:\n91|    verdict, out, code, elapsed = run(m)\n92|    fails = sorted({line.split()[2] for line in out.splitlines() if line.strip().startswith('--- FAIL')})\n93|    print(f\"{m.name}: {verdict} exit={code} elapsed={elapsed:.0f}s fails={fails[:6]} :: {m.note}\", flush=True)\n94|    (LOG_DIR / f\"{m.name}.log\").write_text(f\"# mutant={m.name} path={m.path} -run={m.run}\\n# verdict={verdict} exit={code} elapsed={elapsed:.1f}s\\n# find={m.find!r}\\n# replace={m.replace!r}\\n---\\n{out}\\n\")","final_result":true}}}
