{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b5","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":565,"recorded_at":1780531400001125,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"call_id":"call_01a0b42e12187423966d8f05c5dcd215","text":"Read text file `internal/cloneproject/testdata/mutant_harness.py`.\n(659 line(s) above)\n660|        note=\"Admits exactly the killer's protected tool call into pairing, where its ciphertext body refuses; every other protected non-reasoning record still skips folding.\",\n661|    ),\n662|    Mutant(\n663|        name=\"N-result-status-pending\",\n664|        path=f\"{PACKAGE}/native.go\",\n665|        find='''\\tif status != \"ok\" && status != \"error\" {\\n''',\n666|        replace='''\\tif status != \"ok\" && status != \"error\" && status != \"pending\" {\\n''',\n667|        count=1,\n668|        run=\"TestNormalizeRefusalTable/bad_result_status\",\n669|        expect=\"KILLED\",\n670|        note=\"Admits exactly the pending result status, resolving the call completed; every other out-of-vocabulary status still refuses.\",\n671|    ),\n672|    Mutant(\n673|        name=\"N-size-verify\",\n674|        path=f\"{PACKAGE}/normalize.go\",\n675|        find='''\\t\\tif uint64(len(payload)) != entry.ByteCount {\\n''',\n676|        replace='''\\t\\tif uint64(len(payload)) != entry.ByteCount && item.NativeItemKey != \"store/session.jsonl\" {\\n''',\n677|        count=1,\n678|        run=\"TestNormalizeRefusalTable/blob_size_drift\",\n679|        expect=\"KILLED\",\n680|        note=\"Skips the size arm for exactly store/session.jsonl, so the drift reaches the digest arm with its different message; every other member still fails at the size arm.\",\n681|    ),\n682|    Mutant(\n683|        name=\"N-actors-sort\",\n684|        path=f\"{PACKAGE}/dispatch.go\",\n685|        find='''\\tsort.Strings(selectors)\\n''',\n686|        replace='''\\tif len(selectors) != 3 {\\n\\t\\tsort.Strings(selectors)\\n\\t}\\n''',\n687|        count=1,\n688|        run=\"TestNormalizeActorOrderIsDeterministic\",\n689|        expect=\"KILLED\",\n690|        note=\"Leaves exactly the three-actor shape unsorted so map order leaks into the sealed session; every other actor count still sorts.\",\n691|    ),\n692|    Mutant(\n693|        name=\"N-unknown-protected-body\",\n694|        path=f\"{PACKAGE}/dispatch.go\",\n695|        find='''\\tif _, err := decodeProtectedBody(record); err != nil {\\n\\t\\treturn err\\n\\t}\\n''',\n696|        replace='''\\tif _, err := decodeProtectedBody(record); err != nil && record.NativeEventID != \"evt-unk-prot\" {\\n\\t\\treturn err\\n\\t}\\n''',\n697|        count=1,\n698|        run=\"TestNormalizeRefusalTable/unknown_protected_plaintext_body\",\n699|        expect=\"KILLED\",\n700|        note=\"Admits exactly the killer's non-ciphertext protected body past the body-shape gate into an opaque projection; every other misshapen protected body still refuses.\",\n701|    ),\n702|    Mutant(\n703|        name=\"C-doc-comment\",\n704|        path=f\"{PACKAGE}/doc.go\",\n705|        find=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\\n\",\n706|        replace=\"// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections (control).\\n\",\n707|        count=1,\n708|        run=\"TestNormalizeSourceUsageIsNotTargetAccounting\",\n709|        expect=\"SURVIVED\",\n710|        note=\"Harmless control: a comment-only edit must survive.\",\n711|    ),\n712|]\n713|def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\n714|    target = REPO / mutant.path\n715|    original = target.read_text()\n716|    found = original.count(mutant.find)\n717|    if found != mutant.count:\n718|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\", \"\", -1, 0.0\n719|    with tempfile.TemporaryDirectory() as staging:\n720|        backup = Path(staging) / \"backup\"\n721|        shutil.copy2(target, backup)\n722|        try:\n723|            target.write_text(original.replace(mutant.find, mutant.replace))\n724|            started = time.time()\n725|            run = subprocess.run(\n726|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n727|                cwd=REPO,\n728|                capture_output=True,\n729|                text=True,\n730|                timeout=300,\n731|            )\n732|            elapsed = time.time() - started\n733|        finally:\n734|            shutil.copy2(backup, target)\n735|    output = (run.stdout + run.stderr).strip()\n736|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n737|        return f\"ERROR: {mutant.name}: build broke under the patch\", output, run.returncode, elapsed\n738|    if run.returncode == 0:\n739|        verdict = \"SURVIVED\"\n740|    elif '--- FAIL' in output or 'FAIL:' in output:\n741|        verdict = \"KILLED\"\n742|    else:\n743|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\", output, run.returncode, elapsed\n744|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n745|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\", output, run.returncode, elapsed\n746|\n747|\n748|def main(argv: list[str]) -> int:\n749|    log_dir: Path | None = None\n750|    selected_names: list[str] = []\n751|    args = list(argv)\n752|    while args:\n753|        if args[0] == \"--log-dir\":\n754|            if len(args) < 2:\n755|                print(\"missing directory for --log-dir\")\n756|                return 2\n757|            log_dir = Path(args[1])\n758|            args = args[2:]\n759|        else:\n760|            selected_names.append(args[0])\n761|            args = args[1:]\n762|    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\n763|    if selected_names and len(selected) != len(selected_names):\n764|        unknown = sorted(set(selected_names) - {m.name for m in selected})\n765|        print(f\"unknown mutants: {', '.join(unknown)}\")\n766|        return 2\n767|    if log_dir is not None:\n768|        log_dir.mkdir(parents=True, exist_ok=True)\n769|    failures = 0\n770|    for mutant in selected:\n771|        try:\n772|            line, output, exit_code, elapsed = run_mutant(mutant)\n773|        except subprocess.TimeoutExpired:\n774|            line, output, exit_code, elapsed = f\"ERROR: {mutant.name}: killer timed out\", \"\", -1, 0.0\n775|        print(line, flush=True)\n776|        if log_dir is not None:\n777|            (log_dir / f\"{mutant.name}.log\").write_text(\n778|                f\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\n\"\n779|                f\"# exit={exit_code} elapsed={elapsed:.1f}s\\n\"\n780|                f\"# find={mutant.find!r}\\n# replace={mutant.replace!r}\\n---\\n{output}\\n\"\n781|            )\n782|        if not line.startswith(\"ok:\"):\n783|            failures += 1\n784|    return 1 if failures else 0\n785|\n786|\n787|if __name__ == \"__main__\":\n788|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
