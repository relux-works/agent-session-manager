ue, true\n299|}\n300|\n301|// CheckDigest reports whether the member is a digest of the\n302|// pinned sha256 form.\n303|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Digest{}, false\n307|\t}\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca83","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":924,"recorded_at":1780531400001843,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"call_id":"call_01a0b430bd8f7718b38fe1470cf92b42","text":"Read text file `internal/cloneproject/doc.go`.\n1|package cloneproject\n2|\n3|// This package implements the Section 13.14.1 projection-fidelity\n4|// closure: Normalize derives a Canonical Session and Canonical Events\n5|// from captured bytes (a sealed Clone Capture Manifest, its sealed\n6|// Clone Raw Object Manifest, and the installed payload blobs). It is\n7|// the final leaf of the canonical-session-capture-and-evidence\n8|// story: contracts come from internal/clonebundle, capture from\n9|// internal/clonesnap, and this package owns normalization only.\n10|//\n11|// Authority: relux-works/agent-session-manager-spec@v0.7.0, Sections\n12|// 7.8, 10.2, and 13.14.1 (internal/specdoc/SPEC.v0.7.0.md).\n13|//\n14|// The projection input is captured bytes, never hand-written\n15|// Canonical Events: every proof builds a fixture provider store,\n16|// runs clonesnap.Capture over it, and normalizes the sealed output.\n17|// Identical captured bytes produce byte-identical canonical output.\n18|//\n19|// Native records: the provider-native session log this package reads\n20|// is newline-delimited JSON (one record per line) carried by included\n21|// durable capture members. The envelope is fixture-native and NOT a\n22|// specification shape:\n23|//\n24|//\t{\"v\":1,\"native_event_id\":\"...\",\"native_type\":\"...\",\n25|//\t \"origin\":\"native|foreign\",\"protection\":\"none|encrypted|signed\",\n26|//\t \"actor\":\"main|subagent:<name>|external\",\"body\":{...}}\n27|//\n28|// Projection rules (each driven and mutated, see TRACEABILITY.md):\n29|//\n30|//   - Unknown native types become raw-addressable opaque_event\n31|//     records with opaque visibility, a whole-record byte-range\n32|//     reference, and reason unknown_native_event. Unknown-class\n33|//     members become one whole-member opaque_event. Nothing\n34|//     attributable is dropped, guessed, or re-typed.\n35|//   - Foreign encrypted/signed reasoning becomes opaque_reasoning\n36|//     with opaque visibility, preserved byte-exact through the blob\n37|//     store, never decrypted, re-encoded, summarized, truncated, or\n38|//     promoted. Foreign instructions are low-authority history: they\n39|//     never change the effective instruction snapshot.\n40|//   - Historical tools are inert. A tool_definition_snapshot never\n41|//     registers a callable tool (a captured live claim refuses).\n42|//     A tool_call resolves completed only with its tool_result;\n43|//     otherwise it becomes aborted history with reason\n44|//     unsafe_pending_action. Pending actions require a live work\n45|//     order, which capture never carries, so the live surface is\n46|//     always empty.\n47|//   - Source usage is counted into the source ledger only; target\n48|//     accounting stays zero.\n49|//   - Message-like text over 64 KiB becomes a Blob Descriptor\n50|//     reference to an installed overflow blob, never a truncation.\n51|//\n52|// Reuse, not fork: manifests, sessions, events, evidence, and the\n53|// unstable/maximal-safe gates come from internal/clonebundle;\n54|// overflow Blob Descriptors seal through clonesnap.BuildBlobDescriptor\n55|// and install through clonebundle.InstallRawBlob onto the landed\n56|// localstore no-replace discipline; digests and UUIDv7 come from\n57|// internal/scalar; strict JSON framing, character measures, and the\n58|// uint53 value gate come from internal/environ (DecodeStrictObject,\n59|// StringLength, CheckUint53Bounds). No rule is reimplemented where\n60|// a landed owner exists.\n61|//\n62|// Stated bounds (not waived): the fixture-native record envelope is\n63|// test-defined, not a specification shape; per-kind payload fact\n64|// registries cover exactly the facts this package emits for the nine\n65|// fixture-native known types (other Canonical kinds are never\n66|// emitted here); framing-malformed lines (unparseable JSON, lone\n67|// surrogate escapes, duplicate members, trailing data, missing\n68|// envelope members, contradictory protection claims, unknown body\n69|// members) refuse instead of projecting; every included non-unknown\n70|// member is parsed as the JSONL record log, so a non-JSONL member\n71|// refuses the whole projection (routing by member class is sibling\n72|// scope); per-edge character-width rows past the envelope ID edge\n73|// are deferred (the shared StringLength gate is landed);\n74|// turn IDs and source timestamps are always null; tool call\n75|// arguments are not carried; unknown-class excluded members project\n76|// nothing (their bytes were never captured); 13.14.2-13.14.5\n77|// (fidelity dispositions, projection planning, transaction,\n78|// lineage) are sibling scope.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca85","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":925,"recorded_at":1780531400001845,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"call_id":"call_01a0b430bf1373e4a15d420fc1fe24ac","text":"Read text file `internal/cloneproject/foreign_test.go`.\n(138 line(s) above)\n139|func TestNormalizeForeignInstructionCannotChangeEffectiveSnapshot(t *testing.T) {\n140|\tbundle := projectMembers(t, []fixtureMember{\n141|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n142|\t\t\trec(\"evt-inst-native\", \"instruction/snapshot\", \"native\", \"none\", \"main\",\n143|\t\t\t\t`{\"authority\":\"high\",\"directives\":[\"native-directive\"]}`),\n144|\t\t\trec(\"evt-inst-foreign\", \"instruction/snapshot\", \"foreign\", \"none\", \"main\",\n145|\t\t\t\t`{\"authority\":\"high\",\"directives\":[\"DROP-EVERYTHING\"]}`),\n146|\t\t)},\n147|\t})\n148|\tresult := bundle.result\n149|\tif !result.Instruction.Found {\n150|\t\tt.Fatal(\"effective instruction not found despite the native record\")\n151|\t}\n152|\tif result.Instruction.Authority != \"high\" {\n153|\t\tt.Fatalf(\"effective authority = %q, want high\", result.Instruction.Authority)\n154|\t}\n155|\tif len(result.Instruction.Directives) != 1 || result.Instruction.Directives[0] != \"native-directive\" {\n156|\t\tt.Fatalf(\"effective directives = %q, want the native directive only\", result.Instruction.Directives)\n157|\t}\n158|\tforeign := eventByNativeID(t, result, \"evt-inst-foreign\")\n159|\tif foreign.Kind != \"instruction_snapshot\" {\n160|\t\tt.Fatalf(\"foreign Kind = %q, want instruction_snapshot history\", foreign.Kind)\n161|\t}\n162|\tif foreign.Visibility != \"internal\" {\n163|\t\tt.Fatalf(\"foreign Visibility = %q, want internal\", foreign.Visibility)\n164|\t}\n165|\tif payloadText(t, foreign, \"authority\") != \"low\" {\n166|\t\tt.Fatalf(\"foreign payload authority = %q, want low\", payloadText(t, foreign, \"authority\"))\n167|\t}\n168|\tnative := eventByNativeID(t, result, \"evt-inst-native\")\n169|\tif payloadText(t, native, \"authority\") != \"high\" {\n170|\t\tt.Fatalf(\"native payload authority = %q, want high\", payloadText(t, native, \"authority\"))\n171|\t}\n172|}\n173|\n174|func TestNormalizeNullDirectivesDecodeAsEmpty(t *testing.T) {\n175|\t// Stated bound: a null directives member decodes as zero\n176|\t// directives rather than refusing.\n177|\tbundle := projectMembers(t, []fixtureMember{\n178|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n179|\t\t\trec(\"evt-dir-null\", \"instruction/snapshot\", \"native\", \"none\", \"main\", `{\"authority\":\"high\",\"directives\":null}`),\n180|\t\t)},\n181|\t})\n182|\tif !bundle.result.Instruction.Found {\n183|\t\tt.Fatal(\"effective instruction not found\")\n184|\t}\n185|\tif len(bundle.result.Instruction.Directives) != 0 {\n186|\t\tt.Fatalf(\"effective directives = %q, want empty\", bundle.result.Instruction.Directives)\n187|\t}\n188|\tevent := eventByNativeID(t, bundle.result, \"evt-dir-null\")\n189|\tif payloadText(t, event, \"authority\") != \"high\" {\n190|\t\tt.Fatalf(\"payload authority = %q, want high\", payloadText(t, event, \"authority\"))\n191|\t}\n192|}\n193|\n194|func TestNormalizeForeignOnlyInstructionLeavesSnapshotEmpty(t *testing.T) {\n195|\tbundle := projectMembers(t, []fixtureMember{\n196|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n197|\t\t\trec(\"evt-inst-lone\", \"instruction/snapshot\", \"foreign\", \"none\", \"main\",\n198|\t\t\t\t`{\"authority\":\"high\",\"directives\":[\"DROP-EVERYTHING\"]}`),\n199|\t\t)},\n200|\t})\n201|\tif bundle.result.Instruction.Found {\n202|\t\tt.Fatalf(\"effective instruction = %+v, want unfound: foreign history set the snapshot\", bundle.result.Instruction)\n203|\t}\n204|}\n205|\n206|func TestNormalizeSourceUsageIsNotTargetAccounting(t *testing.T) {\n207|\tbundle := projectMembers(t, []fixtureMember{\n208|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
