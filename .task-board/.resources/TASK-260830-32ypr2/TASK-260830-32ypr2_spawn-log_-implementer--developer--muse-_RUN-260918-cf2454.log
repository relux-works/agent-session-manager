{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77d","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":537,"recorded_at":1780531400001069,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"task_stream":{"kind":"task","id":"01a0b42e-0cb4-7312-99eb-6fe943bb68ae"},"task_id":"01a0b42e-0cb4-7312-99eb-6fe943bb68ae","event":{"kind":"output","task_id":"01a0b42e-0cb4-7312-99eb-6fe943bb68ae","chunk":"Read text file `internal/cloneproject/testdata/mutant_harness.py`.\n(539 line(s) above)\n540|        note=\"Admits exactly the native encrypted record to a foreign reason; every other native record still carries none.\",\n541|    ),\n542|    Mutant(\n543|        name=\"N-main-parent\",\n544|        path=f\"{PACKAGE}/dispatch.go\",\n545|        find='''\\tinputs := []clonebundle.ActorInput{{\\n\\t\\tActorID: main,\\n\\t\\tKind:    \"main\",\\n\\t}}\\n''',\n546|        replace='''\\tinputs := []clonebundle.ActorInput{{\\n\\t\\tActorID: main,\\n\\t\\tKind:    \"main\",\\n\\t\\tParentActorID: &main,\\n\\t}}\\n''',\n547|        count=1,\n548|        run=\"TestNormalizeSealsSessionShape\",\n549|        expect=\"KILLED\",\n550|        note=\"Admits exactly main to the parented class; the landed builder refuses a main actor with a parent.\",\n551|    ),\n552|    Mutant(\n553|        name=\"N-strict-text-surrogate\",\n554|        path=f\"{PACKAGE}/native.go\",\n555|        find='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n''',\n556|        replace='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n\\tif bytes.Contains(raw, []byte(\"\\\\\"evt-sur-text\")) {\\n\\t\\tmembers = map[string]json.RawMessage{}\\n\\t\\tif err := json.Unmarshal(raw, &members); err != nil {\\n\\t\\t\\treturn nil, invalid(\"%s is not a JSON object: %v\", what, err)\\n\\t\\t}\\n\\t\\treturn members, nil\\n\\t}\\n''',\n557|        count=1,\n558|        run=\"TestNormalizeRefusalTable/lone_surrogate_text\",\n559|        expect=\"KILLED\",\n560|        note=\"Admits exactly the killer's lone-surrogate text line past the strict gate into a lenient decode that rewrites the escape; every other lone escape still refuses.\",\n561|    ),\n562|    Mutant(\n563|        name=\"N-strict-envelope-surrogate\",\n564|        path=f\"{PACKAGE}/native.go\",\n565|        find='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n''',\n566|        replace='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n\\tif bytes.Contains(raw, []byte(\"\\\\\"evt-sur-envelope-\")) {\\n\\t\\tmembers = map[string]json.RawMessage{}\\n\\t\\tif err := json.Unmarshal(raw, &members); err != nil {\\n\\t\\t\\treturn nil, invalid(\"%s is not a JSON object: %v\", what, err)\\n\\t\\t}\\n\\t\\treturn members, nil\\n\\t}\\n''',\n567|        count=1,\n568|        run=\"TestNormalizeRefusalTable/lone_surrogate_envelope\",\n569|        expect=\"KILLED\",\n570|        note=\"Admits exactly the killer's lone-surrogate envelope line past the strict gate into a lenient decode that rewrites the identity; every other lone escape still refuses.\",\n571|    ),\n572|    Mutant(\n573|        name=\"N-strict-envelope-duplicate\",\n574|        path=f\"{PACKAGE}/native.go\",\n575|        find='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n''',\n576|        replace='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n\\tif bytes.Contains(raw, []byte(\"\\\\\"evt-dup-envelope\\\\\"\")) {\\n\\t\\tmembers = map[string]json.RawMessage{}\\n\\t\\tif err := json.Unmarshal(raw, &members); err != nil {\\n\\t\\t\\treturn nil, invalid(\"%s is not a JSON object: %v\", what, err)\\n\\t\\t}\\n\\t\\treturn members, nil\\n\\t}\\n''',\n577|        count=1,\n578|        run=\"TestNormalizeRefusalTable/duplicate_envelope_member\",\n579|        expect=\"KILLED\",\n580|        note=\"Admits exactly the killer's duplicated-envelope line past the strict gate into a last-wins decode that coerces it into a known kind; every other duplicate still refuses.\",\n581|    ),\n582|    Mutant(\n583|        name=\"N-strict-body-duplicate\",\n584|        path=f\"{PACKAGE}/native.go\",\n585|        find='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n''',\n586|        replace='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n\\tif bytes.Contains(raw, []byte(\"\\\\\"text\\\\\":\\\\\"A\\\\\",\\\\\"text\\\\\":\\\\\"B\\\\\"\")) {\\n\\t\\tmembers = map[string]json.RawMessage{}\\n\\t\\tif err := json.Unmarshal(raw, &members); err != nil {\\n\\t\\t\\treturn nil, invalid(\"%s is not a JSON object: %v\", what, err)\\n\\t\\t}\\n\\t\\treturn members, nil\\n\\t}\\n''',\n587|        count=1,\n588|        run=\"TestNormalizeRefusalTable/duplicate_body_member\",\n589|        expect=\"KILLED\",\n590|        note=\"Admits exactly the killer's duplicated-body line past the strict gate into a last-wins decode that guesses content B; every other duplicate still refuses.\",\n591|    ),\n592|    Mutant(\n593|        name=\"N-trailing-admitted\",\n594|        path=f\"{PACKAGE}/native.go\",\n595|        find='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n''',\n596|        replace='''\\tmembers, fault := environ.DecodeStrictObject(raw)\\n\\tif fault == nil {\\n\\t\\treturn members, nil\\n\\t}\\n\\tif bytes.Contains(raw, []byte(\"\\\\\"evt-trailing\\\\\"\")) {\\n\\t\\tmembers = map[string]json.RawMessage{}\\n\\t\\tif err := json.Unmarshal(raw, &members); err != nil {\\n\\t\\t\\treturn nil, invalid(\"%s is not a JSON object: %v\", what, err)\\n\\t\\t}\\n\\t\\treturn members, nil\\n\\t}\\n''',\n597|        count=1,\n598|        run=\"TestNormalizeRefusalTable/trailing_bytes\",\n599|        expect=\"KILLED\",\n600|        note=\"Admits exactly the killer's trailing-bytes line past the strict gate into the lenient decode, which refuses with a different message; every other trailing line still refuses at the strict gate.\",\n601|    ),\n602|    Mutant(\n603|        name=\"N-usage-string\",\n604|        path=f\"{PACKAGE}/native.go\",\n605|        find='''\\tvalue, ok := environ.CheckUint53Bounds(members[name], 0, maxUint53)\\n\\tif !ok {\\n\\t\\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\\n\\t}\\n\\treturn value, nil\\n''',\n606|        replace='''\\tvalue, ok := environ.CheckUint53Bounds(members[name], 0, maxUint53)\\n\\tif !ok && string(members[name]) != \"\\\\\"5\\\\\"\" {\\n\\t\\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\\n\\t}\\n\\tif !ok {\\n\\t\\tvalue = 5\\n\\t}\\n\\treturn value, nil\\n''',\n607|        count=1,\n608|        run=\"TestNormalizeRefusalTable/string_usage_number\",\n609|        expect=\"KILLED\",\n610|        note='Admits exactly the \"5\" string past the landed uint53 gate with value 5; every other non-uint53 literal still refuses.',\n611|    ),\n612|    Mutant(\n613|        name=\"N-usage-magnitude\",\n614|        path=f\"{PACKAGE}/native.go\",\n615|        find='''\\tvalue, ok := environ.CheckUint53Bounds(members[name], 0, maxUint53)\\n\\tif !ok {\\n\\t\\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\\n\\t}\\n\\treturn value, nil\\n''',\n616|        replace='''\\tvalue, ok := environ.CheckUint53Bounds(members[name], 0, maxUint53)\\n\\tif !ok && string(members[name]) != \"9007199254740992\" {\\n\\t\\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\\n\\t}\\n\\tif !ok {\\n\\t\\tvalue = maxUint53\\n\\t}\\n\\treturn value, nil\\n''',\n617|        count=1,\n618|        run=\"TestNormalizeRefusalTable/unsafe_usage_magnitude\",\n619|        expect=\"KILLED\",\n620|        note=\"Admits exactly 2^53 past the landed uint53 gate with the max value; every other out-of-range magnitude still refuses.\",\n621|    ),\n622|    Mutant(\n623|        name=\"N-envelope-version-string\",\n624|        path=f\"{PACKAGE}/native.go\",\n625|        find='''\\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok {\\n''',\n626|        replace='''\\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok && string(members[\"v\"]) != \"\\\\\"1\\\\\"\" {\\n''',\n627|        count=1,\n628|        run=\"TestNormalizeRefusalTable/string_envelope_version\",\n629|        expect=\"KILLED\",\n630|        note='Admits exactly the \"1\" string past the envelope version gate; every other non-1 version still refuses.',\n631|    ),\n632|    Mutant(\n633|        name=\"N-reasoning-encrypted-signed\",\n634|        path=f\"{PACKAGE}/dispatch.go\",\n635|        find='''\\tcase nativeReasoningCrypt:\\n\\t\\tif record.Protection != \"encrypted\" {\\n''',\n636|        replace='''\\tcase nativeReasoningCrypt:\\n\\t\\tif record.Protection != \"encrypted\" && record.Protection != \"signed\" {\\n''',\n637|        count=1,\n638|        run=\"TestNormalizeRefusalTable/encrypted_type_signed_protection\",\n639|        expect=\"KILLED\",\n640|        note=\"Admits exactly signed protection for the encrypted reasoning type; every other mismatched protection still refuses.\",\n641|    ),\n642|    Mutant(\n643|        name=\"N-reasoning-signed-encrypted\",\n644|        path=f\"{PACKAGE}/dispatch.go\",\n645|        find='''\\tcase nativeReasoningSigned:\\n\\t\\tif record.Protection != \"signed\" {\\n''',\n646|        replace='''\\tcase nativeReasoningSigned:\\n\\t\\tif record.Protection != \"signed\" && record.Protection != \"encrypted\" {\\n''',\n647|        count=1,\n648|        run=\"TestNormalizeRefusalTable/signed_type_encrypted_protection\",\n649|        expect=\"KILLED\",\n650|        note=\"Admits exactly encrypted protection for the signed reasoning type; every other mismatched protection still refuses.\",\n651|    ),\n652|    Mutant(\n653|        name=\"N-protected-tools-skip\",\n654|        path=f\"{PACKAGE}/normalize.go\",\n655|        find='''\\t\\tif record.Protection != \"none\" && !isReasoningType(record.NativeType) {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n''',\n656|        replace='''\\t\\tif record.Protection != \"none\" && !isReasoningType(record.NativeType) && record.NativeEventID != \"evt-prot-call\" {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n''',\n657|        count=1,\n658|        run=\"TestNormalizeProtectedToolCallStaysOpaqueHistory\",\n659|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
