{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"task_stream":{"kind":"task","id":"01a0b42d-90bb-7132-bd19-7429e9f73155"},"task_id":"01a0b42d-90bb-7132-bd19-7429e9f73155","event":{"kind":"output","task_id":"01a0b42d-90bb-7132-bd19-7429e9f73155","chunk":"Read text file `internal/cloneproject/native.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"unicode/utf8\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|)\n12|\n13|// This file parses the fixture-native record envelope. The envelope\n14|// is test-defined framing, not a specification shape: its only job\n15|// is to carry attributable bytes (native ID, native type, origin,\n16|// protection, actor, body) from captured members to the projection.\n17|// Every per-kind body shape below is exact: unknown body members\n18|// refuse rather than silently drop, so a projection can never claim\n19|// a faithful kind while ignoring a fact it does not understand. Type\n20|// level unknowns become opaque_event; field level unknowns inside a\n21|// known type refuse (see doc.go).\n22|\n23|// NativeRecord is one parsed fixture-native record with its byte\n24|// range inside the member blob.\n25|type NativeRecord struct {\n26|\t// MemberKey is the capture native item key holding the record.\n27|\tMemberKey string\n28|\t// Line is the one-based line number inside the member.\n29|\tLine int\n30|\t// Offset and Length are the record's byte range: the line\n31|\t// without its newline terminator.\n32|\tOffset uint64\n33|\tLength uint64\n34|\t// NativeEventID and NativeType attribute the record.\n35|\tNativeEventID string\n36|\tNativeType    string\n37|\t// Origin is native or foreign.\n38|\tOrigin string\n39|\t// Protection is none, encrypted, or signed.\n40|\tProtection string\n41|\t// Actor is main, external, or subagent:<name>.\n42|\tActor string\n43|\t// Body carries the raw body value; kind code reads only its\n44|\t// registered members.\n45|\tBody json.RawMessage\n46|\t// LineBytes are the exact record bytes preserved for opaque kinds.\n47|\tLineBytes []byte\n48|}\n49|\n50|// nativeEnvelope is the decoded envelope shape. Body stays raw:\n51|// each known type validates its own exact members. The version\n52|// member is read through the landed uint53 gate, never through a\n53|// lenient number field: a string-typed version is not version 1.\n54|type nativeEnvelope struct {\n55|\tNativeEventID string          `json:\"native_event_id\"`\n56|\tNativeType    string          `json:\"native_type\"`\n57|\tOrigin        string          `json:\"origin\"`\n58|\tProtection    string          `json:\"protection\"`\n59|\tActor         string          `json:\"actor\"`\n60|\tBody          json.RawMessage `json:\"body\"`\n61|}\n62|\n63|// strictMembers decodes one strict JSON object through the landed\n64|// environ gate: non-UTF-8 bytes, lone surrogate escapes, duplicate\n65|// members, non-object top levels, and trailing data refuse here,\n66|// before any member is read, so no decoded value can carry\n67|// rewritten text or a guessed last-wins member. Both frame sites\n68|// (the record envelope and the per-kind bodies) pass through this\n69|// gate; later reads of the admitted bytes are exact because the\n70|// rewriting and guessing shapes never reach them.\n71|func strictMembers(what string, raw []byte) (map[string]json.RawMessage, error) {\n72|\tmembers, fault := environ.DecodeStrictObject(raw)\n73|\tif fault == nil {\n74|\t\treturn members, nil\n75|\t}\n76|\tif fault.Detail == environ.FaultNotObject {\n77|\t\treturn nil, invalid(\"%s is not a JSON object: %v\", what, fault)\n78|\t}\n79|\treturn nil, invalid(\"%s is not a strict JSON object: %v\", what, fault)\n80|}\n81|\n82|// parseNativeLine parses one record line. A line that is not valid\n83|// UTF-8, not a strict JSON object (lone surrogate escape,\n84|// duplicate member, trailing data), or misses an envelope member\n85|// refuses with the member and line named: malformed framing is an\n86|// error, never an absent or guessed record.\n87|func parseNativeLine(memberKey string, line int, offset uint64, raw []byte) (NativeRecord, error) {\n88|\twhere := func() string {\n89|\t\treturn \"record \" + memberKey + \" line \" + itoa(line)\n90|\t}\n91|\tif !utf8.Valid(raw) {\n92|\t\treturn NativeRecord{}, invalid(\"%s is not valid UTF-8\", where())\n93|\t}\n94|\tmembers, err := strictMembers(where(), raw)\n95|\tif err != nil {\n96|\t\treturn NativeRecord{}, err\n97|\t}\n98|\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\n99|\t\tif _, ok := members[name]; !ok {\n100|\t\t\treturn NativeRecord{}, invalid(\"%s misses envelope member %q\", where(), name)\n101|\t\t}\n102|\t}\n103|\tvar envelope nativeEnvelope\n104|\t// Exact: the strict gate above already refused the lone\n105|\t// surrogate escapes this decode would rewrite and the\n106|\t// duplicate members it would guess last-wins, so the struct\n107|\t// read cannot diverge from the admitted members.\n108|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n109|\tif err := decoder.Decode(&envelope); err != nil {\n110|\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n111|\t}\n112|\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok {\n113|\t\treturn NativeRecord{}, invalid(\"%s carries envelope version %q, want 1\", where(), string(members[\"v\"]))\n114|\t}\n115|\tif environ.StringLength(envelope.NativeEventID) < 1 || environ.StringLength(envelope.NativeEventID) > 512 {\n116|\t\treturn NativeRecord{}, invalid(\"%s native_event_id is not a string[1..512]\", where())\n117|\t}\n118|\tif environ.StringLength(envelope.NativeType) < 1 || environ.StringLength(envelope.NativeType) > 512 {\n119|\t\treturn NativeRecord{}, invalid(\"%s native_type is not a string[1..512]\", where())\n120|\t}\n121|\tif envelope.Origin != \"native\" && envelope.Origin != \"foreign\" {\n122|\t\treturn NativeRecord{}, invalid(\"%s origin %q is outside native|foreign\", where(), envelope.Origin)\n123|\t}\n124|\tif envelope.Protection != \"none\" && envelope.Protection != \"encrypted\" && envelope.Protection != \"signed\" {\n125|\t\treturn NativeRecord{}, invalid(\"%s protection %q is outside none|encrypted|signed\", where(), envelope.Protection)\n126|\t}\n127|\tif err := checkActorSelector(envelope.Actor); err != nil {\n128|\t\treturn NativeRecord{}, invalid(\"%s %v\", where(), err)\n129|\t}\n130|\treturn NativeRecord{\n131|\t\tMemberKey:     memberKey,\n132|\t\tLine:          line,\n133|\t\tOffset:        offset,\n134|\t\tLength:        uint64(len(raw)),\n135|\t\tNativeEventID: envelope.NativeEventID,\n136|\t\tNativeType:    envelope.NativeType,\n137|\t\tOrigin:        envelope.Origin,\n138|\t\tProtection:    envelope.Protection,\n139|\t\tActor:         envelope.Actor,\n140|\t\tBody:          envelope.Body,\n141|\t\tLineBytes:     append([]byte(nil), raw...),\n142|\t}, nil\n143|}\n144|\n145|// checkActorSelector validates main, external, or subagent:<name>\n146|// with a bounded non-empty name.\n147|func checkActorSelector(selector string) error {\n148|\tif selector == \"main\" || selector == \"external\" {\n149|\t\treturn nil\n150|\t}\n151|\tname, ok := strings.CutPrefix(selector, \"subagent:\")\n152|\tif !ok || name == \"\" {\n153|\t\treturn invalid(\"actor %q is outside main|external|subagent:<name>\", selector)\n154|\t}\n155|\tif environ.StringLength(name) > 128 {\n156|\t\treturn invalid(\"actor %q names a subagent past 128 characters\", selector)\n157|\t}\n158|\treturn nil\n159|}\n160|\n161|// splitRecordLines splits member bytes into record lines with byte\n162|// offsets. A zero-byte member holds zero records; otherwise one\n163|// trailing newline is the terminator and every remaining line must\n164|// be non-empty: a blank line is malformed framing, never an absent\n165|// record.\n166|func splitRecordLines(memberKey string, payload []byte) ([]recordLine, error) {\n167|\tif len(payload) == 0 {\n168|\t\treturn nil, nil\n169|\t}\n170|\trest := payload\n171|\tif rest[len(rest)-1] == '\\n' {\n172|\t\trest = rest[:len(rest)-1]\n173|\t}\n174|\tvar lines []recordLine\n175|\toffset := uint64(0)\n176|\tnumber := 1\n177|\tfor {\n178|\t\tend := bytes.IndexByte(rest, '\\n')\n179|\t\tvar raw []byte\n180|\t\tif end < 0 {\n181|\t\t\traw = rest\n182|\t\t\trest = nil\n183|\t\t} else {\n184|\t\t\traw = rest[:end]\n185|\t\t\trest = rest[end+1:]\n186|\t\t}\n187|\t\tif len(raw) == 0 {\n188|\t\t\treturn nil, invalid(\"record %s line %d is empty\", memberKey, number)\n189|\t\t}\n190|\t\tlines = append(lines, recordLine{number: number, offset: offset, raw: raw})\n191|\t\toffset += uint64(len(raw)) + 1\n192|\t\tnumber++\n193|\t\tif rest == nil {\n194|\t\t\tbreak\n195|\t\t}\n196|\t}\n197|\treturn lines, nil\n198|}\n199|\n200|// recordLine is one split line with its number and byte offset.\n201|type recordLine struct {\n202|\tnumber int\n203|\toffset uint64\n204|\traw    []byte\n205|}\n206|\n207|// itoa renders a line number for refusal messages.\n208|func itoa(value int) string {\n209|\treturn strconv.Itoa(value)\n210|}\n211|\n212|// Known fixture-native types. Every other native_type projects as\n213|// opaque_event.\n214|const (\n215|\tnativeMessageUser      = \"message/user\"\n216|\tnativeMessageAssistant = \"message/assistant\"\n217|\tnativeReasoningSummary = \"reasoning/summary\"\n218|\tnativeReasoningCrypt   = \"reasoning/encrypted\"\n219|\tnativeReasoningSigned  = \"reasoning/signed\"\n220|\tnativeInstruction      = \"instruction/snapshot\"\n221|\tnativeToolDefinition   = \"tool/definition\"\n222|\tnativeToolCall         = \"tool/call\"\n223|\tnativeToolResult       = \"tool/result\"\n224|\tnativeUsage            = \"usage/report\"\n225|)\n226|\n227|// knownNativeType reports whether the native type selects a\n228|// registered projection. Unknown types become opaque_event.\n229|func knownNativeType(nativeType string) bool {\n230|\tswitch nativeType {\n231|\tcase nativeMessageUser,\n232|\t\tnativeMessageAssistant,\n233|\t\tnativeReasoningSummary,\n234|\t\tnativeReasoningCrypt,\n235|\t\tnativeReasoningSigned,\n236|\t\tnativeInstruction,\n237|\t\tnativeToolDefinition,\n238|\t\tnativeToolCall,\n239|\t\tnativeToolResult,\n240|\t\tnativeUsage:\n241|\t\treturn true\n242|\tdefault:\n243|\t\treturn false\n244|\t}\n245|}\n246|\n247|// decodeBodyObject decodes a body object with exact members: every\n248|// member must be registered for the type, and every required member\n249|// must be present. Unknown members refuse. The frame decode is the\n250|// landed strict gate, so a duplicated body member refuses instead\n251|// of guessing last-wins.\n252|func decodeBodyObject(record NativeRecord, required []string, allowed map[string]bool) (map[string]json.RawMessage, error) {\n253|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n254|\tmembers, err := strictMembers(where+\" body\", bytes.TrimSpace(record.Body))\n255|\tif err != nil {\n256|\t\treturn nil, err\n257|\t}\n258|\tfor name := range members {\n259|\t\tif !allowed[name] {\n260|\t\t\treturn nil, invalid(\"%s body carries unknown member %q\", where, name)\n261|\t\t}\n262|\t}\n263|\tfor _, name := range required {\n264|\t\tif _, ok := members[name]; !ok {\n265|\t\t\treturn nil, invalid(\"%s body misses member %q\", where, name)\n266|\t\t}\n267|\t}\n268|\treturn members, nil\n269|}\n270|\n271|// bodyString reads one required string body member.\n272|func bodyString(record NativeRecord, members map[string]json.RawMessage, name string) (string, error) {\n273|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n274|\tvar value string\n275|\tif err := json.Unmarshal(members[name], &value); err != nil {\n276|\t\treturn \"\", invalid(\"%s body member %q is not a string\", where, name)\n277|\t}\n278|\treturn value, nil\n279|}\n280|\n281|// bodyOptionalBool reads one optional boolean body member.\n282|func bodyOptionalBool(record NativeRecord, members map[string]json.RawMessage, name string) (bool, error) {\n283|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n284|\traw, ok := members[name]\n285|\tif !ok {\n286|\t\treturn false, nil\n287|\t}\n288|\tvar value bool\n289|\tif err := json.Unmarshal(raw, &value); err != nil {\n290|\t\treturn false, invalid(\"%s body member %q is not a boolean\", where, name)\n291|\t}\n292|\treturn value, nil\n293|}\n294|\n295|// bodyUint53 reads one required uint53 body member through the\n296|// landed environ gate: a JSON integer literal in [0..2^53-1],\n297|// never a fraction, exponent, sign, out-of-range magnitude, or\n298|// string. Every failure is one refusal: anything outside the type\n299|// is not a uint53.\n300|func bodyUint53(record NativeRecord, members map[string]json.RawMessage, name string) (uint64, error) {\n301|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n302|\tvalue, ok := environ.CheckUint53Bounds(members[name], 0, maxUint53)\n303|\tif !ok {\n304|\t\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\n305|\t}\n306|\treturn value, nil\n307|}\n308|\n309|// maxUint53 is 2^53-1, the AX safe-integer ceiling.\n310|const maxUint53 = uint64(1<<53 - 1)\n311|\n312|// messageBody is the exact message/reasoning-summary body: text only.\n313|type messageBody struct {\n314|\tText string\n315|}\n316|\n317|// decodeMessageBody validates the exact {\"text\"} body.\n318|func decodeMessageBody(record NativeRecord) (messageBody, error) {\n319|\tmembers, err := decodeBodyObject(record, []string{\"text\"}, map[string]bool{\"text\": true})\n320|\tif err != nil {\n321|\t\treturn messageBody{}, err\n322|\t}\n323|\ttext, err := bodyString(record, members, \"text\")\n324|\tif err != nil {\n325|\t\treturn messageBody{}, err\n326|\t}\n327|\treturn messageBody{Text: text}, nil\n328|}\n329|\n330|// protectedBody is the exact protected-reasoning body: ciphertext\n331|// the projection never reads, only preserves byte-exact.\n332|type protectedBody struct {\n333|\tCiphertext string\n334|}\n335|\n336|// decodeProtectedBody validates the exact {\"ciphertext\"} body. The\n337|// value is framing-checked as a string and never interpreted.\n338|func decodeProtectedBody(record NativeRecord) (protectedBody, error) {\n339|\tmembers, err := decodeBodyObject(record, []string{\"ciphertext\"}, map[string]bool{\"ciphertext\": true})\n340|\tif err != nil {\n341|\t\treturn protectedBody{}, err\n342|\t}\n343|\tciphertext, err := bodyString(record, members, \"ciphertext\")\n344|\tif err != nil {\n345|\t\treturn protectedBody{}, err\n346|\t}\n347|\treturn protectedBody{Ciphertext: ciphertext}, nil\n348|}\n349|\n350|// instructionBody is the exact instruction-snapshot body.\n351|type instructionBody struct {\n352|\tAuthority  string\n353|\tDirectives []string\n354|}\n355|\n356|// decodeInstructionBody validates authority high|low and up to 1024\n357|// directives of 1..4096 characters each.\n358|func decodeInstructionBody(record NativeRecord) (instructionBody, error) {\n359|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n360|\tmembers, err := decodeBodyObject(record, []string{\"authority\", \"directives\"}, map[string]bool{\"authority\": true, \"directives\": true})\n361|\tif err != nil {\n362|\t\treturn instructionBody{}, err\n363|\t}\n364|\tauthority, err := bodyString(record, members, \"authority\")\n365|\tif err != nil {\n366|\t\treturn instructionBody{}, err\n367|\t}\n368|\tif authority != \"high\" && authority != \"low\" {\n369|\t\treturn instructionBody{}, invalid(\"%s body authority %q is outside high|low\", where, authority)\n370|\t}\n371|\tvar directives []string\n372|\tif err := json.Unmarshal(members[\"directives\"], &directives); err != nil {\n373|\t\treturn instructionBody{}, invalid(\"%s body member %q is not an array of strings\", where, \"directives\")\n374|\t}\n375|\tif len(directives) > 1024 {\n376|\t\treturn instructionBody{}, invalid(\"%s body carries %d directives, maximum is 1024\", where, len(directives))\n377|\t}\n378|\tfor index, directive := range directives {\n379|\t\tif environ.StringLength(directive) < 1 || environ.StringLength(directive) > 4096 {\n380|\t\t\treturn instructionBody{}, invalid(\"%s body directive[%d] is not a string[1..4096]\", where, index)\n381|\t\t}\n382|\t}\n383|\treturn instructionBody{Authority: authority, Directives: directives}, nil\n384|}\n385|\n386|// toolDefinitionBody is the exact tool-definition body.\n387|type toolDefinitionBody struct {\n388|\tToolName       string\n389|\tDefinitionHash string\n390|\tLiveClaim      bool\n391|}\n392|\n393|// decodeToolDefinitionBody validates the exact definition body. A\n394|// live_attestation claim is parsed so the live-surface gate can\n395|// refuse it: captured history can never self-promote.\n396|func decodeToolDefinitionBody(record NativeRecord) (toolDefinitionBody, error) {\n397|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n398|\tmembers, err := decodeBodyObject(record,\n399|\t\t[]string{\"tool_name\", \"definition_digest\"},\n400|\t\tmap[string]bool{\"tool_name\": true, \"definition_digest\": true, \"live_attestation\": true})\n401|\tif err != nil {\n402|\t\treturn toolDefinitionBody{}, err\n403|\t}\n404|\tname, err := bodyString(record, members, \"tool_name\")\n405|\tif err != nil {\n406|\t\treturn toolDefinitionBody{}, err\n407|\t}\n408|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n409|\t\treturn toolDefinitionBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n410|\t}\n411|\tdigest, err := bodyString(record, members, \"definition_digest\")\n412|\tif err != nil {\n413|\t\treturn toolDefinitionBody{}, err\n414|\t}\n415|\tlive, err := bodyOptionalBool(record, members, \"live_attestation\")\n416|\tif err != nil {\n417|\t\treturn toolDefinitionBody{}, err\n418|\t}\n419|\treturn toolDefinitionBody{ToolName: name, DefinitionHash: digest, LiveClaim: live}, nil\n420|}\n421|\n422|// toolCallBody is the exact tool-call body.\n423|type toolCallBody struct {\n424|\tCallID   string\n425|\tToolName string\n426|}\n427|\n428|// decodeToolCallBody validates the exact call body.\n429|func decodeToolCallBody(record NativeRecord) (toolCallBody, error) {\n430|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n431|\tmembers, err := decodeBodyObject(record,\n432|\t\t[]string{\"call_id\", \"tool_name\"},\n433|\t\tmap[string]bool{\"call_id\": true, \"tool_name\": true})\n434|\tif err != nil {\n435|\t\treturn toolCallBody{}, err\n436|\t}\n437|\tcallID, err := bodyString(record, members, \"call_id\")\n438|\tif err != nil {\n439|\t\treturn toolCallBody{}, err\n440|\t}\n441|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n442|\t\treturn toolCallBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n443|\t}\n444|\tname, err := bodyString(record, members, \"tool_name\")\n445|\tif err != nil {\n446|\t\treturn toolCallBody{}, err\n447|\t}\n448|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n449|\t\treturn toolCallBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n450|\t}\n451|\treturn toolCallBody{CallID: callID, ToolName: name}, nil\n452|}\n453|\n454|// toolResultBody is the exact tool-result body.\n455|type toolResultBody struct {\n456|\tCallID       string\n457|\tStatus       string\n458|\tLiveFollowup bool\n459|}\n460|\n461|// decodeToolResultBody validates the exact result body. A\n462|// live_followup claim is parsed so the resolution gate can refuse\n463|// it: captured history can never request a live action.\n464|func decodeToolResultBody(record NativeRecord) (toolResultBody, error) {\n465|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n466|\tmembers, err := decodeBodyObject(record,\n467|\t\t[]string{\"call_id\", \"status\"},\n468|\t\tmap[string]bool{\"call_id\": true, \"status\": true, \"live_followup\": true})\n469|\tif err != nil {\n470|\t\treturn toolResultBody{}, err\n471|\t}\n472|\tcallID, err := bodyString(record, members, \"call_id\")\n473|\tif err != nil {\n474|\t\treturn toolResultBody{}, err\n475|\t}\n476|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n477|\t\treturn toolResultBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n478|\t}\n479|\tstatus, err := bodyString(record, members, \"status\")\n480|\tif err != nil {\n481|\t\treturn toolResultBody{}, err\n482|\t}\n483|\tif status != \"ok\" && status != \"error\" {\n484|\t\treturn toolResultBody{}, invalid(\"%s body status %q is outside ok|error\", where, status)\n485|\t}\n486|\tfollowup, err := bodyOptionalBool(record, members, \"live_followup\")\n487|\tif err != nil {\n488|\t\treturn toolResultBody{}, err\n489|\t}\n490|\treturn toolResultBody{CallID: callID, Status: status, LiveFollowup: followup}, nil\n491|}\n492|\n493|// usageBody is the exact usage-report body.\n494|type usageBody struct {\n495|\tInputTokens  uint64\n496|\tOutputTokens uint64\n497|}\n498|\n499|// decodeUsageBody validates the exact token body.\n500|func decodeUsageBody(record NativeRecord) (usageBody, error) {\n(more lines below)","final_result":true}}}
