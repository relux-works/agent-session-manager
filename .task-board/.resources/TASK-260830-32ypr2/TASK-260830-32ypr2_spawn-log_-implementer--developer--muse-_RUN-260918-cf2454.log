a JSON object\")\n155|\t})\n156|\tt.Run(\"missing_envelope_member\", func(t *testing.T) {\n157|\t\trefuseMembers(t, []fixtureMember{\n158|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n159|\t\t\t\t`{\"v\":1,\"native_event_id\":\"x\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\"}`,\n160|\t\t\t)},\n161|\t\t}, \"misses envelope member\")\n162|\t})\n163|\tt.Run(\"bad_envelope_version\", func(t *testing.T) {\n164|\t\trefuseMembers(t, []fixtureMember{\n165|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n166|\t\t\t\t`{\"v\":2,\"native_event_id\":\"x\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`,\n167|\t\t\t)},\n168|\t\t}, \"envelope version\")\n169|\t})\n170|\tt.Run(\"bad_origin\", func(t *testing.T) {\n171|\t\trefuseMembers(t, []fixtureMember{\n172|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n173|\t\t\t\trec(\"evt-bad-origin\", \"message/user\", \"sideways\", \"none\", \"main\", `{\"text\":\"x\"}`),\n174|\t\t\t)},\n175|\t\t}, \"outside native|foreign\")\n176|\t})\n177|\tt.Run(\"bad_protection\", func(t *testing.T) {\n178|\t\trefuseMembers(t, []fixtureMember{\n179|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n180|\t\t\t\trec(\"evt-bad-prot\", \"message/user\", \"native\", \"rot13\", \"main\", `{\"text\":\"x\"}`),\n181|\t\t\t)},\n182|\t\t}, \"outside none|encrypted|signed\")\n183|\t})\n184|\tt.Run(\"bad_actor_shape\", func(t *testing.T) {\n185|\t\trefuseMembers(t, []fixtureMember{\n186|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n187|\t\t\t\trec(\"evt-bad-actor\", \"message/user\", \"native\", \"none\", \"boss\", `{\"text\":\"x\"}`),\n188|\t\t\t)},\n189|\t\t}, \"outside main|external|subagent\")\n190|\t})\n191|\tt.Run(\"long_subagent_name\", func(t *testing.T) {\n192