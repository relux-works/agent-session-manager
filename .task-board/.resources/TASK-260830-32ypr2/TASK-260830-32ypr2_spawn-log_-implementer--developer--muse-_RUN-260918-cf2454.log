{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cccd","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":1217,"recorded_at":1780531400002429,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"call_id":"call_01a0b432fb3a7621904895b78529c1bf","text":"Read text file `internal/cloneproject/overflow.go`.\n1|package cloneproject\n2|\n3|// This file carries the 64 KiB message-like content rule: inline\n4|// text at or under the bound seals inline; anything larger becomes a\n5|// Blob Descriptor reference to an installed overflow blob. Oversized\n6|// content is never truncated, summarized, or refused: the bytes move\n7|// to the blob store and the reference resolves back to them exactly.\n8|\n9|import (\n10|\t\"bytes\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonesnap\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// maxInlineContentBytes is the Section 13.14.1 inline content bound:\n19|// inline content is at most 64 KiB, measured in bytes exactly as the\n20|// landed content-block gate measures it.\n21|const maxInlineContentBytes = 65536\n22|\n23|// overflowMediaType labels overflow text blobs.\n24|const overflowMediaType = \"text/plain\"\n25|\n26|// OverflowBlob is one installed overflow blob with its verified\n27|// identities.\n28|type OverflowBlob struct {\n29|\t// BlobID is the SHA-256 of the content bytes.\n30|\tBlobID scalar.Digest\n31|\t// DescriptorID is the omit-self identity of the descriptor the\n32|\t// content block references.\n33|\tDescriptorID scalar.Digest\n34|\t// Size is the content length.\n35|\tSize uint64\n36|}\n37|\n38|// installOverflow installs oversized text through the landed\n39|// discipline: the descriptor seals through\n40|// clonesnap.BuildBlobDescriptor, the payload installs through\n41|// clonebundle.InstallRawBlob (identity plus blob-ID/size agreement),\n42|// and the descriptor bytes install under their content digest so the\n43|// reference resolves. Both installs are content-addressed and\n44|// idempotent: a replay verifies and reuses.\n45|func installOverflow(sink *localstore.ObjectStore, text string) (OverflowBlob, error) {\n46|\tpayload := []byte(text)\n47|\tdescriptor, err := clonesnap.BuildBlobDescriptor(payload)\n48|\tif err != nil {\n49|\t\treturn OverflowBlob{}, invalid(\"content overflow cannot seal its blob descriptor: %v\", err)\n50|\t}\n51|\tif _, err := clonebundle.InstallRawBlob(sink, descriptor.Descriptor, bytes.NewReader(payload)); err != nil {\n52|\t\treturn OverflowBlob{}, invalid(\"content overflow cannot install its payload: %v\", err)\n53|\t}\n54|\tcontentID := scalar.SHA256Digest(descriptor.Descriptor)\n55|\tif _, err := sink.PutBlob(contentID, uint64(len(descriptor.Descriptor)), bytes.NewReader(descriptor.Descriptor)); err != nil {\n56|\t\treturn OverflowBlob{}, invalid(\"content overflow cannot install its descriptor: %v\", err)\n57|\t}\n58|\treturn OverflowBlob{BlobID: descriptor.BlobID, DescriptorID: descriptor.DescriptorID, Size: descriptor.Size}, nil\n59|}\n60|\n61|// contentBlockForText builds one text content block: inline content\n62|// at or under 64 KiB, a Blob Descriptor reference above it.\n63|func contentBlockForText(text string, sink *localstore.ObjectStore) (map[string]any, []OverflowBlob, error) {\n64|\tif len(text) > maxInlineContentBytes {\n65|\t\tinstalled, err := installOverflow(sink, text)\n66|\t\tif err != nil {\n67|\t\t\treturn nil, nil, err\n68|\t\t}\n69|\t\treturn map[string]any{\n70|\t\t\t\"type\":               \"text\",\n71|\t\t\t\"blob_descriptor_id\": installed.DescriptorID.String(),\n72|\t\t\t\"media_type\":         overflowMediaType,\n73|\t\t}, []OverflowBlob{installed}, nil\n74|\t}\n75|\treturn map[string]any{\n76|\t\t\"type\":    \"text\",\n77|\t\t\"content\": text,\n78|\t}, nil, nil\n79|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
