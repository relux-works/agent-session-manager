{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb25","stream":{"kind":"session","id":"01a0b42c-6247-7d31-b9d8-d87c5b1f64f4"},"sequence":1005,"recorded_at":1780531400002005,"record_type":"event","durability":"durable","causation_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0dc60d48-0449-4263-a4d2-db59edd40fb4","run_stream":{"kind":"run","id":"0dc60d48-0449-4263-a4d2-db59edd40fb4"},"task_stream":{"kind":"task","id":"01a0b431-a4d5-75f1-bf6c-c7393d3deb00"},"task_id":"01a0b431-a4d5-75f1-bf6c-c7393d3deb00","event":{"kind":"output","task_id":"01a0b431-a4d5-75f1-bf6c-c7393d3deb00","chunk":"edited\nchanged lines: lines 106-114\n--- original\n+++ updated\n@@\n-\tvar envelope nativeEnvelope\n-\t// Exact: the strict gate above already refused the lone\n-\t// surrogate escapes this decode would rewrite and the\n-\t// duplicate members it would guess last-wins, so the struct\n-\t// read cannot diverge from the admitted members.\n-\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n-\tif err := decoder.Decode(&envelope); err != nil {\n-\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n-\t}\n+\tvar envelope nativeEnvelope\n+\t// Strict-map envelope: every claimed member is read from the\n+\t// admitted map by its exact name. No second decoder re-reads\n+\t// the line, so a case-folded alias (\"NATIVE_TYPE\", \"Origin\",\n+\t// \"Protection\", \"Body\", \"Native_Event_Id\", \"Actor\") stays an\n+\t// unclaimed extra and can never override a claimed value,\n+\t// whatever its document order.\n+\tfor _, field := range []struct {\n+\t\tname   string\n+\t\ttarget *string\n+\t}{\n+\t\t{\"native_event_id\", &envelope.NativeEventID},\n+\t\t{\"native_type\", &envelope.NativeType},\n+\t\t{\"origin\", &envelope.Origin},\n+\t\t{\"protection\", &envelope.Protection},\n+\t\t{\"actor\", &envelope.Actor},\n+\t} {\n+\t\tif err := json.Unmarshal(members[field.name], field.target); err != nil {\n+\t\t\treturn NativeRecord{}, invalid(\"%s envelope member %q is not a string\", where(), field.name)\n+\t\t}\n+\t}\n+\tenvelope.Body = members[\"body\"]\n","final_result":true}}}
