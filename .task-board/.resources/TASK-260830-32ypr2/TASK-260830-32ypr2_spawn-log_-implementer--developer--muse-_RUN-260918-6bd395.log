{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d26b","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":1936,"recorded_at":1780531400003867,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"task_stream":{"kind":"task","id":"01a0b339-0a18-7fe2-a08b-edbfc4acb73f"},"task_id":"01a0b339-0a18-7fe2-a08b-edbfc4acb73f","event":{"kind":"output","task_id":"01a0b339-0a18-7fe2-a08b-edbfc4acb73f","chunk":"edited\nchanged lines: lines 274-304\n--- original\n+++ updated\n@@\n-// mustResolveRef proves a raw reference resolves: the bytes slice\n-// back out of the installed blob exactly.\n-func mustResolveRef(t *testing.T, store *localstore.ObjectStore, ref clonebundle.RawReference) []byte {\n-\tt.Helper()\n-\tfetch := storeFetch(t, store)\n-\tpayload, err := fetch(ref.BlobDescriptorID.String())\n-\tif err == nil {\n-\t\t_ = payload\n-\t}\n-\traw, err := fetchBlobByDescriptor(t, store, ref)\n-\tif err != nil {\n-\t\tt.Fatalf(\"resolve raw reference: %v\", err)\n-\t}\n-\tif ref.Offset+ref.Length > uint64(len(raw)) {\n-\t\tt.Fatalf(\"raw reference [%d:%d] exceeds blob of %d bytes\", ref.Offset, ref.Offset+ref.Length, len(raw))\n-\t}\n-\treturn raw[ref.Offset : ref.Offset+ref.Length]\n-}\n-\n-// fetchBlobByDescriptor resolves a raw reference the way the raw\n-// manifest does: the descriptor ID names the entry, the entry names\n-// the blob. The test passes the raw manifest entries explicitly.\n-func fetchBlobByDescriptor(t *testing.T, store *localstore.ObjectStore, ref clonebundle.RawReference) ([]byte, error) {\n-\tt.Helper()\n-\tfetch := storeFetch(t, store)\n-\tblobs := listStoreBlobs(t, store)\n-\tfor _, blob := range blobs {\n-\t\t_ = blob\n-\t}\n-\treturn nil, errNeedManifest\n-}\n+// mustResolveRef proves a raw reference resolves through the real\n+// path: the manifest ID names the sealed raw manifest, the\n+// descriptor ID names its raw entry, the entry names the installed\n+// blob, and the byte range slices back out exactly.\n+func mustResolveRef(t *testing.T, capture *clonesnap.CaptureResult, store *localstore.ObjectStore, ref clonebundle.RawReference) []byte {\n+\tt.Helper()\n+\tif ref.ManifestID.String() != capture.Raw.ManifestID.String() {\n+\t\tt.Fatalf(\"raw reference manifest %q names %q, want the sealed raw manifest %q\",\n+\t\t\tref.ManifestID.String(), ref.ManifestID.String(), capture.Raw.ManifestID.String())\n+\t}\n+\tblobID := \"\"\n+\tfor _, entry := range capture.Raw.Entries {\n+\t\tif entry.BlobDescriptorID.String() == ref.BlobDescriptorID.String() {\n+\t\t\tblobID = entry.BlobID.String()\n+\t\t}\n+\t}\n+\tif blobID == \"\" {\n+\t\tt.Fatalf(\"raw reference descriptor %q names no raw entry\", ref.BlobDescriptorID.String())\n+\t}\n+\tpayload, err := storeFetch(t, store)(blobID)\n+\tif err != nil {\n+\t\tt.Fatalf(\"fetch referenced blob %q: %v\", blobID, err)\n+\t}\n+\tif ref.Offset+ref.Length > uint64(len(payload)) {\n+\t\tt.Fatalf(\"raw reference [%d:%d] exceeds blob of %d bytes\", ref.Offset, ref.Offset+ref.Length, len(payload))\n+\t}\n+\treturn payload[ref.Offset : ref.Offset+ref.Length]\n+}\n","final_result":true}}}
