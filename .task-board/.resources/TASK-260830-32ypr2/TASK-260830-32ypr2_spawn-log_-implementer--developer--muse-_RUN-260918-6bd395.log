{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc41","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":1147,"recorded_at":1780531400002289,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"task_stream":{"kind":"task","id":"01a0b32f-846b-75c2-81bc-392d974a8b55"},"task_id":"01a0b32f-846b-75c2-81bc-392d974a8b55","event":{"kind":"output","task_id":"01a0b32f-846b-75c2-81bc-392d974a8b55","chunk":"Read text file `internal/traceability/traceability.go`.\n(334 line(s) above)\n335|func verifyOwnership(\n336|\trepository fs.FS,\n337|\tdocument *specdoc.Document,\n338|\tregistry ownershipRegistry,\n339|\tmanifest specpin.Manifest,\n340|\tcurrentCatalog catalog.Catalog,\n341|\tcompatibilityCatalog catalog.Catalog,\n342|\tassignedBindings []assignedSectionBinding,\n343|) (Report, error) {\n344|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n345|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n346|\t}\n347|\tsource := registry.Source\n348|\tif source.Repository != manifest.Source.Repository ||\n349|\t\tsource.Release != manifest.Source.Release ||\n350|\t\tsource.Commit != manifest.Source.Commit ||\n351|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n352|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n353|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n354|\t}\n355|\n356|\texpected := map[ownershipKind]map[string]struct{}{\n357|\t\townershipContract:         expectedContracts(manifest.Contracts),\n358|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n359|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n360|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n361|\t}\n362|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n363|\tif err != nil {\n364|\t\treturn Report{}, err\n365|\t}\n366|\trequired := map[ownershipKind]map[string]struct{}{\n367|\t\townershipContract:         expected[ownershipContract],\n368|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n369|\t\townershipSectionBinding:   requiredSectionBindings,\n370|\t\townershipFixture:          expected[ownershipFixture],\n371|\t}\n372|\tselectedSectionBindings := map[string]struct{}(nil)\n373|\tif assignedBindings != nil {\n374|\t\trequired = cloneOwnershipSets(expected)\n375|\t\tselectedSectionBindings = make(map[string]struct{})\n376|\t\tfor _, binding := range assignedBindings {\n377|\t\t\tfor _, key := range binding.Keys {\n378|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n379|\t\t\t}\n380|\t\t}\n381|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n382|\t}\n383|\tchecker := newSourceChecker(repository)\n384|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n385|\tif err != nil {\n386|\t\treturn Report{}, err\n387|\t}\n388|\t// Coverage is measured over every registered section binding, not only the\n389|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n390|\t// production entry points rather than only the repository-wide one. It is\n391|\t// measured before ownership resolution so that a section moved to the\n392|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n393|\t// as that dodge rather than as an ordinary missing owner.\n394|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n395|\tif err != nil {\n396|\t\treturn Report{}, err\n397|\t}\n398|\townedSections := make(map[string]struct{}, len(coverage))\n399|\tfor key := range coverage {\n400|\t\townedSections[key] = struct{}{}\n401|\t}\n402|\tunowned, err := verifyUnownedSections(\n403|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n404|\tif err != nil {\n405|\t\treturn Report{}, err\n406|\t}\n407|\n408|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n409|\tif err != nil {\n410|\t\treturn Report{}, err\n411|\t}\n412|\n413|\tfor _, binding := range assignedBindings {\n414|\t\tfor _, key := range binding.Keys {\n415|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n416|\t\t\t\treturn Report{}, fail(\n417|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n418|\t\t\t}\n419|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n420|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n421|\t\t\t}\n422|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n423|\t\t\t// deliberately not admitted: the gate cannot see the section's\n424|\t\t\t// obligations, and admitting on an unverifiable justification\n425|\t\t\t// sentence would be self-minted evidence for exactly the class this\n426|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n427|\t\t\t// failure to measure, not a measured absence of obligation.\n428|\t\t\tmeasured := coverage[key]\n429|\t\t\tif measured.Level != coverageFull {\n430|\t\t\t\treturn Report{}, fail(\n431|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n432|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n433|\t\t\t}\n434|\t\t}\n435|\t}\n436|\tfor _, contract := range compatibilityCatalog.Contracts {\n437|\t\tkey := contractKey(contract.Name, string(contract.ID))\n438|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n439|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n440|\t\t}\n441|\t}\n442|\n443|\tcanonical, err := json.Marshal(registry)\n444|\tif err != nil {\n445|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n446|\t}\n447|\tdigest := sha256.Sum256(canonical)\n448|\tgotDigest := hex.EncodeToString(digest[:])\n449|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n450|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n451|\t}\n452|\n453|\treport := Report{\n454|\t\tContracts:              len(expected[ownershipContract]),\n455|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n456|\t\tAcceptanceCases:        len(acceptanceIDs),\n457|\t\tFixtures:               len(expected[ownershipFixture]),\n458|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n459|\t\tAssignedScopes:         len(assignedBindings),\n460|\t\tSectionBindings:        len(coverage),\n461|\t\tUnownedSections:        len(unowned),\n462|\t}\n463|\tfor _, measured := range coverage {\n464|\t\treport.NormativeClauses += measured.Total\n465|\t\treport.DischargedClauses += measured.Discharged\n466|\t\tswitch measured.Level {\n467|\t\tcase coverageFull:\n468|\t\t\treport.FullCoverage++\n469|\t\tcase coveragePartial:\n470|\t\t\treport.PartialCoverage++\n471|\t\tcase coverageSliver:\n472|\t\t\treport.SliverCoverage++\n473|\t\tcase coverageUnevidenced:\n474|\t\t\treport.UnevidencedCoverage++\n475|\t\tcase coverageUnmeasured:\n476|\t\t\treport.UnmeasuredCoverage++\n477|\t\t}\n478|\t}\n479|\treturn report, nil\n480|}\n481|\n482|// verifySectionCoverage measures every registered section binding against the\n483|// pinned document and refuses a coverage claim on any other ownership kind. A\n484|// contract or fixture owner has no section to be measured against, so a\n485|// coverage field there would be a claim the gate cannot check.\n486|func verifySectionCoverage(\n487|\tdocument *specdoc.Document,\n488|\tgroups []ownershipGroup,\n489|\tacceptanceIDs map[string]struct{},\n490|) (map[string]sectionCoverage, error) {\n491|\tresult := make(map[string]sectionCoverage)\n492|\tfor index, group := range groups {\n493|\t\tif group.Kind != ownershipSectionBinding {\n494|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n(more lines below)","final_result":true}}}
