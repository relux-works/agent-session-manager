{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74d","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":513,"recorded_at":1780531400001021,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"call_id":"call_01a0b329d8ad7027834439e50c565c13","text":"Read text file `internal/clonesnap/project.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file owns target-branch admission and the projection output\n14|// whose existence pins the race-before-projection ordering.\n15|// CaptureAndProject runs the capture pipeline, then admits the\n16|// sealed capture manifest: the unstable_archive form can never enter\n17|// a target branch (the landed G2 gate decides), and the maximal_safe\n18|// fidelity profile requires a reconciled complete manifest (the\n19|// landed maximal-safe gate decides). Admission emits one admission\n20|// receipt into the target sink. Projection planning past admission\n21|// is the final leaf's scope; this receipt exists to prove admission\n22|// and ordering, not to plan a projection.\n23|\n24|// FidelityProfile is one Section 7.8 fidelity profile:\n25|// strict_exact|maximal_safe|compact|messages_only.\n26|type FidelityProfile string\n27|\n28|const (\n29|\t// FidelityStrictExact requests exact projection.\n30|\tFidelityStrictExact FidelityProfile = \"strict_exact\"\n31|\t// FidelityMaximalSafe requests maximal safe projection: it\n32|\t// requires a reconciled complete manifest with no unknown class.\n33|\tFidelityMaximalSafe FidelityProfile = \"maximal_safe\"\n34|\t// FidelityCompact requests compact projection.\n35|\tFidelityCompact FidelityProfile = \"compact\"\n36|\t// FidelityMessagesOnly requests messages-only projection.\n37|\tFidelityMessagesOnly FidelityProfile = \"messages_only\"\n38|)\n39|\n40|// validFidelityProfile reports whether the profile is in the Section\n41|// 7.8 closed vocabulary. Bound (P3-ζ′): sessadapter owns an\n42|// unexported copy of this four-profile table; the Story FINAL leaf\n43|// unifies or exports one owner. This package keeps its own closed\n44|// switch so the leaf boundary stays narrow.\n45|func validFidelityProfile(profile string) bool {\n46|\tswitch FidelityProfile(profile) {\n47|\tcase FidelityStrictExact, FidelityMaximalSafe, FidelityCompact, FidelityMessagesOnly:\n48|\t\treturn true\n49|\tdefault:\n50|\t\treturn false\n51|\t}\n52|}\n53|\n54|// ProjectRequest is one capture-and-project candidate: the capture\n55|// request, the target sink that receives the admission receipt, and\n56|// the fidelity profile admission decides.\n57|type ProjectRequest struct {\n58|\tCapture CaptureRequest\n59|\t// TargetSink receives the admission receipt. It stays empty\n60|\t// when capture refuses, races, or seals archive-only output.\n61|\tTargetSink *localstore.ObjectStore\n62|\t// FidelityProfile is the requested Section 7.8 profile.\n63|\tFidelityProfile string\n64|}\n65|\n66|// ProjectResult is one admitted capture: the capture result plus the\n67|// sealed admission receipt.\n68|type ProjectResult struct {\n69|\tCapture *CaptureResult\n70|\t// Receipt carries the sealed admission receipt bytes.\n71|\tReceipt []byte\n72|\t// ReceiptDigest is the blob identity of the receipt.\n73|\tReceiptDigest scalar.Digest\n74|\t// ReceiptInstalled reports whether this run installed the\n75|\t// receipt blob (a replay verifies and reuses).\n76|\tReceiptInstalled bool\n77|}\n78|\n79|// CaptureAndProject runs capture, then admits the sealed capture to\n80|// a target branch and emits the admission receipt. The race gate\n81|// precedes admission and emission (see ORDER-PIN below): a mutated\n82|// source refuses, or seals archive-only output that admission\n83|// rejects — no projection output is produced before the race is\n84|// decided.\n85|func CaptureAndProject(request ProjectRequest) (*ProjectResult, error) {\n86|\tif request.TargetSink == nil {\n87|\t\treturn nil, invalid(\"capture projection requires a target sink\")\n88|\t}\n89|\tstate, err := newPipeline(request.Capture)\n90|\tif err != nil {\n91|\t\treturn nil, err\n92|\t}\n93|\tdefer state.close()\n94|\tif err := state.walkAndMeasure(); err != nil {\n95|\t\treturn nil, err\n96|\t}\n97|\t// ORDER-PIN: the source-race gate precedes any seal, admission,\n98|\t// or projection output. N-race-order-project moves this gate\n99|\t// after admitAndEmit: the early seal then refuses with a seal\n100|\t// error instead of the race refusal, so that row's killer\n101|\t// reddens on the wrong error (the seal error message, not a\n102|\t// sink). N-race-order-project-seal keeps the race error while\n103|\t// sealing first: its killer reddens on the sealed raw manifest\n104|\t// in the capture store.\n105|\tif err := state.gateSourceRace(); err != nil {\n106|\t\tcaptured, raceErr := state.raceOutcome(err)\n107|\t\tif raceErr != nil {\n108|\t\t\treturn nil, raceErr\n109|\t\t}\n110|\t\t// Archive-only output never enters a target branch: the\n111|\t\t// admission gate below refuses it, so no receipt exists.\n112|\t\tif _, err := AdmitForTarget(captured.CaptureManifest, request.FidelityProfile); err != nil {\n113|\t\t\treturn nil, err\n114|\t\t}\n115|\t\treturn nil, invalid(\"capture archive unexpectedly admitted to a target branch\")\n116|\t}\n117|\tsealed, err := state.sealAndPublish(false)\n118|\tif err != nil {\n119|\t\treturn nil, err\n120|\t}\n121|\treturn state.admitAndEmit(request, sealed)\n122|}\n123|\n124|// admitAndEmit admits one sealed capture to the target branch and\n125|// emits its admission receipt into the target sink.\n126|func (state *pipeline) admitAndEmit(request ProjectRequest, sealed *CaptureResult) (*ProjectResult, error) {\n127|\tif _, err := AdmitForTarget(sealed.CaptureManifest, request.FidelityProfile); err != nil {\n128|\t\treturn nil, err\n129|\t}\n130|\treceipt, err := BuildAdmissionReceipt(sealed.Raw.ManifestID, sealed.Capture.ManifestID, request.FidelityProfile)\n131|\tif err != nil {\n132|\t\treturn nil, err\n133|\t}\n134|\tdigest := scalar.SHA256Digest(receipt)\n135|\tput, err := request.TargetSink.PutBlob(digest, uint64(len(receipt)), bytes.NewReader(receipt))\n136|\tif err != nil {\n137|\t\treturn nil, invalid(\"capture projection cannot publish the admission receipt: %v\", err)\n138|\t}\n139|\treturn &ProjectResult{\n140|\t\tCapture:          sealed,\n141|\t\tReceipt:          receipt,\n142|\t\tReceiptDigest:    digest,\n143|\t\tReceiptInstalled: put.Installed,\n144|\t}, nil\n145|}\n146|\n147|// AdmitForTarget admits one sealed capture manifest to a target\n148|// branch under the requested fidelity profile. The unstable_archive\n149|// form is archive-only output and always refuses; an unknown\n150|// fidelity profile refuses; maximal_safe requires a reconciled\n151|// complete manifest with no unknown class.\n152|func AdmitForTarget(captureManifest []byte, profile string) (clonebundle.CaptureManifest, error) {\n153|\tmanifest, err := clonebundle.DecodeCaptureManifest(captureManifest)\n154|\tif err != nil {\n155|\t\treturn clonebundle.CaptureManifest{}, err\n156|\t}\n157|\tif err := clonebundle.RefuseUnstableForTarget(manifest.CaptureBoundary); err != nil {\n158|\t\treturn clonebundle.CaptureManifest{}, err\n159|\t}\n160|\tif !validFidelityProfile(profile) {\n161|\t\treturn clonebundle.CaptureManifest{}, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n162|\t}\n163|\tif profile == \"maximal_safe\" {\n164|\t\tif err := clonebundle.RefuseMaximalSafeUnlessComplete(manifest); err != nil {\n165|\t\t\treturn clonebundle.CaptureManifest{}, err\n166|\t\t}\n167|\t}\n168|\treturn manifest, nil\n169|}\n170|\n171|// admissionReceiptSchema pins the admission receipt envelope\n172|// identity.\n173|const admissionReceiptSchema = \"urn:ax:internal:clonesnap-admission-receipt\"\n174|\n175|// BuildAdmissionReceipt seals one target admission receipt: the\n176|// admitted raw and capture manifest identities, the stable boundary\n177|// kind, and the fidelity profile. Only stable captures reach it;\n178|// AdmitForTarget refused everything else before this seal ran.\n179|func BuildAdmissionReceipt(rawManifestID, captureManifestID scalar.Digest, profile string) ([]byte, error) {\n180|\tif !validFidelityProfile(profile) {\n181|\t\treturn nil, invalid(\"capture fidelity profile %q is outside strict_exact|maximal_safe|compact|messages_only\", profile)\n182|\t}\n183|\tobject := map[string]any{\n184|\t\t\"schema\":                 admissionReceiptSchema,\n185|\t\t\"schema_version\":         \"1.0.0\",\n186|\t\t\"raw_object_manifest_id\": rawManifestID.String(),\n187|\t\t\"capture_manifest_id\":    captureManifestID.String(),\n188|\t\t\"boundary_kind\":          \"stable\",\n189|\t\t\"fidelity_profile\":       profile,\n190|\t\t\"extensions\":             map[string]any{},\n191|\t}\n192|\tplain, err := json.Marshal(object)\n193|\tif err != nil {\n194|\t\treturn nil, invalid(\"serialize admission receipt: %v\", err)\n195|\t}\n196|\tsealed, err := canonicaljson.Canonicalize(plain)\n197|\tif err != nil {\n198|\t\treturn nil, invalid(\"canonicalize admission receipt: %v\", err)\n199|\t}\n200|\treturn sealed, nil\n201|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74f","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":514,"recorded_at":1780531400001023,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"call_id":"call_01a0b329da2a753ba755a17d362a36bc","text":"Read text file `internal/clonebundle/event.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n11|)\n12|\n13|// This file validates and constructs Canonical Event 1.0.0 with its\n14|// Source Evidence and raw byte-range references. The envelope,\n15|// vocabularies, evidence coupling, and message-like content-block\n16|// rules are enforced here; the full per-kind payload fact registry\n17|// is sibling (normalization) scope and is stated in doc.go.\n18|\n19|const (\n20|\tcanonicalEventSchema  = \"urn:ax:schema:canonical-event\"\n21|\tcanonicalEventVersion = \"1.0.0\"\n22|\tcanonicalEventSelf    = \"event_id\"\n23|\tmaxInlineContent      = 65536\n24|)\n25|\n26|// eventKinds is the exact 26-kind event vocabulary Section 13.14.1\n27|// states.\n28|var eventKinds = []string{\n29|\t\"session_started\",\n30|\t\"instruction_snapshot\",\n31|\t\"user_message\",\n32|\t\"assistant_message\",\n33|\t\"reasoning_summary\",\n34|\t\"opaque_reasoning\",\n35|\t\"tool_definition_snapshot\",\n36|\t\"tool_call\",\n37|\t\"tool_result\",\n38|\t\"approval_request\",\n39|\t\"approval_response\",\n40|\t\"plan_update\",\n41|\t\"progress\",\n42|\t\"usage\",\n43|\t\"rate_limit\",\n44|\t\"file_change\",\n45|\t\"compaction\",\n46|\t\"turn_started\",\n47|\t\"turn_completed\",\n48|\t\"turn_aborted\",\n49|\t\"subagent_started\",\n50|\t\"subagent_completed\",\n51|\t\"error\",\n52|\t\"migration_checkpoint\",\n53|\t\"session_finished\",\n54|\t\"opaque_event\",\n55|}\n56|\n57|// ValidEventKind reports whether the name is a canonical event kind.\n58|func ValidEventKind(kind string) bool {\n59|\tfor _, allowed := range eventKinds {\n60|\t\tif kind == allowed {\n61|\t\t\treturn true\n62|\t\t}\n63|\t}\n64|\treturn false\n65|}\n66|\n67|func validVisibility(visibility string) bool {\n68|\tswitch visibility {\n69|\tcase \"public\", \"projection\", \"internal\", \"opaque\":\n70|\t\treturn true\n71|\tdefault:\n72|\t\treturn false\n73|\t}\n74|}\n75|\n76|func validCaptureStatus(status string) bool {\n77|\tswitch status {\n78|\tcase \"exact\", \"partial\", \"synthesized\", \"unavailable\":\n79|\t\treturn true\n80|\tdefault:\n81|\t\treturn false\n82|\t}\n83|}\n84|\n85|// contentBlockTypes is the exact message-like content-block\n86|// vocabulary: text|json|image|audio|document|resource_link|redacted|opaque.\n87|var contentBlockTypes = []string{\n88|\t\"text\",\n89|\t\"json\",\n90|\t\"image\",\n91|\t\"audio\",\n92|\t\"document\",\n93|\t\"resource_link\",\n94|\t\"redacted\",\n95|\t\"opaque\",\n96|}\n97|\n98|func validContentBlockType(blockType string) bool {\n99|\tfor _, allowed := range contentBlockTypes {\n100|\t\tif blockType == allowed {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// messageLikeKind reports whether the kind carries a message-like\n108|// payload: user and assistant messages always do. Other kinds may\n109|// carry content blocks under the same block rules, but only these\n110|// two require them.\n111|func messageLikeKind(kind string) bool {\n112|\treturn kind == \"user_message\" || kind == \"assistant_message\"\n113|}\n114|\n115|var rawReferenceMembers = map[string]bool{\n116|\t\"manifest_id\": true, \"blob_descriptor_id\": true, \"offset\": true, \"length\": true,\n117|}\n118|\n119|var rawReferenceRequired = []string{\n120|\t\"manifest_id\", \"blob_descriptor_id\", \"offset\", \"length\",\n121|}\n122|\n123|// RawReference is one validated raw byte-range reference.\n124|type RawReference struct {\n125|\tManifestID       scalar.Digest\n126|\tBlobDescriptorID scalar.Digest\n127|\tOffset           uint64\n128|\tLength           uint64\n129|}\n130|\n131|func decodeRawReference(raw json.RawMessage, index int) (RawReference, error) {\n132|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n133|\tif fault != nil {\n134|\t\treturn RawReference{}, invalid(\"raw reference[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n135|\t}\n136|\tif name, unknown := unknownMember(members, rawReferenceMembers); unknown {\n137|\t\treturn RawReference{}, invalid(\"raw reference[%d] carries unknown member %q\", index, name)\n138|\t}\n139|\tif name, missing := missingMember(members, rawReferenceRequired); missing {\n140|\t\treturn RawReference{}, invalid(\"raw reference[%d] misses a required member %q\", index, name)\n141|\t}\n142|\tmanifestID, ok := checkDigest(members[\"manifest_id\"])\n143|\tif !ok {\n144|\t\treturn RawReference{}, invalid(\"raw reference[%d] manifest_id is not a digest\", index)\n145|\t}\n146|\tdescriptorID, ok := checkDigest(members[\"blob_descriptor_id\"])\n147|\tif !ok {\n148|\t\treturn RawReference{}, invalid(\"raw reference[%d] blob_descriptor_id is not a digest\", index)\n149|\t}\n150|\toffset, ok := checkUint53Bounds(members[\"offset\"], 0, maxUint53)\n151|\tif !ok {\n152|\t\treturn RawReference{}, invalid(\"raw reference[%d] offset is not a uint53\", index)\n153|\t}\n154|\tlength, ok := checkUint53Bounds(members[\"length\"], 0, maxUint53)\n155|\tif !ok {\n156|\t\treturn RawReference{}, invalid(\"raw reference[%d] length is not a uint53\", index)\n157|\t}\n158|\treturn RawReference{\n159|\t\tManifestID:       manifestID,\n160|\t\tBlobDescriptorID: descriptorID,\n161|\t\tOffset:           offset,\n162|\t\tLength:           length,\n163|\t}, nil\n164|}\n165|\n166|func rawReferenceObject(reference RawReference) map[string]any {\n167|\treturn map[string]any{\n168|\t\t\"manifest_id\":        reference.ManifestID.String(),\n169|\t\t\"blob_descriptor_id\": reference.BlobDescriptorID.String(),\n170|\t\t\"offset\":             reference.Offset,\n171|\t\t\"length\":             reference.Length,\n172|\t}\n173|}\n174|\n175|// decodeSortedUniqueRawReferences validates sorted unique raw\n176|// references: bytewise order of each item's JCS encoding, strict\n177|// increase proving sortedness and uniqueness together.\n178|func decodeSortedUniqueRawReferences(raw json.RawMessage) ([]RawReference, error) {\n179|\telements, ok := decodeArray(raw)\n180|\tif !ok {\n181|\t\treturn nil, invalid(\"source evidence raw_refs are not an array\")\n182|\t}\n183|\tif len(elements) > 65536 {\n184|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(elements))\n185|\t}\n186|\treferences := make([]RawReference, 0, len(elements))\n187|\tvar previous []byte\n188|\tfor index, element := range elements {\n189|\t\treference, err := decodeRawReference(element, index)\n190|\t\tif err != nil {\n191|\t\t\treturn nil, err\n192|\t\t}\n193|\t\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(element))\n194|\t\tif err != nil {\n195|\t\t\treturn nil, invalid(\"source evidence raw_refs[%d] are not canonical JSON: %v\", index, err)\n196|\t\t}\n197|\t\tif index > 0 && bytes.Compare(canonical, previous) <= 0 {\n198|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n199|\t\t}\n200|\t\tprevious = canonical\n201|\t\treferences = append(references, reference)\n202|\t}\n203|\treturn references, nil\n204|}\n205|\n206|var sourceEvidenceMembers = map[string]bool{\n207|\t\"environment\": true, \"native_session_id\": true, \"native_event_id\": true,\n208|\t\"native_type\": true, \"raw_refs\": true, \"capture_status\": true,\n209|\t\"reason_codes\": true, \"core_operation_id\": true, \"extensions\": true,\n210|}\n211|\n212|var sourceEvidenceRequired = []string{\n213|\t\"environment\", \"native_session_id\", \"native_event_id\",\n214|\t\"native_type\", \"raw_refs\", \"capture_status\",\n215|\t\"reason_codes\", \"core_operation_id\", \"extensions\",\n216|}\n217|\n218|// SourceEvidence is one validated source evidence record.\n219|type SourceEvidence struct {\n220|\tEnvironment     sessadapter.Tuple\n221|\tNativeSessionID string\n222|\tNativeEventID   *string\n223|\tNativeType      *string\n224|\tRawRefs         []RawReference\n225|\tCaptureStatus   string\n226|\tReasonCodes     []string\n227|\tCoreOperationID *scalar.UUIDv7\n228|}\n229|\n230|// DecodeSourceEvidence validates one closed SourceEvidence:\n231|// sanitized native IDs, sorted unique raw references, and the\n232|// synthesized coupling (null native Event ID with a non-null core\n233|// operation; every other status with a null core operation).\n234|func DecodeSourceEvidence(raw json.RawMessage) (SourceEvidence, error) {\n235|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n236|\tif fault != nil {\n237|\t\treturn SourceEvidence{}, invalid(\"source evidence %s (%s)\", fault.detail, memberField(fault.member))\n238|\t}\n239|\tif name, unknown := unknownMember(members, sourceEvidenceMembers); unknown {\n240|\t\treturn SourceEvidence{}, invalid(\"source evidence carries unknown member %q\", name)\n241|\t}\n242|\tif name, missing := missingMember(members, sourceEvidenceRequired); missing {\n243|\t\treturn SourceEvidence{}, invalid(\"source evidence misses a required member %q\", name)\n244|\t}\n245|\ttuple, err := sessadapter.DecodeTuple(members[\"environment\"])\n246|\tif err != nil {\n247|\t\treturn SourceEvidence{}, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n248|\t}\n249|\tnativeSession, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n25