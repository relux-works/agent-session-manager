{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a1","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":811,"recorded_at":1780531400001617,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"task_stream":{"kind":"task","id":"01a0b32a-e751-7ff1-9ca6-d91784e82c2b"},"task_id":"01a0b32a-e751-7ff1-9ca6-d91784e82c2b","event":{"kind":"output","task_id":"01a0b32a-e751-7ff1-9ca6-d91784e82c2b","chunk":"Read text file `internal/clonesnap/fixtures_test.go`.\n(139 line(s) above)\n140|\tif err := os.MkdirAll(cwd, 0o700); err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tbranch := \"main\"\n144|\thead := fixtureDigest(\"snap-head\")\n145|\treturn WorkspaceRequest{\n146|\t\tLogicalWorkspaceID: fixtureWorkspaceID,\n147|\t\tWorkspaceRoot:      root,\n148|\t\tCwd:                cwd,\n149|\t\tRemoteFingerprints: []string{fixtureDigest(\"snap-remote\")},\n150|\t\tBranch:             &branch,\n151|\t\tHeadDigest:         &head,\n152|\t\tPlatform:           fixturePlatform(),\n153|\t}\n154|}\n155|\n156|func fixtureSourceBasis() clonebundle.SourceBasisInput {\n157|\treturn clonebundle.SourceBasisInput{\n158|\t\tKind:                     \"ax_session\",\n159|\t\tSourceSessionID:          fixtureSessionID,\n160|\t\tSourceSessionRecordID:    fixtureDigest(\"snap-session-record\"),\n161|\t\tSourceCheckpointID:       fixtureDigest(\"snap-checkpoint\"),\n162|\t\tSourceProviderIdentityID: fixtureDigest(\"snap-provider-identity\"),\n163|\t}\n164|}\n165|\n166|func validCaptureRequest(t *testing.T, storeRoot string, store *localstore.ObjectStore) CaptureRequest {\n167|\tt.Helper()\n168|\treturn CaptureRequest{\n169|\t\tStoreRoot:         storeRoot,\n170|\t\tPlatform:          fixturePlatform(),\n171|\t\tPlan:              fixturePlan(),\n172|\t\tOperationID:       fixtureOperationID,\n173|\t\tBundleID:          fixtureBundleID,\n174|\t\tSourceBasis:       fixtureSourceBasis(),\n175|\t\tSourceEnvironment: []byte(fixtureTupleJSON()),\n176|\t\tSourceIdentity:    fixtureNativeIdentity(t),\n177|\t\tCapturePlanDigest: fixtureDigest(\"snap-capture-plan\"),\n178|\t\tNativeSessionID:   \"native-session-snap\",\n179|\t\tCreatedByHostID:   fixtureHostID,\n180|\t\tCreatedAt:         fixtureCreatedAt,\n181|\t\tGeneration:        \"generation-7\",\n182|\t\tProofKind:         \"closed_store\",\n183|\t\tInputBlocked:      true,\n184|\t\tForegroundIdle:    true,\n185|\t\tBackgroundIdle:    true,\n186|\t\tOperatorExplicit:  false,\n187|\t\tOnRace:            RaceRefuse,\n188|\t\tWorkspace:         fixtureWorkspace(t),\n189|\t\tStore:             store,\n190|\t}\n191|}\n192|\n193|// storedBlob is one content-addressed file observed under a store's\n194|// objects namespace.\n195|type storedBlob struct {\n196|\tdigest scalar.Digest\n197|\tbytes  []byte\n198|}\n199|\n200|// listStoredBlobs enumerates every blob file under the store's\n201|// objects namespace. It is the test-side oracle for what capture\n202|// published: production never lists the namespace.\n203|func listStoredBlobs(t *testing.T, store *localstore.ObjectStore) []storedBlob {\n204|\tt.Helper()\n205|\tobjects := filepath.Join(store.DataRoot(), \"objects\")\n206|\tvar blobs []storedBlob\n207|\terr := filepath.Walk(objects, func(path string, info os.FileInfo, err error) error {\n208|\t\tif err != nil {\n209|\t\t\tif os.IsNotExist(err) {\n210|\t\t\t\treturn nil\n211|\t\t\t}\n212|\t\t\treturn err\n213|\t\t}\n214|\t\tif info.IsDir() {\n215|\t\t\treturn nil\n216|\t\t}\n217|\t\traw, err := os.ReadFile(path)\n218|\t\tif err != nil {\n219|\t\t\tt.Fatalf(\"ReadFile(%q) error = %v\", path, err)\n220|\t\t}\n221|\t\tsum := sha256.Sum256(raw)\n222|\t\tdigest, err := scalar.ParseDigest(\"sha256:\" + hex.EncodeToString(sum[:]))\n223|\t\tif err != nil {\n224|\t\t\tt.Fatalf(\"ParseDigest() error = %v\", err)\n225|\t\t}\n226|\t\tblobs = append(blobs, storedBlob{digest: digest, bytes: raw})\n227|\t\treturn nil\n228|\t})\n229|\tif err != nil {\n230|\t\tt.Fatalf(\"Walk(objects) error = %v\", err)\n231|\t}\n232|\treturn blobs\n233|}\n234|\n235|// blobsContain reports whether any stored blob carries the needle.\n236|func blobsContain(blobs []storedBlob, needle string) bool {\n237|\tfor _, blob := range blobs {\n238|\t\tif strings.Contains(string(blob.bytes), needle) {\n239|\t\t\treturn true\n240|\t\t}\n241|\t}\n242|\treturn false\n243|}\n244|\n245|func mustCapture(t *testing.T, request CaptureRequest) *CaptureResult {\n246|\tt.Helper()\n247|\tresult, err := Capture(request)\n248|\tif err != nil {\n249|\t\tt.Fatalf(\"Capture() error = %v\", err)\n250|\t}\n251|\tif result == nil {\n252|\t\tt.Fatal(\"Capture() returned nil result without an error\")\n253|\t}\n254|\treturn result\n255|}\n256|\n257|// assertEveryRawBlobInstalled proves the Section 10.2 install rule\n258|// at the store: every raw-manifest entry's blob is present under\n259|// its content digest. A manifest that references a blob Capture\n260|// never installed fails here.\n261|func assertEveryRawBlobInstalled(t *testing.T, store *localstore.ObjectStore, raw clonebundle.RawObjectManifest) {\n262|\tt.Helper()\n263|\tif len(raw.Entries) == 0 {\n264|\t\tt.Fatal(\"raw manifest carries no entries\")\n265|\t}\n266|\tinstalled := map[string]bool{}\n267|\tfor _, blob := range listStoredBlobs(t, store) {\n268|\t\tinstalled[blob.digest.String()] = true\n269|\t}\n270|\tfor _, entry := range raw.Entries {\n271|\t\tif !installed[entry.BlobID.String()] {\n272|\t\t\tt.Fatalf(\"raw entry %q references blob %q with no installed blob\", entry.NativeItemKey, entry.BlobID)\n273|\t\t}\n274|\t}\n275|}","final_result":true}}}
