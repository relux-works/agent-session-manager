{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bb","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":568,"recorded_at":1780531400001131,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"call_id":"call_01a0b32a0af8723ea5e756ca71b696a1","text":"Read text file `internal/clonebundle/event.go`.\n(649 line(s) above)\n650|// round. A literal ParseInt cannot read is refused defensively;\n651|// the gate above admits no such literal.\n652|func convertPayloadNumbers(payload map[string]any) (map[string]any, error) {\n653|\tout := make(map[string]any, len(payload))\n654|\tfor name, value := range payload {\n655|\t\tconverted, err := convertPayloadValue(value)\n656|\t\tif err != nil {\n657|\t\t\treturn nil, err\n658|\t\t}\n659|\t\tout[name] = converted\n660|\t}\n661|\treturn out, nil\n662|}\n663|\n664|// convertPayloadValue converts one validated payload value:\n665|// numbers become exact int64, containers recurse, and every other\n666|// scalar crosses untouched.\n667|func convertPayloadValue(value any) (any, error) {\n668|\tswitch typed := value.(type) {\n669|\tcase json.Number:\n670|\t\tinteger, err := strconv.ParseInt(typed.String(), 10, 64)\n671|\t\tif err != nil {\n672|\t\t\treturn nil, invalid(\"canonical event payload carries a number outside the AX safe-integer model\")\n673|\t\t}\n674|\t\treturn integer, nil\n675|\tcase map[string]any:\n676|\t\treturn convertPayloadNumbers(typed)\n677|\tcase []any:\n678|\t\tout := make([]any, len(typed))\n679|\t\tfor index, element := range typed {\n680|\t\t\tconverted, err := convertPayloadValue(element)\n681|\t\t\tif err != nil {\n682|\t\t\t\treturn nil, err\n683|\t\t\t}\n684|\t\t\tout[index] = converted\n685|\t\t}\n686|\t\treturn out, nil\n687|\tdefault:\n688|\t\treturn value, nil\n689|\t}\n690|}\n691|\n692|var contentBlockMembers = map[string]bool{\n693|\t\"type\": true, \"content\": true, \"blob_descriptor_id\": true, \"media_type\": true, \"extensions\": true,\n694|}\n695|\n696|// checkContentBlocks validates message-like content blocks: strict\n697|// objects with a vocabulary type, inline content of at most 64 KiB,\n698|// and digest-grammar Blob Descriptor references. The pinned text\n699|// gives each block \"typed inline content or Blob Descriptor\n700|// references\": exactly one of the two members must be present and\n701|// non-null, so a block with neither (including a null where the\n702|// member belongs) and a block with both are refused.\n703|func checkContentBlocks(raw json.RawMessage) error {\n704|\telements, ok := decodeArray(raw)\n705|\tif !ok {\n706|\t\treturn invalid(\"canonical event content_blocks are not an array\")\n707|\t}\n708|\tfor index, element := range elements {\n709|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n710|\t\tif fault != nil {\n711|\t\t\treturn invalid(\"canonical event content block[%d] %s (%s)\", index, fault.detail, memberField(fault.member))\n712|\t\t}\n713|\t\tif name, unknown := unknownMember(members, contentBlockMembers); unknown {\n714|\t\t\treturn invalid(\"canonical event content block[%d] carries unknown member %q\", index, name)\n715|\t\t}\n716|\t\tblockTypeValue, present := members[\"type\"]\n717|\t\tif !present {\n718|\t\t\treturn invalid(\"canonical event content block[%d] misses its type\", index)\n719|\t\t}\n720|\t\tblockType, ok := rawString(blockTypeValue)\n721|\t\tif !ok || !validContentBlockType(blockType) {\n722|\t\t\treturn invalid(\"canonical event content block[%d] type is outside the eight-type vocabulary\", index)\n723|\t\t}\n724|\t\t_, hasContentMember := members[\"content\"]\n725|\t\t_, hasDescriptorMember := members[\"blob_descriptor_id\"]\n726|\t\thasContent := hasContentMember && !isNull(members[\"content\"])\n727|\t\thasDescriptor := hasDescriptorMember && !isNull(members[\"blob_descriptor_id\"])\n728|\t\tif hasContent == hasDescriptor {\n729|\t\t\treturn invalid(\"canonical event content block[%d] carries content and descriptor members that are not exclusive\", index)\n730|\t\t}\n731|\t\tif content, present := members[\"content\"]; present {\n732|\t\t\ttext, ok := rawString(content)\n733|\t\t\tif !ok {\n734|\t\t\t\treturn invalid(\"canonical event content block[%d] content is not a string\", index)\n735|\t\t\t}\n736|\t\t\tif len(text) > maxInlineContent {\n737|\t\t\t\treturn invalid(\"canonical event content block[%d] inline content exceeds 64 KiB\", index)\n738|\t\t\t}\n739|\t\t}\n740|\t\tif descriptor, present := members[\"blob_descriptor_id\"]; present {\n741|\t\t\tif _, ok := checkDigest(descriptor); !ok {\n742|\t\t\t\treturn invalid(\"canonical event content block[%d] blob_descriptor_id is not a digest\", index)\n743|\t\t\t}\n744|\t\t}\n745|\t\tif mediaType, present := members[\"media_type\"]; present {\n746|\t\t\tif _, ok := checkStringBounds(mediaType, 1, 255); !ok {\n747|\t\t\t\treturn invalid(\"canonical event content block[%d] media_type is not a string[1..255]\", index)\n748|\t\t\t}\n749|\t\t}\n750|\t\tif extensions, present := members[\"extensions\"]; present {\n751|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n752|\t\t\t\treturn invalid(\"canonical event content block[%d] extensions %s\", index, extensionsFault)\n753|\t\t\t}\n754|\t\t}\n755|\t}\n756|\treturn nil\n757|}\n758|\n759|func buildSourceEvidence(input EvidenceInput) (map[string]any, error) {\n760|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.Environment))\n761|\tif err != nil {\n762|\t\treturn nil, invalid(\"source evidence environment is not an Environment Tuple: %v\", err)\n763|\t}\n764|\tif stringLength(input.NativeSessionID) < 1 || stringLength(input.NativeSessionID) > 512 {\n765|\t\treturn nil, invalid(\"source evidence native_session_id is not a string[1..512]\")\n766|\t}\n767|\tif err := SanitizeNativeKey(input.NativeSessionID); err != nil {\n768|\t\treturn nil, err\n769|\t}\n770|\tvar nativeEvent any\n771|\thasNativeEvent := false\n772|\tif input.NativeEventID != nil {\n773|\t\tif stringLength(*input.NativeEventID) < 1 || stringLength(*input.NativeEventID) > 512 {\n774|\t\t\treturn nil, invalid(\"source evidence native_event_id is not a string[1..512]\")\n775|\t\t}\n776|\t\tif err := SanitizeNativeKey(*input.NativeEventID); err != nil {\n777|\t\t\treturn nil, err\n778|\t\t}\n779|\t\tnativeEvent = *input.NativeEventID\n780|\t\thasNativeEvent = true\n781|\t}\n782|\tvar nativeType any\n783|\tif input.NativeType != nil {\n784|\t\tif !validText(*input.NativeType) {\n785|\t\t\treturn nil, invalid(\"source evidence native_type is not valid UTF-8\")\n786|\t\t}\n787|\t\tif stringLength(*input.NativeType) < 1 || stringLength(*input.NativeType) > 512 {\n788|\t\t\treturn nil, invalid(\"source evidence native_type is not a string[1..512]\")\n789|\t\t}\n790|\t\tnativeType = *input.NativeType\n791|\t}\n792|\tif len(input.RawRefs) > 65536 {\n793|\t\treturn nil, invalid(\"source evidence carries %d raw_refs, maximum is 65536\", len(input.RawRefs))\n794|\t}\n795|\treferences := make([]RawReference, 0, len(input.RawRefs))\n796|\tvar previous []byte\n797|\tfor index, candidate := range input.RawRefs {\n798|\t\tmanifestID, err := scalar.ParseDigest(candidate.ManifestID)\n799|\t\tif err != nil {\n800|\t\t\treturn nil, invalid(\"raw reference[%d] manifest_id is not a digest: %v\", index, err)\n801|\t\t}\n802|\t\tdescriptorID, err := scalar.ParseDigest(candidate.BlobDescriptorID)\n803|\t\tif err != nil {\n804|\t\t\treturn nil, invalid(\"raw reference[%d] blob_descriptor_id is not a digest: %v\", index, err)\n805|\t\t}\n806|\t\tif candidate.Offset > maxUint53 {\n807|\t\t\treturn nil, invalid(\"raw reference[%d] offset exceeds uint53\", index)\n808|\t\t}\n809|\t\tif candidate.Length > maxUint53 {\n810|\t\t\treturn nil, invalid(\"raw reference[%d] length exceeds uint53\", index)\n811|\t\t}\n812|\t\treference := RawReference{\n813|\t\t\tManifestID:       manifestID,\n814|\t\t\tBlobDescriptorID: descriptorID,\n815|\t\t\tOffset:           candidate.Offset,\n816|\t\t\tLength:           candidate.Length,\n817|\t\t}\n818|\t\tkey, err := canonicalizeObject(rawReferenceObject(reference))\n819|\t\tif err != nil {\n820|\t\t\treturn nil, err\n821|\t\t}\n822|\t\tif index > 0 && bytes.Compare(key, previous) <= 0 {\n823|\t\t\treturn nil, invalid(\"source evidence raw_refs are not sorted unique\")\n824|\t\t}\n825|\t\tprevious = key\n826|\t\treferences = append(references, reference)\n827|\t}\n828|\tif !validCaptureStatus(input.CaptureStatus) {\n829|\t\treturn nil, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n830|\t}\n831|\tpreviousReason := \"\"\n832|\tfor index, reason := range input.ReasonCodes {\n833|\t\tif !validText(reason) {\n834|\t\t\treturn nil, invalid(\"source evidence reason_codes[%d] is not valid UTF-8\", index)\n835|\t\t}\n836|\t\tif stringLength(reason) < 1 || stringLength(reason) > 128 {\n837|\t\t\treturn nil, invalid(\"source evidence reason_codes[%d] is not a string[1..128]\", index)\n838|\t\t}\n839|\t\tif index > 0 && reason <= previousReason {\n840|\t\t\treturn nil, invalid(\"source evidence reason_codes are not sorted unique\")\n841|\t\t}\n842|\t\tpreviousReason = reason\n843|\t}\n844|\tif len(input.ReasonCodes) > 128 {\n845|\t\treturn nil, invalid(\"source evidence carries %d reason_codes, maximum is 128\", len(input.ReasonCodes))\n846|\t}\n847|\tvar operation any\n848|\thasOperation := false\n849|\tif input.CoreOperationID != nil {\n850|\t\tvalue, err := scalar.ParseUUIDv7(*input.CoreOperationID)\n851|\t\tif err != nil {\n852|\t\t\treturn nil, invalid(\"source evidence core_operation_id is not a UUIDv7: %v\", err)\n853|\t\t}\n854|\t\toperation = value.String()\n855|\t\thasOperation = true\n856|\t}\n857|\tif err := checkEvidenceCoupling(input.CaptureStatus, hasNativeEvent, hasOperation); err != nil {\n858|\t\treturn nil, err\n859|\t}\n860|\tobjects := make([]any, 0, len(references))\n861|\tfor _, reference := range references {\n862|\t\tobjects = append(objects, rawReferenceObject(reference))\n863|\t}\n864|\treasons := make([]any, 0, len(input.ReasonCodes))\n865|\tfor _, reason := range input.ReasonCodes {\n866|\t\treasons = append(reasons, reason)\n867|\t}\n868|\treturn map[string]any{\n869|\t\t\"environment\":       tupleObject(tuple),\n870|\t\t\"native_session_id\": input.NativeSessionID,\n871|\t\t\"native_event_id\":   nativeEvent,\n872|\t\t\"native_type\":       nativeType,\n873|\t\t\"raw_refs\":          objects,\n874|\t\t\"capture_status\":    input.CaptureStatus,\n875|\t\t\"reason_codes\":      reasons,\n876|\t\t\"core_operation_id\": operation,\n877|\t\t\"extensions\":        map[string]any{},\n878|\t}, nil\n879|}\n880|\n881|// CheckOrdinalContiguity verifies the event-set ordinal rule:\n882|// ordinals are zero-based and contiguous, so the set must be\n883|// exactly {0..n-1}.\n884|func CheckOrdinalContiguity(ordinals []uint64) error {\n885|\tseen := make(map[uint64]bool, len(ordinals))\n886|\tfor _, ordinal := range ordinals {\n887|\t\tif ordinal >= uint64(len(ordinals)) {\n888|\t\t\treturn invalid(\"event ordinals are not contiguous from zero: ordinal %d outside [0..%d]\", ordinal, len(ordinals)-1)\n889|\t\t}\n890|\t\tif seen[ordinal] {\n891|\t\t\treturn invalid(\"event ordinals are not contiguous from zero: duplicate ordinal %d\", ordinal)\n892|\t\t}\n893|\t\tseen[ordinal] = true\n894|\t}\n895|\treturn nil\n896|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bd","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":569,"recorded_at":1780531400001133,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"call_id":"call_01a0b32a0da5731ba84dcf251d82b422","text":"Read text file `internal/clonesnap/capture.go`.\n1|package clonesnap\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n11|)\n12|\n13|// This file owns the native capture operation: Capture walks a real\n14|// provider store directory through the contained walk, installs\n15|// payload blobs through the landed no-replace discipline, seals the\n16|// Raw Object Manifest and Capture Manifest through the landed\n17|// builders, publishes both through the object store, and checkpoints\n18|// the workspace binding. The source-race gate runs after the\n19|// post-capture measurement and before any seal: a detected mutation\n20|// refuses, or seals the core-created unstable_archive form for\n21|// archive-only output when the operator explicitly acknowledged\n22|// archival. Nothing sealed here is trusted undecoded: every sealed\n23|// manifest re-decodes through the landed decoder before it is\n24|// published or returned.\n25|\n26|// RacePolicy decides a detected source mutation: RaceRefuse aborts\n27|// capture with no sealed manifest; RaceArchive seals the\n28|// unstable_archive form for archive-only output, which can never\n29|// enter a target branch.\n30|type RacePolicy string\n31|\n32|const (\n33|\t// RaceRefuse aborts capture on a detected source mutation.\n34|\tRaceRefuse RacePolicy = \"refuse\"\n35|\t// RaceArchive seals unstable_archive output on a detected\n36|\t// source mutation. It requires OperatorExplicit.\n37|\tRaceArchive RacePolicy = \"archive\"\n38|)\n39|\n40|// CaptureHooks carries the crash and race seams: AfterWalk runs\n41|// between the capture walk and the post-capture measurement (race\n42|// injection observes here), AfterRawPublish runs between the raw\n43|// manifest publish and the capture manifest seal (crash kill lands\n44|// here). A hook error aborts capture; a hook that never returns\n45|// (process kill) leaves at most the published prefix behind.\n46|type CaptureHooks struct {\n47|\tAfterWalk       func(storeRoot string) error\n48|\tAfterRawPublish func() error\n49|}\n50|\n51|// CaptureRequest is one native capture candidate over a provider\n52|// store directory.\n53|type CaptureRequest struct {\n54|\t// StoreRoot is the absolute provider store directory. Every\n55|\t// payload open descends from its verified handle.\n56|\tStoreRoot string\n57|\t// Platform governs member-name grammar.\n58|\tPlatform scalar.Platform\n59|\t// Plan carries the sorted unique capture-plan candidates.\n60|\tPlan []PlanItem\n61|\t// OperationID and BundleID identify the clone operation and\n62|\t// the logical bundle chain.\n63|\tOperationID string\n64|\tBundleID    string\n65|\t// SourceBasis binds ax_session or external_native source IDs.\n66|\tSourceBasis clonebundle.SourceBasisInput\n67|\t// SourceEnvironment carries the exact probed Environment Tuple\n68|\t// bytes.\n69|\tSourceEnvironment []byte\n70|\t// SourceIdentity is the sanitized NativeIdentity. Capture\n71|\t// re-validates it through the landed IdentityDigest before\n72|\t// anything seals: an identity decoding would refuse fails the\n73|\t// entry, so no sealed artifact carries it.\n74|\tSourceIdentity clonebundle.NativeIdentity\n75|\t// CapturePlanDigest is the exact core-validated capture-plan\n76|\t// digest.\n77|\tCapturePlanDigest string\n78|\t// NativeSessionID is the sanitized source native session ID.\n79|\tNativeSessionID string\n80|\t// CreatedByHostID and CreatedAt stamp the capture manifest.\n81|\tCreatedByHostID string\n82|\tCreatedAt       string\n83|\t// Generation is the immutable source generation token.\n84|\tGeneration string\n85|\t// ProofKind is the closed proof vocabulary:\n86|\t// closed_store|immutable_snapshot|verified_log_prefix|provider_quiescence.\n87|\tProofKind string\n88|\t// SnapshotIdentity pins an immutable snapshot; nil unless the\n89|\t// proof kind requires it.\n90|\tSnapshotIdentity *string\n91|\t// InputBlocked, ForegroundIdle, and BackgroundIdle are the\n92|\t// measured idle facts the stable proof seals.\n93|\tInputBlocked   bool\n94|\tForegroundIdle bool\n95|\tBackgroundIdle bool\n96|\t// OperatorExplicit acknowledges archive-only output when the\n97|\t// source is not quiescent.\n98|\tOperatorExplicit bool\n99|\t// OnRace decides a detected mutation: refuse or archive.\n100|\tOnRace RacePolicy\n101|\t// Workspace carries the repository state the workspace\n102|\t// checkpoint seals.\n103|\tWorkspace WorkspaceRequest\n104|\t// Store receives payload blobs and published manifests.\n105|\tStore *localstore.ObjectStore\n106|\t// MaxSingleBytes bounds one captured member; zero selects\n107|\t// DefaultMaxSingleBytes. A larger member fails capture with\n108|\t// capability_unavailable before any manifest is published.\n109|\tMaxSingleBytes uint64\n110|\t// Hooks carries the crash and race seams; nil hooks are skipped.\n111|\tHooks CaptureHooks\n112|}\n113|\n114|// CaptureResult is one completed native capture: the sealed bytes,\n115|// their decoded forms, the measured digests, and the publish facts.\n116|type CaptureResult struct {\n117|\t// RawManifest and CaptureManifest carry the sealed manifest\n118|\t// bytes produced through the landed builders.\n119|\tRawManifest     []byte\n120|\tCaptureManifest []byte\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
