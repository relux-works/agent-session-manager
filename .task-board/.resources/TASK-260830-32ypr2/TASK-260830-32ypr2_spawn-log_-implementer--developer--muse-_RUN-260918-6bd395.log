{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c775","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":533,"recorded_at":1780531400001061,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"task_stream":{"kind":"task","id":"01a0b32a-05f5-7fe0-9159-5e5e28863010"},"task_id":"01a0b32a-05f5-7fe0-9159-5e5e28863010","event":{"kind":"output","task_id":"01a0b32a-05f5-7fe0-9159-5e5e28863010","chunk":"Read text file `internal/clonebundle/event.go`.\n(249 line(s) above)\n250|\tif !ok {\n251|\t\treturn SourceEvidence{}, invalid(\"source evidence native_session_id is not a string[1..512]\")\n252|\t}\n253|\tif err := SanitizeNativeKey(nativeSession); err != nil {\n254|\t\treturn SourceEvidence{}, err\n255|\t}\n256|\tvar nativeEvent *string\n257|\tif !isNull(members[\"native_event_id\"]) {\n258|\t\tvalue, ok := checkStringBounds(members[\"native_event_id\"], 1, 512)\n259|\t\tif !ok {\n260|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_event_id is not a string[1..512]\")\n261|\t\t}\n262|\t\tif err := SanitizeNativeKey(value); err != nil {\n263|\t\t\treturn SourceEvidence{}, err\n264|\t\t}\n265|\t\tnativeEvent = &value\n266|\t}\n267|\tvar nativeType *string\n268|\tif !isNull(members[\"native_type\"]) {\n269|\t\tvalue, ok := checkStringBounds(members[\"native_type\"], 1, 512)\n270|\t\tif !ok {\n271|\t\t\treturn SourceEvidence{}, invalid(\"source evidence native_type is not a string[1..512]\")\n272|\t\t}\n273|\t\tnativeType = &value\n274|\t}\n275|\treferences, err := decodeSortedUniqueRawReferences(members[\"raw_refs\"])\n276|\tif err != nil {\n277|\t\treturn SourceEvidence{}, err\n278|\t}\n279|\tstatus, ok := rawString(members[\"capture_status\"])\n280|\tif !ok || !validCaptureStatus(status) {\n281|\t\treturn SourceEvidence{}, invalid(\"source evidence capture_status is outside exact|partial|synthesized|unavailable\")\n282|\t}\n283|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n284|\tif !ok {\n285|\t\treturn SourceEvidence{}, invalid(\"source evidence reason_codes are not sorted unique string[1..128][0..128]\")\n286|\t}\n287|\tvar operation *scalar.UUIDv7\n288|\tif !isNull(members[\"core_operation_id\"]) {\n289|\t\tvalue, ok := checkUUIDv7(members[\"core_operation_id\"])\n290|\t\tif !ok {\n291|\t\t\treturn SourceEvidence{}, invalid(\"source evidence core_operation_id is not a UUIDv7\")\n292|\t\t}\n293|\t\toperation = &value\n294|\t}\n295|\tif err := checkEvidenceCoupling(status, nativeEvent != nil, operation != nil); err != nil {\n296|\t\treturn SourceEvidence{}, err\n297|\t}\n298|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n299|\t\treturn SourceEvidence{}, invalid(\"source evidence extensions %s\", extensionsFault)\n300|\t}\n301|\treturn SourceEvidence{\n302|\t\tEnvironment:     tuple,\n303|\t\tNativeSessionID: nativeSession,\n304|\t\tNativeEventID:   nativeEvent,\n305|\t\tNativeType:      nativeType,\n306|\t\tRawRefs:         references,\n307|\t\tCaptureStatus:   status,\n308|\t\tReasonCodes:     reasons,\n309|\t\tCoreOperationID: operation,\n310|\t}, nil\n311|}\n312|\n313|// checkEvidenceCoupling enforces the synthesized rule: synthesized\n314|// requires a null native Event ID and a non-null core operation\n315|// identifying the core operation; all other statuses require a\n316|// null core operation.\n317|func checkEvidenceCoupling(status string, hasNativeEvent, hasOperation bool) error {\n318|\tif status == \"synthesized\" {\n319|\t\tif hasNativeEvent {\n320|\t\t\treturn invalid(\"source evidence synthesized carries a native event ID\")\n321|\t\t}\n322|\t\tif !hasOperation {\n323|\t\t\treturn invalid(\"source evidence synthesized requires a core operation\")\n324|\t\t}\n325|\t\treturn nil\n326|\t}\n327|\tif hasOperation {\n328|\t\treturn invalid(\"source evidence %s carries a core operation\", status)\n329|\t}\n330|\treturn nil\n331|}\n332|\n333|var canonicalEventMembers = map[string]bool{\n334|\t\"schema\": true, \"schema_version\": true, \"event_id\": true,\n335|\t\"logical_session_id\": true, \"ordinal\": true, \"parents\": true,\n336|\t\"actor_id\": true, \"turn_id\": true, \"kind\": true, \"timestamp\": true,\n337|\t\"visibility\": true, \"payload\": true, \"source_evidence\": true, \"extensions\": true,\n338|}\n339|\n340|var canonicalEventRequired = []string{\n341|\t\"schema\", \"schema_version\", \"event_id\",\n342|\t\"logical_session_id\", \"ordinal\", \"parents\",\n343|\t\"actor_id\", \"turn_id\", \"kind\", \"timestamp\",\n344|\t\"visibility\", \"payload\", \"source_evidence\", \"extensions\",\n345|}\n346|\n347|// CanonicalEvent is one validated Canonical Event. Payload carries\n348|// the validated closed payload object.\n349|type CanonicalEvent struct {\n350|\tEventID          scalar.Digest\n351|\tLogicalSessionID scalar.UUIDv7\n352|\tOrdinal          uint64\n353|\tParents          []scalar.Digest\n354|\tActorID          scalar.UUIDv7\n355|\tTurnID           *scalar.UUIDv7\n356|\tKind             string\n357|\tTimestamp        *scalar.Timestamp\n358|\tVisibility       string\n359|\tPayload          map[string]any\n360|\tEvidence         SourceEvidence\n361|}\n362|\n363|// RawRefInput is one caller-supplied raw reference candidate.\n364|type RawRefInput struct {\n365|\tManifestID       string\n366|\tBlobDescriptorID string\n367|\tOffset           uint64\n368|\tLength           uint64\n369|}\n370|\n371|// EvidenceInput is one caller-supplied source evidence candidate\n372|// for Build.\n373|type EvidenceInput struct {\n374|\tEnvironment     []byte\n375|\tNativeSessionID string\n376|\tNativeEventID   *string\n377|\tNativeType      *string\n378|\tRawRefs         []RawRefInput\n379|\tCaptureStatus   string\n380|\tReasonCodes     []string\n381|\tCoreOperationID *string\n382|}\n383|\n384|// CanonicalEventInput is the caller-supplied canonical event\n385|// candidate for Build. Payload carries the exact closed payload\n386|// object bytes; Build validates them under the kind-selected rules.\n387|type CanonicalEventInput struct {\n388|\tLogicalSessionID string\n389|\tOrdinal          uint64\n390|\tParents          []string\n391|\tActorID          string\n392|\tTurnID           *string\n393|\tKind             string\n394|\tTimestamp        *string\n395|\tVisibility       string\n396|\tPayload          []byte\n397|\tEvidence         EvidenceInput\n398|\tExtensions       map[string]any\n399|}\n400|\n401|// BuildCanonicalEvent constructs one closed Canonical Event 1.0.0\n402|// as canonical bytes. Identical inputs produce byte-identical\n403|// outputs.\n404|func BuildCanonicalEvent(input CanonicalEventInput) ([]byte, error) {\n405|\tobject, err := buildCanonicalEvent(input)\n406|\tif err != nil {\n407|\t\treturn nil, err\n408|\t}\n409|\tomitted, err := canonicalizeObject(object)\n410|\tif err != nil {\n411|\t\treturn nil, err\n412|\t}\n413|\teventID := scalar.SHA256Digest(omitted)\n414|\tobject[canonicalEventSelf] = eventID.String()\n415|\treturn canonicalizeObject(object)\n416|}\n417|\n418|func buildCanonicalEvent(input CanonicalEventInput) (map[string]any, error) {\n419|\tlogical, err := scalar.ParseUUIDv7(input.LogicalSessionID)\n420|\tif err != nil {\n421|\t\treturn nil, invalid(\"canonical event logical_session_id is not a UUIDv7: %v\", err)\n422|\t}\n423|\tif input.Ordinal > maxUint53 {\n424|\t\treturn nil, invalid(\"canonical event ordinal exceeds uint53\")\n425|\t}\n426|\tparents, err := parseSortedUniqueDigestStrings(input.Parents, 0, 64, \"parents\")\n427|\tif err != nil {\n428|\t\treturn nil, invalid(\"canonical event %v\", err)\n429|\t}\n430|\tactorID, err := scalar.ParseUUIDv7(input.ActorID)\n431|\tif err != nil {\n432|\t\treturn nil, invalid(\"canonical event actor_id is not a UUIDv7: %v\", err)\n433|\t}\n434|\tvar turn any\n435|\tif input.TurnID != nil {\n436|\t\tvalue, err := scalar.ParseUUIDv7(*input.TurnID)\n437|\t\tif err != nil {\n438|\t\t\treturn nil, invalid(\"canonical event turn_id is not a UUIDv7: %v\", err)\n439|\t\t}\n440|\t\tturn = value.String()\n441|\t}\n442|\tif !ValidEventKind(input.Kind) {\n443|\t\treturn nil, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n444|\t}\n445|\tvar stamp any\n446|\tif input.Timestamp != nil {\n447|\t\tvalue, err := scalar.ParseTimestamp(*input.Timestamp)\n448|\t\tif err != nil {\n449|\t\t\treturn nil, invalid(\"canonical event timestamp is not a timestamp: %v\", err)\n450|\t\t}\n451|\t\tstamp = value.String()\n452|\t}\n453|\tif !validVisibility(input.Visibility) {\n454|\t\treturn nil, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n455|\t}\n456|\tpayload, err := checkPayload(input.Kind, json.RawMessage(input.Payload))\n457|\tif err != nil {\n458|\t\treturn nil, err\n459|\t}\n460|\tevidence, err := buildSourceEvidence(input.Evidence)\n461|\tif err != nil {\n462|\t\treturn nil, err\n463|\t}\n464|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n465|\t\treturn nil, err\n466|\t}\n467|\treturn map[string]any{\n468|\t\t\"schema\":             canonicalEventSchema,\n469|\t\t\"schema_version\":     canonicalEventVersion,\n470|\t\t\"logical_session_id\": logical.String(),\n471|\t\t\"ordinal\":            input.Ordinal,\n472|\t\t\"parents\":            digestStrings(parents),\n473|\t\t\"actor_id\":           actorID.String(),\n474|\t\t\"turn_id\":            turn,\n475|\t\t\"kind\":               input.Kind,\n476|\t\t\"timestamp\":          stamp,\n477|\t\t\"visibility\":         input.Visibility,\n478|\t\t\"payload\":            payload,\n479|\t\t\"source_evidence\":    evidence,\n480|\t\t\"extensions\":         extensionValue(input.Extensions),\n481|\t}, nil\n482|}\n483|\n484|// DecodeCanonicalEvent validates one closed Canonical Event 1.0.0:\n485|// exact members, schema/version, self-digest agreement, the kind\n486|// and visibility vocabularies, the kind-selected payload rules,\n487|// and the source evidence coupling.\n488|func DecodeCanonicalEvent(data []byte) (CanonicalEvent, error) {\n489|\tmembers, fault := decodeStrictObject(data)\n490|\tif fault != nil {\n491|\t\treturn CanonicalEvent{}, invalid(\"canonical event %s (%s)\", fault.detail, memberField(fault.member))\n492|\t}\n493|\tif name, unknown := unknownMember(members, canonicalEventMembers); unknown {\n494|\t\treturn CanonicalEvent{}, invalid(\"canonical event carries unknown member %q\", name)\n495|\t}\n496|\tif name, missing := missingMember(members, canonicalEventRequired); missing {\n497|\t\treturn CanonicalEvent{}, invalid(\"canonical event misses a required member %q\", name)\n498|\t}\n499|\tschema, ok := rawString(members[\"schema\"])\n500|\tif !ok || schema != canonicalEventSchema {\n501|\t\treturn CanonicalEvent{}, invalid(\"canonical event schema is not the canonical event\")\n502|\t}\n503|\tversion, ok := rawString(members[\"schema_version\"])\n504|\tif !ok || version != canonicalEventVersion {\n505|\t\treturn CanonicalEvent{}, invalid(\"canonical event version is not 1.0.0\")\n506|\t}\n507|\teventID, ok := checkDigest(members[canonicalEventSelf])\n508|\tif !ok {\n509|\t\treturn CanonicalEvent{}, invalid(\"canonical event event_id is not a digest\")\n510|\t}\n511|\tlogical, ok := checkUUIDv7(members[\"logical_session_id\"])\n512|\tif !ok {\n513|\t\treturn CanonicalEvent{}, invalid(\"canonical event logical_session_id is not a UUIDv7\")\n514|\t}\n515|\tordinal, ok := checkUint53Bounds(members[\"ordinal\"], 0, maxUint53)\n516|\tif !ok {\n517|\t\treturn CanonicalEvent{}, invalid(\"canonical event ordinal is not a uint53\")\n518|\t}\n519|\tparents, ok := checkSortedUniqueDigests(members[\"parents\"], 0, 64)\n520|\tif !ok {\n521|\t\treturn CanonicalEvent{}, invalid(\"canonical event parents are not sorted unique digest[0..64]\")\n522|\t}\n523|\tactorID, ok := checkUUIDv7(members[\"actor_id\"])\n524|\tif !ok {\n525|\t\treturn CanonicalEvent{}, invalid(\"canonical event actor_id is not a UUIDv7\")\n526|\t}\n527|\tvar turn *scalar.UUIDv7\n528|\tif !isNull(members[\"turn_id\"]) {\n529|\t\tvalue, ok := checkUUIDv7(members[\"turn_id\"])\n530|\t\tif !ok {\n531|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event turn_id is not a UUIDv7\")\n532|\t\t}\n533|\t\tturn = &value\n534|\t}\n535|\tkind, ok := rawString(members[\"kind\"])\n536|\tif !ok || !ValidEventKind(kind) {\n537|\t\treturn CanonicalEvent{}, invalid(\"canonical event kind is outside the 26-kind vocabulary\")\n538|\t}\n539|\tvar stamp *scalar.Timestamp\n540|\tif !isNull(members[\"timestamp\"]) {\n541|\t\tvalue, ok := checkTimestamp(members[\"timestamp\"])\n542|\t\tif !ok {\n543|\t\t\treturn CanonicalEvent{}, invalid(\"canonical event timestamp is not a timestamp\")\n544|\t\t}\n545|\t\tstamp = &value\n546|\t}\n547|\tvisibility, ok := rawString(members[\"visibility\"])\n548|\tif !ok || !validVisibility(visibility) {\n549|\t\treturn CanonicalEvent{}, invalid(\"canonical event visibility is outside public|projection|internal|opaque\")\n550|\t}\n551|\tpayload, err := checkPayload(kind, members[\"payload\"])\n552|\tif err != nil {\n553|\t\treturn CanonicalEvent{}, err\n554|\t}\n555|\tevidence, err := DecodeSourceEvidence(members[\"source_evidence\"])\n556|\tif err != nil {\n557|\t\treturn CanonicalEvent{}, err\n558|\t}\n559|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n560|\t\treturn CanonicalEvent{}, invalid(\"canonical event extensions %s\", extensionsFault)\n561|\t}\n562|\tif err := verifySelfDigest(members, canonicalEventSelf, eventID); err != nil {\n563|\t\treturn CanonicalEvent{}, err\n564|\t}\n565|\treturn CanonicalEvent{\n566|\t\tEventID:          eventID,\n567|\t\tLogicalSessionID: logical,\n568|\t\tOrdinal:          ordinal,\n569|\t\tParents:          parents,\n570|\t\tActorID:          actorID,\n571|\t\tTurnID:           turn,\n572|\t\tKind:             kind,\n573|\t\tTimestamp:        stamp,\n574|\t\tVisibility:       visibility,\n575|\t\tPayload:          payload,\n576|\t\tEvidence:         evidence,\n577|\t}, nil\n578|}\n579|\n580|// checkPayload validates the kind-selected closed payload: every\n581|// payload is a strict (duplicate-free) object carrying only\n582|// Section 1.6 values at every depth; message-like kinds carry\n583|// exactly content_blocks plus extensions; content blocks use exactly\n584|// the eight-type vocabulary with typed inline content (at most 64\n585|// KiB) or Blob Descriptor references. Per-kind fact registries\n586|// beyond this envelope are sibling scope, but the value model is\n587|// enforced here for every kind: no payload member may round or\n588|// collapse under sealing.\n589|func checkPayload(kind string, raw json.RawMessage) (map[string]any, error) {\n590|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n591|\tif fault != nil {\n592|\t\treturn nil, invalid(\"canonical event payload %s (%s)\", fault.detail, memberField(fault.member))\n593|\t}\n594|\tif messageLikeKind(kind) {\n595|\t\tallowed := map[string]bool{\"content_blocks\": true, \"extensions\": true}\n596|\t\tif name, unknown := unknownMember(members, allowed); unknown {\n597|\t\t\treturn nil, invalid(\"canonical event message payload carries unknown member %q\", name)\n598|\t\t}\n599|\t\tblocks, present := members[\"content_blocks\"]\n600|\t\tif !present {\n601|\t\t\treturn nil, invalid(\"canonical event message payload misses content_blocks\")\n602|\t\t}\n603|\t\tif err := checkContentBlocks(blocks); err != nil {\n604|\t\t\treturn nil, err\n605|\t\t}\n606|\t\tif extensions, present := members[\"extensions\"]; present {\n607|\t\t\tif extensionsFault := checkExtensionsClosed(extensions); extensionsFault != nil {\n608|\t\t\t\treturn nil, invalid(\"canonical event message payload extensions %s\", extensionsFault)\n609|\t\t\t}\n610|\t\t}\n611|\t} else if blocks, present := members[\"content_blocks\"]; present {\n612|\t\tif err := checkContentBlocks(blocks); err != nil {\n613|\t\t\treturn nil, err\n614|\t\t}\n615|\t}\n616|\tif err := checkPayloadValues(bytesTrimSpace(raw)); err != nil {\n617|\t\treturn nil, invalid(\"canonical event payload values %s\", err)\n618|\t}\n619|\tvar payload map[string]any\n620|\tdecoder := json.NewDecoder(bytes.NewReader(bytesTrimSpace(raw)))\n621|\tdecoder.UseNumber()\n622|\tif err := decoder.Decode(&payload); err != nil {\n623|\t\treturn nil, invalid(\"canonical event payload is not an object: %v\", err)\n624|\t}\n625|\treturn convertPayloadNumbers(payload)\n626|}\n627|\n628|// checkPayloadValues enforces the Section 1.6 value model on every\n629|// payload member at every depth: integer literals only, |n| <=\n630|// 2^53-1, no fraction or exponent, nested objects duplicate-free,\n631|// depth-bounded. Payload keys are per-kind fact names rather than\n632|// reverse-DNS names, so the closed extensions key rule does not\n633|// apply here; only the shared value walker runs. This walker is the\n634|// single gate: the converter below trusts it and only changes\n635|// number representation, never admission.\n636|func checkPayloadValues(raw json.RawMessage) error {\n637|\tif err := checkExtensionValues(raw); err != nil {\n638|\t\tif err == errExtensionShape {\n639|\t\t\treturn errPayloadShape\n640|\t\t}\n641|\t\treturn err\n642|\t}\n643|\treturn nil\n644|}\n645|\n646|// convertPayloadNumbers renders the validated payload with exact\n647|// integers: every json.Number the gate admitted is an in-range\n648|// integer literal, so it becomes an int64 that marshals\n649|// byte-exact. Host float64 never appears, so no sealed value can\n(more lines below)","final_result":true}}}
