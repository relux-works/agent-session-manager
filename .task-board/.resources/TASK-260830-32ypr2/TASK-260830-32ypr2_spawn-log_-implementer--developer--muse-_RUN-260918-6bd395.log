{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000db29","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":3055,"recorded_at":1780531400006105,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"task_stream":{"kind":"task","id":"01a0b346-12a3-7cd0-b6a7-52ec158b3f45"},"task_id":"01a0b346-12a3-7cd0-b6a7-52ec158b3f45","event":{"kind":"output","task_id":"01a0b346-12a3-7cd0-b6a7-52ec158b3f45","chunk":"{\n  \"chunk_id\": \"exec-84-1\",\n  \"command\": \"cat > /tmp/registry_edit.py <<'EOF'\\nimport json\\n\\npath = 'internal/traceability/ownership.v0.7.0.json'\\no = json.load(open(path))\\n\\ndef find_binding(key):\\n    for g in o['ownership']:\\n        if g.get('kind') == 'section_binding' and g.get('keys') == [key]:\\n            return g\\n    raise SystemExit(f'binding {key} not found')\\n\\nb78 = find_binding('section:7.8')\\nb78.clear()\\nb78.update({\\n    \\\"kind\\\": \\\"section_binding\\\",\\n    \\\"keys\\\": [\\\"section:7.8\\\"],\\n    \\\"production\\\": {\\\"path\\\": \\\"internal/cloneproject/normalize.go\\\", \\\"declaration\\\": \\\"Normalize\\\"},\\n    \\\"acceptance_cases\\\": [\\\"clone-projection-fidelity\\\", \\\"session-adapter-call-binding\\\"],\\n    \\\"coverage\\\": \\\"full\\\",\\n    \\\"clauses\\\": [\\n        {\\\"id\\\": \\\"7.8#1\\\", \\\"line\\\": 3785,\\n         \\\"excerpt\\\": \\\"Large data is referenced by manifest or Blob Descriptor ID and MUST NOT be embedded in the 8 MiB frame.\\\",\\n         \\\"acceptance_cases\\\": [\\\"clone-projection-fidelity\\\"]},\\n        {\\\"id\\\": \\\"7.8#2\\\", \\\"line\\\": 3912,\\n         \\\"excerpt\\\": \\\"target mutation, these facts MUST equal freshly read trusted-candidate facts and the Journal binding.\\\",\\n         \\\"acceptance_cases\\\": [\\\"session-adapter-call-binding\\\"]},\\n    ],\\n})\\n\\nb102 = find_binding('section:10.2')\\nb102.clear()\\nb102.update({\\n    \\\"kind\\\": \\\"section_binding\\\",\\n    \\\"keys\\\": [\\\"section:10.2\\\"],\\n    \\\"production\\\": {\\\"path\\\": \\\"internal/clonesnap/capture.go\\\", \\\"declaration\\\": \\\"Capture\\\"},\\n    \\\"acceptance_cases\\\": [\\\"clone-capture-contracts\\\", \\\"clone-native-capture\\\", \\\"clone-projection-fidelity\\\"],\\n    \\\"coverage\\\": \\\"full\\\",\\n    \\\"clauses\\\": [\\n        {\\\"id\\\": \\\"10.2#1\\\", \\\"line\\\": 4854,\\n         \\\"excerpt\\\": \\\"MUST live in a manifest, not in the blob path.\\\",\\n         \\\"acceptance_cases\\\": [\\\"clone-capture-contracts\\\"]},\\n        {\\\"id\\\": \\\"10.2#2\\\", \\\"line\\\": 4855,\\n         \\\"excerpt\\\": \\\"references a blob, the writer MUST fsync the blob, verify its size and digest, and atomically install it in the object store.\\\",\\n         \\\"acceptance_cases\\\": [\\\"clone-native-capture\\\", \\\"clone-projection-fidelity\\\"]},\\n        {\\\"id\\\": \\\"10.2#3\\\", \\\"line\\\": 4859,\\n         \\\"excerpt\\\": \\\"metrics MUST record digest, size, and media type only, never blob contents.\\\",\\n         \\\"acceptance_cases\\\": [\\\"clone-native-capture\\\"]},\\n        {\\\"id\\\": \\\"10.2#4\\\", \\\"line\\\": 4862,\\n         \\\"excerpt\\\": \\\"<code>urn:ax:schema:blob</code> version <code>1.0.0</code>. Chunks MUST be sorted, contiguous, non-overlapping, start at offset zero, and cover exactly <code>size</code> bytes:\\\",\\n         \\\"acceptance_cases\\\": [\\\"clone-native-capture\\\"]},\\n        {\\\"id\\\": \\\"10.2#5\\\", \\\"line\\\": 4902,\\n         \\\"excerpt\\\": \\\"A larger file MUST fail capture with <code>capability_unavailable</code> before publishing a partial manifest.\\\",\\n         \\\"acceptance_cases\\\": [\\\"clone-native-capture\\\"]},\\n    ],\\n})\\n\\nnew_cases = [\\n    {\\\"id\\\": \\\"clone-capture-contracts\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/clonebundle/rawmanifest.go\\\", \\\"declaration\\\": \\\"BuildRawObjectManifest\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/clonebundle/contract_test.go\\\", \\\"declaration\\\": \\\"TestBuildRawManifestRoundTrip\\\"},\\n         {\\\"path\\\": \\\"internal/clonebundle/contract_test.go\\\", \\\"declaration\\\": \\\"TestBuildCaptureManifestDerivesRawComplete\\\"},\\n         {\\\"path\\\": \\\"internal/clonebundle/contract_test.go\\\", \\\"declaration\\\": \\\"TestBuildCanonicalEventRoundTrip\\\"},\\n         {\\\"path\\\": \\\"internal/clonebundle/refusal_test.go\\\", \\\"declaration\\\": \\\"TestRawManifestRefusals\\\"},\\n         {\\\"path\\\": \\\"internal/clonebundle/refusal_test.go\\\", \\\"declaration\\\": \\\"TestCaptureManifestRefusals\\\"},\\n     ]},\\n    {\\\"id\\\": \\\"clone-native-capture\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/clonesnap/capture.go\\\", \\\"declaration\\\": \\\"Capture\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/clonesnap/capture_test.go\\\", \\\"declaration\\\": \\\"TestCaptureSealsBothManifestsFromStoreBytes\\\"},\\n         {\\\"path\\\": \\\"internal/clonesnap/capture_test.go\\\", \\\"declaration\\\": \\\"TestCaptureInstallsEveryPayloadBlob\\\"},\\n         {\\\"path\\\": \\\"internal/clonesnap/capture_test.go\\\", \\\"declaration\\\": \\\"TestCaptureMultiChunkMember\\\"},\\n         {\\\"path\\\": \\\"internal/clonesnap/exclusion_test.go\\\", \\\"declaration\\\": \\\"TestCaptureLogRecordsDigestsOnly\\\"},\\n         {\\\"path\\\": \\\"internal/clonesnap/refusal_test.go\\\", \\\"declaration\\\": \\\"TestCaptureRefusesOversizedMember\\\"},\\n     ]},\\n    {\\\"id\\\": \\\"clone-projection-fidelity\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/cloneproject/normalize.go\\\", \\\"declaration\\\": \\\"Normalize\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/cloneproject/normalize_test.go\\\", \\\"declaration\\\": \\\"TestNormalizeUnknownRecordBecomesOpaqueEvent\\\"},\\n         {\\\"path\\\": \\\"internal/cloneproject/normalize_test.go\\\", \\\"declaration\\\": \\\"TestNormalizeInlineContentBoundary\\\"},\\n         {\\\"path\\\": \\\"internal/cloneproject/foreign_test.go\\\", \\\"declaration\\\": \\\"TestNormalizeForeignEncryptedReasoningStaysOpaque\\\"},\\n         {\\\"path\\\": \\\"internal/cloneproject/tools_test.go\\\", \\\"declaration\\\": \\\"TestNormalizeToolMatrix\\\"},\\n         {\\\"path\\\": \\\"internal/cloneproject/fidelity_test.go\\\", \\\"declaration\\\": \\\"TestNormalizeIsIdempotentIntoSharedSink\\\"},\\n     ]},\\n    {\\\"id\\\": \\\"session-adapter-call-binding\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/sessadapter/discovery.go\\\", \\\"declaration\\\": \\\"CheckCallBinding\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/sessadapter/discovery_test.go\\\", \\\"declaration\\\": \\\"TestCheckCallBinding\\\"},\\n         {\\\"path\\\": \\\"internal/sessadapter/discovery_test.go\\\", \\\"declaration\\\": \\\"TestCheckCallBindingZeroFactsRefuse\\\"},\\n     ]},\\n]\\nids = {c['id'] for c in o['acceptance_cases']}\\nfor case in new_cases:\\n    assert case['id'] not in ids, case['id']\\no['acceptance_cases'].extend(new_cases)\\n\\nopen(path, 'w').write(json.dumps(o, indent=2) + '\\\\n')\\nprint('cases:', len(o['acceptance_cases']))\\nEOF\\npython3 /tmp/registry_edit.py && git diff --stat internal/traceability/ownership.v0.7.0.json\",\n  \"description\": \"Upgrade registry bindings and cases\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"cases: 139\\n internal/traceability/ownership.v0.7.0.json | 193 +++++++++++++++++++++++++---\\n 1 file changed, 176 insertions(+), 17 deletions(-)\\n\",\n  \"original_output_bytes\": 143,\n  \"original_output_tokens\": 36,\n  \"tr