{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc17","stream":{"kind":"session","id":"01a0b328-b328-7981-8beb-18f071df4b5f"},"sequence":1126,"recorded_at":1780531400002247,"record_type":"event","durability":"durable","causation_id":"8855960a-8895-4077-a9ec-0cb17e90819e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8855960a-8895-4077-a9ec-0cb17e90819e","run_stream":{"kind":"run","id":"8855960a-8895-4077-a9ec-0cb17e90819e"},"task_stream":{"kind":"task","id":"01a0b32f-74f9-7201-ab2d-8f33565338ee"},"task_id":"01a0b32f-74f9-7201-ab2d-8f33565338ee","event":{"kind":"output","task_id":"01a0b32f-74f9-7201-ab2d-8f33565338ee","chunk":"Read text file `internal/traceability/traceability.go`.\n(201 line(s) above)\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.VerifyV070(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV070)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\t// The two legacy projections keep the superseded v0.6.0 and v0.5.0\n255|\t// registries honest. Each is verified the same way: the adopted v0.7.0\n256|\t// lock derives the historical rows through ContractsForRelease (the\n257|\t// v0.6.0 projection drops the Launch Plan request row and trims the\n258|\t// five widened version lists; the v0.5.0 projection derives through\n259|\t// that v0.6.0 projection), and the generated catalog must still carry\n260|\t// those exact rows under the historical release, so legacy support\n261|\t// claims stay verifiable after the authority moved to v0.7.0.\n262|\tfor _, legacy := range []struct {\n263|\t\trelease string\n264|\t\tcatalog catalog.Release\n265|\t}{\n266|\t\t{specpin.ReleaseV060, catalog.ReleaseV060},\n267|\t\t{specpin.ReleaseV050, catalog.ReleaseV050},\n268|\t} {\n269|\t\tlegacyContracts, err := manifest.ContractsForRelease(legacy.release)\n270|\t\tif err != nil {\n271|\t\t\treturn Report{}, fail(\"derive legacy %s catalog contracts: %v\", legacy.release, err)\n272|\t\t}\n273|\t\tlegacyCatalog, err := catalog.ForRelease(legacy.catalog)\n274|\t\tif err != nil {\n275|\t\t\treturn Report{}, fail(\"load legacy %s catalog: %v\", legacy.catalog, err)\n276|\t\t}\n277|\t\tif err := verifyCatalogContracts(legacyContracts, legacyCatalog.Contracts); err != nil {\n278|\t\t\treturn Report{}, fail(\"legacy %s catalog differs from the adopted lock projection: %v\", legacy.release, err)\n279|\t\t}\n280|\t}\n281|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n282|\tif err != nil {\n283|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n284|\t}\n285|\n286|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n287|\tif err != nil {\n288|\t\treturn Report{}, err\n289|\t}\n290|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n291|\tif err != nil {\n292|\t\treturn Report{}, err\n293|\t}\n294|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n295|\tif err != nil {\n296|\t\treturn Report{}, err\n297|\t}\n298|\tdocument, err := specdoc.LoadV070()\n299|\tif err != nil {\n300|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n301|\t}\n302|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256V070 {\n303|\t\treturn Report{}, fail(\n304|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n305|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256V070)\n306|\t}\n307|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n308|}\n309|\n310|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n311|\tvalue, err := fs.ReadFile(repository, filename)\n312|\tif err != nil {\n313|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n314|\t}\n315|\treturn value, nil\n316|}\n317|\n318|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n319|\tvar decoded ownershipRegistry\n320|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n321|\tdecoder.DisallowUnknownFields()\n(more lines below)","final_result":true}}}
