{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d59b","stream":{"kind":"session","id":"01a0b368-b8fb-7503-b19c-2c040425ca00"},"sequence":2344,"recorded_at":1780531400004683,"record_type":"event","durability":"durable","causation_id":"9c78dd5e-2606-42c8-9e04-207bbea54fed","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9c78dd5e-2606-42c8-9e04-207bbea54fed","run_stream":{"kind":"run","id":"9c78dd5e-2606-42c8-9e04-207bbea54fed"},"task_stream":{"kind":"task","id":"01a0b376-2bcf-7121-ac3f-e40465628155"},"task_id":"01a0b376-2bcf-7121-ac3f-e40465628155","event":{"kind":"output","task_id":"01a0b376-2bcf-7121-ac3f-e40465628155","chunk":"Read text file `internal/cloneproject/normalize.go`.\n1|package cloneproject\n2|\n3|// This file owns the Normalize production entry: manifest closure,\n4|// blob verification, native dispatch, tool/instruction/usage folds,\n5|// event and session construction through the landed builders, and\n6|// the re-decode of every sealed byte before return.\n7|\n8|import (\n9|\t\"bytes\"\n10|\t\"encoding/json\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// Stable reason codes this projection emits. They are the closed\n19|// core reasons Section 13.14.2 registers for exactly these causes,\n20|// reused here as Source Evidence reason codes.\n21|const (\n22|\t// reasonUnknownNative marks records whose native type or member\n23|\t// class the projection does not register.\n24|\treasonUnknownNative = \"unknown_native_event\"\n25|\t// reasonForeignEncrypted marks foreign encrypted records\n26|\t// preserved opaque.\n27|\treasonForeignEncrypted = \"foreign_encrypted_payload\"\n28|\t// reasonForeignSigned marks foreign signed records preserved\n29|\t// opaque.\n30|\treasonForeignSigned = \"foreign_signature_unverifiable\"\n31|\t// reasonUnsafePending marks incomplete tool history that blocks\n32|\t// pending action.\n33|\treasonUnsafePending = \"unsafe_pending_action\"\n34|)\n35|\n36|// NormalizeRequest is one projection candidate over captured bytes.\n37|type NormalizeRequest struct {\n38|\t// CaptureManifest and RawManifest carry the sealed manifests\n39|\t// clonesnap.Capture produced.\n40|\tCaptureManifest []byte\n41|\tRawManifest     []byte\n42|\t// Fetch reads one installed blob by content digest. Tests wire\n43|\t// it to the real capture store; every fetched byte is\n44|\t// digest- and size-verified before use.\n45|\tFetch func(blobID string) ([]byte, error)\n46|\t// CanonicalSink receives overflow content blobs through the\n47|\t// landed no-replace discipline.\n48|\tCanonicalSink *localstore.ObjectStore\n49|\t// LogicalSessionID and MainActorID identify the projected\n50|\t// session and its main actor.\n51|\tLogicalSessionID string\n52|\tMainActorID      string\n53|\t// Actors maps extra actor selectors\n54|\t// (external, subagent:<name>) to actor UUIDv7. Every mapped\n55|\t// selector must be referenced, and every referenced selector\n56|\t// must be mapped.\n57|\tActors map[string]string\n58|\t// Title stamps the session title; nil seals a null title.\n59|\tTitle *string\n60|\t// Workspace carries the sealed Workspace Binding bytes (the\n61|\t// capture's workspace checkpoint, passed through).\n62|\tWorkspace []byte\n63|}\n64|\n65|// NormalizeResult is one projected bundle: sealed bytes, their\n66|// decoded forms, and the derived folds.\n67|type NormalizeResult struct {\n68|\t// Session carries the sealed Canonical Session bytes.\n69|\tSession []byte\n70|\t// DecodedSession is the re-decoded session.\n71|\tDecodedSession clonebundle.CanonicalSession\n72|\t// Events carries the sealed Canonical Event bytes in ordinal\n73|\t// order.\n74|\tEvents [][]byte\n75|\t// DecodedEvents are the re-decoded events in ordinal order.\n76|\tDecodedEvents []clonebundle.CanonicalEvent\n77|\t// ToolResolutions carries the completed/aborted fold in call\n78|\t// order with orphan results after calls.\n79|\tToolResolutions []ToolResolution\n80|\t// Live is the live surface: always empty from capture.\n81|\tLive LiveSurface\n82|\t// Instruction is the effective instruction snapshot: native\n83|\t// history only.\n84|\tInstruction EffectiveInstruction\n85|\t// Usage separates source usage from zero target accounting.\n86|\tUsage UsageLedger\n87|\t// Overflows names every installed overflow blob in event\n88|\t// order, so content references resolve.\n89|\tOverflows []OverflowBlob\n90|}\n91|\n92|// Normalize derives a Canonical Session and Canonical Events from\n93|// captured bytes. The unstable_archive form cannot enter: target\n94|// projection refuses it through the landed G2 gate. Every sealed\n95|// event and the session re-decode through the landed decoders before\n96|// return; a failure anywhere returns no partial bundle.\n97|func Normalize(request NormalizeRequest) (*NormalizeResult, error) {\n98|\tif request.Fetch == nil {\n99|\t\treturn nil, invalid(\"projection requires a blob fetcher\")\n100|\t}\n101|\tif request.CanonicalSink == nil {\n102|\t\treturn nil, invalid(\"projection requires a canonical sink\")\n103|\t}\n104|\tif len(request.Workspace) == 0 {\n105|\t\treturn nil, invalid(\"projection requires workspace binding bytes\")\n106|\t}\n107|\tlogical, err := scalar.ParseUUIDv7(request.LogicalSessionID)\n108|\tif err != nil {\n109|\t\treturn nil, invalid(\"projection logical_session_id is not a UUIDv7: %v\", err)\n110|\t}\n111|\tmainActor, err := scalar.ParseUUIDv7(request.MainActorID)\n112|\tif err != nil {\n113|\t\treturn nil, invalid(\"projection main actor is not a UUIDv7: %v\", err)\n114|\t}\n115|\textraActors := map[string]scalar.UUIDv7{}\n116|\tfor selector, value := range request.Actors {\n117|\t\tif err := checkActorSelector(selector); err != nil {\n118|\t\t\treturn nil, err\n119|\t\t}\n120|\t\tif selector == \"main\" {\n121|\t\t\treturn nil, invalid(\"projection actor map carries main, which is request.MainActorID\")\n122|\t\t}\n123|\t\tparsed, err := scalar.ParseUUIDv7(value)\n124|\t\tif err != nil {\n125|\t\t\treturn nil, invalid(\"projection actor %q is not a UUIDv7: %v\", selector, err)\n126|\t\t}\n127|\t\textraActors[selector] = parsed\n128|\t}\n129|\tcapture, err := clonebundle.DecodeCaptureManifest(request.CaptureManifest)\n130|\tif err != nil {\n131|\t\treturn nil, err\n132|\t}\n133|\tif err := clonebundle.RefuseUnstableForTarget(capture.CaptureBoundary); err != nil {\n134|\t\treturn nil, err\n135|\t}\n136|\traw, err := clonebundle.DecodeRawObjectManifest(request.RawManifest)\n137|\tif err != nil {\n138|\t\treturn nil, err\n139|\t}\n140|\tif raw.ManifestID.String() != capture.SourceRawObjectManifest.String() {\n141|\t\treturn nil, invalid(\"capture manifest links raw manifest %q, sealed raw manifest is %q\",\n142|\t\t\tcapture.SourceRawObjectManifest.String(), raw.ManifestID.String())\n143|\t}\n144|\tenvironment, err := sealedEnvironment(request.RawManifest, request.CaptureManifest)\n145|\tif err != nil {\n146|\t\treturn nil, err\n147|\t}\n148|\tentries := map[string]clonebundle.RawObjectEntry{}\n149|\tfor _, entry := range raw.Entries {\n150|\t\tentries[entry.NativeItemKey] = entry\n151|\t}\n152|\tplan := &projectionPlan{\n153|\t\trequest:     request,\n154|\t\traw:         raw,\n155|\t\tentries:     entries,\n156|\t\tenvironment: environment,\n157|\t\tlogical:     logical,\n158|\t\tmainActor:   mainActor,\n159|\t\textraActors: extraActors,\n160|\t}\n161|\tif err := plan.collectMembers(capture); err != nil {\n162|\t\treturn nil, err\n163|\t}\n164|\tif len(plan.units) == 0 {\n165|\t\treturn nil, invalid(\"projection holds no events\")\n166|\t}\n167|\tif err := plan.foldTools(); err != nil {\n168|\t\treturn nil, err\n169|\t}\n170|\tif err := plan.foldInstructions(); err != nil {\n171|\t\treturn nil, err\n172|\t}\n173|\tif err := plan.foldUsage(); err != nil {\n174|\t\treturn nil, err\n175|\t}\n176|\tsurface, err := deriveLiveSurface(plan.definitions, plan.resolutions, nil)\n177|\tif err != nil {\n178|\t\treturn nil, err\n179|\t}\n180|\tplan.surface = surface\n181|\tif err := plan.checkActors(); err != nil {\n182|\t\treturn nil, err\n183|\t}\n184|\tif err := plan.buildEvents(); err != nil {\n185|\t\treturn nil, err\n186|\t}\n187|\treturn plan.buildResult()\n188|}\n189|\n190|// sealedEnvironment extracts the exact source_environment member\n191|// from both sealed manifests and refuses closure drift: the two\n192|// sealed tuples must agree byte-for-byte after canonicalization, so\n193|// the evidence environment is unambiguous.\n194|func sealedEnvironment(rawManifest, captureManifest []byte) ([]byte, error) {\n195|\traw, err := sealedMember(rawManifest, \"source_environment\")\n196|\tif err != nil {\n197|\t\treturn nil, err\n198|\t}\n199|\tcaptured, err := sealedMember(captureManifest, \"source_environment\")\n200|\tif err != nil {\n201|\t\treturn nil, err\n202|\t}\n203|\trawCanonical, err := canonicaljson.Canonicalize(raw)\n204|\tif err != nil {\n205|\t\treturn nil, invalid(\"raw manifest source_environment is not canonical JSON: %v\", err)\n206|\t}\n207|\tcapturedCanonical, err := canonicaljson.Canonicalize(captured)\n208|\tif err != nil {\n209|\t\treturn nil, invalid(\"capture manifest source_environment is not canonical JSON: %v\", err)\n210|\t}\n211|\tif !bytes.Equal(rawCanonical, capturedCanonical) {\n212|\t\treturn nil, invalid(\"capture closure drifts: raw and capture source_environment disagree\")\n213|\t}\n214|\treturn rawCanonical, nil\n215|}\n216|\n217|// sealedMember extracts one raw member from sealed bytes. Both\n218|// manifests decoded clean before this runs, so the bytes are\n219|// canonical and duplicate-free.\n220|func sealedMember(sealed []byte, name string) ([]byte, error) {\n221|\tvar members map[string]json.RawMessage\n222|\tif err := json.Unmarshal(sealed, &members); err != nil {\n223|\t\treturn nil, invalid(\"sealed manifest is not a JSON object: %v\", err)\n224|\t}\n225|\traw, ok := members[name]\n226|\tif !ok {\n227|\t\treturn nil, invalid(\"sealed manifest misses member %q\", name)\n228|\t}\n229|\treturn raw, nil\n230|}\n231|\n232|// projectionUnit is one projectable unit: a parsed record or a\n233|// whole unknown-class member.\n234|type projectionUnit struct {\n235|\trecord NativeRecord\n236|\t// memberOpaque marks a whole-member opaque_event: Offset is 0\n237|\t// and Length is the member byte count.\n238|\tmemberOpaque bool\n239|\t// descriptorID is the raw entry's descriptor; blob bytes are\n240|\t// verified before the unit is admitted.\n241|\tdescriptorID string\n242|\t// definition, call, result, instruction, and usage cache the\n243|\t// decoded bodies the folds validated, so dispatch never\n244|\t// re-decodes and never swallows a decode failure.\n245|\tdefinition  *toolDefinitionBody\n246|\tcall        *toolCallBody\n247|\tresult      *toolResultBody\n248|\tinstruction *instructionBody\n249|\tusage       *usageBody\n250|\t// kind, visibility, payload, and reasons are the dispatch.\n251|\tkind       string\n252|\tvisibility string\n253|\tpayload    map[string]any\n254|\treasons    []string\n255|}\n256|\n257|// projectionPlan accumulates one normalization.\n258|type projectionPlan struct {\n259|\trequest     NormalizeRequest\n260|\traw         clonebundle.RawObjectManifest\n261|\tentries     map[string]clonebundle.RawObjectEntry\n262|\tenvironment []byte\n263|\tlogical     scalar.UUIDv7\n264|\tmainActor   scalar.UUIDv7\n265|\textraActors map[string]scalar.UUIDv7\n266|\n267|\tunits        []projectionUnit\n268|\tcalls        []toolCall\n269|\tresults      []toolResult\n270|\tdefinitions  []toolDefinition\n271|\tinstructions []instructionObservation\n272|\tusages       []usageObservation\n273|\n274|\tresolutions []ToolResolution\n275|\tsurface     LiveSurface\n276|\tinstruction EffectiveInstruction\n277|\tusage       UsageLedger\n278|\n279|\tevents        [][]byte\n280|\tdecodedEvents []clonebundle.CanonicalEvent\n281|\tordinals      []uint64\n282|\toverflows     []OverflowBlob\n283|}\n284|\n285|// collectMembers verifies every included member's blob and parses\n286|// its records in capture order.\n287|func (plan *projectionPlan) collectMembers(capture clonebundle.CaptureManifest) error {\n288|\tfor _, item := range capture.Items {\n289|\t\tif !item.Included() {\n290|\t\t\tcontinue\n291|\t\t}\n292|\t\tentry, ok := plan.entries[item.NativeItemKey]\n293|\t\tif !ok {\n294|\t\t\treturn invalid(\"capture item %q is included with no raw object entry\", item.NativeItemKey)\n295|\t\t}\n296|\t\tpayload, err := plan.request.Fetch(entry.BlobID.String())\n297|\t\tif err != nil {\n298|\t\t\treturn invalid(\"projection cannot fetch blob %q for member %q: %v\", entry.BlobID.String(), item.NativeItemKey, err)\n299|\t\t}\n300|\t\tif uint64(len(payload)) != entry.ByteCount {\n301|\t\t\treturn invalid(\"member %q blob size %d disagrees with raw count %d\", item.NativeItemKey, len(payload), entry.ByteCount)\n302|\t\t}\n303|\t\tif scalar.SHA256Digest(payload).String() != entry.BlobID.String() {\n304|\t\t\treturn invalid(\"member %q blob digest disagrees with raw entry\", item.NativeItemKey)\n305|\t\t}\n306|\t\tif item.Class == \"unknown\" {\n307|\t\t\tplan.units = append(plan.units, projectionUnit{\n308|\t\t\t\trecord: NativeRecord{\n309|\t\t\t\t\tMemberKey:     item.NativeItemKey,\n310|\t\t\t\t\tOffset:        0,\n311|\t\t\t\t\tLength:        entry.ByteCount,\n312|\t\t\t\t\tNativeEventID: \"\",\n313|\t\t\t\t\tNativeType:    \"\",\n314|\t\t\t\t\tOrigin:        \"native\",\n315|\t\t\t\t\tProtection:    \"none\",\n316|\t\t\t\t\tActor:         \"main\",\n317|\t\t\t\t\tLineBytes:     append([]byte(nil), payload...),\n318|\t\t\t\t},\n319|\t\t\t\tmemberOpaque: true,\n320|\t\t\t\tdescriptorID: entry.BlobDescriptorID.String(),\n321|\t\t\t})\n322|\t\t\tcontinue\n323|\t\t}\n324|\t\tlines, err := splitRecordLines(item.NativeItemKey, payload)\n325|\t\tif err != nil {\n326|\t\t\treturn err\n327|\t\t}\n328|\t\tfor _, line := range lines {\n329|\t\t\trecord, err := parseNativeLine(item.NativeItemKey, line.number, line.offset, line.raw)\n330|\t\t\tif err != nil {\n331|\t\t\t\treturn err\n332|\t\t\t}\n333|\t\t\tplan.units = append(plan.units, projectionUnit{\n334|\t\t\t\trecord:       record,\n335|\t\t\t\tdescriptorID: entry.BlobDescriptorID.String(),\n336|\t\t\t})\n337|\t\t}\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|// foldTools collects tool observations in record order and resolves\n343|// the completed/aborted fold.\n344|func (plan *projectionPlan) foldTools() error {\n345|\tfor index := range plan.units {\n346|\t\tunit := &plan.units[index]\n347|\t\tif unit.memberOpaque {\n348|\t\t\tcontinue\n349|\t\t}\n350|\t\trecord := unit.record\n351|\t\tif record.Protection != \"none\" && !isReasoningType(record.NativeType) {\n352|\t\t\tcontinue\n353|\t\t}\n354|\t\tswitch record.NativeType {\n355|\t\tcase nativeToolDefinition:\n356|\t\t\tbody, err := decodeToolDefinitionBody(record)\n357|\t\t\tif err != nil {\n358|\t\t\t\treturn err\n359|\t\t\t}\n360|\t\t\tif _, err := scalar.ParseDigest(body.DefinitionHash); err != nil {\n361|\t\t\t\treturn invalid(\"record %s line %s body definition_digest is not a digest: %v\",\n362|\t\t\t\t\trecord.MemberKey, itoa(record.Line), err)\n363|\t\t\t}\n364|\t\t\tunit.definition = &body\n365|\t\t\tplan.definitions = append(plan.definitions, toolDefinition{record: record, body: body})\n366|\t\tcase nativeToolCall:\n367|\t\t\tbody, err := decodeToolCallBody(record)\n368|\t\t\tif err != nil {\n369|\t\t\t\treturn err\n370|\t\t\t}\n371|\t\t\tunit.call = &body\n372|\t\t\tplan.calls = append(plan.calls, toolCall{record: record, body: body})\n373|\t\tcase nativeToolResult:\n374|\t\t\tbody, err := decodeToolResultBody(record)\n375|\t\t\tif err != nil {\n376|\t\t\t\treturn err\n377|\t\t\t}\n378|\t\t\tunit.result = &body\n379|\t\t\tplan.results = append(plan.results, toolResult{record: record, body: body})\n380|\t\t}\n381|\t}\n382|\tresolutions, err := resolveToolCalls(plan.calls, plan.results)\n383|\tif err != nil {\n384|\t\treturn err\n385|\t}\n386|\tplan.resolutions = resolutions\n387|\treturn nil\n388|}\n389|\n390|// foldInstructions collects instruction observations in record\n391|// order and folds the effective snapshot.\n392|func (plan *projectionPlan) foldInstructions() error {\n393|\tfor index := range plan.units {\n394|\t\tunit := &plan.units[index]\n395|\t\tif unit.memberOpaque {\n396|\t\t\tcontinue\n397|\t\t}\n398|\t\trecord := unit.record\n399|\t\tif record.NativeType != nativeInstruction || record.Protection != \"none\" {\n400|\t\t\tcontinue\n401|\t\t}\n402|\t\tbody, err := decodeInstructionBody(record)\n403|\t\tif err != nil {\n404|\t\t\treturn err\n405|\t\t}\n406|\t\tunit.instruction = &body\n407|\t\tplan.instructions = append(plan.instructions, instructionObservation{record: record, body: body})\n408|\t}\n409|\tplan.instruction = foldInstructions(plan.instructions)\n410|\treturn nil\n411|}\n412|\n413|// foldUsage collects usage observations in record order and folds\n414|// the source ledger.\n415|func (plan *projectionPlan) foldUsage() error {\n416|\tfor index := range plan.units {\n417|\t\tunit := &plan.units[index]\n418|\t\tif unit.memberOpaque {\n419|\t\t\tcontinue\n420|\t\t}\n421|\t\trecord := unit.record\n422|\t\tif record.NativeType != nativeUsage || record.Protection != \"none\" {\n423|\t\t\tcontinue\n424|\t\t}\n425|\t\tbody, err := decodeUsageBody(record)\n426|\t\tif err != nil {\n427|\t\t\treturn err\n428|\t\t}\n429|\t\tunit.usage = &body\n430|\t\tplan.usages = append(plan.usages, usageObservation{record: record, body: body})\n431|\t}\n432|\tledger, err := foldUsage(plan.usages)\n433|\tif err != nil {\n434|\t\treturn err\n435|\t}\n436|\tplan.usage = ledger\n437|\treturn nil\n438|}","final_result":true}}}
