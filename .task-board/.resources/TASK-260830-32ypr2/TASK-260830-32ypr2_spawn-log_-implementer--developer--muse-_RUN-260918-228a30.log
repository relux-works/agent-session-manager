{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d8cd","stream":{"kind":"session","id":"01a0b368-b8fb-7503-b19c-2c040425ca00"},"sequence":2753,"recorded_at":1780531400005501,"record_type":"event","durability":"durable","causation_id":"9c78dd5e-2606-42c8-9e04-207bbea54fed","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9c78dd5e-2606-42c8-9e04-207bbea54fed","run_stream":{"kind":"run","id":"9c78dd5e-2606-42c8-9e04-207bbea54fed"},"task_stream":{"kind":"task","id":"01a0b377-dc0b-7ed3-aeb4-d2c886cd1743"},"task_id":"01a0b377-dc0b-7ed3-aeb4-d2c886cd1743","event":{"kind":"output","task_id":"01a0b377-dc0b-7ed3-aeb4-d2c886cd1743","chunk":"Read text file `internal/cloneproject/native.go`.\n(299 line(s) above)\n300|}\n301|\n302|// maxUint53 is 2^53-1, the AX safe-integer ceiling.\n303|const maxUint53 = uint64(1<<53 - 1)\n304|\n305|// messageBody is the exact message/reasoning-summary body: text only.\n306|type messageBody struct {\n307|\tText string\n308|}\n309|\n310|// decodeMessageBody validates the exact {\"text\"} body.\n311|func decodeMessageBody(record NativeRecord) (messageBody, error) {\n312|\tmembers, err := decodeBodyObject(record, []string{\"text\"}, map[string]bool{\"text\": true})\n313|\tif err != nil {\n314|\t\treturn messageBody{}, err\n315|\t}\n316|\ttext, err := bodyString(record, members, \"text\")\n317|\tif err != nil {\n318|\t\treturn messageBody{}, err\n319|\t}\n320|\treturn messageBody{Text: text}, nil\n321|}\n322|\n323|// protectedBody is the exact protected-reasoning body: ciphertext\n324|// the projection never reads, only preserves byte-exact.\n325|type protectedBody struct {\n326|\tCiphertext string\n327|}\n328|\n329|// decodeProtectedBody validates the exact {\"ciphertext\"} body. The\n330|// value is framing-checked as a string and never interpreted.\n331|func decodeProtectedBody(record NativeRecord) (protectedBody, error) {\n332|\tmembers, err := decodeBodyObject(record, []string{\"ciphertext\"}, map[string]bool{\"ciphertext\": true})\n333|\tif err != nil {\n334|\t\treturn protectedBody{}, err\n335|\t}\n336|\tciphertext, err := bodyString(record, members, \"ciphertext\")\n337|\tif err != nil {\n338|\t\treturn protectedBody{}, err\n339|\t}\n340|\treturn protectedBody{Ciphertext: ciphertext}, nil\n341|}\n342|\n343|// instructionBody is the exact instruction-snapshot body.\n344|type instructionBody struct {\n345|\tAuthority  string\n346|\tDirectives []string\n347|}\n348|\n349|// decodeInstructionBody validates authority high|low and up to 1024\n350|// directives of 1..4096 characters each.\n351|func decodeInstructionBody(record NativeRecord) (instructionBody, error) {\n352|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n353|\tmembers, err := decodeBodyObject(record, []string{\"authority\", \"directives\"}, map[string]bool{\"authority\": true, \"directives\": true})\n354|\tif err != nil {\n355|\t\treturn instructionBody{}, err\n356|\t}\n357|\tauthority, err := bodyString(record, members, \"authority\")\n358|\tif err != nil {\n359|\t\treturn instructionBody{}, err\n360|\t}\n361|\tif authority != \"high\" && authority != \"low\" {\n362|\t\treturn instructionBody{}, invalid(\"%s body authority %q is outside high|low\", where, authority)\n363|\t}\n364|\tvar directives []string\n365|\tif err := json.Unmarshal(members[\"directives\"], &directives); err != nil {\n366|\t\treturn instructionBody{}, invalid(\"%s body member %q is not an array of strings\", where, \"directives\")\n367|\t}\n368|\tif len(directives) > 1024 {\n369|\t\treturn instructionBody{}, invalid(\"%s body carries %d directives, maximum is 1024\", where, len(directives))\n370|\t}\n371|\tfor index, directive := range directives {\n372|\t\tif environ.StringLength(directive) < 1 || environ.StringLength(directive) > 4096 {\n373|\t\t\treturn instructionBody{}, invalid(\"%s body directive[%d] is not a string[1..4096]\", where, index)\n374|\t\t}\n375|\t}\n376|\treturn instructionBody{Authority: authority, Directives: directives}, nil\n377|}\n378|\n379|// toolDefinitionBody is the exact tool-definition body.\n380|type toolDefinitionBody struct {\n381|\tToolName       string\n382|\tDefinitionHash string\n383|\tLiveClaim      bool\n384|}\n385|\n386|// decodeToolDefinitionBody validates the exact definition body. A\n387|// live_attestation claim is parsed so the live-surface gate can\n388|// refuse it: captured history can never self-promote.\n389|func decodeToolDefinitionBody(record NativeRecord) (toolDefinitionBody, error) {\n390|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n391|\tmembers, err := decodeBodyObject(record,\n392|\t\t[]string{\"tool_name\", \"definition_digest\"},\n393|\t\tmap[string]bool{\"tool_name\": true, \"definition_digest\": true, \"live_attestation\": true})\n394|\tif err != nil {\n395|\t\treturn toolDefinitionBody{}, err\n396|\t}\n397|\tname, err := bodyString(record, members, \"tool_name\")\n398|\tif err != nil {\n399|\t\treturn toolDefinitionBody{}, err\n400|\t}\n401|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n402|\t\treturn toolDefinitionBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n403|\t}\n404|\tdigest, err := bodyString(record, members, \"definition_digest\")\n405|\tif err != nil {\n406|\t\treturn toolDefinitionBody{}, err\n407|\t}\n408|\tlive, err := bodyOptionalBool(record, members, \"live_attestation\")\n409|\tif err != nil {\n410|\t\treturn toolDefinitionBody{}, err\n411|\t}\n412|\treturn toolDefinitionBody{ToolName: name, DefinitionHash: digest, LiveClaim: live}, nil\n413|}\n414|\n415|// toolCallBody is the exact tool-call body.\n416|type toolCallBody struct {\n417|\tCallID   string\n418|\tToolName string\n419|}\n420|\n421|// decodeToolCallBody validates the exact call body.\n422|func decodeToolCallBody(record NativeRecord) (toolCallBody, error) {\n423|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n424|\tmembers, err := decodeBodyObject(record,\n425|\t\t[]string{\"call_id\", \"tool_name\"},\n426|\t\tmap[string]bool{\"call_id\": true, \"tool_name\": true})\n427|\tif err != nil {\n428|\t\treturn toolCallBody{}, err\n429|\t}\n430|\tcallID, err := bodyString(record, members, \"call_id\")\n431|\tif err != nil {\n432|\t\treturn toolCallBody{}, err\n433|\t}\n434|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n435|\t\treturn toolCallBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n436|\t}\n437|\tname, err := bodyString(record, members, \"tool_name\")\n438|\tif err != nil {\n439|\t\treturn toolCallBody{}, err\n440|\t}\n441|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n442|\t\treturn toolCallBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n443|\t}\n444|\treturn toolCallBody{CallID: callID, ToolName: name}, nil\n445|}\n446|\n447|// toolResultBody is the exact tool-result body.\n448|type toolResultBody struct {\n449|\tCallID       string\n450|\tStatus       string\n451|\tLiveFollowup bool\n452|}\n453|\n454|// decodeToolResultBody validates the exact result body. A\n455|// live_followup claim is parsed so the resolution gate can refuse\n456|// it: captured history can never request a live action.\n457|func decodeToolResultBody(record NativeRecord) (toolResultBody, error) {\n458|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n459|\tmembers, err := decodeBodyObject(record,\n460|\t\t[]string{\"call_id\", \"status\"},\n461|\t\tmap[string]bool{\"call_id\": true, \"status\": true, \"live_followup\": true})\n462|\tif err != nil {\n463|\t\treturn toolResultBody{}, err\n464|\t}\n465|\tcallID, err := bodyString(record, members, \"call_id\")\n466|\tif err != nil {\n467|\t\treturn toolResultBody{}, err\n468|\t}\n469|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n470|\t\treturn toolResultBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n471|\t}\n472|\tstatus, err := bodyString(record, members, \"status\")\n473|\tif err != nil {\n474|\t\treturn toolResultBody{}, err\n475|\t}\n476|\tif status != \"ok\" && status != \"error\" {\n477|\t\treturn toolResultBody{}, invalid(\"%s body status %q is outside ok|error\", where, status)\n478|\t}\n479|\tfollowup, err := bodyOptionalBool(record, members, \"live_followup\")\n480|\tif err != nil {\n481|\t\treturn toolResultBody{}, err\n482|\t}\n483|\treturn toolResultBody{CallID: callID, Status: status, LiveFollowup: followup}, nil\n484|}\n485|\n486|// usageBody is the exact usage-report body.\n487|type usageBody struct {\n488|\tInputTokens  uint64\n489|\tOutputTokens uint64\n490|}\n491|\n492|// decodeUsageBody validates the exact token body.\n493|func decodeUsageBody(record NativeRecord) (usageBody, error) {\n494|\tmembers, err := decodeBodyObject(record,\n495|\t\t[]string{\"input_tokens\", \"output_tokens\"},\n496|\t\tmap[string]bool{\"input_tokens\": true, \"output_tokens\": true})\n497|\tif err != nil {\n498|\t\treturn usageBody{}, err\n499|\t}\n500|\tinput, err := bodyUint53(record, members, \"input_tokens\")\n501|\tif err != nil {\n502|\t\treturn usageBody{}, err\n503|\t}\n504|\toutput, err := bodyUint53(record, members, \"output_tokens\")\n505|\tif err != nil {\n506|\t\treturn usageBody{}, err\n507|\t}\n508|\treturn usageBody{InputTokens: input, OutputTokens: output}, nil\n509|}","final_result":true}}}
