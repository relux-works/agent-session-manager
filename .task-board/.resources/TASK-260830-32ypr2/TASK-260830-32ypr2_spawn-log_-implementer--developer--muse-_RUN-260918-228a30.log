{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca4b","stream":{"kind":"session","id":"01a0b368-b8fb-7503-b19c-2c040425ca00"},"sequence":896,"recorded_at":1780531400001787,"record_type":"event","durability":"durable","causation_id":"9c78dd5e-2606-42c8-9e04-207bbea54fed","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9c78dd5e-2606-42c8-9e04-207bbea54fed","run_stream":{"kind":"run","id":"9c78dd5e-2606-42c8-9e04-207bbea54fed"},"task_stream":{"kind":"task","id":"01a0b36d-6c93-77e2-a2e9-38c4c766b38d"},"task_id":"01a0b36d-6c93-77e2-a2e9-38c4c766b38d","event":{"kind":"output","task_id":"01a0b36d-6c93-77e2-a2e9-38c4c766b38d","chunk":"{\n  \"chunk_id\": \"exec-37-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport json, subprocess\\ndef show(rev, path):\\n    return subprocess.run(['git','show',f'{rev}:{path}'],capture_output=True,text=True,check=True).stdout\\nP='internal/traceability/ownership.v0.7.0.json'\\nhead=json.loads(show('HEAD',P)); old=json.loads(show('47294bb816429fa83e07e9889605201b35d7f045',P)); mine=json.load(open(P))\\nMY_CASES=['clone-capture-contracts','clone-native-capture','clone-projection-fidelity','session-adapter-call-binding']\\ndef cases(d): return {c['id']:c for c in d['acceptance_cases']}\\ndef bindings(d):\\n    out={}\\n    for b in d['ownership']:\\n        if b.get('kind')=='section_binding':\\n            for k in b.get('keys',[]):\\n                if k.startswith('section:'): out[k]=b\\n    return out\\nhc,oc,mc=cases(head),cases(old),cases(mine)\\nhb,ob,mb=bindings(head),bindings(old),bindings(mine)\\n# 1. my cases absent from head and old, present in mine\\nfor i in MY_CASES:\\n    assert i not in hc and i not in oc and i in mc, i\\n# 2. head's 7.8/10.2 equal old's (trunk untouched) and differ from mine\\nfor s in ['section:7.8','section:10.2']:\\n    assert hb[s]==ob[s], f'trunk touched {s}'\\n    assert mb[s]!=ob[s], f'mine same as old for {s}'\\n# 3. merge\\nnew=dict(head); new['acceptance_cases']=list(head['acceptance_cases'])+[mc[i] for i in MY_CASES]\\nnewown=[]\\nfor b in head['ownership']:\\n    if b.get('kind')=='section_binding':\\n        for k in b.get('keys',[]):\\n            if k in ('section:7.8','section:10.2'):\\n                b=mb[k]; break\\n    newown.append(b)\\nnew['ownership']=newown\\n# 4. verify counts\\nnh,nb=bindings(new),cases(new)\\nassert len(new['acceptance_cases'])==len(head['acceptance_cases'])+4, (len(new['acceptance_cases']),len(head['acceptance_cases']))\\nassert nh['section:7.8']['coverage']=='full' and len(nh['section:7.8']['clauses'])==2\\nassert nh['section:10.2']['coverage']=='full' and len(nh['section:10.2']['clauses'])==5\\nassert len(nh['section:11.2']['clauses'])==len(hb['section:11.2'].get('clauses',[])) or True\\nopen(P,'w').write(json.dumps(new,indent=2)+'\\\\n')\\nprint('merged cases:', len(new['acceptance_cases']))\\nprint('7.8:', nh['section:7.8']['coverage'], [c['id'] for c in nh['section:7.8']['clauses']])\\nprint('10.2:', nh['section:10.2']['coverage'], [c['id'] for c in nh['section:10.2']['clauses']])\\nprint('11.2 kept:', hb['section:11.2']['coverage'], '==', nh['section:11.2']['coverage'])\\nprint('17.4 kept:', hb['section:17.4']['coverage'], '==', nh['section:17.4']['coverage'])\\nEOF\\ngit diff --stat -- internal/traceability/ownership.v0.7.0.json\",\n  \"description\": \"Merge registry rows onto HEAD bytes\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"merged cases: 144\\n7.8: full ['7.8#1', '7.8#2']\\n10.2: full ['10.2#1', '10.2#2', '10.2#3', '10.2#4', '10.2#5']\\n11.2 kept: partial == partial\\n17.4 kept: sliver == sliver\\n internal/traceability/ownership.v0.7.0.json | 193 +++++++++++++++++++++++++---\\n 1 file changed, 176 insertions(+), 17 deletions(-)\\n\",\n  \"original_output_bytes\": 299,\n  \"original_output_tokens\": 75,\n  \"truncated\": false\n}","final_result":true}}}
