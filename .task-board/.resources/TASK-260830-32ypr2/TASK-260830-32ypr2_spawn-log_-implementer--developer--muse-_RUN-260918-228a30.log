\\", err, fragment)\\n\\t\\t}\\n\\t}\\n\\tmessage := func(id, body string) string {\\n\\t\\treturn rec(id, \\\"message/user\\\", \\\"native\\\", \\\"none\\\", \\\"main\\\", body)\\n\\t}\\n\\tcall := func(id, body string) string {\\n\\t\\treturn rec(\\\"evt-\\\"+id, \\\"tool/call\\\", \\\"native\\\", \\\"none\\\", \\\"main\\\", body)\\n\\t}\\n\\n\\tt.Run(\\\"malformed_json_line\\\", func(t *testing.T) {\\n\\t\\trefuseMembers(t, []fixtureMember{\\n\\t\\t\\t{key: \\\"store/session.jsonl\\\", class: \\\"durable_payload\\\", content: []byte(\\\"{not-json\\\\n\\\")},\\n\\t\\t}, \\\"is not a JSON object\\\")\\n\\t})\\n\\tt.Run(\\\"missing_envelope_member\\\", func(t *testing.T) {\\n\\t\\trefuseMembers(t, []fixtureMember{\\n\\t\\t\\t{key: \\\"store/session.jsonl\\\", class: \\\"durable_payload\\\", content: jsonl(\\n...\\n151:\\tt.Run(\\\"malformed_json_line\\\", func(t *testing.T) {\\n156:\\tt.Run(\\\"missing_envelope_member\\\", func(t *testing.T) {\\n163:\\tt.Run(\\\"bad_envelope_version\\\", func(t *testing.T) {\\n170:\\tt.Run(\\\"bad_origin\\\", func(t *testing.T) {\\n177:\\tt.Run(\\\"bad_protection\\\", func(t *testing.T) {\\n184:\\tt.Run(\\\"bad_actor_shape\\\", func(t *testing.T) {\\n191:\\tt.Run(\\\"long_subagent_name\\\", func(t *testing.T) {\\n198:\\tt.Run(\\\"too_many_directives\\\", func(t *testing.T) {\\n207:\\tt.Run(\\\"usage_ledger_overflow\\\", func(t *testing.T) {\\n215:\\tt.Run(\\\"bad_actor_uuid\\\", func(t *testing.T) {\\n=== count subtests ===\\n33\\n    --- PASS: TestNormalizeRefusalTable/malformed_json_line (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/missing_envelope_member (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/bad_envelope_version (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/bad_origin (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/bad_protection (0.11s)\\n    --- PASS: TestNormalizeRefusalTable/bad_actor_shape (0.11s)\\n    --- PASS: TestNormalizeRefusalTable/long_subagent_name (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/too_many_directives (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/usage_ledger_overflow (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/bad_actor_uuid (0.11s)\\n    --- PASS: TestNormalizeRefusalTable/blank_line (0.11s)\\n    --- PASS: TestNormalizeRefusalTable/unknown_body_member (0.11s)\\n    --- PASS: TestNormalizeRefusalTable/contradictory_protection (0.16s)\\n    --- PASS: TestNormalizeRefusalTable/protected_plaintext_body (0.20s)\\n    --- PASS: TestNormalizeRefusalTable/live_attestation_claim (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/live_followup_claim (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/duplicate_call_id (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/duplicate_result_id (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/bad_instruction_authority (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/fractional_usage (0.25s)\\n    --- PASS: TestNormalizeRefusalTable/unsafe_usage_magnitude (0.16s)\\n    --- PASS: TestNormalizeRefusalTable/bad_definition_digest (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/unmapped_actor (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/invalid_utf8_line (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/empty_projection (0.11s)\\n    --- PASS: TestNormalizeRefusalTable/tampered_blob (0.12s)\\n    --- PASS: TestNormalizeRefusalTable/missing_blob (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/manifest_closure_drift (0.21s)\\n    --- PASS: TestNormalizeRefusalTable/unmapped_extra_actor (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/main_actor_in_map (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/missing_fetcher (0.14s)\\n    --- PASS: TestNormalizeRefusalTable/missing_sink (0.13s)\\n    --- PASS: TestNormalizeRefusalTable/bad_logical_session (0.12s)\\n\",\n  \"original_output_bytes\": 4104,\n  \"original_output_tokens\": 1026,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
