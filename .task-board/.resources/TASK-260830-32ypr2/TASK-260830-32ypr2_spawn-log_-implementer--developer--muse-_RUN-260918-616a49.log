{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d397","stream":{"kind":"session","id":"01a0b48a-1840-7d93-9d43-f2decee529f8"},"sequence":2086,"recorded_at":1780531400004167,"record_type":"event","durability":"durable","causation_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","run_stream":{"kind":"run","id":"cc2eb299-8bb3-4a28-9487-6d4564236d15"},"task_stream":{"kind":"task","id":"01a0b494-aa9b-7270-80ce-88faa5e09571"},"task_id":"01a0b494-aa9b-7270-80ce-88faa5e09571","event":{"kind":"output","task_id":"01a0b494-aa9b-7270-80ce-88faa5e09571","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/refusal_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/clonesnap\"\n10|)\n11|\n12|// Negative tests: every refusal below drives the production\n13|// Normalize entry and fails when the gate admits what it must\n14|// reject. Each row names the offending input and the refusal\n15|// fragment the gate must emit.\n16|\n17|func TestNormalizeRefusesUnstableCapture(t *testing.T) {\n18|\tmembers := []fixtureMember{\n19|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n20|\t\t\trec(\"evt-u-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"unstable\"}`),\n21|\t\t)},\n22|\t}\n23|\troot := writeFixtureStore(t, members)\n24|\tstore := openTestStore(t)\n25|\trequest := validCaptureRequest(t, root, store, members)\n26|\trequest.OnRace = clonesnap.RaceArchive\n27|\trequest.OperatorExplicit = true\n28|\trequest.Hooks.AfterWalk = func(storeRoot string) error {\n29|\t\treturn writeStoreFile(storeRoot, \"store/session.jsonl\", jsonl(\n30|\t\t\trec(\"evt-u-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"mutated\"}`),\n31|\t\t))\n32|\t}\n33|\tcapture, err := clonesnap.Capture(request)\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"Capture() error = %v\", err)\n36|\t}\n37|\tif capture.BoundaryKind != \"unstable_archive\" {\n38|\t\tt.Fatalf(\"BoundaryKind = %q, want unstable_archive\", capture.BoundaryKind)\n39|\t}\n40|\t_, err = Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n41|\tif err == nil {\n42|\t\tt.Fatal(\"Normalize() admitted an unstable_archive capture to target projection\")\n43|\t}\n44|\tif !errors.Is(err, ErrInvalid) && !strings.Contains(err.Error(), \"cannot enter a target branch\") {\n45|\t\tt.Fatalf(\"Normalize() error = %v, want the target-branch refusal\", err)\n46|\t}\n47|}\n48|\n49|func TestNormalizeRefusesEnvironmentDrift(t *testing.T) {\n50|\t// Both manifests seal clean and the ID link holds, but the\n51|\t// sealed environments differ: the evidence environment would be\n52|\t// ambiguous, so projection refuses. The real capture entry\n53|\t// cannot produce this pair (one tuple seals both sides), so the\n54|\t// test builds it through the landed builders instead.\n55|\tenvA := fixtureTupleJSON()\n56|\tenvB := `{\"environment_id\":\"project.evw\",\"environment_version\":\"3.0.1\",\"platform\":\"linux\",\"architecture\":\"arm64\",\"store_schema_fingerprint\":` +\n57|\t\t`\"` + fixtureDigest(\"project-store-fingerprint\") + `\",\"adapter_version\":\"2.0.0\"}`\n58|\tidentity := fixtureNativeIdentity(t)\n59|\tidentityDigest, err := clonebundle.IdentityDigest(identity, nil)\n60|\tif err != nil {\n61|\t\tt.Fatalf(\"IdentityDigest() error = %v\", err)\n62|\t}\n63|\trawBytes, err := clonebundle.BuildRawObjectManifest(\n64|\t\tfixtureOperationID, []byte(envA), \"native-session-project\",\n65|\t\tidentityDigest.String(), fixtureDigest(\"project-capture-plan\"), nil, nil)\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"BuildRawObjectManifest() error = %v\", err)\n68|\t}\n69|\traw, err := clonebundle.DecodeRawObjectManifest(rawBytes)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"DecodeRawObjectManifest() error = %v\", err)\n72|\t}\n73|\tpre := fixtureDigest(\"drift-pre\")\n74|\tcaptureBytes, err := clonebundle.BuildCaptureManifest(clonebundle.CaptureManifestInput{\n75|\t\tOperationID: fixtureOperationID,\n76|\t\tBundleID:    fixtureBundleID,\n77|\t\tSourceBasis: clonebundle.SourceBasisInput{\n78|\t\t\tKind:                     \"ax_session\",\n79|\t\t\tSourceSessionID:          fixtureSessionID,\n80|\t\t\tSourceSessionRecordID:    fixtureDigest(\"project-session-record\"),\n81|\t\t\tSourceCheckpointID:       fixtureDigest(\"project-checkpoint\"),\n82|\t\t\tSourceProviderIdentityID: fixtureDigest(\"project-provider-identity\"),\n83|\t\t},\n84|\t\tSourceEnvironment: []byte(envB),\n85|\t\tSourceIdentity:    identity,\n86|\t\tCapturePlanDigest: fixtureDigest(\"project-capture-plan\"),\n87|\t\tBoundary: clonebundle.BoundaryInput{\n88|\t\t\tKind:              \"stable\",\n89|\t\t\tProofKind:         \"closed_store\",\n90|\t\t\tGeneration:        \"generation-11\",\n91|\t\t\tPreCaptureDigest:  pre,\n92|\t\t\tPostCaptureDigest: pre,\n93|\t\t\tInputBlocked:      true,\n94|\t\t\tForegroundIdle:    true,\n95|\t\t\tBackgroundIdle:    true,\n96|\t\t},\n97|\t\tSourceRawManifestID: raw.ManifestID.String(),\n98|\t\tCreatedByHostID:     fixtureHostID,\n99|\t\tCreatedAt:           fixtureCreatedAt,\n100|\t})\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"BuildCaptureManifest() error = %v\", err)\n103|\t}\n104|\t_, probeStore := captureMembers(t, []fixtureMember{\n105|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n106|\t\t\trec(\"evt-drift-ws\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`),\n107|\t\t)},\n108|\t})\n109|\trequest := NormalizeRequest{\n110|\t\tCaptureManifest:  captureBytes,\n111|\t\tRawManifest:      rawBytes,\n112|\t\tFetch:            storeFetch(t, probeStore),\n113|\t\tCanonicalSink:    openTestStore(t),\n114|\t\tLogicalSessionID: fixtureLogicalID,\n115|\t\tMainActorID:      fixtureMainActor,\n116|\t\tWorkspace:        mustWorkspaceBytes(t),\n117|\t}\n118|\t_, err = Normalize(request)\n119|\tif err == nil {\n120|\t\tt.Fatal(\"Normalize() admitted a capture whose sealed environments drift\")\n121|\t}\n122|\tif !strings.Contains(err.Error(), \"source_environment disagree\") {\n123|\t\tt.Fatalf(\"Normalize() error = %v, want the closure-drift refusal\", err)\n124|\t}\n125|}\n126|\n127|func TestNormalizeRefusalTable(t *testing.T) {\n128|\t// refuseMembers projects members that must refuse and asserts\n129|\t// the refusal fragment.\n130|\trefuseMembers := func(t *testing.T, members []fixtureMember, fragment string) {\n131|\t\tt.Helper()\n132|\t\tcapture, store := captureMembers(t, members)\n133|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n134|\t\tif err == nil {\n135|\t\t\tt.Fatalf(\"Normalize() admitted members that must refuse with %q\", fragment)\n136|\t\t}\n137|\t\tif !errors.Is(err, ErrInvalid) && !strings.Contains(err.Error(), fragment) {\n138|\t\t\tt.Fatalf(\"Normalize() error = %v, want fragment %q\", err, fragment)\n139|\t\t}\n140|\t\tif !strings.Contains(err.Error(), fragment) {\n141|\t\t\tt.Fatalf(\"Normalize() error = %v, want fragment %q\", err, fragment)\n142|\t\t}\n143|\t}\n144|\tmessage := func(id, body string) string {\n145|\t\treturn rec(id, \"message/user\", \"native\", \"none\", \"main\", body)\n146|\t}\n147|\tcall := func(id, body string) string {\n148|\t\treturn rec(\"evt-\"+id, \"tool/call\", \"native\", \"none\", \"main\", body)\n149|\t}\n150|\n(more lines below)","final_result":true}}}
