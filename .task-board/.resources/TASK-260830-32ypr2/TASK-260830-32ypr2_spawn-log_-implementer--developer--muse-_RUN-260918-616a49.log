{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2cd","stream":{"kind":"session","id":"01a0b48a-1840-7d93-9d43-f2decee529f8"},"sequence":1985,"recorded_at":1780531400003965,"record_type":"event","durability":"durable","causation_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","run_stream":{"kind":"run","id":"cc2eb299-8bb3-4a28-9487-6d4564236d15"},"task_stream":{"kind":"task","id":"01a0b494-6ffc-7ce1-889b-3f92e61c55a1"},"task_id":"01a0b494-6ffc-7ce1-889b-3f92e61c55a1","event":{"kind":"output","task_id":"01a0b494-6ffc-7ce1-889b-3f92e61c55a1","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/native.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"unicode/utf8\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|)\n12|\n13|// This file parses the fixture-native record envelope. The envelope\n14|// is test-defined framing, not a specification shape: its only job\n15|// is to carry attributable bytes (native ID, native type, origin,\n16|// protection, actor, body) from captured members to the projection.\n17|// Every per-kind body shape below is exact: unknown body members\n18|// refuse rather than silently drop, so a projection can never claim\n19|// a faithful kind while ignoring a fact it does not understand. Type\n20|// level unknowns become opaque_event; field level unknowns inside a\n21|// known type refuse (see doc.go).\n22|\n23|// NativeRecord is one parsed fixture-native record with its byte\n24|// range inside the member blob.\n25|type NativeRecord struct {\n26|\t// MemberKey is the capture native item key holding the record.\n27|\tMemberKey string\n28|\t// Line is the one-based line number inside the member.\n29|\tLine int\n30|\t// Offset and Length are the record's byte range: the line\n31|\t// without its newline terminator.\n32|\tOffset uint64\n33|\tLength uint64\n34|\t// NativeEventID and NativeType attribute the record.\n35|\tNativeEventID string\n36|\tNativeType    string\n37|\t// Origin is native or foreign.\n38|\tOrigin string\n39|\t// Protection is none, encrypted, or signed.\n40|\tProtection string\n41|\t// Actor is main, external, or subagent:<name>.\n42|\tActor string\n43|\t// Body carries the raw body value; kind code reads only its\n44|\t// registered members.\n45|\tBody json.RawMessage\n46|\t// LineBytes are the exact record bytes preserved for opaque kinds.\n47|\tLineBytes []byte\n48|}\n49|\n50|// nativeEnvelope is the decoded envelope shape. Its members are\n51|// filled from the strict map by exact name (see parseNativeLine),\n52|// never through struct decoding: Body stays raw and each known\n53|// type validates its own exact members. The version member is read\n54|// through the landed uint53 gate, never through a lenient number\n55|// field: a string-typed version is not version 1.\n56|type nativeEnvelope struct {\n57|\tNativeEventID string          `json:\"native_event_id\"`\n58|\tNativeType    string          `json:\"native_type\"`\n59|\tOrigin        string          `json:\"origin\"`\n60|\tProtection    string          `json:\"protection\"`\n61|\tActor         string          `json:\"actor\"`\n62|\tBody          json.RawMessage `json:\"body\"`\n63|}\n64|\n65|// strictMembers decodes one strict JSON object through the landed\n66|// environ gate: non-UTF-8 bytes, lone surrogate escapes, duplicate\n67|// members, non-object top levels, and trailing data refuse here,\n68|// before any member is read, so no decoded value can carry\n69|// rewritten text or a guessed last-wins member. Both frame sites\n70|// (the record envelope and the per-kind bodies) pass through this\n71|// gate, and every later read takes its value from the admitted map\n72|// by exact member name: no second decoder re-reads the line, so a\n73|// case-folded alias (\"NATIVE_TYPE\", \"Origin\", ...) is an unclaimed\n74|// extra that can never override a claimed value. The rewriting and\n75|// guessing shapes never reach the readers.\n76|func strictMembers(what string, raw []byte) (map[string]json.RawMessage, error) {\n77|\tmembers, fault := environ.DecodeStrictObject(raw)\n78|\tif fault == nil {\n79|\t\treturn members, nil\n80|\t}\n81|\tif fault.Detail == environ.FaultNotObject {\n82|\t\treturn nil, invalid(\"%s is not a JSON object: %v\", what, fault)\n83|\t}\n84|\treturn nil, invalid(\"%s is not a strict JSON object: %v\", what, fault)\n85|}\n86|\n87|// parseNativeLine parses one record line. A line that is not valid\n88|// UTF-8, not a strict JSON object (lone surrogate escape,\n89|// duplicate member, trailing data), or misses an envelope member\n90|// refuses with the member and line named: malformed framing is an\n91|// error, never an absent or guessed record.\n92|func parseNativeLine(memberKey string, line int, offset uint64, raw []byte) (NativeRecord, error) {\n93|\twhere := func() string {\n94|\t\treturn \"record \" + memberKey + \" line \" + itoa(line)\n95|\t}\n96|\tif !utf8.Valid(raw) {\n97|\t\treturn NativeRecord{}, invalid(\"%s is not valid UTF-8\", where())\n98|\t}\n99|\tmembers, err := strictMembers(where(), raw)\n100|\tif err != nil {\n101|\t\treturn NativeRecord{}, err\n102|\t}\n103|\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\n104|\t\tif _, ok := members[name]; !ok {\n105|\t\t\treturn NativeRecord{}, invalid(\"%s misses envelope member %q\", where(), name)\n106|\t\t}\n107|\t}\n108|\tvar envelope nativeEnvelope\n109|\t// Strict-map envelope: every claimed member is read from the\n110|\t// admitted map by its exact name. No second decoder re-reads\n111|\t// the line, so a case-folded alias (\"NATIVE_TYPE\", \"Origin\",\n112|\t// \"Protection\", \"Body\", \"Native_Event_Id\", \"Actor\") stays an\n113|\t// unclaimed extra and can never override a claimed value,\n114|\t// whatever its document order.\n115|\tfor _, field := range []struct {\n116|\t\tname   string\n117|\t\ttarget *string\n118|\t}{\n119|\t\t{\"native_event_id\", &envelope.NativeEventID},\n120|\t\t{\"native_type\", &envelope.NativeType},\n121|\t\t{\"origin\", &envelope.Origin},\n122|\t\t{\"protection\", &envelope.Protection},\n123|\t\t{\"actor\", &envelope.Actor},\n124|\t} {\n125|\t\tif err := json.Unmarshal(members[field.name], field.target); err != nil {\n126|\t\t\treturn NativeRecord{}, invalid(\"%s envelope member %q is not a string\", where(), field.name)\n127|\t\t}\n128|\t}\n129|\tenvelope.Body = members[\"body\"]\n130|\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok {\n131|\t\treturn NativeRecord{}, invalid(\"%s carries envelope version %q, want 1\", where(), string(members[\"v\"]))\n132|\t}\n133|\tif environ.StringLength(envelope.NativeEventID) < 1 || environ.StringLength(envelope.NativeEventID) > 512 {\n134|\t\treturn NativeRecord{}, invalid(\"%s native_event_id is not a string[1..512]\", where())\n135|\t}\n136|\tif environ.StringLength(envelope.NativeType) < 1 || environ.StringLength(envelope.NativeType) > 512 {\n137|\t\treturn NativeRecord{}, invalid(\"%s native_type is not a string[1..512]\", where())\n138|\t}\n139|\tif envelope.Origin != \"native\" && envelope.Origin != \"foreign\" {\n140|\t\treturn NativeRecord{}, invalid(\"%s origin %q is outside native|foreign\", where(), envelope.Origin)\n141|\t}\n142|\tif envelope.Protection != \"none\" && envelope.Protection != \"encrypted\" && envelope.Protection != \"signed\" {\n143|\t\treturn NativeRecord{}, invalid(\"%s protection %q is outside none|encrypted|signed\", where(), envelope.Protection)\n144|\t}\n145|\tif err := checkActorSelector(envelope.Actor); err != nil {\n146|\t\treturn NativeRecord{}, invalid(\"%s %v\", where(), err)\n147|\t}\n148|\treturn NativeRecord{\n149|\t\tMemberKey:     memberKey,\n150|\t\tLine:          line,\n151|\t\tOffset:        offset,\n152|\t\tLength:        uint64(len(raw)),\n153|\t\tNativeEventID: envelope.NativeEventID,\n154|\t\tNativeType:    envelope.NativeType,\n155|\t\tOrigin:        envelope.Origin,\n156|\t\tProtection:    envelope.Protection,\n157|\t\tActor:         envelope.Actor,\n158|\t\tBody:          envelope.Body,\n159|\t\tLineBytes:     append([]byte(nil), raw...),\n160|\t}, nil\n161|}\n162|\n163|// checkActorSelector validates main, external, or subagent:<name>\n164|// with a bounded non-empty name.\n165|func checkActorSelector(selector string) error {\n166|\tif selector == \"main\" || selector == \"external\" {\n167|\t\treturn nil\n168|\t}\n169|\tname, ok := strings.CutPrefix(selector, \"subagent:\")\n170|\tif !ok || name == \"\" {\n171|\t\treturn invalid(\"actor %q is outside main|external|subagent:<name>\", selector)\n172|\t}\n173|\tif environ.StringLength(name) > 128 {\n174|\t\treturn invalid(\"actor %q names a subagent past 128 characters\", selector)\n175|\t}\n176|\treturn nil\n177|}\n178|\n179|// splitRecordLines splits member bytes into record lines with byte\n180|// offsets. A zero-byte member holds zero records; otherwise one\n181|// trailing newline is the terminator and every remaining line must\n182|// be non-empty: a blank line is malformed framing, never an absent\n183|// record.\n184|func splitRecordLines(memberKey string, payload []byte) ([]recordLine, error) {\n185|\tif len(payload) == 0 {\n186|\t\treturn nil, nil\n187|\t}\n188|\trest := payload\n189|\tif rest[len(rest)-1] == '\\n' {\n190|\t\trest = rest[:len(rest)-1]\n191|\t}\n192|\tvar lines []recordLine\n193|\toffset := uint64(0)\n194|\tnumber := 1\n195|\tfor {\n196|\t\tend := bytes.IndexByte(rest, '\\n')\n197|\t\tvar raw []byte\n198|\t\tif end < 0 {\n199|\t\t\traw = rest\n200|\t\t\trest = nil\n201|\t\t} else {\n202|\t\t\traw = rest[:end]\n203|\t\t\trest = rest[end+1:]\n204|\t\t}\n205|\t\tif len(raw) == 0 {\n206|\t\t\treturn nil, invalid(\"record %s line %d is empty\", memberKey, number)\n207|\t\t}\n208|\t\tlines = append(lines, recordLine{number: number, offset: offset, raw: raw})\n209|\t\toffset += uint64(len(raw)) + 1\n210|\t\tnumber++\n211|\t\tif rest == nil {\n212|\t\t\tbreak\n213|\t\t}\n214|\t}\n215|\treturn lines, nil\n216|}\n217|\n218|// recordLine is one split line with its number and byte offset.\n219|type recordLine struct {\n220|\tnumber int\n221|\toffset uint64\n222|\traw    []byte\n223|}\n224|\n225|// itoa renders a line number for refusal messages.\n226|func itoa(value int) string {\n227|\treturn strconv.Itoa(value)\n228|}\n229|\n230|// Known fixture-native types. Every other native_type projects as\n231|// opaque_event.\n232|const (\n233|\tnativeMessageUser      = \"message/user\"\n234|\tnativeMessageAssistant = \"message/assistant\"\n235|\tnativeReasoningSummary = \"reasoning/summary\"\n236|\tnativeReasoningCrypt   = \"reasoning/encrypted\"\n237|\tnativeReasoningSigned  = \"reasoning/signed\"\n238|\tnativeInstruction      = \"instruction/snapshot\"\n239|\tnativeToolDefinition   = \"tool/definition\"\n240|\tnativeToolCall         = \"tool/call\"\n241|\tnativeToolResult       = \"tool/result\"\n242|\tnativeUsage            = \"usage/report\"\n243|)\n244|\n245|// knownNativeType reports whether the native type selects a\n246|// registered projection. Unknown types become opaque_event.\n247|func knownNativeType(nativeType string) bool {\n248|\tswitch nativeType {\n249|\tcase nativeMessageUser,\n250|\t\tnativeMessageAssistant,\n251|\t\tnativeReasoningSummary,\n252|\t\tnativeReasoningCrypt,\n253|\t\tnativeReasoningSigned,\n254|\t\tnativeInstruction,\n255|\t\tnativeToolDefinition,\n256|\t\tnativeToolCall,\n257|\t\tnativeToolResult,\n258|\t\tnativeUsage:\n259|\t\treturn true\n260|\tdefault:\n261|\t\treturn false\n262|\t}\n263|}\n264|\n265|// decodeBodyObject decodes a body object with exact members: every\n266|// member must be registered for the type, and every required member\n267|// must be present. Unknown members refuse. The frame decode is the\n268|// landed strict gate, so a duplicated body member refuses instead\n269|// of guessing last-wins.\n270|func decodeBodyObject(record NativeRecord, required []string, allowed map[string]bool) (map[string]json.RawMessage, error) {\n271|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n272|\tmembers, err := strictMembers(where+\" body\", bytes.TrimSpace(record.Body))\n273|\tif err != nil {\n274|\t\treturn nil, err\n275|\t}\n276|\tfor name := range members {\n277|\t\tif !allowed[name] {\n278|\t\t\treturn nil, invalid(\"%s body carries unknown member %q\", where, name)\n279|\t\t}\n280|\t}\n281|\tfor _, name := range required {\n282|\t\tif _, ok := members[name]; !ok {\n283|\t\t\treturn nil, invalid(\"%s body misses member %q\", where, name)\n284|\t\t}\n285|\t}\n286|\treturn members, nil\n287|}\n288|\n289|// bodyString reads one required string body member.\n290|func bodyString(record NativeRecord, members map[string]json.RawMessage, name string) (string, error) {\n291|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n292|\tvar value string\n293|\tif err := json.Unmarshal(members[name], &value); err != nil {\n294|\t\treturn \"\", invalid(\"%s body member %q is not a string\", where, name)\n295|\t}\n296|\treturn value, nil\n297|}\n298|\n299|// bodyOptionalBool reads one optional boolean body member.\n300|func bodyOptionalBool(record NativeRecord, members map[string]json.RawMessage, name string) (bool, error) {\n301|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n302|\traw, ok := members[name]\n303|\tif !ok {\n304|\t\treturn false, nil\n305|\t}\n306|\tvar value bool\n307|\tif err := json.Unmarshal(raw, &value); err != nil {\n308|\t\treturn false, invalid(\"%s body member %q is not a boolean\", where, name)\n309|\t}\n310|\treturn value, nil\n311|}\n312|\n313|// bodyUint53 reads one required uint53 body member through the\n314|// landed environ gate: a JSON integer literal in [0..2^53-1],\n315|// never a fraction, exponent, sign, out-of-range magnitude, or\n316|// string. Every failure is one refusal: anything outside the type\n317|// is not a uint53.\n318|func bodyUint53(record NativeRecord, members map[string]json.RawMessage, name string) (uint64, error) {\n319|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n320|\tvalue, ok := environ.CheckUint53Bounds(members[name], 0, maxUint53)\n321|\tif !ok {\n322|\t\treturn 0, invalid(\"%s body member %q is not a uint53\", where, name)\n323|\t}\n324|\treturn value, nil\n325|}\n326|\n327|// maxUint53 is 2^53-1, the AX safe-integer ceiling.\n328|const maxUint53 = uint64(1<<53 - 1)\n329|\n330|// messageBody is the exact message/reasoning-summary body: text only.\n331|type messageBody struct {\n332|\tText string\n333|}\n334|\n335|// decodeMessageBody validates the exact {\"text\"} body.\n336|func decodeMessageBody(record NativeRecord) (messageBody, error) {\n337|\tmembers, err := decodeBodyObject(record, []string{\"text\"}, map[string]bool{\"text\": true})\n338|\tif err != nil {\n339|\t\treturn messageBody{}, err\n340|\t}\n341|\ttext, err := bodyString(record, members, \"text\")\n342|\tif err != nil {\n343|\t\treturn messageBody{}, err\n344|\t}\n345|\treturn messageBody{Text: text}, nil\n346|}\n347|\n348|// protectedBody is the exact protected-reasoning body: ciphertext\n349|// the projection never reads, only preserves byte-exact.\n350|type protectedBody struct {\n351|\tCiphertext string\n352|}\n353|\n354|// decodeProtectedBody validates the exact {\"ciphertext\"} body. The\n355|// value is framing-checked as a string and never interpreted.\n356|func decodeProtectedBody(record NativeRecord) (protectedBody, error) {\n357|\tmembers, err := decodeBodyObject(record, []string{\"ciphertext\"}, map[string]bool{\"ciphertext\": true})\n358|\tif err != nil {\n359|\t\treturn protectedBody{}, err\n360|\t}\n361|\tciphertext, err := bodyString(record, members, \"ciphertext\")\n362|\tif err != nil {\n363|\t\treturn protectedBody{}, err\n364|\t}\n365|\treturn protectedBody{Ciphertext: ciphertext}, nil\n366|}\n367|\n368|// instructionBody is the exact instruction-snapshot body.\n369|type instructionBody struct {\n370|\tAuthority  string\n371|\tDirectives []string\n372|}\n373|\n374|// decodeInstructionBody validates authority high|low and up to 1024\n375|// directives of 1..4096 characters each.\n376|func decodeInstructionBody(record NativeRecord) (instructionBody, error) {\n377|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n378|\tmembers, err := decodeBodyObject(record, []string{\"authority\", \"directives\"}, map[string]bool{\"authority\": true, \"directives\": true})\n379|\tif err != nil {\n380|\t\treturn instructionBody{}, err\n381|\t}\n382|\tauthority, err := bodyString(record, members, \"authority\")\n383|\tif err != nil {\n384|\t\treturn instructionBody{}, err\n385|\t}\n386|\tif authority != \"high\" && authority != \"low\" {\n387|\t\treturn instructionBody{}, invalid(\"%s body authority %q is outside high|low\", where, authority)\n388|\t}\n389|\tvar directives []string\n390|\tif err := json.Unmarshal(members[\"directives\"], &directives); err != nil {\n391|\t\treturn instructionBody{}, invalid(\"%s body member %q is not an array of strings\", where, \"directives\")\n392|\t}\n393|\tif len(directives) > 1024 {\n394|\t\treturn instructionBody{}, invalid(\"%s body carries %d directives, maximum is 1024\", where, len(directives))\n395|\t}\n396|\tfor index, directive := range directives {\n397|\t\tif environ.StringLength(directive) < 1 || environ.StringLength(directive) > 4096 {\n398|\t\t\treturn instructionBody{}, invalid(\"%s body directive[%d] is not a string[1..4096]\", where, index)\n399|\t\t}\n400|\t}\n401|\treturn instructionBody{Authority: authority, Directives: directives}, nil\n402|}\n403|\n404|// toolDefinitionBody is the exact tool-definition body.\n405|type toolDefinitionBody struct {\n406|\tToolName       string\n407|\tDefinitionHash string\n408|\tLiveClaim      bool\n409|}\n410|\n411|// decodeToolDefinitionBody validates the exact definition body. A\n412|// live_attestation claim is parsed so the live-surface gate can\n413|// refuse it: captured history can never self-promote.\n414|func decodeToolDefinitionBody(record NativeRecord) (toolDefinitionBody, error) {\n415|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n416|\tmembers, err := decodeBodyObject(record,\n417|\t\t[]string{\"tool_name\", \"definition_digest\"},\n418|\t\tmap[string]bool{\"tool_name\": true, \"definition_digest\": true, \"live_attestation\": true})\n419|\tif err != nil {\n420|\t\treturn toolDefinitionBody{}, err\n421|\t}\n422|\tname, err := bodyString(record, members, \"tool_name\")\n423|\tif err != nil {\n424|\t\treturn toolDefinitionBody{}, err\n425|\t}\n426|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n427|\t\treturn toolDefinitionBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n428|\t}\n429|\tdigest, err := bodyString(record, members, \"definition_digest\")\n430|\tif err != nil {\n431|\t\treturn toolDefinitionBody{}, err\n432|\t}\n433|\tlive, err := bodyOptionalBool(record, members, \"live_attestation\")\n434|\tif err != nil {\n435|\t\treturn toolDefinitionBody{}, err\n436|\t}\n437|\treturn toolDefinitionBody{ToolName: name, DefinitionHash: digest, LiveClaim: live}, nil\n438|}\n439|\n440|// toolCallBody is the exact tool-call body.\n441|type toolCallBody struct {\n442|\tCallID   string\n443|\tToolName string\n444|}\n445|\n446|// decodeToolCallBody validates the exact call body.\n447|func decodeToolCallBody(record NativeRecord) (toolCallBody, error) {\n448|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n449|\tmembers, err := decodeBodyObject(record,\n450|\t\t[]string{\"call_id\", \"tool_name\"},\n451|\t\tmap[string]bool{\"call_id\": true, \"tool_name\": true})\n452|\tif err != nil {\n453|\t\treturn toolCallBody{}, err\n454|\t}\n455|\tcallID, err := bodyString(record, members, \"call_id\")\n456|\tif err != nil {\n457|\t\treturn toolCallBody{}, err\n458|\t}\n459|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n460|\t\treturn toolCallBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n461|\t}\n462|\tname, err := bodyString(record, members, \"tool_name\")\n463|\tif err != nil {\n464|\t\treturn toolCallBody{}, err\n465|\t}\n466|\tif environ.StringLength(name) < 1 || environ.StringLength(name) > 512 {\n467|\t\treturn toolCallBody{}, invalid(\"%s body tool_name is not a string[1..512]\", where)\n468|\t}\n469|\treturn toolCallBody{CallID: callID, ToolName: name}, nil\n470|}\n471|\n472|// toolResultBody is the exact tool-result body.\n473|type toolResultBody struct {\n474|\tCallID       string\n475|\tStatus       string\n476|\tLiveFollowup bool\n477|}\n478|\n479|// decodeToolResultBody validates the exact result body. A\n480|// live_followup claim is parsed so the resolution gate can refuse\n481|// it: captured history can never request a live action.\n482|func decodeToolResultBody(record NativeRecord) (toolResultBody, error) {\n483|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n484|\tmembers, err := decodeBodyObject(record,\n485|\t\t[]string{\"call_id\", \"status\"},\n486|\t\tmap[string]bool{\"call_id\": true, \"status\": true, \"live_followup\": true})\n487|\tif err != nil {\n488|\t\treturn toolResultBody{}, err\n489|\t}\n490|\tcallID, err := bodyString(record, members, \"call_id\")\n491|\tif err != nil {\n492|\t\treturn toolResultBody{}, err\n493|\t}\n494|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n495|\t\treturn toolResultBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n496|\t}\n497|\tstatus, err := bodyString(record, members, \"status\")\n498|\tif err != nil {\n499|\t\treturn toolResultBody{}, err\n500|\t}\n(more lines below)","final_result":true}}}
