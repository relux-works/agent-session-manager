{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d337","stream":{"kind":"session","id":"01a0b48a-1840-7d93-9d43-f2decee529f8"},"sequence":2038,"recorded_at":1780531400004071,"record_type":"event","durability":"durable","causation_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","run_stream":{"kind":"run","id":"cc2eb299-8bb3-4a28-9487-6d4564236d15"},"call_id":"call_01a0b4948bbd779599497080cb6d55fe","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/fixtures_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"runtime\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/clonesnap\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|)\n19|\n20|// Shared fixtures for the cloneproject suite. Every projection proof\n21|// runs through the real path: a fixture provider store, the\n22|// predecessor's clonesnap.Capture entry, then Normalize over the\n23|// sealed manifests with blob bytes fetched from the real capture\n24|// store. Every literal is hand-written and independent of production\n25|// constants; digests are recomputed with crypto/sha256, never copied\n26|// from production.\n27|\n28|const (\n29|\tfixtureOperationID = \"0198f4d1-9e60-7a11-8a31-abcdef012345\"\n30|\tfixtureBundleID    = \"0198f4d1-9e60-7a22-8b42-bcdef0123456\"\n31|\tfixtureSessionID   = \"0198f4d1-9e60-7a33-8c53-cdef01234567\"\n32|\tfixtureHostID      = \"0198f4d1-9e60-7a44-8d64-def012345678\"\n33|\tfixtureWorkspaceID = \"0198f4d1-9e60-7a55-8e75-ef0123456789\"\n34|\tfixtureCreatedAt   = \"2026-09-18T11:05:00.000Z\"\n35|\tfixtureLogicalID   = \"0198f4d1-9e60-7a66-8f86-f0123456789a\"\n36|\tfixtureMainActor   = \"0198f4d1-9e60-7a77-8097-0123456789ab\"\n37|\tfixtureSubActor    = \"0198f4d1-9e60-7a88-81a8-123456789abc\"\n38|\tfixtureExtActor    = \"0198f4d1-9e60-7a99-82b9-23456789abcd\"\n39|)\n40|\n41|func fixtureDigest(seed string) string {\n42|\tsum := sha256.Sum256([]byte(seed))\n43|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n44|}\n45|\n46|func fixtureTupleJSON() string {\n47|\treturn `{\"environment_id\":\"project.env\",\"environment_version\":\"3.0.1\",\"platform\":\"linux\",\"architecture\":\"arm64\",\"store_schema_fingerprint\":` +\n48|\t\t`\"` + fixtureDigest(\"project-store-fingerprint\") + `\",\"adapter_version\":\"2.0.0\"}`\n49|}\n50|\n51|func fixtureNativeIdentity(t *testing.T) clonebundle.NativeIdentity {\n52|\tt.Helper()\n53|\tworkspace, err := scalar.ParseUUIDv7(fixtureWorkspaceID)\n54|\tif err != nil {\n55|\t\tt.Fatalf(\"ParseUUIDv7() error = %v\", err)\n56|\t}\n57|\treturn clonebundle.NativeIdentity{\n58|\t\tNativeSessionID:    \"native-session-project\",\n59|\t\tIdentityKind:       \"provider_native\",\n60|\t\tLogicalWorkspaceID: workspace,\n61|\t}\n62|}\n63|\n64|func fixturePlatform() scalar.Platform {\n65|\tif runtime.GOOS == \"darwin\" {\n66|\t\treturn scalar.PlatformMacOS\n67|\t}\n68|\tif runtime.GOOS == \"windows\" {\n69|\t\treturn scalar.PlatformWindows\n70|\t}\n71|\treturn scalar.PlatformLinux\n72|}\n73|\n74|func openTestStore(t *testing.T) *localstore.ObjectStore {\n75|\tt.Helper()\n76|\thome := t.TempDir()\n77|\tconfig := filepath.Join(home, \"config\")\n78|\tif err := os.Mkdir(config, 0o700); err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tresolved, err := localstore.ResolvePaths(localstore.ResolveRequest{\n82|\t\tPlatform: fixturePlatform(),\n83|\t\tFlags: map[string]string{\n84|\t\t\t\"--config\":      filepath.Join(home, \"config\", \"config.toml\"),\n85|\t\t\t\"--data-dir\":    filepath.Join(home, \"data\"),\n86|\t\t\t\"--state-dir\":   filepath.Join(home, \"state\"),\n87|\t\t\t\"--cache-dir\":   filepath.Join(home, \"cache\"),\n88|\t\t\t\"--runtime-dir\": filepath.Join(home, \"runtime\"),\n89|\t\t},\n90|\t\tEnvironment:  map[string]string{},\n91|\t\tHomeDir:      home,\n92|\t\tTemporaryDir: filepath.Join(home, \"temporary\"),\n93|\t})\n94|\tif err != nil {\n95|\t\tt.Fatal(err)\n96|\t}\n97|\tstore, err := localstore.OpenObjectStore(resolved)\n98|\tif err != nil {\n99|\t\tt.Fatalf(\"OpenObjectStore() error = %v\", err)\n100|\t}\n101|\treturn store\n102|}\n103|\n104|// errFixtureGone is the test fetch failure for the missing-blob row.\n105|var errFixtureGone = errGone(\"fixture blob removed\")\n106|\n107|type errGone string\n108|\n109|func (err errGone) Error() string { return string(err) }\n110|\n111|// writeStoreFile rewrites one store member (race injection).\n112|func writeStoreFile(root, key string, data []byte) error {\n113|\tpath := filepath.Join(root, filepath.FromSlash(key))\n114|\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n115|\t\treturn err\n116|\t}\n117|\treturn os.WriteFile(path, data, 0o600)\n118|}\n119|\n120|// fixtureMember is one provider store member: key, class, and bytes.\n121|type fixtureMember struct {\n122|\tkey     string\n123|\tclass   string\n124|\tcontent []byte\n125|}\n126|\n127|// writeFixtureStore builds a provider store holding exactly the\n128|// given members.\n129|func writeFixtureStore(t *testing.T, members []fixtureMember) string {\n130|\tt.Helper()\n131|\troot := t.TempDir()\n132|\tfor _, member := range members {\n133|\t\tpath := filepath.Join(root, filepath.FromSlash(member.key))\n134|\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n135|\t\t\tt.Fatal(err)\n136|\t\t}\n137|\t\tif err := os.WriteFile(path, []byte(member.content), 0o600); err != nil {\n138|\t\t\tt.Fatal(err)\n139|\t\t}\n140|\t}\n141|\treturn root\n142|}\n143|\n144|// fixtureWorkspace builds a real workspace tree and its checkpoint\n145|// request.\n146|func fixtureWorkspace(t *testing.T) clonesnap.WorkspaceRequest {\n147|\tt.Helper()\n148|\troot := t.TempDir()\n149|\tcwd := filepath.Join(root, \"work\", \"trees\", \"alpha\")\n150|\tif err := os.MkdirAll(cwd, 0o700); err != nil {\n151|\t\tt.Fatal(err)\n152|\t}\n153|\tbranch := \"main\"\n154|\thead := fixtureDigest(\"project-head\")\n155|\treturn clonesnap.WorkspaceRequest{\n156|\t\tLogicalWorkspaceID: fixtureWorkspaceID,\n157|\t\tWorkspaceRoot:      root,\n158|\t\tCwd:                cwd,\n159|\t\tRemoteFingerprints: []string{fixtureDigest(\"project-remote\")},\n160|\t\tBranch:             &branch,\n161|\t\tHeadDigest:         &head,\n162|\t\tPlatform:           fixturePlatform(),\n163|\t}\n164|}\n165|\n166|// validCaptureRequest builds a capture request over the fixture\n167|// store through the real predecessor entry.\n168|func validCaptureRequest(t *testing.T, storeRoot string, store *localstore.ObjectStore, members []fixtureMember) clonesnap.CaptureRequest {\n169|\tt.Helper()\n170|\tplan := make([]clonesnap.PlanItem, 0, len(members))\n171|\tfor _, member := range members {\n172|\t\tplan = append(plan, clonesnap.PlanItem{NativeKey: member.key, Class: member.class, Required: true})\n173|\t}\n174|\treturn clonesnap.CaptureRequest{\n175|\t\tStoreRoot:   storeRoot,\n176|\t\tPlatform:    fixturePlatform(),\n177|\t\tPlan:        plan,\n178|\t\tOperationID: fixtureOperationID,\n179|\t\tBundleID:    fixtureBundleID,\n180|\t\tSourceBasis: clonebundle.SourceBasisInput{\n181|\t\t\tKind:                     \"ax_session\",\n182|\t\t\tSourceSessionID:          fixtureSessionID,\n183|\t\t\tSourceSessionRecordID:    fixtureDigest(\"project-session-record\"),\n184|\t\t\tSourceCheckpointID:       fixtureDigest(\"project-checkpoint\"),\n185|\t\t\tSourceProviderIdentityID: fixtureDigest(\"project-provider-identity\"),\n186|\t\t},\n187|\t\tSourceEnvironment: []byte(fixtureTupleJSON()),\n188|\t\tSourceIdentity:    fixtureNativeIdentity(t),\n189|\t\tCapturePlanDigest: fixtureDigest(\"project-capture-plan\"),\n190|\t\tNativeSessionID:   \"native-session-project\",\n191|\t\tCreatedByHostID:   fixtureHostID,\n192|\t\tCreatedAt:         fixtureCreatedAt,\n193|\t\tGeneration:        \"generation-11\",\n194|\t\tProofKind:         \"closed_store\",\n195|\t\tInputBlocked:      true,\n196|\t\tForegroundIdle:    true,\n197|\t\tBackgroundIdle:    true,\n198|\t\tOnRace:            clonesnap.RaceRefuse,\n199|\t\tWorkspace:         fixtureWorkspace(t),\n200|\t\tStore:             store,\n201|\t}\n202|}\n203|\n204|// storeFetch returns a blob fetcher reading through the store's real\n205|// digest-to-path layout: the bytes Normalize sees are the bytes the\n206|// capture installed, addressed by content digest.\n207|func storeFetch(t *testing.T, store *localstore.ObjectStore) func(blobID string) ([]byte, error) {\n208|\tt.Helper()\n209|\tstyle := localstore.PathStylePOSIX\n210|\tif runtime.GOOS == \"windows\" {\n211|\t\tstyle = localstore.PathStyleWindows\n212|\t}\n213|\treturn func(blobID string) ([]byte, error) {\n214|\t\tdigest, err := scalar.ParseDigest(blobID)\n215|\t\tif err != nil {\n216|\t\t\treturn nil, err\n217|\t\t}\n218|\t\trelative, err := localstore.DigestPathV1(digest, style)\n219|\t\tif err != nil {\n220|\t\t\treturn nil, err\n221|\t\t}\n222|\t\treturn os.ReadFile(filepath.Join(store.DataRoot(), \"objects\", filepath.FromSlash(relative)))\n223|\t}\n224|}\n225|\n226|// normalizeRequest wires a Normalize request over a real capture\n227|// result: the sealed manifests, the capture store fetcher, a fresh\n228|// canonical sink, and the capture's workspace checkpoint.\n229|func normalizeRequest(t *testing.T, capture *clonesnap.CaptureResult, captureStore, canonicalSink *localstore.ObjectStore) NormalizeRequest {\n230|\tt.Helper()\n231|\treturn NormalizeRequest{\n232|\t\tCaptureManifest:  capture.CaptureManifest,\n233|\t\tRawManifest:      capture.RawManifest,\n234|\t\tFetch:            storeFetch(t, captureStore),\n235|\t\tCanonicalSink:    canonicalSink,\n236|\t\tLogicalSessionID: fixtureLogicalID,\n237|\t\tMainActorID:      fixtureMainActor,\n238|\t\tWorkspace:        capture.WorkspaceBinding,\n239|\t}\n240|}\n241|\n242|// captureMembers runs the real capture entry over the given members\n243|// and returns the result with its store.\n244|func captureMembers(t *testing.T, members []fixtureMember) (*clonesnap.CaptureResult, *localstore.ObjectStore) {\n245|\tt.Helper()\n246|\troot := writeFixtureStore(t, members)\n247|\tstore := openTestStore(t)\n248|\tresult, err := clonesnap.Capture(validCaptureRequest(t, root, store, members))\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"Capture() error = %v\", err)\n251|\t}\n252|\treturn result, store\n253|}\n254|\n255|// projectionBundle bundles one full real-path run: the capture result,\n256|// its store, the canonical sink, the member bytes, and the\n257|// normalized bundle.\n258|type projectionBundle struct {\n259|\tcapture *clonesnap.CaptureResult\n260|\tstore   *localstore.ObjectStore\n261|\tsink    *localstore.ObjectStore\n262|\tmembers []fixtureMember\n263|\tresult  *NormalizeResult\n264|}\n265|\n266|// projectMembers runs the full real path: capture, then Normalize\n267|// over the sealed manifests with a fresh canonical sink.\n268|func projectMembers(t *testing.T, members []fixtureMember) projectionBundle {\n269|\tt.Helper()\n270|\tcapture, store := captureMembers(t, members)\n271|\tsink := openTestStore(t)\n272|\tresult, err := Normalize(normalizeRequest(t, capture, store, sink))\n273|\tif err != nil {\n274|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n275|\t}\n276|\treturn projectionBundle{capture: capture, store: store, sink: sink, members: members, result: result}\n277|}\n278|\n279|// mustWorkspaceBytes captures one throwaway member and returns its\n280|// sealed workspace checkpoint for builder-constructed requests.\n281|func mustWorkspaceBytes(t *testing.T) []byte {\n282|\tt.Helper()\n283|\tcapture, _ := captureMembers(t, []fixtureMember{\n284|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n285|\t\t\trec(\"evt-ws\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`),\n286|\t\t)},\n287|\t})\n288|\treturn capture.WorkspaceBinding\n289|}\n290|\n291|// memberBytes returns the original bytes of one fixture member.\n292|func (bundle projectionBundle) memberBytes(t *testing.T, key string) []byte {\n293|\tt.Helper()\n294|\tfor _, member := range bundle.members {\n295|\t\tif member.key == key {\n296|\t\t\treturn member.content\n297|\t\t}\n298|\t}\n299|\tt.Fatalf(\"no fixture member %q\", key)\n300|\treturn nil\n301|}\n302|\n303|// rec builds one fixture-native record line.\n304|func rec(id, nativeType, origin, protection, actor, body string) string {\n305|\treturn `{\"v\":1,\"native_event_id\":\"` + id + `\",\"native_type\":\"` + nativeType + `\",\"origin\":\"` + origin +\n306|\t\t`\",\"protection\":\"` + protection + `\",\"actor\":\"` + actor + `\",\"body\":` + body + `}`\n307|}\n308|\n309|// jsonl joins record lines into member bytes with a trailing newline.\n310|func jsonl(lines ...string) []byte {\n311|\treturn []byte(strings.Join(lines, \"\\n\") + \"\\n\")\n312|}\n313|\n314|// eventByNativeID finds the decoded event carrying a native event ID.\n315|func eventByNativeID(t *testing.T, result *NormalizeResult, id string) clonebundle.CanonicalEvent {\n316|\tt.Helper()\n317|\tfor _, decoded := range result.DecodedEvents {\n318|\t\tif decoded.Evidence.NativeEventID != nil && *decoded.Evidence.NativeEventID == id {\n319|\t\t\treturn decoded\n320|\t\t}\n321|\t}\n322|\tt.Fatalf(\"no projected event carries native_event_id %q\", id)\n323|\treturn clonebundle.CanonicalEvent{}\n324|}\n325|\n326|// mustResolveRef proves a raw reference resolves through the real\n327|// path: the manifest ID names the sealed raw manifest, the\n328|// descriptor ID names its raw entry, the entry names the installed\n329|// blob, and the byte range slices back out exactly.\n330|func mustResolveRef(t *testing.T, capture *clonesnap.CaptureResult, store *localstore.ObjectStore, ref clonebundle.RawReference) []byte {\n331|\tt.Helper()\n332|\tif ref.ManifestID.String() != capture.Raw.ManifestID.String() {\n333|\t\tt.Fatalf(\"raw reference manifest %q names %q, want the sealed raw manifest %q\",\n334|\t\t\tref.ManifestID.String(), ref.ManifestID.String(), capture.Raw.ManifestID.String())\n335|\t}\n336|\tblobID := \"\"\n337|\tfor _, entry := range capture.Raw.Entries {\n338|\t\tif entry.BlobDescriptorID.String() == ref.BlobDescriptorID.String() {\n339|\t\t\tblobID = entry.BlobID.String()\n340|\t\t}\n341|\t}\n342|\tif blobID == \"\" {\n343|\t\tt.Fatalf(\"raw reference descriptor %q names no raw entry\", ref.BlobDescriptorID.String())\n344|\t}\n345|\tpayload, err := storeFetch(t, store)(blobID)\n346|\tif err != nil {\n347|\t\tt.Fatalf(\"fetch referenced blob %q: %v\", blobID, err)\n348|\t}\n349|\tif ref.Offset+ref.Length > uint64(len(payload)) {\n350|\t\tt.Fatalf(\"raw reference [%d:%d] exceeds blob of %d bytes\", ref.Offset, ref.Offset+ref.Length, len(payload))\n351|\t}\n352|\treturn payload[ref.Offset : ref.Offset+ref.Length]\n353|}\n354|\n355|// listStoreBlobs enumerates installed blob bytes for test-side\n356|// resolution.\n357|func listStoreBlobs(t *testing.T, store *localstore.ObjectStore) [][]byte {\n358|\tt.Helper()\n359|\tobjects := filepath.Join(store.DataRoot(), \"objects\")\n360|\tvar blobs [][]byte\n361|\terr := filepath.Walk(objects, func(path string, info os.FileInfo, err error) error {\n362|\t\tif err != nil {\n363|\t\t\tif os.IsNotExist(err) {\n364|\t\t\t\treturn nil\n365|\t\t\t}\n366|\t\t\treturn err\n367|\t\t}\n368|\t\tif info.IsDir() {\n369|\t\t\treturn nil\n370|\t\t}\n371|\t\traw, err := os.ReadFile(path)\n372|\t\tif err != nil {\n373|\t\t\tt.Fatalf(\"ReadFile(%q) error = %v\", path, err)\n374|\t\t}\n375|\t\tblobs = append(blobs, raw)\n376|\t\treturn nil\n377|\t})\n378|\tif err != nil {\n379|\t\tt.Fatalf(\"Walk(objects) error = %v\", err)\n380|\t}\n381|\treturn blobs\n382|}\n383|\n384|// mustResolveOverflow proves an overflow content reference resolves:\n385|// one installed sink blob carries descriptor bytes whose omit-self\n386|// identity is the referenced ID, and the descriptor's blob holds the\n387|// exact content bytes.\n388|func mustResolveOverflow(t *testing.T, sink *localstore.ObjectStore, descriptorID string) []byte {\n389|\tt.Helper()\n390|\tfor _, blob := range listStoreBlobs(t, sink) {\n391|\t\tcalculated, field, err := canonicaljson.CalculateObjectIdentity(blob)\n392|\t\tif err != nil || string(field) != \"descriptor_id\" {\n393|\t\t\tcontinue\n394|\t\t}\n395|\t\tif calculated.String() != descriptorID {\n396|\t\t\tcontinue\n397|\t\t}\n398|\t\tvar members map[string]json.RawMessage\n399|\t\tif err := json.Unmarshal(blob, &members); err != nil {\n400|\t\t\tt.Fatalf(\"Unmarshal(descriptor) error = %v\", err)\n401|\t\t}\n402|\t\tvar blobID string\n403|\t\tif err := json.Unmarshal(members[\"blob_id\"], &blobID); err != nil {\n404|\t\t\tt.Fatalf(\"Unmarshal(descriptor blob_id) error = %v\", err)\n405|\t\t}\n406|\t\tpayload, err := storeFetch(t, sink)(blobID)\n407|\t\tif err != nil {\n408|\t\t\tt.Fatalf(\"fetch overflow payload %q: %v\", blobID, err)\n409|\t\t}\n410|\t\treturn payload\n411|\t}\n412|\tt.Fatalf(\"overflow descriptor %q resolves to no installed descriptor\", descriptorID)\n413|\treturn nil\n414|}\n415|\n416|// payloadText extracts one string payload fact.\n417|func payloadText(t *testing.T, event clonebundle.CanonicalEvent, name string) string {\n418|\tt.Helper()\n419|\traw, ok := event.Payload[name]\n420|\tif !ok {\n421|\t\tt.Fatalf(\"event kind %q payload misses member %q\", event.Kind, name)\n422|\t}\n423|\ttext, ok := raw.(string)\n424|\tif !ok {\n425|\t\tt.Fatalf(\"event kind %q payload member %q is %T, want string\", event.Kind, name, raw)\n426|\t}\n427|\treturn text\n428|}\n429|\n430|// payloadInt extracts one integer payload fact.\n431|func payloadInt(t *testing.T, event clonebundle.CanonicalEvent, name string) int64 {\n432|\tt.Helper()\n433|\traw, ok := event.Payload[name]\n434|\tif !ok {\n435|\t\tt.Fatalf(\"event kind %q payload misses member %q\", event.Kind, name)\n436|\t}\n437|\tnumber, ok := raw.(int64)\n438|\tif !ok {\n439|\t\tt.Fatalf(\"event kind %q payload member %q is %T, want int64\", event.Kind, name, raw)\n440|\t}\n441|\treturn number\n442|}\n443|\n444|// payloadBool extracts one boolean payload fact.\n445|func payloadBool(t *testing.T, event clonebundle.CanonicalEvent, name string) bool {\n446|\tt.Helper()\n447|\traw, ok := event.Payload[name]\n448|\tif !ok {\n449|\t\tt.Fatalf(\"event kind %q payload misses member %q\", event.Kind, name)\n450|\t}\n451|\tvalue, ok := raw.(bool)\n452|\tif !ok {\n453|\t\tt.Fatalf(\"event kind %q payload member %q is %T, want bool\", event.Kind, name, raw)\n454|\t}\n455|\treturn value\n456|}\n457|\n458|// sealedPayload decodes the sealed event bytes to a member map for\n459|// absence assertions (the decoded form normalizes numbers).\n460|func sealedPayload(t *testing.T, sealed []byte) map[string]any {\n461|\tt.Helper()\n462|\tvar members map[string]json.RawMessage\n463|\tif err := json.Unmarshal(sealed, &members); err != nil {\n464|\t\tt.Fatalf(\"Unmarshal(sealed event) error = %v\", err)\n465|\t}\n466|\tvar payload map[string]any\n467|\tif err := json.Unmarshal(members[\"payload\"], &payload); err != nil {\n468|\t\tt.Fatalf(\"Unmarshal(sealed payload) error = %v\", err)\n469|\t}\n470|\treturn payload\n471|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
