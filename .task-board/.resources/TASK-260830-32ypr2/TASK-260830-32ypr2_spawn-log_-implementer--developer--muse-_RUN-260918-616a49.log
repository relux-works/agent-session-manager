{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d307","stream":{"kind":"session","id":"01a0b48a-1840-7d93-9d43-f2decee529f8"},"sequence":2014,"recorded_at":1780531400004023,"record_type":"event","durability":"durable","causation_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","run_stream":{"kind":"run","id":"cc2eb299-8bb3-4a28-9487-6d4564236d15"},"task_stream":{"kind":"task","id":"01a0b494-8194-7fa0-a7af-6916ba1812bc"},"task_id":"01a0b494-8194-7fa0-a7af-6916ba1812bc","event":{"kind":"output","task_id":"01a0b494-8194-7fa0-a7af-6916ba1812bc","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/native.go`.\n(499 line(s) above)\n500|\t}\n501|\tif status != \"ok\" && status != \"error\" {\n502|\t\treturn toolResultBody{}, invalid(\"%s body status %q is outside ok|error\", where, status)\n503|\t}\n504|\tfollowup, err := bodyOptionalBool(record, members, \"live_followup\")\n505|\tif err != nil {\n506|\t\treturn toolResultBody{}, err\n507|\t}\n508|\treturn toolResultBody{CallID: callID, Status: status, LiveFollowup: followup}, nil\n509|}\n510|\n511|// usageBody is the exact usage-report body.\n512|type usageBody struct {\n513|\tInputTokens  uint64\n514|\tOutputTokens uint64\n515|}\n516|\n517|// decodeUsageBody validates the exact token body.\n518|func decodeUsageBody(record NativeRecord) (usageBody, error) {\n519|\tmembers, err := decodeBodyObject(record,\n520|\t\t[]string{\"input_tokens\", \"output_tokens\"},\n521|\t\tmap[string]bool{\"input_tokens\": true, \"output_tokens\": true})\n522|\tif err != nil {\n523|\t\treturn usageBody{}, err\n524|\t}\n525|\tinput, err := bodyUint53(record, members, \"input_tokens\")\n526|\tif err != nil {\n527|\t\treturn usageBody{}, err\n528|\t}\n529|\toutput, err := bodyUint53(record, members, \"output_tokens\")\n530|\tif err != nil {\n531|\t\treturn usageBody{}, err\n532|\t}\n533|\treturn usageBody{InputTokens: input, OutputTokens: output}, nil\n534|}","final_result":true}}}
