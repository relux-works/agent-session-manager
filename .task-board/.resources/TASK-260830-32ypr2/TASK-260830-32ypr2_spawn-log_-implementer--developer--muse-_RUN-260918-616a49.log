t, event, \"protection\") != \"signed\" {\n67|\t\tt.Fatalf(\"payload protection = %q, want signed\", payloadText(t, event, \"protection\"))\n68|\t}\n69|\tsealed := sealedPayload(t, bundle.result.Events[0])\n70|\tfor _, forbidden := range []string{\"content_blocks\", \"content\", \"text\", \"ciphertext\", \"summary\"} {\n71|\t\tif _, present := sealed[forbidden]; present {\n72|\t\t\tt.Fatalf(\"sealed payload carries %q: decrypted, summarized, or re-encoded\", forbidden)\n73|\t\t}\n74|\t}\n75|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n76|\tif string(resolved) != line {\n77|\t\tt.Fatal(\"signed bytes did not survive the blob round trip byte-exact\")\n78|\t}\n79|}\n80|\n81|func TestNormalizeNativeProtectedReasoningStaysOpaque(t *testing.T) {\n82|\tline := rec(\"evt-enc-native\", \"reasoning/encrypted\", \"native\", \"encrypted\", \"main\", `{\"ciphertext\":\"NATIVE-SECRET\"}`)\n83|\tbundle := projectMembers(t, []fixtureMember{\n84|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n85|\t})\n86|\tevent := bundle.result.DecodedEvents[0]\n87|\tif event.Kind != \"opaque_reasoning\" {\n88|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n89|\t}\n90|\tif len(event.Evidence.ReasonCodes) != 0 {\n91|\t\tt.Fatalf(\"ReasonCodes = %q, want empty: no foreign core code fits native-protected content\", event.Evidence.ReasonCodes)\n92|\t}\n93|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n94|\tif string(resolved) != line {\n95|\t\tt.Fatal(\"native protected bytes did not survive byte-exact\")\n96|\t}\n97|}\n98|\n99|func TestNormalizeProtectedMessageBecomesOpaqueEvent(t *testing.T) {\n100|\tline := rec(\"evt-prot-msg\", \"message/assistant\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"HIDDEN\"}`)\n101|\tbundle := projectMembers(t, []fixtureMember{\n102|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n103|\t})\n104|\tevent := bundle.result.DecodedEvents[0]\n105|\tif event.Kind != \"opaque_event\" {\n106|\t\tt.Fatalf(\"Kind = %q, want opaque_event: protected content reached a semantic kind\", event.Kind)\n107|\t}\n108|\tif event.Visibility != \"opaque\" {\n109|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n110|\t}\n111|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"foreign_encrypted_payload\" {\n112|\t\tt.Fatalf(\"ReasonCodes = %q, want [foreign_encrypted_payload]\", event.Evidence.ReasonCodes)\n113|\t}\n114|\tif payloadText(t, event, \"protection\") != \"encrypted\" {\n115|\t\tt.Fatalf(\"payload protection = %q, want encrypted\", payloadText(t, event, \"protection\"))\n116|\t}\n117|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n118|\tif string(resolved) != line {\n119|\t\tt.Fatal(\"protected bytes did not survive byte-exact\")\n120|\t}\n121|}\n122|\n123|func TestNormalizeUnknownProtectedRecordCarriesBothReasons(t *testing.T) {\n124|\tline := rec(\"evt-prot-unknown\", \"frobnicate\", \"foreign\", \"signed\", \"main\", `{\"ciphertext\":\"HIDDEN\"}`)\n125|\tbundle := projectMembers(t, []fixtureMember{\n126|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n127|\t})\n128|\tevent := bundle.result.DecodedEvents[0]\n129|\tif event.Kind != \"opaque_event\" {\n130|\t\tt.Fatalf(\"Kind = %q, want opaque_event\", event.Kind)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
