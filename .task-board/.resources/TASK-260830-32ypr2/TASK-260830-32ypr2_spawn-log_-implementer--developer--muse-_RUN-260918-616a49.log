ontent: jsonl(\n435|\t\t\t\tmessage(\"evt-mainmap\", `{\"text\":\"x\"}`),\n436|\t\t\t)},\n437|\t\t})\n438|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n439|\t\trequest.Actors = map[string]string{\"main\": fixtureSubActor}\n440|\t\t_, err := Normalize(request)\n441|\t\tif err == nil {\n442|\t\t\tt.Fatal(\"Normalize() admitted main in the actor map\")\n443|\t\t}\n444|\t\tif !strings.Contains(err.Error(), \"carries main\") {\n445|\t\t\tt.Fatalf(\"Normalize() error = %v, want the main-actor refusal\", err)\n446|\t\t}\n447|\t})\n448|\tt.Run(\"missing_fetcher\", func(t *testing.T) {\n449|\t\tcapture, store := captureMembers(t, []fixtureMember{\n450|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n451|\t\t\t\tmessage(\"evt-nofetch\", `{\"text\":\"x\"}`),\n452|\t\t\t)},\n453|\t\t})\n454|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n455|\t\trequest.Fetch = nil\n456|\t\t_, err := Normalize(request)\n457|\t\tif err == nil {\n458|\t\t\tt.Fatal(\"Normalize() admitted a nil blob fetcher\")\n459|\t\t}\n460|\t\tif !strings.Contains(err.Error(), \"requires a blob fetcher\") {\n461|\t\t\tt.Fatalf(\"Normalize() error = %v, want the fetcher refusal\", err)\n462|\t\t}\n463|\t})\n464|\tt.Run(\"missing_sink\", func(t *testing.T) {\n465|\t\tcapture, store := captureMembers(t, []fixtureMember{\n466|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n467|\t\t\t\tmessage(\"evt-nosink\", `{\"text\":\"x\"}`),\n468|\t\t\t)},\n469|\t\t})\n470|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n471|\t\trequest.CanonicalSink = nil\n472|\t\t_, err := Normalize(request)\n473|\t\tif err == nil {\n474|\t\t\tt.Fatal(\"Normalize() admitted a nil canonical sink\")\n475|\t\t}\n476|\t\tif !strings.Contains(err.Error(), \"requires a canonical sink\") {\n477|\t\t\tt.Fatalf(\"Normalize() error = %v, want the sink refusal\", err)\n478|\t\t}\n479|\t})\n480|\tt.Run(\"bad_logical_session\", func(t *testing.T) {\n481|\t\tcapture, store := captureMembers(t, []fixtureMember{\n482|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n483|\t\t\t\tmessage(\"evt-badid\", `{\"text\":\"x\"}`),\n484|\t\t\t)},\n485|\t\t})\n486|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n487|\t\trequest.LogicalSessionID = \"not-a-uuid\"\n488|\t\t_, err := Normalize(request)\n489|\t\tif err == nil {\n490|\t\t\tt.Fatal(\"Normalize() admitted a non-UUIDv7 logical session\")\n491|\t\t}\n492|\t\tif !strings.Contains(err.Error(), \"is not a UUIDv7\") {\n493|\t\t\tt.Fatalf(\"Normalize() error = %v, want the UUID refusal\", err)\n494|\t\t}\n495|\t})\n496|\tt.Run(\"lone_surrogate_text\", func(t *testing.T) {\n497|\t\t// Section 1.6: decoders MUST reject lone surrogate code\n498|\t\t// points before canonicalization. A lenient decode would\n499|\t\t// rewrite the escape to U+FFFD and seal exact anyway.\n500|\t\trefuseMembers(t, []fixtureMember{\n501|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n502|\t\t\t\trec(\"evt-sur-text\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"evt-sur-text A\\ud800B\"}`),\n503|\t\t\t)},\n504|\t\t}, \"lone surrogate escape\")\n505|\t})\n506|\tt.Run(\"lone_surrogate_envelope\", func(t *testing.T) {\n507|\t\t// The envelope identity itself carries the lone escape:\n508|\t\t// admitting it would rewrite the evidence identity.\n509|\t\trefuseMembers(t, []fixtureMember{\n510|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n511|\t\t\t\t`{\"v\":1,\"native_event_id\":\"evt-sur-envelope-\\ud800\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`,\n512|\t\t\t)},\n513|\t\t}, \"lone surrogate escape\")\n514|\t})\n515|\tt.Run(\"duplicate_envelope_member\", func(t *testing.T) {\n516|\t\t// Section 1.6: duplicate keys are forbidden. A lenient\n517|\t\t// last-wins read would coerce this ambiguous record into\n518|\t\t// a known kind.\n519|\t\trefuseMembers(t, []fixtureMember{\n520|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n521|\t\t\t\t`{\"v\":1,\"native_event_id\":\"evt-dup-envelope\",\"native_type\":\"frobnicate\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`,\n522|\t\t\t)},\n523|\t\t}, \"duplicate member\")\n524|\t})\n525|\tt.Run(\"duplicate_body_member\", func(t *testing.T) {\n526|\t\t// A duplicated body member refuses instead of guessing\n527|\t\t// last-wins content.\n528|\t\trefuseMembers(t, []fixtureMember{\n529|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n530|\t\t\t\trec(\"evt-dup-body\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"A\",\"text\":\"B\"}`),\n531|\t\t\t)},\n532|\t\t}, \"duplicate member\")\n533|\t})\n534|\tt.Run(\"trailing_bytes\", func(t *testing.T) {\n535|\t\trefuseMembers(t, []fixtureMember{\n536|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n537|\t\t\t\tmessage(\"evt-trailing\", `{\"text\":\"x\"}`) + \"x\",\n538|\t\t\t)},\n539|\t\t}, \"trailing data\")\n540|\t})\n541|\tt.Run(\"string_usage_number\", func(t *testing.T) {\n542|\t\t// A uint53 member is a JSON integer, never a JSON\n543|\t\t// string: \"5\" is not the number 5.\n544|\t\trefuseMembers(t, []fixtureMember{\n545|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n546|\t\t\t\trec(\"evt-use-str\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":\"5\",\"output_tokens\":0}`),\n547|\t\t\t)},\n548|\t\t}, \"is not a uint53\")\n549|\t})\n550|\tt.Run(\"string_envelope_version\", func(t *testing.T) {\n551|\t\t// Same class at the envelope: \"1\" is not version 1.\n552|\t\trefuseMembers(t, []fixtureMember{\n553|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n554|\t\t\t\t`{\"v\":\"1\",\"native_event_id\":\"evt-vstr\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`,\n555|\t\t\t)},\n556|\t\t}, \"envelope version\")\n557|\t})\n558|\tt.Run(\"encrypted_type_signed_protection\", func(t *testing.T) {\n559|\t\trefuseMembers(t, []fixtureMember{\n560|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n561|\t\t\t\trec(\"evt-enc-signed\", \"reasoning/encrypted\", \"foreign\", \"signed\", \"main\", `{\"ciphertext\":\"x\"}`),\n562|\t\t\t)},\n563|\t\t}, \"declares reasoning/encrypted with protection\")\n564|\t})\n565|\tt.Run(\"signed_type_encrypted_protection\", func(t *testing.T) {\n566|\t\trefuseMembers(t, []fixtureMember{\n567|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n568|\t\t\t\trec(\"evt-signed-enc\", \"reasoning/signed\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"x\"}`),\n569|\t\t\t)},\n570|\t\t}, \"declares reasoning/signed with protection\")\n571|\t})\n572|\tt.Run(\"bad_result_status\", func(t *testing.T) {\n573|\t\trefuseMembers(t, []fixtureMember{\n574|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n575|\t\t\t\tcall(\"call-pending\", `{\"call_id\":\"call-pending\",\"tool_name\":\"write\"}`),\n576|\t\t\t\trec(\"evt-call-pending-result\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-pending\",\"status\":\"pending\"}`),\n577|\t\t\t)},\n578|\t\t}, \"outside ok|error\")\n579|\t})\n580|\tt.Run(\"unknown_protected_plaintext_body\", func(t *testing.T) {\n581|\t\t// An unknown type under protection still carries the\n582|\t\t// protected body shape: only exactly-ciphertext bodies\n583|\t\t// project opaque, anything else refuses rather than\n584|\t\t// guessing which bytes are safe to keep.\n585|\t\trefuseMembers(t, []fixtureMember{\n586|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n587|\t\t\t\trec(\"evt-unk-prot\", \"frobnicate\", \"foreign\", \"encrypted\", \"main\", `{\"mystery\":true}`),\n588|\t\t\t)},\n589|\t\t}, \"unknown member\")\n590|\t})\n591|\tt.Run(\"unknown_type_without_body\", func(t *testing.T) {\n592|\t\t// The body member is required for every record, including\n593|\t\t// unknown types: without it the record carries no\n594|\t\t// attributable payload and refuses instead of projecting\n595|\t\t// opaque.\n596|\t\trefuseMembers(t, []fixtureMember{\n597|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n598|\t\t\t\t`{\"v\":1,\"native_event_id\":\"evt-unk-nobody\",\"native_type\":\"frobnicate\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\"}`,\n599|\t\t\t)},\n600|\t\t}, `misses envelope member \"body\"`)\n601|\t})\n602|\tt.Run(\"blob_size_drift\", func(t *testing.T) {\n603|\t\t// One extra byte: the size arm fires with its own\n604|\t\t// message before the digest arm is reached.\n605|\t\tcapture, store := captureMembers(t, []fixtureMember{\n606|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n607|\t\t\t\tmessage(\"evt-sizedrift\", `{\"text\":\"x\"}`),\n608|\t\t\t)},\n609|\t\t})\n610|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n611|\t\thealthy := request.Fetch\n612|\t\trequest.Fetch = func(blobID string) ([]byte, error) {\n613|\t\t\tpayload, err := healthy(blobID)\n614|\t\t\tif err != nil {\n615|\t\t\t\treturn nil, err\n616|\t\t\t}\n617|\t\t\treturn append(payload, '\\n'), nil\n618|\t\t}\n619|\t\t_, err := Normalize(request)\n620|\t\tif err == nil {\n621|\t\t\tt.Fatal(\"Normalize() admitted blob bytes whose size drifts from the raw count\")\n622|\t\t}\n623|\t\tif !strings.Contains(err.Error(), \"blob size\") {\n624|\t\t\tt.Fatalf(\"Normalize() error = %v, want the size-arm refusal\", err)\n625|\t\t}\n626|\t})\n627|}\n628|\n629|// TestNormalizeNonJSONLIncludedMemberRefuses pins the stated bound:\n630|// every included non-unknown member is parsed as the JSONL record\n631|// log, so a member whose bytes are not JSONL refuses the whole\n632|// projection with the member and line named. Routing by member\n633|// class is sibling scope.\n634|func TestNormalizeNonJSONLIncludedMemberRefuses(t *testing.T) {\n635|\tsession := []fixtureMember{\n636|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n637|\t\t\trec(\"evt-p3i\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`),\n638|\t\t)},\n639|\t}\n640|\tt.Run(\"binary durable index\", func(t *testing.T) {\n641|\t\tmembers := append([]fixtureMember{\n642|\t\t\t{key: \"store/index.bin\", class: \"durable_index_required\", content: []byte{0x00, 0x01, 0x02}},\n643|\t\t}, session...)\n644|\t\tcapture, store := captureMembers(t, members)\n645|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n646|\t\tif err == nil {\n647|\t\t\tt.Fatal(\"Normalize() admitted a binary included member as record lines\")\n648|\t\t}\n649|\t\tif !strings.Contains(err.Error(), \"store/index.bin line 1\") {\n650|\t\t\tt.Fatalf(\"Normalize() error = %v, want the member+line refusal\", err)\n651|\t\t}\n652|\t})\n653|\tt.Run(\"text derived cache\", func(t *testing.T) {\n654|\t\tmembers := append([]fixtureMember{\n655|\t\t\t{key: \"store/cache.bin\", class: \"derived_cache_optional\", content: []byte(\"not json\\n\")},\n656|\t\t}, session...)\n657|\t\tcapture, store := captureMembers(t, members)\n658|\t\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n659|\t\tif err == nil {\n660|\t\t\tt.Fatal(\"Normalize() admitted a non-JSONL included member as record lines\")\n661|\t\t}\n662|\t\tif !strings.Contains(err.Error(), \"store/cache.bin line 1\") {\n663|\t\t\tt.Fatalf(\"Normalize() error = %v, want the member+line refusal\", err)\n664|\t\t}\n665|\t})\n666|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
