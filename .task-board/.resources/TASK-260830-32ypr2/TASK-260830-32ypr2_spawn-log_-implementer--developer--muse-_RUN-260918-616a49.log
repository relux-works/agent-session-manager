|\t\tif resolved.ToolResolutions[0].Status != \"completed\" {\n33|\t\t\tt.Fatalf(\"Status = %q, want completed\", resolved.ToolResolutions[0].Status)\n34|\t\t}\n35|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-call-1\")\n36|\t\tif callEvent.Kind != \"tool_call\" {\n37|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n38|\t\t}\n39|\t\tif callEvent.Visibility != \"internal\" {\n40|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", callEvent.Visibility)\n41|\t\t}\n42|\t\tif payloadText(t, callEvent, \"resolution\") != \"completed\" {\n43|\t\t\tt.Fatalf(\"payload resolution = %q, want completed\", payloadText(t, callEvent, \"resolution\"))\n44|\t\t}\n45|\t\tif len(callEvent.Evidence.ReasonCodes) != 0 {\n46|\t\t\tt.Fatalf(\"ReasonCodes = %q, want empty for a completed call\", callEvent.Evidence.ReasonCodes)\n47|\t\t}\n48|\t\tresultEvent := eventByNativeID(t, resolved, \"evt-call-1-result\")\n49|\t\tif resultEvent.Kind != \"tool_result\" {\n50|\t\t\tt.Fatalf(\"Kind = %q, want tool_result\", resultEvent.Kind)\n51|\t\t}\n52|\t\tif payloadText(t, resultEvent, \"resolution\") != \"completed\" {\n53|\t\t\tt.Fatalf(\"payload resolution = %q, want completed\", payloadText(t, resultEvent, \"resolution\"))\n54|\t\t}\n55|\t\tif len(resolved.Live.CallableTools) != 0 || len(resolved.Live.PendingActions) != 0 {\n56|\t\t\tt.Fatalf(\"Live = %+v, want empty\", resolved.Live)\n57|\t\t}\n58|\t})\n59|\tt.Run(\"call_without_result\", func(t *testing.T) {\n60|\t\tbundle := projectMembers(t, []fixtureMember{\n61|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n62|\t\t\t\tcall(\"call-7\", \"write\"),\n63|\t\t\t)},\n64|\t\t})\n65|\t\tresolved := bundle.result\n66|\t\tif len(resolved.ToolResolutions) != 1 {\n67|\t\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 1\", len(resolved.ToolResolutions))\n68|\t\t}\n69|\t\tif resolved.ToolResolutions[0].Status != \"aborted\" {\n70|\t\t\tt.Fatalf(\"Status = %q, want aborted\", resolved.ToolResolutions[0].Status)\n71|\t\t}\n72|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-call-7\")\n73|\t\tif callEvent.Kind != \"tool_call\" {\n74|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n75|\t\t}\n76|\t\tif callEvent.Visibility != \"internal\" {\n77|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", callEvent.Visibility)\n78|\t\t}\n79|\t\tif payloadText(t, callEvent, \"resolution\") != \"aborted\" {\n80|\t\t\tt.Fatalf(\"payload resolution = %q, want aborted\", payloadText(t, callEvent, \"resolution\"))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
