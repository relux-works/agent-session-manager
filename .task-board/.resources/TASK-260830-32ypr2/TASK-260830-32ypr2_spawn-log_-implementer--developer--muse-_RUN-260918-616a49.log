{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d665","stream":{"kind":"session","id":"01a0b48a-1840-7d93-9d43-f2decee529f8"},"sequence":2445,"recorded_at":1780531400004885,"record_type":"event","durability":"durable","causation_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cc2eb299-8bb3-4a28-9487-6d4564236d15","run_stream":{"kind":"run","id":"cc2eb299-8bb3-4a28-9487-6d4564236d15"},"task_stream":{"kind":"task","id":"01a0b497-4a69-7521-9e67-f33165f11ede"},"task_id":"01a0b497-4a69-7521-9e67-f33165f11ede","event":{"kind":"output","task_id":"01a0b497-4a69-7521-9e67-f33165f11ede","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/tools_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// Invariant 3: historical tools are inert and incomplete calls never\n8|// become live actions. The matrix drives every pairing shape through\n9|// Normalize over real captured bytes and asserts the projected kind,\n10|// the visibility, the folded resolution, and the empty live surface.\n11|\n12|func TestNormalizeToolMatrix(t *testing.T) {\n13|\tcall := func(id, tool string) string {\n14|\t\treturn rec(\"evt-\"+id, \"tool/call\", \"native\", \"none\", \"main\",\n15|\t\t\t`{\"call_id\":\"`+id+`\",\"tool_name\":\"`+tool+`\"}`)\n16|\t}\n17|\tresult := func(id, status string) string {\n18|\t\treturn rec(\"evt-\"+id+\"-result\", \"tool/result\", \"native\", \"none\", \"main\",\n19|\t\t\t`{\"call_id\":\"`+id+`\",\"status\":\"`+status+`\"}`)\n20|\t}\n21|\tt.Run(\"call_with_result\", func(t *testing.T) {\n22|\t\tbundle := projectMembers(t, []fixtureMember{\n23|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n24|\t\t\t\tcall(\"call-1\", \"read\"),\n25|\t\t\t\tresult(\"call-1\", \"ok\"),\n26|\t\t\t)},\n27|\t\t})\n28|\t\tresolved := bundle.result\n29|\t\tif len(resolved.ToolResolutions) != 1 {\n30|\t\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 1\", len(resolved.ToolResolutions))\n31|\t\t}\n32|\t\tif resolved.ToolResolutions[0].Status != \"completed\" {\n33|\t\t\tt.Fatalf(\"Status = %q, want completed\", resolved.ToolResolutions[0].Status)\n34|\t\t}\n35|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-call-1\")\n36|\t\tif callEvent.Kind != \"tool_call\" {\n37|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n38|\t\t}\n39|\t\tif callEvent.Visibility != \"internal\" {\n40|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", callEvent.Visibility)\n41|\t\t}\n42|\t\tif payloadText(t, callEvent, \"resolution\") != \"completed\" {\n43|\t\t\tt.Fatalf(\"payload resolution = %q, want completed\", payloadText(t, callEvent, \"resolution\"))\n44|\t\t}\n45|\t\tif len(callEvent.Evidence.ReasonCodes) != 0 {\n46|\t\t\tt.Fatalf(\"ReasonCodes = %q, want empty for a completed call\", callEvent.Evidence.ReasonCodes)\n47|\t\t}\n48|\t\tresultEvent := eventByNativeID(t, resolved, \"evt-call-1-result\")\n49|\t\tif resultEvent.Kind != \"tool_result\" {\n50|\t\t\tt.Fatalf(\"Kind = %q, want tool_result\", resultEvent.Kind)\n51|\t\t}\n52|\t\tif payloadText(t, resultEvent, \"resolution\") != \"completed\" {\n53|\t\t\tt.Fatalf(\"payload resolution = %q, want completed\", payloadText(t, resultEvent, \"resolution\"))\n54|\t\t}\n55|\t\tif len(resolved.Live.CallableTools) != 0 || len(resolved.Live.PendingActions) != 0 {\n56|\t\t\tt.Fatalf(\"Live = %+v, want empty\", resolved.Live)\n57|\t\t}\n58|\t})\n59|\tt.Run(\"call_without_result\", func(t *testing.T) {\n60|\t\tbundle := projectMembers(t, []fixtureMember{\n61|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n62|\t\t\t\tcall(\"call-7\", \"write\"),\n63|\t\t\t)},\n64|\t\t})\n65|\t\tresolved := bundle.result\n66|\t\tif len(resolved.ToolResolutions) != 1 {\n67|\t\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 1\", len(resolved.ToolResolutions))\n68|\t\t}\n69|\t\tif resolved.ToolResolutions[0].Status != \"aborted\" {\n70|\t\t\tt.Fatalf(\"Status = %q, want aborted\", resolved.ToolResolutions[0].Status)\n71|\t\t}\n72|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-call-7\")\n73|\t\tif callEvent.Kind != \"tool_call\" {\n74|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n75|\t\t}\n76|\t\tif callEvent.Visibility != \"internal\" {\n77|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", callEvent.Visibility)\n78|\t\t}\n79|\t\tif payloadText(t, callEvent, \"resolution\") != \"aborted\" {\n80|\t\t\tt.Fatalf(\"payload resolution = %q, want aborted\", payloadText(t, callEvent, \"resolution\"))\n(more lines below)","final_result":true}}}
