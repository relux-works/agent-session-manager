+			rec("evt-drift-ws", "message/user", "native", "none", "main", `{"text":"x"}`),
+		)},
+	})
+	request := NormalizeRequest{
+		CaptureManifest:  captureBytes,
+		RawManifest:      rawBytes,
+		Fetch:            storeFetch(t, probeStore),
