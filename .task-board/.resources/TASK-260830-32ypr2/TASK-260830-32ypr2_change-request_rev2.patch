+	t.Helper()
+	if !errors.Is(err, ErrInvalid) {
+		t.Fatalf("error = %v, want ErrInvalid", err)
+	}
+	if fragment != "" && !strings.Contains(err.Error(), fragment) {
+		t.Fatalf("error = %v, want fragment %q", err, fragment)
+	}
+}
