+			rec("evt-use-1", "usage/report", "native", "none", "main", `{"input_tokens":100,"output_tokens":40}`),
+			rec("evt-use-2", "usage/report", "native", "none", "main", `{"input_tokens":5,"output_tokens":7}`),
