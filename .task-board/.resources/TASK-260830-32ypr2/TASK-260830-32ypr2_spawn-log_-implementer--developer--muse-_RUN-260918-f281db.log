geMatchesTracecheckReport pins the README \"Measured\n43|// coverage of this repository\" subsection to the tracecheck report measured\n44|// on the current tree. The fenced `section coverage:` line must equal the\n45|// tool's own output line byte-for-byte, and every headline prose figure must\n46|// equal the Report field it restates.\n47|//\n48|// Per-section ratios inside the subsection (13.13 at 9/11 and the like) are\n49|// deliberately not re-derived here: TestCatalogSectionBindingCoverageIsExact-\n50|// AndDoesNotClaimUnimplementedScope already pins each binding's measured\n51|// ratio through the production entry point, and duplicating that table would\n52|// test the copy, not the prose. The historical \"13 sections added by v0.6.0\"\n53|// sentence is likewise out of scope: it states history, not the measured\n54|// report.\n55|func TestREADMEMeasuredCoverageMatchesTracecheckReport(t *testing.T) {\n56|\tt.Parallel()\n57|\n58|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n59|\n60|\tvar output bytes.Buffer\n61|\tif err := run([]string{\"-root\", repositoryRoot}, &output); err != nil {\n62|\t\tt.Fatalf(\"run() error = %v\", err)\n63|\t}\n64|\tlines := strings.Split(strings.TrimSuffix(output.String(), \"\\n\"), \"\\n\")\n65|\tif len(lines) != 2 {\n66|\t\tt.Fatalf(\"run() printed %d lines, want the 2-line tracecheck report\", len(lines))\n67|\t}\n68|\tif !strings.HasPrefix(lines[1], \"section coverage: \") {\n69|\t\tt.Fatalf(\"run() second line = %q, want the section coverage line\", lines[1])\n70|\t}\n71|\n72|\treport, err := traceability.VerifyRepository(os.DirFS(repositoryRoot))\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"VerifyRepository() error = %v\", err)\n75|\t}\n76|\n77|\tsubsection, start := measuredCoverageSubsection(t, repositoryRoot)\n78|\tassertFencedCoverageLine(t, subsection, start, lines[1])\n79|\tprose := strings.Join(subsection, \" \")\n80|\n81|\tassertProseFigure(t, prose, start, `(\\S+) section bindings discharge ([0-9]+) of the ([0-9]+) normative clauses`,\n82|\t\t[]int{report.SectionBindings, report.DischargedClauses, report.NormativeClauses})\n83|\tassertProseFigure(t, prose, start, `(Four) bindings are `+\"`full`\", []int{report.FullCoverage})\n84|\tassertProseFigure(t, prose, start, `(nine) are `+\"`partial`\", []int{report.PartialCoverage})\n85|\tassertProseFigure(t, prose, start, `(nine) are `+\"`sliver`\", []int{report.SliverCoverage})\n86|\tassertProseFigure(t, prose, start, `(four) are `+\"`unmeasured`\", []int{report.UnmeasuredCoverage})\n87|\tassertProseFigure(t, prose, start, `(forty-three) are `+\"`unevidenced`\", []int{report.UnevidencedCoverage})\n88|\tassertProseFigure(t, prose, start, `(Seven) sections are recorded unowned`, []int{report.UnownedSections})\n89|\n90|\tfullBindings, fullClauses := fullBindingTotals(t, repositoryRoot)\n91|\tif fullBindings != report.FullCoverage {\n92|\t\tt.Fatalf(\"registry declares %d full bindings, VerifyRepository measures %d\", fullBindings, report.FullCoverage)\n93|\t}\n94|\tassertProseFigure(t, prose, start, `(Four) admitted bindings out of (sixty-nine) cover (twelve) clauses`,\n95|\t\t[]int{report.FullCoverage, report.SectionBindings, fullClauses})\n96|}\n97|\n98|// measuredCoverageSubsection returns the subsection lines under the anchor,\n99|// stopping before the next heading. A missing anchor, a duplicated anchor,\n100|// or a subsection that runs to end of file without a closing heading is a\n101|// red: each shape would otherwise silently change what this test measures.\n102|func measuredCoverageSubsection(t *testing.T, repositoryRoot string) ([]string, int) {\n103|\tt.Helper()\n104|\n105|\treadme, err := os.ReadFile(filepath.Join(repositoryRoot, \"README.md\"))\n106|\tif err != nil {\n107|\t\tt.Fatalf(\"read README.md: %v\", err)\n108|\t}\n109|\tlines := strings.Split(string(readme), \"\\n\")\n110|\tanchor := -1\n111|\tfor index, line := range lines {\n112|\t\tif strings.TrimSpace(line) == measuredCoverageAnchor {\n113|\t\t\tif anchor >= 0 {\n114|\t\t\t\tt.Fatalf(\"README carries %q twice, at lines %d and %d\", measuredCoverageAnchor, anchor+1, index+1)\n115|\t\t\t}\n116|\t\t\tanchor = index\n117|\t\t}\n118|\t}\n119|\tif anchor < 0 {\n120|\t\tt.Fatalf(\"README no longer carries %q\", measuredCoverageAnchor)\n121|\t}\n122|\tend := -1\n123|\tfor index := anchor + 1; index < len(lines); index++ {\n124|\t\ttrimmed := strings.TrimSpace(lines[index])\n125|\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"### \") {\n126|\t\t\tend = index\n127|\t\t\tbreak\n128|\t\t}\n129|\t}\n130|\tif end < 0 {\n131|\t\tt.Fatalf(\"README subsection %q runs to end of file without a closing heading\", measuredCoverageAnchor)\n132|\t}\n133|\treturn lines[anchor+1 : end], anchor + 2\n134|}\n135|\n136|// assertFencedCoverageLine requires the subsection to carry exactly one\n137|// fenced block and its content to equal the tool's coverage line\n138|// byte-for-byte: no rewording, no reordered fields, no rounding.\n139|func assertFencedCoverageLine(t *testing.T, subsection []string, start int, want string) {\n140|\tt.Helper()\n141|\n142|\tvar fences []int\n143|\tfor offset, line := range subsection {\n144|\t\ttrimmed := strings.TrimSpace(line)\n145|\t\tif trimmed == \"```text\" || trimmed == \"```\" {\n146|\t\t\tfences = append(fences, offset)\n147|\t\t}\n148|\t}\n149|\tif len(fences) != 2 || strings.TrimSpace(subsection[fences[0]]) != \"```text\" {\n150|\t\tt.Fatalf(\"README subsection at line %d carries %d fence lines, want exactly one ```text block\", start, len(fences))\n151|\t}\n152|\tgot := strings.Join(subsection[fences[0]+1:fences[1]], \"\\n\")\n153|\tif got != want {\n154|\t\tt.Fatalf(\"README fenced coverage line = %q, tracecheck printed %q\", got, want)\n155|\t}\n156|}\n157|\n158|// assertProseFigure requires the pattern to match the unwrapped subsection\n159|// exactly once and each capture to equal the measured figure. A capture that\n160|// is all digits compares numerically; any other capture decodes through the\n161|// closed number-word map.\n162|func assertProseFigure(t *testing.T, prose string, start int, pattern string, want []int) {\n163|\tt.Helper()\n164|\n165|\tmatches := regexp.MustCompile(pattern).FindAllStringSubmatch(prose, -1)\n166|\tif len(matches) != 1 {\n167|\t\tt.Fatalf(\"README subsection at line %d matches %q %d times, want exactly 1\", start, pattern, len(matches))\n168|\t}\n169|\tif len(matches[0])-1 != len(want) {\n170|\t\tt.Fatalf(\"README pattern %q captures %d figures, want %d\", pattern, len(matches[0])-1, len(want))\n171|\t}\n172|\tfor index, raw := range matches[0][1:] {\n173|\t\tvar published int\n174|\t\tif value, err := strconv.Atoi(raw); err == nil {\n175|\t\t\tpublished = value\n176|\t\t} else if value, ok := coverageNumberWords[strings.ToLower(raw)]; ok {\n177|\t\t\tpublished = value\n178|\t\t} else {\n179|\t\t\tt.Fatalf(\"README subsection at line %d spells a figure %q the closed map does not decode\", start, raw)\n180|\t\t}\n181|\t\tif published != want[index] {\n182|\t\t\tt.Fatalf(\"README subsection at line %d publishes %d for %q; measured %d\", start, published, pattern, want[index])\n183|\t\t}\n184|\t}\n185|}\n186|\n187|// fullBindingTotals re-derives the admitted-sentence figures from the\n188|// reviewed registry: how many section bindings declare full coverage and how\n189|// many discharged clauses they enumerate. The gate has already verified each\n190|// clause against the pinned document (VerifyRepository is green in this\n191|// test), so the sum is measured evidence, not a restated claim.\n192|func fullBindingTotals(t *testing.T, repositoryRoot string) (int, int) {\n193|\tt.Helper()\n194|\n195|\traw, err := os.ReadFile(filepath.Join(repositoryRoot, \"internal\", \"traceability\", \"ownership.v0.7.0.json\"))\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"read adopted ownership registry: %v\", err)\n198|\t}\n199|\tvar registry struct {\n200|\t\tOwnership []struct {\n201|\t\t\tKind     string `json:\"kind\"`\n202|\t\t\tCoverage string `json:\"coverage\"`\n203|\t\t\tClauses  []struct {\n204|\t\t\t\tID string `json:\"id\"`\n205|\t\t\t} `json:\"clauses\"`\n206|\t\t} `json:\"ownership\"`\n207|\t}\n208|\tif err := json.Unmarshal(raw, &registry); err != nil {\n209|\t\tt.Fatalf(\"decode adopted ownership registry: %v\", err)\n210|\t}\n211|\tbindings, clauses := 0, 0\n212|\tfor _, group := range registry.Ownership {\n213|\t\tif group.Kind != \"section_binding\" || group.Coverage != \"full\" {\n214|\t\t\tcontinue\n215|\t\t}\n216|\t\tbindings++\n217|\t\tclauses += len(group.Clauses)\n218|\t}\n219|\treturn bindings, clauses\n220|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
