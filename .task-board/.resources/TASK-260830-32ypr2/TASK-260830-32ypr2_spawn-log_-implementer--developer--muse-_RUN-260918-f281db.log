{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c719","stream":{"kind":"session","id":"01a0b4ea-fb92-7cf3-9cd5-04cb5a5f5467"},"sequence":487,"recorded_at":1780531400000969,"record_type":"event","durability":"durable","causation_id":"16aac74a-8f80-4da1-94ce-cabce45ae87b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"16aac74a-8f80-4da1-94ce-cabce45ae87b","run_stream":{"kind":"run","id":"16aac74a-8f80-4da1-94ce-cabce45ae87b"},"call_id":"call_01a0b4ec109775ccb6d4033f7a6a74fd","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/clonebundle/refusal_session_event_test.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|)\n10|\n11|// Negative tests for the Canonical Session, Canonical Event, identity,\n12|// generation, and blob-agreement gates. Every row drives a production\n13|// entry point.\n14|\n15|// unsortedPair returns two distinct fixture digests in\n16|// descending order: feeding them where ascending order is required\n17|// always exercises the unsorted refusal.\n18|func unsortedPair(seedA, seedB string) (string, string) {\n19|\tfirst, second := fixtureDigest(seedA), fixtureDigest(seedB)\n20|\tif first < second {\n21|\t\tfirst, second = second, first\n22|\t}\n23|\treturn first, second\n24|}\n25|\n26|func mustSessionBytes(t *testing.T) []byte {\n27|\tt.Helper()\n28|\tbuilt, err := BuildCanonicalSession(validSessionInput())\n29|\tif err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\treturn built\n33|}\n34|\n35|func mustEventBytes(t *testing.T, status string) []byte {\n36|\tt.Helper()\n37|\tbuilt, err := BuildCanonicalEvent(validEventInput(status))\n38|\tif err != nil {\n39|\t\tt.Fatal(err)\n40|\t}\n41|\treturn built\n42|}\n43|\n44|func TestCanonicalSessionRefusals(t *testing.T) {\n45|\tt.Run(\"build actors\", func(t *testing.T) {\n46|\t\tbuild := func(actors []ActorInput) error {\n47|\t\t\tinput := validSessionInput()\n48|\t\t\tinput.Actors = actors\n49|\t\t\t_, err := BuildCanonicalSession(input)\n50|\t\t\treturn err\n51|\t\t}\n52|\t\tcases := []struct {\n53|\t\t\tname     string\n54|\t\t\tactors   []ActorInput\n55|\t\t\tfragment string\n56|\t\t}{\n57|\t\t\t{\"no actors\", nil, \"[1..1024]\"},\n58|\t\t\t{\"no main\", []ActorInput{{ActorID: fixtureActorSub, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)}}, \"exactly one\"},\n59|\t\t\t{\"two mains\", []ActorInput{\n60|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n61|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"main\"},\n62|\t\t\t}, \"exactly one\"},\n63|\t\t\t{\"main with parent\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", ParentActorID: strptr(fixtureActorSub)}}, \"carries a parent\"},\n64|\t\t\t{\"non-main null parent\", []ActorInput{\n65|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n66|\t\t\t\t{ActorID: fixtureActorSub, Kind: \"external\"},\n67|\t\t\t}, \"requires a parent\"},\n68|\t\t\t{\"duplicate actor id\", []ActorInput{\n69|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"main\"},\n70|\t\t\t\t{ActorID: fixtureActorMain, Kind: \"subagent\", ParentActorID: strptr(fixtureActorMain)},\n71|\t\t\t}, \"unique by actor ID\"},\n72|\t\t\t{\"bad kind\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"ghost\"}}, \"main|subagent|external\"},\n73|\t\t\t{\"bad actor id\", []ActorInput{{ActorID: \"nope\", Kind: \"main\"}}, \"not a UUIDv7\"},\n74|\t\t\t{\"unsanitized source id\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", SourceNativeID: strptr(\"/abs/x\")}}, \"absolute source path\"},\n75|\t\t\t{\"empty name\", []ActorInput{{ActorID: fixtureActorMain, Kind: \"main\", Name: strptr(\"\")}}, \"string[1..512]\"},\n76|\t\t}\n77|\t\tfor _, tc := range cases {\n78|\t\t\tt.Run(tc.name, func(t *testing.T) {\n79|\t\t\t\trequireRefusal(t, build(tc.actors), tc.fragment)\n80|\t\t\t})\n81|\t\t}\n82|\t})\n83|\tt.Run(\"build envelope\", func(t *testing.T) {\n84|\t\tcases := []struct {\n85|\t\t\tname     string\n86|\t\t\tmutate   func(*CanonicalSessionInput)\n87|\t\t\tfragment string\n88|\t\t}{\n89|\t\t\t{\"bad logical\", func(in *CanonicalSessionInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n90|\t\t\t{\"bad tuple\", func(in *CanonicalSessionInput) { in.SourceEnvironment = []byte(`{}`) }, \"Environment Tuple\"},\n91|\t\t\t{\"unsanitized native id\", func(in *CanonicalSessionInput) { in.SourceNativeSessionID = fixtureSessionID }, \"fabricated AX\"},\n92|\t\t\t{\"empty title\", func(in *CanonicalSessionInput) { in.Title = strptr(\"\") }, \"string[1..4096]\"},\n93|\t\t\t{\"bad workspace\", func(in *CanonicalSessionInput) { in.Workspace = []byte(`{}`) }, \"workspace\"},\n94|\t\t\t{\"empty events\", func(in *CanonicalSessionInput) { in.EventIDs = nil }, \"[1..1000000]\"},\n95|\t\t\t{\"dup events\", func(in *CanonicalSessionInput) { in.EventIDs = []string{fixtureDigest(\"x\"), fixtureDigest(\"x\")} }, \"not unique\"},\n96|\t\t\t{\"bad event digest\", func(in *CanonicalSessionInput) { in.EventIDs = []string{\"nope\"} }, \"not a digest\"},\n97|\t\t\t{\"empty heads\", func(in *CanonicalSessionInput) { in.HeadEventIDs = nil }, \"[1..1024]\"},\n98|\t\t\t{\"head outside events\", func(in *CanonicalSessionInput) { in.HeadEventIDs = []string{fixtureDigest(\"elsewhere\")} }, \"outside event_ids\"},\n99|\t\t\t{\"heads unsorted\", func(in *CanonicalSessionInput) {\n100|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n101|\t\t\t\tin.EventIDs = []string{low, high}\n102|\t\t\t\tin.HeadEventIDs = []string{high, low}\n103|\t\t\t}, \"sorted unique\"},\n104|\t\t\t{\"bad created_at\", func(in *CanonicalSessionInput) { in.CreatedAt = strptr(\"yesterday\") }, \"not a timestamp\"},\n105|\t\t\t{\"bad extensions\", func(in *CanonicalSessionInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n106|\t\t}\n107|\t\tfor _, tc := range cases {\n108|\t\t\tt.Run(tc.name, func(t *testing.T) {\n109|\t\t\t\tinput := validSessionInput()\n110|\t\t\t\ttc.mutate(&input)\n111|\t\t\t\t_, err := BuildCanonicalSession(input)\n112|\t\t\t\trequireRefusal(t, err, tc.fragment)\n113|\t\t\t})\n114|\t\t}\n115|\t})\n116|\tt.Run(\"decode\", func(t *testing.T) {\n117|\t\tvalid := mustSessionBytes(t)\n118|\t\tcases := []struct {\n119|\t\t\tname     string\n120|\t\t\tbody     func(t *testing.T) []byte\n121|\t\t\tfragment string\n122|\t\t}{\n123|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n124|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n125|\t\t\t}, \"unknown member\"},\n126|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n127|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n128|\t\t\t}, \"not the canonical session\"},\n129|\t\t\t{\"two mains\", func(t *testing.T) []byte {\n130|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n131|\t\t\t\t\tactors := o[\"actors\"].([]any)\n132|\t\t\t\t\tactors[1].(map[string]any)[\"kind\"] = \"main\"\n133|\t\t\t\t\tactors[1].(map[string]any)[\"parent_actor_id\"] = nil\n134|\t\t\t\t})\n135|\t\t\t}, \"exactly one\"},\n136|\t\t\t{\"dup actors\", func(t *testing.T) []byte {\n137|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n138|\t\t\t\t\tactors := o[\"actors\"].([]any)\n139|\t\t\t\t\tactors[1].(map[string]any)[\"actor_id\"] = actors[0].(map[string]any)[\"actor_id\"]\n140|\t\t\t\t})\n141|\t\t\t}, \"unique by actor ID\"},\n142|\t\t\t{\"dup events\", func(t *testing.T) []byte {\n143|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n144|\t\t\t\t\tevents := o[\"event_ids\"].([]any)\n145|\t\t\t\t\to[\"event_ids\"] = []any{events[0], events[0]}\n146|\t\t\t\t})\n147|\t\t\t}, \"not unique\"},\n148|\t\t\t{\"heads unsorted\", func(t *testing.T) []byte {\n149|\t\t\t\thigh, low := unsortedPair(\"unsorted-head-a\", \"unsorted-head-b\")\n150|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n151|\t\t\t\t\to[\"event_ids\"] = []any{low, high}\n152|\t\t\t\t\to[\"head_event_ids\"] = []any{high, low}\n153|\t\t\t\t})\n154|\t\t\t}, \"sorted unique\"},\n155|\t\t\t{\"head outside\", func(t *testing.T) []byte {\n156|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"head_event_ids\"] = []any{fixtureDigest(\"elsewhere\")} })\n157|\t\t\t}, \"outside event_ids\"},\n158|\t\t\t{\"main with parent\", func(t *testing.T) []byte {\n159|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n160|\t\t\t\t\tactors := o[\"actors\"].([]any)\n161|\t\t\t\t\tactors[0].(map[string]any)[\"parent_actor_id\"] = fixtureActorSub\n162|\t\t\t\t})\n163|\t\t\t}, \"carries a parent\"},\n164|\t\t\t{\"subagent null parent\", func(t *testing.T) []byte {\n165|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n166|\t\t\t\t\tactors := o[\"actors\"].([]any)\n167|\t\t\t\t\tactors[1].(map[string]any)[\"parent_actor_id\"] = nil\n168|\t\t\t\t})\n169|\t\t\t}, \"requires a parent\"},\n170|\t\t\t{\"external null parent\", func(t *testing.T) []byte {\n171|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n172|\t\t\t\t\tactors := o[\"actors\"].([]any)\n173|\t\t\t\t\tactors[1].(map[string]any)[\"kind\"] = \"external\"\n174|\t\t\t\t\tactors[1].(map[string]any)[\"parent_actor_id\"] = nil\n175|\t\t\t\t})\n176|\t\t\t}, \"requires a parent\"},\n177|\t\t\t{\"bad version\", func(t *testing.T) []byte {\n178|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema_version\"] = \"2.0.0\" })\n179|\t\t\t}, \"not 1.0.0\"},\n180|\t\t\t{\"actors not array\", func(t *testing.T) []byte {\n181|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"actors\"] = \"nope\" })\n182|\t\t\t}, \"not an array\"},\n183|\t\t\t{\"too many actors\", func(t *testing.T) []byte {\n184|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"actors\"] = make([]any, 1025) })\n185|\t\t\t}, \"want [1..1024]\"},\n186|\t\t\t{\"actor kind ghost\", func(t *testing.T) []byte {\n187|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n188|\t\t\t\t\tactors := o[\"actors\"].([]any)\n189|\t\t\t\t\tactors[1].(map[string]any)[\"kind\"] = \"ghost\"\n190|\t\t\t\t})\n191|\t\t\t}, \"main|subagent|external\"},\n192|\t\t\t{\"heads duplicate\", func(t *testing.T) []byte {\n193|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n194|\t\t\t\t\theads := o[\"head_event_ids\"].([]any)\n195|\t\t\t\t\to[\"head_event_ids\"] = []any{heads[0], heads[0]}\n196|\t\t\t\t})\n197|\t\t\t}, \"sorted unique\"},\n198|\t\t\t{\"title empty\", func(t *testing.T) []byte {\n199|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"title\"] = \"\" })\n200|\t\t\t}, \"string[1..4096]\"},\n201|\t\t\t{\"self mismatch\", func(t *testing.T) []byte {\n202|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"canonical_session_id\"] = fixtureDigest(\"forged\") })\n203|\t\t\t}, \"omit-self digest\"},\n204|\t\t}\n205|\t\tfor _, tc := range cases {\n206|\t\t\tt.Run(tc.name, func(t *testing.T) {\n207|\t\t\t\t_, err := DecodeCanonicalSession(tc.body(t))\n208|\t\t\t\trequireRefusal(t, err, tc.fragment)\n209|\t\t\t})\n210|\t\t}\n211|\t})\n212|}\n213|\n214|func TestCanonicalEventRefusals(t *testing.T) {\n215|\tt.Run(\"build envelope\", func(t *testing.T) {\n216|\t\tcases := []struct {\n217|\t\t\tname     string\n218|\t\t\tmutate   func(*CanonicalEventInput)\n219|\t\t\tfragment string\n220|\t\t}{\n221|\t\t\t{\"bad kind\", func(in *CanonicalEventInput) { in.Kind = \"chat\" }, \"26-kind\"},\n222|\t\t\t{\"bad visibility\", func(in *CanonicalEventInput) { in.Visibility = \"secret\" }, \"public|projection|internal|opaque\"},\n223|\t\t\t{\"bad logical\", func(in *CanonicalEventInput) { in.LogicalSessionID = \"nope\" }, \"not a UUIDv7\"},\n224|\t\t\t{\"bad actor\", func(in *CanonicalEventInput) { in.ActorID = \"nope\" }, \"not a UUIDv7\"},\n225|\t\t\t{\"bad turn\", func(in *CanonicalEventInput) { in.TurnID = strptr(\"nope\") }, \"turn_id\"},\n226|\t\t\t{\"bad timestamp\", func(in *CanonicalEventInput) { in.Timestamp = strptr(\"yesterday\") }, \"not a timestamp\"},\n227|\t\t\t{\"parents unsorted\", func(in *CanonicalEventInput) {\n228|\t\t\t\thigh, low := unsortedPair(\"unsorted-parent-a\", \"unsorted-parent-b\")\n229|\t\t\t\tin.Parents = []string{high, low}\n230|\t\t\t}, \"sorted unique\"},\n231|\t\t\t{\"parents dup\", func(in *CanonicalEventInput) {\n232|\t\t\t\tin.Parents = []string{fixtureDigest(\"a\"), fixtureDigest(\"a\")}\n233|\t\t\t}, \"sorted unique\"},\n234|\t\t\t{\"payload not object\", func(in *CanonicalEventInput) { in.Payload = []byte(`[1]`) }, \"payload\"},\n235|\t\t\t{\"message missing blocks\", func(in *CanonicalEventInput) { in.Payload = []byte(`{\"extensions\":{}}`) }, \"content_blocks\"},\n236|\t\t\t{\"message extra member\", func(in *CanonicalEventInput) {\n237|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[],\"extensions\":{},\"transcript\":\"x\"}`)\n238|\t\t\t}, \"unknown member\"},\n239|\t\t\t{\"block bad type\", func(in *CanonicalEventInput) {\n240|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"video\"}],\"extensions\":{}}`)\n241|\t\t\t}, \"eight-type\"},\n242|\t\t\t{\"block missing type\", func(in *CanonicalEventInput) {\n243|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"content\":\"x\"}],\"extensions\":{}}`)\n244|\t\t\t}, \"misses its type\"},\n245|\t\t\t{\"block inline oversize\", func(in *CanonicalEventInput) {\n246|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"x\", 65537) + `\"}],\"extensions\":{}}`)\n247|\t\t\t}, \"64 KiB\"},\n248|\t\t\t{\"block bad descriptor\", func(in *CanonicalEventInput) {\n249|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"image\",\"blob_descriptor_id\":\"nope\"}],\"extensions\":{}}`)\n250|\t\t\t}, \"not a digest\"},\n251|\t\t\t{\"block neither content nor descriptor\", func(in *CanonicalEventInput) {\n252|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\"}],\"extensions\":{}}`)\n253|\t\t\t}, \"not exclusive\"},\n254|\t\t\t{\"block both content and descriptor\", func(in *CanonicalEventInput) {\n255|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\",\"blob_descriptor_id\":\"` + fixtureDigest(\"d\") + `\"}],\"extensions\":{}}`)\n256|\t\t\t}, \"not exclusive\"},\n257|\t\t\t{\"block extra member\", func(in *CanonicalEventInput) {\n258|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"blob_id\":\"x\"}],\"extensions\":{}}`)\n259|\t\t\t}, \"unknown member\"},\n260|\t\t\t{\"block null content\", func(in *CanonicalEventInput) {\n261|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":null}],\"extensions\":{}}`)\n262|\t\t\t}, \"not exclusive\"},\n263|\t\t\t{\"block null descriptor\", func(in *CanonicalEventInput) {\n264|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"blob_descriptor_id\":null}],\"extensions\":{}}`)\n265|\t\t\t}, \"not exclusive\"},\n266|\t\t\t{\"payload top-level duplicate\", func(in *CanonicalEventInput) {\n267|\t\t\t\tin.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"x\"}],\"extensions\":{},\"extensions\":{}}`)\n268|\t\t\t}, \"duplicate member\"},\n269|\t\t\t{\"ordinal overflow\", func(in *CanonicalEventInput) { in.Ordinal = maxUint53 + 1 }, \"exceeds uint53\"},\n270|\t\t\t{\"bad extensions\", func(in *CanonicalEventInput) { in.Extensions = map[string]any{\"no-dots\": 1} }, \"reverse-DNS\"},\n271|\t\t}\n272|\t\tfor _, tc := range cases {\n273|\t\t\tt.Run(tc.name, func(t *testing.T) {\n274|\t\t\t\tinput := validEventInput(\"exact\")\n275|\t\t\t\ttc.mutate(&input)\n276|\t\t\t\t_, err := BuildCanonicalEvent(input)\n277|\t\t\t\trequireRefusal(t, err, tc.fragment)\n278|\t\t\t})\n279|\t\t}\n280|\t\t// Inline content at exactly 64 KiB is admitted.\n281|\t\tinput := validEventInput(\"exact\")\n282|\t\tinput.Payload = []byte(`{\"content_blocks\":[{\"type\":\"text\",\"content\":\"` + strings.Repeat(\"y\", 65536) + `\"}],\"extensions\":{}}`)\n283|\t\tif _, err := BuildCanonicalEvent(input); err != nil {\n284|\t\t\tt.Fatalf(\"BuildCanonicalEvent(64 KiB inline) error = %v\", err)\n285|\t\t}\n286|\t})\n287|\tt.Run(\"decode\", func(t *testing.T) {\n288|\t\tvalid := mustEventBytes(t, \"exact\")\n289|\t\tcases := []struct {\n290|\t\t\tname     string\n291|\t\t\tbody     func(t *testing.T) []byte\n292|\t\t\tfragment string\n293|\t\t}{\n294|\t\t\t{\"unknown member\", func(t *testing.T) []byte {\n295|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"lease\"] = \"x\" })\n296|\t\t\t}, \"unknown member\"},\n297|\t\t\t{\"bad schema\", func(t *testing.T) []byte {\n298|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"schema\"] = \"urn:ax:schema:blob\" })\n299|\t\t\t}, \"not the canonical event\"},\n300|\t\t\t{\"bad kind\", func(t *testing.T) []byte {\n301|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"kind\"] = \"chat\" })\n302|\t\t\t}, \"26-kind\"},\n303|\t\t\t{\"ordinal float\", func(t *testing.T) []byte {\n304|\t\t\t\traw := strings.Replace(string(valid), `\"ordinal\":0`, `\"ordinal\":1.5`, 1)\n305|\t\t\t\treturn []byte(raw)\n306|\t\t\t}, \"not a uint53\"},\n307|\t\t\t{\"visibility secret\", func(t *testing.T) []byte {\n308|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"visibility\"] = \"secret\" })\n309|\t\t\t}, \"public|projection|internal|opaque\"},\n310|\t\t\t{\"parents duplicate\", func(t *testing.T) []byte {\n311|\t\t\t\tdigest := fixtureDigest(\"test-event-1\")\n312|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"parents\"] = []any{digest, digest} })\n313|\t\t\t}, \"sorted unique\"},\n314|\t\t\t{\"parents unsorted\", func(t *testing.T) []byte {\n315|\t\t\t\thigh, low := unsortedPair(\"unsorted-parent-a\", \"unsorted-parent-b\")\n316|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"parents\"] = []any{high, low} })\n317|\t\t\t}, \"sorted unique\"},\n318|\t\t\t{\"evidence status maybe\", func(t *testing.T) []byte {\n319|\t\t\t\treturn tamper(t,