 valid, func(o map[string]any) {\n350|\t\t\t\t\to[\"source_evidence\"].(map[string]any)[\"raw_refs\"] = make([]any, 65537)\n351|\t\t\t\t})\n352|\t\t\t}, \"maximum is 65536\"},\n353|\t\t\t{\"too many reason codes\", func(t *testing.T) []byte {\n354|\t\t\t\treturn tamper(t, valid, func(o map[string]any) {\n355|\t\t\t\t\tcodes := make([]any, 129)\n356|\t\t\t\t\tfor i := range codes {\n357|\t\t\t\t\t\tcodes[i] = fmt.Sprintf(\"code-%03d\", i)\n358|\t\t\t\t\t}\n359|\t\t\t\t\to[\"source_evidence\"].(map[string]any)[\"reason_codes\"] = codes\n360|\t\t\t\t})\n361|\t\t\t}, \"reason_codes\"},\n362|\t\t\t{\"self mismatch\", func(t *testing.T) []byte {\n363|\t\t\t\treturn tamper(t, valid, func(o map[string]any) { o[\"event_id\"] = fixtureDigest(\"forged\") })\n364|\t\t\t}, \"omit-self digest\"},\n365|\t\t}\n366|\t\tfor _, tc := range cases {\n367|\t\t\tt.Run(tc.name, func(t *testing.T) {\n368|\t\t\t\t_, err := DecodeCanonicalEvent(tc.body(t))\n369|\t\t\t\trequireRefusal(t, err, tc.fragment)\n370|\t\t\t})\n371|\t\t}\n372|\t})\n373|\tt.Run(\"evidence\", func(t *testing.T) {\n374|\t\tbuild := func(mutate func(*EvidenceInput)) error {\n375|\t\t\tinput := validEventInput(\"exact\")\n376|\t\t\tmutate(&input.Evidence)\n377|\t\t\t_, err := BuildCanonicalEvent(input)\n378|\t\t\treturn err\n379|\t\t}\n380|\t\tcases := []struct {\n381|\t\t\tname     string\n382|\t\t\tmutate   func(*EvidenceInput)\n383|\t\t\tfragment string\n384|\t\t}{\n385|\t\t\t{\"bad status\", func(ev *EvidenceInput) { ev.CaptureStatus = \"maybe\" }, \"exact|partial|synthesized|unavailable\"},\n386|\t\t\t{\"synthesized with native event\", func(ev *EvidenceInput) {\n387|\t\t\t\tev.CaptureStatus = \"synthesized\"\n388|\t\t\t\tev.CoreOperationID = strptr(fixtureOperationID)\n389|\t\t\t}, \"carries a native event ID\"},\n390|\t\t\t{\"synthesized missing operation\", func(ev *EvidenceInput) {\n391|\t\t\t\tev.CaptureStatus = \"synthesized\"\n392|\t\t\t\tev.NativeEventID = nil\n393|\t\t\t}, \"requires a core operation\"},\n394|\t\t\t{\"exact with operation\", func(ev *EvidenceInput) { ev.CoreOperationID = strptr(fixtureOperationID) }, \"carries a core operation\"},\n395|\t\t\t{\"bad tuple\", func(ev *EvidenceInput) { ev.Environment = []byte(`{}`) }, \"Environment Tuple\"},\n396|\t\t\t{\"unsanitized session\", func(ev *EvidenceInput) { ev.NativeSessionID = \"/abs\" }, \"absolute source path\"},\n397|\t\t\t{\"unsanitized event\", func(ev *EvidenceInput) { ev.NativeEventID = strptr(\"https://u:p@h/x\") }, \"embedded credentials\"},\n398|\t\t\t{\"refs unsorted\", func(ev *EvidenceInput) {\n399|\t\t\t\thigh, low := unsortedPair(\"unsorted-ref-a\", \"unsorted-ref-b\")\n400|\t\t\t\tev.RawRefs = []RawRefInput{\n401|\t\t\t\t\t{ManifestID: high, BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n402|\t\t\t\t\t{ManifestID: low, BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n403|\t\t\t\t}\n404|\t\t\t}, \"sorted unique\"},\n405|\t\t\t{\"refs dup\", func(ev *EvidenceInput) {\n406|\t\t\t\tev.RawRefs = []RawRefInput{\n407|\t\t\t\t\t{ManifestID: fixtureDigest(\"a\"), BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n408|\t\t\t\t\t{ManifestID: fixtureDigest(\"a\"), BlobDescriptorID: fixtureDigest(\"d\"), Offset: 0, Length: 1},\n409|\t\t\t\t}\n410|\t\t\t}, \"sorted unique\"},\n411|\t\t\t{\"ref bad manifest\", func(ev *EvidenceInput) { ev.RawRefs[0].ManifestID = \"nope\" }, \"not a digest\"},\n412|\t\t\t{\"ref offset overflow\", func(ev *EvidenceInput) { ev.RawRefs[0].Offset = maxUint53 + 1 }, \"exceeds uint53\"},\n413|\t\t\t{\"ref length overflow\", func(ev *EvidenceInput) { ev.RawRefs[0].Length = maxUint53 + 1 }, \"exceeds uint53\"},\n414|\t\t\t{\"reasons unsorted\", func(ev *EvidenceInput) { ev.ReasonCodes = []string{\"b\", \"a\"} }, \"sorted unique\"},\n415|\t\t\t{\"reasons duplicate\", func(ev *EvidenceInput) { ev.ReasonCodes = []string{\"a\", \"a\"} }, \"sorted unique\"},\n416|\t\t\t{\"reason empty\", func(ev *EvidenceInput) { ev.ReasonCodes = []string{\"\"} }, \"string[1..128]\"},\n417|\t\t\t{\"bad operation\", func(ev *EvidenceInput) {\n418|\t\t\t\tev.CaptureStatus = \"synthesized\"\n419|\t\t\t\tev.NativeEventID = nil\n420|\t\t\t\tev.CoreOperationID = strptr(\"nope\")\n421|\t\t\t}, \"not a UUIDv7\"},\n422|\t\t}\n423|\t\tfor _, tc := range cases {\n424|\t\t\tt.Run(tc.name, func(t *testing.T) {\n425|\t\t\t\trequireRefusal(t, build(tc.mutate), tc.fragment)\n426|\t\t\t})\n427|\t\t}\n428|\t\t// Decode-side evidence coupling.\n429|\t\tvalid := mustEventBytes(t, \"exact\")\n430|\t\ttampered := tamper(t, valid, func(o map[string]any) {\n431|\t\t\tevidence := o[\"source_evidence\"].(map[string]any)\n432|\t\t\tevidence[\"capture_status\"] = \"synthesized\"\n433|\t\t\tevidence[\"core_operation_id\"] = nil\n434|\t\t\tevidence[\"native_event_id\"] = nil\n435|\t\t})\n436|\t\tif _, err := DecodeCanonicalEvent(tampered); !errors.Is(err, ErrInvalid) {\n437|\t\t\tt.Fatalf(\"synthesized-without-operation decode error = %v, want ErrInvalid\", err)\n438|\t\t}\n439|\t})\n440|}\n441|\n442|func TestIdentityRefusals(t *testing.T) {\n443|\tt.Run(\"native identity\", func(t *testing.T) {\n444|\t\tencode := func(mutate func(map[string]any)) []byte {\n445|\t\t\tidentity := fixtureNativeIdentity()\n446|\t\t\tgeneration, err := EncodeNativeIdentity(identity, nil)\n447|\t\t\tif err != nil {\n448|\t\t\t\tt.Fatal(err)\n449|\t\t\t}\n(more lines below)","final_result":true}}}
