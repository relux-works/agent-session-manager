{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d087","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":1694,"recorded_at":1780531400003383,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3da-aab4-78c2-86b4-1025e0b0897c"},"task_id":"01a0b3da-aab4-78c2-86b4-1025e0b0897c","event":{"kind":"output","task_id":"01a0b3da-aab4-78c2-86b4-1025e0b0897c","chunk":"edited\nchanged lines: lines 50-95\n--- original\n+++ updated\n@@\n-// nativeEnvelope is the decoded envelope shape. Body stays raw:\n-// each known type validates its own exact members.\n-type nativeEnvelope struct {\n-\tVersion       json.Number     `json:\"v\"`\n-\tNativeEventID string          `json:\"native_event_id\"`\n-\tNativeType    string          `json:\"native_type\"`\n-\tOrigin        string          `json:\"origin\"`\n-\tProtection    string          `json:\"protection\"`\n-\tActor         string          `json:\"actor\"`\n-\tBody          json.RawMessage `json:\"body\"`\n-}\n-\n-// parseNativeLine parses one record line. A line that is not valid\n-// UTF-8, not a JSON object, or misses an envelope member refuses\n-// with the member and line named: malformed framing is an error,\n-// never an absent or guessed record.\n-func parseNativeLine(memberKey string, line int, offset uint64, raw []byte) (NativeRecord, error) {\n-\twhere := func() string {\n-\t\treturn \"record \" + memberKey + \" line \" + itoa(line)\n-\t}\n-\tif !utf8.Valid(raw) {\n-\t\treturn NativeRecord{}, invalid(\"%s is not valid UTF-8\", where())\n-\t}\n-\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n-\tdecoder.UseNumber()\n-\tvar members map[string]json.RawMessage\n-\tif err := decoder.Decode(&members); err != nil {\n-\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n-\t}\n-\tif decoder.More() {\n-\t\treturn NativeRecord{}, invalid(\"%s carries trailing bytes\", where())\n-\t}\n-\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\n-\t\tif _, ok := members[name]; !ok {\n-\t\t\treturn NativeRecord{}, invalid(\"%s misses envelope member %q\", where(), name)\n-\t\t}\n-\t}\n-\tvar envelope nativeEnvelope\n-\tstrict := json.NewDecoder(bytes.NewReader(raw))\n-\tstrict.UseNumber()\n-\tif err := strict.Decode(&envelope); err != nil {\n-\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n-\t}\n-\tif envelope.Version.String() != \"1\" {\n-\t\treturn NativeRecord{}, invalid(\"%s carries envelope version %q, want 1\", where(), envelope.Version.String())\n-\t}\n+// nativeEnvelope is the decoded envelope shape. Body stays raw:\n+// each known type validates its own exact members. The version\n+// member is read through the landed uint53 gate, never through a\n+// lenient number field: a string-typed version is not version 1.\n+type nativeEnvelope struct {\n+\tNativeEventID string          `json:\"native_event_id\"`\n+\tNativeType    string          `json:\"native_type\"`\n+\tOrigin        string          `json:\"origin\"`\n+\tProtection    string          `json:\"protection\"`\n+\tActor         string          `json:\"actor\"`\n+\tBody          json.RawMessage `json:\"body\"`\n+}\n+\n+// strictMembers decodes one strict JSON object through the landed\n+// environ gate: non-UTF-8 bytes, lone surrogate escapes, duplicate\n+// members, non-object top levels, and trailing data refuse here,\n+// before any member is read, so no decoded value can carry\n+// rewritten text or a guessed last-wins member. This package never\n+// decodes JSON past this gate: both callers (the record envelope\n+// and the per-kind bodies) refuse with the fault named.\n+func strictMembers(what string, raw []byte) (map[string]json.RawMessage, error) {\n+\tmembers, fault := environ.DecodeStrictObject(raw)\n+\tif fault == nil {\n+\t\treturn members, nil\n+\t}\n+\tif fault.Detail == environ.FaultNotObject {\n+\t\treturn nil, invalid(\"%s is not a JSON object: %v\", what, fault)\n+\t}\n+\treturn nil, invalid(\"%s is not a strict JSON object: %v\", what, fault)\n+}\n+\n+// parseNativeLine parses one record line. A line that is not valid\n+// UTF-8, not a strict JSON object (lone surrogate escape,\n+// duplicate member, trailing data), or misses an envelope member\n+// refuses with the member and line named: malformed framing is an\n+// error, never an absent or guessed record.\n+func parseNativeLine(memberKey string, line int, offset uint64, raw []byte) (NativeRecord, error) {\n+\twhere := func() string {\n+\t\treturn \"record \" + memberKey + \" line \" + itoa(line)\n+\t}\n+\tif !utf8.Valid(raw) {\n+\t\treturn NativeRecord{}, invalid(\"%s is not valid UTF-8\", where())\n+\t}\n+\tmembers, err := strictMembers(where(), raw)\n+\tif err != nil {\n+\t\treturn NativeRecord{}, err\n+\t}\n+\tfor _, name := range []string{\"v\", \"native_event_id\", \"native_type\", \"origin\", \"protection\", \"actor\", \"body\"} {\n+\t\tif _, ok := members[name]; !ok {\n+\t\t\treturn NativeRecord{}, invalid(\"%s misses envelope member %q\", where(), name)\n+\t\t}\n+\t}\n+\tvar envelope nativeEnvelope\n+\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n+\tif err := decoder.Decode(&envelope); err != nil {\n+\t\treturn NativeRecord{}, invalid(\"%s is not a JSON object: %v\", where(), err)\n+\t}\n+\tif _, ok := environ.CheckUint53Bounds(members[\"v\"], 1, 1); !ok {\n+\t\treturn NativeRecord{}, invalid(\"%s carries envelope version %q, want 1\", where(), string(members[\"v\"]))\n+\t}\n","final_result":true}}}
