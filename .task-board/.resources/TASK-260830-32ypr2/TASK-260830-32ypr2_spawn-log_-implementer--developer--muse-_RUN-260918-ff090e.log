, err)\n472|\t\t}\n473|\t})\n474|\tt.Run(\"bad_logical_session\", func(t *testing.T) {\n475|\t\tcapture, store := captureMembers(t, []fixtureMember{\n476|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n477|\t\t\t\tmessage(\"evt-badid\", `{\"text\":\"x\"}`),\n478|\t\t\t)},\n479|\t\t})\n480|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n481|\t\trequest.LogicalSessionID = \"not-a-uuid\"\n482|\t\t_, err := Normalize(request)\n483|\t\tif err == nil {\n484|\t\t\tt.Fatal(\"Normalize() admitted a non-UUIDv7 logical session\")\n485|\t\t}\n486|\t\tif !strings.Contains(err.Error(), \"is not a UUIDv7\") {\n487|\t\t\tt.Fatalf(\"Normalize() error = %v, want the UUID refusal\", err)\n488|\t\t}\n489|\t})\n490|}","final_result":true}}}
