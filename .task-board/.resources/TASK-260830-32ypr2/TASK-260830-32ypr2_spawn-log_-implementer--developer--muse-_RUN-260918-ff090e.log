ion\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being retired (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"reason\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Written reason the revision will never be integrated\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"withdraw_cr(STORY-260828-2xwsub, revision=1, reason=\\\\\\\"research-only run, zero repository delta, never routed to a reviewer\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false}},\\\"mutations\\\":[\\\"accept_cr\\\",\\\"add_checklist_item\\\",\\\"add_resource\\\",\\\"assign\\\",\\\"audit_context_validation\\\",\\\"check_item\\\",\\\"collect_context_retention\\\",\\\"confirm_context_reclamation\\\",\\\"correct_activity\\\",\\\"create\\\",\\\"defer_cr\\\",\\\"delete\\\",\\\"delete_resource\\\",\\\"handoff\\\",\\\"integrate_external\\\",\\\"link\\\",\\\"login\\\",\\\"logout\\\",\\\"mark_context_stale\\\",\\\"normalize_legacy_status\\\",\\\"publish_context\\\",\\\"reclassify_context\\\",\\\"record_ledger_event\\\",\\\"register_context\\\",\\\"remove_checklist_item\\\",\\\"rename\\\",\\\"retire_context\\\",\\\"retry_context_payload_withdrawal\\\",\\\"set_details\\\",\\\"set_estimate\\\",\\\"set_notes\\\",\\\"set_parent\\\",\\\"set_status\\\",\\\"sweep_context_retention\\\",\\\"sweep_context_validation_audits\\\",\\\"switch_user\\\",\\\"unassign\\\",\\\"uncheck_item\\\",\\\"undefer_cr\\\",\\\"unlink\\\",\\\"update_resource\\\",\\\"withdraw_cr\\\"],\\\"operationMetadata\\\":{\\\"activity\\\":{\\\"description\\\":\\\"Read bounded, cursor-paginated activity for one element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\"},{\\\"name\\\":\\\"cursor\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\