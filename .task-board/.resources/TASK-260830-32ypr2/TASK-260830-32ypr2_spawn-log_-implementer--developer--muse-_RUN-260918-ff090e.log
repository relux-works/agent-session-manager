{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82b","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":624,"recorded_at":1780531400001243,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d1-2f33-7d62-abf8-5c8d74d9bbf6"},"task_id":"01a0b3d1-2f33-7d62-abf8-5c8d74d9bbf6","event":{"kind":"output","task_id":"01a0b3d1-2f33-7d62-abf8-5c8d74d9bbf6","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/fidelity_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// Durability: Normalize holds no local state and its only durable\n10|// write is overflow-blob installation through the landed no-replace\n11|// discipline. A replay converges byte-identical (idempotent), and a\n12|// mid-projection failure returns no partial bundle.\n13|\n14|func TestNormalizeIsIdempotentIntoSharedSink(t *testing.T) {\n15|\toverflow := strings.Repeat(\"q\", 70000)\n16|\tmembers := []fixtureMember{\n17|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n18|\t\t\trec(\"evt-idem-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+overflow+`\"}`),\n19|\t\t\trec(\"evt-idem-2\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"small\"}`),\n20|\t\t)},\n21|\t}\n22|\tcapture, store := captureMembers(t, members)\n23|\tsink := openTestStore(t)\n24|\tfirst, err := Normalize(normalizeRequest(t, capture, store, sink))\n25|\tif err != nil {\n26|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n27|\t}\n28|\tblobsAfterFirst := len(listStoreBlobs(t, sink))\n29|\tsecond, err := Normalize(normalizeRequest(t, capture, store, sink))\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"Normalize() replay error = %v\", err)\n32|\t}\n33|\tif !bytes.Equal(first.Session, second.Session) {\n34|\t\tt.Fatal(\"replay sealed a different session\")\n35|\t}\n36|\tif len(first.Events) != len(second.Events) {\n37|\t\tt.Fatalf(\"replay event counts %d != %d\", len(first.Events), len(second.Events))\n38|\t}\n39|\tfor index := range first.Events {\n40|\t\tif !bytes.Equal(first.Events[index], second.Events[index]) {\n41|\t\t\tt.Fatalf(\"replay event[%d] differs\", index)\n42|\t\t}\n43|\t}\n44|\tif blobs := len(listStoreBlobs(t, sink)); blobs != blobsAfterFirst {\n45|\t\tt.Fatalf(\"sink blobs %d after replay, want %d: replay reinstalled instead of verifying\", blobs, blobsAfterFirst)\n46|\t}\n47|\tif len(first.Overflows) != 1 || len(second.Overflows) != 1 {\n48|\t\tt.Fatalf(\"overflows %d/%d, want 1/1\", len(first.Overflows), len(second.Overflows))\n49|\t}\n50|\tif first.Overflows[0].DescriptorID.String() != second.Overflows[0].DescriptorID.String() {\n51|\t\tt.Fatal(\"replay overflow descriptor differs\")\n52|\t}\n53|}\n54|\n55|func TestNormalizeFailureReturnsNoPartialBundle(t *testing.T) {\n56|\tmembers := []fixtureMember{\n57|\t\t{key: \"store/a.jsonl\", class: \"durable_payload\", content: jsonl(\n58|\t\t\trec(\"evt-part-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"one\"}`),\n59|\t\t)},\n60|\t\t{key: \"store/b.jsonl\", class: \"durable_payload\", content: jsonl(\n61|\t\t\trec(\"evt-part-2\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"two\"}`),\n62|\t\t)},\n63|\t}\n64|\tcapture, store := captureMembers(t, members)\n65|\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n66|\thealthy := request.Fetch\n67|\tcalls := 0\n68|\trequest.Fetch = func(blobID string) ([]byte, error) {\n69|\t\tcalls++\n70|\t\tif calls == 2 {\n71|\t\t\treturn nil, errFixtureGone\n72|\t\t}\n73|\t\treturn healthy(blobID)\n74|\t}\n75|\tresult, err := Normalize(request)\n76|\tif err == nil {\n77|\t\tt.Fatal(\"Normalize() admitted a mid-projection fetch failure\")\n78|\t}\n79|\tif result != nil {\n80|\t\tt.Fatal(\"Normalize() returned a partial bundle alongside the failure\")\n81|\t}\n82|\t// A healthy re-run over the same captured bytes converges.\n83|\tclean, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n84|\tif err != nil {\n85|\t\tt.Fatalf(\"Normalize() re-run error = %v\", err)\n86|\t}\n87|\tif len(clean.Events) != 2 {\n88|\t\tt.Fatalf(\"re-run events = %d, want 2\", len(clean.Events))\n89|\t}\n90|}","final_result":true}}}
