{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86f","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":658,"recorded_at":1780531400001311,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d1-3ed5-7030-80b4-6292b0ef0aac"},"task_id":"01a0b3d1-3ed5-7030-80b4-6292b0ef0aac","event":{"kind":"output","task_id":"01a0b3d1-3ed5-7030-80b4-6292b0ef0aac","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/tools_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// Invariant 3: historical tools are inert and incomplete calls never\n8|// become live actions. The matrix drives every pairing shape through\n9|// Normalize over real captured bytes and asserts the projected kind,\n10|// the visibility, the folded resolution, and the empty live surface.\n11|\n12|func TestNormalizeToolMatrix(t *testing.T) {\n13|\tcall := func(id, tool string) string {\n14|\t\treturn rec(\"evt-\"+id, \"tool/call\", \"native\", \"none\", \"main\",\n15|\t\t\t`{\"call_id\":\"`+id+`\",\"tool_name\":\"`+tool+`\"}`)\n16|\t}\n17|\tresult := func(id, status string) string {\n18|\t\treturn rec(\"evt-\"+id+\"-result\", \"tool/result\", \"native\", \"none\", \"main\",\n19|\t\t\t`{\"call_id\":\"`+id+`\",\"status\":\"`+status+`\"}`)\n20|\t}\n21|\tt.Run(\"call_with_result\", func(t *testing.T) {\n22|\t\tbundle := projectMembers(t, []fixtureMember{\n23|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n24|\t\t\t\tcall(\"call-1\", \"read\"),\n25|\t\t\t\tresult(\"call-1\", \"ok\"),\n26|\t\t\t)},\n27|\t\t})\n28|\t\tresolved := bundle.result\n29|\t\tif len(resolved.ToolResolutions) != 1 {\n30|\t\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 1\", len(resolved.ToolResolutions))\n31|\t\t}\n32|\t\tif resolved.ToolResolutions[0].Status != \"completed\" {\n33|\t\t\tt.Fatalf(\"Status = %q, want completed\", resolved.ToolResolutions[0].Status)\n34|\t\t}\n35|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-call-1\")\n36|\t\tif callEvent.Kind != \"tool_call\" {\n37|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n38|\t\t}\n39|\t\tif callEvent.Visibility != \"internal\" {\n40|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", callEvent.Visibility)\n41|\t\t}\n42|\t\tif payloadText(t, callEvent, \"resolution\") != \"completed\" {\n43|\t\t\tt.Fatalf(\"payload resolution = %q, want completed\", payloadText(t, callEvent, \"resolution\"))\n44|\t\t}\n45|\t\tif len(callEvent.Evidence.ReasonCodes) != 0 {\n46|\t\t\tt.Fatalf(\"ReasonCodes = %q, want empty for a completed call\", callEvent.Evidence.ReasonCodes)\n47|\t\t}\n48|\t\tresultEvent := eventByNativeID(t, resolved, \"evt-call-1-result\")\n49|\t\tif resultEvent.Kind != \"tool_result\" {\n50|\t\t\tt.Fatalf(\"Kind = %q, want tool_result\", resultEvent.Kind)\n51|\t\t}\n52|\t\tif payloadText(t, resultEvent, \"resolution\") != \"completed\" {\n53|\t\t\tt.Fatalf(\"payload resolution = %q, want completed\", payloadText(t, resultEvent, \"resolution\"))\n54|\t\t}\n55|\t\tif len(resolved.Live.CallableTools) != 0 || len(resolved.Live.PendingActions) != 0 {\n56|\t\t\tt.Fatalf(\"Live = %+v, want empty\", resolved.Live)\n57|\t\t}\n58|\t})\n59|\tt.Run(\"call_without_result\", func(t *testing.T) {\n60|\t\tbundle := projectMembers(t, []fixtureMember{\n61|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n62|\t\t\t\tcall(\"call-7\", \"write\"),\n63|\t\t\t)},\n64|\t\t})\n65|\t\tresolved := bundle.result\n66|\t\tif len(resolved.ToolResolutions) != 1 {\n67|\t\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 1\", len(resolved.ToolResolutions))\n68|\t\t}\n69|\t\tif resolved.ToolResolutions[0].Status != \"aborted\" {\n70|\t\t\tt.Fatalf(\"Status = %q, want aborted\", resolved.ToolResolutions[0].Status)\n71|\t\t}\n72|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-call-7\")\n73|\t\tif callEvent.Kind != \"tool_call\" {\n74|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n75|\t\t}\n76|\t\tif callEvent.Visibility != \"internal\" {\n77|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", callEvent.Visibility)\n78|\t\t}\n79|\t\tif payloadText(t, callEvent, \"resolution\") != \"aborted\" {\n80|\t\t\tt.Fatalf(\"payload resolution = %q, want aborted\", payloadText(t, callEvent, \"resolution\"))\n81|\t\t}\n82|\t\tif len(callEvent.Evidence.ReasonCodes) != 1 || callEvent.Evidence.ReasonCodes[0] != \"unsafe_pending_action\" {\n83|\t\t\tt.Fatalf(\"ReasonCodes = %q, want [unsafe_pending_action]\", callEvent.Evidence.ReasonCodes)\n84|\t\t}\n85|\t\tif len(resolved.Live.CallableTools) != 0 || len(resolved.Live.PendingActions) != 0 {\n86|\t\t\tt.Fatalf(\"Live = %+v, want empty\", resolved.Live)\n87|\t\t}\n88|\t})\n89|\tt.Run(\"result_without_call\", func(t *testing.T) {\n90|\t\tbundle := projectMembers(t, []fixtureMember{\n91|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n92|\t\t\t\tresult(\"call-ghost\", \"ok\"),\n93|\t\t\t)},\n94|\t\t})\n95|\t\tresolved := bundle.result\n96|\t\tif len(resolved.ToolResolutions) != 1 {\n97|\t\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 1\", len(resolved.ToolResolutions))\n98|\t\t}\n99|\t\tif resolved.ToolResolutions[0].Status != \"aborted\" {\n100|\t\t\tt.Fatalf(\"Status = %q, want aborted\", resolved.ToolResolutions[0].Status)\n101|\t\t}\n102|\t\torphan := eventByNativeID(t, resolved, \"evt-call-ghost-result\")\n103|\t\tif orphan.Kind != \"tool_result\" {\n104|\t\t\tt.Fatalf(\"Kind = %q, want tool_result\", orphan.Kind)\n105|\t\t}\n106|\t\tif orphan.Visibility != \"internal\" {\n107|\t\t\tt.Fatalf(\"Visibility = %q, want internal\", orphan.Visibility)\n108|\t\t}\n109|\t\tif payloadText(t, orphan, \"resolution\") != \"aborted\" {\n110|\t\t\tt.Fatalf(\"payload resolution = %q, want aborted\", payloadText(t, orphan, \"resolution\"))\n111|\t\t}\n112|\t\tif len(orphan.Evidence.ReasonCodes) != 1 || orphan.Evidence.ReasonCodes[0] != \"unsafe_pending_action\" {\n113|\t\t\tt.Fatalf(\"ReasonCodes = %q, want [unsafe_pending_action]\", orphan.Evidence.ReasonCodes)\n114|\t\t}\n115|\t\tif len(resolved.Live.CallableTools) != 0 || len(resolved.Live.PendingActions) != 0 {\n116|\t\t\tt.Fatalf(\"Live = %+v, want empty\", resolved.Live)\n117|\t\t}\n118|\t})\n119|\tt.Run(\"nested_subagent_call\", func(t *testing.T) {\n120|\t\tmembers := []fixtureMember{\n121|\t\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n122|\t\t\t\trec(\"evt-nested-call\", \"tool/call\", \"native\", \"none\", \"subagent:fetch\",\n123|\t\t\t\t\t`{\"call_id\":\"call-nested\",\"tool_name\":\"fetch\"}`),\n124|\t\t\t\trec(\"evt-nested-result\", \"tool/result\", \"native\", \"none\", \"subagent:fetch\",\n125|\t\t\t\t\t`{\"call_id\":\"call-nested\",\"status\":\"ok\"}`),\n126|\t\t\t)},\n127|\t\t}\n128|\t\tcapture, store := captureMembers(t, members)\n129|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n130|\t\trequest.Actors = map[string]string{\"subagent:fetch\": fixtureSubActor}\n131|\t\tresolved, err := Normalize(request)\n132|\t\tif err != nil {\n133|\t\t\tt.Fatalf(\"Normalize() error = %v\", err)\n134|\t\t}\n135|\t\tif len(resolved.ToolResolutions) != 1 || resolved.ToolResolutions[0].Status != \"completed\" {\n136|\t\t\tt.Fatalf(\"ToolResolutions = %+v, want one completed\", resolved.ToolResolutions)\n137|\t\t}\n138|\t\tcallEvent := eventByNativeID(t, resolved, \"evt-nested-call\")\n139|\t\tif callEvent.Kind != \"tool_call\" {\n140|\t\t\tt.Fatalf(\"Kind = %q, want tool_call\", callEvent.Kind)\n141|\t\t}\n142|\t\tif callEvent.ActorID.String() != fixtureSubActor {\n143|\t\t\tt.Fatalf(\"ActorID = %q, want the subagent actor %q\", callEvent.ActorID.String(), fixtureSubActor)\n144|\t\t}\n145|\t\tif callEvent.ActorID.String() == fixtureMainActor {\n146|\t\t\tt.Fatal(\"nested call was attributed to main instead of the subagent actor\")\n147|\t\t}\n148|\t\tsession := resolved.DecodedSession\n149|\t\tif len(session.Actors) != 2 {\n150|\t\t\tt.Fatalf(\"len(Actors) = %d, want main plus the subagent\", len(session.Actors))\n151|\t\t}\n152|\t\tsubagent := session.Actors[1]\n153|\t\tif subagent.Kind != \"subagent\" {\n154|\t\t\tt.Fatalf(\"Actors[1].Kind = %q, want subagent\", subagent.Kind)\n155|\t\t}\n156|\t\tif subagent.ParentActorID == nil || subagent.ParentActorID.String() != fixtureMainActor {\n157|\t\t\tt.Fatalf(\"subagent parent = %v, want main %q\", subagent.ParentActorID, fixtureMainActor)\n158|\t\t}\n159|\t\tif len(resolved.Live.CallableTools) != 0 || len(resolved.Live.PendingActions) != 0 {\n160|\t\t\tt.Fatalf(\"Live = %+v, want empty\", resolved.Live)\n161|\t\t}\n162|\t})\n163|}\n164|\n165|func TestNormalizeResultAfterBoundaryCompletes(t *testing.T) {\n166|\tcallLine := rec(\"evt-b-call\", \"tool/call\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-b\",\"tool_name\":\"write\"}`)\n167|\tresultLine := rec(\"evt-b-result\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-b\",\"status\":\"ok\"}`)\n168|\t// First capture: the call crossed the boundary, the result has\n169|\t// not arrived yet.\n170|\tearly := projectMembers(t, []fixtureMember{\n171|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(callLine)},\n172|\t})\n173|\tif len(early.result.ToolResolutions) != 1 || early.result.ToolResolutions[0].Status != \"aborted\" {\n174|\t\tt.Fatalf(\"early ToolResolutions = %+v, want one aborted\", early.result.ToolResolutions)\n175|\t}\n176|\t// Second capture over the later store: the result arrived, the\n177|\t// same call resolves completed.\n178|\tlate := projectMembers(t, []fixtureMember{\n179|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(callLine, resultLine)},\n180|\t})\n181|\tif len(late.result.ToolResolutions) != 1 || late.result.ToolResolutions[0].Status != \"completed\" {\n182|\t\tt.Fatalf(\"late ToolResolutions = %+v, want one completed\", late.result.ToolResolutions)\n183|\t}\n184|\tlateCall := eventByNativeID(t, late.result, \"evt-b-call\")\n185|\tif payloadText(t, lateCall, \"resolution\") != \"completed\" {\n186|\t\tt.Fatalf(\"late payload resolution = %q, want completed\", payloadText(t, lateCall, \"resolution\"))\n187|\t}\n188|\tif len(late.result.Live.PendingActions) != 0 {\n189|\t\tt.Fatalf(\"late PendingActions = %q, want empty\", late.result.Live.PendingActions)\n190|\t}\n191|}\n192|\n193|func TestNormalizeToolDefinitionNeverRegistersCallable(t *testing.T) {\n194|\tdigest := fixtureDigest(\"definition-bytes\")\n195|\tbundle := projectMembers(t, []fixtureMember{\n196|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n197|\t\t\trec(\"evt-def-1\", \"tool/definition\", \"native\", \"none\", \"main\",\n198|\t\t\t\t`{\"tool_name\":\"write\",\"definition_digest\":\"`+digest+`\"}`),\n199|\t\t)},\n200|\t})\n201|\tevent := eventByNativeID(t, bundle.result, \"evt-def-1\")\n202|\tif event.Kind != \"tool_definition_snapshot\" {\n203|\t\tt.Fatalf(\"Kind = %q, want tool_definition_snapshot\", event.Kind)\n204|\t}\n205|\tif event.Visibility != \"internal\" {\n206|\t\tt.Fatalf(\"Visibility = %q, want internal\", event.Visibility)\n207|\t}\n208|\tif payloadBool(t, event, \"callable\") {\n209|\t\tt.Fatal(\"payload callable is true: history registered a callable tool\")\n210|\t}\n211|\tif payloadText(t, event, \"tool_name\") != \"write\" {\n212|\t\tt.Fatalf(\"payload tool_name = %q, want write\", payloadText(t, event, \"tool_name\"))\n213|\t}\n214|\tif len(bundle.result.Live.CallableTools) != 0 {\n215|\t\tt.Fatalf(\"CallableTools = %q, want empty\", bundle.result.Live.CallableTools)\n216|\t}\n217|}\n218|\n219|func TestNormalizeLiveSurfaceStaysEmpty(t *testing.T) {\n220|\tbundle := projectMembers(t, []fixtureMember{\n221|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n222|\t\t\trec(\"evt-ls-def\", \"tool/definition\", \"native\", \"none\", \"main\",\n223|\t\t\t\t`{\"tool_name\":\"write\",\"definition_digest\":\"`+fixtureDigest(\"ls-def\")+`\"}`),\n224|\t\t\trec(\"evt-ls-call\", \"tool/call\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-ls\",\"tool_name\":\"write\"}`),\n225|\t\t\trec(\"evt-ls-result\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-ls\",\"status\":\"ok\"}`),\n226|\t\t\trec(\"evt-ls-dangling\", \"tool/call\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-dangling\",\"tool_name\":\"read\"}`),\n227|\t\t\trec(\"evt-ls-orphan\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"call-lost\",\"status\":\"error\"}`),\n228|\t\t)},\n229|\t})\n230|\tlive := bundle.result.Live\n231|\tif len(live.CallableTools) != 0 {\n232|\t\tt.Fatalf(\"CallableTools = %q, want empty\", live.CallableTools)\n233|\t}\n234|\tif len(live.PendingActions) != 0 {\n235|\t\tt.Fatalf(\"PendingActions = %q, want empty\", live.PendingActions)\n236|\t}\n237|\tif len(bundle.result.ToolResolutions) != 3 {\n238|\t\tt.Fatalf(\"len(ToolResolutions) = %d, want 3 (completed, aborted, orphan)\", len(bundle.result.ToolResolutions))\n239|\t}\n240|}","final_result":true}}}
