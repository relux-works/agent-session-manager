{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bb","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":440,"recorded_at":1780531400000875,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d0-d54b-7790-b302-9610ec9d5933"},"task_id":"01a0b3d0-d54b-7790-b302-9610ec9d5933","event":{"kind":"output","task_id":"01a0b3d0-d54b-7790-b302-9610ec9d5933","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/dispatch.go`.\n1|package cloneproject\n2|\n3|// This file dispatches projection units to Canonical Event kinds,\n4|// builds every event and the session through the landed builders,\n5|// and re-decodes each sealed byte before it enters the result.\n6|\n7|import (\n8|\t\"encoding/json\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// isReasoningType reports whether the native type is a reasoning\n17|// type. Protected reasoning becomes opaque_reasoning; protected\n18|// anything else becomes opaque_event.\n19|func isReasoningType(nativeType string) bool {\n20|\tswitch nativeType {\n21|\tcase nativeReasoningSummary, nativeReasoningCrypt, nativeReasoningSigned:\n22|\t\treturn true\n23|\tdefault:\n24|\t\treturn false\n25|\t}\n26|}\n27|\n28|// dispatchUnits selects kind, visibility, payload, and reasons for\n29|// every unit. Protection is decided before type: unreadable content\n30|// never reaches a semantic kind.\n31|func (plan *projectionPlan) dispatchUnits() error {\n32|\tresolutions := map[string]ToolResolution{}\n33|\tfor _, resolution := range plan.resolutions {\n34|\t\tresolutions[resolution.CallID] = resolution\n35|\t}\n36|\tfor index := range plan.units {\n37|\t\tunit := &plan.units[index]\n38|\t\tif unit.memberOpaque {\n39|\t\t\tunit.kind = \"opaque_event\"\n40|\t\t\tunit.visibility = \"opaque\"\n41|\t\t\tunit.payload = map[string]any{\n42|\t\t\t\t\"native_item_key\":    unit.record.MemberKey,\n43|\t\t\t\t\"byte_count\":         unit.record.Length,\n44|\t\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n45|\t\t\t\t\"extensions\":         map[string]any{},\n46|\t\t\t}\n47|\t\t\tunit.reasons = []string{reasonUnknownNative}\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\tif err := plan.dispatchRecord(unit, resolutions); err != nil {\n51|\t\t\treturn err\n52|\t\t}\n53|\t}\n54|\treturn nil\n55|}\n56|\n57|// dispatchRecord dispatches one parsed record.\n58|func (plan *projectionPlan) dispatchRecord(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n59|\trecord := unit.record\n60|\tif record.Protection != \"none\" {\n61|\t\treturn plan.dispatchProtected(unit)\n62|\t}\n63|\tswitch record.NativeType {\n64|\tcase nativeMessageUser, nativeMessageAssistant:\n65|\t\treturn plan.dispatchMessage(unit)\n66|\tcase nativeReasoningSummary:\n67|\t\treturn plan.dispatchMessage(unit)\n68|\tcase nativeReasoningCrypt, nativeReasoningSigned:\n69|\t\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n70|\t\treturn invalid(\"%s declares %s with no protection\", where, record.NativeType)\n71|\tcase nativeInstruction:\n72|\t\treturn plan.dispatchInstruction(unit)\n73|\tcase nativeToolDefinition:\n74|\t\treturn plan.dispatchDefinition(unit)\n75|\tcase nativeToolCall:\n76|\t\treturn plan.dispatchCall(unit, resolutions)\n77|\tcase nativeToolResult:\n78|\t\treturn plan.dispatchResult(unit, resolutions)\n79|\tcase nativeUsage:\n80|\t\treturn plan.dispatchUsage(unit)\n81|\tdefault:\n82|\t\tunit.kind = \"opaque_event\"\n83|\t\tunit.visibility = \"opaque\"\n84|\t\tunit.payload = map[string]any{\n85|\t\t\t\"native_type\":        record.NativeType,\n86|\t\t\t\"byte_count\":         record.Length,\n87|\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n88|\t\t\t\"extensions\":         map[string]any{},\n89|\t\t}\n90|\t\tunit.reasons = []string{reasonUnknownNative}\n91|\t\treturn nil\n92|\t}\n93|}\n94|\n95|// dispatchProtected dispatches a protected record: protection\n96|// defines the body shape (exactly ciphertext, never interpreted),\n97|// and the kind is opaque. Reasoning stays opaque_reasoning;\n98|// anything else becomes opaque_event.\n99|func (plan *projectionPlan) dispatchProtected(unit *projectionUnit) error {\n100|\trecord := unit.record\n101|\twhere := \"record \" + record.MemberKey + \" line \" + itoa(record.Line)\n102|\tif _, err := decodeProtectedBody(record); err != nil {\n103|\t\treturn err\n104|\t}\n105|\tswitch record.NativeType {\n106|\tcase nativeReasoningCrypt:\n107|\t\tif record.Protection != \"encrypted\" {\n108|\t\t\treturn invalid(\"%s declares reasoning/encrypted with protection %q\", where, record.Protection)\n109|\t\t}\n110|\tcase nativeReasoningSigned:\n111|\t\tif record.Protection != \"signed\" {\n112|\t\t\treturn invalid(\"%s declares reasoning/signed with protection %q\", where, record.Protection)\n113|\t\t}\n114|\t}\n115|\treasons := cryptoReasons(record)\n116|\tif !knownNativeType(record.NativeType) {\n117|\t\treasons = append(reasons, reasonUnknownNative)\n118|\t\tsort.Strings(reasons)\n119|\t}\n120|\tif isReasoningType(record.NativeType) {\n121|\t\tunit.kind = \"opaque_reasoning\"\n122|\t\tunit.visibility = \"opaque\"\n123|\t\tunit.payload = map[string]any{\n124|\t\t\t\"protection\":         record.Protection,\n125|\t\t\t\"byte_count\":         record.Length,\n126|\t\t\t\"blob_descriptor_id\": unit.descriptorID,\n127|\t\t\t\"extensions\":         map[string]any{},\n128|\t\t}\n129|\t\tunit.reasons = reasons\n130|\t\treturn nil\n131|\t}\n132|\tunit.kind = \"opaque_event\"\n133|\tunit.visibility = \"opaque\"\n134|\tunit.payload = map[string]any{\n135|\t\t\"native_type\":        record.NativeType,\n136|\t\t\"protection\":         record.Protection,\n137|\t\t\"byte_count\":         record.Length,\n138|\t\t\"blob_descriptor_id\": unit.descriptorID,\n139|\t\t\"extensions\":         map[string]any{},\n140|\t}\n141|\tunit.reasons = reasons\n142|\treturn nil\n143|}\n144|\n145|// cryptoReasons selects the stable reason for a protected record:\n146|// the foreign core reason when the origin is foreign, no reason\n147|// when native (no core code fits native-protected content; the\n148|// payload protection fact carries the cause).\n149|func cryptoReasons(record NativeRecord) []string {\n150|\tif record.Origin != \"foreign\" {\n151|\t\treturn nil\n152|\t}\n153|\tif record.Protection == \"signed\" {\n154|\t\treturn []string{reasonForeignSigned}\n155|\t}\n156|\treturn []string{reasonForeignEncrypted}\n157|}\n158|\n159|// dispatchMessage dispatches a message or reasoning summary: the\n160|// exact text body becomes one text content block, inline or\n161|// overflow-referenced.\n162|func (plan *projectionPlan) dispatchMessage(unit *projectionUnit) error {\n163|\trecord := unit.record\n164|\tbody, err := decodeMessageBody(record)\n165|\tif err != nil {\n166|\t\treturn err\n167|\t}\n168|\tblock, installed, err := contentBlockForText(body.Text, plan.request.CanonicalSink)\n169|\tif err != nil {\n170|\t\treturn err\n171|\t}\n172|\tplan.overflows = append(plan.overflows, installed...)\n173|\tswitch record.NativeType {\n174|\tcase nativeMessageUser:\n175|\t\tunit.kind = \"user_message\"\n176|\t\tunit.visibility = \"public\"\n177|\tcase nativeMessageAssistant:\n178|\t\tunit.kind = \"assistant_message\"\n179|\t\tunit.visibility = \"public\"\n180|\tdefault:\n181|\t\tunit.kind = \"reasoning_summary\"\n182|\t\tunit.visibility = \"internal\"\n183|\t}\n184|\tunit.payload = map[string]any{\n185|\t\t\"content_blocks\": []any{block},\n186|\t\t\"extensions\":     map[string]any{},\n187|\t}\n188|\treturn nil\n189|}\n190|\n191|// dispatchInstruction dispatches an instruction snapshot: foreign\n192|// instructions pin low authority, native instructions carry their\n193|// claimed authority.\n194|func (plan *projectionPlan) dispatchInstruction(unit *projectionUnit) error {\n195|\trecord := unit.record\n196|\tbody := unit.instruction\n197|\tauthority := body.Authority\n198|\tif record.Origin != \"native\" {\n199|\t\tauthority = \"low\"\n200|\t}\n201|\tdirectives := make([]any, 0, len(body.Directives))\n202|\tfor _, directive := range body.Directives {\n203|\t\tdirectives = append(directives, directive)\n204|\t}\n205|\tunit.kind = \"instruction_snapshot\"\n206|\tunit.visibility = \"internal\"\n207|\tunit.payload = map[string]any{\n208|\t\t\"authority\":  authority,\n209|\t\t\"directives\": directives,\n210|\t\t\"extensions\": map[string]any{},\n211|\t}\n212|\treturn nil\n213|}\n214|\n215|// dispatchDefinition dispatches a tool definition snapshot: history\n216|// with callable pinned false. Registration never happens here; the\n217|// live surface refused live claims before dispatch ran.\n218|func (plan *projectionPlan) dispatchDefinition(unit *projectionUnit) error {\n219|\tbody := unit.definition\n220|\tunit.kind = \"tool_definition_snapshot\"\n221|\tunit.visibility = \"internal\"\n222|\tunit.payload = map[string]any{\n223|\t\t\"tool_name\":         body.ToolName,\n224|\t\t\"definition_digest\": body.DefinitionHash,\n225|\t\t\"callable\":          false,\n226|\t\t\"extensions\":        map[string]any{},\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// dispatchCall dispatches a tool call with its folded resolution.\n232|func (plan *projectionPlan) dispatchCall(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n233|\tbody := unit.call\n234|\tresolution, ok := resolutions[body.CallID]\n235|\tif !ok {\n236|\t\treturn invalid(\"tool call %q has no folded resolution\", body.CallID)\n237|\t}\n238|\tunit.kind = \"tool_call\"\n239|\tunit.visibility = \"internal\"\n240|\tunit.payload = map[string]any{\n241|\t\t\"call_id\":    body.CallID,\n242|\t\t\"tool_name\":  body.ToolName,\n243|\t\t\"resolution\": resolution.Status,\n244|\t\t\"extensions\": map[string]any{},\n245|\t}\n246|\tif resolution.Status == StatusAborted {\n247|\t\tunit.reasons = []string{reasonUnsafePending}\n248|\t}\n249|\treturn nil\n250|}\n251|\n252|// dispatchResult dispatches a tool result with its folded\n253|// resolution: completed when paired, aborted history when orphaned.\n254|func (plan *projectionPlan) dispatchResult(unit *projectionUnit, resolutions map[string]ToolResolution) error {\n255|\tbody := unit.result\n256|\tresolution, ok := resolutions[body.CallID]\n257|\tif !ok {\n258|\t\treturn invalid(\"tool result %q has no folded resolution\", body.CallID)\n259|\t}\n260|\tunit.kind = \"tool_result\"\n261|\tunit.visibility = \"internal\"\n262|\tunit.payload = map[string]any{\n263|\t\t\"call_id\":    body.CallID,\n264|\t\t\"status\":     body.Status,\n265|\t\t\"resolution\": resolution.Status,\n266|\t\t\"extensions\": map[string]any{},\n267|\t}\n268|\tif resolution.Status == StatusAborted {\n269|\t\tunit.reasons = []string{reasonUnsafePending}\n270|\t}\n271|\treturn nil\n272|}\n273|\n274|// dispatchUsage dispatches a usage report: source tokens into the\n275|// payload; target accounting is never written anywhere.\n276|func (plan *projectionPlan) dispatchUsage(unit *projectionUnit) error {\n277|\tbody := unit.usage\n278|\tunit.kind = \"usage\"\n279|\tunit.visibility = \"internal\"\n280|\tunit.payload = map[string]any{\n281|\t\t\"input_tokens\":  body.InputTokens,\n282|\t\t\"output_tokens\": body.OutputTokens,\n283|\t\t\"extensions\":    map[string]any{},\n284|\t}\n285|\treturn nil\n286|}\n287|\n288|// actorSet is the resolved actor UUIDs by selector.\n289|type actorSet struct {\n290|\tmain  scalar.UUIDv7\n291|\textra map[string]scalar.UUIDv7\n292|}\n293|\n294|// checkActors resolves every referenced selector: main plus exactly\n295|// the mapped extras. A referenced selector without a mapping, or a\n296|// mapping without a reference, refuses.\n297|func (plan *projectionPlan) checkActors() error {\n298|\treferenced := map[string]bool{}\n299|\tfor _, unit := range plan.units {\n300|\t\treferenced[unit.record.Actor] = true\n301|\t}\n302|\tfor selector := range referenced {\n303|\t\tif selector == \"main\" {\n304|\t\t\tcontinue\n305|\t\t}\n306|\t\tif _, ok := plan.extraActors[selector]; !ok {\n307|\t\t\treturn invalid(\"projection references actor %q with no mapped UUID\", selector)\n308|\t\t}\n309|\t}\n310|\tfor selector := range plan.extraActors {\n311|\t\tif !referenced[selector] {\n312|\t\t\treturn invalid(\"projection maps actor %q with no referencing record\", selector)\n313|\t\t}\n314|\t}\n315|\treturn nil\n316|}\n317|\n318|// buildEvents dispatches every unit and seals the events in record\n319|// order: contiguous ordinals from zero, each event parented on its\n320|// predecessor, each sealed byte re-decoded before use.\n321|func (plan *projectionPlan) buildEvents() error {\n322|\tif err := plan.dispatchUnits(); err != nil {\n323|\t\treturn err\n324|\t}\n325|\tactors := actorSet{main: plan.mainActor, extra: plan.extraActors}\n326|\tvar previous *scalar.Digest\n327|\tfor index := range plan.units {\n328|\t\tunit := &plan.units[index]\n329|\t\tactor, ok := actors.extra[unit.record.Actor]\n330|\t\tif unit.record.Actor == \"main\" {\n331|\t\t\tactor, ok = actors.main, true\n332|\t\t}\n333|\t\tif !ok {\n334|\t\t\treturn invalid(\"projection cannot resolve actor %q to a mapped UUID\", unit.record.Actor)\n335|\t\t}\n336|\t\tparents := []string{}\n337|\t\tif previous != nil {\n338|\t\t\tparents = []string{previous.String()}\n339|\t\t}\n340|\t\tpayload, err := json.Marshal(unit.payload)\n341|\t\tif err != nil {\n342|\t\t\treturn invalid(\"projection cannot marshal event payload: %v\", err)\n343|\t\t}\n344|\t\tinput := clonebundle.CanonicalEventInput{\n345|\t\t\tLogicalSessionID: plan.logical.String(),\n346|\t\t\tOrdinal:          uint64(index),\n347|\t\t\tParents:          parents,\n348|\t\t\tActorID:          actor.String(),\n349|\t\t\tKind:             unit.kind,\n350|\t\t\tVisibility:       unit.visibility,\n351|\t\t\tPayload:          payload,\n352|\t\t\tEvidence:         plan.evidenceFor(unit),\n353|\t\t\tExtensions:       map[string]any{},\n354|\t\t}\n355|\t\tsealed, err := clonebundle.BuildCanonicalEvent(input)\n356|\t\tif err != nil {\n357|\t\t\treturn invalid(\"projection cannot seal ordinal %d (%s): %v\", index, unit.kind, err)\n358|\t\t}\n359|\t\tdecoded, err := clonebundle.DecodeCanonicalEvent(sealed)\n360|\t\tif err != nil {\n361|\t\t\treturn invalid(\"sealed ordinal %d refused: %v\", index, err)\n362|\t\t}\n363|\t\tplan.events = append(plan.events, sealed)\n364|\t\tplan.decodedEvents = append(plan.decodedEvents, decoded)\n365|\t\tplan.ordinals = append(plan.ordinals, uint64(index))\n366|\t\tidentifier := decoded.EventID\n367|\t\tprevious = &identifier\n368|\t}\n369|\tif err := clonebundle.CheckOrdinalContiguity(plan.ordinals); err != nil {\n370|\t\treturn err\n371|\t}\n372|\treturn nil\n373|}\n374|\n375|// evidenceFor builds the Source Evidence input for one unit: exact\n376|// capture status with the record's byte range inside its member\n377|// blob, so every reference resolves back to captured bytes.\n378|func (plan *projectionPlan) evidenceFor(unit *projectionUnit) clonebundle.EvidenceInput {\n379|\trecord := unit.record\n380|\tinput := clonebundle.EvidenceInput{\n381|\t\tEnvironment:     plan.environment,\n382|\t\tNativeSessionID: plan.raw.SourceNativeSessionID,\n383|\t\tRawRefs: []clonebundle.RawRefInput{{\n384|\t\t\tManifestID:       plan.raw.ManifestID.String(),\n385|\t\t\tBlobDescriptorID: unit.descriptorID,\n386|\t\t\tOffset:           record.Offset,\n387|\t\t\tLength:           record.Length,\n388|\t\t}},\n389|\t\tCaptureStatus: \"exact\",\n390|\t\tReasonCodes:   append([]string(nil), unit.reasons...),\n391|\t}\n392|\tif !unit.memberOpaque {\n393|\t\teventID := record.NativeEventID\n394|\t\tnativeType := record.NativeType\n395|\t\tinput.NativeEventID = &eventID\n396|\t\tinput.NativeType = &nativeType\n397|\t}\n398|\treturn input\n399|}\n400|\n401|// buildResult seals the Canonical Session over the projected\n402|// events: main plus exactly the referenced extras (parented on\n403|// main), ordinal-ordered event IDs, the last event as head.\n404|func (plan *projectionPlan) buildResult() (*NormalizeResult, error) {\n405|\tmain := plan.mainActor.String()\n406|\tinputs := []clonebundle.ActorInput{{\n407|\t\tActorID: main,\n408|\t\tKind:    \"main\",\n409|\t}}\n410|\tselectors := make([]string, 0, len(plan.extraActors))\n411|\tfor selector := range plan.extraActors {\n412|\t\tselectors = append(selectors, selector)\n413|\t}\n414|\tsort.Strings(selectors)\n415|\tfor _, selector := range selectors {\n416|\t\tname := selector\n417|\t\tkind := \"external\"\n418|\t\tif strings.HasPrefix(selector, \"subagent:\") {\n419|\t\t\tkind = \"subagent\"\n420|\t\t}\n421|\t\tparent := main\n422|\t\tinputs = append(inputs, clonebundle.ActorInput{\n423|\t\t\tActorID:        plan.extraActors[selector].String(),\n424|\t\t\tKind:           kind,\n425|\t\t\tParentActorID:  &parent,\n426|\t\t\tName:           &name,\n427|\t\t\tSourceNativeID: &name,\n428|\t\t})\n429|\t}\n430|\teventIDs := make([]string, 0, len(plan.decodedEvents))\n431|\tfor _, decoded := range plan.decodedEvents {\n432|\t\teventIDs = append(eventIDs, decoded.EventID.String())\n433|\t}\n434|\t// Unreachable: Normalize refused the empty projection before\n435|\t// dispatch ran. The guard keeps a headless build a builder\n436|\t// refusal instead of an index panic.\n437|\theads := []string{}\n438|\tif len(eventIDs) > 0 {\n439|\t\theads = []string{eventIDs[len(eventIDs)-1]}\n440|\t}\n441|\tsession, err := clonebundle.BuildCanonicalSession(clonebundle.CanonicalSessionInput{\n442|\t\tLogicalSessionID:      plan.logical.String(),\n443|\t\tSourceEnvironment:     plan.environment,\n444|\t\tSourceNativeSessionID: plan.raw.SourceNativeSessionID,\n445|\t\tTitle:                 plan.request.Title,\n446|\t\tWorkspace:             plan.request.Workspace,\n447|\t\tActors:                inputs,\n448|\t\tEventIDs:              eventIDs,\n449|\t\tHeadEventIDs:          heads,\n450|\t\tExtensions:            map[string]any{},\n451|\t})\n452|\tif err != nil {\n453|\t\treturn nil, invalid(\"projection cannot seal its session: %v\", err)\n454|\t}\n455|\tdecoded, err := clonebundle.DecodeCanonicalSession(session)\n456|\tif err != nil {\n457|\t\treturn nil, invalid(\"sealed session refused: %v\", err)\n458|\t}\n459|\treturn &NormalizeResult{\n460|\t\tSession:         session,\n461|\t\tDecodedSession:  decoded,\n462|\t\tEvents:          plan.events,\n463|\t\tDecodedEvents:   plan.decodedEvents,\n464|\t\tToolResolutions: plan.resolutions,\n465|\t\tLive:            plan.surface,\n466|\t\tInstruction:     plan.instruction,\n467|\t\tUsage:           plan.usage,\n468|\t\tOverflows:       plan.overflows,\n469|\t}, nil\n470|}","final_result":true}}}
