{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdc3","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":1340,"recorded_at":1780531400002675,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d7-39fa-7563-9303-98385c40ef26"},"task_id":"01a0b3d7-39fa-7563-9303-98385c40ef26","event":{"kind":"output","task_id":"01a0b3d7-39fa-7563-9303-98385c40ef26","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/traceability/cmd/tracecheck/readme_coverage_pin_test.go`.\n1|package main\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/traceability\"\n14|)\n15|\n16|// measuredCoverageAnchor is the README subsection this test pins to the\n17|// tracecheck report. It is matched exactly, so renaming the heading reddens\n18|// here instead of silently exempting the subsection from measurement.\n19|const measuredCoverageAnchor = \"### Measured coverage of this repository\"\n20|\n21|// coverageNumberWords decodes the spelled-out figures the subsection\n22|// publishes. The map is closed: a figure spelled a new way fails the lookup\n23|// instead of passing against a guessed value.\n24|var coverageNumberWords = map[string]int{\n25|\t\"two\":         2,\n26|\t\"four\":        4,\n27|\t\"five\":        5,\n28|\t\"six\":         6,\n29|\t\"seven\":       7,\n30|\t\"eight\":       8,\n31|\t\"forty-nine\":  49,\n32|\t\"forty-seven\": 47,\n33|\t\"fifty-two\":   52,\n34|\t\"twelve\":      12,\n35|\t\"sixty-eight\": 68,\n36|}\n37|\n38|// TestREADMEMeasuredCoverageMatchesTracecheckReport pins the README \"Measured\n39|// coverage of this repository\" subsection to the tracecheck report measured\n40|// on the current tree. The fenced `section coverage:` line must equal the\n41|// tool's own output line byte-for-byte, and every headline prose figure must\n42|// equal the Report field it restates.\n43|//\n44|// Per-section ratios inside the subsection (13.13 at 9/11 and the like) are\n45|// deliberately not re-derived here: TestCatalogSectionBindingCoverageIsExact-\n46|// AndDoesNotClaimUnimplementedScope already pins each binding's measured\n47|// ratio through the production entry point, and duplicating that table would\n48|// test the copy, not the prose. The historical \"13 sections added by v0.6.0\"\n49|// sentence is likewise out of scope: it states history, not the measured\n50|// report.\n51|func TestREADMEMeasuredCoverageMatchesTracecheckReport(t *testing.T) {\n52|\tt.Parallel()\n53|\n54|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n55|\n56|\tvar output bytes.Buffer\n57|\tif err := run([]string{\"-root\", repositoryRoot}, &output); err != nil {\n58|\t\tt.Fatalf(\"run() error = %v\", err)\n59|\t}\n60|\tlines := strings.Split(strings.TrimSuffix(output.String(), \"\\n\"), \"\\n\")\n61|\tif len(lines) != 2 {\n62|\t\tt.Fatalf(\"run() printed %d lines, want the 2-line tracecheck report\", len(lines))\n63|\t}\n64|\tif !strings.HasPrefix(lines[1], \"section coverage: \") {\n65|\t\tt.Fatalf(\"run() second line = %q, want the section coverage line\", lines[1])\n66|\t}\n67|\n68|\treport, err := traceability.VerifyRepository(os.DirFS(repositoryRoot))\n69|\tif err != nil {\n70|\t\tt.Fatalf(\"VerifyRepository() error = %v\", err)\n71|\t}\n72|\n73|\tsubsection, start := measuredCoverageSubsection(t, repositoryRoot)\n74|\tassertFencedCoverageLine(t, subsection, start, lines[1])\n75|\tprose := strings.Join(subsection, \" \")\n76|\n77|\tassertProseFigure(t, prose, start, `(\\S+) section bindings discharge ([0-9]+) of the ([0-9]+) normative clauses`,\n78|\t\t[]int{report.SectionBindings, report.DischargedClauses, report.NormativeClauses})\n79|\tassertProseFigure(t, prose, start, `(Four) bindings are `+\"`full`\", []int{report.FullCoverage})\n80|\tassertProseFigure(t, prose, start, `(eight) are `+\"`partial`\", []int{report.PartialCoverage})\n81|\tassertProseFigure(t, prose, start, `(five) are `+\"`sliver`\", []int{report.SliverCoverage})\n82|\tassertProseFigure(t, prose, start, `(four) are `+\"`unmeasured`\", []int{report.UnmeasuredCoverage})\n83|\tassertProseFigure(t, prose, start, `(forty-seven) are `+\"`unevidenced`\", []int{report.UnevidencedCoverage})\n84|\tassertProseFigure(t, prose, start, `(Seven) sections are recorded unowned`, []int{report.UnownedSections})\n85|\n86|\tfullBindings, fullClauses := fullBindingTotals(t, repositoryRoot)\n87|\tif fullBindings != report.FullCoverage {\n88|\t\tt.Fatalf(\"registry declares %d full bindings, VerifyRepository measures %d\", fullBindings, report.FullCoverage)\n89|\t}\n90|\tassertProseFigure(t, prose, start, `(Four) admitted bindings out of (sixty-eight) cover (twelve) clauses`,\n91|\t\t[]int{report.FullCoverage, report.SectionBindings, fullClauses})\n92|}\n93|\n94|// measuredCoverageSubsection returns the subsection lines under the anchor,\n95|// stopping before the next heading. A missing anchor, a duplicated anchor,\n96|// or a subsection that runs to end of file without a closing heading is a\n97|// red: each shape would otherwise silently change what this test measures.\n98|func measuredCoverageSubsection(t *testing.T, repositoryRoot string) ([]string, int) {\n99|\tt.Helper()\n100|\n101|\treadme, err := os.ReadFile(filepath.Join(repositoryRoot, \"README.md\"))\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"read README.md: %v\", err)\n104|\t}\n105|\tlines := strings.Split(string(readme), \"\\n\")\n106|\tanchor := -1\n107|\tfor index, line := range lines {\n108|\t\tif strings.TrimSpace(line) == measuredCoverageAnchor {\n109|\t\t\tif anchor >= 0 {\n110|\t\t\t\tt.Fatalf(\"README carries %q twice, at lines %d and %d\", measuredCoverageAnchor, anchor+1, index+1)\n111|\t\t\t}\n112|\t\t\tanchor = index\n113|\t\t}\n114|\t}\n115|\tif anchor < 0 {\n116|\t\tt.Fatalf(\"README no longer carries %q\", measuredCoverageAnchor)\n117|\t}\n118|\tend := -1\n119|\tfor index := anchor + 1; index < len(lines); index++ {\n120|\t\ttrimmed := strings.TrimSpace(lines[index])\n121|\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"### \") {\n122|\t\t\tend = index\n123|\t\t\tbreak\n124|\t\t}\n125|\t}\n126|\tif end < 0 {\n127|\t\tt.Fatalf(\"README subsection %q runs to end of file without a closing heading\", measuredCoverageAnchor)\n128|\t}\n129|\treturn lines[anchor+1 : end], anchor + 2\n130|}\n131|\n132|// assertFencedCoverageLine requires the subsection to carry exactly one\n133|// fenced block and its content to equal the tool's coverage line\n134|// byte-for-byte: no rewording, no reordered fields, no rounding.\n135|func assertFencedCoverageLine(t *testing.T, subsection []string, start int, want string) {\n136|\tt.Helper()\n137|\n138|\tvar fences []int\n139|\tfor offset, line := range subsection {\n140|\t\ttrimmed := strings.TrimSpace(line)\n141|\t\tif trimmed == \"```text\" || trimmed == \"```\" {\n142|\t\t\tfences = append(fences, offset)\n143|\t\t}\n144|\t}\n145|\tif len(fences) != 2 || strings.TrimSpace(subsection[fences[0]]) != \"```text\" {\n146|\t\tt.Fatalf(\"README subsection at line %d carries %d fence lines, want exactly one ```text block\", start, len(fences))\n147|\t}\n148|\tgot := strings.Join(subsection[fences[0]+1:fences[1]], \"\\n\")\n149|\tif got != want {\n150|\t\tt.Fatalf(\"README fenced coverage line = %q, tracecheck printed %q\", got, want)\n151|\t}\n152|}\n153|\n154|// assertProseFigure requires the pattern to match the unwrapped subsection\n155|// exactly once and each capture to equal the measured figure. A capture that\n156|// is all digits compares numerically; any other capture decodes through the\n157|// closed number-word map.\n158|func assertProseFigure(t *testing.T, prose string, start int, pattern string, want []int) {\n159|\tt.Helper()\n160|\n161|\tmatches := regexp.MustCompile(pattern).FindAllStringSubmatch(prose, -1)\n162|\tif len(matches) != 1 {\n163|\t\tt.Fatalf(\"README subsection at line %d matches %q %d times, want exactly 1\", start, pattern, len(matches))\n164|\t}\n165|\tif len(matches[0])-1 != len(want) {\n166|\t\tt.Fatalf(\"README pattern %q captures %d figures, want %d\", pattern, len(matches[0])-1, len(want))\n167|\t}\n168|\tfor index, raw := range matches[0][1:] {\n169|\t\tvar published int\n170|\t\tif value, err := strconv.Atoi(raw); err == nil {\n171|\t\t\tpublished = value\n172|\t\t} else if value, ok := coverageNumberWords[strings.ToLower(raw)]; ok {\n173|\t\t\tpublished = value\n174|\t\t} else {\n175|\t\t\tt.Fatalf(\"README subsection at line %d spells a figure %q the closed map does not decode\", start, raw)\n176|\t\t}\n177|\t\tif published != want[index] {\n178|\t\t\tt.Fatalf(\"README subsection at line %d publishes %d for %q; measured %d\", start, published, pattern, want[index])\n179|\t\t}\n180|\t}\n181|}\n182|\n183|// fullBindingTotals re-derives the admitted-sentence figures from the\n184|// reviewed registry: how many section bindings declare full coverage and how\n185|// many discharged clauses they enumerate. The gate has already verified each\n186|// clause against the pinned document (VerifyRepository is green in this\n187|// test), so the sum is measured evidence, not a restated claim.\n188|func fullBindingTotals(t *testing.T, repositoryRoot string) (int, int) {\n189|\tt.Helper()\n190|\n191|\traw, err := os.ReadFile(filepath.Join(repositoryRoot, \"internal\", \"traceability\", \"ownership.v0.7.0.json\"))\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"read adopted ownership registry: %v\", err)\n194|\t}\n195|\tvar registry struct {\n196|\t\tOwnership []struct {\n197|\t\t\tKind     string `json:\"kind\"`\n198|\t\t\tCoverage string `json:\"coverage\"`\n199|\t\t\tClauses  []struct {\n200|\t\t\t\tID string `json:\"id\"`\n201|\t\t\t} `json:\"clauses\"`\n202|\t\t} `json:\"ownership\"`\n203|\t}\n204|\tif err := json.Unmarshal(raw, &registry); err != nil {\n205|\t\tt.Fatalf(\"decode adopted ownership registry: %v\", err)\n206|\t}\n207|\tbindings, clauses := 0, 0\n208|\tfor _, group := range registry.Ownership {\n209|\t\tif group.Kind != \"section_binding\" || group.Coverage != \"full\" {\n210|\t\t\tcontinue\n211|\t\t}\n212|\t\tbindings++\n213|\t\tclauses += len(group.Clauses)\n214|\t}\n215|\treturn bindings, clauses\n216|}","final_result":true}}}
