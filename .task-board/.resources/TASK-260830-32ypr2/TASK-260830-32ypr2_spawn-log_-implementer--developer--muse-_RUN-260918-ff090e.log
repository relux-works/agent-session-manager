ndProject() = %+v, want a target refusal\\\", projected)\\n\\t\\t}\\n\\t\\t// Archive-only output never enters a target branch: the\\n\\t\\t// refusal leaves the target sink empty, not only unadmitted.\\n\\t\\tif blobs := listStoredBlobs(t, targetSink); len(blobs) != 0 {\\n\\t\\t\\tt.Fatalf(\\\"refused archive capture wrote %d blobs to the target sink, want none\\\", len(blobs))\\n\\t\\t}\\n=== operations 525,555 ===\\n\\t\\t}\\n\\t\\treturn failure\\n\\t}\\n\\treturn nil\\n}\\n\\n// fidelityProfiles is the four-profile vocabulary Section 7.8\\n// states. archive_only is a strategy, never a profile. Membership\\n// is a table loop so the census derives it like every other\\n// closed vocabulary.\\nvar fidelityProfiles = []string{\\n\\t\\\"strict_exact\\\",\\n\\t\\\"maximal_safe\\\",\\n\\t\\\"compact\\\",\\n\\t\\\"messages_only\\\",\\n}\\n\\n// validFidelityProfile reports whether the profile is one of the\\n// four Section 7.8 fidelity profiles. archive_only is a strategy,\\n// never a profile.\\nfunc validFidelityProfile(profile string) bool {\\n\\tfor _, allowed := range fidelityProfiles {\\n\\t\\tif profile == allowed {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n// validateModes is the three-mode validate vocabulary.\\nvar validateModes = []string{\\\"staged\\\", \\\"live\\\", \\\"archive\\\"}\\ninternal/clonesnap/capture_test.go:225:\\tif _, err := AdmitForTarget(result.CaptureManifest, \\\"strict_exact\\\"); err != nil {\\ninternal/clonesnap/capture_test.go:226:\\t\\tt.Fatalf(\\\"AdmitForTarget(strict_exact) error = %v\\\", err)\\ninternal/clonesnap/project_test.go:27:\\tfor _, profile := range []string{\\\"strict_exact\\\", \\\"maximal_safe\\\", \\\"compact\\\", \\\"messages_only\\\"} {\\ninternal/clonesnap/project_test.go:71:\\t\\t\\tFidelityProfile: \\\"strict_exact\\\",\\ninternal/clonesnap/project_test.go:100:\\tif _, err := AdmitForTarget(captured.CaptureManifest, \\\"strict_exact\\\"); err == nil {\\ninternal/clonesnap/project_test.go:161:\\t\\tFidelityProfile: \\\"strict_exact\\\",\\n\",\n  \"original_output_bytes\": 4159,\n  \"original_output_tokens\": 1040,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
