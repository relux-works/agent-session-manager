want the ordinal event %q\", index, session.EventIDs[index], decoded.EventID)\n186|\t\t}\n187|\t\tif decoded.Ordinal != uint64(index) {\n188|\t\t\tt.Fatalf(\"Ordinal = %d, want %d\", decoded.Ordinal, index)\n189|\t\t}\n190|\t}\n191|\tif len(session.HeadEventIDs) != 1 || session.HeadEventIDs[0].String() != session.EventIDs[1].String() {\n192|\t\tt.Fatalf(\"HeadEventIDs = %v, want the last event only\", session.HeadEventIDs)\n193|\t}\n194|\tif len(result.DecodedEvents[0].Parents) != 0 {\n195|\t\tt.Fatalf(\"event[0] parents = %d, want none\", len(result.DecodedEvents[0].Parents))\n196|\t}\n197|\tif len(result.DecodedEvents[1].Parents) != 1 ||\n198|\t\tresult.DecodedEvents[1].Parents[0].String() != result.DecodedEvents[0].EventID.String() {\n199|\t\tt.Fatal(\"event[1] is not parented on event[0]\")\n200|\t}\n201|\tif result.DecodedEvents[0].Kind != \"user_message\" || result.DecodedEvents[1].Kind != \"assistant_message\" {\n202|\t\tt.Fatalf(\"kinds = %q/%q, want user_message/assistant_message\",\n203|\t\t\tresult.DecodedEvents[0].Kind, result.DecodedEvents[1].Kind)\n204|\t}\n205|\tif result.DecodedEvents[0].Visibility != \"public\" || result.DecodedEvents[1].Visibility != \"public\" {\n206|\t\tt.Fatal(\"message visibility is not public\")\n207|\t}\n208|}\n209|\n210|func TestNormalizeInlineContentBoundary(t *testing.T) {\n211|\tinline := strings.Repeat(\"i\", 65536)\n212|\toverflow := strings.Repeat(\"o\", 65537)\n213|\tbundle := projectMembers(t, []fixtureMember{\n214|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n215|\t\t\trec(\"evt-inline\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+inline+`\"}`),\n216|\t\t\trec(\"evt-overflow\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+overflow+`\"}`),\n217|\t\t\trec(\"evt-empty\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"\"}`),\n218|\t\t)},\n219|\t})\n220|\tresult := bundle.result\n221|\tsealed := map[string][]byte{}\n222|\tfor index, decoded := range result.DecodedEvents {\n223|\t\tsealed[*decoded.Evidence.NativeEventID] = result.Events[index]\n224|\t}\n225|\tinlinePayload := sealedPayload(t, sealed[\"evt-inline\"])\n226|\tblocks, ok := inlinePayload[\"content_blocks\"].([]any)\n227|\tif !ok || len(blocks) != 1 {\n228|\t\tt.Fatalf(\"inline content_blocks = %v, want one block\", inlinePayload[\"content_blocks\"])\n229|\t}\n230|\tblock := blocks[0].(map[string]any)\n231|\tif block[\"content\"] != inline {\n232|\t\tt.Fatal(\"65536-byte text did not seal inline\")\n233|\t}\n234|\tif _, present := block[\"blob_descriptor_id\"]; present {\n235|\t\tt.Fatal(\"65536-byte text sealed a descriptor reference instead of inline content\")\n236|\t}\n237|\toverflowPayload := sealedPayload(t, sealed[\"evt-overflow\"])\n238|\toverBlocks, ok := overflowPayload[\"content_blocks\"].([]any)\n239|\tif !ok || len(overBlocks) != 1 {\n240|\t\tt.Fatalf(\"overflow content_blocks = %v, want one block\", overflowPayload[\"content_blocks\"])\n241|\t}\n242|\toverBlock := overBlocks[0].(map[string]any)\n243|\tif _, present := overBlock[\"content\"]; present {\n244|\t\tt.Fatal(\"65537-byte text sealed inline past the 64 KiB bound\")\n245|\t}\n246|\tdescriptor, ok := overBlock[\"blob_descriptor_id\"].(string)\n247|\tif !ok || descriptor == \"\" {\n248|\t\tt.Fatalf(\"overflow block misses its blob_descriptor_id: %v\", overBlock)\n249|\t}\n250|\tresolved := mustResolveOverflow(t, bundle.sink, descriptor)\n251|\tif string(resolved) != overflow {\n252|\t\tt.Fatal(\"overflow reference does not resolve to the exact 65537 bytes: truncated or re-encoded\")\n253|\t}\n254|\temptyPayload := sealedPayload(t, sealed[\"evt-empty\"])\n255|\temptyBlocks := emptyPayload[\"content_blocks\"].([]any)\n256|\tif emptyBlocks[0].(map[string]any)[\"content\"] != \"\" {\n257|\t\tt.Fatal(\"empty text did not seal inline\")\n258|\t}\n259|\tif len(result.Overflows) != 1 {\n260|\t\tt.Fatalf(\"len(Overflows) = %d, want 1\", len(result.Overflows))\n261|\t}\n262|\tif result.Overflows[0].DescriptorID.String() != descriptor {\n263|\t\tt.Fatal(\"reported overflow descriptor differs from the sealed reference\")\n264|\t}\n265|}\n266|\n267|func TestNormalizeMultibyteStringMeasure(t *testing.T) {\n268|\twide512 := strings.Repeat(\"\\u00e9\", 512)\n269|\tbundle := projectMembers(t, []fixtureMember{\n270|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n271|\t\t\trec(wide512, \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"wide\"}`),\n272|\t\t)},\n273|\t})\n274|\tif len(bundle.result.DecodedEvents) != 1 {\n275|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1: 512 characters measured as bytes refused\", len(bundle.result.DecodedEvents))\n276|\t}\n277|\twide513 := strings.Repeat(\"\\u00e9\", 513)\n278|\tcapture, store := captureMembers(t, []fixtureMember{\n279|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n280|\t\t\trec(wide513, \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"wide\"}`),\n281|\t\t)},\n282|\t})\n283|\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n284|\tif err == nil {\n285|\t\tt.Fatal(\"Normalize() admitted a 513-character native event ID\")\n286|\t}\n287|\tif !strings.Contains(err.Error(), \"line 1 native_event_id\") {\n288|\t\tt.Fatalf(\"Normalize() error = %v, want the record-level width refusal\", err)\n289|\t}\n290|}\n291|\n292|func TestNormalizeIsDeterministic(t *testing.T) {\n293|\tmembers := []fixtureMember{\n294|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n295|\t\t\trec(\"evt-d-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"determinism\"}`),\n296|\t\t\trec(\"evt-d-2\", \"frobnicate\", \"native\", \"none\", \"main\", `{\"n\":2}`),\n297|\t\t\trec(\"evt-d-3\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":7,\"output_tokens\":9}`),\n298|\t\t)},\n299|\t}\n300|\tcapture, store := captureMembers(t, members)\n301|\tfirst, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n302|\tif err != nil {\n303|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n304|\t}\n305|\tsecond, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n306|\tif err != nil {\n307|\t\tt.Fatalf(\"Normalize() error = %v\", err)\n308|\t}\n309|\tif !bytes.Equal(first.Session, second.Session) {\n310|\t\tt.Fatal(\"same captured bytes did not seal byte-identical sessions\")\n311|\t}\n312|\tif len(first.Events) != len(second.Events) {\n313|\t\tt.Fatalf(\"event counts %d != %d\", len(first.Events), len(second.Events))\n314|\t}\n315|\tfor index := range first.Events {\n316|\t\tif !bytes.Equal(first.Events[index], second.Events[index]) {\n317|\t\t\tt.Fatalf(\"event[%d] differs across identical projections\", index)\n318|\t\t}\n319|\t}\n320|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
