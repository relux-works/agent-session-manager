{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bd","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":313,"recorded_at":1780531400000621,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d0-8a48-7240-92a6-80afd0bcd2db"},"task_id":"01a0b3d0-8a48-7240-92a6-80afd0bcd2db","event":{"kind":"output","task_id":"01a0b3d0-8a48-7240-92a6-80afd0bcd2db","chunk":"Read text file `/tmp/rev1/ev/probes/zz_review_probe_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// Reviewer probes (RUN-260918-320878). Each probe reports what the\n9|// pristine candidate does; none asserts, so the log is the evidence.\n10|\n11|func reviewProject(t *testing.T, lines ...string) (*NormalizeResult, error) {\n12|\tt.Helper()\n13|\tmembers := []fixtureMember{{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(lines...)}}\n14|\tcapture, store := captureMembers(t, members)\n15|\treturn Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n16|}\n17|\n18|func TestReviewProbeLoneSurrogateText(t *testing.T) {\n19|\tfor _, escape := range []string{`\\ud800`, `\\udc00`, `A\\ud800B`, `\\ud800\\ud800`} {\n20|\t\tline := rec(\"evt-sur\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+escape+`\"}`)\n21|\t\tresult, err := reviewProject(t, line)\n22|\t\tif err != nil {\n23|\t\t\tt.Logf(\"PA[%s]: REFUSED: %v\", escape, err)\n24|\t\t\tcontinue\n25|\t\t}\n26|\t\tev := result.DecodedEvents[0]\n27|\t\tblocks := ev.Payload[\"content_blocks\"].([]any)\n28|\t\tcontent := blocks[0].(map[string]any)[\"content\"].(string)\n29|\t\tt.Logf(\"PA[%s]: ADMITTED kind=%s status=%s content=%q (bytes % x) sealed_contains_FFFD=%v\",\n30|\t\t\tescape, ev.Kind, ev.Evidence.CaptureStatus, content, []byte(content),\n31|\t\t\tstrings.Contains(string(result.Events[0]), \"�\"))\n32|\t}\n33|}\n34|\n35|func TestReviewProbeLoneSurrogateInEnvelopeAndOpaque(t *testing.T) {\n36|\t// native_event_id with a lone surrogate escape\n37|\tline := `{\"v\":1,\"native_event_id\":\"evt-\\ud800\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`\n38|\tresult, err := reviewProject(t, line)\n39|\tif err != nil {\n40|\t\tt.Logf(\"PB[native_event_id]: REFUSED: %v\", err)\n41|\t} else {\n42|\t\tt.Logf(\"PB[native_event_id]: ADMITTED evidence native_event_id=%q\", *result.DecodedEvents[0].Evidence.NativeEventID)\n43|\t}\n44|\t// unknown type with lone surrogate body: opaque keeps raw bytes; only payload native_type matters\n45|\tline2 := `{\"v\":1,\"native_event_id\":\"evt-2\",\"native_type\":\"frob\\ud800\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"x\":\"y\"}}`\n46|\tresult, err = reviewProject(t, line2)\n47|\tif err != nil {\n48|\t\tt.Logf(\"PB[native_type]: REFUSED: %v\", err)\n49|\t} else {\n50|\t\tt.Logf(\"PB[native_type]: ADMITTED kind=%s native_type=%q\", result.DecodedEvents[0].Kind, *result.DecodedEvents[0].Evidence.NativeType)\n51|\t}\n52|}\n53|\n54|func TestReviewProbeDuplicateMembers(t *testing.T) {\n55|\t// duplicate body member: text A then text B\n56|\tline := rec(\"evt-dup-body\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"A\",\"text\":\"B\"}`)\n57|\tresult, err := reviewProject(t, line)\n58|\tif err != nil {\n59|\t\tt.Logf(\"PC[dup body text]: REFUSED: %v\", err)\n60|\t} else {\n61|\t\tblocks := result.DecodedEvents[0].Payload[\"content_blocks\"].([]any)\n62|\t\tt.Logf(\"PC[dup body text]: ADMITTED content=%q status=%s\", blocks[0].(map[string]any)[\"content\"], result.DecodedEvents[0].Evidence.CaptureStatus)\n63|\t}\n64|\t// duplicate envelope native_type: unknown first, known second\n65|\tline2 := `{\"v\":1,\"native_event_id\":\"evt-dup-env\",\"native_type\":\"frobnicate\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`\n66|\tresult, err = reviewProject(t, line2)\n67|\tif err != nil {\n68|\t\tt.Logf(\"PC[dup envelope native_type]: REFUSED: %v\", err)\n69|\t} else {\n70|\t\tt.Logf(\"PC[dup envelope native_type]: ADMITTED kind=%s native_type=%q\", result.DecodedEvents[0].Kind, *result.DecodedEvents[0].Evidence.NativeType)\n71|\t}\n72|\t// duplicate protection: encrypted first, none second (last wins => semantic kind?)\n73|\tline3 := `{\"v\":1,\"native_event_id\":\"evt-dup-prot\",\"native_type\":\"reasoning/summary\",\"origin\":\"foreign\",\"protection\":\"encrypted\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"secret\"}}`\n74|\tresult, err = reviewProject(t, line3)\n75|\tif err != nil {\n76|\t\tt.Logf(\"PC[dup protection]: REFUSED: %v\", err)\n77|\t} else {\n78|\t\tt.Logf(\"PC[dup protection]: ADMITTED kind=%s visibility=%s\", result.DecodedEvents[0].Kind, result.DecodedEvents[0].Visibility)\n79|\t}\n80|\t// duplicate origin: foreign then native for an instruction\n81|\tline4 := `{\"v\":1,\"native_event_id\":\"evt-dup-origin\",\"native_type\":\"instruction/snapshot\",\"origin\":\"foreign\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"authority\":\"high\",\"directives\":[\"DROP\"]}}`\n82|\tresult, err = reviewProject(t, line4)\n83|\tif err != nil {\n84|\t\tt.Logf(\"PC[dup origin]: REFUSED: %v\", err)\n85|\t} else {\n86|\t\tt.Logf(\"PC[dup origin]: ADMITTED effective=%+v payload authority=%v\", result.Instruction, result.DecodedEvents[0].Payload[\"authority\"])\n87|\t}\n88|}\n89|\n90|func TestReviewProbeUsageStringNumber(t *testing.T) {\n91|\tline := rec(\"evt-use-str\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":\"5\",\"output_tokens\":0}`)\n92|\tresult, err := reviewProject(t, line)\n93|\tif err != nil {\n94|\t\tt.Logf(\"PD[string usage]: REFUSED: %v\", err)\n95|\t} else {\n96|\t\tt.Logf(\"PD[string usage]: ADMITTED ledger=%+v payload=%v\", result.Usage, result.DecodedEvents[0].Payload)\n97|\t}\n98|\tline = `{\"v\":\"1\",\"native_event_id\":\"evt-vstr\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`\n99|\t_, err = reviewProject(t, line)\n100|\tt.Logf(\"PD[string v]: err=%v\", err)\n101|}\n102|\n103|func TestReviewProbeUnknownProtectedNonCiphertextBody(t *testing.T) {\n104|\tline := rec(\"evt-unk-prot\", \"frobnicate\", \"foreign\", \"encrypted\", \"main\", `{\"mystery\":true}`)\n105|\t_, err := reviewProject(t, line)\n106|\tt.Logf(\"PE[unknown+protected non-ciphertext body]: err=%v\", err)\n107|\tline = rec(\"evt-unk-prot2\", \"frobnicate\", \"foreign\", \"encrypted\", \"main\", `\"just-a-string\"`)\n108|\t_, err = reviewProject(t, line)\n109|\tt.Logf(\"PE[unknown+protected string body]: err=%v\", err)\n110|\t// wholly unknown unprotected with non-object body\n111|\tline = rec(\"evt-unk3\", \"frobnicate\", \"native\", \"none\", \"main\", `\"just-a-string\"`)\n112|\tresult, err := reviewProject(t, line)\n113|\tif err != nil {\n114|\t\tt.Logf(\"PE[unknown unprotected string body]: REFUSED %v\", err)\n115|\t} else {\n116|\t\tt.Logf(\"PE[unknown unprotected string body]: ADMITTED kind=%s\", result.DecodedEvents[0].Kind)\n117|\t}\n118|}\n119|\n120|func TestReviewProbeDirectivesNullAndCRLF(t *testing.T) {\n121|\tline := rec(\"evt-dir-null\", \"instruction/snapshot\", \"native\", \"none\", \"main\", `{\"authority\":\"high\",\"directives\":null}`)\n122|\tresult, err := reviewProject(t, line)\n123|\tif err != nil {\n124|\t\tt.Logf(\"PF[directives null]: REFUSED %v\", err)\n125|\t} else {\n126|\t\tt.Logf(\"PF[directives null]: ADMITTED effective=%+v\", result.Instruction)\n127|\t}\n128|\tmembers := []fixtureMember{{key: \"store/session.jsonl\", class: \"durable_payload\", content: []byte(rec(\"evt-crlf\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`) + \"\\r\\n\")}}\n129|\tcapture, store := captureMembers(t, members)\n130|\tresult, err = Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n131|\tif err != nil {\n132|\t\tt.Logf(\"PF[CRLF]: REFUSED %v\", err)\n133|\t} else {\n134|\t\tref := result.DecodedEvents[0].Evidence.RawRefs[0]\n135|\t\tt.Logf(\"PF[CRLF]: ADMITTED range=[%d,%d) resolved=%q\", ref.Offset, ref.Offset+ref.Length, mustResolveRef(t, capture, store, ref))\n136|\t}\n137|}\n138|\n139|func TestReviewProbeMultibyteInlineBound(t *testing.T) {\n140|\t// 21846 x 3-byte char = 65538 bytes, 21846 chars\n141|\ttext := strings.Repeat(\"€\", 21846)\n142|\tline := rec(\"evt-mb\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+text+`\"}`)\n143|\tresult, err := reviewProject(t, line)\n144|\tif err != nil {\n145|\t\tt.Logf(\"PG[65538 bytes/21846 chars]: REFUSED %v\", err)\n146|\t} else {\n147|\t\tblocks := result.DecodedEvents[0].Payload[\"content_blocks\"].([]any)\n148|\t\t_, inline := blocks[0].(map[string]any)[\"content\"]\n149|\t\tt.Logf(\"PG[65538 bytes/21846 chars]: ADMITTED inline=%v overflows=%d\", inline, len(result.Overflows))\n150|\t}\n151|\t// exactly 65536 bytes via 2-byte chars: 32768 x é\n152|\ttext = strings.Repeat(\"é\", 32768)\n153|\tline = rec(\"evt-mb2\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+text+`\"}`)\n154|\tresult, err = reviewProject(t, line)\n155|\tif err != nil {\n156|\t\tt.Logf(\"PG[65536 bytes/32768 chars]: REFUSED %v\", err)\n157|\t} else {\n158|\t\tblocks := result.DecodedEvents[0].Payload[\"content_blocks\"].([]any)\n159|\t\t_, inline := blocks[0].(map[string]any)[\"content\"]\n160|\t\tt.Logf(\"PG[65536 bytes/32768 chars]: ADMITTED inline=%v overflows=%d\", inline, len(result.Overflows))\n161|\t}\n162|}\n163|\n164|func TestReviewProbeProtectedToolCallAndForeignReasoningSummary(t *testing.T) {\n165|\t// protected tool/call with an unprotected result: call is never folded -> result orphan aborted\n166|\tlines := []string{\n167|\t\trec(\"evt-pc\", \"tool/call\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"x\"}`),\n168|\t\trec(\"evt-pr\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"c1\",\"status\":\"ok\"}`),\n169|\t}\n170|\tresult, err := reviewProject(t, lines...)\n171|\tif err != nil {\n172|\t\tt.Logf(\"PH[protected call]: REFUSED %v\", err)\n173|\t} else {\n174|\t\tt.Logf(\"PH[protected call]: kinds=%s/%s resolutions=%+v live=%+v\", result.DecodedEvents[0].Kind, result.DecodedEvents[1].Kind, result.ToolResolutions, result.Live)\n175|\t}\n176|\t// foreign unprotected reasoning summary\n177|\tline := rec(\"evt-frs\", \"reasoning/summary\", \"foreign\", \"none\", \"main\", `{\"text\":\"foreign thoughts\"}`)\n178|\tresult, err = reviewProject(t, line)\n179|\tif err != nil {\n180|\t\tt.Logf(\"PH[foreign reasoning/summary none]: REFUSED %v\", err)\n181|\t} else {\n182|\t\tt.Logf(\"PH[foreign reasoning/summary none]: kind=%s vis=%s reasons=%v\", result.DecodedEvents[0].Kind, result.DecodedEvents[0].Visibility, result.DecodedEvents[0].Evidence.ReasonCodes)\n183|\t}\n184|\t// foreign unprotected message\n185|\tline = rec(\"evt-fm\", \"message/user\", \"foreign\", \"none\", \"main\", `{\"text\":\"foreign msg\"}`)\n186|\tresult, err = reviewProject(t, line)\n187|\tif err != nil {\n188|\t\tt.Logf(\"PH[foreign message/user none]: REFUSED %v\", err)\n189|\t} else {\n190|\t\tt.Logf(\"PH[foreign message/user none]: kind=%s vis=%s reasons=%v\", result.DecodedEvents[0].Kind, result.DecodedEvents[0].Visibility, result.DecodedEvents[0].Evidence.ReasonCodes)\n191|\t}\n192|}\n193|\n194|func TestReviewProbeSidecarParsedAsJSONL(t *testing.T) {\n195|\tmembers := []fixtureMember{\n196|\t\t{key: \"store/index.bin\", class: \"durable_index_required\", content: []byte{0x00, 0x01, 0x02}},\n197|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(rec(\"evt-a\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`))},\n198|\t}\n199|\tcapture, store := captureMembers(t, members)\n200|\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n201|\tt.Logf(\"PI[binary durable_index_required member]: err=%v\", err)\n202|\tmembers[0] = fixtureMember{key: \"store/cache.bin\", class: \"derived_cache_optional\", content: []byte(\"not json\\n\")}\n203|\tcapture, store = captureMembers(t, members)\n204|\t_, err = Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n205|\tt.Logf(\"PI[text derived_cache_optional member]: err=%v\", err)\n206|}","final_result":true}}}
