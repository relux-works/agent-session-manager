{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf05","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":1501,"recorded_at":1780531400002997,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d7-df89-7f40-8f8d-6b6d68c692f4"},"task_id":"01a0b3d7-df89-7f40-8f8d-6b6d68c692f4","event":{"kind":"output","task_id":"01a0b3d7-df89-7f40-8f8d-6b6d68c692f4","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/traceability/traceability_test.go`.\n1|package traceability\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"io/fs\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"reflect\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"testing/fstest\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n20|)\n21|\n22|func TestVerifyRepositoryAcceptsExactOwnership(t *testing.T) {\n23|\tt.Parallel()\n24|\n25|\treport, err := VerifyRepository(repositorySnapshot(t))\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"VerifyRepository() error = %v\", err)\n28|\t}\n29|\twant := Report{\n30|\t\tContracts:              64,\n31|\t\tNormativeSections:      36,\n32|\t\tAcceptanceCases:        144,\n33|\t\tFixtures:               33,\n34|\t\tCompatibilityContracts: 55,\n35|\t\tSectionBindings:        68,\n36|\t\tFullCoverage:           4,\n37|\t\tPartialCoverage:        8,\n38|\t\tSliverCoverage:         5,\n39|\t\tUnevidencedCoverage:    47,\n40|\t\tUnmeasuredCoverage:     4,\n41|\t\tUnownedSections:        7,\n42|\t\tNormativeClauses:       569,\n43|\t\tDischargedClauses:      63,\n44|\t}\n45|\tif !reflect.DeepEqual(report, want) {\n46|\t\tt.Fatalf(\"VerifyRepository() report = %#v, want %#v\", report, want)\n47|\t}\n48|}\n49|\n50|// TestVerifyAssignedSectionsBindsGranularScopeToOwnersAndExecutableCases pins\n51|// the admitted arm of assigned-scope admission. Section 6.2 is admitted because\n52|// it discharges the one normative clause its pinned section carries against an\n53|// executable acceptance case, Section 2.4 is admitted because it discharges\n54|// all four of its clauses, and Sections 7.8 and 10.2 are admitted because the\n55|// clone story discharges all two and all five of their clauses. They are the\n56|// only shipped bindings that are.\n57|//\n58|// Section 13.14.5 used to be admitted here on the ground that its pinned\n59|// section \"carries no RFC 2119 obligation of its own\". That was false: the\n60|// obligation scanner matches uppercase keywords only, and Section 13.14.5\n61|// states its obligations as required-member and variant tables. Nineteen of the\n62|// 157 pinned headings are in that class, including the eighteen-row exit-code\n63|// registry of Section 15.2 and the closed Provider Manifest of Section 7.3, and\n64|// admitting them reproduced this bug through a different door. The assertion is\n65|// kept rather than deleted: it moved to the refusal table below and to\n66|// TestVerifyAssignedSectionsRefusesEveryBindingThatOnlySlivers, which now pins\n67|// each of the three by its measured ratio.\n68|func TestVerifyAssignedSectionsBindsGranularScopeToOwnersAndExecutableCases(t *testing.T) {\n69|\tt.Parallel()\n70|\n71|\treport, err := VerifyAssignedSections(repositorySnapshot(t), []string{\"6.2\"})\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"VerifyAssignedSections() error = %v\", err)\n74|\t}\n75|\tif report.AssignedScopes != 1 {\n76|\t\tt.Fatalf(\"VerifyAssignedSections() assigned scopes = %d, want 1\", report.AssignedScopes)\n77|\t}\n78|\n79|\tfor _, scope := range []string{\"6.2\", \"§6.2\", \"2.4\", \"§2.4\", \"7.8\", \"§7.8\", \"10.2\", \"§10.2\"} {\n80|\t\treport, err := VerifyAssignedSections(repositorySnapshot(t), []string{scope})\n81|\t\tif err != nil {\n82|\t\t\tt.Errorf(\"VerifyAssignedSections(%q) error = %v\", scope, err)\n83|\t\t\tcontinue\n84|\t\t}\n85|\t\tif report.AssignedScopes != 1 {\n86|\t\t\tt.Errorf(\"VerifyAssignedSections(%q) assigned scopes = %d, want 1\", scope, report.AssignedScopes)\n87|\t\t}\n88|\t}\n89|\n90|\t// A scope that pairs the one admitted binding with an unmeasured one is\n91|\t// refused as a whole. Admission is not per-section best-effort.\n92|\t_, err = VerifyAssignedSections(repositorySnapshot(t), []string{\"6.2\", \"13.14.5\"})\n93|\tif err == nil || !errors.Is(err, ErrTraceability) ||\n94|\t\t!strings.Contains(err.Error(), `binding \"section:13.14.5\" discharges 0/0 normative clauses, which is unmeasured coverage`) {\n95|\t\tt.Fatalf(\"VerifyAssignedSections(6.2, 13.14.5) error = %v, want unmeasured refusal\", err)\n96|\t}\n97|\n98|\tfor _, scope := range []string{\"11.2-11.3\", \"§4.B-4.C\", \"Appendix D\"} {\n99|\t\t_, err := VerifyAssignedSections(repositorySnapshot(t), []string{scope})\n100|\t\tif err == nil || !errors.Is(err, ErrTraceability) || !strings.Contains(err.Error(), \"assigned-scope admission requires full\") {\n(more lines below)","final_result":true}}}
