tes.Equal(first.Session, second.Session) {\n34|\t\tt.Fatal(\"replay sealed a different session\")\n35|\t}\n36|\tif len(first.Events) != len(second.Events) {\n37|\t\tt.Fatalf(\"replay event counts %d != %d\", len(first.Events), len(second.Events))\n38|\t}\n39|\tfor index := range first.Events {\n40|\t\tif !bytes.Equal(first.Events[index], second.Events[index]) {\n41|\t\t\tt.Fatalf(\"replay event[%d] differs\", index)\n42|\t\t}\n43|\t}\n44|\tif blobs := len(listStoreBlobs(t, sink)); blobs != blobsAfterFirst {\n45|\t\tt.Fatalf(\"sink blobs %d after replay, want %d: replay reinstalled instead of verifying\", blobs, blobsAfterFirst)\n46|\t}\n47|\tif len(first.Overflows) != 1 || len(second.Overflows) != 1 {\n48|\t\tt.Fatalf(\"overflows %d/%d, want 1/1\", len(first.Overflows), len(second.Overflows))\n49|\t}\n50|\tif first.Overflows[0].DescriptorID.String() != second.Overflows[0].DescriptorID.String() {\n51|\t\tt.Fatal(\"replay overflow descriptor differs\")\n52|\t}\n53|}\n54|\n55|func TestNormalizeFailureReturnsNoPartialBundle(t *testing.T) {\n56|\tmembers := []fixtureMember{\n57|\t\t{key: \"store/a.jsonl\", class: \"durable_payload\", content: jsonl(\n58|\t\t\trec(\"evt-part-1\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"one\"}`),\n59|\t\t)},\n60|\t\t{key: \"store/b.jsonl\", class: \"durable_payload\", content: jsonl(\n61|\t\t\trec(\"evt-part-2\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"two\"}`),\n62|\t\t)},\n63|\t}\n64|\tcapture, store := captureMembers(t, members)\n65|\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n66|\thealthy := request.Fetch\n67|\tcalls := 0\n68|\trequest.Fetch = func(blobID string) ([]byte, error) {\n69|\t\tcalls++\n70|\t\tif calls == 2 {\n71|\t\t\treturn nil, errFixtureGone\n72|\t\t}\n73|\t\treturn healthy(blobID)\n74|\t}\n75|\tresult, err := Normalize(request)\n76|\tif err == nil {\n77|\t\tt.Fatal(\"Normalize() admitted a mid-projection fetch failure\")\n78|\t}\n79|\tif result != nil {\n80|\t\tt.Fatal(\"Normalize() returned a partial bundle alongside the failure\")\n81|\t}\n82|\t// A healthy re-run over the same captured bytes converges.\n83|\tclean, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n84|\tif err != nil {\n85|\t\tt.Fatalf(\"Normalize() re-run error = %v\", err)\n86|\t}\n87|\tif len(clean.Events) != 2 {\n88|\t\tt.Fatalf(\"re-run events = %d, want 2\", len(clean.Events))\n89|\t}\n90|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
