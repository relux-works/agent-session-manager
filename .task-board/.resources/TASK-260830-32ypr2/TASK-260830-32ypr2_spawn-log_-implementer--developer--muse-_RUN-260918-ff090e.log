{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c873","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":660,"recorded_at":1780531400001315,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d1-3eb9-78f3-9f4e-40214ce3538d"},"task_id":"01a0b3d1-3eb9-78f3-9f4e-40214ce3538d","event":{"kind":"output","task_id":"01a0b3d1-3eb9-78f3-9f4e-40214ce3538d","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/foreign_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// Invariant 2: foreign signed/encrypted reasoning stays opaque,\n8|// foreign instructions stay low-authority history, and source usage\n9|// never becomes target accounting. Every test drives Normalize over\n10|// bytes the real capture entry sealed.\n11|\n12|func TestNormalizeForeignEncryptedReasoningStaysOpaque(t *testing.T) {\n13|\tline := rec(\"evt-enc-1\", \"reasoning/encrypted\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"TOP-SECRET-THOUGHTS\"}`)\n14|\tbundle := projectMembers(t, []fixtureMember{\n15|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n16|\t})\n17|\tif len(bundle.result.DecodedEvents) != 1 {\n18|\t\tt.Fatalf(\"len(DecodedEvents) = %d, want 1\", len(bundle.result.DecodedEvents))\n19|\t}\n20|\tevent := bundle.result.DecodedEvents[0]\n21|\tif event.Kind != \"opaque_reasoning\" {\n22|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n23|\t}\n24|\tif event.Kind == \"reasoning_summary\" {\n25|\t\tt.Fatal(\"foreign encrypted reasoning was promoted to reasoning_summary\")\n26|\t}\n27|\tif event.Visibility != \"opaque\" {\n28|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n29|\t}\n30|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"foreign_encrypted_payload\" {\n31|\t\tt.Fatalf(\"ReasonCodes = %q, want [foreign_encrypted_payload]\", event.Evidence.ReasonCodes)\n32|\t}\n33|\tif payloadText(t, event, \"protection\") != \"encrypted\" {\n34|\t\tt.Fatalf(\"payload protection = %q, want encrypted\", payloadText(t, event, \"protection\"))\n35|\t}\n36|\tif payloadInt(t, event, \"byte_count\") != int64(len(line)) {\n37|\t\tt.Fatalf(\"payload byte_count = %d, want %d\", payloadInt(t, event, \"byte_count\"), len(line))\n38|\t}\n39|\tsealed := sealedPayload(t, bundle.result.Events[0])\n40|\tfor _, forbidden := range []string{\"content_blocks\", \"content\", \"text\", \"ciphertext\", \"summary\"} {\n41|\t\tif _, present := sealed[forbidden]; present {\n42|\t\t\tt.Fatalf(\"sealed payload carries %q: decrypted, summarized, or re-encoded\", forbidden)\n43|\t\t}\n44|\t}\n45|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n46|\tif string(resolved) != line {\n47|\t\tt.Fatal(\"encrypted bytes did not survive the blob round trip byte-exact\")\n48|\t}\n49|}\n50|\n51|func TestNormalizeForeignSignedReasoningStaysOpaque(t *testing.T) {\n52|\tline := rec(\"evt-sig-1\", \"reasoning/signed\", \"foreign\", \"signed\", \"main\", `{\"ciphertext\":\"SIGNED-BYTES\"}`)\n53|\tbundle := projectMembers(t, []fixtureMember{\n54|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n55|\t})\n56|\tevent := bundle.result.DecodedEvents[0]\n57|\tif event.Kind != \"opaque_reasoning\" {\n58|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n59|\t}\n60|\tif event.Visibility != \"opaque\" {\n61|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n62|\t}\n63|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"foreign_signature_unverifiable\" {\n64|\t\tt.Fatalf(\"ReasonCodes = %q, want [foreign_signature_unverifiable]\", event.Evidence.ReasonCodes)\n65|\t}\n66|\tif payloadText(t, event, \"protection\") != \"signed\" {\n67|\t\tt.Fatalf(\"payload protection = %q, want signed\", payloadText(t, event, \"protection\"))\n68|\t}\n69|\tsealed := sealedPayload(t, bundle.result.Events[0])\n70|\tfor _, forbidden := range []string{\"content_blocks\", \"content\", \"text\", \"ciphertext\", \"summary\"} {\n71|\t\tif _, present := sealed[forbidden]; present {\n72|\t\t\tt.Fatalf(\"sealed payload carries %q: decrypted, summarized, or re-encoded\", forbidden)\n73|\t\t}\n74|\t}\n75|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n76|\tif string(resolved) != line {\n77|\t\tt.Fatal(\"signed bytes did not survive the blob round trip byte-exact\")\n78|\t}\n79|}\n80|\n81|func TestNormalizeNativeProtectedReasoningStaysOpaque(t *testing.T) {\n82|\tline := rec(\"evt-enc-native\", \"reasoning/encrypted\", \"native\", \"encrypted\", \"main\", `{\"ciphertext\":\"NATIVE-SECRET\"}`)\n83|\tbundle := projectMembers(t, []fixtureMember{\n84|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n85|\t})\n86|\tevent := bundle.result.DecodedEvents[0]\n87|\tif event.Kind != \"opaque_reasoning\" {\n88|\t\tt.Fatalf(\"Kind = %q, want opaque_reasoning\", event.Kind)\n89|\t}\n90|\tif len(event.Evidence.ReasonCodes) != 0 {\n91|\t\tt.Fatalf(\"ReasonCodes = %q, want empty: no foreign core code fits native-protected content\", event.Evidence.ReasonCodes)\n92|\t}\n93|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n94|\tif string(resolved) != line {\n95|\t\tt.Fatal(\"native protected bytes did not survive byte-exact\")\n96|\t}\n97|}\n98|\n99|func TestNormalizeProtectedMessageBecomesOpaqueEvent(t *testing.T) {\n100|\tline := rec(\"evt-prot-msg\", \"message/assistant\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"HIDDEN\"}`)\n101|\tbundle := projectMembers(t, []fixtureMember{\n102|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n103|\t})\n104|\tevent := bundle.result.DecodedEvents[0]\n105|\tif event.Kind != \"opaque_event\" {\n106|\t\tt.Fatalf(\"Kind = %q, want opaque_event: protected content reached a semantic kind\", event.Kind)\n107|\t}\n108|\tif event.Visibility != \"opaque\" {\n109|\t\tt.Fatalf(\"Visibility = %q, want opaque\", event.Visibility)\n110|\t}\n111|\tif len(event.Evidence.ReasonCodes) != 1 || event.Evidence.ReasonCodes[0] != \"foreign_encrypted_payload\" {\n112|\t\tt.Fatalf(\"ReasonCodes = %q, want [foreign_encrypted_payload]\", event.Evidence.ReasonCodes)\n113|\t}\n114|\tif payloadText(t, event, \"protection\") != \"encrypted\" {\n115|\t\tt.Fatalf(\"payload protection = %q, want encrypted\", payloadText(t, event, \"protection\"))\n116|\t}\n117|\tresolved := mustResolveRef(t, bundle.capture, bundle.store, event.Evidence.RawRefs[0])\n118|\tif string(resolved) != line {\n119|\t\tt.Fatal(\"protected bytes did not survive byte-exact\")\n120|\t}\n121|}\n122|\n123|func TestNormalizeUnknownProtectedRecordCarriesBothReasons(t *testing.T) {\n124|\tline := rec(\"evt-prot-unknown\", \"frobnicate\", \"foreign\", \"signed\", \"main\", `{\"ciphertext\":\"HIDDEN\"}`)\n125|\tbundle := projectMembers(t, []fixtureMember{\n126|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(line)},\n127|\t})\n128|\tevent := bundle.result.DecodedEvents[0]\n129|\tif event.Kind != \"opaque_event\" {\n130|\t\tt.Fatalf(\"Kind = %q, want opaque_event\", event.Kind)\n131|\t}\n132|\twant := []string{\"foreign_signature_unverifiable\", \"unknown_native_event\"}\n133|\tif len(event.Evidence.ReasonCodes) != 2 ||\n134|\t\tevent.Evidence.ReasonCodes[0] != want[0] || event.Evidence.ReasonCodes[1] != want[1] {\n135|\t\tt.Fatalf(\"ReasonCodes = %q, want %q\", event.Evidence.ReasonCodes, want)\n136|\t}\n137|}\n138|\n139|func TestNormalizeForeignInstructionCannotChangeEffectiveSnapshot(t *testing.T) {\n140|\tbundle := projectMembers(t, []fixtureMember{\n141|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n142|\t\t\trec(\"evt-inst-native\", \"instruction/snapshot\", \"native\", \"none\", \"main\",\n143|\t\t\t\t`{\"authority\":\"high\",\"directives\":[\"native-directive\"]}`),\n144|\t\t\trec(\"evt-inst-foreign\", \"instruction/snapshot\", \"foreign\", \"none\", \"main\",\n145|\t\t\t\t`{\"authority\":\"high\",\"directives\":[\"DROP-EVERYTHING\"]}`),\n146|\t\t)},\n147|\t})\n148|\tresult := bundle.result\n149|\tif !result.Instruction.Found {\n150|\t\tt.Fatal(\"effective instruction not found despite the native record\")\n151|\t}\n152|\tif result.Instruction.Authority != \"high\" {\n153|\t\tt.Fatalf(\"effective authority = %q, want high\", result.Instruction.Authority)\n154|\t}\n155|\tif len(result.Instruction.Directives) != 1 || result.Instruction.Directives[0] != \"native-directive\" {\n156|\t\tt.Fatalf(\"effective directives = %q, want the native directive only\", result.Instruction.Directives)\n157|\t}\n158|\tforeign := eventByNativeID(t, result, \"evt-inst-foreign\")\n159|\tif foreign.Kind != \"instruction_snapshot\" {\n160|\t\tt.Fatalf(\"foreign Kind = %q, want instruction_snapshot history\", foreign.Kind)\n161|\t}\n162|\tif foreign.Visibility != \"internal\" {\n163|\t\tt.Fatalf(\"foreign Visibility = %q, want internal\", foreign.Visibility)\n164|\t}\n165|\tif payloadText(t, foreign, \"authority\") != \"low\" {\n166|\t\tt.Fatalf(\"foreign payload authority = %q, want low\", payloadText(t, foreign, \"authority\"))\n167|\t}\n168|\tnative := eventByNativeID(t, result, \"evt-inst-native\")\n169|\tif payloadText(t, native, \"authority\") != \"high\" {\n170|\t\tt.Fatalf(\"native payload authority = %q, want high\", payloadText(t, native, \"authority\"))\n171|\t}\n172|}\n173|\n174|func TestNormalizeForeignOnlyInstructionLeavesSnapshotEmpty(t *testing.T) {\n175|\tbundle := projectMembers(t, []fixtureMember{\n176|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n177|\t\t\trec(\"evt-inst-lone\", \"instruction/snapshot\", \"foreign\", \"none\", \"main\",\n178|\t\t\t\t`{\"authority\":\"high\",\"directives\":[\"DROP-EVERYTHING\"]}`),\n179|\t\t)},\n180|\t})\n181|\tif bundle.result.Instruction.Found {\n182|\t\tt.Fatalf(\"effective instruction = %+v, want unfound: foreign history set the snapshot\", bundle.result.Instruction)\n183|\t}\n184|}\n185|\n186|func TestNormalizeSourceUsageIsNotTargetAccounting(t *testing.T) {\n187|\tbundle := projectMembers(t, []fixtureMember{\n188|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n189|\t\t\trec(\"evt-use-1\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":100,\"output_tokens\":40}`),\n190|\t\t\trec(\"evt-use-2\", \"usage/report\", \"native\", \"none\", \"main\", `{\"input_tokens\":5,\"output_tokens\":7}`),\n191|\t\t)},\n192|\t})\n193|\tledger := bundle.result.Usage\n194|\tif ledger.SourceInputTokens != 105 || ledger.SourceOutputTokens != 47 {\n195|\t\tt.Fatalf(\"source ledger = %d/%d, want 105/47\", ledger.SourceInputTokens, ledger.SourceOutputTokens)\n196|\t}\n197|\tif ledger.TargetInputTokens != 0 || ledger.TargetOutputTokens != 0 {\n198|\t\tt.Fatalf(\"target ledger = %d/%d, want zero: source usage became target accounting\",\n199|\t\t\tledger.TargetInputTokens, ledger.TargetOutputTokens)\n200|\t}\n201|\tfirst := eventByNativeID(t, bundle.result, \"evt-use-1\")\n202|\tif first.Kind != \"usage\" {\n203|\t\tt.Fatalf(\"Kind = %q, want usage\", first.Kind)\n204|\t}\n205|\tif payloadInt(t, first, \"input_tokens\") != 100 || payloadInt(t, first, \"output_tokens\") != 40 {\n206|\t\tt.Fatal(\"usage payload does not carry the exact token counts\")\n207|\t}\n208|}","final_result":true}}}
