old.Coverage, len(old.Clauses))\n739|\t}\n740|\tif now.Production != upgrade.Production {\n741|\t\tt.Fatalf(\"binding %q upgraded production = %+v, want %+v\", key, now.Production, upgrade.Production)\n742|\t}\n743|\tif !reflect.DeepEqual(now.AcceptanceCases, upgrade.Cases) {\n744|\t\tt.Fatalf(\"binding %q upgraded acceptance cases = %q, want %q\", key, now.AcceptanceCases, upgrade.Cases)\n745|\t}\n746|\tif now.Coverage != upgrade.Coverage {\n747|\t\tt.Fatalf(\"binding %q upgraded coverage = %s, want %s\", key, now.Coverage, upgrade.Coverage)\n748|\t}\n749|\tif now.Gap != upgrade.Gap {\n750|\t\tt.Fatalf(\"binding %q upgraded gap differs from the reviewed upgrade\", key)\n751|\t}\n752|\tif !reflect.DeepEqual(now.Clauses, upgrade.Clauses) {\n753|\t\tt.Fatalf(\"binding %q upgraded clauses differ from the reviewed upgrade\", key)\n754|\t}\n755|}\n756|\n757|// assertStoryBindingClausesRemeasured checks the upgraded binding's new\n758|// clauses against the pinned v0.7.0 document through the production clause\n759|// inventory. Excerpt-verbatim at the declared line is already enforced by\n760|// measuredClauseLines over the current bindings; this pins each declared\n761|// line to its measured position.\n762|func assertStoryBindingClausesRemeasured(t *testing.T, key string, old, now ownershipGroup, measured070 map[string]map[string]int) {\n763|\tt.Helper()\n764|\n765|\tif len(old.Clauses) != 0 {\n766|\t\tt.Fatalf(\"binding %q upgrade base carries %d clauses, want the unevidenced stub\", key, len(old.Clauses))\n767|\t}\n768|\tfor _, newClause := range now.Clauses {\n769|\t\tif measured070[key][newClause.ID] != newClause.Line {\n770|\t\t\tt.Fatalf(\"binding %q clause %s v0.7.0 line %d is not the measured line %d\",\n771|\t\t\t\tkey, newClause.ID, newClause.Line, measured070[key][newClause.ID])\n772|\t\t}\n773|\t}\n774|}","final_result":true}}}
