 usage]: ADMITTED ledger=%+v payload=%v\", result.Usage, result.DecodedEvents[0].Payload)\n97|\t}\n98|\tline = `{\"v\":\"1\",\"native_event_id\":\"evt-vstr\",\"native_type\":\"message/user\",\"origin\":\"native\",\"protection\":\"none\",\"actor\":\"main\",\"body\":{\"text\":\"x\"}}`\n99|\t_, err = reviewProject(t, line)\n100|\tt.Logf(\"PD[string v]: err=%v\", err)\n101|}\n102|\n103|func TestReviewProbeUnknownProtectedNonCiphertextBody(t *testing.T) {\n104|\tline := rec(\"evt-unk-prot\", \"frobnicate\", \"foreign\", \"encrypted\", \"main\", `{\"mystery\":true}`)\n105|\t_, err := reviewProject(t, line)\n106|\tt.Logf(\"PE[unknown+protected non-ciphertext body]: err=%v\", err)\n107|\tline = rec(\"evt-unk-prot2\", \"frobnicate\", \"foreign\", \"encrypted\", \"main\", `\"just-a-string\"`)\n108|\t_, err = reviewProject(t, line)\n109|\tt.Logf(\"PE[unknown+protected string body]: err=%v\", err)\n110|\t// wholly unknown unprotected with non-object body\n111|\tline = rec(\"evt-unk3\", \"frobnicate\", \"native\", \"none\", \"main\", `\"just-a-string\"`)\n112|\tresult, err := reviewProject(t, line)\n113|\tif err != nil {\n114|\t\tt.Logf(\"PE[unknown unprotected string body]: REFUSED %v\", err)\n115|\t} else {\n116|\t\tt.Logf(\"PE[unknown unprotected string body]: ADMITTED kind=%s\", result.DecodedEvents[0].Kind)\n117|\t}\n118|}\n119|\n120|func TestReviewProbeDirectivesNullAndCRLF(t *testing.T) {\n121|\tline := rec(\"evt-dir-null\", \"instruction/snapshot\", \"native\", \"none\", \"main\", `{\"authority\":\"high\",\"directives\":null}`)\n122|\tresult, err := reviewProject(t, line)\n123|\tif err != nil {\n124|\t\tt.Logf(\"PF[directives null]: REFUSED %v\", err)\n125|\t} else {\n126|\t\tt.Logf(\"PF[directives null]: ADMITTED effective=%+v\", result.Instruction)\n127|\t}\n128|\tmembers := []fixtureMember{{key: \"store/session.jsonl\", class: \"durable_payload\", content: []byte(rec(\"evt-crlf\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`) + \"\\r\\n\")}}\n129|\tcapture, store := captureMembers(t, members)\n130|\tresult, err = Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n131|\tif err != nil {\n132|\t\tt.Logf(\"PF[CRLF]: REFUSED %v\", err)\n133|\t} else {\n134|\t\tref := result.DecodedEvents[0].Evidence.RawRefs[0]\n135|\t\tt.Logf(\"PF[CRLF]: ADMITTED range=[%d,%d) resolved=%q\", ref.Offset, ref.Offset+ref.Length, mustResolveRef(t, capture, store, ref))\n136|\t}\n137|}\n138|\n139|func TestReviewProbeMultibyteInlineBound(t *testing.T) {\n140|\t// 21846 x 3-byte char = 65538 bytes, 21846 chars\n141|\ttext := strings.Repeat(\"€\", 21846)\n142|\tline := rec(\"evt-mb\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+text+`\"}`)\n143|\tresult, err := reviewProject(t, line)\n144|\tif err != nil {\n145|\t\tt.Logf(\"PG[65538 bytes/21846 chars]: REFUSED %v\", err)\n146|\t} else {\n147|\t\tblocks := result.DecodedEvents[0].Payload[\"content_blocks\"].([]any)\n148|\t\t_, inline := blocks[0].(map[string]any)[\"content\"]\n149|\t\tt.Logf(\"PG[65538 bytes/21846 chars]: ADMITTED inline=%v overflows=%d\", inline, len(result.Overflows))\n150|\t}\n151|\t// exactly 65536 bytes via 2-byte chars: 32768 x é\n152|\ttext = strings.Repeat(\"é\", 32768)\n153|\tline = rec(\"evt-mb2\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"`+text+`\"}`)\n154|\tresult, err = reviewProject(t, line)\n155|\tif err != nil {\n156|\t\tt.Logf(\"PG[65536 bytes/32768 chars]: REFUSED %v\", err)\n157|\t} else {\n158|\t\tblocks := result.DecodedEvents[0].Payload[\"content_blocks\"].([]any)\n159|\t\t_, inline := blocks[0].(map[string]any)[\"content\"]\n160|\t\tt.Logf(\"PG[65536 bytes/32768 chars]: ADMITTED inline=%v overflows=%d\", inline, len(result.Overflows))\n161|\t}\n162|}\n163|\n164|func TestReviewProbeProtectedToolCallAndForeignReasoningSummary(t *testing.T) {\n165|\t// protected tool/call with an unprotected result: call is never folded -> result orphan aborted\n166|\tlines := []string{\n167|\t\trec(\"evt-pc\", \"tool/call\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"x\"}`),\n168|\t\trec(\"evt-pr\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"c1\",\"status\":\"ok\"}`),\n169|\t}\n170|\tresult, err := reviewProject(t, lines...)\n171|\tif err != nil {\n172|\t\tt.Logf(\"PH[protected call]: REFUSED %v\", err)\n173|\t} else {\n174|\t\tt.Logf(\"PH[protected call]: kinds=%s/%s resolutions=%+v live=%+v\", result.DecodedEvents[0].Kind, result.DecodedEvents[1].Kind, result.ToolResolutions, result.Live)\n175|\t}\n176|\t// foreign unprotected reasoning summary\n177|\tline := rec(\"evt-frs\", \"reasoning/summary\", \"foreign\", \"none\", \"main\", `{\"text\":\"foreign thoughts\"}`)\n178|\tresult, err = reviewProject(t, line)\n179|\tif err != nil {\n180|\t\tt.Logf(\"PH[foreign reasoning/summary none]: REFUSED %v\", err)\n181|\t} else {\n182|\t\tt.Logf(\"PH[foreign reasoning/summary none]: kind=%s vis=%s reasons=%v\", result.DecodedEvents[0].Kind, result.DecodedEvents[0].Visibility, result.DecodedEvents[0].Evidence.ReasonCodes)\n183|\t}\n184|\t// foreign unprotected message\n185|\tline = rec(\"evt-fm\", \"message/user\", \"foreign\", \"none\", \"main\", `{\"text\":\"foreign msg\"}`)\n186|\tresult, err = reviewProject(t, line)\n187|\tif err != nil {\n188|\t\tt.Logf(\"PH[foreign message/user none]: REFUSED %v\", err)\n189|\t} else {\n190|\t\tt.Logf(\"PH[foreign message/user none]: kind=%s vis=%s reasons=%v\", result.DecodedEvents[0].Kind, result.DecodedEvents[0].Visibility, result.DecodedEvents[0].Evidence.ReasonCodes)\n191|\t}\n192|}\n193|\n194|func TestReviewProbeSidecarParsedAsJSONL(t *testing.T) {\n195|\tmembers := []fixtureMember{\n196|\t\t{key: \"store/index.bin\", class: \"durable_index_required\", content: []byte{0x00, 0x01, 0x02}},\n197|\t\t{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(rec(\"evt-a\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`))},\n198|\t}\n199|\tcapture, store := captureMembers(t, members)\n200|\t_, err := Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n201|\tt.Logf(\"PI[binary durable_index_required member]: err=%v\", err)\n202|\tmembers[0] = fixtureMember{key: \"store/cache.bin\", class: \"derived_cache_optional\", content: []byte(\"not json\\n\")}\n203|\tcapture, store = captureMembers(t, members)\n204|\t_, err = Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n205|\tt.Logf(\"PI[text derived_cache_optional member]: err=%v\", err)\n206|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c3","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":316,"recorded_at":1780531400000627,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"call_id":"call_01a0b3d087c472ee8d75b0d3f85da6b7","text":"Read text file `/tmp/rev1/ev/probes/zz_review_under_mutant_test.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|func umProject(t *testing.T, lines ...string) (*NormalizeResult, error) {\n10|\tt.Helper()\n11|\tmembers := []fixtureMember{{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(lines...)}}\n12|\tcapture, store := captureMembers(t, members)\n13|\treturn Normalize(normalizeRequest(t, capture, store, openTestStore(t)))\n14|}\n15|\n16|// UM1: two extra actors; project 12 times and count distinct sealed sessions.\n17|func TestReviewUM1ActorOrderDeterminism(t *testing.T) {\n18|\tmembers := []fixtureMember{{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(\n19|\t\trec(\"e1\", \"message/user\", \"native\", \"none\", \"subagent:zeta\", `{\"text\":\"a\"}`),\n20|\t\trec(\"e2\", \"message/user\", \"native\", \"none\", \"external\", `{\"text\":\"b\"}`),\n21|\t\trec(\"e3\", \"message/user\", \"native\", \"none\", \"subagent:alpha\", `{\"text\":\"c\"}`),\n22|\t)}}\n23|\tcapture, store := captureMembers(t, members)\n24|\tdistinct := map[string]int{}\n25|\tfor i := 0; i < 12; i++ {\n26|\t\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n27|\t\trequest.Actors = map[string]string{\"subagent:zeta\": fixtureSubActor, \"external\": fixtureExtActor, \"subagent:alpha\": \"0198f4d1-9e60-7aaa-83ca-3456789abcde\"}\n28|\t\tresult, err := Normalize(request)\n29|\t\tif err != nil {\n30|\t\t\tt.Fatalf(\"Normalize() error = %v\", err)\n31|\t\t}\n32|\t\tdistinct[string(result.Session)]++\n33|\t}\n34|\tt.Logf(\"UM1: distinct sealed sessions over 12 projections = %d\", len(distinct))\n35|}\n36|\n37|func TestReviewUM2ReasoningEncryptedSigned(t *testing.T) {\n38|\tresult, err := umProject(t, rec(\"e\", \"reasoning/encrypted\", \"foreign\", \"signed\", \"main\", `{\"ciphertext\":\"x\"}`))\n39|\tif err != nil {\n40|\t\tt.Logf(\"UM2: REFUSED %v\", err)\n41|\t\treturn\n42|\t}\n43|\tt.Logf(\"UM2: ADMITTED kind=%s reasons=%v\", result.DecodedEvents[0].Kind, result.DecodedEvents[0].Evidence.ReasonCodes)\n44|}\n45|\n46|func TestReviewUM3DirectiveWidth(t *testing.T) {\n47|\tfor _, n := range []int{4096, 4097} {\n48|\t\tresult, err := umProject(t, rec(\"e\", \"instruction/snapshot\", \"native\", \"none\", \"main\", `{\"authority\":\"high\",\"directives\":[\"`+strings.Repeat(\"d\", n)+`\"]}`))\n49|\t\tif err != nil {\n50|\t\t\tt.Logf(\"UM3[%d]: REFUSED %v\", n, err)\n51|\t\t\tcontinue\n52|\t\t}\n53|\t\tt.Logf(\"UM3[%d]: ADMITTED directives=%d\", n, len(result.Instruction.Directives))\n54|\t}\n55|\tfor _, n := range []int{512, 513} {\n56|\t\tresult, err := umProject(t, rec(\"e\", \"tool/call\", \"native\", \"none\", \"main\", `{\"call_id\":\"`+strings.Repeat(\"c\", n)+`\",\"tool_name\":\"t\"}`))\n57|\t\tif err != nil {\n58|\t\t\tt.Logf(\"UM3b[call_id %d]: REFUSED %v\", n, err)\n59|\t\t\tcontinue\n60|\t\t}\n61|\t\tt.Logf(\"UM3b[call_id %d]: ADMITTED resolutions=%d\", n, len(result.ToolResolutions))\n62|\t}\n63|}\n64|\n65|func TestReviewUM4TrailingBytes(t *testing.T) {\n66|\tline := rec(\"e\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`) + \"x\"\n67|\tresult, err := umProject(t, line)\n68|\tif err != nil {\n69|\t\tt.Logf(\"UM4: REFUSED %v\", err)\n70|\t\treturn\n71|\t}\n72|\tref := result.DecodedEvents[0].Evidence.RawRefs[0]\n73|\tt.Logf(\"UM4: ADMITTED kind=%s range=[%d,%d) line_len=%d\", result.DecodedEvents[0].Kind, ref.Offset, ref.Offset+ref.Length, len(line))\n74|}\n75|\n76|func TestReviewUM5ProtectedToolCall(t *testing.T) {\n77|\tresult, err := umProject(t,\n78|\t\trec(\"pc\", \"tool/call\", \"foreign\", \"encrypted\", \"main\", `{\"ciphertext\":\"x\"}`),\n79|\t\trec(\"pr\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"c1\",\"status\":\"ok\"}`))\n80|\tif err != nil {\n81|\t\tt.Logf(\"UM5: REFUSED %v\", err)\n82|\t\treturn\n83|\t}\n84|\tt.Logf(\"UM5: ADMITTED kinds=%s/%s resolutions=%+v\", result.DecodedEvents[0].Kind, result.DecodedEvents[1].Kind, result.ToolResolutions)\n85|}\n86|\n87|func TestReviewUM6ResultStatusPending(t *testing.T) {\n88|\tresult, err := umProject(t,\n89|\t\trec(\"c\", \"tool/call\", \"native\", \"none\", \"main\", `{\"call_id\":\"c1\",\"tool_name\":\"t\"}`),\n90|\t\trec(\"r\", \"tool/result\", \"native\", \"none\", \"main\", `{\"call_id\":\"c1\",\"status\":\"pending\"}`))\n91|\tif err != nil {\n92|\t\tt.Logf(\"UM6: REFUSED %v\", err)\n93|\t\treturn\n94|\t}\n95|\tt.Logf(\"UM6: ADMITTED resolutions=%+v result payload=%v live=%+v\", result.ToolResolutions, result.DecodedEvents[1].Payload, result.Live)\n96|}\n97|\n98|func TestReviewUM8UnknownProtectedBody(t *testing.T) {\n99|\tresult, err := umProject(t, rec(\"u\", \"frobnicate\", \"foreign\", \"encrypted\", \"main\", `{\"mystery\":true}`))\n100|\tif err != nil {\n101|\t\tt.Logf(\"UM8: REFUSED %v\", err)\n102|\t\treturn\n103|\t}\n104|\tev := result.DecodedEvents[0]\n105|\tresolved := mustResolveRefLoose(t, result, ev)\n106|\tt.Logf(\"UM8: ADMITTED kind=%s reasons=%v raw_ok=%v\", ev.Kind, ev.Evidence.ReasonCodes, resolved)\n107|}\n108|\n109|func mustResolveRefLoose(t *testing.T, result *NormalizeResult, ev interface{ }) bool {\n110|\t_ = result\n111|\t_ = ev\n112|\treturn true\n113|}\n114|\n115|func TestReviewUM7SizeCheck(t *testing.T) {\n116|\tmembers := []fixtureMember{{key: \"store/session.jsonl\", class: \"durable_payload\", content: jsonl(rec(\"e\", \"message/user\", \"native\", \"none\", \"main\", `{\"text\":\"x\"}`))}}\n117|\tcapture, store := captureMembers(t, members)\n118|\trequest := normalizeRequest(t, capture, store, openTestStore(t))\n119|\thealthy := request.Fetch\n120|\trequest.Fetch = func(id string) ([]byte, error) {\n121|\t\tpayload, err := healthy(id)\n122|\t\tif err != nil {\n123|\t\t\treturn nil, err\n124|\t\t}\n125|\t\treturn append(payload, '\\n'), nil // one extra byte: size drifts, digest drifts\n126|\t}\n127|\t_, err := Normalize(request)\n128|\tt.Logf(\"UM7: extra-byte blob -> err=%v\", err)\n129|\t_ = bytes.Equal\n130|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
