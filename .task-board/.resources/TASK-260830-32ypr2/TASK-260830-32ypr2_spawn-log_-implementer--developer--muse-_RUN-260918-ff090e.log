{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8bb","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":696,"recorded_at":1780531400001387,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d1-4f3f-7dc0-bf18-dabde68138ce"},"task_id":"01a0b3d1-4f3f-7dc0-bf18-dabde68138ce","event":{"kind":"output","task_id":"01a0b3d1-4f3f-7dc0-bf18-dabde68138ce","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/cloneproject/errors.go`.\n1|package cloneproject\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|)\n7|\n8|// ErrInvalid is the refusal for every malformed projection input and\n9|// every fidelity violation: undecodable manifests, unstable or\n10|// mismatched capture closure, missing or disagreeing blobs,\n11|// malformed native framing, contradictory protection claims, live\n12|// authority claimed by captured history, and ambiguous tool\n13|// pairings. Callers match with errors.Is; the message names the\n14|// offending member, record, or blob.\n15|var ErrInvalid = errors.New(\"cloneproject: invalid projection\")\n16|\n17|func invalid(format string, arguments ...any) error {\n18|\treturn fmt.Errorf(\"%w: %s\", ErrInvalid, fmt.Sprintf(format, arguments...))\n19|}","final_result":true}}}
