9|\tif environ.StringLength(callID) < 1 || environ.StringLength(callID) > 512 {\n470|\t\treturn toolResultBody{}, invalid(\"%s body call_id is not a string[1..512]\", where)\n471|\t}\n472|\tstatus, err := bodyString(record, members, \"status\")\n473|\tif err != nil {\n474|\t\treturn toolResultBody{}, err\n475|\t}\n476|\tif status != \"ok\" && status != \"error\" {\n477|\t\treturn toolResultBody{}, invalid(\"%s body status %q is outside ok|error\", where, status)\n478|\t}\n479|\tfollowup, err := bodyOptionalBool(record, members, \"live_followup\")\n480|\tif err != nil {\n481|\t\treturn toolResultBody{}, err\n482|\t}\n483|\treturn toolResultBody{CallID: callID, Status: status, LiveFollowup: followup}, nil\n484|}\n485|\n486|// usageBody is the exact usage-report body.\n487|type usageBody struct {\n488|\tInputTokens  uint64\n489|\tOutputTokens uint64\n490|}\n491|\n492|// decodeUsageBody validates the exact token body.\n493|func decodeUsageBody(record NativeRecord) (usageBody, error) {\n494|\tmembers, err := decodeBodyObject(record,\n495|\t\t[]string{\"input_tokens\", \"output_tokens\"},\n496|\t\tmap[string]bool{\"input_tokens\": true, \"output_tokens\": true})\n497|\tif err != nil {\n498|\t\treturn usageBody{}, err\n499|\t}\n500|\tinput, err := bodyUint53(record, members, \"input_tokens\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
