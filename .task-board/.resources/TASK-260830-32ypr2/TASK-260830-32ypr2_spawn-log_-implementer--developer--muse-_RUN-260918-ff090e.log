{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd0f","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":1250,"recorded_at":1780531400002495,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"call_id":"call_01a0b3d6db54721e8c4a9eca6d6dfd2c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/traceability/registry_rederivation_test.go`.\n(499 line(s) above)\n500|\t// this pin deliberately, and any other drift fails here.\n501|\tif now.Production.Declaration != \"VerifyV060\" || now.Production.Path != \"internal/specpin/pin.go\" {\n502|\t\tt.Fatalf(\"source group production = %+v, want the carried VerifyV060 reference (see F1)\", now.Production)\n503|\t}\n504|}\n505|\n506|func assertPinFixtureGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n507|\tt.Helper()\n508|\n509|\told := ownershipGroupByKindAndKeys(t, previous, ownershipFixture, \"pin:ax-session-directory-conformance-v1\")\n510|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipFixture, \"pin:ax-session-directory-conformance-v1\")\n511|\tif now.Production != old.Production {\n512|\t\tt.Fatalf(\"pin fixture group production moved from %+v to %+v\", old.Production, now.Production)\n513|\t}\n514|\twantCases := []string{\"source-pin-exact\", \"source-pin-refusal\", \"source-pin-v060-exact\", \"source-pin-v060-refusal\", \"source-pin-v070-exact\", \"source-pin-v070-refusal\"}\n515|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n516|\t\tt.Fatalf(\"pin fixture group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n517|\t}\n518|\toldKeys := oldKeySet(old.Keys)\n519|\tfor _, key := range now.Keys {\n520|\t\tif _, carried := oldKeys[key]; !carried && key != launchPlanFixtureKey {\n521|\t\t\tt.Fatalf(\"pin fixture group key %q is not carried and not the Launch Plan fixture\", key)\n522|\t\t}\n523|\t\tdelete(oldKeys, key)\n524|\t}\n525|\tif len(oldKeys) != 0 {\n526|\t\tt.Fatalf(\"pin fixture group drops %d carried keys\", len(oldKeys))\n527|\t}\n528|}\n529|\n530|func assertUnownedSectionsCarried(t *testing.T, previous, current ownershipRegistry) {\n531|\tt.Helper()\n532|\n533|\tif len(current.UnownedSections) != len(previous.UnownedSections) {\n534|\t\tt.Fatalf(\"unowned sections length moved from %d to %d\", len(previous.UnownedSections), len(current.UnownedSections))\n535|\t}\n536|\tfor index, old := range previous.UnownedSections {\n537|\t\tnow := current.UnownedSections[index]\n538|\t\tif now.Key != old.Key {\n539|\t\t\tt.Fatalf(\"unowned section %d key moved from %q to %q\", index, old.Key, now.Key)\n540|\t\t}\n541|\t\tif now == old {\n542|\t\t\tcontinue\n543|\t\t}\n544|\t\tif now.Key != \"section:11.10.5\" {\n545|\t\t\tt.Fatalf(\"unowned section %q changed without a reviewed rewording\", now.Key)\n546|\t\t}\n547|\t\tif now.Evidence != old.Evidence {\n548|\t\t\tt.Fatalf(\"unowned section 11.10.5 evidence changed\")\n549|\t\t}\n550|\t\tif !strings.Contains(now.Gap, \"Disclosure owner: TASK-260830-2x16gz\") {\n551|\t\t\tt.Fatalf(\"unowned section 11.10.5 gap lacks the Disclosure owner rewording: %q\", now.Gap)\n552|\t\t}\n553|\t}\n554|}\n555|\n556|// storyBindingUpgrade is the reviewed post-adoption upgrade of one carried\n557|// v0.7.0 binding. The mesh-rpc-framing-and-negotiation story final leaf\n558|// (STORY-260830-4qojoz / TASK-260830-19bjfj) moves three unevidenced stubs to\n559|// measured coverage, and the canonical-session-capture-and-evidence story\n560|// final leaf (STORY-260830-1cyj0q / TASK-260830-32ypr2) moves two more stubs\n561|// to full coverage; every field below is pinned literally, so the\n562|// re-derivation gate keeps failing on any drift outside the reviewed\n563|// upgrades. Section 11.3 is deliberately absent: no test drives a\n564|// digest-identity array, so it stays the carried unevidenced stub. Section\n565|// 13.14.1 is likewise absent: it carries no registry binding at all, so\n566|// there is no carried stub to upgrade.\n567|type storyBindingUpgrade struct {\n568|\tProduction codeReference\n569|\tCases      []string\n570|\tCoverage   coverageLevel\n571|\tGap        string\n572|\tClauses    []dischargedClause\n573|}\n574|\n575|var storyUpgradedV070Bindings = map[string]storyBindingUpgrade{\n576|\t\"section:11.2\": {\n577|\t\tProduction: codeReference{Path: \"internal/rpcwire/envelope.go\", Declaration: \"DecodeRequest\"},\n578|\t\tCases:      []string{\"rpcwire-closed-bodies\", \"rpcwire-framing\", \"catalog-v050-exact\"},\n579|\t\tCoverage:   coveragePartial,\n580|\t\tGap:        \"Section 11.2 clauses 11.2#1 and 11.2#5 (hello-first sequencing) are executed only for the RPC-5 Host Channel responder: DecodeRequest is a stateless codec with no handshake memory, and no legacy `ax rpc serve` responder exists in the tree, so the legacy sequencing lane stays a stated bound while the codec-enforced clauses discharge above.\",\n581|\t\tClauses: []dischargedClause{\n582|\t\t\t{ID: \"11.2#2\", Line: 7364, Excerpt: \"state, Structured Error, Observation Event, and CLI Result MUST NOT appear in\", AcceptanceCases: []string{\"rpcwire-closed-bodies\"}},\n583|\t\t\t{ID: \"11.2#3\", Line: 7408, Excerpt: \"<code>ok = false</code> and one Structured Error and MUST omit body. Unknown\", AcceptanceCases: []string{\"rpcwire-framing\"}},\n584|\t\t\t{ID: \"11.2#4\", Line: 7420, Excerpt: \"at least the values shown and MUST refuse a peer below them. The 5 MiB object\", AcceptanceCases: []string{\"rpcwire-closed-bodies\"}},\n585|\t\t},\n586|\t},\n587|\t\"section:17.1\": {\n588|\t\tProduction: codeReference{Path: \"internal/meshneg/negotiate.go\", Declaration: \"Negotiate\"},\n589|\t\tCases:      []string{\"meshneg-selection\", \"rpcwire-version-boundary\", \"config-versioned-readers\"},\n590|\t\tCoverage:   coveragePartial,\n591|\t\tGap:        \"Section 17.1 clauses 17.1#2 (minor-version semantic preservation) and 17.1#6 (v1 materialization upgrade) are outside Negotiate, which selects majors only: no minor-selection entry exists, immutable-object namespaced extensions (17.1#3) belong to the object-exchange owners, and materialization upgrade belongs to the matjournal and provhost owners. The retained config-versioned-readers case keeps the config Decode lanes traceable.\",\n592|\t\tClauses: []dischargedClause{\n593|\t\t\t{ID: \"17.1#1\", Line: 15567, Excerpt: \"- a major increment MAY break syntax or semantics and MUST require explicit\", AcceptanceCases: []string{\"meshneg-selection\"}},\n594|\t\t\t{ID: \"17.1#4\", Line: 15589, Excerpt: \"highest mutually supported minor within a common major; they MUST NOT select a\", AcceptanceCases: []string{\"meshneg-selection\"}},\n595|\t\t\t{ID: \"17.1#5\", Line: 15602, Excerpt: \"immutable v0.1.0 contracts and MUST NOT be interpreted using the corrected\", AcceptanceCases: []string{\"meshneg-selection\", \"rpcwire-version-boundary\"}},\n596|\t\t},\n597|\t},\n598|\t\"section:17.4\": {\n599|\t\tProduction: codeReference{Path: \"internal/meshneg/negotiate.go\", Declaration: \"Negotiate\"},\n600|\t\tCases:      []string{\"story-4qojoz-mesh-negotiation\", \"config-read-only-downgrade\", \"config-durable-migration\"},\n601|\t\tCoverage:   coverageSliver,\n602|\t\tGap:        \"Section 17.4 clauses 17.4#1 through 17.4#3 (upgrade checks, downgraded-binary read-only mode, no resume or transfer) are outside Negotiate: no upgrade, downgrade, or auto-resume flow exists in the tree, so only the activation-unavailable exposure clause discharges above. The retained config cases keep the AssessCompatibility downgrade-assessment lanes traceable.\",\n603|\t\tClauses: []dischargedClause{\n604|\t\t\t{ID: \"17.4#4\", Line: 15661, Excerpt: \"immutable evidence; it MUST report activation unavailable rather than omit the\", AcceptanceCases: []string{\"story-4qojoz-mesh-negotiation\"}},\n605|\t\t},\n606|\t},\n607|\t\"section:7.8\": {\n608|\t\tProduction: codeReference{Path: \"internal/cloneproject/normalize.go\", Declaration: \"Normalize\"},\n609|\t\tCases:      []string{\"clone-projection-fidelity\", \"session-adapter-call-binding\"},\n610|\t\tCoverage:   coverageFull,\n611|\t\tGap:        \"\",\n612|\t\tClauses: []dischargedClause{\n613|\t\t\t{ID: \"7.8#1\", Line: 3785, Excerpt: \"Large data is referenced by manifest or Blob Descriptor ID and MUST NOT be embedded in the 8 MiB frame.\", AcceptanceCases: []string{\"clone-projection-fidelity\"}},\n614|\t\t\t{ID: \"7.8#2\", Line: 3912, Excerpt: \"target mutation, these facts MUST equal freshly read trusted-candidate facts and the Journal binding.\", AcceptanceCases: []string{\"session-adapter-call-binding\"}},\n615|\t\t},\n616|\t},\n617|\t\"section:10.2\": {\n618|\t\tProduction: codeReference{Path: \"internal/clonesnap/capture.go\", Declaration: \"Capture\"},\n619|\t\tCases:      []string{\"clone-capture-contracts\", \"clone-native-capture\", \"clone-projection-fidelity\"},\n620|\t\tCoverage:   coverageFull,\n621|\t\tGap:        \"\",\n622|\t\tClauses: []dischargedClause{\n623|\t\t\t{ID: \"10.2#1\", Line: 4854, Excerpt: \"MUST live in a manifest, not in the blob path.\", AcceptanceCases: []string{\"clone-capture-contracts\"}},\n624|\t\t\t{ID: \"10.2#2\", Line: 4855, Excerpt: \"references a blob, the writer MUST fsync the blob, verify its size and digest, and atomically install it in the object store.\", AcceptanceCases: []string{\"clone-native-capture\", \"clone-projection-fidelity\"}},\n625|\t\t\t{ID: \"10.2#3\", Line: 4859, Excerpt: \"metrics MUST record digest, size, and media type only, never blob contents.\", AcceptanceCases: []string{\"clone-native-capture\"}},\n626|\t\t\t{ID: \"10.2#4\", Line: 4862, Excerpt: \"<code>urn:ax:schema:blob</code> version <code>1.0.0</code>. Chunks MUST be sorted, contiguous, non-overlapping, start at offset zero, and cover exactly <code>size</code> bytes:\", AcceptanceCases: []string{\"clone-native-capture\"}},\n627|\t\t\t{ID: \"10.2#5\", Line: 4902, Excerpt: \"A larger file MUST fail capture with <code>capability_unavailable</code> before publishing a partial manifest.\", AcceptanceCases: []string{\"clone-native-capture\"}},\n628|\t\t},\n629|\t},\n630|}\n631|\n632|// storyNewV070Cases is the exact set of acceptance cases the post-adoption\n633|// story final leaves add to the adopted registry. Each is pinned literally;\n634|// any further addition still fails as an unreviewed claim.\n635|var storyNewV070Cases = map[string]acceptanceCase{\n636|\t\"rpcwire-closed-bodies\": {\n637|\t\tID:         \"rpcwire-closed-bodies\",\n638|\t\tProduction: codeReference{Path: \"internal/rpcwire/envelope.go\", Declaration: \"DecodeRequest\"},\n639|\t\tTests: []codeReference{\n640|\t\t\t{Path: \"internal/rpcwire/adversarial_test.go\", Declaration: \"TestClosedBodyMemberSweep\"},\n641|\t\t\t{Path: \"internal/rpcwire/adversarial_test.go\", Declaration: \"TestClosedBodyBoundsWitnessed\"},\n642|\t\t\t{Path: \"internal/rpcwire/envelope_test.go\", Declaration: \"TestHelloRefusals\"},\n643|\t\t},\n644|\t},\n645|\t\"rpcwire-framing\": {\n646|\t\tID:         \"rpcwire-framing\",\n647|\t\tProduction: codeReference{Path: \"internal/rpcwire/envelope.go\", Declaration: \"DecodeResponse\"},\n648|\t\tTests: []codeReference{\n649|\t\t\t{Path: \"internal/rpcwire/envelope_test.go\", Declaration: \"TestHistoricalFailureBindings\"},\n650|\t\t\t{Path: \"internal/rpcwire/envelope_test.go\", Declaration: \"TestBootstrapRejectionFraming\"},\n651|\t\t},\n652|\t},\n653|\t\"meshneg-selection\": {\n654|\t\tID:         \"meshneg-selection\",\n655|\t\tProduction: codeReference{Path: \"internal/meshneg/negotiate.go\", Declaration: \"Negotiate\"},\n656|\t\tTests: []codeReference{\n657|\t\t\t{Path: \"internal/meshneg/adversarial_test.go\", D