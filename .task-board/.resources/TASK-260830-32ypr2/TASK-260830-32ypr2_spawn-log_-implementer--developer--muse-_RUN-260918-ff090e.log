tring `json:\"id\"`\n201|\t\t\t} `json:\"clauses\"`\n202|\t\t} `json:\"ownership\"`\n203|\t}\n204|\tif err := json.Unmarshal(raw, &registry); err != nil {\n205|\t\tt.Fatalf(\"decode adopted ownership registry: %v\", err)\n206|\t}\n207|\tbindings, clauses := 0, 0\n208|\tfor _, group := range registry.Ownership {\n209|\t\tif group.Kind != \"section_binding\" || group.Coverage != \"full\" {\n210|\t\t\tcontinue\n211|\t\t}\n212|\t\tbindings++\n213|\t\tclauses += len(group.Clauses)\n214|\t}\n215|\treturn bindings, clauses\n216|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
