se *ast.TypeSpec:\\n\\t\\t\\t\\t\\tif item.Name.Name == name {\\n\\t\\t\\t\\t\\t\\treturn true\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\tcase *ast.ValueSpec:\\n\\t\\t\\t\\t\\tfor _, identifier := range item.Names {\\n\\t\\t\\t\\t\\t\\tif identifier.Name == name {\\n\\t\\t\\t\\t\\t\\t\\treturn true\\n\\t\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n\",\n  \"original_output_bytes\": 2638,\n  \"original_output_tokens\": 660,\n  \"truncated\": false\n}","final_result":true}}}
