{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccd9","stream":{"kind":"session","id":"01a0b3cf-5753-7b41-a2b3-ce03595a21fa"},"sequence":1223,"recorded_at":1780531400002441,"record_type":"event","durability":"durable","causation_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c","run_stream":{"kind":"run","id":"f856bb23-ad72-4bdf-8e88-2c200bbb093c"},"task_stream":{"kind":"task","id":"01a0b3d6-d3ff-7ca3-88d2-d22272567cdb"},"task_id":"01a0b3d6-d3ff-7ca3-88d2-d22272567cdb","event":{"kind":"output","task_id":"01a0b3d6-d3ff-7ca3-88d2-d22272567cdb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1cyj0q/worktree/internal/traceability/registry_rederivation_test.go`.\n1|package traceability\n2|\n3|import (\n4|\t\"os\"\n5|\t\"reflect\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n11|)\n12|\n13|// expectedV070Source is the reviewed normative source the adopted v0.7.0\n14|// registry must bind. It repeats the provenance the pin leaf verified from a\n15|// fresh upstream clone (tag v0.7.0, peeled commit,LF document digest) so a\n16|// registry that drifts to another source fails here before any binding is read.\n17|var expectedV070Source = registrySource{\n18|\tRepository:     \"relux-works/agent-session-manager-spec\",\n19|\tRelease:        \"v0.7.0\",\n20|\tCommit:         \"32b3f2ba7c377248a53cd42389abbd2f1c321834\",\n21|\tDocumentPath:   \"SPEC.md\",\n22|\tDocumentSHA256: \"c6b2fe64ee79ed697a96ed27a1679c80b8ee1eba137feb99e7738b4da289ddcf\",\n23|}\n24|\n25|// newV070Bindings is the exact set of section bindings the v0.7.0 adoption\n26|// may add over the trunk v0.6.0 registry. Every other v0.7.0 binding must be\n27|// carried, and every binding here must name its implementing story, so a\n28|// self-minted implementation claim has nowhere to hide.\n29|var newV070Bindings = map[string]string{\n30|\t\"section:13.1\":  \"STORY-260916-3fjjtn\",\n31|\t\"section:13.10\": \"STORY-260916-3aukw3\",\n32|\t\"section:14.1\":  \"STORY-260916-3fjjtn\",\n33|}\n34|\n35|// newV070Cases is the exact set of acceptance cases the v0.7.0 adoption may\n36|// add. Carried cases must otherwise be byte-equal to the v0.6.0 registry,\n37|// except for the two intended repoints asserted inline below.\n38|var newV070Cases = map[string]struct{}{\n39|\t\"catalog-v070-exact\":      {},\n40|\t\"source-pin-v070-exact\":   {},\n41|\t\"source-pin-v070-refusal\": {},\n42|}\n43|\n44|// rewordedV070Gaps maps the carried bindings whose gap the adoption rewords\n45|// to the story that must own the new text. appendix-d carries a split\n46|// attribution (\"pending STORY-...\") rather than the owner formula.\n47|var rewordedV070Gaps = map[string]string{\n48|\t\"section:5.1\":        \"STORY-260916-2q85nu\",\n49|\t\"section:7.3\":        \"STORY-260916-1ea7od\",\n50|\t\"section:7.4\":        \"STORY-260916-1ea7od\",\n51|\t\"section:7.5\":        \"STORY-260916-1kp1lx\",\n52|\t\"section:appendix-d\": \"STORY-260916-vucwn0\",\n53|}\n54|\n55|const (\n56|\tlaunchPlanContractKey = \"Launch Plan request [urn:ax:schema:launch-plan-request]\"\n57|\tlaunchPlanFixtureKey  = \"pin:ax-launch-plan-request-v1\"\n58|)\n59|\n60|// TestV070RegistryRederivesFromTrunkV060Registry re-derives the adopted v0.7.0\n61|// ownership registry from the trunk-final v0.6.0 registry and fails on any\n62|// missing binding, any unshifted clause line, or any self-minted claim.\n63|//\n64|// The v0.6.0 file in this tree is the trunk baseline: the suite's historical\n65|// byte-identity gate keeps it equal to trunk, and this test treats it as the\n66|// derivation source. Production VerifyRepository pins the exact adopted bytes\n67|// through reviewedOwnershipCanonicalSHA256; this test pins the derivation\n68|// relationship between the two registries, so neither a dropped carry nor an\n69|// unreviewed addition can pass as a re-derivation.\n70|//\n71|// Post-adoption stories upgrade the adopted registry deliberately through\n72|// storyUpgradedV070Bindings and storyNewV070Cases: each named upgrade is\n73|// pinned literally and re-measured against the pinned v0.7.0 document, while\n74|// every other binding and case still rederives byte-equal.\n75|func TestV070RegistryRederivesFromTrunkV060Registry(t *testing.T) {\n76|\tt.Parallel()\n77|\n78|\tprevious := decodeRegistryFile(t, \"ownership.v0.6.0.json\")\n79|\tcurrent := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n80|\n81|\tif current.Source != expectedV070Source {\n82|\t\tt.Fatalf(\"v0.7.0 registry source = %+v, want %+v\", current.Source, expectedV070Source)\n83|\t}\n84|\n85|\tpreviousBindings := sectionBindingsByKey(t, previous)\n86|\tcurrentBindings := sectionBindingsByKey(t, current)\n87|\n88|\tassertNoMissingBindings(t, previousBindings, currentBindings)\n89|\tassertNewBindingsAreReviewed(t, previousBindings, currentBindings)\n90|\tassertCarriedBindingsRederive(t, previousBindings, currentBindings)\n91|\tassertClauseLinesRemeasured(t, previousBindings, currentBindings)\n92|\tassertAcceptanceCasesRederive(t, previous, current)\n93|\tassertOwnershipGroupsRederive(t, previous, current)\n94|\tassertUnownedSectionsCarried(t, previous, current)\n95|}\n96|\n97|func decodeRegistryFile(t *testing.T, name string) ownershipRegistry {\n98|\tt.Helper()\n99|\n100|\traw, err := os.ReadFile(name)\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"read %s: %v\", name, err)\n103|\t}\n104|\tregistry, err := decodeOwnershipRegistry(raw)\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"decode %s: %v\", name, err)\n107|\t}\n108|\treturn registry\n109|}\n110|\n111|func sectionBindingsByKey(t *testing.T, registry ownershipRegistry) map[string]ownershipGroup {\n112|\tt.Helper()\n113|\n114|\tresult := make(map[string]ownershipGroup)\n115|\tfor _, group := range registry.Ownership {\n116|\t\tif group.Kind != ownershipSectionBinding {\n117|\t\t\tcontinue\n118|\t\t}\n119|\t\tif len(group.Keys) != 1 {\n120|\t\t\tt.Fatalf(\"section binding group carries %d keys %q, want exactly 1\", len(group.Keys), group.Keys)\n121|\t\t}\n122|\t\tkey := group.Keys[0]\n123|\t\tif _, duplicate := result[key]; duplicate {\n124|\t\t\tt.Fatalf(\"duplicate section binding %q\", key)\n125|\t\t}\n126|\t\tresult[key] = group\n127|\t}\n128|\treturn result\n129|}\n130|\n131|func assertNoMissingBindings(t *testing.T, previous, current map[string]ownershipGroup) {\n132|\tt.Helper()\n133|\n134|\tvar missing []string\n135|\tfor key := range previous {\n136|\t\tif _, ok := current[key]; !ok {\n137|\t\t\tmissing = append(missing, key)\n138|\t\t}\n139|\t}\n140|\tsort.Strings(missing)\n141|\tif len(missing) > 0 {\n142|\t\tt.Fatalf(\"v0.7.0 registry drops %d carried bindings: %q\", len(missing), missing)\n143|\t}\n144|}\n145|\n146|func assertNewBindingsAreReviewed(t *testing.T, previous, current map[string]ownershipGroup) {\n147|\tt.Helper()\n148|\n149|\tfor key, group := range current {\n150|\t\tif _, carried := previous[key]; carried {\n151|\t\t\tcontinue\n152|\t\t}\n153|\t\tstory, ok := newV070Bindings[key]\n154|\t\tif !ok {\n155|\t\t\tt.Fatalf(\"v0.7.0 binding %q is not carried and not a reviewed addition\", key)\n156|\t\t}\n157|\t\tif !strings.Contains(group.Gap, \"Pending implementation owner: \"+story) {\n158|\t\t\tt.Fatalf(\"v0.7.0 binding %q gap does not name its implementing story %s: %q\", key, story, group.Gap)\n159|\t\t}\n160|\t\tif group.Coverage != coverageUnevidenced {\n161|\t\t\tt.Fatalf(\"v0.7.0 binding %q claims %s coverage, want unevidenced for a story-owned stub\", key, group.Coverage)\n162|\t\t}\n163|\t\tif len(group.Clauses) != 0 {\n164|\t\t\tt.Fatalf(\"v0.7.0 binding %q enumerates %d clauses, want none for a story-owned stub\", key, len(group.Clauses))\n165|\t\t}\n166|\t}\n167|\tfor key := range newV070Bindings {\n168|\t\tif _, ok := current[key]; !ok {\n169|\t\t\tt.Fatalf(\"reviewed v0.7.0 binding %q is absent\", key)\n170|\t\t}\n171|\t}\n172|}\n173|\n174|func assertCarriedBindingsRederive(t *testing.T, previous, current map[string]ownershipGroup) {\n175|\tt.Helper()\n176|\n177|\tfor key, old := range previous {\n178|\t\tnow, ok := current[key]\n179|\t\tif !ok {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\tif upgrade, upgraded := storyUpgradedV070Bindings[key]; upgraded {\n183|\t\t\tassertStoryBindingUpgrade(t, key, old, now, upgrade)\n184|\t\t\tcontinue\n185|\t\t}\n186|\t\tif now.Production != old.Production {\n187|\t\t\tt.Fatalf(\"binding %q production moved from %+v to %+v\", key, old.Production, now.Production)\n188|\t\t}\n189|\t\tif !reflect.DeepEqual(now.AcceptanceCases, old.AcceptanceCases) {\n190|\t\t\tt.Fatalf(\"binding %q acceptance cases moved from %q to %q\", key, old.AcceptanceCases, now.AcceptanceCases)\n191|\t\t}\n192|\t\tif now.Coverage != old.Coverage {\n193|\t\t\tt.Fatalf(\"binding %q coverage moved from %s to %s\", key, old.Coverage, now.Coverage)\n194|\t\t}\n195|\t\tstory, reworded := rewordedV070Gaps[key]\n196|\t\tif !reworded {\n197|\t\t\tif now.Gap != old.Gap {\n198|\t\t\t\tt.Fatalf(\"binding %q gap changed without a reviewed rewording\", key)\n199|\t\t\t}\n200|\t\t\tcontinue\n201|\t\t}\n202|\t\tif now.Gap == old.Gap {\n203|\t\t\tt.Fatalf(\"binding %q gap was not reworded to its story owner\", key)\n204|\t\t}\n205|\t\tif !strings.Contains(now.Gap, story) {\n206|\t\t\tt.Fatalf(\"binding %q reworded gap does not name %s: %q\", key, story, now.Gap)\n207|\t\t}\n208|\t}\n209|}\n210|\n211|// assertClauseLinesRemeasured checks every carried clause against the pinned\n212|// document it cites, using the production clause inventory and quote matcher.\n213|// A clause whose v0.7.0 line still points at the v0.6.0 position fails twice:\n214|// the measured line differs and the excerpt no longer begins there.\n215|func assertClauseLinesRemeasured(t *testing.T, previous, current map[string]ownershipGroup) {\n216|\tt.Helper()\n217|\n218|\tdocument060, err := specdoc.LoadV060()\n219|\tif err != nil {\n220|\t\tt.Fatalf(\"LoadV060: %v\", err)\n221|\t}\n222|\tdocument070, err := specdoc.LoadV070()\n223|\tif err != nil {\n224|\t\tt.Fatalf(\"LoadV070: %v\", err)\n225|\t}\n226|\tmeasured060 := measuredClauseLines(t, document060, previous, \"v0.6.0\")\n227|\tmeasured070 := measuredClauseLines(t, document070, current, \"v0.7.0\")\n228|\n229|\tfor key, old := range previous {\n230|\t\tnow, ok := current[key]\n231|\t\tif !ok {\n232|\t\t\tcontinue\n233|\t\t}\n234|\t\tif _, upgraded := storyUpgradedV070Bindings[key]; upgraded {\n235|\t\t\tassertStoryBindingClausesRemeasured(t, key, old, now, measured070)\n236|\t\t\tcontinue\n237|\t\t}\n238|\t\tif len(now.Clauses) != len(old.Clauses) {\n239|\t\t\tt.Fatalf(\"binding %q carries %d clauses, want %d\", key, len(now.Clauses), len(old.Clauses))\n240|\t\t}\n241|\t\tfor index, oldClause := range old.Clauses {\n242|\t\t\tnewClause := now.Clauses[index]\n243|\t\t\tif newClause.ID != oldClause.ID {\n244|\t\t\t\tt.Fatalf(\"binding %q clause %d id moved from %s to %s\", key, index, oldClause.ID, newClause.ID)\n245|\t\t\t}\n246|\t\t\tif newClause.Excerpt != oldClause.Excerpt {\n247|\t\t\t\tt.Fatalf(\"binding %q clause %s excerpt changed\", key, oldClause.ID)\n248|\t\t\t}\n249|\t\t\tif !reflect.DeepEqual(newClause.AcceptanceCases, oldClause.AcceptanceCases) {\n250|\t\t\t\tt.Fatalf(\"binding %q clause %s acceptance cases moved\", key, oldClause.ID)\n251|\t\t\t}\n252|\t\t\tif newClause.Line == oldClause.Line {\n253|\t\t\t\tt.Fatalf(\"binding %q clause %s still cites v0.6.0 line %d; every carried clause shifts in v0.7.0\",\n254|\t\t\t\t\tkey, oldClause.ID, oldClause.Line)\n255|\t\t\t}\n256|\t\t\tif measured060[key][oldClause.ID] != oldClause.Line {\n257|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.6.0 line %d is not the measured line %d\",\n258|\t\t\t\t\tkey, oldClause.ID, oldClause.Line, measured060[key][oldClause.ID])\n259|\t\t\t}\n260|\t\t\tif measured070[key][newClause.ID] != newClause.Line {\n261|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.7.0 line %d is not the measured line %d\",\n262|\t\t\t\t\tkey, newClause.ID, newClause.Line, measured070[key][newClause.ID])\n263|\t\t\t}\n264|\t\t}\n265|\t}\n266|}\n267|\n268|// measuredClauseLines returns the production-measured line of every normative\n269|// clause the pinned document carries for the given bindings, verifying each\n270|// binding's declared excerpts quote verbatim at their declared lines.\n271|func measuredClauseLines(t *testing.T, document *specdoc.Document, bindings map[string]ownershipGroup, tag string) map[string]map[string]int {\n272|\tt.Helper()\n273|\n274|\tresult := make(map[string]map[string]int, len(bindings))\n275|\tfor key, group := range bindings {\n276|\t\tif len(group.Clauses) == 0 {\n277|\t\t\tcontinue\n278|\t\t}\n279|\t\tinventory, err := sectionClauseInventory(document, key)\n280|\t\tif err != nil {\n281|\t\t\tt.Fatalf(\"%s binding %q inventory: %v\", tag, key, err)\n282|\t\t}\n283|\t\tlines := make(map[string]int, len(inventory))\n284|\t\tfor _, clause := range inventory {\n285|\t\t\tlines[clause.ID] = clause.Line\n286|\t\t}\n287|\t\tfor _, discharged := range group.Clauses {\n288|\t\t\tif _, ok := lines[discharged.ID]; !ok {\n289|\t\t\t\tt.Fatalf(\"%s binding %q clause %s is not a measured clause of its section\", tag, key, discharged.ID)\n290|\t\t\t}\n291|\t\t\tif !quoteBeginsAtLine(document, discharged.Excerpt, discharged.Line) {\n292|\t\t\t\tt.Fatalf(\"%s binding %q clause %s excerpt does not begin at line %d\", tag, key, discharged.ID, discharged.Line)\n293|\t\t\t}\n294|\t\t}\n295|\t\tresult[key] = lines\n296|\t}\n297|\treturn result\n298|}\n299|\n300|func assertAcceptanceCasesRederive(t *testing.T, previous, current ownershipRegistry) {\n301|\tt.Helper()\n302|\n303|\toldCases := make(map[string]acceptanceCase, len(previous.AcceptanceCases))\n304|\tfor _, c := range previous.AcceptanceCases {\n305|\t\toldCases[c.ID] = c\n306|\t}\n307|\tnewCases := make(map[string]acceptanceCase, len(current.AcceptanceCases))\n308|\tfor _, c := range current.AcceptanceCases {\n309|\t\tif _, duplicate := newCases[c.ID]; duplicate {\n310|\t\t\tt.Fatalf(\"duplicate v0.7.0 acceptance case %q\", c.ID)\n311|\t\t}\n312|\t\tnewCases[c.ID] = c\n313|\t}\n314|\tfor id := range oldCases {\n315|\t\tif _, ok := newCases[id]; !ok {\n316|\t\t\tt.Fatalf(\"v0.7.0 registry drops carried acceptance case %q\", id)\n317|\t\t}\n318|\t}\n319|\tfor id := range newCases {\n320|\t\tif _, carried := oldCases[id]; carried {\n321|\t\t\tcontinue\n322|\t\t}\n323|\t\tif _, ok := newV070Cases[id]; !ok {\n324|\t\t\tif _, ok := storyNewV070Cases[id]; !ok {\n325|\t\t\t\tt.Fatalf(\"v0.7.0 acceptance case %q is not carried and not a reviewed addition\", id)\n326|\t\t\t}\n327|\t\t}\n328|\t}\n329|\tfor id := range newV070Cases {\n330|\t\tif _, ok := newCases[id]; !ok {\n331|\t\t\tt.Fatalf(\"reviewed v0.7.0 acceptance case %q is absent\", id)\n332|\t\t}\n333|\t}\n334|\tfor id, want := range storyNewV070Cases {\n335|\t\tgot, ok := newCases[id]\n336|\t\tif !ok {\n337|\t\t\tt.Fatalf(\"story acceptance case %q is absent\", id)\n338|\t\t}\n339|\t\tif !reflect.DeepEqual(got, want) {\n340|\t\t\tt.Fatalf(\"story acceptance case %q differs from the reviewed upgrade: %+v\", id, got)\n341|\t\t}\n342|\t}\n343|\tfor id, old := range oldCases {\n344|\t\tnow := newCases[id]\n345|\t\tif reflect.DeepEqual(now, old) {\n346|\t\t\tcontinue\n347|\t\t}\n348|\t\tswitch id {\n349|\t\tcase \"catalog-v060-exact\":\n350|\t\t\t// The adopted catalog moved to v0.7.0, so the v0.6.0 exact case\n351|\t\t\t// is repointed at the historical projection pair it now proves.\n352|\t\t\twant := acceptanceCase{\n353|\t\t\t\tID:         id,\n354|\t\t\t\tProduction: codeReference{Path: \"internal/catalog/catalog.go\", Declaration: \"ForRelease\"},\n355|\t\t\t\tTests: []codeReference{\n356|\t\t\t\t\t{Path: \"internal/catalog/catalog_test.go\", Declaration: \"TestV060ProjectionMatchesHistoricalLock\"},\n357|\t\t\t\t},\n358|\t\t\t}\n359|\t\t\tif !reflect.DeepEqual(now, want) {\n360|\t\t\t\tt.Fatalf(\"catalog-v060-exact repoint = %+v, want %+v\", now, want)\n361|\t\t\t}\n362|\t\tcase \"assigned-section-binding\":\n363|\t\t\tassertAssignedSectionBindingRename(t, old, now)\n364|\t\tdefault:\n365|\t\t\tt.Fatalf(\"carried acceptance case %q changed without a reviewed repoint\", id)\n366|\t\t}\n367|\t}\n368|}\n369|\n370|// assertAssignedSectionBindingRename allows exactly one change to the carried\n371|// case: the V060 section-identifier test becomes its V070 successor. Any other\n372|// edit, addition, or removal fails.\n373|func assertAssignedSectionBindingRename(t *testing.T, old, now acceptanceCase) {\n374|\tt.Helper()\n375|\n376|\tif now.ID != old.ID || now.Production != old.Production {\n377|\t\tt.Fatalf(\"assigned-section-binding identity moved: %+v vs %+v\", now, old)\n378|\t}\n379|\tif len(now.Tests) != len(old.Tests) {\n380|\t\tt.Fatalf(\"assigned-section-binding test list length moved from %d to %d\", len(old.Tests), len(now.Tests))\n381|\t}\n382|\trenamed := 0\n383|\tfor index, oldRef := range old.Tests {\n384|\t\tnewRef := now.Tests[index]\n385|\t\tif newRef == oldRef {\n386|\t\t\tcontinue\n387|\t\t}\n388|\t\trenamed++\n389|\t\tif newRef.Path != oldRef.Path {\n390|\t\t\tt.Fatalf(\"assigned-section-binding test %d moved path %q to %q\", index, oldRef.Path, newRef.Path)\n391|\t\t}\n392|\t\tif oldRef.Declaration != \"TestMainRejectsSyntacticallyValidNonexistentV060Section\" ||\n393|\t\t\tnewRef.Declaration != \"TestMainRejectsSyntacticallyValidNonexistentV070Section\" {\n394|\t\t\tt.Fatalf(\"assigned-section-binding test %d renamed %q to %q, want the single V060 to V070 rename\",\n395|\t\t\t\tindex, oldRef.Declaration, newRef.Declaration)\n396|\t\t}\n397|\t}\n398|\tif renamed != 1 {\n399|\t\tt.Fatalf(\"assigned-section-binding carries %d test edits, want exactly the V060 to V070 rename\", renamed)\n400|\t}\n401|}\n402|\n403|func ownershipGroupByKindAndKeys(t *testing.T, registry ownershipRegistry, kind ownershipKind, firstKey string) ownershipGroup {\n404|\tt.Helper()\n405|\n406|\tfor _, group := range registry.Ownership {\n407|\t\tif group.Kind == kind && len(group.Keys) > 0 && group.Keys[0] == firstKey {\n408|\t\t\treturn group\n409|\t\t}\n410|\t}\n411|\tt.Fatalf(\"%s group starting with %q is absent\", kind, firstKey)\n412|\treturn ownershipGroup{}\n413|}\n414|\n415|func assertOwnershipGroupsRederive(t *testing.T, previous, current ownershipRegistry) {\n416|\tt.Helper()\n417|\n418|\tassertContractGroupRederives(t, previous, current)\n419|\tassertSourceGroupRederives(t, previous, current)\n420|\n421|\t// The catalog normative-section group and the catalog fixture group are\n422|\t// adoption-independent: identical keys, owners, and cases.\n423|\tfor _, probe := range []struct {\n424|\t\tkind     ownershipKind\n425|\t\tfirstKey string\n426|\t}{\n427|\t\t{ownershipNormativeSection, \"catalog:10.8.5\"},\n428|\t\t{ownershipFixture, \"catalog:Appendix D: Directory Node operation body\"},\n429|\t} {\n430|\t\told := ownershipGroupByKindAndKeys(t, previous, probe.kind, probe.firstKey)\n431|\t\tnow := ownershipGroupByKindAndKeys(t, current, probe.kind, probe.firstKey)\n432|\t\tif !reflect.DeepEqual(now, old) {\n433|\t\t\tt.Fatalf(\"%s group %q changed: %+v vs %+v\", probe.kind, probe.firstKey, now, old)\n434|\t\t}\n435|\t}\n436|\n437|\tassertPinFixtureGroupRederives(t, previous, current)\n438|}\n439|\n440|func assertContractGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n441|\tt.Helper()\n442|\n443|\told := ownershipGroupByKindAndKeys(t, previous, ownershipContract, \"Configuration [urn:ax:schema:config]\")\n444|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipContract, \"Configuration [urn:ax:schema:config]\")\n445|\tif now.Production != old.Production {\n446|\t\tt.Fatalf(\"contract group production moved from %+v to %+v\", old.Production, now.Production)\n447|\t}\n448|\twantCases := []string{\"catalog-v070-exact\", \"catalog-v060-exact\", \"catalog-v050-exact\", \"catalog-v043-compatibility\"}\n449|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n450|\t\tt.Fatalf(\"contract group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n451|\t}\n452|\toldKeys := oldKeySet(old.Keys)\n453|\tfor _, key := range now.Keys {\n454|\t\tif _, carried := oldKeys[key]; !carried && key != launchPlanContractKey {\n455|\t\t\tt.Fatalf(\"contract group key %q is not carried and not the Launch Plan request row\", key)\n456|\t\t}\n457|\t\tdelete(oldKeys, key)\n458|\t}\n459|\tif len(oldKeys) != 0 {\n460|\t\tt.Fatalf(\"contract group drops %d carried keys\", len(oldKeys))\n461|\t}\n462|\tfound := false\n463|\tfor _, key := range now.Keys {\n464|\t\tif key == launchPlanContractKey {\n465|\t\t\tfound = true\n466|\t\t}\n467|\t}\n468|\tif !found {\n469|\t\tt.Fatalf(\"contract group lacks the Launch Plan request row %q\", launchPlanContractKey)\n470|\t}\n471|}\n472|\n473|func oldKeySet(keys []string) map[string]struct{} {\n474|\tresult := make(map[string]struct{}, len(keys))\n475|\tfor _, key := range keys {\n476|\t\tresult[key] = struct{}{}\n477|\t}\n478|\treturn result\n479|}\n480|\n481|func assertSourceGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n482|\tt.Helper()\n483|\n484|\told := ownershipGroupByKindAndKeys(t, previous, ownershipNormativeSection, \"source:1\")\n485|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipNormativeSection, \"source:1\")\n486|\tif !reflect.DeepEqual(now.Keys, old.Keys) {\n487|\t\tt.Fatalf(\"source normative-section keys moved\")\n488|\t}\n489|\twantCases := []string{\"source-pin-v070-exact\", \"source-pin-v070-refusal\"}\n490|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n491|\t\tt.Fatalf(\"source group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n492|\t}\n493|\t// FINDING F1 (TASK-260917-10k118): the reviewed v0.7.0 bytes keep the\n494|\t// source group's production owner at VerifyV060 while its cases moved to\n495|\t// the v0.7.0 pair. The v0.5.0→v0.6.0 precedent moved Verify to VerifyV060,\n496|\t// so the adoption pattern says VerifyV070; the gate only checks that the\n497|\t// named declaration exists, which is why the bytes are green. The\n498|\t// reconstruction must not rewrite reviewed bytes, so this test pins the\n499|\t// carried reference literally: a future fix to VerifyV070 must update\n500|\t// this pin deliberately, and any other drift fails here.\n(more lines below)","final_result":true}}}
