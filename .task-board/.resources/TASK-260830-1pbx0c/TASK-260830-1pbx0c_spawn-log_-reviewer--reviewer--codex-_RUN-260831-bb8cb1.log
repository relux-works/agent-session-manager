   122			}
   123			if _, duplicate := seen[candidate]; duplicate {
   124				return ClosedEnum{}, invalid("closed-enum vocabulary", "must not contain duplicate members")
   125			}
   126			seen[candidate] = struct{}{}
   127		}
   128		if len(seen) == 0 {
   129			return ClosedEnum{}, invalid("closed-enum vocabulary", "must contain at least one member")
   130		}
   131		if _, ok := seen[value]; !ok {
   132			return ClosedEnum{}, invalid("closed-enum", "is not a member of the negotiated vocabulary")
   133		}
   134		return ClosedEnum{value: value}, nil
   135	}
