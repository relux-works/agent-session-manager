   116	func validatePOSIXAbsolutePath(value string) error {
   117		if !strings.HasPrefix(value, "/") || path.Clean(value) != value {
   118			return invalid("absolute-path", "must be a lexically normalized POSIX absolute path")
   119		}
   120		return nil
   121	}
   122	
   123	func validateWindowsAbsolutePath(value string) error {
   124		if strings.Contains(value, "/") {
   125			return invalid("absolute-path", "must use native Windows separators")
   126		}
   127		if hasDrivePrefix(value) {
   128			if len(value) < 3 || value[2] != '\\' {
   129				return invalid("absolute-path", "must be drive-qualified or UNC")
   130			}
   131			return validateWindowsSegments(value[3:], true)
   132		}
   133		if !strings.HasPrefix(value, `\\`) {
   134			return invalid("absolute-path", "must be drive-qualified or UNC")
   135		}
   136		parts := strings.Split(value[2:], `\`)
   137		if len(parts) < 2 || parts[0] == "" || parts[1] == "" {
   138			return invalid("absolute-path", "UNC paths require server and share names")
   139		}
   140		for _, segment := range parts {
   141			if invalidWindowsSegment(segment) {
   142				return invalid("absolute-path", "must be lexically normalized without device or alternate-stream syntax")
   143			}
   144		}
   145		return nil
   146	}
   147	
   148	func validateWindowsSegments(value string, allowEmptyRoot bool) error {
   149		if value == "" && allowEmptyRoot {
   150			return nil
   151		}
   152		for _, segment := range strings.Split(value, `\`) {
   153			if invalidWindowsSegment(segment) {
   154				return invalid("absolute-path", "must be lexically normalized without device or alternate-stream syntax")
   155			}
   156		}
   157		return nil
   158	}
   159	
