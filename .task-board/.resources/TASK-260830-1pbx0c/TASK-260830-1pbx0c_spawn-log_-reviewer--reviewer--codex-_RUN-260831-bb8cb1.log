   100			return AbsolutePath{}, invalid("absolute-path", "must be 1 to 32767 valid UTF-8 characters with no NUL")
   101		}
   102	
   103		var err error
   104		switch platform {
   105		case PlatformMacOS, PlatformLinux, PlatformWSL2:
   106			err = validatePOSIXAbsolutePath(value)
   107		case PlatformWindows:
   108			err = validateWindowsAbsolutePath(value)
   109		}
