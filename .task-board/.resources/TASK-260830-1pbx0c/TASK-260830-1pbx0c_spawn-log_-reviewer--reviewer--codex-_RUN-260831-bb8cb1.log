+package main
+
+import (
+	"fmt"
+
+	"github.com/relux-works/agent-session-manager/internal/scalar"
+)
+
+func main() {
+	for _, value := range []string{
+		`C:\safe\file.txt`,
+		`C:\unsafe\*.json`,
+		`C:\unsafe\CON`,
+		`C:\unsafe\NUL.txt`,
+		`\\server\share\COM1`,
+	} {
+		_, err := scalar.ParseAbsolutePath(scalar.PlatformWindows, value)
+		fmt.Printf("windows absolute-path %q accepted=%t error=%v\n", value, err == nil, err)
+	}
+}

