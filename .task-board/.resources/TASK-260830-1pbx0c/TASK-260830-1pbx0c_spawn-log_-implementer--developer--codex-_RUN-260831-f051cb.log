+		t.Fatalf("DecodeClosedEnumJSON(null) error = %v, want ErrInvalidScalar", err)
+	}
+	encoded, err := json.Marshal(decoded)
+	if err != nil || string(encoded) != `"task_board"` {
+		t.Fatalf("Marshal(ClosedEnum) = %s, %v", encoded, err)
