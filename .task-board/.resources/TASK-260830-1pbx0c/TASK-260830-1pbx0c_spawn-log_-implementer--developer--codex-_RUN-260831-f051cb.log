+	if err != nil {
+		t.Fatalf("Marshal(AbsolutePath) error = %v", err)
+	}
+	decoded, err := DecodeAbsolutePathJSON(PlatformWindows, encoded)
+	if err != nil || decoded.String() != absolute.String() {
