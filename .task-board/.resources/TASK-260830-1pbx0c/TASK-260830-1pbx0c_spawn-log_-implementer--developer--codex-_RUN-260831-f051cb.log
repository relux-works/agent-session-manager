+	digest := SHA256Digest(nil)
+	if digest.String() != want || digest.Hex() != strings.TrimPrefix(want, "sha256:") {
+		t.Fatalf("SHA256Digest(nil) = %q (%q), want %q", digest, digest.Hex(), want)
+	}
