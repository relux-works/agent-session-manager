+		"a/", `a\b`, "a%2fb", "a%2Fb", "a%5cb", "a%5Cb", "a%252fb", "a\x00b", string([]byte{0xff}),
+	}
+	for _, value := range invalid {
+		if _, err := ParseRelativePath(value); !errors.Is(err, ErrInvalidScalar) {
