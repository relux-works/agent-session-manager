+			encoded, err := json.Marshal(test.value)
+			if err != nil {
+				t.Fatalf("json.Marshal() error = %v", err)
+			}
+			if err := json.Unmarshal(encoded, test.target); err != nil {
+				t.Fatalf("json.Unmarshal(%s) error = %v", encoded, err)
