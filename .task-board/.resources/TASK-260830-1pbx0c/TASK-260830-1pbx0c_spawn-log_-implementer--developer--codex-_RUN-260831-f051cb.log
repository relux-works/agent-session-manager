+	}
+	for _, input := range []string{"Provider", "unknown", ""} {
+		if _, err := ParseClosedEnum(input, allowed...); !errors.Is(err, ErrInvalidScalar) {
+			t.Errorf("ParseClosedEnum(%q) error = %v, want ErrInvalidScalar", input, err)
+		}
