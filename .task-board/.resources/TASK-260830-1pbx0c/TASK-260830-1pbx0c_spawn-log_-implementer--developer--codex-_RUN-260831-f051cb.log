+		{"digest", SHA256Digest([]byte("ax")), &Digest{}},
+		{"platform", PlatformLinux, new(Platform)},
+		{"provider", mustProviderID(t, "codex"), &ProviderID{}},
+		{"relative path", mustRelativePath(t, "dir/file"), &RelativePath{}},
