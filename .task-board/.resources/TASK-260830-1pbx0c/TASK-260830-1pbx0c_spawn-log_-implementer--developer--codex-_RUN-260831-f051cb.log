+		"sha256:" + strings.ToUpper(strings.TrimPrefix(want, "sha256:")),
+		want[:len(want)-1],
+		want + "0",
+	} {
+		if _, err := ParseDigest(value); !errors.Is(err, ErrInvalidScalar) {
+			t.Errorf("ParseDigest(%q) error = %v, want ErrInvalidScalar", value, err)
