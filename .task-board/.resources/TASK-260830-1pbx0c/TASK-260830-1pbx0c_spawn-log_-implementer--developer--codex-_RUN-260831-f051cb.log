+func TestValidatedStringTypesSupportTextBoundaries(t *testing.T) {
+	t.Parallel()
+
+	uuid7, err := ParseUUIDv7("0198f4c8-8e50-7f66-8f70-1234567890ab")
+	if err != nil {
+		t.Fatal(err)
