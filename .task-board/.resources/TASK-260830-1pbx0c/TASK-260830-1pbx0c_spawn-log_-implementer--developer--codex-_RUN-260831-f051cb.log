+func TestRelativePathRefusesTraversalAndEncodedSeparators(t *testing.T) {
+	t.Parallel()
+
+	for _, value := range []string{"AGENTS.md", "a/b/c", "данные/файл.txt", "percent%20name"} {
+		path, err := ParseRelativePath(value)
