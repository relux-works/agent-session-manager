   218	func TestSafeAndBoundedIntegersRefuseNarrowedAndUnsafeValues(t *testing.T) {
   219		t.Parallel()
   220	
   221		for _, value := range []int64{-MaxSafeInteger, 0, MaxSafeInteger} {
   222			got, err := NewSafeInteger(value)
   223			if err != nil || got.Int64() != value {
   224				t.Errorf("NewSafeInteger(%d) = %d, %v", value, got.Int64(), err)
   225			}
   226		}
   227		for _, value := range []int64{-MaxSafeInteger - 1, MaxSafeInteger + 1} {
   228			if _, err := NewSafeInteger(value); !errors.Is(err, ErrInvalidScalar) {
   229				t.Errorf("NewSafeInteger(%d) error = %v, want ErrInvalidScalar", value, err)
   230			}
   231		}
   232	
   233		for _, data := range []string{"9007199254740992", "9007199254740993", "1.0", "1e0", `"1"`, "null"} {
   234			var value SafeInteger
   235			if err := json.Unmarshal([]byte(data), &value); !errors.Is(err, ErrInvalidScalar) {
   236				t.Errorf("Unmarshal SafeInteger %s error = %v, want ErrInvalidScalar", data, err)
   237			}
   238		}
   239	
   240		bounded, err := NewBoundedInteger(4_194_304, 1, 4_194_304)
   241		if err != nil || bounded.Int64() != 4_194_304 {
   242			t.Fatalf("NewBoundedInteger(max) = %d, %v", bounded.Int64(), err)
   243		}
   244		for _, value := range []int64{0, 4_194_305} {
   245			if _, err := NewBoundedInteger(value, 1, 4_194_304); !errors.Is(err, ErrInvalidScalar) {
   246				t.Errorf("NewBoundedInteger(%d, narrowed bound) error = %v, want ErrInvalidScalar", value, err)
   247			}
   248		}
   249		if _, err := NewBoundedInteger(1, 2, 1); !errors.Is(err, ErrInvalidScalar) {
   250			t.Fatalf("invalid bounds error = %v, want ErrInvalidScalar", err)
   251		}
   252		explicitZero, err := NewBoundedInteger(0, 0, 0)
   253		if err != nil {
   254			t.Fatalf("NewBoundedInteger(0, 0, 0) error = %v", err)
   255		}
   256		if encoded, err := json.Marshal(explicitZero); err != nil || string(encoded) != "0" {
   257			t.Fatalf("Marshal(explicit [0,0] bounded integer) = %s, %v", encoded, err)
   258		}
   259	
   260		var uint53 Uint53
   261		if err := json.Unmarshal([]byte("9007199254740991"), &uint53); err != nil || uint53.Uint64() != MaxUint53 {
   262			t.Fatalf("Unmarshal Uint53(max) = %d, %v", uint53.Uint64(), err)
   263		}
   264		for _, data := range []string{"-1", "9007199254740992", "1.0"} {
   265			if err := json.Unmarshal([]byte(data), &uint53); !errors.Is(err, ErrInvalidScalar) {
   266				t.Errorf("Unmarshal Uint53 %s error = %v, want ErrInvalidScalar", data, err)
   267			}
   268		}
   269	
   270		for name, value := range map[string]any{
   271			"safe":    mustSafeInteger(t, -42),
   272			"uint53":  uint53,
   273			"bounded": bounded,
   274		} {
   275			encoded, err := json.Marshal(value)
   276			if err != nil {
   277				t.Errorf("Marshal(%s) error = %v", name, err)
   278			}
   279			if len(encoded) == 0 || encoded[0] == '"' {
   280				t.Errorf("Marshal(%s) = %s, want JSON number", name, encoded)
   281			}
   282		}
   283		decoded, err := DecodeBoundedIntegerJSON([]byte("1"), 1, 4_194_304)
   284		if err != nil || decoded.Int64() != 1 || decoded.Min() != 1 || decoded.Max() != 4_194_304 {
   285			t.Fatalf("DecodeBoundedIntegerJSON() = %#v, %v", decoded, err)
   286		}
   287		if _, err := DecodeBoundedIntegerJSON([]byte("0"), 1, 4_194_304); !errors.Is(err, ErrInvalidScalar) {
   288			t.Fatalf("DecodeBoundedIntegerJSON(underflow) error = %v, want ErrInvalidScalar", err)
   289		}
   290	}
