    59	func TestTimestampAcceptsRealUTCRFC3339WithMillisecondPrecision(t *testing.T) {
    60		t.Parallel()
    61	
    62		for _, value := range []string{
    63			"2024-02-29T23:59:59.000Z",
    64			"2026-08-31T14:05:06.123456789Z",
    65			"2026-08-31T14:05:06.1234567890Z",
    66			"2026-08-31T14:05:06." + strings.Repeat("1234567890", 10) + "Z",
    67			"2026-08-31t14:05:06.123z",
    68			"2026-08-31T14:05:06.123+00:00",
    69		} {
    70			got, err := ParseTimestamp(value)
    71			if err != nil || got.String() != value {
    72				t.Errorf("ParseTimestamp(%q) = %q, %v", value, got, err)
    73				continue
    74			}
    75			instant, err := got.Time()
    76			if err != nil || instant.Location() != time.UTC {
    77				t.Errorf("Timestamp(%q).Time() = %v, %v", value, instant, err)
    78			}
    79			var jsonDecoded Timestamp
    80			if err := json.Unmarshal([]byte(`"`+value+`"`), &jsonDecoded); err != nil || jsonDecoded.String() != value {
    81				t.Errorf("Unmarshal Timestamp(%q) = %q, %v", value, jsonDecoded, err)
    82			}
    83			var textDecoded Timestamp
    84			if err := textDecoded.UnmarshalText([]byte(value)); err != nil || textDecoded.String() != value {
    85				t.Errorf("UnmarshalText Timestamp(%q) = %q, %v", value, textDecoded, err)
    86			}
    87		}
    88	
    89		for _, value := range []string{
    90			"2023-02-29T12:00:00.000Z",
    91			"2026-08-31T14:05:06Z",
    92			"2026-08-31T14:05:06.12Z",
    93			"2026-08-31T14:05:06.123+03:00",
    94			"2026-08-31T14:05:06.123-00:00",
    95			"2026-08-31T24:00:00.000Z",
    96		} {
    97			if _, err := ParseTimestamp(value); !errors.Is(err, ErrInvalidScalar) {
    98				t.Errorf("ParseTimestamp(%q) error = %v, want ErrInvalidScalar", value, err)
    99			}
