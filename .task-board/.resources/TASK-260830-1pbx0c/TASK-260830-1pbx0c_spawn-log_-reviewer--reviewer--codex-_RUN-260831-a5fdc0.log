package main

import (
	"encoding/json"
	"fmt"
	"time"

	"github.com/relux-works/agent-session-manager/internal/scalar"
)

func main() {
	for _, candidate := range []string{
		"2026-08-31T14:05:06.1234567890Z",
		"2026-08-31t14:05:06.123z",
	} {
		_, err := scalar.ParseTimestamp(candidate)
		fmt.Printf("timestamp %q accepted=%t err=%v\n", candidate, err == nil, err)
		_, stdlibErr := time.Parse(time.RFC3339Nano, candidate)
		fmt.Printf("stdlib RFC3339Nano %q accepted=%t err=%v\n", candidate, stdlibErr == nil, stdlibErr)
	}

	encoded, err := json.Marshal(scalar.BoundedInteger{})
	fmt.Printf("zero bounded integer json=%s accepted=%t err=%v\n", encoded, err == nil, err)
}

