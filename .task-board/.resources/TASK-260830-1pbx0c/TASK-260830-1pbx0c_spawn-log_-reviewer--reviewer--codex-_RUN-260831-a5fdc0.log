+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+
+	"github.com/relux-works/agent-session-manager/internal/scalar"
+)
+
+func TestRevisionTwoProductionBoundaries(t *testing.T) {
+	t.Run("unbounded lowercase timestamp remains valid", func(t *testing.T) {
+		input := "2026-08-31t14:05:06." + strings.Repeat("1234567890", 10) + "z"
+		got, err := scalar.ParseTimestamp(input)
+		if err != nil || got.String() != input {
+			t.Fatalf("ParseTimestamp(%q) = %q, %v", input, got, err)
+		}
+	})
+
+	t.Run("uninitialized bounded integer is refused", func(t *testing.T) {
+		if _, err := json.Marshal(scalar.BoundedInteger{}); !errors.Is(err, scalar.ErrInvalidScalar) {
+			t.Fatalf("Marshal(BoundedInteger{}) error = %v, want ErrInvalidScalar", err)
+		}
+	})
+
+	t.Run("explicit zero interval remains valid", func(t *testing.T) {
+		value, err := scalar.NewBoundedInteger(0, 0, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := json.Marshal(value)
+		if err != nil || string(got) != "0" {
+			t.Fatalf("Marshal(explicit zero interval) = %s, %v", got, err)
+		}
+	})
+}
+
+func TestRFC3339LeapSecondBoundary(t *testing.T) {
+	t.Run("published RFC example is a real UTC instant", func(t *testing.T) {
+		const input = "1990-12-31T23:59:60.000Z"
+		if _, err := scalar.ParseTimestamp(input); err != nil {
+			t.Fatalf("ParseTimestamp(%q) error = %v, want acceptance", input, err)
+		}
+	})
+
+	t.Run("ordinary minute cannot mint a leap second", func(t *testing.T) {
+		const input = "2026-08-31T14:05:60.000Z"
+		if _, err := scalar.ParseTimestamp(input); !errors.Is(err, scalar.ErrInvalidScalar) {
+			t.Fatalf("ParseTimestamp(%q) error = %v, want ErrInvalidScalar", input, err)
+		}
+	})
+}

