   539		}
   540		if _, err := DecodeClosedEnumJSON([]byte(`"\ud800"`), "known"); !errors.Is(err, ErrInvalidScalar) {
   541			t.Fatalf("DecodeClosedEnumJSON(lone surrogate) error = %v, want ErrInvalidScalar", err)
   542		}
   543		if _, err := DecodeClosedEnumJSON([]byte{'"', 0xff, '"'}, "known"); !errors.Is(err, ErrInvalidScalar) {
