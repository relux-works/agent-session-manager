    12	func ParseRelativePath(value string) (RelativePath, error) {
    13		if value == "" || !utf8.ValidString(value) {
    14			return RelativePath{}, invalid("path", "must be non-empty valid UTF-8")
    15		}
    16		if strings.HasPrefix(value, "/") || hasDrivePrefix(value) {
    17			return RelativePath{}, invalid("path", "must be platform-neutral and relative")
    18		}
    19		if strings.ContainsRune(value, 0) || strings.Contains(value, `\`) {
    20			return RelativePath{}, invalid("path", "must use forward slashes and contain no NUL")
    21		}
    22		if containsEncodedSeparator(value) {
    23			return RelativePath{}, invalid("path", "must not contain an encoded separator")
    24		}
    25		segments := strings.Split(value, "/")
    26		for _, segment := range segments {
    27			if segment == "" || segment == "." || segment == ".." {
    28				return RelativePath{}, invalid("path", "must not contain empty, dot, or parent segments")
    29			}
    30		}
    31		return RelativePath{value: value}, nil
    32	}
    33	
    34	func containsEncodedSeparator(value string) bool {
    35		candidate := strings.ToLower(value)
    36		for {
    37			if strings.Contains(candidate, "%2f") || strings.Contains(candidate, "%5c") {
    38				return true
    39			}
    40			next := strings.ReplaceAll(candidate, "%25", "%")
    41			if next == candidate {
    42				return false
    43			}
    44			candidate = next
    45		}
    46	}
