+	if count := bytes.Count(value, []byte(from)); count != 1 {
+		t.Fatalf("%q contains declaration marker %q %d times, want exactly once", filename, from, count)
+	}
+	value = bytes.Replace(value, []byte(from), []byte(to), 1)
