+	if got, err := scalar.ParseAbsolutePath(scalar.PlatformLinux, posix); err != nil || got.String() != posix {
+		fail("POSIX compatibility = %q, %v", got.String(), err)
+	}
+
+	for _, value := range []string{
+		"1990-12-31T23:59:60.000Z",
