// Package specpin exposes the immutable upstream specification identity that
// this implementation consumes. It does not advertise product capabilities.
package specpin

import (
	"bytes"
	"crypto/sha256"
	_ "embed"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
