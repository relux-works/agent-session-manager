		"relative path":   RelativePath{},
		"bounded integer": BoundedInteger{},
	} {
		if _, err := json.Marshal(value); !errors.Is(err, ErrInvalidScalar) {
			t.Errorf("Marshal(%s zero) error = %v, want ErrInvalidScalar", name, err)
		}
	}
}

