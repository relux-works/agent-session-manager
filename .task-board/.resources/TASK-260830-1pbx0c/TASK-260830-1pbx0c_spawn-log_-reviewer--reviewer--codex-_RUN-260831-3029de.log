	jsonIntegerPattern   = regexp.MustCompile(`^-?(0|[1-9][0-9]*)$`)
	jsonUnsignedPattern  = regexp.MustCompile(`^(0|[1-9][0-9]*)$`)
	decimalUint64Pattern = regexp.MustCompile(`^(0|[1-9][0-9]{0,19})$`)
