+		"1992-06-30", "1993-06-30", "1994-06-30", "1995-12-31",
+		"1997-06-30", "1998-12-31", "2005-12-31", "2008-12-31",
+		"2012-06-30", "2015-06-30", "2016-12-31":
+		return true
+	default:
+		return false
+	}
 }
 
