+	}
+
+	output.Reset()
+	err := run([]string{"-root", repositoryRoot, "-section", "10.1"}, &output)
+	if err == nil || !strings.Contains(err.Error(), `assigned section "10.1" binding "section:10.1" has no scoped implementation owner`) {
