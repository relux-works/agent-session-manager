+func TestMainRejectsDetachedScopeSpecificAcceptanceCase(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds an isolated tracecheck binary")
+	}
+
+	fixtureRoot := isolatedTracecheckFixture(t)
