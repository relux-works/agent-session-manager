+
+type sectionFlags []string
+
+func (sections *sectionFlags) String() string {
+	return strings.Join(*sections, ",")
+}
+
+func (sections *sectionFlags) Set(value string) error {
+	*sections = append(*sections, value)
+	return nil
+}
