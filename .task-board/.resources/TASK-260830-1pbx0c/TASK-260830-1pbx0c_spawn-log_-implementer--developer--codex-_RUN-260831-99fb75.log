+	}
+
+	output, err = runTracecheck(t, fixtureRoot, "-section", "7.9")
+	if err != nil || !strings.Contains(output, "assigned_scopes=1") {
+		t.Fatalf("unrelated assigned tracecheck error = %v output = %q, want green section:7.9 binding", err, output)
+	}
+}
