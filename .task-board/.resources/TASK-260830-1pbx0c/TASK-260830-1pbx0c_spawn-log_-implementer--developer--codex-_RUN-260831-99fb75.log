+		for _, candidate := range group.Keys {
+			if candidate == key {
+				registry.Ownership = append(registry.Ownership[:index], registry.Ownership[index+1:]...)
+				return
+			}
+		}
+	}
+	t.Fatalf("ownership key %q not found", key)
+}
