+func resolveAssignedSections(pinned []string, assigned []string) ([]assignedSectionBinding, error) {
+	if assigned == nil {
+		return nil, nil
+	}
+	pinnedSet := make(map[string]struct{}, len(pinned))
+	for _, section := range pinned {
+		pinnedSet[section] = struct{}{}
+	}
