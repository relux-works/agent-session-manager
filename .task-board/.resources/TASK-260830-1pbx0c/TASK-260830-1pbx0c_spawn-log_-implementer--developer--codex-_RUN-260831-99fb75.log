+		{"10.1", "internal/scalar/time_digest.go", "Timestamp", "type Timestamp struct", "type RenamedTimestamp struct"},
+		{"10.2", "internal/scalar/time_digest.go", "Digest", "type Digest struct", "type RenamedDigest struct"},
+		{"10.3", "internal/scalar/integer.go", "BoundedInteger", "type BoundedInteger struct", "type RenamedBoundedInteger struct"},
+		{"10.4", "internal/scalar/names.go", "ClosedEnum", "type ClosedEnum struct", "type RenamedClosedEnum struct"},
+	}
