+func copyFile(t *testing.T, source, destination string) {
+	t.Helper()
+	value, err := os.ReadFile(source)
+	if err != nil {
+		t.Fatalf("read %q: %v", source, err)
+	}
+	if err := os.WriteFile(destination, value, 0o644); err != nil {
+		t.Fatalf("write %q: %v", destination, err)
+	}
