+	for _, scope := range []string{"11.2-11.3", "§4.B-4.C", "Appendix D"} {
+		report, err := VerifyAssignedSections(repositorySnapshot(t), []string{scope})
+		if err != nil {
+			t.Errorf("VerifyAssignedSections(%q) error = %v", scope, err)
