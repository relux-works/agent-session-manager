+// renames the real Go declaration while leaving the reviewed registry intact.
+func TestMainRejectsRenamedScalarSectionOwnerDeclarations(t *testing.T) {
+	if testing.Short() {
+		t.Skip("builds isolated tracecheck binaries")
+	}
+
+	tests := []struct {
+		section     string
+		path        string
+		declaration string
