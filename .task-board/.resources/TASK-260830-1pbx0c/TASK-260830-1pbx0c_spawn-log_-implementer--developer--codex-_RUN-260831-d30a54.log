/bin/zsh -lc 'cat /Users/iv/.claude/skills/project-management/references/statuses.md && cat /Users/iv/.claude/skills/project-management/references/resources-and-bugs.md && cat /Users/iv/.claude/skills/project-management/references/negative-evidence.md && task-board --help && git status --short && git branch --show-current && git log -5 --oneline --decorate' in /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2wdm5e/worktree
