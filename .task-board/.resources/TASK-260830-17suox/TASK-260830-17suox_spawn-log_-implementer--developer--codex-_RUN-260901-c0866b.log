+}
+
+func TestPreviouslyUnpinnedConfigurationBoundsAtProductionEntry(t *testing.T) {
+	t.Parallel()
+
+	t.Run("scan authority minimum", func(t *testing.T) {
+		configuration := validCurrentConfiguration()
