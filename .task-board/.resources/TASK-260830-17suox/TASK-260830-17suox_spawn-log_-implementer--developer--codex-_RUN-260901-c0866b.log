+		past := validCurrentConfiguration()
+		past.DirectoryInstallations[0].Extensions = map[string]any{"works.relux.number": int64(scalar.MaxSafeInteger + 1)}
+		_, err := EncodeCurrent(past, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})
+		requireConfigClause(t, err, "directory_installations[0].extensions")
+	})
+}
+
+func closedMapMemberPaths(root reflect.Type) []string {
+	closedMap := reflect.TypeFor[map[string]any]()
+	var paths []string
+	var visit func(reflect.Type, string)
+	visit = func(value reflect.Type, prefix string) {
+		if value.Kind() == reflect.Pointer {
+			value = value.Elem()
+		}
+		if value.Kind() != reflect.Struct {
+			return
+		}
+		for index := 0; index < value.NumField(); index++ {
+			field := value.Field(index)
+			name := strings.Split(field.Tag.Get("toml"), ",")[0]
+			if name == "" || name == "-" {
+				continue
+			}
+			path := name
+			if prefix != "" {
+				path = prefix + "." + name
+			}
+			fieldType := field.Type
+			if fieldType == closedMap {
+				paths = append(paths, path)
+				continue
+			}
+			if fieldType.Kind() == reflect.Slice && fieldType.Elem().Kind() == reflect.Struct {
+				visit(fieldType.Elem(), path+"[]")
+				continue
+			}
+			visit(fieldType, path)
+		}
+	}
+	visit(root, "")
+	sort.Strings(paths)
+	return paths
+}
+
+func pinnedConfigurationVersions(t *testing.T) []string {
+	t.Helper()
+	for _, contract := range catalog.Current().Contracts {
+		if contract.ID == catalog.ContractID(SchemaID) {
+			return append([]string(nil), contract.Versions...)
+		}
+	}
+	t.Fatal("pinned catalog has no Configuration contract")
+	return nil
+}
diff --git a/internal/config/refusal_inventory_test.go b/internal/config/refusal_inventory_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..01f2f7760d8626911b540b55b98f1ef9061dd8c9
--- /dev/null
+++ b/internal/config/refusal_inventory_test.go
@@ -0,0 +1,99 @@
+package config
+
+import (
+	"flag"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+)
+
+var exercisedConfigErrorSites sync.Map
+
+func TestMain(main *testing.M) {
+	configError = func(field string, err error) error {
+		_, file, line, ok := runtime.Caller(1)
+		if ok {
+			exercisedConfigErrorSites.Store(fmt.Sprintf("%s:%d", filepath.Base(file), line), struct{}{})
+		}
+		return &DocumentError{Clause: field, Err: err}
+	}
+	code := main.Run()
+	if code == 0 && fullPackageTestRun() {
+		missing, err := missingConfigErrorSites()
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "derive configuration refusal inventory: %v\n", err)
+			code = 1
+		} else if len(missing) != 0 {
+			fmt.Fprintf(os.Stderr, "configuration refusal call sites without an exercised negative path: %s\n", strings.Join(missing, ", "))
+			code = 1
+		}
+	}
+	os.Exit(code)
+}
+
+func fullPackageTestRun() bool {
+	selected := flag.Lookup("test.run")
+	return selected == nil || selected.Value.String() == ""
+}
+
+func missingConfigErrorSites() ([]string, error) {
+	directory, err := os.Getwd()
+	if err != nil {
+		return nil, err
+	}
+	entries, err := os.ReadDir(directory)
+	if err != nil {
+		return nil, err
+	}
+	fileSet := token.NewFileSet()
+	var expected []string
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
+			continue
+		}
+		path := filepath.Join(directory, entry.Name())
+		source, err := os.ReadFile(path)
+		if err != nil {
+			return nil, err
+		}
+		lines := strings.Split(string(source), "\n")
+		parsed, err := parser.ParseFile(fileSet, path, source, 0)
+		if err != nil {
+			return nil, err
+		}
+		ast.Inspect(parsed, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			identifier, ok := call.Fun.(*ast.Ident)
+			if !ok || identifier.Name != "configError" {
+				return true
+			}
+			position := fileSet.Position(call.Pos())
+			line := lines[position.Line-1]
+			if strings.Contains(line, "config-refusal-subsumed:") {
+				return true
+			}
+			expected = append(expected, fmt.Sprintf("%s:%d", entry.Name(), position.Line))
+			return true
+		})
+	}
+
+	var missing []string
+	for _, site := range expected {
+		if _, ok := exercisedConfigErrorSites.Load(site); !ok {
+			missing = append(missing, site)
+		}
+	}
+	sort.Strings(missing)
+	return missing, nil
+}
