+package main
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+type mutation struct {
+	name        string
+	file        string
+	old         string
+	replacement string
+	start, end  int
+}
+
+type callSite struct {
+	name       string
+	file       string
+	start, end int
+}
+
+func main() {
+	if len(os.Args) != 3 {
+		fmt.Fprintln(os.Stderr, "usage: config-refusal-mutator MUTANT_COPY LOG_PATH")
+		os.Exit(2)
+	}
+	root, logPath := os.Args[1], os.Args[2]
+	var log bytes.Buffer
+	callSites, err := configErrorCallSites(root)
+	if err != nil {
+		fatal(err)
+	}
+	mutations := make([]mutation, 0, len(callSites)+10)
+	for _, site := range callSites {
+		data, err := os.ReadFile(filepath.Join(root, site.file))
+		if err != nil {
+			fatal(err)
+		}
+		mutations = append(mutations, mutation{
+			name: site.name, file: site.file,
+			old:         string(data[site.start:site.end]),
+			replacement: disabledConfigErrorExpression(string(data[site.start:site.end])),
+			start:       site.start, end: site.end,
+		})
+	}
+	mutations = append(mutations, narrowingMutations()...)
+
+	killed, survived, invalid := 0, 0, 0
+	for index, mutant := range mutations {
+		path := filepath.Join(root, mutant.file)
+		original, err := os.ReadFile(path)
+		if err != nil {
+			fatal(err)
+		}
+		var changed []byte
+		if mutant.end > mutant.start {
+			if mutant.end > len(original) || string(original[mutant.start:mutant.end]) != mutant.old {
+				fmt.Fprintf(&log, "%03d INVALID %s: positioned source no longer matches\n", index+1, mutant.name)
+				invalid++
+				continue
+			}
+			changed = append(append(append([]byte(nil), original[:mutant.start]...), []byte(mutant.replacement)...), original[mutant.end:]...)
+		} else if bytes.Count(original, []byte(mutant.old)) != 1 {
+			fmt.Fprintf(&log, "%03d INVALID %s: source match count=%d\n", index+1, mutant.name, bytes.Count(original, []byte(mutant.old)))
+			invalid++
+			continue
+		} else {
+			changed = bytes.Replace(original, []byte(mutant.old), []byte(mutant.replacement), 1)
+		}
+		if err := os.WriteFile(path, changed, 0o644); err != nil {
+			fatal(err)
+		}
+		command := exec.Command("go", "test", "./internal/config", "-count=1")
+		command.Dir = root
+		command.Env = append(os.Environ(), "GOCACHE="+filepath.Join(root, ".gocache"))
+		output, runErr := command.CombinedOutput()
+		if restoreErr := os.WriteFile(path, original, 0o644); restoreErr != nil {
+			fatal(restoreErr)
+		}
+		exitCode := 0
+		if runErr != nil {
+			var exitError *exec.ExitError
+			if errors.As(runErr, &exitError) {
+				exitCode = exitError.ExitCode()
+			} else {
+				fatal(runErr)
+			}
+		}
+		if exitCode == 0 {
+			fmt.Fprintf(&log, "%03d SURVIVED exit=0 %s\n", index+1, mutant.name)
+			survived++
+			continue
+		}
+		if bytes.Contains(output, []byte("[build failed]")) || bytes.Contains(output, []byte("build constraints exclude all Go files")) {
+			fmt.Fprintf(&log, "%03d INVALID exit=%d %s\n%s\n", index+1, exitCode, mutant.name, output)
+			invalid++
+			continue
+		}
+		fmt.Fprintf(&log, "%03d KILLED exit=%d %s\n", index+1, exitCode, mutant.name)
+		killed++
+	}
+	fmt.Fprintf(&log, "SUMMARY total=%d killed=%d survived=%d invalid=%d\n", len(mutations), killed, survived, invalid)
+	if err := os.WriteFile(logPath, log.Bytes(), 0o600); err != nil {
+		fatal(err)
+	}
+	fmt.Printf("mutation sweep: total=%d killed=%d survived=%d invalid=%d log=%s\n", len(mutations), killed, survived, invalid, logPath)
+	if survived != 0 || invalid != 0 {
+		os.Exit(1)
+	}
+}
+
+func disabledConfigErrorExpression(call string) string {
+	arguments := strings.TrimSuffix(strings.TrimPrefix(call, "configError("), ")")
+	return "func() error { _ = []any{" + arguments + "}; return nil }()"
+}
+
+func configErrorCallSites(root string) ([]callSite, error) {
+	var sites []callSite
+	for _, name := range []string{"internal/config/schema.go", "internal/config/validation.go", "internal/config/writer.go"} {
+		path := filepath.Join(root, name)
+		source, err := os.ReadFile(path)
+		if err != nil {
+			return nil, err
+		}
+		lines := strings.Split(string(source), "\n")
+		fileSet := token.NewFileSet()
+		parsed, err := parser.ParseFile(fileSet, path, source, 0)
+		if err != nil {
+			return nil, err
+		}
+		file := fileSet.File(parsed.Pos())
+		ast.Inspect(parsed, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			identifier, ok := call.Fun.(*ast.Ident)
+			if !ok || identifier.Name != "configError" {
+				return true
+			}
+			position := fileSet.Position(call.Pos())
+			if strings.Contains(lines[position.Line-1], "config-refusal-subsumed:") {
+				return true
+			}
+			sites = append(sites, callSite{
+				name: fmt.Sprintf("disable %s:%d", filepath.Base(name), position.Line), file: name,
+				start: file.Offset(call.Pos()), end: file.Offset(call.End()),
+			})
+			return true
+		})
+	}
+	sort.Slice(sites, func(i, j int) bool { return sites[i].name < sites[j].name })
+	return sites, nil
+}
+
+func narrowingMutations() []mutation {
+	return []mutation{
+		{name: "narrow peer workspace-root platform binding to host platform", file: "internal/config/validation.go", old: `validateWorkspaceRoots(prefix+".workspace_roots", peer.WorkspaceRoots, peer.Platform, 64)`, replacement: `validateWorkspaceRoots(prefix+".workspace_roots", peer.WorkspaceRoots, configuration.Platform, 64)`},
+		{name: "narrow peer workspace-root validation to count only", file: "internal/config/validation.go", old: `if err := validateWorkspaceRoots(prefix+".workspace_roots", peer.WorkspaceRoots, peer.Platform, 64); err != nil {
+			return err
+		}`, replacement: `if len(peer.WorkspaceRoots) > 64 {
+			return configError(prefix+".workspace_roots", ErrConfigValidation)
+		}`},
+		{name: "drop scan authority minimum", file: "internal/config/validation.go", old: `if len(values) < min || len(values) > max {`, replacement: `if len(values) > max {`},
+		{name: "drop legacy conpty translation", file: "internal/config/validation.go", old: `} else if backend == "conpty" {
+		backend = "ax.conpty"
+	}`, replacement: `}`},
+		{name: "drop legacy Windows backend default", file: "internal/config/validation.go", old: `func legacyBackendDefault(platform scalar.Platform) string {
+	if platform == scalar.PlatformWindows {
+		return "conpty"
+	}
+	return "tmux"
+}`, replacement: `func legacyBackendDefault(scalar.Platform) string { return "tmux" }`},
+		{name: "drop current Windows backend default", file: "internal/config/validation.go", old: `func currentBackendDefault(platform scalar.Platform) string {
+	if platform == scalar.PlatformWindows {
+		return "ax.conpty"
+	}
+	return "ax.tmux"
+}`, replacement: `func currentBackendDefault(scalar.Platform) string { return "ax.tmux" }`},
+		{name: "widen logical-root grammar", file: "internal/config/validation.go", old: "`^[a-z][a-z0-9_-]{0,63}$`", replacement: "`^[A-Za-z0-9_-]{1,64}$`"},
+		{name: "widen extension namespace grammar below three bytes", file: "internal/config/validation.go", old: "`^[a-z][a-z0-9-]{0,62}(?:\\.[a-z][a-z0-9-]{0,62})+$`", replacement: "`^[a-z][a-z0-9-]{0,62}(?:\\.[a-z][a-z0-9-]{0,62})*$`"},
+		{name: "drop extension int64 safe-integer bound", file: "internal/config/validation.go", old: `case int64:
+		if typed < -scalar.MaxSafeInteger || typed > scalar.MaxSafeInteger {
+			return ErrConfigValidation
+		}
+		return nil`, replacement: `case int64:
+		return nil`},
+		{name: "narrow present-empty-map restoration away from settings", file: "internal/config/schema.go", old: `if destinationField.IsNil() && unwrappedSource.IsValid() && unwrappedSource.Kind() == reflect.Map {`, replacement: `if name != "settings" && destinationField.IsNil() && unwrappedSource.IsValid() && unwrappedSource.Kind() == reflect.Map {`},
+	}
+}
+
+func fatal(err error) {
+	fmt.Fprintln(os.Stderr, err)
+	os.Exit(2)
+}
