+		configuration.Mesh.Peers[0].Platform = scalar.PlatformWindows
+		configuration.Mesh.Peers[0].WorkspaceRoots = []WorkspaceRoot{{LogicalRoot: "relux", Path: `D:\Developer\ReluxWorks`}}
