+		}
+		loaded, _ := snapshot.Configuration()
+		if loaded.Value.Terminal.BackendID != "ax.conpty" {
+			t.Fatalf("Load(%s explicit conpty) backend = %q", version, loaded.Value.Terminal.BackendID)
+		}
+	}
+}
