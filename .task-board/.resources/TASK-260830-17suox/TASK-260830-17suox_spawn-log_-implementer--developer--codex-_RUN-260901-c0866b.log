+			configuration.WorkspaceRoots[0].LogicalRoot = logicalRoot
+			_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})
+			requireConfigClause(t, err, "workspace_roots[0].logical_root")
+		}
