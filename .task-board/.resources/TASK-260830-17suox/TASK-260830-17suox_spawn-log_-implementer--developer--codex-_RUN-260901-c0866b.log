+package config
+
+import (
+	"flag"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+)
+
+var exercisedConfigErrorSites sync.Map
+
+func TestMain(main *testing.M) {
+	observeConfigError = func(file string, line int, _ string) {
+		exercisedConfigErrorSites.Store(fmt.Sprintf("%s:%d", filepath.Base(file), line), struct{}{})
+	}
+	code := main.Run()
+	if code == 0 && fullPackageTestRun() {
+		missing, err := missingConfigErrorSites()
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "derive configuration refusal inventory: %v\n", err)
+			code = 1
+		} else if len(missing) != 0 {
+			fmt.Fprintf(os.Stderr, "configuration refusal call sites without an exercised negative path: %s\n", strings.Join(missing, ", "))
+			code = 1
+		}
+	}
+	os.Exit(code)
+}
+
+func fullPackageTestRun() bool {
+	selected := flag.Lookup("test.run")
+	return selected == nil || selected.Value.String() == ""
+}
+
+func missingConfigErrorSites() ([]string, error) {
+	directory, err := os.Getwd()
+	if err != nil {
+		return nil, err
+	}
+	entries, err := os.ReadDir(directory)
+	if err != nil {
+		return nil, err
+	}
+	fileSet := token.NewFileSet()
+	var expected []string
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".go") || strings.HasSuffix(entry.Name(), "_test.go") {
+			continue
+		}
+		path := filepath.Join(directory, entry.Name())
+		source, err := os.ReadFile(path)
+		if err != nil {
+			return nil, err
+		}
+		lines := strings.Split(string(source), "\n")
+		parsed, err := parser.ParseFile(fileSet, path, source, 0)
+		if err != nil {
+			return nil, err
+		}
+		ast.Inspect(parsed, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			identifier, ok := call.Fun.(*ast.Ident)
+			if !ok || identifier.Name != "configError" {
+				return true
+			}
+			position := fileSet.Position(call.Pos())
+			line := lines[position.Line-1]
+			if strings.Contains(line, "config-refusal-subsumed:") {
+				return true
+			}
+			expected = append(expected, fmt.Sprintf("%s:%d", entry.Name(), position.Line))
+			return true
+		})
+	}
+
+	var missing []string
+	for _, site := range expected {
+		if _, ok := exercisedConfigErrorSites.Load(site); !ok {
+			missing = append(missing, site)
+		}
+	}
+	sort.Strings(missing)
+	return missing, nil
+}
diff --git a/internal/config/schema.go b/internal/config/schema.go
index bbbbdd32000373cdd5248eb800416715f8d5dc11..bde0f98fe0bd80b9e8bb58e0ff36c9514468e873
--- a/internal/config/schema.go
+++ b/internal/config/schema.go
@@ -3,6 +3,9 @@
 import (
 	"bytes"
 	"errors"
+	"reflect"
+	"runtime"
+	"strings"
 
 	"github.com/pelletier/go-toml/v2"
 	"github.com/relux-works/agent-session-manager/internal/scalar"
@@ -461,9 +464,84 @@
 	if err := decoder.Decode(destination); err != nil {
 		return configError("closed TOML shape", errors.Join(ErrConfigDecode, err))
 	}
+	var shape map[string]any
+	if err := toml.Unmarshal(document, &shape); err != nil {
+		return configError("closed TOML shape", errors.Join(ErrConfigDecode, err)) // config-refusal-subsumed: envelope TOML syntax parse
+	}
+	restorePresentEmptyMaps(reflect.ValueOf(destination), reflect.ValueOf(shape))
 	return nil
 }
 
+// restorePresentEmptyMaps repairs a go-toml decoding ambiguity without
+// weakening required-member validation. go-toml leaves a map field nil for a
+// present but empty table such as [entry.extensions], which is otherwise
+// indistinguishable from an absent required member in the typed value. The
+// generic document shape retains table presence, so this schema-driven walk
+// initializes only map members that were actually present in the source.
+func restorePresentEmptyMaps(destination, source reflect.Value) {
+	destination = indirectValue(destination)
+	source = indirectValue(source)
+	if !destination.IsValid() || !source.IsValid() {
+		return
+	}
+
+	switch destination.Kind() {
+	case reflect.Struct:
+		if source.Kind() != reflect.Map || source.Type().Key().Kind() != reflect.String {
+			return
+		}
+		for index := 0; index < destination.NumField(); index++ {
+			fieldType := destination.Type().Field(index)
+			name := strings.Split(fieldType.Tag.Get("toml"), ",")[0]
+			if name == "" || name == "-" {
+				continue
+			}
+			sourceField := source.MapIndex(reflect.ValueOf(name).Convert(source.Type().Key()))
+			if !sourceField.IsValid() {
+				continue
+			}
+			destinationField := destination.Field(index)
+			unwrappedSource := indirectValue(sourceField)
+			if destinationField.Kind() == reflect.Map {
+				if destinationField.IsNil() && unwrappedSource.IsValid() && unwrappedSource.Kind() == reflect.Map {
+					destinationField.Set(reflect.MakeMap(destinationField.Type()))
+				}
+				continue
+			}
+			restorePresentEmptyMaps(destinationField, sourceField)
+		}
+	case reflect.Slice:
+		if source.Kind() != reflect.Slice {
+			return
+		}
+		limit := destination.Len()
+		if source.Len() < limit {
+			limit = source.Len()
+		}
+		for index := 0; index < limit; index++ {
+			restorePresentEmptyMaps(destination.Index(index), source.Index(index))
+		}
+	}
+}
+
+func indirectValue(value reflect.Value) reflect.Value {
+	for value.IsValid() && (value.Kind() == reflect.Interface || value.Kind() == reflect.Pointer) {
+		if value.IsNil() {
+			return reflect.Value{}
+		}
+		value = value.Elem()
+	}
+	return value
+}
+
+var observeConfigError func(file string, line int, clause string)
+
 func configError(field string, err error) error {
+	if observer := observeConfigError; observer != nil {
+		_, file, line, ok := runtime.Caller(1)
+		if ok {
+			observer(file, line, field)
+		}
+	}
 	return &DocumentError{Clause: field, Err: err}
 }
