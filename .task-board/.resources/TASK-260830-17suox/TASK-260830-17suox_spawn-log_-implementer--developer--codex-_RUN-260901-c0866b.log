+		if _, err := EncodeCurrent(at, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {
+			t.Fatalf("EncodeCurrent(extension int64 at safe limit) error = %v", err)
+		}
+		past := validCurrentConfiguration()
