+			restorePresentEmptyMaps(destinationField, sourceField)
+		}
+	case reflect.Slice:
+		if source.Kind() != reflect.Slice {
+			return
+		}
+		limit := destination.Len()
+		if source.Len() < limit {
+			limit = source.Len()
+		}
+		for index := 0; index < limit; index++ {
+			restorePresentEmptyMaps(destination.Index(index), source.Index(index))
