+			value.Terminal.ExternalTrust = []ExternalExecutableTrust{{BackendID: "a." + strings.Repeat("b", 127), ExecutablePath: "/opt/backend", ExecutableDigest: testDigest, Enabled: true}}
+		}},
+	}
+
+	for _, test := range tests {
