    66				if loaded.Value.Directory.Mode != "on_demand" || loaded.Value.Directory.DefaultMetadataPolicy != "local_only" {
    67					t.Fatalf("Load(%s) did not apply safe current directory defaults: %#v", version, loaded.Value.Directory)
    68				}
    69			})
    70		}
