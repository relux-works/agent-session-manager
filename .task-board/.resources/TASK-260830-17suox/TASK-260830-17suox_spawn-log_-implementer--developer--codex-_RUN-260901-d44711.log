+#!/bin/zsh
+
+set -eu
+
+task_dir=.temp/TASK-260830-17suox
+source_file=internal/config/validation.go
+backup_file="$task_dir/validation.go.pre-mutation"
+summary_file="$task_dir/clause-mutation-sweep-09.log"
+survivors=0
+
+cp "$source_file" "$backup_file"
+trap 'cp "$backup_file" "$source_file"' EXIT
+: > "$summary_file"
+
+run_mutant() {
+  local name="$1"
+  local test_pattern="$2"
+  local old_text="$3"
+  local new_text="$4"
+  local test_log="$task_dir/mutant-${name}.log"
+
+  cp "$backup_file" "$source_file"
+  OLD_TEXT="$old_text" NEW_TEXT="$new_text" perl -0pi -e '
+    BEGIN { $old = $ENV{"OLD_TEXT"}; $new = $ENV{"NEW_TEXT"}; }
+    $count = s/\Q$old\E/$new/;
+    END { die "mutation pattern not found\n" unless $count; }
+  ' "$source_file"
+
+  set +e
+  go test ./internal/config -run "$test_pattern" -count=1 > "$test_log" 2>&1
+  local result_code=$?
+  set -e
+
+  echo "$name: expected-red go test exit=$result_code" >> "$summary_file"
+  if (( result_code == 0 )); then
+    echo "$name: SURVIVED" >> "$summary_file"
+    survivors=$((survivors + 1))
+  fi
+  cp "$backup_file" "$source_file"
+}
