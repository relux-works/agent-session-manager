   288	func TestConfigurationNumericBoundsAcceptLimitsAndRefusePastLimitsAtProductionEntry(t *testing.T) {
   289		t.Parallel()
   290	
   291		tests := []struct {
   292			name, table, key string
   293			min, max         uint64
   294		}{
   295			{"mesh sync interval", "mesh", "sync_interval_seconds", 5, 86_400},
   296			{"mesh connect timeout", "mesh", "connect_timeout_seconds", 1, 300},
   297			{"mesh RPC timeout", "mesh", "rpc_timeout_seconds", 10, 3_600},
   298			{"parallel chunks", "sync", "max_parallel_chunks", 1, 32},
   299			{"staging retention", "sync", "staging_retention_hours", 1, 720},
   300			{"tombstone retention", "sync", "tombstone_min_retention_days", 90, 3_650},
   301			{"safe boundary timeout", "terminal", "safe_boundary_timeout_seconds", 1, 3_600},
   302			{"graceful stop timeout", "terminal", "graceful_stop_timeout_seconds", 1, 600},
   303			{"service health interval", "service", "health_interval_seconds", 5, 3_600},
   304			{"directory scan interval", "directory", "scan_interval_seconds", 5, 86_400},
   305			{"directory scan debounce", "directory", "scan_debounce_seconds", 0, 3_600},
   306			{"directory scan concurrency", "directory", "scan_concurrency", 1, 32},
   307			{"directory plan expiry", "directory", "plan_expiry_seconds", 30, 3_600},
   308			{"directory query batch", "directory", "query_batch_max", 1, 64},
   309			{"directory grep result", "directory", "grep_result_max", 1, 10_000},
   310			{"directory observation retention", "directory", "observation_retention_days", 30, 3_650},
   311			{"directory job retention", "directory", "job_retention_days", 30, 3_650},
   312			{"directory operation retention", "directory", "operation_retention_days", 90, 3_650},
   313		}
   314		for _, test := range tests {
   315			test := test
   316			t.Run(test.name, func(t *testing.T) {
   317				for label, value := range map[string]uint64{"min": test.min, "max": test.max} {
   318					document := configWithScalar(test.table, test.key, fmt.Sprint(value))
   319					if _, err := loadConfigDocument(document, scalar.PlatformMacOS, nil); err != nil {
   320						t.Errorf("%s at %s=%d refused: %v", test.name, label, value, err)
   321					}
   322				}
   323				if test.min > 0 {
   324					document := configWithScalar(test.table, test.key, fmt.Sprint(test.min-1))
   325					if _, err := loadConfigDocument(document, scalar.PlatformMacOS, nil); !errors.Is(err, ErrConfigValidation) {
   326						t.Errorf("%s below min error = %v", test.name, err)
   327					}
   328				} else {
   329					document := configWithScalar(test.table, test.key, "-1")
   330					if _, err := loadConfigDocument(document, scalar.PlatformMacOS, nil); err == nil {
   331						t.Errorf("%s accepted negative value", test.name)
   332					}
   333				}
   334				document := configWithScalar(test.table, test.key, fmt.Sprint(test.max+1))
   335				if _, err := loadConfigDocument(document, scalar.PlatformMacOS, nil); !errors.Is(err, ErrConfigValidation) {
   336					t.Errorf("%s above max error = %v", test.name, err)
   337				}
   338			})
   339		}
   340	
   341		for _, value := range []uint64{4_194_303, 4_194_305} {
   342			if _, err := loadConfigDocument(configWithScalar("sync", "chunk_bytes", fmt.Sprint(value)), scalar.PlatformMacOS, nil); !errors.Is(err, ErrConfigValidation) {
   343				t.Errorf("sync.chunk_bytes=%d error = %v", value, err)
   344			}
   345		}
   346		if _, err := loadConfigDocument(configWithScalar("sync", "chunk_bytes", "4194304"), scalar.PlatformMacOS, nil); err != nil {
   347			t.Errorf("sync.chunk_bytes exact constant refused: %v", err)
   348		}
