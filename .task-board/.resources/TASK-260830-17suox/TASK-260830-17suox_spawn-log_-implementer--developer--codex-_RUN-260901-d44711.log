   870	func parseSSHConfigOption(option string) (string, string) {
   871		option = strings.TrimSpace(option)
   872		separator := strings.IndexFunc(option, func(character rune) bool { return character == '=' || unicode.IsSpace(character) })
   873		if separator < 0 {
   874			return strings.ToLower(option), ""
   875		}
   876		name := strings.ToLower(strings.TrimSpace(option[:separator]))
   877		remainder := strings.TrimLeftFunc(option[separator:], func(character rune) bool { return character == '=' || unicode.IsSpace(character) })
   878		value := strings.ToLower(strings.TrimSpace(remainder))
   879		if len(value) >= 2 && ((value[0] == '"' && value[len(value)-1] == '"') || (value[0] == '\'' && value[len(value)-1] == '\'')) {
   880			value = strings.TrimSpace(value[1 : len(value)-1])
   881		}
   882		return name, value
   883	}
