   639	func validCurrentConfiguration() Configuration {
   640		configuration := Configuration{
   641			Schema: SchemaID, SchemaVersion: CurrentVersion, HostID: testHostID,
   642			HostName: "fixture-host", Platform: scalar.PlatformMacOS,
   643			Mesh: Mesh{
   644				Transport: "ssh", SyncIntervalSeconds: 60, ConnectTimeoutSeconds: 10, RPCTimeoutSeconds: 300,
   645				WorkspaceReplication: true, PayloadEncryption: "none",
   646				Peers: []Peer{{HostID: testPeerID, Name: "peer", Endpoint: "peer.example", Platform: scalar.PlatformLinux, SSHArgs: []string{"-o", "BatchMode=yes"}}},
   647			},
   648			WorkspaceRoots: []WorkspaceRoot{{LogicalRoot: "relux", Path: "/Users/test/Developer"}},
   649			Providers:      Providers{PluginDirs: []string{"/Users/test/.local/libexec/ax/providers"}, AllowPathPlugins: true, RequireExplicitTrust: true},
   650			Sync:           Sync{ChunkBytes: 4_194_304, MaxParallelChunks: 4, StagingRetentionHours: 72, TombstoneMinRetentionDays: 90},
   651			Terminal:       Terminal{BackendID: "ax.tmux", SafeBoundaryTimeoutSeconds: 300, GracefulStopTimeoutSeconds: 60, MultipleInputPolicy: "deny", TransportPolicy: []string{"local_only", "trusted_private_mesh"}, TransportPolicyExplicit: true},
   652			Service:        Service{Enabled: true, HealthIntervalSeconds: 30}, Restore: Restore{AutoResume: false},
   653			Profiles: Profiles{Yolo: YoloProfile{RequireFirstUseConfirmation: true}}, Directory: defaultDirectory(),
   654			DirectoryInstallations: []DirectoryInstallation{{
   655				InstallationID: testDigest, EnvironmentID: "local", ProviderID: "codex", AdapterID: "codex-local",
   656				ScanRootAuthorityIDs: []string{testDigest}, Enabled: true, Extensions: map[string]any{"works.relux.fixture": map[string]any{"count": int64(1)}},
   657			}},
   658		}
   659		return configuration
   660	}
   661	
   662	func makeDigests(count int) []string {
   663		values := make([]string, count)
   664		for index := range values {
   665			values[index] = fmt.Sprintf("sha256:%064x", index)
   666		}
   667		return values
   668	}
