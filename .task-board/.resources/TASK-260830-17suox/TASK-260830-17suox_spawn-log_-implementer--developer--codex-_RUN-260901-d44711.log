+	if _, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {
+		t.Fatalf("EncodeCurrent(explicit empty transport policy) error = %v", err)
+	}
+}
