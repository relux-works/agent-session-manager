+if ! cmp -s "$backup_file" "$source_file"; then
+  echo 'source restoration mismatch' >> "$summary_file"
+  exit 1
+fi
+echo "survivors=$survivors" >> "$summary_file"
+if (( survivors != 0 )); then
+  exit 1
+fi
