+  'if len(argument) < 1 || len(argument) > 4096 || strings.IndexByte(argument, 0) >= 0 {'
+run_mutant ssh_nul "$composite_test" \
+  'if !utf8.ValidString(argument) || len(argument) < 1 || len(argument) > 4096 || strings.IndexByte(argument, 0) >= 0 {' \
+  'if !utf8.ValidString(argument) || len(argument) < 1 || len(argument) > 4096 {'
+run_mutant extension_key_length '^TestCurrentEntriesProveRelationalCollectionAndNestedBoundsInBothDirections$/^extension_key_byte_bound$' \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {' \
+  'if !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {'
+run_mutant extension_reverse_dns "$composite_test" \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {' \
+  'if len(key) < 3 || len(key) > 253 || hasForbiddenConfigName(key) {'
+run_mutant extension_forbidden_root "$composite_test" \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {' \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) {'
+run_mutant extension_forbidden_nested "$composite_test" \
+  'if hasForbiddenConfigName(key) {' 'if false {'
+run_mutant extension_float "$composite_test" \
+  $'case float64, float32:\n\t\treturn ErrConfigValidation' $'case float64, float32:\n\t\treturn nil'
+run_mutant extension_array_depth "$composite_test" \
+  $'case []any:\n\t\tif depth >= 4 {' $'case []any:\n\t\tif false {'
+run_mutant digest_uniqueness "$composite_test" \
+  $'func validateSortedUniqueDigests(values []string, min, max int) error {\n'\
+$'\tif len(values) < min || len(values) > max {\n'\
+$'\t\treturn ErrConfigValidation\n'\
+$'\t}\n'\
+$'\tfor index, value := range values {\n'\
+$'\t\tif _, err := scalar.ParseDigest(value); err != nil {\n'\
+$'\t\t\treturn errors.Join(ErrConfigValidation, err)\n'\
+$'\t\t}\n'\
+$'\t\tif index > 0 && values[index-1] >= value {' \
+  $'func validateSortedUniqueDigests(values []string, min, max int) error {\n'\
+$'\tif len(values) < min || len(values) > max {\n'\
+$'\t\treturn ErrConfigValidation\n'\
+$'\t}\n'\
+$'\tfor index, value := range values {\n'\
+$'\t\tif _, err := scalar.ParseDigest(value); err != nil {\n'\
+$'\t\t\treturn errors.Join(ErrConfigValidation, err)\n'\
+$'\t\t}\n'\
+$'\t\tif index > 0 && values[index-1] > value {'
+run_mutant closed_set_uniqueness "$composite_test" \
+  $'func validateSortedUniqueClosed(values []string, allowed map[string]struct{}) error {\n'\
+$'\tfor index, value := range values {\n'\
+$'\t\tif _, ok := allowed[value]; !ok {\n'\
+$'\t\t\treturn ErrConfigValidation\n'\
+$'\t\t}\n'\
+$'\t\tif index > 0 && values[index-1] >= value {' \
+  $'func validateSortedUniqueClosed(values []string, allowed map[string]struct{}) error {\n'\
+$'\tfor index, value := range values {\n'\
+$'\t\tif _, ok := allowed[value]; !ok {\n'\
+$'\t\t\treturn ErrConfigValidation\n'\
+$'\t\t}\n'\
+$'\t\tif index > 0 && values[index-1] > value {'
+run_mutant selected_backend_id_bound "$composite_test" \
+  'if !terminalBackendIDPattern.MatchString(terminal.BackendID) || len(terminal.BackendID) > 128 {' \
+  'if !terminalBackendIDPattern.MatchString(terminal.BackendID) {'
+run_mutant external_backend_id_bound "$composite_test" \
+  'if !terminalBackendIDPattern.MatchString(entry.BackendID) || len(entry.BackendID) > 128 {' \
+  'if !terminalBackendIDPattern.MatchString(entry.BackendID) {'
+
+cp "$backup_file" "$source_file"
+if ! cmp -s "$backup_file" "$source_file"; then
+  echo 'source restoration mismatch' >> "$summary_file"
+  exit 1
+fi
+echo "survivors=$survivors" >> "$summary_file"
+if (( survivors != 0 )); then
+  exit 1
+fi
