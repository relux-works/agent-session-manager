+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {' \
+  'if !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {'
+run_mutant extension_reverse_dns "$composite_test" \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {' \
+  'if len(key) < 3 || len(key) > 253 || hasForbiddenConfigName(key) {'
+run_mutant extension_forbidden_root "$composite_test" \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) || hasForbiddenConfigName(key) {' \
+  'if len(key) < 3 || len(key) > 253 || !reverseDNSPattern.MatchString(key) {'
+run_mutant extension_forbidden_nested "$composite_test" \
+  'if hasForbiddenConfigName(key) {' 'if false {'
+run_mutant extension_float "$composite_test" \
+  $'case float64, float32:\n\t\treturn ErrConfigValidation' $'case float64, float32:\n\t\treturn nil'
+run_mutant extension_array_depth "$composite_test" \
+  $'case []any:\n\t\tif depth >= 4 {' $'case []any:\n\t\tif false {'
+run_mutant digest_uniqueness "$composite_test" \
+  $'func validateSortedUniqueDigests(values []string, min, max int) error {\n'\
+$'\tif len(values) < min || len(values) > max {\n'\
