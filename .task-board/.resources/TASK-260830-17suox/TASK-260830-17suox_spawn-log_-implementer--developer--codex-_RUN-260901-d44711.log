+			value.HostName = "host\nname"
+		}},
+		{name: "SSH argument invalid UTF-8", clause: "mesh.peers[0].ssh_args", mutate: func(value *Configuration) {
+			value.Mesh.Peers[0].SSHArgs = []string{string([]byte{0xff})}
