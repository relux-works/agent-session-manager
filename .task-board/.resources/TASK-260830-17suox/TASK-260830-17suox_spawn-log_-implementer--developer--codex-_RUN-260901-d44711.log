    25	// BackendSettingsValidator closes a backend_config.settings object for one
    26	// exact backend implementation/config version. A nil validator means that no
    27	// backend-specific settings schemas are registered and therefore every
    28	// backend_config entry is refused.
    29	type BackendSettingsValidator interface {
    30		ValidateBackendSettings(backendID, configVersion string, settings map[string]any) error
    31	}
