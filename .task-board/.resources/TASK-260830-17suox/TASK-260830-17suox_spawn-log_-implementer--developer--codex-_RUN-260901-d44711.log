    33	// DecodeContext carries facts that are external to the TOML document but are
    34	// required by its exact validation rules.
    35	type DecodeContext struct {
    36		RuntimePlatform scalar.Platform
    37		BackendSettings BackendSettingsValidator
    38	}
    39	
    40	// LoadedConfiguration is an exact source-version read translated into the
    41	// current in-memory model. SourceVersion remains diagnostic provenance; Value
    42	// always has SchemaVersion CurrentVersion.
    43	type LoadedConfiguration struct {
    44		SourceVersion string
    45		Value         Configuration
    46	}
    47	
    48	// DocumentError preserves machine-actionable error identity while rendering
    49	// only a static schema clause. Parser/validator details remain unwrap-able and
    50	// cannot echo TOML values, paths, endpoints, or other machine-local data.
    51	type DocumentError struct {
    52		Clause string
    53		Err    error
    54	}
    55	
    56	func (err *DocumentError) Error() string { return "configuration document rejected at " + err.Clause }
    57	func (err *DocumentError) Unwrap() error { return err.Err }
