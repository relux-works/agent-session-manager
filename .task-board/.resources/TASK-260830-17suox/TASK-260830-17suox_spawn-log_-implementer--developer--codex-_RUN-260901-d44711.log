   506			at.Mesh.Peers[0].Endpoint = strings.Repeat("界", 1024)
   507			at.WorkspaceRoots[0].LogicalRoot = "a" + strings.Repeat("b", 63)
   508			at.WorkspaceRoots[0].Path = "/" + strings.Repeat("p", 32_766)
   509			at.DirectoryInstallations[0].EnvironmentID = strings.Repeat("界", 64)
   510			at.DirectoryInstallations[0].AdapterID = strings.Repeat("界", 64)
   511			assertCurrentAccepted(t, at)
   512			for name, mutate := range map[string]func(*Configuration){
   513				"peer name":      func(value *Configuration) { value.Mesh.Peers[0].Name = strings.Repeat("界", 65) },
   514				"endpoint":       func(value *Configuration) { value.Mesh.Peers[0].Endpoint = strings.Repeat("界", 1025) },
   515				"logical root":   func(value *Configuration) { value.WorkspaceRoots[0].LogicalRoot = "a" + strings.Repeat("b", 64) },
   516				"absolute path":  func(value *Configuration) { value.WorkspaceRoots[0].Path = "/" + strings.Repeat("p", 32_767) },
   517				"environment id": func(value *Configuration) { value.DirectoryInstallations[0].EnvironmentID = strings.Repeat("界", 65) },
   518				"adapter id":     func(value *Configuration) { value.DirectoryInstallations[0].AdapterID = strings.Repeat("界", 65) },
   519			} {
   520				value := validCurrentConfiguration()
   521				mutate(&value)
   522				t.Run(name, func(t *testing.T) { assertCurrentRefused(t, value) })
   523			}
   524		})
   525	
   526		t.Run("terminal backend ID byte bound", func(t *testing.T) {
   527			at := validCurrentConfiguration()
   528			backendID := "a." + strings.Repeat("b", 126)
   529			at.Terminal.BackendID = backendID
   530			at.Terminal.ExternalTrust = []ExternalExecutableTrust{{BackendID: backendID, ExecutablePath: "/opt/backend", ExecutableDigest: testDigest, Enabled: true}}
   531			assertCurrentAccepted(t, at)
   532			over := cloneConfiguration(at)
   533			over.Terminal.BackendID += "b"
   534			over.Terminal.ExternalTrust[0].BackendID = over.Terminal.BackendID
   535			assertCurrentRefused(t, over)
   536		})
   537	
   538		t.Run("extension entry depth and canonical byte bounds", func(t *testing.T) {
   539			at := validCurrentConfiguration()
   540			at.DirectoryInstallations[0].Extensions = make(map[string]any, 64)
   541			for index := 0; index < 64; index++ {
   542				at.DirectoryInstallations[0].Extensions[fmt.Sprintf("works.relux.k%d", index)] = int64(index)
   543			}
   544			assertCurrentAccepted(t, at)
   545			overCount := cloneConfiguration(at)
   546			overCount.DirectoryInstallations[0].Extensions["works.relux.overflow"] = true
   547			assertCurrentRefused(t, overCount)
   548	
   549			depth := validCurrentConfiguration()
   550			depth.DirectoryInstallations[0].Extensions = map[string]any{"works.relux.depth": map[string]any{"a": map[string]any{"b": map[string]any{"c": map[string]any{"d": "leaf"}}}}}
   551			assertCurrentAccepted(t, depth)
   552			overDepth := cloneConfiguration(depth)
   553			overDepth.DirectoryInstallations[0].Extensions = map[string]any{"works.relux.depth": map[string]any{"a": map[string]any{"b": map[string]any{"c": map[string]any{"d": map[string]any{"e": "leaf"}}}}}}
   554			assertCurrentRefused(t, overDepth)
   555	
   556			bytesAt := validCurrentConfiguration()
   557			key := "works.relux.bytes"
   558			baseSize, _ := json.Marshal(map[string]any{key: ""})
   559			payload := strings.Repeat("x", maxConfigExtensionBytes-len(baseSize))
   560			bytesAt.DirectoryInstallations[0].Extensions = map[string]any{key: payload}
   561			encodedJSON, _ := json.Marshal(bytesAt.DirectoryInstallations[0].Extensions)
   562			if len(encodedJSON) != maxConfigExtensionBytes {
   563				t.Fatalf("extension fixture JSON bytes = %d", len(encodedJSON))
   564			}
   565			assertCurrentAccepted(t, bytesAt)
   566			overSize := cloneConfiguration(bytesAt)
   567			overSize.DirectoryInstallations[0].Extensions[key] = payload + "x"
   568			assertCurrentRefused(t, overSize)
   569		})
   570	}
   570	}
   571	
   572	func TestEncodeCurrentRoundTripsCurrentVersionAndReturnsIsolatedSnapshots(t *testing.T) {
   573		t.Parallel()
   574	
   575		configuration := validCurrentConfiguration()
   576		encoded, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})
   577		if err != nil {
   578			t.Fatalf("EncodeCurrent() error = %v", err)
   579		}
   580		if strings.Contains(string(encoded), "schema_version = \"1.0.0\"") || strings.Contains(string(encoded), "backend = \"tmux\"") {
   581			t.Fatalf("EncodeCurrent() emitted legacy syntax:\n%s", encoded)
   582		}
   583		snapshot, err := loadConfigDocument(encoded, scalar.PlatformMacOS, nil)
   584		if err != nil {
   585			t.Fatalf("Load(EncodeCurrent()) error = %v", err)
   586		}
   587		loaded, ok := snapshot.Configuration()
   588		if !ok || loaded.SourceVersion != CurrentVersion {
   589			t.Fatalf("round-trip loaded = %#v, %v", loaded, ok)
   590		}
   591		first, _ := snapshot.Configuration()
   592		first.Value.Mesh.Peers[0].SSHArgs[0] = "mutated"
   593		first.Value.DirectoryInstallations[0].Extensions["works.relux.fixture"] = "mutated"
   594		second, _ := snapshot.Configuration()
   595		if second.Value.Mesh.Peers[0].SSHArgs[0] == "mutated" || reflect.DeepEqual(first.Value.DirectoryInstallations[0].Extensions, second.Value.DirectoryInstallations[0].Extensions) {
   596			t.Fatal("Snapshot.Configuration() exposed mutable internal slices/maps")
   597		}
   598	}
