   600	type exactBackendSettings struct{}
   601	
   602	func (exactBackendSettings) ValidateBackendSettings(backendID, version string, settings map[string]any) error {
   603		if backendID != "com.example.term" || version != "1.0.0" || len(settings) != 1 || settings["color"] != "blue" {
   604			return errors.New("settings do not match registered com.example.term@1.0.0 shape")
   605		}
   606		return nil
   607	}
   608	
   609	func loadConfigDocument(document []byte, platform scalar.Platform, settings BackendSettingsValidator) (Snapshot, error) {
   610		files := newFakeFileSystem()
   611		files.regular["/config/config.toml"] = append([]byte(nil), document...)
   612		inputs := fixtureInputs(platform, map[string]string{"AX_CONFIG": "/config/config.toml"}, files)
   613		inputs.BackendSettings = settings
   614		return Load(inputs, nil)
   615	}
   616	
   617	func minimalValidConfigVersion(platform scalar.Platform, version string) []byte {
   618		return []byte(fmt.Sprintf(
   619			"schema = %q\nschema_version = %q\nhost_id = %q\nhost_name = %q\nplatform = %q\n",
   620			SchemaID, version, testHostID, "fixture-host", platform.String(),
   621		))
   622	}
   623	
   624	func configWithScalar(table, key, value string) []byte {
   625		return []byte(string(minimalValidConfigVersion(scalar.PlatformMacOS, CurrentVersion)) + "\n[" + table + "]\n" + key + " = " + value + "\n")
   626	}
   627	
   628	func replaceRootString(document []byte, key, value string) []byte {
   629		lines := strings.Split(string(document), "\n")
   630		for index, line := range lines {
   631			if strings.HasPrefix(line, key+" = ") {
   632				lines[index] = fmt.Sprintf("%s = %q", key, value)
   633				break
   634			}
   635		}
   636		return []byte(strings.Join(lines, "\n"))
   637	}
