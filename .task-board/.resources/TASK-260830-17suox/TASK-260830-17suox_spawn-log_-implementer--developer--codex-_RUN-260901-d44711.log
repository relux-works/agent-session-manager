   853			}
   854		}
   855		for _, option := range options {
   856			name, value := parseSSHConfigOption(option)
   857			if name == "stricthostkeychecking" && value == "no" {
   858				return true
   859			}
   860			if name == "userknownhostsfile" && (value == "" || value == "/dev/null" || value == "nul") {
