+	WorkspaceRoots              []rawWorkspaceRoot              `toml:"workspace_roots"`
+	Providers                   rawProviders                    `toml:"providers"`
+	Sync                        rawSync                         `toml:"sync"`
+	Terminal                    rawLegacyTerminal               `toml:"terminal"`
