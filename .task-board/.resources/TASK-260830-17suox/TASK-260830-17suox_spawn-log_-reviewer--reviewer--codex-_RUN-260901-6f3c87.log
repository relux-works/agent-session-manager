   126	func validateRawTerminalPresence(terminal rawTerminal) error {
   127		for index, entry := range terminal.ExternalTrust {
   128			if entry.BackendID == nil || entry.ExecutablePath == nil || entry.ExecutableDigest == nil || entry.Enabled == nil {
   129				return configError(fmt.Sprintf("terminal.external_trust[%d] required member", index), ErrConfigValidation)
   130			}
   131		}
   132		for index, entry := range terminal.BackendConfig {
   133			if entry.BackendID == nil || entry.ConfigVersion == nil || entry.Settings == nil {
   134				return configError(fmt.Sprintf("terminal.backend_config[%d] required member", index), ErrConfigValidation)
   135			}
   136		}
   137		return nil
   138	}
