    50		}
    51		base.Terminal = translateLegacyTerminal(raw.Terminal, base.Platform)
    52		base.Directory = defaultDirectory()
    53		if err := validateConfiguration(&base, context); err != nil {
    54			return Configuration{}, err
    55		}
