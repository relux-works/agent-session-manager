    83	func TestTerminalCapabilityClosureIsDerivedFromPinnedCatalog(t *testing.T) {
    84		t.Parallel()
    85	
    86		var expected []string
    87		for _, capability := range catalog.Current().Capabilities {
    88			if capability.Family == catalog.Family("terminal_backend") {
    89				expected = append(expected, string(capability.Name))
    90			}
    91		}
    92		sort.Strings(expected)
    93		if len(expected) == 0 {
    94			t.Fatal("pinned catalog has no terminal_backend capabilities")
    95		}
    96		if len(terminalCapabilitySet) != len(expected) {
    97			t.Fatalf("production terminal capability set has %d members, pinned catalog requires %d", len(terminalCapabilitySet), len(expected))
    98		}
    99		for _, name := range expected {
   100			if _, ok := terminalCapabilitySet[name]; !ok {
   101				t.Errorf("pinned terminal capability %q is not enforced by production validation", name)
   102			}
   103		}
   104	
   105		configuration := validCurrentConfiguration()
   106		configuration.Terminal.RequiredCapabilities = expected
   107		configuration.Terminal.RequiredCapabilitiesExplicit = true
   108		if _, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {
   109			t.Fatalf("EncodeCurrent(all pinned terminal capabilities) error = %v", err)
   110		}
   111	}
