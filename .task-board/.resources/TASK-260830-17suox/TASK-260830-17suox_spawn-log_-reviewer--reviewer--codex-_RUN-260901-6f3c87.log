   140	func translateCommon(raw rawCommon, context DecodeContext) (Configuration, error) {
   141		if raw.HostID == nil || raw.HostName == nil || raw.Platform == nil {
   142			return Configuration{}, configError("required root identity", ErrConfigValidation)
   143		}
   144		platform, err := scalar.ParsePlatform(*raw.Platform)
   145		if err != nil {
   146			return Configuration{}, configError("platform", errors.Join(ErrConfigValidation, err))
   147		}
   148		configuration := Configuration{
   149			Schema: SchemaID, SchemaVersion: CurrentVersion,
   150			HostID: *raw.HostID, HostName: *raw.HostName, Platform: platform,
   151			Mesh: Mesh{
   152				Transport:             valueOr(raw.Mesh.Transport, "ssh"),
   153				SyncIntervalSeconds:   valueOr(raw.Mesh.SyncIntervalSeconds, uint64(60)),
   154				ConnectTimeoutSeconds: valueOr(raw.Mesh.ConnectTimeoutSeconds, uint64(10)),
   155				RPCTimeoutSeconds:     valueOr(raw.Mesh.RPCTimeoutSeconds, uint64(300)),
   156				WorkspaceReplication:  valueOr(raw.Mesh.WorkspaceReplication, true),
   157				PayloadEncryption:     valueOr(raw.Mesh.PayloadEncryption, "none"),
   158			},
   159			Providers: Providers{
   160				AllowPathPlugins:     valueOr(raw.Providers.AllowPathPlugins, true),
   161				RequireExplicitTrust: valueOr(raw.Providers.RequireExplicitTrust, true),
   162			},
   163			Sync: Sync{
   164				ChunkBytes:                valueOr(raw.Sync.ChunkBytes, uint64(4_194_304)),
   165				MaxParallelChunks:         valueOr(raw.Sync.MaxParallelChunks, uint64(4)),
   166				StagingRetentionHours:     valueOr(raw.Sync.StagingRetentionHours, uint64(72)),
   167				TombstoneMinRetentionDays: valueOr(raw.Sync.TombstoneMinRetentionDays, uint64(90)),
   168			},
   169			Service: Service{
   170				Enabled:               valueOr(raw.Service.Enabled, true),
   171				HealthIntervalSeconds: valueOr(raw.Service.HealthIntervalSeconds, uint64(30)),
   172			},
   173			Restore:  Restore{AutoResume: valueOr(raw.Restore.AutoResume, false)},
   174			Profiles: Profiles{Yolo: YoloProfile{RequireFirstUseConfirmation: valueOr(raw.Profiles.Yolo.RequireFirstUseConfirmation, true)}},
   175		}
   176		configuration.Mesh.Peers = make([]Peer, len(raw.Mesh.Peers))
   177		for index, peer := range raw.Mesh.Peers {
   178			if peer.HostID == nil || peer.Name == nil || peer.Endpoint == nil || peer.Platform == nil {
   179				return Configuration{}, configError(fmt.Sprintf("mesh.peers[%d] required member", index), ErrConfigValidation)
   180			}
   181			peerPlatform, parseErr := scalar.ParsePlatform(*peer.Platform)
   182			if parseErr != nil {
   183				return Configuration{}, configError(fmt.Sprintf("mesh.peers[%d].platform", index), errors.Join(ErrConfigValidation, parseErr))
   184			}
   185			configuration.Mesh.Peers[index] = Peer{
   186				HostID: *peer.HostID, Name: *peer.Name, Endpoint: *peer.Endpoint,
   187				Platform: peerPlatform, SSHArgs: cloneStrings(peer.SSHArgs),
   188				WorkspaceRoots: translateWorkspaceRoots(peer.WorkspaceRoots),
   189			}
   190		}
   191		configuration.WorkspaceRoots = translateWorkspaceRoots(raw.WorkspaceRoots)
   192		configuration.Providers.PluginDirs = cloneStrings(raw.Providers.PluginDirs)
   193		return configuration, nil
   194	}
