   165	func TestLoadRefusesUnknownClosedMembersUnsupportedVersionsAndMalformedReads(t *testing.T) {
   166		t.Parallel()
   167	
   168		for _, version := range []string{Version1, Version2, CurrentVersion} {
   169			version := version
   170			t.Run(version+" unknown root", func(t *testing.T) {
   171				document := append(minimalValidConfigVersion(scalar.PlatformMacOS, version), []byte("unknown = true\n")...)
   172				_, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)
   173				if !errors.Is(err, ErrConfigDecode) {
   174					t.Fatalf("Load(%s unknown root) error = %v, want ErrConfigDecode", version, err)
   175				}
   176			})
   177		}
   178		for name, document := range map[string][]byte{
   179			"unsupported major": minimalValidConfigVersion(scalar.PlatformMacOS, "4.0.0"),
   180			"unsupported minor": minimalValidConfigVersion(scalar.PlatformMacOS, "3.1.0"),
   181			"wrong schema":      []byte("schema = \"urn:ax:schema:not-config\"\nschema_version = \"1.0.0\"\n"),
   182			"duplicate member":  append(minimalValidConfigVersion(scalar.PlatformMacOS, Version1), []byte("host_name = \"second\"\n")...),
   183			"partial read":      []byte("schema = \"urn:ax:schema:config\"\nschema_version = \"1.0.0\"\nhost_id ="),
   184		} {
   185			name, document := name, document
   186			t.Run(name, func(t *testing.T) {
   187				_, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)
   188				if err == nil {
   189					t.Fatalf("Load(%s) accepted invalid document", name)
   190				}
   191			})
   192		}
   193		t.Run("platform differs from runtime probe", func(t *testing.T) {
   194			_, err := loadConfigDocument(minimalValidConfigVersion(scalar.PlatformLinux, CurrentVersion), scalar.PlatformMacOS, nil)
   195			if !errors.Is(err, ErrConfigValidation) {
   196				t.Fatalf("Load(platform mismatch) error = %v, want ErrConfigValidation", err)
   197			}
   198		})
   199		t.Run("built-in backend unsupported on platform", func(t *testing.T) {
   200			document := append(minimalValidConfigVersion(scalar.PlatformWindows, CurrentVersion), []byte("\n[terminal]\nbackend_id = \"ax.tmux\"\n")...)
   201			_, err := Decode(document, DecodeContext{RuntimePlatform: scalar.PlatformWindows})
   202			if !errors.Is(err, ErrConfigValidation) {
   203				t.Fatalf("Load(ax.tmux on Windows) error = %v, want ErrConfigValidation", err)
   204			}
   205		})
