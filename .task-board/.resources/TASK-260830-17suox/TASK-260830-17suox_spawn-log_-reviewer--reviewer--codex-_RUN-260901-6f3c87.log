   380	
   381	func validateConfiguration(configuration *Configuration, context DecodeContext) error {
   382		if _, err := scalar.ParseUUIDv7(configuration.HostID); err != nil {
   383			return configError("host_id", errors.Join(ErrConfigValidation, err))
   384		}
   385		if err := validatePrintableCharacters(configuration.HostName, 1, 64); err != nil {
   386			return configError("host_name", err)
   387		}
   388		if configuration.Platform != context.RuntimePlatform {
   389			return configError("platform must match runtime probe", ErrConfigValidation)
   390		}
   391		if err := validateMesh(configuration); err != nil {
   392			return err
   393		}
   394		if err := validateWorkspaceRoots("workspace_roots", configuration.WorkspaceRoots, configuration.Platform, -1); err != nil {
   395			return err
   396		}
   397		if err := validateProviders(configuration); err != nil {
   398			return err
   399		}
   400		if err := validateSync(configuration.Sync); err != nil {
   401			return err
   402		}
   403		if err := validateDirectory(configuration); err != nil {
   404			return err
   405		}
   406		if err := validateTerminal(configuration, context); err != nil {
   407			return err
   408		}
   409		if !between(configuration.Service.HealthIntervalSeconds, 5, 3600) {
   410			return configError("service.health_interval_seconds", ErrConfigValidation)
   411		}
   412		return nil
   413	}
   414	
   415	func validateMesh(configuration *Configuration) error {
   416		mesh := configuration.Mesh
   417		if mesh.Transport != "ssh" {
   418			return configError("mesh.transport", ErrConfigValidation)
   419		}
   420		if !between(mesh.SyncIntervalSeconds, 5, 86_400) {
   421			return configError("mesh.sync_interval_seconds", ErrConfigValidation)
   422		}
   423		if !between(mesh.ConnectTimeoutSeconds, 1, 300) {
   424			return configError("mesh.connect_timeout_seconds", ErrConfigValidation)
   425		}
   426		if !between(mesh.RPCTimeoutSeconds, 10, 3_600) {
   427			return configError("mesh.rpc_timeout_seconds", ErrConfigValidation)
   428		}
   429		if mesh.PayloadEncryption != "none" {
   430			return configError("mesh.payload_encryption", ErrConfigValidation)
   431		}
   432		hostIDs, names := map[string]struct{}{}, map[string]struct{}{}
   433		for index, peer := range mesh.Peers {
   434			prefix := fmt.Sprintf("mesh.peers[%d]", index)
   435			if _, err := scalar.ParseUUIDv7(peer.HostID); err != nil {
   436				return configError(prefix+".host_id", errors.Join(ErrConfigValidation, err))
   437			}
   438			if _, exists := hostIDs[peer.HostID]; exists {
   439				return configError("mesh.peers duplicate host_id", ErrConfigValidation)
   440			}
   441			hostIDs[peer.HostID] = struct{}{}
   442			if err := validatePrintableCharacters(peer.Name, 1, 64); err != nil {
   443				return configError(prefix+".name", err)
   444			}
   445			if _, exists := names[peer.Name]; exists {
   446				return configError("mesh.peers duplicate name", ErrConfigValidation)
   447			}
   448			names[peer.Name] = struct{}{}
   449			if err := validatePrintableCharacters(peer.Endpoint, 1, 1024); err != nil {
   450				return configError(prefix+".endpoint", err)
   451			}
   452			if len(peer.SSHArgs) > 64 {
   453				return configError(prefix+".ssh_args", ErrConfigValidation)
   454			}
   455			totalBytes := len(peer.Endpoint)
   456			for _, argument := range peer.SSHArgs {
   457				if !utf8.ValidString(argument) || len(argument) < 1 || len(argument) > 4096 || strings.IndexByte(argument, 0) >= 0 {
   458					return configError(prefix+".ssh_args", ErrConfigValidation)
   459				}
   460				totalBytes += len(argument)
   461			}
   462			if totalBytes > 65_536 {
   463				return configError(prefix+" SSH argv bytes", ErrConfigValidation)
   464			}
   465			if sshHostAuthenticationBypass(peer.SSHArgs) {
   466				return configError(prefix+".ssh_args host authentication bypass", ErrConfigValidation)
   467			}
   468			if err := validateWorkspaceRoots(prefix+".workspace_roots", peer.WorkspaceRoots, peer.Platform, 64); err != nil {
   469				return err
   470			}
   471		}
   472		return nil
   473	}
   474	
   475	func validateWorkspaceRoots(prefix string, roots []WorkspaceRoot, platform scalar.Platform, max int) error {
   476		if max >= 0 && len(roots) > max {
   477			return configError(prefix, ErrConfigValidation)
   478		}
   479		seen := map[string]struct{}{}
   480		for index, root := range roots {
   481			if !logicalRootPattern.MatchString(root.LogicalRoot) {
   482				return configError(fmt.Sprintf("%s[%d].logical_root", prefix, index), ErrConfigValidation)
   483			}
   484			if _, exists := seen[root.LogicalRoot]; exists {
   485				return configError(prefix+" duplicate logical_root", ErrConfigValidation)
   486			}
   487			seen[root.LogicalRoot] = struct{}{}
   488			if _, err := scalar.ParseAbsolutePath(platform, root.Path); err != nil {
   489				return configError(fmt.Sprintf("%s[%d].path", prefix, index), errors.Join(ErrConfigValidation, err))
   490			}
   491		}
   492		return nil
   493	}
   494	
   495	func validateProviders(configuration *Configuration) error {
   496		for _, directory := range configuration.Providers.PluginDirs {
   497			if _, err := scalar.ParseAbsolutePath(configuration.Platform, directory); err != nil {
   498				return configError("providers.plugin_dirs", errors.Join(ErrConfigValidation, err))
   499			}
   500		}
   501		if !configuration.Providers.RequireExplicitTrust {
   502			return configError("providers.require_explicit_trust", ErrConfigValidation)
   503		}
   504		return nil
   505	}
   506	
   507	func validateSync(value Sync) error {
   508		if value.ChunkBytes != 4_194_304 {
   509			return configError("sync.chunk_bytes", ErrConfigValidation)
   510		}
   511		if !between(value.MaxParallelChunks, 1, 32) {
   512			return configError("sync.max_parallel_chunks", ErrConfigValidation)
   513		}
   514		if !between(value.StagingRetentionHours, 1, 720) {
   515			return configError("sync.staging_retention_hours", ErrConfigValidation)
   516		}
   517		if !between(value.TombstoneMinRetentionDays, 90, 3_650) {
   518			return configError("sync.tombstone_min_retention_days", ErrConfigValidation)
   519		}
   520		return nil
   521	}
   522	
   523	func validateDirectory(configuration *Configuration) error {
   524		directory := configuration.Directory
   525		if !oneOf(directory.Mode, "on_demand", "service") {
   526			return configError("directory.mode", ErrConfigValidation)
   527		}
   528		if !between(directory.ScanIntervalSeconds, 5, 86_400) {
   529			return configError("directory.scan_interval_seconds", ErrConfigValidation)
   530		}
   531		if !between(directory.ScanDebounceSeconds, 0, 3_600) {
   532			return configError("directory.scan_debounce_seconds", ErrConfigValidation)
   533		}
   534		if !between(directory.ScanConcurrency, 1, 32) {
   535			return configError("directory.scan_concurrency", ErrConfigValidation)
