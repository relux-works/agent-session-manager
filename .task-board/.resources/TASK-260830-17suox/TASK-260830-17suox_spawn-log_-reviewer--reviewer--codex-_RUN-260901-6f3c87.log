   420	func Decode(document []byte, context DecodeContext) (LoadedConfiguration, error) {
   421		if _, err := scalar.ParsePlatform(context.RuntimePlatform.String()); err != nil {
   422			return LoadedConfiguration{}, configError("platform", ErrConfigValidation)
   423		}
   424		var envelope rawEnvelope
   425		if err := toml.NewDecoder(bytes.NewReader(document)).Decode(&envelope); err != nil {
   426			return LoadedConfiguration{}, configError("TOML", errors.Join(ErrConfigDecode, err))
   427		}
   428		if envelope.Schema != SchemaID {
   429			return LoadedConfiguration{}, configError("schema", ErrConfigValidation)
   430		}
   431	
   432		var value Configuration
   433		var err error
   434		switch envelope.SchemaVersion {
   435		case Version1:
   436			var raw rawV1
   437			if err = decodeStrict(document, &raw); err == nil {
   438				value, err = translateV1(raw, context)
   439			}
   440		case Version2:
   441			var raw rawV2
   442			if err = decodeStrict(document, &raw); err == nil {
   443				value, err = translateV2(raw, context)
   444			}
   445		case CurrentVersion:
   446			var raw rawV3
   447			if err = decodeStrict(document, &raw); err == nil {
   448				value, err = translateV3(raw, context)
   449			}
   450		default:
   451			return LoadedConfiguration{}, configError("schema_version", ErrUnsupportedConfigVersion)
   452		}
   453		if err != nil {
   454			return LoadedConfiguration{}, err
   455		}
   456		return LoadedConfiguration{SourceVersion: envelope.SchemaVersion, Value: value}, nil
   457	}
   458	
   459	func decodeStrict(document []byte, destination any) error {
   460		decoder := toml.NewDecoder(bytes.NewReader(document)).DisallowUnknownFields()
   461		if err := decoder.Decode(destination); err != nil {
   462			return configError("closed TOML shape", errors.Join(ErrConfigDecode, err))
   463		}
   464		return nil
   465	}
