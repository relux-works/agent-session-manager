+`
+	snapshot, err = loadConfigDocument([]byte(v3), scalar.PlatformMacOS, exactBackendSettings{})
+	if err != nil {
+		t.Fatalf("Load(Configuration 3.0.0 exact terminal extension) error = %v", err)
