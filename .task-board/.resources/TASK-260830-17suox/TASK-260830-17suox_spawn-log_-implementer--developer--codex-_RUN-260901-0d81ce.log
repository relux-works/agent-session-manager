+		}
+		assertCurrentAccepted(t, bytesAt)
+		overSize := cloneConfiguration(bytesAt)
+		overSize.DirectoryInstallations[0].Extensions[key] = payload + "x"
+		assertCurrentRefused(t, overSize)
