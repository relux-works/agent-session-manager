+			_, err := loadConfigDocument(document, scalar.PlatformMacOS, nil)
+			if !errors.Is(err, ErrConfigValidation) {
+				t.Fatalf("Load(%s) error = %v, want ErrConfigValidation", name, err)
+			}
+		})
+	}
+}
