+extensions = { "works.relux.fixture" = { count = 1 } }
+
+[[directory_enrichment_profiles]]
+profile_id = "` + testDigest + `"
+enabled = true
+max_concurrency = 1
+metadata_policy = "local_only"
+extensions = {}
+
+[[directory_peer_disclosure]]
+host_id = "` + testPeerID + `"
