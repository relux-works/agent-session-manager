+	overArgument := peerPrefix + "ssh_args = [\"" + strings.Repeat("x", 4097) + "\"]\n"
+	if _, err := loadConfigDocument([]byte(overArgument), scalar.PlatformMacOS, nil); !errors.Is(err, ErrConfigValidation) {
