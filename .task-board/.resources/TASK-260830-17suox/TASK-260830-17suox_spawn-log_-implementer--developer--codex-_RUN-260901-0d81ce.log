+generated_summary_upgrade_choice = "local_only"
+default_enrichment_profile_id = "` + testDigest + `"
+query_page_default = 1
+query_page_max = 1
+query_batch_max = 1
+grep_result_max = 1
+transcript_grep_enabled = true
+embedding_index = "local_only"
