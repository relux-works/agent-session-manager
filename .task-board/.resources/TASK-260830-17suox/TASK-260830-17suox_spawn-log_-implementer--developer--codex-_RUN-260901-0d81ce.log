	resolved, ok := paths.Path(class)
	}
	if platform == scalar.PlatformLinux || platform == scalar.PlatformWSL2 {
		inputs.HomeDir = "/home/test"
		inputs.TempDir = "/tmp"
	}
	if platform == scalar.PlatformWindows {
		inputs.HomeDir = "C:\\Users\\test"
		inputs.TempDir = "C:\\Temp"
