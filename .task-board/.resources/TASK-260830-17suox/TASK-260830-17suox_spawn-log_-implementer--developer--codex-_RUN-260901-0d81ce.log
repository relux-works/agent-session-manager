+	if err != nil {
+		t.Fatalf("EncodeCurrent(all 16 closed capabilities) error = %v", err)
+	}
+	if _, err := loadConfigDocument(encoded, scalar.PlatformMacOS, nil); err != nil {
+		t.Fatalf("Load(all 16 closed capabilities) error = %v", err)
+	}
+}
