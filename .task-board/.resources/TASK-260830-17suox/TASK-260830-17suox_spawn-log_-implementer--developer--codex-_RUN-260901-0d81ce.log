+func TestLoadAcceptsExactV2DirectoryAndV3TerminalShapes(t *testing.T) {
+	t.Parallel()
+
+	v2 := string(minimalValidConfigVersion(scalar.PlatformMacOS, Version2)) + `
+[directory]
+enabled = true
+mode = "service"
+scan_interval_seconds = 5
