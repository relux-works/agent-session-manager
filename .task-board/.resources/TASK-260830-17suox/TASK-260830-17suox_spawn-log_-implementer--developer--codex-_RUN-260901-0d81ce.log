+endpoint = "b.example"
+platform = "linux"
+`,
+		"unsorted capabilities": `
+[terminal]
+required_capabilities = ["local_attach", "durable_disconnect"]
+`,
+		"duplicate backend trust": `
+[terminal]
+[[terminal.external_trust]]
+backend_id = "com.example.term"
+executable_path = "/opt/a"
+executable_digest = "` + testDigest + `"
