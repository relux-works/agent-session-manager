+		at.DirectoryInstallations[0].EnvironmentID = strings.Repeat("界", 64)
+		at.DirectoryInstallations[0].AdapterID = strings.Repeat("界", 64)
+		assertCurrentAccepted(t, at)
+		for name, mutate := range map[string]func(*Configuration){
