+	if snapshot.configuration == nil {
+		return LoadedConfiguration{}, false
+	}
+	return LoadedConfiguration{
+		SourceVersion: snapshot.configuration.SourceVersion,
+		Value:         cloneConfiguration(snapshot.configuration.Value),
+	}, true
+}
