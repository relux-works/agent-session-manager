+	loaded, _ = snapshot.Configuration()
+	if loaded.Value.Terminal.BackendID != "com.example.term" || len(loaded.Value.Terminal.BackendConfig) != 1 {
+		t.Fatalf("v3 terminal decode = %#v", loaded.Value.Terminal)
+	}
