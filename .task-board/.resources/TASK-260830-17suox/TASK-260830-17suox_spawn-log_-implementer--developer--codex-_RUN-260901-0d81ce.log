+	atArgument := peerPrefix + "ssh_args = [\"" + strings.Repeat("x", 4096) + "\"]\n"
+	if _, err := loadConfigDocument([]byte(atArgument), scalar.PlatformMacOS, nil); err != nil {
+		t.Fatalf("4096-byte SSH argument refused: %v", err)
