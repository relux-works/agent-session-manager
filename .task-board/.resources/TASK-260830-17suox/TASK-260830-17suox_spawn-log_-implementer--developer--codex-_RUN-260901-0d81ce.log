+		"unregistered backend settings": `
+[terminal]
+[[terminal.backend_config]]
+backend_id = "ax.tmux"
+config_version = "1.0.0"
+settings = {}
+`,
+	}
+	for name, suffix := range tests {
+		name, suffix := name, suffix
