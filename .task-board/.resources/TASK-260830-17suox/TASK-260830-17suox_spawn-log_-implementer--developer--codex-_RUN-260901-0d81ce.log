+func TestLoadRefusesSecurityBypassesDuplicatesAndUnknownBackendSettings(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]string{
+		"host-key bypass": `
+[[mesh.peers]]
+host_id = "` + testPeerID + `"
+name = "peer"
+endpoint = "peer.example"
+platform = "linux"
+ssh_args = ["-o", "StrictHostKeyChecking=no"]
+workspace_roots = []
+`,
+		"duplicate peer identity": `
+[[mesh.peers]]
+host_id = "` + testPeerID + `"
+name = "peer-a"
+endpoint = "a.example"
+platform = "linux"
+[[mesh.peers]]
+host_id = "` + testPeerID + `"
+name = "peer-b"
+endpoint = "b.example"
+platform = "linux"
+`,
+		"unsorted capabilities": `
