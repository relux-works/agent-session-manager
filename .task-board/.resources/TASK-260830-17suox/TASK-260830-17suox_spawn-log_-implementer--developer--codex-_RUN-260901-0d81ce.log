+
+	peerPrefix := string(minimalValidConfigVersion(scalar.PlatformMacOS, CurrentVersion)) + `
+[[mesh.peers]]
+host_id = "` + testPeerID + `"
+name = "peer"
+endpoint = "x"
+platform = "linux"
