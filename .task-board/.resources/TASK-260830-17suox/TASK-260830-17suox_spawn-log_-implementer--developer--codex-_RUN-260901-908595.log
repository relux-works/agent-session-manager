+			if err != nil {
+				t.Fatalf("marshal complete %s fixture: %v", path, err)
+			}
+			if _, err := loadConfigDocument(complete, scalar.PlatformMacOS, settings); err != nil {
+				t.Fatalf("complete %s fixture is not valid: %v", path, err)
+			}
+
+			testCase.omit(&raw)
+			omitted, err := toml.Marshal(raw)
+			if err != nil {
