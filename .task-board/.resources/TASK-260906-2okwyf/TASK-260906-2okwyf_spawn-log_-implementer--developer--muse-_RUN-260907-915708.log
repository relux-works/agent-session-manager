durably bound idempotency record: the canonical key, the\n470|// operation it was bound for, and the recorded result identity. AX and the\n471|// backend bind the pair before the first child side effect (§4.1); an\n472|// identical retry returns the recorded result instead of acting again.\n473|type Receipt struct {\n474|\tKey       string\n475|\tOperation Operation\n476|\tResultID  string\n477|}\n478|\n479|// Ledger is the process-local idempotency receipt table backing the §4.C\n480|// recovery rules: persist the receipt before the first side effect,\n481|// identical retry replays it, a changed operation in the window is\n482|// idempotency_mismatch, and uncertainty requires status before any start\n483|// retry. The zero value is unusable; construct with NewLedger.\n484|//\n485|// The ledger is the semantic half of durability: Export and Import move\n486|// the table across a controller crash as stable bytes, and Import refuses\n487|// a malformed or ambiguous image instead of inventing an empty table.\n488|type Ledger struct {\n489|\tmutex    sync.Mutex\n490|\treceipts map[string]Receipt\n491|}\n492|\n493|// NewLedger opens an empty receipt table.\n494|func NewLedger() *Ledger {\n495|\treturn &Ledger{receipts: make(map[string]Receipt)}\n496|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
