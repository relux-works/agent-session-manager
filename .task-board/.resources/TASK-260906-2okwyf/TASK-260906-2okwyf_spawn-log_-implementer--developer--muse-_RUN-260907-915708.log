{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d255","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":1925,"recorded_at":1780531400003845,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"5431a019-ca4c-4aaf-bcb5-bb7bdabc7373"},"task_id":"5431a019-ca4c-4aaf-bcb5-bb7bdabc7373","event":{"kind":"output","task_id":"5431a019-ca4c-4aaf-bcb5-bb7bdabc7373","chunk":"{\n  \"chunk_id\": \"exec-59-1\",\n  \"command\": \"cat > /tmp/mutants_r3.json <<'EOF'\\n[\\n  {\\n    \\\"id\\\": \\\"N-tb-reconcile-lengthgated\\\",\\n    \\\"file\\\": \\\"internal/terminalbackend/manifest.go\\\",\\n    \\\"class\\\": \\\"narrowing\\\",\\n    \\\"old\\\": \\\"\\\\tif _, err := ParseID(manifest.TerminalBackendID); err != nil {\\\\n\\\\t\\\\treturn Admitted{}, err\\\\n\\\\t}\\\\n\\\\tif _, err := ParseID(probe.TerminalBackendID); err != nil {\\\\n\\\\t\\\\treturn Admitted{}, err\\\\n\\\\t}\\\",\\n    \\\"new\\\": \\\"\\\\tif len(manifest.TerminalBackendID) > maxIDBytes {\\\\n\\\\t\\\\tif _, err := ParseID(manifest.TerminalBackendID); err != nil {\\\\n\\\\t\\\\t\\\\treturn Admitted{}, err\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif len(probe.TerminalBackendID) > maxIDBytes {\\\\n\\\\t\\\\tif _, err := ParseID(probe.TerminalBackendID); err != nil {\\\\n\\\\t\\\\t\\\\treturn Admitted{}, err\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\",\\n    \\\"expect\\\": \\\"narrowing: the entry gate stays but admits exactly the grammar-refused-but-bounded subclass (len27 short rows echo at the naming arms, len221 long rows still refuse at the bound). Killed by the census hostile battery split; inventory census SURVIVES (no refuse line added or removed).\\\",\\n    \\\"census_run\\\":