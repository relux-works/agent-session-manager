on file:line at runtime.Caller(skip+1): skip counts every\n84|// frame between Record and the site, including Record's own caller. A\n85|// record helper called from the swapped constructor var passes skip=2\n86|// (helper frame plus wrapper frame), matching the historical sync.Map\n87|// recorders' runtime.Caller(2) exactly.\n88|func (recorder *SiteRecorder) Record(code string, skip int) {\n89|\trecorder.mu.Lock()\n90|\tdefer recorder.mu.Unlock()\n91|\trecorder.codes[code] = struct{}{}\n92|\tif _, file, line, ok := runtime.Caller(skip + 1); ok {\n93|\t\trecorder.sites[filepath.Base(file)+\":\"+fmt.Sprint(line)] = struct{}{}\n94|\t}\n95|}\n96|\n97|// Snapshot returns deep copies of the exercised site and code sets for\n98|// tests that record bystander sites and must remove them before\n99|// returning, keeping the reverse-direction audit exact.\n100|func (recorder *SiteRecorder) Snapshot() (sites map[string]struct{}, codes map[string]struct{}) {\n101|\trecorder.mu.Lock()\n102|\tdefer recorder.mu.Unlock()\n103|\tsites = make(map[string]struct{}, len(recorder.sites))\n104|\tfor site := range recorder.sites {\n105|\t\tsites[site] = struct{}{}\n106|\t}\n107|\tcodes = make(map[string]struct{}, len(recorder.codes))\n108|\tfor code := range recorder.codes {\n109|\t\tcodes[code] = struct{}{}\n110|\t}\n111|\treturn sites, codes\n112|}\n113|\n114|// Restore resets the recorder to a prior snapshot, dropping every site\n115|// and code recorded since.\n116|func (recorder *SiteRecorder) Restore(sites map[string]struct{}, codes map[string]struct{}) {\n117|\trecorder.mu.Lock()\n118|\tdefer recorder.mu.Unlock()\n119|\trecorder.sites = make(map[string]struct{}, len(sites))\n120|\tfor site := range sites {\n121|\t\trecorder.sites[site] = struct{}{}\n122|\t}\n123|\trecorder.codes = make(map[string]struct{}, len(codes))\n124|\tfor code := range codes {\n125|\t\trecorder.codes[code] = struct{}{}\n126|\t}\n127|}\n128|\n129|// Sites returns the exercised production file:line set.\n130|func (recorder *SiteRecorder) Sites() map[string]struct{} {\n131|\trecorder.mu.Lock()\n132|\tdefer recorder.mu.Unlock()\n133|\tduplicated := make(map[string]struct{}, len(recorder.sites))\n134|\tfor site := range recorder.sites {\n135|\t\tduplicated[site] = struct{}{}\n136|\t}\n137|\treturn duplicated\n138|}\n139|\n140|// Codes returns the observed stable code set.\n141|func (recorder *SiteRecorder) Codes() []string {\n142|\trecorder.mu.Lock()\n143|\tdefer recorder.mu.Unlock()\n144|\tvar codes []string\n145|\tfor code := range recorder.codes {\n146|\t\tcodes = append(codes, code)\n147|\t}\n148|\tsort.Strings(codes)\n149|\treturn codes\n150|}\n151|\n152|// AuditSites compares the exercised set against the derived site set in\n153|// both directions and the observed codes against the closed set, returning\n154|// one failure per violated direction. Empty scanned or derived input fails\n155|// closed: a blind scan is not a measurement.\n156|func (recorder *SiteRecorder) AuditSites(what string, scanned int, derived map[string]struct{}, wantCodes []string) []string {\n157|\tvar failures []string\n158|\tif scanned == 0 {\n159|\t\tfailures = append(failures, what+\": scanned no production sources; the check is blind\")\n160|\t}\n161|\tif len(derived) == 0 {\n162|\t\tfailures = append(failures, what+\": derived no refusal sites; the scan is blind\")\n163|\t}\n164|\texercised := recorder.Sites()\n165|\tvar outside []string\n166|\tfor site := range exercised {\n167|\t\tif _, ok := derived[site]; !ok {\n168|\t\t\toutside = append(outside, site)\n169|\t\t}\n170|\t}\n171|\tsort.Strings(outside)\n172|\tif len(outside) != 0 {\n173|\t\tfailures = append(failures, what+\": exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n174|\t}\n175|\tvar missing []string\n176|\tfor site := range derived {\n177|\t\tif _, ok := exercised[site]; !ok {\n178|\t\t\tmissing = append(missing, site)\n179|\t\t}\n180|\t}\n181|\tsort.Strings(missing)\n182|\tif len(missing) != 0 {\n183|\t\tfailures = append(failures, what+\": derived refusal sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n184|\t}\n185|\tcodes := recorder.Codes()\n186|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", wantCodes) {\n187|\t\tfailures = append(failures, fmt.Sprintf(\"%s: observed refusal codes = %v, want closed set %v\", what, codes, wantCodes))\n188|\t}\n189|\treturn failures\n190|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
