{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"7195201f-e367-404c-bc82-03efa557a30c"},"task_id":"7195201f-e367-404c-bc82-03efa557a30c","event":{"kind":"output","task_id":"7195201f-e367-404c-bc82-03efa557a30c","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(249 line(s) above)\n250|\t}\n251|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n252|\t\treturn err\n253|\t}\n254|\tif err := validatePlatforms(record.Platforms); err != nil {\n255|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()})\n256|\t}\n257|\tif needsDigest(record.Kind) {\n258|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n259|\t\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"})\n260|\t\t}\n261|\t} else if record.ExecutableDigest != \"\" {\n262|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"})\n263|\t}\n264|\treturn nil\n265|}\n266|\n267|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n268|// Terminal Backend Protocol major 1.\n269|func validateProtocolVersions(backendID string, versions []string) error {\n270|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n271|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"})\n272|\t}\n273|\tfor index, version := range versions {\n274|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n275|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"})\n276|\t\t}\n277|\t\tif index > 0 && versions[index-1] >= version {\n278|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"})\n279|\t\t}\n280|\t}\n281|\treturn nil\n282|}\n283|\n284|// semverMajor returns the major number of a validated semver string.\n285|// A major that does not fit an int saturates instead of wrapping, so a\n286|// huge foreign major compares foreign at every != 1 call site rather\n287|// than aliasing a small native one (18446744073709551617 must not read\n288|// as 1). Saturation preserves every comparison against the small\n289|// constants the call sites use, in the correct direction.\n290|func semverMajor(version string) int {\n291|\tmajor := 0\n292|\tfor i := 0; i < len(version); i++ {\n293|\t\tif version[i] == '.' {\n294|\t\t\tbreak\n295|\t\t}\n296|\t\tdigit := int(version[i] - '0')\n297|\t\tif major > (math.MaxInt-digit)/10 {\n298|\t\t\treturn math.MaxInt\n299|\t\t}\n300|\t\tmajor = major*10 + digit\n301|\t}\n302|\treturn major\n303|}\n304|\n305|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n306|// macos|linux|wsl2|windows vocabulary.\n307|func validatePlatforms(platforms []scalar.Platform) error {\n308|\tif len(platforms) == 0 || len(platforms) > 4 {\n309|\t\treturn errors.New(\"platforms bound\")\n310|\t}\n311|\tprevious := \"\"\n312|\tfor _, platform := range platforms {\n313|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n314|\t\t\treturn errors.New(\"platforms vocabulary\")\n315|\t\t}\n316|\t\tif previous >= platform.String() {\n317|\t\t\treturn errors.New(\"platforms sorted unique\")\n318|\t\t}\n319|\t\tprevious = platform.String()\n320|\t}\n321|\treturn nil\n322|}\n323|\n324|// cloneStrings deep-copies a version list so the registry never shares a\n325|// backing array with its caller. Registration carries slices; a struct copy\n326|// duplicates only the header, so every ingress and egress point must clone.\n327|func cloneStrings(values []string) []string {\n328|\tif values == nil {\n329|\t\treturn nil\n330|\t}\n331|\tcloned := make([]string, len(values))\n332|\tcopy(cloned, values)\n333|\treturn cloned\n334|}\n335|\n336|// clonePlatforms deep-copies a platform set for the same reason as\n337|// cloneStrings: without it a caller holding a resolved record keeps a live\n338|// handle on admitted registry state and can convert drift into a duplicate.\n339|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n340|\tif values == nil {\n341|\t\treturn nil\n342|\t}\n343|\tcloned := make([]scalar.Platform, len(values))\n344|\tcopy(cloned, values)\n345|\treturn cloned\n346|}\n347|\n348|// cloneRecord deep-copies every slice member of a record.\n349|func cloneRecord(record Registration) Registration {\n350|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n351|\trecord.Platforms = clonePlatforms(record.Platforms)\n352|\treturn record\n353|}\n354|\n355|// equalRecord reports whether two validated records are member-for-member\n356|// identical. Any difference is drift, never a compatible update.\n357|func equalRecord(left, right Registration) bool {\n358|\tif left.ID != right.ID || left.Kind != right.Kind ||\n359|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n360|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n361|\t\treturn false\n362|\t}\n363|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n364|\t\treturn false\n365|\t}\n366|\tfor i := range left.ProtocolVersions {\n367|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n368|\t\t\treturn false\n369|\t\t}\n370|\t}\n371|\tif len(left.Platforms) != len(right.Platforms) {\n372|\t\treturn false\n373|\t}\n374|\tfor i := range left.Platforms {\n375|\t\tif left.Platforms[i] != right.Platforms[i] {\n376|\t\t\treturn false\n377|\t\t}\n378|\t}\n379|\treturn true\n380|}\n381|\n382|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n383|// backend ID, an absolute executable path, an executable digest, and enabled.\n384|type TrustEntry struct {\n385|\tBackendID        string\n386|\tExecutablePath   string\n387|\tExecutableDigest string\n388|\tEnabled          bool\n389|}\n390|\n391|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n392|// reserved-namespace bar (third parties use a vendor-owned namespace),\n393|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n394|// A disabled entry is not an error here; registration treats it as untrusted.\n395|func (entry TrustEntry) validate(platform scalar.Platform) error {\n396|\tif err := mustParseID(entry.BackendID); err != nil {\n397|\t\treturn err\n398|\t}\n399|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n400|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"})\n401|\t}\n402|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n403|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"})\n404|\t}\n405|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n406|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"})\n407|\t}\n408|\treturn nil\n409|}\n410|\n411|// Registry is the process-local TerminalBackend registry. It opens with the\n412|// two canonical built-ins admitted and accepts external adapters only through\n413|// RegisterExternal with a validated trust entry. The zero value is unusable;\n414|// construct with New.\n415|type Registry struct {\n416|\tmutex   sync.RWMutex\n417|\trecords map[string]Registration\n418|}\n419|\n420|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n421|// ax.conpty (windows) at the given implementation version with the given\n422|// Terminal Backend Protocol versions. Both are builtin_go without an\n423|// executable digest. Unknown members or a non-major-1 protocol list fail\n424|// before either built-in is admitted.\n425|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n426|\tif !semverPattern.MatchString(implementationVersion) {\n427|\t\treturn nil, refuse(&Error{Code: CodeDrift, Detail: \"implementation_version semver\"})\n428|\t}\n429|\tprotocols := append([]string(nil), protocolVersions...)\n430|\tsort.Strings(protocols)\n431|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n432|\t\treturn nil, err\n433|\t}\n434|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n435|\tbuiltins := []Registration{\n436|\t\t{\n437|\t\t\tID:                    BuiltinTmux,\n438|\t\t\tKind:                  KindBuiltinGo,\n439|\t\t\tImplementationVersion: implementationVersion,\n440|\t\t\t// Each built-in gets its own copy so the two admitted records\n441|\t\t\t// never alias each other. This is defence-in-depth, not a\n442|\t\t\t// bypass fix: callers only ever see egress clones (Resolve\n443|\t\t\t// clones, RegisterExternal clones on ingress, IDs returns\n444|\t\t\t// strings), so no exported path can reach these arrays.\n445|\t\t\tProtocolVersions: cloneStrings(protocols),\n446|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n447|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n448|\t\t},\n449|\t\t{\n450|\t\t\tID:                    BuiltinConpty,\n451|\t\t\tKind:                  KindBuiltinGo,\n452|\t\t\tImplementationVersion: implementationVersion,\n453|\t\t\tProtocolVersions:      cloneStrings(protocols),\n454|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n455|\t\t},\n456|\t}\n457|\tfor _, record := range builtins {\n458|\t\tif err := record.validate(); err != nil {\n459|\t\t\treturn nil, err\n460|\t\t}\n461|\t\tregistry.records[record.ID] = record\n462|\t}\n463|\treturn registry, nil\n464|}\n465|\n466|// RegisterExternal admits one external adapter (§4.B discovery before\n467|// activation, §6.5 trust). The trust entry must be enabled and name an\n468|// absolute executable whose digest exactly equals the observed record digest;\n469|// a mismatch fails before any probe. The observed record must use an external\n470|// kind, carry the same ID, and pass full record validation. Registering an\n471|// already-known ID fails closed: an identical record is CodeAmbiguous\n472|// (registration is not idempotent) and any difference is CodeDrift.\n473|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n474|\tif registry == nil {\n475|\t\treturn refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n476|\t}\n477|\tif err := entry.validate(platform); err != nil {\n478|\t\treturn err\n479|\t}\n480|\tif !entry.Enabled {\n481|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"})\n482|\t}\n483|\tif observed.ID != entry.BackendID {\n484|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"})\n485|\t}\n486|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n487|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"})\n488|\t}\n489|\tif err := observed.validate(); err != nil {\n490|\t\treturn err\n491|\t}\n492|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n493|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"})\n494|\t}\n495|\tregistry.mutex.Lock()\n496|\tdefer registry.mutex.Unlock()\n497|\texisting, known := registry.records[observed.ID]\n498|\tif !known {\n499|\t\t// Store a copy: the caller keeps its own record, and retaining\n500|\t\t// the slices verbatim would leave the admitted record mutable\n501|\t\t// without passing any gate.\n502|\t\tregistry.records[observed.ID] = cloneRecord(observed)\n503|\t\treturn nil\n504|\t}\n505|\tif equalRecord(existing, observed) {\n506|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \"duplicate backend_id\"})\n507|\t}\n508|\treturn refuse(&Error{Code: CodeDrift, BackendID: observed.ID, Detail: \"implementation drift\"})\n509|}\n510|\n511|// Resolve returns the admitted record for a canonical ID. An unknown,\n512|// malformed, or never-admitted ID is CodeNotFound: a registry read failure is\n513|// never absence, and callers must not fall back to a default.\n514|func (registry *Registry) Resolve(backendID string) (Registration, error) {\n515|\tif registry == nil {\n516|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n517|\t}\n518|\tid, err := ParseID(backendID)\n519|\tif err != nil {\n520|\t\treturn Registration{}, err\n521|\t}\n522|\tregistry.mutex.RLock()\n523|\tdefer registry.mutex.RUnlock()\n524|\trecord, known := registry.records[id]\n525|\tif !known {\n526|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, BackendID: id, Detail: \"unregistered terminal_backend_id\"})\n527|\t}\n528|\t// Hand back a copy: the struct header copy shares the backing arrays,\n529|\t// so returning the stored record would hand out live interior state.\n530|\treturn cloneRecord(record), nil\n531|}\n532|\n533|// IDs returns the sorted admitted identities. It reports membership only,\n534|// never availability.\n535|func (registry *Registry) IDs() []string {\n536|\tif registry == nil {\n537|\t\treturn nil\n538|\t}\n539|\tregistry.mutex.RLock()\n540|\tdefer registry.mutex.RUnlock()\n541|\tids := make([]string, 0, len(registry.records))\n542|\tfor id := range registry.records {\n543|\t\tids = append(ids, id)\n544|\t}\n545|\tsort.Strings(ids)\n546|\treturn ids\n547|}\n548|\n549|// DefaultForPlatform returns the platform default for new activation (§6.5):\n550|// ax.tmux on macos/linux/wsl2 and ax.conpty on windows. Defaults select only\n551|// a new Terminal Instance; restore and resume must use RequireRestoreBinding.\n552|func DefaultForPlatform(platform scalar.Platform) (string, error) {\n553|\tswitch platform {\n554|\tcase scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2:\n555|\t\treturn BuiltinTmux, nil\n556|\tcase scalar.PlatformWindows:\n557|\t\treturn BuiltinConpty, nil\n558|\tdefault:\n559|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"platform vocabulary\"})\n560|\t}\n561|}\n562|\n563|// RequireRestoreBinding resolves the exact prior binding for restore or\n564|// resume (§4.B, §6.5). The candidate must equal the bound backend ID; using\n565|// the current configured default instead is CodeRestoreMismatch. The bound ID\n566|// must be registered: unknown or unsupported IDs remain visible but cannot\n567|// activate.\n568|func (registry *Registry) RequireRestoreBinding(boundBackendID, candidateBackendID string) (Registration, error) {\n569|\tif registry == nil {\n570|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n571|\t}\n572|\tbound, err := ParseID(boundBackendID)\n573|\tif err != nil {\n574|\t\treturn Registration{}, err\n575|\t}\n576|\tcandidate, err := ParseID(candidateBackendID)\n577|\tif err != nil {\n578|\t\treturn Registration{}, err\n579|\t}\n580|\tif candidate != bound {\n581|\t\treturn Registration{}, refuse(&Error{Code: CodeRestoreMismatch, BackendID: candidate, Detail: \"restore requires the prior binding\"})\n582|\t}\n583|\treturn registry.Resolve(bound)\n584|}\n585|\n586|// CheckVersionTuple admits one (implementation_version, protocol_version)\n587|// pair against the admitted protocol list: the implementation must be\n588|// semver, the protocol must be semver in Terminal Backend Protocol major 1\n589|// and exactly one member of the list. Array-to-scalar selection is\n590|// membership, not aggregate equality (§4.B).\n591|//\n592|// The backend ID is validated through ParseID before any version arm runs,\n593|// like RequireRestoreBinding and CheckProviderDescriptor already do: the\n594|// three version arms below name the ID, so an unvalidated parameter would\n595|// echo grammar-refused input (terminal escapes, traversal content,\n596|// over-long bytes) into the refusal. A refused ID returns the ParseID\n597|// refusal — whose bound and grammar arms carry no BackendID — and never\n598|// reaches the version arms.\n599|func CheckVersionTuple(backendID, implementationVersion, protocolVersion string, protocolVersions []string) error {\n600|\tif _, err := ParseID(backendID); err != nil {\n601|\t\treturn err\n602|\t}\n603|\tif !semverPattern.MatchString(implementationVersion) {\n604|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"implementation_version semver\"})\n605|\t}\n606|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n607|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version major 1\"})\n608|\t}\n609|\tfor _, member := range protocolVersions {\n610|\t\tif protocolVersion == member {\n611|\t\t\treturn nil\n612|\t\t}\n613|\t}\n614|\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version membership\"})\n615|}\n616|\n617|// InstanceBinding is the validated host-local binding subset a §7.A provider\n618|// descriptor must match: binding digest, backend ID, versions, and generation\n619|// (SPEC.md §7.A). TerminalBindingID is the digest of the validated Terminal\n620|// Instance Binding 1.0.0 carried as terminal_binding_id (SPEC.md:3461).\n621|type InstanceBinding struct {\n622|\tBackendID             string\n623|\tImplementationVersion string\n624|\tProtocolVersion       string\n625|\tGeneration            string\n626|\tTerminalBindingID     string\n627|}\n628|\n629|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n630|// a descriptor whose binding digest, backend ID, versions, or generation does\n631|// not match the AX-validated host-local binding before launching or observing\n632|// a provider process. Generation lengths 0 and over 256 UTF-8 characters are\n633|// invalid; 256 is accepted.\n634|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n635|\tif err := checkGeneration(descriptor.Generation); err != nil {\n636|\t\treturn err\n637|\t}\n638|\tif err := checkGeneration(binding.Generation); err != nil {\n639|\t\treturn err\n640|\t}\n641|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n642|\t\treturn err\n643|\t}\n644|\tif descriptor.BackendID != binding.BackendID {\n645|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"})\n646|\t}\n647|\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\n648|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n649|\t}\n650|\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\n651|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n652|\t}\n653|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n654|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n655|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"})\n656|\t}\n657|\tif descriptor.Generation != binding.Generation {\n658|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"})\n659|\t}\n660|\treturn nil\n661|}\n662|\n663|// checkGeneration enforces string[1..256] measured in UTF-8 characters over\n664|// valid UTF-8 (SPEC.md:321).\n665|func checkGeneration(generation string) error {\n666|\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\n667|\t\treturn refuse(&Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"})\n668|\t}\n669|\treturn nil\n670|}\n671|\n672|// DigestFile returns the sha256: digest of the executable at path after\n673|// resolving symlinks. The target must be a regular file; anything else (or a\n674|// read failure) is an error, never a digest. It distinguishes a failed read\n675|// from an absent trust entry: callers must not fall back to PATH discovery.\n676|//\n677|// Trust here is Section 6.5 external_trust: the closed entry carries\n678|// exactly backend ID, absolute executable path, executable digest, and\n679|// enabled — there is no owner member, so no owner check applies. That\n680|// differs deliberately from provider trust under Section 7.1, which\n681|// requires the target be owned by the operator or an\n682|// administrator-approved identity (see provider.trustCandidate). The\n683|// symlink-resolution and regular-file steps mirror Section 7.1's\n684|// mechanics; the missing owner dimension is contractual — the closed\n685|// entry leaves no member to record an owner in — not drift. Do not add\n686|// an owner check here without a spec change, and do not read this\n687|// function as the provider trust path.\n688|func DigestFile(path string) (string, error) {\n689|\tresolved, err := filepath.EvalSymlinks(path)\n690|\tif err != nil {\n691|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n692|\t}\n693|\tinfo, err := os.Stat(resolved)\n694|\tif err != nil {\n695|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n696|\t}\n697|\tif !info.Mode().IsRegular() {\n698|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n699|\t}\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c529","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":239,"recorded_at":1780531400000473,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"7195201f-e367-404c-bc82-03efa557a30c"},"task_id":"7195201f-e367-404c-bc82-03efa557a30c","event":{"kind":"completed","task_id":"7195201f-e367-404c-bc82-03efa557a30c"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52b","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":240,"recorded_at":1780531400000475,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"call_id":"call_01a07a5f20497d72904f3f9398af2171","text":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(249 line(s) above)\n250|\t}\n251|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n252|\t\treturn err\n253|\t}\n254|\tif err := validatePlatforms(record.Platforms); err != nil {\n255|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()})\n256|\t}\n257|\tif needsDigest(record.Kind) {\n258|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n259|\t\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"})\n260|\t\t}\n261|\t} else if record.ExecutableDigest != \"\" {\n262|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"})\n263|\t}\n264|\treturn nil\n265|}\n266|\n267|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n268|// Terminal Backend Protocol major 1.\n269|func validateProtocolVersions(backendID string, versions []string) error {\n270|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n271|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"})\n272|\t}\n273|\tfor index, version := range versions {\n274|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n275|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"})\n276|\t\t}\n277|\t\tif index > 0 && versions[index-1] >= version {\n278|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"})\n279|\t\t}\n280|\t}\n281|\treturn nil\n282|}\n283|\n284|// semverMajor returns the major number of a validated semver string.\n285|// A major that does not fit an int saturates instead of wrapping, so a\n286|// huge foreign major compares foreign at every != 1 call site rather\n287|// than aliasing a small native one (18446744073709551617 must not read\n288|// as 1). Saturation preserves every comparison against the small\n289|// constants the call sites use, in the correct direction.\n290|func semverMajor(version string) int {\n291|\tmajor := 0\n292|\tfor i := 0; i < len(version); i++ {\n293|\t\tif version[i] == '.' {\n294|\t\t\tbreak\n295|\t\t}\n296|\t\tdigit := int(version[i] - '0')\n297|\t\tif major > (math.MaxInt-digit)/10 {\n298|\t\t\treturn math.MaxInt\n299|\t\t}\n300|\t\tmajor = major*10 + digit\n301|\t}\n302|\treturn major\n303|}\n304|\n305|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n306|// macos|linux|wsl2|windows vocabulary.\n307|func validatePlatforms(platforms []scalar.Platform) error {\n308|\tif len(platforms) == 0 || len(platforms) > 4 {\n309|\t\treturn errors.New(\"platforms bound\")\n310|\t}\n311|\tprevious := \"\"\n312|\tfor _, platform := range platforms {\n313|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n314|\t\t\treturn errors.New(\"platforms vocabulary\")\n315|\t\t}\n316|\t\tif previous >= platform.String() {\n317|\t\t\treturn errors.New(\"platforms sorted unique\")\n318|\t\t}\n319|\t\tprevious = platform.String()\n320|\t}\n321|\treturn nil\n322|}\n323|\n324|// cloneStrings deep-copies a version list so the registry never shares a\n325|// backing array with its caller. Registration carries slices; a struct copy\n326|// duplicates only the header, so every ingress and egress point must clone.\n327|func cloneStrings(values []string) []string {\n328|\tif values == nil {\n329|\t\treturn nil\n330|\t}\n331|\tcloned := make([]string, len(values))\n332|\tcopy(cloned, values)\n333|\treturn cloned\n334|}\n335|\n336|// clonePlatforms deep-copies a platform set for the same reason as\n337|// cloneStrings: without it a caller holding a resolved record keeps a live\n338|// handle on admitted registry state and can convert drift into a duplicate.\n339|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n340|\tif values == nil {\n341|\t\treturn nil\n342|\t}\n343|\tcloned := make([]scalar.Platform, len(values))\n344|\tcopy(cloned, values)\n345|\treturn cloned\n346|}\n347|\n348|// cloneRecord deep-copies every slice member of a record.\n349|func cloneRecord(record Registration) Registration {\n350|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n351|\trecord.Platforms = clonePlatforms(record.Platforms)\n352|\treturn record\n353|}\n354|\n355|// equalRecord reports whether two validated records are member-for-member\n356|// identical. Any difference is drift, never a compatible update.\n357|func equalRecord(left, right Registration) bool {\n358|\tif left.ID != right.ID || left.Kind != right.Kind ||\n359|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n360|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n361|\t\treturn false\n362|\t}\n363|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n364|\t\treturn false\n365|\t}\n366|\tfor i := range left.ProtocolVersions {\n367|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n368|\t\t\treturn false\n369|\t\t}\n370|\t}\n371|\tif len(left.Platforms) != len(right.Platforms) {\n372|\t\treturn false\n373|\t}\n374|\tfor i := range left.Platforms {\n375|\t\tif left.Platforms[i] != right.Platforms[i] {\n376|\t\t\treturn false\n377|\t\t}\n378|\t}\n379|\treturn true\n380|}\n381|\n382|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n383|// backend ID, an absolute executable path, an executable digest, and enabled.\n384|type TrustEntry struct {\n385|\tBackendID        string\n386|\tExecutablePath   string\n387|\tExecutableDigest string\n388|\tEnabled          bool\n389|}\n390|\n391|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n392|// reserved-namespace bar (third parties use a vendor-owned namespace),\n393|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n394|// A disabled entry is not an error here; registration treats it as untrusted.\n395|func (entry TrustEntry) validate(platform scalar.Platform) error {\n396|\tif err := mustParseID(entry.BackendID); err != nil {\n397|\t\treturn err\n398|\t}\n399|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n400|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"})\n401|\t}\n402|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n403|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"})\n404|\t}\n405|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n406|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"})\n407|\t}\n408|\treturn nil\n409|}\n410|\n411|// Registry is the process-local TerminalBackend registry. It opens with the\n412|// two canonical built-ins admitted and accepts external adapters only through\n413|// RegisterExternal with a validated trust entry. The zero value is unusable;\n414|// construct with New.\n415|type Registry struct {\n416|\tmutex   sync.RWMutex\n417|\trecords map[string]Registration\n418|}\n419|\n420|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n421|// ax.conpty (windows) at the given implementation version with the given\n422|// Terminal Backend Protocol versions. Both are builtin_go without an\n423|// executable digest. Unknown members or a non-major-1 protocol list fail\n424|// before either built-in is admitted.\n425|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n426|\tif !semverPattern.MatchString(implementationVersion) {\n427|\t\treturn nil, refuse(&Error{Code: CodeDrift, Detail: \"implementation_version semver\"})\n428|\t}\n429|\tprotocols := append([]string(nil), protocolVersions...)\n430|\tsort.Strings(protocols)\n431|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n432|\t\treturn nil, err\n433|\t}\n434|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n435|\tbuiltins := []Registration{\n436|\t\t{\n437|\t\t\tID:                    BuiltinTmux,\n438|\t\t\tKind:                  KindBuiltinGo,\n439|\t\t\tImplementationVersion: implementationVersion,\n440|\t\t\t// Each built-in gets its own copy so the two admitted records\n441|\t\t\t// never alias each other. This is defence-in-depth, not a\n442|\t\t\t// bypass fix: callers only ever see egress clones (Resolve\n443|\t\t\t// clones, RegisterExternal clones on ingress, IDs returns\n444|\t\t\t// strings), so no exported path can reach these arrays.\n445|\t\t\tProtocolVersions: cloneStrings(protocols),\n446|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n447|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n448|\t\t},\n449|\t\t{\n450|\t\t\tID:                    BuiltinConpty,\n451|\t\t\tKind:                  KindBuiltinGo,\n452|\t\t\tImplementationVersion: implementationVersion,\n453|\t\t\tProtocolVersions:      cloneStrings(protocols),\n454|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n455|\t\t},\n456|\t}\n457|\tfor _, record := range builtins {\n458|\t\tif err := record.validate(); err != nil {\n459|\t\t\treturn nil, err\n460|\t\t}\n461|\t\tregistry.records[record.ID] = record\n462|\t}\n463|\treturn registry, nil\n464|}\n465|\n466|// RegisterExternal admits one external adapter (§4.B discovery before\n467|// activation, §6.5 trust). The trust entry must be enabled and name an\n468|// absolute executable whose digest exactly equals the observed record digest;\n469|// a mismatch fails before any probe. The observed record must use an external\n470|// kind, carry the same ID, and pass full record validation. Registering an\n471|// already-known ID fails closed: an identical record is CodeAmbiguous\n472|// (registration is not idempotent) and any difference is CodeDrift.\n473|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n474|\tif registry == nil {\n475|\t\treturn refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n476|\t}\n477|\tif err := entry.validate(platform); err != nil {\n478|\t\treturn err\n479|\t}\n480|\tif !entry.Enabled {\n481|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"})\n482|\t}\n483|\tif observed.ID != entry.BackendID {\n484|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"})\n485|\t}\n486|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n487|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"})\n488|\t}\n489|\tif err := observed.validate(); err != nil {\n490|\t\treturn err\n491|\t}\n492|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n493|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"})\n494|\t}\n495|\tregistry.mutex.Lock()\n496|\tdefer registry.mutex.Unlock()\n497|\texisting, known := registry.records[observed.ID]\n498|\tif !known {\n499|\t\t// Store a copy: the caller keeps its own record, and retaining\n500|\t\t// the slices verbatim would leave the admitted record mutable\n501|\t\t// without passing any gate.\n502|\t\tregistry.records[observed.ID] = cloneRecord(observed)\n503|\t\treturn nil\n504|\t}\n505|\tif equalRecord(existing, observed) {\n506|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \"duplicate backend_id\"})\n507|\t}\n508|\treturn refuse(&Error{Code: CodeDrift, BackendID: observed.ID, Detail: \"implementation drift\"})\n509|}\n510|\n511|// Resolve returns the admitted record for a canonical ID. An unknown,\n512|// malformed, or never-admitted ID is CodeNotFound: a registry read failure is\n513|// never absence, and callers must not fall back to a default.\n514|func (registry *Registry) Resolve(backendID string) (Registration, error) {\n515|\tif registry == nil {\n516|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n517|\t}\n518|\tid, err := ParseID(backendID)\n519|\tif err != nil {\n520|\t\treturn Registration{}, err\n521|\t}\n522|\tregistry.mutex.RLock()\n523|\tdefer registry.mutex.RUnlock()\n524|\trecord, known := registry.records[id]\n525|\tif !known {\n526|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, BackendID: id, Detail: \"unregistered terminal_backend_id\"})\n527|\t}\n528|\t// Hand back a copy: the struct header copy shares the backing arrays,\n529|\t// so returning the stored record would hand out live interior state.\n530|\treturn cloneRecord(record), nil\n531|}\n532|\n533|// IDs returns the sorted admitted identities. It reports membership only,\n534|// never availability.\n535|func (registry *Registry) IDs() []string {\n536|\tif registry == nil {\n537|\t\treturn nil\n538|\t}\n539|\tregistry.mutex.RLock()\n540|\tdefer registry.mutex.RUnlock()\n541|\tids := make([]string, 0, len(registry.records))\n542|\tfor id := range registry.records {\n543|\t\tids = append(ids, id)\n544|\t}\n545|\tsort.Strings(ids)\n546|\treturn ids\n547|}\n548|\n549|// DefaultForPlatform returns the platform default for new activation (§6.5):\n550|// ax.tmux on macos/linux/wsl2 and ax.conpty on windows. Defaults select only\n551|// a new Terminal Instance; restore and resume must use RequireRestoreBinding.\n552|func DefaultForPlatform(platform scalar.Platform) (string, error) {\n553|\tswitch platform {\n554|\tcase scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2:\n555|\t\treturn BuiltinTmux, nil\n556|\tcase scalar.PlatformWindows:\n557|\t\treturn BuiltinConpty, nil\n558|\tdefault:\n559|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"platform vocabulary\"})\n560|\t}\n561|}\n562|\n563|// RequireRestoreBinding resolves the exact prior binding for restore or\n564|// resume (§4.B, §6.5). The candidate must equal the bound backend ID; using\n565|// the current configured default instead is CodeRestoreMismatch. The bound ID\n566|// must be registered: unknown or unsupported IDs remain visible but cannot\n567|// activate.\n568|func (registry *Registry) RequireRestoreBinding(boundBackendID, candidateBackendID string) (Registration, error) {\n569|\tif registry == nil {\n570|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n571|\t}\n572|\tbound, err := ParseID(boundBackendID)\n573|\tif err != nil {\n574|\t\treturn Registration{}, err\n575|\t}\n576|\tcandidate, err := ParseID(candidateBackendID)\n577|\tif err != nil {\n578|\t\treturn Registration{}, err\n579|\t}\n580|\tif candidate != bound {\n581|\t\treturn Registration{}, refuse(&Error{Code: CodeRestoreMismatch, BackendID: candidate, Detail: \"restore requires the prior binding\"})\n582|\t}\n583|\treturn registry.Resolve(bound)\n584|}\n585|\n586|// CheckVersionTuple admits one (implementation_version, protocol_version)\n587|// pair against the admitted protocol list: the implementation must be\n588|// semver, the protocol must be semver in Terminal Backend Protocol major 1\n589|// and exactly one member of the list. Array-to-scalar selection is\n590|// membership, not aggregate equality (§4.B).\n591|//\n592|// The backend ID is validated through ParseID before any version arm runs,\n593|// like RequireRestoreBinding and CheckProviderDescriptor already do: the\n594|// three version arms below name the ID, so an unvalidated parameter would\n595|// echo grammar-refused input (terminal escapes, traversal content,\n596|// over-long bytes) into the refusal. A refused ID returns the ParseID\n597|// refusal — whose bound and grammar arms carry no BackendID — and never\n598|// reaches the version arms.\n599|func CheckVersionTuple(backendID, implementationVersion, protocolVersion string, protocolVersions []string) error {\n600|\tif _, err := ParseID(backendID); err != nil {\n601|\t\treturn err\n602|\t}\n603|\tif !semverPattern.MatchString(implementationVersion) {\n604|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"implementation_version semver\"})\n605|\t}\n606|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n607|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version major 1\"})\n608|\t}\n609|\tfor _, member := range protocolVersions {\n610|\t\tif protocolVersion == member {\n611|\t\t\treturn nil\n612|\t\t}\n613|\t}\n614|\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version membership\"})\n615|}\n616|\n617|// InstanceBinding is the validated host-local binding subset a §7.A provider\n618|// descriptor must match: binding digest, backend ID, versions, and generation\n619|// (SPEC.md §7.A). TerminalBindingID is the digest of the validated Terminal\n620|// Instance Binding 1.0.0 carried as terminal_binding_id (SPEC.md:3461).\n621|type InstanceBinding struct {\n622|\tBackendID             string\n623|\tImplementationVersion string\n624|\tProtocolVersion       string\n625|\tGeneration            string\n626|\tTerminalBindingID     string\n627|}\n628|\n629|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n630|// a descriptor whose binding digest, backend ID, versions, or generation does\n631|// not match the AX-validated host-local binding before launching or observing\n632|// a provider process. Generation lengths 0 and over 256 UTF-8 characters are\n633|// invalid; 256 is accepted.\n634|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n635|\tif err := checkGeneration(descriptor.Generation); err != nil {\n636|\t\treturn err\n637|\t}\n638|\tif err := checkGeneration(binding.Generation); err != nil {\n639|\t\treturn err\n640|\t}\n641|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n642|\t\treturn err\n643|\t}\n644|\tif descriptor.BackendID != binding.BackendID {\n645|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"})\n646|\t}\n647|\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\n648|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n649|\t}\n650|\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\n651|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n652|\t}\n653|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n654|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n655|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"})\n656|\t}\n657|\tif descriptor.Generation != binding.Generation {\n658|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"})\n659|\t}\n660|\treturn nil\n661|}\n662|\n663|// checkGeneration enforces string[1..256] measured in UTF-8 characters over\n664|// valid UTF-8 (SPEC.md:321).\n665|func checkGeneration(generation string) error {\n666|\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\n667|\t\treturn refuse(&Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"})\n668|\t}\n669|\treturn nil\n670|}\n671|\n672|// DigestFile returns the sha256: digest of the executable at path after\n673|// resolving symlinks. The target must be a regular file; anything else (or a\n674|// read failure) is an error, never a digest. It distinguishes a failed read\n675|// from an absent trust entry: callers must not fall back to PATH discovery.\n676|//\n677|// Trust here is Section 6.5 external_trust: the closed entry carries\n678|// exactly backend ID, absolute executable path, executable digest, and\n679|// enabled — there is no owner member, so no owner check applies. That\n680|// differs deliberately from provider trust under Section 7.1, which\n681|// requires the target be owned by the operator or an\n682|// administrator-approved identity (see provider.trustCandidate). The\n683|// symlink-resolution and regular-file steps mirror Section 7.1's\n684|// mechanics; the missing owner dimension is contractual — the closed\n685|// entry leaves no member to record an owner in — not drift. Do not add\n686|// an owner check here without a spec change, and do not read this\n687|// function as the provider trust path.\n688|func DigestFile(path string) (string, error) {\n689|\tresolved, err := filepath.EvalSymlinks(path)\n690|\tif err != nil {\n691|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n692|\t}\n693|\tinfo, err := os.Stat(resolved)\n694|\tif err != nil {\n695|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n696|\t}\n697|\tif !info.Mode().IsRegular() {\n698|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n699|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
