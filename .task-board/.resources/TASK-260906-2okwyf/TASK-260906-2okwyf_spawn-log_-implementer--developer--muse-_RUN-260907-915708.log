{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c713","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":484,"recorded_at":1780531400000963,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"728a983c-7d67-4fb8-8e78-be0b661c211f"},"task_id":"728a983c-7d67-4fb8-8e78-be0b661c211f","event":{"kind":"output","task_id":"728a983c-7d67-4fb8-8e78-be0b661c211f","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(299 line(s) above)\n300|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n301|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n302|\t\t\t\t}\n303|\t\t\t\tcollect(functionName, decl.Body)\n304|\t\t\tcase *ast.GenDecl:\n305|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n306|\t\t\t\t// so a func literal (or a bare &Error{}) assigned to a\n307|\t\t\t\t// package var would otherwise ship invisible. Attribute\n308|\t\t\t\t// its arms to the declared variable name.\n309|\t\t\t\tfor _, spec := range decl.Specs {\n310|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n311|\t\t\t\t\tif !ok {\n312|\t\t\t\t\t\tcontinue\n313|\t\t\t\t\t}\n314|\t\t\t\t\tfunctionName := \"var\"\n315|\t\t\t\t\tif len(value.Names) > 0 {\n316|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n317|\t\t\t\t\t}\n318|\t\t\t\t\tfor _, item := range value.Values {\n319|\t\t\t\t\t\tcollect(functionName, item)\n320|\t\t\t\t\t}\n321|\t\t\t\t}\n322|\t\t\t}\n323|\t\t}\n324|\t\tinvcore.MustAuditConstructorReferences(t, file, fileSet, name, refusalConstructorSpec())\n325|\t}\n326|\t_ = parsed\n327|\tif len(arms) == 0 {\n328|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n329|\t}\n330|\toccurrences := make(map[refusalArm]int)\n331|\tfor index := range arms {\n332|\t\t// The occurrence index counts identical (file, function, code,\n333|\t\t// detail) arms, so the line (which distinguishes them at\n334|\t\t// runtime) stays out of the key: zero it alongside the index.\n335|\t\tkey := arms[index]\n336|\t\tkey.occurrence = 0\n337|\t\tkey.line = 0\n338|\t\toccurrences[key]++\n339|\t\tarms[index].occurrence = occurrences[key]\n340|\t}\n341|\t// One line attributes one arm. Two arms sharing a file:line would\n342|\t// record the same exercised site, so a shadowed twin would hide\n343|\t// behind its sibling exactly the way P8 did before the site audit\n344|\t// existed. Keep one construction per line instead.\n345|\tseenLines := make(map[string]string)\n346|\tfor _, arm := range arms {\n347|\t\tsite := arm.file + \":\" + strconv.Itoa(arm.line)\n348|\t\tif first, duplicate := seenLines[site]; duplicate {\n349|\t\t\tt.Fatalf(\"derived arms %s and %s share production line %s; \"+\n350|\t\t\t\t\"one line cannot attribute two arms, split the constructions\",\n351|\t\t\t\tfirst, describeArm(arm), site)\n352|\t\t}\n353|\t\tseenLines[site] = describeArm(arm)\n354|\t}\n355|\treturn arms\n356|}\n357|\n358|// refusalConstructorSpec is the core watch list for this package:\n359|// package-local refusal constructors plus the plain-error spellings by\n360|// import path, so an import alias cannot change what the audit sees. The\n361|// union keeps terminalbackend's outright refusal and resolves the\n362|// import-alias and var-binding shapes that walked through every\n363|// identifier-keyed gate in this repository.\n364|//\n365|// refuse joins the local set: every production &Error literal routes\n366|// through it, so a `refuse := refuse` binding or any other use outside\n367|// direct-call position fails outright instead of shipping an\n368|// unattributed refusal. TestRefuseFunnelRejectsAliases pins that.\n369|func refusalConstructorSpec() invcore.ConstructorSpec {\n370|\treturn invcore.ConstructorSpec{\n371|\t\tLocal: map[string]bool{\n372|\t\t\t\"mismatchf\":        true,\n373|\t\t\t\"integrityFailure\": true,\n374|\t\t\t\"refuse\":           true,\n375|\t\t},\n376|\t\tQualified: map[string]map[string]bool{\n377|\t\t\t\"errors\": {\"New\": true},\n378|\t\t\t\"fmt\":    {\"Errorf*\": true},\n379|\t\t},\n380|\t}\n381|}\n382|\n383|// receiverTypeName renders a method receiver type to its bare name.\n384|func receiverTypeName(expression ast.Expr) string {\n385|\tswitch typed := expression.(type) {\n386|\tcase *ast.Ident:\n387|\t\treturn typed.Name\n388|\tcase *ast.StarExpr:\n389|\t\treturn receiverTypeName(typed.X)\n390|\tdefault:\n391|\t\treturn \"unknown\"\n392|\t}\n393|}\n394|\n395|// staticDetail reads one Detail expression: a string literal, or the one\n396|// dynamic funnel. Anything else fails the derivation.\n397|func staticDetail(t *testing.T, function string, expression ast.Expr) string {\n398|\tt.Helper()\n399|\n400|\tif literal, ok := expression.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n401|\t\tdetail, err := strconv.Unquote(literal.Value)\n402|\t\tif err != nil {\n403|\t\t\tt.Fatalf(\"%s: unquote detail: %v\", function, err)\n404|\t\t}\n405|\t\treturn detail\n406|\t}\n407|\tif call, ok := expression.(*ast.CallExpr); ok {\n408|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == \"Error\" {\n409|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok && receiver.Name == \"err\" {\n410|\t\t\t\treturn passthroughDetail\n411|\t\t\t}\n412|\t\t}\n413|\t}\n414|\tt.Fatalf(\"%s: refusal Detail is not a static clause; Detail must never \"+\n415|\t\t\"interpolate local data, and a dynamic detail cannot be inventoried\", function)\n416|\treturn \"\"\n417|}\n418|\n419|// productionCodeSymbols resolves every Code symbol to its wire value from\n420|// the production const declarations, so the declared table cannot drift\n421|// from the codes production actually emits.\n422|func productionCodeSymbols(t *testing.T) map[string]string {\n423|\tt.Helper()\n424|\n425|\tsymbols := make(map[string]string)\n426|\tfiles, _ := invcore.MustScanProduction(t, \".\")\n427|\tfor _, production := range files {\n428|\t\tfile := production.Syntax\n429|\t\tfor _, declaration := range file.Decls {\n430|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n431|\t\t\tif !ok || general.Tok != token.CONST {\n432|\t\t\t\tcontinue\n433|\t\t\t}\n434|\t\t\tfor _, specification := range general.Specs {\n435|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n436|\t\t\t\tif !ok {\n437|\t\t\t\t\tcontinue\n438|\t\t\t\t}\n439|\t\t\t\tfor index, name := range value.Names {\n440|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Code\") || index >= len(value.Values) {\n441|\t\t\t\t\t\tcontinue\n442|\t\t\t\t\t}\n443|\t\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n444|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n445|\t\t\t\t\t\tt.Fatalf(\"code symbol %s is not a static string; \"+\n446|\t\t\t\t\t\t\t\"wire codes must be literals\", name.Name)\n447|\t\t\t\t\t}\n448|\t\t\t\t\twire, err := strconv.Unquote(literal.Value)\n449|\t\t\t\t\tif err != nil {\n450|\t\t\t\t\t\tt.Fatalf(\"unquote %s: %v\", name.Name, err)\n451|\t\t\t\t\t}\n452|\t\t\t\t\tsymbols[name.Name] = wire\n453|\t\t\t\t}\n454|\t\t\t}\n455|\t\t}\n456|\t}\n457|\tif len(symbols) == 0 {\n458|\t\tt.Fatal(\"resolved zero code symbols; the scanner is broken, not the package\")\n459|\t}\n460|\treturn symbols\n461|}\n462|\n463|// declaredRefusalArm is one inventoried arm: the derived key (file,\n464|// function, code symbol, static detail, occurrence), the public\n465|// production entry its witness drives, an optional stated bound for\n466|// arms no input can reach, and the funneled detail set (nil except the\n467|// funnel row). Non-bound rows are proved by the executed witness of the\n468|// same identity in refusal_arm_witnesses_test.go; bound rows are proved\n469|// by their pinning tests in the pinned set below.\n470|type declaredRefusalArm struct {\n471|\tfile       string\n472|\tfunction   string\n473|\tcode       string\n474|\tdetail     string\n475|\toccurrence int\n476|\tentry      string\n477|\tbound      string\n478|\t// detailSet carries the funneled detail set for the single\n479|\t// dynamic-detail row; it is empty for every literal row.\n480|\tdetailSet []string\n481|}\n482|\n483|// boundDefensiveReparse is the stated bound for re-parse arms after an\n484|// already-validated member: timestampMember validated the member, and the\n485|// Time re-parse cannot fail while scalar owns that contract. The arms\n486|// stay as fail-closed defense; the bound says why no document reaches\n487|// them, and TestDefensiveBoundsAreExactlyThese pins the set.\n488|const boundDefensiveReparse = \"defensive re-parse after validation; scalar owns the re-parse contract\"\n489|\n490|// boundUnreachableVocabulary is the stated bound for CheckTransition's\n491|// \"operation vocabulary\" arm: CheckTransition parses its operation\n492|// through ParseOperation first, and lookupTransition covers every\n493|// admitted operation, so the miss branch is unreachable by\n494|// construction. TestCheckTransitionOperationVocabularyIsUnreachable pins\n495|// the coverage; adding an operation to ParseOperation without a\n496|// transition-table row fails the pin and promotes this row back to a\n497|// witnessed arm.\n498|const boundUnreachableVocabulary = \"unreachable: ParseOperation admits exactly the tabled operations, so lookupTransition never misses\"\n499|\n500|// boundDecoderContract is the stated bound for decodeCappedValue's two\n501|// defensive syntax branches: a non-string object key (#3) and a stray\n502|// delimiter at a value position (#6). encoding/json Token() errors at\n503|// both positions instead of yielding those values, so neither branch has\n504|// an input. TestDecodeCappedValueDefensiveSitesAreUnreachable pins the\n505|// decoder contract; a Go release that yields either value fails the pin\n506|// and promotes both rows back to witnessed arms.\n507|const boundDecoderContract = \"unreachable: encoding/json Token() errors on non-string keys and stray delimiters, never yielding them\"\n508|\n509|// boundCanonicalPlumbing is the stated bound for the four Marshal/JCS\n510|// error branches in objectIdentity and UnsignedEvidenceBytes: their maps\n511|// are built from JSON-decoded values (numbers refused upstream by\n512|// refuseIdentityNumbers, encoding refused by the decode gate) or from\n513|// typed string-only structs, so json.Marshal cannot fail and jcs has no\n514|// numbers, duplicates, or malformed bytes to refuse.\n515|// TestCanonicalPlumbingIsTotalOnDecodedMaps pins totality over the\n516|// reachable input class; a new failing shape fails the pin and promotes\n517|// these rows back to witnessed arms.\n518|const boundCanonicalPlumbing = \"unreachable: json.Marshal and jcs.Transform cannot fail on number-free decoded maps\"\n519|\n520|// boundUnreachableKind is the stated bound for parseKind's vocabulary\n521|// arm: both document callers wrap its error in their own clause, and\n522|// RegisterExternal's external-kind gate fires first, so the arm's own\n523|// clause never surfaces at any public entry. TestParseKindAdmitsOnlyThe-\n524|// ClosedVocabulary pins the vocabulary white-box; TestRegisterExternal-\n525|// RefusesUnknownKindAsUntrusted pins the gate order, so removing the\n526|// gate fails there and promotes this row back to a witnessed arm.\n527|const boundUnreachableKind = \"unreachable: document callers wrap the error and the registry kind gate fires first\"\n528|\n529|// boundUnreachableNumbers is the stated bound for refuseIdentityNumbers'\n530|// arm: every parse entry validates member types before checkIdentity, so\n531|// a JSON number never reaches the walk; the walk holds that order for\n532|// callers that skip the member checks.\n533|// TestObjectIdentityRefusesNumbersBeforeCanonicalization pins the walk\n534|// white-box. The sibling-swallow residual for this arm's shared clause\n535|// is measured by the exercised-site audit, not by arm-deletion mutants:\n536|// deleting the arm orphans its row (bijection kill), but only the audit\n537|// sees an existing arm go dead while its pair still refuses through a\n538|// sibling (battery row S-tb-shadow reproduces exactly that plant and\n539|// kill; the old C-tb-dead-arm add-a-function row killed for the wrong\n540|// reason and no longer counts as dead-arm coverage).\n541|const boundUnreachableNumbers = \"unreachable: member-type validation runs before checkIdentity on every parse entry\"\n542|\n543|// boundUnreachableDigestNull is the stated bound for Registration.validate's\n544|// \"executable_digest must be null\" arm: RegisterExternal's external-kind\n545|// gate admits exactly the digest-carrying kinds, so validate never sees a\n546|// builtin-kind record with a digest at any public entry; New builds its\n547|// builtins without digests. TestValidateRefusesBuiltinKindWithDigest pins\n548|// the arm white-box by calling validate directly. Narrowing the kind gate\n549|// fails TestRegisterExternalRefusesUnknownKindAsUntrusted and promotes\n550|// this row back to a witnessed arm.\n551|const boundUnreachableDigestNull = \"unreachable: the registry kind gate admits exactly the digest-carrying kinds\"\n552|\n553|// boundShadowedLookup is the stated bound for the nine direct-miss arms\n554|// shadowed by a preceding checkExactMembers over the same member list:\n555|// when the exact check passes, the object keys equal the list exactly,\n556|// so the later lookup of a listed member cannot miss.\n557|// TestShadowedLookupsHaveNoInput proves the shadowing per bound row from\n558|// the production AST, never from a hand list: it derives every\n559|// \"document members\" miss, every exact check, and every helper call\n560|// site, and requires each miss to classify covered (bound) or uncovered\n561|// (witnessed) with its row kind agreeing in both directions. A list that\n562|// loses a member un-covers its miss arm into a live one; a removed exact\n563|// call does the same through the extra-member witnesses that pin the\n564|// exact calls themselves.\n565|const boundShadowedLookup = \"unreachable: a preceding checkExactMembers over the same list fires first\"\n566|\n567|// declaredRefusalArms is the inventoried arm set. Field order is file,\n568|// function (receiver-qualified for methods), code symbol, static detail,\n569|// occurrence within that key, driven public entry, stated bound (empty\n570|// except for defensive arms), funneled detail set (nil except the funnel\n571|// row, which lives outside this table), and asserting tests.\n572|//\n573|// The table is generated from the derivation, never hand-enumerated:\n574|// every row must match exactly one derived arm and vice versa, so adding\n575|// a production arm without a row fails forward, and deleting one fails\n576|// in reverse.\n577|var declaredRefusalArms = []declaredRefusalArm{\n578|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeMismatch\", \"document timestamp\", 1, \"CheckAttachRequest\", boundDefensiveReparse, nil},\n579|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization binding\", 1, \"CheckAttachRequest\", \"\", nil},\n580|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach authorization expiry\", 1, \"CheckAttachRequest\", \"\", nil},\n581|\t{\"conformance.go\", \"CheckAttachRequest\", \"CodeUnauthorized\", \"attach relay transport\", 1, \"CheckAttachRequest\", \"\", nil},\n582|\t{\"conformance.go\", \"CheckAttachResult\", \"CodeUnauthorized\", \"attach input binding\", 1, \"CheckAttachResult\", \"\", nil},\n583|\t{\"conformance.go\", \"CheckEntrypoint\", \"CodePreconditionFailed\", \"entrypoint argv\", 1, \"CheckEntrypoint\", \"\", nil},\n584|\t{\"conformance.go\", \"CheckEntrypo