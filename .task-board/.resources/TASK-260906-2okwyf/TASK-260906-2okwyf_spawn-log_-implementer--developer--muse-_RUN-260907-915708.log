dingID != binding.TerminalBindingID {\\\\n\\\\t\\\\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\\\\\"descriptor binding digest\\\\\\\"})\\\\n\\\\t}\\\",\\n    \\\"expect\\\": \\\"audit-only: digest-arm-1 condition widened to swallow arm-2 inputs (same pair). Inventory census SURVIVES (derived set byte-identical) and behav SURVIVES (the occurrence-2 witness proves its pair through the sibling); ONLY the full-run audit kills, naming the dead occurrence-2 line.\\\",\\n    \\\"census_run\\\": \\\"TestDerivedRefusalArmsAreAllDeclared|TestDeclaredRefusalArmsAreAllDerived|TestDeclaredRefusalWiresMatchProductionConsts|TestDefensiveBoundsAreExactlyThese|TestDigitCensusCoversEveryLeafGuard|TestDigitGuardDigitRuneAdmitsCodePointSpellings|TestDerivedSiteLinesAreExactlyRowed|TestRefusalSiteAttributionIsExact|TestRefuseFunnelRejectsAliases|TestShadowedLookupsHaveNoInput|TestCheckTransitionOperationVocabularyIsUnreachable|TestDecodeCappedValueDefensiveSitesAreUnreachable|TestCanonicalPlumbingIsTotalOnDecodedMaps|TestPlainErrorsLiveOnlyInTheirTwoFunctions|TestPlatformFunnelDetailsAreExactlyThese\\\",\\n    \\\"behav_run\\\": \\\"TestParseIDAdmitsCanonicalIdentities|TestParseIDRefusesWidenedGrammar|TestParseIDRefusesReservedNamespace|TestParseIDGrammarRefusalEchoesNothing|TestEveryDeclaredArmRefusesAtItsEntry|TestDigestFile|TestDigestFileRefusalsAreNeverWireErrors|TestCheckProviderDescriptor|TestCheckVersionTuple|TestCheckVersionTupleRefusesHostileBackendIDWithoutEcho|TestLegacyReverseProjectionExistsOnlyForThePair|TestBackendIDEntryCensus\\\",\\n    \\\"audit_run\\\": \\\"\\\"\\n  },\\n  {\\n    \\\"id\\\": \\\"X-control-notapplied\\\",\\n    \\\"file\\\": \\\"internal/terminalbackend/terminalbackend.go\\\",\\n    \\\"class\\\": \\\"control\\\",\\n    \\\"old\\\": \\\"THIS ANCHOR OCCURS ZERO TIMES BY CONSTRUCTION\\\",\\n    \\\"new\\\": \\\"IMPOSSIBLE\\\",\\n    \\\"expect\\\": null,\\n    \\\"census_run\\\": null,\\n    \\\"behav_run\\\": null\\n  },\\n  {\\n    \\\"id\\\": \\\"X-control-compilefail\\\",\\n    \\\"file\\\": \\\"internal/provider/provider.go\\\",\\n    \\\"class\\\": \\\"control\\\",\\n    \\\"old\\\": \\\"func collectDirectory(owner OwnerPolicy, system System, dir, source string, add func(Candidate) error) error {\\\",\\n    \\\"new\\\": \\\"func brokenSyntax( {\\\",\\n    \\\"expect\\\": null,\\n    \\\"census_run\\\": null,\\n    \\\"behav_run\\\": null\\n  }\\n]\\nEOF\\npython3 -c \\\"import json; d=json.load(open('/tmp/mutants_r3.json')); print(len(d),'mutants')\\\"\",\n  \"description\": \"Write r3 mutant set\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"8 mutants\\n\",\n  \"original_output_bytes\": 10,\n  \"original_output_tokens\": 3,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
