{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c685","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":413,"recorded_at":1780531400000821,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"call_id":"call_01a07a5f6a027ec29cbdf8f8baeb130f","text":"Read text file `internal/terminalbackend/manifest.go`.\n(259 line(s) above)\n260|\t// maxIdentityDocumentBytes is the AX omit-self identity bound the\n261|\t// canonical owner enforces before any identity calculation: an\n262|\t// encoded identity object over 5 MiB is refused before decoding,\n263|\t// so this package refuses it at the same gate rather than\n264|\t// admitting through the direct parse entries what the shared\n265|\t// identity entry refuses.\n266|\tmaxIdentityDocumentBytes = 5_242_880\n267|)\n268|\n269|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n270|// must never interpolate local data: paths, digests, generations, and\n271|// document bytes stay out of errors.\n272|//\n273|//go:noinline\n274|func mismatchf(format string, arguments ...any) *Error {\n275|\terr := &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n276|\tif recordRefusal != nil {\n277|\t\trecordRefusal(err.Code, err.Detail)\n278|\t}\n279|\treturn err\n280|}\n281|\n282|// hasLoneSurrogateEscape reports whether raw JSON carries a lone surrogate\n283|// code point inside any string literal, either as a \\uXXXX escape or as raw\n284|// WTF-8 (CESU-8) bytes ED A0..BF 80..BF, which decode to U+D800..U+DFFF.\n285|// It answers only the surrogate question: malformed escapes, other invalid\n286|// UTF-8, unescaped control characters, and unterminated strings are left\n287|// for the decoder's syntax and encoding arms, which refuse them with their\n288|// own details. The scan mirrors internal/canonicaljson\n289|// validateSurrogateEscapes without importing it: canonicaljson is\n290|// byte-identical across stories and must not be edited at integration, so\n291|// the two copies are pinned equal by\n292|// TestSurrogateGateAgreesWithCanonicalJSON instead of shared.\n293|func hasLoneSurrogateEscape(raw []byte) bool {\n294|\tfor index := 0; index < len(raw); index++ {\n295|\t\tif raw[index] != '\"' {\n296|\t\t\tcontinue\n297|\t\t}\n298|\t\tfor index++; index < len(raw); index++ {\n299|\t\t\tif isWTF8SurrogateAt(raw, index) {\n300|\t\t\t\treturn true\n301|\t\t\t}\n302|\t\t\tswitch raw[index] {\n303|\t\t\tcase '\"':\n304|\t\t\t\tgoto stringComplete\n305|\t\t\tcase '\\\\':\n306|\t\t\t\tindex++\n307|\t\t\t\tif index >= len(raw) {\n308|\t\t\t\t\treturn false\n309|\t\t\t\t}\n310|\t\t\t\t// The escaped byte is skipped by the switch below without\n311|\t\t\t\t// passing the loop head, so test it here: a WTF-8 head\n312|\t\t\t\t// immediately after a backslash (for example \"...\\n<ED A0\n313|\t\t\t\t// 80>...\") is still raw bytes on the wire, not an escape.\n314|\t\t\t\tif isWTF8SurrogateAt(raw, index) {\n315|\t\t\t\t\treturn true\n316|\t\t\t\t}\n317|\t\t\t\tif raw[index] != 'u' {\n318|\t\t\t\t\tcontinue\n319|\t\t\t\t}\n320|\t\t\t\tunit, end, ok := readUTF16EscapeUnit(raw, index-1)\n321|\t\t\t\tif !ok {\n322|\t\t\t\t\tcontinue\n323|\t\t\t\t}\n324|\t\t\t\tindex = end - 1\n325|\t\t\t\tswitch {\n326|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n327|\t\t\t\t\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\n328|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n329|\t\t\t\t\t\treturn true\n330|\t\t\t\t\t}\n331|\t\t\t\t\tindex = secondEnd - 1\n332|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n333|\t\t\t\t\treturn true\n334|\t\t\t\t}\n335|\t\t\t}\n336|\t\t}\n337|\tstringComplete:\n338|\t}\n339|\treturn false\n340|}\n341|\n342|// isWTF8SurrogateAt reports whether raw[index] begins a three-byte WTF-8\n343|// (CESU-8) encoding of a surrogate code point: ED A0..BF 80..BF decodes to\n344|// U+D800..U+DFFF, which utf8.Valid refuses. Only this ED range is\n345|// surrogate-shaped: ED 80..9F heads U+D000..U+D7FF, which is valid UTF-8\n346|// and must not match. A truncated tail cannot be classified here and is\n347|// left for the encoding arm.\n348|func isWTF8SurrogateAt(raw []byte, index int) bool {\n349|\treturn index+2 < len(raw) && raw[index] == 0xed &&\n350|\t\traw[index+1] >= 0xa0 && raw[index+1] <= 0xbf &&\n351|\t\traw[index+2] >= 0x80 && raw[index+2] <= 0xbf\n352|}\n353|\n354|// readUTF16EscapeUnit reads one \\uXXXX escape at raw[start] (which must be\n355|// the backslash). It reports false when the escape is absent or malformed;\n356|// malformed escapes are refused by the decoder's syntax arm, so this gate\n357|// only needs to stay silent on them rather than diagnose them.\n358|func readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\n359|\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\' || raw[start+1] != 'u' {\n360|\t\treturn 0, start, false\n361|\t}\n362|\tvar unit uint16\n363|\tfor _, digit := range raw[start+2 : start+6] {\n364|\t\tunit <<= 4\n365|\t\tswitch {\n366|\t\tcase digit >= '0' && digit <= '9':\n367|\t\t\tunit |= uint16(digit - '0')\n368|\t\tcase digit >= 'a' && digit <= 'f':\n369|\t\t\tunit |= uint16(digit-'a') + 10\n370|\t\tcase digit >= 'A' && digit <= 'F':\n371|\t\t\tunit |= uint16(digit-'A') + 10\n372|\t\tdefault:\n373|\t\t\treturn 0, start, false\n374|\t\t}\n375|\t}\n376|\treturn unit, start + 6, true\n377|}\n378|\n379|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n380|// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\n381|// trailing-data refusal. The surrogate scan runs on the raw bytes before\n382|// any canonicalization (SPEC.md:289): Go's encoding/json would silently\n383|// replace a lone \\ud800 with U+FFFD, hiding the violation from every later\n384|// member check. Numbers\n385|// decode as json.Number so member validators can refuse them explicitly:\n386|// none of the three closed schemas has a numeric member.\n387|func decodeStrictObject(raw []byte) (map[string]any, error) {\n388|\tif len(raw) > maxIdentityDocumentBytes {\n389|\t\treturn nil, mismatchf(\"document size\")\n390|\t}\n391|\tif !utf8.Valid(raw) {\n392|\t\treturn nil, mismatchf(\"document encoding\")\n393|\t}\n394|\tif hasLoneSurrogateEscape(raw) {\n395|\t\treturn nil, mismatchf(\"document surrogate escape\")\n396|\t}\n397|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n398|\tdecoder.UseNumber()\n399|\tvalue, err := decodeCappedValue(decoder, 0)\n400|\tif err != nil {\n401|\t\treturn nil, err\n402|\t}\n403|\tif decoder.More() {\n404|\t\treturn nil, mismatchf(\"document trailing data\")\n405|\t}\n406|\tobject, ok := value.(map[string]any)\n407|\tif !ok {\n408|\t\treturn nil, mismatchf(\"document shape\")\n409|\t}\n410|\treturn object, nil\n411|}\n412|\n413|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n414|// bound is far above the deepest legitimate nesting (object, claims array,\n415|// claim object, member array) and fails closed below any decoder-stack risk.\n416|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n417|\tif depth > maxJSONDepth {\n418|\t\treturn nil, mismatchf(\"document nesting\")\n419|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c687","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":414,"recorded_at":1780531400000823,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"call_id":"call_01a07a5f6aff7801b440e8024e0664b6","text":"Read text file `internal/terminalbackend/manifest.go`.\n(974 line(s) above)\n975|func ParseManifest(raw []byte) (Manifest, error) {\n976|\tobject, err := decodeStrictObject(raw)\n977|\tif err != nil {\n978|\t\treturn Manifest{}, err\n979|\t}\n980|\treturn parseManifestObject(object)\n981|}\n982|\n983|// parseManifestObject validates a decoded Manifest member map. It is split\n984|// from ParseManifest so admission paths that already hold a decoded object\n985|// share the exact gate.\n986|func parseManifestObject(object map[string]any) (Manifest, error) {\n987|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n988|\t\treturn Manifest{}, err\n989|\t}\n990|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n991|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n992|\t}\n993|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n994|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n995|\t}\n996|\tmanifestID, err := stringMember(object, \"manifest_id\")\n997|\tif err != nil {\n998|\t\treturn Manifest{}, err\n999|\t}\n1000|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1001|\tif err != nil {\n1002|\t\treturn Manifest{}, err\n1003|\t}\n1004|\tif _, err := ParseID(backendID); err != nil {\n1005|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n1006|\t}\n1007|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1008|\tif err != nil {\n1009|\t\treturn Manifest{}, err\n1010|\t}\n1011|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n1012|\tif err != nil {\n1013|\t\treturn Manifest{}, err\n1014|\t}\n1015|\tif err := validateProtocolList(protocols); err != nil {\n1016|\t\treturn Manifest{}, err\n1017|\t}\n1018|\tplatforms, err := parsePlatformList(object)\n1019|\tif err != nil {\n1020|\t\treturn Manifest{}, err\n1021|\t}\n1022|\tkindName, err := stringMember(object, \"implementation_kind\")\n1023|\tif err != nil {\n1024|\t\treturn Manifest{}, err\n1025|\t}\n1026|\tkind, err := parseKind(kindName)\n1027|\tif err != nil {\n1028|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n1029|\t}\n1030|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n1031|\tif err != nil {\n1032|\t\treturn Manifest{}, err\n1033|\t}\n1034|\tif needsDigest(kind) == (digest == \"\") {\n1035|\t\treturn Manifest{}, mismatchf(\"manifest executable digest\")\n1036|\t}\n1037|\tclaimsRaw, known := object[\"static_capability_claims\"]\n1038|\tif !known {\n1039|\t\treturn Manifest{}, mismatchf(\"document members\")\n1040|\t}\n1041|\tclaims, err := parseClaimList(claimsRaw, false)\n1042|\tif err != nil {\n1043|\t\treturn Manifest{}, err\n1044|\t}\n1045|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n1046|\tif err != nil {\n1047|\t\treturn Manifest{}, err\n1048|\t}\n1049|\tif err := checkExtensions(object); err != nil {\n1050|\t\treturn Manifest{}, err\n1051|\t}\n1052|\t// The identity binding is verified after every member-type rule, so a\n1053|\t// malformed document is refused before any JCS transform runs\n1054|\t// (SPEC.md:301 NUM-UNSAFE-NUMBER: reject before identity calculation).\n1055|\tif err := checkIdentity(object, \"manifest_id\", manifestID); err != nil {\n1056|\t\treturn Manifest{}, err\n1057|\t}\n1058|\treturn Manifest{\n1059|\t\tManifestID:             manifestID,\n1060|\t\tTerminalBackendID:      backendID,\n1061|\t\tImplementationVersion:  implementationVersion,\n1062|\t\tProtocolVersions:       protocols,\n1063|\t\tPlatforms:              platforms,\n1064|\t\tImplementationKind:     kind,\n1065|\t\tExecutableDigest:       digest,\n1066|\t\tStaticCapabilityClaims: claims,\n1067|\t\tConformanceFixtureID:   fixtureID,\n1068|\t}, nil\n1069|}\n1070|\n1071|// validateProtocolList enforces sorted unique semver[1..32], each in\n1072|// Terminal Backend Protocol major 1, without naming a backend.\n1073|func validateProtocolList(versions []string) error {\n1074|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n1075|\t\treturn mismatchf(\"protocol versions bound\")\n1076|\t}\n1077|\tfor index, version := range versions {\n1078|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n1079|\t\t\treturn mismatchf(\"protocol versions major 1\")\n1080|\t\t}\n1081|\t\tif index > 0 && versions[index-1] >= version {\n1082|\t\t\treturn mismatchf(\"protocol versions ordering\")\n1083|\t\t}\n1084|\t}\n1085|\treturn nil\n1086|}\n1087|\n1088|// parsePlatformList validates the sorted unique non-empty platform subset.\n1089|func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\n1090|\tnames, err := stringArrayMember(object, \"platforms\")\n1091|\tif err != nil {\n1092|\t\treturn nil, err\n1093|\t}\n1094|\tif len(names) == 0 || len(names) > 4 {\n1095|\t\treturn nil, mismatchf(\"platforms bound\")\n1096|\t}\n1097|\tplatforms := make([]scalar.Platform, 0, len(names))\n1098|\tfor _, name := range names {\n1099|\t\tplatform, err := scalar.ParsePlatform(name)\n1100|\t\tif err != nil {\n1101|\t\t\treturn nil, mismatchf(\"platforms vocabulary\")\n1102|\t\t}\n1103|\t\tplatforms = append(platforms, platform)\n1104|\t}\n1105|\tfor index := range platforms {\n1106|\t\t// Bytewise >= refuses duplicates and misordering together: equal\n1107|\t\t// neighbours are not strictly ordered.\n1108|\t\tif index > 0 && platforms[index-1].String() >= platforms[index].String() {\n1109|\t\t\treturn nil, mismatchf(\"platforms ordering\")\n1110|\t\t}\n1111|\t}\n1112|\treturn platforms, nil\n1113|}\n1114|\n1115|// probeMembers is the exact closed Probe member set.\n1116|var probeMembers = []string{\n1117|\t\"schema\", \"schema_version\", \"probe_id\", \"terminal_backend_id\",\n1118|\t\"implementation_version\", \"protocol_version\", \"implementation_kind\",\n1119|\t\"executable_digest\", \"platform\", \"os_version\", \"availability\",\n1120|\t\"backend_generation_digest\", \"capability_claims\", \"evidence_ids\",\n1121|\t\"probed_at\", \"extensions\",\n1122|}\n1123|\n1124|// ParseProbe validates one Terminal Backend Probe 1.0.0 document. Shape,\n1125|// vocabulary, bound, ordering, registry-row, and identity failures are all\n1126|// CodeMismatch; cross-document reconciliation against the Manifest happens\n1127|// in Reconcile, not here.\n1128|func ParseProbe(raw []byte) (Probe, error) {\n1129|\tobject, err := decodeStrictObject(raw)\n1130|\tif err != nil {\n1131|\t\treturn Probe{}, err\n1132|\t}\n1133|\tif err := checkExactMembers(object, probeMembers); err != nil {\n1134|\t\treturn Probe{}, err\n1135|\t}\n1136|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaProbe {\n1137|\t\treturn Probe{}, mismatchf(\"probe schema\")\n1138|\t}\n1139|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n1140|\t\treturn Probe{}, mismatchf(\"probe schema version\")\n1141|\t}\n1142|\tprobeID, err := stringMember(object, \"probe_id\")\n1143|\tif err != nil {\n1144|\t\treturn Probe{}, err\n1145|\t}\n1146|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1147|\tif err != nil {\n1148|\t\treturn Probe{}, err\n1149|\t}\n1150|\tif _, err := ParseID(backendID); err != nil {\n1151|\t\treturn Probe{}, mismatchf(\"probe backend identity\")\n1152|\t}\n1153|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1154|\tif err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
