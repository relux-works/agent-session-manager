{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"a4c6f478-3cd1-45a5-8886-8a3daf65ec83"},"task_id":"a4c6f478-3cd1-45a5-8886-8a3daf65ec83","event":{"kind":"output","task_id":"a4c6f478-3cd1-45a5-8886-8a3daf65ec83","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1659 line(s) above)\n1660|\tif operation == \"manifest\" || operation == \"probe\" {\n1661|\t\treturn nil\n1662|\t}\n1663|\tif !admitted.HasOperation(operation) {\n1664|\t\treturn refuse(&Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"})\n1665|\t}\n1666|\treturn nil\n1667|}\n1668|\n1669|// Reconcile admits one Probe against its Manifest with the returned\n1670|// evidence set, binding everything to the AX-known raw generation and the\n1671|// admission instant (§4.B keyed relation, §4.D evidence binding). The check\n1672|// order is deterministic: identity equality, protocol/platform membership,\n1673|// generation binding, claim relation, per-object evidence usability\n1674|// (tuple binding, liveness, signature), per-claim requirement coverage,\n1675|// then the exact evidence_ids set rule. The first failure wins; every\n1676|// failure fails closed before activation.\n1677|//\n1678|// Each supplied evidence object must independently prove its named claim:\n1679|// split-facts evidence (requirement coverage spread across several objects,\n1680|// none sufficient alone) is refused. That reading follows the singular\n1681|// rule-5 phrasing (\"Capability Evidence ... satisfies every listed evidence\n1682|// requirement\") and is stated here as the bound.\n1683|func Reconcile(manifest Manifest, probe Probe, evidence []Evidence, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1684|\tif verify == nil {\n1685|\t\treturn Admitted{}, integrityFailure(\"evidence signature verifier\")\n1686|\t}\n1687|\tif err := checkProbeIdentity(manifest, probe); err != nil {\n1688|\t\treturn Admitted{}, err\n1689|\t}\n1690|\tif err := checkProbeMembership(manifest, probe); err != nil {\n1691|\t\treturn Admitted{}, err\n1692|\t}\n1693|\tif err := checkProbeGeneration(probe, rawGeneration); err != nil {\n1694|\t\treturn Admitted{}, err\n1695|\t}\n1696|\tmanifestClaims := indexClaims(manifest.StaticCapabilityClaims)\n1697|\tif err := checkClaimRelation(manifestClaims, probe.CapabilityClaims); err != nil {\n1698|\t\treturn Admitted{}, err\n1699|\t}\n1700|\tprobeClaims := indexClaims(probe.CapabilityClaims)\n1701|\tused, err := checkEvidenceSet(manifest, probe, probeClaims, evidence, now, verify)\n1702|\tif err != nil {\n1703|\t\treturn Admitted{}, err\n1704|\t}\n1705|\tif err := checkEvidenceCoverage(probeClaims, used); err != nil {\n1706|\t\treturn Admitted{}, err\n1707|\t}\n1708|\tif err := checkEvidenceIDs(probe, used); err != nil {\n1709|\t\treturn Admitted{}, err\n1710|\t}\n1711|\treturn admitCapabilities(probeClaims, used), nil\n1712|}\n1713|\n1714|// checkProbeIdentity enforces the §4.B identity equalities. Executable\n1715|// substitution additionally maps to the more specific untrusted code.\n1716|func checkProbeIdentity(manifest Manifest, probe Probe) error {\n1717|\tif probe.TerminalBackendID != manifest.TerminalBackendID ||\n1718|\t\tprobe.ImplementationVersion != manifest.ImplementationVersion ||\n1719|\t\tprobe.ImplementationKind != manifest.ImplementationKind {\n1720|\t\treturn mismatchf(\"probe manifest binding\")\n1721|\t}\n1722|\t// The backend IDs are already equal here (refused above), so a digest\n1723|\t// difference is always a substitution of the admitted executable: it\n1724|\t// is untrusted, never a plain mismatch.\n1725|\tif probe.ExecutableDigest != manifest.ExecutableDigest {\n1726|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: probe.TerminalBackendID, Detail: \"executable substitution\"})\n1727|\t}\n1728|\treturn nil\n1729|}\n1730|\n1731|// checkProbeMembership enforces array-to-scalar selection as membership:\n1732|// the probe protocol version must be exactly one Manifest member and the\n1733|// probe platform exactly one Manifest platform member.\n1734|func checkProbeMembership(manifest Manifest, probe Probe) error {\n1735|\tmember := false\n1736|\tfor _, version := range manifest.ProtocolVersions {\n1737|\t\tif probe.ProtocolVersion == version {\n1738|\t\t\tmember = true\n1739|\t\t\tbreak\n1740|\t\t}\n1741|\t}\n1742|\tif !member {\n1743|\t\treturn mismatchf(\"probe protocol membership\")\n1744|\t}\n1745|\tfor _, platform := range manifest.Platforms {\n1746|\t\tif probe.Platform == platform {\n1747|\t\t\treturn nil\n1748|\t\t}\n1749|\t}\n1750|\treturn mismatchf(\"probe platform membership\")\n1751|}\n1752|\n1753|// checkProbeGeneration binds the probe to the AX-known raw generation. A\n1754|// digest mismatch (or an underivable raw generation, including empty, which\n1755|// would make every backend share one digest) is stale, never a retry hint.\n1756|func checkProbeGeneration(probe Probe, rawGeneration string) error {\n1757|\tdigest, err := GenerationDigest(rawGeneration)\n1758|\tif err != nil {\n1759|\t\treturn err\n1760|\t}\n1761|\tif digest != probe.BackendGenerationDigest {\n1762|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: probe.TerminalBackendID, Detail: \"probe generation binding\"})\n1763|\t}\n1764|\treturn nil\n1765|}\n1766|\n1767|// indexClaims keys validated claims by capability. The validated lists are\n1768|// duplicate-free, so the index cannot collide.\n1769|func indexClaims(claims []Claim) map[string]Claim {\n1770|\tindexed := make(map[string]Claim, len(claims))\n1771|\tfor _, claim := range claims {\n1772|\t\tindexed[claim.Capability] = claim\n1773|\t}\n1774|\treturn indexed\n1775|}\n1776|\n1777|// checkClaimRelation enforces the complete §4.B keyed relation between the\n1778|// Manifest static claims M and the Probe claims P.\n1779|func checkClaimRelation(manifest map[string]Claim, probe []Claim) error {\n1780|\tfor _, proved := range probe {\n1781|\t\tcapability := proved.Capability\n1782|\t\tstatic, exists := manifest[capability]\n1783|\t\tswitch {\n1784|\t\tcase proved.Origin == OriginStatic && !exists:\n1785|\t\t\treturn mismatchf(\"probe static claim without manifest\")\n1786|\t\tcase proved.Origin == OriginStatic:\n1787|\t\t\tif !equalClaim(proved, static) {\n1788|\t\t\t\treturn mismatchf(\"probe static claim echo\")\n1789|\t\t\t}\n1790|\t\tcase exists && !static.GenerationVariable:\n1791|\t\t\treturn mismatchf(\"probe override of stable claim\")\n1792|\t\tcase exists:\n1793|\t\t\tif proved.GenerationVariable != static.GenerationVariable ||\n1794|\t\t\t\t!equalStrings(proved.DependentOperations, static.DependentOperations) ||\n1795|\t\t\t\t!equalStrings(proved.EvidenceRequirements, static.EvidenceRequirements) {\n1796|\t\t\t\treturn mismatchf(\"probe override registry binding\")\n1797|\t\t\t}\n1798|\t\tdefault:\n1799|\t\t\trow := capabilityRegistry[proved.Capability]\n1800|\t\t\tif proved.GenerationVariable != row.generationVariable ||\n1801|\t\t\t\t!equalStrings(proved.DependentOperations, row.dependentOperations) ||\n1802|\t\t\t\t!equalStrings(proved.EvidenceRequirements, row.evidenceRequirements) {\n1803|\t\t\t\treturn mismatchf(\"probe addition registry binding\")\n1804|\t\t\t}\n1805|\t\t}\n1806|\t}\n1807|\tfor capability := range manifest {\n1808|\t\tif _, present := indexProbeCapability(probe, capability); !present {\n1809|\t\t\treturn mismatchf(\"probe omission of manifest claim\")\n1810|\t\t}\n1811|\t}\n1812|\treturn nil\n1813|}\n1814|\n1815|// indexProbeCapability reports whether the probe lists the capability. The\n1816|// probe list is validated duplicate-free, so presence is unambiguous.\n1817|func indexProbeCapability(probe []Claim, capability string) (Claim, bool) {\n1818|\tfor _, claim := range probe {\n1819|\t\tif claim.Capability == capability {\n1820|\t\t\treturn claim, true\n1821|\t\t}\n1822|\t}\n1823|\treturn Claim{}, false\n1824|}\n1825|\n1826|// checkEvidenceSet validates every supplied evidence object: it must name a\n1827|// present true probe claim, bind to this exact Manifest/Probe tuple, be\n1828|// live at now, and carry a valid attestation signature. Expired,\n1829|// wrong-generation, dangling, or otherwise unusable evidence refuses the\n1830|// whole reconciliation (§4.B); a forged or unverifiable signature is an\n1831|// integrity failure. The returned objects are the usable set that coverage\n1832|// and ID-set checks consume.\n1833|func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\n1834|\tused := make([]Evidence, 0, len(evidence))\n1835|\tseen := make(map[string]Evidence, len(evidence))\n1836|\tfor _, object := range evidence {\n1837|\t\tclaim, present := probeClaims[object.Capability]\n1838|\t\tif !present || !claim.Value {\n1839|\t\t\treturn nil, mismatchf(\"evidence claim binding\")\n1840|\t\t}\n1841|\t\tif err := checkEvidenceTuple(manifest, probe, object); err != nil {\n1842|\t\t\treturn nil, err\n1843|\t\t}\n1844|\t\tif err := checkEvidenceLiveness(object, now); err != nil {\n1845|\t\t\treturn nil, err\n1846|\t\t}\n1847|\t\tif previous, duplicate := seen[object.EvidenceID]; duplicate {\n1848|\t\t\tif !equalEvidence(previous, object) {\n1849|\t\t\t\treturn nil, mismatchf(\"conflicting evidence\")\n1850|\t\t\t}\n1851|\t\t\tcontinue\n1852|\t\t}\n1853|\t\tseen[object.EvidenceID] = object\n1854|\t\tif err := checkEvidenceSignature(object, verify); err != nil {\n1855|\t\t\treturn nil, err\n1856|\t\t}\n1857|\t\tused = append(used, object)\n1858|\t}\n1859|\treturn used, nil\n1860|}\n1861|\n1862|// equalEvidence reports whether two evidence objects with the same ID carry\n1863|// identical members. Same-ID differing-bytes objects are conflicting\n1864|// evidence and invalidate the whole Probe.\n1865|func equalEvidence(left, right Evidence) bool {\n1866|\tif left.TerminalBackendID != right.TerminalBackendID ||\n1867|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n1868|\t\tleft.ProtocolVersion != right.ProtocolVersion ||\n1869|\t\tleft.BackendGenerationDigest != right.BackendGenerationDigest ||\n1870|\t\tleft.Capability != right.Capability ||\n1871|\t\tleft.Platform != right.Platform ||\n1872|\t\tleft.OSVersion != right.OSVersion ||\n1873|\t\tleft.ConformanceFixtureID != right.ConformanceFixtureID ||\n1874|\t\tleft.ObservedAt.String() != right.ObservedAt.String() ||\n1875|\t\tleft.ExpiresAt.String() != right.ExpiresAt.String() ||\n1876|\t\tleft.Issuer != right.Issuer ||\n1877|\t\tleft.IssuerID != right.IssuerID ||\n1878|\t\t!equalStrings(left.Facts, right.Facts) ||\n1879|\t\tleft.TerminalBindingID != right.TerminalBindingID ||\n1880|\t\tleft.ProviderID != right.ProviderID ||\n1881|\t\tleft.ProviderBuild != right.ProviderBuild ||\n1882|\t\tleft.SentinelResult != right.SentinelResult ||\n1883|\t\tleft.ProviderAuthSmokeResult != right.ProviderAuthSmokeResult {\n1884|\t\treturn false\n1885|\t}\n1886|\treturn bytes.Equal(left.AttestationSignature, right.AttestationSignature)\n1887|}\n1888|\n1889|// checkEvidenceTuple binds one evidence object to this exact Manifest/Probe\n1890|// tuple: backend, versions, generation digest, platform, os_version, and\n1891|// the Manifest conformance fixture must all match.\n1892|func checkEvidenceTuple(manifest Manifest, probe Probe, object Evidence) error {\n1893|\tif object.TerminalBackendID != probe.TerminalBackendID ||\n1894|\t\tobject.ImplementationVersion != probe.ImplementationVersion ||\n1895|\t\tobject.ProtocolVersion != probe.ProtocolVersion ||\n1896|\t\tobject.BackendGenerationDigest != probe.BackendGenerationDigest ||\n1897|\t\tobject.Platform != probe.Platform ||\n1898|\t\tobject.OSVersion != probe.OSVersion ||\n1899|\t\tobject.ConformanceFixtureID != manifest.ConformanceFixtureID {\n1900|\t\treturn mismatchf(\"evidence tuple binding\")\n1901|\t}\n1902|\treturn nil\n1903|}\n1904|\n1905|// checkEvidenceLiveness requires observed_at <= now < expires_at. Future\n1906|// observed instants and expired objects are both unusable: the former is\n1907|// not yet proof, the latter no longer is.\n1908|func checkEvidenceLiveness(object Evidence, now time.Time) error {\n1909|\tobserved, err := object.ObservedAt.Time()\n1910|\tif err != nil {\n1911|\t\treturn mismatchf(\"document timestamp\")\n1912|\t}\n1913|\texpires, err := object.ExpiresAt.Time()\n1914|\tif err != nil {\n1915|\t\treturn mismatchf(\"document timestamp\")\n1916|\t}\n1917|\tif observed.After(now) || !now.Before(expires) {\n1918|\t\treturn mismatchf(\"evidence liveness\")\n1919|\t}\n1920|\treturn nil\n1921|}\n1922|\n1923|// checkEvidenceSignature verifies the attestation through the caller's\n1924|// trusted key registry. Missing, unknown-key, or invalid signatures fail\n1925|// closed before capability admission; a caller-supplied issuer ID alone is\n1926|// never authentication.\n1927|func checkEvidenceSignature(object Evidence, verify SignatureVerifier) error {\n1928|\tmessage, err := UnsignedEvidenceBytes(object)\n1929|\tif err != nil {\n1930|\t\treturn err\n1931|\t}\n1932|\tif err := verify(object.IssuerID, message, object.AttestationSignature); err != nil {\n1933|\t\treturn integrityFailure(\"evidence attestation\")\n1934|\t}\n1935|\treturn nil\n1936|}\n1937|\n1938|// checkEvidenceCoverage requires every true probe claim to hold at least\n1939|// one usable evidence object whose facts cover every listed requirement\n1940|// through the requirement-to-fact mapping. False claims need no evidence\n1941|// and take none: evidence for a false claim was already refused as\n1942|// unbound in checkEvidenceSet.\n1943|func checkEvidenceCoverage(probeClaims map[string]Claim, used []Evidence) error {\n1944|\tbyCapability := make(map[string][]Evidence, len(used))\n1945|\tfor _, object := range used {\n1946|\t\tbyCapability[object.Capability] = append(byCapability[object.Capability], object)\n1947|\t}\n1948|\tfor capability, claim := range probeClaims {\n1949|\t\tif !claim.Value {\n1950|\t\t\tcontinue\n1951|\t\t}\n1952|\t\tcovered := false\n1953|\t\tfor _, object := range byCapability[capability] {\n1954|\t\t\tif factsCover(object.Facts, claim.EvidenceRequirements) {\n1955|\t\t\t\tcovered = true\n1956|\t\t\t\tbreak\n1957|\t\t\t}\n1958|\t\t}\n1959|\t\tif !covered {\n1960|\t\t\treturn mismatchf(\"evidence requirement coverage\")\n1961|\t\t}\n1962|\t}\n1963|\treturn nil\n1964|}\n1965|\n1966|// factsCover reports whether the fact set satisfies every listed\n1967|// requirement through the requirement-to-fact mapping. Supplementary facts\n1968|// (ui_absent, prompt_absent) never satisfy a requirement alone.\n1969|func factsCover(facts []string, requirements []string) bool {\n1970|\theld := make(map[string]bool, len(facts))\n1971|\tfor _, fact := range facts {\n1972|\t\theld[fact] = true\n1973|\t}\n1974|\tfor _, requirement := range requirements {\n1975|\t\tif !held[requirementFact[requirement]] {\n1976|\t\t\treturn false\n1977|\t\t}\n1978|\t}\n1979|\treturn true\n1980|}\n1981|\n1982|// checkEvidenceIDs enforces the exact rule-6 set equality: evidence_ids\n1983|// must be exactly the sorted unique IDs of the usable evidence objects.\n1984|// Dangling IDs, unlisted usable objects, and ordering deviations all fail.\n1985|func checkEvidenceIDs(probe Probe, used []Evidence) error {\n1986|\twant := make([]string, 0, len(used))\n1987|\tfor _, object := range used {\n1988|\t\twant = append(want, object.EvidenceID)\n1989|\t}\n1990|\tfor index := range want {\n1991|\t\tfor next := index + 1; next < len(want); next++ {\n1992|\t\t\tif want[next] < want[index] {\n1993|\t\t\t\twant[index], want[next] = want[next], want[index]\n1994|\t\t\t}\n1995|\t\t}\n1996|\t}\n1997|\tif !equalStrings(probe.EvidenceIDs, want) {\n1998|\t\treturn mismatchf(\"evidence id set binding\")\n1999|\t}\n2000|\treturn nil\n2001|}\n2002|\n2003|// admitCapabilities collects the sorted admitted true-claim names and the\n2004|// sorted evidence IDs that proved them.\n2005|func admitCapabilities(probeClaims map[string]Claim, used []Evidence) Admitted {\n2006|\tvar capabilities []string\n2007|\tfor capability, claim := range probeClaims {\n2008|\t\tif claim.Value {\n2009|\t\t\tcapabilities = append(capabilities, capability)\n2010|\t\t}\n2011|\t}\n2012|\tfor index := range capabilities {\n2013|\t\tfor next := index + 1; next < len(capabilities); next++ {\n2014|\t\t\tif capabilities[next] < capabilities[index] {\n2015|\t\t\t\tcapabilities[index], capabilities[next] = capabilities[next], capabilities[index]\n2016|\t\t\t}\n2017|\t\t}\n2018|\t}\n2019|\tevidenceIDs := make([]string, 0, len(used))\n2020|\tfor _, object := range used {\n2021|\t\tevidenceIDs = append(evidenceIDs, object.EvidenceID)\n2022|\t}\n2023|\tfor index := range evidenceIDs {\n2024|\t\tfor next := index + 1; next < len(evidenceIDs); next++ {\n2025|\t\t\tif evidenceIDs[next] < evidenceIDs[index] {\n2026|\t\t\t\tevidenceIDs[index], evidenceIDs[next] = evidenceIDs[next], evidenceIDs[index]\n2027|\t\t\t}\n2028|\t\t}\n2029|\t}\n2030|\treturn Admitted{Capabilities: capabilities, EvidenceIDs: evidenceIDs}\n2031|}\n2032|\n2033|// AdmitProbe is the registry-bound production admission: it parses the\n2034|// Manifest, resolves the backend through the admitted registry (unknown\n2035|// identities fail closed, never default), binds the Manifest identity tuple\n2036|// to the admitted record, then reconciles the Probe with its evidence set.\n2037|// Trust is established before any probe: registration-time trust admission\n2038|// owns executables, and this gate additionally refuses executable\n2039|// substitution as untrusted and any other identity drift as drift.\n2040|//\n2041|// rawGeneration is the AX-known current raw generation for the backend;\n2042|// now is the admission instant; verify authenticates evidence through the\n2043|// trusted key registry and must be non-nil.\n2044|func (registry *Registry) AdmitProbe(manifestRaw, probeRaw []byte, evidenceRaws [][]byte, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n2045|\tif registry == nil {\n2046|\t\treturn Admitted{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n2047|\t}\n2048|\tmanifest, err := ParseManifest(manifestRaw)\n2049|\tif err != nil {\n2050|\t\treturn Admitted{}, err\n2051|\t}\n2052|\trecord, err := registry.Resolve(manifest.TerminalBackendID)\n2053|\tif err != nil {\n2054|\t\treturn Admitted{}, err\n2055|\t}\n2056|\tif err := checkManifestRecordBinding(manifest, record); err != nil {\n2057|\t\treturn Admitted{}, err\n2058|\t}\n2059|\tprobe, err := ParseProbe(probeRaw)\n2060|\tif err != nil {\n2061|\t\treturn Admitted{}, err\n2062|\t}\n2063|\tevidence := make([]Evidence, 0, len(evidenceRaws))\n2064|\tfor _, raw := range evidenceRaws {\n2065|\t\tobject, err := ParseEvidence(raw)\n2066|\t\tif err != nil {\n2067|\t\t\treturn Admitted{}, err\n2068|\t\t}\n2069|\t\tevidence = append(evidence, object)\n2070|\t}\n2071|\treturn Reconcile(manifest, probe, evidence, rawGeneration, now, verify)\n2072|}\n2073|\n2074|// checkManifestRecordBinding binds the Manifest identity tuple to the\n2075|// admitted registry record: implementation version, protocol set, platform\n2076|// set, and kind must match member-for-member, and the executable digest\n2077|// must match exactly. Any version/kind/platform drift is drift; an\n2078|// executable substitution is untrusted.\n2079|func checkManifestRecordBinding(manifest Manifest, record Registration) error {\n2080|\tif manifest.ImplementationVersion != record.ImplementationVersion ||\n2081|\t\tmanifest.ImplementationKind != record.Kind ||\n2082|\t\t!equalStrings(manifest.ProtocolVersions, record.ProtocolVersions) ||\n2083|\t\t!equalPlatforms(manifest.Platforms, record.Platforms) {\n2084|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: manifest.TerminalBackendID, Detail: \"manifest implementation drift\"})\n2085|\t}\n2086|\tif manifest.ExecutableDigest != record.ExecutableDigest {\n2087|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: manifest.TerminalBackendID, Detail: \"executable substitution\"})\n2088|\t}\n2089|\treturn nil\n2090|}\n2091|\n2092|// equalPlatforms reports element-wise equality of two platform lists. Both\n2093|// lists are validated sorted unique, so order is significant.\n2094|func equalPlatforms(left, right []scalar.Platform) bool {\n2095|\tif len(left) != len(right) {\n2096|\t\treturn false\n2097|\t}\n2098|\tfor index := range left {\n2099|\t\tif left[index] != right[index] {\n2100|\t\t\treturn false\n2101|\t\t}\n2102|\t}\n2103|\treturn true\n2104|}\n2105|\n2106|// parseRealmProvider validates the provider_id/provider_build pair: null or\n2107|// a provider-id grammar value plus a string[1..256] build.\n2108|func parseRealmProvider(object map[string]any) (string, string, error) {\n2109|\trawID, known := object[\"provider_id\"]\n2110|\tif !known {\n2111|\t\treturn \"\", \"\", mismatchf(\"document members\")\n2112|\t}\n2113|\tproviderID := \"\"\n2114|\tif rawID != nil {\n2115|\t\tname, ok := rawID.(string)\n2116|\t\tif !ok {\n2117|\t\t\treturn \"\", \"\", mismatchf(\"document member type\")\n2118|\t\t}\n2119|\t\tif _, err := scalar.ParseProviderID(name); err != nil {\n2120|\t\t\treturn \"\", \"\", mismatchf(\"evidence provider identity\")\n2121|\t\t}\n2122|\t\tproviderID = name\n2123|\t}\n2124|\trawBuild, known := object[\"provider_build\"]\n2125|\tif !known {\n2126|\t\treturn \"\", \"\", mismatchf(\"document members\")\n2127|\t}\n2128|\tproviderBuild := \"\"\n2129|\tif rawBuild != nil {\n2130|\t\tbuild, ok := rawBuild.(string)\n2131|\t\tif !ok {\n2132|\t\t\treturn \"\", \"\", mismatchf(\"document member type\")\n2133|\t\t}\n2134|\t\tif !utf8.ValidString(build) || utf8.RuneCountInString(build) < 1 || utf8.RuneCountInString(build) > maxOpaqueString {\n2135|\t\t\treturn \"\", \"\", mismatchf(\"document string bound\")\n2136|\t\t}\n2137|\t\tproviderBuild = build\n2138|\t}\n2139|\tif (providerID == \"\") != (providerBuild == \"\") {\n2140|\t\treturn \"\", \"\", mismatchf(\"evidence realm binding\")\n2141|\t}\n2142|\treturn providerID, providerBuild, nil\n2143|}\n2144|\n2145|// parseRealmLiteral validates a literal passed|null realm member.\n2146|func parseRealmLiteral(object map[string]any, name string) (string, error) {\n2147|\traw, known := object[name]\n2148|\tif !known {\n2149|\t\treturn \"\", mismatchf(\"document members\")\n2150|\t}\n2151|\tif raw == nil {\n2152|\t\treturn \"\", nil\n2153|\t}\n2154|\tvalue, ok := raw.(string)\n2155|\tif !ok || value != \"passed\" {\n2156|\t\treturn \"\", mismatchf(\"evidence realm result\")\n2157|\t}\n2158|\treturn value, nil\n2159|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"a4c6f478-3cd1-45a5-8886-8a3daf65ec83"},"task_id":"a4c6f478-3cd1-45a5-8886-8a3daf65ec83","event":{"kind":"completed","task_id":"a4c6f478-3cd1-45a5-8886-8a3daf65ec83"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"call_id":"call_01a07a5f4fcd76b0abbbf170387ce751","text":"Read text file `internal/terminalbackend/manifest.go`.\n(1659 line(s) above)\n1660|\tif operation == \"manifest\" || operation == \"probe\" {\n1661|\t\treturn nil\n1662|\t}\n1663|\tif !admitted.HasOperation(operation) {\n1664|\t\treturn refuse(&Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"})\n1665|\t}\n1666|\treturn nil\n1667|}\n1668|\n1669|// Reconcile admits one Probe against its Manifest with the returned\n1670|// evidence set, binding everything to the AX-known raw generation and the\n1671|// admission instant (§4.B keyed relation, §4.D evidence binding). The check\n1672|// order is deterministic: identity equality, protocol/platform membership,\n1673|// generation binding, claim relation, per-object evidence usability\n1674|// (tuple binding, liveness, signature), per-claim requirement coverage,\n1675|// then the exact evidence_ids set rule. The first failure wins; every\n1676|// failure fails closed before activation.\n1677|//\n1678|// Each supplied evidence object must independently prove its named claim:\n1679|// split-facts evidence (requirement coverage spread across several objects,\n1680|// none sufficient alone) is refused. That reading follows the singular\n1681|// rule-5 phrasing (\"Capability Evidence ... satisfies every listed evidence\n1682|// requirement\") and is stated here as the bound.\n1683|func Reconcile(manifest Manifest, probe Probe, evidence []Evidence, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1684|\tif verify == nil {\n1685|\t\treturn Admitted{}, integrityFailure(\"evidence signature verifier\")\n1686|\t}\n1687|\tif err := checkProbeIdentity(manifest, probe); err != nil {\n1688|\t\treturn Admitted{}, err\n1689|\t}\n1690|\tif err := checkProbeMembership(manifest, probe); err != nil {\n1691|\t\treturn Admitted{}, err\n1692|\t}\n1693|\tif err := checkProbeGeneration(probe, rawGeneration); err != nil {\n1694|\t\treturn Admitted{}, err\n1695|\t}\n1696|\tmanifestClaims := indexClaims(manifest.StaticCapabilityClaims)\n1697|\tif err := checkClaimRelation(manifestClaims, probe.CapabilityClaims); err != nil {\n1698|\t\treturn Admitted{}, err\n1699|\t}\n1700|\tprobeClaims := indexClaims(probe.CapabilityClaims)\n1701|\tused, err := checkEvidenceSet(manifest, probe, probeClaims, evidence, now, verify)\n1702|\tif err != nil {\n1703|\t\treturn Admitted{}, err\n1704|\t}\n1705|\tif err := checkEvidenceCoverage(probeClaims, used); err != nil {\n1706|\t\treturn Admitted{}, err\n1707|\t}\n1708|\tif err := checkEvidenceIDs(probe, used); err != nil {\n1709|\t\treturn Admitted{}, err\n1710|\t}\n1711|\treturn admitCapabilities(probeClaims, used), nil\n1712|}\n1713|\n1714|// checkProbeIdentity enforces the §4.B identity equalities. Executable\n1715|// substitution additionally maps to the more specific untrusted code.\n1716|func checkProbeIdentity(manifest Manifest, probe Probe) error {\n1717|\tif probe.TerminalBackendID != manifest.TerminalBackendID ||\n1718|\t\tprobe.ImplementationVersion != manifest.ImplementationVersion ||\n1719|\t\tprobe.ImplementationKind != manifest.ImplementationKind {\n1720|\t\treturn mismatchf(\"probe manifest binding\")\n1721|\t}\n1722|\t// The backend IDs are already equal here (refused above), so a digest\n1723|\t// difference is always a substitution of the admitted executable: it\n1724|\t// is untrusted, never a plain mismatch.\n1725|\tif probe.ExecutableDigest != manifest.ExecutableDigest {\n1726|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: probe.TerminalBackendID, Detail: \"executable substitution\"})\n1727|\t}\n1728|\treturn nil\n1729|}\n1730|\n1731|// checkProbeMembership enforces array-to-scalar selection as membership:\n1732|// the probe protocol version must be exactly one Manifest member and the\n1733|// probe platform exactly one Manifest platform member.\n1734|func checkProbeMembership(manifest Manifest, probe Probe) error {\n1735|\tmember := false\n1736|\tfor _, version := range manifest.ProtocolVersions {\n1737|\t\tif probe.ProtocolVersion == version {\n1738|\t\t\tmember = true\n1739|\t\t\tbreak\n1740|\t\t}\n1741|\t}\n1742|\tif !member {\n1743|\t\treturn mismatchf(\"probe protocol membership\")\n1744|\t}\n1745|\tfor _, platform := range manifest.Platforms {\n1746|\t\tif probe.Platform == platform {\n1747|\t\t\treturn nil\n1748|\t\t}\n1749|\t}\n1750|\treturn mismatchf(\"probe platform membership\")\n1751|}\n1752|\n1753|// checkProbeGeneration binds the probe to the AX-known raw generation. A\n1754|// digest mismatch (or an underivable raw generation, including empty, which\n1755|// would make every backend share one digest) is stale, never a retry hint.\n1756|func checkProbeGeneration(probe Probe, rawGeneration string) error {\n1757|\tdigest, err := GenerationDigest(rawGeneration)\n1758|\tif err != nil {\n1759|\t\treturn err\n1760|\t}\n1761|\tif digest != probe.BackendGenerationDigest {\n1762|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: probe.TerminalBackendID, Detail: \"probe generation binding\"})\n1763|\t}\n1764|\treturn nil\n1765|}\n1766|\n1767|// indexClaims keys validated claims by capability. The validated lists are\n1768|// duplicate-free, so the index cannot collide.\n1769|func indexClaims(claims []Claim) map[string]Claim {\n1770|\tindexed := make(map[string]Claim, len(claims))\n1771|\tfor _, claim := range claims {\n1772|\t\tindexed[claim.Capability] = claim\n1773|\t}\n1774|\treturn indexed\n1775|}\n1776|\n1777|// checkClaimRelation enforces the complete §4.B keyed relation between the\n1778|// Manifest static claims M and the Probe claims P.\n1779|func checkClaimRelation(manifest map[string]Claim, probe []Claim) error {\n1780|\tfor _, proved := range probe {\n1781|\t\tcapability := proved.Capability\n1782|\t\tstatic, exists := manifest[capability]\n1783|\t\tswitch {\n1784|\t\tcase proved.Origin == OriginStatic && !exists:\n1785|\t\t\treturn mismatchf(\"probe static claim without manifest\")\n1786|\t\tcase proved.Origin == OriginStatic:\n1787|\t\t\tif !equalClaim(proved, static) {\n1788|\t\t\t\treturn mismatchf(\"probe static claim echo\")\n1789|\t\t\t}\n1790|\t\tcase exists && !static.GenerationVariable:\n1791|\t\t\treturn mismatchf(\"probe override of stable claim\")\n1792|\t\tcase exists:\n1793|\t\t\tif proved.GenerationVariable != static.GenerationVariable ||\n1794|\t\t\t\t!equalStrings(proved.DependentOperations, static.DependentOperations) ||\n1795|\t\t\t\t!equalStrings(proved.EvidenceRequirements, static.EvidenceRequirements) {\n1796|\t\t\t\treturn mismatchf(\"probe override registry binding\")\n1797|\t\t\t}\n1798|\t\tdefault:\n1799|\t\t\trow := capabilityRegistry[proved.Capability]\n1800|\t\t\tif proved.GenerationVariable != row.generationVariable ||\n1801|\t\t\t\t!equalStrings(proved.DependentOperations, row.dependentOperations) ||\n1802|\t\t\t\t!equalStrings(proved.EvidenceRequirements, row.evidenceRequirements) {\n1803|\t\t\t\treturn mismatchf(\"probe addition registry binding\")\n1804|\t\t\t}\n1805|\t\t}\n1806|\t}\n1807|\tfor capability := range manifest {\n1808|\t\tif _, present := indexProbeCapability(probe, capability); !present {\n1809|\t\t\treturn mismatchf(\"probe omission of manifest claim\")\n1810|\t\t}\n1811|\t}\n1812|\treturn nil\n1813|}\n1814|\n1815|// indexProbeCapability reports whether the probe lists the capability. The\n1816|// probe list is validated duplicate-free, so presence is unambiguous.\n1817|func indexProbeCapability(probe []Claim, capability string) (Claim, bool) {\n1818|\tfor _, claim := range probe {\n1819|\t\tif claim.Capability == capability {\n1820|\t\t\treturn claim, true\n1821|\t\t}\n1822|\t}\n1823|\treturn Claim{}, false\n1824|}\n1825|\n1826|// checkEvidenceSet validates every supplied evidence object: it must name a\n1827|// present true probe claim, bind to this exact Manifest/Probe tuple, be\n1828|// live at now, and carry a valid attestation signature. Expired,\n1829|// wrong-generation, dangling, or otherwise unusable evidence refuses the\n1830|// whole reconciliation (§4.B); a forged or unverifiable signature is an\n1831|// integrity failure. The returned objects are the usable set that coverage\n1832|// and ID-set checks consume.\n1833|func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\n1834|\tused := make([]Evidence, 0, len(evidence))\n1835|\tseen := make(map[string]Evidence, len(evidence))\n1836|\tfor _, object := range evidence {\n1837|\t\tclaim, present := probeClaims[object.Capability]\n1838|\t\tif !present || !claim.Value {\n1839|\t\t\treturn nil, mismatchf(\"evidence claim binding\")\n1840|\t\t}\n1841|\t\tif err := checkEvidenceTuple(manifest, probe, object); err != nil {\n1842|\t\t\treturn nil, err\n1843|\t\t}\n1844|\t\tif err := checkEvidenceLiveness(object, now); err != nil {\n1845|\t\t\treturn nil, err\n1846|\t\t}\n1847|\t\tif previous, duplicate := seen[object.EvidenceID]; duplicate {\n1848|\t\t\tif !equalEvidence(previous, object) {\n1849|\t\t\t\treturn nil, mismatchf(\"conflicting evidence\")\n1850|\t\t\t}\n1851|\t\t\tcontinue\n1852|\t\t}\n1853|\t\tseen[object.EvidenceID] = object\n1854|\t\tif err := checkEvidenceSignature(object, verify); err != nil {\n1855|\t\t\treturn nil, err\n1856|\t\t}\n1857|\t\tused = append(used, object)\n1858|\t}\n1859|\treturn used, nil\n1860|}\n1861|\n1862|// equalEvidence reports whether two evidence objects with the same ID carry\n1863|// identical members. Same-ID differing-bytes objects are conflicting\n1864|// evidence and invalidate the whole Probe.\n1865|func equalEvidence(left, right Evidence) bool {\n1866|\tif left.TerminalBackendID != right.TerminalBackendID ||\n1867|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n1868|\t\tleft.ProtocolVersion != right.ProtocolVersion ||\n1869|\t\tleft.BackendGenerationDigest != right.BackendGenerationDigest ||\n1870|\t\tleft.Capability != right.Capability ||\n1871|\t\tleft.Platform != right.Platform ||\n1872|\t\tleft.OSVersion != right.OSVersion ||\n1873|\t\tleft.ConformanceFixtureID != right.ConformanceFixtureID ||\n1874|\t\tleft.ObservedAt.String() != right.ObservedAt.String() ||\n1875|\t\tleft.ExpiresAt.String() != right.ExpiresAt.String() ||\n1876|\t\tleft.Issuer != right.Issuer ||\n1877|\t\tleft.IssuerID != right.IssuerID ||\n1878|\t\t!equalStrings(left.Facts, right.Facts) ||\n1879|\t\tleft.TerminalBindingID != right.TerminalBindingID ||\n1880|\t\tleft.ProviderID != right.ProviderID ||\n1881|\t\tleft.ProviderBuild != right.ProviderBuild ||\n1882|\t\tleft.SentinelResult != right.SentinelResult ||\n1883|\t\tleft.ProviderAuthSmokeResult != right.ProviderAuthSmokeResult {\n1884|\t\treturn false\n1885|\t}\n1886|\treturn bytes.Equal(left.AttestationSignature, right.AttestationSignature)\n1887|}\n1888|\n1889|// checkEvidenceTuple binds one evidence object to this exact Manifest/Probe\n1890|// tuple: backend, versions, generation digest, platform, os_version, and\n1891|// the Manifest conformance fixture must all match.\n1892|func checkEvidenceTuple(manifest Manifest, probe Probe, object Evidence) error {\n1893|\tif object.TerminalBackendID != probe.TerminalBackendID ||\n1894|\t\tobject.ImplementationVersion != probe.ImplementationVersion ||\n1895|\t\tobject.ProtocolVersion != probe.ProtocolVersion ||\n1896|\t\tobject.BackendGenerationDigest != probe.BackendGenerationDigest ||\n1897|\t\tobject.Platform != probe.Platform ||\n1898|\t\tobject.OSVersion != probe.OSVersion ||\n1899|\t\tobject.ConformanceFixtureID != manifest.ConformanceFixtureID {\n1900|\t\treturn mismatchf(\"evidence tuple binding\")\n1901|\t}\n1902|\treturn nil\n1903|}\n1904|\n1905|// checkEvidenceLiveness requires observed_at <= now < expires_at. Future\n1906|// observed instants and expired objects are both unusable: the former is\n1907|// not yet proof, the latter no longer is.\n1908|func checkEvidenceLiveness(object Evidence, now time.Time) error {\n1909|\tobserved, err := object.ObservedAt.Time()\n1910|\tif err != nil {\n1911|\t\treturn mismatchf(\"document timestamp\")\n1912|\t}\n1913|\texpires, err := object.ExpiresAt.Time()\n1914|\tif err != nil {\n1915|\t\treturn mismatchf(\"document timestamp\")\n1916|\t}\n1917|\tif observed.After(now) || !now.Before(expires) {\n1918|\t\treturn mismatchf(\"evidence liveness\")\n1919|\t}\n1920|\treturn nil\n1921|}\n1922|\n1923|// checkEvidenceSignature verifies the attestation through the caller's\n1924|// trusted key registry. Missing, unknown-key, or invalid signatures fail\n1925|// closed before capability admission; a caller-supplied issuer ID alone is\n1926|// never authentication.\n1927|func checkEvidenceSignature(object Evidence, verify SignatureVerifier) error {\n1928|\tmessage, err := UnsignedEvidenceBytes(object)\n1929|\tif err != nil {\n1930|\t\treturn err\n1931|\t}\n1932|\tif err := verify(object.IssuerID, message, object.AttestationSignature); err != nil {\n1933|\t\treturn integrityFailure(\"evidence attestation\")\n1934|\t}\n1935|\treturn nil\n1936|}\n1937|\n1938|// checkEvidenceCoverage requires every true probe claim to hold at least\n1939|// one usable evidence object whose facts cover every listed requirement\n1940|// through the requirement-to-fact mapping. False claims need no evidence\n1941|// and take none: evidence for a false claim was already refused as\n1942|// unbound in checkEvidenceSet.\n1943|func checkEvidenceCoverage(probeClaims map[string]Claim, used []Evidence) error {\n1944|\tbyCapability := make(map[string][]Evidence, len(used))\n1945|\tfor _, object := range used {\n1946|\t\tbyCapability[object.Capability] = append(byCapability[object.Capability], object)\n1947|\t}\n1948|\tfor capability, claim := range probeClaims {\n1949|\t\tif !claim.Value {\n1950|\t\t\tcontinue\n1951|\t\t}\n1952|\t\tcovered := false\n1953|\t\tfor _, object := range byCapability[capability] {\n1954|\t\t\tif factsCover(object.Facts, claim.EvidenceRequirements) {\n1955|\t\t\t\tcovered = true\n1956|\t\t\t\tbreak\n1957|\t\t\t}\n1958|\t\t}\n1959|\t\tif !covered {\n1960|\t\t\treturn mismatchf(\"evidence requirement coverage\")\n1961|\t\t}\n1962|\t}\n1963|\treturn nil\n1964|}\n1965|\n1966|// factsCover reports whether the fact set satisfies every listed\n1967|// requirement through the requirement-to-fact mapping. Supplementary facts\n1968|// (ui_absent, prompt_absent) never satisfy a requirement alone.\n1969|func factsCover(facts []string, requirements []string) bool {\n1970|\theld := make(map[string]bool, len(facts))\n1971|\tfor _, fact := range facts {\n1972|\t\theld[fact] = true\n1973|\t}\n1974|\tfor _, requirement := range requirements {\n1975|\t\tif !held[requirementFact[requirement]] {\n1976|\t\t\treturn false\n1977|\t\t}\n1978|\t}\n1979|\treturn true\n1980|}\n1981|\n1982|// checkEvidenceIDs enforces the exact rule-6 set equality: evidence_ids\n1983|// must be exactly the sorted unique IDs of the usable evidence objects.\n1984|// Dangling IDs, unlisted usable objects, and ordering deviations all fail.\n1985|func checkEvidenceIDs(probe Probe, used []Evidence) error {\n1986|\twant := make([]string, 0, len(used))\n1987|\tfor _, object := range used {\n1988|\t\twant = append(want, object.EvidenceID)\n1989|\t}\n1990|\tfor index := range want {\n1991|\t\tfor next := index + 1; next < len(want); next++ {\n1992|\t\t\tif want[next] < want[index] {\n1993|\t\t\t\twant[index], want[next] = want[next], want[index]\n1994|\t\t\t}\n1995|\t\t}\n1996|\t}\n1997|\tif !equalStrings(probe.EvidenceIDs, want) {\n1998|\t\treturn mismatchf(\"evidence id set binding\")\n1999|\t}\n2000|\treturn nil\n2001|}\n2002|\n2003|// admitCapabilities collects the sorted admitted true-claim names and the\n2004|// sorted evidence IDs that proved them.\n2005|func admitCapabilities(probeClaims map[string]Claim, used []Evidence) Admitted {\n2006|\tvar capabilities []string\n2007|\tfor capability, claim := range probeClaims {\n2008|\t\tif claim.Value {\n2009|\t\t\tcapabilities = append(capabilities, capability)\n2010|\t\t}\n2011|\t}\n2012|\tfor index := range capabilities {\n2013|\t\tfor next := index + 1; next < len(capabilities); next++ {\n2014|\t\t\tif capabilities[next] < capabilities[index] {\n2015|\t\t\t\tcapabilities[index], capabilities[next] = capabilities[next], capabilities[index]\n2016|\t\t\t}\n2017|\t\t}\n2018|\t}\n2019|\tevidenceIDs := make([]string, 0, len(used))\n2020|\tfor _, object := range used {\n2021|\t\tevidenceIDs = append(evidenceIDs, object.EvidenceID)\n2022|\t}\n2023|\tfor index := range evidenceIDs {\n2024|\t\tfor next := index + 1; next < len(evidenceIDs); next++ {\n2025|\t\t\tif evidenceIDs[next] < evidenceIDs[index] {\n2026|\t\t\t\tevidenceIDs[index], evidenceIDs[next] = evidenceIDs[next], evidenceIDs[index]\n2027|\t\t\t}\n2028|\t\t}\n2029|\t}\n2030|\treturn Admitted{Capabilities: capabilities, EvidenceIDs: evidenceIDs}\n2031|}\n2032|\n2033|// AdmitProbe is the registry-bound production admission: it parses the\n2034|// Manifest, resolves the backend through the admitted registry (unknown\n2035|// identities fail closed, never default), binds the Manifest identity tuple\n2036|// to the admitted record, then reconciles the Probe with its evidence set.\n2037|// Trust is established before any probe: registration-time trust admission\n2038|// owns executables, and this gate additionally refuses executable\n2039|// substitution as untrusted and any other identity drift as drift.\n2040|//\n2041|// rawGeneration is the AX-known current raw generation for the backend;\n2042|// now is the admission instant; verify authenticates evidence through the\n2043|// trusted key registry and must be non-nil.\n2044|func (registry *Registry) AdmitProbe(manifestRaw, probeRaw []byte, evidenceRaws [][]byte, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n2045|\tif registry == nil {\n2046|\t\treturn Admitted{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n2047|\t}\n2048|\tmanifest, err := ParseManifest(manifestRaw)\n2049|\tif err != nil {\n2050|\t\treturn Admitted{}, err\n2051|\t}\n2052|\trecord, err := registry.Resolve(manifest.TerminalBackendID)\n2053|\tif err != nil {\n2054|\t\treturn Admitted{}, err\n2055|\t}\n2056|\tif err := checkManifestRecordBinding(manifest, record); err != nil {\n2057|\t\treturn Admitted{}, err\n2058|\t}\n2059|\tprobe, err := ParseProbe(probeRaw)\n2060|\tif err != nil {\n2061|\t\treturn Admitted{}, err\n2062|\t}\n2063|\tevidence := make([]Evidence, 0, len(evidenceRaws))\n2064|\tfor _, raw := range evidenceRaws {\n2065|\t\tobject, err := ParseEvidence(raw)\n2066|\t\tif err != nil {\n2067|\t\t\treturn Admitted{}, err\n2068|\t\t}\n2069|\t\tevidence = append(evidence, object)\n2070|\t}\n2071|\treturn Reconcile(manifest, probe, evidence, rawGeneration, now, verify)\n2072|}\n2073|\n2074|// checkManifestRecordBinding binds the Manifest identity tuple to the\n2075|// admitted registry record: implementation version, protocol set, platform\n2076|// set, and kind must match member-for-member, and the executable digest\n2077|// must match exactly. Any version/kind/platform drift is drift; an\n2078|// executable substitution is untrusted.\n2079|func checkManifestRecordBinding(manifest Manifest, record Registration) error {\n2080|\tif manifest.ImplementationVersion != record.ImplementationVersion ||\n2081|\t\tmanifest.ImplementationKind != record.Kind ||\n2082|\t\t!equalStrings(manifest.ProtocolVersions, record.ProtocolVersions) ||\n2083|\t\t!equalPlatforms(manifest.Platforms, record.Platforms) {\n2084|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: manifest.TerminalBackendID, Detail: \"manifest implementation drift\"})\n2085|\t}\n2086|\tif manifest.ExecutableDigest != record.ExecutableDigest {\n2087|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: manifest.TerminalBackendID, Detail: \"executable substitution\"})\n2088|\t}\n2089|\treturn nil\n2090|}\n2091|\n2092|// equalPlatforms reports element-wise equality of two platform lists. Both\n2093|// lists are validated sorted unique, so order is significant.\n2094|func equalPlatforms(left, right []scalar.Platform) bool {\n2095|\tif len(left) != len(right) {\n2096|\t\treturn false\n2097|\t}\n2098|\tfor index := range left {\n2099|\t\tif left[index] != right[index] {\n2100|\t\t\treturn false\n2101|\t\t}\n2102|\t}\n2103|\treturn true\n2104|}\n2105|\n2106|// parseRealmProvider validates the provider_id/provider_build pair: null or\n2107|// a provider-id grammar value plus a string[1..256] build.\n2108|func parseRealmProvider(object map[string]any) (string, string, error) {\n2109|\trawID, known := object[\"provider_id\"]\n2110|\tif !known {\n2111|\t\treturn \"\", \"\", mismatchf(\"document members\")\n2112|\t}\n2113|\tproviderID := \"\"\n2114|\tif rawID != nil {\n2115|\t\tname, ok := rawID.(string)\n2116|\t\tif !ok {\n2117|\t\t\treturn \"\", \"\", mismatchf(\"document member type\")\n2118|\t\t}\n2119|\t\tif _, err := scalar.ParseProviderID(name); err != nil {\n2120|\t\t\treturn \"\", \"\", mismatchf(\"evidence provider identity\")\n2121|\t\t}\n2122|\t\tproviderID = name\n2123|\t}\n2124|\trawBuild, known := object[\"provider_build\"]\n2125|\tif !known {\n2126|\t\treturn \"\", \"\", mismatchf(\"document members\")\n2127|\t}\n2128|\tproviderBuild := \"\"\n2129|\tif rawBuild != nil {\n2130|\t\tbuild, ok := rawBuild.(string)\n2131|\t\tif !ok {\n2132|\t\t\treturn \"\", \"\", mismatchf(\"document member type\")\n2133|\t\t}\n2134|\t\tif !utf8.ValidString(build) || utf8.RuneCountInString(build) < 1 || utf8.RuneCountInString(build) > maxOpaqueString {\n2135|\t\t\treturn \"\", \"\", mismatchf(\"document string bound\")\n2136|\t\t}\n2137|\t\tproviderBuild = build\n2138|\t}\n2139|\tif (providerID == \"\") != (providerBuild == \"\") {\n2140|\t\treturn \"\", \"\", mismatchf(\"evidence realm binding\")\n2141|\t}\n2142|\treturn providerID, providerBuild, nil\n2143|}\n2144|\n2145|// parseRealmLiteral validates a literal passed|null realm member.\n2146|func parseRealmLiteral(object map[string]any, name string) (string, error) {\n2147|\traw, known := object[name]\n2148|\tif !known {\n2149|\t\treturn \"\", mismatchf(\"document members\")\n2150|\t}\n2151|\tif raw == nil {\n2152|\t\treturn \"\", nil\n2153|\t}\n2154|\tvalue, ok := raw.(string)\n2155|\tif !ok || value != \"passed\" {\n2156|\t\treturn \"\", mismatchf(\"evidence realm result\")\n2157|\t}\n2158|\treturn value, nil\n2159|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
