tation_version semver\", 1, \"RegisterExternal\", \"\", nil},\n755|\t{\"terminalbackend.go\", \"Registration.validate\", \"CodeUntrusted\", \"executable_digest\", 1, \"RegisterExternal\", \"\", nil},\n756|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeAmbiguous\", \"duplicate backend_id\", 1, \"RegisterExternal\", \"\", nil},\n757|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeAmbiguous\", \"external_trust identity binding\", 1, \"RegisterExternal\", \"\", nil},\n758|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeDrift\", \"implementation drift\", 1, \"RegisterExternal\", \"\", nil},\n759|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeNotFound\", \"registry unavailable\", 1, \"RegisterExternal\", \"\", nil},\n760|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeUntrusted\", \"executable substitution\", 1, \"RegisterExternal\", \"\", nil},\n761|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeUntrusted\", \"external implementation_kind\", 1, \"RegisterExternal\", \"\", nil},\n762|\t{\"terminalbackend.go\", \"Registry.RegisterExternal\", \"CodeUntrusted\", \"external_trust disabled\", 1, \"RegisterExternal\", \"\", nil},\n763|\t{\"terminalbackend.go\", \"Registry.RequireRestoreBinding\", \"CodeNotFound\", \"registry unavailable\", 1, \"RequireRestoreBinding\", \"\", nil},\n764|\t{\"terminalbackend.go\", \"Registry.RequireRestoreBinding\", \"CodeRestoreMismatch\", \"restore requires the prior binding\", 1, \"RequireRestoreBinding\", \"\", nil},\n765|\t{\"terminalbackend.go\", \"Registry.Resolve\", \"CodeNotFound\", \"registry unavailable\", 1, \"Resolve\", \"\", nil},\n766|\t{\"terminalbackend.go\", \"Registry.Resolve\", \"CodeNotFound\", \"unregistered terminal_backend_id\", 1, \"Resolve\", \"\", nil},\n767|\t{\"terminalbackend.go\", \"TrustEntry.validate\", \"CodeAmbiguous\", \"external_trust reserved namespace\", 1, \"RegisterExternal\", \"\", nil},\n768|\t{\"terminalbackend.go\", \"TrustEntry.validate\", \"CodeUntrusted\", \"external_trust executable_digest\", 1, \"RegisterExternal\", \"\", nil},\n769|\t{\"terminalbackend.go\", \"TrustEntry.validate\", \"CodeUntrusted\", \"external_trust executable_path\", 1, \"RegisterExternal\", \"\", nil},\n770|\t{\"terminalbackend.go\", \"checkGeneration\", \"CodeStaleGeneration\", \"backend_generation bound\", 1, \"CheckProviderDescriptor\", \"\", nil},\n771|\t{\"terminalbackend.go\", \"parseKind\", \"CodeNotFound\", \"implementation_kind vocabulary\", 1, \"RegisterExternal\", boundUnreachableKind, nil},\n772|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions bound\", 1, \"New\", \"\", nil},\n773|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions major 1\", 1, \"RegisterExternal\", \"\", nil},\n774|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions sorted unique\", 1, \"New\", \"\", nil},\n775|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor member set\", 1, \"ParseProviderDescriptor\", \"\", nil},\n776|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor member set\", 2, \"ParseProviderDescriptor\", \"\", nil},\n777|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor digest\", 1, \"ParseProviderDescriptor\", \"\", nil},\n778|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor instance\", 1, \"ParseProviderDescriptor\", \"\", nil},\n779|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor implementation version\", 1, \"ParseProviderDescriptor\", \"\", nil},\n780|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor protocol version\", 1, \"ParseProviderDescriptor\", \"\", nil},\n781|\t{\"descriptor.go\", \"ParseProviderDescriptor\", \"CodeProtocolError\", \"descriptor interactive\", 1, \"ParseProviderDescriptor\", \"\", nil},\n782|\t{\"descriptor.go\", \"descriptorText\", \"CodeProtocolError\", \"descriptor member type\", 1, \"ParseProviderDescriptor\", \"\", nil},\n783|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry type\", 1, \"ParseProviderDescriptor\", \"\", nil},\n784|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry digits\", 1, \"ParseProviderDescriptor\", \"\", nil},\n785|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry bound\", 1, \"ParseProviderDescriptor\", \"\", nil},\n786|\t{\"descriptor.go\", \"descriptorGeometry\", \"CodeProtocolError\", \"descriptor geometry bound\", 2, \"ParseProviderDescriptor\", \"\", nil},\n787|}\n788|\n789|// funneledPlatformDetails is the exact error set validatePlatforms can\n790|// produce, funneled through the single Registration.validate arm below.\n791|// TestPlatformFunnelDetailsAreExactlyThese derives the set from the\n792|// production AST and requires equality, so a fourth platform error is a\n793|// red rather than a silently widened funnel.\n794|var funneledPlatformDetails = []string{\n795|\t\"platforms bound\",\n796|\t\"platforms vocabulary\",\n797|\t\"platforms sorted unique\",\n798|}\n799|\n800|// funneledPlatformArm declares the single dynamic-detail arm. Its tests\n801|// must mention every funneled detail, not just one of them.\n802|var funneledPlatformArm = declaredRefusalArm{\n803|\tfile: \"terminalbackend.go\", function: \"Registration.validate\",\n804|\tcode: \"CodeNotFound\", detail: passthroughDetail, occurrence: 1,\n805|\tentry: \"RegisterExternal\",\n806|}\n807|\n808|// armlessCodes names wire codes with no refusal arm by design.\n809|// CodeUnavailable appears only inside the allowed-error sets; no\n810|// conformance refusal emits it, so it carries no arm of its own.\n811|var armlessCodes = map[string]bool{\n812|\t\"CodeUnavailable\": true,\n813|}\n814|\n815|// plainErrorFunctions names the only production functions allowed to\n816|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n817|// DigestFile reports I/O failures that must never be wire errors.\n818|var plainErrorFunctions = map[string]bool{\n819|\t\"validatePlatforms\": true,\n820|\t\"DigestFile\":        true,\n821|}\n822|\n823|// armInventoryKeys renders derived arms and declared rows into one shared\n824|// key space for the core both-direction harness.\n825|func armInventoryKeys(derived []refusalArm, rows []declaredRefusalArm) (map[string]struct{}, map[string]struct{}) {\n826|\tderivedKeys := make(map[string]struct{}, len(derived))\n827|\tfor _, arm := range derived {\n828|\t\tderivedKeys[describeArm(arm)] = struct{}{}\n829|\t}\n830|\trowKeys := make(map[string]struct{}, len(rows))\n831|\tfor _, row := range rows {\n832|\t\tkey := describeRow(row)\n833|\t\tif _, duplicate := rowKeys[key]; duplicate {\n834|\t\t\trowKeys[\"DUPLICATE-ROW:\"+key] = struct{}{}\n835|\t\t}\n836|\t\trowKeys[key] = struct{}{}\n837|\t}\n838|\treturn derivedKeys, rowKeys\n839|}\n840|\n841|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n842|// arm the production AST derives resolves to exactly one declared row.\n843|// A brand-new arm with a brand-new detail fails here until its witness\n844|// is recorded.\n845|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n846|\tt.Parallel()\n847|\n848|\tderived, rows := armInventoryKeys(deriveRefusalArms(t), declaredRows())\n849|\tinvcore.MustCheckBothDirections(t, \"refusal-arm inventory\", derived, rows)\n850|}\n851|\n852|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n853|// declared row resolves to exactly one derived arm. Without it the\n854|// forward direction passes vacuously on a truncated derivation, and a\n855|// deleted production guard lingers as a row pointing at nothing.\n856|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n857|\tt.Parallel()\n858|\n859|\tderived, rows := armInventoryKeys(deriveRefusalArms(t), declaredRows())\n860|\tinvcore.MustCheckBothDirections(t, \"refusal-arm inventory\", derived, rows)\n861|}\n862|\n863|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n864|\treturn arm.file == row.file && arm.function == row.function &&\n865|\t\tarm.code == row.code && arm.detail == row.detail &&\n866|\t\tarm.occurrence == row.occurrence\n867|}\n868|\n869|func describeArm(arm refusalArm) string {\n870|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n871|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n872|}\n873|\n874|func describeRow(row declaredRefusalArm) string {\n875|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n876|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n877|}\n878|\n879|// declaredRows returns the table plus the funnel row.\n880|func declaredRows() []declaredRefusalArm {\n881|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n882|\tfunnel := funneledPlatformArm\n883|\tfunnel.detailSet = funneledPlatformDetails\n884|\treturn append(rows, funnel)\n885|}\n886|\n887|// ArmIdentity is the export bridge to the executed-witness registry in\n888|// refusal_arm_witnesses_test.go (package terminalbackend_test): one row\n889|// identity with the entry its witness drives, its bound (empty except\n890|// for arms no input can reach), and the funneled detail set for the\n891|// single dynamic-detail row.\n892|type ArmIdentity struct {\n893|\tFile       string\n894|\tFunction   string\n895|\tCode       string\n896|\tDetail     string\n897|\tOccurrence int\n898|\tEntry      string\n899|\tBound      string\n900|\tDetailSet  []string\n901|}\n902|\n903|// DeclaredArmIdentities exports every declared row identity for the\n904|// witness registry's reverse direction.\n905|func DeclaredArmIdentities() []ArmIdentity {\n906|\trows := declaredRows()\n907|\tidentities := make([]ArmIdentity, 0, len(rows))\n908|\tfor _, row := range rows {\n909|\t\tidentities = append(identities, ArmIdentity{\n910|\t\t\tFile: row.file, Function: row.function, Code: row.code,\n911|\t\t\tDetail: row.detail, Occurrence: row.occurrence,\n912|\t\t\tEntry: row.entry, Bound: row.bound, DetailSet: row.detailSet,\n913|\t\t})\n914|\t}\n915|\treturn identities\n916|}\n917|\n918|// DerivedArmIdentities exports every derived arm identity for the\n919|// witness registry's forward direction.\n920|func DerivedArmIdentities(t *testing.T) []ArmIdentity {\n921|\tt.Helper()\n922|\tderived := deriveRefusalArms(t)\n923|\tidentities := make([]ArmIdentity, 0, len(derived))\n924|\tfor _, arm := range derived {\n925|\t\tidentities = append(identities, ArmIdentity{\n926|\t\t\tFile: arm.file, Function: arm.function, Code: arm.code,\n927|\t\t\tDetail: arm.detail, Occurrence: arm.occurrence,\n928|\t\t})\n929|\t}\n930|\treturn identities\n931|}\n932|\n933|// ArmKey renders one identity in the shared witness key space.\n934|func ArmKey(identity ArmIdentity) string {\n935|\treturn identity.File + \"|\" + identity.Function + \"|\" + identity.Code + \"|\" +\n936|\t\tstrconv.Quote(identity.Detail) + \"#\" + strconv.Itoa(identity.Occurrence)\n937|}\n938|\n939|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n940|// production const values two ways: every row's code resolves to the\n941|// wire its test asserts, and every Code symbol except the named armless\n942|// one appears in at least one row, so a code nobody refuses is a red\n943|// rather than a quiet gap.\n944|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n945|\tt.Parallel()\n946|\n947|\tsymbols := productionCodeSymbols(t)\n948|\tcovered := make(map[string]bool)\n949|\tfor _, row := range declaredRows() {\n950|\t\twire, known := symbols[row.code]\n951|\t\tif !known {\n952|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n953|\t\t\t\tdescribeRow(row), row.code)\n954|\t\t\tcontinue\n955|\t\t}\n956|\t\tcovered[row.code] = true\n957|\t\t_ = wire\n958|\t}\n959|\tfor symbol := range symbols {\n960|\t\tif armlessCodes[symbol] {\n961|\t\t\tcontinue\n962|\t\t}\n963|\t\tif !covered[symbol] {\n964|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n965|\t\t}\n966|\t}\n967|}\n968|\n969|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n970|// defensive arm must join this set deliberately, with its bound stated,\n971|// rather than slipping in as an ordinary row whose test cannot reach it.\n972|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n973|\tt.Parallel()\n974|\n975|\twant := map[string]string{\n976|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\":           boundDefensiveReparse,\n977|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\":           boundDefensiveReparse,\n978|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":                 boundDefensiveReparse,\n979|\t\t\"manifest.go ParseEvidence CodeMismatch \\\"document timestamp\\\" #1\":                         boundDefensiveReparse,\n980|\t\t\"manifest.go ParseEvidence CodeMismatch \\\"document timestamp\\\" #2\":                         boundDefensiveReparse,\n981|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":                 boundDefensiveReparse,\n982|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":                 boundDefensiveReparse,\n983|\t\t\"conformance.go CheckTransition CodeProtocolError \\\"operation vocabulary\\\" #1\":             boundUnreachableVocabulary,\n984|\t\t\"manifest.go decodeCappedValue CodeMismatch \\\"document syntax\\\" #3\":                        boundDecoderContract,\n985|\t\t\"manifest.go decodeCappedValue CodeMismatch \\\"document syntax\\\" #6\":                        boundDecoderContract,\n986|\t\t\"manifest.go objectIdentity CodeMismatch \\\"document identity\\\" #1\":                         boundCanonicalPlumbing,\n987|\t\t\"manifest.go objectIdentity CodeMismatch \\\"document identity\\\" #2\":                         boundCanonicalPlumbing,\n988|\t\t\"manifest.go UnsignedEvidenceBytes CodeIntegrityFailure \\\"evidence canonical bytes\\\" #1\":   boundCanonicalPlumbing,\n989|\t\t\"manifest.go UnsignedEvidenceBytes CodeIntegrityFailure \\\"evidence canonical bytes\\\" #2\":   boundCanonicalPlumbing,\n990|\t\t\"terminalbackend.go parseKind CodeNotFound \\\"implementation_kind vocabulary\\\" #1\":          boundUnreachableKind,\n991|\t\t\"manifest.go refuseIdentityNumbers CodeMismatch \\\"document member type\\\" #1\":               boundUnreachableNumbers,\n992|\t\t\"terminalbackend.go Registration.validate CodeDrift \\\"executable_digest must be null\\\" #1\": boundUnreachableDigestNull,\n993|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document members\\\" #1\":             boundShadowedLookup,\n994|\t\t\"manifest.go parseManifestObject CodeMismatch \\\"document members\\\" #1\":                     boundShadowedLookup,\n995|\t\t\"manifest.go ParseProbe CodeMismatch \\\"document members\\\" #1\":                              boundShadowedLookup,\n996|\t\t\"manifest.go digestOrNullMember CodeMismatch \\\"document members\\\" #1\":                      boundShadowedLookup,\n997|\t\t\"manifest.go stringArrayMember CodeMismatch \\\"document members\\\" #1\":                       boundShadowedLookup,\n998|\t\t\"manifest.go checkExtensions CodeMismatch \\\"document members\\\" #1\":                         boundShadowedLookup,\n999|\t\t\"manifest.go parseRealmProvider CodeMismatch \\\"document members\\\" #1\":                      boundShadowedLookup,\n(more lines below)"}}}
