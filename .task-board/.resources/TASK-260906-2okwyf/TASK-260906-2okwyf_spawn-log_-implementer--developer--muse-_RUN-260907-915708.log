{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f7","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":598,"recorded_at":1780531400001191,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"09b6de7d-ec7e-4b95-ae97-d00c1cd0d38d"},"task_id":"09b6de7d-ec7e-4b95-ae97-d00c1cd0d38d","event":{"kind":"output","task_id":"09b6de7d-ec7e-4b95-ae97-d00c1cd0d38d","chunk":"Read text file `internal/terminalbackend/descriptor.go`.\n1|// Provider Protocol 3.0.0 Terminal Instance descriptor admission.\n2|//\n3|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §7.A:\n4|// Provider Protocol 3.0.0 retains the exact v2 framing and replaces every\n5|// occurrence of the v2 TerminalDescriptor with one closed v3 object. This\n6|// file owns the v3-specific production rule: parsing the closed descriptor\n7|// document and matching it against the AX-validated host-local binding\n8|// before a provider process is launched or observed. Transport framing,\n9|// deadlines, and dispatch stay with the v2 machinery; the v3 failure-error\n10|// binding (Structured Error 1.3.0) is resolved through axerror.BindingFor\n11|// by the dual-stack host, which does not exist yet (see the stated bound\n12|// in internal/provhost/doc.go).\n13|//\n14|// The provider-side MUST this file enforces is: reject a descriptor whose\n15|// binding digest, backend ID/version, or generation does not match the\n16|// AX-validated host-local binding. Shape validation (the closed member set\n17|// and every per-member constraint) runs first so a malformed descriptor is\n18|// refused as a protocol violation, never compared as a binding.\n19|//\n20|// Future caller, recorded so the next leaf inherits the question rather\n21|// than rediscovering it: AdmitProviderDescriptor has no production caller\n22|// yet. It belongs on the v3 launch/observe path — the dual-stack host\n23|// follow-up named in internal/provhost/doc.go — which must admit the\n24|// candidate TerminalDescriptor against the AX-validated host-local\n25|// binding immediately before spawning the provider process (launch) and\n26|// before trusting a status observation (observe), and refuse the\n27|// operation on mismatch. Wiring it anywhere else (after spawn, on a\n28|// retry path that reuses an admitted descriptor without re-checking\n29|// generation) would admit a stale binding; the call order is parse,\n30|// match, then launch, with no caching of the admitted value across\n31|// generation changes.\n32|package terminalbackend\n33|\n34|import (\n35|\t\"encoding/json\"\n36|\n37|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n38|)\n39|\n40|// descriptorMembers is the exact closed §7.A member set: eight table rows,\n41|// nine members, because columns and rows are two members. No other member\n42|// is permitted. It is package-level so the inventory derivation sees the\n43|// single construction site; widening it must redden the member-set test,\n44|// not pass silently.\n45|var descriptorMembers = []string{\n46|\t\"terminal_binding_id\",\n47|\t\"terminal_instance_id\",\n48|\t\"terminal_backend_id\",\n49|\t\"implementation_version\",\n50|\t\"protocol_version\",\n51|\t\"backend_generation\",\n52|\t\"interactive\",\n53|\t\"columns\",\n54|\t\"rows\",\n55|}\n56|\n57|// ProviderDescriptor is one validated §7.A v3 TerminalDescriptor. Every\n58|// value is trustworthy only when produced by ParseProviderDescriptor: the\n59|// zero value is not valid (empty digest, empty generation, zero geometry),\n60|// and no constructor outside this file may mint one. Columns and Rows\n61|// carry the §7.A uint16[1..1000] bound; the Go type holds the uint16 half\n62|// and the parse entry holds the 1..1000 half.\n63|type ProviderDescriptor struct {\n64|\tTerminalBindingID     string\n65|\tTerminalInstanceID    string\n66|\tTerminalBackendID     string\n67|\tImplementationVersion string\n68|\tProtocolVersion       string\n69|\tBackendGeneration     string\n70|\tInteractive           bool\n71|\tColumns               uint16\n72|\tRows                  uint16\n73|}\n74|\n75|// Binding projects the AX-validated binding subset §7.A matches: binding\n76|// digest, backend ID, versions, and generation. Instance identity,\n77|// interactivity, and geometry are carried context, matched to nothing.\n78|func (descriptor ProviderDescriptor) Binding() InstanceBinding {\n79|\treturn InstanceBinding{\n80|\t\tBackendID:             descriptor.TerminalBackendID,\n81|\t\tImplementationVersion: descriptor.ImplementationVersion,\n82|\t\tProtocolVersion:       descriptor.ProtocolVersion,\n83|\t\tGeneration:            descriptor.BackendGeneration,\n84|\t\tTerminalBindingID:     descriptor.TerminalBindingID,\n85|\t}\n86|}\n87|\n88|// AdmitProviderDescriptor is the complete §7.A provider-side gate: parse\n89|// the closed descriptor document, then match it against the AX-validated\n90|// host-local binding. A malformed document is refused with\n91|// terminal_backend_protocol_error before any comparison runs; a\n92|// well-formed document that does not match is refused with the binding\n93|// arm CheckProviderDescriptor reports. Admitted documents return the\n94|// parsed descriptor for the launch path to carry.\n95|func AdmitProviderDescriptor(doc []byte, binding InstanceBinding) (ProviderDescriptor, error) {\n96|\tdescriptor, err := ParseProviderDescriptor(doc)\n97|\tif err != nil {\n98|\t\treturn ProviderDescriptor{}, err\n99|\t}\n100|\tif err := CheckProviderDescriptor(descriptor.Binding(), binding); err != nil {\n101|\t\treturn ProviderDescriptor{}, err\n102|\t}\n103|\treturn descriptor, nil\n104|}\n105|\n106|// ParseProviderDescriptor validates one closed §7.A descriptor document.\n107|// Member-set violations (an unknown member or a missing member) are one\n108|// arm: the rule is the closed set itself, and the member-set test\n109|// enumerates the extra, missing, and duplicate shapes against it. Member\n110|// type violations (a non-string string member) are one arm for the same\n111|// reason: JSON type discipline is one obligation, enumerated across all\n112|// six string members by the member-type test.\n113|func ParseProviderDescriptor(doc []byte) (ProviderDescriptor, error) {\n114|\tobject, err := decodeStrictObject(doc)\n115|\tif err != nil {\n116|\t\treturn ProviderDescriptor{}, err\n117|\t}\n118|\tif len(object) != len(descriptorMembers) {\n119|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor member set\"})\n120|\t}\n121|\tfor _, member := range descriptorMembers {\n122|\t\tif _, known := object[member]; !known {\n123|\t\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor member set\"})\n124|\t\t}\n125|\t}\n126|\tbindingID, err := descriptorText(object, \"terminal_binding_id\")\n127|\tif err != nil {\n128|\t\treturn ProviderDescriptor{}, err\n129|\t}\n130|\tif _, err := scalar.ParseDigest(bindingID); err != nil {\n131|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor digest\"})\n132|\t}\n133|\tinstanceID, err := descriptorText(object, \"terminal_instance_id\")\n134|\tif err != nil {\n135|\t\treturn ProviderDescriptor{}, err\n136|\t}\n137|\t// The UUIDv7 grammar is the decidable half of the §7.A identity rule:\n138|\t// a PID, socket, path, pipe, URL, handle, token, or native reference\n139|\t// cannot spell a 36-character hyphenated UUIDv7, so grammar admission\n140|\t// is identity-shape admission. The undecidable half (a UUIDv7 that\n141|\t// names no live instance) is the binding's business, not the\n142|\t// document's.\n143|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n144|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor instance\"})\n145|\t}\n146|\tbackendID, err := descriptorText(object, \"terminal_backend_id\")\n147|\tif err != nil {\n148|\t\treturn ProviderDescriptor{}, err\n149|\t}\n150|\tif _, err := ParseID(backendID); err != nil {\n151|\t\treturn ProviderDescriptor{}, err\n152|\t}\n153|\timplementationVersion, err := descriptorText(object, \"implementation_version\")\n154|\tif err != nil {\n155|\t\treturn ProviderDescriptor{}, err\n156|\t}\n157|\t// Shape only: equality to the admitted Manifest and Probe is the\n158|\t// binding match CheckProviderDescriptor performs against versions the\n159|\t// registry validated at admission, so a well-formed version here is\n160|\t// compared, never trusted, there.\n161|\tif !semverPattern.MatchString(implementationVersion) {\n162|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor implementation version\"})\n163|\t}\n164|\tprotocolVersion, err := descriptorText(object, \"protocol_version\")\n165|\tif err != nil {\n166|\t\treturn ProviderDescriptor{}, err\n167|\t}\n168|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n169|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor protocol version\"})\n170|\t}\n171|\tgeneration, err := descriptorText(object, \"backend_generation\")\n172|\tif err != nil {\n173|\t\treturn ProviderDescriptor{}, err\n174|\t}\n175|\t// The string[1..256] bound is the registry's own rule, enforced by\n176|\t// its own arm; a descriptor generation outside it is the same\n177|\t// violation wherever it is read.\n178|\tif err := checkGeneration(generation); err != nil {\n179|\t\treturn ProviderDescriptor{}, err\n180|\t}\n181|\tinteractive, ok := object[\"interactive\"].(bool)\n182|\tif !ok {\n183|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor interactive\"})\n184|\t}\n185|\tcolumns, err := descriptorGeometry(object, \"columns\")\n186|\tif err != nil {\n187|\t\treturn ProviderDescriptor{}, err\n188|\t}\n189|\trows, err := descriptorGeometry(object, \"rows\")\n190|\tif err != nil {\n191|\t\treturn ProviderDescriptor{}, err\n192|\t}\n193|\treturn ProviderDescriptor{\n194|\t\tTerminalBindingID:     bindingID,\n195|\t\tTerminalInstanceID:    instanceID,\n196|\t\tTerminalBackendID:     backendID,\n197|\t\tImplementationVersion: implementationVersion,\n198|\t\tProtocolVersion:       protocolVersion,\n199|\t\tBackendGeneration:     generation,\n200|\t\tInteractive:           interactive,\n201|\t\tColumns:               columns,\n202|\t\tRows:                  rows,\n203|\t}, nil\n204|}\n205|\n206|// descriptorText extracts a required string member. Numbers, booleans,\n207|// nulls, arrays, and objects are refused: no string member of the §7.A\n208|// descriptor takes them.\n209|func descriptorText(object map[string]any, name string) (string, error) {\n210|\tvalue, ok := object[name].(string)\n211|\tif !ok {\n212|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor member type\"})\n213|\t}\n214|\treturn value, nil\n215|}\n216|\n217|// descriptorGeometry extracts a required uint16[1..1000] member. The\n218|// strict decoder delivers numbers as json.Number, so the literal must\n219|// spell an unsigned integer: a fraction, exponent, or sign is not one,\n220|// even when it names the same mathematical value. Canonical geometry\n221|// carries counts, never measurements.\n222|func descriptorGeometry(object map[string]any, name string) (uint16, error) {\n223|\t// Three arms, one site each, shared by both geometry members: the JSON\n224|\t// number type, the unsigned-integer literal shape, and the 1..1000\n225|\t// bound are three distinct rules, and the geometry test enumerates the\n226|\t// columns shapes and the rows shapes against each of them.\n227|\tliteral, ok := object[name].(json.Number)\n228|\tif !ok {\n229|\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry type\"})\n230|\t}\n231|\tdigits := literal.String()\n232|\tvalue := 0\n233|\tfor i := 0; i < len(digits); i++ {\n234|\t\tdigit := digits[i]\n235|\t\tif digit < '0' || digit > '9' {\n236|\t\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry digits\"})\n237|\t\t}\n238|\t\t// Refuse on the first digit that would exceed the bound rather\n239|\t\t// than accumulating past it: value is at most 100 here, so the\n240|\t\t// multiply below cannot wrap on any platform, and a literal\n241|\t\t// naming more than 1000 is refused before its low bits can\n242|\t\t// alias an in-range number downstream would trust as read.\n243|\t\tif value > 100 {\n244|\t\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry bound\"})\n245|\t\t}\n246|\t\tvalue = value*10 + int(digit-'0')\n247|\t}\n248|\t// An empty literal spells no digits, so value stays 0 and lands on\n249|\t// the bound arm rather than needing an arm of its own.\n250|\tif value < 1 || value > 1000 {\n251|\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry bound\"})\n252|\t}\n253|\treturn uint16(value), nil\n254|}"}}}
