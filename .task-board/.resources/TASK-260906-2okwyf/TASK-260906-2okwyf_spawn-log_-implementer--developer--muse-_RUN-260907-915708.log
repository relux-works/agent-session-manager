{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fd","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":345,"recorded_at":1780531400000685,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"15f9de24-3821-40f9-b05d-182c4f9dd80d"},"task_id":"15f9de24-3821-40f9-b05d-182c4f9dd80d","event":{"kind":"output","task_id":"15f9de24-3821-40f9-b05d-182c4f9dd80d","chunk":"Read text file `internal/invcore/must.go`.\n1|// Must wrappers and the runtime site recorder for Package invcore.\n2|//\n3|// The Must wrappers fail the suite on any returned failure: production\n4|// inventories call these, while negative tests and control plants call\n5|// the pure funcs in invcore.go directly and assert on the returned\n6|// failures. A gate that can only fatal cannot be planted against.\n7|\n8|package invcore\n9|\n10|import (\n11|\t\"fmt\"\n12|\t\"go/ast\"\n13|\t\"go/token\"\n14|\t\"path/filepath\"\n15|\t\"runtime\"\n16|\t\"sort\"\n17|\t\"strings\"\n18|\t\"sync\"\n19|\t\"testing\"\n20|)\n21|\n22|// MustScanProduction scans dir and fails the suite on any fail-closed\n23|// condition: zero files, unreadable files, unparseable files.\n24|func MustScanProduction(t *testing.T, dir string) ([]ProductionFile, *token.FileSet) {\n25|\tt.Helper()\n26|\tfiles, fileSet, failures := ScanProduction(dir)\n27|\tfor _, failure := range failures {\n28|\t\tt.Error(failure)\n29|\t}\n30|\tif len(failures) > 0 {\n31|\t\tt.FailNow()\n32|\t}\n33|\treturn files, fileSet\n34|}\n35|\n36|// MustCheckBothDirections fails the suite when the derived set and the\n37|// declared row set differ in either direction: unregistered derived sites\n38|// or orphaned rows. A zero derived set fails even when rows are empty.\n39|func MustCheckBothDirections(t *testing.T, what string, derived, rows map[string]struct{}) {\n40|\tt.Helper()\n41|\tunregistered, orphaned, failures := DiffSets(derived, rows)\n42|\tfor _, failure := range failures {\n43|\t\tt.Errorf(\"%s: %s\", what, failure)\n44|\t}\n45|\tfor _, key := range unregistered {\n46|\t\tt.Errorf(\"%s: unregistered site with no declaring row, so nothing witnesses it: %s\", what, key)\n47|\t}\n48|\tfor _, key := range orphaned {\n49|\t\tt.Errorf(\"%s: orphan row with no derived site; a row without a site is a witness without a guard: %s\", what, key)\n50|\t}\n51|}\n52|\n53|// MustAuditConstructorReferences fails the suite on any constructor\n54|// reference outside direct-call position, including import-aliased and\n55|// var-bound shapes, and on any shape the audit cannot classify.\n56|func MustAuditConstructorReferences(t *testing.T, syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) {\n57|\tt.Helper()\n58|\tfor _, failure := range AuditConstructorReferences(syntax, fileSet, display, spec) {\n59|\t\tt.Error(failure)\n60|\t}\n61|}\n62|\n63|// SiteRecorder is the runtime direction of the alias-bypass union\n64|// (provider/provhost shape): instrumented constructor vars record the\n65|// production file:line behind every exercised refusal plus the stable\n66|// codes those refusals carried. The audit requires the exercised site set\n67|// to equal the derived site set in both directions, and the observed code\n68|// set to equal the closed code set exactly, so a constructor call the\n69|// tests never exercise fails forward, and a truncated derivation fails in\n70|// reverse even though the forward check passes vacuously.\n71|type SiteRecorder struct {\n72|\tmu    sync.Mutex\n73|\tsites map[string]struct{}\n74|\tcodes map[string]struct{}\n75|}\n76|\n77|// NewSiteRecorder returns an empty recorder.\n78|func NewSiteRecorder() *SiteRecorder {\n79|\treturn &SiteRecorder{sites: map[string]struct{}{}, codes: map[string]struct{}{}}\n80|}\n81|\n82|// Record notes one exercised refusal carrying code, attributing it to\n83|// the production file:line at runtime.Caller(skip+1): skip counts every\n84|// frame between Record and the site, including Record's own caller. A\n85|// record helper called from the swapped constructor var passes skip=2\n86|// (helper frame plus wrapper frame), matching the historical sync.Map\n87|// recorders' runtime.Caller(2) exactly.\n88|func (recorder *SiteRecorder) Record(code string, skip int) {\n89|\trecorder.mu.Lock()\n90|\tdefer recorder.mu.Unlock()\n91|\trecorder.codes[code] = struct{}{}\n92|\tif _, file, line, ok := runtime.Caller(skip + 1); ok {\n93|\t\trecorder.sites[filepath.Base(file)+\":\"+fmt.Sprint(line)] = struct{}{}\n94|\t}\n95|}\n96|\n97|// Snapshot returns deep copies of the exercised site and code sets for\n98|// tests that record bystander sites and must remove them before\n99|// returning, keeping the reverse-direction audit exact.\n100|func (recorder *SiteRecorder) Snapshot() (sites map[string]struct{}, codes map[string]struct{}) {\n101|\trecorder.mu.Lock()\n102|\tdefer recorder.mu.Unlock()\n103|\tsites = make(map[string]struct{}, len(recorder.sites))\n104|\tfor site := range recorder.sites {\n105|\t\tsites[site] = struct{}{}\n106|\t}\n107|\tcodes = make(map[string]struct{}, len(recorder.codes))\n108|\tfor code := range recorder.codes {\n109|\t\tcodes[code] = struct{}{}\n110|\t}\n111|\treturn sites, codes\n112|}\n113|\n114|// Restore resets the recorder to a prior snapshot, dropping every site\n115|// and code recorded since.\n116|func (recorder *SiteRecorder) Restore(sites map[string]struct{}, codes map[string]struct{}) {\n117|\trecorder.mu.Lock()\n118|\tdefer recorder.mu.Unlock()\n119|\trecorder.sites = make(map[string]struct{}, len(sites))\n120|\tfor site := range sites {\n121|\t\trecorder.sites[site] = struct{}{}\n122|\t}\n123|\trecorder.codes = make(map[string]struct{}, len(codes))\n124|\tfor code := range codes {\n125|\t\trecorder.codes[code] = struct{}{}\n126|\t}\n127|}\n128|\n129|// Sites returns the exercised production file:line set.\n130|func (recorder *SiteRecorder) Sites() map[string]struct{} {\n131|\trecorder.mu.Lock()\n132|\tdefer recorder.mu.Unlock()\n133|\tduplicated := make(map[string]struct{}, len(recorder.sites))\n134|\tfor site := range recorder.sites {\n135|\t\tduplicated[site] = struct{}{}\n136|\t}\n137|\treturn duplicated\n138|}\n139|\n140|// Codes returns the observed stable code set.\n141|func (recorder *SiteRecorder) Codes() []string {\n142|\trecorder.mu.Lock()\n143|\tdefer recorder.mu.Unlock()\n144|\tvar codes []string\n145|\tfor code := range recorder.codes {\n146|\t\tcodes = append(codes, code)\n147|\t}\n148|\tsort.Strings(codes)\n149|\treturn codes\n150|}\n151|\n152|// AuditSites compares the exercised set against the derived site set in\n153|// both directions and the observed codes against the closed set, returning\n154|// one failure per violated direction. Empty scanned or derived input fails\n155|// closed: a blind scan is not a measurement.\n156|func (recorder *SiteRecorder) AuditSites(what string, scanned int, derived map[string]struct{}, wantCodes []string) []string {\n157|\tvar failures []string\n158|\tif scanned == 0 {\n159|\t\tfailures = append(failures, what+\": scanned no production sources; the check is blind\")\n160|\t}\n161|\tif len(derived) == 0 {\n162|\t\tfailures = append(failures, what+\": derived no refusal sites; the scan is blind\")\n163|\t}\n164|\texercised := recorder.Sites()\n165|\tvar outside []string\n166|\tfor site := range exercised {\n167|\t\tif _, ok := derived[site]; !ok {\n168|\t\t\toutside = append(outside, site)\n169|\t\t}\n170|\t}\n171|\tsort.Strings(outside)\n172|\tif len(outside) != 0 {\n173|\t\tfailures = append(failures, what+\": exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n174|\t}\n175|\tvar missing []string\n176|\tfor site := range derived {\n177|\t\tif _, ok := exercised[site]; !ok {\n178|\t\t\tmissing = append(missing, site)\n179|\t\t}\n180|\t}\n181|\tsort.Strings(missing)\n182|\tif len(missing) != 0 {\n183|\t\tfailures = append(failures, what+\": derived refusal sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n184|\t}\n185|\tcodes := recorder.Codes()\n186|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", wantCodes) {\n187|\t\tfailures = append(failures, fmt.Sprintf(\"%s: observed refusal codes = %v, want closed set %v\", what, codes, wantCodes))\n188|\t}\n189|\treturn failures\n190|}"}}}
