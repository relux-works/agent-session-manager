{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c503","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":220,"recorded_at":1780531400000435,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"073c6cce-02ce-4f23-9f3f-5617ae20e49d"},"task_id":"073c6cce-02ce-4f23-9f3f-5617ae20e49d","event":{"kind":"output","task_id":"073c6cce-02ce-4f23-9f3f-5617ae20e49d","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"math\"\n20|\t\"os\"\n21|\t\"path/filepath\"\n22|\t\"regexp\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"sync\"\n26|\t\"unicode/utf8\"\n27|\n28|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n29|)\n30|\n31|// Wire error codes are the exact Section 15.3 codes the registry may report.\n32|// They are a subset of the pinned catalog error vocabulary; no other code is\n33|// emitted by this package.\n34|const (\n35|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n36|\t// read is never absence: callers must not treat this as \"no backend\".\n37|\tCodeNotFound = \"terminal_backend_not_found\"\n38|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n39|\t// an identical record is still refused: identity registration is not\n40|\t// idempotent.\n41|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n42|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n43|\t// external executable. Trust is established before any probe.\n44|\tCodeUntrusted = \"terminal_backend_untrusted\"\n45|\t// CodeDrift reports a re-registration whose version tuple, kind,\n46|\t// platforms, or executable digest differs from the admitted record.\n47|\tCodeDrift = \"terminal_backend_implementation_drift\"\n48|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n49|\t// default for the exact prior binding on restore or resume.\n50|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n51|\t// CodeStaleGeneration reports a generation that is out of bound or does\n52|\t// not match the validated binding.\n53|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n54|)\n55|\n56|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n57|// no third-party registration may use it.\n58|const (\n59|\tBuiltinTmux   = \"ax.tmux\"\n60|\tBuiltinConpty = \"ax.conpty\"\n61|)\n62|\n63|// reservedNamespace is the only namespace this implementation may mint.\n64|const reservedNamespace = \"ax.\"\n65|\n66|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n67|const maxIDBytes = 128\n68|\n69|// maxGenerationRunes is the Section 4.B/7.A bound: string[1..256] counts\n70|// UTF-8 characters (SPEC.md:321), not bytes; terminal_backend_id is the\n71|// only member of this package still bounded in ASCII bytes.\n72|const maxGenerationRunes = 256\n73|\n74|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n75|const maxProtocolVersions = 32\n76|\n77|var (\n78|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n79|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n80|\t// grammar the canonical and config packages enforce for the same members.\n81|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n82|)\n83|\n84|// Error is a registry refusal. Code is always one of the Code* constants;\n85|// BackendID names the identity at issue when there is one. Detail is a static\n86|// clause: it never echoes paths, digests, generations, or other local data.\n87|type Error struct {\n88|\tCode      string\n89|\tBackendID string\n90|\tDetail    string\n91|}\n92|\n93|func (err *Error) Error() string {\n94|\tif err.BackendID == \"\" {\n95|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n96|\t}\n97|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n98|}\n99|\n100|// recordRefusal arms runtime attribution of constructed refusals to their\n101|// production call site. It is nil in production: construction is then a\n102|// pure allocation with zero behavior change. The refusal-arm inventory\n103|// audit (internal test) sets it for the test-binary run so the exercised\n104|// file:line set behind every refusal can be audited against the derived\n105|// arm set in both directions. The hook carries only code and detail; the\n106|// audit attributes the site itself through the call stack, exactly like\n107|// the provider/provhost swapped-constructor recorders.\n108|var recordRefusal func(code, detail string)\n109|\n110|// refuse builds the refusal for one derived arm. Every production\n111|// &Error literal routes through refuse so the exercised-site audit can\n112|// attribute each refusal to its file:line; an &Error literal built\n113|// outside refuse is an unregistered construction the derivation rejects.\n114|// The returned value is identical to the wrapped literal: recording never\n115|// alters the refusal.\n116|//\n117|//go:noinline\n118|func refuse(err *Error) *Error {\n119|\tif recordRefusal != nil {\n120|\t\trecordRefusal(err.Code, err.Detail)\n121|\t}\n122|\treturn err\n123|}\n124|\n125|// errorCode reports whether err carries the given wire code.\n126|func errorCode(err error, code string) bool {\n127|\tvar refusal *Error\n128|\tif !errors.As(err, &refusal) {\n129|\t\treturn false\n130|\t}\n131|\treturn refusal.Code == code\n132|}\n133|\n134|// IsNotFound reports CodeNotFound refusals.\n135|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n136|\n137|// IsAmbiguous reports CodeAmbiguous refusals.\n138|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n139|\n140|// IsUntrusted reports CodeUntrusted refusals.\n141|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n142|\n143|// IsDrift reports CodeDrift refusals.\n144|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n145|\n146|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n147|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n148|\n149|// IsStaleGeneration reports CodeStaleGeneration refusals.\n150|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n151|\n152|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n153|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n154|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n155|// is refused so a third party cannot mint a trusted-looking identity.\n156|//\n157|// The bound and grammar arms omit BackendID on purpose: a value refused\n158|// there is arbitrary input the grammar never admitted, and the package\n159|// posture is that refusals never echo unvalidated data. Only the\n160|// reserved-namespace arm names the identity, because its input already\n161|// passed the grammar. That holds package-wide by construction: every\n162|// other site that names a BackendID validates it through ParseID or\n163|// mustParseID first — Registration.validate and TrustEntry.validate via\n164|// mustParseID; Resolve, RequireRestoreBinding, CheckVersionTuple, and\n165|// CheckProviderDescriptor via ParseID at the entry; ParseManifest,\n166|// ParseProbe, and ParseEvidence via ParseID at document admission, so\n167|// the manifest/probe/generation/drift arms consume validated structs;\n168|// New and RegisterExternal via constants and already-validated records —\n169|// so a named BackendID is always a validated identity, never raw input.\n170|func ParseID(value string) (string, error) {\n171|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n172|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"})\n173|\t}\n174|\tif !idPattern.MatchString(value) {\n175|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id grammar\"})\n176|\t}\n177|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n178|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"})\n179|\t}\n180|\treturn value, nil\n181|}\n182|\n183|// mustParseID is the internal admission used where the caller already holds a\n184|// validated record. It duplicates the ParseID rule so a Registry can never\n185|// hold an identity its own grammar refuses.\n186|func mustParseID(value string) error {\n187|\t_, err := ParseID(value)\n188|\treturn err\n189|}\n190|\n191|// Kind is the Section 4.B implementation_kind vocabulary.\n192|type Kind string\n193|\n194|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n195|// as adapter executables over the Section 4.B argv/framing wire.\n196|const (\n197|\tKindBuiltinGo         Kind = \"builtin_go\"\n198|\tKindLocalProgram      Kind = \"local_program\"\n199|\tKindTrustedExecutable Kind = \"trusted_executable\"\n200|\tKindNativeRuntime     Kind = \"native_runtime\"\n201|)\n202|\n203|// parseKind admits exactly the closed Section 4.B vocabulary.\n204|func parseKind(value string) (Kind, error) {\n205|\tswitch Kind(value) {\n206|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n207|\t\treturn Kind(value), nil\n208|\tdefault:\n209|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"})\n210|\t}\n211|}\n212|\n213|// needsDigest reports whether the kind carries an executable digest. Section\n214|// 4.B: digest for local_program or trusted_executable; null otherwise.\n215|func needsDigest(kind Kind) bool {\n216|\treturn kind == KindLocalProgram || kind == KindTrustedExecutable\n217|}\n218|\n219|// Registration is one admitted backend identity with its exact version tuple,\n220|// platform set, and trust binding. It is the registry half of the Section 4.B\n221|// Manifest identity: the Manifest/Probe objects themselves belong to the\n222|// sibling manifest task.\n223|type Registration struct {\n224|\t// ID is the canonical terminal_backend_id.\n225|\tID string\n226|\t// Kind is the closed implementation_kind.\n227|\tKind Kind\n228|\t// ImplementationVersion is the exact admitted semver.\n229|\tImplementationVersion string\n230|\t// ProtocolVersions are the sorted unique semver members in Terminal\n231|\t// Backend Protocol major 1.\n232|\tProtocolVersions []string\n233|\t// Platforms is the sorted unique non-empty platform subset.\n234|\tPlatforms []scalar.Platform\n235|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n236|\t// (null) for built-in kinds.\n237|\tExecutableDigest string\n238|}\n239|\n240|// validate enforces every closed Section 4.B/6.5 rule on one record.\n241|func (record Registration) validate() error {\n242|\tif err := mustParseID(record.ID); err != nil {\n243|\t\treturn err\n244|\t}\n245|\tif _, err := parseKind(string(record.Kind)); err != nil {\n246|\t\treturn err\n247|\t}\n248|\tif !semverPattern.MatchString(record.ImplementationVersion) {\n249|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"implementation_version semver\"})\n250|\t}\n(more lines below)"}}}
