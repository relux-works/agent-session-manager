d {\n984|\t\tif backendID == canonical {\n985|\t\t\treturn legacy, nil\n986|\t\t}\n987|\t}\n988|\treturn \"\", refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy reverse projection\"})\n989|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
