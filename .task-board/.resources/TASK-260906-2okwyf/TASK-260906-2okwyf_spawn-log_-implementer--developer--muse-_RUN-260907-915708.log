 {\\ninternal/invcore/invcore_test.go:372:\\trecorder := NewSiteRecorder()\\ninternal/invcore/invcore.go:34://   - SiteRecorder owns the runtime direction (provider/provhost shape):\\ninternal/invcore/must.go:63:// SiteRecorder is the runtime direction of the alias-bypass union\\ninternal/invcore/must.go:71:type SiteRecorder struct {\\ninternal/invcore/must.go:77:// NewSiteRecorder returns an empty recorder.\\ninternal/invcore/must.go:78:func NewSiteRecorder() *SiteRecorder {\\ninternal/invcore/must.go:79:\\treturn &SiteRecorder{sites: map[string]struct{}{}, codes: map[string]struct{}{}}\\ninternal/invcore/must.go:88:func (recorder *SiteRecorder) Record(code string, skip int) {\\ninternal/invcore/must.go:100:func (recorder *SiteRecorder) Snapshot() (sites map[string]struct{}, codes map[string]struct{}) {\\ninternal/invcore/must.go:116:func (recorder *SiteRecorder) Restore(sites map[string]struct{}, codes map[string]struct{}) {\\ninternal/invcore/must.go:130:func (recorder *SiteRecorder) Sites() map[string]struct{} {\\ninternal/invcore/must.go:141:func (recorder *SiteRecorder) Codes() []string {\\ninternal/invcore/must.go:156:func (recorder *SiteRecorder) AuditSites(what string, scanned int, derived map[string]struct{}, wantCodes []string) []string {\\n===\\ninternal/terminalbackend/conformance.go:19:// Capability gating stays in manifest.go (CheckOperation, Reconcile); trust\\ninternal/terminalbackend/manifest.go:1127:// in Reconcile, not here.\\ninternal/terminalbackend/manifest.go:1270:// in Reconcile through the caller's SignatureVerifier, because a\\ninternal/terminalbackend/manifest.go:1273:// is enforced in Reconcile.\\ninternal/terminalbackend/manifest.go:1669:// Reconcile admits one Probe against its Manifest with the returned\\ninternal/terminalbackend/manifest.go:1683:func Reconcile(manifest Manifest, probe Probe, evidence []Evidence, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\\ninternal/terminalbackend/manifest.go:2