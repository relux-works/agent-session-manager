arseRealmProvider\", \"CodeMismatch\", \"document member type\", 2, \"ParseEvidence\", \"\", nil},\n726|\t{\"manifest.go\", \"parseRealmProvider\", \"CodeMismatch\", \"document members\", 1, \"ParseManifest\", boundShadowedLookup, nil},\n727|\t{\"manifest.go\", \"parseRealmProvider\", \"CodeMismatch\", \"document members\", 2, \"ParseManifest\", boundShadowedLookup, nil},\n728|\t{\"manifest.go\", \"parseRealmProvider\", \"CodeMismatch\", \"document string bound\", 1, \"ParseEvidence\", \"\", nil},\n729|\t{\"manifest.go\", \"parseRealmProvider\", \"CodeMismatch\", \"evidence provider identity\", 1, \"ParseEvidence\", \"\", nil},\n730|\t{\"manifest.go\", \"parseRealmProvider\", \"CodeMismatch\", \"evidence realm binding\", 1, \"ParseEvidence\", \"\", nil},\n731|\t{\"manifest.go\", \"semverMember\", \"CodeMismatch\", \"document semver\", 1, \"ParseManifest\", \"\", nil},\n732|\t{\"manifest.go\", \"stringArrayMember\", \"CodeMismatch\", \"document member type\", 1, \"ParseManifest\", \"\", nil},\n733|\t{\"manifest.go\", \"stringArrayMember\", \"CodeMismatch\", \"document member type\", 2, \"ParseManifest\", \"\", nil},\n734|\t{\"manifest.go\", \"stringArrayMember\", \"CodeMismatch\", \"document members\", 1, \"ParseManifest\", boundShadowedLookup, nil},\n735|\t{\"manifest.go\", \"stringMember\", \"CodeMismatch\", \"document member type\", 1, \"ParseManifest\", \"\", nil},\n736|\t{\"manifest.go\", \"timestampMember\", \"CodeMismatch\", \"document timestamp\", 1, \"ParseProbe\", \"\", nil},\n737|\t{\"manifest.go\", \"validateProtocolList\", \"CodeMismatch\", \"protocol versions bound\", 1, \"ParseManifest\", \"\", nil},\n738|\t{\"manifest.go\", \"validateProtocolList\", \"CodeMismatch\", \"protocol versions major 1\", 1, \"ParseManifest\", \"\", nil},\n739|\t{\"manifest.go\", \"validateProtocolList\", \"CodeMismatch\", \"protocol versions ordering\", 1, \"ParseManifest\", \"\", nil},\n740|\t{\"terminalbackend.go\", \"CheckProviderDescriptor\", \"CodeDrift\", \"descriptor 