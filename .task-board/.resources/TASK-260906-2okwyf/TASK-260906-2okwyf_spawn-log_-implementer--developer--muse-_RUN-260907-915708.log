{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c681","stream":{"kind":"session","id":"01a07a5e-8204-7c61-b778-7e703c0d991a"},"sequence":411,"recorded_at":1780531400000817,"record_type":"event","durability":"durable","causation_id":"2a014316-3376-47a3-a185-8cb71122e6e6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2a014316-3376-47a3-a185-8cb71122e6e6","run_stream":{"kind":"run","id":"2a014316-3376-47a3-a185-8cb71122e6e6"},"task_stream":{"kind":"task","id":"0c62bcb8-f58d-4e42-98d4-787ac5c003cb"},"task_id":"0c62bcb8-f58d-4e42-98d4-787ac5c003cb","event":{"kind":"output","task_id":"0c62bcb8-f58d-4e42-98d4-787ac5c003cb","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(974 line(s) above)\n975|func ParseManifest(raw []byte) (Manifest, error) {\n976|\tobject, err := decodeStrictObject(raw)\n977|\tif err != nil {\n978|\t\treturn Manifest{}, err\n979|\t}\n980|\treturn parseManifestObject(object)\n981|}\n982|\n983|// parseManifestObject validates a decoded Manifest member map. It is split\n984|// from ParseManifest so admission paths that already hold a decoded object\n985|// share the exact gate.\n986|func parseManifestObject(object map[string]any) (Manifest, error) {\n987|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n988|\t\treturn Manifest{}, err\n989|\t}\n990|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n991|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n992|\t}\n993|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n994|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n995|\t}\n996|\tmanifestID, err := stringMember(object, \"manifest_id\")\n997|\tif err != nil {\n998|\t\treturn Manifest{}, err\n999|\t}\n1000|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1001|\tif err != nil {\n1002|\t\treturn Manifest{}, err\n1003|\t}\n1004|\tif _, err := ParseID(backendID); err != nil {\n1005|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n1006|\t}\n1007|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1008|\tif err != nil {\n1009|\t\treturn Manifest{}, err\n1010|\t}\n1011|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n1012|\tif err != nil {\n1013|\t\treturn Manifest{}, err\n1014|\t}\n1015|\tif err := validateProtocolList(protocols); err != nil {\n1016|\t\treturn Manifest{}, err\n1017|\t}\n1018|\tplatforms, err := parsePlatformList(object)\n1019|\tif err != nil {\n1020|\t\treturn Manifest{}, err\n1021|\t}\n1022|\tkindName, err := stringMember(object, \"implementation_kind\")\n1023|\tif err != nil {\n1024|\t\treturn Manifest{}, err\n1025|\t}\n1026|\tkind, err := parseKind(kindName)\n1027|\tif err != nil {\n1028|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n1029|\t}\n1030|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n1031|\tif err != nil {\n1032|\t\treturn Manifest{}, err\n1033|\t}\n1034|\tif needsDigest(kind) == (digest == \"\") {\n1035|\t\treturn Manifest{}, mismatchf(\"manifest executable digest\")\n1036|\t}\n1037|\tclaimsRaw, known := object[\"static_capability_claims\"]\n1038|\tif !known {\n1039|\t\treturn Manifest{}, mismatchf(\"document members\")\n1040|\t}\n1041|\tclaims, err := parseClaimList(claimsRaw, false)\n1042|\tif err != nil {\n1043|\t\treturn Manifest{}, err\n1044|\t}\n1045|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n1046|\tif err != nil {\n1047|\t\treturn Manifest{}, err\n1048|\t}\n1049|\tif err := checkExtensions(object); err != nil {\n1050|\t\treturn Manifest{}, err\n1051|\t}\n1052|\t// The identity binding is verified after every member-type rule, so a\n1053|\t// malformed document is refused before any JCS transform runs\n1054|\t// (SPEC.md:301 NUM-UNSAFE-NUMBER: reject before identity calculation).\n1055|\tif err := checkIdentity(object, \"manifest_id\", manifestID); err != nil {\n1056|\t\treturn Manifest{}, err\n1057|\t}\n1058|\treturn Manifest{\n1059|\t\tManifestID:             manifestID,\n1060|\t\tTerminalBackendID:      backendID,\n1061|\t\tImplementationVersion:  implementationVersion,\n1062|\t\tProtocolVersions:       protocols,\n1063|\t\tPlatforms:              platforms,\n1064|\t\tImplementationKind:     kind,\n1065|\t\tExecutableDigest:       digest,\n1066|\t\tStaticCapabilityClaims: claims,\n1067|\t\tConformanceFixtureID:   fixtureID,\n1068|\t}, nil\n1069|}\n1070|\n1071|// validateProtocolList enforces sorted unique semver[1..32], each in\n1072|// Terminal Backend Protocol major 1, without naming a backend.\n1073|func validateProtocolList(versions []string) error {\n1074|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n1075|\t\treturn mismatchf(\"protocol versions bound\")\n1076|\t}\n1077|\tfor index, version := range versions {\n1078|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n1079|\t\t\treturn mismatchf(\"protocol versions major 1\")\n1080|\t\t}\n1081|\t\tif index > 0 && versions[index-1] >= version {\n1082|\t\t\treturn mismatchf(\"protocol versions ordering\")\n1083|\t\t}\n1084|\t}\n1085|\treturn nil\n1086|}\n1087|\n1088|// parsePlatformList validates the sorted unique non-empty platform subset.\n1089|func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\n1090|\tnames, err := stringArrayMember(object, \"platforms\")\n1091|\tif err != nil {\n1092|\t\treturn nil, err\n1093|\t}\n1094|\tif len(names) == 0 || len(names) > 4 {\n1095|\t\treturn nil, mismatchf(\"platforms bound\")\n1096|\t}\n1097|\tplatforms := make([]scalar.Platform, 0, len(names))\n1098|\tfor _, name := range names {\n1099|\t\tplatform, err := scalar.ParsePlatform(name)\n1100|\t\tif err != nil {\n1101|\t\t\treturn nil, mismatchf(\"platforms vocabulary\")\n1102|\t\t}\n1103|\t\tplatforms = append(platforms, platform)\n1104|\t}\n1105|\tfor index := range platforms {\n1106|\t\t// Bytewise >= refuses duplicates and misordering together: equal\n1107|\t\t// neighbours are not strictly ordered.\n1108|\t\tif index > 0 && platforms[index-1].String() >= platforms[index].String() {\n1109|\t\t\treturn nil, mismatchf(\"platforms ordering\")\n1110|\t\t}\n1111|\t}\n1112|\treturn platforms, nil\n1113|}\n1114|\n1115|// probeMembers is the exact closed Probe member set.\n1116|var probeMembers = []string{\n1117|\t\"schema\", \"schema_version\", \"probe_id\", \"terminal_backend_id\",\n1118|\t\"implementation_version\", \"protocol_version\", \"implementation_kind\",\n1119|\t\"executable_digest\", \"platform\", \"os_version\", \"availability\",\n1120|\t\"backend_generation_digest\", \"capability_claims\", \"evidence_ids\",\n1121|\t\"probed_at\", \"extensions\",\n1122|}\n1123|\n1124|// ParseProbe validates one Terminal Backend Probe 1.0.0 document. Shape,\n1125|// vocabulary, bound, ordering, registry-row, and identity failures are all\n1126|// CodeMismatch; cross-document reconciliation against the Manifest happens\n1127|// in Reconcile, not here.\n1128|func ParseProbe(raw []byte) (Probe, error) {\n1129|\tobject, err := decodeStrictObject(raw)\n1130|\tif err != nil {\n1131|\t\treturn Probe{}, err\n1132|\t}\n1133|\tif err := checkExactMembers(object, probeMembers); err != nil {\n1134|\t\treturn Probe{}, err\n1135|\t}\n1136|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaProbe {\n1137|\t\treturn Probe{}, mismatchf(\"probe schema\")\n1138|\t}\n1139|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n1140|\t\treturn Probe{}, mismatchf(\"probe schema version\")\n1141|\t}\n1142|\tprobeID, err := stringMember(object, \"probe_id\")\n1143|\tif err != nil {\n1144|\t\treturn Probe{}, err\n1145|\t}\n1146|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1147|\tif err != nil {\n1148|\t\treturn Probe{}, err\n1149|\t}\n1150|\tif _, err := ParseID(backendID); err != nil {\n1151|\t\treturn Probe{}, mismatchf(\"probe backend identity\")\n1152|\t}\n1153|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1154|\tif err != nil {\n(more lines below)"}}}
