{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7cf","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":578,"recorded_at":1780531400001151,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"ab3bce51-39ac-4049-ac0b-50bc9caf2dfc"},"task_id":"ab3bce51-39ac-4049-ac0b-50bc9caf2dfc","event":{"kind":"output","task_id":"ab3bce51-39ac-4049-ac0b-50bc9caf2dfc","chunk":"Read text file `internal/secprim/argv.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strconv\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|// CheckArgv validates one process argv vector under Section 16.4: every\n10|// process invocation uses an argv array and native process APIs, and shell\n11|// command construction from names, paths, provider output, or peer data is\n12|// forbidden. This package offers no string-to-argv constructor at all —\n13|// there is no shell word-splitting entry point to misuse — and CheckArgv\n14|// decides what a validated vector is:\n15|//\n16|//   - the vector is non-empty and names a non-empty executable;\n17|//   - no element is empty: an empty argv element is legal to exec but never\n18|//     meaningful to an AX or provider CLI, so it fails closed;\n19|//   - no element carries a NUL byte, which cannot cross execve;\n20|//   - every element is valid UTF-8, because argv elements recur in receipts,\n21|//     logs, and terminal rendering, all of which are UTF-8.\n22|//\n23|// No length bound is enforced here: the Section 5.1 byte bounds apply to\n24|// the Provider SpawnPlan wire object and stay in internal/provhost, which\n25|// admits the plan. A plan admitted there still crosses this gate at\n26|// process start, so a caller that bypasses plan admission cannot bypass\n27|// argv validation.\n28|func CheckArgv(argv []string) error {\n29|\tif len(argv) == 0 {\n30|\t\treturn failArgv(\"argv empty\", \"no executable\")\n31|\t}\n32|\tfor index, element := range argv {\n33|\t\tposition := \"argv[\" + strconv.Itoa(index) + \"]\"\n34|\t\tswitch {\n35|\t\tcase element == \"\":\n36|\t\t\tif index == 0 {\n37|\t\t\t\treturn failArgv(\"argv executable empty\", position)\n38|\t\t\t}\n39|\t\t\treturn failArgv(\"argv element empty\", position)\n40|\t\tcase strings.ContainsRune(element, 0):\n41|\t\t\treturn failArgv(\"argv NUL\", position)\n42|\t\tcase !utf8.ValidString(element):\n43|\t\t\treturn failArgv(\"argv encoding\", position)\n44|\t\t}\n45|\t}\n46|\treturn nil\n47|}\n48|\n49|// Command is a validated argv vector. The only constructor takes an array,\n50|// so a command cannot be built from a shell string: word-splitting hostile\n51|// input never happens because no entry point performs it. The zero value\n52|// is unusable; build one with NewCommand.\n53|type Command struct {\n54|\targv []string\n55|}\n56|\n57|// NewCommand validates the vector with CheckArgv and keeps a copy: the\n58|// caller's slice cannot be rewritten after admission to smuggle in an\n59|// unchecked element.\n60|func NewCommand(argv []string) (Command, error) {\n61|\tif err := CheckArgv(argv); err != nil {\n62|\t\treturn Command{}, err\n63|\t}\n64|\treturn Command{argv: append([]string(nil), argv...)}, nil\n65|}\n66|\n67|// Argv returns the validated vector. The result is a copy for the same\n68|// reason the constructor copies: a retained alias would let the holder\n69|// rewrite an admitted command.\n70|func (command Command) Argv() []string {\n71|\treturn append([]string(nil), command.argv...)\n72|}\n73|\n74|// Executable reports argv[0], the process image the host will start. It is\n75|// never empty: NewCommand refused that.\n76|func (command Command) Executable() string {\n77|\treturn command.argv[0]\n78|}"}}}
