{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c39b","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":40,"recorded_at":1780531400000075,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"dcd3030e-b826-422a-96a3-5f6ccb0a4ae6"},"task_id":"dcd3030e-b826-422a-96a3-5f6ccb0a4ae6","event":{"kind":"output","task_id":"dcd3030e-b826-422a-96a3-5f6ccb0a4ae6","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(129 line(s) above)\n130|\t}\n131|\treturn refusal.Code == code\n132|}\n133|\n134|// IsNotFound reports CodeNotFound refusals.\n135|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n136|\n137|// IsAmbiguous reports CodeAmbiguous refusals.\n138|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n139|\n140|// IsUntrusted reports CodeUntrusted refusals.\n141|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n142|\n143|// IsDrift reports CodeDrift refusals.\n144|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n145|\n146|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n147|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n148|\n149|// IsStaleGeneration reports CodeStaleGeneration refusals.\n150|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n151|\n152|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n153|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n154|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n155|// is refused so a third party cannot mint a trusted-looking identity.\n156|//\n157|// The bound and grammar arms omit BackendID on purpose: a value refused\n158|// there is arbitrary UTF-8 up to 128 bytes, and the package posture is\n159|// that refusals never echo local data. Only the reserved-namespace arm\n160|// names the identity, because its input already passed the grammar and\n161|// is a validated identity like every other BackendID in the package.\n162|func ParseID(value string) (string, error) {\n163|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n164|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"})\n165|\t}\n166|\tif !idPattern.MatchString(value) {\n167|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id grammar\"})\n168|\t}\n169|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n170|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"})\n171|\t}\n172|\treturn value, nil\n173|}\n174|\n175|// mustParseID is the internal admission used where the caller already holds a\n176|// validated record. It duplicates the ParseID rule so a Registry can never\n177|// hold an identity its own grammar refuses.\n178|func mustParseID(value string) error {\n179|\t_, err := ParseID(value)\n180|\treturn err\n181|}\n182|\n183|// Kind is the Section 4.B implementation_kind vocabulary.\n184|type Kind string\n185|\n186|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n187|// as adapter executables over the Section 4.B argv/framing wire.\n188|const (\n189|\tKindBuiltinGo         Kind = \"builtin_go\"\n190|\tKindLocalProgram      Kind = \"local_program\"\n191|\tKindTrustedExecutable Kind = \"trusted_executable\"\n192|\tKindNativeRuntime     Kind = \"native_runtime\"\n193|)\n194|\n195|// parseKind admits exactly the closed Section 4.B vocabulary.\n196|func parseKind(value string) (Kind, error) {\n197|\tswitch Kind(value) {\n198|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n199|\t\treturn Kind(value), nil\n200|\tdefault:\n201|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"})\n202|\t}\n203|}\n204|\n205|// needsDigest reports whether the kind carries an executable digest. Section\n206|// 4.B: digest for local_program or trusted_executable; null otherwise.\n207|func needsDigest(kind Kind) bool {\n208|\treturn kind == KindLocalProgram || kind == KindTrustedExecutable\n209|}\n210|\n211|// Registration is one admitted backend identity with its exact version tuple,\n212|// platform set, and trust binding. It is the registry half of the Section 4.B\n213|// Manifest identity: the Manifest/Probe objects themselves belong to the\n214|// sibling manifest task.\n215|type Registration struct {\n216|\t// ID is the canonical terminal_backend_id.\n217|\tID string\n218|\t// Kind is the closed implementation_kind.\n219|\tKind Kind\n220|\t// ImplementationVersion is the exact admitted semver.\n221|\tImplementationVersion string\n222|\t// ProtocolVersions are the sorted unique semver members in Terminal\n223|\t// Backend Protocol major 1.\n224|\tProtocolVersions []string\n225|\t// Platforms is the sorted unique non-empty platform subset.\n226|\tPlatforms []scalar.Platform\n227|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n228|\t// (null) for built-in kinds.\n229|\tExecutableDigest string\n230|}\n231|\n232|// validate enforces every closed Section 4.B/6.5 rule on one record.\n233|func (record Registration) validate() error {\n234|\tif err := mustParseID(record.ID); err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif _, err := parseKind(string(record.Kind)); err != nil {\n238|\t\treturn err\n239|\t}\n240|\tif !semverPattern.MatchString(record.ImplementationVersion) {\n241|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"implementation_version semver\"})\n242|\t}\n243|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n244|\t\treturn err\n245|\t}\n246|\tif err := validatePlatforms(record.Platforms); err != nil {\n247|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()})\n248|\t}\n249|\tif needsDigest(record.Kind) {\n250|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n251|\t\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"})\n252|\t\t}\n253|\t} else if record.ExecutableDigest != \"\" {\n254|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"})\n255|\t}\n256|\treturn nil\n257|}\n258|\n259|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n260|// Terminal Backend Protocol major 1.\n261|func validateProtocolVersions(backendID string, versions []string) error {\n262|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n263|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"})\n264|\t}\n265|\tfor index, version := range versions {\n266|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n267|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"})\n268|\t\t}\n269|\t\tif index > 0 && versions[index-1] >= version {\n270|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"})\n271|\t\t}\n272|\t}\n273|\treturn nil\n274|}\n275|\n276|// semverMajor returns the major number of a validated semver string.\n277|// A major that does not fit an int saturates instead of wrapping, so a\n278|// huge foreign major compares foreign at every != 1 call site rather\n279|// than aliasing a small native one (18446744073709551617 must not read\n280|// as 1). Saturation preserves every comparison against the small\n281|// constants the call sites use, in the correct direction.\n282|func semverMajor(version string) int {\n283|\tmajor := 0\n284|\tfor i := 0; i < len(version); i++ {\n285|\t\tif version[i] == '.' {\n286|\t\t\tbreak\n287|\t\t}\n288|\t\tdigit := int(version[i] - '0')\n289|\t\tif major > (math.MaxInt-digit)/10 {\n290|\t\t\treturn math.MaxInt\n291|\t\t}\n292|\t\tmajor = major*10 + digit\n293|\t}\n294|\treturn major\n295|}\n296|\n297|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n298|// macos|linux|wsl2|windows vocabulary.\n299|func validatePlatforms(platforms []scalar.Platform) error {\n300|\tif len(platforms) == 0 || len(platforms) > 4 {\n301|\t\treturn errors.New(\"platforms bound\")\n302|\t}\n303|\tprevious := \"\"\n304|\tfor _, platform := range platforms {\n305|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n306|\t\t\treturn errors.New(\"platforms vocabulary\")\n307|\t\t}\n308|\t\tif previous >= platform.String() {\n309|\t\t\treturn errors.New(\"platforms sorted unique\")\n310|\t\t}\n311|\t\tprevious = platform.String()\n312|\t}\n313|\treturn nil\n314|}\n315|\n316|// cloneStrings deep-copies a version list so the registry never shares a\n317|// backing array with its caller. Registration carries slices; a struct copy\n318|// duplicates only the header, so every ingress and egress point must clone.\n319|func cloneStrings(values []string) []string {\n320|\tif values == nil {\n321|\t\treturn nil\n322|\t}\n323|\tcloned := make([]string, len(values))\n324|\tcopy(cloned, values)\n325|\treturn cloned\n326|}\n327|\n328|// clonePlatforms deep-copies a platform set for the same reason as\n329|// cloneStrings: without it a caller holding a resolved record keeps a live\n330|// handle on admitted registry state and can convert drift into a duplicate.\n331|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n332|\tif values == nil {\n333|\t\treturn nil\n334|\t}\n335|\tcloned := make([]scalar.Platform, len(values))\n336|\tcopy(cloned, values)\n337|\treturn cloned\n338|}\n339|\n340|// cloneRecord deep-copies every slice member of a record.\n341|func cloneRecord(record Registration) Registration {\n342|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n343|\trecord.Platforms = clonePlatforms(record.Platforms)\n344|\treturn record\n345|}\n346|\n347|// equalRecord reports whether two validated records are member-for-member\n348|// identical. Any difference is drift, never a compatible update.\n349|func equalRecord(left, right Registration) bool {\n350|\tif left.ID != right.ID || left.Kind != right.Kind ||\n351|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n352|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n353|\t\treturn false\n354|\t}\n355|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n356|\t\treturn false\n357|\t}\n358|\tfor i := range left.ProtocolVersions {\n359|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n360|\t\t\treturn false\n361|\t\t}\n362|\t}\n363|\tif len(left.Platforms) != len(right.Platforms) {\n364|\t\treturn false\n365|\t}\n366|\tfor i := range left.Platforms {\n367|\t\tif left.Platforms[i] != right.Platforms[i] {\n368|\t\t\treturn false\n369|\t\t}\n370|\t}\n371|\treturn true\n372|}\n373|\n374|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n375|// backend ID, an absolute executable path, an executable digest, and enabled.\n376|type TrustEntry struct {\n377|\tBackendID        string\n378|\tExecutablePath   string\n379|\tExecutableDigest string\n(more lines below)"}}}
