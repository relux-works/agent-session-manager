{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ed","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":465,"recorded_at":1780531400000925,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"call_id":"call_01a07a4156fc7873aa1b25832e35c153","text":"Read text file `internal/secprim/env.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"sort\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|// IsEnvName reports whether name satisfies the environment-name grammar\n10|// shared by launch allowlists and SpawnPlan admission:\n11|// [A-Za-z_][A-Za-z0-9_]{0,127}. internal/provhost delegates its wire-plan\n12|// name check to this function, so the two packages cannot drift on what a\n13|// name is; the byte-counted plan bounds around it stay in provhost.\n14|func IsEnvName(name string) bool {\n15|\tif len(name) < 1 || len(name) > 128 {\n16|\t\treturn false\n17|\t}\n18|\tfor index := 0; index < len(name); index++ {\n19|\t\tchar := name[index]\n20|\t\tvalid := char == '_' ||\n21|\t\t\tchar >= 'A' && char <= 'Z' ||\n22|\t\t\tchar >= 'a' && char <= 'z' ||\n23|\t\t\tindex > 0 && char >= '0' && char <= '9'\n24|\t\tif !valid {\n25|\t\t\treturn false\n26|\t\t}\n27|\t}\n28|\treturn true\n29|}\n30|\n31|// BuildEnv builds the exact environment of a child process from a minimal\n32|// allowlist plus operator literals (Section 16.7 \"minimal environment\n33|// allowlists\"):\n34|//\n35|//   - allowed names the inherited variables the child may see. Each must\n36|//     satisfy IsEnvName; duplicates are refused rather than silently\n37|//     collapsed, because a duplicated allowlist entry is a configuration\n38|//     error. A name absent from lookup is skipped, not failed: an unset\n39|//     variable is a legitimate absence, while a failed read must never\n40|//     masquerade as one, so lookup reports only what it read.\n41|//   - literals carries explicit key=value pairs (workspace-derived values,\n42|//     SpawnPlan literals). Keys must satisfy IsEnvName and must be disjoint\n43|//     from allowed: a literal that shadows an inherited name would make the\n44|//     child's environment depend on map order rather than on policy.\n45|//   - values must be NUL-free valid UTF-8. Empty values are admitted:\n46|//     FOO= is a meaningful empty assignment, not a missing one.\n47|//\n48|// The result is sorted by name and rendered k=v, so identical inputs build\n49|// byte-identical environments. lookup abstracts the parent environment for\n50|// tests; production passes os.LookupEnv.\n51|//\n52|// No length bound is enforced here: the Section 5.1 literal bounds apply\n53|// to the SpawnPlan wire object in internal/provhost. No default allowlist\n54|// is declared here either: with no provider implementation in this\n55|// repository to derive runtime needs from, a baked-in list would be an\n56|// invented product policy, so the operator supplies the list explicitly\n57|// and ExecRunner inherits the parent environment until one is supplied.\n58|func BuildEnv(allowed []string, literals map[string]string, lookup func(string) (string, bool)) ([]string, error) {\n59|\tif lookup == nil {\n60|\t\treturn nil, failEnv(\"env lookup missing\", \"no parent environment reader\")\n61|\t}\n62|\tseen := make(map[string]bool, len(allowed))\n63|\tfor _, name := range allowed {\n64|\t\tif !IsEnvName(name) {\n65|\t\t\treturn nil, failEnv(\"env name\", name)\n66|\t\t}\n67|\t\tif seen[name] {\n68|\t\t\treturn nil, failEnv(\"env allowlist duplicate\", name)\n69|\t\t}\n70|\t\tseen[name] = true\n71|\t}\n72|\tfor key := range literals {\n73|\t\tif !IsEnvName(key) {\n74|\t\t\treturn nil, failEnv(\"env name\", key)\n75|\t\t}\n76|\t\tif seen[key] {\n77|\t\t\treturn nil, failEnv(\"env literal collision\", key)\n78|\t\t}\n79|\t}\n80|\tvalues := make(map[string]string, len(allowed)+len(literals))\n81|\tfor _, name := range allowed {\n82|\t\tvalue, present := lookup(name)\n83|\t\tif !present {\n84|\t\t\tcontinue\n85|\t\t}\n86|\t\tif strings.ContainsRune(value, 0) {\n87|\t\t\treturn nil, failEnv(\"env value NUL\", name)\n88|\t\t}\n89|\t\tif !utf8.ValidString(value) {\n90|\t\t\treturn nil, failEnv(\"env value encoding\", name)\n91|\t\t}\n92|\t\tvalues[name] = value\n93|\t}\n94|\tfor key, value := range literals {\n95|\t\tif strings.ContainsRune(value, 0) {\n96|\t\t\treturn nil, failEnv(\"env value NUL\", key)\n97|\t\t}\n98|\t\tif !utf8.ValidString(value) {\n99|\t\t\treturn nil, failEnv(\"env value encoding\", key)\n100|\t\t}\n101|\t\tvalues[key] = value\n102|\t}\n103|\tnames := make([]string, 0, len(values))\n104|\tfor name := range values {\n105|\t\tnames = append(names, name)\n106|\t}\n107|\tsort.Strings(names)\n108|\tenvironment := make([]string, 0, len(names))\n109|\tfor _, name := range names {\n110|\t\tenvironment = append(environment, name+\"=\"+values[name])\n111|\t}\n112|\treturn environment, nil\n113|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"call_id":"call_01a07a41577c7242b8d2a4a6c08abf07","text":"Read text file `internal/secprim/path.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// CheckMemberPath admits one staging or archive member name on the given\n12|// platform under Section 16.3. The member is a slash-separated relative\n13|// path: the shared relative grammar (absolute, drive-qualified, backslash,\n14|// NUL, empty, dot, parent segments, and repeatedly encoded separators) is\n15|// decided by scalar.ParseRelativePath, which owns it. This gate adds only\n16|// the platform rules scalar does not own because they apply to member\n17|// names rather than to absolute paths:\n18|//\n19|//   - encoded dots and overlong separators (%2e, %c0%af, any case and %25\n20|//     nesting): an extension past scalar, because extraction stacks\n21|//     commonly percent-decode after validation and an admitted \"%2e%2e\"\n22|//     becomes a parent segment below this gate;\n23|//   - Windows alternate-stream and NTFS syntax: any colon outside a refused\n24|//     drive prefix (Section 16.3 \"alternate streams\");\n25|//   - Windows trailing dots and spaces per segment, which the filesystem\n26|//     strips and which therefore alias distinct members;\n27|//   - Windows reserved device names, decided by the same table scalar uses\n28|//     for absolute paths.\n29|func CheckMemberPath(platform scalar.Platform, member string) error {\n30|\tif _, err := scalar.ParseRelativePath(member); err != nil {\n31|\t\treturn failPath(\"member grammar\", memberErrorTarget(member))\n32|\t}\n33|\tif containsEncodedDot(member) {\n34|\t\treturn failPath(\"member encoded dot\", memberErrorTarget(member))\n35|\t}\n36|\tif containsOverlongSeparator(member) {\n37|\t\treturn failPath(\"member overlong separator\", memberErrorTarget(member))\n38|\t}\n39|\tif platform == scalar.PlatformWindows {\n40|\t\tfor _, segment := range strings.Split(member, \"/\") {\n41|\t\t\tif strings.Contains(segment, \":\") {\n42|\t\t\t\treturn failPath(\"member alternate stream\", memberErrorTarget(member))\n43|\t\t\t}\n44|\t\t\tif strings.HasSuffix(segment, \".\") || strings.HasSuffix(segment, \" \") {\n45|\t\t\t\treturn failPath(\"member trailing dot or space\", memberErrorTarget(member))\n46|\t\t\t}\n47|\t\t\tif scalar.IsReservedWindowsDeviceName(segment) {\n48|\t\t\t\treturn failPath(\"member reserved device name\", memberErrorTarget(member))\n49|\t\t\t}\n50|\t\t}\n51|\t}\n52|\treturn nil\n53|}\n54|\n55|// unwrapPercentEncoding folds %25 layers the way scalar's separator check\n56|// does, so a twice-encoded dot or separator cannot hide behind its outer\n57|// encoding.\n58|func unwrapPercentEncoding(value string) string {\n59|\tcandidate := strings.ToLower(value)\n60|\tfor {\n61|\t\tnext := strings.ReplaceAll(candidate, \"%25\", \"%\")\n62|\t\tif next == candidate {\n63|\t\t\treturn candidate\n64|\t\t}\n65|\t\tcandidate = next\n66|\t}\n67|}\n68|\n69|// containsEncodedDot reports a percent-encoded dot (%2e, any case, any\n70|// %25 nesting). scalar owns the encoded-separator rule (%2f/%5c) but not\n71|// encoded dots; this gate extends it because extraction stacks commonly\n72|// percent-decode after validation, turning an admitted \"%2e%2e\" into a\n73|// parent segment below this gate. A literal percent followed by other\n74|// hex (for example \"100%.txt\" or \"a%20b\") keeps passing through.\n75|func containsEncodedDot(member string) bool {\n76|\treturn strings.Contains(unwrapPercentEncoding(member), \"%2e\")\n77|}\n78|\n79|// containsOverlongSeparator reports the overlong UTF-8 encoding of slash\n80|// (%c0%af, any case, any %25 nesting), which some decoders accept as a\n81|// separator. Same ownership rationale as containsEncodedDot.\n82|func containsOverlongSeparator(member string) bool {\n83|\treturn strings.Contains(unwrapPercentEncoding(member), \"%c0%af\")\n84|}\n85|\n86|// memberErrorTarget names the refused member without echoing unbounded\n87|// foreign bytes: the first 64 characters identify the site for an\n88|// operator while a hostile multi-megabyte member cannot flood a log.\n89|func memberErrorTarget(member string) string {\n90|\tif len(member) > 64 {\n91|\t\treturn member[:64] + \"...\"\n92|\t}\n93|\treturn member\n94|}\n95|\n96|// Guard is a containment boundary for staging and extraction: a validated\n97|// absolute root on one platform plus the optional exact set of managed\n98|// member names that may be replaced. A nil managed set disables the\n99|// managed check; a non-nil set (even an empty one) restricts Resolve to\n100|// its members, so denying by default is representable and distinct from\n101|// not checking. The zero value is unusable; build one with NewGuard.\n102|type Guard struct {\n103|\troot         string\n104|\tplatform     scalar.Platform\n105|\tmanaged      map[string]bool\n106|\tcheckManaged bool\n107|}\n108|\n109|// NewGuard validates the staging root and records the managed set.\n110|// The root must be an absolute path on the platform: a relative root\n111|// fails here instead of resolving against the process working directory\n112|// at commit time.\n113|func NewGuard(root string, platform scalar.Platform, managed []string) (Guard, error) {\n114|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n115|\t\treturn Guard{}, failPath(\"guard root\", memberErrorTarget(root))\n116|\t}\n117|\tguard := Guard{root: root, platform: platform}\n118|\tif managed != nil {\n119|\t\tguard.checkManaged = true\n120|\t\tguard.managed = make(map[string]bool, len(managed))\n121|\t\tfor _, member := range managed {\n122|\t\t\tguard.managed[member] = true\n123|\t\t}\n124|\t}\n125|\treturn guard, nil\n126|}\n127|\n128|// Resolve maps one member name to its commit path inside the guard root.\n129|// It enforces the two conjuncts of containment independently: the member\n130|// grammar (CheckMemberPath, which refuses traversal lexically) and the\n131|// joined-prefix check below (which refuses anything whose cleaned join\n132|// escapes the root even if the grammar ever admits a new shape). Either\n133|// conjunct refuses alone.\n134|//\n135|// The prefix check is currently unreachable through this entry: the\n136|// member grammar refuses every parent segment, so no admitted member can\n137|// produce a join outside the root. It stays as defense in depth against a\n138|// future grammar relaxation, and TestGuardPrefixCheckIsLoadBearing pins\n139|// the property it guards (every resolved join stays within the root) so\n140|// weakening the grammar reddens there first.\n141|func (guard Guard) Resolve(member string) (string, error) {\n142|\tif err := CheckMemberPath(guard.platform, member); err != nil {\n143|\t\treturn \"\", err\n144|\t}\n145|\tif guard.checkManaged && !guard.managed[member] {\n146|\t\treturn \"\", failPath(\"member unmanaged\", memberErrorTarget(member))\n147|\t}\n148|\tjoined := joinSlash(guard.slashRoot(), member)\n149|\tif !withinRoot(guard.slashRoot(), joined) {\n150|\t\treturn \"\", failPath(\"member containment\", memberErrorTarget(member))\n151|\t}\n152|\tif guard.platform == scalar.PlatformWindows {\n153|\t\treturn strings.ReplaceAll(joined, \"/\", `\\`), nil\n154|\t}\n155|\treturn joined, nil\n156|}\n157|\n158|// slashRoot renders the validated root with forward slashes so the join\n159|// and prefix check are platform-parameterized rather than host-native:\n160|// windows cases are decided lexically on any host.\n161|func (guard Guard) slashRoot() string {\n162|\tif guard.platform == scalar.PlatformWindows {\n163|\t\treturn strings.ReplaceAll(guard.root, `\\`, \"/\")\n164|\t}\n165|\treturn guard.root\n166|}\n167|\n168|// joinSlash joins a slash-form root with a grammar-checked member and\n169|// cleans the result, preserving a UNC leading double slash that path\n170|// Clean would otherwise collapse.\n171|func joinSlash(slashRoot, member string) string {\n172|\tfull := strings.TrimSuffix(slashRoot, \"/\") + \"/\" + member\n173|\tcleaned := path.Clean(full)\n174|\tif strings.HasPrefix(slashRoot, \"//\") && !strings.HasPrefix(cleaned, \"//\") {\n175|\t\tcleaned = \"/\" + cleaned\n176|\t}\n177|\treturn cleaned\n178|}\n179|\n180|// withinRoot reports whether the cleaned join stays inside the cleaned\n181|// root: equality (the root itself) or a slash-boundary prefix. A bare\n182|// string prefix is not containment: \"/root-evil\" starts with \"/root\" but\n183|// is not inside it.\n184|func withinRoot(slashRoot, joined string) bool {\n185|\tbase := strings.TrimSuffix(slashRoot, \"/\")\n186|\tif base == \"\" {\n187|\t\tbase = \"/\"\n188|\t}\n189|\tif joined == base {\n190|\t\treturn true\n191|\t}\n192|\treturn strings.HasPrefix(joined, base+\"/\")\n193|}\n194|\n195|// DetectCaseCollision reports whether candidate collides with an existing\n196|// member name under case folding for a case-insensitive destination\n197|// (Section 16.3 \"case-fold collisions\"). It returns the colliding entry.\n198|// Comparison is Unicode simple folding via EqualFold over the exact entry\n199|// spellings the caller lists: the caller owns the directory read, this\n200|// function owns the decision.\n201|func DetectCaseCollision(seen []string, candidate string) (string, bool) {\n202|\tfor _, existing := range seen {\n203|\t\tif existing != candidate && strings.EqualFold(existing, candidate) {\n204|\t\t\treturn existing, true\n205|\t\t}\n206|\t}\n207|\treturn \"\", false\n208|}\n209|\n210|// CheckRegularTarget refuses a stat result that is not a plain regular\n211|// file: symlinks, directories, devices, named pipes, and sockets\n212|// (Section 16.3 \"symlink/reparse escape\" and \"device/FIFO/socket\n213|// creation\"). A nil result is refused rather than treated as absent: a\n214|// failed stat is never a legitimate absence.\n215|func CheckRegularTarget(info os.FileInfo) error {\n216|\tif info == nil {\n217|\t\treturn failPath(\"target stat missing\", \"nil file info\")\n218|\t}\n219|\tmode := info.Mode()\n220|\tswitch {\n221|\tcase mode&os.ModeSymlink != 0:\n222|\t\treturn failPath(\"target symlink\", info.Name())\n223|\tcase info.IsDir():\n224|\t\treturn failPath(\"target directory\", info.Name())\n225|\tcase mode&os.ModeDevice != 0,\n226|\t\tmode&os.ModeNamedPipe != 0,\n227|\t\tmode&os.ModeSocket != 0,\n228|\t\tmode&os.ModeCharDevice != 0,\n229|\t\t!mode.IsRegular():\n230|\t\treturn failPath(\"target special file\", info.Name())\n231|\t}\n232|\treturn nil\n233|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
