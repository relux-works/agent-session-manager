{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca93","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":932,"recorded_at":1780531400001859,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"07a6c9ee-00de-4ccc-a4cd-01619ce0d905"},"task_id":"07a6c9ee-00de-4ccc-a4cd-01619ce0d905","event":{"kind":"output","task_id":"07a6c9ee-00de-4ccc-a4cd-01619ce0d905","chunk":"{\n  \"chunk_id\": \"exec-32-1\",\n  \"command\": \"cat > internal/provhost/zz_probe_echo2_test.go <<'EOF'\\npackage provhost_test\\n\\nimport (\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/axerror\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/provhost\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\nfunc mustID2(t *testing.T) scalar.UUIDv7 {\\n\\tid, err := scalar.ParseUUIDv7(\\\"0198f4c8-8e50-7f66-8f70-1234567890ab\\\")\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\treturn id\\n}\\n\\nfunc validProbe(t *testing.T) map[string]any {\\n\\tt.Helper()\\n\\tvar m map[string]any\\n\\tif err := json.Unmarshal([]byte(specProbe), &m); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\treturn m\\n}\\n\\nconst specProbe = `{\\\"schema\\\":\\\"urn:ax:schema:provider-probe\\\",\\\"schema_version\\\":\\\"1.0.0\\\",\\\"provider_id\\\":\\\"pi\\\",\\\"provider_version\\\":\\\"0.73.1\\\",\\\"platform\\\":\\\"macos\\\",\\\"architecture\\\":\\\"arm64\\\",\\\"capabilities\\\":{\\\"native_resume\\\":{\\\"status\\\":\\\"available\\\",\\\"enabled\\\":true,\\\"evidence\\\":\\\"probed\\\",\\\"detail\\\":\\\"x\\\"}},\\\"warnings\\\":[]}`\\n\\nfunc TestZZProbeProvhostEcho2(t *testing.T) {\\n\\thostile := strings.Repeat(\\\"A\\\", 200) + \\\"\\\\x1b[31m\\\" + \\\"../../etc/passwd\\\"\\n\\tvb, _ := json.Marshal(hostile)\\n\\tframe := []byte(`{\\\"protocol\\\":\\\"urn:ax:protocol:provider\\\",\\\"protocol_version\\\":` + string(vb) + `,\\\"request_id\\\":\\\"0198f4c8-8e50-7f66-8f70-1234567890ab\\\",\\\"ok\\\":true,\\\"body\\\":{}}`)\\n\\t_, err := provhost.DecodeResponse(frame, mustID2(t))\\n\\ts := fmt.Sprint(err)\\n\\tt.Logf(\\\"hostile-version Error() len=%d contains=%v\\\", len(s), strings.Contains(s, hostile))\\n\\tif ee, ok := err.(*axerror.Error); ok {\\n\\t\\tif v, ok := ee.Detail(\\\"observed\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"observed detail len=%d equals-hostile=%v\\\", len(fmt.Sprint(v)), fmt.Sprint(v) == hostile)\\n\\t\\t}\\n\\t\\tif v, ok := ee.Detail(\\\"member\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"member detail=%q\\\", v)\\n\\t\\t}\\n\\t\\tt.Logf(\\\"code=%v\\\", ee.Code)\\n\\t} else {\\n\\t\\tt.Logf(\\\"err type %T: %v\\\", err, err)\\n\\t}\\n\\tm := validProbe(t)\\n\\tm[hostile] = float64(1)\\n\\tbody, _ := json.Marshal(m)\\n\\terr = provhost.DecodeProbe(body)\\n\\ts2 := fmt.Sprint(err)\\n\\tt.Logf(\\\"unknown-key Error() len=%d contains=%v err=%q\\\", len(s2), strings.Contains(s2, hostile), s2)\\n\\tif ee, ok := err.(*axerror.Error); ok {\\n\\t\\tif v, ok := ee.Detail(\\\"member\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"member detail len=%d equals-hostile=%v\\\", len(fmt.Sprint(v)), fmt.Sprint(v) == hostile)\\n\\t\\t}\\n\\t}\\n}\\nEOF\\ngo test ./internal/provhost/ -run TestZZProbeProvhostEcho2 -v 2>&1 | head -n 20; rm internal/provhost/zz_probe_echo2_test.go\",\n  \"description\": \"Probe provhost hostile version and key\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"# github.com/relux-works/agent-session-manager/internal/provhost_test\\n# [github.com/relux-works/agent-session-manager/internal/provhost_test]\\ninternal/provhost/zz_probe_echo2_test.go:47:16: (*testing.common).Logf format %v arg ee.Code is a func value, not called\\nFAIL\\tgithub.com/relux-works/agent-session-manager/internal/provhost [build failed]\\nFAIL\\n\",\n  \"original_output_bytes\": 351,\n  \"original_output_tokens\": 88,\n  \"truncated\": false\n}"}}}
