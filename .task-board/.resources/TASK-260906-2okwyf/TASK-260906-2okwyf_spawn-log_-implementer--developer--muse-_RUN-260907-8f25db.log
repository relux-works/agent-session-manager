{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf7d","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":1561,"recorded_at":1780531400003117,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"4c18ba38-188d-4e28-ac3f-289a1024ac6d"},"task_id":"4c18ba38-188d-4e28-ac3f-289a1024ac6d","event":{"kind":"output","task_id":"4c18ba38-188d-4e28-ac3f-289a1024ac6d","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(626 line(s) above)\n627|}\n628|\n629|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n630|// a descriptor whose binding digest, backend ID, versions, or generation does\n631|// not match the AX-validated host-local binding before launching or observing\n632|// a provider process. Generation lengths 0 and over 256 UTF-8 characters are\n633|// invalid; 256 is accepted.\n634|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n635|\tif err := checkGeneration(descriptor.Generation); err != nil {\n636|\t\treturn err\n637|\t}\n638|\tif err := checkGeneration(binding.Generation); err != nil {\n639|\t\treturn err\n640|\t}\n641|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n642|\t\treturn err\n643|\t}\n644|\tif descriptor.BackendID != binding.BackendID {\n645|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"})\n646|\t}\n647|\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\n648|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n649|\t}\n650|\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\n651|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n652|\t}\n653|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n654|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n655|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"})\n656|\t}\n657|\tif descriptor.Generation != binding.Generation {\n658|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"})\n659|\t}\n660|\treturn nil\n661|}\n662|\n663|// checkGeneration enforces string[1..256] measured in UTF-8 characters over\n664|// valid UTF-8 (SPEC.md:321).\n665|func checkGeneration(generation string) error {\n666|\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\n667|\t\treturn refuse(&Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"})\n668|\t}\n669|\treturn nil\n670|}\n671|\n672|// DigestFile returns the sha256: digest of the executable at path after\n673|// resolving symlinks. The target must be a regular file; anything else (or a\n674|// read failure) is an error, never a digest. It distinguishes a failed read\n675|// from an absent trust entry: callers must not fall back to PATH discovery.\n676|//\n(more lines below)"}}}
