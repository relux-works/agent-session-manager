ins=%v err=%q\\\", len(s), strings.Contains(s, \\\"3.0.0\\\"), s)\\n\\tif axErr != nil {\\n\\t\\tif v, ok := axErr.Detail(\\\"observed\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"observed detail=%q\\\", v)\\n\\t\\t} else {\\n\\t\\t\\tt.Logf(\\\"no observed detail\\\")\\n\\t\\t}\\n\\t}\\n\\t// 2. unknown probe member key -> Details member.\\n\\t_ = hostile\\n\\tbody := []byte(`{\\\"schema\\\":\\\"urn:ax:schema:probe\\\",\\\"schema_version\\\":\\\"1.0.0\\\",\\\"provider_id\\\":\\\"com.example.prov\\\",\\\"provider_version\\\":\\\"1.0.0\\\",\\\"platform\\\":\\\"linux\\\",\\\"architecture\\\":\\\"amd64\\\",\\\"capabilities\\\":{\\\"status\\\":{\\\"status\\\":\\\"available\\\",\\\"enabled\\\":true,\\\"evidence\\\":\\\"direct\\\",\\\"detail\\\":\\\"\\\"}}\\\",\\\"warnings\\\":[],\\\"` + `\\\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\\\":1}`)\\n\\terr = provhost.DecodeProbe(body)\\n\\ts2 := fmt.Sprint(err)\\n\\tt.Logf(\\\"probe unknown Error() len=%d err=%q\\\", len(s2), s2)\\n\\tif ee, ok := err.(*axerror.Error); ok {\\n\\t\\tif v, ok := ee.Detail(\\\"member\\\"); ok {\\n\\t\\t\\tvs := fmt.Sprint(v)\\n\\t\\t\\tt.Logf(\\\"member detail len=%d head=%q\\\", len(vs), vs[:min(60, len(vs))])\\n\\t\\t}\\n\\t}\\n}\\nfunc min(a, b int) int { if a < b { return a }; return b }\\nEOF\\ngo test ./internal/provhost/ -run TestZZProbeProvhostEcho -v 2>&1 | head -n 20; rm internal/provhost/zz_probe_echo_test.go\",\n  \"description\": \"Probe provhost echo behavior\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"=== RUN   TestZZProbeProvhostEcho\\n    zz_probe_echo_test.go:31: mismatch Error() len=94 contains=false err=\\\"incompatible_protocol: provider host rejected a foreign protocol major: foreign protocol major\\\"\\n    zz_probe_echo_test.go:34: observed detail=\\\"3.0.0\\\"\\n    zz_probe_echo_test.go:44: 