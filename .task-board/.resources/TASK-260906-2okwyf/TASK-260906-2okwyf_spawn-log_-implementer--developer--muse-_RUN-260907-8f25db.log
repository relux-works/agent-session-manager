{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c851","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":643,"recorded_at":1780531400001281,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"ed96db89-65ae-49ed-ac87-861f7bf52bb9"},"task_id":"ed96db89-65ae-49ed-ac87-861f7bf52bb9","event":{"kind":"output","task_id":"ed96db89-65ae-49ed-ac87-861f7bf52bb9","chunk":"Read text file `internal/provhost/protocol.go`.\n(494 line(s) above)\n495|\t\t\t}\n496|\t\t\treturn Response{}, failure\n497|\t\t}\n498|\t}\n499|\tvar protocol string\n500|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n501|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n502|\t\tif fault != nil {\n503|\t\t\treturn Response{}, fault\n504|\t\t}\n505|\t\treturn Response{}, failure\n506|\t}\n507|\tvar version string\n508|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n509|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n510|\t\tif fault != nil {\n511|\t\t\treturn Response{}, fault\n512|\t\t}\n513|\t\treturn Response{}, failure\n514|\t}\n515|\tif version != ProtocolVersion {\n516|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n517|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n518|\t\t\tif err != nil {\n519|\t\t\t\treturn Response{}, err\n520|\t\t\t}\n521|\t\t\treturn Response{}, failure\n522|\t\t}\n523|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n524|\t\tif fault != nil {\n525|\t\t\treturn Response{}, fault\n526|\t\t}\n527|\t\treturn Response{}, failure\n528|\t}\n529|\tvar requestID string\n530|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n531|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n532|\t\tif fault != nil {\n533|\t\t\treturn Response{}, fault\n534|\t\t}\n535|\t\treturn Response{}, failure\n536|\t}\n537|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n538|\t\tfailure, fault := failProtocol(\"request_id is not a UUIDv7\", \"request_id\")\n539|\t\tif fault != nil {\n540|\t\t\treturn Response{}, fault\n541|\t\t}\n542|\t\treturn Response{}, failure\n543|\t}\n544|\tif requestID != wantRequestID.String() {\n545|\t\tfailure, fault := failProtocol(\"request_id does not match the request\", \"request_id\")\n546|\t\tif fault != nil {\n547|\t\t\treturn Response{}, fault\n548|\t\t}\n549|\t\treturn Response{}, failure\n550|\t}\n551|\tif ok {\n552|\t\tif !isJSONObject(members[\"body\"]) {\n553|\t\t\tfailure, fault := failProtocol(\"body is not a JSON object\", \"body\")\n554|\t\t\tif fault != nil {\n555|\t\t\t\treturn Response{}, fault\n556|\t\t\t}\n557|\t\t\treturn Response{}, failure\n558|\t\t}\n559|\t\treturn Response{Body: append(json.RawMessage(nil), members[\"body\"]...)}, nil\n560|\t}\n561|\tif !isJSONObject(members[\"error\"]) {\n562|\t\tfailure, fault := failProtocol(\"error is not a JSON object\", \"error\")\n563|\t\tif fault != nil {\n564|\t\t\treturn Response{}, fault\n565|\t\t}\n566|\t\treturn Response{}, failure\n567|\t}\n568|\t// The failure-error version is selected by the observed envelope\n569|\t// major through the static Section 15.1/17.1 table, never from the\n570|\t// document: major 2 decodes under Structured Error 1.0.0, and major\n571|\t// 3 would decode under Structured Error 1.3.0. Only 2.0.0 reaches\n572|\t// this line — a recognizable 3.x envelope was refused above as a\n573|\t// major mismatch, because a v2-only host never trusts a different\n574|\t// major's error (Section 7.A) — so the contract below carries major\n(more lines below)"}}}
