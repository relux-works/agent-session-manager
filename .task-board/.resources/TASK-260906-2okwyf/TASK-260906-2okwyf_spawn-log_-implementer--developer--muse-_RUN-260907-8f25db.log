{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d3","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":580,"recorded_at":1780531400001155,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"e93df7cc-8227-4665-97a4-e8daf978dada"},"task_id":"e93df7cc-8227-4665-97a4-e8daf978dada","event":{"kind":"output","task_id":"e93df7cc-8227-4665-97a4-e8daf978dada","chunk":"Read text file `internal/environ/observation.go`.\n(159 line(s) above)\n160|\n161|// Observation is one validated Environment Observation.\n162|type Observation struct {\n163|\tObservationID    string\n164|\tHostID           string\n165|\tInstallationID   string\n166|\tEnvironmentID    string\n167|\tEnvironmentVer   string\n168|\tProviderID       string\n169|\tPlatform         string\n170|\tArchitecture     string\n171|\tRealmFingerprint string\n172|\tCapabilities     map[string]CapabilityResult\n173|\tAuthentication   string\n174|\tRuntime          string\n175|\tObservedAt       string\n176|}\n177|\n178|// DecodeEnvironmentObservation validates one closed Environment\n179|// Observation: the exact schema envelope, digest and UUIDv7\n180|// identities, the environment-id grammar with\n181|// environment_version as string[1..128], the provider-id grammar\n182|// (an explicit manifest mapping, never string inference), the\n183|// platform and architecture vocabularies through the reused\n184|// Section 13.14 tuple admission model, the non-secret realm\n185|// digest, the exact eight-name capability map, the two status\n186|// vocabularies, the diagnostic timestamp, and reverse-DNS\n187|// extensions.\n188|func DecodeEnvironmentObservation(body []byte) (Observation, error) {\n189|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(body))\n190|\tif fault != nil {\n191|\t\treturn Observation{}, refuse(\"observation \"+fault.Detail, fault.Member)\n192|\t}\n193|\tif name, unknown := unknownMember(members, observationMembers); unknown {\n194|\t\treturn Observation{}, refuse(\"observation carries unknown member\", name)\n195|\t}\n196|\tif name, missing := missingMember(members, observationRequired); missing {\n197|\t\treturn Observation{}, refuse(\"observation misses a required member\", name)\n198|\t}\n199|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != observationSchema {\n200|\t\treturn Observation{}, refuse(\"observation schema is not the environment observation\", \"schema\")\n201|\t}\n202|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != observationSchemaVersion {\n203|\t\treturn Observation{}, refuse(\"observation schema version is not 1.0.0\", \"schema_version\")\n204|\t}\n205|\tobservationID, ok := CheckDigest(members[\"observation_id\"])\n206|\tif !ok {\n207|\t\treturn Observation{}, refuse(\"observation identifier is not a digest\", \"observation_id\")\n208|\t}\n209|\thostID, ok := CheckUUIDv7(members[\"host_id\"])\n210|\tif !ok {\n211|\t\treturn Observation{}, refuse(\"observation host identifier is not a UUIDv7\", \"host_id\")\n212|\t}\n213|\tinstallationID, ok := CheckDigest(members[\"installation_id\"])\n214|\tif !ok {\n215|\t\treturn Observation{}, refuse(\"observation installation identifier is not a digest\", \"installation_id\")\n216|\t}\n217|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n218|\tif !ok || !CheckEnvironmentID(environmentID) {\n219|\t\treturn Observation{}, refuse(\"observation environment identifier is not an environment-id\", \"environment_id\")\n220|\t}\n221|\tenvironmentVersion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n222|\tif !ok {\n223|\t\treturn Observation{}, refuse(\"observation environment version is not a string[1..128]\", \"environment_version\")\n224|\t}\n225|\tprovider, ok := rawString(members[\"provider_id\"])\n226|\tif !ok {\n227|\t\treturn Observation{}, refuse(\"observation provider identifier is not a string\", \"provider_id\")\n228|\t}\n229|\tproviderID, err := scalar.ParseProviderID(provider)\n230|\tif err != nil {\n231|\t\treturn Observation{}, refuse(\"observation provider identifier is not a provider-id\", \"provider_id\")\n232|\t}\n233|\tplatform, ok := rawString(members[\"platform\"])\n234|\tif !ok {\n235|\t\treturn Observation{}, refuse(\"observation platform is not a string\", \"platform\")\n236|\t}\n237|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n238|\t\treturn Observation{}, refuse(\"observation platform is outside linux|macos|windows|wsl2\", \"platform\")\n239|\t}\n240|\tarchitecture, ok := rawString(members[\"architecture\"])\n241|\tif !ok || !validTupleArchitecture(architecture) {\n242|\t\treturn Observation{}, refuse(\"observation architecture is outside amd64|arm64\", \"architecture\")\n243|\t}\n244|\trealm, ok := CheckDigest(members[\"backend_realm_fingerprint\"])\n245|\tif !ok {\n246|\t\treturn Observation{}, refuse(\"observation realm fingerprint is not a digest\", \"backend_realm_fingerprint\")\n247|\t}\n248|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n249|\tif !ok {\n250|\t\treturn Observation{}, refuse(\"observation capabilities are not the exact eight-name result map\", \"capabilities\")\n251|\t}\n252|\tauthentication, ok := rawString(members[\"authentication_status\"])\n253|\tif !ok || !validAuthenticationStatus(authentication) {\n254|\t\treturn Observation{}, refuse(\"observation authentication status is outside available|missing|expired|unknown\", \"authentication_status\")\n255|\t}\n256|\truntime, ok := rawString(members[\"runtime_status\"])\n257|\tif !ok || !validRuntimeStatus(runtime) {\n258|\t\treturn Observation{}, refuse(\"observation runtime status is outside available|degraded|unavailable\", \"runtime_status\")\n259|\t}\n260|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n261|\tif !ok {\n262|\t\treturn Observation{}, refuse(\"observation timestamp is not a timestamp\", \"observed_at\")\n263|\t}\n264|\tif !CheckExtensions(members[\"extensions\"]) {\n265|\t\treturn Observation{}, refuse(\"observation extensions are not reverse-DNS keyed\", \"extensions\")\n266|\t}\n267|\treturn Observation{\n268|\t\tObservationID:    observationID.String(),\n269|\t\tHostID:           hostID.String(),\n270|\t\tInstallationID:   installationID.String(),\n271|\t\tEnvironmentID:    environmentID,\n272|\t\tEnvironmentVer:   environmentVersion,\n273|\t\tProviderID:       providerID.String(),\n274|\t\tPlatform:         platform,\n275|\t\tArchitecture:     architecture,\n276|\t\tRealmFingerprint: realm.String(),\n277|\t\tCapabilities:     capabilities,\n278|\t\tAuthentication:   authentication,\n279|\t\tRuntime:          runtime,\n(more lines below)"}}}
