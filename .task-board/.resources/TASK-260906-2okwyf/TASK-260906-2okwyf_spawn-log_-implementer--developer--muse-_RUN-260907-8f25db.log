{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccaf","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":1202,"recorded_at":1780531400002399,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"fcd61eb9-fbfc-4a3e-8f78-0a2449b77795"},"task_id":"fcd61eb9-fbfc-4a3e-8f78-0a2449b77795","event":{"kind":"output","task_id":"fcd61eb9-fbfc-4a3e-8f78-0a2449b77795","chunk":"edited\nchanged lines: lines 157-161\n--- original\n+++ updated\n@@\n-// The bound and grammar arms omit BackendID on purpose: a value refused\n-// there is arbitrary UTF-8 up to 128 bytes, and the package posture is\n-// that refusals never echo local data. Only the reserved-namespace arm\n-// names the identity, because its input already passed the grammar and\n-// is a validated identity like every other BackendID in the package.\n+// The bound and grammar arms omit BackendID on purpose: a value refused\n+// there is arbitrary input the grammar never admitted, and the package\n+// posture is that refusals never echo unvalidated data. Only the\n+// reserved-namespace arm names the identity, because its input already\n+// passed the grammar. That holds package-wide by construction: every\n+// other site that names a BackendID validates it through ParseID or\n+// mustParseID first — Registration.validate and TrustEntry.validate via\n+// mustParseID, Resolve, RequireRestoreBinding, CheckVersionTuple, and\n+// CheckProviderDescriptor via ParseID, New and RegisterExternal via\n+// constants and already-validated records — so a named BackendID is\n+// always a validated identity, never raw caller input.\n"}}}
