tif ee, ok := err.(*axerror.Error); ok {\\n\\t\\tif v, ok := ee.Detail(\\\"observed\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"observed detail len=%d equals-hostile=%v\\\", len(fmt.Sprint(v)), fmt.Sprint(v) == hostile)\\n\\t\\t}\\n\\t\\tif v, ok := ee.Detail(\\\"member\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"member detail=%q\\\", v)\\n\\t\\t}\\n\\t\\tt.Logf(\\\"code=%v\\\", ee.Code)\\n\\t} else {\\n\\t\\tt.Logf(\\\"err type %T: %v\\\", err, err)\\n\\t}\\n\\t// 2. unknown probe key hostile: build from decoded example + extra key.\\n\\tvar m map[string]json.RawMessage\\n\\tif err := json.Unmarshal([]byte(specProbeExample2), &m); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tm[hostile] = json.RawMessage(`1`)\\n\\tbody, _ := json.Marshal(m)\\n\\terr = provhost.DecodeProbe(body)\\n\\ts2 := fmt.Sprint(err)\\n\\tt.Logf(\\\"unknown-key Error() len=%d contains=%v\\\", len(s2), strings.Contains(s2, hostile))\\n\\tif ee, ok := err.(*axerror.Error); ok {\\n\\t\\tif v, ok := ee.Detail(\\\"member\\\"); ok {\\n\\t\\t\\tt.Logf(\\\"member detail len=%d equals-hostile=%v\\\", len(fmt.Sprint(v)), fmt.Sprint(v) == hostile)\\n\\t\\t}\\n\\t}\\n}\\n\\nfunc mustJSON(s string) string {\\n\\tb, _ := json.Marshal(s)\\n\\treturn string(b)\\n}\\nEOF\\ngrep -n \\\"specProbeExample = \\\" internal/provhost/probe_test.go | head -2\\nsed -n '14,70p' internal/provhost/probe_test.go > /tmp/probe_example.txt; wc -l /tmp/probe_example.txt; tail -5 /tmp/probe_example.txt\",\n  \"description\": \"Prepare provhost echo probe 2\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"14:const specProbeExample = `{\\n      57 /tmp/probe_example.txt\\n}`\\n\\n// TestSpecProbeExampleDecodes proves the Section 7.4 example passes\\n// the production entry point with every status represented.\\nfunc TestSpecProbeExampleDecodes(t *testing.T) {\\n\",\n  \"original_output_bytes\": 246,\n  \"original_output_tokens\": 62,\n  \"truncated\": false\n}"}}}
