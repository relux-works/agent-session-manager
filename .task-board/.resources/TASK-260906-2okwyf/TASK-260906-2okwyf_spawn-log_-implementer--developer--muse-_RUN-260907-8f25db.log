urn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \\\"provider_process_failed\\\", Message: \\\"provider plugin process failed: \\\" + detail, Details: axerror.Details{}, Cause: cause})\\n139:\\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \\\"provider_timeout\\\", Message: \\\"provider plugin exceeded its deadline: \\\" + detail, Details: axerror.Details{\\\"deadline_ms\\\": json.Number(strconv.FormatInt(millis, 10))}})\\n143:\\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \\\"integrity_failure\\\", Message: \\\"provider status observation is not durable state: \\\" + detail, Details: axerror.Details{\\\"status_state\\\": statusState, \\\"materialization_id\\\": materializationID, \\\"transaction_id\\\": transactionID}})\\n315:// responseMembers is the exact Section 7.2 response member set: the four\\n319:// TestResponseMembersAreDerivedFromSpec, not pass silently.\\n320:var responseMembers = map[string]bool{\\n329:func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\\n352:\\t\\tif !responseMembers[name] {\\n430:\\t\\tfailure, err := failProtocol(\\\"frame exceeds 8 MiB\\\", \\\"\\\")\\n437:\\t\\tfailure, err := failProtocol(\\\"frame is not UTF-8\\\", \\\"\\\")\\n445:\\t\\tfailure, err := failProtocol(fault.detail, fault.member)\\n479:\\t\\t\\tfailure, err := failProtocol(\\\"missing member\\\", \\\"ok\\\")\\n485:\\t\\t\\tfailure, fault := failProtocol(\\\"member is not a boolean\\\", \\\"ok\\\")\\n491:\\t\\tif fault := checkResponseMembers(members, ok); fault != nil {\\n492:\\t\\t\\tfailure, err := failProtocol(fault.detail, fault.member)\\n501:\\t\\tfailure, fault := failProtocol(\\\"not a provider envelope\\\", \\\"protocol\\\")\\n509:\\t\\tfailure, fault := failProtocol(\\\"member is not a string\\\", \\\"protocol_version\\\")\\n523:\\t\\tfailure, fault := failProtocol(\\\"unsupported protocol version\\\", \\\"protocol_version\\\")\\n531:\\t\\tfailure, fault := failProtocol(\\\"member is not a string\\\", \\\"request_id\\\")\\n538:\\t\\tfailure, fault := failProtocol(\\\"request_id is not a UUIDv7\\\", \\\"request_id\\\")\\n545:\\t\\tfailure, fault := failProtocol(\\\"request_id does not match the request\\\", \\\"request_id\\\")\\n553:\\t\\t\\tfailure, fault := failProtocol(\\\"body is not a JSON object\\\", \\\"body\\\")\\n562:\\t\\tfailure, fault := failProtocol(\\\"error is not a JSON object\\\", \\\"error\\\")\\n581:\\t\\tfailure, fault := failProtocol(\\\"error is not a bound Structured Error 1.0.0\\\", \\\"error\\\")\\n===\\n58:// probeMembers is the exact required member set DecodeProbe accepts.\\n59:var probeMembers = map[string]bool{\\n70:// probeRequired lists probeMembers in a fixed order so a body missing\\n83:// probeCapabilityMembers is the exact member set of one capability\\n85:var probeCapabilityMembers = map[string]bool{\\n92:// probeCapabilityRequired lists probeCapabilityMembers in a fixed\\n119:\\t\\tfailure, err := failProtocol(fault.detail, fault.member)\\n125:\\tif name, unknown := unknownMember(members, probeMembers); unknown {\\n126:\\t\\tfailure, err := failProtocol(\\\"probe carries unknown member\\\", name)\\n132:\\tif name, missing := missingMember(members, probeRequired); missing {\\n133:\\t\\tfailure, err := failProtocol(\\\"probe misses a required member\\\", name)\\n140:\\t\\tfailure, err := failProtocol(\\\"probe schema is not the provider probe\\\", \\\"schema\\\")\\n147:\\t\\tfailure, err := failProtocol(\\\"probe schema_version is not 1.0.0\\\", \\\"schema_version\\\")\\n154:\\t\\tfailure, err := failProtocol(\\\"probe provider_id is not a provider id\\\", \\\"provider_id\\\")\\n161:\\t\\tfailure, err := failProtocol(\\\"probe provider_version is not 1..128 characters\\\", \\\"provider_version\\\")\\n168:\\t\\tfailure, err := failProtocol(\\\"probe platform is not a registry member\\\", \\\"platform\\\")\\n175:\\t\\tfailure, err := failProtocol(\\\"probe architecture is not amd64 or arm64\\\", 