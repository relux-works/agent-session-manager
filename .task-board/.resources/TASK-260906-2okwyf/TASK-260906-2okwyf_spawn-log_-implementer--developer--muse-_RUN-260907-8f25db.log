{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5cb","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":320,"recorded_at":1780531400000635,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"task_stream":{"kind":"task","id":"89035a21-239b-4507-87b9-19141290f36d"},"task_id":"89035a21-239b-4507-87b9-19141290f36d","event":{"kind":"output","task_id":"89035a21-239b-4507-87b9-19141290f36d","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(373 line(s) above)\n374|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n375|// backend ID, an absolute executable path, an executable digest, and enabled.\n376|type TrustEntry struct {\n377|\tBackendID        string\n378|\tExecutablePath   string\n379|\tExecutableDigest string\n380|\tEnabled          bool\n381|}\n382|\n383|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n384|// reserved-namespace bar (third parties use a vendor-owned namespace),\n385|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n386|// A disabled entry is not an error here; registration treats it as untrusted.\n387|func (entry TrustEntry) validate(platform scalar.Platform) error {\n388|\tif err := mustParseID(entry.BackendID); err != nil {\n389|\t\treturn err\n390|\t}\n391|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n392|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"})\n393|\t}\n394|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n395|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"})\n396|\t}\n397|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n398|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"})\n399|\t}\n400|\treturn nil\n401|}\n402|\n403|// Registry is the process-local TerminalBackend registry. It opens with the\n404|// two canonical built-ins admitted and accepts external adapters only through\n405|// RegisterExternal with a validated trust entry. The zero value is unusable;\n406|// construct with New.\n407|type Registry struct {\n408|\tmutex   sync.RWMutex\n409|\trecords map[string]Registration\n410|}\n411|\n412|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n413|// ax.conpty (windows) at the given implementation version with the given\n414|// Terminal Backend Protocol versions. Both are builtin_go without an\n415|// executable digest. Unknown members or a non-major-1 protocol list fail\n416|// before either built-in is admitted.\n417|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n418|\tif !semverPattern.MatchString(implementationVersion) {\n419|\t\treturn nil, refuse(&Error{Code: CodeDrift, Detail: \"implementation_version semver\"})\n420|\t}\n421|\tprotocols := append([]string(nil), protocolVersions...)\n422|\tsort.Strings(protocols)\n423|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n424|\t\treturn nil, err\n425|\t}\n426|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n427|\tbuiltins := []Registration{\n428|\t\t{\n429|\t\t\tID:                    BuiltinTmux,\n430|\t\t\tKind:                  KindBuiltinGo,\n431|\t\t\tImplementationVersion: implementationVersion,\n432|\t\t\t// Each built-in gets its own copy so the two admitted records\n433|\t\t\t// never alias each other. This is defence-in-depth, not a\n434|\t\t\t// bypass fix: callers only ever see egress clones (Resolve\n435|\t\t\t// clones, RegisterExternal clones on ingress, IDs returns\n436|\t\t\t// strings), so no exported path can reach these arrays.\n437|\t\t\tProtocolVersions: cloneStrings(protocols),\n438|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n439|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n440|\t\t},\n441|\t\t{\n442|\t\t\tID:                    BuiltinConpty,\n443|\t\t\tKind:                  KindBuiltinGo,\n444|\t\t\tImplementationVersion: implementationVersion,\n445|\t\t\tProtocolVersions:      cloneStrings(protocols),\n446|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n447|\t\t},\n448|\t}\n449|\tfor _, record := range builtins {\n450|\t\tif err := record.validate(); err != nil {\n451|\t\t\treturn nil, err\n452|\t\t}\n453|\t\tregistry.records[record.ID] = record\n454|\t}\n455|\treturn registry, nil\n456|}\n457|\n458|// RegisterExternal admits one external adapter (§4.B discovery before\n459|// activation, §6.5 trust). The trust entry must be enabled and name an\n460|// absolute executable whose digest exactly equals the observed record digest;\n461|// a mismatch fails before any probe. The observed record must use an external\n462|// kind, carry the same ID, and pass full record validation. Registering an\n463|// already-known ID fails closed: an identical record is CodeAmbiguous\n464|// (registration is not idempotent) and any difference is CodeDrift.\n465|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n466|\tif registry == nil {\n467|\t\treturn refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n468|\t}\n469|\tif err := entry.validate(platform); err != nil {\n470|\t\treturn err\n471|\t}\n472|\tif !entry.Enabled {\n473|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"})\n474|\t}\n475|\tif observed.ID != entry.BackendID {\n476|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"})\n477|\t}\n478|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n479|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"})\n480|\t}\n481|\tif err := observed.validate(); err != nil {\n482|\t\treturn err\n483|\t}\n484|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n485|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"})\n486|\t}\n487|\tregistry.mutex.Lock()\n488|\tdefer registry.mutex.Unlock()\n489|\texisting, known := registry.records[observed.ID]\n490|\tif !known {\n491|\t\t// Store a copy: the caller keeps its own record, and retaining\n492|\t\t// the slices verbatim would leave the admitted record mutable\n493|\t\t// without passing any gate.\n494|\t\tregistry.records[observed.ID] = cloneRecord(observed)\n495|\t\treturn nil\n496|\t}\n497|\tif equalRecord(existing, observed) {\n498|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \"duplicate backend_id\"})\n499|\t}\n500|\treturn refuse(&Error{Code: CodeDrift, BackendID: observed.ID, Detail: \"implementation drift\"})\n501|}\n502|\n503|// Resolve returns the admitted record for a canonical ID. An unknown,\n504|// malformed, or never-admitted ID is CodeNotFound: a registry read failure is\n505|// never absence, and callers must not fall back to a default.\n506|func (registry *Registry) Resolve(backendID string) (Registration, error) {\n507|\tif registry == nil {\n508|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n509|\t}\n510|\tid, err := ParseID(backendID)\n511|\tif err != nil {\n512|\t\treturn Registration{}, err\n513|\t}\n514|\tregistry.mutex.RLock()\n515|\tdefer registry.mutex.RUnlock()\n516|\trecord, known := registry.records[id]\n517|\tif !known {\n518|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, BackendID: id, Detail: \"unregistered terminal_backend_id\"})\n519|\t}\n520|\t// Hand back a copy: the struct header copy shares the backing arrays,\n521|\t// so returning the stored record would hand out live interior state.\n522|\treturn cloneRecord(record), nil\n523|}\n524|\n525|// IDs returns the sorted admitted identities. It reports membership only,\n526|// never availability.\n527|func (registry *Registry) IDs() []string {\n528|\tif registry == nil {\n529|\t\treturn nil\n530|\t}\n531|\tregistry.mutex.RLock()\n532|\tdefer registry.mutex.RUnlock()\n533|\tids := make([]string, 0, len(registry.records))\n(more lines below)"}}}
