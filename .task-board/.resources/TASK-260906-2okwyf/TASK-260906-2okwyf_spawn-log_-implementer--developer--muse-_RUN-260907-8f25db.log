{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3c3","stream":{"kind":"session","id":"01a07a40-291a-7b50-9359-ce2838523baf"},"sequence":60,"recorded_at":1780531400000115,"record_type":"event","durability":"durable","causation_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5c56535d-a447-4a6e-a8da-9b382d4b9205","run_stream":{"kind":"run","id":"5c56535d-a447-4a6e-a8da-9b382d4b9205"},"call_id":"call_01a07a40531c7aa38edb8f7def5f7784","text":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(539 line(s) above)\n540|\n541|// DefaultForPlatform returns the platform default for new activation (§6.5):\n542|// ax.tmux on macos/linux/wsl2 and ax.conpty on windows. Defaults select only\n543|// a new Terminal Instance; restore and resume must use RequireRestoreBinding.\n544|func DefaultForPlatform(platform scalar.Platform) (string, error) {\n545|\tswitch platform {\n546|\tcase scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2:\n547|\t\treturn BuiltinTmux, nil\n548|\tcase scalar.PlatformWindows:\n549|\t\treturn BuiltinConpty, nil\n550|\tdefault:\n551|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"platform vocabulary\"})\n552|\t}\n553|}\n554|\n555|// RequireRestoreBinding resolves the exact prior binding for restore or\n556|// resume (§4.B, §6.5). The candidate must equal the bound backend ID; using\n557|// the current configured default instead is CodeRestoreMismatch. The bound ID\n558|// must be registered: unknown or unsupported IDs remain visible but cannot\n559|// activate.\n560|func (registry *Registry) RequireRestoreBinding(boundBackendID, candidateBackendID string) (Registration, error) {\n561|\tif registry == nil {\n562|\t\treturn Registration{}, refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n563|\t}\n564|\tbound, err := ParseID(boundBackendID)\n565|\tif err != nil {\n566|\t\treturn Registration{}, err\n567|\t}\n568|\tcandidate, err := ParseID(candidateBackendID)\n569|\tif err != nil {\n570|\t\treturn Registration{}, err\n571|\t}\n572|\tif candidate != bound {\n573|\t\treturn Registration{}, refuse(&Error{Code: CodeRestoreMismatch, BackendID: candidate, Detail: \"restore requires the prior binding\"})\n574|\t}\n575|\treturn registry.Resolve(bound)\n576|}\n577|\n578|// CheckVersionTuple admits one (implementation_version, protocol_version)\n579|// pair against the admitted protocol list: the implementation must be\n580|// semver, the protocol must be semver in Terminal Backend Protocol major 1\n581|// and exactly one member of the list. Array-to-scalar selection is\n582|// membership, not aggregate equality (§4.B).\n583|func CheckVersionTuple(backendID, implementationVersion, protocolVersion string, protocolVersions []string) error {\n584|\tif !semverPattern.MatchString(implementationVersion) {\n585|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"implementation_version semver\"})\n586|\t}\n587|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n588|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version major 1\"})\n589|\t}\n590|\tfor _, member := range protocolVersions {\n591|\t\tif protocolVersion == member {\n592|\t\t\treturn nil\n593|\t\t}\n594|\t}\n595|\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version membership\"})\n596|}\n597|\n598|// InstanceBinding is the validated host-local binding subset a §7.A provider\n599|// descriptor must match: binding digest, backend ID, versions, and generation\n600|// (SPEC.md §7.A). TerminalBindingID is the digest of the validated Terminal\n601|// Instance Binding 1.0.0 carried as terminal_binding_id (SPEC.md:3461).\n602|type InstanceBinding struct {\n603|\tBackendID             string\n604|\tImplementationVersion string\n605|\tProtocolVersion       string\n606|\tGeneration            string\n607|\tTerminalBindingID     string\n608|}\n609|\n610|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n611|// a descriptor whose binding digest, backend ID, versions, or generation does\n612|// not match the AX-validated host-local binding before launching or observing\n613|// a provider process. Generation lengths 0 and over 256 UTF-8 characters are\n614|// invalid; 256 is accepted.\n615|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n616|\tif err := checkGeneration(descriptor.Generation); err != nil {\n617|\t\treturn err\n618|\t}\n619|\tif err := checkGeneration(binding.Generation); err != nil {\n620|\t\treturn err\n621|\t}\n622|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n623|\t\treturn err\n624|\t}\n625|\tif descriptor.BackendID != binding.BackendID {\n626|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"})\n627|\t}\n628|\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\n629|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n630|\t}\n631|\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\n632|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n633|\t}\n634|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n635|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n636|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"})\n637|\t}\n638|\tif descriptor.Generation != binding.Generation {\n639|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"})\n640|\t}\n641|\treturn nil\n642|}\n643|\n644|// checkGeneration enforces string[1..256] measured in UTF-8 characters over\n645|// valid UTF-8 (SPEC.md:321).\n646|func checkGeneration(generation string) error {\n647|\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\n648|\t\treturn refuse(&Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"})\n649|\t}\n650|\treturn nil\n651|}\n652|\n653|// DigestFile returns the sha256: digest of the executable at path after\n654|// resolving symlinks. The target must be a regular file; anything else (or a\n655|// read failure) is an error, never a digest. It distinguishes a failed read\n656|// from an absent trust entry: callers must not fall back to PATH discovery.\n657|//\n658|// Trust here is Section 6.5 external_trust: the closed entry carries\n659|// exactly backend ID, absolute executable path, executable digest, and\n660|// enabled — there is no owner member, so no owner check applies. That\n661|// differs deliberately from provider trust under Section 7.1, which\n662|// requires the target be owned by the operator or an\n663|// administrator-approved identity (see provider.trustCandidate). The\n664|// symlink-resolution and regular-file steps mirror Section 7.1's\n665|// mechanics; the missing owner dimension is contractual — the closed\n666|// entry leaves no member to record an owner in — not drift. Do not add\n667|// an owner check here without a spec change, and do not read this\n668|// function as the provider trust path.\n669|func DigestFile(path string) (string, error) {\n670|\tresolved, err := filepath.EvalSymlinks(path)\n671|\tif err != nil {\n672|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n673|\t}\n674|\tinfo, err := os.Stat(resolved)\n675|\tif err != nil {\n676|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n677|\t}\n678|\tif !info.Mode().IsRegular() {\n679|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n680|\t}\n681|\traw, err := os.ReadFile(resolved)\n682|\tif err != nil {\n683|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n684|\t}\n685|\tsum := sha256.Sum256(raw)\n686|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n687|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
