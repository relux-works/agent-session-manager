{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca63","stream":{"kind":"session","id":"01a07aa8-9772-7fb3-a3d6-487c1d889dad"},"sequence":908,"recorded_at":1780531400001811,"record_type":"event","durability":"durable","causation_id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b","run_stream":{"kind":"run","id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b"},"task_stream":{"kind":"task","id":"ae1132b5-dde2-4a85-b765-503162bda094"},"task_id":"ae1132b5-dde2-4a85-b765-503162bda094","event":{"kind":"output","task_id":"ae1132b5-dde2-4a85-b765-503162bda094","chunk":"edited\nchanged lines: lines 316-346\n--- original\n+++ updated\n@@\n-// deriveBackendIDSites filters the production-derived refusal arms to the\n-// constructions naming BackendID: the census denominator. The filter reads\n-// the derived arm's production line through the shared core's scan, so a\n-// new BackendID arm is derived without anyone remembering this file.\n-func deriveBackendIDSites(t *testing.T) []refusalArm {\n-\tt.Helper()\n-\n-\tarms := deriveRefusalArms(t)\n-\tfiles, _ := invcore.MustScanProduction(t, \".\")\n-\tlinesByFile := make(map[string][]string, len(files))\n-\tfor _, production := range files {\n-\t\tlinesByFile[production.Name] = strings.Split(string(production.Source), \"\\n\")\n-\t}\n-\tvar sites []refusalArm\n-\tfor _, arm := range arms {\n-\t\tlines, known := linesByFile[arm.file]\n-\t\tif !known || arm.line < 1 || arm.line > len(lines) {\n-\t\t\tt.Fatalf(\"derived arm %s at %s:%d resolves to no production line\", describeArm(arm), arm.file, arm.line)\n-\t\t}\n-\t\t// mismatchf/integrityFailure sites never carry BackendID: their\n-\t\t// Detail is a static clause by derivation. Only refuse() sites\n-\t\t// with a BackendID key qualify.\n-\t\tif strings.Contains(lines[arm.line-1], \"BackendID:\") {\n-\t\t\tsites = append(sites, arm)\n-\t\t}\n-\t}\n-\tif len(sites) == 0 {\n-\t\tt.Fatal(\"derived zero BackendID refusal sites; the filter is broken, not the package\")\n-\t}\n-\treturn sites\n-}\n+// deriveBackendIDSites filters the production-derived refusal arms to the\n+// constructions naming BackendID: the census denominator. The filter\n+// reads each arm's derivation-time backendID flag — the refuse literal's\n+// AST keys, independent of source layout — so a new BackendID arm in any\n+// spelling (single-line or multi-line composite literal) is derived\n+// without anyone remembering this file. mismatchf/integrityFailure sites\n+// never carry BackendID: their Detail is a static clause by derivation\n+// and their constructors build no BackendID key.\n+func deriveBackendIDSites(t *testing.T) []refusalArm {\n+\tt.Helper()\n+\n+\treturn deriveBackendIDSitesIn(t, \".\")\n+}\n+\n+// deriveBackendIDSitesIn runs the site filter against an arbitrary\n+// directory. Production runs use \".\"; derivation tests stage a synthetic\n+// package copy under t.TempDir() to prove the filter against shapes the\n+// live tree does not contain.\n+func deriveBackendIDSitesIn(t *testing.T, dir string) []refusalArm {\n+\tt.Helper()\n+\n+\tvar sites []refusalArm\n+\tfor _, arm := range deriveRefusalArmsIn(t, dir) {\n+\t\tif arm.backendID {\n+\t\t\tsites = append(sites, arm)\n+\t\t}\n+\t}\n+\tif len(sites) == 0 {\n+\t\tt.Fatal(\"derived zero BackendID refusal sites; the filter is broken, not the package\")\n+\t}\n+\treturn sites\n+}\n"}}}
