{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c695","stream":{"kind":"session","id":"01a07aa8-9772-7fb3-a3d6-487c1d889dad"},"sequence":421,"recorded_at":1780531400000837,"record_type":"event","durability":"durable","causation_id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b","run_stream":{"kind":"run","id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b"},"task_stream":{"kind":"task","id":"addd4a67-42c5-4863-8e99-24bcdb8eefee"},"task_id":"addd4a67-42c5-4863-8e99-24bcdb8eefee","event":{"kind":"output","task_id":"addd4a67-42c5-4863-8e99-24bcdb8eefee","chunk":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(157 line(s) above)\n158|func deriveRefusalArms(t *testing.T) []refusalArm {\n159|\tt.Helper()\n160|\n161|\t// Production-file selection and fail-closed parsing are the shared\n162|\t// core's: a new production file is scanned without anyone\n163|\t// remembering it, and an unparseable file fails, never skips.\n164|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n165|\n166|\tvar arms []refusalArm\n167|\tparsed := 0\n168|\tfor _, production := range files {\n169|\t\tfile, name := production.Syntax, production.Name\n170|\t\tparsed++\n171|\t\tlineOf := func(position token.Pos) int {\n172|\t\t\treturn fileSet.Position(position).Line\n173|\t\t}\n174|\t\t// errorLiteral reads one &Error{Code:, Detail:} literal into its\n175|\t\t// static code symbol and detail. Anything else fails the\n176|\t\t// derivation: a refusal the inventory cannot name is a refusal it\n177|\t\t// cannot witness.\n178|\t\terrorLiteral := func(functionName string, literal *ast.CompositeLit) (string, string) {\n179|\t\t\tidentifier, ok := literal.Type.(*ast.Ident)\n180|\t\t\tif !ok || identifier.Name != \"Error\" {\n181|\t\t\t\tt.Fatalf(\"%s: refuse wraps a non-Error literal; only &Error literals route through refuse\", functionName)\n182|\t\t\t}\n183|\t\t\tcode, detail := \"\", \"\"\n184|\t\t\tfor _, element := range literal.Elts {\n185|\t\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n186|\t\t\t\tif !ok {\n187|\t\t\t\t\tcontinue\n188|\t\t\t\t}\n189|\t\t\t\tkey, ok := pair.Key.(*ast.Ident)\n190|\t\t\t\tif !ok {\n191|\t\t\t\t\tcontinue\n192|\t\t\t\t}\n193|\t\t\t\tswitch key.Name {\n194|\t\t\t\tcase \"Code\":\n195|\t\t\t\t\tsymbol, ok := pair.Value.(*ast.Ident)\n196|\t\t\t\t\tif !ok {\n197|\t\t\t\t\t\tt.Fatalf(\"%s: refusal code is not a static Code symbol; \"+\n198|\t\t\t\t\t\t\t\"a computed code cannot be inventoried\", functionName)\n199|\t\t\t\t\t}\n200|\t\t\t\t\tcode = symbol.Name\n201|\t\t\t\tcase \"Detail\":\n202|\t\t\t\t\tdetail = staticDetail(t, functionName, pair.Value)\n203|\t\t\t\t}\n204|\t\t\t}\n205|\t\t\tif code == \"\" || detail == \"\" {\n206|\t\t\t\tt.Fatalf(\"%s: refusal without a static code and detail; \"+\n207|\t\t\t\t\t\"the inventory cannot name what it cannot read\", functionName)\n208|\t\t\t}\n209|\t\t\treturn code, detail\n210|\t\t}\n211|\t\tcollect := func(functionName string, root ast.Node) {\n212|\t\t\tast.Inspect(root, func(node ast.Node) bool {\n213|\t\t\t\tswitch expression := node.(type) {\n214|\t\t\t\tcase *ast.UnaryExpr:\n215|\t\t\t\t\tif expression.Op != token.AND {\n216|\t\t\t\t\t\treturn true\n217|\t\t\t\t\t}\n218|\t\t\t\t\tliteral, ok := expression.X.(*ast.CompositeLit)\n219|\t\t\t\t\tif !ok {\n220|\t\t\t\t\t\treturn true\n221|\t\t\t\t\t}\n222|\t\t\t\t\tif identifier, ok := literal.Type.(*ast.Ident); !ok || identifier.Name != \"Error\" {\n223|\t\t\t\t\t\treturn true\n224|\t\t\t\t\t}\n225|\t\t\t\t\t// A wrapped literal never reaches here: the refuse\n226|\t\t\t\t\t// CallExpr case below consumes it and prunes the\n227|\t\t\t\t\t// descent. An &Error literal built outside refuse is\n228|\t\t\t\t\t// an unregistered construction: it refuses without\n229|\t\t\t\t\t// recording its site, so the exercised-site audit\n230|\t\t\t\t\t// cannot see it, and it fails here instead of\n231|\t\t\t\t\t// shipping silently.\n232|\t\t\t\t\tt.Fatalf(\"%s (%s:%d): &Error literal outside refuse(); \"+\n233|\t\t\t\t\t\t\"route every production refusal through refuse so the site audit can attribute it\",\n234|\t\t\t\t\t\tfunctionName, name, lineOf(expression.Pos()))\n235|\t\t\t\t\treturn false\n236|\t\t\t\tcase *ast.CallExpr:\n237|\t\t\t\t\tif identifier, ok := expression.Fun.(*ast.Ident); ok && identifier.Name == \"refuse\" {\n238|\t\t\t\t\t\tif len(expression.Args) != 1 {\n239|\t\t\t\t\t\t\tt.Fatalf(\"%s: refuse with %d arguments; refuse wraps exactly one &Error literal\",\n240|\t\t\t\t\t\t\t\tfunctionName, len(expression.Args))\n241|\t\t\t\t\t\t}\n242|\t\t\t\t\t\tunary, ok := expression.Args[0].(*ast.UnaryExpr)\n243|\t\t\t\t\t\tif !ok || unary.Op != token.AND {\n244|\t\t\t\t\t\t\tt.Fatalf(\"%s (%s:%d): refuse wraps a non-literal; refuse takes exactly one &Error literal, never a variable\",\n245|\t\t\t\t\t\t\t\tfunctionName, name, lineOf(expression.Pos()))\n246|\t\t\t\t\t\t}\n247|\t\t\t\t\t\tliteral, ok := unary.X.(*ast.CompositeLit)\n248|\t\t\t\t\t\tif !ok {\n249|\t\t\t\t\t\t\tt.Fatalf(\"%s (%s:%d): refuse wraps a non-literal; refuse takes exactly one &Error literal, never a variable\",\n250|\t\t\t\t\t\t\t\tfunctionName, name, lineOf(expression.Pos()))\n251|\t\t\t\t\t\t}\n252|\t\t\t\t\t\tcode, detail := errorLiteral(functionName, literal)\n253|\t\t\t\t\t\tarms = append(arms, refusalArm{\n254|\t\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n255|\t\t\t\t\t\t\tline: lineOf(expression.Pos()),\n256|\t\t\t\t\t\t})\n257|\t\t\t\t\t\treturn false\n258|\t\t\t\t\t}\n259|\t\t\t\t\tidentifier, ok := expression.Fun.(*ast.Ident)\n260|\t\t\t\t\tif !ok || !constructorFunctions[identifier.Name] {\n261|\t\t\t\t\t\treturn true\n262|\t\t\t\t\t}\n263|\t\t\t\t\tif len(expression.Args) != 1 {\n264|\t\t\t\t\t\tt.Fatalf(\"%s: %s with %d arguments; Detail must be a single \"+\n265|\t\t\t\t\t\t\t\"static literal and never interpolate local data, and a \"+\n266|\t\t\t\t\t\t\t\"variadic detail cannot be inventoried\",\n267|\t\t\t\t\t\t\tfunctionName, identifier.Name, len(expression.Args))\n268|\t\t\t\t\t}\n269|\t\t\t\t\tliteral, ok := expression.Args[0].(*ast.BasicLit)\n270|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n271|\t\t\t\t\t\tt.Fatalf(\"%s: %s detail is not a static string literal; \"+\n272|\t\t\t\t\t\t\t\"a computed detail cannot be inventoried\", functionName, identifier.Name)\n273|\t\t\t\t\t}\n274|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n275|\t\t\t\t\tif err != nil {\n276|\t\t\t\t\t\tt.Fatalf(\"%s: unquote detail: %v\", functionName, err)\n277|\t\t\t\t\t}\n278|\t\t\t\t\tcode := \"CodeMismatch\"\n279|\t\t\t\t\tif identifier.Name == \"integrityFailure\" {\n280|\t\t\t\t\t\tcode = \"CodeIntegrityFailure\"\n281|\t\t\t\t\t}\n282|\t\t\t\t\tarms = append(arms, refusalArm{\n283|\t\t\t\t\t\tfile: name, function: functionName, code: code, detail: detail,\n284|\t\t\t\t\t\tline: lineOf(expression.Pos()),\n285|\t\t\t\t\t})\n286|\t\t\t\t}\n287|\t\t\t\treturn true\n288|\t\t\t})\n289|\t\t}\n290|\t\tfor _, declaration := range file.Decls {\n291|\t\t\tswitch decl := declaration.(type) {\n292|\t\t\tcase *ast.FuncDecl:\n293|\t\t\t\tif decl.Body == nil {\n294|\t\t\t\t\tcontinue\n295|\t\t\t\t}\n296|\t\t\t\tif constructorFunctions[decl.Name.Name] {\n297|\t\t\t\t\tcontinue\n298|\t\t\t\t}\n299|\t\t\t\tfunctionName := decl.Name.Name\n300|\t\t\t\tif decl.Recv != nil && len(decl.Recv.List) > 0 {\n301|\t\t\t\t\tfunctionName = receiverTypeName(decl.Recv.List[0].Type) + \".\" + functionName\n302|\t\t\t\t}\n303|\t\t\t\tcollect(functionName, decl.Body)\n304|\t\t\tcase *ast.GenDecl:\n305|\t\t\t\t// Package-level initializers execute outside any FuncDecl,\n306|\t\t\t\t// so a func literal (or a bare &Error{}) assigned to a\n307|\t\t\t\t// package var would otherwise ship invisible. Attribute\n308|\t\t\t\t// its arms to the declared variable name.\n309|\t\t\t\tfor _, spec := range decl.Specs {\n310|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n311|\t\t\t\t\tif !ok {\n312|\t\t\t\t\t\tcontinue\n313|\t\t\t\t\t}\n314|\t\t\t\t\tfunctionName := \"var\"\n315|\t\t\t\t\tif len(value.Names) > 0 {\n316|\t\t\t\t\t\tfunctionName = value.Names[0].Name\n317|\t\t\t\t\t}\n318|\t\t\t\t\tfor _, item := range value.Values {\n319|\t\t\t\t\t\tcollect(functionName, item)\n320|\t\t\t\t\t}\n321|\t\t\t\t}\n322|\t\t\t}\n323|\t\t}\n324|\t\tinvcore.MustAuditConstructorReferences(t, file, fileSet, name, refusalConstructorSpec())\n325|\t}\n326|\t_ = parsed\n327|\tif len(arms) == 0 {\n328|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n329|\t}\n330|\toccurrences := make(map[refusalArm]int)\n331|\tfor index := range arms {\n332|\t\t// The occurrence index counts identical (file, function, code,\n(more lines below)"}}}
