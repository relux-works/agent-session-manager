teral.Elts {\n+\t\tpair, ok := element.(*ast.KeyValueExpr)\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif key, ok := pair.Key.(*ast.Ident); ok && key.Name == \"BackendID\" {\n+\t\t\treturn true\n+\t\t}\n+\t}\n+\treturn false\n+}\n"}}}
