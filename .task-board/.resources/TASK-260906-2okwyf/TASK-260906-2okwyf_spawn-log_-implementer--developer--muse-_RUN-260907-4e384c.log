{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c9","stream":{"kind":"session","id":"01a07aa8-9772-7fb3-a3d6-487c1d889dad"},"sequence":575,"recorded_at":1780531400001145,"record_type":"event","durability":"durable","causation_id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b","run_stream":{"kind":"run","id":"a1248ce4-fca2-4c19-838c-c9c2fefd9f3b"},"task_stream":{"kind":"task","id":"f7dd4342-0edd-49be-becc-0b41c162842c"},"task_id":"f7dd4342-0edd-49be-becc-0b41c162842c","event":{"kind":"output","task_id":"f7dd4342-0edd-49be-becc-0b41c162842c","chunk":"Read text file `.temp/TASK-260906-2okwyf/mutate_base.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"v8heil mutation battery: apply one textual mutant, run a census mask and a\n3|behavioural mask separately, restore the file byte-for-byte, report per-mask\n4|verdicts plus the kill split.\n5|\n6|Verdicts per mask:\n7|  KILLED       mutant applied, mask FAILED\n8|  SURVIVED     mutant applied, mask PASSED\n9|Overall:\n10|  KILLED       at least one mask failed (killer masks listed)\n11|  SURVIVED     both masks passed  <-- finding, must be accounted\n12|  NOT_APPLIED  anchor not found exactly once (control row)\n13|  COMPILE_FAIL build/vet broke (control row)\n14|\"\"\"\n15|import hashlib\n16|import json\n17|import subprocess\n18|import sys\n19|\n20|ROOT = \"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree\"\n21|\n22|\n23|def sha(path):\n24|    with open(path, \"rb\") as handle:\n25|        return hashlib.sha256(handle.read()).hexdigest()\n26|\n27|\n28|def run_mask(pkg, run):\n29|    # Empty run selects the whole package (no -run flag): provider's\n30|    # TestMain audit only runs unscoped, so a scoped census mask would\n31|    # pass vacuously. Non-empty masks stay scoped.\n32|    cmd = [\"go\", \"test\", pkg, \"-count=1\", \"-v\"]\n33|    if run:\n34|        cmd += [\"-run\", run]\n35|    res = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)\n36|    out = res.stdout + res.stderr\n37|    ran = out.count(\"--- PASS\") + out.count(\"--- FAIL\")\n38|    verdict = \"KILLED\" if res.returncode != 0 else \"SURVIVED\"\n39|    evidence = [line for line in out.splitlines()\n40|                if \"FAIL\" in line or \"want\" in line\n41|                or \"refusal-site audit\" in line][:6]\n42|    return {\"verdict\": verdict, \"ran\": ran, \"evidence\": evidence}\n43|\n44|\n45|def run(mut):\n46|    path = ROOT + \"/\" + mut[\"file\"]\n47|    with open(path, \"r\", encoding=\"utf-8\") as handle:\n48|        original = handle.read()\n49|    before = hashlib.sha256(original.encode()).hexdigest()\n50|    old, new = mut[\"old\"], mut[\"new\"]\n51|    count = original.count(old)\n52|    if count != 1:\n53|        return {\"id\": mut[\"id\"], \"class\": mut[\"class\"],\n54|                \"verdict\": \"NOT_APPLIED\",\n55|                \"detail\": \"anchor occurs %d times\" % count}\n56|    try:\n57|        with open(path, \"w\", encoding=\"utf-8\") as handle:\n58|            handle.write(original.replace(old, new, 1))\n59|        pkg = \"./\" + mut[\"file\"].split(\"/\")[0] + \"/\" + mut[\"file\"].split(\"/\")[1] + \"/\"\n60|        vet = subprocess.run([\"go\", \"vet\", pkg], cwd=ROOT,\n61|                             capture_output=True, text=True)\n62|        if vet.returncode != 0:\n63|            return {\"id\": mut[\"id\"], \"class\": mut[\"class\"],\n64|                    \"verdict\": \"COMPILE_FAIL\",\n65|                    \"detail\": vet.stderr.strip().splitlines()[:3]}\n66|        census = run_mask(mut.get(\"census_pkg\", pkg), mut[\"census_run\"])\n67|        behav = run_mask(mut.get(\"behav_pkg\", pkg), mut[\"behav_run\"])\n68|        masks = [(\"census\", census), (\"behav\", behav)]\n69|        record = {\"id\": mut[\"id\"], \"class\": mut[\"class\"],\n70|                  \"expect\": mut.get(\"expect\"),\n71|                  \"census\": census, \"behav\": behav}\n72|        # Audit mask (round 2): a full-package run whose TestMain audit\n73|        # compares the exercised site set against the derivation. Scoped\n74|        # census/behav masks skip that audit by construction, so a mutant\n75|        # the derivation cannot see and the witnesses cannot feel (the\n76|        # P8 sibling-swallow shape) is green on both and red here.\n77|        if \"audit_run\" in mut or \"audit_pkg\" in mut:\n78|            audit = run_mask(mut.get(\"audit_pkg\", pkg), mut.get(\"audit_run\", \"\"))\n79|            masks.append((\"audit\", audit))\n80|            record[\"audit\"] = audit\n81|        killers = [name for name, res in masks if res[\"verdict\"] == \"KILLED\"]\n82|        record[\"verdict\"] = \"KILLED\" if killers else \"SURVIVED\"\n83|        record[\"killers\"] = killers\n84|        return record\n85|    finally:\n86|        with open(path, \"w\", encoding=\"utf-8\") as handle:\n87|            handle.write(original)\n88|        if sha(path) != before:\n89|            print(\"!!! RESTORE FAILED for %s\" % path, file=sys.stderr)\n90|            sys.exit(2)\n91|\n92|\n93|if __name__ == \"__main__\":\n94|    muts = json.load(open(sys.argv[1]))\n95|    out = []\n96|    for item in muts:\n97|        record = run(item)\n98|        out.append(record)\n99|        print(json.dumps(record), flush=True)\n100|    summary = {v: sum(1 for r in out if r[\"verdict\"] == v)\n101|               for v in (\"KILLED\", \"SURVIVED\", \"NOT_APPLIED\", \"COMPILE_FAIL\")}\n102|    print(\"SUMMARY \" + json.dumps(summary), flush=True)\n103|    with open(sys.argv[2], \"w\") as handle:\n104|        json.dump({\"results\": out, \"summary\": summary}, handle, indent=2)"}}}
