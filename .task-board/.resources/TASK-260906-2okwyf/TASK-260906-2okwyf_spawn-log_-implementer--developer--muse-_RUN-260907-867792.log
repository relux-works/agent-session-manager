{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d251","stream":{"kind":"session","id":"01a07a14-3fcf-7150-a439-df8b693b4c31"},"sequence":1923,"recorded_at":1780531400003841,"record_type":"event","durability":"durable","causation_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","run_stream":{"kind":"run","id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec"},"call_id":"call_01a07a1d118171a395ad53e37039de49","text":"{\n  \"chunk_id\": \"exec-87-1\",\n  \"command\": \"sed -n '1,80p' internal/terminalbackend/refusal_site_audit_test.go; grep -n \\\"func Test\\\" internal/terminalbackend/refusal_site_audit_test.go internal/terminalbackend/refusal_arm_inventory_test.go | head -n 20\",\n  \"description\": \"Read tb site audit semantics\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"// Exercised-site audit for the terminal backend refusal arms.\\n//\\n// The failure this file exists to prevent: a declared, witnessed arm going\\n// dead by construction while the whole suite stays green. Witnesses assert\\n// the (code, detail) pair at a public entry; several arms share one pair\\n// (62 of 184 witnessed arms share their clause with a sibling), so a\\n// widened earlier guard swallows a later arm's inputs and the later\\n// witness still passes through the sibling. That plant (P8:\\n// CheckEntrypoint's first session parse widened to also compare, killing\\n// the second parse and the comparison arms) left the derived set\\n// byte-identical, the bijection at 210/210, and every witness green.\\n//\\n// The audit closes it the way provider and provhost already do: every\\n// production refusal construction records its file:line at runtime\\n// (through refuse/mismatchf/integrityFailure, armed by TestMain below),\\n// and the post-run audit requires every derived non-bound line to have\\n// fired at least once, and every fired line to be derived. A shadowed arm\\n// never fires, so it reddens here as a derived site without an exercised\\n// path. Bound arms (26 rows no input can reach) are exempt by their\\n// declared rows, mapped to lines by TestDerivedSiteLinesAreExactlyRowed,\\n// never by hand.\\n//\\n// Recording is off (nil hook) in production: construction is then a pure\\n// allocation with zero behavior change.\\npackage terminalbackend\\n\\nimport (\\n\\t\\\"flag\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"os\\\"\\n\\t\\\"runtime\\\"\\n\\t\\\"sort\\\"\\n\\t\\\"strconv\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"sync\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/invcore\\\"\\n)\\n\\n// refusalSiteRecorder is the shared core's runtime direction: the\\n// production file:line behind every refusal construction during the test\\n// run, plus the wire codes those refusals carried. The hook is armed in\\n// TestMain, so an aliased constructor still executes the funnel and\\n// records its real production site: the runtime direction of the\\n// alias-bypass union.\\nvar refusalSiteRecorder = invcore.NewSiteRecorder()\\n\\nfunc TestMain(main *testing.M) {\\n\\trecordRefusal = func(code, detail string) {\\n\\t\\t// Skip counts the frames between Record and the production\\n\\t\\t// site: the hook closure plus the funnel frame, matching the\\n\\t\\t// provider/provhost swapped-constructor convention exactly\\n\\t\\t// (pinned by TestRefusalSiteAttributionIsExact, not by reading).\\n\\t\\trefusalSiteRecorder.Record(code, 2)\\n\\t}\\n\\tcode := main.Run()\\n\\tif code == 0 && fullPackageTestRun() {\\n\\t\\tif failures := auditRefusalInventory(); len(failures) != 0 {\\n\\t\\t\\tfor _, failure := range failures {\\n\\t\\t\\t\\tfmt.Fprintln(os.Stderr, failure)\\n\\t\\t\\t}\\n\\t\\t\\tcode = 1\\n\\t\\t}\\n\\t}\\n\\tos.Exit(code)\\n}\\n\\nfunc fullPackageTestRun() bool {\\n\\tselected := flag.Lookup(\\\"test.run\\\")\\n\\treturn selected == nil || selected.Value.String() == \\\"\\\"\\n}\\n\\n// refusalAuditDomain is the captured in-band derivation the post-run\\n// audit compares the exercised set against. It is captured by\\n// TestDerivedSiteLinesAreExactlyRowed (which runs with a *testing.T and\\n// can use the rich derivation) because TestMain has no *testing.T to\\n// derive with. The audit fails closed when the domain is missing: a\\n// scoped (-run) run never reaches the audit by fullPackageTestRun.\\ntype refusalAuditDomain struct {\\ninternal/terminalbackend/refusal_site_audit_test.go:49:func TestMain(main *testing.M) {\\ninternal/terminalbackend/refusal_site_audit_test.go:94:func TestDerivedSiteLinesAreExactlyRowed(t *testing.T) {\\ninternal/terminalbackend/refusal_site_audit_test.go:217:func TestRefusalSiteAttributionIsExact(t *testing.T) {\\ninternal/terminalbackend/refusal_site_audit_test.go:261:func TestRefuseFunnelRejectsAliases(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:845:func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:856:func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:944:func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:972:func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:1036:func TestCheckTransitionOperationVocabularyIsUnreachable(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:1135:func TestDecodeCappedValueDefensiveSitesAreUnreachable(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:1170:func TestCanonicalPlumbingIsTotalOnDecodedMaps(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:1217:func TestShadowedLookupsHaveNoInput(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:1906:func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:1990:func TestPlainErrorsLiveOnlyInTheirTwoFunctions(t *testing.T) {\\ninternal/terminalbackend/refusal_arm_inventory_test.go:2070:func TestDigestFileRefusalsAreNeverWireErrors(t *testing.T) {\\n\",\n  \"original_output_bytes\": 4978,\n  \"original_output_tokens\": 1245,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
