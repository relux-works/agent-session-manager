{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f3","stream":{"kind":"session","id":"01a07a14-3fcf-7150-a439-df8b693b4c31"},"sequence":724,"recorded_at":1780531400001443,"record_type":"event","durability":"durable","causation_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","run_stream":{"kind":"run","id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec"},"task_stream":{"kind":"task","id":"49ca4ac4-51d8-4e4f-88d3-e85c68695974"},"task_id":"49ca4ac4-51d8-4e4f-88d3-e85c68695974","event":{"kind":"output","task_id":"49ca4ac4-51d8-4e4f-88d3-e85c68695974","chunk":"{\n  \"chunk_id\": \"exec-34-1\",\n  \"command\": \"sed -n '1460,1530p' internal/terminalbackend/conformance_test.go\\necho =====\\nsed -n '2085,2125p' internal/terminalbackend/refusal_arm_witnesses_test.go\",\n  \"description\": \"Read grammar-arm witness tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t\\t_, err := terminalbackend.TranslateLegacyBackend(legacy)\\n\\t\\trequireConformanceRefusal(t, err,\\n\\t\\t\\t\\\"incompatible_schema\\\", \\\"legacy backend identity\\\")\\n\\t}\\n}\\n\\n// TestLegacyReverseProjectionExistsOnlyForThePair proves the reverse\\n// direction: the two canonical built-ins project back, every other valid\\n// ID is incompatible rather than fallback, and a malformed identity is\\n// refused by the registry grammar first.\\nfunc TestLegacyReverseProjectionExistsOnlyForThePair(t *testing.T) {\\n\\tt.Parallel()\\n\\n\\tlegacy, err := terminalbackend.ProjectToLegacy(terminalbackend.BuiltinTmux)\\n\\tif err != nil || legacy != \\\"tmux\\\" {\\n\\t\\tt.Errorf(\\\"ProjectToLegacy(ax.tmux) = %q, %v, want tmux, nil\\\", legacy, err)\\n\\t}\\n\\tlegacy, err = terminalbackend.ProjectToLegacy(terminalbackend.BuiltinConpty)\\n\\tif err != nil || legacy != \\\"conpty\\\" {\\n\\t\\tt.Errorf(\\\"ProjectToLegacy(ax.