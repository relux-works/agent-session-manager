{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caef","stream":{"kind":"session","id":"01a07a14-3fcf-7150-a439-df8b693b4c31"},"sequence":978,"recorded_at":1780531400001951,"record_type":"event","durability":"durable","causation_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","run_stream":{"kind":"run","id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec"},"call_id":"call_01a07a17d27f7883a9566e831bb0847e","text":"{\n  \"chunk_id\": \"exec-48-1\",\n  \"command\": \"sed -n '230,330p' .github/workflows/ci.yml; grep -c \\\"^  [a-z-]*:$\\\" .github/workflows/ci.yml; grep -n \\\"^  [a-z-]*:$\\\" .github/workflows/ci.yml\",\n  \"description\": \"Read remaining CI jobs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Targets are derived per package from the compiled test binaries,\\n      # never retyped: only names starting with Fuzz are fuzz targets. An\\n      # empty derivation fails the grep and the explicit size check alike,\\n      # and the total count is pinned: a new fuzz target without a CI\\n      # update reddens here instead of going unsmoked.\\n      - name: Derive fuzz targets\\n        run: |\\n          rm -f fuzz-targets.clean\\n          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\\n            go test \\\"./${pkg}\\\" -list '^Fuzz' > \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" 2>&1\\n            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n          done\\n          test -s fuzz-targets.clean\\n          test \\\"$(wc -l < fuzz-targets.clean | tr -d ' ')\\\" -eq 13\\n          cat fuzz-targets.clean\\n\\n      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n      # derivation, which maps each target to the production entry it\\n      # drives. Either side drifting — a target without an entry, or an\\n      # entry without a target — fails the diff before any smoke runs.\\n      - name: Check secconftest list matches the target derivation\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. Live probe outcomes are never read here;\\n      # ProbeState.Available is consumed by no call site. README prose is\\n      # never capability evidence either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Compile-and-vet only: go vet type-checks test files as well, and no\\n      # step here executes a Windows binary. A green here must never be read\\n      # as behaviour executed on Windows.\\n      - name: Compile for Windows\\n        run: GOOS=windows go build ./...\\n\\n11\\n5:  push:\\n22:  contract-preservation:\\n59:  lint:\\n93:  test:\\n129:  race:\\n152:  coverage:\\n188:  fixture-matrix:\\n225:  fuzz-smoke:\\n280:  capability-claims:\\n312:  windows-compile-only:\\n334:  gates-verdict:\\n\",\n  \"original_output_bytes\": 4760,\n  \"original_output_tokens\": 1190,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
