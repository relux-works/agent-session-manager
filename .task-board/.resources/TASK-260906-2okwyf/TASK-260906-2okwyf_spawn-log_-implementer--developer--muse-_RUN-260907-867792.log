{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cda9","stream":{"kind":"session","id":"01a07a14-3fcf-7150-a439-df8b693b4c31"},"sequence":1327,"recorded_at":1780531400002649,"record_type":"event","durability":"durable","causation_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","run_stream":{"kind":"run","id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec"},"task_stream":{"kind":"task","id":"741d837a-b374-42b4-b24b-4c0cd91cb2d3"},"task_id":"741d837a-b374-42b4-b24b-4c0cd91cb2d3","event":{"kind":"output","task_id":"741d837a-b374-42b4-b24b-4c0cd91cb2d3","chunk":"edited\nchanged lines: lines 152-162\n--- original\n+++ updated\n@@\n-// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n-// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n-// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n-// is refused so a third party cannot mint a trusted-looking identity.\n-func ParseID(value string) (string, error) {\n-\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n-\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"})\n-\t}\n-\tif !idPattern.MatchString(value) {\n-\t\treturn \"\", refuse(&Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id grammar\"})\n-\t}\n+// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n+// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n+// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n+// is refused so a third party cannot mint a trusted-looking identity.\n+//\n+// The bound and grammar arms omit BackendID on purpose: a value refused\n+// there is arbitrary UTF-8 up to 128 bytes, and the package posture is\n+// that refusals never echo local data. Only the reserved-namespace arm\n+// names the identity, because its input already passed the grammar and\n+// is a validated identity like every other BackendID in the package.\n+func ParseID(value string) (string, error) {\n+\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n+\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"})\n+\t}\n+\tif !idPattern.MatchString(value) {\n+\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id grammar\"})\n+\t}\n"}}}
