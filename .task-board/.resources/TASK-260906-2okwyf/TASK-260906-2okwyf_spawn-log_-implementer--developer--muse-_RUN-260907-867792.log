{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2dd","stream":{"kind":"session","id":"01a07a14-3fcf-7150-a439-df8b693b4c31"},"sequence":1993,"recorded_at":1780531400003981,"record_type":"event","durability":"durable","causation_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec","run_stream":{"kind":"run","id":"ddf54e2b-9c50-4ed8-b607-e33112c6c7ec"},"task_stream":{"kind":"task","id":"544b9bf4-e6f9-4f05-9c17-ba1419057409"},"task_id":"544b9bf4-e6f9-4f05-9c17-ba1419057409","event":{"kind":"output","task_id":"544b9bf4-e6f9-4f05-9c17-ba1419057409","chunk":"edited\nchanged lines: lines 10-32\n--- original\n+++ updated\n@@\n-// TestBuiltinsEqualProfileProviders pins the cross-package agreement\n-// between the two hand-written six-provider literals directly: the\n-// Section 7.1 built-in registry behind provider.Builtins and the\n-// Section 7.7 provider registry behind profileProviders.\n-//\n-// Each side already carries its own spec derivation (provider's\n-// TestSection71BuiltinRegistryIsDocumentOrder against the Section 7.1\n-// window, this package's TestProfileYOLOMappingIsDerivedFromSpec\n-// against the Section 7.7 table), but those derivations resolve through\n-// two different SPEC.md line windows, so while the pin holds a green\n-// suite cannot diverge only transitively. This test closes the seam\n-// structurally: it reads no SPEC.md line, compares the two production\n-// registries directly, and fails when either side changes alone — a\n-// seventh member, a rename, a removal, or a reorder on exactly one\n-// side reddens here.\n-//\n-// The comparison is order-sensitive on purpose. Both orders are\n-// independently spec-pinned (Section 7.1 listed order for discovery\n-// enumeration, Section 7.7 table order for the profile registry),\n-// so ordered equality holds today; a future spec bump that\n-// legitimately reorders one table must consciously revisit this\n-// agreement rather than drift through a set-only check.\n-func TestBuiltinsEqualProfileProviders(t *testing.T) {\n+// TestBuiltinsEqualProfileProviders pins the cross-package agreement\n+// between the two hand-written six-provider literals directly: the\n+// Section 7.1 built-in registry behind provider.Builtins and the\n+// Section 7.7 provider registry behind profileProviders. It reads no\n+// SPEC.md line, so the agreement no longer runs only transitively\n+// through the two derivations' different line windows (provider's\n+// TestSection71BuiltinRegistryIsDocumentOrder against Section 7.1,\n+// this package's TestProfileYOLOMappingIsDerivedFromSpec against the\n+// Section 7.7 table).\n+//\n+// Set agreement already has a direct pin:\n+// TestSixProviderSetMatchesDiscoveryRegistry balances the two sets.\n+// That pin is order-insensitive, so a reorder on exactly one side\n+// leaves the whole suite green — the remaining structural hole. This\n+// test closes it with an order-sensitive comparison: both orders are\n+// independently spec-pinned (Section 7.1 listed order is the discovery\n+// enumeration order, Section 7.7 table order is the profile registry\n+// order), so ordered equality holds today, and a seventh member, a\n+// rename, a removal, or a reorder on either side alone reddens here.\n+// A future spec bump that legitimately reorders one table must\n+// consciously revisit this agreement rather than drift through a\n+// set-only check.\n+func TestBuiltinsEqualProfileProviders(t *testing.T) {\n"}}}
