+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+
+	"github.com/relux-works/agent-session-manager/internal/specpin"
+)
+
+func main() {
+	first := specpin.Bytes()
+	second := specpin.Bytes()
+	if len(first) < 4 || len(second) != len(first) {
+		fmt.Fprintln(os.Stderr, "unexpected embedded lock size")
+		os.Exit(1)
+	}
+
+	first[2] = '\t'
+	if second[2] == '\t' {
+		fmt.Fprintln(os.Stderr, "Bytes returned aliased storage")
+		os.Exit(1)
+	}
+
+	candidate := specpin.Bytes()
+	if candidate[2] != ' ' || candidate[3] != ' ' {
+		fmt.Fprintln(os.Stderr, "unexpected lock indentation")
+		os.Exit(1)
+	}
+	candidate[2] = '\t'
+	candidate[3] = ' '
+	if _, err := specpin.Verify(candidate); !errors.Is(err, specpin.ErrPinMismatch) {
+		fmt.Fprintf(os.Stderr, "same-length byte substitution error = %v, want ErrPinMismatch\n", err)
+		os.Exit(1)
+	}
+
+	if _, err := specpin.Current(); err != nil {
+		fmt.Fprintf(os.Stderr, "Current error = %v\n", err)
+		os.Exit(1)
+	}
+
+	fmt.Println("same_length_byte_substitution=REFUSED")
+	fmt.Println("bytes_copy_isolation=PASS")
+	fmt.Println("current_entry_point=PASS")
+}

