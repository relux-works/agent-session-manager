from pathlib import Path
import hashlib, html, json, re

root = Path('.')
upstream = root / '.temp/TASK-260830-2it6xy/spec-source'
lock_path = root / 'internal/specpin/v0.5.0.lock.json'
spec = (upstream / 'SPEC.md').read_text()
lock_bytes = lock_path.read_bytes()
lock = json.loads(lock_bytes)

section = spec.split('### 1.5 Normative contract registry', 1)[1].split('The exact historical v0.4.3 registry', 1)[0]
rows = []
for line in section.splitlines():
    if not line.startswith('|') or 'urn:ax:' not in line:
        continue
    cells = [cell.strip() for cell in line.strip().strip('|').split('|')]
    name = html.unescape(re.sub(r'<["'^>]+>'"', '', cells[0]))
    urn = re.search(r'urn:ax:(?:schema|protocol):[a-z0-9-]+', cells[1]).group(0)
    versions = re.findall(r'\\b\\d+\\.\\d+\\.\\d+\\b', cells[2])
    rows.append({'name': name, 'id': urn, 'versions': versions})
assert len(rows) == 60, len(rows)
assert rows == lock['contracts']

expected_absent = [
    'Terminal Backend protocol', 'Terminal Backend manifest',
    'Terminal Backend probe', 'Terminal Instance binding',
    'Terminal capability evidence',
]
expected_overrides = {
    ('Configuration', 'urn:ax:schema:config'): ['1.0.0', '2.0.0'],
    ('Provider protocol', 'urn:ax:protocol:provider'): ['2.0.0'],
    ('Mesh RPC', 'urn:ax:protocol:rpc'): ['2.0.0', '3.0.0'],
    ('Session event', 'urn:ax:schema:session-event'): ['1.0.0', '2.0.0', '3.0.0'],
    ('Structured error', 'urn:ax:schema:error'): ['1.0.0', '1.1.0', '1.2.0'],
    ('CLI result', 'urn:ax:schema:cli-result'): ['1.0.0', '2.0.0', '3.0.0'],
}
compat = lock['compatibility']
assert compat['absent_contracts'] == expected_absent
assert {(r['name'], r['id']): r['versions'] for r in compat['version_overrides']} == expected_overrides
historical = []
for row in rows:
