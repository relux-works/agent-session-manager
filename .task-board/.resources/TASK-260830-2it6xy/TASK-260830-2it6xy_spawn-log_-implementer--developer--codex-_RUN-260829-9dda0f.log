+    "tag_object": "d3da6614a6c7bf119a88c9596a86c0853c22cfb9",
+    "commit": "28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c",
+    "document": {
+      "path": "SPEC.md",
+      "sha256": "562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a"
+    },
+    "normative_scope": [
+      "1",
+      "17",
+      "20",
+      "appendix-a",
+      "appendix-d"
+    ]
+  },
+  "contracts": [
+    {
+      "name": "Configuration",
+      "id": "urn:ax:schema:config",
+      "versions": ["1.0.0", "2.0.0", "3.0.0"]
+    },
+    {
+      "name": "Provider protocol",
+      "id": "urn:ax:protocol:provider",
+      "versions": ["2.0.0", "3.0.0"]
+    },
+    {
+      "name": "Provider manifest",
+      "id": "urn:ax:schema:provider-manifest",
+      "versions": ["1.0.0"]
+    },
+    {
+      "name": "Provider probe",
+      "id": "urn:ax:schema:provider-probe",
+      "versions": ["1.0.0"]
+    },
+    {
+      "name": "Terminal Backend protocol",
+      "id": "urn:ax:protocol:terminal-backend",
+      "versions": ["1.0.0"]
+    },
