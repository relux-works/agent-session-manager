index 0000000000000000000000000000000000000000..ff4b144c655f372d18f0cd91a6b76e6fbedd1f71
--- /dev/null
+++ b/internal/specpin/v0.5.0.lock.json
@@ -0,0 +1,384 @@
+{
+  "format": "ax-normative-source-pin",
+  "format_version": 1,
+  "source": {
+    "repository": "relux-works/agent-session-manager-spec",
+    "release": "v0.5.0",
+    "tag": "v0.5.0",
+    "tag_object": "d3da6614a6c7bf119a88c9596a86c0853c22cfb9",
+    "commit": "28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c",
+    "document": {
+      "path": "SPEC.md",
+      "sha256": "562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a"
+    },
+    "normative_scope": [
+      "1",
+      "17",
+      "20",
+      "appendix-a",
+      "appendix-d"
+    ]
+  },
+  "contracts": [
+    {
