{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c725","stream":{"kind":"session","id":"01a07d5b-5606-7ab3-a2db-68c61f35ed4c"},"sequence":493,"recorded_at":1780531400000981,"record_type":"event","durability":"durable","causation_id":"ec382e4e-4787-41a3-93af-2c4ed3dbc570","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ec382e4e-4787-41a3-93af-2c4ed3dbc570","run_stream":{"kind":"run","id":"ec382e4e-4787-41a3-93af-2c4ed3dbc570"},"task_stream":{"kind":"task","id":"36187a0f-3721-4d99-ab5e-25d4bfe5bbc0"},"task_id":"36187a0f-3721-4d99-ab5e-25d4bfe5bbc0","event":{"kind":"output","task_id":"36187a0f-3721-4d99-ab5e-25d4bfe5bbc0","chunk":"{\n  \"chunk_id\": \"exec-27-1\",\n  \"command\": \"task-board worktree transaction --help 2>&1 | head -25\",\n  \"description\": \"Inspect transaction subcommand usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"The operator disposition surface for an integration transaction that reached a\\nterminal phase.\\n\\nIt is the ONLY exit from transition_refused and integration_abandoned, and it is\\nforward-only: no command here undoes a landed commit or rewrites trunk.\\n\\nTwo of the three outcomes cannot be obtained by assertion at all. 'resolve\\n--resolution repaired' re-runs the recovery classifier and decides on that, never\\non the operator's claim; 'discharge' recomputes the transaction's own\\npostcondition. Neither --refusal nor the absent-TASK_BOARD_RUN_ID check\\nauthorizes anything — both are caller-supplied guardrails, exactly like\\ncommit_ack and the transition-lease token.\\n\\nUsage:\\n  task-board worktree transaction [command]\\n\\nAvailable Commands:\\n  discharge   Retire an abandoned transaction whose board state has since reached trunk\\n  resolve     Leave transition_refused, by re-verified repair or by explicit abandonment\\n  show        Print an integration transaction, its refusal and the digest to dispose of it\\n\\nFlags:\\n  -h, --help   help for transaction\\n\\nGlobal Flags:\\n\",\n  \"original_output_bytes\": 1067,\n  \"original_output_tokens\": 267,\n  \"truncated\": false\n}"}}}
