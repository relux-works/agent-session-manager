_test.go\\nspawn.go\\nstatus_test.go\\nstatus.go\\nsurrogate_test.go\\nsurrogate.go\\n===\\n LOGBOOK.md                         |  8 +++++\\n README.md                          | 60 ++++++++++++++++++++++++++++++++++++++\\n internal/provhost/identity.go      |  7 +++--\\n internal/provhost/identity_test.go | 49 ++++++++++++++++++++++---------\\n 4 files changed, 108 insertions(+), 16 deletions(-)\\n\",\n  \"original_output_bytes\": 1368,\n  \"original_output_tokens\": 342,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
