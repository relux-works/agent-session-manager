ummaries = append(summaries, summary)\n+\t}\n+\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n+\treturn summaries, nil\n+}\n+\n+// Resolve implements' 1\n+  if run_pass 'TestListAndResolveRefuseMissingRoot'; then\n+    if run_gate_fail; then record A2 audit-only KILLED 'behavioral green; full run fails on alias audit'; else record A2 audit-only SURVIVED 'full run stayed green'; fi\n+  else\n+    record A2 audit-only SURVIVED 'behavioral test reddened (not audit-only)'\n+  fi\n+  restore\n+}\n+\n+controls() {\n+  echo \"== harness controls ==\"\n+  # X1 NOT_APPLIED: pattern is absent; the tree must be provably untouched.\n+  n=$(python3 - internal/sessrepo/chain.go '__absent_pattern_xyz__' <<'EOF'\n+import sys\n+src = open(sys.argv[1]).read()\n+print(src.count(sys.argv[2]))\n+EOF\n+)\n+  if [ \"$n\" = \"0\" ] && sha256sum -c \"$SNAP/pre.sha\" > /dev/null 2>&1; then\n+    record X1 NOT_APPLIED 'absent pattern applicator reports not-applied; checksums unchanged' > /dev/null\n+    PASS_COUNT=$((PASS_COUNT - 1))\n+    RESULTS=\"$RESULTS\"\n+    echo \"X1 [NOT_APPLIED] — absent pattern: not applied, tree checksums unchanged\"\n+  else\n+    echo \"X1 control broken\"\n+    FAIL_COUNT=$((FAIL_COUNT + 1))\n+  fi\n+  # X2 COMPILE_FAIL: broken tree fails distinctly from killed/survived.\n+  printf '\\n}\\n' >> internal/sessrepo/chain.go\n+  if go build \"$PKG\" > /dev/null 2>&1; then\n+    echo \"X2 [COMPILE_FAIL] UNEXPECTEDLY BUILT\"\n+    FAIL_COUNT=$((FAIL_COUNT + 1))\n+  else\n+    echo \"X2 [COMPILE_FAIL] — broken tree fails the build distinctly\"\n+  fi\n+  restore\n+}\n+\n+snapshot\n+baseline\n+\n+GROUP=\"${1:-all}\"\n+case \"$GROUP\" in\n+  narrowing-write) narrowing_write ;;\n+  narrowing-load) narrowing_load ;;\n+  deletion) deletion ;;\n+  gateonly) gateonly ;;\n+  controls) controls ;;\n+  all) narrowing_write; narrowing_load; deletion; gateonly; controls ;;\n+  *) echo \"unknown group $GROUP\" >&2; exit 2 ;