{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c7","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":318,"recorded_at":1780531400000631,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"task_stream":{"kind":"task","id":"354770e9-286c-4664-aa5e-4e93c8c6564a"},"task_id":"354770e9-286c-4664-aa5e-4e93c8c6564a","event":{"kind":"output","task_id":"354770e9-286c-4664-aa5e-4e93c8c6564a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/secconftest/crash.go`.\n1|package secconftest\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"sync\"\n12|)\n13|\n14|// Outcome is the Section 13.13 crash/restart vocabulary every crash\n15|// point classifies into. AC-CRASH-001 requires exactly one of these per\n16|// injection with the section's evidence record; no run may produce\n17|// duplicate live owners, treat an unfenced external continuation as\n18|// safe, or substitute a fresh identity for the persisted one.\n19|type Outcome string\n20|\n21|const (\n22|\t// OutcomeSafeRetry means the operation never mutated durable state\n23|\t// and the identical retry is safe.\n24|\tOutcomeSafeRetry Outcome = \"safe_retry\"\n25|\t// OutcomeExplicitRollback means durable state mutated and the caller\n26|\t// must roll back before any retry.\n27|\tOutcomeExplicitRollback Outcome = \"explicit_rollback\"\n28|\t// OutcomeRecoverableParked means the operation stopped in a named\n29|\t// parked state from which an operator or a later run recovers; it\n30|\t// must never silently resume as a fresh identity.\n31|\tOutcomeRecoverableParked Outcome = \"recoverable_parked_state\"\n32|)\n33|\n34|// Crash points name the phase boundaries the injector can fire on. The\n35|// families follow the AC-CRASH-001 class list (CR-LAUNCH-*, CR-SYNC-*,\n36|// CR-MAT-*, CR-GRACE-*, CR-FORCE-*, CR-FORK-*, CR-STOP-*, CR-RESUME-*,\n37|// CR-RESTORE-*, CR-CLONE-01..16); the suffix selects the boundary\n38|// inside the modeled operation.\n39|const (\n40|\tPointPrepareEnter  = \"CR-MAT-prepare-enter\"\n41|\tPointPrepareCommit = \"CR-MAT-prepare-commit\"\n42|\tPointCommitEnter   = \"CR-MAT-commit-enter\"\n43|\tPointCommitApply   = \"CR-MAT-commit-apply\"\n44|\tPointRollbackEnter = \"CR-MAT-rollback-enter\"\n45|)\n46|\n47|// ErrInjected reports a fired crash point. It carries the point and the\n48|// classified outcome so the caller cannot observe the fault without\n49|// observing what it requires.\n50|var ErrInjected = errors.New(\"secconftest injected crash\")\n51|\n52|// Fault is the fired crash-point evidence.\n53|type Fault struct {\n54|\tpoint   string\n55|\toutcome Outcome\n56|}\n57|\n58|func (fault *Fault) Error() string {\n59|\treturn fmt.Sprintf(\"%v: %s requires %s\", ErrInjected, fault.point, fault.outcome)\n60|}\n61|\n62|// Unwrap matches ErrInjected so callers match the fault kind without\n63|// parsing human text.\n64|func (fault *Fault) Unwrap() error {\n65|\treturn ErrInjected\n66|}\n67|\n68|// Point names the fired crash point.\n69|func (fault *Fault) Point() string { return fault.point }\n70|\n71|// Outcome classifies the fired crash point into the Section 13.13\n72|// vocabulary.\n73|func (fault *Fault) Outcome() Outcome { return fault.outcome }\n74|\n75|// Classify maps a crash point to its required outcome. Points before\n76|// any durable mutation are safe_retry; points after the journal takes\n77|// effect require explicit_rollback; points past the commit marker park\n78|// for recovery. Weakening any row to a different outcome must fail the\n79|// table test that drives it.\n80|func Classify(point string) (Outcome, error) {\n81|\tswitch point {\n82|\tcase PointPrepareEnter:\n83|\t\treturn OutcomeSafeRetry, nil\n84|\tcase PointPrepareCommit, PointCommitEnter, PointRollbackEnter:\n85|\t\treturn OutcomeExplicitRollback, nil\n86|\tcase PointCommitApply:\n87|\t\treturn OutcomeRecoverableParked, nil\n88|\tdefault:\n89|\t\treturn \"\", fmt.Errorf(\"secconftest: unknown crash point %q\", point)\n90|\t}\n91|}\n92|\n93|// Injector arms named crash points. The zero value is usable and fires\n94|// nothing. MaybeFail is the only firing entry: production-shaped code\n95|// under test calls it at each phase boundary.\n96|type Injector struct {\n97|\tmutex sync.Mutex\n98|\tarmed map[string]bool\n99|}\n100|\n101|// Arm fires point on its next MaybeFail call.\n102|func (injector *Injector) Arm(point string) {\n103|\tinjector.mutex.Lock()\n104|\tdefer injector.mutex.Unlock()\n105|\tif injector.armed == nil {\n106|\t\tinjector.armed = map[string]bool{}\n107|\t}\n108|\tinjector.armed[point] = true\n109|}\n110|\n111|// Disarm clears every armed point.\n112|func (injector *Injector) Disarm() {\n113|\tinjector.mutex.Lock()\n114|\tdefer injector.mutex.Unlock()\n115|\tinjector.armed = map[string]bool{}\n116|}\n117|\n118|// Armed reports whether point is currently armed.\n119|func (injector *Injector) Armed(point string) bool {\n120|\tinjector.mutex.Lock()\n121|\tdefer injector.mutex.Unlock()\n122|\treturn injector.armed[point]\n123|}\n124|\n125|// RemainingArmed lists the points still armed, sorted. A test that arms\n126|// a point and drives the operation must find this empty afterwards: an\n127|// armed point that never fires is otherwise noticed only incidentally,\n128|// and a new crash site added without an arm is outside this model (see\n129|// the package bounds). Weakening this to a constant empty slice must\n130|// fail the consumption test that drives it.\n131|func (injector *Injector) RemainingArmed() []string {\n132|\tinjector.mutex.Lock()\n133|\tdefer injector.mutex.Unlock()\n134|\tremaining := make([]string, 0, len(injector.armed))\n135|\tfor point := range injector.armed {\n136|\t\tremaining = append(remaining, point)\n137|\t}\n138|\tsort.Strings(remaining)\n139|\treturn remaining\n140|}\n141|\n142|// MaybeFail returns a *Fault when point is armed and consumes the arm,\n143|// so each armed point fires exactly once. It returns nil when\n144|// disarmed. An unknown point name is a caller error, never silent.\n145|func (injector *Injector) MaybeFail(point string) error {\n146|\toutcome, err := Classify(point)\n147|\tif err != nil {\n148|\t\treturn err\n149|\t}\n150|\tinjector.mutex.Lock()\n151|\tfire := injector.armed[point]\n152|\tif fire {\n153|\t\tdelete(injector.armed, point)\n154|\t}\n155|\tinjector.mutex.Unlock()\n156|\tif !fire {\n157|\t\treturn nil\n158|\t}\n159|\treturn &Fault{point: point, outcome: outcome}\n160|}\n161|\n162|// ErrIdempotencyMismatch reports a lost-response retry that changed the\n163|// operation body: AC-MAT-004 requires the byte-identical receipt for\n164|// the identical retry and a failure that creates no second root for a\n165|// changed one.\n166|var ErrIdempotencyMismatch = errors.New(\"secconftest idempotency_mismatch\")\n167|\n168|// Receipt is the durable proof of one transacted operation.\n169|type Receipt struct {\n170|\tOperationID string\n171|\tBodyDigest  string\n172|\tOutcome     Outcome\n173|\tBytes       []byte\n174|}\n175|\n176|// Transactor is a three-phase durable-commit model (prepare, commit,\n177|// rollback) over a directory, driven through MaybeFail boundaries. It\n178|// exists to prove the injector, the outcome vocabulary, and the\n179|// idempotency rule against real filesystem state; it is not a product\n180|// journal and no product path may import it for recovery.\n181|type Transactor struct {\n182|\tinjector *Injector\n183|\troot     string\n184|\tmutex    sync.Mutex\n185|\treceipts map[string]Receipt\n186|\t// finalized marks operations whose Commit finished the durable\n187|\t// write, cleanly or via a commit-apply fault. The operation is\n188|\t// then terminal and Rollback must refuse it (AC-CLONE-005:\n189|\t// rollback is forbidden after Provider commit).\n190|\tfinalized map[string]bool\n191|}\n192|\n193|// NewTransactor binds a Transactor to root, which must exist.\n194|func NewTransactor(injector *Injector, root string) *Transactor {\n195|\treturn &Transactor{injector: injector, root: root, receipts: map[string]Receipt{}, finalized: map[string]bool{}}\n196|}\n197|\n198|func digestBody(body []byte) string {\n199|\tsum := sha256.Sum256(body)\n200|\treturn hex.EncodeToString(sum[:])\n201|}\n202|\n203|// ErrPreparePastFinalize reports a Prepare refused after the operation\n204|// finalized (clean or crashed Commit): finalization is terminal and a\n205|// new prepare phase cannot resurrect it. The idempotent Prepare retry\n206|// rule (AC-MAT-004) covers retries before Commit only; after Commit the\n207|// operation already has a durable outcome, and returning the old\n208|// explicit_rollback receipt would misdescribe a finalized operation.\n209|var ErrPreparePastFinalize = errors.New(\"secconftest prepare forbidden after finalize\")\n210|\n211|// ErrCommitPastFinalize reports a Commit refused after the operation\n212|// already finalized: the second commit has no staged bytes to promote\n213|// and must name the terminal state, not inherit a filesystem ENOENT.\n214|var ErrCommitPastFinalize = errors.New(\"secconftest commit forbidden after finalize\")\n215|\n216|// Prepare stages body under operationID and fsyncs the journal entry.\n217|// A retry with the same operation ID and byte-identical body returns\n218|// the identical receipt without staging twice. A retry with the same\n219|// ID and a different body fails with ErrIdempotencyMismatch and\n220|// stages nothing new. Prepare after the operation finalized (clean or\n221|// crashed Commit) is refused with ErrPreparePastFinalize: terminal\n222|// means terminal.\n223|func (transactor *Transactor) Prepare(operationID string, body []byte) (Receipt, error) {\n224|\tif operationID == \"\" {\n225|\t\treturn Receipt{}, errors.New(\"secconftest: empty operation ID\")\n226|\t}\n227|\tif err := transactor.injector.MaybeFail(PointPrepareEnter); err != nil {\n228|\t\treturn Receipt{}, err\n229|\t}\n230|\tdigest := digestBody(body)\n231|\ttransactor.mutex.Lock()\n232|\tif transactor.finalized[operationID] {\n233|\t\ttransactor.mutex.Unlock()\n234|\t\treturn Receipt{}, fmt.Errorf(\"%w: operation %q\", ErrPreparePastFinalize, operationID)\n235|\t}\n236|\tif prior, ok := transactor.receipts[operationID]; ok {\n237|\t\ttransactor.mutex.Unlock()\n238|\t\tif prior.BodyDigest != digest {\n239|\t\t\treturn Receipt{}, fmt.Errorf(\"%w: operation %q body changed\", ErrIdempotencyMismatch, operationID)\n240|\t\t}\n241|\t\treturn prior, nil\n242|\t}\n243|\ttransactor.mutex.Unlock()\n244|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n245|\tif err := os.WriteFile(staged, body, 0o600); err != nil {\n246|\t\treturn Receipt{}, err\n247|\t}\n248|\tif err := transactor.injector.MaybeFail(PointPrepareCommit); err != nil {\n249|\t\t_ = os.Remove(staged)\n250|\t\treturn Receipt{}, err\n251|\t}\n252|\treceipt := Receipt{OperationID: operationID, BodyDigest: digest, Outcome: OutcomeSafeRetry, Bytes: append([]byte(nil), body...)}\n253|\ttransactor.mutex.Lock()\n254|\ttransactor.receipts[operationID] = receipt\n255|\ttransactor.mutex.Unlock()\n256|\treturn receipt, nil\n257|}\n258|\n259|// Commit promotes the staged body to committed bytes. It fails armed\n260|// crash points before (commit-enter: rollback required) and after\n261|// (commit-apply: parked) the durable rename.\n262|//\n263|// A commit-apply fault fires AFTER the durable write, so the operation\n264|// is already committed in every observable way: CommittedBytes returns\n265|// the body and the package's own parked-bytes assertion requires it to\n266|// survive. The fault path therefore finalizes the operation with a\n267|// recoverable_parked_state receipt and Rollback afterwards is\n268|// forbidden (AC-CLONE-005: rollback is forbidden after Provider\n269|// commit; all bundle evidence survives). The alternative — letting\n270|// Rollback delete the parked bytes — would walk through both halves\n271|// of that clause at once, which is the one unacceptable answer; the\n272|// leaf states this rule here, in doc.go, and in the README.\n273|//\n274|// Terminal neighbours name their state instead of inheriting ENOENT:\n275|// a second Commit is ErrCommitPastFinalize, and a Commit whose staged\n276|// bytes are gone without finalization names the missing staged bytes.\n277|func (transactor *Transactor) Commit(operationID string) (Receipt, error) {\n278|\tif err := transactor.injector.MaybeFail(PointCommitEnter); err != nil {\n279|\t\treturn Receipt{}, err\n280|\t}\n281|\ttransactor.mutex.Lock()\n282|\treceipt, ok := transactor.receipts[operationID]\n283|\tfinalized := transactor.finalized[operationID]\n284|\ttransactor.mutex.Unlock()\n285|\tif !ok {\n286|\t\treturn Receipt{}, fmt.Errorf(\"secconftest: commit without prepare for operation %q\", operationID)\n287|\t}\n288|\tif finalized {\n289|\t\treturn Receipt{}, fmt.Errorf(\"%w: operation %q\", ErrCommitPastFinalize, operationID)\n290|\t}\n291|\tstaged := filepath.Join(transactor.root, operationID+\".staged\")\n292|\tcommitted := filepath.Join(transactor.root, operationID+\".committed\")\n293|\tcontents, err := os.ReadFile(staged)\n294|\tif err != nil {\n295|\t\tif os.IsNotExist(err) {\n296|\t\t\treturn Receipt{}, fmt.Errorf(\"secconftest: commit without staged bytes for operation %q: %w\", operationID, err)\n297|\t\t}\n298|\t\treturn Receipt{}, err\n299|\t}\n300|\tif err := os.WriteFile(committed, contents, 0o600); err != nil {\n301|\t\treturn Receipt{}, err\n302|\t}\n303|\t_ = os.Remove(staged)\n304|\tif err := transactor.injector.MaybeFail(PointCommitApply); err != nil {\n305|\t\treceipt.Outcome = OutcomeRecoverableParked\n306|\t\ttransactor.mutex.Lock()\n307|\t\ttransactor.receipts[operationID] = receipt\n308|\t\ttransactor.finalized[operationID] = true\n309|\t\ttransactor.mutex.Unlock()\n310|\t\treturn Receipt{}, err\n311|\t}\n312|\treceipt.Outcome = OutcomeExplicitRollback\n313|\ttransactor.mutex.Lock()\n314|\ttransactor.receipts[operationID] = receipt\n315|\ttransactor.finalized[operationID] = true\n316|\ttransactor.mutex.Unlock()\n317|\treturn receipt, nil\n318|}\n319|\n320|// ErrRollbackPastFinalize reports a rollback refused after finalization\n321|// (clean or crashed Commit): the operation is terminal and rollback is\n322|// forbidden (AC-CLONE-005 shapes this rule; the model enforces it for\n323|// both Commit outcomes because the crashed Commit already performed\n324|// the durable write).\n325|var ErrRollbackPastFinalize = errors.New(\"secconftest rollback forbidden after commit\")\n326|\n327|// Rollback removes staged bytes for operationID before finalization\n328|// and forgets the operation, so a second Rollback names the missing\n329|// prepare instead of succeeding silently and a later Commit names it\n330|// too; a fresh Prepare for the same ID restages from scratch (the\n331|// recovery retry). It refuses to run past finalization: once Commit\n332|// returns cleanly — or faults at commit-apply after the durable\n333|// write — the operation is terminal, rollback is forbidden, and the\n334|// committed bytes must survive the refused call untouched. Deleting\n335|// the finalize gate must fail the tests that commit (clean or\n336|// crashed) and then roll back.\n337|func (transactor *Transactor) Rollback(operationID string) error {\n338|\tif err := transactor.injector.MaybeFail(PointRollbackEnter); err != nil {\n339|\t\treturn err\n340|\t}\n341|\ttransactor.mutex.Lock()\n342|\t_, ok := transactor.receipts[operationID]\n343|\tfinalized := transactor.finalized[operationID]\n344|\ttransactor.mutex.Unlock()\n345|\tif !ok {\n346|\t\treturn fmt.Errorf(\"secconftest: rollback without prepare for operation %q\", operationID)\n347|\t}\n348|\tif finalized {\n349|\t\treturn fmt.Errorf(\"%w: operation %q\", ErrRollbackPastFinalize, operationID)\n350|\t}\n351|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".staged\"))\n352|\t_ = os.Remove(filepath.Join(transactor.root, operationID+\".committed\"))\n353|\ttransactor.mutex.Lock()\n354|\tdelete(transactor.receipts, operationID)\n355|\ttransactor.mutex.Unlock()\n356|\treturn nil\n357|}\n358|\n359|// CommittedBytes reads back the committed bytes for operationID.\n360|func (transactor *Transactor) CommittedBytes(operationID string) ([]byte, error) {\n361|\treturn os.ReadFile(filepath.Join(transactor.root, operationID+\".committed\"))\n362|}"}}}
