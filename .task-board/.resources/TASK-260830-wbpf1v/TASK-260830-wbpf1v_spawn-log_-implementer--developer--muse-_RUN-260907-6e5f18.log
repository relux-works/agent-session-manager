e\n79|// owning directory, requires it to stay non-empty so a stale exception\n80|// fails instead of lingering, and still reddens for any other tree. The\n81|// scan is AST-based (comments and test files never count) and fails\n82|// closed when it sees nothing.\n83|// Stated bound on this test: only *ast.CallExpr nodes are inspected, so a\n84|// `f := pkg.VerifyObjectIdentity; f(x)` binding would not be seen; no such\n85|// shape exists today.\n86|func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\n87|\t_, self, _, ok := runtime.Caller(0)\n88|\tif !ok {\n89|\t\tt.Fatal(\"runtime.Caller cannot locate the test file\")\n90|\t}\n91|\troot := filepath.Dir(self)\n92|\tfor {\n93|\t\tif _, err := os.Stat(filepath.Join(root, \"go.mod\")); err == nil {\n94|\t\t\tbreak\n95|\t\t}\n96|\t\tparent := filepath.Dir(root)\n97|\t\tif parent == root {\n98|\t\t\tt.Fatal(\"no module root above the test file; the scan is blind\")\n99|\t\t}\n100|\t\troot = parent\n101|\t}\n102|\tvar scanned, parsed int\n103|\tvar callers, allowed []string\n104|\t// sessrepoLeaf is the one directory whose production VerifyObjectIdentity\n105|\t// calls the rewritten bound admits: session-record and session-event\n106|\t// attestation owned by TASK-260830-wbpf1v. It is matched by path\n107|\t// separator-delimited segment, never by substring.\n108|\tsessrepoLeaf := string(filepath.Separator) + \"sessrepo\" + string(filepath.Separator)\n109|\tfor _, tree := range []string{\"internal\", \"cmd\"} {\n110|\t\tbase := filepath.Join(root, tree)\n111|\t\tif _, err := os.Stat(base); err != nil {\n112|\t\t\tcontinue\n113|\t\t}\n114|\t\t// Recursion stays local: the core selects single-package\n115|\t\t// production files, while this attestation spans trees.\n116|\t\t// Fail-closed parsing is the core's.\n117|\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\n118|\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n119|\t\t\t\treturn err\n120|\t\t\t}\n121|\t\t\tscanned++\n122|\t\t\tsource, err := os.ReadFile(path)\n123|\t\t\tif err != nil {\n124|\t\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n125|\t\t\t}\n126|\t\t\tif !strings.Contains(string(source), \"VerifyObjectIdentity\") {\n127|\t\t\t\treturn nil\n128|\t\t\t}\n129|\t\t\tparsed++\n130|\t\t\tsyntax, fileSet, failure := invcore.ParseBytes(path, source, 0)\n131|\t\t\tif failure != \"\" {\n132|\t\t\t\tt.Fatalf(\"parse %s: %s\", path, failure)\n133|\t\t\t}\n134|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n135|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n136|\t\t\t\tif !ok {\n137|\t\t\t\t\treturn true\n138|\t\t\t\t}\n139|\t\t\t\trecord := func(position token.Position) {\n140|\t\t\t\t\tentry := fmt.Sprintf(\"%s:%d\", position.Filename, position.Line)\n141|\t\t\t\t\tif strings.Contains(position.Filename, sessrepoLeaf) {\n142|\t\t\t\t\t\tallowed = append(allowed, entry)\n143|\t\t\t\t\t\treturn\n144|\t\t\t\t\t}\n145|\t\t\t\t\tcallers = append(callers, entry)\n146|\t\t\t\t}\n147|\t\t\t\tswitch fun := call.Fun.(type) {\n148|\t\t\t\tcase *ast.SelectorExpr:\n149|\t\t\t\t\tif fun.Sel.Name == \"VerifyObjectIdentity\" {\n150|\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\n151|\t\t\t\t\t}\n152|\t\t\t\tcase *ast.Ident:\n153|\t\t\t\t\tif fun.Name == \"VerifyObjectIdentity\" {\n154|\t\t\t\t\t\t// The canonicaljson definition itself is a\n155|\t\t\t\t\t\t// FuncDecl, never a call; a bare-identifier call\n156|\t\t\t\t\t\t// anywhere is a production call site.\n157|\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\n158|\t\t\t\t\t}\n159|\t\t\t\t}\n160|\t\t\t\treturn true\n161|\t\t\t})\n162|\t\t\treturn nil\n163|\t\t}); err != nil {\n164|\t\t\tt.Fatalf(\"walk %s: %v\", base, err)\n165|\t\t}\n166|\t}\n167|\tif scanned == 0 {\n168|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n169|\t}\n170|\tif len(allowed) == 0 {\n171|\t\tt.Fatal(\"sessrepo attestation exception is stale: no allowlisted call site remains, remove the exception\")\n172|\t}\n173|\tif len(callers) != 0 {\n174|\t\tt.Fatalf(\"production call sites outside the session leaf attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\n175|\t}\n176|\tt.Logf(\"attestation scan: %d production files, %d parsed, %d session-leaf call sites, 0 elsewhere\", scanned, parsed, len(allowed))\n177|}\n178|\n179|// identityVariant rewrites one unique substring of the example.\n(more lines below)"}}}
