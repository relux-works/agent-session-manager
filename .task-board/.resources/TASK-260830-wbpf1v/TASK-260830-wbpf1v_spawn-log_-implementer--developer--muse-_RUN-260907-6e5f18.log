{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56b","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":272,"recorded_at":1780531400000539,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"task_stream":{"kind":"task","id":"e26f1a8a-1aac-4bca-98e0-3ed2c7907f48"},"task_id":"e26f1a8a-1aac-4bca-98e0-3ed2c7907f48","event":{"kind":"output","task_id":"e26f1a8a-1aac-4bca-98e0-3ed2c7907f48","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|)\n10|\n11|// This file validates the Provider Identity Record (Section 5.5,\n12|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n13|// identify-session results and carries in launch, resume, quiesce,\n14|// and fork bodies, plus the identify-session success wrapper. The\n15|// record_id is required to be a digest but is not recomputed here:\n16|// content addressing belongs to the object-identity story, and this\n17|// package holds no canonical encoder. The opaque_identity absolute\n18|// prefix rule mirrors the decidable half of the Section 5.5\n19|// sentence: a value beginning with an absolute path is refused, and\n20|// an embedded path the prefix cannot see is a stated bound.\n21|//\n22|// CheckIdentity validates the record shape in this package's provider-stdio\n23|// dialect (provider_protocol_error with member attribution, which the\n24|// shared package cannot mint) and conjoins the verdict with the owner's\n25|// production identity entry canonicaljson.CalculateObjectIdentity: the two\n26|// validators must agree on the Section 5.5 shape rule for rule, and a\n27|// document the dialect admits but the owner refuses is refused at the\n28|// owner gate below. The decoder half of that agreement is pinned by the\n29|// derived TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON sweep,\n30|// which judges escape and raw-UTF-8 vectors through the shared\n31|// decodeStrictObject every entry here reads through, and any shape-rule\n32|// change must land in both validators in the same change.\n33|//\n34|// Binding verification split, stated plainly: the three terminal\n35|// schemas verify their identity binding — terminalbackend's Parse\n36|// entries recompute the omit-self digest and refuse a mismatched claim\n37|// — while provider-identity records admitted here do not. CheckIdentity\n38|// requires record_id to be a well-formed digest but never recomputes\n39|// it, and the conjoined CalculateObjectIdentity entry validates shape\n40|// only (its digest return is discarded below); the entry that would\n41|// attest the binding, canonicaljson.VerifyObjectIdentity, has no\n42|// production call site attesting provider-identity records. The only\n43|// production call sites (internal/sessrepo, TASK-260830-wbpf1v) attest\n44|// session-record and session-event bindings after a schema gate that\n45|// refuses any other schema first, so no transport gate and no\n46|// persistence path recomputes a provider-identity digest today.\n47|//\n48|// This is deferred, not decided. Conjoining Verify here would refuse\n49|// records this gate documents as admitted: every boundary admission in\n50|// identity_test.go mutates content while keeping the example record_id,\n51|// so its claim no longer matches recomputation. Changing that admission\n52|// contract needs the identity owner's ruling on what a mismatched live\n53|// binding must do (refuse? re-resolve? at which layer?), which this leaf\n54|// cannot give for another owner's entry point. Until that ruling lands\n55|// — wired as a board element after this story's final leaf closes —\n56|// this gate admits any well-formed digest, and says so.\n57|//\n58|// The earlier justification for the deferral is withdrawn as false: it\n59|// claimed the gate must admit the pinned Section 5.5 example whose\n60|// record_id is merely illustrative. Measured in\n61|// TestSpecIdentityExampleVerifiesAgainstItsClaimedDigest, Verify returns\n62|// the example's own record_id with nil error, so the example IS the true\n63|// omit-self digest and cannot justify skipping attestation.\n64|\n65|// identitySchema is the exact schema identifier the record carries.\n66|const identitySchema = \"urn:ax:schema:provider-identity\"\n67|\n68|// identitySchemaVersion is the only identity version accepted.\n69|const identitySchemaVersion = \"1.0.0\"\n70|\n71|// identityKinds is the closed identity-kind enum in section order.\n72|var identityKinds = []string{\n73|\t\"session_uuid\",\n74|\t\"session_path_or_id\",\n75|\t\"backend_conversation_uuid\",\n76|\t\"task_board_managed\",\n77|\t\"provider_defined\",\n78|}\n79|\n80|// identityMembers is the exact required member set of a Provider\n81|// Identity Record.\n82|var identityMembers = map[string]bool{\n83|\t\"schema\":                    true,\n84|\t\"schema_version\":            true,\n85|\t\"record_id\":                 true,\n86|\t\"subject_id\":                true,\n87|\t\"session_id\":                true,\n88|\t\"provider_id\":               true,\n89|\t\"provider_version\":          true,\n90|\t\"provider_version_range\":    true,\n91|\t\"native_session_id\":         true,\n92|\t\"identity_kind\":             true,\n93|\t\"logical_workspace_id\":      true,\n94|\t\"backend_realm_fingerprint\": true,\n95|\t\"opaque_identity\":           true,\n96|\t\"created_by_host_id\":        true,\n97|\t\"created_at\":                true,\n98|\t\"extensions\":                true,\n99|}\n100|\n101|// identityRequired lists identityMembers in a fixed order so a record\n102|// missing several members always names the same one.\n103|var identityRequired = []string{\n104|\t\"schema\",\n105|\t\"schema_version\",\n106|\t\"record_id\",\n107|\t\"subject_id\",\n108|\t\"session_id\",\n109|\t\"provider_id\",\n110|\t\"provider_version\",\n111|\t\"provider_version_range\",\n112|\t\"native_session_id\",\n113|\t\"identity_kind\",\n114|\t\"logical_workspace_id\",\n115|\t\"backend_realm_fingerprint\",\n116|\t\"opaque_identity\",\n117|\t\"created_by_host_id\",\n118|\t\"created_at\",\n119|\t\"extensions\",\n120|}\n121|\n122|// identityKeyPattern is the provider-identity key grammar Section 5.5\n123|// states: [a-z][a-z0-9_.-]{0,63}.\n124|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n125|\n126|// windowsDrivePattern matches a Windows drive-qualified absolute\n127|// prefix: a letter, a colon, and a separator.\n128|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n129|\n130|// CheckIdentity validates one Provider Identity Record naming the\n131|// expected provider. Shape violations are provider_protocol_errors;\n132|// a well-formed record for another provider is an invalid_config\n133|// caller error: the caller correlated the wrong identity to this\n134|// session.\n135|func CheckIdentity(body []byte, wantProviderID string) error {\n136|\tmembers, fault := decodeStrictObject(body)\n137|\tif fault != nil {\n138|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n139|\t\tif err != nil {\n140|\t\t\treturn err\n141|\t\t}\n142|\t\treturn failure\n143|\t}\n144|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n145|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n146|\t\tif err != nil {\n147|\t\t\treturn err\n148|\t\t}\n149|\t\treturn failure\n150|\t}\n151|\tif name, missing := missingMember(members, identityRequired); missing {\n152|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n153|\t\tif err != nil {\n154|\t\t\treturn err\n155|\t\t}\n156|\t\treturn failure\n157|\t}\n158|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n159|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\treturn failure\n164|\t}\n165|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n166|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n167|\t\tif err != nil {\n168|\t\t\treturn err\n169|\t\t}\n170|\t\treturn failure\n171|\t}\n172|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n173|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n174|\t\tif err != nil {\n175|\t\t\treturn err\n176|\t\t}\n177|\t\treturn failure\n178|\t}\n179|\tsubject, ok := rawString(members[\"subject_id\"])\n180|\tif !ok || !isUUIDv7(subject) {\n181|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n182|\t\tif err != nil {\n183|\t\t\treturn err\n184|\t\t}\n185|\t\treturn failure\n186|\t}\n187|\tsession, ok := rawString(members[\"session_id\"])\n188|\tif !ok || !isUUIDv7(session) {\n189|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n190|\t\tif err != nil {\n191|\t\t\treturn err\n192|\t\t}\n193|\t\treturn failure\n194|\t}\n195|\tif subject != session {\n196|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n197|\t\tif err != nil {\n198|\t\t\treturn err\n199|\t\t}\n200|\t\treturn failure\n201|\t}\n202|\tprovider, ok := rawString(members[\"provider_id\"])\n203|\tif !ok || !validProviderID(provider) {\n204|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n205|\t\tif err != nil {\n206|\t\t\treturn err\n207|\t\t}\n208|\t\treturn failure\n209|\t}\n210|\tif provider != wantProviderID {\n211|\t\tfailure, err := failInvalid(\"identity names another provider\")\n212|\t\tif err != nil {\n213|\t\t\treturn err\n214|\t\t}\n215|\t\treturn failure\n216|\t}\n217|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n218|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n219|\t\tif err != nil {\n220|\t\t\treturn err\n221|\t\t}\n222|\t\treturn failure\n223|\t}\n224|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n225|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n226|\t\tif err != nil {\n227|\t\t\treturn err\n228|\t\t}\n229|\t\treturn failure\n230|\t}\n231|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n232|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n233|\t\tif err != nil {\n234|\t\t\treturn err\n235|\t\t}\n236|\t\treturn failure\n237|\t}\n238|\tkind, ok := rawString(members[\"identity_kind\"])\n239|\tif !ok || !isIdentityKind(kind) {\n240|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n241|\t\tif err != nil {\n242|\t\t\treturn err\n243|\t\t}\n244|\t\treturn failure\n245|\t}\n246|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n247|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n248|\t\tif err != nil {\n249|\t\t\treturn err\n250|\t\t}\n251|\t\treturn failure\n252|\t}\n253|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n254|\t\treturn err\n255|\t}\n256|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n257|\t\treturn err\n258|\t}\n259|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n260|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n261|\t\tif err != nil {\n262|\t\t\treturn err\n263|\t\t}\n264|\t\treturn failure\n265|\t}\n266|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n267|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n268|\t\tif err != nil {\n269|\t\t\treturn err\n270|\t\t}\n271|\t\treturn failure\n272|\t}\n273|\tif !isJSONObject(members[\"extensions\"]) {\n274|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n275|\t\tif err != nil {\n276|\t\t\treturn err\n277|\t\t}\n278|\t\treturn failure\n279|\t}\n280|\t// The member arms above are this package's provider-stdio dialect of\n281|\t// the Section 5.5 rule; the owner of that rule is canonicaljson\n282|\t// (validateProviderIdentityRecord, registered for section:5.5 in the\n283|\t// traceability registry), and the dialect keeps its member attribution\n284|\t// deliberately. The verdict is therefore conjoined with the owner's\n285|\t// production identity entry: a document this dialect admits but the\n286|\t// owner refuses — open extensions content, a number the dialect never\n287|\t// reads, nesting beyond the dialect's view — is refused here rather\n288|\t// than admitted through a drifted copy. The provider-equality\n289|\t// correlation above stays host-side: it is a caller rule, not a\n290|\t// content rule, and the owner never sees it.\n291|\tif _, _, err := canonicaljson.CalculateObjectIdentity(body); err != nil {\n292|\t\tfailure, ferr := failProtocol(\"identity is not a valid provider identity\", \"\")\n293|\t\tif ferr != nil {\n294|\t\t\treturn ferr\n295|\t\t}\n296|\t\treturn failure\n297|\t}\n298|\treturn nil\n299|}\n300|\n301|// checkIdentityRealm enforces the digest-or-null shape and the one\n302|// conditional rule Section 5.5 states: an Antigravity\n303|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n304|// because the backend realm is a resume precondition there.\n305|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n306|\trealm, isNull, ok := rawNullableString(raw)\n307|\tif !ok || (!isNull && !isDigest(realm)) {\n308|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n309|\t\tif err != nil {\n310|\t\t\treturn err\n311|\t\t}\n312|\t\treturn failure\n313|\t}\n314|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n315|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n316|\t\tif err != nil {\n317|\t\t\treturn err\n318|\t\t}\n319|\t\treturn failure\n320|\t}\n321|\treturn nil\n322|}\n323|\n324|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n325|// object of at most 32 entries, keyed by the provider-identity key\n326|// grammar, with non-secret string values of 1..1,024 characters that\n327|// MUST NOT begin with an absolute path.\n328|func checkIdentityOpaque(raw json.RawMessage) error {\n329|\topaque, fault := decodeStrictObject(raw)\n330|\tif fault != nil {\n331|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n332|\t\tif err != nil {\n333|\t\t\treturn err\n334|\t\t}\n335|\t\treturn failure\n336|\t}\n337|\tif len(opaque) > 32 {\n338|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n339|\t\tif err != nil {\n340|\t\t\treturn err\n341|\t\t}\n342|\t\treturn failure\n343|\t}\n344|\tkeys := make([]string, 0, len(opaque))\n345|\tfor key := range opaque {\n346|\t\tkeys = append(keys, key)\n347|\t}\n348|\tfor _, key := range keys {\n349|\t\tif !identityKeyPattern.MatchString(key) {\n350|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n351|\t\t\tif err != nil {\n352|\t\t\t\treturn err\n353|\t\t\t}\n354|\t\t\treturn failure\n355|\t\t}\n356|\t\tvalue, ok := rawString(opaque[key])\n357|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n358|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n359|\t\t\tif err != nil {\n360|\t\t\t\treturn err\n361|\t\t\t}\n362|\t\t\treturn failure\n363|\t\t}\n364|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n365|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n366|\t\t\tif err != nil {\n367|\t\t\t\treturn err\n368|\t\t\t}\n369|\t\t\treturn failure\n370|\t\t}\n371|\t}\n372|\treturn nil\n373|}\n374|\n375|func isIdentityKind(value string) bool {\n376|\tfor _, kind := range identityKinds {\n377|\t\tif value == kind {\n378|\t\t\treturn true\n379|\t\t}\n380|\t}\n381|\treturn false\n382|}\n383|\n384|// identifyMembers is the exact required member set of an\n385|// identify-session success body.\n386|var identifyMembers = map[string]bool{\n387|\t\"identity\":         true,\n388|\t\"confidence\":       true,\n389|\t\"matched_evidence\": true,\n390|}\n391|\n392|// identifyRequired lists identifyMembers in a fixed order.\n393|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n394|\n395|// identifyConfidences is the closed confidence vocabulary.\n396|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n397|\n398|// identifyEvidence is the closed matched-evidence vocabulary.\n399|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n400|\n401|// DecodeIdentifyResult validates one identify-session success body:\n402|// the Provider Identity Record for the expected provider, a closed\n403|// confidence, and 1..4 sorted unique matched-evidence members.\n404|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n405|\tmembers, fault := decodeStrictObject(body)\n406|\tif fault != nil {\n407|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n408|\t\tif err != nil {\n409|\t\t\treturn err\n410|\t\t}\n411|\t\treturn failure\n412|\t}\n413|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n414|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n415|\t\tif err != nil {\n416|\t\t\treturn err\n417|\t\t}\n418|\t\treturn failure\n419|\t}\n420|\tif name, missing := missingMember(members, identifyRequired); missing {\n421|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n422|\t\tif err != nil {\n423|\t\t\treturn err\n424|\t\t}\n425|\t\treturn failure\n426|\t}\n427|\tconfidence, ok := rawString(members[\"confidence\"])\n428|\tif !ok || !isIdentifyConfidence(confidence) {\n429|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n430|\t\tif err != nil {\n431|\t\t\treturn err\n432|\t\t}\n433|\t\treturn failure\n434|\t}\n435|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n436|\t\treturn err\n437|\t}\n438|\tif !isJSONObject(members[\"identity\"]) {\n439|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n440|\t\tif err != nil {\n441|\t\t\treturn err\n442|\t\t}\n443|\t\treturn failure\n444|\t}\n445|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n446|\t\treturn err\n447|\t}\n448|\treturn nil\n449|}\n450|\n451|func isIdentifyConfidence(value string) bool {\n452|\tfor _, confidence := range identifyConfidences {\n453|\t\tif value == confidence {\n454|\t\t\treturn true\n455|\t\t}\n456|\t}\n457|\treturn false\n458|}\n459|\n460|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n461|// evidence members: the observation must cite what matched, exactly\n462|// once each.\n463|func checkIdentifyEvidence(raw json.RawMessage) error {\n464|\tevidence, ok := rawStringArray(raw)\n465|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n466|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n467|\t\tif err != nil {\n468|\t\t\treturn err\n469|\t\t}\n470|\t\treturn failure\n471|\t}\n472|\tallowed := map[string]bool{}\n473|\tfor _, member := range identifyEvidence {\n474|\t\tallowed[member] = true\n475|\t}\n476|\tfor _, member := range evidence {\n477|\t\tif !allowed[member] {\n478|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n479|\t\t\tif err != nil {\n480|\t\t\t\treturn err\n481|\t\t\t}\n482|\t\t\treturn failure\n483|\t\t}\n484|\t}\n485|\tif !sortedUniqueStrings(evidence) {\n486|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n487|\t\tif err != nil {\n488|\t\t\treturn err\n489|\t\t}\n490|\t\treturn failure\n491|\t}\n492|\treturn nil\n493|}"}}}
