ew(\"name_ambiguous\")\n34|\tErrNameNotFound    = errors.New(\"session name not found\")\n35|\tErrRepositoryPath  = errors.New(\"invalid session repository path\")\n36|)\n37|\n38|// refuse is the single refusal funnel every sessrepo rejection flows\n39|// through. It is a var so the census TestMain can wrap it and record the\n40|// production file:line behind each exercised refusal. No production path\n41|// wraps a sentinel with fmt.Errorf directly.\n42|var refuse = func(sentinel error, format string, arguments ...any) error {\n43|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n44|}\n45|\n46|// SessionRef names one persisted session: its Session Record digest and ID.\n47|type SessionRef struct {\n48|\tSessionID string\n49|\tRecordID  string\n50|}\n51|\n52|// EventRef names one chained event: its digest, lease sequence, and position.\n53|type EventRef struct {\n54|\tSessionID     string\n55|\tEventID       string\n56|\tLeaseSequence uint64\n57|\tPosition      int\n58|}\n59|\n60|// EventSummary is the chain-index entry for one event, derived from the\n61|// validated event bytes at append time and re-verified against them on load.\n62|type EventSummary struct {\n63|\tEventID       string   `json:\"event_id\"`\n64|\tEventType     string   `json:\"event_type\"`\n65|\tLeaseEpoch    uint64   `json:\"lease_epoch\"`\n66|\tLeaseID       string   `json:\"lease_id\"`\n67|\tLeaseSequence uint64   `json:\"lease_sequence\"`\n68|\tPredecessors  []string `json:\"predecessors\"`\n69|}\n70|\n71|// SessionSummary is the Section 14.4 list projection this leaf owns: stored\n72|// identity plus chain-head facts. Owner host, checkpoint age, capability\n73|// status, and warnings are derived downstream, never here.\n74|type SessionSummary struct {\n75|\tSessionID  string\n76|\tRecordID   string\n77|\tName       string\n78|\tKind       string\n79|\tProviderID string\n80|\tEventCount int\n81|\tTailEvent  string\n82|}\n83|\n84|// Repository persists Session Records and per-session event chains under\n85|// one data root. All mutating entries serialize on one mutex; files are\n86|// content-addressed and installed no-replace, so the chain is append-only\n87|// by construction and there is no update or delete entry to test.\n88|//\n89|// BeforeWrite fires after validation and before the first durable byte;\n90|// AfterCommit fires after the chain index is durable. Both are nil in\n91|// normal operation. Tests connect them to a secconftest Injector firing\n92|// the owner's own points, so a fault before the write carries safe_retry\n93|// and a fault after it carries recoverable_parked_state.\n94|type Repository struct {\n95|\troot        string\n96|\tmutex       sync.Mutex\n97|\tBeforeWrite func() error\n98|\tAfterCommit func() error\n99|}\n100|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c409","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":95,"recorded_at":1780531400000185,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"call_id":"call_01a07bd82cc17193b5dfd1e17648beb8","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessrepo/chain.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"io\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// sessionRecord is the validated identity of one Session Record: the exact\n18|// bytes plus the members the repository must bind (SPEC.md Section 5.1).\n19|type sessionRecord struct {\n20|\traw       []byte\n21|\trecordID  string\n22|\tsessionID string\n23|\tname      string\n24|\tkind      string\n25|\tprovider  string\n26|}\n27|\n28|// eventView is the validated routing surface of one Session Event: the\n29|// exact bytes plus the members the chain rules must read (SPEC.md 5.2).\n30|type eventView struct {\n31|\traw          []byte\n32|\teventID      string\n33|\teventType    string\n34|\tsessionID    string\n35|\tleaseEpoch   uint64\n36|\tleaseID      string\n37|\tleaseSeq     uint64\n38|\tpredecessors []string\n39|}\n40|\n41|// storedChain is the chain index: the record digest plus one entry per\n42|// chained event in authoritative order. The blobs are truth; the index is\n43|// a verified cache rebound to them on every load.\n44|type storedChain struct {\n45|\tRecordID string\n46|\tEvents   []EventSummary\n47|}\n48|\n49|// sessionView is one loaded session: record, index, directory, and name facts.\n50|type sessionView struct {\n51|\tdirectory string\n52|\trecord    sessionRecord\n53|\tchain     storedChain\n54|}\n55|\n56|// decodeSessionRecord runs the three validation layers in order: strict\n57|// frame (environ owner), member shape, then canonical identity and closed\n58|// shape (canonicaljson owner). Each layer refuses before the next runs,\n59|// so every site below is reachable with a vector that clears the earlier\n60|// layers and fails exactly this one.\n61|func decodeSessionRecord(raw []byte) (sessionRecord, error) {\n62|\tmembers, fault := environ.DecodeStrictObject(raw)\n63|\tif fault != nil {\n64|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n65|\t}\n66|\tif schema, err := stringMember(members, \"schema\"); err != nil || schema != sessionRecordSchema {\n67|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n68|\t}\n69|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n70|\tif !ok {\n71|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n72|\t}\n73|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n74|\tif err != nil {\n75|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"verify session record identity: %v\", err)\n76|\t}\n77|\tif field != canonicaljson.SelfRecordID {\n78|\t\treturn sessionRecord{}, fmt.Errorf(\"session record identity field %q, want record_id\", string(field))\n79|\t}\n80|\tname, _ := stringMember(members, \"name\")\n81|\tkind, _ := stringMember(members, \"kind\")\n82|\tprovider, _ := stringMember(members, \"provider_id\")\n83|\treturn sessionRecord{raw: raw, recordID: digest.String(), sessionID: sessionID.String(), name: name, kind: kind, provider: provider}, nil\n84|}\n85|\n86|// decodeSessionEvent runs the same three layers for Session Events: strict\n87|// frame, member shape, then canonical identity and closed payload shape.\n88|func decodeSessionEvent(raw []byte) (eventView, error) {\n89|\tmembers, fault := environ.DecodeStrictObject(raw)\n90|\tif fault != nil {\n91|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"decode session event frame: %v\", fault)\n92|\t}\n93|\tif schema, err := stringMember(members, \"schema\"); err != nil || schema != sessionEventSchema {\n94|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"session event schema %q, want %q\", schema, sessionEventSchema)\n95|\t}\n96|\tevent, err := extractEventMembers(members)\n97|\tif err != nil {\n98|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"session event member: %v\", err)\n99|\t}\n100|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40b","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":96,"recorded_at":1780531400000187,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"call_id":"call_01a07bd82df47c50b2b55207ddc277ca","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessrepo/doc.go`.\n1|// Package sessrepo persists and validates AX Session Records and the\n2|// append-only per-session event chain with source sequence continuity.\n3|//\n4|// Normative scope: AX v0.5.0 sections 2.3 (session name resolution), 5.1\n5|// (Session Record), 5.2 (Session Event), 5.7 (derived session states), and\n6|// 14.4 (list and status fields). This package owns durable session state:\n7|// the immutable record, the ordered event chain beneath it, and the stored\n8|// identity fields that later leaves project into lifecycle state, resolved\n9|// names, and list/status rows.\n10|//\n11|// Division of authority inside this story:\n12|//\n13|//   - Validation of record and event closed shapes and of every self-identity\n14|//     digest is owned by internal/canonicaljson and reached only through its\n15|//     production VerifyObjectIdentity entry. This package never re-decodes a\n16|//     frame, never recomputes a bound, and never selects a self field.\n17|//   - Strict frame decoding and scalar bound checks on the members this\n18|//     package must read (session and lease identifiers, lease_sequence,\n19|//     predecessor digests, names) are owned by internal/environ and\n20|//     internal/scalar and reached only through their production checks.\n21|//   - Crash-point vocabulary and outcomes are owned by\n22|//     internal/secconftest. The repository fires the owner's own points\n23|//     through the owner's Injector: a fault before the durable write carries\n24|//     safe_retry, a fault after it carries recoverable_parked_state, and a\n25|//     crashed commit counts as committed.\n26|//   - The refusal census denominator is derived from production through\n27|//     internal/invcore; see census_test.go.\n28|//\n29|// Stated bounds (not silent gaps):\n30|//\n31|//   - Single authoritative branch. The repository tracks one ordered chain\n32|//     per session in arrival order. A same-epoch event under a different\n33|//     lease is preserved as an immutable blob but refused from the chain\n34|//     with ErrDivergentBranch; lease arbitration across partitions belongs\n35|//     to the ownership-leases story, not to this leaf.\n36|//   - No lifecycle derivation. Section 5.7 SessionState reduction and the\n37|//     full Section 2.3 four-step resolution order (peer-learned names,\n38|//     interactive choice) belong to the sibling reducer and name-resolution\n39|//     leaves. This package exposes the stored facts they project: exact\n40|//     local names with ASCII case-fold ambiguity detection, UUID routing,\n41|//     and per-session chain heads.\n42|//   - No Section 14.4 rendering. ListSessions exposes stored identity plus\n43|//     chain-head facts; human or JSON rendering of owner host, checkpoint\n44|//     age, capability status, and warnings belongs to the CLI surface leaf.\n45|//\n46|// The package adds no ax command, no doctor result, and no runtime\n47|// capability claim.\n48|package sessrepo","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
