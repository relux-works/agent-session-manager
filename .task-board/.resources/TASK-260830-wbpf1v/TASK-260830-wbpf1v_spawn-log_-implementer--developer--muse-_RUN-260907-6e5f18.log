 scan is AST-based (comments and test files never count) and fails\n82|// closed when it sees nothing.\n83|// Stated bound on this test: only *ast.CallExpr nodes are inspected, so a\n84|// `f := pkg.VerifyObjectIdentity; f(x)` binding would not be seen; no such\n85|// shape exists today.\n86|func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\n87|\t_, self, _, ok := runtime.Caller(0)\n88|\tif !ok {\n89|\t\tt.Fatal(\"runtime.Caller cannot locate the test file\")\n90|\t}\n91|\troot := filepath.Dir(self)\n92|\tfor {\n93|\t\tif _, err := os.Stat(filepath.Join(root, \"go.mod\")); err == nil {\n94|\t\t\tbreak\n95|\t\t}\n96|\t\tparent := filepath.Dir(root)\n97|\t\tif parent == root {\n98|\t\t\tt.Fatal(\"no module root above the test file; the scan is blind\")\n99|\t\t}\n100|\t\troot = parent\n101|\t}\n102|\tvar scanned, parsed int\n103|\tvar callers, allowed []string\n104|\t// sessrepoLeaf is the one directory whose production VerifyObjectIdentity\n105|\t// calls the rewritten bound admits: session-record and session-event\n106|\t// attestation owned by TASK-260830-wbpf1v. It is matched by path\n107|\t// separator-delimited segment, never by substring.\n108|\tsessrepoLeaf := string(filepath.Separator) + \"sessrepo\" + string(filepath.Separator)\n109|\tfor _, tree := range []string{\"internal\", \"cmd\"} {\n110|\t\tbase := filepath.Join(root, tree)\n111|\t\tif _, err := os.Stat(base); err != nil {\n112|\t\t\tcontinue\n113|\t\t}\n114|\t\t// Recursion stays local: the core selects single-package\n115|\t\t// production files, while this attestation spans trees.\n116|\t\t// Fail-closed parsing is the core's.\n117|\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\n118|\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n119|\t\t\t\treturn err\n120|\t\t\t}\n121|\t\t\tscanned++\n122|\t\t\tsource, err := os.ReadFile(path)\n123|\t\t\tif err != nil {\n124|\t\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n125|\t\t\t}\n126|\t\t\tif !strings.Contains(string(source), \"VerifyObjectIdentity\") {\n127|\t\t\t\treturn nil\n128|\t\t\t}\n129|\t\t\tparsed++\n130|\t\t\tsyntax, fileSet, failure := invcore.ParseBytes(path, source, 0)\n131|\t\t\tif failure != \"\" {\n132|\t\t\t\tt.Fatalf(\"parse %s: %s\", path, failure)\n133|\t\t\t}\n134|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n135|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n136|\t\t\t\tif !ok {\n137|\t\t\t\t\treturn true\n138|\t\t\t\t}\n139|\t\t\t\trecord := func(position token.Position) {\n140|\t\t\t\t\tentry := fmt.Sprintf(\"%s:%d\", position.Filename, position.Line)\n141|\t\t\t\t\tif strings.Contains(position.Filename, sessrepoLeaf) {\n142|\t\t\t\t\t\tallowed = append(allowed, entry)\n143|\t\t\t\t\t\treturn\n144|\t\t\t\t\t}\n145|\t\t\t\t\tcallers = append(callers, entry)\n146|\t\t\t\t}\n147|\t\t\t\tswitch fun := call.Fun.(type) {\n148|\t\t\t\tcase *ast.SelectorExpr:\n149|\t\t\t\t\tif fun.Sel.Name == \"VerifyObjectIdentity\" {\n150|\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\n151|\t\t\t\t\t}\n152|\t\t\t\tcase *ast.Ident:\n153|\t\t\t\t\tif fun.Name == \"VerifyObjectIdentity\" {\n154|\t\t\t\t\t\t// The canonicaljson definition itself is a\n155|\t\t\t\t\t\t// FuncDecl, never a call; a bare-identifier call\n156|\t\t\t\t\t\t// anywhere is a production call site.\n157|\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\n158|\t\t\t\t\t}\n159|\t\t\t\t}\n160|\t\t\t\treturn true\n161|\t\t\t})\n162|\t\t\treturn nil\n163|\t\t}); err != nil {\n164|\t\t\tt.Fatalf(\"walk %s: %v\", base, err)\n165|\t\t}\n166|\t}\n167|\tif scanned == 0 {\n168|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n169|\t}\n170|\tif len(allowed) == 0 {\n171|\t\tt.Fatal(\"sessrepo attestation exception is stale: no allowlisted call site remains, remove the exception\")\n172|\t}\n173|\tif len(callers) != 0 {\n174|\t\tt.Fatalf(\"production call sites outside the session leaf attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\n175|\t}\n176|\tt.Logf(\"attestation scan: %d production files, %d parsed, %d session-leaf call sites, 0 elsewhere\", scanned, parsed, len(allowed))\n177|}\n178|\n179|// identityVariant rewrites one unique substring of the example.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ad","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":433,"recorded_at":1780531400000861,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"call_id":"call_01a07bdb811b7a508dbf97d678304faf","text":"{\n  \"chunk_id\": \"exec-10-1\",\n  \"command\": \"grep -rn \\\"schema gate\\\\|never reach\\\\|before it verifies\\\\|before Verify\\\" --include=\\\"*.go\\\" --include=\\\"*.md\\\" internal/ LOGBOOK.md README.md 2>/dev/null | grep -vi \\\"test_\\\" | head -n 20; echo \\\"=== gitignore ===\\\"; cat .gitignore; echo \\\"=== board ===\\\"; task-board m 'checklist(TASK-260830-wbpf1v)' 2>&1 | head -n 60\",\n  \"description\": \"Find F1 bound statements, gitignore, checklist\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/secprim/inventory_test.go:441:\\t// Factory declarations whose body never reaches a constructor\\ninternal/secconftest/runner.go:12:// refuses fixtures that record none, so a corpus that never reaches the\\ninternal/secconftest/crash_test.go:164:\\t\\t\\t\\tt.Fatalf(\\\"armed point %q was never reached; remaining %q\\\", kase.point, got)\\ninternal/secconftest/crash_test.go:304:\\t\\tt.Fatalf(\\\"armed point was never reached; remaining %q\\\", got)\\ninternal/secconftest/doc.go:39:// armed point the drive never reaches fails its test instead of\\ninternal/terminalbackend/refusal_arm_inventory_test.go:261:\\t\\t\\t\\t\\t// A wrapped literal never reaches here: the refuse\\ninternal/terminalbackend/refusal_arm_inventory_test.go:575:// a JSON number never reaches the walk; the walk holds that order for\\ninternal/terminalbackend/manifest.go:1694:\\t// bound and grammar arms carry no BackendID — and never reaches the\\ninternal/terminalbackend/manifest_test.go:656:// TestManifestDocumentRefusals narrows the closed-schema gate: each case\\ninternal/terminalbackend/manifest_test.go:945:// TestProbeDocumentRefusals narrows the probe closed-schema gate: the same\\ninternal/terminalbackend/manifest_test.go:1093:// TestEvidenceDocumentRefusals narrows the evidence closed-schema gate: the\\ninternal/terminalbackend/refusal_site_audit_test.go:79:// scoped (-run) run never reaches the audit by fullPackageTestRun.\\ninternal/terminalbackend/digit_guard_census_test.go:297:// `:` (0x3A) — the characters adjacent to the digit range — never reach\\ninternal/terminalbackend/identity_ownership_test.go:800:// never reaches the gate through a document because the UTF-8 arm fires\\ninternal/terminalbackend/internal_pin_test.go:283:// pins (including the raw WTF-8 road, which never reaches the gate through\\ninternal/canonicaljson/constraint_inventory_test.go:175:// row whose validator is never reached from an exported entry point. An\\ninternal/canonicaljson/record_conformance_test.go:644:\\t// evidence for a clause it never reached.\\ninternal/canonicaljson/record_conformance_test.go:659:\\t\\t// Deleting the member never reaches validateCommonRecordEnvelope:\\ninternal/canonicaljson/refusal_guards_test.go:31:// on the closed-member sweep and never reaches the per-member type, format or\\ninternal/canonicaljson/core_record_guards_test.go:241:\\t\\t\\t// any other reason, which the previous inference never reached.\\n=== gitignore ===\\n# Curator\\n.agents/\\n.claude/skills/\\n.codex/skills/\\n.cursor/rules/\\n.gemini/skills/\\nSkillfile.dev.json\\n\\n# Project-local temporary artifacts\\n.temp/\\n.task-board/.board-write-ledger.json\\n.DS_Store\\n=== board ===\\nmutation error: parse error at 1:1: unknown operation \\\"checklist\\\" (got \\\"checklist\\\")\\n\",\n  \"original_output_bytes\": 2671,\n  \"original_output_tokens\": 668,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
