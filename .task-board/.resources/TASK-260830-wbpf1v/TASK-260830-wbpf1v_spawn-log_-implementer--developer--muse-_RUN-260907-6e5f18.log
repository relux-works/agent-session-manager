{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c957","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":774,"recorded_at":1780531400001543,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"task_stream":{"kind":"task","id":"ddcf1e2b-c4d8-4ce4-a2d3-3432463223f6"},"task_id":"ddcf1e2b-c4d8-4ce4-a2d3-3432463223f6","event":{"kind":"output","task_id":"ddcf1e2b-c4d8-4ce4-a2d3-3432463223f6","chunk":"edited\nchanged lines: lines 409-424\n--- original\n+++ updated\n@@\n-// installEventBlob installs one event blob idempotently: identical bytes\n-// already present are reused, disagreeing bytes are reported for refusal,\n-// and the no-replace open keeps the install atomic.\n-func installEventBlob(path string, data []byte) error {\n-\tif _, err := os.Stat(path); err == nil {\n-\t\texisting, readErr := os.ReadFile(path)\n-\t\tif readErr != nil || !bytes.Equal(existing, data) {\n-\t\t\treturn errDigestDisagreement\n-\t\t}\n-\t\treturn nil\n-\t}\n-\tif err := writeExclusive(path, data); err != nil {\n-\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n-\t}\n-\treturn nil\n-}\n+// installEventBlob installs one event blob idempotently through the\n+// no-replace open first: a fresh path is created atomically, and only an\n+// EEXIST loser falls back to comparing against the winner's bytes —\n+// identical bytes are reused, disagreeing bytes are reported for\n+// refusal. Leading with the exclusive create (instead of stat-then-act)\n+// keeps the no-replace property a filesystem fact under a second\n+// process, not a check-then-act race the repository mutex cannot see:\n+// the mutex serializes one process, while O_EXCL serializes all of\n+// them. A path that exists but is not a readable file still fails the\n+// install, as an operational error rather than a digest disagreement.\n+func installEventBlob(path string, data []byte) error {\n+\tif err := writeExclusive(path, data); err == nil {\n+\t\treturn nil\n+\t} else if !os.IsExist(err) {\n+\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n+\t}\n+\texisting, readErr := os.ReadFile(path)\n+\tif readErr != nil || !bytes.Equal(existing, data) {\n+\t\treturn errDigestDisagreement\n+\t}\n+\treturn nil\n+}\n"}}}
