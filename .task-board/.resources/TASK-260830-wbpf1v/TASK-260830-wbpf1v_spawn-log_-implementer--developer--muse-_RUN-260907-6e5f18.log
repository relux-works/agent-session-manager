{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43b","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":120,"recorded_at":1780531400000235,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"task_stream":{"kind":"task","id":"444c5863-a85d-4aa3-8ab3-6a7f312e2313"},"task_id":"444c5863-a85d-4aa3-8ab3-6a7f312e2313","event":{"kind":"output","task_id":"444c5863-a85d-4aa3-8ab3-6a7f312e2313","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessrepo/chain.go`.\n(99 line(s) above)\n100|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n101|\tif err != nil {\n102|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"verify session event identity: %v\", err)\n103|\t}\n104|\tif field != canonicaljson.SelfEventID {\n105|\t\treturn eventView{}, fmt.Errorf(\"session event identity field %q, want event_id\", string(field))\n106|\t}\n107|\tevent.raw = raw\n108|\tevent.eventID = digest.String()\n109|\treturn event, nil\n110|}\n111|\n112|// extractEventMembers reads the routing members after the frame gate. It\n113|// returns plain errors; the caller attributes them through its one member\n114|// site. Grammar and range rules stay with their owners: UUIDv7 and uint53\n115|// with environ, digests and UUIDv4 with scalar.\n116|func extractEventMembers(members map[string]json.RawMessage) (eventView, error) {\n117|\tvar event eventView\n118|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n119|\tif !ok {\n120|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv7\", \"session_id\")\n121|\t}\n122|\tevent.sessionID = sessionID.String()\n123|\teventType, err := stringMember(members, \"event_type\")\n124|\tif err != nil {\n125|\t\treturn eventView{}, err\n126|\t}\n127|\tevent.eventType = eventType\n128|\tepoch, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_epoch\"), 1, uint53Max)\n129|\tif !ok {\n130|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_epoch\")\n131|\t}\n132|\tevent.leaseEpoch = epoch\n133|\tleaseID, err := stringMember(members, \"lease_id\")\n134|\tif err != nil {\n135|\t\treturn eventView{}, err\n136|\t}\n137|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n138|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv4: %v\", \"lease_id\", err)\n139|\t}\n140|\tevent.leaseID = leaseID\n141|\tsequence, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_sequence\"), 1, uint53Max)\n142|\tif !ok {\n143|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_sequence\")\n144|\t}\n145|\tevent.leaseSeq = sequence\n146|\tpredecessors, err := digestMembers(members, \"predecessors\")\n147|\tif err != nil {\n148|\t\treturn eventView{}, err\n149|\t}\n150|\tif len(predecessors) == 0 {\n151|\t\treturn eventView{}, fmt.Errorf(\"member %q names no predecessor\", \"predecessors\")\n152|\t}\n153|\tevent.predecessors = predecessors\n154|\treturn event, nil\n155|}\n156|\n157|// checkAppend enforces the SPEC.md Section 5.2 chain rules for one event\n158|// against the record and the current tail: the first event links exactly\n159|// the Session Record at sequence 1 with no gap; within one lease the\n160|// sequence increases by exactly one with no repeat and each event\n161|// references the immediately prior authoritative event; a successor lease\n162|// restarts at 1 referencing the predecessor head; a same-epoch second\n163|// lease diverges and a lower epoch is stale. The reload audit folds this\n164|// same check over the stored index, so weakening any arm breaks both the\n165|// append and the reload evidence.\n166|func checkAppend(recordID string, tail *EventSummary, event eventView) error {\n167|\tif tail != nil && event.leaseID != tail.LeaseID {\n168|\t\tif event.leaseEpoch < tail.LeaseEpoch {\n169|\t\t\treturn refuse(ErrStaleLease, \"event lease epoch %d precedes chain head epoch %d\", event.leaseEpoch, tail.LeaseEpoch)\n170|\t\t}\n171|\t\tif event.leaseEpoch == tail.LeaseEpoch {\n172|\t\t\treturn refuse(ErrDivergentBranch, \"event under lease %s diverges from chain head lease %s at epoch %d\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\n173|\t\t}\n174|\t}\n175|\twant := uint64(1)\n176|\tif tail != nil && event.leaseID == tail.LeaseID {\n177|\t\twant = tail.LeaseSequence + 1\n178|\t}\n179|\tif event.leaseSeq < want {\n180|\t\treturn refuse(ErrSequenceRepeat, \"event lease sequence %d repeats chained sequence through %d\", event.leaseSeq, want-1)\n181|\t}\n182|\tif event.leaseSeq > want {\n183|\t\treturn refuse(ErrSequenceGap, \"event lease sequence %d skips chained sequence %d\", event.leaseSeq, want)\n184|\t}\n185|\tif tail == nil {\n186|\t\tif len(event.predecessors) != 1 || event.predecessors[0] != recordID {\n187|\t\t\treturn refuse(ErrPredecessorLink, \"first event must link exactly the session record\")\n188|\t\t}\n189|\t\treturn nil\n190|\t}\n191|\tif !containsDigest(event.predecessors, tail.EventID) {\n192|\t\treturn refuse(ErrPredecessorLink, \"event predecessors omit prior authoritative event\")\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|func containsDigest(haystack []string, needle string) bool {\n198|\tfor _, candidate := range haystack {\n199|\t\tif candidate == needle {\n200|\t\t\treturn true\n201|\t\t}\n202|\t}\n203|\treturn false\n204|}\n205|\n206|// memberRaw reports the raw member for the environ bound checkers. A\n207|// missing member yields nil, which every checker refuses.\n208|func memberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n209|\treturn members[name]\n210|}\n211|\n212|// stringMember reads one string member with the language decoder. Grammar\n213|// rules for the value stay with the shape owner; this only accesses it.\n214|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n215|\traw, ok := members[name]\n216|\tif !ok {\n217|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n218|\t}\n219|\tvar value string\n220|\tif err := json.Unmarshal(raw, &value); err != nil {\n221|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n222|\t}\n223|\treturn value, nil\n224|}\n225|\n226|// digestMembers reads one array of digest strings. Digest grammar stays\n227|// with the scalar owner.\n228|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n229|\traw, ok := members[name]\n230|\tif !ok {\n231|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n232|\t}\n233|\tvar values []string\n234|\tif err := json.Unmarshal(raw, &values); err != nil {\n235|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n236|\t}\n237|\tfor _, value := range values {\n238|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n239|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n240|\t\t}\n241|\t}\n242|\treturn values, nil\n243|}\n244|\n245|// sessionDir maps a validated session ID to its directory. The ID passed\n246|// the scalar UUIDv7 grammar at decode time, so no traversaliedy member can\n247|// reach the join; path policy stays with the scalar and secprim owners.\n248|func (repository *Repository) sessionDir(sessionID string) string {\n249|\treturn filepath.Join(repository.root, sessionID)\n250|}\n251|\n252|// loadSessionLocked loads and fully re-verifies one session: the chain\n253|// index decodes, the record bytes re-verify against the indexed digest,\n254|// every indexed event blob re-verifies, and the index folds clean through\n255|// the append rules. Callers hold the repository mutex.\n256|func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {\n257|\tdirectory := repository.sessionDir(sessionID)\n258|\tif _, err := os.Stat(directory); err != nil {\n259|\t\treturn nil, refuse(ErrUnknownSession, \"unknown session %s\", sessionID)\n260|\t}\n261|\tchainBytes, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n262|\tif err != nil {\n263|\t\treturn nil, refuse(ErrChainCorrupt, \"read chain index for session %s: %v\", sessionID, err)\n264|\t}\n265|\tchain, err := decodeChainIndex(chainBytes)\n266|\tif err != nil {\n267|\t\treturn nil, refuse(ErrChainCorrupt, \"decode chain index for session %s: %v\", sessionID, err)\n268|\t}\n269|\trecordBytes, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n270|\tif err != nil {\n271|\t\treturn nil, refuse(ErrChainCorrupt, \"read session record for session %s: %v\", sessionID, err)\n272|\t}\n273|\trecord, err := decodeSessionRecord(recordBytes)\n274|\tif err != nil {\n275|\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify session record for session %s: %v\", sessionID, err)\n276|\t}\n277|\tif record.recordID != chain.RecordID || record.sessionID != sessionID {\n278|\t\treturn nil, refuse(ErrChainCorrupt, \"chain index does not describe stored session record for session %s\", sessionID)\n279|\t}\n280|\tevents := filepath.Join(directory, \"events\")\n281|\tfor position, indexed := range chain.Events {\n282|\t\tblob, err := os.ReadFile(filepath.Join(events, blobFileName(indexed.EventID)))\n283|\t\tif err != nil {\n284|\t\t\treturn nil, refuse(ErrChainCorrupt, \"read chained event %d for session %s: %v\", position, sessionID, err)\n285|\t\t}\n286|\t\tdigest, field, err := canonicaljson.VerifyObjectIdentity(blob)\n287|\t\tif err != nil || field != canonicaljson.SelfEventID || digest.String() != indexed.EventID {\n288|\t\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)\n289|\t\t}\n290|\t\tvar tail *EventSummary\n291|\t\tif position > 0 {\n292|\t\t\ttail = &chain.Events[position-1]\n293|\t\t}\n294|\t\treplay := eventView{eventID: indexed.EventID, eventType: indexed.EventType, sessionID: sessionID, leaseEpoch: indexed.LeaseEpoch, leaseID: indexed.LeaseID, leaseSeq: indexed.LeaseSequence, predecessors: indexed.Predecessors}\n295|\t\tif err := checkAppend(chain.RecordID, tail, replay); err != nil {\n296|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chain index order breaks continuity at event %d for session %s: %v\", position, sessionID, err)\n297|\t\t}\n298|\t}\n299|\treturn &sessionView{directory: directory, record: record, chain: chain}, nil\n300|}\n301|\n302|// decodeChainIndex decodes the internal chain index. It is not an AX wire\n303|// object, so the canonical owner does not validate it; member grammars\n304|// still stay with environ and scalar.\n305|func decodeChainIndex(raw []byte) (storedChain, error) {\n306|\tmembers, fault := environ.DecodeStrictObject(raw)\n307|\tif fault != nil {\n308|\t\treturn storedChain{}, fmt.Errorf(\"decode chain frame: %v\", fault)\n309|\t}\n310|\trecordID, err := stringMember(members, \"record_id\")\n311|\tif err != nil {\n312|\t\treturn storedChain{}, err\n313|\t}\n314|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n315|\t\treturn storedChain{}, fmt.Errorf(\"chain record_id: %v\", err)\n316|\t}\n317|\trawEvents, ok := members[\"events\"]\n318|\tif !ok {\n319|\t\treturn storedChain{}, fmt.Errorf(\"member %q is absent\", \"events\")\n320|\t}\n321|\tvar entries []map[string]json.RawMessage\n322|\tif err := json.Unmarshal(rawEvents, &entries); err != nil {\n323|\t\treturn storedChain{}, fmt.Errorf(\"member %q is not an object array: %v\", \"events\", err)\n324|\t}\n325|\tchain := storedChain{RecordID: recordID}\n326|\tfor _, entry := range entries {\n327|\t\tsummary, err := decodeChainEntry(entry)\n328|\t\tif err != nil {\n329|\t\t\treturn storedChain{}, err\n330|\t\t}\n331|\t\tchain.Events = append(chain.Events, summary)\n332|\t}\n333|\treturn chain, nil\n334|}\n335|\n336|// decodeChainEntry validates one index entry. Failures are plain errors;\n337|// loadSessionLocked attributes them through its one index site.\n338|func decodeChainEntry(entry map[string]json.RawMessage) (EventSummary, error) {\n339|\tvar summary EventSummary\n340|\teventID, err := stringMember(entry, \"event_id\")\n341|\tif err != nil {\n342|\t\treturn EventSummary{}, err\n343|\t}\n344|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n345|\t\treturn EventSummary{}, fmt.Errorf(\"chain event_id: %v\", err)\n346|\t}\n347|\tsummary.EventID = eventID\n348|\teventType, err := stringMember(entry, \"event_type\")\n349|\tif err != nil {\n350|\t\treturn EventSummary{}, err\n351|\t}\n352|\tsummary.EventType = eventType\n353|\tepoch, ok := environ.CheckUint53Bounds(entry[\"lease_epoch\"], 1, uint53Max)\n354|\tif !ok {\n355|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_epoch\")\n356|\t}\n357|\tsummary.LeaseEpoch = epoch\n358|\tleaseID, err := stringMember(entry, \"lease_id\")\n359|\tif err != nil {\n360|\t\treturn EventSummary{}, err\n361|\t}\n362|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n363|\t\treturn EventSummary{}, fmt.Errorf(\"chain lease_id: %v\", err)\n364|\t}\n365|\tsummary.LeaseID = leaseID\n366|\tsequence, ok := environ.CheckUint53Bounds(entry[\"lease_sequence\"], 1, uint53Max)\n367|\tif !ok {\n368|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_sequence\")\n369|\t}\n370|\tsummary.LeaseSequence = sequence\n371|\tpredecessors, err := digestMembers(entry, \"predecessors\")\n372|\tif err != nil {\n373|\t\treturn EventSummary{}, err\n374|\t}\n375|\tsummary.Predecessors = predecessors\n376|\treturn summary, nil\n377|}\n378|\n379|// writeChain stores the index atomically: temp file, fsync, rename, fsync\n380|// the directory. A crash either leaves the previous index or the new one;\n381|// the blobs it names are verified on every load, so neither outcome can\n382|// invent history.\n383|func (repository *Repository) writeChain(directory string, chain storedChain) error {\n384|\tpayload, err := json.Marshal(chainPayload{RecordID: chain.RecordID, Events: chain.Events})\n385|\tif err != nil {\n386|\t\treturn fmt.Errorf(\"encode chain index: %w\", err)\n387|\t}\n388|\treturn writeAtomic(filepath.Join(directory, \"chain.json\"), payload)\n389|}\n390|\n391|// chainPayload is the on-disk shape of the index. EventSummary carries the\n392|// JSON tags so the stored form stays exactly this struct.\n393|type chainPayload struct {\n394|\tRecordID string         `json:\"record_id\"`\n395|\tEvents   []EventSummary `json:\"events\"`\n396|}\n397|\n398|// errDigestDisagreement reports bytes at a digest path that a completed\n399|// read proved different from the installing candidate. It is an internal\n400|// marker, never a refusal: callers attribute it through their own site.\n401|var errDigestDisagreement = errors.New(\"digest path holds disagreeing bytes\")\n402|\n403|// installEventBlob installs one event blob idempotently: identical bytes\n404|// already present are reused, disagreeing bytes are reported for refusal,\n405|// and the no-replace open keeps the install atomic.\n406|func installEventBlob(path string, data []byte) error {\n407|\tif _, err := os.Stat(path); err == nil {\n408|\t\texisting, readErr := os.ReadFile(path)\n409|\t\tif readErr != nil || !bytes.Equal(existing, data) {\n410|\t\t\treturn errDigestDisagreement\n411|\t\t}\n412|\t\treturn nil\n413|\t}\n414|\tif err := writeExclusive(path, data); err != nil {\n415|\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n416|\t}\n417|\treturn nil\n418|}\n419|\n420|// writeExclusive installs bytes at a path that must not exist. The\n421|// no-replace open makes append-only a filesystem property, not a convention.\n422|func writeExclusive(path string, data []byte) error {\n423|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n424|\tif err != nil {\n425|\t\treturn err\n426|\t}\n427|\tif _, err := file.Write(data); err != nil {\n428|\t\t_ = file.Close()\n429|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n430|\t}\n431|\tif err := file.Sync(); err != nil {\n432|\t\t_ = file.Close()\n433|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n434|\t}\n435|\tif err := file.Close(); err != nil {\n436|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n437|\t}\n438|\treturn nil\n439|}\n440|\n441|// writeAtomic replaces a path through a temp file in the same directory:\n442|// staged bytes fsync before the rename, the directory fsyncs after.\n443|func writeAtomic(path string, data []byte) error {\n444|\tstaged, err := os.CreateTemp(filepath.Dir(path), \".ax-chain-stage-\")\n445|\tif err != nil {\n446|\t\treturn fmt.Errorf(\"stage chain index: %w\", err)\n447|\t}\n448|\tstagedPath := staged.Name()\n449|\tfinished := false\n450|\tdefer func() {\n451|\t\tif !finished {\n452|\t\t\t_ = staged.Close()\n453|\t\t\t_ = os.Remove(stagedPath)\n454|\t\t}\n455|\t}()\n456|\tif err := staged.Chmod(0o600); err != nil {\n457|\t\treturn fmt.Errorf(\"mode staged chain index: %w\", err)\n458|\t}\n459|\tif _, err := io.Copy(staged, bytes.NewReader(data)); err != nil {\n460|\t\treturn fmt.Errorf(\"write staged chain index: %w\", err)\n461|\t}\n462|\tif err := staged.Sync(); err != nil {\n463|\t\treturn fmt.Errorf(\"fsync staged chain index: %w\", err)\n464|\t}\n465|\tif err := staged.Close(); err != nil {\n466|\t\treturn fmt.Errorf(\"close staged chain index: %w\", err)\n467|\t}\n468|\tfinished = true\n469|\tif err := os.Rename(stagedPath, path); err != nil {\n470|\t\treturn fmt.Errorf(\"install chain index: %w\", err)\n471|\t}\n472|\treturn syncDirectory(filepath.Dir(path))\n473|}\n474|\n475|// blobFileName maps a validated event digest to its file name. The digest\n476|// passed scalar grammar at decode time; Hex is the owner's rendering.\n477|func blobFileName(eventID string) string {\n478|\tdigest, err := scalar.ParseDigest(eventID)\n479|\tif err != nil {\n480|\t\treturn \"invalid.json\"\n481|\t}\n482|\treturn digest.Hex() + \".json\"\n483|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43d","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":121,"recorded_at":1780531400000237,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"task_stream":{"kind":"task","id":"444c5863-a85d-4aa3-8ab3-6a7f312e2313"},"task_id":"444c5863-a85d-4aa3-8ab3-6a7f312e2313","event":{"kind":"completed","task_id":"444c5863-a85d-4aa3-8ab3-6a7f312e2313"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43f","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":122,"recorded_at":1780531400000239,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"call_id":"call_01a07bd852007ef3b01e93795e470934","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessrepo/sessrepo.go`.\n(99 line(s) above)\n100|\n101|// Open binds a repository to the sessions namespace beneath dataRoot,\n102|// creating it owner-only when absent. The root must be absolute.\n103|func Open(dataRoot string) (*Repository, error) {\n104|\tif !filepath.IsAbs(dataRoot) {\n105|\t\treturn nil, refuse(ErrRepositoryPath, \"data root %q is not absolute\", dataRoot)\n106|\t}\n107|\troot := filepath.Join(dataRoot, \"sessions\")\n108|\tif err := os.MkdirAll(root, 0o700); err != nil {\n109|\t\treturn nil, refuse(ErrRepositoryPath, \"create sessions root %q: %v\", root, err)\n110|\t}\n111|\treturn &Repository{root: root}, nil\n112|}\n113|\n114|// CreateSession validates recordJSON through the canonical owner and\n115|// persists it as a new session. The bytes are stored verbatim.\n116|func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\n117|\trecord, err := decodeSessionRecord(recordJSON)\n118|\tif err != nil {\n119|\t\treturn SessionRef{}, err\n120|\t}\n121|\trepository.mutex.Lock()\n122|\tdefer repository.mutex.Unlock()\n123|\tif repository.BeforeWrite != nil {\n124|\t\tif err := repository.BeforeWrite(); err != nil {\n125|\t\t\treturn SessionRef{}, err\n126|\t\t}\n127|\t}\n128|\tdirectory := repository.sessionDir(record.sessionID)\n129|\tif _, err := os.Stat(directory); err == nil {\n130|\t\tresumed, resumeErr := repository.resumeCreateLocked(directory, record, recordJSON)\n131|\t\tif resumeErr != nil {\n132|\t\t\treturn SessionRef{}, resumeErr\n133|\t\t}\n134|\t\tif !resumed {\n135|\t\t\treturn SessionRef{}, refuse(ErrSessionExists, \"session %s already exists\", record.sessionID)\n136|\t\t}\n137|\t} else {\n138|\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n139|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session directory: %w\", err)\n140|\t\t}\n141|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n142|\t\t\treturn SessionRef{}, fmt.Errorf(\"install session record: %w\", err)\n143|\t\t}\n144|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n145|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session events directory: %w\", err)\n146|\t\t}\n147|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n148|\t\t\treturn SessionRef{}, err\n149|\t\t}\n150|\t}\n151|\tif repository.AfterCommit != nil {\n152|\t\tif err := repository.AfterCommit(); err != nil {\n153|\t\t\treturn SessionRef{}, err\n154|\t\t}\n155|\t}\n156|\treturn SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil\n157|}\n158|\n159|// resumeCreateLocked completes a create that crashed between the record\n160|// write and the chain write: the stored record bytes must equal the\n161|// retried bytes and the chain must still be absent. Anything else is not\n162|// a resume — the caller refuses it as an existing session. It returns\n163|// plain operational errors; refusal attribution stays at the caller.\n164|func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {\n165|\texisting, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n166|\tif err != nil || !bytes.Equal(existing, recordJSON) {\n167|\t\treturn false, nil\n168|\t}\n169|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); err == nil {\n170|\t\treturn false, nil\n171|\t}\n172|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n173|\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n174|\t}\n175|\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n176|\t\treturn false, err\n177|\t}\n178|\treturn true, nil\n179|}\n180|\n181|// AppendEvent validates eventJSON through the canonical owner and links it\n182|// onto the session chain after the continuity checks. A byte-identical\n183|// retry of an already chained event returns its existing reference without\n184|// duplicating the chain, so a retry after a crashed commit is safe.\n185|func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\n186|\tevent, err := decodeSessionEvent(eventJSON)\n187|\tif err != nil {\n188|\t\treturn EventRef{}, err\n189|\t}\n190|\tif event.sessionID != sessionID {\n191|\t\treturn EventRef{}, refuse(ErrInvalidEvent, \"event session %s does not match target session %s\", event.sessionID, sessionID)\n192|\t}\n193|\trepository.mutex.Lock()\n194|\tdefer repository.mutex.Unlock()\n195|\tview, err := repository.loadSessionLocked(sessionID)\n196|\tif err != nil {\n197|\t\treturn EventRef{}, err\n198|\t}\n199|\tfor position, existing := range view.chain.Events {\n200|\t\tif existing.EventID == event.eventID {\n201|\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n202|\t\t}\n203|\t}\n204|\tif repository.BeforeWrite != nil {\n205|\t\tif err := repository.BeforeWrite(); err != nil {\n206|\t\t\treturn EventRef{}, err\n207|\t\t}\n208|\t}\n209|\tvar tail *EventSummary\n210|\tif len(view.chain.Events) > 0 {\n211|\t\tprevious := view.chain.Events[len(view.chain.Events)-1]\n212|\t\ttail = &previous\n213|\t}\n214|\tif err := checkAppend(view.chain.RecordID, tail, event); err != nil {\n215|\t\t// Losing-lease branches are preserved as immutable blobs but never\n216|\t\t// applied: the bytes stay addressable while the chain is untouched.\n217|\t\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\n218|\t\t\tif preserveErr := installEventBlob(filepath.Join(view.directory, \"events\", blobFileName(event.eventID)), eventJSON); preserveErr != nil {\n219|\t\t\t\treturn EventRef{}, fmt.Errorf(\"preserve unapplied branch: %v: %w\", preserveErr, err)\n220|\t\t\t}\n221|\t\t}\n222|\t\treturn EventRef{}, err\n223|\t}\n224|\tblobPath := filepath.Join(view.directory, \"events\", blobFileName(event.eventID))\n225|\tif err := installEventBlob(blobPath, eventJSON); err != nil {\n226|\t\tif errors.Is(err, errDigestDisagreement) {\n227|\t\t\treturn EventRef{}, refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for event\")\n228|\t\t}\n229|\t\treturn EventRef{}, err\n230|\t}\n231|\tnext := append(append([]EventSummary(nil), view.chain.Events...), eventSummary(event))\n232|\tif err := repository.writeChain(view.directory, storedChain{RecordID: view.chain.RecordID, Events: next}); err != nil {\n233|\t\treturn EventRef{}, err\n234|\t}\n235|\tif repository.AfterCommit != nil {\n236|\t\tif err := repository.AfterCommit(); err != nil {\n237|\t\t\treturn EventRef{}, err\n238|\t\t}\n239|\t}\n240|\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: event.leaseSeq, Position: len(next) - 1}, nil\n241|}\n242|\n243|// eventSummary projects the validated routing members into the chain index.\n244|func eventSummary(event eventView) EventSummary {\n245|\treturn EventSummary{EventID: event.eventID, EventType: event.eventType, LeaseEpoch: event.leaseEpoch, LeaseID: event.leaseID, LeaseSequence: event.leaseSeq, Predecessors: append([]string(nil), event.predecessors...)}\n246|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c441","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":123,"recorded_at":1780531400000241,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"call_id":"call_01a07bd8532079209d6f178bb2975906","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessrepo/chain.go`.\n(99 line(s) above)\n100|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n101|\tif err != nil {\n102|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"verify session event identity: %v\", err)\n103|\t}\n104|\tif field != canonicaljson.SelfEventID {\n105|\t\treturn eventView{}, fmt.Errorf(\"session event identity field %q, want event_id\", string(field))\n106|\t}\n107|\tevent.raw = raw\n108|\tevent.eventID = digest.String()\n109|\treturn event, nil\n110|}\n111|\n112|// extractEventMembers reads the routing members after the frame gate. It\n113|// returns plain errors; the caller attributes them through its one member\n114|// site. Grammar and range rules stay with their owners: UUIDv7 and uint53\n115|// with environ, digests and UUIDv4 with scalar.\n116|func extractEventMembers(members map[string]json.RawMessage) (eventView, error) {\n117|\tvar event eventView\n118|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n119|\tif !ok {\n120|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv7\", \"session_id\")\n121|\t}\n122|\tevent.sessionID = sessionID.String()\n123|\teventType, err := stringMember(members, \"event_type\")\n124|\tif err != nil {\n125|\t\treturn eventView{}, err\n126|\t}\n127|\tevent.eventType = eventType\n128|\tepoch, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_epoch\"), 1, uint53Max)\n129|\tif !ok {\n130|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_epoch\")\n131|\t}\n132|\tevent.leaseEpoch = epoch\n133|\tleaseID, err := stringMember(members, \"lease_id\")\n134|\tif err != nil {\n135|\t\treturn eventView{}, err\n136|\t}\n137|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n138|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv4: %v\", \"lease_id\", err)\n139|\t}\n140|\tevent.leaseID = leaseID\n141|\tsequence, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_sequence\"), 1, uint53Max)\n142|\tif !ok {\n143|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_sequence\")\n144|\t}\n145|\tevent.leaseSeq = sequence\n146|\tpredecessors, err := digestMembers(members, \"predecessors\")\n147|\tif err != nil {\n148|\t\treturn eventView{}, err\n149|\t}\n150|\tif len(predecessors) == 0 {\n151|\t\treturn eventView{}, fmt.Errorf(\"member %q names no predecessor\", \"predecessors\")\n152|\t}\n153|\tevent.predecessors = predecessors\n154|\treturn event, nil\n155|}\n156|\n157|// checkAppend enforces the SPEC.md Section 5.2 chain rules for one event\n158|// against the record and the current tail: the first event links exactly\n159|// the Session Record at sequence 1 with no gap; within one lease the\n160|// sequence increases by exactly one with no repeat and each event\n161|// references the immediately prior authoritative event; a successor lease\n162|// restarts at 1 referencing the predecessor head; a same-epoch second\n163|// lease diverges and a lower epoch is stale. The reload audit folds this\n164|// same check over the stored index, so weakening any arm breaks both the\n165|// append and the reload evidence.\n166|func checkAppend(recordID string, tail *EventSummary, event eventView) error {\n167|\tif tail != nil && event.leaseID != tail.LeaseID {\n168|\t\tif event.leaseEpoch < tail.LeaseEpoch {\n169|\t\t\treturn refuse(ErrStaleLease, \"event lease epoch %d precedes chain head epoch %d\", event.leaseEpoch, tail.LeaseEpoch)\n170|\t\t}\n171|\t\tif event.leaseEpoch == tail.LeaseEpoch {\n172|\t\t\treturn refuse(ErrDivergentBranch, \"event under lease %s diverges from chain head lease %s at epoch %d\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\n173|\t\t}\n174|\t}\n175|\twant := uint64(1)\n176|\tif tail != nil && event.leaseID == tail.LeaseID {\n177|\t\twant = tail.LeaseSequence + 1\n178|\t}\n179|\tif event.leaseSeq < want {\n180|\t\treturn refuse(ErrSequenceRepeat, \"event lease sequence %d repeats chained sequence through %d\", event.leaseSeq, want-1)\n181|\t}\n182|\tif event.leaseSeq > want {\n183|\t\treturn refuse(ErrSequenceGap, \"event lease sequence %d skips chained sequence %d\", event.leaseSeq, want)\n184|\t}\n185|\tif tail == nil {\n186|\t\tif len(event.predecessors) != 1 || event.predecessors[0] != recordID {\n187|\t\t\treturn refuse(ErrPredecessorLink, \"first event must link exactly the session record\")\n188|\t\t}\n189|\t\treturn nil\n190|\t}\n191|\tif !containsDigest(event.predecessors, tail.EventID) {\n192|\t\treturn refuse(ErrPredecessorLink, \"event predecessors omit prior authoritative event\")\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|func containsDigest(haystack []string, needle string) bool {\n198|\tfor _, candidate := range haystack {\n199|\t\tif candidate == needle {\n200|\t\t\treturn true\n201|\t\t}\n202|\t}\n203|\treturn false\n204|}\n205|\n206|// memberRaw reports the raw member for the environ bound checkers. A\n207|// missing member yields nil, which every checker refuses.\n208|func memberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n209|\treturn members[name]\n210|}\n211|\n212|// stringMember reads one string member with the language decoder. Grammar\n213|// rules for the value stay with the shape owner; this only accesses it.\n214|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n215|\traw, ok := members[name]\n216|\tif !ok {\n217|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n218|\t}\n219|\tvar value string\n220|\tif err := json.Unmarshal(raw, &value); err != nil {\n221|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n222|\t}\n223|\treturn value, nil\n224|}\n225|\n226|// digestMembers reads one array of digest strings. Digest grammar stays\n227|// with the scalar owner.\n228|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n229|\traw, ok := members[name]\n230|\tif !ok {\n231|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n232|\t}\n233|\tvar values []string\n234|\tif err := json.Unmarshal(raw, &values); err != nil {\n235|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n236|\t}\n237|\tfor _, value := range values {\n238|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n239|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n240|\t\t}\n241|\t}\n242|\treturn values, nil\n243|}\n244|\n245|// sessionDir maps a validated session ID to its directory. The ID passed\n246|// the scalar UUIDv7 grammar at decode time, so no traversaliedy member can\n247|// reach the join; path policy stays with the scalar and secprim owners.\n248|func (repository *Repository) sessionDir(sessionID string) string {\n249|\treturn filepath.Join(repository.root, sessionID)\n250|}\n251|\n252|// loadSessionLocked loads and fully re-verifies one session: the chain\n253|// index decodes, the record bytes re-verify against the indexed digest,\n254|// every indexed event blob re-verifies, and the index folds clean through\n255|// the append rules. Callers hold the repository mutex.\n256|func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {\n257|\tdirectory := repository.sessionDir(sessionID)\n258|\tif _, err := os.Stat(directory); err != nil {\n259|\t\treturn nil, refuse(ErrUnknownSession, \"unknown session %s\", sessionID)\n260|\t}\n261|\tchainBytes, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n262|\tif err != nil {\n263|\t\treturn nil, refuse(ErrChainCorrupt, \"read chain index for session %s: %v\", sessionID, err)\n264|\t}\n265|\tchain, err := decodeChainIndex(chainBytes)\n266|\tif err != nil {\n267|\t\treturn nil, refuse(ErrChainCorrupt, \"decode chain index for session %s: %v\", sessionID, err)\n268|\t}\n269|\trecordBytes, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n270|\tif err != nil {\n271|\t\treturn nil, refuse(ErrChainCorrupt, \"read session record for session %s: %v\", sessionID, err)\n272|\t}\n273|\trecord, err := decodeSessionRecord(recordBytes)\n274|\tif err != nil {\n275|\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify session record for session %s: %v\", sessionID, err)\n276|\t}\n277|\tif record.recordID != chain.RecordID || record.sessionID != sessionID {\n278|\t\treturn nil, refuse(ErrChainCorrupt, \"chain index does not describe stored session record for session %s\", sessionID)\n279|\t}\n280|\tevents := filepath.Join(directory, \"events\")\n281|\tfor position, indexed := range chain.Events {\n282|\t\tblob, err := os.ReadFile(filepath.Join(events, blobFileName(indexed.EventID)))\n283|\t\tif err != nil {\n284|\t\t\treturn nil, refuse(ErrChainCorrupt, \"read chained event %d for session %s: %v\", position, sessionID, err)\n285|\t\t}\n286|\t\tdigest, field, err := canonicaljson.VerifyObjectIdentity(blob)\n287|\t\tif err != nil || field != canonicaljson.SelfEventID || digest.String() != indexed.EventID {\n288|\t\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)\n289|\t\t}\n290|\t\tvar tail *EventSummary\n291|\t\tif position > 0 {\n292|\t\t\ttail = &chain.Events[position-1]\n293|\t\t}\n294|\t\treplay := eventView{eventID: indexed.EventID, eventType: indexed.EventType, sessionID: sessionID, leaseEpoch: indexed.LeaseEpoch, leaseID: indexed.LeaseID, leaseSeq: indexed.LeaseSequence, predecessors: indexed.Predecessors}\n295|\t\tif err := checkAppend(chain.RecordID, tail, replay); err != nil {\n296|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chain index order breaks continuity at event %d for session %s: %v\", position, sessionID, err)\n297|\t\t}\n298|\t}\n299|\treturn &sessionView{directory: directory, record: record, chain: chain}, nil\n300|}\n301|\n302|// decodeChainIndex decodes the internal chain index. It is not an AX wire\n303|// object, so the canonical owner does not validate it; member grammars\n304|// still stay with environ and scalar.\n305|func decodeChainIndex(raw []byte) (storedChain, error) {\n306|\tmembers, fault := environ.DecodeStrictObject(raw)\n307|\tif fault != nil {\n308|\t\treturn storedChain{}, fmt.Errorf(\"decode chain frame: %v\", fault)\n309|\t}\n310|\trecordID, err := stringMember(members, \"record_id\")\n311|\tif err != nil {\n312|\t\treturn storedChain{}, err\n313|\t}\n314|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n315|\t\treturn storedChain{}, fmt.Errorf(\"chain record_id: %v\", err)\n316|\t}\n317|\trawEvents, ok := members[\"events\"]\n318|\tif !ok {\n319|\t\treturn storedChain{}, fmt.Errorf(\"member %q is absent\", \"events\")\n320|\t}\n321|\tvar entries []map[string]json.RawMessage\n322|\tif err := json.Unmarshal(rawEvents, &entries); err != nil {\n323|\t\treturn storedChain{}, fmt.Errorf(\"member %q is not an object array: %v\", \"events\", err)\n324|\t}\n325|\tchain := storedChain{RecordID: recordID}\n326|\tfor _, entry := range entries {\n327|\t\tsummary, err := decodeChainEntry(entry)\n328|\t\tif err != nil {\n329|\t\t\treturn storedChain{}, err\n330|\t\t}\n331|\t\tchain.Events = append(chain.Events, summary)\n332|\t}\n333|\treturn chain, nil\n334|}\n335|\n336|// decodeChainEntry validates one index entry. Failures are plain errors;\n337|// loadSessionLocked attributes them through its one index site.\n338|func decodeChainEntry(entry map[string]json.RawMessage) (EventSummary, error) {\n339|\tvar summary EventSummary\n340|\teventID, err := stringMember(entry, \"event_id\")\n341|\tif err != nil {\n342|\t\treturn EventSummary{}, err\n343|\t}\n344|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n345|\t\treturn EventSummary{}, fmt.Errorf(\"chain event_id: %v\", err)\n346|\t}\n347|\tsummary.EventID = eventID\n348|\teventType, err := stringMember(entry, \"event_type\")\n349|\tif err != nil {\n350|\t\treturn EventSummary{}, err\n351|\t}\n352|\tsummary.EventType = eventType\n353|\tepoch, ok := environ.CheckUint53Bounds(entry[\"lease_epoch\"], 1, uint53Max)\n354|\tif !ok {\n355|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_epoch\")\n356|\t}\n357|\tsummary.LeaseEpoch = epoch\n358|\tleaseID, err := stringMember(entry, \"lease_id\")\n359|\tif err != nil {\n360|\t\treturn EventSummary{}, err\n361|\t}\n362|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n363|\t\treturn EventSummary{}, fmt.Errorf(\"chain lease_id: %v\", err)\n364|\t}\n365|\tsummary.LeaseID = leaseID\n366|\tsequence, ok := environ.CheckUint53Bounds(entry[\"lease_sequence\"], 1, uint53Max)\n367|\tif !ok {\n368|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_sequence\")\n369|\t}\n370|\tsummary.LeaseSequence = sequence\n371|\tpredecessors, err := digestMembers(entry, \"predecessors\")\n372|\tif err != nil {\n373|\t\treturn EventSummary{}, err\n374|\t}\n375|\tsummary.Predecessors = predecessors\n376|\treturn summary, nil\n377|}\n378|\n379|// writeChain stores the index atomically: temp file, fsync, rename, fsync\n380|// the directory. A crash either leaves the previous index or the new one;\n381|// the blobs it names are verified on every load, so neither outcome can\n382|// invent history.\n383|func (repository *Repository) writeChain(directory string, chain storedChain) error {\n384|\tpayload, err := json.Marshal(chainPayload{RecordID: chain.RecordID, Events: chain.Events})\n385|\tif err != nil {\n386|\t\treturn fmt.Errorf(\"encode chain index: %w\", err)\n387|\t}\n388|\treturn writeAtomic(filepath.Join(directory, \"chain.json\"), payload)\n389|}\n390|\n391|// chainPayload is the on-disk shape of the index. EventSummary carries the\n392|// JSON tags so the stored form stays exactly this struct.\n393|type chainPayload struct {\n394|\tRecordID string         `json:\"record_id\"`\n395|\tEvents   []EventSummary `json:\"events\"`\n396|}\n397|\n398|// errDigestDisagreement reports bytes at a digest path that a completed\n399|// read proved different from the installing candidate. It is an internal\n400|// marker, never a refusal: callers attribute it through their own site.\n401|var errDigestDisagreement = errors.New(\"digest path holds disagreeing bytes\")\n402|\n403|// installEventBlob installs one event blob idempotently: identical bytes\n404|// already present are reused, disagreeing bytes are reported for refusal,\n405|// and the no-replace open keeps the install atomic.\n406|func installEventBlob(path string, data []byte) error {\n407|\tif _, err := os.Stat(path); err == nil {\n408|\t\texisting, readErr := os.ReadFile(path)\n409|\t\tif readErr != nil || !bytes.Equal(existing, data) {\n410|\t\t\treturn errDigestDisagreement\n411|\t\t}\n412|\t\treturn nil\n413|\t}\n414|\tif err := writeExclusive(path, data); err != nil {\n415|\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n416|\t}\n417|\treturn nil\n418|}\n419|\n420|// writeExclusive installs bytes at a path that must not exist. The\n421|// no-replace open makes append-only a filesystem property, not a convention.\n422|func writeExclusive(path string, data []byte) error {\n423|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n424|\tif err != nil {\n425|\t\treturn err\n426|\t}\n427|\tif _, err := file.Write(data); err != nil {\n428|\t\t_ = file.Close()\n429|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n430|\t}\n431|\tif err := file.Sync(); err != nil {\n432|\t\t_ = file.Close()\n433|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n434|\t}\n435|\tif err := file.Close(); err != nil {\n436|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n437|\t}\n438|\treturn nil\n439|}\n440|\n441|// writeAtomic replaces a path through a temp file in the same directory:\n442|// staged bytes fsync before the rename, the directory fsyncs after.\n443|func writeAtomic(path string, data []byte) error {\n444|\tstaged, err := os.CreateTemp(filepath.Dir(path), \".ax-chain-stage-\")\n445|\tif err != nil {\n446|\t\treturn fmt.Errorf(\"stage chain index: %w\", err)\n447|\t}\n448|\tstagedPath := staged.Name()\n449|\tfinished := false\n450|\tdefer func() {\n451|\t\tif !finished {\n452|\t\t\t_ = staged.Close()\n453|\t\t\t_ = os.Remove(stagedPath)\n454|\t\t}\n455|\t}()\n456|\tif err := staged.Chmod(0o600); err != nil {\n457|\t\treturn fmt.Errorf(\"mode staged chain index: %w\", err)\n458|\t}\n459|\tif _, err := io.Copy(staged, bytes.NewReader(data)); err != nil {\n460|\t\treturn fmt.Errorf(\"write staged chain index: %w\", err)\n461|\t}\n462|\tif err := staged.Sync(); err != nil {\n463|\t\treturn fmt.Errorf(\"fsync staged chain index: %w\", err)\n464|\t}\n465|\tif err := staged.Close(); err != nil {\n466|\t\treturn fmt.Errorf(\"close staged chain index: %w\", err)\n467|\t}\n468|\tfinished = true\n469|\tif err := os.Rename(stagedPath, path); err != nil {\n470|\t\treturn fmt.Errorf(\"install chain index: %w\", err)\n471|\t}\n472|\treturn syncDirectory(filepath.Dir(path))\n473|}\n474|\n475|// blobFileName maps a validated event digest to its file name. The digest\n476|// passed scalar grammar at decode time; Hex is the owner's rendering.\n477|func blobFileName(eventID string) string {\n478|\tdigest, err := scalar.ParseDigest(eventID)\n479|\tif err != nil {\n480|\t\treturn \"invalid.json\"\n481|\t}\n482|\treturn digest.Hex() + \".json\"\n483|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
