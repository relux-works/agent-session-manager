ersation_uuid\",\n31|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n32|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n33|  \"opaque_identity\": {},\n34|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n35|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n36|  \"extensions\": {}\n37|}`\n38|\n39|// TestSpecIdentityExampleDecodes proves the Section 5.5 example\n40|// passes the production entry point for its provider.\n41|func TestSpecIdentityExampleDecodes(t *testing.T) {\n42|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n43|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n44|\t}\n45|}\n46|\n47|// TestSpecIdentityExampleVerifiesAgainstItsClaimedDigest pins the true\n48|// fact the identity stated bound rests on: VerifyObjectIdentity over the\n49|// pinned Section 5.5 example returns the example's own record_id with nil\n50|// error, so the example IS the true omit-self digest. A bound claiming\n51|// the example is merely illustrative — and justifying skipped attestation\n52|// by it — fails here instead of shipping as a considered decision. The\n53|// assertion is exact (field and digest), never a nil-error-only check\n54|// that would also pass on a vacuous verifier.\n55|func TestSpecIdentityExampleVerifiesAgainstItsClaimedDigest(t *testing.T) {\n56|\tverified, field, err := canonicaljson.VerifyObjectIdentity([]byte(specIdentityExample))\n57|\tif err != nil {\n58|\t\tt.Fatalf(\"VerifyObjectIdentity(spec example): %v\", err)\n59|\t}\n60|\tif field != canonicaljson.SelfRecordID {\n(more lines below)"}}}
