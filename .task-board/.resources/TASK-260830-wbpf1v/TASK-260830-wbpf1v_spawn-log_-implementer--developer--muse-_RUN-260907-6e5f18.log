urn refuse(ErrSequenceRepeat, \"event lease sequence %d repeats chained sequence through %d\", event.leaseSeq, want-1)\n+\t}\n+' '' 1\n+  if run_fail 'TestAppendEventRefusesSequenceRepeat'; then record D2 arm-deletion KILLED 'TestAppendEventRefusesSequenceRepeat'; else record D2 arm-deletion SURVIVED 'repeat test stayed green'; fi\n+  restore\n+\n+  # D3 delete divergent arm\n+  mutate internal/sessrepo/chain.go '\t\tif event.leaseEpoch == tail.LeaseEpoch {\n+\t\t\treturn refuse(ErrDivergentBranch, \"event under lease %s diverges from chain head lease %s at epoch %d\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\n+\t\t}\n+' '' 1\n+  if run_fail 'TestAppendEventPreservesDivergentBranchWithoutApplying'; then record D3 arm-deletion KILLED 'TestAppendEventPreservesDivergentBranchWithoutApplying'; else record D3 arm-deletion SURVIVED 'divergent test stayed green'; fi\n+  restore\n+\n+  # D4 delete idempotent-retry branch\n+  mutate internal/sessrepo/sessrepo.go '\tfor position, existing := range view.chain.Events {\n+\t\tif existing.EventID == event.eventID {\n+\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n+\t\t}\n+\t}\n+' '' 1\n+  if run_fail 'TestAppendEventIdempotentRetry'; then record D4 arm-deletion KILLED 'TestAppendEventIdempotentRetry'; else record D4 arm-deletion SURVIVED 'idempotent test stayed green'; fi\n+  restore\n+\n+  # D5 delete load verify-error arm (effect only; condition keeps vars used)\n+  mutate internal/sessrepo/chain.go '\t\tif err != nil {\n+\t\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)\n+\t\t}' '\t\tif err != nil {\n+\t\t}' 1\n+  if run_fail 'TestLoadRefusesTamperedEventBlob'; then record D5 arm-deletion KILLED 'TestLoadRefusesTamperedEventBlob'; else record D5 arm-deletion SURVIVED 'tampered-blob test stayed green'; fi\n+  restore\n+\n+  # D6 delete load self-field arm\n+  mutate internal/sessrepo/chain.go '\t\tif field != canonicaljson.SelfEventID {\n+\t\t\treturn nil, refuse(ErrChainCorrupt, \"chained event %d for session %s carries self field %q, want event_id\", position, sessionID, string(field))\n+\t\t}' '\t\tif field != canonicaljson.SelfEventID {\n+\t\t}' 1\n+  if run_fail 'TestLoadRefusesProviderIdentityBlobAtEventPath'; then record D6 arm-deletion KILLED 'TestLoadRefusesProviderIdentityBlobAtEventPath'; else record D6 arm-deletion SURVIVED 'provider-identity test stayed green'; fi\n+  restore\n+\n+  # D7 delete load digest arm\n+  mutate internal/sessrepo/chain.go '\t\tif digest.String() != indexed.EventID {\n+\t\t\treturn nil, refuse(ErrChainCorrupt, \"chained event %d for session %s digest %s disagrees with indexed event %s\", position, sessionID, digest.String(), indexed.EventID)\n+\t\t}' '\t\tif digest.String() != indexed.EventID {\n+\t\t}' 1\n+  if run_fail 'TestLoadRefusesSwappedEventBlobs'; then record D7 arm-deletion KILLED 'TestLoadRefusesSwappedEventBlobs'; else record D7 arm-deletion SURVIVED 'swap test stayed green'; fi\n+  restore\n+\n+  # D8 delete record/chain binding check\n+  mutate internal/sessrepo/chain.go '\tif record.recordID != chain.RecordID || record.sessionID != sessionID {\n+\t\treturn nil, refuse(ErrChainCorrupt, \"chain index does not describe stored session record for session %s\", sessionID)\n+\t}\n+' '' 1\n+  if run_fail 'TestLoadRefusesMismatchedSessionBinding|TestLoadRefusesDetachedChainIndexWithReboundPredecessors'; then record D8 arm-deletion KILLED 'binding tests'; else record D8 arm-deletion SURVIVED 'binding tests stayed green'; fi\n+  restore\n+\n+  # D9 delete resume byte-equality guard (effect only)\n+  mutate internal/sessrepo/sessrepo.go '\tif !bytes.Equal(existing, recordJSON) {\n+\t\treturn false, nil\n+\t}' '\tif !bytes.Equal(existing, recordJSON) {\n+\t}' 1\n+  if run_fail 'TestCreateSessionRefusesResumeWithDifferingBytes'; then record D9 arm-deletion KILLED 'TestCreateSessionRefusesResumeWithDifferingBytes'; else record D9 arm-deletion SURVIVED 'resume-collision test stayed green'; fi\n+  restore\n+}\n+\n+gateonly() {\n+  echo \"== census-only and audit-only (behavioral green, full-package red) ==\"\n+  # C1 funnel bypass on the write path, token preserved, behavior identical\n+  mutate internal/sessrepo/chain.go 'return refuse(ErrPredecessorLink, \"first event must link exactly the session record\")' 'return fmt.Errorf(\"%w: first event must link exactly the session record\", ErrPredecessorLink)' 1\n+  if run_pass 'TestAppendEventRefusesFirstPredecessorMismatch'; then\n+    if run_gate_fail; then record C1 census-only KILLED 'behavioral green; full run fails on unrouted funnel bypass'; else record C1 census-only SURVIVED 'full run stayed green'; fi\n+  else\n+    record C1 census-only SURVIVED 'behavioral test reddened (not census-only)'\n+  fi\n+  restore\n+\n+  # C2 funnel bypass on the load path, token preserved, behavior identical\n+  mutate internal/sessrepo/chain.go 'return nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)' 'return nil, fmt.Errorf(\"%w: re-verify chained event %d for session %s: %v\", ErrChainCorrupt, position, sessionID, err)' 1\n+  if run_pass 'TestLoadRefusesTamperedEventBlob'; then\n+    if run_gate_fail; then record C2 census-only KILLED 'behavioral green; full run fails on unrouted funnel bypass'; else record C2 census-only SURVIVED 'full run stayed green'; fi\n+  else\n+    record C2 census-only SURVIVED 'behavioral test reddened (not census-only)'\n+  fi\n+  restore\n+\n+  # A1 unreachable extra refuse site: derived but never exercised\n+  mutate internal/sessrepo/chain.go '\tif record.recordID != chain.RecordID || record.sessionID != sessionID {' '\tif len(chain.Events) < 0 {\n+\t\treturn nil, refuse(ErrChainCorrupt, \"unreachable audit probe\")\n+\t}\n+\tif record.recordID != chain.RecordID || record.sessionID != sessionID {' 1\n+  if run_pass 'TestLoadRefuses