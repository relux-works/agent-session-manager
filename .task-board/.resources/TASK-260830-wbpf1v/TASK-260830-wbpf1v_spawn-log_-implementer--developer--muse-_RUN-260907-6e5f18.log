{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c519","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":231,"recorded_at":1780531400000457,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"call_id":"call_01a07bd8759e7782a45d9e9158ba7881","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3tq4ns/worktree/internal/sessrepo/sessrepo_test.go`.\n(499 line(s) above)\n500|\t_, err := repository.AppendEvent(testSessionID, []byte(`{\"schema\": \"urn:ax:schema:session-event\",`))\n501|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(truncated)\")\n502|}\n503|\n504|func TestAppendEventRefusesForeignSchema(t *testing.T) {\n505|\trepository := openTestRepository(t)\n506|\tcreateTestSession(t, repository)\n507|\t_, err := repository.AppendEvent(testSessionID, []byte(specRecordExample))\n508|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(record)\")\n509|}\n510|\n511|func TestAppendEventRefusesBadMember(t *testing.T) {\n512|\trepository := openTestRepository(t)\n513|\treference := createTestSession(t, repository)\n514|\tvectors := []struct {\n515|\t\tname   string\n516|\t\tmutate func(object map[string]any)\n517|\t}{\n518|\t\t{\"zero sequence\", func(object map[string]any) { object[\"lease_sequence\"] = 0 }},\n519|\t\t{\"unsafe sequence\", func(object map[string]any) { object[\"lease_sequence\"] = uint64(1 << 53) }},\n520|\t\t{\"non-v4 lease\", func(object map[string]any) { object[\"lease_id\"] = testSessionID }},\n521|\t\t{\"missing predecessors\", func(object map[string]any) { delete(object, \"predecessors\") }},\n522|\t\t{\"malformed predecessor\", func(object map[string]any) { object[\"predecessors\"] = []string{\"not-a-digest\"} }},\n523|\t\t{\"missing event type\", func(object map[string]any) { delete(object, \"event_type\") }},\n524|\t}\n525|\tfor _, vector := range vectors {\n526|\t\tt.Run(vector.name, func(t *testing.T) {\n527|\t\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n528|\t\t\tvar object map[string]any\n529|\t\t\tif err := json.Unmarshal(raw, &object); err != nil {\n530|\t\t\t\tt.Fatal(err)\n531|\t\t\t}\n532|\t\t\tvector.mutate(object)\n533|\t\t\tmutated, _ := json.Marshal(object)\n534|\t\t\t_, err := repository.AppendEvent(testSessionID, mutated)\n535|\t\t\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(\"+vector.name+\")\")\n536|\t\t})\n537|\t}\n538|}\n539|\n540|func TestAppendEventRefusesDigestMismatch(t *testing.T) {\n541|\trepository := openTestRepository(t)\n542|\treference := createTestSession(t, repository)\n543|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n544|\ttampered := strings.Replace(string(raw), `\"foreground_idle\":true`, `\"foreground_idle\":false`, 1)\n545|\tif tampered == string(raw) {\n546|\t\tt.Fatal(\"tamper did not apply\")\n547|\t}\n548|\t_, err := repository.AppendEvent(testSessionID, []byte(tampered))\n549|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(tampered)\")\n550|}\n551|\n552|func TestAppendEventRefusesSessionMismatch(t *testing.T) {\n553|\trepository := openTestRepository(t)\n554|\tcreateTestSession(t, repository)\n555|\tforeign := buildEvent(t, eventOptions{sessionID: testSessionIDB, predecessors: []string{\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n556|\t_, err := repository.AppendEvent(testSessionID, foreign)\n557|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(session mismatch)\")\n558|}\n559|\n560|func TestAppendEventRefusesSequenceGap(t *testing.T) {\n561|\tt.Run(\"skipped sequence\", func(t *testing.T) {\n562|\t\trepository := openTestRepository(t)\n563|\t\treference := createTestSession(t, repository)\n564|\t\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n565|\t\tskipped := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 3, eventType: \"session.idle\", payload: idlePayload()})\n566|\t\t_, err := repository.AppendEvent(testSessionID, skipped)\n567|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(skipped)\")\n568|\t})\n569|\tt.Run(\"first sequence past one\", func(t *testing.T) {\n570|\t\trepository := openTestRepository(t)\n571|\t\treference := createTestSession(t, repository)\n572|\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n573|\t\t_, err := repository.AppendEvent(testSessionID, raw)\n574|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(first past one)\")\n575|\t})\n576|\tt.Run(\"successor lease past one\", func(t *testing.T) {\n577|\t\trepository := openTestRepository(t)\n578|\t\treference := createTestSession(t, repository)\n579|\t\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n580|\t\tnext := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 2, leaseID: testLeaseIDB, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n581|\t\t_, err := repository.AppendEvent(testSessionID, next)\n582|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(successor past one)\")\n583|\t})\n584|\tt.Run(\"spec stopped fixture is a gap, not an invalid event\", func(t *testing.T) {\n585|\t\trepository := openTestRepository(t)\n586|\t\tcreateTestSession(t, repository)\n587|\t\tif _, _, err := canonicaljson.VerifyObjectIdentity([]byte(specStoppedExample)); err != nil {\n588|\t\t\tt.Fatalf(\"SPEC event fixture must verify: %v\", err)\n589|\t\t}\n590|\t\t_, err := repository.AppendEvent(testSessionID, []byte(specStoppedExample))\n591|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(spec stopped)\")\n592|\t})\n593|}\n594|\n595|func TestAppendEventRefusesSequenceRepeat(t *testing.T) {\n596|\trepository := openTestRepository(t)\n597|\treference := createTestSession(t, repository)\n598|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n599|\t// A different event at an already chained sequence is a repeat, and the\n600|\t// two-events-at-one-sequence fork the spec forbids.\n601|\trepeat := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n602|\t_, err := repository.AppendEvent(testSessionID, repeat)\n603|\tmustErrorIs(t, err, ErrSequenceRepeat, \"AppendEvent(repeat)\")\n604|\tsecond, _ := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n605|\tstale := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n606|\t_, err = repository.AppendEvent(testSessionID, stale)\n607|\tmustErrorIs(t, err, ErrSequenceRepeat, \"AppendEvent(old sequence)\")\n608|\tevents, err := repository.ListEvents(testSessionID)\n609|\tif err != nil {\n610|\t\tt.Fatal(err)\n611|\t}\n612|\tif len(events) != 2 || events[1].EventID != second.EventID {\n613|\t\tt.Fatalf(\"chain after refused repeats = %+v\", events)\n614|\t}\n615|}\n616|\n617|func TestAppendEventRefusesFirstPredecessorMismatch(t *testing.T) {\n618|\tt.Run(\"unrelated predecessor\", func(t *testing.T) {\n619|\t\trepository := openTestRepository(t)\n620|\t\tcreateTestSession(t, repository)\n621|\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{zeroDigest}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\")})\n622|\t\t_, err := repository.AppendEvent(testSessionID, raw)\n623|\t\tmustErrorIs(t, err, ErrPredecessorLink, \"AppendEvent(unrelated predecessor)\")\n624|\t})\n625|\tt.Run(\"record plus extra predecessor\", func(t *testing.T) {\n626|\t\trepository := openTestRepository(t)\n627|\t\treference := createTestSession(t, repository)\n628|\t\textra := \"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\"\n629|\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID, extra}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n630|\t\t_, err := repository.AppendEvent(testSessionID, raw)\n631|\t\tmustErrorIs(t, err, ErrPredecessorLink, \"AppendEvent(extra predecessor)\")\n632|\t})\n633|}\n634|\n635|func TestAppendEventRefusesLaterPredecessorMismatch(t *testing.T) {\n636|\trepository := openTestRepository(t)\n637|\treference := createTestSession(t, repository)\n638|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n639|\t// The second event must reference the first, not skip back to the record.\n640|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n641|\t_, err := repository.AppendEvent(testSessionID, raw)\n642|\tmustErrorIs(t, err, ErrPredecessorLink, \"AppendEvent(skipped head)\")\n643|}\n644|\n645|func TestAppendEventPreservesDivergentBranchWithoutApplying(t *testing.T) {\n646|\trepository := openTestRepository(t)\n647|\treference := createTestSession(t, repository)\n648|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n649|\t// A same-epoch second lease is the concurrent-takeover fork: its bytes\n650|\t// are preserved in the immutable namespace but never linked into the\n651|\t// authoritative chain.\n652|\tfork := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseIDB, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n653|\t_, err := repository.AppendEvent(testSessionID, fork)\n654|\tmustErrorIs(t, err, ErrDivergentBranch, \"AppendEvent(divergent)\")\n655|\tvar forkID struct {\n656|\t\tEventID string `json:\"event_id\"`\n657|\t}\n658|\tif err := json.Unmarshal(fork, &forkID); err != nil {\n659|\t\tt.Fatal(err)\n660|\t}\n661|\tpreserved, err := os.ReadFile(blobPathFor(t, repository, testSessionID, forkID.EventID))\n662|\tif err != nil {\n663|\t\tt.Fatalf(\"divergent blob was not preserved: %v\", err)\n664|\t}\n665|\tif string(preserved) != string(fork) {\n666|\t\tt.Fatal(\"preserved divergent bytes differ\")\n667|\t}\n668|\tevents, err := repository.ListEvents(testSessionID)\n669|\tif err != nil {\n670|\t\tt.Fatal(err)\n671|\t}\n672|\tif len(events) != 1 {\n673|\t\tt.Fatalf(\"chain after divergent fork = %d events, want 1\", len(events))\n674|\t}\n675|}\n676|\n677|func TestAppendEventRefusesStaleLeaseEpoch(t *testing.T) {\n678|\trepository := openTestRepository(t)\n679|\treference := createTestSession(t, repository)\n680|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n681|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 2, testLeaseIDB, 1, \"session.idle\", idlePayload())\n682|\t// An event from the superseded epoch cannot rejoin the chain.\n683|\tlate := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n684|\t_, err := repository.AppendEvent(testSessionID, late)\n685|\tmustErrorIs(t, err, ErrStaleLease, \"AppendEvent(stale epoch)\")\n686|}\n687|\n688|func TestAppendEventRefusesDisagreeingDigestPathBytes(t *testing.T) {\n689|\trepository := openTestRepository(t)\n690|\treference := createTestSession(t, repository)\n691|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n692|\tnext := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n693|\t// Plant disagreeing bytes at the path the event's digest names, then\n694|\t// append the genuine event: the store must refuse instead of trusting\n695|\t// either copy.\n696|\tvar parsed struct {\n697|\t\tEventID string `json:\"event_id\"`\n698|\t}\n699|\tif err := json.Unmarshal(next, &parsed); err != nil {\n700|\t\tt.Fatal(err)\n701|\t}\n702|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, parsed.EventID), []byte(`{\"forged\":true}`), 0o600); err != nil {\n703|\t\tt.Fatal(err)\n704|\t}\n705|\t_, err := repository.AppendEvent(testSessionID, next)\n706|\tmustErrorIs(t, err, ErrChainCorrupt, \"AppendEvent(disagreeing bytes)\")\n707|\tevents, err := repository.ListEvents(testSessionID)\n708|\tif err != nil {\n709|\t\tt.Fatal(err)\n710|\t}\n711|\tif len(events) != 1 {\n712|\t\tt.Fatalf(\"chain after disagreeing plant = %d events, want 1\", len(events))\n713|\t}\n714|}\n715|\n716|// blobPathFor resolves the content-addressed path of an event blob.\n717|func blobPathFor(t *testing.T, repository *Repository, sessionID, eventID string) string {\n718|\tt.Helper()\n719|\thex, ok := strings.CutPrefix(eventID, \"sha256:\")\n720|\tif !ok {\n721|\t\tt.Fatalf(\"event id %q has no digest prefix\", eventID)\n722|\t}\n723|\treturn filepath.Join(repository.sessionDir(sessionID), \"events\", hex+\".json\")\n724|}\n725|\n726|func TestGetEventLookup(t *testing.T) {\n727|\trepository := openTestRepository(t)\n728|\treference := createTestSession(t, repository)\n729|\tfirst, firstBytes := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n730|\tstored, err := repository.GetEvent(testSessionID, first.EventID)\n731|\tif err != nil {\n732|\t\tt.Fatal(err)\n733|\t}\n734|\tif string(stored) != string(firstBytes) {\n735|\t\tt.Fatal(\"GetEvent bytes differ from appended bytes\")\n736|\t}\n737|\t_, err = repository.GetEvent(testSessionID, \"not-a-digest\")\n738|\tmustErrorIs(t, err, ErrUnknownEvent, \"GetEvent(malformed)\")\n739|\t_, err = repository.GetEvent(testSessionID, zeroDigest)\n740|\tmustErrorIs(t, err, ErrUnknownEvent, \"GetEvent(absent)\")\n741|}\n742|\n743|func TestResolveLocalNameAndUUID(t *testing.T) {\n744|\trepository := openTestRepository(t)\n745|\tcreateTestSession(t, repository)\n746|\tsummary, err := repository.Resolve(\"payments-api\")\n747|\tif err != nil {\n748|\t\tt.Fatalf(\"Resolve(exact) error = %v\", err)\n749|\t}\n750|\tif summary.SessionID != testSessionID {\n751|\t\tt.Fatalf(\"resolved = %q, want %q\", summary.SessionID, testSessionID)\n752|\t}\n753|\t// A case-variant query still routes while the name is unambiguous.\n754|\tvariant, err := repository.Resolve(\"Payments-API\")\n755|\tif err != nil {\n756|\t\tt.Fatalf(\"Resolve(folded) error = %v\", err)\n757|\t}\n758|\tif variant.SessionID != testSessionID {\n759|\t\tt.Fatalf(\"folded resolve = %q\", variant.SessionID)\n760|\t}\n761|\tbyUUID, err := repository.Resolve(testSessionID)\n762|\tif err != nil {\n763|\t\tt.Fatalf(\"Resolve(uuid) error = %v\", err)\n764|\t}\n765|\tif byUUID.RecordID != summary.RecordID {\n766|\t\tt.Fatalf(\"uuid resolve = %+v, want %+v\", byUUID, summary)\n767|\t}\n768|\t_, err = repository.Resolve(\"no-such-session\")\n769|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(absent)\")\n770|\t// A UUID-shaped query with no session is not found, not ambiguous.\n771|\t_, err = repository.Resolve(testSessionIDB)\n772|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(absent uuid)\")\n773|}\n774|\n775|func TestResolveRefusesCaseFoldCollision(t *testing.T) {\n776|\trepository := openTestRepository(t)\n777|\tcreateTestSession(t, repository)\n778|\tother := buildRecord(t, func(object map[string]any) {\n779|\t\tobject[\"session_id\"] = testSessionIDB\n780|\t\tobject[\"subject_id\"] = testSessionIDB\n781|\t\tobject[\"name\"] = \"Payments-API\"\n782|\t})\n783|\tif _, err := repository.CreateSession(other); err != nil {\n784|\t\tt.Fatal(err)\n785|\t}\n786|\t_, err := repository.Resolve(\"payments-api\")\n787|\tmustErrorIs(t, err, ErrNameAmbiguous, \"Resolve(collision)\")\n788|\t_, err = repository.Resolve(\"PAYMENTS-API\")\n789|\tmustErrorIs(t, err, ErrNameAmbiguous, \"Resolve(collision upper)\")\n790|}\n791|\n792|// plantCorruptedSession creates a session with two chained events and\n793|// applies one corruption, returning the repository for a load attempt.\n794|func plantCorruptedSession(t *testing.T, corrupt func(t *testing.T, repository *Repository)) *Repository {\n795|\tt.Helper()\n796|\trepository := openTestRepository(t)\n797|\treference := createTestSession(t, repository)\n798|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n799|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n800|\tcorrupt(t, repository)\n801|\treturn repository\n802|}\n803|\n804|func sessionPaths(t *testing.T, repository *Repository) (directory, chain, record string) {\n805|\tt.Helper()\n806|\tdirectory = repository.sessionDir(testSessionID)\n807|\treturn directory, filepath.Join(directory, \"chain.json\"), filepath.Join(directory, \"record.json\")\n808|}\n809|\n810|func TestLoadRefusesMissingChainIndex(t *testing.T) {\n811|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n812|\t\t_, chain, _ := sessionPaths(t, repository)\n813|\t\tif err := os.Remove(chain); err != nil {\n814|\t\t\tt.Fatal(err)\n815|\t\t}\n816|\t})\n817|\t_, err := repository.GetRecord(testSessionID)\n818|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing chain)\")\n819|}\n820|\n821|func TestLoadRefusesMalformedChainIndex(t *testing.T) {\n822|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n823|\t\t_, chain, _ := sessionPaths(t, repository)\n824|\t\tif err := os.WriteFile(chain, []byte(`{\"record_id\":`), 0o600); err != nil {\n825|\t\t\tt.Fatal(err)\n826|\t\t}\n827|\t})\n828|\t_, err := repository.GetRecord(testSessionID)\n829|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(malformed chain)\")\n830|}\n831|\n832|func TestLoadRefusesMissingRecord(t *testing.T) {\n833|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n834|\t\t_, _, record := sessionPaths(t, repository)\n835|\t\tif err := os.Remove(record); err != nil {\n836|\t\t\tt.Fatal(err)\n837|\t\t}\n838|\t})\n839|\t_, err := repository.GetRecord(testSessionID)\n840|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing record)\")\n841|}\n842|\n843|func TestLoadRefusesTamperedRecord(t *testing.T) {\n844|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n845|\t\t_, _, record := sessionPaths(t, repository)\n846|\t\traw, err := os.ReadFile(record)\n847|\t\tif err != nil {\n848|\t\t\tt.Fatal(err)\n849|\t\t}\n850|\t\ttampered := strings.Replace(string(raw), `\"name\": \"payments-api\"`, `\"name\": \"payments-apj\"`, 1)\n851|\t\tif tampered == string(raw) {\n852|\t\t\tt.Fatal(\"tamper did not apply\")\n853|\t\t}\n854|\t\tif err := os.WriteFile(record, []byte(tampered), 0o600); err != nil {\n855|\t\t\tt.Fatal(err)\n856|\t\t}\n857|\t})\n858|\t_, err := repository.GetRecord(testSessionID)\n859|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(tampered record)\")\n860|}\n861|\n862|func TestLoadRefusesDetachedChainIndex(t *testing.T) {\n863|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n864|\t\t_, chain, _ := sessionPaths(t, repository)\n865|\t\traw, err := os.ReadFile(chain)\n866|\t\tif err != nil {\n867|\t\t\tt.Fatal(err)\n868|\t\t}\n869|\t\tvar index map[string]any\n870|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n871|\t\t\tt.Fatal(err)\n872|\t\t}\n873|\t\tindex[\"record_id\"] = zeroDigest\n874|\t\tout, _ := json.Marshal(index)\n875|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n876|\t\t\tt.Fatal(err)\n877|\t\t}\n878|\t})\n879|\t_, err := repository.GetRecord(testSessionID)\n880|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(detached index)\")\n881|}\n882|\n883|func TestLoadRefusesMissingEventBlob(t *testing.T) {\n884|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n885|\t\tevents, err := repository.ListEvents(testSessionID)\n886|\t\tif err != nil {\n887|\t\t\tt.Fatal(err)\n888|\t\t}\n889|\t\tif err := os.Remove(blobPathFor(t, repository, testSessionID, events[0].EventID)); err != nil {\n890|\t\t\tt.Fatal(err)\n891|\t\t}\n892|\t})\n893|\t_, err := repository.GetRecord(testSessionID)\n894|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing blob)\")\n895|}\n896|\n897|func TestLoadRefusesTamperedEventBlob(t *testing.T) {\n898|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n899|\t\tevents, err := repository.ListEvents(testSessionID)\n900|\t\tif err != nil {\n901|\t\t\tt.Fatal(err)\n902|\t\t}\n903|\t\tpath := blobPathFor(t, repository, testSessionID, events[1].EventID)\n904|\t\traw, err := os.ReadFile(path)\n905|\t\tif err != nil {\n906|\t\t\tt.Fatal(err)\n907|\t\t}\n908|\t\ttampered := strings.Replace(string(raw), `\"foreground_idle\":true`, `\"foreground_idle\":false`, 1)\n909|\t\tif tampered == string(raw) {\n910|\t\t\tt.Fatal(\"tamper did not apply\")\n911|\t\t}\n912|\t\tif err := os.WriteFile(path, []byte(tampered), 0o600); err != nil {\n913|\t\t\tt.Fatal(err)\n914|\t\t}\n915|\t})\n916|\t_, err := repository.GetRecord(testSessionID)\n917|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(tampered blob)\")\n918|}\n919|\n920|func TestLoadRefusesReorderedChainIndex(t *testing.T) {\n921|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n922|\t\t_, chain, _ := sessionPaths(t, repository)\n923|\t\traw, err := os.ReadFile(chain)\n924|\t\tif err != nil {\n925|\t\t\tt.Fatal(err)\n926|\t\t}\n927|\t\tvar index map[string]any\n928|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n929|\t\t\tt.Fatal(err)\n930|\t\t}\n931|\t\tevents := index[\"events\"].([]any)\n932|\t\tif len(events) != 2 {\n933|\t\t\tt.Fatalf(\"planted chain has %d events\", len(events))\n934|\t\t}\n935|\t\tindex[\"events\"] = []any{events[1], events[0]}\n936|\t\tout, _ := json.Marshal(index)\n937|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n938|\t\t\tt.Fatal(err)\n939|\t\t}\n940|\t})\n941|\t_, err := repository.GetRecord(testSessionID)\n942|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(reordered index)\")\n943|}\n944|\n945|func TestLoadRefusesUnknownSession(t *testing.T) {\n946|\trepository := openTestRepository(t)\n947|\t_, err := repository.GetRecord(testSessionID)\n948|\tmustErrorIs(t, err, ErrUnknownSession, \"GetRecord(absent)\")\n949|\t_, err = repository.ListEvents(testSessionID)\n950|\tmustErrorIs(t, err, ErrUnknownSession, \"ListEvents(absent)\")\n951|}\n952|\n953|func TestListSessionsFailsClosedOnCorruptSession(t *testing.T) {\n954|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n955|\t\t_, chain, _ := sessionPaths(t, repository)\n956|\t\tif err := os.WriteFile(chain, []byte(`{\"record_id\":`), 0o600); err != nil {\n957|\t\t\tt.Fatal(err)\n958|\t\t}\n959|\t})\n960|\t_, err := repository.ListSessions()\n961|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListSessions(corrupt)\")\n962|}\n963|\n964|func TestListAndResolveRefuseMissingRoot(t *testing.T) {\n965|\trepository := openTestRepository(t)\n966|\tcreateTestSession(t, repository)\n967|\tif err := os.RemoveAll(repository.root); err != nil {\n968|\t\tt.Fatal(err)\n969|\t}\n970|\t_, err := repository.ListSessions()\n971|\tmustErrorIs(t, err, ErrRepositoryPath, \"ListSessions(missing root)\")\n972|\t_, err = repository.Resolve(\"payments-api\")\n973|\tmustErrorIs(t, err, ErrRepositoryPath, \"Resolve(missing root)\")\n974|}\n975|\n976|// specTaskBoardRecordExample is the verbatim SPEC.md Section 5.1\n977|// task-board normative example: the same Launch Plan shape with the tagged\n978|// task_board variant instead of null.\n979|const specTaskBoardRecordExample = `{\n980|  \"schema\": \"urn:ax:schema:session-record\",\n981|  \"schema_version\": \"1.0.0\",\n982|  \"record_id\": \"sha256:0acd3e31635372e176f8f37b1b74aa0ebdcf2d1e4ac40d43adb8e462079b34a2\",\n983|  \"subject_id\": \"0198f4c8-9f60-7077-8071-1234567890ab\",\n984|  \"session_id\": \"0198f4c8-9f60-7077-8071-1234567890ab\",\n985|  \"name\": \"qwen-investigation\",\n986|  \"kind\": \"task_board\",\n987|  \"created_at\": \"2026-08-19T04:01:00.000Z\",\n988|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n989|  \"provider_id\": \"qwen\",\n990|  \"workspace_group_id\": \"0198f4c8-af70-7188-8172-1234567890ab\",\n991|  \"execution_profile\": \"standard\",\n992|  \"launch_plan\": {\n993|    \"argv\": [\"task-board\", \"qwen\", \"TASK-260819-example\"],\n994|    \"cwd_workspace_id\": \"0198f4c8-b080-7299-8273-1234567890ab\",\n995|    \"cwd_relative\": \".\",\n996|    \"env_names\": [],\n997|    \"env_literals\": {},\n998|    \"contains_secrets\": false,\n999|    \"extensions\": {}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
