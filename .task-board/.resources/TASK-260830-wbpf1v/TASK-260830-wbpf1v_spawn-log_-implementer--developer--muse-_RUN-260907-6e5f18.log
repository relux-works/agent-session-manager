{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc5f","stream":{"kind":"session","id":"01a07bd7-ea64-7de3-8c64-1b85523d9cd7"},"sequence":1162,"recorded_at":1780531400002319,"record_type":"event","durability":"durable","causation_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3e3e40a0-075c-4b56-b191-88a15045a8f9","run_stream":{"kind":"run","id":"3e3e40a0-075c-4b56-b191-88a15045a8f9"},"task_stream":{"kind":"task","id":"0cb54062-f930-454e-bf24-7404d39d539a"},"task_id":"0cb54062-f930-454e-bf24-7404d39d539a","event":{"kind":"output","task_id":"0cb54062-f930-454e-bf24-7404d39d539a","chunk":"edited\nchanged lines: lines 152-156\n--- original\n+++ updated\n@@\n-  # N6 fold stops at T (admits U-Z collisions; vector carries Y)\n-  mutate internal/sessrepo/store.go \"character <= 'Z'\" \"character <= 'T'\" 1\n-  if run_fail 'TestResolveRefusesCaseFoldCollision'; then record N6 narrowing KILLED 'fold admits U-Z collisions; TestResolveRefusesCaseFoldCollision'; else record N6 narrowing SURVIVED 'collision test stayed green'; fi\n-  restore\n-}\n+  # N6 fold stops at T (admits U-Z collisions; vector carries Y)\n+  mutate internal/sessrepo/store.go \"character <= 'Z'\" \"character <= 'T'\" 1\n+  if run_fail 'TestResolveRefusesCaseFoldCollision'; then record N6 narrowing KILLED 'fold admits U-Z collisions; TestResolveRefusesCaseFoldCollision'; else record N6 narrowing SURVIVED 'collision test stayed green'; fi\n+  restore\n+}\n+\n+narrowing_load() {\n+  echo \"== narrowing: load and recovery paths ==\"\n+  # N7 self-field arm admits exactly the record_id class (provider-identity)\n+  mutate internal/sessrepo/chain.go '\t\tif field != canonicaljson.SelfEventID {' '\t\tif field != canonicaljson.SelfEventID && field != canonicaljson.SelfRecordID {' 1\n+  if run_fail 'TestLoadRefusesProviderIdentityBlobAtEventPath'; then record N7 narrowing KILLED 'field arm admits r