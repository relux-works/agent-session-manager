{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c61f","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":362,"recorded_at":1780531400000719,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"call_id":"call_01a07bd4b0d477d0a51c6f1ae4042042","text":"Read text file `internal/sessrepo/census_test.go`.\n(399 line(s) above)\n400|\tif len(failures) != 0 {\n401|\t\tt.Fatalf(\"plant failures = %v\", failures)\n402|\t}\n403|\tif len(unregistered) != 1 || unregistered[0] != \"chain.go:1\" {\n404|\t\tt.Fatalf(\"unregistered = %v, want [chain.go:1]\", unregistered)\n405|\t}\n406|\tif len(orphaned) != 0 {\n407|\t\tt.Fatalf(\"orphaned = %v, want none\", orphaned)\n408|\t}\n409|\tunregistered, orphaned, failures = invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{\"chain.go:1\": {}, \"chain.go:2\": {}})\n410|\tif len(failures) != 0 {\n411|\t\tt.Fatalf(\"plant failures = %v\", failures)\n412|\t}\n413|\tif len(unregistered) != 0 {\n414|\t\tt.Fatalf(\"unregistered = %v, want none\", unregistered)\n415|\t}\n416|\tif len(orphaned) != 1 || orphaned[0] != \"chain.go:2\" {\n417|\t\tt.Fatalf(\"orphaned = %v, want [chain.go:2]\", orphaned)\n418|\t}\n419|\t_, _, failures = invcore.DiffSets(map[string]struct{}{}, map[string]struct{}{})\n420|\tif len(failures) == 0 {\n421|\t\tt.Fatal(\"zero-site derivation passed clean; the harness would bless a blind scan\")\n422|\t}\n423|}\n424|\n425|// sessrepoAliasPlant is one control for the alias audit: wantFailure names\n426|// the fragment a reporting plant must carry, empty for a clean plant.\n427|type sessrepoAliasPlant struct {\n428|\tname        string\n429|\tsource      string\n430|\twantFailure string\n431|}\n432|\n433|func sessrepoAliasPlants() []sessrepoAliasPlant {\n434|\tcanonical := `\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"`\n435|\tscalar := `\"github.com/relux-works/agent-session-manager/internal/scalar\"`\n436|\treturn []sessrepoAliasPlant{\n437|\t\t{\n438|\t\t\tname:        \"direct local call is clean\",\n439|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\treturn refuse(errExample, \\\"no\\\")\\n}\\n\",\n440|\t\t\twantFailure: \"\",\n441|\t\t},\n442|\t\t{\n443|\t\t\tname:        \"import alias direct call resolves by path\",\n444|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\t_, _, _ = cjson.VerifyObjectIdentity(raw)\\n}\\n\",\n445|\t\t\twantFailure: \"\",\n446|\t\t},\n447|\t\t{\n448|\t\t\tname:        \"import alias var binding fails\",\n449|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\tverify := cjson.VerifyObjectIdentity\\n\\t_, _, _ = verify(raw)\\n}\\n\",\n450|\t\t\twantFailure: \"outside direct-call position\",\n451|\t\t},\n452|\t\t{\n453|\t\t\tname:        \"local var binding fails\",\n454|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\tdeny := refuse\\n\\treturn deny(errExample, \\\"no\\\")\\n}\\n\",\n455|\t\t\twantFailure: \"outside direct-call position\",\n456|\t\t},\n457|\t\t{\n458|\t\t\tname:        \"dot import of a watched path fails closed\",\n459|\t\t\tsource:      \"package plant\\nimport . \" + scalar + \"\\nfunc run(value string) {\\n\\t_, _ = ParseDigest(value)\\n}\\n\",\n460|\t\t\twantFailure: \"dot-imports watched path\",\n461|\t\t},\n462|\t\t{\n463|\t\t\tname:        \"shadowed funnel name fails closed\",\n464|\t\t\tsource:      \"package plant\\nfunc run(refuse int) int {\\n\\treturn refuse\\n}\\n\",\n465|\t\t\twantFailure: \"outside direct-call position\",\n466|\t\t},\n467|\t}\n468|}\n469|\n470|// TestCensusAliasPlants drives every control through the production audit\n471|// spec and requires the ledgered outcome. A plant that stops reporting\n472|// fails here by construction.\n473|func TestCensusAliasPlants(t *testing.T) {\n474|\tspec := sessrepoConstructorSpec()\n475|\tfor _, plant := range sessrepoAliasPlants() {\n476|\t\tt.Run(plant.name, func(t *testing.T) {\n477|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n478|\t\t\tif failure != \"\" {\n479|\t\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n480|\t\t\t}\n481|\t\t\tfailures := invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", spec)\n482|\t\t\tif plant.wantFailure == \"\" {\n483|\t\t\t\tif len(failures) != 0 {\n484|\t\t\t\t\tt.Fatalf(\"clean plant reported: %s\", strings.Join(failures, \"; \"))\n485|\t\t\t\t}\n486|\t\t\t\treturn\n487|\t\t\t}\n488|\t\t\tmatched := false\n489|\t\t\tfor _, failure := range failures {\n490|\t\t\t\tif strings.Contains(failure, plant.wantFailure) {\n491|\t\t\t\t\tmatched = true\n492|\t\t\t\t}\n493|\t\t\t}\n494|\t\t\tif !matched {\n495|\t\t\t\tt.Fatalf(\"plant reported %q, want a failure containing %q\", failures, plant.wantFailure)\n496|\t\t\t}\n497|\t\t})\n498|\t}\n499|}\n500|\n501|// TestCensusPlantHarnessFailsClosed proves the plant harness itself is\n502|// fail-closed: an unparseable control is a harness failure, never clean.\n503|func TestCensusPlantHarnessFailsClosed(t *testing.T) {\n504|\t_, _, failure := invcore.ParseSource(\"plant.go\", []byte(\"package plant\\nfunc broken( {\\n\"))\n505|\tif failure == \"\" {\n506|\t\tt.Fatal(\"unparseable control parsed clean; the harness would pass a blind plant\")\n507|\t}\n508|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
