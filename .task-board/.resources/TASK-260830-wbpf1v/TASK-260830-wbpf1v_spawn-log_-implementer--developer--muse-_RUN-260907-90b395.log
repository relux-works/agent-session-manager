{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c763","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":524,"recorded_at":1780531400001043,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"task_stream":{"kind":"task","id":"4173d636-2f30-41be-baa4-049c323cbd32"},"task_id":"4173d636-2f30-41be-baa4-049c323cbd32","event":{"kind":"output","task_id":"4173d636-2f30-41be-baa4-049c323cbd32","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(699 line(s) above)\n700|\t\tt.Fatal(err)\n701|\t}\n702|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, parsed.EventID), []byte(`{\"forged\":true}`), 0o600); err != nil {\n703|\t\tt.Fatal(err)\n704|\t}\n705|\t_, err := repository.AppendEvent(testSessionID, next)\n706|\tmustErrorIs(t, err, ErrChainCorrupt, \"AppendEvent(disagreeing bytes)\")\n707|\tevents, err := repository.ListEvents(testSessionID)\n708|\tif err != nil {\n709|\t\tt.Fatal(err)\n710|\t}\n711|\tif len(events) != 1 {\n712|\t\tt.Fatalf(\"chain after disagreeing plant = %d events, want 1\", len(events))\n713|\t}\n714|}\n715|\n716|// blobPathFor resolves the content-addressed path of an event blob.\n717|func blobPathFor(t *testing.T, repository *Repository, sessionID, eventID string) string {\n718|\tt.Helper()\n719|\thex, ok := strings.CutPrefix(eventID, \"sha256:\")\n720|\tif !ok {\n721|\t\tt.Fatalf(\"event id %q has no digest prefix\", eventID)\n722|\t}\n723|\treturn filepath.Join(repository.sessionDir(sessionID), \"events\", hex+\".json\")\n724|}\n725|\n726|func TestGetEventLookup(t *testing.T) {\n727|\trepository := openTestRepository(t)\n728|\treference := createTestSession(t, repository)\n729|\tfirst, firstBytes := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n730|\tstored, err := repository.GetEvent(testSessionID, first.EventID)\n731|\tif err != nil {\n732|\t\tt.Fatal(err)\n733|\t}\n734|\tif string(stored) != string(firstBytes) {\n735|\t\tt.Fatal(\"GetEvent bytes differ from appended bytes\")\n736|\t}\n737|\t_, err = repository.GetEvent(testSessionID, \"not-a-digest\")\n738|\tmustErrorIs(t, err, ErrUnknownEvent, \"GetEvent(malformed)\")\n739|\t_, err = repository.GetEvent(testSessionID, zeroDigest)\n740|\tmustErrorIs(t, err, ErrUnknownEvent, \"GetEvent(absent)\")\n741|}\n742|\n743|func TestResolveLocalNameAndUUID(t *testing.T) {\n744|\trepository := openTestRepository(t)\n745|\tcreateTestSession(t, repository)\n746|\tsummary, err := repository.Resolve(\"payments-api\")\n747|\tif err != nil {\n748|\t\tt.Fatalf(\"Resolve(exact) error = %v\", err)\n749|\t}\n750|\tif summary.SessionID != testSessionID {\n751|\t\tt.Fatalf(\"resolved = %q, want %q\", summary.SessionID, testSessionID)\n752|\t}\n753|\t// A case-variant query still routes while the name is unambiguous.\n754|\tvariant, err := repository.Resolve(\"Payments-API\")\n755|\tif err != nil {\n756|\t\tt.Fatalf(\"Resolve(folded) error = %v\", err)\n757|\t}\n758|\tif variant.SessionID != testSessionID {\n759|\t\tt.Fatalf(\"folded resolve = %q\", variant.SessionID)\n760|\t}\n761|\tbyUUID, err := repository.Resolve(testSessionID)\n762|\tif err != nil {\n763|\t\tt.Fatalf(\"Resolve(uuid) error = %v\", err)\n764|\t}\n765|\tif byUUID.RecordID != summary.RecordID {\n766|\t\tt.Fatalf(\"uuid resolve = %+v, want %+v\", byUUID, summary)\n767|\t}\n768|\t_, err = repository.Resolve(\"no-such-session\")\n769|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(absent)\")\n770|\t// A UUID-shaped query with no session is not found, not ambiguous.\n771|\t_, err = repository.Resolve(testSessionIDB)\n772|\tmustErrorIs(t, err, ErrNameNotFound, \"Resolve(absent uuid)\")\n773|}\n774|\n775|func TestResolveRefusesCaseFoldCollision(t *testing.T) {\n776|\trepository := openTestRepository(t)\n777|\tcreateTestSession(t, repository)\n778|\tother := buildRecord(t, func(object map[string]any) {\n779|\t\tobject[\"session_id\"] = testSessionIDB\n780|\t\tobject[\"subject_id\"] = testSessionIDB\n781|\t\tobject[\"name\"] = \"Payments-API\"\n782|\t})\n783|\tif _, err := repository.CreateSession(other); err != nil {\n784|\t\tt.Fatal(err)\n785|\t}\n786|\t_, err := repository.Resolve(\"payments-api\")\n787|\tmustErrorIs(t, err, ErrNameAmbiguous, \"Resolve(collision)\")\n788|\t_, err = repository.Resolve(\"PAYMENTS-API\")\n789|\tmustErrorIs(t, err, ErrNameAmbiguous, \"Resolve(collision upper)\")\n790|}\n791|\n792|// plantCorruptedSession creates a session with two chained events and\n793|// applies one corruption, returning the repository for a load attempt.\n794|func plantCorruptedSession(t *testing.T, corrupt func(t *testing.T, repository *Repository)) *Repository {\n795|\tt.Helper()\n796|\trepository := openTestRepository(t)\n797|\treference := createTestSession(t, repository)\n798|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n799|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n800|\tcorrupt(t, repository)\n801|\treturn repository\n802|}\n803|\n804|func sessionPaths(t *testing.T, repository *Repository) (directory, chain, record string) {\n805|\tt.Helper()\n806|\tdirectory = repository.sessionDir(testSessionID)\n807|\treturn directory, filepath.Join(directory, \"chain.json\"), filepath.Join(directory, \"record.json\")\n808|}\n809|\n810|func TestLoadRefusesMissingChainIndex(t *testing.T) {\n811|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n812|\t\t_, chain, _ := sessionPaths(t, repository)\n813|\t\tif err := os.Remove(chain); err != nil {\n814|\t\t\tt.Fatal(err)\n815|\t\t}\n816|\t})\n817|\t_, err := repository.GetRecord(testSessionID)\n818|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing chain)\")\n819|}\n820|\n821|func TestLoadRefusesMalformedChainIndex(t *testing.T) {\n822|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n823|\t\t_, chain, _ := sessionPaths(t, repository)\n824|\t\tif err := os.WriteFile(chain, []byte(`{\"record_id\":`), 0o600); err != nil {\n825|\t\t\tt.Fatal(err)\n826|\t\t}\n827|\t})\n828|\t_, err := repository.GetRecord(testSessionID)\n829|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(malformed chain)\")\n830|}\n831|\n832|func TestLoadRefusesMissingRecord(t *testing.T) {\n833|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n834|\t\t_, _, record := sessionPaths(t, repository)\n835|\t\tif err := os.Remove(record); err != nil {\n836|\t\t\tt.Fatal(err)\n837|\t\t}\n838|\t})\n839|\t_, err := repository.GetRecord(testSessionID)\n840|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing record)\")\n841|}\n842|\n843|func TestLoadRefusesTamperedRecord(t *testing.T) {\n844|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n845|\t\t_, _, record := sessionPaths(t, repository)\n846|\t\traw, err := os.ReadFile(record)\n847|\t\tif err != nil {\n848|\t\t\tt.Fatal(err)\n849|\t\t}\n850|\t\ttampered := strings.Replace(string(raw), `\"name\": \"payments-api\"`, `\"name\": \"payments-apj\"`, 1)\n851|\t\tif tampered == string(raw) {\n852|\t\t\tt.Fatal(\"tamper did not apply\")\n853|\t\t}\n854|\t\tif err := os.WriteFile(record, []byte(tampered), 0o600); err != nil {\n855|\t\t\tt.Fatal(err)\n856|\t\t}\n857|\t})\n858|\t_, err := repository.GetRecord(testSessionID)\n859|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(tampered record)\")\n860|}\n861|\n862|func TestLoadRefusesDetachedChainIndex(t *testing.T) {\n863|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n864|\t\t_, chain, _ := sessionPaths(t, repository)\n865|\t\traw, err := os.ReadFile(chain)\n866|\t\tif err != nil {\n867|\t\t\tt.Fatal(err)\n868|\t\t}\n869|\t\tvar index map[string]any\n870|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n871|\t\t\tt.Fatal(err)\n872|\t\t}\n873|\t\tindex[\"record_id\"] = zeroDigest\n874|\t\tout, _ := json.Marshal(index)\n875|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n876|\t\t\tt.Fatal(err)\n877|\t\t}\n878|\t})\n879|\t_, err := repository.GetRecord(testSessionID)\n880|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(detached index)\")\n881|}\n882|\n883|func TestLoadRefusesMissingEventBlob(t *testing.T) {\n884|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n885|\t\tevents, err := repository.ListEvents(testSessionID)\n886|\t\tif err != nil {\n887|\t\t\tt.Fatal(err)\n888|\t\t}\n889|\t\tif err := os.Remove(blobPathFor(t, repository, testSessionID, events[0].EventID)); err != nil {\n890|\t\t\tt.Fatal(err)\n891|\t\t}\n892|\t})\n893|\t_, err := repository.GetRecord(testSessionID)\n894|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing blob)\")\n895|}\n896|\n897|func TestLoadRefusesTamperedEventBlob(t *testing.T) {\n898|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n899|\t\tevents, err := repository.ListEvents(testSessionID)\n900|\t\tif err != nil {\n901|\t\t\tt.Fatal(err)\n902|\t\t}\n903|\t\tpath := blobPathFor(t, repository, testSessionID, events[1].EventID)\n904|\t\traw, err := os.ReadFile(path)\n905|\t\tif err != nil {\n906|\t\t\tt.Fatal(err)\n907|\t\t}\n908|\t\ttampered := strings.Replace(string(raw), `\"foreground_idle\":true`, `\"foreground_idle\":false`, 1)\n909|\t\tif tampered == string(raw) {\n910|\t\t\tt.Fatal(\"tamper did not apply\")\n911|\t\t}\n912|\t\tif err := os.WriteFile(path, []byte(tampered), 0o600); err != nil {\n913|\t\t\tt.Fatal(err)\n914|\t\t}\n915|\t})\n916|\t_, err := repository.GetRecord(testSessionID)\n917|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(tampered blob)\")\n918|}\n919|\n920|func TestLoadRefusesReorderedChainIndex(t *testing.T) {\n921|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n922|\t\t_, chain, _ := sessionPaths(t, repository)\n923|\t\traw, err := os.ReadFile(chain)\n924|\t\tif err != nil {\n925|\t\t\tt.Fatal(err)\n926|\t\t}\n927|\t\tvar index map[string]any\n928|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n929|\t\t\tt.Fatal(err)\n930|\t\t}\n931|\t\tevents := index[\"events\"].([]any)\n932|\t\tif len(events) != 2 {\n933|\t\t\tt.Fatalf(\"planted chain has %d events\", len(events))\n934|\t\t}\n935|\t\tindex[\"events\"] = []any{events[1], events[0]}\n936|\t\tout, _ := json.Marshal(index)\n937|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n938|\t\t\tt.Fatal(err)\n939|\t\t}\n940|\t})\n941|\t_, err := repository.GetRecord(testSessionID)\n942|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(reordered index)\")\n943|}\n944|\n945|func TestLoadRefusesUnknownSession(t *testing.T) {\n946|\trepository := openTestRepository(t)\n947|\t_, err := repository.GetRecord(testSessionID)\n948|\tmustErrorIs(t, err, ErrUnknownSession, \"GetRecord(absent)\")\n949|\t_, err = repository.ListEvents(testSessionID)\n950|\tmustErrorIs(t, err, ErrUnknownSession, \"ListEvents(absent)\")\n951|}\n952|\n953|func TestListSessionsFailsClosedOnCorruptSession(t *testing.T) {\n954|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n955|\t\t_, chain, _ := sessionPaths(t, repository)\n956|\t\tif err := os.WriteFile(chain, []byte(`{\"record_id\":`), 0o600); err != nil {\n957|\t\t\tt.Fatal(err)\n958|\t\t}\n959|\t})\n960|\t_, err := repository.ListSessions()\n961|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListSessions(corrupt)\")\n962|}\n963|\n964|func TestListAndResolveRefuseMissingRoot(t *testing.T) {\n965|\trepository := openTestRepository(t)\n966|\tcreateTestSession(t, repository)\n967|\tif err := os.RemoveAll(repository.root); err != nil {\n968|\t\tt.Fatal(err)\n969|\t}\n970|\t_, err := repository.ListSessions()\n971|\tmustErrorIs(t, err, ErrRepositoryPath, \"ListSessions(missing root)\")\n972|\t_, err = repository.Resolve(\"payments-api\")\n973|\tmustErrorIs(t, err, ErrRepositoryPath, \"Resolve(missing root)\")\n974|}\n975|\n976|// specTaskBoardRecordExample is the verbatim SPEC.md Section 5.1\n977|// task-board normative example: the same Launch Plan shape with the tagged\n978|// task_board variant instead of null.\n979|const specTaskBoardRecordExample = `{\n980|  \"schema\": \"urn:ax:schema:session-record\",\n981|  \"schema_version\": \"1.0.0\",\n982|  \"record_id\": \"sha256:0acd3e31635372e176f8f37b1b74aa0ebdcf2d1e4ac40d43adb8e462079b34a2\",\n983|  \"subject_id\": \"0198f4c8-9f60-7077-8071-1234567890ab\",\n984|  \"session_id\": \"0198f4c8-9f60-7077-8071-1234567890ab\",\n985|  \"name\": \"qwen-investigation\",\n986|  \"kind\": \"task_board\",\n987|  \"created_at\": \"2026-08-19T04:01:00.000Z\",\n988|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n989|  \"provider_id\": \"qwen\",\n990|  \"workspace_group_id\": \"0198f4c8-af70-7188-8172-1234567890ab\",\n991|  \"execution_profile\": \"standard\",\n992|  \"launch_plan\": {\n993|    \"argv\": [\"task-board\", \"qwen\", \"TASK-260819-example\"],\n994|    \"cwd_workspace_id\": \"0198f4c8-b080-7299-8273-1234567890ab\",\n995|    \"cwd_relative\": \".\",\n996|    \"env_names\": [],\n997|    \"env_literals\": {},\n998|    \"contains_secrets\": false,\n999|    \"extensions\": {}\n1000|  },\n1001|  \"task_board\": {\n1002|    \"bridge_protocol_version\": \"1.0.0\",\n1003|    \"board\": {\n1004|      \"kind\": \"local\",\n1005|      \"logical_id\": \"agent-session-manager-spec\",\n1006|      \"remote_url\": null,\n1007|      \"extensions\": {}\n1008|    },\n1009|    \"task_element_id\": \"TASK-260819-example\",\n1010|    \"launch_mode\": \"tracked_prompt\",\n1011|    \"manager_session_ref\": null,\n1012|    \"board_goal\": null,\n1013|    \"native_goal_binding\": \"prompt\",\n1014|    \"extensions\": {}\n1015|  },\n1016|  \"fork_provenance\": null,\n1017|  \"extensions\": {}\n1018|}`\n1019|\n1020|func TestBothRecordKindsCoexist(t *testing.T) {\n1021|\trepository := openTestRepository(t)\n1022|\tdirect := createTestSession(t, repository)\n1023|\tboard, err := repository.CreateSession([]byte(specTaskBoardRecordExample))\n1024|\tif err != nil {\n1025|\t\tt.Fatalf(\"CreateSession(task_board SPEC record) error = %v\", err)\n1026|\t}\n1027|\tif board.RecordID != \"sha256:0acd3e31635372e176f8f37b1b74aa0ebdcf2d1e4ac40d43adb8e462079b34a2\" {\n1028|\t\tt.Fatalf(\"task_board RecordID = %q, want the SPEC example digest\", board.RecordID)\n1029|\t}\n1030|\tconst boardSession = \"0198f4c8-9f60-7077-8071-1234567890ab\"\n1031|\tfirst, _ := appendTestEvent(t, repository, boardSession, []string{board.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(board.RecordID))\n1032|\tif first.Position != 0 {\n1033|\t\tt.Fatalf(\"task_board chain ref = %+v\", first)\n1034|\t}\n1035|\tsummaries, err := repository.ListSessions()\n1036|\tif err != nil {\n1037|\t\tt.Fatal(err)\n1038|\t}\n1039|\tif len(summaries) != 2 {\n1040|\t\tt.Fatalf(\"sessions = %d, want 2\", len(summaries))\n1041|\t}\n1042|\tbyKind := map[string]SessionSummary{}\n1043|\tfor _, summary := range summaries {\n1044|\t\tbyKind[summary.Kind] = summary\n1045|\t}\n1046|\tif byKind[\"direct\"].SessionID != direct.SessionID || byKind[\"task_board\"].SessionID != boardSession {\n1047|\t\tt.Fatalf(\"kinds = %+v\", summaries)\n1048|\t}\n1049|\tif byKind[\"task_board\"].ProviderID != \"qwen\" || byKind[\"task_board\"].EventCount != 1 {\n1050|\t\tt.Fatalf(\"task_board summary = %+v\", byKind[\"task_board\"])\n1051|\t}\n1052|\tresolved, err := repository.Resolve(\"qwen-investigation\")\n1053|\tif err != nil {\n1054|\t\tt.Fatalf(\"Resolve(task_board name) error = %v\", err)\n1055|\t}\n1056|\tif resolved.SessionID != boardSession {\n1057|\t\tt.Fatalf(\"resolved = %q, want %q\", resolved.SessionID, boardSession)\n1058|\t}\n1059|}\n1060|\n1061|func TestCreateSessionResumesInterruptedCreate(t *testing.T) {\n1062|\trepository := openTestRepository(t)\n1063|\t// Simulate a crash between the record write and the chain write: the\n1064|\t// record is durable, the index is absent.\n1065|\tdirectory := repository.sessionDir(testSessionID)\n1066|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n1067|\t\tt.Fatal(err)\n1068|\t}\n1069|\tif err := os.WriteFile(filepath.Join(directory, \"record.json\"), []byte(specRecordExample), 0o600); err != nil {\n1070|\t\tt.Fatal(err)\n1071|\t}\n1072|\treference, err := repository.CreateSession([]byte(specRecordExample))\n1073|\tif err != nil {\n1074|\t\tt.Fatalf(\"resumed CreateSession error = %v\", err)\n1075|\t}\n1076|\tif reference.SessionID != testSessionID {\n1077|\t\tt.Fatalf(\"resumed SessionID = %q\", reference.SessionID)\n1078|\t}\n1079|\tstored, err := repository.GetRecord(testSessionID)\n1080|\tif err != nil {\n1081|\t\tt.Fatal(err)\n1082|\t}\n1083|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n1084|\t\tt.Fatal(\"resumed record differs\")\n1085|\t}\n1086|\t// A resumed-then-completed create is terminal: the next create refuses.\n1087|\t_, err = repository.CreateSession([]byte(specRecordExample))\n1088|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(after resume)\")\n1089|}"}}}
