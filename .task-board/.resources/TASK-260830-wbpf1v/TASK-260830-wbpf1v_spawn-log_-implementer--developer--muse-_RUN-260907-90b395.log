{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e9","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":335,"recorded_at":1780531400000665,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"call_id":"call_01a07bd4a9987a3380945b0aec5bae9f","text":"Read text file `internal/sessrepo/census_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n17|)\n18|\n19|// This file is the sessrepo refusal census. Every rejection in this package\n20|// funnels through the refuse var, and the census derives its denominator\n21|// from production source instead of listing it: a new refuse call without a\n22|// boundary-driven negative path fails the gate, and a row without a site\n23|// fails too. The gate has three halves:\n24|//\n25|//  1. Static derivation: every direct refuse(SENTINEL, ...) call in the\n26|//     production files is derived as file:line with its sentinel. Calls\n27|//     must sit on a single line with a bare sentinel identifier, or the\n28|//     derivation fails closed.\n29|//  2. Runtime recording: TestMain wraps the refuse var, attributing each\n30|//     exercised refusal to its production file:line plus the sentinel it\n31|//     carried, and whether a production boundary entry (Open,\n32|//     CreateSession, AppendEvent, GetRecord, GetEvent, ListEvents,\n33|//     ListSessions, Resolve) is on the stack. A direct helper call proves\n34|//     the helper refuses and nothing about the boundary, so only\n35|//     boundary-driven sites count.\n36|//  3. Alias audit: every refuse reference outside direct-call position,\n37|//     and every import-aliased or var-bound reference to the watched owner\n38|//     delegations, fails through invcore.AuditConstructorReferences, with\n39|//     the funnel's own declaration allowlisted by derived position.\n40|//\n41|// Control plants below prove each half fails closed, including an import\n42|// alias and a var binding in both the passing and the failing direction.\n43|var sessrepoRefusalRecorder = invcore.NewSiteRecorder()\n44|\n45|var sessrepoBoundarySites = map[string]struct{}{}\n46|\n47|var sessrepoBoundaryMarkers = []string{\n48|\t\"sessrepo.Open\",\n49|\t\").CreateSession\",\n50|\t\").AppendEvent\",\n51|\t\").GetRecord\",\n52|\t\").GetEvent\",\n53|\t\").ListEvents\",\n54|\t\").ListSessions\",\n55|\t\").Resolve\",\n56|}\n57|\n58|func TestMain(main *testing.M) {\n59|\toriginal := refuse\n60|\trefuse = func(sentinel error, format string, arguments ...any) error {\n61|\t\terr := original(sentinel, format, arguments...)\n62|\t\tsessrepoRefusalRecorder.Record(sentinel.Error(), 1)\n63|\t\tif beneathSessrepoBoundary() {\n64|\t\t\tif site := callerSessrepoSite(); site != \"\" {\n65|\t\t\t\tsessrepoBoundarySites[site] = struct{}{}\n66|\t\t\t}\n67|\t\t}\n68|\t\treturn err\n69|\t}\n70|\tcode := main.Run()\n71|\tif code == 0 && fullSessrepoPackageTestRun() {\n72|\t\tif failures := auditSessrepoRefusals(); len(failures) != 0 {\n73|\t\t\tfor _, failure := range failures {\n74|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n75|\t\t\t}\n76|\t\t\tcode = 1\n77|\t\t}\n78|\t}\n79|\tos.Exit(code)\n80|}\n81|\n82|func fullSessrepoPackageTestRun() bool {\n83|\tselected := flag.Lookup(\"test.run\")\n84|\treturn selected == nil || selected.Value.String() == \"\"\n85|}\n86|\n87|// callerSessrepoSite reports the production file:line of the refuse call\n88|// site: the wrapper calls this helper, so skip lands past Callers, this\n89|// helper, and the wrapper, on the production line that refused.\n90|func callerSessrepoSite() string {\n91|\tframes := make([]uintptr, 4)\n92|\tif count := runtime.Callers(3, frames); count == 0 {\n93|\t\treturn \"\"\n94|\t}\n95|\tlocated := runtime.CallersFrames(frames)\n96|\tframe, _ := located.Next()\n97|\tif frame.Function == \"\" {\n98|\t\treturn \"\"\n99|\t}\n100|\treturn filepath.Base(frame.File) + \":\" + strconv.Itoa(frame.Line)\n101|}\n102|\n103|func beneathSessrepoBoundary() bool {\n104|\tframes := make([]uintptr, 64)\n105|\tfor {\n106|\t\tcount := runtime.Callers(2, frames)\n107|\t\tlocated := runtime.CallersFrames(frames[:count])\n108|\t\tfor range frames[:count] {\n109|\t\t\tframe, _ := located.Next()\n110|\t\t\tfor _, marker := range sessrepoBoundaryMarkers {\n111|\t\t\t\tif strings.Contains(frame.Function, marker) {\n112|\t\t\t\t\treturn true\n113|\t\t\t\t}\n114|\t\t\t}\n115|\t\t}\n116|\t\tif count < len(frames) {\n117|\t\t\treturn false\n118|\t\t}\n119|\t\tframes = make([]uintptr, 2*len(frames))\n120|\t}\n121|}\n122|\n123|// auditSessrepoRefusals derives the expected inventory from production AST\n124|// and requires the exercised sets to match it in both directions, the alias\n125|// audit to be clean, and the observed sentinel set to equal the derived\n126|// sentinel roster exactly.\n127|func auditSessrepoRefusals() []string {\n128|\tfiles, fileSet, failures := invcore.ScanProduction(\".\")\n129|\tif len(failures) != 0 {\n130|\t\treturn failures\n131|\t}\n132|\tderived, sentinels, sentinelNames, derivationFailures := deriveSessrepoRefusalSites(files, fileSet)\n133|\tfailures = append(failures, derivationFailures...)\n134|\taliasFailures := auditSessrepoAliases(files, fileSet)\n135|\tfailures = append(failures, aliasFailures...)\n136|\tfailures = append(failures, auditSessrepoUnrouted(files, fileSet, sentinelNames)...)\n137|\tderivedSet := make(map[string]struct{}, len(derived))\n138|\tfor _, site := range derived {\n139|\t\tderivedSet[site.key()] = struct{}{}\n140|\t}\n141|\tunregistered, orphaned, diffFailures := invcore.DiffSets(derivedSet, sessrepoRefusalRecorder.Sites())\n142|\tfor _, failure := range diffFailures {\n143|\t\tfailures = append(failures, \"sessrepo refusal census: \"+failure)\n144|\t}\n145|\tfor _, site := range unregistered {\n146|\t\tfailures = append(failures, \"sessrepo refusal site without an exercised negative path: \"+site)\n147|\t}\n148|\tfor _, site := range orphaned {\n149|\t\tfailures = append(failures, \"sessrepo exercised refusal outside the derived inventory: \"+site)\n150|\t}\n151|\tvar missingBoundary []string\n152|\tfor _, site := range derived {\n153|\t\tif _, ok := sessrepoBoundarySites[site.key()]; !ok {\n154|\t\t\tmissingBoundary = append(missingBoundary, site.key())\n155|\t\t}\n156|\t}\n157|\tsort.Strings(missingBoundary)\n158|\tif len(missingBoundary) != 0 {\n159|\t\tfailures = append(failures, \"sessrepo refusal sites never reached beneath a production boundary entry (a direct helper call does not prove the production effect): \"+strings.Join(missingBoundary, \", \"))\n160|\t}\n161|\tvar extraBoundary []string\n162|\tfor site := range sessrepoBoundarySites {\n163|\t\tif _, ok := derivedSet[site]; !ok {\n164|\t\t\textraBoundary = append(extraBoundary, site)\n165|\t\t}\n166|\t}\n167|\tsort.Strings(extraBoundary)\n168|\tif len(extraBoundary) != 0 {\n169|\t\tfailures = append(failures, \"sessrepo boundary-exercised sites outside the derived inventory: \"+strings.Join(extraBoundary, \", \"))\n170|\t}\n171|\twantCodes := make([]string, 0, len(sentinels))\n172|\tfor code := range sentinels {\n173|\t\twantCodes = append(wantCodes, code)\n174|\t}\n175|\tsort.Strings(wantCodes)\n176|\tgotCodes := sessrepoRefusalRecorder.Codes()\n177|\tif fmt.Sprintf(\"%v\", gotCodes) != fmt.Sprintf(\"%v\", wantCodes) {\n178|\t\tfailures = append(failures, fmt.Sprintf(\"sessrepo observed refusal codes = %v, want closed roster %v\", gotCodes, wantCodes))\n179|\t}\n180|\treturn failures\n181|}\n182|\n183|// sessrepoRefusalSite is one derived call site with its sentinel.\n184|type sessrepoRefusalSite struct {\n185|\tfile     string\n186|\tline     int\n187|\tsentinel string\n188|}\n189|\n190|func (site sessrepoRefusalSite) key() string {\n191|\treturn site.file + \":\" + strconv.Itoa(site.line)\n192|}\n193|\n194|// deriveSessrepoRefusalSites derives every direct refuse(SENTINEL, ...)\n195|// call in the production files plus the closed sentinel roster. The roster\n196|// derives from package-level Err* vars initialized with errors.New, so a\n197|// new sentinel without a refusal — or a refusal carrying an undeclared\n198|// sentinel — fails the gate. Sentinel names feed the unrouted-refusal\n199|// audit; sentinel texts feed the observed-code audit.\n200|func deriveSessrepoRefusalSites(files []invcore.ProductionFile, fileSet *token.FileSet) ([]sessrepoRefusalSite, map[string]struct{}, map[string]struct{}, []string) {\n201|\tvar sites []sessrepoRefusalSite\n202|\tsentinels := map[string]struct{}{}\n203|\tsentinelNames := map[string]struct{}{}\n204|\tvar failures []string\n205|\tfor _, production := range files {\n206|\t\tfor _, declaration := range production.Syntax.Decls {\n207|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n208|\t\t\tif !ok || general.Tok != token.VAR {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\tfor _, specification := range general.Specs {\n212|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n213|\t\t\t\tif !ok {\n214|\t\t\t\t\tcontinue\n215|\t\t\t\t}\n216|\t\t\t\tfor index, name := range value.Names {\n217|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Err\") || index >= len(value.Values) {\n218|\t\t\t\t\t\tcontinue\n219|\t\t\t\t\t}\n220|\t\t\t\t\tcall, ok := value.Values[index].(*ast.CallExpr)\n221|\t\t\t\t\tif !ok {\n222|\t\t\t\t\t\tcontinue\n223|\t\t\t\t\t}\n224|\t\t\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n225|\t\t\t\t\tif !ok || selector.Sel.Name != \"New\" {\n226|\t\t\t\t\t\tcontinue\n227|\t\t\t\t\t}\n228|\t\t\t\t\treceiver, ok := selector.X.(*ast.Ident)\n229|\t\t\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n230|\t\t\t\t\t\tcontinue\n231|\t\t\t\t\t}\n232|\t\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n233|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n234|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\" is not an errors.New string literal\")\n235|\t\t\t\t\t\tcontinue\n236|\t\t\t\t\t}\n237|\t\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n238|\t\t\t\t\tif err != nil {\n239|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\": \"+err.Error())\n240|\t\t\t\t\t\tcontinue\n241|\t\t\t\t\t}\n242|\t\t\t\t\tsentinels[text] = struct{}{}\n243|\t\t\t\t\tsentinelNames[name.Name] = struct{}{}\n244|\t\t\t\t}\n245|\t\t\t}\n246|\t\t}\n247|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n248|\t\t\tcall, ok := node.(*ast.CallExpr)\n249|\t\t\tif !ok {\n250|\t\t\t\treturn true\n251|\t\t\t}\n252|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n253|\t\t\tif !ok || identifier.Name != \"refuse\" || len(call.Args) < 1 {\n254|\t\t\t\treturn true\n255|\t\t\t}\n256|\t\t\tposition := fileSet.Position(identifier.Pos())\n257|\t\t\tif !position.IsValid() {\n258|\t\t\t\tfailures = append(failures, production.Name+\": refuse call at an invalid position\")\n259|\t\t\t\treturn true\n260|\t\t\t}\n261|\t\t\tif end := fileSet.Position(call.End()); end.Line != position.Line {\n262|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse call spans several lines; the runtime site and the parsed site would disagree\")\n263|\t\t\t\treturn true\n264|\t\t\t}\n265|\t\t\tsentinel, ok := call.Args[0].(*ast.Ident)\n266|\t\t\tif !ok {\n267|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse sentinel is not a bare identifier; the extractor cannot see through indirection\")\n268|\t\t\t\treturn true\n269|\t\t\t}\n270|\t\t\tsites = append(sites, sessrepoRefusalSite{file: production.Name, line: position.Line, sentinel: sentinel.Name})\n271|\t\t\treturn true\n272|\t\t})\n273|\t}\n274|\tif len(sites) == 0 {\n275|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sites; the scanner is blind, not the package empty\")\n276|\t}\n277|\tif len(sentinels) == 0 {\n278|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sentinels; the roster extractor is blind\")\n279|\t}\n280|\treturn sites, sentinels, sentinelNames, failures\n281|}\n282|\n283|// auditSessrepoUnrouted fails every fmt.Errorf call that wraps a package\n284|// sentinel outside the refuse funnel. A routed refusal and an identical\n285|// direct wrap behave the same, so without this half a bypassed funnel\n286|// passes the behavioral suite and the site inventory together.\n287|func auditSessrepoUnrouted(files []invcore.ProductionFile, fileSet *token.FileSet, sentinelNames map[string]struct{}) []string {\n288|\tvar unrouted []string\n289|\tfor _, production := range files {\n290|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n291|\t\t\tcall, ok := node.(*ast.CallExpr)\n292|\t\t\tif !ok {\n293|\t\t\t\treturn true\n294|\t\t\t}\n295|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n296|\t\t\tif !ok || selector.Sel.Name != \"Errorf\" {\n297|\t\t\t\treturn true\n298|\t\t\t}\n299|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n300|\t\t\tif !ok || receiver.Name != \"fmt\" {\n301|\t\t\t\treturn true\n302|\t\t\t}\n303|\t\t\tfor _, argument := range call.Args {\n304|\t\t\t\tidentifier, ok := argument.(*ast.Ident)\n305|\t\t\t\tif !ok {\n306|\t\t\t\t\tcontinue\n307|\t\t\t\t}\n308|\t\t\t\tif _, watched := sentinelNames[identifier.Name]; watched {\n309|\t\t\t\t\tposition := fileSet.Position(call.Pos())\n310|\t\t\t\t\tunrouted = append(unrouted, production.Name+\":\"+strconv.Itoa(position.Line))\n311|\t\t\t\t}\n312|\t\t\t}\n313|\t\t\treturn true\n314|\t\t})\n315|\t}\n316|\tsort.Strings(unrouted)\n317|\tif len(unrouted) == 0 {\n318|\t\treturn nil\n319|\t}\n320|\treturn []string{\"sessrepo refusals raised outside the refuse funnel (the derived inventory cannot require a negative path for them): \" + strings.Join(unrouted, \", \")}\n321|}\n322|\n323|// sessrepoConstructorSpec is the alias-audit policy: the local funnel must\n324|// stay a direct call, and the watched owner delegations must stay direct\n325|// qualified calls resolved by import path, so neither an import alias nor\n326|// a var binding can hide a refusal or a delegation.\n327|func sessrepoConstructorSpec() invcore.ConstructorSpec {\n328|\treturn invcore.ConstructorSpec{\n329|\t\tLocal: map[string]bool{\"refuse\": true},\n330|\t\tQualified: map[string]map[string]bool{\n331|\t\t\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\": {\"VerifyObjectIdentity\": true},\n332|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\":       {\"DecodeStrictObject\": true, \"CheckUUIDv7\": true, \"CheckUint53Bounds\": true},\n333|\t\t\t\"github.com/relux-works/agent-session-manager/internal/scalar\":        {\"ParseDigest\": true, \"ParseUUIDv7\": true, \"ParseUUIDv4\": true},\n334|\t\t},\n335|\t}\n336|}\n337|\n338|// auditSessrepoAliases runs the alias audit over every production file,\n339|// allowlisting the funnel's own declaration position: a package-level\n340|// `var refuse = func...` binding a function literal.\n341|func auditSessrepoAliases(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n342|\tvar failures []string\n343|\tspec := sessrepoConstructorSpec()\n344|\tfor _, production := range files {\n345|\t\tallowed := sessrepoFunnelPositions(production.Syntax)\n346|\t\tfor _, failure := range invcore.AuditConstructorReferences(production.Syntax, fileSet, production.Name, spec) {\n347|\t\t\tif atAllowedPosition(failure, production.Name, fileSet, allowed) {\n348|\t\t\t\tcontinue\n349|\t\t\t}\n350|\t\t\tfailures = append(failures, failure)\n351|\t\t}\n352|\t}\n353|\treturn failures\n354|}\n355|\n356|func sessrepoFunnelPositions(syntax *ast.File) map[token.Pos]bool {\n357|\tpositions := map[token.Pos]bool{}\n358|\tfor _, declaration := range syntax.Decls {\n359|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n360|\t\tif !ok || general.Tok != token.VAR {\n361|\t\t\tcontinue\n362|\t\t}\n363|\t\tfor _, specification := range general.Specs {\n364|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n365|\t\t\tif !ok {\n366|\t\t\t\tcontinue\n367|\t\t\t}\n368|\t\t\tfor index, name := range value.Names {\n369|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n370|\t\t\t\t\tcontinue\n371|\t\t\t\t}\n372|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n373|\t\t\t\t\tpositions[name.Pos()] = true\n374|\t\t\t\t}\n375|\t\t\t}\n376|\t\t}\n377|\t}\n378|\treturn positions\n379|}\n380|\n381|func atAllowedPosition(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n382|\tfor position := range allowed {\n383|\t\tlocated := fileSet.Position(position)\n384|\t\tif !located.IsValid() {\n385|\t\t\tcontinue\n386|\t\t}\n387|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n388|\t\tif strings.Contains(failure, prefix) {\n389|\t\t\treturn true\n390|\t\t}\n391|\t}\n392|\treturn false\n393|}\n394|\n395|// TestCensusDiffSetsFailsClosed plants the three derivation outcomes\n396|// against the production DiffSets harness: an unregistered site, an orphan\n397|// row, and a zero-site derivation each fail instead of passing silently.\n398|func TestCensusDiffSetsFailsClosed(t *testing.T) {\n399|\tunregistered, orphaned, failures := invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{})\n400|\tif len(failures) != 0 {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
