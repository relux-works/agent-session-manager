{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73f","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":506,"recorded_at":1780531400001007,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"task_stream":{"kind":"task","id":"8a3c6ec6-e7b3-487e-889c-2ef36460ba63"},"task_id":"8a3c6ec6-e7b3-487e-889c-2ef36460ba63","event":{"kind":"output","task_id":"8a3c6ec6-e7b3-487e-889c-2ef36460ba63","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(199 line(s) above)\n200|\traw := buildEvent(t, eventOptions{sessionID: sessionID, predecessors: predecessors, epoch: epoch, leaseID: leaseID, sequence: sequence, eventType: eventType, payload: payload})\n201|\treference, err := repository.AppendEvent(sessionID, raw)\n202|\tif err != nil {\n203|\t\tt.Fatalf(\"AppendEvent(seq %d) error = %v\", sequence, err)\n204|\t}\n205|\treturn reference, raw\n206|}\n207|\n208|// mustErrorIs fails unless err matches the sentinel with errors.Is. Every\n209|// negative test below names its arm this way, so a weakened gate that\n210|// returns a different error — or none — fails the test.\n211|func mustErrorIs(t *testing.T, err error, sentinel error, what string) {\n212|\tt.Helper()\n213|\tif !errors.Is(err, sentinel) {\n214|\t\tt.Fatalf(\"%s error = %v, want errors.Is %v\", what, err, sentinel)\n215|\t}\n216|}\n217|\n218|func TestCreateSessionPersistsSpecRecordFixture(t *testing.T) {\n219|\trepository := openTestRepository(t)\n220|\treference := createTestSession(t, repository)\n221|\tif reference.SessionID != testSessionID {\n222|\t\tt.Fatalf(\"SessionID = %q, want %q\", reference.SessionID, testSessionID)\n223|\t}\n224|\tif reference.RecordID != \"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\" {\n225|\t\tt.Fatalf(\"RecordID = %q, want the SPEC example digest\", reference.RecordID)\n226|\t}\n227|\tstored, err := repository.GetRecord(testSessionID)\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"GetRecord error = %v\", err)\n230|\t}\n231|\tvar wantCanonical, gotCanonical any\n232|\tif err := json.Unmarshal([]byte(specRecordExample), &wantCanonical); err != nil {\n233|\t\tt.Fatal(err)\n234|\t}\n235|\tif err := json.Unmarshal(stored, &gotCanonical); err != nil {\n236|\t\tt.Fatal(err)\n237|\t}\n238|\twantBytes, _ := json.Marshal(wantCanonical)\n239|\tgotBytes, _ := json.Marshal(gotCanonical)\n240|\tif string(wantBytes) != string(gotBytes) {\n241|\t\tt.Fatal(\"stored record differs from the fixture\")\n242|\t}\n243|}\n244|\n245|func TestSessionRecordReloadsByteIdenticallyAcrossProcessBoundary(t *testing.T) {\n246|\troot := t.TempDir()\n247|\tfirst, err := Open(root)\n248|\tif err != nil {\n249|\t\tt.Fatal(err)\n250|\t}\n251|\treference := createTestSession(t, first)\n252|\tfirstEvent, firstBytes := appendTestEvent(t, first, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n253|\t// A second handle over the same root is a new process for file-backed\n254|\t// state: no memory carries over.\n255|\tsecond, err := Open(root)\n256|\tif err != nil {\n257|\t\tt.Fatal(err)\n258|\t}\n259|\tstored, err := second.GetRecord(testSessionID)\n260|\tif err != nil {\n261|\t\tt.Fatalf(\"GetRecord across boundary error = %v\", err)\n262|\t}\n263|\tif string(stored) != specRecordExample && !jsonEqual(t, stored, []byte(specRecordExample)) {\n264|\t\tt.Fatal(\"record bytes differ across the process boundary\")\n265|\t}\n266|\tevents, err := second.ListEvents(testSessionID)\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"ListEvents across boundary error = %v\", err)\n269|\t}\n270|\tif len(events) != 1 || events[0].EventID != firstEvent.EventID {\n271|\t\tt.Fatalf(\"reloaded chain = %+v, want the one appended event\", events)\n272|\t}\n273|\tstoredEvent, err := second.GetEvent(testSessionID, firstEvent.EventID)\n274|\tif err != nil {\n275|\t\tt.Fatalf(\"GetEvent across boundary error = %v\", err)\n276|\t}\n277|\tif string(storedEvent) != string(firstBytes) {\n278|\t\tt.Fatal(\"event bytes differ across the process boundary\")\n279|\t}\n280|\t// The chain continues on the new handle: sequence 2 appends cleanly.\n281|\tsecondRef, _ := appendTestEvent(t, second, testSessionID, []string{firstEvent.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n282|\tif secondRef.Position != 1 || secondRef.LeaseSequence != 2 {\n283|\t\tt.Fatalf(\"continued ref = %+v, want position 1 sequence 2\", secondRef)\n284|\t}\n285|}\n286|\n287|func jsonEqual(t *testing.T, left, right []byte) bool {\n288|\tt.Helper()\n289|\tvar l, r any\n290|\tif err := json.Unmarshal(left, &l); err != nil {\n291|\t\treturn false\n292|\t}\n293|\tif err := json.Unmarshal(right, &r); err != nil {\n294|\t\treturn false\n295|\t}\n296|\tlb, _ := json.Marshal(l)\n297|\trb, _ := json.Marshal(r)\n298|\treturn string(lb) == string(rb)\n299|}\n300|\n301|func TestAppendEventChainInOrder(t *testing.T) {\n302|\trepository := openTestRepository(t)\n303|\treference := createTestSession(t, repository)\n304|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n305|\tsecond, _ := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n306|\tthird, _ := appendTestEvent(t, repository, testSessionID, []string{second.EventID}, 1, testLeaseID, 3, \"checkpoint.created\", checkpointPayload())\n307|\tevents, err := repository.ListEvents(testSessionID)\n308|\tif err != nil {\n309|\t\tt.Fatal(err)\n310|\t}\n311|\tif len(events) != 3 {\n312|\t\tt.Fatalf(\"chain length = %d, want 3\", len(events))\n313|\t}\n314|\twant := []EventRef{first, second, third}\n315|\tfor index, ref := range want {\n316|\t\tif events[index].EventID != ref.EventID || events[index].LeaseSequence != uint64(index+1) {\n317|\t\t\tt.Fatalf(\"chain[%d] = %+v, want %+v\", index, events[index], ref)\n318|\t\t}\n319|\t}\n320|\tif events[0].EventType != \"session.created\" || events[2].EventType != \"checkpoint.created\" {\n321|\t\tt.Fatalf(\"event types = %q %q %q\", events[0].EventType, events[1].EventType, events[2].EventType)\n322|\t}\n323|}\n324|\n325|func TestAppendEventIdempotentRetry(t *testing.T) {\n326|\trepository := openTestRepository(t)\n327|\treference := createTestSession(t, repository)\n328|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n329|\tfirst, err := repository.AppendEvent(testSessionID, raw)\n330|\tif err != nil {\n331|\t\tt.Fatal(err)\n332|\t}\n333|\tsecond, err := repository.AppendEvent(testSessionID, raw)\n334|\tif err != nil {\n335|\t\tt.Fatalf(\"idempotent retry error = %v\", err)\n336|\t}\n337|\tif first != second {\n338|\t\tt.Fatalf(\"retry ref = %+v, want %+v\", second, first)\n339|\t}\n340|\tevents, err := repository.ListEvents(testSessionID)\n341|\tif err != nil {\n342|\t\tt.Fatal(err)\n343|\t}\n344|\tif len(events) != 1 {\n345|\t\tt.Fatalf(\"chain length after retry = %d, want 1\", len(events))\n346|\t}\n347|}\n348|\n349|func TestListSessionsExposesStoredIdentityAndChainHead(t *testing.T) {\n350|\trepository := openTestRepository(t)\n351|\treference := createTestSession(t, repository)\n352|\tother := buildRecord(t, func(object map[string]any) {\n353|\t\tobject[\"session_id\"] = testSessionIDB\n354|\t\tobject[\"subject_id\"] = testSessionIDB\n355|\t\tobject[\"name\"] = \"worker\"\n356|\t})\n357|\totherRef, err := repository.CreateSession(other)\n358|\tif err != nil {\n359|\t\tt.Fatal(err)\n360|\t}\n361|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n362|\tsummaries, err := repository.ListSessions()\n363|\tif err != nil {\n364|\t\tt.Fatal(err)\n365|\t}\n366|\tif len(summaries) != 2 {\n367|\t\tt.Fatalf(\"sessions = %d, want 2\", len(summaries))\n368|\t}\n369|\tif summaries[0].SessionID != testSessionID || summaries[1].SessionID != testSessionIDB {\n370|\t\tt.Fatalf(\"session order = %q %q, want ID order\", summaries[0].SessionID, summaries[1].SessionID)\n371|\t}\n372|\tif summaries[0].Name != \"payments-api\" || summaries[0].Kind != \"direct\" || summaries[0].ProviderID != \"codex\" {\n373|\t\tt.Fatalf(\"first summary = %+v, want stored identity\", summaries[0])\n374|\t}\n375|\tif summaries[0].EventCount != 1 || summaries[0].TailEvent != first.EventID {\n376|\t\tt.Fatalf(\"first head = %+v, want count 1 tail %s\", summaries[0], first.EventID)\n377|\t}\n378|\tif summaries[1].RecordID != otherRef.RecordID || summaries[1].EventCount != 0 || summaries[1].TailEvent != \"\" {\n379|\t\tt.Fatalf(\"second summary = %+v, want empty chain\", summaries[1])\n380|\t}\n381|\t// A stray non-session file in the namespace is ignored, never listed.\n382|\tif err := os.WriteFile(filepath.Join(repository.root, \"stray.txt\"), []byte(\"x\"), 0o600); err != nil {\n383|\t\tt.Fatal(err)\n384|\t}\n385|\tsummaries, err = repository.ListSessions()\n386|\tif err != nil {\n387|\t\tt.Fatal(err)\n388|\t}\n389|\tif len(summaries) != 2 {\n390|\t\tt.Fatalf(\"sessions with stray file = %d, want 2\", len(summaries))\n391|\t}\n392|}\n393|\n394|func TestOpenRefusesNonAbsoluteRoot(t *testing.T) {\n395|\t_, err := Open(\"relative/data\")\n396|\tmustErrorIs(t, err, ErrRepositoryPath, \"Open(relative)\")\n397|}\n398|\n399|func TestOpenRefusesFileAsRoot(t *testing.T) {\n400|\tfile := filepath.Join(t.TempDir(), \"file\")\n401|\tif err := os.WriteFile(file, []byte(\"x\"), 0o600); err != nil {\n402|\t\tt.Fatal(err)\n403|\t}\n404|\t_, err := Open(file)\n405|\tmustErrorIs(t, err, ErrRepositoryPath, \"Open(file)\")\n406|}\n407|\n408|func TestCreateSessionRefusesMalformedFrame(t *testing.T) {\n409|\trepository := openTestRepository(t)\n410|\t_, err := repository.CreateSession([]byte(`{\"schema\": \"urn:ax:schema:session-record\",`))\n411|\tmustErrorIs(t, err, ErrInvalidRecord, \"CreateSession(truncated)\")\n412|}\n413|\n414|func TestCreateSessionRefusesForeignSchema(t *testing.T) {\n415|\trepository := openTestRepository(t)\n416|\t// A valid session EVENT is not a session record: the schema gate fires\n417|\t// before identity is ever consulted.\n418|\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n419|\t_, err := repository.CreateSession(event)\n420|\tmustErrorIs(t, err, ErrInvalidRecord, \"CreateSession(event)\")\n421|}\n422|\n423|func TestCreateSessionRefusesMissingSessionID(t *testing.T) {\n424|\trepository := openTestRepository(t)\n425|\tvar object map[string]any\n426|\tif err := json.Unmarshal([]byte(specRecordExample), &object); err != nil {\n427|\t\tt.Fatal(err)\n428|\t}\n429|\tdelete(object, \"session_id\")\n430|\traw, _ := json.Marshal(object)\n431|\t_, err := repository.CreateSession(raw)\n432|\tmustErrorIs(t, err, ErrInvalidRecord, \"CreateSession(no session_id)\")\n433|}\n434|\n435|func TestCreateSessionRefusesDigestMismatch(t *testing.T) {\n436|\trepository := openTestRepository(t)\n437|\ttampered := strings.Replace(specRecordExample, `\"name\": \"payments-api\"`, `\"name\": \"payments-apj\"`, 1)\n438|\tif tampered == specRecordExample {\n439|\t\tt.Fatal(\"tamper did not apply\")\n440|\t}\n441|\t_, err := repository.CreateSession([]byte(tampered))\n442|\tmustErrorIs(t, err, ErrInvalidRecord, \"CreateSession(tampered)\")\n443|}\n444|\n445|func TestCreateSessionRefusesDuplicateAndRewrite(t *testing.T) {\n446|\trepository := openTestRepository(t)\n447|\tcreateTestSession(t, repository)\n448|\t// Exact duplicate create is refused: records are immutable and the\n449|\t// repository offers no rewrite path.\n450|\t_, err := repository.CreateSession([]byte(specRecordExample))\n451|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(duplicate)\")\n452|\t// A different record under the same session ID is also refused: history\n453|\t// cannot be replaced, only extended by events.\n454|\tcollision := buildRecord(t, func(object map[string]any) {\n455|\t\tobject[\"name\"] = \"payments-api-v2\"\n456|\t})\n457|\t// Force the colliding session ID while keeping a valid digest.\n458|\tvar object map[string]any\n459|\tif err := json.Unmarshal(collision, &object); err != nil {\n460|\t\tt.Fatal(err)\n461|\t}\n462|\tobject[\"session_id\"] = testSessionID\n463|\tobject[\"subject_id\"] = testSessionID\n464|\tcollision = reidentifyRecord(t, object)\n465|\t_, err = repository.CreateSession(collision)\n466|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(collision)\")\n467|\tstored, err := repository.GetRecord(testSessionID)\n468|\tif err != nil {\n469|\t\tt.Fatal(err)\n470|\t}\n471|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n472|\t\tt.Fatal(\"stored record changed after refused rewrite\")\n473|\t}\n474|}\n475|\n476|// reidentifyRecord recomputes the canonical digest after test-side surgery.\n477|func reidentifyRecord(t *testing.T, object map[string]any) []byte {\n478|\tt.Helper()\n479|\tobject[\"record_id\"] = zeroDigest\n480|\tstaged, _ := json.Marshal(object)\n481|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n482|\tif err != nil {\n483|\t\tt.Fatalf(\"reidentify record: %v\", err)\n484|\t}\n485|\tobject[\"record_id\"] = digest.String()\n486|\tout, _ := json.Marshal(object)\n487|\treturn out\n488|}\n489|\n490|func TestAppendEventRefusesUnknownSession(t *testing.T) {\n491|\trepository := openTestRepository(t)\n492|\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n493|\t_, err := repository.AppendEvent(testSessionID, event)\n494|\tmustErrorIs(t, err, ErrUnknownSession, \"AppendEvent(unknown session)\")\n495|}\n496|\n497|func TestAppendEventRefusesMalformedFrame(t *testing.T) {\n498|\trepository := openTestRepository(t)\n499|\tcreateTestSession(t, repository)\n500|\t_, err := repository.AppendEvent(testSessionID, []byte(`{\"schema\": \"urn:ax:schema:session-event\",`))\n501|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(truncated)\")\n502|}\n503|\n504|func TestAppendEventRefusesForeignSchema(t *testing.T) {\n505|\trepository := openTestRepository(t)\n506|\tcreateTestSession(t, repository)\n507|\t_, err := repository.AppendEvent(testSessionID, []byte(specRecordExample))\n508|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(record)\")\n509|}\n510|\n511|func TestAppendEventRefusesBadMember(t *testing.T) {\n512|\trepository := openTestRepository(t)\n513|\treference := createTestSession(t, repository)\n514|\tvectors := []struct {\n515|\t\tname   string\n516|\t\tmutate func(object map[string]any)\n517|\t}{\n518|\t\t{\"zero sequence\", func(object map[string]any) { object[\"lease_sequence\"] = 0 }},\n519|\t\t{\"unsafe sequence\", func(object map[string]any) { object[\"lease_sequence\"] = uint64(1 << 53) }},\n520|\t\t{\"non-v4 lease\", func(object map[string]any) { object[\"lease_id\"] = testSessionID }},\n521|\t\t{\"missing predecessors\", func(object map[string]any) { delete(object, \"predecessors\") }},\n522|\t\t{\"malformed predecessor\", func(object map[string]any) { object[\"predecessors\"] = []string{\"not-a-digest\"} }},\n523|\t\t{\"missing event type\", func(object map[string]any) { delete(object, \"event_type\") }},\n524|\t}\n525|\tfor _, vector := range vectors {\n526|\t\tt.Run(vector.name, func(t *testing.T) {\n527|\t\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n528|\t\t\tvar object map[string]any\n529|\t\t\tif err := json.Unmarshal(raw, &object); err != nil {\n530|\t\t\t\tt.Fatal(err)\n531|\t\t\t}\n532|\t\t\tvector.mutate(object)\n533|\t\t\tmutated, _ := json.Marshal(object)\n534|\t\t\t_, err := repository.AppendEvent(testSessionID, mutated)\n535|\t\t\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(\"+vector.name+\")\")\n536|\t\t})\n537|\t}\n538|}\n539|\n540|func TestAppendEventRefusesDigestMismatch(t *testing.T) {\n541|\trepository := openTestRepository(t)\n542|\treference := createTestSession(t, repository)\n543|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n544|\ttampered := strings.Replace(string(raw), `\"foreground_idle\":true`, `\"foreground_idle\":false`, 1)\n545|\tif tampered == string(raw) {\n546|\t\tt.Fatal(\"tamper did not apply\")\n547|\t}\n548|\t_, err := repository.AppendEvent(testSessionID, []byte(tampered))\n549|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(tampered)\")\n550|}\n551|\n552|func TestAppendEventRefusesSessionMismatch(t *testing.T) {\n553|\trepository := openTestRepository(t)\n554|\tcreateTestSession(t, repository)\n555|\tforeign := buildEvent(t, eventOptions{sessionID: testSessionIDB, predecessors: []string{\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n556|\t_, err := repository.AppendEvent(testSessionID, foreign)\n557|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(session mismatch)\")\n558|}\n559|\n560|func TestAppendEventRefusesSequenceGap(t *testing.T) {\n561|\tt.Run(\"skipped sequence\", func(t *testing.T) {\n562|\t\trepository := openTestRepository(t)\n563|\t\treference := createTestSession(t, repository)\n564|\t\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n565|\t\tskipped := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 3, eventType: \"session.idle\", payload: idlePayload()})\n566|\t\t_, err := repository.AppendEvent(testSessionID, skipped)\n567|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(skipped)\")\n568|\t})\n569|\tt.Run(\"first sequence past one\", func(t *testing.T) {\n570|\t\trepository := openTestRepository(t)\n571|\t\treference := createTestSession(t, repository)\n572|\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n573|\t\t_, err := repository.AppendEvent(testSessionID, raw)\n574|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(first past one)\")\n575|\t})\n576|\tt.Run(\"successor lease past one\", func(t *testing.T) {\n577|\t\trepository := openTestRepository(t)\n578|\t\treference := createTestSession(t, repository)\n579|\t\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n580|\t\tnext := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 2, leaseID: testLeaseIDB, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n581|\t\t_, err := repository.AppendEvent(testSessionID, next)\n582|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(successor past one)\")\n583|\t})\n584|\tt.Run(\"spec stopped fixture is a gap, not an invalid event\", func(t *testing.T) {\n585|\t\trepository := openTestRepository(t)\n586|\t\tcreateTestSession(t, repository)\n587|\t\tif _, _, err := canonicaljson.VerifyObjectIdentity([]byte(specStoppedExample)); err != nil {\n588|\t\t\tt.Fatalf(\"SPEC event fixture must verify: %v\", err)\n589|\t\t}\n590|\t\t_, err := repository.AppendEvent(testSessionID, []byte(specStoppedExample))\n591|\t\tmustErrorIs(t, err, ErrSequenceGap, \"AppendEvent(spec stopped)\")\n592|\t})\n593|}\n594|\n595|func TestAppendEventRefusesSequenceRepeat(t *testing.T) {\n596|\trepository := openTestRepository(t)\n597|\treference := createTestSession(t, repository)\n598|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n599|\t// A different event at an already chained sequence is a repeat, and the\n600|\t// two-events-at-one-sequence fork the spec forbids.\n601|\trepeat := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n602|\t_, err := repository.AppendEvent(testSessionID, repeat)\n603|\tmustErrorIs(t, err, ErrSequenceRepeat, \"AppendEvent(repeat)\")\n604|\tsecond, _ := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n605|\tstale := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n606|\t_, err = repository.AppendEvent(testSessionID, stale)\n607|\tmustErrorIs(t, err, ErrSequenceRepeat, \"AppendEvent(old sequence)\")\n608|\tevents, err := repository.ListEvents(testSessionID)\n609|\tif err != nil {\n610|\t\tt.Fatal(err)\n611|\t}\n612|\tif len(events) != 2 || events[1].EventID != second.EventID {\n613|\t\tt.Fatalf(\"chain after refused repeats = %+v\", events)\n614|\t}\n615|}\n616|\n617|func TestAppendEventRefusesFirstPredecessorMismatch(t *testing.T) {\n618|\tt.Run(\"unrelated predecessor\", func(t *testing.T) {\n619|\t\trepository := openTestRepository(t)\n620|\t\tcreateTestSession(t, repository)\n621|\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{zeroDigest}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\")})\n622|\t\t_, err := repository.AppendEvent(testSessionID, raw)\n623|\t\tmustErrorIs(t, err, ErrPredecessorLink, \"AppendEvent(unrelated predecessor)\")\n624|\t})\n625|\tt.Run(\"record plus extra predecessor\", func(t *testing.T) {\n626|\t\trepository := openTestRepository(t)\n627|\t\treference := createTestSession(t, repository)\n628|\t\textra := \"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff\"\n629|\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID, extra}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n630|\t\t_, err := repository.AppendEvent(testSessionID, raw)\n631|\t\tmustErrorIs(t, err, ErrPredecessorLink, \"AppendEvent(extra predecessor)\")\n632|\t})\n633|}\n634|\n635|func TestAppendEventRefusesLaterPredecessorMismatch(t *testing.T) {\n636|\trepository := openTestRepository(t)\n637|\treference := createTestSession(t, repository)\n638|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n639|\t// The second event must reference the first, not skip back to the record.\n640|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n641|\t_, err := repository.AppendEvent(testSessionID, raw)\n642|\tmustErrorIs(t, err, ErrPredecessorLink, \"AppendEvent(skipped head)\")\n643|}\n644|\n645|func TestAppendEventPreservesDivergentBranchWithoutApplying(t *testing.T) {\n646|\trepository := openTestRepository(t)\n647|\treference := createTestSession(t, repository)\n648|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n649|\t// A same-epoch second lease is the concurrent-takeover fork: its bytes\n650|\t// are preserved in the immutable namespace but never linked into the\n651|\t// authoritative chain.\n652|\tfork := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseIDB, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n653|\t_, err := repository.AppendEvent(testSessionID, fork)\n654|\tmustErrorIs(t, err, ErrDivergentBranch, \"AppendEvent(divergent)\")\n655|\tvar forkID struct {\n656|\t\tEventID string `json:\"event_id\"`\n657|\t}\n658|\tif err := json.Unmarshal(fork, &forkID); err != nil {\n659|\t\tt.Fatal(err)\n660|\t}\n661|\tpreserved, err := os.ReadFile(blobPathFor(t, repository, testSessionID, forkID.EventID))\n662|\tif err != nil {\n663|\t\tt.Fatalf(\"divergent blob was not preserved: %v\", err)\n664|\t}\n665|\tif string(preserved) != string(fork) {\n666|\t\tt.Fatal(\"preserved divergent bytes differ\")\n667|\t}\n668|\tevents, err := repository.ListEvents(testSessionID)\n669|\tif err != nil {\n670|\t\tt.Fatal(err)\n671|\t}\n672|\tif len(events) != 1 {\n673|\t\tt.Fatalf(\"chain after divergent fork = %d events, want 1\", len(events))\n674|\t}\n675|}\n676|\n677|func TestAppendEventRefusesStaleLeaseEpoch(t *testing.T) {\n678|\trepository := openTestRepository(t)\n679|\treference := createTestSession(t, repository)\n680|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n681|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 2, testLeaseIDB, 1, \"session.idle\", idlePayload())\n682|\t// An event from the superseded epoch cannot rejoin the chain.\n683|\tlate := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n684|\t_, err := repository.AppendEvent(testSessionID, late)\n685|\tmustErrorIs(t, err, ErrStaleLease, \"AppendEvent(stale epoch)\")\n686|}\n687|\n688|func TestAppendEventRefusesDisagreeingDigestPathBytes(t *testing.T) {\n689|\trepository := openTestRepository(t)\n690|\treference := createTestSession(t, repository)\n691|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n692|\tnext := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{first.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n693|\t// Plant disagreeing bytes at the path the event's digest names, then\n694|\t// append the genuine event: the store must refuse instead of trusting\n695|\t// either copy.\n696|\tvar parsed struct {\n697|\t\tEventID string `json:\"event_id\"`\n698|\t}\n699|\tif err := json.Unmarshal(next, &parsed); err != nil {\n(more lines below)"}}}
