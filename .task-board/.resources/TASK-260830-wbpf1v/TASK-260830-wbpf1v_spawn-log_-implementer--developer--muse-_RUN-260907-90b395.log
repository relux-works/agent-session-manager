{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a5","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":301,"recorded_at":1780531400000597,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"task_stream":{"kind":"task","id":"97c5fcf1-1e2a-4b1a-b750-aaac6070faef"},"task_id":"97c5fcf1-1e2a-4b1a-b750-aaac6070faef","event":{"kind":"output","task_id":"97c5fcf1-1e2a-4b1a-b750-aaac6070faef","chunk":"Read text file `internal/sessrepo/crash_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n9|)\n10|\n11|// wireCrashPoints connects a repository's write boundaries to the owner's\n12|// crash injector: BeforeWrite fires PointPrepareEnter (before any durable\n13|// byte) and AfterCommit fires PointCommitApply (after the chain index is\n14|// durable). The faults that surface are the owner's typed faults with the\n15|// owner's outcome vocabulary.\n16|func wireCrashPoints(repository *Repository, injector *secconftest.Injector) {\n17|\trepository.BeforeWrite = func() error {\n18|\t\treturn injector.MaybeFail(secconftest.PointPrepareEnter)\n19|\t}\n20|\trepository.AfterCommit = func() error {\n21|\t\treturn injector.MaybeFail(secconftest.PointCommitApply)\n22|\t}\n23|}\n24|\n25|// mustCrashFault fails unless err is the injected fault for the armed point\n26|// carrying the expected outcome.\n27|func mustCrashFault(t *testing.T, err error, point string, outcome secconftest.Outcome, what string) {\n28|\tt.Helper()\n29|\tif err == nil {\n30|\t\tt.Fatalf(\"%s error = nil, want injected fault at %s\", what, point)\n31|\t}\n32|\tvar fault *secconftest.Fault\n33|\tif !errors.As(err, &fault) {\n34|\t\tt.Fatalf(\"%s error = %v, want *secconftest.Fault\", what, err)\n35|\t}\n36|\tif fault.Point() != point {\n37|\t\tt.Fatalf(\"%s point = %q, want %q\", what, fault.Point(), point)\n38|\t}\n39|\tif fault.Outcome() != outcome {\n40|\t\tt.Fatalf(\"%s outcome = %q, want %q\", what, fault.Outcome(), outcome)\n41|\t}\n42|}\n43|\n44|func TestCrashBeforeDurableWriteIsSafeRetryOnCreate(t *testing.T) {\n45|\trepository := openTestRepository(t)\n46|\tinjector := &secconftest.Injector{}\n47|\twireCrashPoints(repository, injector)\n48|\tinjector.Arm(secconftest.PointPrepareEnter)\n49|\t_, err := repository.CreateSession([]byte(specRecordExample))\n50|\tmustCrashFault(t, err, secconftest.PointPrepareEnter, secconftest.OutcomeSafeRetry, \"CreateSession(prepare fault)\")\n51|\t// Nothing mutated: the session is still unknown.\n52|\t_, err = repository.GetRecord(testSessionID)\n53|\tmustErrorIs(t, err, ErrUnknownSession, \"GetRecord(after prepare fault)\")\n54|\t// The identical retry is safe and succeeds.\n55|\treference, err := repository.CreateSession([]byte(specRecordExample))\n56|\tif err != nil {\n57|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n58|\t}\n59|\tif reference.SessionID != testSessionID {\n60|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n61|\t}\n62|}\n63|\n64|func TestCrashBeforeDurableWriteIsSafeRetryOnAppend(t *testing.T) {\n65|\trepository := openTestRepository(t)\n66|\treference := createTestSession(t, repository)\n67|\tinjector := &secconftest.Injector{}\n68|\twireCrashPoints(repository, injector)\n69|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n70|\tinjector.Arm(secconftest.PointPrepareEnter)\n71|\t_, err := repository.AppendEvent(testSessionID, raw)\n72|\tmustCrashFault(t, err, secconftest.PointPrepareEnter, secconftest.OutcomeSafeRetry, \"AppendEvent(prepare fault)\")\n73|\tevents, err := repository.ListEvents(testSessionID)\n74|\tif err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\tif len(events) != 0 {\n78|\t\tt.Fatalf(\"chain after prepare fault = %d events, want 0\", len(events))\n79|\t}\n80|\tfirst, err := repository.AppendEvent(testSessionID, raw)\n81|\tif err != nil {\n82|\t\tt.Fatalf(\"retry AppendEvent error = %v\", err)\n83|\t}\n84|\tif first.Position != 0 || first.LeaseSequence != 1 {\n85|\t\tt.Fatalf(\"retry ref = %+v\", first)\n86|\t}\n87|}\n88|\n89|func TestCrashAfterDurableWriteCountsAsCommittedOnCreate(t *testing.T) {\n90|\trepository := openTestRepository(t)\n91|\tinjector := &secconftest.Injector{}\n92|\twireCrashPoints(repository, injector)\n93|\tinjector.Arm(secconftest.PointCommitApply)\n94|\t_, err := repository.CreateSession([]byte(specRecordExample))\n95|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(commit fault)\")\n96|\t// The crashed commit already performed the durable write: the record\n97|\t// reads back and the operation is terminal, so a retry names the\n98|\t// terminal state instead of duplicating it.\n99|\tstored, err := repository.GetRecord(testSessionID)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"GetRecord after crashed commit error = %v\", err)\n102|\t}\n103|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n104|\t\tt.Fatal(\"record after crashed commit differs\")\n105|\t}\n106|\t_, err = repository.CreateSession([]byte(specRecordExample))\n107|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(after crashed commit)\")\n108|}\n109|\n110|func TestCrashAfterDurableWriteCountsAsCommittedOnAppend(t *testing.T) {\n111|\trepository := openTestRepository(t)\n112|\treference := createTestSession(t, repository)\n113|\tinjector := &secconftest.Injector{}\n114|\twireCrashPoints(repository, injector)\n115|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n116|\tinjector.Arm(secconftest.PointCommitApply)\n117|\t_, err := repository.AppendEvent(testSessionID, raw)\n118|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"AppendEvent(commit fault)\")\n119|\tvar eventID struct {\n120|\t\tEventID string `json:\"event_id\"`\n121|\t}\n122|\tif err := json.Unmarshal(raw, &eventID); err != nil {\n123|\t\tt.Fatal(err)\n124|\t}\n125|\tstored, err := repository.GetEvent(testSessionID, eventID.EventID)\n126|\tif err != nil {\n127|\t\tt.Fatalf(\"GetEvent after crashed commit error = %v\", err)\n128|\t}\n129|\tif string(stored) != string(raw) {\n130|\t\tt.Fatal(\"event after crashed commit differs\")\n131|\t}\n132|\t// The lost-response retry carries the identical bytes and receives the\n133|\t// identical reference without a second chain entry.\n134|\tretry, err := repository.AppendEvent(testSessionID, raw)\n135|\tif err != nil {\n136|\t\tt.Fatalf(\"idempotent retry after crashed commit error = %v\", err)\n137|\t}\n138|\tif retry.EventID != eventID.EventID || retry.Position != 0 {\n139|\t\tt.Fatalf(\"retry ref = %+v, want the committed position\", retry)\n140|\t}\n141|\tevents, err := repository.ListEvents(testSessionID)\n142|\tif err != nil {\n143|\t\tt.Fatal(err)\n144|\t}\n145|\tif len(events) != 1 {\n146|\t\tt.Fatalf(\"chain after crashed commit and retry = %d events, want 1\", len(events))\n147|\t}\n148|\t// Rollback past the crashed commit is forbidden by construction: there\n149|\t// is no rollback entry, and the committed bytes survive every later\n150|\t// refusal on this session.\n151|\t_, err = repository.AppendEvent(testSessionID, buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{eventID.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()}))\n152|\tmustErrorIs(t, err, ErrSequenceRepeat, \"AppendEvent(repeat after parked commit)\")\n153|\tstored, err = repository.GetEvent(testSessionID, eventID.EventID)\n154|\tif err != nil {\n155|\t\tt.Fatal(err)\n156|\t}\n157|\tif string(stored) != string(raw) {\n158|\t\tt.Fatal(\"committed bytes did not survive the later refusal\")\n159|\t}\n160|}"}}}
