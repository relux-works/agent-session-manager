Separator)\ninternal/provhost/identity_test.go-109-\tfor _, tree := range []string{\"internal\", \"cmd\"} {\ninternal/provhost/identity_test.go-110-\t\tbase := filepath.Join(root, tree)\ninternal/provhost/identity_test.go-111-\t\tif _, err := os.Stat(base); err != nil {\ninternal/provhost/identity_test.go-112-\t\t\tcontinue\ninternal/provhost/identity_test.go-113-\t\t}\ninternal/provhost/identity_test.go-114-\t\t// Recursion stays local: the core selects single-package\ninternal/provhost/identity_test.go-115-\t\t// production files, while this attestation spans trees.\ninternal/provhost/identity_test.go-116-\t\t// Fail-closed parsing is the core's.\ninternal/provhost/identity_test.go-117-\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\ninternal/provhost/identity_test.go-118-\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\ninternal/provhost/identity_test.go-119-\t\t\t\treturn err\ninternal/provhost/identity_test.go-120-\t\t\t}\ninternal/provhost/identity_test.go-121-\t\t\tscanned++\ninternal/provhost/identity_test.go-122-\t\t\tsource, err := os.ReadFile(path)\ninternal/provhost/identity_test.go-123-\t\t\tif err != nil {\ninternal/provhost/identity_test.go-124-\t\t\t\tt.Fatalf(\"read %s: %v\", path, err)\ninternal/provhost/identity_test.go-125-\t\t\t}\ninternal/provhost/identity_test.go-126-\t\t\tif !strings.Contains(string(source), \"VerifyObjectIdentity\") {\ninternal/provhost/identity_test.go-127-\t\t\t\treturn nil\ninternal/provhost/identity_test.go-128-\t\t\t}\ninternal/provhost/identity_test.go-129-\t\t\tparsed++\ninternal/provhost/identity_test.go-130-\t\t\tsyntax, fileSet, failure := invcore.ParseBytes(path, source, 0)\ninternal/provhost/identity_test.go-131-\t\t\tif failure != \"\" {\ninternal/provhost/identity_test.go-132-\t\t\t\tt.Fatalf(\"parse %s: %s\", path, failure)\ninternal/provhost/identity_test.go-133-\t\t\t}\ninternal/provhost/identity_test.go-134-\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\ninternal/provhost/identity_test.go-135-\t\t\t\tcall, ok := node.(*ast.CallExpr)\ninternal/provhost/identity_test.go-136-\t\t\t\tif !ok {\ninternal/provhost/identity_test.go-137-\t\t\t\t\treturn true\ninternal/provhost/identity_test.go-138-\t\t\t\t}\ninternal/provhost/identity_test.go-139-\t\t\t\trecord := func(position token.Position) {\ninternal/provhost/identity_test.go-140-\t\t\t\t\tentry := fmt.Sprintf(\"%s:%d\", position.Filename, position.Line)\ninternal/provhost/identity_test.go:141:\t\t\t\t\tif strings.Contains(position.Filename, sessrepoLeaf) {\ninternal/provhost/identity_test.go-142-\t\t\t\t\t\tallowed = append(allowed, entry)\ninternal/provhost/identity_test.go-143-\t\t\t\t\t\treturn\ninternal/provhost/identity_test.go-144-\t\t\t\t\t}\ninternal/provhost/identity_test.go-145-\t\t\t\t\tcallers = append(callers, entry)\ninternal/provhost/identity_test.go-146-\t\t\t\t}\ninternal/provhost/identity_test.go-147-\t\t\t\tswitch fun := call.Fun.(type) {\ninternal/provhost/identity_test.go-148-\t\t\t\tcase *ast.SelectorExpr:\ninternal/provhost/identity_test.go-149-\t\t\t\t\tif fun.Sel.Name == \"VerifyObjectIdentity\" {\ninternal/provhost/identity_test.go-150-\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\ninternal/provhost/identity_test.go-151-\t\t\t\t\t}\ninternal/provhost/identity_test.go-152-\t\t\t\tcase *ast.Ident:\ninternal/provhost/identity_test.go-153-\t\t\t\t\tif fun.Name == \"VerifyObjectIdentity\" {\ninternal/provhost/identity_test.go-154-\t\t\t\t\t\t// The canonicaljson definition itself is a\ninternal/provhost/identity_test.go-155-\t\t\t\t\t\t// FuncDecl, never a call; a bare-identifier call\ninternal/provhost/identity_test.go-156-\t\t\t\t\t\t// anywhere is a production call site.\ninternal/provhost/identity_test.go-157-\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\ninternal/provhost/identity_test.go-158-\t\t\t\t\t}\ninternal/provhost/identity_test.go-159-\t\t\t\t}\ninternal/provhost/identity_test.go-160-\t\t\t\treturn true\ninternal/provhost/identity_test.go-161-\t\t\t})\ninternal/provhost/identity_test.go-162-\t\t\treturn nil\ninternal/provhost/identity_test.go-163-\t\t}); err != nil {\ninternal/provhost/identity_test.go-164-\t\t\tt.Fatalf(\"walk %s: %v\", base, err)\ninternal/provhost/identity_test.go-165-\t\t}\ninternal/provhost/identity_test.go-166-\t}\ninternal/provhost/identity_test.go-167-\tif scanned == 0 {\ninternal/provhost/identity_test.go-168-\t\tt.Fatal(\"scanned no production sources; the check is blind\")\ninternal/provhost/identity_test.go-169-\t}\ninternal/provhost/identity_test.go-170-\tif len(allowed) == 0 {\ninternal/provhost/identity_test.go:171:\t\tt.Fatal(\"sessrepo attestation exception is stale: no allowlisted call site remains, remove the exception\")\ninternal/provhost/identity_test.go-172-\t}\ninternal/provhost/identity_test.go-173-\tif len(callers) != 0 {\ninternal/provhost/identity_test.go-174-\t\tt.Fatalf(\"production call sites outside the session leaf attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\ninternal/provhost/identity_test.go-175-\t}\ninternal/provhost/identity_test.go-176-\tt.Logf(\"attestation scan: %d production files, %d parsed, %d session-leaf call sites, 0 elsewhere\", scanned, parsed, len(allowed))\ninternal/provhost/identity_test.go-177-}\ninternal/provhost/identity_test.go-178-\ninternal/provhost/identity_test.go-179-// identityVariant rewrites one unique substring of the example.\ninternal/provhost/identity_test.go-180-func identityVariant(t *testing.T, old, new string) []byte {\ninternal/provhost/identity_test.go-181-\tt.Helper()\ninternal/provhost/identity_test.go-182-\tif strings.Count(specIdentityExample, old) != 1 {\ninternal/provhost/identity_test.go-183-\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\ninternal/provhost/identity_test.go-184-\t}\ninternal/provhost/identity_test.go-185-\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\ninternal/provhost/identity_test.go-186-}\ninternal/provhost/identity_test.go-187-\ninternal/provhost/identity_test.go-188-// TestCheckIdentityRefusals drives every identity rule, including\ninternal/provhost/identity_test.go-189-// the five normative Section 5.5 negatives: unknown identity_kind,\ninternal/provhost/identity_test.go-190-// absent opaque_identity, an object opaque value, an absolute source\ninternal/provhost/identity_test.go-191-// path in that map, and an Antigravity backend_conversation_uuid\ninternal/provhost/identity_test.go-192-// with a null realm fingerprint.\ninternal/provhost/identity_test.go-193-func TestCheckIdentityRefusals(t *testing.T) {\ninternal/provhost/identity_test.go-194-\tlong128 := strings.Repeat(\"v\", 128)\ninternal/provhost/identity_test.go-195-\tlong129 := strings.Repeat(\"v\", 129)\ninternal/provhost/identity_test.go-196-\tlong1024 := strings.Repeat(\"v\", 1024)\ninternal/provhost/identity_test.go-197-\tlong1025 := strings.Repeat(\"v\", 1025)\ninternal/provhost/identity_test.go-198-\tlong256 := strings.Repeat(\"r\", 256)\ninternal/provhost/identity_test.go-199-\tlong257 := strings.Repeat(\"r\", 257)\ninternal/provhost/identity_test.go-200-\tlong512 := strings.Repeat(\"s\", 512)\ninternal/provhost/identity_test.go-201-\tlong513 := strings.Repeat(\"s\", 513)","correlation_facts":{"tool_name":"search","outcome":"success"}}}
