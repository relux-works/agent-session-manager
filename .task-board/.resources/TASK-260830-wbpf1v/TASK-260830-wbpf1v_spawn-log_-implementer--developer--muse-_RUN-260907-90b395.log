gest, verified by\n32|// TestCreateSessionPersistsSpecRecordFixture below.\n33|const specRecordExample = `{\n34|  \"schema\": \"urn:ax:schema:session-record\",\n35|  \"schema_version\": \"1.0.0\",\n36|  \"record_id\": \"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\",\n37|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n38|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n39|  \"name\": \"payments-api\",\n40|  \"kind\": \"direct\",\n41|  \"created_at\": \"2026-08-19T04:00:00.000Z\",\n42|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n43|  \"provider_id\": \"codex\",\n44|  \"workspace_group_id\": \"0198f4c8-5b20-7c33-8c4d-1234567890ab\",\n45|  \"execution_profile\": \"yolo\",\n46|  \"launch_plan\": {\n47|    \"argv\": [\"codex\"],\n48|    \"cwd_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n49|    \"cwd_relative\": \"src\",\n50|    \"env_names\": [\"OPENAI_API_KEY\"],\n51|    \"env_literals\": {},\n52|    \"contains_secrets\": false,\n53|    \"extensions\": {}\n54|  },\n55|  \"task_board\": null,\n56|  \"fork_provenance\": null,\n57|  \"extensions\": {}\n58|}`\n59|\n60|// specStoppedExample is the verbatim SPEC.md Section 5.2 normative example.\n61|const specStoppedExample = `{\n62|  \"schema\": \"urn:ax:schema:session-event\",\n63|  \"schema_version\": \"1.0.0\",\n64|  \"event_id\": \"sha256:46d2745fe7dfce856027be36e34f1cc6a56ffc846063dc4aa6aabf3f5a85bacb\",\n65|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n66|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n67|  \"event_type\": \"session.stopped\",\n68|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n69|  \"lease_epoch\": 4,\n70|  \"lease_id\": \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\",\n71|  \"lease_sequence\": 12,\n72|  \"predecessors\": [\n73|    \"sha256:7777777777777777777777777777777777777777777777777777777777777777\"\n74|  ],\n75|  \"created_at\": \"2026-08-19T04:08:00.000Z\",\n76|  \"payload\": {\n77|    \"graceful\": true,\n78|    \"checkpoint_id\": \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\",\n79|    \"resumable\": true,\n80|    \"closure_kind\": \"checkpointed\",\n81|    \"process_closed\": true,\n82|    \"store_closed\": true\n83|  },\n84|  \"extensions\": {}\n85|}`\n86|\n87|// openTestRepository opens a repository under a test-temporary data root.\n88|func openTestRepository(t *testing.T) *Repository {\n89|\tt.Helper()\n90|\trepository, err := Open(t.TempDir())\n91|\tif err != nil {\n92|\t\tt.Fatalf(\"Open(test root) error = %v\", err)\n93|\t}\n94|\treturn repository\n95|}\n96|\n97|// buildRecord derives a valid Session Record from the SPEC example with\n98|// the caller's mutations, recomputing the canonical digest through the\n99|// production identity entry. A mutation that breaks the closed shape fails\n100|// the build, so invalid vectors are crafted as raw JSON instead.\n101|func buildRecord(t *testing.T, mutate func(object map[string]any)) []byte {\n102|\tt.Helper()\n103|\tvar object map[string]any\n104|\tif err := json.Unmarshal([]byte(specRecordExample), &object); err != nil {\n105|\t\tt.Fatalf(\"unmarshal SPEC record example: %v\", err)\n106|\t}\n107|\tif mutate != nil {\n108|\t\tmutate(object)\n109|\t}\n110|\tobject[\"record_id\"] = zeroDigest\n111|\tstaged, err := json.Marshal(object)\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"marshal staged record: %v\", err)\n114|\t}\n115|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"CalculateObjectIdentity(staged record) error = %v\", err)\n118|\t}\n119|\tobject[\"record_id\"] = digest.String()\n120|\tout, err := json.Marshal(object)\n121|\tif err != nil {\n122|\t\tt.Fatalf(\"marshal record: %v\", err)\n123|\t}\n124|\tif _, _, err := canonicaljson.VerifyObjectIdentity(out); err != nil {\n125|\t\tt.Fatalf(\"VerifyObjectIdentity(built record) error = %v\", err)\n126|\t}\n127|\treturn out\n128|}\n129|\n130|// eventOptions selects the chain position and payload of a built event.\n131|type eventOptions struct {\n132|\tsessionID    string\n133|\tpredecessors []string\n134|\tepoch        uint64\n135|\tleaseID      string\n136|\tsequence     uint64\n137|\teventType    string\n138|\tpayload      map[string]any\n139|}\n140|\n141|// buildEvent derives a valid Session Event for the given chain position,\n142|// computing the canonical digest through the production identity entry.\n143|func buildEvent(t *testing.T, options eventOptions) []byte {\n144|\tt.Helper()\n145|\tobject := map[string]any{\n146|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": \"1.0.0\",\n147|\t\t\"event_id\": zeroDigest, \"subject_id\": options.sessionID, \"session_id\": options.sessionID,\n148|\t\t\"event_type\": options.eventType, \"created_by_host_id\": testHostID,\n149|\t\t\"lease_epoch\": options.epoch, \"lease_id\": options.leaseID, \"lease_sequence\": options.sequence,\n150|\t\t\"predecessors\": options.predecessors, \"created_at\": testCreatedAt,\n151|\t\t\"payload\": options.payload, \"extensions\": map[string]any{},\n152|\t}\n153|\tstaged, err := json.Marshal(object)\n154|\tif err != nil {\n155|\t\tt.Fatalf(\"marshal staged event: %v\", err)\n156|\t}\n157|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n158|\tif err != nil {\n159|\t\tt.Fatalf(\"CalculateObjectIdentity(staged event) error = %v\", err)\n160|\t}\n161|\tobject[\"event_id\"] = digest.String()\n162|\tout, err := json.Marshal(object)\n163|\tif err != nil {\n164|\t\tt.Fatalf(\"marshal event: %v\", err)\n165|\t}\n166|\tif _, _, err := canonicaljson.VerifyObjectIdentity(out); err != nil {\n167|\t\tt.Fatalf(\"VerifyObjectIdentity(built event) error = %v\", err)\n168|\t}\n169|\treturn out\n170|}\n171|\n172|// Payload builders for the event types the chain tests use. Each carries\n173|// exactly the Section 5.2 members for its type.\n174|func createdPayload(recordID string) map[string]any {\n175|\treturn map[string]any{\"session_record_id\": recordID, \"bootstrap_operation_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\", \"first_checkpoint_operation_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ac\"}\n176|}\n177|\n178|func idlePayload() map[string]any {\n179|\treturn map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}\n180|}\n181|\n182|func checkpointPayload() map[string]any {\n183|\treturn map[string]any{\"checkpoint_id\": \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\", \"kind\": \"manual\"}\n184|}\n185|\n186|// createTestSession persists the SPEC record and returns its reference.\n187|func createTestSession(t *testing.T, repository *Repository) SessionRef {\n188|\tt.Helper()\n189|\treference, err := repository.CreateSession([]byte(specRecordExample))\n190|\tif err != nil {\n191|\t\tt.Fatalf(\"CreateSession(SPEC record) error = %v\", err)\n192|\t}\n193|\treturn reference\n194|}\n195|\n196|// appendTestEvent appends one valid event at the given chain position and\n197|// returns its reference and bytes.\n198|func appendTestEvent(t *testing.T, repository *Repository, sessionID string, predecessors []string, epoch uint64, leaseID string, sequence uint64, eventType string, payload map[string]any) (EventRef, []byte) {\n199|\tt.Helper()\n200|\traw := buildEvent(t, eventOptions{sessionID: sessionID, predecessors: predecessors, epoch: epoch, leaseID: leaseID, sequence: sequence, eventType: eventType, payload: payload})\n(more lines below)"}}}
