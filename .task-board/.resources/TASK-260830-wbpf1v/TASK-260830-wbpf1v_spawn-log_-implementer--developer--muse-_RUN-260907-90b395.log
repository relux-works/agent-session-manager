{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c569","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":271,"recorded_at":1780531400000537,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"call_id":"call_01a07bd49922775297792017ac38834d","text":"Read text file `internal/sessrepo/sessrepo.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sync\"\n10|)\n11|\n12|// uint53Max is the AX safe-integer ceiling from SPEC.md Section 1.6. It is\n13|// passed to the environ bound checker, never re-enforced here.\n14|const uint53Max = uint64(1<<53 - 1)\n15|\n16|const (\n17|\tsessionRecordSchema = \"urn:ax:schema:session-record\"\n18|\tsessionEventSchema  = \"urn:ax:schema:session-event\"\n19|)\n20|\n21|var (\n22|\tErrInvalidRecord   = errors.New(\"invalid session record\")\n23|\tErrSessionExists   = errors.New(\"session already exists\")\n24|\tErrUnknownSession  = errors.New(\"unknown session\")\n25|\tErrInvalidEvent    = errors.New(\"invalid session event\")\n26|\tErrSequenceGap     = errors.New(\"event source sequence gap\")\n27|\tErrSequenceRepeat  = errors.New(\"event source sequence repeat\")\n28|\tErrPredecessorLink = errors.New(\"event predecessor link mismatch\")\n29|\tErrDivergentBranch = errors.New(\"divergent lease branch preserved without application\")\n30|\tErrStaleLease      = errors.New(\"event lease epoch precedes the chain head\")\n31|\tErrChainCorrupt    = errors.New(\"session event chain is corrupt\")\n32|\tErrUnknownEvent    = errors.New(\"unknown session event\")\n33|\tErrNameAmbiguous   = errors.New(\"name_ambiguous\")\n34|\tErrNameNotFound    = errors.New(\"session name not found\")\n35|\tErrRepositoryPath  = errors.New(\"invalid session repository path\")\n36|)\n37|\n38|// refuse is the single refusal funnel every sessrepo rejection flows\n39|// through. It is a var so the census TestMain can wrap it and record the\n40|// production file:line behind each exercised refusal. No production path\n41|// wraps a sentinel with fmt.Errorf directly.\n42|var refuse = func(sentinel error, format string, arguments ...any) error {\n43|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n44|}\n45|\n46|// SessionRef names one persisted session: its Session Record digest and ID.\n47|type SessionRef struct {\n48|\tSessionID string\n49|\tRecordID  string\n50|}\n51|\n52|// EventRef names one chained event: its digest, lease sequence, and position.\n53|type EventRef struct {\n54|\tSessionID     string\n55|\tEventID       string\n56|\tLeaseSequence uint64\n57|\tPosition      int\n58|}\n59|\n60|// EventSummary is the chain-index entry for one event, derived from the\n61|// validated event bytes at append time and re-verified against them on load.\n62|type EventSummary struct {\n63|\tEventID       string   `json:\"event_id\"`\n64|\tEventType     string   `json:\"event_type\"`\n65|\tLeaseEpoch    uint64   `json:\"lease_epoch\"`\n66|\tLeaseID       string   `json:\"lease_id\"`\n67|\tLeaseSequence uint64   `json:\"lease_sequence\"`\n68|\tPredecessors  []string `json:\"predecessors\"`\n69|}\n70|\n71|// SessionSummary is the Section 14.4 list projection this leaf owns: stored\n72|// identity plus chain-head facts. Owner host, checkpoint age, capability\n73|// status, and warnings are derived downstream, never here.\n74|type SessionSummary struct {\n75|\tSessionID  string\n76|\tRecordID   string\n77|\tName       string\n78|\tKind       string\n79|\tProviderID string\n80|\tEventCount int\n81|\tTailEvent  string\n82|}\n83|\n84|// Repository persists Session Records and per-session event chains under\n85|// one data root. All mutating entries serialize on one mutex; files are\n86|// content-addressed and installed no-replace, so the chain is append-only\n87|// by construction and there is no update or delete entry to test.\n88|//\n89|// BeforeWrite fires after validation and before the first durable byte;\n90|// AfterCommit fires after the chain index is durable. Both are nil in\n91|// normal operation. Tests connect them to a secconftest Injector firing\n92|// the owner's own points, so a fault before the write carries safe_retry\n93|// and a fault after it carries recoverable_parked_state.\n94|type Repository struct {\n95|\troot        string\n96|\tmutex       sync.Mutex\n97|\tBeforeWrite func() error\n98|\tAfterCommit func() error\n99|}\n100|\n101|// Open binds a repository to the sessions namespace beneath dataRoot,\n102|// creating it owner-only when absent. The root must be absolute.\n103|func Open(dataRoot string) (*Repository, error) {\n104|\tif !filepath.IsAbs(dataRoot) {\n105|\t\treturn nil, refuse(ErrRepositoryPath, \"data root %q is not absolute\", dataRoot)\n106|\t}\n107|\troot := filepath.Join(dataRoot, \"sessions\")\n108|\tif err := os.MkdirAll(root, 0o700); err != nil {\n109|\t\treturn nil, refuse(ErrRepositoryPath, \"create sessions root %q: %v\", root, err)\n110|\t}\n111|\treturn &Repository{root: root}, nil\n112|}\n113|\n114|// CreateSession validates recordJSON through the canonical owner and\n115|// persists it as a new session. The bytes are stored verbatim.\n116|func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\n117|\trecord, err := decodeSessionRecord(recordJSON)\n118|\tif err != nil {\n119|\t\treturn SessionRef{}, err\n120|\t}\n121|\trepository.mutex.Lock()\n122|\tdefer repository.mutex.Unlock()\n123|\tif repository.BeforeWrite != nil {\n124|\t\tif err := repository.BeforeWrite(); err != nil {\n125|\t\t\treturn SessionRef{}, err\n126|\t\t}\n127|\t}\n128|\tdirectory := repository.sessionDir(record.sessionID)\n129|\tif _, err := os.Stat(directory); err == nil {\n130|\t\tresumed, resumeErr := repository.resumeCreateLocked(directory, record, recordJSON)\n131|\t\tif resumeErr != nil {\n132|\t\t\treturn SessionRef{}, resumeErr\n133|\t\t}\n134|\t\tif !resumed {\n135|\t\t\treturn SessionRef{}, refuse(ErrSessionExists, \"session %s already exists\", record.sessionID)\n136|\t\t}\n137|\t} else {\n138|\t\tif err := os.MkdirAll(directory, 0o700); err != nil {\n139|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session directory: %w\", err)\n140|\t\t}\n141|\t\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n142|\t\t\treturn SessionRef{}, fmt.Errorf(\"install session record: %w\", err)\n143|\t\t}\n144|\t\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n145|\t\t\treturn SessionRef{}, fmt.Errorf(\"create session events directory: %w\", err)\n146|\t\t}\n147|\t\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n148|\t\t\treturn SessionRef{}, err\n149|\t\t}\n150|\t}\n151|\tif repository.AfterCommit != nil {\n152|\t\tif err := repository.AfterCommit(); err != nil {\n153|\t\t\treturn SessionRef{}, err\n154|\t\t}\n155|\t}\n156|\treturn SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil\n157|}\n158|\n159|// resumeCreateLocked completes a create that crashed between the record\n160|// write and the chain write: the stored record bytes must equal the\n161|// retried bytes and the chain must still be absent. Anything else is not\n162|// a resume — the caller refuses it as an existing session. It returns\n163|// plain operational errors; refusal attribution stays at the caller.\n164|func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {\n165|\texisting, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n166|\tif err != nil || !bytes.Equal(existing, recordJSON) {\n167|\t\treturn false, nil\n168|\t}\n169|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); err == nil {\n170|\t\treturn false, nil\n171|\t}\n172|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n173|\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n174|\t}\n175|\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n176|\t\treturn false, err\n177|\t}\n178|\treturn true, nil\n179|}\n180|\n181|// AppendEvent validates eventJSON through the canonical owner and links it\n182|// onto the session chain after the continuity checks. A byte-identical\n183|// retry of an already chained event returns its existing reference without\n184|// duplicating the chain, so a retry after a crashed commit is safe.\n185|func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\n186|\tevent, err := decodeSessionEvent(eventJSON)\n187|\tif err != nil {\n188|\t\treturn EventRef{}, err\n189|\t}\n190|\tif event.sessionID != sessionID {\n191|\t\treturn EventRef{}, refuse(ErrInvalidEvent, \"event session %s does not match target session %s\", event.sessionID, sessionID)\n192|\t}\n193|\trepository.mutex.Lock()\n194|\tdefer repository.mutex.Unlock()\n195|\tview, err := repository.loadSessionLocked(sessionID)\n196|\tif err != nil {\n197|\t\treturn EventRef{}, err\n198|\t}\n199|\tfor position, existing := range view.chain.Events {\n200|\t\tif existing.EventID == event.eventID {\n201|\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n202|\t\t}\n203|\t}\n204|\tif repository.BeforeWrite != nil {\n205|\t\tif err := repository.BeforeWrite(); err != nil {\n206|\t\t\treturn EventRef{}, err\n207|\t\t}\n208|\t}\n209|\tvar tail *EventSummary\n210|\tif len(view.chain.Events) > 0 {\n211|\t\tprevious := view.chain.Events[len(view.chain.Events)-1]\n212|\t\ttail = &previous\n213|\t}\n214|\tif err := checkAppend(view.chain.RecordID, tail, event); err != nil {\n215|\t\t// Losing-lease branches are preserved as immutable blobs but never\n216|\t\t// applied: the bytes stay addressable while the chain is untouched.\n217|\t\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\n218|\t\t\tif preserveErr := installEventBlob(filepath.Join(view.directory, \"events\", blobFileName(event.eventID)), eventJSON); preserveErr != nil {\n219|\t\t\t\treturn EventRef{}, fmt.Errorf(\"preserve unapplied branch: %v: %w\", preserveErr, err)\n220|\t\t\t}\n221|\t\t}\n222|\t\treturn EventRef{}, err\n223|\t}\n224|\tblobPath := filepath.Join(view.directory, \"events\", blobFileName(event.eventID))\n225|\tif err := installEventBlob(blobPath, eventJSON); err != nil {\n226|\t\tif errors.Is(err, errDigestDisagreement) {\n227|\t\t\treturn EventRef{}, refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for event\")\n228|\t\t}\n229|\t\treturn EventRef{}, err\n230|\t}\n231|\tnext := append(append([]EventSummary(nil), view.chain.Events...), eventSummary(event))\n232|\tif err := repository.writeChain(view.directory, storedChain{RecordID: view.chain.RecordID, Events: next}); err != nil {\n233|\t\treturn EventRef{}, err\n234|\t}\n235|\tif repository.AfterCommit != nil {\n236|\t\tif err := repository.AfterCommit(); err != nil {\n237|\t\t\treturn EventRef{}, err\n238|\t\t}\n239|\t}\n240|\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: event.leaseSeq, Position: len(next) - 1}, nil\n241|}\n242|\n243|// eventSummary projects the validated routing members into the chain index.\n244|func eventSummary(event eventView) EventSummary {\n245|\treturn EventSummary{EventID: event.eventID, EventType: event.eventType, LeaseEpoch: event.leaseEpoch, LeaseID: event.leaseID, LeaseSequence: event.leaseSeq, Predecessors: append([]string(nil), event.predecessors...)}\n246|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56b","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":272,"recorded_at":1780531400000539,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"call_id":"call_01a07bd499e57240a712d340ad4f0cd3","text":"Read text file `internal/sessrepo/chain.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"io\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// sessionRecord is the validated identity of one Session Record: the exact\n18|// bytes plus the members the repository must bind (SPEC.md Section 5.1).\n19|type sessionRecord struct {\n20|\traw       []byte\n21|\trecordID  string\n22|\tsessionID string\n23|\tname      string\n24|\tkind      string\n25|\tprovider  string\n26|}\n27|\n28|// eventView is the validated routing surface of one Session Event: the\n29|// exact bytes plus the members the chain rules must read (SPEC.md 5.2).\n30|type eventView struct {\n31|\traw          []byte\n32|\teventID      string\n33|\teventType    string\n34|\tsessionID    string\n35|\tleaseEpoch   uint64\n36|\tleaseID      string\n37|\tleaseSeq     uint64\n38|\tpredecessors []string\n39|}\n40|\n41|// storedChain is the chain index: the record digest plus one entry per\n42|// chained event in authoritative order. The blobs are truth; the index is\n43|// a verified cache rebound to them on every load.\n44|type storedChain struct {\n45|\tRecordID string\n46|\tEvents   []EventSummary\n47|}\n48|\n49|// sessionView is one loaded session: record, index, directory, and name facts.\n50|type sessionView struct {\n51|\tdirectory string\n52|\trecord    sessionRecord\n53|\tchain     storedChain\n54|}\n55|\n56|// decodeSessionRecord runs the three validation layers in order: strict\n57|// frame (environ owner), member shape, then canonical identity and closed\n58|// shape (canonicaljson owner). Each layer refuses before the next runs,\n59|// so every site below is reachable with a vector that clears the earlier\n60|// layers and fails exactly this one.\n61|func decodeSessionRecord(raw []byte) (sessionRecord, error) {\n62|\tmembers, fault := environ.DecodeStrictObject(raw)\n63|\tif fault != nil {\n64|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n65|\t}\n66|\tif schema, err := stringMember(members, \"schema\"); err != nil || schema != sessionRecordSchema {\n67|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n68|\t}\n69|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n70|\tif !ok {\n71|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n72|\t}\n73|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n74|\tif err != nil {\n75|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"verify session record identity: %v\", err)\n76|\t}\n77|\tif field != canonicaljson.SelfRecordID {\n78|\t\treturn sessionRecord{}, fmt.Errorf(\"session record identity field %q, want record_id\", string(field))\n79|\t}\n80|\tname, _ := stringMember(members, \"name\")\n81|\tkind, _ := stringMember(members, \"kind\")\n82|\tprovider, _ := stringMember(members, \"provider_id\")\n83|\treturn sessionRecord{raw: raw, recordID: digest.String(), sessionID: sessionID.String(), name: name, kind: kind, provider: provider}, nil\n84|}\n85|\n86|// decodeSessionEvent runs the same three layers for Session Events: strict\n87|// frame, member shape, then canonical identity and closed payload shape.\n88|func decodeSessionEvent(raw []byte) (eventView, error) {\n89|\tmembers, fault := environ.DecodeStrictObject(raw)\n90|\tif fault != nil {\n91|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"decode session event frame: %v\", fault)\n92|\t}\n93|\tif schema, err := stringMember(members, \"schema\"); err != nil || schema != sessionEventSchema {\n94|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"session event schema %q, want %q\", schema, sessionEventSchema)\n95|\t}\n96|\tevent, err := extractEventMembers(members)\n97|\tif err != nil {\n98|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"session event member: %v\", err)\n99|\t}\n100|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n101|\tif err != nil {\n102|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"verify session event identity: %v\", err)\n103|\t}\n104|\tif field != canonicaljson.SelfEventID {\n105|\t\treturn eventView{}, fmt.Errorf(\"session event identity field %q, want event_id\", string(field))\n106|\t}\n107|\tevent.raw = raw\n108|\tevent.eventID = digest.String()\n109|\treturn event, nil\n110|}\n111|\n112|// extractEventMembers reads the routing members after the frame gate. It\n113|// returns plain errors; the caller attributes them through its one member\n114|// site. Grammar and range rules stay with their owners: UUIDv7 and uint53\n115|// with environ, digests and UUIDv4 with scalar.\n116|func extractEventMembers(members map[string]json.RawMessage) (eventView, error) {\n117|\tvar event eventView\n118|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n119|\tif !ok {\n120|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv7\", \"session_id\")\n121|\t}\n122|\tevent.sessionID = sessionID.String()\n123|\teventType, err := stringMember(members, \"event_type\")\n124|\tif err != nil {\n125|\t\treturn eventView{}, err\n126|\t}\n127|\tevent.eventType = eventType\n128|\tepoch, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_epoch\"), 1, uint53Max)\n129|\tif !ok {\n130|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_epoch\")\n131|\t}\n132|\tevent.leaseEpoch = epoch\n133|\tleaseID, err := stringMember(members, \"lease_id\")\n134|\tif err != nil {\n135|\t\treturn eventView{}, err\n136|\t}\n137|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n138|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv4: %v\", \"lease_id\", err)\n139|\t}\n140|\tevent.leaseID = leaseID\n141|\tsequence, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_sequence\"), 1, uint53Max)\n142|\tif !ok {\n143|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_sequence\")\n144|\t}\n145|\tevent.leaseSeq = sequence\n146|\tpredecessors, err := digestMembers(members, \"predecessors\")\n147|\tif err != nil {\n148|\t\treturn eventView{}, err\n149|\t}\n150|\tif len(predecessors) == 0 {\n151|\t\treturn eventView{}, fmt.Errorf(\"member %q names no predecessor\", \"predecessors\")\n152|\t}\n153|\tevent.predecessors = predecessors\n154|\treturn event, nil\n155|}\n156|\n157|// checkAppend enforces the SPEC.md Section 5.2 chain rules for one event\n158|// against the record and the current tail: the first event links exactly\n159|// the Session Record at sequence 1 with no gap; within one lease the\n160|// sequence increases by exactly one with no repeat and each event\n161|// references the immediately prior authoritative event; a successor lease\n162|// restarts at 1 referencing the predecessor head; a same-epoch second\n163|// lease diverges and a lower epoch is stale. The reload audit folds this\n164|// same check over the stored index, so weakening any arm breaks both the\n165|// append and the reload evidence.\n166|func checkAppend(recordID string, tail *EventSummary, event eventView) error {\n167|\tif tail != nil && event.leaseID != tail.LeaseID {\n168|\t\tif event.leaseEpoch < tail.LeaseEpoch {\n169|\t\t\treturn refuse(ErrStaleLease, \"event lease epoch %d precedes chain head epoch %d\", event.leaseEpoch, tail.LeaseEpoch)\n170|\t\t}\n171|\t\tif event.leaseEpoch == tail.LeaseEpoch {\n172|\t\t\treturn refuse(ErrDivergentBranch, \"event under lease %s diverges from chain head lease %s at epoch %d\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\n173|\t\t}\n174|\t}\n175|\twant := uint64(1)\n176|\tif tail != nil && event.leaseID == tail.LeaseID {\n177|\t\twant = tail.LeaseSequence + 1\n178|\t}\n179|\tif event.leaseSeq < want {\n180|\t\treturn refuse(ErrSequenceRepeat, \"event lease sequence %d repeats chained sequence through %d\", event.leaseSeq, want-1)\n181|\t}\n182|\tif event.leaseSeq > want {\n183|\t\treturn refuse(ErrSequenceGap, \"event lease sequence %d skips chained sequence %d\", event.leaseSeq, want)\n184|\t}\n185|\tif tail == nil {\n186|\t\tif len(event.predecessors) != 1 || event.predecessors[0] != recordID {\n187|\t\t\treturn refuse(ErrPredecessorLink, \"first event must link exactly the session record\")\n188|\t\t}\n189|\t\treturn nil\n190|\t}\n191|\tif !containsDigest(event.predecessors, tail.EventID) {\n192|\t\treturn refuse(ErrPredecessorLink, \"event predecessors omit prior authoritative event\")\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|func containsDigest(haystack []string, needle string) bool {\n198|\tfor _, candidate := range haystack {\n199|\t\tif candidate == needle {\n200|\t\t\treturn true\n201|\t\t}\n202|\t}\n203|\treturn false\n204|}\n205|\n206|// memberRaw reports the raw member for the environ bound checkers. A\n207|// missing member yields nil, which every checker refuses.\n208|func memberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n209|\treturn members[name]\n210|}\n211|\n212|// stringMember reads one string member with the language decoder. Grammar\n213|// rules for the value stay with the shape owner; this only accesses it.\n214|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n215|\traw, ok := members[name]\n216|\tif !ok {\n217|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n218|\t}\n219|\tvar value string\n220|\tif err := json.Unmarshal(raw, &value); err != nil {\n221|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n222|\t}\n223|\treturn value, nil\n224|}\n225|\n226|// digestMembers reads one array of digest strings. Digest grammar stays\n227|// with the scalar owner.\n228|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n229|\traw, ok := members[name]\n230|\tif !ok {\n231|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n232|\t}\n233|\tvar values []string\n234|\tif err := json.Unmarshal(raw, &values); err != nil {\n235|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n236|\t}\n237|\tfor _, value := range values {\n238|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n239|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n240|\t\t}\n241|\t}\n242|\treturn values, nil\n243|}\n244|\n245|// sessionDir maps a validated session ID to its directory. The ID passed\n246|// the scalar UUIDv7 grammar at decode time, so no traversaliedy member can\n247|// reach the join; path policy stays with the scalar and secprim owners.\n248|func (repository *Repository) sessionDir(sessionID string) string {\n249|\treturn filepath.Join(repository.root, sessionID)\n250|}\n251|\n252|// loadSessionLocked loads and fully re-verifies one session: the chain\n253|// index decodes, the record bytes re-verify against the indexed digest,\n254|// every indexed event blob re-verifies, and the index folds clean through\n255|// the append rules. Callers hold the repository mutex.\n256|func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {\n257|\tdirectory := repository.sessionDir(sessionID)\n258|\tif _, err := os.Stat(directory); err != nil {\n259|\t\treturn nil, refuse(ErrUnknownSession, \"unknown session %s\", sessionID)\n260|\t}\n261|\tchainBytes, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n262|\tif err != nil {\n263|\t\treturn nil, refuse(ErrChainCorrupt, \"read chain index for session %s: %v\", sessionID, err)\n264|\t}\n265|\tchain, err := decodeChainIndex(chainBytes)\n266|\tif err != nil {\n267|\t\treturn nil, refuse(ErrChainCorrupt, \"decode chain index for session %s: %v\", sessionID, err)\n268|\t}\n269|\trecordBytes, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n270|\tif err != nil {\n271|\t\treturn nil, refuse(ErrChainCorrupt, \"read session record for session %s: %v\", sessionID, err)\n272|\t}\n273|\trecord, err := decodeSessionRecord(recordBytes)\n274|\tif err != nil {\n275|\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify session record for session %s: %v\", sessionID, err)\n276|\t}\n277|\tif record.recordID != chain.RecordID || record.sessionID != sessionID {\n278|\t\treturn nil, refuse(ErrChainCorrupt, \"chain index does not describe stored session record for session %s\", sessionID)\n279|\t}\n280|\tevents := filepath.Join(directory, \"events\")\n281|\tfor position, indexed := range chain.Events {\n282|\t\tblob, err := os.ReadFile(filepath.Join(events, blobFileName(indexed.EventID)))\n283|\t\tif err != nil {\n284|\t\t\treturn nil, refuse(ErrChainCorrupt, \"read chained event %d for session %s: %v\", position, sessionID, err)\n285|\t\t}\n286|\t\tdigest, field, err := canonicaljson.VerifyObjectIdentity(blob)\n287|\t\tif err != nil || field != canonicaljson.SelfEventID || digest.String() != indexed.EventID {\n288|\t\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)\n289|\t\t}\n290|\t\tvar tail *EventSummary\n291|\t\tif position > 0 {\n292|\t\t\ttail = &chain.Events[position-1]\n293|\t\t}\n294|\t\treplay := eventView{eventID: indexed.EventID, eventType: indexed.EventType, sessionID: sessionID, leaseEpoch: indexed.LeaseEpoch, leaseID: indexed.LeaseID, leaseSeq: indexed.LeaseSequence, predecessors: indexed.Predecessors}\n295|\t\tif err := checkAppend(chain.RecordID, tail, replay); err != nil {\n296|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chain index order breaks continuity at event %d for session %s: %v\", position, sessionID, err)\n297|\t\t}\n298|\t}\n299|\treturn &sessionView{directory: directory, record: record, chain: chain}, nil\n300|}\n301|\n302|// decodeChainIndex decodes the internal chain index. It is not an AX wire\n303|// object, so the canonical owner does not validate it; member grammars\n304|// still stay with environ and scalar.\n305|func decodeChainIndex(raw []byte) (storedChain, error) {\n306|\tmembers, fault := environ.DecodeStrictObject(raw)\n307|\tif fault != nil {\n308|\t\treturn storedChain{}, fmt.Errorf(\"decode chain frame: %v\", fault)\n309|\t}\n310|\trecordID, err := stringMember(members, \"record_id\")\n311|\tif err != nil {\n312|\t\treturn storedChain{}, err\n313|\t}\n314|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n315|\t\treturn storedChain{}, fmt.Errorf(\"chain record_id: %v\", err)\n316|\t}\n317|\trawEvents, ok := members[\"events\"]\n318|\tif !ok {\n319|\t\treturn storedChain{}, fmt.Errorf(\"member %q is absent\", \"events\")\n320|\t}\n321|\tvar entries []map[string]json.RawMessage\n322|\tif err := json.Unmarshal(rawEvents, &entries); err != nil {\n323|\t\treturn storedChain{}, fmt.Errorf(\"member %q is not an object array: %v\", \"events\", err)\n324|\t}\n325|\tchain := storedChain{RecordID: recordID}\n326|\tfor _, entry := range entries {\n327|\t\tsummary, err := decodeChainEntry(entry)\n328|\t\tif err != nil {\n329|\t\t\treturn storedChain{}, err\n330|\t\t}\n331|\t\tchain.Events = append(chain.Events, summary)\n332|\t}\n333|\treturn chain, nil\n334|}\n335|\n336|// decodeChainEntry validates one index entry. Failures are plain errors;\n337|// loadSessionLocked attributes them through its one index site.\n338|func decodeChainEntry(entry map[string]json.RawMessage) (EventSummary, error) {\n339|\tvar summary EventSummary\n340|\teventID, err := stringMember(entry, \"event_id\")\n341|\tif err != nil {\n342|\t\treturn EventSummary{}, err\n343|\t}\n344|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n345|\t\treturn EventSummary{}, fmt.Errorf(\"chain event_id: %v\", err)\n346|\t}\n347|\tsummary.EventID = eventID\n348|\teventType, err := stringMember(entry, \"event_type\")\n349|\tif err != nil {\n350|\t\treturn EventSummary{}, err\n351|\t}\n352|\tsummary.EventType = eventType\n353|\tepoch, ok := environ.CheckUint53Bounds(entry[\"lease_epoch\"], 1, uint53Max)\n354|\tif !ok {\n355|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_epoch\")\n356|\t}\n357|\tsummary.LeaseEpoch = epoch\n358|\tleaseID, err := stringMember(entry, \"lease_id\")\n359|\tif err != nil {\n360|\t\treturn EventSummary{}, err\n361|\t}\n362|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n363|\t\treturn EventSummary{}, fmt.Errorf(\"chain lease_id: %v\", err)\n364|\t}\n365|\tsummary.LeaseID = leaseID\n366|\tsequence, ok := environ.CheckUint53Bounds(entry[\"lease_sequence\"], 1, uint53Max)\n367|\tif !ok {\n368|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_sequence\")\n369|\t}\n370|\tsummary.LeaseSequence = sequence\n371|\tpredecessors, err := digestMembers(entry, \"predecessors\")\n372|\tif err != nil {\n373|\t\treturn EventSummary{}, err\n374|\t}\n375|\tsummary.Predecessors = predecessors\n376|\treturn summary, nil\n377|}\n378|\n379|// writeChain stores the index atomically: temp file, fsync, rename, fsync\n380|// the directory. A crash either leaves the previous index or the new one;\n381|// the blobs it names are verified on every load, so neither outcome can\n382|// invent history.\n383|func (repository *Repository) writeChain(directory string, chain storedChain) error {\n384|\tpayload, err := json.Marshal(chainPayload{RecordID: chain.RecordID, Events: chain.Events})\n385|\tif err != nil {\n386|\t\treturn fmt.Errorf(\"encode chain index: %w\", err)\n387|\t}\n388|\treturn writeAtomic(filepath.Join(directory, \"chain.json\"), payload)\n389|}\n390|\n391|// chainPayload is the on-disk shape of the index. EventSummary carries the\n392|// JSON tags so the stored form stays exactly this struct.\n393|type chainPayload struct {\n394|\tRecordID string         `json:\"record_id\"`\n395|\tEvents   []EventSummary `json:\"events\"`\n396|}\n397|\n398|// errDigestDisagreement reports bytes at a digest path that a completed\n399|// read proved different from the installing candidate. It is an internal\n400|// marker, never a refusal: callers attribute it through their own site.\n401|var errDigestDisagreement = errors.New(\"digest path holds disagreeing bytes\")\n402|\n403|// installEventBlob installs one event blob idempotently: identical bytes\n404|// already present are reused, disagreeing bytes are reported for refusal,\n405|// and the no-replace open keeps the install atomic.\n406|func installEventBlob(path string, data []byte) error {\n407|\tif _, err := os.Stat(path); err == nil {\n408|\t\texisting, readErr := os.ReadFile(path)\n409|\t\tif readErr != nil || !bytes.Equal(existing, data) {\n410|\t\t\treturn errDigestDisagreement\n411|\t\t}\n412|\t\treturn nil\n413|\t}\n414|\tif err := writeExclusive(path, data); err != nil {\n415|\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n416|\t}\n417|\treturn nil\n418|}\n419|\n420|// writeExclusive installs bytes at a path that must not exist. The\n421|// no-replace open makes append-only a filesystem property, not a convention.\n422|func writeExclusive(path string, data []byte) error {\n423|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n424|\tif err != nil {\n425|\t\treturn err\n426|\t}\n427|\tif _, err := file.Write(data); err != nil {\n428|\t\t_ = file.Close()\n429|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n430|\t}\n431|\tif err := file.Sync(); err != nil {\n432|\t\t_ = file.Close()\n433|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n434|\t}\n435|\tif err := file.Close(); err != nil {\n436|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n437|\t}\n438|\treturn nil\n439|}\n440|\n441|// writeAtomic replaces a path through a temp file in the same directory:\n442|// staged bytes fsync before the rename, the directory fsyncs after.\n443|func writeAtomic(path string, data []byte) error {\n444|\tstaged, err := os.CreateTemp(filepath.Dir(path), \".ax-chain-stage-\")\n445|\tif err != nil {\n446|\t\treturn fmt.Errorf(\"stage chain index: %w\", err)\n447|\t}\n448|\tstagedPath := staged.Name()\n449|\tfinished := false\n450|\tdefer func() {\n451|\t\tif !finished {\n452|\t\t\t_ = staged.Close()\n453|\t\t\t_ = os.Remove(stagedPath)\n454|\t\t}\n455|\t}()\n456|\tif err := staged.Chmod(0o600); err != nil {\n457|\t\treturn fmt.Errorf(\"mode staged chain index: %w\", err)\n458|\t}\n459|\tif _, err := io.Copy(staged, bytes.NewReader(data)); err != nil {\n460|\t\treturn fmt.Errorf(\"write staged chain index: %w\", err)\n461|\t}\n462|\tif err := staged.Sync(); err != nil {\n463|\t\treturn fmt.Errorf(\"fsync staged chain index: %w\", err)\n464|\t}\n465|\tif err := staged.Close(); err != nil {\n466|\t\treturn fmt.Errorf(\"close staged chain index: %w\", err)\n467|\t}\n468|\tfinished = true\n469|\tif err := os.Rename(stagedPath, path); err != nil {\n470|\t\treturn fmt.Errorf(\"install chain index: %w\", err)\n471|\t}\n472|\treturn syncDirectory(filepath.Dir(path))\n473|}\n474|\n475|// blobFileName maps a validated event digest to its file name. The digest\n476|// passed scalar grammar at decode time; Hex is the owner's rendering.\n477|func blobFileName(eventID string) string {\n478|\tdigest, err := scalar.ParseDigest(eventID)\n479|\tif err != nil {\n480|\t\treturn \"invalid.json\"\n481|\t}\n482|\treturn digest.Hex() + \".json\"\n483|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56d","stream":{"kind":"session","id":"01a07bd4-2401-7280-a034-9d657f7825ef"},"sequence":273,"recorded_at":1780531400000541,"record_type":"event","durability":"durable","causation_id":"c2c31914-ab73-4f56-a747-9109399dc0be","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c2c31914-ab73-4f56-a747-9109399dc0be","run_stream":{"kind":"run","id":"c2c31914-ab73-4f56-a747-9109399dc0be"},"call_id":"call_01a07bd49aa97ed38c32ad2484edb1b2","text":"Read text file `internal/sessrepo/store.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// syncDirectory fsyncs a directory so a rename inside it survives a crash.\n14|// Opening a directory fails on Windows, where the rename itself is the\n15|// durability boundary; there the sync is skipped, never faked.\n16|func syncDirectory(path string) error {\n17|\tif runtime.GOOS == \"windows\" {\n18|\t\treturn nil\n19|\t}\n20|\tdirectory, err := os.Open(path)\n21|\tif err != nil {\n22|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n23|\t}\n24|\tdefer func() { _ = directory.Close() }()\n25|\tif err := directory.Sync(); err != nil {\n26|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n27|\t}\n28|\treturn nil\n29|}\n30|\n31|// GetRecord returns the byte-identical Session Record for a session,\n32|// re-verified through the canonical owner on every read.\n33|func (repository *Repository) GetRecord(sessionID string) ([]byte, error) {\n34|\trepository.mutex.Lock()\n35|\tdefer repository.mutex.Unlock()\n36|\tview, err := repository.loadSessionLocked(sessionID)\n37|\tif err != nil {\n38|\t\treturn nil, err\n39|\t}\n40|\treturn append([]byte(nil), view.record.raw...), nil\n41|}\n42|\n43|// GetEvent returns the byte-identical chained event for its digest.\n44|func (repository *Repository) GetEvent(sessionID, eventID string) ([]byte, error) {\n45|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n46|\t\treturn nil, refuse(ErrUnknownEvent, \"malformed event id %q\", eventID)\n47|\t}\n48|\trepository.mutex.Lock()\n49|\tdefer repository.mutex.Unlock()\n50|\tview, err := repository.loadSessionLocked(sessionID)\n51|\tif err != nil {\n52|\t\treturn nil, err\n53|\t}\n54|\tfor _, indexed := range view.chain.Events {\n55|\t\tif indexed.EventID == eventID {\n56|\t\t\tblob, err := os.ReadFile(filepath.Join(view.directory, \"events\", blobFileName(eventID)))\n57|\t\t\tif err != nil {\n58|\t\t\t\treturn nil, fmt.Errorf(\"read chained event for session %s: %w\", sessionID, err)\n59|\t\t\t}\n60|\t\t\treturn blob, nil\n61|\t\t}\n62|\t}\n63|\treturn nil, refuse(ErrUnknownEvent, \"unknown event %q in session %s\", eventID, sessionID)\n64|}\n65|\n66|// ListEvents returns the chain summaries in authoritative order.\n67|func (repository *Repository) ListEvents(sessionID string) ([]EventSummary, error) {\n68|\trepository.mutex.Lock()\n69|\tdefer repository.mutex.Unlock()\n70|\tview, err := repository.loadSessionLocked(sessionID)\n71|\tif err != nil {\n72|\t\treturn nil, err\n73|\t}\n74|\treturn append([]EventSummary(nil), view.chain.Events...), nil\n75|}\n76|\n77|// ListSessions returns one summary per stored session in session-ID order.\n78|// A session whose bytes no longer verify fails the listing closed: a\n79|// corrupt session is reported, never skipped.\n80|func (repository *Repository) ListSessions() ([]SessionSummary, error) {\n81|\trepository.mutex.Lock()\n82|\tdefer repository.mutex.Unlock()\n83|\tentries, err := os.ReadDir(repository.root)\n84|\tif err != nil {\n85|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n86|\t}\n87|\tvar summaries []SessionSummary\n88|\tfor _, entry := range entries {\n89|\t\tif !entry.IsDir() {\n90|\t\t\tcontinue\n91|\t\t}\n92|\t\tview, err := repository.loadSessionLocked(entry.Name())\n93|\t\tif err != nil {\n94|\t\t\treturn nil, err\n95|\t\t}\n96|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n97|\t\tif len(view.chain.Events) > 0 {\n98|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n99|\t\t}\n100|\t\tsummaries = append(summaries, summary)\n101|\t}\n102|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n103|\treturn summaries, nil\n104|}\n105|\n106|// Resolve implements the local steps of SPEC.md Section 2.3: an exact live\n107|// session name in the local index wins first; a UUID query routes to its\n108|// session; anything else is not found. Names display with original case\n109|// but collide under ASCII case folding because the allowed alphabet is\n110|// ASCII, and a colliding query fails with ErrNameAmbiguous. Peer-learned\n111|// names and the interactive choice surface belong to the name-resolution\n112|// leaf, which builds on this entry.\n113|func (repository *Repository) Resolve(query string) (SessionSummary, error) {\n114|\trepository.mutex.Lock()\n115|\tdefer repository.mutex.Unlock()\n116|\tsummaries, err := repository.listSessionsLocked()\n117|\tif err != nil {\n118|\t\treturn SessionSummary{}, err\n119|\t}\n120|\tvar folded []SessionSummary\n121|\tfor _, summary := range summaries {\n122|\t\tif asciiFold(summary.Name) == asciiFold(query) {\n123|\t\t\tfolded = append(folded, summary)\n124|\t\t}\n125|\t}\n126|\tif len(folded) > 1 {\n127|\t\treturn SessionSummary{}, refuse(ErrNameAmbiguous, \"name %q collides across %d sessions\", query, len(folded))\n128|\t}\n129|\tif len(folded) == 1 {\n130|\t\treturn folded[0], nil\n131|\t}\n132|\tif id, err := scalar.ParseUUIDv7(query); err == nil {\n133|\t\tfor _, summary := range summaries {\n134|\t\t\tif summary.SessionID == id.String() {\n135|\t\t\t\treturn summary, nil\n136|\t\t\t}\n137|\t\t}\n138|\t}\n139|\treturn SessionSummary{}, refuse(ErrNameNotFound, \"no live session named %q\", query)\n140|}\n141|\n142|// listSessionsLocked shares the listing scan with Resolve without\n143|// re-locking. Corrupt sessions fail it the same closed way.\n144|func (repository *Repository) listSessionsLocked() ([]SessionSummary, error) {\n145|\tentries, err := os.ReadDir(repository.root)\n146|\tif err != nil {\n147|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n148|\t}\n149|\tvar summaries []SessionSummary\n150|\tfor _, entry := range entries {\n151|\t\tif !entry.IsDir() {\n152|\t\t\tcontinue\n153|\t\t}\n154|\t\tview, err := repository.loadSessionLocked(entry.Name())\n155|\t\tif err != nil {\n156|\t\t\treturn nil, err\n157|\t\t}\n158|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n159|\t\tif len(view.chain.Events) > 0 {\n160|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n161|\t\t}\n162|\t\tsummaries = append(summaries, summary)\n163|\t}\n164|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n165|\treturn summaries, nil\n166|}\n167|\n168|// asciiFold folds ASCII uppercase to lowercase and passes every other byte\n169|// through. Session names match [A-Za-z0-9][A-Za-z0-9._-]{0,63} under the\n170|// shape owner, so the fold domain is ASCII by construction and a Unicode\n171|// fold table would be an unowned duplicate, not a reuse.\n172|func asciiFold(value string) string {\n173|\tfolded := make([]byte, 0, len(value))\n174|\tfor index := 0; index < len(value); index++ {\n175|\t\tcharacter := value[index]\n176|\t\tif character >= 'A' && character <= 'Z' {\n177|\t\t\tcharacter += 'a' - 'A'\n178|\t\t}\n179|\t\tfolded = append(folded, character)\n180|\t}\n181|\treturn string(folded)\n182|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
