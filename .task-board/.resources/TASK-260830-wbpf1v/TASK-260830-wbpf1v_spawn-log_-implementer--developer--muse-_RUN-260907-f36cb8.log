{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c3","stream":{"kind":"session","id":"01a07c0a-a85e-7163-b151-07f832301ae1"},"sequence":572,"recorded_at":1780531400001139,"record_type":"event","durability":"durable","causation_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","run_stream":{"kind":"run","id":"effad38b-c422-4dbf-8b01-ea09bebc28e3"},"task_stream":{"kind":"task","id":"a34ac1cc-f84d-45f4-9e00-ef8e21aa1f51"},"task_id":"a34ac1cc-f84d-45f4-9e00-ef8e21aa1f51","event":{"kind":"output","task_id":"a34ac1cc-f84d-45f4-9e00-ef8e21aa1f51","chunk":"Read text file `internal/sessrepo/crash_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n9|)\n10|\n11|// wireCrashPoints connects a repository's write boundaries to the owner's\n12|// crash injector: BeforeWrite fires PointPrepareEnter (before any durable\n13|// byte) and AfterCommit fires PointCommitApply (after the chain index is\n14|// durable). The faults that surface are the owner's typed faults with the\n15|// owner's outcome vocabulary.\n16|func wireCrashPoints(repository *Repository, injector *secconftest.Injector) {\n17|\trepository.BeforeWrite = func() error {\n18|\t\treturn injector.MaybeFail(secconftest.PointPrepareEnter)\n19|\t}\n20|\trepository.AfterCommit = func() error {\n21|\t\treturn injector.MaybeFail(secconftest.PointCommitApply)\n22|\t}\n23|}\n24|\n25|// mustCrashFault fails unless err is the injected fault for the armed point\n26|// carrying the expected outcome.\n27|func mustCrashFault(t *testing.T, err error, point string, outcome secconftest.Outcome, what string) {\n28|\tt.Helper()\n29|\tif err == nil {\n30|\t\tt.Fatalf(\"%s error = nil, want injected fault at %s\", what, point)\n31|\t}\n32|\tvar fault *secconftest.Fault\n33|\tif !errors.As(err, &fault) {\n34|\t\tt.Fatalf(\"%s error = %v, want *secconftest.Fault\", what, err)\n35|\t}\n36|\tif fault.Point() != point {\n37|\t\tt.Fatalf(\"%s point = %q, want %q\", what, fault.Point(), point)\n38|\t}\n39|\tif fault.Outcome() != outcome {\n40|\t\tt.Fatalf(\"%s outcome = %q, want %q\", what, fault.Outcome(), outcome)\n41|\t}\n42|}\n43|\n44|func TestCrashBeforeDurableWriteIsSafeRetryOnCreate(t *testing.T) {\n45|\trepository := openTestRepository(t)\n46|\tinjector := &secconftest.Injector{}\n47|\twireCrashPoints(repository, injector)\n48|\tinjector.Arm(secconftest.PointPrepareEnter)\n49|\t_, err := repository.CreateSession([]byte(specRecordExample))\n50|\tmustCrashFault(t, err, secconftest.PointPrepareEnter, secconftest.OutcomeSafeRetry, \"CreateSession(prepare fault)\")\n51|\t// Nothing mutated: the session is still unknown.\n52|\t_, err = repository.GetRecord(testSessionID)\n53|\tmustErrorIs(t, err, ErrUnknownSession, \"GetRecord(after prepare fault)\")\n54|\t// The identical retry is safe and succeeds.\n55|\treference, err := repository.CreateSession([]byte(specRecordExample))\n56|\tif err != nil {\n57|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n58|\t}\n59|\tif reference.SessionID != testSessionID {\n60|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n61|\t}\n62|}\n63|\n64|func TestCrashBeforeDurableWriteIsSafeRetryOnAppend(t *testing.T) {\n65|\trepository := openTestRepository(t)\n66|\treference := createTestSession(t, repository)\n67|\tinjector := &secconftest.Injector{}\n68|\twireCrashPoints(repository, injector)\n69|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n70|\tinjector.Arm(secconftest.PointPrepareEnter)\n71|\t_, err := repository.AppendEvent(testSessionID, raw)\n72|\tmustCrashFault(t, err, secconftest.PointPrepareEnter, secconftest.OutcomeSafeRetry, \"AppendEvent(prepare fault)\")\n73|\tevents, err := repository.ListEvents(testSessionID)\n74|\tif err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\tif len(events) != 0 {\n78|\t\tt.Fatalf(\"chain after prepare fault = %d events, want 0\", len(events))\n79|\t}\n80|\tfirst, err := repository.AppendEvent(testSessionID, raw)\n81|\tif err != nil {\n82|\t\tt.Fatalf(\"retry AppendEvent error = %v\", err)\n83|\t}\n84|\tif first.Position != 0 || first.LeaseSequence != 1 {\n85|\t\tt.Fatalf(\"retry ref = %+v\", first)\n86|\t}\n87|}\n88|\n89|func TestCrashAfterDurableWriteCountsAsCommittedOnCreate(t *testing.T) {\n90|\trepository := openTestRepository(t)\n91|\tinjector := &secconftest.Injector{}\n92|\twireCrashPoints(repository, injector)\n93|\tinjector.Arm(secconftest.PointCommitApply)\n94|\t_, err := repository.CreateSession([]byte(specRecordExample))\n95|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(commit fault)\")\n96|\t// The crashed commit already performed the durable write: the record\n97|\t// reads back and the operation is terminal, so a retry names the\n98|\t// terminal state instead of duplicating it.\n99|\tstored, err := repository.GetRecord(testSessionID)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"GetRecord after crashed commit error = %v\", err)\n102|\t}\n103|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n104|\t\tt.Fatal(\"record after crashed commit differs\")\n105|\t}\n106|\t_, err = repository.CreateSession([]byte(specRecordExample))\n107|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(after crashed commit)\")\n108|}\n109|\n110|func TestCrashAfterDurableWriteCountsAsCommittedOnAppend(t *testing.T) {\n111|\trepository := openTestRepository(t)\n112|\treference := createTestSession(t, repository)\n113|\tinjector := &secconftest.Injector{}\n114|\twireCrashPoints(repository, injector)\n115|\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.created\", payload: createdPayload(reference.RecordID)})\n116|\tinjector.Arm(secconftest.PointCommitApply)\n117|\t_, err := repository.AppendEvent(testSessionID, raw)\n118|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"AppendEvent(commit fault)\")\n119|\tvar eventID struct {\n120|\t\tEventID string `json:\"event_id\"`\n121|\t}\n122|\tif err := json.Unmarshal(raw, &eventID); err != nil {\n123|\t\tt.Fatal(err)\n124|\t}\n125|\tstored, err := repository.GetEvent(testSessionID, eventID.EventID)\n126|\tif err != nil {\n127|\t\tt.Fatalf(\"GetEvent after crashed commit error = %v\", err)\n128|\t}\n129|\tif string(stored) != string(raw) {\n130|\t\tt.Fatal(\"event after crashed commit differs\")\n131|\t}\n132|\t// The lost-response retry carries the identical bytes and receives the\n133|\t// identical reference without a second chain entry.\n134|\tretry, err := repository.AppendEvent(testSessionID, raw)\n135|\tif err != nil {\n136|\t\tt.Fatalf(\"idempotent retry after crashed commit error = %v\", err)\n137|\t}\n138|\tif retry.EventID != eventID.EventID || retry.Position != 0 {\n139|\t\tt.Fatalf(\"retry ref = %+v, want the committed position\", retry)\n140|\t}\n141|\tevents, err := repository.ListEvents(testSessionID)\n142|\tif err != nil {\n143|\t\tt.Fatal(err)\n144|\t}\n145|\tif len(events) != 1 {\n146|\t\tt.Fatalf(\"chain after crashed commit and retry = %d events, want 1\", len(events))\n147|\t}\n148|\t// Rollback past the crashed commit is forbidden by construction: there\n149|\t// is no rollback entry, and the committed bytes survive every later\n150|\t// refusal on this session.\n151|\t_, err = repository.AppendEvent(testSessionID, buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{eventID.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()}))\n152|\tmustErrorIs(t, err, ErrSequenceRepeat, \"AppendEvent(repeat after parked commit)\")\n153|\tstored, err = repository.GetEvent(testSessionID, eventID.EventID)\n154|\tif err != nil {\n155|\t\tt.Fatal(err)\n156|\t}\n157|\tif string(stored) != string(raw) {\n158|\t\tt.Fatal(\"committed bytes did not survive the later refusal\")\n159|\t}\n160|}\n161|\n162|// armCreateStep wires AfterCreateStep to fire point only at the targeted\n163|// interior step, recording every step reached. The closure — not the\n164|// arm — selects the step, so one armed point proves exactly the targeted\n165|// boundary fired: any other firing order leaves RemainingArmed non-empty\n166|// or the fired prefix wrong.\n167|func armCreateStep(t *testing.T, repository *Repository, target CreateStep, point string) (*secconftest.Injector, *[]CreateStep) {\n168|\tt.Helper()\n169|\tinjector := &secconftest.Injector{}\n170|\tinjector.Arm(point)\n171|\tfired := &[]CreateStep{}\n172|\trepository.AfterCreateStep = func(step CreateStep) error {\n173|\t\t*fired = append(*fired, step)\n174|\t\tif step != target {\n175|\t\t\treturn nil\n176|\t\t}\n177|\t\treturn injector.MaybeFail(point)\n178|\t}\n179|\treturn injector, fired\n180|}\n181|\n182|// mustFiredPrefix fails unless the create reached exactly the expected\n183|// step prefix and the armed point was consumed: a crash point outside\n184|// the window it claims to cover measures nothing.\n185|func mustFiredPrefix(t *testing.T, injector *secconftest.Injector, fired *[]CreateStep, want []CreateStep, what string) {\n186|\tt.Helper()\n187|\tif remaining := injector.RemainingArmed(); len(remaining) != 0 {\n188|\t\tt.Fatalf(\"%s left armed points %q; the interior crash never fired\", what, remaining)\n189|\t}\n190|\tif len(*fired) != len(want) {\n191|\t\tt.Fatalf(\"%s fired steps = %q, want prefix %q\", what, *fired, want)\n192|\t}\n193|\tfor index, step := range want {\n194|\t\tif (*fired)[index] != step {\n195|\t\t\tt.Fatalf(\"%s fired steps = %q, want prefix %q\", what, *fired, want)\n196|\t\t}\n197|\t}\n198|}\n199|\n200|// TestCreateStepCrashAfterSessionDirResumesOnRetry crashes CreateSession\n201|// between the session directory and the record install — the window the\n202|// first revision left unrecoverable. The parked state is a bare\n203|// directory: reads fail closed (including ListSessions, for the whole\n204|// repository, by the documented closed-listing rule), and the identical\n205|// retry resumes the interrupted create instead of reporting a session\n206|// that never existed as existing.\n207|func TestCreateStepCrashAfterSessionDirResumesOnRetry(t *testing.T) {\n208|\trepository := openTestRepository(t)\n209|\tinjector, fired := armCreateStep(t, repository, CreateStepSessionDir, secconftest.PointCommitApply)\n210|\t_, err := repository.CreateSession([]byte(specRecordExample))\n211|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(session-dir fault)\")\n212|\tmustFiredPrefix(t, injector, fired, []CreateStep{CreateStepSessionDir}, \"CreateSession(session-dir fault)\")\n213|\t_, err = repository.GetRecord(testSessionID)\n214|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(parked bare directory)\")\n215|\t_, err = repository.ListSessions()\n216|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListSessions(parked bare directory)\")\n217|\treference, err := repository.CreateSession([]byte(specRecordExample))\n218|\tif err != nil {\n219|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n220|\t}\n221|\tif reference.SessionID != testSessionID {\n222|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n223|\t}\n224|\tstored, err := repository.GetRecord(testSessionID)\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"GetRecord after resumed create error = %v\", err)\n227|\t}\n228|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n229|\t\tt.Fatal(\"record after resumed create differs\")\n230|\t}\n231|\tsummaries, err := repository.ListSessions()\n232|\tif err != nil {\n233|\t\tt.Fatalf(\"ListSessions after resumed create error = %v\", err)\n234|\t}\n235|\tif len(summaries) != 1 || summaries[0].SessionID != testSessionID {\n236|\t\tt.Fatalf(\"sessions after resumed create = %+v, want the one session\", summaries)\n237|\t}\n238|}\n239|\n240|// TestCreateStepCrashAfterRecordResumesOnRetry crashes CreateSession\n241|// between the record install and the events directory: the record is\n242|// durable, the chain is absent, and the identical retry completes the\n243|// index through the resume path, after which the chain continues.\n244|func TestCreateStepCrashAfterRecordResumesOnRetry(t *testing.T) {\n245|\trepository := openTestRepository(t)\n246|\tinjector, fired := armCreateStep(t, repository, CreateStepRecord, secconftest.PointCommitApply)\n247|\t_, err := repository.CreateSession([]byte(specRecordExample))\n248|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(record fault)\")\n249|\tmustFiredPrefix(t, injector, fired, []CreateStep{CreateStepSessionDir, CreateStepRecord}, \"CreateSession(record fault)\")\n250|\t_, err = repository.GetRecord(testSessionID)\n251|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(parked record without chain)\")\n252|\treference, err := repository.CreateSession([]byte(specRecordExample))\n253|\tif err != nil {\n254|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n255|\t}\n256|\tif reference.SessionID != testSessionID {\n257|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n258|\t}\n259|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n260|\tif first.Position != 0 {\n261|\t\tt.Fatalf(\"continued ref = %+v, want position 0\", first)\n262|\t}\n263|}\n264|\n265|// TestCreateStepCrashAfterEventsDirResumesOnRetry crashes CreateSession\n266|// between the events directory and the chain index: same parked shape\n267|// as the record fault, and the identical retry completes it.\n268|func TestCreateStepCrashAfterEventsDirResumesOnRetry(t *testing.T) {\n269|\trepository := openTestRepository(t)\n270|\tinjector, fired := armCreateStep(t, repository, CreateStepEventsDir, secconftest.PointCommitApply)\n271|\t_, err := repository.CreateSession([]byte(specRecordExample))\n272|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(events-dir fault)\")\n273|\tmustFiredPrefix(t, injector, fired, []CreateStep{CreateStepSessionDir, CreateStepRecord, CreateStepEventsDir}, \"CreateSession(events-dir fault)\")\n274|\t_, err = repository.GetRecord(testSessionID)\n275|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(parked record without chain)\")\n276|\treference, err := repository.CreateSession([]byte(specRecordExample))\n277|\tif err != nil {\n278|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n279|\t}\n280|\tif reference.SessionID != testSessionID {\n281|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n282|\t}\n283|\tstored, err := repository.GetRecord(testSessionID)\n284|\tif err != nil {\n285|\t\tt.Fatalf(\"GetRecord after resumed create error = %v\", err)\n286|\t}\n287|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n288|\t\tt.Fatal(\"record after resumed create differs\")\n289|\t}\n290|}\n291|\n292|// TestCreateStepCrashAfterChainCountsAsCommitted crashes CreateSession\n293|// after the chain index is durable but before the operation returns:\n294|// the crashed commit already committed, so the record reads back and\n295|// the retry names the terminal state instead of duplicating it.\n296|func TestCreateStepCrashAfterChainCountsAsCommitted(t *testing.T) {\n297|\trepository := openTestRepository(t)\n298|\tinjector, fired := armCreateStep(t, repository, CreateStepChain, secconftest.PointCommitApply)\n299|\t_, err := repository.CreateSession([]byte(specRecordExample))\n300|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(chain fault)\")\n301|\tmustFiredPrefix(t, injector, fired, []CreateStep{CreateStepSessionDir, CreateStepRecord, CreateStepEventsDir, CreateStepChain}, \"CreateSession(chain fault)\")\n302|\tstored, err := repository.GetRecord(testSessionID)\n303|\tif err != nil {\n304|\t\tt.Fatalf(\"GetRecord after crashed commit error = %v\", err)\n305|\t}\n306|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n307|\t\tt.Fatal(\"record after crashed commit differs\")\n308|\t}\n309|\t_, err = repository.CreateSession([]byte(specRecordExample))\n310|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(after crashed commit)\")\n311|}"}}}
