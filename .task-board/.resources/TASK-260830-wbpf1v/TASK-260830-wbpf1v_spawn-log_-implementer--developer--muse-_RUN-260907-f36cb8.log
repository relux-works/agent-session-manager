{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c457","stream":{"kind":"session","id":"01a07c0a-a85e-7163-b151-07f832301ae1"},"sequence":134,"recorded_at":1780531400000263,"record_type":"event","durability":"durable","causation_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","run_stream":{"kind":"run","id":"effad38b-c422-4dbf-8b01-ea09bebc28e3"},"task_stream":{"kind":"task","id":"c4a30196-76d2-4f7c-9a0f-df2870c6cd02"},"task_id":"c4a30196-76d2-4f7c-9a0f-df2870c6cd02","event":{"kind":"output","task_id":"c4a30196-76d2-4f7c-9a0f-df2870c6cd02","chunk":"Read text file `internal/sessrepo/store.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"sort\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// syncDirectory fsyncs a directory so a rename inside it survives a crash.\n14|// Opening a directory fails on Windows, where the rename itself is the\n15|// durability boundary; there the sync is skipped, never faked.\n16|func syncDirectory(path string) error {\n17|\tif runtime.GOOS == \"windows\" {\n18|\t\treturn nil\n19|\t}\n20|\tdirectory, err := os.Open(path)\n21|\tif err != nil {\n22|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n23|\t}\n24|\tdefer func() { _ = directory.Close() }()\n25|\tif err := directory.Sync(); err != nil {\n26|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n27|\t}\n28|\treturn nil\n29|}\n30|\n31|// GetRecord returns the byte-identical Session Record for a session,\n32|// re-verified through the canonical owner on every read.\n33|func (repository *Repository) GetRecord(sessionID string) ([]byte, error) {\n34|\trepository.mutex.Lock()\n35|\tdefer repository.mutex.Unlock()\n36|\tview, err := repository.loadSessionLocked(sessionID)\n37|\tif err != nil {\n38|\t\treturn nil, err\n39|\t}\n40|\treturn append([]byte(nil), view.record.raw...), nil\n41|}\n42|\n43|// GetEvent returns the byte-identical chained event for its digest.\n44|func (repository *Repository) GetEvent(sessionID, eventID string) ([]byte, error) {\n45|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n46|\t\treturn nil, refuse(ErrUnknownEvent, \"malformed event id %q\", eventID)\n47|\t}\n48|\trepository.mutex.Lock()\n49|\tdefer repository.mutex.Unlock()\n50|\tview, err := repository.loadSessionLocked(sessionID)\n51|\tif err != nil {\n52|\t\treturn nil, err\n53|\t}\n54|\tfor _, indexed := range view.chain.Events {\n55|\t\tif indexed.EventID == eventID {\n56|\t\t\tblob, err := os.ReadFile(filepath.Join(view.directory, \"events\", blobFileName(eventID)))\n57|\t\t\tif err != nil {\n58|\t\t\t\treturn nil, fmt.Errorf(\"read chained event for session %s: %w\", sessionID, err)\n59|\t\t\t}\n60|\t\t\treturn blob, nil\n61|\t\t}\n62|\t}\n63|\treturn nil, refuse(ErrUnknownEvent, \"unknown event %q in session %s\", eventID, sessionID)\n64|}\n65|\n66|// ListEvents returns the chain summaries in authoritative order.\n67|func (repository *Repository) ListEvents(sessionID string) ([]EventSummary, error) {\n68|\trepository.mutex.Lock()\n69|\tdefer repository.mutex.Unlock()\n70|\tview, err := repository.loadSessionLocked(sessionID)\n71|\tif err != nil {\n72|\t\treturn nil, err\n73|\t}\n74|\treturn append([]EventSummary(nil), view.chain.Events...), nil\n75|}\n76|\n77|// ListSessions returns one summary per stored session in session-ID order.\n78|// A session whose bytes no longer verify fails the listing closed: a\n79|// corrupt session is reported, never skipped.\n80|func (repository *Repository) ListSessions() ([]SessionSummary, error) {\n81|\trepository.mutex.Lock()\n82|\tdefer repository.mutex.Unlock()\n83|\tentries, err := os.ReadDir(repository.root)\n84|\tif err != nil {\n85|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n86|\t}\n87|\tvar summaries []SessionSummary\n88|\tfor _, entry := range entries {\n89|\t\tif !entry.IsDir() {\n90|\t\t\tcontinue\n91|\t\t}\n92|\t\tview, err := repository.loadSessionLocked(entry.Name())\n93|\t\tif err != nil {\n94|\t\t\treturn nil, err\n95|\t\t}\n96|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n97|\t\tif len(view.chain.Events) > 0 {\n98|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n99|\t\t}\n100|\t\tsummaries = append(summaries, summary)\n101|\t}\n102|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n103|\treturn summaries, nil\n104|}\n105|\n106|// Resolve implements the local steps of SPEC.md Section 2.3: an exact live\n107|// session name in the local index wins first; a UUID query routes to its\n108|// session; anything else is not found. Names display with original case\n109|// but collide under ASCII case folding because the allowed alphabet is\n110|// ASCII, and a colliding query fails with ErrNameAmbiguous. Peer-learned\n111|// names and the interactive choice surface belong to the name-resolution\n112|// leaf, which builds on this entry.\n113|func (repository *Repository) Resolve(query string) (SessionSummary, error) {\n114|\trepository.mutex.Lock()\n115|\tdefer repository.mutex.Unlock()\n116|\tsummaries, err := repository.listSessionsLocked()\n117|\tif err != nil {\n118|\t\treturn SessionSummary{}, err\n119|\t}\n120|\tvar folded []SessionSummary\n121|\tfor _, summary := range summaries {\n122|\t\tif asciiFold(summary.Name) == asciiFold(query) {\n123|\t\t\tfolded = append(folded, summary)\n124|\t\t}\n125|\t}\n126|\tif len(folded) > 1 {\n127|\t\treturn SessionSummary{}, refuse(ErrNameAmbiguous, \"name %q collides across %d sessions\", query, len(folded))\n128|\t}\n129|\tif len(folded) == 1 {\n130|\t\treturn folded[0], nil\n131|\t}\n132|\tif id, err := scalar.ParseUUIDv7(query); err == nil {\n133|\t\tfor _, summary := range summaries {\n134|\t\t\tif summary.SessionID == id.String() {\n135|\t\t\t\treturn summary, nil\n136|\t\t\t}\n137|\t\t}\n138|\t}\n139|\treturn SessionSummary{}, refuse(ErrNameNotFound, \"no live session named %q\", query)\n140|}\n141|\n142|// listSessionsLocked shares the listing scan with Resolve without\n143|// re-locking. Corrupt sessions fail it the same closed way.\n144|func (repository *Repository) listSessionsLocked() ([]SessionSummary, error) {\n145|\tentries, err := os.ReadDir(repository.root)\n146|\tif err != nil {\n147|\t\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\n148|\t}\n149|\tvar summaries []SessionSummary\n150|\tfor _, entry := range entries {\n151|\t\tif !entry.IsDir() {\n152|\t\t\tcontinue\n153|\t\t}\n154|\t\tview, err := repository.loadSessionLocked(entry.Name())\n155|\t\tif err != nil {\n156|\t\t\treturn nil, err\n157|\t\t}\n158|\t\tsummary := SessionSummary{SessionID: view.record.sessionID, RecordID: view.record.recordID, Name: view.record.name, Kind: view.record.kind, ProviderID: view.record.provider, EventCount: len(view.chain.Events)}\n159|\t\tif len(view.chain.Events) > 0 {\n160|\t\t\tsummary.TailEvent = view.chain.Events[len(view.chain.Events)-1].EventID\n161|\t\t}\n162|\t\tsummaries = append(summaries, summary)\n163|\t}\n164|\tsort.Slice(summaries, func(i, j int) bool { return summaries[i].SessionID < summaries[j].SessionID })\n165|\treturn summaries, nil\n166|}\n167|\n168|// asciiFold folds ASCII uppercase to lowercase and passes every other byte\n169|// through. Session names match [A-Za-z0-9][A-Za-z0-9._-]{0,63} under the\n170|// shape owner, so the fold domain is ASCII by construction and a Unicode\n171|// fold table would be an unowned duplicate, not a reuse.\n172|func asciiFold(value string) string {\n173|\tfolded := make([]byte, 0, len(value))\n174|\tfor index := 0; index < len(value); index++ {\n175|\t\tcharacter := value[index]\n176|\t\tif character >= 'A' && character <= 'Z' {\n177|\t\t\tcharacter += 'a' - 'A'\n178|\t\t}\n179|\t\tfolded = append(folded, character)\n180|\t}\n181|\treturn string(folded)\n182|}"}}}
