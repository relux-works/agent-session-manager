it-only SURVIVED 'behavioral test reddened (not audit-only)'\\n  fi\\n  restore\\n}\\n\\ncontrols() {\\n  echo \\\"== harness controls ==\\\"\\n  # X1 NOT_APPLIED: pattern is absent; the tree must be provably untouched.\\n  n=$(python3 - internal/sessrepo/chain.go '__absent_pattern_xyz__' <<'EOF'\\nimport sys\\nsrc = open(sys.argv[1]).read()\\nprint(src.count(sys.argv[2]))\\nEOF\\n)\\n  if [ \\\"$n\\\" = \\\"0\\\" ] && sha256sum -c \\\"$SNAP/pre.sha\\\" > /dev/null 2>&1; then\\n    echo \\\"X1 [NOT_APPLIED] — absent pattern: not applied, tree checksums unchanged\\\"\\n  else\\n    echo \\\"X1 control broken\\\"\\n    FAIL_COUNT=$((FAIL_COUNT + 1))\\n  fi\\n  # X2 COMPILE_FAIL: broken tree fails distinctly from killed/survived.\\n  printf '\\\\n}\\\\n' >> internal/sessrepo/chain.go\\n  if go build \\\"$PKG\\\" > /dev/null 2>&1; then\\n    echo \\\"X2 [COMPILE_FAIL] UNEXPECTEDLY BUILT\\\"\\n    FAIL_COUNT=$((FAIL_COUNT + 1))\\n  else\\n    echo \\\"X2 [COMPILE_FAIL] — broken tree fails the build distinctly\\\"\\n  fi\\n  restore\\n}\\n\\nsnapshot\\nbaseline\\n\\nGROUP=\\\"${1:-all}\\\"\\ncase \\\"$GROUP\\\" in\\n  narrowing-write) narrowing_write ;;\\n  narrowing-load) narrowing_load ;;\\n  deletion) deletion ;;\\n  gateonly) gateonly ;;\\n  controls) controls ;;\\n  all) narrowing_write; narrowing_load; deletion; gateonly; controls ;;\\n  *) echo \\\"unknown group $GROUP\\\" >&2; exit 2 ;;\\nesac\\n\\necho \\\"\\\"\\necho \\\"== results ==\\\"\\necho \\\"$RESULTS\\\" | grep -v '^$'\\necho \\\"\\\"\\necho \\\"applied verdicts: KILLED=$PASS_COUNT SURVIVED=$FAIL_COUNT (controls excluded)\\\"\\nrestore\\nif [ \\\"$FAIL_COUNT\\\" -ne 0 ]; then\\n  exit 1\\nfi\\n\\n\",\n  \"original_output_bytes\": 8156,\n  \"original_output_tokens\": 2039,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
