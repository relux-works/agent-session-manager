{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c853","stream":{"kind":"session","id":"01a07c0a-a85e-7163-b151-07f832301ae1"},"sequence":644,"recorded_at":1780531400001283,"record_type":"event","durability":"durable","causation_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","run_stream":{"kind":"run","id":"effad38b-c422-4dbf-8b01-ea09bebc28e3"},"task_stream":{"kind":"task","id":"1156589f-1110-4528-a8cc-d84fc772db3c"},"task_id":"1156589f-1110-4528-a8cc-d84fc772db3c","event":{"kind":"output","task_id":"1156589f-1110-4528-a8cc-d84fc772db3c","chunk":"{\n  \"chunk_id\": \"exec-27-1\",\n  \"command\": \"ls .temp/TASK-260830-wbpf1v/ 2>/dev/null; echo \\\"===\\\"; cat .temp/TASK-260830-wbpf1v/mutation_battery.sh 2>/dev/null | head -n 250\",\n  \"description\": \"Find local battery script\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"mutation_battery.sh\\nmutation-battery.log\\nreview\\n===\\n#!/bin/bash\\n# Mutation battery v2 for TASK-260830-wbpf1v (internal/sessrepo + provhost gate).\\n#\\n# Denominator: production-derived. The refusal census derives 36 refuse()\\n# sites from production AST (sessrepo.go 5, chain.go 25, store.go 6); the\\n# mechanism targets below name the non-refuse gates the census cannot see\\n# (O_EXCL install flag, resume byte-equality, binding-equality halves,\\n# load re-verification arms). Every mutant is applied with an exact-count\\n# string replacement that aborts unless the pattern occurs exactly as\\n# stated, and the tree is restored by checksum after each mutant.\\n#\\n# Classes (reported separately, never folded):\\n#   narrowing    — gate stays present, weakened to admit exactly one member\\n#                  of the class it must reject; a named test must fail.\\n#   arm-deletion — the refusal effect is removed; a named test must fail.\\n#   census-only  — behavioral suite stays green; the full-package census\\n#                  gate fails (unrouted funnel / unregistered site).\\n#   audit-only   — behavioral suite stays green; the full-package alias /\\n#                  derivation audit fails.\\n#   NOT_APPLIED  — harness control: pattern absent, tree provably untouched.\\n#   COMPILE_FAIL — harness control: broken tree fails distinctly.\\n#\\n# Usage: mutation_battery.sh [group]\\n#   groups: narrowing-write | narrowing-load | deletion | gateonly | controls | all\\n#   default: all\\nset -u\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"$0\\\")\\\" && pwd)\\\"\\nW=\\\"$(cd \\\"$SCRIPT_DIR/../..\\\" && pwd)\\\"\\ncd \\\"$W\\\" || exit 1\\n\\nPKG=./internal/sessrepo\\nSNAP=\\\"$(mktemp -d)\\\"\\ntrap 'rm -rf \\\"$SNAP\\\"' EXIT\\n\\nPASS_COUNT=0\\nFAIL_COUNT=0\\nRESULTS=\\\"\\\"\\n\\nsnapshot() {\\n  mkdir -p \\\"$SNAP/sessrepo\\\" \\\"$SNAP/provhost\\\"\\n  cp internal/sessrepo/chain.go internal/sessrepo/sessrepo.go internal/sessrepo/store.go \\\"$SNAP/sessrepo/\\\"\\n  sha256sum internal/sessrepo/chain.go internal/sessrepo/sessrepo.go internal/sessrepo/store.go > \\\"$SNAP/pre.sha\\\"\\n}\\n\\nrestore() {\\n  cp \\\"$SNAP/sessrepo/chain.go\\\" \\\"$SNAP/sessrepo/store.go\\\" \\\"$SNAP/sessrepo/sessrepo.go\\\" internal/sessrepo/\\n  if ! sha256sum -c \\\"$SNAP/pre.sha\\\" > /dev/null 2>&1; then\\n    echo \\\"FATAL: restore checksum mismatch; tree left dirty\\\" >&2\\n    exit 1\\n  fi\\n}\\n\\n# mutate <file> <old> <new> <count> — exact-count replacement or the whole\\n# battery aborts: a mutant that did not apply exactly as stated proves\\n# nothing and must never be recorded as a kill or a survivor.\\nmutate() {\\n  python3 - \\\"$1\\\" \\\"$2\\\" \\\"$3\\\" \\\"$4\\\" <<'EOF'\\nimport sys\\npath, old, new, want = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])\\n# Patterns in this script spell tabs and newlines as \\\\t and \\\\n inside\\n# single-quoted shell strings; decode them to the real characters before\\n# matching. No production span below contains a literal backslash, so the\\n# decode cannot collide with source text (verified by the exact counts).\\nold = old.encode(\\\"utf-8\\\").decode(\\\"unicode_escape\\\")\\nnew = new.encode(\\\"utf-8\\\").decode(\\\"unicode_escape\\\")\\nsrc = open(path).read()\\nn = src.count(old)\\nif n != want:\\n    print(f\\\"MUTATE ABORT: pattern occurs {n}x, want {want}x: {old[:100]!r}\\\")\\n    sys.exit(3)\\nopen(path, \\\"w\\\").write(src.replace(old, new))\\nEOF\\n  rc=$?\\n  if [ $rc -ne 0 ]; then\\n    echo \\\"FATAL: mutant did not apply; restoring and aborting\\\" >&2\\n    restore\\n    exit $rc\\n  fi\\n}\\n\\nrecord() {\\n  # record <id> <class> <verdict> <detail>\\n  RESULTS=\\\"$RESULTS\\n$1 [$2] $3 — $4\\\"\\n  if [ \\\"$3\\\" = \\\"KILLED\\\" ]; then\\n    PASS_COUNT=$((PASS_COUNT + 1))\\n  else\\n    FAIL_COUNT=$((FAIL_COUNT + 1))\\n  fi\\n  echo \\\"$1 [$2] $3 — $4\\\"\\n}\\n\\n# run_fail <test-regex> — expects the named behavioral test to FAIL.\\nrun_fail() {\\n  out=$(go test \\\"$PKG\\\" -count=1 -run \\\"$1\\\" 2>&1)\\n  code=$?\\n  if [ $code -eq 0 ]; then\\n    echo \\\"$out\\\" | tail -3\\n    return 1\\n  fi\\n  if ! echo \\\"$out\\\" | grep -q \\\"^--- FAIL\\\"; then\\n    echo \\\"$out\\\" | tail -5\\n    return 1\\n  fi\\n  return 0\\n}\\n\\n# run_pass <test-regex> — expects green.\\nrun_pass() {\\n  out=$(go test \\\"$PKG\\\" -count=1 -run \\\"$1\\\" 2>&1)\\n  code=$?\\n  if [ $code -ne 0 ]; then\\n    echo \\\"$out\\\" | tail -5\\n    return 1\\n  fi\\n  return 0\\n}\\n\\n# run_gate_fail — expects the FULL package run (with TestMain census) to fail\\n# AND to name the census/audit cause: any other failure is not this kill.\\nrun_gate_fail() {\\n  out=$(go test \\\"$PKG\\\" -count=1 2>&1)\\n  code=$?\\n  if [ $code -eq 0 ]; then\\n    return 1\\n  fi\\n  hits=$(echo \\\"$out\\\" | grep -E \\\"refusal site without|refusals raised outside|outside direct-call position|outside the derived inventory|never reached beneath|observed refusal codes\\\" | head -3)\\n  if [ -z \\\"$hits\\\" ]; then\\n    echo \\\"$out\\\" | tail -5\\n    return 1\\n  fi\\n  echo \\\"$hits\\\"\\n  return 0\\n}\\n\\nbaseline() {\\n  echo \\\"== baseline ==\\\"\\n  go build ./... || { echo \\\"FATAL: baseline build red\\\"; exit 1; }\\n  go test \\\"$PKG\\\" -count=1 > /dev/null 2>&1 || { echo \\\"FATAL: baseline package red\\\"; exit 1; }\\n  go test ./internal/provhost/ -count=1 -run 'TestNoProductionPath|TestAttestationAllowlist' > /dev/null 2>&1 || { echo \\\"FATAL: baseline provhost gate red\\\"; exit 1; }\\n  echo \\\"baseline green\\\"\\n}\\n\\nnarrowing_write() {\\n  echo \\\"== narrowing: write path ==\\\"\\n  # N1 gap arm admits gap-of-1\\n  mutate internal/sessrepo/chain.go 'if event.leaseSeq > want {' 'if event.leaseSeq > want+1 {' 1\\n  if run_fail 'TestAppendEventRefusesSequenceGap'; then record N1 narrowing KILLED 'gap arm admits gap-of-1; TestAppendEventRefusesSequenceGap'; else record N1 narrowing SURVIVED 'TestAppendEventRefusesSequenceGap stayed green'; fi\\n  restore\\n\\n  # N2 repeat arm admits the exact last-sequence repeat\\n  mutate internal/sessrepo/chain.go 'if event.leaseSeq < want {' 'if event.leaseSeq+1 < want {' 1\\n  if run_fail 'TestAppendEventRefusesSequenceRepeat'; then record N2 narrowing KILLED 'repeat arm admits exact repeat; TestAppendEventRefusesSequenceRepeat'; else record N2 narrowing SURVIVED 'TestAppendEventRefusesSequenceRepeat stayed green'; fi\\n  restore\\n\\n  # N3 first-link arm admits extra predecessors\\n  mutate internal/sessrepo/chain.go 'if len(event.predecessors) != 1 || event.predecessors[0] != recordID {' 'if len(event.predecessors) < 1 || event.predecessors[0] != recordID {' 1\\n  if run_fail 'TestAppendEventRefusesFirstPredecessorMismatch'; then record N3 narrowing KILLED 'first-link admits extras; TestAppendEventRefusesFirstPredecessorMismatch'; else record N3 narrowing SURVIVED 'first-predecessor test stayed green'; fi\\n  restore\\n\\n  # N4 predecessor arm admits any non-empty wrong link\\n  mutate internal/sessrepo/chain.go 'if !containsDigest(event.predecessors, tail.EventID) {' 'if len(event.predecessors) == 0 {' 1\\n  if run_fail 'TestAppendEventRefusesLaterPredecessorMismatch'; then record N4 narrowing KILLED 'predecessor arm admits wrong link; TestAppendEventRefusesLaterPredecessorMismatch'; else record N4 narrowing SURVIVED 'later-predecessor test stayed green'; fi\\n  restore\\n\\n  # N5 record schema gate admits the session-event class\\n  mutate internal/sessrepo/chain.go 'err != nil || schema != sessionRecordSchema' 'err != nil || schema != sessionEventSchema' 1\\n  if run_fail 'TestCreateSessionRefusesForeignSchema'; then record N5 narrowing KILLED 'record gate admits one foreign class; TestCreateSessionRefusesForeignSchema'; else record N5 narrowing SURVIVED 'foreign-schema test stayed green'; fi\\n  restore\\n\\n  # N6 fold stops at T (admits U-Z collisions; vector carries Y)\\n  mutate internal/sessrepo/store.go \\\"character <= 'Z'\\\" \\\"character <= 'T'\\\" 1\\n  if run_fail 'TestResolveRefusesCaseFoldCollision'; then record N6 narrowing KILLED 'fold admits U-Z collisions; TestResolveRefusesCaseFoldCollision'; else record N6 narrowing SURVIVED 'collision test stayed green'; fi\\n  restore\\n}\\n\\nnarrowing_load() {\\n  echo \\\"== narrowing: load and recovery paths ==\\\"\\n  # N7 self-field arm admits exactly the record_id class (provider-identity)\\n  mutate internal/sessrepo/chain.go '\\t\\tif field != canonicaljson.SelfEventID {' '\\t\\tif field != canonicaljson.SelfEventID && field != canonicaljson.SelfRecordID {' 1\\n  if run_fail 'TestLoadRefusesProviderIdentityBlobAtEventPath'; then record N7 narrowing KILLED 'field arm admits record_id blobs; TestLoadRefusesProviderIdentityBlobAtEventPath'; else record N7 narrowing SURVIVED 'provider-identity test stayed green'; fi\\n  # narrowing evidence: the sibling arms still refuse under N7\\n  if run_pass 'TestLoadRefusesSwappedEventBlobs|TestLoadRefusesTamperedEventBlob'; then echo \\\"N7 narrowing control green (digest/verify arms hold)\\\"; else echo \\\"N7 narrowing control RED\\\"; fi\\n  restore\\n\\n  # N8 digest arm admits exactly well-formed-but-misplaced events\\n  mutate internal/sessrepo/chain.go '\\t\\tif digest.String() != indexed.EventID {' '\\t\\tif digest.String() != indexed.EventID && field != canonicaljson.SelfEventID {' 1\\n  if run_fail 'TestLoadRefusesSwappedEventBlobs'; then record N8 narrowing KILLED 'digest arm admits substitution; TestLoadRefusesSwappedEventBlobs'; else record N8 narrowing SURVIVED 'swap test stayed green'; fi\\n  if run_pass 'TestLoadRefusesTamperedEventBlob'; then echo \\\"N8 narrowing control green (verify arm holds)\\\"; else echo \\\"N8 narrowing control RED\\\"; fi\\n  restore\\n\\n  # N9 no-replace open becomes truncate (M2)\\n  mutate internal/sessrepo/chain.go 'os.O_WRONLY|os.O_CREATE|os.O_EXCL' 'os.O_WRONLY|os.O_CREATE|os.O_TRUNC' 1\\n  if run_fail 'TestAppendEventRefusesDisagreeingDigestPathBytes|TestAppendEventRefusesDisagreeingBytesAcrossHandles'; then record N9 narrowing KILLED 'O_TRUNC admits disagreeing bytes; disagreeing-bytes tests'; else record N9 narrowing SURVIVED 'disagreeing-bytes tests stayed green'; fi\\n  if run_pass 'TestAppendEventIdempotentRetry|TestAppendEventChainInOrder'; then echo \\\"N9 narrowing control green (identical-byte installs hold)\\\"; else echo \\\"N9 narrowing control RED\\\"; fi\\n  restore\\n\\n  # N10 resume equality compares lengths only (M6); two hunks, one mutant\\n  mutate internal/sessrepo/sessrepo.go 'if !bytes.Equal(existing, recordJSON) {' 'if len(existing) != len(recordJSON) {' 1\\n  mutate internal/sessrepo/sessrepo.go '\\t\\\"bytes\\\"\\n' '' 1\\n  if run_fail 'TestCreateSessionRefusesResumeWithDifferingBytes'; then record N10 narrowing KILLED 'length-only equality admits same-length collision; TestCreateSessionRefusesResumeWithDifferingBytes'; else record N10 narrowing SURVIVED 'resume-collision test stayed green'; fi\\n  restore\\n\\n  # N11 binding drops the session-ID half (M7)\\n  mutate internal/sessrepo/chain.go 'if record.recordID != chain.RecordID || record.sessionID != sessionID {' 'if record.recordID != chain.RecordID {' 1\\n  if run_fail 'TestLoadRefusesMismatchedSessionBinding'; then record N11 narrowing KILLED 'binding admits cross-session record; TestLoadRefusesMismatchedSessionBinding'; else record N11 narrowing SURVIVED 'session-binding test stayed green'; fi\\n  restore\\n\\n  # N12 binding drops the record-digest half (M8)\\n  mutate internal/sessrepo/chain.go 'if record.recordID != chain.RecordID || record.sessionID != sessionID {' 'if record.sessionID != sessionID {' 1\\n  if run_fail 'TestLoadRefusesDetachedChainIndexWithReboundPredecessors'; then record N12 narrowing KILLED 'binding admits detached index; TestLoadRefusesDetachedChainIndexWithReboundPredecessors'; else record N12 narrowing SURVIVED 'rebound test stayed green'; fi\\n  # witness precision: the older detached test passes here (downstream arm), proving the new test names its clause\\n  if run_pass 'TestLoadRefusesDetachedChainIndex$'; then echo \\\"N12 precision control green (old detached test passes via continuity arm)\\\"; else echo \\\"N12 precision control RED\\\"; fi\\n  restore\\n}\\n\\ndeletion() {\\n  echo \\\"== arm-deletion ==\\\"\\n  # D1 delete gap arm\\n  mutate internal/sessrepo/chain.go '\\tif event.leaseSeq > want {\\n\\t\\treturn refuse(ErrSequenceGap, \\\"event lease sequence %d skips chained sequence %d\\\", event.leaseSeq, want)\\n\\t}\\n' '' 1\\n  if run_fail 'TestAppendEventRefusesSequenceGap'; then record D1 arm-deletion KILLED 'TestAppendEventRefusesSequenceGap'; else record D1 arm-deletion SURVIVED 'gap test stayed green'; fi\\n  restore\\n\\n  # D2 delete repeat arm\\n  mutate internal/sessrepo/chain.go '\\tif event.leaseSeq < want {\\n\\t\\treturn refuse(ErrSequenceRepeat, \\\"event lease sequence %d repeats chained sequence through %d\\\", event.leaseSeq, want-1)\\n\\t}\\n' '' 1\\n  if run_fail 'TestAppendEventRefusesSequenceRepeat'; then record D2 arm-deletion KILLED 'TestAppendEventRefusesSequenceRepeat'; else record D2 arm-deletion SURVIVED 'repeat test stayed green'; fi\\n  restore\\n\\n  # D3 delete divergent arm\\n  mutate internal/sessrepo/chain.go '\\t\\tif event.leaseEpoch == tail.LeaseEpoch {\\n\\t\\t\\treturn refuse(ErrDivergentBranch, \\\"event under lease %s diverges from chain head lease %s at epoch %d\\\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\\n\\t\\t}\\n' '' 1\\n  if run_fail 'TestAppendEventPreservesDivergentBranchWithoutApplying'; then record D3 arm-deletion KILLED 'TestAppendEventPreservesDivergentBranchWithoutApplying'; else record D3 arm-deletion SURVIVED 'divergent test stayed green'; fi\\n  restore\\n\\n  # D4 delete idempotent-retry branch\\n  mutate internal/sessrepo/sessrepo.go '\\tfor position, existing := range view.chain.Events {\\n\\t\\tif existing.EventID == event.eventID {\\n\\t\\t\\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\\n\\t\\t}\\n\\t}\\n\",\n  \"original_output_bytes\": 13158,\n  \"original_output_tokens\": 3290,\n  \"truncated\": false\n}"}}}
