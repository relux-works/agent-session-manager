{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c517","stream":{"kind":"session","id":"01a07c0a-a85e-7163-b151-07f832301ae1"},"sequence":230,"recorded_at":1780531400000455,"record_type":"event","durability":"durable","causation_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","run_stream":{"kind":"run","id":"effad38b-c422-4dbf-8b01-ea09bebc28e3"},"task_stream":{"kind":"task","id":"98cc1892-9e7e-4711-9d23-04a4dc0e6679"},"task_id":"98cc1892-9e7e-4711-9d23-04a4dc0e6679","event":{"kind":"output","task_id":"98cc1892-9e7e-4711-9d23-04a4dc0e6679","chunk":"{\n  \"chunk_id\": \"exec-8-1\",\n  \"command\": \"task-board --help 2>&1 | head -n 80; echo \\\"===\\\"; TASK_BOARD_DIR=/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board task-board m --help 2>&1 | head -n 60\",\n  \"description\": \"Check task-board commands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n===\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\nAuth (always local):\\n  login(user=..., token=...)           Store token in credentials file\\n  logout()                             Remove active user's token\\n  switch_user(user=...)                Switch active user for remote\\n\\nSafety:\\n  --dry-run     Preview mutation without applying\\n  --confirm     Required for every schema-classified destructive mutation\\n\\nIntrospection:\\n  task-board q 'schema(mutation=NAME)' Show one mutation signature\\n\\nExamples:\\n  task-board m --format json 'set_status(TASK-260218-abc, status=development)'\\n  task-board m --format json 'normalize_legacy_status(STORY-260713-72b914, expected_raw=\\\"in-progress\\\", status=development)'\\n  task-board m --format json 'set_status(STORY-260218-abc, status=done, commit_ack=scope_committed)'\\n  task-board m --format json 'set_estimate(TASK-260218-abc, estimate=estimated, scale=fibonacci, number=5)'\\n  task-board m --format compact 'assign(TASK-260218-abc, agent=claude-opus)'\\n  task-board m --format json --dry-run 'delete(TASK-260218-abc)'\\n  task-board m --format json --dry-run 'remove_checklist_item(TASK-260218-abc, item=2)'\\n  task-board m --format json --confirm 'remove_checklist_item(TASK-260218-abc, item=2)'\\n  task-board m --format json --confirm 'delete(TASK-260218-abc)'\\n\\nUsage:\\n  task-board m <mutation> [flags]\\n\\nAliases:\\n  m, mutate\\n\\nFlags:\\n\",\n  \"original_output_bytes\": 6175,\n  \"original_output_tokens\": 1544,\n  \"truncated\": false\n}"}}}
