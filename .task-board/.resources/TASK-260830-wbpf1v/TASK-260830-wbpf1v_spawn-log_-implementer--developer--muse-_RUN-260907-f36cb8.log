{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb23","stream":{"kind":"session","id":"01a07c0a-a85e-7163-b151-07f832301ae1"},"sequence":1004,"recorded_at":1780531400002003,"record_type":"event","durability":"durable","causation_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","run_stream":{"kind":"run","id":"effad38b-c422-4dbf-8b01-ea09bebc28e3"},"task_stream":{"kind":"task","id":"1aa4805f-de9a-4540-8de0-c86e09563b1c"},"task_id":"1aa4805f-de9a-4540-8de0-c86e09563b1c","event":{"kind":"output","task_id":"1aa4805f-de9a-4540-8de0-c86e09563b1c","chunk":"Read text file `internal/sessrepo/crash_test.go`.\n(215 line(s) above)\n216|\tif err != nil {\n217|\t\tt.Fatalf(\"ListSessions(parked bare directory) error = %v\", err)\n218|\t}\n219|\tif len(summaries) != 1 {\n220|\t\tt.Fatalf(\"ListSessions(parked bare directory) = %d entries, want 1 parked\", len(summaries))\n221|\t}\n222|\tmustParkedEntry(t, summaries[0], testSessionID, retryHintForBareDirectory, \"ListSessions(parked bare directory)\")\n223|\treference, err := repository.CreateSession([]byte(specRecordExample))\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n226|\t}\n227|\tif reference.SessionID != testSessionID {\n228|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n229|\t}\n230|\tstored, err := repository.GetRecord(testSessionID)\n231|\tif err != nil {\n232|\t\tt.Fatalf(\"GetRecord after resumed create error = %v\", err)\n233|\t}\n234|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n235|\t\tt.Fatal(\"record after resumed create differs\")\n236|\t}\n237|\tsummaries, err := repository.ListSessions()\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"ListSessions after resumed create error = %v\", err)\n240|\t}\n241|\tif len(summaries) != 1 || summaries[0].SessionID != testSessionID {\n242|\t\tt.Fatalf(\"sessions after resumed create = %+v, want the one session\", summaries)\n243|\t}\n244|}\n245|\n246|// TestCreateStepCrashAfterRecordResumesOnRetry crashes CreateSession\n247|// between the record install and the events directory: the record is\n248|// durable, the chain is absent, and the identical retry completes the\n249|// index through the resume path, after which the chain continues.\n250|func TestCreateStepCrashAfterRecordResumesOnRetry(t *testing.T) {\n251|\trepository := openTestRepository(t)\n252|\tinjector, fired := armCreateStep(t, repository, CreateStepRecord, secconftest.PointCommitApply)\n253|\t_, err := repository.CreateSession([]byte(specRecordExample))\n254|\tmustCrashFault(t, err, secconftest.PointCommitApply, secconftest.OutcomeRecoverableParked, \"CreateSession(record fault)\")\n255|\tmustFiredPrefix(t, injector, fired, []CreateStep{CreateStepSessionDir, CreateStepRecord}, \"CreateSession(record fault)\")\n256|\t_, err = repository.GetRecord(testSessionID)\n257|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(parked record without chain)\")\n258|\treference, err := repository.CreateSession([]byte(specRecordExample))\n259|\tif err != nil {\n260|\t\tt.Fatalf(\"retry CreateSession error = %v\", err)\n261|\t}\n262|\tif reference.SessionID != testSessionID {\n263|\t\tt.Fatalf(\"retry SessionID = %q\", reference.SessionID)\n264|\t}\n265|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n(more lines below)"}}}
