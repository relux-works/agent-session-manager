{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79f","stream":{"kind":"session","id":"01a07c0a-a85e-7163-b151-07f832301ae1"},"sequence":554,"recorded_at":1780531400001103,"record_type":"event","durability":"durable","causation_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"effad38b-c422-4dbf-8b01-ea09bebc28e3","run_stream":{"kind":"run","id":"effad38b-c422-4dbf-8b01-ea09bebc28e3"},"task_stream":{"kind":"task","id":"e2fc8231-9d82-4161-9866-943570dce463"},"task_id":"e2fc8231-9d82-4161-9866-943570dce463","event":{"kind":"output","task_id":"e2fc8231-9d82-4161-9866-943570dce463","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(799 line(s) above)\n800|\treference := createTestSession(t, repository)\n801|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n802|\t_, _ = appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n803|\tcorrupt(t, repository)\n804|\treturn repository\n805|}\n806|\n807|func sessionPaths(t *testing.T, repository *Repository) (directory, chain, record string) {\n808|\tt.Helper()\n809|\tdirectory = repository.sessionDir(testSessionID)\n810|\treturn directory, filepath.Join(directory, \"chain.json\"), filepath.Join(directory, \"record.json\")\n811|}\n812|\n813|func TestLoadRefusesMissingChainIndex(t *testing.T) {\n814|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n815|\t\t_, chain, _ := sessionPaths(t, repository)\n816|\t\tif err := os.Remove(chain); err != nil {\n817|\t\t\tt.Fatal(err)\n818|\t\t}\n819|\t})\n820|\t_, err := repository.GetRecord(testSessionID)\n821|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing chain)\")\n822|}\n823|\n824|func TestLoadRefusesMalformedChainIndex(t *testing.T) {\n825|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n826|\t\t_, chain, _ := sessionPaths(t, repository)\n827|\t\tif err := os.WriteFile(chain, []byte(`{\"record_id\":`), 0o600); err != nil {\n828|\t\t\tt.Fatal(err)\n829|\t\t}\n830|\t})\n831|\t_, err := repository.GetRecord(testSessionID)\n832|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(malformed chain)\")\n833|}\n834|\n835|func TestLoadRefusesMissingRecord(t *testing.T) {\n836|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n837|\t\t_, _, record := sessionPaths(t, repository)\n838|\t\tif err := os.Remove(record); err != nil {\n839|\t\t\tt.Fatal(err)\n840|\t\t}\n841|\t})\n842|\t_, err := repository.GetRecord(testSessionID)\n843|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing record)\")\n844|}\n845|\n846|func TestLoadRefusesTamperedRecord(t *testing.T) {\n847|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n848|\t\t_, _, record := sessionPaths(t, repository)\n849|\t\traw, err := os.ReadFile(record)\n850|\t\tif err != nil {\n851|\t\t\tt.Fatal(err)\n852|\t\t}\n853|\t\ttampered := strings.Replace(string(raw), `\"name\": \"payments-api\"`, `\"name\": \"payments-apj\"`, 1)\n854|\t\tif tampered == string(raw) {\n855|\t\t\tt.Fatal(\"tamper did not apply\")\n856|\t\t}\n857|\t\tif err := os.WriteFile(record, []byte(tampered), 0o600); err != nil {\n858|\t\t\tt.Fatal(err)\n859|\t\t}\n860|\t})\n861|\t_, err := repository.GetRecord(testSessionID)\n862|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(tampered record)\")\n863|}\n864|\n865|func TestLoadRefusesDetachedChainIndex(t *testing.T) {\n866|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n867|\t\t_, chain, _ := sessionPaths(t, repository)\n868|\t\traw, err := os.ReadFile(chain)\n869|\t\tif err != nil {\n870|\t\t\tt.Fatal(err)\n871|\t\t}\n872|\t\tvar index map[string]any\n873|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n874|\t\t\tt.Fatal(err)\n875|\t\t}\n876|\t\tindex[\"record_id\"] = zeroDigest\n877|\t\tout, _ := json.Marshal(index)\n878|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n879|\t\t\tt.Fatal(err)\n880|\t\t}\n881|\t})\n882|\t_, err := repository.GetRecord(testSessionID)\n883|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(detached index)\")\n884|}\n885|\n886|func TestLoadRefusesMissingEventBlob(t *testing.T) {\n887|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n888|\t\tevents, err := repository.ListEvents(testSessionID)\n889|\t\tif err != nil {\n890|\t\t\tt.Fatal(err)\n891|\t\t}\n892|\t\tif err := os.Remove(blobPathFor(t, repository, testSessionID, events[0].EventID)); err != nil {\n893|\t\t\tt.Fatal(err)\n894|\t\t}\n895|\t})\n896|\t_, err := repository.GetRecord(testSessionID)\n897|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(missing blob)\")\n898|}\n899|\n900|func TestLoadRefusesTamperedEventBlob(t *testing.T) {\n901|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n902|\t\tevents, err := repository.ListEvents(testSessionID)\n903|\t\tif err != nil {\n904|\t\t\tt.Fatal(err)\n905|\t\t}\n906|\t\tpath := blobPathFor(t, repository, testSessionID, events[1].EventID)\n907|\t\traw, err := os.ReadFile(path)\n908|\t\tif err != nil {\n909|\t\t\tt.Fatal(err)\n910|\t\t}\n911|\t\ttampered := strings.Replace(string(raw), `\"foreground_idle\":true`, `\"foreground_idle\":false`, 1)\n912|\t\tif tampered == string(raw) {\n913|\t\t\tt.Fatal(\"tamper did not apply\")\n914|\t\t}\n915|\t\tif err := os.WriteFile(path, []byte(tampered), 0o600); err != nil {\n916|\t\t\tt.Fatal(err)\n917|\t\t}\n918|\t})\n919|\t_, err := repository.GetRecord(testSessionID)\n920|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(tampered blob)\")\n921|}\n922|\n923|func TestLoadRefusesReorderedChainIndex(t *testing.T) {\n924|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n925|\t\t_, chain, _ := sessionPaths(t, repository)\n926|\t\traw, err := os.ReadFile(chain)\n927|\t\tif err != nil {\n928|\t\t\tt.Fatal(err)\n929|\t\t}\n930|\t\tvar index map[string]any\n931|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n932|\t\t\tt.Fatal(err)\n933|\t\t}\n934|\t\tevents := index[\"events\"].([]any)\n935|\t\tif len(events) != 2 {\n936|\t\t\tt.Fatalf(\"planted chain has %d events\", len(events))\n937|\t\t}\n938|\t\tindex[\"events\"] = []any{events[1], events[0]}\n939|\t\tout, _ := json.Marshal(index)\n940|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n941|\t\t\tt.Fatal(err)\n942|\t\t}\n943|\t})\n944|\t_, err := repository.GetRecord(testSessionID)\n945|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(reordered index)\")\n946|}\n947|\n948|func TestLoadRefusesUnknownSession(t *testing.T) {\n949|\trepository := openTestRepository(t)\n950|\t_, err := repository.GetRecord(testSessionID)\n951|\tmustErrorIs(t, err, ErrUnknownSession, \"GetRecord(absent)\")\n952|\t_, err = repository.ListEvents(testSessionID)\n953|\tmustErrorIs(t, err, ErrUnknownSession, \"ListEvents(absent)\")\n954|}\n955|\n956|func TestListSessionsFailsClosedOnCorruptSession(t *testing.T) {\n957|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n958|\t\t_, chain, _ := sessionPaths(t, repository)\n959|\t\tif err := os.WriteFile(chain, []byte(`{\"record_id\":`), 0o600); err != nil {\n960|\t\t\tt.Fatal(err)\n961|\t\t}\n962|\t})\n963|\t_, err := repository.ListSessions()\n964|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListSessions(corrupt)\")\n965|}\n966|\n967|func TestListAndResolveRefuseMissingRoot(t *testing.T) {\n968|\trepository := openTestRepository(t)\n969|\tcreateTestSession(t, repository)\n970|\tif err := os.RemoveAll(repository.root); err != nil {\n971|\t\tt.Fatal(err)\n972|\t}\n973|\t_, err := repository.ListSessions()\n974|\tmustErrorIs(t, err, ErrRepositoryPath, \"ListSessions(missing root)\")\n975|\t_, err = repository.Resolve(\"payments-api\")\n976|\tmustErrorIs(t, err, ErrRepositoryPath, \"Resolve(missing root)\")\n977|}\n978|\n979|// specTaskBoardRecordExample is the verbatim SPEC.md Section 5.1\n980|// task-board normative example: the same Launch Plan shape with the tagged\n981|// task_board variant instead of null.\n982|const specTaskBoardRecordExample = `{\n983|  \"schema\": \"urn:ax:schema:session-record\",\n984|  \"schema_version\": \"1.0.0\",\n985|  \"record_id\": \"sha256:0acd3e31635372e176f8f37b1b74aa0ebdcf2d1e4ac40d43adb8e462079b34a2\",\n986|  \"subject_id\": \"0198f4c8-9f60-7077-8071-1234567890ab\",\n987|  \"session_id\": \"0198f4c8-9f60-7077-8071-1234567890ab\",\n988|  \"name\": \"qwen-investigation\",\n989|  \"kind\": \"task_board\",\n990|  \"created_at\": \"2026-08-19T04:01:00.000Z\",\n991|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n992|  \"provider_id\": \"qwen\",\n993|  \"workspace_group_id\": \"0198f4c8-af70-7188-8172-1234567890ab\",\n994|  \"execution_profile\": \"standard\",\n995|  \"launch_plan\": {\n996|    \"argv\": [\"task-board\", \"qwen\", \"TASK-260819-example\"],\n997|    \"cwd_workspace_id\": \"0198f4c8-b080-7299-8273-1234567890ab\",\n998|    \"cwd_relative\": \".\",\n999|    \"env_names\": [],\n1000|    \"env_literals\": {},\n1001|    \"contains_secrets\": false,\n1002|    \"extensions\": {}\n1003|  },\n1004|  \"task_board\": {\n1005|    \"bridge_protocol_version\": \"1.0.0\",\n1006|    \"board\": {\n1007|      \"kind\": \"local\",\n1008|      \"logical_id\": \"agent-session-manager-spec\",\n1009|      \"remote_url\": null,\n1010|      \"extensions\": {}\n1011|    },\n1012|    \"task_element_id\": \"TASK-260819-example\",\n1013|    \"launch_mode\": \"tracked_prompt\",\n1014|    \"manager_session_ref\": null,\n1015|    \"board_goal\": null,\n1016|    \"native_goal_binding\": \"prompt\",\n1017|    \"extensions\": {}\n1018|  },\n1019|  \"fork_provenance\": null,\n1020|  \"extensions\": {}\n1021|}`\n1022|\n1023|func TestBothRecordKindsCoexist(t *testing.T) {\n1024|\trepository := openTestRepository(t)\n1025|\tdirect := createTestSession(t, repository)\n1026|\tboard, err := repository.CreateSession([]byte(specTaskBoardRecordExample))\n1027|\tif err != nil {\n1028|\t\tt.Fatalf(\"CreateSession(task_board SPEC record) error = %v\", err)\n1029|\t}\n1030|\tif board.RecordID != \"sha256:0acd3e31635372e176f8f37b1b74aa0ebdcf2d1e4ac40d43adb8e462079b34a2\" {\n1031|\t\tt.Fatalf(\"task_board RecordID = %q, want the SPEC example digest\", board.RecordID)\n1032|\t}\n1033|\tconst boardSession = \"0198f4c8-9f60-7077-8071-1234567890ab\"\n1034|\tfirst, _ := appendTestEvent(t, repository, boardSession, []string{board.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(board.RecordID))\n1035|\tif first.Position != 0 {\n1036|\t\tt.Fatalf(\"task_board chain ref = %+v\", first)\n1037|\t}\n1038|\tsummaries, err := repository.ListSessions()\n1039|\tif err != nil {\n1040|\t\tt.Fatal(err)\n1041|\t}\n1042|\tif len(summaries) != 2 {\n1043|\t\tt.Fatalf(\"sessions = %d, want 2\", len(summaries))\n1044|\t}\n1045|\tbyKind := map[string]SessionSummary{}\n1046|\tfor _, summary := range summaries {\n1047|\t\tbyKind[summary.Kind] = summary\n1048|\t}\n1049|\tif byKind[\"direct\"].SessionID != direct.SessionID || byKind[\"task_board\"].SessionID != boardSession {\n1050|\t\tt.Fatalf(\"kinds = %+v\", summaries)\n1051|\t}\n1052|\tif byKind[\"task_board\"].ProviderID != \"qwen\" || byKind[\"task_board\"].EventCount != 1 {\n1053|\t\tt.Fatalf(\"task_board summary = %+v\", byKind[\"task_board\"])\n1054|\t}\n1055|\tresolved, err := repository.Resolve(\"qwen-investigation\")\n1056|\tif err != nil {\n1057|\t\tt.Fatalf(\"Resolve(task_board name) error = %v\", err)\n1058|\t}\n1059|\tif resolved.SessionID != boardSession {\n1060|\t\tt.Fatalf(\"resolved = %q, want %q\", resolved.SessionID, boardSession)\n1061|\t}\n1062|}\n1063|\n1064|func TestCreateSessionResumesInterruptedCreate(t *testing.T) {\n1065|\trepository := openTestRepository(t)\n1066|\t// Simulate a crash between the record write and the chain write: the\n1067|\t// record is durable, the index is absent.\n1068|\tdirectory := repository.sessionDir(testSessionID)\n1069|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n1070|\t\tt.Fatal(err)\n1071|\t}\n1072|\tif err := os.WriteFile(filepath.Join(directory, \"record.json\"), []byte(specRecordExample), 0o600); err != nil {\n1073|\t\tt.Fatal(err)\n1074|\t}\n1075|\treference, err := repository.CreateSession([]byte(specRecordExample))\n1076|\tif err != nil {\n1077|\t\tt.Fatalf(\"resumed CreateSession error = %v\", err)\n1078|\t}\n1079|\tif reference.SessionID != testSessionID {\n1080|\t\tt.Fatalf(\"resumed SessionID = %q\", reference.SessionID)\n1081|\t}\n1082|\tstored, err := repository.GetRecord(testSessionID)\n1083|\tif err != nil {\n1084|\t\tt.Fatal(err)\n1085|\t}\n1086|\tif !jsonEqual(t, stored, []byte(specRecordExample)) {\n1087|\t\tt.Fatal(\"resumed record differs\")\n1088|\t}\n1089|\t// A resumed-then-completed create is terminal: the next create refuses.\n1090|\t_, err = repository.CreateSession([]byte(specRecordExample))\n1091|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(after resume)\")\n1092|}\n1093|\n1094|// specProviderIdentityExample is the verbatim SPEC.md Section 5.5\n1095|// normative example (Antigravity backend_conversation_uuid). It is\n1096|// duplicated here rather than imported from the provhost test package so\n1097|// this leaf's load-path bound stays pinned even if that package moves;\n1098|// TestProviderIdentityPlantVerifiesUnderRecordID fails loudly on any\n1099|// drift from the owner's example.\n1100|const specProviderIdentityExample = `{\n1101|  \"schema\": \"urn:ax:schema:provider-identity\",\n1102|  \"schema_version\": \"1.0.0\",\n1103|  \"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\",\n1104|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n1105|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n1106|  \"provider_id\": \"antigravity\",\n1107|  \"provider_version\": \"1.1.14\",\n1108|  \"provider_version_range\": \">=1.1.14 <1.2.0\",\n1109|  \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n1110|  \"identity_kind\": \"backend_conversation_uuid\",\n1111|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n1112|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n1113|  \"opaque_identity\": {},\n1114|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n1115|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n1116|  \"extensions\": {}\n1117|}`\n1118|\n1119|const specProviderIdentityDigest = \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"\n1120|\n1121|// TestProviderIdentityPlantVerifiesUnderRecordID pins what the plant\n1122|// below is: the SPEC Section 5.5 example verifies with a nil error under\n1123|// the record_id self field, so a load path that recomputes its digest\n1124|// matches it, and only the self-field arm can refuse it.\n1125|func TestProviderIdentityPlantVerifiesUnderRecordID(t *testing.T) {\n1126|\tverified, field, err := canonicaljson.VerifyObjectIdentity([]byte(specProviderIdentityExample))\n1127|\tif err != nil {\n1128|\t\tt.Fatalf(\"VerifyObjectIdentity(provider-identity plant) error = %v\", err)\n1129|\t}\n1130|\tif field != canonicaljson.SelfRecordID {\n1131|\t\tt.Fatalf(\"VerifyObjectIdentity(provider-identity plant) field = %q, want record_id\", string(field))\n1132|\t}\n1133|\tif verified.String() != specProviderIdentityDigest {\n1134|\t\tt.Fatalf(\"VerifyObjectIdentity(provider-identity plant) = %q, want %q\", verified.String(), specProviderIdentityDigest)\n1135|\t}\n1136|}\n1137|\n1138|// TestLoadRefusesProviderIdentityBlobAtEventPath pins the rewritten\n1139|// attestation bound at the load site: entry decodes gate schema before\n1140|// Verify, but the load path re-verifies stored blobs through Verify and\n1141|// refuses a foreign-schema record at the self-field arm. The planted\n1142|// blob verifies cleanly (see the pin above), carries the indexed digest,\n1143|// and replays valid routing members — the field arm is the only clause\n1144|// that can refuse it, so weakening that arm admits the plant.\n1145|func TestLoadRefusesProviderIdentityBlobAtEventPath(t *testing.T) {\n1146|\trepository := openTestRepository(t)\n1147|\treference := createTestSession(t, repository)\n1148|\t_, chainPath, _ := sessionPaths(t, repository)\n1149|\tindex := map[string]any{\n1150|\t\t\"record_id\": reference.RecordID,\n1151|\t\t\"events\": []any{map[string]any{\n1152|\t\t\t\"event_id\": specProviderIdentityDigest, \"event_type\": \"session.created\",\n1153|\t\t\t\"lease_epoch\": 1, \"lease_id\": testLeaseID, \"lease_sequence\": 1,\n1154|\t\t\t\"predecessors\": []any{reference.RecordID},\n1155|\t\t}},\n1156|\t}\n1157|\tout, err := json.Marshal(index)\n1158|\tif err != nil {\n1159|\t\tt.Fatal(err)\n1160|\t}\n1161|\tif err := os.WriteFile(chainPath, out, 0o600); err != nil {\n1162|\t\tt.Fatal(err)\n1163|\t}\n1164|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, specProviderIdentityDigest), []byte(specProviderIdentityExample), 0o600); err != nil {\n1165|\t\tt.Fatal(err)\n1166|\t}\n1167|\t_, err = repository.GetRecord(testSessionID)\n1168|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(provider-identity blob)\")\n1169|\t_, err = repository.ListEvents(testSessionID)\n1170|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(provider-identity blob)\")\n1171|}\n1172|\n1173|// TestLoadRefusesSwappedEventBlobs drives the content-addressed\n1174|// substitution the digest arm exists for: two chained events whose blob\n1175|// files trade places. Both blobs verify individually and both carry the\n1176|// event_id self field, so the digest comparison is the only clause that\n1177|// can refuse. Weakening it admits the substitution with a nil error.\n1178|func TestLoadRefusesSwappedEventBlobs(t *testing.T) {\n1179|\trepository := openTestRepository(t)\n1180|\treference := createTestSession(t, repository)\n1181|\tfirst, firstBytes := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n1182|\tsecond, secondBytes := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n1183|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, first.EventID), secondBytes, 0o600); err != nil {\n1184|\t\tt.Fatal(err)\n1185|\t}\n1186|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, second.EventID), firstBytes, 0o600); err != nil {\n1187|\t\tt.Fatal(err)\n1188|\t}\n1189|\t_, err := repository.ListEvents(testSessionID)\n1190|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(swapped blobs)\")\n1191|\t_, err = repository.GetRecord(testSessionID)\n1192|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(swapped blobs)\")\n1193|}\n1194|\n1195|// TestCreateSessionRefusesResumeWithDifferingBytes proves the resume\n1196|// byte-equality is load-bearing: an interrupted create (record durable,\n1197|// chain absent) retried with a different record for the same session ID\n1198|// is refused as an existing session, the parked record survives\n1199|// byte-identically, and no chain is installed. The retry carries the\n1200|// same byte length as the parked record, so a narrowed equality that\n1201|// compares lengths only would admit it.\n1202|func TestCreateSessionRefusesResumeWithDifferingBytes(t *testing.T) {\n1203|\trepository := openTestRepository(t)\n1204|\tparked := buildRecord(t, nil)\n1205|\tsameLength := buildRecord(t, func(object map[string]any) {\n1206|\t\tobject[\"name\"] = \"payments-apx\"\n1207|\t})\n1208|\tif len(sameLength) != len(parked) {\n1209|\t\tt.Fatalf(\"plant lengths differ (%d vs %d); the narrowing mutant would not be admitted\", len(parked), len(sameLength))\n1210|\t}\n1211|\tdirectory := repository.sessionDir(testSessionID)\n1212|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n1213|\t\tt.Fatal(err)\n1214|\t}\n1215|\tif err := os.WriteFile(filepath.Join(directory, \"record.json\"), parked, 0o600); err != nil {\n1216|\t\tt.Fatal(err)\n1217|\t}\n1218|\t_, err := repository.CreateSession(sameLength)\n1219|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(resume collision, same length)\")\n1220|\tlonger := buildRecord(t, func(object map[string]any) {\n1221|\t\tobject[\"name\"] = \"payments-api-v2\"\n1222|\t})\n1223|\t_, err = repository.CreateSession(longer)\n1224|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(resume collision, longer)\")\n1225|\tstored, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n1226|\tif err != nil {\n1227|\t\tt.Fatal(err)\n1228|\t}\n1229|\tif string(stored) != string(parked) {\n1230|\t\tt.Fatal(\"parked record changed after refused resume\")\n1231|\t}\n1232|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); !os.IsNotExist(err) {\n1233|\t\tt.Fatalf(\"chain.json state after refused resume = %v, want absent\", err)\n1234|\t}\n1235|}\n1236|\n1237|// TestCreateSessionRefusesResumeOfChainWithoutRecord pins the other\n1238|// resume guard: a chain index with no record beneath it is torn foreign\n1239|// state — no crash ordering in CreateSession produces it — and a retry\n1240|// must refuse it as an existing session rather than installing a record\n1241|// beside it and overwriting the index. The refusal funnels through the\n1242|// existing session-exists site; reads of the same state fail closed as\n1243|// corrupt through the load path.\n1244|func TestCreateSessionRefusesResumeOfChainWithoutRecord(t *testing.T) {\n1245|\trepository := openTestRepository(t)\n1246|\tdirectory := repository.sessionDir(testSessionID)\n1247|\tif err := os.MkdirAll(directory, 0o700); err != nil {\n1248|\t\tt.Fatal(err)\n1249|\t}\n1250|\tforeign, err := json.Marshal(map[string]any{\"record_id\": zeroDigest, \"events\": []any{}})\n1251|\tif err != nil {\n1252|\t\tt.Fatal(err)\n1253|\t}\n1254|\tif err := os.WriteFile(filepath.Join(directory, \"chain.json\"), foreign, 0o600); err != nil {\n1255|\t\tt.Fatal(err)\n1256|\t}\n1257|\t_, err = repository.CreateSession([]byte(specRecordExample))\n1258|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(chain without record)\")\n1259|\tif _, err := os.Stat(filepath.Join(directory, \"record.json\")); !os.IsNotExist(err) {\n1260|\t\tt.Fatalf(\"record.json state after refused resume = %v, want absent\", err)\n1261|\t}\n1262|\trestored, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n1263|\tif err != nil {\n1264|\t\tt.Fatal(err)\n1265|\t}\n1266|\tif string(restored) != string(foreign) {\n1267|\t\tt.Fatal(\"foreign chain index changed after refused resume\")\n1268|\t}\n1269|}\n1270|\n1271|// TestLoadRefusesMismatchedSessionBinding isolates the session-binding\n1272|// half of the record/chain binding check: a valid record for another\n1273|// session stored under this session's directory, with the index rebound\n1274|// to its digest so the record-digest half stays silent. Only the\n1275|// session-ID comparison can refuse it.\n1276|func TestLoadRefusesMismatchedSessionBinding(t *testing.T) {\n1277|\trepository := openTestRepository(t)\n1278|\tcreateTestSession(t, repository)\n1279|\tother := buildRecord(t, func(object map[string]any) {\n1280|\t\tobject[\"session_id\"] = testSessionIDB\n1281|\t\tobject[\"subject_id\"] = testSessionIDB\n1282|\t})\n1283|\tvar parsed struct {\n1284|\t\tRecordID string `json:\"record_id\"`\n1285|\t}\n1286|\tif err := json.Unmarshal(other, &parsed); err != nil {\n1287|\t\tt.Fatal(err)\n1288|\t}\n1289|\t_, chainPath, recordPath := sessionPaths(t, repository)\n1290|\tif err := os.WriteFile(recordPath, other, 0o600); err != nil {\n1291|\t\tt.Fatal(err)\n1292|\t}\n1293|\traw, err := os.ReadFile(chainPath)\n1294|\tif err != nil {\n1295|\t\tt.Fatal(err)\n1296|\t}\n1297|\tvar index map[string]any\n1298|\tif err := json.Unmarshal(raw, &index); err != nil {\n1299|\t\tt.Fatal(err)\n1300|\t}\n1301|\tindex[\"record_id\"] = parsed.RecordID\n1302|\tout, err := json.Marshal(index)\n1303|\tif err != nil {\n1304|\t\tt.Fatal(err)\n1305|\t}\n1306|\tif err := os.WriteFile(chainPath, out, 0o600); err != nil {\n1307|\t\tt.Fatal(err)\n1308|\t}\n1309|\t_, err = repository.GetRecord(testSessionID)\n1310|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(session mismatch)\")\n1311|}\n1312|\n1313|// TestLoadRefusesDetachedChainIndexWithReboundPredecessors isolates the\n1314|// record-digest half of the binding check: the index names an unrelated\n1315|// record digest, and the first indexed predecessors are rebound to that\n1316|// same digest so the continuity fold stays silent. Only the\n1317|// record-digest comparison can refuse it; the older detached-index test\n1318|// passes through the continuity arm instead and does not witness this\n1319|// clause.\n1320|func TestLoadRefusesDetachedChainIndexWithReboundPredecessors(t *testing.T) {\n1321|\trepository := plantCorruptedSession(t, func(t *testing.T, repository *Repository) {\n1322|\t\t_, chain, _ := sessionPaths(t, repository)\n1323|\t\traw, err := os.ReadFile(chain)\n1324|\t\tif err != nil {\n1325|\t\t\tt.Fatal(err)\n1326|\t\t}\n1327|\t\tvar index map[string]any\n1328|\t\tif err := json.Unmarshal(raw, &index); err != nil {\n1329|\t\t\tt.Fatal(err)\n1330|\t\t}\n1331|\t\tindex[\"record_id\"] = zeroDigest\n1332|\t\tevents, ok := index[\"events\"].([]any)\n1333|\t\tif !ok || len(events) != 2 {\n1334|\t\t\tt.Fatalf(\"planted chain has %v events, want 2\", index[\"events\"])\n1335|\t\t}\n1336|\t\tfirst, ok := events[0].(map[string]any)\n1337|\t\tif !ok {\n1338|\t\t\tt.Fatal(\"planted first event is not an object\")\n1339|\t\t}\n1340|\t\tfirst[\"predecessors\"] = []any{zeroDigest}\n1341|\t\tout, err := json.Marshal(index)\n1342|\t\tif err != nil {\n1343|\t\t\tt.Fatal(err)\n1344|\t\t}\n1345|\t\tif err := os.WriteFile(chain, out, 0o600); err != nil {\n1346|\t\t\tt.Fatal(err)\n1347|\t\t}\n1348|\t})\n1349|\t_, err := repository.GetRecord(testSessionID)\n1350|\tmustErrorIs(t, err, ErrChainCorrupt, \"load(detached index, rebound predecessors)\")\n1351|}\n1352|\n1353|// TestAppendEventRefusesDisagreeingBytesAcrossHandles drives the\n1354|// no-replace install through a fresh handle: the session is created and\n1355|// the disagreeing bytes are planted through one repository, and the\n1356|// adversarial append arrives through a second Open over the same root\n1357|// that shares no mutex and no memory with the first. The refusal below\n1358|// comes from the filesystem exclusive create alone, which is the whole\n1359|// cross-process claim — the in-process mutex cannot see a second\n1360|// process. The planted bytes must survive: a truncate would overwrite\n1361|// them and extend the chain instead.\n1362|func TestAppendEventRefusesDisagreeingBytesAcrossHandles(t *testing.T) {\n1363|\troot := t.TempDir()\n1364|\tfirst, err := Open(root)\n1365|\tif err != nil {\n1366|\t\tt.Fatal(err)\n1367|\t}\n1368|\treference := createTestSession(t, first)\n1369|\tfirstEvent, _ := appendTestEvent(t, first, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n1370|\tnext := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{firstEvent.EventID}, epoch: 1, leaseID: testLeaseID, sequence: 2, eventType: \"session.idle\", payload: idlePayload()})\n1371|\tvar parsed struct {\n1372|\t\tEventID string `json:\"event_id\"`\n1373|\t}\n1374|\tif err := json.Unmarshal(next, &parsed); err != nil {\n1375|\t\tt.Fatal(err)\n1376|\t}\n1377|\tplantPath := blobPathFor(t, first, testSessionID, parsed.EventID)\n1378|\tif err := os.WriteFile(plantPath, []byte(`{\"forged\":true}`), 0o600); err != nil {\n1379|\t\tt.Fatal(err)\n1380|\t}\n1381|\tsecond, err := Open(root)\n1382|\tif err != nil {\n1383|\t\tt.Fatal(err)\n1384|\t}\n1385|\t_, err = second.AppendEvent(testSessionID, next)\n1386|\tmustErrorIs(t, err, ErrChainCorrupt, \"AppendEvent(disagreeing bytes, fresh handle)\")\n1387|\tpreserved, err := os.ReadFile(plantPath)\n1388|\tif err != nil {\n1389|\t\tt.Fatal(err)\n1390|\t}\n1391|\tif string(preserved) != `{\"forged\":true}` {\n1392|\t\tt.Fatal(\"planted bytes were replaced instead of refused\")\n1393|\t}\n1394|\tevents, err := second.ListEvents(testSessionID)\n1395|\tif err != nil {\n1396|\t\tt.Fatal(err)\n1397|\t}\n1398|\tif len(events) != 1 {\n1399|\t\tt.Fatalf(\"chain after refused install = %d events, want 1\", len(events))\n1400|\t}\n1401|}"}}}
