{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca25","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":877,"recorded_at":1780531400001749,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"a28c623d-a2e8-4498-9c94-b689cfaaa4a6"},"task_id":"a28c623d-a2e8-4498-9c94-b689cfaaa4a6","event":{"kind":"output","task_id":"a28c623d-a2e8-4498-9c94-b689cfaaa4a6","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(1059 line(s) above)\n1060|\trepository := openTestRepository(t)\n1061|\t_, err := repository.GetRecord(testSessionID)\n1062|\tmustErrorIs(t, err, ErrUnknownSession, \"GetRecord(absent)\")\n1063|\t_, err = repository.ListEvents(testSessionID)\n1064|\tmustErrorIs(t, err, ErrUnknownSession, \"ListEvents(absent)\")\n1065|}\n1066|\n1067|// TestReadEntriesRefuseTraversalSessionID drives an unvalidated session ID\n1068|// through the three read entries. sessionDir joins the caller string with\n1069|// no grammar check, so \"../outside\" escapes the sessions root — and the\n1070|// escape still refuses, because the stored record's UUIDv7 session ID can\n1071|// never equal the traversal string at the record/session binding\n1072|// (loadSessionLocked). A plant outside the root carrying a full valid\n1073|// session reaches exactly that binding, so the refusal names\n1074|// ErrChainCorrupt there rather than ErrUnknownSession at a missing\n1075|// directory. Dropping the binding half of that check admits the escape.\n1076|func TestReadEntriesRefuseTraversalSessionID(t *testing.T) {\n1077|\trepository := openTestRepository(t)\n1078|\treference := createTestSession(t, repository)\n1079|\tfirst, _ := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n1080|\tescaped := repository.sessionDir(\"../outside\")\n1081|\trelative, err := filepath.Rel(repository.root, escaped)\n1082|\tif err != nil {\n1083|\t\tt.Fatal(err)\n1084|\t}\n1085|\tif relative == \".\" || !strings.HasPrefix(relative, \"..\") {\n1086|\t\tt.Fatalf(\"sessionDir(../outside) = %q (rel %q), want an escape from %q\", escaped, relative, repository.root)\n1087|\t}\n1088|\tplantSessionTree(t, repository.sessionDir(testSessionID), escaped)\n1089|\t_, err = repository.GetRecord(\"../outside\")\n1090|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(traversal)\")\n1091|\t_, err = repository.ListEvents(\"../outside\")\n1092|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(traversal)\")\n1093|\t_, err = repository.GetEvent(\"../outside\", first.EventID)\n1094|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetEvent(traversal)\")\n1095|\tif _, err := repository.GetRecord(testSessionID); err != nil {\n1096|\t\tt.Fatalf(\"GetRecord(healthy) after traversal error = %v\", err)\n1097|\t}\n1098|}\n1099|\n1100|// plantSessionTree copies one session directory tree to another path. The\n1101|// traversal test uses it to stage a valid session outside the sessions\n1102|// root, so the load reaches the record/session binding.\n1103|func plantSessionTree(t *testing.T, source, target string) {\n1104|\tt.Helper()\n1105|\tif err := os.MkdirAll(filepath.Join(target, \"events\"), 0o700); err != nil {\n1106|\t\tt.Fatal(err)\n1107|\t}\n1108|\tfor _, name := range []string{\"record.json\", \"chain.json\"} {\n1109|\t\traw, err := os.ReadFile(filepath.Join(source, name))\n1110|\t\tif err != nil {\n1111|\t\t\tt.Fatal(err)\n1112|\t\t}\n1113|\t\tif err := os.WriteFile(filepath.Join(target, name), raw, 0o600); err != nil {\n1114|\t\t\tt.Fatal(err)\n1115|\t\t}\n1116|\t}\n1117|\tentries, err := os.ReadDir(filepath.Join(source, \"events\"))\n1118|\tif err != nil {\n1119|\t\tt.Fatal(err)\n1120|\t}\n1121|\tfor _, entry := range entries {\n1122|\t\traw, err := os.ReadFile(filepath.Join(source, \"events\", entry.Name()))\n1123|\t\tif err != nil {\n1124|\t\t\tt.Fatal(err)\n(more lines below)"}}}
