{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d9","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":455,"recorded_at":1780531400000905,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"e511b7bf-709f-4ea2-8fec-2ee8a79eae1c"},"task_id":"e511b7bf-709f-4ea2-8fec-2ee8a79eae1c","event":{"kind":"output","task_id":"e511b7bf-709f-4ea2-8fec-2ee8a79eae1c","chunk":"{\n  \"chunk_id\": \"exec-19-1\",\n  \"command\": \"task-board --help 2>&1 | grep -i -A2 \\\"change\\\\|cr\\\\|request\\\\|handoff\\\\|worktree\\\"\\necho \\\"===\\\"\\ntask-board handoff --help 2>&1 | head -n 60\\necho \\\"===\\\"\\ntask-board worktree --help 2>&1 | head -n 60\",\n  \"description\": \"Check handoff and worktree commands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n--\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n--\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n===\\nResolve the configured role end status, verify every checklist item and\\nat least one stored task-scoped outcome resource, and apply the ordinary\\ncascading status transition under one mutation lock.\\n\\nThe command fails closed with all missing evidence and does not change status.\\nAttach or update the outcome with the resource or mutation CLI before handoff.\\n\\nUsage:\\n  task-board handoff <ELEMENT-ID> [flags]\\n\\nFlags:\\n      --commit-ack string   Mover acknowledgement for an enforced done transition\\n      --format string       Output format: compact or json (default \\\"compact\\\")\\n  -h, --help                help for handoff\\n      --role string         Role whose configured end_status must be applied\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\nInspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n\",\n  \"original_output_bytes\": 4326,\n  \"original_output_tokens\": 1082,\n  \"truncated\": false\n}"}}}
