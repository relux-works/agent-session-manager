{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55f","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":266,"recorded_at":1780531400000527,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"fbd534ed-c7c4-42f1-91db-88867731e933"},"task_id":"fbd534ed-c7c4-42f1-91db-88867731e933","event":{"kind":"output","task_id":"fbd534ed-c7c4-42f1-91db-88867731e933","chunk":"Read text file `internal/sessrepo/census_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n17|)\n18|\n19|// This file is the sessrepo refusal census. Every rejection in this package\n20|// funnels through the refuse var, and the census derives its denominator\n21|// from production source instead of listing it: a new refuse call without a\n22|// boundary-driven negative path fails the gate, and a row without a site\n23|// fails too. The gate has three halves:\n24|//\n25|//  1. Static derivation: every direct refuse(SENTINEL, ...) call in the\n26|//     production files is derived as file:line with its sentinel. Calls\n27|//     must sit on a single line with a bare sentinel identifier, or the\n28|//     derivation fails closed.\n29|//  2. Runtime recording: TestMain wraps the refuse var, attributing each\n30|//     exercised refusal to its production file:line plus the sentinel it\n31|//     carried, and whether a production boundary entry (Open,\n32|//     CreateSession, AppendEvent, GetRecord, GetEvent, ListEvents,\n33|//     ListSessions, Resolve) is on the stack. A direct helper call proves\n34|//     the helper refuses and nothing about the boundary, so only\n35|//     boundary-driven sites count.\n36|//  3. Alias audit: every refuse reference outside direct-call position,\n37|//     and every import-aliased or var-bound reference to the watched owner\n38|//     delegations, fails through invcore.AuditConstructorReferences, with\n39|//     the funnel's own declaration allowlisted by derived position.\n40|//\n41|// Control plants below prove each half fails closed, including an import\n42|// alias and a var binding in both the passing and the failing direction.\n43|var sessrepoRefusalRecorder = invcore.NewSiteRecorder()\n44|\n45|var sessrepoBoundarySites = map[string]struct{}{}\n46|\n47|var sessrepoBoundaryMarkers = []string{\n48|\t\"sessrepo.Open\",\n49|\t\").CreateSession\",\n50|\t\").AppendEvent\",\n51|\t\").GetRecord\",\n52|\t\").GetEvent\",\n53|\t\").ListEvents\",\n54|\t\").ListSessions\",\n55|\t\").Resolve\",\n56|}\n57|\n58|func TestMain(main *testing.M) {\n59|\toriginal := refuse\n60|\trefuse = func(sentinel error, format string, arguments ...any) error {\n61|\t\terr := original(sentinel, format, arguments...)\n62|\t\tsessrepoRefusalRecorder.Record(sentinel.Error(), 1)\n63|\t\tif beneathSessrepoBoundary() {\n64|\t\t\tif site := callerSessrepoSite(); site != \"\" {\n65|\t\t\t\tsessrepoBoundarySites[site] = struct{}{}\n66|\t\t\t}\n67|\t\t}\n68|\t\treturn err\n69|\t}\n70|\tcode := main.Run()\n71|\tif code == 0 && fullSessrepoPackageTestRun() {\n72|\t\tif failures := auditSessrepoRefusals(); len(failures) != 0 {\n73|\t\t\tfor _, failure := range failures {\n74|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n75|\t\t\t}\n76|\t\t\tcode = 1\n77|\t\t}\n78|\t}\n79|\tos.Exit(code)\n80|}\n81|\n82|func fullSessrepoPackageTestRun() bool {\n83|\tselected := flag.Lookup(\"test.run\")\n84|\treturn selected == nil || selected.Value.String() == \"\"\n85|}\n86|\n87|// callerSessrepoSite reports the production file:line of the refuse call\n88|// site: the wrapper calls this helper, so skip lands past Callers, this\n89|// helper, and the wrapper, on the production line that refused.\n90|func callerSessrepoSite() string {\n91|\tframes := make([]uintptr, 4)\n92|\tif count := runtime.Callers(3, frames); count == 0 {\n93|\t\treturn \"\"\n94|\t}\n95|\tlocated := runtime.CallersFrames(frames)\n96|\tframe, _ := located.Next()\n97|\tif frame.Function == \"\" {\n98|\t\treturn \"\"\n99|\t}\n100|\treturn filepath.Base(frame.File) + \":\" + strconv.Itoa(frame.Line)\n101|}\n102|\n103|func beneathSessrepoBoundary() bool {\n104|\tframes := make([]uintptr, 64)\n105|\tfor {\n106|\t\tcount := runtime.Callers(2, frames)\n107|\t\tlocated := runtime.CallersFrames(frames[:count])\n108|\t\tfor range frames[:count] {\n109|\t\t\tframe, _ := located.Next()\n110|\t\t\tfor _, marker := range sessrepoBoundaryMarkers {\n111|\t\t\t\tif strings.Contains(frame.Function, marker) {\n112|\t\t\t\t\treturn true\n113|\t\t\t\t}\n114|\t\t\t}\n115|\t\t}\n116|\t\tif count < len(frames) {\n117|\t\t\treturn false\n118|\t\t}\n119|\t\tframes = make([]uintptr, 2*len(frames))\n120|\t}\n121|}\n122|\n123|// auditSessrepoRefusals derives the expected inventory from production AST\n124|// and requires the exercised sets to match it in both directions, the alias\n125|// audit to be clean, and the observed sentinel set to equal the derived\n126|// sentinel roster exactly.\n127|func auditSessrepoRefusals() []string {\n128|\tfiles, fileSet, failures := invcore.ScanProduction(\".\")\n129|\tif len(failures) != 0 {\n130|\t\treturn failures\n131|\t}\n132|\tderived, sentinels, sentinelNames, derivationFailures := deriveSessrepoRefusalSites(files, fileSet)\n133|\tfailures = append(failures, derivationFailures...)\n134|\tfailures = append(failures, auditSessrepoEquality(files, fileSet)...)\n135|\taliasFailures := auditSessrepoAliases(files, fileSet)\n136|\tfailures = append(failures, aliasFailures...)\n137|\tfailures = append(failures, auditSessrepoUnrouted(files, fileSet, sentinelNames)...)\n138|\tderivedSet := make(map[string]struct{}, len(derived))\n139|\tfor _, site := range derived {\n140|\t\tderivedSet[site.key()] = struct{}{}\n141|\t}\n142|\tunregistered, orphaned, diffFailures := invcore.DiffSets(derivedSet, sessrepoRefusalRecorder.Sites())\n143|\tfor _, failure := range diffFailures {\n144|\t\tfailures = append(failures, \"sessrepo refusal census: \"+failure)\n145|\t}\n146|\tfor _, site := range unregistered {\n147|\t\tfailures = append(failures, \"sessrepo refusal site without an exercised negative path: \"+site)\n148|\t}\n149|\tfor _, site := range orphaned {\n150|\t\tfailures = append(failures, \"sessrepo exercised refusal outside the derived inventory: \"+site)\n151|\t}\n152|\tvar missingBoundary []string\n153|\tfor _, site := range derived {\n154|\t\tif _, ok := sessrepoBoundarySites[site.key()]; !ok {\n155|\t\t\tmissingBoundary = append(missingBoundary, site.key())\n156|\t\t}\n157|\t}\n158|\tsort.Strings(missingBoundary)\n159|\tif len(missingBoundary) != 0 {\n160|\t\tfailures = append(failures, \"sessrepo refusal sites never reached beneath a production boundary entry (a direct helper call does not prove the production effect): \"+strings.Join(missingBoundary, \", \"))\n161|\t}\n162|\tvar extraBoundary []string\n163|\tfor site := range sessrepoBoundarySites {\n164|\t\tif _, ok := derivedSet[site]; !ok {\n165|\t\t\textraBoundary = append(extraBoundary, site)\n166|\t\t}\n167|\t}\n168|\tsort.Strings(extraBoundary)\n169|\tif len(extraBoundary) != 0 {\n170|\t\tfailures = append(failures, \"sessrepo boundary-exercised sites outside the derived inventory: \"+strings.Join(extraBoundary, \", \"))\n171|\t}\n172|\twantCodes := make([]string, 0, len(sentinels))\n173|\tfor code := range sentinels {\n174|\t\twantCodes = append(wantCodes, code)\n175|\t}\n176|\tsort.Strings(wantCodes)\n177|\tgotCodes := sessrepoRefusalRecorder.Codes()\n178|\tif fmt.Sprintf(\"%v\", gotCodes) != fmt.Sprintf(\"%v\", wantCodes) {\n179|\t\tfailures = append(failures, fmt.Sprintf(\"sessrepo observed refusal codes = %v, want closed roster %v\", gotCodes, wantCodes))\n180|\t}\n181|\treturn failures\n182|}\n183|\n184|// sessrepoRefusalSite is one derived call site with its sentinel.\n185|type sessrepoRefusalSite struct {\n186|\tfile     string\n187|\tline     int\n188|\tsentinel string\n189|}\n190|\n191|func (site sessrepoRefusalSite) key() string {\n192|\treturn site.file + \":\" + strconv.Itoa(site.line)\n193|}\n194|\n195|// deriveSessrepoRefusalSites derives every direct refuse(SENTINEL, ...)\n196|// call in the production files plus the closed sentinel roster. The roster\n197|// derives from package-level Err* vars initialized with errors.New, so a\n198|// new sentinel without a refusal — or a refusal carrying an undeclared\n199|// sentinel — fails the gate. Sentinel names feed the unrouted-refusal\n200|// audit; sentinel texts feed the observed-code audit.\n201|func deriveSessrepoRefusalSites(files []invcore.ProductionFile, fileSet *token.FileSet) ([]sessrepoRefusalSite, map[string]struct{}, map[string]struct{}, []string) {\n202|\tvar sites []sessrepoRefusalSite\n203|\tsentinels := map[string]struct{}{}\n204|\tsentinelNames := map[string]struct{}{}\n205|\tvar failures []string\n206|\tfor _, production := range files {\n207|\t\tfor _, declaration := range production.Syntax.Decls {\n208|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n209|\t\t\tif !ok || general.Tok != token.VAR {\n210|\t\t\t\tcontinue\n211|\t\t\t}\n212|\t\t\tfor _, specification := range general.Specs {\n213|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n214|\t\t\t\tif !ok {\n215|\t\t\t\t\tcontinue\n216|\t\t\t\t}\n217|\t\t\t\tfor index, name := range value.Names {\n218|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Err\") || index >= len(value.Values) {\n219|\t\t\t\t\t\tcontinue\n220|\t\t\t\t\t}\n221|\t\t\t\t\tcall, ok := value.Values[index].(*ast.CallExpr)\n222|\t\t\t\t\tif !ok {\n223|\t\t\t\t\t\tcontinue\n224|\t\t\t\t\t}\n225|\t\t\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n226|\t\t\t\t\tif !ok || selector.Sel.Name != \"New\" {\n227|\t\t\t\t\t\tcontinue\n228|\t\t\t\t\t}\n229|\t\t\t\t\treceiver, ok := selector.X.(*ast.Ident)\n230|\t\t\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n231|\t\t\t\t\t\tcontinue\n232|\t\t\t\t\t}\n233|\t\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n234|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n235|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\" is not an errors.New string literal\")\n236|\t\t\t\t\t\tcontinue\n237|\t\t\t\t\t}\n238|\t\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n239|\t\t\t\t\tif err != nil {\n240|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\": \"+err.Error())\n241|\t\t\t\t\t\tcontinue\n242|\t\t\t\t\t}\n243|\t\t\t\t\tsentinels[text] = struct{}{}\n244|\t\t\t\t\tsentinelNames[name.Name] = struct{}{}\n245|\t\t\t\t}\n246|\t\t\t}\n247|\t\t}\n248|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n249|\t\t\tcall, ok := node.(*ast.CallExpr)\n250|\t\t\tif !ok {\n251|\t\t\t\treturn true\n252|\t\t\t}\n253|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n254|\t\t\tif !ok || identifier.Name != \"refuse\" || len(call.Args) < 1 {\n255|\t\t\t\treturn true\n256|\t\t\t}\n257|\t\t\tposition := fileSet.Position(identifier.Pos())\n258|\t\t\tif !position.IsValid() {\n259|\t\t\t\tfailures = append(failures, production.Name+\": refuse call at an invalid position\")\n260|\t\t\t\treturn true\n261|\t\t\t}\n262|\t\t\tif end := fileSet.Position(call.End()); end.Line != position.Line {\n263|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse call spans several lines; the runtime site and the parsed site would disagree\")\n264|\t\t\t\treturn true\n265|\t\t\t}\n266|\t\t\tsentinel, ok := call.Args[0].(*ast.Ident)\n267|\t\t\tif !ok {\n268|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse sentinel is not a bare identifier; the extractor cannot see through indirection\")\n269|\t\t\t\treturn true\n270|\t\t\t}\n271|\t\t\tsites = append(sites, sessrepoRefusalSite{file: production.Name, line: position.Line, sentinel: sentinel.Name})\n272|\t\t\treturn true\n273|\t\t})\n274|\t}\n275|\tif len(sites) == 0 {\n276|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sites; the scanner is blind, not the package empty\")\n277|\t}\n278|\tif len(sentinels) == 0 {\n279|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sentinels; the roster extractor is blind\")\n280|\t}\n281|\treturn sites, sentinels, sentinelNames, failures\n282|}\n283|\n284|// auditSessrepoUnrouted fails every fmt.Errorf call that wraps a package\n285|// sentinel outside the refuse funnel. A routed refusal and an identical\n286|// direct wrap behave the same, so without this half a bypassed funnel\n287|// passes the behavioral suite and the site inventory together.\n288|func auditSessrepoUnrouted(files []invcore.ProductionFile, fileSet *token.FileSet, sentinelNames map[string]struct{}) []string {\n289|\tvar unrouted []string\n290|\tfor _, production := range files {\n291|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n292|\t\t\tcall, ok := node.(*ast.CallExpr)\n293|\t\t\tif !ok {\n294|\t\t\t\treturn true\n295|\t\t\t}\n296|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n297|\t\t\tif !ok || selector.Sel.Name != \"Errorf\" {\n298|\t\t\t\treturn true\n299|\t\t\t}\n300|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n301|\t\t\tif !ok || receiver.Name != \"fmt\" {\n302|\t\t\t\treturn true\n303|\t\t\t}\n304|\t\t\tfor _, argument := range call.Args {\n305|\t\t\t\tidentifier, ok := argument.(*ast.Ident)\n306|\t\t\t\tif !ok {\n307|\t\t\t\t\tcontinue\n308|\t\t\t\t}\n309|\t\t\t\tif _, watched := sentinelNames[identifier.Name]; watched {\n310|\t\t\t\t\tposition := fileSet.Position(call.Pos())\n311|\t\t\t\t\tunrouted = append(unrouted, production.Name+\":\"+strconv.Itoa(position.Line))\n312|\t\t\t\t}\n313|\t\t\t}\n314|\t\t\treturn true\n315|\t\t})\n316|\t}\n317|\tsort.Strings(unrouted)\n318|\tif len(unrouted) == 0 {\n319|\t\treturn nil\n320|\t}\n321|\treturn []string{\"sessrepo refusals raised outside the refuse funnel (the derived inventory cannot require a negative path for them): \" + strings.Join(unrouted, \", \")}\n322|}\n323|\n324|// sessrepoConstructorSpec is the alias-audit policy: the local funnel must\n325|// stay a direct call, and the watched owner delegations must stay direct\n326|// qualified calls resolved by import path, so neither an import alias nor\n327|// a var binding can hide a refusal or a delegation.\n328|func sessrepoConstructorSpec() invcore.ConstructorSpec {\n329|\treturn invcore.ConstructorSpec{\n330|\t\tLocal: map[string]bool{\"refuse\": true},\n331|\t\tQualified: map[string]map[string]bool{\n332|\t\t\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\": {\"VerifyObjectIdentity\": true},\n333|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\":       {\"DecodeStrictObject\": true, \"CheckUUIDv7\": true, \"CheckUint53Bounds\": true},\n334|\t\t\t\"github.com/relux-works/agent-session-manager/internal/scalar\":        {\"ParseDigest\": true, \"ParseUUIDv7\": true, \"ParseUUIDv4\": true},\n335|\t\t},\n336|\t}\n337|}\n338|\n339|// auditSessrepoAliases runs the alias audit over every production file,\n340|// allowlisting the funnel's own declaration position: a package-level\n341|// `var refuse = func...` binding a function literal.\n342|func auditSessrepoAliases(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n343|\tvar failures []string\n344|\tspec := sessrepoConstructorSpec()\n345|\tfor _, production := range files {\n346|\t\tallowed := sessrepoFunnelPositions(production.Syntax)\n347|\t\tfor _, failure := range invcore.AuditConstructorReferences(production.Syntax, fileSet, production.Name, spec) {\n348|\t\t\tif atAllowedPosition(failure, production.Name, fileSet, allowed) {\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tfailures = append(failures, failure)\n352|\t\t}\n353|\t}\n354|\treturn failures\n355|}\n356|\n357|func sessrepoFunnelPositions(syntax *ast.File) map[token.Pos]bool {\n358|\tpositions := map[token.Pos]bool{}\n359|\tfor _, declaration := range syntax.Decls {\n360|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n361|\t\tif !ok || general.Tok != token.VAR {\n362|\t\t\tcontinue\n363|\t\t}\n364|\t\tfor _, specification := range general.Specs {\n365|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n366|\t\t\tif !ok {\n367|\t\t\t\tcontinue\n368|\t\t\t}\n369|\t\t\tfor index, name := range value.Names {\n370|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n371|\t\t\t\t\tcontinue\n372|\t\t\t\t}\n373|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n374|\t\t\t\t\tpositions[name.Pos()] = true\n375|\t\t\t\t}\n376|\t\t\t}\n377|\t\t}\n378|\t}\n379|\treturn positions\n380|}\n381|\n382|func atAllowedPosition(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n383|\tfor position := range allowed {\n384|\t\tlocated := fileSet.Position(position)\n385|\t\tif !located.IsValid() {\n386|\t\t\tcontinue\n387|\t\t}\n388|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n389|\t\tif strings.Contains(failure, prefix) {\n390|\t\t\treturn true\n391|\t\t}\n392|\t}\n393|\treturn false\n394|}\n395|\n396|// TestCensusDiffSetsFailsClosed plants the three derivation outcomes\n397|// against the production DiffSets harness: an unregistered site, an orphan\n398|// row, and a zero-site derivation each fail instead of passing silently.\n399|func TestCensusDiffSetsFailsClosed(t *testing.T) {\n400|\tunregistered, orphaned, failures := invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{})\n401|\tif len(failures) != 0 {\n402|\t\tt.Fatalf(\"plant failures = %v\", failures)\n403|\t}\n404|\tif len(unregistered) != 1 || unregistered[0] != \"chain.go:1\" {\n405|\t\tt.Fatalf(\"unregistered = %v, want [chain.go:1]\", unregistered)\n406|\t}\n407|\tif len(orphaned) != 0 {\n408|\t\tt.Fatalf(\"orphaned = %v, want none\", orphaned)\n409|\t}\n410|\tunregistered, orphaned, failures = invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{\"chain.go:1\": {}, \"chain.go:2\": {}})\n411|\tif len(failures) != 0 {\n412|\t\tt.Fatalf(\"plant failures = %v\", failures)\n413|\t}\n414|\tif len(unregistered) != 0 {\n415|\t\tt.Fatalf(\"unregistered = %v, want none\", unregistered)\n416|\t}\n417|\tif len(orphaned) != 1 || orphaned[0] != \"chain.go:2\" {\n418|\t\tt.Fatalf(\"orphaned = %v, want [chain.go:2]\", orphaned)\n419|\t}\n420|\t_, _, failures = invcore.DiffSets(map[string]struct{}{}, map[string]struct{}{})\n421|\tif len(failures) == 0 {\n422|\t\tt.Fatal(\"zero-site derivation passed clean; the harness would bless a blind scan\")\n423|\t}\n424|}\n425|\n426|// sessrepoAliasPlant is one control for the alias audit: wantFailure names\n427|// the fragment a reporting plant must carry, empty for a clean plant.\n428|type sessrepoAliasPlant struct {\n429|\tname        string\n430|\tsource      string\n431|\twantFailure string\n432|}\n433|\n434|func sessrepoAliasPlants() []sessrepoAliasPlant {\n435|\tcanonical := `\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"`\n436|\tscalar := `\"github.com/relux-works/agent-session-manager/internal/scalar\"`\n437|\treturn []sessrepoAliasPlant{\n438|\t\t{\n439|\t\t\tname:        \"direct local call is clean\",\n440|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\treturn refuse(errExample, \\\"no\\\")\\n}\\n\",\n441|\t\t\twantFailure: \"\",\n442|\t\t},\n443|\t\t{\n444|\t\t\tname:        \"import alias direct call resolves by path\",\n445|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\t_, _, _ = cjson.VerifyObjectIdentity(raw)\\n}\\n\",\n446|\t\t\twantFailure: \"\",\n447|\t\t},\n448|\t\t{\n449|\t\t\tname:        \"import alias var binding fails\",\n450|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\tverify := cjson.VerifyObjectIdentity\\n\\t_, _, _ = verify(raw)\\n}\\n\",\n451|\t\t\twantFailure: \"outside direct-call position\",\n452|\t\t},\n453|\t\t{\n454|\t\t\tname:        \"local var binding fails\",\n455|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\tdeny := refuse\\n\\treturn deny(errExample, \\\"no\\\")\\n}\\n\",\n456|\t\t\twantFailure: \"outside direct-call position\",\n457|\t\t},\n458|\t\t{\n459|\t\t\tname:        \"dot import of a watched path fails closed\",\n460|\t\t\tsource:      \"package plant\\nimport . \" + scalar + \"\\nfunc run(value string) {\\n\\t_, _ = ParseDigest(value)\\n}\\n\",\n461|\t\t\twantFailure: \"dot-imports watched path\",\n462|\t\t},\n463|\t\t{\n464|\t\t\tname:        \"shadowed funnel name fails closed\",\n465|\t\t\tsource:      \"package plant\\nfunc run(refuse int) int {\\n\\treturn refuse\\n}\\n\",\n466|\t\t\twantFailure: \"outside direct-call position\",\n467|\t\t},\n468|\t}\n469|}\n470|\n471|// TestCensusAliasPlants drives every control through the production audit\n472|// spec and requires the ledgered outcome. A plant that stops reporting\n473|// fails here by construction.\n474|func TestCensusAliasPlants(t *testing.T) {\n475|\tspec := sessrepoConstructorSpec()\n476|\tfor _, plant := range sessrepoAliasPlants() {\n477|\t\tt.Run(plant.name, func(t *testing.T) {\n478|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n479|\t\t\tif failure != \"\" {\n480|\t\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n481|\t\t\t}\n482|\t\t\tfailures := invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", spec)\n483|\t\t\tif plant.wantFailure == \"\" {\n484|\t\t\t\tif len(failures) != 0 {\n485|\t\t\t\t\tt.Fatalf(\"clean plant reported: %s\", strings.Join(failures, \"; \"))\n486|\t\t\t\t}\n487|\t\t\t\treturn\n488|\t\t\t}\n489|\t\t\tmatched := false\n490|\t\t\tfor _, failure := range failures {\n491|\t\t\t\tif strings.Contains(failure, plant.wantFailure) {\n492|\t\t\t\t\tmatched = true\n493|\t\t\t\t}\n494|\t\t\t}\n495|\t\t\tif !matched {\n496|\t\t\t\tt.Fatalf(\"plant reported %q, want a failure containing %q\", failures, plant.wantFailure)\n497|\t\t\t}\n498|\t\t})\n499|\t}\n500|}\n501|\n502|// TestCensusPlantHarnessFailsClosed proves the plant harness itself is\n503|// fail-closed: an unparseable control is a harness failure, never clean.\n504|func TestCensusPlantHarnessFailsClosed(t *testing.T) {\n505|\t_, _, failure := invcore.ParseSource(\"plant.go\", []byte(\"package plant\\nfunc broken( {\\n\"))\n506|\tif failure == \"\" {\n507|\t\tt.Fatal(\"unparseable control parsed clean; the harness would pass a blind plant\")\n508|\t}\n509|}\n510|\n511|// The content-equality census derives every byte-content comparison in the\n512|// package through invcore, the way the refusal inventory above is derived:\n513|// over every production file, never over hard-coded names or tokens. The\n514|// class has two classified forms:\n515|//\n516|//   - E1: a qualified bytes.Equal call, resolved by import path (not local\n517|//     spelling) through invcore.WatchedCallPositions, so an import alias\n518|//     still derives. A var-bound Equal is not a call and fails the alias\n519|//     audit instead of deriving.\n520|//   - E2: a == or != whose operand converts content with string(...): the\n521|//     string(left) == string(right) spelling carries no bytes.Equal token\n522|//     and a substring count cannot see it. Identifier comparisons between\n523|//     already-string values (digests, lease IDs, session IDs) are not\n524|//     content comparisons and stay outside the class.\n525|//\n526|// An unclassifiable spelling — bytes.Compare or bytes.EqualFold,\n527|// reflect.DeepEqual, slices.Equal — fails closed instead of passing\n528|// silently; widen the class when one is genuinely needed. A hand-rolled\n529|// comparison loop is the stated blind spot: it carries no classified call\n530|// and no conversion comparison, so this census would not see it.\n531|func sessrepoEqualitySpec() invcore.ConstructorSpec {\n532|\treturn invcore.ConstructorSpec{\n533|\t\tQualified: map[string]map[string]bool{\n534|\t\t\t\"bytes\": {\"Equal\": true},\n535|\t\t},\n536|\t}\n537|}\n538|\n539|// sessrepoEqualityWideSpec is the alias-audit policy for the class: every\n540|// spelling that compares byte content, classified or not, so an aliased\n541|// or bound reference to any of them fails outside direct-call position.\n542|func sessrepoEqualityWideSpec() invcore.ConstructorSpec {\n543|\treturn invcore.ConstructorSpec{\n544|\t\tQualified: map[string]map[string]bool{\n545|\t\t\t\"bytes\":   {\"Equal\": true, \"Compare\": true, \"EqualFold\": true},\n546|\t\t\t\"reflect\": {\"DeepEqual\": true},\n547|\t\t\t\"slices\":  {\"Equal\": true},\n548|\t\t},\n549|\t}\n550|}\n551|\n552|// equalitySite is one derived content-equality comparison with its form.\n553|type equalitySite struct {\n554|\tfile string\n555|\tline int\n556|\tform string\n557|}\n558|\n559|func (site equalitySite) key() string {\n560|\treturn site.file + \":\" + strconv.Itoa(site.line)\n561|}\n562|\n563|// equalitySitesInFile derives the classified sites of one source: E1\n564|// through the invcore attribution set, E2 through the conversion-operand\n565|// scan. Display names the file for diagnostics.\n566|func equalitySitesInFile(syntax *ast.File, fileSet *token.FileSet, display string) ([]equalitySite, []string) {\n567|\tvar sites []equalitySite\n568|\tvar failures []string\n569|\tfor position := range invcore.WatchedCallPositions(syntax, sessrepoEqualitySpec()) {\n570|\t\tlocated := fileSet.Position(position)\n571|\t\tif !located.IsValid() {\n572|\t\t\tfailures = append(failures, display+\": bytes.Equal call at an invalid position\")\n573|\t\t\tcontinue\n574|\t\t}\n575|\t\tsites = append(sites, equalitySite{file: display, line: located.Line, form: \"bytes.Equal\"})\n576|\t}\n577|\tast.Inspect(syntax, func(node ast.Node) bool {\n578|\t\tcomparison, ok := node.(*ast.BinaryExpr)\n579|\t\tif !ok || (comparison.Op != token.EQL && comparison.Op != token.NEQ) {\n580|\t\t\treturn true\n581|\t\t}\n582|\t\tif !isStringConversion(comparison.X) && !isStringConversion(comparison.Y) {\n583|\t\t\treturn true\n584|\t\t}\n585|\t\tlocated := fileSet.Position(comparison.Pos())\n586|\t\tif !located.IsValid() {\n587|\t\t\tfailures = append(failures, display+\": string comparison at an invalid position\")\n588|\t\t\treturn true\n589|\t\t}\n590|\t\tsites = append(sites, equalitySite{file: display, line: located.Line, form: \"string-==\"})\n591|\t\treturn true\n592|\t})\n593|\treturn sites, failures\n594|}\n595|\n596|// isStringConversion reports a string(...) builtin conversion call.\n597|func isStringConversion(node ast.Node) bool {\n598|\tcall, ok := node.(*ast.CallExpr)\n599|\tif !ok {\n600|\t\treturn false\n601|\t}\n602|\tidentifier, ok := call.Fun.(*ast.Ident)\n603|\treturn ok && identifier.Name == \"string\"\n604|}\n605|\n606|// unclassifiableEqualitySpellings reports direct calls to content-equality\n607|// spellings outside the classified set, resolved by import path so an\n608|// import alias cannot hide them.\n609|func unclassifiableEqualitySpellings(syntax *ast.File, fileSet *token.FileSet, display string) []string {\n610|\twide := invcore.WatchedCallPositions(syntax, sessrepoEqualityWideSpec())\n611|\tnarrow := invcore.WatchedCallPositions(syntax, sessrepoEqualitySpec())\n612|\tvar failures []string\n613|\tfor position := range wide {\n614|\t\tif narrow[position] {\n615|\t\t\tcontinue\n616|\t\t}\n617|\t\tlocated := fileSet.Position(position)\n618|\t\tif !located.IsValid() {\n619|\t\t\tfailures = append(failures, display+\": unclassifiable equality call at an invalid position\")\n620|\t\t\tcontinue\n621|\t\t}\n622|\t\tfailures = append(failures, display+\":\"+strconv.Itoa(located.Line)+\": content-equality spelling outside the classified set (bytes.Equal, string ==); widen the census or remove it\")\n623|\t}\n624|\tsort.Strings(failures)\n625|\treturn failures\n626|}\n627|\n628|// sessrepoEqualityLedger registers every derived content-equality site\n629|// with the same-length vector and narrowing mutant that witness it. The\n630|// full-package audit diffs this ledger against the derived set in both\n631|// directions: a site without a row is an unwitnessed comparison, a row\n632|// without a site is a witness without a guard.\n633|func sessrepoEqualityLedger() map[string]string {\n634|\treturn map[string]string{\n635|\t\t\"sessrepo.go:258\": \"TestCreateSessionRefusesResumeWithDifferingBytes // N10 length-only\",\n636|\t\t\"chain.go:426\":    \"TestAppendEventRefusesSameLengthDisagreeingBytes // N13 length-only\",\n637|\t}\n638|}\n639|\n640|// deriveSessrepoEqualitySites derives the classified sites over every\n641|// production file. Zero derived sites is a blind scan, never a pass.\n642|func deriveSessrepoEqualitySites(files []invcore.ProductionFile, fileSet *token.FileSet) (map[string]struct{}, []string) {\n643|\tderived := map[string]struct{}{}\n644|\tvar failures []string\n645|\tfor _, production := range files {\n646|\t\tsites, siteFailures := equalitySitesInFile(production.Syntax, fileSet, production.Name)\n647|\t\tfailures = append(failures, siteFailures...)\n648|\t\tfor _, site := range sites {\n649|\t\t\tderived[site.key()] = struct{}{}\n650|\t\t}\n651|\t}\n652|\tif len(derived) == 0 {\n653|\t\tfailures = append(failures, \"sessrepo content-equality census derived zero sites; the scanner is blind, not the package empty\")\n654|\t}\n655|\treturn derived, failures\n656|}\n657|\n658|// auditSessrepoEquality runs the class census over every production file:\n659|// derivation, the wide alias audit (import aliases resolve by path, var\n660|// bindings and dot imports fail), the unclassifiable-spelling check, and\n661|// the both-direction diff against the ledger. It runs on the full\n662|// unfiltered package run through auditSessrepoRefusals, so a\n663|// census-only plant stays green under -run and reddens the full gate.\n664|func auditSessrepoEquality(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n665|\tderived, failures := deriveSessrepoEqualitySites(files, fileSet)\n666|\tfor _, production := range files {\n667|\t\tfor _, failure := range invcore.AuditConstructorReferences(production.Syntax, fileSet, production.Name, sessrepoEqualityWideSpec()) {\n668|\t\t\tfailures = append(failures, failure)\n669|\t\t}\n670|\t\tfailures = append(failures, unclassifiableEqualitySpellings(production.Syntax, fileSet, production.Name)...)\n671|\t}\n672|\tunregistered, orphaned, diffFailures := invcore.DiffSets(derived, sessrepoEqualityLedgerRows())\n673|\tfor _, failure := range diffFailures {\n674|\t\tfailures = append(failures, \"sessrepo content-equality census: \"+failure)\n675|\t}\n676|\tfor _, site := range unregistered {\n677|\t\tfailures = append(failures, \"sessrepo content-equality site without a registered vector: \"+site)\n678|\t}\n679|\tfor _, row := range orphaned {\n680|\t\tfailures = append(failures, \"sessrepo content-equality row without a derived site: \"+row)\n681|\t}\n682|\treturn failures\n683|}\n684|\n685|// sessrepoEqualityLedgerRows keys the ledger for the both-direction diff.\n686|func sessrepoEqualityLedgerRows() map[string]struct{} {\n687|\trows := map[string]struct{}{}\n688|\tfor key := range sessrepoEqualityLedger() {\n689|\t\trows[key] = struct{}{}\n690|\t}\n691|\treturn rows\n692|}\n693|\n694|// parseEqualityPlant parses one synthetic control source for the equality\n695|// census plants below. An unparseable control is a harness failure.\n696|func parseEqualityPlant(t *testing.T, name, source string) (*ast.File, *token.FileSet) {\n697|\tt.Helper()\n698|\tsyntax, fileSet, failure := invcore.ParseSource(name, []byte(source))\n699|\tif failure != \"\" {\n700|\t\tt.Fatalf(\"control does not parse: %s\", failure)\n701|\t}\n702|\treturn syntax, fileSet\n703|}\n704|\n705|// derivedEqualityKeys derives classified site keys from one control source.\n706|func derivedEqualityKeys(t *testing.T, name, source string) map[string]struct{} {\n707|\tt.Helper()\n708|\tsyntax, fileSet := parseEqualityPlant(t, name, source)\n709|\tsites, failures := equalitySitesInFile(syntax, fileSet, name)\n710|\tif len(failures) != 0 {\n711|\t\tt.Fatalf(\"derivation reported %q on a classified control\", failures)\n712|\t}\n713|\tkeys := map[string]struct{}{}\n714|\tfor _, site := range sites {\n715|\t\tkeys[site.key()] = struct{}{}\n716|\t}\n717|\treturn keys\n718|}\n719|\n720|// TestEqualityCensusDerivesBytesEqualThroughImportAlias is the alias-clean\n721|// plant: a bytes.Equal call through an import alias resolves by path and\n722|// still derives, so renaming the import cannot hide a comparison.\n723|func TestEqualityCensusDerivesBytesEqualThroughImportAlias(t *testing.T) {\n724|\tkeys := derivedEqualityKeys(t, \"plant.go\", \"package plant\\nimport be \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\treturn be.Equal(left, right)\\n}\\n\")\n725|\tif len(keys) != 1 {\n726|\t\tt.Fatalf(\"aliased bytes.Equal derived %v, want one site\", keys)\n727|\t}\n728|\tsyntax, fileSet := parseEqualityPlant(t, \"plant.go\", \"package plant\\nimport be \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\treturn be.Equal(left, right)\\n}\\n\")\n729|\tif failures := invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", sessrepoEqualityWideSpec()); len(failures) != 0 {\n730|\t\tt.Fatalf(\"aliased direct call reported: %s\", strings.Join(failures, \"; \"))\n731|\t}\n732|}\n733|\n734|// TestEqualityCensusFailsClosedOnNewFileSite is the P2 red-before plant: a\n735|// bytes.Equal in a file the ledger never registered — the new-file shape\n736|// a hard-coded filename list cannot see — is an unregistered site, not a\n737|// pass. The derivation takes every scanned file, so the filename is\n738|// evidence, not configuration.\n739|func TestEqualityCensusFailsClosedOnNewFileSite(t *testing.T) {\n740|\tkeys := derivedEqualityKeys(t, \"plantextra.go\", \"package sessrepo\\nimport \\\"bytes\\\"\\nfunc extra(left, right []byte) bool {\\n\\treturn bytes.Equal(left, right)\\n}\\n\")\n741|\tunregistered, _, failures := invcore.DiffSets(keys, map[string]struct{}{\"sessrepo.go:258\": {}, \"chain.go:426\": {}})\n742|\tif len(failures) != 0 {\n743|\t\tt.Fatalf(\"plant failures = %v\", failures)\n744|\t}\n745|\tif len(unregistered) != 1 {\n746|\t\tt.Fatalf(\"unregistered = %v, want the plantextra.go site\", unregistered)\n747|\t}\n748|\tif !strings.HasPrefix(unregistered[0], \"plantextra.go:\") {\n749|\t\tt.Fatalf(\"unregistered = %v, want a plantextra.go row\", unregistered)\n750|\t}\n751|}\n752|\n753|// TestEqualityCensusFailsClosedOnStringEqualitySpelling is the P3\n754|// red-before plant: string(left) == string(right) carries no bytes.Equal\n755|// token and derives as the conversion-operand form, so a token count\n756|// passes it while the class census registers an unregistered site.\n757|func TestEqualityCensusFailsClosedOnStringEqualitySpelling(t *testing.T) {\n758|\tkeys := derivedEqualityKeys(t, \"store.go\", \"package sessrepo\\nfunc equal(left, right []byte) bool {\\n\\treturn string(left) == string(right)\\n}\\n\")\n759|\tif len(keys) != 1 {\n760|\t\tt.Fatalf(\"string-equality spelling derived %v, want one site\", keys)\n761|\t}\n762|\tunregistered, _, failures := invcore.DiffSets(keys, map[string]struct{}{\"sessrepo.go:258\": {}, \"chain.go:426\": {}})\n763|\tif len(failures) != 0 {\n764|\t\tt.Fatalf(\"plant failures = %v\", failures)\n765|\t}\n766|\tif len(unregistered) != 1 {\n767|\t\tt.Fatalf(\"unregistered = %v, want the store.go site\", unregistered)\n768|\t}\n769|}\n770|\n771|// TestEqualityCensusFailsClosedOnOrphanRow plants the reverse direction: a\n772|// ledger row with no derived site is a witness without a guard.\n773|func TestEqualityCensusFailsClosedOnOrphanRow(t *testing.T) {\n774|\t_, orphaned, failures := invcore.DiffSets(\n775|\t\tmap[string]struct{}{\"sessrepo.go:258\": {}, \"chain.go:426\": {}},\n776|\t\tmap[string]struct{}{\"sessrepo.go:258\": {}, \"chain.go:426\": {}, \"store.go:99\": {}},\n777|\t)\n778|\tif len(failures) != 0 {\n779|\t\tt.Fatalf(\"plant failures = %v\", failures)\n780|\t}\n781|\tif len(orphaned) != 1 || orphaned[0] != \"store.go:99\" {\n782|\t\tt.Fatalf(\"orphaned = %v, want [store.go:99]\", orphaned)\n783|\t}\n784|}\n785|\n786|// TestEqualityCensusFailsClosedOnVarBinding plants the var-binding\n787|// direction in both spellings: binding bytes.Equal (even through an\n788|// import alias) and calling the binding fails the alias audit instead of\n789|// deriving a site.\n790|func TestEqualityCensusFailsClosedOnVarBinding(t *testing.T) {\n791|\tfor _, source := range []string{\n792|\t\t\"package plant\\nimport \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\teq := bytes.Equal\\n\\treturn eq(left, right)\\n}\\n\",\n793|\t\t\"package plant\\nimport be \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\teq := be.Equal\\n\\treturn eq(left, right)\\n}\\n\",\n794|\t} {\n795|\t\tsyntax, fileSet := parseEqualityPlant(t, \"plant.go\", source)\n796|\t\tmatched := false\n797|\t\tfor _, failure := range invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", sessrepoEqualityWideSpec()) {\n798|\t\t\tif strings.Contains(failure, \"outside direct-call position\") {\n799|\t\t\t\tmatched = true\n800|\t\t\t}\n801|\t\t}\n802|\t\tif !matched {\n803|\t\t\tt.Fatalf(\"var-bound equality passed clean for %q; the audit would bless a hidden comparison\", source)\n804|\t\t}\n805|\t}\n806|}\n807|\n808|// TestEqualityCensusFailsClosedOnDotImport plants the unclassifiable\n809|// import shape: a dot import of a watched path fails closed because the\n810|// audit cannot attribute the bare member.\n811|func TestEqualityCensusFailsClosedOnDotImport(t *testing.T) {\n812|\tsyntax, fileSet := parseEqualityPlant(t, \"plant.go\", \"package plant\\nimport . \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\treturn Equal(left, right)\\n}\\n\")\n813|\tmatched := false\n814|\tfor _, failure := range invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", sessrepoEqualityWideSpec()) {\n815|\t\tif strings.Contains(failure, \"dot-imports watched path\") {\n816|\t\t\tmatched = true\n817|\t\t}\n818|\t}\n819|\tif !matched {\n820|\t\tt.Fatalf(\"dot-imported equality passed clean; the audit would bless an unattributable comparison\")\n821|\t}\n822|}\n823|\n824|// TestEqualityCensusFailsClosedOnUnclassifiableSpelling plants the form\n825|// the classifier cannot classify: bytes.Compare (and reflect.DeepEqual)\n826|// compare byte content without either classified spelling and fail the\n827|// census instead of passing silently — including through an import alias.\n828|func TestEqualityCensusFailsClosedOnUnclassifiableSpelling(t *testing.T) {\n829|\tfor _, source := range []string{\n830|\t\t\"package plant\\nimport \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\treturn bytes.Compare(left, right) == 0\\n}\\n\",\n831|\t\t\"package plant\\nimport be \\\"bytes\\\"\\nfunc equal(left, right []byte) bool {\\n\\treturn be.Compare(left, right) == 0\\n}\\n\",\n832|\t\t\"package plant\\nimport \\\"reflect\\\"\\nfunc equal(left, right []byte) bool {\\n\\treturn reflect.DeepEqual(left, right)\\n}\\n\",\n833|\t} {\n834|\t\tsyntax, fileSet := parseEqualityPlant(t, \"plant.go\", source)\n835|\t\tif failures := unclassifiableEqualitySpellings(syntax, fileSet, \"plant.go\"); len(failures) == 0 {\n836|\t\t\tt.Fatalf(\"unclassifiable spelling passed clean for %q; widen the class or keep refusing it, never bless it\", source)\n837|\t\t}\n838|\t}\n839|}"}}}
