{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf2b","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":1520,"recorded_at":1780531400003035,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"b106cac5-649d-4139-8136-f18575e7df4a"},"task_id":"b106cac5-649d-4139-8136-f18575e7df4a","event":{"kind":"output","task_id":"b106cac5-649d-4139-8136-f18575e7df4a","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(544 line(s) above)\n545|\trepository := openTestRepository(t)\n546|\tcreateTestSession(t, repository)\n547|\t_, err := repository.AppendEvent(testSessionID, []byte(specRecordExample))\n548|\tmustErrorIs(t, err, ErrInvalidEvent, \"AppendEvent(record)\")\n549|}\n550|\n551|// TestAppendEventRefusesBadMember exercises the ErrInvalidEvent sentinel\n552|// across malformed member classes. Attribution bound (reviewer N2,\n553|// probe P4): these vectors mutate the object after buildEvent computed a\n554|// valid digest, so the canonical owner's identity verification refuses\n555|// them one arm earlier with the same sentinel — the sessrepo member arms\n556|// (sequence bounds, lease UUIDv4, non-empty predecessors, event type\n557|// presence) are subsumed-by-construction for these classes, exactly like\n558|// the load verify-error arm stated in the outcome. The tests below pin\n559|// the sentinel at the production AppendEvent entry; they do not attribute\n560|// to the member clause.\n561|func TestAppendEventRefusesBadMember(t *testing.T) {\n562|\trepository := openTestRepository(t)\n563|\treference := createTestSession(t, repository)\n564|\tvectors := []struct {\n565|\t\tname   string\n566|\t\tmutate func(object map[string]any)\n567|\t}{\n568|\t\t{\"zero sequence\", func(object map[string]any) { object[\"lease_sequence\"] = 0 }},\n569|\t\t{\"unsafe sequence\", func(object map[string]any) { object[\"lease_sequence\"] = uint64(1 << 53) }},\n570|\t\t{\"non-v4 lease\", func(object map[string]any) { object[\"lease_id\"] = testSessionID }},\n571|\t\t{\"missing predecessors\", func(object map[string]any) { delete(object, \"predecessors\") }},\n572|\t\t{\"malformed predecessor\", func(object map[string]any) { object[\"predecessors\"] = []string{\"not-a-digest\"} }},\n573|\t\t{\"missing event type\", func(object map[string]any) { delete(object, \"event_type\") }},\n574|\t}\n575|\tfor _, vector := range vectors {\n576|\t\tt.Run(vector.name, func(t *testing.T) {\n577|\t\t\traw := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n578|\t\t\tvar object map[string]any\n579|\t\t\tif err := json.Unmarshal(raw, &object); err != nil {\n580|\t\t\t\tt.Fatal(err)\n581|\t\t\t}\n582|\t\t\tvector.mutate(object)\n583|\t\t\tmutated, _ := json.Marshal(object)\n584|\t\t\t_, err := repository.AppendEvent(testSessionID, mutated)\n(more lines below)"}}}
