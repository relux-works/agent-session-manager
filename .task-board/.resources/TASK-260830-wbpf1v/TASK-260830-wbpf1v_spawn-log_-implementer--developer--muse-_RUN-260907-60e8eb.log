specProviderIdentityDigest)\n1463|\t}\n1464|}\n1465|\n1466|// TestLoadRefusesProviderIdentityBlobAtEventPath pins the rewritten\n1467|// attestation bound at the load site: entry decodes gate schema before\n1468|// Verify, but the load path re-verifies stored blobs through Verify and\n1469|// refuses a foreign-schema record at the self-field arm. The planted\n1470|// blob verifies cleanly (see the pin above), carries the indexed digest,\n1471|// and replays valid routing members — the field arm is the only clause\n1472|// that can refuse it, so weakening that arm admits the plant.\n1473|func TestLoadRefusesProviderIdentityBlobAtEventPath(t *testing.T) {\n1474|\trepository := openTestRepository(t)\n1475|\treference := createTestSession(t, repository)\n1476|\t_, chainPath, _ := sessionPaths(t, repository)\n1477|\tindex := map[string]any{\n1478|\t\t\"record_id\": reference.RecordID,\n1479|\t\t\"events\": []any{map[string]any{\n1480|\t\t\t\"event_id\": specProviderIdentityDigest, \"event_type\": \"session.created\",\n1481|\t\t\t\"lease_epoch\": 1, \"lease_id\": testLeaseID, \"lease_sequence\": 1,\n1482|\t\t\t\"predecessors\": []any{reference.RecordID},\n1483|\t\t}},\n1484|\t}\n1485|\tout, err := json.Marshal(index)\n1486|\tif err != nil {\n1487|\t\tt.Fatal(err)\n1488|\t}\n1489|\tif err := os.WriteFile(chainPath, out, 0o600); err != nil {\n1490|\t\tt.Fatal(err)\n1491|\t}\n1492|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, specProviderIdentityDigest), []byte(specProviderIdentityExample), 0o600); err != nil {\n1493|\t\tt.Fatal(err)\n1494|\t}\n1495|\t_, err = repository.GetRecord(testSessionID)\n1496|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(provider-identity blob)\")\n1497|\t_, err = repository.ListEvents(testSessionID)\n1498|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(provider-identity blob)\")\n1499|}\n1500|\n1501|// TestLoadRefusesSwappedEventBlobs drives the content-addressed\n1502|// substitution the digest arm exists for: two cha