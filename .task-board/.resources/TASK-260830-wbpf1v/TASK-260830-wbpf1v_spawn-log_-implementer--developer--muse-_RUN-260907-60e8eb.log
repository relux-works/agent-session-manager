{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb05","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":989,"recorded_at":1780531400001973,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"6b6f0588-df7b-4e9b-a065-5d29de16f51c"},"task_id":"6b6f0588-df7b-4e9b-a065-5d29de16f51c","event":{"kind":"output","task_id":"6b6f0588-df7b-4e9b-a065-5d29de16f51c","chunk":"{\n  \"chunk_id\": \"exec-42-1\",\n  \"command\": \"head -n 60 .temp/TASK-260830-wbpf1v/mutation_battery_rev4.sh 2>&1\\necho \\\"...\\\"\\ngrep -n \\\"^# N\\\\|^N[0-9]\\\\|^# D\\\\|^D[0-9]\\\\|^# C\\\\|^C[0-9]\\\\|^# A\\\\|^A[0-9]\\\\|^# X\\\\|^X[0-9]\\\\|run_group\\\\|^all)\\\" .temp/TASK-260830-wbpf1v/mutation_battery_rev4.sh 2>&1 | head -n 60\\necho \\\"=== rev4 mtime ===\\\"\\nls -la .temp/TASK-260830-wbpf1v/*.sh\",\n  \"description\": \"Inspect rev4 battery script\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"#!/bin/bash\\n# Mutation battery rev4 for TASK-260830-wbpf1v (internal/sessrepo + provhost gate).\\n#\\n# Denominator: production-derived. The refusal census derives 35 refuse()\\n# sites from production AST (sessrepo.go 5, chain.go 25, store.go 5); the\\n# mechanism targets below name the non-refuse gates the census cannot see\\n# (O_EXCL install flag, resume byte-equality, binding-equality halves,\\n# load re-verification arms). Every mutant is applied with an exact-count\\n# string replacement that aborts unless the pattern occurs exactly as\\n# stated, and the tree is restored by checksum after each mutant.\\n#\\n# Classes (reported separately, never folded):\\n#   narrowing    — gate stays present, weakened to admit exactly one member\\n#                  of the class it must reject; a named test must fail.\\n#   arm-deletion — the refusal effect is removed; a named test must fail.\\n#   census-only  — behavioral suite stays green; the full-package census\\n#                  gate fails (unrouted funnel / unregistered site).\\n#   audit-only   — behavioral suite stays green; the full-package alias /\\n#                  derivation audit fails.\\n#   NOT_APPLIED  — harness control: pattern absent, tree provably untouched.\\n#   COMPILE_FAIL — harness control: broken tree fails distinctly.\\n#\\n# Usage: mutation_battery.sh [group]\\n#   groups: narrowing-write | narrowing-load | deletion | gateonly | controls | all\\n#   default: all\\nset -u\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"$0\\\")\\\" && pwd)\\\"\\nW=\\\"$(cd \\\"$SCRIPT_DIR/../..\\\" && pwd)\\\"\\ncd \\\"$W\\\" || exit 1\\n\\nPKG=./internal/sessrepo\\nSNAP=\\\"$(mktemp -d)\\\"\\ntrap 'rm -rf \\\"$SNAP\\\"' EXIT\\n\\nPASS_COUNT=0\\nFAIL_COUNT=0\\nRESULTS=\\\"\\\"\\n\\nsnapshot() {\\n  mkdir -p \\\"$SNAP/sessrepo\\\" \\\"$SNAP/provhost\\\"\\n  cp internal/sessrepo/chain.go internal/sessrepo/sessrepo.go internal/sessrepo/store.go \\\"$SNAP/sessrepo/\\\"\\n  sha256sum internal/sessrepo/chain.go internal/sessrepo/sessrepo.go internal/sessrepo/store.go > \\\"$SNAP/pre.sha\\\"\\n}\\n\\nrestore() {\\n  cp \\\"$SNAP/sessrepo/chain.go\\\" \\\"$SNAP/sessrepo/store.go\\\" \\\"$SNAP/sessrepo/sessrepo.go\\\" internal/sessrepo/\\n  if ! sha256sum -c \\\"$SNAP/pre.sha\\\" > /dev/null 2>&1; then\\n    echo \\\"FATAL: restore checksum mismatch; tree left dirty\\\" >&2\\n    exit 1\\n  fi\\n}\\n\\n# mutate <file> <old> <new> <count> — exact-count replacement or the whole\\n# battery aborts: a mutant that did not apply exactly as stated proves\\n# nothing and must never be recorded as a kill or a survivor.\\nmutate() {\\n  python3 - \\\"$1\\\" \\\"$2\\\" \\\"$3\\\" \\\"$4\\\" <<'EOF'\\nimport sys\\npath, old, new, want = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])\\n...\\n4:# Denominator: production-derived. The refusal census derives 35 refuse()\\n12:# Classes (reported separately, never folded):\\n121:# AND to name the census/audit cause: any other failure is not this kill.\\n=== rev4 mtime ===\\n-rwxr-xr-x@ 1 iv  staff  26313 Sep  7 18:25 .temp/TASK-260830-wbpf1v/mutation_battery_rev4.sh\\n-rwxr-xr-x@ 1 iv  staff  23884 Sep  7 17:37 .temp/TASK-260830-wbpf1v/mutation_battery.sh\\n\",\n  \"original_output_bytes\": 2947,\n  \"original_output_tokens\": 737,\n  \"truncated\": false\n}"}}}
