1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n1532|\tsubstitute := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n1533|\tif string(substitute) == string(firstBytes) {\n1534|\t\tt.Fatal(\"substitute equals the chained event; the vector admits nothing\")\n1535|\t}\n1536|\tvar subID struct {\n1537|\t\tEventID string `json:\"event_id\"`\n1538|\t}\n1539|\tif err := json.Unmarshal(substitute, &subID); err != nil {\n1540|\t\tt.Fatal(err)\n1541|\t}\n1542|\tif subID.EventID == first.EventID {\n1543|\t\tt.Fatal(\"substitute digest equals the indexed digest; the vector admits nothing\")\n1544|\t}\n1545|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, first.EventID), substitute, 0o600); err != nil {\n1546|\t\tt.Fatal(err)\n1547|\t}\n1548|\t_, err := repository.ListEvents(testSessionID)\n1549|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(substituted first blob)\")\n1550|\t_, err = repository.GetRecord(testSessionID)\n1551|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(substituted first blob)\")\n1552|}\n1553|\n1554|// TestCreateSessionRefusesResumeWithDifferingBytes proves the resume\n1555|// byte-equality is load-bearing: an interrupted create (record durable,\n1556|// chain absent) retried with a different record for the same session ID\n1557|// is refused as an existing session, the parked record survives\n1558|// byte-identically, and no chain is installed. The retry carries the\n1559|// same byte length as the parked record, so a narrowed equality that\n1560|// compares lengths only would admit it.\n1561|func TestCreateSessionRefusesResumeWithDifferingBytes(t *testing.T) {\n1562|\trepository := openTestRepository(t)\n1563|\tparked := buildRecord(t, nil)\n1564|\tsameLength := buildRecord(t, func(object map[string]any) {\n1565|\t\tobject[\"name\"] = \"payments-apx\"\n1566|\t})\n1567|\tif len(sameLength) != len(parked) {\n1568|\t\tt.Fatalf(\"plant lengths differ (%d vs %d); the narrowing mutant would not be admitted\", len(parked), len(sameLength))\n1569|\t}\n1570|\tdirectory := repository.sessionDir(testSessionID)\n1571|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n1572|\t\tt.Fatal(err)\n1573|\t}\n1574|\tif err := os.WriteFile(filepath.Join(directory, \"record.json\"), parked, 0o600); err != nil {\n1575|\t\tt.Fatal(err)\n1576|\t}\n1577|\t_, err := repository.CreateSession(sameLength)\n1578|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(resume collision, same length)\")\n1579|\tlonger := buildRecord(t, func(object map[string]any) {\n1580|\t\tobject[\"name\"] = \"payments-api-v2\"\n1581|\t})\n1582|\t_, err = repository.CreateSession(longer)\n1583|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(resume collision, longer)\")\n1584|\tstored, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n1585|\tif err != nil {\n1586|\t\tt.Fatal(err)\n1587|\t}\n1588|\tif string(stored) != string(parked) {\n1589|\t\tt.Fatal(\"parked record changed after refused resume\")\n1590|\t}\n1591|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); !os.IsNotExist(err) {\n1592|\t\tt.Fatalf(\"chain.json state after refused resume = %v, want absent\", err)\n1593|\t}\n1594|}\n1595|\n1596|// TestCreateSessionRefusesResumeOfChainWithoutRecord pins the other\n1597|// resume guard: a chain index with no record beneath it is torn foreign\n1598|// state — no crash ordering in CreateSession produces it — and a retry\n1599|// must refuse it as an existing session rather than installing a record\n1600|// beside it and overwriting the index. The refusal funnels through the\n1601|// existing session-exists site; reads of the same state fail closed as\n1602|// corrupt through the load path.\n1603|func TestCreateSessionRefusesResumeOfChainWithoutRecord(t *testing.T) {\n1604|\trepository := openTestRepository(t)\n1605|\tdirectory := repository.sessionDir(testSessionID)\n1606|\tif err := os.MkdirAll(directory, 0o700); err != nil {\n1607|\t\tt.Fatal(err)\n1608|\t}\n1609|\tforeign, err := json.Marshal(map[string]any{\"record_id\": zeroDigest, \"events\": []any{}})\n1610|\tif err != nil {\n1611|\t\tt.Fatal(err)\n1612|\t}\n1613|\tif err := os.WriteFile(filepath.Join(directory, \"chain.json\"), foreign, 0o600); err != nil {\n1614|\t\tt.Fatal(err)\n1615|\t}\n1616|\t_, err = repository.CreateSession([]byte(specRecordExample))\n1617|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(chain without record)\")\n1618|\tif _, err := os.Stat(filepath.Join(directory, \"record.json\")); !os.IsNotExist(err) {\n1619|\t\tt.Fatalf(\"record.json state after refused resume = %v, want absent\", err)\n1620|\t}\n1621|\trestored, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n1622|\tif err != nil {\n1623|\t\tt.Fatal(err)\n1624|\t}\n1625|\tif string(restored) != string(foreign) {\n1626|\t\tt.Fatal(\"foreign chain index changed after refused resume\")\n1627|\t}\n1628|}\n1629|\n1630|// TestLoadRefusesMismatchedSessionBinding isolates the session-binding\n1631|// half of the record/chain binding check: a valid record for another\n1632|// session stored under this session's directory, with the index rebound\n1633|// to its digest so the record-digest half stays silent. Only the\n1634|// session-ID comparison can refuse it.\n1635|func TestLoadRefusesMismatchedSessionBinding(t *testing.T) {\n1636|\trepository := openTestRepository(t)\n1637|\tcreateTestSession(t, repository)\n1638|\tother := buildRecord(t, func(object map[string]any) {\n1639|\t\tobject[\"session_id\"] = testSessionIDB\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
