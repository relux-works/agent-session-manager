{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c537","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":246,"recorded_at":1780531400000487,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"4b536ea3-494c-4c31-b258-8efb6d3641a3"},"task_id":"4b536ea3-494c-4c31-b258-8efb6d3641a3","event":{"kind":"output","task_id":"4b536ea3-494c-4c31-b258-8efb6d3641a3","chunk":"Read text file `internal/sessrepo/chain.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"io\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// sessionRecord is the validated identity of one Session Record: the exact\n18|// bytes plus the members the repository must bind (SPEC.md Section 5.1).\n19|type sessionRecord struct {\n20|\traw       []byte\n21|\trecordID  string\n22|\tsessionID string\n23|\tname      string\n24|\tkind      string\n25|\tprovider  string\n26|}\n27|\n28|// eventView is the validated routing surface of one Session Event: the\n29|// exact bytes plus the members the chain rules must read (SPEC.md 5.2).\n30|type eventView struct {\n31|\traw          []byte\n32|\teventID      string\n33|\teventType    string\n34|\tsessionID    string\n35|\tleaseEpoch   uint64\n36|\tleaseID      string\n37|\tleaseSeq     uint64\n38|\tpredecessors []string\n39|}\n40|\n41|// storedChain is the chain index: the record digest plus one entry per\n42|// chained event in authoritative order. The blobs are truth; the index is\n43|// a verified cache rebound to them on every load.\n44|type storedChain struct {\n45|\tRecordID string\n46|\tEvents   []EventSummary\n47|}\n48|\n49|// sessionView is one loaded session: record, index, directory, and name facts.\n50|type sessionView struct {\n51|\tdirectory string\n52|\trecord    sessionRecord\n53|\tchain     storedChain\n54|}\n55|\n56|// decodeSessionRecord runs the three validation layers in order: strict\n57|// frame (environ owner), member shape, then canonical identity and closed\n58|// shape (canonicaljson owner). Each layer refuses before the next runs,\n59|// so every site below is reachable with a vector that clears the earlier\n60|// layers and fails exactly this one.\n61|func decodeSessionRecord(raw []byte) (sessionRecord, error) {\n62|\tmembers, fault := environ.DecodeStrictObject(raw)\n63|\tif fault != nil {\n64|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"decode session record frame: %v\", fault)\n65|\t}\n66|\tif schema, err := stringMember(members, \"schema\"); err != nil || schema != sessionRecordSchema {\n67|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"session record schema %q, want %q\", schema, sessionRecordSchema)\n68|\t}\n69|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n70|\tif !ok {\n71|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"session record carries no valid session_id member\")\n72|\t}\n73|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n74|\tif err != nil {\n75|\t\treturn sessionRecord{}, refuse(ErrInvalidRecord, \"verify session record identity: %v\", err)\n76|\t}\n77|\tif field != canonicaljson.SelfRecordID {\n78|\t\treturn sessionRecord{}, fmt.Errorf(\"session record identity field %q, want record_id\", string(field))\n79|\t}\n80|\tname, _ := stringMember(members, \"name\")\n81|\tkind, _ := stringMember(members, \"kind\")\n82|\tprovider, _ := stringMember(members, \"provider_id\")\n83|\treturn sessionRecord{raw: raw, recordID: digest.String(), sessionID: sessionID.String(), name: name, kind: kind, provider: provider}, nil\n84|}\n85|\n86|// decodeSessionEvent runs the same three layers for Session Events: strict\n87|// frame, member shape, then canonical identity and closed payload shape.\n88|func decodeSessionEvent(raw []byte) (eventView, error) {\n89|\tmembers, fault := environ.DecodeStrictObject(raw)\n90|\tif fault != nil {\n91|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"decode session event frame: %v\", fault)\n92|\t}\n93|\tif schema, err := stringMember(members, \"schema\"); err != nil || schema != sessionEventSchema {\n94|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"session event schema %q, want %q\", schema, sessionEventSchema)\n95|\t}\n96|\tevent, err := extractEventMembers(members)\n97|\tif err != nil {\n98|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"session event member: %v\", err)\n99|\t}\n100|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n101|\tif err != nil {\n102|\t\treturn eventView{}, refuse(ErrInvalidEvent, \"verify session event identity: %v\", err)\n103|\t}\n104|\tif field != canonicaljson.SelfEventID {\n105|\t\treturn eventView{}, fmt.Errorf(\"session event identity field %q, want event_id\", string(field))\n106|\t}\n107|\tevent.raw = raw\n108|\tevent.eventID = digest.String()\n109|\treturn event, nil\n110|}\n111|\n112|// extractEventMembers reads the routing members after the frame gate. It\n113|// returns plain errors; the caller attributes them through its one member\n114|// site. Grammar and range rules stay with their owners: UUIDv7 and uint53\n115|// with environ, digests and UUIDv4 with scalar.\n116|func extractEventMembers(members map[string]json.RawMessage) (eventView, error) {\n117|\tvar event eventView\n118|\tsessionID, ok := environ.CheckUUIDv7(memberRaw(members, \"session_id\"))\n119|\tif !ok {\n120|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv7\", \"session_id\")\n121|\t}\n122|\tevent.sessionID = sessionID.String()\n123|\teventType, err := stringMember(members, \"event_type\")\n124|\tif err != nil {\n125|\t\treturn eventView{}, err\n126|\t}\n127|\tevent.eventType = eventType\n128|\tepoch, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_epoch\"), 1, uint53Max)\n129|\tif !ok {\n130|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_epoch\")\n131|\t}\n132|\tevent.leaseEpoch = epoch\n133|\tleaseID, err := stringMember(members, \"lease_id\")\n134|\tif err != nil {\n135|\t\treturn eventView{}, err\n136|\t}\n137|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n138|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a UUIDv4: %v\", \"lease_id\", err)\n139|\t}\n140|\tevent.leaseID = leaseID\n141|\tsequence, ok := environ.CheckUint53Bounds(memberRaw(members, \"lease_sequence\"), 1, uint53Max)\n142|\tif !ok {\n143|\t\treturn eventView{}, fmt.Errorf(\"member %q is not a uint53 at or above 1\", \"lease_sequence\")\n144|\t}\n145|\tevent.leaseSeq = sequence\n146|\tpredecessors, err := digestMembers(members, \"predecessors\")\n147|\tif err != nil {\n148|\t\treturn eventView{}, err\n149|\t}\n150|\tif len(predecessors) == 0 {\n151|\t\treturn eventView{}, fmt.Errorf(\"member %q names no predecessor\", \"predecessors\")\n152|\t}\n153|\tevent.predecessors = predecessors\n154|\treturn event, nil\n155|}\n156|\n157|// checkAppend enforces the SPEC.md Section 5.2 chain rules for one event\n158|// against the record and the current tail: the first event links exactly\n159|// the Session Record at sequence 1 with no gap; within one lease the\n160|// sequence increases by exactly one with no repeat and each event\n161|// references the immediately prior authoritative event; a successor lease\n162|// restarts at 1 referencing the predecessor head; a same-epoch second\n163|// lease diverges and a lower epoch is stale. The reload audit folds this\n164|// same check over the stored index, so weakening any arm breaks both the\n165|// append and the reload evidence.\n166|func checkAppend(recordID string, tail *EventSummary, event eventView) error {\n167|\tif tail != nil && event.leaseID != tail.LeaseID {\n168|\t\tif event.leaseEpoch < tail.LeaseEpoch {\n169|\t\t\treturn refuse(ErrStaleLease, \"event lease epoch %d precedes chain head epoch %d\", event.leaseEpoch, tail.LeaseEpoch)\n170|\t\t}\n171|\t\tif event.leaseEpoch == tail.LeaseEpoch {\n172|\t\t\treturn refuse(ErrDivergentBranch, \"event under lease %s diverges from chain head lease %s at epoch %d\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\n173|\t\t}\n174|\t}\n175|\twant := uint64(1)\n176|\tif tail != nil && event.leaseID == tail.LeaseID {\n177|\t\twant = tail.LeaseSequence + 1\n178|\t}\n179|\tif event.leaseSeq < want {\n180|\t\treturn refuse(ErrSequenceRepeat, \"event lease sequence %d repeats chained sequence through %d\", event.leaseSeq, want-1)\n181|\t}\n182|\tif event.leaseSeq > want {\n183|\t\treturn refuse(ErrSequenceGap, \"event lease sequence %d skips chained sequence %d\", event.leaseSeq, want)\n184|\t}\n185|\tif tail == nil {\n186|\t\tif len(event.predecessors) != 1 || event.predecessors[0] != recordID {\n187|\t\t\treturn refuse(ErrPredecessorLink, \"first event must link exactly the session record\")\n188|\t\t}\n189|\t\treturn nil\n190|\t}\n191|\tif !containsDigest(event.predecessors, tail.EventID) {\n192|\t\treturn refuse(ErrPredecessorLink, \"event predecessors omit prior authoritative event\")\n193|\t}\n194|\treturn nil\n195|}\n196|\n197|func containsDigest(haystack []string, needle string) bool {\n198|\tfor _, candidate := range haystack {\n199|\t\tif candidate == needle {\n200|\t\t\treturn true\n201|\t\t}\n202|\t}\n203|\treturn false\n204|}\n205|\n206|// memberRaw reports the raw member for the environ bound checkers. A\n207|// missing member yields nil, which every checker refuses.\n208|func memberRaw(members map[string]json.RawMessage, name string) json.RawMessage {\n209|\treturn members[name]\n210|}\n211|\n212|// stringMember reads one string member with the language decoder. Grammar\n213|// rules for the value stay with the shape owner; this only accesses it.\n214|func stringMember(members map[string]json.RawMessage, name string) (string, error) {\n215|\traw, ok := members[name]\n216|\tif !ok {\n217|\t\treturn \"\", fmt.Errorf(\"member %q is absent\", name)\n218|\t}\n219|\tvar value string\n220|\tif err := json.Unmarshal(raw, &value); err != nil {\n221|\t\treturn \"\", fmt.Errorf(\"member %q is not a string: %v\", name, err)\n222|\t}\n223|\treturn value, nil\n224|}\n225|\n226|// digestMembers reads one array of digest strings. Digest grammar stays\n227|// with the scalar owner.\n228|func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\n229|\traw, ok := members[name]\n230|\tif !ok {\n231|\t\treturn nil, fmt.Errorf(\"member %q is absent\", name)\n232|\t}\n233|\tvar values []string\n234|\tif err := json.Unmarshal(raw, &values); err != nil {\n235|\t\treturn nil, fmt.Errorf(\"member %q is not a string array: %v\", name, err)\n236|\t}\n237|\tfor _, value := range values {\n238|\t\tif _, err := scalar.ParseDigest(value); err != nil {\n239|\t\t\treturn nil, fmt.Errorf(\"member %q holds malformed digest %q: %v\", name, value, err)\n240|\t\t}\n241|\t}\n242|\treturn values, nil\n243|}\n244|\n245|// sessionDir joins a caller-supplied session ID with no grammar check: a\n246|// traversal ID escapes the sessions root, and the escape refuses at load\n247|// time through the record/session binding, which it can never satisfy.\n248|func (repository *Repository) sessionDir(sessionID string) string {\n249|\treturn filepath.Join(repository.root, sessionID)\n250|}\n251|\n252|// loadSessionLocked loads and fully re-verifies one session: the chain\n253|// index decodes, the record bytes re-verify against the indexed digest,\n254|// every indexed event blob re-verifies, and the index folds clean through\n255|// the append rules. Callers hold the repository mutex.\n256|func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {\n257|\tdirectory := repository.sessionDir(sessionID)\n258|\tif _, err := os.Stat(directory); err != nil {\n259|\t\treturn nil, refuse(ErrUnknownSession, \"unknown session %s\", sessionID)\n260|\t}\n261|\tchainBytes, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n262|\tif err != nil {\n263|\t\treturn nil, refuse(ErrChainCorrupt, \"read chain index for session %s: %v\", sessionID, err)\n264|\t}\n265|\tchain, err := decodeChainIndex(chainBytes)\n266|\tif err != nil {\n267|\t\treturn nil, refuse(ErrChainCorrupt, \"decode chain index for session %s: %v\", sessionID, err)\n268|\t}\n269|\trecordBytes, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n270|\tif err != nil {\n271|\t\treturn nil, refuse(ErrChainCorrupt, \"read session record for session %s: %v\", sessionID, err)\n272|\t}\n273|\trecord, err := decodeSessionRecord(recordBytes)\n274|\tif err != nil {\n275|\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify session record for session %s: %v\", sessionID, err)\n276|\t}\n277|\tif record.recordID != chain.RecordID || record.sessionID != sessionID {\n278|\t\treturn nil, refuse(ErrChainCorrupt, \"chain index does not describe stored session record for session %s\", sessionID)\n279|\t}\n280|\tevents := filepath.Join(directory, \"events\")\n281|\tfor position, indexed := range chain.Events {\n282|\t\tblob, err := os.ReadFile(filepath.Join(events, blobFileName(indexed.EventID)))\n283|\t\tif err != nil {\n284|\t\t\treturn nil, refuse(ErrChainCorrupt, \"read chained event %d for session %s: %v\", position, sessionID, err)\n285|\t\t}\n286|\t\tdigest, field, err := canonicaljson.VerifyObjectIdentity(blob)\n287|\t\tif err != nil {\n288|\t\t\treturn nil, refuse(ErrChainCorrupt, \"re-verify chained event %d for session %s: %v\", position, sessionID, err)\n289|\t\t}\n290|\t\tif field != canonicaljson.SelfEventID {\n291|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chained event %d for session %s carries self field %q, want event_id\", position, sessionID, string(field))\n292|\t\t}\n293|\t\tif digest.String() != indexed.EventID && field != canonicaljson.SelfEventID {\n294|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chained event %d for session %s digest %s disagrees with indexed event %s\", position, sessionID, digest.String(), indexed.EventID)\n295|\t\t}\n296|\t\tvar tail *EventSummary\n297|\t\tif position > 0 {\n298|\t\t\ttail = &chain.Events[position-1]\n299|\t\t}\n300|\t\treplay := eventView{eventID: indexed.EventID, eventType: indexed.EventType, sessionID: sessionID, leaseEpoch: indexed.LeaseEpoch, leaseID: indexed.LeaseID, leaseSeq: indexed.LeaseSequence, predecessors: indexed.Predecessors}\n301|\t\tif err := checkAppend(chain.RecordID, tail, replay); err != nil {\n302|\t\t\treturn nil, refuse(ErrChainCorrupt, \"chain index order breaks continuity at event %d for session %s: %v\", position, sessionID, err)\n303|\t\t}\n304|\t}\n305|\treturn &sessionView{directory: directory, record: record, chain: chain}, nil\n306|}\n307|\n308|// decodeChainIndex decodes the internal chain index. It is not an AX wire\n309|// object, so the canonical owner does not validate it; member grammars\n310|// still stay with environ and scalar.\n311|func decodeChainIndex(raw []byte) (storedChain, error) {\n312|\tmembers, fault := environ.DecodeStrictObject(raw)\n313|\tif fault != nil {\n314|\t\treturn storedChain{}, fmt.Errorf(\"decode chain frame: %v\", fault)\n315|\t}\n316|\trecordID, err := stringMember(members, \"record_id\")\n317|\tif err != nil {\n318|\t\treturn storedChain{}, err\n319|\t}\n320|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n321|\t\treturn storedChain{}, fmt.Errorf(\"chain record_id: %v\", err)\n322|\t}\n323|\trawEvents, ok := members[\"events\"]\n324|\tif !ok {\n325|\t\treturn storedChain{}, fmt.Errorf(\"member %q is absent\", \"events\")\n326|\t}\n327|\tvar entries []map[string]json.RawMessage\n328|\tif err := json.Unmarshal(rawEvents, &entries); err != nil {\n329|\t\treturn storedChain{}, fmt.Errorf(\"member %q is not an object array: %v\", \"events\", err)\n330|\t}\n331|\tchain := storedChain{RecordID: recordID}\n332|\tfor _, entry := range entries {\n333|\t\tsummary, err := decodeChainEntry(entry)\n334|\t\tif err != nil {\n335|\t\t\treturn storedChain{}, err\n336|\t\t}\n337|\t\tchain.Events = append(chain.Events, summary)\n338|\t}\n339|\treturn chain, nil\n340|}\n341|\n342|// decodeChainEntry validates one index entry. Failures are plain errors;\n343|// loadSessionLocked attributes them through its one index site.\n344|func decodeChainEntry(entry map[string]json.RawMessage) (EventSummary, error) {\n345|\tvar summary EventSummary\n346|\teventID, err := stringMember(entry, \"event_id\")\n347|\tif err != nil {\n348|\t\treturn EventSummary{}, err\n349|\t}\n350|\tif _, err := scalar.ParseDigest(eventID); err != nil {\n351|\t\treturn EventSummary{}, fmt.Errorf(\"chain event_id: %v\", err)\n352|\t}\n353|\tsummary.EventID = eventID\n354|\teventType, err := stringMember(entry, \"event_type\")\n355|\tif err != nil {\n356|\t\treturn EventSummary{}, err\n357|\t}\n358|\tsummary.EventType = eventType\n359|\tepoch, ok := environ.CheckUint53Bounds(entry[\"lease_epoch\"], 1, uint53Max)\n360|\tif !ok {\n361|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_epoch\")\n362|\t}\n363|\tsummary.LeaseEpoch = epoch\n364|\tleaseID, err := stringMember(entry, \"lease_id\")\n365|\tif err != nil {\n366|\t\treturn EventSummary{}, err\n367|\t}\n368|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n369|\t\treturn EventSummary{}, fmt.Errorf(\"chain lease_id: %v\", err)\n370|\t}\n371|\tsummary.LeaseID = leaseID\n372|\tsequence, ok := environ.CheckUint53Bounds(entry[\"lease_sequence\"], 1, uint53Max)\n373|\tif !ok {\n374|\t\treturn EventSummary{}, fmt.Errorf(\"chain member %q is not a uint53 at or above 1\", \"lease_sequence\")\n375|\t}\n376|\tsummary.LeaseSequence = sequence\n377|\tpredecessors, err := digestMembers(entry, \"predecessors\")\n378|\tif err != nil {\n379|\t\treturn EventSummary{}, err\n380|\t}\n381|\tsummary.Predecessors = predecessors\n382|\treturn summary, nil\n383|}\n384|\n385|// writeChain stores the index atomically: temp file, fsync, rename, fsync\n386|// the directory. A crash either leaves the previous index or the new one;\n387|// the blobs it names are verified on every load, so neither outcome can\n388|// invent history.\n389|func (repository *Repository) writeChain(directory string, chain storedChain) error {\n390|\tpayload, err := json.Marshal(chainPayload{RecordID: chain.RecordID, Events: chain.Events})\n391|\tif err != nil {\n392|\t\treturn fmt.Errorf(\"encode chain index: %w\", err)\n393|\t}\n394|\treturn writeAtomic(filepath.Join(directory, \"chain.json\"), payload)\n395|}\n396|\n397|// chainPayload is the on-disk shape of the index. EventSummary carries the\n398|// JSON tags so the stored form stays exactly this struct.\n399|type chainPayload struct {\n400|\tRecordID string         `json:\"record_id\"`\n401|\tEvents   []EventSummary `json:\"events\"`\n402|}\n403|\n404|// errDigestDisagreement reports bytes at a digest path that a completed\n405|// read proved different from the installing candidate. It is an internal\n406|// marker, never a refusal: callers attribute it through their own site.\n407|var errDigestDisagreement = errors.New(\"digest path holds disagreeing bytes\")\n408|\n409|// installEventBlob installs one event blob idempotently through the\n410|// no-replace open first: a fresh path is created atomically, and only an\n411|// EEXIST loser falls back to comparing against the winner's bytes —\n412|// identical bytes are reused, disagreeing bytes are reported for\n413|// refusal. Leading with the exclusive create (instead of stat-then-act)\n414|// keeps the no-replace property a filesystem fact under a second\n415|// process, not a check-then-act race the repository mutex cannot see:\n416|// the mutex serializes one process, while O_EXCL serializes all of\n417|// them. A path that exists but is not a readable file still fails the\n418|// install, as an operational error rather than a digest disagreement.\n419|func installEventBlob(path string, data []byte) error {\n420|\tif err := writeExclusive(path, data); err == nil {\n421|\t\treturn nil\n422|\t} else if !os.IsExist(err) {\n423|\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n424|\t}\n425|\texisting, readErr := os.ReadFile(path)\n426|\tif readErr != nil || !bytes.Equal(existing, data) {\n427|\t\treturn errDigestDisagreement\n428|\t}\n429|\treturn nil\n430|}\n431|\n432|// writeExclusive installs bytes at a path that must not exist. The\n433|// no-replace open makes append-only a filesystem property, not a convention.\n434|func writeExclusive(path string, data []byte) error {\n435|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n436|\tif err != nil {\n437|\t\treturn err\n438|\t}\n439|\tif _, err := file.Write(data); err != nil {\n440|\t\t_ = file.Close()\n441|\t\treturn fmt.Errorf(\"write exclusive file: %w\", err)\n442|\t}\n443|\tif err := file.Sync(); err != nil {\n444|\t\t_ = file.Close()\n445|\t\treturn fmt.Errorf(\"fsync exclusive file: %w\", err)\n446|\t}\n447|\tif err := file.Close(); err != nil {\n448|\t\treturn fmt.Errorf(\"close exclusive file: %w\", err)\n449|\t}\n450|\treturn nil\n451|}\n452|\n453|// writeAtomic replaces a path through a temp file in the same directory:\n454|// staged bytes fsync before the rename, the directory fsyncs after.\n455|func writeAtomic(path string, data []byte) error {\n456|\tstaged, err := os.CreateTemp(filepath.Dir(path), \".ax-chain-stage-\")\n457|\tif err != nil {\n458|\t\treturn fmt.Errorf(\"stage chain index: %w\", err)\n459|\t}\n460|\tstagedPath := staged.Name()\n461|\tfinished := false\n462|\tdefer func() {\n463|\t\tif !finished {\n464|\t\t\t_ = staged.Close()\n465|\t\t\t_ = os.Remove(stagedPath)\n466|\t\t}\n467|\t}()\n468|\tif err := staged.Chmod(0o600); err != nil {\n469|\t\treturn fmt.Errorf(\"mode staged chain index: %w\", err)\n470|\t}\n471|\tif _, err := io.Copy(staged, bytes.NewReader(data)); err != nil {\n472|\t\treturn fmt.Errorf(\"write staged chain index: %w\", err)\n473|\t}\n474|\tif err := staged.Sync(); err != nil {\n475|\t\treturn fmt.Errorf(\"fsync staged chain index: %w\", err)\n476|\t}\n477|\tif err := staged.Close(); err != nil {\n478|\t\treturn fmt.Errorf(\"close staged chain index: %w\", err)\n479|\t}\n480|\tfinished = true\n481|\tif err := os.Rename(stagedPath, path); err != nil {\n482|\t\treturn fmt.Errorf(\"install chain index: %w\", err)\n483|\t}\n484|\treturn syncDirectory(filepath.Dir(path))\n485|}\n486|\n487|// blobFileName maps a validated event digest to its file name. The digest\n488|// passed scalar grammar at decode time; Hex is the owner's rendering.\n489|func blobFileName(eventID string) string {\n490|\tdigest, err := scalar.ParseDigest(eventID)\n491|\tif err != nil {\n492|\t\treturn \"invalid.json\"\n493|\t}\n494|\treturn digest.Hex() + \".json\"\n495|}"}}}
