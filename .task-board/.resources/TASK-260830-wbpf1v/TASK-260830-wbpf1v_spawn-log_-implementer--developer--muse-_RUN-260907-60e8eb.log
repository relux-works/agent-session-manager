{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca75","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":917,"recorded_at":1780531400001829,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"f974f602-ef12-4437-b7b3-f884377995f9"},"task_id":"f974f602-ef12-4437-b7b3-f884377995f9","event":{"kind":"output","task_id":"f974f602-ef12-4437-b7b3-f884377995f9","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(399 line(s) above)\n400|\t}\n401|\tif len(summaries) != 2 {\n402|\t\tt.Fatalf(\"sessions = %d, want 2\", len(summaries))\n403|\t}\n404|\tif summaries[0].SessionID != testSessionID || summaries[1].SessionID != testSessionIDB {\n405|\t\tt.Fatalf(\"session order = %q %q, want ID order\", summaries[0].SessionID, summaries[1].SessionID)\n406|\t}\n407|\tif summaries[0].Name != \"payments-api\" || summaries[0].Kind != \"direct\" || summaries[0].ProviderID != \"codex\" {\n408|\t\tt.Fatalf(\"first summary = %+v, want stored identity\", summaries[0])\n409|\t}\n410|\tif summaries[0].EventCount != 1 || summaries[0].TailEvent != first.EventID {\n411|\t\tt.Fatalf(\"first head = %+v, want count 1 tail %s\", summaries[0], first.EventID)\n412|\t}\n413|\tif summaries[1].RecordID != otherRef.RecordID || summaries[1].EventCount != 0 || summaries[1].TailEvent != \"\" {\n414|\t\tt.Fatalf(\"second summary = %+v, want empty chain\", summaries[1])\n415|\t}\n416|\t// A stray non-session file in the namespace is ignored, never listed.\n417|\tif err := os.WriteFile(filepath.Join(repository.root, \"stray.txt\"), []byte(\"x\"), 0o600); err != nil {\n418|\t\tt.Fatal(err)\n419|\t}\n420|\tsummaries, err = repository.ListSessions()\n421|\tif err != nil {\n422|\t\tt.Fatal(err)\n423|\t}\n424|\tif len(summaries) != 2 {\n425|\t\tt.Fatalf(\"sessions with stray file = %d, want 2\", len(summaries))\n426|\t}\n427|}\n428|\n429|func TestOpenRefusesNonAbsoluteRoot(t *testing.T) {\n430|\t_, err := Open(\"relative/data\")\n431|\tmustErrorIs(t, err, ErrRepositoryPath, \"Open(relative)\")\n432|}\n433|\n434|func TestOpenRefusesFileAsRoot(t *testing.T) {\n435|\tfile := filepath.Join(t.TempDir(), \"file\")\n436|\tif err := os.WriteFile(file, []byte(\"x\"), 0o600); err != nil {\n437|\t\tt.Fatal(err)\n438|\t}\n439|\t_, err := Open(file)\n440|\tmustErrorIs(t, err, ErrRepositoryPath, \"Open(file)\")\n441|}\n442|\n443|func TestCreateSessionRefusesMalformedFrame(t *testing.T) {\n444|\trepository := openTestRepository(t)\n445|\t_, err := repository.CreateSession([]byte(`{\"schema\": \"urn:ax:schema:session-record\",`))\n446|\tmustErrorIs(t, err, ErrInvalidRecord, \"CreateSession(truncated)\")\n447|}\n448|\n449|func TestCreateSessionRefusesForeignSchema(t *testing.T) {\n450|\trepository := openTestRepository(t)\n451|\t// A valid session EVENT is not a session record: the schema gate fires\n452|\t// before identity is ever consulted.\n453|\tevent := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{\"sha256:d61701066a7f5dd37bf35fea0e85e7f154251355ad24a49976532d7f79ddc772\"}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n454|\t_, err := repository.CreateSession(event)\n455|\tmustErrorIs(t, err, ErrInvalidRecord, \"CreateSession(event)\")\n456|}\n457|\n458|// TestCreateSessionRefusesMissingSessionID pins the ErrInvalidRecord\n459|// sentinel for a record without a session_id. Attribution bound (N2):\n(more lines below)"}}}
