{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"469a5fd7-7dc5-43ff-a48a-ad83ac151003"},"task_id":"469a5fd7-7dc5-43ff-a48a-ad83ac151003","event":{"kind":"output","task_id":"469a5fd7-7dc5-43ff-a48a-ad83ac151003","chunk":"{\n  \"chunk_id\": \"exec-21-1\",\n  \"command\": \"task-board worktree --help 2>&1 | head -n 100\\necho \\\"===\\\"\\ntask-board worktree status 2>&1 | head -n 60\",\n  \"description\": \"Check worktree status\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Inspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n===\\nSTORY-260830-1i3qu7  active\\n  path:       .temp/STORY-260830-1i3qu7/worktree (present)\\n  branch:     task-board/story/STORY-260830-1i3qu7 (present)\\n  base:       main\\n  tip:        7f90e5858cd8346228f7aa687252266f1c133244\\n  tree:       dirty\\n  blocked:    workspace registry is owned by run RUN-260906-ce22ea while no matching lease is visible\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-2ciy0s rev 3 checkpointed (repository_delta=present, 35 changed path(s))\\n  change-req: TASK-260830-2uowwk rev 2 accepted (repository_delta=present, 60 changed path(s))\\n  change-req: TASK-260830-7a0s2c rev 3 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-2dy8oj  active\\n  path:       .temp/STORY-260830-2dy8oj/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2dy8oj (present)\\n  base:       main\\n  tip:        81305c8886ead674122f498ad2124051257c9467\\n  tree:       not checked out\\n  blocked:    workspace registry is owned by run RUN-260901-dea170 while no matching lease is visible\\n  change-req: TASK-260830-3amrl9 rev 8 checkpointed (repository_delta=present, 14 changed path(s))\\n  change-req: TASK-260830-3ps1b1 rev 6 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-2jylym  active\\n  path:       .temp/STORY-260830-2jylym/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2jylym (present)\\n  base:       main\\n  tip:        adca16af03663682ec57993122c22c667813afc9\\n  tree:       not checked out\\n  blocked:    workspace registry is owned by run RUN-260903-8436b6 while no matching lease is visible\\n  change-req: TASK-260830-1bipsa rev 1 checkpointed (repository_delta=empty, 0 changed path(s))\\n  change-req: TASK-260830-33sfxc rev 7 accepted (repository_delta=present, 73 changed path(s))\\n  change-req: TASK-260830-34elja rev 2 checkpointed (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-2wdm5e  active\\n  path:       .temp/STORY-260830-2wdm5e/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2wdm5e (present)\\n  base:       main\\n  tip:        ad7275181ca82fc3fa29544e3893923a92d7b9d5\\n  tree:       not checked out\\n  blocked:    workspace registry is owned by run RUN-260901-4717b6 while no matching lease is visible\\n  change-req: TASK-260830-1pbx0c rev 6 checkpointed (repository_delta=present, 12 changed path(s))\\n  change-req: TASK-260830-236x9n rev 5 checkpointed (repository_delta=present, 19 changed path(s))\\n  change-req: TASK-260830-8x76g1 rev 16 accepted (repository_delta=present, 71 changed path(s))\\nSTORY-260830-323tpq  active\\n  path:       .temp/STORY-260830-323tpq/worktree (missing)\\n  branch:     task-board/story/STORY-260830-323tpq (present)\\n  base:       main\\n  tip:        48db30b59e5e1bbc5e0cf73ec2e0e0eec3d