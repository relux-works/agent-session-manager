{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c605","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":349,"recorded_at":1780531400000693,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"call_id":"call_01a07d35f4697fd3a8209320833b3e39","text":"Read text file `internal/invcore/invcore.go`.\n1|// Package invcore is the shared test-support core for production-derived\n2|// inventories: production-file selection, fail-closed parsing, and the\n3|// both-direction check harness.\n4|//\n5|// Every package inventory in this repository derives its denominator from\n6|// production source instead of listing it, in three historical\n7|// architectures for the same idea: terminalbackend resolves declared rows\n8|// textually and refuses constructor aliasing outright; provhost executes\n9|// every witness through the production entry point and keys on identifier\n10|// names behind a separate call-site audit; provider instruments constructor\n11|// vars at runtime in TestMain and audits the exercised file:line set\n12|// against AST-derived sites. The weaker bound was the real bound, so this\n13|// core carries the UNION of those directions, not the intersection:\n14|//\n15|//   - ScanProduction owns production-file selection: directory-derived,\n16|//     every *.go except *_test.go, sorted, so a new production file is\n17|//     scanned without anyone remembering it. Zero files is a failure,\n18|//     never a vacuous pass.\n19|//   - MustParse owns fail-closed parsing: an unparseable file fails, never\n20|//     skips. A file the derivation cannot read proves nothing.\n21|//   - DiffSets owns the both-direction harness: derived-without-row\n22|//     (unregistered site) AND row-without-site (orphan row) fail together.\n23|//     The forward direction alone passes vacuously on a truncated\n24|//     derivation.\n25|//   - AuditConstructorReferences owns the alias-bypass union: constructor\n26|//     references outside direct-call position fail outright\n27|//     (terminalbackend direction), import aliases and dot imports resolve\n28|//     against the imported path instead of the local spelling (the shape\n29|//     that walked through every identifier-keyed gate in this repository),\n30|//     and var bindings are references, not calls (provider direction made\n31|//     static). Anything the audit cannot classify — a dot import of a\n32|//     watched path, an unresolved shadowing — fails closed as\n33|//     unclassifiable, never pruned.\n34|//   - SiteRecorder owns the runtime direction (provider/provhost shape):\n35|//     instrumented constructor vars record the production file:line behind\n36|//     every exercised refusal, and the audit requires the exercised set to\n37|//     equal the derived site set in both directions.\n38|//\n39|// All checks come in two spellings: a pure func returning failures for\n40|// negative tests and control plants, and a Must wrapper that fails the\n41|// suite. A gate that can only fatal cannot be planted against, and a plant\n42|// that cannot run proves nothing.\n43|package invcore\n44|\n45|import (\n46|\t\"go/ast\"\n47|\t\"go/parser\"\n48|\t\"go/token\"\n49|\t\"os\"\n50|\t\"path/filepath\"\n51|\t\"sort\"\n52|\t\"strconv\"\n53|\t\"strings\"\n54|)\n55|\n56|// ProductionFile is one parsed production source: basename, full path,\n57|// raw bytes, and syntax parsed with a directory-shared FileSet.\n58|type ProductionFile struct {\n59|\tName   string\n60|\tPath   string\n61|\tSource []byte\n62|\tSyntax *ast.File\n63|\tFile   *token.File\n64|}\n65|\n66|// ScanProduction reads every production file of the directory at dir:\n67|// every *.go except *_test.go, in sorted order. It returns the parsed\n68|// files with their shared FileSet, plus a failure string for every\n69|// fail-closed condition: an unreadable directory, an unreadable file, an\n70|// unparseable file, or zero production files. An empty failure slice with\n71|// an empty file list is impossible by construction.\n72|func ScanProduction(dir string) ([]ProductionFile, *token.FileSet, []string) {\n73|\tentries, err := os.ReadDir(dir)\n74|\tif err != nil {\n75|\t\treturn nil, nil, []string{\"scan production files: read \" + dir + \": \" + err.Error()}\n76|\t}\n77|\tvar names []string\n78|\tfor _, entry := range entries {\n79|\t\tname := entry.Name()\n80|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n81|\t\t\tcontinue\n82|\t\t}\n83|\t\tnames = append(names, name)\n84|\t}\n85|\tsort.Strings(names)\n86|\tif len(names) == 0 {\n87|\t\treturn nil, nil, []string{\"scanned zero production files in \" + dir + \"; the scanner is broken, not the package\"}\n88|\t}\n89|\tfileSet := token.NewFileSet()\n90|\tvar files []ProductionFile\n91|\tvar failures []string\n92|\tfor _, name := range names {\n93|\t\tpath := filepath.Join(dir, name)\n94|\t\tsource, err := os.ReadFile(path)\n95|\t\tif err != nil {\n96|\t\t\tfailures = append(failures, \"scan production files: read \"+path+\": \"+err.Error())\n97|\t\t\tcontinue\n98|\t\t}\n99|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n100|\t\tif err != nil {\n101|\t\t\tfailures = append(failures, \"scan production files: parse \"+path+\": \"+err.Error()+\"; an unparseable derivation proves nothing\")\n102|\t\t\tcontinue\n103|\t\t}\n104|\t\tfiles = append(files, ProductionFile{\n105|\t\t\tName:   name,\n106|\t\t\tPath:   path,\n107|\t\t\tSource: source,\n108|\t\t\tSyntax: syntax,\n109|\t\t\tFile:   fileSet.File(syntax.Pos()),\n110|\t\t})\n111|\t}\n112|\tif len(files) == 0 && len(failures) == 0 {\n113|\t\tfailures = append(failures, \"derived zero parsed production files in \"+dir+\"; the scanner is broken, not the package\")\n114|\t}\n115|\treturn files, fileSet, failures\n116|}\n117|\n118|// ParseSource parses one synthetic source (control plants, classifier\n119|// unit probes) with fail-closed semantics: the failure string is empty on\n120|// success and names the cause otherwise.\n121|func ParseSource(filename string, source []byte) (*ast.File, *token.FileSet, string) {\n122|\treturn ParseBytes(filename, source, parser.ParseComments)\n123|}\n124|\n125|// ParseBytes parses one source with the given parser mode and fail-closed\n126|// semantics: the failure string is empty on success and names the cause\n127|// otherwise. Inventories with a non-standard traversal (recursive walk,\n128|// content prefilter, imports-only scan) keep their traversal and route\n129|// parsing here, so an unparseable file fails identically everywhere.\n130|func ParseBytes(filename string, source []byte, mode parser.Mode) (*ast.File, *token.FileSet, string) {\n131|\tfileSet := token.NewFileSet()\n132|\tsyntax, err := parser.ParseFile(fileSet, filename, source, mode)\n133|\tif err != nil {\n134|\t\treturn nil, nil, \"parse \" + filename + \": \" + err.Error() + \"; an unparseable derivation proves nothing\"\n135|\t}\n136|\treturn syntax, fileSet, \"\"\n137|}\n138|\n139|// DiffSets is the both-direction harness over string keys: every derived\n140|// key without a row is unregistered, every row without a derived key is\n141|// orphaned. Both lists are sorted. Empty derived input is itself a\n142|// failure: a domain that silently derives nothing is not a measurement,\n143|// and the forward check would otherwise pass vacuously.\n144|func DiffSets(derived, rows map[string]struct{}) (unregistered, orphaned, failures []string) {\n145|\tif len(derived) == 0 {\n146|\t\tfailures = append(failures, \"derived zero sites; the scanner is broken, not the package\")\n147|\t}\n148|\tfor key := range derived {\n149|\t\tif _, ok := rows[key]; !ok {\n150|\t\t\tunregistered = append(unregistered, key)\n151|\t\t}\n152|\t}\n153|\tfor key := range rows {\n154|\t\tif _, ok := derived[key]; !ok {\n155|\t\t\torphaned = append(orphaned, key)\n156|\t\t}\n157|\t}\n158|\tsort.Strings(unregistered)\n159|\tsort.Strings(orphaned)\n160|\treturn unregistered, orphaned, failures\n161|}\n162|\n163|// ConstructorSpec declares the refusal constructors one audit watches:\n164|// package-local bare identifiers (mismatchf) and qualified constructors\n165|// matched by IMPORT PATH and member name (errors.New), so an import alias\n166|// cannot change what the audit sees.\n167|type ConstructorSpec struct {\n168|\t// Local names package-local constructor identifiers.\n169|\tLocal map[string]bool\n170|\t// Qualified maps an import path to its watched member names:\n171|\t// {\"errors\": {\"New\": true}, \"fmt\": {\"Errorf\": true}}. A member name\n172|\t// with a trailing \"*\" matches by prefix (\"Errorf*\" covers Errorf\n173|\t// and its Errorf-prefixed kin).\n174|\tQualified map[string]map[string]bool\n175|}\n176|\n177|// qualifiedWatches reports whether member is watched under path,\n178|// honoring trailing-\"*\" prefix entries.\n179|func qualifiedWatches(spec ConstructorSpec, path, member string) bool {\n180|\tmembers, ok := spec.Qualified[path]\n181|\tif !ok {\n182|\t\treturn false\n183|\t}\n184|\tif members[member] {\n185|\t\treturn true\n186|\t}\n187|\tfor watched := range members {\n188|\t\tif strings.HasSuffix(watched, \"*\") && strings.HasPrefix(member, strings.TrimSuffix(watched, \"*\")) {\n189|\t\t\treturn true\n190|\t\t}\n191|\t}\n192|\treturn false\n193|}\n194|\n195|// AuditConstructorReferences fails every constructor reference outside\n196|// direct-call position: aliases, var bindings, arguments, struct fields,\n197|// and shadows. Import aliases resolve through the file's import specs, so\n198|// `import errs \"errors\"; errs.New(\"…\")` attributes to errors.New and\n199|// `alias := errs.New` fails like any other binding. A dot import of a\n200|// watched path or any other shape the audit cannot classify fails closed\n201|// as unclassifiable instead of passing silently. Direct calls and the\n202|// constructors' own declarations are the only allowed positions.\n203|func AuditConstructorReferences(syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) []string {\n204|\timports := resolveImports(syntax, spec)\n205|\tfor path := range spec.Qualified {\n206|\t\tif dot, ok := imports.dot[path]; ok && dot {\n207|\t\t\treturn []string{display + \": dot-imports watched path \" + strconv.Quote(path) + \"; the audit cannot attribute bare \" + constructorMembers(spec.Qualified[path]) + \", qualify the import or widen the audit\"}\n208|\t\t}\n209|\t}\n210|\tallowed := map[token.Pos]bool{}\n211|\tast.Inspect(syntax, func(node ast.Node) bool {\n212|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n213|\t\tif ok && spec.Local[declaration.Name.Name] {\n214|\t\t\t// The declaration name itself is allowed, but the body\n215|\t\t\t// still scans: a direct call nested inside the funnel\n216|\t\t\t// body is attributable and must stay allowed.\n217|\t\t\tallowed[declaration.Name.Pos()] = true\n218|\t\t\treturn true\n219|\t\t}\n220|\t\tcall, ok := node.(*ast.CallExpr)\n221|\t\tif !ok {\n222|\t\t\treturn true\n223|\t\t}\n224|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n225|\t\t\tallowed[ident.Pos()] = true\n226|\t\t\treturn true\n227|\t\t}\n228|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n229|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n230|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n231|\t\t\t\t\tallowed[selector.Sel.Pos()] = true\n232|\t\t\t\t}\n233|\t\t\t}\n234|\t\t}\n235|\t\treturn true\n236|\t})\n237|\tvar failures []string\n238|\tast.Inspect(syntax, func(node ast.Node) bool {\n239|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n240|\t\tif ok && spec.Local[declaration.Name.Name] {\n241|\t\t\t// Descend: the declaration name is allowlisted by\n242|\t\t\t// position, but references nested in the funnel body\n243|\t\t\t// still audit.\n244|\t\t\treturn true\n245|\t\t}\n246|\t\tident, ok := node.(*ast.Ident)\n247|\t\tif !ok || allowed[ident.Pos()] {\n248|\t\t\treturn true\n249|\t\t}\n250|\t\tif spec.Local[ident.Name] {\n251|\t\t\tif _, declared := imports.names[ident.Name]; declared {\n252|\t\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" shadowed by an import or declaration the audit cannot classify; rename it or widen the audit\")\n253|\t\t\t\treturn true\n254|\t\t\t}\n255|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" referenced outside direct-call position; an aliased refusal cannot be inventoried, call it directly\")\n256|\t\t\treturn true\n257|\t\t}\n258|\t\treturn true\n259|\t})\n260|\tast.Inspect(syntax, func(node ast.Node) bool {\n261|\t\tselector, ok := node.(*ast.SelectorExpr)\n262|\t\tif !ok || allowed[selector.Sel.Pos()] {\n263|\t\t\treturn true\n264|\t\t}\n265|\t\treceiver, ok := selector.X.(*ast.Ident)\n266|\t\tif !ok {\n267|\t\t\treturn true\n268|\t\t}\n269|\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n270|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, selector.Sel.Pos())+\": constructor \"+strconv.Quote(receiver.Name+\".\"+selector.Sel.Name)+\" referenced outside direct-call position; an aliased construction cannot be inventoried, call it directly\")\n271|\t\t}\n272|\t\treturn true\n273|\t})\n274|\tsort.Strings(failures)\n275|\treturn failures\n276|}\n277|\n278|// FunPosition reports the audited position of a call's function: the\n279|// identifier for bare calls, the selector member for qualified calls.\n280|// WatchedCallPositions keys on exactly these positions.\n281|func FunPosition(call *ast.CallExpr) (token.Pos, bool) {\n282|\tswitch fun := call.Fun.(type) {\n283|\tcase *ast.Ident:\n284|\t\treturn fun.Pos(), true\n285|\tcase *ast.SelectorExpr:\n286|\t\treturn fun.Sel.Pos(), true\n287|\tdefault:\n288|\t\treturn token.NoPos, false\n289|\t}\n290|}\n291|\n292|// WatchedCallPositions returns the audited positions of every direct\n293|// call to a watched constructor in syntax: the attribution set. Callers\n294|// use it to attribute each watched construction to its enclosing\n295|// function (an allowlist scan), while AuditConstructorReferences owns\n296|// the alias direction over the same spec.\n297|func WatchedCallPositions(syntax *ast.File, spec ConstructorSpec) map[token.Pos]bool {\n298|\timports := resolveImports(syntax, spec)\n299|\tpositions := map[token.Pos]bool{}\n300|\tast.Inspect(syntax, func(node ast.Node) bool {\n301|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n302|\t\tif ok && spec.Local[declaration.Name.Name] {\n303|\t\t\treturn true\n304|\t\t}\n305|\t\tcall, ok := node.(*ast.CallExpr)\n306|\t\tif !ok {\n307|\t\t\treturn true\n308|\t\t}\n309|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n310|\t\t\tpositions[ident.Pos()] = true\n311|\t\t\treturn true\n312|\t\t}\n313|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n314|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n315|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n316|\t\t\t\t\tpositions[selector.Sel.Pos()] = true\n317|\t\t\t\t}\n318|\t\t\t}\n319|\t\t}\n320|\t\treturn true\n321|\t})\n322|\treturn positions\n323|}\n324|\n325|// importResolution maps the file's local import names to paths.\n326|type importResolution struct {\n327|\tnames map[string]string\n328|\tdot   map[string]bool\n329|}\n330|\n331|func (resolution importResolution) pathOf(local string) string {\n332|\treturn resolution.names[local]\n333|}\n334|\n335|// resolveImports reads the file's import specs into local-name to path\n336|// bindings. Explicit aliases, blank imports, and default base names all\n337|// resolve; only dot imports are unresolvable, and the caller fails them\n338|// closed.\n339|func resolveImports(syntax *ast.File, spec ConstructorSpec) importResolution {\n340|\tresolution := importResolution{names: map[string]string{}, dot: map[string]bool{}}\n341|\tfor _, declaration := range syntax.Decls {\n342|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n343|\t\tif !ok || general.Tok != token.IMPORT {\n344|\t\t\tcontinue\n345|\t\t}\n346|\t\tfor _, item := range general.Specs {\n347|\t\t\tloaded, ok := item.(*ast.ImportSpec)\n348|\t\t\tif !ok {\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tpath, err := strconv.Unquote(loaded.Path.Value)\n352|\t\t\tif err != nil {\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif loaded.Name != nil && loaded.Name.Name == \".\" {\n356|\t\t\t\tresolution.dot[path] = true\n357|\t\t\t\tcontinue\n358|\t\t\t}\n359|\t\t\tlocal := importBaseName(path)\n360|\t\t\tif loaded.Name != nil {\n361|\t\t\t\tlocal = loaded.Name.Name\n362|\t\t\t}\n363|\t\t\tif local == \"_\" {\n364|\t\t\t\tcontinue\n365|\t\t\t}\n366|\t\t\tresolution.names[local] = path\n367|\t\t}\n368|\t}\n369|\treturn resolution\n370|}\n371|\n372|// importBaseName renders the default local name of an import path.\n373|func importBaseName(path string) string {\n374|\tif index := strings.LastIndex(path, \"/\"); index >= 0 {\n375|\t\treturn path[index+1:]\n376|\t}\n377|\treturn path\n378|}\n379|\n380|// constructorMembers joins watched member names for diagnostics.\n381|func constructorMembers(members map[string]bool) string {\n382|\tvar names []string\n383|\tfor name := range members {\n384|\t\tnames = append(names, name)\n385|\t}\n386|\tsort.Strings(names)\n387|\treturn strings.Join(names, \", \")\n388|}\n389|\n390|// positionOf renders line:column for diagnostics; never empty.\n391|func positionOf(fileSet *token.FileSet, position token.Pos) string {\n392|\tlocated := fileSet.Position(position)\n393|\tif !located.IsValid() {\n394|\t\treturn \"?:?\"\n395|\t}\n396|\treturn strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column)\n397|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
