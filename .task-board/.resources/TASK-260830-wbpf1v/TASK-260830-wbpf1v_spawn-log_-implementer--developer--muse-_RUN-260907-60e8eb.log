{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c745","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":509,"recorded_at":1780531400001013,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"4ad896f0-225f-4bbf-bd61-a54ea21e7066"},"task_id":"4ad896f0-225f-4bbf-bd61-a54ea21e7066","event":{"kind":"output","task_id":"4ad896f0-225f-4bbf-bd61-a54ea21e7066","chunk":"{\n  \"chunk_id\": \"exec-22-1\",\n  \"command\": \"task-board worktree status 2>&1 | grep -A8 \\\"STORY-260830-3tq4ns\\\"\\necho \\\"===\\\"\\ntask-board worktree checkpoint --help 2>&1 | head -n 80\",\n  \"description\": \"Check our story worktree and checkpoint help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"STORY-260830-3tq4ns  active\\n  path:       .temp/STORY-260830-3tq4ns/worktree (present)\\n  branch:     task-board/story/STORY-260830-3tq4ns (present)\\n  base:       main\\n  tip:        7aa151a9c31071bfab190fd8ae8259f502f2ebbc\\n  tree:       dirty\\n  lease:      held by RUN-260907-60e8eb\\n  blocked:    story lease is held by run RUN-260907-60e8eb\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-wbpf1v rev 3 ready (repository_delta=present, 11 changed path(s))\\nSTORY-260830-4n0fo8  active\\n===\\nCheckpoint an accepted Change Request revision.\\n\\nThe accepted candidate tree becomes one internal commit on the Story branch,\\ncreated under a compare-and-swap on the branch tip. The leaf remains integrating:\\nnothing is landed on trunk, and internal checkpoints only delimit later Task\\ndiffs and make the work recoverable before the final Story squash.\\n\\nA Change Request with repository_delta=empty creates no commit — its tree would\\nequal its parent's — and the leaf likewise remains integrating.\\n\\nOnly the tracked integration run bound to the accepted revision's producer role\\nand archetype may run this command. Reviewers, orchestrators, and other producer\\narchetypes are refused.\\n\\nUsage:\\n  task-board worktree checkpoint <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help   help for checkpoint\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 1929,\n  \"original_output_tokens\": 483,\n  \"truncated\": false\n}"}}}
