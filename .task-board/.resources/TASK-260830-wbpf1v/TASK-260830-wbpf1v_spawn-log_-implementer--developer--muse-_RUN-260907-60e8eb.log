{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b3","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":308,"recorded_at":1780531400000611,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"cd2c1796-463e-4838-9c24-d0259e9cc492"},"task_id":"cd2c1796-463e-4838-9c24-d0259e9cc492","event":{"kind":"output","task_id":"cd2c1796-463e-4838-9c24-d0259e9cc492","chunk":"Read text file `internal/sessrepo/sessrepo_test.go`.\n(1439 line(s) above)\n1440|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n1441|  \"opaque_identity\": {},\n1442|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n1443|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n1444|  \"extensions\": {}\n1445|}`\n1446|\n1447|const specProviderIdentityDigest = \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"\n1448|\n1449|// TestProviderIdentityPlantVerifiesUnderRecordID pins what the plant\n1450|// below is: the SPEC Section 5.5 example verifies with a nil error under\n1451|// the record_id self field, so a load path that recomputes its digest\n1452|// matches it, and only the self-field arm can refuse it.\n1453|func TestProviderIdentityPlantVerifiesUnderRecordID(t *testing.T) {\n1454|\tverified, field, err := canonicaljson.VerifyObjectIdentity([]byte(specProviderIdentityExample))\n1455|\tif err != nil {\n1456|\t\tt.Fatalf(\"VerifyObjectIdentity(provider-identity plant) error = %v\", err)\n1457|\t}\n1458|\tif field != canonicaljson.SelfRecordID {\n1459|\t\tt.Fatalf(\"VerifyObjectIdentity(provider-identity plant) field = %q, want record_id\", string(field))\n1460|\t}\n1461|\tif verified.String() != specProviderIdentityDigest {\n1462|\t\tt.Fatalf(\"VerifyObjectIdentity(provider-identity plant) = %q, want %q\", verified.String(), specProviderIdentityDigest)\n1463|\t}\n1464|}\n1465|\n1466|// TestLoadRefusesProviderIdentityBlobAtEventPath pins the rewritten\n1467|// attestation bound at the load site: entry decodes gate schema before\n1468|// Verify, but the load path re-verifies stored blobs through Verify and\n1469|// refuses a foreign-schema record at the self-field arm. The planted\n1470|// blob verifies cleanly (see the pin above), carries the indexed digest,\n1471|// and replays valid routing members — the field arm is the only clause\n1472|// that can refuse it, so weakening that arm admits the plant.\n1473|func TestLoadRefusesProviderIdentityBlobAtEventPath(t *testing.T) {\n1474|\trepository := openTestRepository(t)\n1475|\treference := createTestSession(t, repository)\n1476|\t_, chainPath, _ := sessionPaths(t, repository)\n1477|\tindex := map[string]any{\n1478|\t\t\"record_id\": reference.RecordID,\n1479|\t\t\"events\": []any{map[string]any{\n1480|\t\t\t\"event_id\": specProviderIdentityDigest, \"event_type\": \"session.created\",\n1481|\t\t\t\"lease_epoch\": 1, \"lease_id\": testLeaseID, \"lease_sequence\": 1,\n1482|\t\t\t\"predecessors\": []any{reference.RecordID},\n1483|\t\t}},\n1484|\t}\n1485|\tout, err := json.Marshal(index)\n1486|\tif err != nil {\n1487|\t\tt.Fatal(err)\n1488|\t}\n1489|\tif err := os.WriteFile(chainPath, out, 0o600); err != nil {\n1490|\t\tt.Fatal(err)\n1491|\t}\n1492|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, specProviderIdentityDigest), []byte(specProviderIdentityExample), 0o600); err != nil {\n1493|\t\tt.Fatal(err)\n1494|\t}\n1495|\t_, err = repository.GetRecord(testSessionID)\n1496|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(provider-identity blob)\")\n1497|\t_, err = repository.ListEvents(testSessionID)\n1498|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(provider-identity blob)\")\n1499|}\n1500|\n1501|// TestLoadRefusesSwappedEventBlobs drives the content-addressed\n1502|// substitution the digest arm exists for: two chained events whose blob\n1503|// files trade places. Both blobs verify individually and both carry the\n1504|// event_id self field, so the digest comparison is the only clause that\n1505|// can refuse. Weakening it admits the substitution with a nil error.\n1506|func TestLoadRefusesSwappedEventBlobs(t *testing.T) {\n1507|\trepository := openTestRepository(t)\n1508|\treference := createTestSession(t, repository)\n1509|\tfirst, firstBytes := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n1510|\tsecond, secondBytes := appendTestEvent(t, repository, testSessionID, []string{first.EventID}, 1, testLeaseID, 2, \"session.idle\", idlePayload())\n1511|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, first.EventID), secondBytes, 0o600); err != nil {\n1512|\t\tt.Fatal(err)\n1513|\t}\n1514|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, second.EventID), firstBytes, 0o600); err != nil {\n1515|\t\tt.Fatal(err)\n1516|\t}\n1517|\t_, err := repository.ListEvents(testSessionID)\n1518|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(swapped blobs)\")\n1519|\t_, err = repository.GetRecord(testSessionID)\n1520|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(swapped blobs)\")\n1521|}\n1522|\n1523|// TestLoadRefusesSubstitutedFirstEventBlob covers the digest arm at\n1524|// chain position 0: a single-event chain whose one blob is replaced by a\n1525|// different individually-valid event linking the same record. Both blobs\n1526|// verify with the event_id self field, so only the digest comparison can\n1527|// refuse; a narrowing that exempts position 0 or sequence 1 admits it.\n1528|func TestLoadRefusesSubstitutedFirstEventBlob(t *testing.T) {\n1529|\trepository := openTestRepository(t)\n1530|\treference := createTestSession(t, repository)\n1531|\tfirst, firstBytes := appendTestEvent(t, repository, testSessionID, []string{reference.RecordID}, 1, testLeaseID, 1, \"session.created\", createdPayload(reference.RecordID))\n1532|\tsubstitute := buildEvent(t, eventOptions{sessionID: testSessionID, predecessors: []string{reference.RecordID}, epoch: 1, leaseID: testLeaseID, sequence: 1, eventType: \"session.idle\", payload: idlePayload()})\n1533|\tif string(substitute) == string(firstBytes) {\n1534|\t\tt.Fatal(\"substitute equals the chained event; the vector admits nothing\")\n1535|\t}\n1536|\tvar subID struct {\n1537|\t\tEventID string `json:\"event_id\"`\n1538|\t}\n1539|\tif err := json.Unmarshal(substitute, &subID); err != nil {\n1540|\t\tt.Fatal(err)\n1541|\t}\n1542|\tif subID.EventID == first.EventID {\n1543|\t\tt.Fatal(\"substitute digest equals the indexed digest; the vector admits nothing\")\n1544|\t}\n1545|\tif err := os.WriteFile(blobPathFor(t, repository, testSessionID, first.EventID), substitute, 0o600); err != nil {\n1546|\t\tt.Fatal(err)\n1547|\t}\n1548|\t_, err := repository.ListEvents(testSessionID)\n1549|\tmustErrorIs(t, err, ErrChainCorrupt, \"ListEvents(substituted first blob)\")\n1550|\t_, err = repository.GetRecord(testSessionID)\n1551|\tmustErrorIs(t, err, ErrChainCorrupt, \"GetRecord(substituted first blob)\")\n1552|}\n1553|\n1554|// TestCreateSessionRefusesResumeWithDifferingBytes proves the resume\n1555|// byte-equality is load-bearing: an interrupted create (record durable,\n1556|// chain absent) retried with a different record for the same session ID\n1557|// is refused as an existing session, the parked record survives\n1558|// byte-identically, and no chain is installed. The retry carries the\n1559|// same byte length as the parked record, so a narrowed equality that\n1560|// compares lengths only would admit it.\n1561|func TestCreateSessionRefusesResumeWithDifferingBytes(t *testing.T) {\n1562|\trepository := openTestRepository(t)\n1563|\tparked := buildRecord(t, nil)\n1564|\tsameLength := buildRecord(t, func(object map[string]any) {\n1565|\t\tobject[\"name\"] = \"payments-apx\"\n1566|\t})\n1567|\tif len(sameLength) != len(parked) {\n1568|\t\tt.Fatalf(\"plant lengths differ (%d vs %d); the narrowing mutant would not be admitted\", len(parked), len(sameLength))\n1569|\t}\n1570|\tdirectory := repository.sessionDir(testSessionID)\n1571|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n1572|\t\tt.Fatal(err)\n1573|\t}\n1574|\tif err := os.WriteFile(filepath.Join(directory, \"record.json\"), parked, 0o600); err != nil {\n1575|\t\tt.Fatal(err)\n1576|\t}\n1577|\t_, err := repository.CreateSession(sameLength)\n1578|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(resume collision, same length)\")\n1579|\tlonger := buildRecord(t, func(object map[string]any) {\n1580|\t\tobject[\"name\"] = \"payments-api-v2\"\n1581|\t})\n1582|\t_, err = repository.CreateSession(longer)\n1583|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(resume collision, longer)\")\n1584|\tstored, err := os.ReadFile(filepath.Join(directory, \"record.json\"))\n1585|\tif err != nil {\n1586|\t\tt.Fatal(err)\n1587|\t}\n1588|\tif string(stored) != string(parked) {\n1589|\t\tt.Fatal(\"parked record changed after refused resume\")\n1590|\t}\n1591|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); !os.IsNotExist(err) {\n1592|\t\tt.Fatalf(\"chain.json state after refused resume = %v, want absent\", err)\n1593|\t}\n1594|}\n1595|\n1596|// TestCreateSessionRefusesResumeOfChainWithoutRecord pins the other\n1597|// resume guard: a chain index with no record beneath it is torn foreign\n1598|// state — no crash ordering in CreateSession produces it — and a retry\n1599|// must refuse it as an existing session rather than installing a record\n1600|// beside it and overwriting the index. The refusal funnels through the\n1601|// existing session-exists site; reads of the same state fail closed as\n1602|// corrupt through the load path.\n1603|func TestCreateSessionRefusesResumeOfChainWithoutRecord(t *testing.T) {\n1604|\trepository := openTestRepository(t)\n1605|\tdirectory := repository.sessionDir(testSessionID)\n1606|\tif err := os.MkdirAll(directory, 0o700); err != nil {\n1607|\t\tt.Fatal(err)\n1608|\t}\n1609|\tforeign, err := json.Marshal(map[string]any{\"record_id\": zeroDigest, \"events\": []any{}})\n1610|\tif err != nil {\n1611|\t\tt.Fatal(err)\n1612|\t}\n1613|\tif err := os.WriteFile(filepath.Join(directory, \"chain.json\"), foreign, 0o600); err != nil {\n1614|\t\tt.Fatal(err)\n1615|\t}\n1616|\t_, err = repository.CreateSession([]byte(specRecordExample))\n1617|\tmustErrorIs(t, err, ErrSessionExists, \"CreateSession(chain without record)\")\n1618|\tif _, err := os.Stat(filepath.Join(directory, \"record.json\")); !os.IsNotExist(err) {\n1619|\t\tt.Fatalf(\"record.json state after refused resume = %v, want absent\", err)\n1620|\t}\n1621|\trestored, err := os.ReadFile(filepath.Join(directory, \"chain.json\"))\n1622|\tif err != nil {\n1623|\t\tt.Fatal(err)\n1624|\t}\n1625|\tif string(restored) != string(foreign) {\n1626|\t\tt.Fatal(\"foreign chain index changed after refused resume\")\n1627|\t}\n1628|}\n1629|\n1630|// TestLoadRefusesMismatchedSessionBinding isolates the session-binding\n1631|// half of the record/chain binding check: a valid record for another\n1632|// session stored under this session's directory, with the index rebound\n1633|// to its digest so the record-digest half stays silent. Only the\n1634|// session-ID comparison can refuse it.\n1635|func TestLoadRefusesMismatchedSessionBinding(t *testing.T) {\n1636|\trepository := openTestRepository(t)\n1637|\tcreateTestSession(t, repository)\n1638|\tother := buildRecord(t, func(object map[string]any) {\n1639|\t\tobject[\"session_id\"] = testSessionIDB\n(more lines below)"}}}
