ed green'; fi\n360|  else\n361|    record A1 audit-only SURVIVED 'behavioral test reddened (not audit-only)'\n362|  fi\n363|  restore\n364|\n365|  # A2 var-bound funnel in production: behavior identical, alias audit red.\n366|  # The ReadDir+refuse anchor occurs once: ListSessions delegates to\n367|  # listSessionsLocked, which owns the single root scan (Resolve shares it\n368|  # without re-locking or re-reading).\n369|  mutate internal/sessrepo/store.go '\\tentries, err := os.ReadDir(repository.root)\\n\\tif err != nil {\\n\\t\\treturn nil, refuse(ErrRepositoryPath, \"read sessions root: %v\", err)\\n\\t}' '\\tdeny := refuse\\n\\tentries, err := os.ReadDir(repository.root)\\n\\tif err != nil {\\n\\t\\treturn nil, deny(ErrRepositoryPath, \"read sessions root: %v\", err)\\n\\t}' 1\n370|  if run_pass 'TestListAndResolveRefuseMissingRoot'; then\n371|    if run_gate_fail; then record A2 audit-only KILLED 'behavioral green; full run fails on alias audit'; else record A2 audit-only SURVIVED 'full run stayed green'; fi\n372|  else\n373|    record A2 audit-only SURVIVED 'behavioral test reddened (not audit-only)'\n374|  fi\n375|  restore\n376|\n377|  # C3 new-file bytes.Equal (reviewer P2 shape): a third bytes.Equal in a\n378|  # NEW production file of the same package. Behavioral green; the derived\n379|  # class census fails on the unregistered site. The file is removed before\n380|  # restore so the tree cannot leak into later rows.\n381|  printf 'package sessrepo\\n\\nimport \"bytes\"\\n\\nfunc equalityPlantExtra(left, right []byte) bool {\\n\\treturn bytes.Equal(left, right)\\n}\\n' > internal/sessrepo/plantextra.go\n382|  if run_pass 'TestAppendEventRefusesSameLengthDisagreeingBytes'; then\n383|    if run_gate_fail; then record C3 census-only KILLED 'behavioral green; full run fails on unregistered plantextra.go site'; else record C3 census-only SURVIVED 'full run stayed green'; fi\n384|  else\n385|    record C3 census-only SURVIVED 'behavioral test reddened (not census-only)'\n386|  fi\n387|  rm -f internal/sessrepo/plantextra.go\n388|  restore\n389|\n390|  # C4 token-less spelling (reviewer P3 shape): string(left) ==\n391|  # string(right) in store.go carries no bytes.Equal token. Behavioral\n392|  # green; the derived class census fails on the unregistered site.\n393|  mutate internal/sessrepo/store.go 'func asciiFold(value string) string {' 'func equalityPlantStore(left, right []byte) bool {\\n\\treturn string(left) == string(right)\\n}\\n\\nfunc asciiFold(value string) string {' 1\n394|  if run_pass 'TestCreateSessionRefusesResumeWithDifferingBytes'; then\n395|    if run_gate_fail; then record C4 census-only KILLED 'behavioral green; full run fails on unregistered string-== site'; else record C4 census-only SURVIVED 'full run stayed green'; fi\n396|  else\n397|    record C4 census-only SURVIVED 'behavioral test reddened (not census-only)'\n398|  fi\n399|  restore\n400|\n401|  # A3 var-bound bytes.Equal in production: behavior identical, the class\n402|  # alias audit fails (and the ledger row orphans). Behavioral green; the\n403|  # full run fails on the alias audit.\n404|  mutate internal/sessrepo/chain.go '\tif readErr != nil || !bytes.Equal(existing, data) {' '\teq := bytes.Equal\\n\tif readErr != nil || !eq(existing, data) {' 1\n405|  if run_pass 'TestAppendEventRefusesSameLengthDisagreeingBytes'; then\n406|    if run_gate_fail; then record A3 audit-only KILLED 'behavioral green; full run fails on equality alias audit'; else record A3 audit-only SURVIVED 'full run stayed green'; fi\n407|  else\n408|    record A3 audit-only SURVIVED 'behavioral test reddened (not audit-only)'\n409|  fi\n410|  restore\n411|}\n412|\n413|controls() {\n414|  echo \"== harness controls ==\"\n415|  # X1 NOT_APPLIED: pattern is absent; the tree must be provably untouched.\n416|  n=$(python3 - internal/sessrepo/chain.go '__absent_pattern_xyz__' <<'EOF'\n417|import sys\n418|src = open(sys.argv[1]).read()\n419|print(src.count(sys.argv[2]))\n420|EOF\n421|)\n422|  if [ \"$n\" = \"0\" ] && sha256sum -c \"$SNAP/pre.sha\" > /dev/null 2>&1; then\n423|    echo \"X1 [NOT_APPLIED] — absent pattern: not applied, tree checksums unchanged\"\n424|  else\n425|    echo \"X1 control broken\"\n426|    FAIL_COUNT=$((FAIL_COUNT + 1))\n427|  fi\n428|  # X2 COMPILE_FAIL: broken tree fails distinctly from killed/survived.\n429|  printf '\\n}\\n' >> internal/sessrepo/chain.go\n430|  if go build \"$PKG\" > /dev/null 2>&1; then\n431|    echo \"X2 [COMPILE_FAIL] UNEXPECTEDLY BUILT\"\n432|    FAIL_COUNT=$((FAIL_COUNT + 1))\n433|  else\n434|    echo \"X2 [COMPILE_FAIL] — broken tree fails the build distinctly\"\n435|  fi\n436|  restore\n437|}\n438|\n439|snapshot\n440|baseline\n441|\n442|GROUP=\"${1:-all}\"\n443|case \"$GROUP\" in\n444|  narrowing-write) narrowing_write ;;\n445|  narrowing-load) narrowing_load ;;\n446|  deletion) deletion ;;\n447|  gateonly) gateonly ;;\n448|  controls) controls ;;\n449|  all) narrowing_write; narrowing_load; deletion; gateonly; controls ;;\n450|  *) echo \"unknown group $GROUP\" >&2; exit 2 ;;\n451|esac\n452|\n453|echo \"\"\n454|echo \"== results ==\"\n455|echo \"$RESULTS\" | grep -v '^$'\n456|echo \"\"\n457|echo \"applied verdicts: KILLED=$PASS_COUNT SURVIVED=$FAIL_COUNT (controls excluded)\"\n458|restore\n459|if [ \"$FAIL_COUNT\" -ne 0 ]; then\n460|  exit 1\n461|fi\n462|","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
