{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cae1","stream":{"kind":"session","id":"01a07d34-fcf0-7332-85e2-0e8a0d37c76e"},"sequence":971,"recorded_at":1780531400001937,"record_type":"event","durability":"durable","causation_id":"7741b655-4956-456e-8ab0-1e5b6c597882","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7741b655-4956-456e-8ab0-1e5b6c597882","run_stream":{"kind":"run","id":"7741b655-4956-456e-8ab0-1e5b6c597882"},"task_stream":{"kind":"task","id":"3741abf2-f5fd-48b9-b1cf-34200591062c"},"task_id":"3741abf2-f5fd-48b9-b1cf-34200591062c","event":{"kind":"output","task_id":"3741abf2-f5fd-48b9-b1cf-34200591062c","chunk":"{\n  \"chunk_id\": \"exec-41-1\",\n  \"command\": \"ls -la .temp/TASK-260830-wbpf1v/ 2>&1\\necho \\\"===\\\"\\nhead -n 100 .temp/TASK-260830-wbpf1v/mutation_battery.sh 2>&1\",\n  \"description\": \"Inspect existing mutation battery harness\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"total 120\\ndrwxr-xr-x@  6 iv  staff    192 Sep  7 18:24 .\\ndrwxr-xr-x@  4 iv  staff    128 Sep  7 17:52 ..\\n-rwxr-xr-x@  1 iv  staff  26313 Sep  7 18:25 mutation_battery_rev4.sh\\n-rwxr-xr-x@  1 iv  staff  23884 Sep  7 17:37 mutation_battery.sh\\n-rw-r--r--@  1 iv  staff   5859 Sep  7 16:44 mutation-battery.log\\ndrwxr-xr-x@ 18 iv  staff    576 Sep  7 17:21 review\\n===\\n#!/bin/bash\\n# Mutation battery v2 for TASK-260830-wbpf1v (internal/sessrepo + provhost gate).\\n#\\n# Denominator: production-derived. The refusal census derives 36 refuse()\\n# sites from production AST (sessrepo.go 5, chain.go 25, store.go 6); the\\n# mechanism targets below name the non-refuse gates the census cannot see\\n# (O_EXCL install flag, resume byte-equality, binding-equality halves,\\n# load re-verification arms). Every mutant is applied with an exact-count\\n# string replacement that aborts unless the pattern occurs exactly as\\n# stated, and the tree is restored by checksum after each mutant.\\n#\\n# Classes (reported separately, never folded):\\n#   narrowing    — gate stays present, weakened to admit exactly one member\\n#                  of the class it must reject; a named test must fail.\\n#   arm-deletion — the refusal effect is removed; a named test must fail.\\n#   census-only  — behavioral suite stays green; the full-package census\\n#                  gate fails (unrouted funnel / unregistered site).\\n#   audit-only   — behavioral suite stays green; the full-package alias /\\n#                  derivation audit fails.\\n#   NOT_APPLIED  — harness control: pattern absent, tree provably untouched.\\n#   COMPILE_FAIL — harness control: broken tree fails distinctly.\\n#\\n# Usage: mutation_battery.sh [group]\\n#   groups: narrowing-write | narrowing-load | deletion | gateonly | controls | all\\n#   default: all\\nset -u\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"$0\\\")\\\" && pwd)\\\"\\nW=\\\"$(cd \\\"$SCRIPT_DIR/../..\\\" && pwd)\\\"\\ncd \\\"$W\\\" || exit 1\\n\\nPKG=./internal/sessrepo\\nSNAP=\\\"$(mktemp -d)\\\"\\ntrap 'rm -rf \\\"$SNAP\\\"' EXIT\\n\\nPASS_COUNT=0\\nFAIL_COUNT=0\\nRESULTS=\\\"\\\"\\n\\nsnapshot() {\\n  mkdir -p \\\"$SNAP/sessrepo\\\" \\\"$SNAP/provhost\\\"\\n  cp internal/sessrepo/chain.go internal/sessrepo/sessrepo.go internal/sessrepo/store.go \\\"$SNAP/sessrepo/\\\"\\n  sha256sum internal/sessrepo/chain.go internal/sessrepo/sessrepo.go internal/sessrepo/store.go > \\\"$SNAP/pre.sha\\\"\\n}\\n\\nrestore() {\\n  cp \\\"$SNAP/sessrepo/chain.go\\\" \\\"$SNAP/sessrepo/store.go\\\" \\\"$SNAP/sessrepo/sessrepo.go\\\" internal/sessrepo/\\n  if ! sha256sum -c \\\"$SNAP/pre.sha\\\" > /dev/null 2>&1; then\\n    echo \\\"FATAL: restore checksum mismatch; tree left dirty\\\" >&2\\n    exit 1\\n  fi\\n}\\n\\n# mutate <file> <old> <new> <count> — exact-count replacement or the whole\\n# battery aborts: a mutant that did not apply exactly as stated proves\\n# nothing and must never be recorded as a kill or a survivor.\\nmutate() {\\n  python3 - \\\"$1\\\" \\\"$2\\\" \\\"$3\\\" \\\"$4\\\" <<'EOF'\\nimport sys\\npath, old, new, want = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])\\n# Patterns in this script spell tabs and newlines as \\\\t and \\\\n inside\\n# single-quoted shell strings; decode them to the real characters before\\n# matching. No production span below contains a literal backslash, so the\\n# decode cannot collide with source text (verified by the exact counts).\\nold = old.encode(\\\"utf-8\\\").decode(\\\"unicode_escape\\\")\\nnew = new.encode(\\\"utf-8\\\").decode(\\\"unicode_escape\\\")\\nsrc = open(path).read()\\nn = src.count(old)\\nif n != want:\\n    print(f\\\"MUTATE ABORT: pattern occurs {n}x, want {want}x: {old[:100]!r}\\\")\\n    sys.exit(3)\\nopen(path, \\\"w\\\").write(src.replace(old, new))\\nEOF\\n  rc=$?\\n  if [ $rc -ne 0 ]; then\\n    echo \\\"FATAL: mutant did not apply; restoring and aborting\\\" >&2\\n    restore\\n    exit $rc\\n  fi\\n}\\n\\nrecord() {\\n  # record <id> <class> <verdict> <detail>\\n  RESULTS=\\\"$RESULTS\\n$1 [$2] $3 — $4\\\"\\n  if [ \\\"$3\\\" = \\\"KILLED\\\" ]; then\\n    PASS_COUNT=$((PASS_COUNT + 1))\\n  else\\n    FAIL_COUNT=$((FAIL_COUNT + 1))\\n  fi\\n  echo \\\"$1 [$2] $3 — $4\\\"\\n}\\n\\n# run_fail <test-regex> — expects the named behavioral test to FAIL.\\nrun_fail() {\\n  out=$(go test \\\"$PKG\\\" -count=1 -run \\\"$1\\\" 2>&1)\\n  code=$?\\n  if [ $code -eq 0 ]; then\\n    echo \\\"$out\\\" | tail -3\\n    return 1\\n\",\n  \"original_output_bytes\": 4065,\n  \"original_output_tokens\": 1017,\n  \"truncated\": false\n}"}}}
