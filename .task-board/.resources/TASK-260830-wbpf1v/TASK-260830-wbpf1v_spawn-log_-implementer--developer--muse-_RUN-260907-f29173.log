, err := digestPathComponents(digest)\n43|\tif err != nil {\n44|\t\treturn \"\", err\n45|\t}\n46|\tseparator := \"\"\n47|\tswitch style {\n48|\tcase PathStylePOSIX:\n49|\t\tseparator = \"/\"\n50|\tcase PathStyleWindows:\n51|\t\tseparator = `\\`\n52|\tdefault:\n53|\t\treturn \"\", fmt.Errorf(\"%w: %q\", ErrInvalidPathStyle, style)\n54|\t}\n55|\treturn strings.Join(components[:], separator), nil\n56|}\n57|\n58|// digestPathComponents is the single owner of the digest_path_v1 split. Every\n59|// durable namespace in this package joins these exact components beneath its\n60|// own root instead of re-deriving the shard and leaf independently.\n61|func digestPathComponents(digest scalar.Digest) ([3]string, error) {\n62|\thexDigest := digest.Hex()\n63|\tif len(hexDigest) != sha256.Size*2 {\n64|\t\treturn [3]string{}, fmt.Errorf(\"%w: malformed digest\", ErrInvalidPath)\n65|\t}\n66|\treturn [3]string{\"sha256\", hexDigest[:2], hexDigest[2:]}, nil\n67|}\n68|\n69|func nativeDigestPath(root string, digest scalar.Digest) (string, error) {\n70|\tcomponents, err := digestPathComponents(digest)\n71|\tif err != nil {\n72|\t\treturn \"\", err\n73|\t}\n74|\treturn filepath.Join(root, components[0], components[1], components[2]), nil\n75|}\n76|\n77|type PutResult struct {\n78|\tDigest                 scalar.Digest\n79|\tSize                   uint64\n80|\tPath                   string\n81|\tInstalled              bool\n82|\tQuarantinePath         string\n83|\tExistingQuarantinePath string\n84|}\n85|\n86|type storeOperations struct {\n87|\tsyncFile      func(*os.File) error\n88|\tinstall       func(string, string) error\n89|\tsyncDirectory func(string) error\n90|\t// openExisting reads the entry already occupying a digest path. It is a\n91|\t// seam because the classification that depends on it — a read that did not\n92|\t// complete is a durability failure, never a proven mismatch — is otherwise\n93|\t// reachable only through descriptor exhaustion or real media failure.\n94|\topenExisting blobOpener\n95|}\n96|\n97|func defaultStoreOperations() storeOperations {\n98|\treturn storeOperations{\n99|\t\tsyncFile: func(file *os.File) error { return file.Sync() },\n100|\t\tinstall:  atomicRenameNoReplace,\n101|\t\tsyncDirectory: func(directory string) error {\n102|\t\t\treturn syncDirectory(directory)\n103|\t\t},\n104|\t\topenExisting: openBlobFile,\n105|\t}\n106|}\n107|\n108|type ObjectStore struct {\n109|\tdataRoot   string\n110|\tobjects    string\n111|\tquarantine string\n112|\toperations storeOperations\n113|\tmu         sync.Mutex\n114|}\n115|\n116|// OpenObjectStore creates or verifies the owner-only local roots and opens the\n117|// live blob namespace. It does not expose this root to a plugin or peer.\n118|func OpenObjectStore(paths ResolvedPaths) (*ObjectStore, error) {\n119|\tif err := InitializeLayout(paths); err != nil {\n120|\t\treturn nil, err\n(more lines below)"}}}
