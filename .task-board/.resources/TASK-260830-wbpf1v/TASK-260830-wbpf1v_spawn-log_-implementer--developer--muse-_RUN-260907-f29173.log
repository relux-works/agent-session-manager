{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000db71","stream":{"kind":"session","id":"01a07b9e-4019-7d82-8599-f430d1ae00b2"},"sequence":3091,"recorded_at":1780531400006177,"record_type":"event","durability":"durable","causation_id":"868a1309-d750-4b15-8a10-0ca2d4130887","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"868a1309-d750-4b15-8a10-0ca2d4130887","run_stream":{"kind":"run","id":"868a1309-d750-4b15-8a10-0ca2d4130887"},"task_stream":{"kind":"task","id":"3bf05472-a503-43af-ba8a-f13280082475"},"task_id":"3bf05472-a503-43af-ba8a-f13280082475","event":{"kind":"output","task_id":"3bf05472-a503-43af-ba8a-f13280082475","chunk":"{\n  \"chunk_id\": \"exec-108-1\",\n  \"command\": \"sed -n '40,70p;115,135p;215,230p;250,300p' .github/workflows/ci.yml\",\n  \"description\": \"Read CI gate details\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      # `//go:generate` as `// go:generate` preserves the token while turning\\n      # the directive into a plain comment, so generation is skipped and the\\n      # diff stays clean. The anchored check refuses that token-preserving\\n      # rewrite; only the exact directive form counts. A new directive\\n      # without a pin update reddens here (and in\\n      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\\n      - name: Verify generated catalog is current\\n        run: |\\n          test \\\"$(grep -c '^//go:generate' internal/catalog/catalog.go)\\\" -eq 1\\n          go generate ./internal/catalog\\n          git diff --exit-code -- internal/catalog/catalog_gen.go\\n\\n      # The release roots are derived from internal/specpin and\\n      # internal/catalog inside the gate, never retyped here. Each -- PASS\\n      # guard below must match: a selector that runs nothing fails here\\n      # instead of passing silently.\\n      - name: Run pinned contract-version gates\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-contracts.log\\n          test $code -eq 0\\n          for gate in TestVerifyContractPreservationLive TestPinnedReleasesAgreeAcrossAuthorities TestDerivedSetsAreComplete TestCheckAgreementAdmitsIdenticalSets TestCheckAgreementRefusals TestCheckReleaseRootsRefusesDrift; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-contracts.log\\n          done\\n\\n  lint:\\n    name: Linters (vet, Windows vet, gofmt)\\n    runs-on: ubuntu-latest\\n      - name: Build\\n        run: go build ./...\\n\\n      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\\n      # datum. At least one package must report ok: a suite that matched\\n      # nothing is a failure, not a pass.\\n      - name: Test\\n        run: |\\n          set +e\\n          go test ./... -v -count=1 > test.log 2>&1\\n          code=$?\\n          set -e\\n          cat test.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\\n      # secconftest capabilities line witnesses the probe counters after the\\n      # whole suite. Skips are loud here by construction.\\n      - name: Run fixture package\\n        run: |\\n          set +e\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n          code=$?\\n          set -e\\n          grep '^--- SKIP' fixture.log || echo \\\"no skipped tests\\\"\\n          grep 'secconftest capabilities on' fixture.log || true\\n          {\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n      # pipeline whose exit status the shell discards, so it refuses\\n      # nothing, and the non-empty-file check refuses only the\\n      # every-package-empty case — a single silently empty package dies\\n      # only at the pinned total. A new fuzz target without a CI update\\n      # reddens here instead of going unsmoked.\\n      - name: Derive fuzz targets\\n        run: |\\n          rm -f fuzz-targets.clean\\n          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\\n            go test \\\"./${pkg}\\\" -list '^Fuzz' > \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" 2>&1\\n            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n          done\\n          test -s fuzz-targets.clean\\n          test \\\"$(wc -l < fuzz-targets.clean | tr -d ' ')\\\" -eq 13\\n          cat fuzz-targets.clean\\n\\n      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n      # derivation, which maps each target to the production entry it\\n      # drives. Either side drifting — a target without an entry, or an\\n      # entry without a target — fails the diff before any smoke runs.\\n      - name: Check secconftest list matches the target derivation\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      # It does not prove the mutation phase: at -fuzztime=100x the\\n      # large-corpus targets (secconftest/FuzzRedactCorpus, all four\\n      # canonicaljson targets) spend the budget on baseline coverage and\\n      # never print 'now fuzzing'. Lengthening the budget or shrinking a\\n      # corpus changes that without reddening here.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n\",\n  \"original_output_bytes\": 5882,\n  \"original_output_tokens\": 1471,\n  \"truncated\": false\n}"}}}
