{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1bf","stream":{"kind":"session","id":"01a07b9e-4019-7d82-8599-f430d1ae00b2"},"sequence":1850,"recorded_at":1780531400003695,"record_type":"event","durability":"durable","causation_id":"868a1309-d750-4b15-8a10-0ca2d4130887","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"868a1309-d750-4b15-8a10-0ca2d4130887","run_stream":{"kind":"run","id":"868a1309-d750-4b15-8a10-0ca2d4130887"},"call_id":"call_01a07baa805b7590babc978dadffbb36","text":"edited\nchanged lines: lines 397-398\n--- original\n+++ updated\n@@\n-// writeExclusive installs bytes at a path that must not exist. The\n-// no-replace open makes append-only a filesystem property, not a convention.\n+// errDigestDisagreement reports bytes at a digest path that a completed\n+// read proved different from the installing candidate. It is an internal\n+// marker, never a refusal: callers attribute it through their own site.\n+var errDigestDisagreement = errors.New(\"digest path holds disagreeing bytes\")\n+\n+// installEventBlob installs one event blob idempotently: identical bytes\n+// already present are reused, disagreeing bytes are reported for refusal,\n+// and the no-replace open keeps the install atomic.\n+func installEventBlob(path string, data []byte) error {\n+\tif _, err := os.Stat(path); err == nil {\n+\t\texisting, readErr := os.ReadFile(path)\n+\t\tif readErr != nil || !bytes.Equal(existing, data) {\n+\t\t\treturn errDigestDisagreement\n+\t\t}\n+\t\treturn nil\n+\t}\n+\tif err := writeExclusive(path, data); err != nil {\n+\t\treturn fmt.Errorf(\"install event blob: %w\", err)\n+\t}\n+\treturn nil\n+}\n+\n+// writeExclusive installs bytes at a path that must not exist. The\n+// no-replace open makes append-only a filesystem property, not a convention.\n","edit_facts":{"tool_name":"edit_file","path":"internal/sessrepo/chain.go","added":24,"removed":2},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
