ry.BeforeWrite(); err != nil {\n129|\t\t\treturn SessionRef{}, err\n130|\t\t}\n131|\t}\n132|\tdirectory := repository.sessionDir(record.sessionID)\n133|\tif err := os.MkdirAll(directory, 0o700); err != nil {\n134|\t\treturn SessionRef{}, refuse(ErrRepositoryPath, \"create session directory: %v\", err)\n135|\t}\n136|\tif err := writeExclusive(filepath.Join(directory, \"record.json\"), recordJSON); err != nil {\n137|\t\treturn SessionRef{}, refuse(ErrSessionExists, \"session %s already exists\", record.sessionID)\n138|\t}\n139|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n140|\t\treturn SessionRef{}, refuse(ErrRepositoryPath, \"create session events directory: %v\", err)\n141|\t}\n142|\tchain := storedChain{RecordID: record.recordID, Events: nil}\n143|\tif err := repository.writeChain(directory, chain); err != nil {\n144|\t\treturn SessionRef{}, err\n145|\t}\n146|\tif repository.AfterCommit != nil {\n147|\t\tif err := repository.AfterCommit(); err != nil {\n148|\t\t\treturn SessionRef{}, err\n149|\t\t}\n150|\t}\n151|\treturn SessionRef{SessionID: record.sessionID, RecordID: record.recordID}, nil\n152|}\n(more lines below)"}}}
