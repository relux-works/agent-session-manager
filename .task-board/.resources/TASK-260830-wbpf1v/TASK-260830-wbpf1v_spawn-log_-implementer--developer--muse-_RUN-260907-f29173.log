te\n218|\tvar unrouted []string\n219|\tfor _, entry := range entries {\n220|\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".go\") || strings.HasSuffix(entry.Name(), \"_test.go\") {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tmatches, err := context.MatchFile(directory, entry.Name())\n224|\t\tif err != nil {\n225|\t\t\treturn nil, nil, err\n226|\t\t}\n227|\t\tif !matches {\n228|\t\t\tcontinue\n229|\t\t}\n230|\t\tpath := filepath.Join(directory, entry.Name())\n231|\t\tsource, err := os.ReadFile(path)\n232|\t\tif err != nil {\n233|\t\t\treturn nil, nil, err\n234|\t\t}\n235|\t\tlines := strings.Split(string(source), \"\\n\")\n236|\t\tparsed, err := parser.ParseFile(fileSet, path, source, 0)\n237|\t\tif err != nil {\n238|\t\t\treturn nil, nil, err\n239|\t\t}\n240|\t\tsite := func(position token.Position) string {\n241|\t\t\treturn fmt.Sprintf(\"%s:%d\", entry.Name(), position.Line)\n242|\t\t}\n243|\t\tast.Inspect(parsed, func(node ast.Node) bool {\n244|\t\t\tswitch typed := node.(type) {\n245|\t\t\tcase *ast.CallExpr:\n246|\t\t\t\tif identifier, ok := typed.Fun.(*ast.Ident); ok {\n247|\t\t\t\t\tif _, funnel := projectionRefusalFunnels[identifier.Name]; funnel {\n248|\t\t\t\t\t\tposition := fileSet.Position(typed.Pos())\n249|\t\t\t\t\t\tline := lines[position.Line-1]\n250|\t\t\t\t\t\tif strings.Contains(line, projectionRefusalSubsumedMarker) {\n251|\t\t\t\t\t\t\treturn true\n252|\t\t\t\t\t\t}\n253|\t\t\t\t\t\texpected = append(expected, projectionRefusalSite{\n254|\t\t\t\t\t\t\tsite:        site(position),\n255|\t\t\t\t\t\t\tallowDirect: strings.Contains(line, projectionRefusalDirectMarker),\n256|\t\t\t\t\t\t})\n257|\t\t\t\t\t\treturn true\n258|\t\t\t\t\t}\n259|\t\t\t\t}\n260|\t\t\t\t// fmt.Errorf is a selector, not an identifier, so the unrouted\n261|\t\t\t\t// check must not sit behind the funnel-identifier match above.\n262|\t\t\t\tif !projectionOwnedSource(entry.Name()) {\n263|\t\t\t\t\treturn true\n264|\t\t\t\t}\n265|\t\t\t\tif isProjectionRefusalFunnelDefinition(parsed, typed) {\n266|\t\t\t\t\treturn true\n267|\t\t\t\t}\n268|\t\t\t\tif wrapsUnroutedRefusalSentinel(typed) {\n269|\t\t\t\t\tunrouted = append(unrouted, site(fileSet.Position(typed.Pos())))\n270|\t\t\t\t}\n271|\t\t\tcase *ast.IfStmt:\n272|\t\t\t\tif !projectionOwnedSource(entry.Name()) {\n273|\t\t\t\t\treturn true\n274|\t\t\t\t}\n275|\t\t\t\tif !guardsOwnershipVerifier(typed) || bodyRaisesThroughFunnel(typed.Body) {\n276|\t\t\t\t\treturn true\n277|\t\t\t\t}\n278|\t\t\t\tunrouted = append(unrouted, site(fileSet.Position(typed.Pos())))\n279|\t\t\t}\n280|\t\t\treturn true\n281|\t\t})\n282|\t}\n283|\treturn expected, unrouted, nil\n284|}\n285|\n286|// isProjectionRefusalFunnelDefinition excludes the funnels' own bodies, which\n287|// legitimately wrap a refusal sentinel because they are what every routed call\n288|// site delegates to.\n289|func isProjectionRefusalFunnelDefinition(file *ast.File, call *ast.CallExpr) bool {\n290|\tinside := false\n291|\tast.Inspect(file, func(node ast.Node) bool {\n292|\t\tvalue, ok := node.(*ast.ValueSpec)\n293|\t\tif !ok {\n294|\t\t\treturn true\n295|\t\t}\n296|\t\tfor index, name := range value.Names {\n297|\t\t\tif _, funnel := projectionRefusalFunnels[name.Name]; !funnel {\n298|\t\t\t\tcontinue\n299|\t\t\t}\n300|\t\t\tif index >= len(value.Values) {\n301|\t\t\t\tcontinue\n302|\t\t\t}\n303|\t\t\tif call.Pos() >= value.Values[index].Pos() && call.End() <= value.Values[index].End() {\n304|\t\t\t\tinside = true\n305|\t\t\t}\n306|\t\t}\n307|\t\treturn true\n308|\t})\n309|\treturn inside\n310|}\n311|\n312|func wrapsUnroutedRefusalSentinel(call *ast.CallExpr) bool {\n313|\tselector, ok := call.Fun.(*ast.SelectorExpr)\n314|\tif !ok || selector.Sel.Name != \"Errorf\" {\n315|\t\treturn false\n316|\t}\n317|\tpackageName, ok := selector.X.(*ast.Ident)\n318|\tif !ok || packageName.Name != \"fmt\" {\n319|\t\treturn false\n320|\t}\n321|\tfor _, argument := range call.Args {\n322|\t\tidentifier, ok := argument.(*ast.Ident)\n323|\t\tif !ok {\n324|\t\t\tcontinue\n325|\t\t}\n326|\t\tif _, refusal := projectionUnroutedRefusalSentinels[identifier.Name]; refusal {\n327|\t\t\treturn true\n328|\t\t}\n329|\t}\n330|\treturn false\n331|}\n332|\n333|func guardsOwnershipVerifier(statement *ast.IfStmt) bool {\n334|\tfound := false\n335|\tif statement.Init != nil {\n336|\t\tast.Inspect(statement.Init, func(node ast.Node) bool {\n337|\t\t\tcall, ok := node.(*ast.CallExpr)\n338|\t\t\tif !ok {\n339|\t\t\t\treturn true\n340|\t\t\t}\n341|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n342|\t\t\tif !ok {\n343|\t\t\t\treturn true\n344|\t\t\t}\n345|\t\t\tif _, verifier := projectionOwnershipVerifiers[identifier.Name]; verifier {\n346|\t\t\t\tfound = true\n347|\t\t\t}\n348|\t\t\treturn true\n349|\t\t})\n350|\t}\n351|\treturn found\n352|}\n353|\n354|func bodyRaisesThroughFunnel(body *ast.BlockStmt) bool {\n355|\traises := false\n356|\tast.Inspect(body, func(node ast.Node) bool {\n357|\t\tcall, ok := node.(*ast.CallExpr)\n358|\t\tif !ok {\n359|\t\t\treturn true\n360|\t\t}\n361|\t\tidentifier, ok := call.Fun.(*ast.Ident)\n362|\t\tif !ok {\n363|\t\t\treturn true\n364|\t\t}\n365|\t\tif _, funnel := projectionRefusalFunnels[identifier.Name]; funnel {\n366|\t\t\traises = true\n367|\t\t}\n368|\t\treturn true\n369|\t})\n370|\treturn raises\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
