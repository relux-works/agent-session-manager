{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d967","stream":{"kind":"session","id":"01a07b9e-4019-7d82-8599-f430d1ae00b2"},"sequence":2830,"recorded_at":1780531400005655,"record_type":"event","durability":"durable","causation_id":"868a1309-d750-4b15-8a10-0ca2d4130887","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"868a1309-d750-4b15-8a10-0ca2d4130887","run_stream":{"kind":"run","id":"868a1309-d750-4b15-8a10-0ca2d4130887"},"task_stream":{"kind":"task","id":"dd6c5129-ed89-497b-9de8-6e386b4eca7a"},"task_id":"dd6c5129-ed89-497b-9de8-6e386b4eca7a","event":{"kind":"output","task_id":"dd6c5129-ed89-497b-9de8-6e386b4eca7a","chunk":"Read text file `internal/provhost/identity_test.go`.\n(78 line(s) above)\n79|// fails instead of lingering, and still reddens for any other tree. The\n80|// scan is AST-based (comments and test files never count) and fails\n81|// closed when it sees nothing.\n82|// Stated bound on this test: only *ast.CallExpr nodes are inspected, so a\n83|// `f := pkg.VerifyObjectIdentity; f(x)` binding would not be seen; no such\n84|// shape exists today.\n85|func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\n86|\t_, self, _, ok := runtime.Caller(0)\n87|\tif !ok {\n88|\t\tt.Fatal(\"runtime.Caller cannot locate the test file\")\n89|\t}\n90|\troot := filepath.Dir(self)\n91|\tfor {\n92|\t\tif _, err := os.Stat(filepath.Join(root, \"go.mod\")); err == nil {\n93|\t\t\tbreak\n94|\t\t}\n95|\t\tparent := filepath.Dir(root)\n96|\t\tif parent == root {\n97|\t\t\tt.Fatal(\"no module root above the test file; the scan is blind\")\n98|\t\t}\n99|\t\troot = parent\n100|\t}\n101|\tvar scanned, parsed int\n102|\tvar callers []string\n103|\tfor _, tree := range []string{\"internal\", \"cmd\"} {\n104|\t\tbase := filepath.Join(root, tree)\n105|\t\tif _, err := os.Stat(base); err != nil {\n106|\t\t\tcontinue\n107|\t\t}\n108|\t\t// Recursion stays local: the core selects single-package\n109|\t\t// production files, while this attestation spans trees.\n110|\t\t// Fail-closed parsing is the core's.\n111|\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\n112|\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n113|\t\t\t\treturn err\n114|\t\t\t}\n115|\t\t\tscanned++\n116|\t\t\tsource, err := os.ReadFile(path)\n117|\t\t\tif err != nil {\n118|\t\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n119|\t\t\t}\n120|\t\t\tif !strings.Contains(string(source), \"VerifyObjectIdentity\") {\n121|\t\t\t\treturn nil\n122|\t\t\t}\n123|\t\t\tparsed++\n124|\t\t\tsyntax, fileSet, failure := invcore.ParseBytes(path, source, 0)\n125|\t\t\tif failure != \"\" {\n126|\t\t\t\tt.Fatalf(\"parse %s: %s\", path, failure)\n127|\t\t\t}\n128|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n129|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n130|\t\t\t\tif !ok {\n131|\t\t\t\t\treturn true\n132|\t\t\t\t}\n133|\t\t\t\tswitch fun := call.Fun.(type) {\n134|\t\t\t\tcase *ast.SelectorExpr:\n135|\t\t\t\t\tif fun.Sel.Name == \"VerifyObjectIdentity\" {\n136|\t\t\t\t\t\tposition := fileSet.Position(call.Pos())\n137|\t\t\t\t\t\tcallers = append(callers, fmt.Sprintf(\"%s:%d\", position.Filename, position.Line))\n138|\t\t\t\t\t}\n139|\t\t\t\tcase *ast.Ident:\n140|\t\t\t\t\tif fun.Name == \"VerifyObjectIdentity\" {\n141|\t\t\t\t\t\t// The canonicaljson definition itself is a\n142|\t\t\t\t\t\t// FuncDecl, never a call; a bare-identifier call\n143|\t\t\t\t\t\t// anywhere is a production call site.\n144|\t\t\t\t\t\tposition := fileSet.Position(call.Pos())\n145|\t\t\t\t\t\tcallers = append(callers, fmt.Sprintf(\"%s:%d\", position.Filename, position.Line))\n146|\t\t\t\t\t}\n147|\t\t\t\t}\n148|\t\t\t\treturn true\n149|\t\t\t})\n150|\t\t\treturn nil\n151|\t\t}); err != nil {\n152|\t\t\tt.Fatalf(\"walk %s: %v\", base, err)\n153|\t\t}\n154|\t}\n155|\tif scanned == 0 {\n156|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n157|\t}\n158|\tif len(callers) != 0 {\n159|\t\tt.Fatalf(\"production call sites attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\n160|\t}\n161|\tt.Logf(\"attestation scan: %d production files, %d parsed, 0 production call sites\", scanned, parsed)\n162|}\n163|\n(more lines below)"}}}
