{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e5","stream":{"kind":"session","id":"01a07b9e-4019-7d82-8599-f430d1ae00b2"},"sequence":461,"recorded_at":1780531400000917,"record_type":"event","durability":"durable","causation_id":"868a1309-d750-4b15-8a10-0ca2d4130887","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"868a1309-d750-4b15-8a10-0ca2d4130887","run_stream":{"kind":"run","id":"868a1309-d750-4b15-8a10-0ca2d4130887"},"task_stream":{"kind":"task","id":"4b2f9d87-fe5f-4544-a1f7-b4dd21700780"},"task_id":"4b2f9d87-fe5f-4544-a1f7-b4dd21700780","event":{"kind":"output","task_id":"4b2f9d87-fe5f-4544-a1f7-b4dd21700780","chunk":"Read text file `internal/canonicaljson/core_records.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"regexp\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|const (\n16|\tleaseSchema            = \"urn:ax:schema:lease\"\n17|\tcheckpointSchema       = \"urn:ax:schema:checkpoint\"\n18|\tproviderIdentitySchema = \"urn:ax:schema:provider-identity\"\n19|\tworkspaceGroupSchema   = \"urn:ax:schema:workspace-group\"\n20|\tsessionEventSchema     = \"urn:ax:schema:session-event\"\n21|\tobservationSchema      = \"urn:ax:schema:observation\"\n22|)\n23|\n24|var (\n25|\tproviderIdentityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n26|\tobservationNamePattern     = regexp.MustCompile(`^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$`)\n27|\tlowerSnakePattern          = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n28|\n29|\t// terminalBackendIDPattern is the Section 4.B declared grammar, verbatim:\n30|\t// \"terminal_backend_id is 1-128 ASCII bytes matching\n31|\t// [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\".\n32|\tterminalBackendIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n33|\twindowsAbsolutePathPattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n34|\n35|\t// ErrInvalidObservation reports an Observation Event or stream outside the\n36|\t// pinned Section 18.1 contract. Observation Events are not identity-addressed.\n37|\tErrInvalidObservation = errors.New(\"invalid observation event\")\n38|)\n39|\n40|func validateLeaseRecord(object map[string]any) error {\n41|\tif err := requireExactMembers(\"Lease Record\", object,\n42|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"lease_id\", \"session_id\", \"epoch\",\n43|\t\t\"holder_host_id\", \"predecessor_lease_id\", \"reason\", \"checkpoint_id\", \"issued_by_host_id\",\n44|\t\t\"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n45|\t\treturn err\n46|\t}\n47|\tif err := validateIdentityRecordEnvelope(object, leaseSchema, \"1.0.0\", \"record_id\"); err != nil {\n48|\t\treturn err\n49|\t}\n50|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n51|\tif err != nil {\n52|\t\treturn err\n53|\t}\n54|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n55|\tif err != nil {\n56|\t\treturn err\n57|\t}\n58|\tif subjectID != sessionID {\n59|\t\treturn invalidIdentity(\"Lease Record subject_id must equal session_id\")\n60|\t}\n61|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n62|\t\treturn err\n63|\t}\n64|\tepoch, err := requirePositiveUint(object, \"epoch\")\n65|\tif err != nil {\n66|\t\treturn err\n67|\t}\n68|\tif _, err := requireUUIDv7(object, \"holder_host_id\"); err != nil {\n69|\t\treturn err\n70|\t}\n71|\tpredecessorPresent, err := requireNullableUUIDv4(object, \"predecessor_lease_id\")\n72|\tif err != nil {\n73|\t\treturn err\n74|\t}\n75|\treason, err := requireEnum(object, \"reason\", \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\")\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\tcheckpointPresent, err := requireNullableDigestPresence(object, \"checkpoint_id\")\n80|\tif err != nil {\n81|\t\treturn err\n82|\t}\n83|\t// Each of the three couplings below quotes the clause that licenses it.\n84|\t// Section 5.3 does not declare an epoch-1 => create direction anywhere, so\n85|\t// an epoch-1 recovery or takeover lease is admitted: where the pinned\n86|\t// specification is silent this validator stays permissive.\n87|\tepochOneCreate := epoch == 1 && reason == \"create\"\n88|\t// predecessor_lease_id: \"Null only at epoch 1\".\n89|\tif epoch != 1 && !predecessorPresent {\n90|\t\treturn invalidIdentity(\"Lease Record predecessor_lease_id must be non-null after epoch 1\")\n91|\t}\n92|\t// \"An epoch-1 create lease MUST have a null predecessor\".\n93|\tif epochOneCreate && predecessorPresent {\n94|\t\treturn invalidIdentity(\"Lease Record epoch-1 create predecessor_lease_id must be null\")\n95|\t}\n96|\t// checkpoint_id: \"Null only for epoch-1 create; otherwise the validated\n97|\t// materialized handoff base\". The complement of epoch-1 create therefore\n98|\t// requires a non-null checkpoint, including at epoch 1 for any other reason.\n99|\tif !epochOneCreate && !checkpointPresent {\n100|\t\treturn invalidIdentity(\"Lease Record checkpoint_id must be non-null unless the lease is an epoch-1 create\")\n101|\t}\n102|\tissuedBy, err := requireUUIDv7(object, \"issued_by_host_id\")\n103|\tif err != nil {\n104|\t\treturn err\n105|\t}\n106|\tcreatedBy, _ := object[\"created_by_host_id\"].(string)\n107|\tif createdBy != issuedBy {\n108|\t\treturn invalidIdentity(\"Lease Record created_by_host_id must equal issued_by_host_id\")\n109|\t}\n110|\treturn nil\n111|}\n112|\n113|func validateCheckpointRecord(object map[string]any) error {\n114|\tif err := requireExactMembers(\"Checkpoint Record\", object,\n115|\t\t\"schema\", \"schema_version\", \"checkpoint_id\", \"subject_id\", \"session_id\", \"lease_epoch\", \"lease_id\",\n116|\t\t\"safe_boundary\", \"event_heads\", \"workspace_manifest_id\", \"provider_manifest_id\", \"task_board_bundle_id\",\n117|\t\t\"created_by_host_id\", \"created_at\", \"status\", \"extensions\"); err != nil {\n118|\t\treturn err\n119|\t}\n120|\tif err := validateIdentityRecordEnvelope(object, checkpointSchema, \"1.0.0\", \"checkpoint_id\"); err != nil {\n121|\t\treturn err\n122|\t}\n123|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n124|\tif err != nil {\n125|\t\treturn err\n126|\t}\n127|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif subjectID != sessionID {\n132|\t\treturn invalidIdentity(\"Checkpoint Record subject_id must equal session_id\")\n133|\t}\n134|\tif _, err := requirePositiveUint(object, \"lease_epoch\"); err != nil {\n135|\t\treturn err\n136|\t}\n137|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n138|\t\treturn err\n139|\t}\n140|\tboundary, err := requireObject(object, \"safe_boundary\")\n141|\tif err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif err := validateSafeBoundaryEvidence(boundary); err != nil {\n145|\t\treturn err\n146|\t}\n147|\theads, err := requireArrayRange(object, \"event_heads\", 1, 64)\n148|\tif err != nil {\n149|\t\treturn err\n150|\t}\n(more lines below)"}}}
