 \\\"; \\\"))\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\treturn\\n\\t\\t\\t}\\n\\t\\t\\tmatched := false\\n\\t\\t\\tfor _, failure := range failures {\\n\\t\\t\\t\\tif strings.Contains(failure, plant.wantFailure) {\\n\\t\\t\\t\\t\\tmatched = true\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tif !matched {\\n\\t\\t\\t\\tt.Fatalf(\\\"plant reported %q, want a failure containing %q\\\", failures, plant.wantFailure)\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\\n// TestCensusAuditParsingFailsClosed proves the plant harness\\n// itself is fail-closed: an unparseable control is a harness\\n// failure, never a clean plant.\\nfunc TestCensusAuditParsingFailsClosed(t *testing.T) {\\n\\t_, _, failure := invcore.ParseSource(\\\"plant.go\\\", []byte(\\\"package provider\\\\nfunc broken( {\\\\n\\\"))\\n\\tif failure == \\\"\\\" {\\n\\t\\tt.Fatal(\\\"unparseable control parsed clean; the harness would pass a blind plant\\\")\\n\\t}\\n}\\n\\n// TestRegistryExcludedNameStillFailsOnRebind proves the\\n// validateProviderIdentityRecord exclusion above loses nothing:\\n// a true rebinding of the excluded name derives an unregistered\\n// shape site through the production shape extractor, so the\\n130:func ParseBytes(filename string, source []byte, mode parser.Mode) (*ast.File, *token.FileSet, string) {\\n131-\\tfileSet := token.NewFileSet()\\n132-\\tsyntax, err := parser.ParseFile(fileSet, filename, source, mode)\\n133-\\tif err != nil {\\n134-\\t\\treturn nil, nil, \\\"parse \\\" + filename + \\\": \\\" + err.Error() + \\\"; an unparseable derivation proves nothing\\\"\\n135-\\t}\\n136-\\treturn syntax, fileSet, \\\"\\\"\\n137-}\\n138-\\n139-// DiffSets is the both-direction harness over string keys: every derived\\n140-// key without a row is unregistered, every row without a derived key is\\n141-// orphaned. Both lists are sorted. Empty derived input is itself a\\n142-// failure: a domain that silently derives nothing is not a measurement,\\n\",\n  \"original_output_bytes\": 2501,\n  \"original_output_tokens\": 626,\n  \"truncated\": false\n}"}}}
