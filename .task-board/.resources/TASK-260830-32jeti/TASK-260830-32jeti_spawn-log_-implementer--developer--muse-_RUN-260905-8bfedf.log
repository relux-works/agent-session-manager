{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c703","stream":{"kind":"session","id":"01a07318-0241-7da3-b57d-6ffdad68a9f0"},"sequence":476,"recorded_at":1780531400000947,"record_type":"event","durability":"durable","causation_id":"22948bf0-08f7-4fc5-a226-da30d51eda4e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"22948bf0-08f7-4fc5-a226-da30d51eda4e","run_stream":{"kind":"run","id":"22948bf0-08f7-4fc5-a226-da30d51eda4e"},"task_stream":{"kind":"task","id":"5e9e6805-67a3-426c-89a3-41fcf3263cf7"},"task_id":"5e9e6805-67a3-426c-89a3-41fcf3263cf7","event":{"kind":"output","task_id":"5e9e6805-67a3-426c-89a3-41fcf3263cf7","chunk":"{\n  \"chunk_id\": \"exec-26-1\",\n  \"command\": \"cd /tmp/merge && python3 - <<'EOF'\\nimport json\\nmerged = json.load(open('work_ownership.json'))\\ntrunk = json.load(open('trunk/ownership.json'))\\n# find the array holding these blocks (the one with terminal-manifest / provider-discovery ids)\\ndef find_arr(d):\\n    for k,v in d.items():\\n        if isinstance(v, list) and any(isinstance(e,dict) and e.get('id')=='terminal-manifest-probe-admission' for e in v):\\n            return k, v\\nk, arr = find_arr(merged)\\nprint(\\\"array key:\\\", k, \\\"len:\\\", len(arr))\\nids = [e['id'] for e in arr if isinstance(e,dict) and 'id' in e]\\nimport collections\\nprint(\\\"last 9 ids:\\\", ids[-9:])\\n# sibling blocks byte-identical to trunk?\\n_, tarr = find_arr(trunk)\\nm_by = {e['id']: e for e in arr}\\nt_by = {e['id']: e for e in tarr}\\nfor bid in ['terminal-manifest-probe-admission','terminal-provider-descriptor-7a','terminal-lifecycle-conformance']:\\n    assert m_by[bid] == t_by[bid], f\\\"sibling block {bid} differs!\\\"\\nprint(\\\"sibling 3 blocks byte-identical to trunk: OK\\\")\\n# ours blocks present?\\nfor bid in ['provider-discovery-and-trust','provhost-quiesce-proof','provhost-profile-mapping','provhost-capability-gate']:\\n    assert bid in m_by, f\\\"missing {bid}\\\"\\nprint(\\\"ours 4 blocks present: OK\\\")\\nEOF\",\n  \"description\": \"Verify merged ownership keeps both sides intact\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"array key: acceptance_cases len: 81\\nlast 9 ids: ['structured-error-identity-precedence', 'structured-error-common-data-model', 'terminal-manifest-probe-admission', 'terminal-provider-descriptor-7a', 'terminal-lifecycle-conformance', 'provider-discovery-and-trust', 'provhost-quiesce-proof', 'provhost-profile-mapping', 'provhost-capability-gate']\\nsibling 3 blocks byte-identical to trunk: OK\\nours 4 blocks present: OK\\n\",\n  \"original_output_bytes\": 418,\n  \"original_output_tokens\": 105,\n  \"truncated\": false\n}"}}}
