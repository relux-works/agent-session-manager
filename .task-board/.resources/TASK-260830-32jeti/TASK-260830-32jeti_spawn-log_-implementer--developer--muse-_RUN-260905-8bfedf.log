{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca4b","stream":{"kind":"session","id":"01a07318-0241-7da3-b57d-6ffdad68a9f0"},"sequence":896,"recorded_at":1780531400001787,"record_type":"event","durability":"durable","causation_id":"22948bf0-08f7-4fc5-a226-da30d51eda4e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"22948bf0-08f7-4fc5-a226-da30d51eda4e","run_stream":{"kind":"run","id":"22948bf0-08f7-4fc5-a226-da30d51eda4e"},"call_id":"call_01a0731cb83271509f9b1fb23de7a21a","text":"{\n  \"chunk_id\": \"exec-43-1\",\n  \"command\": \"git diff HEAD --stat -- internal/terminalbackend/ internal/config/ | head; echo \\\"---\\\"; git stash list | head -3\\ngit show HEAD:internal/terminalbackend/terminalbackend_test.go | sed -n '965,978p'\",\n  \"description\": \"Confirm Windows vet failure is pre-existing\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"---\\nstash@{0}: On task-board/story/STORY-260830-3jqsx1: pre-base-refresh: accepted candidate rev7 + LOGBOOK/README merge with trunk 2512f20\\n\\t}\\n\\t// A FIFO pins the regular-file guard itself: the directory case above\\n\\t// would still fail with the guard removed, because os.ReadFile rejects\\n\\t// directories (EISDIR) on its own. A FIFO is the documented hazard\\n\\t// (README: os.Open blocks indefinitely on a FIFO), and only the\\n\\t// Mode().IsRegular check refuses it without blocking.\\n\\tfifo := filepath.Join(t.TempDir(), \\\"backend-fifo\\\")\\n\\tif err := syscall.Mkfifo(fifo, 0o600); err != nil {\\n\\t\\tt.Fatalf(\\\"Mkfifo() error = %v\\\", err)\\n\\t}\\n\\tif _, err := terminalbackend.DigestFile(fifo); err == nil {\\n\\t\\tt.Error(\\\"DigestFile(fifo) error = nil, want refusal for a non-regular file\\\")\\n\\t}\\n}\\n\",\n  \"original_output_bytes\": 771,\n  \"original_output_tokens\": 193,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
