{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8c7","stream":{"kind":"session","id":"01a07318-0241-7da3-b57d-6ffdad68a9f0"},"sequence":702,"recorded_at":1780531400001399,"record_type":"event","durability":"durable","causation_id":"22948bf0-08f7-4fc5-a226-da30d51eda4e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"22948bf0-08f7-4fc5-a226-da30d51eda4e","run_stream":{"kind":"run","id":"22948bf0-08f7-4fc5-a226-da30d51eda4e"},"task_stream":{"kind":"task","id":"051366ff-0108-4b47-87d3-d57a1caf0048"},"task_id":"051366ff-0108-4b47-87d3-d57a1caf0048","event":{"kind":"output","task_id":"051366ff-0108-4b47-87d3-d57a1caf0048","chunk":"{\n  \"chunk_id\": \"exec-33-1\",\n  \"command\": \"python3 - <<'EOF'\\ntrunk = open('/dev/null').read()  # placeholder\\nimport subprocess\\ntrunk_log = subprocess.run(['git','show','2512f20:LOGBOOK.md'], capture_output=True, text=True).stdout\\nmerged = open('LOGBOOK.md').read()\\n# every line of trunk LOGBOOK must appear in merged in order (subsequence check)\\ntl = trunk_log.split('\\\\n'); ml = merged.split('\\\\n')\\ni = 0\\nfor line in tl:\\n    while i < len(ml) and ml[i] != line:\\n        i += 1\\n    assert i < len(ml), f\\\"trunk line missing from merged: {line[:100]}\\\"\\n    i += 1\\nprint(f\\\"sibling LOGBOOK: all {len(tl)} trunk lines present in order, zero dropped: OK\\\")\\n# sibling blocks byte-identical: check the landed commit's added lines are contiguous-verbatim\\ndiff = subprocess.run(['git','diff','57afcc6','2512f20','--','LOGBOOK.md'], capture_output=True, text=True).stdout\\nadded = [l[1:] for l in diff.split('\\\\n') if l.startswith('+') and not l.startswith('+++')]\\nmissing = [l for l in added if l not in ml]\\nassert not missing, f\\\"{len(missing)} sibling-added lines missing\\\"\\nprint(f\\\"sibling LOGBOOK additions: all {len(added)} added lines verbatim in merged: OK\\\")\\nEOF\",\n  \"description\": \"Verify sibling LOGBOOK entries preserved verbatim\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"sibling LOGBOOK: all 762 trunk lines present in order, zero dropped: OK\\nsibling LOGBOOK additions: all 86 added lines verbatim in merged: OK\\n\",\n  \"original_output_bytes\": 141,\n  \"original_output_tokens\": 36,\n  \"truncated\": false\n}"}}}
