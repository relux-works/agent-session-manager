{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d7","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":326,"recorded_at":1780531400000647,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"27ea244a-79c4-4aff-b08c-2f3e3cc4be79"},"task_id":"27ea244a-79c4-4aff-b08c-2f3e3cc4be79","event":{"kind":"output","task_id":"27ea244a-79c4-4aff-b08c-2f3e3cc4be79","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|\n20|// identitySchema is the exact schema identifier the record carries.\n21|const identitySchema = \"urn:ax:schema:provider-identity\"\n22|\n23|// identitySchemaVersion is the only identity version accepted.\n24|const identitySchemaVersion = \"1.0.0\"\n25|\n26|// identityKinds is the closed identity-kind enum in section order.\n27|var identityKinds = []string{\n28|\t\"session_uuid\",\n29|\t\"session_path_or_id\",\n30|\t\"backend_conversation_uuid\",\n31|\t\"task_board_managed\",\n32|\t\"provider_defined\",\n33|}\n34|\n35|// identityMembers is the exact required member set of a Provider\n36|// Identity Record.\n37|var identityMembers = map[string]bool{\n38|\t\"schema\":                    true,\n39|\t\"schema_version\":            true,\n40|\t\"record_id\":                 true,\n41|\t\"subject_id\":                true,\n42|\t\"session_id\":                true,\n43|\t\"provider_id\":               true,\n44|\t\"provider_version\":          true,\n45|\t\"provider_version_range\":    true,\n46|\t\"native_session_id\":         true,\n47|\t\"identity_kind\":             true,\n48|\t\"logical_workspace_id\":      true,\n49|\t\"backend_realm_fingerprint\": true,\n50|\t\"opaque_identity\":           true,\n51|\t\"created_by_host_id\":        true,\n52|\t\"created_at\":                true,\n53|\t\"extensions\":                true,\n54|}\n55|\n56|// identityRequired lists identityMembers in a fixed order so a record\n57|// missing several members always names the same one.\n58|var identityRequired = []string{\n59|\t\"schema\",\n60|\t\"schema_version\",\n61|\t\"record_id\",\n62|\t\"subject_id\",\n63|\t\"session_id\",\n64|\t\"provider_id\",\n65|\t\"provider_version\",\n66|\t\"provider_version_range\",\n67|\t\"native_session_id\",\n68|\t\"identity_kind\",\n69|\t\"logical_workspace_id\",\n70|\t\"backend_realm_fingerprint\",\n71|\t\"opaque_identity\",\n72|\t\"created_by_host_id\",\n73|\t\"created_at\",\n74|\t\"extensions\",\n75|}\n76|\n77|// identityKeyPattern is the provider-identity key grammar Section 5.5\n78|// states: [a-z][a-z0-9_.-]{0,63}.\n79|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n80|\n81|// windowsDrivePattern matches a Windows drive-qualified absolute\n82|// prefix: a letter, a colon, and a separator.\n83|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n84|\n85|// CheckIdentity validates one Provider Identity Record naming the\n86|// expected provider. Shape violations are provider_protocol_errors;\n87|// a well-formed record for another provider is an invalid_config\n88|// caller error: the caller correlated the wrong identity to this\n89|// session.\n90|func CheckIdentity(body []byte, wantProviderID string) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, identityRequired); missing {\n107|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n114|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n121|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n128|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tsubject, ok := rawString(members[\"subject_id\"])\n135|\tif !ok || !isUUIDv7(subject) {\n136|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n137|\t\tif err != nil {\n138|\t\t\treturn err\n139|\t\t}\n140|\t\treturn failure\n141|\t}\n142|\tsession, ok := rawString(members[\"session_id\"])\n143|\tif !ok || !isUUIDv7(session) {\n144|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n145|\t\tif err != nil {\n146|\t\t\treturn err\n147|\t\t}\n148|\t\treturn failure\n149|\t}\n150|\tif subject != session {\n151|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n152|\t\tif err != nil {\n153|\t\t\treturn err\n154|\t\t}\n155|\t\treturn failure\n156|\t}\n157|\tprovider, ok := rawString(members[\"provider_id\"])\n158|\tif !ok || !validProviderID(provider) {\n159|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\treturn failure\n164|\t}\n165|\tif provider != wantProviderID {\n166|\t\tfailure, err := failInvalid(\"identity names another provider\")\n167|\t\tif err != nil {\n168|\t\t\treturn err\n169|\t\t}\n170|\t\treturn failure\n171|\t}\n172|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n173|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n174|\t\tif err != nil {\n175|\t\t\treturn err\n176|\t\t}\n177|\t\treturn failure\n178|\t}\n179|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n180|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n187|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\treturn failure\n192|\t}\n193|\tkind, ok := rawString(members[\"identity_kind\"])\n194|\tif !ok || !isIdentityKind(kind) {\n195|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n196|\t\tif err != nil {\n197|\t\t\treturn err\n198|\t\t}\n199|\t\treturn failure\n200|\t}\n201|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n202|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\treturn failure\n207|\t}\n208|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n215|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n216|\t\tif err != nil {\n217|\t\t\treturn err\n218|\t\t}\n219|\t\treturn failure\n220|\t}\n221|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n222|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n223|\t\tif err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\treturn failure\n227|\t}\n228|\tif !isJSONObject(members[\"extensions\"]) {\n229|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n230|\t\tif err != nil {\n231|\t\t\treturn err\n232|\t\t}\n233|\t\treturn failure\n234|\t}\n235|\treturn nil\n236|}\n237|\n238|// checkIdentityRealm enforces the digest-or-null shape and the one\n239|// conditional rule Section 5.5 states: an Antigravity\n240|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n241|// because the backend realm is a resume precondition there.\n242|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n243|\trealm, isNull, ok := rawNullableString(raw)\n244|\tif !ok || (!isNull && !isDigest(realm)) {\n245|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n246|\t\tif err != nil {\n247|\t\t\treturn err\n248|\t\t}\n249|\t\treturn failure\n250|\t}\n251|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n252|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n253|\t\tif err != nil {\n254|\t\t\treturn err\n255|\t\t}\n256|\t\treturn failure\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n262|// object of at most 32 entries, keyed by the provider-identity key\n263|// grammar, with non-secret string values of 1..1,024 characters that\n264|// MUST NOT begin with an absolute path.\n265|func checkIdentityOpaque(raw json.RawMessage) error {\n266|\topaque, fault := decodeStrictObject(raw)\n267|\tif fault != nil {\n268|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n269|\t\tif err != nil {\n270|\t\t\treturn err\n271|\t\t}\n272|\t\treturn failure\n273|\t}\n274|\tif len(opaque) > 32 {\n275|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n276|\t\tif err != nil {\n277|\t\t\treturn err\n278|\t\t}\n279|\t\treturn failure\n280|\t}\n281|\tkeys := make([]string, 0, len(opaque))\n282|\tfor key := range opaque {\n283|\t\tkeys = append(keys, key)\n284|\t}\n285|\tfor _, key := range keys {\n286|\t\tif !identityKeyPattern.MatchString(key) {\n287|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n288|\t\t\tif err != nil {\n289|\t\t\t\treturn err\n290|\t\t\t}\n291|\t\t\treturn failure\n292|\t\t}\n293|\t\tvalue, ok := rawString(opaque[key])\n294|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n295|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n296|\t\t\tif err != nil {\n297|\t\t\t\treturn err\n298|\t\t\t}\n299|\t\t\treturn failure\n300|\t\t}\n301|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n302|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n303|\t\t\tif err != nil {\n304|\t\t\t\treturn err\n305|\t\t\t}\n306|\t\t\treturn failure\n307|\t\t}\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|func isIdentityKind(value string) bool {\n313|\tfor _, kind := range identityKinds {\n314|\t\tif value == kind {\n315|\t\t\treturn true\n316|\t\t}\n317|\t}\n318|\treturn false\n319|}\n320|\n321|// identifyMembers is the exact required member set of an\n322|// identify-session success body.\n323|var identifyMembers = map[string]bool{\n324|\t\"identity\":         true,\n325|\t\"confidence\":       true,\n326|\t\"matched_evidence\": true,\n327|}\n328|\n329|// identifyRequired lists identifyMembers in a fixed order.\n330|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n331|\n332|// identifyConfidences is the closed confidence vocabulary.\n333|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n334|\n335|// identifyEvidence is the closed matched-evidence vocabulary.\n336|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n337|\n338|// DecodeIdentifyResult validates one identify-session success body:\n339|// the Provider Identity Record for the expected provider, a closed\n340|// confidence, and 1..4 sorted unique matched-evidence members.\n341|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n342|\tmembers, fault := decodeStrictObject(body)\n343|\tif fault != nil {\n344|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n345|\t\tif err != nil {\n346|\t\t\treturn err\n347|\t\t}\n348|\t\treturn failure\n349|\t}\n350|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n351|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n352|\t\tif err != nil {\n353|\t\t\treturn err\n354|\t\t}\n355|\t\treturn failure\n356|\t}\n357|\tif name, missing := missingMember(members, identifyRequired); missing {\n358|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n359|\t\tif err != nil {\n360|\t\t\treturn err\n361|\t\t}\n362|\t\treturn failure\n363|\t}\n364|\tconfidence, ok := rawString(members[\"confidence\"])\n365|\tif !ok || !isIdentifyConfidence(confidence) {\n366|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n367|\t\tif err != nil {\n368|\t\t\treturn err\n369|\t\t}\n370|\t\treturn failure\n371|\t}\n372|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n373|\t\treturn err\n374|\t}\n375|\tif !isJSONObject(members[\"identity\"]) {\n376|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n377|\t\tif err != nil {\n378|\t\t\treturn err\n379|\t\t}\n380|\t\treturn failure\n381|\t}\n382|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n383|\t\treturn err\n384|\t}\n385|\treturn nil\n386|}\n387|\n388|func isIdentifyConfidence(value string) bool {\n389|\tfor _, confidence := range identifyConfidences {\n390|\t\tif value == confidence {\n391|\t\t\treturn true\n392|\t\t}\n393|\t}\n394|\treturn false\n395|}\n396|\n397|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n398|// evidence members: the observation must cite what matched, exactly\n399|// once each.\n400|func checkIdentifyEvidence(raw json.RawMessage) error {\n401|\tevidence, ok := rawStringArray(raw)\n402|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n403|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n404|\t\tif err != nil {\n405|\t\t\treturn err\n406|\t\t}\n407|\t\treturn failure\n408|\t}\n409|\tallowed := map[string]bool{}\n410|\tfor _, member := range identifyEvidence {\n411|\t\tallowed[member] = true\n412|\t}\n413|\tfor _, member := range evidence {\n414|\t\tif !allowed[member] {\n415|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n416|\t\t\tif err != nil {\n417|\t\t\t\treturn err\n418|\t\t\t}\n419|\t\t\treturn failure\n420|\t\t}\n421|\t}\n422|\tif !sortedUniqueStrings(evidence) {\n423|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n424|\t\tif err != nil {\n425|\t\t\treturn err\n426|\t\t}\n427|\t\treturn failure\n428|\t}\n429|\treturn nil\n430|}"}}}
