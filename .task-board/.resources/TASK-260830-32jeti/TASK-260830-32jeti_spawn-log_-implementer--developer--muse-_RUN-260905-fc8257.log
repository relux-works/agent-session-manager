{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c78f","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":546,"recorded_at":1780531400001087,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"05be2da5-bd1a-4b1e-8f73-778c3aab56c4"},"task_id":"05be2da5-bd1a-4b1e-8f73-778c3aab56c4","event":{"kind":"output","task_id":"05be2da5-bd1a-4b1e-8f73-778c3aab56c4","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/conformance_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"encoding/json\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file is the conformance harness: scripted-plugin sequences\n15|// driven through the production Host.Call entry point, asserting the\n16|// operation-layer decoders agree with the transport on the same\n17|// bytes. Every sequence uses a fresh scriptRunner per process and\n18|// counts spawned processes, so a hidden retry or an ambient cache\n19|// would redden the spawn assertions rather than passing silently.\n20|\n21|// childFailureFrameFor builds a failure envelope carrying a genuine\n22|// bound child error for the named registered code, through the\n23|// production axerror entry point. The code must be registered for\n24|// Structured Error 1.0.0, which the provider 2.x binding requires.\n25|func childFailureFrameFor(t *testing.T, want, code, message string) []byte {\n26|\tt.Helper()\n27|\tchild, err := axerror.New(axerror.Spec{\n28|\t\tVersion: axerror.Version100,\n29|\t\tCode:    axerror.Code(code),\n30|\t\tMessage: message,\n31|\t\tDetails: axerror.Details{},\n32|\t})\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"axerror.New(%q): %v\", code, err)\n35|\t}\n36|\traw, err := json.Marshal(child)\n37|\tif err != nil {\n38|\t\tt.Fatalf(\"Marshal child: %v\", err)\n39|\t}\n40|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":false,\"error\":` + string(raw) + `}`)\n41|}\n42|\n43|// frameFor builds a single-line success envelope: the contract\n44|// fixtures are pretty-printed in the document, but the wire carries\n45|// one JSONL line, so bodies compact to that line here.\n46|func frameFor(t *testing.T, requestID, body string) []byte {\n47|\tt.Helper()\n48|\tvar compacted bytes.Buffer\n49|\tif err := json.Compact(&compacted, []byte(body)); err != nil {\n50|\t\tt.Fatalf(\"compact fixture: %v\", err)\n51|\t}\n52|\treturn successFrame(t, requestID, compacted.String())\n53|}\n54|\n55|// callWithBody starts one Host.Call for the operation with the canned\n56|// response frame and returns the success body.\n57|func callWithBody(t *testing.T, runner *scriptRunner, operation Operation, requestID string, frame []byte) []byte {\n58|\tt.Helper()\n59|\thost := liveHost(runner)\n60|\treq := liveRequest(t)\n61|\treq.Operation = operation\n62|\treq.RequestID = mustUUIDv7(t, requestID)\n63|\trunner.steps = append(runner.steps, okStep(Result{Stdout: frame, ExitCode: 0}))\n64|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"%s Call: %v\", operation, err)\n67|\t}\n68|\treturn got.Body\n69|}\n70|\n71|// TestManifestAndProbeThroughCall proves the manifest and probe\n72|// decoders agree with the transport: the exact bytes one plugin\n73|// process returned pass both DecodeResponse and the operation\n74|// decoder, for both operations in registry order.\n75|func TestManifestAndProbeThroughCall(t *testing.T) {\n76|\trunner := &scriptRunner{}\n77|\tmanifestBody := callWithBody(t, runner, OpManifest, testRequestID, frameFor(t, testRequestID, specManifestExample))\n78|\tif err := DecodeManifest(manifestBody); err != nil {\n79|\t\tt.Fatalf(\"manifest through Call: %v\", err)\n80|\t}\n81|\tprobeBody := callWithBody(t, runner, OpProbe, testOtherID, frameFor(t, testOtherID, specProbeExample))\n82|\tif err := DecodeProbe(probeBody); err != nil {\n83|\t\tt.Fatalf(\"probe through Call: %v\", err)\n84|\t}\n85|\tif runner.spawned() != 2 {\n86|\t\tt.Fatalf(\"spawned %d processes, want one per operation\", runner.spawned())\n87|\t}\n88|\tfor index, call := range runner.calls {\n89|\t\tvar decoded struct {\n90|\t\t\tOperation string `json:\"operation\"`\n91|\t\t}\n92|\t\tif err := json.Unmarshal(call.stdin, &decoded); err != nil {\n93|\t\t\tt.Fatalf(\"call %d stdin is not JSON: %v\", index, err)\n94|\t\t}\n95|\t\twant := string([]Operation{OpManifest, OpProbe}[index])\n96|\t\tif decoded.Operation != want {\n97|\t\t\tt.Fatalf(\"call %d operation = %q, want %q\", index, decoded.Operation, want)\n98|\t\t}\n99|\t}\n100|}\n101|\n102|// TestUnknownOperationThroughCallStartsNoProcess proves dispatch\n103|// refuses locally: Host.Call with an unknown operation returns\n104|// invalid_config without touching the Runner.\n105|func TestUnknownOperationThroughCallStartsNoProcess(t *testing.T) {\n106|\trunner := &scriptRunner{}\n107|\thost := liveHost(runner)\n108|\treq := liveRequest(t)\n109|\treq.Operation = \"reboot\"\n110|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n111|\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n112|\tif runner.spawned() != 0 {\n113|\t\tt.Fatalf(\"unknown operation spawned %d processes, want none\", runner.spawned())\n114|\t}\n115|}\n116|\n117|// TestResumeThroughCall proves the normative resume plan travels the\n118|// transport and validates for its provider, profile, and platform,\n119|// with the profile_mapping equal to the Section 7.7 mapping.\n120|func TestResumeThroughCall(t *testing.T) {\n121|\trunner := &scriptRunner{}\n122|\tbody := callWithBody(t, runner, OpResume, testRequestID, frameFor(t, testRequestID, specResumePlan))\n123|\tif err := DecodeSpawnPlan(body, \"codex\", ProfileYOLO, scalar.PlatformLinux); err != nil {\n124|\t\tt.Fatalf(\"resume through Call: %v\", err)\n125|\t}\n126|}\n127|\n128|// specIdentifyCallBody wraps the Section 5.5 example in an\n129|// identify-session success body.\n130|func specIdentifyCallBody() []byte {\n131|\treturn []byte(`{\"identity\": ` + specIdentityExample + `, \"confidence\": \"exact\", \"matched_evidence\": [\"native_id\", \"store_path\"]}`)\n132|}\n133|\n134|// TestIdentifyThroughCall proves the identify-session result travels\n135|// the transport and validates for its provider.\n136|func TestIdentifyThroughCall(t *testing.T) {\n137|\trunner := &scriptRunner{}\n138|\tbody := callWithBody(t, runner, OpIdentifySession, testRequestID, frameFor(t, testRequestID, string(specIdentifyCallBody())))\n139|\tif err := DecodeIdentifyResult(body, \"antigravity\"); err != nil {\n140|\t\tt.Fatalf(\"identify through Call: %v\", err)\n141|\t}\n142|}\n143|\n144|// TestQuiesceThroughCall proves both quiescence verdicts travel the\n145|// transport: the safe proof reports safe true and the unsafe proof\n146|// reports safe false, which is what stops graceful takeover.\n147|func TestQuiesceThroughCall(t *testing.T) {\n148|\trunner := &scriptRunner{}\n149|\tsafeBody := callWithBody(t, runner, OpQuiesce, testRequestID, frameFor(t, testRequestID, safeQuiesceProof))\n150|\tsafe, err := DecodeQuiesceProof(safeBody)\n151|\tif err != nil {\n152|\t\tt.Fatalf(\"safe quiesce through Call: %v\", err)\n153|\t}\n154|\tif !safe {\n155|\t\tt.Fatal(\"safe quiesce proof reports safe false\")\n156|\t}\n157|\tunsafeProof := `{\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\", \"input_blocked\": true, \"boundary_ref\": \"e\", \"foreground_idle\": true, \"background_idle\": null, \"open_child_count\": 0, \"open_database_handle_count\": 0, \"store_generation\": \"g\", \"safe\": false, \"blockers\": []}`\n158|\tunsafeBody := callWithBody(t, runner, OpQuiesce, testOtherID, successFrame(t, testOtherID, unsafeProof))\n159|\tunsafe, err := DecodeQuiesceProof(unsafeBody)\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"unsafe quiesce through Call: %v\", err)\n162|\t}\n163|\tif unsafe {\n164|\t\tt.Fatal(\"unsafe quiesce proof reports safe true; graceful takeover must stop\")\n165|\t}\n166|}\n167|\n168|// TestCapabilityGatePrecedesCall proves the fail-closed tuples: for\n169|// every registry capability under every non-available status the\n170|// host-side gate refuses and no plugin process starts. The domain is\n171|// derived from Capabilities() times the three non-available\n172|// statuses — 21 tuples, all measured, none sampled.\n173|func TestCapabilityGatePrecedesCall(t *testing.T) {\n174|\ttuples := 0\n175|\tfor _, name := range Capabilities() {\n176|\t\tfor _, status := range []string{CapabilityConditional, CapabilityUnsupported, CapabilityUnknown} {\n177|\t\t\tname, status := name, status\n178|\t\t\tt.Run(name+\"/\"+status, func(t *testing.T) {\n179|\t\t\t\tprobe := probeWithCapabilities(t, func(key, _ string) string {\n180|\t\t\t\t\tif key == name {\n181|\t\t\t\t\t\treturn probeCapabilityBlock(status, false)\n182|\t\t\t\t\t}\n183|\t\t\t\t\treturn probeCapabilityBlock(CapabilityUnsupported, false)\n184|\t\t\t\t})\n185|\t\t\t\trunner := &scriptRunner{}\n186|\t\t\t\terr := RequireCapability(probe, name)\n187|\t\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"does not establish the capability\")\n188|\t\t\t\tif runner.spawned() != 0 {\n189|\t\t\t\t\tt.Fatalf(\"refused capability started %d processes\", runner.spawned())\n190|\t\t\t\t}\n191|\t\t\t})\n192|\t\t\ttuples++\n193|\t\t}\n194|\t}\n195|\tif tuples != len(Capabilities())*3 {\n196|\t\tt.Fatalf(\"measured %d fail-closed tuples, want %d\", tuples, len(Capabilities())*3)\n197|\t}\n198|\tt.Logf(\"fail-closed tuple coverage: %d/%d capability-by-status tuples refused with no process\", tuples, tuples)\n199|\t// The positive control: the established capability proceeds.\n200|\trunner := &scriptRunner{}\n201|\tif err := RequireCapability([]byte(specProbeExample), \"native_resume\"); err != nil {\n202|\t\tt.Fatalf(\"established capability refused: %v\", err)\n203|\t}\n204|\tcallWithBody(t, runner, OpNativeStorePlan, testRequestID, successFrame(t, testRequestID, `{}`))\n205|\tif runner.spawned() != 1 {\n206|\t\tt.Fatalf(\"established capability spawned %d processes, want one\", runner.spawned())\n207|\t}\n208|}\n209|\n210|// preparedResultBody is the normative prepared materialize result\n211|// (Section 7.5): the bytes a lost-response retry must reproduce\n212|// byte-identically.\n213|const preparedResultBody = `{\n214|  \"operation_id\": \"0198f4c8-e4b0-75cc-9576-1234567890ab\",\n215|  \"materialization_id\": \"0198f4c8-c290-73aa-9374-1234567890ab\",\n216|  \"transaction_id\": \"0198f4c8-f5c0-76dd-9677-1234567890ab\",\n217|  \"plan_id\": \"sha256:64644a5ad573d36c0c13f44f56ef25ab93cff33001ff2a3371b082603910f2dd\",\n218|  \"state\": \"prepared\",\n219|  \"created_paths\": [\"/srv/provider/sessions/11111111-2222-4333-8444-555555555555\"],\n220|  \"merged_paths\": [],\n221|  \"validations\": [\n222|    {\"code\":\"native_discovery\",\"status\":\"passed\",\"detail\":\"exact session identity resolved\"}\n223|  ],\n224|  \"rollback_token\": \"YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5QUI\",\n225|  \"native_discovery\": {\n226|    \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n227|    \"discovered\": true,\n228|    \"discovery_root\": \"/srv/provider/sessions\",\n229|    \"backend_resolved\": false\n230|  }\n231|}`\n232|\n233|// mutationRequest builds a keyed mutation request with the given\n234|// operation_id and envelope request_id: the canonical bytes the\n235|// retry must reproduce or mismatch on.\n236|func mutationRequest(t *testing.T, operation, operationID, requestID string) Request {\n237|\tt.Helper()\n238|\treturn Request{\n239|\t\tOperation: Operation(operation),\n240|\t\tRequestID: mustUUIDv7(t, requestID),\n241|\t\tDeadline:  futureDeadline(t, 5*time.Minute),\n242|\t\tBody:      json.RawMessage(`{\"operation_id\":\"` + operationID + `\",\"materialization_id\":\"` + testMaterializationID + `\",\"transaction_id\":\"` + testTransactionID + `\"}`),\n243|\t}\n244|}\n245|\n246|// TestLostPrepareReturnsByteIdentical proves the PTX-LOST-PREPARE\n247|// shape through fresh processes: a lost materialize response\n248|// retried with the same (operation, operation_id) and canonical body\n249|// returns byte-identical bytes, and the runner observes two mutation\n250|// frames with equal keys.\n251|func TestLostPrepareReturnsByteIdentical(t *testing.T) {\n252|\tconst operationID = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n253|\tfirstID := testRequestID\n254|\tsecondID := testOtherID\n255|\trunner := &scriptRunner{steps: []scriptStep{\n256|\t\tokStep(Result{Stdout: frameFor(t, firstID, preparedResultBody), ExitCode: 0}),\n257|\t\tokStep(Result{Stdout: frameFor(t, secondID, preparedResultBody), ExitCode: 0}),\n258|\t}}\n259|\thost := Host{Runner: runner, Now: time.Now}\n260|\tfirstReq := mutationRequest(t, string(OpMaterialize), operationID, firstID)\n261|\tfirst, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", firstReq)\n262|\tif err != nil {\n263|\t\tt.Fatalf(\"first materialize Call: %v\", err)\n264|\t}\n265|\tsecondReq := mutationRequest(t, string(OpMaterialize), operationID, secondID)\n266|\tsecond, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", secondReq)\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"retry materialize Call: %v\", err)\n269|\t}\n270|\tif string(first.Body) != string(second.Body) {\n271|\t\tt.Fatalf(\"retry body differs:\\n%s\\n%s\", first.Body, second.Body)\n272|\t}\n273|\tkeys := mutationKeys(t, runner)\n274|\tif len(keys) != 2 || keys[0] != keys[1] {\n275|\t\tt.Fatalf(\"mutation keys = %v, want two equal keys\", keys)\n276|\t}\n277|\twant := \"(materialize, \" + operationID + \")\"\n278|\tif keys[0] != want {\n279|\t\tt.Fatalf(\"mutation key = %q, want %q\", keys[0], want)\n280|\t}\n281|}\n282|\n283|// TestChangedBodyReturnsMismatch proves the PTX-IDEMPOTENCY-N1 shape:\n284|// the same (operation, operation_id) with a changed canonical body\n285|// surfaces the bound idempotency_mismatch child, and the host sends\n286|// no third frame on its own.\n287|func TestChangedBodyReturnsMismatch(t *testing.T) {\n288|\tconst operationID = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n289|\trunner := &scriptRunner{steps: []scriptStep{\n290|\t\tokStep(Result{Stdout: frameFor(t, testRequestID, preparedResultBody), ExitCode: 0}),\n291|\t\tokStep(Result{Stdout: childFailureFrameFor(t, testOtherID, \"idempotency_mismatch\", \"retry changed the plan\"), ExitCode: 0}),\n292|\t}}\n293|\thost := Host{Runner: runner, Now: time.Now}\n294|\tfirstReq := mutationRequest(t, string(OpMaterialize), operationID, testRequestID)\n295|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", firstReq); err != nil {\n296|\t\tt.Fatalf(\"first materialize Call: %v\", err)\n297|\t}\n298|\tsecondReq := mutationRequest(t, string(OpMaterialize), operationID, testOtherID)\n299|\tsecondReq.Body = json.RawMessage(`{\"operation_id\":\"` + operationID + `\",\"materialization_id\":\"` + testMaterializationID + `\",\"transaction_id\":\"0198f4c8-0000-76dd-9677-1234567890ab\"}`)\n300|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", secondReq)\n301|\tif failureCode(t, err) != \"idempotency_mismatch\" {\n302|\t\tt.Fatalf(\"changed-body retry code = %v, want idempotency_mismatch\", err)\n303|\t}\n304|\tif runner.spawned() != 2 {\n305|\t\tt.Fatalf(\"spawned %d processes, want exactly the two sent frames\", runner.spawned())\n306|\t}\n307|\tkeys := mutationKeys(t, runner)\n308|\tif len(keys) != 2 || keys[0] != keys[1] {\n309|\t\tt.Fatalf(\"mutation keys = %v, want two equal keys\", keys)\n310|\t}\n311|}\n312|\n313|// mutationKeys extracts the (operation, operation_id) pair the host\n314|// sent on each recorded call, proving what the retry reused.\n315|func mutationKeys(t *testing.T, runner *scriptRunner) []string {\n316|\tt.Helper()\n317|\tvar keys []string\n318|\tfor _, call := range runner.calls {\n319|\t\tvar frame struct {\n320|\t\t\tOperation string `json:\"operation\"`\n321|\t\t\tBody      struct {\n322|\t\t\t\tOperationID string `json:\"operation_id\"`\n323|\t\t\t} `json:\"body\"`\n324|\t\t}\n325|\t\tif err := json.Unmarshal(call.stdin, &frame); err != nil {\n326|\t\t\tt.Fatalf(\"recorded stdin is not JSON: %v\", err)\n327|\t\t}\n328|\t\tkeys = append(keys, \"(\"+frame.Operation+\", \"+frame.Body.OperationID+\")\")\n329|\t}\n330|\treturn keys\n331|}\n332|\n333|// TestChildFailureCodesPassThrough proves the host never rewrites a\n334|// plugin failure: the normative negative codes surface with their\n335|// registered identities through Host.Call.\n336|func TestChildFailureCodesPassThrough(t *testing.T) {\n337|\tfor _, kase := range []struct {\n338|\t\tcode     string\n339|\t\texitCode int\n340|\t}{\n341|\t\t{\"capability_unavailable\", 6},\n342|\t\t{\"incompatible_schema\", 6},\n343|\t\t{\"secret_policy_violation\", 16},\n344|\t\t{\"idempotency_mismatch\", 3},\n345|\t} {\n346|\t\tt.Run(kase.code, func(t *testing.T) {\n347|\t\t\trunner := &scriptRunner{steps: []scriptStep{\n348|\t\t\t\tokStep(Result{Stdout: childFailureFrameFor(t, testRequestID, kase.code, \"plugin refused\"), ExitCode: 0}),\n349|\t\t\t}}\n350|\t\t\thost := liveHost(runner)\n351|\t\t\treq := liveRequest(t)\n352|\t\t\treq.Operation = OpMaterialize\n353|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n354|\t\t\tif failureCode(t, err) != axerror.Code(kase.code) {\n355|\t\t\t\tt.Fatalf(\"code = %v, want %s\", err, kase.code)\n356|\t\t\t}\n357|\t\t\tif failureExit(t, err) != kase.exitCode {\n358|\t\t\t\tt.Fatalf(\"exit = %d, want %d\", failureExit(t, err), kase.exitCode)\n359|\t\t\t}\n360|\t\t\tif failureObject(t, err).Retryable() {\n361|\t\t\t\tt.Fatalf(\"%s surfaces retryable\", kase.code)\n362|\t\t\t}\n363|\t\t})\n364|\t}\n365|}"}}}
