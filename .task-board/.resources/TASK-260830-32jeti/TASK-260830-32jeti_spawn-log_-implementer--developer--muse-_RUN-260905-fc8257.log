{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5df","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":330,"recorded_at":1780531400000655,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fba963571a0a2bedcd04f273d81","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/probe.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.4 Capability result: the closed\n8|// urn:ax:schema:provider-probe 1.0.0 object a probe operation returns\n9|// as its success body. It also owns the host-side availability gate:\n10|// only available MAY be enabled, and the host MUST NOT treat a\n11|// conditional, unsupported, or unknown capability as usable, no matter\n12|// what enabled claims.\n13|\n14|// probeSchema is the exact schema identifier the probe carries.\n15|const probeSchema = \"urn:ax:schema:provider-probe\"\n16|\n17|// probeSchemaVersion is the only probe version this host accepts.\n18|const probeSchemaVersion = \"1.0.0\"\n19|\n20|// Probe capability statuses Section 7.4 defines. Only Available MAY\n21|// set enabled true; every other status MUST NOT be advertised as\n22|// usable, which CapabilityUsable enforces.\n23|const (\n24|\tCapabilityAvailable   = \"available\"\n25|\tCapabilityConditional = \"conditional\"\n26|\tCapabilityUnsupported = \"unsupported\"\n27|\tCapabilityUnknown     = \"unknown\"\n28|)\n29|\n30|// probeCapabilityStatuses is the closed status vocabulary in the\n31|// Section 7.4 order.\n32|var probeCapabilityStatuses = []string{\n33|\tCapabilityAvailable,\n34|\tCapabilityConditional,\n35|\tCapabilityUnsupported,\n36|\tCapabilityUnknown,\n37|}\n38|\n39|// Probe capability evidence Section 7.4 defines, in section order.\n40|var probeCapabilityEvidence = []string{\n41|\t\"documented\",\n42|\t\"probed\",\n43|\t\"accepted_test\",\n44|\t\"provider_contract\",\n45|\t\"inferred\",\n46|\t\"acceptance_required\",\n47|\t\"none\",\n48|}\n49|\n50|// probeArchitectures is the closed architecture vocabulary.\n51|var probeArchitectures = []string{\"amd64\", \"arm64\"}\n52|\n53|// probePlatforms is the closed platform vocabulary: the four Section\n54|// 7.3 enums. WSL2 and native Windows are distinct rows; one never\n55|// stands for the other.\n56|var probePlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n57|\n58|// probeMembers is the exact required member set DecodeProbe accepts.\n59|var probeMembers = map[string]bool{\n60|\t\"schema\":           true,\n61|\t\"schema_version\":   true,\n62|\t\"provider_id\":      true,\n63|\t\"provider_version\": true,\n64|\t\"platform\":         true,\n65|\t\"architecture\":     true,\n66|\t\"capabilities\":     true,\n67|\t\"warnings\":         true,\n68|}\n69|\n70|// probeRequired lists probeMembers in a fixed order so a body missing\n71|// several members always names the same one.\n72|var probeRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"provider_id\",\n76|\t\"provider_version\",\n77|\t\"platform\",\n78|\t\"architecture\",\n79|\t\"capabilities\",\n80|\t\"warnings\",\n81|}\n82|\n83|// probeCapabilityMembers is the exact member set of one capability\n84|// value: status, enabled, evidence, and detail, nothing else.\n85|var probeCapabilityMembers = map[string]bool{\n86|\t\"status\":   true,\n87|\t\"enabled\":  true,\n88|\t\"evidence\": true,\n89|\t\"detail\":   true,\n90|}\n91|\n92|// probeCapabilityRequired lists probeCapabilityMembers in a fixed\n93|// order so a value missing several members always names the same one.\n94|var probeCapabilityRequired = []string{\"status\", \"enabled\", \"evidence\", \"detail\"}\n95|\n96|// DecodeProbe validates one probe-operation success body as the closed\n97|// Section 7.4 probe object. It returns nil on a well-formed probe and\n98|// a provider_protocol_error naming the offending member otherwise. A\n99|// capability that claims enabled under any status but available is\n100|// refused here, not at use time: an advertised-but-unusable surface\n101|// must never reach the caller as a probe result.\n102|func DecodeProbe(body []byte) error {\n103|\tmembers, fault := decodeStrictObject(body)\n104|\tif fault != nil {\n105|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n106|\t\tif err != nil {\n107|\t\t\treturn err\n108|\t\t}\n109|\t\treturn failure\n110|\t}\n111|\tif name, unknown := unknownMember(members, probeMembers); unknown {\n112|\t\tfailure, err := failProtocol(\"probe carries unknown member\", name)\n113|\t\tif err != nil {\n114|\t\t\treturn err\n115|\t\t}\n116|\t\treturn failure\n117|\t}\n118|\tif name, missing := missingMember(members, probeRequired); missing {\n119|\t\tfailure, err := failProtocol(\"probe misses a required member\", name)\n120|\t\tif err != nil {\n121|\t\t\treturn err\n122|\t\t}\n123|\t\treturn failure\n124|\t}\n125|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != probeSchema {\n126|\t\tfailure, err := failProtocol(\"probe schema is not the provider probe\", \"schema\")\n127|\t\tif err != nil {\n128|\t\t\treturn err\n129|\t\t}\n130|\t\treturn failure\n131|\t}\n132|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != probeSchemaVersion {\n133|\t\tfailure, err := failProtocol(\"probe schema_version is not 1.0.0\", \"schema_version\")\n134|\t\tif err != nil {\n135|\t\t\treturn err\n136|\t\t}\n137|\t\treturn failure\n138|\t}\n139|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n140|\t\tfailure, err := failProtocol(\"probe provider_id is not a provider id\", \"provider_id\")\n141|\t\tif err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t\treturn failure\n145|\t}\n146|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n147|\t\tfailure, err := failProtocol(\"probe provider_version is not 1..128 characters\", \"provider_version\")\n148|\t\tif err != nil {\n149|\t\t\treturn err\n150|\t\t}\n151|\t\treturn failure\n152|\t}\n153|\tif platform, ok := rawString(members[\"platform\"]); !ok || !isProbePlatform(platform) {\n154|\t\tfailure, err := failProtocol(\"probe platform is not a registry member\", \"platform\")\n155|\t\tif err != nil {\n156|\t\t\treturn err\n157|\t\t}\n158|\t\treturn failure\n159|\t}\n160|\tif architecture, ok := rawString(members[\"architecture\"]); !ok || !isProbeArchitecture(architecture) {\n161|\t\tfailure, err := failProtocol(\"probe architecture is not amd64 or arm64\", \"architecture\")\n162|\t\tif err != nil {\n163|\t\t\treturn err\n164|\t\t}\n165|\t\treturn failure\n166|\t}\n167|\tif err := checkProbeCapabilities(members[\"capabilities\"]); err != nil {\n168|\t\treturn err\n169|\t}\n170|\tif err := checkProbeWarnings(members[\"warnings\"]); err != nil {\n171|\t\treturn err\n172|\t}\n173|\treturn nil\n174|}\n175|\n176|func isProbePlatform(value string) bool {\n177|\tfor _, platform := range probePlatforms {\n178|\t\tif value == platform {\n179|\t\t\treturn true\n180|\t\t}\n181|\t}\n182|\treturn false\n183|}\n184|\n185|func isProbeArchitecture(value string) bool {\n186|\tfor _, architecture := range probeArchitectures {\n187|\t\tif value == architecture {\n188|\t\t\treturn true\n189|\t\t}\n190|\t}\n191|\treturn false\n192|}\n193|\n194|// checkProbeCapabilities requires exactly the seven registry keys,\n195|// each carrying a closed status/enabled/evidence/detail value. The\n196|// per-key loop is derived from capabilityOrder, never from a sample:\n197|// a validation that held for three capabilities and skipped the rest\n198|// would pass a probe this function must refuse.\n199|func checkProbeCapabilities(raw json.RawMessage) error {\n200|\tdecoded, fault := decodeStrictObject(raw)\n201|\tif fault != nil {\n202|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\treturn failure\n207|\t}\n208|\tfor _, name := range capabilityOrder {\n209|\t\tif _, present := decoded[name]; !present {\n210|\t\t\tfailure, err := failProtocol(\"probe capabilities miss a registry key\", \"capabilities\")\n211|\t\t\tif err != nil {\n212|\t\t\t\treturn err\n213|\t\t\t}\n214|\t\t\treturn failure\n215|\t\t}\n216|\t}\n217|\tfor name := range decoded {\n218|\t\tknown := false\n219|\t\tfor _, registry := range capabilityOrder {\n220|\t\t\tif name == registry {\n221|\t\t\t\tknown = true\n222|\t\t\t}\n223|\t\t}\n224|\t\tif !known {\n225|\t\t\tfailure, err := failProtocol(\"probe capabilities carry an unknown key\", \"capabilities\")\n226|\t\t\tif err != nil {\n227|\t\t\t\treturn err\n228|\t\t\t}\n229|\t\t\treturn failure\n230|\t\t}\n231|\t}\n232|\tfor _, name := range capabilityOrder {\n233|\t\tif err := checkProbeCapabilityValue(decoded[name]); err != nil {\n234|\t\t\treturn err\n235|\t\t}\n236|\t}\n237|\treturn nil\n238|}\n239|\n240|// checkProbeCapabilityValue validates one capability value object. The\n241|// member parameter of every refusal below is \"capabilities\": the\n242|// detail names the violated rule, and the per-key sweep in the\n243|// conformance tests proves each registry key answers to it.\n244|func checkProbeCapabilityValue(raw json.RawMessage) error {\n245|\tvalue, fault := decodeStrictObject(raw)\n246|\tif fault != nil {\n247|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n248|\t\tif err != nil {\n249|\t\t\treturn err\n250|\t\t}\n251|\t\treturn failure\n252|\t}\n253|\tif _, unknown := unknownMember(value, probeCapabilityMembers); unknown {\n254|\t\tfailure, err := failProtocol(\"probe capability carries an unknown member\", \"capabilities\")\n255|\t\tif err != nil {\n256|\t\t\treturn err\n257|\t\t}\n258|\t\treturn failure\n259|\t}\n260|\tif _, missing := missingMember(value, probeCapabilityRequired); missing {\n261|\t\tfailure, err := failProtocol(\"probe capability misses a required member\", \"capabilities\")\n262|\t\tif err != nil {\n263|\t\t\treturn err\n264|\t\t}\n265|\t\treturn failure\n266|\t}\n267|\tstatus, ok := rawString(value[\"status\"])\n268|\tif !ok || !isProbeStatus(status) {\n269|\t\tfailure, err := failProtocol(\"probe capability status is not a registry member\", \"capabilities\")\n270|\t\tif err != nil {\n271|\t\t\treturn err\n272|\t\t}\n273|\t\treturn failure\n274|\t}\n275|\tenabled, ok := rawBool(value[\"enabled\"])\n276|\tif !ok {\n277|\t\tfailure, err := failProtocol(\"probe capability enabled is not a boolean\", \"capabilities\")\n278|\t\tif err != nil {\n279|\t\t\treturn err\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\tif evidence, ok := rawString(value[\"evidence\"]); !ok || !isProbeEvidence(evidence) {\n284|\t\tfailure, err := failProtocol(\"probe capability evidence is not a registry member\", \"capabilities\")\n285|\t\tif err != nil {\n286|\t\t\treturn err\n287|\t\t}\n288|\t\treturn failure\n289|\t}\n290|\tif detail, ok := rawString(value[\"detail\"]); !ok || runeLength(detail) > 2048 {\n291|\t\tfailure, err := failProtocol(\"probe capability detail is not 0..2048 characters\", \"capabilities\")\n292|\t\tif err != nil {\n293|\t\t\treturn err\n294|\t\t}\n295|\t\treturn failure\n296|\t}\n297|\tif enabled && status != CapabilityAvailable {\n298|\t\tfailure, err := failProtocol(\"probe capability enables a non-available status\", \"capabilities\")\n299|\t\tif err != nil {\n300|\t\t\treturn err\n301|\t\t}\n302|\t\treturn failure\n303|\t}\n304|\treturn nil\n305|}\n306|\n307|func isProbeStatus(value string) bool {\n308|\tfor _, status := range probeCapabilityStatuses {\n309|\t\tif value == status {\n310|\t\t\treturn true\n311|\t\t}\n312|\t}\n313|\treturn false\n314|}\n315|\n316|func isProbeEvidence(value string) bool {\n317|\tfor _, evidence := range probeCapabilityEvidence {\n318|\t\tif value == evidence {\n319|\t\t\treturn true\n320|\t\t}\n321|\t}\n322|\treturn false\n323|}\n324|\n325|// checkProbeWarnings enforces the sorted, unique, bounded warning\n326|// array: at most 1,024 strings of at most 2,048 characters each.\n327|func checkProbeWarnings(raw json.RawMessage) error {\n328|\twarnings, ok := rawStringArray(raw)\n329|\tif !ok || len(warnings) > 1024 {\n330|\t\tfailure, err := failProtocol(\"probe warnings exceed 1024 entries\", \"warnings\")\n331|\t\tif err != nil {\n332|\t\t\treturn err\n333|\t\t}\n334|\t\treturn failure\n335|\t}\n336|\tfor _, warning := range warnings {\n337|\t\tif runeLength(warning) > 2048 {\n338|\t\t\tfailure, err := failProtocol(\"probe warning exceeds 2048 characters\", \"warnings\")\n339|\t\t\tif err != nil {\n340|\t\t\t\treturn err\n341|\t\t\t}\n342|\t\t\treturn failure\n343|\t\t}\n344|\t}\n345|\tif !sortedUniqueStrings(warnings) {\n346|\t\tfailure, err := failProtocol(\"probe warnings are not sorted unique\", \"warnings\")\n347|\t\tif err != nil {\n348|\t\t\treturn err\n349|\t\t}\n350|\t\treturn failure\n351|\t}\n352|\treturn nil\n353|}\n354|\n355|// CapabilityUsable reports whether the probe establishes the named\n356|// capability as usable: status available and enabled true. It is the\n357|// host-side reading of the Section 8 matrices: conditional,\n358|// unsupported, and unknown are never usable, however enabled reads,\n359|// and unknown MUST NOT be rewritten as unsupported — both refuse the\n360|// same way here, by returning false.\n361|func CapabilityUsable(status string, enabled bool) bool {\n362|\treturn status == CapabilityAvailable && enabled\n363|}\n364|\n365|// RequireCapability decodes one probe body and requires the named\n366|// capability usable. A malformed probe is a provider_protocol_error;\n367|// a well-formed probe that does not establish the capability is an\n368|// invalid_config caller error: the caller asked for a surface the\n369|// probe plane never proved. Either way no plugin process starts for\n370|// the gated operation.\n371|func RequireCapability(probeBody []byte, name string) error {\n372|\tif err := DecodeProbe(probeBody); err != nil {\n373|\t\treturn err\n374|\t}\n375|\tmembers, _ := decodeStrictObject(probeBody)\n376|\tcapabilities, _ := decodeStrictObject(members[\"capabilities\"])\n377|\tknown := false\n378|\tfor _, registry := range capabilityOrder {\n379|\t\tif name == registry {\n380|\t\t\tknown = true\n381|\t\t}\n382|\t}\n383|\tif !known {\n384|\t\tfailure, err := failInvalid(\"capability is not a registry member\")\n385|\t\tif err != nil {\n386|\t\t\treturn err\n387|\t\t}\n388|\t\treturn failure\n389|\t}\n390|\tvalue, _ := decodeStrictObject(capabilities[name])\n391|\tstatus, _ := rawString(value[\"status\"])\n392|\tenabled, _ := rawBool(value[\"enabled\"])\n393|\tif !CapabilityUsable(status, enabled) {\n394|\t\tfailure, err := failInvalid(\"probe does not establish the capability as available\")\n395|\t\tif err != nil {\n396|\t\t\treturn err\n397|\t\t}\n398|\t\treturn failure\n399|\t}\n400|\treturn nil\n401|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e1","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":331,"recorded_at":1780531400000657,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fba9767720381b697dd9d789e06","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/quiesce.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the SafeBoundaryProof a quiesce operation\n8|// returns as its success body (Section 7.5 row, Section 7.6 rules). A\n9|// safe proof requires empty blockers, input_blocked, foreground_idle,\n10|// background_idle true, both counts zero, and non-null boundary and\n11|// store generation. If background idleness, process exit, or store\n12|// closure cannot be proven, safe MUST be false and graceful takeover\n13|// MUST stop; the plugin MUST NOT silently convert the request. An\n14|// unsafe proof is an honest observation and validates; only a safe\n15|// claim over unproven facts is refused.\n16|\n17|// quiesceBlockers is the closed blocker enum Section 7.5 defines.\n18|var quiesceBlockers = []string{\n19|\t\"background_unproven\",\n20|\t\"child_process_open\",\n21|\t\"database_handle_open\",\n22|\t\"provider_busy\",\n23|\t\"store_unstable\",\n24|}\n25|\n26|// quiesceMembers is the exact required member set of a\n27|// SafeBoundaryProof.\n28|var quiesceMembers = map[string]bool{\n29|\t\"provider_id\":                true,\n30|\t\"provider_version\":           true,\n31|\t\"input_blocked\":              true,\n32|\t\"boundary_ref\":               true,\n33|\t\"foreground_idle\":            true,\n34|\t\"background_idle\":            true,\n35|\t\"open_child_count\":           true,\n36|\t\"open_database_handle_count\": true,\n37|\t\"store_generation\":           true,\n38|\t\"safe\":                       true,\n39|\t\"blockers\":                   true,\n40|}\n41|\n42|// quiesceRequired lists quiesceMembers in a fixed order so a proof\n43|// missing several members always names the same one.\n44|var quiesceRequired = []string{\n45|\t\"provider_id\",\n46|\t\"provider_version\",\n47|\t\"input_blocked\",\n48|\t\"boundary_ref\",\n49|\t\"foreground_idle\",\n50|\t\"background_idle\",\n51|\t\"open_child_count\",\n52|\t\"open_database_handle_count\",\n53|\t\"store_generation\",\n54|\t\"safe\",\n55|\t\"blockers\",\n56|}\n57|\n58|// DecodeQuiesceProof validates one quiesce-operation success body as a\n59|// SafeBoundaryProof. It returns the observed safe bit on an honest\n60|// proof — safe with every fact proven, or unsafe — and a\n61|// provider_protocol_error naming the offending member on any\n62|// malformed proof or any safe claim over unproven facts. The caller\n63|// stops graceful takeover on safe false; the proof itself never\n64|// converts the request.\n65|func DecodeQuiesceProof(body []byte) (bool, error) {\n66|\tmembers, fault := decodeStrictObject(body)\n67|\tif fault != nil {\n68|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n69|\t\tif err != nil {\n70|\t\t\treturn false, err\n71|\t\t}\n72|\t\treturn false, failure\n73|\t}\n74|\tif name, unknown := unknownMember(members, quiesceMembers); unknown {\n75|\t\tfailure, err := failProtocol(\"quiesce proof carries unknown member\", name)\n76|\t\tif err != nil {\n77|\t\t\treturn false, err\n78|\t\t}\n79|\t\treturn false, failure\n80|\t}\n81|\tif name, missing := missingMember(members, quiesceRequired); missing {\n82|\t\tfailure, err := failProtocol(\"quiesce proof misses a required member\", name)\n83|\t\tif err != nil {\n84|\t\t\treturn false, err\n85|\t\t}\n86|\t\treturn false, failure\n87|\t}\n88|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n89|\t\tfailure, err := failProtocol(\"quiesce provider_id is not a provider id\", \"provider_id\")\n90|\t\tif err != nil {\n91|\t\t\treturn false, err\n92|\t\t}\n93|\t\treturn false, failure\n94|\t}\n95|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n96|\t\tfailure, err := failProtocol(\"quiesce provider_version is not 1..128 characters\", \"provider_version\")\n97|\t\tif err != nil {\n98|\t\t\treturn false, err\n99|\t\t}\n100|\t\treturn false, failure\n101|\t}\n102|\tinputBlocked, ok := rawBool(members[\"input_blocked\"])\n103|\tif !ok {\n104|\t\tfailure, err := failProtocol(\"quiesce input_blocked is not a boolean\", \"input_blocked\")\n105|\t\tif err != nil {\n106|\t\t\treturn false, err\n107|\t\t}\n108|\t\treturn false, failure\n109|\t}\n110|\tforegroundIdle, ok := rawBool(members[\"foreground_idle\"])\n111|\tif !ok {\n112|\t\tfailure, err := failProtocol(\"quiesce foreground_idle is not a boolean\", \"foreground_idle\")\n113|\t\tif err != nil {\n114|\t\t\treturn false, err\n115|\t\t}\n116|\t\treturn false, failure\n117|\t}\n118|\tsafe, ok := rawBool(members[\"safe\"])\n119|\tif !ok {\n120|\t\tfailure, err := failProtocol(\"quiesce safe is not a boolean\", \"safe\")\n121|\t\tif err != nil {\n122|\t\t\treturn false, err\n123|\t\t}\n124|\t\treturn false, failure\n125|\t}\n126|\tboundaryNull, generationNull, background, backgroundNull, err := checkQuiesceNullable(members)\n127|\tif err != nil {\n128|\t\treturn false, err\n129|\t}\n130|\tchildCount, databaseCount, err := checkQuiesceCounts(members)\n131|\tif err != nil {\n132|\t\treturn false, err\n133|\t}\n134|\tblockers, err := checkQuiesceBlockers(members[\"blockers\"])\n135|\tif err != nil {\n136|\t\treturn false, err\n137|\t}\n138|\t// A safe claim over unproven facts is the one lie Section 7.6\n139|\t// names: each conjunct below carries a fixture with only it\n140|\t// violated, so narrowing any one conjunct reddens its fixture.\n141|\tif safe {\n142|\t\tif len(blockers) != 0 || !inputBlocked || !foregroundIdle || backgroundNull || !background || boundaryNull || generationNull || childCount != 0 || databaseCount != 0 {\n143|\t\t\tfailure, fault := failProtocol(\"quiesce safe proof leaves a fact unproven\", \"safe\")\n144|\t\t\tif fault != nil {\n145|\t\t\t\treturn false, fault\n146|\t\t\t}\n147|\t\t\treturn false, failure\n148|\t\t}\n149|\t}\n150|\treturn safe, nil\n151|}\n152|\n153|// rawNullableBool reads a JSON boolean-or-null member.\n154|func rawNullableBool(raw json.RawMessage) (value bool, isNull bool, ok bool) {\n155|\tif string(raw) == \"null\" {\n156|\t\treturn false, true, true\n157|\t}\n158|\tvalue, ok = rawBool(raw)\n159|\treturn value, false, ok\n160|}\n161|\n162|// checkQuiesceNullable enforces the nullability shapes outside the\n163|// safe rule: boundary_ref is string[1..1024] or null, and\n164|// store_generation is string[1..512] or null. Length is checked here\n165|// so the safe rule only decides null against non-null, and the parsed\n166|// null flags and background value are returned for that rule.\n167|func checkQuiesceNullable(members map[string]json.RawMessage) (boundaryNull bool, generationNull bool, background bool, backgroundNull bool, err error) {\n168|\tfail := func(failure error) (bool, bool, bool, bool, error) {\n169|\t\treturn false, false, false, false, failure\n170|\t}\n171|\tboundary, boundaryIsNull, ok := rawNullableString(members[\"boundary_ref\"])\n172|\tif !ok || (!boundaryIsNull && (runeLength(boundary) < 1 || runeLength(boundary) > 1024)) {\n173|\t\tfailure, fault := failProtocol(\"quiesce boundary_ref is not 1..1024 characters or null\", \"boundary_ref\")\n174|\t\tif fault != nil {\n175|\t\t\treturn fail(fault)\n176|\t\t}\n177|\t\treturn fail(failure)\n178|\t}\n179|\tgeneration, generationIsNull, ok := rawNullableString(members[\"store_generation\"])\n180|\tif !ok || (!generationIsNull && (runeLength(generation) < 1 || runeLength(generation) > 512)) {\n181|\t\tfailure, fault := failProtocol(\"quiesce store_generation is not 1..512 characters or null\", \"store_generation\")\n182|\t\tif fault != nil {\n183|\t\t\treturn fail(fault)\n184|\t\t}\n185|\t\treturn fail(failure)\n186|\t}\n187|\tbackground, backgroundNull, ok = rawNullableBool(members[\"background_idle\"])\n188|\tif !ok {\n189|\t\tfailure, fault := failProtocol(\"quiesce background_idle is not a boolean or null\", \"background_idle\")\n190|\t\tif fault != nil {\n191|\t\t\treturn fail(fault)\n192|\t\t}\n193|\t\treturn fail(failure)\n194|\t}\n195|\treturn boundaryIsNull, generationIsNull, background, backgroundNull, nil\n196|}\n197|\n198|// checkQuiesceCounts requires both handle counts as uint53 and\n199|// returns them for the safe rule: a safe proof with either count\n200|// open claims idleness it does not have.\n201|func checkQuiesceCounts(members map[string]json.RawMessage) (uint64, uint64, error) {\n202|\tcounts := make([]uint64, 0, 2)\n203|\tfor _, name := range []string{\"open_child_count\", \"open_database_handle_count\"} {\n204|\t\tcount, ok := rawUint53(members[name])\n205|\t\tif !ok {\n206|\t\t\tfailure, err := failProtocol(\"quiesce count is not a uint53\", name)\n207|\t\t\tif err != nil {\n208|\t\t\t\treturn 0, 0, err\n209|\t\t\t}\n210|\t\t\treturn 0, 0, failure\n211|\t\t}\n212|\t\tcounts = append(counts, count)\n213|\t}\n214|\treturn counts[0], counts[1], nil\n215|}\n216|\n217|// checkQuiesceBlockers requires the sorted unique closed-enum array of\n218|// at most five blockers and returns it for the safe rule.\n219|func checkQuiesceBlockers(raw json.RawMessage) ([]string, error) {\n220|\tblockers, ok := rawStringArray(raw)\n221|\tif !ok || len(blockers) > 5 {\n222|\t\tfailure, err := failProtocol(\"quiesce blockers exceed 5 entries\", \"blockers\")\n223|\t\tif err != nil {\n224|\t\t\treturn nil, err\n225|\t\t}\n226|\t\treturn nil, failure\n227|\t}\n228|\tallowed := map[string]bool{}\n229|\tfor _, blocker := range quiesceBlockers {\n230|\t\tallowed[blocker] = true\n231|\t}\n232|\tfor _, blocker := range blockers {\n233|\t\tif !allowed[blocker] {\n234|\t\t\tfailure, err := failProtocol(\"quiesce blockers name an unknown blocker\", \"blockers\")\n235|\t\t\tif err != nil {\n236|\t\t\t\treturn nil, err\n237|\t\t\t}\n238|\t\t\treturn nil, failure\n239|\t\t}\n240|\t}\n241|\tif !sortedUniqueStrings(blockers) {\n242|\t\tfailure, err := failProtocol(\"quiesce blockers are not sorted unique\", \"blockers\")\n243|\t\tif err != nil {\n244|\t\t\treturn nil, err\n245|\t\t}\n246|\t\treturn nil, failure\n247|\t}\n248|\treturn blockers, nil\n249|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e3","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":332,"recorded_at":1780531400000659,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fba986d7d529884babb89b834c3","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|\n20|// identitySchema is the exact schema identifier the record carries.\n21|const identitySchema = \"urn:ax:schema:provider-identity\"\n22|\n23|// identitySchemaVersion is the only identity version accepted.\n24|const identitySchemaVersion = \"1.0.0\"\n25|\n26|// identityKinds is the closed identity-kind enum in section order.\n27|var identityKinds = []string{\n28|\t\"session_uuid\",\n29|\t\"session_path_or_id\",\n30|\t\"backend_conversation_uuid\",\n31|\t\"task_board_managed\",\n32|\t\"provider_defined\",\n33|}\n34|\n35|// identityMembers is the exact required member set of a Provider\n36|// Identity Record.\n37|var identityMembers = map[string]bool{\n38|\t\"schema\":                    true,\n39|\t\"schema_version\":            true,\n40|\t\"record_id\":                 true,\n41|\t\"subject_id\":                true,\n42|\t\"session_id\":                true,\n43|\t\"provider_id\":               true,\n44|\t\"provider_version\":          true,\n45|\t\"provider_version_range\":    true,\n46|\t\"native_session_id\":         true,\n47|\t\"identity_kind\":             true,\n48|\t\"logical_workspace_id\":      true,\n49|\t\"backend_realm_fingerprint\": true,\n50|\t\"opaque_identity\":           true,\n51|\t\"created_by_host_id\":        true,\n52|\t\"created_at\":                true,\n53|\t\"extensions\":                true,\n54|}\n55|\n56|// identityRequired lists identityMembers in a fixed order so a record\n57|// missing several members always names the same one.\n58|var identityRequired = []string{\n59|\t\"schema\",\n60|\t\"schema_version\",\n61|\t\"record_id\",\n62|\t\"subject_id\",\n63|\t\"session_id\",\n64|\t\"provider_id\",\n65|\t\"provider_version\",\n66|\t\"provider_version_range\",\n67|\t\"native_session_id\",\n68|\t\"identity_kind\",\n69|\t\"logical_workspace_id\",\n70|\t\"backend_realm_fingerprint\",\n71|\t\"opaque_identity\",\n72|\t\"created_by_host_id\",\n73|\t\"created_at\",\n74|\t\"extensions\",\n75|}\n76|\n77|// identityKeyPattern is the provider-identity key grammar Section 5.5\n78|// states: [a-z][a-z0-9_.-]{0,63}.\n79|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n80|\n81|// windowsDrivePattern matches a Windows drive-qualified absolute\n82|// prefix: a letter, a colon, and a separator.\n83|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n84|\n85|// CheckIdentity validates one Provider Identity Record naming the\n86|// expected provider. Shape violations are provider_protocol_errors;\n87|// a well-formed record for another provider is an invalid_config\n88|// caller error: the caller correlated the wrong identity to this\n89|// session.\n90|func CheckIdentity(body []byte, wantProviderID string) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, identityRequired); missing {\n107|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n114|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n121|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n128|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tsubject, ok := rawString(members[\"subject_id\"])\n135|\tif !ok || !isUUIDv7(subject) {\n136|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n137|\t\tif err != nil {\n138|\t\t\treturn err\n139|\t\t}\n140|\t\treturn failure\n141|\t}\n142|\tsession, ok := rawString(members[\"session_id\"])\n143|\tif !ok || !isUUIDv7(session) {\n144|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n145|\t\tif err != nil {\n146|\t\t\treturn err\n147|\t\t}\n148|\t\treturn failure\n149|\t}\n150|\tif subject != session {\n151|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n152|\t\tif err != nil {\n153|\t\t\treturn err\n154|\t\t}\n155|\t\treturn failure\n156|\t}\n157|\tprovider, ok := rawString(members[\"provider_id\"])\n158|\tif !ok || !validProviderID(provider) {\n159|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\treturn failure\n164|\t}\n165|\tif provider != wantProviderID {\n166|\t\tfailure, err := failInvalid(\"identity names another provider\")\n167|\t\tif err != nil {\n168|\t\t\treturn err\n169|\t\t}\n170|\t\treturn failure\n171|\t}\n172|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n173|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n174|\t\tif err != nil {\n175|\t\t\treturn err\n176|\t\t}\n177|\t\treturn failure\n178|\t}\n179|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n180|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n187|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\treturn failure\n192|\t}\n193|\tkind, ok := rawString(members[\"identity_kind\"])\n194|\tif !ok || !isIdentityKind(kind) {\n195|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n196|\t\tif err != nil {\n197|\t\t\treturn err\n198|\t\t}\n199|\t\treturn failure\n200|\t}\n201|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n202|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\treturn failure\n207|\t}\n208|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n215|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n216|\t\tif err != nil {\n217|\t\t\treturn err\n218|\t\t}\n219|\t\treturn failure\n220|\t}\n221|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n222|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n223|\t\tif err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\treturn failure\n227|\t}\n228|\tif !isJSONObject(members[\"extensions\"]) {\n229|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n230|\t\tif err != nil {\n231|\t\t\treturn err\n232|\t\t}\n233|\t\treturn failure\n234|\t}\n235|\treturn nil\n236|}\n237|\n238|// checkIdentityRealm enforces the digest-or-null shape and the one\n239|// conditional rule Section 5.5 states: an Antigravity\n240|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n241|// because the backend realm is a resume precondition there.\n242|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n243|\trealm, isNull, ok := rawNullableString(raw)\n244|\tif !ok || (!isNull && !isDigest(realm)) {\n245|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n246|\t\tif err != nil {\n247|\t\t\treturn err\n248|\t\t}\n249|\t\treturn failure\n250|\t}\n251|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n252|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n253|\t\tif err != nil {\n254|\t\t\treturn err\n255|\t\t}\n256|\t\treturn failure\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n262|// object of at most 32 entries, keyed by the provider-identity key\n263|// grammar, with non-secret string values of 1..1,024 characters that\n264|// MUST NOT begin with an absolute path.\n265|func checkIdentityOpaque(raw json.RawMessage) error {\n266|\topaque, fault := decodeStrictObject(raw)\n267|\tif fault != nil {\n268|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n269|\t\tif err != nil {\n270|\t\t\treturn err\n271|\t\t}\n272|\t\treturn failure\n273|\t}\n274|\tif len(opaque) > 32 {\n275|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n276|\t\tif err != nil {\n277|\t\t\treturn err\n278|\t\t}\n279|\t\treturn failure\n280|\t}\n281|\tkeys := make([]string, 0, len(opaque))\n282|\tfor key := range opaque {\n283|\t\tkeys = append(keys, key)\n284|\t}\n285|\tfor _, key := range keys {\n286|\t\tif !identityKeyPattern.MatchString(key) {\n287|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n288|\t\t\tif err != nil {\n289|\t\t\t\treturn err\n290|\t\t\t}\n291|\t\t\treturn failure\n292|\t\t}\n293|\t\tvalue, ok := rawString(opaque[key])\n294|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n295|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n296|\t\t\tif err != nil {\n297|\t\t\t\treturn err\n298|\t\t\t}\n299|\t\t\treturn failure\n300|\t\t}\n301|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n302|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n303|\t\t\tif err != nil {\n304|\t\t\t\treturn err\n305|\t\t\t}\n306|\t\t\treturn failure\n307|\t\t}\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|func isIdentityKind(value string) bool {\n313|\tfor _, kind := range identityKinds {\n314|\t\tif value == kind {\n315|\t\t\treturn true\n316|\t\t}\n317|\t}\n318|\treturn false\n319|}\n320|\n321|// identifyMembers is the exact required member set of an\n322|// identify-session success body.\n323|var identifyMembers = map[string]bool{\n324|\t\"identity\":         true,\n325|\t\"confidence\":       true,\n326|\t\"matched_evidence\": true,\n327|}\n328|\n329|// identifyRequired lists identifyMembers in a fixed order.\n330|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n331|\n332|// identifyConfidences is the closed confidence vocabulary.\n333|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n334|\n335|// identifyEvidence is the closed matched-evidence vocabulary.\n336|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n337|\n338|// DecodeIdentifyResult validates one identify-session success body:\n339|// the Provider Identity Record for the expected provider, a closed\n340|// confidence, and 1..4 sorted unique matched-evidence members.\n341|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n342|\tmembers, fault := decodeStrictObject(body)\n343|\tif fault != nil {\n344|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n345|\t\tif err != nil {\n346|\t\t\treturn err\n347|\t\t}\n348|\t\treturn failure\n349|\t}\n350|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n351|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n352|\t\tif err != nil {\n353|\t\t\treturn err\n354|\t\t}\n355|\t\treturn failure\n356|\t}\n357|\tif name, missing := missingMember(members, identifyRequired); missing {\n358|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n359|\t\tif err != nil {\n360|\t\t\treturn err\n361|\t\t}\n362|\t\treturn failure\n363|\t}\n364|\tconfidence, ok := rawString(members[\"confidence\"])\n365|\tif !ok || !isIdentifyConfidence(confidence) {\n366|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n367|\t\tif err != nil {\n368|\t\t\treturn err\n369|\t\t}\n370|\t\treturn failure\n371|\t}\n372|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n373|\t\treturn err\n374|\t}\n375|\tif !isJSONObject(members[\"identity\"]) {\n376|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n377|\t\tif err != nil {\n378|\t\t\treturn err\n379|\t\t}\n380|\t\treturn failure\n381|\t}\n382|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n383|\t\treturn err\n384|\t}\n385|\treturn nil\n386|}\n387|\n388|func isIdentifyConfidence(value string) bool {\n389|\tfor _, confidence := range identifyConfidences {\n390|\t\tif value == confidence {\n391|\t\t\treturn true\n392|\t\t}\n393|\t}\n394|\treturn false\n395|}\n396|\n397|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n398|// evidence members: the observation must cite what matched, exactly\n399|// once each.\n400|func checkIdentifyEvidence(raw json.RawMessage) error {\n401|\tevidence, ok := rawStringArray(raw)\n402|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n403|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n404|\t\tif err != nil {\n405|\t\t\treturn err\n406|\t\t}\n407|\t\treturn failure\n408|\t}\n409|\tallowed := map[string]bool{}\n410|\tfor _, member := range identifyEvidence {\n411|\t\tallowed[member] = true\n412|\t}\n413|\tfor _, member := range evidence {\n414|\t\tif !allowed[member] {\n415|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n416|\t\t\tif err != nil {\n417|\t\t\t\treturn err\n418|\t\t\t}\n419|\t\t\treturn failure\n420|\t\t}\n421|\t}\n422|\tif !sortedUniqueStrings(evidence) {\n423|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n424|\t\tif err != nil {\n425|\t\t\treturn err\n426|\t\t}\n427|\t\treturn failure\n428|\t}\n429|\treturn nil\n430|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
