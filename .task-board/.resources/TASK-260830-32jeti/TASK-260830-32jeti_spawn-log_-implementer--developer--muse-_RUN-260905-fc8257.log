{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c681","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":411,"recorded_at":1780531400000817,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"8c2d4902-7063-481a-a84d-dfea22834f16"},"task_id":"8c2d4902-7063-481a-a84d-dfea22834f16","event":{"kind":"output","task_id":"8c2d4902-7063-481a-a84d-dfea22834f16","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/probe_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// specProbeExample is the Section 7.4 probe example, copied verbatim\n11|// from the pinned document. It exercises all four statuses across\n12|// the seven capabilities: available, conditional, unsupported, and\n13|// unknown, each with enabled set exactly as the contract allows.\n14|const specProbeExample = `{\n15|  \"schema\": \"urn:ax:schema:provider-probe\",\n16|  \"schema_version\": \"1.0.0\",\n17|  \"provider_id\": \"pi\",\n18|  \"provider_version\": \"0.73.1\",\n19|  \"platform\": \"macos\",\n20|  \"architecture\": \"arm64\",\n21|  \"capabilities\": {\n22|    \"native_resume\": {\n23|      \"status\": \"available\",\n24|      \"enabled\": true,\n25|      \"evidence\": \"probed\",\n26|      \"detail\": \"--session, --continue, and --resume are present\"\n27|    },\n28|    \"portable_store\": {\n29|      \"status\": \"conditional\",\n30|      \"enabled\": false,\n31|      \"evidence\": \"acceptance_required\",\n32|      \"detail\": \"closed-store cross-host fixture has not passed\"\n33|    },\n34|    \"managed_pty\": {\n35|      \"status\": \"conditional\",\n36|      \"enabled\": false,\n37|      \"evidence\": \"acceptance_required\",\n38|      \"detail\": \"platform PTY interruption and flush gate has not passed\"\n39|    },\n40|    \"appserver\": {\n41|      \"status\": \"unsupported\",\n42|      \"enabled\": false,\n43|      \"evidence\": \"provider_contract\",\n44|      \"detail\": \"Pi RPC is not claimed as the ax appserver capability\"\n45|    },\n46|    \"task_board_primary\": {\n47|      \"status\": \"unknown\",\n48|      \"enabled\": false,\n49|      \"evidence\": \"none\",\n50|      \"detail\": \"no reliable primary adapter is accepted\"\n51|    },\n52|    \"prompt_spawn\": {\n53|      \"status\": \"unknown\",\n54|      \"enabled\": false,\n55|      \"evidence\": \"none\",\n56|      \"detail\": \"not claimed for v0.3.0\"\n57|    },\n58|    \"native_goal_binding\": {\n59|      \"status\": \"unsupported\",\n60|      \"enabled\": false,\n61|      \"evidence\": \"provider_contract\",\n62|      \"detail\": \"no native task-board goal binding\"\n63|    }\n64|  },\n65|  \"warnings\": []\n66|}`\n67|\n68|// TestSpecProbeExampleDecodes proves the Section 7.4 example passes\n69|// the production entry point with every status represented.\n70|func TestSpecProbeExampleDecodes(t *testing.T) {\n71|\tif err := DecodeProbe([]byte(specProbeExample)); err != nil {\n72|\t\tt.Fatalf(\"DecodeProbe(spec example): %v\", err)\n73|\t}\n74|}\n75|\n76|// probeVariant rewrites one unique substring of the spec example.\n77|func probeVariant(t *testing.T, old, new string) []byte {\n78|\tt.Helper()\n79|\tif strings.Count(specProbeExample, old) != 1 {\n80|\t\tt.Fatalf(\"probe variant anchor %q is not unique\", old)\n81|\t}\n82|\treturn []byte(strings.Replace(specProbeExample, old, new, 1))\n83|}\n84|\n85|// probeCapabilityBlock renders one capability value with the given\n86|// status and enabled bit, for the per-key sweep.\n87|func probeCapabilityBlock(status string, enabled bool) string {\n88|\treturn `{\"status\": \"` + status + `\", \"enabled\": ` + map[bool]string{true: \"true\", false: \"false\"}[enabled] + `, \"evidence\": \"probed\", \"detail\": \"sweep\"}`\n89|}\n90|\n91|// probeWithCapabilities builds a probe whose capabilities object is\n92|// exactly the seven registry keys mapped through render. The domain\n93|// is derived from Capabilities(), never from a hand-picked sample:\n94|// every registry key answers to every rule.\n95|func probeWithCapabilities(t *testing.T, render func(name, exampleStatus string) string) []byte {\n96|\tt.Helper()\n97|\texample, fault := decodeStrictObject([]byte(specProbeExample))\n98|\tif fault != nil {\n99|\t\tt.Fatalf(\"spec probe example is not a strict object: %v\", fault.detail)\n100|\t}\n101|\tcapabilities, fault := decodeStrictObject(example[\"capabilities\"])\n102|\tif fault != nil {\n103|\t\tt.Fatalf(\"spec probe capabilities are not a strict object: %v\", fault.detail)\n104|\t}\n105|\tvar names []string\n106|\tfor _, name := range Capabilities() {\n107|\t\traw, present := capabilities[name]\n108|\t\tif !present {\n109|\t\t\tt.Fatalf(\"spec probe example misses capability %q\", name)\n110|\t\t}\n111|\t\tvar status struct {\n112|\t\t\tStatus string `json:\"status\"`\n113|\t\t}\n114|\t\tif err := json.Unmarshal(raw, &status); err != nil {\n115|\t\t\tt.Fatalf(\"spec probe capability %q status: %v\", name, err)\n116|\t\t}\n117|\t\tnames = append(names, `\"`+name+`\": `+render(name, status.Status))\n118|\t}\n119|\tstart := strings.Index(specProbeExample, `\"native_resume\": {`)\n120|\tend := strings.Index(specProbeExample, `  },\n121|  \"warnings\"`)\n122|\tif start < 0 || end <= start {\n123|\t\tt.Fatal(\"spec probe example capabilities block not found; the sweep is blind\")\n124|\t}\n125|\treturn []byte(specProbeExample[:start] + strings.Join(names, \",\\n    \") + \"\\n    \" + specProbeExample[end:])\n126|}\n127|\n128|// TestDecodeProbeRefusals drives every probe rule with a fixture\n129|// carrying only that violation.\n130|func TestDecodeProbeRefusals(t *testing.T) {\n131|\tlong2048 := strings.Repeat(\"w\", 2048)\n132|\tlong2049 := strings.Repeat(\"w\", 2049)\n133|\trows := []struct {\n134|\t\tname   string\n135|\t\tbody   []byte\n136|\t\tmember string\n137|\t\tdetail string\n138|\t}{\n139|\t\t{\"unknown member\", probeVariant(t, `\"warnings\": []`, `\"warnings\": [], \"diagnostics\": []`), \"diagnostics\", \"unknown member\"},\n140|\t\t{\"missing member\", []byte(strings.Replace(specProbeExample, `,\n141|  \"warnings\": []`, ``, 1)), \"warnings\", \"misses a required member\"},\n142|\t\t{\"wrong schema\", probeVariant(t, `\"urn:ax:schema:provider-probe\"`, `\"urn:ax:schema:provider-manifest\"`), \"schema\", \"not the provider probe\"},\n143|\t\t{\"wrong schema version\", probeVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"1.1.0\"`), \"schema_version\", \"not 1.0.0\"},\n144|\t\t{\"bad provider id\", probeVariant(t, `\"provider_id\": \"pi\"`, `\"provider_id\": \"7pi\"`), \"provider_id\", \"not a provider id\"},\n145|\t\t{\"empty provider version\", probeVariant(t, `\"provider_version\": \"0.73.1\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n146|\t\t{\"bad platform\", probeVariant(t, `\"platform\": \"macos\"`, `\"platform\": \"darwin\"`), \"platform\", \"not a registry member\"},\n147|\t\t{\"bad architecture\", probeVariant(t, `\"architecture\": \"arm64\"`, `\"architecture\": \"x86\"`), \"architecture\", \"not amd64 or arm64\"},\n148|\t\t{\"capabilities missing key\", []byte(strings.Replace(specProbeExample, `    \"prompt_spawn\": {\n149|      \"status\": \"unknown\",\n150|      \"enabled\": false,\n151|      \"evidence\": \"none\",\n152|      \"detail\": \"not claimed for v0.3.0\"\n153|    },\n154|`, ``, 1)), \"capabilities\", \"miss a registry key\"},\n155|\t\t{\"capabilities unknown key\", probeVariant(t, \"    }\\n  },\\n  \\\"warnings\\\": []\", \"    },\\n    \\\"remote_exec\\\": {\\n      \\\"status\\\": \\\"available\\\",\\n      \\\"enabled\\\": true,\\n      \\\"evidence\\\": \\\"probed\\\",\\n      \\\"detail\\\": \\\"x\\\"\\n    }\\n  },\\n  \\\"warnings\\\": []\"), \"capabilities\", \"unknown key\"},\n156|\t\t{\"capability unknown member\", probeVariant(t, `\"detail\": \"not claimed for v0.3.0\"`, `\"detail\": \"not claimed for v0.3.0\", \"score\": 1`), \"capabilities\", \"unknown member\"},\n157|\t\t{\"capability missing member\", []byte(strings.Replace(specProbeExample, `      \"evidence\": \"none\",\n158|`, ``, 1)), \"capabilities\", \"misses a required member\"},\n159|\t\t{\"capability bad status\", probeVariant(t, `\"status\": \"unknown\",\n160|      \"enabled\": false,\n161|      \"evidence\": \"none\",\n162|      \"detail\": \"not claimed for v0.3.0\"`, `\"status\": \"sometimes\",\n163|      \"enabled\": false,\n164|      \"evidence\": \"none\",\n165|      \"detail\": \"not claimed for v0.3.0\"`), \"capabilities\", \"status is not a registry member\"},\n166|\t\t{\"capability non-boolean enabled\", probeVariant(t, `\"status\": \"available\",\n167|      \"enabled\": true,`, `\"status\": \"available\",\n168|      \"enabled\": \"yes\",`), \"capabilities\", \"enabled is not a boolean\"},\n169|\t\t{\"capability bad evidence\", probeVariant(t, `\"evidence\": \"probed\",`, `\"evidence\": \"vibes\",`), \"capabilities\", \"evidence is not a registry member\"},\n170|\t\t{\"capability long detail\", probeVariant(t, `\"detail\": \"--session, --continue, and --resume are present\"`, `\"detail\": \"`+long2049+`\"`), \"capabilities\", \"not 0..2048 characters\"},\n171|\t}\n172|\tfor _, row := range rows {\n173|\t\tt.Run(row.name, func(t *testing.T) {\n174|\t\t\terr := DecodeProbe(row.body)\n175|\t\t\trequireFrameRefusal(t, err, row.member, row.detail)\n176|\t\t})\n177|\t}\n178|\tif err := DecodeProbe(probeVariant(t, `\"detail\": \"--session, --continue, and --resume are present\"`, `\"detail\": \"`+long2048+`\"`)); err != nil {\n179|\t\tt.Fatalf(\"2048-character detail refused: %v\", err)\n180|\t}\n181|}\n182|\n183|// TestDecodeProbeWarnings proves the warning-array bounds exactly:\n184|// 1,024 sorted unique entries pass, 1,025 are refused, and order and\n185|// duplication are refused independently of length.\n186|func TestDecodeProbeWarnings(t *testing.T) {\n187|\tsorted := make([]string, 0, 1024)\n188|\tfor i := 0; i < 1024; i++ {\n189|\t\tsorted = append(sorted, fmt.Sprintf(\"w-%04d\", i))\n190|\t}\n191|\tencode := func(warnings []string) []byte {\n192|\t\traw, err := json.Marshal(warnings)\n193|\t\tif err != nil {\n194|\t\t\tt.Fatalf(\"marshal warnings: %v\", err)\n195|\t\t}\n196|\t\treturn probeVariant(t, `\"warnings\": []`, `\"warnings\": `+string(raw))\n197|\t}\n198|\tif err := DecodeProbe(encode(sorted)); err != nil {\n199|\t\tt.Fatalf(\"1024 sorted warnings refused: %v\", err)\n200|\t}\n201|\trequireFrameRefusal(t, DecodeProbe(encode(append(sorted, \"w-last\"))), \"warnings\", \"exceed 1024 entries\")\n202|\trequireFrameRefusal(t, DecodeProbe(encode([]string{\"b\", \"a\"})), \"warnings\", \"not sorted unique\")\n203|\trequireFrameRefusal(t, DecodeProbe(encode([]string{\"a\", \"a\"})), \"warnings\", \"not sorted unique\")\n204|\trequireFrameRefusal(t, DecodeProbe(probeVariant(t, `\"warnings\": []`, `\"warnings\": [\"`+strings.Repeat(\"w\", 2049)+`\"]`)), \"warnings\", \"exceeds 2048 characters\")\n205|}\n206|\n207|// TestDecodeProbeEnabledRequiresAvailable sweeps the full\n208|// status-by-enabled domain for one capability: only\n209|// available+true validates. The sweep is the complement the\n210|// sibling story's harness missed by sampling: 4 statuses times 2\n211|// enabled values, all 8 measured.\n212|func TestDecodeProbeEnabledRequiresAvailable(t *testing.T) {\n213|\tfor _, status := range []string{\"available\", \"conditional\", \"unsupported\", \"unknown\"} {\n214|\t\tfor _, enabled := range []bool{false, true} {\n215|\t\t\tstatus, enabled := status, enabled\n216|\t\t\tname := fmt.Sprintf(\"%s enabled=%v\", status, enabled)\n217|\t\t\tt.Run(name, func(t *testing.T) {\n218|\t\t\t\tbody := probeWithCapabilities(t, func(name, _ string) string {\n219|\t\t\t\t\tif name == \"native_resume\" {\n220|\t\t\t\t\t\treturn probeCapabilityBlock(status, enabled)\n221|\t\t\t\t\t}\n222|\t\t\t\t\treturn probeCapabilityBlock(\"unsupported\", false)\n223|\t\t\t\t})\n224|\t\t\t\terr := DecodeProbe(body)\n225|\t\t\t\tif status == \"available\" && enabled {\n226|\t\t\t\t\tif err != nil {\n227|\t\t\t\t\t\tt.Fatalf(\"available+enabled refused: %v\", err)\n228|\t\t\t\t\t}\n229|\t\t\t\t\treturn\n230|\t\t\t\t}\n231|\t\t\t\tif status != \"available\" && enabled {\n232|\t\t\t\t\trequireFrameRefusal(t, err, \"capabilities\", \"enables a non-available status\")\n233|\t\t\t\t\treturn\n234|\t\t\t\t}\n235|\t\t\t\tif err != nil {\n236|\t\t\t\t\tt.Fatalf(\"%s enabled=%v refused: %v\", status, enabled, err)\n237|\t\t\t\t}\n238|\t\t\t})\n239|\t\t}\n240|\t}\n241|}\n242|\n243|// TestDecodeProbeSweepsEveryCapabilityKey proves the capability\n244|// rules answer per key, not per sample: each registry key carries\n245|// the enabled-non-available violation in turn, and every turn is\n246|// refused. A validation narrowed to the keys the hand-written\n247|// fixtures touch would pass six of these seven turns.\n248|func TestDecodeProbeSweepsEveryCapabilityKey(t *testing.T) {\n249|\tfor _, key := range Capabilities() {\n250|\t\tkey := key\n251|\t\tt.Run(key, func(t *testing.T) {\n252|\t\t\tbody := probeWithCapabilities(t, func(name, _ string) string {\n253|\t\t\t\tif name == key {\n254|\t\t\t\t\treturn probeCapabilityBlock(\"conditional\", true)\n255|\t\t\t\t}\n256|\t\t\t\treturn probeCapabilityBlock(\"unsupported\", false)\n257|\t\t\t})\n258|\t\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"enables a non-available status\")\n259|\t\t})\n260|\t}\n261|\tt.Logf(\"capability key coverage: %d/%d registry keys swept\", len(Capabilities()), len(Capabilities()))\n262|}\n263|\n264|// TestCapabilityUsableIsDerivedFromStatus sweeps the pure gate over\n265|// the same 8-cell domain: usable exactly for available+true.\n266|func TestCapabilityUsableIsDerivedFromStatus(t *testing.T) {\n267|\tfor _, status := range []string{\"available\", \"conditional\", \"unsupported\", \"unknown\"} {\n268|\t\tfor _, enabled := range []bool{false, true} {\n269|\t\t\twant := status == \"available\" && enabled\n270|\t\t\tif got := CapabilityUsable(status, enabled); got != want {\n271|\t\t\t\tt.Fatalf(\"CapabilityUsable(%q, %v) = %v, want %v\", status, enabled, got, want)\n272|\t\t\t}\n273|\t\t}\n274|\t}\n275|}\n276|\n277|// TestRequireCapabilityRefusesUnproven Surfaces proves the host-side\n278|// gate: the spec example establishes native_resume only, so every\n279|// other registry key is refused without starting a process, and an\n280|// unknown name is refused as a caller error.\n281|func TestRequireCapabilityRefusesUnprovenSurfaces(t *testing.T) {\n282|\tif err := RequireCapability([]byte(specProbeExample), \"native_resume\"); err != nil {\n283|\t\tt.Fatalf(\"RequireCapability(native_resume): %v\", err)\n284|\t}\n285|\trefused := 0\n286|\tfor _, name := range Capabilities() {\n287|\t\tif name == \"native_resume\" {\n288|\t\t\tcontinue\n289|\t\t}\n290|\t\terr := RequireCapability([]byte(specProbeExample), name)\n291|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"does not establish the capability\")\n292|\t\trefused++\n293|\t}\n294|\tif refused != len(Capabilities())-1 {\n295|\t\tt.Fatalf(\"refused %d capabilities, want %d\", refused, len(Capabilities())-1)\n296|\t}\n297|\trequireLocalRefusal(t, RequireCapability([]byte(specProbeExample), \"remote_exec\"), \"invalid_config\", \"not a registry member\")\n298|\trequireFrameRefusal(t, RequireCapability([]byte(`{\"schema\":\"x\"}`), \"native_resume\"), \"schema_version\", \"misses a required member\")\n299|\tt.Logf(\"capability gate coverage: 1 usable, %d refused of %d registry keys\", refused, len(Capabilities()))\n300|}"}}}
