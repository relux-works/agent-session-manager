{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c1","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":571,"recorded_at":1780531400001137,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"8e038192-8c4b-4092-839c-0ed14ce60d76"},"task_id":"8e038192-8c4b-4092-839c-0ed14ce60d76","event":{"kind":"output","task_id":"8e038192-8c4b-4092-839c-0ed14ce60d76","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/idempotency_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// TestMutationOperationsAreDerivedFromSpec proves the keyed set is\n12|// exactly the Section 7.5 operations whose request bodies carry\n13|// operation_id: each table row is re-read from the pinned document\n14|// and checked for the mutation key, so a registry row gaining or\n15|// losing operation_id reddens here rather than passing silently.\n16|func TestMutationOperationsAreDerivedFromSpec(t *testing.T) {\n17|\tdocument, err := specdoc.Load()\n18|\tif err != nil {\n19|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n20|\t}\n21|\tvar derived []string\n22|\tfor line := 3072; line <= 3086; line++ {\n23|\t\trow, ok := document.TableRowAt(line)\n24|\t\tif !ok {\n25|\t\t\tcontinue\n26|\t\t}\n27|\t\ttext, ok := document.Line(line)\n28|\t\tif !ok {\n29|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n30|\t\t}\n31|\t\tsection, ok := document.SectionID(line)\n32|\t\tif !ok || section != \"7.5\" {\n33|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, section, \"7.5\")\n34|\t\t}\n35|\t\tif strings.Contains(text, \"operation_id\") {\n36|\t\t\tderived = append(derived, row.Identifier)\n37|\t\t}\n38|\t}\n39|\tif len(derived) == 0 {\n40|\t\tt.Fatal(\"derived no keyed operations from the Section 7.5 table; the check is blind\")\n41|\t}\n42|\tvar got []string\n43|\tfor _, operation := range MutationOperations() {\n44|\t\tgot = append(got, string(operation))\n45|\t}\n46|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n47|\t\tt.Fatalf(\"MutationOperations() = %v, want the Section 7.5 keyed rows %v\", got, derived)\n48|\t}\n49|\tt.Logf(\"idempotency key coverage: %d/%d Section 7.5 operations carry the key\", len(got), len(Operations()))\n50|}\n51|\n52|// TestIdempotencyKeyForIssuesKeys proves the sole key issues for\n53|// every keyed operation and renders in the Section 7.5\n54|// (operation, operation_id) form with its seats exposed.\n55|func TestIdempotencyKeyForIssuesKeys(t *testing.T) {\n56|\tfor _, operation := range MutationOperations() {\n57|\t\tkey, err := IdempotencyKeyFor(operation, testRequestID)\n58|\t\tif err != nil {\n59|\t\t\tt.Fatalf(\"IdempotencyKeyFor(%q): %v\", operation, err)\n60|\t\t}\n61|\t\tif key.Operation() != operation {\n62|\t\t\tt.Fatalf(\"key.Operation() = %q, want %q\", key.Operation(), operation)\n63|\t\t}\n64|\t\tif key.OperationID() != testRequestID {\n65|\t\t\tt.Fatalf(\"key.OperationID() = %q, want %q\", key.OperationID(), testRequestID)\n66|\t\t}\n67|\t\twant := \"(\" + string(operation) + \", \" + testRequestID + \")\"\n68|\t\tif key.String() != want {\n69|\t\t\tt.Fatalf(\"key.String() = %q, want %q\", key.String(), want)\n70|\t\t}\n71|\t}\n72|}\n73|\n74|// TestIdempotencyKeyForRefusesUnkeyed sweeps the complement derived\n75|// from the registry: every operation outside the keyed set is\n76|// refused, plus the unknown operation and the malformed operation\n77|// ID. Reusing one operation_id across distinct tags issues distinct\n78|// keys — no aliasing — which the sweep asserts by issuing the same\n79|// ID under two tags and comparing.\n80|func TestIdempotencyKeyForRefusesUnkeyed(t *testing.T) {\n81|\tkeyed := map[string]bool{}\n82|\tfor _, operation := range MutationOperations() {\n83|\t\tkeyed[string(operation)] = true\n84|\t}\n85|\tunkeyed := 0\n86|\tfor _, name := range Operations() {\n87|\t\tif keyed[name] {\n88|\t\t\tcontinue\n89|\t\t}\n90|\t\tunkeyed++\n91|\t\t_, err := IdempotencyKeyFor(Operation(name), testRequestID)\n92|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"without operation_id\")\n93|\t}\n94|\tif unkeyed != len(Operations())-len(MutationOperations()) {\n95|\t\tt.Fatalf(\"swept %d unkeyed operations, want %d\", unkeyed, len(Operations())-len(MutationOperations()))\n96|\t}\n97|\t_, err := IdempotencyKeyFor(Operation(\"reboot\"), testRequestID)\n98|\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n99|\tfor _, badID := range []string{\"\", \"not-a-uuid\", testDeadline} {\n100|\t\t_, err := IdempotencyKeyFor(OpMaterialize, badID)\n101|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"not a UUIDv7\")\n102|\t}\n103|\tfirst, err := IdempotencyKeyFor(OpMaterialize, testRequestID)\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"IdempotencyKeyFor(materialize): %v\", err)\n106|\t}\n107|\tsecond, err := IdempotencyKeyFor(OpMaterializeCommit, testRequestID)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"IdempotencyKeyFor(materialize-commit): %v\", err)\n110|\t}\n111|\tif first.String() == second.String() {\n112|\t\tt.Fatalf(\"keys alias across tags: %q\", first.String())\n113|\t}\n114|\tt.Logf(\"idempotency refusal coverage: %d unkeyed operations refused\", unkeyed)\n115|}"}}}
