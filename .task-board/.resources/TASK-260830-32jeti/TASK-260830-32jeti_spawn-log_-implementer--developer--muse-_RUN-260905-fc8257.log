{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c78b","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":544,"recorded_at":1780531400001083,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"d0181682-8a69-464a-a5f6-9f307e1aacbc"},"task_id":"d0181682-8a69-464a-a5f6-9f307e1aacbc","event":{"kind":"output","task_id":"d0181682-8a69-464a-a5f6-9f307e1aacbc","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/idempotency.go`.\n1|package provhost\n2|\n3|// This file owns the single Provider protocol 2.0.0 idempotency key\n4|// (operation, operation_id). Every provider mutation request that\n5|// carries operation_id uses this key and no other: an identical\n6|// canonical mutation request MUST return a byte-identical result\n7|// across a fresh plugin process, and any changed member is\n8|// idempotency_mismatch with no new mutation. There is no second\n9|// tuple- or path-based key in provider protocol 2.0.0, so this file\n10|// defines exactly one key type and exactly one keyed-operation set.\n11|\n12|// keyedOperations lists the operations whose request bodies carry\n13|// operation_id in the Section 7.5 registry: the four materialization\n14|// mutations plus fork, whose operation ID is the Session Record's\n15|// fork_provenance.operation_id. Fork is side-effect-free, but an\n16|// identical retry still returns the same plan and a changed body is\n17|// still idempotency_mismatch, so it carries the key. Status reads\n18|// omit operation_id by construction and are evolving reads, never\n19|// receipts.\n20|var keyedOperations = []Operation{\n21|\tOpCapture,\n22|\tOpMaterialize,\n23|\tOpMaterializeCommit,\n24|\tOpMaterializeRollback,\n25|\tOpFork,\n26|}\n27|\n28|// MutationOperations returns the operations keyed by\n29|// (operation, operation_id), in registry order. The result is a copy;\n30|// the set cannot be mutated through it.\n31|func MutationOperations() []Operation {\n32|\treturn append([]Operation(nil), keyedOperations...)\n33|}\n34|\n35|// isKeyedOperation reports whether the operation carries an\n36|// operation_id mutation key.\n37|func isKeyedOperation(operation Operation) bool {\n38|\tfor _, keyed := range keyedOperations {\n39|\t\tif operation == keyed {\n40|\t\t\treturn true\n41|\t\t}\n42|\t}\n43|\treturn false\n44|}\n45|\n46|// IdempotencyKey is the sole provider mutation deduplication key:\n47|// the operation tag plus the caller-supplied operation ID. One\n48|// operation ID used by the materialize family identifies exactly one\n49|// materialization transaction, and reusing the mutation value across\n50|// distinct operation tags does not alias their recorded results,\n51|// because the tag is part of the key.\n52|type IdempotencyKey struct {\n53|\toperation   Operation\n54|\toperationID string\n55|}\n56|\n57|// Operation reports the mutation tag the key was issued for.\n58|func (key IdempotencyKey) Operation() Operation {\n59|\treturn key.operation\n60|}\n61|\n62|// OperationID reports the caller-supplied operation ID the key was\n63|// issued for.\n64|func (key IdempotencyKey) OperationID() string {\n65|\treturn key.operationID\n66|}\n67|\n68|// String renders the key in the Section 7.5 (operation,\n69|// operation_id) form.\n70|func (key IdempotencyKey) String() string {\n71|\treturn \"(\" + string(key.operation) + \", \" + key.operationID + \")\"\n72|}\n73|\n74|// IdempotencyKeyFor issues the mutation key for one operation tag and\n75|// one caller-supplied operation ID. An unknown operation, an\n76|// operation that carries no operation_id, and a non-UUIDv7 operation\n77|// ID are invalid_config caller errors: a retry under a forged,\n78|// mistagged, or unkeyed identity is not a retry at all.\n79|func IdempotencyKeyFor(operation Operation, operationID string) (IdempotencyKey, error) {\n80|\tif !validOperation(string(operation)) {\n81|\t\tfailure, err := failInvalid(\"idempotency key names an unknown operation\")\n82|\t\tif err != nil {\n83|\t\t\treturn IdempotencyKey{}, err\n84|\t\t}\n85|\t\treturn IdempotencyKey{}, failure\n86|\t}\n87|\tif !isKeyedOperation(operation) {\n88|\t\tfailure, err := failInvalid(\"idempotency key names an operation without operation_id\")\n89|\t\tif err != nil {\n90|\t\t\treturn IdempotencyKey{}, err\n91|\t\t}\n92|\t\treturn IdempotencyKey{}, failure\n93|\t}\n94|\tif !isUUIDv7(operationID) {\n95|\t\tfailure, err := failInvalid(\"idempotency operation_id is not a UUIDv7\")\n96|\t\tif err != nil {\n97|\t\t\treturn IdempotencyKey{}, err\n98|\t\t}\n99|\t\treturn IdempotencyKey{}, failure\n100|\t}\n101|\treturn IdempotencyKey{operation: operation, operationID: operationID}, nil\n102|}"}}}
