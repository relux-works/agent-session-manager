{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c9","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":575,"recorded_at":1780531400001145,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fbbd4ed7293a181049aff5b1f11","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/idempotency_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// TestMutationOperationsAreDerivedFromSpec proves the keyed set is\n12|// exactly the Section 7.5 operations whose request bodies carry\n13|// operation_id: each table row is re-read from the pinned document\n14|// and checked for the mutation key, so a registry row gaining or\n15|// losing operation_id reddens here rather than passing silently.\n16|func TestMutationOperationsAreDerivedFromSpec(t *testing.T) {\n17|\tdocument, err := specdoc.Load()\n18|\tif err != nil {\n19|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n20|\t}\n21|\tvar derived []string\n22|\tfor line := 3072; line <= 3086; line++ {\n23|\t\trow, ok := document.TableRowAt(line)\n24|\t\tif !ok {\n25|\t\t\tcontinue\n26|\t\t}\n27|\t\ttext, ok := document.Line(line)\n28|\t\tif !ok {\n29|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n30|\t\t}\n31|\t\tsection, ok := document.SectionID(line)\n32|\t\tif !ok || section != \"7.5\" {\n33|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, section, \"7.5\")\n34|\t\t}\n35|\t\tif strings.Contains(text, \"operation_id\") {\n36|\t\t\tderived = append(derived, row.Identifier)\n37|\t\t}\n38|\t}\n39|\tif len(derived) == 0 {\n40|\t\tt.Fatal(\"derived no keyed operations from the Section 7.5 table; the check is blind\")\n41|\t}\n42|\tvar got []string\n43|\tfor _, operation := range MutationOperations() {\n44|\t\tgot = append(got, string(operation))\n45|\t}\n46|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n47|\t\tt.Fatalf(\"MutationOperations() = %v, want the Section 7.5 keyed rows %v\", got, derived)\n48|\t}\n49|\tt.Logf(\"idempotency key coverage: %d/%d Section 7.5 operations carry the key\", len(got), len(Operations()))\n50|}\n51|\n52|// TestIdempotencyKeyForIssuesKeys proves the sole key issues for\n53|// every keyed operation and renders in the Section 7.5\n54|// (operation, operation_id) form with its seats exposed.\n55|func TestIdempotencyKeyForIssuesKeys(t *testing.T) {\n56|\tfor _, operation := range MutationOperations() {\n57|\t\tkey, err := IdempotencyKeyFor(operation, testRequestID)\n58|\t\tif err != nil {\n59|\t\t\tt.Fatalf(\"IdempotencyKeyFor(%q): %v\", operation, err)\n60|\t\t}\n61|\t\tif key.Operation() != operation {\n62|\t\t\tt.Fatalf(\"key.Operation() = %q, want %q\", key.Operation(), operation)\n63|\t\t}\n64|\t\tif key.OperationID() != testRequestID {\n65|\t\t\tt.Fatalf(\"key.OperationID() = %q, want %q\", key.OperationID(), testRequestID)\n66|\t\t}\n67|\t\twant := \"(\" + string(operation) + \", \" + testRequestID + \")\"\n68|\t\tif key.String() != want {\n69|\t\t\tt.Fatalf(\"key.String() = %q, want %q\", key.String(), want)\n70|\t\t}\n71|\t}\n72|}\n73|\n74|// TestIdempotencyKeyForRefusesUnkeyed sweeps the complement derived\n75|// from the registry: every operation outside the keyed set is\n76|// refused, plus the unknown operation and the malformed operation\n77|// ID. Reusing one operation_id across distinct tags issues distinct\n78|// keys — no aliasing — which the sweep asserts by issuing the same\n79|// ID under two tags and comparing.\n80|func TestIdempotencyKeyForRefusesUnkeyed(t *testing.T) {\n81|\tkeyed := map[string]bool{}\n82|\tfor _, operation := range MutationOperations() {\n83|\t\tkeyed[string(operation)] = true\n84|\t}\n85|\tunkeyed := 0\n86|\tfor _, name := range Operations() {\n87|\t\tif keyed[name] {\n88|\t\t\tcontinue\n89|\t\t}\n90|\t\tunkeyed++\n91|\t\t_, err := IdempotencyKeyFor(Operation(name), testRequestID)\n92|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"without operation_id\")\n93|\t}\n94|\tif unkeyed != len(Operations())-len(MutationOperations()) {\n95|\t\tt.Fatalf(\"swept %d unkeyed operations, want %d\", unkeyed, len(Operations())-len(MutationOperations()))\n96|\t}\n97|\t_, err := IdempotencyKeyFor(Operation(\"reboot\"), testRequestID)\n98|\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n99|\tfor _, badID := range []string{\"\", \"not-a-uuid\", testDeadline} {\n100|\t\t_, err := IdempotencyKeyFor(OpMaterialize, badID)\n101|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"not a UUIDv7\")\n102|\t}\n103|\tfirst, err := IdempotencyKeyFor(OpMaterialize, testRequestID)\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"IdempotencyKeyFor(materialize): %v\", err)\n106|\t}\n107|\tsecond, err := IdempotencyKeyFor(OpMaterializeCommit, testRequestID)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"IdempotencyKeyFor(materialize-commit): %v\", err)\n110|\t}\n111|\tif first.String() == second.String() {\n112|\t\tt.Fatalf(\"keys alias across tags: %q\", first.String())\n113|\t}\n114|\tt.Logf(\"idempotency refusal coverage: %d unkeyed operations refused\", unkeyed)\n115|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7cb","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":576,"recorded_at":1780531400001147,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fbbd5d676e38a8b26f8f1cb788e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/profile_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n8|)\n9|\n10|// TestProfileMappingMatchesSection77 sweeps the full provider-by-\n11|// profile domain: six providers times two profiles, all twelve\n12|// measured. Yolo returns the exact adapter flag; standard returns\n13|// the empty omission for every provider, including Pi, whose yolo\n14|// and standard resolve to the same disclosed tool set rather than a\n15|// flag.\n16|func TestProfileMappingMatchesSection77(t *testing.T) {\n17|\twantYOLO := map[string]string{\n18|\t\t\"codex\":       \"--dangerously-bypass-approvals-and-sandbox\",\n19|\t\t\"claude\":      \"--dangerously-skip-permissions\",\n20|\t\t\"gemini\":      \"--approval-mode=yolo\",\n21|\t\t\"muse\":        \"--yolo\",\n22|\t\t\"antigravity\": \"--dangerously-skip-permissions\",\n23|\t\t\"pi\":          \"default_unrestricted_tool_set\",\n24|\t}\n25|\tif len(profileProviders) != len(wantYOLO) {\n26|\t\tt.Fatalf(\"profileProviders holds %d providers, want %d\", len(profileProviders), len(wantYOLO))\n27|\t}\n28|\tfor _, provider := range profileProviders {\n29|\t\twant, ok := wantYOLO[provider]\n30|\t\tif !ok {\n31|\t\t\tt.Fatalf(\"provider %q has no pinned yolo mapping; the sweep is blind\", provider)\n32|\t\t}\n33|\t\tgot, err := ProfileMapping(provider, ProfileYOLO)\n34|\t\tif err != nil {\n35|\t\t\tt.Fatalf(\"ProfileMapping(%q, yolo): %v\", provider, err)\n36|\t\t}\n37|\t\tif got != want {\n38|\t\t\tt.Fatalf(\"ProfileMapping(%q, yolo) = %q, want %q\", provider, got, want)\n39|\t\t}\n40|\t\tgot, err = ProfileMapping(provider, ProfileStandard)\n41|\t\tif err != nil {\n42|\t\t\tt.Fatalf(\"ProfileMapping(%q, standard): %v\", provider, err)\n43|\t\t}\n44|\t\tif got != \"\" {\n45|\t\t\tt.Fatalf(\"ProfileMapping(%q, standard) = %q, want the empty omission\", provider, got)\n46|\t\t}\n47|\t}\n48|\tt.Logf(\"profile mapping coverage: %d providers x 2 profiles measured\", len(profileProviders))\n49|}\n50|\n51|// TestProfileMappingRefusesUnknowns proves the fail-closed side:\n52|// unknown providers, unknown profiles, and empties are refused, never\n53|// defaulted. The provider near-misses derive from the registry by\n54|// case, affix, and truncation; the open-ended complement beyond them\n55|// is refused by construction (map miss) and witnessed here.\n56|func TestProfileMappingRefusesUnknowns(t *testing.T) {\n57|\tfor _, provider := range []string{\"\", \"Codex\", \"codex \", \" codex\", \"codexx\", \"cod\", \"qwen\", \"future\"} {\n58|\t\trequireLocalRefusal(t, mustProfileMapping(t, provider, true), \"invalid_config\", \"unknown provider\")\n59|\t}\n60|\tfor _, profile := range []string{\"\", \"YOLO\", \"yolo \", \"unrestricted\", \"standard-yolo\"} {\n61|\t\trequireLocalRefusal(t, mustProfileMapping(t, profile, false), \"invalid_config\", \"unknown profile\")\n62|\t}\n63|}\n64|\n65|// mustProfileMapping calls ProfileMapping with the unknown in the\n66|// provider seat (providerSeat true) or the profile seat.\n67|func mustProfileMapping(t *testing.T, unknown string, providerSeat bool) error {\n68|\tt.Helper()\n69|\tif providerSeat {\n70|\t\t_, err := ProfileMapping(unknown, ProfileYOLO)\n71|\t\treturn err\n72|\t}\n73|\t_, err := ProfileMapping(\"codex\", unknown)\n74|\treturn err\n75|}\n76|\n77|// TestProfileMappingIsPinnedToSection77 proves the table this file\n78|// transcribes: six provider rows in the Section 7.7 window, and every\n79|// yolo flag quoted verbatim from the pinned document.\n80|func TestProfileMappingIsPinnedToSection77(t *testing.T) {\n81|\tdocument, err := specdoc.Load()\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n84|\t}\n85|\twindow := sectionLines(t, document, \"7.7\", 3429, 3436)\n86|\trows := 0\n87|\tfor _, line := range strings.Split(window, \"\\n\") {\n88|\t\ttrimmed := strings.TrimSpace(line)\n89|\t\tif strings.HasPrefix(trimmed, \"| Codex \") || strings.HasPrefix(trimmed, \"| Claude \") || strings.HasPrefix(trimmed, \"| Gemini \") || strings.HasPrefix(trimmed, \"| Muse \") || strings.HasPrefix(trimmed, \"| Antigravity \") || strings.HasPrefix(trimmed, \"| Pi \") {\n90|\t\t\trows++\n91|\t\t}\n92|\t}\n93|\tif rows != len(profileProviders) {\n94|\t\tt.Fatalf(\"Section 7.7 holds %d provider rows, want %d\", rows, len(profileProviders))\n95|\t}\n96|\tfor _, excerpt := range []string{\n97|\t\t\"| Codex | <code>--dangerously-bypass-approvals-and-sandbox</code> (alias\",\n98|\t\t\"| Claude | <code>--dangerously-skip-permissions</code> |\",\n99|\t\t\"| Gemini CLI | <code>--approval-mode=yolo</code> |\",\n100|\t\t\"| Muse | <code>--yolo</code> |\",\n101|\t\t\"| Antigravity | <code>--dangerously-skip-permissions</code> |\",\n102|\t\t\"| Pi 0.73.1 | No invented flag;\",\n103|\t\t\"MUST omit every unrestricted flag above\",\n104|\t\t\"An absent or changed flag fails closed\",\n105|\t} {\n106|\t\trequireQuote(t, document, excerpt, \"7.7\")\n107|\t}\n108|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
