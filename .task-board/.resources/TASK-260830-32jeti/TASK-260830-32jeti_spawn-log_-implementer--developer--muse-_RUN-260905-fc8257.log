{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56b","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":272,"recorded_at":1780531400000539,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"193a214f-136e-4096-ae0c-259723903b7b"},"task_id":"193a214f-136e-4096-ae0c-259723903b7b","event":{"kind":"output","task_id":"193a214f-136e-4096-ae0c-259723903b7b","chunk":"Read text file `/tmp/r4/h/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Mutation harness: apply one narrowing mutant, run a targeted test, restore.\"\"\"\n3|import hashlib, os, shutil, subprocess, sys, json\n4|\n5|ROOT = \"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree\"\n6|\n7|def sha(p):\n8|    return hashlib.sha256(open(p,'rb').read()).hexdigest()\n9|\n10|def run_mutant(mid, relpath, old, new, testexpr, pkg=\"./internal/provhost/\"):\n11|    path = os.path.join(ROOT, relpath)\n12|    backup = path + \".reviewbak\"\n13|    shutil.copy2(path, backup)\n14|    before = sha(path)\n15|    try:\n16|        src = open(path).read()\n17|        n = src.count(old)\n18|        if n != 1:\n19|            return {\"id\": mid, \"result\": \"NOT_APPLIED\", \"occurrences\": n}\n20|        open(path, \"w\").write(src.replace(old, new))\n21|        after = sha(path)\n22|        if after == before:\n23|            return {\"id\": mid, \"result\": \"NOT_APPLIED\", \"occurrences\": n}\n24|        cmd = [\"go\", \"test\", pkg, \"-count=1\"]\n25|        if testexpr:\n26|            cmd += [\"-run\", testexpr]\n27|        proc = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=540)\n28|        killed = proc.returncode != 0\n29|        fails = [l for l in proc.stdout.splitlines() if l.startswith(\"--- FAIL\") or l.startswith(\"    --- FAIL\")]\n30|        return {\"id\": mid, \"result\": \"KILLED\" if killed else \"SURVIVED\",\n31|                \"exit\": proc.returncode, \"fails\": fails[:6],\n32|                \"build_err\": proc.stderr.strip().splitlines()[:4]}\n33|    finally:\n34|        shutil.copy2(backup, path)\n35|        os.remove(backup)\n36|        assert sha(path) == before, f\"restore failed for {relpath}\"\n37|\n38|if __name__ == \"__main__\":\n39|    spec = json.load(open(sys.argv[1]))\n40|    out = []\n41|    for m in spec:\n42|        r = run_mutant(m[\"id\"], m[\"file\"], m[\"old\"], m[\"new\"], m.get(\"run\"))\n43|        out.append(r)\n44|        print(json.dumps(r), flush=True)\n45|    print(\"=== SUMMARY ===\")\n46|    print(f\"killed={sum(1 for r in out if r['result']=='KILLED')} survived={sum(1 for r in out if r['result']=='SURVIVED')} notapplied={sum(1 for r in out if r['result']=='NOT_APPLIED')} total={len(out)}\")"}}}
