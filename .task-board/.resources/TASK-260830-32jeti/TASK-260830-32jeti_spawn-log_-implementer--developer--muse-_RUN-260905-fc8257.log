{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b3","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":436,"recorded_at":1780531400000867,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"d2bba4ff-2d14-4491-825a-b88414f2f6a0"},"task_id":"d2bba4ff-2d14-4491-825a-b88414f2f6a0","event":{"kind":"output","task_id":"d2bba4ff-2d14-4491-825a-b88414f2f6a0","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/quiesce_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// safeQuiesceProof is a SafeBoundaryProof with every fact proven:\n9|// empty blockers, both idle flags true, zero counts, and non-null\n10|// boundary and store generation under safe true.\n11|const safeQuiesceProof = `{\n12|  \"provider_id\": \"codex\",\n13|  \"provider_version\": \"0.147.0\",\n14|  \"input_blocked\": true,\n15|  \"boundary_ref\": \"provider-event-42\",\n16|  \"foreground_idle\": true,\n17|  \"background_idle\": true,\n18|  \"open_child_count\": 0,\n19|  \"open_database_handle_count\": 0,\n20|  \"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",\n21|  \"safe\": true,\n22|  \"blockers\": []\n23|}`\n24|\n25|// TestSafeQuiesceProofDecodes proves the fully proven safe proof\n26|// passes the production entry point.\n27|// quiesceErr drives the proof decoder for refusal assertions: the\n28|// safe bit is observed in the positive tests, never here.\n29|func quiesceErr(body []byte) error {\n30|\t_, err := DecodeQuiesceProof(body)\n31|\treturn err\n32|}\n33|\n34|func TestSafeQuiesceProofDecodes(t *testing.T) {\n35|\tsafe, err := DecodeQuiesceProof([]byte(safeQuiesceProof))\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"DecodeQuiesceProof(safe): %v\", err)\n38|\t}\n39|\tif !safe {\n40|\t\tt.Fatal(\"DecodeQuiesceProof(safe) = false, want the observed safe bit true\")\n41|\t}\n42|}\n43|\n44|// TestUnsafeQuiesceProofsDecode proves unsafe proofs are honest\n45|// observations, not refusals: safe false validates with blockers,\n46|// open counts, or null generation present.\n47|func TestUnsafeQuiesceProofsDecode(t *testing.T) {\n48|\tbodies := []string{\n49|\t\tstrings.Replace(safeQuiesceProof, `\"safe\": true,`, `\"safe\": false,`, 1),\n50|\t\tstrings.Replace(safeQuiesceProof, `\"blockers\": []`, `\"blockers\": [\"provider_busy\"]`, 1),\n51|\t\tstrings.Replace(safeQuiesceProof, `\"open_child_count\": 0,`, `\"open_child_count\": 2,`, 1),\n52|\t\tstrings.Replace(safeQuiesceProof, `\"background_idle\": true,`, `\"background_idle\": null,`, 1),\n53|\t\tstrings.Replace(safeQuiesceProof, `\"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",`, `\"store_generation\": null,`, 1),\n54|\t}\n55|\tfor index, body := range bodies {\n56|\t\tunsafe := body\n57|\t\tif !strings.Contains(unsafe, `\"safe\": false`) {\n58|\t\t\tunsafe = strings.Replace(unsafe, `\"safe\": true,`, `\"safe\": false,`, 1)\n59|\t\t}\n60|\t\tsafe, err := DecodeQuiesceProof([]byte(unsafe))\n61|\t\tif err != nil {\n62|\t\t\tt.Fatalf(\"unsafe proof %d refused: %v\", index, err)\n63|\t\t}\n64|\t\tif safe {\n65|\t\t\tt.Fatalf(\"unsafe proof %d reports safe true\", index)\n66|\t\t}\n67|\t}\n68|}\n69|\n70|// quiesceVariant rewrites one unique substring of the safe proof.\n71|func quiesceVariant(t *testing.T, old, new string) []byte {\n72|\tt.Helper()\n73|\tif strings.Count(safeQuiesceProof, old) != 1 {\n74|\t\tt.Fatalf(\"quiesce variant anchor %q is not unique\", old)\n75|\t}\n76|\treturn []byte(strings.Replace(safeQuiesceProof, old, new, 1))\n77|}\n78|\n79|// TestDecodeQuiesceSafeLies enumerates the safe-rule conjuncts: each\n80|// fixture violates exactly one proven fact while claiming safe true,\n81|// and every one is refused under the same arm. Deleting any conjunct\n82|// from the production disjunction admits its fixture and reddens.\n83|func TestDecodeQuiesceSafeLies(t *testing.T) {\n84|\trows := []struct {\n85|\t\tname string\n86|\t\tbody []byte\n87|\t}{\n88|\t\t{\"blockers open\", quiesceVariant(t, `\"blockers\": []`, `\"blockers\": [\"child_process_open\"]`)},\n89|\t\t{\"input flowing\", quiesceVariant(t, `\"input_blocked\": true,`, `\"input_blocked\": false,`)},\n90|\t\t{\"foreground busy\", quiesceVariant(t, `\"foreground_idle\": true,`, `\"foreground_idle\": false,`)},\n91|\t\t{\"background null\", quiesceVariant(t, `\"background_idle\": true,`, `\"background_idle\": null,`)},\n92|\t\t{\"background false\", quiesceVariant(t, `\"background_idle\": true,`, `\"background_idle\": false,`)},\n93|\t\t{\"boundary null\", quiesceVariant(t, `\"boundary_ref\": \"provider-event-42\",`, `\"boundary_ref\": null,`)},\n94|\t\t{\"generation null\", quiesceVariant(t, `\"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",`, `\"store_generation\": null,`)},\n95|\t\t{\"child open\", quiesceVariant(t, `\"open_child_count\": 0,`, `\"open_child_count\": 1,`)},\n96|\t\t{\"database handle open\", quiesceVariant(t, `\"open_database_handle_count\": 0,`, `\"open_database_handle_count\": 1,`)},\n97|\t}\n98|\tfor _, row := range rows {\n99|\t\tt.Run(row.name, func(t *testing.T) {\n100|\t\t\trequireFrameRefusal(t, quiesceErr(row.body), \"safe\", \"leaves a fact unproven\")\n101|\t\t})\n102|\t}\n103|\tt.Logf(\"quiescence safe-rule coverage: %d/%d violated facts refused\", len(rows), len(rows))\n104|}\n105|\n106|// TestDecodeQuiesceRefusals drives every quiescence shape rule.\n107|func TestDecodeQuiesceRefusals(t *testing.T) {\n108|\tlong1024 := strings.Repeat(\"b\", 1024)\n109|\tlong1025 := strings.Repeat(\"b\", 1025)\n110|\tlong512 := strings.Repeat(\"g\", 512)\n111|\tlong513 := strings.Repeat(\"g\", 513)\n112|\trows := []struct {\n113|\t\tname   string\n114|\t\tbody   []byte\n115|\t\tmember string\n116|\t\tdetail string\n117|\t}{\n118|\t\t{\"unknown member\", quiesceVariant(t, `\"safe\": true,`, `\"safe\": true, \"score\": 1,`), \"score\", \"unknown member\"},\n119|\t\t{\"missing member\", []byte(strings.Replace(safeQuiesceProof, \"  \\\"safe\\\": true,\\n\", \"\", 1)), \"safe\", \"misses a required member\"},\n120|\t\t{\"bad provider id\", quiesceVariant(t, `\"provider_id\": \"codex\"`, `\"provider_id\": \"Codex\"`), \"provider_id\", \"not a provider id\"},\n121|\t\t{\"empty provider version\", quiesceVariant(t, `\"provider_version\": \"0.147.0\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n122|\t\t{\"input not boolean\", quiesceVariant(t, `\"input_blocked\": true,`, `\"input_blocked\": \"yes\",`), \"input_blocked\", \"not a boolean\"},\n123|\t\t{\"foreground not boolean\", quiesceVariant(t, `\"foreground_idle\": true,`, `\"foreground_idle\": 1,`), \"foreground_idle\", \"not a boolean\"},\n124|\t\t{\"safe not boolean\", quiesceVariant(t, `\"safe\": true,`, `\"safe\": \"yes\",`), \"safe\", \"not a boolean\"},\n125|\t\t{\"boundary number\", quiesceVariant(t, `\"boundary_ref\": \"provider-event-42\",`, `\"boundary_ref\": 42,`), \"boundary_ref\", \"not 1..1024 characters or null\"},\n126|\t\t{\"boundary 1025\", quiesceVariant(t, `\"boundary_ref\": \"provider-event-42\",`, `\"boundary_ref\": \"`+long1025+`\",`), \"boundary_ref\", \"not 1..1024 characters or null\"},\n127|\t\t{\"generation 513\", quiesceVariant(t, `\"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",`, `\"store_generation\": \"`+long513+`\",`), \"store_generation\", \"not 1..512 characters or null\"},\n128|\t\t{\"background number\", quiesceVariant(t, `\"background_idle\": true,`, `\"background_idle\": 1,`), \"background_idle\", \"not a boolean or null\"},\n129|\t\t{\"count fraction\", quiesceVariant(t, `\"open_child_count\": 0,`, `\"open_child_count\": 1.5,`), \"open_child_count\", \"not a uint53\"},\n130|\t\t{\"count negative\", quiesceVariant(t, `\"open_database_handle_count\": 0`, `\"open_database_handle_count\": -1`), \"open_database_handle_count\", \"not a uint53\"},\n131|\t\t{\"count overflow\", quiesceVariant(t, `\"open_child_count\": 0,`, `\"open_child_count\": 9007199254740992,`), \"open_child_count\", \"not a uint53\"},\n132|\t\t{\"blockers six\", quiesceVariant(t, `\"blockers\": []`, `\"blockers\": [\"background_unproven\", \"child_process_open\", \"database_handle_open\", \"provider_busy\", \"store_unstable\", \"provider_busy\"]`), \"blockers\", \"exceed 5 entries\"},\n133|\t\t{\"blocker unknown\", quiesceVariant(t, `\"blockers\": []`, `\"blockers\": [\"process_open\"]`), \"blockers\", \"unknown blocker\"},\n134|\t\t{\"blockers unsorted\", quiesceVariant(t, `\"safe\": true,\n135|  \"blockers\": []`, `\"safe\": false,\n136|  \"blockers\": [\"provider_busy\", \"background_unproven\"]`), \"blockers\", \"not sorted unique\"},\n137|\t\t{\"blockers duplicated\", quiesceVariant(t, `\"safe\": true,\n138|  \"blockers\": []`, `\"safe\": false,\n139|  \"blockers\": [\"provider_busy\", \"provider_busy\"]`), \"blockers\", \"not sorted unique\"},\n140|\t}\n141|\tfor _, row := range rows {\n142|\t\tt.Run(row.name, func(t *testing.T) {\n143|\t\t\trequireFrameRefusal(t, quiesceErr(row.body), row.member, row.detail)\n144|\t\t})\n145|\t}\n146|\tif _, err := DecodeQuiesceProof(quiesceVariant(t, `\"boundary_ref\": \"provider-event-42\",`, `\"boundary_ref\": \"`+long1024+`\",`)); err != nil {\n147|\t\tt.Fatalf(\"1024-character boundary refused: %v\", err)\n148|\t}\n149|\tif _, err := DecodeQuiesceProof(quiesceVariant(t, `\"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",`, `\"store_generation\": \"`+long512+`\",`)); err != nil {\n150|\t\tt.Fatalf(\"512-character generation refused: %v\", err)\n151|\t}\n152|\t// The maximal uint53 count validates: the bound is exact.\n153|\tif _, err := DecodeQuiesceProof(quiesceVariant(t, `\"safe\": true,\n154|  \"blockers\": []`, `\"safe\": false,\n155|  \"blockers\": [\"background_unproven\", \"child_process_open\", \"database_handle_open\", \"provider_busy\", \"store_unstable\"]`)); err != nil {\n156|\t\tt.Fatalf(\"five sorted blockers refused: %v\", err)\n157|\t}\n158|}"}}}
