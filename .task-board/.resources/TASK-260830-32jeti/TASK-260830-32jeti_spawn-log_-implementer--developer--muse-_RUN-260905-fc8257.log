{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c5","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":573,"recorded_at":1780531400001141,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"76b33bb2-51b9-4a37-a611-ef9f43a4f6b2"},"task_id":"76b33bb2-51b9-4a37-a611-ef9f43a4f6b2","event":{"kind":"output","task_id":"76b33bb2-51b9-4a37-a611-ef9f43a4f6b2","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/profile_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n8|)\n9|\n10|// TestProfileMappingMatchesSection77 sweeps the full provider-by-\n11|// profile domain: six providers times two profiles, all twelve\n12|// measured. Yolo returns the exact adapter flag; standard returns\n13|// the empty omission for every provider, including Pi, whose yolo\n14|// and standard resolve to the same disclosed tool set rather than a\n15|// flag.\n16|func TestProfileMappingMatchesSection77(t *testing.T) {\n17|\twantYOLO := map[string]string{\n18|\t\t\"codex\":       \"--dangerously-bypass-approvals-and-sandbox\",\n19|\t\t\"claude\":      \"--dangerously-skip-permissions\",\n20|\t\t\"gemini\":      \"--approval-mode=yolo\",\n21|\t\t\"muse\":        \"--yolo\",\n22|\t\t\"antigravity\": \"--dangerously-skip-permissions\",\n23|\t\t\"pi\":          \"default_unrestricted_tool_set\",\n24|\t}\n25|\tif len(profileProviders) != len(wantYOLO) {\n26|\t\tt.Fatalf(\"profileProviders holds %d providers, want %d\", len(profileProviders), len(wantYOLO))\n27|\t}\n28|\tfor _, provider := range profileProviders {\n29|\t\twant, ok := wantYOLO[provider]\n30|\t\tif !ok {\n31|\t\t\tt.Fatalf(\"provider %q has no pinned yolo mapping; the sweep is blind\", provider)\n32|\t\t}\n33|\t\tgot, err := ProfileMapping(provider, ProfileYOLO)\n34|\t\tif err != nil {\n35|\t\t\tt.Fatalf(\"ProfileMapping(%q, yolo): %v\", provider, err)\n36|\t\t}\n37|\t\tif got != want {\n38|\t\t\tt.Fatalf(\"ProfileMapping(%q, yolo) = %q, want %q\", provider, got, want)\n39|\t\t}\n40|\t\tgot, err = ProfileMapping(provider, ProfileStandard)\n41|\t\tif err != nil {\n42|\t\t\tt.Fatalf(\"ProfileMapping(%q, standard): %v\", provider, err)\n43|\t\t}\n44|\t\tif got != \"\" {\n45|\t\t\tt.Fatalf(\"ProfileMapping(%q, standard) = %q, want the empty omission\", provider, got)\n46|\t\t}\n47|\t}\n48|\tt.Logf(\"profile mapping coverage: %d providers x 2 profiles measured\", len(profileProviders))\n49|}\n50|\n51|// TestProfileMappingRefusesUnknowns proves the fail-closed side:\n52|// unknown providers, unknown profiles, and empties are refused, never\n53|// defaulted. The provider near-misses derive from the registry by\n54|// case, affix, and truncation; the open-ended complement beyond them\n55|// is refused by construction (map miss) and witnessed here.\n56|func TestProfileMappingRefusesUnknowns(t *testing.T) {\n57|\tfor _, provider := range []string{\"\", \"Codex\", \"codex \", \" codex\", \"codexx\", \"cod\", \"qwen\", \"future\"} {\n58|\t\trequireLocalRefusal(t, mustProfileMapping(t, provider, true), \"invalid_config\", \"unknown provider\")\n59|\t}\n60|\tfor _, profile := range []string{\"\", \"YOLO\", \"yolo \", \"unrestricted\", \"standard-yolo\"} {\n61|\t\trequireLocalRefusal(t, mustProfileMapping(t, profile, false), \"invalid_config\", \"unknown profile\")\n62|\t}\n63|}\n64|\n65|// mustProfileMapping calls ProfileMapping with the unknown in the\n66|// provider seat (providerSeat true) or the profile seat.\n67|func mustProfileMapping(t *testing.T, unknown string, providerSeat bool) error {\n68|\tt.Helper()\n69|\tif providerSeat {\n70|\t\t_, err := ProfileMapping(unknown, ProfileYOLO)\n71|\t\treturn err\n72|\t}\n73|\t_, err := ProfileMapping(\"codex\", unknown)\n74|\treturn err\n75|}\n76|\n77|// TestProfileMappingIsPinnedToSection77 proves the table this file\n78|// transcribes: six provider rows in the Section 7.7 window, and every\n79|// yolo flag quoted verbatim from the pinned document.\n80|func TestProfileMappingIsPinnedToSection77(t *testing.T) {\n81|\tdocument, err := specdoc.Load()\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n84|\t}\n85|\twindow := sectionLines(t, document, \"7.7\", 3429, 3436)\n86|\trows := 0\n87|\tfor _, line := range strings.Split(window, \"\\n\") {\n88|\t\ttrimmed := strings.TrimSpace(line)\n89|\t\tif strings.HasPrefix(trimmed, \"| Codex \") || strings.HasPrefix(trimmed, \"| Claude \") || strings.HasPrefix(trimmed, \"| Gemini \") || strings.HasPrefix(trimmed, \"| Muse \") || strings.HasPrefix(trimmed, \"| Antigravity \") || strings.HasPrefix(trimmed, \"| Pi \") {\n90|\t\t\trows++\n91|\t\t}\n92|\t}\n93|\tif rows != len(profileProviders) {\n94|\t\tt.Fatalf(\"Section 7.7 holds %d provider rows, want %d\", rows, len(profileProviders))\n95|\t}\n96|\tfor _, excerpt := range []string{\n97|\t\t\"| Codex | <code>--dangerously-bypass-approvals-and-sandbox</code> (alias\",\n98|\t\t\"| Claude | <code>--dangerously-skip-permissions</code> |\",\n99|\t\t\"| Gemini CLI | <code>--approval-mode=yolo</code> |\",\n100|\t\t\"| Muse | <code>--yolo</code> |\",\n101|\t\t\"| Antigravity | <code>--dangerously-skip-permissions</code> |\",\n102|\t\t\"| Pi 0.73.1 | No invented flag;\",\n103|\t\t\"MUST omit every unrestricted flag above\",\n104|\t\t\"An absent or changed flag fails closed\",\n105|\t} {\n106|\t\trequireQuote(t, document, excerpt, \"7.7\")\n107|\t}\n108|}"}}}
