{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c617","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":358,"recorded_at":1780531400000711,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fbaa0087d73a362ed37f998ad2f","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/manifest_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// specManifestExample is the Section 7.3 manifest example, copied\n12|// verbatim from the pinned document. The derivation test below\n13|// re-reads the same lines from SPEC.md, so drift between this copy\n14|// and the document reddens there rather than passing silently.\n15|const specManifestExample = `{\n16|  \"schema\": \"urn:ax:schema:provider-manifest\",\n17|  \"schema_version\": \"1.0.0\",\n18|  \"provider_id\": \"pi\",\n19|  \"display_name\": \"Pi\",\n20|  \"plugin_version\": \"0.1.0\",\n21|  \"provider_version_range\": \">=0.73.1 <0.74.0\",\n22|  \"platforms\": [\"linux\", \"macos\", \"windows\", \"wsl2\"],\n23|  \"operations\": [\n24|    \"manifest\",\n25|    \"probe\",\n26|    \"launch\",\n27|    \"identify-session\",\n28|    \"quiesce\",\n29|    \"native-store-plan\",\n30|    \"capture\",\n31|    \"materialize\",\n32|    \"materialize-status\",\n33|    \"materialize-commit\",\n34|    \"materialize-rollback\",\n35|    \"resume\",\n36|    \"fork\",\n37|    \"stop\",\n38|    \"doctor\"\n39|  ],\n40|  \"capability_names\": [\n41|    \"native_resume\",\n42|    \"portable_store\",\n43|    \"managed_pty\",\n44|    \"appserver\",\n45|    \"task_board_primary\",\n46|    \"prompt_spawn\",\n47|    \"native_goal_binding\"\n48|  ]\n49|}`\n50|\n51|// TestSpecManifestExampleDecodes proves the Section 7.3 example is a\n52|// well-formed manifest under DecodeManifest: the contract's own\n53|// fixture passes the production entry point.\n54|func TestSpecManifestExampleDecodes(t *testing.T) {\n55|\tif err := DecodeManifest([]byte(specManifestExample)); err != nil {\n56|\t\tt.Fatalf(\"DecodeManifest(spec example): %v\", err)\n57|\t}\n58|}\n59|\n60|// TestManifestRegistriesAreDerivedFromSpec proves the three transcribed\n61|// registries — operations, capability names, platforms — equal the\n62|// Section 7.3 example: the example JSON is re-read from the pinned\n63|// document, never from the constant above, so a drifted transcription\n64|// reddens here.\n65|func TestManifestRegistriesAreDerivedFromSpec(t *testing.T) {\n66|\tdocument, err := specdoc.Load()\n67|\tif err != nil {\n68|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n69|\t}\n70|\twindow := sectionLines(t, document, \"7.3\", 2751, 2785)\n71|\tstart := strings.Index(window, \"{\")\n72|\tend := strings.LastIndex(window, \"}\")\n73|\tif start < 0 || end <= start {\n74|\t\tt.Fatal(\"Section 7.3 example holds no JSON object; the check is blind\")\n75|\t}\n76|\texample, fault := decodeStrictObject([]byte(window[start : end+1]))\n77|\tif fault != nil {\n78|\t\tt.Fatalf(\"Section 7.3 example is not a strict object: %v %q\", fault.detail, fault.member)\n79|\t}\n80|\toperations, ok := rawStringArray(example[\"operations\"])\n81|\tif !ok {\n82|\t\tt.Fatal(\"Section 7.3 example operations are not a string array; the check is blind\")\n83|\t}\n84|\tif fmt.Sprintf(\"%v\", operations) != fmt.Sprintf(\"%v\", Operations()) {\n85|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.3 example %v\", Operations(), operations)\n86|\t}\n87|\tcapabilities, ok := rawStringArray(example[\"capability_names\"])\n88|\tif !ok {\n89|\t\tt.Fatal(\"Section 7.3 example capability_names are not a string array; the check is blind\")\n90|\t}\n91|\tif fmt.Sprintf(\"%v\", capabilities) != fmt.Sprintf(\"%v\", Capabilities()) {\n92|\t\tt.Fatalf(\"Capabilities() = %v, want the Section 7.3 example %v\", Capabilities(), capabilities)\n93|\t}\n94|\tplatforms, ok := rawStringArray(example[\"platforms\"])\n95|\tif !ok {\n96|\t\tt.Fatal(\"Section 7.3 example platforms are not a string array; the check is blind\")\n97|\t}\n98|\tif fmt.Sprintf(\"%v\", platforms) != fmt.Sprintf(\"%v\", manifestPlatforms) {\n99|\t\tt.Fatalf(\"manifestPlatforms = %v, want the Section 7.3 example %v\", manifestPlatforms, platforms)\n100|\t}\n101|\tt.Logf(\"manifest registry coverage: %d operations, %d capabilities, %d platforms derived\", len(operations), len(capabilities), len(platforms))\n102|}\n103|\n104|// manifestVariant rewrites one unique substring of the spec example.\n105|// The rewritten body, not the spec fixture, is what the negative rows\n106|// drive.\n107|func manifestVariant(t *testing.T, old, new string) []byte {\n108|\tt.Helper()\n109|\tif strings.Count(specManifestExample, old) != 1 {\n110|\t\tt.Fatalf(\"manifest variant anchor %q is not unique\", old)\n111|\t}\n112|\treturn []byte(strings.Replace(specManifestExample, old, new, 1))\n113|}\n114|\n115|// TestDecodeManifestRefusals drives every manifest rule with a\n116|// fixture carrying only that violation. Each row names the arm\n117|// (member plus rule detail), so a deleted rule slides to a different\n118|// arm or to acceptance and reddens here.\n119|func TestDecodeManifestRefusals(t *testing.T) {\n120|\tlong128 := strings.Repeat(\"a\", 128)\n121|\tlong129 := strings.Repeat(\"a\", 129)\n122|\tlong256 := strings.Repeat(\"a\", 256)\n123|\tlong257 := strings.Repeat(\"a\", 257)\n124|\trows := []struct {\n125|\t\tname   string\n126|\t\tbody   []byte\n127|\t\tmember string\n128|\t\tdetail string\n129|\t}{\n130|\t\t{\"duplicate member\", []byte(`{\"schema\": \"urn:ax:schema:provider-manifest\", \"schema\": \"urn:ax:schema:provider-manifest\"}`), \"schema\", \"duplicate member\"},\n131|\t\t{\"unknown member\", manifestVariant(t, `\"display_name\": \"Pi\",`, `\"display_name\": \"Pi\", \"diagnostics\": [],`), \"diagnostics\", \"unknown member\"},\n132|\t\t{\"missing member\", manifestVariant(t, `  \"display_name\": \"Pi\",\n133|`, ``), \"display_name\", \"misses a required member\"},\n134|\t\t{\"wrong schema\", manifestVariant(t, `\"urn:ax:schema:provider-manifest\"`, `\"urn:ax:schema:provider-probe\"`), \"schema\", \"not the provider manifest\"},\n135|\t\t{\"wrong schema version\", manifestVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"2.0.0\"`), \"schema_version\", \"not 1.0.0\"},\n136|\t\t{\"bad provider id\", manifestVariant(t, `\"provider_id\": \"pi\"`, `\"provider_id\": \"Pi\"`), \"provider_id\", \"not a provider id\"},\n137|\t\t{\"empty display name\", manifestVariant(t, `\"display_name\": \"Pi\"`, `\"display_name\": \"\"`), \"display_name\", \"not 1..128 characters\"},\n138|\t\t{\"display name 129\", manifestVariant(t, `\"display_name\": \"Pi\"`, `\"display_name\": \"`+long129+`\"`), \"display_name\", \"not 1..128 characters\"},\n139|\t\t{\"bad semver\", manifestVariant(t, `\"plugin_version\": \"0.1.0\"`, `\"plugin_version\": \"1.0\"`), \"plugin_version\", \"not SemVer\"},\n140|\t\t{\"semver leading zero\", manifestVariant(t, `\"plugin_version\": \"0.1.0\"`, `\"plugin_version\": \"01.0.0\"`), \"plugin_version\", \"not SemVer\"},\n141|\t\t{\"empty version range\", manifestVariant(t, `\"provider_version_range\": \">=0.73.1 <0.74.0\"`, `\"provider_version_range\": \"\"`), \"provider_version_range\", \"not 1..256 characters\"},\n142|\t\t{\"version range 257\", manifestVariant(t, `\"provider_version_range\": \">=0.73.1 <0.74.0\"`, `\"provider_version_range\": \"`+long257+`\"`), \"provider_version_range\", \"not 1..256 characters\"},\n143|\t\t{\"platforms empty\", manifestVariant(t, `[\"linux\", \"macos\", \"windows\", \"wsl2\"]`, `[]`), \"platforms\", \"empty or not an array\"},\n144|\t\t{\"platform unknown\", manifestVariant(t, `\"windows\", \"wsl2\"`, `\"windows\", \"darwin\"`), \"platforms\", \"unknown platform\"},\n145|\t\t{\"platforms unsorted\", manifestVariant(t, `[\"linux\", \"macos\", \"windows\", \"wsl2\"]`, `[\"macos\", \"linux\", \"windows\", \"wsl2\"]`), \"platforms\", \"not sorted unique\"},\n146|\t\t{\"platforms duplicated\", manifestVariant(t, `[\"linux\", \"macos\", \"windows\", \"wsl2\"]`, `[\"linux\", \"linux\", \"macos\", \"windows\", \"wsl2\"]`), \"platforms\", \"not sorted unique\"},\n147|\t\t{\"operations dropped\", []byte(strings.Replace(specManifestExample, `,\n148|    \"doctor\"`, ``, 1)), \"operations\", \"differ from the registry\"},\n149|\t\t{\"operations reordered\", manifestVariant(t, `    \"manifest\",\n150|    \"probe\",`, `    \"probe\",\n151|    \"manifest\",`), \"operations\", \"differ from the registry\"},\n152|\t\t{\"operations first substituted\", manifestVariant(t, `    \"manifest\",\n153|    \"probe\",`, `    \"probe\",\n154|    \"probe\",`), \"operations\", \"differ from the registry\"},\n155|\t\t{\"operations added\", manifestVariant(t, `    \"stop\",\n156|    \"doctor\"`, `    \"stop\",\n157|    \"doctor\",\n158|    \"reboot\"`), \"operations\", \"differ from the registry\"},\n159|\t\t{\"capability added\", manifestVariant(t, `    \"prompt_spawn\",\n160|    \"native_goal_binding\"`, `    \"prompt_spawn\",\n161|    \"native_goal_binding\",\n162|    \"remote_exec\"`), \"capability_names\", \"differ from the registry\"},\n163|\t\t{\"capability dropped\", []byte(strings.Replace(specManifestExample, `,\n164|    \"native_goal_binding\"`, ``, 1)), \"capability_names\", \"differ from the registry\"},\n165|\t\t{\"capability reordered\", manifestVariant(t, `    \"native_resume\",\n166|    \"portable_store\",`, `    \"portable_store\",\n167|    \"native_resume\",`), \"capability_names\", \"differ from the registry\"},\n168|\t\t{\"capability first substituted\", manifestVariant(t, `    \"native_resume\",\n169|    \"portable_store\",`, `    \"portable_store\",\n170|    \"portable_store\",`), \"capability_names\", \"differ from the registry\"},\n171|\t}\n172|\tfor _, row := range rows {\n173|\t\tt.Run(row.name, func(t *testing.T) {\n174|\t\t\terr := DecodeManifest(row.body)\n175|\t\t\trequireFrameRefusal(t, err, row.member, row.detail)\n176|\t\t})\n177|\t}\n178|\t// Boundary acceptances: the longest admitted values pass, so the\n179|\t// bounds above are exact rather than merely sufficient.\n180|\tif err := DecodeManifest(manifestVariant(t, `\"display_name\": \"Pi\"`, `\"display_name\": \"`+long128+`\"`)); err != nil {\n181|\t\tt.Fatalf(\"128-character display_name refused: %v\", err)\n182|\t}\n183|\tif err := DecodeManifest(manifestVariant(t, `\"provider_version_range\": \">=0.73.1 <0.74.0\"`, `\"provider_version_range\": \"`+long256+`\"`)); err != nil {\n184|\t\tt.Fatalf(\"256-character version range refused: %v\", err)\n185|\t}\n186|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c619","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":359,"recorded_at":1780531400000713,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"call_id":"call_01a06fbaa10479e39de6ee1cc2878326","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/spawn.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the SpawnPlan a launch or resume operation\n11|// returns as its success body (Section 7.5 rows). The trusted\n12|// terminal backend performs process creation from this plan, so the\n13|// plan MUST NOT carry secret environment values, and its\n14|// profile_mapping MUST equal the Section 7.7 mapping for the calling\n15|// provider and profile. Literal secrecy is structural, not\n16|// content-admitted: values are bounded and disjoint from inherited\n17|// names, and the host never logs bodies; no content inspection could\n18|// prove a literal non-secret, so none is attempted.\n19|\n20|// spawnMembers is the exact required member set of a SpawnPlan.\n21|var spawnMembers = map[string]bool{\n22|\t\"argv\":              true,\n23|\t\"cwd\":               true,\n24|\t\"env_names\":         true,\n25|\t\"env_literals\":      true,\n26|\t\"native_session_id\": true,\n27|\t\"profile_mapping\":   true,\n28|\t\"extensions\":        true,\n29|}\n30|\n31|// spawnRequired lists spawnMembers in a fixed order so a plan missing\n32|// several members always names the same one.\n33|var spawnRequired = []string{\n34|\t\"argv\",\n35|\t\"cwd\",\n36|\t\"env_names\",\n37|\t\"env_literals\",\n38|\t\"native_session_id\",\n39|\t\"profile_mapping\",\n40|\t\"extensions\",\n41|}\n42|\n43|// maxSpawnArgvBytes bounds the total encoded argv Section 5.1 states.\n44|const maxSpawnArgvBytes = 65536\n45|\n46|// DecodeSpawnPlan validates one launch- or resume-operation success\n47|// body as a SpawnPlan for the calling provider under the calling\n48|// profile on the destination platform. It returns nil on a\n49|// well-formed plan and a refusal naming the offending member\n50|// otherwise: a provider_protocol_error for a malformed plan, and an\n51|// invalid_config caller error when the caller names an unknown\n52|// provider or profile for the mapping check.\n53|func DecodeSpawnPlan(body []byte, providerID, profile string, platform scalar.Platform) error {\n54|\tmembers, fault := decodeStrictObject(body)\n55|\tif fault != nil {\n56|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n57|\t\tif err != nil {\n58|\t\t\treturn err\n59|\t\t}\n60|\t\treturn failure\n61|\t}\n62|\tif name, unknown := unknownMember(members, spawnMembers); unknown {\n63|\t\tfailure, err := failProtocol(\"spawn plan carries unknown member\", name)\n64|\t\tif err != nil {\n65|\t\t\treturn err\n66|\t\t}\n67|\t\treturn failure\n68|\t}\n69|\tif name, missing := missingMember(members, spawnRequired); missing {\n70|\t\tfailure, err := failProtocol(\"spawn plan misses a required member\", name)\n71|\t\tif err != nil {\n72|\t\t\treturn err\n73|\t\t}\n74|\t\treturn failure\n75|\t}\n76|\tif err := checkSpawnArgv(members[\"argv\"]); err != nil {\n77|\t\treturn err\n78|\t}\n79|\tif cwd, ok := rawString(members[\"cwd\"]); !ok || !isAbsoluteOn(cwd, platform) {\n80|\t\tfailure, err := failProtocol(\"spawn cwd is not an absolute path\", \"cwd\")\n81|\t\tif err != nil {\n82|\t\t\treturn err\n83|\t\t}\n84|\t\treturn failure\n85|\t}\n86|\tnames, err := checkSpawnEnvNames(members[\"env_names\"])\n87|\tif err != nil {\n88|\t\treturn err\n89|\t}\n90|\tif err := checkSpawnEnvLiterals(members[\"env_literals\"], names); err != nil {\n91|\t\treturn err\n92|\t}\n93|\tif _, isNull, ok := rawNullableString(members[\"native_session_id\"]); !ok || (!isNull && !isBoundedString(members[\"native_session_id\"], 1, 512)) {\n94|\t\tfailure, err := failProtocol(\"spawn native_session_id is not 1..512 characters or null\", \"native_session_id\")\n95|\t\tif err != nil {\n96|\t\t\treturn err\n97|\t\t}\n98|\t\treturn failure\n99|\t}\n100|\tif err := checkSpawnProfileMapping(members[\"profile_mapping\"], providerID, profile); err != nil {\n101|\t\treturn err\n102|\t}\n103|\tif !isJSONObject(members[\"extensions\"]) {\n104|\t\tfailure, err := failProtocol(\"spawn extensions is not an object\", \"extensions\")\n105|\t\tif err != nil {\n106|\t\t\treturn err\n107|\t\t}\n108|\t\treturn failure\n109|\t}\n110|\treturn nil\n111|}\n112|\n113|// isAbsoluteOn reports whether the path is absolute on the\n114|// destination platform. Destination-native is the Section 7.5 rule;\n115|// the platform arrives from the caller because the plan carries none.\n116|func isAbsoluteOn(path string, platform scalar.Platform) bool {\n117|\t_, err := scalar.ParseAbsolutePath(platform, path)\n118|\treturn err == nil\n119|}\n120|\n121|// isBoundedString reports whether the raw JSON string counts 1..max\n122|// Unicode characters. The caller already established it is a string.\n123|func isBoundedString(raw json.RawMessage, min, max int) bool {\n124|\tvalue, ok := rawString(raw)\n125|\tif !ok {\n126|\t\treturn false\n127|\t}\n128|\tlength := runeLength(value)\n129|\treturn length >= min && length <= max\n130|}\n131|\n132|// checkSpawnArgv enforces the Section 5.1 argv limits: 1..128\n133|// elements, each a NUL-free string of 1..4,096 bytes, 65,536 bytes\n134|// total. Byte length is the exec-bound quantity, so elements count\n135|// bytes here while the character-bounded members count runes.\n136|func checkSpawnArgv(raw json.RawMessage) error {\n137|\telements, ok := rawArray(raw)\n138|\tif !ok || len(elements) == 0 || len(elements) > 128 {\n139|\t\tfailure, err := failProtocol(\"spawn argv is empty or longer than 128\", \"argv\")\n140|\t\tif err != nil {\n141|\t\t\treturn err\n142|\t\t}\n143|\t\treturn failure\n144|\t}\n145|\ttotal := 0\n146|\tfor _, element := range elements {\n147|\t\tvalue, ok := rawString(element)\n148|\t\tif !ok || len(value) < 1 || len(value) > 4096 || strings.ContainsRune(value, 0) {\n149|\t\t\tfailure, err := failProtocol(\"spawn argv element is not 1..4096 NUL-free bytes\", \"argv\")\n150|\t\t\tif err != nil {\n151|\t\t\t\treturn err\n152|\t\t\t}\n153|\t\t\treturn failure\n154|\t\t}\n155|\t\ttotal += len(value)\n156|\t}\n157|\tif total > maxSpawnArgvBytes {\n158|\t\tfailure, err := failProtocol(\"spawn argv exceeds 65536 bytes total\", \"argv\")\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\treturn failure\n163|\t}\n164|\treturn nil\n165|}\n166|\n167|// validEnvName reports whether the name satisfies the Section 5.1\n168|// environment-name grammar: [A-Za-z_][A-Za-z0-9_]{0,127}.\n169|func validEnvName(name string) bool {\n170|\tif len(name) < 1 || len(name) > 128 {\n171|\t\treturn false\n172|\t}\n173|\tfor index := 0; index < len(name); index++ {\n174|\t\tchar := name[index]\n175|\t\tvalid := char == '_' || char >= 'A' && char <= 'Z' || char >= 'a' && char <= 'z' || index > 0 && char >= '0' && char <= '9'\n176|\t\tif !valid {\n177|\t\t\treturn false\n178|\t\t}\n179|\t}\n180|\treturn true\n181|}\n182|\n183|// checkSpawnEnvNames enforces sorted unique environment names\n184|// [0..64] and returns them for the disjointness check.\n185|func checkSpawnEnvNames(raw json.RawMessage) ([]string, error) {\n186|\tnames, ok := rawStringArray(raw)\n187|\tif !ok || len(names) > 64 {\n188|\t\tfailure, err := failProtocol(\"spawn env_names exceed 64 entries\", \"env_names\")\n189|\t\tif err != nil {\n190|\t\t\treturn nil, err\n191|\t\t}\n192|\t\treturn nil, failure\n193|\t}\n194|\tfor _, name := range names {\n195|\t\tif !validEnvName(name) {\n196|\t\t\tfailure, err := failProtocol(\"spawn env_names are not environment names\", \"env_names\")\n197|\t\t\tif err != nil {\n198|\t\t\t\treturn nil, err\n199|\t\t\t}\n200|\t\t\treturn nil, failure\n201|\t\t}\n202|\t}\n203|\tif !sortedUniqueStrings(names) {\n204|\t\tfailure, err := failProtocol(\"spawn env_names are not sorted unique\", \"env_names\")\n205|\t\tif err != nil {\n206|\t\t\treturn nil, err\n207|\t\t}\n208|\t\treturn nil, failure\n209|\t}\n210|\treturn names, nil\n211|}\n212|\n213|// checkSpawnEnvLiterals enforces the literal map: at most 64\n214|// entries, environment-name keys disjoint from env_names, string\n215|// values of at most 4,096 bytes. Keys sort in canonical form on the\n216|// wire; the host reads the set, so order is not rechecked here.\n217|func checkSpawnEnvLiterals(raw json.RawMessage, names []string) error {\n218|\tliterals, fault := decodeStrictObject(raw)\n219|\tif fault != nil {\n220|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\treturn failure\n225|\t}\n226|\tif len(literals) > 64 {\n227|\t\tfailure, err := failProtocol(\"spawn env_literals exceed 64 entries\", \"env_literals\")\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\tinherited := map[string]bool{}\n234|\tfor _, name := range names {\n235|\t\tinherited[name] = true\n236|\t}\n237|\tfor key, value := range literals {\n238|\t\tif !validEnvName(key) || inherited[key] {\n239|\t\t\tfailure, err := failProtocol(\"spawn env_literal key is not disjoint\", \"env_literals\")\n240|\t\t\tif err != nil {\n241|\t\t\t\treturn err\n242|\t\t\t}\n243|\t\t\treturn failure\n244|\t\t}\n245|\t\ttext, ok := rawString(value)\n246|\t\tif !ok || len(text) > 4096 || strings.ContainsRune(text, 0) {\n247|\t\t\tfailure, err := failProtocol(\"spawn env_literal is not at most 4096 NUL-free bytes\", \"env_literals\")\n248|\t\t\tif err != nil {\n249|\t\t\t\treturn err\n250|\t\t\t}\n251|\t\t\treturn failure\n252|\t\t}\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|// checkSpawnProfileMapping requires profile_mapping to equal the\n258|// Section 7.7 mapping for the calling provider and profile. A\n259|// provider that answers yolo with the standard omission, or standard\n260|// with a yolo flag, fails here rather than executing under the wrong\n261|// sandbox. Unknown providers and profiles are caller errors that\n262|// propagate from the mapping table.\n263|func checkSpawnProfileMapping(raw json.RawMessage, providerID, profile string) error {\n264|\tmapping, ok := rawString(raw)\n265|\tif !ok || runeLength(mapping) > 512 {\n266|\t\tfailure, err := failProtocol(\"spawn profile_mapping is not at most 512 characters\", \"profile_mapping\")\n267|\t\tif err != nil {\n268|\t\t\treturn err\n269|\t\t}\n270|\t\treturn failure\n271|\t}\n272|\twant, err := ProfileMapping(providerID, profile)\n273|\tif err != nil {\n274|\t\treturn err\n275|\t}\n276|\tif mapping != want {\n277|\t\tfailure, fault := failProtocol(\"spawn profile_mapping does not match the provider profile\", \"profile_mapping\")\n278|\t\tif fault != nil {\n279|\t\t\treturn fault\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\treturn nil\n284|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
