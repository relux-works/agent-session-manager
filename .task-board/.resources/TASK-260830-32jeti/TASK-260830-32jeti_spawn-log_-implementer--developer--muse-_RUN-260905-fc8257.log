{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b7","stream":{"kind":"session","id":"01a06fb9-e0fc-7072-adfc-69f8598926a4"},"sequence":438,"recorded_at":1780531400000871,"record_type":"event","durability":"durable","causation_id":"694249df-ed90-4909-b924-7901358b9328","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"694249df-ed90-4909-b924-7901358b9328","run_stream":{"kind":"run","id":"694249df-ed90-4909-b924-7901358b9328"},"task_stream":{"kind":"task","id":"805aabfd-d435-4fad-bef0-6def7a0f394a"},"task_id":"805aabfd-d435-4fad-bef0-6def7a0f394a","event":{"kind":"output","task_id":"805aabfd-d435-4fad-bef0-6def7a0f394a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/identity_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// specIdentityExample is the Section 5.5 Provider Identity Record\n9|// example, copied verbatim from the pinned document: an Antigravity\n10|// backend_conversation_uuid with a non-null realm fingerprint.\n11|const specIdentityExample = `{\n12|  \"schema\": \"urn:ax:schema:provider-identity\",\n13|  \"schema_version\": \"1.0.0\",\n14|  \"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\",\n15|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n16|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n17|  \"provider_id\": \"antigravity\",\n18|  \"provider_version\": \"1.1.14\",\n19|  \"provider_version_range\": \">=1.1.14 <1.2.0\",\n20|  \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n21|  \"identity_kind\": \"backend_conversation_uuid\",\n22|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n23|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n24|  \"opaque_identity\": {},\n25|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n26|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n27|  \"extensions\": {}\n28|}`\n29|\n30|// TestSpecIdentityExampleDecodes proves the Section 5.5 example\n31|// passes the production entry point for its provider.\n32|func TestSpecIdentityExampleDecodes(t *testing.T) {\n33|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n34|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n35|\t}\n36|}\n37|\n38|// identityVariant rewrites one unique substring of the example.\n39|func identityVariant(t *testing.T, old, new string) []byte {\n40|\tt.Helper()\n41|\tif strings.Count(specIdentityExample, old) != 1 {\n42|\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\n43|\t}\n44|\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\n45|}\n46|\n47|// TestCheckIdentityRefusals drives every identity rule, including\n48|// the five normative Section 5.5 negatives: unknown identity_kind,\n49|// absent opaque_identity, an object opaque value, an absolute source\n50|// path in that map, and an Antigravity backend_conversation_uuid\n51|// with a null realm fingerprint.\n52|func TestCheckIdentityRefusals(t *testing.T) {\n53|\tlong128 := strings.Repeat(\"v\", 128)\n54|\tlong129 := strings.Repeat(\"v\", 129)\n55|\tlong1024 := strings.Repeat(\"v\", 1024)\n56|\tlong1025 := strings.Repeat(\"v\", 1025)\n57|\trows := []struct {\n58|\t\tname   string\n59|\t\tbody   []byte\n60|\t\tmember string\n61|\t\tdetail string\n62|\t}{\n63|\t\t{\"unknown member\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"score\": 1`), \"score\", \"unknown member\"},\n64|\t\t{\"absent opaque_identity\", []byte(strings.Replace(specIdentityExample, \"  \\\"opaque_identity\\\": {},\\n\", \"\", 1)), \"opaque_identity\", \"misses a required member\"},\n65|\t\t{\"wrong schema\", identityVariant(t, `\"urn:ax:schema:provider-identity\"`, `\"urn:ax:schema:provider-manifest\"`), \"schema\", \"not the provider identity\"},\n66|\t\t{\"wrong schema version\", identityVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"1.1.0\"`), \"schema_version\", \"not 1.0.0\"},\n67|\t\t{\"bad record digest\", identityVariant(t, `\"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"`, `\"record_id\": \"sha256:zzzz\"`), \"record_id\", \"not a digest\"},\n68|\t\t{\"bad subject uuid\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"not-a-uuid\"`), \"subject_id\", \"not a UUIDv7\"},\n69|\t\t{\"bad session uuid\", identityVariant(t, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ax\"`), \"session_id\", \"not a UUIDv7\"},\n70|\t\t{\"subject differs\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`), \"subject_id\", \"does not equal session_id\"},\n71|\t\t{\"bad provider grammar\", identityVariant(t, `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"Antigravity\"`), \"provider_id\", \"not a provider id\"},\n72|\t\t{\"empty provider version\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n73|\t\t{\"provider version 129\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long129+`\"`), \"provider_version\", \"not 1..128 characters\"},\n74|\t\t{\"empty version range\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"\"`), \"provider_version_range\", \"not 1..256 characters\"},\n75|\t\t{\"empty native session\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"\"`), \"native_session_id\", \"not 1..512 characters\"},\n76|\t\t{\"unknown identity_kind\", identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"window_handle\"`), \"identity_kind\", \"not a registry member\"},\n77|\t\t{\"bad workspace uuid\", identityVariant(t, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"`, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890aX\"`), \"logical_workspace_id\", \"not a UUIDv7\"},\n78|\t\t{\"bad realm digest\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": \"nope\"`), \"backend_realm_fingerprint\", \"not a digest or null\"},\n79|\t\t{\"antigravity null realm\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`), \"backend_realm_fingerprint\", \"required for this backend kind\"},\n80|\t\t{\"opaque object value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": {\"nested\": true}}`), \"opaque_identity\", \"not 1..1024 characters\"},\n81|\t\t{\"opaque absolute path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"/Users/iv/work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n82|\t\t{\"opaque windows path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"C:\\\\work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n83|\t\t{\"opaque bad key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"Bad Key!\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n84|\t\t{\"opaque empty value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"\"}`), \"opaque_identity\", \"not 1..1024 characters\"},\n85|\t\t{\"opaque long value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"`+long1025+`\"}`), \"opaque_identity\", \"not 1..1024 characters\"},\n86|\t\t{\"bad host uuid\", identityVariant(t, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890aG\"`), \"created_by_host_id\", \"not a UUIDv7\"},\n87|\t\t{\"bad timestamp\", identityVariant(t, `\"created_at\": \"2026-08-19T04:09:45.000Z\"`, `\"created_at\": \"yesterday\"`), \"created_at\", \"not a timestamp\"},\n88|\t\t{\"extensions array\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": []`), \"extensions\", \"not an object\"},\n89|\t}\n90|\tfor _, row := range rows {\n91|\t\tt.Run(row.name, func(t *testing.T) {\n92|\t\t\trequireFrameRefusal(t, CheckIdentity(row.body, \"antigravity\"), row.member, row.detail)\n93|\t\t})\n94|\t}\n95|\tif err := CheckIdentity(identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long128+`\"`), \"antigravity\"); err != nil {\n96|\t\tt.Fatalf(\"128-character provider version refused: %v\", err)\n97|\t}\n98|\tif err := CheckIdentity(identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"`+long1024+`\"}`), \"antigravity\"); err != nil {\n99|\t\tt.Fatalf(\"1024-character opaque value refused: %v\", err)\n100|\t}\n101|}\n102|\n103|// TestCheckIdentityNamesAnotherProvider proves the caller seat: a\n104|// well-formed record for another provider is a caller error, not a\n105|// frame error, and a null realm is honest for non-Antigravity kinds.\n106|func TestCheckIdentityNamesAnotherProvider(t *testing.T) {\n107|\trequireLocalRefusal(t, CheckIdentity([]byte(specIdentityExample), \"codex\"), \"invalid_config\", \"names another provider\")\n108|\totherKind := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"session_uuid\"`)\n109|\totherKind = []byte(strings.Replace(string(otherKind), `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"codex\"`, 1))\n110|\totherKind = []byte(strings.Replace(string(otherKind), `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`, 1))\n111|\tif err := CheckIdentity(otherKind, \"codex\"); err != nil {\n112|\t\tt.Fatalf(\"codex session_uuid with null realm refused: %v\", err)\n113|\t}\n114|}\n115|\n116|// specIdentifyResult wraps the identity example in the\n117|// identify-session success shape.\n118|const specIdentifyResultPrefix = `{\n119|  \"identity\": `\n120|\n121|// TestDecodeIdentifyResultFixtures proves the wrapper: the example\n122|// record with exact confidence and one evidence member validates,\n123|// and every wrapper rule refuses with its own arm.\n124|func TestDecodeIdentifyResultFixtures(t *testing.T) {\n125|\tindented := strings.ReplaceAll(specIdentityExample, \"\\n\", \"\\n  \")\n126|\tbody := []byte(specIdentifyResultPrefix + \"  \" + strings.TrimPrefix(indented, \"  \") + `,\n127|  \"confidence\": \"exact\",\n128|  \"matched_evidence\": [\"native_id\"]\n129|}`)\n130|\tif err := DecodeIdentifyResult(body, \"antigravity\"); err != nil {\n131|\t\tt.Fatalf(\"DecodeIdentifyResult(spec): %v\", err)\n132|\t}\n133|\twith := func(old, new string) []byte {\n134|\t\tt.Helper()\n135|\t\tfull := string(body)\n136|\t\tif strings.Count(full, old) != 1 {\n137|\t\t\tt.Fatalf(\"identify variant anchor %q is not unique\", old)\n138|\t\t}\n139|\t\treturn []byte(strings.Replace(full, old, new, 1))\n140|\t}\n141|\trows := []struct {\n142|\t\tname   string\n143|\t\tbody   []byte\n144|\t\tmember string\n145|\t\tdetail string\n146|\t}{\n147|\t\t{\"unknown member\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\"], \"score\": 1`), \"score\", \"unknown member\"},\n148|\t\t{\"missing member\", []byte(strings.Replace(string(body), \"  \\\"confidence\\\": \\\"exact\\\",\\n\", \"\", 1)), \"confidence\", \"misses a required member\"},\n149|\t\t{\"bad confidence\", with(`\"confidence\": \"exact\"`, `\"confidence\": \"certain\"`), \"confidence\", \"not exact strong or weak\"},\n150|\t\t{\"evidence empty\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": []`), \"matched_evidence\", \"not 1..4 members\"},\n151|\t\t{\"evidence five\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\", \"native_id\"]`), \"matched_evidence\", \"not 1..4 members\"},\n152|\t\t{\"evidence unknown\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"window_title\"]`), \"matched_evidence\", \"unknown member\"},\n153|\t\t{\"evidence unsorted\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"store_path\", \"native_id\"]`), \"matched_evidence\", \"not sorted unique\"},\n154|\t\t{\"evidence duplicated\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\", \"native_id\"]`), \"matched_evidence\", \"not sorted unique\"},\n155|\t\t{\"identity not object\", []byte(`{\"identity\": [], \"confidence\": \"exact\", \"matched_evidence\": [\"native_id\"]}`), \"identity\", \"not an object\"},\n156|\t}\n157|\tfor _, row := range rows {\n158|\t\tt.Run(row.name, func(t *testing.T) {\n159|\t\t\trequireFrameRefusal(t, DecodeIdentifyResult(row.body, \"antigravity\"), row.member, row.detail)\n160|\t\t})\n161|\t}\n162|\t// A well-formed record for another provider is a caller error,\n163|\t// not a frame error.\n164|\trequireLocalRefusal(t, DecodeIdentifyResult(body, \"codex\"), \"invalid_config\", \"names another provider\")\n165|}"}}}
