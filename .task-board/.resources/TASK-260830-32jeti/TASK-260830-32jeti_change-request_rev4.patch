+	host := liveHost(runner)
+	req := liveRequest(t)
+	got, err := host.Call(context.Background(), "/plugins/ax-provider-pi", req)
+	if err != nil {
+		t.Fatalf("Call: %v", err)
+	}
+	if string(got.Body) != `{"provider_id":"pi"}` {
+		t.Fatalf("Call body = %s", got.Body)
