/ would still fail with the guard removed, because os.ReadFile rejects\n968|\t// directories (EISDIR) on its own. A FIFO is the documented hazard\n969|\t// (README: os.Open blocks indefinitely on a FIFO), and only the\n970|\t// Mode().IsRegular check refuses it without blocking.\n971|\tfifo := filepath.Join(t.TempDir(), \"backend-fifo\")\n972|\tif err := syscall.Mkfifo(fifo, 0o600); err != nil {\n973|\t\tt.Fatalf(\"Mkfifo() error = %v\", err)\n974|\t}\n975|\tif _, err := terminalbackend.DigestFile(fifo); err == nil {\n976|\t\tt.Error(\"DigestFile(fifo) error = nil, want refusal for a non-regular file\")\n977|\t}\n978|}\n979|\n980|// TestErrorPredicatesAreExclusive guards the negative-evidence contract: a\n981|// refusal carries exactly one wire code, so a passing negative test cannot be\n982|// explained by overlapping predicates.\n983|func TestErrorPredicatesAreExclusive(t *testing.T) {\n984|\tt.Parallel()\n985|\n986|\tregistry := testRegistry(t)\n987|\tmustRegisterExternal(t, registry, \"com.example.term\")\n988|\n989|\tcases := []struct {\n990|\t\tname string\n991|\t\terr  error\n992|\t\twant func(error) bool\n993|\t}{\n994|\t\t{\"unknown\", func() error { _, err := registry.Resolve(\"com.example.gone\"); return err }(), terminalbackend.IsNotFound},\n995|\t\t{\"duplicate\", func() error {\n996|\t\t\treturn registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(\"com.example.term\"), testExternalRecord(\"com.example.term\"))\n997|\t\t}(), terminalbackend.IsAmbiguous},\n998|\t\t{\"drift\", func() error {\n999|\t\t\tdrifted := testExternalRecord(\"com.example.term\")\n(more lines below)"}}}
