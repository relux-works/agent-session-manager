{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c41b","stream":{"kind":"session","id":"01a07331-7853-7a51-8c8d-7bc0bf66c506"},"sequence":104,"recorded_at":1780531400000203,"record_type":"event","durability":"durable","causation_id":"0c99dc94-835c-41a8-b7dc-1156d61e2988","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0c99dc94-835c-41a8-b7dc-1156d61e2988","run_stream":{"kind":"run","id":"0c99dc94-835c-41a8-b7dc-1156d61e2988"},"task_stream":{"kind":"task","id":"af17bf7e-f43c-4052-96ce-6c992480867d"},"task_id":"af17bf7e-f43c-4052-96ce-6c992480867d","event":{"kind":"output","task_id":"af17bf7e-f43c-4052-96ce-6c992480867d","chunk":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(931 line(s) above)\n932|func TestDigestFile(t *testing.T) {\n933|\tt.Parallel()\n934|\n935|\tpayload := []byte(\"#!/bin/sh\\nexec ax-backend-term \\\"$@\\\"\\n\")\n936|\tpath := filepath.Join(t.TempDir(), \"ax-backend-term\")\n937|\tif err := os.WriteFile(path, payload, 0o755); err != nil {\n938|\t\tt.Fatalf(\"WriteFile() error = %v\", err)\n939|\t}\n940|\tsum := sha256.Sum256(payload)\n941|\twant := \"sha256:\" + hex.EncodeToString(sum[:])\n942|\tgot, err := terminalbackend.DigestFile(path)\n943|\tif err != nil {\n944|\t\tt.Fatalf(\"DigestFile() error = %v\", err)\n945|\t}\n946|\tif got != want {\n947|\t\tt.Errorf(\"DigestFile() = %q, want %q\", got, want)\n948|\t}\n949|\tlink := filepath.Join(t.TempDir(), \"link-backend-term\")\n950|\tif err := os.Symlink(path, link); err != nil {\n951|\t\tt.Fatalf(\"Symlink() error = %v\", err)\n952|\t}\n953|\tgotLink, err := terminalbackend.DigestFile(link)\n954|\tif err != nil {\n955|\t\tt.Fatalf(\"DigestFile(symlink) error = %v\", err)\n956|\t}\n957|\tif gotLink != want {\n958|\t\tt.Errorf(\"DigestFile(symlink) = %q, want %q\", gotLink, want)\n959|\t}\n960|\tif _, err := terminalbackend.DigestFile(filepath.Join(t.TempDir(), \"absent\")); err == nil {\n961|\t\tt.Error(\"DigestFile(absent) error = nil, want a failed read\")\n962|\t}\n963|\tif _, err := terminalbackend.DigestFile(t.TempDir()); err == nil {\n964|\t\tt.Error(\"DigestFile(directory) error = nil, want refusal for a non-regular file\")\n965|\t}\n966|\t// A FIFO pins the regular-file guard itself: the directory case above\n967|\t// would still fail with the guard removed, because os.ReadFile rejects\n968|\t// directories (EISDIR) on its own. A FIFO is the documented hazard\n969|\t// (README: os.Open blocks indefinitely on a FIFO), and only the\n970|\t// Mode().IsRegular check refuses it without blocking.\n971|\tfifo := filepath.Join(t.TempDir(), \"backend-fifo\")\n972|\tif err := syscall.Mkfifo(fifo, 0o600); err != nil {\n973|\t\tt.Fatalf(\"Mkfifo() error = %v\", err)\n974|\t}\n975|\tif _, err := terminalbackend.DigestFile(fifo); err == nil {\n976|\t\tt.Error(\"DigestFile(fifo) error = nil, want refusal for a non-regular file\")\n977|\t}\n978|}\n979|\n980|// TestErrorPredicatesAreExclusive guards the negative-evidence contract: a\n981|// refusal carries exactly one wire code, so a passing negative test cannot be\n(more lines below)"}}}
