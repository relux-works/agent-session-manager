{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bb","stream":{"kind":"session","id":"01a07303-b963-7e21-81f8-bb3541dfba40"},"sequence":184,"recorded_at":1780531400000363,"record_type":"event","durability":"durable","causation_id":"19e64aa2-5eb1-4345-85e5-fc361fc0d256","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"19e64aa2-5eb1-4345-85e5-fc361fc0d256","run_stream":{"kind":"run","id":"19e64aa2-5eb1-4345-85e5-fc361fc0d256"},"task_stream":{"kind":"task","id":"3192416b-9f70-4e50-8c5b-be979cd368ee"},"task_id":"3192416b-9f70-4e50-8c5b-be979cd368ee","event":{"kind":"output","task_id":"3192416b-9f70-4e50-8c5b-be979cd368ee","chunk":"{\n  \"chunk_id\": \"exec-10-1\",\n  \"command\": \"task-board worktree status 2>&1 | head -n 80\\necho \\\"===\\\"\\ntask-board worktree checkpoint --help 2>&1 | head -n 60\\necho \\\"===\\\"\\ntask-board worktree integrate --help 2>&1 | head -n 60\",\n  \"description\": \"Check worktree status and checkpoint help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"STORY-260830-2dy8oj  active\\n  path:       .temp/STORY-260830-2dy8oj/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2dy8oj (present)\\n  base:       main\\n  tip:        81305c8886ead674122f498ad2124051257c9467\\n  tree:       not checked out\\n  change-req: TASK-260830-3amrl9 rev 8 checkpointed (repository_delta=present, 14 changed path(s))\\n  change-req: TASK-260830-3ps1b1 rev 6 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-2jylym  active\\n  path:       .temp/STORY-260830-2jylym/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2jylym (present)\\n  base:       main\\n  tip:        adca16af03663682ec57993122c22c667813afc9\\n  tree:       not checked out\\n  change-req: TASK-260830-1bipsa rev 1 checkpointed (repository_delta=empty, 0 changed path(s))\\n  change-req: TASK-260830-33sfxc rev 7 accepted (repository_delta=present, 73 changed path(s))\\n  change-req: TASK-260830-34elja rev 2 checkpointed (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-2wdm5e  active\\n  path:       .temp/STORY-260830-2wdm5e/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2wdm5e (present)\\n  base:       main\\n  tip:        ad7275181ca82fc3fa29544e3893923a92d7b9d5\\n  tree:       not checked out\\n  change-req: TASK-260830-1pbx0c rev 6 checkpointed (repository_delta=present, 12 changed path(s))\\n  change-req: TASK-260830-236x9n rev 5 checkpointed (repository_delta=present, 19 changed path(s))\\n  change-req: TASK-260830-8x76g1 rev 16 accepted (repository_delta=present, 71 changed path(s))\\nSTORY-260830-323tpq  active\\n  path:       .temp/STORY-260830-323tpq/worktree (missing)\\n  branch:     task-board/story/STORY-260830-323tpq (present)\\n  base:       main\\n  tip:        48db30b59e5e1bbc5e0cf73ec2e0e0eec3d215d1\\n  tree:       not checked out\\n  change-req: TASK-260902-2ucdvw rev 1 ready (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-385twz  active\\n  path:       .temp/STORY-260830-385twz/worktree (missing)\\n  branch:     task-board/story/STORY-260830-385twz (present)\\n  base:       main\\n  tip:        6d602ba97d1fea8ab68fbc73b009a5f124bfffd0\\n  tree:       not checked out\\n  change-req: TASK-260830-3uessl rev 2 checkpointed (repository_delta=present, 9 changed path(s))\\n  change-req: TASK-260830-treeox rev 3 accepted (repository_delta=present, 15 changed path(s))\\nSTORY-260830-3jqsx1  active\\n  path:       .temp/STORY-260830-3jqsx1/worktree (present)\\n  branch:     task-board/story/STORY-260830-3jqsx1 (present)\\n  base:       main\\n  tip:        8fbc0523c3ed7ad012a6c036166fde04f96b8b41\\n  tree:       dirty\\n  lease:      held by RUN-260905-ea9a88\\n  blocked:    story lease is held by run RUN-260905-ea9a88\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-2890sd rev 5 checkpointed (repository_delta=present, 10 changed path(s))\\n  change-req: TASK-260830-32jeti rev 7 stale (repository_delta=present, 60 changed path(s))\\n  change-req: TASK-260830-qcosxq rev 3 checkpointed (repository_delta=present, 16 changed path(s))\\nSTORY-260830-3m2mw8  active\\n  path:       .temp/STORY-260830-3m2mw8/worktree (present)\\n  branch:     task-board/story/STORY-260830-3m2mw8 (present)\\n  base:       main\\n  tip:        adba01f7316e13f301496d31575ecc25e34a7cde\\n  tree:       dirty\\n  blocked:    managed worktree has uncommitted or untracked changes\\n  change-req: TASK-260830-1snnef rev 8 accepted (repository_delta=present, 17 changed path(s))\\n  change-req: TASK-260830-1zvmw7 rev 3 checkpointed (repository_delta=present, 11 changed path(s))\\n  change-req: TASK-260830-2xdt8t rev 3 checkpointed (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-4n0fo8  active\\n  path:       .temp/STORY-260830-4n0fo8/worktree (missing)\\n  branch:     task-board/story/STORY-260830-4n0fo8 (present)\\n  base:       main\\n  tip:        fc94e4ad4114bd25adacf4b5f6e3c51de4a18a7d\\n  tree:       not checked out\\n  change-req: TASK-260830-1tax26 rev 7 checkpointed (repository_delta=present, 37 changed path(s))\\n  change-req: TASK-260830-3esaam rev 9 checkpointed (repository_delta=present, 10 changed path(s))\\nSTORY-260830-jeaivu  active\\n  path:       .temp/STORY-260830-jeaivu/worktree (missing)\\n  branch:     task-board/story/STORY-260830-jeaivu (present)\\n  base:       main\\n  tip:        c0d42491d08bc6dca6c2322b84085cfce50b1217\\n  tree:       not checked out\\n  change-req: TASK-260830-17suox rev 5 checkpointed (repository_delta=present, 16 changed path(s))\\n  change-req: TASK-260830-1qf777 rev 5 accepted (repository_delta=present, 23 changed path(s))\\n  change-req: TASK-260830-2iint0 rev 3 checkpointed (repository_delta=present, 7 changed path(s))\\n===\\nCheckpoint an accepted Change Request revision.\\n\\nThe accepted candidate tree becomes one internal commit on the Story branch,\\ncreated under a compare-and-swap on the branch tip. The leaf remains integrating:\\nnothing is landed on trunk, and internal checkpoints only delimit later Task\\ndiffs and make the work recoverable before the final Story squash.\\n\\nA Change Request with repository_delta=empty creates no commit — its tree would\\nequal its parent's — and the leaf likewise remains integrating.\\n\\nOnly the tracked integration run bound to the accepted revision's producer role\\nand archetype may run this command. Reviewers, orchestrators, and other producer\\narchetypes are refused.\\n\\nUsage:\\n  task-board worktree checkpoint <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help   help for checkpoint\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\nLand the accepted story_final Change Request for a Story as ONE squash commit on\\ntrunk, perform the Story's done transition, and commit the Story's board delta\\nas a second, board-only commit.\\n\\nThis command runs in the control root — the repository's main working tree, on\\nthe configured trunk branch — but only from the tracked integration run whose\\nrole and archetype match the accepted revision's immutable producer binding.\\nReviewers, orchestrators, and other producer archetypes are refused. No other\\ncheckout is ever advanced.\\n\\nIt is idempotent. A crashed run leaves one durable transaction record; re-running\\nresumes the recorded phase rather than starting a second integration, and the\\nonly phase that offers a rollback is 'prepared' with trunk unmoved.\\n\\nOn a remote board it refuses with worktree_isolation_requires_local_board before\\nthe integration lock and before the transaction opens. The rationale is data\\nlocality, not authority: admission compares worktree bytes against the store's\\nown rendering, and no single process holds both operands on a remote board.\\n\\nUsage:\\n  task-board worktree integrate <STORY-ID> [flags]\\n\\nFlags:\\n      --commit-time string   explicit RFC3339 commit time; required when version_control.confirm is enabled, and applied to both the author and the committer date\\n      --cr string            Change Request ID (the element the accepted story_final CR is attached to)\\n  -h, --help                 help for integrate\\n      --revision int         accepted Change Request revision\\n      --rollback             roll back a transaction at phase prepared with trunk unmoved instead of resuming it; available in no other phase\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 8287,\n  \"original_output_tokens\": 2072,\n  \"truncated\": false\n}"}}}
