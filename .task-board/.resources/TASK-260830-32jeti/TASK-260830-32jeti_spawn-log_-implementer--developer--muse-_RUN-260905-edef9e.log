{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6dd","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":457,"recorded_at":1780531400000909,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"f8bbff3b-b0f6-4ae2-8f2c-7099846a1c50"},"task_id":"f8bbff3b-b0f6-4ae2-8f2c-7099846a1c50","event":{"kind":"output","task_id":"f8bbff3b-b0f6-4ae2-8f2c-7099846a1c50","chunk":"Read text file `internal/provhost/inventory_test.go`.\n(389 line(s) above)\n390|\t\t\"and MUST NOT contain <code>body</code>\",\n391|\t\t\"Envelope and body\",\n392|\t\t\"unknown members are protocol errors under major version 2\",\n393|\t\t\"The host MUST terminate a plugin that exceeds its deadline and report\",\n394|\t\t\"<code>provider_timeout</code>\",\n395|\t\t\"It MUST redact environment and stderr before\",\n396|\t\t\"logging\",\n397|\t} {\n398|\t\trequireQuote(t, document, excerpt, \"7.2\")\n399|\t}\n400|}\n401|\n402|// TestSection151ProviderRowIsPinned quotes the Section 15.1 provider\n403|// row behind the local failure mapping: recognizable majors yield\n404|// incompatible_protocol, everything else unusable yields\n405|// provider_protocol_error, and a different major's payload is never\n406|// trusted.\n407|func TestSection151ProviderRowIsPinned(t *testing.T) {\n408|\tdocument, err := specdoc.Load()\n409|\tif err != nil {\n410|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n411|\t}\n412|\tfor _, excerpt := range []string{\n413|\t\t\"The host accepts no child error object, terminates/waits for exit as applicable, and emits its own local Error 1.0.0\",\n414|\t\t\"<code>incompatible_protocol</code> for a recognizable major mismatch, otherwise <code>provider_protocol_error</code>\",\n415|\t\t\"Receivers MUST NOT parse a different major\",\n416|\t\t\"payload far enough to trust its error code, retryable bit, details, or\",\n417|\t} {\n418|\t\trequireQuote(t, document, excerpt, \"15.1\")\n419|\t}\n420|}\n421|\n422|// TestStatusRecoveryRulesArePinned quotes the Section 7.5 recovery\n423|// sentences behind DecodeStatusOutcome: the evolving status read, the\n424|// unknown quarantine, and the state/nullability table.\n425|func TestStatusRecoveryRulesArePinned(t *testing.T) {\n426|\tdocument, err := specdoc.Load()\n427|\tif err != nil {\n428|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n429|\t}\n430|\tfor _, excerpt := range []string{\n431|\t\t\"is the required evolving lost-response recovery\",\n432|\t\t\"An unknown transaction MUST return state\",\n433|\t\t\"<code>unknown</code>; the host MUST NOT infer success\",\n434|\t\t\"An unreadable or\",\n435|\t\t\"integrity-invalid transaction MUST fail with <code>integrity_failure</code> and\",\n436|\t\t\"MUST be quarantined rather than represented as a successful status object\",\n437|\t\t\"<code>unknown</code> requires null\",\n438|\t\t\"requires all three non-null\",\n439|\t} {\n440|\t\trequireQuote(t, document, excerpt, \"7.5\")\n441|\t}\n442|}\n443|\n444|// TestStableCodesAreRegistered pins every refusal code this package\n445|// emits against the pinned error registry and the exact exit the host\n446|// surfaces, and agrees with the axerror wire table.\n447|func TestStableCodesAreRegistered(t *testing.T) {\n448|\tregistered := map[string]int{}\n449|\tfor _, row := range catalog.Current().Errors {\n450|\t\tregistered[string(row.Code)] = row.ExitCode\n451|\t}\n452|\tfor code, wantExit := range map[string]int{\n453|\t\t\"invalid_config\":          3,\n454|\t\t\"provider_protocol_error\": 13,\n455|\t\t\"incompatible_protocol\":   6,\n456|\t\t\"provider_process_failed\": 13,\n457|\t\t\"provider_timeout\":        13,\n458|\t\t\"integrity_failure\":       9,\n459|\t} {\n460|\t\tgotExit, ok := registered[code]\n461|\t\tif !ok {\n462|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n463|\t\t}\n464|\t\tif gotExit != wantExit {\n465|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n466|\t\t}\n467|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n468|\t\tif err != nil {\n469|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n470|\t\t}\n471|\t\tif gotWire != wantExit {\n472|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n473|\t\t}\n474|\t}\n475|\tt.Logf(\"refusal code coverage: 6/6 package codes registered with pinned exits\")\n476|}\n477|\n478|// TestRefusalConstructorsAreTotal proves the fallible-constructor error\n479|// path never fires in practice: every constructor returns a failure and\n480|// a nil error across representative dynamic causes. The sites recorded\n481|// here are test lines, not production sites, so every key this test adds\n482|// to the exercised set is removed before it returns, keeping the\n483|// reverse-direction audit exact.\n484|func TestRefusalConstructorsAreTotal(t *testing.T) {\n485|\tvar beforeSites, beforeCodes []any\n486|\texercisedRefusalSites.Range(func(key, _ any) bool { beforeSites = append(beforeSites, key); return true })\n487|\tobservedCodes.Range(func(key, _ any) bool { beforeCodes = append(beforeCodes, key); return true })\n488|\tt.Cleanup(func() {\n489|\t\tkeepSites := map[any]bool{}\n490|\t\tfor _, key := range beforeSites {\n491|\t\t\tkeepSites[key] = true\n492|\t\t}\n493|\t\texercisedRefusalSites.Range(func(key, _ any) bool {\n494|\t\t\tif !keepSites[key] {\n495|\t\t\t\texercisedRefusalSites.Delete(key)\n496|\t\t\t}\n497|\t\t\treturn true\n498|\t\t})\n499|\t\tkeepCodes := map[any]bool{}\n500|\t\tfor _, key := range beforeCodes {\n501|\t\t\tkeepCodes[key] = true\n502|\t\t}\n503|\t\tobservedCodes.Range(func(key, _ any) bool {\n504|\t\t\tif !keepCodes[key] {\n505|\t\t\t\tobservedCodes.Delete(key)\n506|\t\t\t}\n507|\t\t\treturn true\n508|\t\t})\n509|\t})\n510|\tcause := fmt.Errorf(\"fake: dynamic cause\")\n511|\tlongCause := fmt.Errorf(\"fake: %s\", strings.Repeat(\"x\", 300))\n512|\tfor _, kase := range []struct {\n513|\t\tname string\n514|\t\tcall func() (*axerror.Error, error)\n515|\t\tcode string\n516|\t}{\n517|\t\t{\"invalid\", func() (*axerror.Error, error) { return failInvalid(\"fake\") }, \"invalid_config\"},\n518|\t\t{\"protocol\", func() (*axerror.Error, error) { return failProtocol(\"fake\", \"member\") }, \"provider_protocol_error\"},\n519|\t\t{\"mismatch\", func() (*axerror.Error, error) { return failMismatch(\"fake\", \"3.0.0\") }, \"incompatible_protocol\"},\n520|\t\t{\"process with cause\", func() (*axerror.Error, error) { return failProcess(\"fake\", cause) }, \"provider_process_failed\"},\n521|\t\t{\"process with long cause\", func() (*axerror.Error, error) { return failProcess(\"fake\", longCause) }, \"provider_process_failed\"},\n522|\t\t{\"process without cause\", func() (*axerror.Error, error) { return failProcess(\"fake\", nil) }, \"provider_process_failed\"},\n523|\t\t{\"timeout\", func() (*axerror.Error, error) { return failTimeout(\"fake\", 100) }, \"provider_timeout\"},\n524|\t\t{\"integrity\", func() (*axerror.Error, error) { return failIntegrity(\"fake\", \"unknown\", \"m\", \"t\") }, \"integrity_failure\"},\n525|\t} {\n526|\t\tt.Run(kase.name, func(t *testing.T) {\n527|\t\t\tfailure, err := kase.call()\n528|\t\t\tif err != nil {\n529|\t\t\t\tt.Fatalf(\"constructor error = %v, want nil\", err)\n530|\t\t\t}\n531|\t\t\tif failure == nil || string(failure.Code()) != kase.code {\n532|\t\t\t\tt.Fatalf(\"constructor failure = %v, want code %s\", failure, kase.code)\n533|\t\t\t}\n534|\t\t})\n535|\t}\n536|}"}}}
