{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a9","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":431,"recorded_at":1780531400000857,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"0d7cb204-a723-4f91-a679-3c2d9251d2ae"},"task_id":"0d7cb204-a723-4f91-a679-3c2d9251d2ae","event":{"kind":"output","task_id":"0d7cb204-a723-4f91-a679-3c2d9251d2ae","chunk":"Read text file `internal/provhost/protocol_test.go`.\n(279 line(s) above)\n280|\t\tt.Fatalf(\"DecodeResponse code = %v, want the bound child code capability_unavailable\", err)\n281|\t}\n282|\tif failureExit(t, err) != 6 {\n283|\t\tt.Fatalf(\"DecodeResponse exit = %d, want 6\", failureExit(t, err))\n284|\t}\n285|}\n286|\n287|// TestDecodeResponseRecognizableMajorMismatch proves a foreign major is\n288|// reported as incompatible_protocol without trusting the payload: the\n289|// frame carries a forged error object whose code must never surface.\n290|func TestDecodeResponseRecognizableMajorMismatch(t *testing.T) {\n291|\tfor _, version := range []string{\"3.0.0\", \"1.0.0\", \"10.2.3\"} {\n292|\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"forged_code\",\"message\":\"forged\",\"exit_code\":0,\"retryable\":true,\"details\":{}}}`)\n293|\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n294|\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n295|\t\t\tt.Fatalf(\"DecodeResponse(%s) code = %v, want incompatible_protocol\", version, err)\n296|\t\t}\n297|\t\tobserved, ok := failureObject(t, err).Detail(\"observed\")\n298|\t\tif !ok || observed != version {\n299|\t\t\tt.Fatalf(\"DecodeResponse(%s) observed = %v, want the foreign version %q\", version, observed, version)\n300|\t\t}\n301|\t\tif failureExit(t, err) != 6 {\n302|\t\t\tt.Fatalf(\"DecodeResponse(%s) exit = %d, want 6\", version, failureExit(t, err))\n303|\t\t}\n304|\t\tif strings.Contains(err.Error(), \"forged_code\") {\n305|\t\t\tt.Fatalf(\"foreign payload leaked into the local failure: %v\", err)\n306|\t\t}\n307|\t}\n308|}\n309|\n310|// TestDecodeResponseRefusals proves every unusable frame shape fails with\n311|// provider_protocol_error, never with a partial result. The production\n312|// entry point is DecodeResponse.\n313|func TestDecodeResponseRefusals(t *testing.T) {\n314|\twant := mustUUIDv7(t, testRequestID)\n315|\tokFrame := func(members string) []byte {\n316|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n317|\t}\n318|\tvalidBody := `{\"provider_id\":\"pi\"}`\n319|\t// Each row names the refusal arm it must reach: the member detail\n320|\t// and the rule detail. A deleted required-member gate slides the\n321|\t// missing member to a lower arm with the same code but a different\n322|\t// member or detail, and the slide reddens here. The malformed\n323|\t// versions below carry a foreign major (\"3\" or empty) so a deleted\n324|\t// parseMajor arm promotes them to incompatible_protocol instead of\n325|\t// collapsing back onto this code. The non-numeric-major rows carry a\n326|\t// numeric rest (\".0.0\") so only the major-digit branch can refuse\n327|\t// them: with a non-numeric rest the rest-digit branch would fire\n328|\t// first and the misclassification would collapse back to this code.\n329|\t// The full five-branch parseMajor enumeration lives in the derived\n330|\t// refusal-arm inventory; these rows are its entry-point witnesses.\n331|\tversionFrame := func(version string) []byte {\n332|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n333|\t}\n334|\tfor _, kase := range []struct {\n335|\t\tname   string\n336|\t\tframe  []byte\n337|\t\tmember string\n338|\t\tdetail string\n339|\t}{\n340|\t\t{\"empty\", []byte{}, \"\", \"not a JSON object\"},\n341|\t\t{\"not JSON\", []byte(`not json`), \"\", \"not a JSON object\"},\n342|\t\t{\"truncated\", []byte(`{\"protocol\":`), \"protocol\", \"not a JSON object\"},\n343|\t\t{\"array\", []byte(`[1,2]`), \"\", \"not a JSON object\"},\n344|\t\t{\"scalar\", []byte(`true`), \"\", \"not a JSON object\"},\n345|\t\t{\"trailing data\", append(successFrame(t, testRequestID, validBody), 'x'), \"\", \"trailing data after the object\"},\n346|\t\t{\"trailing valid value\", append(successFrame(t, testRequestID, validBody), ' ', '{', '}'), \"\", \"trailing data after the object\"},\n347|\t\t{\"duplicate member\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"request_id\", \"duplicate member\"},\n348|\t\t{\"missing protocol\", []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"missing member\"},\n349|\t\t{\"missing version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"missing member\"},\n350|\t\t{\"missing request id\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"ok\":true,\"body\":{}}`), \"request_id\", \"missing member\"},\n351|\t\t{\"missing ok\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`), \"ok\", \"missing member\"},\n352|\t\t{\"missing body on success\", okFrame(`\"ok\":true`), \"body\", \"missing member\"},\n353|\t\t{\"missing error on failure\", okFrame(`\"ok\":false`), \"error\", \"missing member\"},\n354|\t\t{\"body on failure\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`), \"body\", \"failure envelope carries body\"},\n355|\t\t{\"error on success\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`), \"error\", \"success envelope carries error\"},\n356|\t\t{\"unknown member\", okFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), \"diagnostics\", \"unknown member\"},\n357|\t\t{\"ok not boolean\", okFrame(`\"ok\":\"yes\",\"body\":{}`), \"ok\", \"member is not a boolean\"},\n358|\t\t{\"wrong protocol\", []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"not a provider envelope\"},\n359|\t\t{\"protocol not string\", []byte(`{\"protocol\":7,\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"not a provider envelope\"},\n360|\t\t{\"minor version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.1.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n361|\t\t{\"garbage version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"v2\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n362|\t\t{\"short version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n363|\t\t{\"empty version part\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2..0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n364|\t\t{\"non-numeric version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"a.b.c\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n365|\t\t{\"foreign two-part version\", versionFrame(\"3.0\"), \"protocol_version\", \"unsupported protocol version\"},\n366|\t\t{\"foreign four-part version\", versionFrame(\"3.0.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n367|\t\t{\"foreign empty major\", versionFrame(\".0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n368|\t\t{\"foreign empty minor\", versionFrame(\"3..0\"), \"protocol_version\", \"unsupported protocol version\"},\n369|\t\t{\"foreign non-numeric rest\", versionFrame(\"3.b.c\"), \"protocol_version\", \"unsupported protocol version\"},\n370|\t\t{\"foreign non-numeric major\", versionFrame(\"a.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n371|\t\t{\"foreign alphanumeric major\", versionFrame(\"2a.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n372|\t\t{\"foreign negative major\", versionFrame(\"-1.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n373|\t\t{\"foreign plus major\", versionFrame(\"+3.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n374|\t\t{\"version not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"member is not a string\"},\n375|\t\t{\"empty version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n376|\t\t{\"request id not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":7,\"ok\":true,\"body\":{}}`), \"request_id\", \"member is not a string\"},\n377|\t\t{\"request id not UUIDv7\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`), \"request_id\", \"request_id is not a UUIDv7\"},\n378|\t\t{\"request id mismatch\", successFrame(t, testOtherID, validBody), \"request_id\", \"request_id does not match the request\"},\n379|\t\t{\"body array on success\", okFrame(`\"ok\":true,\"body\":[]`), \"body\", \"body is not a JSON object\"},\n380|\t\t{\"body scalar on success\", okFrame(`\"ok\":true,\"body\":1`), \"body\", \"body is not a JSON object\"},\n381|\t\t{\"error scalar on failure\", okFrame(`\"ok\":false,\"error\":1`), \"error\", \"error is not a JSON object\"},\n382|\t\t{\"error unbound version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`), \"error\", \"error is not a bound Structured Error 1.0.0\"},\n383|\t} {\n384|\t\tt.Run(kase.name, func(t *testing.T) {\n385|\t\t\t_, err := DecodeResponse(kase.frame, want)\n386|\t\t\trequireFrameRefusal(t, err, kase.member, kase.detail)\n387|\t\t})\n388|\t}\n389|}\n390|\n391|// TestDecodeResponseRefusesOversizeFrame proves the 8 MiB bound from the\n392|// decoding side: a frame one byte over the limit fails without being\n393|// parsed, and a frame exactly at the limit is accepted.\n394|// specFrameLimitBytes is the absolute Section 7.2 bound, stated as a\n395|// literal rather than derived from MaxFrameBytes: the fixtures below pin\n396|// the constant to the specification text, so weakening the constant\n397|// reddens here instead of scaling the fixtures along with it.\n398|const specFrameLimitBytes = 8 << 20\n399|\n400|func TestDecodeResponseRefusesOversizeFrame(t *testing.T) {\n401|\tif MaxFrameBytes != specFrameLimitBytes {\n402|\t\tt.Fatalf(\"MaxFrameBytes = %d, want the specified %d\", MaxFrameBytes, specFrameLimitBytes)\n403|\t}\n404|\twant := mustUUIDv7(t, testRequestID)\n405|\tbuild := func(pad int) []byte {\n406|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n407|\t}\n408|\t// The pad contributes exactly pad bytes, so base+pad is the frame\n409|\t// size. One byte over the limit must fail; exactly at it must pass.\n410|\tbase := len(build(0))\n411|\tover := build(specFrameLimitBytes - base + 1)\n412|\tif len(over) != specFrameLimitBytes+1 {\n413|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n414|\t}\n415|\t_, err := DecodeResponse(over, want)\n416|\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n417|\tframe := build(specFrameLimitBytes - base)\n418|\tif len(frame) != specFrameLimitBytes {\n419|\t\tt.Fatalf(\"boundary fixture is %d bytes, want exactly %d\", len(frame), specFrameLimitBytes)\n420|\t}\n421|\tif _, err := DecodeResponse(frame, want); err != nil {\n422|\t\tt.Fatalf(\"boundary DecodeResponse: %v\", err)\n423|\t}\n424|}\n425|\n426|// TestDecodeResponseRefusesNonUTF8 proves the UTF-8 gate: invalid bytes\n427|// fail even when the surrounding shape would parse.\n428|func TestDecodeResponseRefusesNonUTF8(t *testing.T) {\n429|\tframe := append([]byte{}, successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`)...)\n430|\tframe[len(frame)-3] = 0xff\n431|\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n432|\trequireFrameRefusal(t, err, \"\", \"frame is not UTF-8\")\n433|}\n434|\n435|// TestEncodeRequestRefusesOversizeFrame proves the 8 MiB bound from the\n436|// framing side with the same exact-boundary technique as the decoding\n437|// side: a request one byte over the limit fails, and a request exactly at\n438|// the limit frames. The pad contributes exactly pad bytes, so a halved or\n439|// doubled bound reddens here instead of scaling along.\n440|func TestEncodeRequestRefusesOversizeFrame(t *testing.T) {\n441|\tif MaxFrameBytes != specFrameLimitBytes {\n442|\t\tt.Fatalf(\"MaxFrameBytes = %d, want the specified %d\", MaxFrameBytes, specFrameLimitBytes)\n443|\t}\n444|\tnow := mustInstant(t, testNow)\n445|\tbuild := func(pad int) (Request, int) {\n446|\t\treq := testRequest(t)\n447|\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", pad) + `\"}`)\n448|\t\tframe, err := EncodeRequest(req, now)\n449|\t\tif err != nil {\n450|\t\t\treturn req, -1\n451|\t\t}\n452|\t\treturn req, len(frame)\n453|\t}\n454|\t_, base := build(0)\n455|\toverPad := specFrameLimitBytes - base + 1\n456|\toverReq, overSize := build(overPad)\n457|\tif overSize != -1 {\n458|\t\tt.Fatalf(\"oversize request framed at %d bytes, want refusal over %d\", overSize, specFrameLimitBytes)\n459|\t}\n460|\tif _, err := EncodeRequest(overReq, now); err == nil {\n461|\t\tt.Fatal(\"oversize EncodeRequest succeeded, want invalid_config\")\n462|\t} else {\n463|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request frame exceeds 8 MiB\")\n464|\t}\n465|\tboundaryReq, boundarySize := build(specFrameLimitBytes - base)\n466|\tif boundarySize != specFrameLimitBytes {\n467|\t\tt.Fatalf(\"boundary request is %d bytes, want exactly %d\", boundarySize, specFrameLimitBytes)\n468|\t}\n469|\tif _, err := EncodeRequest(boundaryReq, now); err != nil {\n470|\t\tt.Fatalf(\"boundary EncodeRequest: %v\", err)\n471|\t}\n472|}"}}}
