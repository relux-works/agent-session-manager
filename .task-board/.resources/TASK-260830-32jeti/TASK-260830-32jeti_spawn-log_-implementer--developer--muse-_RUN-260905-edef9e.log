t\t\treturn invalidJSON(\"lone low surrogate escape is forbidden\")\n545|\t\t\t\t}\n546|\t\t\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\n547|\t\t\t\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n548|\t\t\t\t0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\n549|\t\t\t\t0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:\n550|\t\t\t\treturn invalidJSON(\"unescaped control character in string\")\n551|\t\t\t}\n552|\t\t}\n553|\t\treturn invalidJSON(\"unterminated JSON string\")\n554|\tstringComplete:\n555|\t}\n556|\treturn nil\n557|}\n558|\n559|func readUTF16Escape(input []byte, start int) (uint16, int, error) {\n560|\tif start < 0 || start+6 > len(input) || input[start] != '\\\\' || input[start+1] != 'u' {\n561|\t\treturn 0, start, invalidJSON(\"expected UTF-16 escape\")\n562|\t}\n563|\tvalue, err := strconv.ParseUint(string(input[start+2:start+6]), 16, 16)\n564|\tif err != nil {\n565|\t\treturn 0, start, invalidJSON(\"malformed UTF-16 escape\")\n566|\t}\n567|\treturn uint16(value), start + 6, nil\n568|}\n569|\n570|func invalidJSON(format string, arguments ...any) error {\n571|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidJSON, fmt.Sprintf(format, arguments...))\n572|}\n573|\n574|func invalidIdentity(format string, arguments ...any) error {\n575|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidIdentity, fmt.Sprintf(format, arguments...))\n576|}"}}}
