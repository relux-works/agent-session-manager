{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d9","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":455,"recorded_at":1780531400000905,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"ea30d99c-4751-48a6-a5d4-11dfe40ec9b7"},"task_id":"ea30d99c-4751-48a6-a5d4-11dfe40ec9b7","event":{"kind":"output","task_id":"ea30d99c-4751-48a6-a5d4-11dfe40ec9b7","chunk":"Read text file `internal/canonicaljson/canonical.go`.\n(379 line(s) above)\n380|}\n381|\n382|func requiredStringMember(object map[string]any, name string) (string, error) {\n383|\tvalue, ok := object[name]\n384|\tif !ok {\n385|\t\treturn \"\", invalidIdentity(\"identity input requires string member %s\", name)\n386|\t}\n387|\ttext, ok := value.(string)\n388|\tif !ok || text == \"\" {\n389|\t\treturn \"\", invalidIdentity(\"identity input member %s must be a non-empty string\", name)\n390|\t}\n391|\treturn text, nil\n392|}\n393|\n394|func decodeStrict(input []byte) (any, error) {\n395|\tif len(input) == 0 {\n396|\t\treturn nil, invalidJSON(\"input is empty\")\n397|\t}\n398|\tif !utf8.Valid(input) {\n399|\t\treturn nil, invalidJSON(\"input is not valid UTF-8\")\n400|\t}\n401|\tif err := validateSurrogateEscapes(input); err != nil {\n402|\t\treturn nil, err\n403|\t}\n404|\n405|\tdecoder := json.NewDecoder(bytes.NewReader(input))\n406|\tdecoder.UseNumber()\n407|\tvalue, err := decodeValue(decoder, 0)\n408|\tif err != nil {\n409|\t\treturn nil, err\n410|\t}\n411|\tif token, err := decoder.Token(); !errors.Is(err, io.EOF) {\n412|\t\tif err != nil {\n413|\t\t\treturn nil, invalidJSON(\"read trailing JSON data: %v\", err)\n414|\t\t}\n415|\t\treturn nil, invalidJSON(\"unexpected trailing JSON token %v\", token)\n416|\t}\n417|\treturn value, nil\n418|}\n419|\n420|// decodeValue decodes one logical JSON value. depth counts the containers\n421|// already open around this value, so the top-level value is decoded at depth 0\n422|// and a container at depth maxNestingDepth-1 is the last one allowed to open.\n423|func decodeValue(decoder *json.Decoder, depth int) (any, error) {\n424|\ttoken, err := decoder.Token()\n425|\tif err != nil {\n426|\t\treturn nil, invalidJSON(\"decode JSON token: %v\", err)\n427|\t}\n428|\tdelimiter, ok := token.(json.Delim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n470|\t\t}\n471|\t\tend, err := decoder.Token()\n472|\t\tif err != nil || end != json.Delim(']') {\n473|\t\t\treturn nil, invalidJSON(\"decode array terminator: %v\", err)\n474|\t\t}\n475|\t\treturn array, nil\n476|\tdefault:\n477|\t\treturn nil, invalidJSON(\"unexpected delimiter %q\", delimiter)\n478|\t}\n479|}\n480|\n481|// validateAXNumbers is the AX decoder half of the split documented under\n482|// DIVISION OF GUARANTEES on Canonicalize. It walks the decoded value and\n483|// refuses every literal the common logical data model forbids, on the\n484|// json.Number token rather than on a host double, so an unsafe integer is\n485|// rejected instead of rounded. Canonicalize deliberately does not call it;\n486|// every exported entry point that promises the AX number model does.\n487|func validateAXNumbers(value any) error {\n488|\tswitch typed := value.(type) {\n489|\tcase json.Number:\n490|\t\tliteral := typed.String()\n491|\t\tif strings.ContainsAny(literal, \".eE\") {\n492|\t\t\treturn invalidIdentity(\"floating-point number %q is forbidden by the AX common model\", literal)\n493|\t\t}\n494|\t\tinteger, err := strconv.ParseInt(literal, 10, 64)\n495|\t\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n496|\t\t\treturn invalidIdentity(\"integer %q is outside the AX safe-integer interval\", literal)\n497|\t\t}\n498|\tcase []any:\n499|\t\tfor _, element := range typed {\n500|\t\t\tif err := validateAXNumbers(element); err != nil {\n501|\t\t\t\treturn err\n502|\t\t\t}\n503|\t\t}\n504|\tcase map[string]any:\n505|\t\tfor _, member := range typed {\n506|\t\t\tif err := validateAXNumbers(member); err != nil {\n507|\t\t\t\treturn err\n508|\t\t\t}\n509|\t\t}\n(more lines below)"}}}
