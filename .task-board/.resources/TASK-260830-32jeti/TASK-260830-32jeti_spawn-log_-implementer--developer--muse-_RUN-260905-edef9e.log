{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c719","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":487,"recorded_at":1780531400000969,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"call_id":"call_01a070b0d2ec7c219119b3d0cff20136","text":"Read text file `internal/provhost/conformance_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"encoding/json\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file is the conformance harness: scripted-plugin sequences\n15|// driven through the production Host.Call entry point, asserting the\n16|// operation-layer decoders agree with the transport on the same\n17|// bytes. Every sequence uses a fresh scriptRunner per process and\n18|// counts spawned processes, so a hidden retry or an ambient cache\n19|// would redden the spawn assertions rather than passing silently.\n20|\n21|// childFailureFrameFor builds a failure envelope carrying a genuine\n22|// bound child error for the named registered code, through the\n23|// production axerror entry point. The code must be registered for\n24|// Structured Error 1.0.0, which the provider 2.x binding requires.\n25|func childFailureFrameFor(t *testing.T, want, code, message string) []byte {\n26|\tt.Helper()\n27|\tchild, err := axerror.New(axerror.Spec{\n28|\t\tVersion: axerror.Version100,\n29|\t\tCode:    axerror.Code(code),\n30|\t\tMessage: message,\n31|\t\tDetails: axerror.Details{},\n32|\t})\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"axerror.New(%q): %v\", code, err)\n35|\t}\n36|\traw, err := json.Marshal(child)\n37|\tif err != nil {\n38|\t\tt.Fatalf(\"Marshal child: %v\", err)\n39|\t}\n40|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":false,\"error\":` + string(raw) + `}`)\n41|}\n42|\n43|// frameFor builds a single-line success envelope: the contract\n44|// fixtures are pretty-printed in the document, but the wire carries\n45|// one JSONL line, so bodies compact to that line here.\n46|func frameFor(t *testing.T, requestID, body string) []byte {\n47|\tt.Helper()\n48|\tvar compacted bytes.Buffer\n49|\tif err := json.Compact(&compacted, []byte(body)); err != nil {\n50|\t\tt.Fatalf(\"compact fixture: %v\", err)\n51|\t}\n52|\treturn successFrame(t, requestID, compacted.String())\n53|}\n54|\n55|// callWithBody starts one Host.Call for the operation with the canned\n56|// response frame and returns the success body.\n57|func callWithBody(t *testing.T, runner *scriptRunner, operation Operation, requestID string, frame []byte) []byte {\n58|\tt.Helper()\n59|\thost := liveHost(runner)\n60|\treq := liveRequest(t)\n61|\treq.Operation = operation\n62|\treq.RequestID = mustUUIDv7(t, requestID)\n63|\trunner.steps = append(runner.steps, okStep(Result{Stdout: frame, ExitCode: 0}))\n64|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"%s Call: %v\", operation, err)\n67|\t}\n68|\treturn got.Body\n69|}\n70|\n71|// TestManifestAndProbeThroughCall proves the manifest and probe\n72|// decoders agree with the transport: the exact bytes one plugin\n73|// process returned pass both DecodeResponse and the operation\n74|// decoder, for both operations in registry order.\n75|func TestManifestAndProbeThroughCall(t *testing.T) {\n76|\trunner := &scriptRunner{}\n77|\tmanifestBody := callWithBody(t, runner, OpManifest, testRequestID, frameFor(t, testRequestID, specManifestExample))\n78|\tif err := DecodeManifest(manifestBody); err != nil {\n79|\t\tt.Fatalf(\"manifest through Call: %v\", err)\n80|\t}\n81|\tprobeBody := callWithBody(t, runner, OpProbe, testOtherID, frameFor(t, testOtherID, specProbeExample))\n82|\tif err := DecodeProbe(probeBody); err != nil {\n83|\t\tt.Fatalf(\"probe through Call: %v\", err)\n84|\t}\n85|\tif runner.spawned() != 2 {\n86|\t\tt.Fatalf(\"spawned %d processes, want one per operation\", runner.spawned())\n87|\t}\n88|\tfor index, call := range runner.calls {\n89|\t\tvar decoded struct {\n90|\t\t\tOperation string `json:\"operation\"`\n91|\t\t}\n92|\t\tif err := json.Unmarshal(call.stdin, &decoded); err != nil {\n93|\t\t\tt.Fatalf(\"call %d stdin is not JSON: %v\", index, err)\n94|\t\t}\n95|\t\twant := string([]Operation{OpManifest, OpProbe}[index])\n96|\t\tif decoded.Operation != want {\n97|\t\t\tt.Fatalf(\"call %d operation = %q, want %q\", index, decoded.Operation, want)\n98|\t\t}\n99|\t}\n100|}\n101|\n102|// TestUnknownOperationThroughCallStartsNoProcess proves dispatch\n103|// refuses locally: Host.Call with an unknown operation returns\n104|// invalid_config without touching the Runner.\n105|func TestUnknownOperationThroughCallStartsNoProcess(t *testing.T) {\n106|\trunner := &scriptRunner{}\n107|\thost := liveHost(runner)\n108|\treq := liveRequest(t)\n109|\treq.Operation = \"reboot\"\n110|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n111|\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n112|\tif runner.spawned() != 0 {\n113|\t\tt.Fatalf(\"unknown operation spawned %d processes, want none\", runner.spawned())\n114|\t}\n115|}\n116|\n117|// TestResumeThroughCall proves the normative resume plan travels the\n118|// transport and validates for its provider, profile, and platform,\n119|// with the profile_mapping equal to the Section 7.7 mapping.\n120|func TestResumeThroughCall(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
