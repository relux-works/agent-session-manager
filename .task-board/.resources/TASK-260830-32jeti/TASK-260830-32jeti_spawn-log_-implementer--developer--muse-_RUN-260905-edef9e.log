{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c535","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":245,"recorded_at":1780531400000485,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"4d3e2ad8-6363-48ea-8015-294436bd198f"},"task_id":"4d3e2ad8-6363-48ea-8015-294436bd198f","event":{"kind":"output","task_id":"4d3e2ad8-6363-48ea-8015-294436bd198f","chunk":"Read text file `internal/provhost/runner_test.go`.\n(499 line(s) above)\n500|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n501|\t\tt.Fatalf(\"WriteFile: %v\", err)\n502|\t}\n503|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n504|\tgot, err := host.Call(context.Background(), script, liveRequest(t))\n505|\tif err != nil {\n506|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n507|\t}\n508|\tif string(got.Body) != `{\"provider_id\":\"echo\"}` {\n509|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n510|\t}\n511|}\n512|\n513|// TestExecRunnerEnforcesDeadline drives the production kill path: a\n514|// plugin that sleeps past the deadline is terminated and reported as\n515|// provider_timeout.\n516|func TestExecRunnerEnforcesDeadline(t *testing.T) {\n517|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n518|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n519|\t}\n520|\tscript := filepath.Join(t.TempDir(), \"ax-provider-sleep\")\n521|\tif err := os.WriteFile(script, []byte(\"#!/bin/sh\\nsleep 30\\n\"), 0o700); err != nil {\n522|\t\tt.Fatalf(\"WriteFile: %v\", err)\n523|\t}\n524|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n525|\treq := liveRequest(t)\n526|\tstamp, err := scalar.ParseTimestamp(time.Now().Add(300 * time.Millisecond).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n527|\tif err != nil {\n528|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n529|\t}\n530|\treq.Deadline = stamp\n531|\tstart := time.Now()\n532|\t_, err = host.Call(context.Background(), script, req)\n533|\telapsed := time.Since(start)\n534|\tif elapsed > 20*time.Second {\n535|\t\tt.Fatalf(\"Call took %v, want termination near the deadline\", elapsed)\n536|\t}\n537|\t// Returning before the drain delay shows the wait did not linger\n538|\t// for pipe EOF after the deadline kill. What the group kill buys\n539|\t// beyond Setpgid/Kill consistency is unknown on this platform:\n540|\t// removing the Cancel alone still returns in ~300ms here, while\n541|\t// disabling Setpgid delays past 2s — so this pins termination\n542|\t// latency, not detached-descendant fate.\n543|\tif elapsed >= waitDrainDelay {\n544|\t\tt.Fatalf(\"Call took %v, want group termination well before the %v drain delay\", elapsed, waitDrainDelay)\n545|\t}\n546|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n547|}\n548|\n549|// TestExecRunnerReportsCrashExit drives the production exit-code path: a\n550|// real plugin that exits 3 without answering is provider_process_failed,\n551|// while one that exits 0 without answering is provider_protocol_error.\n552|// Discarding ExitCode in ExecRunner promotes the crash to a protocol\n553|// error, and the promotion reddens here. The production entry point is\n554|// Host.Call over ExecRunner.\n555|func TestExecRunnerReportsCrashExit(t *testing.T) {\n556|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n557|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n558|\t}\n559|\tfor _, kase := range []struct {\n560|\t\tname   string\n561|\t\tscript string\n562|\t\tcode   string\n563|\t\tdetail string\n564|\t}{\n565|\t\t{\"crash exit\", \"#!/bin/sh\\ncat > /dev/null\\nexit 3\\n\", \"provider_process_failed\", \"plugin exited without a response\"},\n566|\t\t{\"clean exit\", \"#!/bin/sh\\ncat > /dev/null\\nexit 0\\n\", \"provider_protocol_error\", \"plugin exited without a response\"},\n567|\t} {\n568|\t\tt.Run(kase.name, func(t *testing.T) {\n569|\t\t\tplugin := filepath.Join(t.TempDir(), \"ax-provider-exit\")\n570|\t\t\tif err := os.WriteFile(plugin, []byte(kase.script), 0o700); err != nil {\n571|\t\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n572|\t\t\t}\n573|\t\t\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n574|\t\t\t_, err := host.Call(context.Background(), plugin, liveRequest(t))\n575|\t\t\tif kase.code == \"provider_protocol_error\" {\n576|\t\t\t\trequireFrameRefusal(t, err, \"\", kase.detail)\n577|\t\t\t} else {\n578|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.code), kase.detail)\n579|\t\t\t}\n580|\t\t})\n581|\t}\n582|}\n583|\n584|// TestExecRunnerKeepsValidFrameWhenPluginIgnoresStdin proves the F2\n585|// rule through the production entry point: a plugin that answers a\n586|// valid correlated frame without ever reading stdin — the shape\n587|// ExecRunner's own comment anticipates — has every call accepted,\n588|// even when the host-side stdin write races the plugin's exit into\n589|// EPIPE. Returning writeErr before stdout is ever considered\n590|// discards those frames as \"runner reported no result\"; the loop\n591|// below fails on that build because a single racing call in two\n592|// hundred is near-certain under load. The production entry point is\n593|// Host.Call over ExecRunner.\n594|func TestExecRunnerKeepsValidFrameWhenPluginIgnoresStdin(t *testing.T) {\n595|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n596|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n597|\t}\n598|\treq := liveRequest(t)\n599|\tscript := filepath.Join(t.TempDir(), \"ax-provider-no-stdin-read\")\n600|\tframe := `{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + req.RequestID.String() + `\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}`\n601|\tif err := os.WriteFile(script, []byte(\"#!/bin/sh\\nprintf '%s' \\\"$AX_VALID_FRAME\\\"\\n\"), 0o700); err != nil {\n602|\t\tt.Fatalf(\"WriteFile: %v\", err)\n603|\t}\n604|\tt.Setenv(\"AX_VALID_FRAME\", frame)\n605|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n606|\tconst calls = 200\n607|\tdiscarded := 0\n608|\tfor i := 0; i < calls; i++ {\n609|\t\tgot, err := host.Call(context.Background(), script, req)\n610|\t\tif err != nil {\n611|\t\t\tdiscarded++\n612|\t\t\tt.Logf(\"call %d discarded its valid frame: %v\", i, err)\n613|\t\t\tcontinue\n614|\t\t}\n615|\t\tif string(got.Body) != `{\"provider_id\":\"echo\"}` {\n616|\t\t\tt.Fatalf(\"call %d body = %s, want the answered frame\", i, got.Body)\n617|\t\t}\n618|\t}\n619|\tif discarded != 0 {\n620|\t\tt.Fatalf(\"ExecRunner discarded %d of %d valid frames from a plugin that never read stdin\", discarded, calls)\n621|\t}\n622|}\n623|\n624|// TestExecRunnerClassifiesCrashExitDeterministically proves the\n625|// crash side of the same rule: a plugin that drains stdin and exits\n626|// 3 without answering is provider_process_failed with \"plugin exited\n627|// without a response\" on every call, never the \"runner reported no\n628|// result\" misclassification the EPIPE race produced. Fifty racing\n629|// calls fail on the old build with near certainty. The production\n630|// entry point is Host.Call over ExecRunner.\n631|func TestExecRunnerClassifiesCrashExitDeterministically(t *testing.T) {\n632|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n633|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n634|\t}\n635|\tplugin := filepath.Join(t.TempDir(), \"ax-provider-exit\")\n636|\tif err := os.WriteFile(plugin, []byte(\"#!/bin/sh\\ncat > /dev/null\\nexit 3\\n\"), 0o700); err != nil {\n637|\t\tt.Fatalf(\"WriteFile: %v\", err)\n638|\t}\n639|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n640|\tconst calls = 50\n641|\tfor i := 0; i < calls; i++ {\n642|\t\t_, err := host.Call(context.Background(), plugin, liveRequest(t))\n643|\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"plugin exited without a response\")\n644|\t}\n645|}\n646|\n647|// TestExecRunnerWritesOneTerminatedFrame drives the production stdin\n648|// path: the exact request frame plus the Section 7.2 line terminator must\n649|// reach the plugin. The script saves its stdin aside and answers from it,\n650|// so the captured bytes pin what ExecRunner wrote. Omitting the newline\n651|// reddens the byte comparison here.\n652|func TestExecRunnerWritesOneTerminatedFrame(t *testing.T) {\n653|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n654|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n655|\t}\n656|\troot := t.TempDir()\n657|\tcapture := filepath.Join(root, \"stdin-capture\")\n658|\tscript := filepath.Join(root, \"ax-provider-capture\")\n659|\tplugin := `#!/bin/sh\n660|cat > \"$AX_STDIN_CAPTURE\"\n661|frame=$(cat \"$AX_STDIN_CAPTURE\")\n662|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n663|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n664|exit 0\n665|`\n666|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n667|\t\tt.Fatalf(\"WriteFile: %v\", err)\n668|\t}\n669|\tt.Setenv(\"AX_STDIN_CAPTURE\", capture)\n670|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n671|\treq := liveRequest(t)\n672|\tif _, err := host.Call(context.Background(), script, req); err != nil {\n673|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n674|\t}\n675|\tframe, err := EncodeRequest(req, time.Now())\n676|\tif err != nil {\n677|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n678|\t}\n679|\twant := append(append([]byte(nil), frame...), '\\n')\n680|\tgot, err := os.ReadFile(capture)\n681|\tif err != nil {\n682|\t\tt.Fatalf(\"ReadFile capture: %v\", err)\n683|\t}\n684|\tif string(got) != string(want) {\n685|\t\tt.Fatalf(\"plugin stdin is %d bytes ending %q, want the %d-byte frame plus one newline\", len(got), lastByte(got), len(want))\n686|\t}\n687|}\n688|\n689|// lastByte renders the final stdin byte for the terminator failure text.\n690|func lastByte(data []byte) string {\n691|\tif len(data) == 0 {\n692|\t\treturn \"empty\"\n693|\t}\n694|\treturn string(data[len(data)-1:])\n695|}"}}}
