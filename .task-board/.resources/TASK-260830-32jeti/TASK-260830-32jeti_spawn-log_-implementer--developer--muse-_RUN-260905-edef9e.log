{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca09","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":863,"recorded_at":1780531400001721,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"e808b3ea-5264-4b1a-a47e-fd1bf7b8bc39"},"task_id":"e808b3ea-5264-4b1a-a47e-fd1bf7b8bc39","event":{"kind":"output","task_id":"e808b3ea-5264-4b1a-a47e-fd1bf7b8bc39","chunk":"edited\nchanged lines: lines 259-268\n--- original\n+++ updated\n@@\n-// decodeStrictObject parses one complete JSON object with duplicate\n-// member detection. A repeated member has no single value, so it is a\n-// fault, not a last-wins read. The lone-surrogate gate runs first:\n-// encoding/json would silently replace a lone \\ud800-style escape with\n-// U+FFFD, so the raw bytes are screened before any member is trusted\n-// (Section 1.6: decoders MUST reject lone surrogate code points).\n-func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n-\tif hasLoneSurrogateEscape(data) {\n-\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n-\t}\n+// decodeStrictObject parses one complete JSON object with duplicate\n+// member detection. A repeated member has no single value, so it is a\n+// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n+// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n+// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n+// raw bytes are screened before any member is trusted. The\n+// lone-surrogate gate runs next: encoding/json would likewise replace\n+// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n+// reject lone surrogate code points).\n+func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n+\tif !utf8.Valid(data) {\n+\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n+\t}\n+\tif hasLoneSurrogateEscape(data) {\n+\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n+\t}\n"}}}
