anonicaljson/canonical.go-160-// holds more than 256 containers open at once. What survives is returned as the\ninternal/canonicaljson/canonical.go-161-// RFC 8785 canonical UTF-8 byte sequence.\ninternal/canonicaljson/canonical.go-162-//\ninternal/canonicaljson/canonical.go-163-// That last bound is a nesting depth, not a count of the containers a document\ninternal/canonicaljson/canonical.go-164-// opens. Only simultaneously open containers cost decoder stack frames, which\ninternal/canonicaljson/canonical.go-165-// is the exhaustion this refusal exists to prevent, so a shallow document is\ninternal/canonicaljson/canonical.go-166-// accepted however many containers it opens in total. Each row below is built\ninternal/canonicaljson/canonical.go-167-// and driven through this function by\ninternal/canonicaljson/canonical.go-168-// TestCanonicalizeDocumentedContainerLimitIsADepthNotACount:\ninternal/canonicaljson/canonical.go-398-\tif !utf8.Valid(input) {\ninternal/canonicaljson/canonical.go-399-\t\treturn nil, invalidJSON(\"input is not valid UTF-8\")\ninternal/canonicaljson/canonical.go-400-\t}\ninternal/canonicaljson/canonical.go:401:\tif err := validateSurrogateEscapes(input); err != nil {\ninternal/canonicaljson/canonical.go-402-\t\treturn nil, err\ninternal/canonicaljson/canonical.go-403-\t}\ninternal/canonicaljson/canonical.go-404-\ninternal/canonicaljson/canonical.go-405-\tdecoder := json.NewDecoder(bytes.NewReader(input))\ninternal/canonicaljson/canonical.go-406-\tdecoder.UseNumber()\ninternal/canonicaljson/canonical.go-407-\tvalue, err := decodeValue(decoder, 0)\ninternal/canonicaljson/canonical.go-408-\tif err != nil {\ninternal/canonicaljson/canonical.go-409-\t\treturn nil, err\ninternal/canonicaljson/canonical.go-410-\t}\ninternal/canonicaljson/canonical.go-411-\tif token, err := decoder.Token(); !errors.Is(err, io.EOF) {\ninternal/canonicaljson/canonical.go-511-\treturn nil\ninternal/canonicaljson/canonical.go-512-}\ninternal/canonicaljson/canonical.go-