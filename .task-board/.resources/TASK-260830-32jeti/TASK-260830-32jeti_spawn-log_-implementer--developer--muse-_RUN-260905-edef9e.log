{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e1","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":459,"recorded_at":1780531400000913,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"call_id":"call_01a070b0bf6a7fb3b41c1018d3b3c82b","text":"Read text file `internal/provhost/inventory_test.go`.\n(389 line(s) above)\n390|\t\t\"and MUST NOT contain <code>body</code>\",\n391|\t\t\"Envelope and body\",\n392|\t\t\"unknown members are protocol errors under major version 2\",\n393|\t\t\"The host MUST terminate a plugin that exceeds its deadline and report\",\n394|\t\t\"<code>provider_timeout</code>\",\n395|\t\t\"It MUST redact environment and stderr before\",\n396|\t\t\"logging\",\n397|\t} {\n398|\t\trequireQuote(t, document, excerpt, \"7.2\")\n399|\t}\n400|}\n401|\n402|// TestSection151ProviderRowIsPinned quotes the Section 15.1 provider\n403|// row behind the local failure mapping: recognizable majors yield\n404|// incompatible_protocol, everything else unusable yields\n405|// provider_protocol_error, and a different major's payload is never\n406|// trusted.\n407|func TestSection151ProviderRowIsPinned(t *testing.T) {\n408|\tdocument, err := specdoc.Load()\n409|\tif err != nil {\n410|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n411|\t}\n412|\tfor _, excerpt := range []string{\n413|\t\t\"The host accepts no child error object, terminates/waits for exit as applicable, and emits its own local Error 1.0.0\",\n414|\t\t\"<code>incompatible_protocol</code> for a recognizable major mismatch, otherwise <code>provider_protocol_error</code>\",\n415|\t\t\"Receivers MUST NOT parse a different major\",\n416|\t\t\"payload far enough to trust its error code, retryable bit, details, or\",\n417|\t} {\n418|\t\trequireQuote(t, document, excerpt, \"15.1\")\n419|\t}\n420|}\n421|\n422|// TestStatusRecoveryRulesArePinned quotes the Section 7.5 recovery\n423|// sentences behind DecodeStatusOutcome: the evolving status read, the\n424|// unknown quarantine, and the state/nullability table.\n425|func TestStatusRecoveryRulesArePinned(t *testing.T) {\n426|\tdocument, err := specdoc.Load()\n427|\tif err != nil {\n428|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n429|\t}\n430|\tfor _, excerpt := range []string{\n431|\t\t\"is the required evolving lost-response recovery\",\n432|\t\t\"An unknown transaction MUST return state\",\n433|\t\t\"<code>unknown</code>; the host MUST NOT infer success\",\n434|\t\t\"An unreadable or\",\n435|\t\t\"integrity-invalid transaction MUST fail with <code>integrity_failure</code> and\",\n436|\t\t\"MUST be quarantined rather than represented as a successful status object\",\n437|\t\t\"<code>unknown</code> requires null\",\n438|\t\t\"requires all three non-null\",\n439|\t} {\n440|\t\trequireQuote(t, document, excerpt, \"7.5\")\n441|\t}\n442|}\n443|\n444|// TestStableCodesAreRegistered pins every refusal code this package\n445|// emits against the pinned error registry and the exact exit the host\n446|// surfaces, and agrees with the axerror wire table.\n447|func TestStableCodesAreRegistered(t *testing.T) {\n448|\tregistered := map[string]int{}\n449|\tfor _, row := range catalog.Current().Errors {\n450|\t\tregistered[string(row.Code)] = row.ExitCode\n451|\t}\n452|\tfor code, wantExit := range map[string]int{\n453|\t\t\"invalid_config\":          3,\n454|\t\t\"provider_protocol_error\": 13,\n455|\t\t\"incompatible_protocol\":   6,\n456|\t\t\"provider_process_failed\": 13,\n457|\t\t\"provider_timeout\":        13,\n458|\t\t\"integrity_failure\":       9,\n459|\t} {\n460|\t\tgotExit, ok := registered[code]\n461|\t\tif !ok {\n462|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n463|\t\t}\n464|\t\tif gotExit != wantExit {\n465|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n466|\t\t}\n467|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n468|\t\tif err != nil {\n469|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n470|\t\t}\n471|\t\tif gotWire != wantExit {\n472|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n473|\t\t}\n474|\t}\n475|\tt.Logf(\"refusal code coverage: 6/6 package codes registered with pinned exits\")\n476|}\n477|\n478|// TestRefusalConstructorsAreTotal proves the fallible-constructor error\n479|// path never fires in practice: every constructor returns a failure and\n480|// a nil error across representative dynamic causes. The sites recorded\n481|// here are test lines, not production sites, so every key this test adds\n482|// to the exercised set is removed before it returns, keeping the\n483|// reverse-direction audit exact.\n484|func TestRefusalConstructorsAreTotal(t *testing.T) {\n485|\tvar beforeSites, beforeCodes []any\n486|\texercisedRefusalSites.Range(func(key, _ any) bool { beforeSites = append(beforeSites, key); return true })\n487|\tobservedCodes.Range(func(key, _ any) bool { beforeCodes = append(beforeCodes, key); return true })\n488|\tt.Cleanup(func() {\n489|\t\tkeepSites := map[any]bool{}\n490|\t\tfor _, key := range beforeSites {\n491|\t\t\tkeepSites[key] = true\n492|\t\t}\n493|\t\texercisedRefusalSites.Range(func(key, _ any) bool {\n494|\t\t\tif !keepSites[key] {\n495|\t\t\t\texercisedRefusalSites.Delete(key)\n496|\t\t\t}\n497|\t\t\treturn true\n498|\t\t})\n499|\t\tkeepCodes := map[any]bool{}\n500|\t\tfor _, key := range beforeCodes {\n501|\t\t\tkeepCodes[key] = true\n502|\t\t}\n503|\t\tobservedCodes.Range(func(key, _ any) bool {\n504|\t\t\tif !keepCodes[key] {\n505|\t\t\t\tobservedCodes.Delete(key)\n506|\t\t\t}\n507|\t\t\treturn true\n508|\t\t})\n509|\t})\n510|\tcause := fmt.Errorf(\"fake: dynamic cause\")\n511|\tlongCause := fmt.Errorf(\"fake: %s\", strings.Repeat(\"x\", 300))\n512|\tfor _, kase := range []struct {\n513|\t\tname string\n514|\t\tcall func() (*axerror.Error, error)\n515|\t\tcode string\n516|\t}{\n517|\t\t{\"invalid\", func() (*axerror.Error, error) { return failInvalid(\"fake\") }, \"invalid_config\"},\n518|\t\t{\"protocol\", func() (*axerror.Error, error) { return failProtocol(\"fake\", \"member\") }, \"provider_protocol_error\"},\n519|\t\t{\"mismatch\", func() (*axerror.Error, error) { return failMismatch(\"fake\", \"3.0.0\") }, \"incompatible_protocol\"},\n520|\t\t{\"process with cause\", func() (*axerror.Error, error) { return failProcess(\"fake\", cause) }, \"provider_process_failed\"},\n521|\t\t{\"process with long cause\", func() (*axerror.Error, error) { return failProcess(\"fake\", longCause) }, \"provider_process_failed\"},\n522|\t\t{\"process without cause\", func() (*axerror.Error, error) { return failProcess(\"fake\", nil) }, \"provider_process_failed\"},\n523|\t\t{\"timeout\", func() (*axerror.Error, error) { return failTimeout(\"fake\", 100) }, \"provider_timeout\"},\n524|\t\t{\"integrity\", func() (*axerror.Error, error) { return failIntegrity(\"fake\", \"unknown\", \"m\", \"t\") }, \"integrity_failure\"},\n525|\t} {\n526|\t\tt.Run(kase.name, func(t *testing.T) {\n527|\t\t\tfailure, err := kase.call()\n528|\t\t\tif err != nil {\n529|\t\t\t\tt.Fatalf(\"constructor error = %v, want nil\", err)\n530|\t\t\t}\n531|\t\t\tif failure == nil || string(failure.Code()) != kase.code {\n532|\t\t\t\tt.Fatalf(\"constructor failure = %v, want code %s\", failure, kase.code)\n533|\t\t\t}\n534|\t\t})\n535|\t}\n536|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e3","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":460,"recorded_at":1780531400000915,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"call_id":"call_01a070b0c08a74d1b61fa9f06871b171","text":"Read text file `internal/canonicaljson/canonical.go`.\n(379 line(s) above)\n380|}\n381|\n382|func requiredStringMember(object map[string]any, name string) (string, error) {\n383|\tvalue, ok := object[name]\n384|\tif !ok {\n385|\t\treturn \"\", invalidIdentity(\"identity input requires string member %s\", name)\n386|\t}\n387|\ttext, ok := value.(string)\n388|\tif !ok || text == \"\" {\n389|\t\treturn \"\", invalidIdentity(\"identity input member %s must be a non-empty string\", name)\n390|\t}\n391|\treturn text, nil\n392|}\n393|\n394|func decodeStrict(input []byte) (any, error) {\n395|\tif len(input) == 0 {\n396|\t\treturn nil, invalidJSON(\"input is empty\")\n397|\t}\n398|\tif !utf8.Valid(input) {\n399|\t\treturn nil, invalidJSON(\"input is not valid UTF-8\")\n400|\t}\n401|\tif err := validateSurrogateEscapes(input); err != nil {\n402|\t\treturn nil, err\n403|\t}\n404|\n405|\tdecoder := json.NewDecoder(bytes.NewReader(input))\n406|\tdecoder.UseNumber()\n407|\tvalue, err := decodeValue(decoder, 0)\n408|\tif err != nil {\n409|\t\treturn nil, err\n410|\t}\n411|\tif token, err := decoder.Token(); !errors.Is(err, io.EOF) {\n412|\t\tif err != nil {\n413|\t\t\treturn nil, invalidJSON(\"read trailing JSON data: %v\", err)\n414|\t\t}\n415|\t\treturn nil, invalidJSON(\"unexpected trailing JSON token %v\", token)\n416|\t}\n417|\treturn value, nil\n418|}\n419|\n420|// decodeValue decodes one logical JSON value. depth counts the containers\n421|// already open around this value, so the top-level value is decoded at depth 0\n422|// and a container at depth maxNestingDepth-1 is the last one allowed to open.\n423|func decodeValue(decoder *json.Decoder, depth int) (any, error) {\n424|\ttoken, err := decoder.Token()\n425|\tif err != nil {\n426|\t\treturn nil, invalidJSON(\"decode JSON token: %v\", err)\n427|\t}\n428|\tdelimiter, ok := token.(json.Delim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n470|\t\t}\n471|\t\tend, err := decoder.Token()\n472|\t\tif err != nil || end != json.Delim(']') {\n473|\t\t\treturn nil, invalidJSON(\"decode array terminator: %v\", err)\n474|\t\t}\n475|\t\treturn array, nil\n476|\tdefault:\n477|\t\treturn nil, invalidJSON(\"unexpected delimiter %q\", delimiter)\n478|\t}\n479|}\n480|\n481|// validateAXNumbers is the AX decoder half of the split documented under\n482|// DIVISION OF GUARANTEES on Canonicalize. It walks the decoded value and\n483|// refuses every literal the common logical data model forbids, on the\n484|// json.Number token rather than on a host double, so an unsafe integer is\n485|// rejected instead of rounded. Canonicalize deliberately does not call it;\n486|// every exported entry point that promises the AX number model does.\n487|func validateAXNumbers(value any) error {\n488|\tswitch typed := value.(type) {\n489|\tcase json.Number:\n490|\t\tliteral := typed.String()\n491|\t\tif strings.ContainsAny(literal, \".eE\") {\n492|\t\t\treturn invalidIdentity(\"floating-point number %q is forbidden by the AX common model\", literal)\n493|\t\t}\n494|\t\tinteger, err := strconv.ParseInt(literal, 10, 64)\n495|\t\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n496|\t\t\treturn invalidIdentity(\"integer %q is outside the AX safe-integer interval\", literal)\n497|\t\t}\n498|\tcase []any:\n499|\t\tfor _, element := range typed {\n500|\t\t\tif err := validateAXNumbers(element); err != nil {\n501|\t\t\t\treturn err\n502|\t\t\t}\n503|\t\t}\n504|\tcase map[string]any:\n505|\t\tfor _, member := range typed {\n506|\t\t\tif err := validateAXNumbers(member); err != nil {\n507|\t\t\t\treturn err\n508|\t\t\t}\n509|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
