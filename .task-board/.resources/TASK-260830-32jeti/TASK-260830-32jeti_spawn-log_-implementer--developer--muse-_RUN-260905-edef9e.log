{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caa5","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":941,"recorded_at":1780531400001877,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"3a144615-e1ba-4ef3-b262-7740b4d8fccf"},"task_id":"3a144615-e1ba-4ef3-b262-7740b4d8fccf","event":{"kind":"output","task_id":"3a144615-e1ba-4ef3-b262-7740b4d8fccf","chunk":"Read text file `internal/provhost/status.go`.\n(59 line(s) above)\n60|\t\"plan_id\":                  true,\n61|\t\"state\":                    true,\n62|\t\"rollback_token\":           true,\n63|\t\"native_discovery\":         true,\n64|}\n65|\n66|// DecodeStatusOutcome reconciles one materialize-status success body to\n67|// the current durable state. It enforces the Section 7.5 recovery rules:\n68|// unknown requires null plan, token, and discovery; prepared requires all\n69|// three non-null; committed and rolled_back require a non-null plan and\n70|// discovery with a null token. Identity members must equal the requested\n71|// transaction.\n72|//\n73|// Every uninterpretable observation fails with integrity_failure,\n74|// including a state of unknown: the caller must quarantine the\n75|// transaction root and must not infer success. Status reads are evolving\n76|// observations, so no byte-identical replay rule applies: the same\n77|// transaction may report prepared under one envelope request_id and\n78|// committed under the next, and both readings are returned as-is.\n79|//\n80|// Only the charset and length of a rollback token are checked here (at\n81|// least 256 bits of base64url); its entropy is not observable. The shapes\n82|// of native_discovery and plan contents belong to the operation layer.\n83|func DecodeStatusOutcome(body []byte, want StatusIDs) (StatusState, error) {\n84|\tintegrity := func(detail string, state string) (StatusState, error) {\n85|\t\tfailure, err := failIntegrity(detail, state, want.MaterializationID, want.TransactionID)\n86|\t\tif err != nil {\n87|\t\t\treturn \"\", err\n88|\t\t}\n89|\t\treturn \"\", failure\n90|\t}\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\treturn integrity(\"status body is \"+fault.detail, \"\")\n94|\t}\n95|\tfor name := range members {\n96|\t\tif !statusBodyMembers[name] {\n97|\t\t\treturn integrity(\"status body carries unknown member\", \"\")\n98|\t\t}\n99|\t}\n100|\tfor _, name := range []string{\"materialization_id\", \"transaction_id\", \"transaction_authority_id\", \"plan_id\", \"state\", \"rollback_token\", \"native_discovery\"} {\n101|\t\tif _, present := members[name]; !present {\n102|\t\t\treturn integrity(\"status body misses a required member\", \"\")\n103|\t\t}\n104|\t}\n105|\tstringMember := func(name string) (string, bool) {\n106|\t\tvar value string\n107|\t\tif err := json.Unmarshal(members[name], &value); err != nil {\n108|\t\t\treturn \"\", false\n109|\t\t}\n(more lines below)"}}}
