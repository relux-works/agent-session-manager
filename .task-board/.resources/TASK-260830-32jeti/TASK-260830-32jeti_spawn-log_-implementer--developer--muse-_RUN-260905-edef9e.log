{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c739","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":503,"recorded_at":1780531400001001,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"bf713de6-ad6a-40d5-af7e-bd6e3d7565fa"},"task_id":"bf713de6-ad6a-40d5-af7e-bd6e3d7565fa","event":{"kind":"output","task_id":"bf713de6-ad6a-40d5-af7e-bd6e3d7565fa","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(119 line(s) above)\n120|\t\tif err != nil {\n121|\t\t\treturn nil, nil, err\n122|\t\t}\n123|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n124|\t\tif err != nil {\n125|\t\t\treturn nil, nil, err\n126|\t\t}\n127|\t\tfiles = append(files, productionFile{syntax: syntax, source: source})\n128|\t}\n129|\t// First pass, package-wide: the decodeStrictObject fault detail\n130|\t// set, which the integrity wrapper site expands over. The wrapper\n131|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n132|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n133|\t// set: expanding over every frameFault literal would invent arms\n134|\t// production can never emit. The pass must span files because the\n135|\t// literals live in protocol.go while the wrapper lives in status.go.\n136|\tvar strictDetails []string\n137|\tseenDetail := map[string]bool{}\n138|\tfor _, file := range files {\n139|\t\tfor _, decl := range file.syntax.Decls {\n140|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n141|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n142|\t\t\t\tcontinue\n143|\t\t\t}\n144|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n145|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n146|\t\t\t\tif !ok {\n147|\t\t\t\t\treturn true\n148|\t\t\t\t}\n149|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n150|\t\t\t\tif !ok {\n151|\t\t\t\t\treturn true\n152|\t\t\t\t}\n153|\t\t\t\tif !seenDetail[detail] {\n154|\t\t\t\t\tseenDetail[detail] = true\n155|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n156|\t\t\t\t}\n157|\t\t\t\treturn true\n158|\t\t\t})\n159|\t\t}\n160|\t}\n161|\tfor _, file := range files {\n162|\t\tsource, syntax := file.source, file.syntax\n163|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n164|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n165|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n166|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n167|\t\t\t\tif !ok {\n168|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n169|\t\t\t\t\treturn true\n170|\t\t\t\t}\n171|\t\t\t\tmember := \"\"\n172|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n173|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n174|\t\t\t\t}\n175|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n176|\t\t\t\treturn true\n177|\t\t\t}\n178|\t\t\tcall, ok := node.(*ast.CallExpr)\n179|\t\t\tif !ok {\n180|\t\t\t\treturn true\n181|\t\t\t}\n182|\t\t\tident, ok := call.Fun.(*ast.Ident)\n183|\t\t\tif !ok || len(call.Args) == 0 {\n184|\t\t\t\treturn true\n185|\t\t\t}\n186|\t\t\tswitch ident.Name {\n187|\t\t\tcase \"integrity\":\n188|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n189|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n190|\t\t\t\t\tif err != nil {\n191|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n192|\t\t\t\t\t\treturn true\n193|\t\t\t\t\t}\n194|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n195|\t\t\t\t\treturn true\n196|\t\t\t\t}\n197|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n198|\t\t\t\t\tif len(strictDetails) == 0 {\n199|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n200|\t\t\t\t\t\treturn true\n201|\t\t\t\t\t}\n202|\t\t\t\t\tfor _, detail := range strictDetails {\n203|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n204|\t\t\t\t\t}\n205|\t\t\t\t\treturn true\n206|\t\t\t\t}\n207|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n208|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n209|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n210|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n211|\t\t\t\t\tif err != nil {\n212|\t\t\t\t\t\treturn true\n213|\t\t\t\t\t}\n214|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n215|\t\t\t\t}\n216|\t\t\t\t// Non-literal first arguments are the fault conduits\n217|\t\t\t\t// (fault.detail, detail variables): the arms behind\n218|\t\t\t\t// them are the frame arms above, so there is no\n219|\t\t\t\t// separate obligation here.\n220|\t\t\t}\n221|\t\t\treturn true\n222|\t\t})\n223|\t}\n224|\tif parseBranches == 0 {\n225|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n226|\t}\n227|\tsort.Strings(scanned)\n228|\treturn arms, scanned, nil\n229|}\n230|\n231|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n232|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n233|\ttarget := node\n234|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n235|\t\ttarget = unary.X\n236|\t}\n237|\tliteral, ok := target.(*ast.CompositeLit)\n238|\tif !ok {\n239|\t\treturn nil, false\n240|\t}\n241|\tident, ok := literal.Type.(*ast.Ident)\n242|\tif !ok || ident.Name != \"frameFault\" {\n243|\t\treturn nil, false\n244|\t}\n245|\treturn literal, true\n246|}\n247|\n248|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n249|\tfor _, element := range literal.Elts {\n250|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n251|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n252|\t\t\t\treturn kv\n253|\t\t\t}\n254|\t\t}\n255|\t}\n256|\treturn nil\n257|}\n258|\n259|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n260|\tkv := literalField(literal, name)\n261|\tif kv == nil {\n262|\t\treturn \"\", false\n263|\t}\n264|\tbasic, ok := kv.Value.(*ast.BasicLit)\n265|\tif !ok || basic.Kind != token.STRING {\n266|\t\treturn \"\", false\n267|\t}\n268|\tdetail, err := strconv.Unquote(basic.Value)\n269|\tif err != nil {\n270|\t\treturn \"\", false\n271|\t}\n272|\treturn detail, true\n273|}\n274|\n275|// integrityPrefix matches \"prefix\" + <expr>, the wrapping shape whose\n276|// arms expand over the derived frame detail set.\n277|func integrityPrefix(arg ast.Expr) (string, bool) {\n278|\tbinary, ok := arg.(*ast.BinaryExpr)\n279|\tif !ok || binary.Op != token.ADD {\n280|\t\treturn \"\", false\n281|\t}\n282|\tprefix, ok := binary.X.(*ast.BasicLit)\n283|\tif !ok || prefix.Kind != token.STRING {\n284|\t\treturn \"\", false\n285|\t}\n286|\ttext, err := strconv.Unquote(prefix.Value)\n287|\tif err != nil {\n288|\t\treturn \"\", false\n289|\t}\n290|\treturn text, true\n291|}\n292|\n293|func nodeSource(source []byte, fileSet *token.FileSet, node ast.Node) string {\n294|\tstart := fileSet.Position(node.Pos()).Offset\n295|\tend := fileSet.Position(node.End()).Offset\n296|\tif start < 0 || end > len(source) || start >= end {\n297|\t\treturn \"?\"\n298|\t}\n299|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n300|}\n301|\n302|// armParseBranches derives one obligation per parseMajor rejection\n303|// branch in this file: every return 0, false inside parseMajor, keyed by\n304|// its innermost enclosing condition, and returns how many it derived. A\n305|// new branch adds a key no witness names; a deleted branch orphans its\n306|// witness; narrowing || to && rewrites the key and does both. The caller\n307|// fails closed when no file derives any branch.\n308|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n309|\tvar body *ast.BlockStmt\n310|\tfor _, decl := range syntax.Decls {\n311|\t\tfunction, ok := decl.(*ast.FuncDecl)\n312|\t\tif ok && function.Name.Name == \"parseMajor\" {\n313|\t\t\tbody = function.Body\n314|\t\t}\n315|\t}\n316|\tif body == nil {\n317|\t\treturn 0\n318|\t}\n319|\tcount := 0\n320|\tvar conditions []string\n321|\tvar walk func(node ast.Node)\n322|\twalk = func(node ast.Node) {\n323|\t\tbranch, ok := node.(*ast.IfStmt)\n324|\t\tif !ok {\n325|\t\t\tfor _, child := range childNodes(node) {\n326|\t\t\t\twalk(child)\n327|\t\t\t}\n328|\t\t\treturn\n329|\t\t}\n330|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n331|\t\tfor _, stmt := range branch.Body.List {\n332|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n333|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n334|\t\t\t\tcount++\n335|\t\t\t}\n336|\t\t}\n337|\t\tfor _, child := range childNodes(node) {\n338|\t\t\twalk(child)\n339|\t\t}\n340|\t\tconditions = conditions[:len(conditions)-1]\n341|\t}\n342|\twalk(body)\n343|\treturn count\n344|}\n345|\n346|func isFalsePair(ret *ast.ReturnStmt) bool {\n347|\tif len(ret.Results) != 2 {\n348|\t\treturn false\n349|\t}\n350|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n351|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n352|\t\treturn false\n353|\t}\n354|\tno, ok := ret.Results[1].(*ast.Ident)\n355|\treturn ok && no.Name == \"false\"\n356|}\n357|\n358|func childNodes(node ast.Node) []ast.Node {\n359|\tvar children []ast.Node\n360|\tast.Inspect(node, func(child ast.Node) bool {\n361|\t\tif child == nil || child == node {\n362|\t\t\treturn true\n363|\t\t}\n364|\t\tchildren = append(children, child)\n365|\t\treturn false\n366|\t})\n367|\treturn children\n368|}\n369|\n370|// armWitness proves one derived refusal arm at the production entry.\n371|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n372|// fails a witness that names nothing production declares, so a deleted or\n373|// narrowed production branch orphans its witness instead of passing\n374|// silently. The prove function must drive the production entry point and\n375|// require the refusal attributed to THIS arm, not merely any refusal.\n376|type armWitness struct {\n377|\tarm   string\n378|\tname  string\n379|\tprove func(*testing.T)\n380|}\n381|\n382|// requireIntegrityRefusal asserts the full identity of a status refusal:\n383|// the integrity_failure code, the rule detail, the status_state detail\n384|// every integrity arm carries (AS6: asserted on all 18 arms, not just\n385|// the unknown row), exit 9, and the non-retryable bit. It is separate\n386|// from requireLocalRefusal because that helper also serves codes with no\n387|// status_state detail.\n388|func requireIntegrityRefusal(t *testing.T, err error, detail, wantState string) {\n389|\tt.Helper()\n390|\trequireLocalRefusal(t, err, \"integrity_failure\", detail)\n391|\tstate, ok := failureObject(t, err).Detail(\"status_state\")\n392|\tif !ok || state != wantState {\n393|\t\tt.Fatalf(\"integrity refusal status_state = %v, want %q (%v)\", state, wantState, err)\n394|\t}\n395|\tif failureExit(t, err) != 9 {\n396|\t\tt.Fatalf(\"integrity refusal exit = %d, want 9\", failureExit(t, err))\n397|\t}\n398|}\n399|\n(more lines below)"}}}
