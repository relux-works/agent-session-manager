{Stdout: []byte(`{\\\"protocol\\\":\\\"urn:ax:protocol:provider\\\",\\\"protocol_version\\\":\\\"3.0.0\\\",\\\"request_id\\\":\\\"` + testRequestID + `\\\",\\\"ok\\\":true,\\\"body\\\":{}}`), ExitCode: 0}, \\\"incompatible_protocol\\\", \\\"\\\", \\\"\\\"},\\ninternal/provhost/runner_test.go:354:\\t\\t\\tcase \\\"incompatible_protocol\\\":\\ninternal/provhost/runner_test.go:355:\\t\\t\\t\\tif failureCode(t, err) != \\\"incompatible_protocol\\\" {\\ninternal/provhost/runner_test.go:356:\\t\\t\\t\\t\\tt.Fatalf(\\\"Call code = %v, want incompatible_protocol\\\", err)\\ninternal/provhost/runner_test.go:358:\\t\\t\\t\\tif observed, ok := failureObject(t, err).Detail(\\\"observed\\\"); !ok || observed != \\\"3.0.0\\\" {\\n\",\n  \"original_output_bytes\": 3308,\n  \"original_output_tokens\": 827,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
