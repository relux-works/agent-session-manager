{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75d","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":521,"recorded_at":1780531400001037,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"6f2143e6-3002-4086-9ebc-f4d458134f68"},"task_id":"6f2143e6-3002-4086-9ebc-f4d458134f68","event":{"kind":"output","task_id":"6f2143e6-3002-4086-9ebc-f4d458134f68","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(399 line(s) above)\n400|func armVersionFrame(version string) []byte {\n401|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n402|}\n403|\n404|func armMemberFrame(members string) []byte {\n405|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n406|}\n407|\n408|func armOversizeResponse(t *testing.T) []byte {\n409|\tt.Helper()\n410|\tbuild := func(pad int) []byte {\n411|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n412|\t}\n413|\tbase := len(build(0))\n414|\tover := build(specFrameLimitBytes - base + 1)\n415|\tif len(over) != specFrameLimitBytes+1 {\n416|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n417|\t}\n418|\treturn over\n419|}\n420|\n421|func declaredArmWitnesses() []armWitness {\n422|\treturn []armWitness{\n423|\t\t// decodeStrictObject frame arms, through DecodeResponse.\n424|\t\t{arm: `frame|not a JSON object|\"\"`, name: \"array is not an object\", prove: func(t *testing.T) {\n425|\t\t\t_, err := DecodeResponse([]byte(`[1,2]`), mustUUIDv7(t, testRequestID))\n426|\t\t\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n427|\t\t}},\n428|\t\t{arm: `frame|not a JSON object|key`, name: \"truncated value names its member\", prove: func(t *testing.T) {\n429|\t\t\t_, err := DecodeResponse([]byte(`{\"protocol\":`), mustUUIDv7(t, testRequestID))\n430|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a JSON object\")\n431|\t\t}},\n432|\t\t{arm: `frame|duplicate member|key`, name: \"repeated member\", prove: func(t *testing.T) {\n433|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n434|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n435|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"duplicate member\")\n436|\t\t}},\n437|\t\t{arm: `frame|trailing data after the object|\"\"`, name: \"trailing byte\", prove: func(t *testing.T) {\n438|\t\t\t_, err := DecodeResponse(append(successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`), 'x'), mustUUIDv7(t, testRequestID))\n439|\t\t\trequireFrameRefusal(t, err, \"\", \"trailing data after the object\")\n440|\t\t}},\n441|\t\t{arm: `frame|lone surrogate escape|\"\"`, name: \"lone surrogate in body\", prove: func(t *testing.T) {\n442|\t\t\t_, err := DecodeResponse(successFrame(t, testRequestID, `{\"provider_id\":\"pi\",\"tag\":\"a\\ud800b\"}`), mustUUIDv7(t, testRequestID))\n443|\t\t\trequireFrameRefusal(t, err, \"\", \"lone surrogate escape\")\n444|\t\t}},\n445|\t\t{arm: `frame|missing member|name`, name: \"missing protocol\", prove: func(t *testing.T) {\n446|\t\t\tframe := []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n447|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n448|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n449|\t\t}},\n450|\t\t{arm: `frame|missing member|\"body\"`, name: \"success without body\", prove: func(t *testing.T) {\n451|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true`), mustUUIDv7(t, testRequestID))\n452|\t\t\trequireFrameRefusal(t, err, \"body\", \"missing member\")\n453|\t\t}},\n454|\t\t{arm: `frame|success envelope carries error|\"error\"`, name: \"error on success\", prove: func(t *testing.T) {\n455|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n456|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n457|\t\t\trequireFrameRefusal(t, err, \"error\", \"success envelope carries error\")\n458|\t\t}},\n459|\t\t{arm: `frame|missing member|\"error\"`, name: \"failure without error\", prove: func(t *testing.T) {\n460|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false`), mustUUIDv7(t, testRequestID))\n461|\t\t\trequireFrameRefusal(t, err, \"error\", \"missing member\")\n462|\t\t}},\n463|\t\t{arm: `frame|failure envelope carries body|\"body\"`, name: \"body on failure\", prove: func(t *testing.T) {\n464|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)\n465|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n466|\t\t\trequireFrameRefusal(t, err, \"body\", \"failure envelope carries body\")\n467|\t\t}},\n468|\t\t{arm: `frame|unknown member|name`, name: \"diagnostics member\", prove: func(t *testing.T) {\n469|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), mustUUIDv7(t, testRequestID))\n470|\t\t\trequireFrameRefusal(t, err, \"diagnostics\", \"unknown member\")\n471|\t\t}},\n472|\t\t// encodeFrame refusals, through EncodeRequest.\n473|\t\t{arm: `ctor|failInvalid|unknown operation`, name: \"unknown operation never frames\", prove: func(t *testing.T) {\n474|\t\t\treq := testRequest(t)\n475|\t\t\treq.Operation = \"reboot\"\n476|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n477|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n478|\t\t}},\n479|\t\t{arm: `ctor|failInvalid|request_id is not a UUIDv7`, name: \"zero request id\", prove: func(t *testing.T) {\n480|\t\t\tbad := testRequest(t)\n481|\t\t\tvar zero scalar.UUIDv7\n482|\t\t\tbad.RequestID = zero\n483|\t\t\t_, err := EncodeRequest(bad, mustInstant(t, testNow))\n484|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request_id is not a UUIDv7\")\n485|\t\t}},\n486|\t\t{arm: `ctor|failInvalid|deadline is not a timestamp`, name: \"zero deadline\", prove: func(t *testing.T) {\n487|\t\t\treq := testRequest(t)\n488|\t\t\treq.Deadline = mustTimestamp(t, testDeadline)\n489|\t\t\tvar zero scalar.Timestamp\n490|\t\t\treq.Deadline = zero\n491|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n492|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not a timestamp\")\n493|\t\t}},\n494|\t\t{arm: `ctor|failInvalid|deadline is not in the future`, name: \"stale deadline\", prove: func(t *testing.T) {\n495|\t\t\treq := testRequest(t)\n496|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n497|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n498|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n499|\t\t}},\n500|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n501|\t\t\treq := testRequest(t)\n502|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n503|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n504|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n505|\t\t}},\n506|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n507|\t\t\treq := testRequest(t)\n508|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n509|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n510|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request frame exceeds 8 MiB\")\n511|\t\t}},\n512|\t\t// DecodeResponse refusals, through DecodeResponse.\n513|\t\t{arm: `ctor|failProtocol|frame exceeds 8 MiB`, name: \"oversize response\", prove: func(t *testing.T) {\n514|\t\t\t_, err := DecodeResponse(armOversizeResponse(t), mustUUIDv7(t, testRequestID))\n515|\t\t\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n516|\t\t}},\n517|\t\t{arm: `ctor|failProtocol|frame is not UTF-8`, name: \"invalid UTF-8\", prove: func(t *testing.T) {\n518|\t\t\tframe := append([]byte{}, successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`)...)\n519|\t\t\tframe[len(frame)-3] = 0xff\n520|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n521|\t\t\trequireFrameRefusal(t, err, \"\", \"frame is not UTF-8\")\n522|\t\t}},\n523|\t\t{arm: `ctor|failProtocol|missing member`, name: \"missing ok\", prove: func(t *testing.T) {\n524|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`)\n525|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n526|\t\t\trequireFrameRefusal(t, err, \"ok\", \"missing member\")\n527|\t\t}},\n528|\t\t{arm: `ctor|failProtocol|member is not a boolean`, name: \"ok is a string\", prove: func(t *testing.T) {\n529|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":\"yes\",\"body\":{}`), mustUUIDv7(t, testRequestID))\n530|\t\t\trequireFrameRefusal(t, err, \"ok\", \"member is not a boolean\")\n531|\t\t}},\n532|\t\t{arm: `ctor|failProtocol|not a provider envelope`, name: \"foreign protocol id\", prove: func(t *testing.T) {\n533|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n534|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n535|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a provider envelope\")\n536|\t\t}},\n537|\t\t{arm: `ctor|failProtocol|member is not a string`, name: \"version is a number\", prove: func(t *testing.T) {\n538|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n539|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n540|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"member is not a string\")\n541|\t\t}},\n542|\t\t{arm: `ctor|failProtocol|unsupported protocol version`, name: \"minor bump\", prove: func(t *testing.T) {\n543|\t\t\t_, err := DecodeResponse(armVersionFrame(\"2.1.0\"), mustUUIDv7(t, testRequestID))\n544|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n545|\t\t}},\n546|\t\t{arm: `ctor|failProtocol|request_id is not a UUIDv7`, name: \"garbage request id\", prove: func(t *testing.T) {\n547|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`)\n548|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n549|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"request_id is not a UUIDv7\")\n550|\t\t}},\n551|\t\t{arm: `ctor|failProtocol|request_id does not match the request`, name: \"crossed response\", prove: func(t *testing.T) {\n552|\t\t\t_, err := DecodeResponse(successFrame(t, testOtherID, `{\"provider_id\":\"pi\"}`), mustUUIDv7(t, testRequestID))\n553|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"request_id does not match the request\")\n554|\t\t}},\n555|\t\t{arm: `ctor|failProtocol|body is not a JSON object`, name: \"array body on success\", prove: func(t *testing.T) {\n556|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":[]`), mustUUIDv7(t, testRequestID))\n557|\t\t\trequireFrameRefusal(t, err, \"body\", \"body is not a JSON object\")\n558|\t\t}},\n559|\t\t{arm: `ctor|failProtocol|error is not a JSON object`, name: \"scalar error on failure\", prove: func(t *testing.T) {\n560|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false,\"error\":1`), mustUUIDv7(t, testRequestID))\n561|\t\t\trequireFrameRefusal(t, err, \"error\", \"error is not a JSON object\")\n562|\t\t}},\n563|\t\t{arm: `ctor|failProtocol|error is not a bound Structured Error 1.0.0`, name: \"unbound child version\", prove: func(t *testing.T) {\n564|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n565|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n566|\t\t\trequireFrameRefusal(t, err, \"error\", \"error is not a bound Structured Error 1.0.0\")\n567|\t\t}},\n568|\t\t{arm: `ctor|failMismatch|foreign protocol major`, name: \"foreign major is not trusted\", prove: func(t *testing.T) {\n569|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"forged_code\",\"message\":\"forged\",\"exit_code\":0,\"retryable\":true,\"details\":{}}}`)\n570|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n571|\t\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n572|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) code = %v, want incompatible_protocol\", err)\n573|\t\t\t}\n574|\t\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n575|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) observed = %v, want the foreign version\", observed)\n576|\t\t\t}\n577|\t\t\tif failureExit(t, err) != 6 {\n578|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) exit = %d, want 6\", failureExit(t, err))\n579|\t\t\t}\n580|\t\t\tif strings.Contains(err.Error(), \"forged_code\") {\n581|\t\t\t\tt.Fatalf(\"foreign payload leaked into the local failure: %v\", err)\n582|\t\t\t}\n583|\t\t}},\n584|\t\t// Host refusals, through Host.Call over the scripted runner.\n585|\t\t{arm: `ctor|failInvalid|host has no runner`, name: \"runnerless host\", prove: func(t *testing.T) {\n586|\t\t\thost := Host{Now: time.Now}\n587|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n588|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"host has no runner\")\n589|\t\t}},\n590|\t\t{arm: `ctor|failTimeout|no response before the request deadline`, name: \"late empty answer\", prove: func(t *testing.T) {\n591|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n592|\t\t\thost := liveHost(runner)\n593|\t\t\treq := liveRequest(t)\n594|\t\t\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n595|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n596|\t\t\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n597|\t\t\tif failureExit(t, err) != 13 {\n598|\t\t\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n599|\t\t\t}\n600|\t\t}},\n601|\t\t{arm: `ctor|failProcess|runner reported no result`, name: \"transport failure with time left\", prove: func(t *testing.T) {\n602|\t\t\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n603|\t\t\thost := liveHost(runner)\n604|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n605|\t\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n606|\t\t}},\n607|\t\t{arm: `ctor|failProtocol|stdout carries more than one frame`, name: \"second line\", prove: func(t *testing.T) {\n608|\t\t\tstdout := append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n')\n609|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: stdout, ExitCode: 0})}}\n610|\t\t\thost := liveHost(runner)\n611|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n612|\t\t\trequireFrameRefusal(t, err, \"\", \"stdout carries more than one frame\")\n613|\t\t}},\n614|\t\t{arm: `ctor|failProcess|plugin exited without a response`, name: \"crash without a frame\", prove: func(t *testing.T) {\n615|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 3})}}\n616|\t\t\thost := liveHost(runner)\n617|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n618|\t\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"plugin exited without a response\")\n619|\t\t}},\n620|\t\t{arm: `ctor|failProtocol|plugin exited without a response`, name: \"clean exit without a frame\", prove: func(t *testing.T) {\n621|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 0})}}\n622|\t\t\thost := liveHost(runner)\n623|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n624|\t\t\trequireFrameRefusal(t, err, \"\", \"plugin exited without a response\")\n625|\t\t}},\n626|\t}\n627|}\n628|\n629|func declaredIntegrityWitnesses() []armWitness {\n630|\tgood := string(preparedBody())\n631|\twithOp := func(fragment string) []byte {\n632|\t\treturn []byte(strings.Replace(good, `\"materialization_id\"`, fragment+`\"materialization_id\"`, 1))\n633|\t}\n634|\treturn []armWitness{\n635|\t\t{arm: `integrity|status body is not a JSON object`, name: \"status body is not JSON\", prove: func(t *testing.T) {\n636|\t\t\t_, err := DecodeStatusOutcome([]byte(`oops`), testStatusIDs())\n637|\t\t\trequireIntegrityRefusal(t, err, \"status body is not a JSON object\", \"\")\n638|\t\t}},\n639|\t\t{arm: `integrity|status body is not a JSON object`, name: \"status body value is truncated\", prove: func(t *testing.T) {\n640|\t\t\t_, err := DecodeStatusOutcome([]byte(`{\"materialization_id\":`), testStatusIDs())\n641|\t\t\trequireIntegrityRefusal(t, err, \"status body is not a JSON object\", \"\")\n642|\t\t}},\n643|\t\t{arm: `integrity|status body is duplicate member`, name: \"status body repeats state\", prove: func(t *testing.T) {\n644|\t\t\tbody := strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1)\n645|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n646|\t\t\trequireIntegrityRefusal(t, err, \"status body is duplicate member\", \"\")\n647|\t\t}},\n648|\t\t{arm: `integrity|status body is trailing data after the object`, name: \"status body has trailing byte\", prove: func(t *testing.T) {\n649|\t\t\t_, err := DecodeStatusOutcome([]byte(good+\"x\"), testStatusIDs())\n650|\t\t\trequireIntegrityRefusal(t, err, \"status body is trailing data after the object\", \"\")\n651|\t\t}},\n652|\t\t{arm: `integrity|status body is lone surrogate escape`, name: \"status body carries lone surrogate\", prove: func(t *testing.T) {\n653|\t\t\tbody := strings.Replace(good, `\"prepared\"`, `\"pre\\ud800pared\"`, 1)\n654|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n655|\t\t\trequireIntegrityRefusal(t, err, \"status body is lone surrogate escape\", \"\")\n656|\t\t}},\n657|\t\t{arm: `integrity|status body carries unknown member`, name: \"status body carries phase\", prove: func(t *testing.T) {\n658|\t\t\tbody := strings.Replace(good, `\"state\":\"prepared\"`, `\"s