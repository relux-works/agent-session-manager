{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c481","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":155,"recorded_at":1780531400000305,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"1e589515-0d5a-45f8-bc4f-c4de7ba8458b"},"task_id":"1e589515-0d5a-45f8-bc4f-c4de7ba8458b","event":{"kind":"output","task_id":"1e589515-0d5a-45f8-bc4f-c4de7ba8458b","chunk":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped. Failure details carry the failure class and member names\n38|\t// only, never stderr content.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil, time.Time{}, failure\n199|\t}\n200|\tdeadline, err := req.Deadline.Time()\n201|\tif err != nil {\n202|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n203|\t\tif fault != nil {\n204|\t\t\treturn nil, time.Time{}, fault\n205|\t\t}\n206|\t\treturn nil, time.Time{}, failure\n207|\t}\n208|\tif !deadline.After(now) {\n209|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n210|\t\tif fault != nil {\n211|\t\t\treturn nil, time.Time{}, fault\n212|\t\t}\n213|\t\treturn nil, time.Time{}, failure\n214|\t}\n215|\tif !isJSONObject(req.Body) {\n216|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n217|\t\tif fault != nil {\n218|\t\t\treturn nil, time.Time{}, fault\n219|\t\t}\n220|\t\treturn nil, time.Time{}, failure\n221|\t}\n222|\t// The operation, request ID, deadline, and body above were each\n223|\t// validated before this marshal, so it cannot fail on a reachable\n224|\t// path: the error propagates as a plain Go error rather than\n225|\t// through a refusal site no negative test could exercise.\n226|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n227|\tif err != nil {\n228|\t\treturn nil, time.Time{}, err\n229|\t}\n230|\tif len(frame) > MaxFrameBytes {\n231|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n232|\t\tif fault != nil {\n233|\t\t\treturn nil, time.Time{}, fault\n234|\t\t}\n235|\t\treturn nil, time.Time{}, failure\n236|\t}\n237|\treturn frame, deadline, nil\n238|}\n239|\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read. The lone-surrogate gate runs first:\n262|// encoding/json would silently replace a lone \\ud800-style escape with\n263|// U+FFFD, so the raw bytes are screened before any member is trusted\n264|// (Section 1.6: decoders MUST reject lone surrogate code points).\n265|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n266|\tif hasLoneSurrogateEscape(data) {\n267|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n268|\t}\n269|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n270|\ttoken, err := decoder.Token()\n271|\tif err != nil {\n272|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n273|\t}\n274|\tdelim, ok := token.(json.Delim)\n275|\tif !ok || delim != '{' {\n276|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n277|\t}\n278|\tmembers := map[string]json.RawMessage{}\n279|\tfor decoder.More() {\n280|\t\tkeyToken, err := decoder.Token()\n281|\t\tif err != nil {\n282|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n283|\t\t}\n284|\t\tkey, ok := keyToken.(string)\n285|\t\tif !ok {\n286|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n287|\t\t}\n288|\t\tif _, duplicate := members[key]; duplicate {\n289|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n290|\t\t}\n291|\t\tvar raw json.RawMessage\n292|\t\tif err := decoder.Decode(&raw); err != nil {\n293|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n294|\t\t}\n295|\t\tmembers[key] = raw\n296|\t}\n297|\tif token, err := decoder.Token(); err != nil {\n298|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n299|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n300|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n301|\t}\n302|\tif _, err := decoder.Token(); err != io.EOF {\n303|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n304|\t}\n305|\treturn members, nil\n306|}\n307|\n308|// responseMembers is the exact Section 7.2 response member set: the four\n309|// framing members plus body on success or error on failure, never both,\n310|// never neither, and nothing else. It is package-level so the closed\n311|// vocabulary census derives it: widening the accepted set here must redden\n312|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n313|var responseMembers = map[string]bool{\n314|\t\"protocol\":         true,\n315|\t\"protocol_version\": true,\n316|\t\"request_id\":       true,\n317|\t\"ok\":               true,\n318|\t\"body\":             true,\n319|\t\"error\":            true,\n320|}\n321|\n322|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n323|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n324|\tfor _, name := range required {\n325|\t\tif _, present := members[name]; !present {\n326|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n327|\t\t}\n328|\t}\n329|\tif ok {\n330|\t\tif _, present := members[\"body\"]; !present {\n331|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n332|\t\t}\n333|\t\tif _, forbidden := members[\"error\"]; forbidden {\n334|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n335|\t\t}\n336|\t} else {\n337|\t\tif _, present := members[\"error\"]; !present {\n338|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n339|\t\t}\n340|\t\tif _, forbidden := members[\"body\"]; forbidden {\n341|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n342|\t\t}\n343|\t}\n344|\tfor name := range members {\n345|\t\tif !responseMembers[name] {\n346|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n347|\t\t}\n348|\t}\n349|\treturn nil\n350|}\n351|\n352|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n353|// Anything else is not a recognizable major, so the frame is unusable\n354|// rather than a mismatch.\n355|func parseMajor(version string) (int, bool) {\n356|\tparts := strings.Split(version, \".\")\n357|\tif len(parts) != 3 {\n358|\t\treturn 0, false\n359|\t}\n360|\tmajor := 0\n361|\tfor i := 0; i < len(parts[0]); i++ {\n362|\t\tdigit := parts[0][i]\n363|\t\tif digit < '0' || digit > '9' {\n364|\t\t\treturn 0, false\n365|\t\t}\n366|\t\tmajor = major*10 + int(digit-'0')\n367|\t}\n368|\tif len(parts[0]) == 0 {\n369|\t\treturn 0, false\n370|\t}\n371|\tfor _, rest := range parts[1:] {\n372|\t\tif len(rest) == 0 {\n373|\t\t\treturn 0, false\n374|\t\t}\n375|\t\tfor i := 0; i < len(rest); i++ {\n376|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n377|\t\t\t\treturn 0, false\n378|\t\t\t}\n379|\t\t}\n380|\t}\n381|\treturn major, true\n382|}\n383|\n384|// providerContract is the static Section 7.2 binding every failure\n385|// envelope is decoded under: provider protocol major 2 binds Structured\n386|// Error 1.0.0. The version is never taken from the document.\n387|var providerContract = axerror.ContainingContract{ID: \"urn:ax:protocol:provider\", Major: 2}\n388|\n389|// DecodeResponse validates one stdout line as the single response frame\n390|// for the request carrying wantRequestID. It returns the success body, or\n391|// the bound child failure, or a local failure that trusts nothing from\n392|// the frame. A recognizable foreign major yields incompatible_protocol;\n393|// every other unusable frame yields provider_protocol_error.\n394|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n395|\tif len(frame) > MaxFrameBytes {\n396|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n397|\t\tif err != nil {\n398|\t\t\treturn Response{}, err\n399|\t\t}\n400|\t\treturn Response{}, failure\n401|\t}\n402|\tif !utf8.Valid(frame) {\n403|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n404|\t\tif err != nil {\n405|\t\t\treturn Response{}, err\n406|\t\t}\n407|\t\treturn Response{}, failure\n408|\t}\n409|\tmembers, fault := decodeStrictObject(frame)\n410|\tif fault != nil {\n411|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n412|\t\tif err != nil {\n413|\t\t\treturn Response{}, err\n414|\t\t}\n415|\t\treturn Response{}, failure\n416|\t}\n417|\tvar ok bool\n418|\tif raw, present := members[\"ok\"]; !present {\n419|\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n420|\t\tif err != nil {\n421|\t\t\treturn Response{}, err\n422|\t\t}\n423|\t\treturn Response{}, failure\n424|\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n425|\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n426|\t\tif fault != nil {\n427|\t\t\treturn Response{}, fault\n428|\t\t}\n429|\t\treturn Response{}, failure\n430|\t}\n431|\tif fault := checkResponseMembers(members, ok); fault != nil {\n432|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n433|\t\tif err != nil {\n434|\t\t\treturn Response{}, err\n435|\t\t}\n436|\t\treturn Response{}, failure\n437|\t}\n438|\tvar protocol string\n439|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n440|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n441|\t\tif fault != nil {\n442|\t\t\treturn Response{}, fault\n443|\t\t}\n444|\t\treturn Response{}, failure\n445|\t}\n446|\tvar version string\n447|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n448|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n449|\t\tif fault != nil {\n450|\t\t\treturn Response{}, fault\n451|\t\t}\n452|\t\treturn Response{}, failure\n453|\t}\n454|\tif version != ProtocolVersion {\n455|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n456|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n457|\t\t\tif err != nil {\n458|\t\t\t\treturn Response{}, err\n459|\t\t\t}\n460|\t\t\treturn Response{}, failure\n461|\t\t}\n462|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n463|\t\tif fault != nil {\n464|\t\t\treturn Response{}, fault\n465|\t\t}\n466|\t\treturn Response{}, failure\n467|\t}\n468|\tvar requestID string\n469|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n470|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n471|\t\tif fault != nil {\n472|\t\t\treturn Response{}, fault\n473|\t\t}\n474|\t\treturn Response{}, failure\n475|\t}\n476|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n477|\t\tfailure, fault := failProtocol(\"request_id is not a UUIDv7\", \"request_id\")\n478|\t\tif fault != nil {\n479|\t\t\treturn Response{}, fault\n480|\t\t}\n481|\t\treturn Response{}, failure\n482|\t}\n483|\tif requestID != wantRequestID.String() {\n484|\t\tfailure, fault := failProtocol(\"request_id does not match the request\", \"request_id\")\n485|\t\tif fault != nil {\n486|\t\t\treturn Response{}, fault\n487|\t\t}\n488|\t\treturn Response{}, failure\n489|\t}\n490|\tif ok {\n491|\t\tif !isJSONObject(members[\"body\"]) {\n492|\t\t\tfailure, fault := failProtocol(\"body is not a JSON object\", \"body\")\n493|\t\t\tif fault != nil {\n494|\t\t\t\treturn Response{}, fault\n495|\t\t\t}\n496|\t\t\treturn Response{}, failure\n497|\t\t}\n498|\t\treturn Response{Body: append(json.RawMessage(nil), members[\"body\"]...)}, nil\n499|\t}\n500|\tif !isJSONObject(members[\"error\"]) {\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c483","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":156,"recorded_at":1780531400000307,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"1e589515-0d5a-45f8-bc4f-c4de7ba8458b"},"task_id":"1e589515-0d5a-45f8-bc4f-c4de7ba8458b","event":{"kind":"completed","task_id":"1e589515-0d5a-45f8-bc4f-c4de7ba8458b"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c485","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":157,"recorded_at":1780531400000309,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"call_id":"call_01a070ac4c2372d380c3418dd4388cae","text":"Read text file `internal/provhost/doc.go`.\n1|// Package provhost implements the ax host side of the provider plugin\n2|// JSON-over-stdio protocol of pinned specification Section 7.2: one-frame\n3|// JSONL transport, deadlines, size limits, stdout/stderr separation,\n4|// operation dispatch, and status recovery.\n5|//\n6|// The actor every Section 7.2 RFC 2119 keyword governs here is the ax host\n7|// (this repository). The provider plugin is a child process this package\n8|// starts but never trusts: every byte it emits is attacker-influenced, so\n9|// every frame is validated before any member is used, and a different-major\n10|// payload is never parsed far enough to trust its error code, retryable\n11|// bit, details, or authority fields (Section 15.1).\n12|//\n13|// This package owns the envelope layer and the operation-layer\n14|// conformance decoders. Operation dispatch means the host maps an\n15|// operation name to one plugin invocation and refuses unknown names\n16|// locally without spawning; the conformance decoders validate what a\n17|// plugin returned: the closed manifest (7.3), probe and capability\n18|// gate (7.4, 8.3), profile mapping (7.7), quiescence proof (7.6),\n19|// SpawnPlan success bodies for launch and resume, the Provider\n20|// Identity Record and identify-session result (5.5), and the single\n21|// (operation, operation_id) mutation key (7.5). Full Section 7.5\n22|// request-body vocabularies beyond these surfaces, and the\n23|// materialize commit/rollback result bodies, cross this package\n24|// opaquely: a body must still be a JSON object, and the\n25|// materialize-status body this package interprets for recovery must\n26|// satisfy the state/nullability/identity rules Section 7.5 states\n27|// for ProviderTransactionStatus.\n28|//\n29|// A failed read is never an absence: a crashed, timed-out, oversized,\n30|// unparsable, or correlation-mismatched invocation fails with a local\n31|// Structured Error 1.0.0, never with a partial response the caller could\n32|// mistake for a result. Status recovery is fail-closed the same way: an\n33|// unknown or integrity-invalid transaction fails with integrity_failure\n34|// and must be quarantined rather than represented as a successful status.\n35|//\n36|// The package mutates no durable state of its own and keeps no cross-call\n37|// cache: Host starts one plugin process per operation, so successive calls\n38|// are separate processes observing durable state through the authority the\n39|// caller passes, which is the property the cross-process recovery cases\n40|// rest on. Retry decisions belong to the caller; every local failure this\n41|// package emits is non-retryable, because nothing observed at an unusable\n42|// frame licenses a safe-retry claim.\n43|//\n44|// Stated bounds: stderr capture is capped at 1 MiB (an implementation\n45|// resource bound, not a protocol limit); error details carry the failure\n46|// class, member names, and the observed version string only — never\n47|// environment or stderr content. Mutation receipts live in the\n48|// provider transaction document and the plugin, not in the host: the\n49|// host holds no cross-call cache, so cross-crash durability of\n50|// (operation, operation_id) results is the document's property, and\n51|// the host side pins the sole key shape, byte-identical retry bytes,\n52|// and the mismatch surface. The Section 8 provider/platform cell\n53|// values are evidence labels, not host behavior: the host pins the\n54|// fail-closed direction (conditional, unsupported, and unknown are\n55|// never usable) for every capability-by-status tuple rather than one\n56|// cell value. Section 8.2 store-exclusion roots and the remaining\n57|// Section 7.5 request vocabularies have no host production yet.\n58|//\n59|// Provider Protocol 3.0.0, which the v0.5.0 catalog pins alongside\n60|// 2.0.0, has no implementation owner in this package: this host\n61|// speaks major 2 only, classifies any recognizable 3.x envelope as\n62|// incompatible_protocol without trusting its payload, and carries no\n63|// Structured Error 1.3.0 binding or launch/resume descriptor carriage.\n64|// A v3 plugin is therefore refused loudly rather than misread as v2;\n65|// naming the v3 envelope owner is open work, not a silent scope.\n66|package provhost","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c487","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":158,"recorded_at":1780531400000311,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"call_id":"call_01a070ac4cfc7f2096ff41b6c10a70ca","text":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped. Failure details carry the failure class and member names\n38|\t// only, never stderr content.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil, time.Time{}, failure\n199|\t}\n200|\tdeadline, err := req.Deadline.Time()\n201|\tif err != nil {\n202|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n203|\t\tif fault != nil {\n204|\t\t\treturn nil, time.Time{}, fault\n205|\t\t}\n206|\t\treturn nil, time.Time{}, failure\n207|\t}\n208|\tif !deadline.After(now) {\n209|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n210|\t\tif fault != nil {\n211|\t\t\treturn nil, time.Time{}, fault\n212|\t\t}\n213|\t\treturn nil, time.Time{}, failure\n214|\t}\n215|\tif !isJSONObject(req.Body) {\n216|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n217|\t\tif fault != nil {\n218|\t\t\treturn nil, time.Time{}, fault\n219|\t\t}\n220|\t\treturn nil, time.Time{}, failure\n221|\t}\n222|\t// The operation, request ID, deadline, and body above were each\n223|\t// validated before this marshal, so it cannot fail on a reachable\n224|\t// path: the error propagates as a plain Go error rather than\n225|\t// through a refusal site no negative test could exercise.\n226|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n227|\tif err != nil {\n228|\t\treturn nil, time.Time{}, err\n229|\t}\n230|\tif len(frame) > MaxFrameBytes {\n231|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n232|\t\tif fault != nil {\n233|\t\t\treturn nil, time.Time{}, fault\n234|\t\t}\n235|\t\treturn nil, time.Time{}, failure\n236|\t}\n237|\treturn frame, deadline, nil\n238|}\n239|\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read. The lone-surrogate gate runs first:\n262|// encoding/json would silently replace a lone \\ud800-style escape with\n263|// U+FFFD, so the raw bytes are screened before any member is trusted\n264|// (Section 1.6: decoders MUST reject lone surrogate code points).\n265|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n266|\tif hasLoneSurrogateEscape(data) {\n267|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n268|\t}\n269|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n270|\ttoken, err := decoder.Token()\n271|\tif err != nil {\n272|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n273|\t}\n274|\tdelim, ok := token.(json.Delim)\n275|\tif !ok || delim != '{' {\n276|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n277|\t}\n278|\tmembers := map[string]json.RawMessage{}\n279|\tfor decoder.More() {\n280|\t\tkeyToken, err := decoder.Token()\n281|\t\tif err != nil {\n282|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n283|\t\t}\n284|\t\tkey, ok := keyToken.(string)\n285|\t\tif !ok {\n286|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n287|\t\t}\n288|\t\tif _, duplicate := members[key]; duplicate {\n289|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n290|\t\t}\n291|\t\tvar raw json.RawMessage\n292|\t\tif err := decoder.Decode(&raw); err != nil {\n293|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n294|\t\t}\n295|\t\tmembers[key] = raw\n296|\t}\n297|\tif token, err := decoder.Token(); err != nil {\n298|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n299|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n300|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n301|\t}\n302|\tif _, err := decoder.Token(); err != io.EOF {\n303|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n304|\t}\n305|\treturn members, nil\n306|}\n307|\n308|// responseMembers is the exact Section 7.2 response member set: the four\n309|// framing members plus body on success or error on failure, never both,\n310|// never neither, and nothing else. It is package-level so the closed\n311|// vocabulary census derives it: widening the accepted set here must redden\n312|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n313|var responseMembers = map[string]bool{\n314|\t\"protocol\":         true,\n315|\t\"protocol_version\": true,\n316|\t\"request_id\":       true,\n317|\t\"ok\":               true,\n318|\t\"body\":             true,\n319|\t\"error\":            true,\n320|}\n321|\n322|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n323|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n324|\tfor _, name := range required {\n325|\t\tif _, present := members[name]; !present {\n326|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n327|\t\t}\n328|\t}\n329|\tif ok {\n330|\t\tif _, present := members[\"body\"]; !present {\n331|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n332|\t\t}\n333|\t\tif _, forbidden := members[\"error\"]; forbidden {\n334|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n335|\t\t}\n336|\t} else {\n337|\t\tif _, present := members[\"error\"]; !present {\n338|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n339|\t\t}\n340|\t\tif _, forbidden := members[\"body\"]; forbidden {\n341|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n342|\t\t}\n343|\t}\n344|\tfor name := range members {\n345|\t\tif !responseMembers[name] {\n346|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n347|\t\t}\n348|\t}\n349|\treturn nil\n350|}\n351|\n352|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n353|// Anything else is not a recognizable major, so the frame is unusable\n354|// rather than a mismatch.\n355|func parseMajor(version string) (int, bool) {\n356|\tparts := strings.Split(version, \".\")\n357|\tif len(parts) != 3 {\n358|\t\treturn 0, false\n359|\t}\n360|\tmajor := 0\n361|\tfor i := 0; i < len(parts[0]); i++ {\n362|\t\tdigit := parts[0][i]\n363|\t\tif digit < '0' || digit > '9' {\n364|\t\t\treturn 0, false\n365|\t\t}\n366|\t\tmajor = major*10 + int(digit-'0')\n367|\t}\n368|\tif len(parts[0]) == 0 {\n369|\t\treturn 0, false\n370|\t}\n371|\tfor _, rest := range parts[1:] {\n372|\t\tif len(rest) == 0 {\n373|\t\t\treturn 0, false\n374|\t\t}\n375|\t\tfor i := 0; i < len(rest); i++ {\n376|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n377|\t\t\t\treturn 0, false\n378|\t\t\t}\n379|\t\t}\n380|\t}\n381|\treturn major, true\n382|}\n383|\n384|// providerContract is the static Section 7.2 binding every failure\n385|// envelope is decoded under: provider protocol major 2 binds Structured\n386|// Error 1.0.0. The version is never taken from the document.\n387|var providerContract = axerror.ContainingContract{ID: \"urn:ax:protocol:provider\", Major: 2}\n388|\n389|// DecodeResponse validates one stdout line as the single response frame\n390|// for the request carrying wantRequestID. It returns the success body, or\n391|// the bound child failure, or a local failure that trusts nothing from\n392|// the frame. A recognizable foreign major yields incompatible_protocol;\n393|// every other unusable frame yields provider_protocol_error.\n394|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n395|\tif len(frame) > MaxFrameBytes {\n396|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n397|\t\tif err != nil {\n398|\t\t\treturn Response{}, err\n399|\t\t}\n400|\t\treturn Response{}, failure\n401|\t}\n402|\tif !utf8.Valid(frame) {\n403|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n404|\t\tif err != nil {\n405|\t\t\treturn Response{}, err\n406|\t\t}\n407|\t\treturn Response{}, failure\n408|\t}\n409|\tmembers, fault := decodeStrictObject(frame)\n410|\tif fault != nil {\n411|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n412|\t\tif err != nil {\n413|\t\t\treturn Response{}, err\n414|\t\t}\n415|\t\treturn Response{}, failure\n416|\t}\n417|\tvar ok bool\n418|\tif raw, present := members[\"ok\"]; !present {\n419|\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n420|\t\tif err != nil {\n421|\t\t\treturn Response{}, err\n422|\t\t}\n423|\t\treturn Response{}, failure\n424|\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n425|\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n426|\t\tif fault != nil {\n427|\t\t\treturn Response{}, fault\n428|\t\t}\n429|\t\treturn Response{}, failure\n430|\t}\n431|\tif fault := checkResponseMembers(members, ok); fault != nil {\n432|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n433|\t\tif err != nil {\n434|\t\t\treturn Response{}, err\n435|\t\t}\n436|\t\treturn Response{}, failure\n437|\t}\n438|\tvar protocol string\n439|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n440|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n441|\t\tif fault != nil {\n442|\t\t\treturn Response{}, fault\n443|\t\t}\n444|\t\treturn Response{}, failure\n445|\t}\n446|\tvar version string\n447|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n448|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n449|\t\tif fault != nil {\n450|\t\t\treturn Response{}, fault\n451|\t\t}\n452|\t\treturn Response{}, failure\n453|\t}\n454|\tif version != ProtocolVersion {\n455|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n456|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n457|\t\t\tif err != nil {\n458|\t\t\t\treturn Response{}, err\n459|\t\t\t}\n460|\t\t\treturn Response{}, failure\n461|\t\t}\n462|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n463|\t\tif fault != nil {\n464|\t\t\treturn Response{}, fault\n465|\t\t}\n466|\t\treturn Response{}, failure\n467|\t}\n468|\tvar requestID string\n469|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n470|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n471|\t\tif fault != nil {\n472|\t\t\treturn Response{}, fault\n473|\t\t}\n474|\t\treturn Response{}, failure\n475|\t}\n476|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n477|\t\tfailure, fault := failProtocol(\"request_id is not a UUIDv7\", \"request_id\")\n478|\t\tif fault != nil {\n479|\t\t\treturn Response{}, fault\n480|\t\t}\n481|\t\treturn Response{}, failure\n482|\t}\n483|\tif requestID != wantRequestID.String() {\n484|\t\tfailure, fault := failProtocol(\"request_id does not match the request\", \"request_id\")\n485|\t\tif fault != nil {\n486|\t\t\treturn Response{}, fault\n487|\t\t}\n488|\t\treturn Response{}, failure\n489|\t}\n490|\tif ok {\n491|\t\tif !isJSONObject(members[\"body\"]) {\n492|\t\t\tfailure, fault := failProtocol(\"body is not a JSON object\", \"body\")\n493|\t\t\tif fault != nil {\n494|\t\t\t\treturn Response{}, fault\n495|\t\t\t}\n496|\t\t\treturn Response{}, failure\n497|\t\t}\n498|\t\treturn Response{Body: append(json.RawMessage(nil), members[\"body\"]...)}, nil\n499|\t}\n500|\tif !isJSONObject(members[\"error\"]) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c489","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":159,"recorded_at":1780531400000313,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"call_id":"call_01a070ac4dd072a1911ddbc58a1d542d","text":"Read text file `internal/provhost/opdecode.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for the Section 7.3-7.7 operation\n15|// bodies. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the six refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing every\n18|// arm. A helper that fronted a constructor would collapse distinct rules\n19|// into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer: Section\n22|// 7.5 counts and Section 5.1 limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// unknownMember names a member outside the closed set, if any.\n26|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n27|\tfor name := range members {\n28|\t\tif !allowed[name] {\n29|\t\t\treturn name, true\n30|\t\t}\n31|\t}\n32|\treturn \"\", false\n33|}\n34|\n35|// missingMember names the first required member with no value, if any.\n36|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n37|\tfor _, name := range required {\n38|\t\tif _, present := members[name]; !present {\n39|\t\t\treturn name, true\n40|\t\t}\n41|\t}\n42|\treturn \"\", false\n43|}\n44|\n45|// rawString reads a JSON string member.\n46|func rawString(raw json.RawMessage) (string, bool) {\n47|\tvar value string\n48|\tif err := json.Unmarshal(raw, &value); err != nil {\n49|\t\treturn \"\", false\n50|\t}\n51|\treturn value, true\n52|}\n53|\n54|// rawBool reads a JSON boolean member.\n55|func rawBool(raw json.RawMessage) (bool, bool) {\n56|\tvar value bool\n57|\tif err := json.Unmarshal(raw, &value); err != nil {\n58|\t\treturn false, false\n59|\t}\n60|\treturn value, true\n61|}\n62|\n63|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n64|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n65|// even when it names the same mathematical value: the canonical bodies\n66|// carry counts, never measurements.\n67|func rawUint53(raw json.RawMessage) (uint64, bool) {\n68|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n69|\tdecoder.UseNumber()\n70|\tvar value any\n71|\tif err := decoder.Decode(&value); err != nil {\n72|\t\treturn 0, false\n73|\t}\n74|\tnumber, ok := value.(json.Number)\n75|\tif !ok {\n76|\t\treturn 0, false\n77|\t}\n78|\tliteral := number.String()\n79|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n80|\t\treturn 0, false\n81|\t}\n82|\tparsed, err := strconv.ParseUint(literal, 10, 64)\n83|\tif err != nil || parsed > maxUint53 {\n84|\t\treturn 0, false\n85|\t}\n86|\treturn parsed, true\n87|}\n88|\n89|// rawNullableString reads a JSON string-or-null member: null reports\n90|// isNull without a value, any other non-string reports !ok.\n91|func rawNullableString(raw json.RawMessage) (value string, isNull bool, ok bool) {\n92|\tif string(raw) == \"null\" {\n93|\t\treturn \"\", true, true\n94|\t}\n95|\tvalue, ok = rawString(raw)\n96|\treturn value, false, ok\n97|}\n98|\n99|// rawArray reads a JSON array member into its raw elements. Null is not\n100|// an array: every array member in Sections 7.3-7.5 is required.\n101|func rawArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n102|\tif string(bytes.TrimSpace(raw)) == \"null\" {\n103|\t\treturn nil, false\n104|\t}\n105|\tvar elements []json.RawMessage\n106|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&elements); err != nil {\n109|\t\treturn nil, false\n110|\t}\n111|\tif elements == nil {\n112|\t\treturn []json.RawMessage{}, true\n113|\t}\n114|\treturn elements, true\n115|}\n116|\n117|// rawStringArray reads an array whose every element is a JSON string.\n118|func rawStringArray(raw json.RawMessage) ([]string, bool) {\n119|\telements, ok := rawArray(raw)\n120|\tif !ok {\n121|\t\treturn nil, false\n122|\t}\n123|\tout := make([]string, 0, len(elements))\n124|\tfor _, element := range elements {\n125|\t\tvalue, ok := rawString(element)\n126|\t\tif !ok {\n127|\t\t\treturn nil, false\n128|\t\t}\n129|\t\tout = append(out, value)\n130|\t}\n131|\treturn out, true\n132|}\n133|\n134|// sortedUniqueStrings reports whether the values are in strictly\n135|// increasing bytewise order: sorted with no duplicates. Bytewise order\n136|// is the canonical-form order every closed array in Sections 7.3-7.5\n137|// is written in.\n138|func sortedUniqueStrings(values []string) bool {\n139|\treturn sort.StringsAreSorted(values) && !hasDuplicateString(values)\n140|}\n141|\n142|func hasDuplicateString(values []string) bool {\n143|\tfor i := 1; i < len(values); i++ {\n144|\t\tif values[i] == values[i-1] {\n145|\t\t\treturn true\n146|\t\t}\n147|\t}\n148|\treturn false\n149|}\n150|\n151|// runeLength reports the Unicode-character length the Section 7 string\n152|// bounds count in. JSON transport is UTF-8, so characters are runes,\n153|// not bytes and not code units.\n154|func runeLength(value string) int {\n155|\treturn utf8.RuneCountInString(value)\n156|}\n157|\n158|// isDigest reports whether the value parses as a content digest.\n159|func isDigest(value string) bool {\n160|\t_, err := scalar.ParseDigest(value)\n161|\treturn err == nil\n162|}\n163|\n164|// isUUIDv7 reports whether the value parses as a UUIDv7.\n165|func isUUIDv7(value string) bool {\n166|\t_, err := scalar.ParseUUIDv7(value)\n167|\treturn err == nil\n168|}\n169|\n170|// isTimestamp reports whether the value parses as a timestamp.\n171|func isTimestamp(value string) bool {\n172|\t_, err := scalar.ParseTimestamp(value)\n173|\treturn err == nil\n174|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
