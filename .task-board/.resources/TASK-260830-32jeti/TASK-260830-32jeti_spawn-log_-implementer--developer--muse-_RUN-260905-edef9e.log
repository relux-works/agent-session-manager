x < len(input); index++ {\ninternal/canonicaljson/canonical.go-516-\t\tif input[index] != '\"' {\ninternal/canonicaljson/canonical.go-517-\t\t\tcontinue\ninternal/canonicaljson/canonical.go-518-\t\t}\ninternal/canonicaljson/canonical.go-519-\t\tfor index++; index < len(input); index++ {\ninternal/canonicaljson/canonical.go-520-\t\t\tswitch input[index] {\ninternal/canonicaljson/canonical.go-521-\t\t\tcase '\"':\ninternal/canonicaljson/canonical.go-522-\t\t\t\tgoto stringComplete\ninternal/canonicaljson/canonical.go-523-\t\t\tcase '\\\\':\ninternal/canonicaljson/canonical.go-524-\t\t\t\tindex++\ninternal/canonicaljson/canonical.go-537-\t\t\t\tcase codeUnit >= 0xd800 && codeUnit <= 0xdbff:\ninternal/canonicaljson/canonical.go-538-\t\t\t\t\tsecond, secondEnd, err := readUTF16Escape(input, end)\ninternal/canonicaljson/canonical.go-539-\t\t\t\t\tif err != nil || second < 0xdc00 || second > 0xdfff {\ninternal/canonicaljson/canonical.go:540:\t\t\t\t\t\treturn invalidJSON(\"high surrogate escape must be followed by a low surrogate escape\")\ninternal/canonicaljson/canonical.go-541-\t\t\t\t\t}\ninternal/canonicaljson/canonical.go-542-\t\t\t\t\tindex = secondEnd - 1\ninternal/canonicaljson/canonical.go-543-\t\t\t\tcase codeUnit >= 0xdc00 && codeUnit <= 0xdfff:\ninternal/canonicaljson/canonical.go:544:\t\t\t\t\treturn invalidJSON(\"lone low surrogate escape is forbidden\")\ninternal/canonicaljson/canonical.go-545-\t\t\t\t}\ninternal/canonicaljson/canonical.go-546-\t\t\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\ninternal/canonicaljson/canonical.go-547-\t\t\t\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\ninternal/canonicaljson/canonical.go-548-\t\t\t\t0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\ninternal/canonicaljson/canonical.go-549-\t\t\t\t0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:\ninternal/canonicaljson/canonical.go-550-\t\t\t\treturn invalidJSON(\"unescaped control character in string\")\ninternal/canonicaljson/canonical.go-551-\t\t\t}\ninternal/can