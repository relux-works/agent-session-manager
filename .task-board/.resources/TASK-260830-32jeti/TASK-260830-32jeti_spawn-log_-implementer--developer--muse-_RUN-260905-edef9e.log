{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c9","stream":{"kind":"session","id":"01a070ab-e5ec-77e1-8b81-6518e8a08211"},"sequence":191,"recorded_at":1780531400000377,"record_type":"event","durability":"durable","causation_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1229eb00-c1b9-42f9-9a80-dbf339369c34","run_stream":{"kind":"run","id":"1229eb00-c1b9-42f9-9a80-dbf339369c34"},"task_stream":{"kind":"task","id":"ec736f5d-bc39-4771-babc-e859728142ef"},"task_id":"ec736f5d-bc39-4771-babc-e859728142ef","event":{"kind":"output","task_id":"ec736f5d-bc39-4771-babc-e859728142ef","chunk":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|//\n20|// CheckIdentity deliberately re-validates the record shape instead of\n21|// delegating to canonicaljson.validateProviderIdentityRecord: this\n22|// package must mint Section 15.1 provider-stdio refusals\n23|// (provider_protocol_error with member attribution), not identity\n24|// errors, and the shared package offers no such entry point. The two\n25|// validators must agree on the Section 5.5 shape rule for rule; the\n26|// decoder half of that agreement is pinned by\n27|// TestSurrogateGateAgreesWithCanonicalJSON, and any shape-rule change\n28|// must land in both validators in the same change.\n29|\n30|// identitySchema is the exact schema identifier the record carries.\n31|const identitySchema = \"urn:ax:schema:provider-identity\"\n32|\n33|// identitySchemaVersion is the only identity version accepted.\n34|const identitySchemaVersion = \"1.0.0\"\n35|\n36|// identityKinds is the closed identity-kind enum in section order.\n37|var identityKinds = []string{\n38|\t\"session_uuid\",\n39|\t\"session_path_or_id\",\n40|\t\"backend_conversation_uuid\",\n41|\t\"task_board_managed\",\n42|\t\"provider_defined\",\n43|}\n44|\n45|// identityMembers is the exact required member set of a Provider\n46|// Identity Record.\n47|var identityMembers = map[string]bool{\n48|\t\"schema\":                    true,\n49|\t\"schema_version\":            true,\n50|\t\"record_id\":                 true,\n51|\t\"subject_id\":                true,\n52|\t\"session_id\":                true,\n53|\t\"provider_id\":               true,\n54|\t\"provider_version\":          true,\n55|\t\"provider_version_range\":    true,\n56|\t\"native_session_id\":         true,\n57|\t\"identity_kind\":             true,\n58|\t\"logical_workspace_id\":      true,\n59|\t\"backend_realm_fingerprint\": true,\n60|\t\"opaque_identity\":           true,\n61|\t\"created_by_host_id\":        true,\n62|\t\"created_at\":                true,\n63|\t\"extensions\":                true,\n64|}\n65|\n66|// identityRequired lists identityMembers in a fixed order so a record\n67|// missing several members always names the same one.\n68|var identityRequired = []string{\n69|\t\"schema\",\n70|\t\"schema_version\",\n71|\t\"record_id\",\n72|\t\"subject_id\",\n73|\t\"session_id\",\n74|\t\"provider_id\",\n75|\t\"provider_version\",\n76|\t\"provider_version_range\",\n77|\t\"native_session_id\",\n78|\t\"identity_kind\",\n79|\t\"logical_workspace_id\",\n80|\t\"backend_realm_fingerprint\",\n81|\t\"opaque_identity\",\n82|\t\"created_by_host_id\",\n83|\t\"created_at\",\n84|\t\"extensions\",\n85|}\n86|\n87|// identityKeyPattern is the provider-identity key grammar Section 5.5\n88|// states: [a-z][a-z0-9_.-]{0,63}.\n89|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n90|\n91|// windowsDrivePattern matches a Windows drive-qualified absolute\n92|// prefix: a letter, a colon, and a separator.\n93|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n94|\n95|// CheckIdentity validates one Provider Identity Record naming the\n96|// expected provider. Shape violations are provider_protocol_errors;\n97|// a well-formed record for another provider is an invalid_config\n98|// caller error: the caller correlated the wrong identity to this\n99|// session.\n100|func CheckIdentity(body []byte, wantProviderID string) error {\n101|\tmembers, fault := decodeStrictObject(body)\n102|\tif fault != nil {\n103|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n104|\t\tif err != nil {\n105|\t\t\treturn err\n106|\t\t}\n107|\t\treturn failure\n108|\t}\n109|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n110|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n111|\t\tif err != nil {\n112|\t\t\treturn err\n113|\t\t}\n114|\t\treturn failure\n115|\t}\n116|\tif name, missing := missingMember(members, identityRequired); missing {\n117|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n118|\t\tif err != nil {\n119|\t\t\treturn err\n120|\t\t}\n121|\t\treturn failure\n122|\t}\n123|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n124|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n125|\t\tif err != nil {\n126|\t\t\treturn err\n127|\t\t}\n128|\t\treturn failure\n129|\t}\n130|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n131|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n132|\t\tif err != nil {\n133|\t\t\treturn err\n134|\t\t}\n135|\t\treturn failure\n136|\t}\n137|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n138|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n139|\t\tif err != nil {\n140|\t\t\treturn err\n141|\t\t}\n142|\t\treturn failure\n143|\t}\n144|\tsubject, ok := rawString(members[\"subject_id\"])\n145|\tif !ok || !isUUIDv7(subject) {\n146|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n147|\t\tif err != nil {\n148|\t\t\treturn err\n149|\t\t}\n150|\t\treturn failure\n151|\t}\n152|\tsession, ok := rawString(members[\"session_id\"])\n153|\tif !ok || !isUUIDv7(session) {\n154|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n155|\t\tif err != nil {\n156|\t\t\treturn err\n157|\t\t}\n158|\t\treturn failure\n159|\t}\n160|\tif subject != session {\n161|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n162|\t\tif err != nil {\n163|\t\t\treturn err\n164|\t\t}\n165|\t\treturn failure\n166|\t}\n167|\tprovider, ok := rawString(members[\"provider_id\"])\n168|\tif !ok || !validProviderID(provider) {\n169|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n170|\t\tif err != nil {\n171|\t\t\treturn err\n172|\t\t}\n173|\t\treturn failure\n174|\t}\n175|\tif provider != wantProviderID {\n176|\t\tfailure, err := failInvalid(\"identity names another provider\")\n177|\t\tif err != nil {\n178|\t\t\treturn err\n179|\t\t}\n180|\t\treturn failure\n181|\t}\n182|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n183|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n184|\t\tif err != nil {\n185|\t\t\treturn err\n186|\t\t}\n187|\t\treturn failure\n188|\t}\n189|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n190|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n191|\t\tif err != nil {\n192|\t\t\treturn err\n193|\t\t}\n194|\t\treturn failure\n195|\t}\n196|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n197|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n198|\t\tif err != nil {\n199|\t\t\treturn err\n200|\t\t}\n201|\t\treturn failure\n202|\t}\n203|\tkind, ok := rawString(members[\"identity_kind\"])\n204|\tif !ok || !isIdentityKind(kind) {\n205|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n206|\t\tif err != nil {\n207|\t\t\treturn err\n208|\t\t}\n209|\t\treturn failure\n210|\t}\n211|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n212|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n213|\t\tif err != nil {\n214|\t\t\treturn err\n215|\t\t}\n216|\t\treturn failure\n217|\t}\n218|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n219|\t\treturn err\n220|\t}\n221|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n222|\t\treturn err\n223|\t}\n224|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n225|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n226|\t\tif err != nil {\n227|\t\t\treturn err\n228|\t\t}\n229|\t\treturn failure\n230|\t}\n231|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n232|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n233|\t\tif err != nil {\n234|\t\t\treturn err\n235|\t\t}\n236|\t\treturn failure\n237|\t}\n238|\tif !isJSONObject(members[\"extensions\"]) {\n239|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n240|\t\tif err != nil {\n241|\t\t\treturn err\n242|\t\t}\n243|\t\treturn failure\n244|\t}\n245|\treturn nil\n246|}\n247|\n248|// checkIdentityRealm enforces the digest-or-null shape and the one\n249|// conditional rule Section 5.5 states: an Antigravity\n250|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n251|// because the backend realm is a resume precondition there.\n252|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n253|\trealm, isNull, ok := rawNullableString(raw)\n254|\tif !ok || (!isNull && !isDigest(realm)) {\n255|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n256|\t\tif err != nil {\n257|\t\t\treturn err\n258|\t\t}\n259|\t\treturn failure\n260|\t}\n261|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n262|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n263|\t\tif err != nil {\n264|\t\t\treturn err\n265|\t\t}\n266|\t\treturn failure\n267|\t}\n268|\treturn nil\n269|}\n270|\n271|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n272|// object of at most 32 entries, keyed by the provider-identity key\n273|// grammar, with non-secret string values of 1..1,024 characters that\n274|// MUST NOT begin with an absolute path.\n275|func checkIdentityOpaque(raw json.RawMessage) error {\n276|\topaque, fault := decodeStrictObject(raw)\n277|\tif fault != nil {\n278|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n279|\t\tif err != nil {\n280|\t\t\treturn err\n281|\t\t}\n282|\t\treturn failure\n283|\t}\n284|\tif len(opaque) > 32 {\n285|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n286|\t\tif err != nil {\n287|\t\t\treturn err\n288|\t\t}\n289|\t\treturn failure\n290|\t}\n291|\tkeys := make([]string, 0, len(opaque))\n292|\tfor key := range opaque {\n293|\t\tkeys = append(keys, key)\n294|\t}\n295|\tfor _, key := range keys {\n296|\t\tif !identityKeyPattern.MatchString(key) {\n297|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n298|\t\t\tif err != nil {\n299|\t\t\t\treturn err\n300|\t\t\t}\n301|\t\t\treturn failure\n302|\t\t}\n303|\t\tvalue, ok := rawString(opaque[key])\n304|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n305|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n306|\t\t\tif err != nil {\n307|\t\t\t\treturn err\n308|\t\t\t}\n309|\t\t\treturn failure\n310|\t\t}\n311|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n312|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n313|\t\t\tif err != nil {\n314|\t\t\t\treturn err\n315|\t\t\t}\n316|\t\t\treturn failure\n317|\t\t}\n318|\t}\n319|\treturn nil\n320|}\n321|\n322|func isIdentityKind(value string) bool {\n323|\tfor _, kind := range identityKinds {\n324|\t\tif value == kind {\n325|\t\t\treturn true\n326|\t\t}\n327|\t}\n328|\treturn false\n329|}\n330|\n331|// identifyMembers is the exact required member set of an\n332|// identify-session success body.\n333|var identifyMembers = map[string]bool{\n334|\t\"identity\":         true,\n335|\t\"confidence\":       true,\n336|\t\"matched_evidence\": true,\n337|}\n338|\n339|// identifyRequired lists identifyMembers in a fixed order.\n340|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n341|\n342|// identifyConfidences is the closed confidence vocabulary.\n343|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n344|\n345|// identifyEvidence is the closed matched-evidence vocabulary.\n346|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n347|\n348|// DecodeIdentifyResult validates one identify-session success body:\n349|// the Provider Identity Record for the expected provider, a closed\n350|// confidence, and 1..4 sorted unique matched-evidence members.\n351|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n352|\tmembers, fault := decodeStrictObject(body)\n353|\tif fault != nil {\n354|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n355|\t\tif err != nil {\n356|\t\t\treturn err\n357|\t\t}\n358|\t\treturn failure\n359|\t}\n360|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n361|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n362|\t\tif err != nil {\n363|\t\t\treturn err\n364|\t\t}\n365|\t\treturn failure\n366|\t}\n367|\tif name, missing := missingMember(members, identifyRequired); missing {\n368|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n369|\t\tif err != nil {\n370|\t\t\treturn err\n371|\t\t}\n372|\t\treturn failure\n373|\t}\n374|\tconfidence, ok := rawString(members[\"confidence\"])\n375|\tif !ok || !isIdentifyConfidence(confidence) {\n376|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n377|\t\tif err != nil {\n378|\t\t\treturn err\n379|\t\t}\n380|\t\treturn failure\n381|\t}\n382|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n383|\t\treturn err\n384|\t}\n385|\tif !isJSONObject(members[\"identity\"]) {\n386|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n387|\t\tif err != nil {\n388|\t\t\treturn err\n389|\t\t}\n390|\t\treturn failure\n391|\t}\n392|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n393|\t\treturn err\n394|\t}\n395|\treturn nil\n396|}\n397|\n398|func isIdentifyConfidence(value string) bool {\n399|\tfor _, confidence := range identifyConfidences {\n400|\t\tif value == confidence {\n401|\t\t\treturn true\n402|\t\t}\n403|\t}\n404|\treturn false\n405|}\n406|\n407|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n408|// evidence members: the observation must cite what matched, exactly\n409|// once each.\n410|func checkIdentifyEvidence(raw json.RawMessage) error {\n411|\tevidence, ok := rawStringArray(raw)\n412|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n413|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n414|\t\tif err != nil {\n415|\t\t\treturn err\n416|\t\t}\n417|\t\treturn failure\n418|\t}\n419|\tallowed := map[string]bool{}\n420|\tfor _, member := range identifyEvidence {\n421|\t\tallowed[member] = true\n422|\t}\n423|\tfor _, member := range evidence {\n424|\t\tif !allowed[member] {\n425|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n426|\t\t\tif err != nil {\n427|\t\t\t\treturn err\n428|\t\t\t}\n429|\t\t\treturn failure\n430|\t\t}\n431|\t}\n432|\tif !sortedUniqueStrings(evidence) {\n433|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n434|\t\tif err != nil {\n435|\t\t\treturn err\n436|\t\t}\n437|\t\treturn failure\n438|\t}\n439|\treturn nil\n440|}"}}}
