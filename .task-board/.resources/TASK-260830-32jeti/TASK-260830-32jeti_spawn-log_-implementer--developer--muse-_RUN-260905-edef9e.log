rity|status operation_id is not a string`, name: \"numeric operation id\", prove: func(t *testing.T) {\n683|\t\t\t_, err := DecodeStatusOutcome(withOp(`\"operation_id\":7,`), testStatusIDs())\n684|\t\t\trequireIntegrityRefusal(t, err, \"status operation_id is not a string\", \"\")\n685|\t\t}},\n686|\t\t{arm: `integrity|status operation_id is not a UUIDv7`, name: \"bogus operation id\", prove: func(t *testing.T) {\n687|\t\t\t_, err := DecodeStatusOutcome(withOp(`\"operation_id\":\"bogus\",`), testStatusIDs())\n688|\t\t\trequireIntegrityRefusal(t, err, \"status operation_id is not a UUIDv7\", \"\")\n689|\t\t}},\n690|\t\t{arm: `integrity|status state is not a registry member`, name: \"preparing state\", prove: func(t *testing.T) {\n691|\t\t\tbody := strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1)\n692|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n693|\t\t\trequireIntegrityRefusal(t, err, \"status state is not a registry member\", \"\")\n694|\t\t}},\n695|\t\t{arm: `integrity|status plan_id is not a string`, name: \"numeric plan id\", prove: func(t *testing.T) {\n696|\t\t\tbody := strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1)\n697|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n698|\t\t\trequireIntegrityRefusal(t, err, \"status plan_id is not a string\", \"prepared\")\n699|\t\t}},\n700|\t\t{arm: `integrity|status plan_id is not a digest`, name: \"malformed digest\", prove: func(t *testing.T) {\n701|\t\t\tbody := strings.Replace(good, testPlanID, \"sha256:xyz\", 1)\n702|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n703|\t\t\trequireIntegrityRefusal(t, err, \"status plan_id is not a digest\", \"prepared\")\n704|\t\t}},\n705|\t\t{arm: `integrity|status rollback_token is not a string`, name: \"numeric token\", prove: func(t *testing.T) {\n706|\t\t\tbody := strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1)\n707|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n708|\t\t\trequireIntegrityRefusal(t, err, \"status rollback_token is not a string\", \"prepared\")\n709|\t\t}},\n710|\t\t{arm: `integrity|status rollback_token is shorter than 256 bits`, name: \"short token\", prove: func(t *testing.T) {\n711|\t\t\tbody := strings.Replace(good, testRollbackToken, \"YWJj\", 1)\n712|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n713|\t\t\trequireIntegrityRefusal(t, err, \"status rollback_token is shorter than 256 bits\", \"prepared\")\n714|\t\t}},\n715|\t\t{arm: `integrity|status native_discovery is not an object`, name: \"scalar discovery\", prove: func(t *testing.T) {\n716|\t\t\tbody := strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1)\n717|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n718|\t\t\trequireIntegrityRefusal(t, err, \"status native_discovery is not an object\", \"prepared\")\n719|\t\t}},\n720|\t\t{arm: `integrity|unknown status carries plan, token, or discovery`, name: \"unknown with plan\", prove: func(t *testing.T) {\n721|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"unknown\", \"null\", \"null\")\n722|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n723|\t\t\trequireIntegrityRefusal(t, err, \"unknown status carries plan, token, or discovery\", \"unknown\")\n724|\t\t}},\n725|\t\t{arm: `integrity|transaction state is unknown`, name: \"well-shaped unknown quarantines\", prove: func(t *testing.T) {\n726|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n727|\t\t\tstate, err := DecodeStatusOutcome(body, testStatusIDs())\n728|\t\t\tif state != \"\" {\n729|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q for unknown, want no status\", state)\n730|\t\t\t}\n731|\t\t\trequireIntegrityRefusal(t, err, \"transaction state is unknown\", \"unknown\")\n732|\t\t}},\n733|\t\t{arm: `integrity|prepared status misses plan, token, or discovery`, name: \"prepared without plan\", prove: func(t *testing.T) {\n734|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"prepared\", testRollbackToken, testDiscovery)\n735|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n736|\t\t\trequireIntegrityRefusal(t, err, \"prepared status misses plan, token, or discovery\", \"prepared\")\n737|\t\t}},\n738|\t\t{arm: `integrity|terminal status misses plan or discovery or keeps a token`, name: \"committed keeping token\", prove: func(t *testing.T) {\n739|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", testRollbackToken, testDiscovery)\n740|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n741|\t\t\trequireIntegrityRefusal(t, err, \"terminal status misses plan or discovery or keeps a token\", \"committed\")\n742|\t\t}},\n743|\t}\n744|}\n745|\n746|// declaredParseWitnesses proves each parseMajor rejection branch at the\n747|// production entry. Every value below carries a numeric rest (or no rest\n748|// at all), so only the named branch can refuse it; the prove function\n749|// additionally requires parseMajor itself to reject the version, which\n750|// attributes the DecodeResponse refusal to the classification branch\n751|// rather than to any frame gate. Exit 13 distinguishes the unusable-frame\n752|// path from the exit-6 mismatch path a deleted branch promotes to.\n753|func declaredParseWitnesses() []armWitness {\n754|\tproveUnrecognized := func(version string) func(*testing.T) {\n755|\t\treturn func(t *testing.T) {\n756|\t\t\tt.Helper()\n757|\t\t\tif major, recognized := parseMajor(version); recognized {\n758|\t\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n759|\t\t\t}\n760|\t\t\t_, err := DecodeResponse(armVersionFrame(version), mustUUIDv7(t, testRequestID))\n761|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n762|\t\t\tif failureExit(t, err) != 13 {\n763|\t\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n764|\t\t\t}\n765|\t\t}\n766|\t}\n767|\treturn []armWitness{\n768|\t\t{arm: `parse|len(parts) != 3`, name: \"two-part version\", prove: proveUnrecognized(\"3.0\")},\n769|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"non-numeric major\", prove: proveUnrecognized(\"a.0.0\")},\n770|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"alphanumeric major\", prove: proveUnrecognized(\"2a.0.0\")},\n771|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"negative major\", prove: proveUnrecognized(\"-1.0.0\")},\n772|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"plus major\", prove: proveUnrecognized(\"+3.0.0\")},\n773|\t\t{arm: `parse|len(parts[0]) == 0`, name: \"empty major\", prove: proveUnrecognized(\".0.0\")},\n774|\t\t{arm: `parse|len(rest) == 0`, name: \"empty minor\", prove: proveUnrecognized(\"3..0\")},\n775|\t\t{arm: `parse|rest[i] < '0' || rest[i] > '9'`, name: \"non-numeric rest\", prove: proveUnrecognized(\"3.b.c\")},\n776|\t}\n777|}\n778|\n779|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction: every\n780|// arm derived from production must carry a witness. A planted arm (a new\n781|// frameFault literal or integrity detail through an existing constructor\n782|// site) lands here as an unwitnessed arm.\n783|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n784|\tderived := deriveRefusalArms(t)\n785|\twitnessed := map[string]int{}\n786|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n787|\t\twitnessed[witness.arm]++\n788|\t}\n789|\tvar missing []string\n790|\tfor arm := range derived {\n791|\t\tif witnessed[arm] == 0 {\n792|\t\t\tmissing = append(missing, arm)\n793|\t\t}\n794|\t}\n795|\tsort.Strings(missing)\n796|\tif len(missing) > 0 {\n797|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n798|\t}\n799|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n(more lines below)"}}}
