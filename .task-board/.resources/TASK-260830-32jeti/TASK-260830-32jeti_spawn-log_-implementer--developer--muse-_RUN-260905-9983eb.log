{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44f","stream":{"kind":"session","id":"01a072e1-8ffd-77a3-aa9e-51910585d2fb"},"sequence":130,"recorded_at":1780531400000255,"record_type":"event","durability":"durable","causation_id":"f9810d01-439e-4fb2-95c8-6dd0f8559161","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f9810d01-439e-4fb2-95c8-6dd0f8559161","run_stream":{"kind":"run","id":"f9810d01-439e-4fb2-95c8-6dd0f8559161"},"task_stream":{"kind":"task","id":"c8df2765-b664-429d-95cd-f6651288517f"},"task_id":"c8df2765-b664-429d-95cd-f6651288517f","event":{"kind":"output","task_id":"c8df2765-b664-429d-95cd-f6651288517f","chunk":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"task-board q --help 2>&1 | head -40\",\n  \"description\": \"Check query syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Execute queries against the board using a compact DSL.\\n\\nOperations:\\n  get(ID)              Get a single element by ID\\n  activity(ID, ...)    Read bounded, cursor-paginated element activity\\n  list(filters...)     List elements with filters\\n  count(filters...)    Count elements matching filters\\n  summary()            Board overview (counts + active/blocked)\\n  plan(scope?)         Execution phases; scope=[ID,ID,...] plans the union of subtrees\\n  agents(stale=N?)     Agent dashboard\\n  models(agent?)       Available models for spawn\\n  project_config()     Full active project board runtime config (always local)\\n  project_config(view=spawn-preflight, role=ROLE, agent=PROVIDER?)\\n                       Narrow effective child-spawn policy for one target\\n  provider_limits()    Machine-scoped provider rate-limit state (always local)\\n  provider_limits(identity=KEY|all_identities=true)\\n                       Report one indexed provider identity, or every one\\n  whoami()             Current remote URL and active user (always local)\\n  schema()             Introspect the full operations/fields/presets contract\\n  schema(operation=NAME|mutation=NAME)\\n                       Return only one typed operation or mutation signature\\n\\nField projection:\\n  { id status assignee }     Select specific fields\\n  { overview }               Use a base preset (minimal, default, overview, full, progress, planning)\\n  { observability-task }     Use project observability presets (project, epic, story, task)\\n  (omitted)                  Defaults to { id name status }\\n\\nBatching:\\n  Separate multiple queries with semicolons; results preserve source order\\n\\nSpawn policy projection:\\n  Full project_config reports the effective spawn-policy-v2/v3 contract,\\n  authority, normalized provider and role-effective policy, and exact config\\n  provenance. V2 additionally reports its frozen compatibility snapshot and a\\n  copy-ready v3 migration object; this is read-only evidence and never edits\\n  task-board.config.json. Spawn-preflight returns only the selected role policy\\n  and its actionable migration warning.\\n\\nOutput format:\\n\",\n  \"original_output_bytes\": 2104,\n  \"original_output_tokens\": 526,\n  \"truncated\": false\n}"}}}
