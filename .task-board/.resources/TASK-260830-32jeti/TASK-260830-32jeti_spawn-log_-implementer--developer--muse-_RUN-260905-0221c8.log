lf is pinned against the\n177|// specification text by the inventory test.\n178|func TestEncodeRequestDispatchesEveryRegistryOperation(t *testing.T) {\n179|\tnow := mustInstant(t, testNow)\n180|\tfor _, name := range Operations() {\n181|\t\treq := testRequest(t)\n182|\t\treq.Operation = Operation(name)\n183|\t\tframe, err := EncodeRequest(req, now)\n184|\t\tif err != nil {\n185|\t\t\tt.Fatalf(\"EncodeRequest(%q): %v\", name, err)\n186|\t\t}\n187|\t\tvar decoded struct {\n188|\t\t\tOperation string `json:\"operation\"`\n189|\t\t}\n190|\t\tif err := json.Unmarshal(frame, &decoded); err != nil {\n191|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame is not JSON: %v\", name, err)\n192|\t\t}\n193|\t\tif decoded.Operation != name {\n194|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame carries operation %q\", name, decoded.Operation)\n195|\t\t}\n196|\t}\n197|}\n198|\n199|// TestEncodeRequestRefusals proves framing fails closed before any\n200|// process starts: unknown operations, non-UUIDv7 request IDs, stale or\n201|// malformed deadlines, non-object bodies, and oversize frames are all\n202|// invalid_config from EncodeRequest. The production entry point is\n203|// EncodeRequest.\n204|func TestEncodeRequestRefusals(t *testing.T) {\n205|\tnow := mustInstant(t, testNow)\n206|\tfor _, kase := range []struct {\n207|\t\tname   string\n208|\t\tmutate func(*Request)\n209|\t\tdetail string\n210|\t}{\n211|\t\t{\"unknown operation\", func(req *Request) { req.Operation = \"reboot\" }, \"unknown operation\"},\n212|\t\t{\"empty operation\", func(req *Request) { req.Operation = \"\" }, \"unknown operation\"},\n213|\t\t{\"zero request id\", func(req *Request) { req.RequestID = scalar.UUIDv7{} }, \"request_id is not a UUIDv7\"},\n214|\t\t{\"zero deadline\", func(req *Request) { req.Deadline = scalar.Timestamp{} }, \"deadline is not a timestamp\"},\n215|\t\t{\"past deadline\", func(req *Request) { req.Deadline = mustTimestamp(t, testNow) }, \"deadline is not in the future\"},\n216|\t\t{\"deadline long past\", func(req *Request) { req.Deadline = mustTimestamp(t, \"2020-01-01T00:00:00.000Z\") }, \"deadline is not in the future\"},\n217|\t\t{\"array body\", func(req *Request) { req.Body = json.RawMessage(`[1,2]`) }, \"body is not a JSON object\"},\n218|\t\t{\"string body\", func(req *Request) { req.Body = json.RawMessage(`\"x\"`) }, \"body is not a JSON object\"},\n219|\t\t{\"scalar body\", func(req *Request) { req.Body = json.RawMessage(`3`) }, \"body is not a JSON object\"},\n220|\t\t{\"empty body\", func(req *Request) { req.Body = nil }, \"body is not a JSON object\"},\n221|\t\t{\"blank body\", func(req *Request) { req.Body = json.RawMessage(`  `) }, \"body is not a JSON object\"},\n222|\t\t{\"malformed body\", func(req *Request) { req.Body = json.RawMessage(`{oops`) }, \"body is not a JSON object\"},\n223|\t\t{\"oversize frame\", func(req *Request) {\n224|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n225|\t\t}, \"request frame exceeds 8 MiB\"},\n226|\t} {\n227|\t\tt.Run(kase.name, func(t *testing.T) {\n228|\t\t\treq := testRequest(t)\n229|\t\t\tkase.mutate(&req)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
