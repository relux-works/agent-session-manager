ion:7.3\"\n2767|      ],\n2768|      \"production\": {\n2769|        \"path\": \"internal/catalog/catalog.go\",\n2770|        \"declaration\": \"ForRelease\"\n2771|      },\n2772|      \"acceptance_cases\": [\n2773|        \"catalog-v050-exact\"\n2774|      ],\n2775|      \"coverage\": \"unmeasured\",\n2776|      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.3; the RFC 2119 scanner measures no clause line under 7.3, because the closed Provider Manifest states its obligations as a required-member table, a 16-entry operation registry and exactly 7 capability names rather than in uppercase keywords, so the gate cannot measure this section - and no provider manifest is implemented anywhere in this repository.\"\n2777|    },\n2778|    {\n2779|      \"kind\": \"section_binding\",\n2780|      \"keys\": [\n2781|        \"section:3.2\"\n2782|      ],\n2783|      \"production\": {\n2784|        \"path\": \"internal/localstore/paths.go\",\n2785|        \"declaration\": \"ResolvePaths\"\n2786|      },\n2787|      \"acceptance_cases\": [\n2788|        \"AC-PATH-001\",\n2789|        \"localstore-path-registry\",\n2790|        \"localstore-layout-owner-only\",\n2791|        \"localstore-digest-path-v1\",\n2792|        \"localstore-immutable-blob-install\",\n2793|        \"localstore-sqlite-projection\"\n2794|      ],\n2795|      \"coverage\": \"unevidenced\",\n2796|      \"gap\": \"ResolvePaths implements the owner-only Section 3.2 path registry, but no clause of Section 3.2 is enumerated against an acceptance case, so the registry makes no clause-level claim about its obligations.\"\n2797|    },\n2798|    {\n2799|      \"kind\": \"section_binding\",\n2800|      \"keys\": [\n2801|        \"section:3.3\"\n2802|      ],\n2803|      \"production\": {\n2804|        \"path\": \"internal/localstore/projection.go\",\n2805|        \"declaration\": \"OpenProjection\"\n2806|      },\n2807|      \"acceptance_cases\": [\n2808|        \"localstore-sqlite-p