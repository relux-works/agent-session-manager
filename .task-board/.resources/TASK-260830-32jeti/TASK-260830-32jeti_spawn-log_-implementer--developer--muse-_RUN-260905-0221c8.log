{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0fb","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":1752,"recorded_at":1780531400003499,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"task_stream":{"kind":"task","id":"f081b54a-4d98-4a95-8cd4-d9babdcbe1b3"},"task_id":"f081b54a-4d98-4a95-8cd4-d9babdcbe1b3","event":{"kind":"output","task_id":"f081b54a-4d98-4a95-8cd4-d9babdcbe1b3","chunk":"Read text file `internal/provhost/quiesce.go`.\n(63 line(s) above)\n64|// converts the request.\n65|func DecodeQuiesceProof(body []byte) (bool, error) {\n66|\tmembers, fault := decodeStrictObject(body)\n67|\tif fault != nil {\n68|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n69|\t\tif err != nil {\n70|\t\t\treturn false, err\n71|\t\t}\n72|\t\treturn false, failure\n73|\t}\n74|\tif name, unknown := unknownMember(members, quiesceMembers); unknown {\n75|\t\tfailure, err := failProtocol(\"quiesce proof carries unknown member\", name)\n76|\t\tif err != nil {\n77|\t\t\treturn err\n78|\t\t}\n79|\t\treturn failure\n80|\t}\n81|\tif name, missing := missingMember(members, quiesceRequired); missing {\n82|\t\tfailure, err := failProtocol(\"quiesce proof misses a required member\", name)\n83|\t\tif err != nil {\n84|\t\t\treturn err\n85|\t\t}\n86|\t\treturn false, failure\n87|\t}\n88|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n89|\t\tfailure, err := failProtocol(\"quiesce provider_id is not a provider id\", \"provider_id\")\n90|\t\tif err != nil {\n91|\t\t\treturn err\n92|\t\t}\n93|\t\treturn failure\n94|\t}\n95|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n96|\t\tfailure, err := failProtocol(\"quiesce provider_version is not 1..128 characters\", \"provider_version\")\n97|\t\tif err != nil {\n98|\t\t\treturn err\n99|\t\t}\n100|\t\treturn failure\n101|\t}\n102|\tinputBlocked, ok := rawBool(members[\"input_blocked\"])\n103|\tif !ok {\n104|\t\tfailure, err := failProtocol(\"quiesce input_blocked is not a boolean\", \"input_blocked\")\n105|\t\tif err != nil {\n106|\t\t\treturn err\n107|\t\t}\n108|\t\treturn failure\n109|\t}\n110|\tforegroundIdle, ok := rawBool(members[\"foreground_idle\"])\n111|\tif !ok {\n112|\t\tfailure, err := failProtocol(\"quiesce foreground_idle is not a boolean\", \"foreground_idle\")\n113|\t\tif err != nil {\n114|\t\t\treturn err\n115|\t\t}\n116|\t\treturn failure\n117|\t}\n118|\tsafe, ok := rawBool(members[\"safe\"])\n119|\tif !ok {\n120|\t\tfailure, err := failProtocol(\"quiesce safe is not a boolean\", \"safe\")\n121|\t\tif err != nil {\n122|\t\t\treturn err\n123|\t\t}\n124|\t\treturn failure\n125|\t}\n126|\tboundaryNull, generationNull, background, backgroundNull, err := checkQuiesceNullable(members)\n127|\tif err != nil {\n128|\t\treturn err\n129|\t}\n130|\tif err := checkQuiesceCounts(members); err != nil {\n131|\t\treturn err\n132|\t}\n133|\tblockers, err := checkQuiesceBlockers(members[\"blockers\"])\n134|\tif err != nil {\n135|\t\treturn err\n136|\t}\n137|\t// A safe claim over unproven facts is the one lie Section 7.6\n138|\t// names: each conjunct below carries a fixture with only it\n139|\t// violated, so narrowing any one conjunct reddens its fixture.\n140|\tif safe {\n141|\t\tif len(blockers) != 0 || !inputBlocked || !foregroundIdle || backgroundNull || !background || boundaryNull || generationNull {\n142|\t\t\tfailure, fault := failProtocol(\"quiesce safe proof leaves a fact unproven\", \"safe\")\n143|\t\t\tif fault != nil {\n144|\t\t\t\treturn fault\n145|\t\t\t}\n146|\t\t\treturn failure\n147|\t\t}\n148|\t}\n149|\treturn nil\n150|}\n151|\n152|// rawNullableBool reads a JSON boolean-or-null member.\n153|func rawNullableBool(raw json.RawMessage) (value bool, isNull bool, ok bool) {\n154|\tif string(raw) == \"null\" {\n155|\t\treturn false, true, true\n156|\t}\n157|\tvalue, ok = rawBool(raw)\n158|\treturn value, false, ok\n159|}\n160|\n161|// checkQuiesceNullable enforces the nullability shapes outside the\n162|// safe rule: boundary_ref is string[1..1024] or null, and\n163|// store_generation is string[1..512] or null. Length is checked here\n(more lines below)"}}}
