:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":false,\"error\":` + string(raw) + `}`)\n260|}\n261|\n262|// TestDecodeResponseAcceptsSuccess proves the positive path returns the\n263|// body verbatim for correlation-matched frames.\n264|func TestDecodeResponseAcceptsSuccess(t *testing.T) {\n265|\tbody := `{\"provider_id\":\"pi\",\"provider_version\":\"0.73.1\",\"findings\":[]}`\n266|\tgot, err := DecodeResponse(successFrame(t, testRequestID, body), mustUUIDv7(t, testRequestID))\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"DecodeResponse: %v\", err)\n269|\t}\n(more lines below)"}}}
