{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d5c7","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":2366,"recorded_at":1780531400004727,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"call_id":"call_01a06f93f40479f392985223e008b709","text":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(499 line(s) above)\n500|\t\t\t_, err := DecodeResponse(armOversizeResponse(t), mustUUIDv7(t, testRequestID))\n501|\t\t\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n502|\t\t}},\n503|\t\t{arm: `ctor|failProtocol|frame is not UTF-8`, name: \"invalid UTF-8\", prove: func(t *testing.T) {\n504|\t\t\tframe := append([]byte{}, successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`)...)\n505|\t\t\tframe[len(frame)-3] = 0xff\n506|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n507|\t\t\trequireFrameRefusal(t, err, \"\", \"frame is not UTF-8\")\n508|\t\t}},\n509|\t\t{arm: `ctor|failProtocol|missing member`, name: \"missing ok\", prove: func(t *testing.T) {\n510|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`)\n511|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n512|\t\t\trequireFrameRefusal(t, err, \"ok\", \"missing member\")\n513|\t\t}},\n514|\t\t{arm: `ctor|failProtocol|member is not a boolean`, name: \"ok is a string\", prove: func(t *testing.T) {\n515|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":\"yes\",\"body\":{}`), mustUUIDv7(t, testRequestID))\n516|\t\t\trequireFrameRefusal(t, err, \"ok\", \"member is not a boolean\")\n517|\t\t}},\n518|\t\t{arm: `ctor|failProtocol|not a provider envelope`, name: \"foreign protocol id\", prove: func(t *testing.T) {\n519|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n520|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n521|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a provider envelope\")\n522|\t\t}},\n523|\t\t{arm: `ctor|failProtocol|member is not a string`, name: \"version is a number\", prove: func(t *testing.T) {\n524|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n525|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n526|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"member is not a string\")\n527|\t\t}},\n528|\t\t{arm: `ctor|failProtocol|unsupported protocol version`, name: \"minor bump\", prove: func(t *testing.T) {\n529|\t\t\t_, err := DecodeResponse(armVersionFrame(\"2.1.0\"), mustUUIDv7(t, testRequestID))\n530|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n531|\t\t}},\n532|\t\t{arm: `ctor|failProtocol|request_id is not a UUIDv7`, name: \"garbage request id\", prove: func(t *testing.T) {\n533|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`)\n534|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n535|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"request_id is not a UUIDv7\")\n536|\t\t}},\n537|\t\t{arm: `ctor|failProtocol|request_id does not match the request`, name: \"crossed response\", prove: func(t *testing.T) {\n538|\t\t\t_, err := DecodeResponse(successFrame(t, testOtherID, `{\"provider_id\":\"pi\"}`), mustUUIDv7(t, testRequestID))\n539|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"request_id does not match the request\")\n540|\t\t}},\n541|\t\t{arm: `ctor|failProtocol|body is not a JSON object`, name: \"array body on success\", prove: func(t *testing.T) {\n542|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":[]`), mustUUIDv7(t, testRequestID))\n543|\t\t\trequireFrameRefusal(t, err, \"body\", \"body is not a JSON object\")\n544|\t\t}},\n545|\t\t{arm: `ctor|failProtocol|error is not a JSON object`, name: \"scalar error on failure\", prove: func(t *testing.T) {\n546|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false,\"error\":1`), mustUUIDv7(t, testRequestID))\n547|\t\t\trequireFrameRefusal(t, err, \"error\", \"error is not a JSON object\")\n548|\t\t}},\n549|\t\t{arm: `ctor|failProtocol|error is not a bound Structured Error 1.0.0`, name: \"unbound child version\", prove: func(t *testing.T) {\n550|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n551|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n552|\t\t\trequireFrameRefusal(t, err, \"error\", \"error is not a bound Structured Error 1.0.0\")\n553|\t\t}},\n554|\t\t{arm: `ctor|failMismatch|foreign protocol major`, name: \"foreign major is not trusted\", prove: func(t *testing.T) {\n555|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"forged_code\",\"message\":\"forged\",\"exit_code\":0,\"retryable\":true,\"details\":{}}}`)\n556|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n557|\t\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n558|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) code = %v, want incompatible_protocol\", err)\n559|\t\t\t}\n560|\t\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n561|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) observed = %v, want the foreign version\", observed)\n562|\t\t\t}\n563|\t\t\tif failureExit(t, err) != 6 {\n564|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) exit = %d, want 6\", failureExit(t, err))\n565|\t\t\t}\n566|\t\t\tif strings.Contains(err.Error(), \"forged_code\") {\n567|\t\t\t\tt.Fatalf(\"foreign payload leaked into the local failure: %v\", err)\n568|\t\t\t}\n569|\t\t}},\n570|\t\t// Host refusals, through Host.Call over the scripted runner.\n571|\t\t{arm: `ctor|failInvalid|host has no runner`, name: \"runnerless host\", prove: func(t *testing.T) {\n572|\t\t\thost := Host{Now: time.Now}\n573|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n574|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"host has no runner\")\n575|\t\t}},\n576|\t\t{arm: `ctor|failTimeout|no response before the request deadline`, name: \"late empty answer\", prove: func(t *testing.T) {\n577|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n578|\t\t\thost := liveHost(runner)\n579|\t\t\treq := liveRequest(t)\n580|\t\t\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n581|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n582|\t\t\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n583|\t\t\tif failureExit(t, err) != 13 {\n584|\t\t\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n585|\t\t\t}\n586|\t\t}},\n587|\t\t{arm: `ctor|failProcess|runner reported no result`, name: \"transport failure with time left\", prove: func(t *testing.T) {\n588|\t\t\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n589|\t\t\thost := liveHost(runner)\n590|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n591|\t\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n592|\t\t}},\n593|\t\t{arm: `ctor|failProtocol|stdout carries more than one frame`, name: \"second line\", prove: func(t *testing.T) {\n594|\t\t\tstdout := append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n')\n595|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: stdout, ExitCode: 0})}}\n596|\t\t\thost := liveHost(runner)\n597|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n598|\t\t\trequireFrameRefusal(t, err, \"\", \"stdout carries more than one frame\")\n599|\t\t}},\n600|\t\t{arm: `ctor|failProcess|plugin exited without a response`, name: \"crash without a frame\", prove: func(t *testing.T) {\n601|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 3})}}\n602|\t\t\thost := liveHost(runner)\n603|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n604|\t\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"plugin exited without a response\")\n605|\t\t}},\n606|\t\t{arm: `ctor|failProtocol|plugin exited without a response`, name: \"clean exit without a frame\", prove: func(t *testing.T) {\n607|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 0})}}\n608|\t\t\thost := liveHost(runner)\n609|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n610|\t\t\trequireFrameRefusal(t, err, \"\", \"plugin exited without a response\")\n611|\t\t}},\n612|\t}\n613|}\n614|\n615|func declaredIntegrityWitnesses() []armWitness {\n616|\tgood := string(preparedBody())\n617|\twithOp := func(fragment string) []byte {\n618|\t\treturn []byte(strings.Replace(good, `\"materialization_id\"`, fragment+`\"materialization_id\"`, 1))\n619|\t}\n620|\treturn []armWitness{\n621|\t\t{arm: `integrity|status body is not a JSON object`, name: \"status body is not JSON\", prove: func(t *testing.T) {\n622|\t\t\t_, err := DecodeStatusOutcome([]byte(`oops`), testStatusIDs())\n623|\t\t\trequireIntegrityRefusal(t, err, \"status body is not a JSON object\", \"\")\n624|\t\t}},\n625|\t\t{arm: `integrity|status body is not a JSON object`, name: \"status body value is truncated\", prove: func(t *testing.T) {\n626|\t\t\t_, err := DecodeStatusOutcome([]byte(`{\"materialization_id\":`), testStatusIDs())\n627|\t\t\trequireIntegrityRefusal(t, err, \"status body is not a JSON object\", \"\")\n628|\t\t}},\n629|\t\t{arm: `integrity|status body is duplicate member`, name: \"status body repeats state\", prove: func(t *testing.T) {\n630|\t\t\tbody := strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1)\n631|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n632|\t\t\trequireIntegrityRefusal(t, err, \"status body is duplicate member\", \"\")\n633|\t\t}},\n634|\t\t{arm: `integrity|status body is trailing data after the object`, name: \"status body has trailing byte\", prove: func(t *testing.T) {\n635|\t\t\t_, err := DecodeStatusOutcome([]byte(good+\"x\"), testStatusIDs())\n636|\t\t\trequireIntegrityRefusal(t, err, \"status body is trailing data after the object\", \"\")\n637|\t\t}},\n638|\t\t{arm: `integrity|status body carries unknown member`, name: \"status body carries phase\", prove: func(t *testing.T) {\n639|\t\t\tbody := strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"phase\":\"prepared\"`, 1)\n640|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n641|\t\t\trequireIntegrityRefusal(t, err, \"status body carries unknown member\", \"\")\n642|\t\t}},\n643|\t\t{arm: `integrity|status body misses a required member`, name: \"status body misses state\", prove: func(t *testing.T) {\n644|\t\t\tbody := strings.Replace(good, `,\"state\":\"prepared\"`, ``, 1)\n645|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n646|\t\t\trequireIntegrityRefusal(t, err, \"status body misses a required member\", \"\")\n647|\t\t}},\n648|\t\t{arm: `integrity|status names another materialization`, name: \"foreign materialization\", prove: func(t *testing.T) {\n649|\t\t\tbody := statusBody(\"0198f4c8-aaaa-73aa-9374-1234567890ab\", testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n650|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n651|\t\t\trequireIntegrityRefusal(t, err, \"status names another materialization\", \"\")\n652|\t\t}},\n653|\t\t{arm: `integrity|status names another transaction`, name: \"foreign transaction\", prove: func(t *testing.T) {\n654|\t\t\tbody := statusBody(testMaterializationID, \"0198f4c8-aaaa-73aa-9374-1234567890ab\", testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n655|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n656|\t\t\trequireIntegrityRefusal(t, err, \"status names another transaction\", \"\")\n657|\t\t}},\n658|\t\t{arm: `integrity|status names another transaction authority`, name: \"foreign authority\", prove: func(t *testing.T) {\n659|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, \"another_authority\", testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n660|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n661|\t\t\trequireIntegrityRefusal(t, err, \"status names another transaction authority\", \"\")\n662|\t\t}},\n663|\t\t{arm: `integrity|status operation_id is not a string`, name: \"numeric operation id\", prove: func(t *testing.T) {\n664|\t\t\t_, err := DecodeStatusOutcome(withOp(`\"operation_id\":7,`), testStatusIDs())\n665|\t\t\trequireIntegrityRefusal(t, err, \"status operation_id is not a string\", \"\")\n666|\t\t}},\n667|\t\t{arm: `integrity|status operation_id is not a UUIDv7`, name: \"bogus operation id\", prove: func(t *testing.T) {\n668|\t\t\t_, err := DecodeStatusOutcome(withOp(`\"operation_id\":\"bogus\",`), testStatusIDs())\n669|\t\t\trequireIntegrityRefusal(t, err, \"status operation_id is not a UUIDv7\", \"\")\n670|\t\t}},\n671|\t\t{arm: `integrity|status state is not a registry member`, name: \"preparing state\", prove: func(t *testing.T) {\n672|\t\t\tbody := strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1)\n673|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n674|\t\t\trequireIntegrityRefusal(t, err, \"status state is not a registry member\", \"\")\n675|\t\t}},\n676|\t\t{arm: `integrity|status plan_id is not a string`, name: \"numeric plan id\", prove: func(t *testing.T) {\n677|\t\t\tbody := strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1)\n678|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n679|\t\t\trequireIntegrityRefusal(t, err, \"status plan_id is not a string\", \"prepared\")\n680|\t\t}},\n681|\t\t{arm: `integrity|status plan_id is not a digest`, name: \"malformed digest\", prove: func(t *testing.T) {\n682|\t\t\tbody := strings.Replace(good, testPlanID, \"sha256:xyz\", 1)\n683|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n684|\t\t\trequireIntegrityRefusal(t, err, \"status plan_id is not a digest\", \"prepared\")\n685|\t\t}},\n686|\t\t{arm: `integrity|status rollback_token is not a string`, name: \"numeric token\", prove: func(t *testing.T) {\n687|\t\t\tbody := strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1)\n688|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n689|\t\t\trequireIntegrityRefusal(t, err, \"status rollback_token is not a string\", \"prepared\")\n690|\t\t}},\n691|\t\t{arm: `integrity|status rollback_token is shorter than 256 bits`, name: \"short token\", prove: func(t *testing.T) {\n692|\t\t\tbody := strings.Replace(good, testRollbackToken, \"YWJj\", 1)\n693|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n694|\t\t\trequireIntegrityRefusal(t, err, \"status rollback_token is shorter than 256 bits\", \"prepared\")\n695|\t\t}},\n696|\t\t{arm: `integrity|status native_discovery is not an object`, name: \"scalar discovery\", prove: func(t *testing.T) {\n697|\t\t\tbody := strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1)\n698|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n699|\t\t\trequireIntegrityRefusal(t, err, \"status native_discovery is not an object\", \"prepared\")\n700|\t\t}},\n701|\t\t{arm: `integrity|unknown status carries plan, token, or discovery`, name: \"unknown with plan\", prove: func(t *testing.T) {\n702|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"unknown\", \"null\", \"null\")\n703|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n704|\t\t\trequireIntegrityRefusal(t, err, \"unknown status carries plan, token, or discovery\", \"unknown\")\n705|\t\t}},\n706|\t\t{arm: `integrity|transaction state is unknown`, name: \"well-shaped unknown quarantines\", prove: func(t *testing.T) {\n707|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n708|\t\t\tstate, err := DecodeStatusOutcome(body, testStatusIDs())\n709|\t\t\tif state != \"\" {\n710|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q for unknown, want no status\", state)\n711|\t\t\t}\n712|\t\t\trequireIntegrityRefusal(t, err, \"transaction state is unknown\", \"unknown\")\n713|\t\t}},\n714|\t\t{arm: `integrity|prepared status misses plan, token, or discovery`, name: \"prepared without plan\", prove: func(t *testing.T) {\n715|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"prepared\", testRollbackToken, testDiscovery)\n716|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n717|\t\t\trequireIntegrityRefusal(t, err, \"prepared status misses plan, token, or discovery\", \"prepared\")\n718|\t\t}},\n719|\t\t{arm: `integrity|terminal status misses plan or discovery or keeps a token`, name: \"committed keeping token\", prove: func(t *testing.T) {\n720|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", testRollbackToken, testDiscovery)\n721|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n722|\t\t\trequireIntegrityRefusal(t, err, \"terminal status misses plan or discovery or keeps a token\", \"committed\")\n723|\t\t}},\n724|\t}\n725|}\n726|\n727|// declaredParseWitnesses proves each parseMajor rejection branch at the\n728|// production entry. Every value below carries a numeric rest (or no rest\n729|// at all), so only the named branch can refuse it; the prove function\n730|// additionally requires parseMajor itself to reject the version, which\n731|// attributes the DecodeResponse refusal to the classification branch\n732|// rather than to any frame gate. Exit 13 distinguishes the unusable-frame\n733|// path from the exit-6 mismatch path a deleted branch promotes to.\n734|func declaredParseWitnesses() []armWitness {\n735|\tproveUnrecognized := func(version string) func(*testing.T) {\n736|\t\treturn func(t *testing.T) {\n737|\t\t\tt.Helper()\n738|\t\t\tif major, recognized := parseMajor(version); recognized {\n739|\t\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n740|\t\t\t}\n741|\t\t\t_, err := DecodeResponse(armVersionFrame(version), mustUUIDv7(t, testRequestID))\n742|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n743|\t\t\tif failureExit(t, err) != 13 {\n744|\t\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n745|\t\t\t}\n746|\t\t}\n747|\t}\n748|\treturn []armWitness{\n749|\t\t{arm: `parse|len(parts) != 3`, name: \"two-part version\", prove: proveUnrecognized(\"3.0\")},\n750|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"non-numeric major\", prove: proveUnrecognized(\"a.0.0\")},\n751|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"alphanumeric major\", prove: proveUnrecognized(\"2a.0.0\")},\n752|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"negative major\", prove: proveUnrecognized(\"-1.0.0\")},\n753|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"plus major\", prove: proveUnrecognized(\"+3.0.0\")},\n754|\t\t{arm: `parse|len(parts[0]) == 0`, name: \"empty major\", prove: proveUnrecognized(\".0.0\")},\n755|\t\t{arm: `parse|len(rest) == 0`, name: \"empty minor\", prove: proveUnrecognized(\"3..0\")},\n756|\t\t{arm: `parse|rest[i] < '0' || rest[i] > '9'`, name: \"non-numeric rest\", prove: proveUnrecognized(\"3.b.c\")},\n757|\t}\n758|}\n759|\n760|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction: every\n761|// arm derived from production must carry a witness. A planted arm (a new\n762|// frameFault literal or integrity detail through an existing constructor\n763|// site) lands here as an unwitnessed arm.\n764|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n765|\tderived := deriveRefusalArms(t)\n766|\twitnessed := map[string]int{}\n767|\tfor _, witness := range append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...) {\n768|\t\twitnessed[witness.arm]++\n769|\t}\n770|\tvar missing []string\n771|\tfor arm := range derived {\n772|\t\tif witnessed[arm] == 0 {\n773|\t\t\tmissing = append(missing, arm)\n774|\t\t}\n775|\t}\n776|\tsort.Strings(missing)\n777|\tif len(missing) > 0 {\n778|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n779|\t}\n780|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n781|}\n782|\n783|// TestWitnessedArmsAreAllDerived is the reverse direction: every witness\n784|// must name an arm production declares. A deleted or narrowed production\n785|// branch orphans its witness and fails here, which is also what makes a\n786|// truncated derivation fail instead of passing vacuously.\n787|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n788|\tderived := deriveRefusalArms(t)\n789|\tvar orphans []string\n790|\tfor _, witness := range append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...) {\n791|\t\tif _, ok := derived[witness.arm]; !ok {\n792|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n793|\t\t}\n794|\t}\n795|\tsort.Strings(orphans)\n796|\tif len(orphans) > 0 {\n797|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n798|\t}\n799|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
