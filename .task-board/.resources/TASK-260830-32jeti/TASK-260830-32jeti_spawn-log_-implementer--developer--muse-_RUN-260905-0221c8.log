{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c475","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":149,"recorded_at":1780531400000293,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"call_id":"call_01a06f86606e7532931b98fe03135a09","text":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"go/ast\"\n9|\t\"go/parser\"\n10|\t\"go/token\"\n11|\t\"os\"\n12|\t\"path/filepath\"\n13|\t\"sort\"\n14|\t\"strconv\"\n15|\t\"strings\"\n16|\t\"testing\"\n17|\t\"time\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|)\n21|\n22|// This file is the derived refusal-arm inventory. It exists because the\n23|// constructor call-site audit in inventory_test.go enumerates constructor\n24|// call SITES, and every frameFault literal and every integrity(...) detail\n25|// funnels through a shared site: planting a new arm through an existing\n26|// site (a new &frameFault literal in checkResponseMembers, a new\n27|// integrity(...) detail in DecodeStatusOutcome) leaves the whole suite\n28|// green. Two review rounds each missed a row by hand, so the arm set is\n29|// derived from production source by parsing it, never by listing it.\n30|//\n31|// Derivation (deriveRefusalArms): every &frameFault{...} literal yields\n32|// frame|<detail>|<member source>; every integrity(...) call with a string\n33|// literal yields integrity|<detail>; the single wrapping site\n34|// integrity(\"status body is \"+fault.detail, ...) expands over the derived\n35|// frame detail set, so each wrapped refusal is its own obligation; every\n36|// rejection branch of parseMajor (a return 0, false) yields\n37|// parse|<enclosing condition source>; every literal first argument to one\n38|// of the six refusal constructors yields ctor|<constructor>|<detail>.\n39|// Non-literal shapes land as expr:<source> obligations rather than passing\n40|// silently, and a missing parseMajor fails the derivation outright.\n41|//\n42|// Both directions are checked: TestDerivedRefusalArmsAreAllWitnessed\n43|// (every derived arm carries a witness) and\n44|// TestWitnessedArmsAreAllDerived (every witness names a derived arm, so a\n45|// truncated derivation reddens on the orphaned witnesses instead of\n46|// passing vacuously). TestEveryArmWitnessRefusesAtTheProductionEntry\n47|// drives each witness through the production entry and requires the\n48|// refusal to come from the arm under test. Empty, single-file, or\n49|// unparseable derivations fail closed: a domain that silently derives\n50|// nothing is not a measurement.\n51|//\n52|// Stated bound: arms sharing one (constructor, detail) identity merge to\n53|// one obligation (the two timeout sites, the two empty-response sites,\n54|// the six identical \"not a JSON object\" sites). Deleting one of a merged\n55|// pair is a behavioral mutant the entry-point tests must catch, not this\n56|// inventory.\n57|\n58|// refusalArmCensusFloor is the derived arm count this test was written\n59|// against. It is a tripwire, not an enumeration: a derivation returning\n60|// fewer arms fails closed even when every surviving arm is witnessed,\n61|// which is what catches a silently truncated scan. Raising it is routine\n62|// when production gains a refusal; lowering it requires saying why.\n63|const refusalArmCensusFloor = 60\n64|\n65|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n66|\tt.Helper()\n67|\tdirectory, err := os.Getwd()\n68|\tif err != nil {\n69|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n70|\t}\n71|\tarms, scanned, err := refusalArmsIn(directory)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n74|\t}\n75|\tif len(scanned) == 0 {\n76|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n77|\t}\n78|\tif len(arms) == 0 {\n79|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n80|\t}\n81|\tif len(arms) < refusalArmCensusFloor {\n82|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n83|\t}\n84|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n85|\treturn arms\n86|}\n87|\n88|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n89|\tentries, err := os.ReadDir(directory)\n90|\tif err != nil {\n91|\t\treturn nil, nil, err\n92|\t}\n93|\tarms := map[string]struct{}{}\n94|\tvar scanned []string\n95|\tparseBranches := 0\n96|\tfileSet := token.NewFileSet()\n97|\ttype productionFile struct {\n98|\t\tsyntax *ast.File\n99|\t\tsource []byte\n100|\t}\n101|\tvar files []productionFile\n102|\tfor _, entry := range entries {\n103|\t\tname := entry.Name()\n104|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n105|\t\t\tcontinue\n106|\t\t}\n107|\t\tscanned = append(scanned, name)\n108|\t\tpath := filepath.Join(directory, name)\n109|\t\tsource, err := os.ReadFile(path)\n110|\t\tif err != nil {\n111|\t\t\treturn nil, nil, err\n112|\t\t}\n113|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n114|\t\tif err != nil {\n115|\t\t\treturn nil, nil, err\n116|\t\t}\n117|\t\tfiles = append(files, productionFile{syntax: syntax, source: source})\n118|\t}\n119|\t// First pass, package-wide: the decodeStrictObject fault detail\n120|\t// set, which the integrity wrapper site expands over. The wrapper\n121|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n122|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n123|\t// set: expanding over every frameFault literal would invent arms\n124|\t// production can never emit. The pass must span files because the\n125|\t// literals live in protocol.go while the wrapper lives in status.go.\n126|\tvar strictDetails []string\n127|\tseenDetail := map[string]bool{}\n128|\tfor _, file := range files {\n129|\t\tfor _, decl := range file.syntax.Decls {\n130|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n131|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n132|\t\t\t\tcontinue\n133|\t\t\t}\n134|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n135|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n136|\t\t\t\tif !ok {\n137|\t\t\t\t\treturn true\n138|\t\t\t\t}\n139|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n140|\t\t\t\tif !ok {\n141|\t\t\t\t\treturn true\n142|\t\t\t\t}\n143|\t\t\t\tif !seenDetail[detail] {\n144|\t\t\t\t\tseenDetail[detail] = true\n145|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n146|\t\t\t\t}\n147|\t\t\t\treturn true\n148|\t\t\t})\n149|\t\t}\n150|\t}\n151|\tfor _, file := range files {\n152|\t\tsource, syntax := file.source, file.syntax\n153|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n154|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n155|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n156|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n157|\t\t\t\tif !ok {\n158|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n159|\t\t\t\t\treturn true\n160|\t\t\t\t}\n161|\t\t\t\tmember := \"\"\n162|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n163|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n164|\t\t\t\t}\n165|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n166|\t\t\t\treturn true\n167|\t\t\t}\n168|\t\t\tcall, ok := node.(*ast.CallExpr)\n169|\t\t\tif !ok {\n170|\t\t\t\treturn true\n171|\t\t\t}\n172|\t\t\tident, ok := call.Fun.(*ast.Ident)\n173|\t\t\tif !ok || len(call.Args) == 0 {\n174|\t\t\t\treturn true\n175|\t\t\t}\n176|\t\t\tswitch ident.Name {\n177|\t\t\tcase \"integrity\":\n178|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n179|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n180|\t\t\t\t\tif err != nil {\n181|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n182|\t\t\t\t\t\treturn true\n183|\t\t\t\t\t}\n184|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n185|\t\t\t\t\treturn true\n186|\t\t\t\t}\n187|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n188|\t\t\t\t\tif len(strictDetails) == 0 {\n189|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n190|\t\t\t\t\t\treturn true\n191|\t\t\t\t\t}\n192|\t\t\t\t\tfor _, detail := range strictDetails {\n193|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n194|\t\t\t\t\t}\n195|\t\t\t\t\treturn true\n196|\t\t\t\t}\n197|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n198|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n199|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n200|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n201|\t\t\t\t\tif err != nil {\n202|\t\t\t\t\t\treturn true\n203|\t\t\t\t\t}\n204|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n205|\t\t\t\t}\n206|\t\t\t\t// Non-literal first arguments are the fault conduits\n207|\t\t\t\t// (fault.detail, detail variables): the arms behind\n208|\t\t\t\t// them are the frame arms above, so there is no\n209|\t\t\t\t// separate obligation here.\n210|\t\t\t}\n211|\t\t\treturn true\n212|\t\t})\n213|\t}\n214|\tif parseBranches == 0 {\n215|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n216|\t}\n217|\tsort.Strings(scanned)\n218|\treturn arms, scanned, nil\n219|}\n220|\n221|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n222|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n223|\ttarget := node\n224|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n225|\t\ttarget = unary.X\n226|\t}\n227|\tliteral, ok := target.(*ast.CompositeLit)\n228|\tif !ok {\n229|\t\treturn nil, false\n230|\t}\n231|\tident, ok := literal.Type.(*ast.Ident)\n232|\tif !ok || ident.Name != \"frameFault\" {\n233|\t\treturn nil, false\n234|\t}\n235|\treturn literal, true\n236|}\n237|\n238|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n239|\tfor _, element := range literal.Elts {\n240|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n241|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n242|\t\t\t\treturn kv\n243|\t\t\t}\n244|\t\t}\n245|\t}\n246|\treturn nil\n247|}\n248|\n249|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n250|\tkv := literalField(literal, name)\n251|\tif kv == nil {\n252|\t\treturn \"\", false\n253|\t}\n254|\tbasic, ok := kv.Value.(*ast.BasicLit)\n255|\tif !ok || basic.Kind != token.STRING {\n256|\t\treturn \"\", false\n257|\t}\n258|\tdetail, err := strconv.Unquote(basic.Value)\n259|\tif err != nil {\n260|\t\treturn \"\", false\n261|\t}\n262|\treturn detail, true\n263|}\n264|\n265|// integrityPrefix matches \"prefix\" + <expr>, the wrapping shape whose\n266|// arms expand over the derived frame detail set.\n267|func integrityPrefix(arg ast.Expr) (string, bool) {\n268|\tbinary, ok := arg.(*ast.BinaryExpr)\n269|\tif !ok || binary.Op != token.ADD {\n270|\t\treturn \"\", false\n271|\t}\n272|\tprefix, ok := binary.X.(*ast.BasicLit)\n273|\tif !ok || prefix.Kind != token.STRING {\n274|\t\treturn \"\", false\n275|\t}\n276|\ttext, err := strconv.Unquote(prefix.Value)\n277|\tif err != nil {\n278|\t\treturn \"\", false\n279|\t}\n280|\treturn text, true\n281|}\n282|\n283|func nodeSource(source []byte, fileSet *token.FileSet, node ast.Node) string {\n284|\tstart := fileSet.Position(node.Pos()).Offset\n285|\tend := fileSet.Position(node.End()).Offset\n286|\tif start < 0 || end > len(source) || start >= end {\n287|\t\treturn \"?\"\n288|\t}\n289|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n290|}\n291|\n292|// armParseBranches derives one obligation per parseMajor rejection\n293|// branch in this file: every return 0, false inside parseMajor, keyed by\n294|// its innermost enclosing condition, and returns how many it derived. A\n295|// new branch adds a key no witness names; a deleted branch orphans its\n296|// witness; narrowing || to && rewrites the key and does both. The caller\n297|// fails closed when no file derives any branch.\n298|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n299|\tvar body *ast.BlockStmt\n300|\tfor _, decl := range syntax.Decls {\n301|\t\tfunction, ok := decl.(*ast.FuncDecl)\n302|\t\tif ok && function.Name.Name == \"parseMajor\" {\n303|\t\t\tbody = function.Body\n304|\t\t}\n305|\t}\n306|\tif body == nil {\n307|\t\treturn 0\n308|\t}\n309|\tcount := 0\n310|\tvar conditions []string\n311|\tvar walk func(node ast.Node)\n312|\twalk = func(node ast.Node) {\n313|\t\tbranch, ok := node.(*ast.IfStmt)\n314|\t\tif !ok {\n315|\t\t\tfor _, child := range childNodes(node) {\n316|\t\t\t\twalk(child)\n317|\t\t\t}\n318|\t\t\treturn\n319|\t\t}\n320|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n321|\t\tfor _, stmt := range branch.Body.List {\n322|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n323|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n324|\t\t\t\tcount++\n325|\t\t\t}\n326|\t\t}\n327|\t\tfor _, child := range childNodes(node) {\n328|\t\t\twalk(child)\n329|\t\t}\n330|\t\tconditions = conditions[:len(conditions)-1]\n331|\t}\n332|\twalk(body)\n333|\treturn count\n334|}\n335|\n336|func isFalsePair(ret *ast.ReturnStmt) bool {\n337|\tif len(ret.Results) != 2 {\n338|\t\treturn false\n339|\t}\n340|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n341|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n342|\t\treturn false\n343|\t}\n344|\tno, ok := ret.Results[1].(*ast.Ident)\n345|\treturn ok && no.Name == \"false\"\n346|}\n347|\n348|func childNodes(node ast.Node) []ast.Node {\n349|\tvar children []ast.Node\n350|\tast.Inspect(node, func(child ast.Node) bool {\n351|\t\tif child == nil || child == node {\n352|\t\t\treturn true\n353|\t\t}\n354|\t\tchildren = append(children, child)\n355|\t\treturn false\n356|\t})\n357|\treturn children\n358|}\n359|\n360|// armWitness proves one derived refusal arm at the production entry.\n361|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n362|// fails a witness that names nothing production declares, so a deleted or\n363|// narrowed production branch orphans its witness instead of passing\n364|// silently. The prove function must drive the production entry point and\n365|// require the refusal attributed to THIS arm, not merely any refusal.\n366|type armWitness struct {\n367|\tarm   string\n368|\tname  string\n369|\tprove func(*testing.T)\n370|}\n371|\n372|// requireIntegrityRefusal asserts the full identity of a status refusal:\n373|// the integrity_failure code, the rule detail, the status_state detail\n374|// every integrity arm carries (AS6: asserted on all 18 arms, not just\n375|// the unknown row), exit 9, and the non-retryable bit. It is separate\n376|// from requireLocalRefusal because that helper also serves codes with no\n377|// status_state detail.\n378|func requireIntegrityRefusal(t *testing.T, err error, detail, wantState string) {\n379|\tt.Helper()\n380|\trequireLocalRefusal(t, err, \"integrity_failure\", detail)\n381|\tstate, ok := failureObject(t, err).Detail(\"status_state\")\n382|\tif !ok || state != wantState {\n383|\t\tt.Fatalf(\"integrity refusal status_state = %v, want %q (%v)\", state, wantState, err)\n384|\t}\n385|\tif failureExit(t, err) != 9 {\n386|\t\tt.Fatalf(\"integrity refusal exit = %d, want 9\", failureExit(t, err))\n387|\t}\n388|}\n389|\n390|func armVersionFrame(version string) []byte {\n391|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n392|}\n393|\n394|func armMemberFrame(members string) []byte {\n395|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n396|}\n397|\n398|func armOversizeResponse(t *testing.T) []byte {\n399|\tt.Helper()\n400|\tbuild := func(pad int) []byte {\n401|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n402|\t}\n403|\tbase := len(build(0))\n404|\tover := build(specFrameLimitBytes - base + 1)\n405|\tif len(over) != specFrameLimitBytes+1 {\n406|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n407|\t}\n408|\treturn over\n409|}\n410|\n411|func declaredArmWitnesses() []armWitness {\n412|\treturn []armWitness{\n413|\t\t// decodeStrictObject frame arms, through DecodeResponse.\n414|\t\t{arm: `frame|not a JSON object|\"\"`, name: \"array is not an object\", prove: func(t *testing.T) {\n415|\t\t\t_, err := DecodeResponse([]byte(`[1,2]`), mustUUIDv7(t, testRequestID))\n416|\t\t\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n417|\t\t}},\n418|\t\t{arm: `frame|not a JSON object|key`, name: \"truncated value names its member\", prove: func(t *testing.T) {\n419|\t\t\t_, err := DecodeResponse([]byte(`{\"protocol\":`), mustUUIDv7(t, testRequestID))\n420|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a JSON object\")\n421|\t\t}},\n422|\t\t{arm: `frame|duplicate member|key`, name: \"repeated member\", prove: func(t *testing.T) {\n423|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n424|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n425|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"duplicate member\")\n426|\t\t}},\n427|\t\t{arm: `frame|trailing data after the object|\"\"`, name: \"trailing byte\", prove: func(t *testing.T) {\n428|\t\t\t_, err := DecodeResponse(append(successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`), 'x'), mustUUIDv7(t, testRequestID))\n429|\t\t\trequireFrameRefusal(t, err, \"\", \"trailing data after the object\")\n430|\t\t}},\n431|\t\t{arm: `frame|missing member|name`, name: \"missing protocol\", prove: func(t *testing.T) {\n432|\t\t\tframe := []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n433|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n434|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n435|\t\t}},\n436|\t\t{arm: `frame|missing member|\"body\"`, name: \"success without body\", prove: func(t *testing.T) {\n437|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true`), mustUUIDv7(t, testRequestID))\n438|\t\t\trequireFrameRefusal(t, err, \"body\", \"missing member\")\n439|\t\t}},\n440|\t\t{arm: `frame|success envelope carries error|\"error\"`, name: \"error on success\", prove: func(t *testing.T) {\n441|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n442|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n443|\t\t\trequireFrameRefusal(t, err, \"error\", \"success envelope carries error\")\n444|\t\t}},\n445|\t\t{arm: `frame|missing member|\"error\"`, name: \"failure without error\", prove: func(t *testing.T) {\n446|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false`), mustUUIDv7(t, testRequestID))\n447|\t\t\trequireFrameRefusal(t, err, \"error\", \"missing member\")\n448|\t\t}},\n449|\t\t{arm: `frame|failure envelope carries body|\"body\"`, name: \"body on failure\", prove: func(t *testing.T) {\n450|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)\n451|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n452|\t\t\trequireFrameRefusal(t, err, \"body\", \"failure envelope carries body\")\n453|\t\t}},\n454|\t\t{arm: `frame|unknown member|name`, name: \"diagnostics member\", prove: func(t *testing.T) {\n455|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), mustUUIDv7(t, testRequestID))\n456|\t\t\trequireFrameRefusal(t, err, \"diagnostics\", \"unknown member\")\n457|\t\t}},\n458|\t\t// encodeFrame refusals, through EncodeRequest.\n459|\t\t{arm: `ctor|failInvalid|unknown operation`, name: \"unknown operation never frames\", prove: func(t *testing.T) {\n460|\t\t\treq := testRequest(t)\n461|\t\t\treq.Operation = \"reboot\"\n462|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n463|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n464|\t\t}},\n465|\t\t{arm: `ctor|failInvalid|request_id is not a UUIDv7`, name: \"zero request id\", prove: func(t *testing.T) {\n466|\t\t\tbad := testRequest(t)\n467|\t\t\tvar zero scalar.UUIDv7\n468|\t\t\tbad.RequestID = zero\n469|\t\t\t_, err := EncodeRequest(bad, mustInstant(t, testNow))\n470|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request_id is not a UUIDv7\")\n471|\t\t}},\n472|\t\t{arm: `ctor|failInvalid|deadline is not a timestamp`, name: \"zero deadline\", prove: func(t *testing.T) {\n473|\t\t\treq := testRequest(t)\n474|\t\t\treq.Deadline = mustTimestamp(t, testDeadline)\n475|\t\t\tvar zero scalar.Timestamp\n476|\t\t\treq.Deadline = zero\n477|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n478|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not a timestamp\")\n479|\t\t}},\n480|\t\t{arm: `ctor|failInvalid|deadline is not in the future`, name: \"stale deadline\", prove: func(t *testing.T) {\n481|\t\t\treq := testRequest(t)\n482|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n483|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n484|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n485|\t\t}},\n486|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n487|\t\t\treq := testRequest(t)\n488|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n489|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n490|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n491|\t\t}},\n492|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n493|\t\t\treq := testRequest(t)\n494|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n495|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n496|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request frame exceeds 8 MiB\")\n497|\t\t}},\n498|\t\t// DecodeResponse refusals, through DecodeResponse.\n499|\t\t{arm: `ctor|failProtocol|frame exceeds 8 MiB`, name: \"oversize response\", prove: func(t *testing.T) {\n500|\t\t\t_, err := DecodeResponse(armOversizeResponse(t), mustUUIDv7(t, testRequestID))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c477","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":150,"recorded_at":1780531400000295,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"call_id":"call_01a06f8660d67281938b96707281e4fb","text":"Read text file `internal/provider/provider.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"crypto/subtle\"\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Stable Structured Error codes this package reports. Discovery-shape\n15|// refusals (duplicates, malformed names, non-regular targets, unapproved\n16|// owners, relative directories) report invalid_config; a filesystem read\n17|// that cannot establish the discovery or verification preconditions reports\n18|// local_precondition_failed; a trust receipt that no longer matches freshly\n19|// read facts reports integrity_failure. The duplicate mapping is mandated by\n20|// Section 7.1; the other two are derived mappings documented on the\n21|// constructors, because Section 7.1 names no code for those cases.\n22|const (\n23|\tcodeInvalidConfig     = \"invalid_config\"\n24|\tcodeLocalPrecondition = \"local_precondition_failed\"\n25|\tcodeIntegrityFailure  = \"integrity_failure\"\n26|)\n27|\n28|// Error is the only error this package produces. Code carries the stable\n29|// registry code above; Detail names the offending provider ID, path, or\n30|// trust dimension in human text automation must never branch on; Cause\n31|// preserves the underlying filesystem failure for errors.Is and errors.As.\n32|type Error struct {\n33|\tcode   string\n34|\tdetail string\n35|\tcause  error\n36|}\n37|\n38|// Code reports the stable registry code for this refusal.\n39|func (err Error) Code() string { return err.code }\n40|\n41|// Detail reports the human-text detail for this refusal.\n42|func (err Error) Detail() string { return err.detail }\n43|\n44|// Unwrap exposes the underlying filesystem cause, if one was recorded.\n45|func (err Error) Unwrap() error { return err.cause }\n46|\n47|func (err Error) Error() string {\n48|\tif err.cause == nil {\n49|\t\treturn \"provider \" + err.code + \": \" + err.detail\n50|\t}\n51|\treturn \"provider \" + err.code + \": \" + err.detail + \": \" + err.cause.Error()\n52|}\n53|\n54|// The four refusal constructors below are declared as variables so the\n55|// refusal-inventory gate can observe every exercised refusal site. Each is\n56|// the single construction site for its failure class; production code must\n57|// not build Error values or wrap filesystem errors any other way.\n58|//\n59|// failDuplicate reports the Section 7.1 duplicate-ID refusal with the\n60|// section-mandated invalid_config code.\n61|//\n62|// failInvalid reports a discovery-shape refusal: a malformed plugin name, a\n63|// non-regular target, an unapproved owner, a relative directory, or a Trust\n64|// call on a builtin adapter. These are operator-configuration or caller\n65|// errors, so they share the invalid_config code.\n66|//\n67|// failPrecondition reports a filesystem read failure during discovery: an\n68|// unreadable plugin directory, an unresolvable symlink, an unreadable\n69|// target, or unattainable ownership metadata. A failed read is never a\n70|// legitimate absence, so discovery aborts with local_precondition_failed\n71|// instead of yielding a partial candidate set.\n72|//\n73|// failIntegrity reports a trust receipt that no longer matches freshly read\n74|// facts, including a receipt whose facts cannot be re-read at all: a\n75|// changed path target or digest requires renewed trust, and an unreadable\n76|// file cannot prove it is unchanged.\n77|var failDuplicate = func(providerID, firstSource, secondSource string) Error {\n78|\treturn Error{\n79|\t\tcode:   codeInvalidConfig,\n80|\t\tdetail: fmt.Sprintf(\"duplicate provider %q from %s and %s\", providerID, firstSource, secondSource),\n81|\t}\n82|}\n83|\n84|var failInvalid = func(detail string) Error {\n85|\treturn Error{code: codeInvalidConfig, detail: detail}\n86|}\n87|\n88|var failPrecondition = func(detail string, cause error) Error {\n89|\treturn Error{code: codeLocalPrecondition, detail: detail, cause: cause}\n90|}\n91|\n92|var failIntegrity = func(detail string, cause error) Error {\n93|\treturn Error{code: codeIntegrityFailure, detail: detail, cause: cause}\n94|}\n95|\n96|// Kind distinguishes a built-in adapter from an external executable.\n97|type Kind string\n98|\n99|const (\n100|\t// KindBuiltin is an adapter compiled into the host. It has no\n101|\t// executable path, digest, or owner to trust.\n102|\tKindBuiltin Kind = \"builtin\"\n103|\t// KindExternal is an ax-provider-<id> executable discovered on the\n104|\t// filesystem and subject to trust recording and verification.\n105|\tKindExternal Kind = \"external\"\n106|)\n107|\n108|// ExecutablePrefix is the Section 7.1 external executable name prefix. The\n109|// suffix is a provider ID in the scalar provider-id grammar.\n110|const ExecutablePrefix = \"ax-provider-\"\n111|\n112|// builtinOrder is the Section 7.1 built-in set in the section's listed\n113|// order. The order is a discovery enumeration order only; Section 7.1\n114|// states the order does not establish precedence.\n115|var builtinOrder = []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n116|\n117|// Builtins returns the Section 7.1 built-in provider IDs in discovery\n118|// order. The result is a copy; the registry cannot be mutated through it.\n119|func Builtins() []string {\n120|\treturn append([]string(nil), builtinOrder...)\n121|}\n122|\n123|// Config carries the operator inputs Discover consumes. PluginDirs maps to\n124|// providers.plugin_dirs in listed order and AllowPathPlugins to\n125|// providers.allow_path_plugins; both arrive already parsed by\n126|// internal/config, which additionally enforces absolute directories and\n127|// require_explicit_trust. Platform is the host AX platform the paths are\n128|// evaluated on.\n129|type Config struct {\n130|\tPlatform         scalar.Platform\n131|\tPluginDirs       []string\n132|\tAllowPathPlugins bool\n133|}\n134|\n135|// OwnerPolicy decides whether a filesystem UID may own a trusted external\n136|// executable. OperatorUID is the operator's own identity;\n137|// AdministratorUIDs are the additional administrator-approved identities,\n138|// if the host configures any. An empty administrator set trusts the\n139|// operator alone; no superuser exception is implied.\n140|type OwnerPolicy struct {\n141|\tOperatorUID       uint32\n142|\tAdministratorUIDs []uint32\n143|}\n144|\n145|// Approves reports whether uid may own a trusted executable.\n146|func (policy OwnerPolicy) Approves(uid uint32) bool {\n147|\tif uid == policy.OperatorUID {\n148|\t\treturn true\n149|\t}\n150|\tfor _, admin := range policy.AdministratorUIDs {\n151|\t\tif uid == admin {\n152|\t\t\treturn true\n153|\t\t}\n154|\t}\n155|\treturn false\n156|}\n157|\n158|// OwnerIdentity renders a UID in the stable form TrustRecord stores.\n159|func (policy OwnerPolicy) OwnerIdentity(uid uint32) string {\n160|\treturn fmt.Sprintf(\"uid:%d\", uid)\n161|}\n162|\n163|// FileInfo is the ownership and shape fact System.Inspect reports for one\n164|// path. UID is the owning identity of the symlink target.\n165|type FileInfo struct {\n166|\tIsRegular bool\n167|\tUID       uint32\n168|}\n169|\n170|// System is the filesystem seam Discover and Verify read through.\n171|// Production code supplies OSSystem; tests supply a scripted fake. Every\n172|// method reports a failed or partial read as an error, never as an empty\n173|// result the caller could mistake for absence.\n174|type System interface {\n175|\t// ReadDir returns the entry names of dir, unsorted.\n176|\tReadDir(dir string) ([]string, error)\n177|\t// Canonicalize resolves dir against an absolute base and every\n178|\t// symlink in the path, returning the canonical absolute target.\n179|\tCanonicalize(path string) (string, error)\n180|\t// Inspect stats the symlink target at an already-canonical path.\n181|\tInspect(canonical string) (FileInfo, error)\n182|\t// ReadFile returns the full bytes of the symlink target at an\n183|\t// already-canonical path.\n184|\tReadFile(canonical string) ([]byte, error)\n185|\t// PathDirs returns the PATH search directories in listed order.\n186|\tPathDirs() []string\n187|}\n188|\n189|// Candidate is one discovered provider. External candidates carry the\n190|// trust-time facts Section 7.1 requires: the canonical absolute executable\n191|// path, the SHA-256 digest of its bytes, and the approving owner identity.\n192|// Builtin candidates carry none of those; the zero accessors report\n193|// absence. A Candidate carries no availability, status, or capability\n194|// claim: discovery never advertises what the probe plane has not proven.\n195|type Candidate struct {\n196|\tid     string\n197|\tkind   Kind\n198|\tsource string\n199|\tpath   string\n200|\tcanon  string\n201|\tdigest scalar.Digest\n202|\towner  string\n203|}\n204|\n205|// ID reports the provider ID this candidate declares.\n206|func (candidate Candidate) ID() string { return candidate.id }\n207|\n208|// Kind reports whether this candidate is built-in or external.\n209|func (candidate Candidate) Kind() Kind { return candidate.kind }\n210|\n211|// Source names where the candidate was found: plugin_dirs[i], builtin, or\n212|// path. It is a diagnostic label, not a precedence rank.\n213|func (candidate Candidate) Source() string { return candidate.source }\n214|\n215|// SourcePath reports the undisguised discovery path of an external\n216|// candidate: the plugin or PATH directory joined with the executable name.\n217|// Verify re-resolves this path to detect symlink retargeting.\n218|func (candidate Candidate) SourcePath() (string, bool) {\n219|\tif candidate.kind != KindExternal {\n220|\t\treturn \"\", false\n221|\t}\n222|\treturn candidate.path, true\n223|}\n224|\n225|// CanonicalPath reports the symlink-resolved absolute target recorded at\n226|// trust time for an external candidate.\n227|func (candidate Candidate) CanonicalPath() (string, bool) {\n228|\tif candidate.kind != KindExternal {\n229|\t\treturn \"\", false\n230|\t}\n231|\treturn candidate.canon, true\n232|}\n233|\n234|// Digest reports the SHA-256 digest of the target bytes recorded at trust\n235|// time for an external candidate.\n236|func (candidate Candidate) Digest() (scalar.Digest, bool) {\n237|\tif candidate.kind != KindExternal {\n238|\t\treturn scalar.Digest{}, false\n239|\t}\n240|\treturn candidate.digest, true\n241|}\n242|\n243|// Owner reports the approving owner identity recorded at trust time for an\n244|// external candidate.\n245|func (candidate Candidate) Owner() (string, bool) {\n246|\tif candidate.kind != KindExternal {\n247|\t\treturn \"\", false\n248|\t}\n249|\treturn candidate.owner, true\n250|}\n251|\n252|// TrustRecord is the trust-time receipt for one accepted external\n253|// candidate: the canonical absolute executable path and SHA-256 digest\n254|// Section 7.1 requires, plus the undisguised discovery path Verify\n255|// re-resolves, the approving owner identity, and the trust instant. The\n256|// host persists this receipt; Verify rechecks it.\n257|type TrustRecord struct {\n258|\tproviderID string\n259|\tsourcePath string\n260|\tcanon      string\n261|\tdigest     scalar.Digest\n262|\towner      string\n263|\ttrustedAt  scalar.Timestamp\n264|}\n265|\n266|// ProviderID reports the trusted provider ID.\n267|func (record TrustRecord) ProviderID() string { return record.providerID }\n268|\n269|// SourcePath reports the undisguised discovery path Verify re-resolves.\n270|func (record TrustRecord) SourcePath() string { return record.sourcePath }\n271|\n272|// CanonicalPath reports the recorded canonical absolute target.\n273|func (record TrustRecord) CanonicalPath() string { return record.canon }\n274|\n275|// Digest reports the recorded SHA-256 digest of the target bytes.\n276|func (record TrustRecord) Digest() scalar.Digest { return record.digest }\n277|\n278|// Owner reports the recorded approving owner identity.\n279|func (record TrustRecord) Owner() string { return record.owner }\n280|\n281|// TrustedAt reports the trust instant.\n282|func (record TrustRecord) TrustedAt() scalar.Timestamp { return record.trustedAt }\n283|\n284|// externalID splits an ax-provider-<id> file name. It reports false for\n285|// names outside the prefix so ordinary directory entries are skipped; a\n286|// prefixed name whose suffix fails the provider-id grammar is a malformed\n287|// candidate, reported as an error rather than silently skipped.\n288|func externalID(name string) (string, bool, error) {\n289|\tsuffix, found := strings.CutPrefix(name, ExecutablePrefix)\n290|\tif !found {\n291|\t\treturn \"\", false, nil\n292|\t}\n293|\tif _, err := scalar.ParseProviderID(suffix); err != nil {\n294|\t\treturn \"\", false, err\n295|\t}\n296|\treturn suffix, true, nil\n297|}\n298|\n299|// Discover deterministically enumerates provider candidates in the Section\n300|// 7.1 source order: configured plugin directories in listed order (entry\n301|// names sorted bytewise within each directory, because filesystem order is\n302|// not deterministic), then built-in adapters in registry order, then PATH\n303|// directories in listed order only when AllowPathPlugins is true. Both\n304|// configured plugin directories and PATH entries must be absolute paths:\n305|// a relative entry fails with invalid_config instead of resolving against\n306|// the process working directory.\n307|//\n308|// Discover never probes or executes a candidate, so the duplicate refusal\n309|// below happens before either by construction: the function has no probe\n310|// or execution dependency to invoke. If two candidates declare the same\n311|// provider ID, Discover fails with invalid_config naming both sources; the\n312|// operator must remove or rename one candidate. There is no\n313|// duplicate-selection override, including for byte-identical observations\n314|// of one file through two directories.\n315|//\n316|// Every accepted external candidate records its canonical absolute path,\n317|// SHA-256 digest, and approving owner at trust time: symlinks are resolved\n318|// before comparison, the target must be a regular file, and its owner must\n319|// satisfy policy. A matching directory entry that cannot become an\n320|// accepted candidate (malformed name, unresolvable link, non-regular\n321|// target, unapproved owner) fails discovery instead of being skipped,\n322|// because a skipped trust check would silently narrow the trust boundary.\n323|// Filesystem read failures abort discovery instead of yielding a partial\n324|// set. Discover holds no state and starts no process.\n325|func Discover(cfg Config, owner OwnerPolicy, system System) ([]Candidate, error) {\n326|\tseen := make(map[string]string)\n327|\tvar out []Candidate\n328|\tadd := func(candidate Candidate) error {\n329|\t\tif first, duplicate := seen[candidate.id]; duplicate {\n330|\t\t\treturn failDuplicate(candidate.id, first, candidate.source)\n331|\t\t}\n332|\t\tseen[candidate.id] = candidate.source\n333|\t\tout = append(out, candidate)\n334|\t\treturn nil\n335|\t}\n336|\tfor index, dir := range cfg.PluginDirs {\n337|\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n338|\t\t\treturn nil, failInvalid(fmt.Sprintf(\"providers.plugin_dirs[%d] %q is not an absolute path\", index, dir))\n339|\t\t}\n340|\t\tsource := fmt.Sprintf(\"plugin_dirs[%d]\", index)\n341|\t\tif err := collectDirectory(owner, system, dir, source, add); err != nil {\n342|\t\t\treturn nil, err\n343|\t\t}\n344|\t}\n345|\tfor _, id := range builtinOrder {\n346|\t\tif err := add(Candidate{id: id, kind: KindBuiltin, source: \"builtin\"}); err != nil {\n347|\t\t\treturn nil, err\n348|\t\t}\n349|\t}\n350|\tif cfg.AllowPathPlugins {\n351|\t\tfor index, dir := range system.PathDirs() {\n352|\t\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n353|\t\t\t\treturn nil, failInvalid(fmt.Sprintf(\"PATH[%d] %q is not an absolute path\", index, dir))\n354|\t\t\t}\n355|\t\t\tif err := collectDirectory(owner, system, dir, \"path\", add); err != nil {\n356|\t\t\t\treturn nil, err\n357|\t\t\t}\n358|\t\t}\n359|\t}\n360|\treturn out, nil\n361|}\n362|\n363|// collectDirectory folds every ax-provider-<id> entry of one directory into\n364|// add in bytewise name order. PATH entries reuse this path, so both sources\n365|// enforce the same trust checks; only the diagnostic source label differs.\n366|func collectDirectory(owner OwnerPolicy, system System, dir, source string, add func(Candidate) error) error {\n367|\tnames, err := system.ReadDir(dir)\n368|\tif err != nil {\n369|\t\treturn failPrecondition(fmt.Sprintf(\"cannot list %s directory %q\", source, dir), err)\n370|\t}\n371|\tsort.Strings(names)\n372|\tfor _, name := range names {\n373|\t\tid, candidate, err := externalID(name)\n374|\t\tif err != nil {\n375|\t\t\treturn failInvalid(fmt.Sprintf(\"%s entry %q is not a provider executable name: %v\", source, filepath.Join(dir, name), err))\n376|\t\t}\n377|\t\tif !candidate {\n378|\t\t\tcontinue\n379|\t\t}\n380|\t\tfound, err := trustCandidate(owner, system, id, filepath.Join(dir, name), source)\n381|\t\tif err != nil {\n382|\t\t\treturn err\n383|\t\t}\n384|\t\tif err := add(found); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\treturn nil\n389|}\n390|\n391|// trustCandidate establishes the trust-time facts for one external\n392|// executable: symlink resolution before comparison, regular-file target,\n393|// approved owner, and digest over the target bytes.\n394|func trustCandidate(owner OwnerPolicy, system System, id, path, source string) (Candidate, error) {\n395|\tcanon, err := system.Canonicalize(path)\n396|\tif err != nil {\n397|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot resolve provider %q at %q\", id, path), err)\n398|\t}\n399|\tinfo, err := system.Inspect(canon)\n400|\tif err != nil {\n401|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot inspect provider %q target %q\", id, canon), err)\n402|\t}\n403|\tif !info.IsRegular {\n404|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is not a regular file\", id, canon))\n405|\t}\n406|\tif !owner.Approves(info.UID) {\n407|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is owned by %s, which the trust policy does not approve\", id, canon, owner.OwnerIdentity(info.UID)))\n408|\t}\n409|\tcontent, err := system.ReadFile(canon)\n410|\tif err != nil {\n411|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot digest provider %q target %q\", id, canon), err)\n412|\t}\n413|\tdigest := scalar.SHA256Digest(content)\n414|\treturn Candidate{\n415|\t\tid:     id,\n416|\t\tkind:   KindExternal,\n417|\t\tsource: source,\n418|\t\tpath:   path,\n419|\t\tcanon:  canon,\n420|\t\tdigest: digest,\n421|\t\towner:  owner.OwnerIdentity(info.UID),\n422|\t}, nil\n423|}\n424|\n425|// Trust records the trust receipt for one accepted external candidate.\n426|// Trusting a builtin adapter is refused: it has no executable bytes to\n427|// record. Trust is pure: identical inputs return identical receipts.\n428|func Trust(candidate Candidate, trustedAt scalar.Timestamp) (TrustRecord, error) {\n429|\tif candidate.kind != KindExternal {\n430|\t\treturn TrustRecord{}, failInvalid(fmt.Sprintf(\"provider %q is a builtin adapter with no executable to trust\", candidate.id))\n431|\t}\n432|\treturn TrustRecord{\n433|\t\tproviderID: candidate.id,\n434|\t\tsourcePath: candidate.path,\n435|\t\tcanon:      candidate.canon,\n436|\t\tdigest:     candidate.digest,\n437|\t\towner:      candidate.owner,\n438|\t\ttrustedAt:  trustedAt,\n439|\t}, nil\n440|}\n441|\n442|// Verify rechecks a trust receipt against freshly read filesystem facts. A\n443|// changed path target or digest requires renewed trust: any mismatch in\n444|// the re-resolved canonical path, the target shape, the approving owner,\n445|// or the digest fails with integrity_failure, as does any read failure,\n446|// because an unreadable file cannot prove it is unchanged. Verify holds no\n447|// state and starts no process; repeated verification over an unchanged\n448|// tree succeeds identically.\n449|func Verify(record TrustRecord, owner OwnerPolicy, system System) error {\n450|\tcanon, err := system.Canonicalize(record.sourcePath)\n451|\tif err != nil {\n452|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q trust receipt cannot be re-resolved and requires renewed trust\", record.providerID), err)\n453|\t}\n454|\tif canon != record.canon {\n455|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target changed from %q to %q and requires renewed trust\", record.providerID, record.canon, canon), nil)\n456|\t}\n457|\tinfo, err := system.Inspect(canon)\n458|\tif err != nil {\n459|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-inspected and requires renewed trust\", record.providerID, canon), err)\n460|\t}\n461|\tif !info.IsRegular {\n462|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q is no longer a regular file and requires renewed trust\", record.providerID, canon), nil)\n463|\t}\n464|\tif identity := owner.OwnerIdentity(info.UID); !owner.Approves(info.UID) || identity != record.owner {\n465|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable owner is now %s and requires renewed trust\", record.providerID, identity), nil)\n466|\t}\n467|\tcontent, err := system.ReadFile(canon)\n468|\tif err != nil {\n469|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-read and requires renewed trust\", record.providerID, canon), err)\n470|\t}\n471|\tsum := sha256.Sum256(content)\n472|\tif subtle.ConstantTimeCompare(sum[:], digestBytes(record.digest)) != 1 {\n473|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable digest changed and requires renewed trust\", record.providerID), nil)\n474|\t}\n475|\treturn nil\n476|}\n477|\n478|// digestBytes decodes the recorded digest for constant-time comparison. A\n479|// TrustRecord always carries a digest produced by SHA256Digest, so the\n480|// decode cannot fail; a receipt that does not decode compares unequal\n481|// rather than panicking.\n482|func digestBytes(digest scalar.Digest) []byte {\n483|\traw := digest.Hex()\n484|\tif len(raw) != sha256.Size*2 {\n485|\t\treturn nil\n486|\t}\n487|\tdecoded := make([]byte, sha256.Size)\n488|\tfor i := range decoded {\n489|\t\thi := unhex(raw[2*i])\n490|\t\tlo := unhex(raw[2*i+1])\n491|\t\tif hi > 15 || lo > 15 {\n492|\t\t\treturn nil\n493|\t\t}\n494|\t\tdecoded[i] = hi<<4 | lo\n495|\t}\n496|\treturn decoded\n497|}\n498|\n499|func unhex(c byte) byte {\n500|\tswitch {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
