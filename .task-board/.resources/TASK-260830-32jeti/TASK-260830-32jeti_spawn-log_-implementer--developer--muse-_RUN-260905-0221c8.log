{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68b","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":416,"recorded_at":1780531400000827,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"task_stream":{"kind":"task","id":"1ce16e2f-2b87-484c-863d-38efaa3185fd"},"task_id":"1ce16e2f-2b87-484c-863d-38efaa3185fd","event":{"kind":"output","task_id":"1ce16e2f-2b87-484c-863d-38efaa3185fd","chunk":"Read text file `internal/provhost/runner_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|)\n18|\n19|// futureDeadline returns a deadline duration ahead of the real clock,\n20|// so Host deadline accounting runs against live time.\n21|func futureDeadline(t *testing.T, ahead time.Duration) scalar.Timestamp {\n22|\tt.Helper()\n23|\tparsed, err := scalar.ParseTimestamp(time.Now().Add(ahead).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n26|\t}\n27|\treturn parsed\n28|}\n29|\n30|// liveRequest is testRequest with a live future deadline for Host calls,\n31|// which enforce the deadline against a real context.\n32|func liveRequest(t *testing.T) Request {\n33|\tt.Helper()\n34|\treq := testRequest(t)\n35|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n36|\treturn req\n37|}\n38|\n39|// liveHost builds a Host on the real clock.\n40|func liveHost(runner *scriptRunner) Host {\n41|\treturn Host{Runner: runner, Now: time.Now}\n42|}\n43|\n44|// scriptCall records one Runner invocation.\n45|type scriptCall struct {\n46|\texecutable string\n47|\tstdin      []byte\n48|}\n49|\n50|// scriptRunner is a scripted Runner: it replays canned results, records\n51|// every invocation, and optionally blocks until the context ends to\n52|// simulate a hung plugin. It proves Host behavior without real processes;\n53|// the ExecRunner integration test below drives the production call site.\n54|// scriptStep is one canned invocation outcome: either a result or a\n55|// transport error, consumed in listed order.\n56|type scriptStep struct {\n57|\tresult Result\n58|\terr    error\n59|}\n60|\n61|func okStep(result Result) scriptStep { return scriptStep{result: result} }\n62|\n63|func failStep(err error) scriptStep { return scriptStep{err: err} }\n64|\n65|type scriptRunner struct {\n66|\tmu    sync.Mutex\n67|\tcalls []scriptCall\n68|\tsteps []scriptStep\n69|\tblock bool\n70|\t// delay sleeps past the request deadline before replaying, so the\n71|\t// runner returns a result after the deadline instead of an error.\n72|\tdelay time.Duration\n73|}\n74|\n75|func (runner *scriptRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n76|\trunner.mu.Lock()\n77|\trunner.calls = append(runner.calls, scriptCall{executable: executable, stdin: append([]byte(nil), stdin...)})\n78|\tindex := len(runner.calls) - 1\n79|\trunner.mu.Unlock()\n80|\tif runner.block {\n(more lines below)"}}}
