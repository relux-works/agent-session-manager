{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d08f","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":1698,"recorded_at":1780531400003391,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"task_stream":{"kind":"task","id":"b73f7477-dd27-40f0-a37f-09b668c3ea0d"},"task_id":"b73f7477-dd27-40f0-a37f-09b668c3ea0d","event":{"kind":"output","task_id":"b73f7477-dd27-40f0-a37f-09b668c3ea0d","chunk":"Read text file `internal/provhost/status_test.go`.\n(248 line(s) above)\n249|func TestStatusReadsEvolve(t *testing.T) {\n250|\tids := testStatusIDs()\n251|\tfirst, err := DecodeStatusOutcome(preparedBody(), ids)\n252|\tif err != nil {\n253|\t\tt.Fatalf(\"first read: %v\", err)\n254|\t}\n255|\tsecond, err := DecodeStatusOutcome(statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), ids)\n256|\tif err != nil {\n257|\t\tt.Fatalf(\"second read: %v\", err)\n258|\t}\n259|\tif first != StatusPrepared || second != StatusCommitted {\n260|\t\tt.Fatalf(\"evolving reads = %q then %q, want prepared then committed\", first, second)\n261|\t}\n262|}\n263|\n264|// TestStatusRecoveryAcrossProcesses proves the cross-process recovery\n265|// shape over the real entry points: two status Calls start two separate\n266|// processes with frames identical except request_id, and each durable\n267|// observation reconciles independently.\n268|func TestStatusRecoveryAcrossProcesses(t *testing.T) {\n269|\tcommitted := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery)\n270|\trunner := &scriptRunner{steps: []scriptStep{\n271|\t\tokStep(Result{Stdout: successFrame(t, testRequestID, string(preparedBody())), ExitCode: 0}),\n272|\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(committed)), ExitCode: 0}),\n273|\t}}\n274|\thost := liveHost(runner)\n275|\tfirstReq := liveRequest(t)\n276|\tfirstReq.Operation = OpMaterializeStatus\n277|\tfirstReq.RequestID = mustUUIDv7(t, testRequestID)\n278|\tfirst, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", firstReq)\n279|\tif err != nil {\n280|\t\tt.Fatalf(\"first status Call: %v\", err)\n281|\t}\n282|\tsecondReq := liveRequest(t)\n283|\tsecondReq.Operation = OpMaterializeStatus\n284|\tsecondReq.RequestID = mustUUIDv7(t, testOtherID)\n285|\tsecond, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", secondReq)\n286|\tif err != nil {\n287|\t\tt.Fatalf(\"second status Call: %v\", err)\n288|\t}\n289|\tif runner.spawned() != 2 {\n290|\t\tt.Fatalf(\"two status reads spawned %d processes, want one per read\", runner.spawned())\n291|\t}\n292|\tif firstState, err := DecodeStatusOutcome(first.Body, testStatusIDs()); err != nil || firstState != StatusPrepared {\n293|\t\tt.Fatalf(\"first recovery = %q, %v; want prepared\", firstState, err)\n294|\t}\n295|\tif secondState, err := DecodeStatusOutcome(second.Body, testStatusIDs()); err != nil || secondState != StatusCommitted {\n296|\t\tt.Fatalf(\"second recovery = %q, %v; want committed\", secondState, err)\n297|\t}\n298|}\n299|\n300|// TestLostMutationRecoversThroughStatus proves the lost-prepare shape: a\n301|// mutation Call whose response is lost is followed by a status read, and\n302|// the runner observes exactly one mutation frame — the host never\n303|// re-issues the mutation on its own, so no second destination mutation\n304|// can occur.\n305|func TestLostMutationRecoversThroughStatus(t *testing.T) {\n306|\trunner := &scriptRunner{\n307|\t\tsteps: []scriptStep{\n308|\t\t\tfailStep(context.DeadlineExceeded),\n309|\t\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(preparedBody())), ExitCode: 0}),\n310|\t\t},\n311|\t}\n312|\t// The runner error above fires with a live deadline, so it is a\n313|\t// transport failure, not a timeout.\n314|\thost := Host{Runner: runner, Now: time.Now}\n315|\tmutation := liveRequest(t)\n316|\tmutation.Operation = OpMaterialize\n317|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", mutation)\n318|\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n319|\tstatus := liveRequest(t)\n320|\tstatus.Operation = OpMaterializeStatus\n321|\tstatus.RequestID = mustUUIDv7(t, testOtherID)\n322|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", status)\n323|\tif err != nil {\n324|\t\tt.Fatalf(\"status Call: %v\", err)\n325|\t}\n326|\tstate, err := DecodeStatusOutcome(got.Body, testStatusIDs())\n327|\tif err != nil || state != StatusPrepared {\n328|\t\tt.Fatalf(\"recovery = %q, %v; want prepared\", state, err)\n329|\t}\n330|\tif runner.spawned() != 2 {\n331|\t\tt.Fatalf(\"recovery spawned %d processes, want mutation plus one status read\", runner.spawned())\n332|\t}\n333|\tmutations := 0\n334|\tfor _, call := range runner.calls {\n335|\t\tvar decoded struct {\n336|\t\t\tOperation string `json:\"operation\"`\n337|\t\t}\n338|\t\tif err := json.Unmarshal(call.stdin, &decoded); err != nil {\n339|\t\t\tt.Fatalf(\"recorded stdin is not JSON: %v\", err)\n340|\t\t}\n341|\t\tif decoded.Operation == string(OpMaterialize) {\n342|\t\t\tmutations++\n343|\t\t}\n344|\t}\n345|\tif mutations != 1 {\n346|\t\tt.Fatalf(\"runner observed %d mutation frames, want exactly one and no blind retry\", mutations)\n347|\t}\n348|}\n349|\n350|// TestUnknownTransactionQuarantinesThroughCall proves the unknown\n351|// transaction path end to end: a status body of unknown surfaces\n352|// integrity_failure from the composed read, never a status.\n353|func TestUnknownTransactionQuarantinesThroughCall(t *testing.T) {\n354|\tunknown := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n355|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: successFrame(t, testRequestID, string(unknown)), ExitCode: 0})}}\n356|\thost := liveHost(runner)\n357|\treq := liveRequest(t)\n358|\treq.Operation = OpMaterializeStatus\n359|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n360|\tif err != nil {\n361|\t\tt.Fatalf(\"status Call: %v\", err)\n362|\t}\n363|\tstate, err := DecodeStatusOutcome(got.Body, testStatusIDs())\n364|\tif state != \"\" {\n365|\t\tt.Fatalf(\"unknown recovery = %q, want no status\", state)\n366|\t}\n367|\trequireLocalRefusal(t, err, \"integrity_failure\", \"transaction state is unknown\")\n368|}"}}}
