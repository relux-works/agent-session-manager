{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68f","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":418,"recorded_at":1780531400000831,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"call_id":"call_01a06f8714b575a18267b0f25fa8ffec","text":"Read text file `internal/provhost/protocol_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// asError unwraps err to an *axerror.Error without hiding the chain.\n15|func asError(t *testing.T, err error, failure **axerror.Error) bool {\n16|\tt.Helper()\n17|\treturn errors.As(err, failure)\n18|}\n19|\n20|const (\n21|\ttestRequestID = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n22|\ttestOtherID   = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n23|\ttestDeadline  = \"2026-08-19T04:05:00.000Z\"\n24|\ttestNow       = \"2026-08-19T04:00:00.000Z\"\n25|)\n26|\n27|func mustUUIDv7(t *testing.T, value string) scalar.UUIDv7 {\n28|\tt.Helper()\n29|\tparsed, err := scalar.ParseUUIDv7(value)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"ParseUUIDv7(%q): %v\", value, err)\n32|\t}\n33|\treturn parsed\n34|}\n35|\n36|func mustTimestamp(t *testing.T, value string) scalar.Timestamp {\n37|\tt.Helper()\n38|\tparsed, err := scalar.ParseTimestamp(value)\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n41|\t}\n42|\treturn parsed\n43|}\n44|\n45|func mustInstant(t *testing.T, value string) time.Time {\n46|\tt.Helper()\n47|\tinstant, err := mustTimestamp(t, value).Time()\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"Timestamp(%q).Time(): %v\", value, err)\n50|\t}\n51|\treturn instant\n52|}\n53|\n54|// testRequest builds the Section 7.2 request-envelope fixture: a doctor\n55|// operation with a future deadline. The production entry point for\n56|// framing is EncodeRequest.\n57|func testRequest(t *testing.T) Request {\n58|\tt.Helper()\n59|\treturn Request{\n60|\t\tOperation: OpDoctor,\n61|\t\tRequestID: mustUUIDv7(t, testRequestID),\n62|\t\tDeadline:  mustTimestamp(t, testDeadline),\n63|\t\tBody:      json.RawMessage(`{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}`),\n64|\t}\n65|}\n66|\n67|// failureCode extracts the Structured Error code from err, failing when\n68|// err is not an *axerror.Error. Every failure below is a 1.0.0 object,\n69|// local or child-bound.\n70|func failureCode(t *testing.T, err error) axerror.Code {\n71|\tt.Helper()\n72|\tif err == nil {\n73|\t\tt.Fatal(\"want a failure, got nil\")\n74|\t}\n75|\tvar failure *axerror.Error\n76|\tif !asError(t, err, &failure) {\n77|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n78|\t}\n79|\treturn failure.Code()\n80|}\n81|\n82|func failureExit(t *testing.T, err error) int {\n83|\tt.Helper()\n84|\tvar failure *axerror.Error\n85|\tif !asError(t, err, &failure) {\n86|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n87|\t}\n88|\treturn failure.ExitCode()\n89|}\n90|\n91|// failureObject unwraps err to the Structured Error itself, so arm\n92|// identity beyond the stable code can be asserted.\n93|func failureObject(t *testing.T, err error) *axerror.Error {\n94|\tt.Helper()\n95|\tif err == nil {\n96|\t\tt.Fatal(\"want a failure, got nil\")\n97|\t}\n98|\tvar failure *axerror.Error\n99|\tif !asError(t, err, &failure) {\n100|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n101|\t}\n102|\treturn failure\n103|}\n104|\n105|// failureMember returns the \"member\" diagnostic of a frame refusal. Every\n106|// provider_protocol_error arm names the member it refused on, so asserting\n107|// it pins the arm: a missing-member gate deleted from checkResponseMembers\n108|// slides to a lower arm carrying the same code with a different member or\n109|// detail, and the slide reddens here instead of passing silently.\n110|func failureMember(t *testing.T, err error) string {\n111|\tt.Helper()\n112|\tfailure := failureObject(t, err)\n113|\tmember, ok := failure.Detail(\"member\")\n114|\tif !ok {\n115|\t\tt.Fatalf(\"refusal %v carries no member detail\", err)\n116|\t}\n117|\ttext, ok := member.(string)\n118|\tif !ok {\n119|\t\tt.Fatalf(\"refusal %v member detail is %T, want string\", err, member)\n120|\t}\n121|\treturn text\n122|}\n123|\n124|// requireFrameRefusal asserts the full arm identity of a plugin-frame\n125|// refusal: the stable code, the refused member, the detail naming the\n126|// rule, and the non-retryable bit doc.go promises for every local\n127|// failure this package emits.\n128|func requireFrameRefusal(t *testing.T, err error, member, detail string) {\n129|\tt.Helper()\n130|\tif failureCode(t, err) != \"provider_protocol_error\" {\n131|\t\tt.Fatalf(\"DecodeResponse code = %v, want provider_protocol_error\", err)\n132|\t}\n133|\tif got := failureMember(t, err); got != member {\n134|\t\tt.Fatalf(\"DecodeResponse member = %q, want %q (detail: %v)\", got, member, err)\n135|\t}\n136|\tif !strings.Contains(err.Error(), detail) {\n137|\t\tt.Fatalf(\"DecodeResponse error = %v, want detail containing %q\", err, detail)\n138|\t}\n139|\tif failureObject(t, err).Retryable() {\n140|\t\tt.Fatalf(\"DecodeResponse error = %v, want non-retryable\", err)\n141|\t}\n142|}\n143|\n144|// requireLocalRefusal asserts the arm identity of a refusal that carries\n145|// no member detail (invalid_config framing refusals and integrity_failure\n146|// status refusals): the stable code, the detail naming the rule in the\n147|// human text, and the non-retryable bit.\n148|func requireLocalRefusal(t *testing.T, err error, code axerror.Code, detail string) {\n149|\tt.Helper()\n150|\tif failureCode(t, err) != code {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c691","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":419,"recorded_at":1780531400000833,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"call_id":"call_01a06f87165f7ac2863d71da5905db52","text":"Read text file `internal/provhost/inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"regexp\"\n12|\t\"runtime\"\n13|\t\"sort\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n21|)\n22|\n23|// exercisedRefusalSites records the production file:line that constructed\n24|// a refusal, for every instrumented refusal constructor call made during\n25|// the test run. observedCodes records every stable code those refusals\n26|// carried.\n27|var exercisedRefusalSites sync.Map\n28|var observedCodes sync.Map\n29|\n30|func recordRefusalSite(code string) {\n31|\tobservedCodes.Store(code, struct{}{})\n32|\tif _, file, line, ok := runtime.Caller(2); ok {\n33|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n34|\t}\n35|}\n36|\n37|func TestMain(main *testing.M) {\n38|\torigInvalid, origProtocol, origMismatch := failInvalid, failProtocol, failMismatch\n39|\torigProcess, origTimeout, origIntegrity := failProcess, failTimeout, failIntegrity\n40|\tfailInvalid = func(detail string) (*axerror.Error, error) {\n41|\t\tfailure, err := origInvalid(detail)\n42|\t\tif err == nil {\n43|\t\t\trecordRefusalSite(string(failure.Code()))\n44|\t\t}\n45|\t\treturn failure, err\n46|\t}\n47|\tfailProtocol = func(detail, member string) (*axerror.Error, error) {\n48|\t\tfailure, err := origProtocol(detail, member)\n49|\t\tif err == nil {\n50|\t\t\trecordRefusalSite(string(failure.Code()))\n51|\t\t}\n52|\t\treturn failure, err\n53|\t}\n54|\tfailMismatch = func(detail, observed string) (*axerror.Error, error) {\n55|\t\tfailure, err := origMismatch(detail, observed)\n56|\t\tif err == nil {\n57|\t\t\trecordRefusalSite(string(failure.Code()))\n58|\t\t}\n59|\t\treturn failure, err\n60|\t}\n61|\tfailProcess = func(detail string, cause error) (*axerror.Error, error) {\n62|\t\tfailure, err := origProcess(detail, cause)\n63|\t\tif err == nil {\n64|\t\t\trecordRefusalSite(string(failure.Code()))\n65|\t\t}\n66|\t\treturn failure, err\n67|\t}\n68|\tfailTimeout = func(millisDetail string, millis int64) (*axerror.Error, error) {\n69|\t\tfailure, err := origTimeout(millisDetail, millis)\n70|\t\tif err == nil {\n71|\t\t\trecordRefusalSite(string(failure.Code()))\n72|\t\t}\n73|\t\treturn failure, err\n74|\t}\n75|\tfailIntegrity = func(detail, statusState, materializationID, transactionID string) (*axerror.Error, error) {\n76|\t\tfailure, err := origIntegrity(detail, statusState, materializationID, transactionID)\n77|\t\tif err == nil {\n78|\t\t\trecordRefusalSite(string(failure.Code()))\n79|\t\t}\n80|\t\treturn failure, err\n81|\t}\n82|\tcode := main.Run()\n83|\tif code == 0 && fullPackageTestRun() {\n84|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n85|\t\t\tfor _, failure := range failures {\n86|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n87|\t\t\t}\n88|\t\t\tcode = 1\n89|\t\t}\n90|\t}\n91|\tos.Exit(code)\n92|}\n93|\n94|func fullPackageTestRun() bool {\n95|\tselected := flag.Lookup(\"test.run\")\n96|\treturn selected == nil || selected.Value.String() == \"\"\n97|}\n98|\n99|// auditRefusalInventory derives the refusal inventory from package\n100|// source, never from memory: every production call to a refusal\n101|// constructor must have an exercised negative path, no Structured Error\n102|// may be built outside the six constructors, no raw error may be minted,\n103|// and the observed code set must equal the closed code set exactly.\n104|func auditRefusalInventory() []string {\n105|\tdirectory, err := os.Getwd()\n106|\tif err != nil {\n107|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n108|\t}\n109|\tinventory, err := deriveRefusalInventory(directory)\n110|\tif err != nil {\n111|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n112|\t}\n113|\tvar failures []string\n114|\t// Floor: a derived domain that can silently derive nothing is not a\n115|\t// measurement. An empty derivation must fail closed, never pass\n116|\t// vacuously — the same \"the scan is blind\" floor the discovery\n117|\t// package carries on its own scans.\n118|\tif len(inventory.ScannedFiles) == 0 {\n119|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n120|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
