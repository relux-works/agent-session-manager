{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42b","stream":{"kind":"session","id":"01a06f86-1896-77b0-a64d-49a48c76fe78"},"sequence":112,"recorded_at":1780531400000219,"record_type":"event","durability":"durable","causation_id":"3bc73467-9e0e-4b04-8606-b581be737d17","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3bc73467-9e0e-4b04-8606-b581be737d17","run_stream":{"kind":"run","id":"3bc73467-9e0e-4b04-8606-b581be737d17"},"task_stream":{"kind":"task","id":"9b6aa097-29ff-4854-86ae-cd2911b6e39a"},"task_id":"9b6aa097-29ff-4854-86ae-cd2911b6e39a","event":{"kind":"output","task_id":"9b6aa097-29ff-4854-86ae-cd2911b6e39a","chunk":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped. Failure details carry the failure class and member names\n38|\t// only, never stderr content.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil, time.Time{}, failure\n199|\t}\n200|\tdeadline, err := req.Deadline.Time()\n201|\tif err != nil {\n202|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n203|\t\tif fault != nil {\n204|\t\t\treturn nil, time.Time{}, fault\n205|\t\t}\n206|\t\treturn nil, time.Time{}, failure\n207|\t}\n208|\tif !deadline.After(now) {\n209|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n210|\t\tif fault != nil {\n211|\t\t\treturn nil, time.Time{}, fault\n212|\t\t}\n213|\t\treturn nil, time.Time{}, failure\n214|\t}\n215|\tif !isJSONObject(req.Body) {\n216|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n217|\t\tif fault != nil {\n218|\t\t\treturn nil, time.Time{}, fault\n219|\t\t}\n220|\t\treturn nil, time.Time{}, failure\n221|\t}\n222|\t// The operation, request ID, deadline, and body above were each\n223|\t// validated before this marshal, so it cannot fail on a reachable\n224|\t// path: the error propagates as a plain Go error rather than\n225|\t// through a refusal site no negative test could exercise.\n226|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n227|\tif err != nil {\n228|\t\treturn nil, time.Time{}, err\n229|\t}\n230|\tif len(frame) > MaxFrameBytes {\n231|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n232|\t\tif fault != nil {\n233|\t\t\treturn nil, time.Time{}, fault\n234|\t\t}\n235|\t\treturn nil, time.Time{}, failure\n236|\t}\n237|\treturn frame, deadline, nil\n238|}\n239|\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read.\n262|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n263|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n264|\ttoken, err := decoder.Token()\n265|\tif err != nil {\n266|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n267|\t}\n268|\tdelim, ok := token.(json.Delim)\n269|\tif !ok || delim != '{' {\n270|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n271|\t}\n272|\tmembers := map[string]json.RawMessage{}\n273|\tfor decoder.More() {\n274|\t\tkeyToken, err := decoder.Token()\n275|\t\tif err != nil {\n276|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n277|\t\t}\n278|\t\tkey, ok := keyToken.(string)\n279|\t\tif !ok {\n280|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n281|\t\t}\n282|\t\tif _, duplicate := members[key]; duplicate {\n283|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n284|\t\t}\n285|\t\tvar raw json.RawMessage\n286|\t\tif err := decoder.Decode(&raw); err != nil {\n287|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n288|\t\t}\n289|\t\tmembers[key] = raw\n290|\t}\n291|\tif token, err := decoder.Token(); err != nil {\n292|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n293|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n294|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n295|\t}\n296|\tif _, err := decoder.Token(); err != io.EOF {\n297|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n298|\t}\n299|\treturn members, nil\n300|}\n301|\n302|// responseMembers is the exact Section 7.2 response member set: the four\n303|// framing members plus body on success or error on failure, never both,\n304|// never neither, and nothing else.\n305|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n306|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n307|\tfor _, name := range required {\n308|\t\tif _, present := members[name]; !present {\n309|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n310|\t\t}\n311|\t}\n312|\tif ok {\n313|\t\tif _, present := members[\"body\"]; !present {\n314|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n315|\t\t}\n316|\t\tif _, forbidden := members[\"error\"]; forbidden {\n317|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n318|\t\t}\n319|\t} else {\n320|\t\tif _, present := members[\"error\"]; !present {\n321|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n322|\t\t}\n323|\t\tif _, forbidden := members[\"body\"]; forbidden {\n324|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n325|\t\t}\n326|\t}\n327|\tfor name := range members {\n328|\t\tswitch name {\n329|\t\tcase \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"body\", \"error\":\n330|\t\tdefault:\n331|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n332|\t\t}\n333|\t}\n334|\treturn nil\n335|}\n336|\n337|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n338|// Anything else is not a recognizable major, so the frame is unusable\n339|// rather than a mismatch.\n340|func parseMajor(version string) (int, bool) {\n341|\tparts := strings.Split(version, \".\")\n342|\tif len(parts) != 3 {\n343|\t\treturn 0, false\n344|\t}\n345|\tmajor := 0\n346|\tfor i := 0; i < len(parts[0]); i++ {\n347|\t\tdigit := parts[0][i]\n348|\t\tif digit < '0' || digit > '9' {\n349|\t\t\treturn 0, false\n350|\t\t}\n351|\t\tmajor = major*10 + int(digit-'0')\n352|\t}\n353|\tif len(parts[0]) == 0 {\n354|\t\treturn 0, false\n355|\t}\n356|\tfor _, rest := range parts[1:] {\n357|\t\tif len(rest) == 0 {\n358|\t\t\treturn 0, false\n359|\t\t}\n360|\t\tfor i := 0; i < len(rest); i++ {\n361|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n362|\t\t\t\treturn 0, false\n363|\t\t\t}\n364|\t\t}\n365|\t}\n366|\treturn major, true\n367|}\n368|\n369|// providerContract is the static Section 7.2 binding every failure\n370|// envelope is decoded under: provider protocol major 2 binds Structured\n371|// Error 1.0.0. The version is never taken from the document.\n372|var providerContract = axerror.ContainingContract{ID: \"urn:ax:protocol:provider\", Major: 2}\n373|\n374|// DecodeResponse validates one stdout line as the single response frame\n375|// for the request carrying wantRequestID. It returns the success body, or\n376|// the bound child failure, or a local failure that trusts nothing from\n377|// the frame. A recognizable foreign major yields incompatible_protocol;\n378|// every other unusable frame yields provider_protocol_error.\n379|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n380|\tif len(frame) > MaxFrameBytes {\n381|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n382|\t\tif err != nil {\n383|\t\t\treturn Response{}, err\n384|\t\t}\n385|\t\treturn Response{}, failure\n386|\t}\n387|\tif !utf8.Valid(frame) {\n388|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n389|\t\tif err != nil {\n390|\t\t\treturn Response{}, err\n391|\t\t}\n392|\t\treturn Response{}, failure\n393|\t}\n394|\tmembers, fault := decodeStrictObject(frame)\n395|\tif fault != nil {\n396|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n397|\t\tif err != nil {\n398|\t\t\treturn Response{}, err\n399|\t\t}\n400|\t\treturn Response{}, failure\n401|\t}\n402|\tvar ok bool\n403|\tif raw, present := members[\"ok\"]; !present {\n404|\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n405|\t\tif err != nil {\n406|\t\t\treturn Response{}, err\n407|\t\t}\n408|\t\treturn Response{}, failure\n409|\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n410|\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n411|\t\tif fault != nil {\n412|\t\t\treturn Response{}, fault\n413|\t\t}\n414|\t\treturn Response{}, failure\n415|\t}\n416|\tif fault := checkResponseMembers(members, ok); fault != nil {\n417|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n418|\t\tif err != nil {\n419|\t\t\treturn Response{}, err\n420|\t\t}\n421|\t\treturn Response{}, failure\n422|\t}\n423|\tvar protocol string\n424|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n425|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n426|\t\tif fault != nil {\n427|\t\t\treturn Response{}, fault\n428|\t\t}\n429|\t\treturn Response{}, failure\n430|\t}\n431|\tvar version string\n432|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n433|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n434|\t\tif fault != nil {\n435|\t\t\treturn Response{}, fault\n436|\t\t}\n437|\t\treturn Response{}, failure\n438|\t}\n439|\tif version != ProtocolVersion {\n440|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n441|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n442|\t\t\tif err != nil {\n443|\t\t\t\treturn Response{}, err\n444|\t\t\t}\n445|\t\t\treturn Response{}, failure\n446|\t\t}\n447|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n448|\t\tif fault != nil {\n449|\t\t\treturn Response{}, fault\n450|\t\t}\n451|\t\treturn Response{}, failure\n452|\t}\n453|\tvar requestID string\n454|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n455|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n456|\t\tif fault != nil {\n457|\t\t\treturn Response{}, fault\n458|\t\t}\n459|\t\treturn Response{}, failure\n460|\t}\n461|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n462|\t\tfailure, fault := failProtocol(\"request_id is not a UUIDv7\", \"request_id\")\n463|\t\tif fault != nil {\n464|\t\t\treturn Response{}, fault\n465|\t\t}\n466|\t\treturn Response{}, failure\n467|\t}\n468|\tif requestID != wantRequestID.String() {\n469|\t\tfailure, fault := failProtocol(\"request_id does not match the request\", \"request_id\")\n470|\t\tif fault != nil {\n471|\t\t\treturn Response{}, fault\n472|\t\t}\n473|\t\treturn Response{}, failure\n474|\t}\n475|\tif ok {\n476|\t\tif !isJSONObject(members[\"body\"]) {\n477|\t\t\tfailure, fault := failProtocol(\"body is not a JSON object\", \"body\")\n478|\t\t\tif fault != nil {\n479|\t\t\t\treturn Response{}, fault\n480|\t\t\t}\n481|\t\t\treturn Response{}, failure\n482|\t\t}\n483|\t\treturn Response{Body: append(json.RawMessage(nil), members[\"body\"]...)}, nil\n484|\t}\n485|\tif !isJSONObject(members[\"error\"]) {\n486|\t\tfailure, fault := failProtocol(\"error is not a JSON object\", \"error\")\n487|\t\tif fault != nil {\n488|\t\t\treturn Response{}, fault\n489|\t\t}\n490|\t\treturn Response{}, failure\n491|\t}\n492|\tchild, err := axerror.DecodeBound(providerContract, members[\"error\"])\n493|\tif err != nil {\n494|\t\tfailure, fault := failProtocol(\"error is not a bound Structured Error 1.0.0\", \"error\")\n495|\t\tif fault != nil {\n496|\t\t\treturn Response{}, fault\n497|\t\t}\n498|\t\treturn Response{}, failure\n499|\t}\n500|\treturn Response{}, child\n(more lines below)"}}}
