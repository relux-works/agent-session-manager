{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c707","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":478,"recorded_at":1780531400000951,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"8bb85e8d-41d7-450a-8c8b-55f02f9bffa4"},"task_id":"8bb85e8d-41d7-450a-8c8b-55f02f9bffa4","event":{"kind":"output","task_id":"8bb85e8d-41d7-450a-8c8b-55f02f9bffa4","chunk":"Read text file `internal/provhost/inventory_test.go`.\n(269 line(s) above)\n270|\t\t\t\t}\n271|\t\t\t}\n272|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n273|\t\t\tif !ok {\n274|\t\t\t\treturn true\n275|\t\t\t}\n276|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n277|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n278|\t\t\t\tswitch qualified {\n279|\t\t\t\tcase \"axerror.New\", \"axerror.LocalFromUntrusted\":\n280|\t\t\t\t\tif !insideConstructor(call.Pos()) {\n281|\t\t\t\t\t\tinventory.StrayBuilders = append(inventory.StrayBuilders, site+\" \"+qualified)\n282|\t\t\t\t\t}\n283|\t\t\t\t\treturn true\n284|\t\t\t\tcase \"errors.New\", \"fmt.Errorf\":\n285|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n286|\t\t\t\t\treturn true\n287|\t\t\t\t}\n288|\t\t\t}\n289|\t\t\tif selector.Sel.Name == \"panic\" {\n290|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n291|\t\t\t}\n292|\t\t\treturn true\n293|\t\t})\n294|\t}\n295|\treturn inventory, nil\n296|}\n297|\n298|// sectionLines joins the pinned document lines for a section, failing\n299|// when the section boundaries move. Every citation below resolves\n300|// against the real text, never against a restatement in this repository.\n301|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n302|\tt.Helper()\n303|\tfor _, line := range []int{first, last} {\n304|\t\tgot, ok := document.SectionID(line)\n305|\t\tif !ok || got != section {\n306|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n307|\t\t}\n308|\t}\n309|\tvar body strings.Builder\n310|\tfor line := first; line <= last; line++ {\n311|\t\ttext, ok := document.Line(line)\n312|\t\tif !ok {\n313|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n314|\t\t}\n315|\t\tbody.WriteString(text)\n316|\t\tbody.WriteString(\"\\n\")\n317|\t}\n318|\treturn body.String()\n319|}\n320|\n321|// requireQuote asserts the excerpt occurs verbatim in the pinned\n322|// document and begins on a line inside the cited section.\n323|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n324|\tt.Helper()\n325|\tif !document.Contains(excerpt) {\n326|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n327|\t}\n328|\tlines := document.QuoteLines(excerpt)\n329|\tif len(lines) == 0 {\n330|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n331|\t}\n332|\tgot, ok := document.SectionID(lines[0])\n333|\tif !ok || got != section {\n334|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n335|\t}\n336|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n337|}\n338|\n339|var operationCellPattern = regexp.MustCompile(`^\\| <code>([a-z-]+)</code> \\|`)\n340|\n341|// TestOperationRegistryIsDerivedFromSpec proves the dispatch registry is\n342|// exactly the Section 7.5 operation table in order: every table row must\n343|// appear in Operations() at the same position, and nothing else may.\n344|// A dropped, added, or reordered entry reddens here.\n345|func TestOperationRegistryIsDerivedFromSpec(t *testing.T) {\n346|\tdocument, err := specdoc.Load()\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n349|\t}\n350|\twindow := sectionLines(t, document, \"7.5\", 3070, 3086)\n351|\tvar derived []string\n352|\tfor _, line := range strings.Split(window, \"\\n\") {\n353|\t\tif match := operationCellPattern.FindStringSubmatch(line); match != nil {\n354|\t\t\tderived = append(derived, match[1])\n355|\t\t}\n356|\t}\n357|\tif len(derived) == 0 {\n358|\t\tt.Fatal(\"derived no operations from the Section 7.5 table; the check is blind\")\n359|\t}\n360|\tgot := Operations()\n361|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n362|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.5 table %v\", got, derived)\n363|\t}\n364|\tt.Logf(\"operation registry coverage: %d/%d table entries dispatched\", len(got), len(derived))\n365|}\n366|\n367|// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\n368|// package implements: the framing limits, the process model, the\n369|// envelope shapes, the closed-member rule, and the deadline/redaction\n370|// duties.\n371|func TestSection72FramingIsPinned(t *testing.T) {\n372|\tdocument, err := specdoc.Load()\n373|\tif err != nil {\n374|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n375|\t}\n376|\tfor _, excerpt := range []string{\n377|\t\t\"Each line MUST be one complete UTF-8\",\n378|\t\t\"JSON object no larger than 8 MiB\",\n379|\t\t\"Stdout MUST contain protocol frames only\",\n380|\t\t\"human diagnostics go to stderr\",\n381|\t\t\"starts one plugin process per operation\",\n382|\t\t\"After one response, <code>ax</code> closes stdin and the\",\n383|\t\t\"Exit 0 requires a successful response\",\n384|\t\t\"A structured error\",\n385|\t\t\"response SHOULD exit 0 because the protocol succeeded\",\n386|\t\t\"a crash, invalid frame,\",\n387|\t\t\"or missing response is a provider-host failure\",\n388|\t\t\"The deadline MUST be in the future when the host writes the frame\",\n389|\t\t\"A failure envelope contains\",\n(more lines below)"}}}
