{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c581","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":283,"recorded_at":1780531400000561,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"910f1336-c433-44ba-8429-00f9985e480f"},"task_id":"910f1336-c433-44ba-8429-00f9985e480f","event":{"kind":"output","task_id":"910f1336-c433-44ba-8429-00f9985e480f","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"go/ast\"\n9|\t\"go/parser\"\n10|\t\"go/token\"\n11|\t\"os\"\n12|\t\"path/filepath\"\n13|\t\"sort\"\n14|\t\"strconv\"\n15|\t\"strings\"\n16|\t\"testing\"\n17|\t\"time\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|)\n21|\n22|// This file is the derived refusal-arm inventory. It exists because the\n23|// constructor call-site audit in inventory_test.go enumerates constructor\n24|// call SITES, and every frameFault literal and every integrity(...) detail\n25|// funnels through a shared site: planting a new arm through an existing\n26|// site (a new &frameFault literal in checkResponseMembers, a new\n27|// integrity(...) detail in DecodeStatusOutcome) leaves the whole suite\n28|// green. Two review rounds each missed a row by hand, so the arm set is\n29|// derived from production source by parsing it, never by listing it.\n30|//\n31|// Derivation (deriveRefusalArms): every &frameFault{...} literal yields\n32|// frame|<detail>|<member source>; every integrity(...) call with a string\n33|// literal yields integrity|<detail>; the single wrapping site\n34|// integrity(\"status body is \"+fault.detail, ...) expands over the derived\n35|// frame detail set, so each wrapped refusal is its own obligation; every\n36|// rejection branch of parseMajor (a return 0, false) yields\n37|// parse|<enclosing condition source>; every literal first argument to one\n38|// of the six refusal constructors yields ctor|<constructor>|<detail>.\n39|// A non-literal frameFault detail or integrity argument lands as an\n40|// expr:<source> obligation rather than passing silently; a non-literal\n41|// constructor first argument is a fault conduit (fault.detail, a detail\n42|// variable) whose arms are the frame arms above, so it carries no\n43|// separate obligation by design. A missing parseMajor fails the\n44|// derivation outright.\n45|//\n46|// Both directions are checked: TestDerivedRefusalArmsAreAllWitnessed\n47|// (every derived arm carries a witness) and\n48|// TestWitnessedArmsAreAllDerived (every witness names a derived arm, so a\n49|// truncated derivation reddens on the orphaned witnesses instead of\n50|// passing vacuously). TestEveryArmWitnessRefusesAtTheProductionEntry\n51|// drives each witness through the production entry and requires the\n52|// refusal to come from the arm under test. Empty, single-file, or\n53|// unparseable derivations fail closed: a domain that silently derives\n54|// nothing is not a measurement.\n55|//\n56|// Stated bound: arms sharing one (constructor, detail) identity merge to\n57|// one obligation (the two timeout sites, the two empty-response sites,\n58|// the six identical \"not a JSON object\" sites). Deleting one of a merged\n59|// pair is a behavioral mutant the entry-point tests must catch, not this\n60|// inventory.\n61|\n62|// refusalArmCensusFloor is the derived arm count this test was written\n63|// against. It is a tripwire, not an enumeration: a derivation returning\n64|// fewer arms fails closed even when every surviving arm is witnessed,\n65|// which is what catches a silently truncated scan. Raising it is routine\n66|// when production gains a refusal; lowering it requires saying why.\n67|//\n68|// Raised 60 -> 162 by the operation-layer leaf (manifest, probe,\n69|// profile, quiescence, spawn, identity, idempotency decoders), each\n70|// new arm witnessed in declaredOperationWitnesses below.\n71|const refusalArmCensusFloor = 162\n72|\n73|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n74|\tt.Helper()\n75|\tdirectory, err := os.Getwd()\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n78|\t}\n79|\tarms, scanned, err := refusalArmsIn(directory)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n82|\t}\n83|\tif len(scanned) == 0 {\n84|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n85|\t}\n86|\tif len(arms) == 0 {\n87|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n88|\t}\n89|\tif len(arms) < refusalArmCensusFloor {\n90|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n91|\t}\n92|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n93|\treturn arms\n94|}\n95|\n96|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n97|\tentries, err := os.ReadDir(directory)\n98|\tif err != nil {\n99|\t\treturn nil, nil, err\n100|\t}\n101|\tarms := map[string]struct{}{}\n102|\tvar scanned []string\n103|\tparseBranches := 0\n104|\tfileSet := token.NewFileSet()\n105|\ttype productionFile struct {\n106|\t\tsyntax *ast.File\n107|\t\tsource []byte\n108|\t}\n109|\tvar files []productionFile\n110|\tfor _, entry := range entries {\n111|\t\tname := entry.Name()\n112|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n113|\t\t\tcontinue\n114|\t\t}\n115|\t\tscanned = append(scanned, name)\n116|\t\tpath := filepath.Join(directory, name)\n117|\t\tsource, err := os.ReadFile(path)\n118|\t\tif err != nil {\n119|\t\t\treturn nil, nil, err\n120|\t\t}\n121|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n122|\t\tif err != nil {\n123|\t\t\treturn nil, nil, err\n124|\t\t}\n125|\t\tfiles = append(files, productionFile{syntax: syntax, source: source})\n126|\t}\n127|\t// First pass, package-wide: the decodeStrictObject fault detail\n128|\t// set, which the integrity wrapper site expands over. The wrapper\n129|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n130|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n131|\t// set: expanding over every frameFault literal would invent arms\n132|\t// production can never emit. The pass must span files because the\n133|\t// literals live in protocol.go while the wrapper lives in status.go.\n134|\tvar strictDetails []string\n135|\tseenDetail := map[string]bool{}\n136|\tfor _, file := range files {\n137|\t\tfor _, decl := range file.syntax.Decls {\n138|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n139|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n140|\t\t\t\tcontinue\n141|\t\t\t}\n142|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n143|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n144|\t\t\t\tif !ok {\n145|\t\t\t\t\treturn true\n146|\t\t\t\t}\n147|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n148|\t\t\t\tif !ok {\n149|\t\t\t\t\treturn true\n150|\t\t\t\t}\n151|\t\t\t\tif !seenDetail[detail] {\n152|\t\t\t\t\tseenDetail[detail] = true\n153|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n154|\t\t\t\t}\n155|\t\t\t\treturn true\n156|\t\t\t})\n157|\t\t}\n158|\t}\n159|\tfor _, file := range files {\n160|\t\tsource, syntax := file.source, file.syntax\n161|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n162|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n163|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n164|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n165|\t\t\t\tif !ok {\n166|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n167|\t\t\t\t\treturn true\n168|\t\t\t\t}\n169|\t\t\t\tmember := \"\"\n170|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n171|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n172|\t\t\t\t}\n173|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n174|\t\t\t\treturn true\n175|\t\t\t}\n176|\t\t\tcall, ok := node.(*ast.CallExpr)\n177|\t\t\tif !ok {\n178|\t\t\t\treturn true\n179|\t\t\t}\n180|\t\t\tident, ok := call.Fun.(*ast.Ident)\n181|\t\t\tif !ok || len(call.Args) == 0 {\n182|\t\t\t\treturn true\n183|\t\t\t}\n184|\t\t\tswitch ident.Name {\n185|\t\t\tcase \"integrity\":\n186|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n187|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n188|\t\t\t\t\tif err != nil {\n189|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n190|\t\t\t\t\t\treturn true\n191|\t\t\t\t\t}\n192|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n193|\t\t\t\t\treturn true\n194|\t\t\t\t}\n195|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n196|\t\t\t\t\tif len(strictDetails) == 0 {\n197|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n198|\t\t\t\t\t\treturn true\n199|\t\t\t\t\t}\n200|\t\t\t\t\tfor _, detail := range strictDetails {\n201|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n202|\t\t\t\t\t}\n203|\t\t\t\t\treturn true\n204|\t\t\t\t}\n205|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n206|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n207|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n208|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n209|\t\t\t\t\tif err != nil {\n210|\t\t\t\t\t\treturn true\n211|\t\t\t\t\t}\n212|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n213|\t\t\t\t}\n214|\t\t\t\t// Non-literal first arguments are the fault conduits\n215|\t\t\t\t// (fault.detail, detail variables): the arms behind\n216|\t\t\t\t// them are the frame arms above, so there is no\n217|\t\t\t\t// separate obligation here.\n218|\t\t\t}\n219|\t\t\treturn true\n220|\t\t})\n221|\t}\n222|\tif parseBranches == 0 {\n223|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n224|\t}\n225|\tsort.Strings(scanned)\n226|\treturn arms, scanned, nil\n227|}\n228|\n229|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n230|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n231|\ttarget := node\n232|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n233|\t\ttarget = unary.X\n234|\t}\n235|\tliteral, ok := target.(*ast.CompositeLit)\n236|\tif !ok {\n237|\t\treturn nil, false\n238|\t}\n239|\tident, ok := literal.Type.(*ast.Ident)\n240|\tif !ok || ident.Name != \"frameFault\" {\n241|\t\treturn nil, false\n242|\t}\n243|\treturn literal, true\n244|}\n245|\n246|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n247|\tfor _, element := range literal.Elts {\n248|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n249|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n250|\t\t\t\treturn kv\n251|\t\t\t}\n252|\t\t}\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n258|\tkv := literalField(literal, name)\n259|\tif kv == nil {\n260|\t\treturn \"\", false\n261|\t}\n262|\tbasic, ok := kv.Value.(*ast.BasicLit)\n263|\tif !ok || basic.Kind != token.STRING {\n264|\t\treturn \"\", false\n265|\t}\n266|\tdetail, err := strconv.Unquote(basic.Value)\n267|\tif err != nil {\n268|\t\treturn \"\", false\n269|\t}\n270|\treturn detail, true\n271|}\n272|\n273|// integrityPrefix matches \"prefix\" + <expr>, the wrapping shape whose\n274|// arms expand over the derived frame detail set.\n275|func integrityPrefix(arg ast.Expr) (string, bool) {\n276|\tbinary, ok := arg.(*ast.BinaryExpr)\n277|\tif !ok || binary.Op != token.ADD {\n278|\t\treturn \"\", false\n279|\t}\n280|\tprefix, ok := binary.X.(*ast.BasicLit)\n281|\tif !ok || prefix.Kind != token.STRING {\n282|\t\treturn \"\", false\n283|\t}\n284|\ttext, err := strconv.Unquote(prefix.Value)\n285|\tif err != nil {\n286|\t\treturn \"\", false\n287|\t}\n288|\treturn text, true\n289|}\n290|\n291|func nodeSource(source []byte, fileSet *token.FileSet, node ast.Node) string {\n292|\tstart := fileSet.Position(node.Pos()).Offset\n293|\tend := fileSet.Position(node.End()).Offset\n294|\tif start < 0 || end > len(source) || start >= end {\n295|\t\treturn \"?\"\n296|\t}\n297|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n298|}\n299|\n300|// armParseBranches derives one obligation per parseMajor rejection\n301|// branch in this file: every return 0, false inside parseMajor, keyed by\n302|// its innermost enclosing condition, and returns how many it derived. A\n303|// new branch adds a key no witness names; a deleted branch orphans its\n304|// witness; narrowing || to && rewrites the key and does both. The caller\n305|// fails closed when no file derives any branch.\n306|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n307|\tvar body *ast.BlockStmt\n308|\tfor _, decl := range syntax.Decls {\n309|\t\tfunction, ok := decl.(*ast.FuncDecl)\n310|\t\tif ok && function.Name.Name == \"parseMajor\" {\n311|\t\t\tbody = function.Body\n312|\t\t}\n313|\t}\n314|\tif body == nil {\n315|\t\treturn 0\n316|\t}\n317|\tcount := 0\n318|\tvar conditions []string\n319|\tvar walk func(node ast.Node)\n320|\twalk = func(node ast.Node) {\n321|\t\tbranch, ok := node.(*ast.IfStmt)\n322|\t\tif !ok {\n323|\t\t\tfor _, child := range childNodes(node) {\n324|\t\t\t\twalk(child)\n325|\t\t\t}\n326|\t\t\treturn\n327|\t\t}\n328|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n329|\t\tfor _, stmt := range branch.Body.List {\n330|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n331|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n332|\t\t\t\tcount++\n333|\t\t\t}\n334|\t\t}\n335|\t\tfor _, child := range childNodes(node) {\n336|\t\t\twalk(child)\n337|\t\t}\n338|\t\tconditions = conditions[:len(conditions)-1]\n339|\t}\n340|\twalk(body)\n341|\treturn count\n342|}\n343|\n344|func isFalsePair(ret *ast.ReturnStmt) bool {\n345|\tif len(ret.Results) != 2 {\n346|\t\treturn false\n347|\t}\n348|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n349|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n350|\t\treturn false\n351|\t}\n352|\tno, ok := ret.Results[1].(*ast.Ident)\n353|\treturn ok && no.Name == \"false\"\n354|}\n355|\n356|func childNodes(node ast.Node) []ast.Node {\n357|\tvar children []ast.Node\n358|\tast.Inspect(node, func(child ast.Node) bool {\n359|\t\tif child == nil || child == node {\n360|\t\t\treturn true\n361|\t\t}\n362|\t\tchildren = append(children, child)\n363|\t\treturn false\n364|\t})\n365|\treturn children\n366|}\n367|\n368|// armWitness proves one derived refusal arm at the production entry.\n369|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n370|// fails a witness that names nothing production declares, so a deleted or\n371|// narrowed production branch orphans its witness instead of passing\n372|// silently. The prove function must drive the production entry point and\n373|// require the refusal attributed to THIS arm, not merely any refusal.\n374|type armWitness struct {\n375|\tarm   string\n376|\tname  string\n377|\tprove func(*testing.T)\n378|}\n379|\n380|// requireIntegrityRefusal asserts the full identity of a status refusal:\n381|// the integrity_failure code, the rule detail, the status_state detail\n382|// every integrity arm carries (AS6: asserted on all 18 arms, not just\n383|// the unknown row), exit 9, and the non-retryable bit. It is separate\n384|// from requireLocalRefusal because that helper also serves codes with no\n385|// status_state detail.\n386|func requireIntegrityRefusal(t *testing.T, err error, detail, wantState string) {\n387|\tt.Helper()\n388|\trequireLocalRefusal(t, err, \"integrity_failure\", detail)\n389|\tstate, ok := failureObject(t, err).Detail(\"status_state\")\n390|\tif !ok || state != wantState {\n391|\t\tt.Fatalf(\"integrity refusal status_state = %v, want %q (%v)\", state, wantState, err)\n392|\t}\n393|\tif failureExit(t, err) != 9 {\n394|\t\tt.Fatalf(\"integrity refusal exit = %d, want 9\", failureExit(t, err))\n395|\t}\n396|}\n397|\n398|func armVersionFrame(version string) []byte {\n399|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n400|}\n401|\n402|func armMemberFrame(members string) []byte {\n403|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n404|}\n405|\n406|func armOversizeResponse(t *testing.T) []byte {\n407|\tt.Helper()\n408|\tbuild := func(pad int) []byte {\n409|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n410|\t}\n411|\tbase := len(build(0))\n412|\tover := build(specFrameLimitBytes - base + 1)\n413|\tif len(over) != specFrameLimitBytes+1 {\n414|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n415|\t}\n416|\treturn over\n417|}\n418|\n419|func declaredArmWitnesses() []armWitness {\n420|\treturn []armWitness{\n421|\t\t// decodeStrictObject frame arms, through DecodeResponse.\n422|\t\t{arm: `frame|not a JSON object|\"\"`, name: \"array is not an object\", prove: func(t *testing.T) {\n423|\t\t\t_, err := DecodeResponse([]byte(`[1,2]`), mustUUIDv7(t, testRequestID))\n424|\t\t\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n425|\t\t}},\n426|\t\t{arm: `frame|not a JSON object|key`, name: \"truncated value names its member\", prove: func(t *testing.T) {\n427|\t\t\t_, err := DecodeResponse([]byte(`{\"protocol\":`), mustUUIDv7(t, testRequestID))\n428|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a JSON object\")\n429|\t\t}},\n430|\t\t{arm: `frame|duplicate member|key`, name: \"repeated member\", prove: func(t *testing.T) {\n431|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n432|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n433|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"duplicate member\")\n434|\t\t}},\n435|\t\t{arm: `frame|trailing data after the object|\"\"`, name: \"trailing byte\", prove: func(t *testing.T) {\n436|\t\t\t_, err := DecodeResponse(append(successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`), 'x'), mustUUIDv7(t, testRequestID))\n437|\t\t\trequireFrameRefusal(t, err, \"\", \"trailing data after the object\")\n438|\t\t}},\n439|\t\t{arm: `frame|missing member|name`, name: \"missing protocol\", prove: func(t *testing.T) {\n440|\t\t\tframe := []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n441|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n442|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n443|\t\t}},\n444|\t\t{arm: `frame|missing member|\"body\"`, name: \"success without body\", prove: func(t *testing.T) {\n445|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true`), mustUUIDv7(t, testRequestID))\n446|\t\t\trequireFrameRefusal(t, err, \"body\", \"missing member\")\n447|\t\t}},\n448|\t\t{arm: `frame|success envelope carries error|\"error\"`, name: \"error on success\", prove: func(t *testing.T) {\n449|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n450|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n451|\t\t\trequireFrameRefusal(t, err, \"error\", \"success envelope carries error\")\n452|\t\t}},\n453|\t\t{arm: `frame|missing member|\"error\"`, name: \"failure without error\", prove: func(t *testing.T) {\n454|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false`), mustUUIDv7(t, testRequestID))\n455|\t\t\trequireFrameRefusal(t, err, \"error\", \"missing member\")\n456|\t\t}},\n457|\t\t{arm: `frame|failure envelope carries body|\"body\"`, name: \"body on failure\", prove: func(t *testing.T) {\n458|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)\n459|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n460|\t\t\trequireFrameRefusal(t, err, \"body\", \"failure envelope carries body\")\n461|\t\t}},\n462|\t\t{arm: `frame|unknown member|name`, name: \"diagnostics member\", prove: func(t *testing.T) {\n463|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), mustUUIDv7(t, testRequestID))\n464|\t\t\trequireFrameRefusal(t, err, \"diagnostics\", \"unknown member\")\n465|\t\t}},\n466|\t\t// encodeFrame refusals, through EncodeRequest.\n467|\t\t{arm: `ctor|failInvalid|unknown operation`, name: \"unknown operation never frames\", prove: func(t *testing.T) {\n468|\t\t\treq := testRequest(t)\n469|\t\t\treq.Operation = \"reboot\"\n470|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n471|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n472|\t\t}},\n473|\t\t{arm: `ctor|failInvalid|request_id is not a UUIDv7`, name: \"zero request id\", prove: func(t *testing.T) {\n474|\t\t\tbad := testRequest(t)\n475|\t\t\tvar zero scalar.UUIDv7\n476|\t\t\tbad.RequestID = zero\n477|\t\t\t_, err := EncodeRequest(bad, mustInstant(t, testNow))\n478|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request_id is not a UUIDv7\")\n479|\t\t}},\n480|\t\t{arm: `ctor|failInvalid|deadline is not a timestamp`, name: \"zero deadline\", prove: func(t *testing.T) {\n481|\t\t\treq := testRequest(t)\n482|\t\t\treq.Deadline = mustTimestamp(t, testDeadline)\n483|\t\t\tvar zero scalar.Timestamp\n484|\t\t\treq.Deadline = zero\n485|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n486|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not a timestamp\")\n487|\t\t}},\n488|\t\t{arm: `ctor|failInvalid|deadline is not in the future`, name: \"stale deadline\", prove: func(t *testing.T) {\n489|\t\t\treq := testRequest(t)\n490|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n491|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n492|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n493|\t\t}},\n494|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n495|\t\t\treq := testRequest(t)\n496|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n497|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n498|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n499|\t\t}},\n500|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"910f1336-c433-44ba-8429-00f9985e480f"},"task_id":"910f1336-c433-44ba-8429-00f9985e480f","event":{"kind":"completed","task_id":"910f1336-c433-44ba-8429-00f9985e480f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffe9f0077e3882c57f207165fca","text":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"go/ast\"\n9|\t\"go/parser\"\n10|\t\"go/token\"\n11|\t\"os\"\n12|\t\"path/filepath\"\n13|\t\"sort\"\n14|\t\"strconv\"\n15|\t\"strings\"\n16|\t\"testing\"\n17|\t\"time\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n20|)\n21|\n22|// This file is the derived refusal-arm inventory. It exists because the\n23|// constructor call-site audit in inventory_test.go enumerates constructor\n24|// call SITES, and every frameFault literal and every integrity(...) detail\n25|// funnels through a shared site: planting a new arm through an existing\n26|// site (a new &frameFault literal in checkResponseMembers, a new\n27|// integrity(...) detail in DecodeStatusOutcome) leaves the whole suite\n28|// green. Two review rounds each missed a row by hand, so the arm set is\n29|// derived from production source by parsing it, never by listing it.\n30|//\n31|// Derivation (deriveRefusalArms): every &frameFault{...} literal yields\n32|// frame|<detail>|<member source>; every integrity(...) call with a string\n33|// literal yields integrity|<detail>; the single wrapping site\n34|// integrity(\"status body is \"+fault.detail, ...) expands over the derived\n35|// frame detail set, so each wrapped refusal is its own obligation; every\n36|// rejection branch of parseMajor (a return 0, false) yields\n37|// parse|<enclosing condition source>; every literal first argument to one\n38|// of the six refusal constructors yields ctor|<constructor>|<detail>.\n39|// A non-literal frameFault detail or integrity argument lands as an\n40|// expr:<source> obligation rather than passing silently; a non-literal\n41|// constructor first argument is a fault conduit (fault.detail, a detail\n42|// variable) whose arms are the frame arms above, so it carries no\n43|// separate obligation by design. A missing parseMajor fails the\n44|// derivation outright.\n45|//\n46|// Both directions are checked: TestDerivedRefusalArmsAreAllWitnessed\n47|// (every derived arm carries a witness) and\n48|// TestWitnessedArmsAreAllDerived (every witness names a derived arm, so a\n49|// truncated derivation reddens on the orphaned witnesses instead of\n50|// passing vacuously). TestEveryArmWitnessRefusesAtTheProductionEntry\n51|// drives each witness through the production entry and requires the\n52|// refusal to come from the arm under test. Empty, single-file, or\n53|// unparseable derivations fail closed: a domain that silently derives\n54|// nothing is not a measurement.\n55|//\n56|// Stated bound: arms sharing one (constructor, detail) identity merge to\n57|// one obligation (the two timeout sites, the two empty-response sites,\n58|// the six identical \"not a JSON object\" sites). Deleting one of a merged\n59|// pair is a behavioral mutant the entry-point tests must catch, not this\n60|// inventory.\n61|\n62|// refusalArmCensusFloor is the derived arm count this test was written\n63|// against. It is a tripwire, not an enumeration: a derivation returning\n64|// fewer arms fails closed even when every surviving arm is witnessed,\n65|// which is what catches a silently truncated scan. Raising it is routine\n66|// when production gains a refusal; lowering it requires saying why.\n67|//\n68|// Raised 60 -> 162 by the operation-layer leaf (manifest, probe,\n69|// profile, quiescence, spawn, identity, idempotency decoders), each\n70|// new arm witnessed in declaredOperationWitnesses below.\n71|const refusalArmCensusFloor = 162\n72|\n73|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n74|\tt.Helper()\n75|\tdirectory, err := os.Getwd()\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n78|\t}\n79|\tarms, scanned, err := refusalArmsIn(directory)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n82|\t}\n83|\tif len(scanned) == 0 {\n84|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n85|\t}\n86|\tif len(arms) == 0 {\n87|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n88|\t}\n89|\tif len(arms) < refusalArmCensusFloor {\n90|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n91|\t}\n92|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n93|\treturn arms\n94|}\n95|\n96|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n97|\tentries, err := os.ReadDir(directory)\n98|\tif err != nil {\n99|\t\treturn nil, nil, err\n100|\t}\n101|\tarms := map[string]struct{}{}\n102|\tvar scanned []string\n103|\tparseBranches := 0\n104|\tfileSet := token.NewFileSet()\n105|\ttype productionFile struct {\n106|\t\tsyntax *ast.File\n107|\t\tsource []byte\n108|\t}\n109|\tvar files []productionFile\n110|\tfor _, entry := range entries {\n111|\t\tname := entry.Name()\n112|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n113|\t\t\tcontinue\n114|\t\t}\n115|\t\tscanned = append(scanned, name)\n116|\t\tpath := filepath.Join(directory, name)\n117|\t\tsource, err := os.ReadFile(path)\n118|\t\tif err != nil {\n119|\t\t\treturn nil, nil, err\n120|\t\t}\n121|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n122|\t\tif err != nil {\n123|\t\t\treturn nil, nil, err\n124|\t\t}\n125|\t\tfiles = append(files, productionFile{syntax: syntax, source: source})\n126|\t}\n127|\t// First pass, package-wide: the decodeStrictObject fault detail\n128|\t// set, which the integrity wrapper site expands over. The wrapper\n129|\t// only wraps decodeStrictObject faults, so checkResponseMembers\n130|\t// arms (\"missing member\", \"unknown member\", ...) are not in this\n131|\t// set: expanding over every frameFault literal would invent arms\n132|\t// production can never emit. The pass must span files because the\n133|\t// literals live in protocol.go while the wrapper lives in status.go.\n134|\tvar strictDetails []string\n135|\tseenDetail := map[string]bool{}\n136|\tfor _, file := range files {\n137|\t\tfor _, decl := range file.syntax.Decls {\n138|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n139|\t\t\tif !ok || function.Name.Name != \"decodeStrictObject\" {\n140|\t\t\t\tcontinue\n141|\t\t\t}\n142|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n143|\t\t\t\tliteral, ok := frameFaultLiteral(node)\n144|\t\t\t\tif !ok {\n145|\t\t\t\t\treturn true\n146|\t\t\t\t}\n147|\t\t\t\tdetail, ok := literalStringField(file.source, fileSet, literal, \"detail\")\n148|\t\t\t\tif !ok {\n149|\t\t\t\t\treturn true\n150|\t\t\t\t}\n151|\t\t\t\tif !seenDetail[detail] {\n152|\t\t\t\t\tseenDetail[detail] = true\n153|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n154|\t\t\t\t}\n155|\t\t\t\treturn true\n156|\t\t\t})\n157|\t\t}\n158|\t}\n159|\tfor _, file := range files {\n160|\t\tsource, syntax := file.source, file.syntax\n161|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n162|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n163|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n164|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n165|\t\t\t\tif !ok {\n166|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n167|\t\t\t\t\treturn true\n168|\t\t\t\t}\n169|\t\t\t\tmember := \"\"\n170|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n171|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n172|\t\t\t\t}\n173|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n174|\t\t\t\treturn true\n175|\t\t\t}\n176|\t\t\tcall, ok := node.(*ast.CallExpr)\n177|\t\t\tif !ok {\n178|\t\t\t\treturn true\n179|\t\t\t}\n180|\t\t\tident, ok := call.Fun.(*ast.Ident)\n181|\t\t\tif !ok || len(call.Args) == 0 {\n182|\t\t\t\treturn true\n183|\t\t\t}\n184|\t\t\tswitch ident.Name {\n185|\t\t\tcase \"integrity\":\n186|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n187|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n188|\t\t\t\t\tif err != nil {\n189|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n190|\t\t\t\t\t\treturn true\n191|\t\t\t\t\t}\n192|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n193|\t\t\t\t\treturn true\n194|\t\t\t\t}\n195|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n196|\t\t\t\t\tif len(strictDetails) == 0 {\n197|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n198|\t\t\t\t\t\treturn true\n199|\t\t\t\t\t}\n200|\t\t\t\t\tfor _, detail := range strictDetails {\n201|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n202|\t\t\t\t\t}\n203|\t\t\t\t\treturn true\n204|\t\t\t\t}\n205|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n206|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n207|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n208|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n209|\t\t\t\t\tif err != nil {\n210|\t\t\t\t\t\treturn true\n211|\t\t\t\t\t}\n212|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n213|\t\t\t\t}\n214|\t\t\t\t// Non-literal first arguments are the fault conduits\n215|\t\t\t\t// (fault.detail, detail variables): the arms behind\n216|\t\t\t\t// them are the frame arms above, so there is no\n217|\t\t\t\t// separate obligation here.\n218|\t\t\t}\n219|\t\t\treturn true\n220|\t\t})\n221|\t}\n222|\tif parseBranches == 0 {\n223|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n224|\t}\n225|\tsort.Strings(scanned)\n226|\treturn arms, scanned, nil\n227|}\n228|\n229|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n230|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n231|\ttarget := node\n232|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n233|\t\ttarget = unary.X\n234|\t}\n235|\tliteral, ok := target.(*ast.CompositeLit)\n236|\tif !ok {\n237|\t\treturn nil, false\n238|\t}\n239|\tident, ok := literal.Type.(*ast.Ident)\n240|\tif !ok || ident.Name != \"frameFault\" {\n241|\t\treturn nil, false\n242|\t}\n243|\treturn literal, true\n244|}\n245|\n246|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n247|\tfor _, element := range literal.Elts {\n248|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n249|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n250|\t\t\t\treturn kv\n251|\t\t\t}\n252|\t\t}\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|func literalStringField(source []byte, fileSet *token.FileSet, literal *ast.CompositeLit, name string) (string, bool) {\n258|\tkv := literalField(literal, name)\n259|\tif kv == nil {\n260|\t\treturn \"\", false\n261|\t}\n262|\tbasic, ok := kv.Value.(*ast.BasicLit)\n263|\tif !ok || basic.Kind != token.STRING {\n264|\t\treturn \"\", false\n265|\t}\n266|\tdetail, err := strconv.Unquote(basic.Value)\n267|\tif err != nil {\n268|\t\treturn \"\", false\n269|\t}\n270|\treturn detail, true\n271|}\n272|\n273|// integrityPrefix matches \"prefix\" + <expr>, the wrapping shape whose\n274|// arms expand over the derived frame detail set.\n275|func integrityPrefix(arg ast.Expr) (string, bool) {\n276|\tbinary, ok := arg.(*ast.BinaryExpr)\n277|\tif !ok || binary.Op != token.ADD {\n278|\t\treturn \"\", false\n279|\t}\n280|\tprefix, ok := binary.X.(*ast.BasicLit)\n281|\tif !ok || prefix.Kind != token.STRING {\n282|\t\treturn \"\", false\n283|\t}\n284|\ttext, err := strconv.Unquote(prefix.Value)\n285|\tif err != nil {\n286|\t\treturn \"\", false\n287|\t}\n288|\treturn text, true\n289|}\n290|\n291|func nodeSource(source []byte, fileSet *token.FileSet, node ast.Node) string {\n292|\tstart := fileSet.Position(node.Pos()).Offset\n293|\tend := fileSet.Position(node.End()).Offset\n294|\tif start < 0 || end > len(source) || start >= end {\n295|\t\treturn \"?\"\n296|\t}\n297|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n298|}\n299|\n300|// armParseBranches derives one obligation per parseMajor rejection\n301|// branch in this file: every return 0, false inside parseMajor, keyed by\n302|// its innermost enclosing condition, and returns how many it derived. A\n303|// new branch adds a key no witness names; a deleted branch orphans its\n304|// witness; narrowing || to && rewrites the key and does both. The caller\n305|// fails closed when no file derives any branch.\n306|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n307|\tvar body *ast.BlockStmt\n308|\tfor _, decl := range syntax.Decls {\n309|\t\tfunction, ok := decl.(*ast.FuncDecl)\n310|\t\tif ok && function.Name.Name == \"parseMajor\" {\n311|\t\t\tbody = function.Body\n312|\t\t}\n313|\t}\n314|\tif body == nil {\n315|\t\treturn 0\n316|\t}\n317|\tcount := 0\n318|\tvar conditions []string\n319|\tvar walk func(node ast.Node)\n320|\twalk = func(node ast.Node) {\n321|\t\tbranch, ok := node.(*ast.IfStmt)\n322|\t\tif !ok {\n323|\t\t\tfor _, child := range childNodes(node) {\n324|\t\t\t\twalk(child)\n325|\t\t\t}\n326|\t\t\treturn\n327|\t\t}\n328|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n329|\t\tfor _, stmt := range branch.Body.List {\n330|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n331|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n332|\t\t\t\tcount++\n333|\t\t\t}\n334|\t\t}\n335|\t\tfor _, child := range childNodes(node) {\n336|\t\t\twalk(child)\n337|\t\t}\n338|\t\tconditions = conditions[:len(conditions)-1]\n339|\t}\n340|\twalk(body)\n341|\treturn count\n342|}\n343|\n344|func isFalsePair(ret *ast.ReturnStmt) bool {\n345|\tif len(ret.Results) != 2 {\n346|\t\treturn false\n347|\t}\n348|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n349|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n350|\t\treturn false\n351|\t}\n352|\tno, ok := ret.Results[1].(*ast.Ident)\n353|\treturn ok && no.Name == \"false\"\n354|}\n355|\n356|func childNodes(node ast.Node) []ast.Node {\n357|\tvar children []ast.Node\n358|\tast.Inspect(node, func(child ast.Node) bool {\n359|\t\tif child == nil || child == node {\n360|\t\t\treturn true\n361|\t\t}\n362|\t\tchildren = append(children, child)\n363|\t\treturn false\n364|\t})\n365|\treturn children\n366|}\n367|\n368|// armWitness proves one derived refusal arm at the production entry.\n369|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n370|// fails a witness that names nothing production declares, so a deleted or\n371|// narrowed production branch orphans its witness instead of passing\n372|// silently. The prove function must drive the production entry point and\n373|// require the refusal attributed to THIS arm, not merely any refusal.\n374|type armWitness struct {\n375|\tarm   string\n376|\tname  string\n377|\tprove func(*testing.T)\n378|}\n379|\n380|// requireIntegrityRefusal asserts the full identity of a status refusal:\n381|// the integrity_failure code, the rule detail, the status_state detail\n382|// every integrity arm carries (AS6: asserted on all 18 arms, not just\n383|// the unknown row), exit 9, and the non-retryable bit. It is separate\n384|// from requireLocalRefusal because that helper also serves codes with no\n385|// status_state detail.\n386|func requireIntegrityRefusal(t *testing.T, err error, detail, wantState string) {\n387|\tt.Helper()\n388|\trequireLocalRefusal(t, err, \"integrity_failure\", detail)\n389|\tstate, ok := failureObject(t, err).Detail(\"status_state\")\n390|\tif !ok || state != wantState {\n391|\t\tt.Fatalf(\"integrity refusal status_state = %v, want %q (%v)\", state, wantState, err)\n392|\t}\n393|\tif failureExit(t, err) != 9 {\n394|\t\tt.Fatalf(\"integrity refusal exit = %d, want 9\", failureExit(t, err))\n395|\t}\n396|}\n397|\n398|func armVersionFrame(version string) []byte {\n399|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n400|}\n401|\n402|func armMemberFrame(members string) []byte {\n403|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n404|}\n405|\n406|func armOversizeResponse(t *testing.T) []byte {\n407|\tt.Helper()\n408|\tbuild := func(pad int) []byte {\n409|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n410|\t}\n411|\tbase := len(build(0))\n412|\tover := build(specFrameLimitBytes - base + 1)\n413|\tif len(over) != specFrameLimitBytes+1 {\n414|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n415|\t}\n416|\treturn over\n417|}\n418|\n419|func declaredArmWitnesses() []armWitness {\n420|\treturn []armWitness{\n421|\t\t// decodeStrictObject frame arms, through DecodeResponse.\n422|\t\t{arm: `frame|not a JSON object|\"\"`, name: \"array is not an object\", prove: func(t *testing.T) {\n423|\t\t\t_, err := DecodeResponse([]byte(`[1,2]`), mustUUIDv7(t, testRequestID))\n424|\t\t\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n425|\t\t}},\n426|\t\t{arm: `frame|not a JSON object|key`, name: \"truncated value names its member\", prove: func(t *testing.T) {\n427|\t\t\t_, err := DecodeResponse([]byte(`{\"protocol\":`), mustUUIDv7(t, testRequestID))\n428|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a JSON object\")\n429|\t\t}},\n430|\t\t{arm: `frame|duplicate member|key`, name: \"repeated member\", prove: func(t *testing.T) {\n431|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n432|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n433|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"duplicate member\")\n434|\t\t}},\n435|\t\t{arm: `frame|trailing data after the object|\"\"`, name: \"trailing byte\", prove: func(t *testing.T) {\n436|\t\t\t_, err := DecodeResponse(append(successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`), 'x'), mustUUIDv7(t, testRequestID))\n437|\t\t\trequireFrameRefusal(t, err, \"\", \"trailing data after the object\")\n438|\t\t}},\n439|\t\t{arm: `frame|missing member|name`, name: \"missing protocol\", prove: func(t *testing.T) {\n440|\t\t\tframe := []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n441|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n442|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n443|\t\t}},\n444|\t\t{arm: `frame|missing member|\"body\"`, name: \"success without body\", prove: func(t *testing.T) {\n445|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true`), mustUUIDv7(t, testRequestID))\n446|\t\t\trequireFrameRefusal(t, err, \"body\", \"missing member\")\n447|\t\t}},\n448|\t\t{arm: `frame|success envelope carries error|\"error\"`, name: \"error on success\", prove: func(t *testing.T) {\n449|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n450|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n451|\t\t\trequireFrameRefusal(t, err, \"error\", \"success envelope carries error\")\n452|\t\t}},\n453|\t\t{arm: `frame|missing member|\"error\"`, name: \"failure without error\", prove: func(t *testing.T) {\n454|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false`), mustUUIDv7(t, testRequestID))\n455|\t\t\trequireFrameRefusal(t, err, \"error\", \"missing member\")\n456|\t\t}},\n457|\t\t{arm: `frame|failure envelope carries body|\"body\"`, name: \"body on failure\", prove: func(t *testing.T) {\n458|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)\n459|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n460|\t\t\trequireFrameRefusal(t, err, \"body\", \"failure envelope carries body\")\n461|\t\t}},\n462|\t\t{arm: `frame|unknown member|name`, name: \"diagnostics member\", prove: func(t *testing.T) {\n463|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), mustUUIDv7(t, testRequestID))\n464|\t\t\trequireFrameRefusal(t, err, \"diagnostics\", \"unknown member\")\n465|\t\t}},\n466|\t\t// encodeFrame refusals, through EncodeRequest.\n467|\t\t{arm: `ctor|failInvalid|unknown operation`, name: \"unknown operation never frames\", prove: func(t *testing.T) {\n468|\t\t\treq := testRequest(t)\n469|\t\t\treq.Operation = \"reboot\"\n470|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n471|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n472|\t\t}},\n473|\t\t{arm: `ctor|failInvalid|request_id is not a UUIDv7`, name: \"zero request id\", prove: func(t *testing.T) {\n474|\t\t\tbad := testRequest(t)\n475|\t\t\tvar zero scalar.UUIDv7\n476|\t\t\tbad.RequestID = zero\n477|\t\t\t_, err := EncodeRequest(bad, mustInstant(t, testNow))\n478|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request_id is not a UUIDv7\")\n479|\t\t}},\n480|\t\t{arm: `ctor|failInvalid|deadline is not a timestamp`, name: \"zero deadline\", prove: func(t *testing.T) {\n481|\t\t\treq := testRequest(t)\n482|\t\t\treq.Deadline = mustTimestamp(t, testDeadline)\n483|\t\t\tvar zero scalar.Timestamp\n484|\t\t\treq.Deadline = zero\n485|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n486|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not a timestamp\")\n487|\t\t}},\n488|\t\t{arm: `ctor|failInvalid|deadline is not in the future`, name: \"stale deadline\", prove: func(t *testing.T) {\n489|\t\t\treq := testRequest(t)\n490|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n491|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n492|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n493|\t\t}},\n494|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n495|\t\t\treq := testRequest(t)\n496|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n497|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n498|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n499|\t\t}},\n500|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
