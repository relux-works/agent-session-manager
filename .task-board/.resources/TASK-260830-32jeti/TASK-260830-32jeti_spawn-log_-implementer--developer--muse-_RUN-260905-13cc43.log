{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e3","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":716,"recorded_at":1780531400001427,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"b906a274-9e3d-4669-a276-d6d66db1514a"},"task_id":"b906a274-9e3d-4669-a276-d6d66db1514a","event":{"kind":"output","task_id":"b906a274-9e3d-4669-a276-d6d66db1514a","chunk":"Read text file `internal/provhost/identity_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// specIdentityExample is the Section 5.5 Provider Identity Record\n9|// example, copied verbatim from the pinned document: an Antigravity\n10|// backend_conversation_uuid with a non-null realm fingerprint.\n11|const specIdentityExample = `{\n12|  \"schema\": \"urn:ax:schema:provider-identity\",\n13|  \"schema_version\": \"1.0.0\",\n14|  \"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\",\n15|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n16|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n17|  \"provider_id\": \"antigravity\",\n18|  \"provider_version\": \"1.1.14\",\n19|  \"provider_version_range\": \">=1.1.14 <1.2.0\",\n20|  \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n21|  \"identity_kind\": \"backend_conversation_uuid\",\n22|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n23|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n24|  \"opaque_identity\": {},\n25|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n26|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n27|  \"extensions\": {}\n28|}`\n29|\n30|// TestSpecIdentityExampleDecodes proves the Section 5.5 example\n31|// passes the production entry point for its provider.\n32|func TestSpecIdentityExampleDecodes(t *testing.T) {\n33|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n34|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n35|\t}\n36|}\n37|\n38|// identityVariant rewrites one unique substring of the example.\n39|func identityVariant(t *testing.T, old, new string) []byte {\n40|\tt.Helper()\n41|\tif strings.Count(specIdentityExample, old) != 1 {\n42|\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\n43|\t}\n44|\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\n45|}\n46|\n47|// TestCheckIdentityRefusals drives every identity rule, including\n48|// the five normative Section 5.5 negatives: unknown identity_kind,\n49|// absent opaque_identity, an object opaque value, an absolute source\n50|// path in that map, and an Antigravity backend_conversation_uuid\n51|// with a null realm fingerprint.\n52|func TestCheckIdentityRefusals(t *testing.T) {\n53|\tlong128 := strings.Repeat(\"v\", 128)\n54|\tlong129 := strings.Repeat(\"v\", 129)\n55|\tlong1024 := strings.Repeat(\"v\", 1024)\n56|\tlong1025 := strings.Repeat(\"v\", 1025)\n57|\tlong256 := strings.Repeat(\"r\", 256)\n58|\tlong257 := strings.Repeat(\"r\", 257)\n59|\tlong512 := strings.Repeat(\"s\", 512)\n60|\tlong513 := strings.Repeat(\"s\", 513)\n(more lines below)"}}}
