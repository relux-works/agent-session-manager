{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c507","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":222,"recorded_at":1780531400000439,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"b5e8390c-6c55-489d-bbad-0c1708a2b038"},"task_id":"b5e8390c-6c55-489d-bbad-0c1708a2b038","event":{"kind":"output","task_id":"b5e8390c-6c55-489d-bbad-0c1708a2b038","chunk":"Read text file `/tmp/probepack/review-round5-widening-probe_test.go.txt`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|func reviewReport(t *testing.T, name string, err error) {\n11|\tt.Helper()\n12|\tif err == nil {\n13|\t\tt.Errorf(\"REVIEWPROBE %s: ACCEPTED\", name)\n14|\t} else {\n15|\t\tt.Logf(\"REVIEWPROBE %s: refused (%v)\", name, err)\n16|\t}\n17|}\n18|\n19|// TestReviewProbeExtraMemberAcceptance reports whether each closed\n20|// object accepts a body carrying one extra \"bogus\" member.\n21|func TestReviewProbeExtraMemberAcceptance(t *testing.T) {\n22|\treviewReport(t, \"manifest-extra\", DecodeManifest(manifestVariant(t, \"\\\"schema_version\\\": \\\"1.0.0\\\",\", \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")))\n23|\treviewReport(t, \"probe-extra\", DecodeProbe(probeVariant(t, \"\\\"schema_version\\\": \\\"1.0.0\\\",\", \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")))\n24|\treviewReport(t, \"quiesce-extra\", quiesceErr([]byte(strings.Replace(safeQuiesceProof, \"\\\"provider_id\\\": \\\"codex\\\",\", \"\\\"provider_id\\\": \\\"codex\\\",\\n  \\\"bogus\\\": 1,\", 1))))\n25|\treviewReport(t, \"identity-extra\", CheckIdentity(identityVariant(t, \"\\\"schema_version\\\": \\\"1.0.0\\\",\", \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\"), \"antigravity\"))\n26|}\n27|\n28|// TestReviewProbeMissingRequiredAcceptance reports whether a proof\n29|// omitting blockers is accepted.\n30|func TestReviewProbeMissingRequiredAcceptance(t *testing.T) {\n31|\tproof := strings.Replace(safeQuiesceProof, \",\\n  \\\"blockers\\\": []\", \"\", 1)\n32|\tif strings.Contains(proof, \"blockers\") {\n33|\t\tt.Fatal(\"probe body still carries blockers; the check is blind\")\n34|\t}\n35|\t_, err := DecodeQuiesceProof([]byte(proof))\n36|\treviewReport(t, \"quiesce-omits-blockers\", err)\n37|}\n38|\n39|// TestReviewProbeProfileMapping reports the mapping for an unknown provider.\n40|func TestReviewProbeProfileMapping(t *testing.T) {\n41|\tflag, err := ProfileMapping(\"bogus\", ProfileYOLO)\n42|\tif err == nil {\n43|\t\tt.Errorf(\"REVIEWPROBE profile-mapping-bogus: ACCEPTED -> %q\", flag)\n44|\t} else {\n45|\t\tt.Logf(\"REVIEWPROBE profile-mapping-bogus: refused (%v)\", err)\n46|\t}\n47|}\n48|\n49|// TestReviewProbeExtraMemberAcceptance2 covers the remaining four\n50|// closed object member sets.\n51|func TestReviewProbeExtraMemberAcceptance2(t *testing.T) {\n52|\treviewReport(t, \"probe-capability-extra\", DecodeProbe(probeVariant(t, \"\\\"status\\\": \\\"available\\\",\\n      \\\"enabled\\\": true,\", \"\\\"status\\\": \\\"available\\\",\\n      \\\"bogus\\\": 1,\\n      \\\"enabled\\\": true,\")))\n53|\treviewReport(t, \"identify-extra\", DecodeIdentifyResult(identifyResultVariant(t, \"\\\"confidence\\\": \\\"exact\\\"\", \"\\\"bogus\\\": 1,\\n  \\\"confidence\\\": \\\"exact\\\"\"), \"antigravity\"))\n54|\treviewReport(t, \"spawn-extra\", DecodeSpawnPlan(spawnVariant(t, \"\\\"cwd\\\":\", \"\\\"bogus\\\": 1,\\n  \\\"cwd\\\":\"), \"codex\", ProfileYOLO, scalar.PlatformLinux))\n55|\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n56|\textra := []byte(strings.Replace(string(body), \"{\\\"materialization_id\\\":\", \"{\\\"bogus\\\":1,\\\"materialization_id\\\":\", 1))\n57|\t_, err := DecodeStatusOutcome(extra, testStatusIDs())\n58|\treviewReport(t, \"status-extra\", err)\n59|}"}}}
