{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c631","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":371,"recorded_at":1780531400000737,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"ef01858f-7530-4178-8fe6-36cbc55f57cd"},"task_id":"ef01858f-7530-4178-8fe6-36cbc55f57cd","event":{"kind":"output","task_id":"ef01858f-7530-4178-8fe6-36cbc55f57cd","chunk":"Read text file `internal/provhost/manifest.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|)\n7|\n8|// This file validates the Section 7.3 Provider Manifest: the closed\n9|// urn:ax:schema:provider-manifest 1.0.0 object a manifest operation\n10|// returns as its success body. The manifest declares possible surfaces,\n11|// not runtime availability; every member below is required and the\n12|// object is closed.\n13|\n14|// manifestSchema is the exact schema identifier the manifest carries.\n15|const manifestSchema = \"urn:ax:schema:provider-manifest\"\n16|\n17|// manifestSchemaVersion is the only manifest version this host accepts.\n18|const manifestSchemaVersion = \"1.0.0\"\n19|\n20|// capabilityOrder is the exact seven-name ordered capability registry\n21|// Section 7.3 shows. The manifest and every probe body carry exactly\n22|// these names in this order; an eighth name advertises a surface the\n23|// contract never defined, and a missing name hides one it did.\n24|var capabilityOrder = []string{\n25|\t\"native_resume\",\n26|\t\"portable_store\",\n27|\t\"managed_pty\",\n28|\t\"appserver\",\n29|\t\"task_board_primary\",\n30|\t\"prompt_spawn\",\n31|\t\"native_goal_binding\",\n32|}\n33|\n34|// Capabilities returns the Section 7.3 capability registry in order.\n35|// The result is a copy; the registry cannot be mutated through it.\n36|func Capabilities() []string {\n37|\treturn append([]string(nil), capabilityOrder...)\n38|}\n39|\n40|// manifestPlatforms is the closed platform vocabulary Section 7.3\n41|// allows: a sorted, unique, non-empty subset of these four.\n42|var manifestPlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n43|\n44|// semverPattern is the SemVer grammar plugin_version and adapter\n45|// versions satisfy: three dot-separated non-negative integers with no\n46|// leading zeros, an optional pre-release, and optional build metadata.\n47|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n48|\n49|// providerIDPattern is the Section 7.1 provider-id grammar the\n50|// manifest and identity layers read: [a-z][a-z0-9-]{0,31}.\n51|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n52|\n53|// manifestMembers is the exact required member set DecodeManifest\n54|// accepts: the schema envelope, identity, versioning, platforms, the\n55|// Section 7.5 operation registry in manifest order, and the capability\n56|// registry above.\n57|var manifestMembers = map[string]bool{\n58|\t\"schema\":                 true,\n59|\t\"schema_version\":         true,\n60|\t\"provider_id\":            true,\n61|\t\"display_name\":           true,\n62|\t\"plugin_version\":         true,\n63|\t\"provider_version_range\": true,\n64|\t\"platforms\":              true,\n65|\t\"operations\":             true,\n66|\t\"capability_names\":       true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"display_name\",\n76|\t\"plugin_version\",\n77|\t\"provider_version_range\",\n78|\t\"platforms\",\n79|\t\"operations\",\n80|\t\"capability_names\",\n81|}\n82|\n83|// DecodeManifest validates one manifest-operation success body as the\n84|// closed Section 7.3 Provider Manifest. It returns nil on a\n85|// well-formed manifest and a provider_protocol_error naming the\n86|// offending member otherwise. A manifest whose operations differ from\n87|// the dispatch registry, or whose capability names differ from the\n88|// registry above, advertises a surface the host cannot invoke or hides\n89|// one it must, so both are refused outright.\n90|func DecodeManifest(body []byte) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"manifest carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, manifestRequired); missing {\n107|\t\tfailure, err := failProtocol(\"manifest misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n114|\t\tfailure, err := failProtocol(\"manifest schema is not the provider manifest\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n121|\t\tfailure, err := failProtocol(\"manifest schema_version is not 1.0.0\", \"schema_version\")\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n128|\t\tfailure, err := failProtocol(\"manifest provider_id is not a provider id\", \"provider_id\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tif name, ok := rawString(members[\"display_name\"]); !ok || runeLength(name) < 1 || runeLength(name) > 128 {\n135|\t\tfailure, err := failProtocol(\"manifest display_name is not 1..128 characters\", \"display_name\")\n136|\t\tif err != nil {\n137|\t\t\treturn err\n138|\t\t}\n139|\t\treturn failure\n140|\t}\n141|\tif version, ok := rawString(members[\"plugin_version\"]); !ok || !semverPattern.MatchString(version) {\n142|\t\tfailure, err := failProtocol(\"manifest plugin_version is not SemVer\", \"plugin_version\")\n143|\t\tif err != nil {\n144|\t\t\treturn err\n145|\t\t}\n146|\t\treturn failure\n147|\t}\n148|\tif constraint, ok := rawString(members[\"provider_version_range\"]); !ok || runeLength(constraint) < 1 || runeLength(constraint) > 256 {\n149|\t\tfailure, err := failProtocol(\"manifest provider_version_range is not 1..256 characters\", \"provider_version_range\")\n150|\t\tif err != nil {\n151|\t\t\treturn err\n152|\t\t}\n153|\t\treturn failure\n154|\t}\n155|\tif err := checkManifestPlatforms(members[\"platforms\"]); err != nil {\n156|\t\treturn err\n157|\t}\n158|\tif err := checkManifestOperations(members[\"operations\"]); err != nil {\n159|\t\treturn err\n160|\t}\n161|\tif err := checkManifestCapabilities(members[\"capability_names\"]); err != nil {\n162|\t\treturn err\n163|\t}\n164|\treturn nil\n165|}\n166|\n167|// validProviderID reports whether the value satisfies the Section 7.1\n168|// provider-id grammar without importing the trust package: the manifest\n169|// layer reads the grammar, never the filesystem.\n170|func validProviderID(value string) bool {\n171|\treturn providerIDPattern.MatchString(value)\n172|}\n173|\n174|// checkManifestPlatforms enforces the sorted, unique, non-empty subset\n175|// rule over the four platform enums. Each shape carries its own\n176|// refusal so narrowing any one check reddens its own fixture.\n177|func checkManifestPlatforms(raw json.RawMessage) error {\n178|\tplatforms, ok := rawStringArray(raw)\n179|\tif !ok || len(platforms) == 0 {\n180|\t\tfailure, err := failProtocol(\"manifest platforms is empty or not an array\", \"platforms\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tallowed := map[string]bool{}\n187|\tfor _, platform := range manifestPlatforms {\n188|\t\tallowed[platform] = true\n189|\t}\n190|\tfor _, platform := range platforms {\n191|\t\tif !allowed[platform] {\n192|\t\t\tfailure, err := failProtocol(\"manifest platforms names an unknown platform\", \"platforms\")\n193|\t\t\tif err != nil {\n194|\t\t\t\treturn err\n195|\t\t\t}\n196|\t\t\treturn failure\n197|\t\t}\n198|\t}\n199|\tif !sortedUniqueStrings(platforms) {\n200|\t\tfailure, err := failProtocol(\"manifest platforms are not sorted unique\", \"platforms\")\n201|\t\tif err != nil {\n202|\t\t\treturn err\n203|\t\t}\n204|\t\treturn failure\n205|\t}\n206|\treturn nil\n207|}\n208|\n209|// checkManifestOperations requires the ordered registry Section 7.5\n210|// shows with no duplicates: the manifest must name exactly what the\n211|// host can dispatch, in the order the manifest order defines.\n212|func checkManifestOperations(raw json.RawMessage) error {\n213|\toperations, ok := rawStringArray(raw)\n214|\tif !ok || len(operations) != len(operationOrder) {\n215|\t\tfailure, err := failProtocol(\"manifest operations differ from the registry\", \"operations\")\n216|\t\tif err != nil {\n217|\t\t\treturn err\n218|\t\t}\n219|\t\treturn failure\n220|\t}\n221|\tfor index, operation := range operationOrder {\n222|\t\tif operations[index] != string(operation) {\n223|\t\t\tfailure, err := failProtocol(\"manifest operations differ from the registry\", \"operations\")\n224|\t\t\tif err != nil {\n225|\t\t\t\treturn err\n226|\t\t\t}\n227|\t\t\treturn failure\n228|\t\t}\n229|\t}\n230|\treturn nil\n231|}\n232|\n233|// checkManifestCapabilities requires the exact seven-name ordered\n234|// registry: no eighth advertised surface, no hidden one.\n235|func checkManifestCapabilities(raw json.RawMessage) error {\n236|\tnames, ok := rawStringArray(raw)\n237|\tif !ok || len(names) != len(capabilityOrder) {\n238|\t\tfailure, err := failProtocol(\"manifest capability_names differ from the registry\", \"capability_names\")\n239|\t\tif err != nil {\n240|\t\t\treturn err\n241|\t\t}\n242|\t\treturn failure\n243|\t}\n244|\tfor index, name := range capabilityOrder {\n245|\t\tif names[index] != name {\n246|\t\t\tfailure, err := failProtocol(\"manifest capability_names differ from the registry\", \"capability_names\")\n247|\t\t\tif err != nil {\n248|\t\t\t\treturn err\n249|\t\t\t}\n250|\t\t\treturn failure\n251|\t\t}\n252|\t}\n253|\treturn nil\n254|}"}}}
