{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68d","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":417,"recorded_at":1780531400000829,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffed02b7e8381a8a1a9ff61e82e","text":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|\n20|// identitySchema is the exact schema identifier the record carries.\n21|const identitySchema = \"urn:ax:schema:provider-identity\"\n22|\n23|// identitySchemaVersion is the only identity version accepted.\n24|const identitySchemaVersion = \"1.0.0\"\n25|\n26|// identityKinds is the closed identity-kind enum in section order.\n27|var identityKinds = []string{\n28|\t\"session_uuid\",\n29|\t\"session_path_or_id\",\n30|\t\"backend_conversation_uuid\",\n31|\t\"task_board_managed\",\n32|\t\"provider_defined\",\n33|}\n34|\n35|// identityMembers is the exact required member set of a Provider\n36|// Identity Record.\n37|var identityMembers = map[string]bool{\n38|\t\"schema\":                    true,\n39|\t\"schema_version\":            true,\n40|\t\"record_id\":                 true,\n41|\t\"subject_id\":                true,\n42|\t\"session_id\":                true,\n43|\t\"provider_id\":               true,\n44|\t\"provider_version\":          true,\n45|\t\"provider_version_range\":    true,\n46|\t\"native_session_id\":         true,\n47|\t\"identity_kind\":             true,\n48|\t\"logical_workspace_id\":      true,\n49|\t\"backend_realm_fingerprint\": true,\n50|\t\"opaque_identity\":           true,\n51|\t\"created_by_host_id\":        true,\n52|\t\"created_at\":                true,\n53|\t\"extensions\":                true,\n54|}\n55|\n56|// identityRequired lists identityMembers in a fixed order so a record\n57|// missing several members always names the same one.\n58|var identityRequired = []string{\n59|\t\"schema\",\n60|\t\"schema_version\",\n61|\t\"record_id\",\n62|\t\"subject_id\",\n63|\t\"session_id\",\n64|\t\"provider_id\",\n65|\t\"provider_version\",\n66|\t\"provider_version_range\",\n67|\t\"native_session_id\",\n68|\t\"identity_kind\",\n69|\t\"logical_workspace_id\",\n70|\t\"backend_realm_fingerprint\",\n71|\t\"opaque_identity\",\n72|\t\"created_by_host_id\",\n73|\t\"created_at\",\n74|\t\"extensions\",\n75|}\n76|\n77|// identityKeyPattern is the provider-identity key grammar Section 5.5\n78|// states: [a-z][a-z0-9_.-]{0,63}.\n79|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n80|\n81|// windowsDrivePattern matches a Windows drive-qualified absolute\n82|// prefix: a letter, a colon, and a separator.\n83|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n84|\n85|// CheckIdentity validates one Provider Identity Record naming the\n86|// expected provider. Shape violations are provider_protocol_errors;\n87|// a well-formed record for another provider is an invalid_config\n88|// caller error: the caller correlated the wrong identity to this\n89|// session.\n90|func CheckIdentity(body []byte, wantProviderID string) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, identityRequired); missing {\n107|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n114|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n121|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n128|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tsubject, ok := rawString(members[\"subject_id\"])\n135|\tif !ok || !isUUIDv7(subject) {\n136|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n137|\t\tif err != nil {\n138|\t\t\treturn err\n139|\t\t}\n140|\t\treturn failure\n141|\t}\n142|\tsession, ok := rawString(members[\"session_id\"])\n143|\tif !ok || !isUUIDv7(session) {\n144|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n145|\t\tif err != nil {\n146|\t\t\treturn err\n147|\t\t}\n148|\t\treturn failure\n149|\t}\n150|\tif subject != session {\n151|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n152|\t\tif err != nil {\n153|\t\t\treturn err\n154|\t\t}\n155|\t\treturn failure\n156|\t}\n157|\tprovider, ok := rawString(members[\"provider_id\"])\n158|\tif !ok || !validProviderID(provider) {\n159|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\treturn failure\n164|\t}\n165|\tif provider != wantProviderID {\n166|\t\tfailure, err := failInvalid(\"identity names another provider\")\n167|\t\tif err != nil {\n168|\t\t\treturn err\n169|\t\t}\n170|\t\treturn failure\n171|\t}\n172|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n173|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n174|\t\tif err != nil {\n175|\t\t\treturn err\n176|\t\t}\n177|\t\treturn failure\n178|\t}\n179|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n180|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n187|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\treturn failure\n192|\t}\n193|\tkind, ok := rawString(members[\"identity_kind\"])\n194|\tif !ok || !isIdentityKind(kind) {\n195|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n196|\t\tif err != nil {\n197|\t\t\treturn err\n198|\t\t}\n199|\t\treturn failure\n200|\t}\n201|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n202|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\treturn failure\n207|\t}\n208|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n215|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n216|\t\tif err != nil {\n217|\t\t\treturn err\n218|\t\t}\n219|\t\treturn failure\n220|\t}\n221|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n222|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n223|\t\tif err != nil {\n224|\t\t\treturn err\n225|\t\t}\n226|\t\treturn failure\n227|\t}\n228|\tif !isJSONObject(members[\"extensions\"]) {\n229|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n230|\t\tif err != nil {\n231|\t\t\treturn err\n232|\t\t}\n233|\t\treturn failure\n234|\t}\n235|\treturn nil\n236|}\n237|\n238|// checkIdentityRealm enforces the digest-or-null shape and the one\n239|// conditional rule Section 5.5 states: an Antigravity\n240|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n241|// because the backend realm is a resume precondition there.\n242|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n243|\trealm, isNull, ok := rawNullableString(raw)\n244|\tif !ok || (!isNull && !isDigest(realm)) {\n245|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n246|\t\tif err != nil {\n247|\t\t\treturn err\n248|\t\t}\n249|\t\treturn failure\n250|\t}\n251|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n252|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n253|\t\tif err != nil {\n254|\t\t\treturn err\n255|\t\t}\n256|\t\treturn failure\n257|\t}\n258|\treturn nil\n259|}\n260|\n261|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n262|// object of at most 32 entries, keyed by the provider-identity key\n263|// grammar, with non-secret string values of 1..1,024 characters that\n264|// MUST NOT begin with an absolute path.\n265|func checkIdentityOpaque(raw json.RawMessage) error {\n266|\topaque, fault := decodeStrictObject(raw)\n267|\tif fault != nil {\n268|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n269|\t\tif err != nil {\n270|\t\t\treturn err\n271|\t\t}\n272|\t\treturn failure\n273|\t}\n274|\tif len(opaque) > 32 {\n275|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n276|\t\tif err != nil {\n277|\t\t\treturn err\n278|\t\t}\n279|\t\treturn failure\n280|\t}\n281|\tkeys := make([]string, 0, len(opaque))\n282|\tfor key := range opaque {\n283|\t\tkeys = append(keys, key)\n284|\t}\n285|\tfor _, key := range keys {\n286|\t\tif !identityKeyPattern.MatchString(key) {\n287|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n288|\t\t\tif err != nil {\n289|\t\t\t\treturn err\n290|\t\t\t}\n291|\t\t\treturn failure\n292|\t\t}\n293|\t\tvalue, ok := rawString(opaque[key])\n294|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n295|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n296|\t\t\tif err != nil {\n297|\t\t\t\treturn err\n298|\t\t\t}\n299|\t\t\treturn failure\n300|\t\t}\n301|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n302|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n303|\t\t\tif err != nil {\n304|\t\t\t\treturn err\n305|\t\t\t}\n306|\t\t\treturn failure\n307|\t\t}\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|func isIdentityKind(value string) bool {\n313|\tfor _, kind := range identityKinds {\n314|\t\tif value == kind {\n315|\t\t\treturn true\n316|\t\t}\n317|\t}\n318|\treturn false\n319|}\n320|\n321|// identifyMembers is the exact required member set of an\n322|// identify-session success body.\n323|var identifyMembers = map[string]bool{\n324|\t\"identity\":         true,\n325|\t\"confidence\":       true,\n326|\t\"matched_evidence\": true,\n327|}\n328|\n329|// identifyRequired lists identifyMembers in a fixed order.\n330|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n331|\n332|// identifyConfidences is the closed confidence vocabulary.\n333|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n334|\n335|// identifyEvidence is the closed matched-evidence vocabulary.\n336|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n337|\n338|// DecodeIdentifyResult validates one identify-session success body:\n339|// the Provider Identity Record for the expected provider, a closed\n340|// confidence, and 1..4 sorted unique matched-evidence members.\n341|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n342|\tmembers, fault := decodeStrictObject(body)\n343|\tif fault != nil {\n344|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n345|\t\tif err != nil {\n346|\t\t\treturn err\n347|\t\t}\n348|\t\treturn failure\n349|\t}\n350|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n351|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n352|\t\tif err != nil {\n353|\t\t\treturn err\n354|\t\t}\n355|\t\treturn failure\n356|\t}\n357|\tif name, missing := missingMember(members, identifyRequired); missing {\n358|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n359|\t\tif err != nil {\n360|\t\t\treturn err\n361|\t\t}\n362|\t\treturn failure\n363|\t}\n364|\tconfidence, ok := rawString(members[\"confidence\"])\n365|\tif !ok || !isIdentifyConfidence(confidence) {\n366|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n367|\t\tif err != nil {\n368|\t\t\treturn err\n369|\t\t}\n370|\t\treturn failure\n371|\t}\n372|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n373|\t\treturn err\n374|\t}\n375|\tif !isJSONObject(members[\"identity\"]) {\n376|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n377|\t\tif err != nil {\n378|\t\t\treturn err\n379|\t\t}\n380|\t\treturn failure\n381|\t}\n382|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n383|\t\treturn err\n384|\t}\n385|\treturn nil\n386|}\n387|\n388|func isIdentifyConfidence(value string) bool {\n389|\tfor _, confidence := range identifyConfidences {\n390|\t\tif value == confidence {\n391|\t\t\treturn true\n392|\t\t}\n393|\t}\n394|\treturn false\n395|}\n396|\n397|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n398|// evidence members: the observation must cite what matched, exactly\n399|// once each.\n400|func checkIdentifyEvidence(raw json.RawMessage) error {\n401|\tevidence, ok := rawStringArray(raw)\n402|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n403|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n404|\t\tif err != nil {\n405|\t\t\treturn err\n406|\t\t}\n407|\t\treturn failure\n408|\t}\n409|\tallowed := map[string]bool{}\n410|\tfor _, member := range identifyEvidence {\n411|\t\tallowed[member] = true\n412|\t}\n413|\tfor _, member := range evidence {\n414|\t\tif !allowed[member] {\n415|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n416|\t\t\tif err != nil {\n417|\t\t\t\treturn err\n418|\t\t\t}\n419|\t\t\treturn failure\n420|\t\t}\n421|\t}\n422|\tif !sortedUniqueStrings(evidence) {\n423|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n424|\t\tif err != nil {\n425|\t\t\treturn err\n426|\t\t}\n427|\t\treturn failure\n428|\t}\n429|\treturn nil\n430|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68f","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":418,"recorded_at":1780531400000831,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffed11d7d42bbe5f2786ec03ba9","text":"Read text file `internal/provhost/quiesce.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the SafeBoundaryProof a quiesce operation\n8|// returns as its success body (Section 7.5 row, Section 7.6 rules). A\n9|// safe proof requires empty blockers, input_blocked, foreground_idle,\n10|// background_idle true, both counts zero, and non-null boundary and\n11|// store generation. If background idleness, process exit, or store\n12|// closure cannot be proven, safe MUST be false and graceful takeover\n13|// MUST stop; the plugin MUST NOT silently convert the request. An\n14|// unsafe proof is an honest observation and validates; only a safe\n15|// claim over unproven facts is refused.\n16|\n17|// quiesceBlockers is the closed blocker enum Section 7.5 defines.\n18|var quiesceBlockers = []string{\n19|\t\"background_unproven\",\n20|\t\"child_process_open\",\n21|\t\"database_handle_open\",\n22|\t\"provider_busy\",\n23|\t\"store_unstable\",\n24|}\n25|\n26|// quiesceMembers is the exact required member set of a\n27|// SafeBoundaryProof.\n28|var quiesceMembers = map[string]bool{\n29|\t\"provider_id\":                true,\n30|\t\"provider_version\":           true,\n31|\t\"input_blocked\":              true,\n32|\t\"boundary_ref\":               true,\n33|\t\"foreground_idle\":            true,\n34|\t\"background_idle\":            true,\n35|\t\"open_child_count\":           true,\n36|\t\"open_database_handle_count\": true,\n37|\t\"store_generation\":           true,\n38|\t\"safe\":                       true,\n39|\t\"blockers\":                   true,\n40|}\n41|\n42|// quiesceRequired lists quiesceMembers in a fixed order so a proof\n43|// missing several members always names the same one.\n44|var quiesceRequired = []string{\n45|\t\"provider_id\",\n46|\t\"provider_version\",\n47|\t\"input_blocked\",\n48|\t\"boundary_ref\",\n49|\t\"foreground_idle\",\n50|\t\"background_idle\",\n51|\t\"open_child_count\",\n52|\t\"open_database_handle_count\",\n53|\t\"store_generation\",\n54|\t\"safe\",\n55|\t\"blockers\",\n56|}\n57|\n58|// DecodeQuiesceProof validates one quiesce-operation success body as a\n59|// SafeBoundaryProof. It returns the observed safe bit on an honest\n60|// proof — safe with every fact proven, or unsafe — and a\n61|// provider_protocol_error naming the offending member on any\n62|// malformed proof or any safe claim over unproven facts. The caller\n63|// stops graceful takeover on safe false; the proof itself never\n64|// converts the request.\n65|func DecodeQuiesceProof(body []byte) (bool, error) {\n66|\tmembers, fault := decodeStrictObject(body)\n67|\tif fault != nil {\n68|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n69|\t\tif err != nil {\n70|\t\t\treturn false, err\n71|\t\t}\n72|\t\treturn false, failure\n73|\t}\n74|\tif name, unknown := unknownMember(members, quiesceMembers); unknown {\n75|\t\tfailure, err := failProtocol(\"quiesce proof carries unknown member\", name)\n76|\t\tif err != nil {\n77|\t\t\treturn false, err\n78|\t\t}\n79|\t\treturn false, failure\n80|\t}\n81|\tif name, missing := missingMember(members, quiesceRequired); missing {\n82|\t\tfailure, err := failProtocol(\"quiesce proof misses a required member\", name)\n83|\t\tif err != nil {\n84|\t\t\treturn false, err\n85|\t\t}\n86|\t\treturn false, failure\n87|\t}\n88|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n89|\t\tfailure, err := failProtocol(\"quiesce provider_id is not a provider id\", \"provider_id\")\n90|\t\tif err != nil {\n91|\t\t\treturn false, err\n92|\t\t}\n93|\t\treturn false, failure\n94|\t}\n95|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n96|\t\tfailure, err := failProtocol(\"quiesce provider_version is not 1..128 characters\", \"provider_version\")\n97|\t\tif err != nil {\n98|\t\t\treturn false, err\n99|\t\t}\n100|\t\treturn false, failure\n101|\t}\n102|\tinputBlocked, ok := rawBool(members[\"input_blocked\"])\n103|\tif !ok {\n104|\t\tfailure, err := failProtocol(\"quiesce input_blocked is not a boolean\", \"input_blocked\")\n105|\t\tif err != nil {\n106|\t\t\treturn false, err\n107|\t\t}\n108|\t\treturn false, failure\n109|\t}\n110|\tforegroundIdle, ok := rawBool(members[\"foreground_idle\"])\n111|\tif !ok {\n112|\t\tfailure, err := failProtocol(\"quiesce foreground_idle is not a boolean\", \"foreground_idle\")\n113|\t\tif err != nil {\n114|\t\t\treturn false, err\n115|\t\t}\n116|\t\treturn false, failure\n117|\t}\n118|\tsafe, ok := rawBool(members[\"safe\"])\n119|\tif !ok {\n120|\t\tfailure, err := failProtocol(\"quiesce safe is not a boolean\", \"safe\")\n121|\t\tif err != nil {\n122|\t\t\treturn false, err\n123|\t\t}\n124|\t\treturn false, failure\n125|\t}\n126|\tboundaryNull, generationNull, background, backgroundNull, err := checkQuiesceNullable(members)\n127|\tif err != nil {\n128|\t\treturn false, err\n129|\t}\n130|\tchildCount, databaseCount, err := checkQuiesceCounts(members)\n131|\tif err != nil {\n132|\t\treturn false, err\n133|\t}\n134|\tblockers, err := checkQuiesceBlockers(members[\"blockers\"])\n135|\tif err != nil {\n136|\t\treturn false, err\n137|\t}\n138|\t// A safe claim over unproven facts is the one lie Section 7.6\n139|\t// names: every conjunct below carries a fixture with only it\n140|\t// violated, except backgroundNull, which rawNullableBool folds\n141|\t// into !background (null reads as false), so no fixture can\n142|\t// isolate it. Narrowing any other conjunct reddens its fixture.\n143|\tif safe {\n144|\t\tif len(blockers) != 0 || !inputBlocked || !foregroundIdle || backgroundNull || !background || boundaryNull || generationNull || childCount != 0 || databaseCount != 0 {\n145|\t\t\tfailure, fault := failProtocol(\"quiesce safe proof leaves a fact unproven\", \"safe\")\n146|\t\t\tif fault != nil {\n147|\t\t\t\treturn false, fault\n148|\t\t\t}\n149|\t\t\treturn false, failure\n150|\t\t}\n151|\t}\n152|\treturn safe, nil\n153|}\n154|\n155|// rawNullableBool reads a JSON boolean-or-null member.\n156|func rawNullableBool(raw json.RawMessage) (value bool, isNull bool, ok bool) {\n157|\tif string(raw) == \"null\" {\n158|\t\treturn false, true, true\n159|\t}\n160|\tvalue, ok = rawBool(raw)\n161|\treturn value, false, ok\n162|}\n163|\n164|// checkQuiesceNullable enforces the nullability shapes outside the\n165|// safe rule: boundary_ref is string[1..1024] or null, and\n166|// store_generation is string[1..512] or null. Length is checked here\n167|// so the safe rule only decides null against non-null, and the parsed\n168|// null flags and background value are returned for that rule.\n169|func checkQuiesceNullable(members map[string]json.RawMessage) (boundaryNull bool, generationNull bool, background bool, backgroundNull bool, err error) {\n170|\tfail := func(failure error) (bool, bool, bool, bool, error) {\n171|\t\treturn false, false, false, false, failure\n172|\t}\n173|\tboundary, boundaryIsNull, ok := rawNullableString(members[\"boundary_ref\"])\n174|\tif !ok || (!boundaryIsNull && (runeLength(boundary) < 1 || runeLength(boundary) > 1024)) {\n175|\t\tfailure, fault := failProtocol(\"quiesce boundary_ref is not 1..1024 characters or null\", \"boundary_ref\")\n176|\t\tif fault != nil {\n177|\t\t\treturn fail(fault)\n178|\t\t}\n179|\t\treturn fail(failure)\n180|\t}\n181|\tgeneration, generationIsNull, ok := rawNullableString(members[\"store_generation\"])\n182|\tif !ok || (!generationIsNull && (runeLength(generation) < 1 || runeLength(generation) > 512)) {\n183|\t\tfailure, fault := failProtocol(\"quiesce store_generation is not 1..512 characters or null\", \"store_generation\")\n184|\t\tif fault != nil {\n185|\t\t\treturn fail(fault)\n186|\t\t}\n187|\t\treturn fail(failure)\n188|\t}\n189|\tbackground, backgroundNull, ok = rawNullableBool(members[\"background_idle\"])\n190|\tif !ok {\n191|\t\tfailure, fault := failProtocol(\"quiesce background_idle is not a boolean or null\", \"background_idle\")\n192|\t\tif fault != nil {\n193|\t\t\treturn fail(fault)\n194|\t\t}\n195|\t\treturn fail(failure)\n196|\t}\n197|\treturn boundaryIsNull, generationIsNull, background, backgroundNull, nil\n198|}\n199|\n200|// checkQuiesceCounts requires both handle counts as uint53 and\n201|// returns them for the safe rule: a safe proof with either count\n202|// open claims idleness it does not have.\n203|func checkQuiesceCounts(members map[string]json.RawMessage) (uint64, uint64, error) {\n204|\tcounts := make([]uint64, 0, 2)\n205|\tfor _, name := range []string{\"open_child_count\", \"open_database_handle_count\"} {\n206|\t\tcount, ok := rawUint53(members[name])\n207|\t\tif !ok {\n208|\t\t\tfailure, err := failProtocol(\"quiesce count is not a uint53\", name)\n209|\t\t\tif err != nil {\n210|\t\t\t\treturn 0, 0, err\n211|\t\t\t}\n212|\t\t\treturn 0, 0, failure\n213|\t\t}\n214|\t\tcounts = append(counts, count)\n215|\t}\n216|\treturn counts[0], counts[1], nil\n217|}\n218|\n219|// checkQuiesceBlockers requires the sorted unique closed-enum array of\n220|// at most five blockers and returns it for the safe rule.\n221|func checkQuiesceBlockers(raw json.RawMessage) ([]string, error) {\n222|\tblockers, ok := rawStringArray(raw)\n223|\tif !ok || len(blockers) > 5 {\n224|\t\tfailure, err := failProtocol(\"quiesce blockers exceed 5 entries\", \"blockers\")\n225|\t\tif err != nil {\n226|\t\t\treturn nil, err\n227|\t\t}\n228|\t\treturn nil, failure\n229|\t}\n230|\tallowed := map[string]bool{}\n231|\tfor _, blocker := range quiesceBlockers {\n232|\t\tallowed[blocker] = true\n233|\t}\n234|\tfor _, blocker := range blockers {\n235|\t\tif !allowed[blocker] {\n236|\t\t\tfailure, err := failProtocol(\"quiesce blockers name an unknown blocker\", \"blockers\")\n237|\t\t\tif err != nil {\n238|\t\t\t\treturn nil, err\n239|\t\t\t}\n240|\t\t\treturn nil, failure\n241|\t\t}\n242|\t}\n243|\tif !sortedUniqueStrings(blockers) {\n244|\t\tfailure, err := failProtocol(\"quiesce blockers are not sorted unique\", \"blockers\")\n245|\t\tif err != nil {\n246|\t\t\treturn nil, err\n247|\t\t}\n248|\t\treturn nil, failure\n249|\t}\n250|\treturn blockers, nil\n251|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c691","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":419,"recorded_at":1780531400000833,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffed20d7283a000b7cffc30f7c2","text":"Read text file `internal/provhost/spawn.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the SpawnPlan a launch or resume operation\n11|// returns as its success body (Section 7.5 rows). The trusted\n12|// terminal backend performs process creation from this plan, so the\n13|// plan MUST NOT carry secret environment values, and its\n14|// profile_mapping MUST equal the Section 7.7 mapping for the calling\n15|// provider and profile. Literal secrecy is structural, not\n16|// content-admitted: values are bounded and disjoint from inherited\n17|// names, and the host never logs bodies; no content inspection could\n18|// prove a literal non-secret, so none is attempted.\n19|\n20|// spawnMembers is the exact required member set of a SpawnPlan.\n21|var spawnMembers = map[string]bool{\n22|\t\"argv\":              true,\n23|\t\"cwd\":               true,\n24|\t\"env_names\":         true,\n25|\t\"env_literals\":      true,\n26|\t\"native_session_id\": true,\n27|\t\"profile_mapping\":   true,\n28|\t\"extensions\":        true,\n29|}\n30|\n31|// spawnRequired lists spawnMembers in a fixed order so a plan missing\n32|// several members always names the same one.\n33|var spawnRequired = []string{\n34|\t\"argv\",\n35|\t\"cwd\",\n36|\t\"env_names\",\n37|\t\"env_literals\",\n38|\t\"native_session_id\",\n39|\t\"profile_mapping\",\n40|\t\"extensions\",\n41|}\n42|\n43|// maxSpawnArgvBytes bounds the total encoded argv Section 5.1 states.\n44|const maxSpawnArgvBytes = 65536\n45|\n46|// DecodeSpawnPlan validates one launch- or resume-operation success\n47|// body as a SpawnPlan for the calling provider under the calling\n48|// profile on the destination platform. It returns nil on a\n49|// well-formed plan and a refusal naming the offending member\n50|// otherwise: a provider_protocol_error for a malformed plan, and an\n51|// invalid_config caller error when the caller names an unknown\n52|// provider or profile for the mapping check.\n53|func DecodeSpawnPlan(body []byte, providerID, profile string, platform scalar.Platform) error {\n54|\tmembers, fault := decodeStrictObject(body)\n55|\tif fault != nil {\n56|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n57|\t\tif err != nil {\n58|\t\t\treturn err\n59|\t\t}\n60|\t\treturn failure\n61|\t}\n62|\tif name, unknown := unknownMember(members, spawnMembers); unknown {\n63|\t\tfailure, err := failProtocol(\"spawn plan carries unknown member\", name)\n64|\t\tif err != nil {\n65|\t\t\treturn err\n66|\t\t}\n67|\t\treturn failure\n68|\t}\n69|\tif name, missing := missingMember(members, spawnRequired); missing {\n70|\t\tfailure, err := failProtocol(\"spawn plan misses a required member\", name)\n71|\t\tif err != nil {\n72|\t\t\treturn err\n73|\t\t}\n74|\t\treturn failure\n75|\t}\n76|\tif err := checkSpawnArgv(members[\"argv\"]); err != nil {\n77|\t\treturn err\n78|\t}\n79|\tif cwd, ok := rawString(members[\"cwd\"]); !ok || !isAbsoluteOn(cwd, platform) {\n80|\t\tfailure, err := failProtocol(\"spawn cwd is not an absolute path\", \"cwd\")\n81|\t\tif err != nil {\n82|\t\t\treturn err\n83|\t\t}\n84|\t\treturn failure\n85|\t}\n86|\tnames, err := checkSpawnEnvNames(members[\"env_names\"])\n87|\tif err != nil {\n88|\t\treturn err\n89|\t}\n90|\tif err := checkSpawnEnvLiterals(members[\"env_literals\"], names); err != nil {\n91|\t\treturn err\n92|\t}\n93|\tif _, isNull, ok := rawNullableString(members[\"native_session_id\"]); !ok || (!isNull && !isBoundedString(members[\"native_session_id\"], 1, 512)) {\n94|\t\tfailure, err := failProtocol(\"spawn native_session_id is not 1..512 characters or null\", \"native_session_id\")\n95|\t\tif err != nil {\n96|\t\t\treturn err\n97|\t\t}\n98|\t\treturn failure\n99|\t}\n100|\tif err := checkSpawnProfileMapping(members[\"profile_mapping\"], providerID, profile); err != nil {\n101|\t\treturn err\n102|\t}\n103|\tif !isJSONObject(members[\"extensions\"]) {\n104|\t\tfailure, err := failProtocol(\"spawn extensions is not an object\", \"extensions\")\n105|\t\tif err != nil {\n106|\t\t\treturn err\n107|\t\t}\n108|\t\treturn failure\n109|\t}\n110|\treturn nil\n111|}\n112|\n113|// isAbsoluteOn reports whether the path is absolute on the\n114|// destination platform. Destination-native is the Section 7.5 rule;\n115|// the platform arrives from the caller because the plan carries none.\n116|func isAbsoluteOn(path string, platform scalar.Platform) bool {\n117|\t_, err := scalar.ParseAbsolutePath(platform, path)\n118|\treturn err == nil\n119|}\n120|\n121|// isBoundedString reports whether the raw JSON string counts 1..max\n122|// Unicode characters. The caller already established it is a string.\n123|func isBoundedString(raw json.RawMessage, min, max int) bool {\n124|\tvalue, ok := rawString(raw)\n125|\tif !ok {\n126|\t\treturn false\n127|\t}\n128|\tlength := runeLength(value)\n129|\treturn length >= min && length <= max\n130|}\n131|\n132|// checkSpawnArgv enforces the Section 5.1 argv limits: 1..128\n133|// elements, each a NUL-free string of 1..4,096 bytes, 65,536 bytes\n134|// total. Byte length is the exec-bound quantity, so elements count\n135|// bytes here while the character-bounded members count runes.\n136|func checkSpawnArgv(raw json.RawMessage) error {\n137|\telements, ok := rawArray(raw)\n138|\tif !ok || len(elements) == 0 || len(elements) > 128 {\n139|\t\tfailure, err := failProtocol(\"spawn argv is empty or longer than 128\", \"argv\")\n140|\t\tif err != nil {\n141|\t\t\treturn err\n142|\t\t}\n143|\t\treturn failure\n144|\t}\n145|\ttotal := 0\n146|\tfor _, element := range elements {\n147|\t\tvalue, ok := rawString(element)\n148|\t\tif !ok || len(value) < 1 || len(value) > 4096 || strings.ContainsRune(value, 0) {\n149|\t\t\tfailure, err := failProtocol(\"spawn argv element is not 1..4096 NUL-free bytes\", \"argv\")\n150|\t\t\tif err != nil {\n151|\t\t\t\treturn err\n152|\t\t\t}\n153|\t\t\treturn failure\n154|\t\t}\n155|\t\ttotal += len(value)\n156|\t}\n157|\tif total > maxSpawnArgvBytes {\n158|\t\tfailure, err := failProtocol(\"spawn argv exceeds 65536 bytes total\", \"argv\")\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\treturn failure\n163|\t}\n164|\treturn nil\n165|}\n166|\n167|// validEnvName reports whether the name satisfies the Section 5.1\n168|// environment-name grammar: [A-Za-z_][A-Za-z0-9_]{0,127}.\n169|func validEnvName(name string) bool {\n170|\tif len(name) < 1 || len(name) > 128 {\n171|\t\treturn false\n172|\t}\n173|\tfor index := 0; index < len(name); index++ {\n174|\t\tchar := name[index]\n175|\t\tvalid := char == '_' || char >= 'A' && char <= 'Z' || char >= 'a' && char <= 'z' || index > 0 && char >= '0' && char <= '9'\n176|\t\tif !valid {\n177|\t\t\treturn false\n178|\t\t}\n179|\t}\n180|\treturn true\n181|}\n182|\n183|// checkSpawnEnvNames enforces sorted unique environment names\n184|// [0..64] and returns them for the disjointness check.\n185|func checkSpawnEnvNames(raw json.RawMessage) ([]string, error) {\n186|\tnames, ok := rawStringArray(raw)\n187|\tif !ok || len(names) > 64 {\n188|\t\tfailure, err := failProtocol(\"spawn env_names exceed 64 entries\", \"env_names\")\n189|\t\tif err != nil {\n190|\t\t\treturn nil, err\n191|\t\t}\n192|\t\treturn nil, failure\n193|\t}\n194|\tfor _, name := range names {\n195|\t\tif !validEnvName(name) {\n196|\t\t\tfailure, err := failProtocol(\"spawn env_names are not environment names\", \"env_names\")\n197|\t\t\tif err != nil {\n198|\t\t\t\treturn nil, err\n199|\t\t\t}\n200|\t\t\treturn nil, failure\n201|\t\t}\n202|\t}\n203|\tif !sortedUniqueStrings(names) {\n204|\t\tfailure, err := failProtocol(\"spawn env_names are not sorted unique\", \"env_names\")\n205|\t\tif err != nil {\n206|\t\t\treturn nil, err\n207|\t\t}\n208|\t\treturn nil, failure\n209|\t}\n210|\treturn names, nil\n211|}\n212|\n213|// checkSpawnEnvLiterals enforces the literal map: at most 64\n214|// entries, environment-name keys disjoint from env_names, string\n215|// values of at most 4,096 bytes. Keys sort in canonical form on the\n216|// wire; the host reads the set, so order is not rechecked here.\n217|func checkSpawnEnvLiterals(raw json.RawMessage, names []string) error {\n218|\tliterals, fault := decodeStrictObject(raw)\n219|\tif fault != nil {\n220|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\treturn failure\n225|\t}\n226|\tif len(literals) > 64 {\n227|\t\tfailure, err := failProtocol(\"spawn env_literals exceed 64 entries\", \"env_literals\")\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\tinherited := map[string]bool{}\n234|\tfor _, name := range names {\n235|\t\tinherited[name] = true\n236|\t}\n237|\tfor key, value := range literals {\n238|\t\tif !validEnvName(key) || inherited[key] {\n239|\t\t\tfailure, err := failProtocol(\"spawn env_literal key is not disjoint\", \"env_literals\")\n240|\t\t\tif err != nil {\n241|\t\t\t\treturn err\n242|\t\t\t}\n243|\t\t\treturn failure\n244|\t\t}\n245|\t\ttext, ok := rawString(value)\n246|\t\tif !ok || len(text) > 4096 || strings.ContainsRune(text, 0) {\n247|\t\t\tfailure, err := failProtocol(\"spawn env_literal is not at most 4096 NUL-free bytes\", \"env_literals\")\n248|\t\t\tif err != nil {\n249|\t\t\t\treturn err\n250|\t\t\t}\n251|\t\t\treturn failure\n252|\t\t}\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|// checkSpawnProfileMapping requires profile_mapping to equal the\n258|// Section 7.7 mapping for the calling provider and profile. A\n259|// provider that answers yolo with the standard omission, or standard\n260|// with a yolo flag, fails here rather than executing under the wrong\n261|// sandbox. Unknown providers and profiles are caller errors that\n262|// propagate from the mapping table.\n263|func checkSpawnProfileMapping(raw json.RawMessage, providerID, profile string) error {\n264|\tmapping, ok := rawString(raw)\n265|\tif !ok || runeLength(mapping) > 512 {\n266|\t\tfailure, err := failProtocol(\"spawn profile_mapping is not at most 512 characters\", \"profile_mapping\")\n267|\t\tif err != nil {\n268|\t\t\treturn err\n269|\t\t}\n270|\t\treturn failure\n271|\t}\n272|\twant, err := ProfileMapping(providerID, profile)\n273|\tif err != nil {\n274|\t\treturn err\n275|\t}\n276|\tif mapping != want {\n277|\t\tfailure, fault := failProtocol(\"spawn profile_mapping does not match the provider profile\", \"profile_mapping\")\n278|\t\tif fault != nil {\n279|\t\t\treturn fault\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\treturn nil\n284|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c693","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":420,"recorded_at":1780531400000835,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffed2f27f41a04fb29c122eeba0","text":"Read text file `internal/provhost/status.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/base64\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// StatusState is the reconciled durable state of a materialization\n11|// transaction. Unknown is fail-closed: the host must quarantine the\n12|// transaction root rather than infer prepare or commit.\n13|type StatusState string\n14|\n15|// ProviderTransactionStatus states Section 7.5 defines.\n16|const (\n17|\tStatusUnknown    StatusState = \"unknown\"\n18|\tStatusPrepared   StatusState = \"prepared\"\n19|\tStatusCommitted  StatusState = \"committed\"\n20|\tStatusRolledBack StatusState = \"rolled_back\"\n21|)\n22|\n23|// validStatusState reports whether the state is a registry member.\n24|func validStatusState(state string) bool {\n25|\tswitch StatusState(state) {\n26|\tcase StatusUnknown, StatusPrepared, StatusCommitted, StatusRolledBack:\n27|\t\treturn true\n28|\t}\n29|\treturn false\n30|}\n31|\n32|// StatusIDs identifies the transaction a status read must describe: the\n33|// caller-supplied materialization and transaction IDs and the exact\n34|// transaction authority the request located it through. A status naming\n35|// any other transaction is not this transaction's durable state.\n36|type StatusIDs struct {\n37|\tMaterializationID      string\n38|\tTransactionID          string\n39|\tTransactionAuthorityID string\n40|}\n41|\n42|// statusBodyMembers is the exact member set DecodeStatusOutcome accepts:\n43|// the ProviderTransactionStatus row of Section 7.5, where operation_id is\n44|// the mutation key the status request omits. A well-formed operation_id is\n45|// ignored — it is not this read's identity — but a malformed one makes\n46|// the observation integrity-invalid, as does any unknown member.\n47|var statusBodyMembers = map[string]bool{\n48|\t\"operation_id\":             true,\n49|\t\"materialization_id\":       true,\n50|\t\"transaction_id\":           true,\n51|\t\"transaction_authority_id\": true,\n52|\t\"plan_id\":                  true,\n53|\t\"state\":                    true,\n54|\t\"rollback_token\":           true,\n55|\t\"native_discovery\":         true,\n56|}\n57|\n58|// DecodeStatusOutcome reconciles one materialize-status success body to\n59|// the current durable state. It enforces the Section 7.5 recovery rules:\n60|// unknown requires null plan, token, and discovery; prepared requires all\n61|// three non-null; committed and rolled_back require a non-null plan and\n62|// discovery with a null token. Identity members must equal the requested\n63|// transaction.\n64|//\n65|// Every uninterpretable observation fails with integrity_failure,\n66|// including a state of unknown: the caller must quarantine the\n67|// transaction root and must not infer success. Status reads are evolving\n68|// observations, so no byte-identical replay rule applies: the same\n69|// transaction may report prepared under one envelope request_id and\n70|// committed under the next, and both readings are returned as-is.\n71|//\n72|// Only the charset and length of a rollback token are checked here (at\n73|// least 256 bits of base64url); its entropy is not observable. The shapes\n74|// of native_discovery and plan contents belong to the operation layer.\n75|func DecodeStatusOutcome(body []byte, want StatusIDs) (StatusState, error) {\n76|\tintegrity := func(detail string, state string) (StatusState, error) {\n77|\t\tfailure, err := failIntegrity(detail, state, want.MaterializationID, want.TransactionID)\n78|\t\tif err != nil {\n79|\t\t\treturn \"\", err\n80|\t\t}\n81|\t\treturn \"\", failure\n82|\t}\n83|\tmembers, fault := decodeStrictObject(body)\n84|\tif fault != nil {\n85|\t\treturn integrity(\"status body is \"+fault.detail, \"\")\n86|\t}\n87|\tfor name := range members {\n88|\t\tif !statusBodyMembers[name] {\n89|\t\t\treturn integrity(\"status body carries unknown member\", \"\")\n90|\t\t}\n91|\t}\n92|\tfor _, name := range []string{\"materialization_id\", \"transaction_id\", \"transaction_authority_id\", \"plan_id\", \"state\", \"rollback_token\", \"native_discovery\"} {\n93|\t\tif _, present := members[name]; !present {\n94|\t\t\treturn integrity(\"status body misses a required member\", \"\")\n95|\t\t}\n96|\t}\n97|\tstringMember := func(name string) (string, bool) {\n98|\t\tvar value string\n99|\t\tif err := json.Unmarshal(members[name], &value); err != nil {\n100|\t\t\treturn \"\", false\n101|\t\t}\n102|\t\treturn value, true\n103|\t}\n104|\tmaterializationID, ok := stringMember(\"materialization_id\")\n105|\tif !ok || materializationID != want.MaterializationID {\n106|\t\treturn integrity(\"status names another materialization\", \"\")\n107|\t}\n108|\ttransactionID, ok := stringMember(\"transaction_id\")\n109|\tif !ok || transactionID != want.TransactionID {\n110|\t\treturn integrity(\"status names another transaction\", \"\")\n111|\t}\n112|\tauthorityID, ok := stringMember(\"transaction_authority_id\")\n113|\tif !ok || authorityID != want.TransactionAuthorityID {\n114|\t\treturn integrity(\"status names another transaction authority\", \"\")\n115|\t}\n116|\tif raw, present := members[\"operation_id\"]; present {\n117|\t\tvar operationID string\n118|\t\tif err := json.Unmarshal(raw, &operationID); err != nil {\n119|\t\t\treturn integrity(\"status operation_id is not a string\", \"\")\n120|\t\t}\n121|\t\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n122|\t\t\treturn integrity(\"status operation_id is not a UUIDv7\", \"\")\n123|\t\t}\n124|\t}\n125|\tstate, ok := stringMember(\"state\")\n126|\tif !ok || !validStatusState(state) {\n127|\t\treturn integrity(\"status state is not a registry member\", \"\")\n128|\t}\n129|\tplanNull := isNull(members[\"plan_id\"])\n130|\ttokenNull := isNull(members[\"rollback_token\"])\n131|\tdiscoveryNull := isNull(members[\"native_discovery\"])\n132|\tif !planNull {\n133|\t\tvar digest string\n134|\t\tif err := json.Unmarshal(members[\"plan_id\"], &digest); err != nil {\n135|\t\t\treturn integrity(\"status plan_id is not a string\", state)\n136|\t\t}\n137|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n138|\t\t\treturn integrity(\"status plan_id is not a digest\", state)\n139|\t\t}\n140|\t}\n141|\tif !tokenNull {\n142|\t\tvar token string\n143|\t\tif err := json.Unmarshal(members[\"rollback_token\"], &token); err != nil {\n144|\t\t\treturn integrity(\"status rollback_token is not a string\", state)\n145|\t\t}\n146|\t\traw, err := base64.RawURLEncoding.DecodeString(token)\n147|\t\tif err != nil || len(raw) < 32 {\n148|\t\t\treturn integrity(\"status rollback_token is shorter than 256 bits\", state)\n149|\t\t}\n150|\t}\n151|\tif !discoveryNull && !isJSONObject(members[\"native_discovery\"]) {\n152|\t\treturn integrity(\"status native_discovery is not an object\", state)\n153|\t}\n154|\tswitch StatusState(state) {\n155|\tcase StatusUnknown:\n156|\t\t// Unknown is not a usable state: whether or not the\n157|\t\t// nullability shape holds, the host must fail closed and\n158|\t\t// quarantine the transaction root rather than infer prepare\n159|\t\t// or commit. The shape violation names its own rule; a\n160|\t\t// well-shaped unknown still refuses as unknown.\n161|\t\tif !planNull || !tokenNull || !discoveryNull {\n162|\t\t\treturn integrity(\"unknown status carries plan, token, or discovery\", state)\n163|\t\t}\n164|\t\treturn integrity(\"transaction state is unknown\", state)\n165|\tcase StatusPrepared:\n166|\t\tif planNull || tokenNull || discoveryNull {\n167|\t\t\treturn integrity(\"prepared status misses plan, token, or discovery\", state)\n168|\t\t}\n169|\tcase StatusCommitted, StatusRolledBack:\n170|\t\tif planNull || discoveryNull || !tokenNull {\n171|\t\t\treturn integrity(\"terminal status misses plan or discovery or keeps a token\", state)\n172|\t\t}\n173|\t}\n174|\treturn StatusState(state), nil\n175|}\n176|\n177|// isNull reports whether the raw member is a JSON null literal.\n178|func isNull(raw json.RawMessage) bool {\n179|\treturn string(raw) == \"null\"\n180|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
