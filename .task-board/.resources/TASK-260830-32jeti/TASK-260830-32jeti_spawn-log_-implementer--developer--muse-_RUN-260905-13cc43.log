{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70f","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":482,"recorded_at":1780531400000959,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffeeec97871a6b531fbfdd43f7e","text":"Read text file `internal/provhost/inventory_test.go`.\n(269 line(s) above)\n270|\t\t\t\t}\n271|\t\t\t}\n272|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n273|\t\t\tif !ok {\n274|\t\t\t\treturn true\n275|\t\t\t}\n276|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n277|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n278|\t\t\t\tswitch qualified {\n279|\t\t\t\tcase \"axerror.New\", \"axerror.LocalFromUntrusted\":\n280|\t\t\t\t\tif !insideConstructor(call.Pos()) {\n281|\t\t\t\t\t\tinventory.StrayBuilders = append(inventory.StrayBuilders, site+\" \"+qualified)\n282|\t\t\t\t\t}\n283|\t\t\t\t\treturn true\n284|\t\t\t\tcase \"errors.New\", \"fmt.Errorf\":\n285|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n286|\t\t\t\t\treturn true\n287|\t\t\t\t}\n288|\t\t\t}\n289|\t\t\tif selector.Sel.Name == \"panic\" {\n290|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n291|\t\t\t}\n292|\t\t\treturn true\n293|\t\t})\n294|\t}\n295|\treturn inventory, nil\n296|}\n297|\n298|// sectionLines joins the pinned document lines for a section, failing\n299|// when the section boundaries move. Every citation below resolves\n300|// against the real text, never against a restatement in this repository.\n301|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n302|\tt.Helper()\n303|\tfor _, line := range []int{first, last} {\n304|\t\tgot, ok := document.SectionID(line)\n305|\t\tif !ok || got != section {\n306|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n307|\t\t}\n308|\t}\n309|\tvar body strings.Builder\n310|\tfor line := first; line <= last; line++ {\n311|\t\ttext, ok := document.Line(line)\n312|\t\tif !ok {\n313|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n314|\t\t}\n315|\t\tbody.WriteString(text)\n316|\t\tbody.WriteString(\"\\n\")\n317|\t}\n318|\treturn body.String()\n319|}\n320|\n321|// requireQuote asserts the excerpt occurs verbatim in the pinned\n322|// document and begins on a line inside the cited section.\n323|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n324|\tt.Helper()\n325|\tif !document.Contains(excerpt) {\n326|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n327|\t}\n328|\tlines := document.QuoteLines(excerpt)\n329|\tif len(lines) == 0 {\n330|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n331|\t}\n332|\tgot, ok := document.SectionID(lines[0])\n333|\tif !ok || got != section {\n334|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n335|\t}\n336|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n337|}\n338|\n339|var operationCellPattern = regexp.MustCompile(`^\\| <code>([a-z-]+)</code> \\|`)\n340|\n341|// TestOperationRegistryIsDerivedFromSpec proves the dispatch registry is\n342|// exactly the Section 7.5 operation table in order: every table row must\n343|// appear in Operations() at the same position, and nothing else may.\n344|// A dropped, added, or reordered entry reddens here.\n345|func TestOperationRegistryIsDerivedFromSpec(t *testing.T) {\n346|\tdocument, err := specdoc.Load()\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n349|\t}\n350|\twindow := sectionLines(t, document, \"7.5\", 3070, 3086)\n351|\tvar derived []string\n352|\tfor _, line := range strings.Split(window, \"\\n\") {\n353|\t\tif match := operationCellPattern.FindStringSubmatch(line); match != nil {\n354|\t\t\tderived = append(derived, match[1])\n355|\t\t}\n356|\t}\n357|\tif len(derived) == 0 {\n358|\t\tt.Fatal(\"derived no operations from the Section 7.5 table; the check is blind\")\n359|\t}\n360|\tgot := Operations()\n361|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n362|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.5 table %v\", got, derived)\n363|\t}\n364|\tt.Logf(\"operation registry coverage: %d/%d table entries dispatched\", len(got), len(derived))\n365|}\n366|\n367|// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\n368|// package implements: the framing limits, the process model, the\n369|// envelope shapes, the closed-member rule, and the deadline/redaction\n370|// duties.\n371|func TestSection72FramingIsPinned(t *testing.T) {\n372|\tdocument, err := specdoc.Load()\n373|\tif err != nil {\n374|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n375|\t}\n376|\tfor _, excerpt := range []string{\n377|\t\t\"Each line MUST be one complete UTF-8\",\n378|\t\t\"JSON object no larger than 8 MiB\",\n379|\t\t\"Stdout MUST contain protocol frames only\",\n380|\t\t\"human diagnostics go to stderr\",\n381|\t\t\"starts one plugin process per operation\",\n382|\t\t\"After one response, <code>ax</code> closes stdin and the\",\n383|\t\t\"Exit 0 requires a successful response\",\n384|\t\t\"A structured error\",\n385|\t\t\"response SHOULD exit 0 because the protocol succeeded\",\n386|\t\t\"a crash, invalid frame,\",\n387|\t\t\"or missing response is a provider-host failure\",\n388|\t\t\"The deadline MUST be in the future when the host writes the frame\",\n389|\t\t\"A failure envelope contains\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffef0317c81b4a996674e253938","text":"Read text file `internal/provhost/profile_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n8|)\n9|\n10|// TestProfileMappingMatchesSection77 sweeps the full provider-by-\n11|// profile domain: six providers times two profiles, all twelve\n12|// measured. Yolo returns the exact adapter flag; standard returns\n13|// the empty omission for every provider, including Pi, whose yolo\n14|// and standard resolve to the same disclosed tool set rather than a\n15|// flag.\n16|func TestProfileMappingMatchesSection77(t *testing.T) {\n17|\twantYOLO := map[string]string{\n18|\t\t\"codex\":       \"--dangerously-bypass-approvals-and-sandbox\",\n19|\t\t\"claude\":      \"--dangerously-skip-permissions\",\n20|\t\t\"gemini\":      \"--approval-mode=yolo\",\n21|\t\t\"muse\":        \"--yolo\",\n22|\t\t\"antigravity\": \"--dangerously-skip-permissions\",\n23|\t\t\"pi\":          \"default_unrestricted_tool_set\",\n24|\t}\n25|\tif len(profileProviders) != len(wantYOLO) {\n26|\t\tt.Fatalf(\"profileProviders holds %d providers, want %d\", len(profileProviders), len(wantYOLO))\n27|\t}\n28|\tfor _, provider := range profileProviders {\n29|\t\twant, ok := wantYOLO[provider]\n30|\t\tif !ok {\n31|\t\t\tt.Fatalf(\"provider %q has no pinned yolo mapping; the sweep is blind\", provider)\n32|\t\t}\n33|\t\tgot, err := ProfileMapping(provider, ProfileYOLO)\n34|\t\tif err != nil {\n35|\t\t\tt.Fatalf(\"ProfileMapping(%q, yolo): %v\", provider, err)\n36|\t\t}\n37|\t\tif got != want {\n38|\t\t\tt.Fatalf(\"ProfileMapping(%q, yolo) = %q, want %q\", provider, got, want)\n39|\t\t}\n40|\t\tgot, err = ProfileMapping(provider, ProfileStandard)\n41|\t\tif err != nil {\n42|\t\t\tt.Fatalf(\"ProfileMapping(%q, standard): %v\", provider, err)\n43|\t\t}\n44|\t\tif got != \"\" {\n45|\t\t\tt.Fatalf(\"ProfileMapping(%q, standard) = %q, want the empty omission\", provider, got)\n46|\t\t}\n47|\t}\n48|\tt.Logf(\"profile mapping coverage: %d providers x 2 profiles measured\", len(profileProviders))\n49|}\n50|\n51|// TestProfileMappingRefusesUnknowns proves the fail-closed side:\n52|// unknown providers, unknown profiles, and empties are refused, never\n53|// defaulted. The provider near-misses derive from the registry by\n54|// case, affix, and truncation; the open-ended complement beyond them\n55|// is refused by construction (map miss) and witnessed here.\n56|func TestProfileMappingRefusesUnknowns(t *testing.T) {\n57|\tfor _, provider := range []string{\"\", \"Codex\", \"codex \", \" codex\", \"codexx\", \"cod\", \"qwen\", \"future\"} {\n58|\t\trequireLocalRefusal(t, mustProfileMapping(t, provider, true), \"invalid_config\", \"unknown provider\")\n59|\t}\n60|\tfor _, profile := range []string{\"\", \"YOLO\", \"yolo \", \"unrestricted\", \"standard-yolo\"} {\n61|\t\trequireLocalRefusal(t, mustProfileMapping(t, profile, false), \"invalid_config\", \"unknown profile\")\n62|\t}\n63|}\n64|\n65|// mustProfileMapping calls ProfileMapping with the unknown in the\n66|// provider seat (providerSeat true) or the profile seat.\n67|func mustProfileMapping(t *testing.T, unknown string, providerSeat bool) error {\n68|\tt.Helper()\n69|\tif providerSeat {\n70|\t\t_, err := ProfileMapping(unknown, ProfileYOLO)\n71|\t\treturn err\n72|\t}\n73|\t_, err := ProfileMapping(\"codex\", unknown)\n74|\treturn err\n75|}\n76|\n77|// TestProfileMappingIsPinnedToSection77 proves the table this file\n78|// transcribes: six provider rows in the Section 7.7 window, and every\n79|// yolo flag quoted verbatim from the pinned document.\n80|func TestProfileMappingIsPinnedToSection77(t *testing.T) {\n81|\tdocument, err := specdoc.Load()\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n84|\t}\n85|\twindow := sectionLines(t, document, \"7.7\", 3429, 3436)\n86|\trows := 0\n87|\tfor _, line := range strings.Split(window, \"\\n\") {\n88|\t\ttrimmed := strings.TrimSpace(line)\n89|\t\tif strings.HasPrefix(trimmed, \"| Codex \") || strings.HasPrefix(trimmed, \"| Claude \") || strings.HasPrefix(trimmed, \"| Gemini \") || strings.HasPrefix(trimmed, \"| Muse \") || strings.HasPrefix(trimmed, \"| Antigravity \") || strings.HasPrefix(trimmed, \"| Pi \") {\n90|\t\t\trows++\n91|\t\t}\n92|\t}\n93|\tif rows != len(profileProviders) {\n94|\t\tt.Fatalf(\"Section 7.7 holds %d provider rows, want %d\", rows, len(profileProviders))\n95|\t}\n96|\tfor _, excerpt := range []string{\n97|\t\t\"| Codex | <code>--dangerously-bypass-approvals-and-sandbox</code> (alias\",\n98|\t\t\"| Claude | <code>--dangerously-skip-permissions</code> |\",\n99|\t\t\"| Gemini CLI | <code>--approval-mode=yolo</code> |\",\n100|\t\t\"| Muse | <code>--yolo</code> |\",\n101|\t\t\"| Antigravity | <code>--dangerously-skip-permissions</code> |\",\n102|\t\t\"| Pi 0.73.1 | No invented flag;\",\n103|\t\t\"MUST omit every unrestricted flag above\",\n104|\t\t\"An absent or changed flag fails closed\",\n105|\t} {\n106|\t\trequireQuote(t, document, excerpt, \"7.7\")\n107|\t}\n108|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c713","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":484,"recorded_at":1780531400000963,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffef1057730b2ec369f1072a939","text":"Read text file `internal/provhost/manifest_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// specManifestExample is the Section 7.3 manifest example, copied\n12|// verbatim from the pinned document. The derivation test below\n13|// re-reads the same lines from SPEC.md, so drift between this copy\n14|// and the document reddens there rather than passing silently.\n15|const specManifestExample = `{\n16|  \"schema\": \"urn:ax:schema:provider-manifest\",\n17|  \"schema_version\": \"1.0.0\",\n18|  \"provider_id\": \"pi\",\n19|  \"display_name\": \"Pi\",\n20|  \"plugin_version\": \"0.1.0\",\n21|  \"provider_version_range\": \">=0.73.1 <0.74.0\",\n22|  \"platforms\": [\"linux\", \"macos\", \"windows\", \"wsl2\"],\n23|  \"operations\": [\n24|    \"manifest\",\n25|    \"probe\",\n26|    \"launch\",\n27|    \"identify-session\",\n28|    \"quiesce\",\n29|    \"native-store-plan\",\n30|    \"capture\",\n31|    \"materialize\",\n32|    \"materialize-status\",\n33|    \"materialize-commit\",\n34|    \"materialize-rollback\",\n35|    \"resume\",\n36|    \"fork\",\n37|    \"stop\",\n38|    \"doctor\"\n39|  ],\n40|  \"capability_names\": [\n41|    \"native_resume\",\n42|    \"portable_store\",\n43|    \"managed_pty\",\n44|    \"appserver\",\n45|    \"task_board_primary\",\n46|    \"prompt_spawn\",\n47|    \"native_goal_binding\"\n48|  ]\n49|}`\n50|\n51|// TestCapabilitiesReturnsACopy proves the copy guarantee the\n52|// accessor documents: mutating a returned slice and re-reading must\n53|// leave the registry unchanged, so the registry cannot be mutated\n54|// through it.\n55|func TestCapabilitiesReturnsACopy(t *testing.T) {\n56|\tfirst := Capabilities()\n57|\tif len(first) == 0 {\n58|\t\tt.Fatal(\"Capabilities() is empty; the check is blind\")\n59|\t}\n60|\twant := first[0]\n61|\tfirst[0] = \"remote_exec\"\n62|\tif got := Capabilities()[0]; got != want {\n63|\t\tt.Fatalf(\"Capabilities()[0] = %q after aliasing write, want %q\", got, want)\n64|\t}\n65|}\n66|\n67|// TestSpecManifestExampleDecodes proves the Section 7.3 example is a\n68|// well-formed manifest under DecodeManifest: the contract's own\n69|// fixture passes the production entry point.\n70|func TestSpecManifestExampleDecodes(t *testing.T) {\n71|\tif err := DecodeManifest([]byte(specManifestExample)); err != nil {\n72|\t\tt.Fatalf(\"DecodeManifest(spec example): %v\", err)\n73|\t}\n74|}\n75|\n76|// TestManifestRegistriesAreDerivedFromSpec proves the three transcribed\n77|// registries — operations, capability names, platforms — equal the\n78|// Section 7.3 example: the example JSON is re-read from the pinned\n79|// document, never from the constant above, so a drifted transcription\n80|// reddens here.\n81|func TestManifestRegistriesAreDerivedFromSpec(t *testing.T) {\n82|\tdocument, err := specdoc.Load()\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n85|\t}\n86|\twindow := sectionLines(t, document, \"7.3\", 2751, 2785)\n87|\tstart := strings.Index(window, \"{\")\n88|\tend := strings.LastIndex(window, \"}\")\n89|\tif start < 0 || end <= start {\n90|\t\tt.Fatal(\"Section 7.3 example holds no JSON object; the check is blind\")\n91|\t}\n92|\texample, fault := decodeStrictObject([]byte(window[start : end+1]))\n93|\tif fault != nil {\n94|\t\tt.Fatalf(\"Section 7.3 example is not a strict object: %v %q\", fault.detail, fault.member)\n95|\t}\n96|\toperations, ok := rawStringArray(example[\"operations\"])\n97|\tif !ok {\n98|\t\tt.Fatal(\"Section 7.3 example operations are not a string array; the check is blind\")\n99|\t}\n100|\tif fmt.Sprintf(\"%v\", operations) != fmt.Sprintf(\"%v\", Operations()) {\n101|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.3 example %v\", Operations(), operations)\n102|\t}\n103|\tcapabilities, ok := rawStringArray(example[\"capability_names\"])\n104|\tif !ok {\n105|\t\tt.Fatal(\"Section 7.3 example capability_names are not a string array; the check is blind\")\n106|\t}\n107|\tif fmt.Sprintf(\"%v\", capabilities) != fmt.Sprintf(\"%v\", Capabilities()) {\n108|\t\tt.Fatalf(\"Capabilities() = %v, want the Section 7.3 example %v\", Capabilities(), capabilities)\n109|\t}\n110|\tplatforms, ok := rawStringArray(example[\"platforms\"])\n111|\tif !ok {\n112|\t\tt.Fatal(\"Section 7.3 example platforms are not a string array; the check is blind\")\n113|\t}\n114|\tif fmt.Sprintf(\"%v\", platforms) != fmt.Sprintf(\"%v\", manifestPlatforms) {\n115|\t\tt.Fatalf(\"manifestPlatforms = %v, want the Section 7.3 example %v\", manifestPlatforms, platforms)\n116|\t}\n117|\tt.Logf(\"manifest registry coverage: %d operations, %d capabilities, %d platforms derived\", len(operations), len(capabilities), len(platforms))\n118|}\n119|\n120|// manifestVariant rewrites one unique substring of the spec example.\n121|// The rewritten body, not the spec fixture, is what the negative rows\n122|// drive.\n123|func manifestVariant(t *testing.T, old, new string) []byte {\n124|\tt.Helper()\n125|\tif strings.Count(specManifestExample, old) != 1 {\n126|\t\tt.Fatalf(\"manifest variant anchor %q is not unique\", old)\n127|\t}\n128|\treturn []byte(strings.Replace(specManifestExample, old, new, 1))\n129|}\n130|\n131|// TestDecodeManifestRefusals drives every manifest rule with a\n132|// fixture carrying only that violation. Each row names the arm\n133|// (member plus rule detail), so a deleted rule slides to a different\n134|// arm or to acceptance and reddens here.\n135|func TestDecodeManifestRefusals(t *testing.T) {\n136|\tlong128 := strings.Repeat(\"a\", 128)\n137|\tlong129 := strings.Repeat(\"a\", 129)\n138|\tlong256 := strings.Repeat(\"a\", 256)\n139|\tlong257 := strings.Repeat(\"a\", 257)\n140|\tid32 := \"a\" + strings.Repeat(\"b\", 31)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
