{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b3","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":692,"recorded_at":1780531400001379,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a07001b29477c1840f5bb751439636","text":"Read text file `internal/provhost/protocol_test.go`.\n(79 line(s) above)\n80|}\n81|\n82|func failureExit(t *testing.T, err error) int {\n83|\tt.Helper()\n84|\tvar failure *axerror.Error\n85|\tif !asError(t, err, &failure) {\n86|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n87|\t}\n88|\treturn failure.ExitCode()\n89|}\n90|\n91|// failureObject unwraps err to the Structured Error itself, so arm\n92|// identity beyond the stable code can be asserted.\n93|func failureObject(t *testing.T, err error) *axerror.Error {\n94|\tt.Helper()\n95|\tif err == nil {\n96|\t\tt.Fatal(\"want a failure, got nil\")\n97|\t}\n98|\tvar failure *axerror.Error\n99|\tif !asError(t, err, &failure) {\n100|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n101|\t}\n102|\treturn failure\n103|}\n104|\n105|// failureMember returns the \"member\" diagnostic of a frame refusal. Every\n106|// provider_protocol_error arm names the member it refused on, so asserting\n107|// it pins the arm: a missing-member gate deleted from checkResponseMembers\n108|// slides to a lower arm carrying the same code with a different member or\n109|// detail, and the slide reddens here instead of passing silently.\n110|func failureMember(t *testing.T, err error) string {\n111|\tt.Helper()\n112|\tfailure := failureObject(t, err)\n113|\tmember, ok := failure.Detail(\"member\")\n114|\tif !ok {\n115|\t\tt.Fatalf(\"refusal %v carries no member detail\", err)\n116|\t}\n117|\ttext, ok := member.(string)\n118|\tif !ok {\n119|\t\tt.Fatalf(\"refusal %v member detail is %T, want string\", err, member)\n120|\t}\n121|\treturn text\n122|}\n123|\n124|// requireFrameRefusal asserts the full arm identity of a plugin-frame\n125|// refusal: the stable code, the refused member, the detail naming the\n126|// rule, and the non-retryable bit doc.go promises for every local\n127|// failure this package emits.\n128|func requireFrameRefusal(t *testing.T, err error, member, detail string) {\n129|\tt.Helper()\n130|\tif failureCode(t, err) != \"provider_protocol_error\" {\n131|\t\tt.Fatalf(\"DecodeResponse code = %v, want provider_protocol_error\", err)\n132|\t}\n133|\tif got := failureMember(t, err); got != member {\n134|\t\tt.Fatalf(\"DecodeResponse member = %q, want %q (detail: %v)\", got, member, err)\n135|\t}\n136|\tif !strings.Contains(err.Error(), detail) {\n137|\t\tt.Fatalf(\"DecodeResponse error = %v, want detail containing %q\", err, detail)\n138|\t}\n139|\tif failureObject(t, err).Retryable() {\n140|\t\tt.Fatalf(\"DecodeResponse error = %v, want non-retryable\", err)\n141|\t}\n142|}\n143|\n144|// requireLocalRefusal asserts the arm identity of a refusal that carries\n145|// no member detail (invalid_config framing refusals and integrity_failure\n146|// status refusals): the stable code, the detail naming the rule in the\n147|// human text, and the non-retryable bit.\n148|func requireLocalRefusal(t *testing.T, err error, code axerror.Code, detail string) {\n149|\tt.Helper()\n150|\tif failureCode(t, err) != code {\n151|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n152|\t}\n153|\tif !strings.Contains(err.Error(), detail) {\n154|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, detail)\n155|\t}\n156|\tif failureObject(t, err).Retryable() {\n157|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n158|\t}\n159|}\n160|\n161|// TestEncodeRequestEmitsExactFrame pins the request wire bytes: the six\n162|// exact members in fixed order, with the body passed through verbatim.\n163|func TestEncodeRequestEmitsExactFrame(t *testing.T) {\n164|\tframe, err := EncodeRequest(testRequest(t), mustInstant(t, testNow))\n165|\tif err != nil {\n166|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n167|\t}\n168|\twant := `{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"operation\":\"doctor\",\"deadline\":\"2026-08-19T04:05:00.000Z\",\"body\":{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}}`\n169|\tif string(frame) != want {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b5","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":693,"recorded_at":1780531400001381,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a07001b3d3764389d52dcfa59b4493","text":"Read text file `internal/provhost/probe_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// specProbeExample is the Section 7.4 probe example, copied verbatim\n11|// from the pinned document. It exercises all four statuses across\n12|// the seven capabilities: available, conditional, unsupported, and\n13|// unknown, each with enabled set exactly as the contract allows.\n14|const specProbeExample = `{\n15|  \"schema\": \"urn:ax:schema:provider-probe\",\n16|  \"schema_version\": \"1.0.0\",\n17|  \"provider_id\": \"pi\",\n18|  \"provider_version\": \"0.73.1\",\n19|  \"platform\": \"macos\",\n20|  \"architecture\": \"arm64\",\n21|  \"capabilities\": {\n22|    \"native_resume\": {\n23|      \"status\": \"available\",\n24|      \"enabled\": true,\n25|      \"evidence\": \"probed\",\n26|      \"detail\": \"--session, --continue, and --resume are present\"\n27|    },\n28|    \"portable_store\": {\n29|      \"status\": \"conditional\",\n30|      \"enabled\": false,\n31|      \"evidence\": \"acceptance_required\",\n32|      \"detail\": \"closed-store cross-host fixture has not passed\"\n33|    },\n34|    \"managed_pty\": {\n35|      \"status\": \"conditional\",\n36|      \"enabled\": false,\n37|      \"evidence\": \"acceptance_required\",\n38|      \"detail\": \"platform PTY interruption and flush gate has not passed\"\n39|    },\n40|    \"appserver\": {\n41|      \"status\": \"unsupported\",\n42|      \"enabled\": false,\n43|      \"evidence\": \"provider_contract\",\n44|      \"detail\": \"Pi RPC is not claimed as the ax appserver capability\"\n45|    },\n46|    \"task_board_primary\": {\n47|      \"status\": \"unknown\",\n48|      \"enabled\": false,\n49|      \"evidence\": \"none\",\n50|      \"detail\": \"no reliable primary adapter is accepted\"\n51|    },\n52|    \"prompt_spawn\": {\n53|      \"status\": \"unknown\",\n54|      \"enabled\": false,\n55|      \"evidence\": \"none\",\n56|      \"detail\": \"not claimed for v0.3.0\"\n57|    },\n58|    \"native_goal_binding\": {\n59|      \"status\": \"unsupported\",\n60|      \"enabled\": false,\n61|      \"evidence\": \"provider_contract\",\n62|      \"detail\": \"no native task-board goal binding\"\n63|    }\n64|  },\n65|  \"warnings\": []\n66|}`\n67|\n68|// TestSpecProbeExampleDecodes proves the Section 7.4 example passes\n69|// the production entry point with every status represented.\n70|func TestSpecProbeExampleDecodes(t *testing.T) {\n71|\tif err := DecodeProbe([]byte(specProbeExample)); err != nil {\n72|\t\tt.Fatalf(\"DecodeProbe(spec example): %v\", err)\n73|\t}\n74|}\n75|\n76|// probeVariant rewrites one unique substring of the spec example.\n77|func probeVariant(t *testing.T, old, new string) []byte {\n78|\tt.Helper()\n79|\tif strings.Count(specProbeExample, old) != 1 {\n80|\t\tt.Fatalf(\"probe variant anchor %q is not unique\", old)\n81|\t}\n82|\treturn []byte(strings.Replace(specProbeExample, old, new, 1))\n83|}\n84|\n85|// probeCapabilityBlock renders one capability value with the given\n86|// status and enabled bit, for the per-key sweep.\n87|func probeCapabilityBlock(status string, enabled bool) string {\n88|\treturn `{\"status\": \"` + status + `\", \"enabled\": ` + map[bool]string{true: \"true\", false: \"false\"}[enabled] + `, \"evidence\": \"probed\", \"detail\": \"sweep\"}`\n89|}\n90|\n91|// probeWithCapabilities builds a probe whose capabilities object is\n92|// exactly the seven registry keys mapped through render. The domain\n93|// is derived from Capabilities(), never from a hand-picked sample:\n94|// every registry key answers to every rule.\n95|func probeWithCapabilities(t *testing.T, render func(name, exampleStatus string) string) []byte {\n96|\tt.Helper()\n97|\texample, fault := decodeStrictObject([]byte(specProbeExample))\n98|\tif fault != nil {\n99|\t\tt.Fatalf(\"spec probe example is not a strict object: %v\", fault.detail)\n100|\t}\n101|\tcapabilities, fault := decodeStrictObject(example[\"capabilities\"])\n102|\tif fault != nil {\n103|\t\tt.Fatalf(\"spec probe capabilities are not a strict object: %v\", fault.detail)\n104|\t}\n105|\tvar names []string\n106|\tfor _, name := range Capabilities() {\n107|\t\traw, present := capabilities[name]\n108|\t\tif !present {\n109|\t\t\tt.Fatalf(\"spec probe example misses capability %q\", name)\n110|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
