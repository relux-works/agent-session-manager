fixture.\n177|func checkManifestPlatforms(raw json.RawMessage) error {\n178|\tplatforms, ok := rawStringArray(raw)\n179|\tif !ok || len(platforms) == 0 {\n180|\t\tfailure, err := failProtocol(\"manifest platforms is empty or not an array\", \"platforms\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tallowed := map[string]bool{}\n187|\tfor _, platform := range manifestPlatforms {\n188|\t\tallowed[platform] = true\n189|\t}\n190|\tfor _, platform := range platforms {\n191|\t\tif !allowed[platform] {\n192|\t\t\tfailure, err := failProtocol(\"manifest platforms names an unknown platform\", \"platforms\")\n193|\t\t\tif err != nil {\n194|\t\t\t\treturn err\n195|\t\t\t}\n196|\t\t\treturn failure\n197|\t\t}\n198|\t}\n199|\tif !sortedUniqueStrings(platforms) {\n200|\t\tfailure, err := failProtocol(\"manifest platforms are not sorted unique\", \"platforms\")\n201|\t\tif err != nil {\n202|\t\t\treturn err\n203|\t\t}\n204|\t\treturn failure\n205|\t}\n206|\treturn nil\n207|}\n208|\n209|// checkManifestOperations requires the ordered registry Section 7.5\n210|// shows with no duplicates: the manifest must name exactly what the\n211|// host can dispatch, in the order the manifest order defines.\n212|func checkManifestOperations(raw json.RawMessage) error {\n213|\toperations, ok := rawStringArray(raw)\n214|\tif !ok || len(operations) != len(operationOrder) {\n215|\t\tfailure, err := failProtocol(\"manifest operations differ from the registry\", \"operations\")\n216|\t\tif err != nil {\n217|\t\t\treturn err\n218|\t\t}\n219|\t\treturn failure\n220|\t}\n221|\tfor index, operation := range operationOrder {\n222|\t\tif operations[index] != string(operation) {\n223|\t\t\tfailure, err := failProtocol(\"manifest operations differ from the registry\", \"operations\")\n224|\t\t\tif err != nil {\n225|\t\t\t\treturn err\n226|\t\t\t}\n227|\t\t\treturn failure\n228|\t\t}\n229|\t}\n230|\treturn nil\n231|}\n232|\n233|// checkManifestCapabilities requires the exact seven-name ordered\n234|// registry: no eighth advertised surface, no hidden one.\n235|func checkManifestCapabilities(raw json.RawMessage) error {\n236|\tnames, ok := rawStringArray(raw)\n237|\tif !ok || len(names) != len(capabilityOrder) {\n238|\t\tfailure, err := failProtocol(\"manifest capability_names differ from the registry\", \"capability_names\")\n239|\t\tif err != nil {\n240|\t\t\treturn err\n241|\t\t}\n242|\t\treturn failure\n243|\t}\n244|\tfor index, name := range capabilityOrder {\n245|\t\tif names[index] != name {\n246|\t\t\tfailure, err := failProtocol(\"manifest capability_names differ from the registry\", \"capability_names\")\n247|\t\t\tif err != nil {\n248|\t\t\t\treturn err\n249|\t\t\t}\n250|\t\t\treturn failure\n251|\t\t}\n252|\t}\n253|\treturn nil\n254|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c637","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":374,"recorded_at":1780531400000743,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffec6207f3386e1ec041a5afc18","text":"Read text file `internal/provhost/probe.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.4 Capability result: the closed\n8|// urn:ax:schema:provider-probe 1.0.0 object a probe operation returns\n9|// as its success body. It also owns the host-side availability gate:\n10|// only available MAY be enabled, and the host MUST NOT treat a\n11|// conditional, unsupported, or unknown capability as usable, no matter\n12|// what enabled claims.\n13|\n14|// probeSchema is the exact schema identifier the probe carries.\n15|const probeSchema = \"urn:ax:schema:provider-probe\"\n16|\n17|// probeSchemaVersion is the only probe version this host accepts.\n18|const probeSchemaVersion = \"1.0.0\"\n19|\n20|// Probe capability statuses Section 7.4 defines. Only Available MAY\n21|// set enabled true; every other status MUST NOT be advertised as\n22|// usable, which CapabilityUsable enforces.\n23|const (\n24|\tCapabilityAvailable   = \"available\"\n25|\tCapabilityConditional = \"conditional\"\n26|\tCapabilityUnsupported = \"unsupported\"\n27|\tCapabilityUnknown     = \"unknown\"\n28|)\n29|\n30|// probeCapabilityStatuses is the closed status vocabulary in the\n31|// Section 7.4 order.\n32|var probeCapabilityStatuses = []string{\n33|\tCapabilityAvailable,\n34|\tCapabilityConditional,\n35|\tCapabilityUnsupported,\n36|\tCapabilityUnknown,\n37|}\n38|\n39|// Probe capability evidence Section 7.4 defines, in section order.\n40|var probeCapabilityEvidence = []string{\n41|\t\"documented\",\n42|\t\"probed\",\n43|\t\"accepted_test\",\n44|\t\"provider_contract\",\n45|\t\"inferred\",\n46|\t\"acceptance_required\",\n47|\t\"none\",\n48|}\n49|\n50|// probeArchitectures is the closed architecture vocabulary.\n51|var probeArchitectures = []string{\"amd64\", \"arm64\"}\n52|\n53|// probePlatforms is the closed platform vocabulary: the four Section\n54|// 7.3 enums. WSL2 and native Windows are distinct rows; one never\n55|// stands for the other.\n56|var probePlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n57|\n58|// probeMembers is the exact required member set DecodeProbe accepts.\n59|var probeMembers = map[string]bool{\n60|\t\"schema\":           true,\n61|\t\"schema_version\":   true,\n62|\t\"provider_id\":      true,\n63|\t\"provider_version\": true,\n64|\t\"platform\":         true,\n65|\t\"architecture\":     true,\n66|\t\"capabilities\":     true,\n67|\t\"warnings\":         true,\n68|}\n69|\n70|// probeRequired lists probeMembers in a fixed order so a body missing\n71|// several members always names the same one.\n72|var probeRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"provider_id\",\n76|\t\"provider_version\",\n77|\t\"platform\",\n78|\t\"architecture\",\n79|\t\"capabilities\",\n80|\t\"warnings\",\n81|}\n82|\n83|// probeCapabilityMembers is the exact member set of one capability\n84|// value: status, enabled, evidence, and detail, nothing else.\n85|var probeCapabilityMembers = map[string]bool{\n86|\t\"status\":   true,\n87|\t\"enabled\":  true,\n88|\t\"evidence\": true,\n89|\t\"detail\":   true,\n90|}\n91|\n92|// probeCapabilityRequired lists probeCapabilityMembers in a fixed\n93|// order so a value missing several members always names the same one.\n94|var probeCapabilityRequired = []string{\"status\", \"enabled\", \"evidence\", \"detail\"}\n95|\n96|// DecodeProbe validates one probe-operation success body as the closed\n97|// Section 7.4 probe object. It returns nil on a well-formed probe and\n98|// a provider_protocol_error naming the offending member otherwise. A\n99|// capability that claims enabled under any status but available is\n100|// refused here, not at use time: an advertised-but-unusable surface\n101|// must never reach the caller as a probe result.\n102|func DecodeProbe(body []byte) error {\n103|\tmembers, fault := decodeStrictObject(body)\n104|\tif fault != nil {\n105|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n106|\t\tif err != nil {\n107|\t\t\treturn err\n108|\t\t}\n109|\t\treturn failure\n110|\t}\n111|\tif name, unknown := unknownMember(members, probeMembers); unknown {\n112|\t\tfailure, err := failProtocol(\"probe carries unknown member\", name)\n113|\t\tif err != nil {\n114|\t\t\treturn err\n115|\t\t}\n116|\t\treturn failure\n117|\t}\n118|\tif name, missing := missingMember(members, probeRequired); missing {\n119|\t\tfailure, err := failProtocol(\"probe misses a required member\", name)\n120|\t\tif err != nil {\n121|\t\t\treturn err\n122|\t\t}\n123|\t\treturn failure\n124|\t}\n125|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != probeSchema {\n126|\t\tfailure, err := failProtocol(\"probe schema is not the provider probe\", \"schema\")\n127|\t\tif err != nil {\n128|\t\t\treturn err\n129|\t\t}\n130|\t\treturn failure\n131|\t}\n132|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != probeSchemaVersion {\n133|\t\tfailure, err := failProtocol(\"probe schema_version is not 1.0.0\", \"schema_version\")\n134|\t\tif err != nil {\n135|\t\t\treturn err\n136|\t\t}\n137|\t\treturn failure\n138|\t}\n139|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n140|\t\tfailure, err := failProtocol(\"probe provider_id is not a provider id\", \"provider_id\")\n141|\t\tif err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t\treturn failure\n145|\t}\n146|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n147|\t\tfailure, err := failProtocol(\"probe provider_version is not 1..128 characters\", \"provider_version\")\n148|\t\tif err != nil {\n149|\t\t\treturn err\n150|\t\t}\n151|\t\treturn failure\n152|\t}\n153|\tif platform, ok := rawString(members[\"platform\"]); !ok || !isProbePlatform(platform) {\n154|\t\tfailure, err := failProtocol(\"probe platform is not a registry member\", \"platform\")\n155|\t\tif err != nil {\n156|\t\t\treturn err\n157|\t\t}\n158|\t\treturn failure\n159|\t}\n160|\tif architecture, ok := rawString(members[\"architecture\"]); !ok || !isProbeArchitecture(architecture) {\n161|\t\tfailure, err := failProtocol(\"probe architecture is not amd64 or arm64\", \"architecture\")\n162|\t\tif err != nil {\n163|\t\t\treturn err\n164|\t\t}\n165|\t\treturn failure\n166|\t}\n167|\tif err := checkProbeCapabilities(members[\"capabilities\"]); err != nil {\n168|\t\treturn err\n169|\t}\n170|\tif err := checkProbeWarnings(members[\"warnings\"]); err != nil {\n171|\t\treturn err\n172|\t}\n173|\treturn nil\n174|}\n175|\n176|func isProbePlatform(value string) bool {\n177|\tfor _, platform := range probePlatforms {\n178|\t\tif value == platform {\n179|\t\t\treturn true\n180|\t\t}\n181|\t}\n182|\treturn false\n183|}\n184|\n185|func isProbeArchitecture(value string) bool {\n186|\tfor _, architecture := range probeArchitectures {\n187|\t\tif value == architecture {\n188|\t\t\treturn true\n189|\t\t}\n190|\t}\n191|\treturn false\n192|}\n193|\n194|// checkProbeCapabilities requires exactly the seven registry keys,\n195|// each carrying a closed status/enabled/evidence/detail value. The\n196|// per-key loop is derived from capabilityOrder, never from a sample:\n197|// a validation that held for three capabilities and skipped the rest\n198|// would pass a probe this function must refuse.\n199|func checkProbeCapabilities(raw json.RawMessage) error {\n200|\tdecoded, fault := decodeStrictObject(raw)\n201|\tif fault != nil {\n202|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n203|\t\tif err != nil {\n204|\t\t\treturn err\n205|\t\t}\n206|\t\treturn failure\n207|\t}\n208|\tfor _, name := range capabilityOrder {\n209|\t\tif _, present := decoded[name]; !present {\n210|\t\t\tfailure, err := failProtocol(\"probe capabilities miss a registry key\", \"capabilities\")\n211|\t\t\tif err != nil {\n212|\t\t\t\treturn err\n213|\t\t\t}\n214|\t\t\treturn failure\n215|\t\t}\n216|\t}\n217|\tfor name := range decoded {\n218|\t\tknown := false\n219|\t\tfor _, registry := range capabilityOrder {\n220|\t\t\tif name == registry {\n221|\t\t\t\tknown = true\n222|\t\t\t}\n223|\t\t}\n224|\t\tif !known {\n225|\t\t\tfailure, err := failProtocol(\"probe capabilities carry an unknown key\", \"capabilities\")\n226|\t\t\tif err != nil {\n227|\t\t\t\treturn err\n228|\t\t\t}\n229|\t\t\treturn failure\n230|\t\t}\n231|\t}\n232|\tfor _, name := range capabilityOrder {\n233|\t\tif err := checkProbeCapabilityValue(decoded[name]); err != nil {\n234|\t\t\treturn err\n235|\t\t}\n236|\t}\n237|\treturn nil\n238|}\n239|\n240|// checkProbeCapabilityValue validates one capability value object. The\n241|// member parameter of every refusal below is \"capabilities\": the\n242|// detail names the violated rule, and the per-key sweep in the\n243|// conformance tests proves each registry key answers to it.\n244|func checkProbeCapabilityValue(raw json.RawMessage) error {\n245|\tvalue, fault := decodeStrictObject(raw)\n246|\tif fault != nil {\n247|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n248|\t\tif err != nil {\n249|\t\t\treturn err\n250|\t\t}\n251|\t\treturn failure\n252|\t}\n253|\tif _, unknown := unknownMember(value, probeCapabilityMembers); unknown {\n254|\t\tfailure, err := failProtocol(\"probe capability carries an unknown member\", \"capabilities\")\n255|\t\tif err != nil {\n256|\t\t\treturn err\n257|\t\t}\n258|\t\treturn failure\n259|\t}\n260|\tif _, missing := missingMember(value, probeCapabilityRequired); missing {\n261|\t\tfailure, err := failProtocol(\"probe capability misses a required member\", \"capabilities\")\n262|\t\tif err != nil {\n263|\t\t\treturn err\n264|\t\t}\n265|\t\treturn failure\n266|\t}\n267|\tstatus, ok := rawString(value[\"status\"])\n268|\tif !ok || !isProbeStatus(status) {\n269|\t\tfailure, err := failProtocol(\"probe capability status is not a registry member\", \"capabilities\")\n270|\t\tif err != nil {\n271|\t\t\treturn err\n272|\t\t}\n273|\t\treturn failure\n274|\t}\n275|\tenabled, ok := rawBool(value[\"enabled\"])\n276|\tif !ok {\n277|\t\tfailure, err := failProtocol(\"probe capability enabled is not a boolean\", \"capabilities\")\n278|\t\tif err != nil {\n279|\t\t\treturn err\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\tif evidence, ok := rawString(value[\"evidence\"]); !ok || !isProbeEvidence(evidence) {\n284|\t\tfailure, err := failProtocol(\"probe capability evidence is not a registry member\", \"capabilities\")\n285|\t\tif err != nil {\n286|\t\t\treturn err\n287|\t\t}\n288|\t\treturn failure\n289|\t}\n290|\tif detail, ok := rawString(value[\"detail\"]); !ok || runeLength(detail) > 2048 {\n291|\t\tfailure, err := failProtocol(\"probe capability detail is not 0..2048 characters\", \"capabilities\")\n292|\t\tif err != nil {\n293|\t\t\treturn err\n294|\t\t}\n295|\t\treturn failure\n296|\t}\n297|\tif enabled && status != CapabilityAvailable {\n298|\t\tfailure, err := failProtocol(\"probe capability enables a non-available status\", \"capabilities\")\n299|\t\tif err != nil {\n300|\t\t\treturn err\n301|\t\t}\n302|\t\treturn failure\n303|\t}\n304|\treturn nil\n305|}\n306|\n307|func isProbeStatus(value string) bool {\n308|\tfor _, status := range probeCapabilityStatuses {\n309|\t\tif value == status {\n310|\t\t\treturn true\n311|\t\t}\n312|\t}\n313|\treturn false\n314|}\n315|\n316|func isProbeEvidence(value string) bool {\n317|\tfor _, evidence := range probeCapabilityEvidence {\n318|\t\tif value == evidence {\n319|\t\t\treturn true\n320|\t\t}\n321|\t}\n322|\treturn false\n323|}\n324|\n325|// checkProbeWarnings enforces the sorted, unique, bounded warning\n326|// array: at most 1,024 strings of at most 2,048 characters each.\n327|func checkProbeWarnings(raw json.RawMessage) error {\n328|\twarnings, ok := rawStringArray(raw)\n329|\tif !ok || len(warnings) > 1024 {\n330|\t\tfailure, err := failProtocol(\"probe warnings exceed 1024 entries\", \"warnings\")\n331|\t\tif err != nil {\n332|\t\t\treturn err\n333|\t\t}\n334|\t\treturn failure\n335|\t}\n336|\tfor _, warning := range warnings {\n337|\t\tif runeLength(warning) > 2048 {\n338|\t\t\tfailure, err := failProtocol(\"probe warning exceeds 2048 characters\", \"warnings\")\n339|\t\t\tif err != nil {\n340|\t\t\t\treturn err\n341|\t\t\t}\n342|\t\t\treturn failure\n343|\t\t}\n344|\t}\n345|\tif !sortedUniqueStrings(warnings) {\n346|\t\tfailure, err := failProtocol(\"probe warnings are not sorted unique\", \"warnings\")\n347|\t\tif err != nil {\n348|\t\t\treturn err\n349|\t\t}\n350|\t\treturn failure\n351|\t}\n352|\treturn nil\n353|}\n354|\n355|// CapabilityUsable reports whether the probe establishes the named\n356|// capability as usable: status available and enabled true. It is the\n357|// host-side reading of the Section 8 matrices: conditional,\n358|// unsupported, and unknown are never usable, however enabled reads,\n359|// and unknown MUST NOT be rewritten as unsupported — both refuse the\n360|// same way here, by returning false.\n361|func CapabilityUsable(status string, enabled bool) bool {\n362|\treturn status == CapabilityAvailable && enabled\n363|}\n364|\n365|// RequireCapability decodes one probe body and requires the named\n366|// capability usable. A malformed probe is a provider_protocol_error;\n367|// a well-formed probe that does not establish the capability is an\n368|// invalid_config caller error: the caller asked for a surface the\n369|// probe plane never proved. Either way no plugin process starts for\n370|// the gated operation.\n371|func RequireCapability(probeBody []byte, name string) error {\n372|\tif err := DecodeProbe(probeBody); err != nil {\n373|\t\treturn err\n374|\t}\n375|\tmembers, _ := decodeStrictObject(probeBody)\n376|\tcapabilities, _ := decodeStrictObject(members[\"capabilities\"])\n377|\tknown := false\n378|\tfor _, registry := range capabilityOrder {\n379|\t\tif name == registry {\n380|\t\t\tknown = true\n381|\t\t}\n382|\t}\n383|\tif !known {\n384|\t\tfailure, err := failInvalid(\"capability is not a registry member\")\n385|\t\tif err != nil {\n386|\t\t\treturn err\n387|\t\t}\n388|\t\treturn failure\n389|\t}\n390|\tvalue, _ := decodeStrictObject(capabilities[name])\n391|\tstatus, _ := rawString(value[\"status\"])\n392|\tenabled, _ := rawBool(value[\"enabled\"])\n393|\tif !CapabilityUsable(status, enabled) {\n394|\t\tfailure, err := failInvalid(\"probe does not establish the capability as available\")\n395|\t\tif err != nil {\n396|\t\t\treturn err\n397|\t\t}\n398|\t\treturn failure\n399|\t}\n400|\treturn nil\n401|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c639","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":375,"recorded_at":1780531400000745,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a06ffec6e57320a6928451d3d0cf9c","text":"Read text file `internal/provhost/profile.go`.\n1|package provhost\n2|\n3|// This file maps execution profiles to provider adapter flags under\n4|// Section 7.7. The v0.3.0 yolo mappings below are exact adapter\n5|// strings the host persists into SpawnPlans; standard uses the\n6|// provider's normal approval and sandbox behavior and omits every\n7|// unrestricted flag. The adapter MUST probe the exact provider\n8|// version before applying a mapping, and an absent or changed flag\n9|// fails closed: unknown providers and unknown profiles are refused,\n10|// never defaulted.\n11|\n12|// Execution profiles Section 7.7 defines.\n13|const (\n14|\tProfileStandard = \"standard\"\n15|\tProfileYOLO     = \"yolo\"\n16|)\n17|\n18|// profileProviders lists the six Section 7.7 providers in table\n19|// order. Pi has no permission-mode flag: both of its profiles resolve\n20|// to the default full tool set, and probe and launch output MUST\n21|// disclose that equivalence rather than invent a flag.\n22|var profileProviders = []string{\n23|\t\"codex\",\n24|\t\"claude\",\n25|\t\"gemini\",\n26|\t\"muse\",\n27|\t\"antigravity\",\n28|\t\"pi\",\n29|}\n30|\n31|// profileYOLOMapping is the required yolo adapter flag per provider.\n32|// Standard maps to the empty string for every provider: no flag, no\n33|// alias that silently expands to unrestricted mode.\n34|var profileYOLOMapping = map[string]string{\n35|\t\"codex\":       \"--dangerously-bypass-approvals-and-sandbox\",\n36|\t\"claude\":      \"--dangerously-skip-permissions\",\n37|\t\"gemini\":      \"--approval-mode=yolo\",\n38|\t\"muse\":        \"--yolo\",\n39|\t\"antigravity\": \"--dangerously-skip-permissions\",\n40|\t\"pi\":          \"default_unrestricted_tool_set\",\n41|}\n42|\n43|// ProfileMapping resolves the adapter flag for one provider under one\n44|// profile. Standard returns the empty string: the caller omits every\n45|// unrestricted flag. An unknown provider or profile is an\n46|// invalid_config caller error; there is no default mapping a new\n47|// provider could silently inherit.\n48|func ProfileMapping(providerID, profile string) (string, error) {\n49|\tmapping, known := profileYOLOMapping[providerID]\n50|\tif !known {\n51|\t\tfailure, err := failInvalid(\"profile mapping names an unknown provider\")\n52|\t\tif err != nil {\n53|\t\t\treturn \"\", err\n54|\t\t}\n55|\t\treturn \"\", failure\n56|\t}\n57|\tswitch profile {\n58|\tcase ProfileStandard:\n59|\t\treturn \"\", nil\n60|\tcase ProfileYOLO:\n61|\t\treturn mapping, nil\n62|\tdefault:\n63|\t\tfailure, err := failInvalid(\"profile mapping names an unknown profile\")\n64|\t\tif err != nil {\n65|\t\t\treturn \"\", err\n66|\t\t}\n67|\t\treturn \"\", failure\n68|\t}\n69|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
