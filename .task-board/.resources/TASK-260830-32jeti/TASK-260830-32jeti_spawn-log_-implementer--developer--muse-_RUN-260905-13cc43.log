{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55d","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":265,"recorded_at":1780531400000525,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"90e596e5-4130-4ac6-8e40-de30ae4af667"},"task_id":"90e596e5-4130-4ac6-8e40-de30ae4af667","event":{"kind":"output","task_id":"90e596e5-4130-4ac6-8e40-de30ae4af667","chunk":"Read text file `internal/provhost/closed_vocabularies_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n11|)\n12|\n13|// This file proves the eight closed vocabularies the manifest,\n14|// keyed-operation, and profile-table derivations do not cover are\n15|// exactly the Section 5.5, 7.4, and 7.5 enums: every list below is\n16|// re-read from the pinned document, never from a hand transcription,\n17|// so a provider value the contract never defined reddens here\n18|// rather than passing silently. Sweeping the known members proves\n19|// the rule over those members, not that the vocabulary contains\n20|// exactly those members; these tests prove the containment.\n21|\n22|// codeSpanPattern matches one inline code element, which is how the\n23|// pinned document writes every vocabulary member.\n24|var codeSpanPattern = regexp.MustCompile(`<code>([^<>]*)</code>`)\n25|\n26|// codeSpansOf extracts the code elements of a spec window in order.\n27|// An empty window or a window with no code elements is a blind\n28|// check, so both fail outright.\n29|func codeSpansOf(t *testing.T, window string) []string {\n30|\tt.Helper()\n31|\tif strings.TrimSpace(window) == \"\" {\n32|\t\tt.Fatal(\"spec window is empty; the check is blind\")\n33|\t}\n34|\tspans := codeSpanPattern.FindAllStringSubmatch(window, -1)\n35|\tif len(spans) == 0 {\n36|\t\tt.Fatal(\"spec window holds no code elements; the check is blind\")\n37|\t}\n38|\tvar members []string\n39|\tfor _, span := range spans {\n40|\t\tmembers = append(members, span[1])\n41|\t}\n42|\treturn members\n43|}\n44|\n45|// alternativesOf parses one pipe-separated alternative list out of a\n46|// Section 7.5 table row: the text after marker up to the next comma,\n47|// split on the document's pipe entity. A missing marker or an empty\n48|// list is a blind check, so both fail outright.\n49|func alternativesOf(t *testing.T, row, marker string) []string {\n50|\tt.Helper()\n51|\tstart := strings.Index(row, marker)\n52|\tif start < 0 {\n53|\t\tt.Fatalf(\"Section 7.5 row holds no %q; the check is blind\", marker)\n54|\t}\n55|\trest := row[start+len(marker):]\n56|\tif end := strings.Index(rest, \",\"); end >= 0 {\n57|\t\trest = rest[:end]\n58|\t}\n59|\tif end := strings.Index(rest, \"}\"); end >= 0 {\n60|\t\trest = rest[:end]\n61|\t}\n62|\tmembers := strings.Split(rest, \"&#124;\")\n63|\tvar cleaned []string\n64|\tfor _, member := range members {\n65|\t\tmember = strings.TrimSpace(member)\n66|\t\tif member == \"\" {\n67|\t\t\tt.Fatalf(\"Section 7.5 row %q parses to an empty member; the check is blind\", marker)\n68|\t\t}\n69|\t\tcleaned = append(cleaned, member)\n70|\t}\n71|\tif len(cleaned) == 0 {\n72|\t\tt.Fatalf(\"Section 7.5 row %q parses to no members; the check is blind\", marker)\n73|\t}\n74|\treturn cleaned\n75|}\n76|\n77|// requireVocabulary asserts the implementation holds exactly the\n78|// spec-derived members in the derived order.\n79|func requireVocabulary(t *testing.T, name string, got, want []string) {\n80|\tt.Helper()\n81|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", want) {\n82|\t\tt.Fatalf(\"%s = %v, want the pinned vocabulary %v\", name, got, want)\n83|\t}\n84|\tt.Logf(\"%s coverage: %d/%d vocabulary members derived\", name, len(got), len(want))\n85|}\n86|\n87|// TestProbeStatusVocabularyIsDerivedFromSpec proves the closed\n88|// status vocabulary equals the Section 7.4 sentence: a widened\n89|// implementation admitting \"partial\" reddens here.\n90|func TestProbeStatusVocabularyIsDerivedFromSpec(t *testing.T) {\n91|\tdocument, err := specdoc.Load()\n92|\tif err != nil {\n93|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n94|\t}\n95|\twindow := sectionLines(t, document, \"7.4\", 2869, 2870)\n96|\trequireQuote(t, document, \"Status is one of\", \"7.4\")\n97|\trequireVocabulary(t, \"probeCapabilityStatuses\", probeCapabilityStatuses, codeSpansOf(t, window))\n98|}\n99|\n100|// TestProbeEvidenceVocabularyIsDerivedFromSpec proves the closed\n101|// evidence vocabulary equals the Section 7.4 sentence: a widened\n102|// implementation admitting \"assumed\" reddens here.\n103|func TestProbeEvidenceVocabularyIsDerivedFromSpec(t *testing.T) {\n104|\tdocument, err := specdoc.Load()\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n107|\t}\n108|\twindow := sectionLines(t, document, \"7.4\", 2872, 2874)\n109|\trequireQuote(t, document, \"Evidence is one of\", \"7.4\")\n110|\trequireVocabulary(t, \"probeCapabilityEvidence\", probeCapabilityEvidence, codeSpansOf(t, window))\n111|}\n112|\n113|// TestProbeArchitecturesAreDerivedFromSpec proves the closed\n114|// architecture vocabulary equals both Section 7.4 prose and the\n115|// Section 7.5 probe request row: a widened implementation admitting\n116|// \"386\" reddens here.\n117|func TestProbeArchitecturesAreDerivedFromSpec(t *testing.T) {\n118|\tdocument, err := specdoc.Load()\n119|\tif err != nil {\n120|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n121|\t}\n122|\twindow := sectionLines(t, document, \"7.4\", 2862, 2862)\n123|\trequireQuote(t, document, \"architecture is\", \"7.4\")\n124|\trequireVocabulary(t, \"probeArchitectures\", probeArchitectures, codeSpansOf(t, window))\n125|\trow := sectionLines(t, document, \"7.5\", 3073, 3073)\n126|\trequireVocabulary(t, \"probeArchitectures\", probeArchitectures, alternativesOf(t, row, \"architecture:\"))\n127|}\n128|\n129|// TestProbePlatformsAreDerivedFromSpec proves the closed probe\n130|// platform vocabulary equals the Section 7.5 probe request row. The\n131|// row lists macos first while the implementation holds sorted\n132|// order, so the comparison is sorted on both sides: a widened\n133|// implementation admitting \"freebsd\" reddens here.\n134|func TestProbePlatformsAreDerivedFromSpec(t *testing.T) {\n135|\tdocument, err := specdoc.Load()\n136|\tif err != nil {\n137|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n138|\t}\n139|\trow := sectionLines(t, document, \"7.5\", 3073, 3073)\n140|\tderived := alternativesOf(t, row, \"platform:\")\n141|\tsort.Strings(derived)\n142|\tgot := append([]string(nil), probePlatforms...)\n143|\tsort.Strings(got)\n144|\trequireVocabulary(t, \"probePlatforms\", got, derived)\n145|}\n146|\n147|// TestQuiesceBlockersAreDerivedFromSpec proves the closed blocker\n148|// enum equals the Section 7.5 sentence: a widened implementation\n149|// admitting \"other\" reddens here.\n150|func TestQuiesceBlockersAreDerivedFromSpec(t *testing.T) {\n151|\tdocument, err := specdoc.Load()\n152|\tif err != nil {\n153|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n154|\t}\n155|\twindow := sectionLines(t, document, \"7.5\", 2907, 2910)\n156|\trequireQuote(t, document, \"blockers\", \"7.5\")\n157|\tspans := codeSpansOf(t, window)\n158|\tif spans[0] != \"SafeBoundaryProof.blockers\" {\n159|\t\tt.Fatalf(\"blocker enum window opens with %q, want the enum owner; the check is blind\", spans[0])\n160|\t}\n161|\trequireVocabulary(t, \"quiesceBlockers\", quiesceBlockers, spans[1:])\n162|}\n163|\n164|// TestIdentityKindsAreDerivedFromSpec proves the closed\n165|// identity-kind enum equals the Section 5.5 table row: a widened\n166|// implementation admitting \"legacy_alias\" reddens here.\n167|func TestIdentityKindsAreDerivedFromSpec(t *testing.T) {\n168|\tdocument, err := specdoc.Load()\n169|\tif err != nil {\n170|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n171|\t}\n172|\twindow := sectionLines(t, document, \"5.5\", 2086, 2086)\n173|\tspans := codeSpansOf(t, window)\n174|\tif len(spans) == 0 || spans[0] != \"identity_kind\" {\n175|\t\tt.Fatalf(\"identity-kind row opens with %v, want the member cell; the check is blind\", spans)\n176|\t}\n177|\trequireVocabulary(t, \"identityKinds\", identityKinds, spans[1:])\n178|}\n179|\n180|// TestIdentifyVocabulariesAreDerivedFromSpec proves the closed\n181|// identify-session confidence and matched-evidence vocabularies\n182|// equal the Section 7.5 row: a widened implementation admitting\n183|// \"guess\" or \"guessed\" reddens here.\n184|func TestIdentifyVocabulariesAreDerivedFromSpec(t *testing.T) {\n185|\tdocument, err := specdoc.Load()\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n188|\t}\n189|\trow := sectionLines(t, document, \"7.5\", 3075, 3075)\n190|\trequireVocabulary(t, \"identifyConfidences\", identifyConfidences, alternativesOf(t, row, \"confidence:\"))\n191|\tevidence := alternativesOf(t, row, \"matched_evidence:sorted unique \")\n192|\tfor index, member := range evidence {\n193|\t\tif bracket := strings.Index(member, \"[\"); bracket >= 0 {\n194|\t\t\tevidence[index] = member[:bracket]\n195|\t\t}\n196|\t}\n197|\trequireVocabulary(t, \"identifyEvidence\", identifyEvidence, evidence)\n198|}\n199|\n200|// identifyResultBody renders the Section 5.5 example inside the\n201|// identify-session success shape: the same body\n202|// TestDecodeIdentifyResultFixtures drives.\n203|func identifyResultBody(t *testing.T) []byte {\n204|\tt.Helper()\n205|\tindented := strings.ReplaceAll(specIdentityExample, \"\\n\", \"\\n  \")\n206|\treturn []byte(specIdentifyResultPrefix + \"  \" + strings.TrimPrefix(indented, \"  \") + `,\n207|  \"confidence\": \"exact\",\n208|  \"matched_evidence\": [\"native_id\"]\n209|}`)\n210|}\n211|\n212|// identifyResultVariant rewrites one unique substring of that body.\n213|func identifyResultVariant(t *testing.T, old, new string) []byte {\n214|\tt.Helper()\n215|\tfull := string(identifyResultBody(t))\n216|\tif strings.Count(full, old) != 1 {\n217|\t\tt.Fatalf(\"identify variant anchor %q is not unique\", old)\n218|\t}\n219|\treturn []byte(strings.Replace(full, old, new, 1))\n220|}\n221|\n222|// TestClosedVocabularyWideningsRefuse drives the exact widened\n223|// members the derivation tests pin through the production entry\n224|// points: each is refused at its own arm, so a vocabulary that\n225|// admits one more value reddens twice — once here, once above.\n226|func TestClosedVocabularyWideningsRefuse(t *testing.T) {\n227|\tt.Run(\"probe status partial\", func(t *testing.T) {\n228|\t\tbody := probeVariant(t, `\"status\": \"unknown\",\n229|      \"enabled\": false,\n230|      \"evidence\": \"none\",\n231|      \"detail\": \"not claimed for v0.3.0\"`, `\"status\": \"partial\",\n232|      \"enabled\": false,\n233|      \"evidence\": \"none\",\n234|      \"detail\": \"not claimed for v0.3.0\"`)\n235|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"status is not a registry member\")\n236|\t})\n237|\tt.Run(\"probe evidence assumed\", func(t *testing.T) {\n238|\t\tbody := probeVariant(t, `\"evidence\": \"probed\",`, `\"evidence\": \"assumed\",`)\n239|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"evidence is not a registry member\")\n240|\t})\n241|\tt.Run(\"probe architecture 386\", func(t *testing.T) {\n242|\t\tbody := probeVariant(t, `\"architecture\": \"arm64\"`, `\"architecture\": \"386\"`)\n243|\t\trequireFrameRefusal(t, DecodeProbe(body), \"architecture\", \"not amd64 or arm64\")\n244|\t})\n245|\tt.Run(\"probe platform freebsd\", func(t *testing.T) {\n246|\t\tbody := probeVariant(t, `\"platform\": \"macos\"`, `\"platform\": \"freebsd\"`)\n247|\t\trequireFrameRefusal(t, DecodeProbe(body), \"platform\", \"not a registry member\")\n248|\t})\n249|\tt.Run(\"quiesce blocker other\", func(t *testing.T) {\n250|\t\tbody := quiesceVariant(t, `\"blockers\": []`, `\"blockers\": [\"other\"]`)\n251|\t\trequireFrameRefusal(t, quiesceErr(body), \"blockers\", \"unknown blocker\")\n252|\t})\n253|\tt.Run(\"identity kind legacy_alias\", func(t *testing.T) {\n254|\t\tbody := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"legacy_alias\"`)\n255|\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"identity_kind\", \"not a registry member\")\n256|\t})\n257|\tt.Run(\"identify confidence guess\", func(t *testing.T) {\n258|\t\tbody := identifyResultVariant(t, `\"confidence\": \"exact\"`, `\"confidence\": \"guess\"`)\n259|\t\trequireFrameRefusal(t, DecodeIdentifyResult(body, \"antigravity\"), \"confidence\", \"not exact strong or weak\")\n260|\t})\n261|\tt.Run(\"identify evidence guessed\", func(t *testing.T) {\n262|\t\tbody := identifyResultVariant(t, `\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"guessed\"]`)\n263|\t\trequireFrameRefusal(t, DecodeIdentifyResult(body, \"antigravity\"), \"matched_evidence\", \"unknown member\")\n264|\t})\n265|}"}}}
