{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c819","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":615,"recorded_at":1780531400001225,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"d3527c44-5b40-4d44-83dd-ea118724d246"},"task_id":"d3527c44-5b40-4d44-83dd-ea118724d246","event":{"kind":"output","task_id":"d3527c44-5b40-4d44-83dd-ea118724d246","chunk":"Read text file `internal/provhost/spawn_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// specResumePlan is the normative resume success body (Section 7.5),\n12|// copied verbatim from the pinned document: a codex yolo plan whose\n13|// profile_mapping carries the exact Section 7.7 adapter flag.\n14|const specResumePlan = `{\n15|    \"argv\": [\n16|      \"codex\",\n17|      \"--dangerously-bypass-approvals-and-sandbox\",\n18|      \"resume\",\n19|      \"11111111-2222-4333-8444-555555555555\"\n20|    ],\n21|    \"cwd\": \"/srv/relux/payments-api/src\",\n22|    \"env_names\": [\"OPENAI_API_KEY\"],\n23|    \"env_literals\": {},\n24|    \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n25|    \"profile_mapping\": \"--dangerously-bypass-approvals-and-sandbox\",\n26|    \"extensions\": {}\n27|  }`\n28|\n29|// TestSpecResumePlanDecodes proves the normative resume body passes\n30|// the production entry point for its provider, profile, and\n31|// platform, and that the embedded profile_mapping equals the\n32|// Section 7.7 mapping rather than merely being present.\n33|func TestSpecResumePlanDecodes(t *testing.T) {\n34|\tif err := DecodeSpawnPlan([]byte(specResumePlan), \"codex\", ProfileYOLO, scalar.PlatformLinux); err != nil {\n35|\t\tt.Fatalf(\"DecodeSpawnPlan(spec resume): %v\", err)\n36|\t}\n37|\tmapping, err := ProfileMapping(\"codex\", ProfileYOLO)\n38|\tif err != nil {\n39|\t\tt.Fatalf(\"ProfileMapping(codex, yolo): %v\", err)\n40|\t}\n41|\tif !strings.Contains(specResumePlan, `\"profile_mapping\": \"`+mapping+`\"`) {\n42|\t\tt.Fatalf(\"spec resume profile_mapping does not carry the Section 7.7 mapping %q\", mapping)\n43|\t}\n44|}\n45|\n46|// spawnVariant rewrites one unique substring of the normative plan.\n47|func spawnVariant(t *testing.T, old, new string) []byte {\n48|\tt.Helper()\n49|\tif strings.Count(specResumePlan, old) != 1 {\n50|\t\tt.Fatalf(\"spawn variant anchor %q is not unique\", old)\n51|\t}\n52|\treturn []byte(strings.Replace(specResumePlan, old, new, 1))\n53|}\n54|\n55|// TestDecodeSpawnPlanRefusals drives every SpawnPlan rule.\n56|func TestDecodeSpawnPlanRefusals(t *testing.T) {\n57|\tlong4096 := strings.Repeat(\"a\", 4096)\n58|\tlong4097 := strings.Repeat(\"a\", 4097)\n59|\tlong512 := strings.Repeat(\"m\", 512)\n60|\tlong513 := strings.Repeat(\"m\", 513)\n61|\trows := []struct {\n62|\t\tname   string\n63|\t\tbody   []byte\n64|\t\tmember string\n65|\t\tdetail string\n66|\t}{\n67|\t\t{\"unknown member\", spawnVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"priority\": 1`), \"priority\", \"unknown member\"},\n68|\t\t{\"missing member\", []byte(strings.Replace(specResumePlan, `,\n69|    \"extensions\": {}`, ``, 1)), \"extensions\", \"misses a required member\"},\n70|\t\t{\"argv empty\", spawnVariant(t, `\"argv\": [\n71|      \"codex\",\n72|      \"--dangerously-bypass-approvals-and-sandbox\",\n73|      \"resume\",\n74|      \"11111111-2222-4333-8444-555555555555\"\n75|    ]`, `\"argv\": []`), \"argv\", \"empty or longer than 128\"},\n76|\t\t{\"argv empty element\", spawnVariant(t, `\"resume\",`, `\"resume\", \"\",`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n77|\t\t{\"argv long element\", spawnVariant(t, `\"resume\",`, `\"resume\", \"`+long4097+`\",`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n78|\t\t{\"argv non-string\", spawnVariant(t, `\"resume\",`, `\"resume\", 7,`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n79|\t\t{\"argv NUL element\", spawnVariant(t, `\"resume\",`, `\"resume\", \"a\\u0000b\",`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n80|\t\t{\"argv 129 elements\", spawnVariant(t, `\"argv\": [\n81|      \"codex\",\n82|      \"--dangerously-bypass-approvals-and-sandbox\",\n83|      \"resume\",\n84|      \"11111111-2222-4333-8444-555555555555\"\n85|    ]`, `\"argv\": [`+strings.Repeat(`\"a\", `, 128)+`\"a\"]`), \"argv\", \"empty or longer than 128\"},\n86|\t\t{\"argv exceeds 65536 total\", spawnVariant(t, `\"argv\": [\n87|      \"codex\",\n88|      \"--dangerously-bypass-approvals-and-sandbox\",\n89|      \"resume\",\n90|      \"11111111-2222-4333-8444-555555555555\"\n(more lines below)"}}}
