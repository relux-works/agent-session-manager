{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c821","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":619,"recorded_at":1780531400001233,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a07000b9ee7543acb3c22d76b1a3a4","text":"Read text file `internal/provhost/status_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"encoding/base64\"\n7|\t\"encoding/json\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|)\n12|\n13|const (\n14|\ttestMaterializationID = \"0198f4c8-c290-73aa-9374-1234567890ab\"\n15|\ttestTransactionID     = \"0198f4c8-f5c0-76dd-9677-1234567890ab\"\n16|\ttestAuthorityID       = \"provider_transaction\"\n17|\ttestPlanID            = \"sha256:64644a5ad573d36c0c13f44f56ef25ab93cff33001ff2a3371b082603910f2dd\"\n18|\ttestRollbackToken     = \"YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5QUI\"\n19|\ttestDiscovery         = `{\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"discovered\":true,\"discovery_root\":\"/srv/provider/sessions\",\"backend_resolved\":false}`\n20|)\n21|\n22|func testStatusIDs() StatusIDs {\n23|\treturn StatusIDs{\n24|\t\tMaterializationID:      testMaterializationID,\n25|\t\tTransactionID:          testTransactionID,\n26|\t\tTransactionAuthorityID: testAuthorityID,\n27|\t}\n28|}\n29|\n30|// statusBody builds a ProviderTransactionStatus body. Null members are\n31|// passed as the literal null.\n32|func statusBody(materializationID, transactionID, authorityID, planID, state, token, discovery string) []byte {\n33|\tquote := func(value, fallback string) string {\n34|\t\tif value == \"null\" {\n35|\t\t\treturn \"null\"\n36|\t\t}\n37|\t\tif value == \"\" {\n38|\t\t\treturn fallback\n39|\t\t}\n40|\t\treturn `\"` + value + `\"`\n41|\t}\n42|\treturn []byte(`{\"materialization_id\":` + quote(materializationID, `\"x\"`) +\n43|\t\t`,\"transaction_id\":` + quote(transactionID, `\"x\"`) +\n44|\t\t`,\"transaction_authority_id\":` + quote(authorityID, `\"x\"`) +\n45|\t\t`,\"plan_id\":` + quote(planID, `\"x\"`) +\n46|\t\t`,\"state\":\"` + state + `\"` +\n47|\t\t`,\"rollback_token\":` + quote(token, `\"x\"`) +\n48|\t\t`,\"native_discovery\":` + discovery + `}`)\n49|}\n50|\n51|func preparedBody() []byte {\n52|\treturn statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n53|}\n54|\n55|// TestDecodeStatusOutcomeAcceptsTerminalStates proves the positive\n56|// recovery path: prepared, committed, and rolled_back observations with\n57|// the state their nullability rules require are returned as-is.\n58|func TestDecodeStatusOutcomeAcceptsTerminalStates(t *testing.T) {\n59|\tfor _, kase := range []struct {\n60|\t\tname  string\n61|\t\tbody  []byte\n62|\t\tstate StatusState\n63|\t}{\n64|\t\t{\"prepared\", preparedBody(), StatusPrepared},\n65|\t\t{\"committed\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), StatusCommitted},\n66|\t\t{\"rolled back\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"rolled_back\", \"null\", testDiscovery), StatusRolledBack},\n67|\t} {\n68|\t\tt.Run(kase.name, func(t *testing.T) {\n69|\t\t\tgot, err := DecodeStatusOutcome(kase.body, testStatusIDs())\n70|\t\t\tif err != nil {\n71|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome: %v\", err)\n72|\t\t\t}\n73|\t\t\tif got != kase.state {\n74|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want %q\", got, kase.state)\n75|\t\t\t}\n76|\t\t})\n77|\t}\n78|}\n79|\n80|// TestDecodeStatusOutcomeUnknownFailsClosed proves the quarantine rule:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c823","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":620,"recorded_at":1780531400001235,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a07000bafc7490b9d972da7ebf48e8","text":"Read text file `internal/provhost/quiesce_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// safeQuiesceProof is a SafeBoundaryProof with every fact proven:\n9|// empty blockers, both idle flags true, zero counts, and non-null\n10|// boundary and store generation under safe true.\n11|const safeQuiesceProof = `{\n12|  \"provider_id\": \"codex\",\n13|  \"provider_version\": \"0.147.0\",\n14|  \"input_blocked\": true,\n15|  \"boundary_ref\": \"provider-event-42\",\n16|  \"foreground_idle\": true,\n17|  \"background_idle\": true,\n18|  \"open_child_count\": 0,\n19|  \"open_database_handle_count\": 0,\n20|  \"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",\n21|  \"safe\": true,\n22|  \"blockers\": []\n23|}`\n24|\n25|// TestSafeQuiesceProofDecodes proves the fully proven safe proof\n26|// passes the production entry point.\n27|// quiesceErr drives the proof decoder for refusal assertions: the\n28|// safe bit is observed in the positive tests, never here.\n29|func quiesceErr(body []byte) error {\n30|\t_, err := DecodeQuiesceProof(body)\n31|\treturn err\n32|}\n33|\n34|func TestSafeQuiesceProofDecodes(t *testing.T) {\n35|\tsafe, err := DecodeQuiesceProof([]byte(safeQuiesceProof))\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"DecodeQuiesceProof(safe): %v\", err)\n38|\t}\n39|\tif !safe {\n40|\t\tt.Fatal(\"DecodeQuiesceProof(safe) = false, want the observed safe bit true\")\n41|\t}\n42|}\n43|\n44|// TestUnsafeQuiesceProofsDecode proves unsafe proofs are honest\n45|// observations, not refusals: safe false validates with blockers,\n46|// open counts, or null generation present.\n47|func TestUnsafeQuiesceProofsDecode(t *testing.T) {\n48|\tbodies := []string{\n49|\t\tstrings.Replace(safeQuiesceProof, `\"safe\": true,`, `\"safe\": false,`, 1),\n50|\t\tstrings.Replace(safeQuiesceProof, `\"blockers\": []`, `\"blockers\": [\"provider_busy\"]`, 1),\n51|\t\tstrings.Replace(safeQuiesceProof, `\"open_child_count\": 0,`, `\"open_child_count\": 2,`, 1),\n52|\t\tstrings.Replace(safeQuiesceProof, `\"background_idle\": true,`, `\"background_idle\": null,`, 1),\n53|\t\tstrings.Replace(safeQuiesceProof, `\"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",`, `\"store_generation\": null,`, 1),\n54|\t}\n55|\tfor index, body := range bodies {\n56|\t\tunsafe := body\n57|\t\tif !strings.Contains(unsafe, `\"safe\": false`) {\n58|\t\t\tunsafe = strings.Replace(unsafe, `\"safe\": true,`, `\"safe\": false,`, 1)\n59|\t\t}\n60|\t\tsafe, err := DecodeQuiesceProof([]byte(unsafe))\n61|\t\tif err != nil {\n62|\t\t\tt.Fatalf(\"unsafe proof %d refused: %v\", index, err)\n63|\t\t}\n64|\t\tif safe {\n65|\t\t\tt.Fatalf(\"unsafe proof %d reports safe true\", index)\n66|\t\t}\n67|\t}\n68|}\n69|\n70|// quiesceVariant rewrites one unique substring of the safe proof.\n71|func quiesceVariant(t *testing.T, old, new string) []byte {\n72|\tt.Helper()\n73|\tif strings.Count(safeQuiesceProof, old) != 1 {\n74|\t\tt.Fatalf(\"quiesce variant anchor %q is not unique\", old)\n75|\t}\n76|\treturn []byte(strings.Replace(safeQuiesceProof, old, new, 1))\n77|}\n78|\n79|// TestDecodeQuiesceSafeLies enumerates the safe-rule conjuncts: each\n80|// fixture violates exactly one proven fact while claiming safe true,\n81|// and every one is refused under the same arm. Deleting any conjunct\n82|// from the production disjunction admits its fixture and reddens.\n83|func TestDecodeQuiesceSafeLies(t *testing.T) {\n84|\trows := []struct {\n85|\t\tname string\n86|\t\tbody []byte\n87|\t}{\n88|\t\t{\"blockers open\", quiesceVariant(t, `\"blockers\": []`, `\"blockers\": [\"child_process_open\"]`)},\n89|\t\t{\"input flowing\", quiesceVariant(t, `\"input_blocked\": true,`, `\"input_blocked\": false,`)},\n90|\t\t{\"foreground busy\", quiesceVariant(t, `\"foreground_idle\": true,`, `\"foreground_idle\": false,`)},\n91|\t\t{\"background null\", quiesceVariant(t, `\"background_idle\": true,`, `\"background_idle\": null,`)},\n92|\t\t{\"background false\", quiesceVariant(t, `\"background_idle\": true,`, `\"background_idle\": false,`)},\n93|\t\t{\"boundary null\", quiesceVariant(t, `\"boundary_ref\": \"provider-event-42\",`, `\"boundary_ref\": null,`)},\n94|\t\t{\"generation null\", quiesceVariant(t, `\"store_generation\": \"closed:11111111-2222-4333-8444-555555555555:1\",`, `\"store_generation\": null,`)},\n95|\t\t{\"child open\", quiesceVariant(t, `\"open_child_count\": 0,`, `\"open_child_count\": 1,`)},\n96|\t\t{\"database handle open\", quiesceVariant(t, `\"open_database_handle_count\": 0,`, `\"open_database_handle_count\": 1,`)},\n97|\t}\n98|\tfor _, row := range rows {\n99|\t\tt.Run(row.name, func(t *testing.T) {\n100|\t\t\trequireFrameRefusal(t, quiesceErr(row.body), \"safe\", \"leaves a fact unproven\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c825","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":621,"recorded_at":1780531400001237,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"call_id":"call_01a07000bc2871a3aa25b5c482f72a0c","text":"Read text file `internal/provhost/spawn_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// specResumePlan is the normative resume success body (Section 7.5),\n12|// copied verbatim from the pinned document: a codex yolo plan whose\n13|// profile_mapping carries the exact Section 7.7 adapter flag.\n14|const specResumePlan = `{\n15|    \"argv\": [\n16|      \"codex\",\n17|      \"--dangerously-bypass-approvals-and-sandbox\",\n18|      \"resume\",\n19|      \"11111111-2222-4333-8444-555555555555\"\n20|    ],\n21|    \"cwd\": \"/srv/relux/payments-api/src\",\n22|    \"env_names\": [\"OPENAI_API_KEY\"],\n23|    \"env_literals\": {},\n24|    \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n25|    \"profile_mapping\": \"--dangerously-bypass-approvals-and-sandbox\",\n26|    \"extensions\": {}\n27|  }`\n28|\n29|// TestSpecResumePlanDecodes proves the normative resume body passes\n30|// the production entry point for its provider, profile, and\n31|// platform, and that the embedded profile_mapping equals the\n32|// Section 7.7 mapping rather than merely being present.\n33|func TestSpecResumePlanDecodes(t *testing.T) {\n34|\tif err := DecodeSpawnPlan([]byte(specResumePlan), \"codex\", ProfileYOLO, scalar.PlatformLinux); err != nil {\n35|\t\tt.Fatalf(\"DecodeSpawnPlan(spec resume): %v\", err)\n36|\t}\n37|\tmapping, err := ProfileMapping(\"codex\", ProfileYOLO)\n38|\tif err != nil {\n39|\t\tt.Fatalf(\"ProfileMapping(codex, yolo): %v\", err)\n40|\t}\n41|\tif !strings.Contains(specResumePlan, `\"profile_mapping\": \"`+mapping+`\"`) {\n42|\t\tt.Fatalf(\"spec resume profile_mapping does not carry the Section 7.7 mapping %q\", mapping)\n43|\t}\n44|}\n45|\n46|// spawnVariant rewrites one unique substring of the normative plan.\n47|func spawnVariant(t *testing.T, old, new string) []byte {\n48|\tt.Helper()\n49|\tif strings.Count(specResumePlan, old) != 1 {\n50|\t\tt.Fatalf(\"spawn variant anchor %q is not unique\", old)\n51|\t}\n52|\treturn []byte(strings.Replace(specResumePlan, old, new, 1))\n53|}\n54|\n55|// TestDecodeSpawnPlanRefusals drives every SpawnPlan rule.\n56|func TestDecodeSpawnPlanRefusals(t *testing.T) {\n57|\tlong4096 := strings.Repeat(\"a\", 4096)\n58|\tlong4097 := strings.Repeat(\"a\", 4097)\n59|\tlong512 := strings.Repeat(\"m\", 512)\n60|\tlong513 := strings.Repeat(\"m\", 513)\n61|\trows := []struct {\n62|\t\tname   string\n63|\t\tbody   []byte\n64|\t\tmember string\n65|\t\tdetail string\n66|\t}{\n67|\t\t{\"unknown member\", spawnVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"priority\": 1`), \"priority\", \"unknown member\"},\n68|\t\t{\"missing member\", []byte(strings.Replace(specResumePlan, `,\n69|    \"extensions\": {}`, ``, 1)), \"extensions\", \"misses a required member\"},\n70|\t\t{\"argv empty\", spawnVariant(t, `\"argv\": [\n71|      \"codex\",\n72|      \"--dangerously-bypass-approvals-and-sandbox\",\n73|      \"resume\",\n74|      \"11111111-2222-4333-8444-555555555555\"\n75|    ]`, `\"argv\": []`), \"argv\", \"empty or longer than 128\"},\n76|\t\t{\"argv empty element\", spawnVariant(t, `\"resume\",`, `\"resume\", \"\",`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n77|\t\t{\"argv long element\", spawnVariant(t, `\"resume\",`, `\"resume\", \"`+long4097+`\",`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n78|\t\t{\"argv non-string\", spawnVariant(t, `\"resume\",`, `\"resume\", 7,`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n79|\t\t{\"argv NUL element\", spawnVariant(t, `\"resume\",`, `\"resume\", \"a\\u0000b\",`), \"argv\", \"not 1..4096 NUL-free bytes\"},\n80|\t\t{\"argv 129 elements\", spawnVariant(t, `\"argv\": [\n81|      \"codex\",\n82|      \"--dangerously-bypass-approvals-and-sandbox\",\n83|      \"resume\",\n84|      \"11111111-2222-4333-8444-555555555555\"\n85|    ]`, `\"argv\": [`+strings.Repeat(`\"a\", `, 128)+`\"a\"]`), \"argv\", \"empty or longer than 128\"},\n86|\t\t{\"argv exceeds 65536 total\", spawnVariant(t, `\"argv\": [\n87|      \"codex\",\n88|      \"--dangerously-bypass-approvals-and-sandbox\",\n89|      \"resume\",\n90|      \"11111111-2222-4333-8444-555555555555\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
