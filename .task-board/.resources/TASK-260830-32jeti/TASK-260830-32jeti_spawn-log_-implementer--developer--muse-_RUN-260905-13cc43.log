{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8e7","stream":{"kind":"session","id":"01a06ffe-0d1f-7ed2-b330-e35e6f06a0ee"},"sequence":718,"recorded_at":1780531400001431,"record_type":"event","durability":"durable","causation_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b","run_stream":{"kind":"run","id":"f683aec3-8d4a-44b0-bdc9-05bef3ee2f1b"},"task_stream":{"kind":"task","id":"d519b5b0-787a-41a6-becb-fd7346203aff"},"task_id":"d519b5b0-787a-41a6-becb-fd7346203aff","event":{"kind":"output","task_id":"d519b5b0-787a-41a6-becb-fd7346203aff","chunk":"Read text file `internal/provhost/status_test.go`.\n(159 line(s) above)\n160|\n161|// TestDecodeStatusOutcomeRefusesMalformedBodies proves uninterpretable\n162|// observations fail closed with integrity_failure rather than as absent\n163|// or partial states.\n164|func TestDecodeStatusOutcomeRefusesMalformedBodies(t *testing.T) {\n165|\tgood := string(preparedBody())\n166|\tfor _, kase := range []struct {\n167|\t\tname   string\n168|\t\tbody   string\n169|\t\tdetail string\n170|\t}{\n171|\t\t{\"empty\", ``, \"status body is not a JSON object\"},\n172|\t\t{\"not JSON\", `oops`, \"status body is not a JSON object\"},\n173|\t\t{\"array\", `[]`, \"status body is not a JSON object\"},\n174|\t\t{\"scalar\", `1`, \"status body is not a JSON object\"},\n175|\t\t{\"trailing data\", good + \"x\", \"status body is trailing data after the object\"},\n176|\t\t{\"duplicate member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1), \"status body is duplicate member\"},\n177|\t\t{\"unknown member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"phase\":\"prepared\"`, 1), \"status body carries unknown member\"},\n178|\t\t{\"missing plan\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\",`, ``, 1), \"status body misses a required member\"},\n179|\t\t{\"missing state\", strings.Replace(good, `,\"state\":\"prepared\"`, ``, 1), \"status body misses a required member\"},\n180|\t\t{\"bad state\", strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1), \"status state is not a registry member\"},\n181|\t\t{\"non-string state\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":7`, 1), \"status state is not a registry member\"},\n182|\t\t{\"malformed digest\", strings.Replace(good, testPlanID, \"sha256:xyz\", 1), \"status plan_id is not a digest\"},\n183|\t\t{\"non-string digest\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1), \"status plan_id is not a string\"},\n184|\t\t{\"short token\", strings.Replace(good, testRollbackToken, \"YWJj\", 1), \"status rollback_token is shorter than 256 bits\"},\n185|\t\t{\"non-base64 token\", strings.Replace(good, testRollbackToken, \"!!!not-base64!!!\", 1), \"status rollback_token is shorter than 256 bits\"},\n186|\t\t{\"non-string token\", strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1), \"status rollback_token is not a string\"},\n187|\t\t{\"scalar discovery\", strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1), \"status native_discovery is not an object\"},\n188|\t\t{\"malformed operation id\", strings.Replace(good, `\"materialization_id\"`, `\"operation_id\":\"bogus\",\"materialization_id\"`, 1), \"status operation_id is not a UUIDv7\"},\n189|\t\t{\"non-string operation id\", strings.Replace(good, `\"materialization_id\"`, `\"operation_id\":7,\"materialization_id\"`, 1), \"status operation_id is not a string\"},\n190|\t} {\n191|\t\tt.Run(kase.name, func(t *testing.T) {\n192|\t\t\t_, err := DecodeStatusOutcome([]byte(kase.body), testStatusIDs())\n193|\t\t\trequireLocalRefusal(t, err, \"integrity_failure\", kase.detail)\n194|\t\t})\n195|\t}\n196|}\n197|\n198|// tokenWithDecodedBytes builds a base64url rollback token decoding to\n199|// exactly n bytes, so the 256-bit floor is pinned from both sides rather\n200|// than only somewhere between the 3-byte short fixture and the 38-byte\n201|// valid one.\n202|func tokenWithDecodedBytes(t *testing.T, n int) string {\n203|\tt.Helper()\n204|\ttoken := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{0x9e}, n))\n205|\traw, err := base64.RawURLEncoding.DecodeString(token)\n206|\tif err != nil {\n207|\t\tt.Fatalf(\"DecodeString: %v\", err)\n208|\t}\n209|\tif len(raw) != n {\n210|\t\tt.Fatalf(\"token decodes to %d bytes, want exactly %d\", len(raw), n)\n211|\t}\n212|\treturn token\n213|}\n214|\n215|// TestDecodeStatusOutcomeEnforcesTokenEntropyFloor proves the 256-bit\n216|// rollback-token floor exactly: a token decoding to 31 bytes fails, and\n217|// one decoding to 32 bytes is accepted. Any weakened floor at or below\n218|// 248 bits admits the 31-byte token; any raised floor rejects the valid\n219|// 32-byte observation. The production entry point is DecodeStatusOutcome.\n(more lines below)"}}}
