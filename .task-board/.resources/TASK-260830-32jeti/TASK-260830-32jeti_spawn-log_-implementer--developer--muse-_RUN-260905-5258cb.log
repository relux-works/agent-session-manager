{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cce1","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":1227,"recorded_at":1780531400002449,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"f7fd4138-0696-43a0-9b64-51fab3b9c0ec"},"task_id":"f7fd4138-0696-43a0-9b64-51fab3b9c0ec","event":{"kind":"output","task_id":"f7fd4138-0696-43a0-9b64-51fab3b9c0ec","chunk":"edited\nchanged lines: line 2844\n--- original\n+++ updated\n@@\n-      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.3; the RFC 2119 scanner measures no clause line under 7.3, because the closed Provider Manifest states its obligations as a required-member table, a 16-entry operation registry and exactly 7 capability names rather than in uppercase keywords, so the gate cannot measure this section - and no provider manifest is implemented anywhere in this repository.\"\n+      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.3; the RFC 2119 scanner measures no clause line under 7.3, because the closed Provider Manifest states its obligations as a required-member table, a 16-entry operation registry and exactly 7 capability names rather than in uppercase keywords, so the gate cannot measure this section - and the closed manifest is implemented in internal/provhost DecodeManifest, exercised by the provhost conformance suite.\"\n"}}}
