{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"call_id":"call_01a0706168937983ac9c5be77de3f832","text":"Read text file `internal/traceability/traceability.go`.\n(439 line(s) above)\n440|\t\tcase coverageFull:\n441|\t\t\treport.FullCoverage++\n442|\t\tcase coveragePartial:\n443|\t\t\treport.PartialCoverage++\n444|\t\tcase coverageSliver:\n445|\t\t\treport.SliverCoverage++\n446|\t\tcase coverageUnevidenced:\n447|\t\t\treport.UnevidencedCoverage++\n448|\t\tcase coverageUnmeasured:\n449|\t\t\treport.UnmeasuredCoverage++\n450|\t\t}\n451|\t}\n452|\treturn report, nil\n453|}\n454|\n455|// verifySectionCoverage measures every registered section binding against the\n456|// pinned document and refuses a coverage claim on any other ownership kind. A\n457|// contract or fixture owner has no section to be measured against, so a\n458|// coverage field there would be a claim the gate cannot check.\n459|func verifySectionCoverage(\n460|\tdocument *specdoc.Document,\n461|\tgroups []ownershipGroup,\n462|\tacceptanceIDs map[string]struct{},\n463|) (map[string]sectionCoverage, error) {\n464|\tresult := make(map[string]sectionCoverage)\n465|\tfor index, group := range groups {\n466|\t\tif group.Kind != ownershipSectionBinding {\n467|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n468|\t\t\t\treturn nil, fail(\n469|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n470|\t\t\t\t\tindex, group.Kind)\n471|\t\t\t}\n472|\t\t\tcontinue\n473|\t\t}\n474|\t\tif len(group.Keys) != 1 {\n475|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n476|\t\t}\n477|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n478|\t\tif err != nil {\n479|\t\t\treturn nil, err\n480|\t\t}\n481|\t\tif _, duplicate := result[measured.Key]; duplicate {\n482|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n483|\t\t}\n484|\t\tresult[measured.Key] = measured\n485|\t}\n486|\treturn result, nil\n487|}\n488|\n489|func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\n490|\tif len(cases) == 0 {\n491|\t\treturn nil, fail(\"acceptance case registry is empty\")\n492|\t}\n493|\tseen := make(map[string]struct{}, len(cases))\n494|\tfor index, acceptance := range cases {\n495|\t\tif acceptance.ID == \"\" {\n496|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n497|\t\t}\n498|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n499|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n500|\t\t}\n501|\t\tseen[acceptance.ID] = struct{}{}\n502|\t\tif err := checker.verify(acceptance.Production, false); err != nil {\n503|\t\t\treturn nil, fail(\"acceptance case %q production owner: %v\", acceptance.ID, err)\n504|\t\t}\n505|\t\tif len(acceptance.Tests) == 0 {\n506|\t\t\treturn nil, fail(\"acceptance case %q has no executable test owner\", acceptance.ID)\n507|\t\t}\n508|\t\ttestSeen := make(map[codeReference]struct{}, len(acceptance.Tests))\n509|\t\tfor _, test := range acceptance.Tests {\n510|\t\t\tif _, duplicate := testSeen[test]; duplicate {\n511|\t\t\t\treturn nil, fail(\"acceptance case %q repeats test owner %s:%s\", acceptance.ID, test.Path, test.Declaration)\n512|\t\t\t}\n513|\t\t\ttestSeen[test] = struct{}{}\n514|\t\t\tif err := checker.verify(test, true); err != nil {\n515|\t\t\t\treturn nil, fail(\"acceptance case %q test owner: %v\", acceptance.ID, err)\n516|\t\t\t}\n517|\t\t}\n518|\t}\n519|\treturn seen, nil\n520|}\n521|\n522|func verifyOwnershipGroups(\n523|\tchecker *sourceChecker,\n524|\tgroups []ownershipGroup,\n525|\tacceptanceIDs map[string]struct{},\n526|\tallowed map[ownershipKind]map[string]struct{},\n527|\trequired map[ownershipKind]map[string]struct{},\n528|\tselectedSectionBindings map[string]struct{},\n529|) (map[ownershipKind]map[string]struct{}, error) {\n530|\towned := map[ownershipKind]map[string]struct{}{\n531|\t\townershipContract:         make(map[string]struct{}),\n532|\t\townershipNormativeSection: make(map[string]struct{}),\n533|\t\townershipSectionBinding:   make(map[string]struct{}),\n534|\t\townershipFixture:          make(map[string]struct{}),\n535|\t}\n536|\tif len(groups) == 0 {\n537|\t\treturn nil, fail(\"implementation ownership registry is empty\")\n538|\t}\n539|\tfor index, group := range groups {\n540|\t\tif _, ok := allowed[group.Kind]; !ok {\n541|\t\t\treturn nil, fail(\"ownership group %d has unknown kind %q\", index, group.Kind)\n542|\t\t}\n543|\t\tif group.Kind == ownershipSectionBinding && selectedSectionBindings != nil {\n544|\t\t\tselected := false\n545|\t\t\tfor _, key := range group.Keys {\n546|\t\t\t\tif _, ok := selectedSectionBindings[key]; ok {\n547|\t\t\t\t\tselected = true\n548|\t\t\t\t\tbreak\n549|\t\t\t\t}\n550|\t\t\t}\n551|\t\t\tif !selected {\n552|\t\t\t\tcontinue\n553|\t\t\t}\n554|\t\t}\n555|\t\tif group.Kind == ownershipSectionBinding && len(group.Keys) != 1 {\n556|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n557|\t\t}\n558|\t\tif len(group.Keys) == 0 {\n559|\t\t\treturn nil, fail(\"ownership group %d (%s) has no registered keys\", index, group.Kind)\n560|\t\t}\n561|\t\tif err := checker.verify(group.Production, false); err != nil {\n562|\t\t\tif group.Kind == ownershipSectionBinding {\n563|\t\t\t\treturn nil, fail(\"section binding %q production owner: %v\", group.Keys[0], err)\n564|\t\t\t}\n565|\t\t\treturn nil, fail(\"ownership group %d (%s) production owner: %v\", index, group.Kind, err)\n566|\t\t}\n567|\t\tif len(group.AcceptanceCases) == 0 {\n568|\t\t\tif group.Kind == ownershipSectionBinding {\n569|\t\t\t\treturn nil, fail(\"section binding %q has no scope-specific acceptance owner\", group.Keys[0])\n570|\t\t\t}\n571|\t\t\treturn nil, fail(\"ownership group %d (%s) has no acceptance owner\", index, group.Kind)\n572|\t\t}\n573|\t\tcaseSeen := make(map[string]struct{}, len(group.AcceptanceCases))\n574|\t\tfor _, acceptanceID := range group.AcceptanceCases {\n575|\t\t\tif _, duplicate := caseSeen[acceptanceID]; duplicate {\n576|\t\t\t\treturn nil, fail(\"ownership group %d (%s) repeats acceptance case %q\", index, group.Kind, acceptanceID)\n577|\t\t\t}\n578|\t\t\tcaseSeen[acceptanceID] = struct{}{}\n579|\t\t\tif _, ok := acceptanceIDs[acceptanceID]; !ok {\n580|\t\t\t\tif group.Kind == ownershipSectionBinding {\n581|\t\t\t\t\treturn nil, fail(\"section binding %q references unregistered acceptance case %q\", group.Keys[0], acceptanceID)\n582|\t\t\t\t}\n583|\t\t\t\treturn nil, fail(\"ownership group %d (%s) references unregistered acceptance case %q\", index, group.Kind, acceptanceID)\n584|\t\t\t}\n585|\t\t}\n586|\t\tfor _, key := range group.Keys {\n587|\t\t\tif key == \"\" {\n588|\t\t\t\treturn nil, fail(\"ownership group %d (%s) has an empty key\", index, group.Kind)\n589|\t\t\t}\n590|\t\t\tif _, duplicate := owned[group.Kind][key]; duplicate {\n591|\t\t\t\treturn nil, fail(\"duplicate %s implementation owner for %q\", group.Kind, key)\n592|\t\t\t}\n593|\t\t\towned[group.Kind][key] = struct{}{}\n594|\t\t}\n595|\t}\n596|\tfor kind, wanted := range required {\n597|\t\tfor key := range wanted {\n598|\t\t\tif _, ok := owned[kind][key]; !ok {\n599|\t\t\t\treturn nil, fail(\"registered %s %q has no implementation owner\", kind, key)\n600|\t\t\t}\n601|\t\t}\n602|\t}\n603|\tfor kind, registered := range owned {\n604|\t\tfor key := range registered {\n605|\t\t\tif _, ok := allowed[kind][key]; !ok {\n606|\t\t\t\treturn nil, fail(\"implementation owner is self-minted for unknown %s %q\", kind, key)\n607|\t\t\t}\n608|\t\t}\n609|\t}\n610|\treturn owned, nil\n611|}\n612|\n613|func resolveAssignedSections(pinned []string, assigned []string) ([]assignedSectionBinding, error) {\n614|\tif assigned == nil {\n615|\t\treturn nil, nil\n616|\t}\n617|\tpinnedSet := make(map[string]struct{}, len(pinned))\n618|\tfor _, section := range pinned {\n619|\t\tpinnedSet[section] = struct{}{}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
