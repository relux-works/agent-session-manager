derIdentityRecord\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"core-record-identity-validation\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"validateProviderIdentityRecord validates the Section 5.5 provider identity shape; the destination-adapter obligations of Section 5.5 are not implemented and no clause of it is enumerated.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:5.6\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/canonicaljson/core_records.go\\\",\\n        \\\"declaration\\\": \\\"validateWorkspaceGroupRecord\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"core-record-identity-validation\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"validateWorkspaceGroupRecord validates the Section 5.6 workspace group shape; workspace group membership and union behaviour is not implemented and no clause of Section 5.6 is enumerated.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:7.2\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n        \\\"declaration\\\": \\\"ForRelease\\\"\\n      },\\n      \\\"acceptance_cases\\\": [\\n        \\\"catalog-v050-exact\\\"\\n      ],\\n      \\\"coverage\\\": \\\"unevidenced\\\",\\n      \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.2; no clause of 7.2 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 7 obligations it carries.\\\"\\n    },\\n    {\\n      \\\"kind\\\": \\\"section_binding\\\",\\n      \\\"keys\\\": [\\n        \\\"section:7.3\\\"\\n      ],\\n      \\\"production\\\": {\\n        \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n        \\\"declaration\\\": \\\"ForRelease\\\"\\n      }