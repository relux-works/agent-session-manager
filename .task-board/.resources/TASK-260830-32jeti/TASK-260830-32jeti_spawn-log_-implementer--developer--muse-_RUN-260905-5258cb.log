{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"d83701d1-9bfc-4ba4-9e33-d60c20c97956"},"task_id":"d83701d1-9bfc-4ba4-9e33-d60c20c97956","event":{"kind":"output","task_id":"d83701d1-9bfc-4ba4-9e33-d60c20c97956","chunk":"Read text file `internal/traceability/traceability.go`.\n(1120 line(s) above)\n1121|func verifySectionBindingCoverage(\n1122|\tdocument *specdoc.Document,\n1123|\tgroup ownershipGroup,\n1124|\tacceptanceIDs map[string]struct{},\n1125|) (sectionCoverage, error) {\n1126|\tkey := group.Keys[0]\n1127|\tinventory, err := sectionClauseInventory(document, key)\n1128|\tif err != nil {\n1129|\t\treturn sectionCoverage{}, fail(\"section binding %q clause inventory: %v\", key, err)\n1130|\t}\n1131|\tbyIdentifier := make(map[string]normativeClause, len(inventory))\n1132|\tfor _, clause := range inventory {\n1133|\t\tbyIdentifier[clause.ID] = clause\n1134|\t}\n1135|\tgroupCases := make(map[string]struct{}, len(group.AcceptanceCases))\n1136|\tfor _, acceptanceID := range group.AcceptanceCases {\n1137|\t\tgroupCases[acceptanceID] = struct{}{}\n1138|\t}\n1139|\n1140|\tseen := make(map[string]struct{}, len(group.Clauses))\n1141|\tfor _, declared := range group.Clauses {\n1142|\t\tclause, known := byIdentifier[declared.ID]\n1143|\t\tif !known {\n1144|\t\t\treturn sectionCoverage{}, fail(\n1145|\t\t\t\t\"section binding %q discharges clause %q, which is not one of the %d normative clauses of the pinned section\",\n1146|\t\t\t\tkey, declared.ID, len(inventory))\n1147|\t\t}\n1148|\t\tif _, duplicate := seen[declared.ID]; duplicate {\n1149|\t\t\treturn sectionCoverage{}, fail(\"section binding %q repeats discharged clause %q\", key, declared.ID)\n1150|\t\t}\n1151|\t\tseen[declared.ID] = struct{}{}\n1152|\t\tif declared.Line != clause.Line {\n1153|\t\t\treturn sectionCoverage{}, fail(\n1154|\t\t\t\t\"section binding %q clause %q declares line %d, but the pinned clause is at line %d\",\n1155|\t\t\t\tkey, declared.ID, declared.Line, clause.Line)\n1156|\t\t}\n1157|\t\texcerpt := specdoc.Normalize(declared.Excerpt)\n1158|\t\tif excerpt == \"\" {\n1159|\t\t\treturn sectionCoverage{}, fail(\"section binding %q clause %q quotes an empty excerpt\", key, declared.ID)\n1160|\t\t}\n1161|\t\tif !normativeKeywordPattern.MatchString(excerpt) {\n1162|\t\t\treturn sectionCoverage{}, fail(\n1163|\t\t\t\t\"section binding %q clause %q quotes text that carries no RFC 2119 obligation\", key, declared.ID)\n1164|\t\t}\n1165|\t\tif !quoteBeginsAtLine(document, declared.Excerpt, clause.Line) {\n1166|\t\t\treturn sectionCoverage{}, fail(\n1167|\t\t\t\t\"section binding %q clause %q does not quote the pinned document verbatim at line %d\",\n1168|\t\t\t\tkey, declared.ID, clause.Line)\n1169|\t\t}\n1170|\t\tif len(declared.AcceptanceCases) == 0 {\n1171|\t\t\treturn sectionCoverage{}, fail(\n1172|\t\t\t\t\"section binding %q clause %q names no acceptance case that discharges it\", key, declared.ID)\n1173|\t\t}\n1174|\t\tcaseSeen := make(map[string]struct{}, len(declared.AcceptanceCases))\n1175|\t\tfor _, acceptanceID := range declared.AcceptanceCases {\n1176|\t\t\tif _, duplicate := caseSeen[acceptanceID]; duplicate {\n1177|\t\t\t\treturn sectionCoverage{}, fail(\n1178|\t\t\t\t\t\"section binding %q clause %q repeats acceptance case %q\", key, declared.ID, acceptanceID)\n1179|\t\t\t}\n1180|\t\t\tcaseSeen[acceptanceID] = struct{}{}\n1181|\t\t\tif _, registered := acceptanceIDs[acceptanceID]; !registered {\n1182|\t\t\t\treturn sectionCoverage{}, fail(\n1183|\t\t\t\t\t\"section binding %q clause %q references unregistered acceptance case %q\", key, declared.ID, acceptanceID)\n1184|\t\t\t}\n1185|\t\t\tif _, owned := groupCases[acceptanceID]; !owned {\n1186|\t\t\t\treturn sectionCoverage{}, fail(\n1187|\t\t\t\t\t\"section binding %q clause %q discharges through acceptance case %q, which the binding does not own\",\n1188|\t\t\t\t\tkey, declared.ID, acceptanceID)\n1189|\t\t\t}\n1190|\t\t}\n1191|\t}\n1192|\n1193|\tmeasured := coverageBucket(len(group.Clauses), len(inventory))\n1194|\tif group.Coverage == \"\" {\n1195|\t\treturn sectionCoverage{}, fail(\n1196|\t\t\t\"section binding %q declares no coverage level; the pinned section carries %d normative clauses and the binding enumerates %d\",\n1197|\t\t\tkey, len(inventory), len(group.Clauses))\n1198|\t}\n1199|\tif group.Coverage != measured {\n1200|\t\treturn sectionCoverage{}, fail(\n1201|\t\t\t\"section binding %q claims %s coverage but discharges %d of the %d normative clauses of the pinned section, which is %s coverage\",\n1202|\t\t\tkey, group.Coverage, len(group.Clauses), len(inventory), measured)\n1203|\t}\n1204|\tdisplay, err := sectionDisplayName(key)\n1205|\tif err != nil {\n1206|\t\treturn sectionCoverage{}, fail(\"section binding %q: %v\", key, err)\n1207|\t}\n1208|\t// Every level below full owes a gap, coverageUnmeasured included. Before\n1209|\t// this the gate refused a gap on the unmeasured bucket, so the bindings with\n1210|\t// the least evidence behind them were the only ones structurally forbidden\n1211|\t// from disclosing it.\n1212|\tswitch measured {\n1213|\tcase coverageFull:\n1214|\t\tif group.Gap != \"\" {\n1215|\t\t\treturn sectionCoverage{}, fail(\"section binding %q claims %s coverage and still names a gap\", key, measured)\n1216|\t\t}\n1217|\tdefault:\n1218|\t\tif err := verifyGapDiscloses(group.Gap, display, group.Production.Declaration); err != nil {\n1219|\t\t\treturn sectionCoverage{}, fail(\n1220|\t\t\t\t\"section binding %q claims %s coverage without naming what %s leaves unimplemented: %v\",\n1221|\t\t\t\tkey, measured, display, err)\n1222|\t\t}\n1223|\t}\n1224|\treturn sectionCoverage{\n1225|\t\tKey:        key,\n1226|\t\tLevel:      measured,\n1227|\t\tDischarged: len(group.Clauses),\n1228|\t\tTotal:      len(inventory),\n1229|\t\tGap:        group.Gap,\n1230|\t}, nil\n1231|}\n1232|\n1233|// quoteBeginsAtLine reports whether the normalized excerpt occurs in the pinned\n1234|// document beginning on the given line. An excerpt matching elsewhere, or\n1235|// nowhere, is not a quote of the clause it claims.\n1236|func quoteBeginsAtLine(document *specdoc.Document, excerpt string, line int) bool {\n1237|\tfor _, candidate := range document.QuoteLines(excerpt) {\n1238|\t\tif candidate == line {\n1239|\t\t\treturn true\n1240|\t\t}\n1241|\t}\n1242|\treturn false\n1243|}\n1244|\n1245|// verifyUnownedSections checks the disclosed unimplemented sections. An entry\n1246|// must name a real section, must not also be owned, must not cover a section\n1247|// the generated catalog requires an owner for, and must state a gap and the\n1248|// evidence for it.\n1249|func verifyUnownedSections(\n1250|\tentries []unownedSection,\n1251|\tallowed map[string]struct{},\n1252|\trequiredByCatalog map[string]struct{},\n1253|\towned map[string]struct{},\n1254|) (map[string]unownedSection, error) {\n1255|\tresult := make(map[string]unownedSection, len(entries))\n1256|\tfor index, entry := range entries {\n1257|\t\tif entry.Key == \"\" {\n1258|\t\t\treturn nil, fail(\"unowned section %d has an empty key\", index)\n1259|\t\t}\n1260|\t\tif _, duplicate := result[entry.Key]; duplicate {\n1261|\t\t\treturn nil, fail(\"duplicate unowned section %q\", entry.Key)\n1262|\t\t}\n1263|\t\tif _, known := allowed[entry.Key]; !known {\n1264|\t\t\treturn nil, fail(\"unowned section %q is self-minted for an unknown section\", entry.Key)\n1265|\t\t}\n1266|\t\tif _, required := requiredByCatalog[entry.Key]; required {\n1267|\t\t\treturn nil, fail(\n1268|\t\t\t\t\"unowned section %q is required to have an implementation owner by the generated catalog\", entry.Key)\n1269|\t\t}\n1270|\t\tif _, conflict := owned[entry.Key]; conflict {\n1271|\t\t\treturn nil, fail(\"section %q is registered as both owned and unowned\", entry.Key)\n1272|\t\t}\n1273|\t\tdisplay, err := sectionDisplayName(entry.Key)\n1274|\t\tif err != nil {\n1275|\t\t\treturn nil, fail(\"unowned section %q: %v\", entry.Key, err)\n1276|\t\t}\n1277|\t\t// An unowned section has no production declaration by construction, so\n1278|\t\t// the gap is checked for length and a whole-identifier section mention\n1279|\t\t// only, and the separate evidence field carries the rest.\n1280|\t\tif err := verifyGapDiscloses(entry.Gap, display, \"\"); err != nil {\n1281|\t\t\treturn nil, fail(\"unowned section %q does not name what %s leaves unimplemented: %v\", entry.Key, display, err)\n1282|\t\t}\n1283|\t\tif len(entry.Evidence) < minimumGapLength {\n1284|\t\t\treturn nil, fail(\"unowned section %q states no evidence for its gap\", entry.Key)\n1285|\t\t}\n1286|\t\tresult[entry.Key] = entry\n1287|\t}\n1288|\treturn result, nil\n1289|}"}}}
