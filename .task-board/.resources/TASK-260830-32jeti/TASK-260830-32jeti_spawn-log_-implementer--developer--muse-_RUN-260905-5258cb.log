lim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40b","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":96,"recorded_at":1780531400000187,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"call_id":"call_01a07061053470a384ef95e11be75296","text":"Read text file `internal/canonicaljson/canonical.go`.\n(504 line(s) above)\n505|\t\tfor _, member := range typed {\n506|\t\t\tif err := validateAXNumbers(member); err != nil {\n507|\t\t\t\treturn err\n508|\t\t\t}\n509|\t\t}\n510|\t}\n511|\treturn nil\n512|}\n513|\n514|func validateSurrogateEscapes(input []byte) error {\n515|\tfor index := 0; index < len(input); index++ {\n516|\t\tif input[index] != '\"' {\n517|\t\t\tcontinue\n518|\t\t}\n519|\t\tfor index++; index < len(input); index++ {\n520|\t\t\tswitch input[index] {\n521|\t\t\tcase '\"':\n522|\t\t\t\tgoto stringComplete\n523|\t\t\tcase '\\\\':\n524|\t\t\t\tindex++\n525|\t\t\t\tif index >= len(input) {\n526|\t\t\t\t\treturn invalidJSON(\"unterminated string escape\")\n527|\t\t\t\t}\n528|\t\t\t\tif input[index] != 'u' {\n529|\t\t\t\t\tcontinue\n530|\t\t\t\t}\n531|\t\t\t\tcodeUnit, end, err := readUTF16Escape(input, index-1)\n532|\t\t\t\tif err != nil {\n533|\t\t\t\t\treturn err\n534|\t\t\t\t}\n535|\t\t\t\tindex = end - 1\n536|\t\t\t\tswitch {\n537|\t\t\t\tcase codeUnit >= 0xd800 && codeUnit <= 0xdbff:\n538|\t\t\t\t\tsecond, secondEnd, err := readUTF16Escape(input, end)\n539|\t\t\t\t\tif err != nil || second < 0xdc00 || second > 0xdfff {\n540|\t\t\t\t\t\treturn invalidJSON(\"high surrogate escape must be followed by a low surrogate escape\")\n541|\t\t\t\t\t}\n542|\t\t\t\t\tindex = secondEnd - 1\n543|\t\t\t\tcase codeUnit >= 0xdc00 && codeUnit <= 0xdfff:\n544|\t\t\t\t\treturn invalidJSON(\"lone low surrogate escape is forbidden\")\n545|\t\t\t\t}\n546|\t\t\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\n547|\t\t\t\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n548|\t\t\t\t0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\n549|\t\t\t\t0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:\n550|\t\t\t\treturn invalidJSON(\"unescaped control character in string\")\n551|\t\t\t}\n552|\t\t}\n553|\t\treturn invalidJSON(\"unterminated JSON string\")\n554|\tstringComplete:\n555|\t}\n556|\treturn nil\n557|}\n558|\n559|func readUTF16Escape(input []byte, start int) (uint16, int, error) {\n560|\tif start < 0 || start+6 > len(input) || input[start] != '\\\\' || input[start+1] != 'u' {\n561|\t\treturn 0, start, invalidJSON(\"expected UTF-16 escape\")\n562|\t}\n563|\tvalue, err := strconv.ParseUint(string(input[start+2:start+6]), 16, 16)\n564|\tif err != nil {\n565|\t\treturn 0, start, invalidJSON(\"malformed UTF-16 escape\")\n566|\t}\n567|\treturn uint16(value), start + 6, nil\n568|}\n569|\n570|func invalidJSON(format string, arguments ...any) error {\n571|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidJSON, fmt.Sprintf(format, arguments...))\n572|}\n573|\n574|func invalidIdentity(format string, arguments ...any) error {\n575|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidIdentity, fmt.Sprintf(format, arguments...))\n576|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c40d","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":97,"recorded_at":1780531400000189,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"call_id":"call_01a0706105fe7bd1a033bb1d44f1fc1a","text":"Read text file `internal/provhost/doc.go`.\n1|// Package provhost implements the ax host side of the provider plugin\n2|// JSON-over-stdio protocol of pinned specification Section 7.2: one-frame\n3|// JSONL transport, deadlines, size limits, stdout/stderr separation,\n4|// operation dispatch, and status recovery.\n5|//\n6|// The actor every Section 7.2 RFC 2119 keyword governs here is the ax host\n7|// (this repository). The provider plugin is a child process this package\n8|// starts but never trusts: every byte it emits is attacker-influenced, so\n9|// every frame is validated before any member is used, and a different-major\n10|// payload is never parsed far enough to trust its error code, retryable\n11|// bit, details, or authority fields (Section 15.1).\n12|//\n13|// This package owns the envelope layer and the operation-layer\n14|// conformance decoders. Operation dispatch means the host maps an\n15|// operation name to one plugin invocation and refuses unknown names\n16|// locally without spawning; the conformance decoders validate what a\n17|// plugin returned: the closed manifest (7.3), probe and capability\n18|// gate (7.4, 8.3), profile mapping (7.7), quiescence proof (7.6),\n19|// SpawnPlan success bodies for launch and resume, the Provider\n20|// Identity Record and identify-session result (5.5), and the single\n21|// (operation, operation_id) mutation key (7.5). Full Section 7.5\n22|// request-body vocabularies beyond these surfaces, and the\n23|// materialize commit/rollback result bodies, cross this package\n24|// opaquely: a body must still be a JSON object, and the\n25|// materialize-status body this package interprets for recovery must\n26|// satisfy the state/nullability/identity rules Section 7.5 states\n27|// for ProviderTransactionStatus.\n28|//\n29|// A failed read is never an absence: a crashed, timed-out, oversized,\n30|// unparsable, or correlation-mismatched invocation fails with a local\n31|// Structured Error 1.0.0, never with a partial response the caller could\n32|// mistake for a result. Status recovery is fail-closed the same way: an\n33|// unknown or integrity-invalid transaction fails with integrity_failure\n34|// and must be quarantined rather than represented as a successful status.\n35|//\n36|// The package mutates no durable state of its own and keeps no cross-call\n37|// cache: Host starts one plugin process per operation, so successive calls\n38|// are separate processes observing durable state through the authority the\n39|// caller passes, which is the property the cross-process recovery cases\n40|// rest on. Retry decisions belong to the caller; every local failure this\n41|// package emits is non-retryable, because nothing observed at an unusable\n42|// frame licenses a safe-retry claim.\n43|//\n44|// Stated bounds: stderr capture is capped at 1 MiB (an implementation\n45|// resource bound, not a protocol limit); error details carry the failure\n46|// class, member names, and the observed version string only — never\n47|// environment or stderr content. Mutation receipts live in the\n48|// provider transaction document and the plugin, not in the host: the\n49|// host holds no cross-call cache, so cross-crash durability of\n50|// (operation, operation_id) results is the document's property, and\n51|// the host side pins the sole key shape, byte-identical retry bytes,\n52|// and the mismatch surface. The Section 8 provider/platform cell\n53|// values are evidence labels, not host behavior: the host pins the\n54|// fail-closed direction (conditional, unsupported, and unknown are\n55|// never usable) for every capability-by-status tuple rather than one\n56|// cell value. Section 8.2 store-exclusion roots and the remaining\n57|// Section 7.5 request vocabularies have no host production yet.\n58|package provhost","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
