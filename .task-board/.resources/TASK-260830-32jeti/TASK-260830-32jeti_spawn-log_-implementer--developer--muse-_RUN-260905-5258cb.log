{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"call_id":"call_01a0706103777ba0be05745d53eff119","text":"Read text file `internal/provhost/protocol.go`.\n(239 line(s) above)\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read.\n262|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n263|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n264|\ttoken, err := decoder.Token()\n265|\tif err != nil {\n266|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n267|\t}\n268|\tdelim, ok := token.(json.Delim)\n269|\tif !ok || delim != '{' {\n270|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n271|\t}\n272|\tmembers := map[string]json.RawMessage{}\n273|\tfor decoder.More() {\n274|\t\tkeyToken, err := decoder.Token()\n275|\t\tif err != nil {\n276|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n277|\t\t}\n278|\t\tkey, ok := keyToken.(string)\n279|\t\tif !ok {\n280|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n281|\t\t}\n282|\t\tif _, duplicate := members[key]; duplicate {\n283|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n284|\t\t}\n285|\t\tvar raw json.RawMessage\n286|\t\tif err := decoder.Decode(&raw); err != nil {\n287|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n288|\t\t}\n289|\t\tmembers[key] = raw\n290|\t}\n291|\tif token, err := decoder.Token(); err != nil {\n292|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n293|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n294|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n295|\t}\n296|\tif _, err := decoder.Token(); err != io.EOF {\n297|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n298|\t}\n299|\treturn members, nil\n300|}\n301|\n302|// responseMembers is the exact Section 7.2 response member set: the four\n303|// framing members plus body on success or error on failure, never both,\n304|// never neither, and nothing else. It is package-level so the closed\n305|// vocabulary census derives it: widening the accepted set here must redden\n306|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n307|var responseMembers = map[string]bool{\n308|\t\"protocol\":         true,\n309|\t\"protocol_version\": true,\n310|\t\"request_id\":       true,\n311|\t\"ok\":               true,\n312|\t\"body\":             true,\n313|\t\"error\":            true,\n314|}\n315|\n316|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n317|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n318|\tfor _, name := range required {\n319|\t\tif _, present := members[name]; !present {\n320|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n321|\t\t}\n322|\t}\n323|\tif ok {\n324|\t\tif _, present := members[\"body\"]; !present {\n325|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n326|\t\t}\n327|\t\tif _, forbidden := members[\"error\"]; forbidden {\n328|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n329|\t\t}\n330|\t} else {\n331|\t\tif _, present := members[\"error\"]; !present {\n332|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n333|\t\t}\n334|\t\tif _, forbidden := members[\"body\"]; forbidden {\n335|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n336|\t\t}\n337|\t}\n338|\tfor name := range members {\n339|\t\tif !responseMembers[name] {\n340|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n341|\t\t}\n342|\t}\n343|\treturn nil\n344|}\n345|\n346|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n347|// Anything else is not a recognizable major, so the frame is unusable\n348|// rather than a mismatch.\n349|func parseMajor(version string) (int, bool) {\n350|\tparts := strings.Split(version, \".\")\n351|\tif len(parts) != 3 {\n352|\t\treturn 0, false\n353|\t}\n354|\tmajor := 0\n355|\tfor i := 0; i < len(parts[0]); i++ {\n356|\t\tdigit := parts[0][i]\n357|\t\tif digit < '0' || digit > '9' {\n358|\t\t\treturn 0, false\n359|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
