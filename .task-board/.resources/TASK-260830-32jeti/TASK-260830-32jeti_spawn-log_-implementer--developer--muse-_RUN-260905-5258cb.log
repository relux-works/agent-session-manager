{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c403","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":92,"recorded_at":1780531400000179,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"31cccb2f-2def-4686-8f9c-070a112c9919"},"task_id":"31cccb2f-2def-4686-8f9c-070a112c9919","event":{"kind":"output","task_id":"31cccb2f-2def-4686-8f9c-070a112c9919","chunk":"Read text file `internal/canonicaljson/canonical.go`.\n(504 line(s) above)\n505|\t\tfor _, member := range typed {\n506|\t\t\tif err := validateAXNumbers(member); err != nil {\n507|\t\t\t\treturn err\n508|\t\t\t}\n509|\t\t}\n510|\t}\n511|\treturn nil\n512|}\n513|\n514|func validateSurrogateEscapes(input []byte) error {\n515|\tfor index := 0; index < len(input); index++ {\n516|\t\tif input[index] != '\"' {\n517|\t\t\tcontinue\n518|\t\t}\n519|\t\tfor index++; index < len(input); index++ {\n520|\t\t\tswitch input[index] {\n521|\t\t\tcase '\"':\n522|\t\t\t\tgoto stringComplete\n523|\t\t\tcase '\\\\':\n524|\t\t\t\tindex++\n525|\t\t\t\tif index >= len(input) {\n526|\t\t\t\t\treturn invalidJSON(\"unterminated string escape\")\n527|\t\t\t\t}\n528|\t\t\t\tif input[index] != 'u' {\n529|\t\t\t\t\tcontinue\n530|\t\t\t\t}\n531|\t\t\t\tcodeUnit, end, err := readUTF16Escape(input, index-1)\n532|\t\t\t\tif err != nil {\n533|\t\t\t\t\treturn err\n534|\t\t\t\t}\n535|\t\t\t\tindex = end - 1\n536|\t\t\t\tswitch {\n537|\t\t\t\tcase codeUnit >= 0xd800 && codeUnit <= 0xdbff:\n538|\t\t\t\t\tsecond, secondEnd, err := readUTF16Escape(input, end)\n539|\t\t\t\t\tif err != nil || second < 0xdc00 || second > 0xdfff {\n540|\t\t\t\t\t\treturn invalidJSON(\"high surrogate escape must be followed by a low surrogate escape\")\n541|\t\t\t\t\t}\n542|\t\t\t\t\tindex = secondEnd - 1\n543|\t\t\t\tcase codeUnit >= 0xdc00 && codeUnit <= 0xdfff:\n544|\t\t\t\t\treturn invalidJSON(\"lone low surrogate escape is forbidden\")\n545|\t\t\t\t}\n546|\t\t\tcase 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,\n547|\t\t\t\t0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n548|\t\t\t\t0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,\n549|\t\t\t\t0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:\n550|\t\t\t\treturn invalidJSON(\"unescaped control character in string\")\n551|\t\t\t}\n552|\t\t}\n553|\t\treturn invalidJSON(\"unterminated JSON string\")\n554|\tstringComplete:\n555|\t}\n556|\treturn nil\n557|}\n558|\n559|func readUTF16Escape(input []byte, start int) (uint16, int, error) {\n560|\tif start < 0 || start+6 > len(input) || input[start] != '\\\\' || input[start+1] != 'u' {\n561|\t\treturn 0, start, invalidJSON(\"expected UTF-16 escape\")\n562|\t}\n563|\tvalue, err := strconv.ParseUint(string(input[start+2:start+6]), 16, 16)\n564|\tif err != nil {\n565|\t\treturn 0, start, invalidJSON(\"malformed UTF-16 escape\")\n566|\t}\n567|\treturn uint16(value), start + 6, nil\n568|}\n569|\n570|func invalidJSON(format string, arguments ...any) error {\n571|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidJSON, fmt.Sprintf(format, arguments...))\n572|}\n573|\n574|func invalidIdentity(format string, arguments ...any) error {\n575|\treturn fmt.Errorf(\"%w: %s\", ErrInvalidIdentity, fmt.Sprintf(format, arguments...))\n576|}"}}}
