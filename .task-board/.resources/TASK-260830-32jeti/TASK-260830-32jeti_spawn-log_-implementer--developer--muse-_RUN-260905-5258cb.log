{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cce5","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":1229,"recorded_at":1780531400002453,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"28c046cb-c16d-4ea0-8fdd-18a695b2613d"},"task_id":"28c046cb-c16d-4ea0-8fdd-18a695b2613d","event":{"kind":"output","task_id":"28c046cb-c16d-4ea0-8fdd-18a695b2613d","chunk":"edited\nchanged lines: line 2909\n--- original\n+++ updated\n@@\n-      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.5; no clause of 7.5 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 53 obligations it carries.\"\n+      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.5; the host-side Section 7.5 operation conformance (SpawnPlan launch and resume bodies, identify-session results, materialize-status recovery, and the single operation plus operation_id mutation key) is implemented in internal/provhost under the Section 7.6 and Section 7.7 bindings, and no clause of Section 7.5 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 53 obligations it carries.\"\n"}}}
