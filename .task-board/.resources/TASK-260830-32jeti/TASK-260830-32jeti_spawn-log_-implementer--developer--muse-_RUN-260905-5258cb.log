n, err := decoder.Token()\n425|\tif err != nil {\n426|\t\treturn nil, invalidJSON(\"decode JSON token: %v\", err)\n427|\t}\n428|\tdelimiter, ok := token.(json.Delim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n(more lines below)"}}}
