t\tif !ok {\n149|\t\t\t\t\treturn true\n150|\t\t\t\t}\n151|\t\t\t\tif !seenDetail[detail] {\n152|\t\t\t\t\tseenDetail[detail] = true\n153|\t\t\t\t\tstrictDetails = append(strictDetails, detail)\n154|\t\t\t\t}\n155|\t\t\t\treturn true\n156|\t\t\t})\n157|\t\t}\n158|\t}\n159|\tfor _, file := range files {\n160|\t\tsource, syntax := file.source, file.syntax\n161|\t\tparseBranches += armParseBranches(source, fileSet, syntax, arms)\n162|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n163|\t\t\tif literal, ok := frameFaultLiteral(node); ok {\n164|\t\t\t\tdetail, ok := literalStringField(source, fileSet, literal, \"detail\")\n165|\t\t\t\tif !ok {\n166|\t\t\t\t\tarms[\"frame|expr:\"+nodeSource(source, fileSet, node)] = struct{}{}\n167|\t\t\t\t\treturn true\n168|\t\t\t\t}\n169|\t\t\t\tmember := \"\"\n170|\t\t\t\tif kv := literalField(literal, \"member\"); kv != nil {\n171|\t\t\t\t\tmember = nodeSource(source, fileSet, kv.Value)\n172|\t\t\t\t}\n173|\t\t\t\tarms[\"frame|\"+detail+\"|\"+member] = struct{}{}\n174|\t\t\t\treturn true\n175|\t\t\t}\n176|\t\t\tcall, ok := node.(*ast.CallExpr)\n177|\t\t\tif !ok {\n178|\t\t\t\treturn true\n179|\t\t\t}\n180|\t\t\tident, ok := call.Fun.(*ast.Ident)\n181|\t\t\tif !ok || len(call.Args) == 0 {\n182|\t\t\t\treturn true\n183|\t\t\t}\n184|\t\t\tswitch ident.Name {\n185|\t\t\tcase \"integrity\":\n186|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n187|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n188|\t\t\t\t\tif err != nil {\n189|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n190|\t\t\t\t\t\treturn true\n191|\t\t\t\t\t}\n192|\t\t\t\t\tarms[\"integrity|\"+detail] = struct{}{}\n193|\t\t\t\t\treturn true\n194|\t\t\t\t}\n195|\t\t\t\tif prefix, ok := integrityPrefix(call.Args[0]); ok {\n196|\t\t\t\t\tif len(strictDetails) == 0 {\n197|\t\t\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n198|\t\t\t\t\t\treturn true\n199|\t\t\t\t\t}\n200|\t\t\t\t\tfor _, detail := range strictDetails {\n201|\t\t\t\t\t\tarms[\"integrity|\"+prefix+detail] = struct{}{}\n202|\t\t\t\t\t}\n203|\t\t\t\t\treturn true\n204|\t\t\t\t}\n205|\t\t\t\tarms[\"integrity|expr:\"+nodeSource(source, fileSet, call.Args[0])] = struct{}{}\n206|\t\t\tcase \"failInvalid\", \"failProtocol\", \"failMismatch\", \"failProcess\", \"failTimeout\":\n207|\t\t\t\tif literal, ok := call.Args[0].(*ast.BasicLit); ok && literal.Kind == token.STRING {\n208|\t\t\t\t\tdetail, err := strconv.Unquote(literal.Value)\n209|\t\t\t\t\tif err != nil {\n210|\t\t\t\t\t\treturn true\n211|\t\t\t\t\t}\n212|\t\t\t\t\tarms[\"ctor|\"+ident.Name+\"|\"+detail] = struct{}{}\n213|\t\t\t\t}\n214|\t\t\t\t// Non-literal first arguments are the fault conduits\n215|\t\t\t\t// (fault.detail, detail variables): the arms behind\n216|\t\t\t\t// them are the frame arms above, so there is no\n217|\t\t\t\t// separate obligation here.\n218|\t\t\t}\n219|\t\t\treturn true\n220|\t\t})\n221|\t}\n222|\tif parseBranches == 0 {\n223|\t\treturn nil, nil, fmt.Errorf(\"parseMajor carries no rejection branch anywhere; the classification-branch enumeration is blind\")\n224|\t}\n225|\tsort.Strings(scanned)\n226|\treturn arms, scanned, nil\n227|}\n228|\n229|// frameFaultLiteral reports whether node is a &frameFault{...} literal.\n230|func frameFaultLiteral(node ast.Node) (*ast.CompositeLit, bool) {\n231|\ttarget := node\n232|\tif unary, ok := node.(*ast.UnaryExpr); ok && unary.Op == token.AND {\n233|\t\ttarget = unary.X\n234|\t}\n235|\tliteral, ok := target.(*ast.CompositeLit)\n236|\tif !ok {\n237|\t\treturn nil, false\n238|\t}\n239|\tident, ok := literal.Type.(*ast.Ident)\n240|\tif !ok || ident.Name != \"frameFault\" {\n241|\t\treturn nil, false\n242|\t}\n243|\treturn literal, true\n244|}\n245|\n246|func literalField(literal *ast.CompositeLit, name string) *ast.KeyValueExpr {\n247|\tfor _, element := range literal.Elts {\n248|\t\tif kv, ok := element.(*ast.KeyValueExpr); ok {\n249|\t\t\tif ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == name {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c559","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":263,"recorded_at":1780531400000521,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"call_id":"call_01a070615b7f7510ad3a521d2fb9c037","text":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"sed -n '380,430p' internal/traceability/traceability.go; echo ===; grep -n \\\"ownership\\\\b\\\" internal/traceability/traceability.go | head -20; echo ===; python3 -c \\\"\\nimport json\\nd=json.load(open('internal/traceability/ownership.v0.5.0.json'))\\nprint(json.dumps(d['ownership'][0], indent=1)[:1500])\\nprint('...')\\n# acceptance cases shape\\nprint(json.dumps(d['acceptance_cases'][:3], indent=1)[:1200])\\nprint('format/source:', d['format'], d['format_version'], json.dumps(d['source'])[:300])\\n\\\"\",\n  \"description\": \"Read hash check and ownership row shapes\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\n\\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\\n\\tif err != nil {\\n\\t\\treturn Report{}, err\\n\\t}\\n\\n\\tfor _, binding := range assignedBindings {\\n\\t\\tfor _, key := range binding.Keys {\\n\\t\\t\\tif entry, disclosed := unowned[key]; disclosed {\\n\\t\\t\\t\\treturn Report{}, fail(\\n\\t\\t\\t\\t\\t\\\"assigned section %q binding %q is recorded unowned: %s\\\", binding.Scope, key, entry.Gap)\\n\\t\\t\\t}\\n\\t\\t\\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\\n\\t\\t\\t\\treturn Report{}, fail(\\\"assigned section %q binding %q has no scoped implementation owner\\\", binding.Scope, key)\\n\\t\\t\\t}\\n\\t\\t\\t// Admission requires full and nothing else. coverageUnmeasured is\\n\\t\\t\\t// deliberately not admitted: the gate cannot see the section's\\n\\t\\t\\t// obligations, and admitting on an unverifiable justification\\n\\t\\t\\t// sentence would be self-minted evidence for exactly the class this\\n\\t\\t\\t// gate exists to refuse. Absence of a scanner-visible clause is a\\n\\t\\t\\t// failure to measure, not a measured absence of obligation.\\n\\t\\t\\tmeasured := coverage[key]\\n\\t\\t\\tif measured.Level != coverageFull {\\n\\t\\t\\t\\treturn Report{}, fail(\\n\\t\\t\\t\\t\\t\\\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\\\",\\n\\t\\t\\t\\t\\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tfor _, contract := range compatibilityCatalog.Contracts {\\n\\t\\tkey := contractKey(contract.Name, string(contract.ID))\\n\\t\\tif _, ok := owned[ownershipContract][key]; !ok {\\n\\t\\t\\treturn Report{}, fail(\\\"compatibility contract %q has no implementation owner\\\", key)\\n\\t\\t}\\n\\t}\\n\\n\\tcanonical, err := json.Marshal(registry)\\n\\tif err != nil {\\n\\t\\treturn Report{}, fail(\\\"encode canonical ownership registry: %v\\\", err)\\n\\t}\\n\\tdigest := sha256.Sum256(canonical)\\n\\tgotDigest := hex.EncodeToString(digest[:])\\n\\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\\n\\t\\treturn Report{}, fail(\\\"ownership registry projection digest %s differs from reviewed %s\\\", gotDigest, reviewedOwnershipCanonicalSHA256)\\n\\t}\\n\\n\\treport := Report{\\n\\t\\tContracts:              len(expected[ownershipContract]),\\n\\t\\tNormativeSections:      len(expected[ownershipNormativeSection]),\\n\\t\\tAcceptanceCases:        len(acceptanceIDs),\\n\\t\\tFixtures:               len(expected[ownershipFixture]),\\n===\\n32:\\townershipRegistryPath = \\\"internal/traceability/ownership.v0.5.0.json\\\"\\n37:\\townershipFormat        = \\\"ax-spec-to-code-ownership\\\"\\n41:\\t// formatting may change, but ownership claims cannot be self-minted without\\n88:\\tOwnership       []ownershipGroup `json:\\\"ownership\\\"`\\n201:// ownership reference against the supplied repository filesystem.\\n296:\\t\\treturn ownershipRegistry{}, fail(\\\"decode ownership registry: %v\\\", err)\\n301:\\t\\t\\treturn ownershipRegistry{}, fail(\\\"decode ownership registry: multiple JSON values\\\")\\n303:\\t\\treturn ownershipRegistry{}, fail(\\\"decode ownership registry trailing data: %v\\\", err)\\n318:\\t\\treturn Report{}, fail(\\\"unsupported ownership registry format %q version %d\\\", registry.Format, registry.FormatVersion)\\n326:\\t\\treturn Report{}, fail(\\\"ownership registry source differs from verified normative lock\\\")\\n364:\\t// measured before ownership resolution so that a section moved to the\\n418:\\t\\treturn Report{}, fail(\\\"encode canonical ownership registry: %v\\\", err)\\n423:\\t\\treturn Report{}, fail(\\\"ownership registry projection digest %s differs from reviewed %s\\\", gotDigest, reviewedOwnershipCanonicalSHA256)\\n456:// pinned document and refuses a coverage claim on any other ownership kind. A\\n469:\\t\\t\\t\\t\\t\\\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\\\",\\n475:\\t\\t\\treturn nil, fail(\\\"section binding ownership group %d has %d keys, want exactly one\\\", index, len(group.Keys))\\n537:\\t\\treturn nil, fail(\\\"implementation ownership registry is empty\\\")\\n541:\\t\\t\\treturn nil, fail(\\\"ownership group %d has unknown kind %q\\\", index, group.Kind)\\n556:\\t\\t\\treturn nil, fail(\\\"section binding ownership group %d has %d keys, want exactly one\\\", index, len(group.Keys))\\n559:\\t\\t\\treturn nil, fail(\\\"ownership group %d (%s) has no registered keys\\\", index, group.Kind)\\n===\\n{\\n \\\"kind\\\": \\\"contract\\\",\\n \\\"keys\\\": [\\n  \\\"Configuration [urn:ax:schema:config]\\\",\\n  \\\"Provider protocol [urn:ax:protocol:provider]\\\",\\n  \\\"Provider manifest [urn:ax:schema:provider-manifest]\\\",\\n  \\\"Provider probe [urn:ax:schema:provider-probe]\\\",\\n  \\\"Terminal Backend protocol [urn:ax:protocol:terminal-backend]\\\",\\n  \\\"Terminal Backend manifest [urn:ax:schema:terminal-backend-manifest]\\\",\\n  \\\"Terminal Backend probe [urn:ax:schema:terminal-backend-probe]\\\",\\n  \\\"Terminal Instance binding [urn:ax:schema:terminal-instance-binding]\\\",\\n  \\\"Terminal capability evidence [urn:ax:schema:terminal-capability-evidence]\\\",\\n  \\\"Session Adapter protocol [urn:ax:protocol:session-adapter]\\\",\\n  \\\"Session Adapter manifest [urn:ax:schema:session-adapter-manifest]\\\",\\n  \\\"Session Adapter probe [urn:ax:schema:session-adapter-probe]\\\",\\n  \\\"Directory Node protocol [urn:ax:protocol:session-directory-node]\\\",\\n  \\\"Directory Node manifest [urn:ax:schema:session-directory-node-manifest]\\\",\\n  \\\"Directory Node request [urn:ax:schema:session-directory-node-request]\\\",\\n  \\\"Directory Node response [urn:ax:schema:session-directory-node-response]\\\",\\n  \\\"Mesh RPC [urn:ax:protocol:rpc]\\\",\\n  \\\"Session record [urn:ax:schema:session-record]\\\",\\n  \\\"Session event [urn:ax:schema:session-event]\\\",\\n  \\\"Lease record [urn:ax:schema:lease]\\\",\\n  \\\"Checkpoint record [urn:ax:schema:checkpoint]\\\",\\n  \\\"Workspace group [urn:ax:schema:workspace-group]\\\",\\n  \\\"Provider identity [urn:ax:schema:provider-identity]\\\",\\n  \\\"Blob descriptor [urn:ax:schema:blob]\\\",\\n  \\\"Transfer manifest [urn:ax:sc\\n...\\n[\\n {\\n  \\\"id\\\": \\\"source-pin-exact\\\",\\n  \\\"production\\\": {\\n   \\\"path\\\": \\\"internal/specpin/pin.go\\\",\\n   \\\"declaration\\\": \\\"Current\\\"\\n  },\\n  \\\"tests\\\": [\\n   {\\n    \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n    \\\"declaration\\\": \\\"TestCurrentPinsPublishedV050Source\\\"\\n   }\\n  ]\\n },\\n {\\n  \\\"id\\\": \\\"source-pin-refusal\\\",\\n  \\\"production\\\": {\\n   \\\"path\\\": \\\"internal/specpin/pin.go\\\",\\n   \\\"declaration\\\": \\\"Verify\\\"\\n  },\\n  \\\"tests\\\": [\\n   {\\n    \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n    \\\"declaration\\\": \\\"TestVerifyRejectsIdentityAndContractDrift\\\"\\n   },\\n   {\\n    \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n    \\\"declaration\\\": \\\"TestVerifyRejectsPartialMalformedAndByteDifferentReads\\\"\\n   }\\n  ]\\n },\\n {\\n  \\\"id\\\": \\\"source-pin-compatibility\\\",\\n  \\\"production\\\": {\\n   \\\"path\\\": \\\"internal/specpin/pin.go\\\",\\n   \\\"declaration\\\": \\\"ContractsForRelease\\\"\\n  },\\n  \\\"tests\\\": [\\n   {\\n    \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n    \\\"declaration\\\": \\\"TestContractsForReleasePreservesV043Compatibility\\\"\\n   }\\n  ]\\n }\\n]\\nformat/source: ax-spec-to-code-ownership 1 {\\\"repository\\\": \\\"relux-works/agent-session-manager-spec\\\", \\\"release\\\": \\\"v0.5.0\\\", \\\"commit\\\": \\\"28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c\\\", \\\"document_path\\\": \\\"SPEC.md\\\", \\\"document_sha256\\\": \\\"562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a\\\"}\\n\",\n  \"original_output_bytes\": 6769,\n  \"original_output_tokens\": 1693,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
