{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44d","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":129,"recorded_at":1780531400000253,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"f3718801-4667-4962-a256-3b8c1bf8f111"},"task_id":"f3718801-4667-4962-a256-3b8c1bf8f111","event":{"kind":"output","task_id":"f3718801-4667-4962-a256-3b8c1bf8f111","chunk":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|\n20|// identitySchema is the exact schema identifier the record carries.\n21|const identitySchema = \"urn:ax:schema:provider-identity\"\n22|\n23|// identitySchemaVersion is the only identity version accepted.\n24|const identitySchemaVersion = \"1.0.0\"\n25|\n26|// identityKinds is the closed identity-kind enum in section order.\n27|var identityKinds = []string{\n28|\t\"session_uuid\",\n29|\t\"session_path_or_id\",\n30|\t\"backend_conversation_uuid\",\n31|\t\"task_board_managed\",\n32|\t\"provider_defined\",\n33|}\n34|\n35|// identityMembers is the exact required member set of a Provider\n36|// Identity Record.\n37|var identityMembers = map[string]bool{\n38|\t\"schema\":                    true,\n39|\t\"schema_version\":            true,\n40|\t\"record_id\":                 true,\n41|\t\"subject_id\":                true,\n42|\t\"session_id\":                true,\n43|\t\"provider_id\":               true,\n44|\t\"provider_version\":          true,\n45|\t\"provider_version_range\":    true,\n46|\t\"native_session_id\":         true,\n47|\t\"identity_kind\":             true,\n48|\t\"logical_workspace_id\":      true,\n49|\t\"backend_realm_fingerprint\": true,\n50|\t\"opaque_identity\":           true,\n51|\t\"created_by_host_id\":        true,\n52|\t\"created_at\":                true,\n53|\t\"extensions\":                true,\n54|}\n55|\n56|// identityRequired lists identityMembers in a fixed order so a record\n57|// missing several members always names the same one.\n58|var identityRequired = []string{\n59|\t\"schema\",\n60|\t\"schema_version\",\n61|\t\"record_id\",\n62|\t\"subject_id\",\n63|\t\"session_id\",\n64|\t\"provider_id\",\n65|\t\"provider_version\",\n66|\t\"provider_version_range\",\n67|\t\"native_session_id\",\n68|\t\"identity_kind\",\n69|\t\"logical_workspace_id\",\n70|\t\"backend_realm_fingerprint\",\n71|\t\"opaque_identity\",\n72|\t\"created_by_host_id\",\n73|\t\"created_at\",\n74|\t\"extensions\",\n75|}\n76|\n77|// identityKeyPattern is the provider-identity key grammar Section 5.5\n78|// states: [a-z][a-z0-9_.-]{0,63}.\n79|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n80|\n81|// windowsDrivePattern matches a Windows drive-qualified absolute\n82|// prefix: a letter, a colon, and a separator.\n83|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n84|\n85|// CheckIdentity validates one Provider Identity Record naming the\n86|// expected provider. Shape violations are provider_protocol_errors;\n87|// a well-formed record for another provider is an invalid_config\n88|// caller error: the caller correlated the wrong identity to this\n89|// session.\n90|func CheckIdentity(body []byte, wantProviderID string) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, identityRequired); missing {\n107|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n114|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n121|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n128|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n(more lines below)"}}}
