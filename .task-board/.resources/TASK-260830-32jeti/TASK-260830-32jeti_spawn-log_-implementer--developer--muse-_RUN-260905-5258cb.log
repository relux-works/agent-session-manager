{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc91","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":1187,"recorded_at":1780531400002369,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"bc082dc4-8457-4fc6-88d0-2c30fc65d58a"},"task_id":"bc082dc4-8457-4fc6-88d0-2c30fc65d58a","event":{"kind":"output","task_id":"bc082dc4-8457-4fc6-88d0-2c30fc65d58a","chunk":"edited\nchanged lines: lines 2923-2925\n--- original\n+++ updated\n@@\n-      \"coverage\": \"unevidenced\",\n-      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.A; no clause of 7.A is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\"\n-    },\n+      \"coverage\": \"unevidenced\",\n+      \"gap\": \"ForRelease only returns the reviewed typed catalog rows that reference 7.A; no clause of 7.A is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\"\n+    },\n+    {\n+      \"kind\": \"section_binding\",\n+      \"keys\": [\n+        \"section:7.1\"\n+      ],\n+      \"production\": {\n+        \"path\": \"internal/provider/provider.go\",\n+        \"declaration\": \"Discover\"\n+      },\n+      \"acceptance_cases\": [\n+        \"provider-discovery-and-trust\"\n+      ],\n+      \"coverage\": \"unevidenced\",\n+      \"gap\": \"Discover implements the Section 7.1 deterministic discovery, trust recording, and substitution detection with the section-mandated duplicate invalid_config refusal; no clause of Section 7.1 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 6 obligations it carries.\"\n+    },\n+    {\n+      \"kind\": \"section_binding\",\n+      \"keys\": [\n+        \"section:7.6\"\n+      ],\n+      \"production\": {\n+        \"path\": \"internal/provhost/quiesce.go\",\n+        \"declaration\": \"DecodeQuiesceProof\"\n+      },\n+      \"acceptance_cases\": [\n+        \"provhost-quiesce-proof\"\n+      ],\n+      \"coverage\": \"unevidenced\",\n+      \"gap\": \"DecodeQuiesceProof implements the Section 7.6 quiescence proof decoder with its fail-closed safe-bit rules; the Provider Identity Record it carries is additionally checked by CheckIdentity, and no clause of Section 7.6 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 3 obligations it carries.\"\n+    },\n+    {\n+      \"kind\": \"section_binding\",\n+      \"keys\": [\n+        \"section:7.7\"\n+      ],\n+      \"production\": {\n+        \"path\": \"internal/provhost/profile.go\",\n+        \"declaration\": \"ProfileMapping\"\n+      },\n+      \"acceptance_cases\": [\n+        \"provhost-profile-mapping\"\n+      ],\n+      \"coverage\": \"unevidenced\",\n+      \"gap\": \"ProfileMapping implements the Section 7.7 execution-profile mapping as a closed six-provider vocabulary with unknown-profile refusal; version probing before mapping and the launch-plan equality rules belong to later leaves, and no clause of Section 7.7 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 4 obligations it carries.\"\n+    },\n+    {\n+      \"kind\": \"section_binding\",\n+      \"keys\": [\n+        \"section:8\"\n+      ],\n+      \"production\": {\n+        \"path\": \"internal/provhost/probe.go\",\n+        \"declaration\": \"RequireCapability\"\n+      },\n+      \"acceptance_cases\": [\n+        \"provhost-capability-gate\"\n+      ],\n+      \"coverage\": \"unevidenced\",\n+      \"gap\": \"RequireCapability implements the Section 8 fail-closed capability gate direction (conditional, unsupported, and unknown surfaces are never usable) without advertising unsupported capabilities; the cell values themselves remain evidence labels and no clause of Section 8 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 12 obligations it carries.\"\n+    },\n"}}}
