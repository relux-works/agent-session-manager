{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71b","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":488,"recorded_at":1780531400000971,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"f923c700-da4d-4212-9a58-e5ca8ab9afd5"},"task_id":"f923c700-da4d-4212-9a58-e5ca8ab9afd5","event":{"kind":"output","task_id":"f923c700-da4d-4212-9a58-e5ca8ab9afd5","chunk":"Read text file `internal/canonicaljson/canonical.go`.\n(214 line(s) above)\n215|//\tValidateObservationEvent\n216|//\tValidateObservationStream\n217|//\n218|// Canonicalize itself carries no such guarantee. It is a byte transform over\n219|// whatever RFC 8785 accepts, and this package exports no standalone AX number\n220|// validator, so a caller that needs the AX number model must reach it through\n221|// one of the entry points named above rather than by canonicalizing first.\n222|func Canonicalize(input []byte) ([]byte, error) {\n223|\tvalue, err := decodeStrict(input)\n224|\tif err != nil {\n225|\t\treturn nil, err\n226|\t}\n227|\t// Re-encode the parsed logical value before the JCS transform. This removes\n228|\t// leading/trailing whitespace around primitive top-level values without\n229|\t// changing json.Number tokens or string data.\n230|\tnormalized, err := json.Marshal(value)\n231|\tif err != nil {\n232|\t\treturn nil, invalidJSON(\"serialize logical JSON value: %v\", err)\n233|\t}\n234|\tcanonical, err := jcs.Transform(normalized)\n235|\tif err != nil {\n236|\t\treturn nil, invalidJSON(\"canonicalize RFC 8785 value: %v\", err)\n237|\t}\n238|\treturn canonical, nil\n239|}\n240|\n241|// CalculateObjectIdentity validates the AX common logical number model,\n242|// resolves the one self field from the object's trusted schema/version\n243|// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\n244|// identity. Callers cannot select an arbitrary field to omit, which prevents\n245|// self inclusion and digest cycles.\n246|//\n247|// This is where the AX safe-integer refusal lives, not in Canonicalize: a\n248|// literal at or beyond 2^53, or any floating-point literal, is refused here\n249|// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\n250|// OF GUARANTEES note on Canonicalize.\n251|func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n252|\tobject, selfField, _, err := prepareObjectIdentity(input)\n253|\tif err != nil {\n254|\t\treturn scalar.Digest{}, \"\", err\n255|\t}\n256|\treturn calculatePreparedObjectIdentity(object, selfField)\n257|}\n258|\n259|func prepareObjectIdentity(input []byte) (map[string]any, SelfField, scalar.Digest, error) {\n260|\tif len(input) > 5_242_880 {\n261|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"encoded identity object is %d bytes, maximum is 5242880\", len(input))\n262|\t}\n263|\tvalue, err := decodeStrict(input)\n264|\tif err != nil {\n265|\t\treturn nil, \"\", scalar.Digest{}, err\n266|\t}\n267|\tif err := validateAXNumbers(value); err != nil {\n268|\t\treturn nil, \"\", scalar.Digest{}, err\n269|\t}\n270|\tobject, ok := value.(map[string]any)\n271|\tif !ok {\n272|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"identity input must be a JSON object\")\n273|\t}\n274|\n(more lines below)"}}}
