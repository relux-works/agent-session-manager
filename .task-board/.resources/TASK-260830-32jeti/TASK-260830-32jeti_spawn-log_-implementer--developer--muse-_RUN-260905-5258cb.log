ntrust_sources_test.go\\ntrust_test.go\\n---\\n M LOGBOOK.md\\n M README.md\\n A internal/provhost/closed_vocabularies_test.go\\n A internal/provhost/closed_vocabulary_census_test.go\\n A internal/provhost/conformance_test.go\\n M internal/provhost/doc.go\\n A internal/provhost/idempotency.go\\n A internal/provhost/idempotency_test.go\\n A internal/provhost/identity.go\\n A internal/provhost/identity_test.go\\n A internal/provhost/malformed_test.go\\n A internal/provhost/manifest.go\\n A internal/provhost/manifest_test.go\\n A internal/provhost/opdecode.go\\n A internal/provhost/probe.go\\n A internal/provhost/probe_test.go\\n A internal/provhost/profile.go\\n A internal/provhost/profile_test.go\\n M internal/provhost/protocol.go\\n A internal/provhost/quiesce.go\\n A internal/provhost/quiesce_test.go\\n M internal/provhost/refusal_arm_inventory_test.go\\n A internal/provhost/refusal_arm_operations_a_test.go\\n A internal/provhost/refusal_arm_operations_b_test.go\\n A internal/provhost/refusal_arm_operations_c_test.go\\n M internal/provhost/runner.go\\n M internal/provhost/runner_test.go\\n A internal/provhost/spawn.go\\n A internal/provhost/spawn_test.go\\n M internal/provhost/status.go\\n---\\n8fbc052 TASK-260830-qcosxq: TASK-260830-qcosxq: implement-provider-jsonl-protocol\\n66573e9 TASK-260830-2890sd: TASK-260830-2890sd: implement-provider-discovery-and-trust\\n6632410 TASK-260830-2890sd: close review round-2 findings F6-F10\\nf0936d8 TASK-260830-2890sd: implement-provider-discovery-and-trust\\n57afcc6 Admit muse-spark as the producer runtime alongside Opus reviewers\\n\",\n  \"original_output_bytes\": 2392,\n  \"original_output_tokens\": 598,\n  \"truncated\": false\n}"}}}
