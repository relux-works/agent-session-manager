ntractPin) map[string]struct{} {\n803|\tresult := make(map[string]struct{}, len(contracts))\n804|\tfor _, contract := range contracts {\n805|\t\tresult[contractKey(contract.Name, contract.ID)] = struct{}{}\n806|\t}\n807|\treturn result\n808|}\n809|\n810|func contractKey(name, id string) string {\n811|\treturn name + \" [\" + id + \"]\"\n812|}\n813|\n814|func expectedNormativeSections(manifest specpin.Manifest, value catalog.Catalog) map[string]struct{} {\n815|\tresult := make(map[string]struct{})\n816|\tfor _, section := range manifest.Source.NormativeScope {\n817|\t\tresult[\"source:\"+section] = struct{}{}\n818|\t}\n819|\tfor _, operation := range value.Operations {\n820|\t\tresult[\"catalog:\"+operation.NormativeSection] = struct{}{}\n821|\t}\n822|\tfor _, capability := range value.Capabilities {\n823|\t\tresult[\"catalog:\"+capability.NormativeSection] = struct{}{}\n824|\t}\n825|\tfor _, event := range value.Events {\n826|\t\tresult[\"catalog:\"+event.NormativeSection] = struct{}{}\n827|\t}\n828|\tfor _, item := range value.Errors {\n829|\t\tresult[\"catalog:\"+item.NormativeSection] = struct{}{}\n830|\t}\n831|\treturn result\n832|}\n833|\n834|func expectedFixtures(manifest specpin.Manifest, value catalog.Catalog) map[string]struct{} {\n835|\tresult := make(map[string]struct{})\n836|\tfor _, fixture := range manifest.Fixtures {\n837|\t\tresult[\"pin:\"+fixture.ID] = struct{}{}\n838|\t}\n839|\tadd := func(fixtures []string) {\n840|\t\tfor _, fixture := range fixtures {\n841|\t\t\tresult[\"catalog:\"+fixture] = struct{}{}\n842|\t\t}\n843|\t}\n844|\tfor _, operation := range value.Operations {\n845|\t\tadd(operation.FixtureFamilies)\n846|\t}\n847|\tfor _, capability := range value.Capabilities {\n848|\t\tadd(capability.FixtureFamilies)\n849|\t}\n850|\tfor _, event := range value.Events {\n851|\t\tadd(event.FixtureFamilies)\n852|\t}\n853|\tfor _, item := range value.Errors {\n854|\t\tadd(item.FixtureFamilies)\n855|\t}\n856|\treturn result\n857|}\n858|\n859|type sourceChecker struct {\n860|\trepository fs.FS\n861|\tfiles      map[string]*ast.File\n862|}\n863|\n864|func newSourceChecker(repository fs.FS) *sourceChecker {\n865|\treturn &sourceChecker{repository: repository, files: make(map[string]*ast.File)}\n866|}\n867|\n868|func (checker *sourceChecker) verify(reference codeReference, test bool) error {\n869|\tif reference.Path == \"\" || reference.Declaration == \"\" {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
