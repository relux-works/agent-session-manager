{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c477","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":150,"recorded_at":1780531400000295,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"b95bfdae-b08e-461b-88f1-266f430bf8d1"},"task_id":"b95bfdae-b08e-461b-88f1-266f430bf8d1","event":{"kind":"output","task_id":"b95bfdae-b08e-461b-88f1-266f430bf8d1","chunk":"{\n  \"chunk_id\": \"exec-3-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nd=json.load(open('internal/traceability/ownership.v0.5.0.json'))\\nprint(type(d), list(d.keys())[:10] if isinstance(d,dict) else len(d))\\n\\\" 2>&1 | head -20; echo ---; grep -n \\\"reviewedOwnershipCanonicalSHA256\\\" internal/traceability/traceability.go | head; echo ---; grep -n \\\"5.5\\\\|7\\\\.2\\\\|7\\\\.3\\\\|7\\\\.5\\\\|provider manifest\\\" internal/traceability/ownership.v0.5.0.json | head -40\",\n  \"description\": \"Inspect ownership registry structure\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"<class 'dict'> ['format', 'format_version', 'source', 'acceptance_cases', 'ownership', 'unowned_sections']\\n---\\n40:\\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\\n43:\\treviewedOwnershipCanonicalSHA256 = \\\"c70c86d24c7a1eddb538940f245396dad907b6aa60eaca92a6d5b1b09a647a12\\\"\\n422:\\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\\n423:\\t\\treturn Report{}, fail(\\\"ownership registry projection digest %s differs from reviewed %s\\\", gotDigest, reviewedOwnershipCanonicalSHA256)\\n---\\n2378:        \\\"catalog:7.2, 7.5, 7.A\\\",\\n2379:        \\\"catalog:7.3-7.4\\\",\\n2591:        \\\"section:17.2\\\"\\n2608:      \\\"gap\\\": \\\"Section 17.2 carries exactly one scanner-visible obligation, clause 17.2#1: a reader MAY retain an unknown event as inert history but MUST NOT derive state from it. That clause binds Session Event history, and Read classifies one completed CLI invocation rather than retaining any event, so this binding discharges none of Section 17.2's measured obligations. The four numbered reader rules the section states carry no RFC 2119 keyword and are therefore invisible to the clause scanner; three of them are implemented and tested here - Read and Decode settle the schema and major before any other member, the closed member set included, acceptsVersion implements the same-or-lower-minor rule, and an unknown namespaced extension survives a decode and re-encode byte for byte - while the unknown ownership/security enum rule is covered only for the closed CLI Result vocabularies, not for any lease or security enum, because no ownership implementation exists in this repository.\\\"\\n2721:        \\\"section:5.5\\\"\\n2731:      \\\"gap\\\": \\\"validateProviderIdentityRecord validates the Section 5.5 provider identity shape; the destination-adapter obligations of Section 5.5 are not implemented and no clause of it is enumerated.\\\"\\n2751:        \\\"section:7.2\\\"\\n2761:      \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.2; no clause of 7.2 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 7 obligations it carries.\\\"\\n2766:        \\\"section:7.3\\\"\\n2776:      \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.3; the RFC 2119 scanner measures no clause line under 7.3, because the closed Provider Manifest states its obligations as a required-member table, a 16-entry operation registry and exactly 7 capability names rather than in uppercase keywords, so the gate cannot measure this section - and no provider manifest is implemented anywhere in this repository.\\\"\\n2831:        \\\"section:7.5\\\"\\n2841:      \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.5; no clause of 7.5 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 53 obligations it carries.\\\"\\n3231:        \\\"section:17.3\\\"\\n3242:      \\\"gap\\\": \\\"validateMigrationProvenance validates the Section 17.3 provenance contribution to object identity; the in-place-edit prohibition and the backup/atomic-write migration clauses are implemented in internal/config, and no clause of Section 17.3 is enumerated.\\\"\\n\",\n  \"original_output_bytes\": 3132,\n  \"original_output_tokens\": 783,\n  \"truncated\": false\n}"}}}
