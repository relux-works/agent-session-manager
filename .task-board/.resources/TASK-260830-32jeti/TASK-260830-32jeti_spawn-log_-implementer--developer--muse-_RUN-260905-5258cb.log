{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c675","stream":{"kind":"session","id":"01a07060-dc53-7421-8823-10572f5f580f"},"sequence":405,"recorded_at":1780531400000805,"record_type":"event","durability":"durable","causation_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647","run_stream":{"kind":"run","id":"1bd0f4b7-3d42-45e7-aae9-47d49f725647"},"task_stream":{"kind":"task","id":"ad3a7122-4ba6-44bd-a146-f891a0207886"},"task_id":"ad3a7122-4ba6-44bd-a146-f891a0207886","event":{"kind":"output","task_id":"ad3a7122-4ba6-44bd-a146-f891a0207886","chunk":"Read text file `internal/traceability/traceability.go`.\n(867 line(s) above)\n868|func (checker *sourceChecker) verify(reference codeReference, test bool) error {\n869|\tif reference.Path == \"\" || reference.Declaration == \"\" {\n870|\t\treturn errors.New(\"code reference has an empty path or declaration\")\n871|\t}\n872|\tclean := path.Clean(reference.Path)\n873|\tif clean != reference.Path || clean == \".\" || path.IsAbs(clean) || strings.HasPrefix(clean, \"../\") {\n874|\t\treturn fmt.Errorf(\"unsafe code reference path %q\", reference.Path)\n875|\t}\n876|\tif path.Ext(clean) != \".go\" {\n877|\t\treturn fmt.Errorf(\"code reference %q is not a Go source file\", clean)\n878|\t}\n879|\tif test {\n880|\t\tif !strings.HasSuffix(clean, \"_test.go\") || !isExecutableTestName(reference.Declaration) {\n881|\t\t\treturn fmt.Errorf(\"test owner %s:%s is not an executable Go test reference\", clean, reference.Declaration)\n882|\t\t}\n883|\t} else if strings.HasSuffix(clean, \"_test.go\") {\n884|\t\treturn fmt.Errorf(\"production owner %s:%s points to test code\", clean, reference.Declaration)\n885|\t}\n886|\n887|\tfile, ok := checker.files[clean]\n888|\tif !ok {\n889|\t\tsource, err := fs.ReadFile(checker.repository, clean)\n890|\t\tif err != nil {\n891|\t\t\treturn fmt.Errorf(\"read %q: %w\", clean, err)\n892|\t\t}\n893|\t\tfile, err = parser.ParseFile(token.NewFileSet(), clean, source, parser.SkipObjectResolution)\n894|\t\tif err != nil {\n895|\t\t\treturn fmt.Errorf(\"parse %q: %w\", clean, err)\n896|\t\t}\n897|\t\tchecker.files[clean] = file\n898|\t}\n899|\tif !hasDeclaration(file, reference.Declaration, test) {\n900|\t\treturn fmt.Errorf(\"declaration %q is absent from %q\", reference.Declaration, clean)\n901|\t}\n902|\treturn nil\n903|}\n904|\n905|func isExecutableTestName(name string) bool {\n906|\tfor _, prefix := range []string{\"Test\", \"Fuzz\"} {\n907|\t\tif !strings.HasPrefix(name, prefix) {\n908|\t\t\tcontinue\n909|\t\t}\n910|\t\tsuffix := name[len(prefix):]\n911|\t\tif suffix == \"\" {\n912|\t\t\treturn true\n913|\t\t}\n914|\t\tfirst, _ := utf8.DecodeRuneInString(suffix)\n915|\t\treturn !unicode.IsLower(first)\n916|\t}\n917|\treturn false\n918|}\n919|\n920|func hasDeclaration(file *ast.File, name string, test bool) bool {\n921|\tfor _, declaration := range file.Decls {\n922|\t\tswitch value := declaration.(type) {\n923|\t\tcase *ast.FuncDecl:\n924|\t\t\tif value.Name.Name == name && (!test || value.Recv == nil) {\n925|\t\t\t\treturn true\n926|\t\t\t}\n927|\t\tcase *ast.GenDecl:\n928|\t\t\tif test {\n929|\t\t\t\tcontinue\n930|\t\t\t}\n931|\t\t\tfor _, specification := range value.Specs {\n932|\t\t\t\tswitch item := specification.(type) {\n933|\t\t\t\tcase *ast.TypeSpec:\n934|\t\t\t\t\tif item.Name.Name == name {\n935|\t\t\t\t\t\treturn true\n936|\t\t\t\t\t}\n937|\t\t\t\tcase *ast.ValueSpec:\n938|\t\t\t\t\tfor _, identifier := range item.Names {\n939|\t\t\t\t\t\tif identifier.Name == name {\n940|\t\t\t\t\t\t\treturn true\n941|\t\t\t\t\t\t}\n942|\t\t\t\t\t}\n943|\t\t\t\t}\n944|\t\t\t}\n945|\t\t}\n946|\t}\n947|\treturn false\n948|}\n949|\n950|func equalStrings(left, right []string) bool {\n951|\tif len(left) != len(right) {\n952|\t\treturn false\n953|\t}\n954|\tfor index := range left {\n955|\t\tif left[index] != right[index] {\n956|\t\t\treturn false\n957|\t\t}\n958|\t}\n959|\treturn true\n960|}\n961|\n962|func fail(format string, arguments ...any) error {\n963|\treturn fmt.Errorf(\"%w: %s\", ErrTraceability, fmt.Sprintf(format, arguments...))\n964|}\n965|\n966|// normativeKeywordPattern matches the RFC 2119 obligation keywords that make a\n967|// specification line a clause an implementation has to discharge. MAY and\n968|// SHOULD are deliberately absent: they create no obligation, so counting them\n969|// would inflate the denominator and make coverage look worse than it is.\n970|var normativeKeywordPattern = regexp.MustCompile(`\\b(MUST NOT|MUST|SHALL NOT|SHALL|REQUIRED)\\b`)\n971|\n972|// clauseIdentifierPattern matches the \"<section>#<index>\" form of a clause id.\n973|var clauseIdentifierPattern = regexp.MustCompile(`^(.+)#([1-9][0-9]*)$`)\n974|\n975|// minimumGapLength is the shortest gap sentence the gate accepts. A gap has to\n976|// say what is missing; \"n/a\", \"todo\" and an empty string are not disclosures.\n977|const minimumGapLength = 32\n978|\n979|// verifyGapDiscloses checks that a gap sentence is a disclosure rather than\n980|// padding. Length and a substring match alone were not enough: \"Section 9.2 is\n981|// not fully covered here yet.\" satisfied both while saying nothing. A real gap\n982|// says what the binding's own implementation does and does not reach, so it has\n983|// to name the production declaration the binding is registered to as well as\n984|// the section, and it has to name the section as a whole identifier so that a\n985|// gap about 6.55 cannot pass for a gap about 6.5.\n986|//\n987|// This is a tightening, not a proof: a sentence that names both and still says\n988|// nothing useful is admitted, and the gate cannot decide otherwise. That limit\n989|// is stated in README.md.\n990|func verifyGapDiscloses(gap, display, declaration string) error {\n991|\tif len(gap) < minimumGapLength {\n992|\t\treturn fmt.Errorf(\"gap %q is shorter than the %d characters a disclosure needs\", gap, minimumGapLength)\n993|\t}\n994|\tif !mentionsSection(gap, display) {\n995|\t\treturn fmt.Errorf(\"gap does not name section %s as a whole identifier\", display)\n996|\t}\n997|\tif declaration != \"\" && !strings.Contains(gap, declaration) {\n998|\t\treturn fmt.Errorf(\"gap does not name the production declaration %q the binding is registered to\", declaration)\n999|\t}\n1000|\treturn nil\n1001|}\n1002|\n1003|// mentionsSection reports whether text names the section display identifier as\n1004|// a whole identifier. A bare substring match accepts \"6.55\" as a mention of\n1005|// \"6.5\" and \"13.15\" as a mention of \"13.1\", which would let a gap about one\n1006|// section stand in for another.\n1007|func mentionsSection(text, display string) bool {\n1008|\tpattern, err := regexp.Compile(`(?:^|[^0-9.])` + regexp.QuoteMeta(display) + `(?:[^0-9]|$)`)\n1009|\tif err != nil {\n1010|\t\treturn false\n1011|\t}\n1012|\treturn pattern.MatchString(text)\n1013|}\n1014|\n1015|// sectionDocumentIdentifier maps an ownership key to the heading identifier the\n1016|// pinned document uses. \"section:10.3\" is heading 10.3; \"section:appendix-d\" is\n1017|// heading D.\n1018|func sectionDocumentIdentifier(key string) (string, error) {\n1019|\tidentifier := strings.TrimPrefix(key, \"section:\")\n1020|\tif identifier == key || identifier == \"\" {\n1021|\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a section binding key\", key)\n1022|\t}\n1023|\tif rest, ok := strings.CutPrefix(identifier, \"appendix-\"); ok {\n1024|\t\tif len(rest) != 1 {\n1025|\t\t\treturn \"\", fmt.Errorf(\"ownership key %q is not a real appendix key\", key)\n1026|\t\t}\n1027|\t\treturn strings.ToUpper(rest), nil\n(more lines below)"}}}
