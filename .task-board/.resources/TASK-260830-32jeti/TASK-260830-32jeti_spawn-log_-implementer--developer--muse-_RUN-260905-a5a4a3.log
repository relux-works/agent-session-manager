{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c563","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":268,"recorded_at":1780531400000531,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"task_stream":{"kind":"task","id":"a6272dc2-78d5-4349-a28f-d8c9ef8b59e0"},"task_id":"a6272dc2-78d5-4349-a28f-d8c9ef8b59e0","event":{"kind":"output","task_id":"a6272dc2-78d5-4349-a28f-d8c9ef8b59e0","chunk":"Read text file `/tmp/rev6/review-round6-switch-vocab-probe_test.go.txt`.\n1|package provhost\n2|\n3|import \"testing\"\n4|\n5|// TestReviewProbeSwitchVocabularies drives each switch-shaped closed\n6|// vocabulary through its real production entry point with the\n7|// widened value. Against the shipped tree every row must REFUSE;\n8|// with the corresponding widening mutant planted each row ACCEPTS,\n9|// which is what makes the mutant a real acceptance rather than a\n10|// no-op the suite happens to miss.\n11|func TestReviewProbeSwitchVocabularies(t *testing.T) {\n12|\tt.Run(\"envelope admits a seventh member\", func(t *testing.T) {\n13|\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"bogus\":[]`), mustUUIDv7(t, testRequestID))\n14|\t\tif err == nil {\n15|\t\t\tt.Log(\"ACCEPTED: response envelope carrying \\\"bogus\\\" decoded without refusal\")\n16|\t\t\tt.Fatal(\"PROBE: envelope accepted an extra top-level member\")\n17|\t\t}\n18|\t\tt.Logf(\"REFUSED: %v\", err)\n19|\t})\n20|\tt.Run(\"profile mapping admits a third profile\", func(t *testing.T) {\n21|\t\tgot, err := ProfileMapping(\"codex\", \"bogus\")\n22|\t\tif err == nil {\n23|\t\t\tt.Logf(\"ACCEPTED: ProfileMapping(codex, bogus) = %q\", got)\n24|\t\t\tt.Fatal(\"PROBE: unknown profile resolved instead of refusing\")\n25|\t\t}\n26|\t\tt.Logf(\"REFUSED: %v\", err)\n27|\t})\n28|\tt.Run(\"status admits a fifth state\", func(t *testing.T) {\n29|\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"bogus\", testRollbackToken, testDiscovery)\n30|\t\tstate, err := DecodeStatusOutcome(body, testStatusIDs())\n31|\t\tif err == nil {\n32|\t\t\tt.Logf(\"ACCEPTED: DecodeStatusOutcome state = %q\", state)\n33|\t\t\tt.Fatal(\"PROBE: unknown transaction state decoded as valid\")\n34|\t\t}\n35|\t\tt.Logf(\"REFUSED: %v\", err)\n36|\t})\n37|}"}}}
