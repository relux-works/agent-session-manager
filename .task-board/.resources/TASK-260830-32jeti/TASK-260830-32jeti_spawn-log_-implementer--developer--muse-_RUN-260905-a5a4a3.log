{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e9","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":463,"recorded_at":1780531400000921,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"task_stream":{"kind":"task","id":"db5d38be-4336-4d15-874a-2017bfa2c761"},"task_id":"db5d38be-4336-4d15-874a-2017bfa2c761","event":{"kind":"output","task_id":"db5d38be-4336-4d15-874a-2017bfa2c761","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner_test.go`.\n(499 line(s) above)\n500|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n501|\t\tt.Fatalf(\"WriteFile: %v\", err)\n502|\t}\n503|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n504|\tgot, err := host.Call(context.Background(), script, liveRequest(t))\n505|\tif err != nil {\n506|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n507|\t}\n508|\tif string(got.Body) != `{\"provider_id\":\"echo\"}` {\n509|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n510|\t}\n511|}\n512|\n513|// TestExecRunnerEnforcesDeadline drives the production kill path: a\n514|// plugin that sleeps past the deadline is terminated and reported as\n515|// provider_timeout.\n516|func TestExecRunnerEnforcesDeadline(t *testing.T) {\n517|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n518|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n519|\t}\n520|\tscript := filepath.Join(t.TempDir(), \"ax-provider-sleep\")\n521|\tif err := os.WriteFile(script, []byte(\"#!/bin/sh\\nsleep 30\\n\"), 0o700); err != nil {\n522|\t\tt.Fatalf(\"WriteFile: %v\", err)\n523|\t}\n524|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n525|\treq := liveRequest(t)\n526|\tstamp, err := scalar.ParseTimestamp(time.Now().Add(300 * time.Millisecond).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n527|\tif err != nil {\n528|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n529|\t}\n530|\treq.Deadline = stamp\n531|\tstart := time.Now()\n532|\t_, err = host.Call(context.Background(), script, req)\n533|\telapsed := time.Since(start)\n534|\tif elapsed > 20*time.Second {\n535|\t\tt.Fatalf(\"Call took %v, want termination near the deadline\", elapsed)\n536|\t}\n537|\t// Returning before the drain delay shows the wait did not linger\n538|\t// for pipe EOF after the deadline kill. What the group kill buys\n539|\t// beyond Setpgid/Kill consistency is unknown on this platform:\n540|\t// removing the Cancel alone still returns in ~300ms here, while\n541|\t// disabling Setpgid delays past 2s — so this pins termination\n542|\t// latency, not detached-descendant fate.\n543|\tif elapsed >= waitDrainDelay {\n544|\t\tt.Fatalf(\"Call took %v, want group termination well before the %v drain delay\", elapsed, waitDrainDelay)\n545|\t}\n546|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n547|}\n548|\n549|// TestExecRunnerReportsCrashExit drives the production exit-code path: a\n550|// real plugin that exits 3 without answering is provider_process_failed,\n551|// while one that exits 0 without answering is provider_protocol_error.\n552|// Discarding ExitCode in ExecRunner promotes the crash to a protocol\n553|// error, and the promotion reddens here. The production entry point is\n554|// Host.Call over ExecRunner.\n555|func TestExecRunnerReportsCrashExit(t *testing.T) {\n556|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n557|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n558|\t}\n559|\tfor _, kase := range []struct {\n560|\t\tname   string\n561|\t\tscript string\n562|\t\tcode   string\n563|\t\tdetail string\n564|\t}{\n565|\t\t{\"crash exit\", \"#!/bin/sh\\ncat > /dev/null\\nexit 3\\n\", \"provider_process_failed\", \"plugin exited without a response\"},\n566|\t\t{\"clean exit\", \"#!/bin/sh\\ncat > /dev/null\\nexit 0\\n\", \"provider_protocol_error\", \"plugin exited without a response\"},\n567|\t} {\n568|\t\tt.Run(kase.name, func(t *testing.T) {\n569|\t\t\tplugin := filepath.Join(t.TempDir(), \"ax-provider-exit\")\n570|\t\t\tif err := os.WriteFile(plugin, []byte(kase.script), 0o700); err != nil {\n571|\t\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n572|\t\t\t}\n573|\t\t\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n574|\t\t\t_, err := host.Call(context.Background(), plugin, liveRequest(t))\n575|\t\t\tif kase.code == \"provider_protocol_error\" {\n576|\t\t\t\trequireFrameRefusal(t, err, \"\", kase.detail)\n577|\t\t\t} else {\n578|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.code), kase.detail)\n579|\t\t\t}\n580|\t\t})\n581|\t}\n582|}\n583|\n584|// TestExecRunnerWritesOneTerminatedFrame drives the production stdin\n585|// path: the exact request frame plus the Section 7.2 line terminator must\n586|// reach the plugin. The script saves its stdin aside and answers from it,\n587|// so the captured bytes pin what ExecRunner wrote. Omitting the newline\n588|// reddens the byte comparison here.\n589|func TestExecRunnerWritesOneTerminatedFrame(t *testing.T) {\n590|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n591|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n592|\t}\n593|\troot := t.TempDir()\n594|\tcapture := filepath.Join(root, \"stdin-capture\")\n595|\tscript := filepath.Join(root, \"ax-provider-capture\")\n596|\tplugin := `#!/bin/sh\n597|cat > \"$AX_STDIN_CAPTURE\"\n598|frame=$(cat \"$AX_STDIN_CAPTURE\")\n599|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n600|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n601|exit 0\n602|`\n603|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n604|\t\tt.Fatalf(\"WriteFile: %v\", err)\n605|\t}\n606|\tt.Setenv(\"AX_STDIN_CAPTURE\", capture)\n607|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n608|\treq := liveRequest(t)\n609|\tif _, err := host.Call(context.Background(), script, req); err != nil {\n610|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n611|\t}\n612|\tframe, err := EncodeRequest(req, time.Now())\n613|\tif err != nil {\n614|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n615|\t}\n616|\twant := append(append([]byte(nil), frame...), '\\n')\n617|\tgot, err := os.ReadFile(capture)\n618|\tif err != nil {\n619|\t\tt.Fatalf(\"ReadFile capture: %v\", err)\n620|\t}\n621|\tif string(got) != string(want) {\n622|\t\tt.Fatalf(\"plugin stdin is %d bytes ending %q, want the %d-byte frame plus one newline\", len(got), lastByte(got), len(want))\n623|\t}\n624|}\n625|\n626|// lastByte renders the final stdin byte for the terminator failure text.\n627|func lastByte(data []byte) string {\n628|\tif len(data) == 0 {\n629|\t\treturn \"empty\"\n630|\t}\n631|\treturn string(data[len(data)-1:])\n632|}"}}}
