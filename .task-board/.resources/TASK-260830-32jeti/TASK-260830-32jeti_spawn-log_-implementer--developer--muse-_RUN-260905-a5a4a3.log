{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c56b","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":272,"recorded_at":1780531400000539,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"task_stream":{"kind":"task","id":"7fb5e507-e534-481c-a6d8-ff8917e820c8"},"task_id":"7fb5e507-e534-481c-a6d8-ff8917e820c8","event":{"kind":"output","task_id":"7fb5e507-e534-481c-a6d8-ff8917e820c8","chunk":"Read text file `/tmp/rev6/review-round6-runner-race-probe_test.go.txt`.\n1|// Drop in as internal/provhost/zz_runnerrace_test.go and run:\n2|//   go test ./internal/provhost/ -count=1 -run TestReviewRunnerRace -v\n3|// Measures F2 at the production entry point Host.Call over ExecRunner.\n4|package provhost\n5|\n6|import (\n7|\t\"context\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"path/filepath\"\n11|\t\"sort\"\n12|\t\"testing\"\n13|\t\"time\"\n14|)\n15|\n16|func tallyCall(t *testing.T, script string, n int) map[string]int {\n17|\tt.Helper()\n18|\tplugin := filepath.Join(t.TempDir(), \"ax-provider-probe\")\n19|\tif err := os.WriteFile(plugin, []byte(script), 0o700); err != nil {\n20|\t\tt.Fatal(err)\n21|\t}\n22|\ttally := map[string]int{}\n23|\tfor i := 0; i < n; i++ {\n24|\t\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n25|\t\t_, err := host.Call(context.Background(), plugin, liveRequest(t))\n26|\t\tkey := \"OK (frame accepted)\"\n27|\t\tif err != nil {\n28|\t\t\tkey = err.Error()\n29|\t\t}\n30|\t\ttally[key]++\n31|\t}\n32|\treturn tally\n33|}\n34|\n35|func report(t *testing.T, label string, tally map[string]int) {\n36|\tt.Helper()\n37|\tvar keys []string\n38|\tfor k := range tally {\n39|\t\tkeys = append(keys, k)\n40|\t}\n41|\tsort.Strings(keys)\n42|\tfor _, k := range keys {\n43|\t\tt.Logf(\"[%s] %4d  %s\", label, tally[k], k)\n44|\t}\n45|}\n46|\n47|func TestReviewRunnerRace(t *testing.T) {\n48|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n49|\t\tt.Skip(\"no sh\")\n50|\t}\n51|\tvalidFrame := \"#!/bin/sh\\n\" +\n52|\t\t`printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}'` + \"\\n\"\n53|\treport(t, \"valid-frame-no-stdin-read\", tallyCall(t, validFrame, 300))\n54|\treport(t, \"crash-exit-3\", tallyCall(t, \"#!/bin/sh\\ncat > /dev/null\\nexit 3\\n\", 300))\n55|}"}}}
