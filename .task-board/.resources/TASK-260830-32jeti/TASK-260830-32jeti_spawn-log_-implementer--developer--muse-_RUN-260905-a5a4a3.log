{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65b","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":392,"recorded_at":1780531400000779,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"call_id":"call_01a0703a5d9378b397611f37f06b2474","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/closed_vocabulary_census_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n16|)\n17|\n18|// This file closes the closed-vocabulary class by construction. The\n19|// eight enum derivations in closed_vocabularies_test.go are\n20|// hand-registered one by one, and nine more membership-checked\n21|// vocabularies existed in production with no derivation at all: a\n22|// widened member set still admitted its extra body with the suite\n23|// green. Enumerating one more hand-written list per vocabulary would\n24|// move the gap, not close it, so the domain is derived the way\n25|// TestDerivedRefusalArmsAreAllWitnessed already does for refusal\n26|// arms: deriveMembershipVocabularies parses production source for\n27|// every package-level []string, map[string]bool, and\n28|// map[string]string consulted by a membership check, and\n29|// TestClosedVocabularyCensusCoversEveryMembershipVocabulary requires\n30|// each to carry a registered spec derivation. A new vocabulary with\n31|// no derivation fails here instead of passing silently.\n32|//\n33|// A membership check is one of: an unknownMember argument, a direct\n34|// map index, or a range that builds an allow-set or compares\n35|// element-wise. The *Required order lists are deliberately out of\n36|// scope: their only production use is as missingMember arguments,\n37|// they encode deterministic refusal order rather than containment,\n38|// and dropping their last entry is behaviour-preserving (the omitted\n39|// body still refuses). profileProviders is likewise out of scope:\n40|// nothing in production consults it. The []Operation registries are\n41|// out of scope by type and stay derived by\n42|// TestOperationRegistryIsDerivedFromSpec. An empty derivation —\n43|// zero files scanned, zero vocabularies found, a spec window with no\n44|// members — fails closed rather than measuring nothing.\n45|\n46|// requireMemberSet asserts the production member set holds exactly\n47|// the spec-derived members, order-insensitive: maps carry no order.\n48|// Either side empty is a blind check, so both fail outright.\n49|func requireMemberSet(t *testing.T, name string, got, want []string) {\n50|\tt.Helper()\n51|\tif len(got) == 0 {\n52|\t\tt.Fatalf(\"%s holds no members; the check is blind\", name)\n53|\t}\n54|\tif len(want) == 0 {\n55|\t\tt.Fatalf(\"%s derives no members from the pinned document; the check is blind\", name)\n56|\t}\n57|\tordered := func(members []string) []string {\n58|\t\tduplicated := append([]string(nil), members...)\n59|\t\tsort.Strings(duplicated)\n60|\t\treturn duplicated\n61|\t}\n62|\tif !reflect.DeepEqual(ordered(got), ordered(want)) {\n63|\t\tt.Fatalf(\"%s = %v, want the pinned member set %v\", name, ordered(got), ordered(want))\n64|\t}\n65|\tt.Logf(\"%s coverage: %d/%d members derived\", name, len(got), len(want))\n66|}\n67|\n68|// exampleObjectKeysOf parses the top-level keys of the JSON example\n69|// embedded in a spec window, in document order. A window with no\n70|// JSON object is a blind check, so it fails outright.\n71|func exampleObjectKeysOf(t *testing.T, window string) []string {\n72|\tt.Helper()\n73|\tstart := strings.Index(window, \"{\")\n74|\tend := strings.LastIndex(window, \"}\")\n75|\tif start < 0 || end <= start {\n76|\t\tt.Fatal(\"spec window holds no JSON object; the check is blind\")\n77|\t}\n78|\texample, fault := decodeStrictObject([]byte(window[start : end+1]))\n79|\tif fault != nil {\n80|\t\tt.Fatalf(\"spec example is not a strict object: %v %q\", fault.detail, fault.member)\n81|\t}\n82|\tvar keys []string\n83|\tfor key := range example {\n84|\t\tkeys = append(keys, key)\n85|\t}\n86|\tif len(keys) == 0 {\n87|\t\tt.Fatal(\"spec example holds no members; the check is blind\")\n88|\t}\n89|\treturn keys\n90|}\n91|\n92|// typeRowMembersOf parses one Section 7.5 embedded-type table row:\n93|// the first code span names the type, and every later span opens\n94|// with one member declaration. A row whose first span is not the\n95|// named type, or that carries no member span, is a blind check.\n96|func typeRowMembersOf(t *testing.T, row, typeName string) []string {\n97|\tt.Helper()\n98|\tspans := codeSpanPattern.FindAllStringSubmatch(row, -1)\n99|\tif len(spans) == 0 {\n100|\t\tt.Fatalf(\"Section 7.5 %s row holds no code elements; the check is blind\", typeName)\n101|\t}\n102|\tif spans[0][1] != typeName {\n103|\t\tt.Fatalf(\"Section 7.5 row opens with %q, want the %s declaration; the check is blind\", spans[0][1], typeName)\n104|\t}\n105|\tvar members []string\n106|\tfor _, span := range spans[1:] {\n107|\t\tname := span[1]\n108|\t\tif end := strings.Index(name, \":\"); end >= 0 {\n109|\t\t\tname = name[:end]\n110|\t\t}\n111|\t\tname = strings.TrimSpace(name)\n112|\t\tif name == \"\" {\n113|\t\t\tt.Fatalf(\"Section 7.5 %s row parses to an empty member; the check is blind\", typeName)\n114|\t\t}\n115|\t\tmembers = append(members, name)\n116|\t}\n117|\tif len(members) == 0 {\n118|\t\tt.Fatalf(\"Section 7.5 %s row parses to no members; the check is blind\", typeName)\n119|\t}\n120|\treturn members\n121|}\n122|\n123|// objectCellMembersOf parses the braced success-body cell of one\n124|// Section 7.5 operation row: the single code span starting with \"{\"\n125|// whose text names marker, split on top-level commas, one member per\n126|// element before its colon. Zero or two matching cells is a blind\n127|// check.\n128|func objectCellMembersOf(t *testing.T, row, marker string) []string {\n129|\tt.Helper()\n130|\tspans := codeSpanPattern.FindAllStringSubmatch(row, -1)\n131|\tvar cell string\n132|\tmatches := 0\n133|\tfor _, span := range spans {\n134|\t\tif strings.HasPrefix(span[1], \"{\") && strings.Contains(span[1], marker) {\n135|\t\t\tcell = span[1]\n136|\t\t\tmatches++\n137|\t\t}\n138|\t}\n139|\tif matches != 1 {\n140|\t\tt.Fatalf(\"Section 7.5 row holds %d success cells naming %q, want exactly one; the check is blind\", matches, marker)\n141|\t}\n142|\tinner := cell\n143|\tif !strings.HasPrefix(inner, \"{\") || !strings.HasSuffix(inner, \"}\") {\n144|\t\tt.Fatalf(\"Section 7.5 cell %q is not a braced object; the check is blind\", cell)\n145|\t}\n146|\tinner = inner[1 : len(inner)-1]\n147|\tvar members []string\n148|\tdepth := 0\n149|\tfield := \"\"\n150|\tflush := func() {\n151|\t\tname := field\n152|\t\tif end := strings.Index(name, \":\"); end >= 0 {\n153|\t\t\tname = name[:end]\n154|\t\t}\n155|\t\tname = strings.TrimSpace(name)\n156|\t\tif name == \"\" {\n157|\t\t\tt.Fatalf(\"Section 7.5 cell %q parses to an empty member; the check is blind\", cell)\n158|\t\t}\n159|\t\tmembers = append(members, name)\n160|\t\tfield = \"\"\n161|\t}\n162|\tfor _, char := range inner {\n163|\t\tswitch char {\n164|\t\tcase '(', '[':\n165|\t\t\tdepth++\n166|\t\t\tfield += string(char)\n167|\t\tcase ')', ']':\n168|\t\t\tdepth--\n169|\t\t\tfield += string(char)\n170|\t\tcase ',':\n171|\t\t\tif depth == 0 {\n172|\t\t\t\tflush()\n173|\t\t\t\tcontinue\n174|\t\t\t}\n175|\t\t\tfield += string(char)\n176|\t\tdefault:\n177|\t\t\tfield += string(char)\n178|\t\t}\n179|\t}\n180|\tflush()\n181|\tif len(members) == 0 {\n182|\t\tt.Fatalf(\"Section 7.5 cell %q parses to no members; the check is blind\", cell)\n183|\t}\n184|\treturn members\n185|}\n186|\n187|// TestManifestMembersAreDerivedFromSpec proves the exact manifest\n188|// member set equals the Section 7.3 example keys: a widened\n189|// implementation admitting \"bogus\" reddens here.\n190|func TestManifestMembersAreDerivedFromSpec(t *testing.T) {\n191|\tdocument, err := specdoc.Load()\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n194|\t}\n195|\twindow := sectionLines(t, document, \"7.3\", 2751, 2785)\n196|\trequireQuote(t, document, \"The manifest is closed and every displayed member is required\", \"7.3\")\n197|\tvar got []string\n198|\tfor member := range manifestMembers {\n199|\t\tgot = append(got, member)\n200|\t}\n201|\trequireMemberSet(t, \"manifestMembers\", got, exampleObjectKeysOf(t, window))\n202|}\n203|\n204|// TestProbeMembersAreDerivedFromSpec proves the exact probe member\n205|// set equals the Section 7.4 example keys: a widened implementation\n206|// admitting \"bogus\" reddens here.\n207|func TestProbeMembersAreDerivedFromSpec(t *testing.T) {\n208|\tdocument, err := specdoc.Load()\n209|\tif err != nil {\n210|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n211|\t}\n212|\twindow := sectionLines(t, document, \"7.4\", 2805, 2857)\n213|\trequireQuote(t, document, \"The probe object is closed and every displayed member is required\", \"7.4\")\n214|\tvar got []string\n215|\tfor member := range probeMembers {\n216|\t\tgot = append(got, member)\n217|\t}\n218|\trequireMemberSet(t, \"probeMembers\", got, exampleObjectKeysOf(t, window))\n219|}\n220|\n221|// TestProbeCapabilityMembersAreDerivedFromSpec proves the exact\n222|// capability-value member set equals the Section 7.4 sentence: a\n223|// widened implementation admitting \"bogus\" reddens here.\n224|func TestProbeCapabilityMembersAreDerivedFromSpec(t *testing.T) {\n225|\tdocument, err := specdoc.Load()\n226|\tif err != nil {\n227|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n228|\t}\n229|\twindow := sectionLines(t, document, \"7.4\", 2864, 2866)\n230|\trequireQuote(t, document, \"Each capability value contains exactly\", \"7.4\")\n231|\t// Only the declaring sentence counts: the next sentence opens\n232|\t// with the warnings member, which belongs to the probe object\n233|\t// rather than to one capability value.\n234|\tsentence := window\n235|\tif end := strings.Index(sentence, \".\"); end >= 0 {\n236|\t\tsentence = sentence[:end+1]\n237|\t}\n238|\tvar got []string\n239|\tfor member := range probeCapabilityMembers {\n240|\t\tgot = append(got, member)\n241|\t}\n242|\trequireMemberSet(t, \"probeCapabilityMembers\", got, codeSpansOf(t, sentence))\n243|}\n244|\n245|// TestIdentityMembersAreDerivedFromSpec proves the exact identity\n246|// member set equals the Section 5.5 table: a widened implementation\n247|// admitting \"bogus\" reddens here. The rows are read through the\n248|// document's own table index, so a window that drifts off the table\n249|// lands on lines no table row declares and fails closed.\n250|func TestIdentityMembersAreDerivedFromSpec(t *testing.T) {\n251|\tdocument, err := specdoc.Load()\n252|\tif err != nil {\n253|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n254|\t}\n255|\twindow := sectionLines(t, document, \"5.5\", 2077, 2092)\n256|\t// The bare closed sentence repeats across sections, so the\n257|\t// quote carries its schema opener: only the 5.5 table it\n258|\t// introduces can satisfy it.\n259|\trequireQuote(t, document, \"The Provider Identity Record schema is <code>urn:ax:schema:provider-identity</code> version <code>1.0.0</code>. Its top-level object is closed and contains exactly:\", \"5.5\")\n260|\t_ = window\n261|\tvar want []string\n262|\tfor line := 2077; line <= 2092; line++ {\n263|\t\trow, ok := document.TableRowAt(line)\n264|\t\tif !ok {\n265|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n266|\t\t}\n267|\t\tif row.Header != \"Field\" {\n268|\t\t\tt.Fatalf(\"SPEC.md line %d declares %q, want a Field row; the check is blind\", line, row.Header)\n269|\t\t}\n270|\t\tif row.Identifier == \"\" {\n271|\t\t\tt.Fatalf(\"SPEC.md line %d declares an empty member; the check is blind\", line)\n272|\t\t}\n273|\t\twant = append(want, row.Identifier)\n274|\t}\n275|\tvar got []string\n276|\tfor member := range identityMembers {\n277|\t\tgot = append(got, member)\n278|\t}\n279|\trequireMemberSet(t, \"identityMembers\", got, want)\n280|}\n281|\n282|// TestIdentifyMembersAreDerivedFromSpec proves the exact\n283|// identify-session success member set equals the Section 7.5 row: a\n284|// widened implementation admitting \"bogus\" reddens here.\n285|func TestIdentifyMembersAreDerivedFromSpec(t *testing.T) {\n286|\tdocument, err := specdoc.Load()\n287|\tif err != nil {\n288|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n289|\t}\n290|\trow := sectionLines(t, document, \"7.5\", 3075, 3075)\n291|\tvar got []string\n292|\tfor member := range identifyMembers {\n293|\t\tgot = append(got, member)\n294|\t}\n295|\trequireMemberSet(t, \"identifyMembers\", got, objectCellMembersOf(t, row, \"matched_evidence\"))\n296|}\n297|\n298|// TestQuiesceMembersAreDerivedFromSpec proves the exact\n299|// SafeBoundaryProof member set equals the Section 7.5 type row: a\n300|// widened implementation admitting \"bogus\" reddens here.\n301|func TestQuiesceMembersAreDerivedFromSpec(t *testing.T) {\n302|\tdocument, err := specdoc.Load()\n303|\tif err != nil {\n304|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n305|\t}\n306|\trow := sectionLines(t, document, \"7.5\", 2891, 2891)\n307|\tvar got []string\n308|\tfor member := range quiesceMembers {\n309|\t\tgot = append(got, member)\n310|\t}\n311|\trequireMemberSet(t, \"quiesceMembers\", got, typeRowMembersOf(t, row, \"SafeBoundaryProof\"))\n312|}\n313|\n314|// TestSpawnMembersAreDerivedFromSpec proves the exact SpawnPlan\n315|// member set equals the Section 7.5 type row: a widened\n316|// implementation admitting \"bogus\" reddens here.\n317|func TestSpawnMembersAreDerivedFromSpec(t *testing.T) {\n318|\tdocument, err := specdoc.Load()\n319|\tif err != nil {\n320|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n321|\t}\n322|\trow := sectionLines(t, document, \"7.5\", 2890, 2890)\n323|\tvar got []string\n324|\tfor member := range spawnMembers {\n325|\t\tgot = append(got, member)\n326|\t}\n327|\trequireMemberSet(t, \"spawnMembers\", got, typeRowMembersOf(t, row, \"SpawnPlan\"))\n328|}\n329|\n330|// TestStatusBodyMembersAreDerivedFromSpec proves the exact status\n331|// member set equals the Section 7.5 ProviderTransactionStatus row: a\n332|// widened implementation admitting \"bogus\" reddens here.\n333|func TestStatusBodyMembersAreDerivedFromSpec(t *testing.T) {\n334|\tdocument, err := specdoc.Load()\n335|\tif err != nil {\n336|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n337|\t}\n338|\trow := sectionLines(t, document, \"7.5\", 2905, 2905)\n339|\tvar got []string\n340|\tfor member := range statusBodyMembers {\n341|\t\tgot = append(got, member)\n342|\t}\n343|\trequireMemberSet(t, \"statusBodyMembers\", got, typeRowMembersOf(t, row, \"ProviderTransactionStatus\"))\n344|}\n345|\n346|// TestProfileYOLOMappingIsDerivedFromSpec proves the yolo mapping\n347|// holds exactly the six Section 7.7 provider rows with the row's own\n348|// flag: a seventh provider entry returns its flag instead of\n349|// invalid_config and reddens here. The Pi row carries no flag, only\n350|// the reported tool-set name, so a span holding a quoted value\n351|// resolves to the value inside the quotes.\n352|func TestProfileYOLOMappingIsDerivedFromSpec(t *testing.T) {\n353|\tdocument, err := specdoc.Load()\n354|\tif err != nil {\n355|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n356|\t}\n357|\twindow := sectionLines(t, document, \"7.7\", 3431, 3436)\n358|\trequireQuote(t, document, \"The v0.3.0 <code>yolo</code> mappings are:\", \"7.7\")\n359|\t_ = window\n360|\tderived := map[string]string{}\n361|\tvar providers []string\n362|\tfor line := 3431; line <= 3436; line++ {\n363|\t\ttext, ok := document.Line(line)\n364|\t\tif !ok {\n365|\t\t\tt.Fatalf(\"SPEC.md line %d is missing; the check is blind\", line)\n366|\t\t}\n367|\t\trow, ok := document.TableRowAt(line)\n368|\t\tif !ok {\n369|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n370|\t\t}\n371|\t\tif row.Header != \"Provider\" {\n372|\t\t\tt.Fatalf(\"SPEC.md line %d declares %q, want a Provider row; the check is blind\", line, row.Header)\n373|\t\t}\n374|\t\tfields := strings.Fields(row.FirstCell)\n375|\t\tif len(fields) == 0 {\n376|\t\t\tt.Fatalf(\"SPEC.md line %d names no provider; the check is blind\", line)\n377|\t\t}\n378|\t\tprovider := strings.ToLower(fields[0])\n379|\t\tspans := codeSpanPattern.FindAllStringSubmatch(text, -1)\n380|\t\tif len(spans) == 0 {\n381|\t\t\tt.Fatalf(\"SPEC.md line %d holds no code elements; the check is blind\", line)\n382|\t\t}\n383|\t\tflag := spans[0][1]\n384|\t\tif first, last := strings.Index(flag, `\"`), strings.LastIndex(flag, `\"`); first >= 0 && last > first {\n385|\t\t\tflag = flag[first+1 : last]\n386|\t\t}\n387|\t\tif flag == \"\" {\n388|\t\t\tt.Fatalf(\"SPEC.md line %d resolves to an empty mapping; the check is blind\", line)\n389|\t\t}\n390|\t\tif _, repeated := derived[provider]; repeated {\n391|\t\t\tt.Fatalf(\"SPEC.md names provider %q twice; the check is blind\", provider)\n392|\t\t}\n393|\t\tderived[provider] = flag\n394|\t\tproviders = append(providers, provider)\n395|\t}\n396|\tif len(derived) == 0 {\n397|\t\tt.Fatal(\"derived no provider mappings from the Section 7.7 table; the check is blind\")\n398|\t}\n399|\tif !reflect.DeepEqual(derived, profileYOLOMapping) {\n400|\t\tt.Fatalf(\"profileYOLOMapping = %v, want the Section 7.7 table %v\", profileYOLOMapping, derived)\n401|\t}\n402|\tsorted := append([]string(nil), providers...)\n403|\tsort.Strings(sorted)\n404|\tregistered := append([]string(nil), profileProviders...)\n405|\tsort.Strings(registered)\n406|\tif !reflect.DeepEqual(sorted, registered) {\n407|\t\tt.Fatalf(\"Section 7.7 providers = %v, want the registry %v\", sorted, registered)\n408|\t}\n409|\tt.Logf(\"profile mapping coverage: %d/%d providers derived\", len(derived), len(providers))\n410|}\n411|\n412|// deriveMembershipVocabularies parses production source for every\n413|// package-level []string, map[string]bool, and map[string]string\n414|// consulted by a membership check. An empty scan fails closed: a\n415|// domain that silently derives nothing is not a measurement.\n416|func deriveMembershipVocabularies(t *testing.T) map[string]struct{} {\n417|\tt.Helper()\n418|\tdirectory, err := os.Getwd()\n419|\tif err != nil {\n420|\t\tt.Fatalf(\"derive membership vocabularies: %v\", err)\n421|\t}\n422|\tvocabularies, scanned, err := membershipVocabulariesIn(directory)\n423|\tif err != nil {\n424|\t\tt.Fatalf(\"derive membership vocabularies: %v\", err)\n425|\t}\n426|\tif len(scanned) == 0 {\n427|\t\tt.Fatal(\"derived membership vocabularies from zero production files; the scanner is broken, not the package\")\n428|\t}\n429|\tif len(vocabularies) == 0 {\n430|\t\tt.Fatal(\"derived zero membership vocabularies from the package sources; the scanner is broken, not the package\")\n431|\t}\n432|\tt.Logf(\"membership vocabulary domain: %d derived vocabularies across %d production files\", len(vocabularies), len(scanned))\n433|\treturn vocabularies\n434|}\n435|\n436|// membershipVocabulariesIn collects the package-level vocabularies of\n437|// the three membership shapes and keeps those with membership use:\n438|// an unknownMember argument, a direct map index, or a range operand.\n439|// A variable whose only production uses are missingMember arguments\n440|// is a refusal-order list, not a containment vocabulary, and is\n441|// excluded by design.\n442|func membershipVocabulariesIn(directory string) (map[string]struct{}, []string, error) {\n443|\tentries, err := os.ReadDir(directory)\n444|\tif err != nil {\n445|\t\treturn nil, nil, err\n446|\t}\n447|\tfileSet := token.NewFileSet()\n448|\ttype productionFile struct {\n449|\t\tsyntax *ast.File\n450|\t}\n451|\tvar files []productionFile\n452|\tvar scanned []string\n453|\tshapes := map[string]bool{}\n454|\tfor _, entry := range entries {\n455|\t\tname := entry.Name()\n456|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n457|\t\t\tcontinue\n458|\t\t}\n459|\t\tscanned = append(scanned, name)\n460|\t\tpath := filepath.Join(directory, name)\n461|\t\tsource, err := os.ReadFile(path)\n462|\t\tif err != nil {\n463|\t\t\treturn nil, nil, err\n464|\t\t}\n465|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n466|\t\tif err != nil {\n467|\t\t\treturn nil, nil, err\n468|\t\t}\n469|\t\tfiles = append(files, productionFile{syntax: syntax})\n470|\t\tfor _, decl := range syntax.Decls {\n471|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n472|\t\t\tif !ok || general.Tok != token.VAR {\n473|\t\t\t\tcontinue\n474|\t\t\t}\n475|\t\t\tfor _, spec := range general.Specs {\n476|\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n477|\t\t\t\tif !ok {\n478|\t\t\t\t\tcontinue\n479|\t\t\t\t}\n480|\t\t\t\tshape := valueShape(value)\n481|\t\t\t\tif shape == \"\" {\n482|\t\t\t\t\tcontinue\n483|\t\t\t\t}\n484|\t\t\t\tfor _, name := range value.Names {\n485|\t\t\t\t\tshapes[name.Name] = true\n486|\t\t\t\t}\n487|\t\t\t}\n488|\t\t}\n489|\t}\n490|\tunknownUsed := map[string]bool{}\n491|\tindexed := map[string]bool{}\n492|\tranged := map[string]bool{}\n493|\tfor _, file := range files {\n494|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n495|\t\t\tcall, ok := node.(*ast.CallExpr)\n496|\t\t\tif !ok {\n497|\t\t\t\treturn true\n498|\t\t\t}\n499|\t\t\tident, ok := call.Fun.(*ast.Ident)\n500|\t\t\tif !ok || ident.Name != \"unknownMember\" {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"call_id":"call_01a0703a5e937c408244ce17381efb66","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/spawn.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the SpawnPlan a launch or resume operation\n11|// returns as its success body (Section 7.5 rows). The trusted\n12|// terminal backend performs process creation from this plan, so the\n13|// plan MUST NOT carry secret environment values, and its\n14|// profile_mapping MUST equal the Section 7.7 mapping for the calling\n15|// provider and profile. Literal secrecy is structural, not\n16|// content-admitted: values are bounded and disjoint from inherited\n17|// names, and the host never logs bodies; no content inspection could\n18|// prove a literal non-secret, so none is attempted.\n19|\n20|// spawnMembers is the exact required member set of a SpawnPlan.\n21|var spawnMembers = map[string]bool{\n22|\t\"argv\":              true,\n23|\t\"cwd\":               true,\n24|\t\"env_names\":         true,\n25|\t\"env_literals\":      true,\n26|\t\"native_session_id\": true,\n27|\t\"profile_mapping\":   true,\n28|\t\"extensions\":        true,\n29|}\n30|\n31|// spawnRequired lists spawnMembers in a fixed order so a plan missing\n32|// several members always names the same one.\n33|var spawnRequired = []string{\n34|\t\"argv\",\n35|\t\"cwd\",\n36|\t\"env_names\",\n37|\t\"env_literals\",\n38|\t\"native_session_id\",\n39|\t\"profile_mapping\",\n40|\t\"extensions\",\n41|}\n42|\n43|// maxSpawnArgvBytes bounds the total encoded argv Section 5.1 states.\n44|const maxSpawnArgvBytes = 65536\n45|\n46|// DecodeSpawnPlan validates one launch- or resume-operation success\n47|// body as a SpawnPlan for the calling provider under the calling\n48|// profile on the destination platform. It returns nil on a\n49|// well-formed plan and a refusal naming the offending member\n50|// otherwise: a provider_protocol_error for a malformed plan, and an\n51|// invalid_config caller error when the caller names an unknown\n52|// provider or profile for the mapping check.\n53|func DecodeSpawnPlan(body []byte, providerID, profile string, platform scalar.Platform) error {\n54|\tmembers, fault := decodeStrictObject(body)\n55|\tif fault != nil {\n56|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n57|\t\tif err != nil {\n58|\t\t\treturn err\n59|\t\t}\n60|\t\treturn failure\n61|\t}\n62|\tif name, unknown := unknownMember(members, spawnMembers); unknown {\n63|\t\tfailure, err := failProtocol(\"spawn plan carries unknown member\", name)\n64|\t\tif err != nil {\n65|\t\t\treturn err\n66|\t\t}\n67|\t\treturn failure\n68|\t}\n69|\tif name, missing := missingMember(members, spawnRequired); missing {\n70|\t\tfailure, err := failProtocol(\"spawn plan misses a required member\", name)\n71|\t\tif err != nil {\n72|\t\t\treturn err\n73|\t\t}\n74|\t\treturn failure\n75|\t}\n76|\tif err := checkSpawnArgv(members[\"argv\"]); err != nil {\n77|\t\treturn err\n78|\t}\n79|\tif cwd, ok := rawString(members[\"cwd\"]); !ok || !isAbsoluteOn(cwd, platform) {\n80|\t\tfailure, err := failProtocol(\"spawn cwd is not an absolute path\", \"cwd\")\n81|\t\tif err != nil {\n82|\t\t\treturn err\n83|\t\t}\n84|\t\treturn failure\n85|\t}\n86|\tnames, err := checkSpawnEnvNames(members[\"env_names\"])\n87|\tif err != nil {\n88|\t\treturn err\n89|\t}\n90|\tif err := checkSpawnEnvLiterals(members[\"env_literals\"], names); err != nil {\n91|\t\treturn err\n92|\t}\n93|\tif _, isNull, ok := rawNullableString(members[\"native_session_id\"]); !ok || (!isNull && !isBoundedString(members[\"native_session_id\"], 1, 512)) {\n94|\t\tfailure, err := failProtocol(\"spawn native_session_id is not 1..512 characters or null\", \"native_session_id\")\n95|\t\tif err != nil {\n96|\t\t\treturn err\n97|\t\t}\n98|\t\treturn failure\n99|\t}\n100|\tif err := checkSpawnProfileMapping(members[\"profile_mapping\"], providerID, profile); err != nil {\n101|\t\treturn err\n102|\t}\n103|\tif !isJSONObject(members[\"extensions\"]) {\n104|\t\tfailure, err := failProtocol(\"spawn extensions is not an object\", \"extensions\")\n105|\t\tif err != nil {\n106|\t\t\treturn err\n107|\t\t}\n108|\t\treturn failure\n109|\t}\n110|\treturn nil\n111|}\n112|\n113|// isAbsoluteOn reports whether the path is absolute on the\n114|// destination platform. Destination-native is the Section 7.5 rule;\n115|// the platform arrives from the caller because the plan carries none.\n116|func isAbsoluteOn(path string, platform scalar.Platform) bool {\n117|\t_, err := scalar.ParseAbsolutePath(platform, path)\n118|\treturn err == nil\n119|}\n120|\n121|// isBoundedString reports whether the raw JSON string counts 1..max\n122|// Unicode characters. The caller already established it is a string.\n123|func isBoundedString(raw json.RawMessage, min, max int) bool {\n124|\tvalue, ok := rawString(raw)\n125|\tif !ok {\n126|\t\treturn false\n127|\t}\n128|\tlength := runeLength(value)\n129|\treturn length >= min && length <= max\n130|}\n131|\n132|// checkSpawnArgv enforces the Section 5.1 argv limits: 1..128\n133|// elements, each a NUL-free string of 1..4,096 bytes, 65,536 bytes\n134|// total. Byte length is the exec-bound quantity, so elements count\n135|// bytes here while the character-bounded members count runes.\n136|func checkSpawnArgv(raw json.RawMessage) error {\n137|\telements, ok := rawArray(raw)\n138|\tif !ok || len(elements) == 0 || len(elements) > 128 {\n139|\t\tfailure, err := failProtocol(\"spawn argv is empty or longer than 128\", \"argv\")\n140|\t\tif err != nil {\n141|\t\t\treturn err\n142|\t\t}\n143|\t\treturn failure\n144|\t}\n145|\ttotal := 0\n146|\tfor _, element := range elements {\n147|\t\tvalue, ok := rawString(element)\n148|\t\tif !ok || len(value) < 1 || len(value) > 4096 || strings.ContainsRune(value, 0) {\n149|\t\t\tfailure, err := failProtocol(\"spawn argv element is not 1..4096 NUL-free bytes\", \"argv\")\n150|\t\t\tif err != nil {\n151|\t\t\t\treturn err\n152|\t\t\t}\n153|\t\t\treturn failure\n154|\t\t}\n155|\t\ttotal += len(value)\n156|\t}\n157|\tif total > maxSpawnArgvBytes {\n158|\t\tfailure, err := failProtocol(\"spawn argv exceeds 65536 bytes total\", \"argv\")\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\treturn failure\n163|\t}\n164|\treturn nil\n165|}\n166|\n167|// validEnvName reports whether the name satisfies the Section 5.1\n168|// environment-name grammar: [A-Za-z_][A-Za-z0-9_]{0,127}.\n169|func validEnvName(name string) bool {\n170|\tif len(name) < 1 || len(name) > 128 {\n171|\t\treturn false\n172|\t}\n173|\tfor index := 0; index < len(name); index++ {\n174|\t\tchar := name[index]\n175|\t\tvalid := char == '_' || char >= 'A' && char <= 'Z' || char >= 'a' && char <= 'z' || index > 0 && char >= '0' && char <= '9'\n176|\t\tif !valid {\n177|\t\t\treturn false\n178|\t\t}\n179|\t}\n180|\treturn true\n181|}\n182|\n183|// checkSpawnEnvNames enforces sorted unique environment names\n184|// [0..64] and returns them for the disjointness check.\n185|func checkSpawnEnvNames(raw json.RawMessage) ([]string, error) {\n186|\tnames, ok := rawStringArray(raw)\n187|\tif !ok || len(names) > 64 {\n188|\t\tfailure, err := failProtocol(\"spawn env_names exceed 64 entries\", \"env_names\")\n189|\t\tif err != nil {\n190|\t\t\treturn nil, err\n191|\t\t}\n192|\t\treturn nil, failure\n193|\t}\n194|\tfor _, name := range names {\n195|\t\tif !validEnvName(name) {\n196|\t\t\tfailure, err := failProtocol(\"spawn env_names are not environment names\", \"env_names\")\n197|\t\t\tif err != nil {\n198|\t\t\t\treturn nil, err\n199|\t\t\t}\n200|\t\t\treturn nil, failure\n201|\t\t}\n202|\t}\n203|\tif !sortedUniqueStrings(names) {\n204|\t\tfailure, err := failProtocol(\"spawn env_names are not sorted unique\", \"env_names\")\n205|\t\tif err != nil {\n206|\t\t\treturn nil, err\n207|\t\t}\n208|\t\treturn nil, failure\n209|\t}\n210|\treturn names, nil\n211|}\n212|\n213|// checkSpawnEnvLiterals enforces the literal map: at most 64\n214|// entries, environment-name keys disjoint from env_names, string\n215|// values of at most 4,096 bytes. Keys sort in canonical form on the\n216|// wire; the host reads the set, so order is not rechecked here.\n217|func checkSpawnEnvLiterals(raw json.RawMessage, names []string) error {\n218|\tliterals, fault := decodeStrictObject(raw)\n219|\tif fault != nil {\n220|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\treturn failure\n225|\t}\n226|\tif len(literals) > 64 {\n227|\t\tfailure, err := failProtocol(\"spawn env_literals exceed 64 entries\", \"env_literals\")\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\tinherited := map[string]bool{}\n234|\tfor _, name := range names {\n235|\t\tinherited[name] = true\n236|\t}\n237|\tfor key, value := range literals {\n238|\t\tif !validEnvName(key) || inherited[key] {\n239|\t\t\tfailure, err := failProtocol(\"spawn env_literal key is not disjoint\", \"env_literals\")\n240|\t\t\tif err != nil {\n241|\t\t\t\treturn err\n242|\t\t\t}\n243|\t\t\treturn failure\n244|\t\t}\n245|\t\ttext, ok := rawString(value)\n246|\t\tif !ok || len(text) > 4096 || strings.ContainsRune(text, 0) {\n247|\t\t\tfailure, err := failProtocol(\"spawn env_literal is not at most 4096 NUL-free bytes\", \"env_literals\")\n248|\t\t\tif err != nil {\n249|\t\t\t\treturn err\n250|\t\t\t}\n251|\t\t\treturn failure\n252|\t\t}\n253|\t}\n254|\treturn nil\n255|}\n256|\n257|// checkSpawnProfileMapping requires profile_mapping to equal the\n258|// Section 7.7 mapping for the calling provider and profile. A\n259|// provider that answers yolo with the standard omission, or standard\n260|// with a yolo flag, fails here rather than executing under the wrong\n261|// sandbox. Unknown providers and profiles are caller errors that\n262|// propagate from the mapping table.\n263|func checkSpawnProfileMapping(raw json.RawMessage, providerID, profile string) error {\n264|\tmapping, ok := rawString(raw)\n265|\tif !ok || runeLength(mapping) > 512 {\n266|\t\tfailure, err := failProtocol(\"spawn profile_mapping is not at most 512 characters\", \"profile_mapping\")\n267|\t\tif err != nil {\n268|\t\t\treturn err\n269|\t\t}\n270|\t\treturn failure\n271|\t}\n272|\twant, err := ProfileMapping(providerID, profile)\n273|\tif err != nil {\n274|\t\treturn err\n275|\t}\n276|\tif mapping != want {\n277|\t\tfailure, fault := failProtocol(\"spawn profile_mapping does not match the provider profile\", \"profile_mapping\")\n278|\t\tif fault != nil {\n279|\t\t\treturn fault\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\treturn nil\n284|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
