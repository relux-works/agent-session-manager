536|\t}\n537|\tsort.Strings(scanned)\n538|\treturn vocabularies, scanned, nil\n539|}\n540|\n541|// valueShape reports whether a package-level variable declaration is\n542|// one of the three membership-vocabulary shapes: a []string, a\n543|// map[string]bool, or a map[string]string. Anything else reports \"\".\n544|func valueShape(value *ast.ValueSpec) string {\n545|\tcandidate := value.Type\n546|\tif candidate == nil && len(value.Values) == 1 {\n547|\t\tif literal, ok := value.Values[0].(*ast.CompositeLit); ok {\n548|\t\t\tcandidate = literal.Type\n549|\t\t}\n550|\t}\n551|\tswitch shape := candidate.(type) {\n552|\tcase *ast.ArrayType:\n553|\t\tif shape.Len != nil {\n554|\t\t\treturn \"\"\n555|\t\t}\n556|\t\tif ident, ok := shape.Elt.(*ast.Ident); ok && ident.Name == \"string\" {\n557|\t\t\treturn \"slice\"\n558|\t\t}\n559|\tcase *ast.MapType:\n560|\t\tkey, ok := shape.Key.(*ast.Ident)\n561|\t\tif !ok || key.Name != \"string\" {\n562|\t\t\treturn \"\"\n563|\t\t}\n564|\t\tif ident, ok := shape.Value.(*ast.Ident); ok && (ident.Name == \"bool\" || ident.Name == \"string\") {\n565|\t\t\treturn \"map\"\n566|\t\t}\n567|\t}\n568|\treturn \"\"\n569|}\n570|\n571|// vocabularyDerivation ties one derived membership vocabulary to the\n572|// test that proves it against the pinned document. The prove\n573|// function executes the real spec read: a registration pointing at\n574|// nothing that checks the vocabulary would pass vacuously.\n575|type vocabularyDerivation struct {\n576|\tname  string\n577|\tprove func(*testing.T)\n578|}\n579|\n580|// registeredVocabularyDerivations lists every membership vocabulary\n581|// the census may find, each with the derivation that pins it. The\n582|// eight enum and two registry entries reuse their covering tests\n583|// with no restatement; the nine member-set and mapping entries are\n584|// proven above.\n585|func registeredVocabularyDerivations() []vocabularyDerivation {\n586|\treturn []vocabularyDerivation{\n587|\t\t{name: \"probeCapabilityStatuses\", prove: TestProbeStatusVocabularyIsDerivedFromSpec},\n588|\t\t{name: \"probeCapabilityEvidence\", prove: TestProbeEvidenceVocabularyIsDerivedFromSpec},\n589|\t\t{name: \"probeArchitectures\", prove: TestProbeArchitecturesAreDerivedFromSpec},\n590|\t\t{name: \"probePlatforms\", prove: TestProbePlatformsAreDerivedFromSpec},\n591|\t\t{name: \"quiesceBlockers\", prove: TestQuiesceBlockersAreDerivedFromSpec},\n592|\t\t{name: \"identityKinds\", prove: TestIdentityKindsAreDerivedFromSpec},\n593|\t\t{name: \"identifyConfidences\", prove: TestIdentifyVocabulariesAreDerivedFromSpec},\n594|\t\t{name: \"identifyEvidence\", prove: TestIdentifyVocabulariesAreDerivedFromSpec},\n595|\t\t{name: \"capabilityOrder\", prove: TestManifestRegistriesAreDerivedFromSpec},\n596|\t\t{name: \"manifestPlatforms\", prove: TestManifestRegistriesAreDerivedFromSpec},\n597|\t\t{name: \"manifestMembers\", prove: TestManifestMembersAreDerivedFromSpec},\n598|\t\t{name: \"probeMembers\", prove: TestProbeMembersAreDerivedFromSpec},\n599|\t\t{name: \"probeCapabilityMembers\", prove: TestProbeCapabilityMembersAreDerivedFromSpec},\n600|\t\t{name: \"identityMembers\", prove: TestIdentityMembersAreDerivedFromSpec},\n601|\t\t{name: \"identifyMembers\", prove: TestIdentifyMembersAreDerivedFromSpec},\n602|\t\t{name: \"quiesceMembers\", prove: TestQuiesceMembersAreDerivedFromSpec},\n603|\t\t{name: \"spawnMembers\", prove: TestSpawnMembersAreDerivedFromSpec},\n604|\t\t{name: \"statusBodyMembers\", prove: TestStatusBodyMembersAreDerivedFromSpec},\n605|\t\t{name: \"profileYOLOMapping\", prove: TestProfileYOLOMappingIsDerivedFromSpec},\n606|\t}\n607|}\n608|\n609|// TestClosedVocabularyCensusCoversEveryMembershipVocabulary checks\n610|// both directions of the census: every derived vocabulary carries a\n611|// registered spec derivation, and every registered derivation names\n612|// a derived vocabulary, so a truncated scan reddens on the orphaned\n613|// registrations instead of passing vacuously. Each derivation then\n614|// executes: the census proves containment, not reachability.\n615|func TestClosedVocabularyCensusCoversEveryMembershipVocabulary(t *testing.T) {\n616|\tfound := deriveMembershipVocabularies(t)\n617|\tregistered := registeredVocabularyDerivations()\n618|\tif len(registered) == 0 {\n619|\t\tt.Fatal(\"registered no vocabulary derivations; the census is blind, not the package\")\n620|\t}\n621|\tbyName := map[string]func(*testing.T){}\n622|\tfor _, entry := range registered {\n623|\t\tif _, repeated := byName[entry.name]; repeated {\n624|\t\t\tt.Fatalf(\"vocabulary %q carries two registered derivations; the census is ambiguous\", entry.name)\n625|\t\t}\n626|\t\tbyName[entry.name] = entry.prove\n627|\t}\n628|\tfor name := range found {\n629|\t\tif _, ok := byName[name]; !ok {\n630|\t\t\tt.Fatalf(\"membership vocabulary %q has no registered spec derivation; widening it passes silently\", name)\n631|\t\t}\n632|\t}\n633|\tfor _, entry := range registered {\n634|\t\tif _, ok := found[entry.name]; !ok {\n635|\t\t\tt.Fatalf(\"registered derivation %q names no production vocabulary; the census is short\", entry.name)\n636|\t\t}\n637|\t}\n638|\tfor _, entry := range registered {\n639|\t\tt.Run(entry.name, entry.prove)\n640|\t}\n641|\tt.Logf(\"vocabulary census coverage: %d/%d vocabularies derived\", len(found), len(registered))\n642|}\n643|\n644|// TestClosedMemberSetsRefuseExtraMembers drives one extra \"bogus\"\n645|// member per closed object through its production entry point: each\n646|// is refused under its own arm, so a member set that admits one more\n647|// value reddens here as well as in its derivation test. The\n648|// production call site is named in every row.\n649|func TestClosedMemberSetsRefuseExtraMembers(t *testing.T) {\n650|\tt.Run(\"manifest carries bogus\", func(t *testing.T) {\n651|\t\tbody := manifestVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n652|\t\trequireFrameRefusal(t, DecodeManifest(body), \"bogus\", \"unknown member\")\n653|\t})\n654|\tt.Run(\"probe carries bogus\", func(t *testing.T) {\n655|\t\tbody := probeVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n656|\t\trequireFrameRefusal(t, DecodeProbe(body), \"bogus\", \"unknown member\")\n657|\t})\n658|\tt.Run(\"probe capability carries bogus\", func(t *testing.T) {\n659|\t\tbody := probeVariant(t, \"\\\"status\\\": \\\"available\\\",\\n      \\\"enabled\\\": true,\", \"\\\"status\\\": \\\"available\\\",\\n      \\\"bogus\\\": 1,\\n      \\\"enabled\\\": true,\")\n660|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"unknown member\")\n661|\t})\n662|\tt.Run(\"identity carries bogus\", func(t *testing.T) {\n663|\t\tbody := identityVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n664|\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"bogus\", \"unknown member\")\n665|\t})\n666|\tt.Run(\"identify result carries bogus\", func(t *testing.T) {\n667|\t\tbody := identifyResultVariant(t, `\"confidence\": \"exact\"`, \"\\\"bogus\\\": 1,\\n  \\\"confidence\\\": \\\"exact\\\"\")\n668|\t\trequireFrameRefusal(t, DecodeIdentifyResult(body, \"antigravity\"), \"bogus\", \"unknown member\")\n669|\t})\n670|\tt.Run(\"quiesce proof carries bogus\", func(t *testing.T) {\n671|\t\tbody := quiesceVariant(t, `\"provider_id\": \"codex\",`, \"\\\"provider_id\\\": \\\"codex\\\",\\n  \\\"bogus\\\": 1,\")\n672|\t\trequireFrameRefusal(t, quiesceErr(body), \"bogus\", \"unknown member\")\n673|\t})\n674|\tt.Run(\"spawn plan carries bogus\", func(t *testing.T) {\n675|\t\tbody := spawnVariant(t, `\"cwd\":`, \"\\\"bogus\\\": 1,\\n  \\\"cwd\\\":\")\n676|\t\trequireFrameRefusal(t, DecodeSpawnPlan(body, \"codex\", ProfileYOLO, scalar.PlatformLinux), \"bogus\", \"unknown member\")\n677|\t})\n678|\tt.Run(\"status body carries bogus\", func(t *testing.T) {\n679|\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n680|\t\textra := []byte(strings.Replace(string(body), \"{\\\"materialization_id\\\":\", \"{\\\"bogus\\\":1,\\\"materialization_id\\\":\", 1))\n681|\t\t_, err := DecodeStatusOutcome(extra, testStatusIDs())\n682|\t\trequireLocalRefusal(t, err, \"integrity_failure\", \"unknown member\")\n683|\t})\n684|\tt.Run(\"profile mapping names bogus\", func(t *testing.T) {\n685|\t\t_, err := ProfileMapping(\"bogus\", ProfileYOLO)\n686|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown provider\")\n687|\t})\n688|}"}}}
