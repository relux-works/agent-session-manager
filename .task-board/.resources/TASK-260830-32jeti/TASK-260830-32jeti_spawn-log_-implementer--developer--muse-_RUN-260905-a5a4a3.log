{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a1","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":427,"recorded_at":1780531400000849,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"task_stream":{"kind":"task","id":"f9cf7abf-853f-4a97-98df-05f9f36ddad5"},"task_id":"f9cf7abf-853f-4a97-98df-05f9f36ddad5","event":{"kind":"output","task_id":"f9cf7abf-853f-4a97-98df-05f9f36ddad5","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/closed_vocabularies_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n11|)\n12|\n13|// This file proves the eight closed vocabularies the manifest,\n14|// keyed-operation, and profile-table derivations do not cover are\n15|// exactly the Section 5.5, 7.4, and 7.5 enums: every list below is\n16|// re-read from the pinned document, never from a hand transcription,\n17|// so a provider value the contract never defined reddens here\n18|// rather than passing silently. Sweeping the known members proves\n19|// the rule over those members, not that the vocabulary contains\n20|// exactly those members; these tests prove the containment.\n21|\n22|// codeSpanPattern matches one inline code element, which is how the\n23|// pinned document writes every vocabulary member.\n24|var codeSpanPattern = regexp.MustCompile(`<code>([^<>]*)</code>`)\n25|\n26|// codeSpansOf extracts the code elements of a spec window in order.\n27|// An empty window or a window with no code elements is a blind\n28|// check, so both fail outright.\n29|func codeSpansOf(t *testing.T, window string) []string {\n30|\tt.Helper()\n31|\tif strings.TrimSpace(window) == \"\" {\n32|\t\tt.Fatal(\"spec window is empty; the check is blind\")\n33|\t}\n34|\tspans := codeSpanPattern.FindAllStringSubmatch(window, -1)\n35|\tif len(spans) == 0 {\n36|\t\tt.Fatal(\"spec window holds no code elements; the check is blind\")\n37|\t}\n38|\tvar members []string\n39|\tfor _, span := range spans {\n40|\t\tmembers = append(members, span[1])\n41|\t}\n42|\treturn members\n43|}\n44|\n45|// alternativesOf parses one pipe-separated alternative list out of a\n46|// Section 7.5 table row: the text after marker up to the next comma,\n47|// split on the document's pipe entity. A missing marker or an empty\n48|// list is a blind check, so both fail outright.\n49|func alternativesOf(t *testing.T, row, marker string) []string {\n50|\tt.Helper()\n51|\tstart := strings.Index(row, marker)\n52|\tif start < 0 {\n53|\t\tt.Fatalf(\"Section 7.5 row holds no %q; the check is blind\", marker)\n54|\t}\n55|\trest := row[start+len(marker):]\n56|\tif end := strings.Index(rest, \",\"); end >= 0 {\n57|\t\trest = rest[:end]\n58|\t}\n59|\tif end := strings.Index(rest, \"}\"); end >= 0 {\n60|\t\trest = rest[:end]\n61|\t}\n62|\tmembers := strings.Split(rest, \"&#124;\")\n63|\tvar cleaned []string\n64|\tfor _, member := range members {\n65|\t\tmember = strings.TrimSpace(member)\n66|\t\tif member == \"\" {\n67|\t\t\tt.Fatalf(\"Section 7.5 row %q parses to an empty member; the check is blind\", marker)\n68|\t\t}\n69|\t\tcleaned = append(cleaned, member)\n70|\t}\n71|\tif len(cleaned) == 0 {\n72|\t\tt.Fatalf(\"Section 7.5 row %q parses to no members; the check is blind\", marker)\n73|\t}\n74|\treturn cleaned\n75|}\n76|\n77|// requireVocabulary asserts the implementation holds exactly the\n78|// spec-derived members in the derived order. The comparison is\n79|// reflect.DeepEqual over the slices themselves: a %v rendering\n80|// cannot tell [a b] from [a, b], so a formatting comparison would\n81|// admit a member the contract never defined.\n82|func requireVocabulary(t *testing.T, name string, got, want []string) {\n83|\tt.Helper()\n84|\tif !reflect.DeepEqual(got, want) {\n85|\t\tt.Fatalf(\"%s = %v, want the pinned vocabulary %v\", name, got, want)\n86|\t}\n87|\tt.Logf(\"%s coverage: %d/%d vocabulary members derived\", name, len(got), len(want))\n88|}\n89|\n90|// TestProbeStatusVocabularyIsDerivedFromSpec proves the closed\n91|// status vocabulary equals the Section 7.4 sentence: a widened\n92|// implementation admitting \"partial\" reddens here.\n93|func TestProbeStatusVocabularyIsDerivedFromSpec(t *testing.T) {\n94|\tdocument, err := specdoc.Load()\n95|\tif err != nil {\n96|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n97|\t}\n98|\twindow := sectionLines(t, document, \"7.4\", 2869, 2870)\n99|\trequireQuote(t, document, \"Status is one of\", \"7.4\")\n100|\trequireVocabulary(t, \"probeCapabilityStatuses\", probeCapabilityStatuses, codeSpansOf(t, window))\n101|}\n102|\n103|// TestProbeEvidenceVocabularyIsDerivedFromSpec proves the closed\n104|// evidence vocabulary equals the Section 7.4 sentence: a widened\n105|// implementation admitting \"assumed\" reddens here.\n106|func TestProbeEvidenceVocabularyIsDerivedFromSpec(t *testing.T) {\n107|\tdocument, err := specdoc.Load()\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n110|\t}\n111|\twindow := sectionLines(t, document, \"7.4\", 2872, 2874)\n112|\trequireQuote(t, document, \"Evidence is one of\", \"7.4\")\n113|\trequireVocabulary(t, \"probeCapabilityEvidence\", probeCapabilityEvidence, codeSpansOf(t, window))\n114|}\n115|\n116|// TestProbeArchitecturesAreDerivedFromSpec proves the closed\n117|// architecture vocabulary equals both Section 7.4 prose and the\n118|// Section 7.5 probe request row: a widened implementation admitting\n119|// \"386\" reddens here.\n120|func TestProbeArchitecturesAreDerivedFromSpec(t *testing.T) {\n121|\tdocument, err := specdoc.Load()\n122|\tif err != nil {\n123|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n124|\t}\n125|\twindow := sectionLines(t, document, \"7.4\", 2862, 2862)\n126|\trequireQuote(t, document, \"architecture is\", \"7.4\")\n127|\trequireVocabulary(t, \"probeArchitectures\", probeArchitectures, codeSpansOf(t, window))\n128|\trow := sectionLines(t, document, \"7.5\", 3073, 3073)\n129|\trequireVocabulary(t, \"probeArchitectures\", probeArchitectures, alternativesOf(t, row, \"architecture:\"))\n130|}\n131|\n132|// TestProbePlatformsAreDerivedFromSpec proves the closed probe\n133|// platform vocabulary equals the Section 7.5 probe request row. The\n134|// row lists macos first while the implementation holds sorted\n135|// order, so the comparison is sorted on both sides: a widened\n136|// implementation admitting \"freebsd\" reddens here.\n137|func TestProbePlatformsAreDerivedFromSpec(t *testing.T) {\n138|\tdocument, err := specdoc.Load()\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n141|\t}\n142|\trow := sectionLines(t, document, \"7.5\", 3073, 3073)\n143|\tderived := alternativesOf(t, row, \"platform:\")\n144|\tsort.Strings(derived)\n145|\tgot := append([]string(nil), probePlatforms...)\n146|\tsort.Strings(got)\n147|\trequireVocabulary(t, \"probePlatforms\", got, derived)\n148|}\n149|\n150|// TestQuiesceBlockersAreDerivedFromSpec proves the closed blocker\n151|// enum equals the Section 7.5 sentence: a widened implementation\n152|// admitting \"other\" reddens here.\n153|func TestQuiesceBlockersAreDerivedFromSpec(t *testing.T) {\n154|\tdocument, err := specdoc.Load()\n155|\tif err != nil {\n156|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n157|\t}\n158|\twindow := sectionLines(t, document, \"7.5\", 2907, 2910)\n159|\trequireQuote(t, document, \"blockers\", \"7.5\")\n160|\tspans := codeSpansOf(t, window)\n161|\tif spans[0] != \"SafeBoundaryProof.blockers\" {\n162|\t\tt.Fatalf(\"blocker enum window opens with %q, want the enum owner; the check is blind\", spans[0])\n163|\t}\n164|\trequireVocabulary(t, \"quiesceBlockers\", quiesceBlockers, spans[1:])\n165|}\n166|\n167|// TestIdentityKindsAreDerivedFromSpec proves the closed\n168|// identity-kind enum equals the Section 5.5 table row: a widened\n169|// implementation admitting \"legacy_alias\" reddens here.\n170|func TestIdentityKindsAreDerivedFromSpec(t *testing.T) {\n171|\tdocument, err := specdoc.Load()\n172|\tif err != nil {\n173|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n174|\t}\n175|\twindow := sectionLines(t, document, \"5.5\", 2086, 2086)\n176|\tspans := codeSpansOf(t, window)\n177|\tif len(spans) == 0 || spans[0] != \"identity_kind\" {\n178|\t\tt.Fatalf(\"identity-kind row opens with %v, want the member cell; the check is blind\", spans)\n179|\t}\n180|\trequireVocabulary(t, \"identityKinds\", identityKinds, spans[1:])\n181|}\n182|\n183|// TestIdentifyVocabulariesAreDerivedFromSpec proves the closed\n184|// identify-session confidence and matched-evidence vocabularies\n185|// equal the Section 7.5 row: a widened implementation admitting\n186|// \"guess\" or \"guessed\" reddens here.\n187|func TestIdentifyVocabulariesAreDerivedFromSpec(t *testing.T) {\n188|\tdocument, err := specdoc.Load()\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n191|\t}\n192|\trow := sectionLines(t, document, \"7.5\", 3075, 3075)\n193|\trequireVocabulary(t, \"identifyConfidences\", identifyConfidences, alternativesOf(t, row, \"confidence:\"))\n194|\tevidence := alternativesOf(t, row, \"matched_evidence:sorted unique \")\n195|\tfor index, member := range evidence {\n196|\t\tif bracket := strings.Index(member, \"[\"); bracket >= 0 {\n197|\t\t\tevidence[index] = member[:bracket]\n198|\t\t}\n199|\t}\n200|\trequireVocabulary(t, \"identifyEvidence\", identifyEvidence, evidence)\n201|}\n202|\n203|// identifyResultBody renders the Section 5.5 example inside the\n204|// identify-session success shape: the same body\n205|// TestDecodeIdentifyResultFixtures drives.\n206|func identifyResultBody(t *testing.T) []byte {\n207|\tt.Helper()\n208|\tindented := strings.ReplaceAll(specIdentityExample, \"\\n\", \"\\n  \")\n209|\treturn []byte(specIdentifyResultPrefix + \"  \" + strings.TrimPrefix(indented, \"  \") + `,\n210|  \"confidence\": \"exact\",\n211|  \"matched_evidence\": [\"native_id\"]\n212|}`)\n213|}\n214|\n215|// identifyResultVariant rewrites one unique substring of that body.\n216|func identifyResultVariant(t *testing.T, old, new string) []byte {\n217|\tt.Helper()\n218|\tfull := string(identifyResultBody(t))\n219|\tif strings.Count(full, old) != 1 {\n220|\t\tt.Fatalf(\"identify variant anchor %q is not unique\", old)\n221|\t}\n222|\treturn []byte(strings.Replace(full, old, new, 1))\n223|}\n224|\n225|// TestClosedVocabularyWideningsRefuse drives the exact widened\n226|// members the derivation tests pin through the production entry\n227|// points: each is refused at its own arm, so a vocabulary that\n228|// admits one more value reddens twice — once here, once above.\n229|func TestClosedVocabularyWideningsRefuse(t *testing.T) {\n230|\tt.Run(\"probe status partial\", func(t *testing.T) {\n231|\t\tbody := probeVariant(t, `\"status\": \"unknown\",\n232|      \"enabled\": false,\n233|      \"evidence\": \"none\",\n234|      \"detail\": \"not claimed for v0.3.0\"`, `\"status\": \"partial\",\n235|      \"enabled\": false,\n236|      \"evidence\": \"none\",\n237|      \"detail\": \"not claimed for v0.3.0\"`)\n238|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"status is not a registry member\")\n239|\t})\n240|\tt.Run(\"probe evidence assumed\", func(t *testing.T) {\n241|\t\tbody := probeVariant(t, `\"evidence\": \"probed\",`, `\"evidence\": \"assumed\",`)\n242|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"evidence is not a registry member\")\n243|\t})\n244|\tt.Run(\"probe architecture 386\", func(t *testing.T) {\n245|\t\tbody := probeVariant(t, `\"architecture\": \"arm64\"`, `\"architecture\": \"386\"`)\n246|\t\trequireFrameRefusal(t, DecodeProbe(body), \"architecture\", \"not amd64 or arm64\")\n247|\t})\n248|\tt.Run(\"probe platform freebsd\", func(t *testing.T) {\n249|\t\tbody := probeVariant(t, `\"platform\": \"macos\"`, `\"platform\": \"freebsd\"`)\n250|\t\trequireFrameRefusal(t, DecodeProbe(body), \"platform\", \"not a registry member\")\n251|\t})\n252|\tt.Run(\"quiesce blocker other\", func(t *testing.T) {\n253|\t\tbody := quiesceVariant(t, `\"blockers\": []`, `\"blockers\": [\"other\"]`)\n254|\t\trequireFrameRefusal(t, quiesceErr(body), \"blockers\", \"unknown blocker\")\n255|\t})\n256|\tt.Run(\"identity kind legacy_alias\", func(t *testing.T) {\n257|\t\tbody := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"legacy_alias\"`)\n258|\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"identity_kind\", \"not a registry member\")\n259|\t})\n260|\tt.Run(\"identify confidence guess\", func(t *testing.T) {\n261|\t\tbody := identifyResultVariant(t, `\"confidence\": \"exact\"`, `\"confidence\": \"guess\"`)\n262|\t\trequireFrameRefusal(t, DecodeIdentifyResult(body, \"antigravity\"), \"confidence\", \"not exact strong or weak\")\n263|\t})\n264|\tt.Run(\"identify evidence guessed\", func(t *testing.T) {\n265|\t\tbody := identifyResultVariant(t, `\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"guessed\"]`)\n266|\t\trequireFrameRefusal(t, DecodeIdentifyResult(body, \"antigravity\"), \"matched_evidence\", \"unknown member\")\n267|\t})\n268|}"}}}
