{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a7","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":302,"recorded_at":1780531400000599,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"call_id":"call_01a0703a3b9a7551988995af48d9e821","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"io\"\n7|\t\"os/exec\"\n8|\t\"time\"\n9|)\n10|\n11|// waitDrainDelay bounds how long Wait lingers for pipe EOF after the\n12|// deadline kill before giving up on detached grandchildren.\n13|const waitDrainDelay = 2 * time.Second\n14|\n15|// stdoutCap bounds captured plugin stdout: one maximal frame, its line\n16|// terminator, and one probe byte, so a maximal frame followed by any\n17|// trailing byte is still distinguishable from a clean end. Anything\n18|// beyond is cut; the splitFrame length checks stay exact on the capped\n19|// capture.\n20|const stdoutCap = MaxFrameBytes + 2\n21|\n22|// Result is what a plugin process produced: captured stdout and stderr\n23|// and the process exit code. Stdout and stderr are kept separate end to\n24|// end: diagnostics never enter frame parsing, and frame bytes never\n25|// enter diagnostics. Captures are capped (stdout at one frame plus a\n26|// probe byte, stderr at StderrCapBytes); beyond the cap the stream is cut\n27|// and the failure is decided from what was captured, which the length\n28|// checks keep exact.\n29|type Result struct {\n30|\tStdout   []byte\n31|\tStderr   []byte\n32|\tExitCode int\n33|}\n34|\n35|// Runner starts one plugin process for one operation frame. Production\n36|// code supplies ExecRunner; tests supply a scripted fake. A Runner moves\n37|// bytes and reports process fate; it never parses frames and never\n38|// decides failures.\n39|type Runner interface {\n40|\tRun(ctx context.Context, executable string, stdin []byte) (Result, error)\n41|}\n42|\n43|// ExecRunner is the production Runner: it starts the trusted executable\n44|// discovered by internal/provider, writes exactly one frame to its stdin,\n45|// closes stdin, and waits under the caller's context. Environment and\n46|// stderr content never enter failure human text: Result carries the raw\n47|// streams, and failures built from a Result carry the failure class and\n48|// member names only, never content.\n49|type ExecRunner struct{}\n50|\n51|// Run starts executable with stdin on its stdin and captures both streams\n52|// with caps. A nil error with a nonzero exit code is an ordinary result:\n53|// a syntactically valid frame governs regardless of the exit status,\n54|// because SHOULD exit 0 is not MUST. A non-nil error means the process\n55|// never produced a result to judge: start failure, signal death, or\n56|// context end.\n57|func (ExecRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n58|\tcommand := newCommandContext(ctx, executable)\n59|\tcommand.WaitDelay = waitDrainDelay\n60|\tstdinPipe, err := command.StdinPipe()\n61|\tif err != nil {\n62|\t\treturn Result{}, err\n63|\t}\n64|\tstdoutPipe, err := command.StdoutPipe()\n65|\tif err != nil {\n66|\t\treturn Result{}, err\n67|\t}\n68|\tstderrPipe, err := command.StderrPipe()\n69|\tif err != nil {\n70|\t\treturn Result{}, err\n71|\t}\n72|\tif err := command.Start(); err != nil {\n73|\t\treturn Result{}, err\n74|\t}\n75|\t// Drain both streams while stdin is written: a plugin that answers\n76|\t// without reading stdin would otherwise deadlock against a full\n77|\t// pipe once either direction exceeds its buffer.\n78|\ttype streamResult struct {\n79|\t\tdata []byte\n80|\t\terr  error\n81|\t}\n82|\tstdoutDone := make(chan streamResult, 1)\n83|\tstderrDone := make(chan streamResult, 1)\n84|\tgo func() {\n85|\t\tdata, err := readCapped(stdoutPipe, stdoutCap)\n86|\t\tstdoutDone <- streamResult{data: data, err: err}\n87|\t}()\n88|\tgo func() {\n89|\t\tdata, err := readCapped(stderrPipe, StderrCapBytes)\n90|\t\tstderrDone <- streamResult{data: data, err: err}\n91|\t}()\n92|\twrote, writeErr := stdinPipe.Write(stdin)\n93|\tif writeErr == nil && wrote < len(stdin) {\n94|\t\twriteErr = io.ErrShortWrite\n95|\t}\n96|\tif writeErr == nil {\n97|\t\t_, writeErr = stdinPipe.Write([]byte{'\\n'})\n98|\t}\n99|\tcloseErr := stdinPipe.Close()\n100|\twaitErr := command.Wait()\n101|\tif ctx.Err() != nil {\n102|\t\t// The wait ended by deadline or cancellation: the kill was\n103|\t\t// already signaled, but a detached grandchild may hold the\n104|\t\t// pipes open past WaitDelay. Close them rather than waiting\n105|\t\t// for streams that can no longer decide anything: with the\n106|\t\t// deadline gone there is no valid response to read.\n107|\t\tstdoutPipe.Close()\n108|\t\tstderrPipe.Close()\n109|\t\t<-stdoutDone\n110|\t\t<-stderrDone\n111|\t\treturn Result{}, ctx.Err()\n112|\t}\n113|\tstdoutResult := <-stdoutDone\n114|\tstderrResult := <-stderrDone\n115|\tif stdoutResult.err != nil {\n116|\t\treturn Result{}, stdoutResult.err\n117|\t}\n118|\tif stderrResult.err != nil {\n119|\t\treturn Result{}, stderrResult.err\n120|\t}\n121|\tstdout := stdoutResult.data\n122|\tstderr := stderrResult.data\n123|\t// A stdin write failure after the process ran is still a result when\n124|\t// the process produced one: the frame may have arrived whole while\n125|\t// the close raced the plugin's exit. Report write and close failures\n126|\t// only when no result can be judged; otherwise the frame governs.\n127|\tresult := Result{Stdout: stdout, Stderr: stderr, ExitCode: command.ProcessState.ExitCode()}\n128|\tif waitErr == nil {\n129|\t\tif writeErr != nil {\n130|\t\t\treturn Result{}, writeErr\n131|\t\t}\n132|\t\treturn result, closeErr\n133|\t}\n134|\tif exit, ok := waitErr.(*exec.ExitError); ok {\n135|\t\tresult.ExitCode = exit.ExitCode()\n136|\t\tif writeErr != nil {\n137|\t\t\treturn Result{}, writeErr\n138|\t\t}\n139|\t\treturn result, closeErr\n140|\t}\n141|\treturn Result{}, waitErr\n142|}\n143|\n144|// readCapped drains stream up to cap bytes and cuts the rest. Memory\n145|// stays bounded no matter what the plugin emits, and the splitFrame\n146|// length checks stay exact on the capped capture.\n147|func readCapped(stream io.Reader, cap int) ([]byte, error) {\n148|\tdata, err := io.ReadAll(io.LimitReader(stream, int64(cap)+1))\n149|\tif err != nil {\n150|\t\treturn nil, err\n151|\t}\n152|\tif len(data) > cap {\n153|\t\treturn data[:cap], nil\n154|\t}\n155|\treturn data, nil\n156|}\n157|\n158|// Host invokes provider plugins: one process per operation, one frame in,\n159|// one frame out, under the request deadline. Host keeps no cross-call\n160|// state, so successive calls are separate processes observing durable\n161|// state through the authority the caller passes.\n162|type Host struct {\n163|\t// Runner starts the plugin process. It must be set; a nil Runner is\n164|\t// a caller error, refused before any frame is built.\n165|\tRunner Runner\n166|\t// Now is the clock deadlines are checked against. Nil means the\n167|\t// system clock; tests supply a fixed instant.\n168|\tNow func() time.Time\n169|}\n170|\n171|func (host Host) now() time.Time {\n172|\tif host.Now == nil {\n173|\t\treturn time.Now()\n174|\t}\n175|\treturn host.Now()\n176|}\n177|\n178|// splitFrame separates the single response line from anything following\n179|// it. oversize reports a first line beyond MaxFrameBytes; extra reports\n180|// any bytes after the first line terminator. An empty line is neither:\n181|// it is a missing response, judged with the exit code by the caller.\n182|//\n183|// The checks are length-only and exact: stdout capture holds at most\n184|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n185|// trailing byte, is always visible in the captured length. No separate\n186|// truncation flag participates; a narrowed or dropped disjunct here\n187|// would be equivalent, not coverage.\n188|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n189|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n190|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n191|\t}\n192|\treturn captured, len(captured) > MaxFrameBytes, false\n193|}\n194|\n195|// Call dispatches one operation: it frames the request, starts one plugin\n196|// process, enforces the request deadline, and interprets the single\n197|// response frame. Encode failures return before the Runner is touched, so\n198|// an unknown operation never starts a process. A success envelope returns\n199|// its body; a failure envelope returns the bound child error; anything\n200|// else returns a local failure that trusts nothing from the plugin.\n201|//\n202|// Deadline accounting is exact: the wait ends under a context cut at the\n203|// request deadline, and provider_timeout is reported only when that\n204|// instant actually passed. A parent cancellation first, or any other\n205|// runner failure with time remaining, is provider_process_failed. An\n206|// empty stdout with time remaining is a missing response:\n207|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n208|// An empty stdout after the deadline passed is provider_timeout, and a\n209|// valid frame governs regardless of lateness or exit status.\n210|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n211|\tif host.Runner == nil {\n212|\t\tfailure, err := failInvalid(\"host has no runner\")\n213|\t\tif err != nil {\n214|\t\t\treturn Response{}, err\n215|\t\t}\n216|\t\treturn Response{}, failure\n217|\t}\n218|\tframe, deadline, err := encodeFrame(req, host.now())\n219|\tif err != nil {\n220|\t\treturn Response{}, err\n221|\t}\n222|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n223|\tdefer cancel()\n224|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n225|\tif err != nil {\n226|\t\tnow := host.now()\n227|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n228|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n229|\t\t\tif fault != nil {\n230|\t\t\t\treturn Response{}, fault\n231|\t\t\t}\n232|\t\t\treturn Response{}, failure\n233|\t\t}\n234|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n235|\t\tif fault != nil {\n236|\t\t\treturn Response{}, fault\n237|\t\t}\n238|\t\treturn Response{}, failure\n239|\t}\n240|\tline, oversize, extra := splitFrame(result.Stdout)\n241|\tif oversize {\n242|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n243|\t\tif fault != nil {\n244|\t\t\treturn Response{}, fault\n245|\t\t}\n246|\t\treturn Response{}, failure\n247|\t}\n248|\tif extra {\n249|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n250|\t\tif fault != nil {\n251|\t\t\treturn Response{}, fault\n252|\t\t}\n253|\t\treturn Response{}, failure\n254|\t}\n255|\tif len(line) == 0 {\n256|\t\t// No valid response arrived. When the request deadline passed,\n257|\t\t// this is the timeout even if the process also exited badly:\n258|\t\t// the host waited the full allowance and got nothing usable.\n259|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n260|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n261|\t\t\tif fault != nil {\n262|\t\t\t\treturn Response{}, fault\n263|\t\t\t}\n264|\t\t\treturn Response{}, failure\n265|\t\t}\n266|\t\tif result.ExitCode != 0 {\n267|\t\t\tfailure, fault := failProcess(\"plugin exited without a response\", nil)\n268|\t\t\tif fault != nil {\n269|\t\t\t\treturn Response{}, fault\n270|\t\t\t}\n271|\t\t\treturn Response{}, failure\n272|\t\t}\n273|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n274|\t\tif fault != nil {\n275|\t\t\treturn Response{}, fault\n276|\t\t}\n277|\t\treturn Response{}, failure\n278|\t}\n279|\treturn DecodeResponse(line, req.RequestID)\n280|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a9","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":303,"recorded_at":1780531400000601,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"call_id":"call_01a0703a3d3a7751ac34498bb053b591","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/profile.go`.\n1|package provhost\n2|\n3|// This file maps execution profiles to provider adapter flags under\n4|// Section 7.7. The v0.3.0 yolo mappings below are exact adapter\n5|// strings the host persists into SpawnPlans; standard uses the\n6|// provider's normal approval and sandbox behavior and omits every\n7|// unrestricted flag. The adapter MUST probe the exact provider\n8|// version before applying a mapping, and an absent or changed flag\n9|// fails closed: unknown providers and unknown profiles are refused,\n10|// never defaulted.\n11|\n12|// Execution profiles Section 7.7 defines.\n13|const (\n14|\tProfileStandard = \"standard\"\n15|\tProfileYOLO     = \"yolo\"\n16|)\n17|\n18|// profileProviders lists the six Section 7.7 providers in table\n19|// order. Pi has no permission-mode flag: both of its profiles resolve\n20|// to the default full tool set, and probe and launch output MUST\n21|// disclose that equivalence rather than invent a flag.\n22|var profileProviders = []string{\n23|\t\"codex\",\n24|\t\"claude\",\n25|\t\"gemini\",\n26|\t\"muse\",\n27|\t\"antigravity\",\n28|\t\"pi\",\n29|}\n30|\n31|// profileYOLOMapping is the required yolo adapter flag per provider.\n32|// Standard maps to the empty string for every provider: no flag, no\n33|// alias that silently expands to unrestricted mode.\n34|var profileYOLOMapping = map[string]string{\n35|\t\"codex\":       \"--dangerously-bypass-approvals-and-sandbox\",\n36|\t\"claude\":      \"--dangerously-skip-permissions\",\n37|\t\"gemini\":      \"--approval-mode=yolo\",\n38|\t\"muse\":        \"--yolo\",\n39|\t\"antigravity\": \"--dangerously-skip-permissions\",\n40|\t\"pi\":          \"default_unrestricted_tool_set\",\n41|}\n42|\n43|// ProfileMapping resolves the adapter flag for one provider under one\n44|// profile. Standard returns the empty string: the caller omits every\n45|// unrestricted flag. An unknown provider or profile is an\n46|// invalid_config caller error; there is no default mapping a new\n47|// provider could silently inherit.\n48|func ProfileMapping(providerID, profile string) (string, error) {\n49|\tmapping, known := profileYOLOMapping[providerID]\n50|\tif !known {\n51|\t\tfailure, err := failInvalid(\"profile mapping names an unknown provider\")\n52|\t\tif err != nil {\n53|\t\t\treturn \"\", err\n54|\t\t}\n55|\t\treturn \"\", failure\n56|\t}\n57|\tswitch profile {\n58|\tcase ProfileStandard:\n59|\t\treturn \"\", nil\n60|\tcase ProfileYOLO:\n61|\t\treturn mapping, nil\n62|\tdefault:\n63|\t\tfailure, err := failInvalid(\"profile mapping names an unknown profile\")\n64|\t\tif err != nil {\n65|\t\t\treturn \"\", err\n66|\t\t}\n67|\t\treturn \"\", failure\n68|\t}\n69|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
