{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c5","stream":{"kind":"session","id":"01a07039-8c36-7981-972e-5e4ed62aa495"},"sequence":445,"recorded_at":1780531400000885,"record_type":"event","durability":"durable","causation_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"58f5c997-17a5-45b9-a711-d639aa7cbef7","run_stream":{"kind":"run","id":"58f5c997-17a5-45b9-a711-d639aa7cbef7"},"task_stream":{"kind":"task","id":"b4468474-6d9a-46e6-9386-974a70f12bae"},"task_id":"b4468474-6d9a-46e6-9386-974a70f12bae","event":{"kind":"output","task_id":"b4468474-6d9a-46e6-9386-974a70f12bae","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|)\n18|\n19|// futureDeadline returns a deadline duration ahead of the real clock,\n20|// so Host deadline accounting runs against live time.\n21|func futureDeadline(t *testing.T, ahead time.Duration) scalar.Timestamp {\n22|\tt.Helper()\n23|\tparsed, err := scalar.ParseTimestamp(time.Now().Add(ahead).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n26|\t}\n27|\treturn parsed\n28|}\n29|\n30|// liveRequest is testRequest with a live future deadline for Host calls,\n31|// which enforce the deadline against a real context.\n32|func liveRequest(t *testing.T) Request {\n33|\tt.Helper()\n34|\treq := testRequest(t)\n35|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n36|\treturn req\n37|}\n38|\n39|// liveHost builds a Host on the real clock.\n40|func liveHost(runner *scriptRunner) Host {\n41|\treturn Host{Runner: runner, Now: time.Now}\n42|}\n43|\n44|// scriptCall records one Runner invocation.\n45|type scriptCall struct {\n46|\texecutable string\n47|\tstdin      []byte\n48|}\n49|\n50|// scriptRunner is a scripted Runner: it replays canned results, records\n51|// every invocation, and optionally blocks until the context ends to\n52|// simulate a hung plugin. It proves Host behavior without real processes;\n53|// the ExecRunner integration test below drives the production call site.\n54|// scriptStep is one canned invocation outcome: either a result or a\n55|// transport error, consumed in listed order.\n56|type scriptStep struct {\n57|\tresult Result\n58|\terr    error\n59|}\n60|\n61|func okStep(result Result) scriptStep { return scriptStep{result: result} }\n62|\n63|func failStep(err error) scriptStep { return scriptStep{err: err} }\n64|\n65|type scriptRunner struct {\n66|\tmu    sync.Mutex\n67|\tcalls []scriptCall\n68|\tsteps []scriptStep\n69|\tblock bool\n70|\t// delay sleeps past the request deadline before replaying, so the\n71|\t// runner returns a result after the deadline instead of an error.\n72|\tdelay time.Duration\n73|}\n74|\n75|func (runner *scriptRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n76|\trunner.mu.Lock()\n77|\trunner.calls = append(runner.calls, scriptCall{executable: executable, stdin: append([]byte(nil), stdin...)})\n78|\tindex := len(runner.calls) - 1\n79|\trunner.mu.Unlock()\n80|\tif runner.block {\n81|\t\t<-ctx.Done()\n82|\t\treturn Result{}, ctx.Err()\n83|\t}\n84|\tif runner.delay > 0 {\n85|\t\ttime.Sleep(runner.delay)\n86|\t}\n87|\tif index < len(runner.steps) {\n88|\t\tstep := runner.steps[index]\n89|\t\treturn step.result, step.err\n90|\t}\n91|\treturn Result{}, errors.New(\"script: no step canned\")\n92|}\n93|\n94|func (runner *scriptRunner) spawned() int {\n95|\trunner.mu.Lock()\n96|\tdefer runner.mu.Unlock()\n97|\treturn len(runner.calls)\n98|}\n99|\n100|func successResult(t *testing.T, id, body string) Result {\n101|\tt.Helper()\n102|\treturn Result{Stdout: successFrame(t, id, body), ExitCode: 0}\n103|}\n104|\n105|// TestCallSendsOneFrameToOneProcess proves the dispatch path: the exact\n106|// request frame reaches exactly one process of the named executable.\n107|func TestCallSendsOneFrameToOneProcess(t *testing.T) {\n108|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n109|\thost := liveHost(runner)\n110|\treq := liveRequest(t)\n111|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"Call: %v\", err)\n114|\t}\n115|\tif string(got.Body) != `{\"provider_id\":\"pi\"}` {\n116|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n117|\t}\n118|\tif runner.spawned() != 1 {\n119|\t\tt.Fatalf(\"Call spawned %d processes, want exactly one per operation\", runner.spawned())\n120|\t}\n121|\tcall := runner.calls[0]\n122|\tif call.executable != \"/plugins/ax-provider-pi\" {\n123|\t\tt.Fatalf(\"Call executable = %q\", call.executable)\n124|\t}\n125|\tframe, err := EncodeRequest(req, time.Now())\n126|\tif err != nil {\n127|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n128|\t}\n129|\tif string(call.stdin) != string(frame) {\n130|\t\tt.Fatalf(\"Call stdin = %q, want the single request frame\", call.stdin)\n131|\t}\n132|}\n133|\n134|// TestCallUnknownOperationStartsNoProcess proves dispatch refuses an\n135|// unregistered operation locally: the failure is invalid_config and the\n136|// Runner is never touched.\n137|func TestCallUnknownOperationStartsNoProcess(t *testing.T) {\n138|\trunner := &scriptRunner{}\n139|\thost := liveHost(runner)\n140|\treq := liveRequest(t)\n141|\treq.Operation = \"reboot\"\n142|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n143|\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n144|\tif runner.spawned() != 0 {\n145|\t\tt.Fatalf(\"Call spawned %d processes for an unknown operation, want none\", runner.spawned())\n146|\t}\n147|}\n148|\n149|// TestCallNilRunnerRefuses proves a host without a Runner fails closed\n150|// before framing.\n151|func TestCallNilRunnerRefuses(t *testing.T) {\n152|\thost := Host{Now: time.Now}\n153|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n154|\trequireLocalRefusal(t, err, \"invalid_config\", \"host has no runner\")\n155|}\n156|\n157|// TestCallUsesSystemClockWhenUnset proves the nil-clock branch: a Host\n158|// without Now enforces live deadlines.\n159|func TestCallUsesSystemClockWhenUnset(t *testing.T) {\n160|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n161|\thost := Host{Runner: runner}\n162|\treq := testRequest(t)\n163|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n164|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); err != nil {\n165|\t\tt.Fatalf(\"Call with unset clock: %v\", err)\n166|\t}\n167|}\n168|\n169|// failingReader always errors, exercising the capped-read failure path.\n170|type failingReader struct{}\n171|\n172|func (failingReader) Read([]byte) (int, error) { return 0, errors.New(\"fake: read failed\") }\n173|\n174|// TestReadCappedReportsStreamErrors proves a stream failure surfaces\n175|// instead of an empty capture.\n176|func TestReadCappedReportsStreamErrors(t *testing.T) {\n177|\tif _, err := readCapped(failingReader{}, 1024); err == nil {\n178|\t\tt.Fatal(\"readCapped swallowed a stream error\")\n179|\t}\n180|}\n181|\n182|// TestReadCappedEnforcesCap proves the memory bound runner.go promises:\n183|// a stream far beyond the cap is cut to exactly cap bytes carrying the\n184|// stream prefix, while under-cap and exact-cap streams pass through\n185|// untouched. Removing the limiter returns the whole stream; removing the\n186|// truncation returns cap+1 bytes; both redden here.\n187|func TestReadCappedEnforcesCap(t *testing.T) {\n188|\tconst cap = 16\n189|\tover := strings.Repeat(\"a\", 4*cap) + strings.Repeat(\"b\", 4*cap)\n190|\tgot, err := readCapped(strings.NewReader(over), cap)\n191|\tif err != nil {\n192|\t\tt.Fatalf(\"readCapped: %v\", err)\n193|\t}\n194|\tif len(got) != cap {\n195|\t\tt.Fatalf(\"readCapped cut %d input bytes to %d, want exactly %d\", len(over), len(got), cap)\n196|\t}\n197|\tif string(got) != strings.Repeat(\"a\", cap) {\n198|\t\tt.Fatalf(\"readCapped kept %q, want the stream prefix\", got)\n199|\t}\n200|\tfor _, size := range []int{0, 1, cap - 1, cap} {\n201|\t\twant := strings.Repeat(\"c\", size)\n202|\t\tgot, err := readCapped(strings.NewReader(want), cap)\n203|\t\tif err != nil {\n204|\t\t\tt.Fatalf(\"readCapped(%d): %v\", size, err)\n205|\t\t}\n206|\t\tif string(got) != want {\n207|\t\t\tt.Fatalf(\"readCapped(%d) = %q, want passthrough\", size, got)\n208|\t\t}\n209|\t}\n210|}\n211|\n212|// errAfterReader yields filler bytes up to a budget, then fails. It proves\n213|// readCapped stops consuming at cap+1: with the limiter the error past the\n214|// cap is never reached, while a limiter removed (reading the whole stream\n215|// into memory first) surfaces it.\n216|type errAfterReader struct {\n217|\tremaining int\n218|\tfiller    byte\n219|}\n220|\n221|func (reader *errAfterReader) Read(into []byte) (int, error) {\n222|\tif reader.remaining <= 0 {\n223|\t\treturn 0, errors.New(\"fake: past the cap\")\n224|\t}\n225|\tn := len(into)\n226|\tif n > reader.remaining {\n227|\t\tn = reader.remaining\n228|\t}\n229|\tfor i := 0; i < n; i++ {\n230|\t\tinto[i] = reader.filler\n231|\t}\n232|\treader.remaining -= n\n233|\treturn n, nil\n234|}\n235|\n236|// TestReadCappedStopsConsumingAtTheCap proves the limiter half of the\n237|// memory bound: a stream that fails past four caps is still cut cleanly,\n238|// because reads stop one byte past the cap instead of draining the\n239|// stream. Removing the limiter surfaces the stream error here.\n240|func TestReadCappedStopsConsumingAtTheCap(t *testing.T) {\n241|\tconst cap = 16\n242|\tgot, err := readCapped(&errAfterReader{remaining: 4 * cap, filler: 'd'}, cap)\n243|\tif err != nil {\n244|\t\tt.Fatalf(\"readCapped reached past the cap: %v\", err)\n245|\t}\n246|\tif string(got) != strings.Repeat(\"d\", cap) {\n247|\t\tt.Fatalf(\"readCapped kept %q, want %d prefix bytes\", got, cap)\n248|\t}\n249|}\n250|\n251|// TestCallTimesOutHungPlugin proves the deadline path: a plugin that\n252|// never answers is terminated at the request deadline and reported as\n253|// provider_timeout with exit 13.\n254|func TestCallTimesOutHungPlugin(t *testing.T) {\n255|\trunner := &scriptRunner{block: true}\n256|\thost := liveHost(runner)\n257|\treq := liveRequest(t)\n258|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n259|\tstart := time.Now()\n260|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n261|\tif elapsed := time.Since(start); elapsed > 10*time.Second {\n262|\t\tt.Fatalf(\"Call took %v, want deadline enforcement near 100ms\", elapsed)\n263|\t}\n264|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n265|\tif failureExit(t, err) != 13 {\n266|\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n267|\t}\n268|}\n269|\n270|// TestCallEmptyResultAfterDeadlineIsTimeout proves the late-empty\n271|// path: a runner that answers with nothing after the deadline still\n272|// reports provider_timeout, even though the process exited on its own.\n273|func TestCallEmptyResultAfterDeadlineIsTimeout(t *testing.T) {\n274|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n275|\thost := liveHost(runner)\n276|\treq := liveRequest(t)\n277|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n278|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n279|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n280|}\n281|\n282|// TestCallRunnerErrorBeforeDeadlineIsProcessFailure proves a transport\n283|// failure with time remaining is provider_process_failed, not a timeout.\n284|func TestCallRunnerErrorBeforeDeadlineIsProcessFailure(t *testing.T) {\n285|\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n286|\thost := liveHost(runner)\n287|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n288|\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n289|}\n290|\n291|// TestCallParentCancelIsNotTimeout proves a caller abort with time\n292|// remaining is provider_process_failed: the deadline never passed, so no\n293|// timeout may be claimed.\n294|func TestCallParentCancelIsNotTimeout(t *testing.T) {\n295|\trunner := &scriptRunner{block: true}\n296|\thost := liveHost(runner)\n297|\tctx, cancel := context.WithCancel(context.Background())\n298|\tcancel()\n299|\t_, err := host.Call(ctx, \"/plugins/ax-provider-pi\", liveRequest(t))\n300|\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n301|}\n302|\n303|// TestCallMissingResponse proves an empty stdout is a missing response:\n304|// provider_process_failed on a crash exit, provider_protocol_error when\n305|// the plugin claimed success by exiting 0.\n306|func TestCallMissingResponse(t *testing.T) {\n307|\tfor _, kase := range []struct {\n308|\t\tname   string\n309|\t\tcode   int\n310|\t\twant   string\n311|\t\tmember string\n312|\t}{\n313|\t\t{\"crash exit\", 3, \"provider_process_failed\", \"\"},\n314|\t\t{\"signal-like exit\", 137, \"provider_process_failed\", \"\"},\n315|\t\t{\"clean exit\", 0, \"provider_protocol_error\", \"\"},\n316|\t} {\n317|\t\tt.Run(kase.name, func(t *testing.T) {\n318|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: kase.code})}}\n319|\t\t\thost := liveHost(runner)\n320|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n321|\t\t\tif kase.want == \"provider_protocol_error\" {\n322|\t\t\t\trequireFrameRefusal(t, err, kase.member, \"plugin exited without a response\")\n323|\t\t\t} else {\n324|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.want), \"plugin exited without a response\")\n325|\t\t\t}\n326|\t\t})\n327|\t}\n328|}\n329|\n330|// TestCallRefusesUnusableStdout proves crashes, garbage, and\n331|// correlation breaks map to the Section 7.2 host-failure classes. The\n332|// production entry point is Host.Call.\n333|func TestCallRefusesUnusableStdout(t *testing.T) {\n334|\tfor _, kase := range []struct {\n335|\t\tname   string\n336|\t\tresult Result\n337|\t\twant   string\n338|\t\tmember string\n339|\t\tdetail string\n340|\t}{\n341|\t\t{\"garbage\", Result{Stdout: []byte(\"not json\\n\"), Stderr: []byte(\"traceback\\n\"), ExitCode: 1}, \"provider_protocol_error\", \"\", \"not a JSON object\"},\n342|\t\t{\"crash no output\", Result{ExitCode: 1}, \"provider_process_failed\", \"\", \"plugin exited without a response\"},\n343|\t\t{\"wrong request id\", Result{Stdout: successFrame(t, testOtherID, `{}`), ExitCode: 0}, \"provider_protocol_error\", \"request_id\", \"request_id does not match the request\"},\n344|\t\t{\"extra line\", Result{Stdout: append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n'), ExitCode: 0}, \"provider_protocol_error\", \"\", \"stdout carries more than one frame\"},\n345|\t\t{\"foreign major\", Result{Stdout: []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), ExitCode: 0}, \"incompatible_protocol\", \"\", \"\"},\n346|\t} {\n347|\t\tt.Run(kase.name, func(t *testing.T) {\n348|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(kase.result)}}\n349|\t\t\thost := liveHost(runner)\n350|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n351|\t\t\tswitch kase.want {\n352|\t\t\tcase \"provider_protocol_error\":\n353|\t\t\t\trequireFrameRefusal(t, err, kase.member, kase.detail)\n354|\t\t\tcase \"incompatible_protocol\":\n355|\t\t\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n356|\t\t\t\t\tt.Fatalf(\"Call code = %v, want incompatible_protocol\", err)\n357|\t\t\t\t}\n358|\t\t\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n359|\t\t\t\t\tt.Fatalf(\"Call observed = %v, want the foreign version\", observed)\n360|\t\t\t\t}\n361|\t\t\tdefault:\n362|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.want), kase.detail)\n363|\t\t\t}\n364|\t\t})\n365|\t}\n366|}\n367|\n368|// TestCallSeparatesStderr proves stdout/stderr separation two ways: a\n369|// valid frame succeeds despite noisy diagnostics, and a failing\n370|// invocation never carries stderr content in its human text.\n371|func TestCallSeparatesStderr(t *testing.T) {\n372|\tsecret := \"[REDACTED]\"\n373|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{\n374|\t\tStdout:   successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`),\n375|\t\tStderr:   []byte(\"diagnostic: using \" + secret + \"\\n\"),\n376|\t\tExitCode: 0,\n377|\t})}}\n378|\thost := liveHost(runner)\n379|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); err != nil {\n380|\t\tt.Fatalf(\"Call with stderr diagnostics: %v\", err)\n381|\t}\n382|\n383|\tbad := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: []byte(\"garbage\\n\"), Stderr: []byte(secret + \"\\n\"), ExitCode: 1})}}\n384|\thost = liveHost(bad)\n385|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n386|\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n387|\tif strings.Contains(err.Error(), secret) {\n388|\t\tt.Fatalf(\"stderr content leaked into the failure text: %v\", err)\n389|\t}\n390|}\n391|\n392|// TestStdoutCapIsPinned pins the stdout capture bound in both\n393|// directions: one maximal frame, its line terminator, and one probe\n394|// byte. Narrowing it to MaxFrameBytes+1 makes the host accept a maximal\n395|// frame followed by one junk byte (behaviorally proven by\n396|// TestExecRunnerRefusesMaximalFramePlusJunk); widening it holds 4x the\n397|// memory bound with the suite green. Neither direction is observable\n398|// from the scripted runner, which never passes through readCapped, so\n399|// the constant itself is asserted here.\n400|func TestStdoutCapIsPinned(t *testing.T) {\n401|\tconst specStdoutCapBytes = (8 << 20) + 2\n402|\tif stdoutCap != specStdoutCapBytes {\n403|\t\tt.Fatalf(\"stdoutCap = %d, want the specified %d\", stdoutCap, specStdoutCapBytes)\n404|\t}\n405|\tif stdoutCap != MaxFrameBytes+2 {\n406|\t\tt.Fatalf(\"stdoutCap = %d, want one maximal frame plus terminator plus probe byte\", stdoutCap)\n407|\t}\n408|}\n409|\n410|// TestExecRunnerRefusesMaximalFramePlusJunk proves the probe byte is\n411|// load-bearing through the production path: a real plugin emitting a\n412|// frame of exactly MaxFrameBytes, a terminator, and one junk byte is\n413|// refused with \"stdout carries more than one frame\". With the cap\n414|// narrowed by one byte the capture holds only frame plus terminator,\n415|// the junk is cut before splitFrame can see it, and the host accepts an\n416|// 8 MiB body the wire forbids — the narrowing reddens here with err=nil.\n417|// The production entry point is Host.Call over ExecRunner.\n418|func TestExecRunnerRefusesMaximalFramePlusJunk(t *testing.T) {\n419|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n420|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n421|\t}\n422|\treq := liveRequest(t)\n423|\tprefix := `{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + req.RequestID.String() + `\",\"ok\":true,\"body\":{\"pad\":\"`\n424|\tsuffix := `\"}}`\n425|\tpadLen := MaxFrameBytes - len(prefix) - len(suffix)\n426|\tif padLen <= 0 {\n427|\t\tt.Fatalf(\"frame overhead exceeds MaxFrameBytes; cannot build a maximal frame\")\n428|\t}\n429|\tif len(prefix)+padLen+len(suffix) != MaxFrameBytes {\n430|\t\tt.Fatalf(\"maximal frame is %d bytes, want exactly %d\", len(prefix)+padLen+len(suffix), MaxFrameBytes)\n431|\t}\n432|\tscript := filepath.Join(t.TempDir(), \"ax-provider-maxframe\")\n433|\tplugin := \"#!/bin/sh\\ncat > /dev/null\\nprintf '%s' \\\"$AX_FRAME_PREFIX\\\"\\nyes a | tr -d '\\\\n' | head -c \\\"$AX_PAD_LEN\\\"\\nprintf '%s' \\\"$AX_FRAME_SUFFIX\\\"\\nprintf '\\\\nX'\\nexit 0\\n\"\n434|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n435|\t\tt.Fatalf(\"WriteFile: %v\", err)\n436|\t}\n437|\tt.Setenv(\"AX_FRAME_PREFIX\", prefix)\n438|\tt.Setenv(\"AX_FRAME_SUFFIX\", suffix)\n439|\tt.Setenv(\"AX_PAD_LEN\", strconv.Itoa(padLen))\n440|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n441|\t_, err := host.Call(context.Background(), script, req)\n442|\trequireFrameRefusal(t, err, \"\", \"stdout carries more than one frame\")\n443|}\n444|\n445|// TestCallOversizeStdoutRefuses proves a first line one byte over 8 MiB\n446|// fails as provider_protocol_error through the full Call path.\n447|func TestCallOversizeStdoutRefuses(t *testing.T) {\n448|\tpad := strings.Repeat(\"a\", specFrameLimitBytes)\n449|\tframe := successFrame(t, testRequestID, `{\"pad\":\"`+pad+`\"}`)\n450|\tif len(frame) <= specFrameLimitBytes {\n451|\t\tt.Fatalf(\"oversize stdout is %d bytes, want over %d\", len(frame), specFrameLimitBytes)\n452|\t}\n453|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: frame, ExitCode: 0})}}\n454|\thost := liveHost(runner)\n455|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n456|\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n457|}\n458|\n459|// TestCallOneProcessPerCall proves the single-flight cross-process\n460|// property: two calls start two processes with distinct request IDs.\n461|func TestCallOneProcessPerCall(t *testing.T) {\n462|\trunner := &scriptRunner{steps: []scriptStep{\n463|\t\tokStep(successResult(t, testRequestID, `{}`)),\n464|\t\tokStep(successResult(t, testOtherID, `{}`)),\n465|\t}}\n466|\thost := liveHost(runner)\n467|\tfirst := liveRequest(t)\n468|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", first); err != nil {\n469|\t\tt.Fatalf(\"first Call: %v\", err)\n470|\t}\n471|\tsecond := liveRequest(t)\n472|\tsecond.RequestID = mustUUIDv7(t, testOtherID)\n473|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", second); err != nil {\n474|\t\tt.Fatalf(\"second Call: %v\", err)\n475|\t}\n476|\tif runner.spawned() != 2 {\n477|\t\tt.Fatalf(\"two Calls spawned %d processes, want one per operation\", runner.spawned())\n478|\t}\n479|\tif string(runner.calls[0].stdin) == string(runner.calls[1].stdin) {\n480|\t\tt.Fatal(\"successive calls sent byte-identical frames; request IDs must differ\")\n481|\t}\n482|}\n483|\n484|// TestExecRunnerEchoRoundTrip drives the production call site end to\n485|// end: a real plugin script receives the frame on stdin and answers on\n486|// stdout while logging diagnostics to stderr.\n487|func TestExecRunnerEchoRoundTrip(t *testing.T) {\n488|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n489|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n490|\t}\n491|\troot := t.TempDir()\n492|\tscript := filepath.Join(root, \"ax-provider-echo\")\n493|\tplugin := `#!/bin/sh\n494|echo \"diagnostic: starting\" >&2\n495|frame=$(cat)\n496|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n497|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n498|exit 0\n499|`\n500|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n(more lines below)"}}}
