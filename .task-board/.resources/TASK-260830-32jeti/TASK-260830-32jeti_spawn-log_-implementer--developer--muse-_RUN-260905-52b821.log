sid and pass vacuously.\\ninternal/provhost/runner_test.go:729:\\tplugin := \\\"#!/bin/sh\\\\nprintf '%s\\\\\\\\n' \\\\\\\"$AX_DETACHED_FRAME\\\\\\\"\\\\nperl -e 'use POSIX setsid; exit if fork(); setsid(); sleep($ARGV[0]);' \\\\\\\"$AX_DETACHED_SLEEP\\\\\\\" &\\\\nwait\\\\nexit 0\\\\n\\\"\\ninternal/provhost/runner_test.go:730:\\tscript := filepath.Join(t.TempDir(), \\\"ax-provider-detached\\\")\\ninternal/provhost/runner_test.go:743:\\t\\tt.Fatalf(\\\"Call took %v, want deadline enforcement near 2s, not the detached grandchild lifetime\\\", elapsed)\\n\",\n  \"original_output_bytes\": 1383,\n  \"original_output_tokens\": 346,\n  \"truncated\": false\n}"}}}
