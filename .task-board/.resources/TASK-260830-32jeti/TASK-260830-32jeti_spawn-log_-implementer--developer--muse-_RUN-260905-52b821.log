{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a071e4-03f6-7fa0-b2ec-dd2af9ddca4b"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","run_stream":{"kind":"run","id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c"},"task_stream":{"kind":"task","id":"16da3bdb-861e-488e-a87f-81bb5080a8f4"},"task_id":"16da3bdb-861e-488e-a87f-81bb5080a8f4","event":{"kind":"output","task_id":"16da3bdb-861e-488e-a87f-81bb5080a8f4","chunk":"Read text file `internal/provhost/runner_unix.go`.\n1|//go:build !windows\n2|\n3|package provhost\n4|\n5|import (\n6|\t\"context\"\n7|\t\"os/exec\"\n8|\t\"syscall\"\n9|)\n10|\n11|// newCommandContext starts the plugin in its own process group so the\n12|// deadline kill reaches the whole tree: provider CLIs routinely spawn\n13|// children, and killing only the parent would leave grandchildren holding\n14|// the pipes open, hanging the wait past the deadline. A grandchild that\n15|// deliberately escapes with setsid is beyond this bound; see doc.go.\n16|func newCommandContext(ctx context.Context, executable string) *exec.Cmd {\n17|\tcommand := exec.CommandContext(ctx, executable)\n18|\tcommand.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n19|\tcommand.Cancel = func() error {\n20|\t\treturn syscall.Kill(-command.Process.Pid, syscall.SIGKILL)\n21|\t}\n22|\treturn command\n23|}"}}}
