{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cb","stream":{"kind":"session","id":"01a071e4-03f6-7fa0-b2ec-dd2af9ddca4b"},"sequence":192,"recorded_at":1780531400000379,"record_type":"event","durability":"durable","causation_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","run_stream":{"kind":"run","id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c"},"task_stream":{"kind":"task","id":"a5632038-d28b-469d-92e0-e07d1613082e"},"task_id":"a5632038-d28b-469d-92e0-e07d1613082e","event":{"kind":"output","task_id":"a5632038-d28b-469d-92e0-e07d1613082e","chunk":"Read text file `internal/provhost/runner.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"io\"\n7|\t\"os\"\n8|\t\"os/exec\"\n9|\t\"time\"\n10|)\n11|\n12|// waitDrainDelay bounds how long Wait lingers for pipe EOF after the\n13|// deadline kill before giving up on detached grandchildren.\n14|const waitDrainDelay = 2 * time.Second\n15|\n16|// stdoutCap bounds captured plugin stdout: one maximal frame, its line\n17|// terminator, and one probe byte, so a maximal frame followed by any\n18|// trailing byte is still distinguishable from a clean end. Anything\n19|// beyond is cut; the splitFrame length checks stay exact on the capped\n20|// capture.\n21|const stdoutCap = MaxFrameBytes + 2\n22|\n23|// Result is what a plugin process produced: captured stdout and stderr\n24|// and the process exit code. Stdout and stderr are kept separate end to\n25|// end: diagnostics never enter frame parsing, and frame bytes never\n26|// enter diagnostics. Captures are capped (stdout at one frame plus a\n27|// probe byte, stderr at StderrCapBytes); beyond the cap the stream is cut\n28|// and the failure is decided from what was captured, which the length\n29|// checks keep exact.\n30|type Result struct {\n31|\tStdout   []byte\n32|\tStderr   []byte\n33|\tExitCode int\n34|}\n35|\n36|// Runner starts one plugin process for one operation frame. Production\n37|// code supplies ExecRunner; tests supply a scripted fake. A Runner moves\n38|// bytes and reports process fate; it never parses frames and never\n39|// decides failures.\n40|type Runner interface {\n41|\tRun(ctx context.Context, executable string, stdin []byte) (Result, error)\n42|}\n43|\n44|// ExecRunner is the production Runner: it starts the trusted executable\n45|// discovered by internal/provider, writes exactly one frame to its stdin,\n46|// closes stdin, and waits under the caller's context. Environment and\n47|// stderr content never enter failure human text: Result carries the raw\n48|// streams, and failures built from a Result carry the failure class and\n49|// member names only, never content.\n50|type ExecRunner struct{}\n51|\n52|// Run starts executable with stdin on its stdin and captures both streams\n53|// with caps. A nil error with a nonzero exit code is an ordinary result:\n54|// a syntactically valid frame governs regardless of the exit status,\n55|// because SHOULD exit 0 is not MUST. A non-nil error means no result\n56|// could be judged: start failure, stream failure, context end, or a\n57|// wait failure with empty stdout and no known exit code. In\n58|// particular, a stdin write failure racing the plugin's exit never\n59|// discards a judgeable result on its own.\n60|func (ExecRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n61|\tcommand := newCommandContext(ctx, executable)\n62|\tcommand.WaitDelay = waitDrainDelay\n63|\tstdinPipe, err := command.StdinPipe()\n64|\tif err != nil {\n65|\t\treturn Result{}, err\n66|\t}\n67|\t// Stdout and stderr travel over pipes owned here, not over\n68|\t// StdoutPipe/StderrPipe: Wait closes those read ends after seeing\n69|\t// the process exit, which races a drain still in flight and\n70|\t// surfaces as \"file already closed\" on a valid frame. A pipe\n71|\t// created here is closed only by this function, so a drain never\n72|\t// loses to the wait.\n73|\tstdoutReader, stdoutWriter, err := os.Pipe()\n74|\tif err != nil {\n75|\t\treturn Result{}, err\n76|\t}\n77|\tdefer stdoutReader.Close()\n78|\tstderrReader, stderrWriter, err := os.Pipe()\n79|\tif err != nil {\n80|\t\tstdoutReader.Close()\n81|\t\treturn Result{}, err\n82|\t}\n83|\tdefer stderrReader.Close()\n84|\tcommand.Stdout = stdoutWriter\n85|\tcommand.Stderr = stderrWriter\n86|\tif err := command.Start(); err != nil {\n87|\t\tstdoutWriter.Close()\n88|\t\tstderrWriter.Close()\n89|\t\tstdoutReader.Close()\n90|\t\tstderrReader.Close()\n91|\t\treturn Result{}, err\n92|\t}\n93|\t// The parent's copies close at once: the child holds its own, so\n94|\t// EOF still means every writer is gone while no later Close can\n95|\t// interrupt a drain.\n96|\t_ = stdoutWriter.Close()\n97|\t_ = stderrWriter.Close()\n98|\t// Drain both streams while stdin is written: a plugin that answers\n99|\t// without reading stdin would otherwise deadlock against a full\n100|\t// pipe once either direction exceeds its buffer.\n101|\tstdoutDone := make(chan streamResult, 1)\n102|\tstderrDone := make(chan streamResult, 1)\n103|\tgo func() {\n104|\t\tdata, err := readCapped(stdoutReader, stdoutCap)\n105|\t\tstdoutDone <- streamResult{data: data, err: err}\n106|\t}()\n107|\tgo func() {\n108|\t\tdata, err := readCapped(stderrReader, StderrCapBytes)\n109|\t\tstderrDone <- streamResult{data: data, err: err}\n110|\t}()\n111|\twrote, writeErr := stdinPipe.Write(stdin)\n112|\tif writeErr == nil && wrote < len(stdin) {\n113|\t\twriteErr = io.ErrShortWrite\n114|\t}\n115|\tif writeErr == nil {\n116|\t\t_, writeErr = stdinPipe.Write([]byte{'\\n'})\n117|\t}\n118|\tcloseErr := stdinPipe.Close()\n119|\t// The wait and both drains run bounded by the call context. A\n120|\t// detached descendant that escapes the deadline group kill holds\n121|\t// the pipes open, and anything here that needs pipe EOF would\n122|\t// otherwise stay open for the descendant's whole lifetime\n123|\t// instead of ending at the deadline. Closing the read ends\n124|\t// fails the blocked drains at once; each drain sends exactly\n125|\t// once over a buffered channel, so no goroutine is left behind.\n126|\twaitDone := make(chan error, 1)\n127|\tgo func() {\n128|\t\twaitDone <- command.Wait()\n129|\t}()\n130|\tvar waitErr error\n131|\tselect {\n132|\tcase waitErr = <-waitDone:\n133|\t\tif ctx.Err() != nil {\n134|\t\t\t// The wait ended by deadline or cancellation: the\n135|\t\t\t// kill was already signaled, but a detached\n136|\t\t\t// grandchild may hold the pipes open past\n137|\t\t\t// WaitDelay. Close them rather than waiting for\n138|\t\t\t// streams that can no longer decide anything:\n139|\t\t\t// with the deadline gone there is no valid\n140|\t\t\t// response to read.\n141|\t\t\tstdoutReader.Close()\n142|\t\t\tstderrReader.Close()\n143|\t\t\t<-stdoutDone\n144|\t\t\t<-stderrDone\n145|\t\t\treturn Result{}, ctx.Err()\n146|\t\t}\n147|\tcase <-ctx.Done():\n148|\t\tstdoutReader.Close()\n149|\t\tstderrReader.Close()\n150|\t\t<-stdoutDone\n151|\t\t<-stderrDone\n152|\t\tif command.Process != nil {\n153|\t\t\t// Cancel targets the process group, which a\n154|\t\t\t// self-detached child escapes: kill the process\n155|\t\t\t// itself as well so the reap below cannot wait\n156|\t\t\t// on it. An already-reaped process reports an\n157|\t\t\t// error here that is safe to ignore.\n158|\t\t\t_ = command.Process.Kill()\n159|\t\t}\n160|\t\twaitErr = <-waitDone\n161|\t\treturn Result{}, ctx.Err()\n162|\t}\n163|\tstdoutResult, stderrResult, drained := collectDrains(ctx, stdoutReader, stderrReader, stdoutDone, stderrDone)\n164|\tif !drained {\n165|\t\t// The process exited but a detached descendant still\n166|\t\t// holds a pipe open past the deadline. The frame, if\n167|\t\t// any, was never fully delivered, so the deadline\n168|\t\t// decides: report the timeout rather than holding the\n169|\t\t// call open for the descendant's lifetime.\n170|\t\treturn Result{}, ctx.Err()\n171|\t}\n172|\tif stdoutResult.err != nil {\n173|\t\treturn Result{}, stdoutResult.err\n174|\t}\n175|\tif stderrResult.err != nil {\n176|\t\treturn Result{}, stderrResult.err\n177|\t}\n178|\tstdout := stdoutResult.data\n179|\tstderr := stderrResult.data\n180|\t// A stdin write failure after the process ran is still a result when\n181|\t// the process produced one: the frame may have arrived whole while\n182|\t// the write or close raced the plugin's exit. Report write, close,\n183|\t// and wait failures only when no result can be judged — empty\n184|\t// stdout with no known exit code — otherwise the frame governs,\n185|\t// and an empty stdout with a known exit code classifies the crash\n186|\t// through the returned Result instead of masking it as a transport\n187|\t// failure. Returning writeErr before stdout is ever considered\n188|\t// discards valid correlated frames on an EPIPE race.\n189|\texitCode := -1\n190|\tif command.ProcessState != nil {\n191|\t\texitCode = command.ProcessState.ExitCode()\n192|\t}\n193|\tif exit, ok := waitErr.(*exec.ExitError); ok {\n194|\t\texitCode = exit.ExitCode()\n195|\t}\n196|\tresult := Result{Stdout: stdout, Stderr: stderr, ExitCode: exitCode}\n197|\tif len(stdout) > 0 || command.ProcessState != nil {\n198|\t\treturn result, nil\n199|\t}\n200|\tif writeErr != nil {\n201|\t\treturn Result{}, writeErr\n202|\t}\n203|\tif closeErr != nil {\n204|\t\treturn Result{}, closeErr\n205|\t}\n206|\tif waitErr != nil {\n207|\t\treturn Result{}, waitErr\n208|\t}\n209|\treturn result, nil\n210|}\n211|\n212|// streamResult is one drained stream: the captured prefix and the\n213|// drain's own error, if the read failed before EOF.\n214|type streamResult struct {\n215|\tdata []byte\n216|\terr  error\n217|}\n218|\n219|// collectDrains gathers both stream captures, bounded by the call\n220|// context. When the deadline passes while a detached descendant still\n221|// holds a pipe open, the still-blocked read ends are closed so those\n222|// drains fail at once instead of holding the call open past its\n223|// deadline, and collectDrains reports false: the frame, if any, was\n224|// never fully delivered, so the caller lets the deadline decide\n225|// rather than judging a partial capture. Each drain channel is\n226|// received exactly once per still-pending drain, matching the single\n227|// buffered send of its goroutine.\n228|func collectDrains(ctx context.Context, stdoutReader, stderrReader *os.File, stdoutDone, stderrDone <-chan streamResult) (streamResult, streamResult, bool) {\n229|\tselect {\n230|\tcase stdout := <-stdoutDone:\n231|\t\tselect {\n232|\t\tcase stderr := <-stderrDone:\n233|\t\t\treturn stdout, stderr, true\n234|\t\tcase <-ctx.Done():\n235|\t\t\tstderrReader.Close()\n236|\t\t\tstderr := <-stderrDone\n237|\t\t\treturn stdout, stderr, false\n238|\t\t}\n239|\tcase <-ctx.Done():\n240|\t\tstdoutReader.Close()\n241|\t\tstderrReader.Close()\n242|\t\tstdout := <-stdoutDone\n243|\t\tstderr := <-stderrDone\n244|\t\treturn stdout, stderr, false\n245|\t}\n246|}\n247|\n248|// readCapped drains stream up to cap bytes and cuts the rest. Memory\n249|// stays bounded no matter what the plugin emits, and the splitFrame\n250|// length checks stay exact on the capped capture.\n251|func readCapped(stream io.Reader, cap int) ([]byte, error) {\n252|\tdata, err := io.ReadAll(io.LimitReader(stream, int64(cap)+1))\n253|\tif err != nil {\n254|\t\treturn nil, err\n255|\t}\n256|\tif len(data) > cap {\n257|\t\treturn data[:cap], nil\n258|\t}\n259|\treturn data, nil\n260|}\n261|\n262|// Host invokes provider plugins: one process per operation, one frame in,\n263|// one frame out, under the request deadline. Host keeps no cross-call\n264|// state, so successive calls are separate processes observing durable\n265|// state through the authority the caller passes.\n266|type Host struct {\n267|\t// Runner starts the plugin process. It must be set; a nil Runner is\n268|\t// a caller error, refused before any frame is built.\n269|\tRunner Runner\n270|\t// Now is the clock deadlines are checked against. Nil means the\n271|\t// system clock; tests supply a fixed instant.\n272|\tNow func() time.Time\n273|}\n274|\n275|func (host Host) now() time.Time {\n276|\tif host.Now == nil {\n277|\t\treturn time.Now()\n278|\t}\n279|\treturn host.Now()\n280|}\n281|\n282|// splitFrame separates the single response line from anything following\n283|// it. oversize reports a first line beyond MaxFrameBytes; extra reports\n284|// any bytes after the first line terminator. An empty line is neither:\n285|// it is a missing response, judged with the exit code by the caller.\n286|//\n287|// The checks are length-only and exact: stdout capture holds at most\n288|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n289|// trailing byte, is always visible in the captured length. No separate\n290|// truncation flag participates; a narrowed or dropped disjunct here\n291|// would be equivalent, not coverage.\n292|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n293|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n294|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n295|\t}\n296|\treturn captured, len(captured) > MaxFrameBytes, false\n297|}\n298|\n299|// Call dispatches one operation: it frames the request, starts one plugin\n300|// process, enforces the request deadline, and interprets the single\n301|// response frame. Encode failures return before the Runner is touched, so\n302|// an unknown operation never starts a process. A success envelope returns\n303|// its body; a failure envelope returns the bound child error; anything\n304|// else returns a local failure that trusts nothing from the plugin.\n305|//\n306|// Deadline accounting is exact: the wait ends under a context cut at the\n307|// request deadline, and provider_timeout is reported only when that\n308|// instant actually passed. A parent cancellation first, or any other\n309|// runner failure with time remaining, is provider_process_failed. An\n310|// empty stdout with time remaining is a missing response:\n311|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n312|// An empty stdout after the deadline passed is provider_timeout, and a\n313|// valid frame governs regardless of lateness or exit status.\n314|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n315|\tif host.Runner == nil {\n316|\t\tfailure, err := failInvalid(\"host has no runner\")\n317|\t\tif err != nil {\n318|\t\t\treturn Response{}, err\n319|\t\t}\n320|\t\treturn Response{}, failure\n321|\t}\n322|\tframe, deadline, err := encodeFrame(req, host.now())\n323|\tif err != nil {\n324|\t\treturn Response{}, err\n325|\t}\n326|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n327|\tdefer cancel()\n328|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n329|\tif err != nil {\n330|\t\tnow := host.now()\n331|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n332|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n333|\t\t\tif fault != nil {\n334|\t\t\t\treturn Response{}, fault\n335|\t\t\t}\n336|\t\t\treturn Response{}, failure\n337|\t\t}\n338|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n339|\t\tif fault != nil {\n340|\t\t\treturn Response{}, fault\n341|\t\t}\n342|\t\treturn Response{}, failure\n343|\t}\n344|\tline, oversize, extra := splitFrame(result.Stdout)\n345|\tif oversize {\n346|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n347|\t\tif fault != nil {\n348|\t\t\treturn Response{}, fault\n349|\t\t}\n350|\t\treturn Response{}, failure\n351|\t}\n352|\tif extra {\n353|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n354|\t\tif fault != nil {\n355|\t\t\treturn Response{}, fault\n356|\t\t}\n357|\t\treturn Response{}, failure\n358|\t}\n359|\tif len(line) == 0 {\n360|\t\t// No valid response arrived. When the request deadline passed,\n361|\t\t// this is the timeout even if the process also exited badly:\n362|\t\t// the host waited the full allowance and got nothing usable.\n363|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n364|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n365|\t\t\tif fault != nil {\n366|\t\t\t\treturn Response{}, fault\n367|\t\t\t}\n368|\t\t\treturn Response{}, failure\n369|\t\t}\n370|\t\tif result.ExitCode != 0 {\n371|\t\t\tfailure, fault := failProcess(\"plugin exited without a response\", nil)\n372|\t\t\tif fault != nil {\n373|\t\t\t\treturn Response{}, fault\n374|\t\t\t}\n375|\t\t\treturn Response{}, failure\n376|\t\t}\n377|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n378|\t\tif fault != nil {\n379|\t\t\treturn Response{}, fault\n380|\t\t}\n381|\t\treturn Response{}, failure\n382|\t}\n383|\treturn DecodeResponse(line, req.RequestID)\n384|}"}}}
