passing\n23|// unnoticed. The sweep judges verdicts against the independent\n24|// implementation, never against a shared hand-written expectation.\n25|//\n26|// The gate decides the surrogate-escape question only. Malformed\n27|// escapes and unterminated strings are not its verdict: they fall\n28|// through to the JSON-syntax arms that already own them. Non-UTF-8\n29|// bytes never reach it: decodeStrictObject refuses them first,\n30|// because a raw WTF-8 surrogate encoding would otherwise slip past\n31|// this escape scanner and be silently replaced with U+FFFD by\n32|// encoding/json. A lone high surrogate is a high unit not immediately\n33|// followed by a \\uDC00–\\uDFFF escape; a lone low surrogate is a low\n34|// unit in any other position. Both are refused before any member is\n35|// read.\n36|\n37|// hasLoneSurrogateEscape reports whether raw JSON bytes carry a lone\n38|// surrogate escape inside any string. The string walk mirrors the shared\n39|// package's walker (backslash handling included: a \\\\ escape consumes\n40|// both bytes, so the text \"\\\\ud800\" is backslash-plus-text, not an\n41|// escape), but only the surrogate verdict is returned.\n42|func hasLoneSurrogateEscape(input []byte) bool {\n43|\tfor index := 0; index < len(input); index++ {\n44|\t\tif input[index] != '\"' {\n45|\t\t\tcontinue\n46|\t\t}\n47|\t\tfor index++; index < len(input); index++ {\n48|\t\t\tif input[index] == '\"' {\n49|\t\t\t\tgoto stringComplete\n50|\t\t\t}\n51|\t\t\tif input[index] != '\\\\' {\n52|\t\t\t\tcontinue\n53|\t\t\t}\n54|\t\t\tindex++\n55|\t\t\tif index >= len(input) || input[index] != 'u' {\n56|\t\t\t\tcontinue\n57|\t\t\t}\n58|\t\t\tunit, end, ok := readHexUnit(input, index-1)\n59|\t\t\tif !ok {\n60|\t\t\t\t// Not a well-formed \\uXXXX escape: the\n61|\t\t\t\t// JSON-syntax arms own it, not this gate.\n62|\t\t\t\tcontinue\n63|\t\t\t}\n64|\t\t\tindex = end - 1\n65|\t\t\tif unit >= 0xd800 && unit <= 0xdbff {\n66|\t\t\t\tlow, lowEnd, ok := readHexUnit(input, end)\n67|\t\t\t\tif !ok || low < 0xdc00 || low > 0xdfff {\n68|\t\t\t\t\treturn true\n69|\t\t\t\t}\n70|\t\t\t\tindex = lowEnd - 1\n71|\t\t\t} else if unit >= 0xdc00 && unit <= 0xdfff {\n72|\t\t\t\treturn true\n73|\t\t\t}\n74|\t\t}\n75|\t\t// The string never closed: malformed JSON the syntax arms\n76|\t\t// refuse, so the gate claims no surrogate verdict here.\n77|\t\treturn false\n78|\tstringComplete:\n79|\t}\n80|\treturn false\n81|}\n82|\n83|// readHexUnit parses one \\uXXXX escape at input[start]. It reports false\n84|// when the bytes are not a well-formed escape; hex digits parse in\n85|// either case, matching the shared package's ParseUint base-16 read.\n86|func readHexUnit(input []byte, start int) (uint16, int, bool) {\n87|\tif start < 0 || start+6 > len(input) || input[start] != '\\\\' || input[start+1] != 'u' {\n88|\t\treturn 0, start, false\n89|\t}\n90|\tvar value uint16\n91|\tfor _, b := range input[start+2 : start+6] {\n92|\t\tvar digit byte\n93|\t\tif b >= '0' && b <= '9' {\n94|\t\t\tdigit = b - '0'\n95|\t\t} else if b >= 'a' && b <= 'f' {\n96|\t\t\tdigit = b - 'a' + 10\n97|\t\t} else if b >= 'A' && b <= 'F' {\n98|\t\t\tdigit = b - 'A' + 10\n99|\t\t} else {\n100|\t\t\treturn 0, start, false\n101|\t\t}\n102|\t\tvalue = value*16 + uint16(digit)\n103|\t}\n104|\treturn value, start + 6, true\n105|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3d5","stream":{"kind":"session","id":"01a071e4-03f6-7fa0-b2ec-dd2af9ddca4b"},"sequence":69,"recorded_at":1780531400000133,"record_type":"event","durability":"durable","causation_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","run_stream":{"kind":"run","id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c"},"call_id":"call_01a071e4278d7ec381e3a126df8c1969","text":"Read text file `internal/provhost/surrogate_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// TestProductionEntriesRefuseLoneSurrogateEscapes proves the Section 1.6\n13|// decoder rule at every production entry that reads a wire body: a lone\n14|// \\ud800-style escape is refused before any member is trusted, so the\n15|// silent U+FFFD replacement encoding/json would perform is never\n16|// observed. The bodies below are otherwise uninterpretable on purpose:\n17|// the gate runs before member validation, so refusal must not depend on\n18|// the members being present.\n19|func TestProductionEntriesRefuseLoneSurrogateEscapes(t *testing.T) {\n20|\tlone := []byte(`{\"note\":\"ab\\ud800cd\"}`)\n21|\trows := []struct {\n22|\t\tname string\n23|\t\terr  error\n24|\t}{\n25|\t\t{\"manifest\", DecodeManifest(lone)},\n26|\t\t{\"probe\", DecodeProbe(lone)},\n27|\t\t{\"identity\", CheckIdentity(lone, \"antigravity\")},\n28|\t\t{\"identify result\", DecodeIdentifyResult(lone, \"antigravity\")},\n29|\t\t{\"quiesce\", quiesceErr(lone)},\n30|\t\t{\"spawn plan\", DecodeSpawnPlan(lone, \"codex\", ProfileYOLO, scalar.PlatformLinux)},\n31|\t\t{\"response envelope\", func() error {\n32|\t\t\t_, err := DecodeResponse(successFrame(t, testRequestID, `{\"provider_id\":\"pi\",\"tag\":\"a\\ud800b\"}`), mustUUIDv7(t, testRequestID))\n33|\t\t\treturn err\n34|\t\t}()},\n35|\t}\n36|\tfor _, row := range rows {\n37|\t\tt.Run(row.name, func(t *testing.T) {\n38|\t\t\trequireFrameRefusal(t, row.err, \"\", \"lone surrogate escape\")\n39|\t\t})\n40|\t}\n41|\tt.Run(\"status outcome\", func(t *testing.T) {\n42|\t\tbody := strings.Replace(string(preparedBody()), `\"prepared\"`, `\"pre\\ud800pared\"`, 1)\n43|\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n44|\t\trequireIntegrityRefusal(t, err, \"status body is lone surrogate escape\", \"\")\n45|\t})\n46|}\n47|\n48|// TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON derives the\n49|// surrogate verdict space from the code-point space and requires the\n50|// local gate (through decodeStrictObject) and canonicaljson to agree\n51|// on every vector. A hand-written vector set shared between two\n52|// implementations is literal-versus-literal: it proves both\n53|// implementations match the same hand list, and a mutant that narrows\n54|// one bound (a low-surrogate ceiling, one hex case range) survives\n55|// every vector that avoids it. Here the inputs are enumerated from\n56|// the space and the verdicts come from the independent\n57|// implementation, so a narrowed bound diverges from the oracle on\n58|// every vector it newly admits, and an over-broad gate diverges on\n59|// every vector it newly refuses. A drift in either direction reddens\n60|// here with the divergent bodies.\n61|//\n62|// Dimensions, each fully enumerated: every BMP code unit as a\n63|// \\uXXXX escape in lower- and uppercase hex; every surrogate unit in\n64|// all 16 hex case permutations; every high surrogate paired with\n65|// boundary lows and non-low seconds; sampled units in member-name,\n66|// nested-object, and array positions plus every surrogate unit in\n67|// member-name position; every BMP code point as raw UTF-8 (surrogate\n68|// units in their raw WTF-8 three-byte form, which the UTF-8 gate in\n69|// decodeStrictObject must refuse); enumerated malformed byte\n70|// patterns; and astral raw samples. Every vector is a top-level\n71|// object so both judges can rule on it.\n72|func TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON(t *testing.T) {\n73|\tconst sweepFloor = 200000\n74|\tcompared := 0\n75|\tdivergent := 0\n76|\tvar examples []string\n77|\tcompare := func(body []byte) {\n78|\t\tcompared++\n79|\t\t_, canonicalErr := canonicaljson.Canonicalize(body)\n80|\t\t_, gateFault := decodeStrictObject(body)\n81|\t\tif (canonicalErr != nil) != (gateFault != nil) {\n82|\t\t\tdivergent++\n83|\t\t\tif len(examples) < 10 {\n84|\t\t\t\texamples = append(examples, fmt.Sprintf(\"%q canonical.refuse=%v gate.refuse=%v\", body, canonicalErr != nil, gateFault != nil))\n85|\t\t\t}\n86|\t\t}\n87|\t}\n88|\tescapeBody := func(prefix string, unit int, upper bool) []byte {\n89|\t\tformat := `{\"a\":\"` + prefix + `\\u%04x\"}`\n90|\t\tif upper {\n91|\t\t\tformat = `{\"a\":\"` + prefix + `\\u%04X\"}`\n92|\t\t}\n93|\t\treturn []byte(fmt.Sprintf(format, unit))\n94|\t}\n95|\t// Every BMP code unit as an escape, both hex cases.\n96|\tfor unit := 0; unit <= 0xffff; unit++ {\n97|\t\tcompare(escapeBody(\"\", unit, false))\n98|\t\tcompare(escapeBody(\"\", unit, true))\n99|\t}\n100|\t// Every surrogate unit in all 16 hex case permutations: a gate\n101|\t// that parses one case differently from the other must still\n102|\t// match the oracle on each mix.\n103|\tfor unit := 0xd800; unit <= 0xdfff; unit++ {\n104|\t\tdigits := fmt.Sprintf(\"%04x\", unit)\n105|\t\tfor mask := 0; mask < 16; mask++ {\n106|\t\t\tvar mixed [4]byte\n107|\t\t\tfor nibble := 0; nibble < 4; nibble++ {\n108|\t\t\t\tc := digits[nibble]\n109|\t\t\t\tif mask&(1<<nibble) != 0 && c >= 'a' && c <= 'f' {\n110|\t\t\t\t\tc -= 'a' - 'A'\n111|\t\t\t\t}\n112|\t\t\t\tmixed[nibble] = c\n113|\t\t\t}\n114|\t\t\tcompare([]byte(`{\"a\":\"\\u` + string(mixed[:]) + `\"}`))\n115|\t\t}\n116|\t}\n117|\t// Every high surrogate paired with boundary lows (valid) and\n118|\t// non-low seconds (lone).\n119|\tfor high := 0xd800; high <= 0xdbff; high++ {\n120|\t\tfor _, second := range []int{0xdc00, 0xdc01, 0xdfff, 0x0041, 0xd800} {\n121|\t\t\tcompare([]byte(fmt.Sprintf(`{\"a\":\"\\u%04x\\u%04x\"}`, high, second)))\n122|\t\t}\n123|\t}\n124|\t// Sampled units in every string position, plus every surrogate\n125|\t// unit in member-name position.\n126|\tfor unit := 0; unit <= 0xffff; unit += 64 {\n127|\t\tescaped := fmt.Sprintf(`\\u%04x`, unit)\n128|\t\tcompare([]byte(`{\"` + escaped + `\":1}`))\n129|\t\tcompare([]byte(`{\"a\":{\"b\":\"` + escaped + `\"}}`))\n130|\t\tcompare([]byte(`{\"a\":[\"` + escaped + `\"]}`))\n131|\t}\n132|\tfor unit := 0xd800; unit <= 0xdfff; unit++ {\n133|\t\tcompare([]byte(fmt.Sprintf(`{\"\\u%04x\":1}`, unit)))\n134|\t}\n135|\t// Every BMP code point as raw UTF-8. Surrogate units have no\n136|\t// UTF-8 encoding; their raw three-byte WTF-8 form is what the\n137|\t// decodeStrictObject UTF-8 gate must refuse.\n138|\tfor unit := 0; unit <= 0xffff; unit++ {\n139|\t\tbody := []byte(`{\"a\":\"`)\n140|\t\tswitch {\n141|\t\tcase unit >= 0xd800 && unit <= 0xdfff:\n142|\t\t\tbody = append(body, 0xe0|byte(unit>>12), 0x80|byte(unit>>6)&0x3f, 0x80|byte(unit)&0x3f)\n143|\t\tcase unit == '\"' || unit == '\\\\':\n144|\t\t\tbody = append(body, '\\\\', byte(unit))\n145|\t\tdefault:\n146|\t\t\tbody = append(body, string(rune(unit))...)\n147|\t\t}\n148|\t\tbody = append(body, `\"}`...)\n149|\t\tcompare(body)\n150|\t}\n151|\t// Enumerated malformed byte patterns inside a string.\n152|\tfor _, pattern := range [][]byte{\n153|\t\t{0xff}, {0xfe}, {0x80},\n154|\t\t{0xc0, 0xaf}, {0xe0, 0x80, 0xaf}, {0xf0, 0x80, 0x80, 0xaf},\n155|\t\t{0xf5, 0x80, 0x80, 0x80}, {0xe2, 0x82}, {0xf0, 0x9f, 0x98},\n156|\t\t{0xed, 0xa0, 0x80}, {0xed, 0xbf, 0xbf},\n157|\t} {\n158|\t\tbody := append([]byte(`{\"a\":\"`), pattern...)\n159|\t\tbody = append(body, `\"}`...)\n160|\t\tcompare(body)\n161|\t}\n162|\t// Astral raw samples, valid UTF-8 both judges accept.\n163|\tfor _, point := range []rune{0x10000, 0x1f600, 0x10ffff} {\n164|\t\tcompare([]byte(`{\"a\":\"` + string(point) + `\"}`))\n165|\t}\n166|\tif compared < sweepFloor {\n167|\t\tt.Fatalf(\"derived sweep compared %d vectors, below the %d floor; the enumeration is short, not the gate\", compared, sweepFloor)\n168|\t}\n169|\tif divergent != 0 {\n170|\t\tt.Fatalf(\"gate and canonicaljson diverge on %d of %d vectors, first %d:\\n  %s\", divergent, compared, len(examples), strings.Join(examples, \"\\n  \"))\n171|\t}\n172|\tt.Logf(\"surrogate sweep: gate agrees with canonicaljson on %d of %d vectors\", compared, compared)\n173|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
