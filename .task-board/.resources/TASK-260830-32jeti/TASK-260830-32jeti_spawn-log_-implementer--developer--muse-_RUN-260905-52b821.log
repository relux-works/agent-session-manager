{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c545","stream":{"kind":"session","id":"01a071e4-03f6-7fa0-b2ec-dd2af9ddca4b"},"sequence":253,"recorded_at":1780531400000501,"record_type":"event","durability":"durable","causation_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c","run_stream":{"kind":"run","id":"ade69f2b-bbb2-4158-ab5d-a5e12db94d0c"},"task_stream":{"kind":"task","id":"9c112809-78a6-4bb5-b773-82b11764455c"},"task_id":"9c112809-78a6-4bb5-b773-82b11764455c","event":{"kind":"output","task_id":"9c112809-78a6-4bb5-b773-82b11764455c","chunk":"Read text file `internal/provhost/runner_windows.go`.\n1|//go:build windows\n2|\n3|package provhost\n4|\n5|import (\n6|\t\"context\"\n7|\t\"os/exec\"\n8|)\n9|\n10|// newCommandContext is the Windows process start: the default\n11|// context kill applies to the direct child only. A child tree holding\n12|// the pipes past the kill is a stated bound on this platform; the wait\n13|// still ends via WaitDelay and the call still reports provider_timeout.\n14|func newCommandContext(ctx context.Context, executable string) *exec.Cmd {\n15|\treturn exec.CommandContext(ctx, executable)\n16|}"}}}
