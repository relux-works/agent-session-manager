ion\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by parent ID\\\"},{\\\"name\\\":\\\"assignee\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by assignee\\\"},{\\\"name\\\":\\\"blocked\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by hard or advisory blocked scheduling state\\\"}],\\\"examples\\\":[\\\"count()\\\",\\\"count(type=task, status=done)\\\"]},\\\"get\\\":{\\\"description\\\":\\\"Get a single element by ID\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\"}],\\\"examples\\\":[\\\"get(TASK-XX) { overview }\\\"]},\\\"list\\\":{\\\"description\\\":\\\"List elements with optional filters and pagination\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by parent ID\\\"},{\\\"name\\\":\\\"assignee\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by assignee\\\"},{\\\"name\\\":\\\"blocked\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by hard or advisory blocked scheduling state\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Number of items to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Maximum number of items to return\\\"}],\\\"examples\\\":[\\\"list(type=task, status=development) { overview }\\\",\\\"list(take=5) { minimal }\\\",\\\"list(type=sto