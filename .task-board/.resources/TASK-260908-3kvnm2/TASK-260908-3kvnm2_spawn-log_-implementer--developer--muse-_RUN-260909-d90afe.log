{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c577","stream":{"kind":"session","id":"01a086e5-19c2-72a1-a8e0-dd9212b1ae96"},"sequence":278,"recorded_at":1780531400000551,"record_type":"event","durability":"durable","causation_id":"98051fac-e595-413c-ab29-8cb5ece495f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98051fac-e595-413c-ab29-8cb5ece495f3","run_stream":{"kind":"run","id":"98051fac-e595-413c-ab29-8cb5ece495f3"},"task_stream":{"kind":"task","id":"eafed0a4-67c0-487f-8fe7-c788de642849"},"task_id":"eafed0a4-67c0-487f-8fe7-c788de642849","event":{"kind":"output","task_id":"eafed0a4-67c0-487f-8fe7-c788de642849","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260908-18woqo/worktree/internal/traceability/traceability.go`.\n1|// Package traceability verifies that the pinned AX specification inventory\n2|// remains bound to concrete production declarations and executable acceptance\n3|// cases. It is a read-only repository gate; it does not advertise runtime\n4|// capabilities or mutate implementation state.\n5|package traceability\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"crypto/sha256\"\n10|\t\"encoding/hex\"\n11|\t\"encoding/json\"\n12|\t\"errors\"\n13|\t\"fmt\"\n14|\t\"go/ast\"\n15|\t\"go/parser\"\n16|\t\"go/token\"\n17|\t\"io\"\n18|\t\"io/fs\"\n19|\t\"path\"\n20|\t\"regexp\"\n21|\t\"strings\"\n22|\t\"unicode\"\n23|\t\"unicode/utf8\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n29|)\n30|\n31|const (\n32|\townershipRegistryPath = \"internal/traceability/ownership.v0.5.0.json\"\n33|\tcontractLockPath      = \"internal/specpin/v0.5.0.lock.json\"\n34|\tcatalogMetadataPath   = \"internal/catalog/catalog.v0.5.0.json\"\n35|\tgeneratedCatalogPath  = \"internal/catalog/catalog_gen.go\"\n36|\n37|\townershipFormat        = \"ax-spec-to-code-ownership\"\n38|\townershipFormatVersion = 1\n39|\n40|\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\n41|\t// formatting may change, but ownership claims cannot be self-minted without\n42|\t// an explicit review of this binding.\n43|\treviewedOwnershipCanonicalSHA256 = \"caaca4c9b2d0a2ddb225810dba757807474230cf20e39cb3676c902f83fd9faa\"\n44|)\n45|\n46|var ErrTraceability = errors.New(\"spec-to-code traceability check failed\")\n47|\n48|// Report contains inventory coverage only. These counts do not claim that any\n49|// runtime capability is available, enabled, or supported.\n50|type Report struct {\n51|\tContracts              int\n52|\tNormativeSections      int\n53|\tAcceptanceCases        int\n54|\tFixtures               int\n55|\tCompatibilityContracts int\n56|\tAssignedScopes         int\n57|\n58|\t// SectionBindings and the coverage counters below are a measured ratio over\n59|\t// the registered section bindings, not a prose claim. NormativeClauses is\n60|\t// the number of RFC 2119 clause lines the pinned document itself carries in\n61|\t// the bound sections; DischargedClauses is how many of those a binding\n62|\t// enumerates with a verified excerpt and an acceptance owner.\n63|\tSectionBindings     int\n64|\tFullCoverage        int\n65|\tPartialCoverage     int\n66|\tSliverCoverage      int\n67|\tUnevidencedCoverage int\n68|\tUnmeasuredCoverage  int\n69|\tUnownedSections     int\n70|\tNormativeClauses    int\n71|\tDischargedClauses   int\n72|}\n73|\n74|type ownershipKind string\n75|\n76|const (\n77|\townershipContract         ownershipKind = \"contract\"\n78|\townershipNormativeSection ownershipKind = \"normative_section\"\n79|\townershipSectionBinding   ownershipKind = \"section_binding\"\n80|\townershipFixture          ownershipKind = \"fixture\"\n81|)\n82|\n83|type ownershipRegistry struct {\n84|\tFormat          string           `json:\"format\"`\n85|\tFormatVersion   int              `json:\"format_version\"`\n86|\tSource          registrySource   `json:\"source\"`\n87|\tAcceptanceCases []acceptanceCase `json:\"acceptance_cases\"`\n88|\tOwnership       []ownershipGroup `json:\"ownership\"`\n89|\tUnownedSections []unownedSection `json:\"unowned_sections\"`\n90|}\n91|\n92|// unownedSection records a real v0.5.0 section that this repository does not\n93|// implement. It exists so an unimplemented section is disclosed by name rather\n94|// than bound to a symbol from a neighbouring package, which is what an owned\n95|// key would otherwise assert. It is a disclosure, never an exemption: a section\n96|// the generated catalog requires an owner for may not be declared here, and\n97|// assigned-scope admission refuses an unowned section and prints its gap.\n98|type unownedSection struct {\n99|\tKey      string `json:\"key\"`\n100|\tGap      string `json:\"gap\"`\n101|\tEvidence string `json:\"evidence\"`\n102|}\n103|\n104|type registrySource struct {\n105|\tRepository     string `json:\"repository\"`\n106|\tRelease        string `json:\"release\"`\n107|\tCommit         string `json:\"commit\"`\n108|\tDocumentPath   string `json:\"document_path\"`\n109|\tDocumentSHA256 string `json:\"document_sha256\"`\n110|}\n111|\n112|type acceptanceCase struct {\n113|\tID         string          `json:\"id\"`\n114|\tProduction codeReference   `json:\"production\"`\n115|\tTests      []codeReference `json:\"tests\"`\n116|}\n117|\n118|type ownershipGroup struct {\n119|\tKind            ownershipKind      `json:\"kind\"`\n120|\tKeys            []string           `json:\"keys\"`\n(more lines below)"}}}
