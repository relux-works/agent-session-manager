{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c46f","stream":{"kind":"session","id":"01a086e5-19c2-72a1-a8e0-dd9212b1ae96"},"sequence":146,"recorded_at":1780531400000287,"record_type":"event","durability":"durable","causation_id":"98051fac-e595-413c-ab29-8cb5ece495f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98051fac-e595-413c-ab29-8cb5ece495f3","run_stream":{"kind":"run","id":"98051fac-e595-413c-ab29-8cb5ece495f3"},"task_stream":{"kind":"task","id":"3a9ebc37-eb1f-4041-8a49-156b92df5395"},"task_id":"3a9ebc37-eb1f-4041-8a49-156b92df5395","event":{"kind":"output","task_id":"3a9ebc37-eb1f-4041-8a49-156b92df5395","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260908-18woqo/worktree/internal/specdoc/specdoc_test.go`.\n1|package specdoc_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"errors\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n13|)\n14|\n15|func TestLoadAcceptsOnlyThePinnedDocumentDigest(t *testing.T) {\n16|\tt.Parallel()\n17|\n18|\tdocument, err := specdoc.Load()\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"Load() error = %v\", err)\n21|\t}\n22|\tdigest := sha256.Sum256(specdoc.Bytes())\n23|\tif got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256 {\n24|\t\tt.Fatalf(\"embedded document digest = %s, want pinned %s\", got, specpin.DocumentSHA256)\n25|\t}\n26|\tif document.LineCount() < 1000 {\n27|\t\tt.Fatalf(\"pinned document has %d lines, want the full specification\", document.LineCount())\n28|\t}\n29|}\n30|\n31|// TestParseRefusesEveryNonPinnedDocument is the anti-vacuity proof for the\n32|// digest gate. A comparison against a swapped specification would confirm\n33|// whatever that swapped text happens to say, so every perturbation must be\n34|// refused rather than parsed.\n35|func TestParseRefusesEveryNonPinnedDocument(t *testing.T) {\n36|\tt.Parallel()\n37|\n38|\tpinned := specdoc.Bytes()\n39|\n40|\tappended := append(bytes.Clone(pinned), '\\n')\n41|\ttruncated := bytes.Clone(pinned)[:len(pinned)-1]\n42|\n43|\tperturbed := bytes.Clone(pinned)\n44|\tindex := bytes.Index(perturbed, []byte(\"urn:ax:schema:blob\"))\n45|\tif index < 0 {\n46|\t\tt.Fatal(\"pinned document does not contain the Blob Descriptor schema identifier\")\n47|\t}\n48|\tperturbed[index] = 'U'\n49|\n50|\twhitespaceOnly := bytes.Clone(pinned)\n51|\tspace := bytes.IndexByte(whitespaceOnly, ' ')\n52|\tif space < 0 {\n53|\t\tt.Fatal(\"pinned document contains no space byte\")\n54|\t}\n55|\twhitespaceOnly[space] = '\\t'\n56|\n57|\tfor _, test := range []struct {\n58|\t\tname      string\n59|\t\tcandidate []byte\n60|\t}{\n61|\t\t{name: \"absent\", candidate: nil},\n62|\t\t{name: \"empty\", candidate: []byte{}},\n63|\t\t{name: \"truncated read\", candidate: truncated},\n64|\t\t{name: \"appended byte\", candidate: appended},\n65|\t\t{name: \"single character substitution\", candidate: perturbed},\n66|\t\t{name: \"whitespace-only substitution\", candidate: whitespaceOnly},\n67|\t\t{name: \"unrelated document\", candidate: []byte(\"# Not the specification\\n\")},\n68|\t} {\n69|\t\tt.Run(test.name, func(t *testing.T) {\n70|\t\t\tt.Parallel()\n71|\t\t\tif _, err := specdoc.Parse(test.candidate); !errors.Is(err, specdoc.ErrDocumentMismatch) {\n72|\t\t\t\tt.Fatalf(\"Parse(%s) error = %v, want ErrDocumentMismatch\", test.name, err)\n73|\t\t\t}\n74|\t\t})\n75|\t}\n76|}\n77|\n78|func TestQuoteLinesFindsWrappedTextAtItsStartingLine(t *testing.T) {\n79|\tt.Parallel()\n80|\n81|\tdocument, err := specdoc.Load()\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"Load() error = %v\", err)\n84|\t}\n85|\n86|\t// A quote that the specification hard-wraps across two lines must resolve\n87|\t// to the line where it starts, otherwise every wrapped excerpt would have\n88|\t// to be shortened until it fit one line.\n89|\tconst wrapped = \"Every transferred blob has a Blob Descriptor with schema <code>urn:ax:schema:blob</code> version <code>1.0.0</code>.\"\n90|\tlines := document.QuoteLines(wrapped)\n91|\tif len(lines) != 1 {\n92|\t\tt.Fatalf(\"QuoteLines(wrapped) = %v, want exactly one line\", lines)\n93|\t}\n94|\tline, ok := document.Line(lines[0])\n95|\tif !ok || !strings.Contains(line, \"Every transferred blob has a Blob Descriptor\") {\n96|\t\tt.Fatalf(\"line %d = %q, want the wrapped quote's first line\", lines[0], line)\n97|\t}\n98|\tif _, ok := document.Line(lines[0] + 1); !ok {\n99|\t\tt.Fatalf(\"line %d has no successor, the quote cannot wrap\", lines[0])\n100|\t}\n101|}\n102|\n103|func TestLineRefusesOutOfRangeNumbers(t *testing.T) {\n104|\tt.Parallel()\n105|\n106|\tdocument, err := specdoc.Load()\n107|\tif err != nil {\n108|\t\tt.Fatalf(\"Load() error = %v\", err)\n109|\t}\n110|\t// A paraphrase that names a line outside the document must be reported as\n111|\t// absent rather than silently resolving to some other line.\n112|\tfor _, number := range []int{0, -1, document.LineCount() + 1, 1 << 30} {\n113|\t\tif text, ok := document.Line(number); ok {\n114|\t\t\tt.Errorf(\"Line(%d) = %q, true; want not found\", number, text)\n115|\t\t}\n116|\t}\n117|\tif _, ok := document.Line(1); !ok {\n118|\t\tt.Fatal(\"Line(1) is not readable\")\n119|\t}\n120|\tif _, ok := document.Line(document.LineCount()); !ok {\n121|\t\tt.Fatal(\"the last line is not readable\")\n122|\t}\n123|}\n124|\n125|func TestQuoteLinesRefusesAbsentAndEmptyText(t *testing.T) {\n126|\tt.Parallel()\n127|\n128|\tdocument, err := specdoc.Load()\n129|\tif err != nil {\n130|\t\tt.Fatalf(\"Load() error = %v\", err)\n131|\t}\n132|\tfor _, text := range []string{\n133|\t\t\"\",\n134|\t\t\"   \\n\\t \",\n135|\t\t\"Every transferred blob has a Blob Descriptor with schema <code>urn:ax:schema:digest</code>\",\n136|\t\t\"the quoted word digest reached the Pinned SPEC declaration column\",\n137|\t} {\n138|\t\tif lines := document.QuoteLines(text); len(lines) != 0 {\n139|\t\t\tt.Errorf(\"QuoteLines(%q) = %v, want no match\", text, lines)\n140|\t\t}\n141|\t\tif document.Contains(text) {\n142|\t\t\tt.Errorf(\"Contains(%q) = true, want false\", text)\n143|\t\t}\n144|\t}\n145|}\n146|\n147|// TestNormalizeForgivesOnlyWhitespace pins the normalization rule. A looser\n148|// rule would let an excerpt match text the specification does not contain.\n149|func TestNormalizeForgivesOnlyWhitespace(t *testing.T) {\n150|\tt.Parallel()\n151|\n152|\tfor _, test := range []struct {\n153|\t\tname  string\n154|\t\tinput string\n155|\t\twant  string\n156|\t}{\n157|\t\t{name: \"wrapped\", input: \"sorted,\\ncontiguous\", want: \"sorted, contiguous\"},\n158|\t\t{name: \"table indent\", input: \"  | `a` |  `b` |  \", want: \"| `a` | `b` |\"},\n159|\t\t{name: \"tabs and returns\", input: \"a\\t\\r\\nb\", want: \"a b\"},\n160|\t\t{name: \"runs collapse\", input: \"a      b\", want: \"a b\"},\n161|\t\t{name: \"case preserved\", input: \"MUST Be\", want: \"MUST Be\"},\n162|\t\t{name: \"punctuation preserved\", input: \"uint53[1..4194304];\", want: \"uint53[1..4194304];\"},\n163|\t\t{name: \"markup preserved\", input: \"<code>size</code>\", want: \"<code>size</code>\"},\n164|\t} {\n165|\t\tif got := specdoc.Normalize(test.input); got != test.want {\n166|\t\t\tt.Errorf(\"Normalize(%s) = %q, want %q\", test.name, got, test.want)\n167|\t\t}\n168|\t}\n169|\n170|\tdocument, err := specdoc.Load()\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"Load() error = %v\", err)\n173|\t}\n174|\t// Case, punctuation, and markup differences must not be normalized away.\n175|\tfor _, text := range []string{\n176|\t\t\"every transferred blob has a blob descriptor\",\n177|\t\t\"Every transferred blob has a Blob Descriptor with schema urn:ax:schema:blob\",\n178|\t\t\"Every transferred blob has a Blob Descriptor with schema `urn:ax:schema:blob`\",\n179|\t} {\n180|\t\tif document.Contains(text) {\n181|\t\t\tt.Errorf(\"Contains(%q) = true; normalization is too loose\", text)\n182|\t\t}\n183|\t}\n184|}\n185|\n186|// TestQuoteLinesRefusesTextThatSpansABlankLine pins the blank-line boundary of\n187|// the normalization rule. Collapsing every whitespace run to one space also\n188|// collapsed blank lines, so a \"verbatim\" excerpt could stitch the tail of one\n189|// block to the head of the next and still be reported as quoting the pinned\n190|// document. That is exactly the looseness the excerpt gate exists to refuse.\n191|//\n192|// The stitched text below is real: both halves are verbatim SPEC.md, taken from\n193|// the two blocks that meet at line 4613 and 4615. It must not match, while each\n194|// half on its own must.\n195|func TestQuoteLinesRefusesTextThatSpansABlankLine(t *testing.T) {\n196|\tt.Parallel()\n197|\n198|\tdocument, err := specdoc.Load()\n199|\tif err != nil {\n200|\t\tt.Fatalf(\"Load() error = %v\", err)\n201|\t}\n202|\n203|\tconst (\n204|\t\tbefore   = \"sorted, contiguous, non-overlapping, start at offset zero, and cover exactly <code>size</code> bytes:\"\n205|\t\tafter    = \"The descriptor is closed and contains exactly <code>schema</code>\"\n206|\t\tstitched = before + \" \" + after\n207|\t)\n208|\n209|\tif lines := document.QuoteLines(before); len(lines) == 0 {\n210|\t\tt.Fatalf(\"the block before the blank line is not quotable; the fixture is stale\")\n211|\t}\n212|\tif lines := document.QuoteLines(after); len(lines) == 0 {\n213|\t\tt.Fatalf(\"the block after the blank line is not quotable; the fixture is stale\")\n214|\t}\n215|\tif lines := document.QuoteLines(stitched); len(lines) != 0 {\n216|\t\tt.Fatalf(\"text spanning a blank line matched at %v; a quote may not stitch two blocks\", lines)\n217|\t}\n218|\tif document.Contains(stitched) {\n219|\t\tt.Fatal(\"Contains admitted text spanning a blank line\")\n220|\t}\n221|}\n222|\n223|// TestNormalizeNeverEmitsTheBlockSeparator is why the boundary above holds. The\n224|// document projection separates blocks with a byte no normalized excerpt can\n225|// produce, so the refusal is structural rather than a special case in the\n226|// caller.\n227|func TestNormalizeNeverEmitsTheBlockSeparator(t *testing.T) {\n228|\tt.Parallel()\n229|\n230|\tfor _, text := range []string{\n231|\t\t\"one\\n\\ntwo\",\n232|\t\t\"one\\n \\n\\t\\n two\",\n233|\t\t\"\\n\\n\\n\",\n234|\t\t\"one\\ntwo\",\n235|\t\t\"  leading and trailing  \",\n236|\t} {\n237|\t\tif strings.ContainsRune(specdoc.Normalize(text), specdoc.BlockSeparator) {\n238|\t\t\tt.Fatalf(\"Normalize(%q) emitted the block separator\", text)\n239|\t\t}\n240|\t}\n241|\tif got, want := specdoc.Normalize(\"one\\n\\ntwo\"), \"one two\"; got != want {\n242|\t\tt.Fatalf(\"Normalize collapsed a blank line to %q, want %q\", got, want)\n243|\t}\n244|}\n245|\n246|// TestSectionIDResolvesTheEnclosingNumberedClause pins the clause resolver the\n247|// enumeration's shape anchor depends on. A resolver that answered \"\" for a\n248|// whole region, or that let an unnumbered subheading open a clause, would let a\n249|// foreign citation through by accident rather than by rule.\n250|func TestSectionIDResolvesTheEnclosingNumberedClause(t *testing.T) {\n251|\tt.Parallel()\n252|\n253|\tdocument, err := specdoc.Load()\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"Load() error = %v\", err)\n256|\t}\n257|\n258|\tfor _, test := range []struct {\n259|\t\tline int\n260|\t\twant string\n261|\t}{\n262|\t\t{line: 4622, want: \"10.2\"}, // BlobChunk's size clause\n263|\t\t{line: 4746, want: \"10.4\"}, // ManifestEntry.file's row\n264|\t\t{line: 1908, want: \"5.3\"},  // Lease Record reason\n265|\t\t{line: 363, want: \"2.1\"},   // Terms table name grammar\n266|\t\t{line: 1471, want: \"5.1\"},  // Session Record name row\n267|\t} {\n268|\t\tgot, ok := document.SectionID(test.line)\n269|\t\tif !ok || got != test.want {\n270|\t\t\tt.Errorf(\"SectionID(%d) = %q, %v; want %q\", test.line, got, ok, test.want)\n271|\t\t}\n272|\t}\n273|\n274|\t// Out of range fails closed rather than resolving to some other clause.\n275|\tfor _, number := range []int{0, -1, document.LineCount() + 1} {\n276|\t\tif id, ok := document.SectionID(number); ok {\n277|\t\t\tt.Errorf(\"SectionID(%d) = %q, true; want not found\", number, id)\n278|\t\t}\n279|\t}\n280|\n281|\t// The title line precedes every numbered clause and must resolve to none.\n282|\tif id, ok := document.SectionID(1); ok {\n283|\t\tt.Errorf(\"SectionID(1) = %q, true; the document title opens no clause\", id)\n284|\t}\n285|\n286|\t// An unnumbered subheading does not open a clause: its body stays inside the\n287|\t// numbered clause above it, which is the clause a citation belongs to.\n288|\tvar unnumbered int\n289|\tfor number := 1; number <= document.LineCount(); number++ {\n290|\t\tline, _ := document.Line(number)\n291|\t\tif strings.HasPrefix(line, \"#### Managed Replica Marker document\") {\n292|\t\t\tunnumbered = number\n293|\t\t\tbreak\n294|\t\t}\n295|\t}\n296|\tif unnumbered == 0 {\n297|\t\tt.Fatal(\"the unnumbered-subheading fixture is stale\")\n298|\t}\n299|\tabove, aboveOK := document.SectionID(unnumbered - 1)\n300|\tat, atOK := document.SectionID(unnumbered)\n301|\tif !aboveOK || !atOK || above != at {\n302|\t\tt.Fatalf(\"an unnumbered subheading changed the clause from %q to %q\", above, at)\n303|\t}\n304|\n305|\t// Nearly every line of the document belongs to some clause; a resolver that\n306|\t// silently answered \"\" would disable the anchor without failing anything.\n307|\tunresolved := 0\n308|\tfor number := 1; number <= document.LineCount(); number++ {\n309|\t\tif _, ok := document.SectionID(number); !ok {\n310|\t\t\tunresolved++\n311|\t\t}\n312|\t}\n313|\tif unresolved > 32 {\n314|\t\tt.Fatalf(\"%d of %d lines resolve to no clause; the anchor would be mostly inert\",\n315|\t\t\tunresolved, document.LineCount())\n316|\t}\n317|}\n318|\n319|// TestQuoteLinesRefusesTextThatSpansTwoTableRows pins the second hard boundary.\n320|// A Markdown table row is a complete line by construction, so no honest excerpt\n321|// spans two of them, while a stitched one is individually verbatim on both\n322|// halves and silently imports the next row's constraint. Collapsing that newline\n323|// to a space admitted exactly that.\n324|func TestQuoteLinesRefusesTextThatSpansTwoTableRows(t *testing.T) {\n325|\tt.Parallel()\n326|\n327|\tdocument, err := specdoc.Load()\n328|\tif err != nil {\n329|\t\tt.Fatalf(\"Load() error = %v\", err)\n330|\t}\n331|\n332|\tconst (\n333|\t\trow      = \"| <code>holder_host_id</code> | UUIDv7 | Proposed owner |\"\n334|\t\tnext     = \"| <code>predecessor_lease_id</code> | UUIDv4 or null | Null only at epoch 1 |\"\n335|\t\tstitched = row + \" \" + next\n336|\t)\n337|\n338|\trowLines := document.QuoteLines(row)\n339|\tif len(rowLines) == 0 {\n340|\t\tt.Fatal(\"the table row is not quotable on its own; the fixture is stale\")\n341|\t}\n342|\tif lines := document.QuoteLines(next); len(lines) == 0 {\n343|\t\tt.Fatal(\"the following table row is not quotable on its own; the fixture is stale\")\n344|\t}\n345|\tif lines := document.QuoteLines(stitched); len(lines) != 0 {\n346|\t\tt.Fatalf(\"text spanning two table rows matched at %v; a quote may not stitch two rows\", lines)\n347|\t}\n348|\tif document.Contains(stitched) {\n349|\t\tt.Fatal(\"Contains admitted text spanning two table rows\")\n350|\t}\n351|}\n352|\n353|// TestQuoteLinesStillForgivesHardWrappingInsideOneParagraph is the other half of\n354|// the pair. A boundary check that refused every newline would pass the test\n355|// above while making the whole comparison useless, because the pinned document\n356|// hard-wraps its prose.\n357|func TestQuoteLinesStillForgivesHardWrappingInsideOneParagraph(t *testing.T) {\n358|\tt.Parallel()\n359|\n360|\tdocument, err := specdoc.Load()\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"Load() error = %v\", err)\n363|\t}\n364|\n365|\twrapped := 0\n366|\tfor number := 1; number < document.LineCount(); number++ {\n367|\t\tabove, _ := document.Line(number)\n368|\t\tbelow, _ := document.Line(number + 1)\n369|\t\tif strings.TrimSpace(above) == \"\" || strings.TrimSpace(below) == \"\" {\n370|\t\t\tcontinue\n371|\t\t}\n372|\t\tif strings.HasPrefix(strings.TrimSpace(above), \"|\") || strings.HasPrefix(strings.TrimSpace(below), \"|\") {\n373|\t\t\tcontinue\n374|\t\t}\n375|\t\tif strings.HasPrefix(strings.TrimSpace(above), \"#\") || strings.HasPrefix(strings.TrimSpace(below), \"#\") {\n376|\t\t\tcontinue\n377|\t\t}\n378|\t\tstitched := strings.TrimSpace(above) + \"\\n\" + strings.TrimSpace(below)\n379|\t\tif !document.Contains(stitched) {\n380|\t\t\tt.Fatalf(\"hard-wrapped prose at lines %d-%d is no longer quotable as one excerpt\", number, number+1)\n381|\t\t}\n382|\t\twrapped++\n383|\t\tif wrapped >= 200 {\n384|\t\t\tbreak\n385|\t\t}\n386|\t}\n387|\tif wrapped < 200 {\n388|\t\tt.Fatalf(\"checked only %d wrapped prose boundaries, want a broad sample\", wrapped)\n389|\t}\n390|}\n391|\n392|// TestTableRowAtNamesWhatEachRowDeclares pins the index the enumeration's\n393|// declaring-row anchor reads. A header or delimiter line declares nothing of its\n394|// own, and must not be reported as a declaration a citation could anchor to.\n395|func TestTableRowAtNamesWhatEachRowDeclares(t *testing.T) {\n396|\tt.Parallel()\n397|\n398|\tdocument, err := specdoc.Load()\n399|\tif err != nil {\n400|\t\tt.Fatalf(\"Load() error = %v\", err)\n401|\t}\n402|\n403|\tfor _, test := range []struct {\n404|\t\tline       int\n405|\t\tok         bool\n406|\t\theader     string\n407|\t\tidentifier string\n408|\t}{\n409|\t\t{line: 1908, ok: true, header: \"Field\", identifier: \"reason\"},\n410|\t\t{line: 4788, ok: true, header: \"Type\", identifier: \"GitHead\"},\n411|\t\t{line: 4791, ok: true, header: \"Type\", identifier: \"GitIndexEntry\"},\n412|\t\t{line: 4785, ok: false},\n413|\t\t{line: 4786, ok: false},\n414|\t\t{line: 1, ok: false},\n415|\t\t{line: 0, ok: false},\n416|\t\t{line: document.LineCount() + 1, ok: false},\n417|\t} {\n418|\t\trow, ok := document.TableRowAt(test.line)\n419|\t\tif ok != test.ok {\n420|\t\t\tt.Fatalf(\"TableRowAt(%d) ok = %v, want %v (row %+v)\", test.line, ok, test.ok, row)\n421|\t\t}\n422|\t\tif !test.ok {\n423|\t\t\tcontinue\n424|\t\t}\n425|\t\tif row.Header != test.header || row.Identifier != test.identifier || row.Line != test.line {\n426|\t\t\tt.Fatalf(\"TableRowAt(%d) = %+v, want header %q identifier %q\", test.line, row, test.header, test.identifier)\n427|\t\t}\n428|\t}\n429|}"}}}
