nal/specpin/ -count=1 -run 'TestVerifyV060RejectsPartialMalformedAndByteDifferentReads' 2>&1 | tail -4\\necho \\\"--- full package (only the named member may fail):\\\"; go test ./internal/specpin/ -count=1 2>&1 | tail -3\\ncp /tmp/pin.go.bak internal/specpin/pin.go\\ngit diff --quiet -- internal/specpin/pin.go && echo \\\"M1-RESTORED\\\" || echo \\\"M1-RESTORE-FAILED\\\"\\n\\necho \\\"=== M2: VerifyV060 identity+digest narrowed to admit exactly the stale-commit member (v0.6.0 tokens preserved) ===\\\"\\ncp internal/specpin/pin.go /tmp/pin.go.bak\\npython3 - \\\"$STALE_DIGEST\\\" <<'PY'\\nimport sys\\nt = open('internal/specpin/pin.go').read()\\nold1 = 'source.TagObject != TagObjectV060 || source.Commit != CommitV060 ||'\\nassert t.count(old1) == 1\\nt = t.replace(old1, 'source.TagObject != TagObjectV060 || (source.Commit != CommitV060 && source.Commit != CommitV050) ||')\\nold2 = 'digest := sha256.Sum256(candidate)\\\\n\\\\tif hex.EncodeToString(digest[:]) != ManifestSHA256V060 {'\\nassert t.count(old2) == 1\\nt = t.replace(old2, 'digest := sha256.Sum256(candidate)\\\\n\\\\tif got := hex.EncodeToString(digest[:]); got != ManifestSHA256V060 && got != \\\"%s\\\" {' % sys.argv[1])\\nopen('internal/specpin/pin.go','w').write(t)\\nPY\\necho \\\"--- named test (must FAIL):\\\"; go test ./internal/specpin/ -count=1 -run 'TestVerifyV060RejectsWrongSourceHashAndVersionEvidence/stale_commit_keeps_v0_6_0_tokens' 2>&1 | tail -3\\necho \\\"--- full package incl. behavioral cross-version tests:\\\"; go test ./internal/specpin/ -count=1 -v 2>&1 | grep -cE \\\"^--- PASS\\\"; go test ./internal/specpin/ -count=1 -v 2>&1 | grep -E \\\"^--- FAIL\\\" | head -5\\ncp /tmp/pin.go.bak internal/specpin/pin.go\\ngit diff --quiet -- internal/specpin/pin.go && echo \\\"M2-RESTORED\\\" || echo \\\"M2-RESTORE-FAILED\\\"\\n\\necho \\\"=== M3: ParseV060 narrowed to also accept the stale v0.5.0 document digest ===\\\"\\ncp internal/specdoc/specdoc.go /tmp/specdoc.go.bak\\npython3 - <<'PY'\\nt = open('internal/specdoc/specdoc.go').read()\\nold = 'if got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256V060 {'\\nassert t.count(old) == 1\\nt = t.replace(old, 'if got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256V060 && got != specpin.DocumentSHA256 {')\\nopen('internal/specdoc/specdoc.go','w').write(t)\\nPY\\necho \\\"--- named test (must FAIL):\\\"; go test ./internal/specdoc/ -count=1 -run 'TestParseV060RefusesEveryNonAdoptedDocument/stale_v0_5_0_document' 2>&1 | tail -3\\necho \\\"--- full package incl. behavioral QuoteLines/SectionID tests:\\\"; go test ./internal/specdoc/ -count=1 -v 2>&1 | grep -cE \\\"^--- PASS\\\"; go test ./internal/specdoc/ -count=1 -v 2>&1 | grep -E \\\"^--- FAIL\\\" | head -5\\ncp /tmp/specdoc.go.bak internal/specdoc/specdoc.go\\ngit diff --quiet -- internal/specdoc/specdoc.go && echo \\\"M3-RESTORED\\\" || echo \\\"M3-RESTORE-FAILED\\\"\\n\\necho \\\"=== M4 (token-preserving): delta-row check keeps Name+ID tokens, drops Versions; digest admits exactly the trimmed-config member ===\\\"\\ncp internal/specpin/pin.go /tmp/pin.go.bak\\npython3 - \\\"$TRIM_DIGEST\\\" <<'PY'\\nimport sys\\nt = open('internal/specpin/pin.go').read()\\nold1 = 'if contractKey(row) == contractKey(contract) && reflect.DeepEqual(row.Versions, contract.Versions) {'\\nassert t.count(old1) == 1\\nt = t.replace(old1, 'if contractKey(row) == contractKey(contract) {')\\nold2 = 'digest := sha256.Sum256(candidate)\\\\n\\\\tif hex.EncodeToString(digest[:]) != ManifestSHA256V060 {'\\nassert t.count(old2) == 1\\nt = t.replace(old2, 'digest := sha256.Sum256(candidate)\\\\n\\\\tif got := hex.EncodeToString(digest[:]); got != ManifestSHA256V060 && got != \\\"%s\\\" {' % sys.argv[1])\\nopen('internal/specpin/pin.go','w').write(t)\\nPY\\necho \\\"--- named test (must FAIL):\\\"; go test ./internal/specpin/ -count=1 -run 'TestVerifyV060RejectsWrongSourceHashAndVersionEvidence/trimmed_configuration_delta' 2>&1 | tail -3\\necho \\\"--- full package:\\\"; go test ./internal/specpin/ -count=1 -v 2>&1 | grep -cE \\\"^--- PASS\\\"; go test ./internal/specpin/ -count=1 -v 2>&1 | grep -E \\\"^--- FAIL\\\" | head -5\\ncp /tmp/pin.go.bak internal/specpin/pin.go\\ngit diff --quiet -- internal/specpin/pin.go && echo \\\"M4-RESTORED\\\" || echo \\\"M4-RESTORE-FAILED\\\"\\n} 2>&1 | tee \\\"$log\\\"\\necho \\\"battery-exit=$?\\\"\\nEOF\\nbash .temp/TASK-260908-3kvnm2/mutants.sh .temp/TASK-260908-3kvnm2/mutant-battery.log 2>&1 | tail -40\",\n  \"description\": \"Run narrowing mutant battery\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \".temp/TASK-260908-3kvnm2/mutants.sh: line 77: log: unbound variable\\nbattery-exit=1\\n\",\n  \"original_output_bytes\": 83,\n  \"original_output_tokens\": 21,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
