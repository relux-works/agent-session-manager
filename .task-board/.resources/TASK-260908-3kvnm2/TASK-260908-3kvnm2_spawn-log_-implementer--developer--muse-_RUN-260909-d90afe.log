ase)\n+\t\t}\n+\t\treturn cloneContracts(manifest.Contracts), nil\n+\tcase ReleaseV050:\n+\t\tif manifest.Source.Release == ReleaseV060 {\n+\t\t\treturn derivedV050Contracts(manifest)\n+\t\t}\n+\t\treturn cloneContracts(manifest.Contracts), nil\n+\tcase ReleaseV043:\n"}}}
