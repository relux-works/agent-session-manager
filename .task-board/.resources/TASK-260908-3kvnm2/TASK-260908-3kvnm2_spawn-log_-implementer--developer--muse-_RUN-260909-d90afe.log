{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c41f","stream":{"kind":"session","id":"01a086e5-19c2-72a1-a8e0-dd9212b1ae96"},"sequence":106,"recorded_at":1780531400000207,"record_type":"event","durability":"durable","causation_id":"98051fac-e595-413c-ab29-8cb5ece495f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"98051fac-e595-413c-ab29-8cb5ece495f3","run_stream":{"kind":"run","id":"98051fac-e595-413c-ab29-8cb5ece495f3"},"call_id":"call_01a086e543a47002a0eb910151dbb7e3","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260908-18woqo/worktree/internal/specdoc/specdoc.go`.\n1|// Package specdoc exposes the exact pinned upstream AX specification document\n2|// to repository fidelity gates.\n3|//\n4|// The upstream specification remains normative. The embedded copy is a\n5|// verification input only: it is accepted solely when its SHA-256 equals the\n6|// document digest already pinned in internal/specpin, so a substituted,\n7|// truncated, edited, or partially read document is refused instead of being\n8|// silently compared against. Nothing here advertises runtime capabilities or\n9|// mutates durable state.\n10|//\n11|// The package exists so that enumeration artifacts and ownership claims can be\n12|// compared against the specification text itself rather than against the\n13|// implementation those artifacts are supposed to constrain. Only repository\n14|// gates import it: the test binaries that check enumeration artifacts, and\n15|// internal/traceability, which measures the normative clause inventory of a\n16|// bound section from this document. The embedded document never reaches the ax\n17|// command, and TestEmbeddedDocumentNeverReachesAProductBinary enforces that\n18|// from the module import graph rather than leaving it as a comment: only\n19|// tracecheck, the ownership gate, may reach this package from a main package.\n20|package specdoc\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t_ \"embed\"\n26|\t\"encoding/hex\"\n27|\t\"errors\"\n28|\t\"fmt\"\n29|\t\"regexp\"\n30|\t\"strings\"\n31|\n32|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n33|)\n34|\n35|//go:embed SPEC.md\n36|var embedded []byte\n37|\n38|// ErrDocumentMismatch reports an absent, empty, or non-pinned document. A\n39|// failed or partial read is reported as a mismatch, never as an absence that\n40|// some caller could treat as satisfied.\n41|var ErrDocumentMismatch = errors.New(\"pinned specification document mismatch\")\n42|\n43|// Document is a verified pinned specification together with the single\n44|// whitespace-normalized projection used for excerpt comparison, an index from\n45|// normalized offsets back to 1-based SPEC.md line numbers, and an index of the\n46|// document's Markdown tables.\n47|//\n48|// The projection collapses each run of ASCII whitespace to one space, except at\n49|// a hard boundary, where it collapses to BlockSeparator instead. A normalized\n50|// excerpt can never contain BlockSeparator, so a quote cannot be satisfied by\n51|// stitching text across such a boundary. Two kinds of boundary are hard:\n52|//\n53|//   - a blank line, which separates a paragraph from the paragraph after it and\n54|//     a heading from its body;\n55|//   - the newline between two adjacent Markdown table rows, because a table row\n56|//     is a complete line by construction, so no honest excerpt spans two of\n57|//     them, while a stitched one silently imports the next row's constraint.\n58|//\n59|// Hard line wrapping and table indentation inside one block are still forgiven,\n60|// as is the newline between two adjacent list items or between two adjacent\n61|// lines of one paragraph.\n62|type Document struct {\n63|\traw            []byte\n64|\tlines          []string\n65|\tnormalized     string\n66|\tlineOf         []int\n67|\tsectionOfLine  []string\n68|\ttableRowOfLine []TableRow\n69|}\n70|\n71|// BlockSeparator marks a hard boundary in the normalized projection. It is a\n72|// newline, which Normalize never emits, so it is unmatchable by any excerpt.\n73|const BlockSeparator = '\\n'\n74|\n75|// TableRow describes one body row of a Markdown table in the pinned document:\n76|// the first-column header of the table it belongs to, and the text of its own\n77|// first cell. Together they say what the row declares — \"Field\"/\"reason\" is the\n78|// declaration of a member, \"Type\"/\"GitIndex\" the declaration of a type, and\n79|// \"Tag\"/\"kind = git\" the declaration of a variant.\n80|type TableRow struct {\n81|\t// Header is the trimmed text of the table's first column header.\n82|\tHeader string\n83|\t// FirstCell is the trimmed text of this row's first cell.\n84|\tFirstCell string\n85|\t// Identifier is FirstCell with a single enclosing <code> element removed,\n86|\t// which is how the pinned document writes every declaration.\n87|\tIdentifier string\n88|\t// Line is the 1-based SPEC.md line of the row.\n89|\tLine int\n90|}\n91|\n92|// Load returns the embedded pinned document after verifying its digest.\n93|func Load() (*Document, error) {\n94|\treturn Parse(embedded)\n95|}\n96|\n97|// Bytes returns an isolated copy of the exact embedded document bytes.\n98|func Bytes() []byte {\n99|\treturn bytes.Clone(embedded)\n100|}\n101|\n102|// Parse accepts only a byte-exact copy of the pinned SPEC.md identified by\n103|// specpin.DocumentSHA256.\n104|func Parse(candidate []byte) (*Document, error) {\n105|\tif len(candidate) == 0 {\n106|\t\treturn nil, fmt.Errorf(\"%w: document is empty\", ErrDocumentMismatch)\n107|\t}\n108|\tdigest := sha256.Sum256(candidate)\n109|\tif got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256 {\n110|\t\treturn nil, fmt.Errorf(\"%w: SHA-256 is %s, want %s\", ErrDocumentMismatch, got, specpin.DocumentSHA256)\n111|\t}\n112|\n113|\tdocument := &Document{raw: bytes.Clone(candidate)}\n114|\tdocument.lines = strings.Split(strings.ReplaceAll(string(document.raw), \"\\r\\n\", \"\\n\"), \"\\n\")\n115|\n116|\thardBoundary := indexHardBoundaries(document.lines)\n117|\n118|\tvar normalized strings.Builder\n119|\tnormalized.Grow(len(candidate))\n120|\tlineOf := make([]int, 0, len(candidate))\n121|\tline := 1\n122|\trunStartLine := 1\n123|\tpendingSeparator := false\n124|\twroteAny := false\n125|\tfor index := 0; index < len(document.raw); index++ {\n126|\t\tcharacter := document.raw[index]\n127|\t\tif isNormalizedWhitespace(character) {\n128|\t\t\tif wroteAny && !pendingSeparator {\n129|\t\t\t\trunStartLine = line\n130|\t\t\t\tpendingSeparator = true\n131|\t\t\t}\n132|\t\t\tif character == '\\n' {\n133|\t\t\t\tline++\n134|\t\t\t}\n135|\t\t\tcontinue\n136|\t\t}\n137|\t\tif pendingSeparator {\n138|\t\t\tseparator := byte(' ')\n139|\t\t\tif crossesHardBoundary(hardBoundary, runStartLine, line) {\n140|\t\t\t\tseparator = BlockSeparator\n141|\t\t\t}\n142|\t\t\tnormalized.WriteByte(separator)\n143|\t\t\tlineOf = append(lineOf, line)\n144|\t\t\tpendingSeparator = false\n145|\t\t}\n146|\t\tnormalized.WriteByte(character)\n147|\t\tlineOf = append(lineOf, line)\n148|\t\twroteAny = true\n149|\t}\n150|\tdocument.normalized = normalized.String()\n151|\tdocument.lineOf = lineOf\n152|\tdocument.sectionOfLine = indexSections(document.lines)\n153|\tdocument.tableRowOfLine = indexTableRows(document.lines)\n154|\treturn document, nil\n155|}\n156|\n157|// indexHardBoundaries marks, for each 1-based line n, whether the newline\n158|// between line n and line n+1 is a hard boundary that no excerpt may cross.\n159|func indexHardBoundaries(lines []string) []bool {\n160|\thard := make([]bool, len(lines)+1)\n161|\tfor number := 1; number < len(lines); number++ {\n162|\t\tabove, below := lines[number-1], lines[number]\n163|\t\tif strings.TrimSpace(above) == \"\" || strings.TrimSpace(below) == \"\" {\n164|\t\t\thard[number] = true\n165|\t\t\tcontinue\n166|\t\t}\n167|\t\tif isTableLine(above) && isTableLine(below) {\n168|\t\t\thard[number] = true\n169|\t\t}\n170|\t}\n171|\treturn hard\n172|}\n173|\n174|// crossesHardBoundary reports whether a whitespace run that started on line\n175|// from and ended on line to crossed any hard boundary.\n176|func crossesHardBoundary(hard []bool, from, to int) bool {\n177|\tfor number := from; number < to && number < len(hard); number++ {\n178|\t\tif hard[number] {\n179|\t\t\treturn true\n180|\t\t}\n181|\t}\n182|\treturn false\n183|}\n184|\n185|func isTableLine(line string) bool {\n186|\treturn strings.HasPrefix(strings.TrimSpace(line), \"|\")\n187|}\n188|\n189|// tableSeparator matches the delimiter row that turns the line above it into a\n190|// Markdown table header.\n191|var tableSeparator = regexp.MustCompile(`^\\|[\\s:|-]*-{3,}[\\s:|-]*\\|?\\s*$`)\n192|\n193|// indexTableRows maps every 1-based line that is a body row of a Markdown table\n194|// to what that row declares. Header and delimiter lines map to nothing: they\n195|// declare no member, type, or variant of their own.\n196|func indexTableRows(lines []string) []TableRow {\n197|\trows := make([]TableRow, len(lines)+1)\n198|\tfor index := 0; index+1 < len(lines); index++ {\n199|\t\tif !isTableLine(lines[index]) || !tableSeparator.MatchString(strings.TrimSpace(lines[index+1])) {\n200|\t\t\tcontinue\n201|\t\t}\n202|\t\theader := firstTableCell(lines[index])\n203|\t\tfor body := index + 2; body < len(lines) && isTableLine(lines[body]); body++ {\n204|\t\t\tcell := firstTableCell(lines[body])\n205|\t\t\trows[body+1] = TableRow{\n206|\t\t\t\tHeader:     header,\n207|\t\t\t\tFirstCell:  cell,\n208|\t\t\t\tIdentifier: stripCodeElement(cell),\n209|\t\t\t\tLine:       body + 1,\n210|\t\t\t}\n211|\t\t}\n212|\t}\n213|\treturn rows\n214|}\n215|\n216|// firstTableCell returns the trimmed text of a table line's first cell.\n217|func firstTableCell(line string) string {\n218|\ttrimmed := strings.TrimSpace(line)\n219|\ttrimmed = strings.TrimPrefix(trimmed, \"|\")\n220|\tif index := strings.IndexByte(trimmed, '|'); index >= 0 {\n221|\t\ttrimmed = trimmed[:index]\n222|\t}\n223|\treturn strings.TrimSpace(trimmed)\n224|}\n225|\n226|var codeElement = regexp.MustCompile(`^<code>(.*)</code>$`)\n227|\n228|// stripCodeElement removes a single enclosing <code> element, which is how the\n229|// pinned document writes every declaration cell. Text that is not exactly one\n230|// such element is returned unchanged rather than partially rewritten.\n231|func stripCodeElement(cell string) string {\n232|\tif match := codeElement.FindStringSubmatch(cell); match != nil {\n233|\t\treturn match[1]\n234|\t}\n235|\treturn cell\n236|}\n237|\n238|// TableRowAt returns what the Markdown table body row at a 1-based SPEC.md line\n239|// declares. It reports false for every line that is not such a row, including\n240|// table headers and delimiters.\n241|func (document *Document) TableRowAt(number int) (TableRow, bool) {\n242|\tif number < 1 || number >= len(document.tableRowOfLine) {\n243|\t\treturn TableRow{}, false\n244|\t}\n245|\trow := document.tableRowOfLine[number]\n246|\tif row.Line == 0 {\n247|\t\treturn TableRow{}, false\n248|\t}\n249|\treturn row, true\n250|}\n251|\n252|// headingSectionID matches the numbered or appendix identifier of an ATX\n253|// heading: \"## 10.4 Transfer Manifest\" -> \"10.4\", \"#### 13.14.5 Events\" ->\n254|// \"13.14.5\", \"## Appendix A. Normative traceability\" -> \"A\",\n255|// \"### A.3 Task acceptance traceability\" -> \"A.3\".\n256|var (\n257|\tatxHeading      = regexp.MustCompile(`^(#{1,6})\\s+(.*)$`)\n258|\tnumberedSection = regexp.MustCompile(`^([0-9]+(?:\\.[0-9A-Z]+)*|[A-Z](?:\\.[0-9]+)+)\\.?\\s`)\n259|\tappendixSection = regexp.MustCompile(`^Appendix\\s+([A-Z])\\.`)\n260|)\n261|\n262|// indexSections maps every 1-based line to the identifier of the nearest\n263|// enclosing numbered clause. An unnumbered subheading — \"#### Managed Replica\n264|// Marker document\" — does not open a clause of its own; its lines stay\n265|// attributed to the numbered section above it, which is the clause a citation\n266|// belongs to.\n267|func indexSections(lines []string) []string {\n268|\tsections := make([]string, len(lines)+1)\n269|\tcurrent := \"\"\n270|\tfor index, line := range lines {\n271|\t\tif match := atxHeading.FindStringSubmatch(line); match != nil {\n272|\t\t\tif id, ok := headingSection(match[2]); ok {\n273|\t\t\t\tcurrent = id\n274|\t\t\t}\n275|\t\t}\n276|\t\tsections[index+1] = current\n277|\t}\n278|\treturn sections\n279|}\n280|\n281|func headingSection(text string) (string, bool) {\n282|\tif match := appendixSection.FindStringSubmatch(text); match != nil {\n283|\t\treturn match[1], true\n284|\t}\n285|\tif match := numberedSection.FindStringSubmatch(text); match != nil {\n286|\t\treturn match[1], true\n287|\t}\n288|\treturn \"\", false\n289|}\n290|\n291|// SectionID returns the identifier of the numbered clause containing a 1-based\n292|// SPEC.md line, so a citation can be held to the clause of the shape it\n293|// documents rather than only to the characters at the line.\n294|func (document *Document) SectionID(number int) (string, bool) {\n295|\tif number < 1 || number >= len(document.sectionOfLine) {\n296|\t\treturn \"\", false\n297|\t}\n298|\tid := document.sectionOfLine[number]\n299|\tif id == \"\" {\n300|\t\treturn \"\", false\n301|\t}\n302|\treturn id, true\n303|}\n304|\n305|// Normalize applies the single documented normalization rule to excerpt text:\n306|// every run of ASCII whitespace collapses to one space and leading/trailing\n307|// whitespace is removed. Nothing else is rewritten. Letter case, punctuation,\n308|// digits, and inline <code> markup are compared exactly, so the rule forgives\n309|// the specification's hard line wrapping and table indentation without letting\n310|// an excerpt match unrelated text.\n311|//\n312|// Normalize never emits BlockSeparator. The document projection does, at every\n313|// hard boundary — a blank line, and the newline between two adjacent table rows\n314|// — so a normalized excerpt cannot span one.\n315|func Normalize(text string) string {\n316|\tvar builder strings.Builder\n317|\tbuilder.Grow(len(text))\n318|\tpendingSeparator := false\n319|\twroteAny := false\n320|\tfor index := 0; index < len(text); index++ {\n321|\t\tcharacter := text[index]\n322|\t\tif isNormalizedWhitespace(character) {\n323|\t\t\tif wroteAny {\n324|\t\t\t\tpendingSeparator = true\n325|\t\t\t}\n326|\t\t\tcontinue\n327|\t\t}\n328|\t\tif pendingSeparator {\n329|\t\t\tbuilder.WriteByte(' ')\n330|\t\t\tpendingSeparator = false\n331|\t\t}\n332|\t\tbuilder.WriteByte(character)\n333|\t\twroteAny = true\n334|\t}\n335|\treturn builder.String()\n336|}\n337|\n338|func isNormalizedWhitespace(character byte) bool {\n339|\tswitch character {\n340|\tcase ' ', '\\t', '\\r', '\\n', '\\v', '\\f':\n341|\t\treturn true\n342|\tdefault:\n343|\t\treturn false\n344|\t}\n345|}\n346|\n347|// LineCount reports the number of lines in the pinned document.\n348|func (document *Document) LineCount() int {\n349|\treturn len(document.lines)\n350|}\n351|\n352|// Line returns the raw text of a 1-based SPEC.md line.\n353|func (document *Document) Line(number int) (string, bool) {\n354|\tif number < 1 || number > len(document.lines) {\n355|\t\treturn \"\", false\n356|\t}\n357|\treturn document.lines[number-1], true\n358|}\n359|\n360|// QuoteLines returns every 1-based SPEC.md line on which the normalized form\n361|// of text begins. An empty excerpt matches nothing: an empty quote would\n362|// otherwise be satisfied by any document. A match never spans a blank line,\n363|// because the projection separates blocks with the unmatchable BlockSeparator.\n364|func (document *Document) QuoteLines(text string) []int {\n365|\tneedle := Normalize(text)\n366|\tif needle == \"\" {\n367|\t\treturn nil\n368|\t}\n369|\tvar lines []int\n370|\tfor offset := 0; ; {\n371|\t\tindex := strings.Index(document.normalized[offset:], needle)\n372|\t\tif index < 0 {\n373|\t\t\treturn lines\n374|\t\t}\n375|\t\tstart := offset + index\n376|\t\tlines = append(lines, document.lineOf[start])\n377|\t\toffset = start + 1\n378|\t}\n379|}\n380|\n381|// Contains reports whether the normalized form of text occurs in the pinned\n382|// document at all.\n383|func (document *Document) Contains(text string) bool {\n384|\treturn len(document.QuoteLines(text)) != 0\n385|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
