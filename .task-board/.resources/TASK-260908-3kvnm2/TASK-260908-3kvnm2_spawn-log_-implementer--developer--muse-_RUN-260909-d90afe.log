{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd57","stream":{"kind":"session","id":"01a086e5-19c2-72a1-a8e0-dd9212b1ae96"},"sequence":1286,"recorded_at":1780531400002567,"record_type":"event","durability":"durable","causation_id":"98051fac-e595-413c-ab29-8cb5ece495f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"98051fac-e595-413c-ab29-8cb5ece495f3","run_stream":{"kind":"run","id":"98051fac-e595-413c-ab29-8cb5ece495f3"},"task_stream":{"kind":"task","id":"255e78ee-ca83-4b06-a302-178e6f1a2575"},"task_id":"255e78ee-ca83-4b06-a302-178e6f1a2575","event":{"kind":"output","task_id":"255e78ee-ca83-4b06-a302-178e6f1a2575","chunk":"{\n  \"chunk_id\": \"exec-48-1\",\n  \"command\": \"mkdir -p .temp/TASK-260908-3kvnm2 && cat > .temp/TASK-260908-3kvnm2/mutants.sh <<'EOF'\\n#!/bin/bash\\n# Narrowing-mutant battery for TASK-260908-3kvnm2 gates.\\n# Each mutant keeps the gate present and weakens it to admit exactly one\\n# member of the rejected class; the named test must FAIL. Restore is verified\\n# by git diff after every mutant.\\nset -u\\nlog=$1\\n{\\necho \\\"=== M1: VerifyV060 digest check narrowed to first 63 hex chars (admits trailing-newline variant only) ===\\\"\\ncp internal/specpin/pin.go /tmp/pin.go.bak\\npython3 - <<'PY'\\nt = open('internal/specpin/pin.go').read()\\nold = 'digest := sha256.Sum256(candidate)\\\\n\\\\tif hex.EncodeToString(digest[:]) != ManifestSHA256V060 {'\\nassert t.count(old) == 1\\nt = t.replace(old, 'digest := sha256.Sum256(candidate)\\\\n\\\\tif hex.EncodeToString(digest[:])[:63] != ManifestSHA256V060[:63] {')\\nopen('internal/specpin/pin.go','w').write(t)\\nPY\\ngo test ./internal/specpin/ -count=1 -run 'TestVerifyV060RejectsPartialMalformedAndByteDifferentReads/byte_different_whitespace' 2>&1 | tail -3\\ncp /tmp/pin.go.bak internal/specpin/pin.go\\ngit diff --quiet -- internal/specpin/pin.go && echo \\\"M1-RESTORED\\\" || echo \\\"M1-RESTORE-FAILED\\\"\\n\\necho \\\"=== M2: VerifyV060 source-identity narrowed to admit the stale v0.5.0 commit (tokens preserved) ===\\\"\\ncp internal/specpin/pin.go /tmp/pin.go.bak\\npython3 - <<'PY'\\nt = open('internal/specpin/pin.go').read()\\nold = 'source.TagObject != TagObjectV060 || source.Commit != CommitV060 ||'\\nassert t.count(old) == 1\\nt = t.replace(old, 'source.TagObject != TagObjectV060 || (source.Commit != CommitV060 && source.Commit != CommitV050) ||')\\nopen('internal/specpin/pin.go','w').write(t)\\nPY\\ngo test ./internal/specpin/ -count=1 -run 'TestVerifyV060RejectsWrongSourceHashAndVersionEvidence/stale_commit_keeps_v0_6_0_tokens' -v 2>&1 | grep -E \\\"^(--- |    )\\\" | head -5\\ngo test ./internal/specpin/ -count=1 -run 'TestVerifyV060RejectsWrongSourceHashAndVersionEvidence/stale_commit_keeps_v0_6_0_tokens' 2>&1 | tail -2\\ncp /tmp/pin.go.bak internal/specpin/pin.go\\ngit diff --quiet -- internal/specpin/pin.go && echo \\\"M2-RESTORED\\\" || echo \\\"M2-RESTORE-FAILED\\\"\\n\\necho \\\"=== M3: ParseV060 narrowed to also accept the v0.5.0 digest (admits exactly the stale document) ===\\\"\\ncp internal/specdoc/specdoc.go /tmp/specdoc.go.bak\\npython3 - <<'PY'\\nt = open('internal/specdoc/specdoc.go').read()\\nold = 'if got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256V060 {'\\nassert t.count(old) == 1\\nt = t.replace(old, 'if got := hex.EncodeToString(digest[:]); got != specpin.DocumentSHA256V060 && got != specpin.DocumentSHA256 {')\\nopen('internal/specdoc/specdoc.go','w').write(t)\\nPY\\ngo test ./internal/specdoc/ -count=1 -run 'TestParseV060RefusesEveryNonAdoptedDocument/stale_v0_5_0_document' 2>&1 | tail -2\\ngo test ./internal/specdoc/ -count=1 -run 'TestParseV060RefusesEveryNonAdoptedDocument' 2>&1 | tail -2\\ncp /tmp/specdoc.go.bak internal/specdoc/specdoc.go\\ngit diff --quiet -- internal/specdoc/specdoc.go && echo \\\"M3-RESTORED\\\" || echo \\\"M3-RESTORE-FAILED\\\"\\n\\necho \\\"=== M4 (token-preserving behavioral): v0.6.0 lock with selector row version 2.0.0, identifier token kept ===\\\"\\ncp internal/specpin/v0.6.0.lock.json /tmp/v060lock.bak\\npython3 - <<'PY'\\nimport json\\nd = json.load(open('internal/specpin/v0.6.0.lock.json'))\\nfor c in d['contracts']:\\n    if c['name'] == 'Session selector':\\n        assert c['id'] == 'urn:ax:contract:session-selector'\\n        c['versions'] = [\\\"2.0.0\\\"]\\njson.dump(d, open('/tmp/m4.json','w'), indent=2)\\nPY\\npython3 - <<'PY'\\n# feed the M4 bytes through the production gate directly\\nPY\\ngo test ./internal/specpin/ -count=1 -run 'TestCurrentV060PinsSignedV060Source|TestContractsForReleaseV060' 2>&1 | tail -2\\necho \\\"(M4 gate evaluated below via a probe test binary)\\\"\\ncp /tmp/v060lock.bak internal/specpin/v0.6.0.lock.json\\ngit diff --quiet -- internal/specpin/pin.go && git status --short internal/specpin/ | head -3\\n} 2>&1 | tee \\\"$log\\\"\\necho \\\"battery-exit=$?\\\"\\nEOF\\nchmod +x .temp/TASK-260908-3kvnm2/mutants.sh; echo staged\",\n  \"description\": \"Stage narrowing mutant battery script\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"staged\\n\",\n  \"original_output_bytes\": 7,\n  \"original_output_tokens\": 2,\n  \"truncated\": false\n}"}}}
