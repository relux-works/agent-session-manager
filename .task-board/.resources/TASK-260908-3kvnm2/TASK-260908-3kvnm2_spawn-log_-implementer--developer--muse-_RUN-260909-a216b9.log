otent\\\":true},\\\"uncheck_item\\\":{\\\"description\\\":\\\"Uncheck a checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"item\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item number (1-based)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"uncheck_item(TASK-260218-abc123, item=2)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"unlink\\\":{\\\"description\\\":\\\"Remove dependency between elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that was blocked\\\",\\\"required\\\":true},{\\\"name\\\":\\\"blocked_by\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that was blocking\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"unlink(TASK-260218-abc123, blocked_by=TASK-260218-def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"update_resource\\\":{\\\"description\\\":\\\"Replace an existing resource on an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name to replace\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Replacement content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"examples\\\":[\\\"update_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"revised\\\\\\\", type=outcome)\\\",\\\"update_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"withdraw_cr\\\":{\\\"description\\\":\\\"Retire an unintegrated Change Request revision with a written reason, so it stops blocking the Story\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being retired (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"reason\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Written reason the revision will never be integrated\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"withdraw_cr(STORY-260828-2xwsub, revision=1, reason=\\\\\\\"research-only run, zero repository delta, never routed to a reviewer\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false}},\\\"mutations\\\":[\\\"accept_cr\\\",\\\"add_checklist_item\\\",\\\"add_resource\\\",\\\"assign\\\",\\\"audit_context_validation\\\",\\\"check_item\\\",\\\"collect_context_retention\\\",\\\"confirm_context_reclamation\\\",\\\"correct_activity\\\",\\\"create\\\",\\\"delete\\\",\\\"delete_resource\\\",\\\"handoff\\\",\\\"link\\\",\\\"login\\\",\\\"logout\\\",\\\"mark_context_stale\\\",\\\"normalize_legacy_status\\\",\\\"publish_context\\\",\\\"reclassify_context\\\",\\\"record_ledger_event\\\",\\\"register_context\\\",\\\"remove_checklist_item\\\",\\\"rename\\\",\\\"retire_context\\\",\\\"retry_context_payload_withdrawal\\\",\\\"set_details\\\",\\\"set_estimate\\\",\\\"set_notes\\\",\\\"set_parent\\\",\\\"set_status\\\",\\\"sweep_context_retention\\\",\\\"sweep_context_validation_audits\\\",\\\"switch_user\\\",\\\"unassign\\\",\\\"uncheck_item\\\",\\\"unlink\\\",\\\"update_resource\\\",\\\"withdraw_cr\\\"],\\\"operationMetadata\\\":{\\\"activity\\\":{\\\"description\\\":\\\"Read bounded, cursor-paginated activity for one element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\"},{\\\"name\\\":\\\"cursor\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Opaque cursor returned by the previous page\\\"},{\\\"name\\\":\\\"limit\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":50,\\\"description\\\":\\\"Maximum events to return (1-100)\\\"},{\\\"name\\\":\\\"order\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"ascending\\\",\\\"description\\\":\\\"Sequence order: ascending or descending\\\"},{\\\"name\\\":\\\"kinds\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Comma-separated activity operation kinds\\\"},{\\\"name\\\":\\\"view\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"raw\\\",\\\"description\\\":\\\"History view: raw or effective\\\"}],\\\"examples\\\":[\\\"activity(TASK-XX, limit=50, order=ascending, view=raw)\\\",\\\"activity(TASK-XX, cursor=opaque-cursor, limit=25, kinds=progress, view=effective)\\\"]},\\\"agents\\\":{\\\"description\\\":\\\"List agents and their assigned elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"stale\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Stale threshold in minutes for done items\\\"}],\\\"examples\\\":[\\\"agents()\\\",\\\"agents(stale=60)\\\"]},\\\"context\\\":{\\\"description\\\":\\\"Get one Context Registry record by CTX id\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"}],\\\"examples\\\":[\\\"context(CTX-260728-a1b2c3) { selection }\\\",\\\"context(CTX-260728-a1b2c3) { identity binding lineage freshness security payload lifecycle }\\\"]},\\\"context_boundary\\\":{\\\"description\\\":\\\"Project one context's declared coverage boundary\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"},{\\\"name\\\":\\\"detail\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"banner\\\",\\\"description\\\":\\\"manifest includes the full boundary document\\\",\\\"enum\\\":[\\\"banner\\\",\\\"manifest\\\"]}],\\\"examples\\\":[\\\"context_boundary(CTX-260728-a1b2c3, detail=manifest)\\\"]},\\\"context_candidates\\\":{\\\"description\\\":\\\"Board-side context candidate projection for one target element and target role, ordered by scope distance then role affinity\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"element\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Target board element\\\"},{\\\"name\\\":\\\"role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Target role the run will execute as; keeps same-role, allowed predecessor, and project-producer snapshots and ranks them by affinity\\\"},{\\\"name\\\":\\\"producer_role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Opt-in exact producer-role filter\\\"},{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"ready\\\",\\\"description\\\":\\\"Comma-separated lifecycle states\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Candidates to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum candidates to return\\\"}],\\\"examples\\\":[\\\"context_candidates(element=TASK-260728-abc123, role=developer, provider=codex) { selection }\\\",\\\"context_candidates(element=TASK-260728-abc123, producer_role=solution-architect) { selection }\\\"]},\\\"context_retention\\\":{\\\"description\\\":\\\"Retention outlook: contexts a provider is about to delete on its own timer, and payloads only the board will ever delete\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"warn_days\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":7,\\\"description\\\":\\\"Expiry warning horizon\\\"},{\\\"name\\\":\\\"include_pinned\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"default\\\":false,\\\"description\\\":\\\"Consider pinned contexts for collection\\\"}],\\\"examples\\\":[\\\"context_retention(warn_days=14)\\\"]},\\\"contexts\\\":{\\\"description\\\":\\\"List Context Registry records with bounded, deterministic filters\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"element\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Board element the binding is resolved against\\\"},{\\\"name\\\":\\\"relation\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"exact\\\",\\\"description\\\":\\\"Binding relation to the element\\\",\\\"enum\\\":[\\\"exact\\\",\\\"ancestors\\\",\\\"descendants\\\",\\\"any\\\"]},{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Producer role that published the snapshot\\\"},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Comma-separated lifecycle states\\\",\\\"enum\\\":[\\\"building\\\",\\\"ready\\\",\\\"stale\\\",\\\"retired\\\"]},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Records to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum records to return\\\"}],\\\"examples\\\":[\\\"contexts(element=TASK-260728-abc123, relation=ancestors, role=developer, provider=codex, state=ready, skip=0, take=20) { selection }\\\",\\\"contexts(state=building) { identity lifecycle }\\\"]},\\\"count\\\":{\\\"description\\\":\\\"Count elements matching filters\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\n[tool output bounded: strategy=head, original_bytes=42974, visible_bytes=40000]\\n<system-reminder>\\nFull output saved to: /Users/iv/.local/share/muse/sessions/2026/09/09/01a08701-59bf-7f32-bf70-e2c68049d70f/tool-outputs/907e9383-5cb9-4bfc-aee5-14af13965071/call_01a087018dbc71f18a59ab15c287e153-bash.txt\\nFull output is longer than the visible window.\\nUse bash tools like head, tail, cat, sed, or grep to inspect and search the full output.\\n</system-reminder>\",\n  \"original_output_bytes\": 42974,\n  \"original_output_tokens\": 10744,\n  \"truncated\": true\n}"}}}
