put kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Comma-separated lifecycle states\\\",\\\"enum\\\":[\\\"building\\\",\\\"ready\\\",\\\"stale\\\",\\\"retired\\\"]},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Records to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum records to return\\\"}],\\\"examples\\\":[\\\"contexts(element=TASK-260728-abc123, relation=ancestors, role=developer, provider=codex, state=ready, skip=0, take=20) { selection }\\\",\\\"contexts(state=building) { identity lifecycle }\\\"]},\\\"count\\\":{\\\"description\\\":\\\"Count elements matching filters\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\n[tool output bounded: strategy=head, original_bytes=42974, visible_bytes=40000]\\n<system-reminder>\\nFull output saved to: /Users/iv/.local/share/muse/sessions/2026/09/09/01a08701-59bf-7f32-bf70-e2c68049d70f/tool-outputs/907e9383-5cb9-4bfc-aee5-14af13965071/call_01a087018dbc71f18a59ab15c287e153-bash.txt\\nFull output is longer than the visible window.\\nUse bash tools like head, tail, cat, sed, or grep to inspect and search the full output.\\n</system-reminder>\",\n  \"original_output_bytes\": 42974,\n  \"original_output_tokens\": 10744,\n  \"truncated\": true\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
