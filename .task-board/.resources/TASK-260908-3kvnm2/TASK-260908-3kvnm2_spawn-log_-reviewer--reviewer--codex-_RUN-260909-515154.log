	}

	if err := validateV060(manifest); err != nil {
		return Manifest{}, err
	}

	digest := sha256.Sum256(candidate)
	if hex.EncodeToString(digest[:]) != ManifestSHA256V060 {
		return Manifest{}, mismatch("lock digest is not %s", ManifestSHA256V060)
	}

	return manifest, nil
}

