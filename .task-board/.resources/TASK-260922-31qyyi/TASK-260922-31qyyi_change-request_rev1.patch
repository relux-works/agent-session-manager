+	if err != nil {
+		t.Fatalf("Projector.Project(after takeover) error = %v", err)
+	}
+	mustPairEqual(t, pair, Pair{Profile: ProfileYOLO, Source: change, HasSource: true}, "Projector(Projector winner handoff)")
+}
