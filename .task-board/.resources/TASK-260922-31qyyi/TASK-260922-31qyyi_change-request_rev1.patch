+#!/usr/bin/env python3
+"""Instrument append admission off and measure the independent source gate.
+
+Usage: PYTHONDONTWRITEBYTECODE=1 python3 internal/sessprofile/testdata/mutate_profile_authority.py /absolute/evidence/directory
+
+The scratch copy first runs every derivation entry with sessrepo's
+checkWinningLease replaced by a no-op. It then applies separate lower-epoch
+and unminted-same-epoch narrowing mutants and runs each entry killer alone.
+A behavior-preserving SURVIVED control follows. Raw subprocess logs and exact
+exit codes are written beneath the supplied task evidence path.
+"""
+from pathlib import Path
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[3]
+OUTPUT = Path(sys.argv[1]).resolve()
+COPY = OUTPUT / "mutation-source"
+OUTPUT.mkdir(parents=True, exist_ok=True)
+if COPY.exists():
+    raise SystemExit(f"refusing to overwrite existing mutation source: {COPY}")
+COPY.mkdir()
+shutil.copytree(ROOT / "internal", COPY / "internal")
+for name in ("go.mod", "go.sum"):
+    shutil.copy2(ROOT / name, COPY / name)
+
+APPEND_SOURCE = COPY / "internal/sessrepo/chain.go"
+AUTHORITY_SOURCE = COPY / "internal/sessprofile/authority.go"
+append_base = APPEND_SOURCE.read_text()
+authority_base = AUTHORITY_SOURCE.read_text()
+
+append_function = '''func checkWinningLease(winner LeaseSummary, event eventView) error {
+	if event.leaseEpoch < winner.Epoch {
+		return refuse(ErrStaleLease, "event lease epoch %d precedes winning lease epoch %d", event.leaseEpoch, winner.Epoch)
+	}
+	if event.leaseEpoch == winner.Epoch && event.leaseID != winner.LeaseID {
+		return refuse(ErrDivergentBranch, "event lease %s loses to winning lease %s at epoch %d", event.leaseID, winner.LeaseID, winner.Epoch)
+	}
+	return nil
+}'''
+if append_base.count(append_function) != 1:
+    raise SystemExit("append gate instrument was not unique")
+instrumented_append = append_base.replace(append_function, "func checkWinningLease(winner LeaseSummary, event eventView) error {\n\treturn nil\n}")
+APPEND_SOURCE.write_text(instrumented_append)
+
+LOWER_EPOCH_TESTS = {
+    "LoadProfile": "TestLoadProfileDoesNotExposeLosingLeaseAsEffectiveSource",
+    "Projector.Project": "TestProbe15DisabledAppendGateProjector",
+    "SetProfile.from_end": "TestSetProfileFromEndDoesNotReplayLosingLeaseChange",
+    "axpane.deriveProfile": "TestAxpaneDeriveProfileDoesNotUseLosingLeaseSource",
+}
+AMBIGUOUS_TESTS = {
+    "LoadProfile": "TestLoadProfileRejectsAmbiguousLeaseSource",
+    "Projector.Project": "TestProjectorRejectsAmbiguousLeaseSource",
+    "SetProfile.from_end": "TestSetProfileFromEndRejectsAmbiguousLeaseSource",
+    "axpane.deriveProfile": "TestAxpaneDeriveProfileRejectsAmbiguousLeaseSource",
+}
+ENTRY_TESTS = tuple(LOWER_EPOCH_TESTS.values()) + tuple(AMBIGUOUS_TESTS.values())
+ENTRY_RUN = "^(" + "|".join(ENTRY_TESTS) + ")$"
+baseline_command = ["go", "test", "./internal/axpane", "-run", ENTRY_RUN, "-count=1", "-v"]
+with (OUTPUT / "instrumented-derivation-baseline.log").open("w") as log:
+    baseline = subprocess.run(baseline_command, cwd=COPY, stdout=log, stderr=subprocess.STDOUT, timeout=600)
+baseline_text = (OUTPUT / "instrumented-derivation-baseline.log").read_text()
+ran = re.findall(r"^=== RUN   (Test[^/\s]+)", baseline_text, re.M)
+skipped = re.findall(r"^--- SKIP: (Test[^/\s]+)", baseline_text, re.M)
+failed = re.findall(r"^--- FAIL: (Test[^/\s]+)", baseline_text, re.M)
+required = set(ENTRY_TESTS)
+if baseline.returncode != 0 or set(ran) != required or skipped or failed:
+    raise SystemExit(f"instrumented entry suite failed: exit={baseline.returncode}, ran={ran}, skipped={skipped}, failed={failed}")
+
+def unique_logged_event_id(label: str) -> str:
+    matches = set(re.findall(rf"instrumented {label} profile event id=(sha256:[0-9a-f]{{64}})", baseline_text))
+    if len(matches) != 1:
+        raise SystemExit(f"instrumented {label} fixture did not emit one stable event id: {sorted(matches)}")
+    return next(iter(matches))
+
+authority_marker = "func authorizedSource(authority SourceAuthority, event Event, handoff map[string]bool, explicitClosure bool) bool {\n"
+if authority_base.count(authority_marker) != 1:
+    raise SystemExit("source-authority narrowing plant was not unique")
+
+def admit_exact_event(event_id: str) -> str:
+    return authority_marker + f'\tif event.ID == "{event_id}" {{\n\t\treturn true\n\t}}\n'
+
+losing_event_id = unique_logged_event_id("losing")
+mutant_source = authority_base.replace(authority_marker, admit_exact_event(losing_event_id))
+AUTHORITY_SOURCE.write_text(mutant_source)
+rows = [
+    {"mutant": "instrumented-derivation-baseline", "classification": "CONTROL", "exit": baseline.returncode, "command": baseline_command, "tests": ran},
+]
+for entry, test_name in LOWER_EPOCH_TESTS.items():
+    log_path = OUTPUT / f"N-profile-source-old-lease-{entry.replace('.', '-')}.log"
+    command = ["go", "test", "./internal/axpane", "-run", f"^{test_name}$", "-count=1", "-v"]
+    with log_path.open("w") as log:
+        result = subprocess.run(command, cwd=COPY, stdout=log, stderr=subprocess.STDOUT, timeout=600)
+    failures = re.findall(r"^--- FAIL: (Test[^/\s]+)", log_path.read_text(), re.M)
+    if result.returncode == 0 or failures != [test_name]:
+        raise SystemExit(f"lower-epoch narrowing mutant was not killed at {entry}: exit={result.returncode}, failed={failures}")
+    rows.append({"mutant": "N-profile-source-old-lease", "classification": "KILLED", "entry": entry, "test": test_name, "exit": result.returncode, "command": command, "failed_tests": failures, "event_id": losing_event_id, "bound": "Admits exactly the post-handoff fixture event under the previously winning lower-epoch lease, outside the captured closure."})
+
+AUTHORITY_SOURCE.write_text(authority_base)
+ambiguous_event_id = unique_logged_event_id("ambiguous")
+AUTHORITY_SOURCE.write_text(authority_base.replace(authority_marker, admit_exact_event(ambiguous_event_id)))
+for entry, test_name in AMBIGUOUS_TESTS.items():
+    log_path = OUTPUT / f"N-profile-source-same-epoch-{entry.replace('.', '-')}.log"
+    command = ["go", "test", "./internal/axpane", "-run", f"^{test_name}$", "-count=1", "-v"]
+    with log_path.open("w") as log:
+        result = subprocess.run(command, cwd=COPY, stdout=log, stderr=subprocess.STDOUT, timeout=600)
+    failures = re.findall(r"^--- FAIL: (Test[^/\s]+)", log_path.read_text(), re.M)
+    if result.returncode == 0 or failures != [test_name]:
+        raise SystemExit(f"same-epoch narrowing mutant was not killed at {entry}: exit={result.returncode}, failed={failures}")
+    rows.append({"mutant": "N-profile-source-same-epoch", "classification": "KILLED", "entry": entry, "test": test_name, "exit": result.returncode, "command": command, "failed_tests": failures, "event_id": ambiguous_event_id, "bound": "Admits exactly the unminted same-epoch competitor fixture event while retaining the normal winning-lease and handoff checks for every other event."})
+
+AUTHORITY_SOURCE.write_text(authority_base)
+control_old = "// SourceAuthority carries the durable lease facts used when selecting a"
+control_new = "// SourceAuthority carries the durable lease facts used when selecting a\n// Applied harmless control: no behavior changes."
+if authority_base.count(control_old) != 1:
+    raise SystemExit("harmless control plant was not unique")
+AUTHORITY_SOURCE.write_text(authority_base.replace(control_old, control_new))
+control_command = ["go", "test", "./internal/axpane", "-run", ENTRY_RUN, "-count=1", "-v"]
+with (OUTPUT / "C-harmless-comment.log").open("w") as log:
+    control = subprocess.run(control_command, cwd=COPY, stdout=log, stderr=subprocess.STDOUT, timeout=600)
+control_text = (OUTPUT / "C-harmless-comment.log").read_text()
+control_failures = re.findall(r"^--- FAIL: (Test[^/\s]+)", control_text, re.M)
+if control.returncode != 0 or control_failures:
+    raise SystemExit(f"harmless control did not survive: exit={control.returncode}, failed={control_failures}")
+
+rows.append({"mutant": "C-harmless-comment", "classification": "SURVIVED", "exit": control.returncode, "command": control_command})
