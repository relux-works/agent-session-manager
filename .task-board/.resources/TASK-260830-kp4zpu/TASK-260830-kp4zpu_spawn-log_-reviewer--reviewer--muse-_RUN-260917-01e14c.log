 false)\n221|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, validDiscoveryContext()), \"invalid_config\", \"bind discovery evidence is absent\")\n222|\t\t}},\n223|\t\t{arm: `ctor|failInvalid|bind store override is pi-only`, name: \"bind codex override\", prove: func(t *testing.T) {\n224|\t\t\tctx := validDiscoveryContext()\n225|\t\t\tctx.StoreRootOverride = filepath.Join(bindHome, \"custom\")\n226|\t\t\tproof := bindProof(bindNativeID, filepath.Join(bindHome, \".codex\", \"sessions\"), false, true, false)\n227|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, ctx), \"invalid_config\", \"bind store override is pi-only\")\n228|\t\t}},\n229|\t\t{arm: `ctor|failInvalid|bind store override is not an absolute path`, name: \"bind relative pi override\", prove: func(t *testing.T) {\n230|\t\t\tparams := validCreateParams()\n231|\t\t\tparams.ProviderID = \"pi\"\n232|\t\t\tparams.ProviderVersion = \"0.73.1\"\n233|\t\t\tparams.ProviderVersionRange = \">=0.73.1 <0.74.0\"\n234|\t\t\tidentity := mustCreate(t, params)\n235|\t\t\tctx := validDiscoveryContext()\n236|\t\t\tctx.Build = BuildTuple{ProviderID: \"pi\", ProviderVersion: \"0.73.1\", Platform: \"macos\", Architecture: \"arm64\"}\n237|\t\t\tctx.StoreRootOverride = \"custom/relative\"\n238|\t\t\tproof := bindProof(params.NativeSessionID, filepath.Join(bindHome, \".pi\", \"agent\", \"sessions\"), false, true, false)\n239|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(identity, proof, ctx), \"invalid_config\", \"bind store override is not an absolute path\")\n240|\t\t}},\n241|\t\t{arm: `ctor|failInvalid|bind discovery root is missing`, name: \"bind null store root\", prove: func(t *testing.T) {\n242|\t\t\tproof := bindProof(bindNativeID, \"\", true, true, false)\n243|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, validDiscoveryContext()), \"invalid_config\", \"bind discovery root is missing\")\n244|\t\t}},\n245|\t\t{arm: `ctor|failInvalid|bind discovery root is outside the provider store`, name: \"bind foreign root\", prove: func(t *testing.T) {\n246|\t\t\tproof := bindProof(bindNativeID, \"/etc/provider\", false, true, false)\n247|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, validDiscoveryContext()), \"invalid_config\", \"bind discovery root is outside the provider store\")\n248|\t\t}},\n249|\t\t{arm: `ctor|failInvalid|bind expected realm is not a digest`, name: \"bind garbage realm\", prove: func(t *testing.T) {\n250|\t\t\tctx := validDiscoveryContext()\n251|\t\t\tctx.Realm = \"nope\"\n252|\t\t\tproof := bindProof(bindNativeID, filepath.Join(bindHome, \".codex\", \"sessions\"), false, true, false)\n253|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, ctx), \"invalid_config\", \"bind expected realm is not a digest\")\n254|\t\t}},\n255|\t\t{arm: `ctor|failInvalid|bind realm does not equal the expected backend realm`, name: \"bind drifted realm\", prove: func(t *testing.T) {\n256|\t\t\tparams := validCreateParams()\n257|\t\t\tparams.BackendRealm = bindRealm\n258|\t\t\tidentity := mustCreate(t, params)\n259|\t\t\tctx := validDiscoveryContext()\n260|\t\t\tctx.Realm = \"sha256:\" + strings.Repeat(\"b\", 64)\n261|\t\t\tproof := bindProof(params.NativeSessionID, filepath.Join(bindHome, \".codex\", \"sessions\"), false, true, true)\n262|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(identity, proof, ctx), \"invalid_config\", \"bind realm does not equal the expected backend realm\")\n263|\t\t}},\n264|\t\t{arm: `ctor|failInvalid|bind backend realm is claimed but unresolved`, name: \"bind unresolved realm\", prove: func(t *testing.T) {\n265|\t\t\tparams := validCreateParams()\n266|\t\t\tparams.BackendRealm = bindRealm\n267|\t\t\tidentity := mustCreate(t, params)\n268|\t\t\tproof := bindProof(params.NativeSessionID, filepath.Join(bindHome, \".codex\", \"sessions\"), false, true, false)\n269|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(i