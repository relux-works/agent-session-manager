ot a provider id`, name: \"create uppercase provider\", prove: func(t *testing.T) {\n28|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.ProviderID = \"Codex\" }))\n29|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create provider_id is not a provider id\")\n30|\t\t}},\n31|\t\t{arm: `ctor|failInvalid|create provider_version is not 1..128 characters`, name: \"create empty version\", prove: func(t *testing.T) {\n32|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.ProviderVersion = \"\" }))\n33|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create provider_version is not 1..128 characters\")\n34|\t\t}},\n35|\t\t{arm: `ctor|failInvalid|create provider_version_range is not 1..256 characters`, name: \"create empty range\", prove: func(t *testing.T) {\n36|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.ProviderVersionRange = \"\" }))\n37|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create provider_version_range is not 1..256 characters\")\n38|\t\t}},\n39|\t\t{arm: `ctor|failInvalid|create native_session_id is not 1..512 characters`, name: \"create empty native id\", prove: func(t *testing.T) {\n40|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.NativeSessionID = \"\" }))\n41|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create native_session_id is not 1..512 characters\")\n42|\t\t}},\n43|\t\t{arm: `ctor|failInvalid|create identity_kind is not a registry member`, name: \"create window handle kind\", prove: func(t *testing.T) {\n44|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.IdentityKind = \"window_handle\" }))\n45|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create identity_kind is not a registry member\")\n46|\t\t}},\n47|\t\t{arm: `ctor|failInvalid|create logical_workspace_id is not a UUIDv7`, name: \"create bogus workspace\", prove: func(t *testing.T) {\n48|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.LogicalWorkspaceID = \"nope\" }))\n49|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create logical_workspace_id is not a UUIDv7\")\n50|\t\t}},\n51|\t\t{arm: `ctor|failInvalid|create backend_realm_fingerprint is not a digest or empty`, name: \"create garbage realm\", prove: func(t *testing.T) {\n52|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.BackendRealm = \"nope\" }))\n53|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create backend_realm_fingerprint is not a digest or empty\")\n54|\t\t}},\n55|\t\t{arm: `ctor|failInvalid|create backend_realm_fingerprint is required for this backend kind`, name: \"create antigravity null realm\", prove: func(t *testing.T) {\n56|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) {\n57|\t\t\t\tp.ProviderID = \"antigravity\"\n58|\t\t\t\tp.IdentityKind = \"backend_conversation_uuid\"\n59|\t\t\t}))\n60|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create backend_realm_fingerprint is required for this backend kind\")\n61|\t\t}},\n62|\t\t{arm: `ctor|failInvalid|create opaque_identity exceeds 32 entries`, name: \"create 33 opaque entries\", prove: func(t *testing.T) {\n63|\t\t\topaque := map[string]string{}\n64|\t\t\tfor i := 0; i < 33; i++ {\n65|\t\t\t\topaque[\"k\"+pad2(i)] = \"x\"\n66|\t\t\t}\n67|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.OpaqueIdentity = opaque }))\n68|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create opaque_identity exceeds 32 entries\")\n69|\t\t}},\n70|\t\t{arm: `ctor|failInvalid|create opaque key is not a provider key`, name: \"create bad opaque key\", prove: func(t *testing.T) {\n71|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.OpaqueIdentity = map[string]string{\"Bad Key!\": \"x\"} }))\n72|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create opaque key is not a provider key\")\n73|\t\t}},\n74|\t\t{arm: `ctor|failInvalid|create opaque value i