der\", prove: func(t *testing.T) {\n171|\t\t\ttuple := validBuildTuple()\n172|\t\t\ttuple.ProviderID = \"Codex\"\n173|\t\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"resume provider is not a provider id\")\n174|\t\t}},\n175|\t\t{arm: `ctor|failInvalid|resume version is not 1..128 characters`, name: \"resume empty version\", prove: func(t *testing.T) {\n176|\t\t\ttuple := validBuildTuple()\n177|\t\t\ttuple.ProviderVersion = \"\"\n178|\t\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"resume version is not 1..128 characters\")\n179|\t\t}},\n180|\t\t{arm: `ctor|failInvalid|resume platform is not a registry member`, name: \"resume plan9 platform\", prove: func(t *testing.T) {\n181|\t\t\ttuple := validBuildTuple()\n182|\t\t\ttuple.Platform = \"plan9\"\n183|\t\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"resume platform is not a registry member\")\n184|\t\t}},\n185|\t\t{arm: `ctor|failInvalid|resume architecture is not amd64 or arm64`, name: \"resume mips architecture\", prove: func(t *testing.T) {\n186|\t\t\ttuple := validBuildTuple()\n187|\t\t\ttuple.Architecture = \"mips\"\n188|\t\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"resume architecture is not amd64 or arm64\")\n189|\t\t}},\n190|\t\t{arm: `ctor|failInvalid|resume has no direct qwen claim`, name: \"resume qwen\", prove: func(t *testing.T) {\n191|\t\t\ttuple := validBuildTuple()\n192|\t\t\ttuple.ProviderID = \"qwen\"\n193|\t\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"resume has no direct qwen claim\")\n194|\t\t}},\n195|\t\t{arm: `ctor|failInvalid|resume names an unknown provider`, name: \"resume future provider\", prove: func(t *testing.T) {\n196|\t\t\ttuple := validBuildTuple()\n197|\t\t\ttuple.ProviderID = \"futuredesk\"\n198|\t\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"resume names an unknown provider\")\n199|\t\t}},\n200|\t\t{arm: `ctor|failI