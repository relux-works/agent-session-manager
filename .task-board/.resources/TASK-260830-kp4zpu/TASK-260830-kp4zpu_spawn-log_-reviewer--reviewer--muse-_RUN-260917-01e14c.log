{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb69","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":1039,"recorded_at":1780531400002073,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"task_stream":{"kind":"task","id":"01a0adc2-826a-7fc3-b762-bfdbd5166a26"},"task_id":"01a0adc2-826a-7fc3-b762-bfdbd5166a26","event":{"kind":"output","task_id":"01a0adc2-826a-7fc3-b762-bfdbd5166a26","chunk":"{\n  \"chunk_id\": \"exec-28-1\",\n  \"command\": \"cat > /tmp/own_mut.py <<'EOF'\\nimport re, subprocess\\nfrom pathlib import Path\\nbase = Path('.temp/TASK-260830-kp4zpu/probe-src')\\nout = Path('.temp/TASK-260830-kp4zpu/own-mutants'); out.mkdir(parents=True, exist_ok=True)\\ncreate = base/'internal/provhost/identity_create.go'\\nbind = base/'internal/provhost/identity_bind.go'\\nplants = [\\n  ('M1-opaque-count-33', create,\\n   'if len(opaque) > 32 {', 'if len(opaque) > 33 {',\\n   ['go','test','./internal/provhost','-run','^TestCreateIdentityRefusals$','-count=1','-v']),\\n  ('M2-resume-arch-mips', bind,\\n   'if !isProbeArchitecture(tuple.Architecture) {', 'if !isProbeArchitecture(tuple.Architecture) && tuple.Architecture != \\\"mips\\\" {',\\n   ['go','test','./internal/provhost','-run','^TestCheckResumeTupleRefusals$','-count=1','-v']),\\n  ('M3-discovery-native-empty', bind,\\n   'if !ok || runeLength(native) < 1 || runeLength(native) > 512 {', 'if !ok || runeLength(native) < 0 || runeLength(native) > 512 {',\\n   ['go','test','./internal/provhost','-run','^TestDecodeNativeDiscoveryRefusals$','-count=1','-v']),\\n  ('M4-store-home-empty-codex', bind,\\n   'if home == \\\"\\\" {', 'if home == \\\"\\\" && providerID != \\\"codex\\\" {',\\n   ['go','test','./internal/provhost','-run','^TestStoreRootForRefusals$','-count=1','-v']),\\n  ('C-harmless-comment', bind,\\n   '// isResumeProvider reports whether the provider carries a Section 8.2',\\n   '// isResumeProvider reports whether the provider carries a Section 8.2\\\\n// reviewer control: comment only.',\\n   ['go','test','./internal/provhost','-count=1']),\\n]\\nfor name, path, old, new, cmd in plants:\\n    orig = path.read_text()\\n    assert orig.count(old)==1, (name, orig.count(old))\\n    path.write_text(orig.replace(old, new))\\n    try:\\n        log = (out/(name+'.log')).open('w')\\n        p = subprocess.run(cmd, cwd=base, stdout=log, stderr=subprocess.STDOUT, timeout=180)\\n        log.close()\\n        text = (out/(name+'.log')).read_text()\\n        fails = re.findall(r'^\\\\s*--- FAIL: ([^ ]+)', text, re.M)\\n        ran = len(re.findall(r'^=== RUN ', text, re.M)) > 0\\n        cls = 'COMPILE_OR_HARNESS_FAILURE' if not ran else ('SURVIVED' if p.returncode==0 else ('KILLED' if fails else 'COMPILE_OR_HARNESS_FAILURE'))\\n        print(name, cls, 'exit='+str(p.returncode), ','.join(fails[:4]))\\n    finally:\\n        path.write_text(orig)\\nEOF\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/own_mut.py\",\n  \"description\": \"Apply and execute four own narrowing mutants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"M1-opaque-count-33 KILLED exit=1 TestCreateIdentityRefusals,TestCreateIdentityRefusals/opaque_count\\nM2-resume-arch-mips KILLED exit=1 TestCheckResumeTupleRefusals,TestCheckResumeTupleRefusals/architecture_registry\\nM3-discovery-native-empty KILLED exit=1 TestDecodeNativeDiscoveryRefusals,TestDecodeNativeDiscoveryRefusals/native_bounds\\nM4-store-home-empty-codex KILLED exit=1 TestStoreRootForRefusals,TestStoreRootForRefusals/home_empty\\nC-harmless-comment COMPILE_OR_HARNESS_FAILURE exit=0 \\n\",\n  \"original_output_bytes\": 491,\n  \"original_output_tokens\": 123,\n  \"truncated\": false\n}","final_result":true}}}
