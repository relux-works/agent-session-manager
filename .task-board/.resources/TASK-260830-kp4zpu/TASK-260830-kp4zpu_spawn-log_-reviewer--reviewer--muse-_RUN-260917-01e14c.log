{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c671","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":403,"recorded_at":1780531400000801,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"task_stream":{"kind":"task","id":"01a0adbc-956f-7e33-ad7a-0b08b964b051"},"task_id":"01a0adbc-956f-7e33-ad7a-0b08b964b051","event":{"kind":"output","task_id":"01a0adbc-956f-7e33-ad7a-0b08b964b051","chunk":"Read text file `internal/provhost/closed_vocabulary_census_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"go/ast\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n16|)\n17|\n18|// This file closes the closed-vocabulary class for the shapes the\n19|// census derives: every package-level []string, map[string]bool, and\n20|// map[string]string consulted by a membership check carries a\n21|// registered spec derivation that executes. The eight enum\n22|// derivations in closed_vocabularies_test.go are hand-registered one\n23|// by one, and nine more membership-checked vocabularies existed in\n24|// production with no derivation at all: a widened member set still\n25|// admitted its extra body with the suite green. Enumerating one more\n26|// hand-written list per vocabulary would move the gap, not close it,\n27|// so the domain is derived the way\n28|// TestDerivedRefusalArmsAreAllWitnessed already does for refusal\n29|// arms: deriveMembershipVocabularies parses production source for\n30|// the three package-level shapes, and\n31|// TestClosedVocabularyCensusCoversEveryMembershipVocabulary requires\n32|// each to carry a registered spec derivation. A new vocabulary with\n33|// no derivation fails here instead of passing silently.\n34|//\n35|// Three vocabularies used to live outside the derived shapes as\n36|// switch statements (the response envelope member set, the execution\n37|// profile set, the transaction state set); a widened case admitted\n38|// its extra value with the suite green. They are package-level maps\n39|// now (responseMembers, profileNames, statusStates), so the census\n40|// derives them like the rest. The remaining switch in production\n41|// dispatches on an already-validated state rather than admitting\n42|// members, and TestAllProductionSwitchesAreClassified pins that:\n43|// any new switch must be classified before the suite passes.\n44|//\n45|// A membership check is one of: an unknownMember argument, a direct\n46|// map index, or a range that builds an allow-set or compares\n47|// element-wise. The *Required order lists are deliberately out of\n48|// scope: their only production use is as missingMember arguments,\n49|// they encode deterministic refusal order rather than containment,\n50|// and dropping their last entry is behaviour-preserving (the omitted\n51|// body still refuses). profileProviders is likewise out of scope:\n52|// nothing in production consults it. The []Operation registries are\n53|// out of scope by type and stay derived by\n54|// TestOperationRegistryIsDerivedFromSpec. Function-local literals\n55|// (such as the required list inside checkResponseMembers) belong to\n56|// the *Required order-list class above, not to containment. An empty\n57|// derivation — zero files scanned, zero vocabularies found, a spec\n58|// window with no members — fails closed rather than measuring\n59|// nothing.\n60|\n61|// requireMemberSet asserts the production member set holds exactly\n62|// the spec-derived members, order-insensitive: maps carry no order.\n63|// Either side empty is a blind check, so both fail outright.\n64|func requireMemberSet(t *testing.T, name string, got, want []string) {\n65|\tt.Helper()\n66|\tif len(got) == 0 {\n67|\t\tt.Fatalf(\"%s holds no members; the check is blind\", name)\n68|\t}\n69|\tif len(want) == 0 {\n70|\t\tt.Fatalf(\"%s derives no members from the pinned document; the check is blind\", name)\n71|\t}\n72|\tordered := func(members []string) []string {\n73|\t\tduplicated := append([]string(nil), members...)\n74|\t\tsort.Strings(duplicated)\n75|\t\treturn duplicated\n76|\t}\n77|\tif !reflect.DeepEqual(ordered(got), ordered(want)) {\n78|\t\tt.Fatalf(\"%s = %v, want the pinned member set %v\", name, ordered(got), ordered(want))\n79|\t}\n80|\tt.Logf(\"%s coverage: %d/%d members derived\", name, len(got), len(want))\n81|}\n82|\n83|// exampleObjectKeysOf parses the top-level keys of the JSON example\n84|// embedded in a spec window, in document order. A window with no\n85|// JSON object is a blind check, so it fails outright.\n86|func exampleObjectKeysOf(t *testing.T, window string) []string {\n87|\tt.Helper()\n88|\tstart := strings.Index(window, \"{\")\n89|\tend := strings.LastIndex(window, \"}\")\n90|\tif start < 0 || end <= start {\n91|\t\tt.Fatal(\"spec window holds no JSON object; the check is blind\")\n92|\t}\n93|\texample, fault := decodeStrictObject([]byte(window[start : end+1]))\n94|\tif fault != nil {\n95|\t\tt.Fatalf(\"spec example is not a strict object: %v %q\", fault.detail, fault.member)\n96|\t}\n97|\tvar keys []string\n98|\tfor key := range example {\n99|\t\tkeys = append(keys, key)\n100|\t}\n101|\tif len(keys) == 0 {\n102|\t\tt.Fatal(\"spec example holds no members; the check is blind\")\n103|\t}\n104|\treturn keys\n105|}\n106|\n107|// typeRowMembersOf parses one Section 7.5 embedded-type table row:\n108|// the first code span names the type, and every later span opens\n109|// with one member declaration. A row whose first span is not the\n110|// named type, or that carries no member span, is a blind check.\n111|func typeRowMembersOf(t *testing.T, row, typeName string) []string {\n112|\tt.Helper()\n113|\tspans := codeSpanPattern.FindAllStringSubmatch(row, -1)\n114|\tif len(spans) == 0 {\n115|\t\tt.Fatalf(\"Section 7.5 %s row holds no code elements; the check is blind\", typeName)\n116|\t}\n117|\tif spans[0][1] != typeName {\n118|\t\tt.Fatalf(\"Section 7.5 row opens with %q, want the %s declaration; the check is blind\", spans[0][1], typeName)\n119|\t}\n120|\tvar members []string\n121|\tfor _, span := range spans[1:] {\n122|\t\tname := span[1]\n123|\t\tif end := strings.Index(name, \":\"); end >= 0 {\n124|\t\t\tname = name[:end]\n125|\t\t}\n126|\t\tname = strings.TrimSpace(name)\n127|\t\tif name == \"\" {\n128|\t\t\tt.Fatalf(\"Section 7.5 %s row parses to an empty member; the check is blind\", typeName)\n129|\t\t}\n130|\t\tmembers = append(members, name)\n131|\t}\n132|\tif len(members) == 0 {\n133|\t\tt.Fatalf(\"Section 7.5 %s row parses to no members; the check is blind\", typeName)\n134|\t}\n135|\treturn members\n136|}\n137|\n138|// objectCellMembersOf parses the braced success-body cell of one\n139|// Section 7.5 operation row: the single code span starting with \"{\"\n140|// whose text names marker, split on top-level commas, one member per\n141|// element before its colon. Zero or two matching cells is a blind\n142|// check.\n143|func objectCellMembersOf(t *testing.T, row, marker string) []string {\n144|\tt.Helper()\n145|\tspans := codeSpanPattern.FindAllStringSubmatch(row, -1)\n146|\tvar cell string\n147|\tmatches := 0\n148|\tfor _, span := range spans {\n149|\t\tif strings.HasPrefix(span[1], \"{\") && strings.Contains(span[1], marker) {\n150|\t\t\tcell = span[1]\n151|\t\t\tmatches++\n152|\t\t}\n153|\t}\n154|\tif matches != 1 {\n155|\t\tt.Fatalf(\"Section 7.5 row holds %d success cells naming %q, want exactly one; the check is blind\", matches, marker)\n156|\t}\n157|\tinner := cell\n158|\tif !strings.HasPrefix(inner, \"{\") || !strings.HasSuffix(inner, \"}\") {\n159|\t\tt.Fatalf(\"Section 7.5 cell %q is not a braced object; the check is blind\", cell)\n160|\t}\n161|\tinner = inner[1 : len(inner)-1]\n162|\tvar members []string\n163|\tdepth := 0\n164|\tfield := \"\"\n165|\tflush := func() {\n166|\t\tname := field\n167|\t\tif end := strings.Index(name, \":\"); end >= 0 {\n168|\t\t\tname = name[:end]\n169|\t\t}\n170|\t\tname = strings.TrimSpace(name)\n171|\t\tif name == \"\" {\n172|\t\t\tt.Fatalf(\"Section 7.5 cell %q parses to an empty member; the check is blind\", cell)\n173|\t\t}\n174|\t\tmembers = append(members, name)\n175|\t\tfield = \"\"\n176|\t}\n177|\tfor _, char := range inner {\n178|\t\tswitch char {\n179|\t\tcase '(', '[':\n180|\t\t\tdepth++\n181|\t\t\tfield += string(char)\n182|\t\tcase ')', ']':\n183|\t\t\tdepth--\n184|\t\t\tfield += string(char)\n185|\t\tcase ',':\n186|\t\t\tif depth == 0 {\n187|\t\t\t\tflush()\n188|\t\t\t\tcontinue\n189|\t\t\t}\n190|\t\t\tfield += string(char)\n191|\t\tdefault:\n192|\t\t\tfield += string(char)\n193|\t\t}\n194|\t}\n195|\tflush()\n196|\tif len(members) == 0 {\n197|\t\tt.Fatalf(\"Section 7.5 cell %q parses to no members; the check is blind\", cell)\n198|\t}\n199|\treturn members\n200|}\n201|\n202|// TestManifestMembersAreDerivedFromSpec proves the exact manifest\n203|// member set equals the Section 7.3 example keys: a widened\n204|// implementation admitting \"bogus\" reddens here.\n205|func TestManifestMembersAreDerivedFromSpec(t *testing.T) {\n206|\tdocument, err := specdoc.Load()\n207|\tif err != nil {\n208|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n209|\t}\n210|\twindow := sectionLines(t, document, \"7.3\", 2751, 2785)\n211|\trequireQuote(t, document, \"The manifest is closed and every displayed member is required\", \"7.3\")\n212|\tvar got []string\n213|\tfor member := range manifestMembers {\n214|\t\tgot = append(got, member)\n215|\t}\n216|\trequireMemberSet(t, \"manifestMembers\", got, exampleObjectKeysOf(t, window))\n217|}\n218|\n219|// TestProbeMembersAreDerivedFromSpec proves the exact probe member\n220|// set equals the Section 7.4 example keys: a widened implementation\n221|// admitting \"bogus\" reddens here.\n222|func TestProbeMembersAreDerivedFromSpec(t *testing.T) {\n223|\tdocument, err := specdoc.Load()\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n226|\t}\n227|\twindow := sectionLines(t, document, \"7.4\", 2805, 2857)\n228|\trequireQuote(t, document, \"The probe object is closed and every displayed member is required\", \"7.4\")\n229|\tvar got []string\n230|\tfor member := range probeMembers {\n231|\t\tgot = append(got, member)\n232|\t}\n233|\trequireMemberSet(t, \"probeMembers\", got, exampleObjectKeysOf(t, window))\n234|}\n235|\n236|// TestProbeCapabilityMembersAreDerivedFromSpec proves the exact\n237|// capability-value member set equals the Section 7.4 sentence: a\n238|// widened implementation admitting \"bogus\" reddens here.\n239|func TestProbeCapabilityMembersAreDerivedFromSpec(t *testing.T) {\n240|\tdocument, err := specdoc.Load()\n241|\tif err != nil {\n242|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n243|\t}\n244|\twindow := sectionLines(t, document, \"7.4\", 2864, 2866)\n245|\trequireQuote(t, document, \"Each capability value contains exactly\", \"7.4\")\n246|\t// Only the declaring sentence counts: the next sentence opens\n247|\t// with the warnings member, which belongs to the probe object\n248|\t// rather than to one capability value.\n249|\tsentence := window\n250|\tif end := strings.Index(sentence, \".\"); end >= 0 {\n251|\t\tsentence = sentence[:end+1]\n252|\t}\n253|\tvar got []string\n254|\tfor member := range probeCapabilityMembers {\n255|\t\tgot = append(got, member)\n256|\t}\n257|\trequireMemberSet(t, \"probeCapabilityMembers\", got, codeSpansOf(t, sentence))\n258|}\n259|\n260|// TestIdentityMembersAreDerivedFromSpec proves the exact identity\n261|// member set equals the Section 5.5 table: a widened implementation\n262|// admitting \"bogus\" reddens here. The rows are read through the\n263|// document's own table index, so a window that drifts off the table\n264|// lands on lines no table row declares and fails closed.\n265|func TestIdentityMembersAreDerivedFromSpec(t *testing.T) {\n266|\tdocument, err := specdoc.Load()\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n269|\t}\n270|\twindow := sectionLines(t, document, \"5.5\", 2077, 2092)\n271|\t// The bare closed sentence repeats across sections, so the\n272|\t// quote carries its schema opener: only the 5.5 table it\n273|\t// introduces can satisfy it.\n274|\trequireQuote(t, document, \"The Provider Identity Record schema is <code>urn:ax:schema:provider-identity</code> version <code>1.0.0</code>. Its top-level object is closed and contains exactly:\", \"5.5\")\n275|\t_ = window\n276|\tvar want []string\n277|\tfor line := 2077; line <= 2092; line++ {\n278|\t\trow, ok := document.TableRowAt(line)\n279|\t\tif !ok {\n280|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n281|\t\t}\n282|\t\tif row.Header != \"Field\" {\n283|\t\t\tt.Fatalf(\"SPEC.md line %d declares %q, want a Field row; the check is blind\", line, row.Header)\n284|\t\t}\n285|\t\tif row.Identifier == \"\" {\n286|\t\t\tt.Fatalf(\"SPEC.md line %d declares an empty member; the check is blind\", line)\n287|\t\t}\n288|\t\twant = append(want, row.Identifier)\n289|\t}\n290|\tvar got []string\n291|\tfor member := range identityMembers {\n292|\t\tgot = append(got, member)\n293|\t}\n294|\trequireMemberSet(t, \"identityMembers\", got, want)\n295|}\n296|\n297|// TestIdentifyMembersAreDerivedFromSpec proves the exact\n298|// identify-session success member set equals the Section 7.5 row: a\n299|// widened implementation admitting \"bogus\" reddens here.\n300|func TestIdentifyMembersAreDerivedFromSpec(t *testing.T) {\n301|\tdocument, err := specdoc.Load()\n302|\tif err != nil {\n303|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n304|\t}\n305|\trow := sectionLines(t, document, \"7.5\", 3075, 3075)\n306|\tvar got []string\n307|\tfor member := range identifyMembers {\n308|\t\tgot = append(got, member)\n309|\t}\n310|\trequireMemberSet(t, \"identifyMembers\", got, objectCellMembersOf(t, row, \"matched_evidence\"))\n311|}\n312|\n313|// TestQuiesceMembersAreDerivedFromSpec proves the exact\n314|// SafeBoundaryProof member set equals the Section 7.5 type row: a\n315|// widened implementation admitting \"bogus\" reddens here.\n316|func TestQuiesceMembersAreDerivedFromSpec(t *testing.T) {\n317|\tdocument, err := specdoc.Load()\n318|\tif err != nil {\n319|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n320|\t}\n321|\trow := sectionLines(t, document, \"7.5\", 2891, 2891)\n322|\tvar got []string\n323|\tfor member := range quiesceMembers {\n324|\t\tgot = append(got, member)\n325|\t}\n326|\trequireMemberSet(t, \"quiesceMembers\", got, typeRowMembersOf(t, row, \"SafeBoundaryProof\"))\n327|}\n328|\n329|// TestSpawnMembersAreDerivedFromSpec proves the exact SpawnPlan\n330|// member set equals the Section 7.5 type row: a widened\n331|// implementation admitting \"bogus\" reddens here.\n332|func TestSpawnMembersAreDerivedFromSpec(t *testing.T) {\n333|\tdocument, err := specdoc.Load()\n334|\tif err != nil {\n335|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n336|\t}\n337|\trow := sectionLines(t, document, \"7.5\", 2890, 2890)\n338|\tvar got []string\n339|\tfor member := range spawnMembers {\n340|\t\tgot = append(got, member)\n341|\t}\n342|\trequireMemberSet(t, \"spawnMembers\", got, typeRowMembersOf(t, row, \"SpawnPlan\"))\n343|}\n344|\n345|// TestStatusBodyMembersAreDerivedFromSpec proves the exact status\n346|// member set equals the Section 7.5 ProviderTransactionStatus row: a\n347|// widened implementation admitting \"bogus\" reddens here.\n348|func TestStatusBodyMembersAreDerivedFromSpec(t *testing.T) {\n349|\tdocument, err := specdoc.Load()\n350|\tif err != nil {\n351|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n352|\t}\n353|\trow := sectionLines(t, document, \"7.5\", 2905, 2905)\n354|\tvar got []string\n355|\tfor member := range statusBodyMembers {\n356|\t\tgot = append(got, member)\n357|\t}\n358|\trequireMemberSet(t, \"statusBodyMembers\", got, typeRowMembersOf(t, row, \"ProviderTransactionStatus\"))\n359|}\n360|\n361|// TestProfileYOLOMappingIsDerivedFromSpec proves the yolo mapping\n362|// holds exactly the six Section 7.7 provider rows with the row's own\n363|// flag: a seventh provider entry returns its flag instead of\n364|// invalid_config and reddens here. The Pi row carries no flag, only\n365|// the reported tool-set name, so a span holding a quoted value\n366|// resolves to the value inside the quotes.\n367|func TestProfileYOLOMappingIsDerivedFromSpec(t *testing.T) {\n368|\tdocument, err := specdoc.Load()\n369|\tif err != nil {\n370|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n371|\t}\n372|\twindow := sectionLines(t, document, \"7.7\", 3431, 3436)\n373|\trequireQuote(t, document, \"The v0.3.0 <code>yolo</code> mappings are:\", \"7.7\")\n374|\t_ = window\n375|\tderived := map[string]string{}\n376|\tvar providers []string\n377|\tfor line := 3431; line <= 3436; line++ {\n378|\t\ttext, ok := document.Line(line)\n379|\t\tif !ok {\n380|\t\t\tt.Fatalf(\"SPEC.md line %d is missing; the check is blind\", line)\n381|\t\t}\n382|\t\trow, ok := document.TableRowAt(line)\n383|\t\tif !ok {\n384|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n385|\t\t}\n386|\t\tif row.Header != \"Provider\" {\n387|\t\t\tt.Fatalf(\"SPEC.md line %d declares %q, want a Provider row; the check is blind\", line, row.Header)\n388|\t\t}\n389|\t\tfields := strings.Fields(row.FirstCell)\n390|\t\tif len(fields) == 0 {\n391|\t\t\tt.Fatalf(\"SPEC.md line %d names no provider; the check is blind\", line)\n392|\t\t}\n393|\t\tprovider := strings.ToLower(fields[0])\n394|\t\tspans := codeSpanPattern.FindAllStringSubmatch(text, -1)\n395|\t\tif len(spans) == 0 {\n396|\t\t\tt.Fatalf(\"SPEC.md line %d holds no code elements; the check is blind\", line)\n397|\t\t}\n398|\t\tflag := spans[0][1]\n399|\t\tif first, last := strings.Index(flag, `\"`), strings.LastIndex(flag, `\"`); first >= 0 && last > first {\n400|\t\t\tflag = flag[first+1 : last]\n401|\t\t}\n402|\t\tif flag == \"\" {\n403|\t\t\tt.Fatalf(\"SPEC.md line %d resolves to an empty mapping; the check is blind\", line)\n404|\t\t}\n405|\t\tif _, repeated := derived[provider]; repeated {\n406|\t\t\tt.Fatalf(\"SPEC.md names provider %q twice; the check is blind\", provider)\n407|\t\t}\n408|\t\tderived[provider] = flag\n409|\t\tproviders = append(providers, provider)\n410|\t}\n411|\tif len(derived) == 0 {\n412|\t\tt.Fatal(\"derived no provider mappings from the Section 7.7 table; the check is blind\")\n413|\t}\n414|\tif !reflect.DeepEqual(derived, profileYOLOMapping) {\n415|\t\tt.Fatalf(\"profileYOLOMapping = %v, want the Section 7.7 table %v\", profileYOLOMapping, derived)\n416|\t}\n417|\tsorted := append([]string(nil), providers...)\n418|\tsort.Strings(sorted)\n419|\tregistered := append([]string(nil), profileProviders...)\n420|\tsort.Strings(registered)\n421|\tif !reflect.DeepEqual(sorted, registered) {\n422|\t\tt.Fatalf(\"Section 7.7 providers = %v, want the registry %v\", sorted, registered)\n423|\t}\n424|\tt.Logf(\"profile mapping coverage: %d/%d providers derived\", len(derived), len(providers))\n425|}\n426|\n427|// TestResponseMembersAreDerivedFromSpec proves the exact response\n428|// envelope member set equals the Section 7.2 union: the success\n429|// sentence names protocol, protocol_version, request_id, ok, and\n430|// body, and the failure sentence adds error without body. The ok\n431|// spans carry their boolean value (`ok = true`, `ok = false`), which\n432|// is normalized to the member name. A seventh implementation member\n433|// admitting \"bogus\" reddens here.\n434|func TestResponseMembersAreDerivedFromSpec(t *testing.T) {\n435|\tdocument, err := specdoc.Load()\n436|\tif err != nil {\n437|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n438|\t}\n439|\twindow := sectionLines(t, document, \"7.2\", 2708, 2712)\n440|\trequireQuote(t, document, \"unknown members are protocol errors under major version 2\", \"7.2\")\n441|\tnormalize := func(span string) string {\n442|\t\tfor _, suffix := range []string{\" = true\", \" = false\"} {\n443|\t\t\tspan = strings.TrimSuffix(span, suffix)\n444|\t\t}\n445|\t\treturn span\n446|\t}\n447|\tseen := map[string]bool{}\n448|\tvar want []string\n449|\tfor _, span := range codeSpansOf(t, window) {\n450|\t\tname := normalize(span)\n451|\t\tif name == \"\" {\n452|\t\t\tt.Fatalf(\"Section 7.2 envelope sentence parses to an empty member; the check is blind\")\n453|\t\t}\n454|\t\tif !seen[name] {\n455|\t\t\tseen[name] = true\n456|\t\t\twant = append(want, name)\n457|\t\t}\n458|\t}\n459|\tvar got []string\n460|\tfor member := range responseMembers {\n461|\t\tgot = append(got, member)\n462|\t}\n463|\trequireMemberSet(t, \"responseMembers\", got, want)\n464|}\n465|\n466|// TestProfileNamesAreDerivedFromSpec proves the exact execution\n467|// profile vocabulary equals the two Section 7.7 profile sentences:\n468|// the yolo sentence names yolo, the standard sentence names\n469|// standard. Each sentence must carry exactly its own profile span,\n470|// so a sentence that drifts onto another member fails closed. A\n471|// third implementation profile resolving \"bogus\" to the unrestricted\n472|// flag reddens here.\n473|func TestProfileNamesAreDerivedFromSpec(t *testing.T) {\n474|\tdocument, err := specdoc.Load()\n475|\tif err != nil {\n476|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n477|\t}\n478|\trequireQuote(t, document, \"The v0.3.0 <code>yolo</code> mappings are:\", \"7.7\")\n479|\trequireQuote(t, document, \"<code>standard</code> MUST use the provider's normal approval/sandbox behavior\", \"7.7\")\n480|\tyolo := codeSpansOf(t, sectionLines(t, document, \"7.7\", 3427, 3427))\n481|\tif len(yolo) != 1 || yolo[0] != \"yolo\" {\n482|\t\tt.Fatalf(\"Section 7.7 yolo sentence names %v, want exactly [yolo]; the check is blind\", yolo)\n483|\t}\n484|\tstandard := codeSpansOf(t, sectionLines(t, document, \"7.7\", 3438, 3438))\n485|\tif len(standard) != 1 || standard[0] != \"standard\" {\n486|\t\tt.Fatalf(\"Section 7.7 standard sentence names %v, want exactly [standard]; the check is blind\", standard)\n487|\t}\n488|\tvar got []string\n489|\tfor profile := range profileNames {\n490|\t\tgot = append(got, profile)\n491|\t}\n492|\trequireMemberSet(t, \"profileNames\", got, []string{\"standard\", \"yolo\"})\n493|}\n494|\n495|// TestStatusStatesAreDerivedFromSpec proves the exact transaction\n496|// state vocabulary equals the Section 7.5 ProviderTransactionStatus\n497|// row: a fifth implementation state decoding \"bogus\" as durable\n498|// state reddens here.\n499|func TestStatusStatesAreDerivedFromSpec(t *testing.T) {\n500|\tdocument, err := specdoc.Load()\n(more lines below)","final_result":true}}}
