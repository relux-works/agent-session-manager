{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75b","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":520,"recorded_at":1780531400001035,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"task_stream":{"kind":"task","id":"01a0adbc-c877-7332-bcd6-6345d128f2aa"},"task_id":"01a0adbc-c877-7332-bcd6-6345d128f2aa","event":{"kind":"output","task_id":"01a0adbc-c877-7332-bcd6-6345d128f2aa","chunk":"Read text file `internal/provhost/identity_bind_test.go`.\n(417 line(s) above)\n418|// TestResumeProvidersAreDerivedFromSpec proves the resume gate holds\n419|// exactly the six Section 8.2 direct providers: a seventh member\n420|// resolving store roots or passing tuples reddens here, and the Qwen\n421|// and future-plugin rows below the six stay refused by their own\n422|// arms rather than admitted by the table.\n423|func TestResumeProvidersAreDerivedFromSpec(t *testing.T) {\n424|\tdocument, err := specdoc.Load()\n425|\tif err != nil {\n426|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n427|\t}\n428|\twindow := sectionLines(t, document, \"8.2\", 3865, 3870)\n429|\trequireQuote(t, document, \"Muse and Antigravity rows above are normative uses\", \"8.2\")\n430|\t_ = window\n431|\tvar derived []string\n432|\tfor line := 3865; line <= 3870; line++ {\n433|\t\trow, ok := document.TableRowAt(line)\n434|\t\tif !ok {\n435|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n436|\t\t}\n437|\t\tif row.Header != \"Provider\" {\n438|\t\t\tt.Fatalf(\"SPEC.md line %d declares %q, want a Provider row; the check is blind\", line, row.Header)\n439|\t\t}\n440|\t\tfields := strings.Fields(row.FirstCell)\n441|\t\tif len(fields) == 0 {\n442|\t\t\tt.Fatalf(\"SPEC.md line %d names no provider; the check is blind\", line)\n443|\t\t}\n444|\t\tderived = append(derived, strings.ToLower(fields[0]))\n445|\t}\n446|\tif len(derived) == 0 {\n447|\t\tt.Fatal(\"derived no providers from the Section 8.2 table; the check is blind\")\n448|\t}\n449|\trequireMemberSet(t, \"resumeProviders\", append([]string(nil), resumeProviders...), derived)\n450|\tfor line := 3871; line <= 3872; line++ {\n451|\t\trow, ok := document.TableRowAt(line)\n452|\t\tif !ok {\n453|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n454|\t\t}\n455|\t\texcluded := strings.ToLower(strings.Fields(row.FirstCell)[0])\n456|\t\tfor _, provider := range resumeProviders {\n457|\t\t\tif provider == excluded {\n458|\t\t\t\tt.Fatalf(\"resumeProviders admits the %q row, which must refuse by its own arm\", excluded)\n459|\t\t\t}\n460|\t\t}\n461|\t}\n462|\tt.Logf(\"resume provider coverage: %d/%d providers derived\", len(resumeProviders), len(derived))\n463|}\n464|\n465|// TestDiscoveryMembersAreDerivedFromSpec proves the exact discovery\n466|// member set equals the Section 7.5 NativeDiscoveryProof row: a\n467|// widened implementation admitting \"bogus\" reddens here.\n468|func TestDiscoveryMembersAreDerivedFromSpec(t *testing.T) {\n469|\tdocument, err := specdoc.Load()\n470|\tif err != nil {\n471|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n472|\t}\n473|\trow := sectionLines(t, document, \"7.5\", 2893, 2893)\n474|\tvar got []string\n475|\tfor member := range discoveryMembers {\n476|\t\tgot = append(got, member)\n477|\t}\n478|\trequireMemberSet(t, \"discoveryMembers\", got, typeRowMembersOf(t, row, \"NativeDiscoveryProof\"))\n479|}","final_result":true}}}
