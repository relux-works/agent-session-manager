{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce9b","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":1448,"recorded_at":1780531400002891,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"call_id":"call_01a0adc5a08d74df9ced68b73e9d1655","text":"{\n  \"chunk_id\": \"exec-45-1\",\n  \"command\": \"task-board m 'schema(mutation=add_resource)' 2>&1 | python3 -c \\\"import json,sys; d=json.load(sys.stdin); print(json.dumps(d['mutationMetadata']['add_resource'], indent=1))\\\"; echo; task-board resources --help 2>&1 | head -n 30; task-board --help 2>&1 | head -n 40\",\n  \"description\": \"Inspect resource attach options for binaries\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\n \\\"description\\\": \\\"Add a text resource to an element\\\",\\n \\\"parameters\\\": [\\n  {\\n   \\\"name\\\": \\\"id\\\",\\n   \\\"type\\\": \\\"string\\\",\\n   \\\"optional\\\": false,\\n   \\\"description\\\": \\\"Element ID\\\",\\n   \\\"required\\\": true\\n  },\\n  {\\n   \\\"name\\\": \\\"name\\\",\\n   \\\"type\\\": \\\"string\\\",\\n   \\\"optional\\\": false,\\n   \\\"description\\\": \\\"Resource name (e.g. research.md)\\\",\\n   \\\"required\\\": true\\n  },\\n  {\\n   \\\"name\\\": \\\"content\\\",\\n   \\\"type\\\": \\\"string\\\",\\n   \\\"optional\\\": true,\\n   \\\"description\\\": \\\"Resource content (text); required if path is not provided\\\"\\n  },\\n  {\\n   \\\"name\\\": \\\"path\\\",\\n   \\\"type\\\": \\\"string\\\",\\n   \\\"optional\\\": true,\\n   \\\"description\\\": \\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"\\n  },\\n  {\\n   \\\"name\\\": \\\"type\\\",\\n   \\\"type\\\": \\\"string\\\",\\n   \\\"optional\\\": true,\\n   \\\"default\\\": \\\"outcome\\\",\\n   \\\"description\\\": \\\"Resource type\\\",\\n   \\\"enum\\\": [\\n    \\\"precondition\\\",\\n    \\\"outcome\\\"\\n   ]\\n  },\\n  {\\n   \\\"name\\\": \\\"description\\\",\\n   \\\"type\\\": \\\"string\\\",\\n   \\\"optional\\\": true,\\n   \\\"description\\\": \\\"One-line description\\\"\\n  }\\n ],\\n \\\"examples\\\": [\\n  \\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\n  \\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"\\n ],\\n \\\"destructive\\\": false,\\n \\\"idempotent\\\": false\\n}\\n\\nunknown command \\\"resources\\\" for \\\"task-board\\\"\\n\\nDid you mean this?\\n\\tresource\\n\\nManage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  init                   Install task-board project integrations\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n\",\n  \"original_output_bytes\": 3712,\n  \"original_output_tokens\": 928,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
