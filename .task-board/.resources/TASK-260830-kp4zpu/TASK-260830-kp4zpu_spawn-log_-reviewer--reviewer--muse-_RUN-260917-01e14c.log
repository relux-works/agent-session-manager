nd undiscovered proof\", prove: func(t *testing.T) {\n220|\t\t\tproof := bindProof(bindNativeID, filepath.Join(bindHome, \".codex\", \"sessions\"), false, false, false)\n221|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, validDiscoveryContext()), \"invalid_config\", \"bind discovery evidence is absent\")\n222|\t\t}},\n223|\t\t{arm: `ctor|failInvalid|bind store override is pi-only`, name: \"bind codex override\", prove: func(t *testing.T) {\n224|\t\t\tctx := validDiscoveryContext()\n225|\t\t\tctx.StoreRootOverride = filepath.Join(bindHome, \"custom\")\n226|\t\t\tproof := bindProof(bindNativeID, filepath.Join(bindHome, \".codex\", \"sessions\"), false, true, false)\n227|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(bindIdentity(t), proof, ctx), \"invalid_config\", \"bind store override is pi-only\")\n228|\t\t}},\n229|\t\t{arm: `ctor|failInvalid|bind store override is not an absolute path`, name: \"bind relative pi override\", prove: func(t *testing.T) {\n230|\t\t\tparams := validCreateParams()\n231|\t\t\tparams.ProviderID = \"pi\"\n232|\t\t\tparams.ProviderVersion = \"0.73.1\"\n233|\t\t\tparams.ProviderVersionRange = \">=0.73.1 <0.74.0\"\n234|\t\t\tidentity := mustCreate(t, params)\n235|\t\t\tctx := validDiscoveryContext()\n236|\t\t\tctx.Build = BuildTuple{ProviderID: \"pi\", ProviderVersion: \"0.73.1\", Platform: \"macos\", Architecture: \"arm64\"}\n237|\t\t\tctx.StoreRootOverride = \"custom/relative\"\n238|\t\t\tproof := bindProof(params.NativeSessionID, filepath.Join(bindHome, \".pi\", \"agent\", \"sessions\"), false, true, false)\n239|\t\t\trequireLocalRefusal(t, VerifyIdentityDiscovery(identity, proof, ctx), \"invalid_config\", \"bind store override is not an absolute path\")\n240|\t\t}},\n241|\t\t{arm: `ctor|failInvalid|bind discovery root is missing`, name: \"bind null store root\", prove: func(t *testing.T) {\n242|\t\t\tproof := bindProof(bindNativeID, \"\", true, true, false)\n243|\t\t\trequireLocalRefusal(t, VerifyIdentit