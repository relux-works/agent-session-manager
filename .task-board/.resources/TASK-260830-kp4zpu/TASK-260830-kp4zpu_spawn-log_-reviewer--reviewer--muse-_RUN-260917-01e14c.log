ive resume but not portable storage.\\n\\n### 8.3 Capability matrix\\n\\n===V060-2893===\\n      \\\"enabled\\\": false,\\n===SPEC.md-2827===\\n      \\\"enabled\\\": false,\\n\",\n  \"original_output_bytes\": 6979,\n  \"original_output_tokens\": 1745,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
