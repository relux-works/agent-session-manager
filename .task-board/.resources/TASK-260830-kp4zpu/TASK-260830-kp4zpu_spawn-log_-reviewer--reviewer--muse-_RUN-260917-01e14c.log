{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c577","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":278,"recorded_at":1780531400000551,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"task_stream":{"kind":"task","id":"01a0adbc-5ff2-7f11-930c-35833faac53d"},"task_id":"01a0adbc-5ff2-7f11-930c-35833faac53d","event":{"kind":"output","task_id":"01a0adbc-5ff2-7f11-930c-35833faac53d","chunk":"Read text file `internal/provhost/testdata/mutate_identity.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants for provider-identity creation; never modify the managed Story checkout.\n3|Usage: PYTHONDONTWRITEBYTECODE=1 python3 internal/provhost/testdata/mutate_identity.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each gate by narrowing, never by deletion: every N-\n6|mutant keeps its gate present and weakens it to admit exactly one member\n7|of the class the gate must reject, and a named behavioral test must fail.\n8|Text-inspecting gates carry a token-preserving mutant, and the harness\n9|always executes the behavioral suites, never only a static checker.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|create_source = copy / 'internal/provhost/identity_create.go'\n30|create_base = create_source.read_text()\n31|bind_source = copy / 'internal/provhost/identity_bind.go'\n32|bind_base = bind_source.read_text()\n33|results = []\n34|\n35|REALM_A = 'sha256:' + 'a' * 63 + 'd'\n36|REALM_B = 'sha256:' + 'b' * 64\n37|\n38|# Keep each mutant bounded to the smallest named behavioral suite that can\n39|# observe its gate. This is still the same subprocess instrument and every\n40|# selected test drives a production entry point; the control rows run the\n41|# complete package. A missing mapping is a harness error, never an\n42|# accidental empty test selection.\n43|TEST_PATTERNS = {\n44|    'N-create-native-empty': r'^TestCreateIdentityRefusals$',\n45|    'N-create-opaque-abs': r'^TestCreateIdentityRefusals$',\n46|    'N-create-realm-required': r'^TestCreateIdentityRefusals$',\n47|    'N-create-backstop': r'^TestCreateIdentityRefusals$',\n48|    'N-create-kind': r'^TestCreateIdentityRefusals$',\n49|    'N-create-session': r'^TestCreateIdentityRefusals$',\n50|    'N-discovery-root': r'^TestDecodeNativeDiscoveryRefusals$',\n51|    'N-discovery-platform': r'^TestDecodeNativeDiscoveryRefusals$',\n52|    'N-store-unknown': r'^TestStoreRootForRefusals$',\n53|    'N-store-home': r'^TestStoreRootForRefusals$',\n54|    'N-store-qwen': r'^TestStoreRootForRefusals$',\n55|    'N-resume-qwen': r'^TestCheckResumeTupleRefusals$',\n56|    'N-resume-unknown': r'^TestCheckResumeTupleRefusals$',\n57|    'N-resume-muse-version': r'^TestCheckResumeTupleRefusals$',\n58|    'N-build-drift': r'^TestVerifyIdentityBuildRefusals$',\n59|    'N-bind-native': r'^TestVerifyIdentityDiscoveryRefusals$',\n60|    'N-bind-absent': r'^TestVerifyIdentityDiscoveryRefusals$',\n61|    'N-bind-contains': r'^TestVerifyIdentityDiscoveryRefusals$',\n62|    'N-bind-unresolved': r'^TestVerifyIdentityDiscoveryRefusals$',\n63|    'N-bind-override-pi': r'^TestVerifyIdentityDiscoveryRefusals$',\n64|    'N-bind-override-absolute': r'^TestVerifyIdentityDiscoveryRefusals$',\n65|    'N-bind-root-missing': r'^TestVerifyIdentityDiscoveryRefusals$',\n66|    'N-bind-realm-shape': r'^TestVerifyIdentityDiscoveryRefusals$',\n67|    'N-bind-realm-mismatch': r'^TestVerifyIdentityDiscoveryRefusals$',\n68|    'C-harmless-comment': None,\n69|    'C-not-applied': None,\n70|    'C-compile-failure': None,\n71|}\n72|\n73|def test_command(name):\n74|    pattern = TEST_PATTERNS.get(name, 'MISSING')\n75|    if pattern == 'MISSING':\n76|        raise SystemExit(f'no behavioral test mapping for {name}')\n77|    if pattern is None:\n78|        return ['go', 'test', './internal/provhost', '-count=1', '-v']\n79|    return ['go', 'test', './internal/provhost', '-run', pattern, '-count=1', '-v']\n80|\n81|def run(name, path, old, new, narrow):\n82|    original = path.read_text()\n83|    if original.count(old) != 1:\n84|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n85|        print(name, 'NOT_APPLIED', original.count(old), flush=True)\n86|        return\n87|    path.write_text(original.replace(old, new))\n88|    command = test_command(name)\n89|    try:\n90|        with (output / (name + '.log')).open('w') as log:\n91|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n92|        text = (output / (name + '.log')).read_text()\n93|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n94|        ran_tests = re.findall(r'^=== RUN ', text, re.M)\n95|        classification = 'COMPILE_OR_HARNESS_FAILURE' if not ran_tests else ('SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE'))\n96|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n97|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n98|    finally:\n99|        path.write_text(original)\n100|        assert hashlib.sha256(path.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n101|\n102|with (output / 'control-before.log').open('w') as log:\n103|    before = subprocess.run(['go','test','./internal/provhost','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n104|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n105|print('control-before', 'CONTROL', before.returncode, flush=True)\n106|if before.returncode:\n107|    raise SystemExit('baseline failed')\n108|run('N-create-native-empty',create_source,'if runeLength(params.NativeSessionID) < 1 || runeLength(params.NativeSessionID) > 512 {','if runeLength(params.NativeSessionID) < 0 || runeLength(params.NativeSessionID) > 512 {','Admit exactly the empty native session ID; overlong IDs still refuse.')\n109|run('N-create-opaque-abs',create_source,r'if strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {',r'if strings.HasSuffix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {','Preserve the searched-for \"/\" token while checking the wrong end; a leading-absolute opaque value is admitted while UNC and drive forms still refuse.')\n110|run('N-create-realm-required',create_source,'if params.ProviderID == \"antigravity\" && params.IdentityKind == \"backend_conversation_uuid\" && params.BackendRealm == \"\" {','if params.ProviderID == \"antigravity\" && params.IdentityKind == \"backend_conversation_uuid\" && params.BackendRealm == \"\" && params.NativeSessionID != \"11111111-2222-4333-8444-555555555555\" {','Admit exactly the fixture native ID past the Antigravity null-realm arm; the owner backstop still refuses it with a degraded detail.')\n111|run('N-create-backstop',create_source,'digest, _, err := canonicaljson.CalculateObjectIdentity(staged)\\n\\tif err != nil {','digest, _, err := canonicaljson.CalculateObjectIdentity(staged)\\n\\tif err != nil && params.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the fixture session past the owner backstop; the deep-extensions negative then succeeds with an empty record_id claim.')\n112|run('N-create-kind',create_source,'if !isIdentityKind(params.IdentityKind) {','if !isIdentityKind(params.IdentityKind) && params.IdentityKind != \"window_handle\" {','Admit exactly window_handle past the kind arm; the owner backstop still refuses it with a degraded detail.')\n113|run('N-create-session',create_source,'if !isUUIDv7(params.SessionID) {','if !isUUIDv7(params.SessionID) && params.SessionID != \"not-a-uuid\" {','Admit exactly not-a-uuid past the session arm; the owner backstop still refuses it with a degraded detail.')\n114|run('N-discovery-root',bind_source,'if !ok || (!isNull && !isAbsoluteOn(root, scalar.Platform(platform))) {','if !ok || (!isNull && !isAbsoluteOn(root, scalar.Platform(platform)) && root != \"sessions/admitted\") {','Admit exactly the sessions/admitted relative root; every other relative root still refuses.')\n115|run('N-discovery-platform',bind_source,'if !isProbePlatform(platform) {','if !isProbePlatform(platform) && platform != \"plan9\" {','Admit exactly the plan9 platform past the registry arm; the body then decodes and the refusal disappears.')\n116|run('N-store-unknown',bind_source,'if !isResumeProvider(providerID) {','if !isResumeProvider(providerID) && providerID != \"futuredesk\" {','Admit exactly futuredesk past the store registry arm; it silently resolves the pi root.')\n117|run('N-store-home',bind_source,'if !isBareAbsolute(home) {','if !isBareAbsolute(home) && home != \"Users/iv\" {','Admit exactly the Users/iv relative home; a relative store root is then resolved.')\n118|run('N-store-qwen',bind_source,'if providerID == \"qwen\" {','if providerID == \"qwen\" && home != \"/Users/iv\" {','Admit exactly the fixture home past the qwen arm; the registry arm still refuses it with a degraded detail.')\n119|run('N-resume-qwen',bind_source,'if tuple.ProviderID == \"qwen\" {','if tuple.ProviderID == \"qwen\" && tuple.Platform != \"linux\" {','Admit exactly the linux tuple past the qwen arm; the registry arm still refuses it with a degraded detail.')\n120|run('N-resume-unknown',bind_source,'if !isResumeProvider(tuple.ProviderID) {','if !isResumeProvider(tuple.ProviderID) && tuple.ProviderID != \"futuredesk\" {','Admit exactly futuredesk past the resume registry arm; the tuple then passes the gate.')\n121|run('N-resume-muse-version',bind_source,'if tuple.ProviderID == \"muse\" && tuple.Platform == \"macos\" && tuple.Architecture == \"arm64\" && tuple.ProviderVersion != \"0.1.0\" {','if tuple.ProviderID == \"muse\" && tuple.Platform == \"macos\" && tuple.Architecture == \"arm64\" && tuple.ProviderVersion != \"0.1.0\" && tuple.ProviderVersion != \"0.2.1\" {','Preserve the pinned 0.1.0 token while admitting exactly 0.2.1; every other unverified version still refuses.')\n122|run('N-build-drift',bind_source,'if version != tuple.ProviderVersion {','if version != tuple.ProviderVersion && tuple.ProviderVersion != \"0.148.0\" {','Admit exactly the 0.148.0 drifted build; every other drifted version still refuses.')\n123|run('N-bind-native',bind_source,'if proof.NativeSessionID != native {','if proof.NativeSessionID != native && proof.NativeSessionID != \"22222222-2222-4333-8444-555555555555\" {','Admit exactly the foreign fixture native ID; the proof then binds and the refusal disappears.')\n124|run('N-bind-absent',bind_source,'\\tif !proof.Discovered {','\\tif !proof.Discovered && !proof.HasDiscoveryRoot {','Admit exactly an undiscovered proof that still carries a root; a rootless undiscovered proof still refuses.')\n125|run('N-bind-contains',bind_source,'if !rootContains(expected, proof.DiscoveryRoot) {','if !rootContains(expected, proof.DiscoveryRoot) && proof.DiscoveryRoot != \"/Users/iv/.codex/sessions-evil\" {','Admit exactly the sibling-prefix root; every other foreign root still refuses.')\n126|run('N-bind-unresolved',bind_source,'if !isNull && !proof.BackendResolved {','if !isNull && !proof.BackendResolved && realm != \"' + REALM_A + '\" {','Admit exactly the fixture realm past the unresolved arm; the proof then binds and the refusal disappears.')\n127|run('N-bind-override-pi',bind_source,'if ctx.Build.ProviderID != \"pi\" {','if ctx.Build.ProviderID != \"pi\" && ctx.Build.ProviderID != \"codex\" {','Admit exactly codex past the pi-only arm; the root-containment arm still refuses it with a degraded detail.')\n128|run('N-bind-override-absolute',bind_source,'if !isAbsoluteOn(ctx.StoreRootOverride, scalar.Platform(ctx.Build.Platform)) {','if !isAbsoluteOn(ctx.StoreRootOverride, scalar.Platform(ctx.Build.Platform)) && ctx.StoreRootOverride != \"custom/relative\" {','Admit exactly the custom/relative override past the absolute arm; the root-containment arm still refuses it with a degraded detail.')\n129|run('N-bind-root-missing',bind_source,'\\tif !proof.HasDiscoveryRoot {','\\tif !proof.HasDiscoveryRoot && !proof.Discovered {','Admit exactly a discovered proof with a null root; the root-containment arm still refuses it with a degraded detail.')\n130|run('N-bind-realm-shape',bind_source,'if !isDigest(wantRealm) {','if !isDigest(wantRealm) && wantRealm != \"nope\" {','Admit exactly the nope realm past the shape arm; the realm-equality arm still refuses it with a degraded detail.')\n131|run('N-bind-realm-mismatch',bind_source,'if isNull || realm != wantRealm {','if isNull || realm != wantRealm && wantRealm != \"' + REALM_B + '\" {','Admit exactly the drifted fixture realm past the equality arm; the unresolved arm still refuses it with a degraded detail.')\n132|run('C-harmless-comment',bind_source,'// resolveBindRoot selects the expected store root: the caller override','// resolveBindRoot selects the expected store root: the caller override\\n// classifier control: comment only, no behavior change.','Applied control: a behavior-preserving plant survives through the same instrument.')\n133|run('C-not-applied',bind_source,'TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n134|run('C-compile-failure',bind_source,'package provhost','package provhost\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n135|with (output / 'control-after.log').open('w') as log:\n136|    after = subprocess.run(['go','test','./internal/provhost','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n137|results.append(dict(mutant='control-after',classification='CONTROL', exit=after.returncode))\n138|print('control-after', 'CONTROL', after.returncode, flush=True)\n139|assert create_source.read_text() == create_base and bind_source.read_text() == bind_base\n140|(output / 'mutants.json').write_text(json.dumps(results,indent=2)+'\\n')\n141|# Controls are reported separately from the applied behavioral denominator.\n142|bad = [row for row in results if row['mutant'].startswith('N-') and row['classification'] != 'KILLED']\n143|raise SystemExit(1 if bad or after.returncode else 0)","final_result":true}}}
