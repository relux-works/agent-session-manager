{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca21","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":875,"recorded_at":1780531400001745,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"task_stream":{"kind":"task","id":"01a0adbe-882e-7812-a352-137809ade9d4"},"task_id":"01a0adbe-882e-7812-a352-137809ade9d4","event":{"kind":"output","task_id":"01a0adbe-882e-7812-a352-137809ade9d4","chunk":"Read text file `internal/provhost/identity_bind_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// This file proves the identity_bind.go production entries: the\n12|// NativeDiscoveryProof decoder, the Section 8.2 store-root table, the\n13|// Section 8.4 resume-tuple gate, and the build and discovery binding\n14|// verifiers. Every refusal below drives its production entry; the\n15|// arm witnesses in refusal_arm_operations_d_test.go pin each derived\n16|// arm to one of these entries.\n17|\n18|const (\n19|\tbindSessionID   = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n20|\tbindWorkspaceID = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n21|\tbindHostID      = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n22|\tbindNativeID    = \"11111111-2222-4333-8444-555555555555\"\n23|\tbindRealm       = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"\n24|\tbindHome        = \"/Users/iv\"\n25|)\n26|\n27|// validBuildTuple returns the codex macOS arm64 tuple the binding\n28|// tests correlate against created codex identities.\n29|func validBuildTuple() BuildTuple {\n30|\treturn BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n31|}\n32|\n33|// bindIdentity creates the codex identity matching validBuildTuple.\n34|func bindIdentity(t *testing.T) []byte {\n35|\tt.Helper()\n36|\tparams := validCreateParams()\n37|\tparams.SessionID = bindSessionID\n38|\tparams.LogicalWorkspaceID = bindWorkspaceID\n39|\tparams.CreatedByHostID = bindHostID\n40|\tparams.NativeSessionID = bindNativeID\n41|\treturn mustCreate(t, params)\n42|}\n43|\n44|// bindProof renders one discovery proof body for the tests below.\n45|func bindProof(native, root string, nullRoot, discovered, backendResolved bool) []byte {\n46|\trootLiteral := \"null\"\n47|\tif !nullRoot {\n48|\t\trootLiteral = `\"` + root + `\"`\n49|\t}\n50|\tboolLiteral := func(value bool) string {\n51|\t\tif value {\n52|\t\t\treturn \"true\"\n53|\t\t}\n54|\t\treturn \"false\"\n55|\t}\n56|\treturn []byte(`{\"native_session_id\": \"` + native + `\", \"discovered\": ` + boolLiteral(discovered) + `, \"discovery_root\": ` + rootLiteral + `, \"backend_resolved\": ` + boolLiteral(backendResolved) + `}`)\n57|}\n58|\n59|// validDiscoveryContext returns the context matching validBuildTuple\n60|// under bindHome with no expected realm and no override.\n61|func validDiscoveryContext() DiscoveryContext {\n62|\treturn DiscoveryContext{Build: validBuildTuple(), Home: bindHome}\n63|}\n64|\n65|// TestDecodeNativeDiscoveryPositive proves both proof shapes decode:\n66|// a null root for backend-resolved discovery and an absolute root\n67|// for store discovery.\n68|func TestDecodeNativeDiscoveryPositive(t *testing.T) {\n69|\tproof, err := DecodeNativeDiscovery(bindProof(bindNativeID, \"\", true, true, true), \"macos\")\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"null-root proof: %v\", err)\n72|\t}\n73|\tif proof.NativeSessionID != bindNativeID || !proof.Discovered || proof.HasDiscoveryRoot || !proof.BackendResolved {\n74|\t\tt.Fatalf(\"null-root proof decodes to %+v\", proof)\n75|\t}\n76|\tproof, err = DecodeNativeDiscovery(bindProof(bindNativeID, \"/Users/iv/.codex/sessions\", false, true, false), \"macos\")\n77|\tif err != nil {\n78|\t\tt.Fatalf(\"rooted proof: %v\", err)\n79|\t}\n80|\tif proof.NativeSessionID != bindNativeID || !proof.Discovered || !proof.HasDiscoveryRoot || proof.DiscoveryRoot != \"/Users/iv/.codex/sessions\" || proof.BackendResolved {\n(more lines below)","final_result":true}}}
