rived) == 0 {\n447|\t\tt.Fatal(\"derived no providers from the Section 8.2 table; the check is blind\")\n448|\t}\n449|\trequireMemberSet(t, \"resumeProviders\", append([]string(nil), resumeProviders...), derived)\n450|\tfor line := 3871; line <= 3872; line++ {\n451|\t\trow, ok := document.TableRowAt(line)\n452|\t\tif !ok {\n453|\t\t\tt.Fatalf(\"SPEC.md line %d is not a table body row; the check is blind\", line)\n454|\t\t}\n455|\t\texcluded := strings.ToLower(strings.Fields(row.FirstCell)[0])\n456|\t\tfor _, provider := range resumeProviders {\n457|\t\t\tif provider == excluded {\n458|\t\t\t\tt.Fatalf(\"resumeProviders admits the %q row, which must refuse by its own arm\", excluded)\n459|\t\t\t}\n460|\t\t}\n461|\t}\n462|\tt.Logf(\"resume provider coverage: %d/%d providers derived\", len(resumeProviders), len(derived))\n463|}\n464|\n465|// TestDiscoveryMembersAreDerivedFromSpec proves the exact discovery\n466|// member set equals the Section 7.5 NativeDiscoveryProof row: a\n467|// widened implementation admitting \"bogus\" reddens here.\n468|func TestDiscoveryMembersAreDerivedFromSpec(t *testing.T) {\n469|\tdocument, err := specdoc.Load()\n470|\tif err != nil {\n471|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n472|\t}\n473|\trow := sectionLines(t, document, \"7.5\", 2893, 2893)\n474|\tvar got []string\n475|\tfor member := range discoveryMembers {\n476|\t\tgot = append(got, member)\n477|\t}\n478|\trequireMemberSet(t, \"discoveryMembers\", got, typeRowMembersOf(t, row, \"NativeDiscoveryProof\"))\n479|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
