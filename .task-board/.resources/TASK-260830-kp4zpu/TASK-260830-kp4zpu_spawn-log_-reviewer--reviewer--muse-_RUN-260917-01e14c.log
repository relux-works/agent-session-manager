{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6cd","stream":{"kind":"session","id":"01a0adbb-d982-7d33-a597-bf4c4953f6b8"},"sequence":449,"recorded_at":1780531400000893,"record_type":"event","durability":"durable","causation_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5d52738d-e67a-4909-b1e5-6f3604d03379","run_stream":{"kind":"run","id":"5d52738d-e67a-4909-b1e5-6f3604d03379"},"task_stream":{"kind":"task","id":"01a0adbc-ae21-7fc1-bf41-2c4fa7119361"},"task_id":"01a0adbc-ae21-7fc1-bf41-2c4fa7119361","event":{"kind":"output","task_id":"01a0adbc-ae21-7fc1-bf41-2c4fa7119361","chunk":"Read text file `internal/provhost/closed_vocabulary_census_test.go`.\n(699 line(s) above)\n700|\t\t\t\tranged[name.Name] = true\n701|\t\t\t}\n702|\t\t\treturn true\n703|\t\t})\n704|\t}\n705|\tvocabularies := map[string]struct{}{}\n706|\tfor name := range shapes {\n707|\t\tif unknownUsed[name] || indexed[name] || ranged[name] {\n708|\t\t\tvocabularies[name] = struct{}{}\n709|\t\t}\n710|\t}\n711|\tsort.Strings(scanned)\n712|\treturn vocabularies, scanned, nil\n713|}\n714|\n715|// valueShape reports whether a package-level variable declaration is\n716|// one of the three membership-vocabulary shapes: a []string, a\n717|// map[string]bool, or a map[string]string. Anything else reports \"\".\n718|func valueShape(value *ast.ValueSpec) string {\n719|\tcandidate := value.Type\n720|\tif candidate == nil && len(value.Values) == 1 {\n721|\t\tif literal, ok := value.Values[0].(*ast.CompositeLit); ok {\n722|\t\t\tcandidate = literal.Type\n723|\t\t}\n724|\t}\n725|\tswitch shape := candidate.(type) {\n726|\tcase *ast.ArrayType:\n727|\t\tif shape.Len != nil {\n728|\t\t\treturn \"\"\n729|\t\t}\n730|\t\tif ident, ok := shape.Elt.(*ast.Ident); ok && ident.Name == \"string\" {\n731|\t\t\treturn \"slice\"\n732|\t\t}\n733|\tcase *ast.MapType:\n734|\t\tkey, ok := shape.Key.(*ast.Ident)\n735|\t\tif !ok || key.Name != \"string\" {\n736|\t\t\treturn \"\"\n737|\t\t}\n738|\t\tif ident, ok := shape.Value.(*ast.Ident); ok && (ident.Name == \"bool\" || ident.Name == \"string\") {\n739|\t\t\treturn \"map\"\n740|\t\t}\n741|\t}\n742|\treturn \"\"\n743|}\n744|\n745|// vocabularyDerivation ties one derived membership vocabulary to the\n746|// test that proves it against the pinned document. The prove\n747|// function executes the real spec read: a registration pointing at\n748|// nothing that checks the vocabulary would pass vacuously.\n749|type vocabularyDerivation struct {\n750|\tname  string\n751|\tprove func(*testing.T)\n752|}\n753|\n754|// registeredVocabularyDerivations lists every membership vocabulary\n755|// the census may find, each with the derivation that pins it. The\n756|// eight enum and two registry entries reuse their covering tests\n757|// with no restatement; the nine member-set and mapping entries plus\n758|// the three formerly-switch vocabularies are proven above.\n759|func registeredVocabularyDerivations() []vocabularyDerivation {\n760|\treturn []vocabularyDerivation{\n761|\t\t{name: \"probeCapabilityStatuses\", prove: TestProbeStatusVocabularyIsDerivedFromSpec},\n762|\t\t{name: \"probeCapabilityEvidence\", prove: TestProbeEvidenceVocabularyIsDerivedFromSpec},\n763|\t\t{name: \"probeArchitectures\", prove: TestProbeArchitecturesAreDerivedFromSpec},\n764|\t\t{name: \"probePlatforms\", prove: TestProbePlatformsAreDerivedFromSpec},\n765|\t\t{name: \"quiesceBlockers\", prove: TestQuiesceBlockersAreDerivedFromSpec},\n766|\t\t{name: \"identityKinds\", prove: TestIdentityKindsAreDerivedFromSpec},\n767|\t\t{name: \"identifyConfidences\", prove: TestIdentifyVocabulariesAreDerivedFromSpec},\n768|\t\t{name: \"identifyEvidence\", prove: TestIdentifyVocabulariesAreDerivedFromSpec},\n769|\t\t{name: \"capabilityOrder\", prove: TestManifestRegistriesAreDerivedFromSpec},\n770|\t\t{name: \"manifestPlatforms\", prove: TestManifestRegistriesAreDerivedFromSpec},\n771|\t\t{name: \"manifestMembers\", prove: TestManifestMembersAreDerivedFromSpec},\n772|\t\t{name: \"probeMembers\", prove: TestProbeMembersAreDerivedFromSpec},\n773|\t\t{name: \"probeCapabilityMembers\", prove: TestProbeCapabilityMembersAreDerivedFromSpec},\n774|\t\t{name: \"identityMembers\", prove: TestIdentityMembersAreDerivedFromSpec},\n775|\t\t{name: \"identifyMembers\", prove: TestIdentifyMembersAreDerivedFromSpec},\n776|\t\t{name: \"quiesceMembers\", prove: TestQuiesceMembersAreDerivedFromSpec},\n777|\t\t{name: \"spawnMembers\", prove: TestSpawnMembersAreDerivedFromSpec},\n778|\t\t{name: \"statusBodyMembers\", prove: TestStatusBodyMembersAreDerivedFromSpec},\n779|\t\t{name: \"profileYOLOMapping\", prove: TestProfileYOLOMappingIsDerivedFromSpec},\n780|\t\t{name: \"responseMembers\", prove: TestResponseMembersAreDerivedFromSpec},\n781|\t\t{name: \"profileNames\", prove: TestProfileNamesAreDerivedFromSpec},\n782|\t\t{name: \"statusStates\", prove: TestStatusStatesAreDerivedFromSpec},\n783|\t\t{name: \"resumeProviders\", prove: TestResumeProvidersAreDerivedFromSpec},\n784|\t\t{name: \"discoveryMembers\", prove: TestDiscoveryMembersAreDerivedFromSpec},\n785|\t}\n786|}\n787|\n788|// TestClosedVocabularyCensusCoversEveryMembershipVocabulary checks\n789|// both directions of the census: every derived vocabulary carries a\n790|// registered spec derivation, and every registered derivation names\n791|// a derived vocabulary, so a truncated scan reddens on the orphaned\n792|// registrations instead of passing vacuously. Each derivation then\n793|// executes: the census proves containment, not reachability.\n794|func TestClosedVocabularyCensusCoversEveryMembershipVocabulary(t *testing.T) {\n795|\tfound := deriveMembershipVocabularies(t)\n796|\tregistered := registeredVocabularyDerivations()\n797|\tif len(registered) == 0 {\n798|\t\tt.Fatal(\"registered no vocabulary derivations; the census is blind, not the package\")\n799|\t}\n800|\tbyName := map[string]func(*testing.T){}\n801|\tfor _, entry := range registered {\n802|\t\tif _, repeated := byName[entry.name]; repeated {\n803|\t\t\tt.Fatalf(\"vocabulary %q carries two registered derivations; the census is ambiguous\", entry.name)\n804|\t\t}\n805|\t\tbyName[entry.name] = entry.prove\n806|\t}\n807|\tfor name := range found {\n808|\t\tif _, ok := byName[name]; !ok {\n809|\t\t\tt.Fatalf(\"membership vocabulary %q has no registered spec derivation; widening it passes silently\", name)\n810|\t\t}\n811|\t}\n812|\tfor _, entry := range registered {\n813|\t\tif _, ok := found[entry.name]; !ok {\n814|\t\t\tt.Fatalf(\"registered derivation %q names no production vocabulary; the census is short\", entry.name)\n815|\t\t}\n816|\t}\n817|\tfor _, entry := range registered {\n818|\t\tt.Run(entry.name, entry.prove)\n819|\t}\n820|\tt.Logf(\"vocabulary census coverage: %d/%d vocabularies derived\", len(found), len(registered))\n821|}\n822|\n823|// TestClosedMemberSetsRefuseExtraMembers drives one extra \"bogus\"\n824|// member per closed object through its production entry point: each\n825|// is refused under its own arm, so a member set that admits one more\n826|// value reddens here as well as in its derivation test. The\n827|// production call site is named in every row.\n828|func TestClosedMemberSetsRefuseExtraMembers(t *testing.T) {\n829|\tt.Run(\"manifest carries bogus\", func(t *testing.T) {\n830|\t\tbody := manifestVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n831|\t\trequireFrameRefusal(t, DecodeManifest(body), \"bogus\", \"unknown member\")\n832|\t})\n833|\tt.Run(\"probe carries bogus\", func(t *testing.T) {\n834|\t\tbody := probeVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n835|\t\trequireFrameRefusal(t, DecodeProbe(body), \"bogus\", \"unknown member\")\n836|\t})\n837|\tt.Run(\"probe capability carries bogus\", func(t *testing.T) {\n838|\t\tbody := probeVariant(t, \"\\\"status\\\": \\\"available\\\",\\n      \\\"enabled\\\": true,\", \"\\\"status\\\": \\\"available\\\",\\n      \\\"bogus\\\": 1,\\n      \\\"enabled\\\": true,\")\n839|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"unknown member\")\n840|\t})\n841|\tt.Run(\"identity carries bogus\", func(t *testing.T) {\n842|\t\tbody := identityVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n843|\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"bogus\", \"unknown member\")\n844|\t})\n845|\tt.Run(\"identify result carries bogus\", func(t *testing.T) {\n846|\t\tbody := identifyResultVariant(t, `\"confidence\": \"exact\"`, \"\\\"bogus\\\": 1,\\n  \\\"confidence\\\": \\\"exact\\\"\")\n847|\t\trequireFrameRefusal(t, DecodeIdentifyResult(body, \"antigravity\"), \"bogus\", \"unknown member\")\n848|\t})\n849|\tt.Run(\"quiesce proof carries bogus\", func(t *testing.T) {\n850|\t\tbody := quiesceVariant(t, `\"provider_id\": \"codex\",`, \"\\\"provider_id\\\": \\\"codex\\\",\\n  \\\"bogus\\\": 1,\")\n851|\t\trequireFrameRefusal(t, quiesceErr(body), \"bogus\", \"unknown member\")\n852|\t})\n853|\tt.Run(\"spawn plan carries bogus\", func(t *testing.T) {\n854|\t\tbody := spawnVariant(t, `\"cwd\":`, \"\\\"bogus\\\": 1,\\n  \\\"cwd\\\":\")\n855|\t\trequireFrameRefusal(t, DecodeSpawnPlan(body, \"codex\", ProfileYOLO, scalar.PlatformLinux), \"bogus\", \"unknown member\")\n856|\t})\n857|\tt.Run(\"status body carries bogus\", func(t *testing.T) {\n858|\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n859|\t\textra := []byte(strings.Replace(string(body), \"{\\\"materialization_id\\\":\", \"{\\\"bogus\\\":1,\\\"materialization_id\\\":\", 1))\n860|\t\t_, err := DecodeStatusOutcome(extra, testStatusIDs())\n861|\t\trequireLocalRefusal(t, err, \"integrity_failure\", \"unknown member\")\n862|\t})\n863|\tt.Run(\"profile mapping names bogus\", func(t *testing.T) {\n864|\t\t_, err := ProfileMapping(\"bogus\", ProfileYOLO)\n865|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown provider\")\n866|\t})\n867|\tt.Run(\"envelope carries bogus\", func(t *testing.T) {\n868|\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":{},\"bogus\":[]`), mustUUIDv7(t, testRequestID))\n869|\t\trequireFrameRefusal(t, err, \"bogus\", \"unknown member\")\n870|\t})\n871|\tt.Run(\"profile mapping names bogus profile\", func(t *testing.T) {\n872|\t\t_, err := ProfileMapping(\"codex\", \"bogus\")\n873|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown profile\")\n874|\t})\n875|\tt.Run(\"status body carries bogus state\", func(t *testing.T) {\n876|\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"bogus\", testRollbackToken, testDiscovery)\n877|\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n878|\t\trequireLocalRefusal(t, err, \"integrity_failure\", \"status state is not a registry member\")\n879|\t})\n880|\tt.Run(\"discovery proof carries bogus\", func(t *testing.T) {\n881|\t\tbody := []byte(`{\"native_session_id\": \"x\", \"discovered\": true, \"discovery_root\": null, \"backend_resolved\": false, \"bogus\": 1}`)\n882|\t\t_, err := DecodeNativeDiscovery(body, \"macos\")\n883|\t\trequireFrameRefusal(t, err, \"bogus\", \"unknown member\")\n884|\t})\n885|\tt.Run(\"resume gate names bogus provider\", func(t *testing.T) {\n886|\t\ttuple := validBuildTuple()\n887|\t\ttuple.ProviderID = \"bogus\"\n888|\t\trequireLocalRefusal(t, CheckResumeTuple(tuple), \"invalid_config\", \"unknown provider\")\n889|\t})\n890|}","final_result":true}}}
