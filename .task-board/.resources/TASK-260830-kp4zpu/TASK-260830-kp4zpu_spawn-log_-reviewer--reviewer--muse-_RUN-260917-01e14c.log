carries a Section 8.2',\\n   '// isResumeProvider reports whether the provider carries a Section 8.2\\\\n// reviewer control: comment only.',\\n   ['go','test','./internal/provhost','-count=1']),\\n]\\nfor name, path, old, new, cmd in plants:\\n    orig = path.read_text()\\n    assert orig.count(old)==1, (name, orig.count(old))\\n    path.write_text(orig.replace(old, new))\\n    try:\\n        log = (out/(name+'.log')).open('w')\\n        p = subprocess.run(cmd, cwd=base, stdout=log, stderr=subprocess.STDOUT, timeout=180)\\n        log.close()\\n        text = (out/(name+'.log')).read_text()\\n        fails = re.findall(r'^\\\\s*--- FAIL: ([^ ]+)', text, re.M)\\n        ran = len(re.findall(r'^=== RUN ', text, re.M)) > 0\\n        cls = 'COMPILE_OR_HARNESS_FAILURE' if not ran else ('SURVIVED' if p.returncode==0 else ('KILLED' if fails else 'COMPILE_OR_HARNESS_FAILURE'))\\n        print(name, cls, 'exit='+str(p.returncode), ','.join(fails[:4]))\\n    finally:\\n        path.write_text(orig)\\nEOF\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/own_mut.py\",\n  \"description\": \"Apply and execute four own narrowing mutants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"M1-opaque-count-33 KILLED exit=1 TestCreateIdentityRefusals,TestCreateIdentityRefusals/opaque_count\\nM2-resume-arch-mips KILLED exit=1 TestCheckResumeTupleRefusals,TestCheckResumeTupleRefusals/architecture_registry\\nM3-discovery-native-empty KILLED exit=1 TestDecodeNativeDiscoveryRefusals,TestDecodeNativeDiscoveryRefusals/native_bounds\\nM4-store-home-empty-codex KILLED exit=1 TestStoreRootForRefusals,TestStoreRootForRefusals/home_empty\\nC-harmless-comment COMPILE_OR_HARNESS_FAILURE exit=0 \\n\",\n  \"original_output_bytes\": 491,\n  \"original_output_tokens\": 123,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
