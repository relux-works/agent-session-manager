roviderID = \"Codex\" }))\n29|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create provider_id is not a provider id\")\n30|\t\t}},\n31|\t\t{arm: `ctor|failInvalid|create provider_version is not 1..128 characters`, name: \"create empty version\", prove: func(t *testing.T) {\n32|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.ProviderVersion = \"\" }))\n33|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create provider_version is not 1..128 characters\")\n34|\t\t}},\n35|\t\t{arm: `ctor|failInvalid|create provider_version_range is not 1..256 characters`, name: \"create empty range\", prove: func(t *testing.T) {\n36|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.ProviderVersionRange = \"\" }))\n37|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create provider_version_range is not 1..256 characters\")\n38|\t\t}},\n39|\t\t{arm: `ctor|failInvalid|create native_session_id is not 1..512 characters`, name: \"create empty native id\", prove: func(t *testing.T) {\n40|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.NativeSessionID = \"\" }))\n41|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create native_session_id is not 1..512 characters\")\n42|\t\t}},\n43|\t\t{arm: `ctor|failInvalid|create identity_kind is not a registry member`, name: \"create window handle kind\", prove: func(t *testing.T) {\n44|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.IdentityKind = \"window_handle\" }))\n45|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create identity_kind is not a registry member\")\n46|\t\t}},\n47|\t\t{arm: `ctor|failInvalid|create logical_workspace_id is not a UUIDv7`, name: \"create bogus workspace\", prove: func(t *testing.T) {\n48|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.LogicalWorkspaceID = \"nope\" }))\n49|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create logical_workspace_id is not a UUIDv7\")\n50|\t\t}},\n51|\t\t{arm: `ctor|failInvalid|create backend_realm_fingerprint is not a digest or empty`, name: \"create garbage realm\", prove: func(t *testing.T) {\n52|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.BackendRealm = \"nope\" }))\n53|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create backend_realm_fingerprint is not a digest or empty\")\n54|\t\t}},\n55|\t\t{arm: `ctor|failInvalid|create backend_realm_fingerprint is required for this backend kind`, name: \"create antigravity null realm\", prove: func(t *testing.T) {\n56|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) {\n57|\t\t\t\tp.ProviderID = \"antigravity\"\n58|\t\t\t\tp.IdentityKind = \"backend_conversation_uuid\"\n59|\t\t\t}))\n60|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create backend_realm_fingerprint is required for this backend kind\")\n61|\t\t}},\n62|\t\t{arm: `ctor|failInvalid|create opaque_identity exceeds 32 entries`, name: \"create 33 opaque entries\", prove: func(t *testing.T) {\n63|\t\t\topaque := map[string]string{}\n64|\t\t\tfor i := 0; i < 33; i++ {\n65|\t\t\t\topaque[\"k\"+pad2(i)] = \"x\"\n66|\t\t\t}\n67|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.OpaqueIdentity = opaque }))\n68|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create opaque_identity exceeds 32 entries\")\n69|\t\t}},\n70|\t\t{arm: `ctor|failInvalid|create opaque key is not a provider key`, name: \"create bad opaque key\", prove: func(t *testing.T) {\n71|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.OpaqueIdentity = map[string]string{\"Bad Key!\": \"x\"} }))\n72|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create opaque key is not a provider key\")\n73|\t\t}},\n74|\t\t{arm: `ctor|failInvalid|create opaque value is not 1..1024 characters`, name: \"create empty opaque value\", prove: func(t *testing.T) {\n75|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.OpaqueIdentity = map[string]string{\"ok\": \"\"} }))\n76|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create opaque value is not 1..1024 characters\")\n77|\t\t}},\n78|\t\t{arm: `ctor|failInvalid|create opaque value begins with an absolute path`, name: \"create absolute opaque value\", prove: func(t *testing.T) {\n79|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.OpaqueIdentity = map[string]string{\"workdir\": \"/tmp/x\"} }))\n80|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create opaque value begins with an absolute path\")\n81|\t\t}},\n82|\t\t{arm: `ctor|failInvalid|create created_by_host_id is not a UUIDv7`, name: \"create bogus host\", prove: func(t *testing.T) {\n83|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.CreatedByHostID = \"nope\" }))\n84|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create created_by_host_id is not a UUIDv7\")\n85|\t\t}},\n86|\t\t{arm: `ctor|failInvalid|create created_at is not a timestamp`, name: \"create bogus timestamp\", prove: func(t *testing.T) {\n87|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.CreatedAt = \"yesterday\" }))\n88|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create created_at is not a timestamp\")\n89|\t\t}},\n90|\t\t{arm: `ctor|failInvalid|create extensions exceed 64 entries`, name: \"create 65 extensions\", prove: func(t *testing.T) {\n91|\t\t\textensions := map[string]any{}\n92|\t\t\tfor i := 0; i < 65; i++ {\n93|\t\t\t\textensions[\"com.example.k\"+pad2(i)] = i\n94|\t\t\t}\n95|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.Extensions = extensions }))\n96|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create extensions exceed 64 entries\")\n97|\t\t}},\n98|\t\t{arm: `ctor|failInvalid|create extension key is not reverse-DNS`, name: \"create bad extension key\", prove: func(t *testing.T) {\n99|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.Extensions = map[string]any{\"NoDNS\": true} }))\n100|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create extension key is not reverse-DNS\")\n101|\t\t}},\n102|\t\t{arm: `ctor|failInvalid|create extensions carry a non-JSON value`, name: \"create channel extension\", prove: func(t *testing.T) {\n103|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.Extensions = map[string]any{\"com.example.bad\": make(chan int)} }))\n104|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create extensions carry a non-JSON value\")\n105|\t\t}},\n106|\t\t{arm: `ctor|failInvalid|create params are not a valid provider identity`, name: \"create deep extensions\", prove: func(t *testing.T) {\n107|\t\t\tdeep := map[string]any{\"com.example.deep\": map[string]any{\"l1\": map[string]any{\"l2\": map[string]any{\"l3\": map[string]any{\"l4\": map[string]any{\"l5\": \"x\"}}}}}}\n108|\t\t\t_, err := CreateIdentity(createParams(func(p *IdentityParams) { p.Extensions = deep }))\n109|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"create params are not a valid provider identity\")\n110|\t\t}},\n111|\t\t// Discovery decoder arms, through DecodeNativeDiscovery.\n112|\t\t{arm: `ctor|failInvalid|discovery platform is not a registry member`, name: \"discovery plan9 platform\", prove: func(t *testing.T) {\n113|\t\t\t_, err := DecodeNativeDiscovery(bindProof(\"x\", \"\", true, true, false), \"plan9\")\n114|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"discovery platform is not a registry member\")\n115|\t\t}},\n116|\t\t{arm: `ctor|failProtocol|discovery carries unknown member`, name: \"discovery score member\", prove: func(t *testing.T) {\n117|\t\t\tbody := []byte(`{\"native_session_id\": \"x\", \"discovered\": true, \"discovery_root\": null, \"backend_resolved\": false, \"score\": 1}`)\n118|\t\t\t_, err := DecodeNativeDiscovery(body, \"macos\")\n119|\t\t\trequireFrameRefusal(t, err, \"score\", \"unknown member\")\n120|\t\t}},\n121|\t\t{arm: `ctor|failProtocol|discovery misses a required member`, name: \"discovery without root\", prove: func(t *testing.T) {\n122|\t\t\tbody := []byte(`{\"native_session_id\": \"x\", \"discovered\": true, \"backend_resolved\": false}`)\n123|\t\t\t_, err := DecodeNativeDiscovery(body, \"macos\")\n124|\t\t\trequireFrameRefusal(t, err, \"discovery_root\", \"misses a required member\")\n125|\t\t}},\n126|\t\t{arm: `ctor|failProtocol|discovery native_session_id is not 1..512 characters`, name: \"discovery empty native id\", prove: func(t *testing.T) {\n127|\t\t\t_, err := DecodeNativeDiscovery(bindProof(\"\", \"\", true, true, false), \"macos\")\n128|\t\t\trequireFrameRefusal(t, err, \"native_session_id\", \"not 1..512 characters\")\n129|\t\t}},\n130|\t\t{arm: `ctor|failProtocol|discovery discovered is not a boolean`, name: \"discovery string discovered\", prove: func(t *testing.T) {\n131|\t\t\tbody := []byte(`{\"native_session_id\": \"x\", \"discovered\": \"yes\", \"discovery_root\": null, \"backend_resolved\": false}`)\n132|\t\t\t_, err := DecodeNativeDiscovery(body, \"macos\")\n133|\t\t\trequireFrameRefusal(t, err, \"discovered\", \"not a boolean\")\n134|\t\t}},\n135|\t\t{arm: `ctor|failProtocol|discovery discovery_root is not an absolute path or null`, name: \"discovery relative root\", prove: func(t *testing.T) {\n136|\t\t\t_, err := DecodeNativeDiscovery(bindProof(\"x\", \"sessions/relative\", false, true, false), \"macos\")\n137|\t\t\trequireFrameRefusal(t, err, \"discovery_root\", \"not an absolute path or null\")\n138|\t\t}},\n139|\t\t{arm: `ctor|failProtocol|discovery backend_resolved is not a boolean`, name: \"discovery string backend\", prove: func(t *testing.T) {\n140|\t\t\tbody := []byte(`{\"native_session_id\": \"x\", \"discovered\": true, \"discovery_root\": null, \"backend_resolved\": \"no\"}`)\n141|\t\t\t_, err := DecodeNativeDiscovery(body, \"macos\")\n142|\t\t\trequireFrameRefusal(t, err, \"backend_resolved\", \"not a boolean\")\n143|\t\t}},\n144|\t\t// Store-roo