{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2e3","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1996,"recorded_at":1780531400003987,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad7c-2f01-70c2-ac52-34de48210df8"},"task_id":"01a0ad7c-2f01-70c2-ac52-34de48210df8","event":{"kind":"output","task_id":"01a0ad7c-2f01-70c2-ac52-34de48210df8","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(774 line(s) above)\n775|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction: every\n776|// arm derived from production must carry a witness. A planted arm (a new\n777|// frameFault literal or integrity detail through an existing constructor\n778|// site) lands here as an unwitnessed arm.\n779|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n780|\tderived := deriveRefusalArms(t)\n781|\twitnessed := map[string]int{}\n782|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n783|\t\twitnessed[witness.arm]++\n784|\t}\n785|\tvar missing []string\n786|\tfor arm := range derived {\n787|\t\tif witnessed[arm] == 0 {\n788|\t\t\tmissing = append(missing, arm)\n789|\t\t}\n790|\t}\n791|\tsort.Strings(missing)\n792|\tif len(missing) > 0 {\n793|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n794|\t}\n795|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n796|}\n797|\n798|// TestWitnessedArmsAreAllDerived is the reverse direction: every witness\n799|// must name an arm production declares. A deleted or narrowed production\n800|// branch orphans its witness and fails here, which is also what makes a\n801|// truncated derivation fail instead of passing vacuously.\n802|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n803|\tderived := deriveRefusalArms(t)\n804|\tvar orphans []string\n805|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n806|\t\tif _, ok := derived[witness.arm]; !ok {\n807|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n808|\t\t}\n809|\t}\n810|\tsort.Strings(orphans)\n811|\tif len(orphans) > 0 {\n812|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n813|\t}\n814|}\n815|\n816|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every witness\n817|// through its production entry point and requires the attributed refusal.\n818|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n819|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n820|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n821|\t\t\twitness.prove(t)\n822|\t\t})\n823|\t}\n824|}","final_result":true}}}
