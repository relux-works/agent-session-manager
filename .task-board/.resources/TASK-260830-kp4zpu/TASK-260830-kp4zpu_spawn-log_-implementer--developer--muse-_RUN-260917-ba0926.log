{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccfb","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1240,"recorded_at":1780531400002475,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad72-bd2d-70f0-910c-8a654567a776"},"task_id":"01a0ad72-bd2d-70f0-910c-8a654567a776","event":{"kind":"output","task_id":"01a0ad72-bd2d-70f0-910c-8a654567a776","chunk":"Read text file `internal/provhost/identity_test.go`.\n(99 line(s) above)\n100|// `f := pkg.VerifyObjectIdentity; f(x)` binding would not be seen; no such\n101|// shape exists today.\n102|func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\n103|\t_, self, _, ok := runtime.Caller(0)\n104|\tif !ok {\n105|\t\tt.Fatal(\"runtime.Caller cannot locate the test file\")\n106|\t}\n107|\troot := filepath.Dir(self)\n108|\tfor {\n109|\t\tif _, err := os.Stat(filepath.Join(root, \"go.mod\")); err == nil {\n110|\t\t\tbreak\n111|\t\t}\n112|\t\tparent := filepath.Dir(root)\n113|\t\tif parent == root {\n114|\t\t\tt.Fatal(\"no module root above the test file; the scan is blind\")\n115|\t\t}\n116|\t\troot = parent\n117|\t}\n118|\tallowed, callers, scanned, parsed := scanAttestationSites(t, root)\n119|\tif scanned == 0 {\n120|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n121|\t}\n122|\tif len(allowed) != 5 {\n123|\t\tt.Fatalf(\"session-leaf attestation sites = %d, want exactly 5 (decodeSessionRecord, decodeSessionEvent, loadSessionLocked, AttestLeaseRecord, AttestCheckpointRecord): a moved call site must rewrite the bound, a new one must justify itself, a stale exception must go\", len(allowed))\n124|\t}\n125|\tif len(callers) != 0 {\n126|\t\tt.Fatalf(\"production call sites outside the session leaf attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\n127|\t}\n128|\tt.Logf(\"attestation scan: %d production files, %d parsed, %d session-leaf call sites, 0 elsewhere\", scanned, parsed, len(allowed))\n129|}\n130|\n131|// isSessrepoLeafFile reports whether a scan path sits inside the owning\n132|// session-persistence directory: <root>/internal/sessrepo/. The match\n133|// anchors on the full module-relative owning path, never on a bare\n134|// segment, so internal/provhost/sessrepo/plant.go (same leaf name,\n135|// foreign owner) and internal/xsessrepo/plant.go (near-miss name) both\n136|// land outside the allowlist while the leaf's own files stay admitted.\n137|func isSessrepoLeafFile(root, path string) bool {\n138|\tleaf := filepath.Join(root, \"internal\", \"sessrepo\") + string(filepath.Separator)\n139|\treturn strings.HasPrefix(path, leaf)\n140|}\n141|\n142|// scanAttestationSites walks the production trees beneath root and\n143|// classifies every VerifyObjectIdentity call: inside the owning leaf it\n144|// is allowlisted, anywhere else it contradicts the bound. It returns\n145|// the allowlisted entries, the contradicting entries, and the scanned\n146|// and parsed file counts.\n147|func scanAttestationSites(t *testing.T, root string) (allowed, callers []string, scanned, parsed int) {\n148|\tt.Helper()\n149|\tfor _, tree := range []string{\"internal\", \"cmd\"} {\n150|\t\tbase := filepath.Join(root, tree)\n151|\t\tif _, err := os.Stat(base); err != nil {\n152|\t\t\tcontinue\n153|\t\t}\n154|\t\t// Recursion stays local: the core selects single-package\n155|\t\t// production files, while this attestation spans trees.\n156|\t\t// Fail-closed parsing is the core's.\n157|\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\n158|\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n159|\t\t\t\treturn err\n160|\t\t\t}\n161|\t\t\tscanned++\n162|\t\t\tsource, err := os.ReadFile(path)\n163|\t\t\tif err != nil {\n164|\t\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n165|\t\t\t}\n166|\t\t\tif !strings.Contains(string(source), \"VerifyObjectIdentity\") {\n167|\t\t\t\treturn nil\n168|\t\t\t}\n169|\t\t\tparsed++\n170|\t\t\tsyntax, fileSet, failure := invcore.ParseBytes(path, source, 0)\n171|\t\t\tif failure != \"\" {\n172|\t\t\t\tt.Fatalf(\"parse %s: %s\", path, failure)\n173|\t\t\t}\n174|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n175|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n176|\t\t\t\tif !ok {\n177|\t\t\t\t\treturn true\n178|\t\t\t\t}\n179|\t\t\t\trecord := func(position token.Position) {\n180|\t\t\t\t\tentry := fmt.Sprintf(\"%s:%d\", position.Filename, position.Line)\n181|\t\t\t\t\tif isSessrepoLeafFile(root, path) {\n182|\t\t\t\t\t\tallowed = append(allowed, entry)\n183|\t\t\t\t\t\treturn\n184|\t\t\t\t\t}\n185|\t\t\t\t\tcallers = append(callers, entry)\n186|\t\t\t\t}\n187|\t\t\t\tswitch fun := call.Fun.(type) {\n188|\t\t\t\tcase *ast.SelectorExpr:\n189|\t\t\t\t\tif fun.Sel.Name == \"VerifyObjectIdentity\" {\n190|\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\n191|\t\t\t\t\t}\n192|\t\t\t\tcase *ast.Ident:\n193|\t\t\t\t\tif fun.Name == \"VerifyObjectIdentity\" {\n194|\t\t\t\t\t\t// The canonicaljson definition itself is a\n195|\t\t\t\t\t\t// FuncDecl, never a call; a bare-identifier call\n196|\t\t\t\t\t\t// anywhere is a production call site.\n197|\t\t\t\t\t\trecord(fileSet.Position(call.Pos()))\n198|\t\t\t\t\t}\n199|\t\t\t\t}\n200|\t\t\t\treturn true\n201|\t\t\t})\n202|\t\t\treturn nil\n203|\t\t}); err != nil {\n204|\t\t\tt.Fatalf(\"walk %s: %v\", base, err)\n205|\t\t}\n206|\t}\n207|\treturn allowed, callers, scanned, parsed\n208|}\n209|\n210|// TestAttestationAllowlistAnchorsOwningPath drives the allowlist through\n211|// a synthetic module tree, preserving the searched-for \"sessrepo\" token\n212|// while changing the owning directory: a plant under\n213|// internal/provhost/sessrepo/ and a near-miss under\n214|// internal/xsessrepo/ must both land outside the allowlist, while the\n215|// leaf's own file stays admitted. The production suite executes the\n216|// behavioral tests, not only this static shape, for the token-preserving\n217|// mutants in the owning task's battery.\n218|func TestAttestationAllowlistAnchorsOwningPath(t *testing.T) {\n219|\troot := t.TempDir()\n220|\tleafCall := \"package sessrepo\\nfunc load(raw []byte) {\\n\\t_, _, _ = canonicaljson.VerifyObjectIdentity(raw)\\n}\\n\"\n221|\tforeignCall := \"package plant\\nfunc plant(raw []byte) {\\n\\t_, _, _ = canonicaljson.VerifyObjectIdentity(raw)\\n}\\n\"\n222|\tfor _, file := range []struct{ rel, body string }{\n223|\t\t{\"internal/sessrepo/chain.go\", leafCall},\n224|\t\t{\"internal/provhost/sessrepo/plant.go\", foreignCall},\n225|\t\t{\"internal/xsessrepo/plant.go\", foreignCall},\n226|\t} {\n227|\t\tpath := filepath.Join(root, filepath.FromSlash(file.rel))\n228|\t\tif err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {\n229|\t\t\tt.Fatal(err)\n230|\t\t}\n231|\t\tif err := os.WriteFile(path, []byte(file.body), 0o600); err != nil {\n232|\t\t\tt.Fatal(err)\n233|\t\t}\n234|\t}\n235|\tallowed, callers, scanned, parsed := scanAttestationSites(t, root)\n236|\tif scanned != 3 || parsed != 3 {\n237|\t\tt.Fatalf(\"synthetic scan files = %d scanned %d parsed, want 3 and 3\", scanned, parsed)\n238|\t}\n239|\tif len(allowed) != 1 {\n240|\t\tt.Fatalf(\"synthetic allowlisted sites = %q, want only the owning leaf file\", allowed)\n241|\t}\n242|\tif !strings.Contains(allowed[0], filepath.Join(\"internal\", \"sessrepo\", \"chain.go\")) {\n243|\t\tt.Fatalf(\"synthetic allowlisted site = %q, want the owning leaf file\", allowed[0])\n244|\t}\n245|\tif len(callers) != 2 {\n246|\t\tt.Fatalf(\"synthetic contradicting sites = %q, want the provhost/sessrepo and xsessrepo plants\", callers)\n247|\t}\n248|}\n249|\n(more lines below)","final_result":true}}}
