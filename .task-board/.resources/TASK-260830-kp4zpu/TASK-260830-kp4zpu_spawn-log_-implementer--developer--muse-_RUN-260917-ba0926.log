t.go:171:\\treturn providerIDPattern.MatchString(value)\\n===\\n===\\n20:    {\\\"contract_id\\\": \\\"urn:ax:schema:provider-identity\\\", \\\"contract_versions\\\": [\\\"1.0.0\\\"], \\\"self_field\\\": \\\"record_id\\\", \\\"releases\\\": [\\\"v0.5.0\\\", \\\"v0.6.0\\\"], \\\"normative_section\\\": \\\"1.6\\\"},\\n86:          \\\"idempotency_key\\\": \\\"terminal_instance_id + \\\\\\\"/boundary/\\\\\\\" + quiescence_generation + \\\\\\\"/\\\\\\\" + provider_proof_kind\\\",\\n107:      \\\"family\\\": \\\"provider\\\",\\n108:      \\\"contract_id\\\": \\\"urn:ax:protocol:provider\\\",\\n256:      \\\"capabilities\\\": [\\\"durable_disconnect\\\", \\\"local_attach\\\", \\\"remote_attach\\\", \\\"web_attach\\\", \\\"multi_attach\\\", \\\"headless_creation\\\", \\\"reboot_restoration\\\", \\\"input_quiescence\\\", \\\"safe_boundary_observation\\\", \\\"provider_process_observation\\\", \\\"graceful_stop\\\", \\\"stale_process_termination\\\", \\\"terminal_state_retention\\\", \\\"scrollback_retention\\\", \\\"credential_capable_execution_realm\\\", \\\"multiple_input_clients\\\"]\\ncatalog_gen.go\\ncatalog_test.go\\ncatalog.go\\ncatalog.v0.5.0.json\\ncatalog.v0.6.0.json\\ncmd\\n\",\n  \"original_output_bytes\": 1669,\n  \"original_output_tokens\": 418,\n  \"truncated\": false\n}","final_result":true}}}
