{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1bd","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1849,"recorded_at":1780531400003693,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"call_id":"call_01a0ad79f93771b88d501d90db10d7bf","text":"Read text file `internal/provhost/refusal_arm_operations_c_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// declaredOperationWitnessesIdentity proves the identity,\n9|// identify-result, and idempotency-key arms. It extends\n10|// declaredOperationWitnesses in refusal_arm_operations_a_test.go; the\n11|// split is file size only.\n12|func declaredOperationWitnessesIdentity() []armWitness {\n13|\treturn []armWitness{\n14|\t\t// Identity arms, through CheckIdentity.\n15|\t\t{arm: `ctor|failProtocol|identity carries unknown member`, name: \"identity score member\", prove: func(t *testing.T) {\n16|\t\t\tbody := identityVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"score\": 1`)\n17|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"score\", \"unknown member\")\n18|\t\t}},\n19|\t\t{arm: `ctor|failProtocol|identity extensions is not an object`, name: \"identity array extensions\", prove: func(t *testing.T) {\n20|\t\t\tbody := identityVariant(t, `\"extensions\": {}`, `\"extensions\": []`)\n21|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"extensions\", \"not an object\")\n22|\t\t}},\n23|\t\t{arm: `ctor|failProtocol|identity host is not a UUIDv7`, name: \"identity bogus host\", prove: func(t *testing.T) {\n24|\t\t\tbody := identityVariant(t, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890aG\"`)\n25|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"created_by_host_id\", \"not a UUIDv7\")\n26|\t\t}},\n27|\t\t{arm: `ctor|failProtocol|identity kind is not a registry member`, name: \"identity window handle kind\", prove: func(t *testing.T) {\n28|\t\t\tbody := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"window_handle\"`)\n29|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"identity_kind\", \"not a registry member\")\n30|\t\t}},\n31|\t\t{arm: `ctor|failProtocol|identity misses a required member`, name: \"identity without opaque\", prove: func(t *testing.T) {\n32|\t\t\tbody := []byte(strings.Replace(specIdentityExample, \"  \\\"opaque_identity\\\": {},\\n\", \"\", 1))\n33|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"opaque_identity\", \"misses a required member\")\n34|\t\t}},\n35|\t\t{arm: `ctor|failProtocol|identity native_session_id is not 1..512 characters`, name: \"identity empty native session\", prove: func(t *testing.T) {\n36|\t\t\tbody := identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"\"`)\n37|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"native_session_id\", \"not 1..512 characters\")\n38|\t\t}},\n39|\t\t{arm: `ctor|failProtocol|identity opaque key is not a provider key`, name: \"identity bad opaque key\", prove: func(t *testing.T) {\n40|\t\t\tbody := identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"Bad Key!\": \"x\"}`)\n41|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"opaque_identity\", \"not a provider key\")\n42|\t\t}},\n43|\t\t{arm: `ctor|failProtocol|identity opaque value begins with an absolute path`, name: \"identity absolute opaque value\", prove: func(t *testing.T) {\n44|\t\t\tbody := identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"/Users/iv/work\"}`)\n45|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"opaque_identity\", \"begins with an absolute path\")\n46|\t\t}},\n47|\t\t{arm: `ctor|failProtocol|identity opaque value is not 1..1024 characters`, name: \"identity object opaque value\", prove: func(t *testing.T) {\n48|\t\t\tbody := identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": {\"nested\": true}}`)\n49|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"opaque_identity\", \"not 1..1024 characters\")\n50|\t\t}},\n51|\t\t{arm: `ctor|failProtocol|identity opaque_identity exceeds 32 entries`, name: \"identity 33 opaque entries\", prove: func(t *testing.T) {\n52|\t\t\tvar entries strings.Builder\n53|\t\t\tfor i := 0; i < 33; i++ {\n54|\t\t\t\tif i > 0 {\n55|\t\t\t\t\tentries.WriteString(\", \")\n56|\t\t\t\t}\n57|\t\t\t\tentries.WriteString(`\"k` + pad2(i) + `\": \"x\"`)\n58|\t\t\t}\n59|\t\t\tbody := identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {`+entries.String()+`}`)\n60|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"opaque_identity\", \"exceeds 32 entries\")\n61|\t\t}},\n62|\t\t{arm: `ctor|failProtocol|identity provider_id is not a provider id`, name: \"identity uppercase provider\", prove: func(t *testing.T) {\n63|\t\t\tbody := identityVariant(t, `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"Antigravity\"`)\n64|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"provider_id\", \"not a provider id\")\n65|\t\t}},\n66|\t\t{arm: `ctor|failProtocol|identity provider_version is not 1..128 characters`, name: \"identity overlong version\", prove: func(t *testing.T) {\n67|\t\t\tbody := identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+strings.Repeat(\"v\", 129)+`\"`)\n68|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"provider_version\", \"not 1..128 characters\")\n69|\t\t}},\n70|\t\t{arm: `ctor|failProtocol|identity provider_version_range is not 1..256 characters`, name: \"identity empty range\", prove: func(t *testing.T) {\n71|\t\t\tbody := identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"\"`)\n72|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"provider_version_range\", \"not 1..256 characters\")\n73|\t\t}},\n74|\t\t{arm: `ctor|failProtocol|identity realm is not a digest or null`, name: \"identity garbage realm\", prove: func(t *testing.T) {\n75|\t\t\tbody := identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": \"nope\"`)\n76|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"backend_realm_fingerprint\", \"not a digest or null\")\n77|\t\t}},\n78|\t\t{arm: `ctor|failProtocol|identity realm is required for this backend kind`, name: \"identity antigravity null realm\", prove: func(t *testing.T) {\n79|\t\t\tbody := identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`)\n80|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"backend_realm_fingerprint\", \"required for this backend kind\")\n81|\t\t}},\n82|\t\t{arm: `ctor|failProtocol|identity record_id is not a digest`, name: \"identity garbage digest\", prove: func(t *testing.T) {\n83|\t\t\tbody := identityVariant(t, `\"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"`, `\"record_id\": \"sha256:zzzz\"`)\n84|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"record_id\", \"not a digest\")\n85|\t\t}},\n86|\t\t{arm: `ctor|failProtocol|identity schema is not the provider identity`, name: \"identity manifest schema\", prove: func(t *testing.T) {\n87|\t\t\tbody := identityVariant(t, `\"urn:ax:schema:provider-identity\"`, `\"urn:ax:schema:provider-manifest\"`)\n88|\t\t\trequireFrameRefusal(t, CheckIdentity(body, \"antigravity\"), \"schema\", \"not the provider identity\")\n89|\t\t}},\n90|\t\t{arm: `ctor|failProtocol|identity schema_version is not 1.0.0`, name: \"identity schema 1.1.0\", prove: func(t *testing.T) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
