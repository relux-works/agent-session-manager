{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c845","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":637,"recorded_at":1780531400001269,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad6f-a6ec-75a3-83e4-d2ed289045b9"},"task_id":"01a0ad6f-a6ec-75a3-83e4-d2ed289045b9","event":{"kind":"output","task_id":"01a0ad6f-a6ec-75a3-83e4-d2ed289045b9","chunk":"Read text file `internal/provhost/status.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/base64\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// StatusState is the reconciled durable state of a materialization\n11|// transaction. Unknown is fail-closed: the host must quarantine the\n12|// transaction root rather than infer prepare or commit.\n13|type StatusState string\n14|\n15|// ProviderTransactionStatus states Section 7.5 defines.\n16|const (\n17|\tStatusUnknown    StatusState = \"unknown\"\n18|\tStatusPrepared   StatusState = \"prepared\"\n19|\tStatusCommitted  StatusState = \"committed\"\n20|\tStatusRolledBack StatusState = \"rolled_back\"\n21|)\n22|\n23|// statusStates is the exact Section 7.5 ProviderTransactionStatus state\n24|// vocabulary: unknown, prepared, committed, and rolled_back, nothing\n25|// else. It is package-level so the closed vocabulary census derives\n26|// it: admitting a fifth state here must redden\n27|// TestStatusStatesAreDerivedFromSpec, not decode as durable state.\n28|var statusStates = map[string]bool{\n29|\tstring(StatusUnknown):    true,\n30|\tstring(StatusPrepared):   true,\n31|\tstring(StatusCommitted):  true,\n32|\tstring(StatusRolledBack): true,\n33|}\n34|\n35|// validStatusState reports whether the state is a registry member.\n36|func validStatusState(state string) bool {\n37|\treturn statusStates[state]\n38|}\n39|\n40|// StatusIDs identifies the transaction a status read must describe: the\n41|// caller-supplied materialization and transaction IDs and the exact\n42|// transaction authority the request located it through. A status naming\n43|// any other transaction is not this transaction's durable state.\n44|type StatusIDs struct {\n45|\tMaterializationID      string\n46|\tTransactionID          string\n47|\tTransactionAuthorityID string\n48|}\n49|\n50|// statusBodyMembers is the exact member set DecodeStatusOutcome accepts:\n51|// the ProviderTransactionStatus row of Section 7.5, where operation_id is\n52|// the mutation key the status request omits. A well-formed operation_id is\n53|// ignored — it is not this read's identity — but a malformed one makes\n54|// the observation integrity-invalid, as does any unknown member.\n55|var statusBodyMembers = map[string]bool{\n56|\t\"operation_id\":             true,\n57|\t\"materialization_id\":       true,\n58|\t\"transaction_id\":           true,\n59|\t\"transaction_authority_id\": true,\n60|\t\"plan_id\":                  true,\n61|\t\"state\":                    true,\n62|\t\"rollback_token\":           true,\n63|\t\"native_discovery\":         true,\n64|}\n65|\n66|// DecodeStatusOutcome reconciles one materialize-status success body to\n67|// the current durable state. It enforces the Section 7.5 recovery rules:\n68|// unknown requires null plan, token, and discovery; prepared requires all\n69|// three non-null; committed and rolled_back require a non-null plan and\n70|// discovery with a null token. Identity members must equal the requested\n71|// transaction.\n72|//\n73|// Every uninterpretable observation fails with integrity_failure,\n74|// including a state of unknown: the caller must quarantine the\n75|// transaction root and must not infer success. Status reads are evolving\n76|// observations, so no byte-identical replay rule applies: the same\n77|// transaction may report prepared under one envelope request_id and\n78|// committed under the next, and both readings are returned as-is.\n79|//\n80|// Only the charset and length of a rollback token are checked here (at\n81|// least 256 bits of base64url); its entropy is not observable. The shapes\n82|// of native_discovery and plan contents belong to the operation layer.\n83|func DecodeStatusOutcome(body []byte, want StatusIDs) (StatusState, error) {\n84|\tintegrity := func(detail string, state string) (StatusState, error) {\n85|\t\tfailure, err := failIntegrity(detail, state, want.MaterializationID, want.TransactionID)\n86|\t\tif err != nil {\n87|\t\t\treturn \"\", err\n88|\t\t}\n89|\t\treturn \"\", failure\n90|\t}\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\treturn integrity(\"status body is \"+fault.detail, \"\")\n94|\t}\n95|\tfor name := range members {\n96|\t\tif !statusBodyMembers[name] {\n97|\t\t\treturn integrity(\"status body carries unknown member\", \"\")\n98|\t\t}\n99|\t}\n100|\tfor _, name := range []string{\"materialization_id\", \"transaction_id\", \"transaction_authority_id\", \"plan_id\", \"state\", \"rollback_token\", \"native_discovery\"} {\n101|\t\tif _, present := members[name]; !present {\n102|\t\t\treturn integrity(\"status body misses a required member\", \"\")\n103|\t\t}\n104|\t}\n105|\tstringMember := func(name string) (string, bool) {\n106|\t\tvar value string\n107|\t\tif err := json.Unmarshal(members[name], &value); err != nil {\n108|\t\t\treturn \"\", false\n109|\t\t}\n110|\t\treturn value, true\n111|\t}\n112|\tmaterializationID, ok := stringMember(\"materialization_id\")\n113|\tif !ok || materializationID != want.MaterializationID {\n114|\t\treturn integrity(\"status names another materialization\", \"\")\n115|\t}\n116|\ttransactionID, ok := stringMember(\"transaction_id\")\n117|\tif !ok || transactionID != want.TransactionID {\n118|\t\treturn integrity(\"status names another transaction\", \"\")\n119|\t}\n120|\tauthorityID, ok := stringMember(\"transaction_authority_id\")\n121|\tif !ok || authorityID != want.TransactionAuthorityID {\n122|\t\treturn integrity(\"status names another transaction authority\", \"\")\n123|\t}\n124|\tif raw, present := members[\"operation_id\"]; present {\n125|\t\tvar operationID string\n126|\t\tif err := json.Unmarshal(raw, &operationID); err != nil {\n127|\t\t\treturn integrity(\"status operation_id is not a string\", \"\")\n128|\t\t}\n129|\t\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n130|\t\t\treturn integrity(\"status operation_id is not a UUIDv7\", \"\")\n131|\t\t}\n132|\t}\n133|\tstate, ok := stringMember(\"state\")\n134|\tif !ok || !validStatusState(state) {\n135|\t\treturn integrity(\"status state is not a registry member\", \"\")\n136|\t}\n137|\tplanNull := isNull(members[\"plan_id\"])\n138|\ttokenNull := isNull(members[\"rollback_token\"])\n139|\tdiscoveryNull := isNull(members[\"native_discovery\"])\n140|\tif !planNull {\n141|\t\tvar digest string\n142|\t\tif err := json.Unmarshal(members[\"plan_id\"], &digest); err != nil {\n143|\t\t\treturn integrity(\"status plan_id is not a string\", state)\n144|\t\t}\n145|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n146|\t\t\treturn integrity(\"status plan_id is not a digest\", state)\n147|\t\t}\n148|\t}\n149|\tif !tokenNull {\n150|\t\tvar token string\n151|\t\tif err := json.Unmarshal(members[\"rollback_token\"], &token); err != nil {\n152|\t\t\treturn integrity(\"status rollback_token is not a string\", state)\n153|\t\t}\n154|\t\traw, err := base64.RawURLEncoding.DecodeString(token)\n155|\t\tif err != nil || len(raw) < 32 {\n156|\t\t\treturn integrity(\"status rollback_token is shorter than 256 bits\", state)\n157|\t\t}\n158|\t}\n159|\tif !discoveryNull && !isJSONObject(members[\"native_discovery\"]) {\n160|\t\treturn integrity(\"status native_discovery is not an object\", state)\n161|\t}\n162|\tswitch StatusState(state) {\n163|\tcase StatusUnknown:\n164|\t\t// Unknown is not a usable state: whether or not the\n165|\t\t// nullability shape holds, the host must fail closed and\n166|\t\t// quarantine the transaction root rather than infer prepare\n167|\t\t// or commit. The shape violation names its own rule; a\n168|\t\t// well-shaped unknown still refuses as unknown.\n169|\t\tif !planNull || !tokenNull || !discoveryNull {\n170|\t\t\treturn integrity(\"unknown status carries plan, token, or discovery\", state)\n171|\t\t}\n172|\t\treturn integrity(\"transaction state is unknown\", state)\n173|\tcase StatusPrepared:\n174|\t\tif planNull || tokenNull || discoveryNull {\n175|\t\t\treturn integrity(\"prepared status misses plan, token, or discovery\", state)\n176|\t\t}\n177|\tcase StatusCommitted, StatusRolledBack:\n178|\t\tif planNull || discoveryNull || !tokenNull {\n179|\t\t\treturn integrity(\"terminal status misses plan or discovery or keeps a token\", state)\n180|\t\t}\n181|\t}\n182|\treturn StatusState(state), nil\n183|}\n184|\n185|// isNull reports whether the raw member is a JSON null literal.\n186|func isNull(raw json.RawMessage) bool {\n187|\treturn string(raw) == \"null\"\n188|}","final_result":true}}}
