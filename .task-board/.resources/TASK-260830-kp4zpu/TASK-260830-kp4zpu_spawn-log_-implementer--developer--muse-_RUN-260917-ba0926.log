{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc33","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1140,"recorded_at":1780531400002275,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad72-52d6-70d0-938e-b2db5f600606"},"task_id":"01a0ad72-52d6-70d0-938e-b2db5f600606","event":{"kind":"output","task_id":"01a0ad72-52d6-70d0-938e-b2db5f600606","chunk":"Read text file `internal/provhost/closed_vocabulary_census_test.go`.\n(718 line(s) above)\n719|\tcandidate := value.Type\n720|\tif candidate == nil && len(value.Values) == 1 {\n721|\t\tif literal, ok := value.Values[0].(*ast.CompositeLit); ok {\n722|\t\t\tcandidate = literal.Type\n723|\t\t}\n724|\t}\n725|\tswitch shape := candidate.(type) {\n726|\tcase *ast.ArrayType:\n727|\t\tif shape.Len != nil {\n728|\t\t\treturn \"\"\n729|\t\t}\n730|\t\tif ident, ok := shape.Elt.(*ast.Ident); ok && ident.Name == \"string\" {\n731|\t\t\treturn \"slice\"\n732|\t\t}\n733|\tcase *ast.MapType:\n734|\t\tkey, ok := shape.Key.(*ast.Ident)\n735|\t\tif !ok || key.Name != \"string\" {\n736|\t\t\treturn \"\"\n737|\t\t}\n738|\t\tif ident, ok := shape.Value.(*ast.Ident); ok && (ident.Name == \"bool\" || ident.Name == \"string\") {\n739|\t\t\treturn \"map\"\n740|\t\t}\n741|\t}\n742|\treturn \"\"\n743|}\n744|\n745|// vocabularyDerivation ties one derived membership vocabulary to the\n746|// test that proves it against the pinned document. The prove\n747|// function executes the real spec read: a registration pointing at\n748|// nothing that checks the vocabulary would pass vacuously.\n749|type vocabularyDerivation struct {\n750|\tname  string\n751|\tprove func(*testing.T)\n752|}\n753|\n754|// registeredVocabularyDerivations lists every membership vocabulary\n755|// the census may find, each with the derivation that pins it. The\n756|// eight enum and two registry entries reuse their covering tests\n757|// with no restatement; the nine member-set and mapping entries plus\n758|// the three formerly-switch vocabularies are proven above.\n759|func registeredVocabularyDerivations() []vocabularyDerivation {\n760|\treturn []vocabularyDerivation{\n761|\t\t{name: \"probeCapabilityStatuses\", prove: TestProbeStatusVocabularyIsDerivedFromSpec},\n762|\t\t{name: \"probeCapabilityEvidence\", prove: TestProbeEvidenceVocabularyIsDerivedFromSpec},\n763|\t\t{name: \"probeArchitectures\", prove: TestProbeArchitecturesAreDerivedFromSpec},\n764|\t\t{name: \"probePlatforms\", prove: TestProbePlatformsAreDerivedFromSpec},\n765|\t\t{name: \"quiesceBlockers\", prove: TestQuiesceBlockersAreDerivedFromSpec},\n766|\t\t{name: \"identityKinds\", prove: TestIdentityKindsAreDerivedFromSpec},\n767|\t\t{name: \"identifyConfidences\", prove: TestIdentifyVocabulariesAreDerivedFromSpec},\n768|\t\t{name: \"identifyEvidence\", prove: TestIdentifyVocabulariesAreDerivedFromSpec},\n769|\t\t{name: \"capabilityOrder\", prove: TestManifestRegistriesAreDerivedFromSpec},\n770|\t\t{name: \"manifestPlatforms\", prove: TestManifestRegistriesAreDerivedFromSpec},\n771|\t\t{name: \"manifestMembers\", prove: TestManifestMembersAreDerivedFromSpec},\n772|\t\t{name: \"probeMembers\", prove: TestProbeMembersAreDerivedFromSpec},\n773|\t\t{name: \"probeCapabilityMembers\", prove: TestProbeCapabilityMembersAreDerivedFromSpec},\n774|\t\t{name: \"identityMembers\", prove: TestIdentityMembersAreDerivedFromSpec},\n775|\t\t{name: \"identifyMembers\", prove: TestIdentifyMembersAreDerivedFromSpec},\n776|\t\t{name: \"quiesceMembers\", prove: TestQuiesceMembersAreDerivedFromSpec},\n777|\t\t{name: \"spawnMembers\", prove: TestSpawnMembersAreDerivedFromSpec},\n778|\t\t{name: \"statusBodyMembers\", prove: TestStatusBodyMembersAreDerivedFromSpec},\n779|\t\t{name: \"profileYOLOMapping\", prove: TestProfileYOLOMappingIsDerivedFromSpec},\n780|\t\t{name: \"responseMembers\", prove: TestResponseMembersAreDerivedFromSpec},\n781|\t\t{name: \"profileNames\", prove: TestProfileNamesAreDerivedFromSpec},\n782|\t\t{name: \"statusStates\", prove: TestStatusStatesAreDerivedFromSpec},\n783|\t}\n784|}\n785|\n786|// TestClosedVocabularyCensusCoversEveryMembershipVocabulary checks\n787|// both directions of the census: every derived vocabulary carries a\n788|// registered spec derivation, and every registered derivation names\n789|// a derived vocabulary, so a truncated scan reddens on the orphaned\n790|// registrations instead of passing vacuously. Each derivation then\n791|// executes: the census proves containment, not reachability.\n792|func TestClosedVocabularyCensusCoversEveryMembershipVocabulary(t *testing.T) {\n793|\tfound := deriveMembershipVocabularies(t)\n794|\tregistered := registeredVocabularyDerivations()\n795|\tif len(registered) == 0 {\n796|\t\tt.Fatal(\"registered no vocabulary derivations; the census is blind, not the package\")\n797|\t}\n798|\tbyName := map[string]func(*testing.T){}\n799|\tfor _, entry := range registered {\n800|\t\tif _, repeated := byName[entry.name]; repeated {\n801|\t\t\tt.Fatalf(\"vocabulary %q carries two registered derivations; the census is ambiguous\", entry.name)\n802|\t\t}\n803|\t\tbyName[entry.name] = entry.prove\n804|\t}\n805|\tfor name := range found {\n806|\t\tif _, ok := byName[name]; !ok {\n807|\t\t\tt.Fatalf(\"membership vocabulary %q has no registered spec derivation; widening it passes silently\", name)\n808|\t\t}\n809|\t}\n810|\tfor _, entry := range registered {\n811|\t\tif _, ok := found[entry.name]; !ok {\n812|\t\t\tt.Fatalf(\"registered derivation %q names no production vocabulary; the census is short\", entry.name)\n813|\t\t}\n814|\t}\n815|\tfor _, entry := range registered {\n816|\t\tt.Run(entry.name, entry.prove)\n817|\t}\n818|\tt.Logf(\"vocabulary census coverage: %d/%d vocabularies derived\", len(found), len(registered))\n819|}\n820|\n821|// TestClosedMemberSetsRefuseExtraMembers drives one extra \"bogus\"\n822|// member per closed object through its production entry point: each\n823|// is refused under its own arm, so a member set that admits one more\n824|// value reddens here as well as in its derivation test. The\n825|// production call site is named in every row.\n826|func TestClosedMemberSetsRefuseExtraMembers(t *testing.T) {\n827|\tt.Run(\"manifest carries bogus\", func(t *testing.T) {\n828|\t\tbody := manifestVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n829|\t\trequireFrameRefusal(t, DecodeManifest(body), \"bogus\", \"unknown member\")\n830|\t})\n831|\tt.Run(\"probe carries bogus\", func(t *testing.T) {\n832|\t\tbody := probeVariant(t, `\"schema_version\": \"1.0.0\",`, \"\\\"schema_version\\\": \\\"1.0.0\\\",\\n  \\\"bogus\\\": 1,\")\n833|\t\trequireFrameRefusal(t, DecodeProbe(body), \"bogus\", \"unknown member\")\n834|\t})\n835|\tt.Run(\"probe capability carries bogus\", func(t *testing.T) {\n836|\t\tbody := probeVariant(t, \"\\\"status\\\": \\\"available\\\",\\n      \\\"enabled\\\": true,\", \"\\\"status\\\": \\\"available\\\",\\n      \\\"bogus\\\": 1,\\n      \\\"enabled\\\": true,\")\n837|\t\trequireFrameRefusal(t, DecodeProbe(body), \"capabilities\", \"unknown member\")\n838|\t})\n(more lines below)","final_result":true}}}
