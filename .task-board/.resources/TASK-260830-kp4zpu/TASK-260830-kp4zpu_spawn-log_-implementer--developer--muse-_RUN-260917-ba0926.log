{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb67","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1038,"recorded_at":1780531400002071,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad71-f598-7b51-8842-cd8be97d7944"},"task_id":"01a0ad71-f598-7b51-8842-cd8be97d7944","event":{"kind":"output","task_id":"01a0ad71-f598-7b51-8842-cd8be97d7944","chunk":"Read text file `internal/provhost/inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"flag\"\n6|\t\"fmt\"\n7|\t\"go/ast\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"regexp\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n20|)\n21|\n22|// refusalRecorder is the shared core's runtime direction: the production\n23|// file:line behind every instrumented refusal constructor call made\n24|// during the test run, plus the stable codes those refusals carried.\n25|// Constructor vars are swapped in TestMain, so an aliased constructor\n26|// still executes the swapped var and records its real production site:\n27|// the runtime direction of the alias-bypass union.\n28|var refusalRecorder = invcore.NewSiteRecorder()\n29|\n30|func recordRefusalSite(code string) {\n31|\trefusalRecorder.Record(code, 2)\n32|}\n33|\n34|func TestMain(main *testing.M) {\n35|\t// Helper-process gate for the ExecRunner environment tests: when the\n36|\t// marker is set this binary prints its observed environment and\n37|\t// exits before the suite or the refusal audit runs. It sits first so\n38|\t// the child never re-enters the audit or spawns grandchildren.\n39|\tif os.Getenv(\"SECPROBE_HELPER_PROCESS\") == \"1\" {\n40|\t\trunExecRunnerHelper()\n41|\t}\n42|\torigInvalid, origProtocol, origMismatch := failInvalid, failProtocol, failMismatch\n43|\torigProcess, origTimeout, origIntegrity := failProcess, failTimeout, failIntegrity\n44|\tfailInvalid = func(detail string) (*axerror.Error, error) {\n45|\t\tfailure, err := origInvalid(detail)\n46|\t\tif err == nil {\n47|\t\t\trecordRefusalSite(string(failure.Code()))\n48|\t\t}\n49|\t\treturn failure, err\n50|\t}\n51|\tfailProtocol = func(detail, member string) (*axerror.Error, error) {\n52|\t\tfailure, err := origProtocol(detail, member)\n53|\t\tif err == nil {\n54|\t\t\trecordRefusalSite(string(failure.Code()))\n55|\t\t}\n56|\t\treturn failure, err\n57|\t}\n58|\tfailMismatch = func(detail, observed string) (*axerror.Error, error) {\n59|\t\tfailure, err := origMismatch(detail, observed)\n60|\t\tif err == nil {\n61|\t\t\trecordRefusalSite(string(failure.Code()))\n62|\t\t}\n63|\t\treturn failure, err\n64|\t}\n65|\tfailProcess = func(detail string, cause error) (*axerror.Error, error) {\n66|\t\tfailure, err := origProcess(detail, cause)\n67|\t\tif err == nil {\n68|\t\t\trecordRefusalSite(string(failure.Code()))\n69|\t\t}\n70|\t\treturn failure, err\n71|\t}\n72|\tfailTimeout = func(millisDetail string, millis int64) (*axerror.Error, error) {\n73|\t\tfailure, err := origTimeout(millisDetail, millis)\n74|\t\tif err == nil {\n75|\t\t\trecordRefusalSite(string(failure.Code()))\n76|\t\t}\n77|\t\treturn failure, err\n78|\t}\n79|\tfailIntegrity = func(detail, statusState, materializationID, transactionID string) (*axerror.Error, error) {\n80|\t\tfailure, err := origIntegrity(detail, statusState, materializationID, transactionID)\n81|\t\tif err == nil {\n82|\t\t\trecordRefusalSite(string(failure.Code()))\n83|\t\t}\n84|\t\treturn failure, err\n85|\t}\n86|\tcode := main.Run()\n87|\tif code == 0 && fullPackageTestRun() {\n88|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n89|\t\t\tfor _, failure := range failures {\n90|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n91|\t\t\t}\n92|\t\t\tcode = 1\n93|\t\t}\n94|\t}\n95|\tos.Exit(code)\n96|}\n97|\n98|func fullPackageTestRun() bool {\n99|\tselected := flag.Lookup(\"test.run\")\n100|\treturn selected == nil || selected.Value.String() == \"\"\n101|}\n102|\n103|// auditRefusalInventory derives the refusal inventory from package\n104|// source, never from memory: every production call to a refusal\n105|// constructor must have an exercised negative path, no Structured Error\n106|// may be built outside the six constructors, no raw error may be minted,\n107|// and the observed code set must equal the closed code set exactly.\n108|func auditRefusalInventory() []string {\n109|\tdirectory, err := os.Getwd()\n110|\tif err != nil {\n111|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n112|\t}\n113|\tinventory, err := deriveRefusalInventory(directory)\n114|\tif err != nil {\n115|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n116|\t}\n117|\tvar failures []string\n118|\t// Floor: a derived domain that can silently derive nothing is not a\n119|\t// measurement. An empty derivation must fail closed, never pass\n120|\t// vacuously — the same \"the scan is blind\" floor the discovery\n(more lines below)","final_result":true}}}
