{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c989","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":799,"recorded_at":1780531400001593,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad70-2ef7-7153-a3d7-d49afeca274e"},"task_id":"01a0ad70-2ef7-7153-a3d7-d49afeca274e","event":{"kind":"output","task_id":"01a0ad70-2ef7-7153-a3d7-d49afeca274e","chunk":"{\n  \"chunk_id\": \"exec-23-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nd=json.load(open('internal/traceability/ownership.v0.6.0.json'))\\nfor e in d['ownership']:\\n  keys=e.get('keys',[])\\n  if any(k in ('section:7.5','section:7.6','section:7.7','section:8.1','section:8.2','section:8.3','section:8.4','section:8') for k in keys):\\n    print(json.dumps(e, indent=1)[:2500]); print('======')\\n\\\"\",\n  \"description\": \"Show 7.5-7.7 and 8 bindings\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.5\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.5; the host-side Section 7.5 operation conformance (SpawnPlan launch and resume bodies, identify-session results, materialize-status recovery, and the single operation plus operation_id mutation key) is implemented in internal/provhost under the Section 7.6 and Section 7.7 bindings, and no clause of Section 7.5 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 53 obligations it carries.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.6\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/quiesce.go\\\",\\n  \\\"declaration\\\": \\\"DecodeQuiesceProof\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-quiesce-proof\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"DecodeQuiesceProof implements the Section 7.6 quiescence proof decoder with its fail-closed safe-bit rules; the Provider Identity Record it carries is additionally checked by CheckIdentity, and no clause of Section 7.6 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 3 obligations it carries.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.7\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/profile.go\\\",\\n  \\\"declaration\\\": \\\"ProfileMapping\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-profile-mapping\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ProfileMapping implements the Section 7.7 execution-profile mapping as a closed six-provider vocabulary with unknown-profile refusal; version probing before mapping and the launch-plan equality rules belong to later leaves, and no clause of Section 7.7 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 4 obligations it carries.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:8\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/probe.go\\\",\\n  \\\"declaration\\\": \\\"RequireCapability\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-capability-gate\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"RequireCapability implements the Section 8 fail-closed capability gate direction (conditional, unsupported, and unknown surfaces are never usable) without advertising unsupported capabilities; the cell values themselves remain evidence labels and no clause of Section 8 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 12 obligations it carries.\\\"\\n}\\n======\\n\",\n  \"original_output_bytes\": 2652,\n  \"original_output_tokens\": 663,\n  \"truncated\": false\n}","final_result":true}}}
