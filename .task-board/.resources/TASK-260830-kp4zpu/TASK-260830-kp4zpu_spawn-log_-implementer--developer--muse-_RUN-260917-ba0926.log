{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc09","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1119,"recorded_at":1780531400002233,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad72-49e6-79d2-9785-0d94eb2e4a73"},"task_id":"01a0ad72-49e6-79d2-9785-0d94eb2e4a73","event":{"kind":"output","task_id":"01a0ad72-49e6-79d2-9785-0d94eb2e4a73","chunk":"Read text file `internal/provhost/closed_vocabulary_census_test.go`.\n(499 line(s) above)\n500|\tdocument, err := specdoc.Load()\n501|\tif err != nil {\n502|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n503|\t}\n504|\trow := sectionLines(t, document, \"7.5\", 2905, 2905)\n505|\t// Each member of this row is its own code span, so the state\n506|\t// cell is the single span opening with \"state:\", split on the\n507|\t// document's pipe entity. Zero or two matching spans is a blind\n508|\t// check.\n509|\tvar want []string\n510|\tmatches := 0\n511|\tfor _, span := range codeSpansOf(t, row) {\n512|\t\tif strings.HasPrefix(span, \"state:\") {\n513|\t\t\twant = strings.Split(strings.TrimPrefix(span, \"state:\"), \"&#124;\")\n514|\t\t\tmatches++\n515|\t\t}\n516|\t}\n517|\tif matches != 1 {\n518|\t\tt.Fatalf(\"Section 7.5 row holds %d state cells, want exactly one; the check is blind\", matches)\n519|\t}\n520|\tfor _, state := range want {\n521|\t\tif strings.TrimSpace(state) == \"\" {\n522|\t\t\tt.Fatalf(\"Section 7.5 state cell parses to an empty member; the check is blind\")\n523|\t\t}\n524|\t}\n525|\tvar got []string\n526|\tfor state := range statusStates {\n527|\t\tgot = append(got, state)\n528|\t}\n529|\trequireMemberSet(t, \"statusStates\", got, want)\n530|}\n531|\n532|// TestAllProductionSwitchesAreClassified closes the switch residue\n533|// the package-level census cannot see: every switch statement in\n534|// production source must be a classified dispatch, never a membership\n535|// gate. The one remaining switch dispatches on a state\n536|// DecodeStatusOutcome already proved a registry member, so widening\n537|// its cases admits nothing. A new switch — the shape three closed\n538|// vocabularies used to hide in — fails here until it is classified,\n539|// which is what keeps the header claim true.\n540|func TestAllProductionSwitchesAreClassified(t *testing.T) {\n541|\tdirectory, err := os.Getwd()\n542|\tif err != nil {\n543|\t\tt.Fatalf(\"classify production switches: %v\", err)\n544|\t}\n545|\t// classified maps the enclosing function of each allowed switch to\n546|\t// the reason it cannot admit a new member.\n547|\tclassified := map[string]string{\n548|\t\t\"DecodeStatusOutcome\": \"dispatches on a state validStatusState already proved a registry member\",\n549|\t}\n550|\tmatched := map[string]bool{}\n551|\tfiles := 0\n552|\tproductions, _ := invcore.MustScanProduction(t, directory)\n553|\tfor _, production := range productions {\n554|\t\tsyntax, name := production.Syntax, production.Name\n555|\t\tfiles++\n556|\t\tfor _, decl := range syntax.Decls {\n557|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n558|\t\t\tif !ok || function.Body == nil {\n559|\t\t\t\tcontinue\n560|\t\t\t}\n561|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n562|\t\t\t\tif _, isSwitch := node.(*ast.SwitchStmt); !isSwitch {\n563|\t\t\t\t\treturn true\n564|\t\t\t\t}\n565|\t\t\t\treason, ok := classified[function.Name.Name]\n566|\t\t\t\tif !ok {\n567|\t\t\t\t\tt.Fatalf(\"unclassified switch in %s (%s): a membership gate here is invisible to the census\", name, function.Name.Name)\n568|\t\t\t\t}\n569|\t\t\t\tmatched[function.Name.Name] = true\n570|\t\t\t\tt.Logf(\"classified switch in %s (%s): %s\", name, function.Name.Name, reason)\n571|\t\t\t\treturn true\n572|\t\t\t})\n573|\t\t}\n574|\t\t// Package-level initializer closures hold no switch today;\n575|\t\t// one appearing there is unclassified by construction.\n576|\t\tfor _, decl := range syntax.Decls {\n577|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n578|\t\t\tif !ok {\n579|\t\t\t\tcontinue\n580|\t\t\t}\n581|\t\t\tast.Inspect(general, func(node ast.Node) bool {\n582|\t\t\t\tif _, isSwitch := node.(*ast.SwitchStmt); isSwitch {\n583|\t\t\t\t\tt.Fatalf(\"unclassified switch in a package initializer in %s: a membership gate here is invisible to the census\", name)\n584|\t\t\t\t}\n585|\t\t\t\treturn true\n586|\t\t\t})\n587|\t\t}\n588|\t}\n589|\tif files == 0 {\n590|\t\tt.Fatal(\"scanned zero production files; the switch classification is blind, not the package\")\n591|\t}\n592|\tfor function := range classified {\n593|\t\tif !matched[function] {\n594|\t\t\tt.Fatalf(\"classified switch %q matches no production switch; the classification is stale\", function)\n595|\t\t}\n596|\t}\n597|}\n598|\n599|// deriveMembershipVocabularies parses production source for every\n600|// package-level []string, map[string]bool, and map[string]string\n601|// consulted by a membership check. An empty scan fails closed: a\n602|// domain that silently derives nothing is not a measurement.\n603|func deriveMembershipVocabularies(t *testing.T) map[string]struct{} {\n604|\tt.Helper()\n605|\tdirectory, err := os.Getwd()\n606|\tif err != nil {\n607|\t\tt.Fatalf(\"derive membership vocabularies: %v\", err)\n608|\t}\n609|\tvocabularies, scanned, err := membershipVocabulariesIn(directory)\n610|\tif err != nil {\n611|\t\tt.Fatalf(\"derive membership vocabularies: %v\", err)\n612|\t}\n613|\tif len(scanned) == 0 {\n614|\t\tt.Fatal(\"derived membership vocabularies from zero production files; the scanner is broken, not the package\")\n615|\t}\n616|\tif len(vocabularies) == 0 {\n617|\t\tt.Fatal(\"derived zero membership vocabularies from the package sources; the scanner is broken, not the package\")\n618|\t}\n619|\tt.Logf(\"membership vocabulary domain: %d derived vocabularies across %d production files\", len(vocabularies), len(scanned))\n620|\treturn vocabularies\n621|}\n622|\n623|// membershipVocabulariesIn collects the package-level vocabularies of\n624|// the three membership shapes and keeps those with membership use:\n625|// an unknownMember argument, a direct map index, or a range operand.\n626|// A variable whose only production uses are missingMember arguments\n627|// is a refusal-order list, not a containment vocabulary, and is\n628|// excluded by design.\n629|func membershipVocabulariesIn(directory string) (map[string]struct{}, []string, error) {\n630|\tscannedFiles, _, failures := invcore.ScanProduction(directory)\n631|\tif len(failures) != 0 {\n632|\t\treturn nil, nil, errors.New(strings.Join(failures, \"; \"))\n633|\t}\n634|\ttype productionFile struct {\n635|\t\tsyntax *ast.File\n636|\t}\n637|\tvar files []productionFile\n638|\tvar scanned []string\n639|\tshapes := map[string]bool{}\n640|\tfor _, production := range scannedFiles {\n641|\t\tscanned = append(scanned, production.Name)\n642|\t\tsyntax := production.Syntax\n643|\t\tfiles = append(files, productionFile{syntax: syntax})\n644|\t\tfor _, decl := range syntax.Decls {\n645|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n646|\t\t\tif !ok || general.Tok != token.VAR {\n647|\t\t\t\tcontinue\n648|\t\t\t}\n649|\t\t\tfor _, spec := range general.Specs {\n650|\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n651|\t\t\t\tif !ok {\n652|\t\t\t\t\tcontinue\n653|\t\t\t\t}\n654|\t\t\t\tshape := valueShape(value)\n655|\t\t\t\tif shape == \"\" {\n656|\t\t\t\t\tcontinue\n657|\t\t\t\t}\n658|\t\t\t\tfor _, name := range value.Names {\n659|\t\t\t\t\tshapes[name.Name] = true\n660|\t\t\t\t}\n661|\t\t\t}\n662|\t\t}\n663|\t}\n664|\tunknownUsed := map[string]bool{}\n665|\tindexed := map[string]bool{}\n666|\tranged := map[string]bool{}\n667|\tfor _, file := range files {\n668|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n669|\t\t\tcall, ok := node.(*ast.CallExpr)\n670|\t\t\tif !ok {\n671|\t\t\t\treturn true\n672|\t\t\t}\n673|\t\t\tident, ok := call.Fun.(*ast.Ident)\n674|\t\t\tif !ok || ident.Name != \"unknownMember\" {\n675|\t\t\t\treturn true\n676|\t\t\t}\n677|\t\t\tfor _, arg := range call.Args {\n678|\t\t\t\tif name, ok := arg.(*ast.Ident); ok {\n679|\t\t\t\t\tunknownUsed[name.Name] = true\n680|\t\t\t\t}\n681|\t\t\t}\n682|\t\t\treturn true\n683|\t\t})\n684|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n685|\t\t\tindex, ok := node.(*ast.IndexExpr)\n686|\t\t\tif !ok {\n687|\t\t\t\treturn true\n688|\t\t\t}\n689|\t\t\tif name, ok := index.X.(*ast.Ident); ok {\n690|\t\t\t\tindexed[name.Name] = true\n691|\t\t\t}\n692|\t\t\treturn true\n693|\t\t})\n694|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n695|\t\t\tloop, ok := node.(*ast.RangeStmt)\n696|\t\t\tif !ok {\n697|\t\t\t\treturn true\n698|\t\t\t}\n699|\t\t\tif name, ok := loop.X.(*ast.Ident); ok {\n700|\t\t\t\tranged[name.Name] = true\n701|\t\t\t}\n702|\t\t\treturn true\n703|\t\t})\n704|\t}\n705|\tvocabularies := map[string]struct{}{}\n706|\tfor name := range shapes {\n707|\t\tif unknownUsed[name] || indexed[name] || ranged[name] {\n708|\t\t\tvocabularies[name] = struct{}{}\n709|\t\t}\n710|\t}\n711|\tsort.Strings(scanned)\n712|\treturn vocabularies, scanned, nil\n713|}\n714|\n715|// valueShape reports whether a package-level variable declaration is\n716|// one of the three membership-vocabulary shapes: a []string, a\n717|// map[string]bool, or a map[string]string. Anything else reports \"\".\n718|func valueShape(value *ast.ValueSpec) string {\n719|\tcandidate := value.Type\n(more lines below)","final_result":true}}}
