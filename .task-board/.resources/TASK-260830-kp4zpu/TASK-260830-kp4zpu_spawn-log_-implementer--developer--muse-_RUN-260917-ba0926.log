{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca2f","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":882,"recorded_at":1780531400001759,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad70-8cc4-7bb3-8701-9972bded5ae6"},"task_id":"01a0ad70-8cc4-7bb3-8701-9972bded5ae6","event":{"kind":"output","task_id":"01a0ad70-8cc4-7bb3-8701-9972bded5ae6","chunk":"Read text file `internal/provhost/opdecode.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for the Section 7.3-7.7 operation\n16|// bodies. Every helper reports a verdict and never refuses: all refusals\n17|// call one of the six refusal constructors directly at the deciding site\n18|// with a literal detail, so the refusal-arm inventory keeps seeing every\n19|// arm. A helper that fronted a constructor would collapse distinct rules\n20|// into one obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer: Section\n23|// 7.5 counts and Section 5.1 limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// unknownMember names a member outside the closed set, if any.\n27|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n28|\tfor name := range members {\n29|\t\tif !allowed[name] {\n30|\t\t\treturn name, true\n31|\t\t}\n32|\t}\n33|\treturn \"\", false\n34|}\n35|\n36|// missingMember names the first required member with no value, if any.\n37|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n38|\tfor _, name := range required {\n39|\t\tif _, present := members[name]; !present {\n40|\t\t\treturn name, true\n41|\t\t}\n42|\t}\n43|\treturn \"\", false\n44|}\n45|\n46|// rawString reads a JSON string member.\n47|func rawString(raw json.RawMessage) (string, bool) {\n48|\tvar value string\n49|\tif err := json.Unmarshal(raw, &value); err != nil {\n50|\t\treturn \"\", false\n51|\t}\n52|\treturn value, true\n53|}\n54|\n55|// rawBool reads a JSON boolean member.\n56|func rawBool(raw json.RawMessage) (bool, bool) {\n57|\tvar value bool\n58|\tif err := json.Unmarshal(raw, &value); err != nil {\n59|\t\treturn false, false\n60|\t}\n61|\treturn value, true\n62|}\n63|\n64|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n65|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n66|// even when it names the same mathematical value: the canonical bodies\n67|// carry counts, never measurements.\n68|func rawUint53(raw json.RawMessage) (uint64, bool) {\n69|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n70|\tdecoder.UseNumber()\n71|\tvar value any\n72|\tif err := decoder.Decode(&value); err != nil {\n73|\t\treturn 0, false\n74|\t}\n75|\t// Decode reads one value and stops: without the trailing\n76|\t// check a hostile slice like `12a` would read as 12. Member\n77|\t// slices arriving through decodeStrictObject can never carry\n78|\t// trailing data, but this entry takes raw slices and must\n79|\t// not trust them.\n80|\tif _, err := decoder.Token(); err != io.EOF {\n81|\t\treturn 0, false\n82|\t}\n83|\tnumber, ok := value.(json.Number)\n84|\tif !ok {\n85|\t\treturn 0, false\n86|\t}\n87|\tliteral := number.String()\n88|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n89|\t\treturn 0, false\n90|\t}\n91|\tparsed, err := strconv.ParseUint(literal, 10, 64)\n92|\tif err != nil || parsed > maxUint53 {\n93|\t\treturn 0, false\n94|\t}\n95|\treturn parsed, true\n96|}\n97|\n98|// rawNullableString reads a JSON string-or-null member: null reports\n99|// isNull without a value, any other non-string reports !ok.\n100|func rawNullableString(raw json.RawMessage) (value string, isNull bool, ok bool) {\n101|\tif string(raw) == \"null\" {\n102|\t\treturn \"\", true, true\n103|\t}\n104|\tvalue, ok = rawString(raw)\n105|\treturn value, false, ok\n106|}\n107|\n108|// rawArray reads a JSON array member into its raw elements. Null is not\n109|// an array: every array member in Sections 7.3-7.5 is required.\n110|func rawArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n111|\tif string(bytes.TrimSpace(raw)) == \"null\" {\n112|\t\treturn nil, false\n113|\t}\n114|\tvar elements []json.RawMessage\n115|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n116|\tdecoder.UseNumber()\n117|\tif err := decoder.Decode(&elements); err != nil {\n118|\t\treturn nil, false\n119|\t}\n120|\tif elements == nil {\n121|\t\treturn []json.RawMessage{}, true\n122|\t}\n123|\treturn elements, true\n124|}\n125|\n126|// rawStringArray reads an array whose every element is a JSON string.\n127|func rawStringArray(raw json.RawMessage) ([]string, bool) {\n128|\telements, ok := rawArray(raw)\n129|\tif !ok {\n130|\t\treturn nil, false\n131|\t}\n132|\tout := make([]string, 0, len(elements))\n133|\tfor _, element := range elements {\n134|\t\tvalue, ok := rawString(element)\n135|\t\tif !ok {\n136|\t\t\treturn nil, false\n137|\t\t}\n138|\t\tout = append(out, value)\n139|\t}\n140|\treturn out, true\n141|}\n142|\n143|// sortedUniqueStrings reports whether the values are in strictly\n144|// increasing bytewise order: sorted with no duplicates. Bytewise order\n145|// is the canonical-form order every closed array in Sections 7.3-7.5\n146|// is written in.\n147|func sortedUniqueStrings(values []string) bool {\n148|\treturn sort.StringsAreSorted(values) && !hasDuplicateString(values)\n149|}\n150|\n151|func hasDuplicateString(values []string) bool {\n152|\tfor i := 1; i < len(values); i++ {\n153|\t\tif values[i] == values[i-1] {\n154|\t\t\treturn true\n155|\t\t}\n156|\t}\n157|\treturn false\n158|}\n159|\n160|// runeLength reports the Unicode-character length the Section 7 string\n161|// bounds count in. JSON transport is UTF-8, so characters are runes,\n162|// not bytes and not code units.\n163|func runeLength(value string) int {\n164|\treturn utf8.RuneCountInString(value)\n165|}\n166|\n167|// isDigest reports whether the value parses as a content digest.\n168|func isDigest(value string) bool {\n169|\t_, err := scalar.ParseDigest(value)\n170|\treturn err == nil\n171|}\n172|\n173|// isUUIDv7 reports whether the value parses as a UUIDv7.\n174|func isUUIDv7(value string) bool {\n175|\t_, err := scalar.ParseUUIDv7(value)\n176|\treturn err == nil\n177|}\n178|\n179|// isTimestamp reports whether the value parses as a timestamp.\n180|func isTimestamp(value string) bool {\n181|\t_, err := scalar.ParseTimestamp(value)\n182|\treturn err == nil\n183|}","final_result":true}}}
