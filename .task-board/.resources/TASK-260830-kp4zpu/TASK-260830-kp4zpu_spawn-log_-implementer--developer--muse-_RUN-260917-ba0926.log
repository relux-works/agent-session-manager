ct, \\\"schema_version\\\", version); err != nil {\\ninternal/canonicaljson/core_records.go-1124-\\t\\treturn err\\ninternal/canonicaljson/core_records.go-1125-\\t}\\ninternal/canonicaljson/core_records.go-1126-\\tif err := requireDigest(object, selfField); err != nil {\\ninternal/canonicaljson/core_records.go-1127-\\t\\treturn err\\ninternal/canonicaljson/core_records.go-1128-\\t}\\ninternal/canonicaljson/core_records.go-1129-\\treturn validateCommonRecordEnvelope(object)\\ninternal/canonicaljson/core_records.go-1130-}\\ninternal/canonicaljson/core_records.go-1131-\\ninternal/canonicaljson/core_records.go-1132-func requireArrayRange(object map[string]any, name string, minimum, maximum int) ([]any, error) {\\ninternal/canonicaljson/core_records.go-1133-\\tvalues, err := requireArray(object, name, maximum)\\ninternal/canonicaljson/core_records.go-1134-\\tif err != nil {\\ninternal/canonicaljson/core_records.go-1135-\\t\\treturn nil, err\\ninternal/canonicaljson/core_records.go-1136-\\t}\\ninternal/canonicaljson/core_records.go-1137-\\tif len(values) < minimum {\\ninternal/canonicaljson/core_records.go-1138-\\t\\treturn nil, invalidIdentity(\\\"member %s requires at least %d entries\\\", name, minimum)\\ninternal/canonicaljson/core_records.go-1139-\\t}\\ninternal/canonicaljson/core_records.go-1140-\\treturn values, nil\\ninternal/canonicaljson/core_records.go-1141-}\\ninternal/canonicaljson/core_records.go-1142-\\ninternal/canonicaljson/core_records.go-1143-func requireArrayMinimum(object map[string]any, name string, minimum int) ([]any, error) {\\ninternal/canonicaljson/core_records.go-1144-\\tvalue, ok := object[name]\\ninternal/canonicaljson/core_records.go-1145-\\tif !ok {\\ninternal/canonicaljson/core_records.go-1146-\\t\\treturn nil, invalidIdentity(\\\"identity input requires member %s\\\", name)\\ninternal/canonicaljson/core_records.go-1147-\\t}\\ninternal/canonicaljson/core_records.go-1148-\\tvalues, ok := value.([]any)\\ninternal/canonicaljson/core_records.g