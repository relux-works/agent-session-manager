{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cafd","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":985,"recorded_at":1780531400001965,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad71-c08f-7662-bda0-9884e262b434"},"task_id":"01a0ad71-c08f-7662-bda0-9884e262b434","event":{"kind":"output","task_id":"01a0ad71-c08f-7662-bda0-9884e262b434","chunk":"Read text file `internal/provhost/manifest.go`.\n(99 line(s) above)\n100|\t\tfailure, err := failProtocol(\"manifest carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, manifestRequired); missing {\n107|\t\tfailure, err := failProtocol(\"manifest misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n114|\t\tfailure, err := failProtocol(\"manifest schema is not the provider manifest\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n121|\t\tfailure, err := failProtocol(\"manifest schema_version is not 1.0.0\", \"schema_version\")\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n128|\t\tfailure, err := failProtocol(\"manifest provider_id is not a provider id\", \"provider_id\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tif name, ok := rawString(members[\"display_name\"]); !ok || runeLength(name) < 1 || runeLength(name) > 128 {\n135|\t\tfailure, err := failProtocol(\"manifest display_name is not 1..128 characters\", \"display_name\")\n136|\t\tif err != nil {\n137|\t\t\treturn err\n138|\t\t}\n139|\t\treturn failure\n140|\t}\n141|\tif version, ok := rawString(members[\"plugin_version\"]); !ok || !semverPattern.MatchString(version) {\n142|\t\tfailure, err := failProtocol(\"manifest plugin_version is not SemVer\", \"plugin_version\")\n143|\t\tif err != nil {\n144|\t\t\treturn err\n145|\t\t}\n146|\t\treturn failure\n147|\t}\n148|\tif constraint, ok := rawString(members[\"provider_version_range\"]); !ok || runeLength(constraint) < 1 || runeLength(constraint) > 256 {\n149|\t\tfailure, err := failProtocol(\"manifest provider_version_range is not 1..256 characters\", \"provider_version_range\")\n150|\t\tif err != nil {\n151|\t\t\treturn err\n152|\t\t}\n153|\t\treturn failure\n154|\t}\n155|\tif err := checkManifestPlatforms(members[\"platforms\"]); err != nil {\n156|\t\treturn err\n157|\t}\n158|\tif err := checkManifestOperations(members[\"operations\"]); err != nil {\n159|\t\treturn err\n160|\t}\n161|\tif err := checkManifestCapabilities(members[\"capability_names\"]); err != nil {\n162|\t\treturn err\n163|\t}\n164|\treturn nil\n165|}\n166|\n167|// validProviderID reports whether the value satisfies the Section 7.1\n168|// provider-id grammar without importing the trust package: the manifest\n169|// layer reads the grammar, never the filesystem.\n170|func validProviderID(value string) bool {\n171|\treturn providerIDPattern.MatchString(value)\n172|}\n173|\n174|// checkManifestPlatforms enforces the sorted, unique, non-empty subset\n175|// rule over the four platform enums. Each shape carries its own\n176|// refusal so narrowing any one check reddens its own fixture.\n177|func checkManifestPlatforms(raw json.RawMessage) error {\n178|\tplatforms, ok := rawStringArray(raw)\n179|\tif !ok || len(platforms) == 0 {\n(more lines below)","final_result":true}}}
