{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1b9","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":1847,"recorded_at":1780531400003689,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad7a-009c-71c2-87cf-4acf5a251d06"},"task_id":"01a0ad7a-009c-71c2-87cf-4acf5a251d06","event":{"kind":"output","task_id":"01a0ad7a-009c-71c2-87cf-4acf5a251d06","chunk":"Read text file `internal/provhost/protocol_test.go`.\n(83 line(s) above)\n84|func failureExit(t *testing.T, err error) int {\n85|\tt.Helper()\n86|\tvar failure *axerror.Error\n87|\tif !asError(t, err, &failure) {\n88|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n89|\t}\n90|\treturn failure.ExitCode()\n91|}\n92|\n93|// failureObject unwraps err to the Structured Error itself, so arm\n94|// identity beyond the stable code can be asserted.\n95|func failureObject(t *testing.T, err error) *axerror.Error {\n96|\tt.Helper()\n97|\tif err == nil {\n98|\t\tt.Fatal(\"want a failure, got nil\")\n99|\t}\n100|\tvar failure *axerror.Error\n101|\tif !asError(t, err, &failure) {\n102|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n103|\t}\n104|\treturn failure\n105|}\n106|\n107|// failureMember returns the \"member\" diagnostic of a frame refusal. Every\n108|// provider_protocol_error arm names the member it refused on, so asserting\n109|// it pins the arm: a missing-member gate deleted from checkResponseMembers\n110|// slides to a lower arm carrying the same code with a different member or\n111|// detail, and the slide reddens here instead of passing silently.\n112|func failureMember(t *testing.T, err error) string {\n113|\tt.Helper()\n114|\tfailure := failureObject(t, err)\n115|\tmember, ok := failure.Detail(\"member\")\n116|\tif !ok {\n117|\t\tt.Fatalf(\"refusal %v carries no member detail\", err)\n118|\t}\n119|\ttext, ok := member.(string)\n120|\tif !ok {\n121|\t\tt.Fatalf(\"refusal %v member detail is %T, want string\", err, member)\n122|\t}\n123|\treturn text\n124|}\n125|\n126|// requireFrameRefusal asserts the full arm identity of a plugin-frame\n127|// refusal: the stable code, the refused member, the detail naming the\n128|// rule, and the non-retryable bit doc.go promises for every local\n129|// failure this package emits.\n130|func requireFrameRefusal(t *testing.T, err error, member, detail string) {\n131|\tt.Helper()\n132|\tif failureCode(t, err) != \"provider_protocol_error\" {\n133|\t\tt.Fatalf(\"DecodeResponse code = %v, want provider_protocol_error\", err)\n134|\t}\n135|\tif got := failureMember(t, err); got != member {\n136|\t\tt.Fatalf(\"DecodeResponse member = %q, want %q (detail: %v)\", got, member, err)\n137|\t}\n138|\tif !strings.Contains(err.Error(), detail) {\n139|\t\tt.Fatalf(\"DecodeResponse error = %v, want detail containing %q\", err, detail)\n140|\t}\n141|\tif failureObject(t, err).Retryable() {\n142|\t\tt.Fatalf(\"DecodeResponse error = %v, want non-retryable\", err)\n143|\t}\n144|}\n145|\n146|// requireLocalRefusal asserts the arm identity of a refusal that carries\n147|// no member detail (invalid_config framing refusals and integrity_failure\n148|// status refusals): the stable code, the detail naming the rule in the\n149|// human text, and the non-retryable bit.\n150|func requireLocalRefusal(t *testing.T, err error, code axerror.Code, detail string) {\n151|\tt.Helper()\n152|\tif failureCode(t, err) != code {\n153|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n154|\t}\n155|\tif !strings.Contains(err.Error(), detail) {\n156|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, detail)\n157|\t}\n158|\tif failureObject(t, err).Retryable() {\n159|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n160|\t}\n161|}\n162|\n163|// TestEncodeRequestEmitsExactFrame pins the request wire bytes: the six\n(more lines below)","final_result":true}}}
