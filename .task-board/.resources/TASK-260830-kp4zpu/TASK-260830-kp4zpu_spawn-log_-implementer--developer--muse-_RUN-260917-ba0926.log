\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.6\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/quiesce.go\\\",\\n  \\\"declaration\\\": \\\"DecodeQuiesceProof\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-quiesce-proof\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"DecodeQuiesceProof implements the Section 7.6 quiescence proof decoder with its fail-closed safe-bit rules; the Provider Identity Record it carries is additionally checked by CheckIdentity, and no clause of Section 7.6 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 3 obligations it carries.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.7\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/profile.go\\\",\\n  \\\"declaration\\\": \\\"ProfileMapping\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-profile-mapping\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ProfileMapping implements the Section 7.7 execution-profile mapping as a closed six-provider vocabulary with unknown-profile refusal; version probing before mapping and the launch-plan equality rules belong to later leaves, and no clause of Section 7.7 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 4 obligations it carries.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:8\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/probe.go\\\",\\n  \\\"declaration\\\": \\\"RequireCapability\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-capability-gate\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"RequireCapability implements the Section 8 fail-closed capability gate direction (conditional, unsupported, and unknown surfaces are never usable) without advertising unsupported capabilities; the cell values themselves remain evidence labels and no clause of Section 8 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 12 obligations it carries.\\\"\\n}\\n======\\n\",\n  \"original_output_bytes\": 2652,\n  \"original_output_tokens\": 663,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
