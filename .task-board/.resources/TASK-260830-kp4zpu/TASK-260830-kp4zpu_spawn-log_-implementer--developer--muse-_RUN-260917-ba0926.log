\\\":              true,\\n\\t\\\"cwd\\\":               true,\\n\\t\\\"env_names\\\":         true,\\n\\t\\\"env_literals\\\":      true,\\n\\t\\\"native_session_id\\\": true,\\n\\t\\\"profile_mapping\\\":   true,\\n\\t\\\"extensions\\\":        true,\\n}\\n\\n// spawnRequired lists spawnMembers in a fixed order so a plan missing\\n// several members always names the same one.\\nvar spawnRequired = []string{\\n\\t\\\"argv\\\",\\n\\t\\\"cwd\\\",\\n\\t\\\"env_names\\\",\\n\\t\\\"env_literals\\\",\\n\\t\\\"native_session_id\\\",\\n\\t\\\"profile_mapping\\\",\\n\\t\\\"extensions\\\",\\n}\\n\\n// maxSpawnArgvBytes bounds the total encoded argv Section 5.1 states.\\nconst maxSpawnArgvBytes = 65536\\n\\n// DecodeSpawnPlan validates one launch- or resume-operation success\\n// body as a SpawnPlan for the calling provider under the calling\\n// profile on the destination platform. It returns nil on a\\n// well-formed plan and a refusal naming the offending member\\n// otherwise: a provider_protocol_error for a malformed plan, and an\\n// invalid_config caller error when the caller names an unknown\\n// provider or profile for the mapping check.\\nfunc DecodeSpawnPlan(body []byte, providerID, profile string, platform scalar.Platform) error {\\n\\tmembers, fault := decodeStrictObject(body)\\n\\tif fault != nil {\\n\\t\\tfailure, err := failProtocol(fault.detail, fault.member)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n101:\\tif err := checkSpawnProfileMapping(members[\\\"profile_mapping\\\"], providerID, profile); err != nil {\\n102-\\t\\treturn err\\n103-\\t}\\n104-\\tif !isJSONObject(members[\\\"extensions\\\"]) {\\n105-\\t\\tfailure, err := failProtocol(\\\"spawn extensions is not an object\\\", \\\"extensions\\\")\\n106-\\t\\tif err != nil {\\n107-\\t\\t\\treturn err\\n108-\\t\\t}\\n109-\\t\\treturn failure\\n110-\\t}\\n111-\\treturn nil\\n112-}\\n113-\\n114-// isAbsoluteOn reports whether the path is absolute on the\\n115-// destination platform. Destination-native is the Section 7.5 rule;\\n116-// the platform arrives from the caller because the plan carries none.\\n117-func isAbsoluteOn(path string, platform scalar.Platform) bool {\\n118-\\t_, err := scalar.ParseAbsolutePath(platform, path)\\n119-\\treturn err == nil\\n120-}\\n121-\\n122-// isBoundedString reports whether the raw JSON string counts 1..max\\n123-// Unicode characters. The caller already established it is a string.\\n124-func isBoundedString(raw json.RawMessage, min, max int) bool {\\n125-\\tvalue, ok := rawString(raw)\\n126-\\tif !ok {\\n127-\\t\\treturn false\\n128-\\t}\\n129-\\tlength := runeLength(value)\\n130-\\treturn length >= min && length <= max\\n131-}\\n--\\n251:// checkSpawnProfileMapping requires profile_mapping to equal the\\n252-// Section 7.7 mapping for the calling provider and profile. A\\n253-// provider that answers yolo with the standard omission, or standard\\n254-// with a yolo flag, fails here rather than executing under the wrong\\n255-// sandbox. Unknown providers and profiles are caller errors that\\n256-// propagate from the mapping table.\\n257:func checkSpawnProfileMapping(raw json.RawMessage, providerID, profile string) error {\\n258-\\tmapping, ok := rawString(raw)\\n\",\n  \"original_output_bytes\": 3742,\n  \"original_output_tokens\": 936,\n  \"truncated\": false\n}","final_result":true}}}
