{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c849","stream":{"kind":"session","id":"01a0ad6e-3dc6-7091-89ac-ffb24ddb613d"},"sequence":639,"recorded_at":1780531400001273,"record_type":"event","durability":"durable","causation_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"33c437db-b2c4-4fed-b492-4dcd097e109a","run_stream":{"kind":"run","id":"33c437db-b2c4-4fed-b492-4dcd097e109a"},"task_stream":{"kind":"task","id":"01a0ad6f-a70f-7061-ad15-fa8c96fcc8e0"},"task_id":"01a0ad6f-a70f-7061-ad15-fa8c96fcc8e0","event":{"kind":"output","task_id":"01a0ad6f-a70f-7061-ad15-fa8c96fcc8e0","chunk":"Read text file `internal/provhost/probe.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.4 Capability result: the closed\n8|// urn:ax:schema:provider-probe 1.0.0 object a probe operation returns\n9|// as its success body. It also owns the host-side availability gate:\n10|// only available MAY be enabled, and the host MUST NOT treat a\n11|// conditional, unsupported, or unknown capability as usable, no matter\n12|// what enabled claims.\n13|\n14|// probeSchema is the exact schema identifier the probe carries.\n15|const probeSchema = \"urn:ax:schema:provider-probe\"\n16|\n17|// probeSchemaVersion is the only probe version this host accepts.\n18|const probeSchemaVersion = \"1.0.0\"\n19|\n20|// Probe capability statuses Section 7.4 defines. Only Available MAY\n21|// set enabled true; every other status MUST NOT be advertised as\n22|// usable, which CapabilityUsable enforces.\n23|const (\n24|\tCapabilityAvailable   = \"available\"\n25|\tCapabilityConditional = \"conditional\"\n26|\tCapabilityUnsupported = \"unsupported\"\n27|\tCapabilityUnknown     = \"unknown\"\n28|)\n29|\n30|// probeCapabilityStatuses is the closed status vocabulary in the\n31|// Section 7.4 order.\n32|var probeCapabilityStatuses = []string{\n33|\tCapabilityAvailable,\n34|\tCapabilityConditional,\n35|\tCapabilityUnsupported,\n36|\tCapabilityUnknown,\n37|}\n38|\n39|// Probe capability evidence Section 7.4 defines, in section order.\n40|var probeCapabilityEvidence = []string{\n41|\t\"documented\",\n42|\t\"probed\",\n43|\t\"accepted_test\",\n44|\t\"provider_contract\",\n45|\t\"inferred\",\n46|\t\"acceptance_required\",\n47|\t\"none\",\n48|}\n49|\n50|// probeArchitectures is the closed architecture vocabulary.\n51|var probeArchitectures = []string{\"amd64\", \"arm64\"}\n52|\n53|// probePlatforms is the closed platform vocabulary: the four Section\n54|// 7.3 enums. WSL2 and native Windows are distinct rows; one never\n55|// stands for the other.\n56|var probePlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n57|\n58|// probeMembers is the exact required member set DecodeProbe accepts.\n59|var probeMembers = map[string]bool{\n60|\t\"schema\":           true,\n61|\t\"schema_version\":   true,\n62|\t\"provider_id\":      true,\n63|\t\"provider_version\": true,\n64|\t\"platform\":         true,\n65|\t\"architecture\":     true,\n66|\t\"capabilities\":     true,\n67|\t\"warnings\":         true,\n68|}\n69|\n70|// probeRequired lists probeMembers in a fixed order so a body missing\n71|// several members always names the same one.\n72|var probeRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"provider_id\",\n76|\t\"provider_version\",\n77|\t\"platform\",\n78|\t\"architecture\",\n79|\t\"capabilities\",\n80|\t\"warnings\",\n81|}\n82|\n83|// probeCapabilityMembers is the exact member set of one capability\n84|// value: status, enabled, evidence, and detail, nothing else.\n85|var probeCapabilityMembers = map[string]bool{\n86|\t\"status\":   true,\n87|\t\"enabled\":  true,\n88|\t\"evidence\": true,\n89|\t\"detail\":   true,\n90|}\n91|\n92|// probeCapabilityRequired lists probeCapabilityMembers in a fixed\n93|// order so a value missing several members always names the same one.\n94|var probeCapabilityRequired = []string{\"status\", \"enabled\", \"evidence\", \"detail\"}\n95|\n96|// DecodeProbe validates one probe-operation success body as the closed\n97|// Section 7.4 probe object. It returns nil on a well-formed probe and\n98|// a provider_protocol_error naming the offending member otherwise. A\n99|// capability that claims enabled under any status but available is\n100|// refused here, not at use time: an advertised-but-unusable surface\n101|// must never reach the caller as a probe result.\n102|func DecodeProbe(body []byte) error {\n103|\t_, err := decodeValidatedProbe(body)\n104|\treturn err\n105|}\n106|\n107|// decodeValidatedProbe is the single site that decodes a probe body\n108|// into members: every check DecodeProbe performs lives here, and the\n109|// validated members are returned for use sites to consume. Validation\n110|// and use couple here on purpose — RequireCapability must consume\n111|// these members rather than re-decoding the body after a separate\n112|// DecodeProbe call, so a future reorder cannot silently drop faults\n113|// between the validation and the use. Keep the validation first at\n114|// every caller: the sub-object replays below prove nothing on their\n115|// own.\n116|func decodeValidatedProbe(body []byte) (map[string]json.RawMessage, error) {\n117|\tmembers, fault := decodeStrictObject(body)\n118|\tif fault != nil {\n119|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n120|\t\tif err != nil {\n121|\t\t\treturn nil, err\n122|\t\t}\n123|\t\treturn nil, failure\n124|\t}\n125|\tif name, unknown := unknownMember(members, probeMembers); unknown {\n126|\t\tfailure, err := failProtocol(\"probe carries unknown member\", name)\n127|\t\tif err != nil {\n128|\t\t\treturn nil, err\n129|\t\t}\n130|\t\treturn nil, failure\n131|\t}\n132|\tif name, missing := missingMember(members, probeRequired); missing {\n133|\t\tfailure, err := failProtocol(\"probe misses a required member\", name)\n134|\t\tif err != nil {\n135|\t\t\treturn nil, err\n136|\t\t}\n137|\t\treturn nil, failure\n138|\t}\n139|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != probeSchema {\n140|\t\tfailure, err := failProtocol(\"probe schema is not the provider probe\", \"schema\")\n141|\t\tif err != nil {\n142|\t\t\treturn nil, err\n143|\t\t}\n144|\t\treturn nil, failure\n145|\t}\n146|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != probeSchemaVersion {\n147|\t\tfailure, err := failProtocol(\"probe schema_version is not 1.0.0\", \"schema_version\")\n148|\t\tif err != nil {\n149|\t\t\treturn nil, err\n150|\t\t}\n151|\t\treturn nil, failure\n152|\t}\n153|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n154|\t\tfailure, err := failProtocol(\"probe provider_id is not a provider id\", \"provider_id\")\n155|\t\tif err != nil {\n156|\t\t\treturn nil, err\n157|\t\t}\n158|\t\treturn nil, failure\n159|\t}\n160|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n161|\t\tfailure, err := failProtocol(\"probe provider_version is not 1..128 characters\", \"provider_version\")\n162|\t\tif err != nil {\n163|\t\t\treturn nil, err\n164|\t\t}\n165|\t\treturn nil, failure\n166|\t}\n167|\tif platform, ok := rawString(members[\"platform\"]); !ok || !isProbePlatform(platform) {\n168|\t\tfailure, err := failProtocol(\"probe platform is not a registry member\", \"platform\")\n169|\t\tif err != nil {\n170|\t\t\treturn nil, err\n171|\t\t}\n172|\t\treturn nil, failure\n173|\t}\n174|\tif architecture, ok := rawString(members[\"architecture\"]); !ok || !isProbeArchitecture(architecture) {\n175|\t\tfailure, err := failProtocol(\"probe architecture is not amd64 or arm64\", \"architecture\")\n176|\t\tif err != nil {\n177|\t\t\treturn nil, err\n178|\t\t}\n179|\t\treturn nil, failure\n180|\t}\n181|\tif err := checkProbeCapabilities(members[\"capabilities\"]); err != nil {\n182|\t\treturn nil, err\n183|\t}\n184|\tif err := checkProbeWarnings(members[\"warnings\"]); err != nil {\n185|\t\treturn nil, err\n186|\t}\n187|\treturn members, nil\n188|}\n189|\n190|func isProbePlatform(value string) bool {\n191|\tfor _, platform := range probePlatforms {\n192|\t\tif value == platform {\n193|\t\t\treturn true\n194|\t\t}\n195|\t}\n196|\treturn false\n197|}\n198|\n199|func isProbeArchitecture(value string) bool {\n200|\tfor _, architecture := range probeArchitectures {\n201|\t\tif value == architecture {\n202|\t\t\treturn true\n203|\t\t}\n204|\t}\n205|\treturn false\n206|}\n207|\n208|// checkProbeCapabilities requires exactly the seven registry keys,\n209|// each carrying a closed status/enabled/evidence/detail value. The\n210|// per-key loop is derived from capabilityOrder, never from a sample:\n211|// a validation that held for three capabilities and skipped the rest\n212|// would pass a probe this function must refuse.\n213|func checkProbeCapabilities(raw json.RawMessage) error {\n214|\tdecoded, fault := decodeStrictObject(raw)\n215|\tif fault != nil {\n216|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n217|\t\tif err != nil {\n218|\t\t\treturn err\n219|\t\t}\n220|\t\treturn failure\n221|\t}\n222|\tfor _, name := range capabilityOrder {\n223|\t\tif _, present := decoded[name]; !present {\n224|\t\t\tfailure, err := failProtocol(\"probe capabilities miss a registry key\", \"capabilities\")\n225|\t\t\tif err != nil {\n226|\t\t\t\treturn err\n227|\t\t\t}\n228|\t\t\treturn failure\n229|\t\t}\n230|\t}\n231|\tfor name := range decoded {\n232|\t\tknown := false\n233|\t\tfor _, registry := range capabilityOrder {\n234|\t\t\tif name == registry {\n235|\t\t\t\tknown = true\n236|\t\t\t}\n237|\t\t}\n238|\t\tif !known {\n239|\t\t\tfailure, err := failProtocol(\"probe capabilities carry an unknown key\", \"capabilities\")\n240|\t\t\tif err != nil {\n241|\t\t\t\treturn err\n242|\t\t\t}\n243|\t\t\treturn failure\n244|\t\t}\n245|\t}\n246|\tfor _, name := range capabilityOrder {\n247|\t\tif err := checkProbeCapabilityValue(decoded[name]); err != nil {\n248|\t\t\treturn err\n249|\t\t}\n250|\t}\n251|\treturn nil\n252|}\n253|\n254|// checkProbeCapabilityValue validates one capability value object. The\n255|// member parameter of every refusal below is \"capabilities\": the\n256|// detail names the violated rule, and the per-key sweep in the\n257|// conformance tests proves each registry key answers to it.\n258|func checkProbeCapabilityValue(raw json.RawMessage) error {\n259|\tvalue, fault := decodeStrictObject(raw)\n260|\tif fault != nil {\n261|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n262|\t\tif err != nil {\n263|\t\t\treturn err\n264|\t\t}\n265|\t\treturn failure\n266|\t}\n267|\tif _, unknown := unknownMember(value, probeCapabilityMembers); unknown {\n268|\t\tfailure, err := failProtocol(\"probe capability carries an unknown member\", \"capabilities\")\n269|\t\tif err != nil {\n270|\t\t\treturn err\n271|\t\t}\n272|\t\treturn failure\n273|\t}\n274|\tif _, missing := missingMember(value, probeCapabilityRequired); missing {\n275|\t\tfailure, err := failProtocol(\"probe capability misses a required member\", \"capabilities\")\n276|\t\tif err != nil {\n277|\t\t\treturn err\n278|\t\t}\n279|\t\treturn failure\n280|\t}\n281|\tstatus, ok := rawString(value[\"status\"])\n282|\tif !ok || !isProbeStatus(status) {\n283|\t\tfailure, err := failProtocol(\"probe capability status is not a registry member\", \"capabilities\")\n284|\t\tif err != nil {\n285|\t\t\treturn err\n286|\t\t}\n287|\t\treturn failure\n288|\t}\n289|\tenabled, ok := rawBool(value[\"enabled\"])\n290|\tif !ok {\n291|\t\tfailure, err := failProtocol(\"probe capability enabled is not a boolean\", \"capabilities\")\n292|\t\tif err != nil {\n293|\t\t\treturn err\n294|\t\t}\n295|\t\treturn failure\n296|\t}\n297|\tif evidence, ok := rawString(value[\"evidence\"]); !ok || !isProbeEvidence(evidence) {\n298|\t\tfailure, err := failProtocol(\"probe capability evidence is not a registry member\", \"capabilities\")\n299|\t\tif err != nil {\n300|\t\t\treturn err\n301|\t\t}\n302|\t\treturn failure\n303|\t}\n304|\tif detail, ok := rawString(value[\"detail\"]); !ok || runeLength(detail) > 2048 {\n305|\t\tfailure, err := failProtocol(\"probe capability detail is not 0..2048 characters\", \"capabilities\")\n306|\t\tif err != nil {\n307|\t\t\treturn err\n308|\t\t}\n309|\t\treturn failure\n310|\t}\n311|\tif enabled && status != CapabilityAvailable {\n312|\t\tfailure, err := failProtocol(\"probe capability enables a non-available status\", \"capabilities\")\n313|\t\tif err != nil {\n314|\t\t\treturn err\n315|\t\t}\n316|\t\treturn failure\n317|\t}\n318|\treturn nil\n319|}\n320|\n321|func isProbeStatus(value string) bool {\n322|\tfor _, status := range probeCapabilityStatuses {\n323|\t\tif value == status {\n324|\t\t\treturn true\n325|\t\t}\n326|\t}\n327|\treturn false\n328|}\n329|\n330|func isProbeEvidence(value string) bool {\n331|\tfor _, evidence := range probeCapabilityEvidence {\n332|\t\tif value == evidence {\n333|\t\t\treturn true\n334|\t\t}\n335|\t}\n336|\treturn false\n337|}\n338|\n339|// checkProbeWarnings enforces the sorted, unique, bounded warning\n340|// array: at most 1,024 strings of at most 2,048 characters each.\n341|func checkProbeWarnings(raw json.RawMessage) error {\n342|\twarnings, ok := rawStringArray(raw)\n343|\tif !ok || len(warnings) > 1024 {\n344|\t\tfailure, err := failProtocol(\"probe warnings exceed 1024 entries\", \"warnings\")\n345|\t\tif err != nil {\n346|\t\t\treturn err\n347|\t\t}\n348|\t\treturn failure\n349|\t}\n350|\tfor _, warning := range warnings {\n351|\t\tif runeLength(warning) > 2048 {\n352|\t\t\tfailure, err := failProtocol(\"probe warning exceeds 2048 characters\", \"warnings\")\n353|\t\t\tif err != nil {\n354|\t\t\t\treturn err\n355|\t\t\t}\n356|\t\t\treturn failure\n357|\t\t}\n358|\t}\n359|\tif !sortedUniqueStrings(warnings) {\n360|\t\tfailure, err := failProtocol(\"probe warnings are not sorted unique\", \"warnings\")\n361|\t\tif err != nil {\n362|\t\t\treturn err\n363|\t\t}\n364|\t\treturn failure\n365|\t}\n366|\treturn nil\n367|}\n368|\n369|// CapabilityUsable reports whether the probe establishes the named\n370|// capability as usable: status available and enabled true. It is the\n371|// host-side reading of the Section 8 matrices: conditional,\n372|// unsupported, and unknown are never usable, however enabled reads,\n373|// and unknown MUST NOT be rewritten as unsupported — both refuse the\n374|// same way here, by returning false.\n375|func CapabilityUsable(status string, enabled bool) bool {\n376|\treturn status == CapabilityAvailable && enabled\n377|}\n378|\n379|// RequireCapability decodes one probe body and requires the named\n380|// capability usable. A malformed probe is a provider_protocol_error;\n381|// a well-formed probe that does not establish the capability is an\n382|// invalid_config caller error: the caller asked for a surface the\n383|// probe plane never proved. Either way no plugin process starts for\n384|// the gated operation.\n385|func RequireCapability(probeBody []byte, name string) error {\n386|\t// The probe body is decoded exactly once, here: the members below\n387|\t// are the validated output of decodeValidatedProbe, not a second\n388|\t// decode of the body after a separate DecodeProbe call. The\n389|\t// sub-object replays over members[\"capabilities\"] and\n390|\t// capabilities[name] stay explicit replays — decodeValidatedProbe\n391|\t// just proved them well-formed, so their faults are nil by\n392|\t// construction — but they replay validated members, never the\n393|\t// body, so no validation can drift after the use.\n394|\tmembers, err := decodeValidatedProbe(probeBody)\n395|\tif err != nil {\n396|\t\treturn err\n397|\t}\n398|\tcapabilities, _ := decodeStrictObject(members[\"capabilities\"])\n399|\tknown := false\n400|\tfor _, registry := range capabilityOrder {\n401|\t\tif name == registry {\n402|\t\t\tknown = true\n403|\t\t}\n404|\t}\n405|\tif !known {\n406|\t\tfailure, err := failInvalid(\"capability is not a registry member\")\n407|\t\tif err != nil {\n408|\t\t\treturn err\n409|\t\t}\n410|\t\treturn failure\n411|\t}\n412|\tvalue, _ := decodeStrictObject(capabilities[name])\n413|\tstatus, _ := rawString(value[\"status\"])\n414|\tenabled, _ := rawBool(value[\"enabled\"])\n415|\tif !CapabilityUsable(status, enabled) {\n416|\t\tfailure, err := failInvalid(\"probe does not establish the capability as available\")\n417|\t\tif err != nil {\n418|\t\t\treturn err\n419|\t\t}\n420|\t\treturn failure\n421|\t}\n422|\treturn nil\n423|}","final_result":true}}}
