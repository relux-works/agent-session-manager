{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c543","stream":{"kind":"session","id":"01a076ad-f47f-7ff2-8dce-96e5ca8ed5ea"},"sequence":252,"recorded_at":1780531400000499,"record_type":"event","durability":"durable","causation_id":"45784b6b-7f39-4dd1-b2ef-238367563335","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"45784b6b-7f39-4dd1-b2ef-238367563335","run_stream":{"kind":"run","id":"45784b6b-7f39-4dd1-b2ef-238367563335"},"task_stream":{"kind":"task","id":"18c4b9c2-8200-4171-a036-fccf2c391fd4"},"task_id":"18c4b9c2-8200-4171-a036-fccf2c391fd4","event":{"kind":"output","task_id":"18c4b9c2-8200-4171-a036-fccf2c391fd4","chunk":"{\n  \"chunk_id\": \"exec-14-1\",\n  \"command\": \"task-board worktree --help 2>&1 | head -50\",\n  \"description\": \"Check worktree subcommands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Inspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n\",\n  \"original_output_bytes\": 2056,\n  \"original_output_tokens\": 514,\n  \"truncated\": false\n}"}}}
