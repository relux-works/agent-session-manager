{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5c9","stream":{"kind":"session","id":"01a076ad-f47f-7ff2-8dce-96e5ca8ed5ea"},"sequence":319,"recorded_at":1780531400000633,"record_type":"event","durability":"durable","causation_id":"45784b6b-7f39-4dd1-b2ef-238367563335","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"45784b6b-7f39-4dd1-b2ef-238367563335","run_stream":{"kind":"run","id":"45784b6b-7f39-4dd1-b2ef-238367563335"},"task_stream":{"kind":"task","id":"88414f4c-8afa-47b6-9c21-0b76b27151f4"},"task_id":"88414f4c-8afa-47b6-9c21-0b76b27151f4","event":{"kind":"output","task_id":"88414f4c-8afa-47b6-9c21-0b76b27151f4","chunk":"{\n  \"chunk_id\": \"exec-18-1\",\n  \"command\": \"task-board worktree transaction --help 2>&1 | head -30\",\n  \"description\": \"Check transaction inspect options\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"The operator disposition surface for an integration transaction that reached a\\nterminal phase.\\n\\nIt is the ONLY exit from transition_refused and integration_abandoned, and it is\\nforward-only: no command here undoes a landed commit or rewrites trunk.\\n\\nTwo of the three outcomes cannot be obtained by assertion at all. 'resolve\\n--resolution repaired' re-runs the recovery classifier and decides on that, never\\non the operator's claim; 'discharge' recomputes the transaction's own\\npostcondition. Neither --refusal nor the absent-TASK_BOARD_RUN_ID check\\nauthorizes anything — both are caller-supplied guardrails, exactly like\\ncommit_ack and the transition-lease token.\\n\\nUsage:\\n  task-board worktree transaction [command]\\n\\nAvailable Commands:\\n  discharge   Retire an abandoned transaction whose board state has since reached trunk\\n  resolve     Leave transition_refused, by re-verified repair or by explicit abandonment\\n  show        Print an integration transaction, its refusal and the digest to dispose of it\\n\\nFlags:\\n  -h, --help   help for transaction\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n\",\n  \"original_output_bytes\": 1494,\n  \"original_output_tokens\": 374,\n  \"truncated\": false\n}"}}}
