{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b3","stream":{"kind":"session","id":"01a0761f-a1d7-7f21-bbcd-d353d9bc9dd9"},"sequence":564,"recorded_at":1780531400001123,"record_type":"event","durability":"durable","causation_id":"357b4990-0035-4254-a95a-ceb9ed1d0622","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"357b4990-0035-4254-a95a-ceb9ed1d0622","run_stream":{"kind":"run","id":"357b4990-0035-4254-a95a-ceb9ed1d0622"},"call_id":"call_01a07622acba7a92951975af2c146798","text":"Read text file `internal/environ/census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the shared-implementation census. The story's\n15|// premise is that the Provider, Session Adapter, and Directory\n16|// Node facades sit on one environment library; today each facade\n17|// carries its own copy of the shared rules, and independent\n18|// copies of the same rule drift in ways no per-facade reviewer\n19|// can see. This census is the boundary that fails when the\n20|// facades diverge: it derives every shared-rule implementation\n21|// from production source and requires the derived set to equal\n22|// the ledger below exactly.\n23|//\n24|// A new copy of a shared rule — a fourth facade\n25|// decodeStrictObject, a third surrogate-gate spelling, a new\n26|// string-measure helper — fails here as an unregistered site.\n27|// Removing or renaming a ledgered implementation orphans its row\n28|// and fails too. An empty scan fails closed. The ledger records\n29|// the single canonical owner per rule (this package, or scalar\n30|// where the grammar already has one) plus the copies this leaf\n31|// may not edit; each copy names the battery file that pins it to\n32|// the canonical semantics, and the escaped-backslash ledger in\n33|// the frame battery proves the battery observes facade\n34|// differences rather than asserting them away.\n35|//\n36|// Scope. The scan covers the story packages (environ, provider,\n37|// provhost, sessadapter, dirnode) plus the grammar owners\n38|// (scalar, canonicaljson). Copies in config, cliresult,\n39|// terminalbackend, axerror, and the other stories' packages are\n40|// outside this story's ownership: each package derives its own\n41|// inventories in its own test files, and gating another story's\n42|// package from here would couple stories that must land\n43|// independently. That exclusion is a stated bound, not a blind\n44|// spot: the scan fails closed inside its scope, and a copy that\n45|// moves into scope (a new definition in a scanned package)\n46|// fails as unregistered.\n47|\n48|// sharedSite is one derived shared-rule implementation.\n49|type sharedSite struct {\n50|\tclass  string\n51|\tpkg    string\n52|\tfile   string\n53|\tsymbol string\n54|}\n55|\n56|// sharedSiteKey renders the ledger key for one site.\n57|func (site sharedSite) sharedSiteKey() string {\n58|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n59|}\n60|\n61|// censusPackages is the exact scan scope. A production file in\n62|// any other package is outside this story's jurisdiction.\n63|var censusPackages = map[string]bool{\n64|\t\"environ\":       true,\n65|\t\"provider\":      true,\n66|\t\"provhost\":      true,\n67|\t\"sessadapter\":   true,\n68|\t\"dirnode\":       true,\n69|\t\"scalar\":        true,\n70|\t\"canonicaljson\": true,\n71|}\n72|\n73|// sharedLedger maps every known shared-rule implementation to\n74|// the rationale that keeps it honest. Canonical owners are the\n75|// single implementation new code must use; every other row names\n76|// the battery file that pins the copy to the canonical\n77|// semantics.\n78|var sharedLedger = map[string]string{\n79|\t// Frame decoders: one JSON entry point per package.\n80|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":     \"canonical owner: string-walk surrogate semantics, rune measure\",\n81|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\":  \"pinned by frame_agreement_test.go\",\n82|\t\"strict-decoder|sessadapter|decode.go|decodeStrictObject\": \"byte-frozen leaf 1: pinned by frame_agreement_test.go\",\n83|\t\"strict-decoder|dirnode|decode.go|decodeStrictObject\":     \"byte-frozen leaf 2: pinned by frame_agreement_test.go\",\n84|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\":  \"canonicalizer entry: distinct JCS pipeline role, surrogate verdicts pinned by frame_agreement_test.go\",\n85|\t// Lone-surrogate gates.\n86|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n87|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n88|\t\"surrogate-gate|sessadapter|decode.go|hasLoneSurrogateEscape\":        \"byte-frozen leaf 1: raw scan, escaped-backslash divergence ledgered in frame_agreement_test.go\",\n89|\t\"surrogate-gate|dirnode|decode.go|hasLoneSurrogateEscape\":            \"byte-frozen leaf 2: raw scan, escaped-backslash divergence ledgered in frame_agreement_test.go\",\n90|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n91|\t// String measures.\n92|\t\"string-measure|environ|decode.go|StringLength\":     \"canonical owner: runes per Section 1.6\",\n93|\t\"string-measure|provhost|opdecode.go|runeLength\":    \"runes, pinned by measure_agreement_test.go\",\n94|\t\"string-measure|sessadapter|decode.go|stringLength\": \"byte-frozen leaf 1: runes, pinned by measure_agreement_test.go\",\n95|\t\"string-measure|dirnode|decode.go|stringLength\":     \"byte-frozen leaf 2: runes, pinned by measure_agreement_test.go\",\n96|\t// Identity validators: two refusal dialects over one rule.\n97|\t\"identity-validator|provhost|identity.go|CheckIdentity\":                           \"provider-stdio refusal dialect, pinned by identity_agreement_test.go\",\n98|\t\"identity-validator|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"identity refusal dialect, pinned by identity_agreement_test.go\",\n99|}\n100|\n101|// sharedFunctionSymbols maps a function name to its census\n102|// class.\n103|var sharedFunctionSymbols = map[string]string{\n104|\t\"decodeStrictObject\":             \"strict-decoder\",\n105|\t\"DecodeStrictObject\":             \"strict-decoder\",\n106|\t\"decodeStrict\":                   \"strict-decoder\",\n107|\t\"hasLoneSurrogateEscape\":         \"surrogate-gate\",\n108|\t\"HasLoneSurrogateEscape\":         \"surrogate-gate\",\n109|\t\"validateSurrogateEscapes\":       \"surrogate-gate\",\n110|\t\"stringLength\":                   \"string-measure\",\n111|\t\"runeLength\":                     \"string-measure\",\n112|\t\"StringLength\":                   \"string-measure\",\n113|\t\"CheckIdentity\":                  \"identity-validator\",\n114|\t\"validateProviderIdentityRecord\": \"identity-validator\",\n115|}\n116|\n117|// grammarSymbols maps a package-level variable name to its\n118|// grammar class. Only same-rule grammars share a class: the\n119|// three capabilityOrder tables (directory eight, adapter\n120|// fifteen, provider seven) and the per-major platform tables are\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
