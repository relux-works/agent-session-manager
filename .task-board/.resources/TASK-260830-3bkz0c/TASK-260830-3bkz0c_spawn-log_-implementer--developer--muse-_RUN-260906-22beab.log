{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c5","stream":{"kind":"session","id":"01a0761f-a1d7-7f21-bbcd-d353d9bc9dd9"},"sequence":445,"recorded_at":1780531400000885,"record_type":"event","durability":"durable","causation_id":"357b4990-0035-4254-a95a-ceb9ed1d0622","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"357b4990-0035-4254-a95a-ceb9ed1d0622","run_stream":{"kind":"run","id":"357b4990-0035-4254-a95a-ceb9ed1d0622"},"task_stream":{"kind":"task","id":"eb717055-76af-4164-ba99-816709d57ecc"},"task_id":"eb717055-76af-4164-ba99-816709d57ecc","event":{"kind":"output","task_id":"eb717055-76af-4164-ba99-816709d57ecc","chunk":"{\n  \"chunk_id\": \"exec-21-1\",\n  \"command\": \"for o in 9b3f568b7db98c307ce1cd449d55d175dea0b207 292bc4242de751821d59ee1e3e68c9f1670b4634 afdba1dd35c7c8f09d8d943ed15c217fe69dabfb; do echo -n \\\"$o: \\\"; git cat-file -t $o 2>&1; done; echo \\\"===\\\"; git rev-parse HEAD HEAD^{tree} 2>&1; echo \\\"===\\\"; task-board worktree --help 2>&1 | head -n 30\",\n  \"description\": \"Identify mismatched tree objects\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"-n 9b3f568b7db98c307ce1cd449d55d175dea0b207: \\ntree\\n-n 292bc4242de751821d59ee1e3e68c9f1670b4634: \\ntree\\n-n afdba1dd35c7c8f09d8d943ed15c217fe69dabfb: \\ncommit\\n===\\nafdba1dd35c7c8f09d8d943ed15c217fe69dabfb\\n9b3f568b7db98c307ce1cd449d55d175dea0b207\\n===\\nInspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n\",\n  \"original_output_bytes\": 1847,\n  \"original_output_tokens\": 462,\n  \"truncated\": false\n}"}}}
