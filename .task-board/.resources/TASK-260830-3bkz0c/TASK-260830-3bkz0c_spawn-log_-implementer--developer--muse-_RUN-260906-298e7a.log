{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f5","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":469,"recorded_at":1780531400000933,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"task_stream":{"kind":"task","id":"9a3ee76a-7ef0-4c6d-ad9b-1c4527aee995"},"task_id":"9a3ee76a-7ef0-4c6d-ad9b-1c4527aee995","event":{"kind":"output","task_id":"9a3ee76a-7ef0-4c6d-ad9b-1c4527aee995","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/tuple_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n14|)\n15|\n16|// This file is the Environment Tuple agreement battery. The\n17|// tuple is the one type every state-bearing adapter call\n18|// carries, and its admission model is shared with the Section\n19|// 10.8.1 observation rather than restated there. The battery\n20|// proves sessadapter.DecodeTuple and environ.DecodeTuple agree\n21|// verdict-for-verdict over a corpus that mutates each member\n22|// alone, and proves the two member tables are literally one\n23|// table: the required lists are derived from both productions\n24|// and required equal in order as well as content, because\n25|// missing-member determinism (which member is named when several\n26|// are absent) is itself shared behavior.\n27|\n28|// deriveRequiredList derives the string list behind a\n29|// package-level []string variable in one production file. The\n30|// comparison travels with the derivation: a reordered,\n31|// extended, or shortened table fails here, not silently.\n32|func deriveRequiredList(t *testing.T, pkg, file, symbol string) []string {\n33|\tt.Helper()\n34|\tpath := filepath.Join(mustInternalRoot(t), pkg, file)\n35|\tsource, err := os.ReadFile(path)\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"members: %v\", err)\n38|\t}\n39|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"members: %v\", err)\n42|\t}\n43|\tfor _, decl := range syntax.Decls {\n44|\t\tnode, ok := decl.(*ast.GenDecl)\n45|\t\tif !ok {\n46|\t\t\tcontinue\n47|\t\t}\n48|\t\tfor _, spec := range node.Specs {\n49|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n50|\t\t\tif !ok || len(value.Names) != 1 || value.Names[0].Name != symbol {\n51|\t\t\t\tcontinue\n52|\t\t\t}\n53|\t\t\tif len(value.Values) != 1 {\n54|\t\t\t\tt.Fatalf(\"members: %s %s is not a single literal; the extractor cannot see through indirection\", path, symbol)\n55|\t\t\t}\n56|\t\t\tcomposite, ok := value.Values[0].(*ast.CompositeLit)\n57|\t\t\tif !ok {\n58|\t\t\t\tt.Fatalf(\"members: %s %s is not a composite literal; the extractor cannot see through indirection\", path, symbol)\n59|\t\t\t}\n60|\t\t\tvar members []string\n61|\t\t\tfor _, element := range composite.Elts {\n62|\t\t\t\tliteral, ok := element.(*ast.BasicLit)\n63|\t\t\t\tif !ok {\n64|\t\t\t\t\tt.Fatalf(\"members: %s %s holds a non-literal; the extractor cannot see through indirection\", path, symbol)\n65|\t\t\t\t}\n66|\t\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n67|\t\t\t}\n68|\t\t\treturn members\n69|\t\t}\n70|\t}\n71|\tt.Fatalf(\"members: %s %s not found; the extractor is blind, not the table absent\", path, symbol)\n72|\treturn nil\n73|}\n74|\n75|func mustInternalRoot(t *testing.T) string {\n76|\tt.Helper()\n77|\troot, err := internalRoot(t)\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"members: %v\", err)\n80|\t}\n81|\treturn root\n82|}\n83|\n84|// TestTupleMemberTablesAreOneTable requires the environ and\n85|// sessadapter required-member tables to be literally equal:\n86|// same members, same order. A seventh member admitted on one\n87|// side, or a renamed member, reddens here before any vector\n88|// runs.\n89|func TestTupleMemberTablesAreOneTable(t *testing.T) {\n90|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleRequired\")\n91|\ttheirs := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleRequired\")\n92|\tif !reflect.DeepEqual(mine, theirs) {\n93|\t\tt.Fatalf(\"tuple required tables differ:\\nenviron:     %q\\nsessadapter: %q\", mine, theirs)\n94|\t}\n95|\tif len(mine) != 6 {\n96|\t\tt.Fatalf(\"tuple required table has %d members, want the exact six\", len(mine))\n97|\t}\n98|}\n99|\n100|// tupleRow is one agreement vector: the body and the rule phrase\n101|// both refusals must carry. An empty phrase means both entries\n102|// accept.\n103|type tupleRow struct {\n104|\tname string\n105|\tbody []byte\n106|\ttext string\n107|}\n108|\n109|// tupleCorpus mutates each tuple member alone against an\n110|// otherwise-valid body, plus the executable-provenance,\n111|// extensions, and vocabulary edges.\n112|func tupleCorpus(t *testing.T) []tupleRow {\n113|\tt.Helper()\n114|\tvalid := validTupleJSON()\n115|\tdrop := func(member string) []byte { return dropMember(t, []byte(valid), member) }\n116|\tset := func(member, literal string) []byte { return mutateMember(t, []byte(valid), member, literal) }\n117|\treturn []tupleRow{\n118|\t\t{\"valid\", []byte(valid), \"\"},\n119|\t\t{\"missing environment_id\", drop(\"environment_id\"), \"misses a required member\"},\n120|\t\t{\"missing environment_version\", drop(\"environment_version\"), \"misses a required member\"},\n121|\t\t{\"missing platform\", drop(\"platform\"), \"misses a required member\"},\n122|\t\t{\"missing architecture\", drop(\"architecture\"), \"misses a required member\"},\n123|\t\t{\"missing store_schema_fingerprint\", drop(\"store_schema_fingerprint\"), \"misses a required member\"},\n124|\t\t{\"missing adapter_version\", drop(\"adapter_version\"), \"misses a required member\"},\n125|\t\t{\"unknown member\", set(\"adapter_version\", `\"1.2.3\"`), \"\"}, // placeholder, replaced below\n126|\t\t{\"extensions refused\", appendMember(t, []byte(valid), \"extensions\", `{}`), \"unknown member\"},\n127|\t\t{\"executable provenance refused\", appendMember(t, []byte(valid), \"executable_sha256\", jsonQuote(fixtureExecutable)), \"unknown member\"},\n128|\t\t{\"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n129|\t\t{\"empty environment id\", set(\"environment_id\", `\"\"`), \"environment-id\"},\n130|\t\t{\"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n131|\t\t{\"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n132|\t\t{\"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n133|\t\t{\"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n134|\t\t{\"uppercase refused\", set(\"platform\", `\"LINUX\"`), \"platform\"},\n135|\t\t{\"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n136|\t\t{\"arm64 admits\", set(\"architecture\", `\"arm64\"`), \"\"},\n137|\t\t{\"bad fingerprint\", set(\"store_schema_fingerprint\", `\"sha256:zzzz\"`), \"digest\"},\n138|\t\t{\"short version\", set(\"adapter_version\", `\"1.2\"`), \"SemVer\"},\n139|\t\t{\"prerelease admits\", set(\"adapter_version\", `\"1.2.3-rc.1\"`), \"\"},\n140|\t}\n141|}\n142|\n143|// TestTupleAgreementAcrossFacades drives the corpus through both\n144|// tuple entries and requires identical verdicts with the full\n145|// rule rendering on each side.\n146|func TestTupleAgreementAcrossFacades(t *testing.T) {\n147|\trows := tupleCorpus(t)\n148|\t// The unknown-member row needs a genuinely unknown member,\n149|\t// not a replaced known one.\n150|\tfor index, row := range rows {\n151|\t\tif row.name == \"unknown member\" {\n152|\t\t\trows[index].body = appendMember(t, []byte(validTupleJSON()), \"score\", `1`)\n153|\t\t\trows[index].text = \"unknown member\"\n154|\t\t}\n155|\t}\n156|\tfor _, row := range rows {\n157|\t\tt.Run(row.name, func(t *testing.T) {\n158|\t\t\tmine, mineErr := DecodeTuple(row.body)\n159|\t\t\ttheirs, theirsErr := sessadapter.DecodeTuple(row.body)\n160|\t\t\tif row.text == \"\" {\n161|\t\t\t\tif mineErr != nil {\n162|\t\t\t\t\tt.Fatalf(\"environ refused %s: %v\", row.body, mineErr)\n163|\t\t\t\t}\n164|\t\t\t\tif theirsErr != nil {\n165|\t\t\t\t\tt.Fatalf(\"sessadapter refused %s: %v\", row.body, theirsErr)\n166|\t\t\t\t}\n167|\t\t\t\tif mine.EnvironmentID != theirs.EnvironmentID || mine.Version != theirs.Version ||\n168|\t\t\t\t\tmine.Platform != theirs.Platform || mine.Architecture != theirs.Architecture ||\n169|\t\t\t\t\tmine.StoreFingerprint != theirs.StoreFingerprint || mine.AdapterVersion != theirs.AdapterVersion {\n170|\t\t\t\t\tt.Fatalf(\"decoded tuples differ: %+v vs %+v\", mine, theirs)\n171|\t\t\t\t}\n172|\t\t\t\treturn\n173|\t\t\t}\n174|\t\t\tif mineErr == nil {\n175|\t\t\t\tt.Fatalf(\"environ admitted %s, want rule %q\", row.body, row.text)\n176|\t\t\t}\n177|\t\t\tif theirsErr == nil {\n178|\t\t\t\tt.Fatalf(\"sessadapter admitted %s, want rule %q\", row.body, row.text)\n179|\t\t\t}\n180|\t\t\tif !strings.Contains(mineErr.Error(), row.text) {\n181|\t\t\t\tt.Fatalf(\"environ error = %v, want rule %q\", mineErr, row.text)\n182|\t\t\t}\n183|\t\t\tif !strings.Contains(theirsErr.Error(), row.text) {\n184|\t\t\t\tt.Fatalf(\"sessadapter error = %v, want rule %q\", theirsErr, row.text)\n185|\t\t\t}\n186|\t\t})\n187|\t}\n188|}\n189|\n190|// appendMember returns the object with one added top-level\n191|// member. Every other member holds a valid value, so the added\n192|// member alone decides the verdict.\n193|func appendMember(t *testing.T, body []byte, member, literal string) []byte {\n194|\tt.Helper()\n195|\tmembers := decodeTestMembers(t, body)\n196|\tif _, present := members[member]; present {\n197|\t\tt.Fatalf(\"appendMember: %q already present\", member)\n198|\t}\n199|\tmembers[member] = literal\n200|\treturn encodeTestMembers(t, members)\n201|}"}}}
