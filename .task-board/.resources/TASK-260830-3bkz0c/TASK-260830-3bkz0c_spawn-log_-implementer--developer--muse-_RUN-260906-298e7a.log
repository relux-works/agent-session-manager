{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6fd","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":473,"recorded_at":1780531400000941,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"call_id":"call_01a0764ff7d079a0a3fc057d2b734b7a","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/tuple_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n14|)\n15|\n16|// This file is the Environment Tuple agreement battery. The\n17|// tuple is the one type every state-bearing adapter call\n18|// carries, and its admission model is shared with the Section\n19|// 10.8.1 observation rather than restated there. The battery\n20|// proves sessadapter.DecodeTuple and environ.DecodeTuple agree\n21|// verdict-for-verdict over a corpus that mutates each member\n22|// alone, and proves the two member tables are literally one\n23|// table: the required lists are derived from both productions\n24|// and required equal in order as well as content, because\n25|// missing-member determinism (which member is named when several\n26|// are absent) is itself shared behavior.\n27|\n28|// deriveRequiredList derives the string list behind a\n29|// package-level []string variable in one production file. The\n30|// comparison travels with the derivation: a reordered,\n31|// extended, or shortened table fails here, not silently.\n32|func deriveRequiredList(t *testing.T, pkg, file, symbol string) []string {\n33|\tt.Helper()\n34|\tpath := filepath.Join(mustInternalRoot(t), pkg, file)\n35|\tsource, err := os.ReadFile(path)\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"members: %v\", err)\n38|\t}\n39|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"members: %v\", err)\n42|\t}\n43|\tfor _, decl := range syntax.Decls {\n44|\t\tnode, ok := decl.(*ast.GenDecl)\n45|\t\tif !ok {\n46|\t\t\tcontinue\n47|\t\t}\n48|\t\tfor _, spec := range node.Specs {\n49|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n50|\t\t\tif !ok || len(value.Names) != 1 || value.Names[0].Name != symbol {\n51|\t\t\t\tcontinue\n52|\t\t\t}\n53|\t\t\tif len(value.Values) != 1 {\n54|\t\t\t\tt.Fatalf(\"members: %s %s is not a single literal; the extractor cannot see through indirection\", path, symbol)\n55|\t\t\t}\n56|\t\t\tcomposite, ok := value.Values[0].(*ast.CompositeLit)\n57|\t\t\tif !ok {\n58|\t\t\t\tt.Fatalf(\"members: %s %s is not a composite literal; the extractor cannot see through indirection\", path, symbol)\n59|\t\t\t}\n60|\t\t\tvar members []string\n61|\t\t\tfor _, element := range composite.Elts {\n62|\t\t\t\tliteral, ok := element.(*ast.BasicLit)\n63|\t\t\t\tif !ok {\n64|\t\t\t\t\tt.Fatalf(\"members: %s %s holds a non-literal; the extractor cannot see through indirection\", path, symbol)\n65|\t\t\t\t}\n66|\t\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n67|\t\t\t}\n68|\t\t\treturn members\n69|\t\t}\n70|\t}\n71|\tt.Fatalf(\"members: %s %s not found; the extractor is blind, not the table absent\", path, symbol)\n72|\treturn nil\n73|}\n74|\n75|func mustInternalRoot(t *testing.T) string {\n76|\tt.Helper()\n77|\troot, err := internalRoot(t)\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"members: %v\", err)\n80|\t}\n81|\treturn root\n82|}\n83|\n84|// TestTupleMemberTablesAreOneTable requires the environ and\n85|// sessadapter required-member tables to be literally equal:\n86|// same members, same order. A seventh member admitted on one\n87|// side, or a renamed member, reddens here before any vector\n88|// runs.\n89|func TestTupleMemberTablesAreOneTable(t *testing.T) {\n90|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleRequired\")\n91|\ttheirs := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleRequired\")\n92|\tif !reflect.DeepEqual(mine, theirs) {\n93|\t\tt.Fatalf(\"tuple required tables differ:\\nenviron:     %q\\nsessadapter: %q\", mine, theirs)\n94|\t}\n95|\tif len(mine) != 6 {\n96|\t\tt.Fatalf(\"tuple required table has %d members, want the exact six\", len(mine))\n97|\t}\n98|}\n99|\n100|// tupleRow is one agreement vector: the body and the rule phrase\n101|// both refusals must carry. An empty phrase means both entries\n102|// accept.\n103|type tupleRow struct {\n104|\tname string\n105|\tbody []byte\n106|\ttext string\n107|}\n108|\n109|// tupleCorpus mutates each tuple member alone against an\n110|// otherwise-valid body, plus the executable-provenance,\n111|// extensions, and vocabulary edges.\n112|func tupleCorpus(t *testing.T) []tupleRow {\n113|\tt.Helper()\n114|\tvalid := validTupleJSON()\n115|\tdrop := func(member string) []byte { return dropMember(t, []byte(valid), member) }\n116|\tset := func(member, literal string) []byte { return mutateMember(t, []byte(valid), member, literal) }\n117|\treturn []tupleRow{\n118|\t\t{\"valid\", []byte(valid), \"\"},\n119|\t\t{\"missing environment_id\", drop(\"environment_id\"), \"misses a required member\"},\n120|\t\t{\"missing environment_version\", drop(\"environment_version\"), \"misses a required member\"},\n121|\t\t{\"missing platform\", drop(\"platform\"), \"misses a required member\"},\n122|\t\t{\"missing architecture\", drop(\"architecture\"), \"misses a required member\"},\n123|\t\t{\"missing store_schema_fingerprint\", drop(\"store_schema_fingerprint\"), \"misses a required member\"},\n124|\t\t{\"missing adapter_version\", drop(\"adapter_version\"), \"misses a required member\"},\n125|\t\t{\"unknown member\", set(\"adapter_version\", `\"1.2.3\"`), \"\"}, // placeholder, replaced below\n126|\t\t{\"extensions refused\", appendMember(t, []byte(valid), \"extensions\", `{}`), \"unknown member\"},\n127|\t\t{\"executable provenance refused\", appendMember(t, []byte(valid), \"executable_sha256\", jsonQuote(fixtureExecutable)), \"unknown member\"},\n128|\t\t{\"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n129|\t\t{\"empty environment id\", set(\"environment_id\", `\"\"`), \"environment-id\"},\n130|\t\t{\"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n131|\t\t{\"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n132|\t\t{\"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n133|\t\t{\"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n134|\t\t{\"uppercase refused\", set(\"platform\", `\"LINUX\"`), \"platform\"},\n135|\t\t{\"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n136|\t\t{\"arm64 admits\", set(\"architecture\", `\"arm64\"`), \"\"},\n137|\t\t{\"bad fingerprint\", set(\"store_schema_fingerprint\", `\"sha256:zzzz\"`), \"digest\"},\n138|\t\t{\"short version\", set(\"adapter_version\", `\"1.2\"`), \"SemVer\"},\n139|\t\t{\"prerelease admits\", set(\"adapter_version\", `\"1.2.3-rc.1\"`), \"\"},\n140|\t}\n141|}\n142|\n143|// TestTupleAgreementAcrossFacades drives the corpus through both\n144|// tuple entries and requires identical verdicts with the full\n145|// rule rendering on each side.\n146|func TestTupleAgreementAcrossFacades(t *testing.T) {\n147|\trows := tupleCorpus(t)\n148|\t// The unknown-member row needs a genuinely unknown member,\n149|\t// not a replaced known one.\n150|\tfor index, row := range rows {\n151|\t\tif row.name == \"unknown member\" {\n152|\t\t\trows[index].body = appendMember(t, []byte(validTupleJSON()), \"score\", `1`)\n153|\t\t\trows[index].text = \"unknown member\"\n154|\t\t}\n155|\t}\n156|\tfor _, row := range rows {\n157|\t\tt.Run(row.name, func(t *testing.T) {\n158|\t\t\tmine, mineErr := DecodeTuple(row.body)\n159|\t\t\ttheirs, theirsErr := sessadapter.DecodeTuple(row.body)\n160|\t\t\tif row.text == \"\" {\n161|\t\t\t\tif mineErr != nil {\n162|\t\t\t\t\tt.Fatalf(\"environ refused %s: %v\", row.body, mineErr)\n163|\t\t\t\t}\n164|\t\t\t\tif theirsErr != nil {\n165|\t\t\t\t\tt.Fatalf(\"sessadapter refused %s: %v\", row.body, theirsErr)\n166|\t\t\t\t}\n167|\t\t\t\tif mine.EnvironmentID != theirs.EnvironmentID || mine.Version != theirs.Version ||\n168|\t\t\t\t\tmine.Platform != theirs.Platform || mine.Architecture != theirs.Architecture ||\n169|\t\t\t\t\tmine.StoreFingerprint != theirs.StoreFingerprint || mine.AdapterVersion != theirs.AdapterVersion {\n170|\t\t\t\t\tt.Fatalf(\"decoded tuples differ: %+v vs %+v\", mine, theirs)\n171|\t\t\t\t}\n172|\t\t\t\treturn\n173|\t\t\t}\n174|\t\t\tif mineErr == nil {\n175|\t\t\t\tt.Fatalf(\"environ admitted %s, want rule %q\", row.body, row.text)\n176|\t\t\t}\n177|\t\t\tif theirsErr == nil {\n178|\t\t\t\tt.Fatalf(\"sessadapter admitted %s, want rule %q\", row.body, row.text)\n179|\t\t\t}\n180|\t\t\tif !strings.Contains(mineErr.Error(), row.text) {\n181|\t\t\t\tt.Fatalf(\"environ error = %v, want rule %q\", mineErr, row.text)\n182|\t\t\t}\n183|\t\t\tif !strings.Contains(theirsErr.Error(), row.text) {\n184|\t\t\t\tt.Fatalf(\"sessadapter error = %v, want rule %q\", theirsErr, row.text)\n185|\t\t\t}\n186|\t\t})\n187|\t}\n188|}\n189|\n190|// appendMember returns the object with one added top-level\n191|// member. Every other member holds a valid value, so the added\n192|// member alone decides the verdict.\n193|func appendMember(t *testing.T, body []byte, member, literal string) []byte {\n194|\tt.Helper()\n195|\tmembers := decodeTestMembers(t, body)\n196|\tif _, present := members[member]; present {\n197|\t\tt.Fatalf(\"appendMember: %q already present\", member)\n198|\t}\n199|\tmembers[member] = literal\n200|\treturn encodeTestMembers(t, members)\n201|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ff","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":474,"recorded_at":1780531400000943,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"call_id":"call_01a0764ff8a57ee182b368d8fff43075","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/observation_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file batteries the Section 10.8.1 Environment\n13|// Observation gate. No facade validates observation content\n14|// today — dirnode crosses observations as presence and object\n15|// shape only, explicitly deferring content to this leaf — so\n16|// these rows prove new behavior, not agreement. The roster is\n17|// still derived and fail-closed: the required-member list comes\n18|// from environ production, every required member owns at least\n19|// one refusal row, and a row naming a member production no\n20|// longer requires fails as orphaned.\n21|//\n22|// Conjoined rules count twice throughout: sorted-unique evidence\n23|// owns an unsorted-but-unique row AND a sorted-but-duplicated\n24|// row, and reason coherence owns an available-with-reason row\n25|// AND a conditional-without-reason row, so a check enforcing\n26|// only one half cannot pass both.\n27|\n28|// observationRow is one battery vector: the required member it\n29|// violates (\"\" for vocabulary and structural rules), the body,\n30|// and the rule phrase the refusal must carry. An empty phrase\n31|// means the entry accepts and the decoded value is asserted.\n32|type observationRow struct {\n33|\tmember string\n34|\tname   string\n35|\tbody   []byte\n36|\ttext   string\n37|}\n38|\n39|// capabilityValueJSON builds one CapabilityResult with the given\n40|// status, reason literal (already JSON), and evidence literal.\n41|func capabilityValueJSON(status, reason, evidence string) string {\n42|\treturn `{\"status\":` + jsonQuote(status) + `,\"reason_code\":` + reason + `,\"evidence_ids\":` + evidence + `,\"observed_at\":` + jsonQuote(fixtureObservedAt) + `,\"extensions\":{}}`\n43|}\n44|\n45|// observationCorpus mutates each observation member alone\n46|// against an otherwise-valid body.\n47|func observationCorpus(t *testing.T) []observationRow {\n48|\tt.Helper()\n49|\tvalid := validObservationJSON()\n50|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n51|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n52|\tevidencePair := sortedDigests(fixtureEvidenceID, fixtureExecutable)\n53|\tunsortedEvidence := `[\"` + evidencePair[1] + `\",\"` + evidencePair[0] + `\"]`\n54|\tduplicatedEvidence := `[\"` + evidencePair[0] + `\",\"` + evidencePair[0] + `\"]`\n55|\tcapWith := func(status, reason, evidence string) []byte {\n56|\t\tcapabilities := strings.Replace(validCapabilitiesJSON(), availableCapabilityJSON(), capabilityValueJSON(status, reason, evidence), 1)\n57|\t\treturn mutateMember(t, valid, \"capabilities\", capabilities)\n58|\t}\n59|\tsevenCaps := sevenCapabilitiesJSON(t)\n60|\treturn []observationRow{\n61|\t\t{\"\", \"valid\", valid, \"\"},\n62|\t\t{\"schema\", \"missing schema\", drop(\"schema\"), \"misses a required member\"},\n63|\t\t{\"schema\", \"wrong schema\", set(\"schema\", `\"urn:ax:schema:session-adapter-manifest\"`), \"not the environment observation\"},\n64|\t\t{\"schema_version\", \"wrong version\", set(\"schema_version\", `\"2.0.0\"`), \"not 1.0.0\"},\n65|\t\t{\"observation_id\", \"bad observation digest\", set(\"observation_id\", `\"sha256:zzzz\"`), \"not a digest\"},\n66|\t\t{\"host_id\", \"bad host uuid\", set(\"host_id\", `\"not-a-uuid\"`), \"not a UUIDv7\"},\n67|\t\t{\"installation_id\", \"bad installation digest\", set(\"installation_id\", `\"42\"`), \"not a digest\"},\n68|\t\t{\"environment_id\", \"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n69|\t\t{\"environment_id\", \"missing environment id\", drop(\"environment_id\"), \"misses a required member\"},\n70|\t\t{\"environment_version\", \"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n71|\t\t{\"environment_version\", \"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n72|\t\t{\"provider_id\", \"uppercase provider\", set(\"provider_id\", `\"Test-Provider\"`), \"provider-id\"},\n73|\t\t{\"platform\", \"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n74|\t\t{\"platform\", \"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n75|\t\t{\"architecture\", \"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n76|\t\t{\"backend_realm_fingerprint\", \"bad realm digest\", set(\"backend_realm_fingerprint\", `\"null\"`), \"not a digest\"},\n77|\t\t{\"capabilities\", \"seven capabilities refused\", set(\"capabilities\", sevenCaps), \"exact eight-name\"},\n78|\t\t{\"capabilities\", \"ninth capability refused\", set(\"capabilities\", nineCapabilitiesJSON(t)), \"exact eight-name\"},\n79|\t\t{\"capabilities\", \"ninth capability refused\", appendMember(t, valid, \"capabilities-extra\", `{}`), \"unknown member\"},\n80|\t\t{\"capabilities\", \"unknown capability key\", set(\"capabilities\", unknownCapabilityJSON(t)), \"exact eight-name\"},\n81|\t\t{\"capabilities\", \"bad status refused\", capWith(\"ready\", `null`, `[]`), \"exact eight-name\"},\n82|\t\t{\"capabilities\", \"available with reason refused\", capWith(\"available\", jsonQuote(\"why\"), `[]`), \"exact eight-name\"},\n83|\t\t{\"capabilities\", \"conditional without reason refused\", capWith(\"conditional\", `null`, `[]`), \"exact eight-name\"},\n84|\t\t{\"capabilities\", \"conditional with reason admits\", capWith(\"conditional\", jsonQuote(\"why\"), `[]`), \"\"},\n85|\t\t{\"capabilities\", \"unsorted evidence refused\", capWith(\"available\", `null`, unsortedEvidence), \"exact eight-name\"},\n86|\t\t{\"capabilities\", \"duplicated evidence refused\", capWith(\"available\", `null`, duplicatedEvidence), \"exact eight-name\"},\n87|\t\t{\"capabilities\", \"bad evidence digest refused\", capWith(\"available\", `null`, `[\"sha256:zzzz\"]`), \"exact eight-name\"},\n88|\t\t{\"authentication_status\", \"bad auth status\", set(\"authentication_status\", `\"signed-in\"`), \"authentication status\"},\n89|\t\t{\"runtime_status\", \"bad runtime status\", set(\"runtime_status\", `\"sleeping\"`), \"runtime status\"},\n90|\t\t{\"observed_at\", \"bad timestamp\", set(\"observed_at\", `\"yesterday\"`), \"not a timestamp\"},\n91|\t\t{\"observed_at\", \"missing timestamp\", drop(\"observed_at\"), \"misses a required member\"},\n92|\t\t{\"extensions\", \"bad extensions key\", set(\"extensions\", `{\"nodots\":1}`), \"reverse-DNS\"},\n93|\t\t{\"\", \"unknown top member\", appendMember(t, valid, \"score\", `1`), \"unknown member\"},\n94|\t}\n95|}\n96|\n97|// sortedDigests returns two distinct fixture digests in JCS\n98|// (lexicographic) order.\n99|func sortedDigests(first, second string) []string {\n100|\tpair := []string{first, second}\n101|\tsort.Strings(pair)\n102|\tif pair[0] == pair[1] {\n103|\t\tpanic(\"sortedDigests: fixtures collide\")\n104|\t}\n105|\treturn pair\n106|}\n107|\n108|// sevenCapabilitiesJSON returns the capability map without its\n109|// first registry name.\n110|func sevenCapabilitiesJSON(t *testing.T) string {\n111|\tt.Helper()\n112|\tfull := validCapabilitiesJSON()\n113|\twithout := strings.Replace(full, `\"directory_discovery\":`+availableCapabilityJSON()+`,`, \"\", 1)\n114|\tif without == full {\n115|\t\tt.Fatal(\"sevenCapabilitiesJSON: anchor not found\")\n116|\t}\n117|\treturn without\n118|}\n119|\n120|// nineCapabilitiesJSON returns the capability map with a ninth\n121|// valid-valued key: the length arm, distinct from the unknown-key\n122|// arm the swap below exercises.\n123|func nineCapabilitiesJSON(t *testing.T) string {\n124|\tt.Helper()\n125|\tfull := validCapabilitiesJSON()\n126|\tnine := strings.Replace(full, `\"native_resume\":`, `\"extra_surface\":`+availableCapabilityJSON()+`,\"native_resume\":`, 1)\n127|\tif nine == full {\n128|\t\tt.Fatal(\"nineCapabilitiesJSON: anchor not found\")\n129|\t}\n130|\treturn nine\n131|}\n132|\n133|// unknownCapabilityJSON returns the eight-name map with one key\n134|// swapped for an unregistered name.\n135|func unknownCapabilityJSON(t *testing.T) string {\n136|\tt.Helper()\n137|\tfull := validCapabilitiesJSON()\n138|\tswapped := strings.Replace(full, `\"directory_discovery\"`, `\"directory_exploration\"`, 1)\n139|\tif swapped == full {\n140|\t\tt.Fatal(\"unknownCapabilityJSON: anchor not found\")\n141|\t}\n142|\treturn swapped\n143|}\n144|\n145|// TestObservationRosterIsClosed requires every derived required\n146|// member to own at least one row, and every row to name a\n147|// derived member (or \"\" for vocabulary and structural rules).\n148|func TestObservationRosterIsClosed(t *testing.T) {\n149|\trequired := deriveRequiredList(t, \"environ\", \"observation.go\", \"observationRequired\")\n150|\tderived := map[string]bool{}\n151|\tfor _, member := range required {\n152|\t\tderived[member] = true\n153|\t}\n154|\tcovered := map[string]bool{}\n155|\tfor _, row := range observationCorpus(t) {\n156|\t\tif row.member == \"\" {\n157|\t\t\tcontinue\n158|\t\t}\n159|\t\tif !derived[row.member] {\n160|\t\t\tt.Fatalf(\"row %q names underived member %q\", row.name, row.member)\n161|\t\t}\n162|\t\tcovered[row.member] = true\n163|\t}\n164|\tfor _, member := range required {\n165|\t\tif !covered[member] {\n166|\t\t\tt.Errorf(\"derived required member %q owns no battery row\", member)\n167|\t\t}\n168|\t}\n169|}\n170|\n171|// TestDecodeEnvironmentObservation drives the corpus through the\n172|// production entry: accepts decode to the fixture values, and\n173|// every refusal carries its full rule rendering.\n174|func TestDecodeEnvironmentObservation(t *testing.T) {\n175|\tfor _, row := range observationCorpus(t) {\n176|\t\tt.Run(row.name, func(t *testing.T) {\n177|\t\t\tobservation, err := DecodeEnvironmentObservation(row.body)\n178|\t\t\tif row.text == \"\" {\n179|\t\t\t\tif err != nil {\n180|\t\t\t\t\tt.Fatalf(\"refused %s: %v\", row.body, err)\n181|\t\t\t\t}\n182|\t\t\t\tassertObservationFixture(t, observation)\n183|\t\t\t\treturn\n184|\t\t\t}\n185|\t\t\tif err == nil {\n186|\t\t\t\tt.Fatalf(\"admitted %s, want rule %q\", row.body, row.text)\n187|\t\t\t}\n188|\t\t\tif !strings.Contains(err.Error(), row.text) {\n189|\t\t\t\tt.Fatalf(\"error = %v, want rule %q\", err, row.text)\n190|\t\t\t}\n191|\t\t})\n192|\t}\n193|}\n194|\n195|// assertObservationFixture requires the decoded accept to carry\n196|// the shared fixture identities: the verdict is accept AND the\n197|// values are the fixture's, so a decoder that accepts while\n198|// misreading a member cannot pass.\n199|func assertObservationFixture(t *testing.T, observation Observation) {\n200|\tt.Helper()\n201|\tif observation.ObservationID != fixtureObserveID {\n202|\t\tt.Fatalf(\"observation id = %q, want %q\", observation.ObservationID, fixtureObserveID)\n203|\t}\n204|\tif observation.HostID != fixtureHostID {\n205|\t\tt.Fatalf(\"host id = %q, want %q\", observation.HostID, fixtureHostID)\n206|\t}\n207|\tif observation.InstallationID != fixtureInstallID {\n208|\t\tt.Fatalf(\"installation id = %q, want %q\", observation.InstallationID, fixtureInstallID)\n209|\t}\n210|\tif observation.EnvironmentID != fixtureEnvironmentID {\n211|\t\tt.Fatalf(\"environment id = %q, want %q\", observation.EnvironmentID, fixtureEnvironmentID)\n212|\t}\n213|\tif observation.ProviderID != fixtureProviderID {\n214|\t\tt.Fatalf(\"provider id = %q, want %q\", observation.ProviderID, fixtureProviderID)\n215|\t}\n216|\tif len(observation.Capabilities) != 8 {\n217|\t\tt.Fatalf(\"capabilities = %d entries, want the exact eight\", len(observation.Capabilities))\n218|\t}\n219|}\n220|\n221|// TestDirectoryCapabilityTableIsShared requires the environ and\n222|// dirnode directory-capability tables to be literally equal. The\n223|// adapter fifteen-name and provider seven-name tables share the\n224|// symbol name but are different rules in different stories, so\n225|// they are out of scope here by rule identity, not by silence:\n226|// this comparison names its files.\n227|func TestDirectoryCapabilityTableIsShared(t *testing.T) {\n228|\tmine := deriveRequiredList(t, \"environ\", \"observation.go\", \"capabilityOrder\")\n229|\ttheirs := deriveRequiredList(t, \"dirnode\", \"manifest.go\", \"capabilityOrder\")\n230|\tif !reflect.DeepEqual(mine, theirs) {\n231|\t\tt.Fatalf(\"directory capability tables differ:\\nenviron: %q\\ndirnode:  %q\", mine, theirs)\n232|\t}\n233|\tif len(mine) != 8 {\n234|\t\tt.Fatalf(\"directory capability table has %d names, want the exact eight\", len(mine))\n235|\t}\n236|}\n237|\n238|// TestArchitectureTableIsShared requires the three architecture\n239|// tables in scope to be literally equal.\n240|func TestArchitectureTableIsShared(t *testing.T) {\n241|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleArchitectures\")\n242|\tadapter := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleArchitectures\")\n243|\tnode := deriveRequiredList(t, \"dirnode\", \"probe.go\", \"architectures\")\n244|\tif !reflect.DeepEqual(mine, adapter) || !reflect.DeepEqual(mine, node) {\n245|\t\tt.Fatalf(\"architecture tables differ:\\nenviron: %q\\nsessadapter: %q\\ndirnode: %q\", mine, adapter, node)\n246|\t}\n247|}\n248|\n249|// TestNegotiatedPlatformsParse requires every platform token in\n250|// the derived dirnode v2 vocabulary to parse as a scalar\n251|// platform, and requires the legacy v1 darwin token to refuse:\n252|// the vocabularies are per-major by design, and a token that\n253|// crossed majors silently would break the Section 7.9 binding.\n254|func TestNegotiatedPlatformsParse(t *testing.T) {\n255|\tv2 := deriveRequiredList(t, \"dirnode\", \"probe.go\", \"platformV2\")\n256|\tif len(v2) != 4 {\n257|\t\tt.Fatalf(\"platformV2 has %d tokens, want four\", len(v2))\n258|\t}\n259|\tfor _, token := range v2 {\n260|\t\tif _, err := scalar.ParsePlatform(token); err != nil {\n261|\t\t\tt.Fatalf(\"v2 token %q does not parse as a platform: %v\", token, err)\n262|\t\t}\n263|\t}\n264|\tif _, err := scalar.ParsePlatform(\"darwin\"); err == nil {\n265|\t\tt.Fatal(\"legacy darwin parses as a platform; the majors are no longer separated\")\n266|\t}\n267|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
