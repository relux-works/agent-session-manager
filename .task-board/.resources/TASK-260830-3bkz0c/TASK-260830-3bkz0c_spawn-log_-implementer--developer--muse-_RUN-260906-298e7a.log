{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c5","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":445,"recorded_at":1780531400000885,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"call_id":"call_01a0764fe9667e11a40648d7a44df0bf","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/frame_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n17|)\n18|\n19|// This file is the cross-facade frame-agreement battery. Every\n20|// Section 7.8, 7.9, and provider-protocol body crosses a strict\n21|// object decoder before any member is trusted, and each facade\n22|// carries its own copy of that decoder (ledgered in\n23|// census_test.go). The battery drives one shared corpus through\n24|// all five judges — environ.DecodeStrictObject,\n25|// sessadapter.DecodeTuple, dirnode.CheckScanRequest,\n26|// provhost.DecodeManifest, and canonicaljson.Canonicalize — and\n27|// requires the ledgered verdict at each.\n28|//\n29|// A row whose reached arm cannot be determined fails, never\n30|// passes: frame-fault rows assert the full rendering (the fault\n31|// detail phrase in the refusal text), and accept rows assert the\n32|// body travels past the frame gate (an accept, or a refusal at a\n33|// named later arm with the frame phrase asserted absent). A code\n34|//-only assertion would conflate the frame gate with the member\n35|// gates behind it, which carry the same refusal code.\n36|//\n37|// The roster fails closed in both directions: every fault detail\n38|// derived from environ production must own at least one row, and\n39|// a row naming a detail production no longer derives fails as\n40|// orphaned. Expected verdicts are ledgered per judge, so a\n41|// verdict flip in EITHER direction — a fix or a regression —\n42|// reddens its row instead of passing silently.\n43|\n44|// frameRow is one corpus vector with the ledgered verdict at\n45|// every judge. A refuse expectation names the refusal text the\n46|// verdict must contain; an accept expectation names a later-arm\n47|// text the verdict must contain (\"\" with accept=true means the\n48|// entry itself accepts). canonicalRefuse nil means the\n49|// canonicalizer is not judged on this row: it validates JSON\n50|// values, not closed objects, so object-shape faults\n51|// (non-object, duplicate, trailing) are outside the decoder\n52|// rules it shares with the facades.\n53|type frameRow struct {\n54|\tfault string\n55|\tname  string\n56|\tbody  []byte\n57|\n58|\t// Per-judge bodies override body where an entry needs a\n59|\t// shaped vector (accept controls): nil means the shared\n60|\t// minimal body, which every frame gate refuses before any\n61|\t// member is read.\n62|\tsessBody []byte\n63|\tdirBody  []byte\n64|\tprovBody []byte\n65|\n66|\tenvironRefuse string\n67|\tenvironMember string\n68|\n69|\tsessAccept bool\n70|\tsessText   string\n71|\tsessAbsent string\n72|\n73|\tdirAccept bool\n74|\tdirText   string\n75|\tdirAbsent string\n76|\n77|\tprovAccept bool\n78|\tprovText   string\n79|\tprovAbsent string\n80|\n81|\tcanonicalRefuse *bool\n82|}\n83|\n84|func boolPointer(value bool) *bool {\n85|\treturn &value\n86|}\n87|\n88|// frameCorpus is the shared fault corpus. Surrogate subclasses\n89|// enumerate the full shape of the gate: bare highs and lows,\n90|// mispairs, truncated and malformed escapes, paired controls,\n91|// and backslash-run parity (runs of 1..3 backslashes before the\n92|// escape, in value, member-name, and nested positions). Run\n93|// parity is the exact shape of the recorded raw-scan divergence:\n94|// a string-aware walk consumes `\\\\` pairs, so a `\\u` sequence\n95|// behind an odd run is a real escape every judge refuses when\n96|// lone, while the same sequence behind an even run is quoted\n97|// text the raw byte scan still refuses. A raw scanner matches\n98|// every `\\u` byte pair regardless of string context.\n99|func frameCorpus() []frameRow {\n100|\tpairVersion := `\"environment_version\":\"A\\uD83D\\uDE00B\"`\n101|\tpairTuple := []byte(strings.Replace(validTupleJSON(), `\"environment_version\":\"2.1.0\"`, pairVersion, 1))\n102|\tpairCursor := validScanRequestJSON(`\"A\\uD83D\\uDE00B\"`)\n103|\trows := []frameRow{\n104|\t\t{\n105|\t\t\tfault: FaultNotUTF8, name: \"non-utf8 bytes\",\n106|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"a\\xff\\\"}\"),\n107|\t\t\tenvironRefuse: FaultNotUTF8,\n108|\t\t\tsessText:      FaultNotUTF8, dirText: FaultNotUTF8, provText: FaultNotUTF8,\n109|\t\t\tcanonicalRefuse: boolPointer(true),\n110|\t\t},\n111|\t\t{\n112|\t\t\tfault: FaultLoneSurrogate, name: \"bare high escape\",\n113|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\ud800B\\\"}\"),\n114|\t\t\tenvironRefuse: FaultLoneSurrogate,\n115|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n116|\t\t\tcanonicalRefuse: boolPointer(true),\n117|\t\t},\n118|\t\t{\n119|\t\t\tfault: FaultLoneSurrogate, name: \"bare low escape\",\n120|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\udc00B\\\"}\"),\n121|\t\t\tenvironRefuse: FaultLoneSurrogate,\n122|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n123|\t\t\tcanonicalRefuse: boolPointer(true),\n124|\t\t},\n125|\t\t{\n126|\t\t\tfault: FaultLoneSurrogate, name: \"high followed by non-low\",\n127|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83D\\\\u0041B\\\"}\"),\n128|\t\t\tenvironRefuse: FaultLoneSurrogate,\n129|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n130|\t\t\tcanonicalRefuse: boolPointer(true),\n131|\t\t},\n132|\t\t{\n133|\t\t\tfault: FaultNotObject, name: \"truncated escape falls to syntax\",\n134|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83\\\"}\"),\n135|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n136|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n137|\t\t\tcanonicalRefuse: boolPointer(true),\n138|\t\t},\n139|\t\t{\n140|\t\t\tfault: FaultNotObject, name: \"malformed escape falls to syntax\",\n141|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uDEFG B\\\"}\"),\n142|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n143|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n144|\t\t\tcanonicalRefuse: boolPointer(true),\n145|\t\t},\n146|\t\t{\n147|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run2\",\n148|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800B\\\"}\"),\n149|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n150|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n151|\t\t\tcanonicalRefuse: boolPointer(false),\n152|\t\t},\n153|\t\t{\n154|\t\t\t// Run 3 is an escaped backslash followed by a REAL\n155|\t\t\t// lone escape (value `A\\` plus U+D800), so every\n156|\t\t\t// judge refuses: odd runs escape, even runs quote.\n157|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run3\",\n158|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\\\\\ud800B\\\"}\"),\n159|\t\t\tenvironRefuse: FaultLoneSurrogate,\n160|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n161|\t\t\tcanonicalRefuse: boolPointer(true),\n162|\t\t},\n163|\t\t{\n164|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash low run2\",\n165|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\udc00B\\\"}\"),\n166|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n167|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n168|\t\t\tcanonicalRefuse: boolPointer(false),\n169|\t\t},\n170|\t\t{\n171|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash pair run2\",\n172|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\uD83D\\\\\\\\uDE00B\\\"}\"),\n173|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n174|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n175|\t\t\tcanonicalRefuse: boolPointer(false),\n176|\t\t},\n177|\t\t{\n178|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash in member name\",\n179|\t\t\tbody:     []byte(\"{\\\"A\\\\\\\\ud800B\\\":1}\"),\n180|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n181|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n182|\t\t\tcanonicalRefuse: boolPointer(false),\n183|\t\t},\n184|\t\t{\n185|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash nested\",\n186|\t\t\tbody:     []byte(\"{\\\"v\\\":{\\\"w\\\":\\\"A\\\\\\\\ud800B\\\"}}\"),\n187|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n188|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n189|\t\t\tcanonicalRefuse: boolPointer(false),\n190|\t\t},\n191|\t\t{\n192|\t\t\tfault: FaultDuplicate, name: \"duplicate member\",\n193|\t\t\tbody:          []byte(\"{\\\"v\\\":1,\\\"v\\\":2}\"),\n194|\t\t\tenvironRefuse: FaultDuplicate, environMember: \"v\",\n195|\t\t\tsessText: FaultDuplicate, dirText: FaultDuplicate, provText: FaultDuplicate,\n196|\t\t},\n197|\t\t{\n198|\t\t\tfault: FaultTrailing, name: \"trailing data\",\n199|\t\t\tbody:          []byte(\"{\\\"v\\\":1} {}\"),\n200|\t\t\tenvironRefuse: FaultTrailing,\n201|\t\t\tsessText:      FaultTrailing, dirText: FaultTrailing, provText: FaultTrailing,\n202|\t\t},\n203|\t\t{\n204|\t\t\tfault: FaultNotObject, name: \"non-object top level\",\n205|\t\t\tbody:          []byte(\"[1,2]\"),\n206|\t\t\tenvironRefuse: FaultNotObject,\n207|\t\t\tsessText:      FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n208|\t\t},\n209|\t\t{\n210|\t\t\tfault: FaultNotObject, name: \"unterminated string is syntax\",\n211|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"abc\"),\n212|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n213|\t\t\tsessText: FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n214|\t\t\tcanonicalRefuse: boolPointer(true),\n215|\t\t},\n216|\t\t{\n217|\t\t\tfault: FaultLoneSurrogate, name: \"paired surrogates admit\",\n218|\t\t\tbody:       []byte(`{\"v\":\"A\\uD83D\\uDE00B\"}`),\n219|\t\t\tsessBody:   pairTuple,\n220|\t\t\tdirBody:    pairCursor,\n221|\t\t\tprovBody:   []byte(`{\"note\":\"A\\uD83D\\uDE00B\"}`),\n222|\t\t\tsessAccept: true,\n223|\t\t\tdirAccept:  true,\n224|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n225|\t\t\tcanonicalRefuse: boolPointer(false),\n226|\t\t},\n227|\t\t{\n228|\t\t\tfault: FaultNotUTF8, name: \"multibyte text admits\",\n229|\t\t\tbody:       []byte(\"{\\\"v\\\":\\\"plain ü ☃\\\"}\"),\n230|\t\t\tsessBody:   pairTuple,\n231|\t\t\tdirBody:    pairCursor,\n232|\t\t\tprovBody:   []byte(\"{\\\"note\\\":\\\"plain ü ☃\\\"}\"),\n233|\t\t\tsessAccept: true,\n234|\t\t\tdirAccept:  true,\n235|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultNotUTF8,\n236|\t\t\tcanonicalRefuse: boolPointer(false),\n237|\t\t},\n238|\t}\n239|\treturn rows\n240|}\n241|\n242|// deriveFaultDetails derives the frame-fault space from environ\n243|// production: every Fault* constant value in decode.go. A sixth\n244|// fault shape fails the roster below instead of passing\n245|// unrostered.\n246|func deriveFaultDetails(t *testing.T) map[string]bool {\n247|\tt.Helper()\n248|\tpath := filepath.Join(mustGetwd(t), \"decode.go\")\n249|\tsource, err := os.ReadFile(path)\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"faults: %v\", err)\n252|\t}\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"faults: %v\", err)\n256|\t}\n257|\tdetails := map[string]bool{}\n258|\tfor _, decl := range syntax.Decls {\n259|\t\tnode, ok := decl.(*ast.GenDecl)\n260|\t\tif !ok {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tfor _, spec := range node.Specs {\n264|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n265|\t\t\tif !ok {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tfor index, name := range value.Names {\n269|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n270|\t\t\t\t\tcontinue\n271|\t\t\t\t}\n272|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n273|\t\t\t\tif !ok {\n274|\t\t\t\t\tt.Fatalf(\"faults: %s is not a literal; the extractor cannot see through indirection\", name.Name)\n275|\t\t\t\t}\n276|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n277|\t\t\t\tif err != nil {\n278|\t\t\t\t\tt.Fatalf(\"faults: %v\", err)\n279|\t\t\t\t}\n280|\t\t\t\tdetails[text] = true\n281|\t\t\t}\n282|\t\t}\n283|\t}\n284|\tif len(details) == 0 {\n285|\t\tt.Fatal(\"faults derived zero details; the scanner is blind, not the space empty\")\n286|\t}\n287|\treturn details\n288|}\n289|\n290|func mustGetwd(t *testing.T) string {\n291|\tt.Helper()\n292|\tdirectory, err := os.Getwd()\n293|\tif err != nil {\n294|\t\tt.Fatalf(\"frame: %v\", err)\n295|\t}\n296|\treturn directory\n297|}\n298|\n299|// TestFrameFaultRosterIsClosed requires every derived fault\n300|// detail to own at least one row, and every row to name a\n301|// derived detail.\n302|func TestFrameFaultRosterIsClosed(t *testing.T) {\n303|\tdetails := deriveFaultDetails(t)\n304|\tcovered := map[string]bool{}\n305|\tfor _, row := range frameCorpus() {\n306|\t\tif row.fault == \"\" {\n307|\t\t\tt.Fatalf(\"row %q names no fault detail\", row.name)\n308|\t\t}\n309|\t\tif !details[row.fault] {\n310|\t\t\tt.Fatalf(\"row %q names underived detail %q\", row.name, row.fault)\n311|\t\t}\n312|\t\tcovered[row.fault] = true\n313|\t}\n314|\tfor detail := range details {\n315|\t\tif !covered[detail] {\n316|\t\t\tt.Errorf(\"derived fault detail %q owns no corpus row\", detail)\n317|\t\t}\n318|\t}\n319|}\n320|\n321|// TestFrameAgreementAcrossFacades drives the shared corpus\n322|// through all five judges and requires the ledgered verdict at\n323|// each. environ rows assert the exact fault and member; facade\n324|// rows assert the full frame rendering (the detail phrase in the\n325|// refusal text) or, for accept rows, travel past the frame gate\n326|// with the frame phrase asserted absent; canonical rows assert\n327|// the verdict only, where the canonicalizer shares the rule.\n328|func TestFrameAgreementAcrossFacades(t *testing.T) {\n329|\tfor _, row := range frameCorpus() {\n330|\t\tt.Run(row.name, func(t *testing.T) {\n331|\t\t\t_, fault := DecodeStrictObject(row.body)\n332|\t\t\tif row.environRefuse == \"\" {\n333|\t\t\t\tif fault != nil {\n334|\t\t\t\t\tt.Fatalf(\"environ refused %q: %v\", row.body, fault)\n335|\t\t\t\t}\n336|\t\t\t} else {\n337|\t\t\t\tif fault == nil {\n338|\t\t\t\t\tt.Fatalf(\"environ admitted %q, want fault %q\", row.body, row.environRefuse)\n339|\t\t\t\t}\n340|\t\t\t\tif fault.Detail != row.environRefuse || fault.Member != row.environMember {\n341|\t\t\t\t\tt.Fatalf(\"environ fault = (%q, %q), want (%q, %q)\", fault.Detail, fault.Member, row.environRefuse, row.environMember)\n342|\t\t\t\t}\n343|\t\t\t}\n344|\t\t\tsessBody := orBody(row.body, row.sessBody)\n345|\t\t\tdirBody := orBody(row.body, row.dirBody)\n346|\t\t\tprovBody := orBody(row.body, row.provBody)\n347|\t\t\tassertFacadeVerdict(t, \"sessadapter\", sessBody, row.sessAccept, row.sessText, row.sessAbsent, func(body []byte) error {\n348|\t\t\t\t_, err := sessadapter.DecodeTuple(body)\n349|\t\t\t\treturn err\n350|\t\t\t})\n351|\t\t\tassertFacadeVerdict(t, \"dirnode\", dirBody, row.dirAccept, row.dirText, row.dirAbsent, func(body []byte) error {\n352|\t\t\t\t_, err := dirnode.CheckScanRequest(body)\n353|\t\t\t\treturn err\n354|\t\t\t})\n355|\t\t\tassertFacadeVerdict(t, \"provhost\", provBody, row.provAccept, row.provText, row.provAbsent, func(body []byte) error {\n356|\t\t\t\treturn provhost.DecodeManifest(body)\n357|\t\t\t})\n358|\t\t\tif row.canonicalRefuse != nil {\n359|\t\t\t\t_, err := canonicaljson.Canonicalize(row.body)\n360|\t\t\t\tif (*row.canonicalRefuse && err == nil) || (!*row.canonicalRefuse && err != nil) {\n361|\t\t\t\t\tt.Fatalf(\"canonicaljson verdict = refuse=%v, want refuse=%v (err=%v)\", err != nil, *row.canonicalRefuse, err)\n362|\t\t\t\t}\n363|\t\t\t}\n364|\t\t})\n365|\t}\n366|}\n367|\n368|// orBody selects the per-judge override body when present.\n369|func orBody(shared, override []byte) []byte {\n370|\tif override != nil {\n371|\t\treturn override\n372|\t}\n373|\treturn shared\n374|}\n375|\n376|// assertFacadeVerdict requires the ledgered verdict at one\n377|// facade entry: an accept, or a refusal whose text contains the\n378|// frame phrase (and never contains the absent phrase, which\n379|// pins travel past a gate the body must cross).\n380|func assertFacadeVerdict(t *testing.T, facade string, body []byte, accept bool, text, absent string, drive func([]byte) error) {\n381|\tt.Helper()\n382|\terr := drive(body)\n383|\tif accept {\n384|\t\tif err != nil {\n385|\t\t\tt.Fatalf(\"%s refused %q, want accept: %v\", facade, body, err)\n386|\t\t}\n387|\t\treturn\n388|\t}\n389|\tif err == nil {\n390|\t\tt.Fatalf(\"%s admitted %q, want refusal containing %q\", facade, body, text)\n391|\t}\n392|\tif text != \"\" && !strings.Contains(err.Error(), text) {\n393|\t\tt.Fatalf(\"%s error = %v, want text containing %q\", facade, err, text)\n394|\t}\n395|\tif absent != \"\" && strings.Contains(err.Error(), absent) {\n396|\t\tt.Fatalf(\"%s error = %v, must not contain %q\", facade, err, absent)\n397|\t}\n398|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c7","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":446,"recorded_at":1780531400000887,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"call_id":"call_01a0764fea1a7d21af0fc86e6fc21348","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/measure_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n13|)\n14|\n15|// This file is the cross-facade string-measure battery. Section\n16|// 1.6 bounds strings in characters, not bytes: string[1..128]\n17|// admits 128 characters of any width. Two strict decoders both\n18|// blind to lone surrogates was one drift class the cross-story\n19|// review found; byte-vs-rune bounds disagreeing on a member that\n20|// crosses both protocols was another. This battery pins the\n21|// measure at every character-bound member one facade shares with\n22|// another, with multibyte vectors that separate the measures: a\n23|// 128-`é` value is 128 characters but 256 bytes, so a\n24|// byte-measure refuses what the specification admits.\n25|//\n26|// The byte side is ledgered, not left open. Provider SpawnPlan\n27|// argv elements and totals and env-literal values bound BYTES by\n28|// Section 5.1 (outside this story), implemented in exactly two\n29|// functions — provhost checkSpawnArgv and checkSpawnEnvLiterals\n30|// — and the byte rows below drive all three byte gates through\n31|// the production DecodeSpawnPlan entry. validEnvName measures\n32|// len() over an ASCII-only grammar where bytes and runes\n33|// coincide, so no row can separate them; that is stated here,\n34|// not hidden. Every other string bound in the census scope flows\n35|// through the single measure helper of its package (census\n36|// ledger: StringLength, runeLength, stringLength), and the rune\n37|// rows pin the helper verdicts at one crossing member per\n38|// facade plus every provhost rune site.\n39|\n40|// validSpawnJSON is one valid Provider SpawnPlan body with the\n41|// given profile mapping, first extra argv element, literal value,\n42|// and native session ID literal. The argv always carries one\n43|// short flag so element-count rules hold while one member under\n44|// test varies.\n45|func validSpawnJSON(mapping, extraArgv, literalValue, nativeID string) []byte {\n46|\targv := `[\"--serve\"]`\n47|\tif extraArgv != \"\" {\n48|\t\targv = fmt.Sprintf(`[\"--serve\",%s]`, jsonQuote(extraArgv))\n49|\t}\n50|\tliterals := `{}`\n51|\tif literalValue != \"\" {\n52|\t\tliterals = fmt.Sprintf(`{\"EXTRA_KEY\":%s}`, jsonQuote(literalValue))\n53|\t}\n54|\tnative := `null`\n55|\tif nativeID != \"\" {\n56|\t\tnative = jsonQuote(nativeID)\n57|\t}\n58|\treturn []byte(fmt.Sprintf(`{\"argv\":%s,\"cwd\":\"/tmp/ax\",\"env_names\":[],\"env_literals\":%s,\"native_session_id\":%s,\"profile_mapping\":%s,\"extensions\":{}}`,\n59|\t\targv, literals, native, jsonQuote(mapping)))\n60|}\n61|\n62|// validSpawnMapping returns the production YOLO flag for codex:\n63|// scaffolding for rows whose probe point is a different member,\n64|// so a mapping change cannot break them for the wrong reason.\n65|// Rows whose probe point IS the mapping construct their own\n66|// lengths and never call this.\n67|func validSpawnMapping(t *testing.T) string {\n68|\tt.Helper()\n69|\tmapping, err := provhost.ProfileMapping(\"codex\", provhost.ProfileYOLO)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"scaffolding: %v\", err)\n72|\t}\n73|\treturn mapping\n74|}\n75|\n76|// jsonQuote quotes a Go string as a JSON string literal.\n77|func jsonQuote(value string) string {\n78|\treturn fmt.Sprintf(\"%q\", value)\n79|}\n80|\n81|// TestStringMeasureCountsRunes proves the character measure at\n82|// the unit helper and at one crossing member per facade. Each\n83|// accept vector carries more bytes than its bound, so a\n84|// byte-measure would refuse it; each refuse vector carries one\n85|// character too many, so a widened bound would admit it.\n86|func TestStringMeasureCountsRunes(t *testing.T) {\n87|\tascii128 := strings.Repeat(\"v\", 128)\n88|\twide128 := strings.Repeat(\"é\", 128)\n89|\twide129 := strings.Repeat(\"é\", 129)\n90|\twide512 := strings.Repeat(\"é\", 512)\n91|\twide513 := strings.Repeat(\"é\", 513)\n92|\twide1024 := strings.Repeat(\"é\", 1024)\n93|\twide1025 := strings.Repeat(\"é\", 1025)\n94|\twide4096 := strings.Repeat(\"é\", 4096)\n95|\twide4097 := strings.Repeat(\"é\", 4097)\n96|\tt.Run(\"environ helper\", func(t *testing.T) {\n97|\t\tif _, ok := CheckStringBounds([]byte(jsonQuote(wide128)), 1, 128); !ok {\n98|\t\t\tt.Fatal(\"CheckStringBounds refused 128 characters in 256 bytes\")\n99|\t\t}\n100|\t\tif _, ok := CheckStringBounds([]byte(jsonQuote(wide129)), 1, 128); ok {\n101|\t\t\tt.Fatal(\"CheckStringBounds admitted 129 characters\")\n102|\t\t}\n103|\t\tif _, ok := CheckStringBounds([]byte(jsonQuote(ascii128)), 1, 128); !ok {\n104|\t\t\tt.Fatal(\"CheckStringBounds refused 128 ASCII characters\")\n105|\t\t}\n106|\t})\n107|\tt.Run(\"sessadapter tuple version\", func(t *testing.T) {\n108|\t\taccept := []byte(strings.Replace(validTupleJSON(), `\"2.1.0\"`, jsonQuote(wide128), 1))\n109|\t\tif _, err := sessadapter.DecodeTuple(accept); err != nil {\n110|\t\t\tt.Fatalf(\"DecodeTuple refused 128-character version: %v\", err)\n111|\t\t}\n112|\t\trefuse := []byte(strings.Replace(validTupleJSON(), `\"2.1.0\"`, jsonQuote(wide129), 1))\n113|\t\t_, err := sessadapter.DecodeTuple(refuse)\n114|\t\tif err == nil {\n115|\t\t\tt.Fatal(\"DecodeTuple admitted 129-character version\")\n116|\t\t}\n117|\t\tif !strings.Contains(err.Error(), \"string[1..128]\") {\n118|\t\t\tt.Fatalf(\"DecodeTuple error = %v, want the version bound arm\", err)\n119|\t\t}\n120|\t})\n121|\tt.Run(\"dirnode scan cursor\", func(t *testing.T) {\n122|\t\tif _, err := dirnode.CheckScanRequest(validScanRequestJSON(jsonQuote(wide4096))); err != nil {\n123|\t\t\tt.Fatalf(\"CheckScanRequest refused 4096-character cursor: %v\", err)\n124|\t\t}\n125|\t\t_, err := dirnode.CheckScanRequest(validScanRequestJSON(jsonQuote(wide4097)))\n126|\t\tif err == nil {\n127|\t\t\tt.Fatal(\"CheckScanRequest admitted 4097-character cursor\")\n128|\t\t}\n129|\t\tif !strings.Contains(err.Error(), \"string[1..4096]\") {\n130|\t\t\tt.Fatalf(\"CheckScanRequest error = %v, want the cursor bound arm\", err)\n131|\t\t}\n132|\t})\n133|\tt.Run(\"provhost profile mapping bound arm\", func(t *testing.T) {\n134|\t\tbound := validSpawnJSON(strings.Repeat(\"m\", 513), \"\", \"\", \"\")\n135|\t\terr := provhost.DecodeSpawnPlan(bound, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux)\n136|\t\tif err == nil {\n137|\t\t\tt.Fatal(\"DecodeSpawnPlan admitted 513-character mapping\")\n138|\t\t}\n139|\t\tif !strings.Contains(err.Error(), \"not at most 512 characters\") {\n140|\t\t\tt.Fatalf(\"DecodeSpawnPlan error = %v, want the mapping bound arm\", err)\n141|\t\t}\n142|\t})\n143|\tt.Run(\"provhost mapping admits 300 wide characters\", func(t *testing.T) {\n144|\t\t// 300 `é` is 300 characters but 600 bytes: the bound\n145|\t\t// arm must admit it (runes) and the equality arm must\n146|\t\t// refuse it (it is not the provider mapping). A byte\n147|\t\t// measure would fire the bound arm instead.\n148|\t\twide := validSpawnJSON(strings.Repeat(\"é\", 300), \"\", \"\", \"\")\n149|\t\terr := provhost.DecodeSpawnPlan(wide, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux)\n150|\t\tif err == nil {\n151|\t\t\tt.Fatal(\"DecodeSpawnPlan admitted a mapping that is not the provider mapping\")\n152|\t\t}\n153|\t\tif !strings.Contains(err.Error(), \"does not match the provider profile\") {\n154|\t\t\tt.Fatalf(\"DecodeSpawnPlan error = %v, want the mapping equality arm, not the bound arm\", err)\n155|\t\t}\n156|\t})\n157|\tt.Run(\"provhost native session id bound\", func(t *testing.T) {\n158|\t\tmapping := validSpawnMapping(t)\n159|\t\taccept := validSpawnJSON(mapping, \"\", \"\", wide512)\n160|\t\tif err := provhost.DecodeSpawnPlan(accept, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux); err != nil {\n161|\t\t\tt.Fatalf(\"DecodeSpawnPlan refused 512-character native session id: %v\", err)\n162|\t\t}\n163|\t\trefuse := validSpawnJSON(mapping, \"\", \"\", wide513)\n164|\t\terr := provhost.DecodeSpawnPlan(refuse, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux)\n165|\t\tif err == nil {\n166|\t\t\tt.Fatal(\"DecodeSpawnPlan admitted 513-character native session id\")\n167|\t\t}\n168|\t\tif !strings.Contains(err.Error(), \"1..512 characters\") {\n169|\t\t\tt.Fatalf(\"DecodeSpawnPlan error = %v, want the native session id bound arm\", err)\n170|\t\t}\n171|\t})\n172|\tt.Run(\"identity opaque bound agrees\", func(t *testing.T) {\n173|\t\t// The opaque_identity value bound (1..1024 runes) is\n174|\t\t// the one member validated by both identity dialects:\n175|\t\t// both judges must agree on the multibyte edges.\n176|\t\taccept := mutateMember(t, validIdentityJSON(), \"opaque_identity\", `{\"k\":`+jsonQuote(wide1024)+`}`)\n177|\t\tif err := provhost.CheckIdentity(accept, \"antigravity\"); err != nil {\n178|\t\t\tt.Fatalf(\"CheckIdentity refused 1024-character opaque value: %v\", err)\n179|\t\t}\n180|\t\tif _, _, err := canonicaljson.CalculateObjectIdentity(accept); err != nil {\n181|\t\t\tt.Fatalf(\"CalculateObjectIdentity refused 1024-character opaque value: %v\", err)\n182|\t\t}\n183|\t\trefuse := mutateMember(t, validIdentityJSON(), \"opaque_identity\", `{\"k\":`+jsonQuote(wide1025)+`}`)\n184|\t\tif err := provhost.CheckIdentity(refuse, \"antigravity\"); err == nil {\n185|\t\t\tt.Fatal(\"CheckIdentity admitted 1025-character opaque value\")\n186|\t\t}\n187|\t\tif _, _, err := canonicaljson.CalculateObjectIdentity(refuse); err == nil {\n188|\t\t\tt.Fatal(\"CalculateObjectIdentity admitted 1025-character opaque value\")\n189|\t\t}\n190|\t})\n191|}\n192|\n193|// TestByteBoundsStayBytes proves the three ledgered byte gates\n194|// keep measuring bytes: each vector is within the rune bound a\n195|// character measure would enforce but over the byte bound the\n196|// specification states, so a rune-measure regression would admit\n197|// it and travel to a later arm instead of the byte arm.\n198|func TestByteBoundsStayBytes(t *testing.T) {\n199|\tmapping := validSpawnMapping(t)\n200|\tt.Run(\"argv element bytes\", func(t *testing.T) {\n201|\t\t// 2049 `é` is 2049 characters but 4098 bytes.\n202|\t\tbody := validSpawnJSON(mapping, strings.Repeat(\"é\", 2049), \"\", \"\")\n203|\t\terr := provhost.DecodeSpawnPlan(body, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux)\n204|\t\tif err == nil {\n205|\t\t\tt.Fatal(\"DecodeSpawnPlan admitted a 4098-byte argv element\")\n206|\t\t}\n207|\t\tif !strings.Contains(err.Error(), \"NUL-free bytes\") {\n208|\t\t\tt.Fatalf(\"DecodeSpawnPlan error = %v, want the argv element byte arm\", err)\n209|\t\t}\n210|\t})\n211|\tt.Run(\"argv total bytes\", func(t *testing.T) {\n212|\t\t// Seventeen 4000-byte elements pass the element gate\n213|\t\t// and fail the 65536-byte total.\n214|\t\telements := make([]string, 0, 17)\n215|\t\tfor index := 0; index < 17; index++ {\n216|\t\t\telements = append(elements, jsonQuote(strings.Repeat(\"a\", 4000)))\n217|\t\t}\n218|\t\tbody := []byte(fmt.Sprintf(`{\"argv\":[\"--serve\",%s],\"cwd\":\"/tmp/ax\",\"env_names\":[],\"env_literals\":{},\"native_session_id\":null,\"profile_mapping\":%s,\"extensions\":{}}`,\n219|\t\t\tstrings.Join(elements, \",\"), jsonQuote(mapping)))\n220|\t\terr := provhost.DecodeSpawnPlan(body, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux)\n221|\t\tif err == nil {\n222|\t\t\tt.Fatal(\"DecodeSpawnPlan admitted argv over 65536 total bytes\")\n223|\t\t}\n224|\t\tif !strings.Contains(err.Error(), \"65536 bytes total\") {\n225|\t\t\tt.Fatalf(\"DecodeSpawnPlan error = %v, want the argv total byte arm\", err)\n226|\t\t}\n227|\t})\n228|\tt.Run(\"env literal bytes\", func(t *testing.T) {\n229|\t\tbody := validSpawnJSON(mapping, \"\", strings.Repeat(\"é\", 2049), \"\")\n230|\t\terr := provhost.DecodeSpawnPlan(body, \"codex\", provhost.ProfileYOLO, scalar.PlatformLinux)\n231|\t\tif err == nil {\n232|\t\t\tt.Fatal(\"DecodeSpawnPlan admitted a 4098-byte env literal\")\n233|\t\t}\n234|\t\tif !strings.Contains(err.Error(), \"4096 NUL-free bytes\") {\n235|\t\t\tt.Fatalf(\"DecodeSpawnPlan error = %v, want the env literal byte arm\", err)\n236|\t\t}\n237|\t})\n238|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c9","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":447,"recorded_at":1780531400000889,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"call_id":"call_01a0764fead17a81914dae9e274ea314","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/identity_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file is the Provider Identity agreement battery. Two\n16|// validators implement the Section 5.5 shape rule-for-rule:\n17|// provhost.CheckIdentity mints provider-stdio refusals while\n18|// canonicaljson validates the same record through the closed\n19|// identity shape on the way to its object identity. A shape-rule\n20|// change must land in both validators in the same change, and\n21|// this battery is what fails when it lands in only one: every\n22|// row drives one shared vector through both production entries\n23|// and requires identical verdicts with the full rendering on\n24|// each side.\n25|//\n26|// One split is by design, not drift: provider equality (the\n27|// record naming the expected provider) is a caller-correlation\n28|// rule the host enforces, not a content rule the identity\n29|// calculation owns. The another-provider row ledgers that split\n30|// exactly — provhost refuses invalid_config while the\n31|// canonicalizer accepts — so a content-rule divergence cannot\n32|// hide behind it and a change to the split reddens here.\n33|\n34|// identityRow is one agreement vector: the body, the provhost\n35|// rule phrase, and the canonicalizer rule phrase. Empty phrases\n36|// mean both entries accept.\n37|type identityRow struct {\n38|\tname      string\n39|\tbody      []byte\n40|\tprovText  string\n41|\tcanonText string\n42|}\n43|\n44|// identityCorpus mutates each identity member alone against an\n45|// otherwise-valid record over the shared fixture identities.\n46|func identityCorpus(t *testing.T) []identityRow {\n47|\tt.Helper()\n48|\tvalid := validIdentityJSON()\n49|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n50|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n51|\totherSubject := jsonQuote(fixtureCreatorHostID)\n52|\treturn []identityRow{\n53|\t\t{\"valid\", valid, \"\", \"\"},\n54|\t\t{\"unknown member\", appendMember(t, valid, \"score\", `1`), \"identity carries unknown member\", \"unknown member\"},\n55|\t\t{\"missing opaque\", drop(\"opaque_identity\"), \"identity misses a required member\", \"required member\"},\n56|\t\t// Schema dispatch precedes shape validation in the\n57|\t\t// canonicalizer: a wrong schema or version refuses at\n58|\t\t// the dispatch registry, never reaching the identity\n59|\t\t// rules provhost enforces as member arms. Same\n60|\t\t// verdict, different arm by construction; a schema\n61|\t\t// change must update the dispatch registry and both\n62|\t\t// validators together.\n63|\t\t{\"wrong schema\", set(\"schema\", `\"urn:ax:schema:provider-manifest\"`), \"identity schema is not the provider identity\", \"has no supported immutable self-identity contract\"},\n64|\t\t{\"wrong version\", set(\"schema_version\", `\"1.1.0\"`), \"identity schema_version is not 1.0.0\", \"has no supported immutable self-identity contract\"},\n65|\t\t{\"bad record digest\", set(\"record_id\", `\"sha256:zzzz\"`), \"identity record_id is not a digest\", \"record_id\"},\n66|\t\t{\"bad subject uuid\", set(\"subject_id\", `\"not-a-uuid\"`), \"identity subject_id is not a UUIDv7\", \"subject_id\"},\n67|\t\t{\"subject differs\", set(\"subject_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n68|\t\t{\"session differs\", set(\"session_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n69|\t\t{\"bad provider grammar\", set(\"provider_id\", `\"Antigravity\"`), \"identity provider_id is not a provider id\", \"provider_id\"},\n70|\t\t{\"empty version\", set(\"provider_version\", `\"\"`), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n71|\t\t{\"long version\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n72|\t\t{\"empty range\", set(\"provider_version_range\", `\"\"`), \"identity provider_version_range is not 1..256 characters\", \"provider_version_range\"},\n73|\t\t{\"empty native id\", set(\"native_session_id\", `\"\"`), \"identity native_session_id is not 1..512 characters\", \"native_session_id\"},\n74|\t\t{\"unknown kind\", set(\"identity_kind\", `\"telepathy\"`), \"identity kind is not a registry member\", \"identity_kind\"},\n75|\t\t{\"bad workspace uuid\", set(\"logical_workspace_id\", `\"not-a-uuid\"`), \"identity workspace is not a UUIDv7\", \"logical_workspace_id\"},\n76|\t\t{\"bad realm\", set(\"backend_realm_fingerprint\", `\"sha256:zzzz\"`), \"identity realm is not a digest or null\", \"backend_realm_fingerprint\"},\n77|\t\t{\"null realm refused\", set(\"backend_realm_fingerprint\", `null`), \"identity realm is required for this backend kind\", \"must be non-null for Antigravity\"},\n78|\t\t{\"opaque array refused\", set(\"opaque_identity\", `[]`), \"not a JSON object\", \"opaque_identity\"},\n79|\t\t{\"opaque 33 keys refused\", set(\"opaque_identity\", opaqueKeysJSON(33)), \"exceeds 32 entries\", \"exceeds maximum length 32\"},\n80|\t\t{\"opaque bad key\", set(\"opaque_identity\", `{\"K\":\"v\"}`), \"identity opaque key is not a provider key\", \"must match\"},\n81|\t\t{\"opaque empty value\", set(\"opaque_identity\", `{\"k\":\"\"}`), \"identity opaque value is not 1..1024 characters\", \"1..1024\"},\n82|\t\t{\"opaque absolute path\", set(\"opaque_identity\", `{\"k\":\"/etc/passwd\"}`), \"begins with an absolute path\", \"must not begin with an absolute path\"},\n83|\t\t{\"bad creator uuid\", set(\"created_by_host_id\", `\"not-a-uuid\"`), \"identity host is not a UUIDv7\", \"created_by_host_id\"},\n84|\t\t{\"bad timestamp\", set(\"created_at\", `\"yesterday\"`), \"identity timestamp is not a timestamp\", \"created_at\"},\n85|\t\t{\"extensions array refused\", set(\"extensions\", `[]`), \"identity extensions is not an object\", \"extensions\"},\n86|\t\t{\"lone escape refused\", set(\"opaque_identity\", `{\"k\":\"A`+rawLoneHigh+`B\"}`), \"lone surrogate escape\", \"surrogate\"},\n87|\t\t{\"escaped text admits\", set(\"opaque_identity\", `{\"k\":\"A`+rawEscapedHigh+`B\"}`), \"\", \"\"},\n88|\t}\n89|}\n90|\n91|// Raw escape fragments. rawLoneHigh is a real lone high escape\n92|// in JSON source; rawEscapedHigh is an escaped backslash\n93|// followed by text, which carries no escape at all. Both are\n94|// package variables (not literals) so the Go compiler never\n95|// sees an invalid \\u escape in source.\n96|var (\n97|\trawLoneHigh    = \"\\\\ud800\"\n98|\trawEscapedHigh = \"\\\\\\\\ud800\"\n99|)\n100|\n101|// opaqueKeysJSON builds an opaque_identity object with count\n102|// grammar-valid keys.\n103|func opaqueKeysJSON(count int) string {\n104|\tparts := make([]string, 0, count)\n105|\tfor index := 0; index < count; index++ {\n106|\t\tparts = append(parts, `\"k`+twoDigits(index)+`\":\"v\"`)\n107|\t}\n108|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n109|}\n110|\n111|func twoDigits(value int) string {\n112|\tdigits := \"0123456789\"\n113|\treturn string([]byte{digits[value/10%10], digits[value%10]})\n114|}\n115|\n116|// TestIdentityAgreementAcrossValidators drives the corpus\n117|// through both identity entries and requires identical verdicts\n118|// with the full rule rendering on each side.\n119|func TestIdentityAgreementAcrossValidators(t *testing.T) {\n120|\tfor _, row := range identityCorpus(t) {\n121|\t\tt.Run(row.name, func(t *testing.T) {\n122|\t\t\tprovErr := provhost.CheckIdentity(row.body, \"antigravity\")\n123|\t\t\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(row.body)\n124|\t\t\tif row.provText == \"\" && row.canonText == \"\" {\n125|\t\t\t\tif provErr != nil {\n126|\t\t\t\t\tt.Fatalf(\"provhost refused %s: %v\", row.body, provErr)\n127|\t\t\t\t}\n128|\t\t\t\tif canonErr != nil {\n129|\t\t\t\t\tt.Fatalf(\"canonicaljson refused %s: %v\", row.body, canonErr)\n130|\t\t\t\t}\n131|\t\t\t\treturn\n132|\t\t\t}\n133|\t\t\tif provErr == nil {\n134|\t\t\t\tt.Fatalf(\"provhost admitted %s, want rule %q\", row.body, row.provText)\n135|\t\t\t}\n136|\t\t\tif canonErr == nil {\n137|\t\t\t\tt.Fatalf(\"canonicaljson admitted %s, want rule %q\", row.body, row.canonText)\n138|\t\t\t}\n139|\t\t\tif !strings.Contains(provErr.Error(), row.provText) {\n140|\t\t\t\tt.Fatalf(\"provhost error = %v, want rule %q\", provErr, row.provText)\n141|\t\t\t}\n142|\t\t\tif !strings.Contains(canonErr.Error(), row.canonText) {\n143|\t\t\t\tt.Fatalf(\"canonicaljson error = %v, want rule %q\", canonErr, row.canonText)\n144|\t\t\t}\n145|\t\t})\n146|\t}\n147|}\n148|\n149|// TestIdentityProviderEqualityIsCallerRule ledgers the one\n150|// by-design split: a well-formed record for another provider is\n151|// a caller-correlation failure (invalid_config) at the host,\n152|// while the identity calculation accepts the content. Neither\n153|// side may change its half silently.\n154|func TestIdentityProviderEqualityIsCallerRule(t *testing.T) {\n155|\tbody := mutateMember(t, validIdentityJSON(), \"provider_id\", `\"codex\"`)\n156|\tprovErr := provhost.CheckIdentity(body, \"antigravity\")\n157|\tif provErr == nil {\n158|\t\tt.Fatalf(\"provhost admitted a record for another provider\")\n159|\t}\n160|\tif !strings.Contains(provErr.Error(), \"identity names another provider\") {\n161|\t\tt.Fatalf(\"provhost error = %v, want the caller-correlation arm\", provErr)\n162|\t}\n163|\tif _, _, canonErr := canonicaljson.CalculateObjectIdentity(body); canonErr != nil {\n164|\t\tt.Fatalf(\"canonicaljson refused well-formed content for another provider: %v\", canonErr)\n165|\t}\n166|}\n167|\n168|// TestIdentityMemberTablesAreOneTable requires the provhost\n169|// required-member table and the canonicalizer's exact-member\n170|// list for the identity record to carry the same members in the\n171|// same order: multi-missing determinism is shared behavior.\n172|func TestIdentityMemberTablesAreOneTable(t *testing.T) {\n173|\tmine := deriveRequiredList(t, \"provhost\", \"identity.go\", \"identityRequired\")\n174|\ttheirs := deriveIdentityExactMembers(t)\n175|\tif len(mine) != len(theirs) {\n176|\t\tt.Fatalf(\"identity member tables differ in size:\\nprovhost: %q\\ncanonicaljson: %q\", mine, theirs)\n177|\t}\n178|\tfor index := range mine {\n179|\t\tif mine[index] != theirs[index] {\n180|\t\t\tt.Fatalf(\"identity member tables differ at %d:\\nprovhost: %q\\ncanonicaljson: %q\", index, mine, theirs)\n181|\t\t}\n182|\t}\n183|}\n184|\n185|// deriveIdentityExactMembers derives the member list from the\n186|// requireExactMembers call for the Provider Identity Record in\n187|// canonicaljson production.\n188|func deriveIdentityExactMembers(t *testing.T) []string {\n189|\tt.Helper()\n190|\tpath := mustInternalRoot(t) + \"/canonicaljson/core_records.go\"\n191|\tsource, err := os.ReadFile(path)\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"identity members: %v\", err)\n194|\t}\n195|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"identity members: %v\", err)\n198|\t}\n199|\tfound := false\n200|\tvar members []string\n201|\tast.Inspect(syntax, func(node ast.Node) bool {\n202|\t\tcall, ok := node.(*ast.CallExpr)\n203|\t\tif !ok || found {\n204|\t\t\treturn true\n205|\t\t}\n206|\t\ttarget, ok := call.Fun.(*ast.Ident)\n207|\t\tif !ok || target.Name != \"requireExactMembers\" || len(call.Args) < 3 {\n208|\t\t\treturn true\n209|\t\t}\n210|\t\tfirst, ok := call.Args[0].(*ast.BasicLit)\n211|\t\tif !ok || strings.Trim(first.Value, `\"`) != \"Provider Identity Record\" {\n212|\t\t\treturn true\n213|\t\t}\n214|\t\tfor _, arg := range call.Args[2:] {\n215|\t\t\tliteral, ok := arg.(*ast.BasicLit)\n216|\t\t\tif !ok {\n217|\t\t\t\tt.Fatalf(\"identity members: exact-member list is not literals; the extractor cannot see through indirection\")\n218|\t\t\t}\n219|\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n220|\t\t}\n221|\t\tfound = true\n222|\t\treturn false\n223|\t})\n224|\tif !found {\n225|\t\tt.Fatal(\"identity members: requireExactMembers call for the Provider Identity Record not found; the extractor is blind\")\n226|\t}\n227|\treturn members\n228|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
