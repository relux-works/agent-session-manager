{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b9","stream":{"kind":"session","id":"01a0764e-74b6-77d0-9ee6-e35ef3cb7d7b"},"sequence":439,"recorded_at":1780531400000873,"record_type":"event","durability":"durable","causation_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"276b1149-e86f-43f0-8fdc-b471b62d760b","run_stream":{"kind":"run","id":"276b1149-e86f-43f0-8fdc-b471b62d760b"},"task_stream":{"kind":"task","id":"a837f7a8-b295-4c2b-9005-4f5a01e8e1c3"},"task_id":"a837f7a8-b295-4c2b-9005-4f5a01e8e1c3","event":{"kind":"output","task_id":"a837f7a8-b295-4c2b-9005-4f5a01e8e1c3","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/environ/identity_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file is the Provider Identity agreement battery. Two\n16|// validators implement the Section 5.5 shape rule-for-rule:\n17|// provhost.CheckIdentity mints provider-stdio refusals while\n18|// canonicaljson validates the same record through the closed\n19|// identity shape on the way to its object identity. A shape-rule\n20|// change must land in both validators in the same change, and\n21|// this battery is what fails when it lands in only one: every\n22|// row drives one shared vector through both production entries\n23|// and requires identical verdicts with the full rendering on\n24|// each side.\n25|//\n26|// One split is by design, not drift: provider equality (the\n27|// record naming the expected provider) is a caller-correlation\n28|// rule the host enforces, not a content rule the identity\n29|// calculation owns. The another-provider row ledgers that split\n30|// exactly — provhost refuses invalid_config while the\n31|// canonicalizer accepts — so a content-rule divergence cannot\n32|// hide behind it and a change to the split reddens here.\n33|\n34|// identityRow is one agreement vector: the body, the provhost\n35|// rule phrase, and the canonicalizer rule phrase. Empty phrases\n36|// mean both entries accept.\n37|type identityRow struct {\n38|\tname      string\n39|\tbody      []byte\n40|\tprovText  string\n41|\tcanonText string\n42|}\n43|\n44|// identityCorpus mutates each identity member alone against an\n45|// otherwise-valid record over the shared fixture identities.\n46|func identityCorpus(t *testing.T) []identityRow {\n47|\tt.Helper()\n48|\tvalid := validIdentityJSON()\n49|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n50|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n51|\totherSubject := jsonQuote(fixtureCreatorHostID)\n52|\treturn []identityRow{\n53|\t\t{\"valid\", valid, \"\", \"\"},\n54|\t\t{\"unknown member\", appendMember(t, valid, \"score\", `1`), \"identity carries unknown member\", \"unknown member\"},\n55|\t\t{\"missing opaque\", drop(\"opaque_identity\"), \"identity misses a required member\", \"required member\"},\n56|\t\t// Schema dispatch precedes shape validation in the\n57|\t\t// canonicalizer: a wrong schema or version refuses at\n58|\t\t// the dispatch registry, never reaching the identity\n59|\t\t// rules provhost enforces as member arms. Same\n60|\t\t// verdict, different arm by construction; a schema\n61|\t\t// change must update the dispatch registry and both\n62|\t\t// validators together.\n63|\t\t{\"wrong schema\", set(\"schema\", `\"urn:ax:schema:provider-manifest\"`), \"identity schema is not the provider identity\", \"has no supported immutable self-identity contract\"},\n64|\t\t{\"wrong version\", set(\"schema_version\", `\"1.1.0\"`), \"identity schema_version is not 1.0.0\", \"has no supported immutable self-identity contract\"},\n65|\t\t{\"bad record digest\", set(\"record_id\", `\"sha256:zzzz\"`), \"identity record_id is not a digest\", \"record_id\"},\n66|\t\t{\"bad subject uuid\", set(\"subject_id\", `\"not-a-uuid\"`), \"identity subject_id is not a UUIDv7\", \"subject_id\"},\n67|\t\t{\"subject differs\", set(\"subject_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n68|\t\t{\"session differs\", set(\"session_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n69|\t\t{\"bad provider grammar\", set(\"provider_id\", `\"Antigravity\"`), \"identity provider_id is not a provider id\", \"provider_id\"},\n70|\t\t{\"empty version\", set(\"provider_version\", `\"\"`), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n71|\t\t{\"long version\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n72|\t\t{\"empty range\", set(\"provider_version_range\", `\"\"`), \"identity provider_version_range is not 1..256 characters\", \"provider_version_range\"},\n73|\t\t{\"empty native id\", set(\"native_session_id\", `\"\"`), \"identity native_session_id is not 1..512 characters\", \"native_session_id\"},\n74|\t\t{\"unknown kind\", set(\"identity_kind\", `\"telepathy\"`), \"identity kind is not a registry member\", \"identity_kind\"},\n75|\t\t{\"bad workspace uuid\", set(\"logical_workspace_id\", `\"not-a-uuid\"`), \"identity workspace is not a UUIDv7\", \"logical_workspace_id\"},\n76|\t\t{\"bad realm\", set(\"backend_realm_fingerprint\", `\"sha256:zzzz\"`), \"identity realm is not a digest or null\", \"backend_realm_fingerprint\"},\n77|\t\t{\"null realm refused\", set(\"backend_realm_fingerprint\", `null`), \"identity realm is required for this backend kind\", \"must be non-null for Antigravity\"},\n78|\t\t{\"opaque array refused\", set(\"opaque_identity\", `[]`), \"not a JSON object\", \"opaque_identity\"},\n79|\t\t{\"opaque 33 keys refused\", set(\"opaque_identity\", opaqueKeysJSON(33)), \"exceeds 32 entries\", \"exceeds maximum length 32\"},\n80|\t\t{\"opaque bad key\", set(\"opaque_identity\", `{\"K\":\"v\"}`), \"identity opaque key is not a provider key\", \"must match\"},\n81|\t\t{\"opaque empty value\", set(\"opaque_identity\", `{\"k\":\"\"}`), \"identity opaque value is not 1..1024 characters\", \"1..1024\"},\n82|\t\t{\"opaque absolute path\", set(\"opaque_identity\", `{\"k\":\"/etc/passwd\"}`), \"begins with an absolute path\", \"must not begin with an absolute path\"},\n83|\t\t{\"bad creator uuid\", set(\"created_by_host_id\", `\"not-a-uuid\"`), \"identity host is not a UUIDv7\", \"created_by_host_id\"},\n84|\t\t{\"bad timestamp\", set(\"created_at\", `\"yesterday\"`), \"identity timestamp is not a timestamp\", \"created_at\"},\n85|\t\t{\"extensions array refused\", set(\"extensions\", `[]`), \"identity extensions is not an object\", \"extensions\"},\n86|\t\t{\"lone escape refused\", set(\"opaque_identity\", `{\"k\":\"A`+rawLoneHigh+`B\"}`), \"lone surrogate escape\", \"surrogate\"},\n87|\t\t{\"escaped text admits\", set(\"opaque_identity\", `{\"k\":\"A`+rawEscapedHigh+`B\"}`), \"\", \"\"},\n88|\t}\n89|}\n90|\n91|// Raw escape fragments. rawLoneHigh is a real lone high escape\n92|// in JSON source; rawEscapedHigh is an escaped backslash\n93|// followed by text, which carries no escape at all. Both are\n94|// package variables (not literals) so the Go compiler never\n95|// sees an invalid \\u escape in source.\n96|var (\n97|\trawLoneHigh    = \"\\\\ud800\"\n98|\trawEscapedHigh = \"\\\\\\\\ud800\"\n99|)\n100|\n101|// opaqueKeysJSON builds an opaque_identity object with count\n102|// grammar-valid keys.\n103|func opaqueKeysJSON(count int) string {\n104|\tparts := make([]string, 0, count)\n105|\tfor index := 0; index < count; index++ {\n106|\t\tparts = append(parts, `\"k`+twoDigits(index)+`\":\"v\"`)\n107|\t}\n108|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n109|}\n110|\n111|func twoDigits(value int) string {\n112|\tdigits := \"0123456789\"\n113|\treturn string([]byte{digits[value/10%10], digits[value%10]})\n114|}\n115|\n116|// TestIdentityAgreementAcrossValidators drives the corpus\n117|// through both identity entries and requires identical verdicts\n118|// with the full rule rendering on each side.\n119|func TestIdentityAgreementAcrossValidators(t *testing.T) {\n120|\tfor _, row := range identityCorpus(t) {\n121|\t\tt.Run(row.name, func(t *testing.T) {\n122|\t\t\tprovErr := provhost.CheckIdentity(row.body, \"antigravity\")\n123|\t\t\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(row.body)\n124|\t\t\tif row.provText == \"\" && row.canonText == \"\" {\n125|\t\t\t\tif provErr != nil {\n126|\t\t\t\t\tt.Fatalf(\"provhost refused %s: %v\", row.body, provErr)\n127|\t\t\t\t}\n128|\t\t\t\tif canonErr != nil {\n129|\t\t\t\t\tt.Fatalf(\"canonicaljson refused %s: %v\", row.body, canonErr)\n130|\t\t\t\t}\n131|\t\t\t\treturn\n132|\t\t\t}\n133|\t\t\tif provErr == nil {\n134|\t\t\t\tt.Fatalf(\"provhost admitted %s, want rule %q\", row.body, row.provText)\n135|\t\t\t}\n136|\t\t\tif canonErr == nil {\n137|\t\t\t\tt.Fatalf(\"canonicaljson admitted %s, want rule %q\", row.body, row.canonText)\n138|\t\t\t}\n139|\t\t\tif !strings.Contains(provErr.Error(), row.provText) {\n140|\t\t\t\tt.Fatalf(\"provhost error = %v, want rule %q\", provErr, row.provText)\n141|\t\t\t}\n142|\t\t\tif !strings.Contains(canonErr.Error(), row.canonText) {\n143|\t\t\t\tt.Fatalf(\"canonicaljson error = %v, want rule %q\", canonErr, row.canonText)\n144|\t\t\t}\n145|\t\t})\n146|\t}\n147|}\n148|\n149|// TestIdentityProviderEqualityIsCallerRule ledgers the one\n150|// by-design split: a well-formed record for another provider is\n151|// a caller-correlation failure (invalid_config) at the host,\n152|// while the identity calculation accepts the content. Neither\n153|// side may change its half silently.\n154|func TestIdentityProviderEqualityIsCallerRule(t *testing.T) {\n155|\tbody := mutateMember(t, validIdentityJSON(), \"provider_id\", `\"codex\"`)\n156|\tprovErr := provhost.CheckIdentity(body, \"antigravity\")\n157|\tif provErr == nil {\n158|\t\tt.Fatalf(\"provhost admitted a record for another provider\")\n159|\t}\n160|\tif !strings.Contains(provErr.Error(), \"identity names another provider\") {\n161|\t\tt.Fatalf(\"provhost error = %v, want the caller-correlation arm\", provErr)\n162|\t}\n163|\tif _, _, canonErr := canonicaljson.CalculateObjectIdentity(body); canonErr != nil {\n164|\t\tt.Fatalf(\"canonicaljson refused well-formed content for another provider: %v\", canonErr)\n165|\t}\n166|}\n167|\n168|// TestIdentityMemberTablesAreOneTable requires the provhost\n169|// required-member table and the canonicalizer's exact-member\n170|// list for the identity record to carry the same members in the\n171|// same order: multi-missing determinism is shared behavior.\n172|func TestIdentityMemberTablesAreOneTable(t *testing.T) {\n173|\tmine := deriveRequiredList(t, \"provhost\", \"identity.go\", \"identityRequired\")\n174|\ttheirs := deriveIdentityExactMembers(t)\n175|\tif len(mine) != len(theirs) {\n176|\t\tt.Fatalf(\"identity member tables differ in size:\\nprovhost: %q\\ncanonicaljson: %q\", mine, theirs)\n177|\t}\n178|\tfor index := range mine {\n179|\t\tif mine[index] != theirs[index] {\n180|\t\t\tt.Fatalf(\"identity member tables differ at %d:\\nprovhost: %q\\ncanonicaljson: %q\", index, mine, theirs)\n181|\t\t}\n182|\t}\n183|}\n184|\n185|// deriveIdentityExactMembers derives the member list from the\n186|// requireExactMembers call for the Provider Identity Record in\n187|// canonicaljson production.\n188|func deriveIdentityExactMembers(t *testing.T) []string {\n189|\tt.Helper()\n190|\tpath := mustInternalRoot(t) + \"/canonicaljson/core_records.go\"\n191|\tsource, err := os.ReadFile(path)\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"identity members: %v\", err)\n194|\t}\n195|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"identity members: %v\", err)\n198|\t}\n199|\tfound := false\n200|\tvar members []string\n201|\tast.Inspect(syntax, func(node ast.Node) bool {\n202|\t\tcall, ok := node.(*ast.CallExpr)\n203|\t\tif !ok || found {\n204|\t\t\treturn true\n205|\t\t}\n206|\t\ttarget, ok := call.Fun.(*ast.Ident)\n207|\t\tif !ok || target.Name != \"requireExactMembers\" || len(call.Args) < 3 {\n208|\t\t\treturn true\n209|\t\t}\n210|\t\tfirst, ok := call.Args[0].(*ast.BasicLit)\n211|\t\tif !ok || strings.Trim(first.Value, `\"`) != \"Provider Identity Record\" {\n212|\t\t\treturn true\n213|\t\t}\n214|\t\tfor _, arg := range call.Args[2:] {\n215|\t\t\tliteral, ok := arg.(*ast.BasicLit)\n216|\t\t\tif !ok {\n217|\t\t\t\tt.Fatalf(\"identity members: exact-member list is not literals; the extractor cannot see through indirection\")\n218|\t\t\t}\n219|\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n220|\t\t}\n221|\t\tfound = true\n222|\t\treturn false\n223|\t})\n224|\tif !found {\n225|\t\tt.Fatal(\"identity members: requireExactMembers call for the Provider Identity Record not found; the extractor is blind\")\n226|\t}\n227|\treturn members\n228|}"}}}
