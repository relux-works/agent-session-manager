{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c545","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":253,"recorded_at":1780531400000501,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"a03e07c4-94f6-4848-b375-fb5d9054c4d5"},"task_id":"a03e07c4-94f6-4848-b375-fb5d9054c4d5","event":{"kind":"output","task_id":"a03e07c4-94f6-4848-b375-fb5d9054c4d5","chunk":"Read text file `internal/environ/census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the shared-implementation census. The story's\n15|// premise is that the Provider, Session Adapter, and Directory\n16|// Node facades sit on one environment library; today each facade\n17|// carries its own copy of the shared rules, and independent\n18|// copies of the same rule drift in ways no per-facade reviewer\n19|// can see. This census is the boundary that fails when the\n20|// facades diverge: it derives every shared-rule implementation\n21|// from production source and requires the derived set to equal\n22|// the ledger below exactly.\n23|//\n24|// A new copy of a shared rule — a fourth facade\n25|// decodeStrictObject, a third surrogate-gate spelling, a new\n26|// string-measure helper — fails here as an unregistered site.\n27|// Removing or renaming a ledgered implementation orphans its row\n28|// and fails too. An empty scan fails closed. The ledger records\n29|// the single canonical owner per rule (this package, or scalar\n30|// where the grammar already has one) plus the copies this leaf\n31|// may not edit; each copy names the battery file that pins it to\n32|// the canonical semantics, and the escaped-backslash ledger in\n33|// the frame battery proves the battery observes facade\n34|// differences rather than asserting them away.\n35|//\n36|// Scope. The scan covers the story packages (environ, provider,\n37|// provhost, sessadapter, dirnode) plus the grammar owners\n38|// (scalar, canonicaljson). Copies in config, cliresult,\n39|// terminalbackend, axerror, and the other stories' packages are\n40|// outside this story's ownership: each package derives its own\n41|// inventories in its own test files, and gating another story's\n42|// package from here would couple stories that must land\n43|// independently. That exclusion is a stated bound, not a blind\n44|// spot: the scan fails closed inside its scope, and a copy that\n45|// moves into scope (a new definition in a scanned package)\n46|// fails as unregistered.\n47|\n48|// sharedSite is one derived shared-rule implementation.\n49|type sharedSite struct {\n50|\tclass  string\n51|\tpkg    string\n52|\tfile   string\n53|\tsymbol string\n54|}\n55|\n56|// sharedSiteKey renders the ledger key for one site.\n57|func (site sharedSite) sharedSiteKey() string {\n58|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n59|}\n60|\n61|// censusPackages is the exact scan scope. A production file in\n62|// any other package is outside this story's jurisdiction.\n63|var censusPackages = map[string]bool{\n64|\t\"environ\":       true,\n65|\t\"provider\":      true,\n66|\t\"provhost\":      true,\n67|\t\"sessadapter\":   true,\n68|\t\"dirnode\":       true,\n69|\t\"scalar\":        true,\n70|\t\"canonicaljson\": true,\n71|}\n72|\n73|// sharedLedger maps every known shared-rule implementation to\n74|// the rationale that keeps it honest. Canonical owners are the\n75|// single implementation new code must use; every other row names\n76|// the battery file that pins the copy to the canonical\n77|// semantics.\n78|var sharedLedger = map[string]string{\n79|\t// Frame decoders: one JSON entry point per package.\n80|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":     \"canonical owner: string-walk surrogate semantics, rune measure\",\n81|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\":  \"pinned by frame_agreement_test.go\",\n82|\t\"strict-decoder|sessadapter|decode.go|decodeStrictObject\": \"byte-frozen leaf 1: pinned by frame_agreement_test.go\",\n83|\t\"strict-decoder|dirnode|decode.go|decodeStrictObject\":     \"byte-frozen leaf 2: pinned by frame_agreement_test.go\",\n84|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\":  \"canonicalizer entry: distinct JCS pipeline role, surrogate verdicts pinned by frame_agreement_test.go\",\n85|\t// Lone-surrogate gates.\n86|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n87|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n88|\t\"surrogate-gate|sessadapter|decode.go|hasLoneSurrogateEscape\":        \"byte-frozen leaf 1: raw scan, escaped-backslash divergence ledgered in frame_agreement_test.go\",\n89|\t\"surrogate-gate|dirnode|decode.go|hasLoneSurrogateEscape\":            \"byte-frozen leaf 2: raw scan, escaped-backslash divergence ledgered in frame_agreement_test.go\",\n90|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n91|\t// String measures.\n92|\t\"string-measure|environ|decode.go|StringLength\":     \"canonical owner: runes per Section 1.6\",\n93|\t\"string-measure|provhost|opdecode.go|runeLength\":    \"runes, pinned by measure_agreement_test.go\",\n94|\t\"string-measure|sessadapter|decode.go|stringLength\": \"byte-frozen leaf 1: runes, pinned by measure_agreement_test.go\",\n95|\t\"string-measure|dirnode|decode.go|stringLength\":     \"byte-frozen leaf 2: runes, pinned by measure_agreement_test.go\",\n96|\t// Identity validators: two refusal dialects over one rule.\n97|\t\"identity-validator|provhost|identity.go|CheckIdentity\":                           \"provider-stdio refusal dialect, pinned by identity_agreement_test.go\",\n98|\t\"identity-validator|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"identity refusal dialect, pinned by identity_agreement_test.go\",\n99|}\n100|\n101|// sharedFunctionSymbols maps a function name to its census\n102|// class.\n103|var sharedFunctionSymbols = map[string]string{\n104|\t\"decodeStrictObject\":             \"strict-decoder\",\n105|\t\"DecodeStrictObject\":             \"strict-decoder\",\n106|\t\"decodeStrict\":                   \"strict-decoder\",\n107|\t\"hasLoneSurrogateEscape\":         \"surrogate-gate\",\n108|\t\"HasLoneSurrogateEscape\":         \"surrogate-gate\",\n109|\t\"validateSurrogateEscapes\":       \"surrogate-gate\",\n110|\t\"stringLength\":                   \"string-measure\",\n111|\t\"runeLength\":                     \"string-measure\",\n112|\t\"StringLength\":                   \"string-measure\",\n113|\t\"CheckIdentity\":                  \"identity-validator\",\n114|\t\"validateProviderIdentityRecord\": \"identity-validator\",\n115|}\n116|\n117|// grammarSymbols maps a package-level variable name to its\n118|// grammar class. Only same-rule grammars share a class: the\n119|// three capabilityOrder tables (directory eight, adapter\n120|// fifteen, provider seven) and the per-major platform tables are\n121|// deliberately absent here and are pinned by literal-list\n122|// derivation in grammar_test.go instead, where the rule identity\n123|// travels with the comparison.\n124|var grammarSymbols = map[string]string{\n125|\t\"environmentIDPattern\": \"env-id-grammar\",\n126|\t\"semverPattern\":        \"semver-grammar\",\n127|\t\"reverseDNSPattern\":    \"extensions-grammar\",\n128|\t\"providerIDPattern\":    \"provider-id-grammar\",\n129|}\n130|\n131|// deriveSharedSites scans every production Go file in the census\n132|// packages for shared-rule implementations. Test files are never\n133|// scanned: a helper in a test is not a production copy. An\n134|// unreadable file or a parse failure fails closed: a scanner that\n135|// cannot read a file must not report the file as clean.\n136|func deriveSharedSites(t *testing.T) map[string]bool {\n137|\tt.Helper()\n138|\tsites := map[string]bool{}\n139|\tfor _, site := range scanSharedSymbols(t, sharedFunctionSymbols, true) {\n140|\t\tsites[site] = true\n141|\t}\n142|\tif len(sites) == 0 {\n143|\t\tt.Fatal(\"census derived zero shared-rule sites from a tree known to duplicate them; the scanner is blind, not the tree clean\")\n144|\t}\n145|\treturn sites\n146|}\n147|\n148|// scanSharedSymbols scans the census packages for function or\n149|// package-level variable definitions whose names appear in the\n150|// symbol map, and returns ledger keys for each hit.\n151|func scanSharedSymbols(t *testing.T, symbols map[string]string, functions bool) []string {\n152|\tt.Helper()\n153|\troot, err := internalRoot(t)\n154|\tif err != nil {\n155|\t\tt.Fatalf(\"census: %v\", err)\n156|\t}\n157|\tvar keys []string\n158|\tcount := 0\n159|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n164|\t\t\treturn nil\n165|\t\t}\n166|\t\trel, err := filepath.Rel(root, path)\n167|\t\tif err != nil {\n168|\t\t\treturn err\n169|\t\t}\n170|\t\tparts := strings.Split(rel, string(filepath.Separator))\n171|\t\tpkg := parts[0]\n172|\t\tif !censusPackages[pkg] {\n173|\t\t\treturn nil\n174|\t\t}\n175|\t\tcount++\n176|\t\tsource, err := os.ReadFile(path)\n177|\t\tif err != nil {\n178|\t\t\tt.Fatalf(\"census: read %s: %v\", path, err)\n179|\t\t}\n180|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"census: parse %s: %v\", path, err)\n183|\t\t}\n184|\t\tfile := parts[len(parts)-1]\n185|\t\tfor _, decl := range syntax.Decls {\n186|\t\t\tswitch node := decl.(type) {\n187|\t\t\tcase *ast.FuncDecl:\n188|\t\t\t\tif !functions || node.Name == nil {\n189|\t\t\t\t\tcontinue\n190|\t\t\t\t}\n191|\t\t\t\tif class, ok := symbols[node.Name.Name]; ok {\n192|\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, node.Name.Name}.sharedSiteKey())\n193|\t\t\t\t}\n194|\t\t\tcase *ast.GenDecl:\n195|\t\t\t\tif functions {\n196|\t\t\t\t\tcontinue\n197|\t\t\t\t}\n198|\t\t\t\tfor _, spec := range node.Specs {\n199|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n200|\t\t\t\t\tif !ok {\n201|\t\t\t\t\t\tcontinue\n202|\t\t\t\t\t}\n203|\t\t\t\t\tfor _, name := range value.Names {\n204|\t\t\t\t\t\tif class, ok := symbols[name.Name]; ok {\n205|\t\t\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, name.Name}.sharedSiteKey())\n206|\t\t\t\t\t\t}\n207|\t\t\t\t\t}\n208|\t\t\t\t}\n209|\t\t\t}\n210|\t\t}\n211|\t\treturn nil\n212|\t})\n213|\tif err != nil {\n214|\t\tt.Fatalf(\"census: walk: %v\", err)\n215|\t}\n216|\tif count == 0 {\n217|\t\tt.Fatal(\"census scanned zero files; the scanner is broken, not the tree\")\n218|\t}\n219|\treturn keys\n220|}\n221|\n222|// internalRoot returns the internal/ source root above this\n223|// package directory.\n224|func internalRoot(t *testing.T) (string, error) {\n225|\tt.Helper()\n226|\tdirectory, err := os.Getwd()\n227|\tif err != nil {\n228|\t\treturn \"\", err\n229|\t}\n230|\treturn filepath.Dir(directory), nil\n231|}\n232|\n233|// TestSharedImplementationsAreCensused requires the derived\n234|// implementation set to equal the ledger exactly: an unregistered\n235|// copy fails as a unification violation, and a row naming an\n236|// implementation production no longer derives fails as orphaned.\n237|func TestSharedImplementationsAreCensused(t *testing.T) {\n238|\tderived := deriveSharedSites(t)\n239|\tfor key := range derived {\n240|\t\tif _, ok := sharedLedger[key]; !ok {\n241|\t\t\tt.Errorf(\"unregistered shared-rule copy %q: add one canonical implementation in internal/environ instead, or ledger the divergence with its agreement battery\", key)\n242|\t\t}\n243|\t}\n244|\tfor key, rationale := range sharedLedger {\n245|\t\tif !derived[key] {\n246|\t\t\tt.Errorf(\"orphaned ledger row %q (%s): production no longer derives it\", key, rationale)\n247|\t\t}\n248|\t}\n249|}\n250|\n251|// grammarSiteLedger names every grammar definition site in the\n252|// census scope. A new grammar definition fails here even when it\n253|// carries an identical literal: a second copy is a second copy,\n254|// and the next edit drifts exactly one of them.\n255|var grammarSiteLedger = map[string]bool{\n256|\t\"env-id-grammar|environ|tuple.go|environmentIDPattern\":                true,\n257|\t\"env-id-grammar|sessadapter|decode.go|environmentIDPattern\":           true,\n258|\t\"env-id-grammar|dirnode|decode.go|environmentIDPattern\":               true,\n259|\t\"env-id-grammar|canonicaljson|closed_shapes.go|environmentIDPattern\":  true,\n260|\t\"semver-grammar|environ|tuple.go|semverPattern\":                       true,\n261|\t\"semver-grammar|sessadapter|decode.go|semverPattern\":                  true,\n262|\t\"semver-grammar|dirnode|decode.go|semverPattern\":                      true,\n263|\t\"semver-grammar|canonicaljson|closed_shapes.go|semverPattern\":         true,\n264|\t\"semver-grammar|provhost|manifest.go|semverPattern\":                   true,\n265|\t\"extensions-grammar|environ|decode.go|reverseDNSPattern\":              true,\n266|\t\"extensions-grammar|sessadapter|decode.go|reverseDNSPattern\":          true,\n267|\t\"extensions-grammar|dirnode|decode.go|reverseDNSPattern\":              true,\n268|\t\"extensions-grammar|canonicaljson|closed_shapes.go|reverseDNSPattern\": true,\n269|\t\"provider-id-grammar|scalar|names.go|providerIDPattern\":               true,\n270|\t\"provider-id-grammar|provhost|manifest.go|providerIDPattern\":          true,\n271|\t\"provider-id-grammar|sessadapter|decode.go|providerIDPattern\":         true,\n272|\t\"provider-id-grammar|dirnode|query.go|providerIDPattern\":              true,\n273|}\n274|\n275|// deriveGrammarLiterals derives the regex literal behind every\n276|// grammar definition in the census scope, keyed by ledger key.\n277|// Two definitions carrying different literals are different\n278|// languages even when the symbol name matches; the grammar\n279|// battery requires one literal per class.\n280|func deriveGrammarLiterals(t *testing.T) (map[string]map[string]bool, map[string]bool) {\n281|\tt.Helper()\n282|\troot, err := internalRoot(t)\n283|\tif err != nil {\n284|\t\tt.Fatalf(\"grammar: %v\", err)\n285|\t}\n286|\tliterals := map[string]map[string]bool{}\n287|\tsites := map[string]bool{}\n288|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n289|\t\tif err != nil {\n290|\t\t\treturn err\n291|\t\t}\n292|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n293|\t\t\treturn nil\n294|\t\t}\n295|\t\trel, err := filepath.Rel(root, path)\n296|\t\tif err != nil {\n297|\t\t\treturn err\n298|\t\t}\n299|\t\tparts := strings.Split(rel, string(filepath.Separator))\n300|\t\tpkg := parts[0]\n301|\t\tif !censusPackages[pkg] {\n302|\t\t\treturn nil\n303|\t\t}\n304|\t\tsource, err := os.ReadFile(path)\n305|\t\tif err != nil {\n306|\t\t\tt.Fatalf(\"grammar: read %s: %v\", path, err)\n307|\t\t}\n308|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n309|\t\tif err != nil {\n310|\t\t\tt.Fatalf(\"grammar: parse %s: %v\", path, err)\n311|\t\t}\n312|\t\tfor _, decl := range syntax.Decls {\n313|\t\t\tnode, ok := decl.(*ast.GenDecl)\n314|\t\t\tif !ok {\n315|\t\t\t\tcontinue\n316|\t\t\t}\n317|\t\t\tfor _, spec := range node.Specs {\n318|\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n319|\t\t\t\tif !ok || len(value.Names) != 1 || len(value.Values) != 1 {\n320|\t\t\t\t\tcontinue\n321|\t\t\t\t}\n322|\t\t\t\tclass, ok := grammarSymbols[value.Names[0].Name]\n323|\t\t\t\tif !ok {\n324|\t\t\t\t\tcontinue\n325|\t\t\t\t}\n326|\t\t\t\tcall, ok := value.Values[0].(*ast.CallExpr)\n327|\t\t\t\tif !ok || len(call.Args) != 1 {\n328|\t\t\t\t\tt.Fatalf(\"grammar: %s %s is not a MustCompile literal; the extractor cannot see through indirection\", path, value.Names[0].Name)\n329|\t\t\t\t}\n330|\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n331|\t\t\t\tif !ok {\n332|\t\t\t\t\tt.Fatalf(\"grammar: %s %s pattern is not a literal; the extractor cannot see through indirection\", path, value.Names[0].Name)\n333|\t\t\t\t}\n334|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n335|\t\t\t\tif err != nil {\n336|\t\t\t\t\tt.Fatalf(\"grammar: %s: %v\", path, err)\n337|\t\t\t\t}\n338|\t\t\t\tif literals[class] == nil {\n339|\t\t\t\t\tliterals[class] = map[string]bool{}\n340|\t\t\t\t}\n341|\t\t\t\tliterals[class][text] = true\n342|\t\t\t\tsites[sharedSite{class, pkg, parts[len(parts)-1], value.Names[0].Name}.sharedSiteKey()] = true\n343|\t\t\t}\n344|\t\t}\n345|\t\treturn nil\n346|\t})\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"grammar: walk: %v\", err)\n349|\t}\n350|\treturn literals, sites\n351|}\n352|\n353|// TestSharedGrammarsAreOneLanguage requires every grammar in the\n354|// census scope to carry the identical regex literal: same symbol\n355|// with different literals would be two languages under one name,\n356|// and a mutant rewriting one copy's literal reddens here.\n357|func TestSharedGrammarsAreOneLanguage(t *testing.T) {\n358|\tliterals, sites := deriveGrammarLiterals(t)\n359|\tfor key := range sites {\n360|\t\tif !grammarSiteLedger[key] {\n361|\t\t\tt.Errorf(\"unregistered grammar copy %q: one language means one definition site per package at most\", key)\n362|\t\t}\n363|\t}\n364|\tfor key := range grammarSiteLedger {\n365|\t\tif !sites[key] {\n366|\t\t\tt.Errorf(\"orphaned grammar row %q: production no longer derives it\", key)\n367|\t\t}\n368|\t}\n369|\tfor class, texts := range literals {\n370|\t\tif len(texts) != 1 {\n371|\t\t\tvar variants []string\n372|\t\t\tfor text := range texts {\n373|\t\t\t\tvariants = append(variants, strconv.Quote(text))\n374|\t\t\t}\n375|\t\t\tt.Errorf(\"grammar class %q has %d distinct literals: %s\", class, len(texts), strings.Join(variants, \" vs \"))\n376|\t\t}\n377|\t}\n378|\tif len(literals) != len(grammarSymbols) {\n379|\t\tt.Fatalf(\"grammar: derived %d classes, want %d; the extractor is blind, not the tree clean\", len(literals), len(grammarSymbols))\n380|\t}\n381|}"}}}
