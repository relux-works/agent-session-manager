{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a9","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":303,"recorded_at":1780531400000601,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"476eac26-8530-4dea-8fb1-9735c8151a47"},"task_id":"476eac26-8530-4dea-8fb1-9735c8151a47","event":{"kind":"output","task_id":"476eac26-8530-4dea-8fb1-9735c8151a47","chunk":"Read text file `internal/environ/frame_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n17|)\n18|\n19|// This file is the cross-facade frame-agreement battery. Every\n20|// Section 7.8, 7.9, and provider-protocol body crosses a strict\n21|// object decoder before any member is trusted, and each facade\n22|// carries its own copy of that decoder (ledgered in\n23|// census_test.go). The battery drives one shared corpus through\n24|// all five judges — environ.DecodeStrictObject,\n25|// sessadapter.DecodeTuple, dirnode.CheckScanRequest,\n26|// provhost.DecodeManifest, and canonicaljson.Canonicalize — and\n27|// requires the ledgered verdict at each.\n28|//\n29|// A row whose reached arm cannot be determined fails, never\n30|// passes: frame-fault rows assert the full rendering (the fault\n31|// detail phrase in the refusal text), and accept rows assert the\n32|// body travels past the frame gate (an accept, or a refusal at a\n33|// named later arm with the frame phrase asserted absent). A code\n34|//-only assertion would conflate the frame gate with the member\n35|// gates behind it, which carry the same refusal code.\n36|//\n37|// The roster fails closed in both directions: every fault detail\n38|// derived from environ production must own at least one row, and\n39|// a row naming a detail production no longer derives fails as\n40|// orphaned. Expected verdicts are ledgered per judge, so a\n41|// verdict flip in EITHER direction — a fix or a regression —\n42|// reddens its row instead of passing silently.\n43|\n44|// frameRow is one corpus vector with the ledgered verdict at\n45|// every judge. A refuse expectation names the refusal text the\n46|// verdict must contain; an accept expectation names a later-arm\n47|// text the verdict must contain (\"\" with accept=true means the\n48|// entry itself accepts). canonicalRefuse nil means the\n49|// canonicalizer is not judged on this row: it validates JSON\n50|// values, not closed objects, so object-shape faults\n51|// (non-object, duplicate, trailing) are outside the decoder\n52|// rules it shares with the facades.\n53|type frameRow struct {\n54|\tfault string\n55|\tname  string\n56|\tbody  []byte\n57|\n58|\t// Per-judge bodies override body where an entry needs a\n59|\t// shaped vector (accept controls): nil means the shared\n60|\t// minimal body, which every frame gate refuses before any\n61|\t// member is read.\n62|\tsessBody []byte\n63|\tdirBody  []byte\n64|\tprovBody []byte\n65|\n66|\tenvironRefuse string\n67|\tenvironMember string\n68|\n69|\tsessAccept bool\n70|\tsessText   string\n71|\tsessAbsent string\n72|\n73|\tdirAccept bool\n74|\tdirText   string\n75|\tdirAbsent string\n76|\n77|\tprovAccept bool\n78|\tprovText   string\n79|\tprovAbsent string\n80|\n81|\tcanonicalRefuse *bool\n82|}\n83|\n84|func boolPointer(value bool) *bool {\n85|\treturn &value\n86|}\n87|\n88|// frameCorpus is the shared fault corpus. Surrogate subclasses\n89|// enumerate the full shape of the gate: bare highs and lows,\n90|// mispairs, truncated and malformed escapes, paired controls,\n91|// and backslash-run parity (runs of 1..3 backslashes before the\n92|// escape, in value, member-name, and nested positions). Run\n93|// parity is the exact shape of the recorded raw-scan divergence:\n94|// a string-aware walk consumes `\\\\` pairs, so a `\\u` sequence\n95|// behind an odd run is a real escape every judge refuses when\n96|// lone, while the same sequence behind an even run is quoted\n97|// text the raw byte scan still refuses. A raw scanner matches\n98|// every `\\u` byte pair regardless of string context.\n99|func frameCorpus() []frameRow {\n100|\tpairVersion := `\"environment_version\":\"A\\uD83D\\uDE00B\"`\n101|\tpairTuple := []byte(strings.Replace(validTupleJSON(), `\"environment_version\":\"2.1.0\"`, pairVersion, 1))\n102|\tpairCursor := validScanRequestJSON(`\"A\\uD83D\\uDE00B\"`)\n103|\trows := []frameRow{\n104|\t\t{\n105|\t\t\tfault: FaultNotUTF8, name: \"non-utf8 bytes\",\n106|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"a\\xff\\\"}\"),\n107|\t\t\tenvironRefuse: FaultNotUTF8,\n108|\t\t\tsessText:      FaultNotUTF8, dirText: FaultNotUTF8, provText: FaultNotUTF8,\n109|\t\t\tcanonicalRefuse: boolPointer(true),\n110|\t\t},\n111|\t\t{\n112|\t\t\tfault: FaultLoneSurrogate, name: \"bare high escape\",\n113|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\ud800B\\\"}\"),\n114|\t\t\tenvironRefuse: FaultLoneSurrogate,\n115|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n116|\t\t\tcanonicalRefuse: boolPointer(true),\n117|\t\t},\n118|\t\t{\n119|\t\t\tfault: FaultLoneSurrogate, name: \"bare low escape\",\n120|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\udc00B\\\"}\"),\n121|\t\t\tenvironRefuse: FaultLoneSurrogate,\n122|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n123|\t\t\tcanonicalRefuse: boolPointer(true),\n124|\t\t},\n125|\t\t{\n126|\t\t\tfault: FaultLoneSurrogate, name: \"high followed by non-low\",\n127|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83D\\\\u0041B\\\"}\"),\n128|\t\t\tenvironRefuse: FaultLoneSurrogate,\n129|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n130|\t\t\tcanonicalRefuse: boolPointer(true),\n131|\t\t},\n132|\t\t{\n133|\t\t\tfault: FaultNotObject, name: \"truncated escape falls to syntax\",\n134|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83\\\"}\"),\n135|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n136|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n137|\t\t\tcanonicalRefuse: boolPointer(true),\n138|\t\t},\n139|\t\t{\n140|\t\t\tfault: FaultNotObject, name: \"malformed escape falls to syntax\",\n141|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uDEFG B\\\"}\"),\n142|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n143|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n144|\t\t\tcanonicalRefuse: boolPointer(true),\n145|\t\t},\n146|\t\t{\n147|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run2\",\n148|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800B\\\"}\"),\n149|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n150|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n151|\t\t\tcanonicalRefuse: boolPointer(false),\n152|\t\t},\n153|\t\t{\n154|\t\t\t// Run 3 is an escaped backslash followed by a REAL\n155|\t\t\t// lone escape (value `A\\` plus U+D800), so every\n156|\t\t\t// judge refuses: odd runs escape, even runs quote.\n157|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run3\",\n158|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\\\\\ud800B\\\"}\"),\n159|\t\t\tenvironRefuse: FaultLoneSurrogate,\n160|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n161|\t\t\tcanonicalRefuse: boolPointer(true),\n162|\t\t},\n163|\t\t{\n164|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash low run2\",\n165|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\udc00B\\\"}\"),\n166|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n167|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n168|\t\t\tcanonicalRefuse: boolPointer(false),\n169|\t\t},\n170|\t\t{\n171|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash pair run2\",\n172|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\uD83D\\\\\\\\uDE00B\\\"}\"),\n173|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n174|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n175|\t\t\tcanonicalRefuse: boolPointer(false),\n176|\t\t},\n177|\t\t{\n178|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash in member name\",\n179|\t\t\tbody:     []byte(\"{\\\"A\\\\\\\\ud800B\\\":1}\"),\n180|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n181|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n182|\t\t\tcanonicalRefuse: boolPointer(false),\n183|\t\t},\n184|\t\t{\n185|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash nested\",\n186|\t\t\tbody:     []byte(\"{\\\"v\\\":{\\\"w\\\":\\\"A\\\\\\\\ud800B\\\"}}\"),\n187|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n188|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n189|\t\t\tcanonicalRefuse: boolPointer(false),\n190|\t\t},\n191|\t\t{\n192|\t\t\tfault: FaultDuplicate, name: \"duplicate member\",\n193|\t\t\tbody:          []byte(\"{\\\"v\\\":1,\\\"v\\\":2}\"),\n194|\t\t\tenvironRefuse: FaultDuplicate, environMember: \"v\",\n195|\t\t\tsessText: FaultDuplicate, dirText: FaultDuplicate, provText: FaultDuplicate,\n196|\t\t},\n197|\t\t{\n198|\t\t\tfault: FaultTrailing, name: \"trailing data\",\n199|\t\t\tbody:          []byte(\"{\\\"v\\\":1} {}\"),\n200|\t\t\tenvironRefuse: FaultTrailing,\n201|\t\t\tsessText:      FaultTrailing, dirText: FaultTrailing, provText: FaultTrailing,\n202|\t\t},\n203|\t\t{\n204|\t\t\tfault: FaultNotObject, name: \"non-object top level\",\n205|\t\t\tbody:          []byte(\"[1,2]\"),\n206|\t\t\tenvironRefuse: FaultNotObject,\n207|\t\t\tsessText:      FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n208|\t\t},\n209|\t\t{\n210|\t\t\tfault: FaultNotObject, name: \"unterminated string is syntax\",\n211|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"abc\"),\n212|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n213|\t\t\tsessText: FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n214|\t\t\tcanonicalRefuse: boolPointer(true),\n215|\t\t},\n216|\t\t{\n217|\t\t\tfault: FaultLoneSurrogate, name: \"paired surrogates admit\",\n218|\t\t\tbody:       []byte(`{\"v\":\"A\\uD83D\\uDE00B\"}`),\n219|\t\t\tsessBody:   pairTuple,\n220|\t\t\tdirBody:    pairCursor,\n221|\t\t\tprovBody:   []byte(`{\"note\":\"A\\uD83D\\uDE00B\"}`),\n222|\t\t\tsessAccept: true,\n223|\t\t\tdirAccept:  true,\n224|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n225|\t\t\tcanonicalRefuse: boolPointer(false),\n226|\t\t},\n227|\t\t{\n228|\t\t\tfault: FaultNotUTF8, name: \"multibyte text admits\",\n229|\t\t\tbody:       []byte(\"{\\\"v\\\":\\\"plain ü ☃\\\"}\"),\n230|\t\t\tsessBody:   pairTuple,\n231|\t\t\tdirBody:    pairCursor,\n232|\t\t\tprovBody:   []byte(\"{\\\"note\\\":\\\"plain ü ☃\\\"}\"),\n233|\t\t\tsessAccept: true,\n234|\t\t\tdirAccept:  true,\n235|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultNotUTF8,\n236|\t\t\tcanonicalRefuse: boolPointer(false),\n237|\t\t},\n238|\t}\n239|\treturn rows\n240|}\n241|\n242|// deriveFaultDetails derives the frame-fault space from environ\n243|// production: every Fault* constant value in decode.go. A sixth\n244|// fault shape fails the roster below instead of passing\n245|// unrostered.\n246|func deriveFaultDetails(t *testing.T) map[string]bool {\n247|\tt.Helper()\n248|\tpath := filepath.Join(mustGetwd(t), \"decode.go\")\n249|\tsource, err := os.ReadFile(path)\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"faults: %v\", err)\n252|\t}\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"faults: %v\", err)\n256|\t}\n257|\tdetails := map[string]bool{}\n258|\tfor _, decl := range syntax.Decls {\n259|\t\tnode, ok := decl.(*ast.GenDecl)\n260|\t\tif !ok {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tfor _, spec := range node.Specs {\n264|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n265|\t\t\tif !ok {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tfor index, name := range value.Names {\n269|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n270|\t\t\t\t\tcontinue\n271|\t\t\t\t}\n272|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n273|\t\t\t\tif !ok {\n274|\t\t\t\t\tt.Fatalf(\"faults: %s is not a literal; the extractor cannot see through indirection\", name.Name)\n275|\t\t\t\t}\n276|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n277|\t\t\t\tif err != nil {\n278|\t\t\t\t\tt.Fatalf(\"faults: %v\", err)\n279|\t\t\t\t}\n280|\t\t\t\tdetails[text] = true\n281|\t\t\t}\n282|\t\t}\n283|\t}\n284|\tif len(details) == 0 {\n285|\t\tt.Fatal(\"faults derived zero details; the scanner is blind, not the space empty\")\n286|\t}\n287|\treturn details\n288|}\n289|\n290|func mustGetwd(t *testing.T) string {\n291|\tt.Helper()\n292|\tdirectory, err := os.Getwd()\n293|\tif err != nil {\n294|\t\tt.Fatalf(\"frame: %v\", err)\n295|\t}\n296|\treturn directory\n297|}\n298|\n299|// TestFrameFaultRosterIsClosed requires every derived fault\n300|// detail to own at least one row, and every row to name a\n301|// derived detail.\n302|func TestFrameFaultRosterIsClosed(t *testing.T) {\n303|\tdetails := deriveFaultDetails(t)\n304|\tcovered := map[string]bool{}\n305|\tfor _, row := range frameCorpus() {\n306|\t\tif row.fault == \"\" {\n307|\t\t\tt.Fatalf(\"row %q names no fault detail\", row.name)\n308|\t\t}\n309|\t\tif !details[row.fault] {\n310|\t\t\tt.Fatalf(\"row %q names underived detail %q\", row.name, row.fault)\n311|\t\t}\n312|\t\tcovered[row.fault] = true\n313|\t}\n314|\tfor detail := range details {\n315|\t\tif !covered[detail] {\n316|\t\t\tt.Errorf(\"derived fault detail %q owns no corpus row\", detail)\n317|\t\t}\n318|\t}\n319|}\n320|\n321|// TestFrameAgreementAcrossFacades drives the shared corpus\n322|// through all five judges and requires the ledgered verdict at\n323|// each. environ rows assert the exact fault and member; facade\n324|// rows assert the full frame rendering (the detail phrase in the\n325|// refusal text) or, for accept rows, travel past the frame gate\n326|// with the frame phrase asserted absent; canonical rows assert\n327|// the verdict only, where the canonicalizer shares the rule.\n328|func TestFrameAgreementAcrossFacades(t *testing.T) {\n329|\tfor _, row := range frameCorpus() {\n330|\t\tt.Run(row.name, func(t *testing.T) {\n331|\t\t\t_, fault := DecodeStrictObject(row.body)\n332|\t\t\tif row.environRefuse == \"\" {\n333|\t\t\t\tif fault != nil {\n334|\t\t\t\t\tt.Fatalf(\"environ refused %q: %v\", row.body, fault)\n335|\t\t\t\t}\n336|\t\t\t} else {\n337|\t\t\t\tif fault == nil {\n338|\t\t\t\t\tt.Fatalf(\"environ admitted %q, want fault %q\", row.body, row.environRefuse)\n339|\t\t\t\t}\n340|\t\t\t\tif fault.Detail != row.environRefuse || fault.Member != row.environMember {\n341|\t\t\t\t\tt.Fatalf(\"environ fault = (%q, %q), want (%q, %q)\", fault.Detail, fault.Member, row.environRefuse, row.environMember)\n342|\t\t\t\t}\n343|\t\t\t}\n344|\t\t\tsessBody := orBody(row.body, row.sessBody)\n345|\t\t\tdirBody := orBody(row.body, row.dirBody)\n346|\t\t\tprovBody := orBody(row.body, row.provBody)\n347|\t\t\tassertFacadeVerdict(t, \"sessadapter\", sessBody, row.sessAccept, row.sessText, row.sessAbsent, func(body []byte) error {\n348|\t\t\t\t_, err := sessadapter.DecodeTuple(body)\n349|\t\t\t\treturn err\n350|\t\t\t})\n351|\t\t\tassertFacadeVerdict(t, \"dirnode\", dirBody, row.dirAccept, row.dirText, row.dirAbsent, func(body []byte) error {\n352|\t\t\t\t_, err := dirnode.CheckScanRequest(body)\n353|\t\t\t\treturn err\n354|\t\t\t})\n355|\t\t\tassertFacadeVerdict(t, \"provhost\", provBody, row.provAccept, row.provText, row.provAbsent, func(body []byte) error {\n356|\t\t\t\treturn provhost.DecodeManifest(body)\n357|\t\t\t})\n358|\t\t\tif row.canonicalRefuse != nil {\n359|\t\t\t\t_, err := canonicaljson.Canonicalize(row.body)\n360|\t\t\t\tif (*row.canonicalRefuse && err == nil) || (!*row.canonicalRefuse && err != nil) {\n361|\t\t\t\t\tt.Fatalf(\"canonicaljson verdict = refuse=%v, want refuse=%v (err=%v)\", err != nil, *row.canonicalRefuse, err)\n362|\t\t\t\t}\n363|\t\t\t}\n364|\t\t})\n365|\t}\n366|}\n367|\n368|// orBody selects the per-judge override body when present.\n369|func orBody(shared, override []byte) []byte {\n370|\tif override != nil {\n371|\t\treturn override\n372|\t}\n373|\treturn shared\n374|}\n375|\n376|// assertFacadeVerdict requires the ledgered verdict at one\n377|// facade entry: an accept, or a refusal whose text contains the\n378|// frame phrase (and never contains the absent phrase, which\n379|// pins travel past a gate the body must cross).\n380|func assertFacadeVerdict(t *testing.T, facade string, body []byte, accept bool, text, absent string, drive func([]byte) error) {\n381|\tt.Helper()\n382|\terr := drive(body)\n383|\tif accept {\n384|\t\tif err != nil {\n385|\t\t\tt.Fatalf(\"%s refused %q, want accept: %v\", facade, body, err)\n386|\t\t}\n387|\t\treturn\n388|\t}\n389|\tif err == nil {\n390|\t\tt.Fatalf(\"%s admitted %q, want refusal containing %q\", facade, body, text)\n391|\t}\n392|\tif text != \"\" && !strings.Contains(err.Error(), text) {\n393|\t\tt.Fatalf(\"%s error = %v, want text containing %q\", facade, err, text)\n394|\t}\n395|\tif absent != \"\" && strings.Contains(err.Error(), absent) {\n396|\t\tt.Fatalf(\"%s error = %v, must not contain %q\", facade, err, absent)\n397|\t}\n398|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ab","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":304,"recorded_at":1780531400000603,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"476eac26-8530-4dea-8fb1-9735c8151a47"},"task_id":"476eac26-8530-4dea-8fb1-9735c8151a47","event":{"kind":"completed","task_id":"476eac26-8530-4dea-8fb1-9735c8151a47"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ad","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":305,"recorded_at":1780531400000605,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"call_id":"call_01a076300e7f70d2936d6fdb22c4bfa7","text":"Read text file `internal/environ/frame_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n17|)\n18|\n19|// This file is the cross-facade frame-agreement battery. Every\n20|// Section 7.8, 7.9, and provider-protocol body crosses a strict\n21|// object decoder before any member is trusted, and each facade\n22|// carries its own copy of that decoder (ledgered in\n23|// census_test.go). The battery drives one shared corpus through\n24|// all five judges — environ.DecodeStrictObject,\n25|// sessadapter.DecodeTuple, dirnode.CheckScanRequest,\n26|// provhost.DecodeManifest, and canonicaljson.Canonicalize — and\n27|// requires the ledgered verdict at each.\n28|//\n29|// A row whose reached arm cannot be determined fails, never\n30|// passes: frame-fault rows assert the full rendering (the fault\n31|// detail phrase in the refusal text), and accept rows assert the\n32|// body travels past the frame gate (an accept, or a refusal at a\n33|// named later arm with the frame phrase asserted absent). A code\n34|//-only assertion would conflate the frame gate with the member\n35|// gates behind it, which carry the same refusal code.\n36|//\n37|// The roster fails closed in both directions: every fault detail\n38|// derived from environ production must own at least one row, and\n39|// a row naming a detail production no longer derives fails as\n40|// orphaned. Expected verdicts are ledgered per judge, so a\n41|// verdict flip in EITHER direction — a fix or a regression —\n42|// reddens its row instead of passing silently.\n43|\n44|// frameRow is one corpus vector with the ledgered verdict at\n45|// every judge. A refuse expectation names the refusal text the\n46|// verdict must contain; an accept expectation names a later-arm\n47|// text the verdict must contain (\"\" with accept=true means the\n48|// entry itself accepts). canonicalRefuse nil means the\n49|// canonicalizer is not judged on this row: it validates JSON\n50|// values, not closed objects, so object-shape faults\n51|// (non-object, duplicate, trailing) are outside the decoder\n52|// rules it shares with the facades.\n53|type frameRow struct {\n54|\tfault string\n55|\tname  string\n56|\tbody  []byte\n57|\n58|\t// Per-judge bodies override body where an entry needs a\n59|\t// shaped vector (accept controls): nil means the shared\n60|\t// minimal body, which every frame gate refuses before any\n61|\t// member is read.\n62|\tsessBody []byte\n63|\tdirBody  []byte\n64|\tprovBody []byte\n65|\n66|\tenvironRefuse string\n67|\tenvironMember string\n68|\n69|\tsessAccept bool\n70|\tsessText   string\n71|\tsessAbsent string\n72|\n73|\tdirAccept bool\n74|\tdirText   string\n75|\tdirAbsent string\n76|\n77|\tprovAccept bool\n78|\tprovText   string\n79|\tprovAbsent string\n80|\n81|\tcanonicalRefuse *bool\n82|}\n83|\n84|func boolPointer(value bool) *bool {\n85|\treturn &value\n86|}\n87|\n88|// frameCorpus is the shared fault corpus. Surrogate subclasses\n89|// enumerate the full shape of the gate: bare highs and lows,\n90|// mispairs, truncated and malformed escapes, paired controls,\n91|// and backslash-run parity (runs of 1..3 backslashes before the\n92|// escape, in value, member-name, and nested positions). Run\n93|// parity is the exact shape of the recorded raw-scan divergence:\n94|// a string-aware walk consumes `\\\\` pairs, so a `\\u` sequence\n95|// behind an odd run is a real escape every judge refuses when\n96|// lone, while the same sequence behind an even run is quoted\n97|// text the raw byte scan still refuses. A raw scanner matches\n98|// every `\\u` byte pair regardless of string context.\n99|func frameCorpus() []frameRow {\n100|\tpairVersion := `\"environment_version\":\"A\\uD83D\\uDE00B\"`\n101|\tpairTuple := []byte(strings.Replace(validTupleJSON(), `\"environment_version\":\"2.1.0\"`, pairVersion, 1))\n102|\tpairCursor := validScanRequestJSON(`\"A\\uD83D\\uDE00B\"`)\n103|\trows := []frameRow{\n104|\t\t{\n105|\t\t\tfault: FaultNotUTF8, name: \"non-utf8 bytes\",\n106|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"a\\xff\\\"}\"),\n107|\t\t\tenvironRefuse: FaultNotUTF8,\n108|\t\t\tsessText:      FaultNotUTF8, dirText: FaultNotUTF8, provText: FaultNotUTF8,\n109|\t\t\tcanonicalRefuse: boolPointer(true),\n110|\t\t},\n111|\t\t{\n112|\t\t\tfault: FaultLoneSurrogate, name: \"bare high escape\",\n113|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\ud800B\\\"}\"),\n114|\t\t\tenvironRefuse: FaultLoneSurrogate,\n115|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n116|\t\t\tcanonicalRefuse: boolPointer(true),\n117|\t\t},\n118|\t\t{\n119|\t\t\tfault: FaultLoneSurrogate, name: \"bare low escape\",\n120|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\udc00B\\\"}\"),\n121|\t\t\tenvironRefuse: FaultLoneSurrogate,\n122|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n123|\t\t\tcanonicalRefuse: boolPointer(true),\n124|\t\t},\n125|\t\t{\n126|\t\t\tfault: FaultLoneSurrogate, name: \"high followed by non-low\",\n127|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83D\\\\u0041B\\\"}\"),\n128|\t\t\tenvironRefuse: FaultLoneSurrogate,\n129|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n130|\t\t\tcanonicalRefuse: boolPointer(true),\n131|\t\t},\n132|\t\t{\n133|\t\t\tfault: FaultNotObject, name: \"truncated escape falls to syntax\",\n134|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83\\\"}\"),\n135|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n136|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n137|\t\t\tcanonicalRefuse: boolPointer(true),\n138|\t\t},\n139|\t\t{\n140|\t\t\tfault: FaultNotObject, name: \"malformed escape falls to syntax\",\n141|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uDEFG B\\\"}\"),\n142|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n143|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n144|\t\t\tcanonicalRefuse: boolPointer(true),\n145|\t\t},\n146|\t\t{\n147|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run2\",\n148|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800B\\\"}\"),\n149|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n150|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n151|\t\t\tcanonicalRefuse: boolPointer(false),\n152|\t\t},\n153|\t\t{\n154|\t\t\t// Run 3 is an escaped backslash followed by a REAL\n155|\t\t\t// lone escape (value `A\\` plus U+D800), so every\n156|\t\t\t// judge refuses: odd runs escape, even runs quote.\n157|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run3\",\n158|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\\\\\ud800B\\\"}\"),\n159|\t\t\tenvironRefuse: FaultLoneSurrogate,\n160|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n161|\t\t\tcanonicalRefuse: boolPointer(true),\n162|\t\t},\n163|\t\t{\n164|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash low run2\",\n165|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\udc00B\\\"}\"),\n166|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n167|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n168|\t\t\tcanonicalRefuse: boolPointer(false),\n169|\t\t},\n170|\t\t{\n171|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash pair run2\",\n172|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\uD83D\\\\\\\\uDE00B\\\"}\"),\n173|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n174|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n175|\t\t\tcanonicalRefuse: boolPointer(false),\n176|\t\t},\n177|\t\t{\n178|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash in member name\",\n179|\t\t\tbody:     []byte(\"{\\\"A\\\\\\\\ud800B\\\":1}\"),\n180|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n181|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n182|\t\t\tcanonicalRefuse: boolPointer(false),\n183|\t\t},\n184|\t\t{\n185|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash nested\",\n186|\t\t\tbody:     []byte(\"{\\\"v\\\":{\\\"w\\\":\\\"A\\\\\\\\ud800B\\\"}}\"),\n187|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n188|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n189|\t\t\tcanonicalRefuse: boolPointer(false),\n190|\t\t},\n191|\t\t{\n192|\t\t\tfault: FaultDuplicate, name: \"duplicate member\",\n193|\t\t\tbody:          []byte(\"{\\\"v\\\":1,\\\"v\\\":2}\"),\n194|\t\t\tenvironRefuse: FaultDuplicate, environMember: \"v\",\n195|\t\t\tsessText: FaultDuplicate, dirText: FaultDuplicate, provText: FaultDuplicate,\n196|\t\t},\n197|\t\t{\n198|\t\t\tfault: FaultTrailing, name: \"trailing data\",\n199|\t\t\tbody:          []byte(\"{\\\"v\\\":1} {}\"),\n200|\t\t\tenvironRefuse: FaultTrailing,\n201|\t\t\tsessText:      FaultTrailing, dirText: FaultTrailing, provText: FaultTrailing,\n202|\t\t},\n203|\t\t{\n204|\t\t\tfault: FaultNotObject, name: \"non-object top level\",\n205|\t\t\tbody:          []byte(\"[1,2]\"),\n206|\t\t\tenvironRefuse: FaultNotObject,\n207|\t\t\tsessText:      FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n208|\t\t},\n209|\t\t{\n210|\t\t\tfault: FaultNotObject, name: \"unterminated string is syntax\",\n211|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"abc\"),\n212|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n213|\t\t\tsessText: FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n214|\t\t\tcanonicalRefuse: boolPointer(true),\n215|\t\t},\n216|\t\t{\n217|\t\t\tfault: FaultLoneSurrogate, name: \"paired surrogates admit\",\n218|\t\t\tbody:       []byte(`{\"v\":\"A\\uD83D\\uDE00B\"}`),\n219|\t\t\tsessBody:   pairTuple,\n220|\t\t\tdirBody:    pairCursor,\n221|\t\t\tprovBody:   []byte(`{\"note\":\"A\\uD83D\\uDE00B\"}`),\n222|\t\t\tsessAccept: true,\n223|\t\t\tdirAccept:  true,\n224|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n225|\t\t\tcanonicalRefuse: boolPointer(false),\n226|\t\t},\n227|\t\t{\n228|\t\t\tfault: FaultNotUTF8, name: \"multibyte text admits\",\n229|\t\t\tbody:       []byte(\"{\\\"v\\\":\\\"plain ü ☃\\\"}\"),\n230|\t\t\tsessBody:   pairTuple,\n231|\t\t\tdirBody:    pairCursor,\n232|\t\t\tprovBody:   []byte(\"{\\\"note\\\":\\\"plain ü ☃\\\"}\"),\n233|\t\t\tsessAccept: true,\n234|\t\t\tdirAccept:  true,\n235|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultNotUTF8,\n236|\t\t\tcanonicalRefuse: boolPointer(false),\n237|\t\t},\n238|\t}\n239|\treturn rows\n240|}\n241|\n242|// deriveFaultDetails derives the frame-fault space from environ\n243|// production: every Fault* constant value in decode.go. A sixth\n244|// fault shape fails the roster below instead of passing\n245|// unrostered.\n246|func deriveFaultDetails(t *testing.T) map[string]bool {\n247|\tt.Helper()\n248|\tpath := filepath.Join(mustGetwd(t), \"decode.go\")\n249|\tsource, err := os.ReadFile(path)\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"faults: %v\", err)\n252|\t}\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"faults: %v\", err)\n256|\t}\n257|\tdetails := map[string]bool{}\n258|\tfor _, decl := range syntax.Decls {\n259|\t\tnode, ok := decl.(*ast.GenDecl)\n260|\t\tif !ok {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tfor _, spec := range node.Specs {\n264|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n265|\t\t\tif !ok {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tfor index, name := range value.Names {\n269|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n270|\t\t\t\t\tcontinue\n271|\t\t\t\t}\n272|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n273|\t\t\t\tif !ok {\n274|\t\t\t\t\tt.Fatalf(\"faults: %s is not a literal; the extractor cannot see through indirection\", name.Name)\n275|\t\t\t\t}\n276|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n277|\t\t\t\tif err != nil {\n278|\t\t\t\t\tt.Fatalf(\"faults: %v\", err)\n279|\t\t\t\t}\n280|\t\t\t\tdetails[text] = true\n281|\t\t\t}\n282|\t\t}\n283|\t}\n284|\tif len(details) == 0 {\n285|\t\tt.Fatal(\"faults derived zero details; the scanner is blind, not the space empty\")\n286|\t}\n287|\treturn details\n288|}\n289|\n290|func mustGetwd(t *testing.T) string {\n291|\tt.Helper()\n292|\tdirectory, err := os.Getwd()\n293|\tif err != nil {\n294|\t\tt.Fatalf(\"frame: %v\", err)\n295|\t}\n296|\treturn directory\n297|}\n298|\n299|// TestFrameFaultRosterIsClosed requires every derived fault\n300|// detail to own at least one row, and every row to name a\n301|// derived detail.\n302|func TestFrameFaultRosterIsClosed(t *testing.T) {\n303|\tdetails := deriveFaultDetails(t)\n304|\tcovered := map[string]bool{}\n305|\tfor _, row := range frameCorpus() {\n306|\t\tif row.fault == \"\" {\n307|\t\t\tt.Fatalf(\"row %q names no fault detail\", row.name)\n308|\t\t}\n309|\t\tif !details[row.fault] {\n310|\t\t\tt.Fatalf(\"row %q names underived detail %q\", row.name, row.fault)\n311|\t\t}\n312|\t\tcovered[row.fault] = true\n313|\t}\n314|\tfor detail := range details {\n315|\t\tif !covered[detail] {\n316|\t\t\tt.Errorf(\"derived fault detail %q owns no corpus row\", detail)\n317|\t\t}\n318|\t}\n319|}\n320|\n321|// TestFrameAgreementAcrossFacades drives the shared corpus\n322|// through all five judges and requires the ledgered verdict at\n323|// each. environ rows assert the exact fault and member; facade\n324|// rows assert the full frame rendering (the detail phrase in the\n325|// refusal text) or, for accept rows, travel past the frame gate\n326|// with the frame phrase asserted absent; canonical rows assert\n327|// the verdict only, where the canonicalizer shares the rule.\n328|func TestFrameAgreementAcrossFacades(t *testing.T) {\n329|\tfor _, row := range frameCorpus() {\n330|\t\tt.Run(row.name, func(t *testing.T) {\n331|\t\t\t_, fault := DecodeStrictObject(row.body)\n332|\t\t\tif row.environRefuse == \"\" {\n333|\t\t\t\tif fault != nil {\n334|\t\t\t\t\tt.Fatalf(\"environ refused %q: %v\", row.body, fault)\n335|\t\t\t\t}\n336|\t\t\t} else {\n337|\t\t\t\tif fault == nil {\n338|\t\t\t\t\tt.Fatalf(\"environ admitted %q, want fault %q\", row.body, row.environRefuse)\n339|\t\t\t\t}\n340|\t\t\t\tif fault.Detail != row.environRefuse || fault.Member != row.environMember {\n341|\t\t\t\t\tt.Fatalf(\"environ fault = (%q, %q), want (%q, %q)\", fault.Detail, fault.Member, row.environRefuse, row.environMember)\n342|\t\t\t\t}\n343|\t\t\t}\n344|\t\t\tsessBody := orBody(row.body, row.sessBody)\n345|\t\t\tdirBody := orBody(row.body, row.dirBody)\n346|\t\t\tprovBody := orBody(row.body, row.provBody)\n347|\t\t\tassertFacadeVerdict(t, \"sessadapter\", sessBody, row.sessAccept, row.sessText, row.sessAbsent, func(body []byte) error {\n348|\t\t\t\t_, err := sessadapter.DecodeTuple(body)\n349|\t\t\t\treturn err\n350|\t\t\t})\n351|\t\t\tassertFacadeVerdict(t, \"dirnode\", dirBody, row.dirAccept, row.dirText, row.dirAbsent, func(body []byte) error {\n352|\t\t\t\t_, err := dirnode.CheckScanRequest(body)\n353|\t\t\t\treturn err\n354|\t\t\t})\n355|\t\t\tassertFacadeVerdict(t, \"provhost\", provBody, row.provAccept, row.provText, row.provAbsent, func(body []byte) error {\n356|\t\t\t\treturn provhost.DecodeManifest(body)\n357|\t\t\t})\n358|\t\t\tif row.canonicalRefuse != nil {\n359|\t\t\t\t_, err := canonicaljson.Canonicalize(row.body)\n360|\t\t\t\tif (*row.canonicalRefuse && err == nil) || (!*row.canonicalRefuse && err != nil) {\n361|\t\t\t\t\tt.Fatalf(\"canonicaljson verdict = refuse=%v, want refuse=%v (err=%v)\", err != nil, *row.canonicalRefuse, err)\n362|\t\t\t\t}\n363|\t\t\t}\n364|\t\t})\n365|\t}\n366|}\n367|\n368|// orBody selects the per-judge override body when present.\n369|func orBody(shared, override []byte) []byte {\n370|\tif override != nil {\n371|\t\treturn override\n372|\t}\n373|\treturn shared\n374|}\n375|\n376|// assertFacadeVerdict requires the ledgered verdict at one\n377|// facade entry: an accept, or a refusal whose text contains the\n378|// frame phrase (and never contains the absent phrase, which\n379|// pins travel past a gate the body must cross).\n380|func assertFacadeVerdict(t *testing.T, facade string, body []byte, accept bool, text, absent string, drive func([]byte) error) {\n381|\tt.Helper()\n382|\terr := drive(body)\n383|\tif accept {\n384|\t\tif err != nil {\n385|\t\t\tt.Fatalf(\"%s refused %q, want accept: %v\", facade, body, err)\n386|\t\t}\n387|\t\treturn\n388|\t}\n389|\tif err == nil {\n390|\t\tt.Fatalf(\"%s admitted %q, want refusal containing %q\", facade, body, text)\n391|\t}\n392|\tif text != \"\" && !strings.Contains(err.Error(), text) {\n393|\t\tt.Fatalf(\"%s error = %v, want text containing %q\", facade, err, text)\n394|\t}\n395|\tif absent != \"\" && strings.Contains(err.Error(), absent) {\n396|\t\tt.Fatalf(\"%s error = %v, must not contain %q\", facade, err, absent)\n397|\t}\n398|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
