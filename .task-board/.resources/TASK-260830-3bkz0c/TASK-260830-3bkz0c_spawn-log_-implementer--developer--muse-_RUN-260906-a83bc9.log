{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c513","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":228,"recorded_at":1780531400000451,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"a5ea55e9-1154-4ce1-ab96-a49563ef2c0d"},"task_id":"a5ea55e9-1154-4ce1-ab96-a49563ef2c0d","event":{"kind":"output","task_id":"a5ea55e9-1154-4ce1-ab96-a49563ef2c0d","chunk":"Read text file `internal/environ/observation.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// observationSchema is the exact schema identifier the\n10|// Environment Observation carries.\n11|const observationSchema = \"urn:ax:schema:environment-observation\"\n12|\n13|// observationSchemaVersion is the only observation version this\n14|// library accepts.\n15|const observationSchemaVersion = \"1.0.0\"\n16|\n17|// observationMembers is the exact Section 10.8.1 member set.\n18|var observationMembers = map[string]bool{\n19|\t\"schema\":                    true,\n20|\t\"schema_version\":            true,\n21|\t\"observation_id\":            true,\n22|\t\"host_id\":                   true,\n23|\t\"installation_id\":           true,\n24|\t\"environment_id\":            true,\n25|\t\"environment_version\":       true,\n26|\t\"provider_id\":               true,\n27|\t\"platform\":                  true,\n28|\t\"architecture\":              true,\n29|\t\"backend_realm_fingerprint\": true,\n30|\t\"capabilities\":              true,\n31|\t\"authentication_status\":     true,\n32|\t\"runtime_status\":            true,\n33|\t\"observed_at\":               true,\n34|\t\"extensions\":                true,\n35|}\n36|\n37|// observationRequired lists observationMembers in a fixed order so\n38|// a record missing several members always names the same one.\n39|var observationRequired = []string{\n40|\t\"schema\",\n41|\t\"schema_version\",\n42|\t\"observation_id\",\n43|\t\"host_id\",\n44|\t\"installation_id\",\n45|\t\"environment_id\",\n46|\t\"environment_version\",\n47|\t\"provider_id\",\n48|\t\"platform\",\n49|\t\"architecture\",\n50|\t\"backend_realm_fingerprint\",\n51|\t\"capabilities\",\n52|\t\"authentication_status\",\n53|\t\"runtime_status\",\n54|\t\"observed_at\",\n55|\t\"extensions\",\n56|}\n57|\n58|// capabilityOrder is the exact eight-name directory-capability\n59|// registry Section 7.9 states. The observation capabilities map\n60|// carries exactly these keys: a ninth key advertises a surface\n61|// the contract never defined, and a missing key hides one it did.\n62|// Section 10.8.1 reuses this registry rather than creating a\n63|// second capability authority.\n64|var capabilityOrder = []string{\n65|\t\"directory_discovery\",\n66|\t\"directory_incremental_scan\",\n67|\t\"directory_head_digest\",\n68|\t\"directory_tail_preview\",\n69|\t\"native_title_read\",\n70|\t\"native_runtime_observation\",\n71|\t\"existing_session_adoption\",\n72|\t\"native_resume\",\n73|}\n74|\n75|// validCapability reports whether the name is a registry member.\n76|// It is a table loop so the census derives it like every other\n77|// closed vocabulary.\n78|func validCapability(name string) bool {\n79|\tfor _, allowed := range capabilityOrder {\n80|\t\tif name == allowed {\n81|\t\t\treturn true\n82|\t\t}\n83|\t}\n84|\treturn false\n85|}\n86|\n87|// capabilityStatuses is the closed CapabilityResult status\n88|// vocabulary. Unknown is never rewritten as unsupported, and\n89|// conditional is never advertised as available.\n90|var capabilityStatuses = []string{\n91|\t\"available\",\n92|\t\"conditional\",\n93|\t\"unavailable\",\n94|\t\"unknown\",\n95|}\n96|\n97|// validCapabilityStatus reports whether the status is a registry\n98|// member.\n99|func validCapabilityStatus(status string) bool {\n100|\tfor _, allowed := range capabilityStatuses {\n101|\t\tif status == allowed {\n102|\t\t\treturn true\n103|\t\t}\n104|\t}\n105|\treturn false\n106|}\n107|\n108|// capabilityMembers is the exact CapabilityResult member set.\n109|var capabilityMembers = map[string]bool{\n110|\t\"status\":       true,\n111|\t\"reason_code\":  true,\n112|\t\"evidence_ids\": true,\n113|\t\"observed_at\":  true,\n114|\t\"extensions\":   true,\n115|}\n116|\n117|// capabilityRequired lists capabilityMembers in a fixed order.\n118|var capabilityRequired = []string{\n119|\t\"status\",\n120|\t\"reason_code\",\n121|\t\"evidence_ids\",\n122|\t\"observed_at\",\n123|\t\"extensions\",\n124|}\n125|\n126|// authenticationStatuses is the closed authentication_status\n127|// vocabulary: status only, never credentials.\n128|var authenticationStatuses = []string{\n129|\t\"available\",\n130|\t\"missing\",\n131|\t\"expired\",\n132|\t\"unknown\",\n133|}\n134|\n135|// validAuthenticationStatus reports whether the status is a\n136|// registry member.\n137|func validAuthenticationStatus(status string) bool {\n138|\tfor _, allowed := range authenticationStatuses {\n139|\t\tif status == allowed {\n140|\t\t\treturn true\n141|\t\t}\n142|\t}\n143|\treturn false\n144|}\n145|\n146|// runtimeStatuses is the closed runtime_status vocabulary.\n147|var runtimeStatuses = []string{\n148|\t\"available\",\n149|\t\"degraded\",\n150|\t\"unavailable\",\n151|}\n152|\n153|// validRuntimeStatus reports whether the status is a registry\n154|// member.\n155|func validRuntimeStatus(status string) bool {\n156|\tfor _, allowed := range runtimeStatuses {\n157|\t\tif status == allowed {\n158|\t\t\treturn true\n159|\t\t}\n160|\t}\n161|\treturn false\n162|}\n163|\n164|// CapabilityResult is one validated directory capability result.\n165|type CapabilityResult struct {\n166|\tStatus     string\n167|\tReasonCode string\n168|\tHasReason  bool\n169|\tEvidence   []string\n170|\tObservedAt string\n171|}\n172|\n173|// Observation is one validated Environment Observation.\n174|type Observation struct {\n175|\tObservationID    string\n176|\tHostID           string\n177|\tInstallationID   string\n178|\tEnvironmentID    string\n179|\tEnvironmentVer   string\n180|\tProviderID       string\n181|\tPlatform         string\n182|\tArchitecture     string\n183|\tRealmFingerprint string\n184|\tCapabilities     map[string]CapabilityResult\n185|\tAuthentication   string\n186|\tRuntime          string\n187|\tObservedAt       string\n188|}\n189|\n190|// DecodeEnvironmentObservation validates one closed Environment\n191|// Observation: the exact schema envelope, digest and UUIDv7\n192|// identities, the environment-id grammar with\n193|// environment_version as string[1..128], the provider-id grammar\n194|// (an explicit manifest mapping, never string inference), the\n195|// platform and architecture vocabularies through the reused\n196|// Section 13.14 tuple admission model, the non-secret realm\n197|// digest, the exact eight-name capability map, the two status\n198|// vocabularies, the diagnostic timestamp, and reverse-DNS\n199|// extensions.\n200|func DecodeEnvironmentObservation(body []byte) (Observation, error) {\n201|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(body))\n202|\tif fault != nil {\n203|\t\treturn Observation{}, refuse(\"observation \"+fault.Detail, fault.Member)\n204|\t}\n205|\tif name, unknown := unknownMember(members, observationMembers); unknown {\n206|\t\treturn Observation{}, refuse(\"observation carries unknown member\", name)\n207|\t}\n208|\tif name, missing := missingMember(members, observationRequired); missing {\n209|\t\treturn Observation{}, refuse(\"observation misses a required member\", name)\n210|\t}\n211|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != observationSchema {\n212|\t\treturn Observation{}, refuse(\"observation schema is not the environment observation\", \"schema\")\n213|\t}\n214|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != observationSchemaVersion {\n215|\t\treturn Observation{}, refuse(\"observation schema version is not 1.0.0\", \"schema_version\")\n216|\t}\n217|\tobservationID, ok := CheckDigest(members[\"observation_id\"])\n218|\tif !ok {\n219|\t\treturn Observation{}, refuse(\"observation identifier is not a digest\", \"observation_id\")\n220|\t}\n221|\thostID, ok := CheckUUIDv7(members[\"host_id\"])\n222|\tif !ok {\n223|\t\treturn Observation{}, refuse(\"observation host identifier is not a UUIDv7\", \"host_id\")\n224|\t}\n225|\tinstallationID, ok := CheckDigest(members[\"installation_id\"])\n226|\tif !ok {\n227|\t\treturn Observation{}, refuse(\"observation installation identifier is not a digest\", \"installation_id\")\n228|\t}\n229|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n230|\tif !ok || !CheckEnvironmentID(environmentID) {\n231|\t\treturn Observation{}, refuse(\"observation environment identifier is not an environment-id\", \"environment_id\")\n232|\t}\n233|\tenvironmentVersion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n234|\tif !ok {\n235|\t\treturn Observation{}, refuse(\"observation environment version is not a string[1..128]\", \"environment_version\")\n236|\t}\n237|\tprovider, ok := rawString(members[\"provider_id\"])\n238|\tif !ok {\n239|\t\treturn Observation{}, refuse(\"observation provider identifier is not a string\", \"provider_id\")\n240|\t}\n241|\tproviderID, err := scalar.ParseProviderID(provider)\n242|\tif err != nil {\n243|\t\treturn Observation{}, refuse(\"observation provider identifier is not a provider-id\", \"provider_id\")\n244|\t}\n245|\tplatform, ok := rawString(members[\"platform\"])\n246|\tif !ok {\n247|\t\treturn Observation{}, refuse(\"observation platform is not a string\", \"platform\")\n248|\t}\n249|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n250|\t\treturn Observation{}, refuse(\"observation platform is outside linux|macos|windows|wsl2\", \"platform\")\n251|\t}\n252|\tarchitecture, ok := rawString(members[\"architecture\"])\n253|\tif !ok || !validTupleArchitecture(architecture) {\n254|\t\treturn Observation{}, refuse(\"observation architecture is outside amd64|arm64\", \"architecture\")\n255|\t}\n256|\trealm, ok := CheckDigest(members[\"backend_realm_fingerprint\"])\n257|\tif !ok {\n258|\t\treturn Observation{}, refuse(\"observation realm fingerprint is not a digest\", \"backend_realm_fingerprint\")\n259|\t}\n260|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n261|\tif !ok {\n262|\t\treturn Observation{}, refuse(\"observation capabilities are not the exact eight-name result map\", \"capabilities\")\n263|\t}\n264|\tauthentication, ok := rawString(members[\"authentication_status\"])\n265|\tif !ok || !validAuthenticationStatus(authentication) {\n266|\t\treturn Observation{}, refuse(\"observation authentication status is outside available|missing|expired|unknown\", \"authentication_status\")\n267|\t}\n268|\truntime, ok := rawString(members[\"runtime_status\"])\n269|\tif !ok || !validRuntimeStatus(runtime) {\n270|\t\treturn Observation{}, refuse(\"observation runtime status is outside available|degraded|unavailable\", \"runtime_status\")\n271|\t}\n272|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n273|\tif !ok {\n274|\t\treturn Observation{}, refuse(\"observation timestamp is not a timestamp\", \"observed_at\")\n275|\t}\n276|\tif !CheckExtensions(members[\"extensions\"]) {\n277|\t\treturn Observation{}, refuse(\"observation extensions are not reverse-DNS keyed\", \"extensions\")\n278|\t}\n279|\treturn Observation{\n280|\t\tObservationID:    observationID.String(),\n281|\t\tHostID:           hostID.String(),\n282|\t\tInstallationID:   installationID.String(),\n283|\t\tEnvironmentID:    environmentID,\n284|\t\tEnvironmentVer:   environmentVersion,\n285|\t\tProviderID:       providerID.String(),\n286|\t\tPlatform:         platform,\n287|\t\tArchitecture:     architecture,\n288|\t\tRealmFingerprint: realm.String(),\n289|\t\tCapabilities:     capabilities,\n290|\t\tAuthentication:   authentication,\n291|\t\tRuntime:          runtime,\n292|\t\tObservedAt:       observed.String(),\n293|\t}, nil\n294|}\n295|\n296|// checkCapabilities validates the exact eight-name capability\n297|// map: exactly the registry keys, each a closed CapabilityResult.\n298|func checkCapabilities(raw json.RawMessage) (map[string]CapabilityResult, bool) {\n299|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n300|\tif fault != nil {\n301|\t\treturn nil, false\n302|\t}\n303|\tif len(members) != len(capabilityOrder) {\n304|\t\treturn nil, false\n305|\t}\n306|\tcapabilities := make(map[string]CapabilityResult, len(capabilityOrder))\n307|\tfor _, name := range capabilityOrder {\n308|\t\tmember, present := members[name]\n309|\t\tif !present {\n310|\t\t\treturn nil, false\n311|\t\t}\n312|\t\tcapability, ok := checkCapabilityResult(member)\n313|\t\tif !ok {\n314|\t\t\treturn nil, false\n315|\t\t}\n316|\t\tcapabilities[name] = capability\n317|\t}\n318|\treturn capabilities, true\n319|}\n320|\n321|// checkCapabilityResult validates one CapabilityResult object.\n322|// Available carries a null reason and every other status carries\n323|// one: the two directions are separate obligations, so an\n324|// available-with-reason vector and a conditional-without-reason\n325|// vector are separate rows in the battery.\n326|func checkCapabilityResult(raw json.RawMessage) (CapabilityResult, bool) {\n327|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n328|\tif fault != nil {\n329|\t\treturn CapabilityResult{}, false\n330|\t}\n331|\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\n332|\t\t_ = name\n333|\t\treturn CapabilityResult{}, false\n334|\t}\n335|\tif name, missing := missingMember(members, capabilityRequired); missing {\n336|\t\t_ = name\n337|\t\treturn CapabilityResult{}, false\n338|\t}\n339|\tstatus, ok := rawString(members[\"status\"])\n340|\tif !ok || !validCapabilityStatus(status) {\n341|\t\treturn CapabilityResult{}, false\n342|\t}\n343|\treasonMember, present := members[\"reason_code\"]\n344|\tif !present {\n345|\t\treturn CapabilityResult{}, false\n346|\t}\n347|\thasReason := false\n348|\tvar reasonCode string\n349|\tif isNull(reasonMember) {\n350|\t\thasReason = false\n351|\t} else {\n352|\t\tvalue, ok := CheckStringBounds(reasonMember, 1, 128)\n353|\t\tif !ok {\n354|\t\t\treturn CapabilityResult{}, false\n355|\t\t}\n356|\t\thasReason = true\n357|\t\treasonCode = value\n358|\t}\n359|\tif status == \"available\" && hasReason {\n360|\t\treturn CapabilityResult{}, false\n361|\t}\n362|\tif status != \"available\" && !hasReason {\n363|\t\treturn CapabilityResult{}, false\n364|\t}\n365|\tevidence, ok := CheckSortedUniqueDigests(members[\"evidence_ids\"], 0, 64)\n366|\tif !ok {\n367|\t\treturn CapabilityResult{}, false\n368|\t}\n369|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n370|\tif !ok {\n371|\t\treturn CapabilityResult{}, false\n372|\t}\n373|\tif !CheckExtensions(members[\"extensions\"]) {\n374|\t\treturn CapabilityResult{}, false\n375|\t}\n376|\ttexts := make([]string, 0, len(evidence))\n377|\tfor _, digest := range evidence {\n378|\t\ttexts = append(texts, digest.String())\n379|\t}\n380|\treturn CapabilityResult{\n381|\t\tStatus:     status,\n382|\t\tReasonCode: reasonCode,\n383|\t\tHasReason:  hasReason,\n384|\t\tEvidence:   texts,\n385|\t\tObservedAt: observed.String(),\n386|\t}, true\n387|}"}}}
