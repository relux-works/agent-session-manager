{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbd3","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":1092,"recorded_at":1780531400002179,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"0bc8dcbf-780a-44cf-ba2d-dd7c17eb99e3"},"task_id":"0bc8dcbf-780a-44cf-ba2d-dd7c17eb99e3","event":{"kind":"output","task_id":"0bc8dcbf-780a-44cf-ba2d-dd7c17eb99e3","chunk":"Read text file `internal/canonicaljson/performance_test.go`.\n1|//go:build !race\n2|\n3|package canonicaljson\n4|\n5|import (\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"testing\"\n9|\t\"time\"\n10|)\n11|\n12|// The race detector deliberately instruments every map and string operation,\n13|// so wall-clock regression thresholds are measured only in an ordinary test\n14|// binary. Functional and race coverage of this gate remain in canonical_test.\n15|func TestTransferManifestMaximumEntryGateIsLinear(t *testing.T) {\n16|\tobject := validTransferManifestObject(\"workspace_tree\")\n17|\tentries := make([]any, 65_536)\n18|\tfor index := range entries {\n19|\t\tentries[index] = map[string]any{\n20|\t\t\t\"path\": fmt.Sprintf(\"p%05x\", index),\n21|\t\t\t\"type\": \"directory\",\n22|\t\t\t\"mode\": json.Number(\"493\"),\n23|\t\t}\n24|\t}\n25|\tobject[\"entries\"] = entries\n26|\tinput := mustJSON(t, object)\n27|\tif len(input) > 5_242_880 {\n28|\t\tt.Fatalf(\"maximum-entry Transfer Manifest encodes to %d bytes, want at most 5242880\", len(input))\n29|\t}\n30|\n31|\tstarted := time.Now()\n32|\tif _, field, err := CalculateObjectIdentity(input); err != nil || field != SelfManifestID {\n33|\t\tt.Fatalf(\"CalculateObjectIdentity(maximum-entry Transfer Manifest) field = %q, erro