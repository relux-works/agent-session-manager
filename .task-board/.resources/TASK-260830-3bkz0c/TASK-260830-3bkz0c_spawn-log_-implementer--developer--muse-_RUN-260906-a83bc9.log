{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"63530e03-b75b-4944-8700-21a2680ebc0d"},"task_id":"63530e03-b75b-4944-8700-21a2680ebc0d","event":{"kind":"output","task_id":"63530e03-b75b-4944-8700-21a2680ebc0d","chunk":"Read text file `internal/environ/corpus_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Shared fixtures for the environ boundary battery. Every builder\n17|// emits hand-written JSON with independently chosen literals: no\n18|// builder derives its probe points from production constants, so\n19|// a mutated production constant cannot take its fixture with\n20|// it. The verdict always comes from production; the vectors never\n21|// do. In particular the schema URNs, version strings, member\n22|// names, and vocabulary tokens below are retyped from the pinned\n23|// specification, not referenced from any package under test.\n24|//\n25|// One corpus drives every facade: the same digest, UUIDv7, and\n26|// timestamp identities flow into the sessadapter, dirnode,\n27|// provhost, and canonicaljson entries each battery file drives,\n28|// so a fixture that is valid for one facade and invalid for\n29|// another fails loudly instead of passing per-facade copies that\n30|// never meet.\n31|\n32|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n33|// the digests are syntactically pinned sha256 hex.\n34|const (\n35|\tfixtureHostID        = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n36|\tfixtureOperationID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n37|\tfixtureSubjectID     = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n38|\tfixtureWorkspaceID   = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n39|\tfixtureCreatorHostID = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n40|\tfixtureObservedAt    = \"2026-08-19T04:05:00.000Z\"\n41|\tfixtureValidFrom     = \"2026-01-01T00:00:00.000Z\"\n42|\tfixtureValidUntil    = \"2027-01-01T00:00:00.000Z\"\n43|\tfixtureEnvironmentID = \"test.env\"\n44|\tfixtureAdapterVer    = \"1.2.3\"\n45|\tfixtureProviderID    = \"test-provider\"\n46|)\n47|\n48|// fixtureDigest returns the pinned digest of one seed.\n49|func fixtureDigest(seed string) string {\n50|\tsum := sha256.Sum256([]byte(seed))\n51|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n52|}\n53|\n54|// Standard fixture digests, each naming its seed.\n55|var (\n56|\tfixtureStorePrint  = fixtureDigest(\"test-store-fingerprint\")\n57|\tfixtureInstallID   = fixtureDigest(\"test-installation\")\n58|\tfixtureObserveID   = fixtureDigest(\"test-observation\")\n59|\tfixtureRealmPrint  = fixtureDigest(\"test-realm\")\n60|\tfixtureRecordID    = fixtureDigest(\"test-identity-record\")\n61|\tfixtureEvidenceID  = fixtureDigest(\"test-evidence\")\n62|\tfixtureExecutable  = fixtureDigest(\"test-executable\")\n63|\tfixtureAdapterMain = fixtureDigest(\"test-adapter-manifest\")\n64|)\n65|\n66|// TestSharedFixtureIdentitiesAreValid guards the instrument: a\n67|// malformed shared identity would refuse at every facade for the\n68|// wrong reason, turning the whole battery into a test of the\n69|// fixture rather than the facades.\n70|func TestSharedFixtureIdentitiesAreValid(t *testing.T) {\n71|\tfor _, identity := range []string{fixtureHostID, fixtureOperationID, fixtureSubjectID, fixtureWorkspaceID, fixtureCreatorHostID} {\n72|\t\tif _, err := scalar.ParseUUIDv7(identity); err != nil {\n73|\t\t\tt.Fatalf(\"fixture UUID %q does not parse: %v\", identity, err)\n74|\t\t}\n75|\t}\n76|\tfor _, moment := range []string{fixtureObservedAt, fixtureValidFrom, fixtureValidUntil} {\n77|\t\tif _, err := scalar.ParseTimestamp(moment); err != nil {\n78|\t\t\tt.Fatalf(\"fixture timestamp %q does not parse: %v\", moment, err)\n79|\t\t}\n80|\t}\n81|\tfor _, digest := range []string{fixtureStorePrint, fixtureInstallID, fixtureObserveID, fixtureRealmPrint, fixtureRecordID, fixtureEvidenceID, fixtureExecutable, fixtureAdapterMain} {\n82|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n83|\t\t\tt.Fatalf(\"fixture digest %q does not parse: %v\", digest, err)\n84|\t\t}\n85|\t}\n86|}\n87|\n88|// validTupleJSON is one valid Environment Tuple over the shared\n89|// identities.\n90|func validTupleJSON() string {\n91|\treturn fmt.Sprintf(`{\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":%q}`,\n92|\t\tfixtureEnvironmentID, fixtureStorePrint, fixtureAdapterVer)\n93|}\n94|\n95|// validScanRequestJSON is one valid dirnode scan request carrying\n96|// the given cursor literal (already JSON-encoded by the caller).\n97|func validScanRequestJSON(cursorLiteral string) []byte {\n98|\treturn []byte(fmt.Sprintf(`{\"operation_id\":%q,\"installation_ids\":[%q],\"prior_batch_id\":null,\"cursor\":%s,\"max_instances\":10,\"extensions\":{}}`,\n99|\t\tfixtureOperationID, fixtureInstallID, cursorLiteral))\n100|}\n101|\n102|// validIdentityJSON is one valid Provider Identity Record over\n103|// the shared identities: an Antigravity\n104|// backend_conversation_uuid with a non-null realm fingerprint.\n105|func validIdentityJSON() []byte {\n106|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:provider-identity\",\"schema_version\":\"1.0.0\",\"record_id\":%q,\"subject_id\":%q,\"session_id\":%q,\"provider_id\":\"antigravity\",\"provider_version\":\"1.1.14\",\"provider_version_range\":\">=1.1.14 <1.2.0\",\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"identity_kind\":\"backend_conversation_uuid\",\"logical_workspace_id\":%q,\"backend_realm_fingerprint\":%q,\"opaque_identity\":{},\"created_by_host_id\":%q,\"created_at\":%q,\"extensions\":{}}`,\n107|\t\tfixtureRecordID, fixtureSubjectID, fixtureSubjectID, fixtureWorkspaceID, fixtureRealmPrint, fixtureCreatorHostID, fixtureObservedAt))\n108|}\n109|\n110|// availableCapabilityJSON is one available CapabilityResult with\n111|// null reason.\n112|func availableCapabilityJSON() string {\n113|\treturn fmt.Sprintf(`{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":%q,\"extensions\":{}}`, fixtureObservedAt)\n114|}\n115|\n116|// validCapabilitiesJSON is the exact eight-name capability map\n117|// with every capability available.\n118|func validCapabilitiesJSON() string {\n119|\tnames := []string{\n120|\t\t\"directory_discovery\",\n121|\t\t\"directory_incremental_scan\",\n122|\t\t\"directory_head_digest\",\n123|\t\t\"directory_tail_preview\",\n124|\t\t\"native_title_read\",\n125|\t\t\"native_runtime_observation\",\n126|\t\t\"existing_session_adoption\",\n127|\t\t\"native_resume\",\n128|\t}\n129|\tparts := make([]string, 0, len(names))\n130|\tfor _, name := range names {\n131|\t\tquoted, err := json.Marshal(name)\n132|\t\tif err != nil {\n133|\t\t\tpanic(err)\n134|\t\t}\n135|\t\tparts = append(parts, string(quoted)+\":\"+availableCapabilityJSON())\n136|\t}\n137|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n138|}\n139|\n140|// validObservationJSON is one valid Environment Observation over\n141|// the shared identities.\n142|func validObservationJSON() []byte {\n143|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:environment-observation\",\"schema_version\":\"1.0.0\",\"observation_id\":%q,\"host_id\":%q,\"installation_id\":%q,\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"provider_id\":%q,\"platform\":\"linux\",\"architecture\":\"amd64\",\"backend_realm_fingerprint\":%q,\"capabilities\":%s,\"authentication_status\":\"available\",\"runtime_status\":\"available\",\"observed_at\":%q,\"extensions\":{}}`,\n144|\t\tfixtureObserveID, fixtureHostID, fixtureInstallID, fixtureEnvironmentID, fixtureProviderID, fixtureRealmPrint, validCapabilitiesJSON(), fixtureObservedAt))\n145|}\n146|\n147|// mutateMember returns the object with one top-level member\n148|// replaced by the given raw JSON. The replacement is applied to a\n149|// fresh positive fixture, one mutation at a time: every other\n150|// member holds a valid value, so two distinct rules cannot both\n151|// satisfy one witness.\n152|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n153|\tt.Helper()\n154|\tmembers := decodeTestMembers(t, body)\n155|\tmembers[member] = replacement\n156|\treturn encodeTestMembers(t, members)\n157|}\n158|\n159|// dropMember returns the object without one top-level member.\n160|func dropMember(t *testing.T, body []byte, member string) []byte {\n161|\tt.Helper()\n162|\tmembers := decodeTestMembers(t, body)\n163|\tdelete(members, member)\n164|\treturn encodeTestMembers(t, members)\n165|}\n166|\n167|func decodeTestMembers(t *testing.T, body []byte) map[string]string {\n168|\tt.Helper()\n169|\tvar raw map[string]json.RawMessage\n170|\tif err := json.Unmarshal(body, &raw); err != nil {\n171|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n172|\t}\n173|\tmembers := make(map[string]string, len(raw))\n174|\tfor name, value := range raw {\n175|\t\tmembers[name] = string(value)\n176|\t}\n177|\treturn members\n178|}\n179|\n180|func encodeTestMembers(t *testing.T, members map[string]string) []byte {\n181|\tt.Helper()\n182|\tnames := make([]string, 0, len(members))\n183|\tfor name := range members {\n184|\t\tnames = append(names, name)\n185|\t}\n186|\tsort.Strings(names)\n187|\tparts := make([]string, 0, len(members))\n188|\tfor _, name := range names {\n189|\t\tquoted, err := json.Marshal(name)\n190|\t\tif err != nil {\n191|\t\t\tt.Fatalf(\"encodeTestMembers: %v\", err)\n192|\t\t}\n193|\t\tparts = append(parts, string(quoted)+\":\"+members[name])\n194|\t}\n195|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n196|}\n197|\n198|// TestEntriesAreDeterministic proves the validation entries are\n199|// pure functions of their input bytes: repeated decoding is\n200|// byte-identical, so there is no hidden cache, no clock read, and\n201|// no durable state whose crash recovery would need evidence. The\n202|// scan journal in dirnode is the story's only durable state and\n203|// belongs to the frozen leaf; this library adds none.\n204|func TestEntriesAreDeterministic(t *testing.T) {\n205|\tbodies := [][]byte{[]byte(validTupleJSON()), validObservationJSON(), validIdentityJSON()}\n206|\tfor index, body := range bodies {\n207|\t\tfirst, err := DecodeStrictObject(body)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"body %d: first decode: %v\", index, err)\n210|\t\t}\n211|\t\tsecond, err := DecodeStrictObject(body)\n212|\t\tif err != nil {\n213|\t\t\tt.Fatalf(\"body %d: second decode: %v\", index, err)\n214|\t\t}\n215|\t\tif !reflect.DeepEqual(first, second) {\n216|\t\t\tt.Fatalf(\"body %d: repeated decode differs\", index)\n217|\t\t}\n218|\t}\n219|\tfirst, err := DecodeTuple([]byte(validTupleJSON()))\n220|\tif err != nil {\n221|\t\tt.Fatalf(\"tuple first decode: %v\", err)\n222|\t}\n223|\tsecond, err := DecodeTuple([]byte(validTupleJSON()))\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"tuple second decode: %v\", err)\n226|\t}\n227|\tif first != second {\n228|\t\tt.Fatalf(\"tuple repeated decode differs: %+v vs %+v\", first, second)\n229|\t}\n230|}"}}}
