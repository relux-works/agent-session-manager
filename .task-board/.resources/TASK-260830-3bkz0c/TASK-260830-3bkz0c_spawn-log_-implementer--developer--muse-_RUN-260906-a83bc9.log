{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c903","stream":{"kind":"session","id":"01a0762f-28c8-71f3-b2cc-60a7b5a2a367"},"sequence":732,"recorded_at":1780531400001459,"record_type":"event","durability":"durable","causation_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee","run_stream":{"kind":"run","id":"ce1e892e-3ef2-41ae-9338-dcad9ed9c1ee"},"task_stream":{"kind":"task","id":"eda7e2f4-2ea4-4524-b3cf-026f54a67dff"},"task_id":"eda7e2f4-2ea4-4524-b3cf-026f54a67dff","event":{"kind":"output","task_id":"eda7e2f4-2ea4-4524-b3cf-026f54a67dff","chunk":"Read text file `internal/canonicaljson/refusal_guards_test.go`.\n(239 line(s) above)\n240|\tparsedSelfFieldRefusal = unreachableRefusal{\n241|\t\treason:           \"resolveSelfField parses the claimed self field as a digest before any shape validator runs\",\n242|\t\tsubsumingRefusal: \"self field %s: %v\",\n243|\t\tprovingTest:      \"TestEveryFixtureMemberRefusesAWrongJSONTypeAtItsProductionEntry\",\n244|\t}\n245|\tenvelopeSubjectRefusal = unreachableRefusal{\n246|\t\treason:           \"validateCommonRecordEnvelope reads subject_id through requireUUIDv7 before this second read of the same member\",\n247|\t\tsubsumingRefusal: \"member subject_id: %v\",\n248|\t\tprovingTest:      \"TestEveryStructuredFixtureValueRefusesAMalformedFormAtItsProductionEntry\",\n249|\t}\n250|\tdecodedValueRefusal = unreachableRefusal{\n251|\t\treason:           \"the value was produced by decodeStrict, so encoding/json and the RFC 8785 transform both accept it\",\n252|\t\tsubsumingRefusal: \"invalid canonical JSON input\",\n253|\t\tprovingTest:      \"TestCalculateObjectIdentityRefusesMalformedJSONInput\",\n254|\t}\n255|\tinvalidUTF8Refusal = unreachableRefusal{\n256|\t\treason:           \"decodeStrict refuses input that is not valid UTF-8, so no decoded string or object key can be invalid\",\n257|\t\tsubsumingRefusal: \"input is not valid UTF-8\",\n258|\t\tprovingTest:      \"TestCalculateObjectIdentityRefusesMalformedJSONInput\",\n259|\t}\n260|\tdispatchedUnionTag = \"validateSessionDerivationProvenance dispatches on the same kind value, so the arm's re-check cannot see a different one\"\n261|)\n262|\n263|// TestUnreachableRefusalDeclarationsNameATestThatExists keeps the escape hatch\n264|// honest the same way the declared-bounds subsumptions are kept honest: a\n265|// declaration must point at a test function present in this package.\n266|func TestUnreachableRefusalDeclarationsNameATestThatExists(t *testing.T) {\n267|\tt.Parallel()\n268|\n269|\tnames := packageTestFunctionNames(t)\n270|\tfor key, declaration := range unreachableRefusalSites {\n271|\t\tif declaration.reason == \"\" || declaration.subsumingRefusal == \"\" || declaration.provingTest == \"\" {\n272|\t\t\tt.Errorf(\"unreachable refusal %s must declare a reason, a subsuming refusal and a proving test\", key)\n273|\t\t\tcontinue\n274|\t\t}\n275|\t\tif _, ok := names[declaration.provingTest]; !ok {\n276|\t\t\tt.Errorf(\"unreachable refusal %s names %s, which does not exist in this package\", key, declaration.provingTest)\n277|\t\t}\n278|\t}\n279|}\n280|\n281|// TestEveryProductionRefusalGuardIsExecuted is the coverage assertion.\n282|//\n283|// It derives every refusal-emitting return in the package's production sources,\n284|// runs the shipped suite under a coverage profile, and requires each derived\n285|// site to have executed at least once. It fails when a guard has no negative\n286|// case, and when a declared-unreachable guard turns out to be reachable.\n287|func TestEveryProductionRefusalGuardIsExecuted(t *testing.T) {\n288|\tif os.Getenv(refusalCoverageChildEnvironment) != \"\" {\n289|\t\tt.Skip(\"child coverage run: the gate measures the shipped suite, it is not part of it\")\n290|\t}\n291|\n292|\tsites := deriveRefusalSites(t)\n293|\tprofile := runShippedSuiteUnderCoverage(t)\n294|\n295|\texecuted := make(map[string]bool, len(sites))\n296|\tfor _, site := range sites {\n297|\t\tblock, ok := profile.innermostBlock(site)\n298|\t\tif !ok {\n299|\t\t\tt.Fatalf(\n300|\t\t\t\t\"refusal guard %s has no coverage block; the derivation and the profile disagree, \"+\n301|\t\t\t\t\t\"which makes every count below meaningless\",\n302|\t\t\t\tsite.key(),\n303|\t\t\t)\n304|\t\t}\n305|\t\texecuted[site.key()] = block.count > 0\n306|\t}\n307|\n308|\tvar unexecuted, obsolete []string\n309|\tfor _, site := range sites {\n310|\t\tdeclaration, declared := unreachableRefusalSites[site.declarationKey()]\n311|\t\tswitch {\n312|\t\tcase executed[site.key()] && declared:\n313|\t\t\tobsolete = append(obsolete, fmt.Sprintf(\"%s: declared unreachable (%s) but executed\", site.key(), declaration.reason))\n314|\t\tcase !executed[site.key()] && !declared:\n315|\t\t\tunexecuted = append(unexecuted, fmt.Sprintf(\"%s: %s\\n      declaration key: %s\", site.key(), site.text, site.declarationKey()))\n316|\t\t}\n317|\t}\n318|\tdeclared := make(map[string]struct{}, len(sites))\n319|\tfor _, site := range sites {\n320|\t\tdeclared[site.declarationKey()] = struct{}{}\n321|\t}\n322|\tfor key := range unreachableRefusalSites {\n323|\t\tif _, ok := declared[key]; !ok {\n324|\t\t\tobsolete = append(obsolete, fmt.Sprintf(\"%s: declared unreachable but no such refusal guard exists\", key))\n325|\t\t}\n326|\t}\n327|\tsort.Strings(unexecuted)\n328|\tsort.Strings(obsolete)\n329|\n330|\tif len(unexecuted) > 0 {\n331|\t\tt.Errorf(\n332|\t\t\t\"%d production refusal guard(s) that the shipped suite never executed. \"+\n333|\t\t\t\t\"Each one can be deleted or narrowed with the whole suite still green. \"+\n334|\t\t\t\t\"Supply a COMPLETE valid member set and violate exactly one member type, format or coupling — \"+\n335|\t\t\t\t\"a fixture that omits a member stops at requireExactMembers and proves only the completeness check:\\n  %s\",\n336|\t\t\tlen(unexecuted), strings.Join(unexecuted, \"\\n  \"),\n337|\t\t)\n338|\t}\n339|\tif len(obsolete) > 0 {\n340|\t\tt.Errorf(\"obsolete unreachable-refusal declarations:\\n  %s\", strings.Join(obsolete, \"\\n  \"))\n341|\t}\n342|}\n343|\n344|// declarationKey identifies a site independently of its line number, so an\n345|// unrelated edit above it does not invalidate a declaration while a rewrite of\n346|// the guard itself does.\n347|func (site refusalSite) declarationKey() string {\n348|\treturn fmt.Sprintf(\"%s|%s|%s|#%d\", site.file, site.function, site.text, site.ordinal)\n349|}\n350|\n351|// TestRefusalGuardDerivationFindsTheKnownRefusalConstructors is the derivation's\n352|// own floor. The obligation set is only as honest as the constructor set it is\n353|// built from: if the derivation silently stopped recognising invalidIdentity,\n354|// every obligation would vanish and the gate above would pass by finding\n355|// nothing.\n356|func TestRefusalGuardDerivationFindsTheKnownRefusalConstructors(t *testing.T) {\n357|\tt.Parallel()\n358|\n359|\tconstructors := deriveRefusalConstructors(t)\n(more lines below)"}}}
