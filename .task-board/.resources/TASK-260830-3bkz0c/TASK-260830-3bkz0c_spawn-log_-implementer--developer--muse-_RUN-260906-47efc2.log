onfig local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\nReplace an existing file resource on a board element.\\n\\nSOURCE may be:\\n  - a local filesystem path\\n  - a file:// URL\\n  - an http:// or https:// URL\\n\\nExamples:\\n  task-board resource update TASK-260311-abc ./results.md --name TASK-260311-abc_results.md\\n  task-board resource update TASK-260311-abc https://example.com/report.json --type outcome\\n\\nUsage:\\n  task-board resource update <ELEMENT-ID> <SOURCE> [flags]\\n\\nFlags:\\n  -d, --description string   Optional one-line description\\n  -h, --help                 help for update\\n      --name string          Override stored resource filename\\n      --type string          Resource type: precondition or outcome (default \\\"outcome\\\")\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2696,\n  \"original_output_tokens\": 674,\n  \"truncated\": false\n}"}}}
