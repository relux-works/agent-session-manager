{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d28f","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":1954,"recorded_at":1780531400003903,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a07672c108738295cf058f6d32fada","text":"Read text file `internal/dirnode/census_test.go`.\n(495 line(s) above)\n496|// literal detail. A composite literal that names frameFault\n497|// through any other shape is a violation.\n498|func (scan *fileScan) visitComposite(literal *ast.CompositeLit, parent ast.Node) {\n499|\tidentifier, ok := literal.Type.(*ast.Ident)\n500|\tif !ok || identifier.Name != \"frameFault\" {\n501|\t\treturn\n502|\t}\n503|\tif _, ok := parent.(*ast.UnaryExpr); !ok {\n504|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": frameFault literal outside address-of\")\n505|\t\treturn\n506|\t}\n507|\tvar detail string\n508|\tfound := false\n509|\tfor _, element := range literal.Elts {\n510|\t\tpair, ok := element.(*ast.KeyValueExpr)\n511|\t\tif !ok {\n512|\t\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": frameFault literal with positional element\")\n513|\t\t\treturn\n514|\t\t}\n515|\t\tkey, ok := pair.Key.(*ast.Ident)\n516|\t\tif !ok || key.Name != \"detail\" {\n517|\t\t\tcontinue\n518|\t\t}\n519|\t\tif literal, ok := pair.Value.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n520|\t\t\tdetail, err := unquoteDetail(scan, literal)\n521|\t\t\tif err != nil {\n522|\t\t\t\treturn\n523|\t\t\t}\n524|\t\t\tscan.derived.arms[\"frame|\"+detail] = true\n525|\t\t\treturn\n526|\t\t}\n527|\t\tif selector, ok := pair.Value.(*ast.SelectorExpr); ok && isEnvironFaultDetail(selector) && scan.name == \"decode.go\" && scan.callFunction() == \"decodeStrictObject\" {\n528|\t\t\t// The environ-delegation bridge forwards environ's\n529|\t\t\t// whole fault space: one arm per fault detail\n530|\t\t\t// derived from environ production source, never\n531|\t\t\t// retyped here.\n532|\t\t\tfor _, detail := range environFaultDetails(scan) {\n533|\t\t\t\tscan.derived.arms[\"frame|\"+detail] = true\n534|\t\t\t}\n535|\t\t\treturn\n536|\t\t}\n537|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": frameFault literal with non-literal detail\")\n538|\t\treturn\n539|\t\tunquoted, err := strconv.Unquote(value.Value)\n540|\t\tif err != nil {\n541|\t\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": frameFault literal with unquotable detail\")\n542|\t\t\treturn\n543|\t\t}\n544|\t\tdetail = unquoted\n545|\t\tfound = true\n546|\t}\n547|\tif !found {\n548|\t\tscan.derived.violations = append(scan.derived.violations, scan.name+\": frameFault literal with no detail\")\n549|\t\treturn\n550|\t}\n551|\tscan.derived.arms[\"frame|\"+detail] = true\n552|}\n553|\n554|// defensiveArms names derived arms no public input can fire:\n555|// encoder-produced values that cannot fail encoding. Each stays\n556|// in production as fail-closed handling of a theoretically\n557|// fallible call, and each is recorded here rather than witnessed\n558|// by a refusal test that cannot exist. A new defensive arm must\n559|// extend this map with its rationale; an arm missing from both\n560|// this map and the witness table fails\n561|// TestDerivedRefusalArmsAreAllWitnessed.\n562|var defensiveArms = map[string]string{\n563|\t\"ctor|failViolation|request frame is not encodable\":        \"json.Marshal over validated strings, integers, and raw JSON cannot fail; the arm stays so a future member type cannot fail silently\",\n564|\t\"ctor|failIntegrity|idempotency journal is not exportable\": \"Canonicalize over encoder-produced bytes cannot fail short of memory corruption; the arm stays so export never returns a partial journal\",\n565|}\n566|\n567|// armWitnesses maps every derived arm to the test functions that\n568|// drive it through a production entry with a negative vector\n569|// asserting code plus distinguishing detail. Shared arms list\n570|// every branch test: the context-prefixed envelope arms fire on\n571|// both the success and failure paths, so both refusal tests are\n572|// named. The table is verified in both directions against the\n573|// derivation; behavioural proof stays with the named tests,\n574|// which run as part of the suite.\n575|var armWitnesses = map[string][]string{\n576|\t\"ctor|failInvalid|request major is outside the locally supported registry\":                              {\"TestEncodeRequestRefusals\"},\n577|\t\"ctor|failInvalid|request identifier is not a UUIDv7\":                                                   {\"TestEncodeRequestRefusals\"},\n578|\t\"ctor|failInvalid|request deadline is outside uint53[1..3600000]\":                                       {\"TestEncodeRequestRefusals\"},\n579|\t\"ctor|failInvalid|probe request major is outside the locally supported registry\":                        {\"TestProbeRequestRefusals\"},\n580|\t\"ctor|failInvalid|observed executable digest is not a digest\":                                           {\"TestCheckManifestBindings\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
