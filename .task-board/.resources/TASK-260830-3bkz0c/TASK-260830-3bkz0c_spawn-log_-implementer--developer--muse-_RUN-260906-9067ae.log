{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d10d","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":1761,"recorded_at":1780531400003517,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"task_stream":{"kind":"task","id":"5127cef2-a4ab-4b84-b3e3-0bc1d30f4ddb"},"task_id":"5127cef2-a4ab-4b84-b3e3-0bc1d30f4ddb","event":{"kind":"output","task_id":"5127cef2-a4ab-4b84-b3e3-0bc1d30f4ddb","chunk":"Read text file `internal/dirnode/census_test.go`.\n(689 line(s) above)\n690|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" frame is empty\"`:                               {\"TestResponseIdentitySharedArms\"},\n691|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" frame exceeds the 8 MiB bound\"`:                {\"TestResponseIdentitySharedArms\"},\n692|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" envelope \"+fault.detail`:                       {\"TestResponseIdentitySharedArms\"},\n693|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" envelope carries unknown member\"`:              {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n694|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" envelope misses a required member\"`:            {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n695|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" schema is not the directory node response\"`:    {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n696|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" schema version is not the bound 1.0.0\"`:        {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n697|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" protocol does not echo the request\"`:           {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n698|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" protocol version does not echo the request\"`:   {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n699|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" request identifier does not echo the request\"`: {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n700|\t`ctor|failViolation|expr|checkResponseIdentity|context+\" operation does not echo the request\"`:          {\"TestCheckSuccessEnvelopeRefusals\", \"TestCheckFailureEnvelopeRefusals\"},\n701|\t\"frame|not valid UTF-8\":                {\"TestDecodeRequestFrameStrictFaults\"},\n702|\t\"frame|lone surrogate escape\":          {\"TestDecodeRequestFrameStrictFaults\"},\n703|\t\"frame|not a JSON object\":              {\"TestDecodeRequestFrameStrictFaults\", \"TestDecodeRequestFrameRefusals\"},\n704|\t\"frame|duplicate member\":               {\"TestDecodeRequestFrameRefusals\"},\n705|\t\"frame|trailing data after the object\": {\"TestDecodeRequestFrameStrictFaults\"},\n706|}\n707|\n708|// TestRefusalConstructorsMatchProduction requires the registered\n709|// constructor set to equal the derived one and every axerror.New\n710|// site to sit inside a registered body with no violations: the\n711|// denominator is derived from production, not from the test\n712|// file. Any violation fails the census instead of passing\n713|// silently.\n714|func TestRefusalConstructorsMatchProduction(t *testing.T) {\n715|\tderived := deriveRefusalArms(t)\n716|\tif len(derived.violations) > 0 {\n717|\t\tsort.Strings(derived.violations)\n718|\t\tt.Fatalf(\"census violations:\\n  %s\", strings.Join(derived.violations, \"\\n  \"))\n719|\t}\n720|\tvar got []string\n721|\tfor name := range derived.ctors {\n722|\t\tgot = append(got, name)\n723|\t}\n724|\tsort.Strings(got)\n725|\twant := append([]string(nil), refusalConstructors...)\n726|\tsort.Strings(want)\n727|\tif strings.Join(got, \"\\x00\") != strings.Join(want, \"\\x00\") {\n728|\t\tt.Fatalf(\"derived constructors = %v, want registered %v\", got, want)\n729|\t}\n730|}\n731|\n732|// TestCensusScansEveryProductionFile requires the scanned set to\n733|// equal the package's production files: a production file the\n734|// census never opens is a file whose arms never derive.\n735|func TestCensusScansEveryProductionFile(t *testing.T) {\n736|\tfiles := productionFiles(t)\n737|\tnames := map[string]bool{\n738|\t\t\"bootstrap.go\": true,\n739|\t\t\"decode.go\":    true,\n740|\t\t\"doc.go\":       true,\n741|\t\t\"manifest.go\":  true,\n742|\t\t\"probe.go\":     true,\n743|\t\t\"protocol.go\":  true,\n744|\t\t\"query.go\":     true,\n745|\t\t\"scan.go\":      true,\n746|\t}\n747|\tif len(files) != len(names) {\n748|\t\tt.Fatalf(\"scanned %d files %v, want %d named files\", len(files), files, len(names))\n749|\t}\n750|\tfor _, path := range files {\n751|\t\tif !names[filepath.Base(path)] {\n752|\t\t\tt.Fatalf(\"unexpected production file %q: register it here or the census ignores it\", path)\n753|\t\t}\n754|\t}\n755|}\n756|\n757|// TestDerivedRefusalArmsAreAllWitnessed requires every derived\n758|// arm to carry a witness or a recorded defensive rationale: an\n759|// arm nobody drives is next round's finding, stated here instead.\n760|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n761|\tderived := deriveRefusalArms(t)\n762|\tif len(derived.violations) > 0 {\n763|\t\tsort.Strings(derived.violations)\n764|\t\tt.Fatalf(\"census violations:\\n  %s\", strings.Join(derived.violations, \"\\n  \"))\n765|\t}\n766|\tvar missing []string\n767|\tfor arm := range derived.arms {\n768|\t\tif _, witnessed := armWitnesses[arm]; witnessed {\n769|\t\t\tcontinue\n770|\t\t}\n771|\t\tif _, defensive := defensiveArms[arm]; defensive {\n772|\t\t\tcontinue\n773|\t\t}\n774|\t\tmissing = append(missing, arm)\n775|\t}\n776|\tsort.Strings(missing)\n777|\tif len(missing) > 0 {\n778|\t\tt.Fatalf(\"unwitnessed arms:\\n  %s\", strings.Join(missing, \"\\n  \"))\n779|\t}\n780|\tt.Logf(\"census: %d arms witnessed, %d defensive, %d constructors\", len(armWitnesses), len(defensiveArms), len(derived.ctors))\n781|}\n782|\n783|// TestWitnessedArmsAreAllDerived requires every witness row to\n784|// name a derived arm: a truncated derivation reddens on the\n785|// orphaned witnesses instead of passing vacuously.\n786|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n787|\tderived := deriveRefusalArms(t)\n788|\tif len(derived.violations) > 0 {\n789|\t\tsort.Strings(derived.violations)\n790|\t\tt.Fatalf(\"census violations:\\n  %s\", strings.Join(derived.violations, \"\\n  \"))\n791|\t}\n792|\tvar orphaned []string\n793|\tfor arm := range armWitnesses {\n794|\t\tif !derived.arms[arm] {\n795|\t\t\torphaned = append(orphaned, arm)\n796|\t\t}\n797|\t}\n798|\tfor arm := range defensiveArms {\n799|\t\tif !derived.arms[arm] {\n800|\t\t\torphaned = append(orphaned, arm+\" (defensive)\")\n801|\t\t}\n802|\t}\n803|\tsort.Strings(orphaned)\n804|\tif len(orphaned) > 0 {\n805|\t\tt.Fatalf(\"orphaned witness rows:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n806|\t}\n807|}\n808|\n809|// TestWitnessesResolve requires every named witness to exist as\n810|// a test function in this package's test files: a witness that\n811|// names nothing proves nothing.\n812|func TestWitnessesResolve(t *testing.T) {\n813|\tdefined := map[string]bool{}\n814|\tentries, err := os.ReadDir(\".\")\n815|\tif err != nil {\n816|\t\tt.Fatalf(\"witness resolve: %v\", err)\n817|\t}\n818|\tfor _, entry := range entries {\n819|\t\tname := entry.Name()\n(more lines below)"}}}
