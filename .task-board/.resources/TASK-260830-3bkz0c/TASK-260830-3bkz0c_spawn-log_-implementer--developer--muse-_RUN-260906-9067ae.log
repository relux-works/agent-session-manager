{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c745","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":509,"recorded_at":1780531400001013,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a07666196d7573a13096f55fb70386","text":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped. Failure details carry the failure class and member names\n38|\t// only, never stderr content.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil, time.Time{}, failure\n199|\t}\n200|\tdeadline, err := req.Deadline.Time()\n201|\tif err != nil {\n202|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n203|\t\tif fault != nil {\n204|\t\t\treturn nil, time.Time{}, fault\n205|\t\t}\n206|\t\treturn nil, time.Time{}, failure\n207|\t}\n208|\tif !deadline.After(now) {\n209|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n210|\t\tif fault != nil {\n211|\t\t\treturn nil, time.Time{}, fault\n212|\t\t}\n213|\t\treturn nil, time.Time{}, failure\n214|\t}\n215|\tif !isJSONObject(req.Body) {\n216|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n217|\t\tif fault != nil {\n218|\t\t\treturn nil, time.Time{}, fault\n219|\t\t}\n220|\t\treturn nil, time.Time{}, failure\n221|\t}\n222|\t// The operation, request ID, deadline, and body above were each\n223|\t// validated before this marshal, so it cannot fail on a reachable\n224|\t// path: the error propagates as a plain Go error rather than\n225|\t// through a refusal site no negative test could exercise.\n226|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n227|\tif err != nil {\n228|\t\treturn nil, time.Time{}, err\n229|\t}\n230|\tif len(frame) > MaxFrameBytes {\n231|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n232|\t\tif fault != nil {\n233|\t\t\treturn nil, time.Time{}, fault\n234|\t\t}\n235|\t\treturn nil, time.Time{}, failure\n236|\t}\n237|\treturn frame, deadline, nil\n238|}\n239|\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n262|// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n263|// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n264|// raw bytes are screened before any member is trusted. The\n265|// lone-surrogate gate runs next: encoding/json would likewise replace\n266|// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n267|// reject lone surrogate code points).\n268|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n269|\tif !utf8.Valid(data) {\n270|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n271|\t}\n272|\tif hasLoneSurrogateEscape(data) {\n273|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n274|\t}\n275|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n276|\ttoken, err := decoder.Token()\n277|\tif err != nil {\n278|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n279|\t}\n280|\tdelim, ok := token.(json.Delim)\n281|\tif !ok || delim != '{' {\n282|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n283|\t}\n284|\tmembers := map[string]json.RawMessage{}\n285|\tfor decoder.More() {\n286|\t\tkeyToken, err := decoder.Token()\n287|\t\tif err != nil {\n288|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n289|\t\t}\n290|\t\tkey, ok := keyToken.(string)\n291|\t\tif !ok {\n292|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n293|\t\t}\n294|\t\tif _, duplicate := members[key]; duplicate {\n295|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n296|\t\t}\n297|\t\tvar raw json.RawMessage\n298|\t\tif err := decoder.Decode(&raw); err != nil {\n299|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n300|\t\t}\n301|\t\tmembers[key] = raw\n302|\t}\n303|\tif token, err := decoder.Token(); err != nil {\n304|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n305|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n306|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n307|\t}\n308|\tif _, err := decoder.Token(); err != io.EOF {\n309|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n310|\t}\n311|\treturn members, nil\n312|}\n313|\n314|// responseMembers is the exact Section 7.2 response member set: the four\n315|// framing members plus body on success or error on failure, never both,\n316|// never neither, and nothing else. It is package-level so the closed\n317|// vocabulary census derives it: widening the accepted set here must redden\n318|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n319|var responseMembers = map[string]bool{\n320|\t\"protocol\":         true,\n321|\t\"protocol_version\": true,\n322|\t\"request_id\":       true,\n323|\t\"ok\":               true,\n324|\t\"body\":             true,\n325|\t\"error\":            true,\n326|}\n327|\n328|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n329|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n330|\tfor _, name := range required {\n331|\t\tif _, present := members[name]; !present {\n332|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n333|\t\t}\n334|\t}\n335|\tif ok {\n336|\t\tif _, present := members[\"body\"]; !present {\n337|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n338|\t\t}\n339|\t\tif _, forbidden := members[\"error\"]; forbidden {\n340|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n341|\t\t}\n342|\t} else {\n343|\t\tif _, present := members[\"error\"]; !present {\n344|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n345|\t\t}\n346|\t\tif _, forbidden := members[\"body\"]; forbidden {\n347|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n348|\t\t}\n349|\t}\n350|\tfor name := range members {\n351|\t\tif !responseMembers[name] {\n352|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n353|\t\t}\n354|\t}\n355|\treturn nil\n356|}\n357|\n358|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n359|// Anything else is not a recognizable major, so the frame is unusable\n360|// rather than a mismatch.\n361|func parseMajor(version string) (int, bool) {\n362|\tparts := strings.Split(version, \".\")\n363|\tif len(parts) != 3 {\n364|\t\treturn 0, false\n365|\t}\n366|\tmajor := 0\n367|\tfor i := 0; i < len(parts[0]); i++ {\n368|\t\tdigit := parts[0][i]\n369|\t\tif digit < '0' || digit > '9' {\n370|\t\t\treturn 0, false\n371|\t\t}\n372|\t\tmajor = major*10 + int(digit-'0')\n373|\t}\n374|\tif len(parts[0]) == 0 {\n375|\t\treturn 0, false\n376|\t}\n377|\tfor _, rest := range parts[1:] {\n378|\t\tif len(rest) == 0 {\n379|\t\t\treturn 0, false\n380|\t\t}\n381|\t\tfor i := 0; i < len(rest); i++ {\n382|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n383|\t\t\t\treturn 0, false\n384|\t\t\t}\n385|\t\t}\n386|\t}\n387|\treturn major, true\n388|}\n389|\n390|// providerContract is the static Section 7.2 binding every failure\n391|// envelope is decoded under: provider protocol major 2 binds Structured\n392|// Error 1.0.0. The version is never taken from the document.\n393|var providerContract = axerror.ContainingContract{ID: \"urn:ax:protocol:provider\", Major: 2}\n394|\n395|// DecodeResponse validates one stdout line as the single response frame\n396|// for the request carrying wantRequestID. It returns the success body, or\n397|// the bound child failure, or a local failure that trusts nothing from\n398|// the frame. A recognizable foreign major yields incompatible_protocol;\n399|// every other unusable frame yields provider_protocol_error.\n400|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n401|\tif len(frame) > MaxFrameBytes {\n402|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n403|\t\tif err != nil {\n404|\t\t\treturn Response{}, err\n405|\t\t}\n406|\t\treturn Response{}, failure\n407|\t}\n408|\tif !utf8.Valid(frame) {\n409|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n410|\t\tif err != nil {\n411|\t\t\treturn Response{}, err\n412|\t\t}\n413|\t\treturn Response{}, failure\n414|\t}\n415|\tmembers, fault := decodeStrictObject(frame)\n416|\tif fault != nil {\n417|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n418|\t\tif err != nil {\n419|\t\t\treturn Response{}, err\n420|\t\t}\n421|\t\treturn Response{}, failure\n422|\t}\n423|\t// foreignMajor peeks at the envelope identity before any v2\n424|\t// member rule runs. A recognizable foreign major is\n425|\t// incompatible_protocol no matter what members it carries, so\n426|\t// the v2 member vocabulary below must not judge it first: a\n427|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n428|\t// is a foreign major, not an unknown or missing member. The\n429|\t// peek trusts nothing and refuses nothing: it only arms when\n430|\t// the protocol member is exactly this protocol and the version\n431|\t// member is a string with a recognizable foreign major. A frame\n432|\t// without our protocol identity, or without a readable version,\n433|\t// falls through to the member rules, which keep their verdicts.\n434|\tforeignMajor := \"\"\n435|\tif rawProtocol, present := members[\"protocol\"]; present {\n436|\t\tvar protocol string\n437|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n438|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n439|\t\t\t\tvar version string\n440|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n441|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n442|\t\t\t\t\t\tforeignMajor = version\n443|\t\t\t\t\t}\n444|\t\t\t\t}\n445|\t\t\t}\n446|\t\t}\n447|\t}\n448|\tvar ok bool\n449|\tif foreignMajor == \"\" {\n450|\t\tif raw, present := members[\"ok\"]; !present {\n451|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn Response{}, err\n454|\t\t\t}\n455|\t\t\treturn Response{}, failure\n456|\t\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n457|\t\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n458|\t\t\tif fault != nil {\n459|\t\t\t\treturn Response{}, fault\n460|\t\t\t}\n461|\t\t\treturn Response{}, failure\n462|\t\t}\n463|\t\tif fault := checkResponseMembers(members, ok); fault != nil {\n464|\t\t\tfailure, err := failProtocol(fault.detail, fault.member)\n465|\t\t\tif err != nil {\n466|\t\t\t\treturn Response{}, err\n467|\t\t\t}\n468|\t\t\treturn Response{}, failure\n469|\t\t}\n470|\t}\n471|\tvar protocol string\n472|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n473|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n474|\t\tif fault != nil {\n475|\t\t\treturn Response{}, fault\n476|\t\t}\n477|\t\treturn Response{}, failure\n478|\t}\n479|\tvar version string\n480|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n481|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n482|\t\tif fault != nil {\n483|\t\t\treturn Response{}, fault\n484|\t\t}\n485|\t\treturn Response{}, failure\n486|\t}\n487|\tif version != ProtocolVersion {\n488|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n489|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n490|\t\t\tif err != nil {\n491|\t\t\t\treturn Response{}, err\n492|\t\t\t}\n493|\t\t\treturn Response{}, failure\n494|\t\t}\n495|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n496|\t\tif fault != nil {\n497|\t\t\treturn Response{}, fault\n498|\t\t}\n499|\t\treturn Response{}, failure\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c747","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":510,"recorded_at":1780531400001015,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a076661a037572a664ddda9d551ebc","text":"Read text file `internal/environ/doc.go`.\n1|// Package environ is the single environment library behind the\n2|// Provider, Session Adapter, and Directory Node facades.\n3|//\n4|// Pinned specification v0.5.0 requires the Directory Node facade to\n5|// expose source-local environment discovery \"through the same\n6|// parsers, identity logic, redaction rules, tuple gates, and\n7|// fixtures as the Provider and Session Adapter facades\" (Section\n8|// 3.1), backed by \"the same environment implementation as Provider\n9|// 2 and Session Adapter 1\" (Sections 7.9, 10.8, 13.14). Before this\n10|// package each facade carried its own copy of those rules, and\n11|// independent copies of the same rule drift in ways no per-facade\n12|// reviewer can see. This package is the one implementation every\n13|// facade must converge on:\n14|//\n15|//   - frame parsing: DecodeStrictObject is the only JSON entry\n16|//     point, with duplicate-member rejection and the Section 1.6\n17|//     lone-surrogate gate in canonical string-walk semantics;\n18|//   - string measure: CheckStringBounds counts Unicode characters\n19|//     (runes), never bytes and never UTF-16 code units;\n20|//   - shared grammars: the environment-id, provider-id (via\n21|//     scalar), SemVer, platform, and architecture rules;\n22|//   - tuple gates: DecodeTuple admits the exact six-member\n23|//     Environment Tuple of Sections 7.8 and 13.14, which never\n24|//     carries executable provenance or extensions;\n25|//   - observation gates: DecodeEnvironmentObservation admits the\n26|//     Section 10.8.1 Environment Observation, reusing the tuple\n27|//     admission model rather than creating a second one.\n28|//\n29|// Every refusal is a plain error whose text names the rule and the\n30|// member: facades keep their own refusal dialects (Structured\n31|// Error codes per protocol), so this package names rules instead\n32|// of minting codes, and the boundary battery pins each facade's\n33|// rendering separately.\n34|//\n35|// Stated bounds. Provider Identity refusal dialects stay in\n36|// provhost and canonicaljson: the two validators must agree\n37|// rule-for-rule and the agreement battery in this package pins\n38|// that, but a third validator here would be another copy, not\n39|// convergence. Byte-counted exec rules (Provider SpawnPlan argv\n40|// and env literals, Section 5.1) stay in provhost: they bound\n41|// bytes by specification while every character-bound member in\n42|// this story counts runes, and the measure battery ledgers that\n43|// split. The tuple-registry signature, sequence monotonicity, and\n44|// publication rules of Section 13.14 fail closed at the registry\n45|// owner, which does not exist yet. This package mutates no durable\n46|// state and keeps no cache: every entry point is a pure function\n47|// of its input bytes.\n48|package environ","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c749","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":511,"recorded_at":1780531400001017,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a076661a9571b2b174583068825b98","text":"Read text file `internal/environ/identity_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file is the Provider Identity agreement battery. Two\n16|// validators implement the Section 5.5 shape rule-for-rule:\n17|// provhost.CheckIdentity mints provider-stdio refusals while\n18|// canonicaljson validates the same record through the closed\n19|// identity shape on the way to its object identity. A shape-rule\n20|// change must land in both validators in the same change, and\n21|// this battery is what fails when it lands in only one: every\n22|// row drives one shared vector through both production entries\n23|// and requires identical verdicts with the full rendering on\n24|// each side.\n25|//\n26|// One split is by design, not drift: provider equality (the\n27|// record naming the expected provider) is a caller-correlation\n28|// rule the host enforces, not a content rule the identity\n29|// calculation owns. The another-provider row ledgers that split\n30|// exactly — provhost refuses invalid_config while the\n31|// canonicalizer accepts — so a content-rule divergence cannot\n32|// hide behind it and a change to the split reddens here.\n33|\n34|// identityRow is one agreement vector: the body, the provhost\n35|// rule phrase, and the canonicalizer rule phrase. Empty phrases\n36|// mean both entries accept.\n37|type identityRow struct {\n38|\tname      string\n39|\tbody      []byte\n40|\tprovText  string\n41|\tcanonText string\n42|}\n43|\n44|// identityCorpus mutates each identity member alone against an\n45|// otherwise-valid record over the shared fixture identities.\n46|func identityCorpus(t *testing.T) []identityRow {\n47|\tt.Helper()\n48|\tvalid := validIdentityJSON()\n49|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n50|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n51|\totherSubject := jsonQuote(fixtureCreatorHostID)\n52|\treturn []identityRow{\n53|\t\t{\"valid\", valid, \"\", \"\"},\n54|\t\t{\"unknown member\", appendMember(t, valid, \"score\", `1`), \"identity carries unknown member\", \"unknown member\"},\n55|\t\t{\"missing opaque\", drop(\"opaque_identity\"), \"identity misses a required member\", \"required member\"},\n56|\t\t// Schema dispatch precedes shape validation in the\n57|\t\t// canonicalizer: a wrong schema or version refuses at\n58|\t\t// the dispatch registry, never reaching the identity\n59|\t\t// rules provhost enforces as member arms. Same\n60|\t\t// verdict, different arm by construction; a schema\n61|\t\t// change must update the dispatch registry and both\n62|\t\t// validators together.\n63|\t\t{\"wrong schema\", set(\"schema\", `\"urn:ax:schema:provider-manifest\"`), \"identity schema is not the provider identity\", \"has no supported immutable self-identity contract\"},\n64|\t\t{\"wrong version\", set(\"schema_version\", `\"1.1.0\"`), \"identity schema_version is not 1.0.0\", \"has no supported immutable self-identity contract\"},\n65|\t\t{\"bad record digest\", set(\"record_id\", `\"sha256:zzzz\"`), \"identity record_id is not a digest\", \"record_id\"},\n66|\t\t{\"bad subject uuid\", set(\"subject_id\", `\"not-a-uuid\"`), \"identity subject_id is not a UUIDv7\", \"subject_id\"},\n67|\t\t{\"subject differs\", set(\"subject_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n68|\t\t{\"session differs\", set(\"session_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n69|\t\t{\"bad provider grammar\", set(\"provider_id\", `\"Antigravity\"`), \"identity provider_id is not a provider id\", \"provider_id\"},\n70|\t\t{\"empty version\", set(\"provider_version\", `\"\"`), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n71|\t\t{\"long version\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n72|\t\t{\"empty range\", set(\"provider_version_range\", `\"\"`), \"identity provider_version_range is not 1..256 characters\", \"provider_version_range\"},\n73|\t\t{\"empty native id\", set(\"native_session_id\", `\"\"`), \"identity native_session_id is not 1..512 characters\", \"native_session_id\"},\n74|\t\t{\"unknown kind\", set(\"identity_kind\", `\"telepathy\"`), \"identity kind is not a registry member\", \"identity_kind\"},\n75|\t\t{\"bad workspace uuid\", set(\"logical_workspace_id\", `\"not-a-uuid\"`), \"identity workspace is not a UUIDv7\", \"logical_workspace_id\"},\n76|\t\t{\"bad realm\", set(\"backend_realm_fingerprint\", `\"sha256:zzzz\"`), \"identity realm is not a digest or null\", \"backend_realm_fingerprint\"},\n77|\t\t{\"null realm refused\", set(\"backend_realm_fingerprint\", `null`), \"identity realm is required for this backend kind\", \"must be non-null for Antigravity\"},\n78|\t\t{\"opaque array refused\", set(\"opaque_identity\", `[]`), \"not a JSON object\", \"opaque_identity\"},\n79|\t\t{\"opaque 33 keys refused\", set(\"opaque_identity\", opaqueKeysJSON(33)), \"exceeds 32 entries\", \"exceeds maximum length 32\"},\n80|\t\t{\"opaque bad key\", set(\"opaque_identity\", `{\"K\":\"v\"}`), \"identity opaque key is not a provider key\", \"must match\"},\n81|\t\t{\"opaque empty value\", set(\"opaque_identity\", `{\"k\":\"\"}`), \"identity opaque value is not 1..1024 characters\", \"1..1024\"},\n82|\t\t{\"opaque absolute path\", set(\"opaque_identity\", `{\"k\":\"/etc/passwd\"}`), \"begins with an absolute path\", \"must not begin with an absolute path\"},\n83|\t\t{\"bad creator uuid\", set(\"created_by_host_id\", `\"not-a-uuid\"`), \"identity host is not a UUIDv7\", \"created_by_host_id\"},\n84|\t\t{\"bad timestamp\", set(\"created_at\", `\"yesterday\"`), \"identity timestamp is not a timestamp\", \"created_at\"},\n85|\t\t{\"extensions array refused\", set(\"extensions\", `[]`), \"identity extensions is not an object\", \"extensions\"},\n86|\t\t{\"lone escape refused\", set(\"opaque_identity\", `{\"k\":\"A`+rawLoneHigh+`B\"}`), \"lone surrogate escape\", \"surrogate\"},\n87|\t\t{\"escaped text admits\", set(\"opaque_identity\", `{\"k\":\"A`+rawEscapedHigh+`B\"}`), \"\", \"\"},\n88|\t}\n89|}\n90|\n91|// Raw escape fragments. rawLoneHigh is a real lone high escape\n92|// in JSON source; rawEscapedHigh is an escaped backslash\n93|// followed by text, which carries no escape at all. Both are\n94|// package variables (not literals) so the Go compiler never\n95|// sees an invalid \\u escape in source.\n96|var (\n97|\trawLoneHigh    = \"\\\\ud800\"\n98|\trawEscapedHigh = \"\\\\\\\\ud800\"\n99|)\n100|\n101|// opaqueKeysJSON builds an opaque_identity object with count\n102|// grammar-valid keys.\n103|func opaqueKeysJSON(count int) string {\n104|\tparts := make([]string, 0, count)\n105|\tfor index := 0; index < count; index++ {\n106|\t\tparts = append(parts, `\"k`+twoDigits(index)+`\":\"v\"`)\n107|\t}\n108|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n109|}\n110|\n111|func twoDigits(value int) string {\n112|\tdigits := \"0123456789\"\n113|\treturn string([]byte{digits[value/10%10], digits[value%10]})\n114|}\n115|\n116|// TestIdentityAgreementAcrossValidators drives the corpus\n117|// through both identity entries and requires identical verdicts\n118|// with the full rule rendering on each side.\n119|func TestIdentityAgreementAcrossValidators(t *testing.T) {\n120|\tfor _, row := range identityCorpus(t) {\n121|\t\tt.Run(row.name, func(t *testing.T) {\n122|\t\t\tprovErr := provhost.CheckIdentity(row.body, \"antigravity\")\n123|\t\t\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(row.body)\n124|\t\t\tif row.provText == \"\" && row.canonText == \"\" {\n125|\t\t\t\tif provErr != nil {\n126|\t\t\t\t\tt.Fatalf(\"provhost refused %s: %v\", row.body, provErr)\n127|\t\t\t\t}\n128|\t\t\t\tif canonErr != nil {\n129|\t\t\t\t\tt.Fatalf(\"canonicaljson refused %s: %v\", row.body, canonErr)\n130|\t\t\t\t}\n131|\t\t\t\treturn\n132|\t\t\t}\n133|\t\t\tif provErr == nil {\n134|\t\t\t\tt.Fatalf(\"provhost admitted %s, want rule %q\", row.body, row.provText)\n135|\t\t\t}\n136|\t\t\tif canonErr == nil {\n137|\t\t\t\tt.Fatalf(\"canonicaljson admitted %s, want rule %q\", row.body, row.canonText)\n138|\t\t\t}\n139|\t\t\tif !strings.Contains(provErr.Error(), row.provText) {\n140|\t\t\t\tt.Fatalf(\"provhost error = %v, want rule %q\", provErr, row.provText)\n141|\t\t\t}\n142|\t\t\tif !strings.Contains(canonErr.Error(), row.canonText) {\n143|\t\t\t\tt.Fatalf(\"canonicaljson error = %v, want rule %q\", canonErr, row.canonText)\n144|\t\t\t}\n145|\t\t})\n146|\t}\n147|}\n148|\n149|// TestIdentityProviderEqualityIsCallerRule ledgers the one\n150|// by-design split: a well-formed record for another provider is\n151|// a caller-correlation failure (invalid_config) at the host,\n152|// while the identity calculation accepts the content. Neither\n153|// side may change its half silently.\n154|func TestIdentityProviderEqualityIsCallerRule(t *testing.T) {\n155|\tbody := mutateMember(t, validIdentityJSON(), \"provider_id\", `\"codex\"`)\n156|\tprovErr := provhost.CheckIdentity(body, \"antigravity\")\n157|\tif provErr == nil {\n158|\t\tt.Fatalf(\"provhost admitted a record for another provider\")\n159|\t}\n160|\tif !strings.Contains(provErr.Error(), \"identity names another provider\") {\n161|\t\tt.Fatalf(\"provhost error = %v, want the caller-correlation arm\", provErr)\n162|\t}\n163|\tif _, _, canonErr := canonicaljson.CalculateObjectIdentity(body); canonErr != nil {\n164|\t\tt.Fatalf(\"canonicaljson refused well-formed content for another provider: %v\", canonErr)\n165|\t}\n166|}\n167|\n168|// TestIdentityMemberTablesAreOneTable requires the provhost\n169|// required-member table and the canonicalizer's exact-member\n170|// list for the identity record to carry the same members in the\n171|// same order: multi-missing determinism is shared behavior.\n172|func TestIdentityMemberTablesAreOneTable(t *testing.T) {\n173|\tmine := deriveRequiredList(t, \"provhost\", \"identity.go\", \"identityRequired\")\n174|\ttheirs := deriveIdentityExactMembers(t)\n175|\tif len(mine) != len(theirs) {\n176|\t\tt.Fatalf(\"identity member tables differ in size:\\nprovhost: %q\\ncanonicaljson: %q\", mine, theirs)\n177|\t}\n178|\tfor index := range mine {\n179|\t\tif mine[index] != theirs[index] {\n180|\t\t\tt.Fatalf(\"identity member tables differ at %d:\\nprovhost: %q\\ncanonicaljson: %q\", index, mine, theirs)\n181|\t\t}\n182|\t}\n183|}\n184|\n185|// deriveIdentityExactMembers derives the member list from the\n186|// requireExactMembers call for the Provider Identity Record in\n187|// canonicaljson production.\n188|func deriveIdentityExactMembers(t *testing.T) []string {\n189|\tt.Helper()\n190|\tpath := mustInternalRoot(t) + \"/canonicaljson/core_records.go\"\n191|\tsource, err := os.ReadFile(path)\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"identity members: %v\", err)\n194|\t}\n195|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"identity members: %v\", err)\n198|\t}\n199|\tfound := false\n200|\tvar members []string\n201|\tast.Inspect(syntax, func(node ast.Node) bool {\n202|\t\tcall, ok := node.(*ast.CallExpr)\n203|\t\tif !ok || found {\n204|\t\t\treturn true\n205|\t\t}\n206|\t\ttarget, ok := call.Fun.(*ast.Ident)\n207|\t\tif !ok || target.Name != \"requireExactMembers\" || len(call.Args) < 3 {\n208|\t\t\treturn true\n209|\t\t}\n210|\t\tfirst, ok := call.Args[0].(*ast.BasicLit)\n211|\t\tif !ok || strings.Trim(first.Value, `\"`) != \"Provider Identity Record\" {\n212|\t\t\treturn true\n213|\t\t}\n214|\t\tfor _, arg := range call.Args[2:] {\n215|\t\t\tliteral, ok := arg.(*ast.BasicLit)\n216|\t\t\tif !ok {\n217|\t\t\t\tt.Fatalf(\"identity members: exact-member list is not literals; the extractor cannot see through indirection\")\n218|\t\t\t}\n219|\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n220|\t\t}\n221|\t\tfound = true\n222|\t\treturn false\n223|\t})\n224|\tif !found {\n225|\t\tt.Fatal(\"identity members: requireExactMembers call for the Provider Identity Record not found; the extractor is blind\")\n226|\t}\n227|\treturn members\n228|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
