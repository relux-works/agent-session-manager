{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f3","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":212,"recorded_at":1780531400000419,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a0766545577eb2bb363cd48fd11589","text":"Read text file `internal/environ/decode.go`.\n1|package environ\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"io\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// maxUint53 is the largest exactly representable JSON integer:\n17|// counts and limits are uint53 throughout the pinned\n18|// specification.\n19|const maxUint53 = uint64(1<<53 - 1)\n20|\n21|// Fault is one strict-decode failure: what was wrong and which\n22|// member it was found in, if any. It never carries foreign bytes.\n23|// The five details are the complete fault space: every body this\n24|// package refuses at the frame layer carries exactly one of them,\n25|// and the frame-agreement battery derives its denominator from\n26|// this list, so a sixth fault shape fails the census instead of\n27|// passing silently.\n28|type Fault struct {\n29|\tDetail string\n30|\tMember string\n31|}\n32|\n33|func (fault *Fault) Error() string {\n34|\tif fault.Member == \"\" {\n35|\t\treturn \"environment frame \" + fault.Detail\n36|\t}\n37|\treturn \"environment frame \" + fault.Detail + \" in member \" + fault.Member\n38|}\n39|\n40|// Frame fault details. Each is a constant so the agreement battery\n41|// derives the fault space from production source instead of\n42|// retyping it: a reworded fault fails its row rather than passing\n43|// against a stale copy.\n44|const (\n45|\tFaultNotUTF8       = \"not valid UTF-8\"\n46|\tFaultLoneSurrogate = \"lone surrogate escape\"\n47|\tFaultNotObject     = \"not a JSON object\"\n48|\tFaultDuplicate     = \"duplicate member\"\n49|\tFaultTrailing      = \"trailing data after the object\"\n50|)\n51|\n52|// DecodeStrictObject parses one complete JSON object with\n53|// duplicate member rejection. It is the only JSON entry point in\n54|// this package: every body crosses it before any member is read.\n55|// A non-UTF-8 frame, a lone surrogate escape, a non-object top\n56|// level, a duplicated member, or trailing data is a fault, never\n57|// a partial object the caller could mistake for a result.\n58|func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\n59|\tif !utf8.Valid(data) {\n60|\t\treturn nil, &Fault{Detail: FaultNotUTF8}\n61|\t}\n62|\tif HasLoneSurrogateEscape(data) {\n63|\t\treturn nil, &Fault{Detail: FaultLoneSurrogate}\n64|\t}\n65|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n66|\ttoken, err := decoder.Token()\n67|\tif err != nil {\n68|\t\treturn nil, &Fault{Detail: FaultNotObject}\n69|\t}\n70|\tdelim, ok := token.(json.Delim)\n71|\tif !ok || delim != '{' {\n72|\t\treturn nil, &Fault{Detail: FaultNotObject}\n73|\t}\n74|\tmembers := map[string]json.RawMessage{}\n75|\tfor decoder.More() {\n76|\t\tkeyToken, err := decoder.Token()\n77|\t\tif err != nil {\n78|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n79|\t\t}\n80|\t\tkey, ok := keyToken.(string)\n81|\t\tif !ok {\n82|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n83|\t\t}\n84|\t\tif _, duplicate := members[key]; duplicate {\n85|\t\t\treturn nil, &Fault{Detail: FaultDuplicate, Member: key}\n86|\t\t}\n87|\t\tvar raw json.RawMessage\n88|\t\tif err := decoder.Decode(&raw); err != nil {\n89|\t\t\treturn nil, &Fault{Detail: FaultNotObject, Member: key}\n90|\t\t}\n91|\t\tmembers[key] = raw\n92|\t}\n93|\tif token, err := decoder.Token(); err != nil {\n94|\t\treturn nil, &Fault{Detail: FaultNotObject}\n95|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n96|\t\treturn nil, &Fault{Detail: FaultNotObject}\n97|\t}\n98|\tif _, err := decoder.Token(); err != io.EOF {\n99|\t\treturn nil, &Fault{Detail: FaultTrailing}\n100|\t}\n101|\treturn members, nil\n102|}\n103|\n104|// HasLoneSurrogateEscape reports whether the raw frame carries a\n105|// UTF-16 escape the JSON string grammar cannot pair. Go's\n106|// encoding/json would otherwise replace the lone escape with\n107|// U+FFFD silently, so wire bodies carrying lone surrogates would\n108|// be admitted with rewritten bytes.\n109|//\n110|// The walk is string-aware: only escapes inside JSON strings\n111|// count, and a backslash escape consumes both bytes, so the text\n112|// \"\\\\ud800\" (backslash-plus-text, JSON source `\"\\\\ud800\"`) is\n113|// not an escape and is admitted. A scanner that matches every\n114|// `\\u` byte pair regardless of string context refuses that text:\n115|// that false positive is exactly the recorded sessadapter and\n116|// dirnode divergence the frame-agreement battery ledgers, and any\n117|// change to it fails there in either direction.\n118|func HasLoneSurrogateEscape(data []byte) bool {\n119|\tfor index := 0; index < len(data); index++ {\n120|\t\tif data[index] != '\"' {\n121|\t\t\tcontinue\n122|\t\t}\n123|\t\tfor index++; index < len(data); index++ {\n124|\t\t\tswitch data[index] {\n125|\t\t\tcase '\"':\n126|\t\t\t\tgoto stringComplete\n127|\t\t\tcase '\\\\':\n128|\t\t\t\tindex++\n129|\t\t\t\tif index >= len(data) || data[index] != 'u' {\n130|\t\t\t\t\tcontinue\n131|\t\t\t\t}\n132|\t\t\t\tunit, end, ok := readUTF16Escape(data, index-1)\n133|\t\t\t\tif !ok {\n134|\t\t\t\t\t// Not a well-formed \\uXXXX escape: the\n135|\t\t\t\t\t// JSON-syntax arms own it, not this gate.\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tindex = end - 1\n139|\t\t\t\tswitch {\n140|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n141|\t\t\t\t\tsecond, _, ok := readUTF16Escape(data, end)\n142|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n143|\t\t\t\t\t\treturn true\n144|\t\t\t\t\t}\n145|\t\t\t\t\tindex = end + 6 - 1\n146|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n147|\t\t\t\t\treturn true\n148|\t\t\t\t}\n149|\t\t\t}\n150|\t\t}\n151|\t\t// An unterminated string owns no surrogate verdict: the\n152|\t\t// frame is not JSON at all, so the syntax arms refuse it\n153|\t\t// as not-a-JSON-object rather than misattributing it\n154|\t\t// here.\n155|\t\treturn false\n156|\tstringComplete:\n157|\t}\n158|\treturn false\n159|}\n160|\n161|// readUTF16Escape reads one \\uXXXX escape starting at the offset.\n162|// It reports the unit value and the offset just past the escape,\n163|// or false when the escape is truncated or not hexadecimal.\n164|func readUTF16Escape(data []byte, offset int) (uint16, int, bool) {\n165|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n166|\t\treturn 0, offset, false\n167|\t}\n168|\tvalue, err := strconv.ParseUint(string(data[offset+2:offset+6]), 16, 16)\n169|\tif err != nil {\n170|\t\treturn 0, offset, false\n171|\t}\n172|\treturn uint16(value), offset + 6, true\n173|}\n174|\n175|// unknownMember names a member outside the closed set, if any.\n176|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n177|\tfor name := range members {\n178|\t\tif !allowed[name] {\n179|\t\t\treturn name, true\n180|\t\t}\n181|\t}\n182|\treturn \"\", false\n183|}\n184|\n185|// missingMember names the first required member with no value, if\n186|// any. The required list is fixed order, so the verdict is\n187|// deterministic for every missing combination.\n188|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n189|\tfor _, name := range required {\n190|\t\tif _, present := members[name]; !present {\n191|\t\t\treturn name, true\n192|\t\t}\n193|\t}\n194|\treturn \"\", false\n195|}\n196|\n197|// rawString reads a JSON string member.\n198|func rawString(raw json.RawMessage) (string, bool) {\n199|\tvar value string\n200|\tif err := json.Unmarshal(raw, &value); err != nil {\n201|\t\treturn \"\", false\n202|\t}\n203|\treturn value, true\n204|}\n205|\n206|// rawUint53 reads an unsigned integral JSON number in [0,\n207|// 2^53-1]. A fraction, exponent, sign, or out-of-range magnitude\n208|// is not a uint53, even when it names the same mathematical\n209|// value: the bodies carry counts, never measurements.\n210|func rawUint53(raw json.RawMessage) (uint64, bool) {\n211|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n212|\tdecoder.UseNumber()\n213|\tvar value any\n214|\tif err := decoder.Decode(&value); err != nil {\n215|\t\treturn 0, false\n216|\t}\n217|\tnumber, ok := value.(json.Number)\n218|\tif !ok {\n219|\t\treturn 0, false\n220|\t}\n221|\tliteral := number.String()\n222|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n223|\t\treturn 0, false\n224|\t}\n225|\treturn parseUint53Literal(literal)\n226|}\n227|\n228|// parseUint53Literal reads a digit-only literal without trusting\n229|// a float conversion: the magnitude bound is checked on the digit\n230|// string, so 2^53 is refused even on platforms that could hold\n231|// it.\n232|func parseUint53Literal(literal string) (uint64, bool) {\n233|\tvar value uint64\n234|\tfor index := 0; index < len(literal); index++ {\n235|\t\tdigit := literal[index]\n236|\t\tif digit < '0' || digit > '9' {\n237|\t\t\treturn 0, false\n238|\t\t}\n239|\t\tvalue = value*10 + uint64(digit-'0')\n240|\t\tif value > maxUint53 {\n241|\t\t\treturn 0, false\n242|\t\t}\n243|\t}\n244|\treturn value, true\n245|}\n246|\n247|// StringLength is the Section 1.6 string measure in characters,\n248|// not bytes: a bound of string[1..128] admits 128 characters of\n249|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n250|// env literals, Section 5.1) do not go through here; the measure\n251|// battery ledgers that split.\n252|func StringLength(value string) int {\n253|\treturn utf8.RuneCountInString(value)\n254|}\n255|\n256|// CheckStringBounds reports whether the member is a JSON string\n257|// whose character count falls in the inclusive bound.\n258|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n259|\tvalue, ok := rawString(raw)\n260|\tif !ok {\n261|\t\treturn \"\", false\n262|\t}\n263|\tlength := StringLength(value)\n264|\tif length < minimum || length > maximum {\n265|\t\treturn \"\", false\n266|\t}\n267|\treturn value, true\n268|}\n269|\n270|// CheckUint53Bounds reports whether the member is a uint53 in the\n271|// inclusive bound. Both edges are checked: a one-sided check\n272|// would admit the open side.\n273|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n274|\tvalue, ok := rawUint53(raw)\n275|\tif !ok {\n276|\t\treturn 0, false\n277|\t}\n278|\tif value < minimum || value > maximum {\n279|\t\treturn 0, false\n280|\t}\n281|\treturn value, true\n282|}\n283|\n284|// CheckDigest reports whether the member is a digest of the\n285|// pinned sha256 form.\n286|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n287|\tvalue, ok := rawString(raw)\n288|\tif !ok {\n289|\t\treturn scalar.Digest{}, false\n290|\t}\n291|\tdigest, err := scalar.ParseDigest(value)\n292|\tif err != nil {\n293|\t\treturn scalar.Digest{}, false\n294|\t}\n295|\treturn digest, true\n296|}\n297|\n298|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n299|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n300|\tvalue, ok := rawString(raw)\n301|\tif !ok {\n302|\t\treturn scalar.UUIDv7{}, false\n303|\t}\n304|\tidentifier, err := scalar.ParseUUIDv7(value)\n305|\tif err != nil {\n306|\t\treturn scalar.UUIDv7{}, false\n307|\t}\n308|\treturn identifier, true\n309|}\n310|\n311|// CheckTimestamp reports whether the member is a pinned\n312|// timestamp.\n313|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n314|\tvalue, ok := rawString(raw)\n315|\tif !ok {\n316|\t\treturn scalar.Timestamp{}, false\n317|\t}\n318|\tinstant, err := scalar.ParseTimestamp(value)\n319|\tif err != nil {\n320|\t\treturn scalar.Timestamp{}, false\n321|\t}\n322|\treturn instant, true\n323|}\n324|\n325|// isNull reports whether the member is an explicit JSON null.\n326|func isNull(raw json.RawMessage) bool {\n327|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n328|}\n329|\n330|func bytesTrimSpace(raw json.RawMessage) []byte {\n331|\treturn bytes.TrimSpace(raw)\n332|}\n333|\n334|// reverseDNSPattern is the extensions-key grammar: at least two\n335|// dot-separated labels, each starting with a lowercase letter.\n336|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n337|\n338|// CheckExtensions reports whether the member is an object whose\n339|// every key is reverse-DNS. Extensions never add operations,\n340|// capabilities, or trust facts; the key grammar is the part of\n341|// that rule decidable from one body.\n342|func CheckExtensions(raw json.RawMessage) bool {\n343|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n344|\tif fault != nil {\n345|\t\treturn false\n346|\t}\n347|\tfor name := range members {\n348|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n349|\t\t\treturn false\n350|\t\t}\n351|\t}\n352|\treturn true\n353|}\n354|\n355|// decodeArray reads a JSON array member into its raw elements. A\n356|// non-array — including null — is not an empty array.\n357|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n358|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n359|\ttoken, err := decoder.Token()\n360|\tif err != nil {\n361|\t\treturn nil, false\n362|\t}\n363|\tdelim, ok := token.(json.Delim)\n364|\tif !ok || delim != '[' {\n365|\t\treturn nil, false\n366|\t}\n367|\tvar elements []json.RawMessage\n368|\tfor decoder.More() {\n369|\t\tvar element json.RawMessage\n370|\t\tif err := decoder.Decode(&element); err != nil {\n371|\t\t\treturn nil, false\n372|\t\t}\n373|\t\telements = append(elements, element)\n374|\t}\n375|\tif token, err := decoder.Token(); err != nil {\n376|\t\treturn nil, false\n377|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n378|\t\treturn nil, false\n379|\t}\n380|\tif _, err := decoder.Token(); err != io.EOF {\n381|\t\treturn nil, false\n382|\t}\n383|\treturn elements, true\n384|}\n385|\n386|// CheckSortedUniqueStrings reports whether the member is an array\n387|// of strings in the item bound whose JCS encodings order strictly\n388|// increasingly with no duplicates. Bytewise JCS order over\n389|// strings is plain lexicographic order, so the check compares\n390|// directly; the count bound is checked on both edges.\n391|//\n392|// Ordering and uniqueness are two obligations, not one: an\n393|// unsorted-but-unique vector and a sorted-but-duplicated vector\n394|// are separate rows in the observation battery, so a check that\n395|// enforced only one half could not pass both.\n396|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n397|\telements, ok := decodeArray(raw)\n398|\tif !ok {\n399|\t\treturn nil, false\n400|\t}\n401|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n402|\t\treturn nil, false\n403|\t}\n404|\tvalues := make([]string, 0, len(elements))\n405|\tfor _, element := range elements {\n406|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n407|\t\tif !ok {\n408|\t\t\treturn nil, false\n409|\t\t}\n410|\t\tvalues = append(values, value)\n411|\t}\n412|\tfor index := 1; index < len(values); index++ {\n413|\t\tif values[index-1] >= values[index] {\n414|\t\t\treturn nil, false\n415|\t\t}\n416|\t}\n417|\treturn values, true\n418|}\n419|\n420|// CheckSortedUniqueDigests reports whether the member is an array\n421|// of digests in the count bound, ordered strictly increasingly\n422|// with no duplicates.\n423|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n424|\telements, ok := decodeArray(raw)\n425|\tif !ok {\n426|\t\treturn nil, false\n427|\t}\n428|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n429|\t\treturn nil, false\n430|\t}\n431|\tvalues := make([]scalar.Digest, 0, len(elements))\n432|\tfor _, element := range elements {\n433|\t\tdigest, ok := CheckDigest(element)\n434|\t\tif !ok {\n435|\t\t\treturn nil, false\n436|\t\t}\n437|\t\tvalues = append(values, digest)\n438|\t}\n439|\tfor index := 1; index < len(values); index++ {\n440|\t\tif values[index-1].String() >= values[index].String() {\n441|\t\t\treturn nil, false\n442|\t\t}\n443|\t}\n444|\treturn values, true\n445|}\n446|\n447|// refuse builds the package error for one refused member: the\n448|// rule in human text automation must never branch on, naming the\n449|// member. Tests assert the full text, so a reworded rule fails\n450|// its row instead of passing against a stale copy.\n451|func refuse(rule, member string) error {\n452|\tif member == \"\" {\n453|\t\treturn fmt.Errorf(\"environment %s\", rule)\n454|\t}\n455|\treturn fmt.Errorf(\"environment %s: %s\", rule, member)\n456|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f5","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":213,"recorded_at":1780531400000421,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a0766545b379e18cdcb345886c089a","text":"Read text file `internal/environ/tuple.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// environmentIDPattern is the Section 7.8 environment-id grammar:\n11|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n12|// identifier; it is never inferred by spelling.\n13|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n14|\n15|// CheckEnvironmentID reports whether the value is an\n16|// environment-id.\n17|func CheckEnvironmentID(value string) bool {\n18|\treturn environmentIDPattern.MatchString(value)\n19|}\n20|\n21|// semverPattern is the SemVer grammar adapter and environment\n22|// versions satisfy: three dot-separated numeric parts with\n23|// optional pre-release and build metadata.\n24|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n25|\n26|// CheckSemver reports whether the value is a SemVer string.\n27|func CheckSemver(value string) bool {\n28|\treturn semverPattern.MatchString(value)\n29|}\n30|\n31|// tupleArchitectures is the closed tuple architecture vocabulary\n32|// Section 7.8 states. Membership is a table loop so the census\n33|// derives it like every other closed vocabulary: an inline chain\n34|// here would be invisible to the census, and a widened chain\n35|// would silently admit a third architecture.\n36|var tupleArchitectures = []string{\n37|\t\"amd64\",\n38|\t\"arm64\",\n39|}\n40|\n41|// validTupleArchitecture reports whether the name is one of the\n42|// two tuple architectures.\n43|func validTupleArchitecture(architecture string) bool {\n44|\tfor _, allowed := range tupleArchitectures {\n45|\t\tif architecture == allowed {\n46|\t\t\treturn true\n47|\t\t}\n48|\t}\n49|\treturn false\n50|}\n51|\n52|// tupleMembers is the exact Environment Tuple member set Sections\n53|// 7.8 and 13.14 require: environment_id, environment_version,\n54|// platform, architecture, store_schema_fingerprint, and\n55|// adapter_version. The tuple never contains executable provenance,\n56|// and — unlike every neighbouring closed type — it carries no\n57|// extensions member, so even a reverse-DNS extensions object is\n58|// refused here.\n59|var tupleMembers = map[string]bool{\n60|\t\"environment_id\":           true,\n61|\t\"environment_version\":      true,\n62|\t\"platform\":                 true,\n63|\t\"architecture\":             true,\n64|\t\"store_schema_fingerprint\": true,\n65|\t\"adapter_version\":          true,\n66|}\n67|\n68|// tupleRequired lists tupleMembers in a fixed order.\n69|var tupleRequired = []string{\n70|\t\"environment_id\",\n71|\t\"environment_version\",\n72|\t\"platform\",\n73|\t\"architecture\",\n74|\t\"store_schema_fingerprint\",\n75|\t\"adapter_version\",\n76|}\n77|\n78|// Tuple is one validated Environment Tuple.\n79|type Tuple struct {\n80|\tEnvironmentID    string\n81|\tVersion          string\n82|\tPlatform         string\n83|\tArchitecture     string\n84|\tStoreFingerprint string\n85|\tAdapterVersion   string\n86|}\n87|\n88|// DecodeTuple validates one closed Environment Tuple: exact\n89|// members, the environment-id grammar, environment_version as\n90|// string[1..128] (the bound Section 10.8.1 states for the\n91|// observation that reuses this admission model), the closed\n92|// platform and architecture vocabularies, a digest store\n93|// fingerprint, and a SemVer adapter version. Any executable\n94|// provenance member is an unknown member, never a second\n95|// identity.\n96|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n97|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n98|\tif fault != nil {\n99|\t\treturn Tuple{}, refuse(\"tuple \"+fault.Detail, fault.Member)\n100|\t}\n101|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n102|\t\treturn Tuple{}, refuse(\"tuple carries unknown member\", name)\n103|\t}\n104|\tif name, missing := missingMember(members, tupleRequired); missing {\n105|\t\treturn Tuple{}, refuse(\"tuple misses a required member\", name)\n106|\t}\n107|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n108|\tif !ok || !CheckEnvironmentID(environmentID) {\n109|\t\treturn Tuple{}, refuse(\"tuple environment identifier is not an environment-id\", \"environment_id\")\n110|\t}\n111|\tversion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n112|\tif !ok {\n113|\t\treturn Tuple{}, refuse(\"tuple environment version is not a string[1..128]\", \"environment_version\")\n114|\t}\n115|\tplatform, ok := rawString(members[\"platform\"])\n116|\tif !ok {\n117|\t\treturn Tuple{}, refuse(\"tuple platform is not a string\", \"platform\")\n118|\t}\n119|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n120|\t\treturn Tuple{}, refuse(\"tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n121|\t}\n122|\tarchitecture, ok := rawString(members[\"architecture\"])\n123|\tif !ok || !validTupleArchitecture(architecture) {\n124|\t\treturn Tuple{}, refuse(\"tuple architecture is outside amd64|arm64\", \"architecture\")\n125|\t}\n126|\tfingerprint, ok := CheckDigest(members[\"store_schema_fingerprint\"])\n127|\tif !ok {\n128|\t\treturn Tuple{}, refuse(\"tuple store fingerprint is not a digest\", \"store_schema_fingerprint\")\n129|\t}\n130|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n131|\tif !ok || !CheckSemver(adapterVersion) {\n132|\t\treturn Tuple{}, refuse(\"tuple adapter version is not SemVer\", \"adapter_version\")\n133|\t}\n134|\treturn Tuple{\n135|\t\tEnvironmentID:    environmentID,\n136|\t\tVersion:          version,\n137|\t\tPlatform:         platform,\n138|\t\tArchitecture:     architecture,\n139|\t\tStoreFingerprint: fingerprint.String(),\n140|\t\tAdapterVersion:   adapterVersion,\n141|\t}, nil\n142|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f7","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":214,"recorded_at":1780531400000423,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a0766546247352b8eff3d74128d483","text":"Read text file `internal/environ/observation.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// observationSchema is the exact schema identifier the\n10|// Environment Observation carries.\n11|const observationSchema = \"urn:ax:schema:environment-observation\"\n12|\n13|// observationSchemaVersion is the only observation version this\n14|// library accepts.\n15|const observationSchemaVersion = \"1.0.0\"\n16|\n17|// observationMembers is the exact Section 10.8.1 member set.\n18|var observationMembers = map[string]bool{\n19|\t\"schema\":                    true,\n20|\t\"schema_version\":            true,\n21|\t\"observation_id\":            true,\n22|\t\"host_id\":                   true,\n23|\t\"installation_id\":           true,\n24|\t\"environment_id\":            true,\n25|\t\"environment_version\":       true,\n26|\t\"provider_id\":               true,\n27|\t\"platform\":                  true,\n28|\t\"architecture\":              true,\n29|\t\"backend_realm_fingerprint\": true,\n30|\t\"capabilities\":              true,\n31|\t\"authentication_status\":     true,\n32|\t\"runtime_status\":            true,\n33|\t\"observed_at\":               true,\n34|\t\"extensions\":                true,\n35|}\n36|\n37|// observationRequired lists observationMembers in a fixed order so\n38|// a record missing several members always names the same one.\n39|var observationRequired = []string{\n40|\t\"schema\",\n41|\t\"schema_version\",\n42|\t\"observation_id\",\n43|\t\"host_id\",\n44|\t\"installation_id\",\n45|\t\"environment_id\",\n46|\t\"environment_version\",\n47|\t\"provider_id\",\n48|\t\"platform\",\n49|\t\"architecture\",\n50|\t\"backend_realm_fingerprint\",\n51|\t\"capabilities\",\n52|\t\"authentication_status\",\n53|\t\"runtime_status\",\n54|\t\"observed_at\",\n55|\t\"extensions\",\n56|}\n57|\n58|// capabilityOrder is the exact eight-name directory-capability\n59|// registry Section 7.9 states. The observation capabilities map\n60|// carries exactly these keys: a ninth key advertises a surface\n61|// the contract never defined, and a missing key hides one it did.\n62|// Section 10.8.1 reuses this registry rather than creating a\n63|// second capability authority.\n64|var capabilityOrder = []string{\n65|\t\"directory_discovery\",\n66|\t\"directory_incremental_scan\",\n67|\t\"directory_head_digest\",\n68|\t\"directory_tail_preview\",\n69|\t\"native_title_read\",\n70|\t\"native_runtime_observation\",\n71|\t\"existing_session_adoption\",\n72|\t\"native_resume\",\n73|}\n74|\n75|// validCapability reports whether the name is a registry member.\n76|// It is a table loop so the census derives it like every other\n77|// closed vocabulary.\n78|func validCapability(name string) bool {\n79|\tfor _, allowed := range capabilityOrder {\n80|\t\tif name == allowed {\n81|\t\t\treturn true\n82|\t\t}\n83|\t}\n84|\treturn false\n85|}\n86|\n87|// capabilityStatuses is the closed CapabilityResult status\n88|// vocabulary. Unknown is never rewritten as unsupported, and\n89|// conditional is never advertised as available.\n90|var capabilityStatuses = []string{\n91|\t\"available\",\n92|\t\"conditional\",\n93|\t\"unavailable\",\n94|\t\"unknown\",\n95|}\n96|\n97|// validCapabilityStatus reports whether the status is a registry\n98|// member.\n99|func validCapabilityStatus(status string) bool {\n100|\tfor _, allowed := range capabilityStatuses {\n101|\t\tif status == allowed {\n102|\t\t\treturn true\n103|\t\t}\n104|\t}\n105|\treturn false\n106|}\n107|\n108|// capabilityMembers is the exact CapabilityResult member set.\n109|var capabilityMembers = map[string]bool{\n110|\t\"status\":       true,\n111|\t\"reason_code\":  true,\n112|\t\"evidence_ids\": true,\n113|\t\"observed_at\":  true,\n114|\t\"extensions\":   true,\n115|}\n116|\n117|// capabilityRequired lists capabilityMembers in a fixed order.\n118|var capabilityRequired = []string{\n119|\t\"status\",\n120|\t\"reason_code\",\n121|\t\"evidence_ids\",\n122|\t\"observed_at\",\n123|\t\"extensions\",\n124|}\n125|\n126|// authenticationStatuses is the closed authentication_status\n127|// vocabulary: status only, never credentials.\n128|var authenticationStatuses = []string{\n129|\t\"available\",\n130|\t\"missing\",\n131|\t\"expired\",\n132|\t\"unknown\",\n133|}\n134|\n135|// validAuthenticationStatus reports whether the status is a\n136|// registry member.\n137|func validAuthenticationStatus(status string) bool {\n138|\tfor _, allowed := range authenticationStatuses {\n139|\t\tif status == allowed {\n140|\t\t\treturn true\n141|\t\t}\n142|\t}\n143|\treturn false\n144|}\n145|\n146|// runtimeStatuses is the closed runtime_status vocabulary.\n147|var runtimeStatuses = []string{\n148|\t\"available\",\n149|\t\"degraded\",\n150|\t\"unavailable\",\n151|}\n152|\n153|// validRuntimeStatus reports whether the status is a registry\n154|// member.\n155|func validRuntimeStatus(status string) bool {\n156|\tfor _, allowed := range runtimeStatuses {\n157|\t\tif status == allowed {\n158|\t\t\treturn true\n159|\t\t}\n160|\t}\n161|\treturn false\n162|}\n163|\n164|// CapabilityResult is one validated directory capability result.\n165|type CapabilityResult struct {\n166|\tStatus     string\n167|\tReasonCode string\n168|\tHasReason  bool\n169|\tEvidence   []string\n170|\tObservedAt string\n171|}\n172|\n173|// Observation is one validated Environment Observation.\n174|type Observation struct {\n175|\tObservationID    string\n176|\tHostID           string\n177|\tInstallationID   string\n178|\tEnvironmentID    string\n179|\tEnvironmentVer   string\n180|\tProviderID       string\n181|\tPlatform         string\n182|\tArchitecture     string\n183|\tRealmFingerprint string\n184|\tCapabilities     map[string]CapabilityResult\n185|\tAuthentication   string\n186|\tRuntime          string\n187|\tObservedAt       string\n188|}\n189|\n190|// DecodeEnvironmentObservation validates one closed Environment\n191|// Observation: the exact schema envelope, digest and UUIDv7\n192|// identities, the environment-id grammar with\n193|// environment_version as string[1..128], the provider-id grammar\n194|// (an explicit manifest mapping, never string inference), the\n195|// platform and architecture vocabularies through the reused\n196|// Section 13.14 tuple admission model, the non-secret realm\n197|// digest, the exact eight-name capability map, the two status\n198|// vocabularies, the diagnostic timestamp, and reverse-DNS\n199|// extensions.\n200|func DecodeEnvironmentObservation(body []byte) (Observation, error) {\n201|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(body))\n202|\tif fault != nil {\n203|\t\treturn Observation{}, refuse(\"observation \"+fault.Detail, fault.Member)\n204|\t}\n205|\tif name, unknown := unknownMember(members, observationMembers); unknown {\n206|\t\treturn Observation{}, refuse(\"observation carries unknown member\", name)\n207|\t}\n208|\tif name, missing := missingMember(members, observationRequired); missing {\n209|\t\treturn Observation{}, refuse(\"observation misses a required member\", name)\n210|\t}\n211|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != observationSchema {\n212|\t\treturn Observation{}, refuse(\"observation schema is not the environment observation\", \"schema\")\n213|\t}\n214|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != observationSchemaVersion {\n215|\t\treturn Observation{}, refuse(\"observation schema version is not 1.0.0\", \"schema_version\")\n216|\t}\n217|\tobservationID, ok := CheckDigest(members[\"observation_id\"])\n218|\tif !ok {\n219|\t\treturn Observation{}, refuse(\"observation identifier is not a digest\", \"observation_id\")\n220|\t}\n221|\thostID, ok := CheckUUIDv7(members[\"host_id\"])\n222|\tif !ok {\n223|\t\treturn Observation{}, refuse(\"observation host identifier is not a UUIDv7\", \"host_id\")\n224|\t}\n225|\tinstallationID, ok := CheckDigest(members[\"installation_id\"])\n226|\tif !ok {\n227|\t\treturn Observation{}, refuse(\"observation installation identifier is not a digest\", \"installation_id\")\n228|\t}\n229|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n230|\tif !ok || !CheckEnvironmentID(environmentID) {\n231|\t\treturn Observation{}, refuse(\"observation environment identifier is not an environment-id\", \"environment_id\")\n232|\t}\n233|\tenvironmentVersion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n234|\tif !ok {\n235|\t\treturn Observation{}, refuse(\"observation environment version is not a string[1..128]\", \"environment_version\")\n236|\t}\n237|\tprovider, ok := rawString(members[\"provider_id\"])\n238|\tif !ok {\n239|\t\treturn Observation{}, refuse(\"observation provider identifier is not a string\", \"provider_id\")\n240|\t}\n241|\tproviderID, err := scalar.ParseProviderID(provider)\n242|\tif err != nil {\n243|\t\treturn Observation{}, refuse(\"observation provider identifier is not a provider-id\", \"provider_id\")\n244|\t}\n245|\tplatform, ok := rawString(members[\"platform\"])\n246|\tif !ok {\n247|\t\treturn Observation{}, refuse(\"observation platform is not a string\", \"platform\")\n248|\t}\n249|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n250|\t\treturn Observation{}, refuse(\"observation platform is outside linux|macos|windows|wsl2\", \"platform\")\n251|\t}\n252|\tarchitecture, ok := rawString(members[\"architecture\"])\n253|\tif !ok || !validTupleArchitecture(architecture) {\n254|\t\treturn Observation{}, refuse(\"observation architecture is outside amd64|arm64\", \"architecture\")\n255|\t}\n256|\trealm, ok := CheckDigest(members[\"backend_realm_fingerprint\"])\n257|\tif !ok {\n258|\t\treturn Observation{}, refuse(\"observation realm fingerprint is not a digest\", \"backend_realm_fingerprint\")\n259|\t}\n260|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n261|\tif !ok {\n262|\t\treturn Observation{}, refuse(\"observation capabilities are not the exact eight-name result map\", \"capabilities\")\n263|\t}\n264|\tauthentication, ok := rawString(members[\"authentication_status\"])\n265|\tif !ok || !validAuthenticationStatus(authentication) {\n266|\t\treturn Observation{}, refuse(\"observation authentication status is outside available|missing|expired|unknown\", \"authentication_status\")\n267|\t}\n268|\truntime, ok := rawString(members[\"runtime_status\"])\n269|\tif !ok || !validRuntimeStatus(runtime) {\n270|\t\treturn Observation{}, refuse(\"observation runtime status is outside available|degraded|unavailable\", \"runtime_status\")\n271|\t}\n272|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n273|\tif !ok {\n274|\t\treturn Observation{}, refuse(\"observation timestamp is not a timestamp\", \"observed_at\")\n275|\t}\n276|\tif !CheckExtensions(members[\"extensions\"]) {\n277|\t\treturn Observation{}, refuse(\"observation extensions are not reverse-DNS keyed\", \"extensions\")\n278|\t}\n279|\treturn Observation{\n280|\t\tObservationID:    observationID.String(),\n281|\t\tHostID:           hostID.String(),\n282|\t\tInstallationID:   installationID.String(),\n283|\t\tEnvironmentID:    environmentID,\n284|\t\tEnvironmentVer:   environmentVersion,\n285|\t\tProviderID:       providerID.String(),\n286|\t\tPlatform:         platform,\n287|\t\tArchitecture:     architecture,\n288|\t\tRealmFingerprint: realm.String(),\n289|\t\tCapabilities:     capabilities,\n290|\t\tAuthentication:   authentication,\n291|\t\tRuntime:          runtime,\n292|\t\tObservedAt:       observed.String(),\n293|\t}, nil\n294|}\n295|\n296|// checkCapabilities validates the exact eight-name capability\n297|// map: exactly the registry keys, each a closed CapabilityResult.\n298|func checkCapabilities(raw json.RawMessage) (map[string]CapabilityResult, bool) {\n299|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n300|\tif fault != nil {\n301|\t\treturn nil, false\n302|\t}\n303|\tif len(members) != len(capabilityOrder) {\n304|\t\treturn nil, false\n305|\t}\n306|\tcapabilities := make(map[string]CapabilityResult, len(capabilityOrder))\n307|\tfor _, name := range capabilityOrder {\n308|\t\tmember, present := members[name]\n309|\t\tif !present {\n310|\t\t\treturn nil, false\n311|\t\t}\n312|\t\tcapability, ok := checkCapabilityResult(member)\n313|\t\tif !ok {\n314|\t\t\treturn nil, false\n315|\t\t}\n316|\t\tcapabilities[name] = capability\n317|\t}\n318|\treturn capabilities, true\n319|}\n320|\n321|// checkCapabilityResult validates one CapabilityResult object.\n322|// Available carries a null reason and every other status carries\n323|// one: the two directions are separate obligations, so an\n324|// available-with-reason vector and a conditional-without-reason\n325|// vector are separate rows in the battery.\n326|func checkCapabilityResult(raw json.RawMessage) (CapabilityResult, bool) {\n327|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n328|\tif fault != nil {\n329|\t\treturn CapabilityResult{}, false\n330|\t}\n331|\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\n332|\t\t_ = name\n333|\t\treturn CapabilityResult{}, false\n334|\t}\n335|\tif name, missing := missingMember(members, capabilityRequired); missing {\n336|\t\t_ = name\n337|\t\treturn CapabilityResult{}, false\n338|\t}\n339|\tstatus, ok := rawString(members[\"status\"])\n340|\tif !ok || !validCapabilityStatus(status) {\n341|\t\treturn CapabilityResult{}, false\n342|\t}\n343|\treasonMember, present := members[\"reason_code\"]\n344|\tif !present {\n345|\t\treturn CapabilityResult{}, false\n346|\t}\n347|\thasReason := false\n348|\tvar reasonCode string\n349|\tif isNull(reasonMember) {\n350|\t\thasReason = false\n351|\t} else {\n352|\t\tvalue, ok := CheckStringBounds(reasonMember, 1, 128)\n353|\t\tif !ok {\n354|\t\t\treturn CapabilityResult{}, false\n355|\t\t}\n356|\t\thasReason = true\n357|\t\treasonCode = value\n358|\t}\n359|\tif status == \"available\" && hasReason {\n360|\t\treturn CapabilityResult{}, false\n361|\t}\n362|\tif status != \"available\" && !hasReason {\n363|\t\treturn CapabilityResult{}, false\n364|\t}\n365|\tevidence, ok := CheckSortedUniqueDigests(members[\"evidence_ids\"], 0, 64)\n366|\tif !ok {\n367|\t\treturn CapabilityResult{}, false\n368|\t}\n369|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n370|\tif !ok {\n371|\t\treturn CapabilityResult{}, false\n372|\t}\n373|\tif !CheckExtensions(members[\"extensions\"]) {\n374|\t\treturn CapabilityResult{}, false\n375|\t}\n376|\ttexts := make([]string, 0, len(evidence))\n377|\tfor _, digest := range evidence {\n378|\t\ttexts = append(texts, digest.String())\n379|\t}\n380|\treturn CapabilityResult{\n381|\t\tStatus:     status,\n382|\t\tReasonCode: reasonCode,\n383|\t\tHasReason:  hasReason,\n384|\t\tEvidence:   texts,\n385|\t\tObservedAt: observed.String(),\n386|\t}, true\n387|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
