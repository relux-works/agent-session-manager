{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb23","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":1004,"recorded_at":1780531400002003,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"task_stream":{"kind":"task","id":"1a0d4a8a-de17-4748-9742-4085410a34b2"},"task_id":"1a0d4a8a-de17-4748-9742-4085410a34b2","event":{"kind":"output","task_id":"1a0d4a8a-de17-4748-9742-4085410a34b2","chunk":"edited\nchanged lines: lines 33-156\n--- original\n+++ updated\n@@\n-// decodeStrictObject parses one complete JSON object with duplicate\n-// member rejection. It is the only JSON entry point in this package:\n-// every body crosses it before any member is read. A non-UTF-8\n-// frame, a lone surrogate escape, a non-object top level, a\n-// duplicated member, or trailing data is a fault, never a partial\n-// object the caller could mistake for a result.\n-func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n-\tif !utf8.Valid(data) {\n-\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n-\t}\n-\tif hasLoneSurrogateEscape(data) {\n-\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n-\t}\n-\tdecoder := json.NewDecoder(bytes.NewReader(data))\n-\ttoken, err := decoder.Token()\n-\tif err != nil {\n-\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n-\t}\n-\tdelim, ok := token.(json.Delim)\n-\tif !ok || delim != '{' {\n-\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n-\t}\n-\tmembers := map[string]json.RawMessage{}\n-\tfor decoder.More() {\n-\t\tkeyToken, err := decoder.Token()\n-\t\tif err != nil {\n-\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n-\t\t}\n-\t\tkey, ok := keyToken.(string)\n-\t\tif !ok {\n-\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n-\t\t}\n-\t\tif _, duplicate := members[key]; duplicate {\n-\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n-\t\t}\n-\t\tvar raw json.RawMessage\n-\t\tif err := decoder.Decode(&raw); err != nil {\n-\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n-\t\t}\n-\t\tmembers[key] = raw\n-\t}\n-\tif token, err := decoder.Token(); err != nil {\n-\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n-\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n-\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n-\t}\n-\tif _, err := decoder.Token(); err != io.EOF {\n-\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n-\t}\n-\treturn members, nil\n-}\n-\n-// hasLoneSurrogateEscape reports whether the raw frame carries a\n-// UTF-16 escape the JSON string grammar cannot pair: a high\n-// surrogate not followed by a low surrogate, a low surrogate with no\n-// high surrogate before it, or a truncated escape. Go's encoding/json\n-// would otherwise replace the lone escape with U+FFFD silently, so\n-// Section 1.6 wire bodies carrying lone surrogates would be admitted\n-// with rewritten bytes. This is a local copy of the shared surrogate\n-// rule because the shared implementation is unexported; the agreement\n-// test pins it against canonicaljson.Canonicalize over a generated\n-// escape corpus whose verdicts come from construction, not from\n-// either implementation.\n-func hasLoneSurrogateEscape(data []byte) bool {\n-\tfor index := 0; index < len(data); index++ {\n-\t\tif data[index] != '\\\\' {\n-\t\t\tcontinue\n-\t\t}\n-\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n-\t\t\tcontinue\n-\t\t}\n-\t\tfirst, length := readUTF16Escape(data, index+2)\n-\t\tif length < 0 {\n-\t\t\treturn true\n-\t\t}\n-\t\tindex += 1 + length\n-\t\tif first >= 0xD800 && first <= 0xDBFF {\n-\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n-\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n-\t\t\t\treturn true\n-\t\t\t}\n-\t\t\tindex += 6\n-\t\t\tcontinue\n-\t\t}\n-\t\tif first >= 0xDC00 && first <= 0xDFFF {\n-\t\t\treturn true\n-\t\t}\n-\t}\n-\treturn false\n-}\n-\n-// readUTF16Escape reads four hex digits at the offset. It returns the\n-// value and the consumed length, or a negative length when the escape\n-// is truncated or not hexadecimal.\n-func readUTF16Escape(data []byte, offset int) (uint16, int) {\n-\tif offset+4 > len(data) {\n-\t\treturn 0, -1\n-\t}\n-\tvar value uint16\n-\tfor _, digit := range data[offset : offset+4] {\n-\t\tvalue <<= 4\n-\t\tswitch {\n-\t\tcase digit >= '0' && digit <= '9':\n-\t\t\tvalue |= uint16(digit - '0')\n-\t\tcase digit >= 'a' && digit <= 'f':\n-\t\t\tvalue |= uint16(digit-'a') + 10\n-\t\tcase digit >= 'A' && digit <= 'F':\n-\t\t\tvalue |= uint16(digit-'A') + 10\n-\t\tdefault:\n-\t\t\treturn 0, -1\n-\t\t}\n-\t}\n-\treturn value, 4\n-}\n-\n-// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n-// at the offset. Anything else — a truncated escape, a non-escape,\n-// or input end — is a negative length.\n-func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n-\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n-\t\treturn 0, -1\n-\t}\n-\treturn readUTF16Escape(data, offset+2)\n-}\n+// decodeStrictObject parses one complete JSON object with duplicate\n+// member rejection. It is the only JSON entry point in this package:\n+// every body crosses it before any member is read. The frame verdict\n+// itself is the shared environ verdict: this function delegates to\n+// environ.DecodeStrictObject and translates the fault into the\n+// package refusal dialect without reimplementing any rule, so the\n+// two can never drift. The delegated