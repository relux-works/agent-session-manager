{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"task_stream":{"kind":"task","id":"e4b6a4a8-2bdc-4fe9-8027-03418da63527"},"task_id":"e4b6a4a8-2bdc-4fe9-8027-03418da63527","event":{"kind":"output","task_id":"e4b6a4a8-2bdc-4fe9-8027-03418da63527","chunk":"Read text file `internal/environ/decode.go`.\n1|package environ\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"io\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// maxUint53 is the largest exactly representable JSON integer:\n17|// counts and limits are uint53 throughout the pinned\n18|// specification.\n19|const maxUint53 = uint64(1<<53 - 1)\n20|\n21|// Fault is one strict-decode failure: what was wrong and which\n22|// member it was found in, if any. It never carries foreign bytes.\n23|// The five details are the complete fault space: every body this\n24|// package refuses at the frame layer carries exactly one of them,\n25|// and the frame-agreement battery derives its denominator from\n26|// this list, so a sixth fault shape fails the census instead of\n27|// passing silently.\n28|type Fault struct {\n29|\tDetail string\n30|\tMember string\n31|}\n32|\n33|func (fault *Fault) Error() string {\n34|\tif fault.Member == \"\" {\n35|\t\treturn \"environment frame \" + fault.Detail\n36|\t}\n37|\treturn \"environment frame \" + fault.Detail + \" in member \" + fault.Member\n38|}\n39|\n40|// Frame fault details. Each is a constant so the agreement battery\n41|// derives the fault space from production source instead of\n42|// retyping it: a reworded fault fails its row rather than passing\n43|// against a stale copy.\n44|const (\n45|\tFaultNotUTF8       = \"not valid UTF-8\"\n46|\tFaultLoneSurrogate = \"lone surrogate escape\"\n47|\tFaultNotObject     = \"not a JSON object\"\n48|\tFaultDuplicate     = \"duplicate member\"\n49|\tFaultTrailing      = \"trailing data after the object\"\n50|)\n51|\n52|// DecodeStrictObject parses one complete JSON object with\n53|// duplicate member rejection. It is the only JSON entry point in\n54|// this package: every body crosses it before any member is read.\n55|// A non-UTF-8 frame, a lone surrogate escape, a non-object top\n56|// level, a duplicated member, or trailing data is a fault, never\n57|// a partial object the caller could mistake for a result.\n58|func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\n59|\tif !utf8.Valid(data) {\n60|\t\treturn nil, &Fault{Detail: FaultNotUTF8}\n61|\t}\n62|\tif HasLoneSurrogateEscape(data) {\n63|\t\treturn nil, &Fault{Detail: FaultLoneSurrogate}\n64|\t}\n65|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n66|\ttoken, err := decoder.Token()\n67|\tif err != nil {\n68|\t\treturn nil, &Fault{Detail: FaultNotObject}\n69|\t}\n70|\tdelim, ok := token.(json.Delim)\n71|\tif !ok || delim != '{' {\n72|\t\treturn nil, &Fault{Detail: FaultNotObject}\n73|\t}\n74|\tmembers := map[string]json.RawMessage{}\n75|\tfor decoder.More() {\n76|\t\tkeyToken, err := decoder.Token()\n77|\t\tif err != nil {\n78|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n79|\t\t}\n80|\t\tkey, ok := keyToken.(string)\n81|\t\tif !ok {\n82|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n83|\t\t}\n84|\t\tif _, duplicate := members[key]; duplicate {\n85|\t\t\treturn nil, &Fault{Detail: FaultDuplicate, Member: key}\n86|\t\t}\n87|\t\tvar raw json.RawMessage\n88|\t\tif err := decoder.Decode(&raw); err != nil {\n89|\t\t\treturn nil, &Fault{Detail: FaultNotObject, Member: key}\n90|\t\t}\n91|\t\tmembers[key] = raw\n92|\t}\n93|\tif token, err := decoder.Token(); err != nil {\n94|\t\treturn nil, &Fault{Detail: FaultNotObject}\n95|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n96|\t\treturn nil, &Fault{Detail: FaultNotObject}\n97|\t}\n98|\tif _, err := decoder.Token(); err != io.EOF {\n99|\t\treturn nil, &Fault{Detail: FaultTrailing}\n100|\t}\n101|\treturn members, nil\n102|}\n103|\n104|// HasLoneSurrogateEscape reports whether the raw frame carries a\n105|// UTF-16 escape the JSON string grammar cannot pair. Go's\n106|// encoding/json would otherwise replace the lone escape with\n107|// U+FFFD silently, so wire bodies carrying lone surrogates would\n108|// be admitted with rewritten bytes.\n109|//\n110|// The walk is string-aware: only escapes inside JSON strings\n111|// count, and a backslash escape consumes both bytes, so the text\n112|// \"\\\\ud800\" (backslash-plus-text, JSON source `\"\\\\ud800\"`) is\n113|// not an escape and is admitted. A scanner that matches every\n114|// `\\u` byte pair regardless of string context refuses that text:\n115|// that false positive is exactly the recorded sessadapter and\n116|// dirnode divergence the frame-agreement battery ledgers, and any\n117|// change to it fails there in either direction.\n118|func HasLoneSurrogateEscape(data []byte) bool {\n119|\tfor index := 0; index < len(data); index++ {\n120|\t\tif data[index] != '\"' {\n121|\t\t\tcontinue\n122|\t\t}\n123|\t\tfor index++; index < len(data); index++ {\n124|\t\t\tswitch data[index] {\n125|\t\t\tcase '\"':\n126|\t\t\t\tgoto stringComplete\n127|\t\t\tcase '\\\\':\n128|\t\t\t\tindex++\n129|\t\t\t\tif index >= len(data) || data[index] != 'u' {\n130|\t\t\t\t\tcontinue\n131|\t\t\t\t}\n132|\t\t\t\tunit, end, ok := readUTF16Escape(data, index-1)\n133|\t\t\t\tif !ok {\n134|\t\t\t\t\t// Not a well-formed \\uXXXX escape: the\n135|\t\t\t\t\t// JSON-syntax arms own it, not this gate.\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tindex = end - 1\n139|\t\t\t\tswitch {\n140|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n141|\t\t\t\t\tsecond, _, ok := readUTF16Escape(data, end)\n142|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n143|\t\t\t\t\t\treturn true\n144|\t\t\t\t\t}\n145|\t\t\t\t\tindex = end + 6 - 1\n146|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n147|\t\t\t\t\treturn true\n148|\t\t\t\t}\n149|\t\t\t}\n150|\t\t}\n151|\t\t// An unterminated string owns no surrogate verdict: the\n152|\t\t// frame is not JSON at all, so the syntax arms refuse it\n153|\t\t// as not-a-JSON-object rather than misattributing it\n154|\t\t// here.\n155|\t\treturn false\n156|\tstringComplete:\n157|\t}\n158|\treturn false\n159|}\n160|\n161|// readUTF16Escape reads one \\uXXXX escape starting at the offset.\n162|// It reports the unit value and the offset just past the escape,\n163|// or false when the escape is truncated or not hexadecimal.\n164|func readUTF16Escape(data []byte, offset int) (uint16, int, bool) {\n165|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n166|\t\treturn 0, offset, false\n167|\t}\n168|\tvalue, err := strconv.ParseUint(string(data[offset+2:offset+6]), 16, 16)\n169|\tif err != nil {\n170|\t\treturn 0, offset, false\n171|\t}\n172|\treturn uint16(value), offset + 6, true\n173|}\n174|\n175|// unknownMember names a member outside the closed set, if any.\n176|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n177|\tfor name := range members {\n178|\t\tif !allowed[name] {\n179|\t\t\treturn name, true\n180|\t\t}\n181|\t}\n182|\treturn \"\", false\n183|}\n184|\n185|// missingMember names the first required member with no value, if\n186|// any. The required list is fixed order, so the verdict is\n187|// deterministic for every missing combination.\n188|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n189|\tfor _, name := range required {\n190|\t\tif _, present := members[name]; !present {\n191|\t\t\treturn name, true\n192|\t\t}\n193|\t}\n194|\treturn \"\", false\n195|}\n196|\n197|// rawString reads a JSON string member.\n198|func rawString(raw json.RawMessage) (string, bool) {\n199|\tvar value string\n200|\tif err := json.Unmarshal(raw, &value); err != nil {\n201|\t\treturn \"\", false\n202|\t}\n203|\treturn value, true\n204|}\n205|\n206|// rawUint53 reads an unsigned integral JSON number in [0,\n207|// 2^53-1]. A fraction, exponent, sign, or out-of-range magnitude\n208|// is not a uint53, even when it names the same mathematical\n209|// value: the bodies carry counts, never measurements.\n210|func rawUint53(raw json.RawMessage) (uint64, bool) {\n211|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n212|\tdecoder.UseNumber()\n213|\tvar value any\n214|\tif err := decoder.Decode(&value); err != nil {\n215|\t\treturn 0, false\n216|\t}\n217|\tnumber, ok := value.(json.Number)\n218|\tif !ok {\n219|\t\treturn 0, false\n220|\t}\n221|\tliteral := number.String()\n222|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n223|\t\treturn 0, false\n224|\t}\n225|\treturn parseUint53Literal(literal)\n226|}\n227|\n228|// parseUint53Literal reads a digit-only literal without trusting\n229|// a float conversion: the magnitude bound is checked on the digit\n230|// string, so 2^53 is refused even on platforms that could hold\n231|// it.\n232|func parseUint53Literal(literal string) (uint64, bool) {\n233|\tvar value uint64\n234|\tfor index := 0; index < len(literal); index++ {\n235|\t\tdigit := literal[index]\n236|\t\tif digit < '0' || digit > '9' {\n237|\t\t\treturn 0, false\n238|\t\t}\n239|\t\tvalue = value*10 + uint64(digit-'0')\n240|\t\tif value > maxUint53 {\n241|\t\t\treturn 0, false\n242|\t\t}\n243|\t}\n244|\treturn value, true\n245|}\n246|\n247|// StringLength is the Section 1.6 string measure in characters,\n248|// not bytes: a bound of string[1..128] admits 128 characters of\n249|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n250|// env literals, Section 5.1) do not go through here; the measure\n251|// battery ledgers that split.\n252|func StringLength(value string) int {\n253|\treturn utf8.RuneCountInString(value)\n254|}\n255|\n256|// CheckStringBounds reports whether the member is a JSON string\n257|// whose character count falls in the inclusive bound.\n258|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n259|\tvalue, ok := rawString(raw)\n260|\tif !ok {\n261|\t\treturn \"\", false\n262|\t}\n263|\tlength := StringLength(value)\n264|\tif length < minimum || length > maximum {\n265|\t\treturn \"\", false\n266|\t}\n267|\treturn value, true\n268|}\n269|\n270|// CheckUint53Bounds reports whether the member is a uint53 in the\n271|// inclusive bound. Both edges are checked: a one-sided check\n272|// would admit the open side.\n273|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n274|\tvalue, ok := rawUint53(raw)\n275|\tif !ok {\n276|\t\treturn 0, false\n277|\t}\n278|\tif value < minimum || value > maximum {\n279|\t\treturn 0, false\n280|\t}\n281|\treturn value, true\n282|}\n283|\n284|// CheckDigest reports whether the member is a digest of the\n285|// pinned sha256 form.\n286|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n287|\tvalue, ok := rawString(raw)\n288|\tif !ok {\n289|\t\treturn scalar.Digest{}, false\n290|\t}\n291|\tdigest, err := scalar.ParseDigest(value)\n292|\tif err != nil {\n293|\t\treturn scalar.Digest{}, false\n294|\t}\n295|\treturn digest, true\n296|}\n297|\n298|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n299|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n300|\tvalue, ok := rawString(raw)\n301|\tif !ok {\n302|\t\treturn scalar.UUIDv7{}, false\n303|\t}\n304|\tidentifier, err := scalar.ParseUUIDv7(value)\n305|\tif err != nil {\n306|\t\treturn scalar.UUIDv7{}, false\n307|\t}\n308|\treturn identifier, true\n309|}\n310|\n311|// CheckTimestamp reports whether the member is a pinned\n312|// timestamp.\n313|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n314|\tvalue, ok := rawString(raw)\n315|\tif !ok {\n316|\t\treturn scalar.Timestamp{}, false\n317|\t}\n318|\tinstant, err := scalar.ParseTimestamp(value)\n319|\tif err != nil {\n320|\t\treturn scalar.Timestamp{}, false\n321|\t}\n322|\treturn instant, true\n323|}\n324|\n325|// isNull reports whether the member is an explicit JSON null.\n326|func isNull(raw json.RawMessage) bool {\n327|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n328|}\n329|\n330|func bytesTrimSpace(raw json.RawMessage) []byte {\n331|\treturn bytes.TrimSpace(raw)\n332|}\n333|\n334|// reverseDNSPattern is the extensions-key grammar: at least two\n335|// dot-separated labels, each starting with a lowercase letter.\n336|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n337|\n338|// CheckExtensions reports whether the member is an object whose\n339|// every key is reverse-DNS. Extensions never add operations,\n340|// capabilities, or trust facts; the key grammar is the part of\n341|// that rule decidable from one body.\n342|func CheckExtensions(raw json.RawMessage) bool {\n343|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n344|\tif fault != nil {\n345|\t\treturn false\n346|\t}\n347|\tfor name := range members {\n348|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n349|\t\t\treturn false\n350|\t\t}\n351|\t}\n352|\treturn true\n353|}\n354|\n355|// decodeArray reads a JSON array member into its raw elements. A\n356|// non-array — including null — is not an empty array.\n357|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n358|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n359|\ttoken, err := decoder.Token()\n360|\tif err != nil {\n361|\t\treturn nil, false\n362|\t}\n363|\tdelim, ok := token.(json.Delim)\n364|\tif !ok || delim != '[' {\n365|\t\treturn nil, false\n366|\t}\n367|\tvar elements []json.RawMessage\n368|\tfor decoder.More() {\n369|\t\tvar element json.RawMessage\n370|\t\tif err := decoder.Decode(&element); err != nil {\n371|\t\t\treturn nil, false\n372|\t\t}\n373|\t\telements = append(elements, element)\n374|\t}\n375|\tif token, err := decoder.Token(); err != nil {\n376|\t\treturn nil, false\n377|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n378|\t\treturn nil, false\n379|\t}\n380|\tif _, err := decoder.Token(); err != io.EOF {\n381|\t\treturn nil, false\n382|\t}\n383|\treturn elements, true\n384|}\n385|\n386|// CheckSortedUniqueStrings reports whether the member is an array\n387|// of strings in the item bound whose JCS encodings order strictly\n388|// increasingly with no duplicates. Bytewise JCS order over\n389|// strings is plain lexicographic order, so the check compares\n390|// directly; the count bound is checked on both edges.\n391|//\n392|// Ordering and uniqueness are two obligations, not one: an\n393|// unsorted-but-unique vector and a sorted-but-duplicated vector\n394|// are separate rows in the observation battery, so a check that\n395|// enforced only one half could not pass both.\n396|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n397|\telements, ok := decodeArray(raw)\n398|\tif !ok {\n399|\t\treturn nil, false\n400|\t}\n401|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n402|\t\treturn nil, false\n403|\t}\n404|\tvalues := make([]string, 0, len(elements))\n405|\tfor _, element := range elements {\n406|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n407|\t\tif !ok {\n408|\t\t\treturn nil, false\n409|\t\t}\n410|\t\tvalues = append(values, value)\n411|\t}\n412|\tfor index := 1; index < len(values); index++ {\n413|\t\tif values[index-1] >= values[index] {\n414|\t\t\treturn nil, false\n415|\t\t}\n416|\t}\n417|\treturn values, true\n418|}\n419|\n420|// CheckSortedUniqueDigests reports whether the member is an array\n421|// of digests in the count bound, ordered strictly increasingly\n422|// with no duplicates.\n423|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n424|\telements, ok := decodeArray(raw)\n425|\tif !ok {\n426|\t\treturn nil, false\n427|\t}\n428|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n429|\t\treturn nil, false\n430|\t}\n431|\tvalues := make([]scalar.Digest, 0, len(elements))\n432|\tfor _, element := range elements {\n433|\t\tdigest, ok := CheckDigest(element)\n434|\t\tif !ok {\n435|\t\t\treturn nil, false\n436|\t\t}\n437|\t\tvalues = append(values, digest)\n438|\t}\n439|\tfor index := 1; index < len(values); index++ {\n440|\t\tif values[index-1].String() >= values[index].String() {\n441|\t\t\treturn nil, false\n442|\t\t}\n443|\t}\n444|\treturn values, true\n445|}\n446|\n447|// refuse builds the package error for one refused member: the\n448|// rule in human text automation must never branch on, naming the\n449|// member. Tests assert the full text, so a reworded rule fails\n450|// its row instead of passing against a stale copy.\n451|func refuse(rule, member string) error {\n452|\tif member == \"\" {\n453|\t\treturn fmt.Errorf(\"environment %s\", rule)\n454|\t}\n455|\treturn fmt.Errorf(\"environment %s: %s\", rule, member)\n456|}"}}}
