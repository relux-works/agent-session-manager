{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53b","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":248,"recorded_at":1780531400000491,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a076654eda7e5383c57c1c251ea735","text":"Read text file `internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.8 closed\n15|// body. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing\n18|// every arm. A helper that fronted a constructor would collapse\n19|// distinct rules into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer:\n22|// Section 7.8 counts and limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// frameFault is one strict-decode failure: what was wrong and which\n26|// member it was found in, if any. It never carries foreign bytes.\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|// decodeStrictObject parses one complete JSON object with duplicate\n33|// member rejection. It is the only JSON entry point in this package:\n34|// every body crosses it before any member is read. A non-UTF-8\n35|// frame, a lone surrogate escape, a non-object top level, a\n36|// duplicated member, or trailing data is a fault, never a partial\n37|// object the caller could mistake for a result.\n38|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n39|\tif !utf8.Valid(data) {\n40|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n41|\t}\n42|\tif hasLoneSurrogateEscape(data) {\n43|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n44|\t}\n45|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n46|\ttoken, err := decoder.Token()\n47|\tif err != nil {\n48|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n49|\t}\n50|\tdelim, ok := token.(json.Delim)\n51|\tif !ok || delim != '{' {\n52|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n53|\t}\n54|\tmembers := map[string]json.RawMessage{}\n55|\tfor decoder.More() {\n56|\t\tkeyToken, err := decoder.Token()\n57|\t\tif err != nil {\n58|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n59|\t\t}\n60|\t\tkey, ok := keyToken.(string)\n61|\t\tif !ok {\n62|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n63|\t\t}\n64|\t\tif _, duplicate := members[key]; duplicate {\n65|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n66|\t\t}\n67|\t\tvar raw json.RawMessage\n68|\t\tif err := decoder.Decode(&raw); err != nil {\n69|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n70|\t\t}\n71|\t\tmembers[key] = raw\n72|\t}\n73|\tif token, err := decoder.Token(); err != nil {\n74|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n75|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n76|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n77|\t}\n78|\tif _, err := decoder.Token(); err != io.EOF {\n79|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n80|\t}\n81|\treturn members, nil\n82|}\n83|\n84|// hasLoneSurrogateEscape reports whether the raw frame carries a\n85|// UTF-16 escape the JSON string grammar cannot pair: a high\n86|// surrogate not followed by a low surrogate, a low surrogate with no\n87|// high surrogate before it, or a truncated escape. Go's encoding/json\n88|// would otherwise replace the lone escape with U+FFFD silently, so\n89|// Section 1.6 wire bodies carrying lone surrogates would be admitted\n90|// with rewritten bytes. This is a local copy of the shared surrogate\n91|// rule because the shared implementation is unexported; the agreement\n92|// test pins it against canonicaljson.Canonicalize over a generated\n93|// escape corpus whose verdicts come from construction, not from\n94|// either implementation.\n95|func hasLoneSurrogateEscape(data []byte) bool {\n96|\tfor index := 0; index < len(data); index++ {\n97|\t\tif data[index] != '\\\\' {\n98|\t\t\tcontinue\n99|\t\t}\n100|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n101|\t\t\tcontinue\n102|\t\t}\n103|\t\tfirst, length := readUTF16Escape(data, index+2)\n104|\t\tif length < 0 {\n105|\t\t\treturn true\n106|\t\t}\n107|\t\tindex += 1 + length\n108|\t\tif first >= 0xD800 && first <= 0xDBFF {\n109|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n110|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n111|\t\t\t\treturn true\n112|\t\t\t}\n113|\t\t\tindex += 6\n114|\t\t\tcontinue\n115|\t\t}\n116|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n117|\t\t\treturn true\n118|\t\t}\n119|\t}\n120|\treturn false\n121|}\n122|\n123|// readUTF16Escape reads four hex digits at the offset. It returns the\n124|// value and the consumed length, or a negative length when the escape\n125|// is truncated or not hexadecimal.\n126|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n127|\tif offset+4 > len(data) {\n128|\t\treturn 0, -1\n129|\t}\n130|\tvar value uint16\n131|\tfor _, digit := range data[offset : offset+4] {\n132|\t\tvalue <<= 4\n133|\t\tswitch {\n134|\t\tcase digit >= '0' && digit <= '9':\n135|\t\t\tvalue |= uint16(digit - '0')\n136|\t\tcase digit >= 'a' && digit <= 'f':\n137|\t\t\tvalue |= uint16(digit-'a') + 10\n138|\t\tcase digit >= 'A' && digit <= 'F':\n139|\t\t\tvalue |= uint16(digit-'A') + 10\n140|\t\tdefault:\n141|\t\t\treturn 0, -1\n142|\t\t}\n143|\t}\n144|\treturn value, 4\n145|}\n146|\n147|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n148|// at the offset. Anything else — a truncated escape, a non-escape,\n149|// or input end — is a negative length.\n150|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n151|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n152|\t\treturn 0, -1\n153|\t}\n154|\treturn readUTF16Escape(data, offset+2)\n155|}\n156|\n157|// unknownMember names a member outside the closed set, if any. The\n158|// single-unknown fixtures keep the verdict deterministic: with\n159|// several unknowns the map order decides which is named, so tests\n160|// never assert a name from a multi-unknown body.\n161|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n162|\tfor name := range members {\n163|\t\tif !allowed[name] {\n164|\t\t\treturn name, true\n165|\t\t}\n166|\t}\n167|\treturn \"\", false\n168|}\n169|\n170|// missingMember names the first required member with no value, if\n171|// any. The required list is fixed order, so the verdict is\n172|// deterministic for every missing combination.\n173|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n174|\tfor _, name := range required {\n175|\t\tif _, present := members[name]; !present {\n176|\t\t\treturn name, true\n177|\t\t}\n178|\t}\n179|\treturn \"\", false\n180|}\n181|\n182|// rawString reads a JSON string member.\n183|func rawString(raw json.RawMessage) (string, bool) {\n184|\tvar value string\n185|\tif err := json.Unmarshal(raw, &value); err != nil {\n186|\t\treturn \"\", false\n187|\t}\n188|\treturn value, true\n189|}\n190|\n191|// rawBool reads a JSON boolean member.\n192|func rawBool(raw json.RawMessage) (bool, bool) {\n193|\tvar value bool\n194|\tif err := json.Unmarshal(raw, &value); err != nil {\n195|\t\treturn false, false\n196|\t}\n197|\treturn value, true\n198|}\n199|\n200|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n201|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n202|// even when it names the same mathematical value: the canonical\n203|// bodies carry counts, never measurements.\n204|func rawUint53(raw json.RawMessage) (uint64, bool) {\n205|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n206|\tdecoder.UseNumber()\n207|\tvar value any\n208|\tif err := decoder.Decode(&value); err != nil {\n209|\t\treturn 0, false\n210|\t}\n211|\tnumber, ok := value.(json.Number)\n212|\tif !ok {\n213|\t\treturn 0, false\n214|\t}\n215|\tliteral := number.String()\n216|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n217|\t\treturn 0, false\n218|\t}\n219|\treturn parseUint53Literal(literal)\n220|}\n221|\n222|// parseUint53Literal reads a digit-only literal without trusting a\n223|// float conversion: the magnitude bound is checked on the digit\n224|// string, so 2^53 is refused even on platforms that could hold it.\n225|func parseUint53Literal(literal string) (uint64, bool) {\n226|\tvar value uint64\n227|\tfor index := 0; index < len(literal); index++ {\n228|\t\tdigit := literal[index]\n229|\t\tif digit < '0' || digit > '9' {\n230|\t\t\treturn 0, false\n231|\t\t}\n232|\t\tvalue = value*10 + uint64(digit-'0')\n233|\t\tif value > maxUint53 {\n234|\t\t\treturn 0, false\n235|\t\t}\n236|\t}\n237|\treturn value, true\n238|}\n239|\n240|// stringLength is the Section 1.6 string measure in characters, not\n241|// bytes: a bound of string[1..128] admits 128 characters of any\n242|// width.\n243|func stringLength(value string) int {\n244|\treturn utf8.RuneCountInString(value)\n245|}\n246|\n247|// checkStringBounds reports whether the member is a JSON string whose\n248|// character count falls in the inclusive bound.\n249|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n250|\tvalue, ok := rawString(raw)\n251|\tif !ok {\n252|\t\treturn \"\", false\n253|\t}\n254|\tlength := stringLength(value)\n255|\tif length < minimum || length > maximum {\n256|\t\treturn \"\", false\n257|\t}\n258|\treturn value, true\n259|}\n260|\n261|// checkUint53Bounds reports whether the member is a uint53 in the\n262|// inclusive bound. Both edges are checked: a one-sided check would\n263|// admit the open side.\n264|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n265|\tvalue, ok := rawUint53(raw)\n266|\tif !ok {\n267|\t\treturn 0, false\n268|\t}\n269|\tif value < minimum || value > maximum {\n270|\t\treturn 0, false\n271|\t}\n272|\treturn value, true\n273|}\n274|\n275|// checkDigest reports whether the member is a digest of the pinned\n276|// sha256 form.\n277|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n278|\tvalue, ok := rawString(raw)\n279|\tif !ok {\n280|\t\treturn scalar.Digest{}, false\n281|\t}\n282|\tdigest, err := scalar.ParseDigest(value)\n283|\tif err != nil {\n284|\t\treturn scalar.Digest{}, false\n285|\t}\n286|\treturn digest, true\n287|}\n288|\n289|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n290|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n291|\tvalue, ok := rawString(raw)\n292|\tif !ok {\n293|\t\treturn scalar.UUIDv7{}, false\n294|\t}\n295|\tidentifier, err := scalar.ParseUUIDv7(value)\n296|\tif err != nil {\n297|\t\treturn scalar.UUIDv7{}, false\n298|\t}\n299|\treturn identifier, true\n300|}\n301|\n302|// checkTimestamp reports whether the member is a pinned timestamp.\n303|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Timestamp{}, false\n307|\t}\n308|\tinstant, err := scalar.ParseTimestamp(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Timestamp{}, false\n311|\t}\n312|\treturn instant, true\n313|}\n314|\n315|// isNull reports whether the member is an explicit JSON null.\n316|func isNull(raw json.RawMessage) bool {\n317|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n318|}\n319|\n320|// decodeArray reads a JSON array member into its raw elements. A\n321|// non-array — including null — is not an empty array.\n322|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n323|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n324|\ttoken, err := decoder.Token()\n325|\tif err != nil {\n326|\t\treturn nil, false\n327|\t}\n328|\tdelim, ok := token.(json.Delim)\n329|\tif !ok || delim != '[' {\n330|\t\treturn nil, false\n331|\t}\n332|\tvar elements []json.RawMessage\n333|\tfor decoder.More() {\n334|\t\tvar element json.RawMessage\n335|\t\tif err := decoder.Decode(&element); err != nil {\n336|\t\t\treturn nil, false\n337|\t\t}\n338|\t\telements = append(elements, element)\n339|\t}\n340|\tif token, err := decoder.Token(); err != nil {\n341|\t\treturn nil, false\n342|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n343|\t\treturn nil, false\n344|\t}\n345|\tif _, err := decoder.Token(); err != io.EOF {\n346|\t\treturn nil, false\n347|\t}\n348|\treturn elements, true\n349|}\n350|\n351|// checkSortedUniqueStrings reports whether the member is an array of\n352|// strings in the item bound whose JCS encodings order strictly\n353|// increasingly with no duplicates. Bytewise JCS order over strings\n354|// is plain lexicographic order, so the check compares directly; the\n355|// count bound is checked on both edges.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// semverPattern is the SemVer grammar adapter and environment\n411|// versions satisfy: three dot-separated non-negative integers with\n412|// no leading zeros, an optional pre-release, and optional build\n413|// metadata.\n414|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n415|\n416|// providerIDPattern is the Section 7.1 provider-id grammar the\n417|// manifest, context, and binding layers read:\n418|// [a-z][a-z0-9-]{0,31}.\n419|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n420|\n421|// environmentIDPattern is the Section 7.8 environment-id grammar:\n422|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n423|// adapter; dots separate the native hierarchy, never trust.\n424|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n425|\n426|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n427|// dot-separated lowercase labels, 3..253 characters.\n428|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n429|\n430|// checkExtensions reports whether the member is an object whose keys\n431|// are all reverse-DNS names. Values cross opaquely: extensions\n432|// cannot add operations, capabilities, or trust facts, and no member\n433|// of this package reads an extension value for any admission\n434|// decision.\n435|func checkExtensions(raw json.RawMessage) bool {\n436|\tmembers, fault := decodeStrictObject(raw)\n437|\tif fault != nil {\n438|\t\treturn false\n439|\t}\n440|\tfor name := range members {\n441|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n442|\t\t\treturn false\n443|\t\t}\n444|\t}\n445|\treturn true\n446|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53d","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":249,"recorded_at":1780531400000493,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a076654f7a745280588ba91c9816df","text":"Read text file `internal/dirnode/decode.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.9 and\n15|// 10.8.5 closed body. Every helper reports a verdict and never\n16|// refuses: all refusals call one of the refusal constructors\n17|// directly at the deciding site with literal details, so the\n18|// refusal-arm inventory keeps seeing every arm. A helper that\n19|// fronted a constructor would collapse distinct rules into one\n20|// obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer:\n23|// Section 7.9 counts and limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// frameFault is one strict-decode failure: what was wrong and which\n27|// member it was found in, if any. It never carries foreign bytes.\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|// decodeStrictObject parses one complete JSON object with duplicate\n34|// member rejection. It is the only JSON entry point in this package:\n35|// every body crosses it before any member is read. A non-UTF-8\n36|// frame, a lone surrogate escape, a non-object top level, a\n37|// duplicated member, or trailing data is a fault, never a partial\n38|// object the caller could mistake for a result.\n39|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n40|\tif !utf8.Valid(data) {\n41|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n42|\t}\n43|\tif hasLoneSurrogateEscape(data) {\n44|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n45|\t}\n46|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n47|\ttoken, err := decoder.Token()\n48|\tif err != nil {\n49|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n50|\t}\n51|\tdelim, ok := token.(json.Delim)\n52|\tif !ok || delim != '{' {\n53|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n54|\t}\n55|\tmembers := map[string]json.RawMessage{}\n56|\tfor decoder.More() {\n57|\t\tkeyToken, err := decoder.Token()\n58|\t\tif err != nil {\n59|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n60|\t\t}\n61|\t\tkey, ok := keyToken.(string)\n62|\t\tif !ok {\n63|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n64|\t\t}\n65|\t\tif _, duplicate := members[key]; duplicate {\n66|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n67|\t\t}\n68|\t\tvar raw json.RawMessage\n69|\t\tif err := decoder.Decode(&raw); err != nil {\n70|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n71|\t\t}\n72|\t\tmembers[key] = raw\n73|\t}\n74|\tif token, err := decoder.Token(); err != nil {\n75|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n76|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n77|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n78|\t}\n79|\tif _, err := decoder.Token(); err != io.EOF {\n80|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n81|\t}\n82|\treturn members, nil\n83|}\n84|\n85|// hasLoneSurrogateEscape reports whether the raw frame carries a\n86|// UTF-16 escape the JSON string grammar cannot pair. Go's\n87|// encoding/json would otherwise replace the lone escape with\n88|// U+FFFD silently, so wire bodies carrying lone surrogates would be\n89|// admitted with rewritten bytes.\n90|func hasLoneSurrogateEscape(data []byte) bool {\n91|\tfor index := 0; index < len(data); index++ {\n92|\t\tif data[index] != '\\\\' {\n93|\t\t\tcontinue\n94|\t\t}\n95|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n96|\t\t\tcontinue\n97|\t\t}\n98|\t\tfirst, length := readUTF16Escape(data, index+2)\n99|\t\tif length < 0 {\n100|\t\t\treturn true\n101|\t\t}\n102|\t\tindex += 1 + length\n103|\t\tif first >= 0xD800 && first <= 0xDBFF {\n104|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n105|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n106|\t\t\t\treturn true\n107|\t\t\t}\n108|\t\t\tindex += 6\n109|\t\t\tcontinue\n110|\t\t}\n111|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n112|\t\t\treturn true\n113|\t\t}\n114|\t}\n115|\treturn false\n116|}\n117|\n118|// readUTF16Escape reads four hex digits at the offset. It returns the\n119|// value and the consumed length, or a negative length when the escape\n120|// is truncated or not hexadecimal.\n121|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n122|\tif offset+4 > len(data) {\n123|\t\treturn 0, -1\n124|\t}\n125|\tvar value uint16\n126|\tfor _, digit := range data[offset : offset+4] {\n127|\t\tvalue <<= 4\n128|\t\tswitch {\n129|\t\tcase digit >= '0' && digit <= '9':\n130|\t\t\tvalue |= uint16(digit - '0')\n131|\t\tcase digit >= 'a' && digit <= 'f':\n132|\t\t\tvalue |= uint16(digit-'a') + 10\n133|\t\tcase digit >= 'A' && digit <= 'F':\n134|\t\t\tvalue |= uint16(digit-'A') + 10\n135|\t\tdefault:\n136|\t\t\treturn 0, -1\n137|\t\t}\n138|\t}\n139|\treturn value, 4\n140|}\n141|\n142|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n143|// at the offset. Anything else is a negative length.\n144|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n145|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n146|\t\treturn 0, -1\n147|\t}\n148|\treturn readUTF16Escape(data, offset+2)\n149|}\n150|\n151|// unknownMember names a member outside the closed set, if any. The\n152|// single-unknown fixtures keep the verdict deterministic: with\n153|// several unknowns the map order decides which is named, so tests\n154|// never assert a name from a multi-unknown body.\n155|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n156|\tfor name := range members {\n157|\t\tif !allowed[name] {\n158|\t\t\treturn name, true\n159|\t\t}\n160|\t}\n161|\treturn \"\", false\n162|}\n163|\n164|// missingMember names the first required member with no value, if\n165|// any. The required list is fixed order, so the verdict is\n166|// deterministic for every missing combination.\n167|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n168|\tfor _, name := range required {\n169|\t\tif _, present := members[name]; !present {\n170|\t\t\treturn name, true\n171|\t\t}\n172|\t}\n173|\treturn \"\", false\n174|}\n175|\n176|// rawString reads a JSON string member.\n177|func rawString(raw json.RawMessage) (string, bool) {\n178|\tvar value string\n179|\tif err := json.Unmarshal(raw, &value); err != nil {\n180|\t\treturn \"\", false\n181|\t}\n182|\treturn value, true\n183|}\n184|\n185|// rawBool reads a JSON boolean member.\n186|func rawBool(raw json.RawMessage) (bool, bool) {\n187|\tvar value bool\n188|\tif err := json.Unmarshal(raw, &value); err != nil {\n189|\t\treturn false, false\n190|\t}\n191|\treturn value, true\n192|}\n193|\n194|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n195|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n196|// even when it names the same mathematical value.\n197|func rawUint53(raw json.RawMessage) (uint64, bool) {\n198|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n199|\tdecoder.UseNumber()\n200|\tvar value any\n201|\tif err := decoder.Decode(&value); err != nil {\n202|\t\treturn 0, false\n203|\t}\n204|\tnumber, ok := value.(json.Number)\n205|\tif !ok {\n206|\t\treturn 0, false\n207|\t}\n208|\tliteral := number.String()\n209|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n210|\t\treturn 0, false\n211|\t}\n212|\treturn parseUint53Literal(literal)\n213|}\n214|\n215|// parseUint53Literal reads a digit-only literal without trusting a\n216|// float conversion: the magnitude bound is checked on the digit\n217|// string, so 2^53 is refused even on platforms that could hold it.\n218|func parseUint53Literal(literal string) (uint64, bool) {\n219|\tvar value uint64\n220|\tfor index := 0; index < len(literal); index++ {\n221|\t\tdigit := literal[index]\n222|\t\tif digit < '0' || digit > '9' {\n223|\t\t\treturn 0, false\n224|\t\t}\n225|\t\tvalue = value*10 + uint64(digit-'0')\n226|\t\tif value > maxUint53 {\n227|\t\t\treturn 0, false\n228|\t\t}\n229|\t}\n230|\treturn value, true\n231|}\n232|\n233|// stringLength is the Section 1.6 string measure in characters, not\n234|// bytes.\n235|func stringLength(value string) int {\n236|\treturn utf8.RuneCountInString(value)\n237|}\n238|\n239|// checkStringBounds reports whether the member is a JSON string whose\n240|// character count falls in the inclusive bound.\n241|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n242|\tvalue, ok := rawString(raw)\n243|\tif !ok {\n244|\t\treturn \"\", false\n245|\t}\n246|\tlength := stringLength(value)\n247|\tif length < minimum || length > maximum {\n248|\t\treturn \"\", false\n249|\t}\n250|\treturn value, true\n251|}\n252|\n253|// checkUint53Bounds reports whether the member is a uint53 in the\n254|// inclusive bound. Both edges are checked: a one-sided check would\n255|// admit the open side.\n256|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n257|\tvalue, ok := rawUint53(raw)\n258|\tif !ok {\n259|\t\treturn 0, false\n260|\t}\n261|\tif value < minimum || value > maximum {\n262|\t\treturn 0, false\n263|\t}\n264|\treturn value, true\n265|}\n266|\n267|// checkDigest reports whether the member is a digest of the pinned\n268|// sha256 form.\n269|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n270|\tvalue, ok := rawString(raw)\n271|\tif !ok {\n272|\t\treturn scalar.Digest{}, false\n273|\t}\n274|\tdigest, err := scalar.ParseDigest(value)\n275|\tif err != nil {\n276|\t\treturn scalar.Digest{}, false\n277|\t}\n278|\treturn digest, true\n279|}\n280|\n281|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n282|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n283|\tvalue, ok := rawString(raw)\n284|\tif !ok {\n285|\t\treturn scalar.UUIDv7{}, false\n286|\t}\n287|\tidentifier, err := scalar.ParseUUIDv7(value)\n288|\tif err != nil {\n289|\t\treturn scalar.UUIDv7{}, false\n290|\t}\n291|\treturn identifier, true\n292|}\n293|\n294|// checkTimestamp reports whether the member is a pinned timestamp.\n295|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n296|\tvalue, ok := rawString(raw)\n297|\tif !ok {\n298|\t\treturn scalar.Timestamp{}, false\n299|\t}\n300|\tinstant, err := scalar.ParseTimestamp(value)\n301|\tif err != nil {\n302|\t\treturn scalar.Timestamp{}, false\n303|\t}\n304|\treturn instant, true\n305|}\n306|\n307|// checkDigestString reports whether the value parses as a digest of\n308|// the pinned form.\n309|func checkDigestString(value string) (string, bool) {\n310|\tdigest, err := scalar.ParseDigest(value)\n311|\tif err != nil {\n312|\t\treturn \"\", false\n313|\t}\n314|\treturn digest.String(), true\n315|}\n316|\n317|// isNull reports whether the member is an explicit JSON null.\n318|func isNull(raw json.RawMessage) bool {\n319|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n320|}\n321|\n322|// decodeArray reads a JSON array member into its raw elements. A\n323|// non-array — including null — is not an empty array.\n324|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n325|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n326|\ttoken, err := decoder.Token()\n327|\tif err != nil {\n328|\t\treturn nil, false\n329|\t}\n330|\tdelim, ok := token.(json.Delim)\n331|\tif !ok || delim != '[' {\n332|\t\treturn nil, false\n333|\t}\n334|\tvar elements []json.RawMessage\n335|\tfor decoder.More() {\n336|\t\tvar element json.RawMessage\n337|\t\tif err := decoder.Decode(&element); err != nil {\n338|\t\t\treturn nil, false\n339|\t\t}\n340|\t\telements = append(elements, element)\n341|\t}\n342|\tif token, err := decoder.Token(); err != nil {\n343|\t\treturn nil, false\n344|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n345|\t\treturn nil, false\n346|\t}\n347|\tif _, err := decoder.Token(); err != io.EOF {\n348|\t\treturn nil, false\n349|\t}\n350|\treturn elements, true\n351|}\n352|\n353|// checkSortedUniqueStrings reports whether the member is an array of\n354|// strings in the item bound whose encodings order strictly\n355|// increasingly with no duplicates, in the count bound.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// checkSortedUniqueUUIDv7 reports whether the member is a sorted\n411|// unique UUIDv7 array in the count bound.\n412|func checkSortedUniqueUUIDv7(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.UUIDv7, bool) {\n413|\telements, ok := decodeArray(raw)\n414|\tif !ok {\n415|\t\treturn nil, false\n416|\t}\n417|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n418|\t\treturn nil, false\n419|\t}\n420|\tvalues := make([]scalar.UUIDv7, 0, len(elements))\n421|\tfor _, element := range elements {\n422|\t\tidentifier, ok := checkUUIDv7(element)\n423|\t\tif !ok {\n424|\t\t\treturn nil, false\n425|\t\t}\n426|\t\tvalues = append(values, identifier)\n427|\t}\n428|\tfor index := 1; index < len(values); index++ {\n429|\t\tif values[index-1].String() >= values[index].String() {\n430|\t\t\treturn nil, false\n431|\t\t}\n432|\t}\n433|\treturn values, true\n434|}\n435|\n436|// checkOptionalDigest reads a digest|null member: null is the only\n437|// accepted absence, and any other non-digest is not an absence.\n438|func checkOptionalDigest(raw json.RawMessage) (scalar.Digest, bool, bool) {\n439|\tif isNull(raw) {\n440|\t\treturn scalar.Digest{}, true, true\n441|\t}\n442|\tdigest, ok := checkDigest(raw)\n443|\tif !ok {\n444|\t\treturn scalar.Digest{}, false, false\n445|\t}\n446|\treturn digest, true, false\n447|}\n448|\n449|// checkOptionalString reads a bounded string|null member with the\n450|// same absence rule.\n451|func checkOptionalString(raw json.RawMessage, minimum, maximum int) (string, bool, bool) {\n452|\tif isNull(raw) {\n453|\t\treturn \"\", true, true\n454|\t}\n455|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n456|\tif !ok {\n457|\t\treturn \"\", false, false\n458|\t}\n459|\treturn value, true, false\n460|}\n461|\n462|// semverPattern is the SemVer grammar versions satisfy: three\n463|// dot-separated non-negative integers with no leading zeros, an\n464|// optional pre-release, and optional build metadata.\n465|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n466|\n467|// environmentIDPattern is the environment-id grammar:\n468|// [a-z][a-z0-9.-]{0,63}.\n469|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n470|\n471|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n472|// dot-separated lowercase labels.\n473|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n474|\n475|// checkSemver reports whether the value is a SemVer string.\n476|func checkSemver(value string) bool {\n477|\treturn semverPattern.MatchString(value)\n478|}\n479|\n480|// checkExtensions reports whether the member is an object whose keys\n481|// are all reverse-DNS names. Values cross opaquely: extensions\n482|// cannot add operations, capabilities, or trust facts, and no member\n483|// of this package reads an extension value for any admission\n484|// decision.\n485|func checkExtensions(raw json.RawMessage) bool {\n486|\tmembers, fault := decodeStrictObject(raw)\n487|\tif fault != nil {\n488|\t\treturn false\n489|\t}\n490|\tfor name := range members {\n491|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n492|\t\t\treturn false\n493|\t\t}\n494|\t}\n495|\treturn true\n496|}\n497|\n498|// checkURI reports whether the value is a URI reference of 1..512\n499|// characters: no whitespace or control characters, with a scheme\n500|// prefix. Contract identifiers in this contract family are URNs, so\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53f","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":250,"recorded_at":1780531400000495,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a07665502470829ac8348684dc6d79","text":"Read text file `internal/environ/census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the shared-implementation census. The story's\n15|// premise is that the Provider, Session Adapter, and Directory\n16|// Node facades sit on one environment library; today each facade\n17|// carries its own copy of the shared rules, and independent\n18|// copies of the same rule drift in ways no per-facade reviewer\n19|// can see. This census is the boundary that fails when the\n20|// facades diverge: it derives every shared-rule implementation\n21|// from production source and requires the derived set to equal\n22|// the ledger below exactly.\n23|//\n24|// A new copy of a shared rule — a fourth facade\n25|// decodeStrictObject, a third surrogate-gate spelling, a new\n26|// string-measure helper — fails here as an unregistered site.\n27|// Removing or renaming a ledgered implementation orphans its row\n28|// and fails too. An empty scan fails closed. The ledger records\n29|// the single canonical owner per rule (this package, or scalar\n30|// where the grammar already has one) plus the copies this leaf\n31|// may not edit; each copy names the battery file that pins it to\n32|// the canonical semantics, and the escaped-backslash ledger in\n33|// the frame battery proves the battery observes facade\n34|// differences rather than asserting them away.\n35|//\n36|// Scope. The scan covers the story packages (environ, provider,\n37|// provhost, sessadapter, dirnode) plus the grammar owners\n38|// (scalar, canonicaljson). Copies in config, cliresult,\n39|// terminalbackend, axerror, and the other stories' packages are\n40|// outside this story's ownership: each package derives its own\n41|// inventories in its own test files, and gating another story's\n42|// package from here would couple stories that must land\n43|// independently. That exclusion is a stated bound, not a blind\n44|// spot: the scan fails closed inside its scope, and a copy that\n45|// moves into scope (a new definition in a scanned package)\n46|// fails as unregistered.\n47|\n48|// sharedSite is one derived shared-rule implementation.\n49|type sharedSite struct {\n50|\tclass  string\n51|\tpkg    string\n52|\tfile   string\n53|\tsymbol string\n54|}\n55|\n56|// sharedSiteKey renders the ledger key for one site.\n57|func (site sharedSite) sharedSiteKey() string {\n58|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n59|}\n60|\n61|// censusPackages is the exact scan scope. A production file in\n62|// any other package is outside this story's jurisdiction.\n63|var censusPackages = map[string]bool{\n64|\t\"environ\":       true,\n65|\t\"provider\":      true,\n66|\t\"provhost\":      true,\n67|\t\"sessadapter\":   true,\n68|\t\"dirnode\":       true,\n69|\t\"scalar\":        true,\n70|\t\"canonicaljson\": true,\n71|}\n72|\n73|// sharedLedger maps every known shared-rule implementation to\n74|// the rationale that keeps it honest. Canonical owners are the\n75|// single implementation new code must use; every other row names\n76|// the battery file that pins the copy to the canonical\n77|// semantics.\n78|var sharedLedger = map[string]string{\n79|\t// Frame decoders: one JSON entry point per package.\n80|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":     \"canonical owner: string-walk surrogate semantics, rune measure\",\n81|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\":  \"pinned by frame_agreement_test.go\",\n82|\t\"strict-decoder|sessadapter|decode.go|decodeStrictObject\": \"byte-frozen leaf 1: pinned by frame_agreement_test.go\",\n83|\t\"strict-decoder|dirnode|decode.go|decodeStrictObject\":     \"byte-frozen leaf 2: pinned by frame_agreement_test.go\",\n84|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\":  \"canonicalizer entry: distinct JCS pipeline role, surrogate verdicts pinned by frame_agreement_test.go\",\n85|\t// Lone-surrogate gates.\n86|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n87|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n88|\t\"surrogate-gate|sessadapter|decode.go|hasLoneSurrogateEscape\":        \"byte-frozen leaf 1: raw scan, escaped-backslash divergence ledgered in frame_agreement_test.go\",\n89|\t\"surrogate-gate|dirnode|decode.go|hasLoneSurrogateEscape\":            \"byte-frozen leaf 2: raw scan, escaped-backslash divergence ledgered in frame_agreement_test.go\",\n90|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n91|\t// String measures.\n92|\t\"string-measure|environ|decode.go|StringLength\":     \"canonical owner: runes per Section 1.6\",\n93|\t\"string-measure|provhost|opdecode.go|runeLength\":    \"runes, pinned by measure_agreement_test.go\",\n94|\t\"string-measure|sessadapter|decode.go|stringLength\": \"byte-frozen leaf 1: runes, pinned by measure_agreement_test.go\",\n95|\t\"string-measure|dirnode|decode.go|stringLength\":     \"byte-frozen leaf 2: runes, pinned by measure_agreement_test.go\",\n96|\t// Identity validators: two refusal dialects over one rule.\n97|\t\"identity-validator|provhost|identity.go|CheckIdentity\":                           \"provider-stdio refusal dialect, pinned by identity_agreement_test.go\",\n98|\t\"identity-validator|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"identity refusal dialect, pinned by identity_agreement_test.go\",\n99|}\n100|\n101|// sharedFunctionSymbols maps a function name to its census\n102|// class.\n103|var sharedFunctionSymbols = map[string]string{\n104|\t\"decodeStrictObject\":             \"strict-decoder\",\n105|\t\"DecodeStrictObject\":             \"strict-decoder\",\n106|\t\"decodeStrict\":                   \"strict-decoder\",\n107|\t\"hasLoneSurrogateEscape\":         \"surrogate-gate\",\n108|\t\"HasLoneSurrogateEscape\":         \"surrogate-gate\",\n109|\t\"validateSurrogateEscapes\":       \"surrogate-gate\",\n110|\t\"stringLength\":                   \"string-measure\",\n111|\t\"runeLength\":                     \"string-measure\",\n112|\t\"StringLength\":                   \"string-measure\",\n113|\t\"CheckIdentity\":                  \"identity-validator\",\n114|\t\"validateProviderIdentityRecord\": \"identity-validator\",\n115|}\n116|\n117|// grammarSymbols maps a package-level variable name to its\n118|// grammar class. Only same-rule grammars share a class: the\n119|// three capabilityOrder tables (directory eight, adapter\n120|// fifteen, provider seven) and the per-major platform tables are\n121|// deliberately absent here and are pinned by literal-list\n122|// derivation in grammar_test.go instead, where the rule identity\n123|// travels with the comparison.\n124|var grammarSymbols = map[string]string{\n125|\t\"environmentIDPattern\": \"env-id-grammar\",\n126|\t\"semverPattern\":        \"semver-grammar\",\n127|\t\"reverseDNSPattern\":    \"extensions-grammar\",\n128|\t\"providerIDPattern\":    \"provider-id-grammar\",\n129|}\n130|\n131|// deriveSharedSites scans every production Go file in the census\n132|// packages for shared-rule implementations. Test files are never\n133|// scanned: a helper in a test is not a production copy. An\n134|// unreadable file or a parse failure fails closed: a scanner that\n135|// cannot read a file must not report the file as clean.\n136|func deriveSharedSites(t *testing.T) map[string]bool {\n137|\tt.Helper()\n138|\tsites := map[string]bool{}\n139|\tfor _, site := range scanSharedSymbols(t, sharedFunctionSymbols, true) {\n140|\t\tsites[site] = true\n141|\t}\n142|\tif len(sites) == 0 {\n143|\t\tt.Fatal(\"census derived zero shared-rule sites from a tree known to duplicate them; the scanner is blind, not the tree clean\")\n144|\t}\n145|\treturn sites\n146|}\n147|\n148|// scanSharedSymbols scans the census packages for function or\n149|// package-level variable definitions whose names appear in the\n150|// symbol map, and returns ledger keys for each hit.\n151|func scanSharedSymbols(t *testing.T, symbols map[string]string, functions bool) []string {\n152|\tt.Helper()\n153|\troot, err := internalRoot(t)\n154|\tif err != nil {\n155|\t\tt.Fatalf(\"census: %v\", err)\n156|\t}\n157|\tvar keys []string\n158|\tcount := 0\n159|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n160|\t\tif err != nil {\n161|\t\t\treturn err\n162|\t\t}\n163|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n164|\t\t\treturn nil\n165|\t\t}\n166|\t\trel, err := filepath.Rel(root, path)\n167|\t\tif err != nil {\n168|\t\t\treturn err\n169|\t\t}\n170|\t\tparts := strings.Split(rel, string(filepath.Separator))\n171|\t\tpkg := parts[0]\n172|\t\tif !censusPackages[pkg] {\n173|\t\t\treturn nil\n174|\t\t}\n175|\t\tcount++\n176|\t\tsource, err := os.ReadFile(path)\n177|\t\tif err != nil {\n178|\t\t\tt.Fatalf(\"census: read %s: %v\", path, err)\n179|\t\t}\n180|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"census: parse %s: %v\", path, err)\n183|\t\t}\n184|\t\tfile := parts[len(parts)-1]\n185|\t\tfor _, decl := range syntax.Decls {\n186|\t\t\tswitch node := decl.(type) {\n187|\t\t\tcase *ast.FuncDecl:\n188|\t\t\t\tif !functions || node.Name == nil {\n189|\t\t\t\t\tcontinue\n190|\t\t\t\t}\n191|\t\t\t\tif class, ok := symbols[node.Name.Name]; ok {\n192|\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, node.Name.Name}.sharedSiteKey())\n193|\t\t\t\t}\n194|\t\t\tcase *ast.GenDecl:\n195|\t\t\t\tif functions {\n196|\t\t\t\t\tcontinue\n197|\t\t\t\t}\n198|\t\t\t\tfor _, spec := range node.Specs {\n199|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n200|\t\t\t\t\tif !ok {\n201|\t\t\t\t\t\tcontinue\n202|\t\t\t\t\t}\n203|\t\t\t\t\tfor _, name := range value.Names {\n204|\t\t\t\t\t\tif class, ok := symbols[name.Name]; ok {\n205|\t\t\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, name.Name}.sharedSiteKey())\n206|\t\t\t\t\t\t}\n207|\t\t\t\t\t}\n208|\t\t\t\t}\n209|\t\t\t}\n210|\t\t}\n211|\t\treturn nil\n212|\t})\n213|\tif err != nil {\n214|\t\tt.Fatalf(\"census: walk: %v\", err)\n215|\t}\n216|\tif count == 0 {\n217|\t\tt.Fatal(\"census scanned zero files; the scanner is broken, not the tree\")\n218|\t}\n219|\treturn keys\n220|}\n221|\n222|// internalRoot returns the internal/ source root above this\n223|// package directory.\n224|func internalRoot(t *testing.T) (string, error) {\n225|\tt.Helper()\n226|\tdirectory, err := os.Getwd()\n227|\tif err != nil {\n228|\t\treturn \"\", err\n229|\t}\n230|\treturn filepath.Dir(directory), nil\n231|}\n232|\n233|// TestSharedImplementationsAreCensused requires the derived\n234|// implementation set to equal the ledger exactly: an unregistered\n235|// copy fails as a unification violation, and a row naming an\n236|// implementation production no longer derives fails as orphaned.\n237|func TestSharedImplementationsAreCensused(t *testing.T) {\n238|\tderived := deriveSharedSites(t)\n239|\tfor key := range derived {\n240|\t\tif _, ok := sharedLedger[key]; !ok {\n241|\t\t\tt.Errorf(\"unregistered shared-rule copy %q: add one canonical implementation in internal/environ instead, or ledger the divergence with its agreement battery\", key)\n242|\t\t}\n243|\t}\n244|\tfor key, rationale := range sharedLedger {\n245|\t\tif !derived[key] {\n246|\t\t\tt.Errorf(\"orphaned ledger row %q (%s): production no longer derives it\", key, rationale)\n247|\t\t}\n248|\t}\n249|}\n250|\n251|// grammarSiteLedger names every grammar definition site in the\n252|// census scope. A new grammar definition fails here even when it\n253|// carries an identical literal: a second copy is a second copy,\n254|// and the next edit drifts exactly one of them.\n255|var grammarSiteLedger = map[string]bool{\n256|\t\"env-id-grammar|environ|tuple.go|environmentIDPattern\":                true,\n257|\t\"env-id-grammar|sessadapter|decode.go|environmentIDPattern\":           true,\n258|\t\"env-id-grammar|dirnode|decode.go|environmentIDPattern\":               true,\n259|\t\"env-id-grammar|canonicaljson|closed_shapes.go|environmentIDPattern\":  true,\n260|\t\"semver-grammar|environ|tuple.go|semverPattern\":                       true,\n261|\t\"semver-grammar|sessadapter|decode.go|semverPattern\":                  true,\n262|\t\"semver-grammar|dirnode|decode.go|semverPattern\":                      true,\n263|\t\"semver-grammar|canonicaljson|closed_shapes.go|semverPattern\":         true,\n264|\t\"semver-grammar|provhost|manifest.go|semverPattern\":                   true,\n265|\t\"extensions-grammar|environ|decode.go|reverseDNSPattern\":              true,\n266|\t\"extensions-grammar|sessadapter|decode.go|reverseDNSPattern\":          true,\n267|\t\"extensions-grammar|dirnode|decode.go|reverseDNSPattern\":              true,\n268|\t\"extensions-grammar|canonicaljson|closed_shapes.go|reverseDNSPattern\": true,\n269|\t\"provider-id-grammar|scalar|names.go|providerIDPattern\":               true,\n270|\t\"provider-id-grammar|provhost|manifest.go|providerIDPattern\":          true,\n271|\t\"provider-id-grammar|sessadapter|decode.go|providerIDPattern\":         true,\n272|\t\"provider-id-grammar|dirnode|query.go|providerIDPattern\":              true,\n273|}\n274|\n275|// deriveGrammarLiterals derives the regex literal behind every\n276|// grammar definition in the census scope, keyed by ledger key.\n277|// Two definitions carrying different literals are different\n278|// languages even when the symbol name matches; the grammar\n279|// battery requires one literal per class.\n280|func deriveGrammarLiterals(t *testing.T) (map[string]map[string]bool, map[string]bool) {\n281|\tt.Helper()\n282|\troot, err := internalRoot(t)\n283|\tif err != nil {\n284|\t\tt.Fatalf(\"grammar: %v\", err)\n285|\t}\n286|\tliterals := map[string]map[string]bool{}\n287|\tsites := map[string]bool{}\n288|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n289|\t\tif err != nil {\n290|\t\t\treturn err\n291|\t\t}\n292|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n293|\t\t\treturn nil\n294|\t\t}\n295|\t\trel, err := filepath.Rel(root, path)\n296|\t\tif err != nil {\n297|\t\t\treturn err\n298|\t\t}\n299|\t\tparts := strings.Split(rel, string(filepath.Separator))\n300|\t\tpkg := parts[0]\n301|\t\tif !censusPackages[pkg] {\n302|\t\t\treturn nil\n303|\t\t}\n304|\t\tsource, err := os.ReadFile(path)\n305|\t\tif err != nil {\n306|\t\t\tt.Fatalf(\"grammar: read %s: %v\", path, err)\n307|\t\t}\n308|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n309|\t\tif err != nil {\n310|\t\t\tt.Fatalf(\"grammar: parse %s: %v\", path, err)\n311|\t\t}\n312|\t\tfor _, decl := range syntax.Decls {\n313|\t\t\tnode, ok := decl.(*ast.GenDecl)\n314|\t\t\tif !ok {\n315|\t\t\t\tcontinue\n316|\t\t\t}\n317|\t\t\tfor _, spec := range node.Specs {\n318|\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n319|\t\t\t\tif !ok || len(value.Names) != 1 || len(value.Values) != 1 {\n320|\t\t\t\t\tcontinue\n321|\t\t\t\t}\n322|\t\t\t\tclass, ok := grammarSymbols[value.Names[0].Name]\n323|\t\t\t\tif !ok {\n324|\t\t\t\t\tcontinue\n325|\t\t\t\t}\n326|\t\t\t\tcall, ok := value.Values[0].(*ast.CallExpr)\n327|\t\t\t\tif !ok || len(call.Args) != 1 {\n328|\t\t\t\t\tt.Fatalf(\"grammar: %s %s is not a MustCompile literal; the extractor cannot see through indirection\", path, value.Names[0].Name)\n329|\t\t\t\t}\n330|\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n331|\t\t\t\tif !ok {\n332|\t\t\t\t\tt.Fatalf(\"grammar: %s %s pattern is not a literal; the extractor cannot see through indirection\", path, value.Names[0].Name)\n333|\t\t\t\t}\n334|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n335|\t\t\t\tif err != nil {\n336|\t\t\t\t\tt.Fatalf(\"grammar: %s: %v\", path, err)\n337|\t\t\t\t}\n338|\t\t\t\tif literals[class] == nil {\n339|\t\t\t\t\tliterals[class] = map[string]bool{}\n340|\t\t\t\t}\n341|\t\t\t\tliterals[class][text] = true\n342|\t\t\t\tsites[sharedSite{class, pkg, parts[len(parts)-1], value.Names[0].Name}.sharedSiteKey()] = true\n343|\t\t\t}\n344|\t\t}\n345|\t\treturn nil\n346|\t})\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"grammar: walk: %v\", err)\n349|\t}\n350|\treturn literals, sites\n351|}\n352|\n353|// TestSharedGrammarsAreOneLanguage requires every grammar in the\n354|// census scope to carry the identical regex literal: same symbol\n355|// with different literals would be two languages under one name,\n356|// and a mutant rewriting one copy's literal reddens here.\n357|func TestSharedGrammarsAreOneLanguage(t *testing.T) {\n358|\tliterals, sites := deriveGrammarLiterals(t)\n359|\tfor key := range sites {\n360|\t\tif !grammarSiteLedger[key] {\n361|\t\t\tt.Errorf(\"unregistered grammar copy %q: one language means one definition site per package at most\", key)\n362|\t\t}\n363|\t}\n364|\tfor key := range grammarSiteLedger {\n365|\t\tif !sites[key] {\n366|\t\t\tt.Errorf(\"orphaned grammar row %q: production no longer derives it\", key)\n367|\t\t}\n368|\t}\n369|\tfor class, texts := range literals {\n370|\t\tif len(texts) != 1 {\n371|\t\t\tvar variants []string\n372|\t\t\tfor text := range texts {\n373|\t\t\t\tvariants = append(variants, strconv.Quote(text))\n374|\t\t\t}\n375|\t\t\tt.Errorf(\"grammar class %q has %d distinct literals: %s\", class, len(texts), strings.Join(variants, \" vs \"))\n376|\t\t}\n377|\t}\n378|\tif len(literals) != len(grammarSymbols) {\n379|\t\tt.Fatalf(\"grammar: derived %d classes, want %d; the extractor is blind, not the tree clean\", len(literals), len(grammarSymbols))\n380|\t}\n381|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
