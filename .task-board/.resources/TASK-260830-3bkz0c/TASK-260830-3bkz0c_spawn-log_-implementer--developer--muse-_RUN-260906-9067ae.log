ings reports whether the values are in strictly\\n// increasing bytewise order: sorted with no duplicates. Bytewise order\\n// is the canonical-form order every closed array in Sections 7.3-7.5\\n// is written in.\\nfunc sortedUniqueStrings(values []string) bool {\\n\\treturn sort.StringsAreSorted(values) && !hasDuplicateString(values)\\n}\\n\\nfunc hasDuplicateString(values []string) bool {\\n\\tfor i := 1; i < len(values); i++ {\\n\\t\\tif values[i] == values[i-1] {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n// runeLength reports the Unicode-character length the Section 7 string\\n// bounds count in. JSON transport is UTF-8, so characters are runes,\\n// not bytes and not code units.\\nfunc runeLength(value string) int {\\n\\treturn utf8.RuneCountInString(value)\\n}\\n\\n// isDigest reports whether the value parses as a content digest.\\nfunc isDigest(value string) bool {\\n\\t_, err := scalar.ParseDigest(value)\\n\\treturn err == nil\\n}\\n\\n// isUUIDv7 reports whether the value parses as a UUIDv7.\\nfunc isUUIDv7(value string) bool {\\n\\t_, err := scalar.ParseUUIDv7(value)\\n\\treturn err == nil\\n}\\n\\n// isTimestamp reports whether the value parses as a timestamp.\\nfunc isTimestamp(value string) bool {\\n\\t_, err := scalar.ParseTimestamp(value)\\n\\treturn err == nil\\n}\\n===SPAWNBYTE\\ninternal/provhost/identity.go:286:\\tif len(opaque) > 32 {\\ninternal/provhost/identity.go:293:\\tkeys := make([]string, 0, len(opaque))\\ninternal/provhost/identity.go:306:\\t\\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\\ninternal/provhost/identity.go:414:\\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\\ninternal/provhost/manifest.go:134:\\tif name, ok := rawString(members[\\\"display_name\\\"]); !ok || runeLength(name) < 1 || runeLength(name) > 128 {\\ninternal/provhost/manifest.go:148:\\tif constraint, ok := rawString(members[\\\"provider_version_range\\\"]); !ok || runeLength(constraint) < 1 || runeLength(constraint) > 256 {\\ninternal/provhost/manifest.go:179:\\tif !ok || len(platforms) == 0 {\\ninternal/provhost/manifest.go:214:\\tif !ok || len(operations) != len(operationOrder) {\\ninternal/provhost/manifest.go:237:\\tif !ok || len(names) != len(capabilityOrder) {\\ninternal/provhost/opdecode.go:123:\\tout := make([]string, 0, len(elements))\\ninternal/provhost/opdecode.go:143:\\tfor i := 1; i < len(values); i++ {\\ninternal/provhost/opdecode.go:151:// runeLength reports the Unicode-character length the Section 7 string\\ninternal/provhost/opdecode.go:154:func runeLength(value string) int {\\ninternal/provhost/opdecode.go:155:\\treturn utf8.RuneCountInString(value)\\ninternal/provhost/probe.go:146:\\tif version, ok := rawString(members[\\\"provider_version\\\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\\ninternal/provhost/probe.go:290:\\tif detail, ok := rawString(value[\\\"detail\\\"]); !ok || runeLength(detail) > 2048 {\\ninternal/provhost/probe.go:329:\\tif !ok || len(warnings) > 1024 {\\ninternal/provhost/probe.go:337:\\t\\tif runeLength(warning) > 2048 {\\ninternal/provhost/protocol.go:90:\\tout := make([]string, 0, len(operationOrder))\\ninternal/provhost/protocol.go:230:\\tif len(frame) > MaxFrameBytes {\\ninternal/provhost/protocol.go:245:\\tif len(trimmed) == 0 || trimmed[0] != '{' {\\ninternal/provhost/protocol.go:363:\\tif len(parts) != 3 {\\ninternal/provhost/protocol.go:367:\\tfor i := 0; i < len(parts[0]); i++ {\\ninternal/provhost/protocol.go:374:\\tif len(parts[0]) == 0 {\\ninternal/provhost/protocol.go:378:\\t\\tif len(rest) == 0 {\\ninternal/provhost/protocol.go:381:\\t\\tfor i := 0; i < len(rest); i++ {\\ninternal/provhost/protocol.go:401:\\tif len(frame) > MaxFrameBytes {\\ninternal/provhost/quiesce.go:95:\\tif version, ok := rawString(members[\\\"provider_version\\\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\\ninternal/provhost/quiesce.go:144:\\t\\tif len(blockers) != 0 || !inputBlocked || !foregroundIdle || bac