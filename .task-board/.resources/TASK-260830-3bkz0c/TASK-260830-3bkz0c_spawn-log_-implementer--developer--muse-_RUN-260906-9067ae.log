 task-board q --format compact 'project_config(); models(agent=codex)'\\n  task-board q 'get(TASK-1) { status }; list(type=task) { id status }'\\n  task-board q --format compact 'list(type=task) { overview }'\\n  task-board q --format compact 'plan(EPIC-1, active=true)'\\n  task-board q 'plan(scope=[EPIC-1, STORY-2, TASK-3], mode=children)'\\n\\nUsage:\\n  task-board q <query> [flags]\\n\\nAliases:\\n  q, query\\n\\nFlags:\\n      --format string   Output format: \\\"json\\\" or \\\"compact\\\" (default \\\"json\\\")\\n  -h, --help            help for q\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n\",\n  \"original_output_bytes\": 3860,\n  \"original_output_tokens\": 965,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
