{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5df","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":330,"recorded_at":1780531400000655,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a07665aba87510937db5b30808fd76","text":"Read text file `internal/sessadapter/tuple.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Environment Tuple and the Supported\n11|// Environment Tuple Registry entry admission Section 7.8 rests on:\n12|// the probe and every state-bearing call carry an exact six-member\n13|// tuple, and target writes and healthy doctor results require an\n14|// accepted non-revoked signed entry whose key equals the\n15|// host-observed execution facts.\n16|//\n17|// The registry publication rules — detached signature, monotonic\n18|// sequence, validity of the registry envelope itself — fail closed\n19|// at the registry owner, which does not exist yet; this package\n20|// admits single entries against caller-held registry facts and\n21|// states that bound in doc.go.\n22|\n23|// tupleMembers is the exact Environment Tuple member set Section 7.8\n24|// requires: environment_id, environment_version, platform,\n25|// architecture, store_schema_fingerprint, and adapter_version. The\n26|// tuple never contains executable provenance, and — unlike every\n27|// neighbouring closed type — it carries no extensions member, so\n28|// even a reverse-DNS extensions object is refused here.\n29|var tupleMembers = map[string]bool{\n30|\t\"environment_id\":           true,\n31|\t\"environment_version\":      true,\n32|\t\"platform\":                 true,\n33|\t\"architecture\":             true,\n34|\t\"store_schema_fingerprint\": true,\n35|\t\"adapter_version\":          true,\n36|}\n37|\n38|// tupleRequired lists tupleMembers in a fixed order.\n39|var tupleRequired = []string{\n40|\t\"environment_id\",\n41|\t\"environment_version\",\n42|\t\"platform\",\n43|\t\"architecture\",\n44|\t\"store_schema_fingerprint\",\n45|\t\"adapter_version\",\n46|}\n47|\n48|// Tuple is one validated Environment Tuple.\n49|type Tuple struct {\n50|\tEnvironmentID    string\n51|\tVersion          string\n52|\tPlatform         string\n53|\tArchitecture     string\n54|\tStoreFingerprint string\n55|\tAdapterVersion   string\n56|}\n57|\n58|// DecodeTuple validates one closed Environment Tuple: exact\n59|// members, the environment-id grammar, environment_version as\n60|// string[1..128] (the bound Section 10.8.1 states for the\n61|// observation that reuses this admission model), the closed\n62|// platform and architecture vocabularies, a digest store\n63|// fingerprint, and a SemVer adapter version. Any executable\n64|// provenance member is an unknown member, never a second identity.\n65|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n66|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n67|\tif fault != nil {\n68|\t\tfailure, err := failProtocol(\"environment tuple \"+fault.detail, fault.member)\n69|\t\tif err != nil {\n70|\t\t\treturn Tuple{}, err\n71|\t\t}\n72|\t\treturn Tuple{}, failure\n73|\t}\n74|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n75|\t\tfailure, err := failProtocol(\"environment tuple carries unknown member\", name)\n76|\t\tif err != nil {\n77|\t\t\treturn Tuple{}, err\n78|\t\t}\n79|\t\treturn Tuple{}, failure\n80|\t}\n81|\tif name, missing := missingMember(members, tupleRequired); missing {\n82|\t\tfailure, err := failProtocol(\"environment tuple misses a required member\", name)\n83|\t\tif err != nil {\n84|\t\t\treturn Tuple{}, err\n85|\t\t}\n86|\t\treturn Tuple{}, failure\n87|\t}\n88|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n89|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n90|\t\tfailure, err := failProtocol(\"environment tuple environment identifier is not an environment-id\", \"environment_id\")\n91|\t\tif err != nil {\n92|\t\t\treturn Tuple{}, err\n93|\t\t}\n94|\t\treturn Tuple{}, failure\n95|\t}\n96|\tversion, ok := checkStringBounds(members[\"environment_version\"], 1, 128)\n97|\tif !ok {\n98|\t\tfailure, err := failProtocol(\"environment tuple environment version is not a string[1..128]\", \"environment_version\")\n99|\t\tif err != nil {\n100|\t\t\treturn Tuple{}, err\n101|\t\t}\n102|\t\treturn Tuple{}, failure\n103|\t}\n104|\tplatform, ok := rawString(members[\"platform\"])\n105|\tif !ok {\n106|\t\tfailure, err := failProtocol(\"environment tuple platform is not a string\", \"platform\")\n107|\t\tif err != nil {\n108|\t\t\treturn Tuple{}, err\n109|\t\t}\n110|\t\treturn Tuple{}, failure\n111|\t}\n112|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n113|\t\tfailure, faultErr := failProtocol(\"environment tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n114|\t\tif faultErr != nil {\n115|\t\t\treturn Tuple{}, faultErr\n116|\t\t}\n117|\t\treturn Tuple{}, failure\n118|\t}\n119|\tarchitecture, ok := rawString(members[\"architecture\"])\n120|\tif !ok || !validTupleArchitecture(architecture) {\n121|\t\tfailure, err := failProtocol(\"environment tuple architecture is outside amd64|arm64\", \"architecture\")\n122|\t\tif err != nil {\n123|\t\t\treturn Tuple{}, err\n124|\t\t}\n125|\t\treturn Tuple{}, failure\n126|\t}\n127|\tfingerprint, ok := checkDigest(members[\"store_schema_fingerprint\"])\n128|\tif !ok {\n129|\t\tfailure, err := failProtocol(\"environment tuple store fingerprint is not a digest\", \"store_schema_fingerprint\")\n130|\t\tif err != nil {\n131|\t\t\treturn Tuple{}, err\n132|\t\t}\n133|\t\treturn Tuple{}, failure\n134|\t}\n135|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n136|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n137|\t\tfailure, err := failProtocol(\"environment tuple adapter version is not SemVer\", \"adapter_version\")\n138|\t\tif err != nil {\n139|\t\t\treturn Tuple{}, err\n140|\t\t}\n141|\t\treturn Tuple{}, failure\n142|\t}\n143|\treturn Tuple{\n144|\t\tEnvironmentID:    environmentID,\n145|\t\tVersion:          version,\n146|\t\tPlatform:         platform,\n147|\t\tArchitecture:     architecture,\n148|\t\tStoreFingerprint: fingerprint.String(),\n149|\t\tAdapterVersion:   adapterVersion,\n150|\t}, nil\n151|}\n152|\n153|// Direction names one Supported Environment Tuple Registry key\n154|// direction. The registry admits no third direction.\n155|type Direction string\n156|\n157|// The closed direction vocabulary.\n158|const (\n159|\tDirectionSourceRead  Direction = \"source_read\"\n160|\tDirectionTargetWrite Direction = \"target_write\"\n161|)\n162|\n163|// directionNames is the closed direction vocabulary as a table so\n164|// the census derives it like every other closed vocabulary: the\n165|// three direction gates compare through validDirection, never\n166|// through an inline comparison chain the census cannot see. The\n167|// table is built from the constants above, so the two spellings\n168|// cannot drift.\n169|var directionNames = []string{\n170|\tstring(DirectionSourceRead),\n171|\tstring(DirectionTargetWrite),\n172|}\n173|\n174|// validDirection reports whether the name is one of the two closed\n175|// registry directions.\n176|func validDirection(name string) bool {\n177|\tfor _, allowed := range directionNames {\n178|\t\tif name == allowed {\n179|\t\t\treturn true\n180|\t\t}\n181|\t}\n182|\treturn false\n183|}\n184|\n185|// tupleEntryStatuses is the two-status registry-entry vocabulary\n186|// Section 13.14 states: accepted plus revoked. Membership is a\n187|// table loop so the census derives it like every other closed\n188|// vocabulary.\n189|var tupleEntryStatuses = []string{\n190|\t\"accepted\",\n191|\t\"revoked\",\n192|}\n193|\n194|// validTupleEntryStatus reports whether the status is one of the\n195|// two Section 13.14 registry-entry statuses.\n196|func validTupleEntryStatus(status string) bool {\n197|\tfor _, allowed := range tupleEntryStatuses {\n198|\t\tif status == allowed {\n199|\t\t\treturn true\n200|\t\t}\n201|\t}\n202|\treturn false\n203|}\n204|\n205|// evidenceResults is the one-result evidence vocabulary Sections\n206|// 13.14 states for FixtureEvidence and ResumeSmokeEvidence: only\n207|// pass constructs. It is a table despite its single member so the\n208|// census derives it and the spec pin below covers it like every\n209|// other closed vocabulary.\n210|var evidenceResults = []string{\n211|\t\"pass\",\n212|}\n213|\n214|// validEvidenceResult reports whether the result is the single\n215|// Section 13.14 evidence result.\n216|func validEvidenceResult(result string) bool {\n217|\tfor _, allowed := range evidenceResults {\n218|\t\tif result == allowed {\n219|\t\t\treturn true\n220|\t\t}\n221|\t}\n222|\treturn false\n223|}\n224|\n225|// CandidateKind names one registry key candidate kind.\n226|type CandidateKind string\n227|\n228|// The closed candidate-kind vocabulary.\n229|const (\n230|\tCandidateBuiltin  CandidateKind = \"builtin\"\n231|\tCandidateExternal CandidateKind = \"external\"\n232|)\n233|\n234|// candidateKindNames is the closed candidate-kind vocabulary as a\n235|// table so the census derives it like every other closed\n236|// vocabulary: the registry-key gate compares through\n237|// validCandidateKind, never through an inline comparison chain the\n238|// census cannot see. The table is built from the constants above,\n239|// so the two spellings cannot drift.\n240|var candidateKindNames = []string{\n241|\tstring(CandidateBuiltin),\n242|\tstring(CandidateExternal),\n243|}\n244|\n245|// validCandidateKind reports whether the kind is one of the two\n246|// closed registry-key candidate kinds.\n247|func validCandidateKind(kind CandidateKind) bool {\n248|\tfor _, allowed := range candidateKindNames {\n249|\t\tif string(kind) == allowed {\n250|\t\t\treturn true\n251|\t\t}\n252|\t}\n253|\treturn false\n254|}\n255|\n256|// projectionStrategies is the closed five-strategy vocabulary\n257|// Section 13.14 admits: archive_only plus the four target\n258|// projection strategies. Entries carry a sorted unique non-empty\n259|// subset.\n260|var projectionStrategies = []string{\n261|\t\"archive_only\",\n262|\t\"same_environment_native_rewrite\",\n263|\t\"target_native_writer\",\n264|\t\"target_official_import\",\n265|\t\"continuation_context\",\n266|}\n267|\n268|// validStrategy reports whether the name is a registry strategy.\n269|func validStrategy(name string) bool {\n270|\tfor _, strategy := range projectionStrategies {\n271|\t\tif strategy == name {\n272|\t\t\treturn true\n273|\t\t}\n274|\t}\n275|\treturn false\n276|}\n277|\n278|// fidelityDispositions is the closed seven-disposition vocabulary:\n279|// exact, semantic, summarized, opaque_preserved, synthesized,\n280|// omitted, unrecoverable. archive_only is a strategy, never a\n281|// disposition.\n282|var fidelityDispositions = []string{\n283|\t\"exact\",\n284|\t\"semantic\",\n285|\t\"summarized\",\n286|\t\"opaque_preserved\",\n287|\t\"synthesized\",\n288|\t\"omitted\",\n289|\t\"unrecoverable\",\n290|}\n291|\n292|// validDisposition reports whether the name is a fidelity\n293|// disposition.\n294|func validDisposition(name string) bool {\n295|\tfor _, disposition := range fidelityDispositions {\n296|\t\tif disposition == name {\n297|\t\t\treturn true\n298|\t\t}\n299|\t}\n300|\treturn false\n301|}\n302|\n303|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n304|// states for CaptureItem: the classes a capture plan may name. The\n305|// count bound on excluded_classes ([0..9]) is not the vocabulary;\n306|// this list is.\n307|var captureClasses = []string{\n308|\t\"durable_payload\",\n309|\t\"durable_index_required\",\n310|\t\"durable_sidecar\",\n311|\t\"derived_cache_optional\",\n312|\t\"credential\",\n313|\t\"machine_auth\",\n314|\t\"runtime_state\",\n315|\t\"transient_lock\",\n316|\t\"unknown\",\n317|}\n318|\n319|// validCaptureClass reports whether the name is a capture class.\n320|func validCaptureClass(name string) bool {\n321|\tfor _, class := range captureClasses {\n322|\t\tif class == name {\n323|\t\t\treturn true\n324|\t\t}\n325|\t}\n326|\treturn false\n327|}\n328|\n329|// tupleArchitectures is the two-architecture tuple vocabulary\n330|// Section 7.8 states. Membership is a table loop so the census\n331|// derives it like every other closed vocabulary.\n332|var tupleArchitectures = []string{\n333|\t\"amd64\",\n334|\t\"arm64\",\n335|}\n336|\n337|// validTupleArchitecture reports whether the name is one of the two\n338|// tuple architectures Section 7.8 states.\n339|func validTupleArchitecture(architecture string) bool {\n340|\tfor _, allowed := range tupleArchitectures {\n341|\t\tif architecture == allowed {\n342|\t\t\treturn true\n343|\t\t}\n344|\t}\n345|\treturn false\n346|}\n347|\n348|// tupleKeyMembers is the exact SupportedEnvironmentTupleKey member\n349|// set: direction, environment, provider_id, candidate_kind,\n350|// executable_sha256, provider_manifest_digest, and\n351|// session_adapter_manifest_digest. Status is not part of the unique\n352|// key, so accepted and revoked rows cannot coexist — which is why\n353|// status lives on the entry, not here.\n354|var tupleKeyMembers = map[string]bool{\n355|\t\"direction\":                       true,\n356|\t\"environment\":                     true,\n357|\t\"provider_id\":                     true,\n358|\t\"candidate_kind\":                  true,\n359|\t\"executable_sha256\":               true,\n360|\t\"provider_manifest_digest\":        true,\n361|\t\"session_adapter_manifest_digest\": true,\n362|}\n363|\n364|// tupleKeyRequired lists tupleKeyMembers in a fixed order.\n365|var tupleKeyRequired = []string{\n366|\t\"direction\",\n367|\t\"environment\",\n368|\t\"provider_id\",\n369|\t\"candidate_kind\",\n370|\t\"executable_sha256\",\n371|\t\"provider_manifest_digest\",\n372|\t\"session_adapter_manifest_digest\",\n373|}\n374|\n375|// TupleKey is one validated registry key.\n376|type TupleKey struct {\n377|\tDirection              Direction\n378|\tEnvironment            Tuple\n379|\tProviderID             string\n380|\tCandidateKind          CandidateKind\n381|\tExecutableSHA256       string\n382|\tProviderManifestDigest string\n383|\tAdapterManifestDigest  string\n384|}\n385|\n386|// decodeTupleKey validates one closed registry key.\n387|func decodeTupleKey(raw json.RawMessage) (TupleKey, error) {\n388|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n389|\tif fault != nil {\n390|\t\tfailure, err := failProtocol(\"tuple registry key \"+fault.detail, fault.member)\n391|\t\tif err != nil {\n392|\t\t\treturn TupleKey{}, err\n393|\t\t}\n394|\t\treturn TupleKey{}, failure\n395|\t}\n396|\tif name, unknown := unknownMember(members, tupleKeyMembers); unknown {\n397|\t\tfailure, err := failProtocol(\"tuple registry key carries unknown member\", name)\n398|\t\tif err != nil {\n399|\t\t\treturn TupleKey{}, err\n400|\t\t}\n401|\t\treturn TupleKey{}, failure\n402|\t}\n403|\tif name, missing := missingMember(members, tupleKeyRequired); missing {\n404|\t\tfailure, err := failProtocol(\"tuple registry key misses a required member\", name)\n405|\t\tif err != nil {\n406|\t\t\treturn TupleKey{}, err\n407|\t\t}\n408|\t\treturn TupleKey{}, failure\n409|\t}\n410|\tdirection, ok := rawString(members[\"direction\"])\n411|\tif !ok || !validDirection(direction) {\n412|\t\tfailure, err := failProtocol(\"tuple registry key direction is outside source_read|target_write\", \"direction\")\n413|\t\tif err != nil {\n414|\t\t\treturn TupleKey{}, err\n415|\t\t}\n416|\t\treturn TupleKey{}, failure\n417|\t}\n418|\tenvironment, err := DecodeTuple(members[\"environment\"])\n419|\tif err != nil {\n420|\t\treturn TupleKey{}, err\n421|\t}\n422|\tproviderID, ok := rawString(members[\"provider_id\"])\n423|\tif !ok || !providerIDPattern.MatchString(providerID) {\n424|\t\tfailure, faultErr := failProtocol(\"tuple registry key provider identifier is not a provider-id\", \"provider_id\")\n425|\t\tif faultErr != nil {\n426|\t\t\treturn TupleKey{}, faultErr\n427|\t\t}\n428|\t\treturn TupleKey{}, failure\n429|\t}\n430|\tcandidateKind, ok := rawString(members[\"candidate_kind\"])\n431|\tif !ok || !validCandidateKind(CandidateKind(candidateKind)) {\n432|\t\tfailure, faultErr := failProtocol(\"tuple registry key candidate kind is outside builtin|external\", \"candidate_kind\")\n433|\t\tif faultErr != nil {\n434|\t\t\treturn TupleKey{}, faultErr\n435|\t\t}\n436|\t\treturn TupleKey{}, failure\n437|\t}\n438|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n439|\tif !ok {\n440|\t\tfailure, faultErr := failProtocol(\"tuple registry key executable digest is not a digest\", \"executable_sha256\")\n441|\t\tif faultErr != nil {\n442|\t\t\treturn TupleKey{}, faultErr\n443|\t\t}\n444|\t\treturn TupleKey{}, failure\n445|\t}\n446|\tproviderManifest, ok := checkDigest(members[\"provider_manifest_digest\"])\n447|\tif !ok {\n448|\t\tfailure, faultErr := failProtocol(\"tuple registry key provider manifest digest is not a digest\", \"provider_manifest_digest\")\n449|\t\tif faultErr != nil {\n450|\t\t\treturn TupleKey{}, faultErr\n451|\t\t}\n452|\t\treturn TupleKey{}, failure\n453|\t}\n454|\tadapterManifest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n455|\tif !ok {\n456|\t\tfailure, faultErr := failProtocol(\"tuple registry key adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n457|\t\tif faultErr != nil {\n458|\t\t\treturn TupleKey{}, faultErr\n459|\t\t}\n460|\t\treturn TupleKey{}, failure\n461|\t}\n462|\treturn TupleKey{\n463|\t\tDirection:              Direction(direction),\n464|\t\tEnvironment:            environment,\n465|\t\tProviderID:             providerID,\n466|\t\tCandidateKind:          CandidateKind(candidateKind),\n467|\t\tExecutableSHA256:       executable.String(),\n468|\t\tProviderManifestDigest: providerManifest.String(),\n469|\t\tAdapterManifestDigest:  adapterManifest.String(),\n470|\t}, nil\n471|}\n472|\n473|// tupleEntryMembers is the exact SupportedEnvironmentTupleEntry\n474|// member set.\n475|var tupleEntryMembers = map[string]bool{\n476|\t\"key\":                   true,\n477|\t\"entry_sequence\":        true,\n478|\t\"contracts\":             true,\n479|\t\"strategies\":            true,\n480|\t\"fixture_evidence\":      true,\n481|\t\"resume_smoke_evidence\": true,\n482|\t\"known_fidelity_limits\": true,\n483|\t\"valid_from\":            true,\n484|\t\"valid_until\":           true,\n485|\t\"status\":                true,\n486|\t\"revocation_reason\":     true,\n487|\t\"revoked_at\":            true,\n488|\t\"extensions\":            true,\n489|}\n490|\n491|// tupleEntryRequired lists tupleEntryMembers in a fixed order.\n492|var tupleEntryRequired = []string{\n493|\t\"key\",\n494|\t\"entry_sequence\",\n495|\t\"contracts\",\n496|\t\"strategies\",\n497|\t\"fixture_evidence\",\n498|\t\"resume_smoke_evidence\",\n499|\t\"known_fidelity_limits\",\n500|\t\"valid_from\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e1","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":331,"recorded_at":1780531400000657,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a07665ac5b7bb09b25b3bc39979a3b","text":"Read text file `internal/dirnode/scan.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/base64\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates the Section 7.9 scan operation framing and\n13|// owns the (operation, operation_id) idempotency the scan and\n14|// enrichment-run mutations use: repeating the same canonical body\n15|// returns the prior durable result, and a changed body under a\n16|// recorded key is an idempotency_mismatch without new records.\n17|//\n18|// Scan reads only declared non-auth roots, publishes observations\n19|// and its Inventory Batch atomically, and never claims that an\n20|// active prefix is a cloning-safe boundary. The InventoryBatch\n21|// content crosses as a present object: its content owner is the\n22|// shared-environment leaf of this Story, so CheckScanResponse\n23|// requires the object shape and never inspects further.\n24|\n25|// scanRequestMembers is the exact scan request-body member set.\n26|var scanRequestMembers = map[string]bool{\n27|\t\"operation_id\":     true,\n28|\t\"installation_ids\": true,\n29|\t\"prior_batch_id\":   true,\n30|\t\"cursor\":           true,\n31|\t\"max_instances\":    true,\n32|\t\"extensions\":       true,\n33|}\n34|\n35|// scanRequestRequired lists scanRequestMembers in a fixed order.\n36|var scanRequestRequired = []string{\n37|\t\"operation_id\",\n38|\t\"installation_ids\",\n39|\t\"prior_batch_id\",\n40|\t\"cursor\",\n41|\t\"max_instances\",\n42|\t\"extensions\",\n43|}\n44|\n45|// ScanRequest is one validated scan request body.\n46|type ScanRequest struct {\n47|\tOperationID   string\n48|\tInstallations []string\n49|\tHasPriorBatch bool\n50|\tPriorBatchID  string\n51|\tHasCursor     bool\n52|\tCursor        string\n53|\tMaxInstances  uint64\n54|}\n55|\n56|// CheckScanRequest validates one scan-operation request body: the\n57|// exact closed members, a UUIDv7 operation identifier, sorted\n58|// unique installation digests in the count bound, a digest|null\n59|// prior batch, a string[1..4096]|null cursor, and max_instances in\n60|// uint53[1..65536]. Null is the only accepted absence for the\n61|// nullable members: a missing-typed value is not an absence.\n62|func CheckScanRequest(body []byte) (ScanRequest, error) {\n63|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n64|\tif fault != nil {\n65|\t\tfailure, err := failViolation(\"scan request \"+fault.detail, fault.member)\n66|\t\tif err != nil {\n67|\t\t\treturn ScanRequest{}, err\n68|\t\t}\n69|\t\treturn ScanRequest{}, failure\n70|\t}\n71|\tif name, unknown := unknownMember(members, scanRequestMembers); unknown {\n72|\t\tfailure, err := failViolation(\"scan request carries unknown member\", name)\n73|\t\tif err != nil {\n74|\t\t\treturn ScanRequest{}, err\n75|\t\t}\n76|\t\treturn ScanRequest{}, failure\n77|\t}\n78|\tif name, missing := missingMember(members, scanRequestRequired); missing {\n79|\t\tfailure, err := failViolation(\"scan request misses a required member\", name)\n80|\t\tif err != nil {\n81|\t\t\treturn ScanRequest{}, err\n82|\t\t}\n83|\t\treturn ScanRequest{}, failure\n84|\t}\n85|\toperationID, ok := checkUUIDv7(members[\"operation_id\"])\n86|\tif !ok {\n87|\t\tfailure, err := failViolation(\"scan request operation identifier is not a UUIDv7\", \"operation_id\")\n88|\t\tif err != nil {\n89|\t\t\treturn ScanRequest{}, err\n90|\t\t}\n91|\t\treturn ScanRequest{}, failure\n92|\t}\n93|\tinstallations, ok := checkSortedUniqueDigests(members[\"installation_ids\"], 1, 256)\n94|\tif !ok {\n95|\t\tfailure, err := failViolation(\"scan request installations are not sorted unique digest[1..256]\", \"installation_ids\")\n96|\t\tif err != nil {\n97|\t\t\treturn ScanRequest{}, err\n98|\t\t}\n99|\t\treturn ScanRequest{}, failure\n100|\t}\n101|\tprior, present, wasNull := checkOptionalDigest(members[\"prior_batch_id\"])\n102|\tif !present {\n103|\t\tfailure, err := failViolation(\"scan request prior batch is not a digest|null\", \"prior_batch_id\")\n104|\t\tif err != nil {\n105|\t\t\treturn ScanRequest{}, err\n106|\t\t}\n107|\t\treturn ScanRequest{}, failure\n108|\t}\n109|\tcursor, cursorPresent, cursorNull := checkOptionalString(members[\"cursor\"], 1, 4096)\n110|\tif !cursorPresent {\n111|\t\tfailure, err := failViolation(\"scan request cursor is not a string[1..4096]|null\", \"cursor\")\n112|\t\tif err != nil {\n113|\t\t\treturn ScanRequest{}, err\n114|\t\t}\n115|\t\treturn ScanRequest{}, failure\n116|\t}\n117|\tmaximum, ok := checkUint53Bounds(members[\"max_instances\"], 1, 65536)\n118|\tif !ok {\n119|\t\tfailure, err := failViolation(\"scan request max_instances is not uint53[1..65536]\", \"max_instances\")\n120|\t\tif err != nil {\n121|\t\t\treturn ScanRequest{}, err\n122|\t\t}\n123|\t\treturn ScanRequest{}, failure\n124|\t}\n125|\tif !checkExtensions(members[\"extensions\"]) {\n126|\t\tfailure, err := failViolation(\"scan request extensions are not reverse-DNS keyed\", \"extensions\")\n127|\t\tif err != nil {\n128|\t\t\treturn ScanRequest{}, err\n129|\t\t}\n130|\t\treturn ScanRequest{}, failure\n131|\t}\n132|\treturn ScanRequest{\n133|\t\tOperationID:   operationID.String(),\n134|\t\tInstallations: digestStrings(installations),\n135|\t\tHasPriorBatch: !wasNull,\n136|\t\tPriorBatchID:  prior.String(),\n137|\t\tHasCursor:     !cursorNull,\n138|\t\tCursor:        cursor,\n139|\t\tMaxInstances:  maximum,\n140|\t}, nil\n141|}\n142|\n143|// scanResponseMembers is the exact scan success-body member set.\n144|var scanResponseMembers = map[string]bool{\n145|\t\"batch\":                       true,\n146|\t\"environment_observation_ids\": true,\n147|\t\"native_observation_ids\":      true,\n148|\t\"next_cursor\":                 true,\n149|\t\"extensions\":                  true,\n150|}\n151|\n152|// scanResponseRequired lists scanResponseMembers in a fixed order.\n153|var scanResponseRequired = []string{\n154|\t\"batch\",\n155|\t\"environment_observation_ids\",\n156|\t\"native_observation_ids\",\n157|\t\"next_cursor\",\n158|\t\"extensions\",\n159|}\n160|\n161|// ScanResponse is one validated scan success body. The batch\n162|// crosses as presence: the InventoryBatch content owner is the\n163|// shared-environment leaf, so only the object shape is checked.\n164|type ScanResponse struct {\n165|\tHasBatch       bool\n166|\tEnvironmentIDs []string\n167|\tNativeIDs      []string\n168|\tHasNextCursor  bool\n169|\tNextCursor     string\n170|}\n171|\n172|// CheckScanResponse validates one scan-operation success body: the\n173|// exact closed members, a present batch object, sorted unique\n174|// environment observation digests in [1..256], sorted unique\n175|// native observation digests in [0..65536], and a\n176|// string[1..4096]|null next cursor.\n177|func CheckScanResponse(body []byte) (ScanResponse, error) {\n178|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n179|\tif fault != nil {\n180|\t\tfailure, err := failViolation(\"scan response \"+fault.detail, fault.member)\n181|\t\tif err != nil {\n182|\t\t\treturn ScanResponse{}, err\n183|\t\t}\n184|\t\treturn ScanResponse{}, failure\n185|\t}\n186|\tif name, unknown := unknownMember(members, scanResponseMembers); unknown {\n187|\t\tfailure, err := failViolation(\"scan response carries unknown member\", name)\n188|\t\tif err != nil {\n189|\t\t\treturn ScanResponse{}, err\n190|\t\t}\n191|\t\treturn ScanResponse{}, failure\n192|\t}\n193|\tif name, missing := missingMember(members, scanResponseRequired); missing {\n194|\t\tfailure, err := failViolation(\"scan response misses a required member\", name)\n195|\t\tif err != nil {\n196|\t\t\treturn ScanResponse{}, err\n197|\t\t}\n198|\t\treturn ScanResponse{}, failure\n199|\t}\n200|\tif _, fault := decodeStrictObject(bytesTrimSpace(members[\"batch\"])); fault != nil {\n201|\t\tfailure, err := failViolation(\"scan response batch is not an object\", \"batch\")\n202|\t\tif err != nil {\n203|\t\t\treturn ScanResponse{}, err\n204|\t\t}\n205|\t\treturn ScanResponse{}, failure\n206|\t}\n207|\tenvironments, ok := checkSortedUniqueDigests(members[\"environment_observation_ids\"], 1, 256)\n208|\tif !ok {\n209|\t\tfailure, err := failViolation(\"scan response environment observations are not sorted unique digest[1..256]\", \"environment_observation_ids\")\n210|\t\tif err != nil {\n211|\t\t\treturn ScanResponse{}, err\n212|\t\t}\n213|\t\treturn ScanResponse{}, failure\n214|\t}\n215|\tnatives, ok := checkSortedUniqueDigests(members[\"native_observation_ids\"], 0, 65536)\n216|\tif !ok {\n217|\t\tfailure, err := failViolation(\"scan response native observations are not sorted unique digest[0..65536]\", \"native_observation_ids\")\n218|\t\tif err != nil {\n219|\t\t\treturn ScanResponse{}, err\n220|\t\t}\n221|\t\treturn ScanResponse{}, failure\n222|\t}\n223|\tcursor, present, wasNull := checkOptionalString(members[\"next_cursor\"], 1, 4096)\n224|\tif !present {\n225|\t\tfailure, err := failViolation(\"scan response next cursor is not a string[1..4096]|null\", \"next_cursor\")\n226|\t\tif err != nil {\n227|\t\t\treturn ScanResponse{}, err\n228|\t\t}\n229|\t\treturn ScanResponse{}, failure\n230|\t}\n231|\tif !checkExtensions(members[\"extensions\"]) {\n232|\t\tfailure, err := failViolation(\"scan response extensions are not reverse-DNS keyed\", \"extensions\")\n233|\t\tif err != nil {\n234|\t\t\treturn ScanResponse{}, err\n235|\t\t}\n236|\t\treturn ScanResponse{}, failure\n237|\t}\n238|\treturn ScanResponse{\n239|\t\tHasBatch:       true,\n240|\t\tEnvironmentIDs: digestStrings(environments),\n241|\t\tNativeIDs:      digestStrings(natives),\n242|\t\tHasNextCursor:  !wasNull,\n243|\t\tNextCursor:     cursor,\n244|\t}, nil\n245|}\n246|\n247|// journalRecord is one durable (operation, operation_id) entry: the\n248|// digest of the canonical request body that produced it and the\n249|// canonical result bytes. The result is stored, never recomputed:\n250|// a retry after a lost response replays the recorded bytes.\n251|type journalRecord struct {\n252|\tBodyDigest string `json:\"body_digest\"`\n253|\tResult     []byte `json:\"result\"`\n254|}\n255|\n256|// Journal is the host-side (operation, operation_id) idempotency\n257|// record for the mutating directory operations (scan and\n258|// enrichment-run). Records are keyed by operation and operation\n259|// identifier and bind the canonical body digest: a repeat of the\n260|// identical body replays the prior result with no new records, and\n261|// a changed body under a recorded key is refused. The journal\n262|// exports and imports its bytes so a restarted host recovers the\n263|// same record without trusting a peer claim.\n264|type Journal struct {\n265|\trecords map[string]journalRecord\n266|}\n267|\n268|// NewJournal returns an empty idempotency journal.\n269|func NewJournal() *Journal {\n270|\treturn &Journal{records: map[string]journalRecord{}}\n271|}\n272|\n273|// journalKey binds the idempotency scope: one operation's\n274|// operation_id never authorizes another operation's retry.\n275|func journalKey(operation Operation, operationID string) string {\n276|\treturn string(operation) + \"\\x00\" + operationID\n277|}\n278|\n279|// CheckAndRecord applies the idempotency rule for one mutating\n280|// call. canonicalBody must be the JCS canonical request body the\n281|// host sent; result is the canonical result bytes to durably\n282|// record. The first call for a key records and reports stored;\n283|// a repeat with the identical body digest replays the recorded\n284|// result; a changed body under a recorded key is an\n285|// idempotency_mismatch and records nothing. An operation outside\n286|// the closed registry or an identifier outside UUIDv7 is a caller\n287|// error, never a key.\n288|func (journal *Journal) CheckAndRecord(operation Operation, operationID string, canonicalBody []byte, result []byte) (stored bool, prior []byte, err error) {\n289|\tif !validOperation(string(operation)) {\n290|\t\tfailure, faultErr := failUnknownOperation(\"idempotency key names an operation outside the closed registry\", string(operation))\n291|\t\tif faultErr != nil {\n292|\t\t\treturn false, nil, faultErr\n293|\t\t}\n294|\t\treturn false, nil, failure\n295|\t}\n296|\tidentifier, parseErr := scalar.ParseUUIDv7(operationID)\n297|\tif parseErr != nil {\n298|\t\tfailure, faultErr := failInvalid(\"idempotency operation identifier is not a UUIDv7\", \"operation_id\")\n299|\t\tif faultErr != nil {\n300|\t\t\treturn false, nil, faultErr\n301|\t\t}\n302|\t\treturn false, nil, failure\n303|\t}\n304|\tcanonical, canonErr := canonicaljson.Canonicalize(bytesTrimSpace(canonicalBody))\n305|\tif canonErr != nil {\n306|\t\tfailure, faultErr := failViolation(\"idempotency body is not canonical JSON\", \"body\")\n307|\t\tif faultErr != nil {\n308|\t\t\treturn false, nil, faultErr\n309|\t\t}\n310|\t\treturn false, nil, failure\n311|\t}\n312|\tdigest := scalar.SHA256Digest(canonical).String()\n313|\tkey := journalKey(operation, identifier.String())\n314|\tif record, recorded := journal.records[key]; recorded {\n315|\t\tif record.BodyDigest != digest {\n316|\t\t\tfailure, faultErr := failIdempotency(\"idempotent body changed under a recorded operation identifier\", string(operation))\n317|\t\t\tif faultErr != nil {\n318|\t\t\t\treturn false, nil, faultErr\n319|\t\t\t}\n320|\t\t\treturn false, nil, failure\n321|\t\t}\n322|\t\treturn false, append([]byte(nil), record.Result...), nil\n323|\t}\n324|\tstoredResult := append([]byte(nil), result...)\n325|\tjournal.records[key] = journalRecord{BodyDigest: digest, Result: storedResult}\n326|\treturn true, nil, nil\n327|}\n328|\n329|// journalDocument is the exported journal shape: versioned, with\n330|// records sorted by key so the bytes are deterministic.\n331|type journalDocument struct {\n332|\tSchema  string                  `json:\"schema\"`\n333|\tVersion int                     `json:\"version\"`\n334|\tRecords []journalDocumentRecord `json:\"records\"`\n335|}\n336|\n337|// journalDocumentRecord is one exported entry.\n338|type journalDocumentRecord struct {\n339|\tKey        string `json:\"key\"`\n340|\tBodyDigest string `json:\"body_digest\"`\n341|\tResult     []byte `json:\"result\"`\n342|}\n343|\n344|// journalExportSchema pins the export envelope identity.\n345|const journalExportSchema = \"urn:ax:internal:dirnode-journal\"\n346|\n347|// Export serializes the journal for durable placement. Records\n348|// emit sorted by key so identical journals export identical bytes.\n349|func (journal *Journal) Export() ([]byte, error) {\n350|\tkeys := make([]string, 0, len(journal.records))\n351|\tfor key := range journal.records {\n352|\t\tkeys = append(keys, key)\n353|\t}\n354|\tsort.Strings(keys)\n355|\tdocument := journalDocument{Schema: journalExportSchema, Version: 1}\n356|\tfor _, key := range keys {\n357|\t\trecord := journal.records[key]\n358|\t\tdocument.Records = append(document.Records, journalDocumentRecord{\n359|\t\t\tKey:        key,\n360|\t\t\tBodyDigest: record.BodyDigest,\n361|\t\t\tResult:     append([]byte(nil), record.Result...),\n362|\t\t})\n363|\t}\n364|\tencoded, err := canonicaljson.Canonicalize(mustMarshalJSON(document))\n365|\tif err != nil {\n366|\t\tfailure, faultErr := failIntegrity(\"idempotency journal is not exportable\", \"journal\")\n367|\t\tif faultErr != nil {\n368|\t\t\treturn nil, faultErr\n369|\t\t}\n370|\t\treturn nil, failure\n371|\t}\n372|\treturn encoded, nil\n373|}\n374|\n375|// mustMarshalJSON encodes the export document. The document is\n376|// built from validated in-memory records only, so encoding cannot\n377|// fail; a failure is a host defect, not a refusal.\n378|func mustMarshalJSON(document journalDocument) []byte {\n379|\tencoded, err := json.Marshal(document)\n380|\tif err != nil {\n381|\t\tpanic(\"dirnode: journal document is not encodable: \" + err.Error())\n382|\t}\n383|\treturn encoded\n384|}\n385|\n386|// Import replaces the journal contents from exported bytes: a\n387|// restarted host recovers the same record without trusting a peer\n388|// claim. The bytes must be one complete object with the exact\n389|// export schema and version, sorted unique keys, digest-shaped\n390|// body bindings, and result values that are strings. A failed or\n391|// partial read is an integrity failure, never an empty journal\n392|// that would authorize fresh records under recorded keys.\n393|func (journal *Journal) Import(data []byte) error {\n394|\tmembers, fault := decodeStrictObject(bytesTrimSpace(data))\n395|\tif fault != nil {\n396|\t\tfailure, err := failIntegrity(\"idempotency journal \"+fault.detail, \"journal\")\n397|\t\tif err != nil {\n398|\t\t\treturn err\n399|\t\t}\n400|\t\treturn failure\n401|\t}\n402|\tschema, ok := rawString(members[\"schema\"])\n403|\tif !ok || schema != journalExportSchema {\n404|\t\tfailure, err := failIntegrity(\"idempotency journal schema is not the journal export\", \"schema\")\n405|\t\tif err != nil {\n406|\t\t\treturn err\n407|\t\t}\n408|\t\treturn failure\n409|\t}\n410|\tversion, ok := rawUint53(members[\"version\"])\n411|\tif !ok || version != 1 {\n412|\t\tfailure, err := failIntegrity(\"idempotency journal version is not 1\", \"version\")\n413|\t\tif err != nil {\n414|\t\t\treturn err\n415|\t\t}\n416|\t\treturn failure\n417|\t}\n418|\telements, ok := decodeArray(members[\"records\"])\n419|\tif !ok {\n420|\t\tfailure, err := failIntegrity(\"idempotency journal records are not an array\", \"records\")\n421|\t\tif err != nil {\n422|\t\t\treturn err\n423|\t\t}\n424|\t\treturn failure\n425|\t}\n426|\trecords := make(map[string]journalRecord, len(elements))\n427|\tvar previous string\n428|\tfirst := true\n429|\tfor _, element := range elements {\n430|\t\trecord, ok := decodeJournalRecord(element)\n431|\t\tif !ok {\n432|\t\t\tfailure, err := failIntegrity(\"idempotency journal record is not a keyed digest binding\", \"records\")\n433|\t\t\tif err != nil {\n434|\t\t\t\treturn err\n435|\t\t\t}\n436|\t\t\treturn failure\n437|\t\t}\n438|\t\tif !first && previous >= record.Key {\n439|\t\t\tfailure, err := failIntegrity(\"idempotency journal records are not sorted unique\", \"records\")\n440|\t\t\tif err != nil {\n441|\t\t\t\treturn err\n442|\t\t\t}\n443|\t\t\treturn failure\n444|\t\t}\n445|\t\tfirst = false\n446|\t\tprevious = record.Key\n447|\t\trecords[record.Key] = journalRecord{BodyDigest: record.BodyDigest, Result: record.Result}\n448|\t}\n449|\tjournal.records = records\n450|\treturn nil\n451|}\n452|\n453|// decodedJournalRecord is one validated export entry.\n454|type decodedJournalRecord struct {\n455|\tKey        string\n456|\tBodyDigest string\n457|\tResult     []byte\n458|}\n459|\n460|// decodeJournalRecord validates one export entry: a closed keyed\n461|// digest binding with a string result.\n462|func decodeJournalRecord(raw json.RawMessage) (decodedJournalRecord, bool) {\n463|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n464|\tif fault != nil {\n465|\t\treturn decodedJournalRecord{}, false\n466|\t}\n467|\tallowed := map[string]bool{\"key\": true, \"body_digest\": true, \"result\": true}\n468|\tif name, unknown := unknownMember(members, allowed); unknown {\n469|\t\t_ = name\n470|\t\treturn decodedJournalRecord{}, false\n471|\t}\n472|\trequired := []string{\"key\", \"body_digest\", \"result\"}\n473|\tif name, missing := missingMember(members, required); missing {\n474|\t\t_ = name\n475|\t\treturn decodedJournalRecord{}, false\n476|\t}\n477|\tkey, ok := checkStringBounds(members[\"key\"], 1, 512)\n478|\tif !ok {\n479|\t\treturn decodedJournalRecord{}, false\n480|\t}\n481|\tdigest, ok := rawString(members[\"body_digest\"])\n482|\tif !ok {\n483|\t\treturn decodedJournalRecord{}, false\n484|\t}\n485|\tif _, ok := checkDigestString(digest); !ok {\n486|\t\treturn decodedJournalRecord{}, false\n487|\t}\n488|\tencoded, ok := rawString(members[\"result\"])\n489|\tif !ok {\n490|\t\treturn decodedJournalRecord{}, false\n491|\t}\n492|\tresult, err := base64.StdEncoding.DecodeString(encoded)\n493|\tif err != nil {\n494|\t\treturn decodedJournalRecord{}, false\n495|\t}\n496|\treturn decodedJournalRecord{Key: key, BodyDigest: digest, Result: result}, true\n497|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
