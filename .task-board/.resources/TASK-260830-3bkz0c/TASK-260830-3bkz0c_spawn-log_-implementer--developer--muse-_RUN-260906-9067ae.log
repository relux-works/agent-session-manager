{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c533","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":244,"recorded_at":1780531400000483,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"task_stream":{"kind":"task","id":"b524292a-e1e9-4ffe-b30f-cab653ad5587"},"task_id":"b524292a-e1e9-4ffe-b30f-cab653ad5587","event":{"kind":"output","task_id":"b524292a-e1e9-4ffe-b30f-cab653ad5587","chunk":"Read text file `internal/dirnode/decode.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.9 and\n15|// 10.8.5 closed body. Every helper reports a verdict and never\n16|// refuses: all refusals call one of the refusal constructors\n17|// directly at the deciding site with literal details, so the\n18|// refusal-arm inventory keeps seeing every arm. A helper that\n19|// fronted a constructor would collapse distinct rules into one\n20|// obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer:\n23|// Section 7.9 counts and limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// frameFault is one strict-decode failure: what was wrong and which\n27|// member it was found in, if any. It never carries foreign bytes.\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|// decodeStrictObject parses one complete JSON object with duplicate\n34|// member rejection. It is the only JSON entry point in this package:\n35|// every body crosses it before any member is read. A non-UTF-8\n36|// frame, a lone surrogate escape, a non-object top level, a\n37|// duplicated member, or trailing data is a fault, never a partial\n38|// object the caller could mistake for a result.\n39|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n40|\tif !utf8.Valid(data) {\n41|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n42|\t}\n43|\tif hasLoneSurrogateEscape(data) {\n44|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n45|\t}\n46|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n47|\ttoken, err := decoder.Token()\n48|\tif err != nil {\n49|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n50|\t}\n51|\tdelim, ok := token.(json.Delim)\n52|\tif !ok || delim != '{' {\n53|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n54|\t}\n55|\tmembers := map[string]json.RawMessage{}\n56|\tfor decoder.More() {\n57|\t\tkeyToken, err := decoder.Token()\n58|\t\tif err != nil {\n59|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n60|\t\t}\n61|\t\tkey, ok := keyToken.(string)\n62|\t\tif !ok {\n63|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n64|\t\t}\n65|\t\tif _, duplicate := members[key]; duplicate {\n66|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n67|\t\t}\n68|\t\tvar raw json.RawMessage\n69|\t\tif err := decoder.Decode(&raw); err != nil {\n70|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n71|\t\t}\n72|\t\tmembers[key] = raw\n73|\t}\n74|\tif token, err := decoder.Token(); err != nil {\n75|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n76|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n77|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n78|\t}\n79|\tif _, err := decoder.Token(); err != io.EOF {\n80|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n81|\t}\n82|\treturn members, nil\n83|}\n84|\n85|// hasLoneSurrogateEscape reports whether the raw frame carries a\n86|// UTF-16 escape the JSON string grammar cannot pair. Go's\n87|// encoding/json would otherwise replace the lone escape with\n88|// U+FFFD silently, so wire bodies carrying lone surrogates would be\n89|// admitted with rewritten bytes.\n90|func hasLoneSurrogateEscape(data []byte) bool {\n91|\tfor index := 0; index < len(data); index++ {\n92|\t\tif data[index] != '\\\\' {\n93|\t\t\tcontinue\n94|\t\t}\n95|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n96|\t\t\tcontinue\n97|\t\t}\n98|\t\tfirst, length := readUTF16Escape(data, index+2)\n99|\t\tif length < 0 {\n100|\t\t\treturn true\n101|\t\t}\n102|\t\tindex += 1 + length\n103|\t\tif first >= 0xD800 && first <= 0xDBFF {\n104|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n105|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n106|\t\t\t\treturn true\n107|\t\t\t}\n108|\t\t\tindex += 6\n109|\t\t\tcontinue\n110|\t\t}\n111|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n112|\t\t\treturn true\n113|\t\t}\n114|\t}\n115|\treturn false\n116|}\n117|\n118|// readUTF16Escape reads four hex digits at the offset. It returns the\n119|// value and the consumed length, or a negative length when the escape\n120|// is truncated or not hexadecimal.\n121|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n122|\tif offset+4 > len(data) {\n123|\t\treturn 0, -1\n124|\t}\n125|\tvar value uint16\n126|\tfor _, digit := range data[offset : offset+4] {\n127|\t\tvalue <<= 4\n128|\t\tswitch {\n129|\t\tcase digit >= '0' && digit <= '9':\n130|\t\t\tvalue |= uint16(digit - '0')\n131|\t\tcase digit >= 'a' && digit <= 'f':\n132|\t\t\tvalue |= uint16(digit-'a') + 10\n133|\t\tcase digit >= 'A' && digit <= 'F':\n134|\t\t\tvalue |= uint16(digit-'A') + 10\n135|\t\tdefault:\n136|\t\t\treturn 0, -1\n137|\t\t}\n138|\t}\n139|\treturn value, 4\n140|}\n141|\n142|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n143|// at the offset. Anything else is a negative length.\n144|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n145|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n146|\t\treturn 0, -1\n147|\t}\n148|\treturn readUTF16Escape(data, offset+2)\n149|}\n150|\n151|// unknownMember names a member outside the closed set, if any. The\n152|// single-unknown fixtures keep the verdict deterministic: with\n153|// several unknowns the map order decides which is named, so tests\n154|// never assert a name from a multi-unknown body.\n155|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n156|\tfor name := range members {\n157|\t\tif !allowed[name] {\n158|\t\t\treturn name, true\n159|\t\t}\n160|\t}\n161|\treturn \"\", false\n162|}\n163|\n164|// missingMember names the first required member with no value, if\n165|// any. The required list is fixed order, so the verdict is\n166|// deterministic for every missing combination.\n167|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n168|\tfor _, name := range required {\n169|\t\tif _, present := members[name]; !present {\n170|\t\t\treturn name, true\n171|\t\t}\n172|\t}\n173|\treturn \"\", false\n174|}\n175|\n176|// rawString reads a JSON string member.\n177|func rawString(raw json.RawMessage) (string, bool) {\n178|\tvar value string\n179|\tif err := json.Unmarshal(raw, &value); err != nil {\n180|\t\treturn \"\", false\n181|\t}\n182|\treturn value, true\n183|}\n184|\n185|// rawBool reads a JSON boolean member.\n186|func rawBool(raw json.RawMessage) (bool, bool) {\n187|\tvar value bool\n188|\tif err := json.Unmarshal(raw, &value); err != nil {\n189|\t\treturn false, false\n190|\t}\n191|\treturn value, true\n192|}\n193|\n194|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n195|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n196|// even when it names the same mathematical value.\n197|func rawUint53(raw json.RawMessage) (uint64, bool) {\n198|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n199|\tdecoder.UseNumber()\n200|\tvar value any\n201|\tif err := decoder.Decode(&value); err != nil {\n202|\t\treturn 0, false\n203|\t}\n204|\tnumber, ok := value.(json.Number)\n205|\tif !ok {\n206|\t\treturn 0, false\n207|\t}\n208|\tliteral := number.String()\n209|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n210|\t\treturn 0, false\n211|\t}\n212|\treturn parseUint53Literal(literal)\n213|}\n214|\n215|// parseUint53Literal reads a digit-only literal without trusting a\n216|// float conversion: the magnitude bound is checked on the digit\n217|// string, so 2^53 is refused even on platforms that could hold it.\n218|func parseUint53Literal(literal string) (uint64, bool) {\n219|\tvar value uint64\n220|\tfor index := 0; index < len(literal); index++ {\n221|\t\tdigit := literal[index]\n222|\t\tif digit < '0' || digit > '9' {\n223|\t\t\treturn 0, false\n224|\t\t}\n225|\t\tvalue = value*10 + uint64(digit-'0')\n226|\t\tif value > maxUint53 {\n227|\t\t\treturn 0, false\n228|\t\t}\n229|\t}\n230|\treturn value, true\n231|}\n232|\n233|// stringLength is the Section 1.6 string measure in characters, not\n234|// bytes.\n235|func stringLength(value string) int {\n236|\treturn utf8.RuneCountInString(value)\n237|}\n238|\n239|// checkStringBounds reports whether the member is a JSON string whose\n240|// character count falls in the inclusive bound.\n241|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n242|\tvalue, ok := rawString(raw)\n243|\tif !ok {\n244|\t\treturn \"\", false\n245|\t}\n246|\tlength := stringLength(value)\n247|\tif length < minimum || length > maximum {\n248|\t\treturn \"\", false\n249|\t}\n250|\treturn value, true\n251|}\n252|\n253|// checkUint53Bounds reports whether the member is a uint53 in the\n254|// inclusive bound. Both edges are checked: a one-sided check would\n255|// admit the open side.\n256|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n257|\tvalue, ok := rawUint53(raw)\n258|\tif !ok {\n259|\t\treturn 0, false\n260|\t}\n261|\tif value < minimum || value > maximum {\n262|\t\treturn 0, false\n263|\t}\n264|\treturn value, true\n265|}\n266|\n267|// checkDigest reports whether the member is a digest of the pinned\n268|// sha256 form.\n269|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n270|\tvalue, ok := rawString(raw)\n271|\tif !ok {\n272|\t\treturn scalar.Digest{}, false\n273|\t}\n274|\tdigest, err := scalar.ParseDigest(value)\n275|\tif err != nil {\n276|\t\treturn scalar.Digest{}, false\n277|\t}\n278|\treturn digest, true\n279|}\n280|\n281|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n282|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n283|\tvalue, ok := rawString(raw)\n284|\tif !ok {\n285|\t\treturn scalar.UUIDv7{}, false\n286|\t}\n287|\tidentifier, err := scalar.ParseUUIDv7(value)\n288|\tif err != nil {\n289|\t\treturn scalar.UUIDv7{}, false\n290|\t}\n291|\treturn identifier, true\n292|}\n293|\n294|// checkTimestamp reports whether the member is a pinned timestamp.\n295|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n296|\tvalue, ok := rawString(raw)\n297|\tif !ok {\n298|\t\treturn scalar.Timestamp{}, false\n299|\t}\n300|\tinstant, err := scalar.ParseTimestamp(value)\n301|\tif err != nil {\n302|\t\treturn scalar.Timestamp{}, false\n303|\t}\n304|\treturn instant, true\n305|}\n306|\n307|// checkDigestString reports whether the value parses as a digest of\n308|// the pinned form.\n309|func checkDigestString(value string) (string, bool) {\n310|\tdigest, err := scalar.ParseDigest(value)\n311|\tif err != nil {\n312|\t\treturn \"\", false\n313|\t}\n314|\treturn digest.String(), true\n315|}\n316|\n317|// isNull reports whether the member is an explicit JSON null.\n318|func isNull(raw json.RawMessage) bool {\n319|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n320|}\n321|\n322|// decodeArray reads a JSON array member into its raw elements. A\n323|// non-array — including null — is not an empty array.\n324|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n325|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n326|\ttoken, err := decoder.Token()\n327|\tif err != nil {\n328|\t\treturn nil, false\n329|\t}\n330|\tdelim, ok := token.(json.Delim)\n331|\tif !ok || delim != '[' {\n332|\t\treturn nil, false\n333|\t}\n334|\tvar elements []json.RawMessage\n335|\tfor decoder.More() {\n336|\t\tvar element json.RawMessage\n337|\t\tif err := decoder.Decode(&element); err != nil {\n338|\t\t\treturn nil, false\n339|\t\t}\n340|\t\telements = append(elements, element)\n341|\t}\n342|\tif token, err := decoder.Token(); err != nil {\n343|\t\treturn nil, false\n344|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n345|\t\treturn nil, false\n346|\t}\n347|\tif _, err := decoder.Token(); err != io.EOF {\n348|\t\treturn nil, false\n349|\t}\n350|\treturn elements, true\n351|}\n352|\n353|// checkSortedUniqueStrings reports whether the member is an array of\n354|// strings in the item bound whose encodings order strictly\n355|// increasingly with no duplicates, in the count bound.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// checkSortedUniqueUUIDv7 reports whether the member is a sorted\n411|// unique UUIDv7 array in the count bound.\n412|func checkSortedUniqueUUIDv7(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.UUIDv7, bool) {\n413|\telements, ok := decodeArray(raw)\n414|\tif !ok {\n415|\t\treturn nil, false\n416|\t}\n417|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n418|\t\treturn nil, false\n419|\t}\n420|\tvalues := make([]scalar.UUIDv7, 0, len(elements))\n421|\tfor _, element := range elements {\n422|\t\tidentifier, ok := checkUUIDv7(element)\n423|\t\tif !ok {\n424|\t\t\treturn nil, false\n425|\t\t}\n426|\t\tvalues = append(values, identifier)\n427|\t}\n428|\tfor index := 1; index < len(values); index++ {\n429|\t\tif values[index-1].String() >= values[index].String() {\n430|\t\t\treturn nil, false\n431|\t\t}\n432|\t}\n433|\treturn values, true\n434|}\n435|\n436|// checkOptionalDigest reads a digest|null member: null is the only\n437|// accepted absence, and any other non-digest is not an absence.\n438|func checkOptionalDigest(raw json.RawMessage) (scalar.Digest, bool, bool) {\n439|\tif isNull(raw) {\n440|\t\treturn scalar.Digest{}, true, true\n441|\t}\n442|\tdigest, ok := checkDigest(raw)\n443|\tif !ok {\n444|\t\treturn scalar.Digest{}, false, false\n445|\t}\n446|\treturn digest, true, false\n447|}\n448|\n449|// checkOptionalString reads a bounded string|null member with the\n450|// same absence rule.\n451|func checkOptionalString(raw json.RawMessage, minimum, maximum int) (string, bool, bool) {\n452|\tif isNull(raw) {\n453|\t\treturn \"\", true, true\n454|\t}\n455|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n456|\tif !ok {\n457|\t\treturn \"\", false, false\n458|\t}\n459|\treturn value, true, false\n460|}\n461|\n462|// semverPattern is the SemVer grammar versions satisfy: three\n463|// dot-separated non-negative integers with no leading zeros, an\n464|// optional pre-release, and optional build metadata.\n465|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n466|\n467|// environmentIDPattern is the environment-id grammar:\n468|// [a-z][a-z0-9.-]{0,63}.\n469|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n470|\n471|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n472|// dot-separated lowercase labels.\n473|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n474|\n475|// checkSemver reports whether the value is a SemVer string.\n476|func checkSemver(value string) bool {\n477|\treturn semverPattern.MatchString(value)\n478|}\n479|\n480|// checkExtensions reports whether the member is an object whose keys\n481|// are all reverse-DNS names. Values cross opaquely: extensions\n482|// cannot add operations, capabilities, or trust facts, and no member\n483|// of this package reads an extension value for any admission\n484|// decision.\n485|func checkExtensions(raw json.RawMessage) bool {\n486|\tmembers, fault := decodeStrictObject(raw)\n487|\tif fault != nil {\n488|\t\treturn false\n489|\t}\n490|\tfor name := range members {\n491|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n492|\t\t\treturn false\n493|\t\t}\n494|\t}\n495|\treturn true\n496|}\n497|\n498|// checkURI reports whether the value is a URI reference of 1..512\n499|// characters: no whitespace or control characters, with a scheme\n500|// prefix. Contract identifiers in this contract family are URNs, so\n(more lines below)"}}}
