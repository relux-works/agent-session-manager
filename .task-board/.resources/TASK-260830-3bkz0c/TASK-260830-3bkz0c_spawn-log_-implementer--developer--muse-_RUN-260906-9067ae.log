{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c583","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":284,"recorded_at":1780531400000563,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a0766584b27581b50bf4fb57739bed","text":"Read text file `internal/environ/frame_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n17|)\n18|\n19|// This file is the cross-facade frame-agreement battery. Every\n20|// Section 7.8, 7.9, and provider-protocol body crosses a strict\n21|// object decoder before any member is trusted, and each facade\n22|// carries its own copy of that decoder (ledgered in\n23|// census_test.go). The battery drives one shared corpus through\n24|// all five judges — environ.DecodeStrictObject,\n25|// sessadapter.DecodeTuple, dirnode.CheckScanRequest,\n26|// provhost.DecodeManifest, and canonicaljson.Canonicalize — and\n27|// requires the ledgered verdict at each.\n28|//\n29|// A row whose reached arm cannot be determined fails, never\n30|// passes: frame-fault rows assert the full rendering (the fault\n31|// detail phrase in the refusal text), and accept rows assert the\n32|// body travels past the frame gate (an accept, or a refusal at a\n33|// named later arm with the frame phrase asserted absent). A code\n34|//-only assertion would conflate the frame gate with the member\n35|// gates behind it, which carry the same refusal code.\n36|//\n37|// The roster fails closed in both directions: every fault detail\n38|// derived from environ production must own at least one row, and\n39|// a row naming a detail production no longer derives fails as\n40|// orphaned. Expected verdicts are ledgered per judge, so a\n41|// verdict flip in EITHER direction — a fix or a regression —\n42|// reddens its row instead of passing silently.\n43|\n44|// frameRow is one corpus vector with the ledgered verdict at\n45|// every judge. A refuse expectation names the refusal text the\n46|// verdict must contain; an accept expectation names a later-arm\n47|// text the verdict must contain (\"\" with accept=true means the\n48|// entry itself accepts). canonicalRefuse nil means the\n49|// canonicalizer is not judged on this row: it validates JSON\n50|// values, not closed objects, so object-shape faults\n51|// (non-object, duplicate, trailing) are outside the decoder\n52|// rules it shares with the facades.\n53|type frameRow struct {\n54|\tfault string\n55|\tname  string\n56|\tbody  []byte\n57|\n58|\t// Per-judge bodies override body where an entry needs a\n59|\t// shaped vector (accept controls): nil means the shared\n60|\t// minimal body, which every frame gate refuses before any\n61|\t// member is read.\n62|\tsessBody []byte\n63|\tdirBody  []byte\n64|\tprovBody []byte\n65|\n66|\tenvironRefuse string\n67|\tenvironMember string\n68|\n69|\tsessAccept bool\n70|\tsessText   string\n71|\tsessAbsent string\n72|\n73|\tdirAccept bool\n74|\tdirText   string\n75|\tdirAbsent string\n76|\n77|\tprovAccept bool\n78|\tprovText   string\n79|\tprovAbsent string\n80|\n81|\tcanonicalRefuse *bool\n82|}\n83|\n84|func boolPointer(value bool) *bool {\n85|\treturn &value\n86|}\n87|\n88|// frameCorpus is the shared fault corpus. Surrogate subclasses\n89|// enumerate the full shape of the gate: bare highs and lows,\n90|// mispairs, truncated and malformed escapes, paired controls,\n91|// and backslash-run parity (runs of 1..3 backslashes before the\n92|// escape, in value, member-name, and nested positions). Run\n93|// parity is the exact shape of the recorded raw-scan divergence:\n94|// a string-aware walk consumes `\\\\` pairs, so a `\\u` sequence\n95|// behind an odd run is a real escape every judge refuses when\n96|// lone, while the same sequence behind an even run is quoted\n97|// text the raw byte scan still refuses. A raw scanner matches\n98|// every `\\u` byte pair regardless of string context.\n99|func frameCorpus() []frameRow {\n100|\tpairVersion := `\"environment_version\":\"A\\uD83D\\uDE00B\"`\n101|\tpairTuple := []byte(strings.Replace(validTupleJSON(), `\"environment_version\":\"2.1.0\"`, pairVersion, 1))\n102|\tpairCursor := validScanRequestJSON(`\"A\\uD83D\\uDE00B\"`)\n103|\trows := []frameRow{\n104|\t\t{\n105|\t\t\tfault: FaultNotUTF8, name: \"non-utf8 bytes\",\n106|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"a\\xff\\\"}\"),\n107|\t\t\tenvironRefuse: FaultNotUTF8,\n108|\t\t\tsessText:      FaultNotUTF8, dirText: FaultNotUTF8, provText: FaultNotUTF8,\n109|\t\t\tcanonicalRefuse: boolPointer(true),\n110|\t\t},\n111|\t\t{\n112|\t\t\tfault: FaultLoneSurrogate, name: \"bare high escape\",\n113|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\ud800B\\\"}\"),\n114|\t\t\tenvironRefuse: FaultLoneSurrogate,\n115|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n116|\t\t\tcanonicalRefuse: boolPointer(true),\n117|\t\t},\n118|\t\t{\n119|\t\t\tfault: FaultLoneSurrogate, name: \"bare low escape\",\n120|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\udc00B\\\"}\"),\n121|\t\t\tenvironRefuse: FaultLoneSurrogate,\n122|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n123|\t\t\tcanonicalRefuse: boolPointer(true),\n124|\t\t},\n125|\t\t{\n126|\t\t\tfault: FaultLoneSurrogate, name: \"high followed by non-low\",\n127|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83D\\\\u0041B\\\"}\"),\n128|\t\t\tenvironRefuse: FaultLoneSurrogate,\n129|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n130|\t\t\tcanonicalRefuse: boolPointer(true),\n131|\t\t},\n132|\t\t{\n133|\t\t\tfault: FaultNotObject, name: \"truncated escape falls to syntax\",\n134|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83\\\"}\"),\n135|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n136|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n137|\t\t\tcanonicalRefuse: boolPointer(true),\n138|\t\t},\n139|\t\t{\n140|\t\t\tfault: FaultNotObject, name: \"malformed escape falls to syntax\",\n141|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uDEFG B\\\"}\"),\n142|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n143|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultNotObject,\n144|\t\t\tcanonicalRefuse: boolPointer(true),\n145|\t\t},\n146|\t\t{\n147|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run2\",\n148|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800B\\\"}\"),\n149|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n150|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n151|\t\t\tcanonicalRefuse: boolPointer(false),\n152|\t\t},\n153|\t\t{\n154|\t\t\t// Run 3 is an escaped backslash followed by a REAL\n155|\t\t\t// lone escape (value `A\\` plus U+D800), so every\n156|\t\t\t// judge refuses: odd runs escape, even runs quote.\n157|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash high run3\",\n158|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\\\\\ud800B\\\"}\"),\n159|\t\t\tenvironRefuse: FaultLoneSurrogate,\n160|\t\t\tsessText:      FaultLoneSurrogate, dirText: FaultLoneSurrogate, provText: FaultLoneSurrogate,\n161|\t\t\tcanonicalRefuse: boolPointer(true),\n162|\t\t},\n163|\t\t{\n164|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash low run2\",\n165|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\udc00B\\\"}\"),\n166|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n167|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n168|\t\t\tcanonicalRefuse: boolPointer(false),\n169|\t\t},\n170|\t\t{\n171|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash pair run2\",\n172|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\uD83D\\\\\\\\uDE00B\\\"}\"),\n173|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n174|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n175|\t\t\tcanonicalRefuse: boolPointer(false),\n176|\t\t},\n177|\t\t{\n178|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash in member name\",\n179|\t\t\tbody:     []byte(\"{\\\"A\\\\\\\\ud800B\\\":1}\"),\n180|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n181|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n182|\t\t\tcanonicalRefuse: boolPointer(false),\n183|\t\t},\n184|\t\t{\n185|\t\t\tfault: FaultLoneSurrogate, name: \"escaped backslash nested\",\n186|\t\t\tbody:     []byte(\"{\\\"v\\\":{\\\"w\\\":\\\"A\\\\\\\\ud800B\\\"}}\"),\n187|\t\t\tsessText: FaultLoneSurrogate, dirText: FaultLoneSurrogate,\n188|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n189|\t\t\tcanonicalRefuse: boolPointer(false),\n190|\t\t},\n191|\t\t{\n192|\t\t\tfault: FaultDuplicate, name: \"duplicate member\",\n193|\t\t\tbody:          []byte(\"{\\\"v\\\":1,\\\"v\\\":2}\"),\n194|\t\t\tenvironRefuse: FaultDuplicate, environMember: \"v\",\n195|\t\t\tsessText: FaultDuplicate, dirText: FaultDuplicate, provText: FaultDuplicate,\n196|\t\t},\n197|\t\t{\n198|\t\t\tfault: FaultTrailing, name: \"trailing data\",\n199|\t\t\tbody:          []byte(\"{\\\"v\\\":1} {}\"),\n200|\t\t\tenvironRefuse: FaultTrailing,\n201|\t\t\tsessText:      FaultTrailing, dirText: FaultTrailing, provText: FaultTrailing,\n202|\t\t},\n203|\t\t{\n204|\t\t\tfault: FaultNotObject, name: \"non-object top level\",\n205|\t\t\tbody:          []byte(\"[1,2]\"),\n206|\t\t\tenvironRefuse: FaultNotObject,\n207|\t\t\tsessText:      FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n208|\t\t},\n209|\t\t{\n210|\t\t\tfault: FaultNotObject, name: \"unterminated string is syntax\",\n211|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"abc\"),\n212|\t\t\tenvironRefuse: FaultNotObject, environMember: \"v\",\n213|\t\t\tsessText: FaultNotObject, dirText: FaultNotObject, provText: FaultNotObject,\n214|\t\t\tcanonicalRefuse: boolPointer(true),\n215|\t\t},\n216|\t\t{\n217|\t\t\tfault: FaultLoneSurrogate, name: \"paired surrogates admit\",\n218|\t\t\tbody:       []byte(`{\"v\":\"A\\uD83D\\uDE00B\"}`),\n219|\t\t\tsessBody:   pairTuple,\n220|\t\t\tdirBody:    pairCursor,\n221|\t\t\tprovBody:   []byte(`{\"note\":\"A\\uD83D\\uDE00B\"}`),\n222|\t\t\tsessAccept: true,\n223|\t\t\tdirAccept:  true,\n224|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultLoneSurrogate,\n225|\t\t\tcanonicalRefuse: boolPointer(false),\n226|\t\t},\n227|\t\t{\n228|\t\t\tfault: FaultNotUTF8, name: \"multibyte text admits\",\n229|\t\t\tbody:       []byte(\"{\\\"v\\\":\\\"plain ü ☃\\\"}\"),\n230|\t\t\tsessBody:   pairTuple,\n231|\t\t\tdirBody:    pairCursor,\n232|\t\t\tprovBody:   []byte(\"{\\\"note\\\":\\\"plain ü ☃\\\"}\"),\n233|\t\t\tsessAccept: true,\n234|\t\t\tdirAccept:  true,\n235|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: FaultNotUTF8,\n236|\t\t\tcanonicalRefuse: boolPointer(false),\n237|\t\t},\n238|\t}\n239|\treturn rows\n240|}\n241|\n242|// deriveFaultDetails derives the frame-fault space from environ\n243|// production: every Fault* constant value in decode.go. A sixth\n244|// fault shape fails the roster below instead of passing\n245|// unrostered.\n246|func deriveFaultDetails(t *testing.T) map[string]bool {\n247|\tt.Helper()\n248|\tpath := filepath.Join(mustGetwd(t), \"decode.go\")\n249|\tsource, err := os.ReadFile(path)\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"faults: %v\", err)\n252|\t}\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"faults: %v\", err)\n256|\t}\n257|\tdetails := map[string]bool{}\n258|\tfor _, decl := range syntax.Decls {\n259|\t\tnode, ok := decl.(*ast.GenDecl)\n260|\t\tif !ok {\n261|\t\t\tcontinue\n262|\t\t}\n263|\t\tfor _, spec := range node.Specs {\n264|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n265|\t\t\tif !ok {\n266|\t\t\t\tcontinue\n267|\t\t\t}\n268|\t\t\tfor index, name := range value.Names {\n269|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n270|\t\t\t\t\tcontinue\n271|\t\t\t\t}\n272|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n273|\t\t\t\tif !ok {\n274|\t\t\t\t\tt.Fatalf(\"faults: %s is not a literal; the extractor cannot see through indirection\", name.Name)\n275|\t\t\t\t}\n276|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n277|\t\t\t\tif err != nil {\n278|\t\t\t\t\tt.Fatalf(\"faults: %v\", err)\n279|\t\t\t\t}\n280|\t\t\t\tdetails[text] = true\n281|\t\t\t}\n282|\t\t}\n283|\t}\n284|\tif len(details) == 0 {\n285|\t\tt.Fatal(\"faults derived zero details; the scanner is blind, not the space empty\")\n286|\t}\n287|\treturn details\n288|}\n289|\n290|func mustGetwd(t *testing.T) string {\n291|\tt.Helper()\n292|\tdirectory, err := os.Getwd()\n293|\tif err != nil {\n294|\t\tt.Fatalf(\"frame: %v\", err)\n295|\t}\n296|\treturn directory\n297|}\n298|\n299|// TestFrameFaultRosterIsClosed requires every derived fault\n300|// detail to own at least one row, and every row to name a\n301|// derived detail.\n302|func TestFrameFaultRosterIsClosed(t *testing.T) {\n303|\tdetails := deriveFaultDetails(t)\n304|\tcovered := map[string]bool{}\n305|\tfor _, row := range frameCorpus() {\n306|\t\tif row.fault == \"\" {\n307|\t\t\tt.Fatalf(\"row %q names no fault detail\", row.name)\n308|\t\t}\n309|\t\tif !details[row.fault] {\n310|\t\t\tt.Fatalf(\"row %q names underived detail %q\", row.name, row.fault)\n311|\t\t}\n312|\t\tcovered[row.fault] = true\n313|\t}\n314|\tfor detail := range details {\n315|\t\tif !covered[detail] {\n316|\t\t\tt.Errorf(\"derived fault detail %q owns no corpus row\", detail)\n317|\t\t}\n318|\t}\n319|}\n320|\n321|// TestFrameAgreementAcrossFacades drives the shared corpus\n322|// through all five judges and requires the ledgered verdict at\n323|// each. environ rows assert the exact fault and member; facade\n324|// rows assert the full frame rendering (the detail phrase in the\n325|// refusal text) or, for accept rows, travel past the frame gate\n326|// with the frame phrase asserted absent; canonical rows assert\n327|// the verdict only, where the canonicalizer shares the rule.\n328|func TestFrameAgreementAcrossFacades(t *testing.T) {\n329|\tfor _, row := range frameCorpus() {\n330|\t\tt.Run(row.name, func(t *testing.T) {\n331|\t\t\t_, fault := DecodeStrictObject(row.body)\n332|\t\t\tif row.environRefuse == \"\" {\n333|\t\t\t\tif fault != nil {\n334|\t\t\t\t\tt.Fatalf(\"environ refused %q: %v\", row.body, fault)\n335|\t\t\t\t}\n336|\t\t\t} else {\n337|\t\t\t\tif fault == nil {\n338|\t\t\t\t\tt.Fatalf(\"environ admitted %q, want fault %q\", row.body, row.environRefuse)\n339|\t\t\t\t}\n340|\t\t\t\tif fault.Detail != row.environRefuse || fault.Member != row.environMember {\n341|\t\t\t\t\tt.Fatalf(\"environ fault = (%q, %q), want (%q, %q)\", fault.Detail, fault.Member, row.environRefuse, row.environMember)\n342|\t\t\t\t}\n343|\t\t\t}\n344|\t\t\tsessBody := orBody(row.body, row.sessBody)\n345|\t\t\tdirBody := orBody(row.body, row.dirBody)\n346|\t\t\tprovBody := orBody(row.body, row.provBody)\n347|\t\t\tassertFacadeVerdict(t, \"sessadapter\", sessBody, row.sessAccept, row.sessText, row.sessAbsent, func(body []byte) error {\n348|\t\t\t\t_, err := sessadapter.DecodeTuple(body)\n349|\t\t\t\treturn err\n350|\t\t\t})\n351|\t\t\tassertFacadeVerdict(t, \"dirnode\", dirBody, row.dirAccept, row.dirText, row.dirAbsent, func(body []byte) error {\n352|\t\t\t\t_, err := dirnode.CheckScanRequest(body)\n353|\t\t\t\treturn err\n354|\t\t\t})\n355|\t\t\tassertFacadeVerdict(t, \"provhost\", provBody, row.provAccept, row.provText, row.provAbsent, func(body []byte) error {\n356|\t\t\t\treturn provhost.DecodeManifest(body)\n357|\t\t\t})\n358|\t\t\tif row.canonicalRefuse != nil {\n359|\t\t\t\t_, err := canonicaljson.Canonicalize(row.body)\n360|\t\t\t\tif (*row.canonicalRefuse && err == nil) || (!*row.canonicalRefuse && err != nil) {\n361|\t\t\t\t\tt.Fatalf(\"canonicaljson verdict = refuse=%v, want refuse=%v (err=%v)\", err != nil, *row.canonicalRefuse, err)\n362|\t\t\t\t}\n363|\t\t\t}\n364|\t\t})\n365|\t}\n366|}\n367|\n368|// orBody selects the per-judge override body when present.\n369|func orBody(shared, override []byte) []byte {\n370|\tif override != nil {\n371|\t\treturn override\n372|\t}\n373|\treturn shared\n374|}\n375|\n376|// assertFacadeVerdict requires the ledgered verdict at one\n377|// facade entry: an accept, or a refusal whose text contains the\n378|// frame phrase (and never contains the absent phrase, which\n379|// pins travel past a gate the body must cross).\n380|func assertFacadeVerdict(t *testing.T, facade string, body []byte, accept bool, text, absent string, drive func([]byte) error) {\n381|\tt.Helper()\n382|\terr := drive(body)\n383|\tif accept {\n384|\t\tif err != nil {\n385|\t\t\tt.Fatalf(\"%s refused %q, want accept: %v\", facade, body, err)\n386|\t\t}\n387|\t\treturn\n388|\t}\n389|\tif err == nil {\n390|\t\tt.Fatalf(\"%s admitted %q, want refusal containing %q\", facade, body, text)\n391|\t}\n392|\tif text != \"\" && !strings.Contains(err.Error(), text) {\n393|\t\tt.Fatalf(\"%s error = %v, want text containing %q\", facade, err, text)\n394|\t}\n395|\tif absent != \"\" && strings.Contains(err.Error(), absent) {\n396|\t\tt.Fatalf(\"%s error = %v, must not contain %q\", facade, err, absent)\n397|\t}\n398|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c585","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":285,"recorded_at":1780531400000565,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a07665855473809fd6b9b379129863","text":"Read text file `internal/environ/corpus_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Shared fixtures for the environ boundary battery. Every builder\n17|// emits hand-written JSON with independently chosen literals: no\n18|// builder derives its probe points from production constants, so\n19|// a mutated production constant cannot take its fixture with\n20|// it. The verdict always comes from production; the vectors never\n21|// do. In particular the schema URNs, version strings, member\n22|// names, and vocabulary tokens below are retyped from the pinned\n23|// specification, not referenced from any package under test.\n24|//\n25|// One corpus drives every facade: the same digest, UUIDv7, and\n26|// timestamp identities flow into the sessadapter, dirnode,\n27|// provhost, and canonicaljson entries each battery file drives,\n28|// so a fixture that is valid for one facade and invalid for\n29|// another fails loudly instead of passing per-facade copies that\n30|// never meet.\n31|\n32|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n33|// the digests are syntactically pinned sha256 hex.\n34|const (\n35|\tfixtureHostID        = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n36|\tfixtureOperationID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n37|\tfixtureSubjectID     = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n38|\tfixtureWorkspaceID   = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n39|\tfixtureCreatorHostID = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n40|\tfixtureObservedAt    = \"2026-08-19T04:05:00.000Z\"\n41|\tfixtureValidFrom     = \"2026-01-01T00:00:00.000Z\"\n42|\tfixtureValidUntil    = \"2027-01-01T00:00:00.000Z\"\n43|\tfixtureEnvironmentID = \"test.env\"\n44|\tfixtureAdapterVer    = \"1.2.3\"\n45|\tfixtureProviderID    = \"test-provider\"\n46|)\n47|\n48|// fixtureDigest returns the pinned digest of one seed.\n49|func fixtureDigest(seed string) string {\n50|\tsum := sha256.Sum256([]byte(seed))\n51|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n52|}\n53|\n54|// Standard fixture digests, each naming its seed.\n55|var (\n56|\tfixtureStorePrint  = fixtureDigest(\"test-store-fingerprint\")\n57|\tfixtureInstallID   = fixtureDigest(\"test-installation\")\n58|\tfixtureObserveID   = fixtureDigest(\"test-observation\")\n59|\tfixtureRealmPrint  = fixtureDigest(\"test-realm\")\n60|\tfixtureRecordID    = fixtureDigest(\"test-identity-record\")\n61|\tfixtureEvidenceID  = fixtureDigest(\"test-evidence\")\n62|\tfixtureExecutable  = fixtureDigest(\"test-executable\")\n63|\tfixtureAdapterMain = fixtureDigest(\"test-adapter-manifest\")\n64|)\n65|\n66|// TestSharedFixtureIdentitiesAreValid guards the instrument: a\n67|// malformed shared identity would refuse at every facade for the\n68|// wrong reason, turning the whole battery into a test of the\n69|// fixture rather than the facades.\n70|func TestSharedFixtureIdentitiesAreValid(t *testing.T) {\n71|\tfor _, identity := range []string{fixtureHostID, fixtureOperationID, fixtureSubjectID, fixtureWorkspaceID, fixtureCreatorHostID} {\n72|\t\tif _, err := scalar.ParseUUIDv7(identity); err != nil {\n73|\t\t\tt.Fatalf(\"fixture UUID %q does not parse: %v\", identity, err)\n74|\t\t}\n75|\t}\n76|\tfor _, moment := range []string{fixtureObservedAt, fixtureValidFrom, fixtureValidUntil} {\n77|\t\tif _, err := scalar.ParseTimestamp(moment); err != nil {\n78|\t\t\tt.Fatalf(\"fixture timestamp %q does not parse: %v\", moment, err)\n79|\t\t}\n80|\t}\n81|\tfor _, digest := range []string{fixtureStorePrint, fixtureInstallID, fixtureObserveID, fixtureRealmPrint, fixtureRecordID, fixtureEvidenceID, fixtureExecutable, fixtureAdapterMain} {\n82|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n83|\t\t\tt.Fatalf(\"fixture digest %q does not parse: %v\", digest, err)\n84|\t\t}\n85|\t}\n86|}\n87|\n88|// validTupleJSON is one valid Environment Tuple over the shared\n89|// identities.\n90|func validTupleJSON() string {\n91|\treturn fmt.Sprintf(`{\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":%q}`,\n92|\t\tfixtureEnvironmentID, fixtureStorePrint, fixtureAdapterVer)\n93|}\n94|\n95|// validScanRequestJSON is one valid dirnode scan request carrying\n96|// the given cursor literal (already JSON-encoded by the caller).\n97|func validScanRequestJSON(cursorLiteral string) []byte {\n98|\treturn []byte(fmt.Sprintf(`{\"operation_id\":%q,\"installation_ids\":[%q],\"prior_batch_id\":null,\"cursor\":%s,\"max_instances\":10,\"extensions\":{}}`,\n99|\t\tfixtureOperationID, fixtureInstallID, cursorLiteral))\n100|}\n101|\n102|// validIdentityJSON is one valid Provider Identity Record over\n103|// the shared identities: an Antigravity\n104|// backend_conversation_uuid with a non-null realm fingerprint.\n105|func validIdentityJSON() []byte {\n106|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:provider-identity\",\"schema_version\":\"1.0.0\",\"record_id\":%q,\"subject_id\":%q,\"session_id\":%q,\"provider_id\":\"antigravity\",\"provider_version\":\"1.1.14\",\"provider_version_range\":\">=1.1.14 <1.2.0\",\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"identity_kind\":\"backend_conversation_uuid\",\"logical_workspace_id\":%q,\"backend_realm_fingerprint\":%q,\"opaque_identity\":{},\"created_by_host_id\":%q,\"created_at\":%q,\"extensions\":{}}`,\n107|\t\tfixtureRecordID, fixtureSubjectID, fixtureSubjectID, fixtureWorkspaceID, fixtureRealmPrint, fixtureCreatorHostID, fixtureObservedAt))\n108|}\n109|\n110|// availableCapabilityJSON is one available CapabilityResult with\n111|// null reason.\n112|func availableCapabilityJSON() string {\n113|\treturn fmt.Sprintf(`{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":%q,\"extensions\":{}}`, fixtureObservedAt)\n114|}\n115|\n116|// validCapabilitiesJSON is the exact eight-name capability map\n117|// with every capability available.\n118|func validCapabilitiesJSON() string {\n119|\tnames := []string{\n120|\t\t\"directory_discovery\",\n121|\t\t\"directory_incremental_scan\",\n122|\t\t\"directory_head_digest\",\n123|\t\t\"directory_tail_preview\",\n124|\t\t\"native_title_read\",\n125|\t\t\"native_runtime_observation\",\n126|\t\t\"existing_session_adoption\",\n127|\t\t\"native_resume\",\n128|\t}\n129|\tparts := make([]string, 0, len(names))\n130|\tfor _, name := range names {\n131|\t\tquoted, err := json.Marshal(name)\n132|\t\tif err != nil {\n133|\t\t\tpanic(err)\n134|\t\t}\n135|\t\tparts = append(parts, string(quoted)+\":\"+availableCapabilityJSON())\n136|\t}\n137|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n138|}\n139|\n140|// validObservationJSON is one valid Environment Observation over\n141|// the shared identities.\n142|func validObservationJSON() []byte {\n143|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:environment-observation\",\"schema_version\":\"1.0.0\",\"observation_id\":%q,\"host_id\":%q,\"installation_id\":%q,\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"provider_id\":%q,\"platform\":\"linux\",\"architecture\":\"amd64\",\"backend_realm_fingerprint\":%q,\"capabilities\":%s,\"authentication_status\":\"available\",\"runtime_status\":\"available\",\"observed_at\":%q,\"extensions\":{}}`,\n144|\t\tfixtureObserveID, fixtureHostID, fixtureInstallID, fixtureEnvironmentID, fixtureProviderID, fixtureRealmPrint, validCapabilitiesJSON(), fixtureObservedAt))\n145|}\n146|\n147|// mutateMember returns the object with one top-level member\n148|// replaced by the given raw JSON. The replacement is applied to a\n149|// fresh positive fixture, one mutation at a time: every other\n150|// member holds a valid value, so two distinct rules cannot both\n151|// satisfy one witness.\n152|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n153|\tt.Helper()\n154|\tmembers := decodeTestMembers(t, body)\n155|\tmembers[member] = replacement\n156|\treturn encodeTestMembers(t, members)\n157|}\n158|\n159|// dropMember returns the object without one top-level member.\n160|func dropMember(t *testing.T, body []byte, member string) []byte {\n161|\tt.Helper()\n162|\tmembers := decodeTestMembers(t, body)\n163|\tdelete(members, member)\n164|\treturn encodeTestMembers(t, members)\n165|}\n166|\n167|func decodeTestMembers(t *testing.T, body []byte) map[string]string {\n168|\tt.Helper()\n169|\tvar raw map[string]json.RawMessage\n170|\tif err := json.Unmarshal(body, &raw); err != nil {\n171|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n172|\t}\n173|\tmembers := make(map[string]string, len(raw))\n174|\tfor name, value := range raw {\n175|\t\tmembers[name] = string(value)\n176|\t}\n177|\treturn members\n178|}\n179|\n180|func encodeTestMembers(t *testing.T, members map[string]string) []byte {\n181|\tt.Helper()\n182|\tnames := make([]string, 0, len(members))\n183|\tfor name := range members {\n184|\t\tnames = append(names, name)\n185|\t}\n186|\tsort.Strings(names)\n187|\tparts := make([]string, 0, len(members))\n188|\tfor _, name := range names {\n189|\t\tquoted, err := json.Marshal(name)\n190|\t\tif err != nil {\n191|\t\t\tt.Fatalf(\"encodeTestMembers: %v\", err)\n192|\t\t}\n193|\t\tparts = append(parts, string(quoted)+\":\"+members[name])\n194|\t}\n195|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n196|}\n197|\n198|// TestEntriesAreDeterministic proves the validation entries are\n199|// pure functions of their input bytes: repeated decoding is\n200|// byte-identical, so there is no hidden cache, no clock read, and\n201|// no durable state whose crash recovery would need evidence. The\n202|// scan journal in dirnode is the story's only durable state and\n203|// belongs to the frozen leaf; this library adds none.\n204|func TestEntriesAreDeterministic(t *testing.T) {\n205|\tbodies := [][]byte{[]byte(validTupleJSON()), validObservationJSON(), validIdentityJSON()}\n206|\tfor index, body := range bodies {\n207|\t\tfirst, err := DecodeStrictObject(body)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"body %d: first decode: %v\", index, err)\n210|\t\t}\n211|\t\tsecond, err := DecodeStrictObject(body)\n212|\t\tif err != nil {\n213|\t\t\tt.Fatalf(\"body %d: second decode: %v\", index, err)\n214|\t\t}\n215|\t\tif !reflect.DeepEqual(first, second) {\n216|\t\t\tt.Fatalf(\"body %d: repeated decode differs\", index)\n217|\t\t}\n218|\t}\n219|\tfirst, err := DecodeTuple([]byte(validTupleJSON()))\n220|\tif err != nil {\n221|\t\tt.Fatalf(\"tuple first decode: %v\", err)\n222|\t}\n223|\tsecond, err := DecodeTuple([]byte(validTupleJSON()))\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"tuple second decode: %v\", err)\n226|\t}\n227|\tif first != second {\n228|\t\tt.Fatalf(\"tuple repeated decode differs: %+v vs %+v\", first, second)\n229|\t}\n230|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c587","stream":{"kind":"session","id":"01a07664-b32a-7b03-be28-978067559ac9"},"sequence":286,"recorded_at":1780531400000567,"record_type":"event","durability":"durable","causation_id":"4279c805-073c-4405-a747-7b1a47e438ac","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4279c805-073c-4405-a747-7b1a47e438ac","run_stream":{"kind":"run","id":"4279c805-073c-4405-a747-7b1a47e438ac"},"call_id":"call_01a0766585f77061a795dffc20b0804a","text":"Read text file `internal/environ/tuple_agreement_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n14|)\n15|\n16|// This file is the Environment Tuple agreement battery. The\n17|// tuple is the one type every state-bearing adapter call\n18|// carries, and its admission model is shared with the Section\n19|// 10.8.1 observation rather than restated there. The battery\n20|// proves sessadapter.DecodeTuple and environ.DecodeTuple agree\n21|// verdict-for-verdict over a corpus that mutates each member\n22|// alone, and proves the two member tables are literally one\n23|// table: the required lists are derived from both productions\n24|// and required equal in order as well as content, because\n25|// missing-member determinism (which member is named when several\n26|// are absent) is itself shared behavior.\n27|\n28|// deriveRequiredList derives the string list behind a\n29|// package-level []string variable in one production file. The\n30|// comparison travels with the derivation: a reordered,\n31|// extended, or shortened table fails here, not silently.\n32|func deriveRequiredList(t *testing.T, pkg, file, symbol string) []string {\n33|\tt.Helper()\n34|\tpath := filepath.Join(mustInternalRoot(t), pkg, file)\n35|\tsource, err := os.ReadFile(path)\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"members: %v\", err)\n38|\t}\n39|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"members: %v\", err)\n42|\t}\n43|\tfor _, decl := range syntax.Decls {\n44|\t\tnode, ok := decl.(*ast.GenDecl)\n45|\t\tif !ok {\n46|\t\t\tcontinue\n47|\t\t}\n48|\t\tfor _, spec := range node.Specs {\n49|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n50|\t\t\tif !ok || len(value.Names) != 1 || value.Names[0].Name != symbol {\n51|\t\t\t\tcontinue\n52|\t\t\t}\n53|\t\t\tif len(value.Values) != 1 {\n54|\t\t\t\tt.Fatalf(\"members: %s %s is not a single literal; the extractor cannot see through indirection\", path, symbol)\n55|\t\t\t}\n56|\t\t\tcomposite, ok := value.Values[0].(*ast.CompositeLit)\n57|\t\t\tif !ok {\n58|\t\t\t\tt.Fatalf(\"members: %s %s is not a composite literal; the extractor cannot see through indirection\", path, symbol)\n59|\t\t\t}\n60|\t\t\tvar members []string\n61|\t\t\tfor _, element := range composite.Elts {\n62|\t\t\t\tliteral, ok := element.(*ast.BasicLit)\n63|\t\t\t\tif !ok {\n64|\t\t\t\t\tt.Fatalf(\"members: %s %s holds a non-literal; the extractor cannot see through indirection\", path, symbol)\n65|\t\t\t\t}\n66|\t\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n67|\t\t\t}\n68|\t\t\treturn members\n69|\t\t}\n70|\t}\n71|\tt.Fatalf(\"members: %s %s not found; the extractor is blind, not the table absent\", path, symbol)\n72|\treturn nil\n73|}\n74|\n75|func mustInternalRoot(t *testing.T) string {\n76|\tt.Helper()\n77|\troot, err := internalRoot(t)\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"members: %v\", err)\n80|\t}\n81|\treturn root\n82|}\n83|\n84|// TestTupleMemberTablesAreOneTable requires the environ and\n85|// sessadapter required-member tables to be literally equal:\n86|// same members, same order. A seventh member admitted on one\n87|// side, or a renamed member, reddens here before any vector\n88|// runs.\n89|func TestTupleMemberTablesAreOneTable(t *testing.T) {\n90|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleRequired\")\n91|\ttheirs := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleRequired\")\n92|\tif !reflect.DeepEqual(mine, theirs) {\n93|\t\tt.Fatalf(\"tuple required tables differ:\\nenviron:     %q\\nsessadapter: %q\", mine, theirs)\n94|\t}\n95|\tif len(mine) != 6 {\n96|\t\tt.Fatalf(\"tuple required table has %d members, want the exact six\", len(mine))\n97|\t}\n98|}\n99|\n100|// tupleRow is one agreement vector: the body and the rule phrase\n101|// both refusals must carry. An empty phrase means both entries\n102|// accept.\n103|type tupleRow struct {\n104|\tname string\n105|\tbody []byte\n106|\ttext string\n107|}\n108|\n109|// tupleCorpus mutates each tuple member alone against an\n110|// otherwise-valid body, plus the executable-provenance,\n111|// extensions, and vocabulary edges.\n112|func tupleCorpus(t *testing.T) []tupleRow {\n113|\tt.Helper()\n114|\tvalid := validTupleJSON()\n115|\tdrop := func(member string) []byte { return dropMember(t, []byte(valid), member) }\n116|\tset := func(member, literal string) []byte { return mutateMember(t, []byte(valid), member, literal) }\n117|\treturn []tupleRow{\n118|\t\t{\"valid\", []byte(valid), \"\"},\n119|\t\t{\"missing environment_id\", drop(\"environment_id\"), \"misses a required member\"},\n120|\t\t{\"missing environment_version\", drop(\"environment_version\"), \"misses a required member\"},\n121|\t\t{\"missing platform\", drop(\"platform\"), \"misses a required member\"},\n122|\t\t{\"missing architecture\", drop(\"architecture\"), \"misses a required member\"},\n123|\t\t{\"missing store_schema_fingerprint\", drop(\"store_schema_fingerprint\"), \"misses a required member\"},\n124|\t\t{\"missing adapter_version\", drop(\"adapter_version\"), \"misses a required member\"},\n125|\t\t{\"unknown member\", set(\"adapter_version\", `\"1.2.3\"`), \"\"}, // placeholder, replaced below\n126|\t\t{\"extensions refused\", appendMember(t, []byte(valid), \"extensions\", `{}`), \"unknown member\"},\n127|\t\t{\"executable provenance refused\", appendMember(t, []byte(valid), \"executable_sha256\", jsonQuote(fixtureExecutable)), \"unknown member\"},\n128|\t\t{\"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n129|\t\t{\"empty environment id\", set(\"environment_id\", `\"\"`), \"environment-id\"},\n130|\t\t{\"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n131|\t\t{\"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n132|\t\t{\"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n133|\t\t{\"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n134|\t\t{\"uppercase refused\", set(\"platform\", `\"LINUX\"`), \"platform\"},\n135|\t\t{\"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n136|\t\t{\"arm64 admits\", set(\"architecture\", `\"arm64\"`), \"\"},\n137|\t\t{\"bad fingerprint\", set(\"store_schema_fingerprint\", `\"sha256:zzzz\"`), \"digest\"},\n138|\t\t{\"short version\", set(\"adapter_version\", `\"1.2\"`), \"SemVer\"},\n139|\t\t{\"prerelease admits\", set(\"adapter_version\", `\"1.2.3-rc.1\"`), \"\"},\n140|\t}\n141|}\n142|\n143|// TestTupleAgreementAcrossFacades drives the corpus through both\n144|// tuple entries and requires identical verdicts with the full\n145|// rule rendering on each side.\n146|func TestTupleAgreementAcrossFacades(t *testing.T) {\n147|\trows := tupleCorpus(t)\n148|\t// The unknown-member row needs a genuinely unknown member,\n149|\t// not a replaced known one.\n150|\tfor index, row := range rows {\n151|\t\tif row.name == \"unknown member\" {\n152|\t\t\trows[index].body = appendMember(t, []byte(validTupleJSON()), \"score\", `1`)\n153|\t\t\trows[index].text = \"unknown member\"\n154|\t\t}\n155|\t}\n156|\tfor _, row := range rows {\n157|\t\tt.Run(row.name, func(t *testing.T) {\n158|\t\t\tmine, mineErr := DecodeTuple(row.body)\n159|\t\t\ttheirs, theirsErr := sessadapter.DecodeTuple(row.body)\n160|\t\t\tif row.text == \"\" {\n161|\t\t\t\tif mineErr != nil {\n162|\t\t\t\t\tt.Fatalf(\"environ refused %s: %v\", row.body, mineErr)\n163|\t\t\t\t}\n164|\t\t\t\tif theirsErr != nil {\n165|\t\t\t\t\tt.Fatalf(\"sessadapter refused %s: %v\", row.body, theirsErr)\n166|\t\t\t\t}\n167|\t\t\t\tif mine.EnvironmentID != theirs.EnvironmentID || mine.Version != theirs.Version ||\n168|\t\t\t\t\tmine.Platform != theirs.Platform || mine.Architecture != theirs.Architecture ||\n169|\t\t\t\t\tmine.StoreFingerprint != theirs.StoreFingerprint || mine.AdapterVersion != theirs.AdapterVersion {\n170|\t\t\t\t\tt.Fatalf(\"decoded tuples differ: %+v vs %+v\", mine, theirs)\n171|\t\t\t\t}\n172|\t\t\t\treturn\n173|\t\t\t}\n174|\t\t\tif mineErr == nil {\n175|\t\t\t\tt.Fatalf(\"environ admitted %s, want rule %q\", row.body, row.text)\n176|\t\t\t}\n177|\t\t\tif theirsErr == nil {\n178|\t\t\t\tt.Fatalf(\"sessadapter admitted %s, want rule %q\", row.body, row.text)\n179|\t\t\t}\n180|\t\t\tif !strings.Contains(mineErr.Error(), row.text) {\n181|\t\t\t\tt.Fatalf(\"environ error = %v, want rule %q\", mineErr, row.text)\n182|\t\t\t}\n183|\t\t\tif !strings.Contains(theirsErr.Error(), row.text) {\n184|\t\t\t\tt.Fatalf(\"sessadapter error = %v, want rule %q\", theirsErr, row.text)\n185|\t\t\t}\n186|\t\t})\n187|\t}\n188|}\n189|\n190|// appendMember returns the object with one added top-level\n191|// member. Every other member holds a valid value, so the added\n192|// member alone decides the verdict.\n193|func appendMember(t *testing.T, body []byte, member, literal string) []byte {\n194|\tt.Helper()\n195|\tmembers := decodeTestMembers(t, body)\n196|\tif _, present := members[member]; present {\n197|\t\tt.Fatalf(\"appendMember: %q already present\", member)\n198|\t}\n199|\tmembers[member] = literal\n200|\treturn encodeTestMembers(t, members)\n201|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
