r string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree transaction [command] --help\\\" for more information about a command.\\n===\\nSTORY-260830-2dy8oj  active\\n  path:       .temp/STORY-260830-2dy8oj/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2dy8oj (present)\\n  base:       main\\n  tip:        81305c8886ead674122f498ad2124051257c9467\\n  tree:       not checked out\\n  change-req: TASK-260830-3amrl9 rev 8 checkpointed (repository_delta=present, 14 changed path(s))\\n  change-req: TASK-260830-3ps1b1 rev 6 checkpointed (repository_delta=present, 19 changed path(s))\\nSTORY-260830-2jylym  active\\n  path:       .temp/STORY-260830-2jylym/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2jylym (present)\\n  base:       main\\n  tip:        adca16af03663682ec57993122c22c667813afc9\\n  tree:       not checked out\\n  change-req: TASK-260830-1bipsa rev 1 checkpointed (repository_delta=empty, 0 changed path(s))\\n  change-req: TASK-260830-33sfxc rev 7 accepted (repository_delta=present, 73 changed path(s))\\n  change-req: TASK-260830-34elja rev 2 checkpointed (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-2wdm5e  active\\n  path:       .temp/STORY-260830-2wdm5e/worktree (missing)\\n  branch:     task-board/story/STORY-260830-2wdm5e (present)\\n  base:       main\\n  tip:        ad7275181ca82fc3fa29544e3893923a92d7b9d5\\n  tree:       not checked out\\n  change-req: TASK-260830-1pbx0c rev 6 checkpointed (repository_delta=present, 12 changed path(s))\\n  change-req: TASK-260830-236x9n rev 5 checkpointed (repository_delta=present, 19 changed path(s))\\n  change-req: TASK-260830-8x76g1 rev 16 accepted (repository_delta=present, 71 changed path(s))\\nSTORY-260830-323tpq  active\\n  path:       .temp/STORY-260830-323tpq/worktree (missing)\\n  branch:     task-board/story/STORY-260830-323tpq (present)\\n  base:       main\\n  tip:        48db30b59e5e1bbc5e0cf73ec2e0e0eec3d215d1\\n  tree:       not checked out\\n  change-req: TASK-260902-2ucdvw rev 1 ready (repository_delta=empty, 0 changed path(s))\\nSTORY-260830-385twz  active\\n  path:       .temp/STORY-260830-385twz/worktree (missing)\\n  branch:     task-board/story/STORY-260830-385twz (present)\\n  base:       main\\n  tip:        6d602ba97d1fea8ab68fbc73b009a5f124bfffd0\\n  tree:       not checked out\\n  change-req: TASK-260830-3uessl rev 2 checkpointed (repository_delta=present, 9 changed path(s))\\n  change-req: TASK-260830-treeox rev 3 accepted (repository_delta=present, 15 changed path(s))\\nSTORY-260830-3drr2m  active\\n  path:       .temp/STORY-260830-3drr2m/worktree (present)\\n  branch:     task-board/story/STORY-260830-3drr2m (present)\\n  base:       main\\n  tip:        22fdf71168a7e1c706dc8c157f834649ba18c934\\n  tree:       clean\\n  lease:      held by RUN-260906-b94e40\\n  blocked:    story lease is held by run RUN-260906-b94e40\\n  change-req: TASK-260830-2z3se0 rev 7 checkpointed (repository_delta=present, 34 changed path(s))\\n  change-req: TASK-260830-3bkz0c rev 5 accepted (repository_delta=present, 70 changed path(s))\\n  change-req: TASK-260830-ljkj8r rev 3 checkpointed (repository_delta=present, 29 changed path(s))\\nSTORY-260830-3jqsx1  active\\n  path:       .temp/STORY-260830-3jqsx1/worktree (present)\\n  branch:     task-board/story/STORY-260830-3jqsx1 (present)\\n  base:       main\\n  tip:        2512f2087bcea43481f8541ee780f11daeececd4\\n  tree