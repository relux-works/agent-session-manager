{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c503","stream":{"kind":"session","id":"01a076e3-7bfb-7723-a196-d7b6322b515d"},"sequence":220,"recorded_at":1780531400000435,"record_type":"event","durability":"durable","causation_id":"dcc3f2a8-dce2-4c45-8f96-d160f1e8bf1f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dcc3f2a8-dce2-4c45-8f96-d160f1e8bf1f","run_stream":{"kind":"run","id":"dcc3f2a8-dce2-4c45-8f96-d160f1e8bf1f"},"task_stream":{"kind":"task","id":"5dee47c2-75a1-4085-8cc4-60d888e46747"},"task_id":"5dee47c2-75a1-4085-8cc4-60d888e46747","event":{"kind":"output","task_id":"5dee47c2-75a1-4085-8cc4-60d888e46747","chunk":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"task-board worktree integrate --help 2>&1 | head -n 80\",\n  \"description\": \"Inspect integrate flags\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Land the accepted story_final Change Request for a Story as ONE squash commit on\\ntrunk, perform the Story's done transition, and commit the Story's board delta\\nas a second, board-only commit.\\n\\nThis command runs in the control root — the repository's main working tree, on\\nthe configured trunk branch — but only from the tracked integration run whose\\nrole and archetype match the accepted revision's immutable producer binding.\\nReviewers, orchestrators, and other producer archetypes are refused. No other\\ncheckout is ever advanced.\\n\\nIt is idempotent. A crashed run leaves one durable transaction record; re-running\\nresumes the recorded phase rather than starting a second integration, and the\\nonly phase that offers a rollback is 'prepared' with trunk unmoved.\\n\\nOn a remote board it refuses with worktree_isolation_requires_local_board before\\nthe integration lock and before the transaction opens. The rationale is data\\nlocality, not authority: admission compares worktree bytes against the store's\\nown rendering, and no single process holds both operands on a remote board.\\n\\nUsage:\\n  task-board worktree integrate <STORY-ID> [flags]\\n\\nFlags:\\n      --commit-time string   explicit RFC3339 commit time; required when version_control.confirm is enabled, and applied to both the author and the committer date\\n      --cr string            Change Request ID (the element the accepted story_final CR is attached to)\\n  -h, --help                 help for integrate\\n      --revision int         accepted Change Request revision\\n      --rollback             roll back a transaction at phase prepared with trunk unmoved instead of resuming it; available in no other phase\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2269,\n  \"original_output_tokens\": 568,\n  \"truncated\": false\n}"}}}
