{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a076d2-aae5-7bc1-9368-91da36dc26f0"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"f1e064ad-aae0-4d22-a3de-61838919f455","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f1e064ad-aae0-4d22-a3de-61838919f455","run_stream":{"kind":"run","id":"f1e064ad-aae0-4d22-a3de-61838919f455"},"task_stream":{"kind":"task","id":"67ee4c8e-b231-4dac-8506-85c33ec12889"},"task_id":"67ee4c8e-b231-4dac-8506-85c33ec12889","event":{"kind":"output","task_id":"67ee4c8e-b231-4dac-8506-85c33ec12889","chunk":"{\n  \"chunk_id\": \"exec-5-1\",\n  \"command\": \"task-board handoff --help 2>&1 | head -n 80\\necho \\\"===QHELP===\\\"\\ntask-board q --help 2>&1 | head -n 60\",\n  \"description\": \"Inspect handoff and query usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Resolve the configured role end status, verify every checklist item and\\nat least one stored task-scoped outcome resource, and apply the ordinary\\ncascading status transition under one mutation lock.\\n\\nThe command fails closed with all missing evidence and does not change status.\\nAttach or update the outcome with the resource or mutation CLI before handoff.\\n\\nUsage:\\n  task-board handoff <ELEMENT-ID> [flags]\\n\\nFlags:\\n      --commit-ack string   Mover acknowledgement for an enforced done transition\\n      --format string       Output format: compact or json (default \\\"compact\\\")\\n  -h, --help                help for handoff\\n      --role string         Role whose configured end_status must be applied\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===QHELP===\\nExecute queries against the board using a compact DSL.\\n\\nOperations:\\n  get(ID)              Get a single element by ID\\n  activity(ID, ...)    Read bounded, cursor-paginated element activity\\n  list(filters...)     List elements with filters\\n  count(filters...)    Count elements matching filters\\n  summary()            Board overview (counts + active/blocked)\\n  plan(scope?)         Execution phases; scope=[ID,ID,...] plans the union of subtrees\\n  agents(stale=N?)     Agent dashboard\\n  models(agent?)       Available models for spawn\\n  project_config()     Full active project board runtime config (always local)\\n  project_config(view=spawn-preflight, role=ROLE, agent=PROVIDER?)\\n                       Narrow effective child-spawn policy for one target\\n  provider_limits()    Machine-scoped provider rate-limit state (always local)\\n  provider_limits(identity=KEY|all_identities=true)\\n                       Report one indexed provider identity, or every one\\n  whoami()             Current remote URL and active user (always local)\\n  schema()             Introspect the full operations/fields/presets contract\\n  schema(operation=NAME|mutation=NAME)\\n                       Return only one typed operation or mutation signature\\n\\nField projection:\\n  { id status assignee }     Select specific fields\\n  { overview }               Use a base preset (minimal, default, overview, full, progress, planning)\\n  { observability-task }     Use project observability presets (project, epic, story, task)\\n  (omitted)                  Defaults to { id name status }\\n\\nBatching:\\n  Separate multiple queries with semicolons; results preserve source order\\n\\nSpawn policy projection:\\n  Full project_config reports the effective spawn-policy-v2/v3 contract,\\n  authority, normalized provider and role-effective policy, and exact config\\n  provenance. V2 additionally reports its frozen compatibility snapshot and a\\n  copy-ready v3 migration object; this is read-only evidence and never edits\\n  task-board.config.json. Spawn-preflight returns only the selected role policy\\n  and its actionable migration warning.\\n\\nOutput format:\\n  --format json       Standard JSON (default)\\n  --format compact    Compact tabular output (~40% fewer tokens)\\n                      plan() switches to the super-compact planning shape:\\n                      flat waves of IDs, one-line critical path, id->status map\\n\\nExamples:\\n  task-board q 'schema()'\\n  task-board q 'get(TASK-260211-abc) { id status assignee }'\\n  task-board q 'activity(TASK-260211-abc, limit=25, order=descending, view=effective)'\\n  task-board q 'list(type=task, status=development) { overview }'\\n  task-board q 'count(type=task, status=done)'\\n  task-board q 'summary()'\\n  task-board q 'summary() { observability-project }'\\n  task-board q 'get(STORY-1) { observability-story }'\\n  task-board q 'models()'\\n  task-board q 'models(agent=claude)'\\n  task-board q 'project_config()'\\n  task-board q 'provider_limits()'\\n  task-board q 'project_config(view=spawn-preflight, role=developer, agent=codex)'\\n  task-board q 'schema(operation=project_config)'\\n\",\n  \"original_output_bytes\": 4382,\n  \"original_output_tokens\": 1096,\n  \"truncated\": false\n}"}}}
