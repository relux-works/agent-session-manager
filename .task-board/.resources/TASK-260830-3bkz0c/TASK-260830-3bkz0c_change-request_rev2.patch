+// hasLenCall reports whether the subtree calls len.
+func hasLenCall(node ast.Node) bool {
+	found := false
+	ast.Inspect(node, func(inner ast.Node) bool {
+		call, ok := inner.(*ast.CallExpr)
+		if ok {
+			if ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == "len" {
+				found = true
+				return false
+			}
+		}
+		return true
+	})
+	return found
+}
