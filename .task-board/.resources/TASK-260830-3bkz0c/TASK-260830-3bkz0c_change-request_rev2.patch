+	if err := drive(`[` + quote(fixtureBatchDigest) + `]`); err != nil {
+		t.Fatalf("refused a digest member: %v", err)
+	}
+	if err := drive(`["zzz"]`); err == nil {
+		t.Fatal("admitted a member that is neither UUIDv7 nor digest")
+	}
+	union256 := make([]string, 0, 256)
