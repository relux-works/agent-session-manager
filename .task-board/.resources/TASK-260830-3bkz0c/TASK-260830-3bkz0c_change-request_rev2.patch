+		union256 = append(union256, fmt.Sprintf("0198f4c8-8e50-7f66-8f70-%012x", 0x123456789000+i))
+	}
+	for i := 0; i < 128; i++ {
+		union256 = append(union256, fixtureDigest(fmt.Sprintf("union-%05d", i)))
