+		return err
+	}
+	if err := drive(`[]`); err != nil {
+		t.Fatalf("refused an empty array at the zero minimum: %v", err)
+	}
+	if err := drive(`[` + quote(fixtureQueryID) + `]`); err != nil {
+		t.Fatalf("refused a UUIDv7 member: %v", err)
