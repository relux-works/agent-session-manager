+
+// requireNullableBool requires the member to be null or a
+// boolean.
+func requireNullableBool(members map[string]json.RawMessage, name string) error {
+	if isNull(members[name]) {
+		return nil
+	}
+	_, err := requireBool(members, name)
+	return err
+}
