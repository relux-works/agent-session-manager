+// sortedEnvIDs builds n sorted unique environment identifiers.
+func sortedEnvIDs(n int) string {
+	parts := make([]string, 0, n)
+	for i := 0; i < n; i++ {
+		parts = append(parts, quote(fmt.Sprintf("e-%05d", i)))
+	}
+	return `[` + strings.Join(parts, ",") + `]`
+}
