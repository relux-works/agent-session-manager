{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c593","stream":{"kind":"session","id":"01a076d6-f373-7df3-9daa-01dcf5c60e7e"},"sequence":292,"recorded_at":1780531400000579,"record_type":"event","durability":"durable","causation_id":"e21886d8-c4f9-4aa7-9607-d62141b924ca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e21886d8-c4f9-4aa7-9607-d62141b924ca","run_stream":{"kind":"run","id":"e21886d8-c4f9-4aa7-9607-d62141b924ca"},"task_stream":{"kind":"task","id":"38401510-a037-4f52-8d4d-a0b116a5dba1"},"task_id":"38401510-a037-4f52-8d4d-a0b116a5dba1","event":{"kind":"output","task_id":"38401510-a037-4f52-8d4d-a0b116a5dba1","chunk":"{\n  \"chunk_id\": \"exec-15-1\",\n  \"command\": \"task-board worktree --help 2>&1 | head -30; echo \\\"===STORY-ACT===\\\"; task-board q 'activity(STORY-260830-3drr2m, limit=8, order=descending, view=effective)' --format json 2>&1 | python3 -c \\\"\\nimport json,sys\\nraw=sys.stdin.read()\\ntry:\\n  d=json.loads(raw)\\nexcept Exception:\\n  print('NON-JSON:', raw[:2000]); raise SystemExit\\nfor e in (d.get('events',[])):\\n  print('SEQ',e.get('sequence'),'OP',e.get('operation'),'TS',e.get('timestamp'))\\n  for c in e.get('changes',[]):\\n    print('  FIELD',c.get('field'))\\n    print('  AFTER',json.dumps(c.get('after'))[:800])\\n  print()\\n\\\" 2>&1 | head -60\",\n  \"description\": \"Check worktree command and story activity\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Inspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n===STORY-ACT===\\nSEQ 67 OP aggregation TS 2026-09-06T13:10:49.204111Z\\n  FIELD status\\n  AFTER {\\\"kind\\\": \\\"status\\\", \\\"status\\\": \\\"to-review\\\"}\\n\\nSEQ 66 OP aggregation TS 2026-09-06T13:09:59.483908Z\\n  FIELD status\\n  AFTER {\\\"kind\\\": \\\"status\\\", \\\"status\\\": \\\"development\\\"}\\n\\nSEQ 65 OP workspace TS 2026-09-06T13:09:52.887026Z\\n  FIELD ledger_event\\n  AFTER {\\\"kind\\\": \\\"ledger\\\", \\\"ledger\\\": {\\\"domain\\\": \\\"workspace\\\", \\\"ledger_id\\\": \\\"STORY-260830-3drr2m\\\", \\\"event\\\": \\\"lease_acquired\\\", \\\"sequence\\\": 6, \\\"recorded_at\\\": \\\"2026-09-06T13:09:52.874898Z\\\", \\\"facts\\\": [{\\\"name\\\": \\\"run\\\", \\\"kind\\\": \\\"id\\\", \\\"value\\\": \\\"RUN-260906-af7f6a\\\"}]}}\\n\\nSEQ 64 OP workspace TS 2026-09-06T13:09:52.245815Z\\n  FIELD ledger_event\\n  AFTER {\\\"kind\\\": \\\"ledger\\\", \\\"ledger\\\": {\\\"domain\\\": \\\"workspace\\\", \\\"ledger_id\\\": \\\"STORY-260830-3drr2m\\\", \\\"event\\\": \\\"lease_released\\\", \\\"sequence\\\": 5, \\\"recorded_at\\\": \\\"2026-09-06T13:09:52.241284Z\\\", \\\"facts\\\": [{\\\"name\\\": \\\"run\\\", \\\"kind\\\": \\\"id\\\", \\\"value\\\": \\\"RUN-260906-47efc2\\\"}]}}\\n\\nSEQ 63 OP aggregation TS 2026-09-06T13:09:09.280344Z\\n  FIELD status\\n  AFTER {\\\"kind\\\": \\\"status\\\", \\\"status\\\": \\\"to-review\\\"}\\n\\nSEQ 62 OP aggregation TS 2026-09-06T13:07:50.197438Z\\n  FIELD status\\n  AFTER {\\\"kind\\\": \\\"status\\\", \\\"status\\\": \\\"development\\\"}\\n\\nSEQ 61 OP workspace TS 2026-09-06T13:07:45.877504Z\\n  FIELD ledger_event\\n  AFTER {\\\"kind\\\": \\\"ledger\\\", \\\"ledger\\\": {\\\"domain\\\": \\\"workspace\\\", \\\"ledger_id\\\": \\\"STORY-260830-3drr2m\\\", \\\"event\\\": \\\"lease_acquired\\\", \\\"sequence\\\": 4, \\\"recorded_at\\\": \\\"2026-09-06T13:07:45.856936Z\\\", \\\"facts\\\": [{\\\"name\\\": \\\"run\\\", \\\"kind\\\": \\\"id\\\", \\\"value\\\": \\\"RUN-260906-47efc2\\\"}]}}\\n\\nSEQ 60 OP workspace TS 2026-09-06T13:07:45.235424Z\\n  FIELD ledger_event\\n  AFTER {\\\"kind\\\": \\\"ledger\\\", \\\"ledger\\\": {\\\"domain\\\": \\\"workspace\\\", \\\"ledger_id\\\": \\\"STORY-260830-3drr2m\\\", \\\"event\\\": \\\"lease_released\\\", \\\"sequence\\\": 3, \\\"recorded_at\\\": \\\"2026-09-06T13:07:45.230777Z\\\", \\\"facts\\\": [{\\\"name\\\": \\\"run\\\", \\\"kind\\\": \\\"id\\\", \\\"value\\\": \\\"RUN-260906-244967\\\"}]}}\\n\\n\",\n  \"original_output_bytes\": 3422,\n  \"original_output_tokens\": 856,\n  \"truncated\": false\n}"}}}
