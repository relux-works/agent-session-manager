{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bb","stream":{"kind":"session","id":"01a076d6-f373-7df3-9daa-01dcf5c60e7e"},"sequence":184,"recorded_at":1780531400000363,"record_type":"event","durability":"durable","causation_id":"e21886d8-c4f9-4aa7-9607-d62141b924ca","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e21886d8-c4f9-4aa7-9607-d62141b924ca","run_stream":{"kind":"run","id":"e21886d8-c4f9-4aa7-9607-d62141b924ca"},"task_stream":{"kind":"task","id":"ae2980a6-0df6-4a83-9e1b-46ca1c74bef5"},"task_id":"ae2980a6-0df6-4a83-9e1b-46ca1c74bef5","event":{"kind":"output","task_id":"ae2980a6-0df6-4a83-9e1b-46ca1c74bef5","chunk":"{\n  \"chunk_id\": \"exec-10-1\",\n  \"command\": \"task-board q 'schema(mutation=add_resource)' 2>&1 | head -30; echo \\\"===\\\"; task-board resource add --help 2>&1 | head -30\",\n  \"description\": \"Check resource mutation shape\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\\"description\\\":\\\"Add a text resource to an element\\\",\\\"destructive\\\":false,\\\"examples\\\":[\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"idempotent\\\":false,\\\"kind\\\":\\\"mutation\\\",\\\"name\\\":\\\"add_resource\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Resource content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"signature\\\":\\\"add_resource(id:string, name:string, content?:string, path?:string, type?:string{precondition|outcome}, description?:string)\\\"}\\n===\\nAttach a new file resource to a board element.\\n\\nSOURCE may be:\\n  - a local filesystem path\\n  - a file:// URL\\n  - an http:// or https:// URL\\n\\nExamples:\\n  task-board resource add TASK-260311-abc ./screenshot.png --type precondition\\n  task-board resource add TASK-260311-abc file:///tmp/report.pdf --name ui-report.pdf\\n  task-board resource add TASK-260311-abc ./report.md --name reports/review/report.md\\n  task-board resource add TASK-260311-abc https://example.com/spec.pdf --type outcome\\n\\nUsage:\\n  task-board resource add <ELEMENT-ID> <SOURCE> [flags]\\n\\nFlags:\\n  -d, --description string   Optional one-line description\\n  -h, --help                 help for add\\n      --name string          Override stored resource filename\\n      --type string          Resource type: precondition or outcome (default \\\"outcome\\\")\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2603,\n  \"original_output_tokens\": 651,\n  \"truncated\": false\n}"}}}
