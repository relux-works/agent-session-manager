{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c991","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":803,"recorded_at":1780531400001601,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"7115f162-ba39-4906-a4b9-39e4beff19fa"},"task_id":"7115f162-ba39-4906-a4b9-39e4beff19fa","event":{"kind":"output","task_id":"7115f162-ba39-4906-a4b9-39e4beff19fa","chunk":"Read text file `internal/dirnode/decode.go`.\n(99 line(s) above)\n100|\t\t\treturn true\n101|\t\t}\n102|\t\tindex += 1 + length\n103|\t\tif first >= 0xD800 && first <= 0xDBFF {\n104|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n105|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n106|\t\t\t\treturn true\n107|\t\t\t}\n108|\t\t\tindex += 6\n109|\t\t\tcontinue\n110|\t\t}\n111|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n112|\t\t\treturn true\n113|\t\t}\n114|\t}\n115|\treturn false\n116|}\n117|\n118|// readUTF16Escape reads four hex digits at the offset. It returns the\n119|// value and the consumed length, or a negative length when the escape\n120|// is truncated or not hexadecimal.\n121|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n122|\tif offset+4 > len(data) {\n123|\t\treturn 0, -1\n124|\t}\n125|\tvar value uint16\n126|\tfor _, digit := range data[offset : offset+4] {\n127|\t\tvalue <<= 4\n128|\t\tswitch {\n129|\t\tcase digit >= '0' && digit <= '9':\n130|\t\t\tvalue |= uint16(digit - '0')\n131|\t\tcase digit >= 'a' && digit <= 'f':\n132|\t\t\tvalue |= uint16(digit-'a') + 10\n133|\t\tcase digit >= 'A' && digit <= 'F':\n134|\t\t\tvalue |= uint16(digit-'A') + 10\n135|\t\tdefault:\n136|\t\t\treturn 0, -1\n137|\t\t}\n138|\t}\n139|\treturn value, 4\n140|}\n141|\n142|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n143|// at the offset. Anything else is a negative length.\n144|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n145|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n146|\t\treturn 0, -1\n147|\t}\n148|\treturn readUTF16Escape(data, offset+2)\n149|}\n150|\n151|// unknownMember names a member outside the closed set, if any. The\n152|// single-unknown fixtures keep the verdict deterministic: with\n153|// several unknowns the map order decides which is named, so tests\n154|// never assert a name from a multi-unknown body.\n155|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n156|\tfor name := range members {\n157|\t\tif !allowed[name] {\n158|\t\t\treturn name, true\n159|\t\t}\n160|\t}\n161|\treturn \"\", false\n162|}\n163|\n164|// missingMember names the first required member with no value, if\n165|// any. The required list is fixed order, so the verdict is\n166|// deterministic for every missing combination.\n167|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n168|\tfor _, name := range required {\n169|\t\tif _, present := members[name]; !present {\n170|\t\t\treturn name, true\n171|\t\t}\n172|\t}\n173|\treturn \"\", false\n174|}\n175|\n176|// rawString reads a JSON string member.\n177|func rawString(raw json.RawMessage) (string, bool) {\n178|\tvar value string\n179|\tif err := json.Unmarshal(raw, &value); err != nil {\n180|\t\treturn \"\", false\n181|\t}\n182|\treturn value, true\n183|}\n184|\n185|// rawBool reads a JSON boolean member.\n186|func rawBool(raw json.RawMessage) (bool, bool) {\n187|\tvar value bool\n188|\tif err := json.Unmarshal(raw, &value); err != nil {\n189|\t\treturn false, false\n190|\t}\n191|\treturn value, true\n192|}\n193|\n194|// rawUint53 reads an unsigned integral JSON number in [0, 2^