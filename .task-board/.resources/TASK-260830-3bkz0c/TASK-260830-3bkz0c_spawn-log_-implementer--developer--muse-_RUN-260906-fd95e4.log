{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c58d","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":289,"recorded_at":1780531400000573,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"b07d81a3-2429-4c3d-9583-24d943865854"},"task_id":"b07d81a3-2429-4c3d-9583-24d943865854","event":{"kind":"output","task_id":"b07d81a3-2429-4c3d-9583-24d943865854","chunk":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|//\n20|// CheckIdentity deliberately re-validates the record shape instead of\n21|// delegating to canonicaljson.validateProviderIdentityRecord: this\n22|// package must mint Section 15.1 provider-stdio refusals\n23|// (provider_protocol_error with member attribution), not identity\n24|// errors, and the shared package offers no such entry point. The two\n25|// validators must agree on the Section 5.5 shape rule for rule; the\n26|// decoder half of that agreement is pinned by the derived\n27|// TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON sweep, which\n28|// judges escape and raw-UTF-8 vectors through the shared\n29|// decodeStrictObject every entry here reads through, and any\n30|// shape-rule change must land in both validators in the same change.\n31|\n32|// identitySchema is the exact schema identifier the record carries.\n33|const identitySchema = \"urn:ax:schema:provider-identity\"\n34|\n35|// identitySchemaVersion is the only identity version accepted.\n36|const identitySchemaVersion = \"1.0.0\"\n37|\n38|// identityKinds is the closed identity-kind enum in section order.\n39|var identityKinds = []string{\n40|\t\"session_uuid\",\n41|\t\"session_path_or_id\",\n42|\t\"backend_conversation_uuid\",\n43|\t\"task_board_managed\",\n44|\t\"provider_defined\",\n45|}\n46|\n47|// identityMembers is the exact required member set of a Provider\n48|// Identity Record.\n49|var identityMembers = map[string]bool{\n50|\t\"schema\":                    true,\n51|\t\"schema_version\":            true,\n52|\t\"record_id\":                 true,\n53|\t\"subject_id\":                true,\n54|\t\"session_id\":                true,\n55|\t\"provider_id\":               true,\n56|\t\"provider_version\":          true,\n57|\t\"provider_version_range\":    true,\n58|\t\"native_session_id\":         true,\n59|\t\"identity_kind\":             true,\n60|\t\"logical_workspace_id\":      true,\n61|\t\"backend_realm_fingerprint\": true,\n62|\t\"opaque_identity\":           true,\n63|\t\"created_by_host_id\":        true,\n64|\t\"created_at\":                true,\n65|\t\"extensions\":                true,\n66|}\n67|\n68|// identityRequired lists identityMembers in a fixed order so a record\n69|// missing several members always names the same one.\n70|var identityRequired = []string{\n71|\t\"schema\",\n72|\t\"schema_version\",\n73|\t\"record_id\",\n74|\t\"subject_id\",\n75|\t\"session_id\",\n76|\t\"provider_id\",\n77|\t\"provider_version\",\n78|\t\"provider_version_range\",\n79|\t\"native_session_id\",\n80|\t\"identity_kind\",\n(more lines below)"}}}
