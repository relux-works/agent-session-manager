Every site carries exactly one row: a vector driven through the\n34|// production DecodeQuery entry that refuses (or, for one\n35|// classification site, admits). Roster fails closed in both\n36|// directions: a derived site with no row fails, and a row naming\n37|// a site production no longer derives fails as orphaned. One site\n38|// is defensive (defensiveObligations) with a structural tripwire,\n39|// not a vector.\n40|//\n41|// Resolution: each refusal vector violates exactly one sibling\n42|// obligation — every other member of its validator holds a valid\n43|// value — so two distinct obligations in one validator cannot both\n44|// satisfy one witness. The committed suite proves each vector\n45|// refuses through the production entry; the attached battery\n46|// proves narrowness by flipping each site alone and recording\n47|// which witnesses fail. Two structural overlaps are stated, not\n48|// hidden:\n49|//\n50|//   - framing gates (checkQueryOperation obligations 7-12):\n51|//     a gate fires exactly when its validator is false, so no\n52|//     vector can violate a gate without violating one obligation\n53|//     beneath it. Gate rows reuse a representative validator\n54|//     witness, documented per row; the battery shows the AND\n55|//     (the witness fails under both flips).\n56|//   - layered delegates (filters arms over checkEnumSubset and\n57|//     checkUUIDv7DigestSubset): a filters witness for a delegated\n58|//     shape necessarily violates the delegate obligation too.\n59|//     Those witnesses name both sites; the battery shows the pair.\n60|\n61|// defensiveObligations names derived sites no public input can\n62|// fire, with the bound that keeps them honest.\n63|var defensiveObligations = map[string]string{\n64|\t// checkQueryParameters obligation-1 fires only when the kind\n65|\t// registry and the parameter-member table disagree on a name:\n66|\t// checkQueryOperation admits only registry names, so through\n67|\t// the production entry the lookup always succeeds while the\n68|\t// tables agree. TestQueryParameterMembersMatchRegistry fails\n69|\t// when the tables diverge, which is exactly when this arm\n70|\t// becomes reachable; a mutant removing it is\n71|\t// behavior-preserving while the tables agree.\n72|\t\"query.go|checkQueryParameters|obligation-1\": \"fires only on registry divergence; pinned by the table-agreement tripwire\",\n73|}\n74|\n75|// deriveQueryObligations derives every false-returning site in\n76|// query.go from production source. A bare `return false` and a\n77|// `return <ZeroLit>, false` both count: both refuse the batch.\n78|// Anything else — expression returns, error returns — is outside\n79|// the obligation shape. An empty derivation fails closed.\n80|func deriveQueryObligations(t *testing.T) map[string]bool {\n81|\tt.Helper()\n82|\tsource, err := readQuerySource(t)\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"obligations: %v\", err)\n85|\t}\n86|\tsyntax, err := parseGoFile(\"query.go\", source)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"obligations: %v\", err)\n89|\t}\n90|\tsites := map[string]bool{}\n91|\tcounts := map[string]int{}\n92|\tast.Inspect(syntax, func(node ast.Node) bool {\n93|\t\tfunction, ok := node.(*ast.FuncDecl)\n94|\t\tif !ok || function.Body == nil {\n95|\t\t\treturn true\n96|\t\t}\n97|\t\tast.Inspect(function.Body, func(inner ast.Node) bool {\n98|\t\t\treturned, ok := inner.(*ast.ReturnStmt)\n99|\t\t\tif !ok {\n100|\t\t\t\treturn true\n101|\t\t\t}\n102|\t\t\tif len(returned.Results) == 0 {\n103|\t\t\t\treturn true\n104|\t\t\t}\n105|\t\t\tlast, ok := returned.Results[len(returned.Results)-1].(*ast.Ident)\n106|\t\t\tif !ok || last.Name != \"false\" {\n107|\t\t\t\treturn true\n108|\t\t\t}\n109|\t\t\tswitch len(returned.Results) {\n110|\t\t\tcase 1:\n111|\t\t\tcase 2:\n112|\t\t\t\tif _, ok := returned.Results[0].(*ast.CompositeLit); !ok {\n113|\t\t\t\t\treturn true\n114|\t\t\t\t}\n115|\t\t\tdefault:\n116|\t\t\t\treturn true\n117|\t\t\t}\n118|\t\t\tcounts[function.Name.Name]++\n119|\t\t\tsites[singleObligationKey(function.Name.Name, counts[function.Name.Name])] = true\n120|\t\t\treturn true\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53b","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":248,"recorded_at":1780531400000491,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"call_id":"call_01a075ffe708772087183b6a74a6f837","text":"Read text file `internal/dirnode/decode.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.9 and\n15|// 10.8.5 closed body. Every helper reports a verdict and never\n16|// refuses: all refusals call one of the refusal constructors\n17|// directly at the deciding site with literal details, so the\n18|// refusal-arm inventory keeps seeing every arm. A helper that\n19|// fronted a constructor would collapse distinct rules into one\n20|// obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer:\n23|// Section 7.9 counts and limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// frameFault is one strict-decode failure: what was wrong and which\n27|// member it was found in, if any. It never carries foreign bytes.\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|// decodeStrictObject parses one complete JSON object with duplicate\n34|// member rejection. It is the only JSON entry point in this package:\n35|// every body crosses it before any member is read. A non-UTF-8\n36|// frame, a lone surrogate escape, a non-object top level, a\n37|// duplicated member, or trailing data is a fault, never a partial\n38|// object the caller could mistake for a result.\n39|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n40|\tif !utf8.Valid(data) {\n41|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n42|\t}\n43|\tif hasLoneSurrogateEscape(data) {\n44|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n45|\t}\n46|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n47|\ttoken, err := decoder.Token()\n48|\tif err != nil {\n49|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n50|\t}\n51|\tdelim, ok := token.(json.Delim)\n52|\tif !ok || delim != '{' {\n53|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n54|\t}\n55|\tmembers := map[string]json.RawMessage{}\n56|\tfor decoder.More() {\n57|\t\tkeyToken, err := decoder.Token()\n58|\t\tif err != nil {\n59|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n60|\t\t}\n61|\t\tkey, ok := keyToken.(string)\n62|\t\tif !ok {\n63|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n64|\t\t}\n65|\t\tif _, duplicate := members[key]; duplicate {\n66|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n67|\t\t}\n68|\t\tvar raw json.RawMessage\n69|\t\tif err := decoder.Decode(&raw); err != nil {\n70|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n71|\t\t}\n72|\t\tmembers[key] = raw\n73|\t}\n74|\tif token, err := decoder.Token(); err != nil {\n75|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n76|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n77|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n78|\t}\n79|\tif _, err := decoder.Token(); err != io.EOF {\n80|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n81|\t}\n82|\treturn members, nil\n83|}\n84|\n85|// hasLoneSurrogateEscape reports whether the raw frame carries a\n86|// UTF-16 escape the JSON string grammar cannot pair. Go's\n87|// encoding/json would otherwise replace the lone escape with\n88|// U+FFFD silently, so wire bodies carrying lone surrogates would be\n89|// admitted with rewritten bytes.\n90|func hasLoneSurrogateEscape(data []byte) bool {\n91|\tfor index := 0; index < len(data); index++ {\n92|\t\tif data[index] != '\\\\' {\n93|\t\t\tcontinue\n94|\t\t}\n95|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n96|\t\t\tcontinue\n97|\t\t}\n98|\t\tfirst, length := readUTF16Escape(data, index+2)\n99|\t\tif length < 0 {\n100|\t\t\treturn true\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
