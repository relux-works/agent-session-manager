{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c797","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":550,"recorded_at":1780531400001095,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"bd33f38a-7a74-4691-be0c-75b6e37d3b73"},"task_id":"bd33f38a-7a74-4691-be0c-75b6e37d3b73","event":{"kind":"output","task_id":"bd33f38a-7a74-4691-be0c-75b6e37d3b73","chunk":"Read text file `internal/dirnode/decode.go`.\n(224 line(s) above)\n225|\t\tvalue = value*10 + uint64(digit-'0')\n226|\t\tif value > maxUint53 {\n227|\t\t\treturn 0, false\n228|\t\t}\n229|\t}\n230|\treturn value, true\n231|}\n232|\n233|// stringLength is the Section 1.6 string measure in characters, not\n234|// bytes.\n235|func stringLength(value string) int {\n236|\treturn utf8.RuneCountInString(value)\n237|}\n238|\n239|// checkStringBounds reports whether the member is a JSON string whose\n240|// character count falls in the inclusive bound.\n241|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n242|\tvalue, ok := rawString(raw)\n243|\tif !ok {\n244|\t\treturn \"\", false\n245|\t}\n246|\tlength := stringLength(value)\n247|\tif length < minimum || length > maximum {\n248|\t\treturn \"\", false\n249|\t}\n250|\treturn value, true\n251|}\n252|\n253|// checkUint53Bounds reports whether the member is a uint53 in the\n254|// inclusive bound. Both edges are checked: a one-sided check would\n255|// admit the open side.\n256|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n257|\tvalue, ok := rawUint53(raw)\n258|\tif !ok {\n259|\t\treturn 0, false\n260|\t}\n261|\tif value < minimum || value > maximum {\n262|\t\treturn 0, false\n263|\t}\n264|\treturn value, true\n265|}\n266|\n267|// checkDigest reports whether the member is a digest of the pinned\n268|// sha256 form.\n269|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n270|\tvalue, ok := rawString(raw)\n271|\tif !ok {\n272|\t\treturn scalar.Digest{}, false\n273|\t}\n274|\tdigest, err := scalar.ParseDigest(value)\n275|\tif err != nil {\n276|\t\treturn scalar.Digest{}, false\n277|\t}\n278|\treturn digest, true\n279|}\n280|\n281|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n282|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n283|\tvalue, ok := rawString(raw)\n284|\tif !ok {\n285|\t\treturn scalar.UUIDv7{}, false\n286|\t}\n287|\tidentifier, err := scalar.ParseUUIDv7(value)\n288|\tif err != nil {\n289|\t\treturn scalar.UUIDv7{}, false\n290|\t}\n291|\treturn identifier, true\n292|}\n293|\n294|// checkTimestamp reports whether the member is a pinned timestamp.\n295|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n296|\tvalue, ok := rawString(raw)\n297|\tif !ok {\n298|\t\treturn scalar.Timestamp{}, false\n299|\t}\n300|\tinstant, err := scalar.ParseTimestamp(value)\n301|\tif err != nil {\n302|\t\treturn scalar.Timestamp{}, false\n303|\t}\n304|\treturn instant, true\n305|}\n306|\n307|// checkDigestString reports whether the value parses as a digest of\n308|// the pinned form.\n309|func checkDigestString(value string) (string, bool) {\n310|\tdigest, err := scalar.ParseDigest(value)\n311|\tif err != nil {\n312|\t\treturn \"\", false\n313|\t}\n314|\treturn digest.String(), true\n315|}\n316|\n317|// isNull reports whether the member is an explicit JSON null.\n318|func isNull(raw json.RawMessage) bool {\n319|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n320|}\n321|\n322|// decodeArray reads a JSON array member into its raw elements. A\n323|// non-array — including null — is not an empty array.\n324|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool