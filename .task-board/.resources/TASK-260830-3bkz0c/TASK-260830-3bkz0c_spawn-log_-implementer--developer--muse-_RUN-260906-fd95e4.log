{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73b","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":504,"recorded_at":1780531400001003,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"bd715f0c-5827-4cb9-96a3-04033cc7a25e"},"task_id":"bd715f0c-5827-4cb9-96a3-04033cc7a25e","event":{"kind":"output","task_id":"bd715f0c-5827-4cb9-96a3-04033cc7a25e","chunk":"Read text file `internal/sessadapter/tuple.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Environment Tuple and the Supported\n11|// Environment Tuple Registry entry admission Section 7.8 rests on:\n12|// the probe and every state-bearing call carry an exact six-member\n13|// tuple, and target writes and healthy doctor results require an\n14|// accepted non-revoked signed entry whose key equals the\n15|// host-observed execution facts.\n16|//\n17|// The registry publication rules — detached signature, monotonic\n18|// sequence, validity of the registry envelope itself — fail closed\n19|// at the registry owner, which does not exist yet; this package\n20|// admits single entries against caller-held registry facts and\n21|// states that bound in doc.go.\n22|\n23|// tupleMembers is the exact Environment Tuple member set Section 7.8\n24|// requires: environment_id, environment_version, platform,\n25|// architecture, store_schema_fingerprint, and adapter_version. The\n26|// tuple never contains executable provenance, and — unlike every\n27|// neighbouring closed type — it carries no extensions member, so\n28|// even a reverse-DNS extensions object is refused here.\n29|var tupleMembers = map[string]bool{\n30|\t\"environment_id\":           true,\n31|\t\"environment_version\":      true,\n32|\t\"platform\":                 true,\n33|\t\"architecture\":             true,\n34|\t\"store_schema_fingerprint\": true,\n35|\t\"adapter_version\":          true,\n36|}\n37|\n38|// tupleRequired lists tupleMembers in a fixed order.\n39|var tupleRequired = []string{\n40|\t\"environment_id\",\n41|\t\"environment_version\",\n42|\t\"platform\",\n43|\t\"architecture\",\n44|\t\"store_schema_fingerprint\",\n45|\t\"adapter_version\",\n46|}\n47|\n48|// Tuple is one validated Environment Tuple.\n49|type Tuple struct {\n50|\tEnvironmentID    string\n51|\tVersion          string\n52|\tPlatform         string\n53|\tArchitecture     string\n54|\tStoreFingerprint string\n55|\tAdapterVersion   string\n56|}\n57|\n58|// DecodeTuple validates one closed Environment Tuple: exact\n59|// members, the environment-id grammar, environment_version as\n60|// string[1..128] (the bound Section 10.8.1 states for the\n61|// observation that reuses this admission model), the closed\n62|// platform and architecture vocabularies, a digest store\n63|// fingerprint, and a SemVer adapter version. Any executable\n64|// provenance member is an unknown member, never a second identity.\n65|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n66|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n67|\tif fault != nil {\n68|\t\tfailure, err := failProtocol(\"environment tuple \"+fault.detail, fault.member)\n69|\t\tif err != nil {\n70|\t\t\treturn Tuple{}, err\n71|\t\t}\n72|\t\treturn Tuple{}, failure\n73|\t}\n74|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n75|\t\tfailure, err := failProtocol(\"environment tuple carries unknown member\", name)\n76|\t\tif err != nil {\n77|\t\t\treturn Tuple{}, err\n78|\t\t}\n79|\t\treturn Tuple{}, failure\n80|\t}\n81|\tif name, missing := missingMember(members, tupleRequired); missing {\n82|\t\tfailure, err := failProtocol(\"environment tuple misses a required member\", name)\n83|\t\tif err != nil {\n84|\t\t\treturn Tuple{}, err\n85|\t\t}\n86|\t\treturn Tuple{}, failure\n87|\t}\n88|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n89|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n90|\t\tfailure, err := failProtocol(\"environment tuple environment identifier is not an environment-id\", \"environment_id\")\n91|\t\tif err != nil {\n92|\t\t\treturn Tuple{}, err\n93|\t\t}\n94|\t\treturn Tuple{}, failure\n95|\t}\n96|\tversion, ok := checkStringBounds(members[\"environment_version\"], 1, 128)\n97|\tif !ok {\n98|\t\tfailure, err := failProtocol(\"environment tuple environment version is not a string[1..128]\", \"environment_version\")\n99|\t\tif err != nil {\n100|\t\t\treturn Tuple{}, err\n101|\t\t}\n102|\t\treturn Tuple{}, failure\n103|\t}\n104|\tplatform, ok := rawString(members[\"platform\"])\n105|\tif !ok {\n106|\t\tfailure, err := failProtocol(\"environment tuple platform is not a string\", \"platform\")\n107|\t\tif err != nil {\n108|\t\t\treturn Tuple{}, err\n109|\t\t}\n110|\t\treturn Tuple{}, failure\n111|\t}\n112|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n113|\t\tfailure, faultErr := failProtocol(\"environment tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n114|\t\tif faultErr != nil {\n115|\t\t\treturn Tuple{}, faultErr\n116|\t\t}\n117|\t\treturn Tuple{}, failure\n118|\t}\n119|\tarchitecture, ok := rawString(members[\"architecture\"])\n120|\tif !ok || !validTupleArchitecture(architecture) {\n(more lines below)"}}}
