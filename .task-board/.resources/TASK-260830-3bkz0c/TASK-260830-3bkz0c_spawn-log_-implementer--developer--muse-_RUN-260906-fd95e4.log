\\t}\\n\\t\\treturn \\\"\\\", failure\\n\\t}\\n\\tif !profileNames[profile] {\\n\\t\\tfailure, err := failInvalid(\\\"profile mapping names an unknown profile\\\")\\n\\t\\tif err != nil {\\n\\t\\t\\treturn \\\"\\\", err\\n\\t\\t}\\n\\t\\treturn \\\"\\\", failure\\n\\t}\\n\\tif profile == ProfileYOLO {\\n\\t\\treturn mapping, nil\\n\\t}\\n\\treturn \\\"\\\", nil\\n}\\n\",\n  \"original_output_bytes\": 1227,\n  \"original_output_tokens\": 307,\n  \"truncated\": false\n}"}}}
