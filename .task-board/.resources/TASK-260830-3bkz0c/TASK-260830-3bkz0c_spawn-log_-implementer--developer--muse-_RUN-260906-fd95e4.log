, so characters are runes,\\n// not bytes and not code units.\\nfunc runeLength(value string) int {\\n\\treturn utf8.RuneCountInString(value)\\n}\\n\\n// isDigest reports whether the value parses as a content digest.\\nfunc isDigest(value string) bool {\\n\\t_, err := scalar.ParseDigest(value)\\n\\treturn err == nil\\n}\\n\\n// isUUIDv7 reports whether the value parses as a UUIDv7.\\nfunc isUUIDv7(value string) bool {\\n\\t_, err := scalar.ParseUUIDv7(value)\\n\\treturn err == nil\\n}\\n\\n// isTimestamp reports whether the value parses as a timestamp.\\nfunc isTimestamp(value string) bool {\\n\\t_, err := scalar.ParseTimestamp(value)\\n\\treturn err == nil\\n}\\n===sessadapter env handling===\\ninternal/sessadapter/context.go:172:\\t\\tredacted, err := json.Marshal(body)\\ninternal/sessadapter/context.go:176:\\t\\tcanonical, err = canonicaljson.Canonicalize(redacted)\\ninternal/dirnode/manifest.go:95:\\t\\\"redaction_policy_ids\\\":            true,\\ninternal/dirnode/manifest.go:117:\\t\\\"redaction_policy_ids\\\",\\ninternal/dirnode/manifest.go:384:\\tredaction, ok := checkSortedUniqueDigests(members[\\\"redaction_policy_ids\\\"], 1, 64)\\ninternal/dirnode/manifest.go:386:\\t\\tfailure, err := failViolation(\\\"node manifest redaction policies are not sorted unique digest[1..64]\\\", \\\"redaction_policy_ids\\\")\\ninternal/dirnode/manifest.go:435:\\t\\tRedactionPolicyIDs:     digestStrings(redaction),\\ninternal/provhost/spawn.go:24:\\t\\\"env_names\\\":         true,\\ninternal/provhost/spawn.go:25:\\t\\\"env_literals\\\":      true,\\ninternal/provhost/spawn.go:36:\\t\\\"env_names\\\",\\ninternal/provhost/spawn.go:37:\\t\\\"env_literals\\\",\\ninternal/provhost/spawn.go:86:\\tnames, err := checkSpawnEnvNames(members[\\\"env_names\\\"])\\ninternal/provhost/spawn.go:90:\\tif err := checkSpawnEnvLiterals(members[\\\"env_literals\\\"], names); err != nil {\\ninternal/provhost/spawn.go:167:// validEnvName reports whether the name satisfies the Section 5.1\\ninternal/provhost/spawn.go:169:func validEnvName(name string) bool {\\ninternal/provhost/spawn.go:183:// checkSpawnEnvNames enforces sorted unique environment names\\ninternal/provhost/spawn.go:185:func checkSpawnEnvNames(raw json.RawMessage) ([]string, error) {\\ninternal/provhost/spawn.go:188:\\t\\tfailure, err := failProtocol(\\\"spawn env_names exceed 64 entries\\\", \\\"env_names\\\")\\ninternal/provhost/spawn.go:195:\\t\\tif !validEnvName(name) {\\ninternal/provhost/spawn.go:196:\\t\\t\\tfailure, err := failProtocol(\\\"spawn env_names are not environment names\\\", \\\"env_names\\\")\\ninternal/provhost/spawn.go:204:\\t\\tfailure, err := failProtocol(\\\"spawn env_names are not sorted unique\\\", \\\"env_names\\\")\\ninternal/provhost/spawn.go:213:// checkSpawnEnvLiterals enforces the literal map: at most 64\\ninternal/provhost/spawn.go:214:// entries, environment-name keys disjoint from env_names, string\\ninternal/provhost/spawn.go:217:func checkSpawnEnvLiterals(raw json.RawMessage, names []string) error {\\ninternal/provhost/spawn.go:227:\\t\\tfailure, err := failProtocol(\\\"spawn env_literals exceed 64 entries\\\", \\\"env_literals\\\")\\ninternal/provhost/spawn.go:238:\\t\\tif !validEnvName(key) || inherited[key] {\\ninternal/provhost/spawn.go:239:\\t\\t\\tfailure, err := failProtocol(\\\"spawn env_literal key is not disjoint\\\", \\\"env_literals\\\")\\ninternal/provhost/spawn.go:247:\\t\\t\\tfailure, err := failProtocol(\\\"spawn env_literal is not at most 4096 NUL-free bytes\\\", \\\"env_literals\\\")\\n\",\n  \"original_output_bytes\": 4058,\n  \"original_output_tokens\": 1015,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
