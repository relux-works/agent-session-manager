{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73f","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":506,"recorded_at":1780531400001007,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"5687661d-0c2e-4b8a-8e7f-c6609d238fbb"},"task_id":"5687661d-0c2e-4b8a-8e7f-c6609d238fbb","event":{"kind":"output","task_id":"5687661d-0c2e-4b8a-8e7f-c6609d238fbb","chunk":"Read text file `internal/dirnode/probe.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.9 probe operation in both\n8|// majors: the closed request body with its per-major platform\n9|// vocabulary, and the closed success body with the node-build\n10|// equality gate against the validated manifest.\n11|//\n12|// The probe row the operation table shows is the Request 2.0.0\n13|// form; Request 1.0.0 differs only in its closed legacy platform\n14|// vocabulary from the major-binding table. A v1 darwin request\n15|// denotes the macOS host class of that published major, but darwin\n16|// is not a valid v2 wire value and never appears in an Environment\n17|// Observation; a v1 request cannot express WSL2. The host validates\n18|// the vocabulary belonging to the negotiated major and never\n19|// relabels, reinterprets, or coerces a token across majors.\n20|\n21|// platformV1 is the closed Request 1.0.0 platform vocabulary.\n22|var platformV1 = []string{\n23|\t\"darwin\",\n24|\t\"linux\",\n25|\t\"windows\",\n26|}\n27|\n28|// platformV2 is the closed Request 2.0.0 platform vocabulary.\n29|var platformV2 = []string{\n30|\t\"macos\",\n31|\t\"linux\",\n32|\t\"wsl2\",\n33|\t\"windows\",\n34|}\n35|\n36|// architectures is the closed probe architecture vocabulary under\n37|// either major.\n38|var architectures = []string{\n39|\t\"amd64\",\n40|\t\"arm64\",\n41|}\n42|\n43|// validPlatformForMajor reports whether the platform token belongs\n44|// to the negotiated major's vocabulary. Both vocabularies are table\n45|// loops so the census derives them like every other closed\n46|// vocabulary: an inline chain here would be invisible to the\n47|// census, and a widened chain would silently admit a cross-major\n48|// token.\n49|func validPlatformForMajor(major int, platform string) bool {\n50|\tswitch major {\n51|\tcase MajorV1:\n52|\t\tfor _, allowed := range platformV1 {\n53|\t\t\tif platform == allowed {\n54|\t\t\t\treturn true\n55|\t\t\t}\n56|\t\t}\n57|\t\treturn false\n58|\tcase MajorV2:\n59|\t\tfor _, allowed := range platformV2 {\n60|\t\t\tif platform == allowed {\n61|\t\t\t\treturn true\n62|\t\t\t}\n63|\t\t}\n64|\t\treturn false\n65|\tdefault:\n66|\t\treturn false\n67|\t}\n68|}\n69|\n70|// validArchitecture reports whether the architecture token is a\n71|// registry member.\n72|func validArchitecture(architecture string) bool {\n73|\tfor _, allowed := range architectures {\n74|\t\tif architecture == allowed {\n75|\t\t\treturn true\n76|\t\t}\n77|\t}\n78|\treturn false\n79|}\n80|\n(more lines below)"}}}
