{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb99","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":1063,"recorded_at":1780531400002121,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"call_id":"call_01a07605cd3075a385429cb827ee3b99","text":"Read text file `internal/sessadapter/surrogate_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|)\n9|\n10|// TestLoneSurrogateSweep drives every UTF-16 escape that can stand\n11|// alone through the strict decoder: all 2048 lone surrogates (high\n12|// and low) in upper, lower, and mixed hex case must refuse, and\n13|// every escape is generated, never listed. The verdict for each\n14|// vector comes from construction — the vector names a lone\n15|// surrogate by construction — not from either implementation, so\n16|// the corpus cannot drift with a mutated gate the way a 13-value\n17|// hand list did.\n18|func TestLoneSurrogateSweep(t *testing.T) {\n19|\tcases := []string{\"%04X\", \"%04x\", \"%02X%02x\"}\n20|\trefused := 0\n21|\tfor surrogate := 0xD800; surrogate <= 0xDFFF; surrogate++ {\n22|\t\tfor _, form := range cases {\n23|\t\t\tframe := []byte(fmt.Sprintf(`{\"member\":\"A\\u`+form+`B\"}`, surrogate))\n24|\t\t\tif _, fault := decodeStrictObject(frame); fault == nil {\n25|\t\t\t\tt.Fatalf(\"decodeStrictObject admitted lone surrogate U+%04X\", surrogate)\n26|\t\t\t} else if fault.detail != \"lone surrogate escape\" {\n27|\t\t\t\tt.Fatalf(\"lone surrogate U+%04X fault = %q, want the surrogate gate\", surrogate, fault.detail)\n28|\t\t\t}\n29|\t\t\trefused++\n30|\t\t}\n31|\t}\n32|\t// A high surrogate followed by a low surrogate admits; a high\n33|\t// followed by a non-low, and a low standing first, refuse.\n34|\tpaired := []byte(`{\"member\":\"A\\uD83D\\uDE00B\"}`)\n35|\tif _, fault := decodeStrictObject(paired); fault != nil {\n36|\t\tt.Fatalf(\"decodeStrictObject refused a paired surrogate: %v\", fault.detail)\n37|\t}\n38|\tunpairedHigh := []byte(`{\"member\":\"A\\uD83D\\u0041B\"}`)\n39|\tif _, fault := decodeStrictObject(unpairedHigh); fault == nil {\n40|\t\tt.Fatal(\"decodeStrictObject admitted a high surrogate followed by a non-low\")\n41|\t}\n42|\t// Truncated and non-hex escapes refuse through the same gate.\n43|\tfor _, frame := range []string{`{\"member\":\"A\\uD83B\"}`, `{\"member\":\"A\\uDEFG B\"}`, `{\"member\":\"A\\uD83D\"}`} {\n44|\t\tif _, fault := decodeStrictObject([]byte(frame)); fault == nil {\n45|\t\t\tt.Fatalf(\"decodeStrictObject admitted %q\", frame)\n46|\t\t}\n47|\t}\n48|\tt.Logf(\"surrogate sweep: %d lone vectors refused\", refused)\n49|}\n50|\n51|// TestSurrogatePairSweep drives the second escape of every high\n52|// surrogate across the low-surrogate range and both adjacent code\n53|// points: for each of the 1024 high surrogates the second escape\n54|// takes the values just below the low range, both low edges, and\n55|// just above it, so an off-by-one on either bound admits a vector\n56|// this corpus refuses by construction. A full low-range sweep for\n57|// the first, middle, and last high surrogate proves the interior\n58|// admits. Every verdict comes from construction — the vector\n59|// names its pair shape from range literals written here, not from\n60|// either implementation — so a mutated production bound cannot\n61|// take the fixture with it.\n62|func TestSurrogatePairSweep(t *testing.T) {\n63|\tconst highLo, highHi = 0xD800, 0xDBFF\n64|\tconst lowLo, lowHi = 0xDC00, 0xDFFF\n65|\trefused, admitted := 0, 0\n66|\tcheck := func(high, second int, form string) {\n67|\t\tt.Helper()\n68|\t\tframe := []byte(fmt.Sprintf(`{\"member\":\"A\\u`+form+`\\u`+form+`B\"}`, high, second))\n69|\t\t_, fault := decodeStrictObject(frame)\n70|\t\tif pair := second >= lowLo && second <= lowHi; pair {\n71|\t\t\tif fault != nil {\n72|\t\t\t\tt.Fatalf(\"decodeStrictObject refused valid pair U+%04X U+%04X: %v\", high, second, fault.detail)\n73|\t\t\t}\n74|\t\t\tadmitted++\n75|\t\t\treturn\n76|\t\t}\n77|\t\tif fault == nil {\n78|\t\t\tt.Fatalf(\"decodeStrictObject admitted lone high surrogate U+%04X followed by U+%04X\", high, second)\n79|\t\t}\n80|\t\tif fault.detail != \"lone surrogate escape\" {\n81|\t\t\tt.Fatalf(\"pair U+%04X U+%04X fault = %q, want the surrogate gate\", high, second, fault.detail)\n82|\t\t}\n83|\t\trefused++\n84|\t}\n85|\tfor high := highLo; high <= highHi; high++ {\n86|\t\tfor _, second := range []int{lowLo - 1, lowLo, lowHi, lowHi + 1} {\n87|\t\t\tcheck(high, second, \"%04X\")\n88|\t\t}\n89|\t}\n90|\t// Lowercase spot checks prove the hex case never moves the\n91|\t// bound: the edges refuse and admit identically.\n92|\tfor _, second := range []int{lowLo - 1, lowLo, lowHi, lowHi + 1} {\n93|\t\tcheck(highLo, second, \"%04x\")\n94|\t\tcheck(highHi, second, \"%04x\")\n95|\t}\n96|\t// Full-range interior for three representative highs: every\n97|\t// low second admits, and the neighbours just outside refuse.\n98|\tfor _, high := range []int{highLo, (highLo + highHi) / 2, highHi} {\n99|\t\tfor second := lowLo - 1; second <= lowHi+1; second++ {\n100|\t\t\tcheck(high, second, \"%04X\")\n101|\t\t}\n102|\t}\n103|\tt.Logf(\"surrogate pair sweep: %d refused, %d admitted\", refused, admitted)\n104|}\n105|\n106|// TestSurrogateGateAgreesWithCanonicalJSON pins the local gate\n107|// against the shared implementation over generated vectors: every\n108|// BMP escape in both hex cases, every surrogate pair shape, and\n109|// raw non-surrogate multibyte text. Agreement is a consistency\n110|// pin, not the verdict: the verdicts above come from\n111|// construction.\n112|func TestSurrogateGateAgreesWithCanonicalJSON(t *testing.T) {\n113|\tchecked := 0\n114|\tfor code := 0; code < 0xD800; code += 0x217 {\n115|\t\tfor _, frame := range []string{\n116|\t\t\tfmt.Sprintf(`{\"member\":\"A\\u%04XB\"}`, code),\n117|\t\t\tfmt.Sprintf(`{\"member\":\"A\\u%04xB\"}`, code),\n118|\t\t} {\n119|\t\t\t_, localFault := decodeStrictObject([]byte(frame))\n120|\t\t\t_, sharedErr := canonicaljson.Canonicalize([]byte(frame))\n121|\t\t\tif (localFault != nil) != (sharedErr != nil) {\n122|\t\t\t\tt.Fatalf(\"disagreement on U+%04X: local=%v shared=%v\", code, localFault, sharedErr)\n123|\t\t\t}\n124|\t\t\tchecked++\n125|\t\t}\n126|\t}\n127|\tfor _, frame := range []string{\n128|\t\t`{\"member\":\"plain ascii\"}`,\n129|\t\t`{\"member\":\"ü é ☃\"}`,\n130|\t\t`{\"member\":\"A\\uD83D\\uDE00B\"}`,\n131|\t\t`{\"member\":\"A\\ud800B\"}`,\n132|\t\t`{\"member\":\"A\\udc00B\"}`,\n133|\t} {\n134|\t\t_, localFault := decodeStrictObject([]byte(frame))\n135|\t\t_, sharedErr := canonicaljson.Canonicalize([]byte(frame))\n136|\t\tlocalRefuses := localFault != nil\n137|\t\tsharedRefuses := sharedErr != nil\n138|\t\t// The shared canonicalizer accepts lone surrogates it\n139|\t\t// encodes losslessly; the local gate refuses them by\n140|\t\t// rule. Agreement is required only where both must\n141|\t\t// accept: valid text and paired surrogates.\n142|\t\tif !localRefuses && sharedRefuses {\n143|\t\t\tt.Fatalf(\"local gate admits what canonical JSON refuses: %q\", frame)\n144|\t\t}\n145|\t\tchecked++\n146|\t}\n147|\tt.Logf(\"agreement sweep: %d vectors compared\", checked)\n148|}\n149|\n150|// TestNonUTF8NeverDecodes proves raw non-UTF-8 bytes refuse before\n151|// any member is read: overlong encodings, truncated sequences,\n152|// and encoded surrogates (WTF-8) are failures, never rewritten\n153|// text.\n154|func TestNonUTF8NeverDecodes(t *testing.T) {\n155|\tframes := [][]byte{\n156|\t\t{0x7b, 0x22, 0x6d, 0x22, 0x3a, 0xff, 0x7d},\n157|\t\t[]byte(\"{\\\"m\\\":\\\"a\\xed\\xa0\\x80b\\\"}\"),\n158|\t\t[]byte(\"{\\\"m\\\":\\\"a\\xc0\\xafb\\\"}\"),\n159|\t\t[]byte(\"{\\\"m\\\":\\\"a\\xe2\\x82b\\\"}\"),\n160|\t}\n161|\tfor index, frame := range frames {\n162|\t\tif _, fault := decodeStrictObject(frame); fault == nil {\n163|\t\t\tt.Fatalf(\"decodeStrictObject admitted non-UTF-8 frame %d\", index)\n164|\t\t} else if fault.detail != \"not valid UTF-8\" {\n165|\t\t\tt.Fatalf(\"frame %d fault = %q, want the UTF-8 gate\", index, fault.detail)\n166|\t\t}\n167|\t}\n168|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
