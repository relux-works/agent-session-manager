4c8-4a10-7b22-8b3c-1234567890ab\\\",\\n  \\\"created_at\\\": \\\"2026-08-19T04:09:45.000Z\\\",\\n  \\\"extensions\\\": {}\\n}`\\n\\nfunc judge(name string, body []byte) {\\n\\tprovErr := provhost.CheckIdentity(body, \\\"antigravity\\\")\\n\\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(body)\\n\\tfmt.Printf(\\\"%-28s provhost.refuse=%-5v canonical.refuse=%-5v\\\\n\\\", name, provErr != nil, canonErr != nil)\\n\\tif (provErr != nil) != (canonErr != nil) {\\n\\t\\tfmt.Printf(\\\"   DIVERGENCE provhost=%v\\\\n   DIVERGENCE canonical=%v\\\\n\\\", provErr, canonErr)\\n\\t}\\n}\\n\\nfunc main() {\\n\\tjudge(\\\"valid\\\", []byte(specIdentityExample))\\n\\tjudge(\\\"backslash-u text opaque\\\", []byte(strings.Replace(specIdentityExample, `\\\"opaque_identity\\\": {}`, `\\\"opaque_identity\\\": {\\\"k\\\": \\\"\\\\\\\\\\\\\\\\ud800\\\"}`, 1)))\\n\\tjudge(\\\"real lone opaque\\\", []byte(strings.Replace(specIdentityExample, `\\\"opaque_identity\\\": {}`, `\\\"opaque_identity\\\": {\\\"k\\\": \\\"A\\\\ud800B\\\"}`, 1)))\\n\\tjudge(\\\"unknown kind\\\", []byte(strings.Replace(specIdentityExample, `\\\"backend_conversation_uuid\\\"`, `\\\"telepathy\\\"`, 1)))\\n\\tjudge(\\\"null realm antigravity\\\", []byte(strings.Replace(specIdentityExample, `\\\"backend_realm_fingerprint\\\": \\\"sha256:aaaa`, `\\\"backend_realm_fingerprint\\\": null, \\\"x\\\": \\\"sha256:aaaa`, 1)))\\n\\tjudge(\\\"128e version\\\", []byte(strings.Replace(specIdentityExample, `\\\"provider_version\\\": \\\"1.1.14\\\"`, `\\\"provider_version\\\": \\\"`+strings.Repeat(\\\"é\\\", 128)+`\\\"`, 1)))\\n\\tjudge(\\\"129e version\\\", []byte(strings.Replace(specIdentityExample, `\\\"provider_version\\\": \\\"1.1.14\\\"`, `\\\"provider_version\\\": \\\"`+strings.Repeat(\\\"é\\\", 129)+`\\\"`, 1)))\\n}\\nEOF\\ngo run ./tmp-probe 2>&1 | head -n 30; rm -rf tmp-probe\",\n  \"description\": \"Probe identity validator agreement\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"valid                        provhost.refuse=false canonical.refuse=false\\nbackslash-u text opaque      provhost.refuse=true  canonical.refuse=true \\nreal lone opaque             provhost.refuse=true  canonical.refuse=true \\nunknown kind                 provhost.refuse=true  canonical.refuse=true \\nnull realm antigravity       provhost.refuse=true  canonical.refuse=true \\n128e version                 provhost.refuse=false canonical.refuse=false\\n129e version                 provhost.refuse=true  canonical.refuse=true \\n\",\n  \"original_output_bytes\": 518,\n  \"original_output_tokens\": 130,\n  \"truncated\": false\n}"}}}
