{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"3a5500e4-d82f-402b-89a9-2ca464b91131"},"task_id":"3a5500e4-d82f-402b-89a9-2ca464b91131","event":{"kind":"output","task_id":"3a5500e4-d82f-402b-89a9-2ca464b91131","chunk":"Read text file `internal/dirnode/decode.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.9 and\n15|// 10.8.5 closed body. Every helper reports a verdict and never\n16|// refuses: all refusals call one of the refusal constructors\n17|// directly at the deciding site with literal details, so the\n18|// refusal-arm inventory keeps seeing every arm. A helper that\n19|// fronted a constructor would collapse distinct rules into one\n20|// obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer:\n23|// Section 7.9 counts and limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// frameFault is one strict-decode failure: what was wrong and which\n27|// member it was found in, if any. It never carries foreign bytes.\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|// decodeStrictObject parses one complete JSON object with duplicate\n34|// member rejection. It is the only JSON entry point in this package:\n35|// every body crosses it before any member is read. A non-UTF-8\n36|// frame, a lone surrogate escape, a non-object top level, a\n37|// duplicated member, or trailing data is a fault, never a partial\n38|// object the caller could mistake for a result.\n39|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n40|\tif !utf8.Valid(data) {\n41|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n42|\t}\n43|\tif hasLoneSurrogateEscape(data) {\n44|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n45|\t}\n46|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n47|\ttoken, err := decoder.Token()\n48|\tif err != nil {\n49|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n50|\t}\n51|\tdelim, ok := token.(json.Delim)\n52|\tif !ok || delim != '{' {\n53|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n54|\t}\n55|\tmembers := map[string]json.RawMessage{}\n56|\tfor decoder.More() {\n57|\t\tkeyToken, err := decoder.Token()\n58|\t\tif err != nil {\n59|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n60|\t\t}\n61|\t\tkey, ok := keyToken.(string)\n62|\t\tif !ok {\n63|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n64|\t\t}\n65|\t\tif _, duplicate := members[key]; duplicate {\n66|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n67|\t\t}\n68|\t\tvar raw json.RawMessage\n69|\t\tif err := decoder.Decode(&raw); err != nil {\n70|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n71|\t\t}\n72|\t\tmembers[key] = raw\n73|\t}\n74|\tif token, err := decoder.Token(); err != nil {\n75|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n76|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n77|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n78|\t}\n79|\tif _, err := decoder.Token(); err != io.EOF {\n80|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n81|\t}\n82|\treturn members, nil\n83|}\n84|\n85|// hasLoneSurrogateEscape reports whether the raw frame carries a\n86|// UTF-16 escape the JSON string grammar cannot pair. Go's\n87|// encoding/json would otherwise replace the lone escape with\n88|// U+FFFD silently, so wire bodies carrying lone surrogates would be\n89|// admitted with rewritten bytes.\n90|func hasLoneSurrogateEscape(data []byte) bool {\n91|\tfor index := 0; index < len(data); index++ {\n92|\t\tif data[index] != '\\\\' {\n93|\t\t\tcontinue\n94|\t\t}\n95|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n96|\t\t\tcontinue\n97|\t\t}\n98|\t\tfirst, length := readUTF16Escape(data, index+2)\n99|\t\tif length < 0 {\n100|\t\t\treturn true\n(more lines below)"}}}
