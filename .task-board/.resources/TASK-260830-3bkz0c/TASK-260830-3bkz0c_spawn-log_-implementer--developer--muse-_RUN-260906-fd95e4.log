{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000da41","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":2939,"recorded_at":1780531400005873,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"6f53528c-22d6-4222-bf79-b89788427788"},"task_id":"6f53528c-22d6-4222-bf79-b89788427788","event":{"kind":"output","task_id":"6f53528c-22d6-4222-bf79-b89788427788","chunk":"Read text file `internal/provhost/identity.go`.\n(208 line(s) above)\n209|\t\t\treturn err\n210|\t\t}\n211|\t\treturn failure\n212|\t}\n213|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n214|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n215|\t\tif err != nil {\n216|\t\t\treturn err\n217|\t\t}\n218|\t\treturn failure\n219|\t}\n220|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n221|\t\treturn err\n222|\t}\n223|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n224|\t\treturn err\n225|\t}\n226|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n227|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n234|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n235|\t\tif err != nil {\n236|\t\t\treturn err\n237|\t\t}\n238|\t\treturn failure\n239|\t}\n240|\tif !isJSONObject(members[\"extensions\"]) {\n241|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n242|\t\tif err != nil {\n243|\t\t\treturn err\n244|\t\t}\n245|\t\treturn failure\n246|\t}\n247|\treturn nil\n248|}\n249|\n250|// checkIdentityRealm enforces the digest-or-null shape and the one\n251|// conditional rule Section 5.5 states: an Antigravity\n252|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n253|// because the backend realm is a resume precondition there.\n254|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n255|\trealm, isNull, ok := rawNullableString(raw)\n256|\tif !ok || (!isNull && !isDigest(realm)) {\n257|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n258|\t\tif err != nil {\n259|\t\t\treturn err\n260|\t\t}\n261|\t\treturn failure\n262|\t}\n263|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n264|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n265|\t\tif err != nil {\n266|\t\t\treturn err\n267|\t\t}\n268|\t\treturn failure\n269|\t}\n270|\treturn nil\n271|}\n272|\n273|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n274|// object of at most 32 entries, keyed by the provider-identity key\n275|// grammar, with non-secret string values of 1..1,024 characters that\n276|// MUST NOT begin with an absolute path.\n277|func checkIdentityOpaque(raw json.RawMessage) error {\n278|\topaque, fault := decodeStrictObject(raw)\n279|\tif fault != nil {\n280|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n281|\t\tif err != nil {\n282|\t\t\treturn err\n283|\t\t}\n284|\t\treturn failure\n285|\t}\n286|\tif len(opaque) > 32 {\n287|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n288|\t\tif err != nil {\n289|\t\t\treturn err\n290|\t\t}\n291|\t\treturn failure\n292|\t}\n293|\tkeys := make([]string, 0, len(opaque))\n294|\tfor key := range opaque {\n295|\t\tkeys = append(keys, key)\n296|\t}\n297|\tfor _, key := range keys {\n298|\t\tif !identityKeyPattern.MatchString(key) {\n299|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n300|\t\t\tif err != nil {\n301|\t\t\t\treturn err\n302|\t\t\t}\n303|\t\t\treturn failure\n304|\t\t}\n305|\t\tvalue, ok := rawString(opaque[key])\n306|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n307|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n308|\t\t\tif err != nil {\n309|\t\t\t\treturn err\n310|\t\t\t}\n311|\t\t\treturn failure\n312|\t\t}\n313|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n314|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n315|\t\t\tif err != nil {\n316|\t\t\t\treturn err\n317|\t\t\t}\n318|\t\t\treturn failure\n319|\t\t}\n320|\t}\n321|\treturn nil\n322|}\n323|\n324|func isIdentityKind(value string) bool {\n325|\tfor _, kind := range identityKinds {\n326|\t\tif value == kind {\n327|\t\t\treturn true\n328|\t\t}\n329|\t}\n330|\treturn false\n331|}\n332|\n333|// identifyMembers is the exact required member set of an\n334|// identify-session success body.\n335|var identifyMembers = map[string]bool{\n336|\t\"identity\":         true,\n337|\t\"confidence\":       true,\n338|\t\"matched_evidence\": true,\n339|}\n340|\n341|// identifyRequired lists identifyMembers in a fixed order.\n342|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n343|\n344|// identifyConfidences is the closed confidence vocabulary.\n345|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n346|\n347|// identifyEvidence is the closed matched-evidence vocabulary.\n348|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n349|\n350|// DecodeIdentifyResult validates one identify-session success body:\n351|// the Provider Identity Record for the expected provider, a closed\n352|// confidence, and 1..4 sorted unique matched-evidence members.\n353|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n354|\tmembers, fault := decodeStrictObject(body)\n355|\tif fault != nil {\n356|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n357|\t\tif err != nil {\n358|\t\t\treturn err\n359|\t\t}\n360|\t\treturn failure\n361|\t}\n362|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n363|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n364|\t\tif err != nil {\n365|\t\t\treturn err\n366|\t\t}\n367|\t\treturn failure\n368|\t}\n(more lines below)"}}}
