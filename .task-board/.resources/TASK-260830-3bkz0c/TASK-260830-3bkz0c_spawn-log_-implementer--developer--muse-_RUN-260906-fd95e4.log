own := unknownMember(members, identityMembers); unknown {\n112|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n113|\t\tif err != nil {\n114|\t\t\treturn err\n115|\t\t}\n116|\t\treturn failure\n117|\t}\n118|\tif name, missing := missingMember(members, identityRequired); missing {\n119|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n120|\t\tif err != nil {\n121|\t\t\treturn err\n122|\t\t}\n123|\t\treturn failure\n124|\t}\n125|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n126|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n127|\t\tif err != nil {\n128|\t\t\treturn err\n129|\t\t}\n130|\t\treturn failure\n131|\t}\n132|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n133|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n134|\t\tif err != nil {\n135|\t\t\treturn err\n136|\t\t}\n137|\t\treturn failure\n138|\t}\n139|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n140|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n141|\t\tif err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t\treturn failure\n145|\t}\n146|\tsubject, ok := rawString(members[\"subject_id\"])\n147|\tif !ok || !isUUIDv7(subject) {\n148|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n149|\t\tif err != nil {\n150|\t\t\treturn err\n151|\t\t}\n152|\t\treturn failure\n153|\t}\n154|\tsession, ok := rawString(members[\"session_id\"])\n155|\tif !ok || !isUUIDv7(session) {\n156|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n157|\t\tif err != nil {\n158|\t\t\treturn err\n159|\t\t}\n160|\t\treturn failure\n161|\t}\n162|\tif subject != session {\n163|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n164|\t\tif err != nil {\n165|\t\t\treturn err\n166|\t\t}\n167|\t\treturn failure\n168|\t}\n169|\tprovider, ok := rawString(members[\"provider_id\"])\n170|\tif !ok || !validProviderID(provider) {\n171|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n172|\t\tif err != nil {\n173|\t\t\treturn err\n174|\t\t}\n175|\t\treturn failure\n176|\t}\n177|\tif provider != wantProviderID {\n178|\t\tfailure, err := failInvalid(\"identity names another provider\")\n179|\t\tif err != nil {\n180|\t\t\treturn err\n181|\t\t}\n182|\t\treturn failure\n183|\t}\n184|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n185|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n186|\t\tif err != nil {\n187|\t\t\treturn err\n188|\t\t}\n189|\t\treturn failure\n190|\t}\n191|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n192|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n193|\t\tif err != nil {\n194|\t\t\treturn err\n195|\t\t}\n196|\t\treturn failure\n197|\t}\n198|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n199|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\tkind, ok := rawString(members[\"identity_kind\"])\n206|\tif !ok || !isIdentityKind(kind) {\n207|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n208|\t\tif err != nil {\n209|\t\t\treturn err\n(more lines below)"}}}
