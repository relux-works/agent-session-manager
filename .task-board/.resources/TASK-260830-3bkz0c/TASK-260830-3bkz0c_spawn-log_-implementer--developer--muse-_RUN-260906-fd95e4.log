tStoreFingerprint: fingerprint.String(),\n149|\t\tAdapterVersion:   adapterVersion,\n150|\t}, nil\n151|}\n152|\n153|// Direction names one Supported Environment Tuple Registry key\n154|// direction. The registry admits no third direction.\n155|type Direction string\n156|\n157|// The closed direction vocabulary.\n158|const (\n159|\tDirectionSourceRead  Direction = \"source_read\"\n160|\tDirectionTargetWrite Direction = \"target_write\"\n161|)\n162|\n163|// directionNames is the closed direction vocabulary as a table so\n164|// the census derives it like every other closed vocabulary: the\n165|// three direction gates compare through validDirection, never\n166|// through an inline comparison chain the census cannot see. The\n167|// table is built from the constants above, so the two spellings\n168|// cannot drift.\n169|var directionNames = []string{\n170|\tstring(DirectionSourceRead),\n171|\tstring(DirectionTargetWrite),\n172|}\n173|\n174|// validDirection reports whether the name is one of the two closed\n175|// registry directions.\n176|func validDirection(name string) bool {\n177|\tfor _, allowed := range directionNames {\n178|\t\tif name == allowed {\n179|\t\t\treturn true\n180|\t\t}\n181|\t}\n182|\treturn false\n183|}\n184|\n185|// tupleEntryStatuses is the two-status registry-entry vocabulary\n186|// Section 13.14 states: accepted plus revoked. Membership is a\n187|// table loop so the census derives it like every other closed\n188|// vocabulary.\n189|var tupleEntryStatuses = []string{\n190|\t\"accepted\",\n191|\t\"revoked\",\n192|}\n193|\n194|// validTupleEntryStatus reports whether the status is one of the\n195|// two Section 13.14 registry-entry statuses.\n196|func validTupleEntryStatus(status string) bool {\n197|\tfor _, allowed := range tupleEntryStatuses {\n198|\t\tif status == allowed {\n199|\t\t\treturn true\n200|\t\t}\n201|\t}\n202|\treturn false\n203|}\n204|\n205|// evidenceResults is the one-result evidence vocabulary Sections\n206|// 13.14 states for