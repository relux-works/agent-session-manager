{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86d","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":657,"recorded_at":1780531400001309,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"b3dd6192-60a6-4875-9ce8-0c353154a25b"},"task_id":"b3dd6192-60a6-4875-9ce8-0c353154a25b","event":{"kind":"output","task_id":"b3dd6192-60a6-4875-9ce8-0c353154a25b","chunk":"Read text file `internal/dirnode/probe.go`.\n(299 line(s) above)\n300|}\n301|\n302|// Finding is one validated AdapterFinding.\n303|type Finding struct {\n304|\tSeverity    string\n305|\tCode        string\n306|\tMessage     string\n307|\tRemediation string\n308|\tHasRemedy   bool\n309|}\n310|\n311|// ProbeResponse is one validated probe success body. Environment\n312|// observations cross as validated array bounds of present objects:\n313|// their content belongs to the shared-environment leaf of this\n314|// Story, so checkProbeEnvironments requires each element to be an\n315|// object and never inspects further — the one place that bound is\n316|// enforced.\n317|type ProbeResponse struct {\n318|\tHostID       string\n319|\tBuild        NodeBuild\n320|\tPolicyDigest string\n321|\tEnvironments int\n322|\tFindings     []Finding\n323|}\n324|\n325|// CheckProbeResponse validates one probe-operation success body:\n326|// the exact closed members, the host identifier, the closed node\n327|// build, the policy digest, the bounded environment and finding\n328|// arrays, and extensions.\n329|func CheckProbeResponse(body []byte) (ProbeResponse, error) {\n330|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n331|\tif fault != nil {\n332|\t\tfailure, err := failViolation(\"probe response \"+fault.detail, fault.member)\n333|\t\tif err != nil {\n334|\t\t\treturn ProbeResponse{}, err\n335|\t\t}\n336|\t\treturn ProbeResponse{}, failure\n337|\t}\n338|\tif name, unknown := unknownMember(members, probeResponseMembers); unknown {\n339|\t\tfailure, err := failViolation(\"probe response carries unknown member\", name)\n340|\t\tif err != nil {\n341|\t\t\treturn ProbeResponse{}, err\n342|\t\t}\n343|\t\treturn ProbeResponse{}, failure\n344|\t}\n345|\tif name, missing := missingMember(members, probeResponseRequired); missing {\n346|\t\tfailure, err := failViolation(\"probe response misses a required member\", name)\n347|\t\tif err != nil {\n348|\t\t\treturn ProbeResponse{}, err\n349|\t\t}\n350|\t\treturn ProbeResponse{}, failure\n351|\t}\n352|\thostID, ok := checkUUIDv7(members[\"host_id\"])\n353|\tif !ok {\n354|\t\tfailure, err := failViolation(\"probe response host identifier is not a UUIDv7\", \"host_id\")\n355|\t\tif err != nil {\n356|\t\t\treturn ProbeResponse{}, err\n357|\t\t}\n358|\t\treturn ProbeResponse{}, failure\n359|\t}\n360|\tbuild, ok := checkNodeBuild(members[\"node_build\"])\n361|\tif !ok {\n362|\t\tfailure, err := failViolation(\"probe response node build is not the closed DirectoryNodeBuild\", \"node_build\")\n363|\t\tif err != nil {\n364|\t\t\treturn ProbeResponse{}, err\n365|\t\t}\n366|\t\treturn ProbeResponse{}, failure\n367|\t}\n368|\tpolicy, ok := checkDigest(members[\"policy_digest\"])\n369|\tif !ok {\n370|\t\tfailure, err := failViolation(\"probe response policy digest is not a digest\", \"policy_digest\")\n371|\t\tif err != nil {\n372|\t\t\treturn ProbeResponse{}, err\n373|\t\t}\n374|\t\treturn ProbeResponse{}, failure\n375|\t}\n376|\tenvironments, ok := checkNestedObjects(members[\"environments\"], 0, 256)\n377|\tif !ok {\n378|\t\tfailure, err := failViolation(\"probe response environments are not EnvironmentObservation[0..256] by shape\", \"environments\")\n379|\t\tif err != nil {\n380|\t\t\treturn ProbeResponse{}, err\n381|\t\t}\n382|\t\treturn ProbeResponse{}, failure\n383|\t}\n384|\tfindings, ok := checkFindings(members[\"findings\"])\n385|\tif !ok {\n386|\t\tfailure, err := failViolation(\"probe response findings are not AdapterFinding[0..4096]\", \"findings\")\n387|\t\tif err != nil {\n388|\t\t\treturn ProbeResponse{}, err\n389|\t\t}\n390|\t\treturn ProbeResponse{}, failure\n391|\t}\n392|\tif !checkExtensions(members[\"extensions\"]) {\n393|\t\tfailure, err := failViolation(\"probe response extensions are not reverse-DNS keyed\", \"extensions\")\n394|\t\tif err != nil {\n395|\t\t\treturn ProbeResponse{}, err\n396|\t\t}\n397|\t\treturn ProbeResponse{}, failure\n398|\t}\n399|\treturn ProbeResponse{\n400|\t\tHostID:       hostID.String(),\n401|\t\tBuild:        build,\n402|\t\tPolicyDigest: policy.String(),\n403|\t\tEnvironments: environments,\n404|\t\tFindings:     findings,\n405|\t}, nil\n406|}\n407|\n408|// checkNodeBuild validates one DirectoryNodeBuild object.\n409|func checkNodeBuild(raw json.RawMessage) (NodeBuild, bool) {\n410|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n411|\tif fault != nil {\n412|\t\treturn NodeBuild{}, false\n413|\t}\n414|\tif name, unknown := unknownMember(members, nodeBuildMembers); unknown {\n415|\t\t_ = name\n416|\t\treturn NodeBuild{}, false\n417|\t}\n418|\tif name, missing := missingMember(members, nodeBuildRequired); missing {\n419|\t\t_ = name\n(more lines below)"}}}
