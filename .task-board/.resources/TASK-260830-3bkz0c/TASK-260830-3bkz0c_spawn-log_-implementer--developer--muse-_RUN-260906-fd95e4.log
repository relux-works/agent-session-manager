{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c737","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":502,"recorded_at":1780531400000999,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"a79a5b81-a26c-421f-bda2-4ebf48b15580"},"task_id":"a79a5b81-a26c-421f-bda2-4ebf48b15580","event":{"kind":"output","task_id":"a79a5b81-a26c-421f-bda2-4ebf48b15580","chunk":"Read text file `internal/sessadapter/probe.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.8 Session Adapter Probe 1.0.0,\n8|// the capability-value rules, the probe equality gates against the\n9|// verified manifest and host values, the doctor health gate, and\n10|// the target-write capability gates.\n11|\n12|// probeSchema is the exact schema identifier the probe carries.\n13|const probeSchema = \"urn:ax:schema:session-adapter-probe\"\n14|\n15|// probeSchemaVersion is the only probe version this host accepts.\n16|const probeSchemaVersion = \"1.0.0\"\n17|\n18|// probeMembers is the exact Session Adapter Probe 1.0.0 member set:\n19|// schema, schema_version, provider_id, adapter_manifest_digest,\n20|// adapter_version, environment, capabilities, warnings, and\n21|// extensions.\n22|var probeMembers = map[string]bool{\n23|\t\"schema\":                  true,\n24|\t\"schema_version\":          true,\n25|\t\"provider_id\":             true,\n26|\t\"adapter_manifest_digest\": true,\n27|\t\"adapter_version\":         true,\n28|\t\"environment\":             true,\n29|\t\"capabilities\":            true,\n30|\t\"warnings\":                true,\n31|\t\"extensions\":              true,\n32|}\n33|\n34|// probeRequired lists probeMembers in a fixed order.\n35|var probeRequired = []string{\n36|\t\"schema\",\n37|\t\"schema_version\",\n38|\t\"provider_id\",\n39|\t\"adapter_manifest_digest\",\n40|\t\"adapter_version\",\n41|\t\"environment\",\n42|\t\"capabilities\",\n43|\t\"warnings\",\n44|\t\"extensions\",\n45|}\n46|\n47|// capabilityValueMembers is the exact per-capability value member\n48|// set: status, enabled, evidence, and detail. Only\n49|// status=available permits enabled=true.\n50|var capabilityValueMembers = map[string]bool{\n51|\t\"status\":   true,\n52|\t\"enabled\":  true,\n53|\t\"evidence\": true,\n54|\t\"detail\":   true,\n55|}\n56|\n57|// capabilityValueRequired lists capabilityValueMembers in order.\n58|var capabilityValueRequired = []string{\n59|\t\"status\",\n60|\t\"enabled\",\n61|\t\"evidence\",\n62|\t\"detail\",\n63|}\n64|\n65|// Capability is one validated capability value.\n66|type Capability struct {\n67|\tStatus   string\n68|\tEnabled  bool\n69|\tEvidence string\n70|\tDetail   string\n71|}\n72|\n73|// Probe is one validated Session Adapter Probe 1.0.0.\n74|type Probe struct {\n75|\tProviderID     string\n76|\tManifestDigest string\n77|\tAdapterVersion string\n78|\tEnvironment    Tuple\n79|\tCapabilities   map[string]Capability\n80|\tWarnings       []string\n(more lines below)"}}}
