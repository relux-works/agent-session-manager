{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca77","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":918,"recorded_at":1780531400001831,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"0a1e1fd2-bd14-4fa6-942b-a1f50b6befd9"},"task_id":"0a1e1fd2-bd14-4fa6-942b-a1f50b6befd9","event":{"kind":"output","task_id":"0a1e1fd2-bd14-4fa6-942b-a1f50b6befd9","chunk":"Read text file `internal/dirnode/scan.go`.\n(61 line(s) above)\n62|func CheckScanRequest(body []byte) (ScanRequest, error) {\n63|\tmembers, fault := decodeStrictObject(bytesTrimSpace(body))\n64|\tif fault != nil {\n65|\t\tfailure, err := failViolation(\"scan request \"+fault.detail, fault.member)\n66|\t\tif err != nil {\n67|\t\t\treturn ScanRequest{}, err\n68|\t\t}\n69|\t\treturn ScanRequest{}, failure\n70|\t}\n71|\tif name, unknown := unknownMember(members, scanRequestMembers); unknown {\n72|\t\tfailure, err := failViolation(\"scan request carries unknown member\", name)\n73|\t\tif err != nil {\n74|\t\t\treturn ScanRequest{}, err\n75|\t\t}\n76|\t\treturn ScanRequest{}, failure\n77|\t}\n78|\tif name, missing := missingMember(members, scanRequestRequired); missing {\n79|\t\tfailure, err := failViolation(\"scan request misses a required member\", name)\n80|\t\tif err != nil {\n81|\t\t\treturn ScanRequest{}, err\n82|\t\t}\n83|\t\treturn ScanRequest{}, failure\n84|\t}\n85|\toperationID, ok := checkUUIDv7(members[\"operation_id\"])\n86|\tif !ok {\n87|\t\tfailure, err := failViolation(\"scan request operation identifier is not a UUIDv7\", \"operation_id\")\n88|\t\tif err != nil {\n89|\t\t\treturn ScanRequest{}, err\n90|\t\t}\n91|\t\treturn ScanRequest{}, failure\n92|\t}\n93|\tinstallations, ok := checkSortedUniqueDigests(members[\"installation_ids\"], 1, 256)\n94|\tif !ok {\n95|\t\tfailure, err := failViolation(\"scan request installations are not sorted unique digest[1..256]\", \"installation_ids\")\n96|\t\tif err != nil {\n97|\t\t\treturn ScanRequest{}, err\n98|\t\t}\n99|\t\treturn ScanRequest{}, failure\n100|\t}\n101|\tprior, present, wasNull := checkOptionalDigest(members[\"prior_batch_id\"])\n102|\tif !present {\n103|\t\tfailure, err := failViolation(\"scan request prior batch is not a digest|null\", \"prior_batch_id\")\n104|\t\tif err != nil {\n105|\t\t\treturn ScanRequest{}, err\n106|\t\t}\n107|\t\treturn ScanRequest{}, failure\n108|\t}\n109|\tcursor, cursorPresent, cursorNull := checkOptionalString(members[\"cursor\"], 1, 4096)\n110|\tif !cursorPresent {\n111|\t\tfailure, err := failViolation(\"scan request cursor is not a string[1..4096]|null\", \"cursor\")\n112|\t\tif err != nil {\n113|\t\t\treturn ScanRequest{}, err\n114|\t\t}\n115|\t\treturn ScanRequest{}, failure\n116|\t}\n117|\tmaximum, ok := checkUint53Bounds(members[\"max_instances\"], 1, 65536)\n118|\tif !ok {\n119|\t\tfailure, err := failViolation(\"scan request max_instances is not uint53[1..65536]\", \"max_instances\")\n120|\t\tif err != nil {\n121|\t\t\treturn ScanRequest{}, err\n122|\t\t}\n123|\t\treturn ScanRequest{}, failure\n124|\t}\n125|\tif !checkExtensions(members[\"extensions\"]) {\n126|\t\tfailure, err := failViolation(\"scan request extensions are not reverse-DNS keyed\", \"extensions\")\n127|\t\tif err != nil {\n128|\t\t\treturn ScanRequest{}, err\n129|\t\t}\n130|\t\treturn ScanRequest{}, failure\n131|\t}\n132|\treturn ScanRequest{\n133|\t\tOperationID:   operationID.String(),\n134|\t\tInstallations: digestStrings(installations),\n135|\t\tHasPriorBatch: !wasNull,\n136|\t\tPriorBatchID:  prior.String(),\n137|\t\tHasCursor:     !cursorNull,\n138|\t\tCursor:        cursor,\n139|\t\tMaxInstances:  maximum,\n140|\t}, nil\n141|}\n142|\n143|// scanResponseMembers is the exact scan success-body member set.\n144|var scanResponseMembers = map[string]bool{\n145|\t\"batch\":                       true,\n146|\t\"environment_observation_ids\": true,\n147|\t\"native_observation_ids\":      true,\n148|\t\"next_cursor\":                 true,\n149|\t\"extensions\":                  true,\n150|}\n151|\n152|// scanResponseRequired lists scanResponseMembers in a fixed order.\n153|var scanResponseRequired = []string{\n154|\t\"batch\",\n155|\t\"environment_observation_ids\",\n156|\t\"native_observation_ids\",\n157|\t\"next_cursor\",\n158|\t\"extensions\",\n159|}\n160|\n161|// ScanResponse is one validated scan success body. The batch\n162|// crosses as presence: the InventoryBatch content owner is the\n163|// shared-environment leaf, so only the object shape is checked.\n164|type ScanResponse struct {\n165|\tHasBatch       bool\n166|\tEnvironmentIDs []string\n167|\tNativeIDs      []string\n168|\tHasNextCursor  bool\n169|\tNextCursor     string\n170|}\n171|\n172|// CheckScanResponse validates one scan-operation success body: the\n173|// exact closed members, a present batch object, sorted unique\n174|// environment observation digests in [1..256], sorted unique\n175|// native observation digests in [0..65536], and a\n176|// string[1..4096]|null next cursor.\n(more lines below)"}}}
