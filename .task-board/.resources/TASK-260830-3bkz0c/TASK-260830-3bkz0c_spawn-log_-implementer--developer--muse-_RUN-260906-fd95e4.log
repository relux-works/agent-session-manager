{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d3","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":708,"recorded_at":1780531400001411,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"call_id":"call_01a07600f37974029693b4e9938b9010","text":"Read text file `internal/sessadapter/fixtures_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|)\n15|\n16|// Shared fixtures for the sessadapter suite. Every builder emits\n17|// hand-written JSON with independently chosen literals: no builder\n18|// derives its probe points from production constants, so a mutated\n19|// production constant cannot take its fixture with it. The verdict\n20|// always comes from production; the vectors never do.\n21|\n22|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n23|// the digests are syntactically pinned sha256 hex.\n24|const (\n25|\tfixtureProviderID    = \"test-provider\"\n26|\tfixtureEnvironmentID = \"test.env\"\n27|\tfixtureAdapterVer    = \"1.2.3\"\n28|\tfixtureRequestID     = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n29|\tfixtureOperationID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n30|\tfixtureAuthorityID   = \"0198f4c8-8e50-7f66-8f70-1234567890ad\"\n31|\tfixtureDeadline      = \"2026-08-19T04:05:00.000Z\"\n32|\tfixtureValidFrom     = \"2026-01-01T00:00:00.000Z\"\n33|\tfixtureValidUntil    = \"2027-01-01T00:00:00.000Z\"\n34|\tfixtureCallTime      = \"2026-06-01T00:00:00.000Z\"\n35|\tfixtureExecutedAt    = \"2026-05-01T00:00:00.000Z\"\n36|\tfixtureExpiresAt     = \"2026-08-19T05:05:00.000Z\"\n37|)\n38|\n39|// fixtureDigest returns the pinned digest of one seed.\n40|func fixtureDigest(seed string) string {\n41|\tsum := sha256.Sum256([]byte(seed))\n42|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n43|}\n44|\n45|// Standard fixture digests, each naming its seed.\n46|var (\n47|\tfixtureExecutableDigest = fixtureDigest(\"test-executable\")\n48|\tfixtureProviderManifest = fixtureDigest(\"test-provider-manifest\")\n49|\tfixtureStorePrint       = fixtureDigest(\"test-store-fingerprint\")\n50|\tfixtureSuiteDigest      = fixtureDigest(\"test-suite\")\n51|\tfixtureEvidenceDigest   = fixtureDigest(\"test-evidence\")\n52|\tfixtureSmokeDigest      = fixtureDigest(\"test-smoke\")\n53|\tfixtureRegistryDigest   = fixtureDigest(\"test-registry\")\n54|\tfixturePlanDigest       = fixtureDigest(\"test-plan\")\n55|\tfixtureCaptureDigest    = fixtureDigest(\"test-capture-manifest\")\n56|\tfixtureSessionDigest    = fixtureDigest(\"test-canonical-session\")\n57|\tfixtureProjectedDigest  = fixtureDigest(\"test-projected-manifest\")\n58|\tfixtureStructuralDigest = fixtureDigest(\"test-structural\")\n59|\tfixtureReadBackDigest   = fixtureDigest(\"test-read-back-evidence\")\n60|)\n61|\n62|// fixtureTupleJSON is one valid Environment Tuple.\n63|func fixtureTupleJSON() string {\n64|\treturn fmt.Sprintf(`{\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":%q}`,\n65|\t\tfixtureEnvironmentID, fixtureStorePrint, fixtureAdapterVer)\n66|}\n67|\n68|// fixtureContextJSON is one valid AdapterCallContext carrying the\n69|// given request digest.\n70|func fixtureContextJSON(requestDigest string) string {\n71|\treturn fmt.Sprintf(`{\"operation_id\":%q,\"provider_id\":%q,\"environment\":%s,\"session_adapter_manifest_digest\":%q,\"executable_sha256\":%q,\"request_digest\":%q,\"extensions\":{}}`,\n72|\t\tfixtureOperationID, fixtureProviderID, fixtureTupleJSON(), fixtureDigest(\"test-adapter-manifest\"), fixtureExecutableDigest, requestDigest)\n73|}\n74|\n75|// fixtureReadAuthorityJSON is one valid source_native ReadAuthority.\n76|func fixtureReadAuthorityJSON() string {\n77|\treturn fmt.Sprintf(`{\"authority_id\":%q,\"purpose\":\"source_native\",\"root_handle_names\":[\"handle-a\"],\"expires_at\":%q,\"extensions\":{}}`,\n78|\t\tfixtureAuthorityID, fixtureExpiresAt)\n79|}\n80|\n81|// fixtureFreshSinkJSON is one valid fresh_sink ObjectAuthority.\n82|func fixtureFreshSinkJSON(purpose string) string {\n83|\treturn fmt.Sprintf(`{\"authority_id\":%q,\"purpose\":%q,\"mode\":\"fresh_sink\",\"max_objects\":100,\"max_total_bytes\":1000000,\"extensions\":{}}`,\n84|\t\tfixtureAuthorityID, purpose)\n85|}\n86|\n87|// fixtureManifestJSON is one valid Session Adapter Manifest 1.0.0\n88|// with the registries in section order.\n89|func fixtureManifestJSON() string {\n90|\toperations := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\toperations = append(operations, `\"`+string(operation)+`\"`)\n93|\t}\n94|\tcapabilities := make([]string, 0, len(capabilityOrder))\n95|\tfor _, name := range capabilityOrder {\n96|\t\tcapabilities = append(capabilities, `\"`+name+`\"`)\n97|\t}\n98|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-adapter-manifest\",\"schema_version\":\"1.0.0\",\"provider_id\":%q,\"environment_id\":%q,\"display_name\":\"Test Adapter\",\"adapter_version\":%q,\"environment_version_range\":\">=1.0.0\",\"platforms\":[\"linux\",\"macos\"],\"operations\":[%s],\"capability_names\":[%s],\"extensions\":{}}`,\n99|\t\tfixtureProviderID, fixtureEnvironmentID, fixtureAdapterVer,\n100|\t\tstrings.Join(operations, \",\"), strings.Join(capabilities, \",\"))\n101|}\n102|\n103|// fixtureCapabilityJSON is one available+enabled capability value.\n104|func fixtureCapabilityJSON() string {\n105|\treturn `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"\"}`\n106|}\n107|\n108|// fixtureProbeJSON is one valid Session Adapter Probe 1.0.0 with\n109|// every capability available and enabled.\n110|func fixtureProbeJSON(manifestDigest string) string {\n111|\tvalues := make([]string, 0, len(capabilityOrder))\n112|\tfor _, name := range capabilityOrder {\n113|\t\tvalues = append(values, `\"`+name+`\":`+fixtureCapabilityJSON())\n114|\t}\n115|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-adapter-probe\",\"schema_version\":\"1.0.0\",\"provider_id\":%q,\"adapter_manifest_digest\":%q,\"adapter_version\":%q,\"environment\":%s,\"capabilities\":{%s},\"warnings\":[],\"extensions\":{}}`,\n116|\t\tfixtureProviderID, manifestDigest, fixtureAdapterVer, fixtureTupleJSON(), strings.Join(values, \",\"))\n117|}\n118|\n119|// fixtureEntryJSON is one valid accepted registry entry for the\n120|// direction: source_read carries strategies=[archive_only] with\n121|// null smoke, target_write carries the native-writer strategy\n122|// with passing smoke.\n123|func fixtureEntryJSON(direction Direction) string {\n124|\tstrategies := `[\"archive_only\"]`\n125|\tsmoke := `null`\n126|\tif direction == DirectionTargetWrite {\n127|\t\tstrategies = `[\"target_native_writer\"]`\n128|\t\tsmoke = fmt.Sprintf(`{\"result\":\"pass\",\"executed_at\":%q,\"evidence_digest\":%q,\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":true}`,\n129|\t\t\tfixtureExecutedAt, fixtureSmokeDigest)\n130|\t}\n131|\treturn fmt.Sprintf(`{\"key\":{\"direction\":%q,\"environment\":%s,\"provider_id\":%q,\"candidate_kind\":\"builtin\",\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q},\"entry_sequence\":7,\"contracts\":[{\"contract_id\":\"urn:ax:protocol:session-adapter\",\"versions\":[\"1.0.0\"]}],\"strategies\":%s,\"fixture_evidence\":{\"suite_revision\":\"rev-9\",\"suite_digest\":%q,\"result\":\"pass\",\"executed_at\":%q,\"evidence_digest\":%q,\"fixture_count\":12},\"resume_smoke_evidence\":%s,\"known_fidelity_limits\":[],\"valid_from\":%q,\"valid_until\":%q,\"status\":\"accepted\",\"revocation_reason\":null,\"revoked_at\":null,\"extensions\":{}}`,\n132|\t\tstring(direction), fixtureTupleJSON(), fixtureProviderID,\n133|\t\tfixtureExecutableDigest, fixtureProviderManifest, fixtureDigest(\"test-adapter-manifest\"),\n134|\t\tstrategies, fixtureSuiteDigest, fixtureExecutedAt, fixtureEvidenceDigest, smoke,\n135|\t\tfixtureValidFrom, fixtureValidUntil)\n136|}\n137|\n138|// fixtureBindingFacts are the host-observed facts matching every\n139|// fixture above.\n140|func fixtureBindingFacts() BindingFacts {\n141|\treturn BindingFacts{\n142|\t\tProviderID:             fixtureProviderID,\n143|\t\tCandidateKind:          CandidateBuiltin,\n144|\t\tExecutableSHA256:       fixtureExecutableDigest,\n145|\t\tProviderManifestDigest: fixtureProviderManifest,\n146|\t\tAdapterManifestDigest:  fixtureDigest(\"test-adapter-manifest\"),\n147|\t}\n148|}\n149|\n150|// fixtureCandidate is the trusted candidate matching every\n151|// fixture above.\n152|func fixtureCandidate() TrustedCandidate {\n153|\treturn TrustedCandidate{\n154|\t\tProviderID:             fixtureProviderID,\n155|\t\tKind:                   CandidateBuiltin,\n156|\t\tExecutablePath:         \"/opt/ax/bin/ax-provider-test-provider\",\n157|\t\tOwnerIdentity:          \"test-owner\",\n158|\t\tExecutableSHA256:       fixtureExecutableDigest,\n159|\t\tProviderManifestDigest: fixtureProviderManifest,\n160|\t}\n161|}\n162|\n163|// mutateMember returns the object with one top-level member\n164|// replaced by the given raw JSON. The replacement is applied to a\n165|// fresh positive fixture, one mutation at a time, per the\n166|// Appendix D execution rules. Members re-encode in sorted key\n167|// order and the replacement passes through unvalidated, so\n168|// malformed values reach the production decoder instead of\n169|// failing the test scaffolding.\n170|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n171|\tt.Helper()\n172|\tvar members map[string]json.RawMessage\n173|\tif err := json.Unmarshal(body, &members); err != nil {\n174|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n175|\t}\n176|\tmembers[member] = json.RawMessage(replacement)\n177|\tnames := make([]string, 0, len(members))\n178|\tfor name := range members {\n179|\t\tnames = append(names, name)\n180|\t}\n181|\tsort.Strings(names)\n182|\tparts := make([]string, 0, len(members))\n183|\tfor _, name := range names {\n184|\t\tquoted, err := json.Marshal(name)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"mutateMember: %v\", err)\n187|\t\t}\n188|\t\tparts = append(parts, string(quoted)+\":\"+string(members[name]))\n189|\t}\n190|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n191|}\n192|\n193|// dropMember returns the object without one top-level member.\n194|func dropMember(t *testing.T, body []byte, member string) []byte {\n195|\tt.Helper()\n196|\tvar members map[string]json.RawMessage\n197|\tif err := json.Unmarshal(body, &members); err != nil {\n198|\t\tt.Fatalf(\"dropMember: fixture is not JSON: %v\", err)\n199|\t}\n200|\tdelete(members, member)\n201|\tdropped, err := json.Marshal(members)\n202|\tif err != nil {\n203|\t\tt.Fatalf(\"dropMember: %v\", err)\n204|\t}\n205|\treturn dropped\n206|}\n207|\n208|// failureObject requires a Structured Error and returns it.\n209|func failureObject(t *testing.T, err error) *axerror.Error {\n210|\tt.Helper()\n211|\tif err == nil {\n212|\t\tt.Fatal(\"want refusal, got nil error\")\n213|\t}\n214|\tfailure, ok := err.(*axerror.Error)\n215|\tif !ok {\n216|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n217|\t}\n218|\treturn failure\n219|}\n220|\n221|// failureCode returns the stable code of a refusal.\n222|func failureCode(t *testing.T, err error) axerror.Code {\n223|\tt.Helper()\n224|\treturn failureObject(t, err).Code()\n225|}\n226|\n227|// failureDetail returns one string diagnostic of a refusal.\n228|func failureDetail(t *testing.T, err error, key string) string {\n229|\tt.Helper()\n230|\tdetail, ok := failureObject(t, err).Detail(key)\n231|\tif !ok {\n232|\t\tt.Fatalf(\"refusal %v carries no %q detail\", err, key)\n233|\t}\n234|\ttext, ok := detail.(string)\n235|\tif !ok {\n236|\t\tt.Fatalf(\"refusal %v detail %q is %T, want string\", err, key, detail)\n237|\t}\n238|\treturn text\n239|}\n240|\n241|// requireRefusal asserts the full arm identity of a refusal: the\n242|// stable code, one distinguishing diagnostic, the detail naming\n243|// the rule in the human text, and the non-retryable bit. Asserting\n244|// the distinguishing diagnostic pins which arm fired: deleting a\n245|// gate slides the refusal to a lower arm carrying the same code\n246|// with a different diagnostic, and the slide reddens here.\n247|func requireRefusal(t *testing.T, err error, code axerror.Code, detailKey, detailValue, text string) {\n248|\tt.Helper()\n249|\tif failureCode(t, err) != code {\n250|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n251|\t}\n252|\tif got := failureDetail(t, err, detailKey); got != detailValue {\n253|\t\tt.Fatalf(\"%s detail = %q, want %q (error: %v)\", detailKey, got, detailValue, err)\n254|\t}\n255|\tif !strings.Contains(err.Error(), text) {\n256|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, text)\n257|\t}\n258|\tif failureObject(t, err).Retryable() {\n259|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n260|\t}\n261|}\n262|\n263|// canonicalJSON canonicalizes test scaffolding. It is test-only\n264|// assembly, never a verdict: every verdict comes from production.\n265|func canonicalJSON(t *testing.T, body []byte) []byte {\n266|\tt.Helper()\n267|\tcanonical, err := canonicaljson.Canonicalize(body)\n268|\tif err != nil {\n269|\t\tt.Fatalf(\"canonicalJSON: %v\", err)\n270|\t}\n271|\treturn canonical\n272|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d5","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":709,"recorded_at":1780531400001413,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"call_id":"call_01a07600f447758282e5f563980f4a58","text":"{\n  \"chunk_id\": \"exec-25-1\",\n  \"command\": \"sed -n '3530,3720p' internal/specdoc/SPEC.md\",\n  \"description\": \"Read session adapter probe and environment section\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\nEvery operation body is a closed object. In the definitions below,\\n<code>T[n..m]</code> is an array with the inclusive item bound and\\n<code>sorted unique</code> means bytewise order of each item's JCS encoding.\\nLarge data is referenced by manifest or Blob Descriptor ID and MUST NOT be\\nembedded in the 8 MiB frame. The reusable closed body types are:\\n\\n- <code>AdapterCallContext</code> contains exactly\\n  <code>operation_id:UUIDv7</code>, <code>provider_id:provider-id</code>,\\n  <code>environment:EnvironmentTuple</code>,\\n  <code>session_adapter_manifest_digest:digest</code>,\\n  <code>executable_sha256:digest</code>, <code>request_digest:digest</code>,\\n  and <code>extensions</code>. The host constructs it from the verified\\n  candidate. <code>request_digest</code> is the digest of the JCS request body\\n  with only that member omitted. Every success echoes the context byte-for-byte.\\n- <code>ReadAuthority</code> contains exactly <code>authority_id:UUIDv7</code>,\\n  <code>purpose:source_native|target_staged|target_live</code>,\\n  <code>root_handle_names:sorted unique string[1..128][1..128]</code>,\\n  <code>expires_at:timestamp</code>, and <code>extensions</code>. Handle names\\n  identify host-opened descriptors or handles delivered out of band; they are\\n  never paths.\\n- <code>ObjectAuthority</code> contains exactly\\n  <code>authority_id:UUIDv7</code>,\\n  <code>purpose:capture_plan|raw_source|canonical_source|projection_plan|projected_target|read_back_evidence</code>,\\n  <code>mode:read|fresh_sink</code>, <code>max_objects:uint53</code>,\\n  <code>max_total_bytes:uint53</code>, and <code>extensions</code>.\\n  <code>fresh_sink</code> requires an empty host-created sink and both limits\\n  greater than zero. <code>read</code> exposes only request-named objects.\\n- <code>SourceSelector</code> contains exactly\\n  <code>native_session_id:string[1..512]|null</code>,\\n  <code>logical_workspace_id:UUIDv7|null</code>, and\\n  <code>opaque_source_ref:string[1..512]|null</code>; exactly one is non-null.\\n- <code>AdapterFinding</code> contains exactly\\n  <code>severity:info|warning|error</code>, <code>code:string[1..128]</code>,\\n  <code>message:string[1..4096]</code>,\\n  <code>remediation:string[1..4096]|null</code>, and <code>extensions</code>.\\n- <code>ResourceLimits</code> contains exactly\\n  <code>max_objects:uint53&gt;0</code>,\\n  <code>max_total_bytes:uint53&gt;0</code>,\\n  <code>max_single_object_bytes:uint53&gt;0</code>,\\n  <code>max_events:uint53[0..65536]</code>, and\\n  <code>max_target_resources:uint53[0..65536]</code>. Each per-item maximum is\\n  no greater than <code>max_total_bytes</code>.\\n- <code>CapturePlanItem</code> contains exactly\\n  <code>native_item_key:string[1..512]</code>,\\n  <code>class:capture-class</code>, <code>byte_count:uint53|null</code>,\\n  <code>required:boolean</code>, and <code>extensions</code>.\\n\\nThe exact request and success <code>body</code> registry is:\\n\\n| Operation | Exact request body | Exact success body |\\n| --- | --- | --- |\\n| <code>manifest</code> | <code>{}</code> | Exact Session Adapter Manifest 1.0.0 |\\n| <code>probe</code> | <code>{expected_provider_id:provider-id,expected_candidate_kind:builtin\\\\|external,extensions}</code> | Exact Session Adapter Probe 1.0.0; all provider, manifest, version, and tuple equalities below hold |\\n| <code>discover</code> | <code>{context:AdapterCallContext,authority:ReadAuthority,workspace_filter:UUIDv7\\\\|null,limit:uint53[1..65536],cursor:string[1..1024]\\\\|null,extensions}</code> | <code>{context:AdapterCallContext,sources:CloneSourceSummary[0..65536],next_cursor:string[1..1024]\\\\|null,partial:boolean,extensions}</code>; sorted by logical workspace/native Session ID; <code>partial=false</code> iff <code>next_cursor</code> is null |\\n| <code>inspect</code> | <code>{context:AdapterCallContext,authority:ReadAuthority,source:SourceSelector,extensions}</code> | <code>{context:AdapterCallContext,source:CloneSourceSummary,source_identity:NativeIdentity,source_store_generation:string[1..512],environment:EnvironmentTuple,ambiguities:AdapterFinding[0..1024],extensions}</code>; zero ambiguities are required before capture |\\n| <code>snapshot-proof</code> | <code>{context:AdapterCallContext,authority:ReadAuthority,source:SourceSelector,expected_source_store_generation:string[1..512],allow_provider_quiescence:boolean,extensions}</code> | <code>{context:AdapterCallContext,proof:StableSnapshotProof,provider_quiescence_requested:boolean,provider_quiescence_observed:boolean,extensions}</code>; provider quiescence requires both booleans true and separately verified Provider <code>quiesce</code> evidence |\\n| <code>capture-plan</code> | <code>{context:AdapterCallContext,authority:ReadAuthority,source:SourceSelector,capture_boundary:CaptureBoundary,plan_sink:ObjectAuthority,max_items:uint53[1..65536],max_total_bytes:uint53&gt;0,extensions}</code> | <code>{context:AdapterCallContext,source_identity:NativeIdentity,source_store_generation:string[1..512],capture_plan_candidate_id:digest,candidate_count:uint53[0..65536],excluded_classes:sorted unique capture-class[0..9],capture_plan_digest:digest,extensions}</code>; fresh <code>capture_plan</code> sink containing exactly sorted unique <code>CapturePlanItem[0..65536]</code>, and the two candidate digests are equal after core rehash |\\n| <code>capture</code> | <code>{context:AdapterCallContext,source_authority:ReadAuthority,sink:ObjectAuthority,source:SourceSelector,capture_boundary:CaptureBoundary,capture_plan_digest:digest,extensions}</code> | <code>{context:AdapterCallContext,capture_plan_digest:digest,source_store_generation:string[1..512],capture_result_candidate_id:digest,source_raw_object_manifest_candidate_id:digest,item_count:uint53[0..65536],pre_capture_digest:digest,post_capture_digest:digest,extensions}</code>; fresh raw sink, exact plan-key reconciliation, and an exact included-object closure |\\n| <code>normalize</code> | <code>{context:AdapterCallContext,capture_manifest_id:digest,raw_objects:ObjectAuthority,canonical_sink:ObjectAuthority,extensions}</code> | <code>{context:AdapterCallContext,capture_manifest_id:digest,canonical_session_candidate_id:digest,canonical_event_candidate_ids:digest[0..65536],raw_reference_ids:sorted unique digest[0..65536],extensions}</code>; all candidates resolve inside the fresh canonical sink and all raw references are in Capture Manifest closure |\\n| <code>projection-plan</code> | <code>{context:AdapterCallContext,capture_manifest_id:digest,canonical_session_id:digest,canonical_event_ids:digest[0..65536],source_objects:ObjectAuthority,plan_sink:ObjectAuthority,target_environment:EnvironmentTuple,expected_target_native_session_id:string[1..512],fidelity_profile:strict_exact\\\\|maximal_safe\\\\|compact\\\\|messages_only,required_dispositions:closed-map(event-or-artifact-class,sorted-unique-fidelity-disposition[1..7]),forbid_reasons:sorted-unique-string[1..128][0..128],resource_limits:ResourceLimits,extensions}</code> | <code>{context:AdapterCallContext,projection_plan_candidate_id:digest,required_source_object_ids:sorted unique digest[0..65536],predicted_counts:FidelityCounts,findings:AdapterFinding[0..4096],extensions}</code>; <code>archive_only</code> is forbidden and every canonical item has one disposition |\\n| <code>project</code> | <code>{context:AdapterCallContext,projection_plan_id:digest,capture_manifest_id:digest,canonical_session_id:digest,source_objects:ObjectAuthority,target_sink:ObjectAuthority,extensions}</code> | <code>{context:AdapterCallContext,projection_plan_id:digest,projected_object_manifest_candidate_id:digest,created_resource_keys:sorted unique string[1..512][0..65536],actual_counts:FidelityCounts,extensions}</code>; fresh target sink and exact plan/manifest/resource-key reconciliation |\\n| <code>read-back</code> | <code>{context:AdapterCallContext,authority:ReadAuthority,expected_target_native_session_id:string[1..512],projection_plan_id:digest,projected_object_manifest_id:digest,evidence_sink:ObjectAuthority,extensions}</code> | <code>{context:AdapterCallContext,observed_target_native_session_id:string[1..512],projection_plan_id:digest,observed_environment:EnvironmentTuple,parsed_event_count:uint53,parsed_head_ids:sorted unique string[1..512][0..1024],workspace_binding:WorkspaceBinding,structural_digest:digest,read_back_evidence_manifest_candidate_id:digest,extensions}</code>; staged/live mode is fixed by authority and cannot be relabeled |\\n| <code>validate</code> | <code>{context:AdapterCallContext,mode:staged\\\\|live\\\\|archive,capture_manifest_id:digest,canonical_session_id:digest,projection_plan_id:digest\\\\|null,projected_object_manifest_id:digest\\\\|null,read_back_evidence_manifest_id:digest\\\\|null,expected_target_native_session_id:string[1..512]\\\\|null,extensions}</code> | <code>{context:AdapterCallContext,mode:staged\\\\|live\\\\|archive,valid:boolean,structural_valid:boolean,semantic_marker_valid:boolean,identity_valid:boolean\\\\|null,workspace_binding_valid:boolean\\\\|null,resume_surface_valid:boolean\\\\|null,findings:AdapterFinding[0..4096],evidence_digest:digest,extensions}</code>; archive requires all four target members null, staged/live require them non-null, and <code>valid=true</code> requires every applicable check true and no error finding |\\n| <code>resume-plan</code> | <code>{context:AdapterCallContext,authority:ReadAuthority,expected_target_native_session_id:string[1..512],projection_plan_id:digest,target_checkpoint_id:digest\\\\|null,extensions}</code> | <code>{context:AdapterCallContext,target_native_session_id:string[1..512],projection_plan_id:digest,argv:string[1..4096][1..128],cwd_relative:string[1..4096],environment_names:sorted unique string[1..256][0..128],opens_existing_identity:true,extensions}</code>; argv contains no secret, names the trusted CLI family, and contains the explicit identity exactly once |\\n| <code>doctor</code> | <code>{context:AdapterCallContext,direction:source_read\\\\|target_write,tuple_registry_digest:digest,refresh_requested:boolean,extensions}</code> | <code>{context:AdapterCallContext,direction:source_read\\\\|target_write,registry_sequence:uint53,registry_entry_status:accepted\\\\|revoked\\\\|absent,findings:AdapterFinding[0..4096],healthy:boolean,extensions}</code>; healthy requires an accepted exact binding and every required capability |\\n\\nCandidate objects are addressed only by their exact\\n<code>*_candidate_id</code> in the request's fresh sink. The core retrieves,\\nvalidates, rehashes, and seals them. A partial, malformed, over-limit, escaped,\\nor authority-unresolvable result is an error, never an empty or absent result\\nand never fallback permission.\\n\\nSession Adapter Manifest 1.0.0 is closed and contains exactly:\\n\\n| Member | Type and constraint |\\n| --- | --- |\\n| <code>schema</code> / <code>schema_version</code> | Exact <code>urn:ax:schema:session-adapter-manifest</code> / <code>1.0.0</code> |\\n| <code>provider_id</code> | <code>[a-z][a-z0-9-]{0,31}</code>; equal to Provider Manifest and discovered candidate ID |\\n| <code>environment_id</code> | <code>[a-z][a-z0-9.-]{0,63}</code>; one semantic native environment |\\n| <code>display_name</code> / <code>adapter_version</code> | UTF-8 string[1..128] / SemVer |\\n| <code>environment_version_range</code> | Non-empty constraint string[1..256] |\\n| <code>platforms</code> | Sorted unique non-empty subset of <code>linux&#124;macos&#124;windows&#124;wsl2</code> |\\n| <code>operations</code> / <code>capability_names</code> | Complete ordered registries in this section, no omissions or duplicates |\\n| <code>extensions</code> | Reverse-DNS keys; cannot add operations, capabilities, or trust facts |\\n\\nIts host-computed JCS SHA-256 is\\n<code>session_adapter_manifest_digest</code> and is not embedded.\\n\\nSession Adapter Probe 1.0.0 is closed and contains exactly\\n<code>schema=urn:ax:schema:session-adapter-probe</code>,\\n<code>schema_version=1.0.0</code>, <code>provider_id</code>,\\n<code>adapter_manifest_digest</code>, <code>adapter_version</code>,\\n<code>environment:EnvironmentTuple</code>, <code>capabilities</code>,\\n<code>warnings:sorted unique string[0..2048][0..1024]</code>, and\\n<code>extensions</code>. Provider ID, manifest digest, and adapter version equal\\nthe verified Manifest and host values. Environment Tuple contains exactly\\n<code>environment_id</code>, <code>environment_version</code>,\\n<code>platform=linux|macos|windows|wsl2</code>,\\n<code>architecture=amd64|arm64</code>,\\n<code>store_schema_fingerprint</code>, and <code>adapter_version</code>; it\\nnever contains executable provenance.\\n\\nThe exact capability names are <code>native_discovery</code>,\\n<code>stable_snapshot</code>, <code>raw_capture</code>,\\n<code>canonical_read</code>, <code>canonical_write</code>,\\n<code>native_read_back</code>, <code>native_resume_plan</code>,\\n<code>official_import</code>, <code>same_environment_lossless_clone</code>,\\n<code>tool_history</code>, <code>usage_history</code>,\\n<code>compaction_history</code>, <code>subagent_graph</code>,\\n<code>opaque_reasoning_roundtrip</code>, and <code>workspace_binding</code>.\\nEach value contains exactly status, enabled, evidence, and detail; only\\n<code>status=available</code> permits <code>enabled=true</code>.\\n\\nEach capability value contains exactly\\n<code>status:available|conditional|unsupported|unknown</code>,\\n<code>enabled:boolean</code>,\\n<code>evidence:documented|probed|accepted_test|provider_contract|inferred|acceptance_required|none</code>,\\nand <code>detail:string[0..2048]</code>. Missing, extra, duplicated, malformed,\\nor contradictory facts invalidate the whole Probe and never mean unsupported.\\n\\nFor source and target, the host seals a closed\\n<code>SessionAdapterExecutionBinding</code> containing exactly\\n<code>role:source|target</code>, <code>provider_id:provider-id</code>,\\n<code>candidate_kind:builtin|external</code>,\\n<code>canonical_executable_path:string[1..4096]</code>,\\n<code>owner_identity:string[1..512]</code>,\\n<code>executable_sha256:digest</code>,\\n<code>provider_manifest_digest:digest</code>,\\n<code>session_adapter_manifest_digest:digest</code>, and\\n<code>verified_at:timestamp</code>. Before every call and\\ntarget mutation, these facts MUST equal freshly read trusted-candidate facts\\nand the Journal binding. A failed/partial read is an integrity failure; no\\nself-claim or publisher claim establishes trust.\\n\\nA target write requires available canonical-write or official-import,\\nnative-read-back, native-resume-plan, workspace-binding, Provider\\nportable-store and native-resume capabilities; exact execution bindings;\\naccepted non-revoked signed source/target tuple entries; and current fixture\\nplus bounded native-resume smoke evidence. <code>--force</code>, experimental\\nprofiles, and environment-name-only matches cannot bypass these gates. Unknown\\nsources may be archived only after safe byte enumeration; unknown targets never\\nwrite.\\n\\n### 7.9 Companion Directory Node protocol\\n\\nDirectory Node protocol <code>urn:ax:protocol:session-directory-node</code>\\n<code>2.0.0</code> is the current separately negotiated, read-mostly façade\\nbacked by the same per-environment implementation as Provider 2 and Session\\nAdapter 1. Directory Node protocol <code>1.0.0</code> remains an immutable\\nlegacy wire contract. Neither major adds operations to Provider 2, executes\\nContinuation Plans, or transports transcript/workspace bytes.\\n\\nThe exact major bindings are closed:\\n\\n| Protocol | Request | Response | Manifest | <code>probe.platform</code> vocabulary |\\n| --- | --- | --- | --- | --- |\\n| <code>1.0.0</code> | Directory Node Request <code>1.0.0</code> | Directory Node Response <code>1.0.0</code> | Directory Node Manifest <code>1.0.0</code> | <code>darwin\\\\|linux\\\\|windows</code> |\\n| <code>2.0.0</code> | Directory Node Request <code>2.0.0</code> | Directory Node Response <code>1.0.0</code> | Directory Node Manifest <code>1.0.0</code> | <code>macos\\\\|linux\\\\|wsl2\\\\|windows</code> |\\n\\nA v1 <code>darwin</code> request denotes the macOS host class defined by that\\npublished major, but <code>darwin</code> is not a valid v2 wire value and never\\nappears in an Environment Observation. A v1 request cannot express WSL2.\\nImplementations MUST validate the vocabulary belonging to the negotiated\\nmajor; they MUST NOT relabel a v1 envelope as v2, relabel a v2 envelope as v1,\\nor coerce an unknown token across majors. Implementations supporting v2 SHOULD\\nserve v1 concurrently for at least one stable specification release. Peers\\nchoose the highest mutually supported major and fail closed when no major is\\nshared.\\n\\nA fresh adapter invocation has no trusted manifest from which to discover the\\npeer's supported majors. The caller MUST therefore enumerate its locally\\nsupported Directory Node majors in strictly descending numeric order and make\\none <code>manifest</code> request for the highest not yet attempted major. Each\\nattempt MUST launch a fresh process; a process that returned or failed an\\nattempt is terminated and reaped and MUST NOT be reused for a lower major. The\\nrequest binds <code>protocol_version</code> and request\\n<code>schema_version</code> to the exact attempted <code>N.0.0</code> version and\\nuses an empty body.\\n\\nThere is exactly one downgrade trigger. The attempted process MUST return one\\nwell-framed Directory Node failure response whose <code>protocol</code>,\\n<code>protocol_version</code>, <code>request_id</code>, and\\n<code>operation=manifest</code> exactly echo the request and whose response\\n<code>schema_version</code> is the bound <code>1.0.0</code>, whose Structured\\nError 1.2 has\\n<code>code=incompatible_protocol</code>, <code>exit_code=6</code>, and\\n<code>retryable=false</code>, and then exit with status 6. Only that complete\\nresponse-plus-exit tuple authorizes the caller to launch a fresh process for\\nthe next lower locally supported major. The response is negotiation evidence,\\nnot trusted manifest data and not an ordinary retryable operation failure.\\n\",\n  \"original_output_bytes\": 17816,\n  \"original_output_tokens\": 4454,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
