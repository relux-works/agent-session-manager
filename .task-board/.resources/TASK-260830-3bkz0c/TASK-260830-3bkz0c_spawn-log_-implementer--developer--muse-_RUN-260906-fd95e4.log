{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb71","stream":{"kind":"session","id":"01a075ff-68a1-7c53-bd42-f28c0c61d002"},"sequence":1043,"recorded_at":1780531400002081,"record_type":"event","durability":"durable","causation_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"01319f54-880e-4865-b5c8-fc6dd7d16451","run_stream":{"kind":"run","id":"01319f54-880e-4865-b5c8-fc6dd7d16451"},"task_stream":{"kind":"task","id":"69c6dffe-d570-44e4-9c9e-e15295aee5ef"},"task_id":"69c6dffe-d570-44e4-9c9e-e15295aee5ef","event":{"kind":"output","task_id":"69c6dffe-d570-44e4-9c9e-e15295aee5ef","chunk":"Read text file `internal/provhost/surrogate_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// TestProductionEntriesRefuseLoneSurrogateEscapes proves the Section 1.6\n13|// decoder rule at every production entry that reads a wire body: a lone\n14|// \\ud800-style escape is refused before any member is trusted, so the\n15|// silent U+FFFD replacement encoding/json would perform is never\n16|// observed. The bodies below are otherwise uninterpretable on purpose:\n17|// the gate runs before member validation, so refusal must not depend on\n18|// the members being present.\n19|func TestProductionEntriesRefuseLoneSurrogateEscapes(t *testing.T) {\n20|\tlone := []byte(`{\"note\":\"ab\\ud800cd\"}`)\n21|\trows := []struct {\n22|\t\tname string\n23|\t\terr  error\n24|\t}{\n25|\t\t{\"manifest\", DecodeManifest(lone)},\n26|\t\t{\"probe\", DecodeProbe(lone)},\n27|\t\t{\"identity\", CheckIdentity(lone, \"antigravity\")},\n28|\t\t{\"identify result\", DecodeIdentifyResult(lone, \"antigravity\")},\n29|\t\t{\"quiesce\", quiesceErr(lone)},\n30|\t\t{\"spawn plan\", DecodeSpawnPlan(lone, \"codex\", ProfileYOLO, scalar.PlatformLinux)},\n31|\t\t{\"response envelope\", func() error {\n32|\t\t\t_, err := DecodeResponse(successFrame(t, testRequestID, `{\"provider_id\":\"pi\",\"tag\":\"a\\ud800b\"}`), mustUUIDv7(t, testRequestID))\n33|\t\t\treturn err\n34|\t\t}()},\n35|\t}\n36|\tfor _, row := range rows {\n37|\t\tt.Run(row.name, func(t *testing.T) {\n38|\t\t\trequireFrameRefusal(t, row.err, \"\", \"lone surrogate escape\")\n39|\t\t})\n40|\t}\n41|\tt.Run(\"status outcome\", func(t *testing.T) {\n42|\t\tbody := strings.Replace(string(preparedBody()), `\"prepared\"`, `\"pre\\ud800pared\"`, 1)\n43|\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n44|\t\trequireIntegrityRefusal(t, err, \"status body is lone surrogate escape\", \"\")\n45|\t})\n46|}\n47|\n48|// TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON derives the\n49|// surrogate verdict space from the code-point space and requires the\n50|// local gate (through decodeStrictObject) and canonicaljson to agree\n51|// on every vector. A hand-written vector set shared between two\n52|// implementations is literal-versus-literal: it proves both\n53|// implementations match the same hand list, and a mutant that narrows\n54|// one bound (a low-surrogate ceiling, one hex case range) survives\n55|// every vector that avoids it. Here the inputs are enumerated from\n56|// the space and the verdicts come from the independent\n57|// implementation, so a narrowed bound diverges from the oracle on\n58|// every vector it newly admits, and an over-broad gate diverges on\n59|// every vector it newly refuses. A drift in either direction reddens\n60|// here with the divergent bodies.\n61|//\n62|// Dimensions, each enumerated from the space or the gate's own range\n63|// constants, never from a hand-written boundary literal: every BMP\n64|// code unit as a \\uXXXX escape in lower- and uppercase hex; every\n65|// surrogate unit in all 16 hex case permutations; every high\n66|// surrogate paired with the derived low-boundary neighborhood\n67|// (offsets from the gate's low constants) plus one sample from each\n68|// out-of-range second class; sampled units in member-name,\n69|// nested-object, and array positions plus every surrogate unit in\n70|// member-name position; every BMP code point as raw UTF-8 (surrogate\n71|// units in their raw WTF-8 three-byte form, which the UTF-8 gate in\n72|// decodeStrictObject must refuse); enumerated malformed byte\n73|// patterns; and astral raw samples. Every vector is a top-level\n74|// object so both judges can rule on it.\n75|func TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON(t *testing.T) {\n76|\tconst sweepFloor = 200000\n77|\tcompared := 0\n78|\tdivergent := 0\n79|\tvar examples []string\n80|\tcompare := func(body []byte) {\n81|\t\tcompared++\n82|\t\t_, canonicalErr := canonicaljson.Canonicalize(body)\n83|\t\t_, gateFault := decodeStrictObject(body)\n84|\t\tif (canonicalErr != nil) != (gateFault != nil) {\n85|\t\t\tdivergent++\n86|\t\t\tif len(examples) < 10 {\n87|\t\t\t\texamples = append(examples, fmt.Sprintf(\"%q canonical.refuse=%v gate.refuse=%v\", body, canonicalErr != nil, gateFault != nil))\n88|\t\t\t}\n89|\t\t}\n90|\t}\n91|\tescapeBody := func(prefix string, unit int, upper bool) []byte {\n92|\t\tformat := `{\"a\":\"` + prefix + `\\u%04x\"}`\n93|\t\tif upper {\n94|\t\t\tformat = `{\"a\":\"` + prefix + `\\u%04X\"}`\n95|\t\t}\n96|\t\treturn []byte(fmt.Sprintf(format, unit))\n97|\t}\n98|\t// Every BMP code unit as an escape, both hex cases.\n99|\tfor unit := 0; unit <= 0xffff; unit++ {\n100|\t\tcompare(escapeBody(\"\", unit, false))\n101|\t\tcompare(escapeBody(\"\", unit, true))\n102|\t}\n103|\t// Every surrogate unit in all 16 hex case permutations: a gate\n104|\t// that parses one case differently from the other must still\n105|\t// match the oracle on each mix.\n106|\tfor unit := 0xd800; unit <= 0xdfff; unit++ {\n107|\t\tdigits := fmt.Sprintf(\"%04x\", unit)\n108|\t\tfor mask := 0; mask < 16; mask++ {\n109|\t\t\tvar mixed [4]byte\n110|\t\t\tfor nibble := 0; nibble < 4; nibble++ {\n111|\t\t\t\tc := digits[nibble]\n112|\t\t\t\tif mask&(1<<nibble) != 0 && c >= 'a' && c <= 'f' {\n113|\t\t\t\t\tc -= 'a' - 'A'\n114|\t\t\t\t}\n115|\t\t\t\tmixed[nibble] = c\n116|\t\t\t}\n117|\t\t\tcompare([]byte(`{\"a\":\"\\u` + string(mixed[:]) + `\"}`))\n118|\t\t}\n119|\t}\n120|\t// Every high surrogate paired with the low-boundary neighborhood\n121|\t// derived from the gate's own range constants: two units on each\n122|\t// side of each low bound, both bound endpoints, and the interior\n123|\t// midpoint, plus one sample from each out-of-range second class\n124|\t// (a high unit and the BMP unit just below the surrogate range).\n125|\t// The adjacent units outside the range (lowSurrogateMin-1,\n126|\t// lowSurrogateMax+1) are the lone-surrogate vectors that separate\n127|\t// the correct bound from an off-by-one narrowing: narrowing either\n128|\t// low bound newly admits a swept second and diverges from the\n129|\t// oracle there, while the endpoints (valid pairs) kill an\n130|\t// over-broad shift. Every value is a gate constant plus a small\n131|\t// offset, so no hand-written boundary literal can silently miss a\n132|\t// neighbor the way the old five-element list missed 0xdbff and\n133|\t// 0xe000.\n134|\tpairSeconds := []int{\n135|\t\tlowSurrogateMin - 2, lowSurrogateMin - 1,\n136|\t\tlowSurrogateMin, lowSurrogateMin + 1,\n137|\t\t(lowSurrogateMin + lowSurrogateMax) / 2,\n138|\t\tlowSurrogateMax - 1, lowSurrogateMax,\n139|\t\tlowSurrogateMax + 1, lowSurrogateMax + 2,\n140|\t\thighSurrogateMin, highSurrogateMax,\n141|\t\thighSurrogateMin - 1,\n142|\t}\n143|\tfor high := highSurrogateMin; high <= highSurrogateMax; high++ {\n144|\t\tfor _, second := range pairSeconds {\n145|\t\t\tcompare([]byte(fmt.Sprintf(`{\"a\":\"\\u%04x\\u%04x\"}`, high, second)))\n146|\t\t}\n147|\t}\n148|\t// Sampled units in every string position, plus every surrogate\n149|\t// unit in member-name position.\n150|\tfor unit := 0; unit <= 0xffff; unit += 64 {\n151|\t\tescaped := fmt.Sprintf(`\\u%04x`, unit)\n152|\t\tcompare([]byte(`{\"` + escaped + `\":1}`))\n153|\t\tcompare([]byte(`{\"a\":{\"b\":\"` + escaped + `\"}}`))\n154|\t\tcompare([]byte(`{\"a\":[\"` + escaped + `\"]}`))\n155|\t}\n156|\tfor unit := 0xd800; unit <= 0xdfff; unit++ {\n157|\t\tcompare([]byte(fmt.Sprintf(`{\"\\u%04x\":1}`, unit)))\n158|\t}\n159|\t// Every BMP code point as raw UTF-8. Surrogate units have no\n160|\t// UTF-8 encoding; their raw three-byte WTF-8 form is what the\n161|\t// decodeStrictObject UTF-8 gate must refuse.\n162|\tfor unit := 0; unit <= 0xffff; unit++ {\n163|\t\tbody := []byte(`{\"a\":\"`)\n164|\t\tswitch {\n165|\t\tcase unit >= 0xd800 && unit <= 0xdfff:\n166|\t\t\tbody = append(body, 0xe0|byte(unit>>12), 0x80|byte(unit>>6)&0x3f, 0x80|byte(unit)&0x3f)\n167|\t\tcase unit == '\"' || unit == '\\\\':\n168|\t\t\tbody = append(body, '\\\\', byte(unit))\n169|\t\tdefault:\n170|\t\t\tbody = append(body, string(rune(unit))...)\n171|\t\t}\n172|\t\tbody = append(body, `\"}`...)\n173|\t\tcompare(body)\n174|\t}\n175|\t// Enumerated malformed byte patterns inside a string.\n176|\tfor _, pattern := range [][]byte{\n177|\t\t{0xff}, {0xfe}, {0x80},\n178|\t\t{0xc0, 0xaf}, {0xe0, 0x80, 0xaf}, {0xf0, 0x80, 0x80, 0xaf},\n179|\t\t{0xf5, 0x80, 0x80, 0x80}, {0xe2, 0x82}, {0xf0, 0x9f, 0x98},\n180|\t\t{0xed, 0xa0, 0x80}, {0xed, 0xbf, 0xbf},\n181|\t} {\n182|\t\tbody := append([]byte(`{\"a\":\"`), pattern...)\n183|\t\tbody = append(body, `\"}`...)\n184|\t\tcompare(body)\n185|\t}\n186|\t// Astral raw samples, valid UTF-8 both judges accept.\n187|\tfor _, point := range []rune{0x10000, 0x1f600, 0x10ffff} {\n188|\t\tcompare([]byte(`{\"a\":\"` + string(point) + `\"}`))\n189|\t}\n190|\tif compared < sweepFloor {\n191|\t\tt.Fatalf(\"derived sweep compared %d vectors, below the %d floor; the enumeration is short, not the gate\", compared, sweepFloor)\n192|\t}\n193|\tif divergent != 0 {\n194|\t\tt.Fatalf(\"gate and canonicaljson diverge on %d of %d vectors, first %d:\\n  %s\", divergent, compared, len(examples), strings.Join(examples, \"\\n  \"))\n195|\t}\n196|\tt.Logf(\"surrogate sweep: gate agrees with canonicaljson on %d of %d vectors\", compared, compared)\n197|}"}}}
