{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ff","stream":{"kind":"session","id":"01a076b1-60f4-7002-8c54-5d0850ac3584"},"sequence":346,"recorded_at":1780531400000687,"record_type":"event","durability":"durable","causation_id":"24fa6c39-bbe1-434a-8195-377cf6e9ad13","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"24fa6c39-bbe1-434a-8195-377cf6e9ad13","run_stream":{"kind":"run","id":"24fa6c39-bbe1-434a-8195-377cf6e9ad13"},"task_stream":{"kind":"task","id":"7d0ef7cb-b584-49ee-a896-f7462e098b1a"},"task_id":"7d0ef7cb-b584-49ee-a896-f7462e098b1a","event":{"kind":"output","task_id":"7d0ef7cb-b584-49ee-a896-f7462e098b1a","chunk":"{\n  \"chunk_id\": \"exec-19-1\",\n  \"command\": \"task-board worktree invalidate-acceptance --help 2>&1 | head -n 60; echo ===; task-board worktree status STORY-260830-3drr2m 2>&1 | head -n 80\",\n  \"description\": \"Inspect invalidate-acceptance and worktree status\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Release an element from integrating after §6.2 invalidated its acceptance.\\n\\nWhen trunk advances on a path the accepted Change Request also changes,\\nintegration refuses with integration_base_moved and the Change Request is\\ndemoted to stale. Refresh, revalidation and a new review are meant to follow,\\nbut none of them is reachable while the element is still integrating: a producer\\nspawn refuses because the revision is no longer accepted, and set_status refuses\\nas outside the integration production path.\\n\\nThis is that exit, and it is deliberately not a side effect of the refusal: a\\nrefused integration replays no board mutation, so releasing the element is a\\nseparate action an operator takes after reading the refusal.\\n\\nIt authorizes nothing by assertion. The Change Request must ALREADY be stale,\\nwhich only §6.2 can make it, and the element must already be integrating.\\n\\nUsage:\\n  task-board worktree invalidate-acceptance <STORY-ID> [flags]\\n\\nFlags:\\n      --cr string       the element whose acceptance was invalidated\\n  -h, --help            help for invalidate-acceptance\\n      --reason string   operator reason, recorded verbatim\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\nSTORY-260830-3drr2m  active\\n  path:       .temp/STORY-260830-3drr2m/worktree (present)\\n  branch:     task-board/story/STORY-260830-3drr2m (present)\\n  base:       main\\n  tip:        82c38378fe79b3e2a3e9fa337c23643b856ba7ee\\n  tree:       clean\\n  lease:      held by RUN-260906-737631\\n  blocked:    story lease is held by run RUN-260906-737631\\n  change-req: TASK-260830-2z3se0 rev 7 checkpointed (repository_delta=present, 34 changed path(s))\\n  change-req: TASK-260830-3bkz0c rev 4 accepted (repository_delta=empty, 0 changed path(s))\\n  change-req: TASK-260830-ljkj8r rev 3 checkpointed (repository_delta=present, 29 changed path(s))\\n\",\n  \"original_output_bytes\": 2379,\n  \"original_output_tokens\": 595,\n  \"truncated\": false\n}"}}}
