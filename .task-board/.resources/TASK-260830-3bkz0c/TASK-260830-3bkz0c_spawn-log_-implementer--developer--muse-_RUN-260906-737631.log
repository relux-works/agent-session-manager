{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44f","stream":{"kind":"session","id":"01a076b1-60f4-7002-8c54-5d0850ac3584"},"sequence":130,"recorded_at":1780531400000255,"record_type":"event","durability":"durable","causation_id":"24fa6c39-bbe1-434a-8195-377cf6e9ad13","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"24fa6c39-bbe1-434a-8195-377cf6e9ad13","run_stream":{"kind":"run","id":"24fa6c39-bbe1-434a-8195-377cf6e9ad13"},"task_stream":{"kind":"task","id":"c9663898-0ef4-43a6-b60d-aeddabed7239"},"task_id":"c9663898-0ef4-43a6-b60d-aeddabed7239","event":{"kind":"output","task_id":"c9663898-0ef4-43a6-b60d-aeddabed7239","chunk":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"task-board handoff --help 2>&1 | head -n 120; echo ===; task-board worktree --help 2>&1 | head -n 120; echo ===; echo \\\"TASK_BOARD_DIR=$TASK_BOARD_DIR\\\"; pwd; git branch --show-current; git status --porcelain=v1; echo ---; ls /Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board/ 2>&1 | head -n 40\",\n  \"description\": \"Inspect handoff and worktree commands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Resolve the configured role end status, verify every checklist item and\\nat least one stored task-scoped outcome resource, and apply the ordinary\\ncascading status transition under one mutation lock.\\n\\nThe command fails closed with all missing evidence and does not change status.\\nAttach or update the outcome with the resource or mutation CLI before handoff.\\n\\nUsage:\\n  task-board handoff <ELEMENT-ID> [flags]\\n\\nFlags:\\n      --commit-ack string   Mover acknowledgement for an enforced done transition\\n      --format string       Output format: compact or json (default \\\"compact\\\")\\n  -h, --help                help for handoff\\n      --role string         Role whose configured end_status must be applied\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n===\\nInspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n===\\nTASK_BOARD_DIR=/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board\\n/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree\\ntask-board/story/STORY-260830-3drr2m\\n---\\nEPIC-260829-dz9yvx_implementation-repository-foundation\\nEPIC-260830-1ewjla_advisory-human-validation\\nEPIC-260830-1uwj54_m1-single-host-durability\\nEPIC-260830-27bix9_m3-daily-driver-tmux\\nEPIC-260830-37rgqn_m0-contract-foundation\\nEPIC-260830-391tge_m4-cloning-directory-platform-release-hardening\\nEPIC-260830-3v9jlg_m2-multi-host-preview\\n\",\n  \"original_output_bytes\": 3911,\n  \"original_output_tokens\": 978,\n  \"truncated\": false\n}"}}}
