{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f9","stream":{"kind":"session","id":"01a0ae2b-e184-7c10-8d9d-bac4c231b352"},"sequence":343,"recorded_at":1780531400000681,"record_type":"event","durability":"durable","causation_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","run_stream":{"kind":"run","id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2"},"task_stream":{"kind":"task","id":"01a0ae2c-b80b-7131-8380-e47d5f1ce811"},"task_id":"01a0ae2c-b80b-7131-8380-e47d5f1ce811","event":{"kind":"output","task_id":"01a0ae2c-b80b-7131-8380-e47d5f1ce811","chunk":"Read text file `internal/provhost/identity_bind.go`.\n(499 line(s) above)\n500|\n501|// isBareAbsolute reports whether the path starts with an absolute\n502|// prefix on any platform: a forward slash, a UNC backslash pair, or a\n503|// drive letter with a separator. Home and XDG roots arrive before any\n504|// platform is selected, so the check cannot be platform-native; the\n505|// proof-root rule beside it is, through isAbsoluteOn.\n506|func isBareAbsolute(path string) bool {\n507|\treturn strings.HasPrefix(path, \"/\") || strings.HasPrefix(path, `\\\\`) || windowsDrivePattern.MatchString(path)\n508|}\n509|\n510|// rootContains reports whether the observed proof root equals the\n511|// expected store root or sits under it: discovery of a session inside\n512|// a project-keyed subdirectory still counts as discovery in the\n513|// provider's store. Comparison is byte-exact and separator-aware, so a\n514|// sibling whose name merely extends the root prefix is outside.\n515|func rootContains(expected, observed string) bool {\n516|\tif expected == observed {\n517|\t\treturn true\n518|\t}\n519|\trelative, err := filepath.Rel(expected, observed)\n520|\tif err != nil {\n521|\t\treturn false\n522|\t}\n523|\treturn relative != \"..\" && !strings.HasPrefix(relative, \"..\"+string(filepath.Separator))\n524|}","final_result":true}}}
