SS: ${gate}\\\" cigate-contracts.log\\n          done\\n\\n  lint:\\n    name: Linters (vet, Windows vet, gofmt)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Vet\\n        run: go vet ./...\\n\\n      - name: Vet Windows build-tagged sources\\n        run: GOOS=windows go vet ./...\\n\\n      # gofmt lists only offending files, so a clean tree prints nothing.\\n      # The file count proves the scan was not empty; the log must then be.\\n      - name: Check formatting\\n        run: |\\n          count=$(find internal -name '*.go' | wc -l | tr -d ' ')\\n          echo \\\"go files scanned: ${count}\\\"\\n          test \\\"${count}\\\" -gt 0\\n          set +e\\n          gofmt -l internal > gofmt.log 2>&1\\n          code=$?\\n          set -e\\n          cat gofmt.log\\n          test $code -eq 0\\n          test ! -s gofmt.log\\n\\n  test:\\n    name: Build and test (no cache)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Build\\n        run: go build ./...\\n\\n      # Verbose on purpose: the --- SKIP lines are the suite-wide skip\\n      # datum. At least one package must report ok: a suite that matched\\n      # nothing is a failure, not a pass.\\n      - name: Test\\n        run: |\\n          set +e\\n          go test ./... -v -count=1 > test.log 2>&1\\n          code=$?\\n          set -e\\n          cat test.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  race:\\n    name: Race detector\\n    runs-on: ubuntu-latest\\n\",\n  \"original_output_bytes\": 3122,\n  \"original_output_tokens\": 781,\n  \"truncated\": false\n}","final_result":true}}}
