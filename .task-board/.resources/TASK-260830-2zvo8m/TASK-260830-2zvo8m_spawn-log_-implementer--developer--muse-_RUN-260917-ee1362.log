{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c887","stream":{"kind":"session","id":"01a0ae2b-e184-7c10-8d9d-bac4c231b352"},"sequence":670,"recorded_at":1780531400001335,"record_type":"event","durability":"durable","causation_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","run_stream":{"kind":"run","id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2"},"task_stream":{"kind":"task","id":"01a0ae2e-3fc2-7aa0-85b9-47b35feb50a0"},"task_id":"01a0ae2e-3fc2-7aa0-85b9-47b35feb50a0","event":{"kind":"output","task_id":"01a0ae2e-3fc2-7aa0-85b9-47b35feb50a0","chunk":"Read text file `internal/provhost/identity.go`.\n(396 line(s) above)\n397|var identifyMembers = map[string]bool{\n398|\t\"identity\":         true,\n399|\t\"confidence\":       true,\n400|\t\"matched_evidence\": true,\n401|}\n402|\n403|// identifyRequired lists identifyMembers in a fixed order.\n404|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n405|\n406|// identifyConfidences is the closed confidence vocabulary.\n407|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n408|\n409|// identifyEvidence is the closed matched-evidence vocabulary.\n410|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n411|\n412|// DecodeIdentifyResult validates one identify-session success body:\n413|// the Provider Identity Record for the expected provider, a closed\n414|// confidence, and 1..4 sorted unique matched-evidence members.\n415|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n416|\tmembers, fault := decodeStrictObject(body)\n417|\tif fault != nil {\n418|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n419|\t\tif err != nil {\n420|\t\t\treturn err\n421|\t\t}\n422|\t\treturn failure\n423|\t}\n424|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n425|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n426|\t\tif err != nil {\n427|\t\t\treturn err\n428|\t\t}\n429|\t\treturn failure\n430|\t}\n431|\tif name, missing := missingMember(members, identifyRequired); missing {\n432|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n433|\t\tif err != nil {\n434|\t\t\treturn err\n435|\t\t}\n436|\t\treturn failure\n437|\t}\n438|\tconfidence, ok := rawString(members[\"confidence\"])\n439|\tif !ok || !isIdentifyConfidence(confidence) {\n440|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n441|\t\tif err != nil {\n442|\t\t\treturn err\n443|\t\t}\n444|\t\treturn failure\n445|\t}\n446|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n447|\t\treturn err\n448|\t}\n449|\tif !isJSONObject(members[\"identity\"]) {\n450|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n451|\t\tif err != nil {\n452|\t\t\treturn err\n453|\t\t}\n454|\t\treturn failure\n455|\t}\n456|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n457|\t\treturn err\n458|\t}\n459|\treturn nil\n460|}\n461|\n462|func isIdentifyConfidence(value string) bool {\n463|\tfor _, confidence := range identifyConfidences {\n464|\t\tif value == confidence {\n465|\t\t\treturn true\n466|\t\t}\n467|\t}\n468|\treturn false\n469|}\n470|\n471|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n472|// evidence members: the observation must cite what matched, exactly\n473|// once each.\n474|func checkIdentifyEvidence(raw json.RawMessage) error {\n475|\tevidence, ok := rawStringArray(raw)\n476|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n477|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n478|\t\tif err != nil {\n479|\t\t\treturn err\n480|\t\t}\n481|\t\treturn failure\n482|\t}\n483|\tallowed := map[string]bool{}\n484|\tfor _, member := range identifyEvidence {\n485|\t\tallowed[member] = true\n486|\t}\n487|\tfor _, member := range evidence {\n488|\t\tif !allowed[member] {\n489|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n490|\t\t\tif err != nil {\n491|\t\t\t\treturn err\n492|\t\t\t}\n493|\t\t\treturn failure\n494|\t\t}\n495|\t}\n496|\tif !sortedUniqueStrings(evidence) {\n497|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n498|\t\tif err != nil {\n499|\t\t\treturn err\n500|\t\t}\n501|\t\treturn failure\n502|\t}\n503|\treturn nil\n504|}","final_result":true}}}
