{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cea1","stream":{"kind":"session","id":"01a0ae2b-e184-7c10-8d9d-bac4c231b352"},"sequence":1451,"recorded_at":1780531400002897,"record_type":"event","durability":"durable","causation_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","run_stream":{"kind":"run","id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2"},"task_stream":{"kind":"task","id":"01a0ae36-ebd3-7de2-8a31-9c3eb3e0ea12"},"task_id":"01a0ae36-ebd3-7de2-8a31-9c3eb3e0ea12","event":{"kind":"output","task_id":"01a0ae36-ebd3-7de2-8a31-9c3eb3e0ea12","chunk":"edited\nchanged lines: lines 270-329\n--- original\n+++ updated\n@@\n-// checkVerdictConsistent requires the stored verdict to equal the\n-// verdict the cell and checks derive: unsupported and unknown cells\n-// refuse, any failed check fails, a conditional cell gates, and only\n-// an available cell with no failure and no unexpected skip passes.\n-// A promotion that flips the verdict without rewriting the check\n-// list refuses here even with a recomputed digest.\n-func checkVerdictConsistent(record Record) error {\n-\tvar want Verdict\n-\tswitch record.ResumeCell {\n-\tcase CellUnsupported:\n-\t\twant = VerdictUnsupported\n-\tcase CellUnknown:\n-\t\twant = VerdictUnknown\n-\tdefault:\n-\t\tfailed := false\n-\t\tfor _, check := range record.Checks {\n-\t\t\tif check.Outcome == OutcomeFail {\n-\t\t\t\tfailed = true\n-\t\t\t}\n-\t\t}\n-\t\tswitch {\n-\t\tcase failed:\n-\t\t\twant = VerdictFail\n-\t\tcase record.ResumeCell == CellConditional:\n-\t\t\twant = VerdictGated\n-\t\tdefault:\n-\t\t\twant = VerdictPass\n-\t\t\tfor _, check := range record.Checks {\n-\t\t\t\tif check.Outcome == OutcomeSkipped && check.Name != checkQuiescence {\n-\t\t\t\t\twant = VerdictFail\n-\t\t\t\t}\n-\t\t\t}\n-\t\t}\n-\t}\n-\tif record.Verdict != want {\n-\t\treturn fmt.Errorf(\"smoke record verdict %q is inconsistent with its checks\", record.Verdict)\n-\t}\n-\treturn nil\n-}\n-\n-// deriveVerdict computes the run verdict from the cell and the check\n-// outcomes under the same rule verification enforces, so a run can\n-// never emit an inconsistent record.\n-func deriveVerdict(cell Cell, checks []Check) Verdict {\n-\tswitch cell {\n-\tcase CellUnsupported:\n-\t\treturn VerdictUnsupported\n-\tcase CellUnknown:\n-\t\treturn VerdictUnknown\n-\t}\n-\tfor _, check := range checks {\n-\t\tif check.Outcome == OutcomeFail {\n-\t\t\treturn VerdictFail\n-\t\t}\n-\t}\n-\tif cell == CellConditional {\n-\t\treturn VerdictGated\n-\t}\n-\treturn VerdictPass\n-}\n+// checkVerdictConsistent requires the stored verdict to equal the\n+// verdict the cell and checks derive. A promotion that flips the\n+// verdict without rewriting the check list refuses here even with a\n+// recomputed digest.\n+func checkVerdictConsistent(record Record) error {\n+\tif want := deriveVerdict(record.ResumeCell, record.Checks); record.Verdict != want {\n+\t\treturn fmt.Errorf(\"smoke record verdict %q is inconsistent with its checks\", record.Verdict)\n+\t}\n+\treturn nil\n+}\n+\n+// deriveVerdict computes the run verdict from the cell and the check\n+// outcomes: unsupported and unknown cells refuse, any failed check\n+// fails, a conditional cell gates, and only an available cell with\n+// no failure and no unexpected skip passes. Runs and verification\n+// share this single rule, so a run can never emit an inconsistent\n+// record.\n+func deriveVerdict(cell Cell, checks []Check) Verdict {\n+\tswitch cell {\n+\tcase CellUnsupported:\n+\t\treturn VerdictUnsupported\n+\tcase CellUnknown:\n+\t\treturn VerdictUnknown\n+\t}\n+\tfor _, check := range checks {\n+\t\tif check.Outcome == OutcomeFail {\n+\t\t\treturn VerdictFail\n+\t\t}\n+\t}\n+\tif cell == CellConditional {\n+\t\treturn VerdictGated\n+\t}\n+\tfor _, check := range checks {\n+\t\tif check.Outcome == OutcomeSkipped && check.Name != checkQuiescence {\n+\t\t\treturn VerdictFail\n+\t\t}\n+\t}\n+\treturn VerdictPass\n+}\n","final_result":true}}}
