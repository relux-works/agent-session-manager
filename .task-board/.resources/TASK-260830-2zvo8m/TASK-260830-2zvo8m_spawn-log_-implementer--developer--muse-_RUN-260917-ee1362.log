{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d1","stream":{"kind":"session","id":"01a0ae2b-e184-7c10-8d9d-bac4c231b352"},"sequence":451,"recorded_at":1780531400000897,"record_type":"event","durability":"durable","causation_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","run_stream":{"kind":"run","id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2"},"task_stream":{"kind":"task","id":"01a0ae2d-5e5f-7d30-89c6-23c6941f3678"},"task_id":"01a0ae2d-5e5f-7d30-89c6-23c6941f3678","event":{"kind":"output","task_id":"01a0ae2d-5e5f-7d30-89c6-23c6941f3678","chunk":"Read text file `internal/provhost/runner.go`.\n(279 line(s) above)\n280|\t}\n281|\tif len(data) > cap {\n282|\t\treturn data[:cap], nil\n283|\t}\n284|\treturn data, nil\n285|}\n286|\n287|// Host invokes provider plugins: one process per operation, one frame in,\n288|// one frame out, under the request deadline. Host keeps no cross-call\n289|// state, so successive calls are separate processes observing durable\n290|// state through the authority the caller passes.\n291|type Host struct {\n292|\t// Runner starts the plugin process. It must be set; a nil Runner is\n293|\t// a caller error, refused before any frame is built.\n294|\tRunner Runner\n295|\t// Now is the clock deadlines are checked against. Nil means the\n296|\t// system clock; tests supply a fixed instant.\n297|\tNow func() time.Time\n298|}\n299|\n300|func (host Host) now() time.Time {\n301|\tif host.Now == nil {\n302|\t\treturn time.Now()\n303|\t}\n304|\treturn host.Now()\n305|}\n306|\n307|// splitFrame separates the single response line from anything following\n308|// it. oversize reports a first line beyond MaxFrameBytes; extra reports\n309|// any bytes after the first line terminator. An empty line is neither:\n310|// it is a missing response, judged with the exit code by the caller.\n311|//\n312|// The checks are length-only and exact: stdout capture holds at most\n313|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n314|// trailing byte, is always visible in the captured length. No separate\n315|// truncation flag participates; a narrowed or dropped disjunct here\n316|// would be equivalent, not coverage.\n317|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n318|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n319|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n320|\t}\n321|\treturn captured, len(captured) > MaxFrameBytes, false\n322|}\n323|\n324|// Call dispatches one operation: it frames the request, starts one plugin\n325|// process, enforces the request deadline, and interprets the single\n326|// response frame. Encode failures return before the Runner is touched, so\n327|// an unknown operation never starts a process. A success envelope returns\n328|// its body; a failure envelope returns the bound child error; anything\n329|// else returns a local failure that trusts nothing from the plugin.\n330|//\n331|// Deadline accounting is exact: the wait ends under a context cut at the\n332|// request deadline, and provider_timeout is reported only when that\n333|// instant actually passed. A parent cancellation first, or any other\n334|// runner failure with time remaining, is provider_process_failed. An\n335|// empty stdout with time remaining is a missing response:\n336|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n337|// An empty stdout after the deadline passed is provider_timeout, and a\n338|// valid frame governs regardless of lateness or exit status.\n339|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n340|\tif host.Runner == nil {\n341|\t\tfailure, err := failInvalid(\"host has no runner\")\n342|\t\tif err != nil {\n343|\t\t\treturn Response{}, err\n344|\t\t}\n345|\t\treturn Response{}, failure\n346|\t}\n347|\tframe, deadline, err := encodeFrame(req, host.now())\n348|\tif err != nil {\n349|\t\treturn Response{}, err\n350|\t}\n351|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n352|\tdefer cancel()\n353|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n354|\tif err != nil {\n355|\t\tnow := host.now()\n356|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n357|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n358|\t\t\tif fault != nil {\n359|\t\t\t\treturn Response{}, fault\n360|\t\t\t}\n361|\t\t\treturn Response{}, failure\n362|\t\t}\n363|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n364|\t\tif fault != nil {\n365|\t\t\treturn Response{}, fault\n366|\t\t}\n367|\t\treturn Response{}, failure\n368|\t}\n369|\tline, oversize, extra := splitFrame(result.Stdout)\n370|\tif oversize {\n371|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n372|\t\tif fault != nil {\n373|\t\t\treturn Response{}, fault\n374|\t\t}\n375|\t\treturn Response{}, failure\n376|\t}\n377|\tif extra {\n378|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n379|\t\tif fault != nil {\n380|\t\t\treturn Response{}, fault\n381|\t\t}\n382|\t\treturn Response{}, failure\n383|\t}\n384|\tif len(line) == 0 {\n385|\t\t// No valid response arrived. When the request deadline passed,\n386|\t\t// this is the timeout even if the process also exited badly:\n387|\t\t// the host waited the full allowance and got nothing usable.\n388|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n389|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n390|\t\t\tif fault != nil {\n391|\t\t\t\treturn Response{}, fault\n392|\t\t\t}\n393|\t\t\treturn Response{}, failure\n394|\t\t}\n395|\t\tif result.ExitCode != 0 {\n396|\t\t\tfailure, fault := 