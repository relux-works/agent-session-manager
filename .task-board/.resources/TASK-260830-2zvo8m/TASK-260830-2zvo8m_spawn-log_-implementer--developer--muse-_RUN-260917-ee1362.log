{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caf1","stream":{"kind":"session","id":"01a0ae2b-e184-7c10-8d9d-bac4c231b352"},"sequence":979,"recorded_at":1780531400001953,"record_type":"event","durability":"durable","causation_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","run_stream":{"kind":"run","id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2"},"task_stream":{"kind":"task","id":"01a0ae32-a250-7ea0-b953-92bb38b79a42"},"task_id":"01a0ae32-a250-7ea0-b953-92bb38b79a42","event":{"kind":"output","task_id":"01a0ae32-a250-7ea0-b953-92bb38b79a42","chunk":"{\n  \"chunk_id\": \"exec-34-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nd=json.load(open('internal/traceability/ownership.v0.6.0.json'))\\nfor e in d['ownership']:\\n    if e.get('kind')=='section_binding' and any(s in json.dumps(e.get('keys',[])) for s in ['2.4','5.5','7.7','section:8']):\\n        print(json.dumps(e,indent=1)[:1200]); print('======')\\n\\\" | head -80\",\n  \"description\": \"Show section bindings for story sections\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:2.4\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/canonicaljson/closed_shapes.go\\\",\\n  \\\"declaration\\\": \\\"validateSessionRecordCommon\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"canonical-object-identity\\\",\\n  \\\"canonical-identity-refusal\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"validateSessionRecordCommon validates the Section 2.4 execution-profile enum value only; profile selection, first-use confirmation and downgrade behaviour are not implemented, and no clause of Section 2.4 is enumerated.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:5.5\\\"\\n