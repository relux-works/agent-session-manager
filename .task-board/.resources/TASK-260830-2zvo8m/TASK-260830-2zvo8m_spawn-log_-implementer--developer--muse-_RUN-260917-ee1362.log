{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c883","stream":{"kind":"session","id":"01a0ae2b-e184-7c10-8d9d-bac4c231b352"},"sequence":668,"recorded_at":1780531400001331,"record_type":"event","durability":"durable","causation_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2","run_stream":{"kind":"run","id":"be9157de-ded3-4e9d-94df-e7cb793fb0f2"},"task_stream":{"kind":"task","id":"01a0ae2e-3f7c-78e3-9518-0575db73332b"},"task_id":"01a0ae2e-3f7c-78e3-9518-0575db73332b","event":{"kind":"output","task_id":"01a0ae2e-3f7c-78e3-9518-0575db73332b","chunk":"Read text file `internal/provhost/probe.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.4 Capability result: the closed\n8|// urn:ax:schema:provider-probe 1.0.0 object a probe operation returns\n9|// as its success body. It also owns the host-side availability gate:\n10|// only available MAY be enabled, and the host MUST NOT treat a\n11|// conditional, unsupported, or unknown capability as usable, no matter\n12|// what enabled claims.\n13|\n14|// probeSchema is the exact schema identifier the probe carries.\n15|const probeSchema = \"urn:ax:schema:provider-probe\"\n16|\n17|// probeSchemaVersion is the only probe version this host accepts.\n18|const probeSchemaVersion = \"1.0.0\"\n19|\n20|// Probe capability statuses Section 7.4 defines. Only Available MAY\n21|// set enabled true; every other status MUST NOT be advertised as\n22|// usable, which CapabilityUsable enforces.\n23|const (\n24|\tCapabilityAvailable   = \"available\"\n25|\tCapabilityConditional = \"conditional\"\n26|\tCapabilityUnsupported = \"unsupported\"\n27|\tCapabilityUnknown     = \"unknown\"\n28|)\n29|\n30|// probeCapabilityStatuses is the closed status vocabulary in the\n31|// Section 7.4 order.\n32|var probeCapabilityStatuses = []string{\n33|\tCapabilityAvailable,\n34|\tCapabilityConditional,\n35|\tCapabilityUnsupported,\n36|\tCapabilityUnknown,\n37|}\n38|\n39|// Probe capability evidence Section 7.4 defines, in section order.\n40|var probeCapabilityEvidence = []string{\n41|\t\"documented\",\n42|\t\"probed\",\n43|\t\"accepted_test\",\n44|\t\"provider_contract\",\n45|\t\"inferred\",\n46|\t\"acceptance_required\",\n47|\t\"none\",\n48|}\n49|\n50|// probeArchitectures is the closed architecture vocabulary.\n51|var probeArchitectures = []string{\"amd64\", \"arm64\"}\n52|\n53|// probePlatforms is the closed platform vocabulary: the four Section\n54|// 7.3 enums. WSL2 and native Windows are distinct rows; one never\n55|// stands for the other.\n56|var probePlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n57|\n58|// probeMembers is the exact required member set DecodeProbe accepts.\n59|var probeMembers = map[string]bool{\n60|\t\"schema\":           true,\n61|\t\"schema_version\":   true,\n62|\t\"provider_id\":      true,\n63|\t\"provider_version\": true,\n64|\t\"platform\":         true,\n65|\t\"architecture\":     true,\n66|\t\"capabilities\":     true,\n67|\t\"warnings\":         true,\n68|}\n69|\n70|// probeRequired lists probeMembers in a fixed order so a body missing\n71|// several members always names the same one.\n72|var probeRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"provider_id\",\n76|\t\"provider_version\",\n77|\t\"platform\",\n78|\t\"architecture\",\n79|\t\"capabilities\",\n80|\t\"warnings\",\n81|}\n82|\n83|// probeCapabilityMembers is the exact member set of one capability\n84|// value: status, enabled, evidence, and detail, nothing else.\n85|var probeCapabilityMembers = map[string]bool{\n86|\t\"status\":   true,\n87|\t\"enabled\":  true,\n88|\t\"evidence\": true,\n89|\t\"detail\":   true,\n90|}\n91|\n92|// probeCapabilityRequired lists probeCapabilityMembers in a fixed\n93|// order so a value missing several members always names the same one.\n94|var probeCapabilityRequired = []string{\"status\", \"enabled\", \"evidence\", \"detail\"}\n95|\n96|// DecodeProbe validates one probe-operation success body as the closed\n97|// Section 7.4 probe object. It returns nil on a well-formed probe and\n98|// a provider_protocol_error naming the offending member otherwise. A\n99|// capability that claims enabled under any status but available is\n100|// refused here, not at use time: an advertised-but-unusable surface\n101|// must never reach the caller as a probe result.\n102|func DecodeProbe(body []byte) error {\n103|\t_, err := decodeValidatedProbe(body)\n104|\treturn err\n105|}\n106|\n107|// decodeValidatedProbe is the single site that decodes a probe body\n108|// into members: every check DecodeProbe performs lives here, and the\n109|// validated members are returned for use sites to consume. Validation\n110|// and use couple here on purpose — RequireCapability must consume\n111|// these members rather than re-decoding the body after a separate\n112|// DecodeProbe call, so a future reorder cannot silently drop faults\n113|// between the validation and the use. Keep the validation first at\n114|// every caller: the sub-object replays below prove nothing on their\n115|// own.\n116|func decodeValidatedProbe(body []byte) (map[string]json.RawMessage, error) {\n117|\tmembers, fault := decodeStrictObject(body)\n118|\tif fault != nil {\n119|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n120|\t\tif err != nil {\n121|\t\t\treturn nil, err\n122|\t\t}\n123|\t\treturn nil, failure\n124|\t}\n125|\tif name, unknown := unknownMember(members, probeMembers); unknown {\n126|\t\tfailure, err := failProtocol(\"probe carries unknown member\", name)\n127|\t\tif err != nil {\n128|\t\t\treturn nil, err\n129|\t\t}\n130|\t\treturn nil, failure\n131|\t}\n132|\tif name, missing := missingMember(members, probeRequired); missing {\n133|\t\tfailure, err := failProtocol(\"probe misses a required member\", name)\n134|\t\tif err != nil {\n135|\t\t\treturn nil, err\n136|\t\t}\n137|\t\treturn nil, failure\n138|\t}\n139|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != probeSchema {\n140|\t\tfailure, err := failProtocol(\"probe schema is not the provider probe\", \"schema\")\n141|\t\tif err != nil {\n142|\t\t\treturn nil, err\n143|\t\t}\n144|\t\treturn nil, failure\n145|\t}\n146|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != probeSchemaVersion {\n147|\t\tfailure, err := failProtocol(\"probe schema_version is not 1.0.0\", \"schema_version\")\n148|\t\tif err != nil {\n149|\t\t\treturn nil, err\n150|\t\t}\n151|\t\treturn nil, failure\n152|\t}\n153|\tif provider, ok := rawString(members[\"provider_id\"]); !ok || !validProviderID(provider) {\n154|\t\tfailure, err := failProtocol(\"probe provider_id is not a provider id\", \"provider_id\")\n155|\t\tif err != nil {\n156|\t\t\treturn nil, err\n157|\t\t}\n158|\t\treturn nil, failure\n159|\t}\n160|\tif version, ok := rawString(members[\"provider_version\"]); !ok || runeLength(version) < 1 || runeLength(version) > 128 {\n161|\t\tfailure, err := failProtocol(\"probe provider_version is not 1..128 characters\", \"provider_version\")\n162|\t\tif err != nil {\n163|\t\t\treturn nil, err\n164|\t\t}\n165|\t\treturn nil, failure\n166|\t}\n167|\tif platform, ok := rawString(members[\"platform\"]); !ok || !isProbePlatform(platform) {\n168|\t\tfailure, err := failProtocol(\"probe platform is not a registry member\", \"platform\")\n169|\t\tif err != nil {\n170|\t\t\treturn nil, err\n171|\t\t}\n172|\t\treturn nil, failure\n173|\t}\n174|\tif architecture, ok := rawString(members[\"architecture\"]); !ok || !isProbeArchitecture(architecture) {\n175|\t\tfailure, err := failProtocol(\"probe architecture is not amd64 or arm64\", \"architecture\")\n176|\t\tif err != nil {\n177|\t\t\treturn nil, err\n178|\t\t}\n179|\t\treturn nil, failure\n180|\t}\n181|\tif err := checkProbeCapabilities(members[\"capabilities\"]); err != nil {\n182|\t\treturn nil, err\n183|\t}\n184|\tif err := checkProbeWarnings(members[\"warnings\"]); err != nil {\n185|\t\treturn nil, err\n186|\t}\n187|\treturn members, nil\n188|}\n189|\n190|func isProbePlatform(value string) bool {\n(more lines below)","final_result":true}}}
