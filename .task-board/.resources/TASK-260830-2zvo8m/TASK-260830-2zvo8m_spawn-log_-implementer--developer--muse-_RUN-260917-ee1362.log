.go\\nrunner_env_test.go\\nrunner_test.go\\nrunner_unix.go\\nrunner_windows.go\\nrunner.go\\nspawn_test.go\\nspawn.go\\nstatus_test.go\\nstatus.go\\nsurrogate_test.go\\nsurrogate.go\\ntestdata\\nTRACEABILITY.md\\n\\ninternal/sessprofile:\\ncrash_test.go\\ndecode.go\\ndoc.go\\nfixtures_e2e_test.go\\nfixtures_test.go\\nmint_test.go\\nmint.go\\npairs_test.go\\npairs.go\\nprofile_test.go\\nprofile.go\\nproject.go\\nsetprofile_test.go\\nsetprofile.go\\ntestdata\\n\\ninternal/specdoc:\\nembed_reach_test.go\\nSPEC.md\\nSPEC.v0.6.0.md\\nspecdoc_test.go\\nspecdoc.go\\nspecdoc060_test.go\\n\\ninternal/traceability:\\nadoption-v0.6.0.md\\ncmd\\nownership.v0.5.0.json\\nownership.v0.6.0.json\\nreadme_figures_pin_test.go\\ntraceability_test.go\\ntraceability.go\\n     223 internal/specdoc/embed_reach_test.go\\n   12665 internal/specdoc/SPEC.md\\n   16453 internal/specdoc/SPEC.v0.6.0.md\\n     429 internal/specdoc/specdoc_test.go\\n     421 internal/specdoc/specdoc.go\\n     183 internal/specdoc/specdoc060_test.go\\n   30374 total\\n\",\n  \"original_output_bytes\": 1903,\n  \"original_output_tokens\": 476,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
