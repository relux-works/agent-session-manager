{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc81","stream":{"kind":"session","id":"01a0aea4-a602-7083-bf0e-7964935feca1"},"sequence":1179,"recorded_at":1780531400002353,"record_type":"event","durability":"durable","causation_id":"bc9a7f38-db06-4e74-8937-112c51b35a5b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bc9a7f38-db06-4e74-8937-112c51b35a5b","run_stream":{"kind":"run","id":"bc9a7f38-db06-4e74-8937-112c51b35a5b"},"call_id":"call_01a0aea9db4477cd9aaa4444d43b0869","text":"Read text file `internal/resumesmoke/record_verify_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"encoding/json\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n11|)\n12|\n13|// This file attacks the smoke record itself: tampered bytes,\n14|// promotion attempts, inconsistent verdicts, and non-canonical\n15|// encodings must all refuse on re-read.\n16|\n17|// TestSmokeTamperedRecordRefuses proves one flipped byte anywhere\n18|// in an installed record refuses on re-read, for passing and gated\n19|// records alike: integrity is not verdict-scoped.\n20|func TestSmokeTamperedRecordRefuses(t *testing.T) {\n21|\tfor _, tuple := range []provhost.BuildTuple{\n22|\t\t{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"},\n23|\t\t{ProviderID: \"gemini\", ProviderVersion: \"0.54.4\", Platform: \"wsl2\", Architecture: \"amd64\"},\n24|\t} {\n25|\t\treport := runRowFixture(t, tuple)\n26|\t\tfor _, index := range []int{0, len(report.Bytes) / 2, len(report.Bytes) - 2} {\n27|\t\t\ttampered := bytes.Clone(report.Bytes)\n28|\t\t\ttampered[index] ^= 0x01\n29|\t\t\tif _, err := VerifyRecord(tampered); err == nil {\n30|\t\t\t\tt.Fatalf(\"VerifyRecord(tampered %s byte %d) = nil, want refusal\", tuple.ProviderID, index)\n31|\t\t\t}\n32|\t\t\tif _, _, err := Load(writeTempRecord(t, tampered)); err == nil {\n33|\t\t\t\tt.Fatalf(\"Load(tampered %s byte %d) = nil, want refusal\", tuple.ProviderID, index)\n34|\t\t\t}\n35|\t\t}\n36|\t}\n37|}\n38|\n39|// TestSmokePromotionAttemptRefuses proves a gated cell cannot be\n40|// promoted through the record: flipping the verdict to pass\n41|// refuses on the digest, and flipping it with a recomputed digest\n42|// still refuses on the verdict consistency rule, because the\n43|// gated resume plan is still in the check list.\n44|func TestSmokePromotionAttemptRefuses(t *testing.T) {\n45|\ttuple := provhost.BuildTuple{ProviderID: \"gemini\", ProviderVersion: \"0.54.4\", Platform: \"wsl2\", Architecture: \"amd64\"}\n46|\treport := runRowFixture(t, tuple)\n47|\tif report.Record.Verdict != VerdictGated {\n48|\t\tt.Fatalf(\"fixture verdict = %q, want gated\", report.Record.Verdict)\n49|\t}\n50|\tflipped := bytes.Replace(report.Bytes, []byte(`\"verdict\":\"gated\"`), []byte(`\"verdict\":\"pass\"`), 1)\n51|\tif bytes.Equal(flipped, report.Bytes) {\n52|\t\tt.Fatal(\"promotion fixture did not flip the verdict frame\")\n53|\t}\n54|\tif _, err := VerifyRecord(flipped); err == nil {\n55|\t\tt.Fatal(\"VerifyRecord(flipped verdict) = nil, want digest refusal\")\n56|\t}\n57|\tvar record Record\n58|\tif err := json.Unmarshal(report.Bytes, &record); err != nil {\n59|\t\tt.Fatalf(\"unmarshal gated record: %v\", err)\n60|\t}\n61|\trecord.Verdict = VerdictPass\n62|\tresigned, err := encodeRecord(record)\n63|\tif err != nil {\n64|\t\tt.Fatalf(\"encodeRecord: %v\", err)\n65|\t}\n66|\tif _, err := VerifyRecord(resigned); err == nil {\n67|\t\tt.Fatal(\"VerifyRecord(resigned promotion) = nil, want consistency refusal\")\n68|\t} else if !strings.Contains(err.Error(), \"inconsistent\") {\n69|\t\tt.Fatalf(\"VerifyRecord(resigned promotion) = %v, want the consistency refusal\", err)\n70|\t}\n71|}\n72|\n73|// TestSmokeInconsistentFailRefuses proves the consistency rule runs\n74|// in both directions: an available record whose checks all pass\n75|// cannot verify as a failure either.\n76|func TestSmokeInconsistentFailRefuses(t *testing.T) {\n77|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n78|\treport := runRowFixture(t, tuple)\n79|\tif report.Record.Verdict != VerdictPass {\n80|\t\tt.Fatalf(\"fixture verdict = %q, want pass\", report.Record.Verdict)\n81|\t}\n82|\tvar record Record\n83|\tif err := json.Unmarshal(report.Bytes, &record); err != nil {\n84|\t\tt.Fatalf(\"unmarshal pass record: %v\", err)\n85|\t}\n86|\trecord.Verdict = VerdictFail\n87|\tresigned, err := encodeRecord(record)\n88|\tif err != nil {\n89|\t\tt.Fatalf(\"encodeRecord: %v\", err)\n90|\t}\n91|\tif _, err := VerifyRecord(resigned); err == nil {\n92|\t\tt.Fatal(\"VerifyRecord(resigned fail) = nil, want consistency refusal\")\n93|\t}\n94|}\n95|\n96|// TestSmokeWhitespaceVariantRefuses proves the digest binds the\n97|// exact emitted bytes: a semantically equal but reindented record\n98|// refuses on its record_id frame and digest.\n99|func TestSmokeWhitespaceVariantRefuses(t *testing.T) {\n100|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n101|\treport := runRowFixture(t, tuple)\n102|\tvar decoded any\n103|\tif err := json.Unmarshal(report.Bytes, &decoded); err != nil {\n104|\t\tt.Fatalf(\"unmarshal record: %v\", err)\n105|\t}\n106|\tindented, err := json.MarshalIndent(decoded, \"\", \"  \")\n107|\tif err != nil {\n108|\t\tt.Fatalf(\"indent record: %v\", err)\n109|\t}\n110|\tif _, err := VerifyRecord(indented); err == nil {\n111|\t\tt.Fatal(\"VerifyRecord(indented) = nil, want digest refusal\")\n112|\t}\n113|}\n114|\n115|// TestSmokeIdenticalInputsReplayIdenticalBytes proves the smoke is\n116|// a pure function of its params: two runs replay byte-identical\n117|// records, and both verify.\n118|func TestSmokeIdenticalInputsReplayIdenticalBytes(t *testing.T) {\n119|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n120|\tfirst := runRowFixture(t, tuple)\n121|\tsecond := runRowFixture(t, tuple)\n122|\tif !bytes.Equal(first.Bytes, second.Bytes) {\n123|\t\tt.Fatal(\"identical smoke inputs replayed differing bytes\")\n124|\t}\n125|\tif _, err := VerifyRecord(second.Bytes); err != nil {\n126|\t\tt.Fatalf(\"VerifyRecord(replay) = %v\", err)\n127|\t}\n128|}\n129|\n130|// runRowFixture runs one row end to end with scripted fakes and\n131|// returns its report: available rows pass, conditional rows gate.\n132|func runRowFixture(t *testing.T, tuple provhost.BuildTuple) *Report {\n133|\tt.Helper()\n134|\tcell, _ := ResumeCell(tuple.ProviderID, tuple.ProviderVersion, tuple.Platform, tuple.Architecture)\n135|\trunner := newScriptedRunner(t)\n136|\trunner.scriptProbe(tuple)\n137|\trunner.scriptIdentify(t, tuple, \"exact\")\n138|\tparams := smokeParams(tuple, runner)\n139|\tif cell == CellAvailable {\n140|\t\trunner.scriptResume(t, tuple, params.Profile)\n141|\t}\n142|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n143|\tif tuple.ProviderID == \"antigravity\" {\n144|\t\tparams.Realm = smokeRealm\n145|\t}\n146|\treport, err := Run(context.Background(), params)\n147|\tif err != nil {\n148|\t\tt.Fatalf(\"Run(%+v) error = %v\", tuple, err)\n149|\t}\n150|\treturn report\n151|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
