{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca25","stream":{"kind":"session","id":"01a0aea4-a602-7083-bf0e-7964935feca1"},"sequence":877,"recorded_at":1780531400001749,"record_type":"event","durability":"durable","causation_id":"bc9a7f38-db06-4e74-8937-112c51b35a5b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bc9a7f38-db06-4e74-8937-112c51b35a5b","run_stream":{"kind":"run","id":"bc9a7f38-db06-4e74-8937-112c51b35a5b"},"task_stream":{"kind":"task","id":"01a0aea6-fe0c-7100-b24c-a04da5ae98b3"},"task_id":"01a0aea6-fe0c-7100-b24c-a04da5ae98b3","event":{"kind":"output","task_id":"01a0aea6-fe0c-7100-b24c-a04da5ae98b3","chunk":"Read text file `internal/resumesmoke/matrix.go`.\n1|package resumesmoke\n2|\n3|// This file reads the Section 8.4 native-resume direction for one\n4|// exact probed tuple: the first cell of the provider/platform row,\n5|// refined by the Appendix B version gates. The matrix is evidence\n6|// labels, never availability promises: the fail-closed direction is\n7|// that only CellAvailable may run a resume plan, and the row-complete\n8|// derivation test pins every value against the pinned specification\n9|// text rather than trusting this table.\n10|//\n11|// The version refinements come from the rows and gates themselves:\n12|// the Muse macOS arm64 row accepts only the probed 0.1.0, and\n13|// Appendix B leaves every newer Muse behavior unsettled with\n14|// enabled false, so a non-0.1.0 build on that tuple is unknown,\n15|// refused outright like the row's own unknown Windows cell. Qwen\n16|// direct is unsupported on every platform — the row names task-board\n17|// prompt mode only — and any provider or platform outside the\n18|// Section 8.4 rows is unknown, disabled until a tuple-specific probe\n19|// and acceptance record exist. Unknown is never rewritten as\n20|// unsupported: the two refuse through distinct cells and verdicts.\n21|\n22|// Cell is one Section 8.1 matrix label for the native-resume\n23|// direction: available, conditional, unsupported, or unknown.\n24|type Cell string\n25|\n26|// The four Section 8.1 labels.\n27|const (\n28|\tCellAvailable   Cell = \"A\"\n29|\tCellConditional Cell = \"C\"\n30|\tCellUnsupported Cell = \"U\"\n31|\tCellUnknown     Cell = \"?\"\n32|)\n33|\n34|// musePinnedVersion is the exact Muse build the Section 8.4 macOS\n35|// arm64 row accepts for native resume. Every other Muse version on\n36|// that tuple is Appendix B unsettled behavior and reads unknown.\n37|const musePinnedVersion = \"0.1.0\"\n38|\n39|// ResumeCell reads the Section 8.4 native-resume cell for one exact\n40|// tuple and cites the row or gate that decided it. The citation is a\n41|// stable section-8.4 row reference, never a capability claim.\n42|func ResumeCell(providerID, providerVersion, platform, architecture string) (Cell, string) {\n43|\tswitch providerID {\n44|\tcase \"codex\":\n45|\t\treturn platformCell(platform, \"codex\", CellAvailable, CellAvailable, CellAvailable, CellAvailable)\n46|\tcase \"claude\":\n47|\t\treturn platformCell(platform, \"claude\", CellAvailable, CellAvailable, CellAvailable, CellConditional)\n48|\tcase \"gemini\":\n49|\t\treturn platformCell(platform, \"gemini\", CellAvailable, CellAvailable, CellConditional, CellAvailable)\n50|\tcase \"muse\":\n51|\t\treturn museCell(providerVersion, platform, architecture)\n52|\tcase \"antigravity\":\n53|\t\treturn platformCell(platform, \"antigravity\", CellConditional, CellConditional, CellConditional, CellConditional)\n54|\tcase \"pi\":\n55|\t\treturn platformCell(platform, \"pi\", CellAvailable, CellConditional, CellConditional, CellConditional)\n56|\tcase \"qwen\":\n57|\t\t// The Qwen row covers any target platform: direct native\n58|\t\t// resume is unsupported everywhere, and only task-board\n59|\t\t// prompt mode may be available where its own probe says so.\n60|\t\treturn CellUnsupported, \"section-8.4:qwen-direct\"\n61|\tdefault:\n62|\t\t// Future plugins and unknown providers start disabled: every\n63|\t\t// cell is unknown until a tuple-specific probe and\n64|\t\t// acceptance record exist.\n65|\t\treturn CellUnknown, \"section-8.4:future-plugin\"\n66|\t}\n67|}\n68|\n69|// platformCell reads one provider row in Section 8.4 platform order:\n70|// macOS, Linux, WSL2, native Windows. WSL2 and native Windows are\n71|// distinct rows; one never stands for the other. A platform outside\n72|// the registry is unknown, never a default into a named row.\n73|func platformCell(platform, provider string, macos, linux, wsl2, windows Cell) (Cell, string) {\n74|\tswitch platform {\n75|\tcase \"macos\":\n76|\t\treturn macos, \"section-8.4:\" + provider + \"/macos\"\n77|\tcase \"linux\":\n78|\t\treturn linux, \"section-8.4:\" + provider + \"/linux\"\n79|\tcase \"wsl2\":\n80|\t\treturn wsl2, \"section-8.4:\" + provider + \"/wsl2\"\n81|\tcase \"windows\":\n82|\t\treturn windows, \"section-8.4:\" + provider + \"/windows\"\n83|\tdefault:\n84|\t\treturn CellUnknown, \"section-8.4:platform-unknown\"\n85|\t}\n86|}\n87|\n88|// museCell reads the five Muse rows: the macOS arm64 row accepts\n89|// only the pinned probe version, the macOS amd64, Linux, and WSL2\n90|// rows are conditional, and native Windows is unknown. A non-pinned\n91|// version on macOS arm64 is unknown rather than conditional,\n92|// because Appendix B leaves newer Muse resume behavior unsettled\n93|// with enabled false instead of naming an acceptance gate the smoke\n94|// could await.\n95|func museCell(version, platform, architecture string) (Cell, string) {\n96|\tswitch platform {\n97|\tcase \"macos\":\n98|\t\tswitch architecture {\n99|\t\tcase \"arm64\":\n100|\t\t\tif version == musePinnedVersion {\n101|\t\t\t\treturn CellAvailable, \"section-8.4:muse/macos-arm64\"\n102|\t\t\t}\n103|\t\t\treturn CellUnknown, \"section-8.4:muse/macos-arm64+appendix-B\"\n104|\t\tcase \"amd64\":\n105|\t\t\treturn CellConditional, \"section-8.4:muse/macos-amd64\"\n106|\t\tdefault:\n107|\t\t\treturn CellUnknown, \"section-8.4:platform-unknown\"\n108|\t\t}\n109|\tcase \"linux\":\n110|\t\treturn CellConditional, \"section-8.4:muse/linux\"\n111|\tcase \"wsl2\":\n112|\t\treturn CellConditional, \"section-8.4:muse/wsl2\"\n113|\tcase \"windows\":\n114|\t\treturn CellUnknown, \"section-8.4:muse/windows\"\n115|\tdefault:\n116|\t\treturn CellUnknown, \"section-8.4:platform-unknown\"\n117|\t}\n118|}","final_result":true}}}
