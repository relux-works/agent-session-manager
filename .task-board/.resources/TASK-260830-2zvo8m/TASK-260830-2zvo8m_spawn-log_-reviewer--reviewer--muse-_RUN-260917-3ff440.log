{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c89b","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":680,"recorded_at":1780531400001355,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"task_stream":{"kind":"task","id":"01a0ae7a-7004-7752-8a34-2ae33d5654a6"},"task_id":"01a0ae7a-7004-7752-8a34-2ae33d5654a6","event":{"kind":"output","task_id":"01a0ae7a-7004-7752-8a34-2ae33d5654a6","chunk":"Read text file `internal/resumesmoke/mutant_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\t\"os/exec\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|// This file ships the refusal-mutant harness: every gate in this\n13|// package is weakened to admit exactly one member of the class it\n14|// must reject, and a named test must fail on the weakened tree. A\n15|// delete-only mutant would prove only that the gate exists; each\n16|// mutant below keeps the gate and narrows it, so survival means the\n17|// named test does not actually cover the gate.\n18|//\n19|// The harness never touches the checkout: each mutant is applied to\n20|// a private copy of the module under a temp directory, and one\n21|// focused go test runs there. Copying keeps parallel package runs\n22|// hermetic — a tree-walking census in another package can never\n23|// observe a half-patched file. It skips under -short so short runs\n24|// stay fast; every other run executes it.\n25|\n26|// smokeMutant is one narrowing mutation: the production file, the\n27|// exact text to weaken (which must occur exactly once), its\n28|// narrowed replacement, the focused test mask that must fail, and\n29|// whether the mutant must be killed or must survive. Exactly one\n30|// mutant is the harmless SURVIVED control, which proves the harness\n31|// reports survival instead of failing unconditionally.\n32|type smokeMutant struct {\n33|\tname    string\n34|\tfile    string\n35|\tfind    string\n36|\treplace string\n37|\tmask    string\n38|\tsurvive bool\n39|}\n40|\n41|// smokeMutants is the shipped set: one narrowing mutant per\n42|// refusal, plus the harmless control.\n43|var smokeMutants = []smokeMutant{\n44|\t{\n45|\t\tname:    \"resume-gate-admits-conditional\",\n46|\t\tfile:    \"smoke.go\",\n47|\t\tfind:    \"if run.cell != CellAvailable {\",\n48|\t\treplace: \"if run.cell != CellAvailable && run.cell != CellConditional {\",\n49|\t\tmask:    \"TestSmokeRowVerdicts/gemini-0.54.4-wsl2-amd64\",\n50|\t},\n51|\t{\n52|\t\tname:    \"probe-admits-version-drift\",\n53|\t\tfile:    \"smoke.go\",\n54|\t\tfind:    \"if probed != run.params.Tuple {\",\n55|\t\treplace: \"if probed.ProviderID != run.params.Tuple.ProviderID || probed.Platform != run.params.Tuple.Platform || probed.Architecture != run.params.Tuple.Architecture {\",\n56|\t\tmask:    \"TestSmokeProbeMismatchFails\",\n57|\t},\n58|\t{\n59|\t\tname:    \"identify-admits-strong\",\n60|\t\tfile:    \"smoke.go\",\n61|\t\tfind:    `if outcome.Confidence != \"exact\" {`,\n62|\t\treplace: `if outcome.Confidence != \"exact\" && outcome.Confidence != \"strong\" {`,\n63|\t\tmask:    \"TestSmokeStrongConfidenceFails\",\n64|\t},\n65|\t{\n66|\t\tname:    \"bind-admits-antigravity\",\n67|\t\tfile:    \"smoke.go\",\n68|\t\tfind:    \"if err := provhost.VerifyIdentityDiscovery(identity, run.params.Discovery, discovery); err != nil {\",\n69|\t\treplace: `if err := provhost.VerifyIdentityDiscovery(identity, run.params.Discovery, discovery); err != nil && run.params.Tuple.ProviderID != \"antigravity\" {`,\n70|\t\tmask:    \"TestSmokeAntigravityUnresolvedRealmFails\",\n71|\t},\n72|\t{\n73|\t\tname:    \"digest-scoped-to-pass\",\n74|\t\tfile:    \"record.go\",\n75|\t\tfind:    `if \"sha256:\"+hex.EncodeToString(sum[:]) != record.RecordID {`,\n76|\t\treplace: `if \"sha256:\"+hex.EncodeToString(sum[:]) != record.RecordID && record.Verdict == VerdictPass {`,\n77|\t\tmask:    \"TestSmokeTamperedRecordRefuses\",\n78|\t},\n79|\t{\n80|\t\tname:    \"consistency-admits-fail\",\n81|\t\tfile:    \"record.go\",\n82|\t\tfind:    \"if want := deriveVerdict(record.ResumeCell, record.Checks); record.Verdict != want {\",\n83|\t\treplace: \"if want := deriveVerdict(record.ResumeCell, record.Checks); record.Verdict != want && record.Verdict != VerdictFail {\",\n84|\t\tmask:    \"TestSmokeInconsistentFailRefuses\",\n85|\t},\n86|\t{\n87|\t\tname:    \"disagreement-admits-same-length\",\n88|\t\tfile:    \"store.go\",\n89|\t\tfind:    \"if !bytes.Equal(existing, record) {\",\n90|\t\treplace: \"if len(existing) != len(record) {\",\n91|\t\tmask:    \"TestStoreDisagreementQuarantines\",\n92|\t},\n93|\t{\n94|\t\tname:    \"quiescence-admits-unsafe-codex\",\n95|\t\tfile:    \"smoke.go\",\n96|\t\tfind:    \"if !safe {\",\n97|\t\treplace: `if !safe && run.params.Tuple.ProviderID != \"codex\" {`,\n98|\t\tmask:    \"TestSmokeUnsafeQuiescenceFails\",\n99|\t},\n100|\t{\n101|\t\tname:    \"mapping-admits-yolo\",\n102|\t\tfile:    \"smoke.go\",\n103|\t\tfind:    \"if _, err := provhost.ResolveMapping(run.params.Tuple.ProviderID, run.params.Profile, run.params.Tuple); err != nil {\",\n104|\t\treplace: `if _, err := provhost.ResolveMapping(run.params.Tuple.ProviderID, run.params.Profile, run.params.Tuple); err != nil && run.params.Profile != \"yolo\" {`,\n105|\t\tmask:    \"TestSmokePiUnmappedVersionFails\",\n106|\t},\n107|\t{\n108|\t\tname:    \"matrix-admits-muse-offpin\",\n109|\t\tfile:    \"matrix.go\",\n110|\t\tfind:    `return CellUnknown, \"section-8.4:muse/macos-arm64+appendix-B\"`,\n111|\t\treplace: `return CellConditional, \"section-8.4:muse/macos-arm64+appendix-B\"`,\n112|\t\tmask:    \"TestResumeMatrixCoversEverySpecRow\",\n113|\t},\n114|\t{\n115|\t\tname:    \"harmless-comment-control\",\n116|\t\tfile:    \"smoke.go\",\n117|\t\tfind:    \"// Check names in execution order.\",\n118|\t\treplace: \"// Check names in execution order. Mutant-harness control: no behavior change.\",\n119|\t\tmask:    \"TestSmokeRowVerdicts/codex-0.147.0-macos-amd64\",\n120|\t\tsurvive: true,\n121|\t},\n122|}\n123|\n124|// TestSmokeMutantsAreKilled applies every shipped mutant to a\n125|// private module copy and requires the kill verdict each names:\n126|// narrowing mutants must fail their focused test, and the harmless\n127|// control must pass its.\n128|func TestSmokeMutantsAreKilled(t *testing.T) {\n129|\tif testing.Short() {\n130|\t\tt.Skip(\"mutant harness needs full runs; skipped under -short\")\n131|\t}\n132|\troot := smokeModuleRoot(t)\n133|\tkilled, survived := 0, 0\n134|\tfor _, mutant := range smokeMutants {\n135|\t\tmutant := mutant\n136|\t\tt.Run(mutant.name, func(t *testing.T) {\n137|\t\t\tworkdir := copyModuleForMutant(t, root, mutant)\n138|\t\t\tcommand := exec.Command(\"go\", \"test\", \"./internal/resumesmoke/\", \"-run\", mutant.mask, \"-count=1\")\n139|\t\t\tcommand.Dir = workdir\n140|\t\t\toutput, err := command.CombinedOutput()\n141|\t\t\tfailed := err != nil\n142|\t\t\tt.Logf(\"mutant %s mask %s failed=%v:\\n%s\", mutant.name, mutant.mask, failed, output)\n143|\t\t\tswitch {\n144|\t\t\tcase mutant.survive && failed:\n145|\t\t\t\tt.Fatalf(\"SURVIVED control failed; the harness or the mask is broken:\\n%s\", output)\n146|\t\t\tcase mutant.survive && !failed:\n147|\t\t\t\tsurvived++\n148|\t\t\tcase !mutant.survive && !failed:\n149|\t\t\t\tt.Fatalf(\"SURVIVED: narrowing mutant %q passed %s; the gate is uncovered\", mutant.name, mutant.mask)\n150|\t\t\tcase !mutant.survive && failed && !strings.Contains(string(output), \"FAIL\"):\n151|\t\t\t\tt.Fatalf(\"mutant %q errored without a test failure; the mask may be broken:\\n%s\", mutant.name, output)\n152|\t\t\tdefault:\n153|\t\t\t\tkilled++\n154|\t\t\t}\n155|\t\t})\n156|\t}\n157|\tt.Logf(\"mutants killed=%d survived-controls=%d\", killed, survived)\n158|\tif killed != len(smokeMutants)-1 || survived != 1 {\n159|\t\tt.Fatalf(\"mutant census killed=%d survived=%d, want %d and 1\", killed, survived, len(smokeMutants)-1)\n160|\t}\n161|}\n162|\n163|// smokeModuleRoot returns the repository root two directories\n164|// above this package: the tree the harness copies mutants from.\n165|func smokeModuleRoot(t *testing.T) string {\n166|\tt.Helper()\n167|\tworking, err := os.Getwd()\n168|\tif err != nil {\n169|\t\tt.Fatalf(\"os.Getwd: %v\", err)\n170|\t}\n171|\treturn filepath.Join(working, \"..\", \"..\")\n172|}\n173|\n174|// copyModuleForMutant copies the module sources a mutant run needs\n175|// — go.mod, go.sum, and the internal tree — into a fresh temp\n176|// directory, applies the mutant there, and returns the copy. The\n177|// checkout is only read, never written.\n178|func copyModuleForMutant(t *testing.T, root string, mutant smokeMutant) string {\n179|\tt.Helper()\n180|\tworkdir := t.TempDir()\n181|\tfor _, name := range []string{\"go.mod\", \"go.sum\"} {\n182|\t\tdata, err := os.ReadFile(filepath.Join(root, name))\n183|\t\tif err != nil {\n184|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n185|\t\t}\n186|\t\tif err := os.WriteFile(filepath.Join(workdir, name), data, 0o600); err != nil {\n187|\t\t\tt.Fatalf(\"stage %s: %v\", name, err)\n188|\t\t}\n189|\t}\n190|\tcopyDir(t, filepath.Join(root, \"internal\"), filepath.Join(workdir, \"internal\"))\n191|\tpath := filepath.Join(workdir, \"internal\", \"resumesmoke\", mutant.file)\n192|\toriginal, err := os.ReadFile(path)\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"read %s: %v\", mutant.file, err)\n195|\t}\n196|\tif bytes.Count(original, []byte(mutant.find)) != 1 {\n197|\t\tt.Fatalf(\"mutant find occurs %d times in %s, want exactly once\", bytes.Count(original, []byte(mutant.find)), mutant.file)\n198|\t}\n199|\tmutated := bytes.Replace(original, []byte(mutant.find), []byte(mutant.replace), 1)\n200|\tif err := os.WriteFile(path, mutated, 0o600); err != nil {\n201|\t\tt.Fatalf(\"apply mutant: %v\", err)\n202|\t}\n203|\treturn workdir\n204|}\n205|\n206|// copyDir copies one directory tree to a fresh destination,\n207|// preserving file modes. Symlinks refuse: the module tree the\n208|// harness copies carries none, and a link would escape the copy.\n209|func copyDir(t *testing.T, source, destination string) {\n210|\tt.Helper()\n211|\tentries, err := os.ReadDir(source)\n212|\tif err != nil {\n213|\t\tt.Fatalf(\"read %s: %v\", source, err)\n214|\t}\n215|\tif err := os.MkdirAll(destination, 0o755); err != nil {\n216|\t\tt.Fatalf(\"stage %s: %v\", destination, err)\n217|\t}\n218|\tfor _, entry := range entries {\n219|\t\tif entry.Type()&os.ModeSymlink != 0 {\n220|\t\t\tt.Fatalf(\"refusing to copy symlink %s\", filepath.Join(source, entry.Name()))\n221|\t\t}\n222|\t\tfrom := filepath.Join(source, entry.Name())\n223|\t\tto := filepath.Join(destination, entry.Name())\n224|\t\tif entry.IsDir() {\n225|\t\t\tcopyDir(t, from, to)\n226|\t\t\tcontinue\n227|\t\t}\n228|\t\tdata, err := os.ReadFile(from)\n229|\t\tif err != nil {\n230|\t\t\tt.Fatalf(\"read %s: %v\", from, err)\n231|\t\t}\n232|\t\tinfo, err := entry.Info()\n233|\t\tif err != nil {\n234|\t\t\tt.Fatalf(\"stat %s: %v\", from, err)\n235|\t\t}\n236|\t\tif err := os.WriteFile(to, data, info.Mode()); err != nil {\n237|\t\t\tt.Fatalf(\"stage %s: %v\", to, err)\n238|\t\t}\n239|\t}\n240|}","final_result":true}}}
