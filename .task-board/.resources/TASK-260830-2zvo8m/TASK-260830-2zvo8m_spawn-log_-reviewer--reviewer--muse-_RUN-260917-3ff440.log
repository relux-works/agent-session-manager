verify as a failure either.\n76|func TestSmokeInconsistentFailRefuses(t *testing.T) {\n77|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n78|\treport := runRowFixture(t, tuple)\n79|\tif report.Record.Verdict != VerdictPass {\n80|\t\tt.Fatalf(\"fixture verdict = %q, want pass\", report.Record.Verdict)\n81|\t}\n82|\tvar record Record\n83|\tif err := json.Unmarshal(report.Bytes, &record); err != nil {\n84|\t\tt.Fatalf(\"unmarshal pass record: %v\", err)\n85|\t}\n86|\trecord.Verdict = VerdictFail\n87|\tresigned, err := encodeRecord(record)\n88|\tif err != nil {\n89|\t\tt.Fatalf(\"encodeRecord: %v\", err)\n90|\t}\n91|\tif _, err := VerifyRecord(resigned); err == nil {\n92|\t\tt.Fatal(\"VerifyRecord(resigned fail) = nil, want consistency refusal\")\n93|\t}\n94|}\n95|\n96|// TestSmokeWhitespaceVariantRefuses proves the digest binds the\n97|// exact emitted bytes: a semantically equal but reindented record\n98|// refuses on its record_id frame and digest.\n99|func TestSmokeWhitespaceVariantRefuses(t *testing.T) {\n100|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n101|\treport := runRowFixture(t, tuple)\n102|\tvar decoded any\n103|\tif err := json.Unmarshal(report.Bytes, &decoded); err != nil {\n104|\t\tt.Fatalf(\"unmarshal record: %v\", err)\n105|\t}\n106|\tindented, err := json.MarshalIndent(decoded, \"\", \"  \")\n107|\tif err != nil {\n108|\t\tt.Fatalf(\"indent record: %v\", err)\n109|\t}\n110|\tif _, err := VerifyRecord(indented); err == nil {\n111|\t\tt.Fatal(\"VerifyRecord(indented) = nil, want digest refusal\")\n112|\t}\n113|}\n114|\n115|// TestSmokeIdenticalInputsReplayIdenticalBytes proves the smoke is\n116|// a pure function of its params: two runs replay byte-identical\n117|// records, and both verify.\n118|func TestSmokeIdenticalInputsReplayIdenticalBytes(t *testing.T) {\n119|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n120|\tfirst := runRowFixture(t, tuple)\n121|\tsecond := runRowFixture(t, tuple)\n122|\tif !bytes.Equal(first.Bytes, second.Bytes) {\n123|\t\tt.Fatal(\"identical smoke inputs replayed differing bytes\")\n124|\t}\n125|\tif _, err := VerifyRecord(second.Bytes); err != nil {\n126|\t\tt.Fatalf(\"VerifyRecord(replay) = %v\", err)\n127|\t}\n128|}\n129|\n130|// runRowFixture runs one row end to end with scripted fakes and\n131|// returns its report: available rows pass, conditional rows gate.\n132|func runRowFixture(t *testing.T, tuple provhost.BuildTuple) *Report {\n133|\tt.Helper()\n134|\tcell, _ := ResumeCell(tuple.ProviderID, tuple.ProviderVersion, tuple.Platform, tuple.Architecture)\n135|\trunner := newScriptedRunner(t)\n136|\trunner.scriptProbe(tuple)\n137|\trunner.scriptIdentify(t, tuple, \"exact\")\n138|\tparams := smokeParams(tuple, runner)\n139|\tif cell == CellAvailable {\n140|\t\trunner.scriptResume(t, tuple, params.Profile)\n141|\t}\n142|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n143|\tif tuple.ProviderID == \"antigravity\" {\n144|\t\tparams.Realm = smokeRealm\n145|\t}\n146|\treport, err := Run(context.Background(), params)\n147|\tif err != nil {\n148|\t\tt.Fatalf(\"Run(%+v) error = %v\", tuple, err)\n149|\t}\n150|\treturn report\n151|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c963","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":780,"recorded_at":1780531400001555,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a846f743a8b9eeee547dcef0a","text":"Read text file `internal/resumesmoke/store_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n12|)\n13|\n14|// This file proves the durable install: verified records install\n15|// no-replace and fsynced, identical retries reuse the path,\n16|// disagreeing bytes refuse for quarantine, and crash-hook faults\n17|// leave nothing the retry cannot recover.\n18|\n19|// TestStoreInstallsVerifiedRecord proves a verified record installs\n20|// at its content-addressed path and loads back byte-identical,\n21|// while invalid bytes refuse before any file is created.\n22|func TestStoreInstallsVerifiedRecord(t *testing.T) {\n23|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n24|\treport := runRowFixture(t, tuple)\n25|\tdirectory := t.TempDir()\n26|\tpath, err := Store(directory, report.Bytes, nil)\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"Store error = %v\", err)\n29|\t}\n30|\tif !strings.HasPrefix(filepath.Base(path), \"native-resume-smoke-\") {\n31|\t\tt.Fatalf(\"Store path = %q, want the content-addressed name\", path)\n32|\t}\n33|\trecord, body, err := Load(path)\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"Load error = %v\", err)\n36|\t}\n37|\tif !bytes.Equal(body, report.Bytes) {\n38|\t\tt.Fatal(\"loaded bytes differ from the installed record\")\n39|\t}\n40|\tif record.Verdict != VerdictPass {\n41|\t\tt.Fatalf(\"loaded verdict = %q, want pass\", record.Verdict)\n42|\t}\n43|\tentries, err := os.ReadDir(directory)\n44|\tif err != nil {\n45|\t\tt.Fatalf(\"ReadDir: %v\", err)\n46|\t}\n47|\tif len(entries) != 1 {\n48|\t\tt.Fatalf(\"directory holds %d entries, want exactly the record\", len(entries))\n49|\t}\n50|\tif _, err := Store(directory, []byte(`{}`), nil); err == nil {\n51|\t\tt.Fatal(\"Store(invalid) = nil, want refusal\")\n52|\t}\n53|}\n54|\n55|// TestStoreReplayIsIdentical proves the idempotent install: storing\n56|// the same record twice returns the same path with identical bytes.\n57|func TestStoreReplayIsIdentical(t *testing.T) {\n58|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n59|\treport := runRowFixture(t, tuple)\n60|\tdirectory := t.TempDir()\n61|\tfirst, err := Store(directory, report.Bytes, nil)\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"Store error = %v\", err)\n64|\t}\n65|\tsecond, err := Store(directory, report.Bytes, nil)\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"Store(replay) error = %v\", err)\n68|\t}\n69|\tif first != second {\n70|\t\tt.Fatalf(\"replay path = %q, want %q\", second, first)\n71|\t}\n72|\t_, loaded, err := Load(first)\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"Load error = %v\", err)\n75|\t}\n76|\tif !bytes.Equal(loaded, report.Bytes) {\n77|\t\tt.Fatal(\"replayed bytes differ from the installed record\")\n78|\t}\n79|}\n80|\n81|// TestStoreDisagreementQuarantines proves a torn write refuses the\n82|// retry instead of replacing evidence: garbage at the record's\n83|// path fails the install with the quarantine direction, and the\n84|// retry succeeds byte-identical once the torn file is removed.\n85|func TestStoreDisagreementQuarantines(t *testing.T) {\n86|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n87|\treport := runRowFixture(t, tuple)\n88|\tdirectory := t.TempDir()\n89|\tpath, err := Store(directory, report.Bytes, nil)\n90|\tif err != nil {\n91|\t\tt.Fatalf(\"Store error = %v\", err)\n92|\t}\n93|\t// A torn write of exactly the record length: the disagreement\n94|\t// is in the bytes, never the size.\n95|\ttorn := bytes.Clone(report.Bytes)\n96|\tfor index := range torn {\n97|\t\ttorn[index] = 'x'\n98|\t}\n99|\tif err := os.WriteFile(path, torn, 0o600); err != nil {\n100|\t\tt.Fatalf(\"corrupt installed record: %v\", err)\n101|\t}\n102|\tif _, err := Store(directory, report.Bytes, nil); err == nil {\n103|\t\tt.Fatal(\"Store(disagreeing bytes) = nil, want refusal\")\n104|\t} else if !strings.Contains(err.Error(), \"quarantine\") {\n105|\t\tt.Fatalf(\"Store(disagreeing bytes) = %v, want the quarantine direction\", err)\n106|\t}\n107|\tif _, _, err := Load(path); err == nil {\n108|\t\tt.Fatal(\"Load(torn bytes) = nil, want refusal\")\n109|\t}\n110|\tif err := os.Remove(path); err != nil {\n111|\t\tt.Fatalf(\"quarantine torn record: %v\", err)\n112|\t}\n113|\tretry, err := Store(directory, report.Bytes, nil)\n114|\tif err != nil {\n115|\t\tt.Fatalf(\"Store(after quarantine) error = %v\", err)\n116|\t}\n117|\tif retry != path {\n118|\t\tt.Fatalf(\"retry path = %q, want %q\", retry, path)\n119|\t}\n120|\t_, loaded, err := Load(retry)\n121|\tif err != nil {\n122|\t\tt.Fatalf(\"Load error = %v\", err)\n123|\t}\n124|\tif !bytes.Equal(loaded, report.Bytes) {\n125|\t\tt.Fatal(\"post-quarantine bytes differ from the record\")\n126|\t}\n127|}\n128|\n129|// TestStoreCrashBeforeCreateAdmitsNothing proves the pre-create\n130|// crash point installs nothing and the identical retry succeeds.\n131|func TestStoreCrashBeforeCreateAdmitsNothing(t *testing.T) {\n132|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n133|\treport := runRowFixture(t, tuple)\n134|\tdirectory := t.TempDir()\n135|\tboom := errors.New(\"crash before create\")\n136|\tif _, err := Store(directory, report.Bytes, &StoreHooks{BeforeCreate: func(string) error { return boom }}); err == nil {\n137|\t\tt.Fatal(\"Store(before-create fault) = nil, want the fault\")\n138|\t}\n139|\tentries, err := os.ReadDir(directory)\n140|\tif err != nil {\n141|\t\tt.Fatalf(\"ReadDir: %v\", err)\n142|\t}\n143|\tif len(entries) != 0 {\n144|\t\tt.Fatalf(\"directory holds %d entries after the fault, want none\", len(entries))\n145|\t}\n146|\tif _, err := Store(directory, report.Bytes, nil); err != nil {\n147|\t\tt.Fatalf(\"Store(retry) error = %v\", err)\n148|\t}\n149|}\n150|\n151|// TestStoreCrashAfterWriteReplays proves the post-write crash point\n152|// recovers through the idempotent retry: the faulted install may\n153|// leave complete bytes behind, and the identical retry reuses them.\n154|func TestStoreCrashAfterWriteReplays(t *testing.T) {\n155|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n156|\treport := runRowFixture(t, tuple)\n157|\tdirectory := t.TempDir()\n158|\tboom := errors.New(\"crash after write\")\n159|\tif _, err := Store(directory, report.Bytes, &StoreHooks{AfterWrite: func(string) error { return boom }}); err == nil {\n160|\t\tt.Fatal(\"Store(after-write fault) = nil, want the fault\")\n161|\t}\n162|\tpath, err := Store(directory, report.Bytes, nil)\n163|\tif err != nil {\n164|\t\tt.Fatalf(\"Store(retry) error = %v\", err)\n165|\t}\n166|\t_, loaded, err := Load(path)\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"Load error = %v\", err)\n169|\t}\n170|\tif !bytes.Equal(loaded, report.Bytes) {\n171|\t\tt.Fatal(\"post-crash bytes differ from the record\")\n172|\t}\n173|}\n174|\n175|// writeTempRecord writes bytes to a temp file and returns its path.\n176|func writeTempRecord(t *testing.T, record []byte) string {\n177|\tt.Helper()\n178|\tpath := filepath.Join(t.TempDir(), \"record.json\")\n179|\tif err := os.WriteFile(path, record, 0o600); err != nil {\n180|\t\tt.Fatalf(\"write temp record: %v\", err)\n181|\t}\n182|\treturn path\n183|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c965","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":781,"recorded_at":1780531400001557,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a853073cb8e24422b895bf39f","text":"Read text file `internal/resumesmoke/crash_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\t\"os/exec\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file kills a real installer mid-write: the crash child is\n16|// the test binary re-executed, signaled ready after its bytes land\n17|// but before the fsync, and then killed. The retry must recover to\n18|// byte-identical evidence.\n19|\n20|// TestStoreRealKillBetweenWriteAndSync kills the installer after\n21|// the write and before the fsync, then proves the identical retry\n22|// installs byte-identical evidence that loads valid.\n23|func TestStoreRealKillBetweenWriteAndSync(t *testing.T) {\n24|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n25|\treport := runRowFixture(t, tuple)\n26|\tdirectory := t.TempDir()\n27|\tinput := filepath.Join(directory, \"input.json\")\n28|\tif err := os.WriteFile(input, report.Bytes, 0o600); err != nil {\n29|\t\tt.Fatalf(\"write helper input: %v\", err)\n30|\t}\n31|\tready := filepath.Join(directory, \"ready\")\n32|\texecutable, err := os.Executable()\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"os.Executable: %v\", err)\n35|\t}\n36|\tcommand := exec.Command(executable)\n37|\tcommand.Env = append(os.Environ(),\n38|\t\t\"RESUMESMOKE_HELPER=crash-store\",\n39|\t\t\"RESUMESMOKE_INPUT=\"+input,\n40|\t\t\"RESUMESMOKE_DIR=\"+directory,\n41|\t\t\"RESUMESMOKE_READY=\"+ready,\n42|\t)\n43|\tif err := command.Start(); err != nil {\n44|\t\tt.Fatalf(\"start crash child: %v\", err)\n45|\t}\n46|\twaitReady(t, ready, 30*time.Second)\n47|\tif err := command.Process.Kill(); err != nil {\n48|\t\tt.Fatalf(\"kill crash child: %v\", err)\n49|\t}\n50|\t_ = command.Wait()\n51|\t// The kill landed after the write: the record file exists with\n52|\t// the complete but unsynced bytes.\n53|\tentries, err := os.ReadDir(directory)\n54|\tif err != nil {\n55|\t\tt.Fatalf(\"ReadDir: %v\", err)\n56|\t}\n57|\tinstalled := \"\"\n58|\tfor _, entry := range entries {\n59|\t\tif strings.HasPrefix(entry.Name(), \"native-resume-smoke-\") {\n60|\t\t\tinstalled = filepath.Join(directory, entry.Name())\n61|\t\t}\n62|\t}\n63|\tif installed == \"\" {\n64|\t\tt.Fatal(\"killed installer left no record file; the kill missed its window\")\n65|\t}\n66|\t// The identical retry reuses the killed installer's bytes and\n67|\t// loads valid: the kill cost durability timing, never evidence.\n68|\tpath, err := Store(directory, report.Bytes, nil)\n69|\tif err != nil {\n70|\t\tt.Fatalf(\"Store(retry after kill) error = %v\", err)\n71|\t}\n72|\tif path != installed {\n73|\t\tt.Fatalf(\"retry path = %q, want the killed install %q\", path, installed)\n74|\t}\n75|\t_, loaded, err := Load(path)\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"Load error = %v\", err)\n78|\t}\n79|\tif !bytes.Equal(loaded, report.Bytes) {\n80|\t\tt.Fatal(\"post-kill bytes differ from the record\")\n81|\t}\n82|}\n83|\n84|// waitReady polls for the helper's readiness signal until the\n85|// deadline: the kill must land after the write, never before it.\n86|func waitReady(t *testing.T, ready string, timeout time.Duration) {\n87|\tt.Helper()\n88|\tdeadline := time.Now().Add(timeout)\n89|\tfor time.Now().Before(deadline) {\n90|\t\tif _, err := os.Stat(ready); err == nil {\n91|\t\t\treturn\n92|\t\t}\n93|\t\ttime.Sleep(10 * time.Millisecond)\n94|\t}\n95|\tt.Fatalf(\"crash child never signaled ready within %v\", timeout)\n96|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c967","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":782,"recorded_at":1780531400001559,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a8619711493af20989111db61","text":"Read text file `internal/resumesmoke/spawn_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n12|)\n13|\n14|// This file proves the smoke runs through a real provider process:\n15|// the fake adapter is the test binary re-executed as the provider\n16|// executable under the production ExecRunner, answering canned\n17|// bodies the parent built with the shared fixtures.\n18|\n19|// TestSmokeThroughRealProviderProcess runs one available row end to\n20|// end with the adapter as a real child process per operation. The\n21|// verdict, checks, and record integrity must equal the in-process\n22|// run exactly.\n23|func TestSmokeThroughRealProviderProcess(t *testing.T) {\n24|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"linux\", Architecture: \"amd64\"}\n25|\trunner := newScriptedRunner(t)\n26|\trunner.scriptProbe(tuple)\n27|\trunner.scriptIdentify(t, tuple, \"exact\")\n28|\tprobeBody := captureCannedBody(t, runner, \"probe\", smokeProbeRequest(t, tuple))\n29|\tidentifyBody := captureCannedBody(t, runner, \"identify-session\", smokeIdentifyRequest(t))\n30|\tdirectory := t.TempDir()\n31|\tprobePath := writeHelperBody(t, directory, \"probe.json\", probeBody)\n32|\tidentifyPath := writeHelperBody(t, directory, \"identify.json\", identifyBody)\n33|\t// The resume script asserts the threaded identity; capture the\n34|\t// plan from a resume-shaped request carrying it.\n35|\trunner.scriptResume(t, tuple, \"standard\")\n36|\tresumeBody := captureCannedBody(t, runner, \"resume\", smokeResumeRequest(t, runner.identity))\n37|\tresumePath := writeHelperBody(t, directory, \"resume.json\", resumeBody)\n38|\n39|\texecutable, err := os.Executable()\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"os.Executable: %v\", err)\n42|\t}\n43|\tenvironment := append(os.Environ(),\n44|\t\t\"RESUMESMOKE_HELPER=fake-provider\",\n45|\t\t\"RESUMESMOKE_PROBE=\"+probePath,\n46|\t\t\"RESUMESMOKE_IDENTIFY=\"+identifyPath,\n47|\t\t\"RESUMESMOKE_RESUME=\"+resumePath,\n48|\t)\n49|\tclock, err := time.Parse(time.RFC3339, smokeClock)\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"parse smoke clock: %v\", err)\n52|\t}\n53|\thost := provhost.Host{Runner: provhost.ExecRunner{Env: environment}, Now: func() time.Time { return clock }}\n54|\tparams := smokeParams(tuple, runner)\n55|\tparams.Host = host\n56|\tparams.Executable = executable\n57|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n58|\treport, err := Run(context.Background(), params)\n59|\tif err != nil {\n60|\t\tt.Fatalf(\"Run error = %v\", err)\n61|\t}\n62|\tassertVerdict(t, report.Record, VerdictPass)\n63|\tassertOutcomes(t, report.Record, map[string]Outcome{\n64|\t\t\"resume-cell\":   OutcomePass,\n65|\t\t\"tuple-gate\":    OutcomePass,\n66|\t\t\"probe\":         OutcomePass,\n67|\t\t\"identify\":      OutcomePass,\n68|\t\t\"discover-bind\": OutcomePass,\n69|\t\t\"quiescence\":    OutcomeSkipped,\n70|\t\t\"resume-plan\":   OutcomePass,\n71|\t})\n72|\tassertNoCanary(t, report.Bytes)\n73|\tif _, err := VerifyRecord(report.Bytes); err != nil {\n74|\t\tt.Fatalf(\"VerifyRecord(process bytes) = %v\", err)\n75|\t}\n76|\t// The process run replays the in-process bytes exactly: the\n77|\t// transport carries no identity of its own.\n78|\tinProcess := runRowFixture(t, tuple)\n79|\tif string(inProcess.Bytes) != string(report.Bytes) {\n80|\t\tt.Fatal(\"process run bytes differ from the in-process run\")\n81|\t}\n82|}\n83|\n84|// captureCannedBody runs one scripted handler over a fixture\n85|// request body and returns the canned response body.\n86|func captureCannedBody(t *testing.T, runner *scriptedRunner, operation string, request json.RawMessage) json.RawMessage {\n87|\tt.Helper()\n88|\thandler, ok := runner.script[operation]\n89|\tif !ok {\n90|\t\tt.Fatalf(\"no script for %q\", operation)\n91|\t}\n92|\treturn handler(request)\n93|}\n94|\n95|func writeHelperBody(t *testing.T, directory, name string, body json.RawMessage) string {\n96|\tt.Helper()\n97|\tpath := filepath.Join(directory, name)\n98|\tif err := os.WriteFile(path, body, 0o600); err != nil {\n99|\t\tt.Fatalf(\"write helper body: %v\", err)\n100|\t}\n101|\treturn path\n102|}\n103|\n104|func smokeProbeRequest(t *testing.T, tuple provhost.BuildTuple) json.RawMessage {\n105|\tt.Helper()\n106|\treturn json.RawMessage(`{\"platform\": \"` + tuple.Platform + `\", \"architecture\": \"` + tuple.Architecture + `\", \"provider_executable\": null, \"requested_capabilities\": [\"native_resume\"]}`)\n107|}\n108|\n109|func smokeIdentifyRequest(t *testing.T) json.RawMessage {\n110|\tt.Helper()\n111|\treturn json.RawMessage(`{\"session_id\": \"` + smokeSessionID + `\", \"provider_id\": \"codex\", \"observation\": {\"terminal_id\": \"smoke-terminal\", \"executable_path\": \"/smoke/bin/codex\", \"started_at\": \"` + smokeCreatedAt + `\", \"candidate_store_paths\": [], \"candidate_native_ids\": []}}`)\n112|}\n113|\n114|func smokeResumeRequest(t *testing.T, identity json.RawMessage) json.RawMessage {\n115|\tt.Helper()\n116|\treturn json.RawMessage(`{\"identity\": ` + string(identity) + `, \"workspace_paths\": {\"` + smokeWorkID + `\": \"/smoke/work\"}, \"execution_profile\": \"standard\", \"terminal\": {\"backend\": \"tmux\", \"terminal_id\": \"smoke-terminal\", \"interactive\": true, \"columns\": 120, \"rows\": 40}, \"lease\": {\"session_id\": \"` + smokeSessionID + `\", \"lease_epoch\": 1, \"lease_id\": \"` + smokeLeaseID + `\"}}`)\n117|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c969","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":783,"recorded_at":1780531400001561,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a872b76caaab959bc374a72f0","text":"Read text file `internal/resumesmoke/main_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"io\"\n7|\t\"os\"\n8|\t\"testing\"\n9|\t\"time\"\n10|)\n11|\n12|// TestMain gates the helper processes first: when the marker names\n13|// a helper, this binary serves it and exits before the suite runs,\n14|// so a helper child never re-enters the suite or spawns\n15|// grandchildren.\n16|func TestMain(main *testing.M) {\n17|\tswitch os.Getenv(\"RESUMESMOKE_HELPER\") {\n18|\tcase \"fake-provider\":\n19|\t\trunFakeProviderHelper()\n20|\tcase \"crash-store\":\n21|\t\trunCrashStoreHelper()\n22|\t}\n23|\tos.Exit(main.Run())\n24|}\n25|\n26|// runFakeProviderHelper serves one provider-protocol frame as the\n27|// fake adapter executable: it reads the request, loads the canned\n28|// body file the parent named for the operation, and prints the\n29|// success envelope with the echoed request ID. Unknown operations\n30|// exit nonzero with no frame, which the host refuses as a process\n31|// failure rather than mistaking for a result.\n32|func runFakeProviderHelper() {\n33|\tstdin, err := io.ReadAll(os.Stdin)\n34|\tif err != nil {\n35|\t\tfmt.Fprintf(os.Stderr, \"helper read: %v\\n\", err)\n36|\t\tos.Exit(1)\n37|\t}\n38|\tvar frame struct {\n39|\t\tRequestID string          `json:\"request_id\"`\n40|\t\tOperation string          `json:\"operation\"`\n41|\t\tBody      json.RawMessage `json:\"body\"`\n42|\t}\n43|\tif err := json.Unmarshal(stdin, &frame); err != nil {\n44|\t\tfmt.Fprintf(os.Stderr, \"helper frame: %v\\n\", err)\n45|\t\tos.Exit(1)\n46|\t}\n47|\tpath := \"\"\n48|\tswitch frame.Operation {\n49|\tcase \"probe\":\n50|\t\tpath = os.Getenv(\"RESUMESMOKE_PROBE\")\n51|\tcase \"identify-session\":\n52|\t\tpath = os.Getenv(\"RESUMESMOKE_IDENTIFY\")\n53|\tcase \"resume\":\n54|\t\tpath = os.Getenv(\"RESUMESMOKE_RESUME\")\n55|\tdefault:\n56|\t\tfmt.Fprintf(os.Stderr, \"helper unexpected operation %q\\n\", frame.Operation)\n57|\t\tos.Exit(1)\n58|\t}\n59|\tbody, err := os.ReadFile(path)\n60|\tif err != nil {\n61|\t\tfmt.Fprintf(os.Stderr, \"helper body: %v\\n\", err)\n62|\t\tos.Exit(1)\n63|\t}\n64|\tresponse := map[string]any{\n65|\t\t\"protocol\":         \"urn:ax:protocol:provider\",\n66|\t\t\"protocol_version\": \"2.0.0\",\n67|\t\t\"request_id\":       frame.RequestID,\n68|\t\t\"ok\":               true,\n69|\t\t\"body\":             json.RawMessage(body),\n70|\t}\n71|\trendered, err := json.Marshal(response)\n72|\tif err != nil {\n73|\t\tfmt.Fprintf(os.Stderr, \"helper response: %v\\n\", err)\n74|\t\tos.Exit(1)\n75|\t}\n76|\trendered = append(rendered, '\\n')\n77|\tif _, err := os.Stdout.Write(rendered); err != nil {\n78|\t\tfmt.Fprintf(os.Stderr, \"helper write: %v\\n\", err)\n79|\t\tos.Exit(1)\n80|\t}\n81|\tos.Exit(0)\n82|}\n83|\n84|// runCrashStoreHelper installs one record and dies mid-install: the\n85|// AfterWrite hook signals readiness, then the process sleeps so the\n86|// parent can kill it between the write and the fsync. Exit codes\n87|// are diagnostics; the kill is the test.\n88|func runCrashStoreHelper() {\n89|\tinput, err := os.ReadFile(os.Getenv(\"RESUMESMOKE_INPUT\"))\n90|\tif err != nil {\n91|\t\tfmt.Fprintf(os.Stderr, \"helper input: %v\\n\", err)\n92|\t\tos.Exit(1)\n93|\t}\n94|\tready := os.Getenv(\"RESUMESMOKE_READY\")\n95|\thooks := &StoreHooks{AfterWrite: func(string) error {\n96|\t\tif err := os.WriteFile(ready, []byte(\"ready\"), 0o600); err != nil {\n97|\t\t\tfmt.Fprintf(os.Stderr, \"helper ready: %v\\n\", err)\n98|\t\t\tos.Exit(1)\n99|\t\t}\n100|\t\ttime.Sleep(60 * time.Second)\n101|\t\treturn nil\n102|\t}}\n103|\tif _, err := Store(os.Getenv(\"RESUMESMOKE_DIR\"), input, hooks); err != nil {\n104|\t\tfmt.Fprintf(os.Stderr, \"helper store: %v\\n\", err)\n105|\t\tos.Exit(1)\n106|\t}\n107|\tos.Exit(0)\n108|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
