{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c845","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":637,"recorded_at":1780531400001269,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"task_stream":{"kind":"task","id":"01a0ae7a-643d-79c3-9807-5c091729a9a8"},"task_id":"01a0ae7a-643d-79c3-9807-5c091729a9a8","event":{"kind":"output","task_id":"01a0ae7a-643d-79c3-9807-5c091729a9a8","chunk":"Read text file `internal/resumesmoke/store.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|)\n10|\n11|// This file installs smoke records durably: content-addressed,\n12|// no-replace, fsynced files the crash tests kill around. The\n13|// discipline follows the session repository model — an exclusive\n14|// create first, so append-only is a filesystem fact under a second\n15|// process rather than a check-then-act race; identical bytes on an\n16|// existing path are the idempotent replay, and disagreeing bytes\n17|// refuse for quarantine instead of replacing evidence.\n18|//\n19|// The filename carries the record digest, so one record has exactly\n20|// one path: a retry installs the same bytes at the same path, and a\n21|// torn write at that path disagrees with the retry and refuses\n22|// until the operator quarantines it. Only verified records install:\n23|// invalid bytes refuse before any file is created.\n24|\n25|// StoreHooks are the test-only crash points of the install path:\n26|// BeforeCreate runs before the exclusive create, AfterWrite runs\n27|// after the bytes land but before the fsync. Production passes nil.\n28|type StoreHooks struct {\n29|\tBeforeCreate func(path string) error\n30|\tAfterWrite   func(path string) error\n31|}\n32|\n33|// Store verifies the record bytes and installs them at their\n34|// content-addressed path under the directory, creating nothing\n35|// else. It returns the installed path. An identical retry returns\n36|// the same path; disagreeing bytes at that path refuse.\n37|func Store(directory string, record []byte, hooks *StoreHooks) (string, error) {\n38|\tdecoded, err := VerifyRecord(record)\n39|\tif err != nil {\n40|\t\treturn \"\", err\n41|\t}\n42|\tname := \"native-resume-smoke-\" + strings.TrimPrefix(decoded.RecordID, \"sha256:\") + \".json\"\n43|\tpath := filepath.Join(directory, name)\n44|\tif hooks != nil && hooks.BeforeCreate != nil {\n45|\t\tif err := hooks.BeforeCreate(path); err != nil {\n46|\t\t\treturn \"\", err\n47|\t\t}\n48|\t}\n49|\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\n50|\tif err != nil {\n51|\t\tif !os.IsExist(err) {\n52|\t\t\treturn \"\", fmt.Errorf(\"create smoke record: %w\", err)\n53|\t\t}\n54|\t\texisting, readErr := os.ReadFile(path)\n55|\t\tif readErr != nil {\n56|\t\t\treturn \"\", fmt.Errorf(\"read installed smoke record: %w\", readErr)\n57|\t\t}\n58|\t\tif !bytes.Equal(existing, record) {\n59|\t\t\treturn \"\", fmt.Errorf(\"installed smoke record disagrees; quarantine %q before retry\", path)\n60|\t\t}\n61|\t\treturn path, nil\n62|\t}\n63|\tif _, err := file.Write(record); err != nil {\n64|\t\t_ = file.Close()\n65|\t\treturn \"\", fmt.Errorf(\"write smoke record: %w\", err)\n66|\t}\n67|\tif hooks != nil && hooks.AfterWrite != nil {\n68|\t\tif err := hooks.AfterWrite(path); err != nil {\n69|\t\t\t_ = file.Close()\n70|\t\t\treturn \"\", err\n71|\t\t}\n72|\t}\n73|\tif err := file.Sync(); err != nil {\n74|\t\t_ = file.Close()\n75|\t\treturn \"\", fmt.Errorf(\"fsync smoke record: %w\", err)\n76|\t}\n77|\tif err := file.Close(); err != nil {\n78|\t\treturn \"\", fmt.Errorf(\"close smoke record: %w\", err)\n79|\t}\n80|\tif err := syncDirectory(directory); err != nil {\n81|\t\treturn \"\", err\n82|\t}\n83|\treturn path, nil\n84|}\n85|\n86|// Load reads one installed record and verifies it: malformed,\n87|// tampered, or inconsistent bytes refuse, never decode into a\n88|// record the caller could mistake for evidence.\n89|func Load(path string) (Record, []byte, error) {\n90|\tvar empty Record\n91|\tbytes, err := os.ReadFile(path)\n92|\tif err != nil {\n93|\t\treturn empty, nil, fmt.Errorf(\"read smoke record: %w\", err)\n94|\t}\n95|\trecord, err := VerifyRecord(bytes)\n96|\tif err != nil {\n97|\t\treturn empty, nil, err\n98|\t}\n99|\treturn record, bytes, nil\n100|}\n101|\n102|// syncDirectory fsyncs the directory so the installed name is\n103|// durable alongside the file bytes.\n104|func syncDirectory(directory string) error {\n105|\tdir, err := os.Open(directory)\n106|\tif err != nil {\n107|\t\treturn fmt.Errorf(\"open smoke record directory: %w\", err)\n108|\t}\n109|\tdefer func() { _ = dir.Close() }()\n110|\tif err := dir.Sync(); err != nil {\n111|\t\treturn fmt.Errorf(\"fsync smoke record directory: %w\", err)\n112|\t}\n113|\treturn nil\n114|}","final_result":true}}}
