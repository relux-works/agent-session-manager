{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a7","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":686,"recorded_at":1780531400001367,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a6b6d7385ade3b9c6c7a83b64","text":"Read text file `internal/resumesmoke/smoke.go`.\n(499 line(s) above)\n500|\tif err := checkParamsFixtures(params, platform); err != nil {\n501|\t\treturn zero, err\n502|\t}\n503|\treturn deadline, nil\n504|}\n505|\n506|// checkParamsFixtures validates the Section 7.5 fixture ranges:\n507|// workspace paths, terminal geometry, lease shape, and observation\n508|// bounds. Deeper adapter-body semantics stay the adapter's to\n509|// refuse; these are the ranges the smoke itself depends on.\n510|func checkParamsFixtures(params Params, platform scalar.Platform) error {\n511|\tif len(params.Workspaces) == 0 || len(params.Workspaces) > 256 {\n512|\t\treturn fmt.Errorf(\"smoke workspace paths are not 1..256 entries\")\n513|\t}\n514|\tfor id, path := range params.Workspaces {\n515|\t\tif _, err := scalar.ParseUUIDv7(id); err != nil {\n516|\t\t\treturn fmt.Errorf(\"smoke workspace id is not a UUIDv7: %w\", err)\n517|\t\t}\n518|\t\tif _, err := scalar.ParseAbsolutePath(platform, path); err != nil {\n519|\t\t\treturn fmt.Errorf(\"smoke workspace path is not absolute: %w\", err)\n520|\t\t}\n521|\t}\n522|\tif params.Terminal.Backend != \"tmux\" && params.Terminal.Backend != \"conpty\" {\n523|\t\treturn fmt.Errorf(\"smoke terminal backend is not tmux or conpty\")\n524|\t}\n525|\tif params.Terminal.TerminalID == \"\" || len(params.Terminal.TerminalID) > 512 {\n526|\t\treturn fmt.Errorf(\"smoke terminal id is not 1..512 characters\")\n527|\t}\n528|\tif params.Terminal.Columns < 1 || params.Terminal.Columns > 1000 || params.Terminal.Rows < 1 || params.Terminal.Rows > 1000 {\n529|\t\treturn fmt.Errorf(\"smoke terminal geometry is not 1..1000 cells\")\n530|\t}\n531|\tif params.Lease.Epoch == 0 {\n532|\t\treturn fmt.Errorf(\"smoke lease epoch is zero\")\n533|\t}\n534|\tif _, err := scalar.ParseUUIDv4(params.Lease.LeaseID); err != nil {\n535|\t\treturn fmt.Errorf(\"smoke lease id is not a UUIDv4: %w\", err)\n536|\t}\n537|\tif params.Observation.TerminalID == \"\" || len(params.Observation.TerminalID) > 512 {\n538|\t\treturn fmt.Errorf(\"smoke observation terminal id is not 1..512 characters\")\n539|\t}\n540|\tif _, err := scalar.ParseAbsolutePath(platform, params.Observation.ExecutablePath); err != nil {\n541|\t\treturn fmt.Errorf(\"smoke observation executable is not absolute: %w\", err)\n542|\t}\n543|\tif _, err := scalar.ParseTimestamp(params.Observation.StartedAt); err != nil {\n544|\t\treturn fmt.Errorf(\"smoke observation start is not a timestamp: %w\", err)\n545|\t}\n546|\tfor _, member := range []struct {\n547|\t\tname   string\n548|\t\tvalues []string\n549|\t}{\n550|\t\t{\"candidate store paths\", params.Observation.CandidateStorePaths},\n551|\t\t{\"candidate native ids\", params.Observation.CandidateNativeIDs},\n552|\t} {\n553|\t\tif len(member.values) > 256 {\n554|\t\t\treturn fmt.Errorf(\"smoke %s exceed 256 entries\", member.name)\n555|\t\t}\n556|\t\tif !sort.StringsAreSorted(member.values) {\n557|\t\t\treturn fmt.Errorf(\"smoke %s are not sorted\", member.name)\n558|\t\t}\n559|\t\tfor index := 1; index < len(member.values); index++ {\n560|\t\t\tif member.values[index] == member.values[index-1] {\n561|\t\t\t\treturn fmt.Errorf(\"smoke %s are not unique\", member.name)\n562|\t\t\t}\n563|\t\t}\n564|\t}\n565|\treturn nil\n566|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a9","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":687,"recorded_at":1780531400001369,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a6d2375548df119b212a5194b","text":"Read text file `internal/resumesmoke/mutant_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"os\"\n6|\t\"os/exec\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|// This file ships the refusal-mutant harness: every gate in this\n13|// package is weakened to admit exactly one member of the class it\n14|// must reject, and a named test must fail on the weakened tree. A\n15|// delete-only mutant would prove only that the gate exists; each\n16|// mutant below keeps the gate and narrows it, so survival means the\n17|// named test does not actually cover the gate.\n18|//\n19|// The harness never touches the checkout: each mutant is applied to\n20|// a private copy of the module under a temp directory, and one\n21|// focused go test runs there. Copying keeps parallel package runs\n22|// hermetic — a tree-walking census in another package can never\n23|// observe a half-patched file. It skips under -short so short runs\n24|// stay fast; every other run executes it.\n25|\n26|// smokeMutant is one narrowing mutation: the production file, the\n27|// exact text to weaken (which must occur exactly once), its\n28|// narrowed replacement, the focused test mask that must fail, and\n29|// whether the mutant must be killed or must survive. Exactly one\n30|// mutant is the harmless SURVIVED control, which proves the harness\n31|// reports survival instead of failing unconditionally.\n32|type smokeMutant struct {\n33|\tname    string\n34|\tfile    string\n35|\tfind    string\n36|\treplace string\n37|\tmask    string\n38|\tsurvive bool\n39|}\n40|\n41|// smokeMutants is the shipped set: one narrowing mutant per\n42|// refusal, plus the harmless control.\n43|var smokeMutants = []smokeMutant{\n44|\t{\n45|\t\tname:    \"resume-gate-admits-conditional\",\n46|\t\tfile:    \"smoke.go\",\n47|\t\tfind:    \"if run.cell != CellAvailable {\",\n48|\t\treplace: \"if run.cell != CellAvailable && run.cell != CellConditional {\",\n49|\t\tmask:    \"TestSmokeRowVerdicts/gemini-0.54.4-wsl2-amd64\",\n50|\t},\n51|\t{\n52|\t\tname:    \"probe-admits-version-drift\",\n53|\t\tfile:    \"smoke.go\",\n54|\t\tfind:    \"if probed != run.params.Tuple {\",\n55|\t\treplace: \"if probed.ProviderID != run.params.Tuple.ProviderID || probed.Platform != run.params.Tuple.Platform || probed.Architecture != run.params.Tuple.Architecture {\",\n56|\t\tmask:    \"TestSmokeProbeMismatchFails\",\n57|\t},\n58|\t{\n59|\t\tname:    \"identify-admits-strong\",\n60|\t\tfile:    \"smoke.go\",\n61|\t\tfind:    `if outcome.Confidence != \"exact\" {`,\n62|\t\treplace: `if outcome.Confidence != \"exact\" && outcome.Confidence != \"strong\" {`,\n63|\t\tmask:    \"TestSmokeStrongConfidenceFails\",\n64|\t},\n65|\t{\n66|\t\tname:    \"bind-admits-antigravity\",\n67|\t\tfile:    \"smoke.go\",\n68|\t\tfind:    \"if err := provhost.VerifyIdentityDiscovery(identity, run.params.Discovery, discovery); err != nil {\",\n69|\t\treplace: `if err := provhost.VerifyIdentityDiscovery(identity, run.params.Discovery, discovery); err != nil && run.params.Tuple.ProviderID != \"antigravity\" {`,\n70|\t\tmask:    \"TestSmokeAntigravityUnresolvedRealmFails\",\n71|\t},\n72|\t{\n73|\t\tname:    \"digest-scoped-to-pass\",\n74|\t\tfile:    \"record.go\",\n75|\t\tfind:    `if \"sha256:\"+hex.EncodeToString(sum[:]) != record.RecordID {`,\n76|\t\treplace: `if \"sha256:\"+hex.EncodeToString(sum[:]) != record.RecordID && record.Verdict == VerdictPass {`,\n77|\t\tmask:    \"TestSmokeTamperedRecordRefuses\",\n78|\t},\n79|\t{\n80|\t\tname:    \"consistency-admits-fail\",\n81|\t\tfile:    \"record.go\",\n82|\t\tfind:    \"if want := deriveVerdict(record.ResumeCell, record.Checks); record.Verdict != want {\",\n83|\t\treplace: \"if want := deriveVerdict(record.ResumeCell, record.Checks); record.Verdict != want && record.Verdict != VerdictFail {\",\n84|\t\tmask:    \"TestSmokeInconsistentFailRefuses\",\n85|\t},\n86|\t{\n87|\t\tname:    \"disagreement-admits-same-length\",\n88|\t\tfile:    \"store.go\",\n89|\t\tfind:    \"if !bytes.Equal(existing, record) {\",\n90|\t\treplace: \"if len(existing) != len(record) {\",\n91|\t\tmask:    \"TestStoreDisagreementQuarantines\",\n92|\t},\n93|\t{\n94|\t\tname:    \"quiescence-admits-unsafe-codex\",\n95|\t\tfile:    \"smoke.go\",\n96|\t\tfind:    \"if !safe {\",\n97|\t\treplace: `if !safe && run.params.Tuple.ProviderID != \"codex\" {`,\n98|\t\tmask:    \"TestSmokeUnsafeQuiescenceFails\",\n99|\t},\n100|\t{\n101|\t\tname:    \"mapping-admits-yolo\",\n102|\t\tfile:    \"smoke.go\",\n103|\t\tfind:    \"if _, err := provhost.ResolveMapping(run.params.Tuple.ProviderID, run.params.Profile, run.params.Tuple); err != nil {\",\n104|\t\treplace: `if _, err := provhost.ResolveMapping(run.params.Tuple.ProviderID, run.params.Profile, run.params.Tuple); err != nil && run.params.Profile != \"yolo\" {`,\n105|\t\tmask:    \"TestSmokePiUnmappedVersionFails\",\n106|\t},\n107|\t{\n108|\t\tname:    \"matrix-admits-muse-offpin\",\n109|\t\tfile:    \"matrix.go\",\n110|\t\tfind:    `return CellUnknown, \"section-8.4:muse/macos-arm64+appendix-B\"`,\n111|\t\treplace: `return CellConditional, \"section-8.4:muse/macos-arm64+appendix-B\"`,\n112|\t\tmask:    \"TestResumeMatrixCoversEverySpecRow\",\n113|\t},\n114|\t{\n115|\t\tname:    \"harmless-comment-control\",\n116|\t\tfile:    \"smoke.go\",\n117|\t\tfind:    \"// Check names in execution order.\",\n118|\t\treplace: \"// Check names in execution order. Mutant-harness control: no behavior change.\",\n119|\t\tmask:    \"TestSmokeRowVerdicts/codex-0.147.0-macos-amd64\",\n120|\t\tsurvive: true,\n121|\t},\n122|}\n123|\n124|// TestSmokeMutantsAreKilled applies every shipped mutant to a\n125|// private module copy and requires the kill verdict each names:\n126|// narrowing mutants must fail their focused test, and the harmless\n127|// control must pass its.\n128|func TestSmokeMutantsAreKilled(t *testing.T) {\n129|\tif testing.Short() {\n130|\t\tt.Skip(\"mutant harness needs full runs; skipped under -short\")\n131|\t}\n132|\troot := smokeModuleRoot(t)\n133|\tkilled, survived := 0, 0\n134|\tfor _, mutant := range smokeMutants {\n135|\t\tmutant := mutant\n136|\t\tt.Run(mutant.name, func(t *testing.T) {\n137|\t\t\tworkdir := copyModuleForMutant(t, root, mutant)\n138|\t\t\tcommand := exec.Command(\"go\", \"test\", \"./internal/resumesmoke/\", \"-run\", mutant.mask, \"-count=1\")\n139|\t\t\tcommand.Dir = workdir\n140|\t\t\toutput, err := command.CombinedOutput()\n141|\t\t\tfailed := err != nil\n142|\t\t\tt.Logf(\"mutant %s mask %s failed=%v:\\n%s\", mutant.name, mutant.mask, failed, output)\n143|\t\t\tswitch {\n144|\t\t\tcase mutant.survive && failed:\n145|\t\t\t\tt.Fatalf(\"SURVIVED control failed; the harness or the mask is broken:\\n%s\", output)\n146|\t\t\tcase mutant.survive && !failed:\n147|\t\t\t\tsurvived++\n148|\t\t\tcase !mutant.survive && !failed:\n149|\t\t\t\tt.Fatalf(\"SURVIVED: narrowing mutant %q passed %s; the gate is uncovered\", mutant.name, mutant.mask)\n150|\t\t\tcase !mutant.survive && failed && !strings.Contains(string(output), \"FAIL\"):\n151|\t\t\t\tt.Fatalf(\"mutant %q errored without a test failure; the mask may be broken:\\n%s\", mutant.name, output)\n152|\t\t\tdefault:\n153|\t\t\t\tkilled++\n154|\t\t\t}\n155|\t\t})\n156|\t}\n157|\tt.Logf(\"mutants killed=%d survived-controls=%d\", killed, survived)\n158|\tif killed != len(smokeMutants)-1 || survived != 1 {\n159|\t\tt.Fatalf(\"mutant census killed=%d survived=%d, want %d and 1\", killed, survived, len(smokeMutants)-1)\n160|\t}\n161|}\n162|\n163|// smokeModuleRoot returns the repository root two directories\n164|// above this package: the tree the harness copies mutants from.\n165|func smokeModuleRoot(t *testing.T) string {\n166|\tt.Helper()\n167|\tworking, err := os.Getwd()\n168|\tif err != nil {\n169|\t\tt.Fatalf(\"os.Getwd: %v\", err)\n170|\t}\n171|\treturn filepath.Join(working, \"..\", \"..\")\n172|}\n173|\n174|// copyModuleForMutant copies the module sources a mutant run needs\n175|// — go.mod, go.sum, and the internal tree — into a fresh temp\n176|// directory, applies the mutant there, and returns the copy. The\n177|// checkout is only read, never written.\n178|func copyModuleForMutant(t *testing.T, root string, mutant smokeMutant) string {\n179|\tt.Helper()\n180|\tworkdir := t.TempDir()\n181|\tfor _, name := range []string{\"go.mod\", \"go.sum\"} {\n182|\t\tdata, err := os.ReadFile(filepath.Join(root, name))\n183|\t\tif err != nil {\n184|\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n185|\t\t}\n186|\t\tif err := os.WriteFile(filepath.Join(workdir, name), data, 0o600); err != nil {\n187|\t\t\tt.Fatalf(\"stage %s: %v\", name, err)\n188|\t\t}\n189|\t}\n190|\tcopyDir(t, filepath.Join(root, \"internal\"), filepath.Join(workdir, \"internal\"))\n191|\tpath := filepath.Join(workdir, \"internal\", \"resumesmoke\", mutant.file)\n192|\toriginal, err := os.ReadFile(path)\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"read %s: %v\", mutant.file, err)\n195|\t}\n196|\tif bytes.Count(original, []byte(mutant.find)) != 1 {\n197|\t\tt.Fatalf(\"mutant find occurs %d times in %s, want exactly once\", bytes.Count(original, []byte(mutant.find)), mutant.file)\n198|\t}\n199|\tmutated := bytes.Replace(original, []byte(mutant.find), []byte(mutant.replace), 1)\n200|\tif err := os.WriteFile(path, mutated, 0o600); err != nil {\n201|\t\tt.Fatalf(\"apply mutant: %v\", err)\n202|\t}\n203|\treturn workdir\n204|}\n205|\n206|// copyDir copies one directory tree to a fresh destination,\n207|// preserving file modes. Symlinks refuse: the module tree the\n208|// harness copies carries none, and a link would escape the copy.\n209|func copyDir(t *testing.T, source, destination string) {\n210|\tt.Helper()\n211|\tentries, err := os.ReadDir(source)\n212|\tif err != nil {\n213|\t\tt.Fatalf(\"read %s: %v\", source, err)\n214|\t}\n215|\tif err := os.MkdirAll(destination, 0o755); err != nil {\n216|\t\tt.Fatalf(\"stage %s: %v\", destination, err)\n217|\t}\n218|\tfor _, entry := range entries {\n219|\t\tif entry.Type()&os.ModeSymlink != 0 {\n220|\t\t\tt.Fatalf(\"refusing to copy symlink %s\", filepath.Join(source, entry.Name()))\n221|\t\t}\n222|\t\tfrom := filepath.Join(source, entry.Name())\n223|\t\tto := filepath.Join(destination, entry.Name())\n224|\t\tif entry.IsDir() {\n225|\t\t\tcopyDir(t, from, to)\n226|\t\t\tcontinue\n227|\t\t}\n228|\t\tdata, err := os.ReadFile(from)\n229|\t\tif err != nil {\n230|\t\t\tt.Fatalf(\"read %s: %v\", from, err)\n231|\t\t}\n232|\t\tinfo, err := entry.Info()\n233|\t\tif err != nil {\n234|\t\t\tt.Fatalf(\"stat %s: %v\", from, err)\n235|\t\t}\n236|\t\tif err := os.WriteFile(to, data, info.Mode()); err != nil {\n237|\t\t\tt.Fatalf(\"stage %s: %v\", to, err)\n238|\t\t}\n239|\t}\n240|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ab","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":688,"recorded_at":1780531400001371,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a6de47724a746d99a11abd54f","text":"Read text file `internal/resumesmoke/matrix_derive_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// This file derives the Section 8.4 native-resume expectations from\n12|// the pinned specification text and requires the smoke matrix to\n13|// cover every row exactly. The cell values are never retyped here:\n14|// the test parses the provider/platform rows and the native-resume\n15|// cell out of the document, so a matrix value that drifts from the\n16|// pinned contract reddens here rather than passing against a\n17|// hand-typed copy of the same mistake.\n18|\n19|// specRow is one parsed Section 8.4 row: the provider, the platform,\n20|// the architectures it names, the native-resume cell, and the\n21|// version the row pins when it names one.\n22|type specRow struct {\n23|\tprovider      string\n24|\tplatform      string\n25|\tarchitectures []string\n26|\tcell          Cell\n27|\tpinned        string\n28|}\n29|\n30|// derivedFixtureVersions are the probe versions the row tests run\n31|// with. Versions are fixtures, not derivations — Section 8.4 pins\n32|// only the Muse macOS arm64 probe — except the Muse pin itself,\n33|// which the row text carries.\n34|var derivedFixtureVersions = map[string]string{\n35|\t\"codex\":          \"0.147.0\",\n36|\t\"claude\":         \"2.1.229\",\n37|\t\"gemini\":         \"0.54.4\",\n38|\t\"muse\":           \"0.1.0\",\n39|\t\"antigravity\":    \"1.1.14\",\n40|\t\"pi\":             \"0.73.1\",\n41|\t\"qwen\":           \"1.0.0\",\n42|\t\"future-plugin\":  \"0.0.0\",\n43|\t\"not-a-provider\": \"0.0.0\",\n44|}\n45|\n46|// TestResumeMatrixCoversEverySpecRow derives every Section 8.4 row\n47|// and requires the smoke matrix to read the row's native-resume\n48|// cell for each named tuple. The parsed row count is asserted so a\n49|// parser that silently derives nothing fails closed.\n50|func TestResumeMatrixCoversEverySpecRow(t *testing.T) {\n51|\trows := parseSection84(t)\n52|\tif len(rows) != 27 {\n53|\t\tt.Fatalf(\"parsed %d section 8.4 rows, want 27\", len(rows))\n54|\t}\n55|\tvar tuples []specRow\n56|\tfor _, row := range rows {\n57|\t\ttuples = append(tuples, expandRow(row)...)\n58|\t}\n59|\tfor _, row := range tuples {\n60|\t\trow := row\n61|\t\tfor _, architecture := range row.architectures {\n62|\t\t\tarchitecture := architecture\n63|\t\t\tt.Run(row.provider+\"/\"+row.platform+\"/\"+architecture, func(t *testing.T) {\n64|\t\t\t\tversion := derivedFixtureVersions[row.provider]\n65|\t\t\t\tif row.pinned != \"\" {\n66|\t\t\t\t\tversion = row.pinned\n67|\t\t\t\t}\n68|\t\t\t\tcell, gate := ResumeCell(row.provider, version, row.platform, architecture)\n69|\t\t\t\tif cell != row.cell {\n70|\t\t\t\t\tt.Fatalf(\"ResumeCell(%s %s %s %s) = %q, want row cell %q\", row.provider, version, row.platform, architecture, cell, row.cell)\n71|\t\t\t\t}\n72|\t\t\t\tif gate == \"\" {\n73|\t\t\t\t\tt.Fatal(\"ResumeCell returned an empty gate citation\")\n74|\t\t\t\t}\n75|\t\t\t\tif row.pinned != \"\" {\n76|\t\t\t\t\t// A pinned row accepts only its probe: one\n77|\t\t\t\t\t// patch off the pin is unknown, per the\n78|\t\t\t\t\t// Appendix B unsettled-behavior rule the\n79|\t\t\t\t\t// matrix cites. The pin itself comes from\n80|\t\t\t\t\t// the row text; the off-pin version below\n81|\t\t\t\t\t// is the derivation's probe of it.\n82|\t\t\t\t\toff := offPinVersion(row.pinned)\n83|\t\t\t\t\toffCell, _ := ResumeCell(row.provider, off, row.platform, architecture)\n84|\t\t\t\t\tif offCell != CellUnknown {\n85|\t\t\t\t\t\tt.Fatalf(\"ResumeCell(%s %s %s %s) = %q, want unknown off the %s pin\", row.provider, off, row.platform, architecture, offCell, row.pinned)\n86|\t\t\t\t\t}\n87|\t\t\t\t}\n88|\t\t\t})\n89|\t\t}\n90|\t}\n91|}\n92|\n93|// TestResumeMatrixAgreesWithTupleGate requires the matrix and the\n94|// landed Section 8.4 tuple gate to agree on the direction for every\n95|// derived tuple: available and conditional rows pass the gate, and\n96|// unsupported and unknown rows refuse. Both sides are production;\n97|// the agreement pins them against each other.\n98|func TestResumeMatrixAgreesWithTupleGate(t *testing.T) {\n99|\trows := parseSection84(t)\n100|\tif len(rows) != 27 {\n101|\t\tt.Fatalf(\"parsed %d section 8.4 rows, want 27\", len(rows))\n102|\t}\n103|\tvar tuples []specRow\n104|\tfor _, row := range rows {\n105|\t\ttuples = append(tuples, expandRow(row)...)\n106|\t}\n107|\tfor _, row := range tuples {\n108|\t\tversion := derivedFixtureVersions[row.provider]\n109|\t\tif row.pinned != \"\" {\n110|\t\t\tversion = row.pinned\n111|\t\t}\n112|\t\tfor _, architecture := range row.architectures {\n113|\t\t\ttuple := provhost.BuildTuple{ProviderID: row.provider, ProviderVersion: version, Platform: row.platform, Architecture: architecture}\n114|\t\t\terr := provhost.CheckResumeTuple(tuple)\n115|\t\t\tswitch row.cell {\n116|\t\t\tcase CellAvailable, CellConditional:\n117|\t\t\t\tif err != nil {\n118|\t\t\t\t\tt.Errorf(\"CheckResumeTuple(%+v) = %v, want pass for %q row\", tuple, err, row.cell)\n119|\t\t\t\t}\n120|\t\t\tdefault:\n121|\t\t\t\tif err == nil {\n122|\t\t\t\t\tt.Errorf(\"CheckResumeTuple(%+v) = nil, want refusal for %q row\", tuple, row.cell)\n123|\t\t\t\t}\n124|\t\t\t}\n125|\t\t}\n126|\t}\n127|\t// The off-pin Muse probe refuses at the gate too: the unknown\n128|\t// reading of the unsettled version is shared, not unilateral.\n129|\toff := provhost.BuildTuple{ProviderID: \"muse\", ProviderVersion: offPinVersion(\"0.1.0\"), Platform: \"macos\", Architecture: \"arm64\"}\n130|\tif err := provhost.CheckResumeTuple(off); err == nil {\n131|\t\tt.Errorf(\"CheckResumeTuple(%+v) = nil, want refusal off the muse pin\", off)\n132|\t}\n133|}\n134|\n135|// offPinVersion bumps the last version component by one: the\n136|// one-patch-off probe the pin rule must refuse.\n137|func offPinVersion(pinned string) string {\n138|\tparts := strings.Split(pinned, \".\")\n139|\tlast := parts[len(parts)-1]\n140|\tbumped := \"1\"\n141|\tif last == \"1\" {\n142|\t\tbumped = \"2\"\n143|\t} else if last == \"0\" {\n144|\t\tbumped = \"1\"\n145|\t} else {\n146|\t\tbumped = last + \".1\"\n147|\t}\n148|\tparts[len(parts)-1] = bumped\n149|\treturn strings.Join(parts, \".\")\n150|}\n151|\n152|// parseSection84 extracts the Section 8.4 provider/platform rows\n153|// from the pinned v0.6.0 document: the table between the 8.4\n154|// heading and the Section 9 heading.\n155|func parseSection84(t *testing.T) []specRow {\n156|\tt.Helper()\n157|\tdocument, err := specdoc.LoadV060()\n158|\tif err != nil {\n159|\t\tt.Fatalf(\"specdoc.LoadV060: %v\", err)\n160|\t}\n161|\tinTable := false\n162|\tvar rows []specRow\n163|\tfor number := 1; number <= document.LineCount(); number++ {\n164|\t\tline, ok := document.Line(number)\n165|\t\tif !ok {\n166|\t\t\tcontinue\n167|\t\t}\n168|\t\tif strings.HasPrefix(line, \"### 8.4 \") {\n169|\t\t\tinTable = true\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tif inTable && strings.HasPrefix(line, \"## 9.\") {\n173|\t\t\tbreak\n174|\t\t}\n175|\t\tif !inTable || !strings.HasPrefix(line, \"|\") {\n176|\t\t\tcontinue\n177|\t\t}\n178|\t\tcells := splitTableLine(line)\n179|\t\tif len(cells) != 3 {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\thead, status := strings.TrimSpace(cells[0]), strings.TrimSpace(cells[1])\n183|\t\tif head == \"Provider/platform\" || strings.HasPrefix(head, \"---\") {\n184|\t\t\tcontinue\n185|\t\t}\n186|\t\trows = append(rows, parseSpecRow(t, head, status))\n187|\t}\n188|\treturn rows\n189|}\n190|\n191|// parseSpecRow parses one Section 8.4 row head and status into its\n192|// provider, platform, architectures, and native-resume cell. The\n193|// native cell is the first slash-separated status member: the\n194|// triple is always native resume, cross-host materialization, and\n195|// managed terminal, in that order. Rows that span platforms or\n196|// providers expand: Qwen covers every platform, and the future row\n197|// is probed with two distinct unknown provider IDs, so the unknown\n198|// reading is proven for unknown-ness rather than one literal.\n199|func parseSpecRow(t *testing.T, head, status string) specRow {\n200|\tt.Helper()\n201|\tnative := strings.TrimSpace(strings.Split(status, \"/\")[0])\n202|\tvar cell Cell\n203|\tvar pinned string\n204|\tswitch {\n205|\tcase native == \"A\":\n206|\t\tcell = CellAvailable\n207|\tcase strings.HasPrefix(native, \"A for probed \"):\n208|\t\tcell = CellAvailable\n209|\t\tpinned = strings.TrimSpace(strings.TrimPrefix(native, \"A for probed \"))\n210|\tcase strings.HasPrefix(native, \"C\"):\n211|\t\tcell = CellConditional\n212|\tcase strings.HasPrefix(native, \"U\"):\n213|\t\tcell = CellUnsupported\n214|\tcase strings.HasPrefix(native, \"?\"):\n215|\t\tcell = CellUnknown\n216|\tdefault:\n217|\t\tt.Fatalf(\"row %q carries an unparsable native cell %q\", head, native)\n218|\t}\n219|\tprovider, platforms, architectures := parseRowHead(t, head)\n220|\treturn specRow{provider: provider, platform: platforms[0], architectures: architectures, cell: cell, pinned: pinned}\n221|}\n222|\n223|// expandRow expands one parsed row into the tuples it names. Most\n224|// rows name one tuple per architecture; the Qwen row spans every\n225|// platform, and the future row spans every platform under two\n226|// distinct unknown provider IDs.\n227|func expandRow(row specRow) []specRow {\n228|\tif row.provider == \"qwen\" {\n229|\t\tvar expanded []specRow\n230|\t\tfor _, platform := range []string{\"macos\", \"linux\", \"wsl2\", \"windows\"} {\n231|\t\t\texpanded = append(expanded, specRow{provider: \"qwen\", platform: platform, architectures: row.architectures, cell: row.cell})\n232|\t\t}\n233|\t\treturn expanded\n234|\t}\n235|\tif row.provider == \"future-plugin\" {\n236|\t\tvar expanded []specRow\n237|\t\tfor _, provider := range []string{\"future-plugin\", \"not-a-provider\"} {\n238|\t\t\tfor _, platform := range []string{\"macos\", \"linux\", \"wsl2\", \"windows\"} {\n239|\t\t\t\texpanded = append(expanded, specRow{provider: provider, platform: platform, architectures: row.architectures, cell: row.cell})\n240|\t\t\t}\n241|\t\t}\n242|\t\treturn expanded\n243|\t}\n244|\treturn []specRow{row}\n245|}\n246|\n247|// parseRowHead maps one Section 8.4 row head to its provider ID,\n248|// platforms, and named architectures. Every token below is pinned\n249|// by the row-count guard and the cell assertions above: an unknown\n250|// token fails the test instead of defaulting into a row.\n251|func parseRowHead(t *testing.T, head string) (string, []string, []string) {\n252|\tt.Helper()\n253|\tprovider := \"\"\n254|\tfor _, known := range []struct {\n255|\t\ttoken string\n256|\t\tid    string\n257|\t}{\n258|\t\t{\"Codex\", \"codex\"},\n259|\t\t{\"Claude\", \"claude\"},\n260|\t\t{\"Gemini\", \"gemini\"},\n261|\t\t{\"Muse\", \"muse\"},\n262|\t\t{\"Antigravity\", \"antigravity\"},\n263|\t\t{\"Pi\", \"pi\"},\n264|\t\t{\"Qwen\", \"qwen\"},\n265|\t\t{\"Future plugin\", \"future-plugin\"},\n266|\t} {\n267|\t\tif strings.HasPrefix(head, known.token) {\n268|\t\t\tprovider = known.id\n269|\t\t}\n270|\t}\n271|\tif provider == \"\" {\n272|\t\tt.Fatalf(\"row %q names an unknown provider\", head)\n273|\t}\n274|\tvar platforms []string\n275|\tfor _, known := range []struct {\n276|\t\ttoken string\n277|\t\tid    string\n278|\t}{\n279|\t\t{\"macOS\", \"macos\"},\n280|\t\t{\"Linux\", \"linux\"},\n281|\t\t{\"WSL2\", \"wsl2\"},\n282|\t\t{\"native Windows\", \"windows\"},\n283|\t} {\n284|\t\tif strings.Contains(head, known.token) {\n285|\t\t\tplatforms = append(platforms, known.id)\n286|\t\t}\n287|\t}\n288|\tif provider == \"qwen\" || provider == \"future-plugin\" {\n289|\t\tplatforms = []string{\"macos\"}\n290|\t}\n291|\tif len(platforms) != 1 {\n292|\t\tt.Fatalf(\"row %q names %d platforms, want exactly one\", head, len(platforms))\n293|\t}\n294|\tvar architectures []string\n295|\tnamesArch := func(token string) bool {\n296|\t\tfor _, field := range strings.Fields(head) {\n297|\t\t\tif field == token {\n298|\t\t\t\treturn true\n299|\t\t\t}\n300|\t\t}\n301|\t\treturn false\n302|\t}\n303|\tswitch {\n304|\tcase namesArch(\"amd64\") && namesArch(\"arm64\"):\n305|\t\tarchitectures = []string{\"amd64\", \"arm64\"}\n306|\tcase namesArch(\"arm64\"):\n307|\t\tarchitectures = []string{\"arm64\"}\n308|\tcase namesArch(\"amd64\"):\n309|\t\tarchitectures = []string{\"amd64\"}\n310|\tdefault:\n311|\t\tarchitectures = []string{\"amd64\", \"arm64\"}\n312|\t}\n313|\treturn provider, platforms, architectures\n314|}\n315|\n316|// splitTableLine splits one markdown table line into its trimmed\n317|// cells, dropping the leading and trailing pipes.\n318|func splitTableLine(line string) []string {\n319|\tparts := strings.Split(line, \"|\")\n320|\tif len(parts) < 3 {\n321|\t\treturn nil\n322|\t}\n323|\tcells := make([]string, 0, len(parts)-2)\n324|\tfor _, part := range parts[1 : len(parts)-1] {\n325|\t\tcells = append(cells, strings.TrimSpace(part))\n326|\t}\n327|\treturn cells\n328|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
