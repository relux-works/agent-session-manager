{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c89f","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":682,"recorded_at":1780531400001359,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"task_stream":{"kind":"task","id":"01a0ae7a-706c-74b2-aa37-722544c448cc"},"task_id":"01a0ae7a-706c-74b2-aa37-722544c448cc","event":{"kind":"output","task_id":"01a0ae7a-706c-74b2-aa37-722544c448cc","chunk":"Read text file `internal/resumesmoke/matrix_derive_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// This file derives the Section 8.4 native-resume expectations from\n12|// the pinned specification text and requires the smoke matrix to\n13|// cover every row exactly. The cell values are never retyped here:\n14|// the test parses the provider/platform rows and the native-resume\n15|// cell out of the document, so a matrix value that drifts from the\n16|// pinned contract reddens here rather than passing against a\n17|// hand-typed copy of the same mistake.\n18|\n19|// specRow is one parsed Section 8.4 row: the provider, the platform,\n20|// the architectures it names, the native-resume cell, and the\n21|// version the row pins when it names one.\n22|type specRow struct {\n23|\tprovider      string\n24|\tplatform      string\n25|\tarchitectures []string\n26|\tcell          Cell\n27|\tpinned        string\n28|}\n29|\n30|// derivedFixtureVersions are the probe versions the row tests run\n31|// with. Versions are fixtures, not derivations — Section 8.4 pins\n32|// only the Muse macOS arm64 probe — except the Muse pin itself,\n33|// which the row text carries.\n34|var derivedFixtureVersions = map[string]string{\n35|\t\"codex\":          \"0.147.0\",\n36|\t\"claude\":         \"2.1.229\",\n37|\t\"gemini\":         \"0.54.4\",\n38|\t\"muse\":           \"0.1.0\",\n39|\t\"antigravity\":    \"1.1.14\",\n40|\t\"pi\":             \"0.73.1\",\n41|\t\"qwen\":           \"1.0.0\",\n42|\t\"future-plugin\":  \"0.0.0\",\n43|\t\"not-a-provider\": \"0.0.0\",\n44|}\n45|\n46|// TestResumeMatrixCoversEverySpecRow derives every Section 8.4 row\n47|// and requires the smoke matrix to read the row's native-resume\n48|// cell for each named tuple. The parsed row count is asserted so a\n49|// parser that silently derives nothing fails closed.\n50|func TestResumeMatrixCoversEverySpecRow(t *testing.T) {\n51|\trows := parseSection84(t)\n52|\tif len(rows) != 27 {\n53|\t\tt.Fatalf(\"parsed %d section 8.4 rows, want 27\", len(rows))\n54|\t}\n55|\tvar tuples []specRow\n56|\tfor _, row := range rows {\n57|\t\ttuples = append(tuples, expandRow(row)...)\n58|\t}\n59|\tfor _, row := range tuples {\n60|\t\trow := row\n61|\t\tfor _, architecture := range row.architectures {\n62|\t\t\tarchitecture := architecture\n63|\t\t\tt.Run(row.provider+\"/\"+row.platform+\"/\"+architecture, func(t *testing.T) {\n64|\t\t\t\tversion := derivedFixtureVersions[row.provider]\n65|\t\t\t\tif row.pinned != \"\" {\n66|\t\t\t\t\tversion = row.pinned\n67|\t\t\t\t}\n68|\t\t\t\tcell, gate := ResumeCell(row.provider, version, row.platform, architecture)\n69|\t\t\t\tif cell != row.cell {\n70|\t\t\t\t\tt.Fatalf(\"ResumeCell(%s %s %s %s) = %q, want row cell %q\", row.provider, version, row.platform, architecture, cell, row.cell)\n71|\t\t\t\t}\n72|\t\t\t\tif gate == \"\" {\n73|\t\t\t\t\tt.Fatal(\"ResumeCell returned an empty gate citation\")\n74|\t\t\t\t}\n75|\t\t\t\tif row.pinned != \"\" {\n76|\t\t\t\t\t// A pinned row accepts only its probe: one\n77|\t\t\t\t\t// patch off the pin is unknown, per the\n78|\t\t\t\t\t// Appendix B unsettled-behavior rule the\n79|\t\t\t\t\t// matrix cites. The pin itself comes from\n80|\t\t\t\t\t// the row text; the off-pin version below\n81|\t\t\t\t\t// is the derivation's probe of it.\n82|\t\t\t\t\toff := offPinVersion(row.pinned)\n83|\t\t\t\t\toffCell, _ := ResumeCell(row.provider, off, row.platform, architecture)\n84|\t\t\t\t\tif offCell != CellUnknown {\n85|\t\t\t\t\t\tt.Fatalf(\"ResumeCell(%s %s %s %s) = %q, want unknown off the %s pin\", row.provider, off, row.platform, architecture, offCell, row.pinned)\n86|\t\t\t\t\t}\n87|\t\t\t\t}\n88|\t\t\t})\n89|\t\t}\n90|\t}\n91|}\n92|\n93|// TestResumeMatrixAgreesWithTupleGate requires the matrix and the\n94|// landed Section 8.4 tuple gate to agree on the direction for every\n95|// derived tuple: available and conditional rows pass the gate, and\n96|// unsupported and unknown rows refuse. Both sides are production;\n97|// the agreement pins them against each other.\n98|func TestResumeMatrixAgreesWithTupleGate(t *testing.T) {\n99|\trows := parseSection84(t)\n100|\tif len(rows) != 27 {\n101|\t\tt.Fatalf(\"parsed %d section 8.4 rows, want 27\", len(rows))\n102|\t}\n103|\tvar tuples []specRow\n104|\tfor _, row := range rows {\n105|\t\ttuples = append(tuples, expandRow(row)...)\n106|\t}\n107|\tfor _, row := range tuples {\n108|\t\tversion := derivedFixtureVersions[row.provider]\n109|\t\tif row.pinned != \"\" {\n110|\t\t\tversion = row.pinned\n111|\t\t}\n112|\t\tfor _, architecture := range row.architectures {\n113|\t\t\ttuple := provhost.BuildTuple{ProviderID: row.provider, ProviderVersion: version, Platform: row.platform, Architecture: architecture}\n114|\t\t\terr := provhost.CheckResumeTuple(tuple)\n115|\t\t\tswitch row.cell {\n116|\t\t\tcase CellAvailable, CellConditional:\n117|\t\t\t\tif err != nil {\n118|\t\t\t\t\tt.Errorf(\"CheckResumeTuple(%+v) = %v, want pass for %q row\", tuple, err, row.cell)\n119|\t\t\t\t}\n120|\t\t\tdefault:\n121|\t\t\t\tif err == nil {\n122|\t\t\t\t\tt.Errorf(\"CheckResumeTuple(%+v) = nil, want refusal for %q row\", tuple, row.cell)\n123|\t\t\t\t}\n124|\t\t\t}\n125|\t\t}\n126|\t}\n127|\t// The off-pin Muse probe refuses at the gate too: the unknown\n128|\t// reading of the unsettled version is shared, not unilateral.\n129|\toff := provhost.BuildTuple{ProviderID: \"muse\", ProviderVersion: offPinVersion(\"0.1.0\"), Platform: \"macos\", Architecture: \"arm64\"}\n130|\tif err := provhost.CheckResumeTuple(off); err == nil {\n131|\t\tt.Errorf(\"CheckResumeTuple(%+v) = nil, want refusal off the muse pin\", off)\n132|\t}\n133|}\n134|\n135|// offPinVersion bumps the last version component by one: the\n136|// one-patch-off probe the pin rule must refuse.\n137|func offPinVersion(pinned string) string {\n138|\tparts := strings.Split(pinned, \".\")\n139|\tlast := parts[len(parts)-1]\n140|\tbumped := \"1\"\n141|\tif last == \"1\" {\n142|\t\tbumped = \"2\"\n143|\t} else if last == \"0\" {\n144|\t\tbumped = \"1\"\n145|\t} else {\n146|\t\tbumped = last + \".1\"\n147|\t}\n148|\tparts[len(parts)-1] = bumped\n149|\treturn strings.Join(parts, \".\")\n150|}\n151|\n152|// parseSection84 extracts the Section 8.4 provider/platform rows\n153|// from the pinned v0.6.0 document: the table between the 8.4\n154|// heading and the Section 9 heading.\n155|func parseSection84(t *testing.T) []specRow {\n156|\tt.Helper()\n157|\tdocument, err := specdoc.LoadV060()\n158|\tif err != nil {\n159|\t\tt.Fatalf(\"specdoc.LoadV060: %v\", err)\n160|\t}\n161|\tinTable := false\n162|\tvar rows []specRow\n163|\tfor number := 1; number <= document.LineCount(); number++ {\n164|\t\tline, ok := document.Line(number)\n165|\t\tif !ok {\n166|\t\t\tcontinue\n167|\t\t}\n168|\t\tif strings.HasPrefix(line, \"### 8.4 \") {\n169|\t\t\tinTable = true\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tif inTable && strings.HasPrefix(line, \"## 9.\") {\n173|\t\t\tbreak\n174|\t\t}\n175|\t\tif !inTable || !strings.HasPrefix(line, \"|\") {\n176|\t\t\tcontinue\n177|\t\t}\n178|\t\tcells := splitTableLine(line)\n179|\t\tif len(cells) != 3 {\n180|\t\t\tcontinue\n181|\t\t}\n182|\t\thead, status := strings.TrimSpace(cells[0]), strings.TrimSpace(cells[1])\n183|\t\tif head == \"Provider/platform\" || strings.HasPrefix(head, \"---\") {\n184|\t\t\tcontinue\n185|\t\t}\n186|\t\trows = append(rows, parseSpecRow(t, head, status))\n187|\t}\n188|\treturn rows\n189|}\n190|\n191|// parseSpecRow parses one Section 8.4 row head and status into its\n192|// provider, platform, architectures, and native-resume cell. The\n193|// native cell is the first slash-separated status member: the\n194|// triple is always native resume, cross-host materialization, and\n195|// managed terminal, in that order. Rows that span platforms or\n196|// providers expand: Qwen covers every platform, and the future row\n197|// is probed with two distinct unknown provider IDs, so the unknown\n198|// reading is proven for unknown-ness rather than one literal.\n199|func parseSpecRow(t *testing.T, head, status string) specRow {\n200|\tt.Helper()\n201|\tnative := strings.TrimSpace(strings.Split(status, \"/\")[0])\n202|\tvar cell Cell\n203|\tvar pinned string\n204|\tswitch {\n205|\tcase native == \"A\":\n206|\t\tcell = CellAvailable\n207|\tcase strings.HasPrefix(native, \"A for probed \"):\n208|\t\tcell = CellAvailable\n209|\t\tpinned = strings.TrimSpace(strings.TrimPrefix(native, \"A for probed \"))\n210|\tcase strings.HasPrefix(native, \"C\"):\n211|\t\tcell = CellConditional\n212|\tcase strings.HasPrefix(native, \"U\"):\n213|\t\tcell = CellUnsupported\n214|\tcase strings.HasPrefix(native, \"?\"):\n215|\t\tcell = CellUnknown\n216|\tdefault:\n217|\t\tt.Fatalf(\"row %q carries an unparsable native cell %q\", head, native)\n218|\t}\n219|\tprovider, platforms, architectures := parseRowHead(t, head)\n220|\treturn specRow{provider: provider, platform: platforms[0], architectures: architectures, cell: cell, pinned: pinned}\n221|}\n222|\n223|// expandRow expands one parsed row into the tuples it names. Most\n224|// rows name one tuple per architecture; the Qwen row spans every\n225|// platform, and the future row spans every platform under two\n226|// distinct unknown provider IDs.\n227|func expandRow(row specRow) []specRow {\n228|\tif row.provider == \"qwen\" {\n229|\t\tvar expanded []specRow\n230|\t\tfor _, platform := range []string{\"macos\", \"linux\", \"wsl2\", \"windows\"} {\n231|\t\t\texpanded = append(expanded, specRow{provider: \"qwen\", platform: platform, architectures: row.architectures, cell: row.cell})\n232|\t\t}\n233|\t\treturn expanded\n234|\t}\n235|\tif row.provider == \"future-plugin\" {\n236|\t\tvar expanded []specRow\n237|\t\tfor _, provider := range []string{\"future-plugin\", \"not-a-provider\"} {\n238|\t\t\tfor _, platform := range []string{\"macos\", \"linux\", \"wsl2\", \"windows\"} {\n239|\t\t\t\texpanded = append(expanded, specRow{provider: provider, platform: platform, architectures: row.architectures, cell: row.cell})\n240|\t\t\t}\n241|\t\t}\n242|\t\treturn expanded\n243|\t}\n244|\treturn []specRow{row}\n245|}\n246|\n247|// parseRowHead maps one Section 8.4 row head to its provider ID,\n248|// platforms, and named architectures. Every token below is pinned\n249|// by the row-count guard and the cell assertions above: an unknown\n250|// token fails the test instead of defaulting into a row.\n251|func parseRowHead(t *testing.T, head string) (string, []string, []string) {\n252|\tt.Helper()\n253|\tprovider := \"\"\n254|\tfor _, known := range []struct {\n255|\t\ttoken string\n256|\t\tid    string\n257|\t}{\n258|\t\t{\"Codex\", \"codex\"},\n259|\t\t{\"Claude\", \"claude\"},\n260|\t\t{\"Gemini\", \"gemini\"},\n261|\t\t{\"Muse\", \"muse\"},\n262|\t\t{\"Antigravity\", \"antigravity\"},\n263|\t\t{\"Pi\", \"pi\"},\n264|\t\t{\"Qwen\", \"qwen\"},\n265|\t\t{\"Future plugin\", \"future-plugin\"},\n266|\t} {\n267|\t\tif strings.HasPrefix(head, known.token) {\n268|\t\t\tprovider = known.id\n269|\t\t}\n270|\t}\n271|\tif provider == \"\" {\n272|\t\tt.Fatalf(\"row %q names an unknown provider\", head)\n273|\t}\n274|\tvar platforms []string\n275|\tfor _, known := range []struct {\n276|\t\ttoken string\n277|\t\tid    string\n278|\t}{\n279|\t\t{\"macOS\", \"macos\"},\n280|\t\t{\"Linux\", \"linux\"},\n281|\t\t{\"WSL2\", \"wsl2\"},\n282|\t\t{\"native Windows\", \"windows\"},\n283|\t} {\n284|\t\tif strings.Contains(head, known.token) {\n285|\t\t\tplatforms = append(platforms, known.id)\n286|\t\t}\n287|\t}\n288|\tif provider == \"qwen\" || provider == \"future-plugin\" {\n289|\t\tplatforms = []string{\"macos\"}\n290|\t}\n291|\tif len(platforms) != 1 {\n292|\t\tt.Fatalf(\"row %q names %d platforms, want exactly one\", head, len(platforms))\n293|\t}\n294|\tvar architectures []string\n295|\tnamesArch := func(token string) bool {\n296|\t\tfor _, field := range strings.Fields(head) {\n297|\t\t\tif field == token {\n298|\t\t\t\treturn true\n299|\t\t\t}\n300|\t\t}\n301|\t\treturn false\n302|\t}\n303|\tswitch {\n304|\tcase namesArch(\"amd64\") && namesArch(\"arm64\"):\n305|\t\tarchitectures = []string{\"amd64\", \"arm64\"}\n306|\tcase namesArch(\"arm64\"):\n307|\t\tarchitectures = []string{\"arm64\"}\n308|\tcase namesArch(\"amd64\"):\n309|\t\tarchitectures = []string{\"amd64\"}\n310|\tdefault:\n311|\t\tarchitectures = []string{\"amd64\", \"arm64\"}\n312|\t}\n313|\treturn provider, platforms, architectures\n314|}\n315|\n316|// splitTableLine splits one markdown table line into its trimmed\n317|// cells, dropping the leading and trailing pipes.\n318|func splitTableLine(line string) []string {\n319|\tparts := strings.Split(line, \"|\")\n320|\tif len(parts) < 3 {\n321|\t\treturn nil\n322|\t}\n323|\tcells := make([]string, 0, len(parts)-2)\n324|\tfor _, part := range parts[1 : len(parts)-1] {\n325|\t\tcells = append(cells, strings.TrimSpace(part))\n326|\t}\n327|\treturn cells\n328|}","final_result":true}}}
