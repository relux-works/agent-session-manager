6|\t\tt.Fatalf(\"SplitIdentifyResult error = %v\", err)\n37|\t}\n38|\tif outcome.Confidence != \"exact\" {\n39|\t\tt.Fatalf(\"confidence = %q, want exact\", outcome.Confidence)\n40|\t}\n41|\tif !bytes.Equal(outcome.Identity, identity) {\n42|\t\tt.Fatal(\"replayed identity differs from the validated member\")\n43|\t}\n44|\t// The replay is a copy: mutating it must not alias the body.\n45|\toutcome.Identity[0] ^= 0xff\n46|\tif bytes.Equal(outcome.Identity, identity) {\n47|\t\tt.Fatal(\"mutating the replay changed the validated member; want a copy\")\n48|\t}\n49|\tvar decoded map[string]json.RawMessage\n50|\tif err := json.Unmarshal(body, &decoded); err != nil {\n51|\t\tt.Fatalf(\"unmarshal identify body: %v\", err)\n52|\t}\n53|\tif !bytes.Equal(decoded[\"identity\"], identity) {\n54|\t\tt.Fatal(\"mutating the replay corrupted the response body; want a copy\")\n55|\t}\n56|}\n57|\n58|func TestSplitIdentifyResultRefusesMalformedBody(t *testing.T) {\n59|\tidentity := validCreatedIdentity(t, validCreateParams())\n60|\tif _, err := SplitIdentifyResult(identifyBody(t, identity, \"certain\"), validCreateParams().ProviderID); err == nil {\n61|\t\tt.Fatal(\"SplitIdentifyResult(bad confidence) = nil, want provider_protocol_error\")\n62|\t}\n63|}\n64|\n65|func validCreatedIdentity(t *testing.T, params IdentityParams) []byte {\n66|\tt.Helper()\n67|\tidentity, err := CreateIdentity(params)\n68|\tif err != nil {\n69|\t\tt.Fatalf(\"CreateIdentity error = %v\", err)\n70|\t}\n71|\treturn identity\n72|}\n73|\n74|func identifyBody(t *testing.T, identity []byte, confidence string) []byte {\n75|\tt.Helper()\n76|\tbody, err := json.Marshal(map[string]any{\n77|\t\t\"identity\":         json.RawMessage(identity),\n78|\t\t\"confidence\":       confidence,\n79|\t\t\"matched_evidence\": []string{\"native_id\"},\n80|\t})\n81|\tif err != nil {\n82|\t\tt.Fatalf(\"marshal identify body: %v\", err)\n83|\t}\n84|\treturn body\n85|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
