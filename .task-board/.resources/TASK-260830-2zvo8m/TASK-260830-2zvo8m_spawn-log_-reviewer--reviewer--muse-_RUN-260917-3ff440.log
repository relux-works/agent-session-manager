{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c95d","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":777,"recorded_at":1780531400001549,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"task_stream":{"kind":"task","id":"01a0ae7a-8b4e-7140-9e87-b8ca65c97520"},"task_id":"01a0ae7a-8b4e-7140-9e87-b8ca65c97520","event":{"kind":"output","task_id":"01a0ae7a-8b4e-7140-9e87-b8ca65c97520","chunk":"Read text file `internal/resumesmoke/main_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"io\"\n7|\t\"os\"\n8|\t\"testing\"\n9|\t\"time\"\n10|)\n11|\n12|// TestMain gates the helper processes first: when the marker names\n13|// a helper, this binary serves it and exits before the suite runs,\n14|// so a helper child never re-enters the suite or spawns\n15|// grandchildren.\n16|func TestMain(main *testing.M) {\n17|\tswitch os.Getenv(\"RESUMESMOKE_HELPER\") {\n18|\tcase \"fake-provider\":\n19|\t\trunFakeProviderHelper()\n20|\tcase \"crash-store\":\n21|\t\trunCrashStoreHelper()\n22|\t}\n23|\tos.Exit(main.Run())\n24|}\n25|\n26|// runFakeProviderHelper serves one provider-protocol frame as the\n27|// fake adapter executable: it reads the request, loads the canned\n28|// body file the parent named for the operation, and prints the\n29|// success envelope with the echoed request ID. Unknown operations\n30|// exit nonzero with no frame, which the host refuses as a process\n31|// failure rather than mistaking for a result.\n32|func runFakeProviderHelper() {\n33|\tstdin, err := io.ReadAll(os.Stdin)\n34|\tif err != nil {\n35|\t\tfmt.Fprintf(os.Stderr, \"helper read: %v\\n\", err)\n36|\t\tos.Exit(1)\n37|\t}\n38|\tvar frame struct {\n39|\t\tRequestID string          `json:\"request_id\"`\n40|\t\tOperation string          `json:\"operation\"`\n41|\t\tBody      json.RawMessage `json:\"body\"`\n42|\t}\n43|\tif err := json.Unmarshal(stdin, &frame); err != nil {\n44|\t\tfmt.Fprintf(os.Stderr, \"helper frame: %v\\n\", err)\n45|\t\tos.Exit(1)\n46|\t}\n47|\tpath := \"\"\n48|\tswitch frame.Operation {\n49|\tcase \"probe\":\n50|\t\tpath = os.Getenv(\"RESUMESMOKE_PROBE\")\n51|\tcase \"identify-session\":\n52|\t\tpath = os.Getenv(\"RESUMESMOKE_IDENTIFY\")\n53|\tcase \"resume\":\n54|\t\tpath = os.Getenv(\"RESUMESMOKE_RESUME\")\n55|\tdefault:\n56|\t\tfmt.Fprintf(os.Stderr, \"helper unexpected operation %q\\n\", frame.Operation)\n57|\t\tos.Exit(1)\n58|\t}\n59|\tbody, err := os.ReadFile(path)\n60|\tif err != nil {\n61|\t\tfmt.Fprintf(os.Stderr, \"helper body: %v\\n\", err)\n62|\t\tos.Exit(1)\n63|\t}\n64|\tresponse := map[string]any{\n65|\t\t\"protocol\":         \"urn:ax:protocol:provider\",\n66|\t\t\"protocol_version\": \"2.0.0\",\n67|\t\t\"request_id\":       frame.RequestID,\n68|\t\t\"ok\":               true,\n69|\t\t\"body\":             json.RawMessage(body),\n70|\t}\n71|\trendered, err := json.Marshal(response)\n72|\tif err != nil {\n73|\t\tfmt.Fprintf(os.Stderr, \"helper response: %v\\n\", err)\n74|\t\tos.Exit(1)\n75|\t}\n76|\trendered = append(rendered, '\\n')\n77|\tif _, err := os.Stdout.Write(rendered); err != nil {\n78|\t\tfmt.Fprintf(os.Stderr, \"helper write: %v\\n\", err)\n79|\t\tos.Exit(1)\n80|\t}\n81|\tos.Exit(0)\n82|}\n83|\n84|// runCrashStoreHelper installs one record and dies mid-install: the\n85|// AfterWrite hook signals readiness, then the process sleeps so the\n86|// parent can kill it between the write and the fsync. Exit codes\n87|// are diagnostics; the kill is the test.\n88|func runCrashStoreHelper() {\n89|\tinput, err := os.ReadFile(os.Getenv(\"RESUMESMOKE_INPUT\"))\n90|\tif err != nil {\n91|\t\tfmt.Fprintf(os.Stderr, \"helper input: %v\\n\", err)\n92|\t\tos.Exit(1)\n93|\t}\n94|\tready := os.Getenv(\"RESUMESMOKE_READY\")\n95|\thooks := &StoreHooks{AfterWrite: func(string) error {\n96|\t\tif err := os.WriteFile(ready, []byte(\"ready\"), 0o600); err != nil {\n97|\t\t\tfmt.Fprintf(os.Stderr, \"helper ready: %v\\n\", err)\n98|\t\t\tos.Exit(1)\n99|\t\t}\n100|\t\ttime.Sleep(60 * time.Second)\n101|\t\treturn nil\n102|\t}}\n103|\tif _, err := Store(os.Getenv(\"RESUMESMOKE_DIR\"), input, hooks); err != nil {\n104|\t\tfmt.Fprintf(os.Stderr, \"helper store: %v\\n\", err)\n105|\t\tos.Exit(1)\n106|\t}\n107|\tos.Exit(0)\n108|}","final_result":true}}}
