{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c951","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":771,"recorded_at":1780531400001537,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"task_stream":{"kind":"task","id":"01a0ae7a-8ad4-7a93-9935-ea7e8c347edd"},"task_id":"01a0ae7a-8ad4-7a93-9935-ea7e8c347edd","event":{"kind":"output","task_id":"01a0ae7a-8ad4-7a93-9935-ea7e8c347edd","chunk":"Read text file `internal/resumesmoke/spawn_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n12|)\n13|\n14|// This file proves the smoke runs through a real provider process:\n15|// the fake adapter is the test binary re-executed as the provider\n16|// executable under the production ExecRunner, answering canned\n17|// bodies the parent built with the shared fixtures.\n18|\n19|// TestSmokeThroughRealProviderProcess runs one available row end to\n20|// end with the adapter as a real child process per operation. The\n21|// verdict, checks, and record integrity must equal the in-process\n22|// run exactly.\n23|func TestSmokeThroughRealProviderProcess(t *testing.T) {\n24|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"linux\", Architecture: \"amd64\"}\n25|\trunner := newScriptedRunner(t)\n26|\trunner.scriptProbe(tuple)\n27|\trunner.scriptIdentify(t, tuple, \"exact\")\n28|\tprobeBody := captureCannedBody(t, runner, \"probe\", smokeProbeRequest(t, tuple))\n29|\tidentifyBody := captureCannedBody(t, runner, \"identify-session\", smokeIdentifyRequest(t))\n30|\tdirectory := t.TempDir()\n31|\tprobePath := writeHelperBody(t, directory, \"probe.json\", probeBody)\n32|\tidentifyPath := writeHelperBody(t, directory, \"identify.json\", identifyBody)\n33|\t// The resume script asserts the threaded identity; capture the\n34|\t// plan from a resume-shaped request carrying it.\n35|\trunner.scriptResume(t, tuple, \"standard\")\n36|\tresumeBody := captureCannedBody(t, runner, \"resume\", smokeResumeRequest(t, runner.identity))\n37|\tresumePath := writeHelperBody(t, directory, \"resume.json\", resumeBody)\n38|\n39|\texecutable, err := os.Executable()\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"os.Executable: %v\", err)\n42|\t}\n43|\tenvironment := append(os.Environ(),\n44|\t\t\"RESUMESMOKE_HELPER=fake-provider\",\n45|\t\t\"RESUMESMOKE_PROBE=\"+probePath,\n46|\t\t\"RESUMESMOKE_IDENTIFY=\"+identifyPath,\n47|\t\t\"RESUMESMOKE_RESUME=\"+resumePath,\n48|\t)\n49|\tclock, err := time.Parse(time.RFC3339, smokeClock)\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"parse smoke clock: %v\", err)\n52|\t}\n53|\thost := provhost.Host{Runner: provhost.ExecRunner{Env: environment}, Now: func() time.Time { return clock }}\n54|\tparams := smokeParams(tuple, runner)\n55|\tparams.Host = host\n56|\tparams.Executable = executable\n57|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n58|\treport, err := Run(context.Background(), params)\n59|\tif err != nil {\n60|\t\tt.Fatalf(\"Run error = %v\", err)\n61|\t}\n62|\tassertVerdict(t, report.Record, VerdictPass)\n63|\tassertOutcomes(t, report.Record, map[string]Outcome{\n64|\t\t\"resume-cell\":   OutcomePass,\n65|\t\t\"tuple-gate\":    OutcomePass,\n66|\t\t\"probe\":         OutcomePass,\n67|\t\t\"identify\":      OutcomePass,\n68|\t\t\"discover-bind\": OutcomePass,\n69|\t\t\"quiescence\":    OutcomeSkipped,\n70|\t\t\"resume-plan\":   OutcomePass,\n71|\t})\n72|\tassertNoCanary(t, report.Bytes)\n73|\tif _, err := VerifyRecord(report.Bytes); err != nil {\n74|\t\tt.Fatalf(\"VerifyRecord(process bytes) = %v\", err)\n75|\t}\n76|\t// The process run replays the in-process bytes exactly: the\n77|\t// transport carries no identity of its own.\n78|\tinProcess := runRowFixture(t, tuple)\n79|\tif string(inProcess.Bytes) != string(report.Bytes) {\n80|\t\tt.Fatal(\"process run bytes differ from the in-process run\")\n81|\t}\n82|}\n83|\n84|// captureCannedBody runs one scripted handler over a fixture\n85|// request body and returns the canned response body.\n86|func captureCannedBody(t *testing.T, runner *scriptedRunner, operation string, request json.RawMessage) json.RawMessage {\n87|\tt.Helper()\n88|\thandler, ok := runner.script[operation]\n89|\tif !ok {\n90|\t\tt.Fatalf(\"no script for %q\", operation)\n91|\t}\n92|\treturn handler(request)\n93|}\n94|\n95|func writeHelperBody(t *testing.T, directory, name string, body json.RawMessage) string {\n96|\tt.Helper()\n97|\tpath := filepath.Join(directory, name)\n98|\tif err := os.WriteFile(path, body, 0o600); err != nil {\n99|\t\tt.Fatalf(\"write helper body: %v\", err)\n100|\t}\n101|\treturn path\n102|}\n103|\n104|func smokeProbeRequest(t *testing.T, tuple provhost.BuildTuple) json.RawMessage {\n105|\tt.Helper()\n106|\treturn json.RawMessage(`{\"platform\": \"` + tuple.Platform + `\", \"architecture\": \"` + tuple.Architecture + `\", \"provider_executable\": null, \"requested_capabilities\": [\"native_resume\"]}`)\n107|}\n108|\n109|func smokeIdentifyRequest(t *testing.T) json.RawMessage {\n110|\tt.Helper()\n111|\treturn json.RawMessage(`{\"session_id\": \"` + smokeSessionID + `\", \"provider_id\": \"codex\", \"observation\": {\"terminal_id\": \"smoke-terminal\", \"executable_path\": \"/smoke/bin/codex\", \"started_at\": \"` + smokeCreatedAt + `\", \"candidate_store_paths\": [], \"candidate_native_ids\": []}}`)\n112|}\n113|\n114|func smokeResumeRequest(t *testing.T, identity json.RawMessage) json.RawMessage {\n115|\tt.Helper()\n116|\treturn json.RawMessage(`{\"identity\": ` + string(identity) + `, \"workspace_paths\": {\"` + smokeWorkID + `\": \"/smoke/work\"}, \"execution_profile\": \"standard\", \"terminal\": {\"backend\": \"tmux\", \"terminal_id\": \"smoke-terminal\", \"interactive\": true, \"columns\": 120, \"rows\": 40}, \"lease\": {\"session_id\": \"` + smokeSessionID + `\", \"lease_epoch\": 1, \"lease_id\": \"` + smokeLeaseID + `\"}}`)\n117|}","final_result":true}}}
