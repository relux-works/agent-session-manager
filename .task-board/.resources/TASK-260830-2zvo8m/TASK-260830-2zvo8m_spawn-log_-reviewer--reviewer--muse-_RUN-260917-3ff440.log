{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9cd","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":833,"recorded_at":1780531400001661,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"task_stream":{"kind":"task","id":"01a0ae7a-a6d6-7c92-b591-a82d8a4384dd"},"task_id":"01a0ae7a-a6d6-7c92-b591-a82d8a4384dd","event":{"kind":"output","task_id":"01a0ae7a-a6d6-7c92-b591-a82d8a4384dd","chunk":"Read text file `internal/provhost/accessors_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"testing\"\n7|)\n8|\n9|// The replay accessors below hand validated probe and identify\n10|// members to use sites that bind them further. They add no refusal\n11|// of their own: a malformed body fails with the decoder's error,\n12|// and the replayed members are the validated output, never a second\n13|// decode.\n14|\n15|func TestProbeBuildReplaysValidatedTuple(t *testing.T) {\n16|\ttuple, err := ProbeBuild([]byte(specProbeExample))\n17|\tif err != nil {\n18|\t\tt.Fatalf(\"ProbeBuild(spec) error = %v\", err)\n19|\t}\n20|\tif tuple.ProviderID != \"pi\" || tuple.ProviderVersion != \"0.73.1\" || tuple.Platform != \"macos\" || tuple.Architecture != \"arm64\" {\n21|\t\tt.Fatalf(\"ProbeBuild(spec) = %+v, want pi 0.73.1 macos arm64\", tuple)\n22|\t}\n23|}\n24|\n25|func TestProbeBuildRefusesMalformedProbe(t *testing.T) {\n26|\tif _, err := ProbeBuild(probeVariant(t, `\"arm64\"`, `\"sparc\"`)); err == nil {\n27|\t\tt.Fatal(\"ProbeBuild(bad architecture) = nil, want provider_protocol_error\")\n28|\t}\n29|}\n30|\n31|func TestSplitIdentifyResultReplaysIdentityAndConfidence(t *testing.T) {\n32|\tidentity := validCreatedIdentity(t, validCreateParams())\n33|\tbody := identifyBody(t, identity, \"exact\")\n34|\toutcome, err := SplitIdentifyResult(body, validCreateParams().ProviderID)\n35|\tif err != nil {\n36|\t\tt.Fatalf(\"SplitIdentifyResult error = %v\", err)\n37|\t}\n38|\tif outcome.Confidence != \"exact\" {\n39|\t\tt.Fatalf(\"confidence = %q, want exact\", outcome.Confidence)\n40|\t}\n41|\tif !bytes.Equal(outcome.Identity, identity) {\n42|\t\tt.Fatal(\"replayed identity differs from the validated member\")\n43|\t}\n44|\t// The replay is a copy: mutating it must not alias the body.\n45|\toutcome.Identity[0] ^= 0xff\n46|\tif bytes.Equal(outcome.Identity, identity) {\n47|\t\tt.Fatal(\"mutating the replay changed the validated member; want a copy\")\n48|\t}\n49|\tvar decoded map[string]json.RawMessage\n50|\tif err := json.Unmarshal(body, &decoded); err != nil {\n51|\t\tt.Fatalf(\"unmarshal identify body: %v\", err)\n52|\t}\n53|\tif !bytes.Equal(decoded[\"identity\"], identity) {\n54|\t\tt.Fatal(\"mutating the replay corrupted the response body; want a copy\")\n55|\t}\n56|}\n57|\n58|func TestSplitIdentifyResultRefusesMalformedBody(t *testing.T) {\n59|\tidentity := validCreatedIdentity(t, validCreateParams())\n60|\tif _, err := SplitIdentifyResult(identifyBody(t, identity, \"certain\"), validCreateParams().ProviderID); err == nil {\n61|\t\tt.Fatal(\"SplitIdentifyResult(bad confidence) = nil, want provider_protocol_error\")\n62|\t}\n63|}\n64|\n65|func validCreatedIdentity(t *testing.T, params IdentityParams) []byte {\n66|\tt.Helper()\n67|\tidentity, err := CreateIdentity(params)\n68|\tif err != nil {\n69|\t\tt.Fatalf(\"CreateIdentity error = %v\", err)\n70|\t}\n71|\treturn identity\n72|}\n73|\n74|func identifyBody(t *testing.T, identity []byte, confidence string) []byte {\n75|\tt.Helper()\n76|\tbody, err := json.Marshal(map[string]any{\n77|\t\t\"identity\":         json.RawMessage(identity),\n78|\t\t\"confidence\":       confidence,\n79|\t\t\"matched_evidence\": []string{\"native_id\"},\n80|\t})\n81|\tif err != nil {\n82|\t\tt.Fatalf(\"marshal identify body: %v\", err)\n83|\t}\n84|\treturn body\n85|}","final_result":true}}}
