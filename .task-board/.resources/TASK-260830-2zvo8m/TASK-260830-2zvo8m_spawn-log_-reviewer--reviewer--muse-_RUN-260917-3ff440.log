\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"provhost-mapping-resolution\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"2.4#2\\\",\\n   \\\"line\\\": 646,\\n   \\\"excerpt\\\": \\\"Losing-lease or ambiguous events MUST NOT change it.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"sessprofile-derive\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"2.4#3\\\",\\n   \\\"line\\\": 650,\\n   \\\"excerpt\\\": \\\"a bundle, resume, or fork MUST NOT fall back to the Session Record creation value when the closure contains a later change.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"sessprofile-derive\\\",\\n    \\\"sessprofile-derive-heads\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"2.4#4\\\",\\n   \\\"line\\\": 658,\\n   \\\"excerpt\\\": \\\"MUST NOT be treated as a profile event in the new session's event chain.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"sessprofile-fork-\\n=====\\n[]\\n{\\\"kind\\\": \\\"section_binding\\\", \\\"keys\\\": [\\\"section:2.4\\\"], \\\"production\\\": {\\\"path\\\": \\\"internal/sessprofile/profile.go\\\", \\\"declaration\\\": \\\"Derive\\\"}, \\\"acceptance_cases\\\": [\\\"sessprofile-derive\\\", \\\"sessprofile-derive-heads\\\", \\\"sessprofile-fork-pair\\\", \\\"provhost-mapping-resolution\\\"], \\\"coverage\\\": \\\"full\\\", \\\"clauses\\\": [{\\\"id\\\": \\\"2.4#1\\\", \\\"line\\\": 641, \\\"excerpt\\\": \\\"MUST fail with <code>profile_mapping_unavailable</code> if the adapter cannot map the stored profile for the probed provider version.\\\", \\\"acceptance_cases\\\": [\\\"provhost-mapping-resolution\\\"]}, {\\\"id\\\": \\\"2.4#2\\\", \\\"line\\\": 646, \\\"excerpt\\\": \\\"Losing-lease or ambiguous event\\n---\\n{\\\"kind\\\": \\\"section_binding\\\", \\\"keys\\\": [\\\"section:6.2\\\"], \\\"production\\\": {\\\"path\\\": \\\"internal/config/schema.go\\\", \\\"declaration\\\": \\\"Decode\\\"}, \\\"acceptance_cases\\\": [\\\"config-versioned-readers\\\"], \\\"coverage\\\": \\\"full\\\", \\\"clauses\\\": [{\\\"id\\\": \\\"6.2#1\\\