{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ed","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":721,"recorded_at":1780531400001437,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a76c47631a393687d8af11261","text":"Read text file `internal/resumesmoke/smoke_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"runtime\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n12|)\n13|\n14|// This file drives the production Run entry through scripted fake\n15|// adapters: one verdict per Section 8.4 row, plus the focused\n16|// refusals the story names. Positives cover the available cells;\n17|// conditional cells gate; unsupported and unknown cells refuse with\n18|// no adapter call at all.\n19|\n20|// TestSmokeRowVerdicts runs the full smoke for every Section 8.4\n21|// tuple the derivation parses and requires the row's verdict:\n22|// available rows pass, conditional rows gate with the resume plan\n23|// skipped, and unsupported and unknown rows refuse before any\n24|// adapter call. Native-Windows bind rows need a Windows host —\n25|// store roots join with the host separator while the proof rule is\n26|// platform-native — so those four cases skip loudly elsewhere; the\n27|// matrix derivation above still pins their cells on every host.\n28|func TestSmokeRowVerdicts(t *testing.T) {\n29|\trows := parseSection84(t)\n30|\tif len(rows) != 27 {\n31|\t\tt.Fatalf(\"parsed %d section 8.4 rows, want 27\", len(rows))\n32|\t}\n33|\tvar tuples []specRow\n34|\tfor _, row := range rows {\n35|\t\ttuples = append(tuples, expandRow(row)...)\n36|\t}\n37|\tfor _, row := range tuples {\n38|\t\tfor _, architecture := range row.architectures {\n39|\t\t\tversion := derivedFixtureVersions[row.provider]\n40|\t\t\tif row.pinned != \"\" {\n41|\t\t\t\tversion = row.pinned\n42|\t\t\t}\n43|\t\t\ttuple := provhost.BuildTuple{ProviderID: row.provider, ProviderVersion: version, Platform: row.platform, Architecture: architecture}\n44|\t\t\tname := fmt.Sprintf(\"%s-%s-%s-%s\", row.provider, version, row.platform, architecture)\n45|\t\t\tt.Run(name, func(t *testing.T) {\n46|\t\t\t\tif needsWindowsHost(tuple) && runtime.GOOS != \"windows\" {\n47|\t\t\t\t\tt.Skipf(\"windows native-store bind requires a Windows host; cell %q is pinned by TestResumeMatrixCoversEverySpecRow\", row.cell)\n48|\t\t\t\t}\n49|\t\t\t\trunner := newScriptedRunner(t)\n50|\t\t\t\tparams := smokeParams(tuple, runner)\n51|\t\t\t\tswitch row.cell {\n52|\t\t\t\tcase CellAvailable, CellConditional:\n53|\t\t\t\t\trunner.scriptProbe(tuple)\n54|\t\t\t\t\trunner.scriptIdentify(t, tuple, \"exact\")\n55|\t\t\t\t\tif row.cell == CellAvailable {\n56|\t\t\t\t\t\trunner.scriptResume(t, tuple, params.Profile)\n57|\t\t\t\t\t}\n58|\t\t\t\t\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n59|\t\t\t\t\tif tuple.ProviderID == \"antigravity\" {\n60|\t\t\t\t\t\tparams.Realm = smokeRealm\n61|\t\t\t\t\t}\n62|\t\t\t\tdefault:\n63|\t\t\t\t\tparams.Discovery = json.RawMessage(`{}`)\n64|\t\t\t\t}\n65|\t\t\t\treport, err := Run(context.Background(), params)\n66|\t\t\t\tif err != nil {\n67|\t\t\t\t\tt.Fatalf(\"Run(%+v) error = %v\", tuple, err)\n68|\t\t\t\t}\n69|\t\t\t\tassertNoCanary(t, report.Bytes)\n70|\t\t\t\tif _, err := VerifyRecord(report.Bytes); err != nil {\n71|\t\t\t\t\tt.Fatalf(\"VerifyRecord(row bytes) = %v\", err)\n72|\t\t\t\t}\n73|\t\t\t\tswitch row.cell {\n74|\t\t\t\tcase CellAvailable:\n75|\t\t\t\t\tassertVerdict(t, report.Record, VerdictPass)\n76|\t\t\t\t\tassertOutcomes(t, report.Record, map[string]Outcome{\n77|\t\t\t\t\t\t\"resume-cell\":   OutcomePass,\n78|\t\t\t\t\t\t\"tuple-gate\":    OutcomePass,\n79|\t\t\t\t\t\t\"probe\":         OutcomePass,\n80|\t\t\t\t\t\t\"identify\":      OutcomePass,\n81|\t\t\t\t\t\t\"discover-bind\": OutcomePass,\n82|\t\t\t\t\t\t\"quiescence\":    OutcomeSkipped,\n83|\t\t\t\t\t\t\"resume-plan\":   OutcomePass,\n84|\t\t\t\t\t})\n85|\t\t\t\t\tif report.Record.ProbeDigest == \"\" || report.Record.DiscoveryProofDigest == \"\" || report.Record.IdentityRecordID == \"\" || report.Record.SpawnPlanDigest == \"\" || report.Record.StoreRoot == \"\" {\n86|\t\t\t\t\t\tt.Fatal(\"pass record misses evidence digests or the store root\")\n87|\t\t\t\t\t}\n88|\t\t\t\t\tassertCalls(t, runner, []string{\"probe\", \"identify-session\", \"resume\"})\n89|\t\t\t\tcase CellConditional:\n90|\t\t\t\t\tassertVerdict(t, report.Record, VerdictGated)\n91|\t\t\t\t\tassertOutcomes(t, report.Record, map[string]Outcome{\n92|\t\t\t\t\t\t\"resume-cell\":   OutcomePass,\n93|\t\t\t\t\t\t\"tuple-gate\":    OutcomePass,\n94|\t\t\t\t\t\t\"probe\":         OutcomePass,\n95|\t\t\t\t\t\t\"identify\":      OutcomePass,\n96|\t\t\t\t\t\t\"discover-bind\": OutcomePass,\n97|\t\t\t\t\t\t\"quiescence\":    OutcomeSkipped,\n98|\t\t\t\t\t\t\"resume-plan\":   OutcomeSkipped,\n99|\t\t\t\t\t})\n100|\t\t\t\t\tplan := findCheck(t, report.Record, \"resume-plan\")\n101|\t\t\t\t\tif !strings.Contains(plan.Detail, \"section 19.3\") {\n102|\t\t\t\t\t\tt.Fatalf(\"gated resume-plan detail = %q, want the section 19.3 citation\", plan.Detail)\n103|\t\t\t\t\t}\n104|\t\t\t\t\tassertCalls(t, runner, []string{\"probe\", \"identify-session\"})\n105|\t\t\t\tcase CellUnsupported:\n106|\t\t\t\t\tassertVerdict(t, report.Record, VerdictUnsupported)\n107|\t\t\t\t\tassertRefused(t, report.Record, runner)\n108|\t\t\t\tdefault:\n109|\t\t\t\t\tassertVerdict(t, report.Record, VerdictUnknown)\n110|\t\t\t\t\tassertRefused(t, report.Record, runner)\n111|\t\t\t\t}\n112|\t\t\t})\n113|\t\t}\n114|\t}\n115|}\n116|\n117|// needsWindowsHost reports whether the tuple's bind step proves a\n118|// filesystem store root on native Windows: only a Windows host\n119|// joins that root with native separators, while the proof rule is\n120|// platform-native. Backend-only Antigravity and zero-call refused\n121|// rows run anywhere.\n122|func needsWindowsHost(tuple provhost.BuildTuple) bool {\n123|\tif tuple.Platform != \"windows\" {\n124|\t\treturn false\n125|\t}\n126|\tswitch tuple.ProviderID {\n127|\tcase \"codex\", \"claude\", \"gemini\", \"pi\":\n128|\t\treturn true\n129|\tdefault:\n130|\t\treturn false\n131|\t}\n132|}\n133|\n134|// TestSmokeMuseOnePatchOffPinRefuses proves the Appendix B version\n135|// gate at the smoke boundary: one patch above the accepted Muse\n136|// probe is unknown and refuses with no adapter call.\n137|func TestSmokeMuseOnePatchOffPinRefuses(t *testing.T) {\n138|\ttuple := provhost.BuildTuple{ProviderID: \"muse\", ProviderVersion: offPinVersion(\"0.1.0\"), Platform: \"macos\", Architecture: \"arm64\"}\n139|\trunner := newScriptedRunner(t)\n140|\tparams := smokeParams(tuple, runner)\n141|\tparams.Discovery = json.RawMessage(`{}`)\n142|\treport, err := Run(context.Background(), params)\n143|\tif err != nil {\n144|\t\tt.Fatalf(\"Run error = %v\", err)\n145|\t}\n146|\tassertVerdict(t, report.Record, VerdictUnknown)\n147|\tassertRefused(t, report.Record, runner)\n148|}\n149|\n150|// TestSmokeAntigravityUnresolvedRealmFails proves the backend-realm\n151|// precondition: an Antigravity proof the backend did not resolve\n152|// fails the bind check, even on a conditional row.\n153|func TestSmokeAntigravityUnresolvedRealmFails(t *testing.T) {\n154|\ttuple := provhost.BuildTuple{ProviderID: \"antigravity\", ProviderVersion: \"1.1.14\", Platform: \"macos\", Architecture: \"arm64\"}\n155|\trunner := newScriptedRunner(t)\n156|\trunner.scriptProbe(tuple)\n157|\trunner.scriptIdentify(t, tuple, \"exact\")\n158|\tparams := smokeParams(tuple, runner)\n159|\tparams.Realm = smokeRealm\n160|\tparams.Discovery = json.RawMessage(fmt.Sprintf(`{\"native_session_id\": %q, \"discovered\": true, \"discovery_root\": null, \"backend_resolved\": false}`, smokeNativeID))\n161|\treport, err := Run(context.Background(), params)\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"Run error = %v\", err)\n164|\t}\n165|\tassertVerdict(t, report.Record, VerdictFail)\n166|\tassertOutcomes(t, report.Record, map[string]Outcome{\n167|\t\t\"resume-cell\":   OutcomePass,\n168|\t\t\"tuple-gate\":    OutcomePass,\n169|\t\t\"probe\":         OutcomePass,\n170|\t\t\"identify\":      OutcomePass,\n171|\t\t\"discover-bind\": OutcomeFail,\n172|\t})\n173|}\n174|\n175|// TestSmokeStrongConfidenceFails proves the smoke binds one precise\n176|// identity: identify confidence below exact fails the run.\n177|func TestSmokeStrongConfidenceFails(t *testing.T) {\n178|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n179|\trunner := newScriptedRunner(t)\n180|\trunner.scriptProbe(tuple)\n181|\trunner.scriptIdentify(t, tuple, \"strong\")\n182|\tparams := smokeParams(tuple, runner)\n183|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n184|\treport, err := Run(context.Background(), params)\n185|\tif err != nil {\n186|\t\tt.Fatalf(\"Run error = %v\", err)\n187|\t}\n188|\tassertVerdict(t, report.Record, VerdictFail)\n189|\tassertOutcomes(t, report.Record, map[string]Outcome{\n190|\t\t\"resume-cell\": OutcomePass,\n191|\t\t\"tuple-gate\":  OutcomePass,\n192|\t\t\"probe\":       OutcomePass,\n193|\t\t\"identify\":    OutcomeFail,\n194|\t})\n195|}\n196|\n197|// TestSmokeCrossTupleProofFails proves a discovery proof for another\n198|// native session refuses at the bind check, as does a proof whose\n199|// root escapes the declared store.\n200|func TestSmokeCrossTupleProofFails(t *testing.T) {\n201|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n202|\tproofs := map[string]json.RawMessage{\n203|\t\t\"foreign native id\": json.RawMessage(`{\"native_session_id\": \"another-session-id\", \"discovered\": true, \"discovery_root\": \"/smoke/home/.codex/sessions\", \"backend_resolved\": false}`),\n204|\t\t\"escaped root\":      json.RawMessage(fmt.Sprintf(`{\"native_session_id\": %q, \"discovered\": true, \"discovery_root\": \"/elsewhere/sessions\", \"backend_resolved\": false}`, smokeNativeID)),\n205|\t\t\"undiscovered\":      json.RawMessage(fmt.Sprintf(`{\"native_session_id\": %q, \"discovered\": false, \"discovery_root\": \"/smoke/home/.codex/sessions\", \"backend_resolved\": false}`, smokeNativeID)),\n206|\t}\n207|\tfor name, proof := range proofs {\n208|\t\tt.Run(name, func(t *testing.T) {\n209|\t\t\trunner := newScriptedRunner(t)\n210|\t\t\trunner.scriptProbe(tuple)\n211|\t\t\trunner.scriptIdentify(t, tuple, \"exact\")\n212|\t\t\tparams := smokeParams(tuple, runner)\n213|\t\t\tparams.Discovery = proof\n214|\t\t\treport, err := Run(context.Background(), params)\n215|\t\t\tif err != nil {\n216|\t\t\t\tt.Fatalf(\"Run error = %v\", err)\n217|\t\t\t}\n218|\t\t\tassertVerdict(t, report.Record, VerdictFail)\n219|\t\t\tif got := findCheck(t, report.Record, \"discover-bind\"); got.Outcome != OutcomeFail {\n220|\t\t\t\tt.Fatalf(\"discover-bind = %q, want fail\", got.Outcome)\n221|\t\t\t}\n222|\t\t})\n223|\t}\n224|}\n225|\n226|// TestSmokeProbeMismatchFails proves a probe that drifts from the\n227|// claimed tuple fails closed: the run fails at the probe check and\n228|// never identifies or resumes for the wrong build.\n229|func TestSmokeProbeMismatchFails(t *testing.T) {\n230|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n231|\tdrifted := tuple\n232|\tdrifted.ProviderVersion = \"0.148.0\"\n233|\trunner := newScriptedRunner(t)\n234|\trunner.scriptProbe(drifted)\n235|\tparams := smokeParams(tuple, runner)\n236|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n237|\treport, err := Run(context.Background(), params)\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"Run error = %v\", err)\n240|\t}\n241|\tassertVerdict(t, report.Record, VerdictFail)\n242|\tassertOutcomes(t, report.Record, map[string]Outcome{\n243|\t\t\"resume-cell\": OutcomePass,\n244|\t\t\"tuple-gate\":  OutcomePass,\n245|\t\t\"probe\":       OutcomeFail,\n246|\t})\n247|\tassertCalls(t, runner, []string{\"probe\"})\n248|}\n249|\n250|// TestSmokePiUnmappedVersionFails proves the Section 2.4 mapping\n251|// rule at the resume plan: Pi past the pinned probe has an\n252|// available cell but no profile mapping, so the plan fails.\n253|func TestSmokePiUnmappedVersionFails(t *testing.T) {\n254|\ttuple := provhost.BuildTuple{ProviderID: \"pi\", ProviderVersion: \"0.74.0\", Platform: \"macos\", Architecture: \"arm64\"}\n255|\trunner := newScriptedRunner(t)\n256|\trunner.scriptProbe(tuple)\n257|\trunner.scriptIdentify(t, tuple, \"exact\")\n258|\tparams := smokeParams(tuple, runner)\n259|\tparams.Profile = \"yolo\"\n260|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n261|\treport, err := Run(context.Background(), params)\n262|\tif err != nil {\n263|\t\tt.Fatalf(\"Run error = %v\", err)\n264|\t}\n265|\tassertVerdict(t, report.Record, VerdictFail)\n266|\tplan := findCheck(t, report.Record, \"resume-plan\")\n267|\tif plan.Outcome != OutcomeFail {\n268|\t\tt.Fatalf(\"resume-plan = %q, want fail\", plan.Outcome)\n269|\t}\n270|\tif !strings.Contains(plan.Detail, \"profile_mapping_unavailable\") {\n271|\t\tt.Fatalf(\"resume-plan detail = %q, want the mapping failure\", plan.Detail)\n272|\t}\n273|\tassertCalls(t, runner, []string{\"probe\", \"identify-session\"})\n274|}\n275|\n276|// TestSmokeUnsafeQuiescenceFails proves the quiescence precondition:\n277|// a valid but unsafe proof fails the run before any resume plan.\n278|func TestSmokeUnsafeQuiescenceFails(t *testing.T) {\n279|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n280|\trunner := newScriptedRunner(t)\n281|\trunner.scriptProbe(tuple)\n282|\trunner.scriptIdentify(t, tuple, \"exact\")\n283|\tparams := smokeParams(tuple, runner)\n284|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n285|\tparams.Quiescence = json.RawMessage(fmt.Sprintf(`{\n286|  \"provider_id\": %q, \"provider_version\": %q, \"input_blocked\": true,\n287|  \"boundary_ref\": \"smoke-boundary\", \"foreground_idle\": true, \"background_idle\": null,\n288|  \"open_child_count\": 1, \"open_database_handle_count\": 0, \"store_generation\": \"smoke-generation\",\n289|  \"safe\": false, \"blockers\": [\"child_process_open\"]\n290|}`, tuple.ProviderID, tuple.ProviderVersion))\n291|\treport, err := Run(context.Background(), params)\n292|\tif err != nil {\n293|\t\tt.Fatalf(\"Run error = %v\", err)\n294|\t}\n295|\tassertVerdict(t, report.Record, VerdictFail)\n296|\tif got := findCheck(t, report.Record, \"quiescence\"); got.Outcome != OutcomeFail {\n297|\t\tt.Fatalf(\"quiescence = %q, want fail\", got.Outcome)\n298|\t}\n299|}\n300|\n301|// TestSmokeSafeQuiescencePasses proves the quiescence precondition\n302|// input is consumed when present: a safe proof passes its check and\n303|// its digest enters the record.\n304|func TestSmokeSafeQuiescencePasses(t *testing.T) {\n305|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n306|\trunner := newScriptedRunner(t)\n307|\trunner.scriptProbe(tuple)\n308|\trunner.scriptIdentify(t, tuple, \"exact\")\n309|\trunner.scriptResume(t, tuple, \"standard\")\n310|\tparams := smokeParams(tuple, runner)\n311|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n312|\tparams.Quiescence = smokeQuiescence(t, tuple)\n313|\treport, err := Run(context.Background(), params)\n314|\tif err != nil {\n315|\t\tt.Fatalf(\"Run error = %v\", err)\n316|\t}\n317|\tassertVerdict(t, report.Record, VerdictPass)\n318|\tif got := findCheck(t, report.Record, \"quiescence\"); got.Outcome != OutcomePass {\n319|\t\tt.Fatalf(\"quiescence = %q, want pass\", got.Outcome)\n320|\t}\n321|\tif report.Record.QuiescenceDigest == \"\" {\n322|\t\tt.Fatal(\"pass record with quiescence input carries no quiescence digest\")\n323|\t}\n324|\tassertNoCanary(t, report.Bytes)\n325|}\n326|\n327|// TestSmokeParamsRefusals proves malformed run params are caller\n328|// errors with no report, never verdicts.\n329|func TestSmokeParamsRefusals(t *testing.T) {\n330|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n331|\tmutate := map[string]func(*Params){\n332|\t\t\"empty executable\":    func(params *Params) { params.Executable = \"\" },\n333|\t\t\"bad deadline\":        func(params *Params) { params.Deadline = \"yesterday\" },\n334|\t\t\"past deadline\":       func(params *Params) { params.Deadline = \"2020-01-01T00:00:00Z\" },\n335|\t\t\"bad probe id\":        func(params *Params) { params.ProbeID = \"not-a-uuid\" },\n336|\t\t\"bad session id\":      func(params *Params) { params.SessionID = \"not-a-uuid\" },\n337|\t\t\"bad profile\":         func(params *Params) { params.Profile = \"turbo\" },\n338|\t\t\"absent discovery\":    func(params *Params) { params.Discovery = nil },\n339|\t\t\"no workspaces\":       func(params *Params) { params.Workspaces = map[string]string{} },\n340|\t\t\"bad terminal\":        func(params *Params) { params.Terminal.Columns = 0 },\n341|\t\t\"zero lease epoch\":    func(params *Params) { params.Lease.Epoch = 0 },\n342|\t\t\"unsorted candidates\": func(params *Params) { params.Observation.CandidateNativeIDs = []string{\"b\", \"a\"} },\n343|\t}\n344|\tfor name, change := range mutate {\n345|\t\tt.Run(name, func(t *testing.T) {\n346|\t\t\trunner := newScriptedRunner(t)\n347|\t\t\tparams := smokeParams(tuple, runner)\n348|\t\t\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n349|\t\t\tchange(&params)\n350|\t\t\tif _, err := Run(context.Background(), params); err == nil {\n351|\t\t\t\tt.Fatalf(\"Run(%s) = nil, want a params error\", name)\n352|\t\t\t}\n353|\t\t\tif len(runner.calls) != 0 {\n354|\t\t\t\tt.Fatalf(\"Run(%s) made %d adapter calls, want none\", name, len(runner.calls))\n355|\t\t\t}\n356|\t\t})\n357|\t}\n358|}\n359|\n360|// TestSmokeRecordCarriesNoCapabilityClaim proves the record shape\n361|// carries evidence only: its closed member set has no capability,\n362|// availability, or doctor surface for a reader to mistake for a\n363|// capability advertisement.\n364|func TestSmokeRecordCarriesNoCapabilityClaim(t *testing.T) {\n365|\ttuple := provhost.BuildTuple{ProviderID: \"codex\", ProviderVersion: \"0.147.0\", Platform: \"macos\", Architecture: \"arm64\"}\n366|\trunner := newScriptedRunner(t)\n367|\trunner.scriptProbe(tuple)\n368|\trunner.scriptIdentify(t, tuple, \"exact\")\n369|\trunner.scriptResume(t, tuple, \"standard\")\n370|\tparams := smokeParams(tuple, runner)\n371|\tparams.Discovery = smokeDiscovery(t, tuple, params.Home, params.XDGDataHome)\n372|\treport, err := Run(context.Background(), params)\n373|\tif err != nil {\n374|\t\tt.Fatalf(\"Run error = %v\", err)\n375|\t}\n376|\tvar members map[string]json.RawMessage\n377|\tif err := json.Unmarshal(report.Bytes, &members); err != nil {\n378|\t\tt.Fatalf(\"unmarshal record: %v\", err)\n379|\t}\n380|\tif len(members) != len(recordMembers) {\n381|\t\tt.Fatalf(\"record carries %d members, want the closed %d\", len(members), len(recordMembers))\n382|\t}\n383|\tfor name := range members {\n384|\t\tif !recordMembers[name] {\n385|\t\t\tt.Fatalf(\"record carries outside member %q\", name)\n386|\t\t}\n387|\t\tif strings.Contains(name, \"capab\") || strings.Contains(name, \"doctor\") || strings.Contains(name, \"enabled\") {\n388|\t\t\tt.Fatalf(\"record member %q reads as a capability claim\", name)\n389|\t\t}\n390|\t}\n391|}\n392|\n393|func assertVerdict(t *testing.T, record Record, want Verdict) {\n394|\tt.Helper()\n395|\tif record.Verdict != want {\n396|\t\tt.Fatalf(\"verdict = %q, want %q (checks %v)\", record.Verdict, want, smokeOutcomeNames(record))\n397|\t}\n398|}\n399|\n400|func assertOutcomes(t *testing.T, record Record, want map[string]Outcome) {\n401|\tt.Helper()\n402|\tif len(record.Checks) != len(want) {\n403|\t\tt.Fatalf(\"checks = %v, want %d entries\", smokeOutcomeNames(record), len(want))\n404|\t}\n405|\tfor _, check := range record.Checks {\n406|\t\toutcome, ok := want[check.Name]\n407|\t\tif !ok {\n408|\t\t\tt.Fatalf(\"unexpected check %q in %v\", check.Name, smokeOutcomeNames(record))\n409|\t\t}\n410|\t\tif check.Outcome != outcome {\n411|\t\t\tt.Fatalf(\"check %q = %q, want %q\", check.Name, check.Outcome, outcome)\n412|\t\t}\n413|\t\tif check.Detail == \"\" {\n414|\t\t\tt.Fatalf(\"check %q carries an empty detail\", check.Name)\n415|\t\t}\n416|\t}\n417|}\n418|\n419|func assertCalls(t *testing.T, runner *scriptedRunner, want []string) {\n420|\tt.Helper()\n421|\tif fmt.Sprintf(\"%v\", runner.calls) != fmt.Sprintf(\"%v\", want) {\n422|\t\tt.Fatalf(\"adapter calls = %v, want %v\", runner.calls, want)\n423|\t}\n424|}\n425|\n426|// assertRefused requires the refused shape: the cell check alone,\n427|// no evidence digests, and no adapter call.\n428|func assertRefused(t *testing.T, record Record, runner *scriptedRunner) {\n429|\tt.Helper()\n430|\tassertOutcomes(t, record, map[string]Outcome{\"resume-cell\": OutcomePass})\n431|\tif record.ProbeDigest != \"\" || record.DiscoveryProofDigest != \"\" || record.IdentityRecordID != \"\" || record.SpawnPlanDigest != \"\" || record.StoreRoot != \"\" {\n432|\t\tt.Fatal(\"refused record carries evidence it never observed\")\n433|\t}\n434|\tassertCalls(t, runner, nil)\n435|}\n436|\n437|func findCheck(t *testing.T, record Record, name string) Check {\n438|\tt.Helper()\n439|\tfor _, check := range record.Checks {\n440|\t\tif check.Name == name {\n441|\t\t\treturn check\n442|\t\t}\n443|\t}\n444|\tt.Fatalf(\"record has no %q check in %v\", name, smokeOutcomeNames(record))\n445|\treturn Check{}\n446|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ef","stream":{"kind":"session","id":"01a0ae78-f771-79c0-aef9-997901ed5074"},"sequence":722,"recorded_at":1780531400001439,"record_type":"event","durability":"durable","causation_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5","run_stream":{"kind":"run","id":"d66f8436-fc6e-4b44-8a69-1ce280f51ff5"},"call_id":"call_01a0ae7a776d75c3b99c56d8bab4e981","text":"Read text file `internal/resumesmoke/support_test.go`.\n1|package resumesmoke\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// Fixed fixture facts. The clock never advances inside a run, so one\n16|// fixed instant keeps started_at and completed_at equal and every\n17|// replay byte-identical. IDs are distinct valid UUIDv7 values; the\n18|// lease ID is a valid UUIDv4.\n19|const (\n20|\tsmokeClock     = \"2026-09-17T00:00:00Z\"\n21|\tsmokeDeadline  = \"2026-09-18T00:00:00.000Z\"\n22|\tsmokeSessionID = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n23|\tsmokeWorkID    = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n24|\tsmokeHostID    = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n25|\tsmokeProbeID   = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n26|\tsmokeIdentID   = \"0198f4c8-9f60-7a77-9a81-1234567890ab\"\n27|\tsmokeResumeID  = \"0198f4c8-af70-7b88-ab92-1234567890ab\"\n28|\tsmokeLeaseID   = \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"\n29|\tsmokeCreatedAt = \"2026-09-17T00:00:00.000Z\"\n30|\tsmokeRealm     = \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"\n31|\tsmokeHome      = \"/smoke/home\"\n32|)\n33|\n34|// smokeNativeID is the fixture native session ID. It is a canary:\n35|// no smoke record may contain it, because records carry digests,\n36|// never raw native references.\n37|const smokeNativeID = \"smoke-native-canary-11111111-2222-4333-8444-555555555555\"\n38|\n39|// scriptedRunner is an in-process fake provider adapter: it speaks\n40|// the Section 7.2 frame protocol through the real provhost.Host,\n41|// answers each operation from its script, and records every call.\n42|// Unknown operations fail the test, because the smoke must dispatch\n43|// exactly the sequence it claims.\n44|type scriptedRunner struct {\n45|\tt        *testing.T\n46|\tscript   map[string]func(body json.RawMessage) json.RawMessage\n47|\tcalls    []string\n48|\tbodies   map[string]json.RawMessage\n49|\tidentity json.RawMessage\n50|}\n51|\n52|func newScriptedRunner(t *testing.T) *scriptedRunner {\n53|\tt.Helper()\n54|\treturn &scriptedRunner{t: t, script: map[string]func(body json.RawMessage) json.RawMessage{}, bodies: map[string]json.RawMessage{}}\n55|}\n56|\n57|func (runner *scriptedRunner) Run(_ context.Context, _ string, stdin []byte) (provhost.Result, error) {\n58|\tvar frame struct {\n59|\t\tProtocol        string          `json:\"protocol\"`\n60|\t\tProtocolVersion string          `json:\"protocol_version\"`\n61|\t\tRequestID       string          `json:\"request_id\"`\n62|\t\tOperation       string          `json:\"operation\"`\n63|\t\tBody            json.RawMessage `json:\"body\"`\n64|\t}\n65|\tif err := json.Unmarshal(stdin, &frame); err != nil {\n66|\t\trunner.t.Fatalf(\"fake adapter received a malformed frame: %v\", err)\n67|\t}\n68|\tif frame.Protocol != provhost.ProtocolID || frame.ProtocolVersion != provhost.ProtocolVersion {\n69|\t\trunner.t.Fatalf(\"fake adapter received %q %q, want the provider protocol\", frame.Protocol, frame.ProtocolVersion)\n70|\t}\n71|\tif frame.RequestID == \"\" {\n72|\t\trunner.t.Fatal(\"fake adapter received an empty request id\")\n73|\t}\n74|\tvar probe map[string]json.RawMessage\n75|\tif err := json.Unmarshal(frame.Body, &probe); err != nil {\n76|\t\trunner.t.Fatalf(\"fake adapter received a non-object body: %v\", err)\n77|\t}\n78|\thandler, ok := runner.script[frame.Operation]\n79|\tif !ok {\n80|\t\trunner.t.Fatalf(\"fake adapter received unexpected operation %q\", frame.Operation)\n81|\t}\n82|\trunner.calls = append(runner.calls, frame.Operation)\n83|\trunner.bodies[frame.Operation] = frame.Body\n84|\tresponse := map[string]any{\n85|\t\t\"protocol\":         provhost.ProtocolID,\n86|\t\t\"protocol_version\": provhost.ProtocolVersion,\n87|\t\t\"request_id\":       frame.RequestID,\n88|\t\t\"ok\":               true,\n89|\t\t\"body\":             handler(frame.Body),\n90|\t}\n91|\tstdout, err := json.Marshal(response)\n92|\tif err != nil {\n93|\t\trunner.t.Fatalf(\"fake adapter cannot frame its response: %v\", err)\n94|\t}\n95|\treturn provhost.Result{Stdout: append(stdout, '\\n'), ExitCode: 0}, nil\n96|}\n97|\n98|// scriptProbe answers the probe operation with a valid probe for\n99|// the tuple. The native_resume capability mirrors the row: on an\n100|// available row the fake claims available and enabled, elsewhere\n101|// conditional and disabled. The smoke never consults these claims —\n102|// the Section 8.4 matrix decides — but the fixture stays plausible.\n103|func (runner *scriptedRunner) scriptProbe(tuple provhost.BuildTuple) {\n104|\tcell, _ := ResumeCell(tuple.ProviderID, tuple.ProviderVersion, tuple.Platform, tuple.Architecture)\n105|\tstatus := \"conditional\"\n106|\tenabled := false\n107|\tevidence := \"acceptance_required\"\n108|\tif cell == CellAvailable {\n109|\t\tstatus = \"available\"\n110|\t\tenabled = true\n111|\t\tevidence = \"probed\"\n112|\t}\n113|\trunner.script[\"probe\"] = func(body json.RawMessage) json.RawMessage {\n114|\t\tvar probe struct {\n115|\t\t\tPlatform     string `json:\"platform\"`\n116|\t\t\tArchitecture string `json:\"architecture\"`\n117|\t\t}\n118|\t\tif err := json.Unmarshal(body, &probe); err != nil {\n119|\t\t\trunner.t.Fatalf(\"fake probe body malformed: %v\", err)\n120|\t\t}\n121|\t\tif probe.Platform != tuple.Platform || probe.Architecture != tuple.Architecture {\n122|\t\t\trunner.t.Fatalf(\"fake probe asked for %s/%s, want the claimed tuple\", probe.Platform, probe.Architecture)\n123|\t\t}\n124|\t\tcapability := func(status string, enabled bool, evidence, detail string) map[string]any {\n125|\t\t\treturn map[string]any{\"status\": status, \"enabled\": enabled, \"evidence\": evidence, \"detail\": detail}\n126|\t\t}\n127|\t\treturn json.RawMessage(fmt.Sprintf(`{\n128|  \"schema\": \"urn:ax:schema:provider-probe\",\n129|  \"schema_version\": \"1.0.0\",\n130|  \"provider_id\": %q,\n131|  \"provider_version\": %q,\n132|  \"platform\": %q,\n133|  \"architecture\": %q,\n134|  \"capabilities\": {\n135|    \"native_resume\": %s,\n136|    \"portable_store\": %s,\n137|    \"managed_pty\": %s,\n138|    \"appserver\": %s,\n139|    \"task_board_primary\": %s,\n140|    \"prompt_spawn\": %s,\n141|    \"native_goal_binding\": %s\n142|  },\n143|  \"warnings\": []\n144|}`,\n145|\t\t\ttuple.ProviderID, tuple.ProviderVersion, tuple.Platform, tuple.Architecture,\n146|\t\t\tmustJSON(capability(status, enabled, evidence, \"smoke fixture claim\")),\n147|\t\t\tmustJSON(capability(\"conditional\", false, \"acceptance_required\", \"smoke fixture claim\")),\n148|\t\t\tmustJSON(capability(\"conditional\", false, \"acceptance_required\", \"smoke fixture claim\")),\n149|\t\t\tmustJSON(capability(\"conditional\", false, \"acceptance_required\", \"smoke fixture claim\")),\n150|\t\t\tmustJSON(capability(\"conditional\", false, \"acceptance_required\", \"smoke fixture claim\")),\n151|\t\t\tmustJSON(capability(\"conditional\", false, \"acceptance_required\", \"smoke fixture claim\")),\n152|\t\t\tmustJSON(capability(\"conditional\", false, \"acceptance_required\", \"smoke fixture claim\")),\n153|\t\t))\n154|\t}\n155|}\n156|\n157|// scriptIdentify answers identify-session with a host-created\n158|// identity for the tuple at the given confidence. The identity\n159|// bytes are retained so the resume script can prove the smoke\n160|// threaded exactly them into the resume body.\n161|func (runner *scriptedRunner) scriptIdentify(t *testing.T, tuple provhost.BuildTuple, confidence string) {\n162|\tt.Helper()\n163|\tidentity := smokeIdentity(t, tuple)\n164|\trunner.identity = identity\n165|\trunner.script[\"identify-session\"] = func(body json.RawMessage) json.RawMessage {\n166|\t\tvar identify struct {\n167|\t\t\tSessionID  string `json:\"session_id\"`\n168|\t\t\tProviderID string `json:\"provider_id\"`\n169|\t\t}\n170|\t\tif err := json.Unmarshal(body, &identify); err != nil {\n171|\t\t\trunner.t.Fatalf(\"fake identify body malformed: %v\", err)\n172|\t\t}\n173|\t\tif identify.SessionID != smokeSessionID || identify.ProviderID != tuple.ProviderID {\n174|\t\t\trunner.t.Fatalf(\"fake identify asked for %s/%s, want the smoke session\", identify.ProviderID, identify.SessionID)\n175|\t\t}\n176|\t\treturn json.RawMessage(fmt.Sprintf(`{\"identity\": %s, \"confidence\": %q, \"matched_evidence\": [\"native_id\"]}`, identity, confidence))\n177|\t}\n178|}\n179|\n180|// scriptResume answers the resume operation with a valid spawn plan\n181|// and proves the smoke threaded the identified record into the\n182|// resume body byte for byte.\n183|func (runner *scriptedRunner) scriptResume(t *testing.T, tuple provhost.BuildTuple, profile string) {\n184|\tt.Helper()\n185|\trunner.script[\"resume\"] = func(body json.RawMessage) json.RawMessage {\n186|\t\tvar resume struct {\n187|\t\t\tIdentity  json.RawMessage   `json:\"identity\"`\n188|\t\t\tProfile   string            `json:\"execution_profile\"`\n189|\t\t\tWorkspace map[string]string `json:\"workspace_paths\"`\n190|\t\t}\n191|\t\tif err := json.Unmarshal(body, &resume); err != nil {\n192|\t\t\trunner.t.Fatalf(\"fake resume body malformed: %v\", err)\n193|\t\t}\n194|\t\tif string(canonicalJSON(t, resume.Identity)) != string(canonicalJSON(t, runner.identity)) {\n195|\t\t\trunner.t.Fatal(\"fake resume received an identity other than the identified record\")\n196|\t\t}\n197|\t\tif resume.Profile != profile {\n198|\t\t\trunner.t.Fatalf(\"fake resume received profile %q, want %q\", resume.Profile, profile)\n199|\t\t}\n200|\t\treturn smokeSpawnPlan(t, tuple, profile)\n201|\t}\n202|}\n203|\n204|// smokeIdentity creates the fixture Provider Identity Record for\n205|// one tuple through the production creation entry: a session UUID\n206|// for filesystem providers, a backend conversation UUID with the\n207|// smoke realm for Antigravity.\n208|func smokeIdentity(t *testing.T, tuple provhost.BuildTuple) []byte {\n209|\tt.Helper()\n210|\tparams := provhost.IdentityParams{\n211|\t\tSessionID:            smokeSessionID,\n212|\t\tProviderID:           tuple.ProviderID,\n213|\t\tProviderVersion:      tuple.ProviderVersion,\n214|\t\tProviderVersionRange: \">=0 <99\",\n215|\t\tNativeSessionID:      smokeNativeID,\n216|\t\tIdentityKind:         \"session_uuid\",\n217|\t\tLogicalWorkspaceID:   smokeWorkID,\n218|\t\tCreatedByHostID:      smokeHostID,\n219|\t\tCreatedAt:            smokeCreatedAt,\n220|\t}\n221|\tif tuple.ProviderID == \"antigravity\" {\n222|\t\tparams.IdentityKind = \"backend_conversation_uuid\"\n223|\t\tparams.BackendRealm = smokeRealm\n224|\t}\n225|\tidentity, err := provhost.CreateIdentity(params)\n226|\tif err != nil {\n227|\t\tt.Fatalf(\"CreateIdentity(%+v): %v\", tuple, err)\n228|\t}\n229|\treturn identity\n230|}\n231|\n232|// smokeDiscovery renders the observed discovery-proof input for one\n233|// tuple: discovered under the Section 8.2 store root the production\n234|// entry resolves, or backend-resolved with a null root for\n235|// Antigravity, which identifies through its realm.\n236|func smokeDiscovery(t *testing.T, tuple provhost.BuildTuple, home, xdg string) []byte {\n237|\tt.Helper()\n238|\troot, backendOnly, err := provhost.StoreRootFor(tuple.ProviderID, home, xdg)\n239|\tif err != nil {\n240|\t\tt.Fatalf(\"StoreRootFor(%q): %v\", tuple.ProviderID, err)\n241|\t}\n242|\tif backendOnly {\n243|\t\treturn json.RawMessage(fmt.Sprintf(`{\"native_session_id\": %q, \"discovered\": true, \"discovery_root\": null, \"backend_resolved\": true}`, smokeNativeID))\n244|\t}\n245|\treturn json.RawMessage(fmt.Sprintf(`{\"native_session_id\": %q, \"discovered\": true, \"discovery_root\": %q, \"backend_resolved\": false}`, smokeNativeID, root))\n246|}\n247|\n248|// smokeQuiescence renders a safe Section 7.6 proof input.\n249|func smokeQuiescence(t *testing.T, tuple provhost.BuildTuple) []byte {\n250|\tt.Helper()\n251|\treturn json.RawMessage(fmt.Sprintf(`{\n252|  \"provider_id\": %q,\n253|  \"provider_version\": %q,\n254|  \"input_blocked\": true,\n255|  \"boundary_ref\": \"smoke-boundary\",\n256|  \"foreground_idle\": true,\n257|  \"background_idle\": true,\n258|  \"open_child_count\": 0,\n259|  \"open_database_handle_count\": 0,\n260|  \"store_generation\": \"smoke-generation\",\n261|  \"safe\": true,\n262|  \"blockers\": []\n263|}`, tuple.ProviderID, tuple.ProviderVersion))\n264|}\n265|\n266|// smokeSpawnPlan renders a valid resume SpawnPlan for one tuple and\n267|// profile. The argv names the native session, which is exactly why\n268|// the record may carry only the plan digest: the canary must never\n269|// appear in record bytes. The profile_mapping comes from the\n270|// production table, never retyped.\n271|func smokeSpawnPlan(t *testing.T, tuple provhost.BuildTuple, profile string) json.RawMessage {\n272|\tt.Helper()\n273|\tmapping, err := provhost.ProfileMapping(tuple.ProviderID, profile)\n274|\tif err != nil {\n275|\t\tt.Fatalf(\"ProfileMapping(%q, %q): %v\", tuple.ProviderID, profile, err)\n276|\t}\n277|\tcwd := \"/smoke/work\"\n278|\tif tuple.Platform == \"windows\" {\n279|\t\tcwd = `C:\\smoke\\work`\n280|\t}\n281|\targv := []string{tuple.ProviderID, \"resume\", smokeNativeID}\n282|\tif mapping != \"\" {\n283|\t\targv = append([]string{argv[0], mapping}, argv[1:]...)\n284|\t}\n285|\tplan := map[string]any{\n286|\t\t\"argv\":              argv,\n287|\t\t\"cwd\":               cwd,\n288|\t\t\"env_names\":         []string{},\n289|\t\t\"env_literals\":      map[string]string{},\n290|\t\t\"native_session_id\": smokeNativeID,\n291|\t\t\"profile_mapping\":   mapping,\n292|\t\t\"extensions\":        map[string]any{},\n293|\t}\n294|\treturn mustJSONRaw(plan)\n295|}\n296|\n297|// smokeParams builds valid smoke params for one tuple against the\n298|// scripted runner: standard profile, POSIX fixtures, the smoke\n299|// discovery input, and no quiescence input. Callers mutate the\n300|// result for their negative.\n301|func smokeParams(tuple provhost.BuildTuple, runner *scriptedRunner) Params {\n302|\tclock, err := time.Parse(time.RFC3339, smokeClock)\n303|\tif err != nil {\n304|\t\tpanic(err)\n305|\t}\n306|\tworkspace := \"/smoke/work\"\n307|\texecutable := \"/smoke/bin/\" + tuple.ProviderID\n308|\tif tuple.Platform == \"windows\" {\n309|\t\tworkspace = `C:\\smoke\\work`\n310|\t\texecutable = `C:\\smoke\\bin\\` + tuple.ProviderID + \".exe\"\n311|\t}\n312|\tworkspaces := map[string]string{smokeWorkID: workspace}\n313|\treturn Params{\n314|\t\tTuple:      tuple,\n315|\t\tHost:       provhost.Host{Runner: runner, Now: func() time.Time { return clock }},\n316|\t\tExecutable: executable,\n317|\t\tDeadline:   smokeDeadline,\n318|\t\tProbeID:    smokeProbeID,\n319|\t\tIdentifyID: smokeIdentID,\n320|\t\tResumeID:   smokeResumeID,\n321|\t\tSessionID:  smokeSessionID,\n322|\t\tWorkspaces: workspaces,\n323|\t\tProfile:    \"standard\",\n324|\t\tTerminal: Terminal{\n325|\t\t\tBackend:     \"tmux\",\n326|\t\t\tTerminalID:  \"smoke-terminal\",\n327|\t\t\tInteractive: true,\n328|\t\t\tColumns:     120,\n329|\t\t\tRows:        40,\n330|\t\t},\n331|\t\tLease: Lease{\n332|\t\t\tSessionID: smokeSessionID,\n333|\t\t\tEpoch:     1,\n334|\t\t\tLeaseID:   smokeLeaseID,\n335|\t\t},\n336|\t\tObservation: Observation{\n337|\t\t\tTerminalID:          \"smoke-terminal\",\n338|\t\t\tExecutablePath:      executable,\n339|\t\t\tStartedAt:           smokeCreatedAt,\n340|\t\t\tCandidateStorePaths: []string{},\n341|\t\t\tCandidateNativeIDs:  []string{},\n342|\t\t},\n343|\t\tHome:      smokeHome,\n344|\t\tDiscovery: nil,\n345|\t\tClock:     func() time.Time { return clock },\n346|\t}\n347|}\n348|\n349|// smokeOutcomeNames returns the check name/outcome pairs of a report\n350|// in execution order.\n351|func smokeOutcomeNames(record Record) []string {\n352|\tvar names []string\n353|\tfor _, check := range record.Checks {\n354|\t\tnames = append(names, check.Name+\"=\"+string(check.Outcome))\n355|\t}\n356|\treturn names\n357|}\n358|\n359|func mustJSON(value any) string {\n360|\treturn string(mustJSONRaw(value))\n361|}\n362|\n363|func mustJSONRaw(value any) json.RawMessage {\n364|\trendered, err := json.Marshal(value)\n365|\tif err != nil {\n366|\t\tpanic(err)\n367|\t}\n368|\treturn rendered\n369|}\n370|\n371|// canonicalJSON remarshals JSON through sorted maps so semantically\n372|// equal documents compare equal as bytes.\n373|func canonicalJSON(t *testing.T, raw json.RawMessage) json.RawMessage {\n374|\tt.Helper()\n375|\tvar decoded any\n376|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n377|\t\tt.Fatalf(\"canonicalize JSON: %v\", err)\n378|\t}\n379|\treturn mustJSONRaw(sortJSON(decoded))\n380|}\n381|\n382|func sortJSON(value any) any {\n383|\tswitch typed := value.(type) {\n384|\tcase map[string]any:\n385|\t\tkeys := make([]string, 0, len(typed))\n386|\t\tfor key := range typed {\n387|\t\t\tkeys = append(keys, key)\n388|\t\t}\n389|\t\tsort.Strings(keys)\n390|\t\tordered := make(map[string]any, len(typed))\n391|\t\tfor _, key := range keys {\n392|\t\t\tordered[key] = sortJSON(typed[key])\n393|\t\t}\n394|\t\treturn ordered\n395|\tcase []any:\n396|\t\tfor index := range typed {\n397|\t\t\ttyped[index] = sortJSON(typed[index])\n398|\t\t}\n399|\t\treturn typed\n400|\tdefault:\n401|\t\treturn value\n402|\t}\n403|}\n404|\n405|// assertNoCanary fails when the record bytes leak the fixture\n406|// native ID or any other raw native reference the canary stands\n407|// for. Records carry digests, never the references themselves.\n408|func assertNoCanary(t *testing.T, record []byte) {\n409|\tt.Helper()\n410|\tif strings.Contains(string(record), smokeNativeID) {\n411|\t\tt.Fatal(\"smoke record leaks the raw native session id\")\n412|\t}\n413|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
