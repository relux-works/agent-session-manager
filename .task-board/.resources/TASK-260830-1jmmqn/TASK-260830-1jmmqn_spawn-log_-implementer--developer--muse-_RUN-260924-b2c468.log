\n28|\tprojectionPlanSelf    = \"projection_plan_id\"\n29|)\n30|\n31|var projectionPlanMembers = map[string]bool{\n32|\t\"schema\": true, \"schema_version\": true, \"projection_plan_id\": true,\n33|\t\"operation_id\": true, \"bundle_id\": true,\n34|\t\"request_digest\": true, \"source_snapshot_digest\": true,\n35|\t\"capture_manifest_id\": true, \"canonical_session_id\": true,\n36|\t\"canonical_event_ids\": true,\n37|\t\"source_environment\":  true, \"target_environment\": true,\n38|\t\"expected_target_native_session_id\": true, \"target_workspace\": true,\n39|\t\"strategy\": true, \"strategy_rationale\": true, \"fidelity_profile\": true,\n40|\t\"required_dispositions\": true, \"forbid_reasons\": true,\n41|\t\"item_mappings\": true, \"target_operations\": true,\n42|\t\"expected_resources\": true, \"synthesized_events\": true,\n43|\t\"security_exclusions\": true, \"resource_limits\": true,\n44|\t\"transaction_plan\": true, \"read_back_plan\": true,\n45|\t\"resume_plan\": true, \"rollback_plan\": true,\n46|\t\"required_contracts\": true, \"required_capabilities\": true,\n47|\t\"fidelity_basis_digest\":       true,\n48|\t\"source_adapter_build_digest\": true, \"target_adapter_build_digest\": true,\n49|\t\"controller_build_digest\": true, \"extensions\": true,\n50|}\n51|\n52|var projectionPlanRequired = []string{\n53|\t\"schema\", \"schema_version\", \"projection_plan_id\",\n54|\t\"operation_id\", \"bundle_id\",\n55|\t\"request_digest\", \"source_snapshot_digest\",\n56|\t\"capture_manifest_id\", \"canonical_session_id\",\n57|\t\"canonical_event_ids\",\n58|\t\"source_environment\", \"target_environment\",\n59|\t\"expected_target_native_session_id\", \"target_workspace\",\n60|\t\"strategy\", \"strategy_rationale\", \"fidelity_profile\",\n61|\t\"required_dispositions\", \"forbid_reasons\",\n62|\t\"item_mappings\", \"target_operations\",\n63|\t\"expected_resources\", \"synthesized_events\",\n64|\t\"security_exclusions\", \"resource_limits\",\n65|\t\"transaction_plan\", \"read_back_plan\",\n66|\t\"resume_plan\", \"rollback_plan\",\n67|\t\"required_contracts\", \"required_capabilities\",\n68|\t\"fidelity_basis_digest\",\n69|\t\"source_adapter_build_digest\", \"target_adapter_build_digest\",\n70|\t\"controller_build_digest\", \"extensions\",\n71|}\n72|\n73|// ProjectionPlan is one validated projection plan.\n74|type ProjectionPlan struct {\n75|\tPlanID                      scalar.Digest\n76|\tOperationID                 scalar.UUIDv7\n77|\tBundleID                    scalar.UUIDv7\n78|\tRequestDigest               scalar.Digest\n79|\tSourceSnapshotDigest        scalar.Digest\n80|\tCaptureManifestID           scalar.Digest\n81|\tCanonicalSessionID          scalar.Digest\n82|\tCanonicalEventIDs           []scalar.Digest\n83|\tSourceEnvironment           sessadapter.Tuple\n84|\tTargetEnvironment           sessadapter.Tuple\n85|\tExpectedTargetNativeSession string\n86|\tTargetWorkspace             clonebundle.WorkspaceBinding\n87|\tStrategy                    string\n88|\tStrategyRationale           string\n89|\tFidelityProfile             string\n90|\tRequiredDispositions        map[string][]string\n91|\tForbidReasons               []string\n92|\tItemMappings                []ItemMapping\n93|\tTargetOperations            []TargetOperation\n94|\tExpectedResources           []ExpectedResource\n95|\tSynthesizedEvents           []SynthesizedEvent\n96|\tSecurityExclusions          []string\n97|\tResourceLimits              sessadapter.ResourceLimits\n98|\tTransactionPlan             TransactionPlan\n99|\tReadBackPlan                ReadBackPlan\n100|\tResumePlan                  ResumePlan\n101|\tRollbackPlan                RollbackPlan\n102|\tRequiredContracts           []ContractRequirement\n103|\tRequiredCapabilities        []string\n104|\tFidelityBasisDigest         scalar.Digest\n105|\tSourceAdapterBuildDigest    scalar.Digest\n106|\tTargetAdapterBuildDigest    scalar.Digest\n107|\tControllerBuildDigest       scalar.Digest\n108|}\n109|\n110|// ProjectionPlanInput is the caller-supplied projection plan\n111|// candidate for Build. Tuples, workspace, and resource limits arrive\n112|// as raw JSON and validate through their landed owners; the sealed\n113|// plan carries them back in canonical form.\n114|type ProjectionPlanInput struct {\n115|\tOperationID                 string\n116|\tBundleID                    string\n117|\tRequestDigest               string\n118|\tSourceSnapshotDigest        string\n119|\tCaptureManifestID           string\n120|\tCanonicalSessionID          string\n121|\tCanonicalEventIDs           []string\n122|\tSourceEnvironment           []byte\n123|\tTargetEnvironment           []byte\n124|\tExpectedTargetNativeSession string\n125|\tTargetWorkspace             []byte\n126|\tStrategy                    string\n127|\tStrategyRationale           string\n128|\tFidelityProfile             string\n129|\tRequiredDispositions        map[string][]string\n130|\tForbidReasons               []string\n131|\tItemMappings                []ItemMappingInput\n132|\tTargetOperations            []TargetOperationInput\n133|\tExpectedResources           []ExpectedResourceInput\n134|\tSynthesizedEvents           []SynthesizedEventInput\n135|\tSecurityExclusions          []string\n136|\tResourceLimits              []byte\n137|\tTransactionPlan             TransactionPlanInput\n138|\tReadBackPlan                ReadBackPlanInput\n139|\tResumePlan                  ResumePlanInput\n140|\tRollbackPlan                RollbackPlanInput\n141|\tRequiredContracts           []ContractRequirementInput\n142|\tRequiredCapabilities        []string\n143|\tFidelityBasisDigest         string\n144|\tSourceAdapterBuildDigest    string\n145|\tTargetAdapterBuildDigest    string\n146|\tControllerBuildDigest       string\n147|\tExtensions                  map[string]any\n148|}\n149|\n150|// BuildProjectionPlan constructs one closed Projection Plan 1.0.0\n(more lines below)","final_result":true}}}
