{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a7","stream":{"kind":"session","id":"01a0d1b0-8de1-7d92-b557-e0145e16dab5"},"sequence":302,"recorded_at":1780531400000599,"record_type":"event","durability":"durable","causation_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","run_stream":{"kind":"run","id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8"},"task_stream":{"kind":"task","id":"01a0d1b1-47d4-7101-a821-ef26b9adc4fd"},"task_id":"01a0d1b1-47d4-7101-a821-ef26b9adc4fd","event":{"kind":"output","task_id":"01a0d1b1-47d4-7101-a821-ef26b9adc4fd","chunk":"Read text file `internal/cloneplan/plans.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n9|)\n10|\n11|// This file validates and constructs the four closed plan\n12|// components Section 13.14.2 states (TransactionPlan, ReadBackPlan,\n13|// ResumeProjectionPlan, RollbackPlan) and ContractRequirement. Every\n14|// constant is a refusal: any value but the pinned one refuses, on\n15|// both entries, including non-string and non-boolean JSON types on\n16|// decode. ContractRequirement carries exactly contract_id and\n17|// version — the pinned text states no extensions member for it, so\n18|// an extensions member there is unknown.\n19|\n20|var transactionPlanMembers = map[string]bool{\n21|\t\"materialization_intent\":  true,\n22|\t\"target_collision_policy\": true,\n23|\t\"activation\":              true,\n24|\t\"extensions\":              true,\n25|}\n26|\n27|var transactionPlanRequired = []string{\n28|\t\"materialization_intent\",\n29|\t\"target_collision_policy\",\n30|\t\"activation\",\n31|\t\"extensions\",\n32|}\n33|\n34|var readBackPlanMembers = map[string]bool{\n35|\t\"modes\":                   true,\n36|\t\"require_identity_match\":  true,\n37|\t\"require_workspace_match\": true,\n38|\t\"require_semantic_marker\": true,\n39|\t\"extensions\":              true,\n40|}\n41|\n42|var readBackPlanRequired = []string{\n43|\t\"modes\",\n44|\t\"require_identity_match\",\n45|\t\"require_workspace_match\",\n46|\t\"require_semantic_marker\",\n47|\t\"extensions\",\n48|}\n49|\n50|var resumePlanMembers = map[string]bool{\n51|\t\"opens_existing_identity\":            true,\n52|\t\"allow_blank_fallback\":               true,\n53|\t\"bounded_continuation_turn_required\": true,\n54|\t\"extensions\":                         true,\n55|}\n56|\n57|var resumePlanRequired = []string{\n58|\t\"opens_existing_identity\",\n59|\t\"allow_blank_fallback\",\n60|\t\"bounded_continuation_turn_required\",\n61|\t\"extensions\",\n62|}\n63|\n64|var rollbackPlanMembers = map[string]bool{\n65|\t\"required\":                        true,\n66|\t\"retain_through\":                  true,\n67|\t\"forbidden_after_provider_commit\": true,\n68|\t\"extensions\":                      true,\n69|}\n70|\n71|var rollbackPlanRequired = []string{\n72|\t\"required\",\n73|\t\"retain_through\",\n74|\t\"forbidden_after_provider_commit\",\n75|\t\"extensions\",\n76|}\n77|\n78|var contractRequirementMembers = map[string]bool{\n79|\t\"contract_id\": true,\n80|\t\"version\":     true,\n81|}\n82|\n83|var contractRequirementRequired = []string{\n84|\t\"contract_id\",\n85|\t\"version\",\n86|}\n87|\n88|// TransactionPlan is one validated closed transaction plan.\n89|type TransactionPlan struct{}\n90|\n91|// TransactionPlanInput is the caller-supplied transaction plan\n92|// candidate for Build.\n93|type TransactionPlanInput struct {\n94|\tMaterializationIntent string\n95|\tTargetCollisionPolicy string\n96|\tActivation            string\n97|\tExtensions            map[string]any\n98|}\n99|\n100|// ReadBackPlan is one validated closed read-back plan.\n101|type ReadBackPlan struct{}\n102|\n103|// ReadBackPlanInput is the caller-supplied read-back plan candidate\n104|// for Build.\n105|type ReadBackPlanInput struct {\n106|\tModes                 []string\n107|\tRequireIdentityMatch  bool\n108|\tRequireWorkspaceMatch bool\n109|\tRequireSemanticMarker bool\n110|\tExtensions            map[string]any\n111|}\n112|\n113|// ResumePlan is one validated closed resume projection plan.\n114|type ResumePlan struct {\n115|\tBoundedContinuationTurnRequired bool\n116|}\n117|\n118|// ResumePlanInput is the caller-supplied resume plan candidate for\n119|// Build.\n120|type ResumePlanInput struct {\n121|\tOpensExistingIdentity           bool\n122|\tAllowBlankFallback              bool\n123|\tBoundedContinuationTurnRequired bool\n124|\tExtensions                      map[string]any\n125|}\n126|\n127|// RollbackPlan is one validated closed rollback plan.\n128|type RollbackPlan struct{}\n129|\n130|// RollbackPlanInput is the caller-supplied rollback plan candidate\n131|// for Build.\n132|type RollbackPlanInput struct {\n133|\tRequired                     bool\n134|\tRetainThrough                string\n135|\tForbiddenAfterProviderCommit bool\n136|\tExtensions                   map[string]any\n137|}\n138|\n139|// ContractRequirement is one validated contract requirement.\n140|type ContractRequirement struct {\n141|\tContractID string\n142|\tVersion    string\n143|}\n144|\n145|// ContractRequirementInput is the caller-supplied contract\n146|// requirement candidate for Build.\n147|type ContractRequirementInput struct {\n148|\tContractID string\n149|\tVersion    string\n150|}\n151|\n152|// buildTransactionPlan validates one caller-supplied transaction\n153|// plan and renders its closed object: materialization_intent=clone,\n154|// target_collision_policy=must_be_absent,\n155|// activation=dormant_validated.\n156|func buildTransactionPlan(input TransactionPlanInput) (TransactionPlan, map[string]any, error) {\n157|\towner := \"transaction plan\"\n158|\tif !validText(input.MaterializationIntent) {\n159|\t\treturn TransactionPlan{}, nil, invalid(\"%s materialization_intent is not valid UTF-8\", owner)\n160|\t}\n161|\tif input.MaterializationIntent != \"clone\" {\n162|\t\treturn TransactionPlan{}, nil, invalid(\"%s materialization_intent is not clone\", owner)\n163|\t}\n164|\tif !validText(input.TargetCollisionPolicy) {\n165|\t\treturn TransactionPlan{}, nil, invalid(\"%s target_collision_policy is not valid UTF-8\", owner)\n166|\t}\n167|\tif input.TargetCollisionPolicy != \"must_be_absent\" {\n168|\t\treturn TransactionPlan{}, nil, invalid(\"%s target_collision_policy is not must_be_absent\", owner)\n169|\t}\n170|\tif !validText(input.Activation) {\n171|\t\treturn TransactionPlan{}, nil, invalid(\"%s activation is not valid UTF-8\", owner)\n172|\t}\n173|\tif input.Activation != \"dormant_validated\" {\n174|\t\treturn TransactionPlan{}, nil, invalid(\"%s activation is not dormant_validated\", owner)\n175|\t}\n176|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n177|\t\treturn TransactionPlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n178|\t}\n179|\textensions := input.Extensions\n180|\tif extensions == nil {\n181|\t\textensions = map[string]any{}\n182|\t}\n183|\treturn TransactionPlan{}, map[string]any{\n184|\t\t\"materialization_intent\":  \"clone\",\n185|\t\t\"target_collision_policy\": \"must_be_absent\",\n186|\t\t\"activation\":              \"dormant_validated\",\n187|\t\t\"extensions\":              extensions,\n188|\t}, nil\n189|}\n190|\n191|// decodeTransactionPlan validates one closed TransactionPlan.\n192|func decodeTransactionPlan(raw json.RawMessage) (TransactionPlan, error) {\n193|\towner := \"transaction plan\"\n194|\tmembers, fault := decodeStrictObject(raw)\n195|\tif fault != nil {\n196|\t\treturn TransactionPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n197|\t}\n198|\tif name, unknown := unknownMember(members, transactionPlanMembers); unknown {\n199|\t\treturn TransactionPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n200|\t}\n201|\tif name, missing := missingMember(members, transactionPlanRequired); missing {\n202|\t\treturn TransactionPlan{}, invalid(\"%s misses a required member %q\", owner, name)\n203|\t}\n204|\tintent, ok := rawString(members[\"materialization_intent\"])\n205|\tif !ok || intent != \"clone\" {\n206|\t\treturn TransactionPlan{}, invalid(\"%s materialization_intent is not clone\", owner)\n207|\t}\n208|\tpolicy, ok := rawString(members[\"target_collision_policy\"])\n209|\tif !ok || policy != \"must_be_absent\" {\n210|\t\treturn TransactionPlan{}, invalid(\"%s target_collision_policy is not must_be_absent\", owner)\n211|\t}\n212|\tactivation, ok := rawString(members[\"activation\"])\n213|\tif !ok || activation != \"dormant_validated\" {\n214|\t\treturn TransactionPlan{}, invalid(\"%s activation is not dormant_validated\", owner)\n215|\t}\n216|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n217|\t\treturn TransactionPlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n218|\t}\n219|\treturn TransactionPlan{}, nil\n220|}\n221|\n222|// checkReadBackModes validates the closed modes constant\n223|// [staged,live]: exactly two elements in exactly that order.\n224|func checkReadBackModes(modes []string) error {\n225|\tif len(modes) != 2 || modes[0] != \"staged\" || modes[1] != \"live\" {\n226|\t\treturn invalid(\"read-back plan modes are not [staged,live]\")\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// buildReadBackPlan validates one caller-supplied read-back plan\n232|// and renders its closed object: modes=[staged,live] with all three\n233|// require flags true.\n234|func buildReadBackPlan(input ReadBackPlanInput) (ReadBackPlan, map[string]any, error) {\n235|\towner := \"read-back plan\"\n236|\tfor _, mode := range input.Modes {\n237|\t\tif !validText(mode) {\n238|\t\t\treturn ReadBackPlan{}, nil, invalid(\"%s modes carry a member that is not valid UTF-8\", owner)\n239|\t\t}\n240|\t}\n241|\tif err := checkReadBackModes(input.Modes); err != nil {\n242|\t\treturn ReadBackPlan{}, nil, err\n243|\t}\n244|\tif !input.RequireIdentityMatch {\n245|\t\treturn ReadBackPlan{}, nil, invalid(\"%s require_identity_match is not true\", owner)\n246|\t}\n247|\tif !input.RequireWorkspaceMatch {\n248|\t\treturn ReadBackPlan{}, nil, invalid(\"%s require_workspace_match is not true\", owner)\n249|\t}\n250|\tif !input.RequireSemanticMarker {\n251|\t\treturn ReadBackPlan{}, nil, invalid(\"%s require_semantic_marker is not true\", owner)\n252|\t}\n253|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n254|\t\treturn ReadBackPlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n255|\t}\n256|\textensions := input.Extensions\n257|\tif extensions == nil {\n258|\t\textensions = map[string]any{}\n259|\t}\n260|\treturn ReadBackPlan{}, map[string]any{\n261|\t\t\"modes\":                   []any{\"staged\", \"live\"},\n262|\t\t\"require_identity_match\":  true,\n263|\t\t\"require_workspace_match\": true,\n264|\t\t\"require_semantic_marker\": true,\n265|\t\t\"extensions\":              extensions,\n266|\t}, nil\n267|}\n268|\n269|// decodeReadBackPlan validates one closed ReadBackPlan.\n270|func decodeReadBackPlan(raw json.RawMessage) (ReadBackPlan, error) {\n271|\towner := \"read-back plan\"\n272|\tmembers, fault := decodeStrictObject(raw)\n273|\tif fault != nil {\n274|\t\treturn ReadBackPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n275|\t}\n276|\tif name, unknown := unknownMember(members, readBackPlanMembers); unknown {\n277|\t\treturn ReadBackPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n278|\t}\n279|\tif name, missing := missingMember(members, readBackPlanRequired); missing {\n280|\t\treturn ReadBackPlan{}, invalid(\"%s misses a required member %q\", owner, name)\n281|\t}\n282|\telements, ok := decodeArray(members[\"modes\"])\n283|\tif !ok {\n284|\t\treturn ReadBackPlan{}, invalid(\"%s modes are not [staged,live]\", owner)\n285|\t}\n286|\tmodes := make([]string, 0, len(elements))\n287|\tfor _, element := range elements {\n288|\t\tmode, ok := rawString(element)\n289|\t\tif !ok {\n290|\t\t\treturn ReadBackPlan{}, invalid(\"%s modes are not [staged,live]\", owner)\n291|\t\t}\n292|\t\tmodes = append(modes, mode)\n293|\t}\n294|\tif err := checkReadBackModes(modes); err != nil {\n295|\t\treturn ReadBackPlan{}, err\n296|\t}\n297|\tidentity, ok := rawBool(members[\"require_identity_match\"])\n298|\tif !ok || !identity {\n299|\t\treturn ReadBackPlan{}, invalid(\"%s require_identity_match is not true\", owner)\n300|\t}\n301|\tworkspace, ok := rawBool(members[\"require_workspace_match\"])\n302|\tif !ok || !workspace {\n303|\t\treturn ReadBackPlan{}, invalid(\"%s require_workspace_match is not true\", owner)\n304|\t}\n305|\tsemantic, ok := rawBool(members[\"require_semantic_marker\"])\n306|\tif !ok || !semantic {\n307|\t\treturn ReadBackPlan{}, invalid(\"%s require_semantic_marker is not true\", owner)\n308|\t}\n309|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n310|\t\treturn ReadBackPlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n311|\t}\n312|\treturn ReadBackPlan{}, nil\n313|}\n314|\n315|// buildResumePlan validates one caller-supplied resume plan and\n316|// renders its closed object: opens_existing_identity=true,\n317|// allow_blank_fallback=false, and a boolean\n318|// bounded_continuation_turn_required.\n319|func buildResumePlan(input ResumePlanInput) (ResumePlan, map[string]any, error) {\n320|\towner := \"resume projection plan\"\n321|\tif !input.OpensExistingIdentity {\n322|\t\treturn ResumePlan{}, nil, invalid(\"%s opens_existing_identity is not true\", owner)\n323|\t}\n324|\tif input.AllowBlankFallback {\n325|\t\treturn ResumePlan{}, nil, invalid(\"%s allow_blank_fallback is not false\", owner)\n326|\t}\n327|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n328|\t\treturn ResumePlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n329|\t}\n330|\textensions := input.Extensions\n331|\tif extensions == nil {\n332|\t\textensions = map[string]any{}\n333|\t}\n334|\treturn ResumePlan{BoundedContinuationTurnRequired: input.BoundedContinuationTurnRequired}, map[string]any{\n335|\t\t\"opens_existing_identity\":            true,\n336|\t\t\"allow_blank_fallback\":               false,\n337|\t\t\"bounded_continuation_turn_required\": input.BoundedContinuationTurnRequired,\n338|\t\t\"extensions\":                         extensions,\n339|\t}, nil\n340|}\n341|\n342|// decodeResumePlan validates one closed ResumeProjectionPlan.\n343|func decodeResumePlan(raw json.RawMessage) (ResumePlan, error) {\n344|\towner := \"resume projection plan\"\n345|\tmembers, fault := decodeStrictObject(raw)\n346|\tif fault != nil {\n347|\t\treturn ResumePlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n348|\t}\n349|\tif name, unknown := unknownMember(members, resumePlanMembers); unknown {\n350|\t\treturn ResumePlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n351|\t}\n352|\tif name, missing := missingMember(members, resumePlanRequired); missing {\n353|\t\treturn ResumePlan{}, invalid(\"%s misses a required member %q\", owner, name)\n354|\t}\n355|\topens, ok := rawBool(members[\"opens_existing_identity\"])\n356|\tif !ok || !opens {\n357|\t\treturn ResumePlan{}, invalid(\"%s opens_existing_identity is not true\", owner)\n358|\t}\n359|\tblank, ok := rawBool(members[\"allow_blank_fallback\"])\n360|\tif !ok || blank {\n361|\t\treturn ResumePlan{}, invalid(\"%s allow_blank_fallback is not false\", owner)\n362|\t}\n363|\tbounded, ok := rawBool(members[\"bounded_continuation_turn_required\"])\n364|\tif !ok {\n365|\t\treturn ResumePlan{}, invalid(\"%s bounded_continuation_turn_required is not a boolean\", owner)\n366|\t}\n367|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n368|\t\treturn ResumePlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n369|\t}\n370|\treturn ResumePlan{BoundedContinuationTurnRequired: bounded}, nil\n371|}\n372|\n373|// buildRollbackPlan validates one caller-supplied rollback plan and\n374|// renders its closed object: required=true,\n375|// retain_through=live_validated,\n376|// forbidden_after_provider_commit=true.\n377|func buildRollbackPlan(input RollbackPlanInput) (RollbackPlan, map[string]any, error) {\n378|\towner := \"rollback plan\"\n379|\tif !input.Required {\n380|\t\treturn RollbackPlan{}, nil, invalid(\"%s required is not true\", owner)\n381|\t}\n382|\tif !validText(input.RetainThrough) {\n383|\t\treturn RollbackPlan{}, nil, invalid(\"%s retain_through is not valid UTF-8\", owner)\n384|\t}\n385|\tif input.RetainThrough != \"live_validated\" {\n386|\t\treturn RollbackPlan{}, nil, invalid(\"%s retain_through is not live_validated\", owner)\n387|\t}\n388|\tif !input.ForbiddenAfterProviderCommit {\n389|\t\treturn RollbackPlan{}, nil, invalid(\"%s forbidden_after_provider_commit is not true\", owner)\n390|\t}\n391|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n392|\t\treturn RollbackPlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n393|\t}\n394|\textensions := input.Extensions\n395|\tif extensions == nil {\n396|\t\textensions = map[string]any{}\n397|\t}\n398|\treturn RollbackPlan{}, map[string]any{\n399|\t\t\"required\":                        true,\n400|\t\t\"retain_through\":                  \"live_validated\",\n401|\t\t\"forbidden_after_provider_commit\": true,\n402|\t\t\"extensions\":                      extensions,\n403|\t}, nil\n404|}\n405|\n406|// decodeRollbackPlan validates one closed RollbackPlan.\n407|func decodeRollbackPlan(raw json.RawMessage) (RollbackPlan, error) {\n408|\towner := \"rollback plan\"\n409|\tmembers, fault := decodeStrictObject(raw)\n410|\tif fault != nil {\n411|\t\treturn RollbackPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n412|\t}\n413|\tif name, unknown := unknownMember(members, rollbackPlanMembers); unknown {\n414|\t\treturn RollbackPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n415|\t}\n416|\tif name, missing := missingMember(members, rollbackPlanRequired); missing {\n417|\t\treturn RollbackPlan{}, invalid(\"%s misses a required member %q\", owner, name)\n418|\t}\n419|\trequired, ok := rawBool(members[\"required\"])\n420|\tif !ok || !required {\n421|\t\treturn RollbackPlan{}, invalid(\"%s required is not true\", owner)\n422|\t}\n423|\tretain, ok := rawString(members[\"retain_through\"])\n424|\tif !ok || retain != \"live_validated\" {\n425|\t\treturn RollbackPlan{}, invalid(\"%s retain_through is not live_validated\", owner)\n426|\t}\n427|\tforbidden, ok := rawBool(members[\"forbidden_after_provider_commit\"])\n428|\tif !ok || !forbidden {\n429|\t\treturn RollbackPlan{}, invalid(\"%s forbidden_after_provider_commit is not true\", owner)\n430|\t}\n431|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n432|\t\treturn RollbackPlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n433|\t}\n434|\treturn RollbackPlan{}, nil\n435|}\n436|\n437|// buildContractRequirement validates one caller-supplied contract\n438|// requirement: contract_id string[1..256] and a SemVer version. The\n439|// SemVer grammar delegates to the environ owner.\n440|func buildContractRequirement(input ContractRequirementInput, index int) (ContractRequirement, map[string]any, error) {\n441|\towner := fmt.Sprintf(\"contract requirement[%d]\", index)\n442|\tif !validText(input.ContractID) {\n443|\t\treturn ContractRequirement{}, nil, invalid(\"%s contract_id is not valid UTF-8\", owner)\n444|\t}\n445|\tif length := stringLength(input.ContractID); length < 1 || length > 256 {\n446|\t\treturn ContractRequirement{}, nil, invalid(\"%s contract_id is not a string[1..256]\", owner)\n447|\t}\n448|\tif !validText(input.Version) {\n449|\t\treturn ContractRequirement{}, nil, invalid(\"%s version is not valid UTF-8\", owner)\n450|\t}\n451|\tif !environ.CheckSemver(input.Version) {\n452|\t\treturn ContractRequirement{}, nil, invalid(\"%s version is not a SemVer\", owner)\n453|\t}\n454|\treturn ContractRequirement{ContractID: input.ContractID, Version: input.Version}, map[string]any{\n455|\t\t\"contract_id\": input.ContractID,\n456|\t\t\"version\":     input.Version,\n457|\t}, nil\n458|}\n459|\n460|// decodeContractRequirement validates one closed\n461|// ContractRequirement.\n462|func decodeContractRequirement(raw json.RawMessage, index int) (ContractRequirement, error) {\n463|\towner := \"contract requirement\"\n464|\tmembers, fault := decodeStrictObject(raw)\n465|\tif fault != nil {\n466|\t\treturn ContractRequirement{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n467|\t}\n468|\tif name, unknown := unknownMember(members, contractRequirementMembers); unknown {\n469|\t\treturn ContractRequirement{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n470|\t}\n471|\tif name, missing := missingMember(members, contractRequirementRequired); missing {\n472|\t\treturn ContractRequirement{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n473|\t}\n474|\tid, ok := checkStringBounds(members[\"contract_id\"], 1, 256)\n475|\tif !ok {\n476|\t\treturn ContractRequirement{}, invalid(\"%s[%d] contract_id is not a string[1..256]\", owner, index)\n477|\t}\n478|\tversion, ok := rawString(members[\"version\"])\n479|\tif !ok || !environ.CheckSemver(version) {\n480|\t\treturn ContractRequirement{}, invalid(\"%s[%d] version is not a SemVer\", owner, index)\n481|\t}\n482|\treturn ContractRequirement{ContractID: id, Version: version}, nil\n483|}\n484|\n485|// checkContractOrder enforces \"Sorted unique\n486|// ContractRequirement\": contract IDs are strictly increasing. Both