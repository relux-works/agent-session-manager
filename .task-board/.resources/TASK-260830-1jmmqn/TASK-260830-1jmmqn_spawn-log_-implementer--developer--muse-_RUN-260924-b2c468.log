{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b7","stream":{"kind":"session","id":"01a0d1b0-8de1-7d92-b557-e0145e16dab5"},"sequence":566,"recorded_at":1780531400001127,"record_type":"event","durability":"durable","causation_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","run_stream":{"kind":"run","id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8"},"task_stream":{"kind":"task","id":"01a0d1b3-a0ed-7292-80ea-285772d153de"},"task_id":"01a0d1b3-a0ed-7292-80ea-285772d153de","event":{"kind":"output","task_id":"01a0d1b3-a0ed-7292-80ea-285772d153de","chunk":"{\n  \"chunk_id\": \"exec-16-1\",\n  \"command\": \"grep -n \\\"def run\\\\|go test\\\\|-run\\\\|verdict\\\\|FAIL\\\\|kill-line\\\\|def main\\\\|argv\\\\|log-dir\\\\|MUTANT\\\" internal/cloneplan/testdata/mutant_harness.py | head -30; echo ===; tail -80 internal/cloneplan/testdata/mutant_harness.py\",\n  \"description\": \"Show harness execution and verdict logic\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"10:scoped Go killer through a production entry), V (verdict from the Go\\n11:exit code plus a FAIL kill-line: KILLED iff R fails with a test\\n38:  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplan/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\\n65:MUTANTS = [\\n1319:def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\\n1332:                [\\\"go\\\", \\\"test\\\", f\\\"./{PACKAGE}/\\\", \\\"-run\\\", mutant.run, \\\"-count=1\\\"],\\n1345:        verdict = \\\"SURVIVED\\\"\\n1346:    elif '--- FAIL' in output or 'FAIL:' in output:\\n1347:        verdict = \\\"KILLED\\\"\\n1350:    mark = \\\"ok\\\" if verdict == mutant.expect else \\\"MISMATCH\\\"\\n1351:    return f\\\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\\\", output, run.returncode, elapsed\\n1354:def main(argv: list[str]) -> int:\\n1357:    args = list(argv)\\n1359:        if args[0] == \\\"--log-dir\\\":\\n1361:                print(\\\"missing directory for --log-dir\\\")\\n1368:    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\\n1384:                f\\\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\\\n\\\"\\n1394:    sys.exit(main(sys.argv[1:]))\\n===\\n    ),\\n]\\n\\n\\ndef run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\\n    target = REPO / mutant.path\\n    original = target.read_text()\\n    found = original.count(mutant.find)\\n    if found != mutant.count:\\n        return f\\\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\\\", \\\"\\\", -1, 0.0\\n    with tempfile.TemporaryDirectory() as staging:\\n        backup = Path(staging) / \\\"backup\\\"\\n        shutil.copy2(target, backup)\\n        try:\\n            target.write_text(original.replace(mutant.find, mutant.replace))\\n            started = time.time()\\n            run = subprocess.run(\\n                [\\\"go\\\", \\\"test\\\", f\\\"./{PACKAGE}/\\\", \\\"-run\\\", mutant.run, \\\"-count=1\\\"],\\n                cwd=REPO,\\n                capture_output=True,\\n                text=True,\\n                timeout=300,\\n            )\\n            elapsed = time.time() - started\\n        finally:\\n            shutil.copy2(backup, target)\\n    output = (run.stdout + run.stderr).strip()\\n    if 'build failed' in output or '\\\\n# ' in output or output.startswith('# '):\\n        return f\\\"ERROR: {mutant.name}: build broke under the patch\\\", output, run.returncode, elapsed\\n    if run.returncode == 0:\\n        verdict = \\\"SURVIVED\\\"\\n    elif '--- FAIL' in output or 'FAIL:' in output:\\n        verdict = \\\"KILLED\\\"\\n    else:\\n        return f\\\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\\\", output, run.returncode, elapsed\\n    mark = \\\"ok\\\" if verdict == mutant.expect else \\\"MISMATCH\\\"\\n    return f\\\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\\\", output, run.returncode, elapsed\\n\\n\\ndef main(argv: list[str]) -> int:\\n    log_dir: Path | None = None\\n    selected_names: list[str] = []\\n    args = list(argv)\\n    while args:\\n        if args[0] == \\\"--log-dir\\\":\\n            if len(args) < 2:\\n                print(\\\"missing directory for --log-dir\\\")\\n                return 2\\n            log_dir = Path(args[1])\\n            args = args[2:]\\n        else:\\n            selected_names.append(args[0])\\n            args = args[1:]\\n    selected = [m for m in MUTANTS if not selected_names or m.name in selected_names]\\n    if selected_names and len(selected) != len(selected_names):\\n        unknown = sorted(set(selected_names) - {m.name for m in selected})\\n        print(f\\\"unknown mutants: {', '.join(unknown)}\\\")\\n        return 2\\n    if log_dir is not None:\\n        log_dir.mkdir(parents=True, exist_ok=True)\\n    failures = 0\\n    for mutant in selected:\\n        try:\\n            line, output, exit_code, elapsed = run_mutant(mutant)\\n        except subprocess.TimeoutExpired:\\n            line, output, exit_code, elapsed = f\\\"ERROR: {mutant.name}: killer timed out\\\", \\\"\\\", -1, 0.0\\n        print(line, flush=True)\\n        if log_dir is not None:\\n            (log_dir / f\\\"{mutant.name}.log\\\").write_text(\\n                f\\\"# mutant={mutant.name} path={mutant.path} -run={mutant.run}\\\\n\\\"\\n                f\\\"# exit={exit_code} elapsed={elapsed:.1f}s\\\\n\\\"\\n                f\\\"# find={mutant.find!r}\\\\n# replace={mutant.replace!r}\\\\n---\\\\n{output}\\\\n\\\"\\n            )\\n        if not line.startswith(\\\"ok:\\\"):\\n            failures += 1\\n    return 1 if failures else 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main(sys.argv[1:]))\\n\",\n  \"original_output_bytes\": 4308,\n  \"original_output_tokens\": 1077,\n  \"truncated\": false\n}","final_result":true}}}
