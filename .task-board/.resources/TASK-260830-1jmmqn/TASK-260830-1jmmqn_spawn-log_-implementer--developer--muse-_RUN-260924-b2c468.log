vents:           []cloneplan.SynthesizedEventInput{},\n172|\t\tSecurityExclusions:          []string{},\n173|\t\tResourceLimits:              []byte(fixtureLimitsJSON()),\n174|\t\tTransactionPlan:             validTransactionInput(),\n175|\t\tReadBackPlan:                validReadBackInput(),\n176|\t\tResumePlan:                  validResumeInput(),\n177|\t\tRollbackPlan:                validRollbackInput(),\n178|\t\tRequiredContracts:           []cloneplan.ContractRequirementInput{validContractInput(\"ax.contract.plan\")},\n179|\t\tRequiredCapabilities:        []string{\"clone.target.write\"},\n180|\t\tFidelityBasisDigest:         fixtureDigest(\"basis\"),\n181|\t\tSourceAdapterBuildDigest:    fixtureDigest(\"source-build\"),\n182|\t\tTargetAdapterBuildDigest:    fixtureDigest(\"target-build\"),\n183|\t\tControllerBuildDigest:       fixtureDigest(\"controller-build\"),\n184|\t\tExtensions:                  map[string]any{},\n185|\t}\n186|}\n187|\n188|// validBlobEntryInput returns a valid blob manifest entry.\n189|func validBlobEntryInput(sequence uint64, key string) cloneplan.ProjectedEntryInput {\n190|\treturn cloneplan.ProjectedEntryInput{\n191|\t\tOperationSequence: sequence,\n192|\t\tResourceKey:       key,\n193|\t\tKind:              \"blob\",\n194|\t\tMode:              nil,\n195|\t\tByteCount:         u64ptr(128),\n196|\t\tBlobID:            strptr(fixtureDigest(\"blob-\" + key)),\n197|\t\tBlobDescriptorID:  strptr(fixtureDigest(\"descriptor-\" + key)),\n198|\t}\n199|}\n200|\n201|// validDirectoryEntryInput returns a valid directory manifest\n202|// entry.\n203|func validDirectoryEntryInput(sequence uint64, key string) cloneplan.ProjectedEntryInput {\n204|\treturn cloneplan.ProjectedEntryInput{\n205|\t\tOperationSequence: sequence,\n206|\t\tResourceKey:       key,\n207|\t\tKind:              \"directory\",\n208|\t\tMode:              u64ptr(0755),\n209|\t}\n210|}\n211|\n212|// validManifestInput returns a valid projected manifest candidate.\n213|func validManifestInput() cloneplan.ProjectedManifestInput {\n214|\treturn cloneplan.ProjectedManifestInput{\n215|\t\tOperationID:                 fixtureOperationID,\n216|\t\tProjectionPlanID:            fixtureDigest(\"plan-id\"),\n217|\t\tTargetEnvironment:           []byte(fixtureTupleJSON()),\n218|\t\tExpectedTargetNativeSession: \"target-native-session\",\n219|\t\tEntries: []cloneplan.ProjectedEntryInput{\n220|\t\t\tvalidDirectoryEntryInput(1, \"a-dir\"),\n221|\t\t\tvalidBlobEntryInput(1, \"b-blob\"),\n222|\t\t},\n223|\t\tTotalBytes: 128,\n224|\t\tExtensions: map[string]any{},\n225|\t}\n226|}\n227|\n228|func mustBuildPlan(t *testing.T, input cloneplan.ProjectionPlanInput) []byte {\n229|\tt.Helper()\n230|\tsealed, err := cloneplan.BuildProjectionPlan(input)\n231|\tif err != nil {\n232|\t\tt.Fatalf(\"BuildProjectionPlan: %v\", err)\n233|\t}\n234|\treturn sealed\n235|}\n236|\n237|func mustDecodePlan(t *testing.T, sealed []byte) cloneplan.ProjectionPlan {\n238|\tt.Helper()\n239|\tplan, err := cloneplan.DecodeProjectionPlan(sealed)\n240|\tif err != nil {\n241|\t\tt.Fatalf(\"DecodeProjectionPlan: %v\", err)\n242|\t}\n243|\treturn plan\n244|}\n245|\n246|func mustBuildManifest(t *testing.T, input cloneplan.ProjectedManifestInput) []byte {\n247|\tt.Helper()\n248|\tsealed, err := cloneplan.BuildProjectedObjectManifest(input)\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"BuildProjectedObjectManifest: %v\", err)\n251|\t}\n252|\treturn sealed\n253|}\n254|\n255|func mustDecodeManifest(t *testing.T, sealed []byte) cloneplan.ProjectedManifest {\n256|\tt.Helper()\n257|\tmanifest, err := cloneplan.DecodeProjectedObjectManifest(sealed)\n258|\tif err != nil {\n259|\t\tt.Fatalf(\"DecodeProjectedObjectManifest: %v\", err)\n260|\t}\n261|\treturn manifest\n262|}\n263|\n264|// requireRefusal asserts the error is an ErrInvalid refusal whose\n265|// detail carries every literal token.\n266|func requireRefusal(t *testing.T, err error, tokens ...string) {\n267|\tt.Helper()\n268|\tif err == nil {\n269|\t\tt.Fatalf(\"error = nil, want refusal containing %q\", tokens)\n270|\t}\n271|\tif !errors.Is(err, cloneplan.ErrInvalid) {\n272|\t\tt.Fatalf(\"error = %v, want cloneplan.ErrInvalid\", err)\n273|\t}\n274|\tfor _, token := range tokens {\n275|\t\tif !strings.Contains(err.Error(), token) {\n276|\t\t\tt.Fatalf(\"error = %q, want token %q\", err.Error(), token)\n277|\t\t}\n278|\t}\n279|}\n280|\n281|// decodeDocument unmarshals sealed bytes into a generic map for\n282|// member surgery.\n283|func decodeDocument(t *testing.T, sealed []byte) map[string]any {\n284|\tt.Helper()\n285|\tvar document map[string]any\n286|\tif err := json.Unmarshal(sealed, &document); err != nil {\n287|\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n288|\t}\n289|\treturn document\n290|}\n291|\n292|// marshalDocument renders a mutated document back to bytes.\n293|func marshalDocument(t *testing.T, document map[string]any) []byte {\n294|\tt.Helper()\n295|\traw, err := json.Marshal(document)\n296|\tif err != nil {\n297|\t\tt.Fatalf(\"marshal mutated: %v\", err)\n298|\t}\n299|\treturn raw\n300|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
