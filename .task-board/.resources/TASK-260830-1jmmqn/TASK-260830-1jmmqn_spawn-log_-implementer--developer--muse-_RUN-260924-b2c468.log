ge planCensusShapes(t) {\\n847-\\t\\tfor _, member := range shape.members {\\n848-\\t\\t\\tuniverse[member.name] = true\\n849-\\t\\t}\\n850-\\t}\\n851-\\tif len(universe) == 0 {\\n852-\\t\\tt.Fatal(\\\"derived member universe is empty\\\")\\n853-\\t}\\n854-\\t_, file, _, ok := runtime.Caller(0)\\n855-\\tif !ok {\\n856-\\t\\tt.Fatal(\\\"runtime.Caller failed\\\")\\n857-\\t}\\n858-\\tfiles, err := filepath.Glob(filepath.Join(filepath.Dir(file), \\\"*_test.go\\\"))\\n859-\\tif err != nil {\\n860-\\t\\tt.Fatalf(\\\"glob test files: %v\\\", err)\\n861-\\t}\\n862-\\tif len(files) == 0 {\\n863-\\t\\tt.Fatal(\\\"no test files found\\\")\\n864-\\t}\\n865-\\tfor _, path := range files {\\n866-\\t\\tsource, err := os.ReadFile(path)\\n867-\\t\\tif err != nil {\\n868-\\t\\t\\tt.Fatalf(\\\"read %s: %v\\\", path, err)\\n869-\\t\\t}\\n870-\\t\\tfset := token.NewFileSet()\\n871-\\t\\tparsed, err := parser.ParseFile(fset, path, source, 0)\\n872-\\t\\tif err != nil {\\n873-\\t\\t\\tt.Fatalf(\\\"parse %s: %v\\\", path, err)\\n874-\\t\\t}\\n875-\\t\\tast.Inspect(parsed, func(node ast.Node) bool {\\n876-\\t\\t\\tcomposite, ok := node.(*ast.CompositeLit)\\n877-\\t\\t\\tif !ok {\\n878-\\t\\t\\t\\treturn true\\n879-\\t\\t\\t}\\n880-\\t\\t\\tmembers := map[string]bool{}\\n881-\\t\\t\\tmemberLiterals := 0\\n882-\\t\\t\\tstringLiterals := 0\\n883-\\t\\t\\tvar walk func(node ast.Node)\\n884-\\t\\t\\twalk = func(node ast.Node) {\\n====\\n10571:Fidelity Report ID. Clone Projected Object Manifest 1.0.0 binds plan and target\\n10722:Clone Projected Object Manifest 1.0.0 contains exactly its schema/version,\\n====\\ninternal/cloneplan/decode.go:42:\\tif member == \\\"\\\" {\\ninternal/cloneplan/decode.go:141:\\treturn string(bytes.TrimSpace(raw)) == \\\"null\\\"\\ninternal/cloneplan/manifest.go:131:\\tif kind == \\\"blob\\\" {\\ninternal/cloneplan/manifest.go:194:\\tif input.Kind == \\\"blob\\\" {\\ninternal/cloneplan/manifest.go:234:\\tif kind == \\\"directory\\\" {\\ninternal/cloneplan/manifest.go:265:\\tif kind == \\\"blob\\\" {\\ninternal/cloneplan/resources.go:65:\\tif kind == \\\"blob\\\" && !hasBlob {\\ninternal/cloneplan/resources.go:68:\\tif kind == \\\"directory\\\" && hasBlob {\\n\",\n  \"original_output_bytes\": 2610,\n  \"original_output_tokens\": 653,\n  \"truncated\": false\n}","final_result":true}}}
