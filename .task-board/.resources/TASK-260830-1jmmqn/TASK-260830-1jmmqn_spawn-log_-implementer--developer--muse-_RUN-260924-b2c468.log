s N-strategy-route and N-action-route are the token-preserving\\nattacks: the searched-for token still matches the vocabulary table,\\nbut the entry decision changes, and the killers execute the\\nbehavioral oracle suites through both entries.\\n\\nSingle-member-class rows narrow a gate whose reject class holds\\nexactly one member, so the plant admits the whole class, which is\\none member.\\n\\nRow C-doc-comment is the harmless control: a comment-only edit that\\nmust SURVIVE, proving the harness observes test outcomes instead of\\nhard-coding kills.\\n\\nUsage:\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/cloneplan/testdata/mutant_harness.py [--log-dir DIR] [MUTANT ...]\\n\\\"\\\"\\\"\\n\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\n\\nREPO = Path(__file__).resolve().parents[3]\\nPACKAGE = \\\"internal/cloneplan\\\"\\n\\n\\n@dataclass(frozen=True)\\nclass Mutant:\\n    name: str\\n    path: str\\n    find: str\\n    replace: str\\n    count: int\\n    run: str\\n    expect: str\\n    note: str\\n\\n\\nMUTANTS = [\\n    Mutant(\\n        name=\\\"N-strategy-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidPlanStrategy(strategy string) bool {\\\\n\\\\tfor _, allowed := range planStrategies {\\\\n\\\\t\\\\tif strategy == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidPlanStrategy(strategy string) bool {\\\\n\\\\tfor _, allowed := range planStrategies {\\\\n\\\\t\\\\tif strategy == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif strategy == \\\"archive_only\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        count=1,\\n        run=\\\"TestPlanStrategyOracle\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Shared gate: admits exactly archive_only past the plan strategy vocabulary at both entries.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-profile-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidPlanProfile(profile string) bool {\\\\n\\\\tfor _, allowed := range planProfiles {\\\\n\\\\t\\\\tif profile == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidPlanProfile(profile string) bool {\\\\n\\\\tfor _, allowed := range planProfiles {\\\\n\\\\t\\\\tif profile == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif profile == \\\"archive_only\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        count=1,\\n        run=\\\"TestPlanProfileOracle\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Shared gate: admits exactly archive_only past the plan profile vocabulary at both entries.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-action-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidOperationAction(action string) bool {\\\\n\\\\tfor _, allowed := range operationActions {\\\\n\\\\t\\\\tif action == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidOperationAction(action string) bool {\\\\n\\\\tfor _, allowed := range operationActions {\\\\n\\\\t\\\\tif action == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif action == \\\"delete_blob\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        count=1,\\n        run=\\\"TestOperationActionOracle\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Shared gate: admits exactly delete_blob past the action vocabulary at both entries.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-purpose-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidSynthesizedPurpose(purpose string) bool {\\\\n\\\\tfor _, allowed := range synthesizedPurposes {\\\\n\\\\t\\\\tif purpose == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidSynthesizedPurpose(purpose string) bool {\\\\n\\\\tfor _, allowed := range synthesizedPurposes {\\\\n\\\\t\\\\tif purpose == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif purpose == \\\"checkpoint\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        count=1,\\n        run=\\\"TestSynthesizedPurposeOracle\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Shared gate: admits exactly checkpoint past the purpose vocabulary at both entries.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-kind-vocab\\\",\\n        path=f\\\"{PACKAGE}/vocab.go\\\",\\n        find='''func ValidResourceKind(kind string) bool {\\\\n\\\\tfor _, allowed := range resourceKinds {\\\\n\\\\t\\\\tif kind == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        replace='''func ValidResourceKind(kind string) bool {\\\\n\\\\tfor _, allowed := range resourceKinds {\\\\n\\\\t\\\\tif kind == allowed {\\\\n\\\\t\\\\t\\\\treturn true\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\tif kind == \\\"file\\\" {\\\\n\\\\t\\\\treturn true\\\\n\\\\t}\\\\n\\\\treturn false\\\\n}''',\\n        count=1,\\n        run=\\\"TestResourceKindOracle\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Shared gate: admits exactly file past the kind vocabulary on both shapes at both entries.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-strategy-route\\\",\\n        path=f\\\"{PACKAGE}/plan.go\\\",\\n        find='''\\\\tif !ValidPlanStrategy(input.Strategy) {''',\\n        replace='''\\\\tif !ValidPlanStrategy(input.Strategy) && input.Strategy != \\\"archive_only\\\" {''',\\n\",\n  \"original_output_bytes\": 5971,\n  \"original_output_tokens\": 1493,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
