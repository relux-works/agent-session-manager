ange elements {\n288|\t\tmode, ok := rawString(element)\n289|\t\tif !ok {\n290|\t\t\treturn ReadBackPlan{}, invalid(\"%s modes are not [staged,live]\", owner)\n291|\t\t}\n292|\t\tmodes = append(modes, mode)\n293|\t}\n294|\tif err := checkReadBackModes(modes); err != nil {\n295|\t\treturn ReadBackPlan{}, err\n296|\t}\n297|\tidentity, ok := rawBool(members[\"require_identity_match\"])\n298|\tif !ok || !identity {\n299|\t\treturn ReadBackPlan{}, invalid(\"%s require_identity_match is not true\", owner)\n300|\t}\n301|\tworkspace, ok := rawBool(members[\"require_workspace_match\"])\n302|\tif !ok || !workspace {\n303|\t\treturn ReadBackPlan{}, invalid(\"%s require_workspace_match is not true\", owner)\n304|\t}\n305|\tsemantic, ok := rawBool(members[\"require_semantic_marker\"])\n306|\tif !ok || !semantic {\n307|\t\treturn ReadBackPlan{}, invalid(\"%s require_semantic_marker is not true\", owner)\n308|\t}\n309|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n310|\t\treturn ReadBackPlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n311|\t}\n312|\treturn ReadBackPlan{}, nil\n313|}\n314|\n315|// buildResumePlan validates one caller-supplied resume plan and\n316|// renders its closed object: opens_existing_identity=true,\n317|// allow_blank_fallback=false, and a boolean\n318|// bounded_continuation_turn_required.\n319|func buildResumePlan(input ResumePlanInput) (ResumePlan, map[string]any, error) {\n320|\towner := \"resume projection plan\"\n321|\tif !input.OpensExistingIdentity {\n322|\t\treturn ResumePlan{}, nil, invalid(\"%s opens_existing_identity is not true\", owner)\n323|\t}\n324|\tif input.AllowBlankFallback {\n325|\t\treturn ResumePlan{}, nil, invalid(\"%s allow_blank_fallback is not false\", owner)\n326|\t}\n327|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n328|\t\treturn ResumePlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n329|\t}\n330|\textensions := input.Extensions\n331|\tif extensions == nil {\n332|\t\textensions = map[string]any{}\n333|\t}\n334|\treturn ResumePlan{BoundedContinuationTurnRequired: input.BoundedContinuationTurnRequired}, map[string]any{\n335|\t\t\"opens_existing_identity\":            true,\n336|\t\t\"allow_blank_fallback\":               false,\n337|\t\t\"bounded_continuation_turn_required\": input.BoundedContinuationTurnRequired,\n338|\t\t\"extensions\":                         extensions,\n339|\t}, nil\n340|}\n341|\n342|// decodeResumePlan validates one closed ResumeProjectionPlan.\n343|func decodeResumePlan(raw json.RawMessage) (ResumePlan, error) {\n344|\towner := \"resume projection plan\"\n345|\tmembers, fault := decodeStrictObject(raw)\n346|\tif fault != nil {\n347|\t\treturn ResumePlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n348|\t}\n349|\tif name, unknown := unknownMember(members, resumePlanMembers); unknown {\n350|\t\treturn ResumePlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n351|\t}\n352|\tif name, missing := missingMember(members, resumePlanRequired); missing {\n353|\t\treturn ResumePlan{}, invalid(\"%s misses a required member %q\", owner, name)\n354|\t}\n355|\topens, ok := rawBool(members[\"opens_existing_identity\"])\n356|\tif !ok || !opens {\n357|\t\treturn ResumePlan{}, invalid(\"%s opens_existing_identity is not true\", owner)\n358|\t}\n359|\tblank, ok := rawBool(members[\"allow_blank_fallback\"])\n360|\tif !ok || blank {\n361|\t\treturn ResumePlan{}, invalid(\"%s allow_blank_fallback is not false\", owner)\n362|\t}\n363|\tbounded, ok := rawBool(members[\"bounded_continuation_turn_required\"])\n364|\tif !ok {\n365|\t\treturn ResumePlan{}, invalid(\"%s bounded_continuation_turn_required is not a boolean\", owner)\n366|\t}\n367|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n368|\t\treturn ResumePlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n369|\t}\n370|\treturn ResumePlan{BoundedContinuationTurnRequired: bounded}, nil\n371|}\n372|\n373|// buildRollbackPlan validates one caller-supplied rollback plan and\n374|// renders its closed object: required=true,\n375|// retain_through=live_validated,\n376|// forbidden_after_provider_commit=true.\n377|func buildRollbackPlan(input RollbackPlanInput) (RollbackPlan, map[string]any, error) {\n378|\towner := \"rollback plan\"\n379|\tif !input.Required {\n380|\t\treturn RollbackPlan{}, nil, invalid(\"%s required is not true\", owner)\n381|\t}\n382|\tif !validText(input.RetainThrough) {\n383|\t\treturn RollbackPlan{}, nil, invalid(\"%s retain_through is not valid UTF-8\", owner)\n384|\t}\n385|\tif input.RetainThrough != \"live_validated\" {\n386|\t\treturn RollbackPlan{}, nil, invalid(\"%s retain_through is not live_validated\", owner)\n387|\t}\n388|\tif !input.ForbiddenAfterProviderCommit {\n389|\t\treturn RollbackPlan{}, nil, invalid(\"%s forbidden_after_provider_commit is not true\", owner)\n390|\t}\n391|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n392|\t\treturn RollbackPlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n393|\t}\n394|\textensions := input.Extensions\n395|\tif extensions == nil {\n396|\t\textensions = map[string]any{}\n397|\t}\n398|\treturn RollbackPlan{}, map[string]any{\n399|\t\t\"required\":                        true,\n400|\t\t\"retain_through\":                  \"live_validated\",\n401|\t\t\"forbidden_after_provider_commit\": true,\n402|\t\t\"extensions\":                      extensions,\n403|\t}, nil\n404|}\n405|\n406|// decodeRollbackPlan validates one closed RollbackPlan.\n407|func decodeRollbackPlan(raw json.RawMessage) (RollbackPlan, error) {\n408|\towner := \"rollback plan\"\n409|\tmembers, fault := decodeStrictObject(raw)\n410|\tif fault != nil {\n411|\t\treturn RollbackPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n412|\t}\n413|\tif name, unknown := unknownMember(members, rollbackPlanMembers); unknown {\n414|\t\treturn RollbackPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n415|\t}\n416|\tif name, missing := missingMember(members, rollbackPlanRequired); missing {\n417|\t\treturn RollbackPlan{}, invalid(\"%s misses a required member %q\", owner, name)\n418|\t}\n419|\trequired, ok := rawBool(members[\"required\"])\n420|\tif !ok || !required {\n421|\t\treturn RollbackPlan{}, invalid(\"%s required is not true\", owner)\n422|\t}\n423|\tretain, ok := rawString(members[\"retain_through\"])\n424|\tif !ok || retain != \"live_validated\" {\n425|\t\treturn RollbackPlan{}, invalid(\"%s retain_through is not live_validated\", owner)\n426|\t}\n427|\tforbidden, ok := rawBool(members[\"forbidden_after_provider_commit\"])\n428|\tif !ok || !forbidden {\n429|\t\treturn RollbackPlan{}, invalid(\"%s forbidden_after_provider_commit is not true\", owner)\n430|\t}\n431|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n432|\t\treturn RollbackPlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n433|\t}\n434|\treturn RollbackPlan{}, nil\n435|}\n436|\n437|// buildContractRequirement validates one caller-supplied contract\n438|// requirement: contract_id string[1..256] and a SemVer version. The\n439|// SemVer grammar delegates to the environ owner.\n440|func buildContractRequirement(input ContractRequirementInput, index int) (ContractRequirement, map[string]any, error) {\n441|\towner := fmt.Sprintf(\"contract requirement[%d]\", index)\n442|\tif !validText(input.ContractID) {\n443|\t\treturn ContractRequirement{}, nil, invalid(\"%s contract_id is not valid UTF-8\", owner)\n444|\t}\n445|\tif length := stringLength(input.ContractID); length < 1 || length > 256 {\n446|\t\treturn ContractRequirement{}, nil, invalid(\"%s contract_id is not a string[1..256]\", owner)\n447|\t}\n448|\tif !validText(input.Version) {\n449|\t\treturn ContractRequirement{}, nil, invalid(\"%s version is not valid UTF-8\", owner)\n450|\t}\n451|\tif !environ.CheckSemver(input.Version) {\n452|\t\treturn ContractRequirement{}, nil, invalid(\"%s version is not a SemVer\", owner)\n453|\t}\n454|\treturn ContractRequirement{ContractID: input.ContractID, Version: input.Version}, map[string]any{\n455|\t\t\"contract_id\": input.ContractID,\n456|\t\t\"version\":     input.Version,\n457|\t}, nil\n458|}\n459|\n460|// decodeContractRequirement validates one closed\n461|// ContractRequirement.\n462|func decodeContractRequirement(raw json.RawMessage, index int) (ContractRequirement, error) {\n463|\towner := \"contract requirement\"\n464|\tmembers, fault := decodeStrictObject(raw)\n465|\tif fault != nil {\n466|\t\treturn ContractRequirement{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n467|\t}\n468|\tif name, unknown := unknownMember(members, contractRequirementMembers); unknown {\n469|\t\treturn ContractRequirement{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n470|\t}\n471|\tif name, missing := missingMember(members, contractRequirementRequired); missing {\n472|\t\treturn ContractRequirement{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n473|\t}\n474|\tid, ok := checkStringBounds(members[\"contract_id\"], 1, 256)\n475|\tif !ok {\n476|\t\treturn ContractRequirement{}, invalid(\"%s[%d] contract_id is not a string[1..256]\", owner, index)\n477|\t}\n478|\tversion, ok := rawString(members[\"version\"])\n479|\tif !ok || !environ.CheckSemver(version) {\n480|\t\treturn ContractRequirement{}, invalid(\"%s[%d] version is not a SemVer\", owner, index)\n481|\t}\n482|\treturn ContractRequirement{ContractID: id, Version: version}, nil\n483|}\n484|\n485|// checkContractOrder enforces \"Sorted unique\n486|// ContractRequirement\": contract IDs are strictly increasing. Both\n487|// entries share this gate over the sealed requirement set.\n488|func checkContractOrder(requirements []ContractRequirement) error {\n489|\tfor index := 1; index < len(requirements); index++ {\n490|\t\tif requirements[index].ContractID <= requirements[index-1].ContractID {\n491|\t\t\treturn invalid(\"projection plan required_contracts are not sorted unique by contract_id\")\n492|\t\t}\n493|\t}\n494|\treturn nil\n495|}\n496|\n497|// checkContractCount enforces the required_contracts cardinality\n498|// bound ContractRequirement[1..64].\n499|func checkContractCount(count int) error {\n500|\tif count < 1 || count > 64 {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
