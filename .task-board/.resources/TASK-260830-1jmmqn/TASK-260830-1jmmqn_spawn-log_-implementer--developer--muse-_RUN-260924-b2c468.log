{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0d1b0-8de1-7d92-b557-e0145e16dab5"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","run_stream":{"kind":"run","id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8"},"task_stream":{"kind":"task","id":"01a0d1b3-c6d8-7c72-9f17-f53632b6d2df"},"task_id":"01a0d1b3-c6d8-7c72-9f17-f53632b6d2df","event":{"kind":"output","task_id":"01a0d1b3-c6d8-7c72-9f17-f53632b6d2df","chunk":"Read text file `internal/cloneplan/framing_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n9|)\n10|\n11|// TestFraming pins the strict frame on both decode entries:\n12|// non-objects, trailing data, lone-surrogate escapes, and invalid\n13|// UTF-8 refuse before any member gate runs.\n14|func TestFraming(t *testing.T) {\n15|\tsealed := mustBuildPlan(t, validPlanInput())\n16|\tcases := []struct {\n17|\t\tlabel string\n18|\t\traw   []byte\n19|\t}{\n20|\t\t{\"array\", []byte(`[]`)},\n21|\t\t{\"string\", []byte(`\"x\"`)},\n22|\t\t{\"number\", []byte(`7`)},\n23|\t\t{\"null\", []byte(`null`)},\n24|\t\t{\"empty\", []byte(``)},\n25|\t\t// Trailing whitespace is admitted by the landed strict\n26|\t\t// frame (JSON-insignificant); trailing values refuse.\n27|\t\t{\"trailing-object\", append(append([]byte{}, sealed...), []byte(`{}`)...)},\n28|\t\t{\"lone-surrogate\", []byte(`{\"schema\":\"a�b\"}`)},\n29|\t\t{\"invalid-utf8\", []byte{0x7b, 0x22, 0xff, 0x22, 0x7d}},\n30|\t}\n31|\tfor _, row := range cases {\n32|\t\t_, err := cloneplan.DecodeProjectionPlan(row.raw)\n33|\t\trequireRefusal(t, err, \"projection plan\")\n34|\t}\n35|\tmsealed := mustBuildManifest(t, validManifestInput())\n36|\tmcases := []struct {\n37|\t\tlabel string\n38|\t\traw   []byte\n39|\t}{\n40|\t\t{\"array\", []byte(`[]`)},\n41|\t\t{\"trailing-object\", append(append([]byte{}, msealed...), []byte(`{}`)...)},\n42|\t\t{\"invalid-utf8\", []byte{0x7b, 0x22, 0xff, 0x22, 0x7d}},\n43|\t}\n44|\tfor _, row := range mcases {\n45|\t\t_, err := cloneplan.DecodeProjectedObjectManifest(row.raw)\n46|\t\trequireRefusal(t, err, \"projected object manifest\")\n47|\t}\n48|\t// A lone surrogate escape inside a member value refuses too.\n49|\traw := strings.Replace(string(sealed), `\"target_native_writer\"`, `\"target\\ud800_writer\"`, 1)\n50|\t_, err := cloneplan.DecodeProjectionPlan([]byte(raw))\n51|\trequireRefusal(t, err, \"projection plan\")\n52|}\n53|\n54|// TestDeterminism pins that identical inputs produce byte-identical\n55|// outputs on both build entries.\n56|func TestDeterminism(t *testing.T) {\n57|\tfirst := mustBuildPlan(t, validPlanInput())\n58|\tfor index := 0; index < 10; index++ {\n59|\t\tsealed := mustBuildPlan(t, validPlanInput())\n60|\t\tif !bytes.Equal(sealed, first) {\n61|\t\t\tt.Fatalf(\"plan build %d differs from build 0\", index)\n62|\t\t}\n63|\t}\n64|\tmfirst := mustBuildManifest(t, validManifestInput())\n65|\tfor index := 0; index < 10; index++ {\n66|\t\tsealed := mustBuildManifest(t, validManifestInput())\n67|\t\tif !bytes.Equal(sealed, mfirst) {\n68|\t\t\tt.Fatalf(\"manifest build %d differs from build 0\", index)\n69|\t\t}\n70|\t}\n71|}\n72|\n73|// TestEntriesArePure pins that decode never mutates its input and\n74|// every build output decodes clean.\n75|func TestEntriesArePure(t *testing.T) {\n76|\tsealed := mustBuildPlan(t, validPlanInput())\n77|\tbefore := append([]byte{}, sealed...)\n78|\tmustDecodePlan(t, sealed)\n79|\tif !bytes.Equal(sealed, before) {\n80|\t\tt.Fatal(\"DecodeProjectionPlan mutated its input\")\n81|\t}\n82|\tmsealed := mustBuildManifest(t, validManifestInput())\n83|\tmbefore := append([]byte{}, msealed...)\n84|\tmustDecodeManifest(t, msealed)\n85|\tif !bytes.Equal(msealed, mbefore) {\n86|\t\tt.Fatal(\"DecodeProjectedObjectManifest mutated its input\")\n87|\t}\n88|}\n89|\n90|// TestSchemaLiterals pins the exact schema/version literals on both\n91|// decode entries with literal expectations.\n92|func TestSchemaLiterals(t *testing.T) {\n93|\tsealed := mustBuildPlan(t, validPlanInput())\n94|\tfor _, schema := range []string{\"\", \"urn:ax:schema:projection-plan \", \"urn:ax:schema:projection_plan\", \"urn:ax:schema:fidelity-report\"} {\n95|\t\tdocument := decodeDocument(t, sealed)\n96|\t\tdocument[\"schema\"] = schema\n97|\t\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n98|\t\trequireRefusal(t, err, \"schema is not urn:ax:schema:projection-plan\")\n99|\t}\n100|\tfor _, version := range []string{\"\", \"1.0\", \"1.0.0 \", \"2.0.0\"} {\n101|\t\tdocument := decodeDocument(t, sealed)\n102|\t\tdocument[\"schema_version\"] = version\n103|\t\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n104|\t\trequireRefusal(t, err, \"schema_version is not 1.0.0\")\n105|\t}\n106|\tmsealed := mustBuildManifest(t, validManifestInput())\n107|\tfor _, schema := range []string{\"\", \"urn:ax:schema:clone-projected-object-manifest \", \"urn:ax:schema:projection-plan\"} {\n108|\t\tdocument := decodeDocument(t, msealed)\n109|\t\tdocument[\"schema\"] = schema\n110|\t\t_, err := cloneplan.DecodeProjectedObjectManifest(marshalDocument(t, document))\n111|\t\trequireRefusal(t, err, \"schema is not urn:ax:schema:clone-projected-object-manifest\")\n112|\t}\n113|\tdocument := decodeDocument(t, msealed)\n114|\tdocument[\"schema_version\"] = \"2.0.0\"\n115|\t_, err := cloneplan.DecodeProjectedObjectManifest(marshalDocument(t, document))\n116|\trequireRefusal(t, err, \"schema_version is not 1.0.0\")\n117|}","final_result":true}}}
