cy\"] = \"must_be_absent2\" }, \"target_collision_policy is not must_be_absent\"},\n457|\t\t\t{\"activation\", func(input *cloneplan.TransactionPlanInput) { input.Activation = \"active\" },\n458|\t\t\t\tfunc(nested map[string]any) { nested[\"activation\"] = \"active\" }, \"activation is not dormant_validated\"},\n459|\t\t\t{\"activation-near\", func(input *cloneplan.TransactionPlanInput) { input.Activation = \"dormant_validated2\" },\n460|\t\t\t\tfunc(nested map[string]any) { nested[\"activation\"] = \"dormant_validated2\" }, \"activation is not dormant_validated\"},\n461|\t\t}\n462|\t\tfor _, row := range cases {\n463|\t\t\tinput := validPlanInput()\n464|\t\t\ttransaction := input.TransactionPlan\n465|\t\t\trow.mutate(&transaction)\n466|\t\t\tinput.TransactionPlan = transaction\n467|\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n468|\t\t\trequireRefusal(t, err, \"transaction plan\", row.token)\n469|\t\t\tsealed := mustBuildPlan(t, validPlanInput())\n470|\t\t\tdocument := decodeDocument(t, sealed)\n471|\t\t\trow.doc(document[\"transaction_plan\"].(map[string]any))\n472|\t\t\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n473|\t\t\trequireRefusal(t, err, \"transaction plan\", row.token)\n474|\t\t}\n475|\t})\n476|\tt.Run(\"read-back\", func(t *testing.T) {\n477|\t\tfor _, modes := range [][]string{\n478|\t\t\t{}, {\"staged\"}, {\"live\"}, {\"live\", \"staged\"},\n479|\t\t\t{\"staged\", \"live\", \"live\"}, {\"staged\", \"staged\"}, {\"x\", \"y\"},\n480|\t\t\t{\"staged\", \"live2\"},\n481|\t\t} {\n482|\t\t\tinput := validPlanInput()\n483|\t\t\treadBack := input.ReadBackPlan\n484|\t\t\treadBack.Modes = modes\n485|\t\t\tinput.ReadBackPlan = readBack\n486|\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n487|\t\t\trequireRefusal(t, err, \"read-back plan\", \"modes are not [staged,live]\")\n488|\t\t\tsealed := mustBuildPlan(t, validPlanInput())\n489|\t\t\tdocument := decodeDocument(t, sealed)\n490|\t\t\tanyModes := make([]any, 0, len(mode