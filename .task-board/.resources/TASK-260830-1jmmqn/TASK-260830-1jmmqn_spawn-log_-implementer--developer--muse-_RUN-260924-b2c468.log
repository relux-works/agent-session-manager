{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ab","stream":{"kind":"session","id":"01a0d1b0-8de1-7d92-b557-e0145e16dab5"},"sequence":304,"recorded_at":1780531400000603,"record_type":"event","durability":"durable","causation_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8","run_stream":{"kind":"run","id":"cf8f870b-7b13-4d13-bdaa-1af4a685e1f8"},"call_id":"call_01a0d1b144af764193d23580c2d11f14","text":"Read text file `internal/cloneplan/plans.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n9|)\n10|\n11|// This file validates and constructs the four closed plan\n12|// components Section 13.14.2 states (TransactionPlan, ReadBackPlan,\n13|// ResumeProjectionPlan, RollbackPlan) and ContractRequirement. Every\n14|// constant is a refusal: any value but the pinned one refuses, on\n15|// both entries, including non-string and non-boolean JSON types on\n16|// decode. ContractRequirement carries exactly contract_id and\n17|// version — the pinned text states no extensions member for it, so\n18|// an extensions member there is unknown.\n19|\n20|var transactionPlanMembers = map[string]bool{\n21|\t\"materialization_intent\":  true,\n22|\t\"target_collision_policy\": true,\n23|\t\"activation\":              true,\n24|\t\"extensions\":              true,\n25|}\n26|\n27|var transactionPlanRequired = []string{\n28|\t\"materialization_intent\",\n29|\t\"target_collision_policy\",\n30|\t\"activation\",\n31|\t\"extensions\",\n32|}\n33|\n34|var readBackPlanMembers = map[string]bool{\n35|\t\"modes\":                   true,\n36|\t\"require_identity_match\":  true,\n37|\t\"require_workspace_match\": true,\n38|\t\"require_semantic_marker\": true,\n39|\t\"extensions\":              true,\n40|}\n41|\n42|var readBackPlanRequired = []string{\n43|\t\"modes\",\n44|\t\"require_identity_match\",\n45|\t\"require_workspace_match\",\n46|\t\"require_semantic_marker\",\n47|\t\"extensions\",\n48|}\n49|\n50|var resumePlanMembers = map[string]bool{\n51|\t\"opens_existing_identity\":            true,\n52|\t\"allow_blank_fallback\":               true,\n53|\t\"bounded_continuation_turn_required\": true,\n54|\t\"extensions\":                         true,\n55|}\n56|\n57|var resumePlanRequired = []string{\n58|\t\"opens_existing_identity\",\n59|\t\"allow_blank_fallback\",\n60|\t\"bounded_continuation_turn_required\",\n61|\t\"extensions\",\n62|}\n63|\n64|var rollbackPlanMembers = map[string]bool{\n65|\t\"required\":                        true,\n66|\t\"retain_through\":                  true,\n67|\t\"forbidden_after_provider_commit\": true,\n68|\t\"extensions\":                      true,\n69|}\n70|\n71|var rollbackPlanRequired = []string{\n72|\t\"required\",\n73|\t\"retain_through\",\n74|\t\"forbidden_after_provider_commit\",\n75|\t\"extensions\",\n76|}\n77|\n78|var contractRequirementMembers = map[string]bool{\n79|\t\"contract_id\": true,\n80|\t\"version\":     true,\n81|}\n82|\n83|var contractRequirementRequired = []string{\n84|\t\"contract_id\",\n85|\t\"version\",\n86|}\n87|\n88|// TransactionPlan is one validated closed transaction plan.\n89|type TransactionPlan struct{}\n90|\n91|// TransactionPlanInput is the caller-supplied transaction plan\n92|// candidate for Build.\n93|type TransactionPlanInput struct {\n94|\tMaterializationIntent string\n95|\tTargetCollisionPolicy string\n96|\tActivation            string\n97|\tExtensions            map[string]any\n98|}\n99|\n100|// ReadBackPlan is one validated closed read-back plan.\n101|type ReadBackPlan struct{}\n102|\n103|// ReadBackPlanInput is the caller-supplied read-back plan candidate\n104|// for Build.\n105|type ReadBackPlanInput struct {\n106|\tModes                 []string\n107|\tRequireIdentityMatch  bool\n108|\tRequireWorkspaceMatch bool\n109|\tRequireSemanticMarker bool\n110|\tExtensions            map[string]any\n111|}\n112|\n113|// ResumePlan is one validated closed resume projection plan.\n114|type ResumePlan struct {\n115|\tBoundedContinuationTurnRequired bool\n116|}\n117|\n118|// ResumePlanInput is the caller-supplied resume plan candidate for\n119|// Build.\n120|type ResumePlanInput struct {\n121|\tOpensExistingIdentity           bool\n122|\tAllowBlankFallback              bool\n123|\tBoundedContinuationTurnRequired bool\n124|\tExtensions                      map[string]any\n125|}\n126|\n127|// RollbackPlan is one validated closed rollback plan.\n128|type RollbackPlan struct{}\n129|\n130|// RollbackPlanInput is the caller-supplied rollback plan candidate\n131|// for Build.\n132|type RollbackPlanInput struct {\n133|\tRequired                     bool\n134|\tRetainThrough                string\n135|\tForbiddenAfterProviderCommit bool\n136|\tExtensions                   map[string]any\n137|}\n138|\n139|// ContractRequirement is one validated contract requirement.\n140|type ContractRequirement struct {\n141|\tContractID string\n142|\tVersion    string\n143|}\n144|\n145|// ContractRequirementInput is the caller-supplied contract\n146|// requirement candidate for Build.\n147|type ContractRequirementInput struct {\n148|\tContractID string\n149|\tVersion    string\n150|}\n151|\n152|// buildTransactionPlan validates one caller-supplied transaction\n153|// plan and renders its closed object: materialization_intent=clone,\n154|// target_collision_policy=must_be_absent,\n155|// activation=dormant_validated.\n156|func buildTransactionPlan(input TransactionPlanInput) (TransactionPlan, map[string]any, error) {\n157|\towner := \"transaction plan\"\n158|\tif !validText(input.MaterializationIntent) {\n159|\t\treturn TransactionPlan{}, nil, invalid(\"%s materialization_intent is not valid UTF-8\", owner)\n160|\t}\n161|\tif input.MaterializationIntent != \"clone\" {\n162|\t\treturn TransactionPlan{}, nil, invalid(\"%s materialization_intent is not clone\", owner)\n163|\t}\n164|\tif !validText(input.TargetCollisionPolicy) {\n165|\t\treturn TransactionPlan{}, nil, invalid(\"%s target_collision_policy is not valid UTF-8\", owner)\n166|\t}\n167|\tif input.TargetCollisionPolicy != \"must_be_absent\" {\n168|\t\treturn TransactionPlan{}, nil, invalid(\"%s target_collision_policy is not must_be_absent\", owner)\n169|\t}\n170|\tif !validText(input.Activation) {\n171|\t\treturn TransactionPlan{}, nil, invalid(\"%s activation is not valid UTF-8\", owner)\n172|\t}\n173|\tif input.Activation != \"dormant_validated\" {\n174|\t\treturn TransactionPlan{}, nil, invalid(\"%s activation is not dormant_validated\", owner)\n175|\t}\n176|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n177|\t\treturn TransactionPlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n178|\t}\n179|\textensions := input.Extensions\n180|\tif extensions == nil {\n181|\t\textensions = map[string]any{}\n182|\t}\n183|\treturn TransactionPlan{}, map[string]any{\n184|\t\t\"materialization_intent\":  \"clone\",\n185|\t\t\"target_collision_policy\": \"must_be_absent\",\n186|\t\t\"activation\":              \"dormant_validated\",\n187|\t\t\"extensions\":              extensions,\n188|\t}, nil\n189|}\n190|\n191|// decodeTransactionPlan validates one closed TransactionPlan.\n192|func decodeTransactionPlan(raw json.RawMessage) (TransactionPlan, error) {\n193|\towner := \"transaction plan\"\n194|\tmembers, fault := decodeStrictObject(raw)\n195|\tif fault != nil {\n196|\t\treturn TransactionPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n197|\t}\n198|\tif name, unknown := unknownMember(members, transactionPlanMembers); unknown {\n199|\t\treturn TransactionPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n200|\t}\n201|\tif name, missing := missingMember(members, transactionPlanRequired); missing {\n202|\t\treturn TransactionPlan{}, invalid(\"%s misses a required member %q\", owner, name)\n203|\t}\n204|\tintent, ok := rawString(members[\"materialization_intent\"])\n205|\tif !ok || intent != \"clone\" {\n206|\t\treturn TransactionPlan{}, invalid(\"%s materialization_intent is not clone\", owner)\n207|\t}\n208|\tpolicy, ok := rawString(members[\"target_collision_policy\"])\n209|\tif !ok || policy != \"must_be_absent\" {\n210|\t\treturn TransactionPlan{}, invalid(\"%s target_collision_policy is not must_be_absent\", owner)\n211|\t}\n212|\tactivation, ok := rawString(members[\"activation\"])\n213|\tif !ok || activation != \"dormant_validated\" {\n214|\t\treturn TransactionPlan{}, invalid(\"%s activation is not dormant_validated\", owner)\n215|\t}\n216|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n217|\t\treturn TransactionPlan{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n218|\t}\n219|\treturn TransactionPlan{}, nil\n220|}\n221|\n222|// checkReadBackModes validates the closed modes constant\n223|// [staged,live]: exactly two elements in exactly that order.\n224|func checkReadBackModes(modes []string) error {\n225|\tif len(modes) != 2 || modes[0] != \"staged\" || modes[1] != \"live\" {\n226|\t\treturn invalid(\"read-back plan modes are not [staged,live]\")\n227|\t}\n228|\treturn nil\n229|}\n230|\n231|// buildReadBackPlan validates one caller-supplied read-back plan\n232|// and renders its closed object: modes=[staged,live] with all three\n233|// require flags true.\n234|func buildReadBackPlan(input ReadBackPlanInput) (ReadBackPlan, map[string]any, error) {\n235|\towner := \"read-back plan\"\n236|\tfor _, mode := range input.Modes {\n237|\t\tif !validText(mode) {\n238|\t\t\treturn ReadBackPlan{}, nil, invalid(\"%s modes carry a member that is not valid UTF-8\", owner)\n239|\t\t}\n240|\t}\n241|\tif err := checkReadBackModes(input.Modes); err != nil {\n242|\t\treturn ReadBackPlan{}, nil, err\n243|\t}\n244|\t