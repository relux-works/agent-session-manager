t = validPlanInput()\n582|\t\trollback = input.RollbackPlan\n583|\t\trollback.ForbiddenAfterProviderCommit = false\n584|\t\tinput.RollbackPlan = rollback\n585|\t\t_, err = cloneplan.BuildProjectionPlan(input)\n586|\t\trequireRefusal(t, err, \"rollback plan\", \"forbidden_after_provider_commit is not true\")\n587|\t\tsealed := mustBuildPlan(t, validPlanInput())\n588|\t\tdocument := decodeDocument(t, sealed)\n589|\t\tdocument[\"rollback_plan\"].(map[string]any)[\"required\"] = false\n590|\t\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n591|\t\trequireRefusal(t, err, \"rollback plan\", \"required is not true\")\n592|\t\tdocument = decodeDocument(t, sealed)\n593|\t\tdocument[\"rollback_plan\"].(map[string]any)[\"retain_through\"] = \"prepared\"\n594|\t\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n595|\t\trequireRefusal(t, err, \"rollback plan\", \"retain_through is not live_validated\")\n596|\t\tdocument = decodeDocument(t, sealed)\n597|\t\tdocument[\"rollback_plan\"].(map[string]any)[\"retain_through\"] = \"live_validated2\"\n598|\t\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n599|\t\trequireRefusal(t, err, \"rollback plan\", \"retain_through is not live_validated\")\n600|\t\tdocument = decodeDocument(t, sealed)\n601|\t\tdocument[\"rollback_plan\"].(map[string]any)[\"forbidden_after_provider_commit\"] = false\n602|\t\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n603|\t\trequireRefusal(t, err, \"rollback plan\", \"forbidden_after_provider_commit is not true\")\n604|\t})\n605|}\n606|\n607|// TestContractSemver pins the SemVer version gate on both entries\n608|// with literal expectations independent of the environ grammar.\n609|func TestContractSemver(t *testing.T) {\n610|\tfor _, version := range []string{\"1.2.3\", \"0.0.0\", \"10.20.30\", \"1.0.0-alpha\", \"1.0.0+build.1\"} {\n611|\t\tinput := validPlanInput()\n612|\t\tcontract := input.RequiredContracts[0]\n613|\t\tcontract.Version = version\n614|\t\tinput.RequiredContracts = []cloneplan.ContractRequirementInput{contract}\n615|\t\tsealed := mustBuildPlan(t, input)\n616|\t\tmustDecodePlan(t, sealed)\n617|\t}\n618|\tfor _, version := range []string{\"\", \"1.2\", \"1.2.3.4\", \"v1.2.3\", \"1.2.x\", \"latest\", \"1.02.3\"} {\n619|\t\tinput := validPlanInput()\n620|\t\tcontract := input.RequiredContracts[0]\n621|\t\tcontract.Version = version\n622|\t\tinput.RequiredContracts = []cloneplan.ContractRequirementInput{contract}\n623|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n624|\t\trequireRefusal(t, err, \"contract requirement[0]\", \"version is not a SemVer\")\n625|\t\tsealed := mustBuildPlan(t, validPlanInput())\n626|\t\tdocument := decodeDocument(t, sealed)\n627|\t\tdocument[\"required_contracts\"].([]any)[0].(map[string]any)[\"version\"] = version\n628|\t\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n629|\t\trequireRefusal(t, err, \"contract requirement[0]\", \"version is not a SemVer\")\n630|\t}\n631|}\n632|\n633|// TestContractNoExtensions pins that ContractRequirement carries no\n634|// extensions member: the pinned text states exactly contract_id and\n635|// version.\n636|func TestContractNoExtensions(t *testing.T) {\n637|\tsealed := mustBuildPlan(t, validPlanInput())\n638|\tdocument := decodeDocument(t, sealed)\n639|\tdocument[\"required_contracts\"].([]any)[0].(map[string]any)[\"extensions\"] = map[string]any{}\n640|\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n641|\trequireRefusal(t, err, \"contract requirement[0]\", \"unknown member\", \"extensions\")\n642|}\n643|\n644|// TestRequiredDispositions pins the exact-policy map: non-empty,\n645|// values sorted unique 1..7 dispositions, on both entries.\n646|func TestRequiredDispositions(t *testing.T) {\n647|\tinput := validPlanInput()\n648|\tinput.RequiredDispositions = map[string][]string{}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
