+		"create_directory",
+		"write_blob",
+		"write_native_record",
+		"rebuild_index",
+	}
+	if len(cloneplan.OperationActions()) != 4 {
+		t.Fatalf("OperationActions count = %d, want 4", len(cloneplan.OperationActions()))
+	}
+	for _, action := range admit {
