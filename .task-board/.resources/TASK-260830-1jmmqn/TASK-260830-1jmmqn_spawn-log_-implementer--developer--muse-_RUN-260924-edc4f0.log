{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c801","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":603,"recorded_at":1780531400001201,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"task_stream":{"kind":"task","id":"01a0d128-c964-77a2-9837-dd7b9733590b"},"task_id":"01a0d128-c964-77a2-9837-dd7b9733590b","event":{"kind":"output","task_id":"01a0d128-c964-77a2-9837-dd7b9733590b","chunk":"Read text file `internal/cloneplan/utf8_reflection_test.go`.\n(119 line(s) above)\n120|\t\tif cloneplan.ValidPlanStrategy(bad) {\n121|\t\t\tt.Fatalf(\"ValidPlanStrategy(%q) = true, want false\", bad)\n122|\t\t}\n123|\t\tif cloneplan.ValidPlanProfile(bad) {\n124|\t\t\tt.Fatalf(\"ValidPlanProfile(%q) = true, want false\", bad)\n125|\t\t}\n126|\t\tif cloneplan.ValidOperationAction(bad) {\n127|\t\t\tt.Fatalf(\"ValidOperationAction(%q) = true, want false\", bad)\n128|\t\t}\n129|\t\tif cloneplan.ValidSynthesizedPurpose(bad) {\n130|\t\t\tt.Fatalf(\"ValidSynthesizedPurpose(%q) = true, want false\", bad)\n131|\t\t}\n132|\t\tif cloneplan.ValidResourceKind(bad) {\n133|\t\t\tt.Fatalf(\"ValidResourceKind(%q) = true, want false\", bad)\n134|\t\t}\n135|\t}\n136|}\n137|\n138|func requireRefusalTokens(t *testing.T, err error, tokens ...string) {\n139|\tt.Helper()\n140|\tif err == nil {\n141|\t\tt.Fatalf(\"error = nil, want refusal containing %q\", tokens)\n142|\t}\n143|\tif !errors.Is(err, cloneplan.ErrInvalid) {\n144|\t\tt.Fatalf(\"error = %v, want errors.Is ErrInvalid\", err)\n145|\t}\n146|\tfor _, token := range tokens {\n147|\t\tif !strings.Contains(err.Error(), token) {\n148|\t\t\tt.Fatalf(\"error = %q, want literal %q\", err.Error(), token)\n149|\t\t}\n150|\t}\n151|}\n152|\n153|// derivePlanUTF8Members walks both input types by reflection and\n154|// returns the sorted set of string-carrying member IDs. Any field\n155|// the walker cannot classify fails the test: the set grows loudly,\n156|// it never shrinks silently.\n157|func derivePlanUTF8Members(t *testing.T) []string {\n158|\tt.Helper()\n159|\tvar members []string\n160|\twalkPlanUTF8Fields(t, reflect.TypeOf(cloneplan.ProjectionPlanInput{}), \"plan\", &members)\n161|\twalkPlanUTF8Fields(t, reflect.TypeOf(cloneplan.ProjectedManifestInput{}), \"manifest\", &members)\n162|\tsort.Strings(members)\n163|\tseen := map[string]bool{}\n164|\tfor _, member := range members {\n165|\t\tif seen[member] {\n166|\t\t\tt.Fatalf(\"derived member %q twice\", member)\n167|\t\t}\n168|\t\tseen[member] = true\n169|\t}\n170|\tif len(members) == 0 {\n171|\t\tt.Fatal(\"derived UTF-8 member set is empty\")\n172|\t}\n173|\treturn members\n174|}\n175|\n176|func walkPlanUTF8Fields(t *testing.T, typ reflect.Type, path string, out *[]string) {\n177|\tt.Helper()\n178|\tfor index := 0; index < typ.NumField(); index++ {\n179|\t\tfield := typ.Field(index)\n180|\t\twalkPlanUTF8Field(t, field, path+\".\"+field.Name, out)\n181|\t}\n182|}\n183|\n184|func walkPlanUTF8Field(t *testing.T, field reflect.StructField, path string, out *[]string) {\n185|\tt.Helper()\n186|\tif field.PkgPath != \"\" {\n187|\t\tt.Fatalf(\"unexported field at %s: extend the walker before probing it\", path)\n188|\t}\n189|\temit := func(id string) { *out = append(*out, id) }\n190|\tfieldType := field.Type\n191|\tswitch fieldType.Kind() {\n192|\tcase reflect.String:\n193|\t\temit(path)\n194|\tcase reflect.Pointer:\n195|\t\tswitch fieldType.Elem().Kind() {\n196|\t\tcase reflect.String:\n197|\t\t\temit(path)\n198|\t\tcase reflect.Uint64:\n199|\t\t\t// Numeric optionals carry no strings.\n200|\t\tdefault:\n201|\t\t\tt.Fatalf(\"unhandled pointer at %s: extend the walker\", path)\n202|\t\t}\n203|\tcase reflect.Slice, reflect.Array:\n204|\t\telement := fieldType.Elem()\n205|\t\tswitch element.Kind() {\n206|\t\tcase reflect.Uint8:\n207|\t\t\temit(path)\n208|\t\tcase reflect.String:\n209|\t\t\temit(path + \"[]\")\n210|\t\tcase reflect.Uint64:\n211|\t\t\t// Numeric arrays carry no strings.\n212|\t\tcase reflect.Struct:\n213|\t\t\tfor index := 0; index < element.NumField(); index++ {\n214|\t\t\t\tsub := element.Field(index)\n215|\t\t\t\twalkPlanUTF8Field(t, sub, path+\"[].\"+sub.Name, out)\n216|\t\t\t}\n217|\t\tdefault:\n218|\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s: extend the walker\", element.Kind(), path)\n219|\t\t}\n220|\tcase reflect.Map:\n221|\t\tif fieldType.Key().Kind() != reflect.String {\n222|\t\t\tt.Fatalf(\"unhandled map key kind %s at %s: extend the walker\", fieldType.Key().Kind(), path)\n223|\t\t}\n224|\t\tvalue := fieldType.Elem()\n225|\t\tswitch value.Kind() {\n226|\t\tcase reflect.Slice:\n227|\t\t\tif value.Elem().Kind() != reflect.String {\n228|\t\t\t\tt.Fatalf(\"unhandled map slice element kind %s at %s: extend the walker\", value.Elem().Kind(), path)\n229|\t\t\t}\n230|\t\t\temit(path + \"<key>\")\n231|\t\t\temit(path + \"[]\")\n232|\t\tcase reflect.Interface:\n233|\t\t\tif value.NumMethod() != 0 {\n234|\t\t\t\tt.Fatalf(\"unhandled map interface at %s: extend the walker\", path)\n235|\t\t\t}\n236|\t\t\temit(path + \"<key>\")\n237|\t\t\temit(path + \"<value>\")\n238|\t\tdefault:\n239|\t\t\tt.Fatalf(\"unhandled map value kind %s at %s: extend the walker\", value.Kind(), path)\n240|\t\t}\n241|\tcase reflect.Struct:\n242|\t\twalkPlanUTF8Fields(t, fieldType, path, out)\n243|\tcase reflect.Bool,\n244|\t\treflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,\n245|\t\treflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64,\n246|\t\treflect.Float32, reflect.Float64:\n247|\t\t// Scalar non-text fields carry no strings.\n248|\tdefault:\n249|\t\tt.Fatalf(\"unhandled kind %s at %s: extend the walker\", fieldType.Kind(), path)\n250|\t}\n251|}\n252|\n253|// utf8PlanProbe drives one derived member at both entries:\n254|// buildRefuses plants the bad string in a fresh baseline input and\n255|// asserts the member-specific refusal; anchor/value locate the\n256|// sealed bytes to splice for the decode plant.\n257|type utf8PlanProbe struct {\n258|\tmanifest     bool\n259|\tbuildRefuses func(t *testing.T, bad string)\n260|\tanchor       []byte\n261|\tvalue        []byte\n262|}\n263|\n264|func utf8TaggedTuple(envID, platform, seed string) string {\n265|\treturn `{\"environment_id\":\"` + envID + `\",\"environment_version\":\"2.1.0\",\"platform\":\"` +\n266|\t\tplatform + `\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":\"` +\n267|\t\tfixtureDigest(seed) + `\",\"adapter_version\":\"1.2.3\"}`\n268|}\n269|\n270|// utf8PlanBaseline is the valid plan every grid cell starts from:\n271|// every probed value is unique within the sealed document so every\n272|// decode anchor pins its member.\n273|func utf8PlanBaseline(t *testing.T) cloneplan.ProjectionPlanInput {\n274|\tt.Helper()\n275|\tinput := validPlanInput()\n276|\tinput.SourceEnvironment = []byte(utf8TaggedTuple(\"test.env.utf8source\", \"linux\", \"utf8-source-fingerprint\"))\n277|\tinput.TargetEnvironment = []byte(utf8TaggedTuple(\"test.env.utf8target\", \"macos\", \"utf8-target-fingerprint\"))\n278|\tinput.ExpectedTargetNativeSession = \"utf8-target-native\"\n279|\tinput.CanonicalEventIDs = []string{fixtureDigest(\"utf8-ev\")}\n280|\tinput.RequiredDispositions = map[string][]string{\"utf8dispositionclass\": {\"exact\"}}\n281|\tinput.ForbidReasons = []string{\"utf8forbid\"}\n282|\tmapping := validMappingInput(\"utf8-mapping\")\n283|\tmapping.CanonicalObjectID = strptr(fixtureDigest(\"canonical-utf8-mapping\"))\n284|\tmapping.TargetResourceKey = []string{\"utf8/mapping\"}\n285|\tmapping.ReasonCodes = []string{\"unknown_native_event\"}\n286|\tmapping.Extensions = map[string]any{\"com.example.utf8mapping\": \"utf8mappingvalue\"}\n287|\tinput.ItemMappings = []cloneplan.ItemMappingInput{mapping}\n288|\toperation := validOperationInput(1)\n289|\toperation.ResourceKeys = []string{\"utf8/operation\"}\n290|\toperation.Extensions = map[string]any{\"com.example.utf8operation\": \"utf8operationvalue\"}\n291|\tinput.TargetOperations = []cloneplan.TargetOperationInput{operation}\n292|\tresource := validResourceInput(1, \"utf8-resource\")\n293|\tresource.ExpectedBlobID = strptr(fixtureDigest(\"blob-utf8-resource\"))\n294|\tresource.Extensions = map[string]any{\"com.example.utf8resource\": \"utf8resourcevalue\"}\n295|\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{resource}\n296|\tevent := validSynthEventInput(\"utf8\")\n297|\tevent.Extensions = map[string]any{\"com.example.utf8event\": \"utf8eventvalue\"}\n298|\tinput.SynthesizedEvents = []cloneplan.SynthesizedEventInput{event}\n299|\tinput.SecurityExclusions = []string{\"credential\"}\n300|\tcontract := validContractInput(\"ax.contract.utf8\")\n301|\tcontract.Version = \"7.8.9\"\n302|\tinput.RequiredContracts = []cloneplan.ContractRequirementInput{contract}\n303|\tinput.RequiredCapabilities = []string{\"utf8.capability\"}\n304|\tinput.Extensions = map[string]any{\"com.example.utf8plan\": \"utf8planvalue\"}\n305|\treturn input\n306|}\n307|\n308|func utf8ManifestBaseline(t *testing.T) cloneplan.ProjectedManifestInput {\n309|\tt.Helper()\n310|\tmanifest := validManifestInput()\n311|\tmanifest.TargetEnvironment = []byte(utf8TaggedTuple(\"test.env.utf8manifest\", \"windows\", \"utf8-manifest-fingerprint\"))\n312|\tmanifest.ExpectedTargetNativeSession = \"utf8-manifest-native\"\n313|\tdirectory := validDirectoryEntryInput(1, \"utf8-adir\")\n314|\tblob := validBlobEntryInput(1, \"utf8-bblob\")\n315|\tblob.BlobID = strptr(fixtureDigest(\"blob-utf8-bblob\"))\n316|\tblob.BlobDescriptorID = strptr(fixtureDigest(\"descriptor-utf8-bblob\"))\n317|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory, blob}\n318|\tmanifest.Extensions = map[string]any{\"com.example.utf8manifest\": \"utf8manifestvalue\"}\n319|\treturn manifest\n320|}\n321|\n322|func planUTF8Probes(t *testing.T) (map[string]utf8PlanProbe, map[string]utf8PlanProbe) {\n323|\tt.Helper()\n324|\tplan := map[string]utf8PlanProbe{}\n325|\tmanifest := map[string]utf8PlanProbe{}\n326|\tbaseline := utf8PlanBaseline(t)\n327|\t_ = baseline\n328|\n329|\tstrField := func(path, member, token string, set func(*cloneplan.ProjectionPlanInput, string), anchor, value string) {\n330|\t\tplan[path] = utf8PlanProbe{\n331|\t\t\tbuildRefuses: func(t *testing.T, bad string) {\n332|\t\t\t\tinput := utf8PlanBaseline(t)\n333|\t\t\t\tset(&input, bad)\n334|\t\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n335|\t\t\t\trequireRefusalTokens(t, err, token)\n336|\t\t\t},\n337|\t\t\tanchor: []byte(anchor),\n338|\t\t\tvalue:  []byte(value),\n339|\t\t}\n340|\t\t_ = member\n341|\t}\n342|\t_ = strField\n343|\n344|\t// Scalar plan members.\n345|\tscalars := []struct {\n346|\t\tpath, member, token, anchor, value string\n347|\t\tset                                func(*cloneplan.ProjectionPlanInput, string)\n348|\t}{\n349|\t\t{\"plan.OperationID\", \"operation_id\", \"operation_id is not a UUIDv7\",\n350|\t\t\t`\"operation_id\":\"` + fixtureOperationID + `\"`, fixtureOperationID,\n351|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.OperationID = bad }},\n352|\t\t{\"plan.BundleID\", \"bundle_id\", \"bundle_id is not a UUIDv7\",\n353|\t\t\t`\"bundle_id\":\"` + fixtureBundleID + `\"`, fixtureBundleID,\n354|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.BundleID = bad }},\n355|\t\t{\"plan.RequestDigest\", \"request_digest\", \"request_digest is not a digest\",\n356|\t\t\t`\"request_digest\":\"` + fixtureDigest(\"request\") + `\"`, fixtureDigest(\"request\"),\n357|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.RequestDigest = bad }},\n358|\t\t{\"plan.SourceSnapshotDigest\", \"source_snapshot_digest\", \"source_snapshot_digest is not a digest\",\n359|\t\t\t`\"source_snapshot_digest\":\"` + fixtureDigest(\"snapshot\") + `\"`, fixtureDigest(\"snapshot\"),\n360|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.SourceSnapshotDigest = bad }},\n361|\t\t{\"plan.CaptureManifestID\", \"capture_manifest_id\", \"capture_manifest_id is not a digest\",\n362|\t\t\t`\"capture_manifest_id\":\"` + fixtureDigest(\"capture\") + `\"`, fixtureDigest(\"capture\"),\n363|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.CaptureManifestID = bad }},\n364|\t\t{\"plan.CanonicalSessionID\", \"canonical_session_id\", \"canonical_session_id is not a digest\",\n365|\t\t\t`\"canonical_session_id\":\"` + fixtureDigest(\"canonical\") + `\"`, fixtureDigest(\"canonical\"),\n366|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.CanonicalSessionID = bad }},\n367|\t\t{\"plan.CanonicalEventIDs[]\", \"canonical_event_ids\", \"canonical_event_ids[0] is not a digest\",\n368|\t\t\t`\"canonical_event_ids\":[\"` + fixtureDigest(\"utf8-ev\") + `\"]`, fixtureDigest(\"utf8-ev\"),\n369|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.CanonicalEventIDs = []string{bad} }},\n370|\t\t{\"plan.ExpectedTargetNativeSession\", \"expected_target_native_session_id\", \"expected_target_native_session_id is not valid UTF-8\",\n371|\t\t\t`\"expected_target_native_session_id\":\"utf8-target-native\"`, \"utf8-target-native\",\n372|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.ExpectedTargetNativeSession = bad }},\n373|\t\t{\"plan.Strategy\", \"strategy\", \"strategy is not valid UTF-8\",\n374|\t\t\t`\"strategy\":\"target_native_writer\"`, \"target_native_writer\",\n375|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.Strategy = bad }},\n376|\t\t{\"plan.StrategyRationale\", \"strategy_rationale\", \"strategy_rationale is not valid UTF-8\",\n377|\t\t\t`\"strategy_rationale\":\"native writer covers the target tuple\"`, \"native writer covers the target tuple\",\n378|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.StrategyRationale = bad }},\n379|\t\t{\"plan.FidelityProfile\", \"fidelity_profile\", \"fidelity_profile is not valid UTF-8\",\n380|\t\t\t`\"fidelity_profile\":\"maximal_safe\"`, \"maximal_safe\",\n381|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.FidelityProfile = bad }},\n382|\t\t{\"plan.RequiredDispositions<key>\", \"required_dispositions\", \"carry a class that is not valid UTF-8\",\n383|\t\t\t`\"required_dispositions\":{\"utf8dispositionclass\":[\"exact\"]}`, \"utf8dispositionclass\",\n384|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) {\n385|\t\t\t\tinput.RequiredDispositions = map[string][]string{bad: {\"exact\"}}\n386|\t\t\t}},\n387|\t\t{\"plan.RequiredDispositions[]\", \"required_dispositions\", \"is not valid UTF-8\",\n388|\t\t\t`\"required_dispositions\":{\"utf8dispositionclass\":[\"exact\"]}`, `\"exact\"`,\n389|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) {\n390|\t\t\t\tinput.RequiredDispositions = map[string][]string{\"utf8dispositionclass\": {bad}}\n391|\t\t\t}},\n392|\t\t{\"plan.ForbidReasons[]\", \"forbid_reasons\", \"forbid_reasons[0] is not valid UTF-8\",\n393|\t\t\t`\"forbid_reasons\":[\"utf8forbid\"]`, \"utf8forbid\",\n394|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.ForbidReasons = []string{bad} }},\n395|\t\t{\"plan.SecurityExclusions[]\", \"security_exclusions\", \"security_exclusions[0] is not valid UTF-8\",\n396|\t\t\t`\"security_exclusions\":[\"credential\"]`, \"credential\",\n397|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.SecurityExclusions = []string{bad} }},\n398|\t\t{\"plan.RequiredCapabilities[]\", \"required_capabilities\", \"required_capabilities[0] is not valid UTF-8\",\n399|\t\t\t`\"required_capabilities\":[\"utf8.capability\"]`, \"utf8.capability\",\n400|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.RequiredCapabilities = []string{bad} }},\n401|\t\t{\"p