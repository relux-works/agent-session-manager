{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e1","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":459,"recorded_at":1780531400000913,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"task_stream":{"kind":"task","id":"01a0d128-12c3-72e1-bf7a-381cbcfb3beb"},"task_id":"01a0d128-12c3-72e1-bf7a-381cbcfb3beb","event":{"kind":"output","task_id":"01a0d128-12c3-72e1-bf7a-381cbcfb3beb","chunk":"Read text file `internal/cloneplan/nullability_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n7|)\n8|\n9|// TestResourceNullabilityGrid sweeps the full kind x mode-presence x\n10|// blob-presence grid for ExpectedTargetResource through both\n11|// entries against the independent branch oracle: blob rows carry a\n12|// non-null expected_blob_id, directory rows carry null, and mode\n13|// keeps its nullable uint32[0..4095] type on both branches.\n14|func TestResourceNullabilityGrid(t *testing.T) {\n15|\tkinds := []string{\"blob\", \"directory\"}\n16|\tmodes := []struct {\n17|\t\tlabel string\n18|\t\tvalue *uint64\n19|\t}{\n20|\t\t{\"null\", nil},\n21|\t\t{\"zero\", u64ptr(0)},\n22|\t\t{\"max\", u64ptr(4095)},\n23|\t}\n24|\tblobs := []struct {\n25|\t\tlabel   string\n26|\t\tpresent bool\n27|\t}{\n28|\t\t{\"null\", false},\n29|\t\t{\"digest\", true},\n30|\t}\n31|\toracle := func(kind string, blobPresent bool) bool {\n32|\t\tif kind == \"blob\" {\n33|\t\t\treturn blobPresent\n34|\t\t}\n35|\t\treturn !blobPresent\n36|\t}\n37|\tadmitted := 0\n38|\tfor _, kind := range kinds {\n39|\t\tfor _, mode := range modes {\n40|\t\t\tfor _, blob := range blobs {\n41|\t\t\t\twant := oracle(kind, blob.present)\n42|\t\t\t\tinput := validPlanInput()\n43|\t\t\t\tresource := validResourceInput(1, \"grid\")\n44|\t\t\t\tresource.Kind = kind\n45|\t\t\t\tresource.Mode = mode.value\n46|\t\t\t\tif blob.present {\n47|\t\t\t\t\tresource.ExpectedBlobID = strptr(fixtureDigest(\"grid-blob\"))\n48|\t\t\t\t} else {\n49|\t\t\t\t\tresource.ExpectedBlobID = nil\n50|\t\t\t\t}\n51|\t\t\t\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{resource}\n52|\t\t\t\tsealed, buildErr := cloneplan.BuildProjectionPlan(input)\n53|\t\t\t\tif (buildErr == nil) != want {\n54|\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: build admits = %v, oracle = %v (err=%v)\",\n55|\t\t\t\t\t\tkind, mode.label, blob.label, buildErr == nil, want, buildErr)\n56|\t\t\t\t}\n57|\t\t\t\tif want {\n58|\t\t\t\t\t// Admit cells decode the fresh seal: the\n59|\t\t\t\t\t// branch gate and the digest both pass.\n60|\t\t\t\t\tplan, decodeErr := cloneplan.DecodeProjectionPlan(sealed)\n61|\t\t\t\t\tif decodeErr != nil {\n62|\t\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: fresh seal refused: %v\",\n63|\t\t\t\t\t\t\tkind, mode.label, blob.label, decodeErr)\n64|\t\t\t\t\t} else if len(plan.ExpectedResources) != 1 {\n65|\t\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: resources = %d, want 1\",\n66|\t\t\t\t\t\t\tkind, mode.label, blob.label, len(plan.ExpectedResources))\n67|\t\t\t\t\t}\n68|\t\t\t\t\tadmitted++\n69|\t\t\t\t\tcontinue\n70|\t\t\t\t}\n71|\t\t\t\t// Refuse cells mutate a sealed shape-valid\n72|\t\t\t\t// baseline: the branch gate fires before the\n73|\t\t\t\t// self-digest, so the branch literal proves\n74|\t\t\t\t// the gate measured.\n75|\t\t\t\tbase := validPlanInput()\n76|\t\t\t\tbaseResource := validResourceInput(1, \"grid\")\n77|\t\t\t\tif kind == \"directory\" {\n78|\t\t\t\t\tbaseResource = validDirectoryResourceInput(1, \"grid\")\n79|\t\t\t\t}\n80|\t\t\t\tbase.ExpectedResources = []cloneplan.ExpectedResourceInput{baseResource}\n81|\t\t\t\tbaseline := mustBuildPlan(t, base)\n82|\t\t\t\tdocument := decodeDocument(t, baseline)\n83|\t\t\t\trow := document[\"expected_resources\"].([]any)[0].(map[string]any)\n84|\t\t\t\tif mode.value == nil {\n85|\t\t\t\t\trow[\"mode\"] = nil\n86|\t\t\t\t} else {\n87|\t\t\t\t\trow[\"mode\"] = float64(*mode.value)\n88|\t\t\t\t}\n89|\t\t\t\tif blob.present {\n90|\t\t\t\t\trow[\"expected_blob_id\"] = fixtureDigest(\"grid-blob\")\n91|\t\t\t\t} else {\n92|\t\t\t\t\trow[\"expected_blob_id\"] = nil\n93|\t\t\t\t}\n94|\t\t\t\t_, decodeErr := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n95|\t\t\t\tif decodeErr == nil {\n96|\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: decode admits, oracle refuses\",\n97|\t\t\t\t\t\tkind, mode.label, blob.label)\n98|\t\t\t\t} else {\n99|\t\t\t\t\trequireRefusal(t, decodeErr, \"expected target resource[0]\", \"expected_blob_id\")\n100|\t\t\t\t}\n101|\t\t\t}\n102|\t\t}\n103|\t}\n104|\t// 2 kinds x 3 modes x 2 blob states = 12 cells; 6 admit.\n105|\tif admitted != 6 {\n106|\t\tt.Fatalf(\"admitted cells = %d, want 6\", admitted)\n107|\t}\n108|}\n109|\n110|// TestResourceBranchLiterals pins the branch refusal literals on\n111|// both entries.\n112|func TestResourceBranchLiterals(t *testing.T) {\n113|\tinput := validPlanInput()\n114|\tblob := validResourceInput(1, \"branch-blob\")\n115|\tblob.ExpectedBlobID = nil\n116|\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{blob}\n117|\t_, err := cloneplan.BuildProjectionPlan(input)\n118|\trequireRefusal(t, err, \"expected target resource[0]\", \"expected_blob_id is null for blob\")\n119|\n120|\tinput = validPlanInput()\n121|\tdirectory := validDirectoryResourceInput(1, \"branch-dir\")\n122|\tdirectory.ExpectedBlobID = strptr(fixtureDigest(\"branch-blob\"))\n123|\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{directory}\n124|\t_, err = cloneplan.BuildProjectionPlan(input)\n125|\trequireRefusal(t, err, \"expected target resource[0]\", \"expected_blob_id is not null for directory\")\n126|\n127|\tsealed := mustBuildPlan(t, validPlanInput())\n128|\tdocument := decodeDocument(t, sealed)\n129|\tdocument[\"expected_resources\"].([]any)[0].(map[string]any)[\"expected_blob_id\"] = nil\n130|\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n131|\trequireRefusal(t, err, \"expected target resource[0]\", \"expected_blob_id is null for blob\")\n132|}\n133|\n134|// TestEntryNullabilityGrid sweeps the full kind x mode-presence x\n135|// blob-member-presence grid for ProjectedObjectEntry through both\n136|// entries: blob entries carry byte_count, blob_id, and\n137|// blob_descriptor_id; directory entries carry none of the three;\n138|// mode stays nullable on both branches.\n139|func TestEntryNullabilityGrid(t *testing.T) {\n140|\tmodes := []struct {\n141|\t\tlabel string\n142|\t\tvalue *uint64\n143|\t}{\n144|\t\t{\"null\", nil},\n145|\t\t{\"zero\", u64ptr(0)},\n146|\t\t{\"max\", u64ptr(4095)},\n147|\t}\n148|\t// blobMembers toggles the three blob-only members together on\n149|\t// build; decode additionally sweeps each member missing alone.\n150|\tadmitted := 0\n151|\tfor _, kind := range []string{\"blob\", \"directory\"} {\n152|\t\tfor _, mode := range modes {\n153|\t\t\tfor _, blobPresent := range []bool{false, true} {\n154|\t\t\t\twant := (kind == \"blob\") == blobPresent\n155|\t\t\t\tentry := validBlobEntryInput(1, \"grid\")\n156|\t\t\t\tentry.Kind = kind\n157|\t\t\t\tentry.Mode = mode.value\n158|\t\t\t\tif !blobPresent {\n159|\t\t\t\t\tentry.ByteCount = nil\n160|\t\t\t\t\tentry.BlobID = nil\n161|\t\t\t\t\tentry.BlobDescriptorID = nil\n162|\t\t\t\t}\n163|\t\t\t\tmanifest := validManifestInput()\n164|\t\t\t\tmanifest.Entries = []cloneplan.ProjectedEntryInput{entry}\n165|\t\t\t\t_, buildErr := cloneplan.BuildProjectedObjectManifest(manifest)\n166|\t\t\t\tif (buildErr == nil) != want {\n167|\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%v: build admits = %v, oracle = %v (err=%v)\",\n168|\t\t\t\t\t\tkind, mode.label, blobPresent, buildErr == nil, want, buildErr)\n169|\t\t\t\t}\n170|\t\t\t\tif want {\n171|\t\t\t\t\tadmitted++\n172|\t\t\t\t}\n173|\t\t\t}\n174|\t\t}\n175|\t}\n176|\t// 2 kinds x 3 modes x 2 blob states = 12 cells; 6 admit.\n177|\tif admitted != 6 {\n178|\t\tt.Fatalf(\"admitted build cells = %d, want 6\", admitted)\n179|\t}\n180|}\n181|\n182|// TestEntryDecodeBranchGrid sweeps the decode side member by\n183|// member: each blob-only member missing alone refuses on blob, and\n184|// each blob-only member present alone refuses on directory.\n185|func TestEntryDecodeBranchGrid(t *testing.T) {\n186|\tblobOnly := []string{\"byte_count\", \"blob_id\", \"blob_descriptor_id\"}\n187|\t// Blob baseline: entries[1]; directory baseline: entries[0].\n188|\tsealed := mustBuildManifest(t, validManifestInput())\n189|\tfor _, member := range blobOnly {\n190|\t\tdocument := decodeDocument(t, sealed)\n191|\t\tdelete(document[\"entries\"].([]any)[1].(map[string]any), member)\n192|\t\t_, err := cloneplan.DecodeProjectedObjectManifest(marshalDocument(t, document))\n193|\t\trequireRefusal(t, err, \"projected object entry[1]\", member)\n194|\t}\n195|\tfor _, member := range blobOnly {\n196|\t\tdocument := decodeDocument(t, sealed)\n197|\t\trow := document[\"entries\"].([]any)[0].(map[string]any)\n198|\t\tswitch member {\n199|\t\tcase \"byte_count\":\n200|\t\t\trow[member] = float64(8)\n201|\t\tdefault:\n202|\t\t\trow[member] = fixtureDigest(\"stray-\" + member)\n203|\t\t}\n204|\t\t_, err := cloneplan.DecodeProjectedObjectManifest(marshalDocument(t, document))\n205|\t\trequireRefusal(t, err, \"projected object entry[0]\", member)\n206|\t}\n207|\t// Mode nullability admits on both branches: fresh seal plus\n208|\t// decode per cell (mutating sealed bytes would trip the\n209|\t// self-digest instead of measuring the mode gate).\n210|\tmodes := []*uint64{nil, u64ptr(0), u64ptr(4095)}\n211|\tfor _, mode := range modes {\n212|\t\tmanifest := validManifestInput()\n213|\t\tdirectory := validDirectoryEntryInput(1, \"a-admit\")\n214|\t\tdirectory.Mode = mode\n215|\t\tblob := validBlobEntryInput(1, \"b-admit\")\n216|\t\tblob.Mode = mode\n217|\t\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory, blob}\n218|\t\tsealed := mustBuildManifest(t, manifest)\n219|\t\tdecoded := mustDecodeManifest(t, sealed)\n220|\t\tif len(decoded.Entries) != 2 {\n221|\t\t\tt.Fatalf(\"mode=%v: entries = %d, want 2\", mode, len(decoded.Entries))\n222|\t\t}\n223|\t}\n224|}\n225|\n226|// TestEntryBranchLiterals pins the build-side branch refusal\n227|// literals for each blob-only member on each branch.\n228|func TestEntryBranchLiterals(t *testing.T) {\n229|\tblob := validBlobEntryInput(1, \"branch\")\n230|\tblob.ByteCount = nil\n231|\tmanifest := validManifestInput()\n232|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{blob}\n233|\t_, err := cloneplan.BuildProjectedObjectManifest(manifest)\n234|\trequireRefusal(t, err, \"projected object entry[0]\", \"byte_count is missing for blob\")\n235|\n236|\tblob = validBlobEntryInput(1, \"branch\")\n237|\tblob.BlobID = nil\n238|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{blob}\n239|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n240|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_id is missing for blob\")\n241|\n242|\tblob = validBlobEntryInput(1, \"branch\")\n243|\tblob.BlobDescriptorID = nil\n244|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{blob}\n245|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n246|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_descriptor_id is missing for blob\")\n247|\n248|\tdirectory := validDirectoryEntryInput(1, \"branch\")\n249|\tdirectory.ByteCount = u64ptr(8)\n250|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory}\n251|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n252|\trequireRefusal(t, err, \"projected object entry[0]\", \"byte_count is present for directory\")\n253|\n254|\tdirectory = validDirectoryEntryInput(1, \"branch\")\n255|\tdirectory.BlobID = strptr(fixtureDigest(\"stray\"))\n256|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory}\n257|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n258|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_id is present for directory\")\n259|\n260|\tdirectory = validDirectoryEntryInput(1, \"branch\")\n261|\tdirectory.BlobDescriptorID = strptr(fixtureDigest(\"stray\"))\n262|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory}\n263|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n264|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_descriptor_id is present for directory\")\n265|}","final_result":true}}}
