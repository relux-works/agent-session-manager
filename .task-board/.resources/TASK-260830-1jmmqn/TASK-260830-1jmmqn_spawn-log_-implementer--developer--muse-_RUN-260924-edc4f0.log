ype found\\\"\\n    a, b = types[-1]\\n    typename = a or b\\n    label = {\\\"ItemMappingInput\\\":\\\"mapping\\\",\\\"TargetOperationInput\\\":\\\"operation\\\",\\\"ExpectedResourceInput\\\":\\\"resource\\\",\\\"SynthesizedEventInput\\\":\\\"event\\\",\\\"ProjectedManifestInput\\\":\\\"manifest\\\",\\\"ProjectedEntryInput\\\":\\\"entry\\\"}[typename]\\n    guard = ('\\\\t\\\\tif want := censusFieldCount(cloneplan.%s{}); len(cases) != want {\\\\n'\\n             '\\\\t\\\\t\\\\tt.Fatalf(\\\"%s zero cells = %%d, want reflected %%d\\\", len(cases), want)\\\\n\\\\t\\\\t}\\\\n') % (typename, label)\\n    out.append(src[pos:m.start()])\\n    out.append(guard)\\n    pos = m.start()\\nout.append(src[pos:])\\np.write_text(''.join(out))\\nprint(\\\"guards inserted:\\\", len(re.findall(r'censusFieldCount', p.read_text())) - 1)\\nEOF\\ngofmt -l internal/cloneplan/; grep -n \\\"zero cells = \\\" internal/cloneplan/zerovalue_test.go\",\n  \"description\": \"Insert reflection count guards in zero tables\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"guards inserted: 8\\n75:\\t\\tt.Fatalf(\\\"zero cells = %d, want reflected %d\\\", len(cells), want)\\n101:\\t\\tt.Fatalf(\\\"admitted zero cells = %d, want 6\\\", admitted)\\n123:\\t\\t\\tt.Fatalf(\\\"mapping zero cells = %d, want reflected %d\\\", len(cases), want)\\n154:\\t\\t\\tt.Fatalf(\\\"operation zero cells = %d, want reflected %d\\\", len(cases), want)\\n186:\\t\\t\\tt.Fatalf(\\\"resource zero cells = %d, want reflected %d\\\", len(cases), want)\\n216:\\t\\t\\tt.Fatalf(\\\"event zero cells = %d, want reflected %d\\\", len(cases), want)\\n268:\\t\\t\\tt.Fatalf(\\\"manifest zero cells = %d, want reflected %d\\\", len(cases), want)\\n301:\\t\\t\\tt.Fatalf(\\\"entry zero cells = %d, want reflected %d\\\", len(cases), want)\\n\",\n  \"original_output_bytes\": 630,\n  \"original_output_tokens\": 158,\n  \"truncated\": false\n}","final_result":true}}}
