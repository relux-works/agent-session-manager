{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c74d","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":513,"recorded_at":1780531400001021,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"task_stream":{"kind":"task","id":"01a0d128-2617-7292-a95a-6c13e35f26de"},"task_id":"01a0d128-2617-7292-a95a-6c13e35f26de","event":{"kind":"output","task_id":"01a0d128-2617-7292-a95a-6c13e35f26de","chunk":"Read text file `internal/cloneplan/manifest.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Clone Projected Object\n13|// Manifest 1.0.0: the closed 10-member manifest Section 13.14.2\n14|// states with its sorted entries partitioned by operation sequence.\n15|// Entries are branch-exact by kind: a blob carries mode, byte\n16|// count, blob ID, and blob descriptor ID; a directory carries only\n17|// mode. Entries partitioning Plan resources needs the plan as an\n18|// input and is a stated bound, as is total_bytes reconciliation:\n19|// the pinned text states no derivation rule for the total, so any\n20|// uint53 total admits.\n21|\n22|const (\n23|\tprojectedManifestSchema  = \"urn:ax:schema:clone-projected-object-manifest\"\n24|\tprojectedManifestVersion = \"1.0.0\"\n25|\tprojectedManifestSelf    = \"projected_object_manifest_id\"\n26|)\n27|\n28|var projectedManifestMembers = map[string]bool{\n29|\t\"schema\": true, \"schema_version\": true,\n30|\t\"projected_object_manifest_id\": true, \"operation_id\": true,\n31|\t\"projection_plan_id\": true, \"target_environment\": true,\n32|\t\"expected_target_native_session_id\": true,\n33|\t\"entries\":                           true, \"total_bytes\": true, \"extensions\": true,\n34|}\n35|\n36|var projectedManifestRequired = []string{\n37|\t\"schema\", \"schema_version\",\n38|\t\"projected_object_manifest_id\", \"operation_id\",\n39|\t\"projection_plan_id\", \"target_environment\",\n40|\t\"expected_target_native_session_id\",\n41|\t\"entries\", \"total_bytes\", \"extensions\",\n42|}\n43|\n44|var blobEntryMembers = map[string]bool{\n45|\t\"operation_sequence\": true,\n46|\t\"resource_key\":       true,\n47|\t\"kind\":               true,\n48|\t\"mode\":               true,\n49|\t\"byte_count\":         true,\n50|\t\"blob_id\":            true,\n51|\t\"blob_descriptor_id\": true,\n52|}\n53|\n54|var blobEntryRequired = []string{\n55|\t\"operation_sequence\",\n56|\t\"resource_key\",\n57|\t\"kind\",\n58|\t\"mode\",\n59|\t\"byte_count\",\n60|\t\"blob_id\",\n61|\t\"blob_descriptor_id\",\n62|}\n63|\n64|var directoryEntryMembers = map[string]bool{\n65|\t\"operation_sequence\": true,\n66|\t\"resource_key\":       true,\n67|\t\"kind\":               true,\n68|\t\"mode\":               true,\n69|}\n70|\n71|var directoryEntryRequired = []string{\n72|\t\"operation_sequence\",\n73|\t\"resource_key\",\n74|\t\"kind\",\n75|\t\"mode\",\n76|}\n77|\n78|// ProjectedEntry is one validated projected object entry. Blob\n79|// entries carry byte count and blob IDs; directory entries carry\n80|// only mode.\n81|type ProjectedEntry struct {\n82|\tOperationSequence uint64\n83|\tResourceKey       string\n84|\tKind              string\n85|\tMode              *uint64\n86|\tByteCount         *uint64\n87|\tBlobID            *scalar.Digest\n88|\tBlobDescriptorID  *scalar.Digest\n89|}\n90|\n91|// ProjectedEntryInput is the caller-supplied projected entry\n92|// candidate for Build. Nil Mode seals as null on both branches; the\n93|// blob-only members must be non-nil exactly for blob entries.\n94|type ProjectedEntryInput struct {\n95|\tOperationSequence uint64\n96|\tResourceKey       string\n97|\tKind              string\n98|\tMode              *uint64\n99|\tByteCount         *uint64\n100|\tBlobID            *string\n101|\tBlobDescriptorID  *string\n102|}\n103|\n104|// ProjectedManifest is one validated projected object manifest.\n105|type ProjectedManifest struct {\n106|\tManifestID                  scalar.Digest\n107|\tOperationID                 scalar.UUIDv7\n108|\tProjectionPlanID            scalar.Digest\n109|\tTargetEnvironment           sessadapter.Tuple\n110|\tExpectedTargetNativeSession string\n111|\tEntries                     []ProjectedEntry\n112|\tTotalBytes                  uint64\n113|}\n114|\n115|// ProjectedManifestInput is the caller-supplied projected manifest\n116|// candidate for Build.\n117|type ProjectedManifestInput struct {\n118|\tOperationID                 string\n119|\tProjectionPlanID            string\n120|\tTargetEnvironment           []byte\n121|\tExpectedTargetNativeSession string\n122|\tEntries                     []ProjectedEntryInput\n123|\tTotalBytes                  uint64\n124|\tExtensions                  map[string]any\n125|}\n126|\n127|// checkEntryBranch enforces branch-exact entry membership: blob\n128|// entries carry byte count and both blob IDs, directory entries\n129|// carry none of the three. Both entries share this gate.\n130|func checkEntryBranch(owner, kind string, hasCount, hasBlob, hasDescriptor bool) error {\n131|\tif kind == \"blob\" {\n132|\t\tif !hasCount {\n133|\t\t\treturn invalid(\"%s byte_count is missing for blob\", owner)\n134|\t\t}\n135|\t\tif !hasBlob {\n136|\t\t\treturn invalid(\"%s blob_id is missing for blob\", owner)\n137|\t\t}\n138|\t\tif !hasDescriptor {\n139|\t\t\treturn invalid(\"%s blob_descriptor_id is missing for blob\", owner)\n140|\t\t}\n141|\t\treturn nil\n142|\t}\n143|\tif hasCount {\n144|\t\treturn invalid(\"%s byte_count is present for directory\", owner)\n145|\t}\n146|\tif hasBlob {\n147|\t\treturn invalid(\"%s blob_id is present for directory\", owner)\n148|\t}\n149|\tif hasDescriptor {\n150|\t\treturn invalid(\"%s blob_descriptor_id is present for directory\", owner)\n151|\t}\n152|\treturn nil\n153|}\n154|\n155|// buildProjectedEntry validates one caller-supplied entry and\n156|// renders its closed object. The rendered member set is branch-exact:\n157|// seven members for blob, four for directory.\n158|func buildProjectedEntry(input ProjectedEntryInput, index int) (ProjectedEntry, map[string]any, error) {\n159|\towner := fmt.Sprintf(\"projected object entry[%d]\", index)\n160|\tif input.OperationSequence == 0 || input.OperationSequence > maxUint53 {\n161|\t\treturn ProjectedEntry{}, nil, invalid(\"%s operation_sequence is not a uint53>0\", owner)\n162|\t}\n163|\tif !validText(input.ResourceKey) {\n164|\t\treturn ProjectedEntry{}, nil, invalid(\"%s resource_key is not valid UTF-8\", owner)\n165|\t}\n166|\tif length := stringLength(input.ResourceKey); length < 1 || length > 512 {\n167|\t\treturn ProjectedEntry{}, nil, invalid(\"%s resource_key is not a string[1..512]\", owner)\n168|\t}\n169|\tif !validText(input.Kind) {\n170|\t\treturn ProjectedEntry{}, nil, invalid(\"%s kind is not valid UTF-8\", owner)\n171|\t}\n172|\tif !ValidResourceKind(input.Kind) {\n173|\t\treturn ProjectedEntry{}, nil, invalid(\"%s kind is outside blob|directory\", owner)\n174|\t}\n175|\tmode, modeValue, err := checkBuildMode(input.Mode, owner)\n176|\tif err != nil {\n177|\t\treturn ProjectedEntry{}, nil, err\n178|\t}\n179|\tif err := checkEntryBranch(owner, input.Kind, input.ByteCount != nil, input.BlobID != nil, input.BlobDescriptorID != nil); err != nil {\n180|\t\treturn ProjectedEntry{}, nil, err\n181|\t}\n182|\tobject := map[string]any{\n183|\t\t\"operation_sequence\": input.OperationSequence,\n184|\t\t\"resource_key\":       input.ResourceKey,\n185|\t\t\"kind\":               input.Kind,\n186|\t\t\"mode\":               modeValue,\n187|\t}\n188|\tentry := ProjectedEntry{\n189|\t\tOperationSequence: input.OperationSequence,\n190|\t\tResourceKey:       input.ResourceKey,\n191|\t\tKind:              input.Kind,\n192|\t\tMode:              mode,\n193|\t}\n194|\tif input.Kind == \"blob\" {\n195|\t\tif *input.ByteCount > maxUint53 {\n196|\t\t\treturn ProjectedEntry{}, nil, invalid(\"%s byte_count exceeds uint53\", owner)\n197|\t\t}\n198|\t\tcount := *input.ByteCount\n199|\t\tblob, err := scalar.ParseDigest(*input.BlobID)\n200|\t\tif err != nil {\n201|\t\t\treturn ProjectedEntry{}, nil, invalid(\"%s blob_id is not a digest: %v\", owner, err)\n202|\t\t}\n203|\t\tdescriptor, err := scalar.ParseDigest(*input.BlobDescriptorID)\n204|\t\tif err != nil {\n205|\t\t\treturn ProjectedEntry{}, nil, invalid(\"%s blob_descriptor_id is not a digest: %v\", owner, err)\n206|\t\t}\n207|\t\tentry.ByteCount = &count\n208|\t\tentry.BlobID = &blob\n209|\t\tentry.BlobDescriptorID = &descriptor\n210|\t\tobject[\"byte_count\"] = count\n211|\t\tobject[\"blob_id\"] = blob.String()\n212|\t\tobject[\"blob_descriptor_id\"] = descriptor.String()\n213|\t}\n214|\treturn entry, object, nil\n215|}\n216|\n217|// decodeProjectedEntry validates one closed ProjectedObjectEntry,\n218|// dispatching on kind to the branch-exact member set.\n219|func decodeProjectedEntry(raw json.RawMessage, index int) (ProjectedEntry, error) {\n220|\towner := \"projected object entry\"\n221|\tmembers, fault := decodeStrictObject(raw)\n222|\tif fault != nil {\n223|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n224|\t}\n225|\tkindMember, present := members[\"kind\"]\n226|\tif !present {\n227|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] misses a required member %q\", owner, index, \"kind\")\n228|\t}\n229|\tkind, ok := rawString(kindMember)\n230|\tif !ok || !ValidResourceKind(kind) {\n231|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] kind is outside blob|directory\", owner, index)\n232|\t}\n233|\tallowed, required := blobEntryMembers, blobEntryRequired\n234|\tif kind == \"directory\" {\n235|\t\tallowed, required = directoryEntryMembers, directoryEntryRequired\n236|\t}\n237|\tif name, unknown := unknownMember(members, allowed); unknown {\n238|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n239|\t}\n240|\tif name, missing := missingMember(members, required); missing {\n241|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n242|\t}\n243|\tsequence, ok := checkUint53Bounds(members[\"operation_sequence\"], 1, maxUint53)\n244|\tif !ok {\n245|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] operation_sequence is not a uint53>0\", owner, index)\n246|\t}\n247|\tkey, ok := checkStringBounds(members[\"resource_key\"], 1, 512)\n248|\tif !ok {\n249|\t\treturn ProjectedEntry{}, invalid(\"%s[%d] resource_key is not a string[1..512]\", owner, index)\n250|\t}\n251|\tvar mode *uint64\n252|\tif !isNull(members[\"mode\"]) {\n253|\t\tvalue, ok := checkUint53Bounds(members[\"mode\"], 0, maxMode)\n254|\t\tif !ok {\n255|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] mode is not a uint32[0..4095] or null\", owner, index)\n256|\t\t}\n257|\t\tmode = &value\n258|\t}\n259|\tentry := ProjectedEntry{\n260|\t\tOperationSequence: sequence,\n261|\t\tResourceKey:       key,\n262|\t\tKind:              kind,\n263|\t\tMode:              mode,\n264|\t}\n265|\tif kind == \"blob\" {\n266|\t\tcount, ok := checkUint53Bounds(members[\"byte_count\"], 0, maxUint53)\n267|\t\tif !ok {\n268|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] byte_count is not a uint53\", owner, index)\n269|\t\t}\n270|\t\tblob, ok := checkDigest(members[\"blob_id\"])\n271|\t\tif !ok {\n272|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] blob_id is not a digest\", owner, index)\n273|\t\t}\n274|\t\tdescriptor, ok := checkDigest(members[\"blob_descriptor_id\"])\n275|\t\tif !ok {\n276|\t\t\treturn ProjectedEntry{}, invalid(\"%s[%d] blob_descriptor_id is not a digest\", owner, index)\n277|\t\t}\n278|\t\tentry.ByteCount = &count\n279|\t\tentry.BlobID = &blob\n280|\t\tentry.BlobDescriptorID = &descriptor\n281|\t}\n282|\treturn entry, nil\n283|}\n284|\n285|// checkProjectedEntryOrder enforces \"sorted unique by operation\n286|// sequence/resource key\": the (sequence, key) pairs are strictly\n287|// increasing. Both entries share this gate over the sealed entry\n288|// set.\n289|func checkProjectedEntryOrder(entries []ProjectedEntry) error {\n290|\tfor index := 1; index < len(entries); index++ {\n291|\t\tprevious := entries[index-1]\n292|\t\tcurrent := entries[index]\n293|\t\tif current.OperationSequence < previous.OperationSequence ||\n294|\t\t\t(current.OperationSequence == previous.OperationSequence && current.ResourceKey <= previous.ResourceKey) {\n295|\t\t\treturn invalid(\"projected object manifest entries are not sorted unique by operation sequence/resource key\")\n296|\t\t}\n297|\t}\n298|\treturn nil\n299|}\n300|\n301|// checkProjectedEntryCount enforces the entries cardinality bound\n302|// ProjectedObjectEntry[0..65536]. The gate is factored so the exact\n303|// upper edge pins at the gate while entry reachability pins at both\n304|// entries.\n305|func checkProjectedEntryCount(count int) error {\n306|\tif count < 0 || count > 65536 {\n307|\t\treturn invalid(\"projected object manifest carries %d entries, want [0..65536]\", count)\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|// BuildProjectedObjectManifest constructs one closed Clone\n313|// Projected Object Manifest 1.0.0 as canonical bytes. Identical\n314|// inputs produce byte-identical outputs. Every closed-shape,\n315|// branch, order, and vocabulary rule is a refusal, never a repair.\n316|func BuildProjectedObjectManifest(input ProjectedManifestInput) ([]byte, error) {\n317|\t_, object, err := buildProjectedManifest(input)\n318|\tif err != nil {\n319|\t\treturn nil, err\n320|\t}\n321|\tomitted, err := canonicalizeObject(object)\n322|\tif err != nil {\n323|\t\treturn nil, err\n324|\t}\n325|\tmanifestID := scalar.SHA256Digest(omitted)\n326|\tobject[projectedManifestSelf] = manifestID.String()\n327|\treturn canonicalizeObject(object)\n328|}\n329|\n330|func buildProjectedManifest(input ProjectedManifestInput) (ProjectedManifest, map[string]any, error) {\n331|\towner := \"projected object manifest\"\n332|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n333|\tif err != nil {\n334|\t\treturn ProjectedManifest{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n335|\t}\n336|\tplanID, err := scalar.ParseDigest(input.ProjectionPlanID)\n337|\tif err != nil {\n338|\t\treturn ProjectedManifest{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n339|\t}\n340|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n341|\tif err != nil {\n342|\t\treturn ProjectedManifest{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n343|\t}\n344|\tif !validText(input.ExpectedTargetNativeSession) {\n345|\t\treturn ProjectedManifest{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n346|\t}\n347|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n348|\t\treturn ProjectedManifest{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n349|\t}\n350|\tif err := checkProjectedEntryCount(len(input.Entries)); err != nil {\n351|\t\treturn ProjectedManifest{}, nil, err\n352|\t}\n353|\tentries := make([]ProjectedEntry, 0, len(input.Entries))\n354|\tobjects := make([]any, 0, len(input.Entries))\n355|\tfor index, candidate := range input.Entries {\n356|\t\tentry, object, err := buildProjectedEntry(candidate, index)\n357|\t\tif err != nil {\n358|\t\t\treturn ProjectedManifest{}, nil, err\n359|\t\t}\n360|\t\tentries = append(entries, entry)\n361|\t\tobjects = append(objects, object)\n362|\t}\n363|\tif err := checkProjectedEntryOrder(entries); err != nil {\n364|\t\treturn ProjectedManifest{}, nil, err\n365|\t}\n366|\tif input.TotalBytes > maxUint53 {\n367|\t\treturn ProjectedManifest{}, nil, invalid(\"%s total_bytes exceeds uint53\", owner)\n368|\t}\n369|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n370|\t\treturn ProjectedManifest{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n371|\t}\n372|\textensions := input.Extensions\n373|\tif extensions == nil {\n374|\t\textensions = map[string]any{}\n375|\t}\n376|\tmanifest := ProjectedManifest{\n377|\t\tOperationID:                 operation,\n378|\t\tProjectionPlanID:            planID,\n379|\t\tTargetEnvironment:           targetTuple,\n380|\t\tExpectedTargetNativeSession: input.ExpectedTargetNativeSession,\n381|\t\tEntries:                     entries,\n382|\t\tTotalBytes:                  input.TotalBytes,\n383|\t}\n384|\tobject := map[string]any{\n385|\t\t\"schema\":                            projectedManifestSchema,\n386|\t\t\"schema_version\":                    projectedManifestVersion,\n387|\t\t\"operation_id\":                      operation.String(),\n388|\t\t\"projection_plan_id\":                planID.String(),\n389|\t\t\"target_environment\":                tupleObject(targetTuple),\n390|\t\t\"expected_target_native_session_id\": input.ExpectedTargetNativeSession,\n391|\t\t\"entries\":                           objects,\n392|\t\t\"total_bytes\":                       input.TotalBytes,\n393|\t\t\"extensions\":                        extensions,\n394|\t}\n395|\treturn manifest, object, nil\n396|}\n397|\n398|// DecodeProjectedObjectManifest validates one closed Clone\n399|// Projected Object Manifest 1.0.0: exact members, schema/version,\n400|// scalar bounds, branch-exact entries, entry order, and self-digest\n401|// agreement.\n402|func DecodeProjectedObjectManifest(data []byte) (ProjectedManifest, error) {\n403|\towner := \"projected object manifest\"\n404|\tmembers, fault := decodeStrictObject(data)\n405|\tif fault != nil {\n406|\t\treturn ProjectedManifest{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n407|\t}\n408|\tif name, unknown := unknownMember(members, projectedManifestMembers); unknown {\n409|\t\treturn ProjectedManifest{}, invalid(\"%s carries unknown member %q\", owner, name)\n410|\t}\n411|\tif name, missing := missingMember(members, projectedManifestRequired); missing {\n412|\t\treturn ProjectedManifest{}, invalid(\"%s misses a required member %q\", owner, name)\n413|\t}\n414|\tschema, ok := rawString(members[\"schema\"])\n415|\tif !ok || schema != projectedManifestSchema {\n416|\t\treturn ProjectedManifest{}, invalid(\"%s schema is not urn:ax:schema:clone-projected-object-manifest\", owner)\n417|\t}\n418|\tversion, ok := rawString(members[\"schema_version\"])\n419|\tif !ok || version != projectedManifestVersion {\n420|\t\treturn ProjectedManifest{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n421|\t}\n422|\tclaimed, ok := checkDigest(members[\"projected_object_manifest_id\"])\n423|\tif !ok {\n424|\t\treturn ProjectedManifest{}, invalid(\"%s projected_object_manifest_id is not a digest\", owner)\n425|\t}\n426|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n427|\tif !ok {\n428|\t\treturn ProjectedManifest{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n429|\t}\n430|\tplanID, ok := checkDigest(members[\"projection_plan_id\"])\n431|\tif !ok {\n432|\t\treturn ProjectedManifest{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n433|\t}\n434|\ttargetTuple, err := sessadapter.DecodeTuple(members[\"target_environment\"])\n435|\tif err != nil {\n436|\t\treturn ProjectedManifest{}, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n437|\t}\n438|\tnativeID, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n439|\tif !ok {\n440|\t\treturn ProjectedManifest{}, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n441|\t}\n442|\telements, ok := decodeArray(members[\"entries\"])\n443|\tif !ok {\n444|\t\treturn ProjectedManifest{}, invalid(\"%s entries is not an array\", owner)\n445|\t}\n446|\tif err := checkProjectedEntryCount(len(elements)); err != nil {\n447|\t\treturn ProjectedManifest{}, err\n448|\t}\n449|\tentries := make([]ProjectedEntry, 0, len(elements))\n450|\tfor index, element := range elements {\n451|\t\tentry, err := decodeProjectedEntry(element, index)\n452|\t\tif err != nil {\n453|\t\t\treturn ProjectedManifest{}, err\n454|\t\t}\n455|\t\tentries = append(entries, entry)\n456|\t}\n457|\tif err := checkProjectedEntryOrder(entries); err != nil {\n458|\t\treturn ProjectedManifest{}, err\n459|\t}\n460|\ttotal, ok := checkUint53Bounds(members[\"total_bytes\"], 0, maxUint53)\n461|\tif !ok {\n462|\t\treturn ProjectedManifest{}, invalid(\"%s total_bytes is not a uint53\", owner)\n463|\t}\n464|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n465|\t\treturn ProjectedManifest{}, invalid(\"%s extensions %s\", owner, extensionsFault)\n466|\t}\n467|\tif err := verifySelfDigest(members, projectedManifestSelf, claimed); err != nil {\n468|\t\treturn ProjectedManifest{}, err\n469|\t}\n470|\treturn ProjectedManifest{\n471|\t\tManifestID:                  claimed,\n472|\t\tOperationID:                 operation,\n473|\t\tProjectionPlanID:            planID,\n474|\t\tTargetEnvironment:           targetTuple,\n475|\t\tExpectedTargetNativeSession: nativeID,\n476|\t\tEntries:                     entries,\n477|\t\tTotalBytes:                  total,\n478|\t}, nil\n479|}","final_result":true}}}
