{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d7","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":710,"recorded_at":1780531400001415,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"task_stream":{"kind":"task","id":"01a0d12b-ce06-7033-8989-c6b9602f3843"},"task_id":"01a0d12b-ce06-7033-8989-c6b9602f3843","event":{"kind":"output","task_id":"01a0d12b-ce06-7033-8989-c6b9602f3843","chunk":"Read text file `internal/cloneplan/mapping.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// This file validates and constructs ProjectionItemMapping: the\n13|// closed per-item row Section 13.14.2 states. Unlike the fidelity\n14|// disposition row, the spec pins no coupling between\n15|// expected_disposition and reason_codes or canonical_object_id here,\n16|// so every combination of the shaped members admits.\n17|\n18|var itemMappingMembers = map[string]bool{\n19|\t\"source_item_key\":      true,\n20|\t\"canonical_object_id\":  true,\n21|\t\"target_resource_keys\": true,\n22|\t\"expected_disposition\": true,\n23|\t\"reason_codes\":         true,\n24|\t\"extensions\":           true,\n25|}\n26|\n27|var itemMappingRequired = []string{\n28|\t\"source_item_key\",\n29|\t\"canonical_object_id\",\n30|\t\"target_resource_keys\",\n31|\t\"expected_disposition\",\n32|\t\"reason_codes\",\n33|\t\"extensions\",\n34|}\n35|\n36|// ItemMapping is one validated projection item mapping.\n37|type ItemMapping struct {\n38|\tSourceItemKey     string\n39|\tCanonicalObjectID *scalar.Digest\n40|\tTargetResourceKey []string\n41|\tExpectedDispos    string\n42|\tReasonCodes       []string\n43|}\n44|\n45|// ItemMappingInput is the caller-supplied item mapping candidate\n46|// for Build. A nil CanonicalObjectID seals as null.\n47|type ItemMappingInput struct {\n48|\tSourceItemKey     string\n49|\tCanonicalObjectID *string\n50|\tTargetResourceKey []string\n51|\tExpectedDispos    string\n52|\tReasonCodes       []string\n53|\tExtensions        map[string]any\n54|}\n55|\n56|// buildItemMapping validates one caller-supplied mapping and\n57|// renders its closed object. Every rule is a refusal: broken\n58|// bounds, unsorted or duplicate arrays, unknown dispositions, and\n59|// out-of-vocabulary reasons are refused, never repaired.\n60|func buildItemMapping(input ItemMappingInput, index int) (ItemMapping, map[string]any, error) {\n61|\towner := fmt.Sprintf(\"projection item mapping[%d]\", index)\n62|\tif !validText(input.SourceItemKey) {\n63|\t\treturn ItemMapping{}, nil, invalid(\"%s source_item_key is not valid UTF-8\", owner)\n64|\t}\n65|\tif length := stringLength(input.SourceItemKey); length < 1 || length > 512 {\n66|\t\treturn ItemMapping{}, nil, invalid(\"%s source_item_key is not a string[1..512]\", owner)\n67|\t}\n68|\tvar canonical *scalar.Digest\n69|\tvar canonicalValue any\n70|\tif input.CanonicalObjectID != nil {\n71|\t\tid, err := scalar.ParseDigest(*input.CanonicalObjectID)\n72|\t\tif err != nil {\n73|\t\t\treturn ItemMapping{}, nil, invalid(\"%s canonical_object_id is not a digest: %v\", owner, err)\n74|\t\t}\n75|\t\tcanonical = &id\n76|\t\tcanonicalValue = id.String()\n77|\t}\n78|\tkeys, err := checkSortedUniqueBoundedStrings(input.TargetResourceKey, 1, 512, 0, 65536, owner, \"target_resource_keys\")\n79|\tif err != nil {\n80|\t\treturn ItemMapping{}, nil, err\n81|\t}\n82|\tif !validText(input.ExpectedDispos) {\n83|\t\treturn ItemMapping{}, nil, invalid(\"%s expected_disposition is not valid UTF-8\", owner)\n84|\t}\n85|\tif !clonefidelity.ValidDisposition(input.ExpectedDispos) {\n86|\t\treturn ItemMapping{}, nil, invalid(\"%s expected_disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner)\n87|\t}\n88|\treasons, err := checkSortedUniqueReasonStrings(input.ReasonCodes, 0, 128, owner)\n89|\tif err != nil {\n90|\t\treturn ItemMapping{}, nil, err\n91|\t}\n92|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n93|\t\treturn ItemMapping{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n94|\t}\n95|\textensions := input.Extensions\n96|\tif extensions == nil {\n97|\t\textensions = map[string]any{}\n98|\t}\n99|\treturn ItemMapping{\n100|\t\t\tSourceItemKey:     input.SourceItemKey,\n101|\t\t\tCanonicalObjectID: canonical,\n102|\t\t\tTargetResourceKey: keys,\n103|\t\t\tExpectedDispos:    input.ExpectedDispos,\n104|\t\t\tReasonCodes:       reasons,\n105|\t\t}, map[string]any{\n106|\t\t\t\"source_item_key\":      input.SourceItemKey,\n107|\t\t\t\"canonical_object_id\":  canonicalValue,\n108|\t\t\t\"target_resource_keys\": stringValues(keys),\n109|\t\t\t\"expected_disposition\": input.ExpectedDispos,\n110|\t\t\t\"reason_codes\":         stringValues(reasons),\n111|\t\t\t\"extensions\":           extensions,\n112|\t\t}, nil\n113|}\n114|\n115|// decodeItemMapping validates one closed ProjectionItemMapping.\n116|func decodeItemMapping(raw json.RawMessage, index int) (ItemMapping, error) {\n117|\towner := \"projection item mapping\"\n118|\tmembers, fault := decodeStrictObject(raw)\n119|\tif fault != nil {\n120|\t\treturn ItemMapping{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n121|\t}\n122|\tif name, unknown := unknownMember(members, itemMappingMembers); unknown {\n123|\t\treturn ItemMapping{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n124|\t}\n125|\tif name, missing := missingMember(members, itemMappingRequired); missing {\n126|\t\treturn ItemMapping{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n127|\t}\n128|\tkey, ok := checkStringBounds(members[\"source_item_key\"], 1, 512)\n129|\tif !ok {\n130|\t\treturn ItemMapping{}, invalid(\"%s[%d] source_item_key is not a string[1..512]\", owner, index)\n131|\t}\n132|\tvar canonical *scalar.Digest\n133|\tif !isNull(members[\"canonical_object_id\"]) {\n134|\t\tid, ok := checkDigest(members[\"canonical_object_id\"])\n135|\t\tif !ok {\n136|\t\t\treturn ItemMapping{}, invalid(\"%s[%d] canonical_object_id is not a digest or null\", owner, index)\n137|\t\t}\n138|\t\tcanonical = &id\n139|\t}\n140|\tkeys, ok := checkSortedUniqueStrings(members[\"target_resource_keys\"], 1, 512, 0, 65536)\n141|\tif !ok {\n142|\t\treturn ItemMapping{}, invalid(\"%s[%d] target_resource_keys are not sorted unique string[1..512][0..65536]\", owner, index)\n143|\t}\n144|\tdisposition, ok := rawString(members[\"expected_disposition\"])\n145|\tif !ok || !clonefidelity.ValidDisposition(disposition) {\n146|\t\treturn ItemMapping{}, invalid(\"%s[%d] expected_disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, index)\n147|\t}\n148|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n149|\tif !ok {\n150|\t\treturn ItemMapping{}, invalid(\"%s[%d] reason_codes are not sorted unique string[1..128][0..128]\", owner, index)\n151|\t}\n152|\tfor _, reason := range reasons {\n153|\t\tif !clonefidelity.ValidReasonCode(reason) {\n154|\t\t\treturn ItemMapping{}, invalid(\"%s[%d] reason_codes carry %q outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n155|\t\t}\n156|\t}\n157|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n158|\t\treturn ItemMapping{}, invalid(\"%s[%d] extensions %s\", owner, index, extensionsFault)\n159|\t}\n160|\treturn ItemMapping{\n161|\t\tSourceItemKey:     key,\n162|\t\tCanonicalObjectID: canonical,\n163|\t\tTargetResourceKey: keys,\n164|\t\tExpectedDispos:    disposition,\n165|\t\tReasonCodes:       reasons,\n166|\t}, nil\n167|}\n168|\n169|// checkMappingOrder enforces the plan prose \"ordered item mappings\":\n170|// mappings are sorted unique by source item key. Both entries share\n171|// this gate over the sealed row set.\n172|func checkMappingOrder(mappings []ItemMapping) error {\n173|\tfor index := 1; index < len(mappings); index++ {\n174|\t\tif mappings[index].SourceItemKey <= mappings[index-1].SourceItemKey {\n175|\t\t\treturn invalid(\"projection plan item_mappings are not sorted unique by source item key\")\n176|\t\t}\n177|\t}\n178|\treturn nil\n179|}\n180|\n181|// checkMappingCount enforces the item_mappings cardinality bound\n182|// ProjectionItemMapping[1..1000000]. The gate is factored so the\n183|// exact upper edge pins at the gate while entry reachability pins\n184|// at both entries.\n185|func checkMappingCount(count int) error {\n186|\tif count < 1 || count > 1000000 {\n187|\t\treturn invalid(\"projection plan carries %d item_mappings, want [1..1000000]\", count)\n188|\t}\n189|\treturn nil\n190|}","final_result":true}}}
