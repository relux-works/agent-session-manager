{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e9","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":463,"recorded_at":1780531400000921,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"call_id":"call_01a0d1280db3775985184d79ef04db21","text":"Read text file `internal/cloneplan/dag_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"testing\"\n6|\n7|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n8|)\n9|\n10|// dagOracleVerdict is the independent DAG rule retyped from the\n11|// spec sentence \"Dependencies are lower sequences and form a DAG\":\n12|// sequences strictly increase, and every dependency names a\n13|// strictly lower sequence present in the set. Strict decrease along\n14|// every edge admits no cycle and no self-edge, so the oracle needs\n15|// no separate cycle walk: any cycle would cross a non-decreasing\n16|// edge.\n17|func dagOracleVerdict(sequences []uint64, depends [][]uint64) bool {\n18|\tfor index := 1; index < len(sequences); index++ {\n19|\t\tif sequences[index] <= sequences[index-1] {\n20|\t\t\treturn false\n21|\t\t}\n22|\t}\n23|\tpresent := make(map[uint64]bool, len(sequences))\n24|\tfor _, sequence := range sequences {\n25|\t\tpresent[sequence] = true\n26|\t}\n27|\tfor index, sequence := range sequences {\n28|\t\tfor _, dependency := range depends[index] {\n29|\t\t\tif dependency >= sequence || !present[dependency] {\n30|\t\t\t\treturn false\n31|\t\t\t}\n32|\t\t}\n33|\t}\n34|\treturn true\n35|}\n36|\n37|func dagInput(sequences []uint64, depends [][]uint64) cloneplan.ProjectionPlanInput {\n38|\tinput := validPlanInput()\n39|\toperations := make([]cloneplan.TargetOperationInput, 0, len(sequences))\n40|\tfor index, sequence := range sequences {\n41|\t\toperation := validOperationInput(sequence, depends[index]...)\n42|\t\toperation.ResourceKeys = []string{fmt.Sprintf(\"res/%d\", sequence)}\n43|\t\toperations = append(operations, operation)\n44|\t}\n45|\tinput.TargetOperations = operations\n46|\treturn input\n47|}\n48|\n49|func dagVerdict(t *testing.T, sequences []uint64, depends [][]uint64) (bool, bool) {\n50|\tt.Helper()\n51|\tinput := dagInput(sequences, depends)\n52|\t_, buildErr := cloneplan.BuildProjectionPlan(input)\n53|\tbuildAdmits := buildErr == nil\n54|\tvar decodeAdmits bool\n55|\tif buildAdmits {\n56|\t\tsealed, err := cloneplan.BuildProjectionPlan(input)\n57|\t\tif err != nil {\n58|\t\t\tt.Fatalf(\"rebuild: %v\", err)\n59|\t\t}\n60|\t\t_, decodeErr := cloneplan.DecodeProjectionPlan(sealed)\n61|\t\tdecodeAdmits = decodeErr == nil\n62|\t} else {\n63|\t\t// A build refusal still reaches decode through a\n64|\t\t// hand-assembled document only when the shape is\n65|\t\t// otherwise valid; dependency violations are shape-valid\n66|\t\t// except for the DAG rule, so decode must refuse them\n67|\t\t// too. Documents that fail earlier gates are out of\n68|\t\t// scope for this sweep: every swept graph is\n69|\t\t// shape-valid by construction.\n70|\t\tdecodeAdmits = decodeAdmitsHandBuilt(t, sequences, depends)\n71|\t}\n72|\treturn buildAdmits, decodeAdmits\n73|}\n74|\n75|// decodeAdmitsHandBuilt assembles a sealed-shape document with the\n76|// given operations by mutating a valid sealed plan, so decode-side\n77|// verdicts are measured even for graphs build refuses.\n78|func decodeAdmitsHandBuilt(t *testing.T, sequences []uint64, depends [][]uint64) bool {\n79|\tt.Helper()\n80|\tbase := validPlanInput()\n81|\toperations := make([]cloneplan.TargetOperationInput, 0, len(sequences))\n82|\tfor _, sequence := range sequences {\n83|\t\toperation := validOperationInput(sequence)\n84|\t\toperation.ResourceKeys = []string{fmt.Sprintf(\"res/%d\", sequence)}\n85|\t\toperations = append(operations, operation)\n86|\t}\n87|\tbase.TargetOperations = operations\n88|\tsealed := mustBuildPlan(t, base)\n89|\tdocument := decodeDocument(t, sealed)\n90|\t// Sequences in the swept graphs are contiguous from 1, so\n91|\t// hand-editing dependencies preserves shape validity.\n92|\trows := document[\"target_operations\"].([]any)\n93|\tfor index := range rows {\n94|\t\tedges := make([]any, 0, len(depends[index]))\n95|\t\tfor _, dependency := range depends[index] {\n96|\t\t\tedges = append(edges, float64(dependency))\n97|\t\t}\n98|\t\trows[index].(map[string]any)[\"depends_on_sequences\"] = edges\n99|\t}\n100|\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n101|\t// A DAG refusal is the expected decode verdict for invalid\n102|\t// graphs; any refusal counts as non-admission here because the\n103|\t// document is shape-valid except for the swept edges.\n104|\treturn err == nil\n105|}\n106|\n107|// TestDAGExhaustiveSmall enumerates EVERY dependency graph over up\n108|// to 3 operations (all 2^(n^2) edge sets, valid and invalid) and\n109|// asserts both production entries agree with the independent oracle\n110|// on every graph.\n111|func TestDAGExhaustiveSmall(t *testing.T) {\n112|\tfor n := 1; n <= 3; n++ {\n113|\t\tsequences := make([]uint64, 0, n)\n114|\t\tfor sequence := uint64(1); sequence <= uint64(n); sequence++ {\n115|\t\t\tsequences = append(sequences, sequence)\n116|\t\t}\n117|\t\ttotal := 1 << (n * n)\n118|\t\tadmitted := 0\n119|\t\tfor mask := 0; mask < total; mask++ {\n120|\t\t\tdepends := make([][]uint64, n)\n121|\t\t\tfor target := 0; target < n; target++ {\n122|\t\t\t\tfor source := 0; source < n; source++ {\n123|\t\t\t\t\tbit := target*n + source\n124|\t\t\t\t\tif mask&(1<<bit) != 0 {\n125|\t\t\t\t\t\t// Edge stored sorted: sources ascend,\n126|\t\t\t\t\t\t// so the shape gate never fires here.\n127|\t\t\t\t\t\tdepends[target] = append(depends[target], uint64(source+1))\n128|\t\t\t\t\t}\n129|\t\t\t\t}\n130|\t\t\t}\n131|\t\t\twant := dagOracleVerdict(sequences, depends)\n132|\t\t\tbuildAdmits, decodeAdmits := dagVerdict(t, sequences, depends)\n133|\t\t\tif buildAdmits != want {\n134|\t\t\t\tt.Errorf(\"n=%d mask=%b: build admits = %v, oracle = %v (depends=%v)\", n, mask, buildAdmits, want, depends)\n135|\t\t\t}\n136|\t\t\tif decodeAdmits != want {\n137|\t\t\t\tt.Errorf(\"n=%d mask=%b: decode admits = %v, oracle = %v (depends=%v)\", n, mask, decodeAdmits, want, depends)\n138|\t\t\t}\n139|\t\t\tif want {\n140|\t\t\t\tadmitted++\n141|\t\t\t}\n142|\t\t}\n143|\t\tt.Logf(\"n=%d: %d of %d graphs admitted\", n, total, admitted)\n144|\t}\n145|}\n146|\n147|// TestDAGValidEnumeration admits every valid DAG over 4 and 5\n148|// operations: all 2^(n(n-1)/2) strictly-lower edge sets through\n149|// both entries.\n150|func TestDAGValidEnumeration(t *testing.T) {\n151|\tfor _, n := range []int{4, 5} {\n152|\t\tsequences := make([]uint64, 0, n)\n153|\t\tfor sequence := uint64(1); sequence <= uint64(n); sequence++ {\n154|\t\t\tsequences = append(sequences, sequence)\n155|\t\t}\n156|\t\t// Lower-triangular edge slots: (target, source) with\n157|\t\t// source < target.\n158|\t\tvar slots [][2]int\n159|\t\tfor target := 0; target < n; target++ {\n160|\t\t\tfor source := 0; source < target; source++ {\n161|\t\t\t\tslots = append(slots, [2]int{target, source})\n162|\t\t\t}\n163|\t\t}\n164|\t\ttotal := 1 << len(slots)\n165|\t\tfor mask := 0; mask < total; mask++ {\n166|\t\t\tdepends := make([][]uint64, n)\n167|\t\t\tfor slot, edge := range slots {\n168|\t\t\t\tif mask&(1<<slot) != 0 {\n169|\t\t\t\t\tdepends[edge[0]] = append(depends[edge[0]], uint64(edge[1]+1))\n170|\t\t\t\t}\n171|\t\t\t}\n172|\t\t\tif !dagOracleVerdict(sequences, depends) {\n173|\t\t\t\tt.Fatalf(\"n=%d mask=%b: swept graph is not a valid DAG: the sweep is wrong\", n, mask)\n174|\t\t\t}\n175|\t\t\tbuildAdmits, decodeAdmits := dagVerdict(t, sequences, depends)\n176|\t\t\tif !buildAdmits || !decodeAdmits {\n177|\t\t\t\tt.Errorf(\"n=%d mask=%b: valid DAG refused (build=%v decode=%v)\", n, mask, buildAdmits, decodeAdmits)\n178|\t\t\t}\n179|\t\t}\n180|\t\tt.Logf(\"n=%d: %d valid DAGs admitted\", n, total)\n181|\t}\n182|}\n183|\n184|// TestDAGRefusalLiterals pins the refusal literals for each invalid\n185|// edge class through the production entries: higher, equal,\n186|// self-edge, dangling-lower, duplicate sequence, and unordered\n187|// sequences.\n188|func TestDAGRefusalLiterals(t *testing.T) {\n189|\tt.Run(\"higher\", func(t *testing.T) {\n190|\t\tinput := dagInput([]uint64{1, 2}, [][]uint64{{2}, {}})\n191|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n192|\t\trequireRefusal(t, err, \"target operation 1\", \"depends on sequence 2\", \"want a lower sequence\")\n193|\t})\n194|\tt.Run(\"self\", func(t *testing.T) {\n195|\t\tinput := dagInput([]uint64{1, 2}, [][]uint64{{}, {2}})\n196|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n197|\t\trequireRefusal(t, err, \"target operation 2\", \"depends on sequence 2\", \"want a lower sequence\")\n198|\t})\n199|\tt.Run(\"dangling\", func(t *testing.T) {\n200|\t\t// Non-contiguous sequences: 2 is lower than 3 but no\n201|\t\t// operation carries it.\n202|\t\tinput := dagInput([]uint64{1, 3}, [][]uint64{{}, {2}})\n203|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n204|\t\trequireRefusal(t, err, \"target operation 3\", \"depends on absent sequence 2\")\n205|\t})\n206|\tt.Run(\"duplicate-sequence\", func(t *testing.T) {\n207|\t\tinput := dagInput([]uint64{1, 1}, [][]uint64{{}, {}})\n208|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n209|\t\trequireRefusal(t, err, \"target_operations\", \"not ordered by sequence\")\n210|\t})\n211|\tt.Run(\"unordered\", func(t *testing.T) {\n212|\t\tinput := dagInput([]uint64{2, 1}, [][]uint64{{}, {}})\n213|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n214|\t\trequireRefusal(t, err, \"target_operations\", \"not ordered by sequence\")\n215|\t})\n216|\tt.Run(\"decode-higher\", func(t *testing.T) {\n217|\t\tsealed := mustBuildPlan(t, dagInput([]uint64{1, 2}, [][]uint64{{}, {}}))\n218|\t\tdocument := decodeDocument(t, sealed)\n219|\t\trows := document[\"target_operations\"].([]any)\n220|\t\trows[0].(map[string]any)[\"depends_on_sequences\"] = []any{float64(2)}\n221|\t\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n222|\t\trequireRefusal(t, err, \"target operation 1\", \"depends on sequence 2\", \"want a lower sequence\")\n223|\t})\n224|\tt.Run(\"decode-dangling\", func(t *testing.T) {\n225|\t\tsealed := mustBuildPlan(t, dagInput([]uint64{1, 3}, [][]uint64{{}, {}}))\n226|\t\tdocument := decodeDocument(t, sealed)\n227|\t\trows := document[\"target_operations\"].([]any)\n228|\t\trows[1].(map[string]any)[\"depends_on_sequences\"] = []any{float64(2)}\n229|\t\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n230|\t\trequireRefusal(t, err, \"target operation 3\", \"depends on absent sequence 2\")\n231|\t})\n232|\tt.Run(\"cycle-is-higher\", func(t *testing.T) {\n233|\t\t// A two-cycle 1->2->1 needs the non-decreasing edge\n234|\t\t// 1->2, which the lower-sequence rule refuses.\n235|\t\tinput := dagInput([]uint64{1, 2}, [][]uint64{{2}, {1}})\n236|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n237|\t\trequireRefusal(t, err, \"want a lower sequence\")\n238|\t})\n239|}\n240|\n241|// TestDAGNonContiguousValid pins that gaps in the sequence space\n242|// admit: only strictly-lower presence matters, not contiguity.\n243|func TestDAGNonContiguousValid(t *testing.T) {\n244|\tinput := dagInput([]uint64{1, 5, 9}, [][]uint64{{}, {1}, {1, 5}})\n245|\tsealed := mustBuildPlan(t, input)\n246|\tplan := mustDecodePlan(t, sealed)\n247|\tif len(plan.TargetOperations) != 3 {\n248|\t\tt.Fatalf(\"operations = %d, want 3\", len(plan.TargetOperations))\n249|\t}\n250|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6eb","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":464,"recorded_at":1780531400000923,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"call_id":"call_01a0d1280ec3772ba328726df4e34a6c","text":"Read text file `internal/cloneplan/nullability_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n7|)\n8|\n9|// TestResourceNullabilityGrid sweeps the full kind x mode-presence x\n10|// blob-presence grid for ExpectedTargetResource through both\n11|// entries against the independent branch oracle: blob rows carry a\n12|// non-null expected_blob_id, directory rows carry null, and mode\n13|// keeps its nullable uint32[0..4095] type on both branches.\n14|func TestResourceNullabilityGrid(t *testing.T) {\n15|\tkinds := []string{\"blob\", \"directory\"}\n16|\tmodes := []struct {\n17|\t\tlabel string\n18|\t\tvalue *uint64\n19|\t}{\n20|\t\t{\"null\", nil},\n21|\t\t{\"zero\", u64ptr(0)},\n22|\t\t{\"max\", u64ptr(4095)},\n23|\t}\n24|\tblobs := []struct {\n25|\t\tlabel   string\n26|\t\tpresent bool\n27|\t}{\n28|\t\t{\"null\", false},\n29|\t\t{\"digest\", true},\n30|\t}\n31|\toracle := func(kind string, blobPresent bool) bool {\n32|\t\tif kind == \"blob\" {\n33|\t\t\treturn blobPresent\n34|\t\t}\n35|\t\treturn !blobPresent\n36|\t}\n37|\tadmitted := 0\n38|\tfor _, kind := range kinds {\n39|\t\tfor _, mode := range modes {\n40|\t\t\tfor _, blob := range blobs {\n41|\t\t\t\twant := oracle(kind, blob.present)\n42|\t\t\t\tinput := validPlanInput()\n43|\t\t\t\tresource := validResourceInput(1, \"grid\")\n44|\t\t\t\tresource.Kind = kind\n45|\t\t\t\tresource.Mode = mode.value\n46|\t\t\t\tif blob.present {\n47|\t\t\t\t\tresource.ExpectedBlobID = strptr(fixtureDigest(\"grid-blob\"))\n48|\t\t\t\t} else {\n49|\t\t\t\t\tresource.ExpectedBlobID = nil\n50|\t\t\t\t}\n51|\t\t\t\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{resource}\n52|\t\t\t\tsealed, buildErr := cloneplan.BuildProjectionPlan(input)\n53|\t\t\t\tif (buildErr == nil) != want {\n54|\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: build admits = %v, oracle = %v (err=%v)\",\n55|\t\t\t\t\t\tkind, mode.label, blob.label, buildErr == nil, want, buildErr)\n56|\t\t\t\t}\n57|\t\t\t\tif want {\n58|\t\t\t\t\t// Admit cells decode the fresh seal: the\n59|\t\t\t\t\t// branch gate and the digest both pass.\n60|\t\t\t\t\tplan, decodeErr := cloneplan.DecodeProjectionPlan(sealed)\n61|\t\t\t\t\tif decodeErr != nil {\n62|\t\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: fresh seal refused: %v\",\n63|\t\t\t\t\t\t\tkind, mode.label, blob.label, decodeErr)\n64|\t\t\t\t\t} else if len(plan.ExpectedResources) != 1 {\n65|\t\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: resources = %d, want 1\",\n66|\t\t\t\t\t\t\tkind, mode.label, blob.label, len(plan.ExpectedResources))\n67|\t\t\t\t\t}\n68|\t\t\t\t\tadmitted++\n69|\t\t\t\t\tcontinue\n70|\t\t\t\t}\n71|\t\t\t\t// Refuse cells mutate a sealed shape-valid\n72|\t\t\t\t// baseline: the branch gate fires before the\n73|\t\t\t\t// self-digest, so the branch literal proves\n74|\t\t\t\t// the gate measured.\n75|\t\t\t\tbase := validPlanInput()\n76|\t\t\t\tbaseResource := validResourceInput(1, \"grid\")\n77|\t\t\t\tif kind == \"directory\" {\n78|\t\t\t\t\tbaseResource = validDirectoryResourceInput(1, \"grid\")\n79|\t\t\t\t}\n80|\t\t\t\tbase.ExpectedResources = []cloneplan.ExpectedResourceInput{baseResource}\n81|\t\t\t\tbaseline := mustBuildPlan(t, base)\n82|\t\t\t\tdocument := decodeDocument(t, baseline)\n83|\t\t\t\trow := document[\"expected_resources\"].([]any)[0].(map[string]any)\n84|\t\t\t\tif mode.value == nil {\n85|\t\t\t\t\trow[\"mode\"] = nil\n86|\t\t\t\t} else {\n87|\t\t\t\t\trow[\"mode\"] = float64(*mode.value)\n88|\t\t\t\t}\n89|\t\t\t\tif blob.present {\n90|\t\t\t\t\trow[\"expected_blob_id\"] = fixtureDigest(\"grid-blob\")\n91|\t\t\t\t} else {\n92|\t\t\t\t\trow[\"expected_blob_id\"] = nil\n93|\t\t\t\t}\n94|\t\t\t\t_, decodeErr := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n95|\t\t\t\tif decodeErr == nil {\n96|\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%s: decode admits, oracle refuses\",\n97|\t\t\t\t\t\tkind, mode.label, blob.label)\n98|\t\t\t\t} else {\n99|\t\t\t\t\trequireRefusal(t, decodeErr, \"expected target resource[0]\", \"expected_blob_id\")\n100|\t\t\t\t}\n101|\t\t\t}\n102|\t\t}\n103|\t}\n104|\t// 2 kinds x 3 modes x 2 blob states = 12 cells; 6 admit.\n105|\tif admitted != 6 {\n106|\t\tt.Fatalf(\"admitted cells = %d, want 6\", admitted)\n107|\t}\n108|}\n109|\n110|// TestResourceBranchLiterals pins the branch refusal literals on\n111|// both entries.\n112|func TestResourceBranchLiterals(t *testing.T) {\n113|\tinput := validPlanInput()\n114|\tblob := validResourceInput(1, \"branch-blob\")\n115|\tblob.ExpectedBlobID = nil\n116|\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{blob}\n117|\t_, err := cloneplan.BuildProjectionPlan(input)\n118|\trequireRefusal(t, err, \"expected target resource[0]\", \"expected_blob_id is null for blob\")\n119|\n120|\tinput = validPlanInput()\n121|\tdirectory := validDirectoryResourceInput(1, \"branch-dir\")\n122|\tdirectory.ExpectedBlobID = strptr(fixtureDigest(\"branch-blob\"))\n123|\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{directory}\n124|\t_, err = cloneplan.BuildProjectionPlan(input)\n125|\trequireRefusal(t, err, \"expected target resource[0]\", \"expected_blob_id is not null for directory\")\n126|\n127|\tsealed := mustBuildPlan(t, validPlanInput())\n128|\tdocument := decodeDocument(t, sealed)\n129|\tdocument[\"expected_resources\"].([]any)[0].(map[string]any)[\"expected_blob_id\"] = nil\n130|\t_, err = cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n131|\trequireRefusal(t, err, \"expected target resource[0]\", \"expected_blob_id is null for blob\")\n132|}\n133|\n134|// TestEntryNullabilityGrid sweeps the full kind x mode-presence x\n135|// blob-member-presence grid for ProjectedObjectEntry through both\n136|// entries: blob entries carry byte_count, blob_id, and\n137|// blob_descriptor_id; directory entries carry none of the three;\n138|// mode stays nullable on both branches.\n139|func TestEntryNullabilityGrid(t *testing.T) {\n140|\tmodes := []struct {\n141|\t\tlabel string\n142|\t\tvalue *uint64\n143|\t}{\n144|\t\t{\"null\", nil},\n145|\t\t{\"zero\", u64ptr(0)},\n146|\t\t{\"max\", u64ptr(4095)},\n147|\t}\n148|\t// blobMembers toggles the three blob-only members together on\n149|\t// build; decode additionally sweeps each member missing alone.\n150|\tadmitted := 0\n151|\tfor _, kind := range []string{\"blob\", \"directory\"} {\n152|\t\tfor _, mode := range modes {\n153|\t\t\tfor _, blobPresent := range []bool{false, true} {\n154|\t\t\t\twant := (kind == \"blob\") == blobPresent\n155|\t\t\t\tentry := validBlobEntryInput(1, \"grid\")\n156|\t\t\t\tentry.Kind = kind\n157|\t\t\t\tentry.Mode = mode.value\n158|\t\t\t\tif !blobPresent {\n159|\t\t\t\t\tentry.ByteCount = nil\n160|\t\t\t\t\tentry.BlobID = nil\n161|\t\t\t\t\tentry.BlobDescriptorID = nil\n162|\t\t\t\t}\n163|\t\t\t\tmanifest := validManifestInput()\n164|\t\t\t\tmanifest.Entries = []cloneplan.ProjectedEntryInput{entry}\n165|\t\t\t\t_, buildErr := cloneplan.BuildProjectedObjectManifest(manifest)\n166|\t\t\t\tif (buildErr == nil) != want {\n167|\t\t\t\t\tt.Errorf(\"kind=%s mode=%s blob=%v: build admits = %v, oracle = %v (err=%v)\",\n168|\t\t\t\t\t\tkind, mode.label, blobPresent, buildErr == nil, want, buildErr)\n169|\t\t\t\t}\n170|\t\t\t\tif want {\n171|\t\t\t\t\tadmitted++\n172|\t\t\t\t}\n173|\t\t\t}\n174|\t\t}\n175|\t}\n176|\t// 2 kinds x 3 modes x 2 blob states = 12 cells; 6 admit.\n177|\tif admitted != 6 {\n178|\t\tt.Fatalf(\"admitted build cells = %d, want 6\", admitted)\n179|\t}\n180|}\n181|\n182|// TestEntryDecodeBranchGrid sweeps the decode side member by\n183|// member: each blob-only member missing alone refuses on blob, and\n184|// each blob-only member present alone refuses on directory.\n185|func TestEntryDecodeBranchGrid(t *testing.T) {\n186|\tblobOnly := []string{\"byte_count\", \"blob_id\", \"blob_descriptor_id\"}\n187|\t// Blob baseline: entries[1]; directory baseline: entries[0].\n188|\tsealed := mustBuildManifest(t, validManifestInput())\n189|\tfor _, member := range blobOnly {\n190|\t\tdocument := decodeDocument(t, sealed)\n191|\t\tdelete(document[\"entries\"].([]any)[1].(map[string]any), member)\n192|\t\t_, err := cloneplan.DecodeProjectedObjectManifest(marshalDocument(t, document))\n193|\t\trequireRefusal(t, err, \"projected object entry[1]\", member)\n194|\t}\n195|\tfor _, member := range blobOnly {\n196|\t\tdocument := decodeDocument(t, sealed)\n197|\t\trow := document[\"entries\"].([]any)[0].(map[string]any)\n198|\t\tswitch member {\n199|\t\tcase \"byte_count\":\n200|\t\t\trow[member] = float64(8)\n201|\t\tdefault:\n202|\t\t\trow[member] = fixtureDigest(\"stray-\" + member)\n203|\t\t}\n204|\t\t_, err := cloneplan.DecodeProjectedObjectManifest(marshalDocument(t, document))\n205|\t\trequireRefusal(t, err, \"projected object entry[0]\", member)\n206|\t}\n207|\t// Mode nullability admits on both branches: fresh seal plus\n208|\t// decode per cell (mutating sealed bytes would trip the\n209|\t// self-digest instead of measuring the mode gate).\n210|\tmodes := []*uint64{nil, u64ptr(0), u64ptr(4095)}\n211|\tfor _, mode := range modes {\n212|\t\tmanifest := validManifestInput()\n213|\t\tdirectory := validDirectoryEntryInput(1, \"a-admit\")\n214|\t\tdirectory.Mode = mode\n215|\t\tblob := validBlobEntryInput(1, \"b-admit\")\n216|\t\tblob.Mode = mode\n217|\t\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory, blob}\n218|\t\tsealed := mustBuildManifest(t, manifest)\n219|\t\tdecoded := mustDecodeManifest(t, sealed)\n220|\t\tif len(decoded.Entries) != 2 {\n221|\t\t\tt.Fatalf(\"mode=%v: entries = %d, want 2\", mode, len(decoded.Entries))\n222|\t\t}\n223|\t}\n224|}\n225|\n226|// TestEntryBranchLiterals pins the build-side branch refusal\n227|// literals for each blob-only member on each branch.\n228|func TestEntryBranchLiterals(t *testing.T) {\n229|\tblob := validBlobEntryInput(1, \"branch\")\n230|\tblob.ByteCount = nil\n231|\tmanifest := validManifestInput()\n232|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{blob}\n233|\t_, err := cloneplan.BuildProjectedObjectManifest(manifest)\n234|\trequireRefusal(t, err, \"projected object entry[0]\", \"byte_count is missing for blob\")\n235|\n236|\tblob = validBlobEntryInput(1, \"branch\")\n237|\tblob.BlobID = nil\n238|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{blob}\n239|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n240|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_id is missing for blob\")\n241|\n242|\tblob = validBlobEntryInput(1, \"branch\")\n243|\tblob.BlobDescriptorID = nil\n244|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{blob}\n245|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n246|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_descriptor_id is missing for blob\")\n247|\n248|\tdirectory := validDirectoryEntryInput(1, \"branch\")\n249|\tdirectory.ByteCount = u64ptr(8)\n250|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory}\n251|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n252|\trequireRefusal(t, err, \"projected object entry[0]\", \"byte_count is present for directory\")\n253|\n254|\tdirectory = validDirectoryEntryInput(1, \"branch\")\n255|\tdirectory.BlobID = strptr(fixtureDigest(\"stray\"))\n256|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory}\n257|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n258|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_id is present for directory\")\n259|\n260|\tdirectory = validDirectoryEntryInput(1, \"branch\")\n261|\tdirectory.BlobDescriptorID = strptr(fixtureDigest(\"stray\"))\n262|\tmanifest.Entries = []cloneplan.ProjectedEntryInput{directory}\n263|\t_, err = cloneplan.BuildProjectedObjectManifest(manifest)\n264|\trequireRefusal(t, err, \"projected object entry[0]\", \"blob_descriptor_id is present for directory\")\n265|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
