{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c7","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":574,"recorded_at":1780531400001143,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"task_stream":{"kind":"task","id":"01a0d128-b0d5-7af3-a19f-bd4c753779d8"},"task_id":"01a0d128-b0d5-7af3-a19f-bd4c753779d8","event":{"kind":"output","task_id":"01a0d128-b0d5-7af3-a19f-bd4c753779d8","chunk":"Read text file `internal/cloneplan/utf8_reflection_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"reflect\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"unicode/utf8\"\n11|\n12|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n13|)\n14|\n15|// TestUTF8RefusalReflectionGrid pins that every string-valued\n16|// member of every shape this leaf builds or decodes refuses invalid\n17|// UTF-8 at both production entries with ErrInvalid and a pinned\n18|// literal detail.\n19|//\n20|// The member set is DERIVED from the Go input types by reflection,\n21|// not typed by hand: a new string field is covered automatically\n22|// (its derived member has no probe, so this test fails naming it),\n23|// and a new field of an unhandled kind fails loudly in the walker,\n24|// so the set can never silently shrink. Decode refuses at the\n25|// delegated strict frame (landed environ owner) before any member\n26|// gate runs, so every decode cell pins the frame literal; planting\n27|// per member proves no member bypasses the frame gate.\n28|func TestUTF8RefusalReflectionGrid(t *testing.T) {\n29|\tmembers := derivePlanUTF8Members(t)\n30|\tplanProbes, manifestProbes := planUTF8Probes(t)\n31|\tprobes := map[string]utf8PlanProbe{}\n32|\tfor member, probe := range planProbes {\n33|\t\tprobes[member] = probe\n34|\t}\n35|\tfor member, probe := range manifestProbes {\n36|\t\tprobes[member] = probe\n37|\t}\n38|\tfor _, member := range members {\n39|\t\tif _, ok := probes[member]; !ok {\n40|\t\t\tt.Fatalf(\"derived member %q has no probe: add a build setter, a decode anchor, and build literals\", member)\n41|\t\t}\n42|\t}\n43|\tfor member := range probes {\n44|\t\tfound := false\n45|\t\tfor _, derived := range members {\n46|\t\t\tif derived == member {\n47|\t\t\t\tfound = true\n48|\t\t\t\tbreak\n49|\t\t\t}\n50|\t\t}\n51|\t\tif !found {\n52|\t\t\tt.Fatalf(\"orphan probe %q matches no derived member: the walker or the probe is stale\", member)\n53|\t\t}\n54|\t}\n55|\tt.Logf(\"derived UTF-8 member set (%d): %s\", len(members), strings.Join(members, \", \"))\n56|\tclasses := []struct {\n57|\t\tname string\n58|\t\traw  []byte\n59|\t}{\n60|\t\t{\"lone-continuation\", []byte{0x80}},\n61|\t\t{\"ff-fe\", []byte{0xff, 0xfe}},\n62|\t\t{\"overlong\", []byte{0xc0, 0xaf}},\n63|\t\t{\"encoded-surrogate\", []byte{0xed, 0xa0, 0x80}},\n64|\t\t{\"truncated-sequence\", []byte{0xe2, 0x82}},\n65|\t}\n66|\tfor _, class := range classes {\n67|\t\tif utf8.Valid(class.raw) {\n68|\t\t\tt.Fatalf(\"class %q is valid UTF-8: the test vector is wrong\", class.name)\n69|\t\t}\n70|\t}\n71|\tplanSealed := mustBuildPlan(t, utf8PlanBaseline(t))\n72|\tmanifestSealed := mustBuildManifest(t, utf8ManifestBaseline(t))\n73|\tfor _, member := range members {\n74|\t\tprobe := probes[member]\n75|\t\tt.Run(member, func(t *testing.T) {\n76|\t\t\tfor _, class := range classes {\n77|\t\t\t\tt.Run(class.name+\"/build\", func(t *testing.T) {\n78|\t\t\t\t\tprobe.buildRefuses(t, string(class.raw))\n79|\t\t\t\t})\n80|\t\t\t\tt.Run(class.name+\"/decode\", func(t *testing.T) {\n81|\t\t\t\t\tsealed := planSealed\n82|\t\t\t\t\tdecode := func(raw []byte) error {\n83|\t\t\t\t\t\t_, err := cloneplan.DecodeProjectionPlan(raw)\n84|\t\t\t\t\t\treturn err\n85|\t\t\t\t\t}\n86|\t\t\t\t\towner := \"projection plan\"\n87|\t\t\t\t\tif probe.manifest {\n88|\t\t\t\t\t\tsealed = manifestSealed\n89|\t\t\t\t\t\tdecode = func(raw []byte) error {\n90|\t\t\t\t\t\t\t_, err := cloneplan.DecodeProjectedObjectManifest(raw)\n91|\t\t\t\t\t\t\treturn err\n92|\t\t\t\t\t\t}\n93|\t\t\t\t\t\towner = \"projected object manifest\"\n94|\t\t\t\t\t}\n95|\t\t\t\t\tmutated := splicePlanUTF8Bytes(t, sealed, probe.anchor, probe.value, class.raw)\n96|\t\t\t\t\terr := decode(mutated)\n97|\t\t\t\t\trequireRefusalTokens(t, err, owner, \"not valid UTF-8\", \"(frame)\")\n98|\t\t\t\t})\n99|\t\t\t}\n100|\t\t})\n101|\t}\n102|}\n103|\n104|// TestRegistryPredicatesRefuseInvalidUTF8 pins the remaining public\n105|// entries: the five string-taking registry predicates admit no\n106|// invalid-UTF-8 token (they return false; there is no error to\n107|// carry ErrInvalid through a boolean entry).\n108|func TestRegistryPredicatesRefuseInvalidUTF8(t *testing.T) {\n109|\tbads := []string{\n110|\t\tstring([]byte{0x80}),\n111|\t\tstring([]byte{0xff, 0xfe}),\n112|\t\tstring([]byte{0xc0, 0xaf}),\n113|\t\tstring([]byte{0xed, 0xa0, 0x80}),\n114|\t\tstring([]byte{0xe2, 0x82}),\n115|\t}\n116|\tfor _, bad := range bads {\n117|\t\tif utf8.ValidString(bad) {\n118|\t\t\tt.Fatalf(\"vector %q is valid UTF-8: the test vector is wrong\", bad)\n119|\t\t}\n120|\t\tif cloneplan.ValidPlanStrategy(bad) {\n(more lines below)","final_result":true}}}
