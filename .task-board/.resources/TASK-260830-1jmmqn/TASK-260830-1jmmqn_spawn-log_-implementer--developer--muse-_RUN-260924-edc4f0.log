every strict decode; the case-variant sweep pins the refusal.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-case-upper-strategy\\\",\\n        path=f\\\"{PACKAGE}/decode.go\\\",\\n        find=\\\\'\\\\'\\\\'\\\\\\\\tmembers, fault := environ.DecodeStrictObject(data)\\\\\\\\n\\\\\\\\tif fault != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\\\\\\\\n\\\\\\\\t}\\\\\\\\n\\\\\\\\treturn members, nil\\\\'\\\\'\\\\',\\n        replace=\\\\'\\\\'\\\\'\\\\\\\\tmembers, fault := environ.DecodeStrictObject(data)\\\\\\\\n\\\\\\\\tif fault != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\\\\\\\\n\\\\\\\\t}\\\\\\\\n\\\\\\\\tif value, present := members[\\\"STRATEGY\\\"]; present {\\\\\\\\n\\\\\\\\t\\\\\\\\tmembers[\\\"strategy\\\"] = value\\\\\\\\n\\\\\\\\t\\\\\\\\tdelete(members, \\\"STRATEGY\\\")\\\\\\\\n\\\\\\\\t}\\\\\\\\n\\\\\\\\treturn members, nil\\\\'\\\\'\\\\',\\n        count=1,\\n        run=\\\"TestMemberCensusMiscased\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Narrowing: admits exactly the UPPER STRATEGY member through every strict decode; the case-variant sweep pins the refusal.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-dagfour-self\\\",\\n        path=f\\\"{PACKAGE}/operations.go\\\",\\n        find=\\\\'\\\\'\\\\'\\\\\\\\t\\\\\\\\t\\\\\\\\tif dependency >= operation.Sequence {\\\\'\\\\'\\\\',\\n        replace=\\\\'\\\\'\\\\'\\\\\\\\t\\\\\\\\t\\\\\\\\tif dependency >= operation.Sequence && !(len(operations) == 4 && dependency == operation.Sequence) {\\\\'\\\\'\\\\',\\n        count=1,\\n        run=\\\"TestDAGWholeDomainCensus\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Narrowing: admits exactly four-operation self edges; the exhaustive census classifies every four-operation graph against the oracle.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-dagfive-self\\\",\\n        path=f\\\"{PACKAGE}/operations.go\\\",\\n        find=\\\\'\\\\'\\\\'\\\\\\\\t\\\\\\\\t\\\\\\\\tif dependency >= operation.Sequence {\\\\'\\\\'\\\\',\\n        replace=\\\\'\\\\'\\\\'\\\\\\\\t\\\\\\\\t\\\\\\\\tif dependency >= operation.Sequence && !(len(operations) == 5 && dependency == operation.Sequence) {\\\\'\\\\'\\\\',\\n        count=1,\\n        run=\\\"TestDAGWholeDomainCensus\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Narrowing: admits exactly five-operation self edges; the five-operation edge-class sweep pins every position.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-dag-locality-evasion\\\",\\n        path=f\\\"{PACKAGE}/operations.go\\\",\\n        find=\\\\'\\\\'\\\\'\\\\\\\\t\\\\\\\\t\\\\\\\\tif dependency >= operation.Sequence {\\\\'\\\\'\\\\',\\n        replace=\\\\'\\\\'\\\\'\\\\\\\\t\\\\\\\\t\\\\\\\\tif dependency >= operation.Sequence && len(operations) >= 0 == false {\\\\'\\\\'\\\\',\\n        count=1,\\n        run=\\\"TestDAGWholeDomainCensus\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Token-preserving arm-delete, NOT a narrowing: every token the AST locality pin searches for survives while the lower arm never refuses; the killer is the behavioral census, proving the static pin alone is blind.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-entry-branch-combo\\\",\\n        path=f\\\"{PACKAGE}/manifest.go\\\",\\n        find=\\\\'\\\\'\\\\'func checkEntryBranch(owner, kind string, hasCount, hasBlob, hasDescriptor bool) error {\\\\\\\\n\\\\\\\\tif kind == \\\"blob\\\" {\\\\'\\\\'\\\\',\\n        replace=\\\\'\\\\'\\\\'func checkEntryBranch(owner, kind string, hasCount, hasBlob, hasDescriptor bool) error {\\\\\\\\n\\\\\\\\tif kind == \\\"blob\\\" && !hasCount && !hasBlob && hasDescriptor { return nil }\\\\\\\\n\\\\\\\\tif kind == \\\"blob\\\" {\\\\'\\\\'\\\\',\\n        count=1,\\n        run=\\\"TestEntryNullabilityGrid\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Narrowing: admits exactly blob rows missing byte_count and blob_id; the full presence grid refuses the cell and the panic guard fails it.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-guard-literal-list\\\",\\n        path=f\\\"{PACKAGE}/members_test.go\\\",\\n        find=\\\\'\\\\'\\\\'// rowShapeOf maps a container field to the shape label its element\\\\\\\\n// or nested struct decodes into.\\\\'\\\\'\\\\',\\n        replace=\\\\'\\\\'\\\\'// rowShapeOf maps a container field to the shape label its element\\\\\\\\n// or nested struct decodes into.\\\\\\\\n\\\\\\\\n// guardProbeList is a harness-planted literal member list.\\\\\\\\nvar guardProbeList = []string{\\\"schema\\\", \\\"schema_version\\\", \\\"projection_plan_id\\\", \\\"operation_id\\\", \\\"bundle_id\\\", \\\"request_digest\\\", \\\"source_snapshot_digest\\\", \\\"capture_manifest_id\\\", \\\"canonical_session_id\\\", \\\"canonical_event_ids\\\", \\\"source_environment\\\", \\\"target_environment\\\"}\\\\'\\\\'\\\\',\\n        count=1,\\n        run=\\\"TestMemberCensusNoLiteralList\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Narrowing on the derivation guard: plants exactly one 12-name literal list; the guard must redden on it.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"C-doc-comment\\\",'''\\n\\nold = '''    Mutant(\\n        name=\\\"C-doc-comment\\\",'''\\nassert src.count(old) == 1\\nsrc = src.replace(old, rows)\\np.write_text(src)\\nprint(\\\"rows inserted:\\\", src.count(\\\"Mutant(\\\"))\\nPYEOF\\npython3 -c \\\"import ast; ast.parse(open('internal/cloneplan/testdata/mutant_harness.py').read()); print('harness parses')\\\"\",\n  \"description\": \"Insert seven new harness rows\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"rows inserted: 125\\nharness parses\\n\",\n  \"original_output_bytes\": 34,\n  \"original_output_tokens\": 9,\n  \"truncated\": false\n}","final_result":true}}}
