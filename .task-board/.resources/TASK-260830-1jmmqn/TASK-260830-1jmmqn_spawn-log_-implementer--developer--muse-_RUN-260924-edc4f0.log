{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e5","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":461,"recorded_at":1780531400000917,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"task_stream":{"kind":"task","id":"01a0d128-1278-7471-ae24-5e25aa2b9d3b"},"task_id":"01a0d128-1278-7471-ae24-5e25aa2b9d3b","event":{"kind":"output","task_id":"01a0d128-1278-7471-ae24-5e25aa2b9d3b","chunk":"Read text file `internal/cloneplan/dag_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"testing\"\n6|\n7|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n8|)\n9|\n10|// dagOracleVerdict is the independent DAG rule retyped from the\n11|// spec sentence \"Dependencies are lower sequences and form a DAG\":\n12|// sequences strictly increase, and every dependency names a\n13|// strictly lower sequence present in the set. Strict decrease along\n14|// every edge admits no cycle and no self-edge, so the oracle needs\n15|// no separate cycle walk: any cycle would cross a non-decreasing\n16|// edge.\n17|func dagOracleVerdict(sequences []uint64, depends [][]uint64) bool {\n18|\tfor index := 1; index < len(sequences); index++ {\n19|\t\tif sequences[index] <= sequences[index-1] {\n20|\t\t\treturn false\n21|\t\t}\n22|\t}\n23|\tpresent := make(map[uint64]bool, len(sequences))\n24|\tfor _, sequence := range sequences {\n25|\t\tpresent[sequence] = true\n26|\t}\n27|\tfor index, sequence := range sequences {\n28|\t\tfor _, dependency := range depends[index] {\n29|\t\t\tif dependency >= sequence || !present[dependency] {\n30|\t\t\t\treturn false\n31|\t\t\t}\n32|\t\t}\n33|\t}\n34|\treturn true\n35|}\n36|\n37|func dagInput(sequences []uint64, depends [][]uint64) cloneplan.ProjectionPlanInput {\n38|\tinput := validPlanInput()\n39|\toperations := make([]cloneplan.TargetOperationInput, 0, len(sequences))\n40|\tfor index, sequence := range sequences {\n41|\t\toperation := validOperationInput(sequence, depends[index]...)\n42|\t\toperation.ResourceKeys = []string{fmt.Sprintf(\"res/%d\", sequence)}\n43|\t\toperations = append(operations, operation)\n44|\t}\n45|\tinput.TargetOperations = operations\n46|\treturn input\n47|}\n48|\n49|func dagVerdict(t *testing.T, sequences []uint64, depends [][]uint64) (bool, bool) {\n50|\tt.Helper()\n51|\tinput := dagInput(sequences, depends)\n52|\t_, buildErr := cloneplan.BuildProjectionPlan(input)\n53|\tbuildAdmits := buildErr == nil\n54|\tvar decodeAdmits bool\n55|\tif buildAdmits {\n56|\t\tsealed, err := cloneplan.BuildProjectionPlan(input)\n57|\t\tif err != nil {\n58|\t\t\tt.Fatalf(\"rebuild: %v\", err)\n59|\t\t}\n60|\t\t_, decodeErr := cloneplan.DecodeProjectionPlan(sealed)\n61|\t\tdecodeAdmits = decodeErr == nil\n62|\t} else {\n63|\t\t// A build refusal still reaches decode through a\n64|\t\t// hand-assembled document only when the shape is\n65|\t\t// otherwise valid; dependency violations are shape-valid\n66|\t\t// except for the DAG rule, so decode must refuse them\n67|\t\t// too. Documents that fail earlier gates are out of\n68|\t\t// scope for this sweep: every swept graph is\n69|\t\t// shape-valid by construction.\n70|\t\tdecodeAdmits = decodeAdmitsHandBuilt(t, sequences, depends)\n71|\t}\n72|\treturn buildAdmits, decodeAdmits\n73|}\n74|\n75|// decodeAdmitsHandBuilt assembles a sealed-shape document with the\n76|// given operations by mutating a valid sealed plan, so decode-side\n77|// verdicts are measured even for graphs build refuses.\n78|func decodeAdmitsHandBuilt(t *testing.T, sequences []uint64, depends [][]uint64) bool {\n79|\tt.Helper()\n80|\tbase := validPlanInput()\n81|\toperations := make([]cloneplan.TargetOperationInput, 0, len(sequences))\n82|\tfor _, sequence := range sequences {\n83|\t\toperation := validOperationInput(sequence)\n84|\t\toperation.ResourceKeys = []string{fmt.Sprintf(\"res/%d\", sequence)}\n85|\t\toperations = append(operations, operation)\n86|\t}\n87|\tbase.TargetOperations = operations\n88|\tsealed := mustBuildPlan(t, base)\n89|\tdocument := decodeDocument(t, sealed)\n90|\t// Sequences in the swept graphs are contiguous from 1, so\n91|\t// hand-editing dependencies preserves shape validity.\n92|\trows := document[\"target_operations\"].([]any)\n93|\tfor index := range rows {\n94|\t\tedges := make([]any, 0, len(depends[index]))\n95|\t\tfor _, dependency := range depends[index] {\n96|\t\t\tedges = append(edges, float64(dependency))\n97|\t\t}\n98|\t\trows[index].(map[string]any)[\"depends_on_sequences\"] = edges\n99|\t}\n100|\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n101|\t// A DAG refusal is the expected decode verdict for invalid\n102|\t// graphs; any refusal counts as non-admission here because the\n103|\t// document is shape-valid except for the swept edges.\n104|\treturn err == nil\n105|}\n106|\n107|// TestDAGExhaustiveSmall enumerates EVERY dependency graph over up\n108|// to 3 operations (all 2^(n^2) edge sets, valid and invalid) and\n109|// asserts both production entries agree with the independent oracle\n110|// on every graph.\n111|func TestDAGExhaustiveSmall(t *testing.T) {\n112|\tfor n := 1; n <= 3; n++ {\n113|\t\tsequences := make([]uint64, 0, n)\n114|\t\tfor sequence := uint64(1); sequence <= uint64(n); sequence++ {\n115|\t\t\tsequences = append(sequences, sequence)\n116|\t\t}\n117|\t\ttotal := 1 << (n * n)\n118|\t\tadmitted := 0\n119|\t\tfor mask := 0; mask < total; mask++ {\n120|\t\t\tdepends := make([][]uint64, n)\n121|\t\t\tfor target := 0; target < n; target++ {\n122|\t\t\t\tfor source := 0; source < n; source++ {\n123|\t\t\t\t\tbit := target*n + source\n124|\t\t\t\t\tif mask&(1<<bit) != 0 {\n125|\t\t\t\t\t\t// Edge stored sorted: sources ascend,\n126|\t\t\t\t\t\t// so the shape gate never fires here.\n127|\t\t\t\t\t\tdepends[target] = append(depends[target], uint64(source+1))\n128|\t\t\t\t\t}\n129|\t\t\t\t}\n130|\t\t\t}\n131|\t\t\twant := dagOracleVerdict(sequences, depends)\n132|\t\t\tbuildAdmits, decodeAdmits := dagVerdict(t, sequences, depends)\n133|\t\t\tif buildAdmits != want {\n134|\t\t\t\tt.Errorf(\"n=%d mask=%b: build admits = %v, oracle = %v (depends=%v)\", n, mask, buildAdmits, want, depends)\n135|\t\t\t}\n136|\t\t\tif decodeAdmits != want {\n137|\t\t\t\tt.Errorf(\"n=%d mask=%b: decode admits = %v, oracle = %v (depends=%v)\", n, mask, decodeAdmits, want, depends)\n138|\t\t\t}\n139|\t\t\tif want {\n140|\t\t\t\tadmitted++\n141|\t\t\t}\n142|\t\t}\n143|\t\tt.Logf(\"n=%d: %d of %d graphs admitted\", n, total, admitted)\n144|\t}\n145|}\n146|\n147|// TestDAGValidEnumeration admits every valid DAG over 4 and 5\n148|// operations: all 2^(n(n-1)/2) strictly-lower edge sets through\n149|// both entries.\n150|func TestDAGValidEnumeration(t *testing.T) {\n151|\tfor _, n := range []int{4, 5} {\n152|\t\tsequences := make([]uint64, 0, n)\n153|\t\tfor sequence := uint64(1); sequence <= uint64(n); sequence++ {\n154|\t\t\tsequences = append(sequences, sequence)\n155|\t\t}\n156|\t\t// Lower-triangular edge slots: (target, source) with\n157|\t\t// source < target.\n158|\t\tvar slots [][2]int\n159|\t\tfor target := 0; target < n; target++ {\n160|\t\t\tfor source := 0; source < target; source++ {\n161|\t\t\t\tslots = append(slots, [2]int{target, source})\n162|\t\t\t}\n163|\t\t}\n164|\t\ttotal := 1 << len(slots)\n165|\t\tfor mask := 0; mask < total; mask++ {\n166|\t\t\tdepends := make([][]uint64, n)\n167|\t\t\tfor slot, edge := range slots {\n168|\t\t\t\tif mask&(1<<slot) != 0 {\n169|\t\t\t\t\tdepends[edge[0]] = append(depends[edge[0]], uint64(edge[1]+1))\n170|\t\t\t\t}\n171|\t\t\t}\n172|\t\t\tif !dagOracleVerdict(sequences, depends) {\n173|\t\t\t\tt.Fatalf(\"n=%d mask=%b: swept graph is not a valid DAG: the sweep is wrong\", n, mask)\n174|\t\t\t}\n175|\t\t\tbuildAdmits, decodeAdmits := dagVerdict(t, sequences, depends)\n176|\t\t\tif !buildAdmits || !decodeAdmits {\n177|\t\t\t\tt.Errorf(\"n=%d mask=%b: valid DAG refused (build=%v decode=%v)\", n, mask, buildAdmits, decodeAdmits)\n178|\t\t\t}\n179|\t\t}\n180|\t\tt.Logf(\"n=%d: %d valid DAGs admitted\", n, total)\n181|\t}\n182|}\n183|\n184|// TestDAGRefusalLiterals pins the refusal literals for each invalid\n185|// edge class through the production entries: higher, equal,\n186|// self-edge, dangling-lower, duplicate sequence, and unordered\n187|// sequences.\n188|func TestDAGRefusalLiterals(t *testing.T) {\n189|\tt.Run(\"higher\", func(t *testing.T) {\n190|\t\tinput := dagInput([]uint64{1, 2}, [][]uint64{{2}, {}})\n191|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n192|\t\trequireRefusal(t, err, \"target operation 1\", \"depends on sequence 2\", \"want a lower sequence\")\n193|\t})\n194|\tt.Run(\"self\", func(t *testing.T) {\n195|\t\tinput := dagInput([]uint64{1, 2}, [][]uint64{{}, {2}})\n196|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n197|\t\trequireRefusal(t, err, \"target operation 2\", \"depends on sequence 2\", \"want a lower sequence\")\n198|\t})\n199|\tt.Run(\"dangling\", func(t *testing.T) {\n200|\t\t// Non-contiguous sequences: 2 is lower than 3 but no\n201|\t\t// operation carries it.\n202|\t\tinput := dagInput([]uint64{1, 3}, [][]uint64{{}, {2}})\n203|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n204|\t\trequireRefusal(t, err, \"target operation 3\", \"depends on absent sequence 2\")\n205|\t})\n206|\tt.Run(\"duplicate-sequence\", func(t *testing.T) {\n207|\t\tinput := dagInput([]uint64{1, 1}, [][]uint64{{}, {}})\n208|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n209|\t\trequireRefusal(t, err, \"target_operations\", \"not ordered by sequence\")\n210|\t})\n211|\tt.Run(\"unordered\", func(t *testing.T) {\n212|\t\tinput := dagInput([]uint64{2, 1}, [][]uint64{{}, {}})\n213|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n214|\t\trequireRefusal(t, err, \"target_operations\", \"not ordered by sequence\")\n215|\t})\n216|\tt.Run(\"decode-higher\", func(t *testing.T) {\n217|\t\tsealed := mustBuildPlan(t, dagInput([]uint64{1, 2}, [][]uint64{{}, {}}))\n218|\t\tdocument := decodeDocument(t, sealed)\n219|\t\trows := document[\"target_operations\"].([]any)\n220|\t\trows[0].(map[string]any)[\"depends_on_sequences\"] = []any{float64(2)}\n221|\t\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n222|\t\trequireRefusal(t, err, \"target operation 1\", \"depends on sequence 2\", \"want a lower sequence\")\n223|\t})\n224|\tt.Run(\"decode-dangling\", func(t *testing.T) {\n225|\t\tsealed := mustBuildPlan(t, dagInput([]uint64{1, 3}, [][]uint64{{}, {}}))\n226|\t\tdocument := decodeDocument(t, sealed)\n227|\t\trows := document[\"target_operations\"].([]any)\n228|\t\trows[1].(map[string]any)[\"depends_on_sequences\"] = []any{float64(2)}\n229|\t\t_, err := cloneplan.DecodeProjectionPlan(marshalDocument(t, document))\n230|\t\trequireRefusal(t, err, \"target operation 3\", \"depends on absent sequence 2\")\n231|\t})\n232|\tt.Run(\"cycle-is-higher\", func(t *testing.T) {\n233|\t\t// A two-cycle 1->2->1 needs the non-decreasing edge\n234|\t\t// 1->2, which the lower-sequence rule refuses.\n235|\t\tinput := dagInput([]uint64{1, 2}, [][]uint64{{2}, {1}})\n236|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n237|\t\trequireRefusal(t, err, \"want a lower sequence\")\n238|\t})\n239|}\n240|\n241|// TestDAGNonContiguousValid pins that gaps in the sequence space\n242|// admit: only strictly-lower presence matters, not contiguity.\n243|func TestDAGNonContiguousValid(t *testing.T) {\n244|\tinput := dagInput([]uint64{1, 5, 9}, [][]uint64{{}, {1}, {1, 5}})\n245|\tsealed := mustBuildPlan(t, input)\n246|\tplan := mustDecodePlan(t, sealed)\n247|\tif len(plan.TargetOperations) != 3 {\n248|\t\tt.Fatalf(\"operations = %d, want 3\", len(plan.TargetOperations))\n249|\t}\n250|}",