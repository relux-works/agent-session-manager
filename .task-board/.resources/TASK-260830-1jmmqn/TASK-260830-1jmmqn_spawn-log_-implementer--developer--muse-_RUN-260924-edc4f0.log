, \"capture_manifest_id is not a digest\"},\n29|\t\t{\"canonical\", func(input *cloneplan.ProjectionPlanInput) { input.CanonicalSessionID = \"\" }, false, \"canonical_session_id is not a digest\"},\n30|\t\t{\"event-ids\", func(input *cloneplan.ProjectionPlanInput) { input.CanonicalEventIDs = nil }, true, \"\"},\n31|\t\t{\"source-tuple\", func(input *cloneplan.ProjectionPlanInput) { input.SourceEnvironment = nil }, false, \"source_environment is not an Environment Tuple\"},\n32|\t\t{\"target-tuple\", func(input *cloneplan.ProjectionPlanInput) { input.TargetEnvironment = nil }, false, \"target_environment is not an Environment Tuple\"},\n33|\t\t{\"native-id\", func(input *cloneplan.ProjectionPlanInput) { input.ExpectedTargetNativeSession = \"\" }, false, \"expected_target_native_session_id is not a string[1..512]\"},\n34|\t\t{\"workspace\", func(input *cloneplan.ProjectionPlanInput) { input.TargetWorkspace = nil }, false, \"target_workspace is not a Workspace Binding\"},\n35|\t\t{\"strategy\", func(input *cloneplan.ProjectionPlanInput) { input.Strategy = \"\" }, false, \"strategy is outside same_environment_native_rewrite|target_native_writer|target_official_import|continuation_context\"},\n36|\t\t{\"rationale\", func(input *cloneplan.ProjectionPlanInput) { input.StrategyRationale = \"\" }, false, \"strategy_rationale is not a string[1..4096]\"},\n37|\t\t{\"profile\", func(input *cloneplan.ProjectionPlanInput) { input.FidelityProfile = \"\" }, false, \"fidelity_profile is outside strict_exact|maximal_safe|compact|messages_only\"},\n38|\t\t{\"required\", func(input *cloneplan.ProjectionPlanInput) { input.RequiredDispositions = nil }, false, \"required_dispositions carry no class\"},\n39|\t\t{\"forbid\", func(input *cloneplan.ProjectionPlanInput) { input.ForbidReasons = nil }, true, \"\"},\n40|\t\t{\"mappings\", func(input *cloneplan.ProjectionPlanInput) { input.ItemMappings = nil }, false, \"0 item_mappings\"},\n41|\t\t{\"operations\", func(input *cloneplan.ProjectionPlanInput) { input.TargetOperations = nil }, false, \"0 target_operations\"},\n42|\t\t{\"resources\", func(input *cloneplan.ProjectionPlanInput) { input.ExpectedResources = nil }, true, \"\"},\n43|\t\t{\"events\", func(input *cloneplan.ProjectionPlanInput) { input.SynthesizedEvents = nil }, true, \"\"},\n44|\t\t{\"exclusions\", func(input *cloneplan.ProjectionPlanInput) { input.SecurityExclusions = nil }, true, \"\"},\n45|\t\t{\"limits\", func(input *cloneplan.ProjectionPlanInput) { input.ResourceLimits = nil }, false, \"resource_limits are not Resource Limits\"},\n46|\t\t{\"transaction\", func(input *cloneplan.ProjectionPlanInput) { input.TransactionPlan = cloneplan.TransactionPlanInput{} }, false, \"transaction plan materialization_intent is not clone\"},\n47|\t\t{\"read-back\", func(input *cloneplan.ProjectionPlanInput) { input.ReadBackPlan = cloneplan.ReadBackPlanInput{} }, false, \"read-back plan modes are not [staged,live]\"},\n48|\t\t{\"resume\", func(input *cloneplan.ProjectionPlanInput) { input.ResumePlan = cloneplan.ResumePlanInput{} }, false, \"resume projection plan opens_existing_identity is not true\"},\n49|\t\t{\"rollback\", func(input *cloneplan.ProjectionPlanInput) { input.RollbackPlan = cloneplan.RollbackPlanInput{} }, false, \"rollback plan required is not true\"},\n50|\t\t{\"contracts\", func(input *cloneplan.ProjectionPlanInput) { input.RequiredContracts = nil }, false, \"0 required_contracts\"},\n51|\t\t{\"capabilities\", func(input *cloneplan.ProjectionPlanInput) { input.RequiredCapabilities = nil }, false, \"0 required_capabilities\"},\n52|\t\t{\"basis\", func(input *cloneplan.ProjectionPlanInput) { input.FidelityBasisDigest = \"\" }, false, \"fidelity_basis_digest is not a digest\"},\n53|\t\t{\"source-build\", func(input *cloneplan.ProjectionPlanInput) { input.SourceAdapterBuildDigest = \"\" }, false, \"source_adapter_build_digest is not a digest\"},\n54|\t\t{\"target-build\", func(input *cloneplan.ProjectionPlanInput) { input.TargetAdapterBuildDigest = \"\" }, false, \"target_adapter_build_digest is not a digest\"},\n55|\t\t{\"controller-build\", func(input *cloneplan.ProjectionPlanInput) { input.ControllerBuildDigest = \"\" }, false, \"controller_build_digest is not a digest\"},\n56|\t\t{\"extensions\", func(input *cloneplan.ProjectionPlanInput) { input.Extensions = nil }, true, \"\"},\n57|\t}\n58|}\n59|\n60|// TestBuildZeroValueCensus sweeps every top-level plan input\n61|// member: zero it in an otherwise-valid candidate and assert the\n62|// pinned verdict through the production build entry.\n63|func TestBuildZeroValueCensus(t *testing.T) {\n64|\tcells := planZeroCells()\n65|\tif len(cells) != 33 {\n66|\t\tt.Fatalf(\"zero cells = %d, want 33\", len(cells))\n67|\t}\n68|\tadmitted := 0\n69|\tfor _, cell := range cells {\n70|\t\tt.Run(cell.label, func(t *testing.T) {\n71|\t\t\tinput := validPlanInput()\n72|\t\t\tcell.zero(&input)\n73|\t\t\tsealed, err := cloneplan.BuildProjectionPlan(input)\n74|\t\t\tif cell.admit {\n75|\t\t\t\tadmitted++\n76|\t\t\t\tif err != nil {\n77|\t\t\t\t\tt.Fatalf(\"zero %s refused: %v\", cell.label, err)\n78|\t\t\t\t}\n79|\t\t\t\tmustDecodePlan(t, sealed)\n80|\t\t\t\treturn\n81|\t\t\t}\n82|\t\t\t// Nested constant errors name their own owner, not the\n83|\t\t\t// plan; top-level errors name the plan.\n84|\t\t\tif strings.Contains(cell.token, \" plan \") || strings.HasPrefix(cell.token, \"read-back\") || strings.HasPrefix(cell.token, \"rollback\") {\n85|\t\t\t\trequireRefusal(t, err, cell.token)\n86|\t\t\t} else {\n87|\t\t\t\trequireRefusal(t, err, \"projection plan\", cell.token)\n88|\t\t\t}\n89|\t\t})\n90|\t}\n91|\tif admitted != 6 {\n92|\t\tt.Fatalf(\"admitted zero cells = %d, want 6\", admitted)\n93|\t}\n94|}\n95|\n96|// TestBuildZeroValueRows sweeps every row input member through the\n97|// production build entry.\n98|func TestBuildZeroValueRows(t *testing.T) {\n99|\tt.Run(\"mapping\", func(t *testing.T) {\n100|\t\tcases := []struct {\n101|\t\t\tlabel string\n102|\t\t\tzero  func(*cloneplan.ItemMappingInput)\n103|\t\t\tadmit bool\n104|\t\t\ttoken string\n105|\t\t}{\n106|\t\t\t{\"key\", func(row *cloneplan.ItemMappingInput) { row.SourceItemKey = \"\" }, false, \"source_item_key is not a string[1..512]\"},\n107|\t\t\t{\"canonical\", func(row *cloneplan.ItemMappingInput) { row.CanonicalObjectID = nil }, true, \"\"},\n108|\t\t\t{\"keys\", func(row *cloneplan.ItemMappingInput) { row.TargetResourceKey = nil }, true, \"\"},\n109|\t\t\t{\"disposition\", func(row *cloneplan.ItemMappingInput) { row.ExpectedDispos = \"\" }, false, \"expected_disposition is outside\"},\n110|\t\t\t{\"reasons\", func(row *cloneplan.ItemMappingInput) { row.ReasonCodes = nil }, true, \"\"},\n111|\t\t\t{\"extensions\", func(row *cloneplan.ItemMappingInput) { row.Extensions = nil }, true, \"\"},\n112|\t\t}\n113|\t\tfor _, row := range cases {\n114|\t\t\tinput := validPlanInput()\n115|\t\t\tmapping := validMappingInput(\"zero\")\n116|\t\t\trow.zero(&mapping)\n117|\t\t\tinput.ItemMappings = []cloneplan.ItemMappingInput{mapping}\n118|\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n119|\t\t\tif row.admit {\n120|\t\t\t\tif err != nil {\n121|\t\t\t\t\tt.Errorf(\"zero mapping %s refused: %v\", row.label, err)\n122|\t\t\t\t}\n123|\t\t\t\tcontinue\n124|\t\t\t}\n125|\t\t\trequireRefusal(t, err, \"projection item mapping[0]\", row.token)\n126|\t\t}\n127|\t})\n128|\tt.Run(\"operation\", func(t *testing.T) {\n129|\t\tcases := []struct {\n130|\t\t\tlabel string\n131|\t\t\tzero  func(*cloneplan.TargetOperationInput)\n132|\t\t\tadmit bool\n133|\t\t\ttoken string\n134|\t\t}{\n135|\t\t\t{\"sequence\", func(row *cloneplan.TargetOperationInput) { row.Sequence = 0 }, false, \"sequence is not a uint53>0\"},\n136|\t\t\t{\"action\", func(row *cloneplan.TargetOperationInput) { row.Action = \"\" }, false, \"action is outside\"},\n137|\t\t\t{\"keys\", func(row *cloneplan.TargetOperationInput) { row.ResourceKeys = nil }, false, \"0 resource_keys\"},\n138|\t\t\t{\"depends\", func(row *cloneplan.TargetOperationInput) { row.DependsOnSequences = nil }, true, \"\"},\n139|\t\t\t{\"extensions\", func(row *cloneplan.TargetOperationInput) { row.Extensions = nil }, true, \"\"},\n140|\t\t}\n141|\t\tfor _, row := range cases {\n142|\t\t\tinput := validPlanInput()\n143|\t\t\toperation := validOperationInput(1)\n144|\t\t\trow.zero(&operation)\n145|\t\t\tinput.TargetOperations = []cloneplan.TargetOperationInput{operation}\n146|\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n147|\t\t\tif row.admit {\n148|\t\t\t\tif err != nil {\n149|\t\t\t\t\tt.Errorf(\"zero operation %s refused: %v\", row.label, err)\n150|\t\t\t\t}\n151|\t\t\t\tcontinue\n152|\t\t\t}\n153|\t\t\trequireRefusal(t, err, \"projection target operation[0]\", row.token)\n154|\t\t}\n155|\t})\n156|\tt.Run(\"resource\", func(t *testing.T) {\n157|\t\tcases := []struct {\n158|\t\t\tlabel string\n159|\t\t\tzero  func(*cloneplan.ExpectedResourceInput)\n160|\t\t\tadmit bool\n161|\t\t\ttoken string\n162|\t\t}{\n163|\t\t\t{\"sequence\", func(row *cloneplan.ExpectedResourceInput) { row.OperationSequence = 0 }, false, \"operation_sequence is not a uint53>0\"},\n164|\t\t\t{\"key\", func(row *cloneplan.ExpectedResourceInput) { row.ResourceKey = \"\" }, false, \"resource_key is not a string[1..512]\"},\n165|\t\t\t{\"kind\", func(row *cloneplan.ExpectedResourceInput) { row.Kind = \"\" }, false, \"kind is outside blob|directory\"},\n166|\t\t\t{\"mode\", func(row *cloneplan.ExpectedResourceInput) { row.Mode = nil }, true, \"\"},\n167|\t\t\t{\"blob\", func(row *cloneplan.ExpectedResourceInput) { row.ExpectedBlobID = nil }, false, \"expected_blob_id is null for blob\"},\n168|\t\t\t{\"extensions\", func(row *cloneplan.ExpectedResourceInput) { row.Extensions = nil }, true, \"\"},\n169|\t\t}\n170|\t\tfor _, row := range cases {\n171|\t\t\tinput := validPlanInput()\n172|\t\t\tresource := validResourceInput(1, \"zero\")\n173|\t\t\trow.zero(&resource)\n174|\t\t\tinput.ExpectedResources = []cloneplan.ExpectedResourceInput{resource}\n175|\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n176|\t\t\tif row.admit {\n177|\t\t\t\tif err != nil {\n178|\t\t\t\t\tt.Errorf(\"zero resource %s refused: %v\", row.label, err)\n179|\t\t\t\t}\n180|\t\t\t\tcontinue\n181|\t\t\t}\n182|\t\t\trequireRefusal(t, err, \"expected target resource[0]\", row.token)\n183|\t\t}\n184|\t})\n185|\tt.Run(\"event\", func(t *testing.T) {\n186|\t\tcases := []struct {\n187|\t\t\tlabel string\n188|\t\t\tzero  func(*cloneplan.SynthesizedEventInput)\n189|\t\t\tadmit bool\n190|\t\t\ttoken string\n191|\t\t}{\n192|\t\t\t{\"id\", func(row *cloneplan.SynthesizedEventInput) { row.CanonicalEventID = \"\" }, false, \"canonical_event_id is not a digest\"},\n193|\t\t\t{\"anchor\", func(row *cloneplan.SynthesizedEventInput) { row.InsertionAfterEvent = nil }, true, \"\"},\n194|\t\t\t{\"purpose\", func(row *cloneplan.SynthesizedEventInput) { row.Purpose = \"\" }, false, \"purpose is outside\"},\n195|\t\t\t{\"extensions\", func(row *cloneplan.SynthesizedEventInput) { row.Extensions = nil }, true, \"\"},\n196|\t\t}\n197|\t\tfor _, row := range cases {\n198|\t\t\tinput := validPlanInput()\n199|\t\t\tevent := validSynthEventInput(\"zero\")\n200|\t\t\trow.zero(&event)\n201|\t\t\tinput.SynthesizedEvents = []cloneplan.SynthesizedEventInput{event}\n202|\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n203|\t\t\tif row.admit {\n204|\t\t\t\tif err != nil {\n205|\t\t\t\t\tt.Errorf(\"zero event %s refused: %v\", row.label, err)\n206|\t\t\t\t}\n207|\t\t\t\tcontinue\n208|\t\t\t}\n209|\t\t\trequireRefusal(t, err, \"synthesized projection event[0]\", row.token)\n210|\t\t}\n211|\t})\n212|\tt.Run(\"contract\", func(t *testing.T) {\n213|\t\tinput := validPlanInput()\n214|\t\tcontract := input.RequiredContracts[0]\n215|\t\tcontract.ContractID = \"\"\n216|\t\tinput.RequiredContracts = []cloneplan.ContractRequirementInput{contract}\n217|\t\t_, err := cloneplan.BuildProjectionPlan(input)\n218|\t\trequireRefusal(t, err, \"contract requirement[0]\", \"contract_id is not a string[1..256]\")\n219|\t\tinput = validPlanInput()\n220|\t\tcontract = input.RequiredContracts[0]\n221|\t\tcontract.Version = \"\"\n222|\t\tinput.RequiredContracts = []cloneplan.ContractRequirementInput{contract}\n223|\t\t_, err = cloneplan.BuildProjectionPlan(input)\n224|\t\trequireRefusal(t, err, \"contract requirement[0]\", \"version is not a SemVer\")\n225|\t})\n226|}\n227|\n228|// TestBuildZeroValueManifest sweeps every manifest and entry input\n229|// member through the production build entry.\n230|func TestBuildZeroValueManifest(t *testing.T) {\n231|\tt.Run(\"top\", func(t *testing.T) {\n232|\t\tcases := []struct {\n233|\t\t\tlabel string\n234|\t\t\tzero  func(*cloneplan.ProjectedManifestInput)\n235|\t\t\tadmit bool\n236|\t\t\ttoken string\n237|\t\t}{\n238|\t\t\t{\"operation\", func(input *cloneplan.ProjectedManifestInput) { input.OperationID = \"\" }, false, \"operation_id is not a UUIDv7\"},\n239|\t\t\t{\"plan\", func(input *cloneplan.ProjectedManifestInput) { input.ProjectionPlanID = \"\" }, false, \"projection_plan_id is not a digest\"},\n240|\t\t\t{\"tuple\", func(input *cloneplan.ProjectedManifestInput) { input.TargetEnvironment = nil }, false, \"target_environment is not an Environment Tuple\"},\n241|\t\t\t{\"native-id\", func(input *cloneplan.ProjectedManifestInput) { input.ExpectedTargetNativeSession = \"\" }, false, \"expected_target_native_session_id is not a string[1..512]\"},\n242|\t\t\t{\"entries\", func(input *cloneplan.ProjectedManifestInput) { input.Entries = nil }, true, \"\"},\n243|\t\t\t{\"total\", func(input *cloneplan.ProjectedManifestInput) { input.TotalBytes = 0 }, true, \"\"},\n244|\t\t\t{\"extensions\", func(input *cloneplan.ProjectedManifestInput) { input.Extensions = nil }, true, \"\"},\n245|\t\t}\n246|\t\tfor _, row := range cases {\n247|\t\t\tmanifest := validManifestInput()\n248|\t\t\trow.zero(&manifest)\n249|\t\t\tsealed, err := cloneplan.BuildProjectedObjectManifest(manifest)\n250|\t\t\tif row.admit {\n251|\t\