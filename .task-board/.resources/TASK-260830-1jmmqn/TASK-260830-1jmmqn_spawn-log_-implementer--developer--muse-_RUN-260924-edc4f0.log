{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"call_id":"call_01a0d1280395712bae8bfcfe032434d0","text":"Read text file `internal/cloneplan/members_test.go`.\n1|package cloneplan_test\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\tcloneplan \"github.com/relux-works/agent-session-manager/internal/cloneplan\"\n11|)\n12|\n13|// TestPlanRoundTrip seals a full plan and a full manifest, decodes\n14|// each, and asserts every field survived with literal schema,\n15|// strategy, and profile values.\n16|func TestPlanRoundTrip(t *testing.T) {\n17|\tinput := validPlanInput()\n18|\tevent := validSynthEventInput(\"roundtrip\")\n19|\tevent.InsertionAfterEvent = nil\n20|\tinput.SynthesizedEvents = []cloneplan.SynthesizedEventInput{event}\n21|\tinput.CanonicalEventIDs = []string{fixtureDigest(\"ev-2\"), fixtureDigest(\"ev-1\")}\n22|\tsealed := mustBuildPlan(t, input)\n23|\tplan := mustDecodePlan(t, sealed)\n24|\tif plan.Strategy != \"target_native_writer\" {\n25|\t\tt.Fatalf(\"strategy = %q, want target_native_writer\", plan.Strategy)\n26|\t}\n27|\tif plan.FidelityProfile != \"maximal_safe\" {\n28|\t\tt.Fatalf(\"profile = %q, want maximal_safe\", plan.FidelityProfile)\n29|\t}\n30|\tif len(plan.CanonicalEventIDs) != 2 {\n31|\t\tt.Fatalf(\"canonical_event_ids = %d, want 2\", len(plan.CanonicalEventIDs))\n32|\t}\n33|\tif plan.CanonicalEventIDs[0].String() != fixtureDigest(\"ev-2\") {\n34|\t\tt.Fatal(\"canonical_event_ids order did not survive: session order is preserved, not sorted\")\n35|\t}\n36|\tif plan.SynthesizedEvents[0].InsertionAfterEvent != nil {\n37|\t\tt.Fatal(\"null insertion anchor did not survive\")\n38|\t}\n39|\tif !plan.ResumePlan.BoundedContinuationTurnRequired {\n40|\t\tt.Fatal(\"bounded_continuation_turn_required did not survive\")\n41|\t}\n42|\tdocument := decodeDocument(t, sealed)\n43|\tif document[\"schema\"] != \"urn:ax:schema:projection-plan\" {\n44|\t\tt.Fatalf(\"schema = %v, want urn:ax:schema:projection-plan\", document[\"schema\"])\n45|\t}\n46|\tif document[\"schema_version\"] != \"1.0.0\" {\n47|\t\tt.Fatalf(\"schema_version = %v, want 1.0.0\", document[\"schema_version\"])\n48|\t}\n49|\tmsealed := mustBuildManifest(t, validManifestInput())\n50|\tmanifest := mustDecodeManifest(t, msealed)\n51|\tif len(manifest.Entries) != 2 || manifest.TotalBytes != 128 {\n52|\t\tt.Fatal(\"manifest entries/total did not survive\")\n53|\t}\n54|\tif manifest.Entries[0].Kind != \"directory\" || manifest.Entries[1].Kind != \"blob\" {\n55|\t\tt.Fatal(\"manifest entry branches did not survive\")\n56|\t}\n57|\tmdocument := decodeDocument(t, msealed)\n58|\tif mdocument[\"schema\"] != \"urn:ax:schema:clone-projected-object-manifest\" {\n59|\t\tt.Fatalf(\"schema = %v, want urn:ax:schema:clone-projected-object-manifest\", mdocument[\"schema\"])\n60|\t}\n61|\tif mdocument[\"schema_version\"] != \"1.0.0\" {\n62|\t\tt.Fatalf(\"schema_version = %v, want 1.0.0\", mdocument[\"schema_version\"])\n63|\t}\n64|}\n65|\n66|// memberProbe describes one shape member for the census grid: its\n67|// admitted JSON type and whether null admits.\n68|type memberProbe struct {\n69|\tname     string\n70|\ttyp      string // string, uint, boolean, array, object\n71|\tnullable bool\n72|}\n73|\n74|// censusShape binds one closed shape to its oracle member list\n75|// (retyped from the pinned spec), a baseline sealer, a navigator to\n76|// the shape object inside the sealed document, and the production\n77|// decode entry.\n78|type censusShape struct {\n79|\tlabel    string\n80|\towner    string // error owner phrase or member prefix\n81|\tmembers  []memberProbe\n82|\tseal     func(t *testing.T) []byte\n83|\tnavigate func(t *testing.T, document map[string]any) map[string]any\n84|\tdecode   func([]byte) error\n85|}\n86|\n87|func planCensusShapes() []censusShape {\n88|\tstr := func(name string) memberProbe { return memberProbe{name: name, typ: \"string\"} }\n89|\tnstr := func(name string) memberProbe { return memberProbe{name: name, typ: \"string\", nullable: true} }\n90|\tnum := func(name string) memberProbe { return memberProbe{name: name, typ: \"uint\"} }\n91|\tboolean := func(name string) memberProbe { return memberProbe{name: name, typ: \"boolean\"} }\n92|\tarr := func(name string) memberProbe { return memberProbe{name: name, typ: \"array\"} }\n93|\tobj := func(name string) memberProbe { return memberProbe{name: name, typ: \"object\"} }\n94|\n95|\tplanMembers := []memberProbe{\n96|\t\tstr(\"schema\"), str(\"schema_version\"), str(\"projection_plan_id\"),\n97|\t\tstr(\"operation_id\"), str(\"bundle_id\"),\n98|\t\tstr(\"request_digest\"), str(\"source_snapshot_digest\"),\n99|\t\tstr(\"capture_manifest_id\"), str(\"canonical_session_id\"),\n100|\t\tarr(\"canonical_event_ids\"),\n101|\t\tobj(\"source_environment\"), obj(\"target_environment\"),\n102|\t\tstr(\"expected_target_native_session_id\"), obj(\"target_workspace\"),\n103|\t\tstr(\"strategy\"), str(\"strategy_rationale\"), str(\"fidelity_profile\"),\n104|\t\tobj(\"required_dispositions\"), arr(\"forbid_reasons\"),\n105|\t\tarr(\"item_mappings\"), arr(\"target_operations\"),\n106|\t\tarr(\"expected_resources\"), arr(\"synthesized_events\"),\n107|\t\tarr(\"security_exclusions\"), obj(\"resource_limits\"),\n108|\t\tobj(\"transaction_plan\"), obj(\"read_back_plan\"),\n109|\t\tobj(\"resume_plan\"), obj(\"rollback_plan\"),\n110|\t\tarr(\"required_contracts\"), arr(\"required_capabilities\"),\n111|\t\tstr(\"fidelity_basis_digest\"),\n112|\t\tstr(\"source_adapter_build_digest\"), str(\"target_adapter_build_digest\"),\n113|\t\tstr(\"controller_build_digest\"), obj(\"extensions\"),\n114|\t}\n115|\tmanifestMembers := []memberProbe{\n116|\t\tstr(\"schema\"), str(\"schema_version\"),\n117|\t\tstr(\"projected_object_manifest_id\"), str(\"operation_id\"),\n118|\t\tstr(\"projection_plan_id\"), obj(\"target_environment\"),\n119|\t\tstr(\"expected_target_native_session_id\"),\n120|\t\tarr(\"entries\"), num(\"total_bytes\"), obj(\"extensions\"),\n121|\t}\n122|\tmappingMembers := []memberProbe{\n123|\t\tstr(\"source_item_key\"), nstr(\"canonical_object_id\"),\n124|\t\tarr(\"target_resource_keys\"), str(\"expected_disposition\"),\n125|\t\tarr(\"reason_codes\"), obj(\"extensions\"),\n126|\t}\n127|\toperationMembers := []memberProbe{\n128|\t\tnum(\"sequence\"), str(\"action\"),\n129|\t\tarr(\"resource_keys\"), arr(\"depends_on_sequences\"), obj(\"extensions\"),\n130|\t}\n131|\tresourceMembers := []memberProbe{\n132|\t\tnum(\"operation_sequence\"), str(\"resource_key\"), str(\"kind\"),\n133|\t\t{\"mode\", \"uint\", true},\n134|\t\tnstr(\"expected_blob_id\"), obj(\"extensions\"),\n135|\t}\n136|\teventMembers := []memberProbe{\n137|\t\tstr(\"canonical_event_id\"), nstr(\"insertion_after_event_id\"),\n138|\t\tstr(\"purpose\"), obj(\"extensions\"),\n139|\t}\n140|\ttransactionMembers := []memberProbe{\n141|\t\tstr(\"materialization_intent\"), str(\"target_collision_policy\"),\n142|\t\tstr(\"activation\"), obj(\"extensions\"),\n143|\t}\n144|\treadBackMembers := []memberProbe{\n145|\t\tarr(\"modes\"),\n146|\t\tboolean(\"require_identity_match\"), boolean(\"require_workspace_match\"),\n147|\t\tboolean(\"require_semantic_marker\"), obj(\"extensions\"),\n148|\t}\n149|\tresumeMembers := []memberProbe{\n150|\t\tboolean(\"opens_existing_identity\"), boolean(\"allow_blank_fallback\"),\n151|\t\tboolean(\"bounded_continuation_turn_required\"), obj(\"extensions\"),\n152|\t}\n153|\trollbackMembers := []memberProbe{\n154|\t\tboolean(\"required\"), str(\"retain_through\"),\n155|\t\tboolean(\"forbidden_after_provider_commit\"), obj(\"extensions\"),\n156|\t}\n157|\tcontractMembers := []memberProbe{str(\"contract_id\"), str(\"version\")}\n158|\tblobMembers := []memberProbe{\n159|\t\tnum(\"operation_sequence\"), str(\"resource_key\"), str(\"kind\"),\n160|\t\t{\"mode\", \"uint\", true},\n161|\t\tnum(\"byte_count\"), str(\"blob_id\"), str(\"blob_descriptor_id\"),\n162|\t}\n163|\tdirectoryMembers := []memberProbe{\n164|\t\tnum(\"operation_sequence\"), str(\"resource_key\"), str(\"kind\"),\n165|\t\t{\"mode\", \"uint\", true},\n166|\t}\n167|\n168|\tsealPlan := func(t *testing.T) []byte {\n169|\t\tt.Helper()\n170|\t\tinput := validPlanInput()\n171|\t\tinput.SynthesizedEvents = []cloneplan.SynthesizedEventInput{validSynthEventInput(\"census\")}\n172|\t\treturn mustBuildPlan(t, input)\n173|\t}\n174|\tsealManifest := func(t *testing.T) []byte { t.Helper(); return mustBuildManifest(t, validManifestInput()) }\n175|\ttop := func(t *testing.T, document map[string]any) map[string]any { return document }\n176|\tat := func(member string) func(t *testing.T, document map[string]any) map[string]any {\n177|\t\treturn func(t *testing.T, document map[string]any) map[string]any {\n178|\t\t\tt.Helper()\n179|\t\t\tnested, ok := document[member].(map[string]any)\n180|\t\t\tif !ok {\n181|\t\t\t\tt.Fatalf(\"member %q is not an object in the sealed baseline\", member)\n182|\t\t\t}\n183|\t\t\treturn nested\n184|\t\t}\n185|\t}\n186|\tatIndex := func(member string, index int) func(t *testing.T, document map[string]any) map[string]any {\n187|\t\treturn func(t *testing.T, document map[string]any) map[string]any {\n188|\t\t\tt.Helper()\n189|\t\t\tarray, ok := document[member].([]any)\n190|\t\t\tif !ok || index >= len(array) {\n191|\t\t\t\tt.Fatalf(\"member %q has no row %d in the sealed baseline\", member, index)\n192|\t\t\t}\n193|\t\t\trow, ok := array[index].(map[string]any)\n194|\t\t\tif !ok {\n195|\t\t\t\tt.Fatalf(\"member %q row %d is not an object\", member, index)\n196|\t\t\t}\n197|\t\t\treturn row\n198|\t\t}\n199|\t}\n200|\tdecodePlan := func(raw []byte) error { _, err := cloneplan.DecodeProjectionPlan(raw); return err }\n201|\tdecodeManifest := func(raw []byte) error { _, err := cloneplan.DecodeProjectedObjectManifest(raw); return err }\n202|\n203|\treturn []censusShape{\n204|\t\t{\"plan\", \"projection plan\", planMembers, sealPlan, top, decodePlan},\n205|\t\t{\"manifest\", \"projected object manifest\", manifestMembers, sealManifest, top, decodeManifest},\n206|\t\t{\"mapping\", \"projection item mapping[0]\", mappingMembers, sealPlan, atIndex(\"item_mappings\", 0), decodePlan},\n207|\t\t{\"operation\", \"projection target operation[0]\", operationMembers, sealPlan, atIndex(\"target_operations\", 0), decodePlan},\n208|\t\t{\"resource\", \"expected target resource[0]\", resourceMembers, sealPlan, atIndex(\"expected_resources\", 0), decodePlan},\n209|\t\t{\"synth-event\", \"synthesized projection event[0]\", eventMembers, sealPlan, atIndex(\"synthesized_events\", 0), decodePlan},\n210|\t\t{\"transaction\", \"transaction plan\", transactionMembers, sealPlan, at(\"transaction_plan\"), decodePlan},\n211|\t\t{\"read-back\", \"read-back plan\", readBackMembers, sealPlan, at(\"read_back_plan\"), decodePlan},\n212|\t\t{\"resume\", \"resume projection plan\", resumeMembers, sealPlan, at(\"resume_plan\"), decodePlan},\n213|\t\t{\"rollback\", \"rollback plan\", rollbackMembers, sealPlan, at(\"rollback_plan\"), decodePlan},\n214|\t\t{\"contract\", \"contract requirement[0]\", contractMembers, sealPlan, atIndex(\"required_contracts\", 0), decodePlan},\n215|\t\t// Manifest entries carry one directory row then one blob row in the baseline.\n216|\t\t{\"blob-entry\", \"projected object entry[1]\", blobMembers, sealManifest, atIndex(\"entries\", 1), decodeManifest},\n217|\t\t{\"directory-entry\", \"projected object entry[0]\", directoryMembers, sealManifest, atIndex(\"entries\", 0), decodeManifest},\n218|\t}\n219|}\n220|\n221|// TestMemberCensusExactSets pins every closed member set: the sealed\n222|// shape carries exactly the oracle members — no missing, no extra.\n223|func TestMemberCensusExactSets(t *testing.T) {\n224|\tfor _, shape := range planCensusShapes() {\n225|\t\tt.Run(shape.label, func(t *testing.T) {\n226|\t\t\tdocument := decodeDocument(t, shape.seal(t))\n227|\t\t\ttarget := shape.navigate(t, document)\n228|\t\t\tvar oracle []string\n229|\t\t\tfor _, member := range shape.members {\n230|\t\t\t\toracle = append(oracle, member.name)\n231|\t\t\t}\n232|\t\t\tif len(target) != len(oracle) {\n233|\t\t\t\tt.Fatalf(\"sealed %s carries %d members, want %d\", shape.label, len(target), len(oracle))\n234|\t\t\t}\n235|\t\t\tfor _, name := range oracle {\n236|\t\t\t\tif _, present := target[name]; !present {\n237|\t\t\t\t\tt.Errorf(\"sealed %s misses member %q\", shape.label, name)\n238|\t\t\t\t}\n239|\t\t\t}\n240|\t\t\tfor name := range target {\n241|\t\t\t\tfound := false\n242|\t\t\t\tfor _, want := range oracle {\n243|\t\t\t\t\tif name == want {\n244|\t\t\t\t\t\tfound = true\n245|\t\t\t\t\t\tbreak\n246|\t\t\t\t\t}\n247|\t\t\t\t}\n248|\t\t\t\tif !found {\n249|\t\t\t\t\tt.Errorf(\"sealed %s carries extra member %q\", shape.label, name)\n250|\t\t\t\t}\n251|\t\t\t}\n252|\t\t})\n253|\t}\n254|}\n255|\n256|// TestMemberCensusUnknownMissing pins that every shape refuses one\n257|// unknown member and refuses each oracle member removed, naming the\n258|// member.\n259|func TestMemberCensusUnknownMissing(t *testing.T) {\n260|\tfor _, shape := range planCensusShapes() {\n261|\t\tt.Run(shape.label, func(t *testing.T) {\n262|\t\t\tsealed := shape.seal(t)\n263|\t\t\tdocument := decodeDocument(t, sealed)\n264|\t\t\tshape.navigate(t, document)[\"zz_unknown_member\"] = \"x\"\n265|\t\t\terr := shape.decode(marshalDocument(t, document))\n266|\t\t\trequireRefusal(t, err, shape.owner, \"zz_unknown_member\")\n267|\t\t\tfor _, member := range shape.members {\n268|\t\t\t\tdocument := decodeDocument(t, sealed)\n269|\t\t\t\tdelete(shape.navigate(t, document), member.name)\n270|\t\t\t\terr := shape.decode(marshalDocument(t, document))\n271|\t\t\t\trequireRefusal(t, err, shape.owner, member.name, \"misses a required member\")\n272|\t\t\t}\n273|\t\t})\n274|\t}\n275|}\n276|\n277|// TestMemberCensusMiscased pins that every member miscased refuses:\n278|// member names are case-exact.\n279|func TestMemberCensusMiscased(t *testing.T) {\n280|\tfor _, shape := range planCensusShapes() {\n281|\t\tt.Run(shape.label, func(t *testing.T) {\n282|\t\t\tsealed := shape.seal(t)\n283|\t\t\tfor _, member := range shape.members {\n284|\t\t\t\tmiscased := strings.ToUpper(member.name)\n285|\t\t\t\tif miscased == member.name {\n286|\t\t\t\t\tt.Fatalf(\"member %q has no miscased form: the probe is wrong\", member.name)\n287|\t\t\t\t}\n288|\t\t\t\tdocument := decodeDocument(t, sealed)\n289|\t\t\t\ttarget := shape.navigate(t, document)\n290|\t\t\t\ttarget[miscased] = target[member.name]\n291|\t\t\t\tdelete(target, member.name)\n292|\t\t\t\terr := shape.decode(marshalDocument(t, document))\n293|\t\t\t\trequireRefusal(t, err, shape.owner)\n294|\t\t\t}\n295|\t\t})\n296|\t}\n297|}\n298|\n299|// TestMemberCensusWrongTypes pins that every member refuses every\n300|// wrong JSON type with the member (or its shape owner) named. Cells\n301|// whose probe type equals the admitted type are skipped: same-type\n302|// values are covered by the vocabulary, bound, and branch tests.\n303|func TestMemberCensusWrongTypes(t *testing.T) {\n304|\tprobes := []struct {\n305|\t\tlabel string\n306|\t\ttyp   string\n307|\t\tvalue any\n308|\t}{\n309|\t\t{\"object\", \"object\", map[string]any{\"zz\": 1}},\n310|\t\t{\"array\", \"array\", []any{7}},\n311|\t\t{\"string\", \"string\", \"zz-top\"},\n312|\t\t{\"number\", \"uint\", float64(7)},\n313|\t\t{\"boolean\", \"boolean\", true},\n314|\t\t{\"null\", \"null\", nil},\n315|\t}\n316|\t// Nested plan components report their owner phrase instead of\n317|\t// the member name when the whole member is the wrong type.\n318|\talts := map[string]string{\n319|\t\t\"transaction_plan\": \"transaction plan\",\n320|\t\t\"read_back_plan\":   \"read-back plan\",\n321|\t\t\"resume_plan\":      \"resume projection plan\",\n322|\t\t\"rollback_plan\":    \"rollback plan\",\n323|\t}\n324|\tfor _, shape := range planCensusShapes() {\n325|\t\tt.Run(shape.label, func(t *testing.T) {\n326|\t\t\tsealed := shape.seal(t)\n327|\t\t\tfor _, member := range shape.members {\n328|\t\t\t\tfor _, probe := range probes {\n329|\t\t\t\t\tif probe.typ == member.typ {\n330|\t\t\t\t\t\tcontinue\n331|\t\t\t\t\t}\n332|\t\t\t\t\tif probe.typ == \"null\" && member.nullable {\n333|\t\t\t\t\t\tcontinue\n334|\t\t\t\t\t}\n335|\t\t\t\t\tdocument := decodeDocument(t, sealed)\n336|\t\t\t\t\tshape.navigate(t, document)[member.name] = probe.value\n337|\t\t\t\t\terr := shape.decode(marshalDocument(t, document))\n338|\t\t\t\t\tif err == nil {\n339|\t\t\t\t\t\tt.Errorf(\"%s member %q admits %s probe, want refusal\", shape.label, member.name, probe.label)\n340|\t\t\t\t\t\tcontinue\n341|\t\t\t\t\t}\n342|\t\t\t\t\tdetail := err.Error()\n343|\t\t\t\t\talt, hasAlt := alts[member.name]\n344|\t\t\t\t\tif !strings.Contains(detail, member.name) && !strings.Contains(detail, shape.owner) && !(hasAlt && strings.Contains(detail, alt)) {\n345|\t\t\t\t\t\tt.Errorf(\"%s member %q %s probe: error %q names neither the member nor %q\", shape.label, member.name, probe.label, detail, shape.owner)\n346|\t\t\t\t\t}\n347|\t\t\t\t}\n348|\t\t\t}\n349|\t\t})\n350|\t}\n351|}\n352|\n353|// TestMemberCensusDuplicated pins that a duplicated member refuses\n354|// at the strict frame on every shape: raw JSON surgery duplicates\n355|// one member pair inside the sealed bytes.\n356|func TestMemberCensusDuplicated(t *testing.T) {\n357|\tdupTargets := []struct {\n358|\t\tshape  string\n359|\t\tmember string\n360|\t}{\n361|\t\t{\"plan\", \"strategy\"},\n362|\t\t{\"manifest\", \"total_bytes\"},\n363|\t\t{\"mapping\", \"source_item_key\"},\n364|\t\t{\"operation\", \"action\"},\n365|\t\t{\"resource\", \"resource_key\"},\n366|\t\t{\"synth-event\", \"purpose\"},\n367|\t\t{\"transaction\", \"activation\"},\n368|\t\t{\"read-back\", \"require_identity_match\"},\n369|\t\t{\"resume\", \"allow_blank_fallback\"},\n370|\t\t{\"rollback\", \"retain_through\"},\n371|\t\t{\"contract\", \"contract_id\"},\n372|\t\t{\"blob-entry\", \"byte_count\"},\n373|\t\t{\"directory-entry\", \"mode\"},\n374|\t}\n375|\tbyLabel := make(map[string]censusShape)\n376|\tfor _, shape := range planCensusShapes() {\n377|\t\tbyLabel[shape.label] = shape\n378|\t}\n379|\tfor _, target := range dupTargets {\n380|\t\tt.Run(target.shape, func(t *testing.T) {\n381|\t\t\tshape := byLabel[target.shape]\n382|\t\t\tsealed := shape.seal(t)\n383|\t\t\tvar rawMembers map[string]json.RawMessage\n384|\t\t\tif err := json.Unmarshal(sealed, &rawMembers); err != nil {\n385|\t\t\t\tt.Fatalf(\"unmarshal sealed: %v\", err)\n386|\t\t\t}\n387|\t\t\tmutated := duplicateMemberJSON(t, sealed, rawMembers, target.member, nil)\n388|\t\t\terr := shape.decode(mutated)\n389|\t\t\trequireRefusal(t, err, shape.owner, \"duplicate member\")\n390|\t\t})\n391|\t}\n392|}\n393|\n394|// duplicateMemberJSON rebuilds the sealed object with one member\n395|// pair duplicated. Nested paths are out of scope for this helper:\n396|// every dup target names a member whose first raw occurrence sits\n397|// inside its own shape object, so duplicating at the top level of\n398|// the located object is exact. The path argument locates the nested\n399|// object raw for surgery.\n400|func duplicateMemberJSON(t *testing.T, sealed []byte, rawMembers map[string]json.RawMessage, member string, _ []string) []byte {\n401|\tt.Helper()\n402|\t_ = rawMembers\n403|\tkey := `\"` + member + `\":`\n404|\tindex := strings.Index(string(sealed), key)\n405|\tif index < 0 {\n406|\t\tt.Fatalf(\"member %q not found in sealed bytes\", member)\n407|\t}\n408|\t// Find the value extent by decoding the remainder.\n409|\trest := sealed[index+len(key):]\n410|\tdecoder := json.NewDecoder(strings.NewReader(string(rest)))\n411|\tvar raw json.RawMessage\n412|\tif err := decoder.Decode(&raw); err != nil {\n413|\t\tt.Fatalf(\"decode member value: %v\", err)\n414|\t}\n415|\tend := int(decoder.InputOffset())\n416|\tdup := fmt.Sprintf(`%s%s,%s%s`, key, strings.TrimSpace(string(rest[:end])), key, strings.TrimSpace(string(rest[:end])))\n417|\treturn []byte(string(sealed[:index]) + dup + string(sealed[index+len(key)+end:]))\n418|}\n419|\n420|// TestCensusShapeInventory pins the census coverage itself: 13\n421|// shapes and the exact member counts retyped from the spec.\n422|func TestCensusShapeInventory(t *testing.T) {\n423|\twant := map[string]int{\n424|\t\t\"plan\": 36, \"manifest\": 10, \"mapping\": 6, \"operation\": 5,\n425|\t\t\"resource\": 6, \"synth-event\": 4, \"transaction\": 4,\n426|\t\t\"read-back\": 5, \"resume\": 4, \"rollback\": 4, \"contract\": 2,\n427|\t\t\"blob-entry\": 7, \"directory-entry\": 4,\n428|\t}\n429|\tshapes := planCensusShapes()\n430|\tif len(shapes) != len(want) {\n431|\t\tt.Fatalf(\"census shapes = %d, want %d\", len(shapes), len(want))\n432|\t}\n433|\tvar labels []string\n434|\tfor _, shape := range shapes {\n435|\t\tlabels = append(labels, shape.label)\n436|\t\tif len(shape.members) != want[shape.label] {\n437|\t\t\tt.Errorf(\"shape %s members = %d, want %d\", shape.label, len(shape.members), want[shape.label])\n438|\t\t}\n439|\t}\n440|\tsort.Strings(labels)\n441|\tt.Logf(\"census shapes (%d): %s\", len(labels), strings.Join(labels, \", \"))\n442|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
