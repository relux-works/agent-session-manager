 one closed Projection Plan 1.0.0\n151|// as canonical bytes. Identical inputs produce byte-identical\n152|// outputs. Every closed-shape, vocabulary, branch, order, DAG, and\n153|// constant rule is a refusal, never a repair.\n154|func BuildProjectionPlan(input ProjectionPlanInput) ([]byte, error) {\n155|\t_, object, err := buildProjectionPlan(input)\n156|\tif err != nil {\n157|\t\treturn nil, err\n158|\t}\n159|\tomitted, err := canonicalizeObject(object)\n160|\tif err != nil {\n161|\t\treturn nil, err\n162|\t}\n163|\tplanID := scalar.SHA256Digest(omitted)\n164|\tobject[projectionPlanSelf] = planID.String()\n165|\treturn canonicalizeObject(object)\n166|}\n167|\n168|func buildProjectionPlan(input ProjectionPlanInput) (ProjectionPlan, map[string]any, error) {\n169|\towner := \"projection plan\"\n170|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n171|\tif err != nil {\n172|\t\treturn ProjectionPlan{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n173|\t}\n174|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n175|\tif err != nil {\n176|\t\treturn ProjectionPlan{}, nil, invalid(\"%s bundle_id is not a UUIDv7: %v\", owner, err)\n177|\t}\n178|\trequest, err := scalar.ParseDigest(input.RequestDigest)\n179|\tif err != nil {\n180|\t\treturn ProjectionPlan{}, nil, invalid(\"%s request_digest is not a digest: %v\", owner, err)\n181|\t}\n182|\tsnapshot, err := scalar.ParseDigest(input.SourceSnapshotDigest)\n183|\tif err != nil {\n184|\t\treturn ProjectionPlan{}, nil, invalid(\"%s source_snapshot_digest is not a digest: %v\", owner, err)\n185|\t}\n186|\tcaptureID, err := scalar.ParseDigest(input.CaptureManifestID)\n187|\tif err != nil {\n188|\t\treturn ProjectionPlan{}, nil, invalid(\"%s capture_manifest_id is not a digest: %v\", owner, err)\n189|\t}\n190|\tcanonicalID, err := scalar.ParseDigest(input.CanonicalSessionID)\n191|\tif err != nil {\n192|\t\treturn ProjectionPlan{}, nil, invalid(\"%s canonical_session_id is not a digest: %v\", owner, err)\n193|\t}\n194|\teventIDs, err := parseOrderedUniqueDigestStrings(input.CanonicalEventIDs, 0, 65536, owner, \"canonical_event_ids\")\n195|\tif err != nil {\n196|\t\treturn ProjectionPlan{}, nil, err\n197|\t}\n198|\tsourceTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n199|\tif err != nil {\n200|\t\treturn ProjectionPlan{}, nil, invalid(\"%s source_environment is not an Environment Tuple: %v\", owner, err)\n201|\t}\n202|\ttargetTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n203|\tif err != nil {\n204|\t\treturn ProjectionPlan{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n205|\t}\n206|\tif !validText(input.ExpectedTargetNativeSession) {\n207|\t\treturn ProjectionPlan{}, nil, invalid(\"%s expected_target_native_session_id is not valid UTF-8\", owner)\n208|\t}\n209|\tif length := stringLength(input.ExpectedTargetNativeSession); length < 1 || length > 512 {\n210|\t\treturn ProjectionPlan{}, nil, invalid(\"%s expected_target_native_session_id is not a string[1..512]\", owner)\n211|\t}\n212|\tworkspace, err := clonebundle.DecodeWorkspaceBinding(json.RawMessage(input.TargetWorkspace))\n213|\tif err != nil {\n214|\t\treturn ProjectionPlan{}, nil, invalid(\"%s target_workspace is not a Workspace Binding: %v\", owner, err)\n215|\t}\n216|\tvar workspaceValue any\n217|\tif err := json.Unmarshal(input.TargetWorkspace, &workspaceValue); err != nil {\n218|\t\treturn ProjectionPlan{}, nil, invalid(\"%s target_workspace is not a Workspace Binding: %v\", owner, err)\n219|\t}\n220|\tif !validText(input.Strategy) {\n221|\t\treturn ProjectionPlan{}, nil, invalid(\"%s strategy is not valid UTF-8\", owner)\n222|\t}\n223|\tif !ValidPlanStrategy(input.Strategy) {\n224|\t\treturn ProjectionPlan{}, nil, invalid(\"%s strategy is outside same_environment_native_rewrite|target_native_writer|target_official_import|continuation_context\", owner)\n225|\t}\n226|\tif !validText(input.StrategyRationale) {\n227|\t\treturn ProjectionPlan{}, nil, invalid(\"%s strategy_rationale is not valid UTF-8\", owner)\n228|\t}\n229|\tif length := stringLength(input.StrategyRationale); length < 1 || length > 4096 {\n230|\t\treturn ProjectionPlan{}, nil, invalid(\"%s strategy_rationale is not a string[1..4096]\", owner)\n231|\t}\n232|\tif !validText(input.FidelityProfile) {\n233|\t\treturn ProjectionPlan{}, nil, invalid(\"%s fidelity_profile is not valid UTF-8\", owner)\n234|\t}\n235|\tif !ValidPlanProfile(input.FidelityProfile) {\n236|\t\treturn ProjectionPlan{}, nil, invalid(\"%s fidelity_profile is outside strict_exact|maximal_safe|compact|messages_only\", owner)\n237|\t}\n238|\trequired, err := buildRequiredDispositions(input.RequiredDispositions)\n239|\tif err != nil {\n240|\t\treturn ProjectionPlan{}, nil, err\n241|\t}\n242|\tforbidden, err := checkSortedUniqueBoundedStrings(input.ForbidReasons, 1, 128, 0, 128, owner, \"forbid_reasons\")\n243|\tif err != nil {\n244|\t\treturn ProjectionPlan{}, nil, err\n245|\t}\n246|\tif err := checkMappingCount(len(input.ItemMappings)); err != nil {\n247|\t\treturn ProjectionPlan{}, nil, err\n248|\t}\n249|\tmappings := make([]ItemMapping, 0, len(input.ItemMappings))\n250|\tmappingObjects := make([]any, 0, len(input.ItemMappings))\n251|\tfor index, candidate := range input.ItemMappings {\n252|\t\tmapping, object, err := buildItemMapping(candidate, index)\n253|\t\tif err != nil {\n254|\t\t\treturn ProjectionPlan{}, nil, err\n255|\t\t}\n256|\t\tmappings = append(mappings, mapping)\n257|\t\tmappingObjects = append(mappingObjects, object)\n258|\t}\n259|\tif err := checkMappingOrder(mappings); err != nil {\n260|\t\treturn ProjectionPlan{}, nil, err\n261|\t}\n262|\tif err := checkOperationCount(len(input.TargetOperations)); err != nil {\n263|\t\treturn ProjectionPlan{}, nil, err\n264|\t}\n265|\toperations := make([]TargetOperation, 0, len(input.TargetOperations))\n266|\toperationObjects := make([]any, 0, len(input.TargetOperations))\n267|\tfor index, candidate := range input.TargetOperations {\n268|\t\toperation, object, err := buildTargetOperation(candidate, index)\n269|\t\tif err != nil {\n270|\t\t\treturn ProjectionPlan{}, nil, err\n271|\t\t}\n272|\t\toperations = append(operations, operation)\n273|\t\toperationObjects = append(operationObjects, object)\n274|\t}\n275|\tif err := checkOperationOrder(operations); err != nil {\n276|\t\treturn ProjectionPlan{}, nil, err\n277|\t}\n278|\tif err := checkOperationDAG(operations); err != nil {\n279|\t\treturn ProjectionPlan{}, nil, err\n280|\t}\n281|\tif err := checkExpectedResourceCount(len(input.ExpectedResources)); err != nil {\n282|\t\treturn ProjectionPlan{}, nil, err\n283|\t}\n284|\tresources := make([]ExpectedResource, 0, len(input.ExpectedResources))\n285|\tresourceObjects := make([]any, 0, len(input.ExpectedResources))\n286|\tfor index, candidate := range input.ExpectedResources {\n287|\t\tresource, object, err := buildExpectedResource(candidate, index)\n288|\t\tif err != nil {\n289|\t\t\treturn ProjectionPlan{}, nil, err\n290|\t\t}\n291|\t\tresources = append(resources, resource)\n292|\t\tresourceObjects = append(resourceObjects, object)\n293|\t}\n294|\tif err := checkExpectedResourceOrder(resources); err != nil {\n295|\t\treturn ProjectionPlan{}, nil, err\n296|\t}\n297|\tif err := checkSynthesizedEventCount(len(input.SynthesizedEvents)); err != nil {\n298|\t\treturn ProjectionPlan{}, nil, err\n299|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
