"resource_limits\":{\"max_events\":100`, `\"max_events\":100`,\n456|\t\t\tfunc(input *cloneplan.ProjectionPlanInput, bad string) { input.ResourceLimits = []byte(bad) }},\n457|\t}\n458|\tfor _, row := range raws {\n459|\t\tplan[row.path] = utf8PlanProbe{\n460|\t\t\tbuildRefuses: func(set func(*cloneplan.ProjectionPlanInput, string), token string) func(*testing.T, string) {\n461|\t\t\t\treturn func(t *testing.T, bad string) {\n462|\t\t\t\t\tinput := utf8PlanBaseline(t)\n463|\t\t\t\t\tset(&input, bad)\n464|\t\t\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n465|\t\t\t\t\trequireRefusalTokens(t, err, token)\n466|\t\t\t\t}\n467|\t\t\t}(row.set, row.token),\n468|\t\t\tanchor: []byte(row.anchor),\n469|\t\t\tvalue:  []byte(row.value),\n470|\t\t}\n471|\t}\n472|\n473|\t// Row members: one setter per row shape.\n474|\tmappingRows := []struct {\n475|\t\tpath, token, anchor, value string\n476|\t\tset                        func(*cloneplan.ItemMappingInput, string)\n477|\t}{\n478|\t\t{\"plan.ItemMappings[].SourceItemKey\", \"source_item_key is not valid UTF-8\",\n479|\t\t\t`\"source_item_key\":\"utf8-mapping\"`, \"utf8-mapping\",\n480|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) { row.SourceItemKey = bad }},\n481|\t\t{\"plan.ItemMappings[].CanonicalObjectID\", \"canonical_object_id is not a digest\",\n482|\t\t\t`\"canonical_object_id\":\"` + fixtureDigest(\"canonical-utf8-mapping\") + `\"`, fixtureDigest(\"canonical-utf8-mapping\"),\n483|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) { row.CanonicalObjectID = &bad }},\n484|\t\t{\"plan.ItemMappings[].TargetResourceKey[]\", \"target_resource_keys[0] is not valid UTF-8\",\n485|\t\t\t`\"target_resource_keys\":[\"utf8/mapping\"]`, \"utf8/mapping\",\n486|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) { row.TargetResourceKey = []string{bad} }},\n487|\t\t{\"plan.ItemMappings[].ExpectedDispos\", \"expected_disposition is not valid UTF-8\",\n488|\t\t\t`\"expected_disposition\":\"exact\"`, `\"expected_disposition\":\"exact\"`,\n489|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) { row.ExpectedDispos = bad }},\n490|\t\t{\"plan.ItemMappings[].ReasonCodes[]\", \"reason_codes[0] is not valid UTF-8\",\n491|\t\t\t`\"reason_codes\":[\"unknown_native_event\"]`, \"unknown_native_event\",\n492|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) { row.ReasonCodes = []string{bad} }},\n493|\t\t{\"plan.ItemMappings[].Extensions<key>\", \"extensions invalid\",\n494|\t\t\t`\"com.example.utf8mapping\":\"utf8mappingvalue\"`, \"com.example.utf8mapping\",\n495|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) {\n496|\t\t\t\trow.Extensions = map[string]any{bad: \"utf8mappingvalue\"}\n497|\t\t\t}},\n498|\t\t{\"plan.ItemMappings[].Extensions<value>\", \"extensions invalid\",\n499|\t\t\t`\"com.example.utf8mapping\":\"utf8mappingvalue\"`, \"utf8mappingvalue\",\n500|\t\t\tfunc(row *cloneplan.ItemMappingInput, bad string) {\n501|\t\t\t\trow.Extensions = map[string]any{\"com.example.utf8mapping\": bad}\n502|\t\t\t}},\n503|\t}\n504|\tfor _, row := range mappingRows {\n505|\t\tplan[row.path] = utf8PlanProbe{\n506|\t\t\tbuildRefuses: func(set func(*cloneplan.ItemMappingInput, string), token string) func(*testing.T, string) {\n507|\t\t\t\treturn func(t *testing.T, bad string) {\n508|\t\t\t\t\tinput := utf8PlanBaseline(t)\n509|\t\t\t\t\tmapping := input.ItemMappings[0]\n510|\t\t\t\t\tset(&mapping, bad)\n511|\t\t\t\t\tinput.ItemMappings = []cloneplan.ItemMappingInput{mapping}\n512|\t\t\t\t\t_, err := cloneplan.BuildProjectionPlan(input)\n513|\t\t\t\t\trequireRefusalTokens(t, err, token)\n514|\t\t\t\t}\n515|\t\t\t}(row.set, row.token),\n516|\t\t\tanchor: []byte(row.anchor),\n517|\t\t\tvalue:  []byte(row.value),\n518|\t\t}\n519|\t}\n(more lines below)","final_result":true}}}
