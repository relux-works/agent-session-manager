{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c725","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":493,"recorded_at":1780531400000981,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"call_id":"call_01a0d1281a2f7763b06aa92b99fdc23e","text":"Read text file `internal/cloneplan/decode.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// This file holds parse-only helpers for every Section 13.14.2\n17|// projection closed shape. Helpers report verdicts; every refusal\n18|// is constructed at the deciding site with a literal detail so each\n19|// rule stays a distinct gate. Strict object decoding, scalar\n20|// bounds, sorted-unique arrays, the reverse-DNS grammar, and the\n21|// SemVer grammar delegate to the landed environ owner; closed\n22|// extension values and the omit-self digest delegate to the\n23|// clonebundle owner; tuples, workspace bindings, and resource\n24|// limits decode through their owners at the call site.\n25|\n26|const maxUint53 = uint64(1<<53 - 1)\n27|\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n34|\tmembers, fault := environ.DecodeStrictObject(data)\n35|\tif fault != nil {\n36|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n37|\t}\n38|\treturn members, nil\n39|}\n40|\n41|func memberField(member string) string {\n42|\tif member == \"\" {\n43|\t\treturn \"frame\"\n44|\t}\n45|\treturn \"member \" + member\n46|}\n47|\n48|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n49|\tfor name := range members {\n50|\t\tif !allowed[name] {\n51|\t\t\treturn name, true\n52|\t\t}\n53|\t}\n54|\treturn \"\", false\n55|}\n56|\n57|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n58|\tfor _, name := range required {\n59|\t\tif _, present := members[name]; !present {\n60|\t\t\treturn name, true\n61|\t\t}\n62|\t}\n63|\treturn \"\", false\n64|}\n65|\n66|func rawString(raw json.RawMessage) (string, bool) {\n67|\t// encoding/json unmarshals null into a string without an error,\n68|\t// so null is rejected explicitly: every string member here is\n69|\t// required non-null (nullable members branch on isNull first).\n70|\tif isNull(raw) {\n71|\t\treturn \"\", false\n72|\t}\n73|\tvar value string\n74|\tif err := json.Unmarshal(raw, &value); err != nil {\n75|\t\treturn \"\", false\n76|\t}\n77|\treturn value, true\n78|}\n79|\n80|func rawBool(raw json.RawMessage) (bool, bool) {\n81|\t// encoding/json unmarshals null into a bool without an error,\n82|\t// so null is rejected explicitly: a missing boolean is never a\n83|\t// false one.\n84|\tif isNull(raw) {\n85|\t\treturn false, false\n86|\t}\n87|\tvar value bool\n88|\tif err := json.Unmarshal(raw, &value); err != nil {\n89|\t\treturn false, false\n90|\t}\n91|\treturn value, true\n92|}\n93|\n94|// stringLength is the Section 1.6 string measure in characters, not\n95|// bytes. It delegates to the single environ measure so the two can\n96|// never drift.\n97|func stringLength(value string) int {\n98|\treturn environ.StringLength(value)\n99|}\n100|\n101|// checkStringBounds reports whether the member is a JSON string\n102|// whose character count falls in the inclusive bound. It delegates\n103|// to the environ gate.\n104|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n105|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n106|}\n107|\n108|// checkUint53Bounds reports whether the member is a uint53 in the\n109|// inclusive bound. It delegates to the environ gate.\n110|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n111|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n112|}\n113|\n114|// checkDigest reports whether the member is a digest of the pinned\n115|// sha256 form. It delegates to the environ gate.\n116|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n117|\treturn environ.CheckDigest(raw)\n118|}\n119|\n120|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n121|// delegates to the environ gate.\n122|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n123|\treturn environ.CheckUUIDv7(raw)\n124|}\n125|\n126|// checkSortedUniqueStrings reports whether the member is an array of\n127|// strings in the item bound whose order is strictly increasing with\n128|// no duplicates. It delegates to the environ gate.\n129|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n130|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n131|}\n132|\n133|// checkSortedUniqueDigests reports whether the member is a sorted\n134|// unique digest array in the count bound. It delegates to the\n135|// environ gate.\n136|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n137|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n138|}\n139|\n140|func isNull(raw json.RawMessage) bool {\n141|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n142|}\n143|\n144|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n145|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n146|\ttoken, err := decoder.Token()\n147|\tif err != nil {\n148|\t\treturn nil, false\n149|\t}\n150|\tdelimiter, ok := token.(json.Delim)\n151|\tif !ok || delimiter != '[' {\n152|\t\treturn nil, false\n153|\t}\n154|\tvar elements []json.RawMessage\n155|\tfor decoder.More() {\n156|\t\tvar element json.RawMessage\n157|\t\tif err := decoder.Decode(&element); err != nil {\n158|\t\t\treturn nil, false\n159|\t\t}\n160|\t\telements = append(elements, element)\n161|\t}\n162|\ttoken, err = decoder.Token()\n163|\tif err != nil {\n164|\t\treturn nil, false\n165|\t}\n166|\tdelimiter, ok = token.(json.Delim)\n167|\tif !ok || delimiter != ']' {\n168|\t\treturn nil, false\n169|\t}\n170|\tif _, err := decoder.Token(); err != io.EOF {\n171|\t\treturn nil, false\n172|\t}\n173|\tif elements == nil {\n174|\t\telements = []json.RawMessage{}\n175|\t}\n176|\treturn elements, true\n177|}\n178|\n179|// validText reports whether the value is valid UTF-8 text. Section\n180|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n181|// rewrites invalid bytes to U+FFFD instead of failing — so every\n182|// Build-side string admission runs this gate BEFORE marshaling, and\n183|// refuses what it cannot seal byte-exactly.\n184|func validText(value string) bool {\n185|\treturn utf8.ValidString(value)\n186|}\n187|\n188|// checkExtensionsClosed enforces the full closed extensions rule via\n189|// the clonebundle owner: reverse-DNS keys and values inside the AX\n190|// common logical data model. It returns nil when the member is\n191|// closed, otherwise the refusal detail naming the failed rule.\n192|func checkExtensionsClosed(raw json.RawMessage) error {\n193|\treturn clonebundle.CheckExtensionsClosed(raw)\n194|}\n195|\n196|// canonicalizeObject renders one closed object deterministically:\n197|// the members marshal in any order and the JCS transform sorts\n198|// them, so identical logical inputs always produce identical bytes.\n199|func canonicalizeObject(object map[string]any) ([]byte, error) {\n200|\tplain, err := json.Marshal(object)\n201|\tif err != nil {\n202|\t\treturn nil, invalid(\"serialize projection object: %v\", err)\n203|\t}\n204|\tcanonical, err := canonicaljson.Canonicalize(plain)\n205|\tif err != nil {\n206|\t\treturn nil, invalid(\"canonicalize projection object: %v\", err)\n207|\t}\n208|\treturn canonical, nil\n209|}\n210|\n211|// verifySelfDigest recomputes the omit-self identity through the\n212|// clonebundle owner and refuses a mismatch against the claimed self\n213|// digest.\n214|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n215|\tcalculated, err := clonebundle.OmitSelfDigest(members, selfField)\n216|\tif err != nil {\n217|\t\treturn err\n218|\t}\n219|\tif calculated != claimed {\n220|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n221|\t}\n222|\treturn nil\n223|}\n224|\n225|// checkSortedUniqueReasonStrings reports whether the caller-supplied\n226|// Build input is sorted unique ValidReasonCode strings in the item\n227|// bound. It mirrors the decode reason gate for Go inputs: UTF-8\n228|// first (so nothing seals rewritten), then character bounds, then\n229|// order, then vocabulary.\n230|func checkSortedUniqueReasonStrings(values []string, minimumCount, maximumCount int, owner string) ([]string, error) {\n231|\tif len(values) < minimumCount || len(values) > maximumCount {\n232|\t\treturn nil, invalid(\"%s carries %d reason_codes, want [%d..%d]\", owner, len(values), minimumCount, maximumCount)\n233|\t}\n234|\tprevious := \"\"\n235|\tfor index, reason := range values {\n236|\t\tif !validText(reason) {\n237|\t\t\treturn nil, invalid(\"%s reason_codes[%d] is not valid UTF-8\", owner, index)\n238|\t\t}\n239|\t\tif length := stringLength(reason); length < 1 || length > 128 {\n240|\t\t\treturn nil, invalid(\"%s reason_codes[%d] is not a string[1..128]\", owner, index)\n241|\t\t}\n242|\t\tif !clonefidelity.ValidReasonCode(reason) {\n243|\t\t\treturn nil, invalid(\"%s reason_codes[%d] %q is outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n244|\t\t}\n245|\t\tif index > 0 && reason <= previous {\n246|\t\t\treturn nil, invalid(\"%s reason_codes are not sorted unique\", owner)\n247|\t\t}\n248|\t\tprevious = reason\n249|\t}\n250|\treturn values, nil\n251|}\n252|\n253|// checkSortedUniqueBoundedStrings reports whether the\n254|// caller-supplied Build input is sorted unique strings in the\n255|// character and count bounds. Ordering and measure delegate to the\n256|// same rules the environ JSON gate enforces.\n257|func checkSortedUniqueBoundedStrings(values []string, minimumLength, maximumLength int, minimumCount, maximumCount int, owner, member string) ([]string, error) {\n258|\tif len(values) < minimumCount || len(values) > maximumCount {\n259|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimumCount, maximumCount)\n260|\t}\n261|\tprevious := \"\"\n262|\tfor index, value := range values {\n263|\t\tif !validText(value) {\n264|\t\t\treturn nil, invalid(\"%s %s[%d] is not valid UTF-8\", owner, member, index)\n265|\t\t}\n266|\t\tif length := stringLength(value); length < minimumLength || length > maximumLength {\n267|\t\t\treturn nil, invalid(\"%s %s[%d] is not a string[%d..%d]\", owner, member, index, minimumLength, maximumLength)\n268|\t\t}\n269|\t\tif index > 0 && value <= previous {\n270|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n271|\t\t}\n272|\t\tprevious = value\n273|\t}\n274|\treturn values, nil\n275|}\n276|\n277|// parseSortedUniqueDigestStrings reports whether the\n278|// caller-supplied Build input is sorted unique digests in the count\n279|// bound.\n280|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, owner, member string) ([]scalar.Digest, error) {\n281|\tif len(values) < minimum || len(values) > maximum {\n282|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimum, maximum)\n283|\t}\n284|\tids := make([]scalar.Digest, 0, len(values))\n285|\tprevious := \"\"\n286|\tfor index, value := range values {\n287|\t\tid, err := scalar.ParseDigest(value)\n288|\t\tif err != nil {\n289|\t\t\treturn nil, invalid(\"%s %s[%d] is not a digest: %v\", owner, member, index, err)\n290|\t\t}\n291|\t\tif index > 0 && id.String() <= previous {\n292|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n293|\t\t}\n294|\t\tprevious = id.String()\n295|\t\tids = append(ids, id)\n296|\t}\n297|\treturn ids, nil\n298|}\n299|\n300|// parseOrderedUniqueDigestStrings reports whether the\n301|// caller-supplied Build input is unique digests in the count bound.\n302|// Order is preserved, never sorted: canonical_event_ids follow\n303|// Canonical Session order, not lexicographic order.\n304|func parseOrderedUniqueDigestStrings(values []string, minimum, maximum int, owner, member string) ([]scalar.Digest, error) {\n305|\tif len(values) < minimum || len(values) > maximum {\n306|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimum, maximum)\n307|\t}\n308|\tids := make([]scalar.Digest, 0, len(values))\n309|\tseen := make(map[string]bool, len(values))\n310|\tfor index, value := range values {\n311|\t\tid, err := scalar.ParseDigest(value)\n312|\t\tif err != nil {\n313|\t\t\treturn nil, invalid(\"%s %s[%d] is not a digest: %v\", owner, member, index, err)\n314|\t\t}\n315|\t\tif seen[id.String()] {\n316|\t\t\treturn nil, invalid(\"%s %s are not unique\", owner, member)\n317|\t\t}\n318|\t\tseen[id.String()] = true\n319|\t\tids = append(ids, id)\n320|\t}\n321|\treturn ids, nil\n322|}\n323|\n324|// checkSortedUniqueUint53s reports whether the member is an array of\n325|// uint53 values in the element bound whose order is strictly\n326|// increasing with no duplicates, with the array length in the count\n327|// bound. Element parsing delegates to the environ uint53 gate so\n328|// the AX number model (no fractions, exponents, or values at or\n329|// beyond 2^53) is enforced per element.\n330|func checkSortedUniqueUint53s(raw json.RawMessage, minimumElement, maximumElement uint64, minimumCount, maximumCount int, owner, member string) ([]uint64, error) {\n331|\telements, ok := decodeArray(raw)\n332|\tif !ok {\n333|\t\treturn nil, invalid(\"%s %s is not an array\", owner, member)\n334|\t}\n335|\tif len(elements) < minimumCount || len(elements) > maximumCount {\n336|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(elements), member, minimumCount, maximumCount)\n337|\t}\n338|\tvalues := make([]uint64, 0, len(elements))\n339|\tfor index, element := range elements {\n340|\t\tvalue, ok := checkUint53Bounds(element, minimumElement, maximumElement)\n341|\t\tif !ok {\n342|\t\t\treturn nil, invalid(\"%s %s[%d] is not a uint53\", owner, member, index)\n343|\t\t}\n344|\t\tif index > 0 && value <= values[index-1] {\n345|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n346|\t\t}\n347|\t\tvalues = append(values, value)\n348|\t}\n349|\treturn values, nil\n350|}\n351|\n352|// checkSortedUniqueUint53Inputs reports whether the caller-supplied\n353|// Build input is sorted unique uint53 values in the element and\n354|// count bounds.\n355|func checkSortedUniqueUint53Inputs(values []uint64, minimumElement, maximumElement uint64, minimumCount, maximumCount int, owner, member string) ([]uint64, error) {\n356|\tif len(values) < minimumCount || len(values) > maximumCount {\n357|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimumCount, maximumCount)\n358|\t}\n359|\tfor index, value := range values {\n360|\t\tif value < minimumElement || value > maximumElement {\n361|\t\t\treturn nil, invalid(\"%s %s[%d] is not a uint53\", owner, member, index)\n362|\t\t}\n363|\t\tif index > 0 && value <= values[index-1] {\n364|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n365|\t\t}\n366|\t}\n367|\treturn values, nil\n368|}\n369|\n370|func digestStrings(ids []scalar.Digest) []any {\n371|\tout := make([]any, 0, len(ids))\n372|\tfor _, id := range ids {\n373|\t\tout = append(out, id.String())\n374|\t}\n375|\treturn out\n376|}\n377|\n378|func stringValues(values []string) []any {\n379|\tout := make([]any, 0, len(values))\n380|\tfor _, value := range values {\n381|\t\tout = append(out, value)\n382|\t}\n383|\treturn out\n384|}\n385|\n386|func uintValues(values []uint64) []any {\n387|\tout := make([]any, 0, len(values))\n388|\tfor _, value := range values {\n389|\t\tout = append(out, value)\n390|\t}\n391|\treturn out\n392|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c727","stream":{"kind":"session","id":"01a0d127-0511-7921-a79b-fbe9b8416c0a"},"sequence":494,"recorded_at":1780531400000983,"record_type":"event","durability":"durable","causation_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2935b83d-2af1-400b-8bec-61864cd8ed2c","run_stream":{"kind":"run","id":"2935b83d-2af1-400b-8bec-61864cd8ed2c"},"call_id":"call_01a0d1281ba571b285878159c96b8562","text":"Read text file `internal/cloneplan/operations.go`.\n1|package cloneplan\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|)\n9|\n10|// This file validates and constructs ProjectionTargetOperation: the\n11|// closed sequenced target step Section 13.14.2 states. Operations\n12|// are ordered by sequence, and every dependency names a strictly\n13|// lower existing sequence, which makes the dependency graph a DAG\n14|// by construction: a cycle would need an edge that is not strictly\n15|// decreasing.\n16|\n17|var targetOperationMembers = map[string]bool{\n18|\t\"sequence\":             true,\n19|\t\"action\":               true,\n20|\t\"resource_keys\":        true,\n21|\t\"depends_on_sequences\": true,\n22|\t\"extensions\":           true,\n23|}\n24|\n25|var targetOperationRequired = []string{\n26|\t\"sequence\",\n27|\t\"action\",\n28|\t\"resource_keys\",\n29|\t\"depends_on_sequences\",\n30|\t\"extensions\",\n31|}\n32|\n33|// TargetOperation is one validated projection target operation.\n34|type TargetOperation struct {\n35|\tSequence           uint64\n36|\tAction             string\n37|\tResourceKeys       []string\n38|\tDependsOnSequences []uint64\n39|}\n40|\n41|// TargetOperationInput is the caller-supplied target operation\n42|// candidate for Build.\n43|type TargetOperationInput struct {\n44|\tSequence           uint64\n45|\tAction             string\n46|\tResourceKeys       []string\n47|\tDependsOnSequences []uint64\n48|\tExtensions         map[string]any\n49|}\n50|\n51|// buildTargetOperation validates one caller-supplied operation and\n52|// renders its closed object. Sequence positivity, the action\n53|// vocabulary, and the sorted-unique arrays are refusals here; the\n54|// cross-operation order and DAG rules run over the sealed set in\n55|// checkOperationOrder and checkOperationDAG.\n56|func buildTargetOperation(input TargetOperationInput, index int) (TargetOperation, map[string]any, error) {\n57|\towner := fmt.Sprintf(\"projection target operation[%d]\", index)\n58|\tif input.Sequence == 0 || input.Sequence > maxUint53 {\n59|\t\treturn TargetOperation{}, nil, invalid(\"%s sequence is not a uint53>0\", owner)\n60|\t}\n61|\tif !validText(input.Action) {\n62|\t\treturn TargetOperation{}, nil, invalid(\"%s action is not valid UTF-8\", owner)\n63|\t}\n64|\tif !ValidOperationAction(input.Action) {\n65|\t\treturn TargetOperation{}, nil, invalid(\"%s action is outside create_directory|write_blob|write_native_record|rebuild_index\", owner)\n66|\t}\n67|\tkeys, err := checkSortedUniqueBoundedStrings(input.ResourceKeys, 1, 512, 1, 65536, owner, \"resource_keys\")\n68|\tif err != nil {\n69|\t\treturn TargetOperation{}, nil, err\n70|\t}\n71|\tdepends, err := checkSortedUniqueUint53Inputs(input.DependsOnSequences, 0, maxUint53, 0, 65536, owner, \"depends_on_sequences\")\n72|\tif err != nil {\n73|\t\treturn TargetOperation{}, nil, err\n74|\t}\n75|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n76|\t\treturn TargetOperation{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n77|\t}\n78|\textensions := input.Extensions\n79|\tif extensions == nil {\n80|\t\textensions = map[string]any{}\n81|\t}\n82|\treturn TargetOperation{\n83|\t\t\tSequence:           input.Sequence,\n84|\t\t\tAction:             input.Action,\n85|\t\t\tResourceKeys:       keys,\n86|\t\t\tDependsOnSequences: depends,\n87|\t\t}, map[string]any{\n88|\t\t\t\"sequence\":             input.Sequence,\n89|\t\t\t\"action\":               input.Action,\n90|\t\t\t\"resource_keys\":        stringValues(keys),\n91|\t\t\t\"depends_on_sequences\": uintValues(depends),\n92|\t\t\t\"extensions\":           extensions,\n93|\t\t}, nil\n94|}\n95|\n96|// decodeTargetOperation validates one closed\n97|// ProjectionTargetOperation.\n98|func decodeTargetOperation(raw json.RawMessage, index int) (TargetOperation, error) {\n99|\towner := \"projection target operation\"\n100|\tmembers, fault := decodeStrictObject(raw)\n101|\tif fault != nil {\n102|\t\treturn TargetOperation{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n103|\t}\n104|\tif name, unknown := unknownMember(members, targetOperationMembers); unknown {\n105|\t\treturn TargetOperation{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n106|\t}\n107|\tif name, missing := missingMember(members, targetOperationRequired); missing {\n108|\t\treturn TargetOperation{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n109|\t}\n110|\tsequence, ok := checkUint53Bounds(members[\"sequence\"], 1, maxUint53)\n111|\tif !ok {\n112|\t\treturn TargetOperation{}, invalid(\"%s[%d] sequence is not a uint53>0\", owner, index)\n113|\t}\n114|\taction, ok := rawString(members[\"action\"])\n115|\tif !ok || !ValidOperationAction(action) {\n116|\t\treturn TargetOperation{}, invalid(\"%s[%d] action is outside create_directory|write_blob|write_native_record|rebuild_index\", owner, index)\n117|\t}\n118|\tkeys, ok := checkSortedUniqueStrings(members[\"resource_keys\"], 1, 512, 1, 65536)\n119|\tif !ok {\n120|\t\treturn TargetOperation{}, invalid(\"%s[%d] resource_keys are not sorted unique string[1..512][1..65536]\", owner, index)\n121|\t}\n122|\trowOwner := fmt.Sprintf(\"%s[%d]\", owner, index)\n123|\tdepends, err := checkSortedUniqueUint53s(members[\"depends_on_sequences\"], 0, maxUint53, 0, 65536, rowOwner, \"depends_on_sequences\")\n124|\tif err != nil {\n125|\t\treturn TargetOperation{}, err\n126|\t}\n127|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n128|\t\treturn TargetOperation{}, invalid(\"%s[%d] extensions %s\", owner, index, extensionsFault)\n129|\t}\n130|\treturn TargetOperation{\n131|\t\tSequence:           sequence,\n132|\t\tAction:             action,\n133|\t\tResourceKeys:       keys,\n134|\t\tDependsOnSequences: depends,\n135|\t}, nil\n136|}\n137|\n138|// checkOperationOrder enforces \"ordered by sequence\": sequences are\n139|// strictly increasing, so no two operations share a sequence. Both\n140|// entries share this gate over the sealed operation set.\n141|func checkOperationOrder(operations []TargetOperation) error {\n142|\tfor index := 1; index < len(operations); index++ {\n143|\t\tif operations[index].Sequence <= operations[index-1].Sequence {\n144|\t\t\treturn invalid(\"projection plan target_operations are not ordered by sequence\")\n145|\t\t}\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// checkOperationDAG enforces \"Dependencies are lower sequences and\n151|// form a DAG\": every dependency names a strictly lower sequence\n152|// that an operation in this plan carries. Strict decrease along\n153|// every edge admits no cycle and no self-edge, so a set passing\n154|// this gate is a DAG over the plan operations. Both entries share\n155|// this gate over the sealed operation set.\n156|func checkOperationDAG(operations []TargetOperation) error {\n157|\tpresent := make(map[uint64]bool, len(operations))\n158|\tfor _, operation := range operations {\n159|\t\tpresent[operation.Sequence] = true\n160|\t}\n161|\tfor _, operation := range operations {\n162|\t\tfor _, dependency := range operation.DependsOnSequences {\n163|\t\t\tif dependency >= operation.Sequence {\n164|\t\t\t\treturn invalid(\"projection plan target operation %d depends on sequence %d, want a lower sequence\", operation.Sequence, dependency)\n165|\t\t\t}\n166|\t\t\tif !present[dependency] {\n167|\t\t\t\treturn invalid(\"projection plan target operation %d depends on absent sequence %d\", operation.Sequence, dependency)\n168|\t\t\t}\n169|\t\t}\n170|\t}\n171|\treturn nil\n172|}\n173|\n174|// checkOperationCount enforces the target_operations cardinality\n175|// bound ProjectionTargetOperation[1..65536]. The gate is factored\n176|// so the exact upper edge pins at the gate while entry reachability\n177|// pins at both entries.\n178|func checkOperationCount(count int) error {\n179|\tif count < 1 || count > 65536 {\n180|\t\treturn invalid(\"projection plan carries %d target_operations, want [1..65536]\", count)\n181|\t}\n182|\treturn nil\n183|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
