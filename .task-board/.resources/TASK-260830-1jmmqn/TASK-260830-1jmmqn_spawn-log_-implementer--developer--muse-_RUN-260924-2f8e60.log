{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd59","stream":{"kind":"session","id":"01a0d21a-4b2b-71c2-bc0c-518fae23454a"},"sequence":1287,"recorded_at":1780531400002569,"record_type":"event","durability":"durable","causation_id":"74ccd5d2-939d-4d79-8bb1-4e7bedb0dad5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"74ccd5d2-939d-4d79-8bb1-4e7bedb0dad5","run_stream":{"kind":"run","id":"74ccd5d2-939d-4d79-8bb1-4e7bedb0dad5"},"task_stream":{"kind":"task","id":"01a0d223-d0a5-7122-bd34-e845cf39f99c"},"task_id":"01a0d223-d0a5-7122-bd34-e845cf39f99c","event":{"kind":"output","task_id":"01a0d223-d0a5-7122-bd34-e845cf39f99c","chunk":"Read text file `internal/cloneplan/plan.go`.\n(553 line(s) above)\n554|func DecodeProjectionPlan(data []byte) (ProjectionPlan, error) {\n555|\towner := \"projection plan\"\n556|\tmembers, fault := decodeStrictObject(data)\n557|\tif fault != nil {\n558|\t\treturn ProjectionPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n559|\t}\n560|\tif name, unknown := unknownMember(members, projectionPlanMembers); unknown {\n561|\t\treturn ProjectionPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n562|\t}\n563|\tif name, missing := missingMember(members, projectionPlanRequired); missing {\n564|\t\treturn ProjectionPlan{}, invalid(\"%s misses a required member %q\", owner, name)\n565|\t}\n566|\tschema, ok := rawString(members[\"schema\"])\n567|\tif !ok || schema != projectionPlanSchema {\n568|\t\treturn ProjectionPlan{}, invalid(\"%s schema is not urn:ax:schema:projection-plan\", owner)\n569|\t}\n570|\tversion, ok := rawString(members[\"schema_version\"])\n571|\tif !ok || version != projectionPlanVersion {\n572|\t\treturn ProjectionPlan{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n573|\t}\n574|\tclaimed, ok := checkDigest(members[\"projection_plan_id\"])\n575|\tif !ok {\n576|\t\treturn ProjectionPlan{}, invalid(\"%s projection_plan_id is not a digest\", owner)\n577|\t}\n578|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n579|\tif !ok {\n580|\t\treturn ProjectionPlan{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n581|\t}\n582|\tbundle, ok := checkUUIDv7(members[\"bundle_id\"])\n583|\tif !ok {\n584|\t\treturn ProjectionPlan{}, invalid(\"%s bundle_id is not a UUIDv7\", owner)\n585|\t}\n586|\trequest, ok := checkDigest(members[\"request_digest\"])\n587|\tif !ok {\n588|\t\treturn ProjectionPlan{}, invalid(\"%s request_digest is not a digest\", owner)\n589|\t}\n590|\tsnapshot, ok := checkDigest(members[\"source_snapshot_digest\"])\n591|\tif !ok {\n592|\t\treturn ProjectionPlan{}, invalid(\"%s source_snapshot_digest is not a digest\", owner)\n593|\t}\n594|\tcaptureID, ok := checkDigest(members[\"capture_manifest_id\"])\n595|\tif !ok {\n596|\t\treturn ProjectionPlan{}, invalid(\"%s capture_manifest_id is not a digest\", owner)\n597|\t}\n598|\tcanonicalID, ok := checkDigest(members[\"canonical_session_id\"])\n599|\tif !ok {\n600|\t\treturn ProjectionPlan{}, invalid(\"%s canonical_session_id is not a digest\", owner)\n601|\t}\n602|\teventIDs, err := decodeOrderedUniqueDigests(members[\"canonical_event_ids\"], 0, 65536, owner, \"canonical_event_ids\")\n603|\tif err != nil {\n604|\t\treturn ProjectionPlan{}, err\n605|\t}\n606|\tsourceTuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n607|\tif err != nil {\n608|\t\treturn ProjectionPlan{}, invalid(\"%s source_environment is not an Environment Tuple: %v\", owner, err)\n609|\t}\n610|\ttargetTuple, err := sessadapter.DecodeTuple(members[\"target_environment\"])\n611|\tif err != nil {\n612|\t\treturn ProjectionPlan{}, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n613|\t}\n614|\tnativeID, ok := checkStringBounds(members[\"expected_target_native_session_id\"], 1, 512)\n615|\tif !ok {\n616|\t\treturn ProjectionPlan{}, invalid(\"%s expected_target_native_session_id is not a string[1.