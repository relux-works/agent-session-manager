tionPlan{}, invalid(\"%s target_workspace is not a Workspace Binding: %v\", owner, err)\n621|\t}\n622|\tstrategy, ok := rawString(members[\"strategy\"])\n623|\tif !ok || !ValidPlanStrategy(strategy) {\n624|\t\treturn ProjectionPlan{}, invalid(\"%s strategy is outside same_environment_native_rewrite|target_native_writer|target_official_import|continuation_context\", owner)\n625|\t}\n626|\trationale, ok := checkStringBounds(members[\"strategy_rationale\"], 1, 4096)\n627|\tif !ok {\n628|\t\treturn ProjectionPlan{}, invalid(\"%s strategy_rationale is not a string[1..4096]\", owner)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
