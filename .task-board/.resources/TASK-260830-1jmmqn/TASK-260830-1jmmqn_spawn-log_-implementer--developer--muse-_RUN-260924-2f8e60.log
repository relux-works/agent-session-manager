{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77d","stream":{"kind":"session","id":"01a0d21a-4b2b-71c2-bc0c-518fae23454a"},"sequence":537,"recorded_at":1780531400001069,"record_type":"event","durability":"durable","causation_id":"74ccd5d2-939d-4d79-8bb1-4e7bedb0dad5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"74ccd5d2-939d-4d79-8bb1-4e7bedb0dad5","run_stream":{"kind":"run","id":"74ccd5d2-939d-4d79-8bb1-4e7bedb0dad5"},"task_stream":{"kind":"task","id":"01a0d21c-9519-7341-8bbf-4b505c9c0c6e"},"task_id":"01a0d21c-9519-7341-8bbf-4b505c9c0c6e","event":{"kind":"output","task_id":"01a0d21c-9519-7341-8bbf-4b505c9c0c6e","chunk":"Read text file `internal/traceability/cmd/tracecheck/main_test.go`.\n(329 line(s) above)\n330|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n331|\t\tt.Fatalf(\"missing-production tracecheck error = %v output = %q, want refusal containing %q and no success output\", err, output, want)\n332|\t}\n333|\n334|\toutput, err = runTracecheck(t, fixtureRoot, \"-section\", \"6.2\")\n335|\tif err != nil || !strings.Contains(output, \"assigned_scopes=1\") {\n336|\t\tt.Fatalf(\"unrelated assigned tracecheck error = %v output = %q, want green section:6.2 binding\", err, output)\n337|\t}\n338|}\n339|\n340|// TestMainRejectsSyntacticallyValidNonexistentV070Section drives the production\n341|// main -> run -> traceability.VerifyAssignedSections call chain. A plausible\n342|// subsection must not inherit the top-level owner unless that exact identifier\n343|// exists in the immutable v0.7.0 inventory. A real but still unowned section\n344|// remains a separate refusal shape.\n345|func TestMainRejectsSyntacticallyValidNonexistentV070Section(t *testing.T) {\n346|\tif testing.Short() {\n347|\t\tt.Skip(\"launches the production tracecheck entry point\")\n348|\t}\n349|\n350|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n351|\toutput, err := runTracecheck(t, repositoryRoot, \"-section\", \"10.999\")\n352|\twant := `assigned section \"10.999\" is not a real v0.7.0 section identifier`\n353|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n354|\t\tt.Fatalf(\"tracecheck -section 10.999 error = %v output = %q, want refusal %q and no success output\", err, output, want)\n355|\t}\n356|\n357|\toutput, err = runTracecheck(t, repositoryRoot, \"-section\", \"10.5\")\n358|\twant = `assigned section \"10.5\" binding \"section:10.5\" has no scoped implementation owner`\n359|\tif err == nil || !strings.Contains(output, want) || strings.Contains(output, \"traceability ok:\") {\n360|\t\tt.Fatalf(\"tracecheck -section 10.5 error = %v output = %q, want refusal %q and no success output\", err, output, want)\n361|\t}\n362|}\n363|\n364|func TestRunRejectsRegisteredContractWithoutImplementationOwner(t *testing.T) {\n365|\tt.Parallel()\n366|\n367|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n368|\tfixtureRoot := t.TempDir()\n369|\tif err := os.CopyFS(\n370|\t\tfilepath.Join(fixtureRoot, \"internal\"),\n371|\t\tos.DirFS(filepath.Join(repositoryRoot, \"internal\")),\n372|\t); err != nil {\n373|\t\tt.Fatalf(\"copy repository fixture: %v\", err)\n374|\t}\n375|\n376|\tregistryPath := filepath.Join(fixtureRoot, \"internal\", \"traceability\", \"ownership.v0.7.0.json\")\n377|\tregistry, err := os.ReadFile(registryPath)\n378|\tif err != nil {\n379|\t\tt.Fatalf(\"read ownership registry fixture: %v\", err)\n380|\t}\n381|\tconst contract = \"Session Directory Query [urn:ax:schema:session-directory-query]\"\n382|\towner := []byte(\",\\n        \\\"\" + contract + \"\\\"\")\n383|\tif count := bytes.Count(registry, owner); count != 1 {\n384|\t\tt.Fatalf(\"ownership registry contains contract owner %q %d times, want exactly once\", contract, count)\n385|\t}\n386|\tif err := os.WriteFile(registryPath, bytes.Replace(registry, owner, nil, 1), 0o644); err != nil {\n387|\t\tt.Fatalf(\"write narrowed ownership registry fixture: %v\", err)\n388|\t}\n389|\n390|\tvar output bytes.Buffer\n391|\terr = run([]string{\"-root\", fixtureRoot}, &output)\n392|\twant := \"registered contract \\\"\" + contract + \"\\\" has no implementation owner\"\n393|\tif err == nil || !errors.Is(err, traceability.ErrTraceability) || !strings.Contains(err.Error(), want) {\n394|\t\tt.Fatalf(\"run(missing contract owner) error = %v, want ErrTraceability containing %q\", err, want)\n395|\t}\n396|\tif output.Len() != 0 {\n397|\t\tt.Fatalf(\"failed ownership run emitted success output %q\", output.String())\n398|\t}\n399|}\n400|\n401|type failingWriter struct {\n402|\terr error\n403|}\n404|\n405|func copyFile(t *testing.T, source, destination string) {\n406|\tt.Helper()\n407|\tvalue, err := os.ReadFile(source)\n408|\tif err != nil {\n409|\t\tt.Fatalf(\"read %q: %v\", source, err)\n(more lines below)","final_result":true}}}
