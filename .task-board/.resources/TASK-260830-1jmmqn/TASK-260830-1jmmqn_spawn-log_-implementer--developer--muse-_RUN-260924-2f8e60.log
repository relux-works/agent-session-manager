wner)\n160|\t}\n161|\tif input.MaterializationIntent != \"clone\" {\n162|\t\treturn TransactionPlan{}, nil, invalid(\"%s materialization_intent is not clone\", owner)\n163|\t}\n164|\tif !validText(input.TargetCollisionPolicy) {\n165|\t\treturn TransactionPlan{}, nil, invalid(\"%s target_collision_policy is not valid UTF-8\", owner)\n166|\t}\n167|\tif input.TargetCollisionPolicy != \"must_be_absent\" {\n168|\t\treturn TransactionPlan{}, nil, invalid(\"%s target_collision_policy is not must_be_absent\", owner)\n169|\t}\n170|\tif !validText(input.Activation) {\n171|\t\treturn TransactionPlan{}, nil, invalid(\"%s activation is not valid UTF-8\", owner)\n172|\t}\n173|\tif input.Activation != \"dormant_validated\" {\n174|\t\treturn TransactionPlan{}, nil, invalid(\"%s activation is not dormant_validated\", owner)\n175|\t}\n176|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n177|\t\treturn TransactionPlan{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n178|\t}\n179|\textensions := input.Extensions\n180|\tif extensions == nil {\n181|\t\textensions = map[string]any{}\n182|\t}\n183|\treturn TransactionPlan{}, map[string]any{\n184|\t\t\"materialization_intent\":  \"clone\",\n185|\t\t\"target_collision_policy\": \"must_be_absent\",\n186|\t\t\"activation\":              \"dormant_validated\",\n187|\t\t\"extensions\":              extensions,\n188|\t}, nil\n189|}\n190|\n191|// decodeTransactionPlan validates one closed TransactionPlan.\n192|func decodeTransactionPlan(raw json.RawMessage) (TransactionPlan, error) {\n193|\towner := \"transaction plan\"\n194|\tmembers, fault := decodeStrictObject(raw)\n195|\tif fault != nil {\n196|\t\treturn TransactionPlan{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n197|\t}\n198|\tif name, unknown := unknownMember(members, transactionPlanMembers); unknown {\n199|\t\treturn TransactionPlan{}, invalid(\"%s carries unknown member %q\", owner, name)\n(more lines below)","final_result":true}}}
