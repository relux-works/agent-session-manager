{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d519","stream":{"kind":"session","id":"01a0d07a-a3e5-7921-b8c5-a0eb31c22717"},"sequence":2279,"recorded_at":1780531400004553,"record_type":"event","durability":"durable","causation_id":"02f90c3f-e443-410f-b698-87485677e928","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"02f90c3f-e443-410f-b698-87485677e928","run_stream":{"kind":"run","id":"02f90c3f-e443-410f-b698-87485677e928"},"task_stream":{"kind":"task","id":"01a0d089-69d6-7e53-826c-ecab0278ba4f"},"task_id":"01a0d089-69d6-7e53-826c-ecab0278ba4f","event":{"kind":"output","task_id":"01a0d089-69d6-7e53-826c-ecab0278ba4f","chunk":"{\n  \"chunk_id\": \"exec-63-1\",\n  \"command\": \"sed -n '/^def run_mutant/,/^def main/p' internal/clonefidelity/testdata/mutant_harness.py\",\n  \"description\": \"Read runmutant implementation\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"def run_mutant(mutant: Mutant) -> tuple[str, str, int, float]:\\n    target = REPO / mutant.path\\n    original = target.read_text()\\n    found = original.count(mutant.find)\\n    if found != mutant.count:\\n        return f\\\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\\\", \\\"\\\", -1, 0.0\\n    with tempfile.TemporaryDirectory() as staging:\\n        backup = Path(staging) / \\\"backup\\\"\\n        shutil.copy2(target, backup)\\n        try:\\n            target.write_text(original.replace(mutant.find, mutant.replace))\\n            started = time.time()\\n            run = subprocess.run(\\n                [\\\"go\\\", \\\"test\\\", f\\\"./{PACKAGE}/\\\", \\\"-run\\\", mutant.run, \\\"-count=1\\\"],\\n                cwd=REPO,\\n                capture_output=True,\\n                text=True,\\n                timeout=300,\\n            )\\n            elapsed = time.time() - started\\n        finally:\\n            shutil.copy2(backup, target)\\n    output = (run.stdout + run.stderr).strip()\\n    if 'build failed' in output or '\\\\n# ' in output or output.startswith('# '):\\n        return f\\\"ERROR: {mutant.name}: build broke under the patch\\\", output, run.returncode, elapsed\\n    if run.returncode == 0:\\n        verdict = \\\"SURVIVED\\\"\\n    elif '--- FAIL' in output or 'FAIL:' in output:\\n        verdict = \\\"KILLED\\\"\\n    else:\\n        return f\\\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\\\", output, run.returncode, elapsed\\n    mark = \\\"ok\\\" if verdict == mutant.expect else \\\"MISMATCH\\\"\\n    return f\\\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note}\\\", output, run.returncode, elapsed\\n\\n\\ndef main(argv: list[str]) -> int:\\n\",\n  \"original_output_bytes\": 1602,\n  \"original_output_tokens\": 401,\n  \"truncated\": false\n}","final_result":true}}}
