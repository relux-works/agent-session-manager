{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"call_id":"call_01a075187c067fc2bd918ca40ab8db9c","text":"Read text file `internal/sessadapter/bound_census_test.go`.\n(199 line(s) above)\n200|\tviolations = append(violations, boundHelperIndirections(syntax)...)\n201|\treturn sites, violations\n202|}\n203|\n204|// boundHelperIndirections reports every func-value indirection\n205|// of the six bound helpers in one parsed file: any use of a\n206|// helper name that is neither a direct call (the identifier is\n207|// the Fun of its enclosing call) nor one of the six function\n208|// definitions. The rule is positional, so it covers var and :=\n209|// bindings at package and function scope, plain assignments,\n210|// arguments, and return values uniformly — the same shape as the\n211|// constructor census indirection check it is ported from.\n212|func boundHelperIndirections(syntax *ast.File) []string {\n213|\tdefinitions := map[*ast.Ident]bool{}\n214|\tfor _, declaration := range syntax.Decls {\n215|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n216|\t\tif !ok || !boundHelpers[function.Name.Name] {\n217|\t\t\tcontinue\n218|\t\t}\n219|\t\tdefinitions[function.Name] = true\n220|\t}\n221|\tvar violations []string\n222|\tvar stack []ast.Node\n223|\tast.Inspect(syntax, func(node ast.Node) bool {\n224|\t\tif node == nil {\n225|\t\t\tstack = stack[:len(stack)-1]\n226|\t\t\treturn true\n227|\t\t}\n228|\t\tif ident, ok := node.(*ast.Ident); ok && boundHelpers[ident.Name] {\n229|\t\t\tif !definitions[ident] && !isDirectBoundCall(stack, ident) {\n230|\t\t\t\tviolations = append(violations, \"func-value indirection of \"+ident.Name+\"; bounds built through it hide from the bound census\")\n231|\t\t\t}\n232|\t\t}\n233|\t\tstack = append(stack, node)\n234|\t\treturn true\n235|\t})\n236|\treturn violations\n237|}\n238|\n239|// isDirectBoundCall reports whether the identifier is the\n240|// function of the call enclosing it: the stack top is a call\n241|// whose Fun is this identifier. Anything else holding the name\n242|// — a value spec, an assignment, an argument, a return — is an\n243|// alias, not a bound.\n244|func isDirectBoundCall(stack []ast.Node, ident *ast.Ident) bool {\n245|\tif len(stack) == 0 {\n246|\t\treturn false\n247|\t}\n248|\tcall, ok := stack[len(stack)-1].(*ast.CallExpr)\n249|\treturn ok && call.Fun == ast.Expr(ident)\n250|}\n251|\n252|// boundMemberOf names the bounded member of one helper call: the\n253|// string-literal member for the require wrappers, the indexed\n254|// member name for direct checks, or the rendered expression when\n255|// the call bounds a computed value (element, identifier,\n256|// members[name]).\n257|func boundMemberOf(call *ast.CallExpr, helper string) string {\n258|\tif len(call.Args) == 0 {\n259|\t\treturn \"noargs\"\n260|\t}\n261|\tvar first ast.Expr\n262|\tif helper == \"requireStringBounds\" || helper == \"requireUint53Bounds\" {\n263|\t\tif len(call.Args) < 2 {\n264|\t\t\treturn \"short\"\n265|\t\t}\n266|\t\tfirst = call.Args[1]\n267|\t} else {\n268|\t\tfirst = call.Args[0]\n269|\t}\n270|\tif literal, ok := first.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n271|\t\treturn literal.Value\n272|\t}\n273|\tif index, ok := first.(*ast.IndexExpr); ok {\n274|\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n275|\t\t\treturn literal.Value\n276|\t\t}\n277|\t}\n278|\treturn renderBoundExpr(first)\n279|}\n280|\n281|// renderBoundExpr renders one bound expression deterministically.\n282|func renderBoundExpr(node ast.Node) string {\n283|\tvar buffer bytes.Buffer\n284|\tif err := printer.Fprint(&buffer, token.NewFileSet(), node); err != nil {\n285|\t\treturn \"RENDER-ERR\"\n286|\t}\n287|\treturn buffer.String()\n288|}\n289|\n290|// normalizeBoundNumbers replaces standalone integer literals in\n291|// a rendered len guard with N, so the census rosters the guard\n292|// shape rather than its bound values: a moved bound keeps its\n293|// identity and must redden its behavioral driver. Identifiers\n294|// holding digits (uint64, MaxFrameBytes) are untouched.\n295|func normalizeBoundNumbers(rendered string) string {\n296|\tvar out strings.Builder\n297|\tfor i := 0; i < len(rendered); {\n298|\t\tc := rendered[i]\n299|\t\tif c >= '0' && c <= '9' && (i == 0 || !isBoundIdentChar(rendered[i-1])) {\n300|\t\t\tj := i\n301|\t\t\tfor j < len(rendered) && rendered[j] >= '0' && rendered[j] <= '9' {\n302|\t\t\t\tj++\n303|\t\t\t}\n304|\t\t\tif j >= len(rendered) || !isBoundIdentChar(rendered[j]) {\n305|\t\t\t\tout.WriteString(\"N\")\n306|\t\t\t\ti = j\n307|\t\t\t\tcontinue\n308|\t\t\t}\n309|\t\t}\n310|\t\tout.WriteByte(c)\n311|\t\ti++\n312|\t}\n313|\treturn out.String()\n314|}\n315|\n316|// isBoundIdentChar reports whether the byte continues a Go\n317|// identifier.\n318|func isBoundIdentChar(c byte) bool {\n319|\treturn c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'\n320|}\n321|\n322|// hasLenCall reports whether the subtree calls len.\n323|func hasLenCall(node ast.Node) bool {\n324|\tfound := false\n325|\tast.Inspect(node, func(inner ast.Node) bool {\n326|\t\tcall, ok := inner.(*ast.CallExpr)\n327|\t\tif ok {\n328|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == \"len\" {\n329|\t\t\t\tfound = true\n330|\t\t\t\treturn false\n331|\t\t\t}\n332|\t\t}\n333|\t\treturn true\n334|\t})\n335|\treturn found\n336|}\n337|\n338|// boundRegistrations rosters every derived site. driver names the\n339|// committed test proving the edges at the production entry;\n3