re and reddens.\n831|func TestBindingEqualityZeroFactsRefuse(t *testing.T) {\n832|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n833|\tif err != nil {\n834|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n835|\t}\n836|\tsealed, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n837|\tif err != nil {\n838|\t\tt.Fatalf(\"Discover: %v\", err)\n839|\t}\n840|\tzeroes := []struct {\n841|\t\tname string\n842|\t\tzero func(*ExecutionBinding)\n843|\t}{\n844|\t\t{\"role\", func(binding *ExecutionBinding) { binding.Role = \"\" }},\n845|\t\t{\"provider\", func(binding *ExecutionBinding) { binding.ProviderID = \"\" }},\n846|\t\t{\"kind\", func(binding *ExecutionBinding) { binding.CandidateKind = \"\" }},\n847|\t\t{\"path\", func(binding *ExecutionBinding) { binding.ExecutablePath = \"\" }},\n848|\t\t{\"owner\", func(binding *ExecutionBinding) { binding.OwnerIdentity = \"\" }},\n849|\t\t{\"executable\", func(binding *ExecutionBinding) { binding.ExecutableSHA256 = \"\" }},\n850|\t\t{\"provider digest\", func(binding *ExecutionBinding) { binding.ProviderManifestDigest = \"\" }},\n851|\t\t{\"adapter digest\", func(binding *ExecutionBinding) { binding.AdapterManifestDigest = \"\" }},\n852|\t}\n853|\tif len(zeroes) != 8 {\n854|\t\tt.Fatalf(\"zeroes = %d, want one per identity fact\", len(zeroes))\n855|\t}\n856|\tfor _, fact := range zeroes {\n857|\t\tfact := fact\n858|\t\tt.Run(\"fresh \"+fact.name, func(t *testing.T) {\n859|\t\t\tfresh := sealed\n860|\t\t\tfact.zero(&fresh)\n861|\t\t\tif err := CheckBindingEquality(sealed, fresh); err == nil {\n862|\t\t\t\tt.Fatalf(\"CheckBindingEquality admitted a zero fresh %s\", fact.name)\n863|\t\t\t} else {\n864|\t\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n865|\t\t\t}\n866|\t\t})\n867|\t\tt.Run(\"sealed \"+fact.name, func(t *testing.T) {\n868|\t\t\tresealed := sealed\n869|\t\t\tfact.zero(&resealed)\n870|\t\t\tif err := CheckBindingEquality(resealed, sealed); err == nil {\n871|\t\t\t\tt.Fatalf(\"CheckBindingEquality admitted a zero sealed %s\", fact.name)\n872|\t\t\t} else {\n873|\t\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n874|\t\t\t}\n875|\t\t})\n876|\t}\n877|}\n878|\n879|// TestTupleAdmissionZeroFactsRefuse drives every admission key\n880|// fact, the direction, the environment, and the status to zero:\n881|// an empty fact refuses, never admits. Binding-side zeroes are\n882|// driven too, since the key disjunction compares both sides.\n883|func TestTupleAdmissionZeroFactsRefuse(t *testing.T) {\n884|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n885|\tif err != nil {\n886|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n887|\t}\n888|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n889|\tif err != nil {\n890|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n891|\t}\n892|\tbinding := fixtureBindingFacts()\n893|\tnow := mustTime(t, fixtureCallTime)\n894|\tif err := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, binding, now); err != nil {\n895|\t\tt.Fatalf(\"CheckTupleAdmission baseline: %v\", err)\n896|\t}\n897|\tt.Run(\"empty direction\", func(t *testing.T) {\n898|\t\tdirectionless := entry\n899|\t\tdirectionless.Key.Direction = \"\"\n900|\t\tif err := CheckTupleAdmission(directionless, DirectionTargetWrite, tuple, binding, now); err == nil {\n901|\t\t\tt.Fatal(\"admitted an empty entry direction\")\n902|\t\t} else {\n903|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"direction does not match\")\n904|\t\t}\n905|\t})\n906|\tt.Run(\"zero environment\", func(t *testing.T) {\n907|\t\tenvironmentless := entry\n908|\t\tenvironmentless.Key.Environment = Tuple{}\n909|\t\tif err := CheckTupleAdmission(environmentless, DirectionTargetWrite, tuple, binding, now); err == nil {\n910|\t\t\tt.Fatal(\"admitted a zero entry environment\")\n911|\t\t} else {\n912|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"probed tuple\")\n913|\t\t}\n914|\t})\n915|\tkeyZeroes := []struct {\n916|\t\tname string\n917|\t\tzero func(*TupleEntry)\n918|\t}{\n919|\t\t{\"provider\", func(entry *TupleEntry) { entry.Key.ProviderID = \"\" }},\n920|\t\t{\"kind\", func(entry *TupleEntry) { entry.Key.CandidateKind = \"\" }},\n921|\t\t{\"executable\", func(entry *TupleEntry) { entry.Key.ExecutableSHA256 = \"\" }},\n922|\t\t{\"provider digest\", func(entry *TupleEntry) { entry.Key.ProviderManifestDigest = \"\" }},\n923|\t\t{\"adapter digest\", func(entry *TupleEntry) { entry.Key.AdapterManifestDigest = \"\" }},\n924|\t}\n925|\tfor _, fact := range keyZeroes {\n926|\t\tfact := fact\n927|\t\tt.Run(\"entry \"+fact.name, func(t *testing.T) {\n928|\t\t\tzeroed := entry\n929|\t\t\tfact.zero(&zeroed)\n930|\t\t\tif err := CheckTupleAdmission(zeroed, DirectionTargetWrite, tuple, binding, now); err == nil {\n931|\t\t\t\tt.Fatalf(\"admitted a zero entry %s\", fact.name)\n932|\t\t\t} else {\n933|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"execution binding\")\n934|\t\t\t}\n935|\t\t})\n936|\t}\n937|\tbindingZeroes := []struct {\n938|\t\tname string\n939|\t\tzero func(*BindingFacts)\n940|\t}{\n941|\t\t{\"provider\", func(binding *BindingFacts) { binding.ProviderID = \"\" }},\n942|\t\t{\"kind\", func(binding *BindingFacts) { binding.CandidateKind = \"\" }},\n943|\t\t{\"executable\", func(binding *BindingFacts) { binding.ExecutableSHA256 = \"\" }},\n944|\t\t{\"provider digest\", func(binding *BindingFacts) { binding.ProviderManifestDigest = \"\" }},\n945|\t\t{\"adapter digest\", func(binding *BindingFacts) { binding.AdapterManifestDigest = \"\" }},\n946|\t}\n947|\tfor _, fact := range bindingZeroes {\n948|\t\tfact := fact\n949|\t\tt.Run(\"binding \"+fact.name, func(t *testing.T) {\n950|\t\t\tzeroed := binding\n951|\t\t\tfact.zero(&zeroed)\n952|\t\t\tif err := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, zeroed, now); err == nil {\n953|\t\t\t\tt.Fatalf(\"admitted a zero binding %s\", fact.name)\n954|\t\t\t} else {\n955|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"execution binding\")\n956|\t\t\t}\n957|\t\t})\n958|\t}\n959|\tt.Run(\"empty status\", func(t *testing.T) {\n960|\t\tstatusless := entry\n961|\t\tstatusless.Status = \"\"\n962|\t\tif err := CheckTupleAdmission(statusless, DirectionTargetWrite, tuple, binding, now); err == nil {\n963|\t\t\tt.Fatal(\"admitted an empty entry status\")\n964|\t\t} else {\n965|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"not accepted\")\n966|\t\t}\n967|\t})\n968|\tt.Run(\"empty strategy word\", func(t *testing.T) {\n969|\t\tsource, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionSourceRead)))\n970|\t\tif err != nil {\n971|\t\t\tt.Fatalf(\"DecodeTupleEntry source: %v\", err)\n972|\t\t}\n973|\t\twordless := source\n974|\t\twordless.Strategies = []string{\"\"}\n975|\t\tif err := CheckTupleAdmission(wordless, DirectionSourceRead, tuple, binding, now); err == nil {\n976|\t\t\tt.Fatal(\"admitted a source entry with an empty strategy word\")\n977|\t\t} else {\n978|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"exactly strategies=[archive_only]\")\n979|\t\t}\n980|\t})\n981|}\n982|\n983|// presenceRegistration is one map-presence default with its\n984|// fail-closed proof: the behavioral driver plus the structural\n985|// shape the census asserts in production source.\n986|type presenceRegistration struct {\n987|\tfunction string\n988|\tfile     string\n989|\toutcome  string\n990|\tdriver   string\n991|}\n992|\n993|// presenceRegistrations rosters every map-presence default in\n994|// production: an absent name must refuse or read unusable, never\n995|// default to admitted. missingMember is the generic mechanism\n996|// behind every closed-body check.\n997|var presenceRegistrations = []presenceRegistration{\n998|\t{function: \"decodeCapabilities\", file: \"probe.go\", outcome: \"refuse\", driver: \"TestDecodeProbeClosedRules\"},\n999|\t{function: \"CapabilityUsable\", file: \"probe.go\", outcome: \"false\", driver: \"TestCapabilityUsableAbsentIsNotUsable\"},\n1000|\t{function: \"capabilityMapUsable\", file: \"probe.go\", outcome: \"false\", driver: \"TestCapabilityUsableAbsentIsNotUsable\"},\n1001|\t{function: \"CheckTargetWriteGates\", file: \"probe.go\", outcome: \"refuse\", driver: \"TestCheckTargetWriteGates\"},\n1002|\t{function: \"missingMember\", file: \"decode.go\", outcome: \"report\", driver: \"TestClosedMemberSetsAreDerivedFromSpec\"},\n1003|}\n1004|\n1005|// TestPresenceDefaultsAreFailClosed asserts the structural shape\n1006|// of every rostered presence default: the function body guards\n1007|// on !present and the guarded arm refuses (a fail* construction)\n1008|// or reads unusable (a false return). A default rewritten to\n1009|// admit an absent name fails here before any behavior runs.\n1010|func TestPresenceDefaultsAreFailClosed(t *testing.T) {\n1011|\tdirectory, err := os.Getwd()\n1012|\tif err != nil {\n1013|\t\tt.Fatalf(\"presence census: %v\", err)\n1014|\t}\n1015|\tfor _, row := range presenceRegistrations {\n1016|\t\trow := row\n1017|\t\tt.Run(row.function, func(t *testing.T) {\n1018|\t\t\tpath := filepath.Join(directory, row.file)\n1019|\t\t\tsource, err := os.ReadFile(path)\n1020|\t\t\tif err != nil {\n1021|\t\t\t\tt.Fatalf(\"presence census: %v\", err)\n1022|\t\t\t}\n1023|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n1024|\t\t\tif err != nil {\n1025|\t\t\t\tt.Fatalf(\"presence census: %v\", err)\n1026|\t\t\t}\n1027|\t\t\tfound := false\n1028|\t\t\tfor _, declaration := range syntax.Decls {\n1029|\t\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1030|\t\t\t\tif !ok || function.Name.Name != row.function || function.Body == nil {\n1031|\t\t\t\t\tcontinue\n1032|\t\t\t\t}\n1033|\t\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1034|\t\t\t\t\tstatement, ok := node.(*ast.IfStmt)\n1035|\t\t\t\t\tif !ok {\n1036|\t\t\t\t\t\treturn true\n1037|\t\t\t\t\t}\n1038|\t\t\t\t\tif !hasPresentNegation(statement.Cond) {\n1039|\t\t\t\t\t\treturn true\n1040|\t\t\t\t\t}\n1041|\t\t\t\t\tswitch row.outcome {\n1042|\t\t\t\t\tcase \"false\":\n1043|\t\t\t\t\t\tast.Inspect(statement.Body, func(inner ast.Node) bool {\n1044|\t\t\t\t\t\t\tret, ok := inner.(*ast.ReturnStmt)\n1045|\t\t\t\t\t\t\tif ok && len(ret.Results) == 1 {\n1046|\t\t\t\t\t\t\t\tif ident, ok := ret.Results[0].(*ast.Ident); ok && ident.Name == \"false\" {\n1047|\t\t\t\t\t\t\t\t\tfound = true\n1048|\t\t\t\t\t\t\t\t\treturn false\n1049|\t\t\t\t\t\t\t\t}\n1050|\t\t\t\t\t\t\t}\n1051|\t\t\t\t\t\t\treturn true\n1052|\t\t\t\t\t\t})\n1053|\t\t\t\t\tcase \"refuse\", \"report\":\n1054|\t\t\t\t\t\tast.Inspect(statement.Body, func(inner ast.Node) bool {\n1055|\t\t\t\t\t\t\tif call, ok := inner.(*ast.CallExpr); ok {\n1056|\t\t\t\t\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && strings.HasPrefix(ident.Name, \"fail\") {\n1057|\t\t\t\t\t\t\t\t\tfound = true\n1058|\t\t\t\t\t\t\t\t\treturn false\n1059|\t\t\t\t\t\t\t\t}\n1060|\t\t\t\t\t\t\t\treturn true\n1061|\t\t\t\t\t\t\t}\n1062|\t\t\t\t\t\t\tif ret, ok := inner.(*ast.ReturnStmt); ok {\n1063|\t\t\t\t\t\t\t\tfor _, result := range ret.Results {\n1064|\t\t\t\t\t\t\t\t\tif ident, ok := result.(*ast.Ident); ok && ident.Name == \"true\" && row.outcome == \"report\" {\n1065|\t\t\t\t\t\t\t\t\t\tfound = true\n1066|\t\t\t\t\t\t\t\t\t\treturn false\n1067|\t\t\t\t\t\t\t\t\t}\n1068|\t\t\t\t\t\t\t\t}\n1069|\t\t\t\t\t\t\t}\n1070|\t\t\t\t\t\t\treturn true\n1071|\t\t\t\t\t\t})\n1072|\t\t\t\t\t}\n1073|\t\t\t\t\treturn true\n1074|\t\t\t\t})\n1075|\t\t\t}\n1076|\t\t\tif !found {\n1077|\t\t\t\tt.Fatalf(\"%s in %s no longer guards !present with a fail-closed %s arm\", row.function, row.file, row.outcome)\n1078|\t\t\t}\n1079|\t\t})\n1080|\t}\n1081|}\n1082|\n1083|// hasPresentNegation reports whether the condition negates the\n1084|// present/ok boolean: !present, !ok, or a disjunction holding\n1085|// one.\n1086|func hasPresentNegation(node ast.Node) bool {\n1087|\tfound := false\n1088|\tast.Inspect(node, func(inner ast.Node) bool {\n1089|\t\tunary, ok := inner.(*ast.UnaryExpr)\n1090|\t\tif ok && unary.Op == token.NOT {\n1091|\t\t\tif ident, ok := unary.X.(*ast.Ident); ok && (ident.Name == \"present\" || ident.Name == \"ok\") {\n1092|\t\t\t\tfound = true\n1093|\t\t\t\treturn false\n1094|\t\t\t}\n1095|\t\t}\n1096|\t\treturn true\n1097|\t})\n1098|\treturn found\n1099|}"}}}
