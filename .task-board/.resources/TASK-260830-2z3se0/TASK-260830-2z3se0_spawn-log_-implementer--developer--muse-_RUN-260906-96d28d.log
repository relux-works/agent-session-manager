w) {\\ninternal/sessadapter/decode.go:26:// member it was found in, if any. It never carries foreign bytes.\\ninternal/sessadapter/decode.go:45:\\tdecoder := json.NewDecoder(bytes.NewReader(data))\\ninternal/sessadapter/decode.go:90:// with rewritten bytes. This is a local copy of the shared surrogate\\ninternal/sessadapter/decode.go:205:\\tdecoder := json.NewDecoder(bytes.NewReader(raw))\\ninternal/sessadapter/decode.go:317:\\treturn string(bytes.TrimSpace(raw)) == \\\"null\\\"\\ninternal/sessadapter/decode.go:323:\\tdecoder := json.NewDecoder(bytes.NewReader(raw))\\ninternal/sessadapter/protocol.go:225:// the identity fields plus the canonical body bytes. Responses are\\ninternal/sessadapter/protocol.go:526:\\ttrimmed := json.RawMessage(bytes.TrimSpace(raw))\\n\",\n  \"original_output_bytes\": 1403,\n  \"original_output_tokens\": 351,\n  \"truncated\": false\n}"}}}
