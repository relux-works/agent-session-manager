{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b5","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":565,"recorded_at":1780531400001125,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"call_id":"call_01a0751ac4f57b739727946df67bab57","text":"Read text file `internal/sessadapter/inventory_test.go`.\n(449 line(s) above)\n450|\t\t}\n451|\t}\n452|\treturn violations\n453|}\n454|\n455|// isAxerrorNew reports whether the selector names the error\n456|// constructor: axerror.New. Any other selector — axerror.Decode,\n457|// a version constant — is not a construction.\n458|func isAxerrorNew(selector *ast.SelectorExpr) bool {\n459|\treceiver, ok := selector.X.(*ast.Ident)\n460|\treturn ok && receiver.Name == \"axerror\" && selector.Sel.Name == \"New\"\n461|}\n462|\n463|// parentNode returns the innermost enclosing node on the walk\n464|// stack, or nil at the file root.\n465|func parentNode(stack []ast.Node) ast.Node {\n466|\tif len(stack) == 0 {\n467|\t\treturn nil\n468|\t}\n469|\treturn stack[len(stack)-1]\n470|}\n471|\n472|// pairedFuncLit returns the func literal holding one ValueSpec\n473|// name: the index-paired value when every name carries its own,\n474|// the shared value when one serves all names, and nil for any\n475|// other shape or a non-literal value.\n476|func pairedFuncLit(value *ast.ValueSpec, index int) *ast.FuncLit {\n477|\tvar candidate ast.Expr\n478|\tswitch {\n479|\tcase len(value.Values) == len(value.Names) && index < len(value.Values):\n480|\t\tcandidate = value.Values[index]\n481|\tcase len(value.Values) == 1:\n482|\t\tcandidate = value.Values[0]\n483|\tdefault:\n484|\t\treturn nil\n485|\t}\n486|\tliteral, ok := candidate.(*ast.FuncLit)\n487|\tif !ok {\n488|\t\treturn nil\n489|\t}\n490|\treturn literal\n491|}\n492|\n493|// scopeRange is one named scope constructor calls attribute to:\n494|// a function declaration or a package-level variable holding a\n495|// func literal.\n496|type scopeRange struct {\n497|\tname       string\n498|\tstart, end token.Pos\n499|}\n500|\n501|// collectFileArms derives every arm in one production file from a\n502|// single parse, so scope containment compares positions within\n503|// one file set: constructor calls attribute to their innermost\n504|// enclosing scope by source range, frameFault literals derive\n505|// frame arms, and any constructor identifier outside call-fun\n506|// and definition position is an alias and fails the file.\n507|func collectFileArms(fileSet *token.FileSet, syntax *ast.File, constructors map[string]bool, arms map[string]struct{}) error {\n508|\tvar scopes []scopeRange\n509|\ttype pendingCall struct {\n510|\t\tname     string\n511|\t\tcall     *ast.CallExpr\n512|\t\tposition token.Pos\n513|\t}\n514|\tvar calls []pendingCall\n515|\tvar frames []*ast.CompositeLit\n516|\ttype identUse struct {\n517|\t\tidentifier *ast.Ident\n518|\t\tparent     ast.Node\n519|\t}\n520|\tvar uses []identUse\n521|\tvar stack []ast.Node\n522|\tast.Inspect(syntax, func(node ast.Node) bool {\n523|\t\tif node == nil {\n524|\t\t\tstack = stack[:len(stack)-1]\n525|\t\t\treturn true\n526|\t\t}\n527|\t\tvar parent ast.Node\n528|\t\tif len(stack) > 0 {\n529|\t\t\tparent = stack[len(stack)-1]\n530|\t\t}\n531|\t\tswitch node := node.(type) {\n532|\t\tcase *ast.FuncDecl:\n533|\t\t\tscopes = append(scopes, scopeRange{name: node.Name.Name, start: node.Pos(), end: node.End()})\n534|\t\tcase *ast.GenDecl:\n535|\t\t\tfor _, specification := range node.Specs {\n536|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n537|\t\t\t\tif !ok {\n538|\t\t\t\t\tcontinue\n539|\t\t\t\t}\n540|\t\t\t\tfor index, name := range value.Names {\n541|\t\t\t\t\tif index < len(value.Values) {\n542|\t\t\t\t\t\tif literal, ok := value.Values[index].(*ast.FuncLit); ok {\n543|\t\t\t\t\t\t\tscopes = append(scopes, scopeRange{name: \"var:\" + name.Name, start: literal.Pos(), end: literal.End()})\n544|\t\t\t\t\t\t}\n545|\t\t\t\t\t}\n546|\t\t\t\t}\n547|\t\t\t}\n548|\t\tcase *ast.Ident:\n549|\t\t\tif constructors[node.Name] {\n550|\t\t\t\tuses = append(uses, identUse{identifier: node, parent: parent})\n551|\t\t\t}\n552|\t\tcase *ast.CallExpr:\n553|\t\t\tif fun, ok := node.Fun.(*ast.Ident); ok && constructors[fun.Name] {\n554|\t\t\t\tcalls = append(calls, pendingCall{name: fun.Name, call: node, position: node.Pos()})\n555|\t\t\t}\n556|\t\tcase *ast.CompositeLit:\n557|\t\t\tif identifier, ok := node.Type.(*ast.Ident); ok && identifier.Name == \"frameFault\" {\n558|\t\t\t\tframes = append(frames, node)\n559|\t\t\t}\n560|\t\t}\n561|\t\tstack = append(stack, node)\n562|\t\treturn true\n563|\t})\n564|\tfor _, use := range uses {\n565|\t\tif call, ok := use.parent.(*ast.CallExpr); ok {\n566|\t\t\tif fun, ok := call.Fun.(*ast.Ident); ok && fun == use.identifier {\n567|\t\t\t\tcontinue\n568|\t\t\t}\n569|\t\t}\n570|\t\tif specification, ok := use.parent.(*ast.ValueSpec); ok {\n571|\t\t\tdefined := false\n572|\t\t\tfor _, name := range specification.Names {\n573|\t\t\t\tif name == use.identifier {\n574|\t\t\t\t\tdefined = true\n575|\t\t\t\t\tbreak\n576|\t\t\t\t}\n577|\t\t\t}\n578|\t\t\tif defined {\n579|\t\t\t\tcontinue\n580|\t\t\t}\n581|\t\t\treturn fmt.Errorf(\"constructor alias of %s buries every arm it builds at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n582|\t\t}\n583|\t\treturn fmt.Errorf(\"constructor alias or indirect use of %s at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n584|\t}\n585|\tenclosing := func(position token.Pos) string {\n586|\t\tbest := \"package\"\n587|\t\tvar bestStart token.Pos\n588|\t\tinitialized := false\n589|\t\tfor _, scope := range scopes {\n590|\t\t\tif scope.start <= position && position <= scope.end {\n591|\t\t\t\tif !initialized || scope.start >= bestStart {\n592|\t\t\t\t\tbest, bestStart, initialized = scope.name, scope.start, true\n593|\t\t\t\t}\n594|\t\t\t}\n595|\t\t}\n596|\t\treturn best\n597|\t}\n598|\tfor _, call := range calls {\n599|\t\tarm, err := callArm(call.name, call.call, enclosing(call.position))\n600|\t\tif err != nil {\n601|\t\t\treturn err\n602|\t\t}\n603|\t\tarms[arm] = struct{}{}\n604|\t}\n605|\tfor _, frame := range frames {\n606|\t\tdetail, err := frameDetail(frame)\n607|\t\tif err != nil {\n608|\t\t\treturn err\n609|\t\t}\n610|\t\tarms[\"frame|\"+detail] = struct{}{}\n611|\t}\n612|\treturn nil\n613|}\n614|\n615|// callArm derives one constructor arm: a string-literal first\n616|// argument is the detail; a literal-plus-fault.detail binary is a\n617|// conduit keyed by function and prefix; anything else is an\n618|// expr obligation keyed by function.\n619|func callArm(constructor string, call *ast.CallExpr, function string) (string, error) {\n620|\tif len(call.Args) == 0 {\n621|\t\treturn \"\", fmt.Errorf(\"constructor %s called with no arguments in %s\", constructor, function)\n622|\t}\n623|\tswitch first := call.Args[0].(type) {\n624|\tcase *ast.BasicLit:\n625|\t\tif first.Kind != token.STRING {\n626|\t\t\treturn \"\", fmt.Errorf(\"constructor %s first argument is not a string in %s\", constructor, function)\n627|\t\t}\n628|\t\tdetail, err := strconv.Unquote(first.Value)\n629|\t\tif err != nil {\n630|\t\t\treturn \"\", err\n631|\t\t}\n632|\t\treturn \"ctor|\" + constructor + \"|\" + detail, nil\n633|\tcase *ast.BinaryExpr:\n634|\t\tprefix, ok := first.X.(*ast.BasicLit)\n635|\t\tif !ok || prefix.Kind != token.STRING {\n636|\t\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n637|\t\t}\n638|\t\ttext, err := strconv.Unquote(prefix.Value)\n639|\t\tif err != nil {\n640|\t\t\treturn \"\", err\n641|\t\t}\n642|\t\treturn \"ctor|\" + constructor + \"|conduit|\" + function + \"|\" + text, nil\n643|\tdefault:\n644|\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n645|\t}\n646|}\n647|\n648|// frameDetail extracts the detail literal from one &frameFault\n649|// composite literal. A non-literal detail is an expr obligation,\n650|// never a silent pass.\n651|func frameDetail(frame *ast.CompositeLit) (string, error) {\n652|\tfor _, element := range frame.Elts {\n653|\t\tpair, ok := element.(*ast.KeyValueExpr)\n654|\t\tif !ok {\n655|\t\t\tcontinue\n656|\t\t}\n657|\t\tkey, ok := pair.Key.(*ast.Ident)\n658|\t\tif !ok || key.Name != \"detail\" {\n659|\t\t\tcontinue\n660|\t\t}\n661|\t\tliteral, ok := pair.Value.(*ast.BasicLit)\n662|\t\tif !ok || literal.Kind != token.STRING {\n663|\t\t\treturn \"expr\", nil\n664|\t\t}\n665|\t\treturn strconv.Unquote(literal.Value)\n666|\t}\n667|\treturn \"\", fmt.Errorf(\"frameFault literal carries no detail\")\n668|}\n669|\n670|// TestConstructorAliasSpellingsFailDerivation replays the four\n671|// alias probes against the derivation gate on synthetic sources:\n672|// a direct constructor call derives cleanly (the control), while\n673|// a package-level `var alias = ctor`, a function-local\n674|// `var alias = ctor`, and an `alias := ctor` all fail the file.\n675|// The package's own `var failX = func...` definition spelling\n676|// stays exempt: only the definition Name is excused, never a\n677|// constructor in value position.\n678|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n679|\tconstructors := map[string]bool{\"failInvalid\": true}\n680|\tderive := func(source string) error {\n681|\t\tt.Helper()\n682|\t\tfileSet := token.NewFileSet()\n683|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n684|\t\tif err != nil {\n685|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n686|\t\t}\n687|\t\treturn collectFileArms(fileSet, syntax, constructors, map[string]struct{}{})\n688|\t}\n689|\tt.Run(\"direct call derives\", func(t *testing.T) {\n690|\t\tif err := derive(\"package probe\\nfunc f() { failInvalid(\\\"planted\\\", \\\"field\\\") }\\n\"); err != nil {\n691|\t\t\tt.Fatalf(\"direct call failed the derivation: %v\", err)\n692|\t\t}\n693|\t})\n694|\tt.Run(\"definition name stays exempt\", func(t *testing.T) {\n695|\t\tif err := derive(\"package probe\\nvar failInvalid = func(detail, field string) (int, error) { return 0, nil }\\n\"); err != nil {\n696|\t\t\tt.Fatalf(\"constructor definition failed the derivation: %v\", err)\n697|\t\t}\n698|\t})\n699|\tfor _, probe := range []struct {\n700|\t\tname   string\n701|\t\tsource string\n702|\t}{\n703|\t\t{\"package level var alias\", \"package probe\\nvar plantedFail = failInvalid\\nfunc f() { plantedFail(\\\"planted\\\", \\\"field\\\") }\\n\"},\n704|\t\t{\"function local var alias\", \"package probe\\nfunc f() { var localFail = failInvalid\\n_ = localFail }\\n\"},\n705|\t\t{\"short declaration alias\", \"package probe\\nfunc f() { localFail := failInvalid\\n_ = localFail }\\n\"},\n706|\t} {\n707|\t\tt.Run(probe.name, func(t *testing.T) {\n708|\t\t\tif err := derive(probe.source); err == nil {\n709|\t\t\t\tt.Fatal(\"aliased constructor passed the derivation with every arm it builds hidden\")\n710|\t\t\t}\n711|\t\t})\n712|\t}\n713|}\n714|\n715|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction:\n716|// every arm derived from production must carry a witness. A\n717|// planted arm (a new literal or site through an existing\n718|// constructor) lands here as an unwitnessed arm.\n719|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n720|\tderived := deriveRefusalArms(t)\n721|\twitnessed := map[string]int{}\n722|\tfor _, witness := range declaredWitnesses(t) {\n723|\t\twitnessed[witness.arm]++\n724|\t}\n725|\tvar missing []string\n726|\tfor arm := range derived {\n727|\t\tif witnessed[arm] == 0 {\n728|\t\t\tmissing = append(missing, arm)\n729|\t\t}\n730|\t}\n731|\tsort.Strings(missing)\n732|\tif len(missing) > 0 {\n733|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n734|\t}\n735|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n736|}\n737|\n738|// TestWitnessedArmsAreAllDerived is the reverse direction: every\n739|// witness must name an arm production declares. A deleted or\n740|// narrowed production branch orphans its witness and fails here,\n741|// which is also what makes a truncated derivation fail instead\n742|// of passing vacuously.\n743|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n744|\tderived := deriveRefusalArms(t)\n745|\tvar orphans []string\n746|\tfor _, witness := range declaredWitnesses(t) {\n747|\t\tif _, ok := derived[witness.arm]; !ok {\n748|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n749|\t\t}\n750|\t}\n751|\tsort.Strings(orphans)\n752|\tif len(orphans) > 0 {\n753|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n754|\t}\n755|}\n756|\n757|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every\n758|// witness through its production entry point and requires the\n759|// attributed refusal.\n760|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n761|\tfor _, witness := range declaredWitnesses(t) {\n762|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n763|\t\t\twitness.prove(t)\n764|\t\t})\n765|\t}\n766|}\n767|\n768|// armWitness is one derived arm plus the test proving it refuses\n769|// at the production entry with the attributed identity.\n770|type armWitness struct {\n771|\tarm   string\n772|\tname  string\n773|\tprove func(t *testing.T)\n774|}\n775|\n776|// declaredWitnesses lists every witness. The group tables live\n777|// in inventory_witnesses_test.go.\n778|func declaredWitnesses(t *testing.T) []armWitness {\n779|\tt.Helper()\n780|\te := witnessFixtureEntries(t)\n781|\twitnesses := []armWitness{}\n782|\twitnesses = append(witnesses, envelopeWitnesses(e)...)\n783|\twitnesses = append(witnesses, manifestWitnesses(e)...)\n784|\twitnesses = append(witnesses, probeWitnesses(e)...)\n785|\twitnesses = append(witnesses, contextWitnesses(e)...)\n786|\twitnesses = append(witnesses, tupleWitnesses(e)...)\n787|\twitnesses = append(witnesses, operationWitnesses(e)...)\n788|\twitnesses = append(witnesses, gateWitnesses(e)...)\n789|\twitnesses = append(witnesses, frameWitnesses(e)...)\n790|\twitnesses = append(witnesses, conduitWitnesses(e)...)\n791|\treturn witnesses\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
