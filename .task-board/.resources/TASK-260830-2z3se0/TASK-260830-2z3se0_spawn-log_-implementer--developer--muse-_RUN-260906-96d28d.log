{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b9","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":439,"recorded_at":1780531400000873,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"call_id":"call_01a0751994a071b287ae386d64392882","text":"Read text file `internal/sessadapter/identity_census_test.go`.\n(519 line(s) above)\n520|\t\t}\n521|\t}\n522|\tif validRole(Role(\"\")) {\n523|\t\tt.Error(\"validRole(\\\"\\\") = true; the empty role is outside source|target\")\n524|\t}\n525|\tif validRole(\"bogus\") {\n526|\t\tt.Error(\"validRole(\\\"bogus\\\") = true; an arbitrary role is outside source|target\")\n527|\t}\n528|\tif validCandidateKind(CandidateKind(\"\")) {\n529|\t\tt.Error(\"validCandidateKind(\\\"\\\") = true; the empty kind is outside the union\")\n530|\t}\n531|\tif validCandidateKind(CandidateKind(\"bogus\")) {\n532|\t\tt.Error(\"validCandidateKind(\\\"bogus\\\") = true; an arbitrary kind is outside the union\")\n533|\t}\n534|\tif operationSkipsRequestContext(Operation(\"\")) {\n535|\t\tt.Error(\"operationSkipsRequestContext(\\\"\\\") = true; the empty operation skips nothing\")\n536|\t}\n537|\tif operationSkipsRequestContext(Operation(\"bogus\")) {\n538|\t\tt.Error(\"operationSkipsRequestContext(\\\"bogus\\\") = true; an arbitrary operation skips nothing\")\n539|\t}\n540|}\n541|\n542|// identityCensusDomainCount returns the number of non-exempt\n543|// rows in the given domain. Sibling tables with fixed tripwires\n544|// assert against it so they cannot go stale.\n545|func identityCensusDomainCount(domain string) int {\n546|\tcount := 0\n547|\tfor _, row := range identityRegistrations {\n548|\t\tif !row.exempt && row.domain == domain {\n549|\t\t\tcount++\n550|\t\t}\n551|\t}\n552|\treturn count\n553|}\n554|\n555|// probeFactsFor builds the CheckProbe facts for the fixture\n556|// manifest: the expected provider, builtin kind, host-computed\n557|// digest, and verified manifest.\n558|func probeFactsFor(manifest Manifest) ProbeHostFacts {\n559|\treturn ProbeHostFacts{\n560|\t\tExpectedProviderID: fixtureProviderID,\n561|\t\tExpectedKind:       CandidateBuiltin,\n562|\t\tManifestDigest:     ManifestDigest(manifest).String(),\n563|\t\tManifest:           manifest,\n564|\t}\n565|}\n566|\n567|// TestIdentityZeroRows drives every surviving zero-value gate at\n568|// its exported entry: the zero fact refuses through its own arm,\n569|// so a mutant exempting the zero (`!= want && fact != \"\"`)\n570|// admits and reddens here. requireRefusal pins the arm\n571|// identity, so a slide to a neighbouring arm reddens too.\n572|func TestIdentityZeroRows(t *testing.T) {\n573|\tt.Run(\"probe schema empty\", func(t *testing.T) {\n574|\t\tprobe, manifest := fixtureValidProbe(t)\n575|\t\t_ = probe\n576|\t\tdigest := ManifestDigest(manifest).String()\n577|\t\tbase := []byte(fixtureProbeJSON(digest))\n578|\t\tif _, err := DecodeProbe(mutateMember(t, base, \"schema\", `\"\"`)); err == nil {\n579|\t\t\tt.Fatal(\"DecodeProbe admitted an empty schema\")\n580|\t\t} else {\n581|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"schema\", \"not the session adapter probe\")\n582|\t\t}\n583|\t\tif _, err := DecodeProbe(mutateMember(t, base, \"schema_version\", `\"\"`)); err == nil {\n584|\t\t\tt.Fatal(\"DecodeProbe admitted an empty schema_version\")\n585|\t\t} else {\n586|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"schema_version\", \"is not 1.0.0\")\n587|\t\t}\n588|\t})\n589|\tt.Run(\"probe provider zeros\", func(t *testing.T) {\n590|\t\tprobe, manifest := fixtureValidProbe(t)\n591|\t\tfacts := probeFactsFor(manifest)\n592|\t\tproviderless := probe\n593|\t\tproviderless.ProviderID = \"\"\n594|\t\tif err := CheckProbe(providerless, facts); err == nil {\n595|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe provider\")\n596|\t\t} else {\n597|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"requested provider\")\n598|\t\t}\n599|\t\t// Facts-side zero of the expected provider is pinned by\n600|\t\t// TestZeroValueHostFactsRefuse; here the manifest side\n601|\t\t// goes zero with probe and expectation held equal.\n602|\t\tmanifestZero := facts\n603|\t\tmanifestZero.ExpectedProviderID = \"other-provider\"\n604|\t\tzeroed := manifest\n605|\t\tzeroed.ProviderID = \"\"\n606|\t\tmanifestZero.Manifest = zeroed\n607|\t\tother := probe\n608|\t\tother.ProviderID = \"other-provider\"\n609|\t\tif err := CheckProbe(other, manifestZero); err == nil {\n610|\t\t\tt.Fatal(\"CheckProbe admitted an empty manifest provider\")\n611|\t\t} else {\n612|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"verified manifest\")\n613|\t\t}\n614|\t})\n615|\tt.Run(\"probe digest zeros\", func(t *testing.T) {\n616|\t\tprobe, manifest := fixtureValidProbe(t)\n617|\t\tfacts := probeFactsFor(manifest)\n618|\t\tdigestless := probe\n619|\t\tdigestless.ManifestDigest = \"\"\n620|\t\tif err := CheckProbe(digestless, facts); err == nil {\n621|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe digest\")\n622|\t\t} else {\n623|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_manifest_digest\", \"host-computed digest\")\n624|\t\t}\n625|\t\tfactsless := facts\n626|\t\tfactsless.ManifestDigest = \"\"\n627|\t\tif err := CheckProbe(probe, factsless); err == nil {\n628|\t\t\tt.Fatal(\"CheckProbe admitted an empty expected digest\")\n629|\t\t} else {\n630|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_manifest_digest\", \"host-computed digest\")\n631|\t\t}\n632|\t})\n633|\tt.Run(\"probe version zeros\", func(t *testing.T) {\n634|\t\tprobe, manifest := fixtureValidProbe(t)\n635|\t\tfacts := probeFactsFor(manifest)\n636|\t\tversionless := probe\n637|\t\tversionless.AdapterVersion = \"\"\n638|\t\tif err := CheckProbe(versionless, facts); err == nil {\n639|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe version\")\n640|\t\t} else {\n641|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_version\", \"verified manifest\")\n642|\t\t}\n643|\t\tmanifestless := facts\n644|\t\tzeroed := manifest\n645|\t\tzeroed.AdapterVersion = \"\"\n646|\t\tmanifestless.Manifest = zeroed\n647|\t\tif err := CheckProbe(probe, manifestless); err == nil {\n648|\t\t\tt.Fatal(\"CheckProbe admitted an empty manifest version\")\n649|\t\t} else {\n650|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_version\", \"verified manifest\")\n651|\t\t}\n652|\t\tdriftless := probe\n653|\t\tdriftless.Environment.AdapterVersion = \"\"\n654|\t\tif err := CheckProbe(driftless, facts); err == nil {\n655|\t\t\tt.Fatal(\"CheckProbe admitted an empty tuple adapter version\")\n656|\t\t} else {\n657|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"environment\", \"probe adapter version\")\n658|\t\t}\n659|\t})\n660|\tt.Run(\"probe tuple environment zero\", func(t *testing.T) {\n661|\t\tprobe, manifest := fixtureValidProbe(t)\n662|\t\tfacts := probeFactsFor(manifest)\n663|\t\ttupleless := probe\n664|\t\ttupleless.Environment.EnvironmentID = \"\"\n665|\t\tif err := CheckProbe(tupleless, facts); err == nil {\n666|\t\t\tt.Fatal(\"CheckProbe admitted an empty tuple environment\")\n667|\t\t} else {\n668|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", \"\", \"outside the manifest environment\")\n669|\t\t}\n670|\t})\n671|\tt.Run(\"probe request zeros\", func(t *testing.T) {\n672|\t\tcandidate := fixtureCandidate()\n673|\t\tif err := CheckProbeRequest(\"\", CandidateBuiltin, candidate); err == nil {\n674|\t\t\tt.Fatal(\"CheckProbeRequest admitted an empty expected provider\")\n675|\t\t} else {\n676|\t\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n677|\t\t}\n678|\t\tproviderless := candidate\n679|\t\tproviderless.ProviderID = \"\"\n680|\t\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, providerless); err == nil {\n681|\t\t\tt.Fatal(\"CheckProbeRequest admitted an empty candidate provider\")\n682|\t\t} else {\n683|\t\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n684|\t\t}\n685|\t})\n686|\tt.Run(\"doctor direction zero\", func(t *testing.T) {\n687|\t\tmanifestDigest := fixtureManifestDigestText(t)\n688|\t\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n689|\t\tdecoded, err := CheckRequestBody(OpDoctor, request)\n690|\t\tif err != nil {\n691|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n692|\t\t}\n693|\t\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n694|\t\tif _, err := DecodeDoctorResult(good, decoded, \"\"); err == nil {\n695|\t\t\tt.Fatal(\"DecodeDoctorResult admitted an empty request direction\")\n696|\t\t} else {\n697|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"direction\", \"does not answer the request direction\")\n698|\t\t}\n699|\t})\n700|\tt.Run(\"doctor entry status zero\", func(t *testing.T) {\n701|\t\tmanifestDigest := fixtureManifestDigestText(t)\n702|\t\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n703|\t\tdecoded, err := CheckRequestBody(OpDoctor, request)\n704|\t\tif err != nil {\n705|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n706|\t\t}\n707|\t\tprobe, _ := fixtureValidProbe(t)\n708|\t\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n709|\t\thealthy, err := DecodeDoctorResult(mutateMember(t, good, \"healthy\", `true`), decoded, DirectionSourceRead)\n710|\t\tif err != nil {\n711|\t\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n712|\t\t}\n713|\t\tstatusless := healthy\n714|\t\tstatusless.EntryStatus = \"\"\n715|\t\trequired := DoctorRequiredCapabilities(DirectionTargetWrite, false)\n716|\t\tif err := CheckDoctorHealthy(statusless, probe, required); err == nil {\n717|\t\t\tt.Fatal(\"CheckDoctorHealthy admitted an empty entry status as healthy\")\n718|\t\t} else {\n719|\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"tuple_registry\", \"accepted registry entry\")\n720|\t\t}\n721|\t})\n722|\tt.Run(\"request digest zero\", func(t *testing.T) {\n723|\t\tmanifestDigest := fixtureManifestDigestText(t)\n724|\t\tbody := fixtureRequestBody(t, OpDiscover, manifestDigest)\n725|\t\tdecoded, err := CheckRequestBody(OpDiscover, body)\n726|\t\tif err != nil {\n727|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n728|\t\t}\n729|\t\tif err := VerifyRequestDigest(decoded, body); err != nil {\n730|\t\t\tt.Fatalf(\"VerifyRequestDigest baseline: %v\", err)\n731|\t\t}\n732|\t\tdigestless := decoded\n733|\t\tdigestless.RequestDigest = \"\"\n734|\t\tif err := VerifyRequestDigest(digestless, body); err == nil {\n735|\t\t\tt.Fatal(\"VerifyRequestDigest admitted an empty request digest\")\n736|\t\t} else {\n737|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"request_digest\", \"does not match\")\n738|\t\t}\n739|\t})\n740|\tt.Run(\"discover provider zeros\", func(t *testing.T) {\n741|\t\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n742|\t\tif err != nil {\n743|\t\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n744|\t\t}\n745|\t\tdigest := ManifestDigest(manifest).String()\n746|\t\tcandidate := fixtureCandidate()\n747|\t\tproviderless := manifest\n748|\t\tproviderless.ProviderID = \"\"\n749|\t\tif _, err := Discover(RoleSource, providerless, digest, candidate); err == nil {\n750|\t\t\tt.Fatal(\"Discover admitted an empty manifest provider\")\n751|\t\t} else {\n752|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"trusted candidate\")\n753|\t\t}\n754|\t\tcandidateless := candidate\n755|\t\tcandidateless.ProviderID = \"\"\n756|\t\tif _, err := Discover(RoleSource, manifest, digest, candidateless); err == nil {\n757|\t\t\tt.Fatal(\"Discover admitted an empty candidate provider\")\n758|\t\t} else {\n759|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"trusted candidate\")\n760|\t\t}\n761|\t})\n762|\tt.Run(\"call binding caller zeros\", func(t *testing.T) {\n763|\t\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n764|\t\tif err != nil {\n765|\t\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n766|\t\t}\n767|\t\tbinding, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n768|\t\tif err != nil {\n769|\t\t\tt.Fatalf(\"Discover: %v\", err)\n770|\t\t}\n771|\t\tbody := fixtureRequestWithDigest(t, ManifestDigest(manifest).String())\n772|\t\tcontext, err := CheckRequestBody(OpDiscover, body)\n773|\t\tif err != nil {\n774|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n775|\t\t}\n776|\t\tadmitted, err := DecodeTuple([]byte(fixtureTupleJSON()))\n777|\t\tif err != nil {\n778|\t\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n779|\t\t}\n780|\t\tproviderless := context\n781|\t\tproviderless.ProviderID = \"\"\n782|\t\tif err := CheckCallBinding(binding, RoleSource, providerless, admitted); err == nil {\n783|\t\t\tt.Fatal(\"CheckCallBinding admitted an empty context provider\")\n784|\t\t} else {\n785|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"sealed binding\")\n786|\t\t}\n787|\t\tdigestless := context\n788|\t\tdigestless.ManifestDigest = \"\"\n789|\t\tif err := CheckCallBinding(binding, RoleSource, digestless, admitted); err == nil {\n790|\t\t\tt.Fatal(\"CheckCallBinding admitted an empty context digest\")\n791|\t\t} else {\n792|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"session_adapter_manifest_digest\", \"sealed binding\")\n793|\t\t}\n794|\t\texeless := context\n795|\t\texeless.ExecutableSHA256 = \"\"\n796|\t\tif err := CheckCallBinding(binding, RoleSource, exeless, admitted); err == nil {\n797|\t\t\tt.Fatal(\"CheckCallBinding admitted an empty context executable digest\")\n798|\t\t} else {\n799|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"executable_sha256\", \"sealed binding\")\n800|\t\t}\n801|\t\tif err := CheckCallBinding(binding, \"\", context, admitted); err == nil {\n802|\t\t\tt.Fatal(\"CheckCallBinding admitted an empty call role\")\n803|\t\t} else {\n804|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"role\", \"binding role\")\n805|\t\t}\n806|\t})\n807|\tt.Run(\"provider status zero\", func(t *testing.T) {\n808|\t\tprobe, _ := fixtureValidProbe(t)\n809|\t\tprovider := map[string]ProviderCapability{\n810|\t\t\t\"portable_store\": {Status: \"\", Enabled: true},\n811|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n812|\t\t}\n813|\t\tif err := CheckTargetWriteGates(probeCapabilities(probe), provider); err == nil {\n814|\t\t\tt.Fatal(\"CheckTargetWriteGates admitted an empty provider status\")\n815|\t\t} else {\n816|\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:portable_store\", \"usable provider capability\")\n817|\t\t}\n818|\t})\n819|}\n820|\n821|// probeCapabilities projects the probe map for gate tests.\n822|func probeCapabilities(probe Probe) map[string]Capability {\n823|\treturn cloneCapabilities(probe.Capabilities)\n824|}\n825|\n826|// TestBindingEqualityZeroFactsRefuse drives every sealed-binding\n827|// fact to zero on each side: a forgotten seal fact refuses,\n828|// never agrees. Non-zero flips were already pinned by\n829|// TestBindingEqualityFlipsEveryFact; a mutant exempting the zero\n830|// admits here and reddens.\n831|func TestBindingEqualityZeroFactsRefuse(t *testing.T) {\n832|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n833|\tif err != nil {\n834|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n835|\t}\n836|\tsealed, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n837|\tif err != nil {\n838|\t\tt.Fatalf(\"Discover: %v\", err)\n839|\t}\n840|\tzeroes := []struct {\n841|\t\tname string\n842|\t\tzero func(*ExecutionBinding)\n843|\t}{\n844|\t\t{\"role\", func(binding *ExecutionBinding) { binding.Role = \"\" }},\n845|\t\t{\"provider\", func(binding *ExecutionBinding) { binding.ProviderID = \"\" }},\n846|\t\t{\"kind\", func(binding *ExecutionBinding) { binding.CandidateKind = \"\" }},\n847|\t\t{\"path\", func(binding *ExecutionBinding) { binding.ExecutablePath = \"\" }},\n848|\t\t{\"owner\", func(binding *ExecutionBinding) { binding.OwnerIdentity = \"\" }},\n849|\t\t{\"executable\", func(binding *ExecutionBinding) { binding.ExecutableSHA256 = \"\" }},\n850|\t\t{\"provider digest\", func(binding *ExecutionBinding) { binding.ProviderManifestDigest = \"\" }},\n851|\t\t{\"adapter digest\", func(binding *ExecutionBinding) { binding.AdapterManifestDigest = \"\" }},\n852|\t}\n853|\tif len(zeroes) != 8 {\n854|\t\tt.Fatalf(\"zeroes = %d, want one per identity fact\", len(zeroes))\n855|\t}\n856|\tfor _, fact := range zeroes {\n857|\t\tfact := fact\n858|\t\tt.Run(\"fresh \"+fact.name, func(t *testing.T) {\n859|\t\t\tfresh := sealed\n860|\t\t\tfact.zero(&fresh)\n861|\t\t\tif err := CheckBindingEquality(sealed, fresh); err == nil {\n862|\t\t\t\tt.Fatalf(\"CheckBindingEquality admitted a zero fresh %s\", fact.name)\n863|\t\t\t} else {\n864|\t\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n865|\t\t\t}\n866|\t\t})\n867|\t\tt.Run(\"sealed \"+fact.name, func(t *testing.T) {\n868|\t\t\tresealed := sealed\n869|\t\t\tfact.zero(&resealed)\n870|\t\t\tif err := CheckBindingEquality(resealed, sealed); err == nil {\n871|\t\t\t\tt.Fatalf(\"CheckBindingEquality admitted a zero sealed %s\", fact.name)\n872|\t\t\t} else {\n873|\t\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n874|\t\t\t}\n875|\t\t})\n876|\t}\n877|}\n878|\n879|// TestTupleAdmissionZeroFactsRefuse drives every admission key\n880|// fact, the direction, the environment, and the status to zero:\n881|// an empty fact refuses, never admits. Binding-side zeroes are\n882|// driven too, since the key disjunction compares both sides.\n883|func TestTupleAdmissionZeroFactsRefuse(t *testing.T) {\n884|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n885|\tif err != nil {\n886|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n887|\t}\n888|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n889|\tif err != nil {\n890|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n891|\t}\n892|\tbinding := fixtureBindingFacts()\n893|\tnow := mustTime(t, fixtureCallTime)\n894|\tif err := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, binding, now); err != nil {\n895|\t\tt.Fatalf(\"CheckTupleAdmission baseline: %v\", err)\n896|\t}\n897|\tt.Run(\"empty direction\", func(t *testing.T) {\n898|\t\tdirectionless := entry\n899|\t\tdirectionless.Key.Direction = \"\"\n900|\t\tif err := CheckTupleAdmission(directionless, DirectionTargetWrite, tuple, binding, now); err == nil {\n901|\t\t\tt.Fatal(\"admitted an empty entry direction\")\n902|\t\t} else {\n903|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"direction does not match\")\n904|\t\t}\n905|\t})\n906|\tt.Run(\"zero environment\", func(t *testing.T) {\n907|\t\tenvironmentless := entry\n908|\t\tenvironmentless.Key.Environment = Tuple{}\n909|\t\tif err := CheckTupleAdmission(environmentless, DirectionTargetWrite, tuple, binding, now); err == nil {\n910|\t\t\tt.Fatal(\"admitted a zero entry environment\")\n911|\t\t} else {\n912|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"probed tuple\")\n913|\t\t}\n914|\t})\n915|\tkeyZeroes := []struct {\n916|\t\tname string\n917|\t\tzero func(*TupleEntry)\n918|\t}{\n919|\t\t{\"provider\", func(entry *TupleEntry) { entry.Key.ProviderID = \"\" }},\n920|\t\t{\"kind\", func(entry *TupleEntry) { entry.Key.CandidateKind = \"\" }},\n921|\t\t{\"executable\", func(entry *TupleEntry) { entry.Key.ExecutableSHA256 = \"\" }},\n922|\t\t{\"provider digest\", func(entry *TupleEntry) { entry.Key.ProviderManifestDigest = \"\" }},\n923|\t\t{\"adapter digest\", func(entry *TupleEntry) { entry.Key.AdapterManifestDigest = \"\" }},\n924|\t}\n925|\tfor _, fact := range keyZeroes {\n926|\t\tfact := fact\n927|\t\tt.Run(\"entry \"+fact.name, func(t *testing.T) {\n928|\t\t\tzeroed := entry\n929|\t\t\tfact.zero(&zeroed)\n930|\t\t\tif err := CheckTupleAdmission(zeroed, DirectionTargetWrite, tuple, binding, now); err == nil {\n931|\t\t\t\tt.Fatalf(\"admitted a zero entry %s\", fact.name)\n932|\t\t\t} else {\n933|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"execution binding\")\n934|\t\t\t}\n935|\t\t})\n936|\t}\n937|\tbindingZeroes := []struct {\n938|\t\tname string\n939|\t\tzero func(*BindingFacts)\n940|\t}{\n941|\t\t{\"provider\", func(binding *BindingFacts) { binding.ProviderID = \"\" }},\n942|\t\t{\"kind\", func(binding *BindingFacts) { binding.CandidateKind = \"\" }},\n943|\t\t{\"executable\", func(binding *BindingFacts) { binding.ExecutableSHA256 = \"\" }},\n944|\t\t{\"provider digest\", func(binding *BindingFacts) { binding.ProviderManifestDigest = \"\" }},\n945|\t\t{\"adapter digest\", func(binding *BindingFacts) { binding.AdapterManifestDigest = \"\" }},\n946|\t}\n947|\tfor _, fact := range bindingZeroes {\n948|\t\tfact := fact\n949|\t\tt.Run(\"binding \"+fact.name, func(t *testing.T) {\n950|\t\t\tzeroed := binding\n951|\t\t\tfact.zero(&zeroed)\n952|\t\t\tif err := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, zeroed, now); err == nil {\n953|\t\t\t\tt.Fatalf(\"admitted a zero binding %s\", fact.name)\n954|\t\t\t} else {\n955|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"execution binding\")\n956|\t\t\t}\n957|\t\t})\n958|\t}\n959|\tt.Run(\"empty status\", func(t *testing.T) {\n960|\t\tstatusless := entry\n961|\t\tstatusless.Status = \"\"\n962|\t\tif err := CheckTupleAdmission(statusless, DirectionTargetWrite, tuple, binding, now); err == nil {\n963|\t\t\tt.Fatal(\"admitted an empty entry status\")\n964|\t\t} else {\n965|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"not accepted\")\n966|\t\t}\n967|\t})\n968|\tt.Run(\"empty strategy word\", func(t *testing.T) {\n969|\t\tsource, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionSourceRead)))\n970|\t\tif err != nil {\n971|\t\t\tt.Fatalf(\"DecodeTupleEntry source: %v\", err)\n972|\t\t}\n973|\t\twordless := source\n974|\t\twordless.Strategies = []string{\"\"}\n975|\t\tif err := CheckTupleAdmission(wordless, DirectionSourceRead, tuple, binding, now); err == nil {\n976|\t\t\tt.Fatal(\"admitted a source entry with an empty strategy word\")\n977|\t\t} else {\n978|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"exactly strategies=[archive_only]\")\n979|\t\t}\n980|\t})\n981|}\n982|\n983|// presenceRegistration is one map-presence default with its\n984|// fail-closed proof: the behavioral driver plus the structural\n985|// shape the census asserts in production source.\n986|type presenceRegistration struct {\n987|\tfunction string\n988|\tfile     string\n989|\toutcome  string\n990|\tdriver   string\n991|}\n992|\n993|// presenceRegistrations rosters every map-presence default in\n994|// production: an absent name must refuse or read unusable, never\n995|// default to admitted. missingMember is the generic mechanism\n996|// behind every closed-body check.\n997|var presenceRegistrations = []presenceRegistration{\n998|\t{function: \"decodeCapabilities\", file: \"probe.go\", outcome: \"refuse\", driver: \"TestDecodeProbeClosedRules\"},\n999|\t{function: \"CapabilityUsable\", file: \"probe.go\", outcome: \"false\", driver: \"TestCapabilityUsableAbsentIsNotUsable\"},\n1000|\t{function: \"capabilityMapUsable\", file: \"probe.go\", outcome: \"false\", driver: \"TestCapabilityUsableAbsentIsNotUsable\"},\n1001|\t{function: \"CheckTargetWriteGates\", file: \"probe.go\", outcome: \"refuse\", driver: \"TestCheckTargetWriteGates\"},\n1002|\t{function: \"missingMember\", file: \"decode.go\", outcome: \"report\", driver: \"TestClosedMemberSetsAreDerivedFromSpec\"},\n1003|}\n1004|\n1005|// TestPresenceDefaultsAreFailClosed asserts the structural shape\n1006|// of every rostered presence default: the function body guards\n1007|// on !present and the guarded arm refuses (a fail* construction)\n1008|// or reads unusable (a false return). A default rewritten to\n1009|// admit an absent name fails here before any behavior runs.\n1010|func TestPresenceDefaultsAreFailClosed(t *testing.T) {\n1011|\tdirectory, err := os.Getwd()\n1012|\tif err != nil {\n1013|\t\tt.Fatalf(\"presence census: %v\", err)\n1014|\t}\n1015|\tfor _, row := range presenceRegistrations {\n1016|\t\trow := row\n1017|\t\tt.Run(row.function, func(t *testing.T) {\n1018|\t\t\tpath := filepath.Join(directory, row.file)\n1019|\t\t\tsource, err := os.ReadFile(path)\n1020|\t\t\tif err != nil {\n1021|\t\t\t\tt.Fatalf(\"presence census: %v\", err)\n1022|\t\t\t}\n1023|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n1024|\t\t\tif err != nil {\n1025|\t\t\t\tt.Fatalf(\"presence census: %v\", err)\n1026|\t\t\t}\n1027|\t\t\tfound := false\n1028|\t\t\tfor _, declaration := range syntax.Decls {\n1029|\t\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n1030|\t\t\t\tif !ok || function.Name.Name != row.function || function.Body == nil {\n1031|\t\t\t\t\tcontinue\n1032|\t\t\t\t}\n1033|\t\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n1034|\t\t\t\t\tstatement, ok := node.(*ast.IfStmt)\n1035|\t\t\t\t\tif !ok {\n1036|\t\t\t\t\t\treturn true\n1037|\t\t\t\t\t}\n1038|\t\t\t\t\tif !hasPresentNegation(statement.Cond) {\n1039|\t\t\t\t\t\treturn true\n1040|\t\t\t\t\t}\n1041|\t\t\t\t\tswitch row.outcome {\n1042|\t\t\t\t\tcase \"false\":\n1043|\t\t\t\t\t\tast.Inspect(statement.Body, func(inner ast.Node) bool {\n1044|\t\t\t\t\t\t\tret, ok := inner.(*ast.ReturnStmt)\n1045|\t\t\t\t\t\t\tif ok && len(ret.Results) == 1 {\n1046|\t\t\t\t\t\t\t\tif ident, ok := ret.Results[0].(*ast.Ident); ok && ident.Name == \"false\" {\n1047|\t\t\t\t\t\t\t\t\tfound = true\n1048|\t\t\t\t\t\t\t\t\treturn false\n1049|\t\t\t\t\t\t\t\t}\n1050|\t\t\t\t\t\t\t}\n1051|\t\t\t\t\t\t\treturn true\n1052|\t\t\t\t\t\t})\n1053|\t\t\t\t\tcase \"refuse\", \"report\":\n1054|\t\t\t\t\t\tast.Inspect(statement.Body, func(inner ast.Node) bool {\n1055|\t\t\t\t\t\t\tif call, ok := inner.(*ast.CallExpr); ok {\n1056|\t\t\t\t\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && strings.HasPrefix(ident.Name, \"fail\") {\n1057|\t\t\t\t\t\t\t\t\tfound = true\n1058|\t\t\t\t\t\t\t\t\treturn false\n1059|\t\t\t\t\t\t\t\t}\n1060|\t\t\t\t\t\t\t\treturn true\n1061|\t\t\t\t\t\t\t}\n1062|\t\t\t\t\t\t\tif ret, ok := inner.(*ast.ReturnStmt); ok {\n1063|\t\t\t\t\t\t\t\tfor _, result := range ret.Results {\n1064|\t\t\t\t\t\t\t\t\tif ident, ok := result.(*ast.Ident); ok && ident.Name == \"true\" && row.outcome == \"report\" {\n1065|\t\t\t\t\t\t\t\t\t\tfound = true\n1066|\t\t\t\t\t\t\t\t\t\treturn false\n1067|\t\t\t\t\t\t\t\t\t}\n1068|\t\t\t\t\t\t\t\t}\n1069|\t\t\t\t\t\t\t}\n1070|\t\t\t\t\t\t\treturn true\n1071|\t\t\t\t\t\t})\n1072|\t\t\t\t\t}\n1073|\t\t\t\t\treturn true\n1074|\t\t\t\t})\n1075|\t\t\t}\n1076|\t\t\tif !found {\n1077|\t\t\t\tt.Fatalf(\"%s in %s no longer guards !present with a fail-closed %s arm\", row.function, row.file, row.outcome)\n1078|\t\t\t}\n1079|\t\t})\n1080|\t}\n1081|}\n1082|\n1083|// hasPresentNegation reports whether the condition negates the\n1084|// present/ok boolean: !present, !ok, or a disjunction holding\n1085|// one.\n1086|func hasPresentNegation(node ast.Node) bool {\n1087|\tfound := false\n1088|\tast.Inspect(node, func(inner ast.Node) bool {\n1089|\t\tunary, ok := inner.(*ast.UnaryExpr)\n1090|\t\tif ok && unary.Op == token.NOT {\n1091|\t\t\tif ident, ok := unary.X.(*ast.Ident); ok && (ident.Name == \"present\" || ident.Name == \"ok\") {\n1092|\t\t\t\tfound = true\n1093|\t\t\t\treturn false\n1094|\t\t\t}\n1095|\t\t}\n1096|\t\treturn true\n1097|\t})\n1098|\treturn found\n1099|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
