{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c855","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":645,"recorded_at":1780531400001285,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"task_stream":{"kind":"task","id":"f1b31728-9c62-453e-acf2-82ce6310231b"},"task_id":"f1b31728-9c62-453e-acf2-82ce6310231b","event":{"kind":"output","task_id":"f1b31728-9c62-453e-acf2-82ce6310231b","chunk":"Read text file `internal/sessadapter/context_test.go`.\n(59 line(s) above)\n60|\t}\n61|\t// The digest is deterministic: the same canonical body\n62|\t// digests identically across calls.\n63|\tagain, err := RequestDigestFor(body)\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"RequestDigestFor: %v\", err)\n66|\t}\n67|\tif again.String() != context.RequestDigest {\n68|\t\tt.Fatal(\"request digest is not deterministic\")\n69|\t}\n70|}\n71|\n72|func TestVerifyRequestDigestOmitsOnlyItsMember(t *testing.T) {\n73|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n74|\tcontext, err := CheckRequestBody(OpDiscover, body)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n77|\t}\n78|\t// Changing the operation_id changes the digest: the omission\n79|\t// covers only request_digest, not its neighbours.\n80|\tmutated := []byte(strings.Replace(string(body), fixtureOperationID, \"0198f4c8-8e50-7f66-8f70-1234567890aa\", 1))\n81|\tif err := VerifyRequestDigest(context, mutated); err == nil {\n82|\t\tt.Fatal(\"VerifyRequestDigest admitted a body with a different operation_id\")\n83|\t}\n84|}\n85|\n86|func TestCheckContextEcho(t *testing.T) {\n87|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n88|\tsent, err := CheckRequestBody(OpDiscover, body)\n89|\tif err != nil {\n90|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n91|\t}\n92|\t// Byte-identical echo passes.\n93|\techoed, err := CheckContextEcho(sent, rawMember(t, body, \"context\"))\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"CheckContextEcho: %v\", err)\n96|\t}\n97|\tif echoed.OperationID != sent.OperationID {\n98|\t\tt.Fatal(\"echoed context lost the operation identifier\")\n99|\t}\n100|\t// A re-serialized context with a changed value fails at the\n101|\t// echo: decode accepts the valid shape, and only byte\n102|\t// identity proves the adapter answered this call.\n103|\taltered := mutateMember(t, rawMember(t, body, \"context\"), \"provider_id\", `\"other-provider\"`)\n104|\tif _, err := CheckContextEcho(sent, altered); err == nil {\n105|\t\tt.Fatal(\"CheckContextEcho admitted a context for another provider\")\n106|\t} else {\n107|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"context\", \"byte-for-byte\")\n108|\t}\n109|\t// A same-length forgery — one flipped hex digit in the\n110|\t// operation identifier, still a valid UUIDv7 — fails at the\n111|\t// echo too. A length-only comparison admits it, so this case\n112|\t// pins the byte-for-byte half of the gate, not just the\n113|\t// length half.\n114|\tsameLength := []byte(strings.Replace(string(rawMember(t, body, \"context\")), fixtureOperationID, \"0198f4c8-8e50-7f66-8f70-1234567890ad\", 1))\n115|\tif len(sameLength) != len(rawMember(t, body, \"context\")) {\n116|\t\tt.Fatal(\"same-length forgery changed length; the probe is broken, not the gate\")\n117|\t}\n118|\tif _, err := DecodeCallContext(sameLength); err != nil {\n119|\t\tt.Fatalf(\"same-length forgery is not a valid context: %v\", err)\n120|\t}\n121|\tif _, err := CheckContextEcho(sent, sameLength); err == nil {\n122|\t\tt.Fatal(\"CheckContextEcho admitted a same-length rebuilt context\")\n123|\t} else {\n124|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"context\", \"byte-for-byte\")\n125|\t}\n126|\t// A malformed context fails at decode, before the echo.\n127|\tmalformed := mutateMember(t, rawMember(t, body, \"context\"), \"provider_id\", `\"Other Provider\"`)\n128|\tif _, err := CheckContextEcho(sent, malformed); err == nil {\n129|\t\tt.Fatal(\"CheckContextEcho admitted a malformed context\")\n130|\t} else {\n131|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"not a provider-id\")\n132|\t}\n133|}\n134|\n135|// rawMember extracts one top-level member's raw bytes.\n136|func rawMember(t *testing.T, body []byte, member string) []byte {\n137|\tt.Helper()\n138|\tvar members map[string]json.RawMessage\n139|\tif err := json.Unmarshal(body, &members); err != nil {\n(more lines below)"}}}
