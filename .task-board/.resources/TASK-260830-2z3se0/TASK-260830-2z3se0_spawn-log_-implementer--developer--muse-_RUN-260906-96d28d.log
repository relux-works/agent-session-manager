d\n71|// Time halves by construction (one rule, two halves); deleting\n72|// one half is a behavioral mutant the entry-point tests must\n73|// catch, and every witness below proves both halves. Arms\n74|// sharing one identity merge to one obligation only there and\n75|// nowhere else: any other merge fails the derivation. The\n76|// open-class member gates (unknown-member and duplicate-member\n77|// refusals) range over an unbounded name class, so one witness\n78|// per arm proves the gate fires, not that every name is gated:\n79|// a mutant exempting a different name than the witnessed one is\n80|// outside what the arm inventory narrows, and is recorded here\n81|// rather than proven.\n82|\n83|// refusalArmCensusFloor is the derived arm count this test was\n84|// written against. It is a tripwire, not an enumeration: a\n85|// derivation returning fewer arms fails closed even when every\n86|// surviving arm is witnessed, which is what catches a silently\n87|// truncated scan. Raising it is routine when production gains a\n88|// refusal; lowering it requires saying why.\n89|const refusalArmCensusFloor = 323\n90|\n91|// refusalConstructors is the closed constructor set the\n92|// derivation observes, pinned against production by\n93|// TestRefusalConstructorsMatchProduction: the registered names\n94|// must equal the package-level error-constructing vars exactly,\n95|// and every axerror.New site in production must sit inside one\n96|// registered constructor body. A refusal built any other way —\n97|// through an unregistered eighth constructor or an inline\n98|// axerror.New — fails that census; a refusal built through an\n99|// aliased constructor fails the alias gate below.\n100|var refusalConstructors = []string{\n101|\t\"failInvalid\",\n102|\t\"failProtocol\",\n103|\t\"failUnknownOperation\",\n104|\t\"failCapability\",\n105|\t\"failUnavailable\",\n106|\t\"failUnsupportedTuple\",\n107|\t\"failIntegrity\",\n108|}\n109|\n110|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n111|\tt.Helper()\n112|\tdirectory, err := os.Getwd()\n113|\tif err != nil {\n114|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n115|\t}\n116|\tarms, scanned, err := refusalArmsIn(directory)\n117|\tif err != nil {\n118|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n119|\t}\n120|\tif len(scanned) == 0 {\n121|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n122|\t}\n123|\tif len(arms) == 0 {\n124|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n125|\t}\n126|\tif len(arms) < refusalArmCensusFloor {\n127|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n128|\t}\n129|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n130|\treturn arms\n131|}\n132|\n133|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n134|\tentries, err := os.ReadDir(directory)\n135|\tif err != nil {\n136|\t\treturn nil, nil, err\n137|\t}\n138|\tarms := map[string]struct{}{}\n139|\tvar scanned []string\n140|\tconstructors := map[string]bool{}\n141|\tfor _, name := range refusalConstructors {\n142|\t\tconstructors[name] = true\n143|\t}\n144|\tfor _, entry := range entries {\n145|\t\tname := entry.Name()\n146|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n147|\t\t\tcontinue\n148|\t\t}\n149|\t\tscanned = append(scanned, name)\n150|\t\tpath := filepath.Join(directory, name)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"call_id":"call_01a07518f6067fe2a9afe64111371bad","text":"Read text file `internal/sessadapter/census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/printer\"\n9|\t\"go/token\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"testing\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n19|)\n20|\n21|// This file is the closed-vocabulary census. It exists because a\n22|// new closed set in production — a map consulted for membership,\n23|// a slice looped for admission, a switch classifying inputs, an\n24|// inline comparison chain admitting two names — passes every\n25|// behavioral test that never names it. The census finds the\n26|// membership surface by parsing production source and fails\n27|// closed on anything with no registered derivation, so the\n28|// surface cannot grow something unwitnessed.\n29|//\n30|// Five checks:\n31|// TestClosedVocabularyTablesAreRegistered scans every\n32|// package-level var shaped like a vocabulary — a map or slice\n33|// composite, written directly or through a named slice or map\n34|// type declared anywhere in the package — and requires each in\n35|// the registration table below with its consultation proof.\n36|// TestNoUnregisteredInlineVocabularies forbids the shape the\n37|// table scan cannot see: a boolean chain comparing one operand\n38|// against two or more closed values (`v == \"a\" || v == \"b\"`,\n39|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n40|// or conversions). Every closed union lives in a registered\n41|// table; a chain is an unregistered union and fails here.\n42|// TestClosedMemberSetsAreDerivedFromSpec parses every closed\n43|// body from the pinned document and requires exact ordered\n44|// equality with the production member tables: a dropped, added,\n45|// or reordered member reddens here.\n46|// TestAllProductionSwitchesAreClassified allows only switches\n47|// dispatching on the validated operation plus the tagless UTF-16\n48|// hex classifier inside readUTF16Escape, named by function; any\n49|// other switch — including a tagless switch anywhere else — is a\n50|// membership gate hiding spot and fails.\n51|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n52|// against its verbatim spec union as a set.\n53|//\n54|// Stated bound: the scanner is syntactic. It sees package-level\n55|// composite shapes (single, shared, and paired initializers),\n56|// named-type aliases, and comparison chains — not function-local\n57|// composites, not unions encoded in a const string or a regexp\n58|// alternation, and not sets built at runtime (a map populated in\n59|// a loop, a registry assembled in init). This package holds no\n60|// const- or regexp-encoded union and builds no vocabulary at\n61|// runtime: every registered table is a package-level composite\n62|// literal, which the scan asserts by construction — a\n63|// runtime-built set would have to replace a composite the\n64|// census already pins. The five function-local obligation lists\n65|// (the validate target list, the two validate check triples,\n66|// the two target-write lists) are outside the table scan and\n67|// are pinned behaviourally instead, in both directions, by the\n68|// obligation tests.\n69|//\n70|// An empty scan, an empty derivation, or an unparseable file\n71|// fails closed throughout: a domain that silently derives\n72|// nothing is not a measurement.\n73|\n74|// registeredVocabulary is one production vocabulary table with\n75|// its consultation proof: the production function or call\n76|// pattern that consults it for membership.\n77|type registeredVocabulary struct {\n78|\tname       string\n79|\tconsulted  string\n80|\tspecMember string\n81|}\n82|\n83|// vocabularyRegistrations lists every package-level vocabulary\n84|// table. A production table with no row here fails the census.\n85|var vocabularyRegistrations = []registeredVocabulary{\n86|\t{name: \"operationOrder\", consulted: \"validOperation\", specMember: \"Section 7.8 operation table\"},\n87|\t{name: \"requestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 request envelope sentence\"},\n88|\t{name: \"requestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 request envelope sentence\"},\n89|\t{name: \"successMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 success envelope rule\"},\n90|\t{name: \"successRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 success envelope rule\"},\n91|\t{name: \"failureMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 failure envelope rule\"},\n92|\t{name: \"failureRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 failure envelope rule\"},\n93|\t{name: \"capabilityOrder\", consulted: \"decodeCapabilities\", specMember: \"Section 7.8 capability sentence\"},\n94|\t{name: \"manifestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 manifest table\"},\n95|\t{name: \"manifestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 manifest table\"},\n96|\t{name: \"probeMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 probe sentence\"},\n97|\t{name: \"probeRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 probe sentence\"},\n98|\t{name: \"capabilityValueMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 capability value sentence\"},\n99|\t{name: \"capabilityValueRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 capability value sentence\"},\n100|\t{name: \"capabilityEvidences\", consulted: \"validCapabilityEvidence\", specMember: \"Section 7.8 evidence union\"},\n101|\t{name: \"capabilityStatuses\", consulted: \"validCapabilityStatus\", specMember: \"Section 7.8 status union\"},\n102|\t{name: \"contextMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n103|\t{name: \"contextRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n104|\t{name: \"readAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n105|\t{name: \"readAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n106|\t{name: \"objectAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n107|\t{name: \"objectAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n108|\t{name: \"objectPurposes\", consulted: \"validObjectPurpose\", specMember: \"Section 7.8 purpose union\"},\n109|\t{name: \"objectModes\", consulted: \"validObjectMode\", specMember: \"Section 7.8 ObjectAuthority mode union\"},\n110|\t{name: \"readPurposes\", consulted: \"validReadPurpose\", specMember: \"Section 7.8 ReadAuthority purpose union\"},\n111|\t{name: \"findingSeverities\", consulted: \"validFindingSeverity\", specMember: \"Section 7.8 severity union\"},\n112|\t{name: \"sourceSelectorMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n113|\t{name: \"sourceSelectorRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n114|\t{name: \"resourceLimitsMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n115|\t{name: \"resourceLimitsRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n116|\t{name: \"findingMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n117|\t{name: \"findingRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n118|\t{name: \"capturePlanItemMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n119|\t{name: \"capturePlanItemRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n120|\t{name: \"tupleMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
