{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b5","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":437,"recorded_at":1780531400000869,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"task_stream":{"kind":"task","id":"1b10be48-ac77-4b90-9b24-b8bf3bf81e34"},"task_id":"1b10be48-ac77-4b90-9b24-b8bf3bf81e34","event":{"kind":"output","task_id":"1b10be48-ac77-4b90-9b24-b8bf3bf81e34","chunk":"Read text file `internal/sessadapter/identity_census_test.go`.\n(519 line(s) above)\n520|\t\t}\n521|\t}\n522|\tif validRole(Role(\"\")) {\n523|\t\tt.Error(\"validRole(\\\"\\\") = true; the empty role is outside source|target\")\n524|\t}\n525|\tif validRole(\"bogus\") {\n526|\t\tt.Error(\"validRole(\\\"bogus\\\") = true; an arbitrary role is outside source|target\")\n527|\t}\n528|\tif validCandidateKind(CandidateKind(\"\")) {\n529|\t\tt.Error(\"validCandidateKind(\\\"\\\") = true; the empty kind is outside the union\")\n530|\t}\n531|\tif validCandidateKind(CandidateKind(\"bogus\")) {\n532|\t\tt.Error(\"validCandidateKind(\\\"bogus\\\") = true; an arbitrary kind is outside the union\")\n533|\t}\n534|\tif operationSkipsRequestContext(Operation(\"\")) {\n535|\t\tt.Error(\"operationSkipsRequestContext(\\\"\\\") = true; the empty operation skips nothing\")\n536|\t}\n537|\tif operationSkipsRequestContext(Operation(\"bogus\")) {\n538|\t\tt.Error(\"operationSkipsRequestContext(\\\"bogus\\\") = true; an arbitrary operation skips nothing\")\n539|\t}\n540|}\n541|\n542|// identityCensusDomainCount returns the number of non-exempt\n543|// rows in the given domain. Sibling tables with fixed tripwires\n544|// assert against it so they cannot go stale.\n545|func identityCensusDomainCount(domain string) int {\n546|\tcount := 0\n547|\tfor _, row := range identityRegistrations {\n548|\t\tif !row.exempt && row.domain == domain {\n549|\t\t\tcount++\n550|\t\t}\n551|\t}\n552|\treturn count\n553|}\n554|\n555|// probeFactsFor builds the CheckProbe facts for the fixture\n556|// manifest: the expected provider, builtin kind, host-computed\n557|// digest, and verified manifest.\n558|func probeFactsFor(manifest Manifest) ProbeHostFacts {\n559|\treturn ProbeHostFacts{\n560|\t\tExpectedProviderID: fixtureProviderID,\n561|\t\tExpectedKind:       CandidateBuiltin,\n562|\t\tManifestDigest:     ManifestDigest(manifest).String(),\n563|\t\tManifest:           manifest,\n564|\t}\n565|}\n566|\n567|// TestIdentityZeroRows drives every surviving zero-value gate at\n568|// its exported entry: the zero fact refuses through its own arm,\n569|// so a mutant exempting the zero (`!= want && fact != \"\"`)\n570|// admits and reddens here. requireRefusal pins the arm\n571|// identity, so a slide to a neighbouring arm reddens too.\n572|func TestIdentityZeroRows(t *testing.T) {\n573|\tt.Run(\"probe schema empty\", func(t *testing.T) {\n574|\t\tprobe, manifest := fixtureValidProbe(t)\n575|\t\t_ = probe\n576|\t\tdigest := ManifestDigest(manifest).String()\n577|\t\tbase := []byte(fixtureProbeJSON(digest))\n578|\t\tif _, err := DecodeProbe(mutateMember(t, base, \"schema\", `\"\"`)); err == nil {\n579|\t\t\tt.Fatal(\"DecodeProbe admitted an empty schema\")\n580|\t\t} else {\n581|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"schema\", \"not the session adapter probe\")\n582|\t\t}\n583|\t\tif _, err := DecodeProbe(mutateMember(t, base, \"schema_version\", `\"\"`)); err == nil {\n584|\t\t\tt.Fatal(\"DecodeProbe admitted an empty schema_version\")\n585|\t\t} else {\n586|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"schema_version\", \"is not 1.0.0\")\n587|\t\t}\n588|\t})\n589|\tt.Run(\"probe provider zeros\", func(t *testing.T) {\n590|\t\tprobe, manifest := fixtureValidProbe(t)\n591|\t\tfacts := probeFactsFor(manifest)\n592|\t\tproviderless := probe\n593|\t\tproviderless.ProviderID = \"\"\n594|\t\tif err := CheckProbe(providerless, facts); err == nil {\n595|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe provider\")\n596|\t\t} else {\n597|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"requested provider\")\n598|\t\t}\n599|\t\t// Facts-side zero of the expected provider is pinned by\n600|\t\t// TestZeroValueHostFactsRefuse; here the manifest side\n601|\t\t// goes zero with probe and expectation held equal.\n602|\t\tmanifestZero := facts\n603|\t\tmanifestZero.ExpectedProviderID = \"other-provider\"\n604|\t\tzeroed := manifest\n605|\t\tzeroed.ProviderID = \"\"\n606|\t\tmanifestZero.Manifest = zeroed\n607|\t\tother := probe\n608|\t\tother.ProviderID = \"other-provider\"\n609|\t\tif err := CheckProbe(other, manifestZero); err == nil {\n610|\t\t\tt.Fatal(\"CheckProbe admitted an empty manifest provider\")\n611|\t\t} else {\n612|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"verified manifest\")\n613|\t\t}\n614|\t})\n615|\tt.Run(\"probe digest zeros\", func(t *testing.T) {\n616|\t\tprobe, manifest := fixtureValidProbe(t)\n617|\t\tfacts := probeFactsFor(manifest)\n618|\t\tdigestless := probe\n619|\t\tdigestless.ManifestDigest = \"\"\n620|\t\tif err := CheckProbe(digestless, facts); err == nil {\n621|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe digest\")\n622|\t\t} else {\n623|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_manifest_digest\", \"host-computed digest\")\n624|\t\t}\n625|\t\tfactsless := facts\n626|\t\tfactsless.ManifestDigest = \"\"\n627|\t\tif err := CheckProbe(probe, factsless); err == nil {\n628|\t\t\tt.Fatal(\"CheckProbe admitted an empty expected digest\")\n629|\t\t} else {\n630|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_manifest_digest\", \"host-computed digest\")\n631|\t\t}\n632|\t})\n633|\tt.Run(\"probe version zeros\", func(t *testing.T) {\n634|\t\tprobe, manifest := fixtureValidProbe(t)\n635|\t\tfacts := probeFactsFor(manifest)\n636|\t\tversionless := probe\n637|\t\tversionless.AdapterVersion = \"\"\n638|\t\tif err := CheckProbe(versionless, facts); err == nil {\n639|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe version\")\n640|\t\t} else {\n641|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_version\", \"verified manifest\")\n642|\t\t}\n643|\t\tmanifestless := facts\n644|\t\tzeroed := manifest\n645|\t\tzeroed.AdapterVersion = \"\"\n646|\t\tmanifestless.Manifest = zeroed\n647|\t\tif err := CheckProbe(probe, manifestless); err == nil {\n648|\t\t\tt.Fatal(\"CheckProbe admitted an empty manifest version\")\n649|\t\t} else {\n650|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_version\", \"verified manifest\")\n651|\t\t}\n652|\t\tdriftless := probe\n653|\t\tdriftless.Environment.AdapterVersion = \"\"\n654|\t\tif err := CheckProbe(driftless, facts); err == nil {\n655|\t\t\tt.Fatal(\"CheckProbe admitted an empty tuple adapter version\")\n656|\t\t} else {\n657|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"environment\", \"probe adapter version\")\n658|\t\t}\n659|\t})\n660|\tt.Run(\"probe tuple environment zero\", func(t *testing.T) {\n661|\t\tprobe, manifest := fixtureValidProbe(t)\n662|\t\tfacts := probeFactsFor(manifest)\n663|\t\ttupleless := probe\n664|\t\ttupleless.Environment.EnvironmentID = \"\"\n665|\t\tif err := CheckProbe(tupleless, facts); err == nil {\n666|\t\t\tt.Fatal(\"CheckProbe admitted an empty tuple environment\")\n667|\t\t} else {\n668|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", \"\", \"outside the manifest environment\")\n669|\t\t}\n670|\t})\n671|\tt.Run(\"probe request zeros\", func(t *testing.T) {\n672|\t\tcandidate := fixtureCandidate()\n673|\t\tif err := CheckProbeRequest(\"\", CandidateBuiltin, candidate); err == nil {\n674|\t\t\tt.Fatal(\"CheckProbeRequest admitted an empty expected provider\")\n675|\t\t} else {\n676|\t\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n677|\t\t}\n678|\t\tproviderless := candidate\n679|\t\tproviderless.ProviderID = \"\"\n680|\t\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, providerless); err == nil {\n681|\t\t\tt.Fatal(\"CheckProbeRequest admitted an empty candidate provider\")\n682|\t\t} else {\n683|\t\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n684|\t\t}\n685|\t})\n686|\tt.Run(\"doctor direction zero\", func(t *testing.T) {\n687|\t\tmanifestDigest := fixtureManifestDigestText(t)\n688|\t\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n689|\t\tdecoded, err := CheckRequestBody(OpDoctor, request)\n690|\t\tif err != nil {\n691|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n692|\t\t}\n693|\t\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n694|\t\tif _, err := DecodeDoctorResult(good, decoded, \"\"); err == nil {\n695|\t\t\tt.Fatal(\"DecodeDoctorResult admitted an empty request direction\")\n696|\t\t} else {\n697|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"direction\", \"does not answer the request direction\")\n698|\t\t}\n699|\t})\n700|\tt.Run(\"doctor entry status zero\", func(t *testing.T) {\n701|\t\tmanifestDigest := fixtureManifestDigestText(t)\n702|\t\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n703|\t\tdecoded, err := CheckRequestBody(OpDoctor, request)\n704|\t\tif err != nil {\n705|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n706|\t\t}\n707|\t\tprobe, _ := fixtureValidProbe(t)\n708|\t\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n709|\t\thealthy, err := DecodeDoctorResult(mutateMember(t, good, \"healthy\", `true`), decoded, DirectionSourceRead)\n710|\t\tif err != nil {\n711|\t\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n712|\t\t}\n713|\t\tstatusless := healthy\n714|\t\tstatusless.EntryStatus = \"\"\n715|\t\trequired := DoctorRequiredCapabilities(DirectionTargetWrite, false)\n716|\t\tif err := CheckDoctorHealthy(statusless, probe, required); err == nil {\n717|\t\t\tt.Fatal(\"CheckDoctorHealthy admitted an empty entry status as healthy\")\n718|\t\t} else {\n719|\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"tuple_registry\", \"accepted registry entry\")\n720|\t\t}\n721|\t})\n722|\tt.Run(\"request digest zero\", func(t *testing.T) {\n723|\t\tmanifestDigest := fixtureManifestDigestText(t)\n724|\t\tbody := fixtureRequestBody(t, OpDiscover, manifestDigest)\n725|\t\tdecoded, err := CheckRequestBody(OpDiscover, body)\n726|\t\tif err != nil {\n727|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n728|\t\t}\n729|\t\tif err := VerifyRequestDigest(decoded, body); err != nil {\n730|\t\t\tt.Fatalf(\"VerifyRequestDigest baseline: %v\", err)\n731|\t\t}\n732|\t\tdigestless := decoded\n733|\t\tdigestless.RequestDigest = \"\"\n734|\t\tif err := VerifyRequestDigest(digestless, body); err == nil {\n735|\t\t\tt.Fatal(\"VerifyRequestDigest admitted an empty request digest\")\n736|\t\t} else {\n737|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"request_digest\", \"does not match\")\n738|\t\t}\n739|\t})\n740|\tt.Run(\"discover provider zeros\", func(t *testing.T) {\n741|\t\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n742|\t\tif err != nil {\n743|\t\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n744|\t\t}\n745|\t\tdigest := ManifestDigest(manifest).String()\n746|\t\tcandidate := fixtureCandidate()\n747|\t\tproviderless := manifest\n748|\t\tproviderless.ProviderID = \"\"\n749|\t\tif _, err := Discover(RoleSource, providerless, digest, candidate); err == nil {\n750|\t\t\tt.Fatal(\"Discover admitted an empty manifest provider\")\n751|\t\t} else {\n752|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"trusted candidate\")\n753|\t\t}\n754|\t\tcandidateless := candidate\n755|\t\tcandidateless.ProviderID = \"\"\n756|\t\tif _, err := Discover(RoleSource, manifest, digest, candidateless); err == nil {\n757|\t\t\tt.Fatal(\"Discover admitted an empty candidate provider\")\n758|\t\t} else {\n759|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"trusted candidate\")\n760|\t\t}\n761|\t})\n762|\tt.Run(\"call binding caller zeros\", func(t *testing.T) {\n763|\t\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n764|\t\tif err != nil {\n765|\t\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n766|\t\t}\n767|\t\tbinding, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n768|\t\tif err != nil {\n769|\t\t\tt.Fatalf(\"Discover: %v\", err)\n770|\t\t}\n771|\t\tbody := fixtureRequestWithDigest(t, ManifestDigest(manifest).String())\n772|\t\tcontext, err := CheckRequestBody(OpDiscover, body)\n773|\t\tif err != nil {\n774|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n775|\t\t}\n776|\t\tadmitted, err := DecodeTuple([]byte(fixtureTupleJSON()))\n777|\t\tif err != nil {\n778|\t\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n779|\t\t}\n780|\t\tproviderless := context\n781|\t\tproviderless.ProviderID = \"\"\n782|\t\tif err := CheckCallBinding(binding, RoleSource, providerless, admitted); err == nil {\n783|\t\t\tt.Fatal(\"CheckCallBinding admitted an empty context provider\")\n784|\t\t} else {\n785|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"sealed binding\")\n786|\t\t}\n787|\t\tdigestless := context\n788|\t\tdigestless.ManifestDigest = \"\"\n789|\t\tif err := CheckCallBinding(binding, RoleSource, digestless, admitted); err == nil {\n790|\t\t\tt.Fatal(\"CheckCallBinding admitted