{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a5","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":173,"recorded_at":1780531400000341,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"task_stream":{"kind":"task","id":"a962ff01-17fa-4123-bdde-9bc422965267"},"task_id":"a962ff01-17fa-4123-bdde-9bc422965267","event":{"kind":"output","task_id":"a962ff01-17fa-4123-bdde-9bc422965267","chunk":"Read text file `internal/sessadapter/bound_census_test.go`.\n1|package sessadapter\n2|\n3|// This file is the bound census (review rev4 B8). It exists because a\n4|// new bound through any of the six helpers — checkStringBounds,\n5|// requireStringBounds, checkUint53Bounds, requireUint53Bounds,\n6|// checkSortedUniqueStrings, checkSortedUniqueDigests — or a new\n7|// explicit len(...) guard passes every behavioral test that never\n8|// names it, and pinning checkStringBounds while requireStringBounds\n9|// goes unmeasured reads as complete at 35 of 35 while half the\n10|// class stays open.\n11|//\n12|// The mechanism note: requireStringBounds is a transparent wrapper\n13|// over checkStringBounds (operations.go, declared 100 lines above\n14|// the pinned sites) carrying 13 of the production call sites, and\n15|// requireUint53Bounds the same over checkUint53Bounds. Both\n16|// wrappers are rostered below as mechanism rows: they forward\n17|// their min/max to the shared checker, so their values are pinned\n18|// at the caller rows, not at the wrapper.\n19|//\n20|// Shape, modelled on TestClosedVocabularyTablesAreRegistered:\n21|// scanBoundSiteIDs derives every bound site from production source\n22|// (helper calls with their member, len guards in any statement\n23|// context, DecodeFindings cap instantiations), and\n24|// TestBoundGuardsAreCensused requires the derived multiset to\n25|// equal boundRegistrations exactly. A new bound with no row fails\n26|// the census; a removed bound orphans its row and fails too. A\n27|// helper alias (`var f = requireStringBounds`) fails as an\n28|// indirection violation rather than a missed site. An empty scan\n29|// fails closed. Site identity is file|function|member,\n30|// never the bound values: a moved bound (+1) keeps its identity\n31|// and must redden its behavioral driver, which the mutant battery\n32|// proves per row.\n33|//\n34|// Every non-exempt row names its driver: the committed test\n35|// driving min-1/min/max/max+1 (or the applicable edges) through\n36|// the production entry. Exempt rows say why: equivalent (the\n37|// bound is unreachable behind an upstream gate), stated-bound\n38|// (a 65537-element body), mechanism (transparent forwarder or\n39|// generic guard whose values live at the caller rows), or\n40|// plumbing (byte-scanner loop guards pinned by the surrogate\n41|// agreement suite).\n42|//\n43|// Stated bounds of this census: cross-field relational gates\n44|// (maxObjects > maxTotalBytes and its sibling in\n45|// DecodeResourceLimits) are not edge-valued sites and are pinned\n46|// behaviourally by TestDecodeResourceLimitsBounds instead; the\n47|// maxUint53 maxima are representability bounds pinned once by\n48|// TestUint53RepresentabilityCeiling rather than per site.\n49|\n50|import (\n51|\t\"bytes\"\n52|\t\"encoding/json\"\n53|\t\"fmt\"\n54|\t\"go/ast\"\n55|\t\"go/parser\"\n56|\t\"go/printer\"\n57|\t\"go/token\"\n58|\t\"os\"\n59|\t\"path/filepath\"\n60|\t\"sort\"\n61|\t\"strconv\"\n62|\t\"strings\"\n63|\t\"testing\"\n64|)\n65|\n66|// boundRegistration is one production bound site with its proof:\n67|// the behavioral driver covering its edges, or an explicit\n68|// exemption with its rationale.\n69|type boundRegistration struct {\n70|\tid     string\n71|\tdriver string\n72|\texempt bool\n73|\treason string\n74|}\n75|\n76|// boundHelpers is the closed helper set the census derives. A\n77|// seventh bound helper with no row here fails the census only if\n78|// it is called; the call-shape derivation below names the helper\n79|// per site, so an unrostered helper surfaces as unregistered\n80|// sites.\n81|var boundHelpers = map[string]bool{\n82|\t\"checkStringBounds\":        true,\n83|\t\"requireStringBounds\":      true,\n84|\t\"checkUint53Bounds\":        true,\n85|\t\"requireUint53Bounds\":      true,\n86|\t\"checkSortedUniqueStrings\": true,\n87|\t\"checkSortedUniqueDigests\": true,\n88|}\n89|\n90|// scanBoundSiteIDs derives every bound site identity from\n91|// production source: file|function|helper|member|ordinal for the\n92|// six helpers and DecodeFindings instantiations, and\n93|// file|function|len|rendered|ordinal for len guards in any\n94|// statement context (if, for, switch, return, assignment —\n95|// review rev5/F2). Values are deliberately not part of the\n96|// identity. A func-value indirection of any helper (`var f =\n97|// requireStringBounds`, at package or function scope) is a\n98|// census violation, not a missed site: refusals built through\n99|// the alias hide from this derivation exactly the way\n100|// axerror.New aliases hid from the constructor census (review\n101|// rev4/N8), and the import-census shape applies here — the alias\n102|// itself fails rather than each hidden call. The synthetic\n103|// TestBoundHelperIndirectionReports and\n104|// TestBoundLenScanSeesNonIfContexts prove both halves.\n105|func scanBoundSiteIDs(t *testing.T, directory string) []string {\n106|\tt.Helper()\n107|\tentries, err := os.ReadDir(directory)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"bound census: %v\", err)\n110|\t}\n111|\tvar ids []string\n112|\tscanned := 0\n113|\tfor _, entry := range entries {\n114|\t\tname := entry.Name()\n115|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n116|\t\t\tcontinue\n117|\t\t}\n118|\t\tscanned++\n119|\t\tpath := filepath.Join(directory, name)\n120|\t\tsource, err := os.ReadFile(path)\n121|\t\tif err != nil {\n122|\t\t\tt.Fatalf(\"bound census: %v\", err)\n123|\t\t}\n124|\t\tfileSet := token.NewFileSet()\n125|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n126|\t\tif err != nil {\n127|\t\t\tt.Fatalf(\"bound census: %v\", err)\n128|\t\t}\n129|\t\tsites, violations := boundSitesInSyntax(syntax, name)\n130|\t\tfor _, violation := range violations {\n131|\t\t\tt.Errorf(\"bound census: %s: %s\", name, violation)\n132|\t\t}\n133|\t\tids = append(ids, sites...)\n134|\t}\n135|\tif scanned == 0 {\n136|\t\tt.Fatal(\"bound census scanned zero production files; the scanner is broken, not the package\")\n137|\t}\n138|\treturn ids\n139|}\n140|\n141|// boundSitesInSyntax derives the bound site identities of one\n142|// parsed production file and reports every helper indirection.\n143|// Direct helper calls claim file|function|helper|member|ordinal;\n144|// DecodeFindings instantiations claim their member; every len\n145|// comparison in any statement context claims\n146|// file|function|len|rendered|ordinal. A use of a helper name\n147|// that is neither a direct call nor one of the six function\n148|// definitions is an indirection violation.\n149|func boundSitesInSyntax(syntax *ast.File, name string) (sites []string, violations []string) {\n150|\tfor _, declaration := range syntax.Decls {\n151|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n152|\t\tif !ok || function.Body == nil {\n153|\t\t\tcontinue\n154|\t\t}\n155|\t\tordinal := map[string]int{}\n156|\t\tclaim := func(base string) {\n157|\t\t\tsites = append(sites, base+\"|\"+strconv.Itoa(ordinal[base]))\n158|\t\t\tordinal[base]++\n159|\t\t}\n160|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n161|\t\t\tcall, ok := node.(*ast.CallExpr)\n162|\t\t\tif !ok {\n163|\t\t\t\treturn true\n164|\t\t\t}\n165|\t\t\tident, ok := call.Fun.(*ast.Ident)\n166|\t\t\tif !ok {\n167|\t\t\t\treturn true\n168|\t\t\t}\n169|\t\t\tswitch {\n170|\t\t\tcase boundHelpers[ident.Name]:\n171|\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|\" + ident.Name + \"|\" + boundMemberOf(call, ident.Name))\n172|\t\t\tcase ident.Name == \"DecodeFindings\":\n173|\t\t\t\tmember := renderBoundExpr(call.Args[0])\n174|\t\t\t\tif index, ok := call.Args[0].(*ast.IndexExpr); ok {\n175|\t\t\t\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n176|\t\t\t\t\t\tmember = literal.Value\n177|\t\t\t\t\t}\n178|\t\t\t\t}\n179|\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|DecodeFindings|\" + member)\n180|\t\t\t}\n181|\t\t\treturn true\n182|\t\t})\n183|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n184|\t\t\tcomparison, ok := node.(*ast.BinaryExpr)\n185|\t\t\tif !ok {\n186|\t\t\t\treturn true\n187|\t\t\t}\n188|\t\t\tswitch comparison.Op {\n189|\t\t\tcase token.GTR, token.GEQ, token.LSS, token.LEQ, token.EQL, token.NEQ:\n190|\t\t\tdefault:\n191|\t\t\t\treturn true\n192|\t\t\t}\n193|\t\t\tif !hasLenCall(comparison) {\n194|\t\t\t\treturn true\n195|\t\t\t}\n196|\t\t\tclaim(name + \"|\" + function.Name.Name + \"|len|\" + normalizeBoundNumbers(renderBoundExpr(comparison)))\n197|\t\t\treturn true\n198|\t\t})\n199|\t}\n200|\tviolations = append(violations, boundHelperIndirections(syntax)...)\n(more lines below)"}}}
