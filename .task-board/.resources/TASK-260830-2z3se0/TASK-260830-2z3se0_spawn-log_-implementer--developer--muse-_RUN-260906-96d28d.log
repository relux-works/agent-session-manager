ice\", row.id)\n523|\t\t}\n524|\t\tseen[row.id] = true\n525|\t\tregisteredCounts[row.id]++\n526|\t\tif row.driver == \"\" && !row.exempt {\n527|\t\t\tt.Errorf(\"bound census row %q names no driver and no exemption\", row.id)\n528|\t\t}\n529|\t\tif row.exempt && row.reason == \"\" {\n530|\t\t\tt.Errorf(\"bound census exemption %q states no rationale\", row.id)\n531|\t\t}\n532|\t}\n533|\tvar unregistered []string\n534|\tfor id, count := range derivedCounts {\n535|\t\tfor i := registeredCounts[id]; i < count; i++ {\n536|\t\t\tunregistered = append(unregistered, id)\n537|\t\t}\n538|\t}\n539|\tvar orphaned []string\n540|\tfor id, count := range registeredCounts {\n541|\t\tfor i := derivedCounts[id]; i < count; i++ {\n542|\t\t\torphaned = append(orphaned, id)\n543|\t\t}\n544|\t}\n545|\tsort.Strings(unregistered)\n546|\tsort.Strings(orphaned)\n547|\tif len(unregistered) > 0 {\n548|\t\tt.Fatalf(\"production bound site(s) with no census row:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n549|\t}\n550|\tif len(orphaned) > 0 {\n551|\t\tt.Fatalf(\"census row(s) naming no production site:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n552|\t}\n553|\tdriven, exempt := 0, 0\n554|\tfor _, row := range boundRegistrations {\n555|\t\tif row.exempt {\n556|\t\t\texempt++\n557|\t\t} else {\n558|\t\t\tdriven++\n559|\t\t}\n560|\t}\n561|\tt.Logf(\"bound census: %d sites rostered (%d driven, %d exempt) across production\", len(derived), driven, exempt)\n562|}\n563|\n564|// TestBoundHelperIndirectionReports proves the indirection half\n565|// of the bound census against synthetic files: a package-level\n566|// `var f = requireStringBounds` and a function-local alias both\n567|// report, while a direct helper call and the helper definition\n568|// itself stay exempt. The vectors are synthetic on purpose: they\n569|// prove the gate, not production. This is the regression test\n570|// for review rev5/F2 (repeat of rev4/N8): the alias plant passed\n571|// the whole suite because the scanner matched `call.Fun` only.\n572|func TestBoundHelperIndirectionReports(t *testing.T) {\n573|\tparse := func(source string) *ast.File {\n574|\t\tt.Helper()\n575|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), 0)\n576|\t\tif err != nil {\n577|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n578|\t\t}\n579|\t\treturn syntax\n580|\t}\n581|\tt.Run(\"package-level alias reports\", func(t *testing.T) {\n582|\t\tsyntax := parse(\"package probe\\nvar zzprobeIndirect = requireStringBounds\\nfunc f(m map[string]json.RawMessage) error {\\nreturn zzprobeIndirect(m, \\\"zz_probe_member\\\", 1, 4096)\\n}\\n\")\n583|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 1 {\n584|\t\t\tt.Fatalf(\"violations = %v, want the single indirection report\", violations)\n585|\t\t}\n586|\t})\n587|\tt.Run(\"function-local alias reports\", func(t *testing.T) {\n588|\t\tsyntax := parse(\"package probe\\nfunc f() {\\nindirect := requireStringBounds\\n_ = indirect\\n}\\n\")\n589|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 1 {\n590|\t\t\tt.Fatalf(\"violations = %v, want the single indirection report\", violations)\n591|\t\t}\n592|\t})\n593|\tt.Run(\"direct call stays exempt\", func(t *testing.T) {\n594|\t\tsyntax := parse(\"package probe\\nfunc f(m map[string]json.RawMessage) error {\\nreturn requireStringBounds(m, \\\"zz_probe_member\\\", 1, 4096)\\n}\\n\")\n595|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 0 {\n596|\t\t\tt.Fatalf(\"violations = %v, want none for a direct call\", violations)\n597|\t\t}\n598|\t})\n599|\tt.Run(\"helper definition stays exempt\", func(t *testing.T) {\n600|\t\tsyntax := parse(\"package probe\\nfunc requireStringBounds(m map[string]json.RawMessage, name string, minimum, maximum int) error {\\nreturn nil\\n}\\n\")\n601|\t\tif violations := boundHelperIndirections(syntax); len(violations) != 0 {\n602|\t\t\tt.Fatalf(\"violations = %v, want none for the definition spelling\", violations)\n603|\t\t}\n604|\t})\n605|}\n606|\n607|// TestBoundLenScanSeesNonIfContexts proves the context half of\n608|// the bound census against a synthetic file: len guards in a\n609|// return, a for condition, a switch condition, and an assignment\n610|// all derive, while a boundless len use (a slice length passed\n611|// to make) does not claim a guard. The vectors are synthetic on\n612|// purpose: they prove the gate, not production. This is the\n613|// regression test for the second and third plants of review\n614|// rev5/F2, which hid in return and for positions the if-only\n615|// walk never visited.\n616|func TestBoundLenScanSeesNonIfContexts(t *testing.T) {\n617|\tsource := \"package probe\\nfunc zzReturnBound(value string) bool {\\nreturn len(value) >= 1 && len(value) <= 512\\n}\\n\" +\n618|\t\t\"func zzForBound(values []string) int {\\nn := 0\\nfor i := 0; len(values) > 128 && i < 1; i++ {\\nn++\\n}\\nreturn n\\n}\\n\" +\n619|\t\t\"func zzSwitchBound(values []string) int {\\nswitch {\\ncase len(values) == 0:\\nreturn 0\\ndefault:\\nreturn 1\\n}\\n}\\n\" +\n620|\t\t\"func zzAssignBound(values []string) int {\\nover := len(values) > 64\\nif over {\\nreturn 1\\n}\\nreturn 0\\n}\\n\" +\n621|\t\t\"func zzBoundless(values []string) []string {\\nreturn make([]string, 0, len(values))\\n}\\n\"\n622|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), 0)\n623|\tif err != nil {\n624|\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n625|\t}\n626|\tsites, violations := boundSitesInSyntax(syntax, \"probe.go\")\n627|\tif len(violations) != 0 {\n628|\t\tt.Fatalf(\"violations = %v, want none\", violations)\n629|\t}\n630|\tcontains := func(want string) bool {\n631|\t\tfor _, id := range sites {\n632|\t\t\tif strings.HasPrefix(id, want) {\n633|\t\t\t\treturn true\n634|\t\t\t}\n635|\t\t}\n636|\t\treturn false\n637|\t}\n638|\tfor _, want := range []string{\n639|\t\t\"probe.go|zzReturnBound|len|\",\n640|\t\t\"probe.go|zzForBound|len|\",\n641|\t\t\"probe.go|zzSwitchBound|len|\",\n642|\t\t\"probe.go|zzAssignBound|len|\",\n643|\t} {\n644|\t\tif !contains(want) {\n645|\t\t\tt.Errorf(\"sites = %v, want a site under %q\", sites, want)\n646|\t\t}\n647|\t}\n648|\tif contains(\"probe.go|zzBoundless|len|\") {\n649|\t\tt.Errorf(\"sites = %v, want no guard for the boundless make length\", sites)\n650|\t}\n651|}\n652|\n653|// boundCensusDriverCount returns the number of non-exempt rows\n654|// naming the given driver. Sibling tables with fixed tripwires\n655|// (TestStringBoundEdges) assert against it so they cannot go\n656|// stale when the roster grows.\n657|func boundCensusDriverCount(driver string) int {\n658|\tcount := 0\n659|\tfor _, row := range boundRegistrations {\n660|\t\tif !row.exempt && row.driver == driver {\n661|\t\t\tcount++\n662|\t\t}\n663|\t}\n664|\treturn count\n665|}\n666|\n667|// requestStringBoundRow is one requireStringBounds site on the\n668|// request path: operation, member, and inclusive character\n669|// bounds, driven through CheckRequestBody.\n670|type requestStringBoundRow struct {\n671|\toperation Operation\n672|\tmember    string\n673|\tmin       int\n674|\tmax       int\n675|}\n676|\n677|// TestRequestScalarBoundEdges drives every requireStringBounds\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
