{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdf5","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":1365,"recorded_at":1780531400002725,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"task_stream":{"kind":"task","id":"d1186074-afbf-46d2-b325-87305c844186"},"task_id":"d1186074-afbf-46d2-b325-87305c844186","event":{"kind":"output","task_id":"d1186074-afbf-46d2-b325-87305c844186","chunk":"Read text file `internal/sessadapter/census_test.go`.\n(299 line(s) above)\n300|\t\t\t\tdefault:\n301|\t\t\t\t\tcontinue\n302|\t\t\t\t}\n303|\t\t\t\tif isVocabularyShape(initializer, named) {\n304|\t\t\t\t\tfound = append(found, ident.Name)\n305|\t\t\t\t}\n306|\t\t\t}\n307|\t\t}\n308|\t}\n309|\treturn found\n310|}\n311|\n312|// isVocabularyShape reports whether the initializer is a\n313|// vocabulary composite: a map or slice literal, or a composite\n314|// through a named type whose underlying type — resolved across\n315|// the package, through any alias chain — is a map or slice.\n316|// Element type is irrelevant; registrations name the table, not\n317|// its shape. A composite through any other named type (a struct\n318|// literal, a string conversion) is not a table.\n319|func isVocabularyShape(node ast.Expr, named map[string]ast.Expr) bool {\n320|\tliteral, ok := node.(*ast.CompositeLit)\n321|\tif !ok {\n322|\t\treturn false\n323|\t}\n324|\tswitch typ := literal.Type.(type) {\n325|\tcase *ast.MapType, *ast.ArrayType:\n326|\t\treturn true\n327|\tcase *ast.Ident:\n328|\t\treturn resolvesToComposite(typ.Name, named, 0)\n329|\t}\n330|\treturn false\n331|}\n332|\n333|// resolvesToComposite reports whether the named type ultimately\n334|// denotes a map or slice. Alias chains resolve up to a fixed\n335|// depth; a cycle or an unknown name is not a table.\n336|func resolvesToComposite(name string, named map[string]ast.Expr, depth int) bool {\n337|\tif depth > 8 {\n338|\t\treturn false\n339|\t}\n340|\tunderlying, ok := named[name]\n341|\tif !ok {\n342|\t\treturn false\n343|\t}\n344|\tswitch typ := underlying.(type) {\n345|\tcase *ast.MapType, *ast.ArrayType:\n346|\t\treturn true\n347|\tcase *ast.Ident:\n348|\t\treturn resolvesToComposite(typ.Name, named, depth+1)\n349|\t}\n350|\treturn false\n351|}\n352|\n353|// TestAllProductionSwitchesAreClassified allows only switches\n354|// dispatching on the validated operation plus the tagless UTF-16\n355|// hex classifier inside readUTF16Escape. Any other switch —\n356|// including a tagless switch in any other function — is a\n357|// membership gate hiding spot and fails: membership lives in\n358|// tables the census sees, never in case arms it cannot.\n359|func TestAllProductionSwitchesAreClassified(t *testing.T) {\n360|\tdirectory, err := os.Getwd()\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"switch census: %v\", err)\n363|\t}\n364|\tentries, err := os.ReadDir(directory)\n365|\tif err != nil {\n366|\t\tt.Fatalf(\"switch census: %v\", err)\n367|\t}\n368|\tscanned := 0\n369|\tclassified := 0\n370|\tvar unclassified []string\n371|\tfor _, entry := range entries {\n372|\t\tname := entry.Name()\n373|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n374|\t\t\tcontinue\n375|\t\t}\n376|\t\tscanned++\n377|\t\tpath := filepath.Join(directory, name)\n378|\t\tsource, err := os.ReadFile(path)\n379|\t\tif err != nil {\n380|\t\t\tt.Fatalf(\"switch census: %v\", err)\n381|\t\t}\n382|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n383|\t\tif err != nil {\n384|\t\t\tt.Fatalf(\"switch census: %v\", err)\n385|\t\t}\n386|\t\tvar stack []ast.Node\n387|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n388|\t\t\tif node == nil {\n389|\t\t\t\tstack = stack[:len(stack)-1]\n390|\t\t\t\treturn true\n391|\t\t\t}\n392|\t\t\tif statement, ok := node.(*ast.SwitchStmt); ok {\n393|\t\t\t\tposition := filepath.Base(path)\n394|\t\t\t\tif classifySwitch(statement.Tag, enclosingFunc(stack)) {\n395|\t\t\t\t\tclassified++\n396|\t\t\t\t} else {\n397|\t\t\t\t\tunclassified = append(unclassified, position)\n398|\t\t\t\t}\n399|\t\t\t}\n(more lines below)"}}}
