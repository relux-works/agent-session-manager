{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c78f","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":546,"recorded_at":1780531400001087,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"call_id":"call_01a0751aa12574839505ebc285c531de","text":"Read text file `internal/sessadapter/inventory_test.go`.\n(149 line(s) above)\n150|\t\tpath := filepath.Join(directory, name)\n151|\t\tsource, err := os.ReadFile(path)\n152|\t\tif err != nil {\n153|\t\t\treturn nil, nil, err\n154|\t\t}\n155|\t\tfileSet := token.NewFileSet()\n156|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n157|\t\tif err != nil {\n158|\t\t\treturn nil, nil, err\n159|\t\t}\n160|\t\tif err := collectFileArms(fileSet, syntax, constructors, arms); err != nil {\n161|\t\t\treturn nil, nil, err\n162|\t\t}\n163|\t}\n164|\treturn arms, scanned, nil\n165|}\n166|\n167|// TestRefusalConstructorsMatchProduction pins the constructor\n168|// denominator against production source in both directions: the\n169|// set of package-level func-valued vars whose body constructs\n170|// an error with axerror.New must equal refusalConstructors\n171|// exactly, and every axerror.New call in production must sit\n172|// inside one registered constructor body. A func-value\n173|// indirection of the constructor (`var newFault = axerror.New`)\n174|// is refused outright: the reference names the constructor\n175|// without calling it, so a refusal built through the alias\n176|// hides from both the census and the arm derivation. The arm\n177|// inventory observes only registered constructors, so an eighth\n178|// constructor with an additive arm, an inline axerror.New\n179|// refusal with an additive arm, or an indirection with an\n180|// additive arm all survive the full suite — and all fail here,\n181|// the first as an unregistered constructor, the second as a\n182|// construction site outside every registered body, the third as\n183|// an indirection. axerror.Decode is a read, not a construction,\n184|// and is ignored. An empty scan fails closed.\n185|func TestRefusalConstructorsMatchProduction(t *testing.T) {\n186|\tdirectory, err := os.Getwd()\n187|\tif err != nil {\n188|\t\tt.Fatalf(\"constructor census: %v\", err)\n189|\t}\n190|\tentries, err := os.ReadDir(directory)\n191|\tif err != nil {\n192|\t\tt.Fatalf(\"constructor census: %v\", err)\n193|\t}\n194|\tregistered := map[string]bool{}\n195|\tfor _, name := range refusalConstructors {\n196|\t\tregistered[name] = true\n197|\t}\n198|\tproduced := map[string]string{}\n199|\tscanned := 0\n200|\tvar violations []string\n201|\tfor _, entry := range entries {\n202|\t\tname := entry.Name()\n203|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n204|\t\t\tcontinue\n205|\t\t}\n206|\t\tscanned++\n207|\t\tpath := filepath.Join(directory, name)\n208|\t\tsource, err := os.ReadFile(path)\n209|\t\tif err != nil {\n210|\t\t\tt.Fatalf(\"constructor census: %v\", err)\n211|\t\t}\n212|\t\tfileSet := token.NewFileSet()\n213|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n214|\t\tif err != nil {\n215|\t\t\tt.Fatalf(\"constructor census: %v\", err)\n216|\t\t}\n217|\t\tfor _, violation := range constructorSitesInFile(fileSet, syntax, registered, produced, name) {\n218|\t\t\tviolations = append(violations, name+\": \"+violation)\n219|\t\t}\n220|\t}\n221|\tif scanned == 0 {\n222|\t\tt.Fatal(\"constructor census scanned zero production files; the scanner is broken, not the package\")\n223|\t}\n224|\tsort.Strings(violations)\n225|\tif len(violations) > 0 {\n226|\t\tt.Fatalf(\"error-construction site(s) outside the registered constructors:\\n  %s\", strings.Join(violations, \"\\n  \"))\n227|\t}\n228|\tvar unregistered []string\n229|\tfor name, file := range produced {\n230|\t\tif !registered[name] {\n231|\t\t\tunregistered = append(unregistered, name+\" (\"+file+\")\")\n232|\t\t}\n233|\t}\n234|\tvar orphaned []string\n235|\tfor name := range registered {\n236|\t\tif _, ok := produced[name]; !ok {\n237|\t\t\torphaned = append(orphaned, name)\n238|\t\t}\n239|\t}\n240|\tsort.Strings(unregistered)\n241|\tsort.Strings(orphaned)\n242|\tif len(unregistered) > 0 {\n243|\t\tt.Fatalf(\"production error constructor(s) with no census registration:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n244|\t}\n245|\tif len(orphaned) > 0 {\n246|\t\tt.Fatalf(\"census registration(s) naming no production constructor:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n247|\t}\n248|\tt.Logf(\"constructor census: %d constructors across %d files\", len(produced), scanned)\n249|}\n250|\n251|// TestConstructorSitesReportFuncValueIndirection proves the\n252|// indirection case of the constructor census against synthetic\n253|// files: a package-level `var newFault = axerror.New` reports\n254|// even with no refusal built through it yet, while a New call\n255|// inside the registered definition and a Decode read stay\n256|// exempt. The vectors are synthetic on purpose: they prove the\n257|// gate, not production.\n258|func TestConstructorSitesReportFuncValueIndirection(t *testing.T) {\n259|\tregistered := map[string]bool{\"failInvalid\": true}\n260|\tparse := func(source string) (*token.FileSet, *ast.File) {\n261|\t\tt.Helper()\n262|\t\tfileSet := token.NewFileSet()\n263|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n264|\t\tif err != nil {\n265|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n266|\t\t}\n267|\t\treturn fileSet, syntax\n268|\t}\n269|\tt.Run(\"package-level indirection reports\", func(t *testing.T) {\n270|\t\tfileSet, syntax := parse(\"package probe\\nvar newFault = axerror.New\\nfunc f() { _, _ = newFault(nil) }\\n\")\n271|\t\tproduced := map[string]string{}\n272|\t\tviolations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\")\n273|\t\tif len(violations) != 1 {\n274|\t\t\tt.Fatalf(\"violations = %v, want the single indirection report\", violations)\n275|\t\t}\n276|\t\tif !strings.Contains(violations[0], \"indirection\") {\n277|\t\t\tt.Fatalf(\"violation = %q, want the indirection sentence\", violations[0])\n278|\t\t}\n279|\t})\n280|\tt.Run(\"function-local indirection reports\", func(t *testing.T) {\n281|\t\tfileSet, syntax := parse(\"package probe\\nfunc f() { newFault := axerror.New\\n_ = newFault }\\n\")\n282|\t\tproduced := map[string]string{}\n283|\t\tif violations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\"); len(violations) != 1 {\n284|\t\t\tt.Fatalf(\"violations = %v, want the single indirection report\", violations)\n285|\t\t}\n286|\t})\n287|\tt.Run(\"call inside the definition stays exempt\", func(t *testing.T) {\n288|\t\tfileSet, syntax := parse(\"package probe\\nvar failInvalid = func() { axerror.New(nil) }\\n\")\n289|\t\tproduced := map[string]string{}\n290|\t\tif violations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\"); len(violations) != 0 {\n291|\t\t\tt.Fatalf(\"violations = %v, want none for the definition spelling\", violations)\n292|\t\t}\n293|\t})\n294|\tt.Run(\"decode read stays exempt\", func(t *testing.T) {\n295|\t\tfileSet, syntax := parse(\"package probe\\nfunc f() { _, _ = axerror.Decode(nil) }\\n\")\n296|\t\tproduced := map[string]string{}\n297|\t\tif violations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\"); len(violations) != 0 {\n298|\t\t\tt.Fatalf(\"violations = %v, want none for a Decode read\", violations)\n299|\t\t}\n300|\t})\n301|}\n302|\n303|// TestConstructorSitesReportFunctionLocalRegisteredName proves\n304|// the function-local case of the constructor census against a\n305|// synthetic file: a New call inside a function-local literal\n306|// reports even when the variable carries a registered name,\n307|// while the package-level definition spelling stays exempt. The\n308|// vector is synthetic on purpose: it proves the gate, not\n309|// production.\n310|func TestConstructorSitesReportFunctionLocalRegisteredName(t *testing.T) {\n311|\tregistered := map[string]bool{\"failInvalid\": true}\n312|\tparse := func(source string) (*token.FileSet, *ast.File) {\n313|\t\tt.Helper()\n314|\t\tfileSet := token.NewFileSet()\n315|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n316|\t\tif err != nil {\n317|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n318|\t\t}\n319|\t\treturn fileSet, syntax\n320|\t}\n321|\tt.Run(\"function-local registered name reports\", func(t *testing.T) {\n322|\t\tfileSet, syntax := parse(\"package probe\\nfunc f() { var failInvalid = func() { axerror.New(nil) }\\n_ = failInvalid }\\n\")\n323|\t\tproduced := map[string]string{}\n324|\t\tviolations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\")\n325|\t\tif len(violations) != 1 {\n326|\t\t\tt.Fatalf(\"violations = %v, want one function-local report\", violations)\n327|\t\t}\n328|\t\tif _, ok := produced[\"failInvalid\"]; ok {\n329|\t\t\tt.Fatal(\"function-local literal recorded a constructor; only package-level scopes produce\")\n330|\t\t}\n331|\t})\n332|\tt.Run(\"package-level definition stays exempt\", func(t *testing.T) {\n333|\t\tfileSet, syntax := parse(\"package probe\\nvar failInvalid = func() { axerror.New(nil) }\\n\")\n334|\t\tproduced := map[string]string{}\n335|\t\tif violations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\"); len(violations) != 0 {\n336|\t\t\tt.Fatalf(\"violations = %v, want none for the definition spelling\", violations)\n337|\t\t}\n338|\t\tif produced[\"failInvalid\"] != \"probe.go\" {\n339|\t\t\tt.Fatalf(\"produced = %v, want the definition recorded\", produced)\n340|\t\t}\n341|\t})\n342|}\n343|\n344|// constructorVarScope is one var-held func literal an\n345|// axerror.New call can attribute to: the holding variable name\n346|// with its source range, and whether the declaration is\n347|// package-level. Only a package-level scope holding a\n348|// registered name is a constructor; anything else enclosing a\n349|// New call is an unregistered construction site.\n350|type constructorVarScope struct {\n351|\tname       string\n352|\tstart, end token.Pos\n353|\ttopLevel   bool\n354|}\n355|\n356|// constructorSitesInFile records every package-level func-valued\n357|// var whose body calls axerror.New into produced, and reports\n358|// every axerror.New call outside a registered constructor body:\n359|// outside any var-held literal, inside one whose variable is not\n360|// registered, or inside a function-local literal even when the\n361|// variable carries a registered name. Function-local var-held\n362|// literals are never constructors, so a New call inside one\n363|// always reports. A func-value indirection (`var newFault =\n364|// axerror.New`) is reported too: the reference names the\n365|// constructor without calling it, so every refusal built through\n366|// the alias would hide from both this census and the arm\n367|// derivation at once. axerror.Decode is a read, not a\n368|// construction, and is ignored.\n369|func constructorSitesInFile(fileSet *token.FileSet, syntax *ast.File, registered map[string]bool, produced map[string]string, filename string) []string {\n370|\tvar scopes []constructorVarScope\n371|\tvar calls []token.Pos\n372|\tvar indirections []token.Pos\n373|\tvar stack []ast.Node\n374|\tfuncDepth := 0\n375|\tast.Inspect(syntax, func(node ast.Node) bool {\n376|\t\tif node == nil {\n377|\t\t\tpopped := stack[len(stack)-1]\n378|\t\t\tswitch popped.(type) {\n379|\t\t\tcase *ast.FuncDecl, *ast.FuncLit:\n380|\t\t\t\tfuncDepth--\n381|\t\t\t}\n382|\t\t\tstack = stack[:len(stack)-1]\n383|\t\t\treturn true\n384|\t\t}\n385|\t\tif selector, ok := node.(*ast.SelectorExpr); ok && isAxerrorNew(selector) {\n386|\t\t\tif parent, ok := parentNode(stack).(*ast.CallExpr); !ok || parent.Fun != selector {\n387|\t\t\t\tindirections = append(indirections, node.Pos())\n388|\t\t\t}\n389|\t\t}\n390|\t\tswitch node := node.(type) {\n391|\t\tcase *ast.FuncDecl, *ast.FuncLit:\n392|\t\t\tfuncDepth++\n393|\t\tcase *ast.GenDecl:\n394|\t\t\tif node.Tok != token.VAR {\n395|\t\t\t\tbreak\n396|\t\t\t}\n397|\t\t\ttopLevel := funcDepth == 0\n398|\t\t\tfor _, specification := range node.Specs {\n399|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n400|\t\t\t\tif !ok {\n401|\t\t\t\t\tcontinue\n402|\t\t\t\t}\n403|\t\t\t\tfor index, ident := range value.Names {\n404|\t\t\t\t\tliteral := pairedFuncLit(value, index)\n405|\t\t\t\t\tif literal == nil {\n406|\t\t\t\t\t\tcontinue\n407|\t\t\t\t\t}\n408|\t\t\t\t\tscopes = append(scopes, constructorVarScope{name: ident.Name, start: literal.Pos(), end: literal.End(), topLevel: topLevel})\n409|\t\t\t\t}\n410|\t\t\t}\n411|\t\tcase *ast.CallExpr:\n412|\t\t\tselector, ok := node.Fun.(*ast.SelectorExpr)\n413|\t\t\tif !ok {\n414|\t\t\t\tbreak\n415|\t\t\t}\n416|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n417|\t\t\tif !ok || receiver.Name != \"axerror\" || selector.Sel.Name != \"New\" {\n418|\t\t\t\tbreak\n419|\t\t\t}\n420|\t\t\tcalls = append(calls, node.Pos())\n421|\t\t}\n422|\t\tstack = append(stack, node)\n423|\t\treturn true\n424|\t})\n425|\tvar violations []string\n426|\tfor _, position := range indirections {\n427|\t\tviolations = append(violations, fmt.Sprintf(\"func-value indirection of axerror.New at %s; refusals built through it hide from the constructor census\", fileSet.Position(position)))\n428|\t}\n429|\tfor _, position := range calls {\n430|\t\tbest := \"\"\n431|\t\tvar bestStart token.Pos\n432|\t\tinitialized := false\n433|\t\ttopLevel := false\n434|\t\tfor _, scope := range scopes {\n435|\t\t\tif scope.start <= position && position <= scope.end {\n436|\t\t\t\tif !initialized || scope.start >= bestStart {\n437|\t\t\t\t\tbest, bestStart, initialized, topLevel = scope.name, scope.start, true, scope.topLevel\n438|\t\t\t\t}\n439|\t\t\t}\n440|\t\t}\n441|\t\tswitch {\n442|\t\tcase !initialized:\n443|\t\t\tviolations = append(violations, fmt.Sprintf(\"axerror.New outside any constructor at %s\", fileSet.Position(position)))\n444|\t\tcase !registered[best]:\n445|\t\t\tviolations = append(violations, fmt.Sprintf(\"axerror.New inside unregistered %q at %s\", best, fileSet.Position(position)))\n446|\t\tcase !topLevel:\n447|\t\t\tviolations = append(violations, fmt.Sprintf(\"axerror.New inside function-local %q at %s; only package-level constructors are registered\", best, fileSet.Position(position)))\n448|\t\tdefault:\n449|\t\t\tproduced[best] = filename\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c791","stream":{"kind":"session","id":"01a07518-079c-74f3-9ecd-fd15c4068145"},"sequence":547,"recorded_at":1780531400001089,"record_type":"event","durability":"durable","causation_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"368dc5f6-65c1-4883-954e-0941c86fd7c5","run_stream":{"kind":"run","id":"368dc5f6-65c1-4883-954e-0941c86fd7c5"},"call_id":"call_01a0751aa1e17c939818473fd746119c","text":"Read text file `internal/sessadapter/import_census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"go/parser\"\n5|\t\"go/token\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the import census the constructor census stands on\n15|// (review rev3 B6). TestRefusalConstructorsMatchProduction matches\n16|// error constructions by the package identifier `axerror`, so a\n17|// production file importing the error package under any other name\n18|// hides every refusal it builds from both the constructor census\n19|// and the arm derivation at once. This test requires every\n20|// production import of the error package path to bind the name\n21|// `axerror` — the default spelling or an explicit identical alias —\n22|// and fails on any other binding. An empty scan, or a tree with no\n23|// production importer at all, fails closed: a census that sees\n24|// nothing measures nothing.\n25|\n26|// axerrorImportPath is the only import path the constructor census\n27|// resolves. It is spelled here rather than derived because the\n28|// census must pin production, not follow it: a moved package with\n29|// no row here fails the zero-importer guard below.\n30|const axerrorImportPath = \"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\n32|// TestAxerrorImportsAreUnaliased pins the import spelling every\n33|// identifier-matched census in this package relies on.\n34|func TestAxerrorImportsAreUnaliased(t *testing.T) {\n35|\tdirectory, err := os.Getwd()\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"import census: %v\", err)\n38|\t}\n39|\tentries, err := os.ReadDir(directory)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"import census: %v\", err)\n42|\t}\n43|\tscanned := 0\n44|\timporting := 0\n45|\tvar violations []string\n46|\tfor _, entry := range entries {\n47|\t\tname := entry.Name()\n48|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n49|\t\t\tcontinue\n50|\t\t}\n51|\t\tscanned++\n52|\t\tpath := filepath.Join(directory, name)\n53|\t\tsource, err := os.ReadFile(path)\n54|\t\tif err != nil {\n55|\t\t\tt.Fatalf(\"import census: %v\", err)\n56|\t\t}\n57|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n58|\t\tif err != nil {\n59|\t\t\tt.Fatalf(\"import census: %v\", err)\n60|\t\t}\n61|\t\tfor _, declaration := range syntax.Imports {\n62|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n63|\t\t\tif err != nil || target != axerrorImportPath {\n64|\t\t\t\tcontinue\n65|\t\t\t}\n66|\t\t\timporting++\n67|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n68|\t\t\t\tviolations = append(violations, name+\": imports the error package as \"+declaration.Name.Name)\n69|\t\t\t}\n70|\t\t}\n71|\t}\n72|\tif scanned == 0 {\n73|\t\tt.Fatal(\"import census scanned zero production files; the scanner is broken, not the package\")\n74|\t}\n75|\tif importing == 0 {\n76|\t\tt.Fatal(\"import census found zero production importers of the error package; the census is vacuous, not green\")\n77|\t}\n78|\tsort.Strings(violations)\n79|\tif len(violations) > 0 {\n80|\t\tt.Fatalf(\"aliased error-package import(s) hide constructions from the constructor census:\\n  %s\", strings.Join(violations, \"\\n  \"))\n81|\t}\n82|\tt.Logf(\"import census: %d production importer(s) bind axerror across %d files\", importing, scanned)\n83|}\n84|\n85|// TestAxerrorImportCensusSeesAliases proves the census shape\n86|// against synthetic imports: the default binding and an explicit\n87|// identical alias pass, while a renamed, blank, or dot import\n88|// fails. The vectors are synthetic on purpose: they prove the\n89|// gate, not production.\n90|func TestAxerrorImportCensusSeesAliases(t *testing.T) {\n91|\taliased := func(source string) bool {\n92|\t\tt.Helper()\n93|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), parser.ImportsOnly)\n94|\t\tif err != nil {\n95|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n96|\t\t}\n97|\t\tfor _, declaration := range syntax.Imports {\n98|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n99|\t\t\tif err != nil || target != axerrorImportPath {\n100|\t\t\t\tcontinue\n101|\t\t\t}\n102|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n103|\t\t\t\treturn true\n104|\t\t\t}\n105|\t\t}\n106|\t\treturn false\n107|\t}\n108|\tpath := strconv.Quote(axerrorImportPath)\n109|\tfor _, probe := range []struct {\n110|\t\tname   string\n111|\t\tsource string\n112|\t\twant   bool\n113|\t}{\n114|\t\t{\"default binding passes\", \"package probe\\nimport \" + path + \"\\n\", false},\n115|\t\t{\"explicit identical alias passes\", \"package probe\\nimport axerror \" + path + \"\\n\", false},\n116|\t\t{\"renamed import fails\", \"package probe\\nimport axe \" + path + \"\\n\", true},\n117|\t\t{\"blank import fails\", \"package probe\\nimport _ \" + path + \"\\n\", true},\n118|\t\t{\"dot import fails\", \"package probe\\nimport . \" + path + \"\\n\", true},\n119|\t} {\n120|\t\tt.Run(probe.name, func(t *testing.T) {\n121|\t\t\tif got := aliased(probe.source); got != probe.want {\n122|\t\t\t\tt.Fatalf(\"aliased(%q) = %v, want %v\", probe.source, got, probe.want)\n123|\t\t\t}\n124|\t\t})\n125|\t}\n126|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
