mission|entry.Status != \"accepted\"`,\n255|\t`discovery.go|CheckBindingEquality|sealed.Role != fresh.Role`,\n256|}\n257|\n258|// TestIdentityGatesAreCensused is the identity census: the\n259|// derived production gate multiset must equal the registration\n260|// multiset. Every non-exempt row must name a driver and every\n261|// exempt row a rationale.\n262|func TestIdentityGatesAreCensused(t *testing.T) {\n263|\tdirectory, err := os.Getwd()\n264|\tif err != nil {\n265|\t\tt.Fatalf(\"identity census: %v\", err)\n266|\t}\n267|\tderived := scanIdentityGateIDs(t, directory)\n268|\tif len(derived) == 0 {\n269|\t\tt.Fatal(\"identity census derived zero gates; the scanner is broken, not the package\")\n270|\t}\n271|\tderivedCounts := map[string]int{}\n272|\tfor _, id := range derived {\n273|\t\tderivedCounts[id]++\n274|\t}\n275|\tfor _, canary := range identityCensusCanaries {\n276|\t\tfound := false\n277|\t\tfor id := range derivedCounts {\n278|\t\t\tif strings.HasPrefix(id, canary) {\n279|\t\t\t\tfound = true\n280|\t\t\t\tbreak\n281|\t\t\t}\n282|\t\t}\n283|\t\tif !found {\n284|\t\t\tt.Errorf(\"identity census blind to canary %q; the scanner misses the class it must roster\", canary)\n285|\t\t}\n286|\t}\n287|\tregisteredCounts := map[string]int{}\n288|\tseen := map[string]bool{}\n289|\tfor _, row := range identityRegistrations {\n290|\t\tif seen[row.id] {\n291|\t\t\tt.Errorf(\"identity census registers %q twice\", row.id)\n292|\t\t}\n293|\t\tseen[row.id] = true\n294|\t\tregisteredCounts[row.id]++\n295|\t\tif row.driver == \"\" && !row.exempt {\n296|\t\t\tt.Errorf(\"identity census row %q names no driver and no exemption\", row.id)\n297|\t\t}\n298|\t\tif row.exempt && row.reason == \"\" {\n299|\t\t\tt.Errorf(\"identity census exemption %q states no rationale\", row.id)\n300|\t\t}\n301|\t}\n302|\tvar unregistered []string\n303|\tfor id, count := range derivedCounts {\n304|\t\tfor i := registeredCounts[id]; i < count; i++ {\n305|\t\t\tunregistered = append(unregistered, id)\n306|\t\t}\n307|\t}\n308|\tvar orphaned []string\n309|\tfor id, count := range registeredCounts {\n310|\t\tfor i := derivedCounts[id]; i < count; i++ {\n311|\t\t\torphaned = append(orphaned, id)\n312|\t\t}\n313|\t}\n314|\tsort.Strings(unregistered)\n315|\tsort.Strings(orphaned)\n316|\tif len(unregistered) > 0 {\n317|\t\tt.Fatalf(\"production identity gate(s) with no census row:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n318|\t}\n319|\tif len(orphaned) > 0 {\n320|\t\tt.Fatalf(\"census row(s) naming no production gate:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n321|\t}\n322|\tdriven, exempt := 0, 0\n323|\tfor _, row := range identityRegistrations {\n324|\t\tif row.exempt {\n325|\t\t\texempt++\n326|\t\t} else {\n327|\t\t\tdriven++\n328|\t\t}\n329|\t}\n330|\tt.Logf(\"identity census: %d gates rostered (%d driven, %d exempt) across production\", len(derived), driven, exempt)\n331|}\n332|\n333|// identityCensusDomainCount returns the number of non-exempt\n334|// rows in the given domain. Sibling tables with fixed tripwires\n335|// assert against it so they cannot go stale.\n336|func identityCensusDomainCount(domain string) int {\n337|\tcount := 0\n338|\tfor _, row := range identityRegistrations {\n339|\t\tif !row.exempt && row.domain == domain {\n340|\t\t\tcount++\n341|\t\t}\n342|\t}\n343|\treturn count\n344|}\n345|\n346|// probeFactsFor builds the CheckProbe facts for the fixture\n347|// manifest: the expected provider, builtin kind, host-computed\n348|// digest, and verified manifest.\n349|func probeFactsFor(manifest Manifest) ProbeHostFacts {\n350|\treturn ProbeHostFacts{\n351|\t\tExpectedProviderID: fixtureProviderID,\n352|\t\tExpectedKind:       CandidateBuiltin,\n353|\t\tManifestDigest:     ManifestDigest(manifest).String(),\n354|\t\tManifest:           manifest,\n355|\t}\n356|}\n357|\n358|// TestIdentityZeroRows drives every surviving zero-value gate at\n359|// its exported entry: the zero fact refuses through its own arm,\n360|// so a mutant exempting the zero (`!= want && fact != \"\"`)\n361|// admits and reddens here. requireRefusal pins the arm\n362|// identity, so a slide to a neighbouring arm reddens too.\n363|func TestIdentityZeroRows(t *testing.T) {\n364|\tt.Run(\"probe schema empty\", func(t *testing.T) {\n365|\t\tprobe, manifest := fixtureValidProbe(t)\n366|\t\t_ = probe\n367|\t\tdigest := ManifestDigest(manifest).String()\n368|\t\tbase := []byte(fixtureProbeJSON(digest))\n369|\t\tif _, err := DecodeProbe(mutateMember(t, base, \"schema\", `\"\"`)); err == nil {\n370|\t\t\tt.Fatal(\"DecodeProbe admitted an empty schema\")\n371|\t\t} else {\n372|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"schema\", \"not the session adapter probe\")\n373|\t\t}\n374|\t\tif _, err := DecodeProbe(mutateMember(t, base, \"schema_version\", `\"\"`)); err == nil {\n375|\t\t\tt.Fatal(\"DecodeProbe admitted an empty schema_version\")\n376|\t\t} else {\n377|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"schema_version\", \"is not 1.0.0\")\n378|\t\t}\n379|\t})\n380|\tt.Run(\"probe provider zeros\", func(t *testing.T) {\n381|\t\tprobe, manifest := fixtureValidProbe(t)\n382|\t\tfacts := probeFactsFor(manifest)\n383|\t\tproviderless := probe\n384|\t\tproviderless.ProviderID = \"\"\n385|\t\tif err := CheckProbe(providerless, facts); err == nil {\n386|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe provider\")\n387|\t\t} else {\n388|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"requested provider\")\n389|\t\t}\n390|\t\t// Facts-side zero of the expected provider is pinned by\n391|\t\t// TestZeroValueHostFactsRefuse; here the manifest side\n392|\t\t// goes zero with probe and expectation held equal.\n393|\t\tmanifestZero := facts\n394|\t\tmanifestZero.ExpectedProviderID = \"other-provider\"\n395|\t\tzeroed := manifest\n396|\t\tzeroed.ProviderID = \"\"\n397|\t\tmanifestZero.Manifest = zeroed\n398|\t\tother := probe\n399|\t\tother.ProviderID = \"other-provider\"\n400|\t\tif err := CheckProbe(other, manifestZero); err == nil {\n401|\t\t\tt.Fatal(\"CheckProbe admitted an empty manifest provider\")\n402|\t\t} else {\n403|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"verified manifest\")\n404|\t\t}\n405|\t})\n406|\tt.Run(\"probe digest zeros\", func(t *testing.T) {\n407|\t\tprobe, manifest := fixtureValidProbe(t)\n408|\t\tfacts := probeFactsFor(manifest)\n409|\t\tdigestless := probe\n410|\t\tdigestless.ManifestDigest = \"\"\n411|\t\tif err := CheckProbe(digestless, facts); err == nil {\n412|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe digest\")\n413|\t\t} else {\n414|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_manifest_digest\", \"host-computed digest\")\n415|\t\t}\n416|\t\tfactsless := facts\n417|\t\tfactsless.ManifestDigest = \"\"\n418|\t\tif err := CheckProbe(probe, factsless); err == nil {\n419|\t\t\tt.Fatal(\"CheckProbe admitted an empty expected digest\")\n420|\t\t} else {\n421|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_manifest_digest\", \"host-computed digest\")\n422|\t\t}\n423|\t})\n424|\tt.Run(\"probe version zeros\", func(t *testing.T) {\n425|\t\tprobe, manifest := fixtureValidProbe(t)\n426|\t\tfacts := probeFactsFor(manifest)\n427|\t\tversionless := probe\n428|\t\tversionless.AdapterVersion = \"\"\n429|\t\tif err := CheckProbe(versionless, facts); err == nil {\n430|\t\t\tt.Fatal(\"CheckProbe admitted an empty probe version\")\n431|\t\t} else {\n432|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_version\", \"verified manifest\")\n433|\t\t}\n434|\t\tmanifestless := facts\n435|\t\tzeroed := manifest\n436|\t\tzeroed.AdapterVersion = \"\"\n437|\t\tmanifestless.Manifest = zeroed\n438|\t\tif err := CheckProbe(probe, manifestless); err == nil {\n439|\t\t\tt.Fatal(\"CheckProbe admitted an empty manifest version\")\n440|\t\t} else {\n441|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"adapter_version\", \"verified manifest\")\n442|\t\t}\n443|\t\tdriftless := probe\n444|\t\tdriftless.Environment.AdapterVersion = \"\"\n445|\t\tif err := CheckProbe(driftless, facts); err == nil {\n446|\t\t\tt.Fatal(\"CheckProbe admitted an empty tuple adapter version\")\n447|\t\t} else {\n448|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"environment\", \"probe adapter version\")\n449|\t\t}\n450|\t})\n451|\tt.Run(\"probe tuple environment zero\", func(t *testing.T) {\n452|\t\tprobe, manifest := fixtureValidProbe(t)\n453|\t\tfacts := probeFactsFor(manifest)\n454|\t\ttupleless := probe\n455|\t\ttupleless.Environment.EnvironmentID = \"\"\n456|\t\tif err := CheckProbe(tupleless, facts); err == nil {\n457|\t\t\tt.Fatal(\"CheckProbe admitted an empty tuple environment\")\n458|\t\t} else {\n459|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", \"\", \"outside the manifest environment\")\n460|\t\t}\n461|\t})\n462|\tt.Run(\"probe request zeros\", func(t *testing.T) {\n463|\t\tcandidate := fixtureCandidate()\n464|\t\tif err := CheckProbeRequest(\"\", CandidateBuiltin, candidate); err == nil {\n465|\t\t\tt.Fatal(\"CheckProbeRequest admitted an empty expected provider\")\n466|\t\t} else {\n467|\t\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n468|\t\t}\n469|\t\tproviderless := candidate\n470|\t\tproviderless.ProviderID = \"\"\n471|\t\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, providerless); err == nil {\n472|\t\t\tt.Fatal(\"CheckProbeRequest admitted an empty candidate provider\")\n473|\t\t} else {\n474|\t\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n475|\t\t}\n476|\t})\n477|\tt.Run(\"doctor direction zero\", func(t *testing.T) {\n478|\t\tmanifestDigest := fixtureManifestDigestText(t)\n479|\t\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n480|\t\tdecoded, err := CheckRequestBody(OpDoctor, request)\n481|\t\tif err != nil {\n482|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n483|\t\t}\n484|\t\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n485|\t\tif _, err := DecodeDoctorResult(good, decoded, \"\"); err == nil {\n486|\t\t\tt.Fatal(\"DecodeDoctorResult admitted an empty request direction\")\n487|\t\t} else {\n488|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"direction\", \"does not answer the request direction\")\n489|\t\t}\n490|\t})\n491|\tt.Run(\"doctor entry status zero\", func(t *testing.T) {\n492|\t\tmanifestDigest := fixtureManifestDigestText(t)\n493|\t\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n494|\t\tdecoded, err := CheckRequestBody(OpDoctor, request)\n495|\t\tif err != nil {\n496|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n497|\t\t}\n498|\t\tprobe, _ := fixtureValidProbe(t)\n499|\t\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c601","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":347,"recorded_at":1780531400000689,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e4e9047c118c5920df32ad3d3f","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n(199 line(s) above)\n200|\t}\n201|\tif index, ok := first.(*ast.IndexExpr); ok {\n202|\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n203|\t\t\treturn literal.Value\n204|\t\t}\n205|\t}\n206|\treturn renderBoundExpr(first)\n207|}\n208|\n209|// renderBoundExpr renders one bound expression deterministically.\n210|func renderBoundExpr(node ast.Node) string {\n211|\tvar buffer bytes.Buffer\n212|\tif err := printer.Fprint(&buffer, token.NewFileSet(), node); err != nil {\n213|\t\treturn \"RENDER-ERR\"\n214|\t}\n215|\treturn buffer.String()\n216|}\n217|\n218|// normalizeBoundNumbers replaces standalone integer literals in\n219|// a rendered len guard with N, so the census rosters the guard\n220|// shape rather than its bound values: a moved bound keeps its\n221|// identity and must redden its behavioral driver. Identifiers\n222|// holding digits (uint64, MaxFrameBytes) are untouched.\n223|func normalizeBoundNumbers(rendered string) string {\n224|\tvar out strings.Builder\n225|\tfor i := 0; i < len(rendered); {\n226|\t\tc := rendered[i]\n227|\t\tif c >= '0' && c <= '9' && (i == 0 || !isBoundIdentChar(rendered[i-1])) {\n228|\t\t\tj := i\n229|\t\t\tfor j < len(rendered) && rendered[j] >= '0' && rendered[j] <= '9' {\n230|\t\t\t\tj++\n231|\t\t\t}\n232|\t\t\tif j >= len(rendered) || !isBoundIdentChar(rendered[j]) {\n233|\t\t\t\tout.WriteString(\"N\")\n234|\t\t\t\ti = j\n235|\t\t\t\tcontinue\n236|\t\t\t}\n237|\t\t}\n238|\t\tout.WriteByte(c)\n239|\t\ti++\n240|\t}\n241|\treturn out.String()\n242|}\n243|\n244|// isBoundIdentChar reports whether the byte continues a Go\n245|// identifier.\n246|func isBoundIdentChar(c byte) bool {\n247|\treturn c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'\n248|}\n249|\n250|// hasLenCall reports whether the subtree calls len.\n251|func hasLenCall(node ast.Node) bool {\n252|\tfound := false\n253|\tast.Inspect(node, func(inner ast.Node) bool {\n254|\t\tcall, ok := inner.(*ast.CallExpr)\n255|\t\tif ok {\n256|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == \"len\" {\n257|\t\t\t\tfound = true\n258|\t\t\t\treturn false\n259|\t\t\t}\n260|\t\t}\n261|\t\treturn true\n262|\t})\n263|\treturn found\n264|}\n265|\n266|// boundRegistrations rosters every derived site. driver names the\n267|// committed test proving the edges at the production entry;\n268|// exempt rows carry the rationale instead. Ordinals disambiguate\n269|// repeated members in one function: checkRequestScalars carries\n270|// four expected_target_native_session_id bounds (ordinal 0\n271|// projection-plan, 1 read-back, 2 validate-nullable, 3\n272|// resume-plan) and checkSuccessScalars three\n273|// source_store_generation bounds (ordinal 0 inspect, 1\n274|// capture-plan, 2 capture).\n275|var boundRegistrations = []boundRegistration{\n276|\t// context.go: direct checks with existing drivers.\n277|\t{id: `context.go|DecodeCapturePlanItem|checkStringBounds|\"native_item_key\"|0`, driver: \"TestStringBoundEdges\", reason: \"capture item key 1..512\"},\n278|\t{id: `context.go|DecodeFinding|checkStringBounds|\"code\"|0`, driver: \"TestStringBoundEdges\", reason: \"finding code 1..128\"},\n279|\t{id: `context.go|DecodeFinding|checkStringBounds|\"message\"|0`, driver: \"TestStringBoundE