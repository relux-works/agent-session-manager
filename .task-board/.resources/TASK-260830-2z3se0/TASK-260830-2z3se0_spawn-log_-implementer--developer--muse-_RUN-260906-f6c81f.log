 with open(os.path.join(BACKUP, os.path.basename(p)), \"wb\") as f:\n+            f.write(data)\n+    return snap\n+\n+\n+def restore(snap):\n+    for p in snap:\n+        with open(os.path.join(BACKUP, os.path.basename(p)), \"rb\") as f:\n+            data = f.read()\n+        with open(p, \"wb\") as f:\n+            f.write(data)\n+\n+\n+def check_snapshot(snap):\n+    ok = True\n+    for p, h in snap.items():\n+        if not os.path.exists(p):\n+            print(f\"  RESTORE-FAIL: {os.path.basename(p)} missing\")\n+            ok = False\n+        elif sha256(p) != h:\n+            print(f\"  RESTORE-FAIL: {os.path.basename(p)} hash mismatch\")\n+            ok = False\n+    current = set(prod_files())\n+    if set(snap) != current:\n+        print(f\"  RESTORE-FAIL: file set changed {set(snap) ^ current}\")\n+        ok = False\n+    return ok\n"}}}
