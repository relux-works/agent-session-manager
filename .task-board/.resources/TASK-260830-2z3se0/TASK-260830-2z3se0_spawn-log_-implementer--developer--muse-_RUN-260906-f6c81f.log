{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c78d","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":545,"recorded_at":1780531400001085,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"17024369-3b70-4261-9513-48f3930804bd"},"task_id":"17024369-3b70-4261-9513-48f3930804bd","event":{"kind":"output","task_id":"17024369-3b70-4261-9513-48f3930804bd","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/identity_census_test.go`.\n(599 line(s) above)\n600|\t\tprovider := map[string]ProviderCapability{\n601|\t\t\t\"portable_store\": {Status: \"\", Enabled: true},\n602|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n603|\t\t}\n604|\t\tif err := CheckTargetWriteGates(probeCapabilities(probe), provider); err == nil {\n605|\t\t\tt.Fatal(\"CheckTargetWriteGates admitted an empty provider status\")\n606|\t\t} else {\n607|\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:portable_store\", \"usable provider capability\")\n608|\t\t}\n609|\t})\n610|}\n611|\n612|// probeCapabilities projects the probe map for gate tests.\n613|func probeCapabilities(probe Probe) map[string]Capability {\n614|\treturn cloneCapabilities(probe.Capabilities)\n615|}\n616|\n617|// TestBindingEqualityZeroFactsRefuse drives every sealed-binding\n618|// fact to zero on each side: a forgotten seal fact refuses,\n619|// never agrees. Non-zero flips were already pinned by\n620|// TestBindingEqualityFlipsEveryFact; a mutant exempting the zero\n621|// admits here and reddens.\n622|func TestBindingEqualityZeroFactsRefuse(t *testing.T) {\n623|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n624|\tif err != nil {\n625|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n626|\t}\n627|\tsealed, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n628|\tif err != nil {\n629|\t\tt.Fatalf(\"Discover: %v\", err)\n630|\t}\n631|\tzeroes := []struct {\n632|\t\tname string\n633|\t\tzero func(*ExecutionBinding)\n634|\t}{\n635|\t\t{\"role\", func(binding *ExecutionBinding) { binding.Role = \"\" }},\n636|\t\t{\"provider\", func(binding *ExecutionBinding) { binding.ProviderID = \"\" }},\n637|\t\t{\"kind\", func(binding *ExecutionBinding) { binding.CandidateKind = \"\" }},\n638|\t\t{\"path\", func(binding *ExecutionBinding) { binding.ExecutablePath = \"\" }},\n639|\t\t{\"owner\", func(binding *ExecutionBinding) { binding.OwnerIdentity = \"\" }},\n640|\t\t{\"executable\", func(binding *ExecutionBinding) { binding.ExecutableSHA256 = \"\" }},\n641|\t\t{\"provider digest\", func(binding *ExecutionBinding) { binding.ProviderManifestDigest = \"\" }},\n642|\t\t{\"adapter digest\", func(binding *ExecutionBinding) { binding.AdapterManifestDigest = \"\" }},\n643|\t}\n644|\tif len(zeroes) != 8 {\n645|\t\tt.Fatalf(\"zeroes = %d, want one per identity fact\", len(zeroes))\n646|\t}\n647|\tfor _, fact := range zeroes {\n648|\t\tfact := fact\n649|\t\tt.Run(\"fresh \"+fact.name, func(t *testing.T) {\n650|\t\t\tfresh := sealed\n651|\t\t\tfact.zero(&fresh)\n652|\t\t\tif err := CheckBindingEquality(sealed, fresh); err == nil {\n653|\t\t\t\tt.Fatalf(\"CheckBindingEquality admitted a zero fresh %s\", fact.name)\n654|\t\t\t} else {\n655|\t\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n656|\t\t\t}\n657|\t\t})\n658|\t\tt.Run(\"sealed \"+fact.name, func(t *testing.T) {\n659|\t\t\tresealed := sealed\n660|\t\t\tfact.zero(&resealed)\n661|\t\t\tif err := CheckBindingEquality(resealed, sealed); err == nil {\n662|\t\t\t\tt.Fatalf(\"CheckBindingEquality admitted a zero sealed %s\", fact.name)\n663|\t\t\t} else {\n664|\t\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n665|\t\t\t}\n666|\t\t})\n667|\t}\n668|}\n669|\n670|// TestTupleAdmissionZeroFactsRefuse drives every admission key\n671|// fact, the direction, the environment, and the status to zero:\n672|// an empty fact refuses, never admits. Binding-side zeroes are\n673|// driven too, since the key disjunction compares both sides.\n674|func TestTupleAdmissionZeroFactsRefuse(t *testing.T) {\n675|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n676|\tif err != nil {\n677|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n678|\t}\n679|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n680|\tif err != nil {\n681|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n682|\t}\n683|\tbinding := fixtureBindingFacts()\n684|\tnow := mustTime(t, fixtureCallTime)\n685|\tif err := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, binding, now); err != nil {\n686|\t\tt.Fatalf(\"CheckTupleAdmission baseline: %v\", err)\n687|\t}\n688|\tt.Run(\"empty direction\", func(t *testing.T) {\n689|\t\tdirectionless := entry\n690|\t\tdirectionless.Key.Direction = \"\"\n691|\t\tif err := CheckTupleAdmission(directionless, DirectionTargetWrite, tuple, binding, now); err == nil {\n692|\t\t\tt.Fatal(\"admitted an empty entry direction\")\n693|\t\t} else {\n694|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"direction does not match\")\n695|\t\t}\n696|\t})\n697|\tt.Run(\"zero environment\", func(t *testing.T) {\n698|\t\tenvironmentless := entry\n699|\t\tenvironmentless.Key.Environment = Tuple{}\n700|\t\tif err := CheckTupleAdmission(environmentless, DirectionTargetWrite, tuple, binding, now); err == nil {\n701|\t\t\tt.Fatal(\"admitted a zero entry environment\")\n702|\t\t} else {\n703|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"probed tuple\")\n704|\t\t}\n705|\t})\n706|\tkeyZeroes := []struct {\n707|\t\tname string\n708|\t\tzero func(*TupleEntry)\n709|\t}{\n710|\t\t{\"provider\", func(entry *TupleEntry) { entry.Key.ProviderID = \"\" }},\n711|\t\t{\"kind\", func(entry *TupleEntry) { entry.Key.CandidateKind = \"\" }},\n712|\t\t{\"executable\", func(entry *TupleEntry) { entry.Key.ExecutableSHA256 = \"\" }},\n713|\t\t{\"provider digest\", func(entry *TupleEntry) { entry.Key.ProviderManifestDigest = \"\" }},\n714|\t\t{\"adapter digest\", func(entry *TupleEntry) { entry.Key.AdapterManifestDigest = \"\" }},\n715|\t}\n716|\tfor _, fact := range keyZeroes {\n717|\t\tfact := fact\n718|\t\tt.Run(\"entry \"+fact.name, func(t *testing.T) {\n719|\t\t\tzeroed := entry\n720|\t\t\tfact.zero(&zeroed)\n721|\t\t\tif err := CheckTupleAdmission(zeroed, DirectionTargetWrite, tuple, binding, now); err == nil {\n722|\t\t\t\tt.Fatalf(\"admitted a zero entry %s\", fact.name)\n723|\t\t\t} else {\n724|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"execution binding\")\n725|\t\t\t}\n726|\t\t})\n727|\t}\n728|\tbindingZeroes := []struct {\n729|\t\tname string\n730|\t\tzero func(*BindingFacts)\n731|\t}{\n732|\t\t{\"provider\", func(binding *BindingFacts) { binding.ProviderID = \"\" }},\n733|\t\t{\"kind\", func(binding *BindingFacts) { binding.CandidateKind = \"\" }},\n734|\t\t{\"executable\", func(binding *BindingFacts) { binding.ExecutableSHA256 = \"\" }},\n735|\t\t{\"provider digest\", func(binding *BindingFacts) { binding.ProviderManifestDigest = \"\" }},\n736|\t\t{\"adapter digest\", func(binding *BindingFacts) { binding.AdapterManifestDigest = \"\" }},\n737|\t}\n738|\tfor _, fact := range bindingZeroes {\n739|\t\tfact := fact\n740|\t\tt.Run(\"binding \"+fact.name, func(t *testing.T) {\n741|\t\t\tzeroed := binding\n742|\t\t\tfact.zero(&zeroed)\n743|\t\t\tif err := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, zeroed, now); err == nil {\n744|\t\t\t\tt.Fatalf(\"admitted a zero binding %s\", fact.name)\n745|\t\t\t} else {\n746|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"execution binding\")\n747|\t\t\t}\n748|\t\t})\n749|\t}\n750|\tt.Run(\"empty status\", func(t *testing.T) {\n751|\t\tstatusless := entry\n752|\t\tstatusless.Status = \"\"\n753|\t\tif err := CheckTupleAdmission(statusless, DirectionTargetWrite, tuple, binding, now); err == nil {\n754|\t\t\tt.Fatal(\"admitted an empty entry status\")\n755|\t\t} else {\n756|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"not accepted\")\n757|\t\t}\n758|\t})\n759|\tt.Run(\"empty strategy word\", func(t *testing.T) {\n760|\t\tsource, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionSourceRead)))\n761|\t\tif err != nil {\n762|\t\t\tt.Fatalf(\"DecodeTupleEntry source: %v\", err)\n763|\t\t}\n764|\t\twordless := source\n765|\t\twordless.Strategies = []string{\"\"}\n766|\t\tif err := CheckTupleAdmission(wordless, DirectionSourceRead, tuple, binding, now); err == nil {\n767|\t\t\tt.Fatal(\"admitted a source entry with an empty strategy word\")\n768|\t\t} else {\n769|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"exactly strategies=[archive_only]\")\n770|\t\t}\n771|\t})\n772|}\n773|\n774|// presenceRegistration is one map-presence default with its\n775|// fail-closed proof: the behavioral driver plus the structural\n776|// shape the census asserts in production source.\n777|type presenceRegistration struct {\n778|\tfunction string\n779|\tfile     string\n780|\toutcome  string\n781|\tdriver   string\n782|}\n783|\n784|// presenceRegistrations rosters every map-presence default in\n785|// production: an absent name must refuse or read unusable, never\n786|// default to admitted. missingMember is the generic mechanism\n787|// behind every closed-body check.\n788|var presenceRegistrations = []presenceRegistration{\n789|\t{function: \"decodeCapabilities\", file: \"probe.go\", outcome: \"refuse\", driver: \"TestDecodeProbeClosedRules\"},\n790|\t{function: \"CapabilityUsable\", file: \"probe.go\", outcome: \"false\", driver: \"TestCapabilityUsableAbsentIsNotUsable\"},\n791|\t{function: \"capabilityMapUsable\", file: \"probe.go\", outcome: \"false\", driver: \"TestCapabilityUsableAbsentIsNotUsable\"},\n792|\t{function: \"CheckTargetWriteGates\", file: \"probe.go\", outcome: \"refuse\", driver: \"TestCheckTargetWriteGates\"},\n793|\t{function: \"missingMember\", file: \"decode.go\", outcome: \"report\", driver: \"TestClosedMemberSetsAreDerivedFromSpec\"},\n794|}\n795|\n796|// TestPresenceDefaultsAreFailClosed asserts the structural shape\n797|// of every rostered presence default: the function body guards\n798|// on !present and the guarded arm refuses (a fail* construction)\n799|// or reads unusable (a false return). A default rewritten to\n800|// admit an absent name fails here before any behavior runs.\n801|func TestPresenceDefaultsAreFailClosed(t *testing.T) {\n802|\tdirectory, err := os.Getwd()\n803|\tif err != nil {\n804|\t\tt.Fatalf(\"presence census: %v\", err)\n805|\t}\n806|\tfor _, row := range presenceRegistrations {\n807|\t\trow := row\n808|\t\tt.Run(row.function, func(t *testing.T) {\n809|\t\t\tpath := filepath.Join(directory, row.file)\n810|\t\t\tsource, err := os.ReadFile(path)\n811|\t\t\tif err != nil {\n812|\t\t\t\tt.Fatalf(\"presence census: %v\", err)\n813|\t\t\t}\n814|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n815|\t\t\tif err != nil {\n816|\t\t\t\tt.Fatalf(\"presence census: %v\", err)\n817|\t\t\t}\n818|\t\t\tfound := false\n819|\t\t\tfor _, declaration := range syntax.Decls {\n820|\t\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n821|\t\t\t\tif !ok || function.Name.Name != row.function || function.Body == nil {\n822|\t\t\t\t\tcontinue\n823|\t\t\t\t}\n824|\t\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n825|\t\t\t\t\tstatement, ok := node.(*ast.IfStmt)\n826|\t\t\t\t\tif !ok {\n827|\t\t\t\t\t\treturn true\n828|\t\t\t\t\t}\n829|\t\t\t\t\tif !hasPresentNegation(statement.Cond) {\n830|\t\t\t\t\t\treturn true\n831|\t\t\t\t\t}\n832|\t\t\t\t\tswitch row.outcome {\n833|\t\t\t\t\tcase \"false\":\n834|\t\t\t\t\t\tast.Inspect(statement.Body, func(inner ast.Node) bool {\n835|\t\t\t\t\t\t\tret, ok := inner.(*ast.ReturnStmt)\n836|\t\t\t\t\t\t\tif ok && len(ret.Results) == 1 {\n837|\t\t\t\t\t\t\t\tif ident, ok := ret.Results[0].(*ast.Ident); ok && ident.Name == \"false\" {\n838|\t\t\t\t\t\t\t\t\tfound = true\n839|\t\t\t\t\t\t\t\t\treturn false\n840|\t\t\t\t\t\t\t\t}\n841|\t\t\t\t\t\t\t}\n842|\t\t\t\t\t\t\treturn true\n843|\t\t\t\t\t\t})\n844|\t\t\t\t\tcase \"refuse\", \"report\":\n845|\t\t\t\t\t\tast.Inspect(statement.Body, func(inner ast.Node) bool {\n846|\t\t\t\t\t\t\tif call, ok := inner.(*ast.CallExpr); ok {\n847|\t\t\t\t\t\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok && strings.HasPrefix(ident.Name, \"fail\") {\n848|\t\t\t\t\t\t\t\t\tfound = true\n849|\t\t\t\t\t\t\t\t\treturn false\n850|\t\t\t\t\t\t\t\t}\n851|\t\t\t\t\t\t\t\treturn true\n852|\t\t\t\t\t\t\t}\n853|\t\t\t\t\t\t\tif ret, ok := inner.(*ast.ReturnStmt); ok {\n854|\t\t\t\t\t\t\t\tfor _, result := range ret.Results {\n855|\t\t\t\t\t\t\t\t\tif ident, ok := result.(*ast.Ident); ok && ident.Name == \"true\" && row.outcome == \"report\" {\n856|\t\t\t\t\t\t\t\t\t\tfound = true\n857|\t\t\t\t\t\t\t\t\t\treturn false\n858|\t\t\t\t\t\t\t\t\t}\n859|\t\t\t\t\t\t\t\t}\n860|\t\t\t\t\t\t\t}\n861|\t\t\t\t\t\t\treturn true\n862|\t\t\t\t\t\t})\n863|\t\t\t\t\t}\n864|\t\t\t\t\treturn true\n865|\t\t\t\t})\n866|\t\t\t}\n867|\t\t\tif !found {\n868|\t\t\t\tt.Fatalf(\"%s in %s no longer guards !present with a fail-closed %s arm\", row.function, row.file, row.outcome)\n869|\t\t\t}\n870|\t\t})\n871|\t}\n872|}\n873|\n874|// hasPresentNegation reports whether the condition negates the\n875|// present/ok boolean: !present, !ok, or a disjunction holding\n876|// one.\n877|func hasPresentNegation(node ast.Node) bool {\n878|\tfound := false\n879|\tast.Inspect(node, func(inner ast.Node) bool {\n880|\t\tunary, ok := inner.(*ast.UnaryExpr)\n881|\t\tif ok && unary.Op == token.NOT {\n882|\t\t\tif ident, ok := unary.X.(*ast.Ident); ok && (ident.Name == \"present\" || ident.Name == \"ok\") {\n883|\t\t\t\tfound = true\n884|\t\t\t\treturn false\n885|\t\t\t}\n886|\t\t}\n887|\t\treturn true\n888|\t})\n889|\treturn found\n890|}"}}}
