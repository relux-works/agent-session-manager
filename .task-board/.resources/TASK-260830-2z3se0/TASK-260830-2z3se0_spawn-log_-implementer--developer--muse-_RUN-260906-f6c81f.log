{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c633","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":372,"recorded_at":1780531400000739,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"b3348d18-b013-443c-a16d-617e2676e297"},"task_id":"b3348d18-b013-443c-a16d-617e2676e297","event":{"kind":"output","task_id":"b3348d18-b013-443c-a16d-617e2676e297","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n(439 line(s) above)\n440|// A request naming a different provider or kind would attest a\n441|// probe for a candidate the host never observed.\n442|func CheckProbeRequest(expectedProviderID string, expectedKind CandidateKind, candidate TrustedCandidate) error {\n443|\tif expectedProviderID != candidate.ProviderID {\n444|\t\tfailure, err := failInvalid(\"probe request provider identifier does not match the trusted candidate\", \"expected_provider_id\")\n445|\t\tif err != nil {\n446|\t\t\treturn err\n447|\t\t}\n448|\t\treturn failure\n449|\t}\n450|\tif expectedKind != candidate.Kind {\n451|\t\tfailure, err := failInvalid(\"probe request candidate kind does not match the trusted candidate\", \"expected_candidate_kind\")\n452|\t\tif err != nil {\n453|\t\t\treturn err\n454|\t\t}\n455|\t\treturn failure\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// CapabilityUsable reports whether the named capability is a usable\n461|// surface: present in the closed registry with status=available and\n462|// enabled=true. Conditional, unsupported, and unknown surfaces are\n463|// never usable, and neither is a name outside the registry.\n464|func CapabilityUsable(probe Probe, name string) bool {\n465|\tvalue, present := probe.Capabilities[name]\n466|\tif !present {\n467|\t\treturn false\n468|\t}\n469|\treturn value.Status == \"available\" && value.Enabled\n470|}\n471|\n472|// ProviderCapability is one provider-probe capability the\n473|// target-write gate reads: the provider's portable-store and\n474|// native-resume facts live in the provider probe, not the adapter\n475|// probe, so the caller projects exactly those two surfaces.\n476|type ProviderCapability struct {\n477|\tStatus  string\n478|\tEnabled bool\n479|}\n480|\n481|// CheckTargetWriteGates enforces the Section 7.8 target-write\n482|// conjunction: available canonical-write or official-import,\n483|// native-read-back, native-resume-plan, and workspace-binding on\n484|// the adapter side, plus provider portable-store and native-resume\n485|// on the provider side. Exact execution bindings, accepted\n486|// non-revoked tuple entries, and current fixture plus bounded\n487|// resume-smoke evidence are the caller's adjacent gates\n488|// (CheckBinding, CheckTupleAdmission, CheckDoctorResult): this\n489|// gate decides the capability conjunction only. --force,\n490|// experimental profiles, and environment-name-only matches cannot\n491|// bypass these gates: the function takes no bypass parameter, so a\n492|// caller cannot express one. Unknown sources may be archived only\n493|// after safe byte enumeration; unknown targets never write —\n494|// which this gate enforces by refusing every capability it cannot\n495|// see as available and enabled.\n496|func CheckTargetWriteGates(adapter map[string]Capability, provider map[string]ProviderCapability) error {\n497|\tif !capabilityMapUsable(adapter, \"canonical_write\") && !capabilityMapUsable(adapter, \"official_import\") {\n498|\t\tfailure, err := failCapability(\"target write has neither usable canonical-write nor official-import\", \"canonical_write|official_import\")\n499|\t\tif err != nil {\n500|\t\t\treturn err\n501|\t\t}\n502|\t\treturn failure\n503|\t}\n504|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n505|\t\tif !capabilityMapUsable(adapter, name) {\n506|\t\t\tfailure, err := failCapability(\"target write misses a usable adapter capability\", name)\n507|\t\t\tif err != nil {\n508|\t\t\t\treturn err\n509|\t\t\t}\n510|\t\t\treturn failure\n511|\t\t}\n512|\t}\n513|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n514|\t\tvalue, present := provider[name]\n515|\t\tif !present || value.Status != \"available\" || !value.Enabled {\n516|\t\t\tfailure, err := failCapability(\"target write misses a usable provider capability\", \"provider:\"+name)\n517|\t\t\tif err != nil {\n518|\t\t\t\treturn err\n519|\t\t\t}\n520|\t\t\treturn failure\n521|\t\t}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// capabilityMapUsable reports whether the named adapter capability\n527|// is usable. An absent name is not usable: the map must be the\n528|// decoded probe map, which always carries all fifteen.\n529|func capabilityMapUsable(adapter map[string]Capability, name string) bool {\n530|\tvalue, present := adapter[name]\n531|\tif !present {\n532|\t\treturn false\n533|\t}\n534|\treturn value.Status == \"available\" && value.Enabled\n535|}\n536|\n537|// doctorResultMembers is the exact doctor success-body member set.\n538|var doctorResultMembers = map[string]bool{\n539|\t\"context\":               true,\n540|\t\"direction\":             true,\n541|\t\"registry_sequence\":     true,\n542|\t\"registry_entry_status\": true,\n543|\t\"findings\":              true,\n544|\t\"healthy\":               true,\n545|\t\"extensions\":            true,\n546|}\n547|\n548|// doctorResultRequired lists doctorResultMembers in order.\n549|var doctorResultRequired = []string{\n550|\t\"context\",\n551|\t\"direction\",\n552|\t\"registry_sequence\",\n553|\t\"registry_entry_status\",\n554|\t\"findings\",\n555|\t\"healthy\",\n556|\t\"extensions\",\n557|}\n558|\n559|// DoctorResult is one validated doctor success body.\n560|type DoctorResult struct {\n561|\tContext          CallContext\n562|\tDirection        Direction\n563|\tRegistrySequence uint64\n564|\tEntryStatus      string\n565|\tFindings         []Finding\n566|\tHealthy          bool\n567|}\n568|\n569|// DecodeDoctorResult validates one closed doctor success body: the\n570|// echoed context, the direction in the closed vocabulary, the\n571|// registry sequence as uint53, the entry status in\n572|// accepted|revoked|absent, the findings, and the health flag. The\n573|// health rule itself is CheckDoctorHealthy: decoding proves shape,\n574|// not health.\n575|func DecodeDoctorResult(body []byte, sent CallContext, sentDirection Direction) (DoctorResult, error) {\n576|\tmembers, fault := decodeStrictObject(body)\n577|\tif fault != nil {\n578|\t\tfailure, err := failProtocol(\"doctor result \"+fault.detail, fault.member)\n579|\t\tif err != nil {\n580|\t\t\treturn DoctorResult{}, err\n581|\t\t}\n582|\t\treturn DoctorResult{}, failure\n583|\t}\n584|\tif name, unknown := unknownMember(members, doctorResultMembers); unknown {\n585|\t\tfailure, err := failProtocol(\"doctor result carries unknown member\", name)\n586|\t\tif err != nil {\n587|\t\t\treturn DoctorResult{}, err\n588|\t\t}\n589|\t\treturn DoctorResult{}, failure\n590|\t}\n591|\tif name, missing := missingMember(members, doctorResultRequired); missing {\n592|\t\tfailure, err := failProtocol(\"doctor result misses a required member\", name)\n593|\t\tif err != nil {\n594|\t\t\treturn DoctorResult{}, err\n595|\t\t}\n596|\t\treturn DoctorResult{}, failure\n597|\t}\n598|\tcontext, err := CheckContextEcho(sent, members[\"context\"])\n599|\tif err != nil {\n600|\t\treturn DoctorResult{}, err\n601|\t}\n602|\tdirection, ok := rawString(members[\"direction\"])\n603|\tif !ok || !validDirection(direction) {\n604|\t\tfailure, err := failProtocol(\"doctor result direction is outside source_read|target_write\", \"direction\")\n605|\t\tif err != nil {\n606|\t\t\treturn DoctorResult{}, err\n607|\t\t}\n608|\t\treturn DoctorResult{}, failure\n609|\t}\n610|\tif Direction(direction) != sentDirection {\n611|\t\tfailure, err := failProtocol(\"doctor result direction does not answer the request direction\", \"direction\")\n612|\t\tif err != nil {\n613|\t\t\treturn DoctorResult{}, err\n614|\t\t}\n615|\t\treturn DoctorResult{}, failure\n616|\t}\n617|\tsequence, ok := checkUint53Bounds(members[\"registry_sequence\"], 0, maxUint53)\n618|\tif !ok {\n619|\t\tfailure, err := failProtocol(\"doctor result registry sequence is not a uint53\", \"registry_sequence\")\n620|\t\tif err != nil {\n621|\t\t\treturn DoctorResult{}, err\n622|\t\t}\n623|\t\treturn DoctorResult{}, failure\n624|\t}\n625|\tstatus, ok := rawString(members[\"registry_entry_status\"])\n626|\tif !ok || !validRegistryEntryStatus(status) {\n627|\t\tfailure, err := failProtocol(\"doctor result entry status is outside accepted|revoked|absent\", \"registry_entry_status\")\n628|\t\tif err != nil {\n629|\t\t\treturn DoctorResult{}, err\n630|\t\t}\n631|\t\treturn DoctorResult{}, failure\n632|\t}\n633|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n634|\tif err != nil {\n635|\t\treturn DoctorResult{}, err\n636|\t}\n637|\thealthy, ok := rawBool(members[\"healthy\"])\n638|\tif !ok {\n639|\t\tfailure, err := failProtocol(\"doctor result health flag is not a boolean\", \"healthy\")\n640|\t\tif err != nil {\n641|\t\t\treturn DoctorResult{}, err\n642|\t\t}\n643|\t\treturn DoctorResult{}, failure\n644|\t}\n645|\tif !checkExtensions(members[\"extensions\"]) {\n646|\t\tfailure, err := failProtocol(\"doctor result extensions are not reverse-DNS keyed\", \"extensions\")\n647|\t\tif err != nil {\n648|\t\t\treturn DoctorResult{}, err\n649|\t\t}\n650|\t\treturn DoctorResult{}, failure\n651|\t}\n652|\treturn DoctorResult{\n653|\t\tContext:          context,\n654|\t\tDirection:        Direction(direction),\n655|\t\tRegistrySequence: sequence,\n656|\t\tEntryStatus:      status,\n657|\t\tFindings:         findings,\n658|\t\tHealthy:          healthy,\n659|\t}, nil\n660|}\n661|\n662|// CheckDoctorHealthy enforces the doctor health rule: healthy\n663|// requires an accepted exact binding and every required\n664|// capability. A healthy=true result over a revoked or absent entry\n665|// is refused, and so is a healthy=true result with any required\n666|// capability unusable. healthy=false is always structurally\n667|// admissible: the rule states necessary conditions, not\n668|// sufficient ones. Every required name must belong to the closed\n669|// fifteen-registry; a required set naming anything else is a\n670|// caller error, because the host cannot demand a surface the\n671|// contract never defined.\n672|func CheckDoctorHealthy(result DoctorResult, probe Probe, required []string) error {\n673|\tfor _, name := range required {\n674|\t\tif !validCapabilityName(name) {\n675|\t\t\tfailure, err := failInvalid(\"doctor required set names a capability outside the closed registry\", \"required\")\n676|\t\t\tif err != nil {\n677|\t\t\t\treturn err\n678|\t\t\t}\n679|\t\t\treturn failure\n680|\t\t}\n681|\t}\n682|\tif !result.Healthy {\n683|\t\treturn nil\n684|\t}\n685|\tif result.EntryStatus != \"accepted\" {\n686|\t\tfailure, err := failCapability(\"doctor reports healthy without an accepted registry entry\", \"tuple_registry\")\n687|\t\tif err != nil {\n688|\t\t\treturn err\n689|\t\t}\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c635","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":373,"recorded_at":1780531400000741,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"b3348d18-b013-443c-a16d-617e2676e297"},"task_id":"b3348d18-b013-443c-a16d-617e2676e297","event":{"kind":"completed","task_id":"b3348d18-b013-443c-a16d-617e2676e297"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c637","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":374,"recorded_at":1780531400000743,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e4f38e7833b23a600a87972012","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n(89 line(s) above)\n90|func decodeCapabilityValue(raw json.RawMessage, name string) (Capability, error) {\n91|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(\"adapter capability \"+fault.detail, name)\n94|\t\tif err != nil {\n95|\t\t\treturn Capability{}, err\n96|\t\t}\n97|\t\treturn Capability{}, failure\n98|\t}\n99|\tif member, unknown := unknownMember(members, capabilityValueMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"adapter capability value carries unknown member\", member)\n101|\t\tif err != nil {\n102|\t\t\treturn Capability{}, err\n103|\t\t}\n104|\t\treturn Capability{}, failure\n105|\t}\n106|\tif member, missing := missingMember(members, capabilityValueRequired); missing {\n107|\t\tfailure, err := failProtocol(\"adapter capability value misses a required member\", member)\n108|\t\tif err != nil {\n109|\t\t\treturn Capability{}, err\n110|\t\t}\n111|\t\treturn Capability{}, failure\n112|\t}\n113|\tstatus, ok := rawString(members[\"status\"])\n114|\tif !ok || !validCapabilityStatus(status) {\n115|\t\tfailure, err := failProtocol(\"adapter capability status is outside available|conditional|unsupported|unknown\", name)\n116|\t\tif err != nil {\n117|\t\t\treturn Capability{}, err\n118|\t\t}\n119|\t\treturn Capability{}, failure\n120|\t}\n121|\tenabled, ok := rawBool(members[\"enabled\"])\n122|\tif !ok {\n123|\t\tfailure, err := failProtocol(\"adapter capability enabled flag is not a boolean\", name)\n124|\t\tif err != nil {\n125|\t\t\treturn Capability{}, err\n126|\t\t}\n127|\t\treturn Capability{}, failure\n128|\t}\n129|\tif enabled && status != \"available\" {\n130|\t\tfailure, err := failProtocol(\"adapter capability is enabled without available status\", name)\n131|\t\tif err != nil {\n132|\t\t\treturn Capability{}, err\n133|\t\t}\n134|\t\treturn Capability{}, failure\n135|\t}\n136|\tevidence, ok := rawString(members[\"evidence\"])\n137|\tif !ok || !validCapabilityEvidence(evidence) {\n138|\t\tfailure, err := failProtocol(\"adapter capability evidence is outside the seven-evidence vocabulary\", name)\n139|\t\tif err != nil {\n140|\t\t\treturn Capability{}, err\n141|\t\t}\n142|\t\treturn Capability{}, failure\n143|\t}\n144|\tdetail, ok := checkStringBounds(members[\"detail\"], 0, 2048)\n145|\tif !ok {\n146|\t\tfailure, err := failProtocol(\"adapter capability detail is not a string[0..2048]\", name)\n147|\t\tif err != nil {\n148|\t\t\treturn Capability{}, err\n149|\t\t}\n150|\t\treturn Capability{}, failure\n151|\t}\n152|\treturn Capability{\n153|\t\tStatus:   status,\n154|\t\tEnabled:  enabled,\n155|\t\tEvidence: evidence,\n156|\t\tDetail:   detail,\n157|\t}, nil\n158|}\n159|\n160|// capabilityEvidences is the seven-evidence vocabulary Section 7.8\n161|// states. Membership is a table loop so the census derives it like\n162|// every other closed vocabulary.\n163|var capabilityEvidences = []string{\n164|\t\"documented\",\n165|\t\"probed\",\n166|\t\"accepted_test\",\n167|\t\"provider_contract\",\n168|\t\"inferred\",\n169|\t\"acceptance_required\",\n170|\t\"none\",\n171|}\n172|\n173|// validCapabilityEvidence reports whether the evidence token is one\n174|// of the seven Section 7.8 values.\n175|func validCapabilityEvidence(evidence string) bool {\n176|\tfor _, allowed := range capabilityEvidences {\n177|\t\tif evidence == allowed {\n178|\t\t\treturn true\n179|\t\t}\n180|\t}\n181|\treturn false\n182|}\n183|\n184|// capabilityStatuses is the four-status vocabulary Section 7.8\n185|// states. Membership is a table loop so the census derives it like\n186|// every other closed vocabulary.\n187|var capabilityStatuses = []string{\n188|\t\"available\",\n189|\t\"conditional\",\n190|\t\"unsupported\",\n191|\t\"unknown\",\n192|}\n193|\n194|// validCapabilityStatus reports whether the status token is one of\n195|// the four Section 7.8 values.\n196|func validCapabilityStatus(status string) bool {\n197|\tfor _, allowed := range capabilityStatuses {\n198|\t\tif status == allowed {\n199|\t\t\treturn true\n200|\t\t}\n201|\t}\n202|\treturn false\n203|}\n204|\n205|// registryEntryStatuses is the three-status doctor vocabulary the\n206|// Section 7.8 doctor row states: accepted, revoked, and absent.\n207|// Membership is a table loop so the census derives it like every\n208|// other closed vocabulary.\n209|var registryEntryStatuses = []string{\n210|\t\"accepted\",\n211|\t\"revoked\",\n212|\t\"absent\",\n213|}\n214|\n215|// validRegistryEntryStatus reports whether the status is one of\n216|// the three Section 7.8 doctor entry statuses.\n217|func validRegistryEntryStatus(status string) bool {\n218|\tfor _, allowed := range registryEntryStatuses {\n219|\t\tif status == allowed {\n220|\t\t\treturn true\n221|\t\t}\n222|\t}\n223|\treturn false\n224|}\n225|\n226|// DecodeProbe validates one probe-operation success body as the\n227|// closed Section 7.8 Session Adapter Probe: the exact members, all\n228|// fifteen capabilities with no omission and no extra, and the\n229|// value rules above. Missing, extra, duplicated, malformed, or\n230|// contradictory facts invalidate the whole probe and never mean\n231|// unsupported. Equality against the manifest and host values is\n232|// the separate CheckProbe gate: decoding proves shape, not\n233|// binding.\n234|func DecodeProbe(body []byte) (Probe, error) {\n235|\tmembers, fault := decodeStrictObject(body)\n236|\tif fault != nil {\n237|\t\tfailure, err := failProtocol(\"adapter probe \"+fault.detail, fault.member)\n238|\t\tif err != nil {\n239|\t\t\treturn Probe{}, err\n240|\t\t}\n241|\t\treturn Probe{}, failure\n242|\t}\n243|\tif name, unknown := unknownMember(members, probeMembers); unknown {\n244|\t\tfailure, err := failProtocol(\"adapter probe carries unknown member\", name)\n245|\t\tif err != nil {\n246|\t\t\treturn Probe{}, err\n247|\t\t}\n248|\t\treturn Probe{}, failure\n249|\t}\n250|\tif name, missing := missingMember(members, probeRequired); missing {\n251|\t\tfailure, err := failProtocol(\"adapter probe misses a required member\", name)\n252|\t\tif err != nil {\n253|\t\t\treturn Probe{}, err\n254|\t\t}\n255|\t\treturn Probe{}, failure\n256|\t}\n257|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != probeSchema {\n258|\t\tfailure, err := failProtocol(\"adapter probe schema is not the session adapter probe\", \"schema\")\n259|\t\tif err != nil {\n260|\t\t\treturn Probe{}, err\n261|\t\t}\n262|\t\treturn Probe{}, failure\n263|\t}\n264|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != probeSchemaVersion {\n265|\t\tfailure, err := failProtocol(\"adapter probe version is not 1.0.0\", \"schema_version\")\n266|\t\tif err != nil {\n267|\t\t\treturn Probe{}, err\n268|\t\t}\n269|\t\treturn Probe{}, failure\n270|\t}\n271|\tproviderID, ok := rawString(members[\"provider_id\"])\n272|\tif !ok || !providerIDPattern.MatchString(providerID) {\n273|\t\tfailure, err := failProtocol(\"adapter probe provider identifier is not a provider-id\", \"provider_id\")\n274|\t\tif err != nil {\n275|\t\t\treturn Probe{}, err\n276|\t\t}\n277|\t\treturn Probe{}, failure\n278|\t}\n279|\tmanifestDigest, ok := checkDigest(members[\"adapter_manifest_digest\"])\n280|\tif !ok {\n281|\t\tfailure, err := failProtocol(\"adapter probe manifest digest is not a digest\", \"adapter_manifest_digest\")\n282|\t\tif err != nil {\n283|\t\t\treturn Probe{}, err\n284|\t\t}\n285|\t\treturn Probe{}, failure\n286|\t}\n287|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n288|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n289|\t\tfailure, err := failProtocol(\"adapter probe adapter version is not SemVer\", \"adapter_version\")\n290|\t\tif err != nil {\n291|\t\t\treturn Probe{}, err\n292|\t\t}\n293|\t\treturn Probe{}, failure\n294|\t}\n295|\tenvironment, err := DecodeTuple(members[\"environment\"])\n296|\tif err != nil {\n297|\t\treturn Probe{}, err\n298|\t}\n299|\tcapabilities, err := decodeCapabilities(members[\"capabilities\"])\n300|\tif err != nil {\n301|\t\treturn Probe{}, err\n302|\t}\n303|\twarnings, ok := checkSortedUniqueStrings(members[\"warnings\"], 0, 2048, 0, 1024)\n304|\tif !ok {\n305|\t\tfailure, err := failProtocol(\"adapter probe warnings are not sorted unique string[0..2048][0..1024]\", \"warnings\")\n306|\t\tif err != nil {\n307|\t\t\treturn Probe{}, err\n308|\t\t}\n309|\t\treturn Probe{}, failure\n310|\t}\n311|\tif !checkExtensions(members[\"extensions\"]) {\n312|\t\tfailure, err := failProtocol(\"adapter probe extensions are not reverse-DNS keyed\", \"extensions\")\n313|\t\tif err != nil {\n314|\t\t\treturn Probe{}, err\n315|\t\t}\n316|\t\treturn Probe{}, failure\n317|\t}\n318|\treturn Probe{\n319|\t\tProviderID:     providerID,\n320|\t\tManifestDigest: manifestDigest.String(),\n321|\t\tAdapterVersion: adapterVersion,\n322|\t\tEnvironment:    environment,\n323|\t\tCapabilities:   capabilities,\n324|\t\tWarnings:       warnings,\n325|\t}, nil\n326|}\n327|\n328|// decodeCapabilities validates the closed capability map: exactly\n329|// the fifteen registry names, each with a closed value. The map\n330|// carries no order — names are the keys — so omission and extra\n331|// are the two refused directions, and duplication is already\n332|// refused by the strict decode.\n333|func decodeCapabilities(raw json.RawMessage) (map[string]Capability, error) {\n334|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n335|\tif fault != nil {\n336|\t\tfailure, err := failProtocol(\"adapter capabilities \"+fault.detail, \"capabilities\")\n337|\t\tif err != nil {\n338|\t\t\treturn nil, err\n339|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c639","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":375,"recorded_at":1780531400000745,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e4f45a7573893ffff67fed6b3e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n(439 line(s) above)\n440|// A request naming a different provider or kind would attest a\n441|// probe for a candidate the host never observed.\n442|func CheckProbeRequest(expectedProviderID string, expectedKind CandidateKind, candidate TrustedCandidate) error {\n443|\tif expectedProviderID != candidate.ProviderID {\n444|\t\tfailure, err := failInvalid(\"probe request provider identifier does not match the trusted candidate\", \"expected_provider_id\")\n445|\t\tif err != nil {\n446|\t\t\treturn err\n447|\t\t}\n448|\t\treturn failure\n449|\t}\n450|\tif expectedKind != candidate.Kind {\n451|\t\tfailure, err := failInvalid(\"probe request candidate kind does not match the trusted candidate\", \"expected_candidate_kind\")\n452|\t\tif err != nil {\n453|\t\t\treturn err\n454|\t\t}\n455|\t\treturn failure\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// CapabilityUsable reports whether the named capability is a usable\n461|// surface: present in the closed registry with status=available and\n462|// enabled=true. Conditional, unsupported, and unknown surfaces are\n463|// never usable, and neither is a name outside the registry.\n464|func CapabilityUsable(probe Probe, name string) bool {\n465|\tvalue, present := probe.Capabilities[name]\n466|\tif !present {\n467|\t\treturn false\n468|\t}\n469|\treturn value.Status == \"available\" && value.Enabled\n470|}\n471|\n472|// ProviderCapability is one provider-probe capability the\n473|// target-write gate reads: the provider's portable-store and\n474|// native-resume facts live in the provider probe, not the adapter\n475|// probe, so the caller projects exactly those two surfaces.\n476|type ProviderCapability struct {\n477|\tStatus  string\n478|\tEnabled bool\n479|}\n480|\n481|// CheckTargetWriteGates enforces the Section 7.8 target-write\n482|// conjunction: available canonical-write or official-import,\n483|// native-read-back, native-resume-plan, and workspace-binding on\n484|// the adapter side, plus provider portable-store and native-resume\n485|// on the provider side. Exact execution bindings, accepted\n486|// non-revoked tuple entries, and current fixture plus bounded\n487|// resume-smoke evidence are the caller's adjacent gates\n488|// (CheckBinding, CheckTupleAdmission, CheckDoctorResult): this\n489|// gate decides the capability conjunction only. --force,\n490|// experimental profiles, and environment-name-only matches cannot\n491|// bypass these gates: the function takes no bypass parameter, so a\n492|// caller cannot express one. Unknown sources may be archived only\n493|// after safe byte enumeration; unknown targets never write —\n494|// which this gate enforces by refusing every capability it cannot\n495|// see as available and enabled.\n496|func CheckTargetWriteGates(adapter map[string]Capability, provider map[string]ProviderCapability) error {\n497|\tif !capabilityMapUsable(adapter, \"canonical_write\") && !capabilityMapUsable(adapter, \"official_import\") {\n498|\t\tfailure, err := failCapability(\"target write has neither usable canonical-write nor official-import\", \"canonical_write|official_import\")\n499|\t\tif err != nil {\n500|\t\t\treturn err\n501|\t\t}\n502|\t\treturn failure\n503|\t}\n504|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n505|\t\tif !capabilityMapUsable(adapter, name) {\n506|\t\t\tfailure, err := failCapability(\"target write misses a usable adapter capability\", name)\n507|\t\t\tif err != nil {\n508|\t\t\t\treturn err\n509|\t\t\t}\n510|\t\t\treturn failure\n511|\t\t}\n512|\t}\n513|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n514|\t\tvalue, present := provider[name]\n515|\t\tif !present || value.Status != \"available\" || !value.Enabled {\n516|\t\t\tfailure, err := failCapability(\"target write misses a usable provider capability\", \"provider:\"+name)\n517|\t\t\tif err != nil {\n518|\t\t\t\treturn err\n519|\t\t\t}\n520|\t\t\treturn failure\n521|\t\t}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// capabilityMapUsable reports whether the named adapter capability\n527|// is usable. An absent name is not usable: the map must be the\n528|// decoded probe map, which always carries all fifteen.\n529|func capabilityMapUsable(adapter map[string]Capability, name string) bool {\n530|\tvalue, present := adapter[name]\n531|\tif !present {\n532|\t\treturn false\n533|\t}\n534|\treturn value.Status == \"available\" && value.Enabled\n535|}\n536|\n537|// doctorResultMembers is the exact doctor success-body member set.\n538|var doctorResultMembers = map[string]bool{\n539|\t\"context\":               true,\n540|\t\"direction\":             true,\n541|\t\"registry_sequence\":     true,\n542|\t\"registry_entry_status\": true,\n543|\t\"findings\":              true,\n544|\t\"healthy\":               true,\n545|\t\"extensions\":            true,\n546|}\n547|\n548|// doctorResultRequired lists doctorResultMembers in order.\n549|var doctorResultRequired = []string{\n550|\t\"context\",\n551|\t\"direction\",\n552|\t\"registry_sequence\",\n553|\t\"registry_entry_status\",\n554|\t\"findings\",\n555|\t\"healthy\",\n556|\t\"extensions\",\n557|}\n558|\n559|// DoctorResult is one validated doctor success body.\n560|type DoctorResult struct {\n561|\tContext          CallContext\n562|\tDirection        Direction\n563|\tRegistrySequence uint64\n564|\tEntryStatus      string\n565|\tFindings         []Finding\n566|\tHealthy          bool\n567|}\n568|\n569|// DecodeDoctorResult validates one closed doctor success body: the\n570|// echoed context, the direction in the closed vocabulary, the\n571|// registry sequence as uint53, the entry status in\n572|// accepted|revoked|absent, the findings, and the health flag. The\n573|// health rule itself is CheckDoctorHealthy: decoding proves shape,\n574|// not health.\n575|func DecodeDoctorResult(body []byte, sent CallContext, sentDirection Direction) (DoctorResult, error) {\n576|\tmembers, fault := decodeStrictObject(body)\n577|\tif fault != nil {\n578|\t\tfailure, err := failProtocol(\"doctor result \"+fault.detail, fault.member)\n579|\t\tif err != nil {\n580|\t\t\treturn DoctorResult{}, err\n581|\t\t}\n582|\t\treturn DoctorResult{}, failure\n583|\t}\n584|\tif name, unknown := unknownMember(members, doctorResultMembers); unknown {\n585|\t\tfailure, err := failProtocol(\"doctor result carries unknown member\", name)\n586|\t\tif err != nil {\n587|\t\t\treturn DoctorResult{}, err\n588|\t\t}\n589|\t\treturn DoctorResult{}, failure\n590|\t}\n591|\tif name, missing := missingMember(members, doctorResultRequired); missing {\n592|\t\tfailure, err := failProtocol(\"doctor result misses a required member\", name)\n593|\t\tif err != nil {\n594|\t\t\treturn DoctorResult{}, err\n595|\t\t}\n596|\t\treturn DoctorResult{}, failure\n597|\t}\n598|\tcontext, err := CheckContextEcho(sent, members[\"context\"])\n599|\tif err != nil {\n600|\t\treturn DoctorResult{}, err\n601|\t}\n602|\tdirection, ok := rawString(members[\"direction\"])\n603|\tif !ok || !validDirection(direction) {\n604|\t\tfailure, err := failProtocol(\"doctor result direction is outside source_read|target_write\", \"direction\")\n605|\t\tif err != nil {\n606|\t\t\treturn DoctorResult{}, err\n607|\t\t}\n608|\t\treturn DoctorResult{}, failure\n609|\t}\n610|\tif Direction(direction) != sentDirection {\n611|\t\tfailure, err := failProtocol(\"doctor result direction does not answer the request direction\", \"direction\")\n612|\t\tif err != nil {\n613|\t\t\treturn DoctorResult{}, err\n614|\t\t}\n615|\t\treturn DoctorResult{}, failure\n616|\t}\n617|\tsequence, ok := checkUint53Bounds(members[\"registry_sequence\"], 0, maxUint53)\n618|\tif !ok {\n619|\t\tfailure, err := failProtocol(\"doctor result registry sequence is not a uint53\", \"registry_sequence\")\n620|\t\tif err != nil {\n621|\t\t\treturn DoctorResult{}, err\n622|\t\t}\n623|\t\treturn DoctorResult{}, failure\n624|\t}\n625|\tstatus, ok := rawString(members[\"registry_entry_status\"])\n626|\tif !ok || !validRegistryEntryStatus(status) {\n627|\t\tfailure, err := failProtocol(\"doctor result entry status is outside accepted|revoked|absent\", \"registry_entry_status\")\n628|\t\tif err != nil {\n629|\t\t\treturn DoctorResult{}, err\n630|\t\t}\n631|\t\treturn DoctorResult{}, failure\n632|\t}\n633|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n634|\tif err != nil {\n635|\t\treturn DoctorResult{}, err\n636|\t}\n637|\thealthy, ok := rawBool(members[\"healthy\"])\n638|\tif !ok {\n639|\t\tfailure, err := failProtocol(\"doctor result health flag is not a boolean\", \"healthy\")\n640|\t\tif err != nil {\n641|\t\t\treturn DoctorResult{}, err\n642|\t\t}\n643|\t\treturn DoctorResult{}, failure\n644|\t}\n645|\tif !checkExtensions(members[\"extensions\"]) {\n646|\t\tfailure, err := failProtocol(\"doctor result extensions are not reverse-DNS keyed\", \"extensions\")\n647|\t\tif err != nil {\n648|\t\t\treturn DoctorResult{}, err\n649|\t\t}\n650|\t\treturn DoctorResult{}, failure\n651|\t}\n652|\treturn DoctorResult{\n653|\t\tContext:          context,\n654|\t\tDirection:        Direction(direction),\n655|\t\tRegistrySequence: sequence,\n656|\t\tEntryStatus:      status,\n657|\t\tFindings:         findings,\n658|\t\tHealthy:          healthy,\n659|\t}, nil\n660|}\n661|\n662|// CheckDoctorHealthy enforces the doctor health rule: healthy\n663|// requires an accepted exact binding and every required\n664|// capability. A healthy=true result over a revoked or absent entry\n665|// is refused, and so is a healthy=true result with any required\n666|// capability unusable. healthy=false is always structurally\n667|// admissible: the rule states necessary conditions, not\n668|// sufficient ones. Every required name must belong to the closed\n669|// fifteen-registry; a required set naming anything else is a\n670|// caller error, because the host cannot demand a surface the\n671|// contract never defined.\n672|func CheckDoctorHealthy(result DoctorResult, probe Probe, required []string) error {\n673|\tfor _, name := range required {\n674|\t\tif !validCapabilityName(name) {\n675|\t\t\tfailure, err := failInvalid(\"doctor required set names a capability outside the closed registry\", \"required\")\n676|\t\t\tif err != nil {\n677|\t\t\t\treturn err\n678|\t\t\t}\n679|\t\t\treturn failure\n680|\t\t}\n681|\t}\n682|\tif !result.Healthy {\n683|\t\treturn nil\n684|\t}\n685|\tif result.EntryStatus != \"accepted\" {\n686|\t\tfailure, err := failCapability(\"doctor reports healthy without an accepted registry entry\", \"tuple_registry\")\n687|\t\tif err != nil {\n688|\t\t\treturn err\n689|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
