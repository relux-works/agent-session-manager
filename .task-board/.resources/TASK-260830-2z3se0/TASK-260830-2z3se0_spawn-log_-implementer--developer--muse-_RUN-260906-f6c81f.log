{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccf3","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":1236,"recorded_at":1780531400002467,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"6ac25fda-9987-4d52-8ea3-2829aa7d3dbc"},"task_id":"6ac25fda-9987-4d52-8ea3-2829aa7d3dbc","event":{"kind":"output","task_id":"6ac25fda-9987-4d52-8ea3-2829aa7d3dbc","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n(486 line(s) above)\n487|\n488|// TestBoundGuardsAreCensused is the bound census: the derived\n489|// production site multiset must equal the registration multiset.\n490|// An unregistered site fails as unrostered; an orphaned\n491|// registration fails as stale. Every non-exempt row must name a\n492|// driver and every exempt row a rationale.\n493|func TestBoundGuardsAreCensused(t *testing.T) {\n494|\tdirectory, err := os.Getwd()\n495|\tif err != nil {\n496|\t\tt.Fatalf(\"bound census: %v\", err)\n497|\t}\n498|\tderived := scanBoundSiteIDs(t, directory)\n499|\tif len(derived) == 0 {\n500|\t\tt.Fatal(\"bound census derived zero sites; the scanner is broken, not the package\")\n501|\t}\n502|\tderivedCounts := map[string]int{}\n503|\tfor _, id := range derived {\n504|\t\tderivedCounts[id]++\n505|\t}\n506|\tfor _, canary := range boundCensusCanaries {\n507|\t\tfound := false\n508|\t\tfor id := range derivedCounts {\n509|\t\t\tif strings.HasPrefix(id, canary) {\n510|\t\t\t\tfound = true\n511|\t\t\t\tbreak\n512|\t\t\t}\n513|\t\t}\n514|\t\tif !found {\n515|\t\t\tt.Errorf(\"bound census blind to canary %q; the scanner misses the class it must roster\", canary)\n516|\t\t}\n517|\t}\n518|\tregisteredCounts := map[string]int{}\n519|\tseen := map[string]bool{}\n520|\tfor _, row := range boundRegistrations {\n521|\t\tif seen[row.id] {\n522|\t\t\tt.Errorf(\"bound census registers %q twice\", row.id)\n523|\t\t}\n524|\t\tseen[row.id] = true\n525|\t\tregisteredCounts[row.id]++\n526|\t\tif row.driver == \"\" && !row.exempt {\n527|\t\t\tt.Errorf(\"bound census row %q names no driver and no exemption\", row.id)\n528|\t\t}\n529|\t\tif row.exempt && row.reason == \"\" {\n530|\t\t\tt.Errorf(\"bound census exemption %q states no rationale\", row.id)\n531|\t\t}\n532|\t}\n533|\tvar unregistered []string\n534|\tfor id, count := range derivedCounts {\n535|\t\tfor i := registeredCounts[id]; i < count; i++ {\n536|\t\t\tunregistered = append(unregistered, id)\n537|\t\t}\n538|\t}\n539|\tvar orphaned []string\n540|\tfor id, count := range registeredCounts {\n541|\t\tfor i := derivedCounts[id]; i < count; i++ {\n542|\t\t\torphaned = append(orphaned, id)\n543|\t\t}\n544|\t}\n545|\tsort.Strings(unregistered)\n546|\tsort.Strings(orphaned)\n547|\tif len(unregistered) > 0 {\n548|\t\tt.Fatalf(\"production bound site(s) with no census row:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n549|\t}\n550|\tif len(orphaned) > 0 {\n551|\t\tt.Fatalf(\"census row(s) naming no production site:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n552|\t}\n553|\tdriven, exempt := 0, 0\n554|\tfor _, row := range boundRegistrations {\n555|\t\tif row.exempt {\n556|\t\t\texempt++\n557|\t\t} else {\n558|\t\t\tdriven++\n559|\t\t}\n560|\t}\n561|\tt.Logf(\"bound census: %d sites rostered (%d driven, %d exempt) across production\", len(derived), driven, exempt)\n562|}\n563|\n564|// boundCensusDriverCount returns the number of non-exempt rows\n565|// naming the given driver. Sibling tables with fixed tripwires\n566|// (TestStringBoundEdges) assert against it so they cannot go\n(more lines below)"}}}
