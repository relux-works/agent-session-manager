{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb79","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":1047,"recorded_at":1780531400002089,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"402b8a3b-ac28-4dee-a963-c31b476b591d"},"task_id":"402b8a3b-ac28-4dee-a963-c31b476b591d","event":{"kind":"output","task_id":"402b8a3b-ac28-4dee-a963-c31b476b591d","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/identity_census_test.go`.\n(348 line(s) above)\n349|}\n350|\n351|// TestIdentityGatesAreCensused is the identity census: the\n352|// derived production gate multiset must equal the registration\n353|// multiset. Every non-exempt row must name a driver and every\n354|// exempt row a rationale.\n355|func TestIdentityGatesAreCensused(t *testing.T) {\n356|\tdirectory, err := os.Getwd()\n357|\tif err != nil {\n358|\t\tt.Fatalf(\"identity census: %v\", err)\n359|\t}\n360|\tderived := scanIdentityGateIDs(t, directory)\n361|\tif len(derived) == 0 {\n362|\t\tt.Fatal(\"identity census derived zero gates; the scanner is broken, not the package\")\n363|\t}\n364|\tderivedCounts := map[string]int{}\n365|\tfor _, id := range derived {\n366|\t\tderivedCounts[id]++\n367|\t}\n368|\tfor _, canary := range identityCensusCanaries {\n369|\t\tfound := false\n370|\t\tfor id := range derivedCounts {\n371|\t\t\tif strings.HasPrefix(id, canary) {\n372|\t\t\t\tfound = true\n373|\t\t\t\tbreak\n374|\t\t\t}\n375|\t\t}\n376|\t\tif !found {\n377|\t\t\tt.Errorf(\"identity census blind to canary %q; the scanner misses the class it must roster\", canary)\n378|\t\t}\n379|\t}\n380|\tregisteredCounts := map[string]int{}\n381|\tseen := map[string]bool{}\n382|\tfor _, row := range identityRegistrations {\n383|\t\tif seen[row.id] {\n384|\t\t\tt.Errorf(\"identity census registers %q twice\", row.id)\n385|\t\t}\n386|\t\tseen[row.id] = true\n387|\t\tregisteredCounts[row.id]++\n388|\t\tif row.driver == \"\" && !row.exempt {\n389|\t\t\tt.Errorf(\"identity census row %q names no driver and no exemption\", row.id)\n390|\t\t}\n391|\t\tif row.exempt && row.reason == \"\" {\n392|\t\t\tt.Errorf(\"identity census exemption %q states no rationale\", row.id)\n393|\t\t}\n394|\t}\n395|\tvar unregistered []string\n396|\tfor id, count := range derivedCounts {\n397|\t\tfor i := registeredCounts[id]; i < count; i++ {\n398|\t\t\tunregistered = append(unregistered, id)\n399|\t\t}\n400|\t}\n401|\tvar orphaned []string\n402|\tfor id, count := range registeredCounts {\n403|\t\tfor i := derivedCounts[id]; i < count; i++ {\n404|\t\t\torphaned = append(orphaned, id)\n405|\t\t}\n406|\t}\n407|\tsort.Strings(unregistered)\n408|\tsort.Strings(orphaned)\n409|\tif len(unregistered) > 0 {\n410|\t\tt.Fatalf(\"production identity gate(s) with no census row:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n411|\t}\n412|\tif len(orphaned) > 0 {\n413|\t\tt.Fatalf(\"census row(s) naming no production gate:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n(more lines below)"}}}
