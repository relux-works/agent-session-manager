{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76b","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":528,"recorded_at":1780531400001051,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e6297673e187edea7a6a72c91c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n(339 line(s) above)\n340|\t\treturn nil, failure\n341|\t}\n342|\tif len(members) != len(capabilityOrder) {\n343|\t\tfailure, err := failProtocol(\"adapter capabilities do not carry exactly fifteen entries\", \"capabilities\")\n344|\t\tif err != nil {\n345|\t\t\treturn nil, err\n346|\t\t}\n347|\t\treturn nil, failure\n348|\t}\n349|\tcapabilities := make(map[string]Capability, len(capabilityOrder))\n350|\tfor _, name := range capabilityOrder {\n351|\t\trawValue, present := members[name]\n352|\t\tif !present {\n353|\t\t\tfailure, err := failProtocol(\"adapter capabilities omit a registry capability\", name)\n354|\t\t\tif err != nil {\n355|\t\t\t\treturn nil, err\n356|\t\t\t}\n357|\t\t\treturn nil, failure\n358|\t\t}\n359|\t\tvalue, err := decodeCapabilityValue(rawValue, name)\n360|\t\tif err != nil {\n361|\t\t\treturn nil, err\n362|\t\t}\n363|\t\tcapabilities[name] = value\n364|\t}\n365|\treturn capabilities, nil\n366|}\n367|\n368|// ProbeHostFacts are the host-held values the probe must equal:\n369|// the provider identifier and candidate kind from the probe\n370|// request the host built, the manifest digest the host computed,\n371|// and the manifest the host verified. Nothing here comes from the\n372|// adapter.\n373|type ProbeHostFacts struct {\n374|\tExpectedProviderID string\n375|\tExpectedKind       CandidateKind\n376|\tManifestDigest     string\n377|\tManifest           Manifest\n378|}\n379|\n380|// CheckProbe enforces the Section 7.8 probe equalities: provider\n381|// ID, manifest digest, and adapter version equal the verified\n382|// manifest and host values, and the reported tuple is the\n383|// manifest's tuple — the adapter's one semantic native\n384|// environment, so a probe reporting any other tuple is an\n385|// unrequested tuple and is refused. The tuple's adapter version\n386|// must equal the probe's own adapter version: both name the same\n387|// probed software, and a probe disagreeing with itself is\n388|// refused. Whether the tuple's environment version satisfies the\n389|// manifest's version-range constraint language is a stated bound:\n390|// the range grammar has no evaluation rule in Section 7.8.\n391|func CheckProbe(probe Probe, facts ProbeHostFacts) error {\n392|\tif probe.ProviderID != facts.ExpectedProviderID {\n393|\t\tfailure, err := failProtocol(\"adapter probe provider identifier does not match the requested provider\", \"provider_id\")\n394|\t\tif err != nil {\n395|\t\t\treturn err\n396|\t\t}\n397|\t\treturn failure\n398|\t}\n399|\tif probe.ProviderID != facts.Manifest.ProviderID {\n400|\t\tfailure, err := failProtocol(\"adapter probe provider identifier does not match the verified manifest\", \"provider_id\")\n401|\t\tif err != nil {\n402|\t\t\treturn err\n403|\t\t}\n404|\t\treturn failure\n405|\t}\n406|\tif probe.ManifestDigest != facts.ManifestDigest {\n407|\t\tfailure, err := failProtocol(\"adapter probe manifest digest does not match the host-computed digest\", \"adapter_manifest_digest\")\n408|\t\tif err != nil {\n409|\t\t\treturn err\n410|\t\t}\n411|\t\treturn failure\n412|\t}\n413|\tif probe.AdapterVersion != facts.Manifest.AdapterVersion {\n414|\t\tfailure, err := failProtocol(\"adapter probe adapter version does not match the verified manifest\", \"adapter_version\")\n415|\t\tif err != nil {\n416|\t\t\treturn err\n417|\t\t}\n418|\t\treturn failure\n419|\t}\n420|\tif probe.Environment.EnvironmentID != facts.Manifest.EnvironmentID {\n421|\t\tfailure, err := failUnsupportedTuple(\"adapter probe reports a tuple outside the manifest environment\", probe.Environment.EnvironmentID)\n422|\t\tif err != nil {\n423|\t\t\treturn err\n424|\t\t}\n425|\t\treturn failure\n426|\t}\n427|\tif probe.Environment.AdapterVersion != probe.AdapterVersion {\n428|\t\tfailure, err := failProtocol(\"adapter probe tuple adapter version does not match the probe adapter version\", \"environment\")\n429|\t\tif err != nil {\n430|\t\t\treturn err\n431|\t\t}\n432|\t\treturn failure\n433|\t}\n434|\treturn nil\n435|}\n436|\n437|// CheckProbeRequest binds the probe request the host built to the\n438|// trusted candidate: the expected provider identifier and\n439|// candidate kind must equal the candidate the host will invoke.\n440|// A request naming a different provider or kind would attest a\n441|// probe for a candidate the host never observed.\n442|func CheckProbeRequest(expectedProviderID string, expectedKind CandidateKind, candidate TrustedCandidate) error {\n443|\tif expectedProviderID != candidate.ProviderID {\n444|\t\tfailure, err := failInvalid(\"probe request provider identifier does not match the trusted candidate\", \"expected_provider_id\")\n445|\t\tif err != nil {\n446|\t\t\treturn err\n447|\t\t}\n448|\t\treturn failure\n449|\t}\n450|\tif expectedKind != candidate.Kind {\n451|\t\tfailure, err := failInvalid(\"probe request candidate kind does not match the trusted candidate\", \"expected_candidate_kind\")\n452|\t\tif err != nil {\n453|\t\t\treturn err\n454|\t\t}\n455|\t\treturn failure\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// CapabilityUsable reports whether the named capability is a usable\n461|// surface: present in the closed registry with status=available and\n462|// enabled=true. Conditional, unsupported, and unknown surfaces are\n463|// never usable, and neither is a name outside the registry.\n464|func CapabilityUsable(probe Probe, name string) bool {\n465|\tvalue, present := probe.Capabilities[name]\n466|\tif !present {\n467|\t\treturn false\n468|\t}\n469|\treturn value.Status == \"available\" && value.Enabled\n470|}\n471|\n472|// ProviderCapability is one provider-probe capability the\n473|// target-write gate reads: the provider's portable-store and\n474|// native-resume facts live in the provider probe, not the adapter\n475|// probe, so the caller projects exactly those two surfaces.\n476|type ProviderCapability struct {\n477|\tStatus  string\n478|\tEnabled bool\n479|}\n480|\n481|// CheckTargetWriteGates enforces the Section 7.8 target-write\n482|// conjunction: available canonical-write or official-import,\n483|// native-read-back, native-resume-plan, and workspace-binding on\n484|// the adapter side, plus provider portable-store and native-resume\n485|// on the provider side. Exact execution bindings, accepted\n486|// non-revoked tuple entries, and current fixture plus bounded\n487|// resume-smoke evidence are the caller's adjacent gates\n488|// (CheckBinding, CheckTupleAdmission, CheckDoctorResult): this\n489|// gate decides the capability conjunction only. --force,\n490|// experimental profiles, and environment-name-only matches cannot\n491|// bypass these gates: the function takes no bypass parameter, so a\n492|// caller cannot express one. Unknown sources may be archived only\n493|// after safe byte enumeration; unknown targets never write —\n494|// which this gate enforces by refusing every capability it cannot\n495|// see as available and enabled.\n496|func CheckTargetWriteGates(adapter map[string]Capability, provider map[string]ProviderCapability) error {\n497|\tif !capabilityMapUsable(adapter, \"canonical_write\") && !capabilityMapUsable(adapter, \"official_import\") {\n498|\t\tfailure, err := failCapability(\"target write has neither usable canonical-write nor official-import\", \"canonical_write|official_import\")\n499|\t\tif err != nil {\n500|\t\t\treturn err\n501|\t\t}\n502|\t\treturn failure\n503|\t}\n504|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n505|\t\tif !capabilityMapUsable(adapter, name) {\n506|\t\t\tfailure, err := failCapability(\"target write misses a usable adapter capability\", name)\n507|\t\t\tif err != nil {\n508|\t\t\t\treturn err\n509|\t\t\t}\n510|\t\t\treturn failure\n511|\t\t}\n512|\t}\n513|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n514|\t\tvalue, present := provider[name]\n515|\t\tif !present || value.Status != \"available\" || !value.Enabled {\n516|\t\t\tfailure, err := failCapability(\"target write misses a usable provider capability\", \"provider:\"+name)\n517|\t\t\tif err != nil {\n518|\t\t\t\treturn err\n519|\t\t\t}\n520|\t\t\treturn failure\n521|\t\t}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// capabilityMapUsable reports whether the named adapter capability\n527|// is usable. An absent name is not usable: the map must be the\n528|// decoded probe map, which always carries all fifteen.\n529|func capabilityMapUsable(adapter map[string]Capability, name string) bool {\n530|\tvalue, present := adapter[name]\n531|\tif !present {\n532|\t\treturn false\n533|\t}\n534|\treturn value.Status == \"available\" && value.Enabled\n535|}\n536|\n537|// doctorResultMembers is the exact doctor success-body member set.\n538|var doctorResultMembers = map[string]bool{\n539|\t\"context\":               true,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
