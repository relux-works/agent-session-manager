{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5af","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":306,"recorded_at":1780531400000607,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"1192d810-ae74-4f2d-a3d5-71ca730bd525"},"task_id":"1192d810-ae74-4f2d-a3d5-71ca730bd525","event":{"kind":"output","task_id":"1192d810-ae74-4f2d-a3d5-71ca730bd525","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n1|package sessadapter\n2|\n3|// This file is the bound census (review rev4 B8). It exists because a\n4|// new bound through any of the six helpers — checkStringBounds,\n5|// requireStringBounds, checkUint53Bounds, requireUint53Bounds,\n6|// checkSortedUniqueStrings, checkSortedUniqueDigests — or a new\n7|// explicit len(...) guard passes every behavioral test that never\n8|// names it, and pinning checkStringBounds while requireStringBounds\n9|// goes unmeasured reads as complete at 35 of 35 while half the\n10|// class stays open.\n11|//\n12|// The mechanism note: requireStringBounds is a transparent wrapper\n13|// over checkStringBounds (operations.go, declared 100 lines above\n14|// the pinned sites) carrying 13 of the production call sites, and\n15|// requireUint53Bounds the same over checkUint53Bounds. Both\n16|// wrappers are rostered below as mechanism rows: they forward\n17|// their min/max to the shared checker, so their values are pinned\n18|// at the caller rows, not at the wrapper.\n19|//\n20|// Shape, modelled on TestClosedVocabularyTablesAreRegistered:\n21|// scanBoundSiteIDs derives every bound site from production source\n22|// (helper calls with their member, len guards in if conditions,\n23|// DecodeFindings cap instantiations), and\n24|// TestBoundGuardsAreCensused requires the derived multiset to\n25|// equal boundRegistrations exactly. A new bound with no row fails\n26|// the census; a removed bound orphans its row and fails too. An\n27|// empty scan fails closed. Site identity is file|function|member,\n28|// never the bound values: a moved bound (+1) keeps its identity\n29|// and must redden its behavioral driver, which the mutant battery\n30|// proves per row.\n31|//\n32|// Every non-exempt row names its driver: the committed test\n33|// driving min-1/min/max/max+1 (or the applicable edges) through\n34|// the production entry. Exempt rows say why: equivalent (the\n35|// bound is unreachable behind an upstream gate), stated-bound\n36|// (a 65537-element body), mechanism (transparent forwarder or\n37|// generic guard whose values live at the caller rows), or\n38|// plumbing (byte-scanner loop guards pinned by the surrogate\n39|// agreement suite).\n40|//\n41|// Stated bounds of this census: cross-field relational gates\n42|// (maxObjects > maxTotalBytes and its sibling in\n43|// DecodeResourceLimits) are not edge-valued sites and are pinned\n44|// behaviourally by TestDecodeResourceLimitsBounds instead; the\n45|// maxUint53 maxima are representability bounds pinned once by\n46|// TestUint53RepresentabilityCeiling rather than per site.\n47|\n48|import (\n49|\t\"bytes\"\n50|\t\"encoding/json\"\n51|\t\"fmt\"\n52|\t\"go/ast\"\n53|\t\"go/parser\"\n54|\t\"go/printer\"\n55|\t\"go/token\"\n56|\t\"os\"\n57|\t\"path/filepath\"\n58|\t\"sort\"\n59|\t\"strconv\"\n60|\t\"strings\"\n61|\t\"testing\"\n62|)\n63|\n64|// boundRegistration is one production bound site with its proof:\n65|// the behavioral driver covering its edges, or an explicit\n66|// exemption with its rationale.\n67|type boundRegistration struct {\n68|\tid     string\n69|\tdriver string\n70|\texempt bool\n71|\treason string\n72|}\n73|\n74|// boundHelpers is the closed helper set the census derives. A\n75|// seventh bound helper with no row here fails the census only if\n76|// it is called; the call-shape derivation below names the helper\n77|// per site, so an unrostered helper surfaces as unregistered\n78|// sites.\n79|var boundHelpers = map[string]bool{\n80|\t\"checkStringBounds\":        true,\n81|\t\"requireStringBounds\":      true,\n82|\t\"checkUint53Bounds\":        true,\n83|\t\"requireUint53Bounds\":      true,\n84|\t\"checkSortedUniqueStrings\": true,\n85|\t\"checkSortedUniqueDigests\": true,\n86|}\n87|\n88|// scanBoundSiteIDs derives every bound site identity from\n89|// production source: file|function|helper|member|ordinal for the\n90|// six helpers and DecodeFindings instantiations, and\n91|// file|function|len|rendered|ordinal for len guards in if\n92|// conditions. Values are deliberately not part of the identity.\n93|func scanBoundSiteIDs(t *testing.T, directory string) []string {\n94|\tt.Helper()\n95|\tentries, err := os.ReadDir(directory)\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"bound census: %v\", err)\n98|\t}\n99|\tvar ids []string\n100|\tscanned := 0\n101|\tfor _, entry := range entries {\n102|\t\tname := entry.Name()\n103|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n104|\t\t\tcontinue\n105|\t\t}\n106|\t\tscanned++\n107|\t\tpath := filepath.Join(directory, name)\n108|\t\tsource, err := os.ReadFile(path)\n109|\t\tif err != nil {\n110|\t\t\tt.Fatalf(\"bound census: %v\", err)\n111|\t\t}\n112|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n113|\t\tif err != nil {\n114|\t\t\tt.Fatalf(\"bound census: %v\", err)\n115|\t\t}\n116|\t\tfor _, declaration := range syntax.Decls {\n117|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n118|\t\t\tif !ok || function.Body == nil {\n119|\t\t\t\tcontinue\n120|\t\t\t}\n121|\t\t\tordinal := map[string]int{}\n122|\t\t\tclaim := func(base string) {\n123|\t\t\t\tids = append(ids, base+\"|\"+strconv.Itoa(ordinal[base]))\n124|\t\t\t\tordinal[base]++\n125|\t\t\t}\n126|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n127|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n128|\t\t\t\tif !ok {\n129|\t\t\t\t\treturn true\n130|\t\t\t\t}\n131|\t\t\t\tident, ok := call.Fun.(*ast.Ident)\n132|\t\t\t\tif !ok {\n133|\t\t\t\t\treturn true\n134|\t\t\t\t}\n135|\t\t\t\tswitch {\n136|\t\t\t\tcase boundHelpers[ident.Name]:\n137|\t\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|\" + ident.Name + \"|\" + boundMemberOf(call, ident.Name))\n138|\t\t\t\tcase ident.Name == \"DecodeFindings\":\n139|\t\t\t\t\tmember := renderBoundExpr(call.Args[0])\n140|\t\t\t\t\tif index, ok := call.Args[0].(*ast.IndexExpr); ok {\n141|\t\t\t\t\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n142|\t\t\t\t\t\t\tmember = literal.Value\n143|\t\t\t\t\t\t}\n144|\t\t\t\t\t}\n145|\t\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|DecodeFindings|\" + member)\n146|\t\t\t\t}\n147|\t\t\t\treturn true\n148|\t\t\t})\n149|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n150|\t\t\t\tstatement, ok := node.(*ast.IfStmt)\n151|\t\t\t\tif !ok {\n152|\t\t\t\t\treturn true\n153|\t\t\t\t}\n154|\t\t\t\tast.Inspect(statement.Cond, func(inner ast.Node) bool {\n155|\t\t\t\t\tcomparison, ok := inner.(*ast.BinaryExpr)\n156|\t\t\t\t\tif !ok {\n157|\t\t\t\t\t\treturn true\n158|\t\t\t\t\t}\n159|\t\t\t\t\tswitch comparison.Op {\n160|\t\t\t\t\tcase token.GTR, token.GEQ, token.LSS, token.LEQ, token.EQL, token.NEQ:\n161|\t\t\t\t\tdefault:\n162|\t\t\t\t\t\treturn true\n163|\t\t\t\t\t}\n164|\t\t\t\t\tif !hasLenCall(comparison) {\n165|\t\t\t\t\t\treturn true\n166|\t\t\t\t\t}\n167|\t\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|len|\" + normalizeBoundNumbers(renderBoundExpr(comparison)))\n168|\t\t\t\t\treturn true\n169|\t\t\t\t})\n170|\t\t\t\treturn true\n171|\t\t\t})\n172|\t\t}\n173|\t}\n174|\tif scanned == 0 {\n175|\t\tt.Fatal(\"bound census scanned zero production files; the scanner is broken, not the package\")\n176|\t}\n177|\treturn ids\n178|}\n179|\n180|// boundMemberOf names the bounded member of one helper call: the\n181|// string-literal member for the require wrappers, the indexed\n182|// member name for direct checks, or the rendered expression when\n183|// the call bounds a computed value (element, identifier,\n184|// members[name]).\n185|func boundMemberOf(call *ast.CallExpr, helper string) string {\n186|\tif len(call.Args) == 0 {\n187|\t\treturn \"noargs\"\n188|\t}\n189|\tvar first ast.Expr\n190|\tif helper == \"requireStringBounds\" || helper == \"requireUint53Bounds\" {\n191|\t\tif len(call.Args) < 2 {\n192|\t\t\treturn \"short\"\n193|\t\t}\n194|\t\tfirst = call.Args[1]\n195|\t} else {\n196|\t\tfirst = call.Args[0]\n197|\t}\n198|\tif literal, ok := first.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n199|\t\treturn literal.Value\n200|\t}\n(more lines below)"}}}
