e package\")\n-\t}\n-\treturn ids\n-}\n+\t\tids = append(ids, identityGatesInSyntax(syntax, name)...)\n+\t}\n+\tif scanned == 0 {\n+\t\tt.Fatal(\"identity census scanned zero production files; the scanner is broken, not the package\")\n+\t}\n+\treturn ids\n+}\n+\n+// identityGatesInSyntax derives the gate identities of one parsed\n+// production file: every != and == domain comparison with the\n+// mechanical classes excluded. Both operators share the exclusion\n+// set, so neither spelling can hide from the roster. Ordinals\n+// disambiguate repeated spellings inside one function.\n+func identityGatesInSyntax(syntax *ast.File, name string) []string {\n+\tvar ids []string\n+\tfor _, declaration := range syntax.Decls {\n+\t\tfunction, ok := declaration.(*ast.FuncDecl)\n+\t\tif !ok || function.Body == nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tordinal := map[string]int{}\n+\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n+\t\t\tcomparison, ok := node.(*ast.BinaryExpr)\n+\t\t\tif !ok || (comparison.Op != token.NEQ && comparison.Op != token.EQL) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tif isNilIdent(comparison.X) || isNilIdent(comparison.Y) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tif isErrIdent(comparison.X) || isErrIdent(comparison.Y) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tif isEOFSelector(comparison.X) || isEOFSelector(comparison.Y) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tif hasRuneLiteral(comparison) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tif hasLenCall(comparison) {\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tbase := name + \"|\" + function.Name.Name + \"|\" + renderBoundExpr(comparison)\n+\t\t\tids = append(ids, base+\"|\"+strconv.Itoa(ordinal[base]))\n+\t\t\tordinal[base]++\n+\t\t\treturn true\n+\t\t})\n+\t}\n+\treturn ids\n+}\n"}}}
