tring]int{}\n109|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n110|\t\t\t\tcomparison, ok := node.(*ast.BinaryExpr)\n111|\t\t\t\tif !ok || comparison.Op != token.NEQ {\n112|\t\t\t\t\treturn true\n113|\t\t\t\t}\n114|\t\t\t\tif isNilIdent(comparison.X) || isNilIdent(comparison.Y) {\n115|\t\t\t\t\treturn true\n116|\t\t\t\t}\n117|\t\t\t\tif isErrIdent(comparison.X) || isErrIdent(comparison.Y) {\n118|\t\t\t\t\treturn true\n119|\t\t\t\t}\n120|\t\t\t\tif isEOFSelector(comparison.X) || isEOFSelector(comparison.Y) {\n121|\t\t\t\t\treturn true\n122|\t\t\t\t}\n123|\t\t\t\tif hasRuneLiteral(comparison) {\n124|\t\t\t\t\treturn true\n125|\t\t\t\t}\n126|\t\t\t\tif hasLenCall(comparison) {\n127|\t\t\t\t\treturn true\n128|\t\t\t\t}\n129|\t\t\t\tbase := name + \"|\" + function.Name.Name + \"|\" + renderBoundExpr(comparison)\n130|\t\t\t\tids = append(ids, base+\"|\"+strconv.Itoa(ordinal[base]))\n131|\t\t\t\tordinal[base]++\n132|\t\t\t\treturn true\n133|\t\t\t})\n134|\t\t}\n135|\t}\n136|\tif scanned == 0 {\n137|\t\tt.Fatal(\"identity census scanned zero production files; the scanner is broken, not the package\")\n138|\t}\n139|\treturn ids\n140|}\n141|\n142|// isNilIdent reports whether the expression is the nil identifier.\n143|func isNilIdent(node ast.Expr) bool {\n144|\tident, ok := node.(*ast.Ident)\n145|\treturn ok && ident.Name == \"nil\"\n146|}\n147|\n148|// isErrIdent reports whether the expression is an error plumbing\n149|// identifier rather than a domain fact.\n150|func isErrIdent(node ast.Expr) bool {\n151|\tident, ok := node.(*ast.Ident)\n152|\treturn ok && (ident.Name == \"err\" || ident.Name == \"fault\" || ident.Name == \"faultErr\")\n(more lines below)"}}}
