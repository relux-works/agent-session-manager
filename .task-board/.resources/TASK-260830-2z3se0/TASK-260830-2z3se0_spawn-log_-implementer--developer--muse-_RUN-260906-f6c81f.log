{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ab","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":304,"recorded_at":1780531400000603,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"task_stream":{"kind":"task","id":"1b75a8ba-e2b5-448c-99cf-1c9765d487eb"},"task_id":"1b75a8ba-e2b5-448c-99cf-1c9765d487eb","event":{"kind":"output","task_id":"1b75a8ba-e2b5-448c-99cf-1c9765d487eb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/identity_census_test.go`.\n1|package sessadapter\n2|\n3|// This file is the identity-gate census (review rev4 B7). It exists\n4|// because the zero-value / absent-fact class was closed three\n5|// times as a site list (4, then 5, then 13 sites) while the class\n6|// stayed open: TestEnvelopeEchoEmptyStringRefuses derives its rows\n7|// from three envelopes with a tripwire that forbids growth, so it\n8|// cannot reach DecodeProbe's schema echo — the identical two lines\n9|// as DecodeManifest's pinned echo — nor CheckProbe, Discover,\n10|// CheckTupleAdmission, or VerifyRequestDigest.\n11|//\n12|// Shape, modelled on TestClosedVocabularyTablesAreRegistered:\n13|// scanIdentityGateIDs derives every X != Y refusal comparison\n14|// from production source (excluding error, nil, EOF, delimiter,\n15|// and length plumbing), and TestIdentityGatesAreCensused requires\n16|// the derived multiset to equal identityRegistrations exactly. A\n17|// new identity gate with no row fails the census; a removed gate\n18|// orphans its row. Map-presence defaults (!present) live in\n19|// presenceRegistrations with a structural fail-closed proof plus\n20|// behavioral drivers. An empty scan fails closed, and canaries\n21|// from the review traversal guard scanner blindness.\n22|//\n23|// Every non-exempt row names its driver: the committed test\n24|// refusing the zero/absent fact at the exported entry, on the\n25|// side the mutant would exempt. Struct-taking gates (CheckProbe,\n26|// CheckTupleAdmission, CheckBindingEquality) are driven with\n27|// struct literals; bytes-reachable gates (DecodeProbe schema)\n28|// through raw bodies. Where honest decode makes a zero\n29|// unreachable, the row is an explicit exemption naming the\n30|// upstream guard — checkValidateResult's mode echo (vocabulary\n31|// gate at operations.go:1084) is the real example — never a\n32|// silent omission.\n33|//\n34|// Stated bounds: vacuous agreement of two hand-built empty\n35|// structs (an all-zero Probe against all-zero facts) is outside\n36|// the threat model — honest decode never yields empty provider\n37|// identifiers (providerIDPattern) or digests (checkDigest) — and\n38|// stays admitted, documented per row rather than redefined here.\n39|\n40|import (\n41|\t\"go/ast\"\n42|\t\"go/parser\"\n43|\t\"go/token\"\n44|\t\"os\"\n45|\t\"path/filepath\"\n46|\t\"sort\"\n47|\t\"strconv\"\n48|\t\"strings\"\n49|\t\"testing\"\n50|)\n51|\n52|// identityRegistration is one production identity gate with its\n53|// proof: the behavioral zero-row driver, or an explicit\n54|// exemption. domain groups rows for sibling tripwires.\n55|type identityRegistration struct {\n56|\tid     string\n57|\tdriver string\n58|\tdomain string\n59|\texempt bool\n60|\treason string\n61|}\n62|\n63|// scanIdentityGateIDs derives every X != Y comparison from\n64|// production source, excluding the mechanical classes: error and\n65|// fault checks, nil presence, io.EOF framing, rune delimiters\n66|// and escapes, and length comparisons (rostered by the bound\n67|// census instead).\n68|func scanIdentityGateIDs(t *testing.T, directory string) []string {\n69|\tt.Helper()\n70|\tentries, err := os.ReadDir(directory)\n71|\tif err != nil {\n72|\t\tt.Fatalf(\"identity census: %v\", err)\n73|\t}\n74|\tvar ids []string\n75|\tscanned := 0\n76|\tfor _, entry := range entries {\n77|\t\tname := entry.Name()\n78|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n79|\t\t\tcontinue\n80|\t\t}\n81|\t\tscanned++\n82|\t\tpath := filepath.Join(directory, name)\n83|\t\tsource, err := os.ReadFile(path)\n84|\t\tif err != nil {\n85|\t\t\tt.Fatalf(\"identity census: %v\", err)\n86|\t\t}\n87|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n88|\t\tif err != nil {\n89|\t\t\tt.Fatalf(\"identity census: %v\", err)\n90|\t\t}\n91|\t\tfor _, declaration := range syntax.Decls {\n92|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n93|\t\t\tif !ok || function.Body == nil {\n94|\t\t\t\tcontinue\n95|\t\t\t}\n96|\t\t\tordinal := map[string]int{}\n97|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n98|\t\t\t\tcomparison, ok := node.(*ast.BinaryExpr)\n99|\t\t\t\tif !ok || comparison.Op != token.NEQ {\n100|\t\t\t\t\treturn true\n101|\t\t\t\t}\n102|\t\t\t\tif isNilIdent(comparison.X) || isNilIdent(comparison.Y) {\n103|\t\t\t\t\treturn true\n104|\t\t\t\t}\n105|\t\t\t\tif isErrIdent(comparison.X) || isErrIdent(comparison.Y) {\n106|\t\t\t\t\treturn true\n107|\t\t\t\t}\n108|\t\t\t\tif isEOFSelector(comparison.X) || isEOFSelector(comparison.Y) {\n109|\t\t\t\t\treturn true\n110|\t\t\t\t}\n111|\t\t\t\tif hasRuneLiteral(comparison) {\n112|\t\t\t\t\treturn true\n113|\t\t\t\t}\n114|\t\t\t\tif hasLenCall(comparison) {\n115|\t\t\t\t\treturn true\n116|\t\t\t\t}\n117|\t\t\t\tbase := name + \"|\" + function.Name.Name + \"|\" + renderBoundExpr(comparison)\n118|\t\t\t\tids = append(ids, base+\"|\"+strconv.Itoa(ordinal[base]))\n119|\t\t\t\tordinal[base]++\n120|\t\t\t\treturn true\n121|\t\t\t})\n122|\t\t}\n123|\t}\n124|\tif scanned == 0 {\n125|\t\tt.Fatal(\"identity census scanned zero production files; the scanner is broken, not the package\")\n126|\t}\n127|\treturn ids\n128|}\n129|\n130|// isNilIdent reports whether the expression is the nil identifier.\n131|func isNilIdent(node ast.Expr) bool {\n132|\tident, ok := node.(*ast.Ident)\n133|\treturn ok && ident.Name == \"nil\"\n134|}\n135|\n136|// isErrIdent reports whether the expression is an error plumbing\n137|// identifier rather than a domain fact.\n138|func isErrIdent(node ast.Expr) bool {\n139|\tident, ok := node.(*ast.Ident)\n140|\treturn ok && (ident.Name == \"err\" || ident.Name == \"fault\" || ident.Name == \"faultErr\")\n141|}\n142|\n143|// isEOFSelector reports whether the expression is io.EOF.\n144|func isEOFSelector(node ast.Expr) bool {\n145|\tselector, ok := node.(*ast.SelectorExpr)\n146|\tif !ok || selector.Sel.Name != \"EOF\" {\n147|\t\treturn false\n148|\t}\n149|\tident, ok := selector.X.(*ast.Ident)\n150|\treturn ok && ident.Name == \"io\"\n151|}\n152|\n153|// hasRuneLiteral reports whether the subtree holds a rune\n154|// literal: wire delimiters and escapes, not domain facts.\n155|func hasRuneLiteral(node ast.Node) bool {\n156|\tfound := false\n157|\tast.Inspect(node, func(inner ast.Node) bool {\n158|\t\tliteral, ok := inner.(*ast.BasicLit)\n159|\t\tif ok && literal.Kind == token.CHAR {\n160|\t\t\tfound = true\n161|\t\t\treturn false\n162|\t\t}\n163|\t\treturn true\n164|\t})\n165|\treturn found\n166|}\n167|\n168|// identityRegistrations rosters every derived gate. domain\n169|// \"envelope-echo\" feeds the TestEnvelopeEchoEmptyStringRefuses\n170|// tripwire so that table cannot go stale.\n171|var identityRegistrations = []identityRegistration{\n172|\t// context.go.\n173|\t{id: `context.go|CheckFreshSink|authority.Mode != \"fresh_sink\"|0`, exempt: true, reason: \"dispatch, not a refusal: mode comes from validObjectMode, so \\\"\\\" is refused upstream\"},\n174|\t{id: `context.go|DecodeSourceSelector|count != 1|0`, driver: \"TestDecodeSourceSelectorComplement\", reason: \"exactly-one selector via none/all combos\"},\n175|\t{id: `context.go|VerifyRequestDigest|digest.String() != context.RequestDigest|0`, driver: \"TestIdentityZeroRows\", reason: \"zero request digest refuses at VerifyRequestDigest\"},\n176|\t// discovery.go: the sealed binding. Zero flips on both sides\n177|\t// are driven; non-zero flips were already pinned by\n178|\t// TestBindingEqualityFlipsEveryFact.\n179|\t{id: `discovery.go|CheckBindingEquality|sealed.AdapterManifestDigest != fresh.AdapterManifestDigest|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal adapter digest zero refuses\"},\n180|\t{id: `discovery.go|CheckBindingEquality|sealed.CandidateKind != fresh.CandidateKind|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal kind zero refuses\"},\n181|\t{id: `discovery.go|CheckBindingEquality|sealed.ExecutablePath != fresh.ExecutablePath|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal path zero refuses\"},\n182|\t{id: `discovery.go|CheckBindingEquality|sealed.ExecutableSHA256 != fresh.ExecutableSHA256|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal executable digest zero refuses\"},\n183|\t{id: `discovery.go|CheckBindingEquality|sealed.OwnerIdentity != fresh.OwnerIdentity|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal owner zero refuses\"},\n184|\t{id: `discovery.go|CheckBindingEquality|sealed.ProviderID != fresh.ProviderID|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal provider zero refuses\"},\n185|\t{id: `discovery.go|CheckBindingEquality|sealed.ProviderManifestDigest != fresh.ProviderManifestDigest|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal provider digest zero refuses\"},\n186|\t{id: `discovery.go|CheckBindingEquality|sealed.Role != fresh.Role|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal role zero refuses\"},\n187|\t{id: `discovery.go|CheckCallBinding|context.Environment != admitted|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero admitted tuple; caller side unreachable, tuple always decoded\"},\n188|\t{id: `discovery.go|CheckCallBinding|context.ExecutableSHA256 != binding.ExecutableSHA256|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding digest; caller-side zero driven in call binding caller zeros\"},\n189|\t{id: `discovery.go|CheckCallBinding|context.ManifestDigest != binding.AdapterManifestDigest|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding digest; caller-side zero driven in call binding caller zeros\"},\n190|\t{id: `discovery.go|CheckCallBinding|context.ProviderID != binding.ProviderID|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding provider; caller-side zero driven in call binding caller zeros\"},\n191|\t{id: `discovery.go|CheckCallBinding|role != binding.Role|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding role; caller-side zero driven in call binding caller zeros\"},\n192|\t{id: `discovery.go|Discover|manifest.ProviderID != candidate.ProviderID|0`, driver: \"TestIdentityZeroRows\", domain: \"discover\", reason: \"zero provider on either side refuses at Discover\"},\n193|\t// manifest.go: schema echoes pinned by the null-member rows,\n194|\t// registry elements by the mutation suite.\n195|\t{id: `manifest.go|DecodeManifest|schema != manifestSchema|0`, driver: \"TestDecodeManifestClosedMemberRules\", domain: \"manifest-echo\", reason: \"null schema row\"},\n196|\t{id: `manifest.go|DecodeManifest|version != manifestSchemaVersion|0`, driver: \"TestDecodeManifestClosedMemberRules\", domain: \"manifest-echo\", reason: \"null schema_version row\"},\n197|\t{id: `manifest.go|checkCapabilityRegistry|name != capabilityOrder[index]|0`, driver: \"TestRegistryElementEmptyRefuses\", reason: \"empty capability name refuses; order pinned by TestDecodeManifestRegistryMutations\"},\n198|\t{id: `manifest.go|checkOperationRegistry|name != string(operationOrder[index])|0`, driver: \"TestRegistryElementEmptyRefuses\", reason: \"empty operation name refuses; order pinned by TestDecodeManifestRegistryMutations\"},\n199|\t// operations.go.\n200|\t{id: `operations.go|checkExcludedClasses|previous != \"\"|0`, exempt: true, reason: \"first-iteration sortedness sentinel, not a fact gate; class vocabulary refuses \\\"\\\" upstream\"},\n(more lines below)"}}}
