..128\"},\n391|\t{id: `tuple.go|decodeStrategies|len|len(elements) == N|0`, driver: \"TestStrategiesEmptyRefuses\", reason: \"strategies lower edge\"},\n392|}\n393|\n394|// boundCensusCanaries are survivor sites from the review traversal\n395|// that the scanner must see. If any is absent from the derived\n396|// set, the scanner is blind in exactly the direction the census\n397|// exists to measure, and the census fails rather than reporting\n398|// a short denominator as complete.\n399|var boundCensusCanaries = []string{\n400|\t`operations.go|checkRequestScalars|requireStringBounds|\"cursor\"`,\n401|\t`operations.go|checkSuccessScalars|requireStringBounds|\"cwd_relative\"`,\n402|\t`operations.go|checkRequestScalars|requireStringBounds|\"expected_target_native_session_id\"`,\n403|\t`operations.go|checkSuccessScalars|requireUint53Bounds|\"candidate_count\"`,\n404|\t`probe.go|DecodeProbe|checkSortedUniqueStrings|\"warnings\"`,\n405|\t`decode.go|checkExtensions|len|len(name) > N`,\n406|}\n407|\n408|// TestBoundGuardsAreCensused is the bound census: the derived\n409|// production site multiset must equal the registration multiset.\n410|// An unregistered site fails as unrostered; an orphaned\n411|// registration fails as stale. Every non-exempt row must name a\n412|// driver and every exempt row a rationale.\n413|func TestBoundGuardsAreCensused(t *testing.T) {\n414|\tdirectory, err := os.Getwd()\n415|\tif err != nil {\n416|\t\tt.Fatalf(\"bound census: %v\", err)\n417|\t}\n418|\tderived := scanBoundSiteIDs(t, directory)\n419|\tif len(derived) == 0 {\n420|\t\tt.Fatal(\"bound census derived zero sites; the scanner is broken, not the package\")\n421|\t}\n422|\tderivedCounts := map[string]int{}\n423|\tfor _, id := range derived {\n424|\t\tderivedCounts[id]++\n425|\t}\n426|\tfor _, canary := range boundCensusCanaries {\n427|\t\tfound := false\n428|\t\tfor id := range derivedCounts {\n429|\t\t\tif strings.HasPrefix(id, canary) {\n430|\t\t\t\tfound = true\n431|\t\t\t\tbreak\n432|\t\t\t}\n433|\t\t}\n434|\t\tif !found {\n435|\t\t\tt.Errorf(\"bound census blind to canary %q; the scanner misses the class it must roster\", canary)\n436|\t\t}\n437|\t}\n438|\tregisteredCounts := map[string]int{}\n439|\tseen := map[string]bool{}\n440|\tfor _, row := range boundRegistrations {\n441|\t\tif seen[row.id] {\n442|\t\t\tt.Errorf(\"bound census registers %q twice\", row.id)\n443|\t\t}\n444|\t\tseen[row.id] = true\n445|\t\tregisteredCounts[row.id]++\n446|\t\tif row.driver == \"\" && !row.exempt {\n447|\t\t\tt.Errorf(\"bound census row %q names no driver and no exemption\", row.id)\n448|\t\t}\n449|\t\tif row.exempt && row.reason == \"\" {\n(more lines below)"}}}
