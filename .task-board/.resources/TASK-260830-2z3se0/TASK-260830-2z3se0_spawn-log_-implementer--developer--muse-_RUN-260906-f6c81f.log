{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c5","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":573,"recorded_at":1780531400001141,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e641147ab2abc2a65373fc0a68","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// fixtureValidProbe decodes the fixture probe and returns it with\n10|// the manifest digest the fixture manifest computes to.\n11|func fixtureValidProbe(t *testing.T) (Probe, Manifest) {\n12|\tt.Helper()\n13|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n16|\t}\n17|\tdigest := ManifestDigest(manifest).String()\n18|\tprobe, err := DecodeProbe([]byte(fixtureProbeJSON(digest)))\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"DecodeProbe: %v\", err)\n21|\t}\n22|\treturn probe, manifest\n23|}\n24|\n25|func TestDecodeProbeAcceptsFixture(t *testing.T) {\n26|\tprobe, _ := fixtureValidProbe(t)\n27|\tif len(probe.Capabilities) != 15 {\n28|\t\tt.Fatalf(\"capabilities = %d, want 15\", len(probe.Capabilities))\n29|\t}\n30|\tif probe.ProviderID != fixtureProviderID {\n31|\t\tt.Fatalf(\"ProviderID = %q, want %q\", probe.ProviderID, fixtureProviderID)\n32|\t}\n33|\tif probe.Environment.EnvironmentID != fixtureEnvironmentID {\n34|\t\tt.Fatalf(\"EnvironmentID = %q, want %q\", probe.Environment.EnvironmentID, fixtureEnvironmentID)\n35|\t}\n36|\tfor _, name := range capabilityOrder {\n37|\t\tif !CapabilityUsable(probe, name) {\n38|\t\t\tt.Fatalf(\"CapabilityUsable(%q) = false, want true\", name)\n39|\t\t}\n40|\t}\n41|}\n42|\n43|// TestCapabilityStatusMatrix drives every status/enabled\n44|// combination through the value decoder: only\n45|// available+enabled is usable, and only available permits\n46|// enabled=true. The eight combinations are enumerated, not\n47|// sampled.\n48|func TestCapabilityStatusMatrix(t *testing.T) {\n49|\tfor _, status := range []string{\"available\", \"conditional\", \"unsupported\", \"unknown\"} {\n50|\t\tfor _, enabled := range []bool{false, true} {\n51|\t\t\tname := fmt.Sprintf(\"%s/enabled=%v\", status, enabled)\n52|\t\t\tt.Run(name, func(t *testing.T) {\n53|\t\t\t\tbody := fmt.Sprintf(`{\"status\":%q,\"enabled\":%v,\"evidence\":\"probed\",\"detail\":\"\"}`, status, enabled)\n54|\t\t\t\tprobe, _ := fixtureValidProbe(t)\n55|\t\t\t\t// Rebuild the probe body with one value replaced.\n56|\t\t\t\tfixture := fixtureProbeJSON(probe.ManifestDigest)\n57|\t\t\t\tmutated := replaceCapability(t, []byte(fixture), \"tool_history\", body)\n58|\t\t\t\tredone, err := DecodeProbe(mutated)\n59|\t\t\t\tif enabled && status != \"available\" {\n60|\t\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"without available status\")\n61|\t\t\t\t\treturn\n62|\t\t\t\t}\n63|\t\t\t\tif err != nil {\n64|\t\t\t\t\tt.Fatalf(\"DecodeProbe: %v\", err)\n65|\t\t\t\t}\n66|\t\t\t\twantUsable := status == \"available\" && enabled\n67|\t\t\t\tif CapabilityUsable(redone, \"tool_history\") != wantUsable {\n68|\t\t\t\t\tt.Fatalf(\"CapabilityUsable = %v, want %v\", !wantUsable, wantUsable)\n69|\t\t\t\t}\n70|\t\t\t})\n71|\t\t}\n72|\t}\n73|}\n74|\n75|// replaceCapability swaps one capability value in a probe body.\n76|func replaceCapability(t *testing.T, body []byte, name, value string) []byte {\n77|\tt.Helper()\n78|\tmarker := `\"` + name + `\":` + fixtureCapabilityJSON()\n79|\tif !strings.Contains(string(body), marker) {\n80|\t\tt.Fatalf(\"replaceCapability: %q not in fixture\", name)\n81|\t}\n82|\treturn []byte(strings.Replace(string(body), marker, `\"`+name+`\":`+value, 1))\n83|}\n84|\n85|func TestDecodeProbeClosedRules(t *testing.T) {\n86|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n89|\t}\n90|\tdigest := ManifestDigest(manifest).String()\n91|\tfixture := []byte(fixtureProbeJSON(digest))\n92|\tmembers := []string{\"schema\", \"schema_version\", \"provider_id\", \"adapter_manifest_digest\", \"adapter_version\", \"environment\", \"capabilities\", \"warnings\", \"extensions\"}\n93|\tfor _, member := range members {\n94|\t\tt.Run(\"missing \"+member, func(t *testing.T) {\n95|\t\t\t_, err := DecodeProbe(dropMember(t, fixture, member))\n96|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a required member\")\n97|\t\t})\n98|\t}\n99|\tt.Run(\"unknown member\", func(t *testing.T) {\n100|\t\t_, err := DecodeProbe(appendMember(t, fixture, \"unexpected\", `true`))\n101|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"unexpected\", \"unknown member\")\n102|\t})\n103|\tt.Run(\"omit capability\", func(t *testing.T) {\n104|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"\"}`)\n105|\t\t_ = mutated\n106|\t\tdropped := dropCapability(t, fixture, \"tool_history\")\n107|\t\t_, err := DecodeProbe(dropped)\n108|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"capabilities\", \"exactly fifteen\")\n109|\t})\n110|\tt.Run(\"extra capability\", func(t *testing.T) {\n111|\t\tadded := addCapability(t, fixture, \"gui_clipboard\", fixtureCapabilityJSON())\n112|\t\t_, err := DecodeProbe(added)\n113|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"capabilities\", \"exactly fifteen\")\n114|\t})\n115|\tt.Run(\"bad evidence\", func(t *testing.T) {\n116|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"vibes\",\"detail\":\"\"}`)\n117|\t\t_, err := DecodeProbe(mutated)\n118|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"seven-evidence vocabulary\")\n119|\t})\n120|\tt.Run(\"bad status\", func(t *testing.T) {\n121|\t\t// A fifth status is refused even though the matrix above\n122|\t\t// admits the four closed values: the status gate admits\n123|\t\t// exactly the Section 7.8 union, and a mutant weakening\n124|\t\t// validCapabilityStatus to admit anything fails here.\n125|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"bogus\",\"enabled\":false,\"evidence\":\"probed\",\"detail\":\"\"}`)\n126|\t\t_, err := DecodeProbe(mutated)\n127|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"outside available|conditional|unsupported|unknown\")\n128|\t})\n129|\tt.Run(\"detail too long\", func(t *testing.T) {\n130|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"`+strings.Repeat(\"d\", 2049)+`\"}`)\n131|\t\t_, err := DecodeProbe(mutated)\n132|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"string[0..2048]\")\n133|\t})\n134|\tt.Run(\"unsorted warnings\", func(t *testing.T) {\n135|\t\t_, err := DecodeProbe(mutateMember(t, fixture, \"warnings\", `[\"b\",\"a\"]`))\n136|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"warnings\", \"sorted unique\")\n137|\t})\n138|\tt.Run(\"duplicate warnings\", func(t *testing.T) {\n139|\t\t_, err := DecodeProbe(mutateMember(t, fixture, \"warnings\", `[\"a\",\"a\"]`))\n140|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"warnings\", \"sorted unique\")\n141|\t})\n142|\tt.Run(\"warning too long\", func(t *testing.T) {\n143|\t\t_, err := DecodeProbe(mutateMember(t, fixture, \"warnings\", `[\"`+strings.Repeat(\"w\", 2049)+`\"]`))\n144|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"warnings\", \"sorted unique\")\n145|\t})\n146|}\n147|\n148|// dropCapability removes one capability from a probe body.\n149|func dropCapability(t *testing.T, body []byte, name string) []byte {\n150|\tt.Helper()\n151|\tmarker := `\"` + name + `\":` + fixtureCapabilityJSON() + `,`\n152|\tif strings.Contains(string(body), marker) {\n153|\t\treturn []byte(strings.Replace(string(body), marker, ``, 1))\n154|\t}\n155|\tmarker = `,` + `\"` + name + `\":` + fixtureCapabilityJSON()\n156|\tif strings.Contains(string(body), marker) {\n157|\t\treturn []byte(strings.Replace(string(body), marker, ``, 1))\n158|\t}\n159|\tt.Fatalf(\"dropCapability: %q not in fixture\", name)\n160|\treturn nil\n161|}\n162|\n163|// addCapability inserts one extra capability into a probe body.\n164|func addCapability(t *testing.T, body []byte, name, value string) []byte {\n165|\tt.Helper()\n166|\tmarker := `\"capabilities\":{`\n167|\tif !strings.Contains(string(body), marker) {\n168|\t\tt.Fatalf(\"addCapability: capabilities map not in fixture\")\n169|\t}\n170|\treturn []byte(strings.Replace(string(body), marker, marker+`\"`+name+`\":`+value+`,`, 1))\n171|}\n172|\n173|func TestCheckProbeEqualities(t *testing.T) {\n174|\tprobe, manifest := fixtureValidProbe(t)\n175|\tdigest := ManifestDigest(manifest).String()\n176|\tfacts := ProbeHostFacts{\n177|\t\tExpectedProviderID: fixtureProviderID,\n178|\t\tExpectedKind:       CandidateBuiltin,\n179|\t\tManifestDigest:     digest,\n180|\t\tManifest:           manifest,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c7","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":574,"recorded_at":1780531400001143,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e642287c51be47d5e72d54ae4d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe_test.go`.\n(329 line(s) above)\n330|func TestCheckTargetWriteGates(t *testing.T) {\n331|\tprobe, _ := fixtureValidProbe(t)\n332|\tprovider := map[string]ProviderCapability{\n333|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n334|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n335|\t}\n336|\tif err := CheckTargetWriteGates(probe.Capabilities, provider); err != nil {\n337|\t\tt.Fatalf(\"CheckTargetWriteGates: %v\", err)\n338|\t}\n339|\t// The disjunction: disabling canonical_write alone still\n340|\t// passes through official_import, and vice versa.\n341|\twithoutCanonical := cloneCapabilities(probe.Capabilities)\n342|\twithoutCanonical[\"canonical_write\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n343|\tif err := CheckTargetWriteGates(withoutCanonical, provider); err != nil {\n344|\t\tt.Fatalf(\"CheckTargetWriteGates without canonical_write: %v\", err)\n345|\t}\n346|\twithoutImport := cloneCapabilities(probe.Capabilities)\n347|\twithoutImport[\"official_import\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n348|\tif err := CheckTargetWriteGates(withoutImport, provider); err != nil {\n349|\t\tt.Fatalf(\"CheckTargetWriteGates without official_import: %v\", err)\n350|\t}\n351|\t// Both members of the pair down: refused, naming the pair.\n352|\twithoutBoth := cloneCapabilities(probe.Capabilities)\n353|\twithoutBoth[\"canonical_write\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n354|\twithoutBoth[\"official_import\"] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n355|\terr := CheckTargetWriteGates(withoutBoth, provider)\n356|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"canonical_write|official_import\", \"neither usable\")\n357|\t// Each remaining required adapter capability is broken alone.\n358|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n359|\t\twithout := cloneCapabilities(probe.Capabilities)\n360|\t\twithout[name] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n361|\t\terr := CheckTargetWriteGates(without, provider)\n362|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", name, \"usable adapter capability\")\n363|\t}\n364|\t// Each provider capability is broken alone, including the\n365|\t// enabled-bit half: available-but-disabled is not usable.\n366|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n367|\t\tunsupported := map[string]ProviderCapability{\n368|\t\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n369|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n370|\t\t}\n371|\t\tunsupported[name] = ProviderCapability{Status: \"unsupported\", Enabled: false}\n372|\t\terr := CheckTargetWriteGates(probe.Capabilities, unsupported)\n373|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:\"+name, \"usable provider capability\")\n374|\t\tdisabled := map[string]ProviderCapability{\n375|\t\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n376|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n377|\t\t}\n378|\t\tdisabled[name] = ProviderCapability{Status: \"available\", Enabled: false}\n379|\t\terr = CheckTargetWriteGates(probe.Capabilities, disabled)\n380|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:\"+name, \"usable provider capability\")\n381|\t}\n382|\t// A missing provider surface is refused, never defaulted.\n383|\tmissing := map[string]ProviderCapability{\n384|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n385|\t}\n386|\terr = CheckTargetWriteGates(probe.Capabilities, missing)\n387|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:native_resume\", \"usable provider capability\")\n388|}\n389|\n390|func cloneCapabilities(capabilities map[string]Capability) map[string]Capability {\n391|\tcloned := make(map[string]Capability, len(capabilities))\n392|\tfor name, value := range capabilities {\n393|\t\tcloned[name] = value\n394|\t}\n395|\treturn cloned\n396|}\n397|\n398|// TestTargetWriteComplementDerivesNonRequired pins the other side\n399|// of the gate: every registry capability outside the required set\n400|// is not required, so a mutant that adds a requirement fails here\n401|// with the complement named.\n402|func TestTargetWriteComplementDerivesNonRequired(t *testing.T) {\n403|\trequired := map[string]bool{\n404|\t\t\"canonical_write\": true, \"official_import\": true,\n405|\t\t\"native_read_back\": true, \"native_resume_plan\": true, \"workspace_binding\": true,\n406|\t\t\"provider:portable_store\": true, \"provider:native_resume\": true,\n407|\t}\n408|\tvar complement []string\n409|\tfor _, name := range capabilityOrder {\n410|\t\tif !required[name] {\n411|\t\t\tcomplement = append(complement, name)\n412|\t\t}\n413|\t}\n414|\tif len(complement) == 0 {\n415|\t\tt.Fatal(\"derived an empty non-required complement; the check is blind\")\n416|\t}\n417|\tprobe, _ := fixtureValidProbe(t)\n418|\tprovider := map[string]ProviderCapability{\n419|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n420|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n421|\t}\n422|\t// Disabling every complement capability at once still passes:\n423|\t// none of them gates a target write.\n424|\tdisabled := cloneCapabilities(probe.Capabilities)\n425|\tfor _, name := range complement {\n426|\t\tdisabled[name] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n427|\t}\n428|\tif err := CheckTargetWriteGates(disabled, provider); err != nil {\n429|\t\tt.Fatalf(\"CheckTargetWriteGates with complement disabled: %v\", err)\n430|\t}\n431|\tt.Logf(\"non-required complement: %d/%d capabilities\", len(complement), len(capabilityOrder))\n432|}\n433|\n434|func TestDoctorRequiredCapabilities(t *testing.T) {\n435|\ttarget := DoctorRequiredCapabilities(DirectionTargetWrite, false)\n436|\tif len(target) != 4 || target[0] != \"canonical_write\" {\n437|\t\tt.Fatalf(\"target required = %v, want [canonical_write native_read_back native_resume_plan workspace_binding]\", target)\n438|\t}\n439|\tofficial := DoctorRequiredCapabilities(DirectionTargetWrite, true)\n440|\tif len(official) != 4 || official[0] != \"official_import\" {\n441|\t\tt.Fatalf(\"official-import required = %v, want official_import first\", official)\n442|\t}\n443|\tif got := DoctorRequiredCapabilities(DirectionSourceRead, false); len(got) != 0 {\n444|\t\tt.Fatalf(\"source required = %v, want empty: Section 7.8 names no source set\", got)\n445|\t}\n446|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
