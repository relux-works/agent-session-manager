{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b7","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":310,"recorded_at":1780531400000615,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e4dedf79d0ace969140eaebc9f","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/identity_census_test.go`.\n1|package sessadapter\n2|\n3|// This file is the identity-gate census (review rev4 B7). It exists\n4|// because the zero-value / absent-fact class was closed three\n5|// times as a site list (4, then 5, then 13 sites) while the class\n6|// stayed open: TestEnvelopeEchoEmptyStringRefuses derives its rows\n7|// from three envelopes with a tripwire that forbids growth, so it\n8|// cannot reach DecodeProbe's schema echo — the identical two lines\n9|// as DecodeManifest's pinned echo — nor CheckProbe, Discover,\n10|// CheckTupleAdmission, or VerifyRequestDigest.\n11|//\n12|// Shape, modelled on TestClosedVocabularyTablesAreRegistered:\n13|// scanIdentityGateIDs derives every X != Y refusal comparison\n14|// from production source (excluding error, nil, EOF, delimiter,\n15|// and length plumbing), and TestIdentityGatesAreCensused requires\n16|// the derived multiset to equal identityRegistrations exactly. A\n17|// new identity gate with no row fails the census; a removed gate\n18|// orphans its row. Map-presence defaults (!present) live in\n19|// presenceRegistrations with a structural fail-closed proof plus\n20|// behavioral drivers. An empty scan fails closed, and canaries\n21|// from the review traversal guard scanner blindness.\n22|//\n23|// Every non-exempt row names its driver: the committed test\n24|// refusing the zero/absent fact at the exported entry, on the\n25|// side the mutant would exempt. Struct-taking gates (CheckProbe,\n26|// CheckTupleAdmission, CheckBindingEquality) are driven with\n27|// struct literals; bytes-reachable gates (DecodeProbe schema)\n28|// through raw bodies. Where honest decode makes a zero\n29|// unreachable, the row is an explicit exemption naming the\n30|// upstream guard — checkValidateResult's mode echo (vocabulary\n31|// gate at operations.go:1084) is the real example — never a\n32|// silent omission.\n33|//\n34|// Stated bounds: vacuous agreement of two hand-built empty\n35|// structs (an all-zero Probe against all-zero facts) is outside\n36|// the threat model — honest decode never yields empty provider\n37|// identifiers (providerIDPattern) or digests (checkDigest) — and\n38|// stays admitted, documented per row rather than redefined here.\n39|\n40|import (\n41|\t\"go/ast\"\n42|\t\"go/parser\"\n43|\t\"go/token\"\n44|\t\"os\"\n45|\t\"path/filepath\"\n46|\t\"sort\"\n47|\t\"strconv\"\n48|\t\"strings\"\n49|\t\"testing\"\n50|)\n51|\n52|// identityRegistration is one production identity gate with its\n53|// proof: the behavioral zero-row driver, or an explicit\n54|// exemption. domain groups rows for sibling tripwires.\n55|type identityRegistration struct {\n56|\tid     string\n57|\tdriver string\n58|\tdomain string\n59|\texempt bool\n60|\treason string\n61|}\n62|\n63|// scanIdentityGateIDs derives every X != Y comparison from\n64|// production source, excluding the mechanical classes: error and\n65|// fault checks, nil presence, io.EOF framing, rune delimiters\n66|// and escapes, and length comparisons (rostered by the bound\n67|// census instead).\n68|func scanIdentityGateIDs(t *testing.T, directory string) []string {\n69|\tt.Helper()\n70|\tentries, err := os.ReadDir(directory)\n71|\tif err != nil {\n72|\t\tt.Fatalf(\"identity census: %v\", err)\n73|\t}\n74|\tvar ids []string\n75|\tscanned := 0\n76|\tfor _, entry := range entries {\n77|\t\tname := entry.Name()\n78|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n79|\t\t\tcontinue\n80|\t\t}\n81|\t\tscanned++\n82|\t\tpath := filepath.Join(directory, name)\n83|\t\tsource, err := os.ReadFile(path)\n84|\t\tif err != nil {\n85|\t\t\tt.Fatalf(\"identity census: %v\", err)\n86|\t\t}\n87|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n88|\t\tif err != nil {\n89|\t\t\tt.Fatalf(\"identity census: %v\", err)\n90|\t\t}\n91|\t\tfor _, declaration := range syntax.Decls {\n92|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n93|\t\t\tif !ok || function.Body == nil {\n94|\t\t\t\tcontinue\n95|\t\t\t}\n96|\t\t\tordinal := map[string]int{}\n97|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n98|\t\t\t\tcomparison, ok := node.(*ast.BinaryExpr)\n99|\t\t\t\tif !ok || comparison.Op != token.NEQ {\n100|\t\t\t\t\treturn true\n101|\t\t\t\t}\n102|\t\t\t\tif isNilIdent(comparison.X) || isNilIdent(comparison.Y) {\n103|\t\t\t\t\treturn true\n104|\t\t\t\t}\n105|\t\t\t\tif isErrIdent(comparison.X) || isErrIdent(comparison.Y) {\n106|\t\t\t\t\treturn true\n107|\t\t\t\t}\n108|\t\t\t\tif isEOFSelector(comparison.X) || isEOFSelector(comparison.Y) {\n109|\t\t\t\t\treturn true\n110|\t\t\t\t}\n111|\t\t\t\tif hasRuneLiteral(comparison) {\n112|\t\t\t\t\treturn true\n113|\t\t\t\t}\n114|\t\t\t\tif hasLenCall(comparison) {\n115|\t\t\t\t\treturn true\n116|\t\t\t\t}\n117|\t\t\t\tbase := name + \"|\" + function.Name.Name + \"|\" + renderBoundExpr(comparison)\n118|\t\t\t\tids = append(ids, base+\"|\"+strconv.Itoa(ordinal[base]))\n119|\t\t\t\tordinal[base]++\n120|\t\t\t\treturn true\n121|\t\t\t})\n122|\t\t}\n123|\t}\n124|\tif scanned == 0 {\n125|\t\tt.Fatal(\"identity census scanned zero production files; the scanner is broken, not the package\")\n126|\t}\n127|\treturn ids\n128|}\n129|\n130|// isNilIdent reports whether the expression is the nil identifier.\n131|func isNilIdent(node ast.Expr) bool {\n132|\tident, ok := node.(*ast.Ident)\n133|\treturn ok && ident.Name == \"nil\"\n134|}\n135|\n136|// isErrIdent reports whether the expression is an error plumbing\n137|// identifier rather than a domain fact.\n138|func isErrIdent(node ast.Expr) bool {\n139|\tident, ok := node.(*ast.Ident)\n140|\treturn ok && (ident.Name == \"err\" || ident.Name == \"fault\" || ident.Name == \"faultErr\")\n141|}\n142|\n143|// isEOFSelector reports whether the expression is io.EOF.\n144|func isEOFSelector(node ast.Expr) bool {\n145|\tselector, ok := node.(*ast.SelectorExpr)\n146|\tif !ok || selector.Sel.Name != \"EOF\" {\n147|\t\treturn false\n148|\t}\n149|\tident, ok := selector.X.(*ast.Ident)\n150|\treturn ok && ident.Name == \"io\"\n151|}\n152|\n153|// hasRuneLiteral reports whether the subtree holds a rune\n154|// literal: wire delimiters and escapes, not domain facts.\n155|func hasRuneLiteral(node ast.Node) bool {\n156|\tfound := false\n157|\tast.Inspect(node, func(inner ast.Node) bool {\n158|\t\tliteral, ok := inner.(*ast.BasicLit)\n159|\t\tif ok && literal.Kind == token.CHAR {\n160|\t\t\tfound = true\n161|\t\t\treturn false\n162|\t\t}\n163|\t\treturn true\n164|\t})\n165|\treturn found\n166|}\n167|\n168|// identityRegistrations rosters every derived gate. domain\n169|// \"envelope-echo\" feeds the TestEnvelopeEchoEmptyStringRefuses\n170|// tripwire so that table cannot go stale.\n171|var identityRegistrations = []identityRegistration{\n172|\t// context.go.\n173|\t{id: `context.go|CheckFreshSink|authority.Mode != \"fresh_sink\"|0`, exempt: true, reason: \"dispatch, not a refusal: mode comes from validObjectMode, so \\\"\\\" is refused upstream\"},\n174|\t{id: `context.go|DecodeSourceSelector|count != 1|0`, driver: \"TestDecodeSourceSelectorComplement\", reason: \"exactly-one selector via none/all combos\"},\n175|\t{id: `context.go|VerifyRequestDigest|digest.String() != context.RequestDigest|0`, driver: \"TestIdentityZeroRows\", reason: \"zero request digest refuses at VerifyRequestDigest\"},\n176|\t// discovery.go: the sealed binding. Zero flips on both sides\n177|\t// are driven; non-zero flips were already pinned by\n178|\t// TestBindingEqualityFlipsEveryFact.\n179|\t{id: `discovery.go|CheckBindingEquality|sealed.AdapterManifestDigest != fresh.AdapterManifestDigest|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal adapter digest zero refuses\"},\n180|\t{id: `discovery.go|CheckBindingEquality|sealed.CandidateKind != fresh.CandidateKind|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal kind zero refuses\"},\n181|\t{id: `discovery.go|CheckBindingEquality|sealed.ExecutablePath != fresh.ExecutablePath|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal path zero refuses\"},\n182|\t{id: `discovery.go|CheckBindingEquality|sealed.ExecutableSHA256 != fresh.ExecutableSHA256|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal executable digest zero refuses\"},\n183|\t{id: `discovery.go|CheckBindingEquality|sealed.OwnerIdentity != fresh.OwnerIdentity|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal owner zero refuses\"},\n184|\t{id: `discovery.go|CheckBindingEquality|sealed.ProviderID != fresh.ProviderID|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal provider zero refuses\"},\n185|\t{id: `discovery.go|CheckBindingEquality|sealed.ProviderManifestDigest != fresh.ProviderManifestDigest|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal provider digest zero refuses\"},\n186|\t{id: `discovery.go|CheckBindingEquality|sealed.Role != fresh.Role|0`, driver: \"TestBindingEqualityZeroFactsRefuse\", domain: \"seal\", reason: \"seal role zero refuses\"},\n187|\t{id: `discovery.go|CheckCallBinding|context.Environment != admitted|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero admitted tuple; caller side unreachable, tuple always decoded\"},\n188|\t{id: `discovery.go|CheckCallBinding|context.ExecutableSHA256 != binding.ExecutableSHA256|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding digest; caller-side zero driven in call binding caller zeros\"},\n189|\t{id: `discovery.go|CheckCallBinding|context.ManifestDigest != binding.AdapterManifestDigest|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding digest; caller-side zero driven in call binding caller zeros\"},\n190|\t{id: `discovery.go|CheckCallBinding|context.ProviderID != binding.ProviderID|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding provider; caller-side zero driven in call binding caller zeros\"},\n191|\t{id: `discovery.go|CheckCallBinding|role != binding.Role|0`, driver: \"TestCheckCallBindingZeroFactsRefuse\", domain: \"binding\", reason: \"zero binding role; caller-side zero driven in call binding caller zeros\"},\n192|\t{id: `discovery.go|Discover|manifest.ProviderID != candidate.ProviderID|0`, driver: \"TestIdentityZeroRows\", domain: \"discover\", reason: \"zero provider on either side refuses at Discover\"},\n193|\t// manifest.go: schema echoes pinned by the null-member rows,\n194|\t// registry elements by the mutation suite.\n195|\t{id: `manifest.go|DecodeManifest|schema != manifestSchema|0`, driver: \"TestDecodeManifestClosedMemberRules\", domain: \"manifest-echo\", reason: \"null schema row\"},\n196|\t{id: `manifest.go|DecodeManifest|version != manifestSchemaVersion|0`, driver: \"TestDecodeManifestClosedMemberRules\", domain: \"manifest-echo\", reason: \"null schema_version row\"},\n197|\t{id: `manifest.go|checkCapabilityRegistry|name != capabilityOrder[index]|0`, driver: \"TestRegistryElementEmptyRefuses\", reason: \"empty capability name refuses; order pinned by TestDecodeManifestRegistryMutations\"},\n198|\t{id: `manifest.go|checkOperationRegistry|name != string(operationOrder[index])|0`, driver: \"TestRegistryElementEmptyRefuses\", reason: \"empty operation name refuses; order pinned by TestDecodeManifestRegistryMutations\"},\n199|\t// operations.go.\n200|\t{id: `operations.go|checkExcludedClasses|previous != \"\"|0`, exempt: true, reason: \"first-iteration sortedness sentinel, not a fact gate; class vocabulary refuses \\\"\\\" upstream\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b9","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":311,"recorded_at":1780531400000617,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e4dfcb71918ba93fbc7450be91","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bound_census_test.go`.\n1|package sessadapter\n2|\n3|// This file is the bound census (review rev4 B8). It exists because a\n4|// new bound through any of the six helpers — checkStringBounds,\n5|// requireStringBounds, checkUint53Bounds, requireUint53Bounds,\n6|// checkSortedUniqueStrings, checkSortedUniqueDigests — or a new\n7|// explicit len(...) guard passes every behavioral test that never\n8|// names it, and pinning checkStringBounds while requireStringBounds\n9|// goes unmeasured reads as complete at 35 of 35 while half the\n10|// class stays open.\n11|//\n12|// The mechanism note: requireStringBounds is a transparent wrapper\n13|// over checkStringBounds (operations.go, declared 100 lines above\n14|// the pinned sites) carrying 13 of the production call sites, and\n15|// requireUint53Bounds the same over checkUint53Bounds. Both\n16|// wrappers are rostered below as mechanism rows: they forward\n17|// their min/max to the shared checker, so their values are pinned\n18|// at the caller rows, not at the wrapper.\n19|//\n20|// Shape, modelled on TestClosedVocabularyTablesAreRegistered:\n21|// scanBoundSiteIDs derives every bound site from production source\n22|// (helper calls with their member, len guards in if conditions,\n23|// DecodeFindings cap instantiations), and\n24|// TestBoundGuardsAreCensused requires the derived multiset to\n25|// equal boundRegistrations exactly. A new bound with no row fails\n26|// the census; a removed bound orphans its row and fails too. An\n27|// empty scan fails closed. Site identity is file|function|member,\n28|// never the bound values: a moved bound (+1) keeps its identity\n29|// and must redden its behavioral driver, which the mutant battery\n30|// proves per row.\n31|//\n32|// Every non-exempt row names its driver: the committed test\n33|// driving min-1/min/max/max+1 (or the applicable edges) through\n34|// the production entry. Exempt rows say why: equivalent (the\n35|// bound is unreachable behind an upstream gate), stated-bound\n36|// (a 65537-element body), mechanism (transparent forwarder or\n37|// generic guard whose values live at the caller rows), or\n38|// plumbing (byte-scanner loop guards pinned by the surrogate\n39|// agreement suite).\n40|//\n41|// Stated bounds of this census: cross-field relational gates\n42|// (maxObjects > maxTotalBytes and its sibling in\n43|// DecodeResourceLimits) are not edge-valued sites and are pinned\n44|// behaviourally by TestDecodeResourceLimitsBounds instead; the\n45|// maxUint53 maxima are representability bounds pinned once by\n46|// TestUint53RepresentabilityCeiling rather than per site.\n47|\n48|import (\n49|\t\"bytes\"\n50|\t\"encoding/json\"\n51|\t\"fmt\"\n52|\t\"go/ast\"\n53|\t\"go/parser\"\n54|\t\"go/printer\"\n55|\t\"go/token\"\n56|\t\"os\"\n57|\t\"path/filepath\"\n58|\t\"sort\"\n59|\t\"strconv\"\n60|\t\"strings\"\n61|\t\"testing\"\n62|)\n63|\n64|// boundRegistration is one production bound site with its proof:\n65|// the behavioral driver covering its edges, or an explicit\n66|// exemption with its rationale.\n67|type boundRegistration struct {\n68|\tid     string\n69|\tdriver string\n70|\texempt bool\n71|\treason string\n72|}\n73|\n74|// boundHelpers is the closed helper set the census derives. A\n75|// seventh bound helper with no row here fails the census only if\n76|// it is called; the call-shape derivation below names the helper\n77|// per site, so an unrostered helper surfaces as unregistered\n78|// sites.\n79|var boundHelpers = map[string]bool{\n80|\t\"checkStringBounds\":        true,\n81|\t\"requireStringBounds\":      true,\n82|\t\"checkUint53Bounds\":        true,\n83|\t\"requireUint53Bounds\":      true,\n84|\t\"checkSortedUniqueStrings\": true,\n85|\t\"checkSortedUniqueDigests\": true,\n86|}\n87|\n88|// scanBoundSiteIDs derives every bound site identity from\n89|// production source: file|function|helper|member|ordinal for the\n90|// six helpers and DecodeFindings instantiations, and\n91|// file|function|len|rendered|ordinal for len guards in if\n92|// conditions. Values are deliberately not part of the identity.\n93|func scanBoundSiteIDs(t *testing.T, directory string) []string {\n94|\tt.Helper()\n95|\tentries, err := os.ReadDir(directory)\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"bound census: %v\", err)\n98|\t}\n99|\tvar ids []string\n100|\tscanned := 0\n101|\tfor _, entry := range entries {\n102|\t\tname := entry.Name()\n103|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n104|\t\t\tcontinue\n105|\t\t}\n106|\t\tscanned++\n107|\t\tpath := filepath.Join(directory, name)\n108|\t\tsource, err := os.ReadFile(path)\n109|\t\tif err != nil {\n110|\t\t\tt.Fatalf(\"bound census: %v\", err)\n111|\t\t}\n112|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n113|\t\tif err != nil {\n114|\t\t\tt.Fatalf(\"bound census: %v\", err)\n115|\t\t}\n116|\t\tfor _, declaration := range syntax.Decls {\n117|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n118|\t\t\tif !ok || function.Body == nil {\n119|\t\t\t\tcontinue\n120|\t\t\t}\n121|\t\t\tordinal := map[string]int{}\n122|\t\t\tclaim := func(base string) {\n123|\t\t\t\tids = append(ids, base+\"|\"+strconv.Itoa(ordinal[base]))\n124|\t\t\t\tordinal[base]++\n125|\t\t\t}\n126|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n127|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n128|\t\t\t\tif !ok {\n129|\t\t\t\t\treturn true\n130|\t\t\t\t}\n131|\t\t\t\tident, ok := call.Fun.(*ast.Ident)\n132|\t\t\t\tif !ok {\n133|\t\t\t\t\treturn true\n134|\t\t\t\t}\n135|\t\t\t\tswitch {\n136|\t\t\t\tcase boundHelpers[ident.Name]:\n137|\t\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|\" + ident.Name + \"|\" + boundMemberOf(call, ident.Name))\n138|\t\t\t\tcase ident.Name == \"DecodeFindings\":\n139|\t\t\t\t\tmember := renderBoundExpr(call.Args[0])\n140|\t\t\t\t\tif index, ok := call.Args[0].(*ast.IndexExpr); ok {\n141|\t\t\t\t\t\tif literal, ok := index.Index.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n142|\t\t\t\t\t\t\tmember = literal.Value\n143|\t\t\t\t\t\t}\n144|\t\t\t\t\t}\n145|\t\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|DecodeFindings|\" + member)\n146|\t\t\t\t}\n147|\t\t\t\treturn true\n148|\t\t\t})\n149|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n150|\t\t\t\tstatement, ok := node.(*ast.IfStmt)\n151|\t\t\t\tif !ok {\n152|\t\t\t\t\treturn true\n153|\t\t\t\t}\n154|\t\t\t\tast.Inspect(statement.Cond, func(inner ast.Node) bool {\n155|\t\t\t\t\tcomparison, ok := inner.(*ast.BinaryExpr)\n156|\t\t\t\t\tif !ok {\n157|\t\t\t\t\t\treturn true\n158|\t\t\t\t\t}\n159|\t\t\t\t\tswitch comparison.Op {\n160|\t\t\t\t\tcase token.GTR, token.GEQ, token.LSS, token.LEQ, token.EQL, token.NEQ:\n161|\t\t\t\t\tdefault:\n162|\t\t\t\t\t\treturn true\n163|\t\t\t\t\t}\n164|\t\t\t\t\tif !hasLenCall(comparison) {\n165|\t\t\t\t\t\treturn true\n166|\t\t\t\t\t}\n167|\t\t\t\t\tclaim(name + \"|\" + function.Name.Name + \"|len|\" + normalizeBoundNumbers(renderBoundExpr(comparison)))\n168|\t\t\t\t\treturn true\n169|\t\t\t\t})\n170|\t\t\t\treturn true\n171|\t\t\t})\n172|\t\t}\n173|\t}\n174|\tif scanned == 0 {\n175|\t\tt.Fatal(\"bound census scanned zero production files; the scanner is broken, not the package\")\n176|\t}\n177|\treturn ids\n178|}\n179|\n180|// boundMemberOf names the bounded member of one helper call: the\n181|// string-literal member for the require wrappers, the indexed\n182|// member name for direct checks, or the rendered expression when\n183|// the call bounds a computed value (element, identifier,\n184|// members[name]).\n185|func boundMemberOf(call *ast.CallExpr, helper string) string {\n186|\tif len(call.Args) == 0 {\n187|\t\treturn \"noargs\"\n188|\t}\n189|\tvar first ast.Expr\n190|\tif helper == \"requireStringBounds\" || helper == \"requireUint53Bounds\" {\n191|\t\tif len(call.Args) < 2 {\n192|\t\t\treturn \"short\"\n193|\t\t}\n194|\t\tfirst = call.Args[1]\n195|\t} else {\n196|\t\tfirst = call.Args[0]\n197|\t}\n198|\tif literal, ok := first.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n199|\t\treturn literal.Value\n200|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a074e4-2b36-7083-b248-59166c4be87c"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5","run_stream":{"kind":"run","id":"bfc095d2-89f8-42f0-9c2e-b6fe72e18de5"},"call_id":"call_01a074e4e06474c3980303c63d619980","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/discovery.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n5|)\n6|\n7|// This file owns Session Adapter discovery. The adapter is not a\n8|// separately discovered plugin: it runs in the same trusted\n9|// ax-provider-<id> executable and under the same host-observed\n10|// executable digest as Provider Protocol 2.0.0. Discovering it\n11|// therefore means binding the adapter manifest the executable\n12|// returned to the independently observed provider candidate —\n13|// same provider identifier, same executable, same digests — and\n14|// sealing that binding so every later call and target mutation can\n15|// be checked against freshly read facts and the Journal binding.\n16|\n17|// Role names one side of a SessionAdapterExecutionBinding. The role\n18|// is call-scoped: a source binding never authorizes a target call.\n19|type Role string\n20|\n21|// The closed role vocabulary.\n22|const (\n23|\tRoleSource Role = \"source\"\n24|\tRoleTarget Role = \"target\"\n25|)\n26|\n27|// roleNames is the closed role vocabulary as a table so the census\n28|// derives it like every other closed vocabulary: Discover compares\n29|// through validRole, never through an inline comparison chain the\n30|// census cannot see. The table is built from the constants above,\n31|// so the two spellings cannot drift.\n32|var roleNames = []string{\n33|\tstring(RoleSource),\n34|\tstring(RoleTarget),\n35|}\n36|\n37|// validRole reports whether the role is one of the two closed\n38|// binding roles.\n39|func validRole(role Role) bool {\n40|\tfor _, allowed := range roleNames {\n41|\t\tif string(role) == allowed {\n42|\t\t\treturn true\n43|\t\t}\n44|\t}\n45|\treturn false\n46|}\n47|\n48|// TrustedCandidate is the independently observed provider\n49|// candidate the adapter must share: the identifier, kind,\n50|// executable path, owner identity, and digests the host observed\n51|// through provider discovery and trust, never through the adapter.\n52|type TrustedCandidate struct {\n53|\tProviderID             string\n54|\tKind                   CandidateKind\n55|\tExecutablePath         string\n56|\tOwnerIdentity          string\n57|\tExecutableSHA256       string\n58|\tProviderManifestDigest string\n59|}\n60|\n61|// ExecutionBinding is one sealed\n62|// SessionAdapterExecutionBinding: role, provider, candidate kind,\n63|// canonical executable path, owner identity, executable digest,\n64|// provider and adapter manifest digests, and the observation time.\n65|// verified_at records when the host observed these facts, not what\n66|// they are: equality compares the eight identity facts, never the\n67|// clock reading, because two reads of one unchanged candidate\n68|// legitimately carry different timestamps.\n69|type ExecutionBinding struct {\n70|\tRole                   Role\n71|\tProviderID             string\n72|\tCandidateKind          CandidateKind\n73|\tExecutablePath         string\n74|\tOwnerIdentity          string\n75|\tExecutableSHA256       string\n76|\tProviderManifestDigest string\n77|\tAdapterManifestDigest  string\n78|\tVerifiedAt             string\n79|}\n80|\n81|// Discover binds one validated adapter manifest to one trusted\n82|// candidate: the manifest's provider identifier must equal the\n83|// candidate's, and the host-computed manifest digest is sealed into\n84|// the binding alongside the candidate's executable facts. A\n85|// well-formed manifest for a different provider is an integrity\n86|// failure, not a usable adapter: agreement with the trusted\n87|// candidate is what makes the manifest this adapter's, and a\n88|// failed or partial observation never means the candidate is\n89|// absent.\n90|func Discover(role Role, manifest Manifest, manifestDigest string, candidate TrustedCandidate) (ExecutionBinding, error) {\n91|\tif !validRole(role) {\n92|\t\tfailure, err := failInvalid(\"discovery role is outside source|target\", \"role\")\n93|\t\tif err != nil {\n94|\t\t\treturn ExecutionBinding{}, err\n95|\t\t}\n96|\t\treturn ExecutionBinding{}, failure\n97|\t}\n98|\tif manifest.ProviderID != candidate.ProviderID {\n99|\t\tfailure, err := failIntegrity(\"adapter manifest provider identifier does not match the trusted candidate\", \"provider_id\")\n100|\t\tif err != nil {\n101|\t\t\treturn ExecutionBinding{}, err\n102|\t\t}\n103|\t\treturn ExecutionBinding{}, failure\n104|\t}\n105|\tif candidate.ExecutablePath == \"\" {\n106|\t\tfailure, err := failInvalid(\"discovery candidate carries no executable path\", \"executable_path\")\n107|\t\tif err != nil {\n108|\t\t\treturn ExecutionBinding{}, err\n109|\t\t}\n110|\t\treturn ExecutionBinding{}, failure\n111|\t}\n112|\tif candidate.OwnerIdentity == \"\" {\n113|\t\tfailure, err := failInvalid(\"discovery candidate carries no owner identity\", \"owner_identity\")\n114|\t\tif err != nil {\n115|\t\t\treturn ExecutionBinding{}, err\n116|\t\t}\n117|\t\treturn ExecutionBinding{}, failure\n118|\t}\n119|\tif _, ok := checkDigestString(candidate.ExecutableSHA256); !ok {\n120|\t\tfailure, err := failInvalid(\"discovery candidate executable digest is not a digest\", \"executable_sha256\")\n121|\t\tif err != nil {\n122|\t\t\treturn ExecutionBinding{}, err\n123|\t\t}\n124|\t\treturn ExecutionBinding{}, failure\n125|\t}\n126|\tif _, ok := checkDigestString(candidate.ProviderManifestDigest); !ok {\n127|\t\tfailure, err := failInvalid(\"discovery candidate provider manifest digest is not a digest\", \"provider_manifest_digest\")\n128|\t\tif err != nil {\n129|\t\t\treturn ExecutionBinding{}, err\n130|\t\t}\n131|\t\treturn ExecutionBinding{}, failure\n132|\t}\n133|\tif _, ok := checkDigestString(manifestDigest); !ok {\n134|\t\tfailure, err := failInvalid(\"discovery adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n135|\t\tif err != nil {\n136|\t\t\treturn ExecutionBinding{}, err\n137|\t\t}\n138|\t\treturn ExecutionBinding{}, failure\n139|\t}\n140|\treturn ExecutionBinding{\n141|\t\tRole:                   role,\n142|\t\tProviderID:             candidate.ProviderID,\n143|\t\tCandidateKind:          candidate.Kind,\n144|\t\tExecutablePath:         candidate.ExecutablePath,\n145|\t\tOwnerIdentity:          candidate.OwnerIdentity,\n146|\t\tExecutableSHA256:       candidate.ExecutableSHA256,\n147|\t\tProviderManifestDigest: candidate.ProviderManifestDigest,\n148|\t\tAdapterManifestDigest:  manifestDigest,\n149|\t\tVerifiedAt:             \"\",\n150|\t}, nil\n151|}\n152|\n153|// checkDigestString reports whether the value parses as a digest of\n154|// the pinned form.\n155|func checkDigestString(value string) (string, bool) {\n156|\tdigest, err := scalar.ParseDigest(value)\n157|\tif err != nil {\n158|\t\treturn \"\", false\n159|\t}\n160|\treturn digest.String(), true\n161|}\n162|\n163|// CheckBindingEquality requires the sealed binding to equal freshly\n164|// read trusted-candidate facts and the Journal binding on all\n165|// eight identity facts. Before every call and every target\n166|// mutation these facts MUST agree; a failed or partial read is an\n167|// integrity failure, and no self-claim or publisher claim\n168|// establishes trust. verified_at is compared by presence only\n169|// when both sides carry it: it timestamps the observation and two\n170|// observations of one unchanged candidate legitimately differ.\n171|func CheckBindingEquality(sealed, fresh ExecutionBinding) error {\n172|\tif sealed.Role != fresh.Role ||\n173|\t\tsealed.ProviderID != fresh.ProviderID ||\n174|\t\tsealed.CandidateKind != fresh.CandidateKind ||\n175|\t\tsealed.ExecutablePath != fresh.ExecutablePath ||\n176|\t\tsealed.OwnerIdentity != fresh.OwnerIdentity ||\n177|\t\tsealed.ExecutableSHA256 != fresh.ExecutableSHA256 ||\n178|\t\tsealed.ProviderManifestDigest != fresh.ProviderManifestDigest ||\n179|\t\tsealed.AdapterManifestDigest != fresh.AdapterManifestDigest {\n180|\t\tfailure, err := failIntegrity(\"session adapter binding no longer equals the freshly read trusted facts\", \"binding\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\treturn nil\n187|}\n188|\n189|// CheckCallBinding requires one state-bearing call's context to\n190|// match its sealed binding and its admitted tuple: the provider\n191|// identifier, both digests, and the environment must equal the\n192|// binding facts and the tuple the registry admitted, and the role\n193|// must equal the call's side. A context answering for another\n194|// provider, another executable, another manifest, or an\n195|// unadmitted tuple is refused before the adapter surface is\n196|// touched.\n197|func CheckCallBinding(binding ExecutionBinding, role Role, context CallContext, admitted Tuple) error {\n198|\tif role != binding.Role {\n199|\t\tfailure, err := failIntegrity(\"adapter call role does not match the sealed binding role\", \"role\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\tif context.ProviderID != binding.ProviderID {\n206|\t\tfailure, err := failIntegrity(\"adapter call provider identifier does not match the sealed binding\", \"provider_id\")\n207|\t\tif err != nil {\n208|\t\t\treturn err\n209|\t\t}\n210|\t\treturn failure\n211|\t}\n212|\tif context.ManifestDigest != binding.AdapterManifestDigest {\n213|\t\tfailure, err := failIntegrity(\"adapter call manifest digest does not match the sealed binding\", \"session_adapter_manifest_digest\")\n214|\t\tif err != nil {\n215|\t\t\treturn err\n216|\t\t}\n217|\t\treturn failure\n218|\t}\n219|\tif context.ExecutableSHA256 != binding.ExecutableSHA256 {\n220|\t\tfailure, err := failIntegrity(\"adapter call executable digest does not match the sealed binding\", \"executable_sha256\")\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\treturn failure\n225|\t}\n226|\tif context.Environment != admitted {\n227|\t\tfailure, err := failUnsupportedTuple(\"adapter call environment is not the admitted tuple\", context.Environment.EnvironmentID)\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\treturn nil\n234|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
