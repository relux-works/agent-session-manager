{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52b","stream":{"kind":"session","id":"01a073f8-9c6c-71e2-bce9-b222228c680e"},"sequence":240,"recorded_at":1780531400000475,"record_type":"event","durability":"durable","causation_id":"c064aec4-d381-4449-af82-c9e09b4adcbf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c064aec4-d381-4449-af82-c9e09b4adcbf","run_stream":{"kind":"run","id":"c064aec4-d381-4449-af82-c9e09b4adcbf"},"call_id":"call_01a073fbbbf97872b7fa2c89939a77d1","text":"{\n  \"chunk_id\": \"exec-13-1\",\n  \"command\": \"task-board worktree checkpoint --help 2>&1 | head -60\",\n  \"description\": \"Inspect checkpoint command\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Checkpoint an accepted Change Request revision.\\n\\nThe accepted candidate tree becomes one internal commit on the Story branch,\\ncreated under a compare-and-swap on the branch tip. The leaf remains integrating:\\nnothing is landed on trunk, and internal checkpoints only delimit later Task\\ndiffs and make the work recoverable before the final Story squash.\\n\\nA Change Request with repository_delta=empty creates no commit — its tree would\\nequal its parent's — and the leaf likewise remains integrating.\\n\\nOnly the tracked integration run bound to the accepted revision's producer role\\nand archetype may run this command. Reviewers, orchestrators, and other producer\\narchetypes are refused.\\n\\nUsage:\\n  task-board worktree checkpoint <ELEMENT-ID> [flags]\\n\\nFlags:\\n  -h, --help   help for checkpoint\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 1396,\n  \"original_output_tokens\": 349,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
