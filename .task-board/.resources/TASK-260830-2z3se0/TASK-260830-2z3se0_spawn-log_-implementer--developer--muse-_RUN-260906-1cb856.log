{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6eb","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":464,"recorded_at":1780531400000923,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a639fb7780918fd7389123b48b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/discovery.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n5|)\n6|\n7|// This file owns Session Adapter discovery. The adapter is not a\n8|// separately discovered plugin: it runs in the same trusted\n9|// ax-provider-<id> executable and under the same host-observed\n10|// executable digest as Provider Protocol 2.0.0. Discovering it\n11|// therefore means binding the adapter manifest the executable\n12|// returned to the independently observed provider candidate —\n13|// same provider identifier, same executable, same digests — and\n14|// sealing that binding so every later call and target mutation can\n15|// be checked against freshly read facts and the Journal binding.\n16|\n17|// Role names one side of a SessionAdapterExecutionBinding. The role\n18|// is call-scoped: a source binding never authorizes a target call.\n19|type Role string\n20|\n21|// The closed role vocabulary.\n22|const (\n23|\tRoleSource Role = \"source\"\n24|\tRoleTarget Role = \"target\"\n25|)\n26|\n27|// roleNames is the closed role vocabulary as a table so the census\n28|// derives it like every other closed vocabulary: Discover compares\n29|// through validRole, never through an inline comparison chain the\n30|// census cannot see. The table is built from the constants above,\n31|// so the two spellings cannot drift.\n32|var roleNames = []string{\n33|\tstring(RoleSource),\n34|\tstring(RoleTarget),\n35|}\n36|\n37|// validRole reports whether the role is one of the two closed\n38|// binding roles.\n39|func validRole(role Role) bool {\n40|\tfor _, allowed := range roleNames {\n41|\t\tif string(role) == allowed {\n42|\t\t\treturn true\n43|\t\t}\n44|\t}\n45|\treturn false\n46|}\n47|\n48|// TrustedCandidate is the independently observed provider\n49|// candidate the adapter must share: the identifier, kind,\n50|// executable path, owner identity, and digests the host observed\n51|// through provider discovery and trust, never through the adapter.\n52|type TrustedCandidate struct {\n53|\tProviderID             string\n54|\tKind                   CandidateKind\n55|\tExecutablePath         string\n56|\tOwnerIdentity          string\n57|\tExecutableSHA256       string\n58|\tProviderManifestDigest string\n59|}\n60|\n61|// ExecutionBinding is one sealed\n62|// SessionAdapterExecutionBinding: role, provider, candidate kind,\n63|// canonical executable path, owner identity, executable digest,\n64|// provider and adapter manifest digests, and the observation time.\n65|// verified_at records when the host observed these facts, not what\n66|// they are: equality compares the eight identity facts, never the\n67|// clock reading, because two reads of one unchanged candidate\n68|// legitimately carry different timestamps.\n69|type ExecutionBinding struct {\n70|\tRole                   Role\n71|\tProviderID             string\n72|\tCandidateKind          CandidateKind\n73|\tExecutablePath         string\n74|\tOwnerIdentity          string\n75|\tExecutableSHA256       string\n76|\tProviderManifestDigest string\n77|\tAdapterManifestDigest  string\n78|\tVerifiedAt             string\n79|}\n80|\n81|// Discover binds one validated adapter manifest to one trusted\n82|// candidate: the manifest's provider identifier must equal the\n83|// candidate's, and the host-computed manifest digest is sealed into\n84|// the binding alongside the candidate's executable facts. A\n85|// well-formed manifest for a different provider is an integrity\n86|// failure, not a usable adapter: agreement with the trusted\n87|// candidate is what makes the manifest this adapter's, and a\n88|// failed or partial observation never means the candidate is\n89|// absent.\n90|func Discover(role Role, manifest Manifest, manifestDigest string, candidate TrustedCandidate) (ExecutionBinding, error) {\n91|\tif !validRole(role) {\n92|\t\tfailure, err := failInvalid(\"discovery role is outside source|target\", \"role\")\n93|\t\tif err != nil {\n94|\t\t\treturn ExecutionBinding{}, err\n95|\t\t}\n96|\t\treturn ExecutionBinding{}, failure\n97|\t}\n98|\tif manifest.ProviderID != candidate.ProviderID {\n99|\t\tfailure, err := failIntegrity(\"adapter manifest provider identifier does not match the trusted candidate\", \"provider_id\")\n100|\t\tif err != nil {\n101|\t\t\treturn ExecutionBinding{}, err\n102|\t\t}\n103|\t\treturn ExecutionBinding{}, failure\n104|\t}\n105|\tif candidate.ExecutablePath == \"\" {\n106|\t\tfailure, err := failInvalid(\"discovery candidate carries no executable path\", \"executable_path\")\n107|\t\tif err != nil {\n108|\t\t\treturn ExecutionBinding{}, err\n109|\t\t}\n110|\t\treturn ExecutionBinding{}, failure\n111|\t}\n112|\tif candidate.OwnerIdentity == \"\" {\n113|\t\tfailure, err := failInvalid(\"discovery candidate carries no owner identity\", \"owner_identity\")\n114|\t\tif err != nil {\n115|\t\t\treturn ExecutionBinding{}, err\n116|\t\t}\n117|\t\treturn ExecutionBinding{}, failure\n118|\t}\n119|\tif _, ok := checkDigestString(candidate.ExecutableSHA256); !ok {\n120|\t\tfailure, err := failInvalid(\"discovery candidate executable digest is not a digest\", \"executable_sha256\")\n121|\t\tif err != nil {\n122|\t\t\treturn ExecutionBinding{}, err\n123|\t\t}\n124|\t\treturn ExecutionBinding{}, failure\n125|\t}\n126|\tif _, ok := checkDigestString(candidate.ProviderManifestDigest); !ok {\n127|\t\tfailure, err := failInvalid(\"discovery candidate provider manifest digest is not a digest\", \"provider_manifest_digest\")\n128|\t\tif err != nil {\n129|\t\t\treturn ExecutionBinding{}, err\n130|\t\t}\n131|\t\treturn ExecutionBinding{}, failure\n132|\t}\n133|\tif _, ok := checkDigestString(manifestDigest); !ok {\n134|\t\tfailure, err := failInvalid(\"discovery adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n135|\t\tif err != nil {\n136|\t\t\treturn ExecutionBinding{}, err\n137|\t\t}\n138|\t\treturn ExecutionBinding{}, failure\n139|\t}\n140|\treturn ExecutionBinding{\n141|\t\tRole:                   role,\n142|\t\tProviderID:             candidate.ProviderID,\n143|\t\tCandidateKind:          candidate.Kind,\n144|\t\tExecutablePath:         candidate.ExecutablePath,\n145|\t\tOwnerIdentity:          candidate.OwnerIdentity,\n146|\t\tExecutableSHA256:       candidate.ExecutableSHA256,\n147|\t\tProviderManifestDigest: candidate.ProviderManifestDigest,\n148|\t\tAdapterManifestDigest:  manifestDigest,\n149|\t\tVerifiedAt:             \"\",\n150|\t}, nil\n151|}\n152|\n153|// checkDigestString reports whether the value parses as a digest of\n154|// the pinned form.\n155|func checkDigestString(value string) (string, bool) {\n156|\tdigest, err := scalar.ParseDigest(value)\n157|\tif err != nil {\n158|\t\treturn \"\", false\n159|\t}\n160|\treturn digest.String(), true\n161|}\n162|\n163|// CheckBindingEquality requires the sealed binding to equal freshly\n164|// read trusted-candidate facts and the Journal binding on all\n165|// eight identity facts. Before every call and every target\n166|// mutation these facts MUST agree; a failed or partial read is an\n167|// integrity failure, and no self-claim or publisher claim\n168|// establishes trust. verified_at is compared by presence only\n169|// when both sides carry it: it timestamps the observation and two\n170|// observations of one unchanged candidate legitimately differ.\n171|func CheckBindingEquality(sealed, fresh ExecutionBinding) error {\n172|\tif sealed.Role != fresh.Role ||\n173|\t\tsealed.ProviderID != fresh.ProviderID ||\n174|\t\tsealed.CandidateKind != fresh.CandidateKind ||\n175|\t\tsealed.ExecutablePath != fresh.ExecutablePath ||\n176|\t\tsealed.OwnerIdentity != fresh.OwnerIdentity ||\n177|\t\tsealed.ExecutableSHA256 != fresh.ExecutableSHA256 ||\n178|\t\tsealed.ProviderManifestDigest != fresh.ProviderManifestDigest ||\n179|\t\tsealed.AdapterManifestDigest != fresh.AdapterManifestDigest {\n180|\t\tfailure, err := failIntegrity(\"session adapter binding no longer equals the freshly read trusted facts\", \"binding\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\treturn nil\n187|}\n188|\n189|// CheckCallBinding requires one state-bearing call's context to\n190|// match its sealed binding and its admitted tuple: the provider\n191|// identifier, both digests, and the environment must equal the\n192|// binding facts and the tuple the registry admitted, and the role\n193|// must equal the call's side. A context answering for another\n194|// provider, another executable, another manifest, or an\n195|// unadmitted tuple is refused before the adapter surface is\n196|// touched.\n197|func CheckCallBinding(binding ExecutionBinding, role Role, context CallContext, admitted Tuple) error {\n198|\tif role != binding.Role {\n199|\t\tfailure, err := failIntegrity(\"adapter call role does not match the sealed binding role\", \"role\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\tif context.ProviderID != binding.ProviderID {\n206|\t\tfailure, err := failIntegrity(\"adapter call provider identifier does not match the sealed binding\", \"provider_id\")\n207|\t\tif err != nil {\n208|\t\t\treturn err\n209|\t\t}\n210|\t\treturn failure\n211|\t}\n212|\tif context.ManifestDigest != binding.AdapterManifestDigest {\n213|\t\tfailure, err := failIntegrity(\"adapter call manifest digest does not match the sealed binding\", \"session_adapter_manifest_digest\")\n214|\t\tif err != nil {\n215|\t\t\treturn err\n216|\t\t}\n217|\t\treturn failure\n218|\t}\n219|\tif context.ExecutableSHA256 != binding.ExecutableSHA256 {\n220|\t\tfailure, err := failIntegrity(\"adapter call executable digest does not match the sealed binding\", \"executable_sha256\")\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\treturn failure\n225|\t}\n226|\tif context.Environment != admitted {\n227|\t\tfailure, err := failUnsupportedTuple(\"adapter call environment is not the admitted tuple\", context.Environment.EnvironmentID)\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\treturn nil\n234|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ed","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":465,"recorded_at":1780531400000925,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a63aa777308c1fafdb4c32fdcd","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n(495 line(s) above)\n496|func CheckTargetWriteGates(adapter map[string]Capability, provider map[string]ProviderCapability) error {\n497|\tif !capabilityMapUsable(adapter, \"canonical_write\") && !capabilityMapUsable(adapter, \"official_import\") {\n498|\t\tfailure, err := failCapability(\"target write has neither usable canonical-write nor official-import\", \"canonical_write|official_import\")\n499|\t\tif err != nil {\n500|\t\t\treturn err\n501|\t\t}\n502|\t\treturn failure\n503|\t}\n504|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n505|\t\tif !capabilityMapUsable(adapter, name) {\n506|\t\t\tfailure, err := failCapability(\"target write misses a usable adapter capability\", name)\n507|\t\t\tif err != nil {\n508|\t\t\t\treturn err\n509|\t\t\t}\n510|\t\t\treturn failure\n511|\t\t}\n512|\t}\n513|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n514|\t\tvalue, present := provider[name]\n515|\t\tif !present || value.Status != \"available\" || !value.Enabled {\n516|\t\t\tfailure, err := failCapability(\"target write misses a usable provider capability\", \"provider:\"+name)\n517|\t\t\tif err != nil {\n518|\t\t\t\treturn err\n519|\t\t\t}\n520|\t\t\treturn failure\n521|\t\t}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// capabilityMapUsable reports whether the named adapter capability\n527|// is usable. An absent name is not usable: the map must be the\n528|// decoded probe map, which always carries all fifteen.\n529|func capabilityMapUsable(adapter map[string]Capability, name string) bool {\n530|\tvalue, present := adapter[name]\n531|\tif !present {\n532|\t\treturn false\n533|\t}\n534|\treturn value.Status == \"available\" && value.Enabled\n535|}\n536|\n537|// doctorResultMembers is the exact doctor success-body member set.\n538|var doctorResultMembers = map[string]bool{\n539|\t\"context\":               true,\n540|\t\"direction\":             true,\n541|\t\"registry_sequence\":     true,\n542|\t\"registry_entry_status\": true,\n543|\t\"findings\":              true,\n544|\t\"healthy\":               true,\n545|\t\"extensions\":            true,\n546|}\n547|\n548|// doctorResultRequired lists doctorResultMembers in order.\n549|var doctorResultRequired = []string{\n550|\t\"context\",\n551|\t\"direction\",\n552|\t\"registry_sequence\",\n553|\t\"registry_entry_status\",\n554|\t\"findings\",\n555|\t\"healthy\",\n556|\t\"extensions\",\n557|}\n558|\n559|// DoctorResult is one validated doctor success body.\n560|type DoctorResult struct {\n561|\tContext          CallContext\n562|\tDirection        Direction\n563|\tRegistrySequence uint64\n564|\tEntryStatus      string\n565|\tFindings         []Finding\n566|\tHealthy          bool\n567|}\n568|\n569|// DecodeDoctorResult validates one closed doctor success body: the\n570|// echoed context, the direction in the closed vocabulary, the\n571|// registry sequence as uint53, the entry status in\n572|// accepted|revoked|absent, the findings, and the health flag. The\n573|// health rule itself is CheckDoctorHealthy: decoding proves shape,\n574|// not health.\n575|func DecodeDoctorResult(body []byte, sent CallContext, sentDirection Direction) (DoctorResult, error) {\n576|\tmembers, fault := decodeStrictObject(body)\n577|\tif fault != nil {\n578|\t\tfailure, err := failProtocol(\"doctor result \"+fault.detail, fault.member)\n579|\t\tif err != nil {\n580|\t\t\treturn DoctorResult{}, err\n581|\t\t}\n582|\t\treturn DoctorResult{}, failure\n583|\t}\n584|\tif name, unknown := unknownMember(members, doctorResultMembers); unknown {\n585|\t\tfailure, err := failProtocol(\"doctor result carries unknown member\", name)\n586|\t\tif err != nil {\n587|\t\t\treturn DoctorResult{}, err\n588|\t\t}\n589|\t\treturn DoctorResult{}, failure\n590|\t}\n591|\tif name, missing := missingMember(members, doctorResultRequired); missing {\n592|\t\tfailure, err := failProtocol(\"doctor result misses a required member\", name)\n593|\t\tif err != nil {\n594|\t\t\treturn DoctorResult{}, err\n595|\t\t}\n596|\t\treturn DoctorResult{}, failure\n597|\t}\n598|\tcontext, err := CheckContextEcho(sent, members[\"context\"])\n599|\tif err != nil {\n600|\t\treturn DoctorResult{}, err\n601|\t}\n602|\tdirection, ok := rawString(members[\"direction\"])\n603|\tif !ok || !validDirection(direction) {\n604|\t\tfailure, err := failProtocol(\"doctor result direction is outside source_read|target_write\", \"direction\")\n605|\t\tif err != nil {\n606|\t\t\treturn DoctorResult{}, err\n607|\t\t}\n608|\t\treturn DoctorResult{}, failure\n609|\t}\n610|\tif Direction(direction) != sentDirection {\n611|\t\tfailure, err := failProtocol(\"doctor result direction does not answer the request direction\", \"direction\")\n612|\t\tif err != nil {\n613|\t\t\treturn DoctorResult{}, err\n614|\t\t}\n615|\t\treturn DoctorResult{}, failure\n616|\t}\n617|\tsequence, ok := checkUint53Bounds(members[\"registry_sequence\"], 0, maxUint53)\n618|\tif !ok {\n619|\t\tfailure, err := failProtocol(\"doctor result registry sequence is not a uint53\", \"registry_sequence\")\n620|\t\tif err != nil {\n621|\t\t\treturn DoctorResult{}, err\n622|\t\t}\n623|\t\treturn DoctorResult{}, failure\n624|\t}\n625|\tstatus, ok := rawString(members[\"registry_entry_status\"])\n626|\tif !ok || !validRegistryEntryStatus(status) {\n627|\t\tfailure, err := failProtocol(\"doctor result entry status is outside accepted|revoked|absent\", \"registry_entry_status\")\n628|\t\tif err != nil {\n629|\t\t\treturn DoctorResult{}, err\n630|\t\t}\n631|\t\treturn DoctorResult{}, failure\n632|\t}\n633|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n634|\tif err != nil {\n635|\t\treturn DoctorResult{}, err\n636|\t}\n637|\thealthy, ok := rawBool(members[\"healthy\"])\n638|\tif !ok {\n639|\t\tfailure, err := failProtocol(\"doctor result health flag is not a boolean\", \"healthy\")\n640|\t\tif err != nil {\n641|\t\t\treturn DoctorResult{}, err\n642|\t\t}\n643|\t\treturn DoctorResult{}, failure\n644|\t}\n645|\tif !checkExtensions(members[\"extensions\"]) {\n646|\t\tfailure, err := failProtocol(\"doctor result extensions are not reverse-DNS keyed\", \"extensions\")\n647|\t\tif err != nil {\n648|\t\t\treturn DoctorResult{}, err\n649|\t\t}\n650|\t\treturn DoctorResult{}, failure\n651|\t}\n652|\treturn DoctorResult{\n653|\t\tContext:          context,\n654|\t\tDirection:        Direction(direction),\n655|\t\tRegistrySequence: sequence,\n656|\t\tEntryStatus:      status,\n657|\t\tFindings:         findings,\n658|\t\tHealthy:          healthy,\n659|\t}, nil\n660|}\n661|\n662|// CheckDoctorHealthy enforces the doctor health rule: healthy\n663|// requires an accepted exact binding and every required\n664|// capability. A healthy=true result over a revoked or absent entry\n665|// is refused, and so is a healthy=true result with any required\n666|// capability unusable. healthy=false is always structurally\n667|// admissible: the rule states necessary conditions, not\n668|// sufficient ones. Every required name must belong to the closed\n669|// fifteen-registry; a required set naming anything else is a\n670|// caller error, because the host cannot demand a surface the\n671|// contract never defined.\n672|func CheckDoctorHealthy(result DoctorResult, probe Probe, required []string) error {\n673|\tfor _, name := range required {\n674|\t\tif !validCapabilityName(name) {\n675|\t\t\tfailure, err := failInvalid(\"doctor required set names a capability outside the closed registry\", \"required\")\n676|\t\t\tif err != nil {\n677|\t\t\t\treturn err\n678|\t\t\t}\n679|\t\t\treturn failure\n680|\t\t}\n681|\t}\n682|\tif !result.Healthy {\n683|\t\treturn nil\n684|\t}\n685|\tif result.EntryStatus != \"accepted\" {\n686|\t\tfailure, err := failCapability(\"doctor reports healthy without an accepted registry entry\", \"tuple_registry\")\n687|\t\tif err != nil {\n688|\t\t\treturn err\n689|\t\t}\n690|\t\treturn failure\n691|\t}\n692|\tfor _, name := range required {\n693|\t\tif !CapabilityUsable(probe, name) {\n694|\t\t\tfailure, err := failCapability(\"doctor reports healthy without a usable required capability\", name)\n695|\t\t\tif err != nil {\n696|\t\t\t\treturn err\n697|\t\t\t}\n698|\t\t\treturn failure\n699|\t\t}\n700|\t}\n701|\treturn nil\n702|}\n703|\n704|// validCapabilityName reports whether the name belongs to the\n705|// fifteen-capability registry.\n706|func validCapabilityName(name string) bool {\n707|\tfor _, capability := range capabilityOrder {\n708|\t\tif capability == name {\n709|\t\t\treturn true\n710|\t\t}\n711|\t}\n712|\treturn false\n713|}\n714|\n715|// DoctorRequiredCapabilities returns the closed required-capability\n716|// set for one doctor direction. For target_write it is the Section\n717|// 7.8 target-write adapter set: the import strategy selects which\n718|// member of the canonical-write/official-import pair is required,\n719|// and native-read-back, native-resume-plan, and workspace-binding\n720|// are always required. For source_read it is empty: Section 7.8\n721|// names no per-direction source set, so the caller carries its\n722|// tuple-registry-derived requirements explicitly rather than\n723|// reading them from an invented list. The strategy-to-pair mapping\n724|// is an interpretation recorded here, not a derived rule: the\n725|// target_official_import strategy authorizes the official-import\n726|// member, every other target strategy the canonical-write member.\n727|func DoctorRequiredCapabilities(direction Direction, useOfficialImport bool) []string {\n728|\tif direction != DirectionTargetWrite {\n729|\t\treturn nil\n730|\t}\n731|\twriter := \"canonical_write\"\n732|\tif useOfficialImport {\n733|\t\twriter = \"official_import\"\n734|\t}\n735|\treturn []string{writer, \"native_read_back\", \"native_resume_plan\", \"workspace_binding\"}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
