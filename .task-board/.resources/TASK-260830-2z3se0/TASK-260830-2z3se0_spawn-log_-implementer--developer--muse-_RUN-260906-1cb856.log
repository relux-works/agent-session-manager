ed := probe; mutated.ProviderID = \"other-provider\"; return mutated }(),\n205|\t\t\tfacts: func() ProbeHostFacts { fixed := facts; fixed.ExpectedProviderID = \"other-provider\"; return fixed }(),\n206|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"verified manifest\",\n207|\t\t},\n208|\t\t{\n209|\t\t\tname:  \"manifest digest\",\n210|\t\t\tprobe: func() Probe { mutated := probe; mutated.ManifestDigest = otherDigest; return mutated }(),\n211|\t\t\tfacts: facts, key: \"member\", value: \"adapter_manifest_digest\", text: \"host-computed digest\",\n212|\t\t},\n213|\t\t{\n214|\t\t\tname:  \"adapter version\",\n215|\t\t\tprobe: func() Probe { mutated := probe; mutated.AdapterVersion = \"9.9.9\"; return mutated }(),\n216|\t\t\tfacts: facts, key: \"member\", value: \"adapter_version\", text: \"verified manifest\",\n217|\t\t},\n218|\t\t{\n219|\t\t\tname:  \"unrequested tuple\",\n220|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.EnvironmentID = \"other.env\"; return mutated }(),\n221|\t\t\tfacts: facts, key: \"environment\", value: \"other.env\", text: \"outside the manifest environment\",\n222|\t\t},\n223|\t\t{\n224|\t\t\tname:  \"tuple version disagrees\",\n225|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.AdapterVersion = \"0.0.1\"; return mutated }(),\n226|\t\t\tfacts: facts, key: \"member\", value: \"environment\", text: \"probe adapter version\",\n227|\t\t},\n228|\t} {\n229|\t\tt.Run(test.name, func(t *testing.T) {\n230|\t\t\terr := CheckProbe(test.probe, test.facts)\n231|\t\t\tif test.key == \"environment\" && (test.name == \"unrequested tuple\") {\n232|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", test.key, test.value, test.text)\n233|\t\t\t\treturn\n234|\t\t\t}\n235|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n236|\t\t})\n237|\t}\n238|}\n239|\n240|// TestZeroValueHostFactsRefuse pins the fail-closed half of the\n241|// host-fact equality gates: