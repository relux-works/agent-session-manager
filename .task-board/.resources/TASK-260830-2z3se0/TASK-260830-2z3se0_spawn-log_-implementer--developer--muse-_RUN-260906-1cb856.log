esult(members, facts)\n925|\tcase OpResumePlan:\n926|\t\tif err := requireStringBounds(members, \"target_native_session_id\", 1, 512); err != nil {\n927|\t\t\treturn err\n928|\t\t}\n929|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n930|\t\t\treturn err\n931|\t\t}\n932|\t\targv, ok := decodeArray(bytesTrimSpace(members[\"argv\"]))\n933|\t\tif !ok || len(argv) == 0 || len(argv) > 128 {\n934|\t\t\tfailure, err := failProtocol(\"resume-plan argv is not 1..128 entries\", \"argv\")\n935|\t\t\tif err != nil {\n936|\t\t\t\treturn err\n937|\t\t\t}\n938|\t\t\treturn failure\n939|\t\t}\n940|\t\toccurrences := 0\n941|\t\tfor _, element := range argv {\n942|\t\t\tword, ok := checkStringBounds(element, 1, 4096)\n943|\t\t\tif !ok {\n944|\t\t\t\tfailure, err := failProtocol(\"resume-plan argv word is not a string[1..4096]\", \"argv\")\n945|\t\t\t\tif err != nil {\n946|\t\t\t\t\treturn err\n947|\t\t\t\t}\n948|\t\t\t\treturn failure\n949|\t\t\t}\n950|\t\t\tif word == facts.ResumeTargetID {\n951|\t\t\t\toccurrences++\n952|\t\t\t}\n953|\t\t}\n954|\t\t// The explicit identity occurs exactly once: zero leaves\n955|\t\t// the resume unbound, two or more leave it ambiguous.\n956|\t\tif occurrences != 1 {\n957|\t\t\tfailure, err := failProtocol(\"resume-plan argv does not carry the explicit identity exactly once\", \"argv\")\n958|\t\t\tif err != nil {\n959|\t\t\t\treturn err\n960|\t\t\t}\n961|\t\t\treturn failure\n962|\t\t}\n963|\t\tif err := requireStringBounds(members, \"cwd_relative\", 1, 4096); err != nil {\n964|\t\t\treturn err\n965|\t\t}\n966|\t\tif _, ok := checkSortedUniqueStrings(members[\"environment_names\"], 1, 256, 0, 128); !ok {\n967|\t\t\tfailure, err := failProtocol(\"resume-plan environment names are not sorted unique string[1..256][0..128]\", \"environment_names\")\n968|\t\t\tif err != nil {\n969|\t\t\t\treturn err\n970|\t\t\t}\n971|\t\t\treturn failure\n972|\t\t}\n973|\t\topens, err := requireBool(members, \"opens_existing_identity\")\n974|\t