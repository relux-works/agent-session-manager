{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e5","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":333,"recorded_at":1780531400000661,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"b308d820-a45b-43c4-8978-aaceda8947ec"},"task_id":"b308d820-a45b-43c4-8978-aaceda8947ec","event":{"kind":"output","task_id":"b308d820-a45b-43c4-8978-aaceda8947ec","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/printer\"\n9|\t\"go/token\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"testing\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n19|)\n20|\n21|// This file is the closed-vocabulary census. It exists because a\n22|// new closed set in production — a map consulted for membership,\n23|// a slice looped for admission, a switch classifying inputs, an\n24|// inline comparison chain admitting two names — passes every\n25|// behavioral test that never names it. The census finds the\n26|// membership surface by parsing production source and fails\n27|// closed on anything with no registered derivation, so the\n28|// surface cannot grow something unwitnessed.\n29|//\n30|// Five checks:\n31|// TestClosedVocabularyTablesAreRegistered scans every\n32|// package-level var shaped like a vocabulary — a map or slice\n33|// composite, written directly or through a named slice or map\n34|// type declared anywhere in the package — and requires each in\n35|// the registration table below with its consultation proof.\n36|// TestNoUnregisteredInlineVocabularies forbids the shape the\n37|// table scan cannot see: a boolean chain comparing one operand\n38|// against two or more closed values (`v == \"a\" || v == \"b\"`,\n39|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n40|// or conversions). Every closed union lives in a registered\n41|// table; a chain is an unregistered union and fails here.\n42|// TestClosedMemberSetsAreDerivedFromSpec parses every closed\n43|// body from the pinned document and requires exact ordered\n44|// equality with the production member tables: a dropped, added,\n45|// or reordered member reddens here.\n46|// TestAllProductionSwitchesAreClassified allows only switches\n47|// dispatching on the validated operation plus the tagless UTF-16\n48|// hex classifier inside readUTF16Escape, named by function; any\n49|// other switch — including a tagless switch anywhere else — is a\n50|// membership gate hiding spot and fails.\n51|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n52|// against its verbatim spec union as a set.\n53|//\n54|// Stated bound: the scanner is syntactic. It sees package-level\n55|// composite shapes (single, shared, and paired initializers),\n56|// named-type aliases, and comparison chains — not function-local\n57|// composites, not unions encoded in a const string or a regexp\n58|// alternation, and not sets built at runtime (a map populated in\n59|// a loop, a registry assembled in init). This package holds no\n60|// const- or regexp-encoded union and builds no vocabulary at\n61|// runtime: every registered table is a package-level composite\n62|// literal, which the scan asserts by construction — a\n63|// runtime-built set would have to replace a composite the\n64|// census already pins. The five function-local obligation lists\n65|// (the validate target list, the two validate check triples,\n66|// the two target-write lists) are outside the table scan and\n67|// are pinned behaviourally instead, in both directions, by the\n68|// obligation tests.\n69|//\n70|// An empty scan, an empty derivation, or an unparseable file\n71|// fails closed throughout: a domain that silently derives\n72|// nothing is not a measurement.\n73|\n74|// registeredVocabulary is one production vocabulary table with\n75|// its consultation proof: the production function or call\n76|// pattern that consults it for membership.\n77|type registeredVocabulary struct {\n78|\tname       string\n79|\tconsulted  string\n80|\tspecMember string\n81|}\n82|\n83|// vocabularyRegistrations lists every package-level vocabulary\n84|// table. A production table with no row here fails the census.\n85|var vocabularyRegistrations = []registeredVocabulary{\n86|\t{name: \"operationOrder\", consulted: \"validOperation\", specMember: \"Section 7.8 operation table\"},\n87|\t{name: \"requestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 request envelope sentence\"},\n88|\t{name: \"requestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 request envelope sentence\"},\n89|\t{name: \"successMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 success envelope rule\"},\n90|\t{name: \"successRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 success envelope rule\"},\n91|\t{name: \"failureMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 failure envelope rule\"},\n92|\t{name: \"failureRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 failure envelope rule\"},\n93|\t{name: \"capabilityOrder\", consulted: \"decodeCapabilities\", specMember: \"Section 7.8 capability sentence\"},\n94|\t{name: \"manifestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 manifest table\"},\n95|\t{name: \"manifestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 manifest table\"},\n96|\t{name: \"probeMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 probe sentence\"},\n97|\t{name: \"probeRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 probe sentence\"},\n98|\t{name: \"capabilityValueMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 capability value sentence\"},\n99|\t{name: \"capabilityValueRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 capability value sentence\"},\n100|\t{name: \"capabilityEvidences\", consulted: \"validCapabilityEvidence\", specMember: \"Section 7.8 evidence union\"},\n101|\t{name: \"capabilityStatuses\", consulted: \"validCapabilityStatus\", specMember: \"Section 7.8 status union\"},\n102|\t{name: \"contextMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n103|\t{name: \"contextRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n104|\t{name: \"readAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n105|\t{name: \"readAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n106|\t{name: \"objectAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n107|\t{name: \"objectAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n108|\t{name: \"objectPurposes\", consulted: \"validObjectPurpose\", specMember: \"Section 7.8 purpose union\"},\n109|\t{name: \"objectModes\", consulted: \"validObjectMode\", specMember: \"Section 7.8 ObjectAuthority mode union\"},\n110|\t{name: \"readPurposes\", consulted: \"validReadPurpose\", specMember: \"Section 7.8 ReadAuthority purpose union\"},\n111|\t{name: \"findingSeverities\", consulted: \"validFindingSeverity\", specMember: \"Section 7.8 severity union\"},\n112|\t{name: \"sourceSelectorMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n113|\t{name: \"sourceSelectorRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n114|\t{name: \"resourceLimitsMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n115|\t{name: \"resourceLimitsRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n116|\t{name: \"findingMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n117|\t{name: \"findingRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n118|\t{name: \"capturePlanItemMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n119|\t{name: \"capturePlanItemRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n120|\t{name: \"tupleMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n121|\t{name: \"tupleRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n122|\t{name: \"projectionStrategies\", consulted: \"validStrategy\", specMember: \"Section 13.14 strategy sentence\"},\n123|\t{name: \"fidelityDispositions\", consulted: \"validDisposition\", specMember: \"Section 13.14 disposition sentence\"},\n124|\t{name: \"captureClasses\", consulted: \"validCaptureClass\", specMember: \"Section 13.14 CaptureItem class column\"},\n125|\t{name: \"tupleArchitectures\", consulted: \"validTupleArchitecture\", specMember: \"Section 7.8 architecture union\"},\n126|\t{name: \"tupleKeyMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 key sentence\"},\n127|\t{name: \"tupleKeyRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 key sentence\"},\n128|\t{name: \"tupleEntryMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 entry sentence\"},\n129|\t{name: \"tupleEntryRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 entry sentence\"},\n130|\t{name: \"fixtureEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n131|\t{name: \"fixtureEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n132|\t{name: \"smokeEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n133|\t{name: \"smokeEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n134|\t{name: \"fidelityLimitMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n135|\t{name: \"fidelityLimitRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n136|\t{name: \"requestBodyMembers\", consulted: \"CheckRequestBody\", specMember: \"Section 7.8 operation table\"},\n137|\t{name: \"successBodyMembers\", consulted: \"CheckSuccessBody\", specMember: \"Section 7.8 operation table\"},\n138|\t{name: \"fidelityProfiles\", consulted: \"validFidelityProfile\", specMember: \"Section 7.8 profile union\"},\n139|\t{name: \"validateModes\", consulted: \"validValidateMode\", specMember: \"Section 7.8 validate row\"},\n140|\t{name: \"contextFreeOperations\", consulted: \"operationSkipsRequestContext\", specMember: \"Section 7.8 operation table (context-free request bodies)\"},\n141|\t{name: \"doctorResultMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 doctor row\"},\n142|\t{name: \"doctorResultRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 doctor row\"},\n143|\t{name: \"directionNames\", consulted: \"validDirection\", specMember: \"Section 13.14 key direction union and Section 7.8 doctor row\"},\n144|\t{name: \"roleNames\", consulted: \"validRole\", specMember: \"Section 7.8 binding role union\"},\n145|\t{name: \"candidateKindNames\", consulted: \"validCandidateKind\", specMember: \"Section 7.8 candidate-kind union\"},\n146|\t{name: \"tupleEntryStatuses\", consulted: \"validTupleEntryStatus\", specMember: \"Section 13.14 entry status union\"},\n147|\t{name: \"evidenceResults\", consulted: \"validEvidenceResult\", specMember: \"Sections 13.14 result=pass\"},\n148|\t{name: \"registryEntryStatuses\", consulted: \"validRegistryEntryStatus\", specMember: \"Section 7.8 doctor row\"},\n149|}\n150|\n151|// TestClosedVocabularyTablesAreRegistered is the census: every\n152|// package-level vocabulary-shaped var must carry a registration\n153|// row naming its consultation. A new table without a row fails\n154|// here rather than passing silently.\n155|func TestClosedVocabularyTablesAreRegistered(t *testing.T) {\n156|\tdirectory, err := os.Getwd()\n157|\tif err != nil {\n158|\t\tt.Fatalf(\"census: %v\", err)\n159|\t}\n160|\tregistered := map[string]registeredVocabulary{}\n161|\tfor _, entry := range vocabularyRegistrations {\n162|\t\tif _, duplicate := registered[entry.name]; duplicate {\n163|\t\t\tt.Fatalf(\"census registers %q twice\", entry.name)\n164|\t\t}\n165|\t\tregistered[entry.name] = entry\n166|\t}\n167|\tfound, scanned := scanVocabularyTables(t, directory)\n168|\tif len(scanned) == 0 {\n169|\t\tt.Fatal(\"census scanned zero production files; the scanner is broken, not the package\")\n170|\t}\n171|\tif len(found) == 0 {\n172|\t\tt.Fatal(\"census found zero vocabulary tables; the scanner is broken, not the package\")\n173|\t}\n174|\tvar unregistered []string\n175|\tfor _, name := range found {\n176|\t\tentry, ok := registered[name]\n177|\t\tif !ok {\n178|\t\t\tunregistered = append(unregistered, name)\n179|\t\t\tcontinue\n180|\t\t}\n181|\t\tif entry.consulted == \"\" || entry.specMember == \"\" {\n182|\t\t\tt.Errorf(\"census registration of %q names no consultation or spec member\", name)\n183|\t\t}\n184|\t}\n185|\tsort.Strings(unregistered)\n186|\tif len(unregistered) > 0 {\n187|\t\tt.Fatalf(\"production vocabulary table(s) with no census registration:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n188|\t}\n189|\tvar orphaned []string\n190|\tfor name := range registered {\n191|\t\tpresent := false\n192|\t\tfor _, table := range found {\n193|\t\t\tif table == name {\n194|\t\t\t\tpresent = true\n195|\t\t\t\tbreak\n196|\t\t\t}\n197|\t\t}\n198|\t\tif !present {\n199|\t\t\torphaned = append(orphaned, name)\n200|\t\t}\n201|\t}\n202|\tsort.Strings(orphaned)\n203|\tif len(orphaned) > 0 {\n204|\t\tt.Fatalf(\"census registration(s) naming no production table:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n205|\t}\n206|\tt.Logf(\"vocabulary census: %d tables registered across %d files\", len(found), len(scanned))\n207|}\n208|\n209|// scanVocabularyTables returns every package-level var shaped\n210|// like a vocabulary: a map or slice composite, written directly\n211|// or through a named slice or map type declared anywhere in the\n212|// package. A named-type table (`type names []string` plus\n213|// `var t = names{...}`) is the same closed set as a literal one,\n214|// and the census sees both.\n215|func scanVocabularyTables(t *testing.T, directory string) ([]string, []string) {\n216|\tt.Helper()\n217|\tentries, err := os.ReadDir(directory)\n218|\tif err != nil {\n219|\t\tt.Fatalf(\"census: %v\", err)\n220|\t}\n221|\ttype namedFile struct {\n222|\t\tname   string\n223|\t\tsyntax *ast.File\n224|\t}\n225|\tvar files []namedFile\n226|\tvar scanned []string\n227|\tfor _, entry := range entries {\n228|\t\tname := entry.Name()\n229|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n230|\t\t\tcontinue\n231|\t\t}\n232|\t\tscanned = append(scanned, name)\n233|\t\tpath := filepath.Join(directory, name)\n234|\t\tsource, err := os.ReadFile(path)\n235|\t\tif err != nil {\n236|\t\t\tt.Fatalf(\"census: %v\", err)\n237|\t\t}\n238|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n239|\t\tif err != nil {\n240|\t\t\tt.Fatalf(\"census: %v\", err)\n241|\t\t}\n242|\t\tfiles = append(files, namedFile{name: name, syntax: syntax})\n243|\t}\n244|\tnamed := map[string]ast.Expr{}\n245|\tfor _, file := range files {\n246|\t\tcollectNamedCompositeTypes(file.syntax, named)\n247|\t}\n248|\tvar found []string\n249|\tfor _, file := range files {\n250|\t\tfound = append(found, vocabularyTablesInFile(file.syntax, named)...)\n251|\t}\n252|\treturn found, scanned\n253|}\n254|\n255|// collectNamedCompositeTypes records every package-level type\n256|// name declared with a composite underlying type: a direct map or\n257|// slice, or another named type resolved later. Struct, string,\n258|// and other underlying types are recorded too, so a struct\n259|// literal through a named type is never mistaken for a table.\n260|func collectNamedCompositeTypes(syntax *ast.File, named map[string]ast.Expr) {\n261|\tfor _, declaration := range syntax.Decls {\n262|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n263|\t\tif !ok || general.Tok != token.TYPE {\n264|\t\t\tcontinue\n265|\t\t}\n266|\t\tfor _, specification := range general.Specs {\n267|\t\t\talias, ok := specification.(*ast.TypeSpec)\n268|\t\t\tif !ok {\n269|\t\t\t\tcontinue\n270|\t\t\t}\n271|\t\t\tnamed[alias.Name.Name] = alias.Type\n272|\t\t}\n273|\t}\n274|}\n275|\n276|// vocabularyTablesInFile returns the package-level vars of one\n277|// file whose initializer is a vocabulary composite. One shared\n278|// initializer serves every name; paired initializers serve their\n279|// own name each (`var a, b = []string{...}, []string{...}`), so\n280|// a multi-name declaration never hides a table from the scan.\n281|func vocabularyTablesInFile(syntax *ast.File, named map[string]ast.Expr) []string {\n282|\tvar found []string\n283|\tfor _, declaration := range syntax.Decls {\n284|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n285|\t\tif !ok || general.Tok != token.VAR {\n286|\t\t\tcontinue\n287|\t\t}\n288|\t\tfor _, specification := range general.Specs {\n289|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n290|\t\t\tif !ok || len(value.Values) == 0 {\n291|\t\t\t\tcontinue\n292|\t\t\t}\n293|\t\t\tfor index, ident := range value.Names {\n294|\t\t\t\tvar initializer ast.Expr\n295|\t\t\t\tswitch {\n296|\t\t\t\tcase len(value.Values) == 1:\n297|\t\t\t\t\tinitializer = value.Values[0]\n298|\t\t\t\tcase index < len(value.Values):\n299|\t\t\t\t\tinitializer = value.Values[index]\n300|\t\t\t\tdefault:\n301|\t\t\t\t\tcontinue\n302|\t\t\t\t}\n303|\t\t\t\tif isVocabularyShape(initializer, named) {\n304|\t\t\t\t\tfound = append(found, ident.Name)\n305|\t\t\t\t}\n306|\t\t\t}\n307|\t\t}\n308|\t}\n309|\treturn found\n310|}\n311|\n312|// isVocabularyShape reports whether the initializer is a\n313|// vocabulary composite: a map or slice literal, or a composite\n314|// through a named type whose underlying type — resolved across\n315|// the package, through any alias chain — is a map or slice.\n316|// Element type is irrelevant; registrations name the table, not\n317|// its shape. A composite through any other named type (a struct\n318|// literal, a string conversion) is not a table.\n319|func isVocabularyShape(node ast.Expr, named map[string]ast.Expr) bool {\n320|\tliteral, ok := node.(*ast.CompositeLit)\n321|\tif !ok {\n322|\t\treturn false\n323|\t}\n324|\tswitch typ := literal.Type.(type) {\n325|\tcase *ast.MapType, *ast.ArrayType:\n326|\t\treturn true\n327|\tcase *ast.Ident:\n328|\t\treturn resolvesToComposite(typ.Name, named, 0)\n329|\t}\n330|\treturn false\n331|}\n332|\n333|// resolvesToComposite reports whether the named type ultimately\n334|// denotes a map or slice. Alias chains resolve up to a fixed\n335|// depth; a cycle or an unknown name is not a table.\n336|func resolvesToComposite(name string, named map[string]ast.Expr, depth int) bool {\n337|\tif depth > 8 {\n338|\t\treturn false\n339|\t}\n340|\tunderlying, ok := named[name]\n341|\tif !ok {\n342|\t\treturn false\n343|\t}\n344|\tswitch typ := underlying.(type) {\n345|\tcase *ast.MapType, *ast.ArrayType:\n346|\t\treturn true\n347|\tcase *ast.Ident:\n348|\t\treturn resolvesToComposite(typ.Name, named, depth+1)\n349|\t}\n350|\treturn false\n351|}\n352|\n353|// TestAllProductionSwitchesAreClassified allows only switches\n354|// dispatching on the validated operation plus the tagless UTF-16\n355|// hex classifier inside readUTF16Escape. Any other switch —\n356|// including a tagless switch in any other function — is a\n357|// membership gate hiding spot and fails: membership lives in\n358|// tables the census sees, never in case arms it cannot.\n359|func TestAllProductionSwitchesAreClassified(t *testing.T) {\n360|\tdirectory, err := os.Getwd()\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"switch census: %v\", err)\n363|\t}\n364|\tentries, err := os.ReadDir(directory)\n365|\tif err != nil {\n366|\t\tt.Fatalf(\"switch census: %v\", err)\n367|\t}\n368|\tscanned := 0\n369|\tclassified := 0\n370|\tvar unclassified []string\n371|\tfor _, entry := range entries {\n372|\t\tname := entry.Name()\n373|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n374|\t\t\tcontinue\n375|\t\t}\n376|\t\tscanned++\n377|\t\tpath := filepath.Join(directory, name)\n378|\t\tsource, err := os.ReadFile(path)\n379|\t\tif err != nil {\n380|\t\t\tt.Fatalf(\"switch census: %v\", err)\n381|\t\t}\n382|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n383|\t\tif err != nil {\n384|\t\t\tt.Fatalf(\"switch census: %v\", err)\n385|\t\t}\n386|\t\tvar stack []ast.Node\n387|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n388|\t\t\tif node == nil {\n389|\t\t\t\tstack = stack[:len(stack)-1]\n390|\t\t\t\treturn true\n391|\t\t\t}\n392|\t\t\tif statement, ok := node.(*ast.SwitchStmt); ok {\n393|\t\t\t\tposition := filepath.Base(path)\n394|\t\t\t\tif classifySwitch(statement.Tag, enclosingFunc(stack)) {\n395|\t\t\t\t\tclassified++\n396|\t\t\t\t} else {\n397|\t\t\t\t\tunclassified = append(unclassified, position)\n398|\t\t\t\t}\n399|\t\t\t}\n400|\t\t\tstack = append(stack, node)\n401|\t\t\treturn true\n402|\t\t})\n403|\t}\n404|\tif scanned == 0 {\n405|\t\tt.Fatal(\"switch census scanned zero production files\")\n406|\t}\n407|\tsort.Strings(unclassified)\n408|\tif len(unclassified) > 0 {\n409|\t\tt.Fatalf(\"unclassified production switch(es): %s\", strings.Join(unclassified, \", \"))\n410|\t}\n411|\tt.Logf(\"switch census: %d classified switches across %d files\", classified, scanned)\n412|}\n413|\n414|// enclosingFunc names the innermost function declaration above\n415|// the current walk position, or \"\" outside any function. The\n416|// switch census uses it to confine the tagless-switch exemption\n417|// to readUTF16Escape by name rather than exempting the shape.\n418|func enclosingFunc(stack []ast.Node) string {\n419|\tfor index := len(stack) - 1; index >= 0; index-- {\n420|\t\tif declaration, ok := stack[index].(*ast.FuncDecl); ok {\n421|\t\t\treturn declaration.Name.Name\n422|\t\t}\n423|\t}\n424|\treturn \"\"\n425|}\n426|\n427|// classifySwitch reports whether a switch with the given tag in\n428|// the named function is an allowed classifier: a dispatch on\n429|// the validated operation, or the tagless UTF-16 hex classifier\n430|// inside readUTF16Escape — which switches over digit ranges and\n431|// classifies characters rather than admitting members. Only\n432|// this function earns the tagless exemption; a tagless switch\n433|// anywhere else is a membership gate hiding spot.\n434|func classifySwitch(tag ast.Expr, function string) bool {\n435|\tif ident, ok := tag.(*ast.Ident); ok && ident.Name == \"operation\" {\n436|\t\treturn true\n437|\t}\n438|\treturn tag == nil && function == \"readUTF16Escape\"\n439|}\n440|\n441|// TestSwitchClassifierNamesItsExemption proves the switch gate\n442|// shape against synthetic inputs: the operation dispatch passes\n443|// anywhere, the tagless classifier passes only inside\n444|// readUTF16Escape, and a tagless switch in any other function\n445|// fails — the sentence the census header states.\n446|func TestSwitchClassifierNamesItsExemption(t *testing.T) {\n447|\toperation := &ast.Ident{Name: \"operation\"}\n448|\tother := &ast.Ident{Name: \"mode\"}\n449|\tfor _, probe := range []struct {\n450|\t\tname     string\n451|\t\ttag      ast.Expr\n452|\t\tfunction string\n453|\t\twant     bool\n454|\t}{\n455|\t\t{\"operation dispatch passes\", operation, \"checkRequestScalars\", true},\n456|\t\t{\"tagless classifier passes in readUTF16Escape\", nil, \"readUTF16Escape\", true},\n457|\t\t{\"tagless switch fails elsewhere\", nil, \"CheckSuccessBody\", false},\n458|\t\t{\"other tag fails\", other, \"checkRequestScalars\", false},\n459|\t} {\n460|\t\tt.Run(probe.name, func(t *testing.T) {\n461|\t\t\tif got := classifySwitch(probe.tag, probe.function); got != probe.want {\n462|\t\t\t\tt.Fatalf(\"classifySwitch(tag, %q) = %v, want %v\", probe.function, got, probe.want)\n463|\t\t\t}\n464|\t\t})\n465|\t}\n466|}\n467|\n468|// TestNoUnregisteredInlineVocabularies is the chain census: no\n469|// production boolean chain may compare one operand against two\n470|// or more closed values. `v == \"a\" || v == \"b\"`,\n471|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n472|// (`role != RoleSource && role != RoleTarget`) or conversions are\n473|// unions outside every table, and a widened chain survives every\n474|// behavioral test that never names the new member. Single\n475|// comparisons — one dispatch member (`mode == \"archive\"`), one\n476|// sentinel (`== \"\"`), one echo — are not unions and pass.\n477|func TestNoUnregisteredInlineVocabularies(t *testing.T) {\n478|\tdirectory, err := os.Getwd()\n479|\tif err != nil {\n480|\t\tt.Fatalf(\"chain census: %v\", err)\n481|\t}\n482|\tentries, err := os.ReadDir(directory)\n483|\tif err != nil {\n484|\t\tt.Fatalf(\"chain census: %v\", err)\n485|\t}\n486|\tscanned := 0\n487|\tvar unregistered []string\n488|\tfor _, entry := range entries {\n489|\t\tname := entry.Name()\n490|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n491|\t\t\tcontinue\n492|\t\t}\n493|\t\tscanned++\n494|\t\tpath := filepath.Join(directory, name)\n495|\t\tsource, err := os.ReadFile(path)\n496|\t\tif err != nil {\n497|\t\t\tt.Fatalf(\"chain census: %v\", err)\n498|\t\t}\n499|\t\tfileSet := token.NewFileSet()\n500|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n(more lines below)"}}}
