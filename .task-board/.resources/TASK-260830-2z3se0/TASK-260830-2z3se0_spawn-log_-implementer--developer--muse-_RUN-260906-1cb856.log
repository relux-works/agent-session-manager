{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d703","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":2524,"recorded_at":1780531400005043,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"253a7179-4174-4e31-b9a8-9b9e51297830"},"task_id":"253a7179-4174-4e31-b9a8-9b9e51297830","event":{"kind":"output","task_id":"253a7179-4174-4e31-b9a8-9b9e51297830","chunk":"{\n  \"chunk_id\": \"exec-66-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport re\\nsrc = open('/tmp/battery.py').read()\\nm = re.search(r'MUTANTS = \\\\[(.*?)\\\\n\\\\]', src, re.S)\\nentries = re.findall(r'\\\\(\\\\s*\\\"([^\\\"]+)\\\",\\\\s*\\\"([^\\\"]+)\\\",\\\\s*\\\\'(.*?)\\\\',\\\\s*(\\\\d+),\\\\s*\\\\'(.*?)\\\\',\\\\s*\\\"([^\\\"]*)\\\",\\\\s*\\\"(.*?)\\\"\\\\s*\\\\)', m.group(1))\\nprint(len(entries), \\\"entries parsed\\\")\\nlines = [\\\"| mutant | file | narrowing | driver | verdict |\\\",\\n         \\\"| --- | --- | --- | --- | --- |\\\"]\\n# verdicts: kills except the 6 Eequiv* (3 green, 3 censusonly)\\nfor mid, fn, old, occ, new, test, expect in entries:\\n    if expect == \\\"kill\\\":\\n        verdict = \\\"killed\\\"\\n    elif mid in (\\\"Eequiv-platforms-element\\\", \\\"Eequiv-platforms-count\\\", \\\"Eequiv-ext-min\\\"):\\n        verdict = \\\"equivalent (full suite green)\\\"\\n    else:\\n        verdict = \\\"equivalent (behavioral green; roster fails closed on the added clause)\\\"\\n    narrow = new.strip()\\n    if len(narrow) > 90:\\n        narrow = narrow[:87] + \\\"...\\\"\\n    drv = test if test else \\\"full package suite\\\"\\n    lines.append(f\\\"| {mid} | {fn} | `{narrow}` | {drv} | {verdict} |\\\")\\nopen('/tmp/mutant_table.md', 'w').write(\\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\")\\nprint(\\\"table lines:\\\", len(lines))\\nEOF\",\n  \"description\": \"Generate per-mutant evidence table\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"153 entries parsed\\ntable lines: 155\\n\",\n  \"original_output_bytes\": 36,\n  \"original_output_tokens\": 9,\n  \"truncated\": false\n}"}}}
