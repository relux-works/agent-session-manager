{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5e9","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":335,"recorded_at":1780531400000665,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"cf6faeaa-a655-4693-af45-df5884b74b58"},"task_id":"cf6faeaa-a655-4693-af45-df5884b74b58","event":{"kind":"output","task_id":"cf6faeaa-a655-4693-af45-df5884b74b58","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bounds_edge_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strconv\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// This file pins every rev3-B5 contract string maximum and array cap\n11|// at the edge (review rev3 B5): each bound is driven at the limit\n12|// (admitted) and one past it (refused), with the same for one below\n13|// the minimum. A witness far outside the range proves the arm\n14|// exists, not where the bound sits; a mutant moving any bound by\n15|// exactly one admits exactly one member of the reject class and\n16|// reddens its row here. Lengths are characters: the repeat rune is\n17|// ASCII, so bytes equal runes.\n18|\n19|// quotedRepeat renders a JSON string literal of exactly n characters.\n20|func quotedRepeat(n int) string {\n21|\treturn strconv.Quote(strings.Repeat(\"a\", n))\n22|}\n23|\n24|// stringBoundRow is one checkStringBounds maximum pinned at the\n25|// production entry: drive maps a JSON string literal to the entry's\n26|// verdict, member/text name the bound refusal for requireRefusal.\n27|type stringBoundRow struct {\n28|\tname   string\n29|\tmin    int\n30|\tmax    int\n31|\tmember string\n32|\ttext   string\n33|\tdrive  func(t *testing.T, literal string) error\n34|}\n35|\n36|// TestStringBoundEdges drives every survivor string maximum at\n37|// max-1/min/max/max+1 through its production entry point.\n38|func TestStringBoundEdges(t *testing.T) {\n39|\trows := []stringBoundRow{\n40|\t\t{\n41|\t\t\tname: \"manifest environment_version_range\", min: 1, max: 256,\n42|\t\t\tmember: \"environment_version_range\", text: \"string[1..256]\",\n43|\t\t\tdrive: func(t *testing.T, literal string) error {\n44|\t\t\t\t_, err := DecodeManifest(mutateMember(t, []byte(fixtureManifestJSON()), \"environment_version_range\", literal))\n45|\t\t\t\treturn err\n46|\t\t\t},\n47|\t\t},\n48|\t\t{\n49|\t\t\tname: \"source native_session_id\", min: 1, max: 512,\n50|\t\t\tmember: \"native_session_id\", text: \"string[1..512]\",\n51|\t\t\tdrive: func(t *testing.T, literal string) error {\n52|\t\t\t\t_, err := DecodeSourceSelector([]byte(`{\"native_session_id\":` + literal + `,\"logical_workspace_id\":null,\"opaque_source_ref\":null}`))\n53|\t\t\t\treturn err\n54|\t\t\t},\n55|\t\t},\n56|\t\t{\n57|\t\t\tname: \"source opaque_source_ref\", min: 1, max: 512,\n58|\t\t\tmember: \"opaque_source_ref\", text: \"string[1..512]\",\n59|\t\t\tdrive: func(t *testing.T, literal string) error {\n60|\t\t\t\t_, err := DecodeSourceSelector([]byte(`{\"native_session_id\":null,\"logical_workspace_id\":null,\"opaque_source_ref\":` + literal + `}`))\n61|\t\t\t\treturn err\n62|\t\t\t},\n63|\t\t},\n64|\t\t{\n65|\t\t\tname: \"finding code\", min: 1, max: 128,\n66|\t\t\tmember: \"code\", text: \"string[1..128]\",\n67|\t\t\tdrive: func(t *testing.T, literal string) error {\n68|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n69|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"code\", literal))\n70|\t\t\t\treturn err\n71|\t\t\t},\n72|\t\t},\n73|\t\t{\n74|\t\t\tname: \"finding message\", min: 1, max: 4096,\n75|\t\t\tmember: \"message\", text: \"string[1..4096]\",\n76|\t\t\tdrive: func(t *testing.T, literal string) error {\n77|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n78|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"message\", literal))\n79|\t\t\t\treturn err\n80|\t\t\t},\n81|\t\t},\n82|\t\t{\n83|\t\t\tname: \"finding remediation\", min: 1, max: 4096,\n84|\t\t\tmember: \"remediation\", text: \"string[1..4096]\",\n85|\t\t\tdrive: func(t *testing.T, literal string) error {\n86|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n87|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"remediation\", literal))\n88|\t\t\t\treturn err\n89|\t\t\t},\n90|\t\t},\n91|\t\t{\n92|\t\t\tname: \"capture native_item_key\", min: 1, max: 512,\n93|\t\t\tmember: \"native_item_key\", text: \"string[1..512]\",\n94|\t\t\tdrive: func(t *testing.T, literal string) error {\n95|\t\t\t\tvalid := `{\"native_item_key\":\"item-1\",\"class\":\"durable_payload\",\"byte_count\":12,\"required\":true,\"extensions\":{}}`\n96|\t\t\t\t_, err := DecodeCapturePlanItem(mutateMember(t, []byte(valid), \"native_item_key\", literal))\n97|\t\t\t\treturn err\n98|\t\t\t},\n99|\t\t},\n100|\t\t{\n101|\t\t\tname: \"resume argv word\", min: 1, max: 4096,\n102|\t\t\tmember: \"argv\", text: \"string[1..4096]\",\n103|\t\t\tdrive: func(t *testing.T, literal string) error {\n104|\t\t\t\treturn checkResumeArgv(t, `[\"target-1\",`+literal+`]`)\n105|\t\t\t},\n106|\t\t},\n107|\t\t{\n108|\t\t\tname: \"tuple environment_version\", min: 1, max: 128,\n109|\t\t\tmember: \"environment_version\", text: \"string[1..128]\",\n110|\t\t\tdrive: func(t *testing.T, literal string) error {\n111|\t\t\t\t_, err := DecodeTuple(mutateMember(t, []byte(fixtureTupleJSON()), \"environment_version\", literal))\n112|\t\t\t\treturn err\n113|\t\t\t},\n114|\t\t},\n115|\t\t{\n116|\t\t\tname: \"tuple suite_revision\", min: 1, max: 128,\n117|\t\t\tmember: \"suite_revision\", text: \"string[1..128]\",\n118|\t\t\tdrive: func(t *testing.T, literal string) error {\n119|\t\t\t\t_, err := DecodeTupleEntry(mutateNested(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"fixture_evidence\", \"suite_revision\", literal))\n120|\t\t\t\treturn err\n121|\t\t\t},\n122|\t\t},\n123|\t\t{\n124|\t\t\tname: \"tuple native_cli_family\", min: 1, max: 128,\n125|\t\t\tmember: \"native_cli_family\", text: \"string[1..128]\",\n126|\t\t\tdrive: func(t *testing.T, literal string) error {\n127|\t\t\t\t_, err := DecodeTupleEntry(mutateNested(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"resume_smoke_evidence\", \"native_cli_family\", literal))\n128|\t\t\t\treturn err\n129|\t\t\t},\n130|\t\t},\n131|\t\t{\n132|\t\t\tname: \"fidelity code\", min: 1, max: 128,\n133|\t\t\tmember: \"code\", text: \"string[1..128]\",\n134|\t\t\tdrive: func(t *testing.T, literal string) error {\n135|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(literal, `\"c\"`, `\"d\"`)+`]`, DirectionTargetWrite))\n136|\t\t\t\treturn err\n137|\t\t\t},\n138|\t\t},\n139|\t\t{\n140|\t\t\tname: \"fidelity affected_class\", min: 1, max: 128,\n141|\t\t\tmember: \"affected_class\", text: \"string[1..128]\",\n142|\t\t\tdrive: func(t *testing.T, literal string) error {\n143|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(`\"c\"`, literal, `\"d\"`)+`]`, DirectionTargetWrite))\n144|\t\t\t\treturn err\n145|\t\t\t},\n146|\t\t},\n147|\t\t{\n148|\t\t\tname: \"fidelity detail\", min: 1, max: 4096,\n149|\t\t\tmember: \"detail\", text: \"string[1..4096]\",\n150|\t\t\tdrive: func(t *testing.T, literal string) error {\n151|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(`\"c\"`, `\"a\"`, literal)+`]`, DirectionTargetWrite))\n152|\t\t\t\treturn err\n153|\t\t\t},\n154|\t\t},\n155|\t\t{\n156|\t\t\tname: \"contract identifier\", min: 1, max: 256,\n157|\t\t\tmember: \"contract_id\", text: \"string[1..256]\",\n158|\t\t\tdrive: func(t *testing.T, literal string) error {\n159|\t\t\t\t_, err := DecodeTupleEntry(withContracts(t, `[`+contractRow(literal, []string{`\"1.0.0\"`})+`]`))\n160|\t\t\t\treturn err\n161|\t\t\t},\n162|\t\t},\n163|\t\t{\n164|\t\t\tname: \"revocation reason\", min: 1, max: 4096,\n165|\t\t\tmember: \"revocation_reason\", text: \"string[1..4096]\",\n166|\t\t\tdrive: func(t *testing.T, literal string) error {\n167|\t\t\t\t_, err := DecodeTupleEntry(revokedWithReason(t, literal))\n168|\t\t\t\treturn err\n169|\t\t\t},\n170|\t\t},\n171|\t\t{\n172|\t\t\tname: \"probe detail\", min: 0, max: 2048,\n173|\t\t\tmember: \"tool_history\", text: \"string[0..2048]\",\n174|\t\t\tdrive: func(t *testing.T, literal string) error {\n175|\t\t\t\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n176|\t\t\t\tif err != nil {\n177|\t\t\t\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n178|\t\t\t\t}\n179|\t\t\t\tdigest := ManifestDigest(manifest).String()\n180|\t\t\t\tfixture := []byte(fixtureProbeJSON(digest))\n181|\t\t\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":`+literal+`}`)\n182|\t\t\t\t_, err = DecodeProbe(mutated)\n183|\t\t\t\treturn err\n184|\t\t\t},\n185|\t\t},\n186|\t}\n187|\tif len(rows) != 17 {\n188|\t\tt.Fatalf(\"string bound rows = %d, want 17; the table is short, not the package\", len(rows))\n189|\t}\n190|\tfor _, row := range rows {\n191|\t\trow := row\n192|\t\tt.Run(row.name, func(t *testing.T) {\n193|\t\t\t// One below the minimum refuses (the empty string\n194|\t\t\t// when min is 1); the minimum itself admits.\n195|\t\t\tif row.min > 0 {\n196|\t\t\t\tif err := row.drive(t, quotedRepeat(row.min-1)); err == nil {\n197|\t\t\t\t\tt.Fatalf(\"%s admitted length %d below the %d minimum\", row.name, row.min-1, row.min)\n198|\t\t\t\t} else {\n199|\t\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, row.text)\n200|\t\t\t\t}\n201|\t\t\t}\n202|\t\t\tif err := row.drive(t, quotedRepeat(row.min)); err != nil {\n203|\t\t\t\tt.Fatalf(\"%s refused length %d at the minimum: %v\", row.name, row.min, err)\n204|\t\t\t}\n205|\t\t\t// The maximum admits; one past it refuses.\n206|\t\t\tif err := row.drive(t, quotedRepeat(row.max)); err != nil {\n207|\t\t\t\tt.Fatalf(\"%s refused length %d at the maximum: %v\", row.name, row.max, err)\n208|\t\t\t}\n209|\t\t\tif err := row.drive(t, quotedRepeat(row.max+1)); err == nil {\n210|\t\t\t\tt.Fatalf(\"%s admitted length %d past the %d maximum\", row.name, row.max+1, row.max)\n211|\t\t\t} else {\n212|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, row.text)\n213|\t\t\t}\n214|\t\t})\n215|\t}\n216|}\n217|\n218|// checkResumeArgv drives one argv array through the resume-plan\n219|// success gate with the explicit identity occurring exactly once.\n220|func checkResumeArgv(t *testing.T, argv string) error {\n221|\tt.Helper()\n222|\tmanifestDigest := fixtureManifestDigestText(t)\n223|\trequest := fixtureRequestBody(t, OpResumePlan, manifestDigest)\n224|\tdecoded, err := CheckRequestBody(OpResumePlan, request)\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n227|\t}\n228|\tfacts := SuccessFacts{Context: decoded, ResumeTargetID: \"target-1\"}\n229|\tbase := fixtureSuccessBody(t, OpResumePlan, requestContextOf(t, request), manifestDigest)\n230|\treturn CheckSuccessBody(OpResumePlan, mutateMember(t, base, \"argv\", argv), facts)\n231|}\n232|\n233|// mutateNested replaces one member inside one nested object member\n234|// of a fixture body.\n235|func mutateNested(t *testing.T, body []byte, outer, inner, replacement string) []byte {\n236|\tt.Helper()\n237|\tvar members map[string]json.RawMessage\n238|\tif err := json.Unmarshal(body, &members); err != nil {\n239|\t\tt.Fatalf(\"mutateNested: fixture is not JSON: %v\", err)\n240|\t}\n241|\traw, present := members[outer]\n242|\tif !present {\n243|\t\tt.Fatalf(\"mutateNested: %q not in fixture\", outer)\n244|\t}\n245|\tvar nested map[string]json.RawMessage\n246|\tif err := json.Unmarshal(raw, &nested); err != nil {\n247|\t\tt.Fatalf(\"mutateNested: %q is not an object: %v\", outer, err)\n248|\t}\n249|\tif _, present := nested[inner]; !present {\n250|\t\tt.Fatalf(\"mutateNested: %q not in %q\", inner, outer)\n251|\t}\n252|\tnested[inner] = json.RawMessage(replacement)\n253|\trebuilt, err := json.Marshal(nested)\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"mutateNested: %v\", err)\n256|\t}\n257|\tmembers[outer] = rebuilt\n258|\tout, err := json.Marshal(members)\n259|\tif err != nil {\n260|\t\tt.Fatalf(\"mutateNested: %v\", err)\n261|\t}\n262|\treturn out\n263|}\n264|\n265|// fidelityRow builds one fidelity-limit row with the given raw\n266|// code, class, and detail literals.\n267|func fidelityRow(code, class, detail string) string {\n268|\treturn `{\"code\":` + code + `,\"affected_class\":` + class + `,\"maximum_disposition\":\"exact\",\"detail\":` + detail + `}`\n269|}\n270|\n271|// withFidelityLimits returns the target-write entry fixture with\n272|// the limit array replaced.\n273|func withFidelityLimits(t *testing.T, limits string, direction Direction) []byte {\n274|\tt.Helper()\n275|\treturn mutateMember(t, []byte(fixtureEntryJSON(direction)), \"known_fidelity_limits\", limits)\n276|}\n277|\n278|// contractRow builds one contract row with the given raw\n279|// identifier literal and raw version literals.\n280|func contractRow(identifier string, versions []string) string {\n281|\treturn `{\"contract_id\":` + identifier + `,\"versions\":[` + strings.Join(versions, \",\") + `]}`\n282|}\n283|\n284|// withContracts returns the target-write entry fixture with the\n285|// contract array replaced.\n286|func withContracts(t *testing.T, contracts string) []byte {\n287|\tt.Helper()\n288|\treturn mutateMember(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"contracts\", contracts)\n289|}\n290|\n291|// revokedWithReason returns the target-write entry fixture revoked\n292|// with the given raw reason literal.\n293|func revokedWithReason(t *testing.T, reason string) []byte {\n294|\tt.Helper()\n295|\tfixture := []byte(fixtureEntryJSON(DirectionTargetWrite))\n296|\trevoked := mutateMember(t, fixture, \"status\", `\"revoked\"`)\n297|\trevoked = mutateMember(t, revoked, \"revocation_reason\", reason)\n298|\treturn mutateMember(t, revoked, \"revoked_at\", `\"2026-06-02T00:00:00.000Z\"`)\n299|}\n300|\n301|// TestArrayBoundEdges drives every survivor array cap at its edge\n302|// through its production entry: empty, one, max, and max+1.\n303|func TestArrayBoundEdges(t *testing.T) {\n304|\tt.Run(\"resume argv 1..128\", func(t *testing.T) {\n305|\t\targv := func(n int) string {\n306|\t\t\tif n == 0 {\n307|\t\t\t\treturn `[]`\n308|\t\t\t}\n309|\t\t\treturn `[\"target-1\"` + strings.Repeat(`,\"w\"`, n-1) + `]`\n310|\t\t}\n311|\t\tif err := checkResumeArgv(t, argv(0)); err == nil {\n312|\t\t\tt.Fatal(\"admitted an empty argv\")\n313|\t\t} else {\n314|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"1..128 entries\")\n315|\t\t}\n316|\t\tif err := checkResumeArgv(t, argv(1)); err != nil {\n317|\t\t\tt.Fatalf(\"refused a one-word argv: %v\", err)\n318|\t\t}\n319|\t\tif err := checkResumeArgv(t, argv(128)); err != nil {\n320|\t\t\tt.Fatalf(\"refused a 128-word argv at the maximum: %v\", err)\n321|\t\t}\n322|\t\tif err := checkResumeArgv(t, argv(129)); err == nil {\n323|\t\t\tt.Fatal(\"admitted a 129-word argv past the 128 maximum\")\n324|\t\t} else {\n325|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"1..128 entries\")\n326|\t\t}\n327|\t})\n328|\tt.Run(\"required dispositions 1..7\", func(t *testing.T) {\n329|\t\tmanifestDigest := fixtureManifestDigestText(t)\n330|\t\tdrive := func(t *testing.T, value string) error {\n331|\t\t\trequest := fixtureRequestBody(t, OpProjectionPlan, manifestDigest)\n332|\t\t\t_, err := CheckRequestBody(OpProjectionPlan, mutateMember(t, request, \"required_dispositions\", value))\n333|\t\t\treturn err\n334|\t\t}\n335|\t\tseven := `{\"user_message\":[\"exact\",\"omitted\",\"opaque_preserved\",\"semantic\",\"summarized\",\"synthesized\",\"unrecoverable\"]}`\n336|\t\teight := `{\"user_message\":[\"exact\",\"omitted\",\"opaque_preserved\",\"semantic\",\"summarized\",\"synthesized\",\"unrecoverable\",\"exact\"]}`\n337|\t\tif err := drive(t, `{\"user_message\":[]}`); err == nil {\n338|\t\t\tt.Fatal(\"admitted an empty disposition list\")\n339|\t\t} else {\n340|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"1..7 entries\")\n341|\t\t}\n342|\t\tif err := drive(t, `{\"user_message\":[\"exact\"]}`); err != nil {\n343|\t\t\tt.Fatalf(\"refused a one-entry disposition list: %v\", err)\n344|\t\t}\n345|\t\tif err := drive(t, seven); err != nil {\n346|\t\t\tt.Fatalf(\"refused a seven-entry disposition list at the maximum: %v\", err)\n347|\t\t}\n348|\t\t// The count gate fires before the element gates, so the\n349|\t\t// eighth entry refuses on the count even though it also\n350|\t\t// repeats a member.\n351|\t\tif err := drive(t, eight); err == nil {\n352|\t\t\tt.Fatal(\"admitted an eight-entry disposition list past the 7 maximum\")\n353|\t\t} else {\n354|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"1..7 entries\")\n355|\t\t}\n356|\t})\n357|\tt.Run(\"contracts 1..64\", func(t *testing.T) {\n358|\t\tcontracts := func(n int) string {\n359|\t\t\trows := make([]string, 0, n)\n360|\t\t\tfor i := 1; i <= n; i++ {\n361|\t\t\t\trows = append(rows, contractRow(strconv.Quote(\"c\"+twoDigits(i)), []string{`\"1.0.0\"`}))\n362|\t\t\t}\n363|\t\t\treturn `[` + strings.Join(rows, \",\") + `]`\n364|\t\t}\n365|\t\tif _, err := DecodeTupleEntry(withContracts(t, `[]`)); err == nil {\n366|\t\t\tt.Fatal(\"admitted zero contract rows\")\n367|\t\t} else {\n368|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"contracts\", \"1..64 rows\")\n369|\t\t}\n370|\t\tif _, err := DecodeTupleEntry(withContracts(t, contracts(1))); err != nil {\n371|\t\t\tt.Fatalf(\"refused one contract row: %v\", err)\n372|\t\t}\n373|\t\tif _, err := DecodeTupleEntry(withContracts(t, contracts(64))); err != nil {\n374|\t\t\tt.Fatalf(\"refused 64 contract rows at the maximum: %v\", err)\n375|\t\t}\n376|\t\tif _, err := DecodeTupleEntry(withContracts(t, contracts(65))); err == nil {\n377|\t\t\tt.Fatal(\"admitted 65 contract rows past the 64 maximum\")\n378|\t\t} else {\n379|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"contracts\", \"1..64 rows\")\n380|\t\t}\n381|\t})\n382|\tt.Run(\"versions 1..32\", func(t *testing.T) {\n383|\t\tversions := func(n int) string {\n384|\t\t\tnames := make([]string, 0, n)\n385|\t\t\tfor i := 1; i <= n; i++ {\n386|\t\t\t\t// Zero-padded prerelease tags sort\n387|\t\t\t\t// lexicographically, so the sorted-unique\n388|\t\t\t\t// gate stays green while the count sweeps.\n389|\t\t\t\tnames = append(names, strconv.Quote(\"1.0.0-a\"+twoDigits(i)))\n390|\t\t\t}\n391|\t\t\treturn contractRow(`\"urn:ax:protocol:session-adapter\"`, names)\n392|\t\t}\n393|\t\tdrive := func(t *testing.T, row string) error {\n394|\t\t\t_, err := DecodeTupleEntry(withContracts(t, `[`+row+`]`))\n395|\t\t\treturn err\n396|\t\t}\n397|\t\tif err := drive(t, `{\"contract_id\":\"urn:ax:protocol:session-adapter\",\"versions\":[]}`); err == nil {\n398|\t\t\tt.Fatal(\"admitted zero versions\")\n399|\t\t} else {\n400|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"versions\", \"1..32 entries\")\n401|\t\t}\n402|\t\tif err := drive(t, versions(1)); err != nil {\n403|\t\t\tt.Fatalf(\"refused one version: %v\", err)\n404|\t\t}\n405|\t\tif err := drive(t, versions(32)); err != nil {\n406|\t\t\tt.Fatalf(\"refused 32 versions at the maximum: %v\", err)\n407|\t\t}\n408|\t\tif err := drive(t, versions(33)); err == nil {\n409|\t\t\tt.Fatal(\"admitted 33 versions past the 32 maximum\")\n410|\t\t} else {\n411|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"versions\", \"1..32 entries\")\n412|\t\t}\n413|\t})\n414|}\n415|\n416|// twoDigits renders i zero-padded to two digits for\n417|// lexicographically sortable fixture names.\n418|func twoDigits(i int) string {\n419|\tif i < 10 {\n420|\t\treturn \"0\" + strconv.Itoa(i)\n421|\t}\n422|\treturn strconv.Itoa(i)\n423|}"}}}
