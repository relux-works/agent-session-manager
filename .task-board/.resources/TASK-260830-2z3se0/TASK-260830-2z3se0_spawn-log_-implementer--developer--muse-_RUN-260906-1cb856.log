{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4dd","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":201,"recorded_at":1780531400000397,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"3e067480-a1a4-4a35-bdbd-c4e5bfa9e0cf"},"task_id":"3e067480-a1a4-4a35-bdbd-c4e5bfa9e0cf","event":{"kind":"output","task_id":"3e067480-a1a4-4a35-bdbd-c4e5bfa9e0cf","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/operations.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the fourteen Section 7.8 operation bodies:\n8|// the closed request member set per operation with the inline\n9|// scalar bounds, and the closed success member set with the\n10|// semantic gates the table states (discover partial/cursor,\n11|// capture-plan digest equality, validate mode coherence,\n12|// resume-plan identity occurrence, projection-plan disposition\n13|// rules).\n14|//\n15|// Nested objects owned by Sections 13.14 and 10.8\n16|// (CaptureBoundary, NativeIdentity, StableSnapshotProof,\n17|// CloneSourceSummary, FidelityCounts, WorkspaceBinding) are\n18|// required to be present JSON objects and are never inspected\n19|// further here: their content owners are the directory-node and\n20|// boundary leaves of this Story. requireNestedObject is the one\n21|// place that rule is enforced, so the bound is visible, not\n22|// scattered.\n23|\n24|// RefuseUnknownOperation refuses a dispatch name outside the\n25|// closed registry with operation_unknown. Dispatch refuses\n26|// locally, before any adapter surface is touched.\n27|func RefuseUnknownOperation(name string) error {\n28|\tfailure, err := failUnknownOperation(\"dispatch names an operation outside the closed registry\", name)\n29|\tif err != nil {\n30|\t\treturn err\n31|\t}\n32|\treturn failure\n33|}\n34|\n35|// contextFreeOperations is the set of operations whose request\n36|// bodies carry no context: manifest takes the empty object and\n37|// probe takes only the expected provider facts. Membership is a\n38|// table loop so the census derives it like every other closed\n39|// vocabulary: an inline `operation != X && operation != Y` chain\n40|// here would be invisible to the census, and a widened chain\n41|// would silently skip context decoding for a third operation.\n42|var contextFreeOperations = []Operation{\n43|\tOpManifest,\n44|\tOpProbe,\n45|}\n46|\n47|// operationSkipsRequestContext reports whether the operation's\n48|// request body carries no context member.\n49|func operationSkipsRequestContext(operation Operation) bool {\n50|\tfor _, free := range contextFreeOperations {\n51|\t\tif operation == free {\n52|\t\t\treturn true\n53|\t\t}\n54|\t}\n55|\treturn false\n56|}\n57|\n58|// RefuseUnavailableOperation reports an operation the adapter does\n59|// not implement with capability_unavailable. Every adapter\n60|// implements every name; an unavailable one is refused, never\n61|// emulated.\n62|func RefuseUnavailableOperation(operation Operation) error {\n63|\tfailure, err := failUnavailable(\"adapter does not implement the registry operation\", string(operation))\n64|\tif err != nil {\n65|\t\treturn err\n66|\t}\n67|\treturn failure\n68|}\n69|\n70|// requestBodyMembers maps each operation to its exact request-body\n71|// member set in Section 7.8 table order. The manifest body is the\n72|// empty object.\n73|var requestBodyMembers = map[Operation][]string{\n74|\tOpManifest:       {},\n75|\tOpProbe:          {\"expected_provider_id\", \"expected_candidate_kind\", \"extensions\"},\n76|\tOpDiscover:       {\"context\", \"authority\", \"workspace_filter\", \"limit\", \"cursor\", \"extensions\"},\n77|\tOpInspect:        {\"context\", \"authority\", \"source\", \"extensions\"},\n78|\tOpSnapshotProof:  {\"context\", \"authority\", \"source\", \"expected_source_store_generation\", \"allow_provider_quiescence\", \"extensions\"},\n79|\tOpCapturePlan:    {\"context\", \"authority\", \"source\", \"capture_boundary\", \"plan_sink\", \"max_items\", \"max_total_bytes\", \"extensions\"},\n80|\tOpCapture:        {\"context\", \"source_authority\", \"sink\", \"source\", \"capture_boundary\", \"capture_plan_digest\", \"extensions\"},\n81|\tOpNormalize:      {\"context\", \"capture_manifest_id\", \"raw_objects\", \"canonical_sink\", \"extensions\"},\n82|\tOpProjectionPlan: {\"context\", \"capture_manifest_id\", \"canonical_session_id\", \"canonical_event_ids\", \"source_objects\", \"plan_sink\", \"target_environment\", \"expected_target_native_session_id\", \"fidelity_profile\", \"required_dispositions\", \"forbid_reasons\", \"resource_limits\", \"extensions\"},\n83|\tOpProject:        {\"context\", \"projection_plan_id\", \"capture_manifest_id\", \"canonical_session_id\", \"source_objects\", \"target_sink\", \"extensions\"},\n84|\tOpReadBack:       {\"context\", \"authority\", \"expected_target_native_session_id\", \"projection_plan_id\", \"projected_object_manifest_id\", \"evidence_sink\", \"extensions\"},\n85|\tOpValidate:       {\"context\", \"mode\", \"capture_manifest_id\", \"canonical_session_id\", \"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\", \"extensions\"},\n86|\tOpResumePlan:     {\"context\", \"authority\", \"expected_target_native_session_id\", \"projection_plan_id\", \"target_checkpoint_id\", \"extensions\"},\n87|\tOpDoctor:         {\"context\", \"direction\", \"tuple_registry_digest\", \"refresh_requested\", \"extensions\"},\n88|}\n89|\n90|// successBodyMembers maps each operation to its exact success-body\n91|// member set. Manifest and probe successes decode through their\n92|// dedicated decoders; the rest validate here.\n93|var successBodyMembers = map[Operation][]string{\n94|\tOpManifest:       nil,\n95|\tOpProbe:          nil,\n96|\tOpDiscover:       {\"context\", \"sources\", \"next_cursor\", \"partial\", \"extensions\"},\n97|\tOpInspect:        {\"context\", \"source\", \"source_identity\", \"source_store_generation\", \"environment\", \"ambiguities\", \"extensions\"},\n98|\tOpSnapshotProof:  {\"context\", \"proof\", \"provider_quiescence_requested\", \"provider_quiescence_observed\", \"extensions\"},\n99|\tOpCapturePlan:    {\"context\", \"source_identity\", \"source_store_generation\", \"capture_plan_candidate_id\", \"candidate_count\", \"excluded_classes\", \"capture_plan_digest\", \"extensions\"},\n100|\tOpCapture:        {\"context\", \"capture_plan_digest\", \"source_store_generation\", \"capture_result_candidate_id\", \"source_raw_object_manifest_candidate_id\", \"item_count\", \"pre_capture_digest\", \"post_capture_digest\", \"extensions\"},\n101|\tOpNormalize:      {\"context\", \"capture_manifest_id\", \"canonical_session_candidate_id\", \"canonical_event_candidate_ids\", \"raw_reference_ids\", \"extensions\"},\n102|\tOpProjectionPlan: {\"context\", \"projection_plan_candidate_id\", \"required_source_object_ids\", \"predicted_counts\", \"findings\", \"extensions\"},\n103|\tOpProject:        {\"context\", \"projection_plan_id\", \"projected_object_manifest_candidate_id\", \"created_resource_keys\", \"actual_counts\", \"extensions\"},\n104|\tOpReadBack:       {\"context\", \"observed_target_native_session_id\", \"projection_plan_id\", \"observed_environment\", \"parsed_event_count\", \"parsed_head_ids\", \"workspace_binding\", \"structural_digest\", \"read_back_evidence_manifest_candidate_id\", \"extensions\"},\n105|\tOpValidate:       {\"context\", \"mode\", \"valid\", \"structural_valid\", \"semantic_marker_valid\", \"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\", \"findings\", \"evidence_digest\", \"extensions\"},\n106|\tOpResumePlan:     {\"context\", \"target_native_session_id\", \"projection_plan_id\", \"argv\", \"cwd_relative\", \"environment_names\", \"opens_existing_identity\", \"extensions\"},\n107|\tOpDoctor:         nil,\n108|}\n109|\n110|// requestMemberSet builds the closed set for one operation's\n111|// request body.\n112|func requestMemberSet(operation Operation) map[string]bool {\n113|\tset := map[string]bool{}\n114|\tfor _, name := range requestBodyMembers[operation] {\n115|\t\tset[name] = true\n116|\t}\n117|\treturn set\n118|}\n119|\n120|// successMemberSet builds the closed set for one operation's\n121|// success body.\n122|func successMemberSet(operation Operation) map[string]bool {\n123|\tset := map[string]bool{}\n124|\tfor _, name := range successBodyMembers[operation] {\n125|\t\tset[name] = true\n126|\t}\n127|\treturn set\n128|}\n129|\n130|// requireNestedObject requires the member to be a present JSON\n131|// object. Content owned by Sections 13.14 and 10.8 is never\n132|// inspected here; presence plus object shape is the whole rule,\n133|// and anything else — null, array, scalar — is a protocol error,\n134|// never an absent result.\n135|func requireNestedObject(members map[string]json.RawMessage, name string) error {\n136|\tif _, fault := decodeStrictObject(bytesTrimSpace(members[name])); fault != nil {\n137|\t\tfailure, err := failProtocol(\"operation body nested object \"+fault.detail, name)\n138|\t\tif err != nil {\n139|\t\t\treturn err\n140|\t\t}\n141|\t\treturn failure\n142|\t}\n143|\treturn nil\n144|}\n145|\n146|// requireDigest requires the member to be a digest.\n147|func requireDigest(members map[string]json.RawMessage, name string) error {\n148|\tif _, ok := checkDigest(members[name]); !ok {\n149|\t\tfailure, err := failProtocol(\"operation body digest member is not a digest\", name)\n150|\t\tif err != nil {\n151|\t\t\treturn err\n152|\t\t}\n153|\t\treturn failure\n154|\t}\n155|\treturn nil\n156|}\n157|\n158|// requireStringBounds requires the member to be a string in the\n159|// inclusive character bound.\n160|func requireStringBounds(members map[string]json.RawMessage, name string, minimum, maximum int) error {\n161|\tif _, ok := checkStringBounds(members[name], minimum, maximum); !ok {\n162|\t\tfailure, err := failProtocol(\"operation body string member is outside its bound\", name)\n163|\t\tif err != nil {\n164|\t\t\treturn err\n165|\t\t}\n166|\t\treturn failure\n167|\t}\n168|\treturn nil\n169|}\n170|\n171|// requireUint53Bounds requires the member to be a uint53 in the\n172|// inclusive bound. Both edges are enforced.\n173|func requireUint53Bounds(members map[string]json.RawMessage, name string, minimum, maximum uint64) error {\n174|\tif _, ok := checkUint53Bounds(members[name], minimum, maximum); !ok {\n175|\t\tfailure, err := failProtocol(\"operation body count member is outside its bound\", name)\n176|\t\tif err != nil {\n177|\t\t\treturn err\n178|\t\t}\n179|\t\treturn failure\n180|\t}\n181|\treturn nil\n182|}\n183|\n184|// requireBool requires the member to be a boolean.\n185|func requireBool(members map[string]json.RawMessage, name string) (bool, error) {\n186|\tvalue, ok := rawBool(members[name])\n187|\tif !ok {\n188|\t\tfailure, err := failProtocol(\"operation body flag member is not a boolean\", name)\n189|\t\tif err != nil {\n190|\t\t\treturn false, err\n191|\t\t}\n192|\t\treturn false, failure\n193|\t}\n194|\treturn value, nil\n195|}\n196|\n197|// requireNullableDigest requires the member to be null or a\n198|// digest.\n199|func requireNullableDigest(members map[string]json.RawMessage, name string) error {\n200|\tif isNull(members[name]) {\n201|\t\treturn nil\n202|\t}\n203|\treturn requireDigest(members, name)\n204|}\n205|\n206|// requireNullableBool requires the member to be null or a\n207|// boolean.\n208|func requireNullableBool(members map[string]json.RawMessage, name string) error {\n209|\tif isNull(members[name]) {\n210|\t\treturn nil\n211|\t}\n212|\t_, err := requireBool(members, name)\n213|\treturn err\n214|}\n215|\n216|// CheckRequestBody validates one outbound request body for its\n217|// operation: the exact member set, the call context where the\n218|// operation carries one, and the inline scalar bounds Section 7.8\n219|// states. The manifest body must be the empty object; an unknown\n220|// operation is operation_unknown. The decoded context is returned\n221|// for the digest binding and the call checks; manifest and probe\n222|// carry no context and return the zero value.\n223|func CheckRequestBody(operation Operation, body []byte) (CallContext, error) {\n224|\tif !validOperation(string(operation)) {\n225|\t\tfailure, err := failUnknownOperation(\"request body names an operation outside the closed registry\", string(operation))\n226|\t\tif err != nil {\n227|\t\t\treturn CallContext{}, err\n228|\t\t}\n229|\t\treturn CallContext{}, failure\n230|\t}\n231|\tmembers, fault := decodeStrictObject(body)\n232|\tif fault != nil {\n233|\t\tfailure, err := failProtocol(\"request body \"+fault.detail, fault.member)\n234|\t\tif err != nil {\n235|\t\t\treturn CallContext{}, err\n236|\t\t}\n237|\t\treturn CallContext{}, failure\n238|\t}\n239|\tallowed := requestMemberSet(operation)\n240|\tif name, unknown := unknownMember(members, allowed); unknown {\n241|\t\tfailure, err := failProtocol(\"request body carries unknown member\", name)\n242|\t\tif err != nil {\n243|\t\t\treturn CallContext{}, err\n244|\t\t}\n245|\t\treturn CallContext{}, failure\n246|\t}\n247|\tif name, missing := missingMember(members, requestBodyMembers[operation]); missing {\n248|\t\tfailure, err := failProtocol(\"request body misses a required member\", name)\n249|\t\tif err != nil {\n250|\t\t\treturn CallContext{}, err\n251|\t\t}\n252|\t\treturn CallContext{}, failure\n253|\t}\n254|\tvar context CallContext\n255|\tif !operationSkipsRequestContext(operation) {\n256|\t\tdecoded, err := DecodeCallContext(members[\"context\"])\n257|\t\tif err != nil {\n258|\t\t\treturn CallContext{}, err\n259|\t\t}\n260|\t\tcontext = decoded\n261|\t}\n262|\tif err := checkRequestScalars(operation, members); err != nil {\n263|\t\treturn CallContext{}, err\n264|\t}\n265|\treturn context, nil\n266|}\n267|\n268|// checkRequestScalars validates the inline scalar members of one\n269|// request body: authorities, selectors, limits, enums, and bounds.\n270|// Nested Section 13.14/10.8 objects validate for presence only.\n271|func checkRequestScalars(operation Operation, members map[string]json.RawMessage) error {\n272|\tswitch operation {\n273|\tcase OpManifest:\n274|\t\treturn nil\n275|\tcase OpProbe:\n276|\t\tif provider, ok := rawString(members[\"expected_provider_id\"]); !ok || !providerIDPattern.MatchString(provider) {\n277|\t\t\tfailure, err := failProtocol(\"probe request provider identifier is not a provider-id\", \"expected_provider_id\")\n278|\t\t\tif err != nil {\n279|\t\t\t\treturn err\n280|\t\t\t}\n281|\t\t\treturn failure\n282|\t\t}\n283|\t\tif kind, ok := rawString(members[\"expected_candidate_kind\"]); !ok || !validCandidateKind(CandidateKind(kind)) {\n284|\t\t\tfailure, err := failProtocol(\"probe request candidate kind is outside builtin|external\", \"expected_candidate_kind\")\n285|\t\t\tif err != nil {\n286|\t\t\t\treturn err\n287|\t\t\t}\n288|\t\t\treturn failure\n289|\t\t}\n290|\t\tif !checkExtensions(members[\"extensions\"]) {\n291|\t\t\tfailure, err := failProtocol(\"probe request extensions are not reverse-DNS keyed\", \"extensions\")\n292|\t\t\tif err != nil {\n293|\t\t\t\treturn err\n294|\t\t\t}\n295|\t\t\treturn failure\n296|\t\t}\n297|\t\treturn nil\n298|\tcase OpDiscover:\n299|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n300|\t\t\treturn err\n301|\t\t}\n302|\t\tif !isNull(members[\"workspace_filter\"]) {\n303|\t\t\tif _, ok := checkUUIDv7(members[\"workspace_filter\"]); !ok {\n304|\t\t\t\tfailure, err := failProtocol(\"discover workspace filter is not a UUIDv7\", \"workspace_filter\")\n305|\t\t\t\tif err != nil {\n306|\t\t\t\t\treturn err\n307|\t\t\t\t}\n308|\t\t\t\treturn failure\n309|\t\t\t}\n310|\t\t}\n311|\t\tif err := requireUint53Bounds(members, \"limit\", 1, 65536); err != nil {\n312|\t\t\treturn err\n313|\t\t}\n314|\t\tif !isNull(members[\"cursor\"]) {\n315|\t\t\tif err := requireStringBounds(members, \"cursor\", 1, 1024); err != nil {\n316|\t\t\t\treturn err\n317|\t\t\t}\n318|\t\t}\n319|\tcase OpInspect:\n320|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n321|\t\t\treturn err\n322|\t\t}\n323|\t\tif _, err := DecodeSourceSelector(members[\"source\"]); err != nil {\n324|\t\t\treturn err\n325|\t\t}\n326|\tcase OpSnapshotProof:\n327|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n328|\t\t\treturn err\n329|\t\t}\n330|\t\tif _, err := DecodeSourceSelector(members[\"source\"]); err != nil {\n331|\t\t\treturn err\n332|\t\t}\n333|\t\tif err := requireStringBounds(members, \"expected_source_store_generation\", 1, 512); err != nil {\n334|\t\t\treturn err\n335|\t\t}\n336|\t\tif _, err := requireBool(members, \"allow_provider_quiescence\"); err != nil {\n337|\t\t\treturn err\n338|\t\t}\n339|\tcase OpCapturePlan:\n340|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n341|\t\t\treturn err\n342|\t\t}\n343|\t\tif _, err := DecodeSourceSelector(members[\"source\"]); err != nil {\n344|\t\t\treturn err\n345|\t\t}\n346|\t\tif err := requireNestedObject(members, \"capture_boundary\"); err != nil {\n347|\t\t\treturn err\n348|\t\t}\n349|\t\tif _, err := DecodeObjectAuthority(members[\"plan_sink\"]); err != nil {\n350|\t\t\treturn err\n351|\t\t}\n352|\t\tif err := requireUint53Bounds(members, \"max_items\", 1, 65536); err != nil {\n353|\t\t\treturn err\n354|\t\t}\n355|\t\tif err := requireUint53Bounds(members, \"max_total_bytes\", 1, maxUint53); err != nil {\n356|\t\t\treturn err\n357|\t\t}\n358|\tcase OpCapture:\n359|\t\tif _, err := DecodeReadAuthority(members[\"source_authority\"]); err != nil {\n360|\t\t\treturn err\n361|\t\t}\n362|\t\tif _, err := DecodeObjectAuthority(members[\"sink\"]); err != nil {\n363|\t\t\treturn err\n364|\t\t}\n365|\t\tif _, err := DecodeSourceSelector(members[\"source\"]); err != nil {\n366|\t\t\treturn err\n367|\t\t}\n368|\t\tif err := requireNestedObject(members, \"capture_boundary\"); err != nil {\n369|\t\t\treturn err\n370|\t\t}\n371|\t\tif err := requireDigest(members, \"capture_plan_digest\"); err != nil {\n372|\t\t\treturn err\n373|\t\t}\n374|\tcase OpNormalize:\n375|\t\tif err := requireDigest(members, \"capture_manifest_id\"); err != nil {\n376|\t\t\treturn err\n377|\t\t}\n378|\t\tif _, err := DecodeObjectAuthority(members[\"raw_objects\"]); err != nil {\n379|\t\t\treturn err\n380|\t\t}\n381|\t\tif _, err := DecodeObjectAuthority(members[\"canonical_sink\"]); err != nil {\n382|\t\t\treturn err\n383|\t\t}\n384|\tcase OpProjectionPlan:\n385|\t\tif err := requireDigest(members, \"capture_manifest_id\"); err != nil {\n386|\t\t\treturn err\n387|\t\t}\n388|\t\tif err := requireDigest(members, \"canonical_session_id\"); err != nil {\n389|\t\t\treturn err\n390|\t\t}\n391|\t\tif _, ok := checkSortedUniqueDigests(members[\"canonical_event_ids\"], 0, 65536); !ok {\n392|\t\t\tfailure, faultErr := failProtocol(\"projection request canonical event identifiers are not sorted unique digest[0..65536]\", \"canonical_event_ids\")\n393|\t\t\tif faultErr != nil {\n394|\t\t\t\treturn faultErr\n395|\t\t\t}\n396|\t\t\treturn failure\n397|\t\t}\n398|\t\tif _, err := DecodeObjectAuthority(members[\"source_objects\"]); err != nil {\n399|\t\t\treturn err\n400|\t\t}\n401|\t\tif _, err := DecodeObjectAuthority(members[\"plan_sink\"]); err != nil {\n402|\t\t\treturn err\n403|\t\t}\n404|\t\tif _, err := DecodeTuple(members[\"target_environment\"]); err != nil {\n405|\t\t\treturn err\n406|\t\t}\n407|\t\tif err := requireStringBounds(members, \"expected_target_native_session_id\", 1, 512); err != nil {\n408|\t\t\treturn err\n409|\t\t}\n410|\t\tif profile, ok := rawString(members[\"fidelity_profile\"]); !ok || !validFidelityProfile(profile) {\n411|\t\t\tfailure, err := failProtocol(\"projection request fidelity profile is outside the four-profile vocabulary\", \"fidelity_profile\")\n412|\t\t\tif err != nil {\n413|\t\t\t\treturn err\n414|\t\t\t}\n415|\t\t\treturn failure\n416|\t\t}\n417|\t\tif err := checkRequiredDispositions(members[\"required_dispositions\"]); err != nil {\n418|\t\t\treturn err\n419|\t\t}\n420|\t\tif _, ok := checkSortedUniqueStrings(members[\"forbid_reasons\"], 1, 128, 0, 128); !ok {\n421|\t\t\tfailure, err := failProtocol(\"projection request forbid reasons are not sorted-unique-string[1..128][0..128]\", \"forbid_reasons\")\n422|\t\t\tif err != nil {\n423|\t\t\t\treturn err\n424|\t\t\t}\n425|\t\t\treturn failure\n426|\t\t}\n427|\t\tif _, err := DecodeResourceLimits(members[\"resource_limits\"]); err != nil {\n428|\t\t\treturn err\n429|\t\t}\n430|\tcase OpProject:\n431|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n432|\t\t\treturn err\n433|\t\t}\n434|\t\tif err := requireDigest(members, \"capture_manifest_id\"); err != nil {\n435|\t\t\treturn err\n436|\t\t}\n437|\t\tif err := requireDigest(members, \"canonical_session_id\"); err != nil {\n438|\t\t\treturn err\n439|\t\t}\n440|\t\tif _, err := DecodeObjectAuthority(members[\"source_objects\"]); err != nil {\n441|\t\t\treturn err\n442|\t\t}\n443|\t\tif _, err := DecodeObjectAuthority(members[\"target_sink\"]); err != nil {\n444|\t\t\treturn err\n445|\t\t}\n446|\tcase OpReadBack:\n447|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n448|\t\t\treturn err\n449|\t\t}\n450|\t\tif err := requireStringBounds(members, \"expected_target_native_session_id\", 1, 512); err != nil {\n451|\t\t\treturn err\n452|\t\t}\n453|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n454|\t\t\treturn err\n455|\t\t}\n456|\t\tif err := requireDigest(members, \"projected_object_manifest_id\"); err != nil {\n457|\t\t\treturn err\n458|\t\t}\n459|\t\tif _, err := DecodeObjectAuthority(members[\"evidence_sink\"]); err != nil {\n460|\t\t\treturn err\n461|\t\t}\n462|\tcase OpValidate:\n463|\t\tif mode, ok := rawString(members[\"mode\"]); !ok || !validValidateMode(mode) {\n464|\t\t\tfailure, err := failProtocol(\"validate request mode is outside staged|live|archive\", \"mode\")\n465|\t\t\tif err != nil {\n466|\t\t\t\treturn err\n467|\t\t\t}\n468|\t\t\treturn failure\n469|\t\t}\n470|\t\tif err := requireDigest(members, \"capture_manifest_id\"); err != nil {\n471|\t\t\treturn err\n472|\t\t}\n473|\t\tif err := requireDigest(members, \"canonical_session_id\"); err != nil {\n474|\t\t\treturn err\n475|\t\t}\n476|\t\tif err := requireNullableDigest(members, \"projection_plan_id\"); err != nil {\n477|\t\t\treturn err\n478|\t\t}\n479|\t\tif err := requireNullableDigest(members, \"projected_object_manifest_id\"); err != nil {\n480|\t\t\treturn err\n481|\t\t}\n482|\t\tif err := requireNullableDigest(members, \"read_back_evidence_manifest_id\"); err != nil {\n483|\t\t\treturn err\n484|\t\t}\n485|\t\tif !isNull(members[\"expected_target_native_session_id\"]) {\n486|\t\t\tif err := requireStringBounds(members, \"expected_target_native_session_id\", 1, 512); err != nil {\n487|\t\t\t\treturn err\n488|\t\t\t}\n489|\t\t}\n490|\t\tif err := checkValidateNullability(members); err != nil {\n491|\t\t\treturn err\n492|\t\t}\n493|\tcase OpResumePlan:\n494|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n495|\t\t\treturn err\n496|\t\t}\n497|\t\tif err := requireStringBounds(members, \"expected_target_native_session_id\", 1, 512); err != nil {\n498|\t\t\treturn err\n499|\t\t}\n500|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n(more lines below)"}}}
