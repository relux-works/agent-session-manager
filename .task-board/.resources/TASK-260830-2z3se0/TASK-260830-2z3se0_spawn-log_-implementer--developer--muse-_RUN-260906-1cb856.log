{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c497","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":166,"recorded_at":1780531400000327,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"df048fa6-3646-451f-86f6-6f75c4182817"},"task_id":"df048fa6-3646-451f-86f6-6f75c4182817","event":{"kind":"output","task_id":"df048fa6-3646-451f-86f6-6f75c4182817","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.8 closed\n15|// body. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing\n18|// every arm. A helper that fronted a constructor would collapse\n19|// distinct rules into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer:\n22|// Section 7.8 counts and limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// frameFault is one strict-decode failure: what was wrong and which\n26|// member it was found in, if any. It never carries foreign bytes.\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|// decodeStrictObject parses one complete JSON object with duplicate\n33|// member rejection. It is the only JSON entry point in this package:\n34|// every body crosses it before any member is read. A non-UTF-8\n35|// frame, a lone surrogate escape, a non-object top level, a\n36|// duplicated member, or trailing data is a fault, never a partial\n37|// object the caller could mistake for a result.\n38|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n39|\tif !utf8.Valid(data) {\n40|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n41|\t}\n42|\tif hasLoneSurrogateEscape(data) {\n43|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n44|\t}\n45|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n46|\ttoken, err := decoder.Token()\n47|\tif err != nil {\n48|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n49|\t}\n50|\tdelim, ok := token.(json.Delim)\n51|\tif !ok || delim != '{' {\n52|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n53|\t}\n54|\tmembers := map[string]json.RawMessage{}\n55|\tfor decoder.More() {\n56|\t\tkeyToken, err := decoder.Token()\n57|\t\tif err != nil {\n58|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n59|\t\t}\n60|\t\tkey, ok := keyToken.(string)\n61|\t\tif !ok {\n62|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n63|\t\t}\n64|\t\tif _, duplicate := members[key]; duplicate {\n65|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n66|\t\t}\n67|\t\tvar raw json.RawMessage\n68|\t\tif err := decoder.Decode(&raw); err != nil {\n69|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n70|\t\t}\n71|\t\tmembers[key] = raw\n72|\t}\n73|\tif token, err := decoder.Token(); err != nil {\n74|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n75|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n76|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n77|\t}\n78|\tif _, err := decoder.Token(); err != io.EOF {\n79|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n80|\t}\n81|\treturn members, nil\n82|}\n83|\n84|// hasLoneSurrogateEscape reports whether the raw frame carries a\n85|// UTF-16 escape the JSON string grammar cannot pair: a high\n86|// surrogate not followed by a low surrogate, a low surrogate with no\n87|// high surrogate before it, or a truncated escape. Go's encoding/json\n88|// would otherwise replace the lone escape with U+FFFD silently, so\n89|// Section 1.6 wire bodies carrying lone surrogates would be admitted\n90|// with rewritten bytes. This is a local copy of the shared surrogate\n91|// rule because the shared implementation is unexported; the agreement\n92|// test pins it against canonicaljson.Canonicalize over a generated\n93|// escape corpus whose verdicts come from construction, not from\n94|// either implementation.\n95|func hasLoneSurrogateEscape(data []byte) bool {\n96|\tfor index := 0; index < len(data); index++ {\n97|\t\tif data[index] != '\\\\' {\n98|\t\t\tcontinue\n99|\t\t}\n100|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n101|\t\t\tcontinue\n102|\t\t}\n103|\t\tfirst, length := readUTF16Escape(data, index+2)\n104|\t\tif length < 0 {\n105|\t\t\treturn true\n106|\t\t}\n107|\t\tindex += 1 + length\n108|\t\tif first >= 0xD800 && first <= 0xDBFF {\n109|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n110|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n111|\t\t\t\treturn true\n112|\t\t\t}\n113|\t\t\tindex += 6\n114|\t\t\tcontinue\n115|\t\t}\n116|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n117|\t\t\treturn true\n118|\t\t}\n119|\t}\n120|\treturn false\n121|}\n122|\n123|// readUTF16Escape reads four hex digits at the offset. It returns the\n124|// value and the consumed length, or a negative length when the escape\n125|// is truncated or not hexadecimal.\n126|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n127|\tif offset+4 > len(data) {\n128|\t\treturn 0, -1\n129|\t}\n130|\tvar value uint16\n131|\tfor _, digit := range data[offset : offset+4] {\n132|\t\tvalue <<= 4\n133|\t\tswitch {\n134|\t\tcase digit >= '0' && digit <= '9':\n135|\t\t\tvalue |= uint16(digit - '0')\n136|\t\tcase digit >= 'a' && digit <= 'f':\n137|\t\t\tvalue |= uint16(digit-'a') + 10\n138|\t\tcase digit >= 'A' && digit <= 'F':\n139|\t\t\tvalue |= uint16(digit-'A') + 10\n140|\t\tdefault:\n141|\t\t\treturn 0, -1\n142|\t\t}\n143|\t}\n144|\treturn value, 4\n145|}\n146|\n147|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n148|// at the offset. Anything else — a truncated escape, a non-escape,\n149|// or input end — is a negative length.\n150|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n151|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n152|\t\treturn 0, -1\n153|\t}\n154|\treturn readUTF16Escape(data, offset+2)\n155|}\n156|\n157|// unknownMember names a member outside the closed set, if any. The\n158|// single-unknown fixtures keep the verdict deterministic: with\n159|// several unknowns the map order decides which is named, so tests\n160|// never assert a name from a multi-unknown body.\n161|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n162|\tfor name := range members {\n163|\t\tif !allowed[name] {\n164|\t\t\treturn name, true\n165|\t\t}\n166|\t}\n167|\treturn \"\", false\n168|}\n169|\n170|// missingMember names the first required member with no value, if\n171|// any. The required list is fixed order, so the verdict is\n172|// deterministic for every missing combination.\n173|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n174|\tfor _, name := range required {\n175|\t\tif _, present := members[name]; !present {\n176|\t\t\treturn name, true\n177|\t\t}\n178|\t}\n179|\treturn \"\", false\n180|}\n181|\n182|// rawString reads a JSON string member.\n183|func rawString(raw json.RawMessage) (string, bool) {\n184|\tvar value string\n185|\tif err := json.Unmarshal(raw, &value); err != nil {\n186|\t\treturn \"\", false\n187|\t}\n188|\treturn value, true\n189|}\n190|\n191|// rawBool reads a JSON boolean member.\n192|func rawBool(raw json.RawMessage) (bool, bool) {\n193|\tvar value bool\n194|\tif err := json.Unmarshal(raw, &value); err != nil {\n195|\t\treturn false, false\n196|\t}\n197|\treturn value, true\n198|}\n199|\n200|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n201|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n202|// even when it names the same mathematical value: the canonical\n203|// bodies carry counts, never measurements.\n204|func rawUint53(raw json.RawMessage) (uint64, bool) {\n205|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n206|\tdecoder.UseNumber()\n207|\tvar value any\n208|\tif err := decoder.Decode(&value); err != nil {\n209|\t\treturn 0, false\n210|\t}\n211|\tnumber, ok := value.(json.Number)\n212|\tif !ok {\n213|\t\treturn 0, false\n214|\t}\n215|\tliteral := number.String()\n216|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n217|\t\treturn 0, false\n218|\t}\n219|\treturn parseUint53Literal(literal)\n220|}\n221|\n222|// parseUint53Literal reads a digit-only literal without trusting a\n223|// float conversion: the magnitude bound is checked on the digit\n224|// string, so 2^53 is refused even on platforms that could hold it.\n225|func parseUint53Literal(literal string) (uint64, bool) {\n226|\tvar value uint64\n227|\tfor index := 0; index < len(literal); index++ {\n228|\t\tdigit := literal[index]\n229|\t\tif digit < '0' || digit > '9' {\n230|\t\t\treturn 0, false\n231|\t\t}\n232|\t\tvalue = value*10 + uint64(digit-'0')\n233|\t\tif value > maxUint53 {\n234|\t\t\treturn 0, false\n235|\t\t}\n236|\t}\n237|\treturn value, true\n238|}\n239|\n240|// stringLength is the Section 1.6 string measure in characters, not\n241|// bytes: a bound of string[1..128] admits 128 characters of any\n242|// width.\n243|func stringLength(value string) int {\n244|\treturn utf8.RuneCountInString(value)\n245|}\n246|\n247|// checkStringBounds reports whether the member is a JSON string whose\n248|// character count falls in the inclusive bound.\n249|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n250|\tvalue, ok := rawString(raw)\n251|\tif !ok {\n252|\t\treturn \"\", false\n253|\t}\n254|\tlength := stringLength(value)\n255|\tif length < minimum || length > maximum {\n256|\t\treturn \"\", false\n257|\t}\n258|\treturn value, true\n259|}\n260|\n261|// checkUint53Bounds reports whether the member is a uint53 in the\n262|// inclusive bound. Both edges are checked: a one-sided check would\n263|// admit the open side.\n264|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n265|\tvalue, ok := rawUint53(raw)\n266|\tif !ok {\n267|\t\treturn 0, false\n268|\t}\n269|\tif value < minimum || value > maximum {\n270|\t\treturn 0, false\n271|\t}\n272|\treturn value, true\n273|}\n274|\n275|// checkDigest reports whether the member is a digest of the pinned\n276|// sha256 form.\n277|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n278|\tvalue, ok := rawString(raw)\n279|\tif !ok {\n280|\t\treturn scalar.Digest{}, false\n281|\t}\n282|\tdigest, err := scalar.ParseDigest(value)\n283|\tif err != nil {\n284|\t\treturn scalar.Digest{}, false\n285|\t}\n286|\treturn digest, true\n287|}\n288|\n289|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n290|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n291|\tvalue, ok := rawString(raw)\n292|\tif !ok {\n293|\t\treturn scalar.UUIDv7{}, false\n294|\t}\n295|\tidentifier, err := scalar.ParseUUIDv7(value)\n296|\tif err != nil {\n297|\t\treturn scalar.UUIDv7{}, false\n298|\t}\n299|\treturn identifier, true\n300|}\n301|\n302|// checkTimestamp reports whether the member is a pinned timestamp.\n303|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Timestamp{}, false\n307|\t}\n308|\tinstant, err := scalar.ParseTimestamp(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Timestamp{}, false\n311|\t}\n312|\treturn instant, true\n313|}\n314|\n315|// isNull reports whether the member is an explicit JSON null.\n316|func isNull(raw json.RawMessage) bool {\n317|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n318|}\n319|\n320|// decodeArray reads a JSON array member into its raw elements. A\n321|// non-array — including null — is not an empty array.\n322|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n323|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n324|\ttoken, err := decoder.Token()\n325|\tif err != nil {\n326|\t\treturn nil, false\n327|\t}\n328|\tdelim, ok := token.(json.Delim)\n329|\tif !ok || delim != '[' {\n330|\t\treturn nil, false\n331|\t}\n332|\tvar elements []json.RawMessage\n333|\tfor decoder.More() {\n334|\t\tvar element json.RawMessage\n335|\t\tif err := decoder.Decode(&element); err != nil {\n336|\t\t\treturn nil, false\n337|\t\t}\n338|\t\telements = append(elements, element)\n339|\t}\n340|\tif token, err := decoder.Token(); err != nil {\n341|\t\treturn nil, false\n342|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n343|\t\treturn nil, false\n344|\t}\n345|\tif _, err := decoder.Token(); err != io.EOF {\n346|\t\treturn nil, false\n347|\t}\n348|\treturn elements, true\n349|}\n350|\n351|// checkSortedUniqueStrings reports whether the member is an array of\n352|// strings in the item bound whose JCS encodings order strictly\n353|// increasingly with no duplicates. Bytewise JCS order over strings\n354|// is plain lexicographic order, so the check compares directly; the\n355|// count bound is checked on both edges.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// semverPattern is the SemVer grammar adapter and environment\n411|// versions satisfy: three dot-separated non-negative integers with\n412|// no leading zeros, an optional pre-release, and optional build\n413|// metadata.\n414|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n415|\n416|// providerIDPattern is the Section 7.1 provider-id grammar the\n417|// manifest, context, and binding layers read:\n418|// [a-z][a-z0-9-]{0,31}.\n419|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n420|\n421|// environmentIDPattern is the Section 7.8 environment-id grammar:\n422|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n423|// adapter; dots separate the native hierarchy, never trust.\n424|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n425|\n426|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n427|// dot-separated lowercase labels, 3..253 characters.\n428|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n429|\n430|// checkExtensions reports whether the member is an object whose keys\n431|// are all reverse-DNS names. Values cross opaquely: extensions\n432|// cannot add operations, capabilities, or trust facts, and no member\n433|// of this package reads an extension value for any admission\n434|// decision.\n435|func checkExtensions(raw json.RawMessage) bool {\n436|\tmembers, fault := decodeStrictObject(raw)\n437|\tif fault != nil {\n438|\t\treturn false\n439|\t}\n440|\tfor name := range members {\n441|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n442|\t\t\treturn false\n443|\t\t}\n444|\t}\n445|\treturn true\n446|}"}}}
