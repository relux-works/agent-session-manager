{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c49f","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":170,"recorded_at":1780531400000335,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"43929644-798f-4dd7-ba9c-d1517a8fd55f"},"task_id":"43929644-798f-4dd7-ba9c-d1517a8fd55f","event":{"kind":"output","task_id":"43929644-798f-4dd7-ba9c-d1517a8fd55f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/manifest.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Section 7.8 Session Adapter Manifest: the\n11|// closed urn:ax:schema:session-adapter-manifest 1.0.0 object a\n12|// manifest operation returns as its success body. The manifest\n13|// declares possible surfaces, not runtime availability; every member\n14|// below is required and the object is closed.\n15|\n16|// manifestSchema is the exact schema identifier the manifest carries.\n17|const manifestSchema = \"urn:ax:schema:session-adapter-manifest\"\n18|\n19|// manifestSchemaVersion is the only manifest version this host accepts.\n20|const manifestSchemaVersion = \"1.0.0\"\n21|\n22|// capabilityOrder is the exact fifteen-name ordered capability\n23|// registry Section 7.8 shows. The manifest and every probe body\n24|// carry exactly these names in this order; a sixteenth name\n25|// advertises a surface the contract never defined, and a missing\n26|// name hides one it did.\n27|var capabilityOrder = []string{\n28|\t\"native_discovery\",\n29|\t\"stable_snapshot\",\n30|\t\"raw_capture\",\n31|\t\"canonical_read\",\n32|\t\"canonical_write\",\n33|\t\"native_read_back\",\n34|\t\"native_resume_plan\",\n35|\t\"official_import\",\n36|\t\"same_environment_lossless_clone\",\n37|\t\"tool_history\",\n38|\t\"usage_history\",\n39|\t\"compaction_history\",\n40|\t\"subagent_graph\",\n41|\t\"opaque_reasoning_roundtrip\",\n42|\t\"workspace_binding\",\n43|}\n44|\n45|// Capabilities returns the Section 7.8 capability registry in order.\n46|// The result is a copy; the registry cannot be mutated through it.\n47|func Capabilities() []string {\n48|\treturn append([]string(nil), capabilityOrder...)\n49|}\n50|\n51|// manifestMembers is the exact required member set DecodeManifest\n52|// accepts: the schema envelope, identity, versioning, platforms, the\n53|// Section 7.8 operation registry in section order, and the\n54|// capability registry above.\n55|var manifestMembers = map[string]bool{\n56|\t\"schema\":                    true,\n57|\t\"schema_version\":            true,\n58|\t\"provider_id\":               true,\n59|\t\"environment_id\":            true,\n60|\t\"display_name\":              true,\n61|\t\"adapter_version\":           true,\n62|\t\"environment_version_range\": true,\n63|\t\"platforms\":                 true,\n64|\t\"operations\":                true,\n65|\t\"capability_names\":          true,\n66|\t\"extensions\":                true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"environment_id\",\n76|\t\"display_name\",\n77|\t\"adapter_version\",\n78|\t\"environment_version_range\",\n79|\t\"platforms\",\n80|\t\"operations\",\n81|\t\"capability_names\",\n82|\t\"extensions\",\n83|}\n84|\n85|// Manifest is the validated Session Adapter Manifest 1.0.0: the\n86|// provider and environment identity plus the ordered registries the\n87|// probe and dispatch layers check. The canonical body is retained\n88|// for the host-computed digest.\n89|type Manifest struct {\n90|\tProviderID     string\n91|\tEnvironmentID  string\n92|\tAdapterVersion string\n93|\tPlatforms      []string\n94|\tOperations     []string\n95|\tCapabilities   []string\n96|\tcanonical      []byte\n97|}\n98|\n99|// Canonical returns the JCS bytes the digest was computed over.\n100|func (manifest Manifest) Canonical() []byte {\n101|\treturn append([]byte(nil), manifest.canonical...)\n102|}\n103|\n104|// DecodeManifest validates one manifest-operation success body as the\n105|// closed Section 7.8 Session Adapter Manifest. A manifest whose\n106|// operations differ from the dispatch registry, or whose capability\n107|// names differ from the registry above, advertises a surface the\n108|// host cannot invoke or hides one it must, so both are refused\n109|// outright.\n110|func DecodeManifest(body []byte) (Manifest, error) {\n111|\tmembers, fault := decodeStrictObject(body)\n112|\tif fault != nil {\n113|\t\tfailure, err := failProtocol(\"adapter manifest \"+fault.detail, fault.member)\n114|\t\tif err != nil {\n115|\t\t\treturn Manifest{}, err\n116|\t\t}\n117|\t\treturn Manifest{}, failure\n118|\t}\n119|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n120|\t\tfailure, err := failProtocol(\"adapter manifest carries unknown member\", name)\n121|\t\tif err != nil {\n122|\t\t\treturn Manifest{}, err\n123|\t\t}\n124|\t\treturn Manifest{}, failure\n125|\t}\n126|\tif name, missing := missingMember(members, manifestRequired); missing {\n127|\t\tfailure, err := failProtocol(\"adapter manifest misses a required member\", name)\n128|\t\tif err != nil {\n129|\t\t\treturn Manifest{}, err\n130|\t\t}\n131|\t\treturn Manifest{}, failure\n132|\t}\n133|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n134|\t\tfailure, err := failProtocol(\"adapter manifest schema is not the session adapter manifest\", \"schema\")\n135|\t\tif err != nil {\n136|\t\t\treturn Manifest{}, err\n137|\t\t}\n138|\t\treturn Manifest{}, failure\n139|\t}\n140|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n141|\t\tfailure, err := failProtocol(\"adapter manifest version is not 1.0.0\", \"schema_version\")\n142|\t\tif err != nil {\n143|\t\t\treturn Manifest{}, err\n144|\t\t}\n145|\t\treturn Manifest{}, failure\n146|\t}\n147|\tproviderID, ok := rawString(members[\"provider_id\"])\n148|\tif !ok || !providerIDPattern.MatchString(providerID) {\n149|\t\tfailure, err := failProtocol(\"adapter manifest provider identifier is not a provider-id\", \"provider_id\")\n150|\t\tif err != nil {\n151|\t\t\treturn Manifest{}, err\n152|\t\t}\n153|\t\treturn Manifest{}, failure\n154|\t}\n155|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n156|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n157|\t\tfailure, err := failProtocol(\"adapter manifest environment identifier is not an environment-id\", \"environment_id\")\n158|\t\tif err != nil {\n159|\t\t\treturn Manifest{}, err\n160|\t\t}\n161|\t\treturn Manifest{}, failure\n162|\t}\n163|\tif _, ok := checkStringBounds(members[\"display_name\"], 1, 128); !ok {\n164|\t\tfailure, err := failProtocol(\"adapter manifest display name is not a string[1..128]\", \"display_name\")\n165|\t\tif err != nil {\n166|\t\t\treturn Manifest{}, err\n167|\t\t}\n168|\t\treturn Manifest{}, failure\n169|\t}\n170|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n171|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n172|\t\tfailure, err := failProtocol(\"adapter manifest adapter version is not SemVer\", \"adapter_version\")\n173|\t\tif err != nil {\n174|\t\t\treturn Manifest{}, err\n175|\t\t}\n176|\t\treturn Manifest{}, failure\n177|\t}\n178|\tif _, ok := checkStringBounds(members[\"environment_version_range\"], 1, 256); !ok {\n179|\t\tfailure, err := failProtocol(\"adapter manifest environment version range is not a non-empty string[1..256]\", \"environment_version_range\")\n180|\t\tif err != nil {\n181|\t\t\treturn Manifest{}, err\n182|\t\t}\n183|\t\treturn Manifest{}, failure\n184|\t}\n185|\tplatforms, ok := checkSortedUniqueStrings(members[\"platforms\"], 1, 16, 1, 4)\n186|\tif !ok {\n187|\t\tfailure, err := failProtocol(\"adapter manifest platforms are not a sorted unique non-empty subset\", \"platforms\")\n188|\t\tif err != nil {\n189|\t\t\treturn Manifest{}, err\n190|\t\t}\n191|\t\treturn Manifest{}, failure\n192|\t}\n193|\tfor _, platform := range platforms {\n194|\t\tif _, err := scalar.ParsePlatform(platform); err != nil {\n195|\t\t\tfailure, faultErr := failProtocol(\"adapter manifest platform is outside linux|macos|windows|wsl2\", \"platforms\")\n196|\t\t\tif faultErr != nil {\n197|\t\t\t\treturn Manifest{}, faultErr\n198|\t\t\t}\n199|\t\t\treturn Manifest{}, failure\n200|\t\t}\n201|\t}\n202|\toperations, ok := checkOperationRegistry(members[\"operations\"])\n203|\tif !ok {\n204|\t\tfailure, err := failProtocol(\"adapter manifest operations are not the complete ordered fourteen-name registry\", \"operations\")\n205|\t\tif err != nil {\n206|\t\t\treturn Manifest{}, err\n207|\t\t}\n208|\t\treturn Manifest{}, failure\n209|\t}\n210|\tcapabilities, ok := checkCapabilityRegistry(members[\"capability_names\"])\n211|\tif !ok {\n212|\t\tfailure, err := failProtocol(\"adapter manifest capability names are not the complete ordered fifteen-name registry\", \"capability_names\")\n213|\t\tif err != nil {\n214|\t\t\treturn Manifest{}, err\n215|\t\t}\n216|\t\treturn Manifest{}, failure\n217|\t}\n218|\tif !checkExtensions(members[\"extensions\"]) {\n219|\t\tfailure, err := failProtocol(\"adapter manifest extensions are not reverse-DNS keyed\", \"extensions\")\n220|\t\tif err != nil {\n221|\t\t\treturn Manifest{}, err\n222|\t\t}\n223|\t\treturn Manifest{}, failure\n224|\t}\n225|\tcanonical, err := canonicaljson.Canonicalize(body)\n226|\tif err != nil {\n227|\t\tfailure, faultErr := failProtocol(\"adapter manifest is not canonical JSON\", \"\")\n228|\t\tif faultErr != nil {\n229|\t\t\treturn Manifest{}, faultErr\n230|\t\t}\n231|\t\treturn Manifest{}, failure\n232|\t}\n233|\treturn Manifest{\n234|\t\tProviderID:     providerID,\n235|\t\tEnvironmentID:  environmentID,\n236|\t\tAdapterVersion: adapterVersion,\n237|\t\tPlatforms:      platforms,\n238|\t\tOperations:     operations,\n239|\t\tCapabilities:   capabilities,\n240|\t\tcanonical:      canonical,\n241|\t}, nil\n242|}\n243|\n244|// checkOperationRegistry reports whether the member is exactly the\n245|// dispatch registry in section order: same names, same positions,\n246|// same length. Sortedness is not the rule here — order is — so the\n247|// comparison is element-wise against operationOrder.\n248|func checkOperationRegistry(raw json.RawMessage) ([]string, bool) {\n249|\telements, ok := decodeArray(raw)\n250|\tif !ok || len(elements) != len(operationOrder) {\n251|\t\treturn nil, false\n252|\t}\n253|\toperations := make([]string, 0, len(elements))\n254|\tfor index, element := range elements {\n255|\t\tname, ok := rawString(element)\n256|\t\tif !ok || name != string(operationOrder[index]) {\n257|\t\t\treturn nil, false\n258|\t\t}\n259|\t\toperations = append(operations, name)\n260|\t}\n261|\treturn operations, true\n262|}\n263|\n264|// checkCapabilityRegistry reports whether the member is exactly the\n265|// fifteen-name capability registry in section order.\n266|func checkCapabilityRegistry(raw json.RawMessage) ([]string, bool) {\n267|\telements, ok := decodeArray(raw)\n268|\tif !ok || len(elements) != len(capabilityOrder) {\n269|\t\treturn nil, false\n270|\t}\n271|\tcapabilities := make([]string, 0, len(elements))\n272|\tfor index, element := range elements {\n273|\t\tname, ok := rawString(element)\n274|\t\tif !ok || name != capabilityOrder[index] {\n275|\t\t\treturn nil, false\n276|\t\t}\n277|\t\tcapabilities = append(capabilities, name)\n278|\t}\n279|\treturn capabilities, true\n280|}\n281|\n282|// ManifestDigest returns the host-computed JCS SHA-256 of the\n283|// validated manifest: the session_adapter_manifest_digest. It is\n284|// computed by the host, never embedded by the adapter, so a\n285|// manifest that names its own digest cannot mint trust.\n286|func ManifestDigest(manifest Manifest) scalar.Digest {\n287|\treturn scalar.SHA256Digest(manifest.canonical)\n288|}"}}}
