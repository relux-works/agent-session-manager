{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8bb","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":696,"recorded_at":1780531400001387,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"8f6959f2-1560-454b-bfa8-cf4ee41863fb"},"task_id":"8f6959f2-1560-454b-bfa8-cf4ee41863fb","event":{"kind":"output","task_id":"8f6959f2-1560-454b-bfa8-cf4ee41863fb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe_test.go`.\n(172 line(s) above)\n173|func TestCheckProbeEqualities(t *testing.T) {\n174|\tprobe, manifest := fixtureValidProbe(t)\n175|\tdigest := ManifestDigest(manifest).String()\n176|\tfacts := ProbeHostFacts{\n177|\t\tExpectedProviderID: fixtureProviderID,\n178|\t\tExpectedKind:       CandidateBuiltin,\n179|\t\tManifestDigest:     digest,\n180|\t\tManifest:           manifest,\n181|\t}\n182|\tif err := CheckProbe(probe, facts); err != nil {\n183|\t\tt.Fatalf(\"CheckProbe: %v\", err)\n184|\t}\n185|\t// Every equality is broken alone: provider vs request, provider\n186|\t// vs manifest, digest, version, tuple environment, and tuple\n187|\t// adapter version.\n188|\totherDigest := fixtureDigest(\"other-manifest\")\n189|\tfor _, test := range []struct {\n190|\t\tname  string\n191|\t\tprobe Probe\n192|\t\tfacts ProbeHostFacts\n193|\t\tkey   string\n194|\t\tvalue string\n195|\t\ttext  string\n196|\t}{\n197|\t\t{\n198|\t\t\tname: \"provider vs request\", probe: probe,\n199|\t\t\tfacts: ProbeHostFacts{ExpectedProviderID: \"other-provider\", ExpectedKind: CandidateBuiltin, ManifestDigest: digest, Manifest: manifest},\n200|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"requested provider\",\n201|\t\t},\n202|\t\t{\n203|\t\t\tname:  \"provider vs manifest\",\n204|\t\t\tprobe: func() Probe { mutated := probe; mutated.ProviderID = \"other-provider\"; return mutated }(),\n205|\t\t\tfacts: func() ProbeHostFacts { fixed := facts; fixed.ExpectedProviderID = \"other-provider\"; return fixed }(),\n206|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"verified manifest\",\n207|\t\t},\n208|\t\t{\n209|\t\t\tname:  \"manifest digest\",\n210|\t\t\tprobe: func() Probe { mutated := probe; mutated.ManifestDigest = otherDigest; return mutated }(),\n211|\t\t\tfacts: facts, key: \"member\", value: \"adapter_manifest_digest\", text: \"host-computed digest\",\n212|\t\t},\n213|\t\t{\n214|\t\t\tname:  \"adapter version\",\n215|\t\t\tprobe: func() Probe { mutated := probe; mutated.AdapterVersion = \"9.9.9\"; return mutated }(),\n216|\t\t\tfacts: facts, key: \"member\", value: \"adapter_version\", text: \"verified manifest\",\n217|\t\t},\n218|\t\t{\n219|\t\t\tname:  \"unrequested tuple\",\n220|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.EnvironmentID = \"other.env\"; return mutated }(),\n221|\t\t\tfacts: facts, key: \"environment\", value: \"other.env\", text: \"outside the manifest environment\",\n222|\t\t},\n223|\t\t{\n224|\t\t\tname:  \"tuple version disagrees\",\n225|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.AdapterVersion = \"0.0.1\"; return mutated }(),\n226|\t\t\tfacts: facts, key: \"member\", value: \"environment\", text: \"probe adapter version\",\n227|\t\t},\n228|\t} {\n229|\t\tt.Run(test.name, func(t *testing.T) {\n230|\t\t\terr := CheckProbe(test.probe, test.facts)\n231|\t\t\tif test.key == \"environment\" && (test.name == \"unrequested tuple\") {\n232|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", test.key, test.value, test.text)\n233|\t\t\t\treturn\n234|\t\t\t}\n235|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n236|\t\t})\n237|\t}\n238|}\n239|\n240|// TestZeroValueHostFactsRefuse pins the fail-closed half of the\n241|// host-fact equality gates: a caller that forgets a fact field\n242|// gets a refusal, never an admission. Each zero field with a\n243|// non-empty probe side refuses through its own arm, so a mutant\n244|// that only refuses when the expected side is non-empty\n245|// (`!= expected && expected != \"\"`) slides the arm or admits,\n246|// and reddens here.\n247|func TestZeroValueHostFactsRefuse(t *testing.T) {\n248|\tprobe, manifest := fixtureValidProbe(t)\n249|\tdigest := ManifestDigest(manifest).String()\n250|\tt.Run(\"zero expected provider\", func(t *testing.T) {\n251|\t\terr := CheckProbe(probe, ProbeHostFacts{})\n252|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"requested provider\")\n253|\t})\n254|\tt.Run(\"zero manifest environment\", func(t *testing.T) {\n255|\t\tempty := manifest\n256|\t\tempty.EnvironmentID = \"\"\n257|\t\tfacts := ProbeHostFacts{\n258|\t\t\tExpectedProviderID: fixtureProviderID,\n259|\t\t\tExpectedKind:       CandidateBuiltin,\n260|\t\t\tManifestDigest:     digest,\n261|\t\t\tManifest:           empty,\n262|\t\t}\n263|\t\terr := CheckProbe(probe, facts)\n264|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"outside the manifest environment\")\n265|\t})\n266|\tt.Run(\"zero expected candidate kind\", func(t *testing.T) {\n267|\t\terr := CheckProbeRequest(fixtureProviderID, \"\", fixtureCandidate())\n268|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n269|\t})\n270|}\n271|\n272|func TestCheckProbeRequest(t *testing.T) {\n273|\tcandidate := fixtureCandidate()\n274|\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, candidate); err != nil {\n275|\t\tt.Fatalf(\"CheckProbeRequest: %v\", err)\n276|\t}\n277|\tif err := CheckProbeRequest(\"other-provider\", CandidateBuiltin, candidate); err == nil {\n278|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign provider identifier\")\n279|\t} else {\n280|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n281|\t}\n282|\tif err := CheckProbeRequest(fixtureProviderID, CandidateExternal, candidate); err == nil {\n283|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign candidate kind\")\n284|\t} else {\n285|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n286|\t}\n287|}\n288|\n289|// TestCheckDoctorHealthyDrivesEveryRequiredCapability derives\n290|// the required set from DoctorRequiredCapabilities and breaks\n291|// every member alone: a healthy accepted result passes whole,\n292|// and weakening any single required capability refuses naming\n293|// that capability. A loop truncation (required[:1]) admits a\n294|// weakened later member and reddens here, which a one-member\n295|// probe cannot catch.\n296|func TestCheckDoctorHealthyDrivesEveryRequiredCapability(t *testing.T) {\n297|\tmanifestDigest := fixtureManifestDigestText(t)\n298|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n299|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n300|\tif err != nil {\n301|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n302|\t}\n303|\tprobe, _ := fixtureValidProbe(t)\n304|\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n305|\thealthy := mutateMember(t, good, \"healthy\", `true`)\n306|\tfor _, official := range []bool{false, true} {\n307|\t\trequired := DoctorRequiredCapabilities(DirectionTargetWrite, official)\n308|\t\tif len(required) != 4 {\n309|\t\t\tt.Fatalf(\"official=%v required = %v, want the derived four-capability set\", official, required)\n310|\t\t}\n311|\t\tresult, err := DecodeDoctorResult(healthy, decoded, DirectionSourceRead)\n312|\t\tif err != nil {\n313|\t\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n314|\t\t}\n315|\t\tif err := CheckDoctorHealthy(result, probe, required); err != nil {\n316|\t\t\tt.Fatalf(\"official=%v CheckDoctorHealthy whole: %v\", official, err)\n317|\t\t}\n318|\t\tfor _, name := range required {\n319|\t\t\tt.Run(fmt.Sprintf(\"official=%v/%s\", official, name), func(t *testing.T) {\n320|\t\t\t\tweakened := probe\n321|\t\t\t\tweakened.Capabilities = cloneCapabilities(probe.Capabilities)\n322|\t\t\t\tweakened.Capabilities[name] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n323|\t\t\t\terr := CheckDoctorHealthy(result, weakened, required)\n324|\t\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", name, \"usable required capability\")\n325|\t\t\t})\n326|\t\t}\n327|\t}\n328|}\n329|\n330|func TestCheckTargetWriteGates(t *testing.T) {\n331|\tprobe, _ := fixtureValidProbe(t)\n332|\tprovider := map[string]ProviderCapability{\n(more lines below)"}}}
