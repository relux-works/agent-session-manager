{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d9","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":199,"recorded_at":1780531400000393,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"2ce032a6-4093-47b2-ba69-c53fe785d20e"},"task_id":"2ce032a6-4093-47b2-ba69-c53fe785d20e","event":{"kind":"output","task_id":"2ce032a6-4093-47b2-ba69-c53fe785d20e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/context.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the reusable closed body types Section 7.8\n12|// defines: AdapterCallContext with its request-digest binding,\n13|// ReadAuthority, ObjectAuthority with the fresh-sink rule,\n14|// SourceSelector with its exactly-one rule, AdapterFinding,\n15|// ResourceLimits, and CapturePlanItem.\n16|\n17|// contextMembers is the exact AdapterCallContext member set: the\n18|// operation UUID, provider, environment, manifest and executable\n19|// digests, request digest, and extensions.\n20|var contextMembers = map[string]bool{\n21|\t\"operation_id\":                    true,\n22|\t\"provider_id\":                     true,\n23|\t\"environment\":                     true,\n24|\t\"session_adapter_manifest_digest\": true,\n25|\t\"executable_sha256\":               true,\n26|\t\"request_digest\":                  true,\n27|\t\"extensions\":                      true,\n28|}\n29|\n30|// contextRequired lists contextMembers in a fixed order.\n31|var contextRequired = []string{\n32|\t\"operation_id\",\n33|\t\"provider_id\",\n34|\t\"environment\",\n35|\t\"session_adapter_manifest_digest\",\n36|\t\"executable_sha256\",\n37|\t\"request_digest\",\n38|\t\"extensions\",\n39|}\n40|\n41|// CallContext is one validated AdapterCallContext. The raw member\n42|// is retained so the success echo can be compared byte-for-byte:\n43|// the adapter must echo the context exactly, not rebuild it.\n44|type CallContext struct {\n45|\tOperationID      string\n46|\tProviderID       string\n47|\tEnvironment      Tuple\n48|\tManifestDigest   string\n49|\tExecutableSHA256 string\n50|\tRequestDigest    string\n51|\traw              []byte\n52|}\n53|\n54|// Raw returns the canonical context bytes for echo comparison.\n55|func (context CallContext) Raw() []byte {\n56|\treturn append([]byte(nil), context.raw...)\n57|}\n58|\n59|// DecodeCallContext validates one closed AdapterCallContext.\n60|func DecodeCallContext(raw json.RawMessage) (CallContext, error) {\n61|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n62|\tif fault != nil {\n63|\t\tfailure, err := failProtocol(\"call context \"+fault.detail, fault.member)\n64|\t\tif err != nil {\n65|\t\t\treturn CallContext{}, err\n66|\t\t}\n67|\t\treturn CallContext{}, failure\n68|\t}\n69|\tif name, unknown := unknownMember(members, contextMembers); unknown {\n70|\t\tfailure, err := failProtocol(\"call context carries unknown member\", name)\n71|\t\tif err != nil {\n72|\t\t\treturn CallContext{}, err\n73|\t\t}\n74|\t\treturn CallContext{}, failure\n75|\t}\n76|\tif name, missing := missingMember(members, contextRequired); missing {\n77|\t\tfailure, err := failProtocol(\"call context misses a required member\", name)\n78|\t\tif err != nil {\n79|\t\t\treturn CallContext{}, err\n80|\t\t}\n81|\t\treturn CallContext{}, failure\n82|\t}\n83|\toperationID, ok := checkUUIDv7(members[\"operation_id\"])\n84|\tif !ok {\n85|\t\tfailure, err := failProtocol(\"call context operation identifier is not a UUIDv7\", \"operation_id\")\n86|\t\tif err != nil {\n87|\t\t\treturn CallContext{}, err\n88|\t\t}\n89|\t\treturn CallContext{}, failure\n90|\t}\n91|\tproviderID, ok := rawString(members[\"provider_id\"])\n92|\tif !ok || !providerIDPattern.MatchString(providerID) {\n93|\t\tfailure, err := failProtocol(\"call context provider identifier is not a provider-id\", \"provider_id\")\n94|\t\tif err != nil {\n95|\t\t\treturn CallContext{}, err\n96|\t\t}\n97|\t\treturn CallContext{}, failure\n98|\t}\n99|\tenvironment, err := DecodeTuple(members[\"environment\"])\n100|\tif err != nil {\n101|\t\treturn CallContext{}, err\n102|\t}\n103|\tmanifestDigest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n104|\tif !ok {\n105|\t\tfailure, faultErr := failProtocol(\"call context manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n106|\t\tif faultErr != nil {\n107|\t\t\treturn CallContext{}, faultErr\n108|\t\t}\n109|\t\treturn CallContext{}, failure\n110|\t}\n111|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n112|\tif !ok {\n113|\t\tfailure, faultErr := failProtocol(\"call context executable digest is not a digest\", \"executable_sha256\")\n114|\t\tif faultErr != nil {\n115|\t\t\treturn CallContext{}, faultErr\n116|\t\t}\n117|\t\treturn CallContext{}, failure\n118|\t}\n119|\trequestDigest, ok := checkDigest(members[\"request_digest\"])\n120|\tif !ok {\n121|\t\tfailure, faultErr := failProtocol(\"call context request digest is not a digest\", \"request_digest\")\n122|\t\tif faultErr != nil {\n123|\t\t\treturn CallContext{}, faultErr\n124|\t\t}\n125|\t\treturn CallContext{}, failure\n126|\t}\n127|\tif !checkExtensions(members[\"extensions\"]) {\n128|\t\tfailure, faultErr := failProtocol(\"call context extensions are not reverse-DNS keyed\", \"extensions\")\n129|\t\tif faultErr != nil {\n130|\t\t\treturn CallContext{}, faultErr\n131|\t\t}\n132|\t\treturn CallContext{}, failure\n133|\t}\n134|\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(raw))\n135|\tif err != nil {\n136|\t\tfailure, faultErr := failProtocol(\"call context is not canonical JSON\", \"\")\n137|\t\tif faultErr != nil {\n138|\t\t\treturn CallContext{}, faultErr\n139|\t\t}\n140|\t\treturn CallContext{}, failure\n141|\t}\n142|\treturn CallContext{\n143|\t\tOperationID:      operationID.String(),\n144|\t\tProviderID:       providerID,\n145|\t\tEnvironment:      environment,\n146|\t\tManifestDigest:   manifestDigest.String(),\n147|\t\tExecutableSHA256: executable.String(),\n148|\t\tRequestDigest:    requestDigest.String(),\n149|\t\traw:              canonical,\n150|\t}, nil\n151|}\n152|\n153|// RequestDigestFor computes the request digest the host binds into\n154|// the call context: the SHA-256 of the JCS request body with only\n155|// the context's request_digest member omitted. The omission is\n156|// what makes the digest computable: the host computes it over the\n157|// body it is about to send, writes it into the context, and sends;\n158|// reinsertion cannot change the digest because the digested form\n159|// never contained the member. A body with no context member\n160|// digests whole.\n161|func RequestDigestFor(requestBody []byte) (scalar.Digest, error) {\n162|\tcanonical, err := canonicaljson.Canonicalize(requestBody)\n163|\tif err != nil {\n164|\t\treturn scalar.Digest{}, err\n165|\t}\n166|\tvar body map[string]any\n167|\tif err := json.Unmarshal(canonical, &body); err != nil {\n168|\t\treturn scalar.Digest{}, err\n169|\t}\n170|\tif context, ok := body[\"context\"].(map[string]any); ok {\n171|\t\tdelete(context, \"request_digest\")\n172|\t\tredacted, err := json.Marshal(body)\n173|\t\tif err != nil {\n174|\t\t\treturn scalar.Digest{}, err\n175|\t\t}\n176|\t\tcanonical, err = canonicaljson.Canonicalize(redacted)\n177|\t\tif err != nil {\n178|\t\t\treturn scalar.Digest{}, err\n179|\t\t}\n180|\t}\n181|\treturn scalar.SHA256Digest(canonical), nil\n182|}\n183|\n184|// VerifyRequestDigest recomputes the digest of the canonical request\n185|// body the host sent and requires it to equal the context's\n186|// request_digest: the adapter answers for exactly this body, not\n187|// for a neighbouring call. A changed body under a replayed context\n188|// is a protocol error, never a retried mutation.\n189|func VerifyRequestDigest(context CallContext, requestBody []byte) error {\n190|\tdigest, err := RequestDigestFor(requestBody)\n191|\tif err != nil {\n192|\t\tfailure, faultErr := failProtocol(\"call request body is not canonical JSON\", \"body\")\n193|\t\tif faultErr != nil {\n194|\t\t\treturn faultErr\n195|\t\t}\n196|\t\treturn failure\n197|\t}\n198|\tif digest.String() != context.RequestDigest {\n199|\t\tfailure, err := failProtocol(\"call context request digest does not match the request body\", \"request_digest\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\treturn nil\n206|}\n207|\n208|// CheckContextEcho requires the success body to carry the request\n209|// context byte-for-byte: Section 7.8 states every success echoes\n210|// the context exactly. A rebuilt context — even a semantically\n211|// equal one — is a protocol error, because only byte identity\n212|// proves the adapter answered this call. DecodeCallContext\n213|// already returns the canonical bytes, so the comparison reuses\n214|// them: a second canonicalization of the same bytes could only\n215|// repeat its verdict, and an arm that cannot fire is not\n216|// carried.\n217|func CheckContextEcho(sent CallContext, echoed json.RawMessage) (CallContext, error) {\n218|\treceived, err := DecodeCallContext(echoed)\n219|\tif err != nil {\n220|\t\treturn CallContext{}, err\n221|\t}\n222|\tif !bytes.Equal(received.raw, sent.raw) {\n223|\t\tfailure, err := failProtocol(\"success context does not echo the request context byte-for-byte\", \"context\")\n224|\t\tif err != nil {\n225|\t\t\treturn CallContext{}, err\n226|\t\t}\n227|\t\treturn CallContext{}, failure\n228|\t}\n229|\treturn received, nil\n230|}\n231|\n232|// readAuthorityMembers is the exact ReadAuthority member set:\n233|// authority_id, purpose, root_handle_names, expires_at, and\n234|// extensions. Handle names identify host-opened descriptors\n235|// delivered out of band; they are never paths.\n236|var readAuthorityMembers = map[string]bool{\n237|\t\"authority_id\":      true,\n238|\t\"purpose\":           true,\n239|\t\"root_handle_names\": true,\n240|\t\"expires_at\":        true,\n241|\t\"extensions\":        true,\n242|}\n243|\n244|// readAuthorityRequired lists readAuthorityMembers in order.\n245|var readAuthorityRequired = []string{\n246|\t\"authority_id\",\n247|\t\"purpose\",\n248|\t\"root_handle_names\",\n249|\t\"expires_at\",\n250|\t\"extensions\",\n251|}\n252|\n253|// ReadAuthority is one validated read authority.\n254|type ReadAuthority struct {\n255|\tAuthorityID string\n256|\tPurpose     string\n257|\tHandleNames []string\n258|\tExpiresAt   string\n259|}\n260|\n261|// DecodeReadAuthority validates one closed ReadAuthority: the\n262|// purpose in source_native|target_staged|target_live and 1..128\n263|// sorted unique handle names of 1..128 characters each.\n264|func DecodeReadAuthority(raw json.RawMessage) (ReadAuthority, error) {\n265|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n266|\tif fault != nil {\n267|\t\tfailure, err := failProtocol(\"read authority \"+fault.detail, fault.member)\n268|\t\tif err != nil {\n269|\t\t\treturn ReadAuthority{}, err\n270|\t\t}\n271|\t\treturn ReadAuthority{}, failure\n272|\t}\n273|\tif name, unknown := unknownMember(members, readAuthorityMembers); unknown {\n274|\t\tfailure, err := failProtocol(\"read authority carries unknown member\", name)\n275|\t\tif err != nil {\n276|\t\t\treturn ReadAuthority{}, err\n277|\t\t}\n278|\t\treturn ReadAuthority{}, failure\n279|\t}\n280|\tif name, missing := missingMember(members, readAuthorityRequired); missing {\n281|\t\tfailure, err := failProtocol(\"read authority misses a required member\", name)\n282|\t\tif err != nil {\n283|\t\t\treturn ReadAuthority{}, err\n284|\t\t}\n285|\t\treturn ReadAuthority{}, failure\n286|\t}\n287|\tauthorityID, ok := checkUUIDv7(members[\"authority_id\"])\n288|\tif !ok {\n289|\t\tfailure, err := failProtocol(\"read authority identifier is not a UUIDv7\", \"authority_id\")\n290|\t\tif err != nil {\n291|\t\t\treturn ReadAuthority{}, err\n292|\t\t}\n293|\t\treturn ReadAuthority{}, failure\n294|\t}\n295|\tpurpose, ok := rawString(members[\"purpose\"])\n296|\tif !ok || !validReadPurpose(purpose) {\n297|\t\tfailure, err := failProtocol(\"read authority purpose is outside source_native|target_staged|target_live\", \"purpose\")\n298|\t\tif err != nil {\n299|\t\t\treturn ReadAuthority{}, err\n300|\t\t}\n301|\t\treturn ReadAuthority{}, failure\n302|\t}\n303|\thandles, ok := checkSortedUniqueStrings(members[\"root_handle_names\"], 1, 128, 1, 128)\n304|\tif !ok {\n305|\t\tfailure, err := failProtocol(\"read authority handle names are not sorted unique string[1..128][1..128]\", \"root_handle_names\")\n306|\t\tif err != nil {\n307|\t\t\treturn ReadAuthority{}, err\n308|\t\t}\n309|\t\treturn ReadAuthority{}, failure\n310|\t}\n311|\texpiresAt, ok := checkTimestamp(members[\"expires_at\"])\n312|\tif !ok {\n313|\t\tfailure, err := failProtocol(\"read authority expiry is not a timestamp\", \"expires_at\")\n314|\t\tif err != nil {\n315|\t\t\treturn ReadAuthority{}, err\n316|\t\t}\n317|\t\treturn ReadAuthority{}, failure\n318|\t}\n319|\tif !checkExtensions(members[\"extensions\"]) {\n320|\t\tfailure, err := failProtocol(\"read authority extensions are not reverse-DNS keyed\", \"extensions\")\n321|\t\tif err != nil {\n322|\t\t\treturn ReadAuthority{}, err\n323|\t\t}\n324|\t\treturn ReadAuthority{}, failure\n325|\t}\n326|\treturn ReadAuthority{\n327|\t\tAuthorityID: authorityID.String(),\n328|\t\tPurpose:     purpose,\n329|\t\tHandleNames: handles,\n330|\t\tExpiresAt:   expiresAt.String(),\n331|\t}, nil\n332|}\n333|\n334|// objectAuthorityMembers is the exact ObjectAuthority member set:\n335|// authority_id, purpose, mode, max_objects, max_total_bytes, and\n336|// extensions.\n337|var objectAuthorityMembers = map[string]bool{\n338|\t\"authority_id\":    true,\n339|\t\"purpose\":         true,\n340|\t\"mode\":            true,\n341|\t\"max_objects\":     true,\n342|\t\"max_total_bytes\": true,\n343|\t\"extensions\":      true,\n344|}\n345|\n346|// objectAuthorityRequired lists objectAuthorityMembers in order.\n347|var objectAuthorityRequired = []string{\n348|\t\"authority_id\",\n349|\t\"purpose\",\n350|\t\"mode\",\n351|\t\"max_objects\",\n352|\t\"max_total_bytes\",\n353|\t\"extensions\",\n354|}\n355|\n356|// ObjectAuthority is one validated object authority.\n357|type ObjectAuthority struct {\n358|\tAuthorityID   string\n359|\tPurpose       string\n360|\tMode          string\n361|\tMaxObjects    uint64\n362|\tMaxTotalBytes uint64\n363|}\n364|\n365|// DecodeObjectAuthority validates one closed ObjectAuthority: the\n366|// purpose in the six-purpose vocabulary, the mode in\n367|// read|fresh_sink, and the two limits as uint53. fresh_sink with a\n368|// zero limit is refused here; whether the sink is empty is host\n369|// state the caller asserts through CheckFreshSink.\n370|func DecodeObjectAuthority(raw json.RawMessage) (ObjectAuthority, error) {\n371|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n372|\tif fault != nil {\n373|\t\tfailure, err := failProtocol(\"object authority \"+fault.detail, fault.member)\n374|\t\tif err != nil {\n375|\t\t\treturn ObjectAuthority{}, err\n376|\t\t}\n377|\t\treturn ObjectAuthority{}, failure\n378|\t}\n379|\tif name, unknown := unknownMember(members, objectAuthorityMembers); unknown {\n380|\t\tfailure, err := failProtocol(\"object authority carries unknown member\", name)\n381|\t\tif err != nil {\n382|\t\t\treturn ObjectAuthority{}, err\n383|\t\t}\n384|\t\treturn ObjectAuthority{}, failure\n385|\t}\n386|\tif name, missing := missingMember(members, objectAuthorityRequired); missing {\n387|\t\tfailure, err := failProtocol(\"object authority misses a required member\", name)\n388|\t\tif err != nil {\n389|\t\t\treturn ObjectAuthority{}, err\n390|\t\t}\n391|\t\treturn ObjectAuthority{}, failure\n392|\t}\n393|\tauthorityID, ok := checkUUIDv7(members[\"authority_id\"])\n394|\tif !ok {\n395|\t\tfailure, err := failProtocol(\"object authority identifier is not a UUIDv7\", \"authority_id\")\n396|\t\tif err != nil {\n397|\t\t\treturn ObjectAuthority{}, err\n398|\t\t}\n399|\t\treturn ObjectAuthority{}, failure\n400|\t}\n401|\tpurpose, ok := rawString(members[\"purpose\"])\n402|\tif !ok || !validObjectPurpose(purpose) {\n403|\t\tfailure, err := failProtocol(\"object authority purpose is outside the six-purpose vocabulary\", \"purpose\")\n404|\t\tif err != nil {\n405|\t\t\treturn ObjectAuthority{}, err\n406|\t\t}\n407|\t\treturn ObjectAuthority{}, failure\n408|\t}\n409|\tmode, ok := rawString(members[\"mode\"])\n410|\tif !ok || !validObjectMode(mode) {\n411|\t\tfailure, err := failProtocol(\"object authority mode is outside read|fresh_sink\", \"mode\")\n412|\t\tif err != nil {\n413|\t\t\treturn ObjectAuthority{}, err\n414|\t\t}\n415|\t\treturn ObjectAuthority{}, failure\n416|\t}\n417|\tmaxObjects, ok := rawUint53(members[\"max_objects\"])\n418|\tif !ok {\n419|\t\tfailure, err := failProtocol(\"object authority object limit is not a uint53\", \"max_objects\")\n420|\t\tif err != nil {\n421|\t\t\treturn ObjectAuthority{}, err\n422|\t\t}\n423|\t\treturn ObjectAuthority{}, failure\n424|\t}\n425|\tmaxTotalBytes, ok := rawUint53(members[\"max_total_bytes\"])\n426|\tif !ok {\n427|\t\tfailure, err := failProtocol(\"object authority byte limit is not a uint53\", \"max_total_bytes\")\n428|\t\tif err != nil {\n429|\t\t\treturn ObjectAuthority{}, err\n430|\t\t}\n431|\t\treturn ObjectAuthority{}, failure\n432|\t}\n433|\tif mode == \"fresh_sink\" && (maxObjects == 0 || maxTotalBytes == 0) {\n434|\t\tfailure, err := failProtocol(\"object authority fresh sink requires both limits above zero\", \"mode\")\n435|\t\tif err != nil {\n436|\t\t\treturn ObjectAuthority{}, err\n437|\t\t}\n438|\t\treturn ObjectAuthority{}, failure\n439|\t}\n440|\tif !checkExtensions(members[\"extensions\"]) {\n441|\t\tfailure, err := failProtocol(\"object authority extensions are not reverse-DNS keyed\", \"extensions\")\n442|\t\tif err != nil {\n443|\t\t\treturn ObjectAuthority{}, err\n444|\t\t}\n445|\t\treturn ObjectAuthority{}, failure\n446|\t}\n447|\treturn ObjectAuthority{\n448|\t\tAuthorityID:   authorityID.String(),\n449|\t\tPurpose:       purpose,\n450|\t\tMode:          mode,\n451|\t\tMaxObjects:    maxObjects,\n452|\t\tMaxTotalBytes: maxTotalBytes,\n453|\t}, nil\n454|}\n455|\n456|// readPurposes is the three-purpose read-authority vocabulary\n457|// Section 7.8 states. Membership is a table loop so the census\n458|// derives it like every other closed vocabulary.\n459|var readPurposes = []string{\n460|\t\"source_native\",\n461|\t\"target_staged\",\n462|\t\"target_live\",\n463|}\n464|\n465|// validReadPurpose reports whether the name is one of the three\n466|// read-authority purposes Section 7.8 states.\n467|func validReadPurpose(purpose string) bool {\n468|\tfor _, allowed := range readPurposes {\n469|\t\tif purpose == allowed {\n470|\t\t\treturn true\n471|\t\t}\n472|\t}\n473|\treturn false\n474|}\n475|\n476|// findingSeverities is the three-severity finding vocabulary\n477|// Section 7.8 states. Membership is a table loop so the census\n478|// derives it like every other closed vocabulary.\n479|var findingSeverities = []string{\n480|\t\"info\",\n481|\t\"warning\",\n482|\t\"error\",\n483|}\n484|\n485|// validFindingSeverity reports whether the name is one of the three\n486|// finding severities Section 7.8 states.\n487|func validFindingSeverity(severity string) bool {\n488|\tfor _, allowed := range findingSeverities {\n489|\t\tif severity == allowed {\n490|\t\t\treturn true\n491|\t\t}\n492|\t}\n493|\treturn false\n494|}\n495|\n496|// objectPurposes is the six-purpose object-authority vocabulary\n497|// Section 7.8 states. Membership is a table loop so the census\n498|// derives it like every other closed vocabulary.\n499|var objectPurposes = []string{\n500|\t\"capture_plan\",\n(more lines below)"}}}
