{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a5a96b79b39b43c53ff0de50f4","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/import_census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"go/parser\"\n5|\t\"go/token\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the import census the constructor census stands on\n15|// (review rev3 B6). TestRefusalConstructorsMatchProduction matches\n16|// error constructions by the package identifier `axerror`, so a\n17|// production file importing the error package under any other name\n18|// hides every refusal it builds from both the constructor census\n19|// and the arm derivation at once. This test requires every\n20|// production import of the error package path to bind the name\n21|// `axerror` — the default spelling or an explicit identical alias —\n22|// and fails on any other binding. An empty scan, or a tree with no\n23|// production importer at all, fails closed: a census that sees\n24|// nothing measures nothing.\n25|\n26|// axerrorImportPath is the only import path the constructor census\n27|// resolves. It is spelled here rather than derived because the\n28|// census must pin production, not follow it: a moved package with\n29|// no row here fails the zero-importer guard below.\n30|const axerrorImportPath = \"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\n32|// TestAxerrorImportsAreUnaliased pins the import spelling every\n33|// identifier-matched census in this package relies on.\n34|func TestAxerrorImportsAreUnaliased(t *testing.T) {\n35|\tdirectory, err := os.Getwd()\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"import census: %v\", err)\n38|\t}\n39|\tentries, err := os.ReadDir(directory)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"import census: %v\", err)\n42|\t}\n43|\tscanned := 0\n44|\timporting := 0\n45|\tvar violations []string\n46|\tfor _, entry := range entries {\n47|\t\tname := entry.Name()\n48|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n49|\t\t\tcontinue\n50|\t\t}\n51|\t\tscanned++\n52|\t\tpath := filepath.Join(directory, name)\n53|\t\tsource, err := os.ReadFile(path)\n54|\t\tif err != nil {\n55|\t\t\tt.Fatalf(\"import census: %v\", err)\n56|\t\t}\n57|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n58|\t\tif err != nil {\n59|\t\t\tt.Fatalf(\"import census: %v\", err)\n60|\t\t}\n61|\t\tfor _, declaration := range syntax.Imports {\n62|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n63|\t\t\tif err != nil || target != axerrorImportPath {\n64|\t\t\t\tcontinue\n65|\t\t\t}\n66|\t\t\timporting++\n67|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n68|\t\t\t\tviolations = append(violations, name+\": imports the error package as \"+declaration.Name.Name)\n69|\t\t\t}\n70|\t\t}\n71|\t}\n72|\tif scanned == 0 {\n73|\t\tt.Fatal(\"import census scanned zero production files; the scanner is broken, not the package\")\n74|\t}\n75|\tif importing == 0 {\n76|\t\tt.Fatal(\"import census found zero production importers of the error package; the census is vacuous, not green\")\n77|\t}\n78|\tsort.Strings(violations)\n79|\tif len(violations) > 0 {\n80|\t\tt.Fatalf(\"aliased error-package import(s) hide constructions from the constructor census:\\n  %s\", strings.Join(violations, \"\\n  \"))\n81|\t}\n82|\tt.Logf(\"import census: %d production importer(s) bind axerror across %d files\", importing, scanned)\n83|}\n84|\n85|// TestAxerrorImportCensusSeesAliases proves the census shape\n86|// against synthetic imports: the default binding and an explicit\n87|// identical alias pass, while a renamed, blank, or dot import\n88|// fails. The vectors are synthetic on purpose: they prove the\n89|// gate, not production.\n90|func TestAxerrorImportCensusSeesAliases(t *testing.T) {\n91|\taliased := func(source string) bool {\n92|\t\tt.Helper()\n93|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), parser.ImportsOnly)\n94|\t\tif err != nil {\n95|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n96|\t\t}\n97|\t\tfor _, declaration := range syntax.Imports {\n98|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n99|\t\t\tif err != nil || target != axerrorImportPath {\n100|\t\t\t\tcontinue\n101|\t\t\t}\n102|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n103|\t\t\t\treturn true\n104|\t\t\t}\n105|\t\t}\n106|\t\treturn false\n107|\t}\n108|\tpath := strconv.Quote(axerrorImportPath)\n109|\tfor _, probe := range []struct {\n110|\t\tname   string\n111|\t\tsource string\n112|\t\twant   bool\n113|\t}{\n114|\t\t{\"default binding passes\", \"package probe\\nimport \" + path + \"\\n\", false},\n115|\t\t{\"explicit identical alias passes\", \"package probe\\nimport axerror \" + path + \"\\n\", false},\n116|\t\t{\"renamed import fails\", \"package probe\\nimport axe \" + path + \"\\n\", true},\n117|\t\t{\"blank import fails\", \"package probe\\nimport _ \" + path + \"\\n\", true},\n118|\t\t{\"dot import fails\", \"package probe\\nimport . \" + path + \"\\n\", true},\n119|\t} {\n120|\t\tt.Run(probe.name, func(t *testing.T) {\n121|\t\t\tif got := aliased(probe.source); got != probe.want {\n122|\t\t\t\tt.Fatalf(\"aliased(%q) = %v, want %v\", probe.source, got, probe.want)\n123|\t\t\t}\n124|\t\t})\n125|\t}\n126|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a5aa4a7fb2aef64b64ab3e83b5","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/inventory_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|)\n15|\n16|// This file is the derived refusal-arm inventory. It exists\n17|// because a new refusal through an existing site — a widened\n18|// member set, a new detail literal, a dropped check that slides\n19|// to a lower arm — leaves the whole suite green unless the arm\n20|// set is derived from production source by parsing it, never by\n21|// listing it.\n22|//\n23|// Derivation (deriveRefusalArms): every call to one of the seven\n24|// refusal constructors with a string-literal first argument\n25|// yields ctor|<constructor>|<detail>; a call whose first\n26|// argument is a literal prefix plus fault.detail yields\n27|// ctor|<constructor>|conduit|<function>|<prefix>, so conduits in\n28|// different functions never merge; every &frameFault{...}\n29|// literal yields frame|<detail>. A constructor call with any\n30|// other first-argument shape lands as\n31|// ctor|<constructor>|expr|<function> rather than passing\n32|// silently. Constructor references outside direct-call position\n33|// fail the derivation outright: an aliased constructor hides\n34|// every arm it builds. All three alias spellings are caught —\n35|// `alias := failInvalid`, `var alias = failInvalid` at package\n36|// level, and `var alias = failInvalid` inside a function body —\n37|// because the gate exempts only the definition's own Name in its\n38|// ValueSpec, never a constructor identifier appearing as a\n39|// ValueSpec value. The constructors of this package are\n40|// themselves declared as `var failX = func...`, so their\n41|// definition Names must stay exempt while any other var-held\n42|// reference fails.\n43|// Package-level var initializers scan under their variable name,\n44|// so a refusal arm hiding in a package-level func literal is\n45|// derived, not missed.\n46|//\n47|// The constructor denominator is itself derived, not listed on\n48|// trust: TestRefusalConstructorsMatchProduction requires the\n49|// registered set to equal the package-level vars whose bodies\n50|// call axerror.New, and every axerror.New site in production to\n51|// sit inside one registered body. An eighth constructor or an\n52|// inline axerror.New refusal carries an additive arm the\n53|// derivation never observes, and fails there instead of passing\n54|// silently.\n55|//\n56|// Both directions are checked:\n57|// TestDerivedRefusalArmsAreAllWitnessed (every derived arm\n58|// carries a witness) and TestWitnessedArmsAreAllDerived (every\n59|// witness names a derived arm, so a truncated derivation reddens\n60|// on the orphaned witnesses instead of passing vacuously).\n61|// TestEveryArmWitnessRefusesAtTheProductionEntry drives each\n62|// witness through the production entry and requires the refusal\n63|// to come from the arm under test: code, distinguishing detail,\n64|// and rule text. Empty, single-file, or unparseable derivations\n65|// fail closed: a domain that silently derives nothing is not a\n66|// measurement.\n67|//\n68|// Stated bounds: the five timestamp pairs share one\n69|// (constructor, detail) identity across their checkTimestamp and\n70|// Time halves by construction (one rule, two halves); deleting\n71|// one half is a behavioral mutant the entry-point tests must\n72|// catch, and every witness below proves both halves. Arms\n73|// sharing one identity merge to one obligation only there and\n74|// nowhere else: any other merge fails the derivation. The\n75|// open-class member gates (unknown-member and duplicate-member\n76|// refusals) range over an unbounded name class, so one witness\n77|// per arm proves the gate fires, not that every name is gated:\n78|// a mutant exempting a different name than the witnessed one is\n79|// outside what the arm inventory narrows, and is recorded here\n80|// rather than proven.\n81|\n82|// refusalArmCensusFloor is the derived arm count this test was\n83|// written against. It is a tripwire, not an enumeration: a\n84|// derivation returning fewer arms fails closed even when every\n85|// surviving arm is witnessed, which is what catches a silently\n86|// truncated scan. Raising it is routine when production gains a\n87|// refusal; lowering it requires saying why.\n88|const refusalArmCensusFloor = 323\n89|\n90|// refusalConstructors is the closed constructor set the\n91|// derivation observes, pinned against production by\n92|// TestRefusalConstructorsMatchProduction: the registered names\n93|// must equal the package-level error-constructing vars exactly,\n94|// and every axerror.New site in production must sit inside one\n95|// registered constructor body. A refusal built any other way —\n96|// through an unregistered eighth constructor or an inline\n97|// axerror.New — fails that census; a refusal built through an\n98|// aliased constructor fails the alias gate below.\n99|var refusalConstructors = []string{\n100|\t\"failInvalid\",\n101|\t\"failProtocol\",\n102|\t\"failUnknownOperation\",\n103|\t\"failCapability\",\n104|\t\"failUnavailable\",\n105|\t\"failUnsupportedTuple\",\n106|\t\"failIntegrity\",\n107|}\n108|\n109|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n110|\tt.Helper()\n111|\tdirectory, err := os.Getwd()\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n114|\t}\n115|\tarms, scanned, err := refusalArmsIn(directory)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n118|\t}\n119|\tif len(scanned) == 0 {\n120|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n121|\t}\n122|\tif len(arms) == 0 {\n123|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n124|\t}\n125|\tif len(arms) < refusalArmCensusFloor {\n126|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n127|\t}\n128|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n129|\treturn arms\n130|}\n131|\n132|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n133|\tentries, err := os.ReadDir(directory)\n134|\tif err != nil {\n135|\t\treturn nil, nil, err\n136|\t}\n137|\tarms := map[string]struct{}{}\n138|\tvar scanned []string\n139|\tconstructors := map[string]bool{}\n140|\tfor _, name := range refusalConstructors {\n141|\t\tconstructors[name] = true\n142|\t}\n143|\tfor _, entry := range entries {\n144|\t\tname := entry.Name()\n145|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n146|\t\t\tcontinue\n147|\t\t}\n148|\t\tscanned = append(scanned, name)\n149|\t\tpath := filepath.Join(directory, name)\n150|\t\tsource, err := os.ReadFile(path)\n151|\t\tif err != nil {\n152|\t\t\treturn nil, nil, err\n153|\t\t}\n154|\t\tfileSet := token.NewFileSet()\n155|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n156|\t\tif err != nil {\n157|\t\t\treturn nil, nil, err\n158|\t\t}\n159|\t\tif err := collectFileArms(fileSet, syntax, constructors, arms); err != nil {\n160|\t\t\treturn nil, nil, err\n161|\t\t}\n162|\t}\n163|\treturn arms, scanned, nil\n164|}\n165|\n166|// TestRefusalConstructorsMatchProduction pins the constructor\n167|// denominator against production source in both directions: the\n168|// set of package-level func-valued vars whose body constructs\n169|// an error with axerror.New must equal refusalConstructors\n170|// exactly, and every axerror.New call in production must sit\n171|// inside one registered constructor body. The arm inventory\n172|// observes only registered constructors, so an eighth\n173|// constructor with an additive arm, or an inline axerror.New\n174|// refusal with an additive arm, both survive the full suite —\n175|// and both fail here, the first as an unregistered constructor,\n176|// the second as a construction site outside every registered\n177|// body. axerror.Decode is a read, not a construction, and is\n178|// ignored. An empty scan fails closed.\n179|func TestRefusalConstructorsMatchProduction(t *testing.T) {\n180|\tdirectory, err := os.Getwd()\n181|\tif err != nil {\n182|\t\tt.Fatalf(\"constructor census: %v\", err)\n183|\t}\n184|\tentries, err := os.ReadDir(directory)\n185|\tif err != nil {\n186|\t\tt.Fatalf(\"constructor census: %v\", err)\n187|\t}\n188|\tregistered := map[string]bool{}\n189|\tfor _, name := range refusalConstructors {\n190|\t\tregistered[name] = true\n191|\t}\n192|\tproduced := map[string]string{}\n193|\tscanned := 0\n194|\tvar violations []string\n195|\tfor _, entry := range entries {\n196|\t\tname := entry.Name()\n197|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n198|\t\t\tcontinue\n199|\t\t}\n200|\t\tscanned++\n201|\t\tpath := filepath.Join(directory, name)\n202|\t\tsource, err := os.ReadFile(path)\n203|\t\tif err != nil {\n204|\t\t\tt.Fatalf(\"constructor census: %v\", err)\n205|\t\t}\n206|\t\tfileSet := token.NewFileSet()\n207|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"constructor census: %v\", err)\n210|\t\t}\n211|\t\tfor _, violation := range constructorSitesInFile(fileSet, syntax, registered, produced, name) {\n212|\t\t\tviolations = append(violations, name+\": \"+violation)\n213|\t\t}\n214|\t}\n215|\tif scanned == 0 {\n216|\t\tt.Fatal(\"constructor census scanned zero production files; the scanner is broken, not the package\")\n217|\t}\n218|\tsort.Strings(violations)\n219|\tif len(violations) > 0 {\n220|\t\tt.Fatalf(\"error-construction site(s) outside the registered constructors:\\n  %s\", strings.Join(violations, \"\\n  \"))\n221|\t}\n222|\tvar unregistered []string\n223|\tfor name, file := range produced {\n224|\t\tif !registered[name] {\n225|\t\t\tunregistered = append(unregistered, name+\" (\"+file+\")\")\n226|\t\t}\n227|\t}\n228|\tvar orphaned []string\n229|\tfor name := range registered {\n230|\t\tif _, ok := produced[name]; !ok {\n231|\t\t\torphaned = append(orphaned, name)\n232|\t\t}\n233|\t}\n234|\tsort.Strings(unregistered)\n235|\tsort.Strings(orphaned)\n236|\tif len(unregistered) > 0 {\n237|\t\tt.Fatalf(\"production error constructor(s) with no census registration:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n238|\t}\n239|\tif len(orphaned) > 0 {\n240|\t\tt.Fatalf(\"census registration(s) naming no production constructor:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n241|\t}\n242|\tt.Logf(\"constructor census: %d constructors across %d files\", len(produced), scanned)\n243|}\n244|\n245|// TestConstructorSitesReportFunctionLocalRegisteredName proves\n246|// the function-local case of the constructor census against a\n247|// synthetic file: a New call inside a function-local literal\n248|// reports even when the variable carries a registered name,\n249|// while the package-level definition spelling stays exempt. The\n250|// vector is synthetic on purpose: it proves the gate, not\n251|// production.\n252|func TestConstructorSitesReportFunctionLocalRegisteredName(t *testing.T) {\n253|\tregistered := map[string]bool{\"failInvalid\": true}\n254|\tparse := func(source string) (*token.FileSet, *ast.File) {\n255|\t\tt.Helper()\n256|\t\tfileSet := token.NewFileSet()\n257|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n258|\t\tif err != nil {\n259|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n260|\t\t}\n261|\t\treturn fileSet, syntax\n262|\t}\n263|\tt.Run(\"function-local registered name reports\", func(t *testing.T) {\n264|\t\tfileSet, syntax := parse(\"package probe\\nfunc f() { var failInvalid = func() { axerror.New(nil) }\\n_ = failInvalid }\\n\")\n265|\t\tproduced := map[string]string{}\n266|\t\tviolations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\")\n267|\t\tif len(violations) != 1 {\n268|\t\t\tt.Fatalf(\"violations = %v, want one function-local report\", violations)\n269|\t\t}\n270|\t\tif _, ok := produced[\"failInvalid\"]; ok {\n271|\t\t\tt.Fatal(\"function-local literal recorded a constructor; only package-level scopes produce\")\n272|\t\t}\n273|\t})\n274|\tt.Run(\"package-level definition stays exempt\", func(t *testing.T) {\n275|\t\tfileSet, syntax := parse(\"package probe\\nvar failInvalid = func() { axerror.New(nil) }\\n\")\n276|\t\tproduced := map[string]string{}\n277|\t\tif violations := constructorSitesInFile(fileSet, syntax, registered, produced, \"probe.go\"); len(violations) != 0 {\n278|\t\t\tt.Fatalf(\"violations = %v, want none for the definition spelling\", violations)\n279|\t\t}\n280|\t\tif produced[\"failInvalid\"] != \"probe.go\" {\n281|\t\t\tt.Fatalf(\"produced = %v, want the definition recorded\", produced)\n282|\t\t}\n283|\t})\n284|}\n285|\n286|// constructorVarScope is one var-held func literal an\n287|// axerror.New call can attribute to: the holding variable name\n288|// with its source range, and whether the declaration is\n289|// package-level. Only a package-level scope holding a\n290|// registered name is a constructor; anything else enclosing a\n291|// New call is an unregistered construction site.\n292|type constructorVarScope struct {\n293|\tname       string\n294|\tstart, end token.Pos\n295|\ttopLevel   bool\n296|}\n297|\n298|// constructorSitesInFile records every package-level func-valued\n299|// var whose body calls axerror.New into produced, and reports\n300|// every axerror.New call outside a registered constructor body:\n301|// outside any var-held literal, inside one whose variable is not\n302|// registered, or inside a function-local literal even when the\n303|// variable carries a registered name. Function-local var-held\n304|// literals are never constructors, so a New call inside one\n305|// always reports.\n306|func constructorSitesInFile(fileSet *token.FileSet, syntax *ast.File, registered map[string]bool, produced map[string]string, filename string) []string {\n307|\tvar scopes []constructorVarScope\n308|\tvar calls []token.Pos\n309|\tvar stack []ast.Node\n310|\tfuncDepth := 0\n311|\tast.Inspect(syntax, func(node ast.Node) bool {\n312|\t\tif node == nil {\n313|\t\t\tpopped := stack[len(stack)-1]\n314|\t\t\tswitch popped.(type) {\n315|\t\t\tcase *ast.FuncDecl, *ast.FuncLit:\n316|\t\t\t\tfuncDepth--\n317|\t\t\t}\n318|\t\t\tstack = stack[:len(stack)-1]\n319|\t\t\treturn true\n320|\t\t}\n321|\t\tswitch node := node.(type) {\n322|\t\tcase *ast.FuncDecl, *ast.FuncLit:\n323|\t\t\tfuncDepth++\n324|\t\tcase *ast.GenDecl:\n325|\t\t\tif node.Tok != token.VAR {\n326|\t\t\t\tbreak\n327|\t\t\t}\n328|\t\t\ttopLevel := funcDepth == 0\n329|\t\t\tfor _, specification := range node.Specs {\n330|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n331|\t\t\t\tif !ok {\n332|\t\t\t\t\tcontinue\n333|\t\t\t\t}\n334|\t\t\t\tfor index, ident := range value.Names {\n335|\t\t\t\t\tliteral := pairedFuncLit(value, index)\n336|\t\t\t\t\tif literal == nil {\n337|\t\t\t\t\t\tcontinue\n338|\t\t\t\t\t}\n339|\t\t\t\t\tscopes = append(scopes, constructorVarScope{name: ident.Name, start: literal.Pos(), end: literal.End(), topLevel: topLevel})\n340|\t\t\t\t}\n341|\t\t\t}\n342|\t\tcase *ast.CallExpr:\n343|\t\t\tselector, ok := node.Fun.(*ast.SelectorExpr)\n344|\t\t\tif !ok {\n345|\t\t\t\tbreak\n346|\t\t\t}\n347|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n348|\t\t\tif !ok || receiver.Name != \"axerror\" || selector.Sel.Name != \"New\" {\n349|\t\t\t\tbreak\n350|\t\t\t}\n351|\t\t\tcalls = append(calls, node.Pos())\n352|\t\t}\n353|\t\tstack = append(stack, node)\n354|\t\treturn true\n355|\t})\n356|\tvar violations []string\n357|\tfor _, position := range calls {\n358|\t\tbest := \"\"\n359|\t\tvar bestStart token.Pos\n360|\t\tinitialized := false\n361|\t\ttopLevel := false\n362|\t\tfor _, scope := range scopes {\n363|\t\t\tif scope.start <= position && position <= scope.end {\n364|\t\t\t\tif !initialized || scope.start >= bestStart {\n365|\t\t\t\t\tbest, bestStart, initialized, topLevel = scope.name, scope.start, true, scope.topLevel\n366|\t\t\t\t}\n367|\t\t\t}\n368|\t\t}\n369|\t\tswitch {\n370|\t\tcase !initialized:\n371|\t\t\tviolations = append(violations, fmt.Sprintf(\"axerror.New outside any constructor at %s\", fileSet.Position(position)))\n372|\t\tcase !registered[best]:\n373|\t\t\tviolations = append(violations, fmt.Sprintf(\"axerror.New inside unregistered %q at %s\", best, fileSet.Position(position)))\n374|\t\tcase !topLevel:\n375|\t\t\tviolations = append(violations, fmt.Sprintf(\"axerror.New inside function-local %q at %s; only package-level constructors are registered\", best, fileSet.Position(position)))\n376|\t\tdefault:\n377|\t\t\tproduced[best] = filename\n378|\t\t}\n379|\t}\n380|\treturn violations\n381|}\n382|\n383|// pairedFuncLit returns the func literal holding one ValueSpec\n384|// name: the index-paired value when every name carries its own,\n385|// the shared value when one serves all names, and nil for any\n386|// other shape or a non-literal value.\n387|func pairedFuncLit(value *ast.ValueSpec, index int) *ast.FuncLit {\n388|\tvar candidate ast.Expr\n389|\tswitch {\n390|\tcase len(value.Values) == len(value.Names) && index < len(value.Values):\n391|\t\tcandidate = value.Values[index]\n392|\tcase len(value.Values) == 1:\n393|\t\tcandidate = value.Values[0]\n394|\tdefault:\n395|\t\treturn nil\n396|\t}\n397|\tliteral, ok := candidate.(*ast.FuncLit)\n398|\tif !ok {\n399|\t\treturn nil\n400|\t}\n401|\treturn literal\n402|}\n403|\n404|// scopeRange is one named scope constructor calls attribute to:\n405|// a function declaration or a package-level variable holding a\n406|// func literal.\n407|type scopeRange struct {\n408|\tname       string\n409|\tstart, end token.Pos\n410|}\n411|\n412|// collectFileArms derives every arm in one production file from a\n413|// single parse, so scope containment compares positions within\n414|// one file set: constructor calls attribute to their innermost\n415|// enclosing scope by source range, frameFault literals derive\n416|// frame arms, and any constructor identifier outside call-fun\n417|// and definition position is an alias and fails the file.\n418|func collectFileArms(fileSet *token.FileSet, syntax *ast.File, constructors map[string]bool, arms map[string]struct{}) error {\n419|\tvar scopes []scopeRange\n420|\ttype pendingCall struct {\n421|\t\tname     string\n422|\t\tcall     *ast.CallExpr\n423|\t\tposition token.Pos\n424|\t}\n425|\tvar calls []pendingCall\n426|\tvar frames []*ast.CompositeLit\n427|\ttype identUse struct {\n428|\t\tidentifier *ast.Ident\n429|\t\tparent     ast.Node\n430|\t}\n431|\tvar uses []identUse\n432|\tvar stack []ast.Node\n433|\tast.Inspect(syntax, func(node ast.Node) bool {\n434|\t\tif node == nil {\n435|\t\t\tstack = stack[:len(stack)-1]\n436|\t\t\treturn true\n437|\t\t}\n438|\t\tvar parent ast.Node\n439|\t\tif len(stack) > 0 {\n440|\t\t\tparent = stack[len(stack)-1]\n441|\t\t}\n442|\t\tswitch node := node.(type) {\n443|\t\tcase *ast.FuncDecl:\n444|\t\t\tscopes = append(scopes, scopeRange{name: node.Name.Name, start: node.Pos(), end: node.End()})\n445|\t\tcase *ast.GenDecl:\n446|\t\t\tfor _, specification := range node.Specs {\n447|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n448|\t\t\t\tif !ok {\n449|\t\t\t\t\tcontinue\n450|\t\t\t\t}\n451|\t\t\t\tfor index, name := range value.Names {\n452|\t\t\t\t\tif index < len(value.Values) {\n453|\t\t\t\t\t\tif literal, ok := value.Values[index].(*ast.FuncLit); ok {\n454|\t\t\t\t\t\t\tscopes = append(scopes, scopeRange{name: \"var:\" + name.Name, start: literal.Pos(), end: literal.End()})\n455|\t\t\t\t\t\t}\n456|\t\t\t\t\t}\n457|\t\t\t\t}\n458|\t\t\t}\n459|\t\tcase *ast.Ident:\n460|\t\t\tif constructors[node.Name] {\n461|\t\t\t\tuses = append(uses, identUse{identifier: node, parent: parent})\n462|\t\t\t}\n463|\t\tcase *ast.CallExpr:\n464|\t\t\tif fun, ok := node.Fun.(*ast.Ident); ok && constructors[fun.Name] {\n465|\t\t\t\tcalls = append(calls, pendingCall{name: fun.Name, call: node, position: node.Pos()})\n466|\t\t\t}\n467|\t\tcase *ast.CompositeLit:\n468|\t\t\tif identifier, ok := node.Type.(*ast.Ident); ok && identifier.Name == \"frameFault\" {\n469|\t\t\t\tframes = append(frames, node)\n470|\t\t\t}\n471|\t\t}\n472|\t\tstack = append(stack, node)\n473|\t\treturn true\n474|\t})\n475|\tfor _, use := range uses {\n476|\t\tif call, ok := use.parent.(*ast.CallExpr); ok {\n477|\t\t\tif fun, ok := call.Fun.(*ast.Ident); ok && fun == use.identifier {\n478|\t\t\t\tcontinue\n479|\t\t\t}\n480|\t\t}\n481|\t\tif specification, ok := use.parent.(*ast.ValueSpec); ok {\n482|\t\t\tdefined := false\n483|\t\t\tfor _, name := range specification.Names {\n484|\t\t\t\tif name == use.identifier {\n485|\t\t\t\t\tdefined = true\n486|\t\t\t\t\tbreak\n487|\t\t\t\t}\n488|\t\t\t}\n489|\t\t\tif defined {\n490|\t\t\t\tcontinue\n491|\t\t\t}\n492|\t\t\treturn fmt.Errorf(\"constructor alias of %s buries every arm it builds at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n493|\t\t}\n494|\t\treturn fmt.Errorf(\"constructor alias or indirect use of %s at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n495|\t}\n496|\tenclosing := func(position token.Pos) string {\n497|\t\tbest := \"package\"\n498|\t\tvar bestStart token.Pos\n499|\t\tinitialized := false\n500|\t\tfor _, scope := range scopes {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
