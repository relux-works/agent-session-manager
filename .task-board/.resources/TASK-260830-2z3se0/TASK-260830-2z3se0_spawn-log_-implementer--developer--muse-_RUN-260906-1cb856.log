{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c407","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":94,"recorded_at":1780531400000183,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"6eeabb1b-6ba6-442b-8874-43f94be9b633"},"task_id":"6eeabb1b-6ba6-442b-8874-43f94be9b633","event":{"kind":"output","task_id":"6eeabb1b-6ba6-442b-8874-43f94be9b633","chunk":"{\n  \"chunk_id\": \"exec-5-1\",\n  \"command\": \"task-board q --help 2>&1 | head -n 50\",\n  \"description\": \"Check query syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Execute queries against the board using a compact DSL.\\n\\nOperations:\\n  get(ID)              Get a single element by ID\\n  activity(ID, ...)    Read bounded, cursor-paginated element activity\\n  list(filters...)     List elements with filters\\n  count(filters...)    Count elements matching filters\\n  summary()            Board overview (counts + active/blocked)\\n  plan(scope?)         Execution phases; scope=[ID,ID,...] plans the union of subtrees\\n  agents(stale=N?)     Agent dashboard\\n  models(agent?)       Available models for spawn\\n  project_config()     Full active project board runtime config (always local)\\n  project_config(view=spawn-preflight, role=ROLE, agent=PROVIDER?)\\n                       Narrow effective child-spawn policy for one target\\n  provider_limits()    Machine-scoped provider rate-limit state (always local)\\n  provider_limits(identity=KEY|all_identities=true)\\n                       Report one indexed provider identity, or every one\\n  whoami()             Current remote URL and active user (always local)\\n  schema()             Introspect the full operations/fields/presets contract\\n  schema(operation=NAME|mutation=NAME)\\n                       Return only one typed operation or mutation signature\\n\\nField projection:\\n  { id status assignee }     Select specific fields\\n  { overview }               Use a base preset (minimal, default, overview, full, progress, planning)\\n  { observability-task }     Use project observability presets (project, epic, story, task)\\n  (omitted)                  Defaults to { id name status }\\n\\nBatching:\\n  Separate multiple queries with semicolons; results preserve source order\\n\\nSpawn policy projection:\\n  Full project_config reports the effective spawn-policy-v2/v3 contract,\\n  authority, normalized provider and role-effective policy, and exact config\\n  provenance. V2 additionally reports its frozen compatibility snapshot and a\\n  copy-ready v3 migration object; this is read-only evidence and never edits\\n  task-board.config.json. Spawn-preflight returns only the selected role policy\\n  and its actionable migration warning.\\n\\nOutput format:\\n  --format json       Standard JSON (default)\\n  --format compact    Compact tabular output (~40% fewer tokens)\\n                      plan() switches to the super-compact planning shape:\\n                      flat waves of IDs, one-line critical path, id->status map\\n\\nExamples:\\n  task-board q 'schema()'\\n  task-board q 'get(TASK-260211-abc) { id status assignee }'\\n  task-board q 'activity(TASK-260211-abc, limit=25, order=descending, view=effective)'\\n  task-board q 'list(type=task, status=development) { overview }'\\n\",\n  \"original_output_bytes\": 2621,\n  \"original_output_tokens\": 656,\n  \"truncated\": false\n}"}}}
