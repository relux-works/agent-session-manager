ts, err := decodeFidelityLimits(members[\"known_fidelity_limits\"])\n1103|\tif err != nil {\n1104|\t\treturn TupleEntry{}, err\n1105|\t}\n1106|\tvalidFrom, ok := checkTimestamp(members[\"valid_from\"])\n1107|\tif !ok {\n1108|\t\tfailure, faultErr := failProtocol(\"tuple entry valid_from is not a timestamp\", \"valid_from\")\n1109|\t\tif faultErr != nil {\n1110|\t\t\treturn TupleEntry{}, faultErr\n1111|\t\t}\n1112|\t\treturn TupleEntry{}, failure\n1113|\t}\n1114|\tfrom, err := validFrom.Time()\n1115|\tif err != nil {\n1116|\t\tfailure, faultErr := failProtocol(\"tuple entry valid_from is not a timestamp\", \"valid_from\")\n1117|\t\tif faultErr != nil {\n1118|\t\t\treturn TupleEntry{}, faultErr\n1119|\t\t}\n1120|\t\treturn TupleEntry{}, failure\n1121|\t}\n1122|\tvalidUntil, ok := checkTimestamp(members[\"valid_until\"])\n1123|\tif !ok {\n1124|\t\tfailure, faultErr := failProtocol(\"tuple entry valid_until is not a timestamp\", \"valid_until\")\n1125|\t\tif faultErr != nil {\n1126|\t\t\treturn TupleEntry{}, faultErr\n1127|\t\t}\n1128|\t\treturn TupleEntry{}, failure\n1129|\t}\n1130|\tuntil, err := validUntil.Time()\n1131|\tif err != nil {\n1132|\t\tfailure, faultErr := failProtocol(\"tuple entry valid_until is not a timestamp\", \"valid_until\")\n1133|\t\tif faultErr != nil {\n1134|\t\t\treturn TupleEntry{}, faultErr\n1135|\t\t}\n1136|\t\treturn TupleEntry{}, failure\n1137|\t}\n1138|\tif !from.Before(until) {\n1139|\t\tfailure, faultErr := failProtocol(\"tuple entry validity interval does not order valid_from before valid_until\", \"valid_until\")\n1140|\t\tif faultErr != nil {\n1141|\t\t\treturn TupleEntry{}, faultErr\n1142|\t\t}\n1143|\t\treturn TupleEntry{}, failure\n1144|\t}\n1145|\tstatus, ok := rawString(members[\"status\"])\n1146|\tif !ok || !validTupleEntryStatus(status) {\n1147|\t\tfailure, faultErr := failProtocol(\"tuple entry status is outside accepted|revoked\", \"status\")\n1148|\t\tif faultErr != nil {\n1149|\t\t\treturn TupleEntry{}, faultErr\n1150|\t\t}\n1151|\t\treturn TupleEntry{}, failure\n1152|\t}\n1153|\tvar reason *string\n1154|\tif !isNull(members[\"revocation_reason\"]) {\n1155|\t\ttext, ok := checkStringBounds(members[\"revocation_reason\"], 1, 4096)\n1156|\t\tif !ok {\n1157|\t\t\tfailure, faultErr := failProtocol(\"tuple entry revocation reason is not a string[1..4096]\", \"revocation_reason\")\n1158|\t\t\tif faultErr != nil {\n1159|\t\t\t\treturn TupleEntry{}, faultErr\n1160|\t\t\t}\n1161|\t\t\treturn TupleEntry{}, failure\n1162|\t\t}\n1163|\t\treason = &text\n1164|\t}\n1165|\tvar revokedAt *time.Time\n1166|\tif !isNull(members[\"revoked_at\"]) {\n1167|\t\tstamp, ok := checkTimestamp(members[\"revoked_at\"])\n1168|\t\tif !ok {\n1169|\t\t\tfailure, faultErr := failProtocol(\"tuple entry revocation time is not a timestamp\", \"revoked_at\")\n1170|\t\t\tif faultErr != nil {\n1171|\t\t\t\treturn TupleEntry{}, faultErr\n1172|\t\t\t}\n1173|\t\t\treturn TupleEntry{}, failure\n1174|\t\t}\n1175|\t\tinstant, err := stamp.Time()\n1176|\t\tif err != nil {\n1177|\t\t\tfailure, faultErr := failProtocol(\"tuple entry revocation time is not a timestamp\", \"revoked_at\")\n1178|\t\t\tif faultErr != nil {\n1179|\t\t\t\treturn TupleEntry{}, faultErr\n1180|\t\t\t}\n1181|\t\t\treturn TupleEntry{}, failure\n1182|\t\t}\n1183|\t\trevokedAt = &instant\n1184|\t}\n1185|\tif status == \"accepted\" {\n1186|\t\tif reason != nil || revokedAt != nil {\n1187|\t\t\tfailure, faultErr := failProtocol(\"tuple accepted entry carries revocation members\", \"status\")\n1188|\t\t\tif faultErr != nil {\n1189|\t\t\t\treturn TupleEntry{}, faultErr\n1190|\t\t\t}\n1191|\t\t\treturn TupleEntry{}, failure\n1192|\t\t}\n1193|\t} else {\n1194|\t\tif reason == nil || revokedAt == nil {\n1195|\t\t\tfailure, faultErr := failProtocol(\"tuple revoked entry misses a revocation member\", \"status\")\n1196|\t\t\tif faultErr != nil {\n1197|\t\t\t\treturn TupleEntry{}, faultErr\n1198|\t\t\t}\n1199|\t\t\treturn TupleEntry{}, failure\n1200|\t\t}\n1201|\t}\n1202|\tif !checkExtensions(members[\"extensions\"]) {\n1203|\t\tfailure, faultErr := failProtocol(\"tuple registry entry extensions are not reverse-DNS keyed\", \"extensions\")\n1204|\t\tif faultErr != nil {\n1205|\t\t\treturn TupleEntry{}, faultErr\n1206|\t\t}\n1207|\t\treturn TupleEntry{}, failure\n1208|\t}\n1209|\treturn TupleEntry{\n1210|\t\tKey:              key,\n1211|\t\tEntrySequence:    sequence,\n1212|\t\tStrategies:       strategies,\n1213|\t\tFixture:          fixture,\n1214|\t\tSmoke:            smoke,\n1215|\t\tFidelityLimits:   limits,\n1216|\t\tValidFrom:        from,\n1217|\t\tValidUntil:       until,\n1218|\t\tStatus:           status,\n1219|\t\tRevocationReason: reason,\n1220|\t\tRevokedAt:        revokedAt,\n1221|\t}, nil\n1222|}\n1223|\n1224|// BindingFacts are the host-observed execution facts the registry\n1225|// key must equal: provider, candidate kind, and the three digests.\n1226|// The host constructs them from the verified candidate and the\n1227|// Journal binding, never from adapter claims.\n1228|type BindingFacts struct {\n1229|\tProviderID             string\n1230|\tCandidateKind          CandidateKind\n1231|\tExecutableSHA256       string\n1232|\tProviderManifestDigest string\n1233|\tAdapterManifestDigest  string\n1234|}\n1235|\n1236|// CheckTupleAdmission decides whether one validated entry admits a\n1237|// call in the given direction at the given instant: the key equals\n1238|// the host-observed binding facts and the probed tuple exactly, the\n1239|// status is accepted, the instant falls inside the validity\n1240|// interval, and the direction rules hold — source_read admits only\n1241|// strategies=[archive_only] with null smoke, target_write admits\n1242|// only a non-archive strategy set with a passing smoke record. A\n1243|// revoked or absent entry, a key mismatch, a stale interval, or a\n1244|// direction violation is unsupported_environment_tuple, never a\n1245|// fallback permission. Local policy may further deny an admitted\n1246|// entry but cannot admit a refused one.\n1247|func CheckTupleAdmission(entry TupleEntry, direction Direction, environment Tuple, binding BindingFacts, now time.Time) error {\n1248|\tif entry.Key.Direction != direction {\n1249|\t\tfailure, err := failUnsupportedTuple(\"tuple entry direction does not match the call direction\", environment.EnvironmentID)\n1250|\t\tif err != nil {\n1251|\t\t\treturn err\n1252|\t\t}\n1253|\t\treturn failure\n1254|\t}\n1255|\tif entry.Key.Environment != environment {\n1256|\t\tfailure, err := failUnsupportedTuple(\"tuple entry environment does not equal the probed tuple\", environment.EnvironmentID)\n1257|\t\tif err != nil {\n1258|\t\t\treturn err\n1259|\t\t}\n1260|\t\treturn failure\n1261|\t}\n1262|\tif entry.Key.ProviderID != binding.ProviderID ||\n1263|\t\tentry.Key.CandidateKind != binding.CandidateKind ||\n1264|\t\tentry.Key.ExecutableSHA256 != binding.ExecutableSHA256 ||\n1265|\t\tentry.Key.ProviderManifestDigest != binding.ProviderManifestDigest ||\n1266|\t\tentry.Key.AdapterManifestDigest != binding.AdapterManifestDigest {\n1267|\t\tfailure, err := failUnsupportedTuple(\"tuple entry key does not equal the host-observed execution binding\", environment.EnvironmentID)\n1268|\t\tif err != nil {\n1269|\t\t\treturn err\n1270|\t\t}\n1271|\t\treturn failure\n1272|\t}\n1273|\tif entry.Status != \"accepted\" {\n1274|\t\tfailure, err := failUnsupportedTuple(\"tuple entry is not accepted\", environment.EnvironmentID)\n1275|\t\tif err != nil {\n1276|\t\t\treturn err\n1277|\t\t}\n1278|\t\treturn failure\n1279|\t}\n1280|\tif now.Before(entry.ValidFrom) || now.After(entry.ValidUntil) {\n1281|\t\tfailure, err := failUnsupportedTuple(\"tuple entry validity interval does not cover the call\", environment.EnvironmentID)\n1282|\t\tif err != nil {\n1283|\t\t\treturn err\n1284|\t\t}\n1285|\t\treturn failure\n1286|\t}\n1287|\tif direction == DirectionSourceRead {\n1288|\t\tif len(entry.Strategies) != 1 || entry.Strategies[0] != \"archive_only\" {\n1289|\t\t\tfailure, err := failUnsupportedTuple(\"tuple source entry does not carry exactly strategies=[archive_only]\", environment.EnvironmentID)\n1290|\t\t\tif err != nil {\n1291|\t\t\t\treturn err\n1292|\t\t\t}\n1293|\t\t\treturn failure\n1294|\t\t}\n1295|\t\tif entry.Smoke != nil {\n1296|\t\t\tfailure, err := failUnsupportedTuple(\"tuple source entry carries resume smoke evidence\", environment.EnvironmentID)\n1297|\t\t\tif err != nil {\n1298|\t\t\t\treturn err\n1299|\t\t\t}\n1300|\t\t\treturn failure\n1301|\t\t}\n1302|\t\treturn nil\n1303|\t}\n1304|\tfor _, strategy := range entry.Strategies {\n1305|\t\tif strategy == \"archive_only\" {\n1306|\t\t\tfailure, err := failUnsupportedTuple(\"tuple target entry admits archive_only\", environment.EnvironmentID)\n1307|\t\t\tif err != nil {\n1308|\t\t\t\treturn err\n1309|\t\t\t}\n1310|\t\t\treturn failure\n1311|\t\t}\n1312|\t}\n1313|\tif entry.Smoke == nil {\n1314|\t\tfailure, err := failUnsupportedTuple(\"tuple target entry misses passing resume smoke evidence\", environment.EnvironmentID)\n1315|\t\tif err != nil {\n1316|\t\t\treturn err\n1317|\t\t}\n1318|\t\treturn failure\n1319|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
