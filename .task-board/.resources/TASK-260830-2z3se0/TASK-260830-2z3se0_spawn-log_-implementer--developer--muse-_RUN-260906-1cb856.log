{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c61d","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":361,"recorded_at":1780531400000717,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"33e4d510-c3e3-4c87-a67d-62ff9caa321c"},"task_id":"33e4d510-c3e3-4c87-a67d-62ff9caa321c","event":{"kind":"output","task_id":"33e4d510-c3e3-4c87-a67d-62ff9caa321c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/import_census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"go/parser\"\n5|\t\"go/token\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the import census the constructor census stands on\n15|// (review rev3 B6). TestRefusalConstructorsMatchProduction matches\n16|// error constructions by the package identifier `axerror`, so a\n17|// production file importing the error package under any other name\n18|// hides every refusal it builds from both the constructor census\n19|// and the arm derivation at once. This test requires every\n20|// production import of the error package path to bind the name\n21|// `axerror` — the default spelling or an explicit identical alias —\n22|// and fails on any other binding. An empty scan, or a tree with no\n23|// production importer at all, fails closed: a census that sees\n24|// nothing measures nothing.\n25|\n26|// axerrorImportPath is the only import path the constructor census\n27|// resolves. It is spelled here rather than derived because the\n28|// census must pin production, not follow it: a moved package with\n29|// no row here fails the zero-importer guard below.\n30|const axerrorImportPath = \"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\n32|// TestAxerrorImportsAreUnaliased pins the import spelling every\n33|// identifier-matched census in this package relies on.\n34|func TestAxerrorImportsAreUnaliased(t *testing.T) {\n35|\tdirectory, err := os.Getwd()\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"import census: %v\", err)\n38|\t}\n39|\tentries, err := os.ReadDir(directory)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"import census: %v\", err)\n42|\t}\n43|\tscanned := 0\n44|\timporting := 0\n45|\tvar violations []string\n46|\tfor _, entry := range entries {\n47|\t\tname := entry.Name()\n48|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n49|\t\t\tcontinue\n50|\t\t}\n51|\t\tscanned++\n52|\t\tpath := filepath.Join(directory, name)\n53|\t\tsource, err := os.ReadFile(path)\n54|\t\tif err != nil {\n55|\t\t\tt.Fatalf(\"import census: %v\", err)\n56|\t\t}\n57|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n58|\t\tif err != nil {\n59|\t\t\tt.Fatalf(\"import census: %v\", err)\n60|\t\t}\n61|\t\tfor _, declaration := range syntax.Imports {\n62|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n63|\t\t\tif err != nil || target != axerrorImportPath {\n64|\t\t\t\tcontinue\n65|\t\t\t}\n66|\t\t\timporting++\n67|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n68|\t\t\t\tviolations = append(violations, name+\": imports the error package as \"+declaration.Name.Name)\n69|\t\t\t}\n70|\t\t}\n71|\t}\n72|\tif scanned == 0 {\n73|\t\tt.Fatal(\"import census scanned zero production files; the scanner is broken, not the package\")\n74|\t}\n75|\tif importing == 0 {\n76|\t\tt.Fatal(\"import census found zero production importers of the error package; the census is vacuous, not green\")\n77|\t}\n78|\tsort.Strings(violations)\n79|\tif len(violations) > 0 {\n80|\t\tt.Fatalf(\"aliased error-package import(s) hide constructions from the constructor census:\\n  %s\", strings.Join(violations, \"\\n  \"))\n81|\t}\n82|\tt.Logf(\"import census: %d production importer(s) bind axerror across %d files\", importing, scanned)\n83|}\n84|\n85|// TestAxerrorImportCensusSeesAliases proves the census shape\n86|// against synthetic imports: the default binding and an explicit\n87|// identical alias pass, while a renamed, blank, or dot import\n88|// fails. The vectors are synthetic on purpose: they prove the\n89|// gate, not production.\n90|func TestAxerrorImportCensusSeesAliases(t *testing.T) {\n91|\taliased := func(source string) bool {\n92|\t\tt.Helper()\n93|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"probe.go\", []byte(source), parser.ImportsOnly)\n94|\t\tif err != nil {\n95|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n96|\t\t}\n97|\t\tfor _, declaration := range syntax.Imports {\n98|\t\t\ttarget, err := strconv.Unquote(declaration.Path.Value)\n99|\t\t\tif err != nil || target != axerrorImportPath {\n100|\t\t\t\tcontinue\n101|\t\t\t}\n102|\t\t\tif declaration.Name != nil && declaration.Name.Name != \"axerror\" {\n103|\t\t\t\treturn true\n104|\t\t\t}\n105|\t\t}\n106|\t\treturn false\n107|\t}\n108|\tpath := strconv.Quote(axerrorImportPath)\n109|\tfor _, probe := range []struct {\n110|\t\tname   string\n111|\t\tsource string\n112|\t\twant   bool\n113|\t}{\n114|\t\t{\"default binding passes\", \"package probe\\nimport \" + path + \"\\n\", false},\n115|\t\t{\"explicit identical alias passes\", \"package probe\\nimport axerror \" + path + \"\\n\", false},\n116|\t\t{\"renamed import fails\", \"package probe\\nimport axe \" + path + \"\\n\", true},\n117|\t\t{\"blank import fails\", \"package probe\\nimport _ \" + path + \"\\n\", true},\n118|\t\t{\"dot import fails\", \"package probe\\nimport . \" + path + \"\\n\", true},\n119|\t} {\n120|\t\tt.Run(probe.name, func(t *testing.T) {\n121|\t\t\tif got := aliased(probe.source); got != probe.want {\n122|\t\t\t\tt.Fatalf(\"aliased(%q) = %v, want %v\", probe.source, got, probe.want)\n123|\t\t\t}\n124|\t\t})\n125|\t}\n126|}"}}}
