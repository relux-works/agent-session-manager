{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c95f","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":778,"recorded_at":1780531400001551,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"task_stream":{"kind":"task","id":"f53e34a6-9813-4a73-8b8a-0c7a782b95da"},"task_id":"f53e34a6-9813-4a73-8b8a-0c7a782b95da","event":{"kind":"output","task_id":"f53e34a6-9813-4a73-8b8a-0c7a782b95da","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/context.go`.\n(684 line(s) above)\n685|type ResourceLimits struct {\n686|\tMaxObjects           uint64\n687|\tMaxTotalBytes        uint64\n688|\tMaxSingleObjectBytes uint64\n689|\tMaxEvents            uint64\n690|\tMaxTargetResources   uint64\n691|}\n692|\n693|// DecodeResourceLimits validates one closed ResourceLimits: every\n694|// per-item maximum above zero, the event and resource counts in\n695|// [0..65536], and each per-item maximum no greater than the total.\n696|// The last rule is checked in both directions — a per-item maximum\n697|// above the total would license an object the total cannot hold,\n698|// and a total of zero would license nothing at all.\n699|func DecodeResourceLimits(raw json.RawMessage) (ResourceLimits, error) {\n700|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n701|\tif fault != nil {\n702|\t\tfailure, err := failProtocol(\"resource limits \"+fault.detail, fault.member)\n703|\t\tif err != nil {\n704|\t\t\treturn ResourceLimits{}, err\n705|\t\t}\n706|\t\treturn ResourceLimits{}, failure\n707|\t}\n708|\tif name, unknown := unknownMember(members, resourceLimitsMembers); unknown {\n709|\t\tfailure, err := failProtocol(\"resource limits carry unknown member\", name)\n710|\t\tif err != nil {\n711|\t\t\treturn ResourceLimits{}, err\n712|\t\t}\n713|\t\treturn ResourceLimits{}, failure\n714|\t}\n715|\tif name, missing := missingMember(members, resourceLimitsRequired); missing {\n716|\t\tfailure, err := failProtocol(\"resource limits miss a required member\", name)\n717|\t\tif err != nil {\n718|\t\t\treturn ResourceLimits{}, err\n719|\t\t}\n720|\t\treturn ResourceLimits{}, failure\n721|\t}\n722|\tmaxObjects, ok := checkUint53Bounds(members[\"max_objects\"], 1, maxUint53)\n723|\tif !ok {\n724|\t\tfailure, err := failProtocol(\"resource object limit is not a uint53 above zero\", \"max_objects\")\n725|\t\tif err != nil {\n726|\t\t\treturn ResourceLimits{}, err\n727|\t\t}\n728|\t\treturn ResourceLimits{}, failure\n729|\t}\n730|\tmaxTotalBytes, ok := checkUint53Bounds(members[\"max_total_bytes\"], 1, maxUint53)\n731|\tif !ok {\n732|\t\tfailure, err := failProtocol(\"resource total byte limit is not a uint53 above zero\", \"max_total_bytes\")\n733|\t\tif err != nil {\n734|\t\t\treturn ResourceLimits{}, err\n735|\t\t}\n736|\t\treturn ResourceLimits{}, failure\n737|\t}\n738|\tmaxSingle, ok := checkUint53Bounds(members[\"max_single_object_bytes\"], 1, maxUint53)\n739|\tif !ok {\n740|\t\tfailure, err := failProtocol(\"resource single-object byte limit is not a uint53 above zero\", \"max_single_object_bytes\")\n741|\t\tif err != nil {\n742|\t\t\treturn ResourceLimits{}, err\n743|\t\t}\n744|\t\treturn ResourceLimits{}, failure\n745|\t}\n746|\tmaxEvents, ok := checkUint53Bounds(members[\"max_events\"], 0, 65536)\n747|\tif !ok {\n748|\t\tfailure, err := failProtocol(\"resource event limit is not a uint53 in [0..65536]\", \"max_events\")\n749|\t\tif err != nil {\n750|\t\t\treturn ResourceLimits{}, err\n751|\t\t}\n752|\t\treturn ResourceLimits{}, failure\n753|\t}\n754|\tmaxTargetResources, ok := checkUint53Bounds(members[\"max_target_resources\"], 0, 65536)\n755|\tif !ok {\n756|\t\tfailure, err := failProtocol(\"resource target limit is not a uint53 in [0..65536]\", \"max_target_resources\")\n757|\t\tif err != nil {\n758|\t\t\treturn ResourceLimits{}, err\n759|\t\t}\n760|\t\treturn ResourceLimits{}, failure\n761|\t}\n762|\tif maxObjects > maxTotalBytes {\n763|\t\tfailure, err := failProtocol(\"resource object limit exceeds the total byte limit\", \"max_objects\")\n764|\t\tif err != nil {\n765|\t\t\treturn ResourceLimits{}, err\n766|\t\t}\n767|\t\treturn ResourceLimits{}, failure\n768|\t}\n769|\tif maxSingle > maxTotalBytes {\n770|\t\tfailure, err := failProtocol(\"resource single-object byte limit exceeds the total byte limit\", \"max_single_object_bytes\")\n771|\t\tif err != nil {\n772|\t\t\treturn ResourceLimits{}, err\n773|\t\t}\n774|\t\treturn ResourceLimits{}, failure\n775|\t}\n776|\treturn ResourceLimits{\n777|\t\tMaxObjects:           maxObjects,\n778|\t\tMaxTotalBytes:        maxTotalBytes,\n779|\t\tMaxSingleObjectBytes: maxSingle,\n780|\t\tMaxEvents:            maxEvents,\n781|\t\tMaxTargetResources:   maxTargetResources,\n782|\t}, nil\n783|}\n784|\n785|// findingMembers is the exact AdapterFinding member set: severity,\n786|// code, message, remediation, and extensions.\n787|var findingMembers = map[string]bool{\n788|\t\"severity\":    true,\n789|\t\"code\":        true,\n790|\t\"message\":     true,\n791|\t\"remediation\": true,\n792|\t\"extensions\":  true,\n793|}\n794|\n795|// findingRequired lists findingMembers in order.\n796|var findingRequired = []string{\n797|\t\"severity\",\n798|\t\"code\",\n799|\t\"message\",\n800|\t\"remediation\",\n801|\t\"extensions\",\n802|}\n803|\n804|// Finding is one validated adapter finding.\n805|type Finding struct {\n806|\tSeverity    string\n807|\tCode        string\n808|\tMessage     string\n809|\tRemediation *string\n810|}\n811|\n812|// DecodeFinding validates one closed AdapterFinding: the severity\n813|// in info|warning|error, the code as string[1..128], the message as\n814|// string[1..4096], and the remediation as null or\n815|// string[1..4096].\n816|func DecodeFinding(raw json.RawMessage) (Finding, error) {\n817|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n818|\tif fault != nil {\n819|\t\tfailure, err := failProtocol(\"adapter finding \"+fault.detail, fault.member)\n820|\t\tif err != nil {\n821|\t\t\treturn Finding{}, err\n822|\t\t}\n823|\t\treturn Finding{}, failure\n824|\t}\n825|\tif name, unknown := unknownMember(members, findingMembers); unknown {\n826|\t\tfailure, err := failProtocol(\"adapter finding carries unknown member\", name)\n827|\t\tif err != nil {\n828|\t\t\treturn Finding{}, err\n829|\t\t}\n830|\t\treturn Finding{}, failure\n831|\t}\n832|\tif name, missing := missingMember(members, findingRequired); missing {\n833|\t\tfailure, err := failProtocol(\"adapter finding misses a required member\", name)\n834|\t\tif err != nil {\n835|\t\t\treturn Finding{}, err\n836|\t\t}\n837|\t\treturn Finding{}, failure\n838|\t}\n839|\tseverity, ok := rawString(members[\"severity\"])\n840|\tif !ok || !validFindingSeverity(severity) {\n841|\t\tfailure, err := failProtocol(\"adapter finding severity is outside info|warning|error\", \"severity\")\n842|\t\tif err != nil {\n843|\t\t\treturn Finding{}, err\n844|\t\t}\n845|\t\treturn Finding{}, failure\n846|\t}\n847|\tcode, ok := checkStringBounds(members[\"code\"], 1, 128)\n848|\tif !ok {\n849|\t\tfailure, err := failProtocol(\"adapter finding code is not a string[1..128]\", \"code\")\n850|\t\tif err != nil {\n851|\t\t\treturn Finding{}, err\n852|\t\t}\n853|\t\treturn Finding{}, failure\n854|\t}\n855|\tmessage, ok := checkStringBounds(members[\"message\"], 1, 4096)\n856|\tif !ok {\n857|\t\tfailure, err := failProtocol(\"adapter finding message is not a string[1..4096]\", \"message\")\n858|\t\tif err != nil {\n859|\t\t\treturn Finding{}, err\n860|\t\t}\n861|\t\treturn Finding{}, failure\n862|\t}\n863|\tvar remediation *string\n864|\tif !isNull(members[\"remediation\"]) {\n865|\t\ttext, ok := checkStringBounds(members[\"remediation\"], 1, 4096)\n866|\t\tif !ok {\n867|\t\t\tfailure, err := failProtocol(\"adapter finding remediation is not a string[1..4096]\", \"remediation\")\n868|\t\t\tif err != nil {\n869|\t\t\t\treturn Finding{}, err\n870|\t\t\t}\n871|\t\t\treturn Finding{}, failure\n872|\t\t}\n873|\t\tremediation = &text\n874|\t}\n875|\tif !checkExtensions(members[\"extensions\"]) {\n876|\t\tfailure, err := failProtocol(\"adapter finding extensions are not reverse-DNS keyed\", \"extensions\")\n877|\t\tif err != nil {\n878|\t\t\treturn Finding{}, err\n879|\t\t}\n880|\t\treturn Finding{}, failure\n881|\t}\n882|\treturn Finding{\n883|\t\tSeverity:    severity,\n884|\t\tCode:        code,\n(more lines below)"}}}
