{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a642bf7931b429c0dae6267a52","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/operations.go`.\n(499 line(s) above)\n500|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n501|\t\t\treturn err\n502|\t\t}\n503|\t\tif err := requireNullableDigest(members, \"target_checkpoint_id\"); err != nil {\n504|\t\t\treturn err\n505|\t\t}\n506|\tcase OpDoctor:\n507|\t\tif direction, ok := rawString(members[\"direction\"]); !ok || !validDirection(direction) {\n508|\t\t\tfailure, err := failProtocol(\"doctor request direction is outside source_read|target_write\", \"direction\")\n509|\t\t\tif err != nil {\n510|\t\t\t\treturn err\n511|\t\t\t}\n512|\t\t\treturn failure\n513|\t\t}\n514|\t\tif err := requireDigest(members, \"tuple_registry_digest\"); err != nil {\n515|\t\t\treturn err\n516|\t\t}\n517|\t\tif _, err := requireBool(members, \"refresh_requested\"); err != nil {\n518|\t\t\treturn err\n519|\t\t}\n520|\t}\n521|\tif !checkExtensions(members[\"extensions\"]) {\n522|\t\tfailure, err := failProtocol(\"request body extensions are not reverse-DNS keyed\", \"extensions\")\n523|\t\tif err != nil {\n524|\t\t\treturn err\n525|\t\t}\n526|\t\treturn failure\n527|\t}\n528|\treturn nil\n529|}\n530|\n531|// fidelityProfiles is the four-profile vocabulary Section 7.8\n532|// states. archive_only is a strategy, never a profile. Membership\n533|// is a table loop so the census derives it like every other\n534|// closed vocabulary.\n535|var fidelityProfiles = []string{\n536|\t\"strict_exact\",\n537|\t\"maximal_safe\",\n538|\t\"compact\",\n539|\t\"messages_only\",\n540|}\n541|\n542|// validFidelityProfile reports whether the profile is one of the\n543|// four Section 7.8 fidelity profiles. archive_only is a strategy,\n544|// never a profile.\n545|func validFidelityProfile(profile string) bool {\n546|\tfor _, allowed := range fidelityProfiles {\n547|\t\tif profile == allowed {\n548|\t\t\treturn true\n549|\t\t}\n550|\t}\n551|\treturn false\n552|}\n553|\n554|// validateModes is the three-mode validate vocabulary.\n555|var validateModes = []string{\"staged\", \"live\", \"archive\"}\n556|\n557|// validValidateMode reports whether the mode is one of the three\n558|// validate modes.\n559|func validValidateMode(mode string) bool {\n560|\tfor _, allowed := range validateModes {\n561|\t\tif mode == allowed {\n562|\t\t\treturn true\n563|\t\t}\n564|\t}\n565|\treturn false\n566|}\n567|\n568|// checkRequiredDispositions validates the closed\n569|// required_dispositions map: an object whose every value is 1..7\n570|// sorted unique dispositions from the seven-vocabulary with\n571|// archive_only forbidden. The key vocabulary\n572|// (event-or-artifact-class) has no enumerable list in v0.5.0 —\n573|// the term occurs only in this table row — so keys validate as\n574|// present strings and the key closure is a stated bound.\n575|func checkRequiredDispositions(raw json.RawMessage) error {\n576|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n577|\tif fault != nil {\n578|\t\tfailure, err := failProtocol(\"projection required dispositions \"+fault.detail, \"required_dispositions\")\n579|\t\tif err != nil {\n580|\t\t\treturn err\n581|\t\t}\n582|\t\treturn failure\n583|\t}\n584|\tif len(members) == 0 {\n585|\t\tfailure, err := failProtocol(\"projection required dispositions carry no class\", \"required_dispositions\")\n586|\t\tif err != nil {\n587|\t\t\treturn err\n588|\t\t}\n589|\t\treturn failure\n590|\t}\n591|\tfor class, value := range members {\n592|\t\telements, ok := decodeArray(bytesTrimSpace(value))\n593|\t\tif !ok || len(elements) == 0 || len(elements) > 7 {\n594|\t\t\tfailure, err := failProtocol(\"projection disposition list is not 1..7 entries\", class)\n595|\t\t\tif err != nil {\n596|\t\t\t\treturn err\n597|\t\t\t}\n598|\t\t\treturn failure\n599|\t\t}\n600|\t\tprevious := \"\"\n601|\t\tfor _, element := range elements {\n602|\t\t\tdisposition, ok := rawString(element)\n603|\t\t\tif !ok || !validDisposition(disposition) {\n604|\t\t\t\tfailure, err := failProtocol(\"projection disposition is outside the seven-disposition vocabulary\", class)\n605|\t\t\t\tif err != nil {\n606|\t\t\t\t\treturn err\n607|\t\t\t\t}\n608|\t\t\t\treturn failure\n609|\t\t\t}\n610|\t\t\tif previous >= disposition && previous != \"\" {\n611|\t\t\t\tfailure, err := failProtocol(\"projection dispositions are not sorted unique\", class)\n612|\t\t\t\tif err != nil {\n613|\t\t\t\t\treturn err\n614|\t\t\t\t}\n615|\t\t\t\treturn failure\n616|\t\t\t}\n617|\t\t\tprevious = disposition\n618|\t\t}\n619|\t}\n620|\treturn nil\n621|}\n622|\n623|// checkValidateNullability enforces the validate mode rule on\n624|// request bodies: archive requires all four target members null,\n625|// staged and live require them non-null. Success bodies carry no\n626|// target members at all (the pinned Section 7.8 validate success\n627|// list names none), so the rule never applies there; checkValidateResult\n628|// does not call it.\n629|func checkValidateNullability(members map[string]json.RawMessage) error {\n630|\tmode, _ := rawString(members[\"mode\"])\n631|\ttargets := []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"}\n632|\tif mode == \"archive\" {\n633|\t\tfor _, name := range targets {\n634|\t\t\tif !isNull(members[name]) {\n635|\t\t\t\tfailure, err := failProtocol(\"validate archive mode carries a target member\", name)\n636|\t\t\t\tif err != nil {\n637|\t\t\t\t\treturn err\n638|\t\t\t\t}\n639|\t\t\t\treturn failure\n640|\t\t\t}\n641|\t\t}\n642|\t\treturn nil\n643|\t}\n644|\tfor _, name := range targets {\n645|\t\tif isNull(members[name]) {\n646|\t\t\tfailure, err := failProtocol(\"validate staged/live mode misses a target member\", name)\n647|\t\t\tif err != nil {\n648|\t\t\t\treturn err\n649|\t\t\t}\n650|\t\t\treturn failure\n651|\t\t}\n652|\t}\n653|\treturn nil\n654|}\n655|\n656|// SuccessFacts are the request-side facts one success body is\n657|// checked against: the sent context for the byte-for-byte echo,\n658|// the validate request mode for the mode pairing, the resume-plan\n659|// expected native identifier for the identity occurrence, and the\n660|// doctor request direction for the direction pairing. Unused\n661|// members stay zero for other operations.\n662|type SuccessFacts struct {\n663|\tContext         CallContext\n664|\tValidateMode    string\n665|\tResumeTargetID  string\n666|\tDoctorDirection Direction\n667|}\n668|\n669|// CheckSuccessBody validates one inbound success body for its\n670|// operation: the exact member set, the byte-for-byte context\n671|// echo, and the semantic gates Section 7.8 states per operation.\n672|// Manifest, probe, and doctor successes decode through their\n673|// dedicated decoders. An unknown operation is operation_unknown.\n674|func CheckSuccessBody(operation Operation, body []byte, facts SuccessFacts) error {\n675|\tif !validOperation(string(operation)) {\n676|\t\tfailure, err := failUnknownOperation(\"success body names an operation outside the closed registry\", string(operation))\n677|\t\tif err != nil {\n678|\t\t\treturn err\n679|\t\t}\n680|\t\treturn failure\n681|\t}\n682|\tswitch operation {\n683|\tcase OpManifest:\n684|\t\t_, err := DecodeManifest(body)\n685|\t\treturn err\n686|\tcase OpProbe:\n687|\t\t_, err := DecodeProbe(body)\n688|\t\treturn err\n689|\tcase OpDoctor:\n690|\t\t_, err := DecodeDoctorResult(body, facts.Context, facts.DoctorDirection)\n691|\t\treturn err\n692|\t}\n693|\tmembers, fault := decodeStrictObject(body)\n694|\tif fault != nil {\n695|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, fault.member)\n696|\t\tif err != nil {\n697|\t\t\treturn err\n698|\t\t}\n699|\t\treturn failure\n700|\t}\n701|\tallowed := successMemberSet(operation)\n702|\tif name, unknown := unknownMember(members, allowed); unknown {\n703|\t\tfailure, err := failProtocol(\"success body carries unknown member\", name)\n704|\t\tif err != nil {\n705|\t\t\treturn err\n706|\t\t}\n707|\t\treturn failure\n708|\t}\n709|\tif name, missing := missingMember(members, successBodyMembers[operation]); missing {\n710|\t\tfailure, err := failProtocol(\"success body misses a required member\", name)\n711|\t\tif err != nil {\n712|\t\t\treturn err\n713|\t\t}\n714|\t\treturn failure\n715|\t}\n716|\tif _, err := CheckContextEcho(facts.Context, members[\"context\"]); err != nil {\n717|\t\treturn err\n718|\t}\n719|\tif err := checkSuccessScalars(operation, members, facts); err != nil {\n720|\t\treturn err\n721|\t}\n722|\tif !checkExtensions(members[\"extensions\"]) {\n723|\t\tfailure, err := failProtocol(\"success body extensions are not reverse-DNS keyed\", \"extensions\")\n724|\t\tif err != nil {\n725|\t\t\treturn err\n726|\t\t}\n727|\t\treturn failure\n728|\t}\n729|\treturn nil\n730|}\n731|\n732|// checkSuccessScalars validates the inline members of one success\n733|// body plus the semantic gates.\n734|func checkSuccessScalars(operation Operation, members map[string]json.RawMessage, facts SuccessFacts) error {\n735|\tswitch operation {\n736|\tcase OpDiscover:\n737|\t\tif _, err := checkDiscoverSources(members[\"sources\"]); err != nil {\n738|\t\t\treturn err\n739|\t\t}\n740|\t\tpartial, err := requireBool(members, \"partial\")\n741|\t\tif err != nil {\n742|\t\t\treturn err\n743|\t\t}\n744|\t\tcursorNull := isNull(members[\"next_cursor\"]