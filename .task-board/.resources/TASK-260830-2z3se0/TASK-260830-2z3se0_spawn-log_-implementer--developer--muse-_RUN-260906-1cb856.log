{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ed","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":337,"recorded_at":1780531400000669,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a59dcb7e83b720105f3b120230","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/printer\"\n9|\t\"go/token\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"testing\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n19|)\n20|\n21|// This file is the closed-vocabulary census. It exists because a\n22|// new closed set in production — a map consulted for membership,\n23|// a slice looped for admission, a switch classifying inputs, an\n24|// inline comparison chain admitting two names — passes every\n25|// behavioral test that never names it. The census finds the\n26|// membership surface by parsing production source and fails\n27|// closed on anything with no registered derivation, so the\n28|// surface cannot grow something unwitnessed.\n29|//\n30|// Five checks:\n31|// TestClosedVocabularyTablesAreRegistered scans every\n32|// package-level var shaped like a vocabulary — a map or slice\n33|// composite, written directly or through a named slice or map\n34|// type declared anywhere in the package — and requires each in\n35|// the registration table below with its consultation proof.\n36|// TestNoUnregisteredInlineVocabularies forbids the shape the\n37|// table scan cannot see: a boolean chain comparing one operand\n38|// against two or more closed values (`v == \"a\" || v == \"b\"`,\n39|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n40|// or conversions). Every closed union lives in a registered\n41|// table; a chain is an unregistered union and fails here.\n42|// TestClosedMemberSetsAreDerivedFromSpec parses every closed\n43|// body from the pinned document and requires exact ordered\n44|// equality with the production member tables: a dropped, added,\n45|// or reordered member reddens here.\n46|// TestAllProductionSwitchesAreClassified allows only switches\n47|// dispatching on the validated operation plus the tagless UTF-16\n48|// hex classifier inside readUTF16Escape, named by function; any\n49|// other switch — including a tagless switch anywhere else — is a\n50|// membership gate hiding spot and fails.\n51|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n52|// against its verbatim spec union as a set.\n53|//\n54|// Stated bound: the scanner is syntactic. It sees package-level\n55|// composite shapes (single, shared, and paired initializers),\n56|// named-type aliases, and comparison chains — not function-local\n57|// composites, not unions encoded in a const string or a regexp\n58|// alternation, and not sets built at runtime (a map populated in\n59|// a loop, a registry assembled in init). This package holds no\n60|// const- or regexp-encoded union and builds no vocabulary at\n61|// runtime: every registered table is a package-level composite\n62|// literal, which the scan asserts by construction — a\n63|// runtime-built set would have to replace a composite the\n64|// census already pins. The five function-local obligation lists\n65|// (the validate target list, the two validate check triples,\n66|// the two target-write lists) are outside the table scan and\n67|// are pinned behaviourally instead, in both directions, by the\n68|// obligation tests.\n69|//\n70|// An empty scan, an empty derivation, or an unparseable file\n71|// fails closed throughout: a domain that silently derives\n72|// nothing is not a measurement.\n73|\n74|// registeredVocabulary is one production vocabulary table with\n75|// its consultation proof: the production function or call\n76|// pattern that consults it for membership.\n77|type registeredVocabulary struct {\n78|\tname       string\n79|\tconsulted  string\n80|\tspecMember string\n81|}\n82|\n83|// vocabularyRegistrations lists every package-level vocabulary\n84|// table. A production table with no row here fails the census.\n85|var vocabularyRegistrations = []registeredVocabulary{\n86|\t{name: \"operationOrder\", consulted: \"validOperation\", specMember: \"Section 7.8 operation table\"},\n87|\t{name: \"requestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 request envelope sentence\"},\n88|\t{name: \"requestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 request envelope sentence\"},\n89|\t{name: \"successMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 success envelope rule\"},\n90|\t{name: \"successRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 success envelope rule\"},\n91|\t{name: \"failureMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 failure envelope rule\"},\n92|\t{name: \"failureRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 failure envelope rule\"},\n93|\t{name: \"capabilityOrder\", consulted: \"decodeCapabilities\", specMember: \"Section 7.8 capability sentence\"},\n94|\t{name: \"manifestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 manifest table\"},\n95|\t{name: \"manifestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 manifest table\"},\n96|\t{name: \"probeMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 probe sentence\"},\n97|\t{name: \"probeRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 probe sentence\"},\n98|\t{name: \"capabilityValueMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 capability value sentence\"},\n99|\t{name: \"capabilityValueRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 capability value sentence\"},\n100|\t{name: \"capabilityEvidences\", consulted: \"validCapabilityEvidence\", specMember: \"Section 7.8 evidence union\"},\n101|\t{name: \"capabilityStatuses\", consulted: \"validCapabilityStatus\", specMember: \"Section 7.8 status union\"},\n102|\t{name: \"contextMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n103|\t{name: \"contextRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n104|\t{name: \"readAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n105|\t{name: \"readAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n106|\t{name: \"objectAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n107|\t{name: \"objectAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n108|\t{name: \"objectPurposes\", consulted: \"validObjectPurpose\", specMember: \"Section 7.8 purpose union\"},\n109|\t{name: \"objectModes\", consulted: \"validObjectMode\", specMember: \"Section 7.8 ObjectAuthority mode union\"},\n110|\t{name: \"readPurposes\", consulted: \"validReadPurpose\", specMember: \"Section 7.8 ReadAuthority purpose union\"},\n111|\t{name: \"findingSeverities\", consulted: \"validFindingSeverity\", specMember: \"Section 7.8 severity union\"},\n112|\t{name: \"sourceSelectorMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n113|\t{name: \"sourceSelectorRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n114|\t{name: \"resourceLimitsMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n115|\t{name: \"resourceLimitsRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n116|\t{name: \"findingMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n117|\t{name: \"findingRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n118|\t{name: \"capturePlanItemMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n119|\t{name: \"capturePlanItemRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n120|\t{name: \"tupleMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n121|\t{name: \"tupleRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n122|\t{name: \"projectionStrategies\", consulted: \"validStrategy\", specMember: \"Section 13.14 strategy sentence\"},\n123|\t{name: \"fidelityDispositions\", consulted: \"validDisposition\", specMember: \"Section 13.14 disposition sentence\"},\n124|\t{name: \"captureClasses\", consulted: \"validCaptureClass\", specMember: \"Section 13.14 CaptureItem class column\"},\n125|\t{name: \"tupleArchitectures\", consulted: \"validTupleArchitecture\", specMember: \"Section 7.8 architecture union\"},\n126|\t{name: \"tupleKeyMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 key sentence\"},\n127|\t{name: \"tupleKeyRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 key sentence\"},\n128|\t{name: \"tupleEntryMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 entry sentence\"},\n129|\t{name: \"tupleEntryRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 entry sentence\"},\n130|\t{name: \"fixtureEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n131|\t{name: \"fixtureEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n132|\t{name: \"smokeEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n133|\t{name: \"smokeEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n134|\t{name: \"fidelityLimitMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n135|\t{name: \"fidelityLimitRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n136|\t{name: \"requestBodyMembers\", consulted: \"CheckRequestBody\", specMember: \"Section 7.8 operation table\"},\n137|\t{name: \"successBodyMembers\", consulted: \"CheckSuccessBody\", specMember: \"Section 7.8 operation table\"},\n138|\t{name: \"fidelityProfiles\", consulted: \"validFidelityProfile\", specMember: \"Section 7.8 profile union\"},\n139|\t{name: \"validateModes\", consulted: \"validValidateMode\", specMember: \"Section 7.8 validate row\"},\n140|\t{name: \"contextFreeOperations\", consulted: \"operationSkipsRequestContext\", specMember: \"Section 7.8 operation table (context-free request bodies)\"},\n141|\t{name: \"doctorResultMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 doctor row\"},\n142|\t{name: \"doctorResultRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 doctor row\"},\n143|\t{name: \"directionNames\", consulted: \"validDirection\", specMember: \"Section 13.14 key direction union and Section 7.8 doctor row\"},\n144|\t{name: \"roleNames\", consulted: \"validRole\", specMember: \"Section 7.8 binding role union\"},\n145|\t{name: \"candidateKindNames\", consulted: \"validCandidateKind\", specMember: \"Section 7.8 candidate-kind union\"},\n146|\t{name: \"tupleEntryStatuses\", consulted: \"validTupleEntryStatus\", specMember: \"Section 13.14 entry status union\"},\n147|\t{name: \"evidenceResults\", consulted: \"validEvidenceResult\", specMember: \"Sections 13.14 result=pass\"},\n148|\t{name: \"registryEntryStatuses\", consulted: \"validRegistryEntryStatus\", specMember: \"Section 7.8 doctor row\"},\n149|}\n150|\n151|// TestClosedVocabularyTablesAreRegistered is the census: every\n152|// package-level vocabulary-shaped var must carry a registration\n153|// row naming its consultation. A new table without a row fails\n154|// here rather than passing silently.\n155|func TestClosedVocabularyTablesAreRegistered(t *testing.T) {\n156|\tdirectory, err := os.Getwd()\n157|\tif err != nil {\n158|\t\tt.Fatalf(\"census: %v\", err)\n159|\t}\n160|\tregistered := map[string]registeredVocabulary{}\n161|\tfor _, entry := range vocabularyRegistrations {\n162|\t\tif _, duplicate := registered[entry.name]; duplicate {\n163|\t\t\tt.Fatalf(\"census registers %q twice\", entry.name)\n164|\t\t}\n165|\t\tregistered[entry.name] = entry\n166|\t}\n167|\tfound, scanned := scanVocabularyTables(t, directory)\n168|\tif len(scanned) == 0 {\n169|\t\tt.Fatal(\"census scanned zero production files; the scanner is broken, not the package\")\n170|\t}\n171|\tif len(found) == 0 {\n172|\t\tt.Fatal(\"census found zero vocabulary tables; the scanner is broken, not the package\")\n173|\t}\n174|\tvar unregistered []string\n175|\tfor _, name := range found {\n176|\t\tentry, ok := registered[name]\n177|\t\tif !ok {\n178|\t\t\tunregistered = append(unregistered, name)\n179|\t\t\tcontinue\n180|\t\t}\n181|\t\tif entry.consulted == \"\" || entry.specMember == \"\" {\n182|\t\t\tt.Errorf(\"census registration of %q names no consultation or spec member\", name)\n183|\t\t}\n184|\t}\n185|\tsort.Strings(unregistered)\n186|\tif len(unregistered) > 0 {\n187|\t\tt.Fatalf(\"production vocabulary table(s) with no census registration:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n188|\t}\n189|\tvar orphaned []string\n190|\tfor name := range registered {\n191|\t\tpresent := false\n192|\t\tfor _, table := range found {\n193|\t\t\tif table == name {\n194|\t\t\t\tpresent = true\n195|\t\t\t\tbreak\n196|\t\t\t}\n197|\t\t}\n198|\t\tif !present {\n199|\t\t\torphaned = append(orphaned, name)\n200|\t\t}\n201|\t}\n202|\tsort.Strings(orphaned)\n203|\tif len(orphaned) > 0 {\n204|\t\tt.Fatalf(\"census registration(s) naming no production table:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n205|\t}\n206|\tt.Logf(\"vocabulary census: %d tables registered across %d files\", len(found), len(scanned))\n207|}\n208|\n209|// scanVocabularyTables returns every package-level var shaped\n210|// like a vocabulary: a map or slice composite, written directly\n211|// or through a named slice or map type declared anywhere in the\n212|// package. A named-type table (`type names []string` plus\n213|// `var t = names{...}`) is the same closed set as a literal one,\n214|// and the census sees both.\n215|func scanVocabularyTables(t *testing.T, directory string) ([]string, []string) {\n216|\tt.Helper()\n217|\tentries, err := os.ReadDir(directory)\n218|\tif err != nil {\n219|\t\tt.Fatalf(\"census: %v\", err)\n220|\t}\n221|\ttype namedFile struct {\n222|\t\tname   string\n223|\t\tsyntax *ast.File\n224|\t}\n225|\tvar files []namedFile\n226|\tvar scanned []string\n227|\tfor _, entry := range entries {\n228|\t\tname := entry.Name()\n229|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n230|\t\t\tcontinue\n231|\t\t}\n232|\t\tscanned = append(scanned, name)\n233|\t\tpath := filepath.Join(directory, name)\n234|\t\tsource, err := os.ReadFile(path)\n235|\t\tif err != nil {\n236|\t\t\tt.Fatalf(\"census: %v\", err)\n237|\t\t}\n238|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n239|\t\tif err != nil {\n240|\t\t\tt.Fatalf(\"census: %v\", err)\n241|\t\t}\n242|\t\tfiles = append(files, namedFile{name: name, syntax: syntax})\n243|\t}\n244|\tnamed := map[string]ast.Expr{}\n245|\tfor _, file := range files {\n246|\t\tcollectNamedCompositeTypes(file.syntax, named)\n247|\t}\n248|\tvar found []string\n249|\tfor _, file := range files {\n250|\t\tfound = append(found, vocabularyTablesInFile(file.syntax, named)...)\n251|\t}\n252|\treturn found, scanned\n253|}\n254|\n255|// collectNamedCompositeTypes records every package-level type\n256|// name declared with a composite underlying type: a direct map or\n257|// slice, or another named type resolved later. Struct, string,\n258|// and other underlying types are recorded too, so a struct\n259|// literal through a named type is never mistaken for a table.\n260|func collectNamedCompositeTypes(syntax *ast.File, named map[string]ast.Expr) {\n261|\tfor _, declaration := range syntax.Decls {\n262|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n263|\t\tif !ok || general.Tok != token.TYPE {\n264|\t\t\tcontinue\n265|\t\t}\n266|\t\tfor _, specification := range general.Specs {\n267|\t\t\talias, ok := specification.(*ast.TypeSpec)\n268|\t\t\tif !ok {\n269|\t\t\t\tcontinue\n270|\t\t\t}\n271|\t\t\tnamed[alias.Name.Name] = alias.Type\n272|\t\t}\n273|\t}\n274|}\n275|\n276|// vocabularyTablesInFile returns the package-level vars of one\n277|// file whose initializer is a vocabulary composite. One shared\n278|// initializer serves every name; paired initializers serve their\n279|// own name each (`var a, b = []string{...}, []string{...}`), so\n280|// a multi-name declaration never hides a table from the scan.\n281|func vocabularyTablesInFile(syntax *ast.File, named map[string]ast.Expr) []string {\n282|\tvar found []string\n283|\tfor _, declaration := range syntax.Decls {\n284|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n285|\t\tif !ok || general.Tok != token.VAR {\n286|\t\t\tcontinue\n287|\t\t}\n288|\t\tfor _, specification := range general.Specs {\n289|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n290|\t\t\tif !ok || len(value.Values) == 0 {\n291|\t\t\t\tcontinue\n292|\t\t\t}\n293|\t\t\tfor index, ident := range value.Names {\n294|\t\t\t\tvar initializer ast.Expr\n295|\t\t\t\tswitch {\n296|\t\t\t\tcase len(value.Values) == 1:\n297|\t\t\t\t\tinitializer = value.Values[0]\n298|\t\t\t\tcase index < len(value.Values):\n299|\t\t\t\t\tinitializer = value.Values[index]\n300|\t\t\t\tdefault:\n301|\t\t\t\t\tcontinue\n302|\t\t\t\t}\n303|\t\t\t\tif isVocabularyShape(initializer, named) {\n304|\t\t\t\t\tfound = append(found, ident.Name)\n305|\t\t\t\t}\n306|\t\t\t}\n307|\t\t}\n308|\t}\n309|\treturn found\n310|}\n311|\n312|// isVocabularyShape reports whether the initializer is a\n313|// vocabulary composite: a map or slice literal, or a composite\n314|// through a named type whose underlying type — resolved across\n315|// the package, through any alias chain — is a map or slice.\n316|// Element type is irrelevant; registrations name the table, not\n317|// its shape. A composite through any other named type (a struct\n318|// literal, a string conversion) is not a table.\n319|func isVocabularyShape(node ast.Expr, named map[string]ast.Expr) bool {\n320|\tliteral, ok := node.(*ast.CompositeLit)\n321|\tif !ok {\n322|\t\treturn false\n323|\t}\n324|\tswitch typ := literal.Type.(type) {\n325|\tcase *ast.MapType, *ast.ArrayType:\n326|\t\treturn true\n327|\tcase *ast.Ident:\n328|\t\treturn resolvesToComposite(typ.Name, named, 0)\n329|\t}\n330|\treturn false\n331|}\n332|\n333|// resolvesToComposite reports whether the named type ultimately\n334|// denotes a map or slice. Alias chains resolve up to a fixed\n335|// depth; a cycle or an unknown name is not a table.\n336|func resolvesToComposite(name string, named map[string]ast.Expr, depth int) bool {\n337|\tif depth > 8 {\n338|\t\treturn false\n339|\t}\n340|\tunderlying, ok := named[name]\n341|\tif !ok {\n342|\t\treturn false\n343|\t}\n344|\tswitch typ := underlying.(type) {\n345|\tcase *ast.MapType, *ast.ArrayType:\n346|\t\treturn true\n347|\tcase *ast.Ident:\n348|\t\treturn resolvesToComposite(typ.Name, named, depth+1)\n349|\t}\n350|\treturn false\n351|}\n352|\n353|// TestAllProductionSwitchesAreClassified allows only switches\n354|// dispatching on the validated operation plus the tagless UTF-16\n355|// hex classifier inside readUTF16Escape. Any other switch —\n356|// including a tagless switch in any other function — is a\n357|// membership gate hiding spot and fails: membership lives in\n358|// tables the census sees, never in case arms it cannot.\n359|func TestAllProductionSwitchesAreClassified(t *testing.T) {\n360|\tdirectory, err := os.Getwd()\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"switch census: %v\", err)\n363|\t}\n364|\tentries, err := os.ReadDir(directory)\n365|\tif err != nil {\n366|\t\tt.Fatalf(\"switch census: %v\", err)\n367|\t}\n368|\tscanned := 0\n369|\tclassified := 0\n370|\tvar unclassified []string\n371|\tfor _, entry := range entries {\n372|\t\tname := entry.Name()\n373|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n374|\t\t\tcontinue\n375|\t\t}\n376|\t\tscanned++\n377|\t\tpath := filepath.Join(directory, name)\n378|\t\tsource, err := os.ReadFile(path)\n379|\t\tif err != nil {\n380|\t\t\tt.Fatalf(\"switch census: %v\", err)\n381|\t\t}\n382|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n383|\t\tif err != nil {\n384|\t\t\tt.Fatalf(\"switch census: %v\", err)\n385|\t\t}\n386|\t\tvar stack []ast.Node\n387|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n388|\t\t\tif node == nil {\n389|\t\t\t\tstack = stack[:len(stack)-1]\n390|\t\t\t\treturn true\n391|\t\t\t}\n392|\t\t\tif statement, ok := node.(*ast.SwitchStmt); ok {\n393|\t\t\t\tposition := filepath.Base(path)\n394|\t\t\t\tif classifySwitch(statement.Tag, enclosingFunc(stack)) {\n395|\t\t\t\t\tclassified++\n396|\t\t\t\t} else {\n397|\t\t\t\t\tunclassified = append(unclassified, position)\n398|\t\t\t\t}\n399|\t\t\t}\n400|\t\t\tstack = append(stack, node)\n401|\t\t\treturn true\n402|\t\t})\n403|\t}\n404|\tif scanned == 0 {\n405|\t\tt.Fatal(\"switch census scanned zero production files\")\n406|\t}\n407|\tsort.Strings(unclassified)\n408|\tif len(unclassified) > 0 {\n409|\t\tt.Fatalf(\"unclassified production switch(es): %s\", strings.Join(unclassified, \", \"))\n410|\t}\n411|\tt.Logf(\"switch census: %d classified switches across %d files\", classified, scanned)\n412|}\n413|\n414|// enclosingFunc names the innermost function declaration above\n415|// the current walk position, or \"\" outside any function. The\n416|// switch census uses it to confine the tagless-switch exemption\n417|// to readUTF16Escape by name rather than exempting the shape.\n418|func enclosingFunc(stack []ast.Node) string {\n419|\tfor index := len(stack) - 1; index >= 0; index-- {\n420|\t\tif declaration, ok := stack[index].(*ast.FuncDecl); ok {\n421|\t\t\treturn declaration.Name.Name\n422|\t\t}\n423|\t}\n424|\treturn \"\"\n425|}\n426|\n427|// classifySwitch reports whether a switch with the given tag in\n428|// the named function is an allowed classifier: a dispatch on\n429|// the validated operation, or the tagless UTF-16 hex classifier\n430|// inside readUTF16Escape — which switches over digit ranges and\n431|// classifies characters rather than admitting members. Only\n432|// this function earns the tagless exemption; a tagless switch\n433|// anywhere else is a membership gate hiding spot.\n434|func classifySwitch(tag ast.Expr, function string) bool {\n435|\tif ident, ok := tag.(*ast.Ident); ok && ident.Name == \"operation\" {\n436|\t\treturn true\n437|\t}\n438|\treturn tag == nil && function == \"readUTF16Escape\"\n439|}\n440|\n441|// TestSwitchClassifierNamesItsExemption proves the switch gate\n442|// shape against synthetic inputs: the operation dispatch passes\n443|// anywhere, the tagless classifier passes only inside\n444|// readUTF16Escape, and a tagless switch in any other function\n445|// fails — the sentence the census header states.\n446|func TestSwitchClassifierNamesItsExemption(t *testing.T) {\n447|\toperation := &ast.Ident{Name: \"operation\"}\n448|\tother := &ast.Ident{Name: \"mode\"}\n449|\tfor _, probe := range []struct {\n450|\t\tname     string\n451|\t\ttag      ast.Expr\n452|\t\tfunction string\n453|\t\twant     bool\n454|\t}{\n455|\t\t{\"operation dispatch passes\", operation, \"checkRequestScalars\", true},\n456|\t\t{\"tagless classifier passes in readUTF16Escape\", nil, \"readUTF16Escape\", true},\n457|\t\t{\"tagless switch fails elsewhere\", nil, \"CheckSuccessBody\", false},\n458|\t\t{\"other tag fails\", other, \"checkRequestScalars\", false},\n459|\t} {\n460|\t\tt.Run(probe.name, func(t *testing.T) {\n461|\t\t\tif got := classifySwitch(probe.tag, probe.function); got != probe.want {\n462|\t\t\t\tt.Fatalf(\"classifySwitch(tag, %q) = %v, want %v\", probe.function, got, probe.want)\n463|\t\t\t}\n464|\t\t})\n465|\t}\n466|}\n467|\n468|// TestNoUnregisteredInlineVocabularies is the chain census: no\n469|// production boolean chain may compare one operand against two\n470|// or more closed values. `v == \"a\" || v == \"b\"`,\n471|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n472|// (`role != RoleSource && role != RoleTarget`) or conversions are\n473|// unions outside every table, and a widened chain survives every\n474|// behavioral test that never names the new member. Single\n475|// comparisons — one dispatch member (`mode == \"archive\"`), one\n476|// sentinel (`== \"\"`), one echo — are not unions and pass.\n477|func TestNoUnregisteredInlineVocabularies(t *testing.T) {\n478|\tdirectory, err := os.Getwd()\n479|\tif err != nil {\n480|\t\tt.Fatalf(\"chain census: %v\", err)\n481|\t}\n482|\tentries, err := os.ReadDir(directory)\n483|\tif err != nil {\n484|\t\tt.Fatalf(\"chain census: %v\", err)\n485|\t}\n486|\tscanned := 0\n487|\tvar unregistered []string\n488|\tfor _, entry := range entries {\n489|\t\tname := entry.Name()\n490|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n491|\t\t\tcontinue\n492|\t\t}\n493|\t\tscanned++\n494|\t\tpath := filepath.Join(directory, name)\n495|\t\tsource, err := os.ReadFile(path)\n496|\t\tif err != nil {\n497|\t\t\tt.Fatalf(\"chain census: %v\", err)\n498|\t\t}\n499|\t\tfileSet := token.NewFileSet()\n500|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ef","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":338,"recorded_at":1780531400000671,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a59eac73b2af4c1ee87e28795b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/zero_absent_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"testing\"\n6|)\n7|\n8|// This file closes the zero-value / absent-fact class (review rev3\n9|// B4): every envelope echo comparison must refuse the empty string,\n10|// and every map-presence default must refuse an absent name. The\n11|// subjects are derived from production — the envelope member lists\n12|// from the Required slices, the target-write names from\n13|// DoctorRequiredCapabilities, the capability names from\n14|// capabilityOrder — so a new echo gate or required capability with\n15|// no row here fails the derivation guard rather than passing\n16|// silently.\n17|\n18|// TestEnvelopeEchoEmptyStringRefuses drives \"\" through every echo\n19|// comparison at the production entry: the two request identity\n20|// checks through DecodeRequestFrame, the four success echoes and\n21|// the four failure echoes through CheckSuccessEnvelope and\n22|// CheckFailureEnvelope. A mutant narrowing any one gate to\n23|// `(x != want && x != \"\")` admits its row and reddens here.\n24|func TestEnvelopeEchoEmptyStringRefuses(t *testing.T) {\n25|\tif len(requestRequired) < 2 || requestRequired[0] != \"protocol\" || requestRequired[1] != \"protocol_version\" {\n26|\t\tt.Fatalf(\"request echo derivation changed: head = %v, want [protocol protocol_version]\", requestRequired)\n27|\t}\n28|\tif len(successRequired) < 4 || successRequired[0] != \"protocol\" || successRequired[1] != \"protocol_version\" || successRequired[2] != \"request_id\" || successRequired[3] != \"operation\" {\n29|\t\tt.Fatalf(\"success echo derivation changed: head = %v\", successRequired)\n30|\t}\n31|\tif len(failureRequired) < 4 || failureRequired[0] != \"protocol\" || failureRequired[1] != \"protocol_version\" || failureRequired[2] != \"request_id\" || failureRequired[3] != \"operation\" {\n32|\t\tt.Fatalf(\"failure echo derivation changed: head = %v\", failureRequired)\n33|\t}\n34|\twant := wantRequest()\n35|\techoWant := map[string]string{\n36|\t\t\"protocol\":         ProtocolID,\n37|\t\t\"protocol_version\": ProtocolVersion,\n38|\t\t\"request_id\":       want.RequestID,\n39|\t\t\"operation\":        string(want.Operation),\n40|\t}\n41|\trequestText := map[string]string{\n42|\t\t\"protocol\":         \"not the session adapter\",\n43|\t\t\"protocol_version\": \"not 1.0.0\",\n44|\t}\n45|\tprobeBody := `{\"expected_provider_id\":\"test-provider\",\"expected_candidate_kind\":\"builtin\",\"extensions\":{}}`\n46|\tsuccessBody := func() []byte {\n47|\t\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":true,\"body\":{}}`,\n48|\t\t\tProtocolID, fixtureRequestID))\n49|\t}\n50|\tfailureBody := func() []byte {\n51|\t\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.1.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`,\n52|\t\t\tProtocolID, fixtureRequestID))\n53|\t}\n54|\trows := 0\n55|\tfor _, member := range requestRequired[:2] {\n56|\t\tmember := member\n57|\t\tt.Run(\"request/\"+member, func(t *testing.T) {\n58|\t\t\tframe := mutateMember(t, fixtureRequestFrame(t, OpProbe, probeBody), member, `\"\"`)\n59|\t\t\t_, err := DecodeRequestFrame(frame)\n60|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, requestText[member])\n61|\t\t})\n62|\t\trows++\n63|\t}\n64|\tfor _, member := range successRequired[:4] {\n65|\t\tmember := member\n66|\t\tt.Run(\"success/\"+member, func(t *testing.T) {\n67|\t\t\tframe := mutateMember(t, successBody(), member, `\"\"`)\n68|\t\t\t_, err := CheckSuccessEnvelope(frame, want)\n69|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"does not echo\")\n70|\t\t})\n71|\t\trows++\n72|\t}\n73|\tfor _, member := range failureRequired[:4] {\n74|\t\tmember := member\n75|\t\tt.Run(\"failure/\"+member, func(t *testing.T) {\n76|\t\t\tframe := mutateMember(t, failureBody(), member, `\"\"`)\n77|\t\t\t_, err := CheckFailureEnvelope(frame, want)\n78|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"does not echo\")\n79|\t\t})\n80|\t\trows++\n81|\t}\n82|\tif rows != 10 {\n83|\t\tt.Fatalf(\"echo rows = %d, want 10 (2 request + 4 success + 4 failure); the derivation is short\", rows)\n84|\t}\n85|\tfor member, value := range echoWant {\n86|\t\tif value == \"\" {\n87|\t\t\tt.Fatalf(\"echo want for %q is empty; the probe is broken, not the gate\", member)\n88|\t\t}\n89|\t}\n90|}\n91|\n92|// TestCheckTargetWriteGatesAbsentAdapterRefuses is the adapter-side\n93|// twin of the provider-side \"missing surface is refused, never\n94|// defaulted\" case: every always-required adapter capability is\n95|// deleted alone from a whole map and must refuse naming it, and the\n96|// writer pair deleted together must refuse naming the pair. The\n97|// required names come from DoctorRequiredCapabilities, not from a\n98|// hand list. A mutant defaulting an absent adapter name to usable\n99|// admits here and reddens.\n100|func TestCheckTargetWriteGatesAbsentAdapterRefuses(t *testing.T) {\n101|\tprobe, _ := fixtureValidProbe(t)\n102|\tprovider := map[string]ProviderCapability{\n103|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n104|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n105|\t}\n106|\trequired := map[string]bool{}\n107|\tfor _, name := range DoctorRequiredCapabilities(DirectionTargetWrite, false) {\n108|\t\trequired[name] = true\n109|\t}\n110|\tfor _, name := range DoctorRequiredCapabilities(DirectionTargetWrite, true) {\n111|\t\trequired[name] = true\n112|\t}\n113|\tif len(required) != 5 || !required[\"canonical_write\"] || !required[\"official_import\"] ||\n114|\t\t!required[\"native_read_back\"] || !required[\"native_resume_plan\"] || !required[\"workspace_binding\"] {\n115|\t\tt.Fatalf(\"derived target-write adapter set = %v, want the five-name set\", required)\n116|\t}\n117|\t// Each always-required capability deleted alone refuses naming it.\n118|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n119|\t\tt.Run(\"absent \"+name, func(t *testing.T) {\n120|\t\t\twithout := cloneCapabilities(probe.Capabilities)\n121|\t\t\tdelete(without, name)\n122|\t\t\terr := CheckTargetWriteGates(without, provider)\n123|\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", name, \"usable adapter capability\")\n124|\t\t})\n125|\t}\n126|\t// Each writer deleted alone still passes through the other half\n127|\t// of the disjunction: absence is refused only when both are gone.\n128|\tfor _, name := range []string{\"canonical_write\", \"official_import\"} {\n129|\t\tt.Run(\"absent one writer \"+name, func(t *testing.T) {\n130|\t\t\twithout := cloneCapabilities(probe.Capabilities)\n131|\t\t\tdelete(without, name)\n132|\t\t\tif err := CheckTargetWriteGates(without, provider); err != nil {\n133|\t\t\t\tt.Fatalf(\"CheckTargetWriteGates with one writer absent: %v\", err)\n134|\t\t\t}\n135|\t\t})\n136|\t}\n137|\tt.Run(\"absent both writers\", func(t *testing.T) {\n138|\t\twithout := cloneCapabilities(probe.Capabilities)\n139|\t\tdelete(without, \"canonical_write\")\n140|\t\tdelete(without, \"official_import\")\n141|\t\terr := CheckTargetWriteGates(without, provider)\n142|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"canonical_write|official_import\", \"neither usable\")\n143|\t})\n144|}\n145|\n146|// TestCapabilityUsableAbsentIsNotUsable pins the presence default\n147|// at the unit level for every registry name: deleting any one\n148|// capability from a whole map makes exactly that name unusable,\n149|// and the empty or unknown name is never usable. A mutant\n150|// defaulting an absent name to usable inverts every row here.\n151|func TestCapabilityUsableAbsentIsNotUsable(t *testing.T) {\n152|\tprobe, _ := fixtureValidProbe(t)\n153|\tfor _, name := range capabilityOrder {\n154|\t\tif !CapabilityUsable(probe, name) {\n155|\t\t\tt.Fatalf(\"CapabilityUsable(%q) = false on the whole probe; the fixture is broken\", name)\n156|\t\t}\n157|\t\twithout := probe\n158|\t\twithout.Capabilities = cloneCapabilities(probe.Capabilities)\n159|\t\tdelete(without.Capabilities, name)\n160|\t\tif CapabilityUsable(without, name) {\n161|\t\t\tt.Fatalf(\"CapabilityUsable(%q) = true with the capability absent\", name)\n162|\t\t}\n163|\t\tif capabilityMapUsable(without.Capabilities, name) {\n164|\t\t\tt.Fatalf(\"capabilityMapUsable(%q) = true with the capability absent\", name)\n165|\t\t}\n166|\t}\n167|\tfor _, name := range []string{\"\", \"no_such_capability\"} {\n168|\t\tif CapabilityUsable(probe, name) {\n169|\t\t\tt.Fatalf(\"CapabilityUsable(%q) = true; an unseen name is never usable\", name)\n170|\t\t}\n171|\t\tif capabilityMapUsable(probe.Capabilities, name) {\n172|\t\t\tt.Fatalf(\"capabilityMapUsable(%q) = true; an unseen name is never usable\", name)\n173|\t\t}\n174|\t}\n175|}\n176|\n177|// TestCheckDoctorHealthyRefusesEmptyRequiredName pins the name gate\n178|// against the zero value: a required set naming \"\" is a caller\n179|// error, never a vacuous pass. A mutant exempting the empty name\n180|// (`!validCapabilityName(name) && name != \"\"`) admits here.\n181|func TestCheckDoctorHealthyRefusesEmptyRequiredName(t *testing.T) {\n182|\tmanifestDigest := fixtureManifestDigestText(t)\n183|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n184|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n185|\tif err != nil {\n186|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n187|\t}\n188|\tprobe, _ := fixtureValidProbe(t)\n189|\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n190|\thealthy, err := DecodeDoctorResult(mutateMember(t, good, \"healthy\", `true`), decoded, DirectionSourceRead)\n191|\tif err != nil {\n192|\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n193|\t}\n194|\terr = CheckDoctorHealthy(healthy, probe, []string{\"\"})\n195|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"required\", \"closed registry\")\n196|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a59f757411bcd737004c226c62","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/bounds_edge_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strconv\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// This file pins every rev3-B5 contract string maximum and array cap\n11|// at the edge (review rev3 B5): each bound is driven at the limit\n12|// (admitted) and one past it (refused), with the same for one below\n13|// the minimum. A witness far outside the range proves the arm\n14|// exists, not where the bound sits; a mutant moving any bound by\n15|// exactly one admits exactly one member of the reject class and\n16|// reddens its row here. Lengths are characters: the repeat rune is\n17|// ASCII, so bytes equal runes.\n18|\n19|// quotedRepeat renders a JSON string literal of exactly n characters.\n20|func quotedRepeat(n int) string {\n21|\treturn strconv.Quote(strings.Repeat(\"a\", n))\n22|}\n23|\n24|// stringBoundRow is one checkStringBounds maximum pinned at the\n25|// production entry: drive maps a JSON string literal to the entry's\n26|// verdict, member/text name the bound refusal for requireRefusal.\n27|type stringBoundRow struct {\n28|\tname   string\n29|\tmin    int\n30|\tmax    int\n31|\tmember string\n32|\ttext   string\n33|\tdrive  func(t *testing.T, literal string) error\n34|}\n35|\n36|// TestStringBoundEdges drives every survivor string maximum at\n37|// max-1/min/max/max+1 through its production entry point.\n38|func TestStringBoundEdges(t *testing.T) {\n39|\trows := []stringBoundRow{\n40|\t\t{\n41|\t\t\tname: \"manifest environment_version_range\", min: 1, max: 256,\n42|\t\t\tmember: \"environment_version_range\", text: \"string[1..256]\",\n43|\t\t\tdrive: func(t *testing.T, literal string) error {\n44|\t\t\t\t_, err := DecodeManifest(mutateMember(t, []byte(fixtureManifestJSON()), \"environment_version_range\", literal))\n45|\t\t\t\treturn err\n46|\t\t\t},\n47|\t\t},\n48|\t\t{\n49|\t\t\tname: \"source native_session_id\", min: 1, max: 512,\n50|\t\t\tmember: \"native_session_id\", text: \"string[1..512]\",\n51|\t\t\tdrive: func(t *testing.T, literal string) error {\n52|\t\t\t\t_, err := DecodeSourceSelector([]byte(`{\"native_session_id\":` + literal + `,\"logical_workspace_id\":null,\"opaque_source_ref\":null}`))\n53|\t\t\t\treturn err\n54|\t\t\t},\n55|\t\t},\n56|\t\t{\n57|\t\t\tname: \"source opaque_source_ref\", min: 1, max: 512,\n58|\t\t\tmember: \"opaque_source_ref\", text: \"string[1..512]\",\n59|\t\t\tdrive: func(t *testing.T, literal string) error {\n60|\t\t\t\t_, err := DecodeSourceSelector([]byte(`{\"native_session_id\":null,\"logical_workspace_id\":null,\"opaque_source_ref\":` + literal + `}`))\n61|\t\t\t\treturn err\n62|\t\t\t},\n63|\t\t},\n64|\t\t{\n65|\t\t\tname: \"finding code\", min: 1, max: 128,\n66|\t\t\tmember: \"code\", text: \"string[1..128]\",\n67|\t\t\tdrive: func(t *testing.T, literal string) error {\n68|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n69|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"code\", literal))\n70|\t\t\t\treturn err\n71|\t\t\t},\n72|\t\t},\n73|\t\t{\n74|\t\t\tname: \"finding message\", min: 1, max: 4096,\n75|\t\t\tmember: \"message\", text: \"string[1..4096]\",\n76|\t\t\tdrive: func(t *testing.T, literal string) error {\n77|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n78|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"message\", literal))\n79|\t\t\t\treturn err\n80|\t\t\t},\n81|\t\t},\n82|\t\t{\n83|\t\t\tname: \"finding remediation\", min: 1, max: 4096,\n84|\t\t\tmember: \"remediation\", text: \"string[1..4096]\",\n85|\t\t\tdrive: func(t *testing.T, literal string) error {\n86|\t\t\t\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n87|\t\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), \"remediation\", literal))\n88|\t\t\t\treturn err\n89|\t\t\t},\n90|\t\t},\n91|\t\t{\n92|\t\t\tname: \"capture native_item_key\", min: 1, max: 512,\n93|\t\t\tmember: \"native_item_key\", text: \"string[1..512]\",\n94|\t\t\tdrive: func(t *testing.T, literal string) error {\n95|\t\t\t\tvalid := `{\"native_item_key\":\"item-1\",\"class\":\"durable_payload\",\"byte_count\":12,\"required\":true,\"extensions\":{}}`\n96|\t\t\t\t_, err := DecodeCapturePlanItem(mutateMember(t, []byte(valid), \"native_item_key\", literal))\n97|\t\t\t\treturn err\n98|\t\t\t},\n99|\t\t},\n100|\t\t{\n101|\t\t\tname: \"resume argv word\", min: 1, max: 4096,\n102|\t\t\tmember: \"argv\", text: \"string[1..4096]\",\n103|\t\t\tdrive: func(t *testing.T, literal string) error {\n104|\t\t\t\treturn checkResumeArgv(t, `[\"target-1\",`+literal+`]`)\n105|\t\t\t},\n106|\t\t},\n107|\t\t{\n108|\t\t\tname: \"tuple environment_version\", min: 1, max: 128,\n109|\t\t\tmember: \"environment_version\", text: \"string[1..128]\",\n110|\t\t\tdrive: func(t *testing.T, literal string) error {\n111|\t\t\t\t_, err := DecodeTuple(mutateMember(t, []byte(fixtureTupleJSON()), \"environment_version\", literal))\n112|\t\t\t\treturn err\n113|\t\t\t},\n114|\t\t},\n115|\t\t{\n116|\t\t\tname: \"tuple suite_revision\", min: 1, max: 128,\n117|\t\t\tmember: \"suite_revision\", text: \"string[1..128]\",\n118|\t\t\tdrive: func(t *testing.T, literal string) error {\n119|\t\t\t\t_, err := DecodeTupleEntry(mutateNested(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"fixture_evidence\", \"suite_revision\", literal))\n120|\t\t\t\treturn err\n121|\t\t\t},\n122|\t\t},\n123|\t\t{\n124|\t\t\tname: \"tuple native_cli_family\", min: 1, max: 128,\n125|\t\t\tmember: \"native_cli_family\", text: \"string[1..128]\",\n126|\t\t\tdrive: func(t *testing.T, literal string) error {\n127|\t\t\t\t_, err := DecodeTupleEntry(mutateNested(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"resume_smoke_evidence\", \"native_cli_family\", literal))\n128|\t\t\t\treturn err\n129|\t\t\t},\n130|\t\t},\n131|\t\t{\n132|\t\t\tname: \"fidelity code\", min: 1, max: 128,\n133|\t\t\tmember: \"code\", text: \"string[1..128]\",\n134|\t\t\tdrive: func(t *testing.T, literal string) error {\n135|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(literal, `\"c\"`, `\"d\"`)+`]`, DirectionTargetWrite))\n136|\t\t\t\treturn err\n137|\t\t\t},\n138|\t\t},\n139|\t\t{\n140|\t\t\tname: \"fidelity affected_class\", min: 1, max: 128,\n141|\t\t\tmember: \"affected_class\", text: \"string[1..128]\",\n142|\t\t\tdrive: func(t *testing.T, literal string) error {\n143|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(`\"c\"`, literal, `\"d\"`)+`]`, DirectionTargetWrite))\n144|\t\t\t\treturn err\n145|\t\t\t},\n146|\t\t},\n147|\t\t{\n148|\t\t\tname: \"fidelity detail\", min: 1, max: 4096,\n149|\t\t\tmember: \"detail\", text: \"string[1..4096]\",\n150|\t\t\tdrive: func(t *testing.T, literal string) error {\n151|\t\t\t\t_, err := DecodeTupleEntry(withFidelityLimits(t, `[`+fidelityRow(`\"c\"`, `\"a\"`, literal)+`]`, DirectionTargetWrite))\n152|\t\t\t\treturn err\n153|\t\t\t},\n154|\t\t},\n155|\t\t{\n156|\t\t\tname: \"contract identifier\", min: 1, max: 256,\n157|\t\t\tmember: \"contract_id\", text: \"string[1..256]\",\n158|\t\t\tdrive: func(t *testing.T, literal string) error {\n159|\t\t\t\t_, err := DecodeTupleEntry(withContracts(t, `[`+contractRow(literal, []string{`\"1.0.0\"`})+`]`))\n160|\t\t\t\treturn err\n161|\t\t\t},\n162|\t\t},\n163|\t\t{\n164|\t\t\tname: \"revocation reason\", min: 1, max: 4096,\n165|\t\t\tmember: \"revocation_reason\", text: \"string[1..4096]\",\n166|\t\t\tdrive: func(t *testing.T, literal string) error {\n167|\t\t\t\t_, err := DecodeTupleEntry(revokedWithReason(t, literal))\n168|\t\t\t\treturn err\n169|\t\t\t},\n170|\t\t},\n171|\t\t{\n172|\t\t\tname: \"probe detail\", min: 0, max: 2048,\n173|\t\t\tmember: \"tool_history\", text: \"string[0..2048]\",\n174|\t\t\tdrive: func(t *testing.T, literal string) error {\n175|\t\t\t\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n176|\t\t\t\tif err != nil {\n177|\t\t\t\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n178|\t\t\t\t}\n179|\t\t\t\tdigest := ManifestDigest(manifest).String()\n180|\t\t\t\tfixture := []byte(fixtureProbeJSON(digest))\n181|\t\t\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":`+literal+`}`)\n182|\t\t\t\t_, err = DecodeProbe(mutated)\n183|\t\t\t\treturn err\n184|\t\t\t},\n185|\t\t},\n186|\t}\n187|\tif len(rows) != 17 {\n188|\t\tt.Fatalf(\"string bound rows = %d, want 17; the table is short, not the package\", len(rows))\n189|\t}\n190|\tfor _, row := range rows {\n191|\t\trow := row\n192|\t\tt.Run(row.name, func(t *testing.T) {\n193|\t\t\t// One below the minimum refuses (the empty string\n194|\t\t\t// when min is 1); the minimum itself admits.\n195|\t\t\tif row.min > 0 {\n196|\t\t\t\tif err := row.drive(t, quotedRepeat(row.min-1)); err == nil {\n197|\t\t\t\t\tt.Fatalf(\"%s admitted length %d below the %d minimum\", row.name, row.min-1, row.min)\n198|\t\t\t\t} else {\n199|\t\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, row.text)\n200|\t\t\t\t}\n201|\t\t\t}\n202|\t\t\tif err := row.drive(t, quotedRepeat(row.min)); err != nil {\n203|\t\t\t\tt.Fatalf(\"%s refused length %d at the minimum: %v\", row.name, row.min, err)\n204|\t\t\t}\n205|\t\t\t// The maximum admits; one past it refuses.\n206|\t\t\tif err := row.drive(t, quotedRepeat(row.max)); err != nil {\n207|\t\t\t\tt.Fatalf(\"%s refused length %d at the maximum: %v\", row.name, row.max, err)\n208|\t\t\t}\n209|\t\t\tif err := row.drive(t, quotedRepeat(row.max+1)); err == nil {\n210|\t\t\t\tt.Fatalf(\"%s admitted length %d past the %d maximum\", row.name, row.max+1, row.max)\n211|\t\t\t} else {\n212|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", row.member, row.text)\n213|\t\t\t}\n214|\t\t})\n215|\t}\n216|}\n217|\n218|// checkResumeArgv drives one argv array through the resume-plan\n219|// success gate with the explicit identity occurring exactly once.\n220|func checkResumeArgv(t *testing.T, argv string) error {\n221|\tt.Helper()\n222|\tmanifestDigest := fixtureManifestDigestText(t)\n223|\trequest := fixtureRequestBody(t, OpResumePlan, manifestDigest)\n224|\tdecoded, err := CheckRequestBody(OpResumePlan, request)\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n227|\t}\n228|\tfacts := SuccessFacts{Context: decoded, ResumeTargetID: \"target-1\"}\n229|\tbase := fixtureSuccessBody(t, OpResumePlan, requestContextOf(t, request), manifestDigest)\n230|\treturn CheckSuccessBody(OpResumePlan, mutateMember(t, base, \"argv\", argv), facts)\n231|}\n232|\n233|// mutateNested replaces one member inside one nested object member\n234|// of a fixture body.\n235|func mutateNested(t *testing.T, body []byte, outer, inner, replacement string) []byte {\n236|\tt.Helper()\n237|\tvar members map[string]json.RawMessage\n238|\tif err := json.Unmarshal(body, &members); err != nil {\n239|\t\tt.Fatalf(\"mutateNested: fixture is not JSON: %v\", err)\n240|\t}\n241|\traw, present := members[outer]\n242|\tif !present {\n243|\t\tt.Fatalf(\"mutateNested: %q not in fixture\", outer)\n244|\t}\n245|\tvar nested map[string]json.RawMessage\n246|\tif err := json.Unmarshal(raw, &nested); err != nil {\n247|\t\tt.Fatalf(\"mutateNested: %q is not an object: %v\", outer, err)\n248|\t}\n249|\tif _, present := nested[inner]; !present {\n250|\t\tt.Fatalf(\"mutateNested: %q not in %q\", inner, outer)\n251|\t}\n252|\tnested[inner] = json.RawMessage(replacement)\n253|\trebuilt, err := json.Marshal(nested)\n254|\tif err != nil {\n255|\t\tt.Fatalf(\"mutateNested: %v\", err)\n256|\t}\n257|\tmembers[outer] = rebuilt\n258|\tout, err := json.Marshal(members)\n259|\tif err != nil {\n260|\t\tt.Fatalf(\"mutateNested: %v\", err)\n261|\t}\n262|\treturn out\n263|}\n264|\n265|// fidelityRow builds one fidelity-limit row with the given raw\n266|// code, class, and detail literals.\n267|func fidelityRow(code, class, detail string) string {\n268|\treturn `{\"code\":` + code + `,\"affected_class\":` + class + `,\"maximum_disposition\":\"exact\",\"detail\":` + detail + `}`\n269|}\n270|\n271|// withFidelityLimits returns the target-write entry fixture with\n272|// the limit array replaced.\n273|func withFidelityLimits(t *testing.T, limits string, direction Direction) []byte {\n274|\tt.Helper()\n275|\treturn mutateMember(t, []byte(fixtureEntryJSON(direction)), \"known_fidelity_limits\", limits)\n276|}\n277|\n278|// contractRow builds one contract row with the given raw\n279|// identifier literal and raw version literals.\n280|func contractRow(identifier string, versions []string) string {\n281|\treturn `{\"contract_id\":` + identifier + `,\"versions\":[` + strings.Join(versions, \",\") + `]}`\n282|}\n283|\n284|// withContracts returns the target-write entry fixture with the\n285|// contract array replaced.\n286|func withContracts(t *testing.T, contracts string) []byte {\n287|\tt.Helper()\n288|\treturn mutateMember(t, []byte(fixtureEntryJSON(DirectionTargetWrite)), \"contracts\", contracts)\n289|}\n290|\n291|// revokedWithReason returns the target-write entry fixture revoked\n292|// with the given raw reason literal.\n293|func revokedWithReason(t *testing.T, reason string) []byte {\n294|\tt.Helper()\n295|\tfixture := []byte(fixtureEntryJSON(DirectionTargetWrite))\n296|\trevoked := mutateMember(t, fixture, \"status\", `\"revoked\"`)\n297|\trevoked = mutateMember(t, revoked, \"revocation_reason\", reason)\n298|\treturn mutateMember(t, revoked, \"revoked_at\", `\"2026-06-02T00:00:00.000Z\"`)\n299|}\n300|\n301|// TestArrayBoundEdges drives every survivor array cap at its edge\n302|// through its production entry: empty, one, max, and max+1.\n303|func TestArrayBoundEdges(t *testing.T) {\n304|\tt.Run(\"resume argv 1..128\", func(t *testing.T) {\n305|\t\targv := func(n int) string {\n306|\t\t\tif n == 0 {\n307|\t\t\t\treturn `[]`\n308|\t\t\t}\n309|\t\t\treturn `[\"target-1\"` + strings.Repeat(`,\"w\"`, n-1) + `]`\n310|\t\t}\n311|\t\tif err := checkResumeArgv(t, argv(0)); err == nil {\n312|\t\t\tt.Fatal(\"admitted an empty argv\")\n313|\t\t} else {\n314|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"1..128 entries\")\n315|\t\t}\n316|\t\tif err := checkResumeArgv(t, argv(1)); err != nil {\n317|\t\t\tt.Fatalf(\"refused a one-word argv: %v\", err)\n318|\t\t}\n319|\t\tif err := checkResumeArgv(t, argv(128)); err != nil {\n320|\t\t\tt.Fatalf(\"refused a 128-word argv at the maximum: %v\", err)\n321|\t\t}\n322|\t\tif err := checkResumeArgv(t, argv(129)); err == nil {\n323|\t\t\tt.Fatal(\"admitted a 129-word argv past the 128 maximum\")\n324|\t\t} else {\n325|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"1..128 entries\")\n326|\t\t}\n327|\t})\n328|\tt.Run(\"required dispositions 1..7\", func(t *testing.T) {\n329|\t\tmanifestDigest := fixtureManifestDigestText(t)\n330|\t\tdrive := func(t *testing.T, value string) error {\n331|\t\t\trequest := fixtureRequestBody(t, OpProjectionPlan, manifestDigest)\n332|\t\t\t_, err := CheckRequestBody(OpProjectionPlan, mutateMember(t, request, \"required_dispositions\", value))\n333|\t\t\treturn err\n334|\t\t}\n335|\t\tseven := `{\"user_message\":[\"exact\",\"omitted\",\"opaque_preserved\",\"semantic\",\"summarized\",\"synthesized\",\"unrecoverable\"]}`\n336|\t\teight := `{\"user_message\":[\"exact\",\"omitted\",\"opaque_preserved\",\"semantic\",\"summarized\",\"synthesized\",\"unrecoverable\",\"exact\"]}`\n337|\t\tif err := drive(t, `{\"user_message\":[]}`); err == nil {\n338|\t\t\tt.Fatal(\"admitted an empty disposition list\")\n339|\t\t} else {\n340|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"1..7 entries\")\n341|\t\t}\n342|\t\tif err := drive(t, `{\"user_message\":[\"exact\"]}`); err != nil {\n343|\t\t\tt.Fatalf(\"refused a one-entry disposition list: %v\", err)\n344|\t\t}\n345|\t\tif err := drive(t, seven); err != nil {\n346|\t\t\tt.Fatalf(\"refused a seven-entry disposition list at the maximum: %v\", err)\n347|\t\t}\n348|\t\t// The count gate fires before the element gates, so the\n349|\t\t// eighth entry refuses on the count even though it also\n350|\t\t// repeats a member.\n351|\t\tif err := drive(t, eight); err == nil {\n352|\t\t\tt.Fatal(\"admitted an eight-entry disposition list past the 7 maximum\")\n353|\t\t} else {\n354|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"1..7 entries\")\n355|\t\t}\n356|\t})\n357|\tt.Run(\"contracts 1..64\", func(t *testing.T) {\n358|\t\tcontracts := func(n int) string {\n359|\t\t\trows := make([]string, 0, n)\n360|\t\t\tfor i := 1; i <= n; i++ {\n361|\t\t\t\trows = append(rows, contractRow(strconv.Quote(\"c\"+twoDigits(i)), []string{`\"1.0.0\"`}))\n362|\t\t\t}\n363|\t\t\treturn `[` + strings.Join(rows, \",\") + `]`\n364|\t\t}\n365|\t\tif _, err := DecodeTupleEntry(withContracts(t, `[]`)); err == nil {\n366|\t\t\tt.Fatal(\"admitted zero contract rows\")\n367|\t\t} else {\n368|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"contracts\", \"1..64 rows\")\n369|\t\t}\n370|\t\tif _, err := DecodeTupleEntry(withContracts(t, contracts(1))); err != nil {\n371|\t\t\tt.Fatalf(\"refused one contract row: %v\", err)\n372|\t\t}\n373|\t\tif _, err := DecodeTupleEntry(withContracts(t, contracts(64))); err != nil {\n374|\t\t\tt.Fatalf(\"refused 64 contract rows at the maximum: %v\", err)\n375|\t\t}\n376|\t\tif _, err := DecodeTupleEntry(withContracts(t, contracts(65))); err == nil {\n377|\t\t\tt.Fatal(\"admitted 65 contract rows past the 64 maximum\")\n378|\t\t} else {\n379|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"contracts\", \"1..64 rows\")\n380|\t\t}\n381|\t})\n382|\tt.Run(\"versions 1..32\", func(t *testing.T) {\n383|\t\tversions := func(n int) string {\n384|\t\t\tnames := make([]string, 0, n)\n385|\t\t\tfor i := 1; i <= n; i++ {\n386|\t\t\t\t// Zero-padded prerelease tags sort\n387|\t\t\t\t// lexicographically, so the sorted-unique\n388|\t\t\t\t// gate stays green while the count sweeps.\n389|\t\t\t\tnames = append(names, strconv.Quote(\"1.0.0-a\"+twoDigits(i)))\n390|\t\t\t}\n391|\t\t\treturn contractRow(`\"urn:ax:protocol:session-adapter\"`, names)\n392|\t\t}\n393|\t\tdrive := func(t *testing.T, row string) error {\n394|\t\t\t_, err := DecodeTupleEntry(withContracts(t, `[`+row+`]`))\n395|\t\t\treturn err\n396|\t\t}\n397|\t\tif err := drive(t, `{\"contract_id\":\"urn:ax:protocol:session-adapter\",\"versions\":[]}`); err == nil {\n398|\t\t\tt.Fatal(\"admitted zero versions\")\n399|\t\t} else {\n400|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"versions\", \"1..32 entries\")\n401|\t\t}\n402|\t\tif err := drive(t, versions(1)); err != nil {\n403|\t\t\tt.Fatalf(\"refused one version: %v\", err)\n404|\t\t}\n405|\t\tif err := drive(t, versions(32)); err != nil {\n406|\t\t\tt.Fatalf(\"refused 32 versions at the maximum: %v\", err)\n407|\t\t}\n408|\t\tif err := drive(t, versions(33)); err == nil {\n409|\t\t\tt.Fatal(\"admitted 33 versions past the 32 maximum\")\n410|\t\t} else {\n411|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"versions\", \"1..32 entries\")\n412|\t\t}\n413|\t})\n414|}\n415|\n416|// twoDigits renders i zero-padded to two digits for\n417|// lexicographically sortable fixture names.\n418|func twoDigits(i int) string {\n419|\tif i < 10 {\n420|\t\treturn \"0\" + strconv.Itoa(i)\n421|\t}\n422|\treturn strconv.Itoa(i)\n423|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
