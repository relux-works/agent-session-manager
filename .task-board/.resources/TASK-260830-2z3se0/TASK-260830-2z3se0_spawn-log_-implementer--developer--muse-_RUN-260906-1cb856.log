{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a7","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":174,"recorded_at":1780531400000343,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a5421174b39506351c9ac67c44","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/protocol.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Wire constants of pinned specification Section 7.8. The protocol\n12|// identifier and version are exact: the adapter speaks 1.0.0 in the\n13|// same trusted executable as Provider Protocol 2.0.0, and anything\n14|// else on the wire is a session_adapter_protocol_error, never a\n15|// negotiation.\n16|const (\n17|\t// ProtocolID is the exact protocol member every request and\n18|\t// response envelope carries.\n19|\tProtocolID = \"urn:ax:protocol:session-adapter\"\n20|\t// ProtocolVersion is the exact protocol_version member this host\n21|\t// writes and the only one it accepts a response under.\n22|\tProtocolVersion = \"1.0.0\"\n23|\t// ProtocolMajor is the major this host implements. Section 7.8\n24|\t// defines no multi-major negotiation for the adapter, so a\n25|\t// different major is an invalid envelope, not a downgrade.\n26|\tProtocolMajor = 1\n27|\t// ErrorVersion is the Structured Error version every failure\n28|\t// envelope carries: Session Adapter 1.0 statically binds\n29|\t// Structured Error 1.1.0.\n30|\tErrorVersion = axerror.Version110\n31|\t// MaxFrameBytes bounds one JSONL line in either direction:\n32|\t// Section 7.8 inherits Section 7.2's rule that every line is one\n33|\t// complete UTF-8 JSON object no larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|)\n36|\n37|// Operation names one Section 7.8 registry entry. The registry is\n38|// closed: dispatch refuses any other name locally, before any adapter\n39|// surface is touched.\n40|type Operation string\n41|\n42|// Section 7.8 operation registry in the section's table order. The\n43|// inventory test derives this list from the pinned specification\n44|// text and requires exact ordered equality, so a dropped, added, or\n45|// reordered entry reddens there rather than passing silently.\n46|const (\n47|\tOpManifest       Operation = \"manifest\"\n48|\tOpProbe          Operation = \"probe\"\n49|\tOpDiscover       Operation = \"discover\"\n50|\tOpInspect        Operation = \"inspect\"\n51|\tOpSnapshotProof  Operation = \"snapshot-proof\"\n52|\tOpCapturePlan    Operation = \"capture-plan\"\n53|\tOpCapture        Operation = \"capture\"\n54|\tOpNormalize      Operation = \"normalize\"\n55|\tOpProjectionPlan Operation = \"projection-plan\"\n56|\tOpProject        Operation = \"project\"\n57|\tOpReadBack       Operation = \"read-back\"\n58|\tOpValidate       Operation = \"validate\"\n59|\tOpResumePlan     Operation = \"resume-plan\"\n60|\tOpDoctor         Operation = \"doctor\"\n61|)\n62|\n63|// operationOrder is the single construction site of the dispatch\n64|// registry.\n65|var operationOrder = []Operation{\n66|\tOpManifest,\n67|\tOpProbe,\n68|\tOpDiscover,\n69|\tOpInspect,\n70|\tOpSnapshotProof,\n71|\tOpCapturePlan,\n72|\tOpCapture,\n73|\tOpNormalize,\n74|\tOpProjectionPlan,\n75|\tOpProject,\n76|\tOpReadBack,\n77|\tOpValidate,\n78|\tOpResumePlan,\n79|\tOpDoctor,\n80|}\n81|\n82|// Operations returns the dispatch registry in section order. The\n83|// result is a copy; the registry cannot be mutated through it.\n84|func Operations() []string {\n85|\tout := make([]string, 0, len(operationOrder))\n86|\tfor _, operation := range operationOrder {\n87|\t\tout = append(out, string(operation))\n88|\t}\n89|\treturn out\n90|}\n91|\n92|// validOperation reports whether the name is a registry member.\n93|func validOperation(name string) bool {\n94|\tfor _, operation := range operationOrder {\n95|\t\tif string(operation) == name {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// The refusal constructors below are declared as variables so the\n103|// inventory gate can observe every exercised refusal site. Each is\n104|// the single construction site for its failure class; production\n105|// code must not build *axerror.Error any other way.\n106|//\n107|// failInvalid reports a caller error caught before any adapter\n108|// surface is touched: a required set naming an unknown capability, a\n109|// binding the caller built from unobserved facts. failProtocol\n110|// reports an unusable adapter frame: an invalid envelope, a body\n111|// outside its closed shape, a digest mismatch, a partial,\n112|// malformed, over-limit, or escaped result. failUnknownOperation\n113|// reports a name outside the closed registry. failCapability\n114|// reports an operation the adapter does not implement.\n115|// failUnsupportedTuple reports an environment the signed registry\n116|// does not admit. failIntegrity reports a binding observation that\n117|// cannot be reconciled to trusted candidate facts: a failed or\n118|// partial read, or a before-call fact that no longer equals the\n119|// freshly read fact and the Journal binding.\n120|//\n121|// Every constructor takes the human detail first as a string literal\n122|// at the call site and the distinguishing wire fact second, so the\n123|// inventory derives one obligation per literal detail and every\n124|// witness can assert which arm fired through the code plus the\n125|// distinguishing detail, not merely that something refused.\n126|var failInvalid = func(detail string, field string) (*axerror.Error, error) {\n127|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"invalid_config\", Message: \"session adapter host refused the call: \" + detail, Details: axerror.Details{\"field\": field}})\n128|}\n129|\n130|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n131|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"session_adapter_protocol_error\", Message: \"session adapter host rejected the adapter frame: \" + detail, Details: axerror.Details{\"member\": member}})\n132|}\n133|\n134|var failUnknownOperation = func(detail string, operation string) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"operation_unknown\", Message: \"session adapter host refused an unknown operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n136|}\n137|\n138|var failCapability = func(detail string, capability string) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unavailable operation: \" + detail, Details: axerror.Details{\"capability\": capability}})\n140|}\n141|\n142|// failUnavailable reports an operation the adapter does not\n143|// implement. The operation-to-capability mapping is not stated in\n144|// Section 7.8, so the refusal names the operation rather than\n145|// inventing a capability: the detail key is operation, never a\n146|// capability the contract never defined.\n147|var failUnavailable = func(detail string, operation string) (*axerror.Error, error) {\n148|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unimplemented operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n149|}\n150|\n151|var failUnsupportedTuple = func(detail string, environment string) (*axerror.Error, error) {\n152|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"unsupported_environment_tuple\", Message: \"session adapter host refused an unadmitted environment: \" + detail, Details: axerror.Details{\"environment\": environment}})\n153|}\n154|\n155|var failIntegrity = func(detail string, subject string) (*axerror.Error, error) {\n156|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"integrity_failure\", Message: \"session adapter binding observation is not trusted state: \" + detail, Details: axerror.Details{\"subject\": subject}})\n157|}\n158|\n159|// requestMembers is the exact request envelope member set Section 7.8\n160|// requires: protocol, protocol_version, request_id, operation,\n161|// deadline, and body.\n162|var requestMembers = map[string]bool{\n163|\t\"protocol\":         true,\n164|\t\"protocol_version\": true,\n165|\t\"request_id\":       true,\n166|\t\"operation\":        true,\n167|\t\"deadline\":         true,\n168|\t\"body\":             true,\n169|}\n170|\n171|// requestRequired lists requestMembers in a fixed order so an\n172|// envelope missing several members always names the same one.\n173|var requestRequired = []string{\n174|\t\"protocol\",\n175|\t\"protocol_version\",\n176|\t\"request_id\",\n177|\t\"operation\",\n178|\t\"deadline\",\n179|\t\"body\",\n180|}\n181|\n182|// successMembers is the exact success envelope member set: the four\n183|// echoed identity fields, ok=true, and body, with no error member.\n184|var successMembers = map[string]bool{\n185|\t\"protocol\":         true,\n186|\t\"protocol_version\": true,\n187|\t\"request_id\":       true,\n188|\t\"operation\":        true,\n189|\t\"ok\":               true,\n190|\t\"body\":             true,\n191|}\n192|\n193|// successRequired lists successMembers in a fixed order.\n194|var successRequired = []string{\n195|\t\"protocol\",\n196|\t\"protocol_version\",\n197|\t\"request_id\",\n198|\t\"operation\",\n199|\t\"ok\",\n200|\t\"body\",\n201|}\n202|\n203|// failureMembers is the exact failure envelope member set: the four\n204|// echoed identity fields, ok=false, and error, with no body member.\n205|var failureMembers = map[string]bool{\n206|\t\"protocol\":         true,\n207|\t\"protocol_version\": true,\n208|\t\"request_id\":       true,\n209|\t\"operation\":        true,\n210|\t\"ok\":               true,\n211|\t\"error\":            true,\n212|}\n213|\n214|// failureRequired lists failureMembers in a fixed order.\n215|var failureRequired = []string{\n216|\t\"protocol\",\n217|\t\"protocol_version\",\n218|\t\"request_id\",\n219|\t\"operation\",\n220|\t\"ok\",\n221|\t\"error\",\n222|}\n223|\n224|// Request is one Section 7.8 request envelope as the host wrote it:\n225|// the identity fields plus the canonical body bytes. Responses are\n226|// checked against it, never trusted on their own echo.\n227|type Request struct {\n228|\tOperation Operation\n229|\tRequestID string\n230|\tBody      []byte\n231|}\n232|\n233|// DecodeRequestFrame validates one outbound request frame before it\n234|// reaches the adapter surface: one complete object within the frame\n235|// bound, the exact envelope members, the exact protocol identifier\n236|// and version, a UUIDv7 request identifier, a registry operation, a\n237|// timestamp deadline, and an object body. An unknown operation is\n238|// operation_unknown; every other envelope defect is\n239|// session_adapter_protocol_error. The returned body is the raw\n240|// canonical member for the operation-layer checks.\n241|func DecodeRequestFrame(frame []byte) (Request, error) {\n242|\tif len(frame) == 0 {\n243|\t\tfailure, err := failProtocol(\"request frame is empty\", \"\")\n244|\t\tif err != nil {\n245|\t\t\treturn Request{}, err\n246|\t\t}\n247|\t\treturn Request{}, failure\n248|\t}\n249|\tif len(frame) > MaxFrameBytes {\n250|\t\tfailure, err := failProtocol(\"request frame exceeds the 8 MiB bound\", \"\")\n251|\t\tif err != nil {\n252|\t\t\treturn Request{}, err\n253|\t\t}\n254|\t\treturn Request{}, failure\n255|\t}\n256|\tmembers, fault := decodeStrictObject(frame)\n257|\tif fault != nil {\n258|\t\tfailure, err := failProtocol(\"request envelope \"+fault.detail, fault.member)\n259|\t\tif err != nil {\n260|\t\t\treturn Request{}, err\n261|\t\t}\n262|\t\treturn Request{}, failure\n263|\t}\n264|\tif name, unknown := unknownMember(members, requestMembers); unknown {\n265|\t\tfailure, err := failProtocol(\"request envelope carries unknown member\", name)\n266|\t\tif err != nil {\n267|\t\t\treturn Request{}, err\n268|\t\t}\n269|\t\treturn Request{}, failure\n270|\t}\n271|\tif name, missing := missingMember(members, requestRequired); missing {\n272|\t\tfailure, err := failProtocol(\"request envelope misses a required member\", name)\n273|\t\tif err != nil {\n274|\t\t\treturn Request{}, err\n275|\t\t}\n276|\t\treturn Request{}, failure\n277|\t}\n278|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n279|\t\tfailure, err := failProtocol(\"request protocol is not the session adapter\", \"protocol\")\n280|\t\tif err != nil {\n281|\t\t\treturn Request{}, err\n282|\t\t}\n283|\t\treturn Request{}, failure\n284|\t}\n285|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n286|\t\tfailure, err := failProtocol(\"request protocol version is not 1.0.0\", \"protocol_version\")\n287|\t\tif err != nil {\n288|\t\t\treturn Request{}, err\n289|\t\t}\n290|\t\treturn Request{}, failure\n291|\t}\n292|\trequestID, ok := rawString(members[\"request_id\"])\n293|\tif !ok {\n294|\t\tfailure, err := failProtocol(\"request identifier is not a string\", \"request_id\")\n295|\t\tif err != nil {\n296|\t\t\treturn Request{}, err\n297|\t\t}\n298|\t\treturn Request{}, failure\n299|\t}\n300|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n301|\t\tfailure, err := failProtocol(\"request identifier is not a UUIDv7\", \"request_id\")\n302|\t\tif err != nil {\n303|\t\t\treturn Request{}, err\n304|\t\t}\n305|\t\treturn Request{}, failure\n306|\t}\n307|\toperation, ok := rawString(members[\"operation\"])\n308|\tif !ok {\n309|\t\tfailure, err := failProtocol(\"request operation is not a string\", \"operation\")\n310|\t\tif err != nil {\n311|\t\t\treturn Request{}, err\n312|\t\t}\n313|\t\treturn Request{}, failure\n314|\t}\n315|\tif !validOperation(operation) {\n316|\t\tfailure, err := failUnknownOperation(\"request names an operation outside the closed registry\", operation)\n317|\t\tif err != nil {\n318|\t\t\treturn Request{}, err\n319|\t\t}\n320|\t\treturn Request{}, failure\n321|\t}\n322|\tif _, ok := checkTimestamp(members[\"deadline\"]); !ok {\n323|\t\tfailure, err := failProtocol(\"request deadline is not a timestamp\", \"deadline\")\n324|\t\tif err != nil {\n325|\t\t\treturn Request{}, err\n326|\t\t}\n327|\t\treturn Request{}, failure\n328|\t}\n329|\tbody := bytesTrimSpace(members[\"body\"])\n330|\tif _, fault := decodeStrictObject(body); fault != nil {\n331|\t\tfailure, err := failProtocol(\"request body \"+fault.detail, \"body\")\n332|\t\tif err != nil {\n333|\t\t\treturn Request{}, err\n334|\t\t}\n335|\t\treturn Request{}, failure\n336|\t}\n337|\treturn Request{Operation: Operation(operation), RequestID: requestID, Body: body}, nil\n338|}\n339|\n340|// CheckSuccessEnvelope validates one inbound success frame against\n341|// the request that caused it: one complete object within the frame\n342|// bound, the exact success members, the four identity fields echoed\n343|// exactly, ok=true, an object body, and no error member. Body and\n344|// error are disjoint, never nullable sentinels: a frame carrying\n345|// both or neither is a protocol error. The returned body is the raw\n346|// member for the operation-layer checks.\n347|func CheckSuccessEnvelope(frame []byte, want Request) ([]byte, error) {\n348|\tif len(frame) == 0 {\n349|\t\tfailure, err := failProtocol(\"success frame is empty\", \"\")\n350|\t\tif err != nil {\n351|\t\t\treturn nil, err\n352|\t\t}\n353|\t\treturn nil, failure\n354|\t}\n355|\tif len(frame) > MaxFrameBytes {\n356|\t\tfailure, err := failProtocol(\"success frame exceeds the 8 MiB bound\", \"\")\n357|\t\tif err != nil {\n358|\t\t\treturn nil, err\n359|\t\t}\n360|\t\treturn nil, failure\n361|\t}\n362|\tmembers, fault := decodeStrictObject(frame)\n363|\tif fault != nil {\n364|\t\tfailure, err := failProtocol(\"success envelope \"+fault.detail, fault.member)\n365|\t\tif err != nil {\n366|\t\t\treturn nil, err\n367|\t\t}\n368|\t\treturn nil, failure\n369|\t}\n370|\tif name, unknown := unknownMember(members, successMembers); unknown {\n371|\t\tfailure, err := failProtocol(\"success envelope carries unknown member\", name)\n372|\t\tif err != nil {\n373|\t\t\treturn nil, err\n374|\t\t}\n375|\t\treturn nil, failure\n376|\t}\n377|\tif name, missing := missingMember(members, successRequired); missing {\n378|\t\tfailure, err := failProtocol(\"success envelope misses a required member\", name)\n379|\t\tif err != nil {\n380|\t\t\treturn nil, err\n381|\t\t}\n382|\t\treturn nil, failure\n383|\t}\n384|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n385|\t\tfailure, err := failProtocol(\"success protocol does not echo the request\", \"protocol\")\n386|\t\tif err != nil {\n387|\t\t\treturn nil, err\n388|\t\t}\n389|\t\treturn nil, failure\n390|\t}\n391|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n392|\t\tfailure, err := failProtocol(\"success protocol version does not echo the request\", \"protocol_version\")\n393|\t\tif err != nil {\n394|\t\t\treturn nil, err\n395|\t\t}\n396|\t\treturn nil, failure\n397|\t}\n398|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n399|\t\tfailure, err := failProtocol(\"success request identifier does not echo the request\", \"request_id\")\n400|\t\tif err != nil {\n401|\t\t\treturn nil, err\n402|\t\t}\n403|\t\treturn nil, failure\n404|\t}\n405|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n406|\t\tfailure, err := failProtocol(\"success operation does not echo the request\", \"operation\")\n407|\t\tif err != nil {\n408|\t\t\treturn nil, err\n409|\t\t}\n410|\t\treturn nil, failure\n411|\t}\n412|\tpositive, ok := rawBool(members[\"ok\"])\n413|\tif !ok || !positive {\n414|\t\tfailure, err := failProtocol(\"success envelope does not carry ok=true\", \"ok\")\n415|\t\tif err != nil {\n416|\t\t\treturn nil, err\n417|\t\t}\n418|\t\treturn nil, failure\n419|\t}\n420|\tbody := bytesTrimSpace(members[\"body\"])\n421|\tif _, fault := decodeStrictObject(body); fault != nil {\n422|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, \"body\")\n423|\t\tif err != nil {\n424|\t\t\treturn nil, err\n425|\t\t}\n426|\t\treturn nil, failure\n427|\t}\n428|\treturn body, nil\n429|}\n430|\n431|// CheckFailureEnvelope validates one inbound failure frame against\n432|// the request that caused it: the exact failure members, the four\n433|// identity fields echoed exactly, ok=false, a closed error object,\n434|// and no body member. The error object itself must decode as a\n435|// Structured Error under the adapter's bound version; a failure that\n436|// cannot be read is an integrity failure, never a retryable result.\n437|func CheckFailureEnvelope(frame []byte, want Request) (*axerror.Error, error) {\n438|\tif len(frame) == 0 {\n439|\t\tfailure, err := failProtocol(\"failure frame is empty\", \"\")\n440|\t\tif err != nil {\n441|\t\t\treturn nil, err\n442|\t\t}\n443|\t\treturn nil, failure\n444|\t}\n445|\tif len(frame) > MaxFrameBytes {\n446|\t\tfailure, err := failProtocol(\"failure frame exceeds the 8 MiB bound\", \"\")\n447|\t\tif err != nil {\n448|\t\t\treturn nil, err\n449|\t\t}\n450|\t\treturn nil, failure\n451|\t}\n452|\tmembers, fault := decodeStrictObject(frame)\n453|\tif fault != nil {\n454|\t\tfailure, err := failProtocol(\"failure envelope \"+fault.detail, fault.member)\n455|\t\tif err != nil {\n456|\t\t\treturn nil, err\n457|\t\t}\n458|\t\treturn nil, failure\n459|\t}\n460|\tif name, unknown := unknownMember(members, failureMembers); unknown {\n461|\t\tfailure, err := failProtocol(\"failure envelope carries unknown member\", name)\n462|\t\tif err != nil {\n463|\t\t\treturn nil, err\n464|\t\t}\n465|\t\treturn nil, failure\n466|\t}\n467|\tif name, missing := missingMember(members, failureRequired); missing {\n468|\t\tfailure, err := failProtocol(\"failure envelope misses a required member\", name)\n469|\t\tif err != nil {\n470|\t\t\treturn nil, err\n471|\t\t}\n472|\t\treturn nil, failure\n473|\t}\n474|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n475|\t\tfailure, err := failProtocol(\"failure protocol does not echo the request\", \"protocol\")\n476|\t\tif err != nil {\n477|\t\t\treturn nil, err\n478|\t\t}\n479|\t\treturn nil, failure\n480|\t}\n481|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n482|\t\tfailure, err := failProtocol(\"failure protocol version does not echo the request\", \"protocol_version\")\n483|\t\tif err != nil {\n484|\t\t\treturn nil, err\n485|\t\t}\n486|\t\treturn nil, failure\n487|\t}\n488|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n489|\t\tfailure, err := failProtocol(\"failure request identifier does not echo the request\", \"request_id\")\n490|\t\tif err != nil {\n491|\t\t\treturn nil, err\n492|\t\t}\n493|\t\treturn nil, failure\n494|\t}\n495|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n496|\t\tfailure, err := failProtocol(\"failure operation does not echo the request\", \"operation\")\n497|\t\tif err != nil {\n498|\t\t\treturn nil, err\n499|\t\t}\n500|\t\treturn nil, failure\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a9","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":175,"recorded_at":1780531400000345,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a542d97a1098c7b73b35cd2334","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.8 closed\n15|// body. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing\n18|// every arm. A helper that fronted a constructor would collapse\n19|// distinct rules into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer:\n22|// Section 7.8 counts and limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// frameFault is one strict-decode failure: what was wrong and which\n26|// member it was found in, if any. It never carries foreign bytes.\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|// decodeStrictObject parses one complete JSON object with duplicate\n33|// member rejection. It is the only JSON entry point in this package:\n34|// every body crosses it before any member is read. A non-UTF-8\n35|// frame, a lone surrogate escape, a non-object top level, a\n36|// duplicated member, or trailing data is a fault, never a partial\n37|// object the caller could mistake for a result.\n38|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n39|\tif !utf8.Valid(data) {\n40|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n41|\t}\n42|\tif hasLoneSurrogateEscape(data) {\n43|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n44|\t}\n45|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n46|\ttoken, err := decoder.Token()\n47|\tif err != nil {\n48|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n49|\t}\n50|\tdelim, ok := token.(json.Delim)\n51|\tif !ok || delim != '{' {\n52|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n53|\t}\n54|\tmembers := map[string]json.RawMessage{}\n55|\tfor decoder.More() {\n56|\t\tkeyToken, err := decoder.Token()\n57|\t\tif err != nil {\n58|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n59|\t\t}\n60|\t\tkey, ok := keyToken.(string)\n61|\t\tif !ok {\n62|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n63|\t\t}\n64|\t\tif _, duplicate := members[key]; duplicate {\n65|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n66|\t\t}\n67|\t\tvar raw json.RawMessage\n68|\t\tif err := decoder.Decode(&raw); err != nil {\n69|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n70|\t\t}\n71|\t\tmembers[key] = raw\n72|\t}\n73|\tif token, err := decoder.Token(); err != nil {\n74|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n75|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n76|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n77|\t}\n78|\tif _, err := decoder.Token(); err != io.EOF {\n79|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n80|\t}\n81|\treturn members, nil\n82|}\n83|\n84|// hasLoneSurrogateEscape reports whether the raw frame carries a\n85|// UTF-16 escape the JSON string grammar cannot pair: a high\n86|// surrogate not followed by a low surrogate, a low surrogate with no\n87|// high surrogate before it, or a truncated escape. Go's encoding/json\n88|// would otherwise replace the lone escape with U+FFFD silently, so\n89|// Section 1.6 wire bodies carrying lone surrogates would be admitted\n90|// with rewritten bytes. This is a local copy of the shared surrogate\n91|// rule because the shared implementation is unexported; the agreement\n92|// test pins it against canonicaljson.Canonicalize over a generated\n93|// escape corpus whose verdicts come from construction, not from\n94|// either implementation.\n95|func hasLoneSurrogateEscape(data []byte) bool {\n96|\tfor index := 0; index < len(data); index++ {\n97|\t\tif data[index] != '\\\\' {\n98|\t\t\tcontinue\n99|\t\t}\n100|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n101|\t\t\tcontinue\n102|\t\t}\n103|\t\tfirst, length := readUTF16Escape(data, index+2)\n104|\t\tif length < 0 {\n105|\t\t\treturn true\n106|\t\t}\n107|\t\tindex += 1 + length\n108|\t\tif first >= 0xD800 && first <= 0xDBFF {\n109|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n110|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n111|\t\t\t\treturn true\n112|\t\t\t}\n113|\t\t\tindex += 6\n114|\t\t\tcontinue\n115|\t\t}\n116|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n117|\t\t\treturn true\n118|\t\t}\n119|\t}\n120|\treturn false\n121|}\n122|\n123|// readUTF16Escape reads four hex digits at the offset. It returns the\n124|// value and the consumed length, or a negative length when the escape\n125|// is truncated or not hexadecimal.\n126|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n127|\tif offset+4 > len(data) {\n128|\t\treturn 0, -1\n129|\t}\n130|\tvar value uint16\n131|\tfor _, digit := range data[offset : offset+4] {\n132|\t\tvalue <<= 4\n133|\t\tswitch {\n134|\t\tcase digit >= '0' && digit <= '9':\n135|\t\t\tvalue |= uint16(digit - '0')\n136|\t\tcase digit >= 'a' && digit <= 'f':\n137|\t\t\tvalue |= uint16(digit-'a') + 10\n138|\t\tcase digit >= 'A' && digit <= 'F':\n139|\t\t\tvalue |= uint16(digit-'A') + 10\n140|\t\tdefault:\n141|\t\t\treturn 0, -1\n142|\t\t}\n143|\t}\n144|\treturn value, 4\n145|}\n146|\n147|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n148|// at the offset. Anything else — a truncated escape, a non-escape,\n149|// or input end — is a negative length.\n150|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n151|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n152|\t\treturn 0, -1\n153|\t}\n154|\treturn readUTF16Escape(data, offset+2)\n155|}\n156|\n157|// unknownMember names a member outside the closed set, if any. The\n158|// single-unknown fixtures keep the verdict deterministic: with\n159|// several unknowns the map order decides which is named, so tests\n160|// never assert a name from a multi-unknown body.\n161|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n162|\tfor name := range members {\n163|\t\tif !allowed[name] {\n164|\t\t\treturn name, true\n165|\t\t}\n166|\t}\n167|\treturn \"\", false\n168|}\n169|\n170|// missingMember names the first required member with no value, if\n171|// any. The required list is fixed order, so the verdict is\n172|// deterministic for every missing combination.\n173|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n174|\tfor _, name := range required {\n175|\t\tif _, present := members[name]; !present {\n176|\t\t\treturn name, true\n177|\t\t}\n178|\t}\n179|\treturn \"\", false\n180|}\n181|\n182|// rawString reads a JSON string member.\n183|func rawString(raw json.RawMessage) (string, bool) {\n184|\tvar value string\n185|\tif err := json.Unmarshal(raw, &value); err != nil {\n186|\t\treturn \"\", false\n187|\t}\n188|\treturn value, true\n189|}\n190|\n191|// rawBool reads a JSON boolean member.\n192|func rawBool(raw json.RawMessage) (bool, bool) {\n193|\tvar value bool\n194|\tif err := json.Unmarshal(raw, &value); err != nil {\n195|\t\treturn false, false\n196|\t}\n197|\treturn value, true\n198|}\n199|\n200|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n201|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n202|// even when it names the same mathematical value: the canonical\n203|// bodies carry counts, never measurements.\n204|func rawUint53(raw json.RawMessage) (uint64, bool) {\n205|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n206|\tdecoder.UseNumber()\n207|\tvar value any\n208|\tif err := decoder.Decode(&value); err != nil {\n209|\t\treturn 0, false\n210|\t}\n211|\tnumber, ok := value.(json.Number)\n212|\tif !ok {\n213|\t\treturn 0, false\n214|\t}\n215|\tliteral := number.String()\n216|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n217|\t\treturn 0, false\n218|\t}\n219|\treturn parseUint53Literal(literal)\n220|}\n221|\n222|// parseUint53Literal reads a digit-only literal without trusting a\n223|// float conversion: the magnitude bound is checked on the digit\n224|// string, so 2^53 is refused even on platforms that could hold it.\n225|func parseUint53Literal(literal string) (uint64, bool) {\n226|\tvar value uint64\n227|\tfor index := 0; index < len(literal); index++ {\n228|\t\tdigit := literal[index]\n229|\t\tif digit < '0' || digit > '9' {\n230|\t\t\treturn 0, false\n231|\t\t}\n232|\t\tvalue = value*10 + uint64(digit-'0')\n233|\t\tif value > maxUint53 {\n234|\t\t\treturn 0, false\n235|\t\t}\n236|\t}\n237|\treturn value, true\n238|}\n239|\n240|// stringLength is the Section 1.6 string measure in characters, not\n241|// bytes: a bound of string[1..128] admits 128 characters of any\n242|// width.\n243|func stringLength(value string) int {\n244|\treturn utf8.RuneCountInString(value)\n245|}\n246|\n247|// checkStringBounds reports whether the member is a JSON string whose\n248|// character count falls in the inclusive bound.\n249|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n250|\tvalue, ok := rawString(raw)\n251|\tif !ok {\n252|\t\treturn \"\", false\n253|\t}\n254|\tlength := stringLength(value)\n255|\tif length < minimum || length > maximum {\n256|\t\treturn \"\", false\n257|\t}\n258|\treturn value, true\n259|}\n260|\n261|// checkUint53Bounds reports whether the member is a uint53 in the\n262|// inclusive bound. Both edges are checked: a one-sided check would\n263|// admit the open side.\n264|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n265|\tvalue, ok := rawUint53(raw)\n266|\tif !ok {\n267|\t\treturn 0, false\n268|\t}\n269|\tif value < minimum || value > maximum {\n270|\t\treturn 0, false\n271|\t}\n272|\treturn value, true\n273|}\n274|\n275|// checkDigest reports whether the member is a digest of the pinned\n276|// sha256 form.\n277|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n278|\tvalue, ok := rawString(raw)\n279|\tif !ok {\n280|\t\treturn scalar.Digest{}, false\n281|\t}\n282|\tdigest, err := scalar.ParseDigest(value)\n283|\tif err != nil {\n284|\t\treturn scalar.Digest{}, false\n285|\t}\n286|\treturn digest, true\n287|}\n288|\n289|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n290|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n291|\tvalue, ok := rawString(raw)\n292|\tif !ok {\n293|\t\treturn scalar.UUIDv7{}, false\n294|\t}\n295|\tidentifier, err := scalar.ParseUUIDv7(value)\n296|\tif err != nil {\n297|\t\treturn scalar.UUIDv7{}, false\n298|\t}\n299|\treturn identifier, true\n300|}\n301|\n302|// checkTimestamp reports whether the member is a pinned timestamp.\n303|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Timestamp{}, false\n307|\t}\n308|\tinstant, err := scalar.ParseTimestamp(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Timestamp{}, false\n311|\t}\n312|\treturn instant, true\n313|}\n314|\n315|// isNull reports whether the member is an explicit JSON null.\n316|func isNull(raw json.RawMessage) bool {\n317|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n318|}\n319|\n320|// decodeArray reads a JSON array member into its raw elements. A\n321|// non-array — including null — is not an empty array.\n322|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n323|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n324|\ttoken, err := decoder.Token()\n325|\tif err != nil {\n326|\t\treturn nil, false\n327|\t}\n328|\tdelim, ok := token.(json.Delim)\n329|\tif !ok || delim != '[' {\n330|\t\treturn nil, false\n331|\t}\n332|\tvar elements []json.RawMessage\n333|\tfor decoder.More() {\n334|\t\tvar element json.RawMessage\n335|\t\tif err := decoder.Decode(&element); err != nil {\n336|\t\t\treturn nil, false\n337|\t\t}\n338|\t\telements = append(elements, element)\n339|\t}\n340|\tif token, err := decoder.Token(); err != nil {\n341|\t\treturn nil, false\n342|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n343|\t\treturn nil, false\n344|\t}\n345|\tif _, err := decoder.Token(); err != io.EOF {\n346|\t\treturn nil, false\n347|\t}\n348|\treturn elements, true\n349|}\n350|\n351|// checkSortedUniqueStrings reports whether the member is an array of\n352|// strings in the item bound whose JCS encodings order strictly\n353|// increasingly with no duplicates. Bytewise JCS order over strings\n354|// is plain lexicographic order, so the check compares directly; the\n355|// count bound is checked on both edges.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// semverPattern is the SemVer grammar adapter and environment\n411|// versions satisfy: three dot-separated non-negative integers with\n412|// no leading zeros, an optional pre-release, and optional build\n413|// metadata.\n414|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n415|\n416|// providerIDPattern is the Section 7.1 provider-id grammar the\n417|// manifest, context, and binding layers read:\n418|// [a-z][a-z0-9-]{0,31}.\n419|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n420|\n421|// environmentIDPattern is the Section 7.8 environment-id grammar:\n422|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n423|// adapter; dots separate the native hierarchy, never trust.\n424|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n425|\n426|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n427|// dot-separated lowercase labels, 3..253 characters.\n428|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n429|\n430|// checkExtensions reports whether the member is an object whose keys\n431|// are all reverse-DNS names. Values cross opaquely: extensions\n432|// cannot add operations, capabilities, or trust facts, and no member\n433|// of this package reads an extension value for any admission\n434|// decision.\n435|func checkExtensions(raw json.RawMessage) bool {\n436|\tmembers, fault := decodeStrictObject(raw)\n437|\tif fault != nil {\n438|\t\treturn false\n439|\t}\n440|\tfor name := range members {\n441|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n442|\t\t\treturn false\n443|\t\t}\n444|\t}\n445|\treturn true\n446|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ab","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":176,"recorded_at":1780531400000347,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a543a67f0393091cba4bf4b951","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/manifest.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// This file validates the Section 7.8 Session Adapter Manifest: the\n11|// closed urn:ax:schema:session-adapter-manifest 1.0.0 object a\n12|// manifest operation returns as its success body. The manifest\n13|// declares possible surfaces, not runtime availability; every member\n14|// below is required and the object is closed.\n15|\n16|// manifestSchema is the exact schema identifier the manifest carries.\n17|const manifestSchema = \"urn:ax:schema:session-adapter-manifest\"\n18|\n19|// manifestSchemaVersion is the only manifest version this host accepts.\n20|const manifestSchemaVersion = \"1.0.0\"\n21|\n22|// capabilityOrder is the exact fifteen-name ordered capability\n23|// registry Section 7.8 shows. The manifest and every probe body\n24|// carry exactly these names in this order; a sixteenth name\n25|// advertises a surface the contract never defined, and a missing\n26|// name hides one it did.\n27|var capabilityOrder = []string{\n28|\t\"native_discovery\",\n29|\t\"stable_snapshot\",\n30|\t\"raw_capture\",\n31|\t\"canonical_read\",\n32|\t\"canonical_write\",\n33|\t\"native_read_back\",\n34|\t\"native_resume_plan\",\n35|\t\"official_import\",\n36|\t\"same_environment_lossless_clone\",\n37|\t\"tool_history\",\n38|\t\"usage_history\",\n39|\t\"compaction_history\",\n40|\t\"subagent_graph\",\n41|\t\"opaque_reasoning_roundtrip\",\n42|\t\"workspace_binding\",\n43|}\n44|\n45|// Capabilities returns the Section 7.8 capability registry in order.\n46|// The result is a copy; the registry cannot be mutated through it.\n47|func Capabilities() []string {\n48|\treturn append([]string(nil), capabilityOrder...)\n49|}\n50|\n51|// manifestMembers is the exact required member set DecodeManifest\n52|// accepts: the schema envelope, identity, versioning, platforms, the\n53|// Section 7.8 operation registry in section order, and the\n54|// capability registry above.\n55|var manifestMembers = map[string]bool{\n56|\t\"schema\":                    true,\n57|\t\"schema_version\":            true,\n58|\t\"provider_id\":               true,\n59|\t\"environment_id\":            true,\n60|\t\"display_name\":              true,\n61|\t\"adapter_version\":           true,\n62|\t\"environment_version_range\": true,\n63|\t\"platforms\":                 true,\n64|\t\"operations\":                true,\n65|\t\"capability_names\":          true,\n66|\t\"extensions\":                true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"environment_id\",\n76|\t\"display_name\",\n77|\t\"adapter_version\",\n78|\t\"environment_version_range\",\n79|\t\"platforms\",\n80|\t\"operations\",\n81|\t\"capability_names\",\n82|\t\"extensions\",\n83|}\n84|\n85|// Manifest is the validated Session Adapter Manifest 1.0.0: the\n86|// provider and environment identity plus the ordered registries the\n87|// probe and dispatch layers check. The canonical body is retained\n88|// for the host-computed digest.\n89|type Manifest struct {\n90|\tProviderID     string\n91|\tEnvironmentID  string\n92|\tAdapterVersion string\n93|\tPlatforms      []string\n94|\tOperations     []string\n95|\tCapabilities   []string\n96|\tcanonical      []byte\n97|}\n98|\n99|// Canonical returns the JCS bytes the digest was computed over.\n100|func (manifest Manifest) Canonical() []byte {\n101|\treturn append([]byte(nil), manifest.canonical...)\n102|}\n103|\n104|// DecodeManifest validates one manifest-operation success body as the\n105|// closed Section 7.8 Session Adapter Manifest. A manifest whose\n106|// operations differ from the dispatch registry, or whose capability\n107|// names differ from the registry above, advertises a surface the\n108|// host cannot invoke or hides one it must, so both are refused\n109|// outright.\n110|func DecodeManifest(body []byte) (Manifest, error) {\n111|\tmembers, fault := decodeStrictObject(body)\n112|\tif fault != nil {\n113|\t\tfailure, err := failProtocol(\"adapter manifest \"+fault.detail, fault.member)\n114|\t\tif err != nil {\n115|\t\t\treturn Manifest{}, err\n116|\t\t}\n117|\t\treturn Manifest{}, failure\n118|\t}\n119|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n120|\t\tfailure, err := failProtocol(\"adapter manifest carries unknown member\", name)\n121|\t\tif err != nil {\n122|\t\t\treturn Manifest{}, err\n123|\t\t}\n124|\t\treturn Manifest{}, failure\n125|\t}\n126|\tif name, missing := missingMember(members, manifestRequired); missing {\n127|\t\tfailure, err := failProtocol(\"adapter manifest misses a required member\", name)\n128|\t\tif err != nil {\n129|\t\t\treturn Manifest{}, err\n130|\t\t}\n131|\t\treturn Manifest{}, failure\n132|\t}\n133|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n134|\t\tfailure, err := failProtocol(\"adapter manifest schema is not the session adapter manifest\", \"schema\")\n135|\t\tif err != nil {\n136|\t\t\treturn Manifest{}, err\n137|\t\t}\n138|\t\treturn Manifest{}, failure\n139|\t}\n140|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n141|\t\tfailure, err := failProtocol(\"adapter manifest version is not 1.0.0\", \"schema_version\")\n142|\t\tif err != nil {\n143|\t\t\treturn Manifest{}, err\n144|\t\t}\n145|\t\treturn Manifest{}, failure\n146|\t}\n147|\tproviderID, ok := rawString(members[\"provider_id\"])\n148|\tif !ok || !providerIDPattern.MatchString(providerID) {\n149|\t\tfailure, err := failProtocol(\"adapter manifest provider identifier is not a provider-id\", \"provider_id\")\n150|\t\tif err != nil {\n151|\t\t\treturn Manifest{}, err\n152|\t\t}\n153|\t\treturn Manifest{}, failure\n154|\t}\n155|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n156|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n157|\t\tfailure, err := failProtocol(\"adapter manifest environment identifier is not an environment-id\", \"environment_id\")\n158|\t\tif err != nil {\n159|\t\t\treturn Manifest{}, err\n160|\t\t}\n161|\t\treturn Manifest{}, failure\n162|\t}\n163|\tif _, ok := checkStringBounds(members[\"display_name\"], 1, 128); !ok {\n164|\t\tfailure, err := failProtocol(\"adapter manifest display name is not a string[1..128]\", \"display_name\")\n165|\t\tif err != nil {\n166|\t\t\treturn Manifest{}, err\n167|\t\t}\n168|\t\treturn Manifest{}, failure\n169|\t}\n170|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n171|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n172|\t\tfailure, err := failProtocol(\"adapter manifest adapter version is not SemVer\", \"adapter_version\")\n173|\t\tif err != nil {\n174|\t\t\treturn Manifest{}, err\n175|\t\t}\n176|\t\treturn Manifest{}, failure\n177|\t}\n178|\tif _, ok := checkStringBounds(members[\"environment_version_range\"], 1, 256); !ok {\n179|\t\tfailure, err := failProtocol(\"adapter manifest environment version range is not a non-empty string[1..256]\", \"environment_version_range\")\n180|\t\tif err != nil {\n181|\t\t\treturn Manifest{}, err\n182|\t\t}\n183|\t\treturn Manifest{}, failure\n184|\t}\n185|\tplatforms, ok := checkSortedUniqueStrings(members[\"platforms\"], 1, 16, 1, 4)\n186|\tif !ok {\n187|\t\tfailure, err := failProtocol(\"adapter manifest platforms are not a sorted unique non-empty subset\", \"platforms\")\n188|\t\tif err != nil {\n189|\t\t\treturn Manifest{}, err\n190|\t\t}\n191|\t\treturn Manifest{}, failure\n192|\t}\n193|\tfor _, platform := range platforms {\n194|\t\tif _, err := scalar.ParsePlatform(platform); err != nil {\n195|\t\t\tfailure, faultErr := failProtocol(\"adapter manifest platform is outside linux|macos|windows|wsl2\", \"platforms\")\n196|\t\t\tif faultErr != nil {\n197|\t\t\t\treturn Manifest{}, faultErr\n198|\t\t\t}\n199|\t\t\treturn Manifest{}, failure\n200|\t\t}\n201|\t}\n202|\toperations, ok := checkOperationRegistry(members[\"operations\"])\n203|\tif !ok {\n204|\t\tfailure, err := failProtocol(\"adapter manifest operations are not the complete ordered fourteen-name registry\", \"operations\")\n205|\t\tif err != nil {\n206|\t\t\treturn Manifest{}, err\n207|\t\t}\n208|\t\treturn Manifest{}, failure\n209|\t}\n210|\tcapabilities, ok := checkCapabilityRegistry(members[\"capability_names\"])\n211|\tif !ok {\n212|\t\tfailure, err := failProtocol(\"adapter manifest capability names are not the complete ordered fifteen-name registry\", \"capability_names\")\n213|\t\tif err != nil {\n214|\t\t\treturn Manifest{}, err\n215|\t\t}\n216|\t\treturn Manifest{}, failure\n217|\t}\n218|\tif !checkExtensions(members[\"extensions\"]) {\n219|\t\tfailure, err := failProtocol(\"adapter manifest extensions are not reverse-DNS keyed\", \"extensions\")\n220|\t\tif err != nil {\n221|\t\t\treturn Manifest{}, err\n222|\t\t}\n223|\t\treturn Manifest{}, failure\n224|\t}\n225|\tcanonical, err := canonicaljson.Canonicalize(body)\n226|\tif err != nil {\n227|\t\tfailure, faultErr := failProtocol(\"adapter manifest is not canonical JSON\", \"\")\n228|\t\tif faultErr != nil {\n229|\t\t\treturn Manifest{}, faultErr\n230|\t\t}\n231|\t\treturn Manifest{}, failure\n232|\t}\n233|\treturn Manifest{\n234|\t\tProviderID:     providerID,\n235|\t\tEnvironmentID:  environmentID,\n236|\t\tAdapterVersion: adapterVersion,\n237|\t\tPlatforms:      platforms,\n238|\t\tOperations:     operations,\n239|\t\tCapabilities:   capabilities,\n240|\t\tcanonical:      canonical,\n241|\t}, nil\n242|}\n243|\n244|// checkOperationRegistry reports whether the member is exactly the\n245|// dispatch registry in section order: same names, same positions,\n246|// same length. Sortedness is not the rule here — order is — so the\n247|// comparison is element-wise against operationOrder.\n248|func checkOperationRegistry(raw json.RawMessage) ([]string, bool) {\n249|\telements, ok := decodeArray(raw)\n250|\tif !ok || len(elements) != len(operationOrder) {\n251|\t\treturn nil, false\n252|\t}\n253|\toperations := make([]string, 0, len(elements))\n254|\tfor index, element := range elements {\n255|\t\tname, ok := rawString(element)\n256|\t\tif !ok || name != string(operationOrder[index]) {\n257|\t\t\treturn nil, false\n258|\t\t}\n259|\t\toperations = append(operations, name)\n260|\t}\n261|\treturn operations, true\n262|}\n263|\n264|// checkCapabilityRegistry reports whether the member is exactly the\n265|// fifteen-name capability registry in section order.\n266|func checkCapabilityRegistry(raw json.RawMessage) ([]string, bool) {\n267|\telements, ok := decodeArray(raw)\n268|\tif !ok || len(elements) != len(capabilityOrder) {\n269|\t\treturn nil, false\n270|\t}\n271|\tcapabilities := make([]string, 0, len(elements))\n272|\tfor index, element := range elements {\n273|\t\tname, ok := rawString(element)\n274|\t\tif !ok || name != capabilityOrder[index] {\n275|\t\t\treturn nil, false\n276|\t\t}\n277|\t\tcapabilities = append(capabilities, name)\n278|\t}\n279|\treturn capabilities, true\n280|}\n281|\n282|// ManifestDigest returns the host-computed JCS SHA-256 of the\n283|// validated manifest: the session_adapter_manifest_digest. It is\n284|// computed by the host, never embedded by the adapter, so a\n285|// manifest that names its own digest cannot mint trust.\n286|func ManifestDigest(manifest Manifest) scalar.Digest {\n287|\treturn scalar.SHA256Digest(manifest.canonical)\n288|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ad","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":177,"recorded_at":1780531400000349,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a544687022a8cdf5d67b29448b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|)\n6|\n7|// This file validates the Section 7.8 Session Adapter Probe 1.0.0,\n8|// the capability-value rules, the probe equality gates against the\n9|// verified manifest and host values, the doctor health gate, and\n10|// the target-write capability gates.\n11|\n12|// probeSchema is the exact schema identifier the probe carries.\n13|const probeSchema = \"urn:ax:schema:session-adapter-probe\"\n14|\n15|// probeSchemaVersion is the only probe version this host accepts.\n16|const probeSchemaVersion = \"1.0.0\"\n17|\n18|// probeMembers is the exact Session Adapter Probe 1.0.0 member set:\n19|// schema, schema_version, provider_id, adapter_manifest_digest,\n20|// adapter_version, environment, capabilities, warnings, and\n21|// extensions.\n22|var probeMembers = map[string]bool{\n23|\t\"schema\":                  true,\n24|\t\"schema_version\":          true,\n25|\t\"provider_id\":             true,\n26|\t\"adapter_manifest_digest\": true,\n27|\t\"adapter_version\":         true,\n28|\t\"environment\":             true,\n29|\t\"capabilities\":            true,\n30|\t\"warnings\":                true,\n31|\t\"extensions\":              true,\n32|}\n33|\n34|// probeRequired lists probeMembers in a fixed order.\n35|var probeRequired = []string{\n36|\t\"schema\",\n37|\t\"schema_version\",\n38|\t\"provider_id\",\n39|\t\"adapter_manifest_digest\",\n40|\t\"adapter_version\",\n41|\t\"environment\",\n42|\t\"capabilities\",\n43|\t\"warnings\",\n44|\t\"extensions\",\n45|}\n46|\n47|// capabilityValueMembers is the exact per-capability value member\n48|// set: status, enabled, evidence, and detail. Only\n49|// status=available permits enabled=true.\n50|var capabilityValueMembers = map[string]bool{\n51|\t\"status\":   true,\n52|\t\"enabled\":  true,\n53|\t\"evidence\": true,\n54|\t\"detail\":   true,\n55|}\n56|\n57|// capabilityValueRequired lists capabilityValueMembers in order.\n58|var capabilityValueRequired = []string{\n59|\t\"status\",\n60|\t\"enabled\",\n61|\t\"evidence\",\n62|\t\"detail\",\n63|}\n64|\n65|// Capability is one validated capability value.\n66|type Capability struct {\n67|\tStatus   string\n68|\tEnabled  bool\n69|\tEvidence string\n70|\tDetail   string\n71|}\n72|\n73|// Probe is one validated Session Adapter Probe 1.0.0.\n74|type Probe struct {\n75|\tProviderID     string\n76|\tManifestDigest string\n77|\tAdapterVersion string\n78|\tEnvironment    Tuple\n79|\tCapabilities   map[string]Capability\n80|\tWarnings       []string\n81|}\n82|\n83|// decodeCapabilityValue validates one closed capability value:\n84|// status in available|conditional|unsupported|unknown, evidence in\n85|// the seven-vocabulary, detail as string[0..2048], and the\n86|// coherence rule that only available permits enabled=true. A\n87|// conditional, unsupported, or unknown capability with\n88|// enabled=true is a contradictory fact and invalidates the whole\n89|// probe, never a usable surface.\n90|func decodeCapabilityValue(raw json.RawMessage, name string) (Capability, error) {\n91|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(\"adapter capability \"+fault.detail, name)\n94|\t\tif err != nil {\n95|\t\t\treturn Capability{}, err\n96|\t\t}\n97|\t\treturn Capability{}, failure\n98|\t}\n99|\tif member, unknown := unknownMember(members, capabilityValueMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"adapter capability value carries unknown member\", member)\n101|\t\tif err != nil {\n102|\t\t\treturn Capability{}, err\n103|\t\t}\n104|\t\treturn Capability{}, failure\n105|\t}\n106|\tif member, missing := missingMember(members, capabilityValueRequired); missing {\n107|\t\tfailure, err := failProtocol(\"adapter capability value misses a required member\", member)\n108|\t\tif err != nil {\n109|\t\t\treturn Capability{}, err\n110|\t\t}\n111|\t\treturn Capability{}, failure\n112|\t}\n113|\tstatus, ok := rawString(members[\"status\"])\n114|\tif !ok || !validCapabilityStatus(status) {\n115|\t\tfailure, err := failProtocol(\"adapter capability status is outside available|conditional|unsupported|unknown\", name)\n116|\t\tif err != nil {\n117|\t\t\treturn Capability{}, err\n118|\t\t}\n119|\t\treturn Capability{}, failure\n120|\t}\n121|\tenabled, ok := rawBool(members[\"enabled\"])\n122|\tif !ok {\n123|\t\tfailure, err := failProtocol(\"adapter capability enabled flag is not a boolean\", name)\n124|\t\tif err != nil {\n125|\t\t\treturn Capability{}, err\n126|\t\t}\n127|\t\treturn Capability{}, failure\n128|\t}\n129|\tif enabled && status != \"available\" {\n130|\t\tfailure, err := failProtocol(\"adapter capability is enabled without available status\", name)\n131|\t\tif err != nil {\n132|\t\t\treturn Capability{}, err\n133|\t\t}\n134|\t\treturn Capability{}, failure\n135|\t}\n136|\tevidence, ok := rawString(members[\"evidence\"])\n137|\tif !ok || !validCapabilityEvidence(evidence) {\n138|\t\tfailure, err := failProtocol(\"adapter capability evidence is outside the seven-evidence vocabulary\", name)\n139|\t\tif err != nil {\n140|\t\t\treturn Capability{}, err\n141|\t\t}\n142|\t\treturn Capability{}, failure\n143|\t}\n144|\tdetail, ok := checkStringBounds(members[\"detail\"], 0, 2048)\n145|\tif !ok {\n146|\t\tfailure, err := failProtocol(\"adapter capability detail is not a string[0..2048]\", name)\n147|\t\tif err != nil {\n148|\t\t\treturn Capability{}, err\n149|\t\t}\n150|\t\treturn Capability{}, failure\n151|\t}\n152|\treturn Capability{\n153|\t\tStatus:   status,\n154|\t\tEnabled:  enabled,\n155|\t\tEvidence: evidence,\n156|\t\tDetail:   detail,\n157|\t}, nil\n158|}\n159|\n160|// capabilityEvidences is the seven-evidence vocabulary Section 7.8\n161|// states. Membership is a table loop so the census derives it like\n162|// every other closed vocabulary.\n163|var capabilityEvidences = []string{\n164|\t\"documented\",\n165|\t\"probed\",\n166|\t\"accepted_test\",\n167|\t\"provider_contract\",\n168|\t\"inferred\",\n169|\t\"acceptance_required\",\n170|\t\"none\",\n171|}\n172|\n173|// validCapabilityEvidence reports whether the evidence token is one\n174|// of the seven Section 7.8 values.\n175|func validCapabilityEvidence(evidence string) bool {\n176|\tfor _, allowed := range capabilityEvidences {\n177|\t\tif evidence == allowed {\n178|\t\t\treturn true\n179|\t\t}\n180|\t}\n181|\treturn false\n182|}\n183|\n184|// capabilityStatuses is the four-status vocabulary Section 7.8\n185|// states. Membership is a table loop so the census derives it like\n186|// every other closed vocabulary.\n187|var capabilityStatuses = []string{\n188|\t\"available\",\n189|\t\"conditional\",\n190|\t\"unsupported\",\n191|\t\"unknown\",\n192|}\n193|\n194|// validCapabilityStatus reports whether the status token is one of\n195|// the four Section 7.8 values.\n196|func validCapabilityStatus(status string) bool {\n197|\tfor _, allowed := range capabilityStatuses {\n198|\t\tif status == allowed {\n199|\t\t\treturn true\n200|\t\t}\n201|\t}\n202|\treturn false\n203|}\n204|\n205|// registryEntryStatuses is the three-status doctor vocabulary the\n206|// Section 7.8 doctor row states: accepted, revoked, and absent.\n207|// Membership is a table loop so the census derives it like every\n208|// other closed vocabulary.\n209|var registryEntryStatuses = []string{\n210|\t\"accepted\",\n211|\t\"revoked\",\n212|\t\"absent\",\n213|}\n214|\n215|// validRegistryEntryStatus reports whether the status is one of\n216|// the three Section 7.8 doctor entry statuses.\n217|func validRegistryEntryStatus(status string) bool {\n218|\tfor _, allowed := range registryEntryStatuses {\n219|\t\tif status == allowed {\n220|\t\t\treturn true\n221|\t\t}\n222|\t}\n223|\treturn false\n224|}\n225|\n226|// DecodeProbe validates one probe-operation success body as the\n227|// closed Section 7.8 Session Adapter Probe: the exact members, all\n228|// fifteen capabilities with no omission and no extra, and the\n229|// value rules above. Missing, extra, duplicated, malformed, or\n230|// contradictory facts invalidate the whole probe and never mean\n231|// unsupported. Equality against the manifest and host values is\n232|// the separate CheckProbe gate: decoding proves shape, not\n233|// binding.\n234|func DecodeProbe(body []byte) (Probe, error) {\n235|\tmembers, fault := decodeStrictObject(body)\n236|\tif fault != nil {\n237|\t\tfailure, err := failProtocol(\"adapter probe \"+fault.detail, fault.member)\n238|\t\tif err != nil {\n239|\t\t\treturn Probe{}, err\n240|\t\t}\n241|\t\treturn Probe{}, failure\n242|\t}\n243|\tif name, unknown := unknownMember(members, probeMembers); unknown {\n244|\t\tfailure, err := failProtocol(\"adapter probe carries unknown member\", name)\n245|\t\tif err != nil {\n246|\t\t\treturn Probe{}, err\n247|\t\t}\n248|\t\treturn Probe{}, failure\n249|\t}\n250|\tif name, missing := missingMember(members, probeRequired); missing {\n251|\t\tfailure, err := failProtocol(\"adapter probe misses a required member\", name)\n252|\t\tif err != nil {\n253|\t\t\treturn Probe{}, err\n254|\t\t}\n255|\t\treturn Probe{}, failure\n256|\t}\n257|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != probeSchema {\n258|\t\tfailure, err := failProtocol(\"adapter probe schema is not the session adapter probe\", \"schema\")\n259|\t\tif err != nil {\n260|\t\t\treturn Probe{}, err\n261|\t\t}\n262|\t\treturn Probe{}, failure\n263|\t}\n264|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != probeSchemaVersion {\n265|\t\tfailure, err := failProtocol(\"adapter probe version is not 1.0.0\", \"schema_version\")\n266|\t\tif err != nil {\n267|\t\t\treturn Probe{}, err\n268|\t\t}\n269|\t\treturn Probe{}, failure\n270|\t}\n271|\tproviderID, ok := rawString(members[\"provider_id\"])\n272|\tif !ok || !providerIDPattern.MatchString(providerID) {\n273|\t\tfailure, err := failProtocol(\"adapter probe provider identifier is not a provider-id\", \"provider_id\")\n274|\t\tif err != nil {\n275|\t\t\treturn Probe{}, err\n276|\t\t}\n277|\t\treturn Probe{}, failure\n278|\t}\n279|\tmanifestDigest, ok := checkDigest(members[\"adapter_manifest_digest\"])\n280|\tif !ok {\n281|\t\tfailure, err := failProtocol(\"adapter probe manifest digest is not a digest\", \"adapter_manifest_digest\")\n282|\t\tif err != nil {\n283|\t\t\treturn Probe{}, err\n284|\t\t}\n285|\t\treturn Probe{}, failure\n286|\t}\n287|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n288|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n289|\t\tfailure, err := failProtocol(\"adapter probe adapter version is not SemVer\", \"adapter_version\")\n290|\t\tif err != nil {\n291|\t\t\treturn Probe{}, err\n292|\t\t}\n293|\t\treturn Probe{}, failure\n294|\t}\n295|\tenvironment, err := DecodeTuple(members[\"environment\"])\n296|\tif err != nil {\n297|\t\treturn Probe{}, err\n298|\t}\n299|\tcapabilities, err := decodeCapabilities(members[\"capabilities\"])\n300|\tif err != nil {\n301|\t\treturn Probe{}, err\n302|\t}\n303|\twarnings, ok := checkSortedUniqueStrings(members[\"warnings\"], 0, 2048, 0, 1024)\n304|\tif !ok {\n305|\t\tfailure, err := failProtocol(\"adapter probe warnings are not sorted unique string[0..2048][0..1024]\", \"warnings\")\n306|\t\tif err != nil {\n307|\t\t\treturn Probe{}, err\n308|\t\t}\n309|\t\treturn Probe{}, failure\n310|\t}\n311|\tif !checkExtensions(members[\"extensions\"]) {\n312|\t\tfailure, err := failProtocol(\"adapter probe extensions are not reverse-DNS keyed\", \"extensions\")\n313|\t\tif err != nil {\n314|\t\t\treturn Probe{}, err\n315|\t\t}\n316|\t\treturn Probe{}, failure\n317|\t}\n318|\treturn Probe{\n319|\t\tProviderID:     providerID,\n320|\t\tManifestDigest: manifestDigest.String(),\n321|\t\tAdapterVersion: adapterVersion,\n322|\t\tEnvironment:    environment,\n323|\t\tCapabilities:   capabilities,\n324|\t\tWarnings:       warnings,\n325|\t}, nil\n326|}\n327|\n328|// decodeCapabilities validates the closed capability map: exactly\n329|// the fifteen registry names, each with a closed value. The map\n330|// carries no order — names are the keys — so omission and extra\n331|// are the two refused directions, and duplication is already\n332|// refused by the strict decode.\n333|func decodeCapabilities(raw json.RawMessage) (map[string]Capability, error) {\n334|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n335|\tif fault != nil {\n336|\t\tfailure, err := failProtocol(\"adapter capabilities \"+fault.detail, \"capabilities\")\n337|\t\tif err != nil {\n338|\t\t\treturn nil, err\n339|\t\t}\n340|\t\treturn nil, failure\n341|\t}\n342|\tif len(members) != len(capabilityOrder) {\n343|\t\tfailure, err := failProtocol(\"adapter capabilities do not carry exactly fifteen entries\", \"capabilities\")\n344|\t\tif err != nil {\n345|\t\t\treturn nil, err\n346|\t\t}\n347|\t\treturn nil, failure\n348|\t}\n349|\tcapabilities := make(map[string]Capability, len(capabilityOrder))\n350|\tfor _, name := range capabilityOrder {\n351|\t\trawValue, present := members[name]\n352|\t\tif !present {\n353|\t\t\tfailure, err := failProtocol(\"adapter capabilities omit a registry capability\", name)\n354|\t\t\tif err != nil {\n355|\t\t\t\treturn nil, err\n356|\t\t\t}\n357|\t\t\treturn nil, failure\n358|\t\t}\n359|\t\tvalue, err := decodeCapabilityValue(rawValue, name)\n360|\t\tif err != nil {\n361|\t\t\treturn nil, err\n362|\t\t}\n363|\t\tcapabilities[name] = value\n364|\t}\n365|\treturn capabilities, nil\n366|}\n367|\n368|// ProbeHostFacts are the host-held values the probe must equal:\n369|// the provider identifier and candidate kind from the probe\n370|// request the host built, the manifest digest the host computed,\n371|// and the manifest the host verified. Nothing here comes from the\n372|// adapter.\n373|type ProbeHostFacts struct {\n374|\tExpectedProviderID string\n375|\tExpectedKind       CandidateKind\n376|\tManifestDigest     string\n377|\tManifest           Manifest\n378|}\n379|\n380|// CheckProbe enforces the Section 7.8 probe equalities: provider\n381|// ID, manifest digest, and adapter version equal the verified\n382|// manifest and host values, and the reported tuple is the\n383|// manifest's tuple — the adapter's one semantic native\n384|// environment, so a probe reporting any other tuple is an\n385|// unrequested tuple and is refused. The tuple's adapter version\n386|// must equal the probe's own adapter version: both name the same\n387|// probed software, and a probe disagreeing with itself is\n388|// refused. Whether the tuple's environment version satisfies the\n389|// manifest's version-range constraint language is a stated bound:\n390|// the range grammar has no evaluation rule in Section 7.8.\n391|func CheckProbe(probe Probe, facts ProbeHostFacts) error {\n392|\tif probe.ProviderID != facts.ExpectedProviderID {\n393|\t\tfailure, err := failProtocol(\"adapter probe provider identifier does not match the requested provider\", \"provider_id\")\n394|\t\tif err != nil {\n395|\t\t\treturn err\n396|\t\t}\n397|\t\treturn failure\n398|\t}\n399|\tif probe.ProviderID != facts.Manifest.ProviderID {\n400|\t\tfailure, err := failProtocol(\"adapter probe provider identifier does not match the verified manifest\", \"provider_id\")\n401|\t\tif err != nil {\n402|\t\t\treturn err\n403|\t\t}\n404|\t\treturn failure\n405|\t}\n406|\tif probe.ManifestDigest != facts.ManifestDigest {\n407|\t\tfailure, err := failProtocol(\"adapter probe manifest digest does not match the host-computed digest\", \"adapter_manifest_digest\")\n408|\t\tif err != nil {\n409|\t\t\treturn err\n410|\t\t}\n411|\t\treturn failure\n412|\t}\n413|\tif probe.AdapterVersion != facts.Manifest.AdapterVersion {\n414|\t\tfailure, err := failProtocol(\"adapter probe adapter version does not match the verified manifest\", \"adapter_version\")\n415|\t\tif err != nil {\n416|\t\t\treturn err\n417|\t\t}\n418|\t\treturn failure\n419|\t}\n420|\tif probe.Environment.EnvironmentID != facts.Manifest.EnvironmentID {\n421|\t\tfailure, err := failUnsupportedTuple(\"adapter probe reports a tuple outside the manifest environment\", probe.Environment.EnvironmentID)\n422|\t\tif err != nil {\n423|\t\t\treturn err\n424|\t\t}\n425|\t\treturn failure\n426|\t}\n427|\tif probe.Environment.AdapterVersion != probe.AdapterVersion {\n428|\t\tfailure, err := failProtocol(\"adapter probe tuple adapter version does not match the probe adapter version\", \"environment\")\n429|\t\tif err != nil {\n430|\t\t\treturn err\n431|\t\t}\n432|\t\treturn failure\n433|\t}\n434|\treturn nil\n435|}\n436|\n437|// CheckProbeRequest binds the probe request the host built to the\n438|// trusted candidate: the expected provider identifier and\n439|// candidate kind must equal the candidate the host will invoke.\n440|// A request naming a different provider or kind would attest a\n441|// probe for a candidate the host never observed.\n442|func CheckProbeRequest(expectedProviderID string, expectedKind CandidateKind, candidate TrustedCandidate) error {\n443|\tif expectedProviderID != candidate.ProviderID {\n444|\t\tfailure, err := failInvalid(\"probe request provider identifier does not match the trusted candidate\", \"expected_provider_id\")\n445|\t\tif err != nil {\n446|\t\t\treturn err\n447|\t\t}\n448|\t\treturn failure\n449|\t}\n450|\tif expectedKind != candidate.Kind {\n451|\t\tfailure, err := failInvalid(\"probe request candidate kind does not match the trusted candidate\", \"expected_candidate_kind\")\n452|\t\tif err != nil {\n453|\t\t\treturn err\n454|\t\t}\n455|\t\treturn failure\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// CapabilityUsable reports whether the named capability is a usable\n461|// surface: present in the closed registry with status=available and\n462|// enabled=true. Conditional, unsupported, and unknown surfaces are\n463|// never usable, and neither is a name outside the registry.\n464|func CapabilityUsable(probe Probe, name string) bool {\n465|\tvalue, present := probe.Capabilities[name]\n466|\tif !present {\n467|\t\treturn false\n468|\t}\n469|\treturn value.Status == \"available\" && value.Enabled\n470|}\n471|\n472|// ProviderCapability is one provider-probe capability the\n473|// target-write gate reads: the provider's portable-store and\n474|// native-resume facts live in the provider probe, not the adapter\n475|// probe, so the caller projects exactly those two surfaces.\n476|type ProviderCapability struct {\n477|\tStatus  string\n478|\tEnabled bool\n479|}\n480|\n481|// CheckTargetWriteGates enforces the Section 7.8 target-write\n482|// conjunction: available canonical-write or official-import,\n483|// native-read-back, native-resume-plan, and workspace-binding on\n484|// the adapter side, plus provider portable-store and native-resume\n485|// on the provider side. Exact execution bindings, accepted\n486|// non-revoked tuple entries, and current fixture plus bounded\n487|// resume-smoke evidence are the caller's adjacent gates\n488|// (CheckBinding, CheckTupleAdmission, CheckDoctorResult): this\n489|// gate decides the capability conjunction only. --force,\n490|// experimental profiles, and environment-name-only matches cannot\n491|// bypass these gates: the function takes no bypass parameter, so a\n492|// caller cannot express one. Unknown sources may be archived only\n493|// after safe byte enumeration; unknown targets never write —\n494|// which this gate enforces by refusing every capability it cannot\n495|// see as available and enabled.\n496|func CheckTargetWriteGates(adapter map[string]Capability, provider map[string]ProviderCapability) error {\n497|\tif !capabilityMapUsable(adapter, \"canonical_write\") && !capabilityMapUsable(adapter, \"official_import\") {\n498|\t\tfailure, err := failCapability(\"target write has neither usable canonical-write nor official-import\", \"canonical_write|official_import\")\n499|\t\tif err != nil {\n500|\t\t\treturn err\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
