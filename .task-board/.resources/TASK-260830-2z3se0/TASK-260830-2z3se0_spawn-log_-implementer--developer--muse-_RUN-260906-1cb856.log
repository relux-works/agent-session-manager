{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c757","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":518,"recorded_at":1780531400001031,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a6d39c7420a75dbf6b327b2f53","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/fixtures_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|)\n15|\n16|// Shared fixtures for the sessadapter suite. Every builder emits\n17|// hand-written JSON with independently chosen literals: no builder\n18|// derives its probe points from production constants, so a mutated\n19|// production constant cannot take its fixture with it. The verdict\n20|// always comes from production; the vectors never do.\n21|\n22|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n23|// the digests are syntactically pinned sha256 hex.\n24|const (\n25|\tfixtureProviderID    = \"test-provider\"\n26|\tfixtureEnvironmentID = \"test.env\"\n27|\tfixtureAdapterVer    = \"1.2.3\"\n28|\tfixtureRequestID     = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n29|\tfixtureOperationID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n30|\tfixtureAuthorityID   = \"0198f4c8-8e50-7f66-8f70-1234567890ad\"\n31|\tfixtureDeadline      = \"2026-08-19T04:05:00.000Z\"\n32|\tfixtureValidFrom     = \"2026-01-01T00:00:00.000Z\"\n33|\tfixtureValidUntil    = \"2027-01-01T00:00:00.000Z\"\n34|\tfixtureCallTime      = \"2026-06-01T00:00:00.000Z\"\n35|\tfixtureExecutedAt    = \"2026-05-01T00:00:00.000Z\"\n36|\tfixtureExpiresAt     = \"2026-08-19T05:05:00.000Z\"\n37|)\n38|\n39|// fixtureDigest returns the pinned digest of one seed.\n40|func fixtureDigest(seed string) string {\n41|\tsum := sha256.Sum256([]byte(seed))\n42|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n43|}\n44|\n45|// Standard fixture digests, each naming its seed.\n46|var (\n47|\tfixtureExecutableDigest = fixtureDigest(\"test-executable\")\n48|\tfixtureProviderManifest = fixtureDigest(\"test-provider-manifest\")\n49|\tfixtureStorePrint       = fixtureDigest(\"test-store-fingerprint\")\n50|\tfixtureSuiteDigest      = fixtureDigest(\"test-suite\")\n51|\tfixtureEvidenceDigest   = fixtureDigest(\"test-evidence\")\n52|\tfixtureSmokeDigest      = fixtureDigest(\"test-smoke\")\n53|\tfixtureRegistryDigest   = fixtureDigest(\"test-registry\")\n54|\tfixturePlanDigest       = fixtureDigest(\"test-plan\")\n55|\tfixtureCaptureDigest    = fixtureDigest(\"test-capture-manifest\")\n56|\tfixtureSessionDigest    = fixtureDigest(\"test-canonical-session\")\n57|\tfixtureProjectedDigest  = fixtureDigest(\"test-projected-manifest\")\n58|\tfixtureStructuralDigest = fixtureDigest(\"test-structural\")\n59|\tfixtureReadBackDigest   = fixtureDigest(\"test-read-back-evidence\")\n60|)\n61|\n62|// fixtureTupleJSON is one valid Environment Tuple.\n63|func fixtureTupleJSON() string {\n64|\treturn fmt.Sprintf(`{\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":%q}`,\n65|\t\tfixtureEnvironmentID, fixtureStorePrint, fixtureAdapterVer)\n66|}\n67|\n68|// fixtureContextJSON is one valid AdapterCallContext carrying the\n69|// given request digest.\n70|func fixtureContextJSON(requestDigest string) string {\n71|\treturn fmt.Sprintf(`{\"operation_id\":%q,\"provider_id\":%q,\"environment\":%s,\"session_adapter_manifest_digest\":%q,\"executable_sha256\":%q,\"request_digest\":%q,\"extensions\":{}}`,\n72|\t\tfixtureOperationID, fixtureProviderID, fixtureTupleJSON(), fixtureDigest(\"test-adapter-manifest\"), fixtureExecutableDigest, requestDigest)\n73|}\n74|\n75|// fixtureReadAuthorityJSON is one valid source_native ReadAuthority.\n76|func fixtureReadAuthorityJSON() string {\n77|\treturn fmt.Sprintf(`{\"authority_id\":%q,\"purpose\":\"source_native\",\"root_handle_names\":[\"handle-a\"],\"expires_at\":%q,\"extensions\":{}}`,\n78|\t\tfixtureAuthorityID, fixtureExpiresAt)\n79|}\n80|\n81|// fixtureFreshSinkJSON is one valid fresh_sink ObjectAuthority.\n82|func fixtureFreshSinkJSON(purpose string) string {\n83|\treturn fmt.Sprintf(`{\"authority_id\":%q,\"purpose\":%q,\"mode\":\"fresh_sink\",\"max_objects\":100,\"max_total_bytes\":1000000,\"extensions\":{}}`,\n84|\t\tfixtureAuthorityID, purpose)\n85|}\n86|\n87|// fixtureManifestJSON is one valid Session Adapter Manifest 1.0.0\n88|// with the registries in section order.\n89|func fixtureManifestJSON() string {\n90|\toperations := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\toperations = append(operations, `\"`+string(operation)+`\"`)\n93|\t}\n94|\tcapabilities := make([]string, 0, len(capabilityOrder))\n95|\tfor _, name := range capabilityOrder {\n96|\t\tcapabilities = append(capabilities, `\"`+name+`\"`)\n97|\t}\n98|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-adapter-manifest\",\"schema_version\":\"1.0.0\",\"provider_id\":%q,\"environment_id\":%q,\"display_name\":\"Test Adapter\",\"adapter_version\":%q,\"environment_version_range\":\">=1.0.0\",\"platforms\":[\"linux\",\"macos\"],\"operations\":[%s],\"capability_names\":[%s],\"extensions\":{}}`,\n99|\t\tfixtureProviderID, fixtureEnvironmentID, fixtureAdapterVer,\n100|\t\tstrings.Join(operations, \",\"), strings.Join(capabilities, \",\"))\n101|}\n102|\n103|// fixtureCapabilityJSON is one available+enabled capability value.\n104|func fixtureCapabilityJSON() string {\n105|\treturn `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"\"}`\n106|}\n107|\n108|// fixtureProbeJSON is one valid Session Adapter Probe 1.0.0 with\n109|// every capability available and enabled.\n110|func fixtureProbeJSON(manifestDigest string) string {\n111|\tvalues := make([]string, 0, len(capabilityOrder))\n112|\tfor _, name := range capabilityOrder {\n113|\t\tvalues = append(values, `\"`+name+`\":`+fixtureCapabilityJSON())\n114|\t}\n115|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-adapter-probe\",\"schema_version\":\"1.0.0\",\"provider_id\":%q,\"adapter_manifest_digest\":%q,\"adapter_version\":%q,\"environment\":%s,\"capabilities\":{%s},\"warnings\":[],\"extensions\":{}}`,\n116|\t\tfixtureProviderID, manifestDigest, fixtureAdapterVer, fixtureTupleJSON(), strings.Join(values, \",\"))\n117|}\n118|\n119|// fixtureEntryJSON is one valid accepted registry entry for the\n120|// direction: source_read carries strategies=[archive_only] with\n121|// null smoke, target_write carries the native-writer strategy\n122|// with passing smoke.\n123|func fixtureEntryJSON(direction Direction) string {\n124|\tstrategies := `[\"archive_only\"]`\n125|\tsmoke := `null`\n126|\tif direction == DirectionTargetWrite {\n127|\t\tstrategies = `[\"target_native_writer\"]`\n128|\t\tsmoke = fmt.Sprintf(`{\"result\":\"pass\",\"executed_at\":%q,\"evidence_digest\":%q,\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":true}`,\n129|\t\t\tfixtureExecutedAt, fixtureSmokeDigest)\n130|\t}\n131|\treturn fmt.Sprintf(`{\"key\":{\"direction\":%q,\"environment\":%s,\"provider_id\":%q,\"candidate_kind\":\"builtin\",\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q},\"entry_sequence\":7,\"contracts\":[{\"contract_id\":\"urn:ax:protocol:session-adapter\",\"versions\":[\"1.0.0\"]}],\"strategies\":%s,\"fixture_evidence\":{\"suite_revision\":\"rev-9\",\"suite_digest\":%q,\"result\":\"pass\",\"executed_at\":%q,\"evidence_digest\":%q,\"fixture_count\":12},\"resume_smoke_evidence\":%s,\"known_fidelity_limits\":[],\"valid_from\":%q,\"valid_until\":%q,\"status\":\"accepted\",\"revocation_reason\":null,\"revoked_at\":null,\"extensions\":{}}`,\n132|\t\tstring(direction), fixtureTupleJSON(), fixtureProviderID,\n133|\t\tfixtureExecutableDigest, fixtureProviderManifest, fixtureDigest(\"test-adapter-manifest\"),\n134|\t\tstrategies, fixtureSuiteDigest, fixtureExecutedAt, fixtureEvidenceDigest, smoke,\n135|\t\tfixtureValidFrom, fixtureValidUntil)\n136|}\n137|\n138|// fixtureBindingFacts are the host-observed facts matching every\n139|// fixture above.\n140|func fixtureBindingFacts() BindingFacts {\n141|\treturn BindingFacts{\n142|\t\tProviderID:             fixtureProviderID,\n143|\t\tCandidateKind:          CandidateBuiltin,\n144|\t\tExecutableSHA256:       fixtureExecutableDigest,\n145|\t\tProviderManifestDigest: fixtureProviderManifest,\n146|\t\tAdapterManifestDigest:  fixtureDigest(\"test-adapter-manifest\"),\n147|\t}\n148|}\n149|\n150|// fixtureCandidate is the trusted candidate matching every\n151|// fixture above.\n152|func fixtureCandidate() TrustedCandidate {\n153|\treturn TrustedCandidate{\n154|\t\tProviderID:             fixtureProviderID,\n155|\t\tKind:                   CandidateBuiltin,\n156|\t\tExecutablePath:         \"/opt/ax/bin/ax-provider-test-provider\",\n157|\t\tOwnerIdentity:          \"test-owner\",\n158|\t\tExecutableSHA256:       fixtureExecutableDigest,\n159|\t\tProviderManifestDigest: fixtureProviderManifest,\n160|\t}\n161|}\n162|\n163|// mutateMember returns the object with one top-level member\n164|// replaced by the given raw JSON. The replacement is applied to a\n165|// fresh positive fixture, one mutation at a time, per the\n166|// Appendix D execution rules. Members re-encode in sorted key\n167|// order and the replacement passes through unvalidated, so\n168|// malformed values reach the production decoder instead of\n169|// failing the test scaffolding.\n170|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n171|\tt.Helper()\n172|\tvar members map[string]json.RawMessage\n173|\tif err := json.Unmarshal(body, &members); err != nil {\n174|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n175|\t}\n176|\tmembers[member] = json.RawMessage(replacement)\n177|\tnames := make([]string, 0, len(members))\n178|\tfor name := range members {\n179|\t\tnames = append(names, name)\n180|\t}\n181|\tsort.Strings(names)\n182|\tparts := make([]string, 0, len(members))\n183|\tfor _, name := range names {\n184|\t\tquoted, err := json.Marshal(name)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"mutateMember: %v\", err)\n187|\t\t}\n188|\t\tparts = append(parts, string(quoted)+\":\"+string(members[name]))\n189|\t}\n190|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n191|}\n192|\n193|// dropMember returns the object without one top-level member.\n194|func dropMember(t *testing.T, body []byte, member string) []byte {\n195|\tt.Helper()\n196|\tvar members map[string]json.RawMessage\n197|\tif err := json.Unmarshal(body, &members); err != nil {\n198|\t\tt.Fatalf(\"dropMember: fixture is not JSON: %v\", err)\n199|\t}\n200|\tdelete(members, member)\n201|\tdropped, err := json.Marshal(members)\n202|\tif err != nil {\n203|\t\tt.Fatalf(\"dropMember: %v\", err)\n204|\t}\n205|\treturn dropped\n206|}\n207|\n208|// failureObject requires a Structured Error and returns it.\n209|func failureObject(t *testing.T, err error) *axerror.Error {\n210|\tt.Helper()\n211|\tif err == nil {\n212|\t\tt.Fatal(\"want refusal, got nil error\")\n213|\t}\n214|\tfailure, ok := err.(*axerror.Error)\n215|\tif !ok {\n216|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n217|\t}\n218|\treturn failure\n219|}\n220|\n221|// failureCode returns the stable code of a refusal.\n222|func failureCode(t *testing.T, err error) axerror.Code {\n223|\tt.Helper()\n224|\treturn failureObject(t, err).Code()\n225|}\n226|\n227|// failureDetail returns one string diagnostic of a refusal.\n228|func failureDetail(t *testing.T, err error, key string) string {\n229|\tt.Helper()\n230|\tdetail, ok := failureObject(t, err).Detail(key)\n231|\tif !ok {\n232|\t\tt.Fatalf(\"refusal %v carries no %q detail\", err, key)\n233|\t}\n234|\ttext, ok := detail.(string)\n235|\tif !ok {\n236|\t\tt.Fatalf(\"refusal %v detail %q is %T, want string\", err, key, detail)\n237|\t}\n238|\treturn text\n239|}\n240|\n241|// requireRefusal asserts the full arm identity of a refusal: the\n242|// stable code, one distinguishing diagnostic, the detail naming\n243|// the rule in the human text, and the non-retryable bit. Asserting\n244|// the distinguishing diagnostic pins which arm fired: deleting a\n245|// gate slides the refusal to a lower arm carrying the same code\n246|// with a different diagnostic, and the slide reddens here.\n247|func requireRefusal(t *testing.T, err error, code axerror.Code, detailKey, detailValue, text string) {\n248|\tt.Helper()\n249|\tif failureCode(t, err) != code {\n250|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n251|\t}\n252|\tif got := failureDetail(t, err, detailKey); got != detailValue {\n253|\t\tt.Fatalf(\"%s detail = %q, want %q (error: %v)\", detailKey, got, detailValue, err)\n254|\t}\n255|\tif !strings.Contains(err.Error(), text) {\n256|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, text)\n257|\t}\n258|\tif failureObject(t, err).Retryable() {\n259|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n260|\t}\n261|}\n262|\n263|// canonicalJSON canonicalizes test scaffolding. It is test-only\n264|// assembly, never a verdict: every verdict comes from production.\n265|func canonicalJSON(t *testing.T, body []byte) []byte {\n266|\tt.Helper()\n267|\tcanonical, err := canonicaljson.Canonicalize(body)\n268|\tif err != nil {\n269|\t\tt.Fatalf(\"canonicalJSON: %v\", err)\n270|\t}\n271|\treturn canonical\n272|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a074a4-ddb9-7301-870e-62d9c91b70f4"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce","run_stream":{"kind":"run","id":"445757ea-edf1-42a4-8d03-75b0e90ee6ce"},"call_id":"call_01a074a6d46b78719a6b6e6ca4b65bcb","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/inventory_test.go`.\n(499 line(s) above)\n500|\t\tfor _, scope := range scopes {\n501|\t\t\tif scope.start <= position && position <= scope.end {\n502|\t\t\t\tif !initialized || scope.start >= bestStart {\n503|\t\t\t\t\tbest, bestStart, initialized = scope.name, scope.start, true\n504|\t\t\t\t}\n505|\t\t\t}\n506|\t\t}\n507|\t\treturn best\n508|\t}\n509|\tfor _, call := range calls {\n510|\t\tarm, err := callArm(call.name, call.call, enclosing(call.position))\n511|\t\tif err != nil {\n512|\t\t\treturn err\n513|\t\t}\n514|\t\tarms[arm] = struct{}{}\n515|\t}\n516|\tfor _, frame := range frames {\n517|\t\tdetail, err := frameDetail(frame)\n518|\t\tif err != nil {\n519|\t\t\treturn err\n520|\t\t}\n521|\t\tarms[\"frame|\"+detail] = struct{}{}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// callArm derives one constructor arm: a string-literal first\n527|// argument is the detail; a literal-plus-fault.detail binary is a\n528|// conduit keyed by function and prefix; anything else is an\n529|// expr obligation keyed by function.\n530|func callArm(constructor string, call *ast.CallExpr, function string) (string, error) {\n531|\tif len(call.Args) == 0 {\n532|\t\treturn \"\", fmt.Errorf(\"constructor %s called with no arguments in %s\", constructor, function)\n533|\t}\n534|\tswitch first := call.Args[0].(type) {\n535|\tcase *ast.BasicLit:\n536|\t\tif first.Kind != token.STRING {\n537|\t\t\treturn \"\", fmt.Errorf(\"constructor %s first argument is not a string in %s\", constructor, function)\n538|\t\t}\n539|\t\tdetail, err := strconv.Unquote(first.Value)\n540|\t\tif err != nil {\n541|\t\t\treturn \"\", err\n542|\t\t}\n543|\t\treturn \"ctor|\" + constructor + \"|\" + detail, nil\n544|\tcase *ast.BinaryExpr:\n545|\t\tprefix, ok := first.X.(*ast.BasicLit)\n546|\t\tif !ok || prefix.Kind != token.STRING {\n547|\t\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n548|\t\t}\n549|\t\ttext, err := strconv.Unquote(prefix.Value)\n550|\t\tif err != nil {\n551|\t\t\treturn \"\", err\n552|\t\t}\n553|\t\treturn \"ctor|\" + constructor + \"|conduit|\" + function + \"|\" + text, nil\n554|\tdefault:\n555|\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n556|\t}\n557|}\n558|\n559|// frameDetail extracts the detail literal from one &frameFault\n560|// composite literal. A non-literal detail is an expr obligation,\n561|// never a silent pass.\n562|func frameDetail(frame *ast.CompositeLit) (string, error) {\n563|\tfor _, element := range frame.Elts {\n564|\t\tpair, ok := element.(*ast.KeyValueExpr)\n565|\t\tif !ok {\n566|\t\t\tcontinue\n567|\t\t}\n568|\t\tkey, ok := pair.Key.(*ast.Ident)\n569|\t\tif !ok || key.Name != \"detail\" {\n570|\t\t\tcontinue\n571|\t\t}\n572|\t\tliteral, ok := pair.Value.(*ast.BasicLit)\n573|\t\tif !ok || literal.Kind != token.STRING {\n574|\t\t\treturn \"expr\", nil\n575|\t\t}\n576|\t\treturn strconv.Unquote(literal.Value)\n577|\t}\n578|\treturn \"\", fmt.Errorf(\"frameFault literal carries no detail\")\n579|}\n580|\n581|// TestConstructorAliasSpellingsFailDerivation replays the four\n582|// alias probes against the derivation gate on synthetic sources:\n583|// a direct constructor call derives cleanly (the control), while\n584|// a package-level `var alias = ctor`, a function-local\n585|// `var alias = ctor`, and an `alias := ctor` all fail the file.\n586|// The package's own `var failX = func...` definition spelling\n587|// stays exempt: only the definition Name is excused, never a\n588|// constructor in value position.\n589|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n590|\tconstructors := map[string]bool{\"failInvalid\": true}\n591|\tderive := func(source string) error {\n592|\t\tt.Helper()\n593|\t\tfileSet := token.NewFileSet()\n594|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n595|\t\tif err != nil {\n596|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n597|\t\t}\n598|\t\treturn collectFileArms(fileSet, syntax, constructors, map[string]struct{}{})\n599|\t}\n600|\tt.Run(\"direct call derives\", func(t *testing.T) {\n601|\t\tif err := derive(\"package probe\\nfunc f() { failInvalid(\\\"planted\\\", \\\"field\\\") }\\n\"); err != nil {\n602|\t\t\tt.Fatalf(\"direct call failed the derivation: %v\", err)\n603|\t\t}\n604|\t})\n605|\tt.Run(\"definition name stays exempt\", func(t *testing.T) {\n606|\t\tif err := derive(\"package probe\\nvar failInvalid = func(detail, field string) (int, error) { return 0, nil }\\n\"); err != nil {\n607|\t\t\tt.Fatalf(\"constructor definition failed the derivation: %v\", err)\n608|\t\t}\n609|\t})\n610|\tfor _, probe := range []struct {\n611|\t\tname   string\n612|\t\tsource string\n613|\t}{\n614|\t\t{\"package level var alias\", \"package probe\\nvar plantedFail = failInvalid\\nfunc f() { plantedFail(\\\"planted\\\", \\\"field\\\") }\\n\"},\n615|\t\t{\"function local var alias\", \"package probe\\nfunc f() { var localFail = failInvalid\\n_ = localFail }\\n\"},\n616|\t\t{\"short declaration alias\", \"package probe\\nfunc f() { localFail := failInvalid\\n_ = localFail }\\n\"},\n617|\t} {\n618|\t\tt.Run(probe.name, func(t *testing.T) {\n619|\t\t\tif err := derive(probe.source); err == nil {\n620|\t\t\t\tt.Fatal(\"aliased constructor passed the derivation with every arm it builds hidden\")\n621|\t\t\t}\n622|\t\t})\n623|\t}\n624|}\n625|\n626|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction:\n627|// every arm derived from production must carry a witness. A\n628|// planted arm (a new literal or site through an existing\n629|// constructor) lands here as an unwitnessed arm.\n630|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n631|\tderived := deriveRefusalArms(t)\n632|\twitnessed := map[string]int{}\n633|\tfor _, witness := range declaredWitnesses(t) {\n634|\t\twitnessed[witness.arm]++\n635|\t}\n636|\tvar missing []string\n637|\tfor arm := range derived {\n638|\t\tif witnessed[arm] == 0 {\n639|\t\t\tmissing = append(missing, arm)\n640|\t\t}\n641|\t}\n642|\tsort.Strings(missing)\n643|\tif len(missing) > 0 {\n644|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n645|\t}\n646|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n647|}\n648|\n649|// TestWitnessedArmsAreAllDerived is the reverse direction: every\n650|// witness must name an arm production declares. A deleted or\n651|// narrowed production branch orphans its witness and fails here,\n652|// which is also what makes a truncated derivation fail instead\n653|// of passing vacuously.\n654|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n655|\tderived := deriveRefusalArms(t)\n656|\tvar orphans []string\n657|\tfor _, witness := range declaredWitnesses(t) {\n658|\t\tif _, ok := derived[witness.arm]; !ok {\n659|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n660|\t\t}\n661|\t}\n662|\tsort.Strings(orphans)\n663|\tif len(orphans) > 0 {\n664|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n665|\t}\n666|}\n667|\n668|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every\n669|// witness through its production entry point and requires the\n670|// attributed refusal.\n671|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n672|\tfor _, witness := range declaredWitnesses(t) {\n673|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n674|\t\t\twitness.prove(t)\n675|\t\t})\n676|\t}\n677|}\n678|\n679|// armWitness is one derived arm plus the test proving it refuses\n680|// at the production entry with the attributed identity.\n681|type armWitness struct {\n682|\tarm   string\n683|\tname  string\n684|\tprove func(t *testing.T)\n685|}\n686|\n687|// declaredWitnesses lists every witness. The group tables live\n688|// in inventory_witnesses_test.go.\n689|func declaredWitnesses(t *testing.T) []armWitness {\n690|\tt.Helper()\n691|\te := witnessFixtureEntries(t)\n692|\twitnesses := []armWitness{}\n693|\twitnesses = append(witnesses, envelopeWitnesses(e)...)\n694|\twitnesses = append(witnesses, manifestWitnesses(e)...)\n695|\twitnesses = append(witnesses, probeWitnesses(e)...)\n696|\twitnesses = append(witnesses, contextWitnesses(e)...)\n697|\twitnesses = append(witnesses, tupleWitnesses(e)...)\n698|\twitnesses = append(witnesses, operationWitnesses(e)...)\n699|\twitnesses = append(witnesses, gateWitnesses(e)...)\n700|\twitnesses = append(witnesses, frameWitnesses(e)...)\n701|\twitnesses = append(witnesses, conduitWitnesses(e)...)\n702|\treturn witnesses\n703|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
