+		requireRefusal(t, err, "session_adapter_protocol_error", "member", "warnings", "sorted unique")
+	})
+	t.Run("warning too long", func(t *testing.T) {
+		_, err := DecodeProbe(mutateMember(t, fixture, "warnings", `["`+strings.Repeat("w", 2049)+`"]`))
+		requireRefusal(t, err, "session_adapter_protocol_error", "member", "warnings", "sorted unique")
