{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f9b7","stream":{"kind":"session","id":"01a073c4-c6ec-7382-9783-190de4ee11a6"},"sequence":6966,"recorded_at":1780531400013927,"record_type":"event","durability":"durable","causation_id":"a5409c77-5362-4816-80c2-4a2c06765e09","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5409c77-5362-4816-80c2-4a2c06765e09","run_stream":{"kind":"run","id":"a5409c77-5362-4816-80c2-4a2c06765e09"},"task_stream":{"kind":"task","id":"42cb3c8b-cf86-4b67-abe8-23702a2e3940"},"task_id":"42cb3c8b-cf86-4b67-abe8-23702a2e3940","event":{"kind":"output","task_id":"42cb3c8b-cf86-4b67-abe8-23702a2e3940","chunk":"{\n  \"chunk_id\": \"exec-242-1\",\n  \"command\": \"task-board q 'schema(mutation=set_status)' 2>&1 | head -20; task-board m --help 2>&1 | head -30\",\n  \"description\": \"Show mutation syntax options\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\\"description\\\":\\\"Change element status with auto-promotion and escalation\\\",\\\"destructive\\\":false,\\\"examples\\\":[\\\"set_status(TASK-260218-abc123, status=development)\\\",\\\"set_status(STORY-260218-abc123, status=done, commit_ack=scope_committed)\\\"],\\\"idempotent\\\":true,\\\"kind\\\":\\\"mutation\\\",\\\"name\\\":\\\"set_status\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"New status\\\",\\\"enum\\\":[\\\"backlog\\\",\\\"analysis\\\",\\\"to-dev\\\",\\\"development\\\",\\\"to-review\\\",\\\"reviewing\\\",\\\"integrating\\\",\\\"done\\\",\\\"closed\\\",\\\"blocked\\\"],\\\"required\\\":true},{\\\"name\\\":\\\"commit_ack\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Mover acknowledgement required by version_control.confirm for Bug/Story done transitions\\\"},{\\\"name\\\":\\\"txn_id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Integration transaction token presented to satisfy a transition lease; it authorizes nothing else\\\"}],\\\"signature\\\":\\\"set_status(id:string, status:string{backlog|analysis|to-dev|development|to-review|reviewing|integrating|done|closed|blocked}, commit_ack?:string, txn_id?:string)\\\"}\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\n\",\n  \"original_output_bytes\": 2975,\n  \"original_output_tokens\": 744,\n  \"truncated\": false\n}"}}}
