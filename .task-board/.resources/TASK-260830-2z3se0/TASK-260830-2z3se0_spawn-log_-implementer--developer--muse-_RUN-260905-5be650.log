{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c601","stream":{"kind":"session","id":"01a073c4-c6ec-7382-9783-190de4ee11a6"},"sequence":347,"recorded_at":1780531400000689,"record_type":"event","durability":"durable","causation_id":"a5409c77-5362-4816-80c2-4a2c06765e09","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5409c77-5362-4816-80c2-4a2c06765e09","run_stream":{"kind":"run","id":"a5409c77-5362-4816-80c2-4a2c06765e09"},"task_stream":{"kind":"task","id":"1afa1532-4ba1-47db-8c67-f36952ac392e"},"task_id":"1afa1532-4ba1-47db-8c67-f36952ac392e","event":{"kind":"output","task_id":"1afa1532-4ba1-47db-8c67-f36952ac392e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/provhost/manifest.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|)\n7|\n8|// This file validates the Section 7.3 Provider Manifest: the closed\n9|// urn:ax:schema:provider-manifest 1.0.0 object a manifest operation\n10|// returns as its success body. The manifest declares possible surfaces,\n11|// not runtime availability; every member below is required and the\n12|// object is closed.\n13|\n14|// manifestSchema is the exact schema identifier the manifest carries.\n15|const manifestSchema = \"urn:ax:schema:provider-manifest\"\n16|\n17|// manifestSchemaVersion is the only manifest version this host accepts.\n18|const manifestSchemaVersion = \"1.0.0\"\n19|\n20|// capabilityOrder is the exact seven-name ordered capability registry\n21|// Section 7.3 shows. The manifest and every probe body carry exactly\n22|// these names in this order; an eighth name advertises a surface the\n23|// contract never defined, and a missing name hides one it did.\n24|var capabilityOrder = []string{\n25|\t\"native_resume\",\n26|\t\"portable_store\",\n27|\t\"managed_pty\",\n28|\t\"appserver\",\n29|\t\"task_board_primary\",\n30|\t\"prompt_spawn\",\n31|\t\"native_goal_binding\",\n32|}\n33|\n34|// Capabilities returns the Section 7.3 capability registry in order.\n35|// The result is a copy; the registry cannot be mutated through it.\n36|func Capabilities() []string {\n37|\treturn append([]string(nil), capabilityOrder...)\n38|}\n39|\n40|// manifestPlatforms is the closed platform vocabulary Section 7.3\n41|// allows: a sorted, unique, non-empty subset of these four.\n42|var manifestPlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n43|\n44|// semverPattern is the SemVer grammar plugin_version and adapter\n45|// versions satisfy: three dot-separated non-negative integers with no\n46|// leading zeros, an optional pre-release, and optional build metadata.\n47|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n48|\n49|// providerIDPattern is the Section 7.1 provider-id grammar the\n50|// manifest and identity layers read: [a-z][a-z0-9-]{0,31}.\n51|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n52|\n53|// manifestMembers is the exact required member set DecodeManifest\n54|// accepts: the schema envelope, identity, versioning, platforms, the\n55|// Section 7.5 operation registry in manifest order, and the capability\n56|// registry above.\n57|var manifestMembers = map[string]bool{\n58|\t\"schema\":                 true,\n59|\t\"schema_version\":         true,\n60|\t\"provider_id\":            true,\n61|\t\"display_name\":           true,\n62|\t\"plugin_version\":         true,\n63|\t\"provider_version_range\": true,\n64|\t\"platforms\":              true,\n65|\t\"operations\":             true,\n66|\t\"capability_names\":       true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"display_name\",\n76|\t\"plugin_version\",\n77|\t\"provider_version_range\",\n78|\t\"platforms\",\n79|\t\"operations\",\n80|\t\"capability_names\",\n81|}\n82|\n83|// DecodeManifest validates one manifest-operation success body as the\n84|// closed Section 7.3 Provider Manifest. It returns nil on a\n85|// well-formed manifest and a provider_protocol_error naming the\n86|// offending member otherwise. A manifest whose operations differ from\n87|// the dispatch registry, or whose capability names differ from the\n88|// registry above, advertises a surface the host cannot invoke or hides\n89|// one it must, so both are refused outright.\n90|func DecodeManifest(body []byte) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"manifest carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, manifestRequired); missing {\n107|\t\tfailure, err := failProtocol(\"manifest misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n114|\t\tfailure, err := failProtocol(\"manifest schema is not the provider manifest\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n(more lines below)"}}}
