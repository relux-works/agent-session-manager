) 1 [('internal/sessadapter/operations.go', 555, 'projection required dispositions ')]\\n  ('failProtocol', 'decodeCapabilities') 1 [('internal/sessadapter/probe.go', 294, 'adapter capabilities ')]\\n  ('failProtocol', 'decodeCapabilityValue') 1 [('internal/sessadapter/probe.go', 93, 'adapter capability ')]\\n  ('failProtocol', 'decodeFidelityLimits') 1 [('internal/sessadapter/tuple.go', 699, 'tuple fidelity limit ')]\\n  ('failProtocol', 'decodeFixtureEvidence') 1 [('internal/sessadapter/tuple.go', 471, 'tuple fixture evidence ')]\\n  ('failProtocol', 'decodeSmokeEvidence') 1 [('internal/sessadapter/tuple.go', 583, 'tuple resume smoke ')]\\n  ('failProtocol', 'decodeTupleKey') 1 [('internal/sessadapter/tuple.go', 287, 'tuple registry key ')]\\n  ('failProtocol', 'requireNestedObject') 1 [('internal/sessadapter/operations.go', 114, 'operation body nested object ')]\\n\",\n  \"original_output_bytes\": 3073,\n  \"original_output_tokens\": 769,\n  \"truncated\": false\n}"}}}
