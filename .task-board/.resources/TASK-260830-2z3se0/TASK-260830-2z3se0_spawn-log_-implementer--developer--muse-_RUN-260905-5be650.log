not be mutated through it.\n36|func Capabilities() []string {\n37|\treturn append([]string(nil), capabilityOrder...)\n38|}\n39|\n40|// manifestPlatforms is the closed platform vocabulary Section 7.3\n41|// allows: a sorted, unique, non-empty subset of these four.\n42|var manifestPlatforms = []string{\"linux\", \"macos\", \"windows\", \"wsl2\"}\n43|\n44|// semverPattern is the SemVer grammar plugin_version and adapter\n45|// versions satisfy: three dot-separated non-negative integers with no\n46|// leading zeros, an optional pre-release, and optional build metadata.\n47|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n48|\n49|// providerIDPattern is the Section 7.1 provider-id grammar the\n50|// manifest and identity layers read: [a-z][a-z0-9-]{0,31}.\n51|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n52|\n53|// manifestMembers is the exact required member set DecodeManifest\n54|// accepts: the schema envelope, identity, versioning, platforms, the\n55|// Section 7.5 operation registry in manifest order, and the capability\n56|// registry above.\n57|var manifestMembers = map[string]bool{\n58|\t\"schema\":                 true,\n59|\t\"schema_version\":         true,\n60|\t\"provider_id\":            true,\n61|\t\"display_name\":           true,\n62|\t\"plugin_version\":         true,\n63|\t\"provider_version_range\": true,\n64|\t\"platforms\":              true,\n65|\t\"operations\":             true,\n66|\t\"capability_names\":       true,\n67|}\n68|\n69|// manifestRequired lists manifestMembers in a fixed order so a body\n70|// missing several members always names the same one.\n71|var manifestRequired = []string{\n72|\t\"schema\",\n73|\t\"schema_version\",\n74|\t\"provider_id\",\n75|\t\"display_name\",\n76|\t\"plugin_version\",\n77|\t\"provider_version_range\",\n78|\t\"platforms\",\n79|\t\"operations\",\n80|\t\"capability_names\",\n81|}\n82|\n83|// DecodeManifest validates one manifest-operation success body as the\n84|// closed Section 7.3 Provider Manifest. It returns nil on a\n85|// well-formed manifest and a provider_protocol_error naming the\n86|// offending member otherwise. A manifest whose operations differ from\n87|// the dispatch registry, or whose capability names differ from the\n88|// registry above, advertises a surface the host cannot invoke or hides\n89|// one it must, so both are refused outright.\n90|func DecodeManifest(body []byte) error {\n91|\tmembers, fault := decodeStrictObject(body)\n92|\tif fault != nil {\n93|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n94|\t\tif err != nil {\n95|\t\t\treturn err\n96|\t\t}\n97|\t\treturn failure\n98|\t}\n99|\tif name, unknown := unknownMember(members, manifestMembers); unknown {\n100|\t\tfailure, err := failProtocol(\"manifest carries unknown member\", name)\n101|\t\tif err != nil {\n102|\t\t\treturn err\n103|\t\t}\n104|\t\treturn failure\n105|\t}\n106|\tif name, missing := missingMember(members, manifestRequired); missing {\n107|\t\tfailure, err := failProtocol(\"manifest misses a required member\", name)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != manifestSchema {\n114|\t\tfailure, err := failProtocol(\"manifest schema is not the provider manifest\", \"schema\")\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != manifestSchemaVersion {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c607","stream":{"kind":"session","id":"01a073c4-c6ec-7382-9783-190de4ee11a6"},"sequence":350,"recorded_at":1780531400000695,"record_type":"event","durability":"durable","causation_id":"a5409c77-5362-4816-80c2-4a2c06765e09","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a5409c77-5362-4816-80c2-4a2c06765e09","run_stream":{"kind":"run","id":"a5409c77-5362-4816-80c2-4a2c06765e09"},"call_id":"call_01a073c584177803bf7a189f0911bce8","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/provhost/idempotency.go`.\n1|package provhost\n2|\n3|// This file owns the single Provider protocol 2.0.0 idempotency key\n4|// (operation, operation_id). Every provider mutation request that\n5|// carries operation_id uses this key and no other: an identical\n6|// canonical mutation request MUST return a byte-identical result\n7|// across a fresh plugin process, and any changed member is\n8|// idempotency_mismatch with no new mutation. There is no second\n9|// tuple- or path-based key in provider protocol 2.0.0, so this file\n10|// defines exactly one key type and exactly one keyed-operation set.\n11|\n12|// keyedOperations lists the operations whose request bodies carry\n13|// operation_id in the Section 7.5 registry: the four materialization\n14|// mutations plus fork, whose operation ID is the Session Record's\n15|// fork_provenance.operation_id. Fork is side-effect-free, but an\n16|// identical retry still returns the same plan and a changed body is\n17|// still idempotency_mismatch, so it carries the key. Status reads\n18|// omit operation_id by construction and are evolving reads, never\n19|// receipts.\n20|var keyedOperations = []Operation{\n21|\tOpCapture,\n22|\tOpMaterialize,\n23|\tOpMaterializeCommit,\n24|\tOpMaterializeRollback,\n25|\tOpFork,\n26|}\n27|\n28|// MutationOperations returns the operations keyed by\n29|// (operation, operation_id), in registry order. The result is a copy;\n30|// the set cannot be mutated through it.\n31|func MutationOperations() []Operation {\n32|\treturn append([]Operation(nil), keyedOperations...)\n33|}\n34|\n35|// isKeyedOperation reports whether the operation carries an\n36|// operation_id mutation key.\n37|func isKeyedOperation(operation Operation) bool {\n38|\tfor _, keyed := range keyedOperations {\n39|\t\tif operation == keyed {\n40|\t\t\treturn true\n41|\t\t}\n42|\t}\n43|\treturn false\n44|}\n45|\n46|// IdempotencyKey is the sole provider mutation deduplication key:\n47|// the operation tag plus the caller-supplied operation ID. One\n48|// operation ID used by the materialize family identifies exactly one\n49|// materialization transaction, and reusing the mutation value across\n50|// distinct operation tags does not alias their recorded results,\n51|// because the tag is part of the key.\n52|type IdempotencyKey struct {\n53|\toperation   Operation\n54|\toperationID string\n55|}\n56|\n57|// Operation reports the mutation tag the key was issued for.\n58|func (key IdempotencyKey) Operation() Operation {\n59|\treturn key.operation\n60|}\n61|\n62|// OperationID reports the caller-supplied operation ID the key was\n63|// issued for.\n64|func (key IdempotencyKey) OperationID() string {\n65|\treturn key.operationID\n66|}\n67|\n68|// String renders the key in the Section 7.5 (operation,\n69|// operation_id) form.\n70|func (key IdempotencyKey) String() string {\n71|\treturn \"(\" + string(key.operation) + \", \" + key.operationID + \")\"\n72|}\n73|\n74|// IdempotencyKeyFor issues the mutation key for one operation tag and\n75|// one caller-supplied operation ID. An unknown operation, an\n76|// operation that carries no operation_id, and a non-UUIDv7 operation\n77|// ID are invalid_config caller errors: a retry under a forged,\n78|// mistagged, or unkeyed identity is not a retry at all.\n79|func IdempotencyKeyFor(operation Operation, operationID string) (IdempotencyKey, error) {\n80|\tif !validOperation(string(operation)) {\n81|\t\tfailure, err := failInvalid(\"idempotency key names an unknown operation\")\n82|\t\tif err != nil {\n83|\t\t\treturn IdempotencyKey{}, err\n84|\t\t}\n85|\t\treturn IdempotencyKey{}, failure\n86|\t}\n87|\tif !isKeyedOperation(operation) {\n88|\t\tfailure, err := failInvalid(\"idempotency key names an operation without operation_id\")\n89|\t\tif err != nil {\n90|\t\t\treturn IdempotencyKey{}, err\n91|\t\t}\n92|\t\treturn IdempotencyKey{}, failure\n93|\t}\n94|\tif !isUUIDv7(operationID) {\n95|\t\tfailure, err := failInvalid(\"idempotency operation_id is not a UUIDv7\")\n96|\t\tif err != nil {\n97|\t\t\treturn IdempotencyKey{}, err\n98|\t\t}\n99|\t\treturn IdempotencyKey{}, failure\n100|\t}\n101|\treturn IdempotencyKey{operation: operation, operationID: operationID}, nil\n102|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
