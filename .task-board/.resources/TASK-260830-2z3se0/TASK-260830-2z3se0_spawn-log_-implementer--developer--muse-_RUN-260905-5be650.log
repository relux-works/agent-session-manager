space_filter\", \"unknown member\")\n+\t}\n","edit_facts":{"tool_name":"edit_file","path":"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/operations_derived_test.go","added":20,"removed":7},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
