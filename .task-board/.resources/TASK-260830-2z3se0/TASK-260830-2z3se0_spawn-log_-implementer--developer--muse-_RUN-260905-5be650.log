{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88d","stream":{"kind":"session","id":"01a073c4-c6ec-7382-9783-190de4ee11a6"},"sequence":673,"recorded_at":1780531400001341,"record_type":"event","durability":"durable","causation_id":"a5409c77-5362-4816-80c2-4a2c06765e09","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5409c77-5362-4816-80c2-4a2c06765e09","run_stream":{"kind":"run","id":"a5409c77-5362-4816-80c2-4a2c06765e09"},"task_stream":{"kind":"task","id":"ed09ba64-0283-4e80-94c8-a87226e4d417"},"task_id":"ed09ba64-0283-4e80-94c8-a87226e4d417","event":{"kind":"output","task_id":"ed09ba64-0283-4e80-94c8-a87226e4d417","chunk":"{\n  \"chunk_id\": \"exec-26-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nreg=json.load(open('internal/traceability/ownership.v0.5.0.json'))\\nfor g in reg['ownership']:\\n    p=(g.get('production') or {})\\n    if 'provhost' in str(p) or 'terminalbackend' in str(p):\\n        print(g.get('kind'), '|', g.get('keys'), '|', p, '|', g.get('acceptance_cases'), '|', g.get('coverage',''), '|', str(g.get('gap',''))[:150])\\n\\\"; echo ===; ls internal/traceability/cmd/tracecheck/; grep -n \\\"assigned-scope\\\\|assigned_scope\\\\|AssignedScope\\\\|unowned\\\" internal/traceability/traceability.go | head -n 20\",\n  \"description\": \"See how provhost registers ownership\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"section_binding | ['section:7.6'] | {'path': 'internal/provhost/quiesce.go', 'declaration': 'DecodeQuiesceProof'} | ['provhost-quiesce-proof'] | unevidenced | DecodeQuiesceProof implements the Section 7.6 quiescence proof decoder with its fail-closed safe-bit rules; the Provider Identity Record it carries is\\nsection_binding | ['section:7.7'] | {'path': 'internal/provhost/profile.go', 'declaration': 'ProfileMapping'} | ['provhost-profile-mapping'] | unevidenced | ProfileMapping implements the Section 7.7 execution-profile mapping as a closed six-provider vocabulary with unknown-profile refusal; version probing \\nsection_binding | ['section:8'] | {'path': 'internal/provhost/probe.go', 'declaration': 'RequireCapability'} | ['provhost-capability-gate'] | unevidenced | RequireCapability implements the Section 8 fail-closed capability gate direction (conditional, unsupported, and unknown surfaces are never usable) wit\\n===\\nmain_test.go\\nmain.go\\n56:\\tAssignedScopes         int\\n89:\\tUnownedSections []unownedSection `json:\\\"unowned_sections\\\"`\\n92:// unownedSection records a real v0.5.0 section that this repository does not\\n97:// assigned-scope admission refuses an unowned section and prints its gap.\\n98:type unownedSection struct {\\n161:\\t// refused for assigned-scope admission.\\n209:// pinned top-level source owner alone never satisfies assigned-scope admission.\\n365:\\t// unowned disclosure to dodge the catalog's owner requirement is reported\\n375:\\tunowned, err := verifyUnownedSections(\\n388:\\t\\t\\tif entry, disclosed := unowned[key]; disclosed {\\n390:\\t\\t\\t\\t\\t\\\"assigned section %q binding %q is recorded unowned: %s\\\", binding.Scope, key, entry.Gap)\\n404:\\t\\t\\t\\t\\t\\\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\\\",\\n432:\\t\\tAssignedScopes:         len(assignedBindings),\\n434:\\t\\tUnownedSections:        len(unowned),\\n1250:\\tentries []unownedSection,\\n1254:) (map[string]unownedSection, error) {\\n1255:\\tresult := make(map[string]unownedSection, len(entries))\\n1258:\\t\\t\\treturn nil, fail(\\\"unowned section %d has an empty key\\\", index)\\n1261:\\t\\t\\treturn nil, fail(\\\"duplicate unowned section %q\\\", entry.Key)\\n1264:\\t\\t\\treturn nil, fail(\\\"unowned section %q is self-minted for an unknown section\\\", entry.Key)\\n\",\n  \"original_output_bytes\": 2255,\n  \"original_output_tokens\": 564,\n  \"truncated\": false\n}"}}}
