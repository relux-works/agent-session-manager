ations()\\n361-\\tif fmt.Sprintf(\\\"%v\\\", got) != fmt.Sprintf(\\\"%v\\\", derived) {\\n362-\\t\\tt.Fatalf(\\\"Operations() = %v, want the Section 7.5 table %v\\\", got, derived)\\n363-\\t}\\n364-\\tt.Logf(\\\"operation registry coverage: %d/%d table entries dispatched\\\", len(got), len(derived))\\n365-}\\n366-\\n367-// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\\n368-// package implements: the framing limits, the process model, the\\n369-// envelope shapes, the closed-member rule, and the deadline/redaction\\n370-// duties.\\n371-func TestSection72FramingIsPinned(t *testing.T) {\\n372-\\tdocument, err := specdoc.Load()\\n373-\\tif err != nil {\\n374-\\t\\tt.Fatalf(\\\"specdoc.Load: %v\\\", err)\\n375-\\t}\\n376-\\tfor _, excerpt := range []string{\\n377-\\t\\t\\\"Each line MUST be one complete UTF-8\\\",\\n378-\\t\\t\\\"JSON object no larger than 8 MiB\\\",\\n379-\\t\\t\\\"Stdout MUST contain protocol frames only\\\",\\n380-\\t\\t\\\"human diagnostics go to stderr\\\",\\n381-\\t\\t\\\"starts one plugin process per operation\\\",\\n382-\\t\\t\\\"After one response, <code>ax</code> closes stdin and the\\\",\\n383-\\t\\t\\\"Exit 0 requires a successful response\\\",\\n384-\\t\\t\\\"A structured error\\\",\\n385-\\t\\t\\\"response SHOULD exit 0 because the protocol succeeded\\\",\\n386-\\t\\t\\\"a crash, invalid frame,\\\",\\n387-\\t\\t\\\"or missing response is a provider-host failure\\\",\\n388-\\t\\t\\\"The deadline MUST be in the future when the host writes the frame\\\",\\n389-\\t\\t\\\"A failure envelope contains\\\",\\n390-\\t\\t\\\"and MUST NOT contain <code>body</code>\\\",\\n391-\\t\\t\\\"Envelope and body\\\",\\n392-\\t\\t\\\"unknown members are protocol errors under major version 2\\\",\\n393-\\t\\t\\\"The host MUST terminate a plugin that exceeds its deadline and report\\\",\\n394-\\t\\t\\\"<code>provider_timeout</code>\\\",\\n395-\\t\\t\\\"It MUST redact environment and stderr before\\\",\\n396-\\t\\t\\\"logging\\\",\\n397-\\t} {\\n398-\\t\\trequireQuote(t, document, excerpt, \\\"7.2\\\")\\n399-\\t}\\n400-}\\n401-\\n402-// TestSection151ProviderRowIsPinned quotes the Section 15.1 provider\\n403-// row behind the local failure mapping: recognizable majors yield\\n404-// incompatible_protocol, everything else unusable yields\\n405-// provider_protocol_error, and a different major's payload is never\\n\",\n  \"original_output_bytes\": 2895,\n  \"original_output_tokens\": 724,\n  \"truncated\": false\n}"}}}
