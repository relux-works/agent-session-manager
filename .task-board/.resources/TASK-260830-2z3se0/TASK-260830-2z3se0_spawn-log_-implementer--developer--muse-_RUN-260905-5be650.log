{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd87","stream":{"kind":"session","id":"01a073c4-c6ec-7382-9783-190de4ee11a6"},"sequence":3358,"recorded_at":1780531400006711,"record_type":"event","durability":"durable","causation_id":"a5409c77-5362-4816-80c2-4a2c06765e09","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5409c77-5362-4816-80c2-4a2c06765e09","run_stream":{"kind":"run","id":"a5409c77-5362-4816-80c2-4a2c06765e09"},"task_stream":{"kind":"task","id":"2da88372-59aa-4f2a-a228-a95a7a7d6ffe"},"task_id":"2da88372-59aa-4f2a-a228-a95a7a7d6ffe","event":{"kind":"output","task_id":"2da88372-59aa-4f2a-a228-a95a7a7d6ffe","chunk":"edited\nchanged lines: lines 208-234\n--- original\n+++ updated\n@@\n-// CheckContextEcho requires the success body to carry the request\n-// context byte-for-byte: Section 7.8 states every success echoes\n-// the context exactly. A rebuilt context — even a semantically\n-// equal one — is a protocol error, because only byte identity\n-// proves the adapter answered this call.\n-func CheckContextEcho(sent CallContext, echoed json.RawMessage) (CallContext, error) {\n-\treceived, err := DecodeCallContext(echoed)\n-\tif err != nil {\n-\t\treturn CallContext{}, err\n-\t}\n-\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(echoed))\n-\tif err != nil {\n-\t\tfailure, faultErr := failProtocol(\"success context is not canonical JSON\", \"context\")\n-\t\tif faultErr != nil {\n-\t\t\treturn CallContext{}, faultErr\n-\t\t}\n-\t\treturn CallContext{}, failure\n-\t}\n-\tif !bytes.Equal(canonical, sent.raw) {\n-\t\tfailure, err := failProtocol(\"success context does not echo the request context byte-for-byte\", \"context\")\n-\t\tif err != nil {\n-\t\t\treturn CallContext{}, err\n-\t\t}\n-\t\treturn CallContext{}, failure\n-\t}\n-\treturn received, nil\n-}\n+// CheckContextEcho requires the success body to carry the request\n+// context byte-for-byte: Section 7.8 states every success echoes\n+// the context exactly. A rebuilt context — even a semantically\n+// equal one — is a protocol error, because only byte identity\n+// proves the adapter answered this call. DecodeCallContext\n+// already returns the canonical bytes, so the comparison reuses\n+// them: a second canonicalization of the same bytes could only\n+// repeat its verdict, and an arm that cannot fire is not\n+// carried.\n+func CheckContextEcho(sent CallContext, echoed json.RawMessage) (CallContext, error) {\n+\treceived, err := DecodeCallContext(echoed)\n+\tif err != nil {\n+\t\treturn CallContext{}, err\n+\t}\n+\tif !bytes.Equal(received.raw, sent.raw) {\n+\t\tfailure, err := failProtocol(\"success context does not echo the request context byte-for-byte\", \"context\")\n+\t\tif err != nil {\n+\t\t\treturn CallContext{}, err\n+\t\t}\n+\t\treturn CallContext{}, failure\n+\t}\n+\treturn received, nil\n+}\n"}}}
