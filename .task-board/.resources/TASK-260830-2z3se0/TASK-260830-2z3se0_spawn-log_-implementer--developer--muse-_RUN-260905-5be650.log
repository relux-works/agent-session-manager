{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dab5","stream":{"kind":"session","id":"01a073c4-c6ec-7382-9783-190de4ee11a6"},"sequence":2997,"recorded_at":1780531400005989,"record_type":"event","durability":"durable","causation_id":"a5409c77-5362-4816-80c2-4a2c06765e09","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a5409c77-5362-4816-80c2-4a2c06765e09","run_stream":{"kind":"run","id":"a5409c77-5362-4816-80c2-4a2c06765e09"},"task_stream":{"kind":"task","id":"048891a6-6f1a-40fb-969b-3c798cc487c7"},"task_id":"048891a6-6f1a-40fb-969b-3c798cc487c7","event":{"kind":"output","task_id":"048891a6-6f1a-40fb-969b-3c798cc487c7","chunk":"{\n  \"chunk_id\": \"exec-92-1\",\n  \"command\": \"python3 -c \\\"\\nimport re, glob\\narms = {}\\nconduits = 0\\nfor path in glob.glob('internal/sessadapter/*.go'):\\n    if path.endswith('_test.go'): continue\\n    for line in open(path):\\n        m = re.search(r'(fail[A-Za-z]*)\\\\(\\\\\\\"', line)\\n        if not m or 'var fail' in line: continue\\n        ctor = m.group(1)\\n        rest = line[m.end():]\\n        if rest.startswith('\\\\\\\"+') or ('+fault.detail' in rest[:80] and not re.match(r'[^\\\\\\\"]*\\\\\\\"', rest)):\\n            conduits += 1\\n            continue\\n        mm = re.match(r'((?:[^\\\\\\\"\\\\\\\\\\\\\\\\]|\\\\\\\\\\\\\\\\.)*)\\\\\\\"', rest)\\n        if mm:\\n            detail = mm.group(1)\\n            # check if followed by more string concat (conduit)\\n            arms.setdefault((ctor, detail), []).append(path)\\n        else:\\n            conduits += 1\\nfrom collections import Counter\\nprint('unique literal arms:', len(arms))\\ndups = {k: v for k, v in arms.items() if len(v) > 1}\\nprint('duplicated (ctor,detail):', len(dups))\\nfor k, v in sorted(dups.items()):\\n    print(' ', k, v)\\nprint('conduit sites:', conduits)\\n\\\"\",\n  \"description\": \"Count unique literal arms and duplicates\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"unique literal arms: 316\\nduplicated (ctor,detail): 8\\n  ('failProtocol', 'operation body digest member is not a digest') ['internal/sessadapter/operations.go', 'internal/sessadapter/operations.go']\\n  ('failProtocol', 'request body ') ['internal/sessadapter/protocol.go', 'internal/sessadapter/operations.go']\\n  ('failProtocol', 'success body ') ['internal/sessadapter/protocol.go', 'internal/sessadapter/operations.go']\\n  ('failProtocol', 'tuple entry revocation time is not a timestamp') ['internal/sessadapter/tuple.go', 'internal/sessadapter/tuple.go']\\n  ('failProtocol', 'tuple entry valid_from is not a timestamp') ['internal/sessadapter/tuple.go', 'internal/sessadapter/tuple.go']\\n  ('failProtocol', 'tuple entry valid_until is not a timestamp') ['internal/sessadapter/tuple.go', 'internal/sessadapter/tuple.go']\\n  ('failProtocol', 'tuple fixture execution time is not a timestamp') ['internal/sessadapter/tuple.go', 'internal/sessadapter/tuple.go']\\n  ('failProtocol', 'tuple resume smoke execution time is not a timestamp') ['internal/sessadapter/tuple.go', 'internal/sessadapter/tuple.go']\\nconduit sites: 0\\n\",\n  \"original_output_bytes\": 1114,\n  \"original_output_tokens\": 279,\n  \"truncated\": false\n}"}}}
