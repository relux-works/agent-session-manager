ects are addressed only by their exact\")\n+\t\tif !ok {\n+\t\t\tt.Fatal(\"Section 7.8 registry table window not found\")\n+\t\t}\n+\t\tvar line string\n+\t\tfor _, candidate := range strings.Split(table, \"\\n\") {\n+\t\t\tif strings.HasPrefix(candidate, row) {\n+\t\t\t\tline = candidate\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tif line == \"\" {\n+\t\t\tt.Fatalf(\"spec row %q not found\", row)\n+\t\t}\n"}}}
