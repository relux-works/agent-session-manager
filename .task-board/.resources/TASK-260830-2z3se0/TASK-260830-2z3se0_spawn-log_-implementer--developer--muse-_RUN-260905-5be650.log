 3 obligations it carries.\\\"\\n}\\n======\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.8\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.8; no clause of 7.8 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\\\"\\n}\\n======\\nacceptance case sample:\\n{\\n \\\"id\\\": \\\"source-pin-exact\\\",\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/specpin/pin.go\\\",\\n  \\\"declaration\\\": \\\"Current\\\"\\n },\\n \\\"tests\\\": [\\n  {\\n   \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n   \\\"declaration\\\": \\\"TestCurrentPinsPublishedV050Source\\\"\\n  }\\n ]\\n}\\n---\\n{\\n \\\"id\\\": \\\"source-pin-refusal\\\",\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/specpin/pin.go\\\",\\n  \\\"declaration\\\": \\\"Verify\\\"\\n },\\n \\\"tests\\\": [\\n  {\\n   \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n   \\\"declaration\\\": \\\"TestVerifyRejectsIdentityAndContractDrift\\\"\\n  },\\n  {\\n   \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n   \\\"declaration\\\": \\\"TestVerifyRejectsPartialMalformedAndByteDifferentReads\\\"\\n  }\\n ]\\n}\\n---\\n{\\n \\\"id\\\": \\\"source-pin-compatibility\\\",\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/specpin/pin.go\\\",\\n  \\\"declaration\\\": \\\"ContractsForRelease\\\"\\n },\\n \\\"tests\\\": [\\n  {\\n   \\\"path\\\": \\\"internal/specpin/pin_test.go\\\",\\n   \\\"declaration\\\": \\\"TestContractsForReleasePreservesV043Compatibility\\\"\\n  }\\n ]\\n}\\n---\\n\",\n  \"original_output_bytes\": 1986,\n  \"original_output_tokens\": 497,\n  \"truncated\": false\n}"}}}
