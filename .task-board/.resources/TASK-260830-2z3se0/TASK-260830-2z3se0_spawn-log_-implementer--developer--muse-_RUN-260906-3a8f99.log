{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c569","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":271,"recorded_at":1780531400000537,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"a197b761-6fc3-4a30-90f8-dcf862445b01"},"task_id":"a197b761-6fc3-4a30-90f8-dcf862445b01","event":{"kind":"output","task_id":"a197b761-6fc3-4a30-90f8-dcf862445b01","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.8 closed\n15|// body. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing\n18|// every arm. A helper that fronted a constructor would collapse\n19|// distinct rules into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer:\n22|// Section 7.8 counts and limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// frameFault is one strict-decode failure: what was wrong and which\n26|// member it was found in, if any. It never carries foreign bytes.\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|// decodeStrictObject parses one complete JSON object with duplicate\n33|// member rejection. It is the only JSON entry point in this package:\n34|// every body crosses it before any member is read. A non-UTF-8\n35|// frame, a lone surrogate escape, a non-object top level, a\n36|// duplicated member, or trailing data is a fault, never a partial\n37|// object the caller could mistake for a result.\n38|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n39|\tif !utf8.Valid(data) {\n40|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n41|\t}\n42|\tif hasLoneSurrogateEscape(data) {\n43|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n44|\t}\n45|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n46|\ttoken, err := decoder.Token()\n47|\tif err != nil {\n48|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n49|\t}\n50|\tdelim, ok := token.(json.Delim)\n51|\tif !ok || delim != '{' {\n52|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n53|\t}\n54|\tmembers := map[string]json.RawMessage{}\n55|\tfor decoder.More() {\n56|\t\tkeyToken, err := decoder.Token()\n57|\t\tif err != nil {\n58|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n59|\t\t}\n60|\t\tkey, ok := keyToken.(string)\n61|\t\tif !ok {\n62|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n63|\t\t}\n64|\t\tif _, duplicate := members[key]; duplicate {\n65|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n66|\t\t}\n67|\t\tvar raw json.RawMessage\n68|\t\tif err := decoder.Decode(&raw); err != nil {\n69|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n70|\t\t}\n71|\t\tmembers[key] = raw\n72|\t}\n73|\tif token, err := decoder.Token(); err != nil {\n74|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n75|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n76|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n77|\t}\n78|\tif _, err := decoder.Token(); err != io.EOF {\n79|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n80|\t}\n81|\treturn members, nil\n82|}\n83|\n84|// hasLoneSurrogateEscape reports whether the raw frame carries a\n85|// UTF-16 escape the JSON string grammar cannot pair: a high\n86|// surrogate not followed by a low surrogate, a low surrogate with no\n87|// high surrogate before it, or a truncated escape. Go's encoding/json\n88|// would otherwise replace the lone escape with U+FFFD silently, so\n89|// Section 1.6 wire bodies carrying lone surrogates would be admitted\n90|// with rewritten bytes. This is a local copy of the shared surrogate\n91|// rule because the shared implementation is unexported; the agreement\n92|// test pins it against canonicaljson.Canonicalize over a generated\n93|// escape corpus whose verdicts come from construction, not from\n94|// either implementation.\n95|func hasLoneSurrogateEscape(data []byte) bool {\n96|\tfor index := 0; index < len(data); index++ {\n97|\t\tif data[index] != '\\\\' {\n98|\t\t\tcontinue\n99|\t\t}\n100|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n101|\t\t\tcontinue\n102|\t\t}\n103|\t\tfirst, length := readUTF16Escape(data, index+2)\n104|\t\tif length < 0 {\n105|\t\t\treturn true\n106|\t\t}\n107|\t\tindex += 1 + length\n108|\t\tif first >= 0xD800 && first <= 0xDBFF {\n109|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n110|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n111|\t\t\t\treturn true\n112|\t\t\t}\n113|\t\t\tindex += 6\n114|\t\t\tcontinue\n115|\t\t}\n116|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n117|\t\t\treturn true\n118|\t\t}\n119|\t}\n120|\treturn false\n121|}\n122|\n123|// readUTF16Escape reads four hex digits at the offset. It returns the\n124|// value and the consumed length, or a negative length when the escape\n125|// is truncated or not hexadecimal.\n126|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n127|\tif offset+4 > len(data) {\n128|\t\treturn 0, -1\n129|\t}\n130|\tvar value uint16\n131|\tfor _, digit := range data[offset : offset+4] {\n132|\t\tvalue <<= 4\n133|\t\tswitch {\n134|\t\tcase digit >= '0' && digit <= '9':\n135|\t\t\tvalue |= uint16(digit - '0')\n136|\t\tcase digit >= 'a' && digit <= 'f':\n137|\t\t\tvalue |= uint16(digit-'a') + 10\n138|\t\tcase digit >= 'A' && digit <= 'F':\n139|\t\t\tvalue |= uint16(digit-'A') + 10\n140|\t\tdefault:\n141|\t\t\treturn 0, -1\n142|\t\t}\n143|\t}\n144|\treturn value, 4\n145|}\n146|\n147|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n148|// at the offset. Anything else — a truncated escape, a non-escape,\n149|// or input end — is a negative length.\n150|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n151|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n152|\t\treturn 0, -1\n153|\t}\n154|\treturn readUTF16Escape(data, offset+2)\n155|}\n156|\n157|// unknownMember names a member outside the closed set, if any. The\n158|// single-unknown fixtures keep the verdict deterministic: with\n159|// several unknowns the map order decides which is named, so tests\n160|// never assert a name from a multi-unknown body.\n161|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n162|\tfor name := range members {\n163|\t\tif !allowed[name] {\n164|\t\t\treturn name, true\n165|\t\t}\n166|\t}\n167|\treturn \"\", false\n168|}\n169|\n170|// missingMember names the first required member with no value, if\n171|// any. The required list is fixed order, so the verdict is\n172|// deterministic for every missing combination.\n173|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n174|\tfor _, name := range required {\n175|\t\tif _, present := members[name]; !present {\n176|\t\t\treturn name, true\n177|\t\t}\n178|\t}\n179|\treturn \"\", false\n180|}\n181|\n182|// rawString reads a JSON string member.\n183|func rawString(raw json.RawMessage) (string, bool) {\n184|\tvar value string\n185|\tif err := json.Unmarshal(raw, &value); err != nil {\n186|\t\treturn \"\", false\n187|\t}\n188|\treturn value, true\n189|}\n190|\n191|// rawBool reads a JSON boolean member.\n192|func rawBool(raw json.RawMessage) (bool, bool) {\n193|\tvar value bool\n194|\tif err := json.Unmarshal(raw, &value); err != nil {\n195|\t\treturn false, false\n196|\t}\n197|\treturn value, true\n198|}\n199|\n200|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n(more lines below)"}}}
