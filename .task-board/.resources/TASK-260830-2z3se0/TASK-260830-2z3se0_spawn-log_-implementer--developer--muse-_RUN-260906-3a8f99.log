{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cac9","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":959,"recorded_at":1780531400001913,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"39df4155-a410-468f-97f2-3c1984a4b9f3"},"task_id":"39df4155-a410-468f-97f2-3c1984a4b9f3","event":{"kind":"output","task_id":"39df4155-a410-468f-97f2-3c1984a4b9f3","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/discovery.go`.\n(13 line(s) above)\n14|// sealing that binding so every later call and target mutation can\n15|// be checked against freshly read facts and the Journal binding.\n16|\n17|// Role names one side of a SessionAdapterExecutionBinding. The role\n18|// is call-scoped: a source binding never authorizes a target call.\n19|type Role string\n20|\n21|// The closed role vocabulary.\n22|const (\n23|\tRoleSource Role = \"source\"\n24|\tRoleTarget Role = \"target\"\n25|)\n26|\n27|// TrustedCandidate is the independently observed provider\n28|// candidate the adapter must share: the identifier, kind,\n29|// executable path, owner identity, and digests the host observed\n30|// through provider discovery and trust, never through the adapter.\n31|type TrustedCandidate struct {\n32|\tProviderID             string\n33|\tKind                   CandidateKind\n34|\tExecutablePath         string\n35|\tOwnerIdentity          string\n36|\tExecutableSHA256       string\n37|\tProviderManifestDigest string\n38|}\n39|\n40|// ExecutionBinding is one sealed\n41|// SessionAdapterExecutionBinding: role, provider, candidate kind,\n42|// canonical executable path, owner identity, executable digest,\n43|// provider and adapter manifest digests, and the observation time.\n44|// verified_at records when the host observed these facts, not what\n45|// they are: equality compares the eight identity facts, never the\n46|// clock reading, because two reads of one unchanged candidate\n47|// legitimately carry different timestamps.\n48|type ExecutionBinding struct {\n49|\tRole                   Role\n50|\tProviderID             string\n51|\tCandidateKind          CandidateKind\n52|\tExecutablePath         string\n53|\tOwnerIdentity          string\n54|\tExecutableSHA256       string\n55|\tProviderManifestDigest string\n56|\tAdapterManifestDigest  string\n57|\tVerifiedAt             string\n58|}\n59|\n60|// Discover binds one validated adapter manifest to one trusted\n61|// candidate: the manifest's provider identifier must equal the\n62|// candidate's, and the host-computed manifest digest is sealed into\n63|// the binding alongside the candidate's executable facts. A\n64|// well-formed manifest for a different provider is an integrity\n65|// failure, not a usable adapter: agreement with the trusted\n66|// candidate is what makes the manifest this adapter's, and a\n67|// failed or partial observation never means the candidate is\n68|// absent.\n69|func Discover(role Role, manifest Manifest, manifestDigest string, candidate TrustedCandidate) (ExecutionBinding, error) {\n70|\tif role != RoleSource && role != RoleTarget {\n71|\t\tfailure, err := failInvalid(\"discovery role is outside source|target\", \"role\")\n72|\t\tif err != nil {\n73|\t\t\treturn ExecutionBinding{}, err\n74|\t\t}\n75|\t\treturn ExecutionBinding{}, failure\n76|\t}\n77|\tif manifest.ProviderID != candidate.ProviderID {\n78|\t\tfailure, err := failIntegrity(\"adapter manifest provider identifier does not match the trusted candidate\", \"provider_id\")\n79|\t\tif err != nil {\n80|\t\t\treturn ExecutionBinding{}, err\n81|\t\t}\n82|\t\treturn ExecutionBinding{}, failure\n83|\t}\n84|\tif candidate.ExecutablePath == \"\" {\n85|\t\tfailure, err := failInvalid(\"discovery candidate carries no executable path\", \"executable_path\")\n86|\t\tif err != nil {\n87|\t\t\treturn ExecutionBinding{}, err\n88|\t\t}\n89|\t\treturn ExecutionBinding{}, failure\n90|\t}\n91|\tif candidate.OwnerIdentity == \"\" {\n92|\t\tfailure, err := failInvalid(\"discovery candidate carries no owner identity\", \"owner_identity\")\n93|\t\tif err != nil {\n(more lines below)"}}}
