{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c659","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":391,"recorded_at":1780531400000777,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c5fe67702a7d64be941834bc5","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/context.go`.\n(179 line(s) above)\n180|\t}\n181|\treturn scalar.SHA256Digest(canonical), nil\n182|}\n183|\n184|// VerifyRequestDigest recomputes the digest of the canonical request\n185|// body the host sent and requires it to equal the context's\n186|// request_digest: the adapter answers for exactly this body, not\n187|// for a neighbouring call. A changed body under a replayed context\n188|// is a protocol error, never a retried mutation.\n189|func VerifyRequestDigest(context CallContext, requestBody []byte) error {\n190|\tdigest, err := RequestDigestFor(requestBody)\n191|\tif err != nil {\n192|\t\tfailure, faultErr := failProtocol(\"call request body is not canonical JSON\", \"body\")\n193|\t\tif faultErr != nil {\n194|\t\t\treturn faultErr\n195|\t\t}\n196|\t\treturn failure\n197|\t}\n198|\tif digest.String() != context.RequestDigest {\n199|\t\tfailure, err := failProtocol(\"call context request digest does not match the request body\", \"request_digest\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\treturn nil\n206|}\n207|\n208|// CheckContextEcho requires the success body to carry the request\n209|// context byte-for-byte: Section 7.8 states every success echoes\n210|// the context exactly. A rebuilt context — even a semantically\n211|// equal one — is a protocol error, because only byte identity\n212|// proves the adapter answered this call. DecodeCallContext\n213|// already returns the canonical bytes, so the comparison reuses\n214|// them: a second canonicalization of the same bytes could only\n215|// repeat its verdict, and an arm that cannot fire is not\n216|// carried.\n217|func CheckContextEcho(sent CallContext, echoed json.RawMessage) (CallContext, error) {\n218|\treceived, err := DecodeCallContext(echoed)\n219|\tif err != nil {\n220|\t\treturn CallContext{}, err\n221|\t}\n222|\tif !bytes.Equal(received.raw, sent.raw) {\n223|\t\tfailure, err := failProtocol(\"success context does not echo the request context byte-for-byte\", \"context\")\n224|\t\tif err != nil {\n225|\t\t\treturn CallContext{}, err\n226|\t\t}\n227|\t\treturn CallContext{}, failure\n228|\t}\n229|\treturn received, nil\n230|}\n231|\n232|// readAuthorityMembers is the exact ReadAuthority member set:\n233|// authority_id, purpose, root_handle_names, expires_at, and\n234|// extensions. Handle names identify host-opened descriptors\n235|// delivered out of band; they are never paths.\n236|var readAuthorityMembers = map[string]bool{\n237|\t\"authority_id\":      true,\n238|\t\"purpose\":           true,\n239|\t\"root_handle_names\": true,\n240|\t\"expires_at\":        true,\n241|\t\"extensions\":        true,\n242|}\n243|\n244|// readAuthorityRequired lists readAuthorityMembers in order.\n245|var readAuthorityRequired = []string{\n246|\t\"authority_id\",\n247|\t\"purpose\",\n248|\t\"root_handle_names\",\n249|\t\"expires_at\",\n250|\t\"extensions\",\n251|}\n252|\n253|// ReadAuthority is one validated read authority.\n254|type ReadAuthority struct {\n255|\tAuthorityID string\n256|\tPurpose     string\n257|\tHandleNames []string\n258|\tExpiresAt   string\n259|}\n260|\n261|// DecodeReadAuthority validates one closed ReadAuthority: the\n262|// purpose in source_native|target_staged|target_live and 1..128\n263|// sorted unique handle names of 1..128 characters each.\n264|func DecodeReadAuthority(raw json.RawMessage) (ReadAuthority, error) {\n265|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n266|\tif fault != nil {\n267|\t\tfailure, err := failProtocol(\"read authority \"+fault.detail, fault.member)\n268|\t\tif err != nil {\n269|\t\t\treturn ReadAuthority{}, err\n270|\t\t}\n271|\t\treturn ReadAuthority{}, failure\n272|\t}\n273|\tif name, unknown := unknownMember(members, readAuthorityMembers); unknown {\n274|\t\tfailure, err := failProtocol(\"read authority carries unknown member\", name)\n275|\t\tif err != nil {\n276|\t\t\treturn ReadAuthority{}, err\n277|\t\t}\n278|\t\treturn ReadAuthority{}, failure\n279|\t}\n280|\tif name, missing := missingMember(members, readAuthorityRequired); missing {\n281|\t\tfailure, err := failProtocol(\"read authority misses a required member\", name)\n282|\t\tif err != nil {\n283|\t\t\treturn ReadAuthority{}, err\n284|\t\t}\n285|\t\treturn ReadAuthority{}, failure\n286|\t}\n287|\tauthorityID, ok := checkUUIDv7(members[\"authority_id\"])\n288|\tif !ok {\n289|\t\tfailure, err := failProtocol(\"read authority identifier is not a UUIDv7\", \"authority_id\")\n290|\t\tif err != nil {\n291|\t\t\treturn ReadAuthority{}, err\n292|\t\t}\n293|\t\treturn ReadAuthority{}, failure\n294|\t}\n295|\tpurpose, ok := rawString(members[\"purpose\"])\n296|\tif !ok || !validReadPurpose(purpose) {\n297|\t\tfailure, err := failProtocol(\"read authority purpose is outside source_native|target_staged|target_live\", \"purpose\")\n298|\t\tif err != nil {\n299|\t\t\treturn ReadAuthority{}, err\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65b","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":392,"recorded_at":1780531400000779,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c611376639c4f7443a10de3e8","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/protocol.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Wire constants of pinned specification Section 7.8. The protocol\n12|// identifier and version are exact: the adapter speaks 1.0.0 in the\n13|// same trusted executable as Provider Protocol 2.0.0, and anything\n14|// else on the wire is a session_adapter_protocol_error, never a\n15|// negotiation.\n16|const (\n17|\t// ProtocolID is the exact protocol member every request and\n18|\t// response envelope carries.\n19|\tProtocolID = \"urn:ax:protocol:session-adapter\"\n20|\t// ProtocolVersion is the exact protocol_version member this host\n21|\t// writes and the only one it accepts a response under.\n22|\tProtocolVersion = \"1.0.0\"\n23|\t// ProtocolMajor is the major this host implements. Section 7.8\n24|\t// defines no multi-major negotiation for the adapter, so a\n25|\t// different major is an invalid envelope, not a downgrade.\n26|\tProtocolMajor = 1\n27|\t// ErrorVersion is the Structured Error version every failure\n28|\t// envelope carries: Session Adapter 1.0 statically binds\n29|\t// Structured Error 1.1.0.\n30|\tErrorVersion = axerror.Version110\n31|\t// MaxFrameBytes bounds one JSONL line in either direction:\n32|\t// Section 7.8 inherits Section 7.2's rule that every line is one\n33|\t// complete UTF-8 JSON object no larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|)\n36|\n37|// Operation names one Section 7.8 registry entry. The registry is\n38|// closed: dispatch refuses any other name locally, before any adapter\n39|// surface is touched.\n40|type Operation string\n41|\n42|// Section 7.8 operation registry in the section's table order. The\n43|// inventory test derives this list from the pinned specification\n44|// text and requires exact ordered equality, so a dropped, added, or\n45|// reordered entry reddens there rather than passing silently.\n46|const (\n47|\tOpManifest       Operation = \"manifest\"\n48|\tOpProbe          Operation = \"probe\"\n49|\tOpDiscover       Operation = \"discover\"\n50|\tOpInspect        Operation = \"inspect\"\n51|\tOpSnapshotProof  Operation = \"snapshot-proof\"\n52|\tOpCapturePlan    Operation = \"capture-plan\"\n53|\tOpCapture        Operation = \"capture\"\n54|\tOpNormalize      Operation = \"normalize\"\n55|\tOpProjectionPlan Operation = \"projection-plan\"\n56|\tOpProject        Operation = \"project\"\n57|\tOpReadBack       Operation = \"read-back\"\n58|\tOpValidate       Operation = \"validate\"\n59|\tOpResumePlan     Operation = \"resume-plan\"\n60|\tOpDoctor         Operation = \"doctor\"\n61|)\n62|\n63|// operationOrder is the single construction site of the dispatch\n64|// registry.\n65|var operationOrder = []Operation{\n66|\tOpManifest,\n67|\tOpProbe,\n68|\tOpDiscover,\n69|\tOpInspect,\n70|\tOpSnapshotProof,\n71|\tOpCapturePlan,\n72|\tOpCapture,\n73|\tOpNormalize,\n74|\tOpProjectionPlan,\n75|\tOpProject,\n76|\tOpReadBack,\n77|\tOpValidate,\n78|\tOpResumePlan,\n79|\tOpDoctor,\n80|}\n81|\n82|// Operations returns the dispatch registry in section order. The\n83|// result is a copy; the registry cannot be mutated through it.\n84|func Operations() []string {\n85|\tout := make([]string, 0, len(operationOrder))\n86|\tfor _, operation := range operationOrder {\n87|\t\tout = append(out, string(operation))\n88|\t}\n89|\treturn out\n90|}\n91|\n92|// validOperation reports whether the name is a registry member.\n93|func validOperation(name string) bool {\n94|\tfor _, operation := range operationOrder {\n95|\t\tif string(operation) == name {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// The refusal constructors below are declared as variables so the\n103|// inventory gate can observe every exercised refusal site. Each is\n104|// the single construction site for its failure class; production\n105|// code must not build *axerror.Error any other way.\n106|//\n107|// failInvalid reports a caller error caught before any adapter\n108|// surface is touched: a required set naming an unknown capability, a\n109|// binding the caller built from unobserved facts. failProtocol\n110|// reports an unusable adapter frame: an invalid envelope, a body\n111|// outside its closed shape, a digest mismatch, a partial,\n112|// malformed, over-limit, or escaped result. failUnknownOperation\n113|// reports a name outside the closed registry. failCapability\n114|// reports an operation the adapter does not implement.\n115|// failUnsupportedTuple reports an environment the signed registry\n116|// does not admit. failIntegrity reports a binding observation that\n117|// cannot be reconciled to trusted candidate facts: a failed or\n118|// partial read, or a before-call fact that no longer equals the\n119|// freshly read fact and the Journal binding.\n120|//\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c61ea7ba2a9c00eb84864ff50","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/operations.go`.\n(589 line(s) above)\n590|\t\t\t\t\treturn err\n591|\t\t\t\t}\n592|\t\t\t\treturn failure\n593|\t\t\t}\n594|\t\t\tprevious = disposition\n595|\t\t}\n596|\t}\n597|\treturn nil\n598|}\n599|\n600|// checkValidateNullability enforces the validate mode rule:\n601|// archive requires all four target members null, staged and live\n602|// require them non-null. The request and the success share the rule.\n603|func checkValidateNullability(members map[string]json.RawMessage) error {\n604|\tmode, _ := rawString(members[\"mode\"])\n605|\ttargets := []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"}\n606|\tif mode == \"archive\" {\n607|\t\tfor _, name := range targets {\n608|\t\t\tif !isNull(members[name]) {\n609|\t\t\t\tfailure, err := failProtocol(\"validate archive mode carries a target member\", name)\n610|\t\t\t\tif err != nil {\n611|\t\t\t\t\treturn err\n612|\t\t\t\t}\n613|\t\t\t\treturn failure\n614|\t\t\t}\n615|\t\t}\n616|\t\treturn nil\n617|\t}\n618|\tfor _, name := range targets {\n619|\t\tif isNull(members[name]) {\n620|\t\t\tfailure, err := failProtocol(\"validate staged/live mode misses a target member\", name)\n621|\t\t\tif err != nil {\n622|\t\t\t\treturn err\n623|\t\t\t}\n624|\t\t\treturn failure\n625|\t\t}\n626|\t}\n627|\treturn nil\n628|}\n629|\n630|// SuccessFacts are the request-side facts one success body is\n631|// checked against: the sent context for the byte-for-byte echo,\n632|// the validate request mode for the mode pairing, the resume-plan\n633|// expected native identifier for the identity occurrence, and the\n634|// doctor request direction for the direction pairing. Unused\n635|// members stay zero for other operations.\n636|type SuccessFacts struct {\n637|\tContext         CallContext\n638|\tValidateMode    string\n639|\tResumeTargetID  string\n640|\tDoctorDirection Direction\n641|}\n642|\n643|// CheckSuccessBody validates one inbound success body for its\n644|// operation: the exact member set, the byte-for-byte context\n645|// echo, and the semantic gates Section 7.8 states per operation.\n646|// Manifest, probe, and doctor successes decode through their\n647|// dedicated decoders. An unknown operation is operation_unknown.\n648|func CheckSuccessBody(operation Operation, body []byte, facts SuccessFacts) error {\n649|\tif !validOperation(string(operation)) {\n650|\t\tfailure, err := failUnknownOperation(\"success body names an operation outside the closed registry\", string(operation))\n651|\t\tif err != nil {\n652|\t\t\treturn err\n653|\t\t}\n654|\t\treturn failure\n655|\t}\n656|\tswitch operation {\n657|\tcase OpManifest:\n658|\t\t_, err := DecodeManifest(body)\n659|\t\treturn err\n660|\tcase OpProbe:\n661|\t\t_, err := DecodeProbe(body)\n662|\t\treturn err\n663|\tcase OpDoctor:\n664|\t\t_, err := DecodeDoctorResult(body, facts.Context, facts.DoctorDirection)\n665|\t\treturn err\n666|\t}\n667|\tmembers, fault := decodeStrictObject(body)\n668|\tif fault != nil {\n669|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, fault.member)\n670|\t\tif err != nil {\n671|\t\t\treturn err\n672|\t\t}\n673|\t\treturn failure\n674|\t}\n675|\tallowed := successMemberSet(operation)\n676|\tif name, unknown := unknownMember(members, allowed); unknown {\n677|\t\tfailure, err := failProtocol(\"success body carries unknown member\", name)\n678|\t\tif err != nil {\n679|\t\t\treturn err\n680|\t\t}\n681|\t\treturn failure\n682|\t}\n683|\tif name, missing := missingMember(members, successBodyMembers[operation]); missing {\n684|\t\tfailure, err := failProtocol(\"success body misses a required member\", name)\n685|\t\tif err != nil {\n686|\t\t\treturn err\n687|\t\t}\n688|\t\treturn failure\n689|\t}\n690|\tif _, err := CheckContextEcho(facts.Context, members[\"context\"]); err != nil {\n691|\t\treturn err\n692|\t}\n693|\tif err := checkSuccessScalars(operation, members, facts); err != nil {\n694|\t\treturn err\n695|\t}\n696|\tif !checkExtensions(members[\"extensions\"]) {\n697|\t\tfailure, err := failProtocol(\"success body extensions are not reverse-DNS keyed\", \"extensions\")\n698|\t\tif err != nil {\n699|\t\t\treturn err\n700|\t\t}\n701|\t\treturn failure\n702|\t}\n703|\treturn nil\n704|}\n705|\n706|// checkSuccessScalars validates the inline members of one success\n707|// body plus the semantic gates.\n708|func checkSuccessScalars(operation Operation, members map[string]json.RawMessage, facts SuccessFacts) error {\n709|\tswitch operation {\n710|\tcase OpDiscover:\n711|\t\tif _, err := checkDiscoverSources(members[\"sources\"]); err != nil {\n712|\t\t\treturn err\n713|\t\t}\n714|\t\tpartial, err := requireBool(members, \"partial\")\n715|\t\tif err != nil {\n716|\t\t\treturn err\n717|\t\t}\n718|\t\tcursorNull := isNull(members[\"next_cursor\"])\n719|\t\tif !cursorNull {\n720|\t\t\tif err := requireStringBounds(members, \"next_cursor\", 1, 1024); err != nil {\n721|\t\t\t\treturn err\n722|\t\t\t}\n723|\t\t}\n724|\t\t// partial=false iff next_cursor is null: a complete page\n725|\t\t// carries no cursor, and a cursor always means more.\n726|\t\tif partial == cursorNull {\n727|\t\t\tfailure, err := failProtocol(\"discover partial flag disagrees with the cursor\", \"partial\")\n728|\t\t\tif err != nil {\n729|\t\t\t\treturn err\n730|\t\t\t}\n731|\t\t\treturn failure\n732|\t\t}\n733|\tcase OpInspect:\n734|\t\tif err := requireNestedObject(members, \"source\"); err != nil {\n735|\t\t\treturn err\n736|\t\t}\n737|\t\tif err := requireNestedObject(members, \"source_identity\"); err != nil {\n738|\t\t\treturn err\n739|\t\t}\n740|\t\tif err := requireStringBounds(members, \"source_store_generation\", 1, 512); err != nil {\n741|\t\t\treturn err\n742|\t\t}\n743|\t\tif _, err := DecodeTuple(members[\"environment\"]); err != nil {\n744|\t\t\treturn err\n745|\t\t}\n746|\t\tif _, err := DecodeFindings(members[\"ambiguities\"], 1024); err != nil {\n747|\t\t\treturn err\n748|\t\t}\n749|\tcase OpSnapshotProof:\n750|\t\tif err := requireNestedObject(members, \"proof\"); err != nil {\n751|\t\t\treturn err\n752|\t\t}\n753|\t\tif _, err := requireBool(members, \"provider_quiescence_requested\"); err != nil {\n754|\t\t\treturn err\n755|\t\t}\n756|\t\tif _, err := requireBool(members, \"provider_quiescence_observed\"); err != nil {\n757|\t\t\treturn err\n758|\t\t}\n759|\tcase OpCapturePlan:\n760|\t\tif err := requireNestedObject(members, \"source_identity\"); err != nil {\n761|\t\t\treturn err\n762|\t\t}\n763|\t\tif err := requireStringBounds(members, \"source_store_generation\", 1, 512); err != nil {\n764|\t\t\treturn err\n765|\t\t}\n766|\t\tcandidate, err := requireDigestValue(members, \"capture_plan_candidate_id\")\n767|\t\tif err != nil {\n768|\t\t\treturn err\n769|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
