uiescence\":false,\"extensions\":{}}`)\n56|\tcase OpCapturePlan:\n57|\t\treturn []byte(`{` + ctx + `,\"authority\":` + authority + `,\"source\":` + source + `,\"capture_boundary\":` + boundary + `,\"plan_sink\":` + fixtureFreshSinkJSON(\"capture_plan\") + `,\"max_items\":10,\"max_total_bytes\":1000,\"extensions\":{}}`)\n58|\tcase OpCapture:\n59|\t\treturn []byte(`{` + ctx + `,\"source_authority\":` + authority + `,\"sink\":` + fixtureFreshSinkJSON(\"raw_source\") + `,\"source\":` + source + `,\"capture_boundary\":` + boundary + `,\"capture_plan_digest\":` + quote(fixturePlanDigest) + `,\"extensions\":{}}`)\n60|\tcase OpNormalize:\n61|\t\treturn []byte(`{` + ctx + `,\"capture_manifest_id\":` + quote(fixtureCaptureDigest) + `,\"raw_objects\":` + fixtureFreshSinkJSON(\"raw_source\") + `,\"canonical_sink\":` + fixtureFreshSinkJSON(\"canonical_source\") + `,\"extensions\":{}}`)\n62|\tcase OpProjectionPlan:\n63|\t\treturn []byte(`{` + ctx + `,\"capture_manifest_id\":` + quote(fixtureCaptureDigest) + `,\"canonical_session_id\":` + quote(fixtureSessionDigest) + `,\"canonical_event_ids\":[],\"source_objects\":` + fixtureFreshSinkJSON(\"canonical_source\") + `,\"plan_sink\":` + fixtureFreshSinkJSON(\"projection_plan\") + `,\"target_environment\":` + fixtureTupleJSON() + `,\"expected_target_native_session_id\":\"target-1\",\"fidelity_profile\":\"maximal_safe\",\"required_dispositions\":{\"user_message\":[\"exact\"]},\"forbid_reasons\":[],\"resource_limits\":{\"max_objects\":10,\"max_total_bytes\":1000,\"max_single_object_bytes\":100,\"max_events\":5,\"max_target_resources\":5},\"extensions\":{}}`)\n64|\tcase OpProject:\n65|\t\treturn []byte(`{` + ctx + `,\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"capture_manifest_id\":` + quote(fixtureCaptureDigest) + `,\"canonical_session_id\":` + quote(fixtureSessionDigest) + `,\"source_objects\":` + fixtureFreshSinkJSON(\"canonical_source\") + `,\"target_sink\":` + fixtureFreshSinkJSON(\"projected_target\") + `,\"extensions\":{}}`)\n66|\tcase OpReadBack:\n67|\t\tstaged := mutateAuthority(t, authority, \"target_staged\")\n68|\t\treturn []byte(`{` + ctx + `,\"authority\":` + staged + `,\"expected_target_native_session_id\":\"target-1\",\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"projected_object_manifest_id\":` + quote(fixtureProjectedDigest) + `,\"evidence_sink\":` + fixtureFreshSinkJSON(\"read_back_evidence\") + `,\"extensions\":{}}`)\n69|\tcase OpValidate:\n70|\t\treturn []byte(`{` + ctx + `,\"mode\":\"staged\",\"capture_manifest_id\":` + quote(fixtureCaptureDigest) + `,\"canonical_session_id\":` + quote(fixtureSessionDigest) + `,\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"projected_object_manifest_id\":` + quote(fixtureProjectedDigest) + `,\"read_back_evidence_manifest_id\":` + quote(fixtureReadBackDigest) + `,\"expected_target_native_session_id\":\"target-1\",\"extensions\":{}}`)\n71|\tcase OpResumePlan:\n72|\t\treturn []byte(`{` + ctx + `,\"authority\":` + authority + `,\"expected_target_native_session_id\":\"target-1\",\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"target_checkpoint_id\":null,\"extensions\":{}}`)\n73|\tcase OpDoctor:\n74|\t\treturn []byte(`{` + ctx + `,\"direction\":\"source_read\",\"tuple_registry_digest\":` + quote(fixtureRegistryDigest) + `,\"refresh_requested\":false,\"extensions\":{}}`)\n75|\tdefault:\n76|\t\tt.Fatalf(\"no request fixture for %q\", operation)\n77|\t\treturn nil\n78|\t}\n79|}\n80|\n81|func quote(value string) string {\n82|\treturn `\"` + value + `\"`\n83|}\n84|\n85|// mutateAuthority rebuilds the authority fixture with a purpose.\n86|func mutateAuthority(t *testing.T, authority, purpose string) string {\n87|\tt.Helper()\n88|\tvar members map[string]json.RawMessage\n89|\tif err := json.Unmarshal([]byte(authority), &members); err != nil {\n90|\t\tt.Fatalf(\"mutateAuthority: %v\", err)\n91|\t}\n92|\tmembers[\"purpose\"] = json.RawMessage(`\"` + purpose + `\"`)\n93|\trebuilt, err := json.Marshal(members)\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"mutateAuthority: %v\", err)\n96|\t}\n97|\treturn string(rebuilt)\n98|}\n99|\n100|// fixtureSuccessBody builds one valid success body per operation\n101|// over the request context bytes.\n102|func fixtureSuccessBody(t *testing.T, operation Operation, contextJSON string, manifestDigest string) []byte {\n103|\tt.Helper()\n104|\tctx := `\"context\":` + contextJSON\n105|\tswitch operation {\n106|\tcase OpDiscover:\n107|\t\treturn []byte(`{` + ctx + `,\"sources\":[],\"next_cursor\":null,\"partial\":false,\"extensions\":{}}`)\n108|\tcase OpInspect:\n109|\t\treturn []byte(`{` + ctx + `,\"source\":{},\"source_identity\":{},\"source_store_generation\":\"gen-7\",\"environment\":` + fixtureTupleJSON() + `,\"ambiguities\":[],\"extensions\":{}}`)\n110|\tcase OpSnapshotProof:\n111|\t\treturn []byte(`{` + ctx + `,\"proof\":{},\"provider_quiescence_requested\":false,\"provider_quiescence_observed\":false,\"extensions\":{}}`)\n112|\tcase OpCapturePlan:\n113|\t\treturn []byte(`{` + ctx + `,\"source_identity\":{},\"source_store_generation\":\"gen-7\",\"capture_plan_candidate_id\":` + quote(fixturePlanDigest) + `,\"candidate_count\":0,\"excluded_classes\":[],\"capture_plan_digest\":` + quote(fixturePlanDigest) + `,\"extensions\":{}}`)\n114|\tcase OpCapture:\n115|\t\treturn []byte(`{` + ctx + `,\"capture_plan_digest\":` + quote(fixturePlanDigest) + `,\"source_store_generation\":\"gen-7\",\"capture_result_candidate_id\":` + quote(fixtureDigest(\"result\")) + `,\"source_raw_object_manifest_candidate_id\":` + quote(fixtureDigest(\"raw-manifest\")) + `,\"item_count\":0,\"pre_capture_digest\":` + quote(fixtureDigest(\"pre\")) + `,\"post_capture_digest\":` + quote(fixtureDigest(\"post\")) + `,\"extensions\":{}}`)\n116|\tcase OpNormalize:\n117|\t\treturn []byte(`{` + ctx + `,\"capture_manifest_id\":` + quote(fixtureCaptureDigest) + `,\"canonical_session_candidate_id\":` + quote(fixtureSessionDigest) + `,\"canonical_event_candidate_ids\":[],\"raw_reference_ids\":[],\"extensions\":{}}`)\n118|\tcase OpProjectionPlan:\n119|\t\treturn []byte(`{` + ctx + `,\"projection_plan_candidate_id\":` + quote(fixturePlanDigest) + `,\"required_source_object_ids\":[],\"predicted_counts\":{},\"findings\":[],\"extensions\":{}}`)\n120|\tcase OpProject:\n121|\t\treturn []byte(`{` + ctx + `,\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"projected_object_manifest_candidate_id\":` + quote(fixtureProjectedDigest) + `,\"created_resource_keys\":[],\"actual_counts\":{},\"extensions\":{}}`)\n122|\tcase OpReadBack:\n123|\t\treturn []byte(`{` + ctx + `,\"observed_target_native_session_id\":\"target-1\",\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"observed_environment\":` + fixtureTupleJSON() + `,\"parsed_event_count\":0,\"parsed_head_ids\":[],\"workspace_binding\":{},\"structural_digest\":` + quote(fixtureStructuralDigest) + `,\"read_back_evidence_manifest_candidate_id\":` + quote(fixtureReadBackDigest) + `,\"extensions\":{}}`)\n124|\tcase OpValidate:\n125|\t\treturn []byte(`{` + ctx + `,\"mode\":\"staged\",\"valid\":true,\"structural_valid\":true,\"semantic_marker_valid\":true,\"identity_valid\":null,\"workspace_binding_valid\":null,\"resume_surface_valid\":null,\"findings\":[],\"evidence_digest\":` + quote(fixtureEvidenceDigest) + `,\"extensions\":{}}`)\n126|\tcase OpResumePlan:\n127|\t\treturn []byte(`{` + ctx + `,\"target_native_session_id\":\"target-1\",\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"argv\":[\"ax\",\"open\",\"target-1\"],\"cwd_relative\":\".\",\"environment_names\":[],\"opens_existing_identity\":true,\"extensions\":{}}`)\n128|\tcase OpDoctor:\n129|\t\treturn []byte(`{` + ctx + `,\"direction\":\"source_read\",\"registry_sequence\":9,\"registry_entry_status\":\"accepted\",\"findings\":[],\"healthy\":false,\"extensions\":{}}`)\n130|\tdefault:\n131|\t\tt.Fatalf(\"no success fixture for %q\", operation)\n132|\t\treturn nil\n133|\t}\n134|}\n135|\n136|// requestContextOf extracts the context bytes from a request body.\n137|func requestContextOf(t *testing.T, body []byte) string {\n138|\tt.Helper()\n139|\treturn string(rawMember(t, body, \"context\"))\n140|}\n141|\n142|// TestEveryOperationHasContractVectors drives every registry\n143|// operation through both production entry points with a valid\n144|// body: 14 of 14 request vectors and 11 of 11 success vectors\n145|// (manifest, probe, and doctor successes decode through their\n146|// dedicated decoders, covered by their own tests). An operation\n147|// with no vector fails here rather than passing silently.\n148|func TestEveryOperationHasContractVectors(t *testing.T) {\n149|\tmanifestDigest := fixtureManifestDigestText(t)\n150|\t_, context := requestContext(t, manifestDigest)\n151|\t_ = context\n152|\tdrivenRequests := 0\n153|\tdrivenSuccesses := 0\n154|\tfor _, name := range Operations() {\n155|\t\toperation := Operation(name)\n156|\t\trequest := fixtureRequestBody(t, operation, manifestDigest)\n157|\t\tdecoded, err := CheckRequestBody(operation, request)\n158|\t\tif err != nil {\n159|\t\t\tt.Fatalf(\"CheckRequestBody(%q): %v\", operation, err)\n160|\t\t}\n161|\t\tdrivenRequests++\n162|\t\tif operation == OpManifest || operation == OpProbe || operation == OpDoctor {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\tfacts := SuccessFacts{Context: decoded, ValidateMode: \"staged\", ResumeTargetID: \"target-1\", DoctorDirection: DirectionSourceRead}\n166|\t\tif operation == OpValidate {\n167|\t\t\tfacts.ValidateMode = \"staged\"\n168|\t\t}\n169|\t\tsuccess := fixtureSuccessBody(t, operation, requestContextOf(t, request), manifestDigest)\n170|\t\tif err := CheckSuccessBody(operation, success, facts); err != nil {\n171|\t\t\tt.Fatalf(\"CheckSuccessBody(%q): %v\", operation, err)\n172|\t\t}\n173|\t\tdrivenSuccesses++\n174|\t}\n175|\tif drivenRequests != 14 {\n176|\t\tt.Fatalf(\"request vectors = %d, want 14\", drivenRequests)\n177|\t}\n178|\tif drivenSuccesses != 11 {\n179|\t\tt.Fatalf(\"success vectors = %d, want 11\", drivenSuccesses)\n180|\t}\n181|\tt.Logf(\"contract vectors: %d/14 requests, %d/11 successes, 3 dedicated decoders\", drivenRequests, drivenSuccesses)\n182|}"}}}
