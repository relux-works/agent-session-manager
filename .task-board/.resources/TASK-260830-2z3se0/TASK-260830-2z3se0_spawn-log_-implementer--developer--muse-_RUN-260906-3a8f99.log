cts)\n212|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"registry_entry_status\", \"accepted|revoked|absent\")\n213|\tresult, err := DecodeDoctorResult(good(), decoded, DirectionSourceRead)\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n216|\t}\n217|\tif err := CheckDoctorHealthy(result, probe, nil); err != nil {\n218|\t\tt.Fatalf(\"CheckDoctorHealthy unhealthy: %v\", err)\n219|\t}\n220|\trevoked := mutateMember(t, good(), \"registry_entry_status\", `\"revoked\"`)\n221|\trevoked = mutateMember(t, revoked, \"healthy\", `true`)\n222|\trevokedResult, err := DecodeDoctorResult(revoked, decoded, DirectionSourceRead)\n223|\tif err != nil {\n224|\t\tt.Fatalf(\"DecodeDoctorResult revoked: %v\", err)\n225|\t}\n226|\terr = CheckDoctorHealthy(revokedResult, probe, nil)\n227|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"tuple_registry\", \"accepted registry entry\")\n228|\thealthy := mutateMember(t, good(), \"healthy\", `true`)\n229|\thealthyResult, err := DecodeDoctorResult(healthy, decoded, DirectionSourceRead)\n230|\tif err != nil {\n231|\t\tt.Fatalf(\"DecodeDoctorResult healthy: %v\", err)\n232|\t}\n233|\tweakened := probe\n234|\tweakened.Capabilities = cloneCapabilities(probe.Capabilities)\n235|\tweakened.Capabilities[\"native_discovery\"] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n236|\terr = CheckDoctorHealthy(healthyResult, weakened, []string{\"native_discovery\"})\n237|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"native_discovery\", \"usable required capability\")\n238|\tif err := CheckDoctorHealthy(healthyResult, probe, []string{\"native_discovery\"}); err != nil {\n239|\t\tt.Fatalf(\"CheckDoctorHealthy healthy: %v\", err)\n240|\t}\n241|\terr = CheckDoctorHealthy(healthyResult, probe, []string{\"teleport\"})\n242|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"required\", \"closed registry\")\n243|}"}}}
