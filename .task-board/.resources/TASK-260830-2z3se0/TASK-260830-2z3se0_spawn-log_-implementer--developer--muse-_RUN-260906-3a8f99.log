{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68d","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":417,"recorded_at":1780531400000829,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"0ba00031-c65f-4161-a633-9920ff55c56b"},"task_id":"0ba00031-c65f-4161-a633-9920ff55c56b","event":{"kind":"output","task_id":"0ba00031-c65f-4161-a633-9920ff55c56b","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/operations.go`.\n(1019 line(s) above)\n1020|\tif uint64(len(elements)) > 9 {\n1021|\t\tfailure, err := failProtocol(\"capture excluded classes exceed 9 entries\", \"excluded_classes\")\n1022|\t\tif err != nil {\n1023|\t\t\treturn err\n1024|\t\t}\n1025|\t\treturn failure\n1026|\t}\n1027|\tprevious := \"\"\n1028|\tfor _, element := range elements {\n1029|\t\tclass, ok := rawString(element)\n1030|\t\tif !ok || !validCaptureClass(class) {\n1031|\t\t\tfailure, err := failProtocol(\"capture excluded class is outside the nine-class vocabulary\", \"excluded_classes\")\n1032|\t\t\tif err != nil {\n1033|\t\t\t\treturn err\n1034|\t\t\t}\n1035|\t\t\treturn failure\n1036|\t\t}\n1037|\t\tif previous >= class && previous != \"\" {\n1038|\t\t\tfailure, err := failProtocol(\"capture excluded classes are not sorted unique\", \"excluded_classes\")\n1039|\t\t\tif err != nil {\n1040|\t\t\t\treturn err\n1041|\t\t\t}\n1042|\t\t\treturn failure\n1043|\t\t}\n1044|\t\tprevious = class\n1045|\t}\n1046|\treturn nil\n1047|}\n1048|\n1049|// checkValidateResult validates one validate success body: the\n1050|// mode echoes the request mode, the target nullability follows the\n1051|// mode, and valid=true requires every applicable check true with\n1052|// no error finding. A null applicable check is not applicable and\n1053|// is skipped; a false one fails the conjunction.\n1054|func checkValidateResult(members map[string]json.RawMessage, facts SuccessFacts) error {\n1055|\tmode, ok := rawString(members[\"mode\"])\n1056|\tif !ok || !validValidateMode(mode) {\n1057|\t\tfailure, err := failProtocol(\"validate result mode is outside staged|live|archive\", \"mode\")\n1058|\t\tif err != nil {\n1059|\t\t\treturn err\n1060|\t\t}\n1061|\t\treturn failure\n1062|\t}\n1063|\tif mode != facts.ValidateMode {\n1064|\t\tfailure, err := failProtocol(\"validate result mode does not echo the request mode\", \"mode\")\n1065|\t\tif err != nil {\n1066|\t\t\treturn err\n1067|\t\t}\n1068|\t\treturn failure\n1069|\t}\n1070|\tif err := checkValidateNullability(members); err != nil {\n1071|\t\treturn err\n1072|\t}\n1073|\tstructural, err := requireBool(members, \"structural_valid\")\n1074|\tif err != nil {\n1075|\t\treturn err\n1076|\t}\n1077|\tsemantic, err := requireBool(members, \"semantic_marker_valid\")\n1078|\tif err != nil {\n1079|\t\treturn err\n1080|\t}\n1081|\tfor _, name := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n1082|\t\tif err := requireNullableBool(members, name); err != nil {\n1083|\t\t\treturn err\n1084|\t\t}\n1085|\t}\n1086|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n1087|\tif err != nil {\n1088|\t\treturn err\n1089|\t}\n1090|\tif err := requireDigest(members, \"evidence_digest\"); err != nil {\n1091|\t\treturn err\n1092|\t}\n1093|\tvalid, err := requireBool(members, \"valid\")\n1094|\tif err != nil {\n1095|\t\treturn err\n1096|\t}\n1097|\tif !valid {\n1098|\t\treturn nil\n1099|\t}\n1100|\tif !structural || !semantic {\n1101|\t\tfailure, err := failProtocol(\"validate reports valid with a failed structural or semantic check\", \"valid\")\n1102|\t\tif err != nil {\n1103|\t\t\treturn err\n1104|\t\t}\n1105|\t\treturn failure\n1106|\t}\n1107|\tfor _, name := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n1108|\t\tif !isNull(members[name]) {\n1109|\t\t\tapplicable, _ := rawBool(members[name])\n1110|\t\t\tif !applicable {\n1111|\t\t\t\tfailure, err := failProtocol(\"validate reports valid with a failed applicable check\", name)\n1112|\t\t\t\tif err != nil {\n1113|\t\t\t\t\treturn err\n1114|\t\t\t\t}\n1115|\t\t\t\treturn failure\n1116|\t\t\t}\n1117|\t\t}\n1118|\t}\n1119|\tfor _, finding := range findings {\n1120|\t\tif finding.Severity == \"error\" {\n1121|\t\t\tfailure, err := failProtocol(\"validate reports valid with an error finding\", \"findings\")\n1122|\t\t\tif err != nil {\n1123|\t\t\t\treturn err\n1124|\t\t\t}\n1125|\t\t\treturn failure\n1126|\t\t}\n1127|\t}\n1128|\treturn nil\n1129|}"}}}
