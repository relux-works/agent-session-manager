{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53b","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":248,"recorded_at":1780531400000491,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c1376719189fd9f0a0f8dea07","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/inventory_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|)\n15|\n16|// This file is the derived refusal-arm inventory. It exists\n17|// because a new refusal through an existing site — a widened\n18|// member set, a new detail literal, a dropped check that slides\n19|// to a lower arm — leaves the whole suite green unless the arm\n20|// set is derived from production source by parsing it, never by\n21|// listing it.\n22|//\n23|// Derivation (deriveRefusalArms): every call to one of the seven\n24|// refusal constructors with a string-literal first argument\n25|// yields ctor|<constructor>|<detail>; a call whose first\n26|// argument is a literal prefix plus fault.detail yields\n27|// ctor|<constructor>|conduit|<function>|<prefix>, so conduits in\n28|// different functions never merge; every &frameFault{...}\n29|// literal yields frame|<detail>. A constructor call with any\n30|// other first-argument shape lands as\n31|// ctor|<constructor>|expr|<function> rather than passing\n32|// silently. Constructor references outside direct-call position\n33|// (aliases, variables holding a constructor) fail the derivation\n34|// outright: an aliased constructor hides every arm it builds.\n35|// Package-level var initializers scan under their variable name,\n36|// so a refusal arm hiding in a package-level func literal is\n37|// derived, not missed.\n38|//\n39|// Both directions are checked:\n40|// TestDerivedRefusalArmsAreAllWitnessed (every derived arm\n41|// carries a witness) and TestWitnessedArmsAreAllDerived (every\n42|// witness names a derived arm, so a truncated derivation reddens\n43|// on the orphaned witnesses instead of passing vacuously).\n44|// TestEveryArmWitnessRefusesAtTheProductionEntry drives each\n45|// witness through the production entry and requires the refusal\n46|// to come from the arm under test: code, distinguishing detail,\n47|// and rule text. Empty, single-file, or unparseable derivations\n48|// fail closed: a domain that silently derives nothing is not a\n49|// measurement.\n50|//\n51|// Stated bounds: the five timestamp pairs share one\n52|// (constructor, detail) identity across their checkTimestamp and\n53|// Time halves by construction (one rule, two halves); deleting\n54|// one half is a behavioral mutant the entry-point tests must\n55|// catch, and every witness below proves both halves. Arms\n56|// sharing one identity merge to one obligation only there and\n57|// nowhere else: any other merge fails the derivation.\n58|\n59|// refusalArmCensusFloor is the derived arm count this test was\n60|// written against. It is a tripwire, not an enumeration: a\n61|// derivation returning fewer arms fails closed even when every\n62|// surviving arm is witnessed, which is what catches a silently\n63|// truncated scan. Raising it is routine when production gains a\n64|// refusal; lowering it requires saying why.\n65|const refusalArmCensusFloor = 323\n66|\n67|// refusalConstructors is the closed constructor set the\n68|// derivation observes. A production refusal built any other way\n69|// is invisible to the inventory and fails the alias gate.\n70|var refusalConstructors = []string{\n71|\t\"failInvalid\",\n72|\t\"failProtocol\",\n73|\t\"failUnknownOperation\",\n74|\t\"failCapability\",\n75|\t\"failUnavailable\",\n76|\t\"failUnsupportedTuple\",\n77|\t\"failIntegrity\",\n78|}\n79|\n80|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n81|\tt.Helper()\n82|\tdirectory, err := os.Getwd()\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n85|\t}\n86|\tarms, scanned, err := refusalArmsIn(directory)\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n89|\t}\n90|\tif len(scanned) == 0 {\n91|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n92|\t}\n93|\tif len(arms) == 0 {\n94|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n95|\t}\n96|\tif len(arms) < refusalArmCensusFloor {\n97|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n98|\t}\n99|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n100|\treturn arms\n101|}\n102|\n103|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n104|\tentries, err := os.ReadDir(directory)\n105|\tif err != nil {\n106|\t\treturn nil, nil, err\n107|\t}\n108|\tarms := map[string]struct{}{}\n109|\tvar scanned []string\n110|\tconstructors := map[string]bool{}\n111|\tfor _, name := range refusalConstructors {\n112|\t\tconstructors[name] = true\n113|\t}\n114|\tfor _, entry := range entries {\n115|\t\tname := entry.Name()\n116|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n117|\t\t\tcontinue\n118|\t\t}\n119|\t\tscanned = append(scanned, name)\n120|\t\tpath := filepath.Join(directory, name)\n121|\t\tsource, err := os.ReadFile(path)\n122|\t\tif err != nil {\n123|\t\t\treturn nil, nil, err\n124|\t\t}\n125|\t\tfileSet := token.NewFileSet()\n126|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n127|\t\tif err != nil {\n128|\t\t\treturn nil, nil, err\n129|\t\t}\n130|\t\tif err := collectFileArms(fileSet, syntax, constructors, arms); err != nil {\n131|\t\t\treturn nil, nil, err\n132|\t\t}\n133|\t}\n134|\treturn arms, scanned, nil\n135|}\n136|\n137|// scopeRange is one named scope constructor calls attribute to:\n138|// a function declaration or a package-level variable holding a\n139|// func literal.\n140|type scopeRange struct {\n141|\tname       string\n142|\tstart, end token.Pos\n143|}\n144|\n145|// collectFileArms derives every arm in one production file from a\n146|// single parse, so scope containment compares positions within\n147|// one file set: constructor calls attribute to their innermost\n148|// enclosing scope by source range, frameFault literals derive\n149|// frame arms, and any constructor identifier outside call-fun\n150|// and definition position is an alias and fails the file.\n151|func collectFileArms(fileSet *token.FileSet, syntax *ast.File, constructors map[string]bool, arms map[string]struct{}) error {\n152|\tvar scopes []scopeRange\n153|\ttype pendingCall struct {\n154|\t\tname     string\n155|\t\tcall     *ast.CallExpr\n156|\t\tposition token.Pos\n157|\t}\n158|\tvar calls []pendingCall\n159|\tvar frames []*ast.CompositeLit\n160|\ttype identUse struct {\n161|\t\tidentifier *ast.Ident\n162|\t\tparent     ast.Node\n163|\t}\n164|\tvar uses []identUse\n165|\tvar stack []ast.Node\n166|\tast.Inspect(syntax, func(node ast.Node) bool {\n167|\t\tif node == nil {\n168|\t\t\tstack = stack[:len(stack)-1]\n169|\t\t\treturn true\n170|\t\t}\n171|\t\tvar parent ast.Node\n172|\t\tif len(stack) > 0 {\n173|\t\t\tparent = stack[len(stack)-1]\n174|\t\t}\n175|\t\tswitch node := node.(type) {\n176|\t\tcase *ast.FuncDecl:\n177|\t\t\tscopes = append(scopes, scopeRange{name: node.Name.Name, start: node.Pos(), end: node.End()})\n178|\t\tcase *ast.GenDecl:\n179|\t\t\tfor _, specification := range node.Specs {\n180|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n181|\t\t\t\tif !ok {\n182|\t\t\t\t\tcontinue\n183|\t\t\t\t}\n184|\t\t\t\tfor index, name := range value.Names {\n185|\t\t\t\t\tif index < len(value.Values) {\n186|\t\t\t\t\t\tif literal, ok := value.Values[index].(*ast.FuncLit); ok {\n187|\t\t\t\t\t\t\tscopes = append(scopes, scopeRange{name: \"var:\" + name.Name, start: literal.Pos(), end: literal.End()})\n188|\t\t\t\t\t\t}\n189|\t\t\t\t\t}\n190|\t\t\t\t}\n191|\t\t\t}\n192|\t\tcase *ast.Ident:\n193|\t\t\tif constructors[node.Name] {\n194|\t\t\t\tuses = append(uses, identUse{identifier: node, parent: parent})\n195|\t\t\t}\n196|\t\tcase *ast.CallExpr:\n197|\t\t\tif fun, ok := node.Fun.(*ast.Ident); ok && constructors[fun.Name] {\n198|\t\t\t\tcalls = append(calls, pendingCall{name: fun.Name, call: node, position: node.Pos()})\n199|\t\t\t}\n200|\t\tcase *ast.CompositeLit:\n201|\t\t\tif identifier, ok := node.Type.(*ast.Ident); ok && identifier.Name == \"frameFault\" {\n202|\t\t\t\tframes = append(frames, node)\n203|\t\t\t}\n204|\t\t}\n205|\t\tstack = append(stack, node)\n206|\t\treturn true\n207|\t})\n208|\tfor _, use := range uses {\n209|\t\tif call, ok := use.parent.(*ast.CallExpr); ok {\n210|\t\t\tif fun, ok := call.Fun.(*ast.Ident); ok && fun == use.identifier {\n211|\t\t\t\tcontinue\n212|\t\t\t}\n213|\t\t}\n214|\t\tif _, ok := use.parent.(*ast.ValueSpec); ok {\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\treturn fmt.Errorf(\"constructor alias or indirect use of %s at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n218|\t}\n219|\tenclosing := func(position token.Pos) string {\n220|\t\tbest := \"package\"\n221|\t\tvar bestStart token.Pos\n222|\t\tinitialized := false\n223|\t\tfor _, scope := range scopes {\n224|\t\t\tif scope.start <= position && position <= scope.end {\n225|\t\t\t\tif !initialized || scope.start >= bestStart {\n226|\t\t\t\t\tbest, bestStart, initialized = scope.name, scope.start, true\n227|\t\t\t\t}\n228|\t\t\t}\n229|\t\t}\n230|\t\treturn best\n231|\t}\n232|\tfor _, call := range calls {\n233|\t\tarm, err := callArm(call.name, call.call, enclosing(call.position))\n234|\t\tif err != nil {\n235|\t\t\treturn err\n236|\t\t}\n237|\t\tarms[arm] = struct{}{}\n238|\t}\n239|\tfor _, frame := range frames {\n240|\t\tdetail, err := frameDetail(frame)\n241|\t\tif err != nil {\n242|\t\t\treturn err\n243|\t\t}\n244|\t\tarms[\"frame|\"+detail] = struct{}{}\n245|\t}\n246|\treturn nil\n247|}\n248|\n249|// callArm derives one constructor arm: a string-literal first\n250|// argument is the detail; a literal-plus-fault.detail binary is a\n251|// conduit keyed by function and prefix; anything else is an\n252|// expr obligation keyed by function.\n253|func callArm(constructor string, call *ast.CallExpr, function string) (string, error) {\n254|\tif len(call.Args) == 0 {\n255|\t\treturn \"\", fmt.Errorf(\"constructor %s called with no arguments in %s\", constructor, function)\n256|\t}\n257|\tswitch first := call.Args[0].(type) {\n258|\tcase *ast.BasicLit:\n259|\t\tif first.Kind != token.STRING {\n260|\t\t\treturn \"\", fmt.Errorf(\"constructor %s first argument is not a string in %s\", constructor, function)\n261|\t\t}\n262|\t\tdetail, err := strconv.Unquote(first.Value)\n263|\t\tif err != nil {\n264|\t\t\treturn \"\", err\n265|\t\t}\n266|\t\treturn \"ctor|\" + constructor + \"|\" + detail, nil\n267|\tcase *ast.BinaryExpr:\n268|\t\tprefix, ok := first.X.(*ast.BasicLit)\n269|\t\tif !ok || prefix.Kind != token.STRING {\n270|\t\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n271|\t\t}\n272|\t\ttext, err := strconv.Unquote(prefix.Value)\n273|\t\tif err != nil {\n274|\t\t\treturn \"\", err\n275|\t\t}\n276|\t\treturn \"ctor|\" + constructor + \"|conduit|\" + function + \"|\" + text, nil\n277|\tdefault:\n278|\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n279|\t}\n280|}\n281|\n282|// frameDetail extracts the detail literal from one &frameFault\n283|// composite literal. A non-literal detail is an expr obligation,\n284|// never a silent pass.\n285|func frameDetail(frame *ast.CompositeLit) (string, error) {\n286|\tfor _, element := range frame.Elts {\n287|\t\tpair, ok := element.(*ast.KeyValueExpr)\n288|\t\tif !ok {\n289|\t\t\tcontinue\n290|\t\t}\n291|\t\tkey, ok := pair.Key.(*ast.Ident)\n292|\t\tif !ok || key.Name != \"detail\" {\n293|\t\t\tcontinue\n294|\t\t}\n295|\t\tliteral, ok := pair.Value.(*ast.BasicLit)\n296|\t\tif !ok || literal.Kind != token.STRING {\n297|\t\t\treturn \"expr\", nil\n298|\t\t}\n299|\t\treturn strconv.Unquote(literal.Value)\n300|\t}\n301|\treturn \"\", fmt.Errorf(\"frameFault literal carries no detail\")\n302|}\n303|\n304|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction:\n305|// every arm derived from production must carry a witness. A\n306|// planted arm (a new literal or site through an existing\n307|// constructor) lands here as an unwitnessed arm.\n308|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n309|\tderived := deriveRefusalArms(t)\n310|\twitnessed := map[string]int{}\n311|\tfor _, witness := range declaredWitnesses(t) {\n312|\t\twitnessed[witness.arm]++\n313|\t}\n314|\tvar missing []string\n315|\tfor arm := range derived {\n316|\t\tif witnessed[arm] == 0 {\n317|\t\t\tmissing = append(missing, arm)\n318|\t\t}\n319|\t}\n320|\tsort.Strings(missing)\n321|\tif len(missing) > 0 {\n322|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n323|\t}\n324|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n325|}\n326|\n327|// TestWitnessedArmsAreAllDerived is the reverse direction: every\n328|// witness must name an arm production declares. A deleted or\n329|// narrowed production branch orphans its witness and fails here,\n330|// which is also what makes a truncated derivation fail instead\n331|// of passing vacuously.\n332|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n333|\tderived := deriveRefusalArms(t)\n334|\tvar orphans []string\n335|\tfor _, witness := range declaredWitnesses(t) {\n336|\t\tif _, ok := derived[witness.arm]; !ok {\n337|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n338|\t\t}\n339|\t}\n340|\tsort.Strings(orphans)\n341|\tif len(orphans) > 0 {\n342|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n343|\t}\n344|}\n345|\n346|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every\n347|// witness through its production entry point and requires the\n348|// attributed refusal.\n349|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n350|\tfor _, witness := range declaredWitnesses(t) {\n351|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n352|\t\t\twitness.prove(t)\n353|\t\t})\n354|\t}\n355|}\n356|\n357|// armWitness is one derived arm plus the test proving it refuses\n358|// at the production entry with the attributed identity.\n359|type armWitness struct {\n360|\tarm   string\n361|\tname  string\n362|\tprove func(t *testing.T)\n363|}\n364|\n365|// declaredWitnesses lists every witness. The group tables live\n366|// in inventory_witnesses_test.go.\n367|func declaredWitnesses(t *testing.T) []armWitness {\n368|\tt.Helper()\n369|\te := witnessFixtureEntries(t)\n370|\twitnesses := []armWitness{}\n371|\twitnesses = append(witnesses, envelopeWitnesses(e)...)\n372|\twitnesses = append(witnesses, manifestWitnesses(e)...)\n373|\twitnesses = append(witnesses, probeWitnesses(e)...)\n374|\twitnesses = append(witnesses, contextWitnesses(e)...)\n375|\twitnesses = append(witnesses, tupleWitnesses(e)...)\n376|\twitnesses = append(witnesses, operationWitnesses(e)...)\n377|\twitnesses = append(witnesses, gateWitnesses(e)...)\n378|\twitnesses = append(witnesses, frameWitnesses(e)...)\n379|\twitnesses = append(witnesses, conduitWitnesses(e)...)\n380|\treturn witnesses\n381|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53d","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":249,"recorded_at":1780531400000493,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c146973c2b728cd9402229bbc","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/surrogate_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|)\n9|\n10|// TestLoneSurrogateSweep drives every UTF-16 escape that can stand\n11|// alone through the strict decoder: all 2048 lone surrogates (high\n12|// and low) in upper, lower, and mixed hex case must refuse, and\n13|// every escape is generated, never listed. The verdict for each\n14|// vector comes from construction — the vector names a lone\n15|// surrogate by construction — not from either implementation, so\n16|// the corpus cannot drift with a mutated gate the way a 13-value\n17|// hand list did.\n18|func TestLoneSurrogateSweep(t *testing.T) {\n19|\tcases := []string{\"%04X\", \"%04x\", \"%02X%02x\"}\n20|\trefused := 0\n21|\tfor surrogate := 0xD800; surrogate <= 0xDFFF; surrogate++ {\n22|\t\tfor _, form := range cases {\n23|\t\t\tframe := []byte(fmt.Sprintf(`{\"member\":\"A\\u`+form+`B\"}`, surrogate))\n24|\t\t\tif _, fault := decodeStrictObject(frame); fault == nil {\n25|\t\t\t\tt.Fatalf(\"decodeStrictObject admitted lone surrogate U+%04X\", surrogate)\n26|\t\t\t} else if fault.detail != \"lone surrogate escape\" {\n27|\t\t\t\tt.Fatalf(\"lone surrogate U+%04X fault = %q, want the surrogate gate\", surrogate, fault.detail)\n28|\t\t\t}\n29|\t\t\trefused++\n30|\t\t}\n31|\t}\n32|\t// A high surrogate followed by a low surrogate admits; a high\n33|\t// followed by a non-low, and a low standing first, refuse.\n34|\tpaired := []byte(`{\"member\":\"A\\uD83D\\uDE00B\"}`)\n35|\tif _, fault := decodeStrictObject(paired); fault != nil {\n36|\t\tt.Fatalf(\"decodeStrictObject refused a paired surrogate: %v\", fault.detail)\n37|\t}\n38|\tunpairedHigh := []byte(`{\"member\":\"A\\uD83D\\u0041B\"}`)\n39|\tif _, fault := decodeStrictObject(unpairedHigh); fault == nil {\n40|\t\tt.Fatal(\"decodeStrictObject admitted a high surrogate followed by a non-low\")\n41|\t}\n42|\t// Truncated and non-hex escapes refuse through the same gate.\n43|\tfor _, frame := range []string{`{\"member\":\"A\\uD83B\"}`, `{\"member\":\"A\\uDEFG B\"}`, `{\"member\":\"A\\uD83D\"}`} {\n44|\t\tif _, fault := decodeStrictObject([]byte(frame)); fault == nil {\n45|\t\t\tt.Fatalf(\"decodeStrictObject admitted %q\", frame)\n46|\t\t}\n47|\t}\n48|\tt.Logf(\"surrogate sweep: %d lone vectors refused\", refused)\n49|}\n50|\n51|// TestSurrogateGateAgreesWithCanonicalJSON pins the local gate\n52|// against the shared implementation over generated vectors: every\n53|// BMP escape in both hex cases, every surrogate pair shape, and\n54|// raw non-surrogate multibyte text. Agreement is a consistency\n55|// pin, not the verdict: the verdicts above come from\n56|// construction.\n57|func TestSurrogateGateAgreesWithCanonicalJSON(t *testing.T) {\n58|\tchecked := 0\n59|\tfor code := 0; code < 0xD800; code += 0x217 {\n60|\t\tfor _, frame := range []string{\n61|\t\t\tfmt.Sprintf(`{\"member\":\"A\\u%04XB\"}`, code),\n62|\t\t\tfmt.Sprintf(`{\"member\":\"A\\u%04xB\"}`, code),\n63|\t\t} {\n64|\t\t\t_, localFault := decodeStrictObject([]byte(frame))\n65|\t\t\t_, sharedErr := canonicaljson.Canonicalize([]byte(frame))\n66|\t\t\tif (localFault != nil) != (sharedErr != nil) {\n67|\t\t\t\tt.Fatalf(\"disagreement on U+%04X: local=%v shared=%v\", code, localFault, sharedErr)\n68|\t\t\t}\n69|\t\t\tchecked++\n70|\t\t}\n71|\t}\n72|\tfor _, frame := range []string{\n73|\t\t`{\"member\":\"plain ascii\"}`,\n74|\t\t`{\"member\":\"ü é ☃\"}`,\n75|\t\t`{\"member\":\"A\\uD83D\\uDE00B\"}`,\n76|\t\t`{\"member\":\"A\\ud800B\"}`,\n77|\t\t`{\"member\":\"A\\udc00B\"}`,\n78|\t} {\n79|\t\t_, localFault := decodeStrictObject([]byte(frame))\n80|\t\t_, sharedErr := canonicaljson.Canonicalize([]byte(frame))\n81|\t\tlocalRefuses := localFault != nil\n82|\t\tsharedRefuses := sharedErr != nil\n83|\t\t// The shared canonicalizer accepts lone surrogates it\n84|\t\t// encodes losslessly; the local gate refuses them by\n85|\t\t// rule. Agreement is required only where both must\n86|\t\t// accept: valid text and paired surrogates.\n87|\t\tif !localRefuses && sharedRefuses {\n88|\t\t\tt.Fatalf(\"local gate admits what canonical JSON refuses: %q\", frame)\n89|\t\t}\n90|\t\tchecked++\n91|\t}\n92|\tt.Logf(\"agreement sweep: %d vectors compared\", checked)\n93|}\n94|\n95|// TestNonUTF8NeverDecodes proves raw non-UTF-8 bytes refuse before\n96|// any member is read: overlong encodings, truncated sequences,\n97|// and encoded surrogates (WTF-8) are failures, never rewritten\n98|// text.\n99|func TestNonUTF8NeverDecodes(t *testing.T) {\n100|\tframes := [][]byte{\n101|\t\t{0x7b, 0x22, 0x6d, 0x22, 0x3a, 0xff, 0x7d},\n102|\t\t[]byte(\"{\\\"m\\\":\\\"a\\xed\\xa0\\x80b\\\"}\"),\n103|\t\t[]byte(\"{\\\"m\\\":\\\"a\\xc0\\xafb\\\"}\"),\n104|\t\t[]byte(\"{\\\"m\\\":\\\"a\\xe2\\x82b\\\"}\"),\n105|\t}\n106|\tfor index, frame := range frames {\n107|\t\tif _, fault := decodeStrictObject(frame); fault == nil {\n108|\t\t\tt.Fatalf(\"decodeStrictObject admitted non-UTF-8 frame %d\", index)\n109|\t\t} else if fault.detail != \"not valid UTF-8\" {\n110|\t\t\tt.Fatalf(\"frame %d fault = %q, want the UTF-8 gate\", index, fault.detail)\n111|\t\t}\n112|\t}\n113|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
