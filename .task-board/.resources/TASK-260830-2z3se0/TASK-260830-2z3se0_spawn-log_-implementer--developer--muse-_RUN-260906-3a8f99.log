s,\"session_adapter_manifest_digest\":%q,\"executable_sha256\":%q,\"request_digest\":%q,\"extensions\":{}}`,\n72|\t\tfixtureOperationID, fixtureProviderID, fixtureTupleJSON(), fixtureDigest(\"test-adapter-manifest\"), fixtureExecutableDigest, requestDigest)\n73|}\n74|\n75|// fixtureReadAuthorityJSON is one valid source_native ReadAuthority.\n76|func fixtureReadAuthorityJSON() string {\n77|\treturn fmt.Sprintf(`{\"authority_id\":%q,\"purpose\":\"source_native\",\"root_handle_names\":[\"handle-a\"],\"expires_at\":%q,\"extensions\":{}}`,\n78|\t\tfixtureAuthorityID, fixtureExpiresAt)\n79|}\n80|\n81|// fixtureFreshSinkJSON is one valid fresh_sink ObjectAuthority.\n82|func fixtureFreshSinkJSON(purpose string) string {\n83|\treturn fmt.Sprintf(`{\"authority_id\":%q,\"purpose\":%q,\"mode\":\"fresh_sink\",\"max_objects\":100,\"max_total_bytes\":1000000,\"extensions\":{}}`,\n84|\t\tfixtureAuthorityID, purpose)\n85|}\n86|\n87|// fixtureManifestJSON is one valid Session Adapter Manifest 1.0.0\n88|// with the registries in section order.\n89|func fixtureManifestJSON() string {\n90|\toperations := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\toperations = append(operations, `\"`+string(operation)+`\"`)\n93|\t}\n94|\tcapabilities := make([]string, 0, len(capabilityOrder))\n95|\tfor _, name := range capabilityOrder {\n96|\t\tcapabilities = append(capabilities, `\"`+name+`\"`)\n97|\t}\n98|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-adapter-manifest\",\"schema_version\":\"1.0.0\",\"provider_id\":%q,\"environment_id\":%q,\"display_name\":\"Test Adapter\",\"adapter_version\":%q,\"environment_version_range\":\">=1.0.0\",\"platforms\":[\"linux\",\"macos\"],\"operations\":[%s],\"capability_names\":[%s],\"extensions\":{}}`,\n99|\t\tfixtureProviderID, fixtureEnvironmentID, fixtureAdapterVer,\n100|\t\tstrings.Join(operations, \",\"), strings.Join(capabilities, \",\"))\n101|}\n102|\n103|// fixtureCapabilityJSON is one available+enabled capability value.\n104|func fixtureCapabilityJSON() string {\n105|\treturn `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"\"}`\n106|}\n107|\n108|// fixtureProbeJSON is one valid Session Adapter Probe 1.0.0 with\n109|// every capability available and enabled.\n110|func fixtureProbeJSON(manifestDigest string) string {\n111|\tvalues := make([]string, 0, len(capabilityOrder))\n112|\tfor _, name := range capabilityOrder {\n113|\t\tvalues = append(values, `\"`+name+`\":`+fixtureCapabilityJSON())\n114|\t}\n115|\treturn fmt.Sprintf(`{\"schema\":\"urn:ax:schema:session-adapter-probe\",\"schema_version\":\"1.0.0\",\"provider_id\":%q,\"adapter_manifest_digest\":%q,\"adapter_version\":%q,\"environment\":%s,\"capabilities\":{%s},\"warnings\":[],\"extensions\":{}}`,\n116|\t\tfixtureProviderID, manifestDigest, fixtureAdapterVer, fixtureTupleJSON(), strings.Join(values, \",\"))\n117|}\n118|\n119|// fixtureEntryJSON is one valid accepted registry entry for the\n120|// direction: source_read carries strategies=[archive_only] with\n121|// null smoke, target_write carries the native-writer strategy\n122|// with passing smoke.\n123|func fixtureEntryJSON(direction Direction) string {\n124|\tstrategies := `[\"archive_only\"]`\n125|\tsmoke := `null`\n126|\tif direction == DirectionTargetWrite {\n127|\t\tstrategies = `[\"target_native_writer\"]`\n128|\t\tsmoke = fmt.Sprintf(`{\"result\":\"pass\",\"executed_at\":%q,\"evidence_digest\":%q,\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":true}`,\n129|\t\t\tfixtureExecutedAt, fixtureSmokeDigest)\n130|\t}\n131|\treturn fmt.Sprintf(`{\"key\":{\"direction\":%q,\"environment\":%s,\"provider_id\":%q,\"candidate_kind\":\"builtin\",\"executable_sha256\":%q,\"provider_manifest_digest\":%q,\"session_adapter_manifest_digest\":%q},\"entry_sequence\":7,\"contracts\":[{\"contract_id\":\"urn:ax:protocol:session-adapter\",\"versions\":[\"1.0.0\"]}],\"strategies\":%s,\"fixture_evidence\":{\"suite_re