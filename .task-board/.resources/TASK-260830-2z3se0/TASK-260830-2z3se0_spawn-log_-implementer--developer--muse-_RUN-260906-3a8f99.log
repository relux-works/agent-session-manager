{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ed","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":465,"recorded_at":1780531400000925,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c7ebb7d63893e9a3c40a53995","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/context_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// fixtureRequestWithDigest builds a discover request body whose\n11|// context carries the digest of the body itself: the fixpoint the\n12|// host computes (digest over the body with request_digest\n13|// omitted, then written in). The context names the given adapter\n14|// manifest digest so the body binds to a real sealed binding.\n15|func fixtureRequestWithDigest(t *testing.T, manifestDigest string) []byte {\n16|\tt.Helper()\n17|\tcontextWith := func(requestDigest string) string {\n18|\t\treturn fmt.Sprintf(`{\"operation_id\":%q,\"provider_id\":%q,\"environment\":%s,\"session_adapter_manifest_digest\":%q,\"executable_sha256\":%q,\"request_digest\":%q,\"extensions\":{}}`,\n19|\t\t\tfixtureOperationID, fixtureProviderID, fixtureTupleJSON(), manifestDigest, fixtureExecutableDigest, requestDigest)\n20|\t}\n21|\tskeleton := fmt.Sprintf(`{\"context\":%s,\"authority\":%s,\"workspace_filter\":null,\"limit\":50,\"cursor\":null,\"extensions\":{}}`,\n22|\t\tcontextWith(\"sha256:\"+strings.Repeat(\"0\", 64)), fixtureReadAuthorityJSON())\n23|\tdigest, err := RequestDigestFor([]byte(skeleton))\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"RequestDigestFor: %v\", err)\n26|\t}\n27|\treturn []byte(fmt.Sprintf(`{\"context\":%s,\"authority\":%s,\"workspace_filter\":null,\"limit\":50,\"cursor\":null,\"extensions\":{}}`,\n28|\t\tcontextWith(digest.String()), fixtureReadAuthorityJSON()))\n29|}\n30|\n31|// fixtureManifestDigestText decodes the fixture manifest and returns\n32|// its host-computed digest text.\n33|func fixtureManifestDigestText(t *testing.T) string {\n34|\tt.Helper()\n35|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n38|\t}\n39|\treturn ManifestDigest(manifest).String()\n40|}\n41|\n42|func TestRequestDigestFixpoint(t *testing.T) {\n43|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n44|\tcontext, err := CheckRequestBody(OpDiscover, body)\n45|\tif err != nil {\n46|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n47|\t}\n48|\t// The digest verifies against the sent bytes: writing the\n49|\t// digest into the context did not change the digest, because\n50|\t// the digested form omits that member.\n51|\tif err := VerifyRequestDigest(context, body); err != nil {\n52|\t\tt.Fatalf(\"VerifyRequestDigest: %v\", err)\n53|\t}\n54|\t// A one-byte change anywhere else breaks the binding.\n55|\tmutated := mutateMember(t, body, \"limit\", `51`)\n56|\tif err := VerifyRequestDigest(context, mutated); err == nil {\n57|\t\tt.Fatal(\"VerifyRequestDigest admitted a changed body under a replayed context\")\n58|\t} else {\n59|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"request_digest\", \"does not match\")\n60|\t}\n61|\t// The digest is deterministic: the same canonical body\n62|\t// digests identically across calls.\n63|\tagain, err := RequestDigestFor(body)\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"RequestDigestFor: %v\", err)\n66|\t}\n67|\tif again.String() != context.RequestDigest {\n68|\t\tt.Fatal(\"request digest is not deterministic\")\n69|\t}\n70|}\n71|\n72|func TestVerifyRequestDigestOmitsOnlyItsMember(t *testing.T) {\n73|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n74|\tcontext, err := CheckRequestBody(OpDiscover, body)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n77|\t}\n78|\t// Changing the operation_id changes the digest: the omission\n79|\t// covers only request_digest, not its neighbours.\n80|\tmutated := []byte(strings.Replace(string(body), fixtureOperationID, \"0198f4c8-8e50-7f66-8f70-1234567890aa\", 1))\n81|\tif err := VerifyRequestDigest(context, mutated); err == nil {\n82|\t\tt.Fatal(\"VerifyRequestDigest admitted a body with a different operation_id\")\n83|\t}\n84|}\n85|\n86|func TestCheckContextEcho(t *testing.T) {\n87|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n88|\tsent, err := CheckRequestBody(OpDiscover, body)\n89|\tif err != nil {\n90|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n91|\t}\n92|\t// Byte-identical echo passes.\n93|\techoed, err := CheckContextEcho(sent, rawMember(t, body, \"context\"))\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"CheckContextEcho: %v\", err)\n96|\t}\n97|\tif echoed.OperationID != sent.OperationID {\n98|\t\tt.Fatal(\"echoed context lost the operation identifier\")\n99|\t}\n100|\t// A re-serialized context with a changed value fails at the\n101|\t// echo: decode accepts the valid shape, and only byte\n102|\t// identity proves the adapter answered this call.\n103|\taltered := mutateMember(t, rawMember(t, body, \"context\"), \"provider_id\", `\"other-provider\"`)\n104|\tif _, err := CheckContextEcho(sent, altered); err == nil {\n105|\t\tt.Fatal(\"CheckContextEcho admitted a context for another provider\")\n106|\t} else {\n107|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"context\", \"byte-for-byte\")\n108|\t}\n109|\t// A malformed context fails at decode, before the echo.\n110|\tmalformed := mutateMember(t, rawMember(t, body, \"context\"), \"provider_id\", `\"Other Provider\"`)\n111|\tif _, err := CheckContextEcho(sent, malformed); err == nil {\n112|\t\tt.Fatal(\"CheckContextEcho admitted a malformed context\")\n113|\t} else {\n114|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"not a provider-id\")\n115|\t}\n116|}\n117|\n118|// rawMember extracts one top-level member's raw bytes.\n119|func rawMember(t *testing.T, body []byte, member string) []byte {\n120|\tt.Helper()\n121|\tvar members map[string]json.RawMessage\n122|\tif err := json.Unmarshal(body, &members); err != nil {\n123|\t\tt.Fatalf(\"rawMember: %v\", err)\n124|\t}\n125|\traw, present := members[member]\n126|\tif !present {\n127|\t\tt.Fatalf(\"rawMember: %q not in body\", member)\n128|\t}\n129|\treturn raw\n130|}\n131|\n132|func TestDecodeCallContextRules(t *testing.T) {\n133|\tvalid := fixtureContextJSON(fixtureDigest(\"req\"))\n134|\tif _, err := DecodeCallContext([]byte(valid)); err != nil {\n135|\t\tt.Fatalf(\"DecodeCallContext: %v\", err)\n136|\t}\n137|\tfor _, test := range []struct {\n138|\t\tname   string\n139|\t\tmember string\n140|\t\tvalue  string\n141|\t\ttext   string\n142|\t}{\n143|\t\t{\"bad operation id\", \"operation_id\", `\"not-a-uuid\"`, \"not a UUIDv7\"},\n144|\t\t{\"bad provider id\", \"provider_id\", `\"Test\"`, \"not a provider-id\"},\n145|\t\t{\"bad manifest digest\", \"session_adapter_manifest_digest\", `\"nope\"`, \"not a digest\"},\n146|\t\t{\"bad executable digest\", \"executable_sha256\", `\"nope\"`, \"not a digest\"},\n147|\t\t{\"bad request digest\", \"request_digest\", `\"nope\"`, \"not a digest\"},\n148|\t\t{\"bad extensions\", \"extensions\", `{\"x\":\"y\"}`, \"not reverse-DNS keyed\"},\n149|\t} {\n150|\t\tt.Run(test.name, func(t *testing.T) {\n151|\t\t\t_, err := DecodeCallContext(mutateMember(t, []byte(valid), test.member, test.value))\n152|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.member, test.text)\n153|\t\t})\n154|\t}\n155|\tt.Run(\"missing member\", func(t *testing.T) {\n156|\t\t_, err := DecodeCallContext(dropMember(t, []byte(valid), \"environment\"))\n157|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"environment\", \"misses a required member\")\n158|\t})\n159|\tt.Run(\"unknown member\", func(t *testing.T) {\n160|\t\t_, err := DecodeCallContext(appendMember(t, []byte(valid), \"unexpected\", `1`))\n161|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"unexpected\", \"unknown member\")\n162|\t})\n163|}\n164|\n165|func TestDecodeReadAuthorityRules(t *testing.T) {\n166|\tvalid := fixtureReadAuthorityJSON()\n167|\tif _, err := DecodeReadAuthority([]byte(valid)); err != nil {\n168|\t\tt.Fatalf(\"DecodeReadAuthority: %v\", err)\n169|\t}\n170|\tfor _, purpose := range []string{\"source_native\", \"target_staged\", \"target_live\"} {\n171|\t\tif _, err := DecodeReadAuthority(mutateMember(t, []byte(valid), \"purpose\", `\"`+purpose+`\"`)); err != nil {\n172|\t\t\tt.Fatalf(\"DecodeReadAuthority(%q): %v\", purpose, err)\n173|\t\t}\n174|\t}\n175|\tfor _, test := range []struct {\n176|\t\tname   string\n177|\t\tmember string\n178|\t\tvalue  string\n179|\t\ttext   string\n180|\t}{\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
