, func(t *testing.T) {\n+\t\terr := CheckProbeRequest(fixtureProviderID, \"\", fixtureCandidate())\n+\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n+\t})\n+}\n+\n+func TestCheckProbeRequest(t *testing.T) {\n","edit_facts":{"tool_name":"edit_file","path":"/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe_test.go","added":33,"removed":1},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
