{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d54b","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":2304,"recorded_at":1780531400004603,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"241342c3-ae0f-451a-9bdf-b39d9e11d9bf"},"task_id":"241342c3-ae0f-451a-9bdf-b39d9e11d9bf","event":{"kind":"output","task_id":"241342c3-ae0f-451a-9bdf-b39d9e11d9bf","chunk":"edited\nchanged lines: line 204\n--- original\n+++ updated\n@@\n-killed = sum(1 for _, v, _, _, _ in results if v == \"KILLED\")\n+def measure_file(mid, filename, content, test, expect):\n+    \"\"\"File-addition mutant (F2 alias probes).\"\"\"\n+    try:\n+        with open(filename, \"w\") as f:\n+            f.write(content)\n+        present = run(f\"grep -c -F planted {filename}\").stdout.strip()\n+        assert present and int(present) >= 1, f\"{mid}: mutant file not present\"\n+        build = run(f\"go vet {PKG} 2>&1 | head -3\")\n+        compiled = build.returncode == 0\n+        out = run(f\"go test {PKG} -run '{test}' -count=1 2>&1 | tail -6\")\n+        red = \"FAIL\" in out.stdout\n+        if expect == \"fail\":\n+            verdict = \"KILLED\" if (compiled and red) else \"SURVIVED\"\n+        else:\n+            verdict = \"CONTROL-GREEN\" if (compiled and not red) else \"CONTROL-RED\"\n+        results.append((mid, verdict, test, compiled, red))\n+        log(f\"{mid}: {verdict} test={test} compiled={compiled} red={red}\")\n+        if verdict in (\"SURVIVED\", \"CONTROL-RED\"):\n+            log(f\"  tail: {out.stdout.strip()[:400]}\")\n+    finally:\n+        run(f\"rm -f {filename}\")\n+\n+\n+# F2: var-form aliases fail the derivation; direct arms are seen (unwitnessed).\n+measure_file(\"M11-pkg-var-alias\", \"internal/sessadapter/zz_m11_alias.go\",\n+             \"package sessadapter\\n\\nvar plantedFail = failInvalid\\n\\nfunc plantedAliasArm() {\\n\\t_, _ = plantedFail(\\\"planted alias arm\\\", \\\"field\\\")\\n}\\n\",\n+             \"TestDerivedRefusalArmsAreAllWitnessed\", \"fail\")\n+measure_file(\"M12-local-var-alias\", \"internal/sessadapter/zz_m12_alias.go\",\n+             \"package sessadapter\\n\\nfunc plantedLocalAliasArm() {\\n\\tvar localFail = failInvalid\\n\\t_, _ = localFail(\\\"planted local arm\\\", \\\"field\\\")\\n}\\n\",\n+             \"TestDerivedRefusalArmsAreAllWitnessed\", \"fail\")\n+measure_file(\"M13-direct-arm-control\", \"internal/sessadapter/zz_m13_direct.go\",\n+             \"package sessadapter\\n\\nfunc plantedDirectArm() {\\n\\t_, _ = failInvalid(\\\"planted direct arm\\\", \\\"field\\\")\\n}\\n\",\n+             \"TestDerivedRefusalArmsAreAllWitnessed\", \"fail\")\n+\n+killed = sum(1 for _, v, _, _, _ in results if v == \"KILLED\")\n"}}}
