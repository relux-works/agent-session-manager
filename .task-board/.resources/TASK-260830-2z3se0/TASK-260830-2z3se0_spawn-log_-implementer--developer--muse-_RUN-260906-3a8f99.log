{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c719","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":487,"recorded_at":1780531400000969,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"1cf3491f-23d7-4dc5-b95a-c72f63ee94e8"},"task_id":"1cf3491f-23d7-4dc5-b95a-c72f63ee94e8","event":{"kind":"output","task_id":"1cf3491f-23d7-4dc5-b95a-c72f63ee94e8","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe_test.go`.\n(179 line(s) above)\n180|\t\tManifest:           manifest,\n181|\t}\n182|\tif err := CheckProbe(probe, facts); err != nil {\n183|\t\tt.Fatalf(\"CheckProbe: %v\", err)\n184|\t}\n185|\t// Every equality is broken alone: provider vs request, provider\n186|\t// vs manifest, digest, version, tuple environment, and tuple\n187|\t// adapter version.\n188|\totherDigest := fixtureDigest(\"other-manifest\")\n189|\tfor _, test := range []struct {\n190|\t\tname  string\n191|\t\tprobe Probe\n192|\t\tfacts ProbeHostFacts\n193|\t\tkey   string\n194|\t\tvalue string\n195|\t\ttext  string\n196|\t}{\n197|\t\t{\n198|\t\t\tname: \"provider vs request\", probe: probe,\n199|\t\t\tfacts: ProbeHostFacts{ExpectedProviderID: \"other-provider\", ExpectedKind: CandidateBuiltin, ManifestDigest: digest, Manifest: manifest},\n200|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"requested provider\",\n201|\t\t},\n202|\t\t{\n203|\t\t\tname:  \"provider vs manifest\",\n204|\t\t\tprobe: func() Probe { mutated := probe; mutated.ProviderID = \"other-provider\"; return mutated }(),\n205|\t\t\tfacts: func() ProbeHostFacts { fixed := facts; fixed.ExpectedProviderID = \"other-provider\"; return fixed }(),\n206|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"verified manifest\",\n207|\t\t},\n208|\t\t{\n209|\t\t\tname:  \"manifest digest\",\n210|\t\t\tprobe: func() Probe { mutated := probe; mutated.ManifestDigest = otherDigest; return mutated }(),\n211|\t\t\tfacts: facts, key: \"member\", value: \"adapter_manifest_digest\", text: \"host-computed digest\",\n212|\t\t},\n213|\t\t{\n214|\t\t\tname:  \"adapter version\",\n215|\t\t\tprobe: func() Probe { mutated := probe; mutated.AdapterVersion = \"9.9.9\"; return mutated }(),\n216|\t\t\tfacts: facts, key: \"member\", value: \"adapter_version\", text: \"verified manifest\",\n217|\t\t},\n218|\t\t{\n219|\t\t\tname:  \"unrequested tuple\",\n220|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.EnvironmentID = \"other.env\"; return mutated }(),\n221|\t\t\tfacts: facts, key: \"environment\", value: \"other.env\", text: \"outside the manifest environment\",\n222|\t\t},\n223|\t\t{\n224|\t\t\tname:  \"tuple version disagrees\",\n225|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.AdapterVersion = \"0.0.1\"; return mutated }(),\n226|\t\t\tfacts: facts, key: \"member\", value: \"environment\", text: \"probe adapter version\",\n227|\t\t},\n228|\t} {\n229|\t\tt.Run(test.name, func(t *testing.T) {\n230|\t\t\terr := CheckProbe(test.probe, test.facts)\n231|\t\t\tif test.key == \"environment\" && (test.name == \"unrequested tuple\") {\n232|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", test.key, test.value, test.text)\n233|\t\t\t\treturn\n234|\t\t\t}\n235|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n236|\t\t})\n237|\t}\n238|}\n239|\n240|func TestCheckProbeRequest(t *testing.T) {\n241|\tcandidate := fixtureCandidate()\n242|\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, candidate); err != nil {\n243|\t\tt.Fatalf(\"CheckProbeRequest: %v\", err)\n244|\t}\n245|\tif err := CheckProbeRequest(\"other-provider\", CandidateBuiltin, candidate); err == nil {\n246|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign provider identifier\")\n247|\t} else {\n248|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n249|\t}\n250|\tif err := CheckProbeRequest(fixtureProviderID, CandidateExternal, candidate); err == nil {\n251|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign candidate kind\")\n252|\t} else {\n253|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n254|\t}\n255|}\n256|\n257|func TestCheckTargetWriteGates(t *testing.T) {\n258|\tprobe, _ := fixtureValidProbe(t)\n259|\tprovider := map[string]ProviderCapability{\n260|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n261|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n262|\t}\n263|\tif err := CheckTargetWriteGates(probe.Capabilities, provider); err != nil {\n264|\t\tt.Fatalf(\"CheckTargetWriteGates: %v\", err)\n265|\t}\n266|\t// The disjunction: disabling canonical_write alone still\n267|\t// passes through official_import, and vice versa.\n268|\twithoutCanonical := cloneCapabilities(probe.Capabilities)\n269|\twithoutCanonical[\"canonical_write\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n270|\tif err := CheckTargetWriteGates(withoutCanonical, provider); err != nil {\n271|\t\tt.Fatalf(\"CheckTargetWriteGates without canonical_write: %v\", err)\n272|\t}\n273|\twithoutImport := cloneCapabilities(probe.Capabilities)\n274|\twithoutImport[\"official_import\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n275|\tif err := CheckTargetWriteGates(withoutImport, provider); err != nil {\n276|\t\tt.Fatalf(\"CheckTargetWriteGates without official_import: %v\", err)\n277|\t}\n278|\t// Both members of the pair down: refused, naming the pair.\n279|\twithoutBoth := cloneCapabilities(probe.Capabilities)\n280|\twithoutBoth[\"canonical_write\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n281|\twithoutBoth[\"official_import\"] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n282|\terr := CheckTargetWriteGates(withoutBoth, provider)\n283|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"canonical_write|official_import\", \"neither usable\")\n284|\t// Each remaining required adapter capability is broken alone.\n285|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n286|\t\twithout := cloneCapabilities(probe.Capabilities)\n287|\t\twithout[name] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n288|\t\terr := CheckTargetWriteGates(without, provider)\n289|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", name, \"usable adapter capability\")\n290|\t}\n291|\t// Each provider capability is broken alone, including the\n292|\t// enabled-bit half: available-but-disabled is not usable.\n293|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n294|\t\tunsupported := map[string]ProviderCapability{\n295|\t\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n296|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n297|\t\t}\n298|\t\tunsupported[name] = ProviderCapability{Status: \"unsupported\", Enabled: false}\n299|\t\terr := CheckTargetWriteGates(probe.Capabilities, unsupported)\n300|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:\"+name, \"usable provider capability\")\n301|\t\tdisabled := map[string]ProviderCapability{\n302|\t\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n303|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n304|\t\t}\n305|\t\tdisabled[name] = ProviderCapability{Status: \"available\", Enabled: false}\n306|\t\terr = CheckTargetWriteGates(probe.Capabilities, disabled)\n307|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:\"+name, \"usable provider capability\")\n308|\t}\n309|\t// A missing provider surface is refused, never defaulted.\n310|\tmissing := map[string]ProviderCapability{\n311|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n312|\t}\n313|\terr = CheckTargetWriteGates(probe.Capabilities, missing)\n314|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:native_resume\", \"usable provider capability\")\n315|}\n316|\n317|func cloneCapabilities(capabilities map[string]Capability) map[string]Capability {\n318|\tcloned := make(map[string]Capability, len(capabilities))\n319|\tfor name, value := range capabilities {\n320|\t\tcloned[name] = value\n321|\t}\n322|\treturn cloned\n323|}\n324|\n325|// TestTargetWriteComplementDerivesNonRequired pins the other side\n326|// of the gate: every registry capability outside the required set\n327|// is not required, so a mutant that adds a requirement fails here\n328|// with the complement named.\n329|func TestTargetWriteComplementDerivesNonRequired(t *testing.T) {\n330|\trequired := map[string]bool{\n331|\t\t\"canonical_write\": true, \"official_import\": true,\n332|\t\t\"native_read_back\": true, \"native_resume_plan\": true, \"workspace_binding\": true,\n333|\t\t\"provider:portable_store\": true, \"provider:native_resume\": true,\n334|\t}\n335|\tvar complement []string\n336|\tfor _, name := range capabilityOrder {\n337|\t\tif !required[name] {\n338|\t\t\tcomplement = append(complement, name)\n339|\t\t}\n340|\t}\n341|\tif len(complement) == 0 {\n342|\t\tt.Fatal(\"derived an empty non-required complement; the check is blind\")\n343|\t}\n344|\tprobe, _ := fixtureValidProbe(t)\n345|\tprovider := map[string]ProviderCapability{\n346|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n347|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n348|\t}\n349|\t// Disabling every complement capability at once still passes:\n350|\t// none of them gates a target write.\n351|\tdisabled := cloneCapabilities(probe.Capabilities)\n352|\tfor _, name := range complement {\n353|\t\tdisabled[name] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n354|\t}\n355|\tif err := CheckTargetWriteGates(disabled, provider); err != nil {\n356|\t\tt.Fatalf(\"CheckTargetWriteGates with complement disabled: %v\", err)\n357|\t}\n358|\tt.Logf(\"non-required complement: %d/%d capabilities\", len(complement), len(capabilityOrder))\n359|}\n360|\n361|func TestDoctorRequiredCapabilities(t *testing.T) {\n362|\ttarget := DoctorRequiredCapabilities(DirectionTargetWrite, false)\n363|\tif len(target) != 4 || target[0] != \"canonical_write\" {\n364|\t\tt.Fatalf(\"target required = %v, want [canonical_write native_read_back native_resume_plan workspace_binding]\", target)\n365|\t}\n366|\tofficial := DoctorRequiredCapabilities(DirectionTargetWrite, true)\n367|\tif len(official) != 4 || official[0] != \"official_import\" {\n368|\t\tt.Fatalf(\"official-import required = %v, want official_import first\", official)\n369|\t}\n370|\tif got := DoctorRequiredCapabilities(DirectionSourceRead, false); len(got) != 0 {\n371|\t\tt.Fatalf(\"source required = %v, want empty: Section 7.8 names no source set\", got)\n372|\t}\n373|}"}}}
