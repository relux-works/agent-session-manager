:= sectionTableWindow(text, \"The exact request and success <code>body</code> registry is:\", \"Candidate objects are addressed only by their exact\")\n28|\tif !ok {\n29|\t\tt.Fatal(\"Section 7.8 registry table window not found; the scan is broken, not the registry\")\n30|\t}\n31|\trequests = map[string][]string{}\n32|\tsuccesses = map[string][]string{}\n33|\tfor _, line := range strings.Split(table, \"\\n\") {\n34|\t\tif !strings.HasPrefix(line, \"| <code>\") {\n35|\t\t\tcontinue\n36|\t\t}\n37|\t\t// Cells split on unescaped pipes only: body cells\n38|\t\t// carry \\| vocabulary alternations that never\n39|\t\t// separate columns.\n40|\t\tcells := splitTableCells(line)\n41|\t\tif len(cells) < 4 {\n42|\t\t\tcontinue\n43|\t\t}\n44|\t\tname := strings.TrimSpace(cells[1])\n45|\t\tname = strings.TrimPrefix(name, \"<code>\")\n46|\t\tname = strings.TrimSuffix(name, \"</code>\")\n47|\t\tif !validOperation(name) {\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\toperations = append(operations, name)\n51|\t\trequests[name] = parseBodyMembers(t, cells[2])\n52|\t\tif body := parseBodyMembers(t, cells[3]); body != nil {\n53|\t\t\tsuccesses[name] = body\n54|\t\t}\n55|\t}\n56|\tif len(operations) != 14 {\n57|\t\tt.Fatalf(\"derived %d operation rows, want 14; the table scan is broken, not the registry\", len(operations))\n58|\t}\n59|\tfor _, name := range operations {\n60|\t\tif len(requests[name]) == 0 && name != \"manifest\" {\n61|\t\t\tt.Fatalf(\"derived no request members for %q; the parser is broken\", name)\n62|\t\t}\n63|\t}\n64|\treturn operations, requests, successes\n65|}\n66|\n67|// parseBodyMembers extracts the member names from one table cell's\n68|// first {…} span, splitting top-level commas only: nested\n69|// closed-map parens and uint53 brackets never separate members.\n70|// A cell with no brace span (a prose body reference) yields nil.\n71|func parseBodyMembers(t *testing.T, cell string) []string {\n72|\tt.Helper()\n73|\tstart := strings.Index(cell, \"{\")\n74|\tif start < 0 {\n75|\t\treturn nil\n76|\t}\n77|\tdepth := 0\n78|\tend := -1\n79|\tfor index := start; index < len(cell); index++ {\n80|\t\tswitch cell[index] {\n81|\t\tcase '{', '[', '(':\n82|\t\t\tdepth++\n83|\t\tcase '}', ']', ')':\n84|\t\t\tdepth--\n85|\t\t\tif depth == 0 {\n86|\t\t\t\tend = index\n87|\t\t\t}\n88|\t\t}\n89|\t\tif end >= 0 {\n90|\t\t\tbreak\n91|\t\t}\n92|\t}\n93|\tif end < 0 {\n94|\t\tt.Fatalf(\"unbalanced body span in %q\", cell)\n95|\t}\n96|\tspan := strings.ReplaceAll(cell[start+1:end], \"<code>\", \"\")\n97|\tspan = strings.ReplaceAll(span, \"</code>\", \"\")\n98|\tif strings.TrimSpace(span) == \"\" {\n99|\t\treturn []string{}\n100|\t}\n101|\tvar members []string\n102|\tdepth = 0\n103|\tcurrent := \"\"\n104|\tfor index := 0; index < len(span); index++ {\n105|\t\tchar := span[index]\n106|\t\tswitch char {\n107|\t\tcase '{', '[', '(':\n108|\t\t\tdepth++\n109|\t\t\tcurrent += string(char)\n110|\t\tcase '}', ']', ')':\n111|\t\t\tdepth--\n112|\t\t\tcurrent += string(char)\n113|\t\tcase ',':\n114|\t\t\tif depth == 0 {\n115|\t\t\t\tmembers = append(members, memberName(strings.TrimSpace(current)))\n116|\t\t\t\tcurrent = \"\"\n117|\t\t\t} else {\n118|\t\t\t\tcurrent += string(char)\n119|\t\t\t}\n120|\t\tdefault:\n(more lines below)"}}}
