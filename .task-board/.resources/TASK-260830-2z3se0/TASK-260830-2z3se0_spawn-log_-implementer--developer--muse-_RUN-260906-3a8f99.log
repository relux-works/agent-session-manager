{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c651","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":387,"recorded_at":1780531400000769,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"31a041fa-6b97-4789-a466-4d2afeae3d0c"},"task_id":"31a041fa-6b97-4789-a466-4d2afeae3d0c","event":{"kind":"output","task_id":"31a041fa-6b97-4789-a466-4d2afeae3d0c","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/protocol.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Wire constants of pinned specification Section 7.8. The protocol\n12|// identifier and version are exact: the adapter speaks 1.0.0 in the\n13|// same trusted executable as Provider Protocol 2.0.0, and anything\n14|// else on the wire is a session_adapter_protocol_error, never a\n15|// negotiation.\n16|const (\n17|\t// ProtocolID is the exact protocol member every request and\n18|\t// response envelope carries.\n19|\tProtocolID = \"urn:ax:protocol:session-adapter\"\n20|\t// ProtocolVersion is the exact protocol_version member this host\n21|\t// writes and the only one it accepts a response under.\n22|\tProtocolVersion = \"1.0.0\"\n23|\t// ProtocolMajor is the major this host implements. Section 7.8\n24|\t// defines no multi-major negotiation for the adapter, so a\n25|\t// different major is an invalid envelope, not a downgrade.\n26|\tProtocolMajor = 1\n27|\t// ErrorVersion is the Structured Error version every failure\n28|\t// envelope carries: Session Adapter 1.0 statically binds\n29|\t// Structured Error 1.1.0.\n30|\tErrorVersion = axerror.Version110\n31|\t// MaxFrameBytes bounds one JSONL line in either direction:\n32|\t// Section 7.8 inherits Section 7.2's rule that every line is one\n33|\t// complete UTF-8 JSON object no larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|)\n36|\n37|// Operation names one Section 7.8 registry entry. The registry is\n38|// closed: dispatch refuses any other name locally, before any adapter\n39|// surface is touched.\n40|type Operation string\n41|\n42|// Section 7.8 operation registry in the section's table order. The\n43|// inventory test derives this list from the pinned specification\n44|// text and requires exact ordered equality, so a dropped, added, or\n45|// reordered entry reddens there rather than passing silently.\n46|const (\n47|\tOpManifest       Operation = \"manifest\"\n48|\tOpProbe          Operation = \"probe\"\n49|\tOpDiscover       Operation = \"discover\"\n50|\tOpInspect        Operation = \"inspect\"\n51|\tOpSnapshotProof  Operation = \"snapshot-proof\"\n52|\tOpCapturePlan    Operation = \"capture-plan\"\n53|\tOpCapture        Operation = \"capture\"\n54|\tOpNormalize      Operation = \"normalize\"\n55|\tOpProjectionPlan Operation = \"projection-plan\"\n56|\tOpProject        Operation = \"project\"\n57|\tOpReadBack       Operation = \"read-back\"\n58|\tOpValidate       Operation = \"validate\"\n59|\tOpResumePlan     Operation = \"resume-plan\"\n60|\tOpDoctor         Operation = \"doctor\"\n61|)\n62|\n63|// operationOrder is the single construction site of the dispatch\n64|// registry.\n65|var operationOrder = []Operation{\n66|\tOpManifest,\n67|\tOpProbe,\n68|\tOpDiscover,\n69|\tOpInspect,\n70|\tOpSnapshotProof,\n71|\tOpCapturePlan,\n72|\tOpCapture,\n73|\tOpNormalize,\n74|\tOpProjectionPlan,\n75|\tOpProject,\n76|\tOpReadBack,\n77|\tOpValidate,\n78|\tOpResumePlan,\n79|\tOpDoctor,\n80|}\n81|\n82|// Operations returns the dispatch registry in section order. The\n83|// result is a copy; the registry cannot be mutated through it.\n84|func Operations() []string {\n85|\tout := make([]string, 0, len(operationOrder))\n86|\tfor _, operation := range operationOrder {\n87|\t\tout = append(out, string(operation))\n88|\t}\n89|\treturn out\n90|}\n91|\n92|// validOperation reports whether the name is a registry member.\n93|func validOperation(name string) bool {\n94|\tfor _, operation := range operationOrder {\n95|\t\tif string(operation) == name {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// The refusal constructors below are declared as variables so the\n103|// inventory gate can observe every exercised refusal site. Each is\n104|// the single construction site for its failure class; production\n105|// code must not build *axerror.Error any other way.\n106|//\n107|// failInvalid reports a caller error caught before any adapter\n108|// surface is touched: a required set naming an unknown capability, a\n109|// binding the caller built from unobserved facts. failProtocol\n110|// reports an unusable adapter frame: an invalid envelope, a body\n111|// outside its closed shape, a digest mismatch, a partial,\n112|// malformed, over-limit, or escaped result. failUnknownOperation\n113|// reports a name outside the closed registry. failCapability\n114|// reports an operation the adapter does not implement.\n115|// failUnsupportedTuple reports an environment the signed registry\n116|// does not admit. failIntegrity reports a binding observation that\n117|// cannot be reconciled to trusted candidate facts: a failed or\n118|// partial read, or a before-call fact that no longer equals the\n119|// freshly read fact and the Journal binding.\n120|//\n(more lines below)"}}}
