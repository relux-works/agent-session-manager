alues reach the production decoder instead of\n169|// failing the test scaffolding.\n170|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n171|\tt.Helper()\n172|\tvar members map[string]json.RawMessage\n173|\tif err := json.Unmarshal(body, &members); err != nil {\n174|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n175|\t}\n176|\tmembers[member] = json.RawMessage(replacement)\n177|\tnames := make([]string, 0, len(members))\n178|\tfor name := range members {\n179|\t\tnames = append(names, name)\n180|\t}\n181|\tsort.Strings(names)\n182|\tparts := make([]string, 0, len(members))\n183|\tfor _, name := range names {\n184|\t\tquoted, err := json.Marshal(name)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"mutateMember: %v\", err)\n187|\t\t}\n188|\t\tparts = append(parts, string(quoted)+\":\"+string(members[name]))\n189|\t}\n190|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n191|}\n192|\n193|// dropMember returns the object without one top-level member.\n194|func dropMember(t *testing.T, body []byte, member string) []byte {\n195|\tt.Helper()\n196|\tvar members map[string]json.RawMessage\n197|\tif err := json.Unmarshal(body, &members); err != nil {\n198|\t\tt.Fatalf(\"dropMember: fixture is not JSON: %v\", err)\n199|\t}\n200|\tdelete(members, member)\n201|\tdropped, err := json.Marshal(members)\n202|\tif err != nil {\n203|\t\tt.Fatalf(\"dropMember: %v\", err)\n204|\t}\n205|\treturn dropped\n206|}\n207|\n208|// failureObject requires a Structured Error and returns it.\n209|func failureObject(t *testing.T, err error) *axerror.Error {\n210|\tt.Helper()\n211|\tif err == nil {\n212|\t\tt.Fatal(\"want refusal, got nil error\")\n213|\t}\n214|\tfailure, ok := err.(*axerror.Error)\n215|\tif !ok {\n216|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n217|\t}\n218|\treturn failure\n219|}\n220|\n221|// failureCode returns the stable code of a refusal.\n222|func failureCode(t *testing.T, err error) axerror.Code {\n223|\tt.Helper()\n224|\treturn failureObject(t, err).Code()\n225|}\n226|\n227|// failureDetail returns one string diagnostic of a refusal.\n228|func failureDetail(t *testing.T, err error, key string) string {\n229|\tt.Helper()\n230|\tdetail, ok := failureObject(t, err).Detail(key)\n231|\tif !ok {\n232|\t\tt.Fatalf(\"refusal %v carries no %q detail\", err, key)\n233|\t}\n234|\ttext, ok := detail.(string)\n235|\tif !ok {\n236|\t\tt.Fatalf(\"refusal %v detail %q is %T, want string\", err, key, detail)\n237|\t}\n238|\treturn text\n239|}\n240|\n241|// requireRefusal asserts the full arm identity of a refusal: the\n242|// stable code, one distinguishing diagnostic, the detail naming\n243|// the rule in the human text, and the non-retryable bit. Asserting\n244|// the distinguishing diagnostic pins which arm fired: deleting a\n245|// gate slides the refusal to a lower arm carrying the same code\n246|// with a different diagnostic, and the slide reddens here.\n247|func requireRefusal(t *testing.T, err error, code axerror.Code, detailKey, detailValue, text string) {\n248|\tt.Helper()\n249|\tif failureCode(t, err) != code {\n250|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n251|\t}\n252|\tif got := failureDetail(t, err, detailKey); got != detailValue {\n253|\t\tt.Fatalf(\"%s detail = %q, want %q (error: %v)\", detailKey, got, detailValue, err)\n254|\t}\n255|\tif !strings.Contains(err.Error(), text) {\n256|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, text)\n257|\t}\n258|\tif failureObject(t, err).Retryable() {\n259|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n260|\t}\n261|}\n262|\n263|// canonicalJSON canonicalizes test scaffolding. It is test-only\n264|// assembly, never a verdict: every verdict comes from production.\n265|func canonicalJSON(t *testing.T, body []byte) []byte {\n266|\tt.Helper()\n267|\tcanonical, err := canonicaljson.Canonicalize(body)\n268|\tif err != nil {\n269|\t\tt.Fatalf(\"canonicalJSON: %v\", err)\n270|\t}\n271|\treturn canonica