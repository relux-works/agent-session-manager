{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c857","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":646,"recorded_at":1780531400001287,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741df41a743287054d996ec78c7a","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/operations_semantic_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|func TestDiscoverPartialCursorComplement(t *testing.T) {\n8|\tmanifestDigest := fixtureManifestDigestText(t)\n9|\trequest := fixtureRequestBody(t, OpDiscover, manifestDigest)\n10|\tdecoded, err := CheckRequestBody(OpDiscover, request)\n11|\tif err != nil {\n12|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n13|\t}\n14|\tfacts := SuccessFacts{Context: decoded}\n15|\tbase := fixtureSuccessBody(t, OpDiscover, requestContextOf(t, request), manifestDigest)\n16|\tcombinations := []struct {\n17|\t\tname    string\n18|\t\tpartial string\n19|\t\tcursor  string\n20|\t\tok      bool\n21|\t}{\n22|\t\t{\"complete without cursor\", `false`, `null`, true},\n23|\t\t{\"partial with cursor\", `true`, `\"cursor-9\"`, true},\n24|\t\t{\"complete with cursor\", `false`, `\"cursor-9\"`, false},\n25|\t\t{\"partial without cursor\", `true`, `null`, false},\n26|\t}\n27|\tfor _, test := range combinations {\n28|\t\tt.Run(test.name, func(t *testing.T) {\n29|\t\t\tbody := mutateMember(t, mutateMember(t, base, \"partial\", test.partial), \"next_cursor\", test.cursor)\n30|\t\t\terr := CheckSuccessBody(OpDiscover, body, facts)\n31|\t\t\tif test.ok && err != nil {\n32|\t\t\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n33|\t\t\t}\n34|\t\t\tif !test.ok && err == nil {\n35|\t\t\t\tt.Fatal(\"admitted an incoherent partial/cursor pair\")\n36|\t\t\t}\n37|\t\t\tif !test.ok {\n38|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"partial\", \"disagrees with the cursor\")\n39|\t\t\t}\n40|\t\t})\n41|\t}\n42|}\n43|\n44|func TestCapturePlanDigestEquality(t *testing.T) {\n45|\tmanifestDigest := fixtureManifestDigestText(t)\n46|\trequest := fixtureRequestBody(t, OpCapturePlan, manifestDigest)\n47|\tdecoded, err := CheckRequestBody(OpCapturePlan, request)\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n50|\t}\n51|\tfacts := SuccessFacts{Context: decoded}\n52|\tbase := fixtureSuccessBody(t, OpCapturePlan, requestContextOf(t, request), manifestDigest)\n53|\tif err := CheckSuccessBody(OpCapturePlan, base, facts); err != nil {\n54|\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n55|\t}\n56|\tmismatched := mutateMember(t, base, \"capture_plan_digest\", quote(fixtureDigest(\"other-plan\")))\n57|\terr = CheckSuccessBody(OpCapturePlan, mismatched, facts)\n58|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"capture_plan_digest\", \"does not equal the plan digest\")\n59|}\n60|\n61|func TestValidateResultRules(t *testing.T) {\n62|\tmanifestDigest := fixtureManifestDigestText(t)\n63|\tbuild := func(t *testing.T, mode string, archive bool) ([]byte, SuccessFacts) {\n64|\t\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n65|\t\tif mode != \"staged\" {\n66|\t\t\trequest = mutateMember(t, request, \"mode\", quote(mode))\n67|\t\t\tif archive {\n68|\t\t\t\tfor _, member := range []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"} {\n69|\t\t\t\t\trequest = mutateMember(t, request, member, `null`)\n70|\t\t\t\t}\n71|\t\t\t}\n72|\t\t}\n73|\t\tdecoded, err := CheckRequestBody(OpValidate, request)\n74|\t\tif err != nil {\n75|\t\t\tt.Fatalf(\"CheckRequestBody(%q): %v\", mode, err)\n76|\t\t}\n77|\t\treturn request, SuccessFacts{Context: decoded, ValidateMode: mode}\n78|\t}\n79|\tt.Run(\"staged valid\", func(t *testing.T) {\n80|\t\trequest, facts := build(t, \"staged\", false)\n81|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n82|\t\tif err := CheckSuccessBody(OpValidate, success, facts); err != nil {\n83|\t\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n84|\t\t}\n85|\t})\n86|\tt.Run(\"archive request carries target\", func(t *testing.T) {\n87|\t\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n88|\t\trequest = mutateMember(t, request, \"mode\", `\"archive\"`)\n89|\t\t_, err := CheckRequestBody(OpValidate, request)\n90|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"projection_plan_id\", \"carries a target member\")\n91|\t})\n92|\tt.Run(\"staged request misses target\", func(t *testing.T) {\n93|\t\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n94|\t\trequest = mutateMember(t, request, \"projection_plan_id\", `null`)\n95|\t\t_, err := CheckRequestBody(OpValidate, request)\n96|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"projection_plan_id\", \"misses a target member\")\n97|\t})\n98|\tt.Run(\"mode mismatch\", func(t *testing.T) {\n99|\t\trequest, facts := build(t, \"staged\", false)\n100|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n101|\t\tsuccess = mutateMember(t, success, \"mode\", `\"live\"`)\n102|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n103|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"mode\", \"does not echo\")\n104|\t})\n105|\tt.Run(\"valid with failed check\", func(t *testing.T) {\n106|\t\trequest, facts := build(t, \"staged\", false)\n107|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n108|\t\tsuccess = mutateMember(t, success, \"structural_valid\", `false`)\n109|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n110|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"valid\", \"failed structural or semantic\")\n111|\t})\n112|\tt.Run(\"valid with failed applicable check\", func(t *testing.T) {\n113|\t\trequest, facts := build(t, \"staged\", false)\n114|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n115|\t\tsuccess = mutateMember(t, success, \"identity_valid\", `false`)\n116|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n117|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"identity_valid\", \"failed applicable check\")\n118|\t})\n119|\tt.Run(\"valid with error finding\", func(t *testing.T) {\n120|\t\trequest, facts := build(t, \"staged\", false)\n121|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n122|\t\tfinding := `{\"severity\":\"error\",\"code\":\"val-1\",\"message\":\"broken\",\"remediation\":null,\"extensions\":{}}`\n123|\t\tsuccess = mutateMember(t, success, \"findings\", `[`+finding+`]`)\n124|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n125|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"findings\", \"error finding\")\n126|\t})\n127|\tt.Run(\"invalid result admits failures\", func(t *testing.T) {\n128|\t\trequest, facts := build(t, \"staged\", false)\n129|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n130|\t\tsuccess = mutateMember(t, success, \"valid\", `false`)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
