{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64d","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":385,"recorded_at":1780531400000765,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"44984197-8842-468a-b628-17f6c19d7d0e"},"task_id":"44984197-8842-468a-b628-17f6c19d7d0e","event":{"kind":"output","task_id":"44984197-8842-468a-b628-17f6c19d7d0e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/context.go`.\n(179 line(s) above)\n180|\t}\n181|\treturn scalar.SHA256Digest(canonical), nil\n182|}\n183|\n184|// VerifyRequestDigest recomputes the digest of the canonical request\n185|// body the host sent and requires it to equal the context's\n186|// request_digest: the adapter answers for exactly this body, not\n187|// for a neighbouring call. A changed body under a replayed context\n188|// is a protocol error, never a retried mutation.\n189|func VerifyRequestDigest(context CallContext, requestBody []byte) error {\n190|\tdigest, err := RequestDigestFor(requestBody)\n191|\tif err != nil {\n192|\t\tfailure, faultErr := failProtocol(\"call request body is not canonical JSON\", \"body\")\n193|\t\tif faultErr != nil {\n194|\t\t\treturn faultErr\n195|\t\t}\n196|\t\treturn failure\n197|\t}\n198|\tif digest.String() != context.RequestDigest {\n199|\t\tfailure, err := failProtocol(\"call context request digest does not match the request body\", \"request_digest\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\treturn nil\n206|}\n207|\n208|// CheckContextEcho requires the success body to carry the request\n209|// context byte-for-byte: Section 7.8 states every success echoes\n210|// the context exactly. A rebuilt context — even a semantically\n211|// equal one — is a protocol error, because only byte identity\n212|// proves the adapter answered this call. DecodeCallContext\n213|// already returns the canonical bytes, so the comparison reuses\n214|// them: a second canonicalization of the same bytes could only\n215|// repeat its verdict, and an arm that cannot fire is not\n216|// carried.\n217|func CheckContextEcho(sent CallContext, echoed json.RawMessage) (CallContext, error) {\n218|\treceived, err := DecodeCallContext(echoed)\n219|\tif err != nil {\n220|\t\treturn CallContext{}, err\n221|\t}\n222|\tif !bytes.Equal(received.raw, sent.raw) {\n223|\t\tfailure, err := failProtocol(\"success context does not echo the request context byte-for-byte\", \"context\")\n224|\t\tif err != nil {\n225|\t\t\treturn CallContext{}, err\n226|\t\t}\n227|\t\treturn CallContext{}, failure\n228|\t}\n229|\treturn received, nil\n230|}\n231|\n232|// readAuthorityMembers is the exact ReadAuthority member set:\n233|// authority_id, purpose, root_handle_names, expires_at, and\n234|// extensions. Handle names identify host-opened descriptors\n235|// delivered out of band; they are never paths.\n236|var readAuthorityMembers = map[string]bool{\n237|\t\"authority_id\":      true,\n238|\t\"purpose\":           true,\n239|\t\"root_handle_names\": true,\n240|\t\"expires_at\":        true,\n241|\t\"extensions\":        true,\n242|}\n243|\n244|// readAuthorityRequired lists readAuthorityMembers in order.\n245|var readAuthorityRequired = []string{\n246|\t\"authority_id\",\n247|\t\"purpose\",\n248|\t\"root_handle_names\",\n249|\t\"expires_at\",\n250|\t\"extensions\",\n251|}\n252|\n253|// ReadAuthority is one validated read authority.\n254|type ReadAuthority struct {\n255|\tAuthorityID string\n256|\tPurpose     string\n257|\tHandleNames []string\n258|\tExpiresAt   string\n259|}\n260|\n261|// DecodeReadAuthority validates one closed ReadAuthority: the\n262|// purpose in source_native|target_staged|target_live and 1..128\n263|// sorted unique handle names of 1..128 characters each.\n264|func DecodeReadAuthority(raw json.RawMessage) (ReadAuthority, error) {\n265|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n266|\tif fault != nil {\n267|\t\tfailure, err := failProtocol(\"read authority \"+fault.detail, fault.member)\n268|\t\tif err != nil {\n269|\t\t\treturn ReadAuthority{}, err\n270|\t\t}\n271|\t\treturn ReadAuthority{}, failure\n272|\t}\n273|\tif name, unknown := unknownMember(members, readAuthorityMembers); unknown {\n274|\t\tfailure, err := failProtocol(\"read authority carries unknown member\", name)\n275|\t\tif err != nil {\n276|\t\t\treturn ReadAuthority{}, err\n277|\t\t}\n278|\t\treturn ReadAuthority{}, failure\n279|\t}\n280|\tif name, missing := missingMember(members, readAuthorityRequired); missing {\n281|\t\tfailure, err := failProtocol(\"read authority misses a required member\", name)\n282|\t\tif err != nil {\n283|\t\t\treturn ReadAuthority{}, err\n284|\t\t}\n285|\t\treturn ReadAuthority{}, failure\n286|\t}\n287|\tauthorityID, ok := checkUUIDv7(members[\"authority_id\"])\n288|\tif !ok {\n289|\t\tfailure, err := failProtocol(\"read authority identifier is not a UUIDv7\", \"authority_id\")\n290|\t\tif err != nil {\n291|\t\t\treturn ReadAuthority{}, err\n292|\t\t}\n293|\t\treturn ReadAuthority{}, failure\n294|\t}\n295|\tpurpose, ok := rawString(members[\"purpose\"])\n296|\tif !ok || !validReadPurpose(purpose) {\n297|\t\tfailure, err := failProtocol(\"read authority purpose is outside source_native|target_staged|target_live\", \"purpose\")\n298|\t\tif err != nil {\n299|\t\t\treturn ReadAuthority{}, err\n(more lines below)"}}}
