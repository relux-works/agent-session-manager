{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c507","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":222,"recorded_at":1780531400000439,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0741c0c237c309b199381e3bd00be","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n15|)\n16|\n17|// This file is the closed-vocabulary census. It exists because a\n18|// new closed set in production — a map consulted for membership,\n19|// a slice looped for admission, a switch classifying inputs —\n20|// passes every behavioral test that never names it. The census\n21|// finds the membership surface by parsing production source and\n22|// fails closed on anything with no registered derivation, so the\n23|// surface cannot grow something unwitnessed.\n24|//\n25|// Three checks:\n26|// TestClosedVocabularyTablesAreRegistered scans every\n27|// package-level var shaped like a vocabulary (map[string]bool,\n28|// []string, []Operation, map[Operation]...) and requires each in\n29|// the registration table below with its consultation proof.\n30|// TestClosedMemberSetsAreDerivedFromSpec parses every closed\n31|// body from the pinned document and requires exact ordered\n32|// equality with the production member tables: a dropped, added,\n33|// or reordered member reddens here.\n34|// TestAllProductionSwitchesAreClassified allows only switches\n35|// dispatching on the validated operation plus the UTF-16 hex\n36|// classifier; any other switch is a membership gate hiding spot\n37|// and fails.\n38|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n39|// against its verbatim spec union as a set.\n40|//\n41|// An empty scan, an empty derivation, or an unparseable file\n42|// fails closed throughout: a domain that silently derives\n43|// nothing is not a measurement.\n44|\n45|// registeredVocabulary is one production vocabulary table with\n46|// its consultation proof: the production function or call\n47|// pattern that consults it for membership.\n48|type registeredVocabulary struct {\n49|\tname       string\n50|\tconsulted  string\n51|\tspecMember string\n52|}\n53|\n54|// vocabularyRegistrations lists every package-level vocabulary\n55|// table. A production table with no row here fails the census.\n56|var vocabularyRegistrations = []registeredVocabulary{\n57|\t{name: \"operationOrder\", consulted: \"validOperation\", specMember: \"Section 7.8 operation table\"},\n58|\t{name: \"requestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 request envelope sentence\"},\n59|\t{name: \"requestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 request envelope sentence\"},\n60|\t{name: \"successMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 success envelope rule\"},\n61|\t{name: \"successRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 success envelope rule\"},\n62|\t{name: \"failureMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 failure envelope rule\"},\n63|\t{name: \"failureRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 failure envelope rule\"},\n64|\t{name: \"capabilityOrder\", consulted: \"decodeCapabilities\", specMember: \"Section 7.8 capability sentence\"},\n65|\t{name: \"manifestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 manifest table\"},\n66|\t{name: \"manifestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 manifest table\"},\n67|\t{name: \"probeMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 probe sentence\"},\n68|\t{name: \"probeRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 probe sentence\"},\n69|\t{name: \"capabilityValueMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 capability value sentence\"},\n70|\t{name: \"capabilityValueRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 capability value sentence\"},\n71|\t{name: \"capabilityEvidences\", consulted: \"validCapabilityEvidence\", specMember: \"Section 7.8 evidence union\"},\n72|\t{name: \"capabilityStatuses\", consulted: \"validCapabilityStatus\", specMember: \"Section 7.8 status union\"},\n73|\t{name: \"contextMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n74|\t{name: \"contextRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n75|\t{name: \"readAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n76|\t{name: \"readAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n77|\t{name: \"objectAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n78|\t{name: \"objectAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n79|\t{name: \"objectPurposes\", consulted: \"validObjectPurpose\", specMember: \"Section 7.8 purpose union\"},\n80|\t{name: \"readPurposes\", consulted: \"validReadPurpose\", specMember: \"Section 7.8 ReadAuthority purpose union\"},\n81|\t{name: \"findingSeverities\", consulted: \"validFindingSeverity\", specMember: \"Section 7.8 severity union\"},\n82|\t{name: \"sourceSelectorMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n83|\t{name: \"sourceSelectorRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n84|\t{name: \"resourceLimitsMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n85|\t{name: \"resourceLimitsRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n86|\t{name: \"findingMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n87|\t{name: \"findingRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n88|\t{name: \"capturePlanItemMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n89|\t{name: \"capturePlanItemRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n90|\t{name: \"tupleMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n91|\t{name: \"tupleRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n92|\t{name: \"projectionStrategies\", consulted: \"validStrategy\", specMember: \"Section 13.14 strategy sentence\"},\n93|\t{name: \"fidelityDispositions\", consulted: \"validDisposition\", specMember: \"Section 13.14 disposition sentence\"},\n94|\t{name: \"captureClasses\", consulted: \"validCaptureClass\", specMember: \"Section 13.14 CaptureItem class column\"},\n95|\t{name: \"tupleArchitectures\", consulted: \"validTupleArchitecture\", specMember: \"Section 7.8 architecture union\"},\n96|\t{name: \"tupleKeyMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 key sentence\"},\n97|\t{name: \"tupleKeyRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 key sentence\"},\n98|\t{name: \"tupleEntryMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 entry sentence\"},\n99|\t{name: \"tupleEntryRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 entry sentence\"},\n100|\t{name: \"fixtureEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n101|\t{name: \"fixtureEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n102|\t{name: \"smokeEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n103|\t{name: \"smokeEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n104|\t{name: \"fidelityLimitMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n105|\t{name: \"fidelityLimitRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n106|\t{name: \"requestBodyMembers\", consulted: \"CheckRequestBody\", specMember: \"Section 7.8 operation table\"},\n107|\t{name: \"successBodyMembers\", consulted: \"CheckSuccessBody\", specMember: \"Section 7.8 operation table\"},\n108|\t{name: \"fidelityProfiles\", consulted: \"validFidelityProfile\", specMember: \"Section 7.8 profile union\"},\n109|\t{name: \"validateModes\", consulted: \"validValidateMode\", specMember: \"Section 7.8 validate row\"},\n110|\t{name: \"doctorResultMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 doctor row\"},\n111|\t{name: \"doctorResultRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 doctor row\"},\n112|}\n113|\n114|// TestClosedVocabularyTablesAreRegistered is the census: every\n115|// package-level vocabulary-shaped var must carry a registration\n116|// row naming its consultation. A new table without a row fails\n117|// here rather than passing silently.\n118|func TestClosedVocabularyTablesAreRegistered(t *testing.T) {\n119|\tdirectory, err := os.Getwd()\n120|\tif err != nil {\n121|\t\tt.Fatalf(\"census: %v\", err)\n122|\t}\n123|\tregistered := map[string]registeredVocabulary{}\n124|\tfor _, entry := range vocabularyRegistrations {\n125|\t\tif _, duplicate := registered[entry.name]; duplicate {\n126|\t\t\tt.Fatalf(\"census registers %q twice\", entry.name)\n127|\t\t}\n128|\t\tregistered[entry.name] = entry\n129|\t}\n130|\tfound, scanned := scanVocabularyTables(t, directory)\n131|\tif len(scanned) == 0 {\n132|\t\tt.Fatal(\"census scanned zero production files; the scanner is broken, not the package\")\n133|\t}\n134|\tif len(found) == 0 {\n135|\t\tt.Fatal(\"census found zero vocabulary tables; the scanner is broken, not the package\")\n136|\t}\n137|\tvar unregistered []string\n138|\tfor _, name := range found {\n139|\t\tentry, ok := registered[name]\n140|\t\tif !ok {\n141|\t\t\tunregistered = append(unregistered, name)\n142|\t\t\tcontinue\n143|\t\t}\n144|\t\tif entry.consulted == \"\" || entry.specMember == \"\" {\n145|\t\t\tt.Errorf(\"census registration of %q names no consultation or spec member\", name)\n146|\t\t}\n147|\t}\n148|\tsort.Strings(unregistered)\n149|\tif len(unregistered) > 0 {\n150|\t\tt.Fatalf(\"production vocabulary table(s) with no census registration:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n151|\t}\n152|\tvar orphaned []string\n153|\tfor name := range registered {\n154|\t\tpresent := false\n155|\t\tfor _, table := range found {\n156|\t\t\tif table == name {\n157|\t\t\t\tpresent = true\n158|\t\t\t\tbreak\n159|\t\t\t}\n160|\t\t}\n161|\t\tif !present {\n162|\t\t\torphaned = append(orphaned, name)\n163|\t\t}\n164|\t}\n165|\tsort.Strings(orphaned)\n166|\tif len(orphaned) > 0 {\n167|\t\tt.Fatalf(\"census registration(s) naming no production table:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n168|\t}\n169|\tt.Logf(\"vocabulary census: %d tables registered across %d files\", len(found), len(scanned))\n170|}\n171|\n172|// scanVocabularyTables returns every package-level var shaped\n173|// like a vocabulary: map[string]bool, []string, []Operation, or\n174|// map[Operation]... composites.\n175|func scanVocabularyTables(t *testing.T, directory string) ([]string, []string) {\n176|\tt.Helper()\n177|\tentries, err := os.ReadDir(directory)\n178|\tif err != nil {\n179|\t\tt.Fatalf(\"census: %v\", err)\n180|\t}\n181|\tvar found []string\n182|\tvar scanned []string\n183|\tfor _, entry := range entries {\n184|\t\tname := entry.Name()\n185|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n186|\t\t\tcontinue\n187|\t\t}\n188|\t\tscanned = append(scanned, name)\n189|\t\tpath := filepath.Join(directory, name)\n190|\t\tsource, err := os.ReadFile(path)\n191|\t\tif err != nil {\n192|\t\t\tt.Fatalf(\"census: %v\", err)\n193|\t\t}\n194|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n195|\t\tif err != nil {\n196|\t\t\tt.Fatalf(\"census: %v\", err)\n197|\t\t}\n198|\t\tfor _, declaration := range syntax.Decls {\n199|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n200|\t\t\tif !ok || general.Tok.String() != \"var\" {\n201|\t\t\t\tcontinue\n202|\t\t\t}\n203|\t\t\tfor _, specification := range general.Specs {\n204|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n205|\t\t\t\tif !ok || len(value.Values) != 1 {\n206|\t\t\t\t\tcontinue\n207|\t\t\t\t}\n208|\t\t\t\tif isVocabularyShape(value.Values[0]) {\n209|\t\t\t\t\tfor _, ident := range value.Names {\n210|\t\t\t\t\t\tfound = append(found, ident.Name)\n211|\t\t\t\t\t}\n212|\t\t\t\t}\n213|\t\t\t}\n214|\t\t}\n215|\t}\n216|\treturn found, scanned\n217|}\n218|\n219|// isVocabularyShape reports whether the initializer is a\n220|// vocabulary composite: a map or slice literal (element type is\n221|// irrelevant; registrations name the table, not its shape).\n222|func isVocabularyShape(node ast.Expr) bool {\n223|\tswitch node := node.(type) {\n224|\tcase *ast.CompositeLit:\n225|\t\tswitch node.Type.(type) {\n226|\t\tcase *ast.MapType, *ast.ArrayType:\n227|\t\t\treturn true\n228|\t\t}\n229|\t}\n230|\treturn false\n231|}\n232|\n233|// TestAllProductionSwitchesAreClassified allows only switches\n234|// dispatching on the validated operation plus the UTF-16 hex\n235|// classifier in readUTF16Escape. Any other switch is a\n236|// membership gate hiding spot and fails: membership lives in\n237|// tables the census sees, never in case arms it cannot.\n238|func TestAllProductionSwitchesAreClassified(t *testing.T) {\n239|\tdirectory, err := os.Getwd()\n240|\tif err != nil {\n241|\t\tt.Fatalf(\"switch census: %v\", err)\n242|\t}\n243|\tentries, err := os.ReadDir(directory)\n244|\tif err != nil {\n245|\t\tt.Fatalf(\"switch census: %v\", err)\n246|\t}\n247|\tscanned := 0\n248|\tclassified := 0\n249|\tvar unclassified []string\n250|\tfor _, entry := range entries {\n251|\t\tname := entry.Name()\n252|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n253|\t\t\tcontinue\n254|\t\t}\n255|\t\tscanned++\n256|\t\tpath := filepath.Join(directory, name)\n257|\t\tsource, err := os.ReadFile(path)\n258|\t\tif err != nil {\n259|\t\t\tt.Fatalf(\"switch census: %v\", err)\n260|\t\t}\n261|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n262|\t\tif err != nil {\n263|\t\t\tt.Fatalf(\"switch census: %v\", err)\n264|\t\t}\n265|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n266|\t\t\tstatement, ok := node.(*ast.SwitchStmt)\n267|\t\t\tif !ok {\n268|\t\t\t\treturn true\n269|\t\t\t}\n270|\t\t\tposition := filepath.Base(path)\n271|\t\t\tif tag, ok := statement.Tag.(*ast.Ident); ok && tag.Name == \"operation\" {\n272|\t\t\t\tclassified++\n273|\t\t\t\treturn true\n274|\t\t\t}\n275|\t\t\t// The UTF-16 hex classifier switches on nothing:\n276|\t\t\t// a tagless switch over digit ranges, which\n277|\t\t\t// classifies characters rather than admitting\n278|\t\t\t// members.\n279|\t\t\tif statement.Tag == nil {\n280|\t\t\t\tclassified++\n281|\t\t\t\treturn true\n282|\t\t\t}\n283|\t\t\tunclassified = append(unclassified, position)\n284|\t\t\treturn true\n285|\t\t})\n286|\t}\n287|\tif scanned == 0 {\n288|\t\tt.Fatal(\"switch census scanned zero production files\")\n289|\t}\n290|\tsort.Strings(unclassified)\n291|\tif len(unclassified) > 0 {\n292|\t\tt.Fatalf(\"unclassified production switch(es): %s\", strings.Join(unclassified, \", \"))\n293|\t}\n294|\tt.Logf(\"switch census: %d classified switches across %d files\", classified, scanned)\n295|}\n296|\n297|// sentenceEnd scans the first sentence terminator in text after a\n298|// member-list marker: the first period outside a code span that is\n299|// not a digit-period-digit abbreviation like Section 7.5 or\n300|// Structured Error 1.1. Normative member sentences never end\n301|// mid-list any other way, so any other period ends the scan.\n302|func sentenceEnd(rest string) int {\n303|\tinCode := false\n304|\tfor offset := 0; offset < len(rest); offset++ {\n305|\t\tif strings.HasPrefix(rest[offset:], \"<code>\") {\n306|\t\t\tinCode = true\n307|\t\t\tcontinue\n308|\t\t}\n309|\t\tif strings.HasPrefix(rest[offset:], \"</code>\") {\n310|\t\t\tinCode = false\n311|\t\t\tcontinue\n312|\t\t}\n313|\t\tif rest[offset] != '.' || inCode {\n314|\t\t\tcontinue\n315|\t\t}\n316|\t\tprevious, next := byte(0), byte(0)\n317|\t\tif offset > 0 {\n318|\t\t\tprevious = rest[offset-1]\n319|\t\t}\n320|\t\tif offset+1 < len(rest) {\n321|\t\t\tnext = rest[offset+1]\n322|\t\t}\n323|\t\tif previous >= '0' && previous <= '9' && next >= '0' && next <= '9' {\n324|\t\t\tcontinue\n325|\t\t}\n326|\t\treturn offset\n327|\t}\n328|\treturn -1\n329|}\n330|\n331|// sentenceMembers collects the member names of one scanned\n332|// sentence: every code span contributes the name before its first\n333|// colon or equals sign, in document order.\n334|func sentenceMembers(t *testing.T, marker, sentence string) []string {\n335|\tt.Helper()\n336|\tvar members []string\n337|\tfor {\n338|\t\topen := strings.Index(sentence, \"<code>\")\n339|\t\tif open < 0 {\n340|\t\t\tbreak\n341|\t\t}\n342|\t\tsentence = sentence[open+len(\"<code>\"):]\n343|\t\tclose := strings.Index(sentence, \"</code>\")\n344|\t\tif close < 0 {\n345|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n346|\t\t}\n347|\t\tspan := sentence[:close]\n348|\t\tsentence = sentence[close+len(\"</code>\"):]\n349|\t\tname := span\n350|\t\tif index := strings.IndexAny(span, \":=\"); index >= 0 {\n351|\t\t\tname = span[:index]\n352|\t\t}\n353|\t\tmembers = append(members, name)\n354|\t}\n355|\tif len(members) == 0 {\n356|\t\tt.Fatalf(\"derived no members for %q; the parser is broken\", marker)\n357|\t}\n358|\treturn members\n359|}\n360|\n361|// deriveTypeMembers parses one \"<code>Type</code> contains\n362|// exactly ...\" sentence from the pinned document into its member\n363|// list in document order. A missing marker or an empty derivation\n364|// fails closed.\n365|func deriveTypeMembers(t *testing.T, text, marker string) []string {\n366|\tt.Helper()\n367|\treturn deriveTypeMembersWith(t, text, marker, \"\")\n368|}\n369|\n370|// deriveTypeMembersWith selects among repeated homonymous\n371|// sentences: the pinned document states the request envelope and\n372|// the capability value in more than one section with different\n373|// members, so the selector names a structural fragment only the\n374|// Session Adapter sentence carries. An empty selector keeps the\n375|// first occurrence. The derivation still parses the whole\n376|// selected sentence; no production value is matched.\n377|func deriveTypeMembersWith(t *testing.T, text, marker, selector string) []string {\n378|\tt.Helper()\n379|\tremaining := text\n380|\tfor {\n381|\t\tindex := strings.Index(remaining, marker)\n382|\t\tif index < 0 {\n383|\t\t\tt.Fatalf(\"spec marker %q with selector %q not found; the derivation is broken\", marker, selector)\n384|\t\t}\n385|\t\trest := remaining[index+len(marker):]\n386|\t\tend := sentenceEnd(rest)\n387|\t\tif end < 0 {\n388|\t\t\tt.Fatalf(\"spec sentence for %q never terminates\", marker)\n389|\t\t}\n390|\t\tsentence := rest[:end]\n391|\t\tif selector == \"\" || strings.Contains(sentence, selector) {\n392|\t\t\treturn sentenceMembers(t, marker, sentence)\n393|\t\t}\n394|\t\tremaining = rest\n395|\t}\n396|}\n397|\n398|// memberSetKeys returns the keys of one production member map.\n399|func memberSetKeys(set map[string]bool) []string {\n400|\tkeys := make([]string, 0, len(set))\n401|\tfor name := range set {\n402|\t\tkeys = append(keys, name)\n403|\t}\n404|\tsort.Strings(keys)\n405|\treturn keys\n406|}\n407|\n408|// TestClosedMemberSetsAreDerivedFromSpec requires every closed\n409|// body to equal its pinned definition in order: the production\n410|// Required list must match the document sequence exactly, and\n411|// the Members map must hold exactly the same names. A dropped,\n412|// added, or reordered member reddens here.\n413|func TestClosedMemberSetsAreDerivedFromSpec(t *testing.T) {\n414|\tif _, err := specdoc.Load(); err != nil {\n415|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n416|\t}\n417|\ttext := string(specdoc.Bytes())\n418|\t// selectors disambiguate the two member sentences the pinned\n419|\t// document repeats across sections with different members: the\n420|\t// request envelope (Sections 7.5-style, 7.8, and 7.9 each state\n421|\t// one) and the capability value (the Provider Probe and Session\n422|\t// Adapter Probe sentences differ). Each selector is a structural\n423|\t// fragment only the Session Adapter sentence carries.\n424|\tselectors := map[string]string{\n425|\t\t\"request envelope\": \"<code>deadline</code>, and <code>body</code>\",\n426|\t\t\"capability value\": \"<code>detail:string[0..2048]</code>\",\n427|\t}\n428|\tordered := []struct {\n429|\t\tname     string\n430|\t\tmarker   string\n431|\t\trequired []string\n432|\t\tmembers  map[string]bool\n433|\t}{\n434|\t\t{\"request envelope\", \"The request envelope contains exactly\", requestRequired, requestMembers},\n435|\t\t{\"AdapterCallContext\", \"<code>AdapterCallContext</code> contains exactly\", contextRequired, contextMembers},\n436|\t\t{\"ReadAuthority\", \"<code>ReadAuthority</code> contains exactly\", readAuthorityRequired, readAuthorityMembers},\n437|\t\t{\"ObjectAuthority\", \"<code>ObjectAuthority</code> contains exactly\", objectAuthorityRequired, objectAuthorityMembers},\n438|\t\t{\"SourceSelector\", \"<code>SourceSelector</code> contains exactly\", sourceSelectorRequired, sourceSelectorMembers},\n439|\t\t{\"AdapterFinding\", \"<code>AdapterFinding</code> contains exactly\", findingRequired, findingMembers},\n440|\t\t{\"ResourceLimits\", \"<code>ResourceLimits</code> contains exactly\", resourceLimitsRequired, resourceLimitsMembers},\n441|\t\t{\"CapturePlanItem\", \"<code>CapturePlanItem</code> contains exactly\", capturePlanItemRequired, capturePlanItemMembers},\n442|\t\t{\"Session Adapter Probe\", \"Session Adapter Probe 1.0.0 is closed and contains exactly\", probeRequired, probeMembers},\n443|\t\t{\"Environment Tuple\", \"Environment Tuple contains exactly\", tupleRequired, tupleMembers},\n444|\t\t{\"SupportedEnvironmentTupleKey\", \"<code>SupportedEnvironmentTupleKey</code> contains exactly\", tupleKeyRequired, tupleKeyMembers},\n445|\t\t{\"SupportedEnvironmentTupleEntry\", \"<code>SupportedEnvironmentTupleEntry</code> contains exactly\", tupleEntryRequired, tupleEntryMembers},\n446|\t\t{\"SupportedContractVersions\", \"<code>SupportedContractVersions</code> contains exactly\", []string{\"contract_id\", \"versions\"}, nil},\n447|\t\t{\"FixtureEvidence\", \"<code>FixtureEvidence</code> contains exactly\", fixtureEvidenceRequired, fixtureEvidenceMembers},\n448|\t\t{\"ResumeSmokeEvidence\", \"<code>ResumeSmokeEvidence</code> contains exactly\", smokeEvidenceRequired, smokeEvidenceMembers},\n449|\t\t{\"FidelityLimit\", \"<code>FidelityLimit</code> contains exactly\", fidelityLimitRequired, fidelityLimitMembers},\n450|\t\t{\"capability value\", \"Each capability value contains exactly\", capabilityValueRequired, capabilityValueMembers},\n451|\t}\n452|\tfor _, test := range ordered {\n453|\t\tt.Run(test.name, func(t *testing.T) {\n454|\t\t\tderived := deriveTypeMembersWith(t, text, test.marker, selectors[test.name])\n455|\t\t\tif strings.Join(derived, \",\") != strings.Join(test.required, \",\") {\n456|\t\t\t\tt.Errorf(\"%s required = %v, want derived %v\", test.name, test.required, derived)\n457|\t\t\t}\n458|\t\t\tif test.members != nil {\n459|\t\t\t\tderivedSet := append([]string(nil), derived...)\n460|\t\t\t\tsort.Strings(derivedSet)\n461|\t\t\t\tif strings.Join(derivedSet, \",\") != strings.Join(memberSetKeys(test.members), \",\") {\n462|\t\t\t\t\tt.Errorf(\"%s members = %v, want derived %v\", test.name, memberSetKeys(test.members), derivedSet)\n463|\t\t\t\t}\n464|\t\t\t}\n465|\t\t})\n466|\t}\n467|\t// The success and failure envelopes reuse the request's first\n468|\t// four identity fields by an explicit rule, so their\n469|\t// derivation transforms the request list rather than\n470|\t// re-parsing prose.\n471|\trequest := deriveTypeMembers(t, text, \"The request envelope contains exactly\")\n472|\tfirstFour := request[:4]\n473|\twantSuccess := append(append([]string(nil), firstFour...), \"ok\", \"body\")\n474|\tif strings.Join(wantSuccess, \",\") != strings.Join(successRequired, \",\") {\n475|\t\tt.Errorf(\"success required = %v, want %v\", successRequired, wantSuccess)\n476|\t}\n477|\twantFailure := append(append([]string(nil), firstFour...), \"ok\", \"error\")\n478|\tif strings.Join(wantFailure, \",\") != strings.Join(failureRequired, \",\") {\n479|\t\tt.Errorf(\"failure required = %v, want %v\", failureRequired, wantFailure)\n480|\t}\n481|\t// The manifest member column comes from its own table, not a\n482|\t// sentence: parse the first-column code spans in the table\n483|\t// window.\n484|\tmanifestMembers := deriveManifestTableMembers(t, text)\n485|\tif strings.Join(manifestMembers, \",\") != strings.Join(manifestRequired, \",\") {\n486|\t\tt.Errorf(\"manifest required = %v, want derived %v\", manifestRequired, manifestMembers)\n487|\t}\n488|\t// The doctor result members come from the operation table\n489|\t// like every other success body.\n490|\t_, _, successes := deriveOperationTable(t)\n491|\tdoctor, ok := successes[string(OpDoctor)]\n492|\tif !ok {\n493|\t\tt.Fatal(\"derived no doctor success body from the operation table\")\n494|\t}\n495|\tif strings.Join(doctor, \",\") != strings.Join(doctorResultRequired, \",\") {\n496|\t\tt.Errorf(\"doctor required = %v, want derived %v\", doctorResultRequired, doctor)\n497|\t}\n498|\tt.Logf(\"member-set census: %d closed bodies derived\", len(ordered)+3)\n499|}\n500|\n501|// deriveManifestTableMembers parses the Session Adapter Manifest\n502|// member column from its table window: rows starting with\n503|// \"| <code>\" contribute their first-column name in order.\n504|func deriveManifestTableMembers(t *testing.T, text string) []string {\n505|\tt.Helper()\n506|\ttable, ok := sectionTableWindow(text, \"Session Adapter Manifest 1.0.0 is closed and contains exactly:\", \"Session Adapter Probe 1.0.0 is closed and contains exactly\")\n507|\tif !ok {\n508|\t\tt.Fatal(\"manifest table window not found\")\n509|\t}\n510|\tvar members []string\n511|\tfor _, line := range strings.Split(table, \"\\n\") {\n512|\t\tif !strings.HasPrefix(line, \"| <code>\") {\n513|\t\t\tcontinue\n514|\t\t}\n515|\t\tcells := splitTableCells(line)\n516|\t\tif len(cells) < 2 {\n517|\t\t\tcontinue\n518|\t\t}\n519|\t\t// The first cell carries one member per code span: three\n520|\t\t// rows pair two members with a slash (schema /\n521|\t\t// schema_version, display_name / adapter_version,\n522|\t\t// operations / capability_names). Every span that is a\n523|\t\t// bare snake_case name is a member, in order.\n524|\t\tcell := cells[1]\n525|\t\tfor {\n526|\t\t\topen := strings.Index(cell, \"<code>\")\n527|\t\t\tif open < 0 {\n528|\t\t\t\tbreak\n529|\t\t\t}\n530|\t\t\tcell = cell[open+len(\"<code>\"):]\n531|\t\t\tclose := strings.Index(cell, \"</code>\")\n532|\t\t\tif close < 0 {\n533|\t\t\t\tt.Fatal(\"unbalanced code span in the manifest table\")\n534|\t\t\t}\n535|\t\t\tname := cell[:close]\n536|\t\t\tcell = cell[close+len(\"</code>\"):]\n537|\t\t\tsnake := len(name) > 0\n538|\t\t\tfor _, character := range name {\n539|\t\t\t\tif character != '_' && (character < 'a' || character > 'z') && (character < '0' || character > '9') {\n540|\t\t\t\t\tsnake = false\n541|\t\t\t\t\tbreak\n542|\t\t\t\t}\n543|\t\t\t}\n544|\t\t\tif snake {\n545|\t\t\t\tmembers = append(members, name)\n546|\t\t\t}\n547|\t\t}\n548|\t}\n549|\tif len(members) == 0 {\n550|\t\tt.Fatal(\"derived no manifest members; the parser is broken\")\n551|\t}\n552|\treturn members\n553|}\n554|\n555|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n556|// against its verbatim spec union as a set. Order is not\n557|// normative for these sets — sortedness governs instances, not\n558|// the listing — so both sides sort before comparing. The\n559|// operation and capability registries are order-normative and\n560|// are pinned in order instead.\n561|func TestValueVocabulariesMatchSpec(t *testing.T) {\n562|\tif _, err := specdoc.Load(); err != nil {\n563|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n564|\t}\n565|\ttext := string(specdoc.Bytes())\n566|\t// normalizeUnionPipes collapses the three pipe encodings the\n567|\t// pinned document uses inside unions: escaped pipes in the\n568|\t// operation table, raw pipes in prose, and HTML entities in\n569|\t// the manifest table.\n570|\tnormalizeUnionPipes := func(raw string) []string {\n571|\t\traw = strings.ReplaceAll(raw, \"&#124;\", \"|\")\n572|\t\traw = strings.ReplaceAll(raw, \"\\\\|\", \"|\")\n573|\t\tvar values []string\n574|\t\tfor _, value := range strings.Split(raw, \"|\") {\n575|\t\t\tif value == \"\" {\n576|\t\t\t\tcontinue\n577|\t\t\t}\n578|\t\t\tvalues = append(values, value)\n579|\t\t}\n580|\t\treturn values\n581|\t}\n582|\t// firstSpanUnion takes the union in the first code span after\n583|\t// a prose marker. A leading member-name prefix on the first\n584|\t// element is stripped: the union starts after it.\n585|\tfirstSpanUnion := func(t *testing.T, marker string) []string {\n586|\t\tt.Helper()\n587|\t\tindex := strings.Index(text, marker)\n588|\t\tif index < 0 {\n589|\t\t\tt.Fatalf(\"spec union %q not found\", marker)\n590|\t\t}\n591|\t\trest := text[index+len(marker):]\n592|\t\topen := strings.Index(rest, \"<code>\")\n593|\t\tif open < 0 {\n594|\t\t\tt.Fatalf(\"no code span after %q\", marker)\n595|\t\t}\n596|\t\trest = rest[open+len(\"<code>\"):]\n597|\t\tclose := strings.Index(rest, \"</code>\")\n598|\t\tif close < 0 {\n599|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n600|\t\t}\n601|\t\tvalues := normalizeUnionPipes(rest[:close])\n602|\t\tif len(values) == 0 {\n603|\t\t\tt.Fatalf(\"empty union after %q\", marker)\n604|\t\t}\n605|\t\tif prefix := strings.IndexAny(values[0], \":=\"); prefix >= 0 {\n606|\t\t\tvalues[0] = values[0][prefix+1:]\n607|\t\t}\n608|\t\treturn values\n609|\t}\n610|\t// unionAfter takes the union starting exactly at the end of\n611|\t// the marker: the marker already names the sentence and the\n612|\t// member prefix, so nothing is consumed from the union and\n613|\t// nothing is stripped. This is the anchored form for unions\n614|\t// whose bare member name collides with an unrelated earlier\n615|\t// span in the document.\n616|\tunionAfter := func(t *testing.T, marker string) []string {\n617|\t\tt.Helper()\n618|\t\tindex := strings.Index(text, marker)\n619|\t\tif index < 0 {\n620|\t\t\tt.Fatalf(\"spec union %q not found\", marker)\n621|\t\t}\n622|\t\trest := text[index+len(marker):]\n623|\t\tclose := strings.Index(rest, \"</code>\")\n624|\t\tif close < 0 {\n625|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n626|\t\t}\n627|\t\tvalues := normalizeUnionPipes(rest[:close])\n628|\t\tif len(values) == 0 {\n629|\t\t\tt.Fatalf(\"empty union after %q\", marker)\n630|\t\t}\n631|\t\treturn values\n632|\t}\n633|\t// rowInlineUnion takes an inline member union from one\n634|\t// operation-table row: the first line starting with the row\n635|\t// marker, the union after the member prefix up to the next\n636|\t// comma or closing brace. The scan is windowed to the Section\n637|\t// 7.8 registry table because the probe name recurs in the\n638|\t// Terminal Backend, Provider Probe, and Directory Node tables\n639|\t// with different vocabularies.\n640|\trowInlineUnion := func(t *testing.T, row, prefix string) []string {\n641|\t\tt.Helper()\n642|\t\ttable, ok := sectionTableWindow(text, \"The exact request and success <code>body</code> registry is:\", \"Candidate objects are addressed only by their exact\")\n643|\t\tif !ok {\n644|\t\t\tt.Fatal(\"Section 7.8 registry table window not found\")\n645|\t\t}\n646|\t\tvar line string\n647|\t\tfor _, candidate := range strings.Split(table, \"\\n\") {\n648|\t\t\tif strings.HasPrefix(candidate, row) {\n649|\t\t\t\tline = candidate\n650|\t\t\t\tbreak\n651|\t\t\t}\n652|\t\t}\n653|\t\tif line == \"\" {\n654|\t\t\tt.Fatalf(\"spec row %q not found\", row)\n655|\t\t}\n656|\t\tindex := strings.Index(line, prefix)\n657|\t\tif index < 0 {\n658|\t\t\tt.Fatalf(\"spec member %q not found in row %q\", prefix, row)\n659|\t\t}\n660|\t\trest := line[index+len(prefix):]\n661|\t\tend := strings.IndexAny(rest, \",}\")\n662|\t\tif end < 0 {\n663|\t\t\tt.Fatalf(\"unterminated union in row %q\", row)\n664|\t\t}\n665|\t\tvalues := normalizeUnionPipes(rest[:end])\n666|\t\tif len(values) == 0 {\n667|\t\t\tt.Fatalf(\"empty union in row %q\", row)\n668|\t\t}\n669|\t\treturn values\n670|\t}\n671|\tsetEqual := func(t *testing.T, name string, got []string, want []string) {\n672|\t\tt.Helper()\n673|\t\tsortedGot := append([]string(nil), got...)\n674|\t\tsortedWant := append([]string(nil), want...)\n675|\t\tsort.Strings(sortedGot)\n676|\t\tsort.Strings(sortedWant)\n677|\t\tif strings.Join(sortedGot, \",\") != strings.Join(sortedWant, \",\") {\n678|\t\t\tt.Errorf(\"%s = %v, want spec %v\", name, got, want)\n679|\t\t}\n680|\t}\n681|\tt.Run(\"operations ordered\", func(t *testing.T) {\n682|\t\toperations, _, _ := deriveOperationTable(t)\n683|\t\tvar got []string\n684|\t\tfor _, operation := range operationOrder {\n685|\t\t\tgot = append(got, string(operation))\n686|\t\t}\n687|\t\tif strings.Join(got, \",\") != strings.Join(operations, \",\") {\n688|\t\t\tt.Errorf(\"operation registry = %v, want table %v\", got, operations)\n689|\t\t}\n690|\t})\n691|\tt.Run(\"capabilities ordered\", func(t *testing.T) {\n692|\t\tderived := deriveTypeMembers(t, text, \"The exact capability names are\")\n693|\t\tif strings.Join(capabilityOrder, \",\") != strings.Join(derived, \",\") {\n694|\t\t\tt.Errorf(\"capability registry = %v, want spec %v\", capabilityOrder, derived)\n695|\t\t}\n696|\t})\n697|\tsetEqual(t, \"capture classes\", captureClasses, firstSpanUnion(t, \"Each Capture Item has one native key and class\"))\n698|\tsetEqual(t, \"projection strategies\", projectionStrategies, firstSpanUnion(t, \"Strategies are\"))\n699|\tsetEqual(t, \"fidelity dispositions\", fidelityDispositions, firstSpanUnion(t, \"The dispositions are\"))\n700|\tsetEqual(t, \"capability statuses\", capabilityStatuses, unionAfter(t, \"Each capability value contains exactly\\n<code>status:\"))\n701|\tsetEqual(t, \"capability evidences\", capabilityEvidences, unionAfter(t, \"<code>enabled:boolean</code>,\\n<code>evidence:\"))\n702|\tsetEqual(t, \"read purposes\", readPurposes, unionAfter(t, \"<code>ReadAuthority</code> contains exactly <code>authority_id:UUIDv7</code>,\\n  <code>purpose:\"))\n703|\tsetEqual(t, \"object purposes\", objectPurposes, unionAfter(t, \"<code>ObjectAuthority</code> contains exactly\\n  <code>authority_id:UUIDv7</code>,\\n  <code>purpose:\"))\n704|\tsetEqual(t, \"finding severities\", findingSeverities, unionAfter(t, \"<code>AdapterFinding</code> contains exactly\\n  <code>severity:\"))\n705|\tsetEqual(t, \"directions\", []string{string(DirectionSourceRead), string(DirectionTargetWrite)}, unionAfter(t, \"<code>SupportedEnvironmentTupleKey</code> contains exactly\\n<code>direction:\"))\n706|\tsetEqual(t, \"roles\", []string{string(RoleSource), string(RoleTarget)}, unionAfter(t, \"<code>SessionAdapterExecutionBinding</code> containing exactly\\n<code>role:\"))\n707|\tsetEqual(t, \"binding candidate kinds\", []string{string(CandidateBuiltin), string(CandidateExternal)}, unionAfter(t, \"<code>provider_id:provider-id</code>,\\n<code>candidate_kind:\"))\n708|\tsetEqual(t, \"probe candidate kinds agree\", []string{string(CandidateBuiltin), string(CandidateExternal)}, rowInlineUnion(t, \"| <code>probe</code> |\", \"expected_candidate_kind:\"))\n709|\tsetEqual(t, \"platforms\", []string{string(scalar.PlatformLinux), string(scalar.PlatformMacOS), string(scalar.PlatformWindows), string(scalar.PlatformWSL2)}, unionAfter(t, \"<code>platform=\"))\n710|\tsetEqual(t, \"architectures\", tupleArchitectures, unionAfter(t, \"<code>architecture=\"))\n711|\tsetEqual(t, \"fidelity profiles\", fidelityProfiles, rowInlineUnion(t, \"| <code>projection-plan</code> |\", \"fidelity_profile:\"))\n712|\tsetEqual(t, \"validate modes\", validateModes, rowInlineUnion(t, \"| <code>validate</code> |\", \"mode:\"))\n713|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
