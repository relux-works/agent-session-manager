\"required_source_object_ids\":[],\"predicted_counts\":{},\"findings\":[],\"extensions\":{}}`)\n120|\tcase OpProject:\n121|\t\treturn []byte(`{` + ctx + `,\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"projected_object_manifest_candidate_id\":` + quote(fixtureProjectedDigest) + `,\"created_resource_keys\":[],\"actual_counts\":{},\"extensions\":{}}`)\n122|\tcase OpReadBack:\n123|\t\treturn []byte(`{` + ctx + `,\"observed_target_native_session_id\":\"target-1\",\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"observed_environment\":` + fixtureTupleJSON() + `,\"parsed_event_count\":0,\"parsed_head_ids\":[],\"workspace_binding\":{},\"structural_digest\":` + quote(fixtureStructuralDigest) + `,\"read_back_evidence_manifest_candidate_id\":` + quote(fixtureReadBackDigest) + `,\"extensions\":{}}`)\n124|\tcase OpValidate:\n125|\t\treturn []byte(`{` + ctx + `,\"mode\":\"staged\",\"valid\":true,\"structural_valid\":true,\"semantic_marker_valid\":true,\"identity_valid\":null,\"workspace_binding_valid\":null,\"resume_surface_valid\":null,\"findings\":[],\"evidence_digest\":` + quote(fixtureEvidenceDigest) + `,\"extensions\":{}}`)\n126|\tcase OpResumePlan:\n127|\t\treturn []byte(`{` + ctx + `,\"target_native_session_id\":\"target-1\",\"projection_plan_id\":` + quote(fixturePlanDigest) + `,\"argv\":[\"ax\",\"open\",\"target-1\"],\"cwd_relative\":\".\",\"environment_names\":[],\"opens_existing_identity\":true,\"extensions\":{}}`)\n128|\tcase OpDoctor:\n129|\t\treturn []byte(`{` + ctx + `,\"direction\":\"source_read\",\"registry_sequence\":9,\"registry_entry_status\":\"accepted\",\"findings\":[],\"healthy\":false,\"extensions\":{}}`)\n130|\tdefault:\n131|\t\tt.Fatalf(\"no success fixture for %q\", operation)\n132|\t\treturn nil\n133|\t}\n134|}\n135|\n136|// requestContextOf extracts the context bytes from a request body.\n137|func requestContextOf(t *testing.T, body []byte) string {\n138|\tt.Helper()\n139|\treturn string(rawMember(t, body, \"context\"))\n140|}\n141|\n142|// TestEveryOperationHasContractVectors drives every registry\n143|// operation through both production entry points with a valid\n144|// body: 14 of 14 request vectors and 11 of 11 success vectors\n145|// (manifest, probe, and doctor successes decode through their\n146|// dedicated decoders, covered by their own tests). An operation\n147|// with no vector fails here rather than passing silently.\n148|func TestEveryOperationHasContractVectors(t *testing.T) {\n149|\tmanifestDigest := fixtureManifestDigestText(t)\n150|\t_, context := requestContext(t, manifestDigest)\n151|\t_ = context\n152|\tdrivenRequests := 0\n153|\tdrivenSuccesses := 0\n154|\tfor _, name := range Operations() {\n155|\t\toperation := Operation(name)\n156|\t\trequest := fixtureRequestBody(t, operation, manifestDigest)\n157|\t\tdecoded, err := CheckRequestBody(operation, request)\n158|\t\tif err != nil {\n159|\t\t\tt.Fatalf(\"CheckRequestBody(%q): %v\", operation, err)\n160|\t\t}\n161|\t\tdrivenRequests++\n162|\t\tif operation == OpManifest || operation == OpProbe || operation == OpDoctor {\n163|\t\t\tcontinue\n164|\t\t}\n165|\t\tfacts := SuccessFacts{Context: decoded, ValidateMode: \"staged\", ResumeTargetID: \"target-1\", DoctorDirection: DirectionSourceRead}\n166|\t\tif operation == OpValidate {\n167|\t\t\tfacts.ValidateMode = \"staged\"\n168|\t\t}\n169|\t\tsuccess := fixtureSuccessBody(t, operation, requestContextOf(t, request), manifestDigest)\n170|\t\tif err := CheckSuccessBody(operation, success, facts); err != nil {\n171|\t\t\tt.Fatalf(\"CheckSuccessBody(%q): %v\", operation, err)\n172|\t\t}\n173|\t\tdrivenSuccesses++\n174|\t}\n175|\tif drivenRequests != 14 {\n176|\t\tt.Fatalf(\"request vectors = %d, want 14\", drivenRequests)\n177|\t}\n178|\tif drivenSuccesses != 11 {\n179|\t\tt.Fatalf(\"success vectors = %d, want 11\", drivenSuccesses)\n180|\t}\n181|\tt.Logf(\"contract vectors: %d/14 requests, %d/11 successes, 3 dedicated decoders\", drivenRequests, drivenSuccesses)\n182|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1c3","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":1852,"recorded_at":1780531400003699,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"call_id":"call_01a0742561507221a4661f303eb86768","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// fixtureValidProbe decodes the fixture probe and returns it with\n10|// the manifest digest the fixture manifest computes to.\n11|func fixtureValidProbe(t *testing.T) (Probe, Manifest) {\n12|\tt.Helper()\n13|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n16|\t}\n17|\tdigest := ManifestDigest(manifest).String()\n18|\tprobe, err := DecodeProbe([]byte(fixtureProbeJSON(digest)))\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"DecodeProbe: %v\", err)\n21|\t}\n22|\treturn probe, manifest\n23|}\n24|\n25|func TestDecodeProbeAcceptsFixture(t *testing.T) {\n26|\tprobe, _ := fixtureValidProbe(t)\n27|\tif len(probe.Capabilities) != 15 {\n28|\t\tt.Fatalf(\"capabilities = %d, want 15\", len(probe.Capabilities))\n29|\t}\n30|\tif probe.ProviderID != fixtureProviderID {\n31|\t\tt.Fatalf(\"ProviderID = %q, want %q\", probe.ProviderID, fixtureProviderID)\n32|\t}\n33|\tif probe.Environment.EnvironmentID != fixtureEnvironmentID {\n34|\t\tt.Fatalf(\"EnvironmentID = %q, want %q\", probe.Environment.EnvironmentID, fixtureEnvironmentID)\n35|\t}\n36|\tfor _, name := range capabilityOrder {\n37|\t\tif !CapabilityUsable(probe, name) {\n38|\t\t\tt.Fatalf(\"CapabilityUsable(%q) = false, want true\", name)\n39|\t\t}\n40|\t}\n41|}\n42|\n43|// TestCapabilityStatusMatrix drives every status/enabled\n44|// combination through the value decoder: only\n45|// available+enabled is usable, and only available permits\n46|// enabled=true. The eight combinations are enumerated, not\n47|// sampled.\n48|func TestCapabilityStatusMatrix(t *testing.T) {\n49|\tfor _, status := range []string{\"available\", \"conditional\", \"unsupported\", \"unknown\"} {\n50|\t\tfor _, enabled := range []bool{false, true} {\n51|\t\t\tname := fmt.Sprintf(\"%s/enabled=%v\", status, enabled)\n52|\t\t\tt.Run(name, func(t *testing.T) {\n53|\t\t\t\tbody := fmt.Sprintf(`{\"status\":%q,\"enabled\":%v,\"evidence\":\"probed\",\"detail\":\"\"}`, status, enabled)\n54|\t\t\t\tprobe, _ := fixtureValidProbe(t)\n55|\t\t\t\t// Rebuild the probe body with one value replaced.\n56|\t\t\t\tfixture := fixtureProbeJSON(probe.ManifestDigest)\n57|\t\t\t\tmutated := replaceCapability(t, []byte(fixture), \"tool_history\", body)\n58|\t\t\t\tredone, err := DecodeProbe(mutated)\n59|\t\t\t\tif enabled && status != \"available\" {\n60|\t\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"without available status\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
