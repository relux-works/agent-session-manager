{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e7","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":462,"recorded_at":1780531400000919,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"a927782c-8795-47f4-a44e-e07ca9e40851"},"task_id":"a927782c-8795-47f4-a44e-e07ca9e40851","event":{"kind":"output","task_id":"a927782c-8795-47f4-a44e-e07ca9e40851","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/protocol.go`.\n(339 line(s) above)\n340|// CheckSuccessEnvelope validates one inbound success frame against\n341|// the request that caused it: one complete object within the frame\n342|// bound, the exact success members, the four identity fields echoed\n343|// exactly, ok=true, an object body, and no error member. Body and\n344|// error are disjoint, never nullable sentinels: a frame carrying\n345|// both or neither is a protocol error. The returned body is the raw\n346|// member for the operation-layer checks.\n347|func CheckSuccessEnvelope(frame []byte, want Request) ([]byte, error) {\n348|\tif len(frame) == 0 {\n349|\t\tfailure, err := failProtocol(\"success frame is empty\", \"\")\n350|\t\tif err != nil {\n351|\t\t\treturn nil, err\n352|\t\t}\n353|\t\treturn nil, failure\n354|\t}\n355|\tif len(frame) > MaxFrameBytes {\n356|\t\tfailure, err := failProtocol(\"success frame exceeds the 8 MiB bound\", \"\")\n357|\t\tif err != nil {\n358|\t\t\treturn nil, err\n359|\t\t}\n360|\t\treturn nil, failure\n361|\t}\n362|\tmembers, fault := decodeStrictObject(frame)\n363|\tif fault != nil {\n364|\t\tfailure, err := failProtocol(\"success envelope \"+fault.detail, fault.member)\n365|\t\tif err != nil {\n366|\t\t\treturn nil, err\n367|\t\t}\n368|\t\treturn nil, failure\n369|\t}\n370|\tif name, unknown := unknownMember(members, successMembers); unknown {\n371|\t\tfailure, err := failProtocol(\"success envelope carries unknown member\", name)\n372|\t\tif err != nil {\n373|\t\t\treturn nil, err\n374|\t\t}\n375|\t\treturn nil, failure\n376|\t}\n377|\tif name, missing := missingMember(members, successRequired); missing {\n378|\t\tfailure, err := failProtocol(\"success envelope misses a required member\", name)\n379|\t\tif err != nil {\n380|\t\t\treturn nil, err\n381|\t\t}\n382|\t\treturn nil, failure\n383|\t}\n384|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n385|\t\tfailure, err := failProtocol(\"success protocol does not echo the request\", \"protocol\")\n386|\t\tif err != nil {\n387|\t\t\treturn nil, err\n388|\t\t}\n389|\t\treturn nil, failure\n390|\t}\n391|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n392|\t\tfailure, err := failProtocol(\"success protocol version does not echo the request\", \"protocol_version\")\n393|\t\tif err != nil {\n394|\t\t\treturn nil, err\n395|\t\t}\n396|\t\treturn nil, failure\n397|\t}\n398|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n399|\t\tfailure, err := failProtocol(\"success request identifier does not echo the request\", \"request_id\")\n400|\t\tif err != nil {\n401|\t\t\treturn nil, err\n402|\t\t}\n403|\t\treturn nil, failure\n404|\t}\n405|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n406|\t\tfailure, err := failProtocol(\"success operation does not echo the request\", \"operation\")\n407|\t\tif err != nil {\n408|\t\t\treturn nil, err\n409|\t\t}\n410|\t\treturn nil, failure\n411|\t}\n412|\tpositive, ok := rawBool(members[\"ok\"])\n413|\tif !ok || !positive {\n414|\t\tfailure, err := failProtocol(\"success envelope does not carry ok=true\", \"ok\")\n415|\t\tif err != nil {\n416|\t\t\treturn nil, err\n417|\t\t}\n418|\t\treturn nil, failure\n419|\t}\n420|\tbody := bytesTrimSpace(members[\"body\"])\n421|\tif _, fault := decodeStrictObject(body); fault != nil {\n422|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, \"body\")\n423|\t\tif err != nil {\n424|\t\t\treturn nil, err\n425|\t\t}\n426|\t\treturn nil, failure\n427|\t}\n428|\treturn body, nil\n429|}\n430|\n431|// CheckFailureEnvelope validates one inbound failure frame against\n432|// the request that caused it: the exact failure members, the four\n433|// identity fields echoed exactly, ok=false, a closed error object,\n434|// and no body member. The error object itself must decode as a\n435|// Structured Error under the adapter's bound version; a failure that\n436|// cannot be read is an integrity failure, never a retryable result.\n437|func CheckFailureEnvelope(frame []byte, want Request) (*axerror.Error, error) {\n438|\tif len(frame) == 0 {\n439|\t\tfailure, err := failProtocol(\"failure frame is empty\", \"\")\n440|\t\tif err != nil {\n441|\t\t\treturn nil, err\n442|\t\t}\n443|\t\treturn nil, failure\n444|\t}\n445|\tif len(frame) > MaxFrameBytes {\n446|\t\tfailure, err := failProtocol(\"failure frame exceeds the 8 MiB bound\", \"\")\n447|\t\tif err != nil {\n448|\t\t\treturn nil, err\n449|\t\t}\n450|\t\treturn nil, failure\n451|\t}\n452|\tmembers, fault := decodeStrictObject(frame)\n453|\tif fault != nil {\n454|\t\tfailure, err := failProtocol(\"failure envelope \"+fault.detail, fault.member)\n455|\t\tif err != nil {\n456|\t\t\treturn nil, err\n457|\t\t}\n458|\t\treturn nil, failure\n459|\t}\n460|\tif name, unknown := unknownMember(members, failureMembers); unknown {\n461|\t\tfailure, err := failProtocol(\"failure envelope carries unknown member\", name)\n462|\t\tif err != nil {\n463|\t\t\treturn nil, err\n464|\t\t}\n465|\t\treturn nil, failure\n466|\t}\n467|\tif name, missing := missingMember(members, failureRequired); missing {\n468|\t\tfailure, err := failProtocol(\"failure envelope misses a required member\", name)\n469|\t\tif err != nil {\n(more lines below)"}}}
