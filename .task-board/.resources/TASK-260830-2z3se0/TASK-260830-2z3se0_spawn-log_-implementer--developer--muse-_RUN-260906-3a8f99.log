{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5eb","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":336,"recorded_at":1780531400000667,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"5a86f03f-2122-40dc-be7c-6597b7d6f521"},"task_id":"5a86f03f-2122-40dc-be7c-6597b7d6f521","event":{"kind":"output","task_id":"5a86f03f-2122-40dc-be7c-6597b7d6f521","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/probe.go`.\n(539 line(s) above)\n540|\tContext          CallContext\n541|\tDirection        Direction\n542|\tRegistrySequence uint64\n543|\tEntryStatus      string\n544|\tFindings         []Finding\n545|\tHealthy          bool\n546|}\n547|\n548|// DecodeDoctorResult validates one closed doctor success body: the\n549|// echoed context, the direction in the closed vocabulary, the\n550|// registry sequence as uint53, the entry status in\n551|// accepted|revoked|absent, the findings, and the health flag. The\n552|// health rule itself is CheckDoctorHealthy: decoding proves shape,\n553|// not health.\n554|func DecodeDoctorResult(body []byte, sent CallContext, sentDirection Direction) (DoctorResult, error) {\n555|\tmembers, fault := decodeStrictObject(body)\n556|\tif fault != nil {\n557|\t\tfailure, err := failProtocol(\"doctor result \"+fault.detail, fault.member)\n558|\t\tif err != nil {\n559|\t\t\treturn DoctorResult{}, err\n560|\t\t}\n561|\t\treturn DoctorResult{}, failure\n562|\t}\n563|\tif name, unknown := unknownMember(members, doctorResultMembers); unknown {\n564|\t\tfailure, err := failProtocol(\"doctor result carries unknown member\", name)\n565|\t\tif err != nil {\n566|\t\t\treturn DoctorResult{}, err\n567|\t\t}\n568|\t\treturn DoctorResult{}, failure\n569|\t}\n570|\tif name, missing := missingMember(members, doctorResultRequired); missing {\n571|\t\tfailure, err := failProtocol(\"doctor result misses a required member\", name)\n572|\t\tif err != nil {\n573|\t\t\treturn DoctorResult{}, err\n574|\t\t}\n575|\t\treturn DoctorResult{}, failure\n576|\t}\n577|\tcontext, err := CheckContextEcho(sent, members[\"context\"])\n578|\tif err != nil {\n579|\t\treturn DoctorResult{}, err\n580|\t}\n581|\tdirection, ok := rawString(members[\"direction\"])\n582|\tif !ok || (Direction(direction) != DirectionSourceRead && Direction(direction) != DirectionTargetWrite) {\n583|\t\tfailure, err := failProtocol(\"doctor result direction is outside source_read|target_write\", \"direction\")\n584|\t\tif err != nil {\n585|\t\t\treturn DoctorResult{}, err\n586|\t\t}\n587|\t\treturn DoctorResult{}, failure\n588|\t}\n589|\tif Direction(direction) != sentDirection {\n590|\t\tfailure, err := failProtocol(\"doctor result direction does not answer the request direction\", \"direction\")\n591|\t\tif err != nil {\n592|\t\t\treturn DoctorResult{}, err\n593|\t\t}\n594|\t\treturn DoctorResult{}, failure\n595|\t}\n596|\tsequence, ok := checkUint53Bounds(members[\"registry_sequence\"], 0, maxUint53)\n597|\tif !ok {\n598|\t\tfailure, err := failProtocol(\"doctor result registry sequence is not a uint53\", \"registry_sequence\")\n599|\t\tif err != nil {\n600|\t\t\treturn DoctorResult{}, err\n601|\t\t}\n602|\t\treturn DoctorResult{}, failure\n603|\t}\n604|\tstatus, ok := rawString(members[\"registry_entry_status\"])\n605|\tif !ok || (status != \"accepted\" && status != \"revoked\" && status != \"absent\") {\n606|\t\tfailure, err := failProtocol(\"doctor result entry status is outside accepted|revoked|absent\", \"registry_entry_status\")\n607|\t\tif err != nil {\n608|\t\t\treturn DoctorResult{}, err\n609|\t\t}\n610|\t\treturn DoctorResult{}, failure\n611|\t}\n612|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n613|\tif err != nil {\n614|\t\treturn DoctorResult{}, err\n615|\t}\n616|\thealthy, ok := rawBool(members[\"healthy\"])\n617|\tif !ok {\n618|\t\tfailure, err := failProtocol(\"doctor result health flag is not a boolean\", \"healthy\")\n619|\t\tif err != nil {\n620|\t\t\treturn DoctorResult{}, err\n621|\t\t}\n622|\t\treturn DoctorResult{}, failure\n623|\t}\n624|\tif !checkExtensions(members[\"extensions\"]) {\n625|\t\tfailure, err := failProtocol(\"doctor result extensions are not reverse-DNS keyed\", \"extensions\")\n626|\t\tif err != nil {\n627|\t\t\treturn DoctorResult{}, err\n628|\t\t}\n629|\t\treturn DoctorResult{}, failure\n630|\t}\n631|\treturn DoctorResult{\n632|\t\tContext:          context,\n633|\t\tDirection:        Direction(direction),\n634|\t\tRegistrySequence: sequence,\n635|\t\tEntryStatus:      status,\n636|\t\tFindings:         findings,\n637|\t\tHealthy:          healthy,\n638|\t}, nil\n639|}\n640|\n641|// CheckDoctorHealthy enforces the doctor health rule: healthy\n642|// requires an accepted exact binding and every required\n643|// capability. A healthy=true result over a revoked or absent entry\n644|// is refused, and so is a healthy=true result with any required\n645|// capability unusable. healthy=false is always structurally\n646|// admissible: the rule states necessary conditions, not\n647|// sufficient ones. Every required name must belong to the closed\n648|// fifteen-registry; a required set naming anything else is a\n649|// caller error, because the host cannot demand a surface the\n650|// contract never defined.\n651|func CheckDoctorHealthy(result DoctorResult, probe Probe, required []string) error {\n652|\tfor _, name := range required {\n653|\t\tif !validCapabilityName(name) {\n654|\t\t\tfailure, err := failInvalid(\"doctor required set names a capability outside the closed registry\", \"required\")\n655|\t\t\tif err != nil {\n656|\t\t\t\treturn err\n657|\t\t\t}\n658|\t\t\treturn failure\n659|\t\t}\n660|\t}\n661|\tif !result.Healthy {\n662|\t\treturn nil\n663|\t}\n664|\tif result.EntryStatus != \"accepted\" {\n665|\t\tfailure, err := failCapability(\"doctor reports healthy without an accepted registry entry\", \"tuple_registry\")\n666|\t\tif err != nil {\n667|\t\t\treturn err\n668|\t\t}\n669|\t\treturn failure\n670|\t}\n671|\tfor _, name := range required {\n672|\t\tif !CapabilityUsable(probe, name) {\n673|\t\t\tfailure, err := failCapability(\"doctor reports healthy without a usable required capability\", name)\n674|\t\t\tif err != nil {\n675|\t\t\t\treturn err\n676|\t\t\t}\n677|\t\t\treturn failure\n678|\t\t}\n679|\t}\n680|\treturn nil\n681|}\n682|\n683|// validCapabilityName reports whether the name belongs to the\n684|// fifteen-capability registry.\n685|func validCapabilityName(name string) bool {\n686|\tfor _, capability := range capabilityOrder {\n687|\t\tif capability == name {\n688|\t\t\treturn true\n689|\t\t}\n(more lines below)"}}}
