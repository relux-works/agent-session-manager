{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e7","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":590,"recorded_at":1780531400001175,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"206d15bb-febd-43ea-a58d-a2002af3f55f"},"task_id":"206d15bb-febd-43ea-a58d-a2002af3f55f","event":{"kind":"output","task_id":"206d15bb-febd-43ea-a58d-a2002af3f55f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/context.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the reusable closed body types Section 7.8\n12|// defines: AdapterCallContext with its request-digest binding,\n13|// ReadAuthority, ObjectAuthority with the fresh-sink rule,\n14|// SourceSelector with its exactly-one rule, AdapterFinding,\n15|// ResourceLimits, and CapturePlanItem.\n16|\n17|// contextMembers is the exact AdapterCallContext member set: the\n18|// operation UUID, provider, environment, manifest and executable\n19|// digests, request digest, and extensions.\n20|var contextMembers = map[string]bool{\n21|\t\"operation_id\":                    true,\n22|\t\"provider_id\":                     true,\n23|\t\"environment\":                     true,\n24|\t\"session_adapter_manifest_digest\": true,\n25|\t\"executable_sha256\":               true,\n26|\t\"request_digest\":                  true,\n27|\t\"extensions\":                      true,\n28|}\n29|\n30|// contextRequired lists contextMembers in a fixed order.\n31|var contextRequired = []string{\n32|\t\"operation_id\",\n33|\t\"provider_id\",\n34|\t\"environment\",\n35|\t\"session_adapter_manifest_digest\",\n36|\t\"executable_sha256\",\n37|\t\"request_digest\",\n38|\t\"extensions\",\n39|}\n40|\n41|// CallContext is one validated AdapterCallContext. The raw member\n42|// is retained so the success echo can be compared byte-for-byte:\n43|// the adapter must echo the context exactly, not rebuild it.\n44|type CallContext struct {\n45|\tOperationID      string\n46|\tProviderID       string\n47|\tEnvironment      Tuple\n48|\tManifestDigest   string\n49|\tExecutableSHA256 string\n50|\tRequestDigest    string\n51|\traw              []byte\n52|}\n53|\n54|// Raw returns the canonical context bytes for echo comparison.\n55|func (context CallContext) Raw() []byte {\n56|\treturn append([]byte(nil), context.raw...)\n57|}\n58|\n59|// DecodeCallContext validates one closed AdapterCallContext.\n60|func DecodeCallContext(raw json.RawMessage) (CallContext, error) {\n61|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n62|\tif fault != nil {\n63|\t\tfailure, err := failProtocol(\"call context \"+fault.detail, fault.member)\n64|\t\tif err != nil {\n65|\t\t\treturn CallContext{}, err\n66|\t\t}\n67|\t\treturn CallContext{}, failure\n68|\t}\n69|\tif name, unknown := unknownMember(members, contextMembers); unknown {\n70|\t\tfailure, err := failProtocol(\"call context carries unknown member\", name)\n71|\t\tif err != nil {\n72|\t\t\treturn CallContext{}, err\n73|\t\t}\n74|\t\treturn CallContext{}, failure\n75|\t}\n76|\tif name, missing := missingMember(members, contextRequired); missing {\n77|\t\tfailure, err := failProtocol(\"call context misses a required member\", name)\n78|\t\tif err != nil {\n79|\t\t\treturn CallContext{}, err\n80|\t\t}\n81|\t\treturn CallContext{}, failure\n82|\t}\n83|\toperationID, ok := checkUUIDv7(members[\"operation_id\"])\n84|\tif !ok {\n85|\t\tfailure, err := failProtocol(\"call context operation identifier is not a UUIDv7\", \"operation_id\")\n86|\t\tif err != nil {\n87|\t\t\treturn CallContext{}, err\n88|\t\t}\n89|\t\treturn CallContext{}, failure\n90|\t}\n91|\tproviderID, ok := rawString(members[\"provider_id\"])\n92|\tif !ok || !providerIDPattern.MatchString(providerID) {\n93|\t\tfailure, err := failProtocol(\"call context provider identifier is not a provider-id\", \"provider_id\")\n94|\t\tif err != nil {\n95|\t\t\treturn CallContext{}, err\n96|\t\t}\n97|\t\treturn CallContext{}, failure\n98|\t}\n99|\tenvironment, err := DecodeTuple(members[\"environment\"])\n100|\tif err != nil {\n101|\t\treturn CallContext{}, err\n102|\t}\n103|\tmanifestDigest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n104|\tif !ok {\n105|\t\tfailure, faultErr := failProtocol(\"call context manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n106|\t\tif faultErr != nil {\n107|\t\t\treturn CallContext{}, faultErr\n108|\t\t}\n109|\t\treturn CallContext{}, failure\n110|\t}\n111|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n112|\tif !ok {\n113|\t\tfailure, faultErr := failProtocol(\"call context executable digest is not a digest\", \"executable_sha256\")\n114|\t\tif faultErr != nil {\n115|\t\t\treturn CallContext{}, faultErr\n116|\t\t}\n117|\t\treturn CallContext{}, failure\n118|\t}\n119|\trequestDigest, ok := checkDigest(members[\"request_digest\"])\n120|\tif !ok {\n121|\t\tfailure, faultErr := failProtocol(\"call context request digest is not a digest\", \"request_digest\")\n122|\t\tif faultErr != nil {\n123|\t\t\treturn CallContext{}, faultErr\n124|\t\t}\n125|\t\treturn CallContext{}, failure\n126|\t}\n127|\tif !checkExtensions(members[\"extensions\"]) {\n128|\t\tfailure, faultErr := failProtocol(\"call context extensions are not reverse-DNS keyed\", \"extensions\")\n129|\t\tif faultErr != nil {\n130|\t\t\treturn CallContext{}, faultErr\n131|\t\t}\n132|\t\treturn CallContext{}, failure\n133|\t}\n134|\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(raw))\n135|\tif err != nil {\n136|\t\tfailure, faultErr := failProtocol(\"call context is not canonical JSON\", \"\")\n137|\t\tif faultErr != nil {\n138|\t\t\treturn CallContext{}, faultErr\n139|\t\t}\n140|\t\treturn CallContext{}, failure\n141|\t}\n142|\treturn CallContext{\n143|\t\tOperationID:      operationID.String(),\n144|\t\tProviderID:       providerID,\n145|\t\tEnvironment:      environment,\n146|\t\tManifestDigest:   manifestDigest.String(),\n147|\t\tExecutableSHA256: executable.String(),\n148|\t\tRequestDigest:    requestDigest.String(),\n149|\t\traw:              canonical,\n150|\t}, nil\n151|}\n152|\n153|// RequestDigestFor computes the request digest the host binds into\n154|// the call context: the SHA-256 of the JCS request body with only\n155|// the context's request_digest member omitted. The omission is\n156|// what makes the digest computable: the host computes it over the\n157|// body it is about to send, writes it into the context, and sends;\n158|// reinsertion cannot change the digest because the digested form\n159|// never contained the member. A body with no context member\n160|// digests whole.\n161|func RequestDigestFor(requestBody []byte) (scalar.Digest, error) {\n162|\tcanonical, err := canonicaljson.Canonicalize(requestBody)\n163|\tif err != nil {\n164|\t\treturn scalar.Digest{}, err\n165|\t}\n166|\tvar body map[string]any\n167|\tif err := json.Unmarshal(canonical, &body); err != nil {\n168|\t\treturn scalar.Digest{}, err\n169|\t}\n170|\tif context, ok := body[\"context\"].(map[string]any); ok {\n171|\t\tdelete(context, \"request_digest\")\n172|\t\tredacted, err := json.Marshal(body)\n173|\t\tif err != nil {\n174|\t\t\treturn scalar.Digest{}, err\n175|\t\t}\n176|\t\tcanonical, err = canonicaljson.Canonicalize(redacted)\n177|\t\tif err != nil {\n178|\t\t\treturn scalar.Digest{}, err\n179|\t\t}\n180|\t}\n(more lines below)"}}}
