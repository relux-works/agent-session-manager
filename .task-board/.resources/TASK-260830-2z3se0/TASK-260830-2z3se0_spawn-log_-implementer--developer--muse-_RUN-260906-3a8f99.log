{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c689","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":415,"recorded_at":1780531400000825,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"79aabb87-987f-4002-89d7-3323a31d31b5"},"task_id":"79aabb87-987f-4002-89d7-3323a31d31b5","event":{"kind":"output","task_id":"79aabb87-987f-4002-89d7-3323a31d31b5","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/protocol.go`.\n(119 line(s) above)\n120|//\n121|// Every constructor takes the human detail first as a string literal\n122|// at the call site and the distinguishing wire fact second, so the\n123|// inventory derives one obligation per literal detail and every\n124|// witness can assert which arm fired through the code plus the\n125|// distinguishing detail, not merely that something refused.\n126|var failInvalid = func(detail string, field string) (*axerror.Error, error) {\n127|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"invalid_config\", Message: \"session adapter host refused the call: \" + detail, Details: axerror.Details{\"field\": field}})\n128|}\n129|\n130|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n131|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"session_adapter_protocol_error\", Message: \"session adapter host rejected the adapter frame: \" + detail, Details: axerror.Details{\"member\": member}})\n132|}\n133|\n134|var failUnknownOperation = func(detail string, operation string) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"operation_unknown\", Message: \"session adapter host refused an unknown operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n136|}\n137|\n138|var failCapability = func(detail string, capability string) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unavailable operation: \" + detail, Details: axerror.Details{\"capability\": capability}})\n140|}\n141|\n142|// failUnavailable reports an operation the adapter does not\n143|// implement. The operation-to-capability mapping is not stated in\n144|// Section 7.8, so the refusal names the operation rather than\n145|// inventing a capability: the detail key is operation, never a\n146|// capability the contract never defined.\n147|var failUnavailable = func(detail string, operation string) (*axerror.Error, error) {\n148|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unimplemented operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n149|}\n150|\n151|var failUnsupportedTuple = func(detail string, environment string) (*axerror.Error, error) {\n152|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"unsupported_environment_tuple\", Message: \"session adapter host refused an unadmitted environment: \" + detail, Details: axerror.Details{\"environment\": environment}})\n153|}\n154|\n155|var failIntegrity = func(detail string, subject string) (*axerror.Error, error) {\n156|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"integrity_failure\", Message: \"session adapter binding observation is not trusted state: \" + detail, Details: axerror.Details{\"subject\": subject}})\n157|}\n158|\n159|// requestMembers is the exact request envelope member set Section 7.8\n160|// requires: protocol, protocol_version, request_id, operation,\n161|// deadline, and body.\n162|var requestMembers = map[string]bool{\n163|\t\"protocol\":         true,\n164|\t\"protocol_version\": true,\n165|\t\"request_id\":       true,\n166|\t\"operation\":        true,\n167|\t\"deadline\":         true,\n168|\t\"body\":             true,\n169|}\n170|\n171|// requestRequired lists requestMembers in a fixed order so an\n172|// envelope missing several members always names the same one.\n173|var requestRequired = []string{\n174|\t\"protocol\",\n175|\t\"protocol_version\",\n176|\t\"request_id\",\n177|\t\"operation\",\n178|\t\"deadline\",\n179|\t\"body\",\n180|}\n181|\n182|// successMembers is the exact success envelope member set: the four\n183|// echoed identity fields, ok=true, and body, with no error member.\n184|var successMembers = map[string]bool{\n185|\t\"protocol\":         true,\n186|\t\"protocol_version\": true,\n187|\t\"request_id\":       true,\n188|\t\"operation\":        true,\n189|\t\"ok\":               true,\n190|\t\"body\":             true,\n191|}\n192|\n193|// successRequired lists successMembers in a fixed order.\n194|var successRequired = []string{\n195|\t\"protocol\",\n196|\t\"protocol_version\",\n197|\t\"request_id\",\n198|\t\"operation\",\n199|\t\"ok\",\n200|\t\"body\",\n201|}\n202|\n203|// failureMembers is the exact failure envelope member set: the four\n204|// echoed identity fields, ok=false, and error, with no body member.\n205|var failureMembers = map[string]bool{\n206|\t\"protocol\":         true,\n207|\t\"protocol_version\": true,\n208|\t\"request_id\":       true,\n209|\t\"operation\":        true,\n210|\t\"ok\":               true,\n211|\t\"error\":            true,\n212|}\n213|\n214|// failureRequired lists failureMembers in a fixed order.\n215|var failureRequired = []string{\n216|\t\"protocol\",\n217|\t\"protocol_version\",\n218|\t\"request_id\",\n219|\t\"operation\",\n220|\t\"ok\",\n221|\t\"error\",\n222|}\n223|\n224|// Request is one Section 7.8 request envelope as the host wrote it:\n225|// the identity fields plus the canonical body bytes. Responses are\n226|// checked against it, never trusted on their own echo.\n227|type Request struct {\n228|\tOperation Operation\n229|\tRequestID string\n230|\tBody      []byte\n231|}\n232|\n233|// DecodeRequestFrame validates one outbound request frame before it\n234|// reaches the adapter surface: one complete object within the frame\n235|// bound, the exact envelope members, the exact protocol identifier\n236|// and version, a UUIDv7 request identifier, a registry operation, a\n237|// timestamp deadline, and an object body. An unknown operation is\n238|// operation_unknown; every other envelope defect is\n239|// session_adapter_protocol_error. The returned body is the raw\n240|// canonical member for the operation-layer checks.\n241|func DecodeRequestFrame(frame []byte) (Request, error) {\n242|\tif len(frame) == 0 {\n243|\t\tfailure, err := failProtocol(\"request frame is empty\", \"\")\n244|\t\tif err != nil {\n245|\t\t\treturn Request{}, err\n246|\t\t}\n247|\t\treturn Request{}, failure\n248|\t}\n249|\tif len(frame) > MaxFrameBytes {\n250|\t\tfailure, err := failProtocol(\"request frame exceeds the 8 MiB bound\", \"\")\n251|\t\tif err != nil {\n252|\t\t\treturn Request{}, err\n253|\t\t}\n254|\t\treturn Request{}, failure\n255|\t}\n256|\tmembers, fault := decodeStrictObject(frame)\n257|\tif fault != nil {\n258|\t\tfailure, err := failProtocol(\"request envelope \"+fault.detail, fault.member)\n259|\t\tif err != nil {\n260|\t\t\treturn Request{}, err\n261|\t\t}\n262|\t\treturn Request{}, failure\n263|\t}\n264|\tif name, unknown := unknownMember(members, requestMembers); unknown {\n265|\t\tfailure, err := failProtocol(\"request envelope carries unknown member\", name)\n266|\t\tif err != nil {\n267|\t\t\treturn Request{}, err\n268|\t\t}\n269|\t\treturn Request{}, failure\n(more lines below)"}}}
