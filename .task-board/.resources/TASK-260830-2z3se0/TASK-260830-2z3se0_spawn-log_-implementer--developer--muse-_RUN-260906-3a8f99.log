\"}\n149|\tbase := fixtureSuccessBody(t, OpResumePlan, requestContextOf(t, request), manifestDigest)\n150|\tif err := CheckSuccessBody(OpResumePlan, base, facts); err != nil {\n151|\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n152|\t}\n153|\tabsent := mutateMember(t, base, \"argv\", `[\"ax\",\"open\"]`)\n154|\terr = CheckSuccessBody(OpResumePlan, absent, facts)\n155|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"exactly once\")\n156|\tdoubled := mutateMember(t, base, \"argv\", `[\"ax\",\"open\",\"target-1\",\"target-1\"]`)\n157|\terr = CheckSuccessBody(OpResumePlan, doubled, facts)\n158|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"exactly once\")\n159|\tclosed := mutateMember(t, base, \"opens_existing_identity\", `false`)\n160|\terr = CheckSuccessBody(OpResumePlan, closed, facts)\n161|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"opens_existing_identity\", \"existing identity\")\n162|}\n163|\n164|func TestProjectionPlanDispositionRules(t *testing.T) {\n165|\tmanifestDigest := fixtureManifestDigestText(t)\n166|\trequest := fixtureRequestBody(t, OpProjectionPlan, manifestDigest)\n167|\tif _, err := CheckRequestBody(OpProjectionPlan, request); err != nil {\n168|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n169|\t}\n170|\tarchived := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"archive_only\"]}`)\n171|\t_, err := CheckRequestBody(OpProjectionPlan, archived)\n172|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"seven-disposition vocabulary\")\n173|\teighth := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"exact\",\"bogus\"]}`)\n174|\t_, err = CheckRequestBody(OpProjectionPlan, eighth)\n175|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"seven-disposition vocabulary\")\n176|\tunsorted := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"summarized\",\"exact\"]}`)\n177|\t_, err = CheckRequestBody(OpProjectionPlan, unsorted)\n178|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"not sorted unique\")\n179|\tempty := mutateMember(t, request, \"required_dispositions\", `{}`)\n180|\t_, err = CheckRequestBody(OpProjectionPlan, empty)\n181|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"required_dispositions\", \"no class\")\n182|\tfifth := mutateMember(t, request, \"fidelity_profile\", `\"archive_only\"`)\n183|\t_, err = CheckRequestBody(OpProjectionPlan, fifth)\n184|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"fidelity_profile\", \"four-profile vocabulary\")\n185|\tduplicated := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"exact\",\"exact\"]}`)\n186|\t_, err = CheckRequestBody(OpProjectionPlan, duplicated)\n187|\tif err == nil {\n188|\t\tt.Fatal(\"admitted a duplicated disposition\")\n189|\t}\n190|}\n191|\n(more lines below)"}}}
