t\"session_adapter_manifest_digest\",\n36|\t\"executable_sha256\",\n37|\t\"request_digest\",\n38|\t\"extensions\",\n39|}\n40|\n41|// CallContext is one validated AdapterCallContext. The raw member\n42|// is retained so the success echo can be compared byte-for-byte:\n43|// the adapter must echo the context exactly, not rebuild it.\n44|type CallContext struct {\n45|\tOperationID      string\n46|\tProviderID       string\n47|\tEnvironment      Tuple\n48|\tManifestDigest   string\n49|\tExecutableSHA256 string\n50|\tRequestDigest    string\n51|\traw              []byte\n52|}\n53|\n54|// Raw returns the canonical context bytes for echo comparison.\n55|func (context CallContext) Raw() []byte {\n56|\treturn append([]byte(nil), context.raw...)\n57|}\n58|\n59|// DecodeCallContext validates one closed AdapterCallContext.\n60|func DecodeCallContext(raw json.RawMessage) (CallContext, error) {\n61|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n62|\tif fault != nil {\n63|\t\tfailure, err := failProtocol(\"call context \"+fault.detail, fault.member)\n64|\t\tif err != nil {\n65|\t\t\treturn CallContext{}, err\n66|\t\t}\n67|\t\treturn CallContext{}, failure\n68|\t}\n69|\tif name, unknown := unknownMember(members, contextMembers); unknown {\n70|\t\tfailure, err := failProtocol(\"call context carries unknown member\", name)\n71|\t\tif err != nil {\n72|\t\t\treturn CallContext{}, err\n73|\t\t}\n74|\t\treturn CallContext{}, failure\n75|\t}\n76|\tif name, missing := missingMember(members, contextRequired); missing {\n77|\t\tfailure, err := failProtocol(\"call context misses a required member\", name)\n78|\t\tif err != nil {\n79|\t\t\treturn CallContext{}, err\n80|\t\t}\n81|\t\treturn CallContext{}, failure\n82|\t}\n83|\toperationID, ok := checkUUIDv7(members[\"operation_id\"])\n84|\tif !ok {\n85|\t\tfailure, err := failProtocol(\"call context operation identifier is not a UUIDv7\", \"operation_id\")\n86|\t\tif err != nil {\n87|\t\t\treturn CallContext{}, err\n88|\t\t}\n89|\t\treturn CallContext{}, failure\n90|\t}\n91|\tproviderID, ok := rawString(members[\"provider_id\"])\n92|\tif !ok || !providerIDPattern.MatchString(providerID) {\n93|\t\tfailure, err := failProtocol(\"call context provider identifier is not a provider-id\", \"provider_id\")\n94|\t\tif err != nil {\n95|\t\t\treturn CallContext{}, err\n96|\t\t}\n97|\t\treturn CallContext{}, failure\n98|\t}\n99|\tenvironment, err := DecodeTuple(members[\"environment\"])\n100|\tif err != nil {\n101|\t\treturn CallContext{}, err\n102|\t}\n103|\tmanifestDigest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n104|\tif !ok {\n105|\t\tfailure, faultErr := failProtocol(\"call context manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n106|\t\tif faultErr != nil {\n107|\t\t\treturn CallContext{}, faultErr\n108|\t\t}\n109|\t\treturn CallContext{}, failure\n110|\t}\n111|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n112|\tif !ok {\n113|\t\tfailure, faultErr := failProtocol(\"call context executable digest is not a digest\", \"executable_sha256\")\n114|\t\tif faultErr != nil {\n115|\t\t\treturn CallContext{}, faultErr\n116|\t\t}\n117|\t\treturn CallContext{}, failure\n118|\t}\n119|\trequestDigest, ok := checkDigest(members[\"request_digest\"])\n120|\tif !ok {\n121|\t\tfailure, faultErr := failProtocol(\"call context request digest is not a digest\", \"request_digest\")\n122|\t\tif faultErr != nil {\n123|\t\t\treturn CallContext{}, faultErr\n124|\t\t}\n125|\t\treturn CallContext{}, failure\n126|\t}\n127|\tif !checkExtensions(members[\"extensions\"]) {\n128|\t\tfailure, faultErr := failProtocol(\"call context extensions are not reverse-DNS keyed\", \"extensions\")\n129|\t\tif faultErr != nil {\n130|\t\t\treturn CallContext{}, faultErr\n131|\t\t}\n132|\t\treturn CallContext{}, failure\n133|\t}\n134|\tcanonical, err := canonicaljson.Canonicalize(bytesTrimSpace(raw))\n135|\tif err != nil {\n136|\t\tfailure, faultErr := failProtocol(\"call context