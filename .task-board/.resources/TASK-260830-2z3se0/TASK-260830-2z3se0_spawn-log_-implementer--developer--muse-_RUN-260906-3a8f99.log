{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c80b","stream":{"kind":"session","id":"01a0741b-6622-7cb3-8912-9b715d19fde5"},"sequence":608,"recorded_at":1780531400001211,"record_type":"event","durability":"durable","causation_id":"299e9e89-8e07-4f61-8116-490e98862efb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"299e9e89-8e07-4f61-8116-490e98862efb","run_stream":{"kind":"run","id":"299e9e89-8e07-4f61-8116-490e98862efb"},"task_stream":{"kind":"task","id":"6749d683-4a5f-4a21-b447-062a3f048d27"},"task_id":"6749d683-4a5f-4a21-b447-062a3f048d27","event":{"kind":"output","task_id":"6749d683-4a5f-4a21-b447-062a3f048d27","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3drr2m/worktree/internal/sessadapter/envelope_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n9|)\n10|\n11|// fixtureRequestFrame builds one valid request frame for the\n12|// operation with the probe-shaped body replaced by the caller.\n13|func fixtureRequestFrame(t *testing.T, operation Operation, body string) []byte {\n14|\tt.Helper()\n15|\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":%q,\"deadline\":%q,\"body\":%s}`,\n16|\t\tProtocolID, fixtureRequestID, string(operation), fixtureDeadline, body))\n17|}\n18|\n19|// wantRequest is the Request a valid doctor frame decodes to.\n20|func wantRequest() Request {\n21|\treturn Request{Operation: OpDoctor, RequestID: fixtureRequestID}\n22|}\n23|\n24|func TestDecodeRequestFrameAcceptsValidEnvelope(t *testing.T) {\n25|\tframe := fixtureRequestFrame(t, OpDoctor, `{\"context\":{},\"direction\":\"source_read\",\"tuple_registry_digest\":\"`+fixtureRegistryDigest+`\",\"refresh_requested\":false,\"extensions\":{}}`)\n26|\tgot, err := DecodeRequestFrame(frame)\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"DecodeRequestFrame: %v\", err)\n29|\t}\n30|\tif got.Operation != OpDoctor || got.RequestID != fixtureRequestID {\n31|\t\tt.Fatalf(\"DecodeRequestFrame = %+v, want doctor/%s\", got, fixtureRequestID)\n32|\t}\n33|}\n34|\n35|func TestDecodeRequestFrameRefusals(t *testing.T) {\n36|\tvalidBody := `{\"expected_provider_id\":\"test-provider\",\"expected_candidate_kind\":\"builtin\",\"extensions\":{}}`\n37|\tfor _, test := range []struct {\n38|\t\tname  string\n39|\t\tframe func() []byte\n40|\t\tcode  axerror.Code\n41|\t\tkey   string\n42|\t\tvalue string\n43|\t\ttext  string\n44|\t}{\n45|\t\t{\n46|\t\t\tname:  \"empty frame\",\n47|\t\t\tframe: func() []byte { return nil },\n48|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"\", text: \"request frame is empty\",\n49|\t\t},\n50|\t\t{\n51|\t\t\tname:  \"non object frame\",\n52|\t\t\tframe: func() []byte { return []byte(`[1,2]`) },\n53|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"\", text: \"request envelope not a JSON object\",\n54|\t\t},\n55|\t\t{\n56|\t\t\tname: \"unknown envelope member\",\n57|\t\t\tframe: func() []byte {\n58|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"unexpected\", `true`)\n59|\t\t\t},\n60|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"unexpected\", text: \"unknown member\",\n61|\t\t},\n62|\t\t{\n63|\t\t\tname:  \"missing operation\",\n64|\t\t\tframe: func() []byte { return dropMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"operation\") },\n65|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"operation\", text: \"misses a required member\",\n66|\t\t},\n67|\t\t{\n68|\t\t\tname: \"wrong protocol\",\n69|\t\t\tframe: func() []byte {\n70|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"protocol\", `\"urn:ax:protocol:provider\"`)\n71|\t\t\t},\n72|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"protocol\", text: \"not the session adapter\",\n73|\t\t},\n74|\t\t{\n75|\t\t\tname: \"wrong version\",\n76|\t\t\tframe: func() []byte {\n77|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"protocol_version\", `\"2.0.0\"`)\n78|\t\t\t},\n79|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"protocol_version\", text: \"not 1.0.0\",\n80|\t\t},\n81|\t\t{\n82|\t\t\tname: \"non uuid request id\",\n83|\t\t\tframe: func() []byte {\n84|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"request_id\", `\"not-a-uuid\"`)\n85|\t\t\t},\n86|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"request_id\", text: \"not a UUIDv7\",\n87|\t\t},\n88|\t\t{\n89|\t\t\tname: \"unknown operation\",\n90|\t\t\tframe: func() []byte {\n91|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"operation\", `\"launch\"`)\n92|\t\t\t},\n93|\t\t\tcode: \"operation_unknown\", key: \"operation\", value: \"launch\", text: \"outside the closed registry\",\n94|\t\t},\n95|\t\t{\n96|\t\t\tname:  \"empty operation\",\n97|\t\t\tframe: func() []byte { return mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"operation\", `\"\"`) },\n98|\t\t\tcode:  \"operation_unknown\", key: \"operation\", value: \"\", text: \"outside the closed registry\",\n99|\t\t},\n100|\t\t{\n101|\t\t\tname: \"bad deadline\",\n102|\t\t\tframe: func() []byte {\n103|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"deadline\", `\"yesterday\"`)\n104|\t\t\t},\n105|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"deadline\", text: \"not a timestamp\",\n106|\t\t},\n107|\t\t{\n108|\t\t\tname:  \"non object body\",\n109|\t\t\tframe: func() []byte { return mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"body\", `[]`) },\n110|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"body\", text: \"not a JSON object\",\n111|\t\t},\n112|\t\t{\n113|\t\t\tname: \"duplicate member\",\n114|\t\t\tframe: func() []byte {\n115|\t\t\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:session-adapter\",\"protocol_version\":\"1.0.0\",\"request_id\":\"` + fixtureRequestID + `\",\"operation\":\"probe\",\"operation\":\"probe\",\"deadline\":\"` + fixtureDeadline + `\",\"body\":{}}`)\n116|\t\t\t},\n117|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"operation\", text: \"duplicate member\",\n118|\t\t},\n119|\t} {\n120|\t\tt.Run(test.name, func(t *testing.T) {\n121|\t\t\t_, err := DecodeRequestFrame(test.frame())\n122|\t\t\trequireRefusal(t, err, test.code, test.key, test.value, test.text)\n123|\t\t})\n124|\t}\n125|}\n126|\n127|func TestDecodeRequestFrameRefusesOversizeFrame(t *testing.T) {\n128|\tpadding := strings.Repeat(\"a\", MaxFrameBytes)\n129|\tframe := fixtureRequestFrame(t, OpProbe, `{\"expected_provider_id\":\"`+padding+`\",\"expected_candidate_kind\":\"builtin\",\"extensions\":{}}`)\n130|\tif len(frame) <= MaxFrameBytes {\n131|\t\tt.Fatalf(\"oversize fixture is %d bytes, want above %d\", len(frame), MaxFrameBytes)\n132|\t}\n133|\t_, err := DecodeRequestFrame(frame)\n134|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"\", \"exceeds the 8 MiB bound\")\n135|}\n136|\n137|func TestCheckSuccessEnvelopeAcceptsValidFrame(t *testing.T) {\n138|\tbody := `{\"direction\":\"source_read\"}`\n139|\tframe := []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":true,\"body\":%s}`,\n140|\t\tProtocolID, fixtureRequestID, body))\n141|\tgot, err := CheckSuccessEnvelope(frame, wantRequest())\n142|\tif err != nil {\n143|\t\tt.Fatalf(\"CheckSuccessEnvelope: %v\", err)\n144|\t}\n145|\tif string(got) != body {\n146|\t\tt.Fatalf(\"CheckSuccessEnvelope body = %s, want %s\", got, body)\n147|\t}\n148|}\n149|\n150|func TestCheckSuccessEnvelopeRefusals(t *testing.T) {\n151|\tgood := func() []byte {\n152|\t\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":true,\"body\":{}}`,\n153|\t\t\tProtocolID, fixtureRequestID))\n154|\t}\n155|\tfor _, test := range []struct {\n156|\t\tname  string\n157|\t\tframe func() []byte\n158|\t\tkey   string\n159|\t\tvalue string\n160|\t\ttext  string\n161|\t}{\n162|\t\t{\n163|\t\t\tname:  \"error member on success\",\n164|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"error\", `{\"code\":\"x\"}`) },\n165|\t\t\tkey:   \"member\", value: \"error\", text: \"unknown member\",\n166|\t\t},\n167|\t\t{\n168|\t\t\tname:  \"missing body\",\n169|\t\t\tframe: func() []byte { return dropMember(t, good(), \"body\") },\n170|\t\t\tkey:   \"member\", value: \"body\", text: \"misses a required member\",\n171|\t\t},\n172|\t\t{\n173|\t\t\tname:  \"request id mismatch\",\n174|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"request_id\", `\"0198f4c8-8e50-7f66-8f70-1234567890aa\"`) },\n175|\t\t\tkey:   \"member\", value: \"request_id\", text: \"does not echo\",\n176|\t\t},\n177|\t\t{\n178|\t\t\tname:  \"operation mismatch\",\n179|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"operation\", `\"probe\"`) },\n180|\t\t\tkey:   \"member\", value: \"operation\", text: \"does not echo\",\n181|\t\t},\n182|\t\t{\n183|\t\t\tname:  \"protocol mismatch\",\n184|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"protocol\", `\"urn:ax:protocol:provider\"`) },\n185|\t\t\tkey:   \"member\", value: \"protocol\", text: \"does not echo\",\n186|\t\t},\n187|\t\t{\n188|\t\t\tname:  \"version mismatch\",\n189|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"protocol_version\", `\"9.9.9\"`) },\n190|\t\t\tkey:   \"member\", value: \"protocol_version\", text: \"does not echo\",\n191|\t\t},\n192|\t\t{\n193|\t\t\tname:  \"ok false\",\n194|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"ok\", `false`) },\n195|\t\t\tkey:   \"member\", value: \"ok\", text: \"does not carry ok=true\",\n196|\t\t},\n197|\t\t{\n198|\t\t\tname:  \"null body\",\n199|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"body\", `null`) },\n200|\t\t\tkey:   \"member\", value: \"body\", text: \"not a JSON object\",\n201|\t\t},\n202|\t} {\n203|\t\tt.Run(test.name, func(t *testing.T) {\n204|\t\t\t_, err := CheckSuccessEnvelope(test.frame(), wantRequest())\n205|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n206|\t\t})\n207|\t}\n208|}\n209|\n210|func TestCheckFailureEnvelopeAcceptsBoundError(t *testing.T) {\n211|\tframe := []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.1.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`,\n212|\t\tProtocolID, fixtureRequestID))\n213|\treported, err := CheckFailureEnvelope(frame, wantRequest())\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"CheckFailureEnvelope: %v\", err)\n216|\t}\n217|\tif reported.Code() != \"capability_unavailable\" || reported.ExitCode() != 6 {\n218|\t\tt.Fatalf(\"reported = %s/%d, want capability_unavailable/6\", reported.Code(), reported.ExitCode())\n219|\t}\n220|}\n221|\n222|func TestCheckFailureEnvelopeRefusals(t *testing.T) {\n223|\tgood := func() []byte {\n224|\t\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.1.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`,\n225|\t\t\tProtocolID, fixtureRequestID))\n226|\t}\n227|\tfor _, test := range []struct {\n228|\t\tname  string\n229|\t\tframe func() []byte\n230|\t\tcode  axerror.Code\n231|\t\tkey   string\n232|\t\tvalue string\n233|\t\ttext  string\n234|\t}{\n235|\t\t{\n236|\t\t\tname:  \"body member on failure\",\n237|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"body\", `{}`) },\n238|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"body\", text: \"unknown member\",\n239|\t\t},\n240|\t\t{\n241|\t\t\tname:  \"ok true\",\n242|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"ok\", `true`) },\n243|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"ok\", text: \"does not carry ok=false\",\n244|\t\t},\n245|\t\t{\n246|\t\t\tname:  \"request id mismatch\",\n247|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"request_id\", `\"0198f4c8-8e50-7f66-8f70-1234567890aa\"`) },\n248|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"request_id\", text: \"does not echo\",\n249|\t\t},\n250|\t\t{\n251|\t\t\tname: \"wrong error version\",\n252|\t\t\tframe: func() []byte {\n253|\t\t\t\treturn mutateMember(t, good(), \"error\", `{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}`)\n254|\t\t\t},\n255|\t\t\tcode: \"integrity_failure\", key: \"subject\", value: \"error\", text: \"not a Structured Error 1.1\",\n256|\t\t},\n257|\t\t{\n258|\t\t\tname:  \"non object error\",\n259|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"error\", `null`) },\n260|\t\t\tcode:  \"integrity_failure\", key: \"subject\", value: \"error\", text: \"not a Structured Error 1.1\",\n261|\t\t},\n262|\t} {\n263|\t\tt.Run(test.name, func(t *testing.T) {\n264|\t\t\t_, err := CheckFailureEnvelope(test.frame(), wantRequest())\n265|\t\t\tif test.key == \"\" {\n266|\t\t\t\tif failureCode(t, err) != test.code {\n267|\t\t\t\t\tt.Fatalf(\"code = %v, want %s\", err, test.code)\n268|\t\t\t\t}\n269|\t\t\t\tif !strings.Contains(err.Error(), test.text) {\n270|\t\t\t\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, test.text)\n271|\t\t\t\t}\n272|\t\t\t\treturn\n273|\t\t\t}\n274|\t\t\trequireRefusal(t, err, test.code, test.key, test.value, test.text)\n275|\t\t})\n276|\t}\n277|}"}}}
