ig local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board resource [command] --help\\\" for more information about a command.\\nDownload a board resource and save it locally.\\n\\nIf --output is omitted, the file is materialized under:\\n  .temp/resources/<ELEMENT-ID>/<NAME>\\n\\nNested resource names preserve their directory hierarchy below the element.\\n\\nUse --output - to write the resource bytes to stdout.\\n\\nUsage:\\n  task-board resource get <ELEMENT-ID> <NAME> [flags]\\n\\nFlags:\\n  -h, --help            help for get\\n  -o, --output string   Write resource to this path (default: .temp/resources/<ELEMENT-ID>/<NAME>, use - for stdout)\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2615,\n  \"original_output_tokens\": 654,\n  \"truncated\": false\n}"}}}
