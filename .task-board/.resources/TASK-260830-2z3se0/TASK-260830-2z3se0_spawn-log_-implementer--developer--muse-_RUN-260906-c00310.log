{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb67","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":1038,"recorded_at":1780531400002071,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"a18c1cb3-bc0a-42f0-a337-2986b1ec748d"},"task_id":"a18c1cb3-bc0a-42f0-a337-2986b1ec748d","event":{"kind":"output","task_id":"a18c1cb3-bc0a-42f0-a337-2986b1ec748d","chunk":"edited\nchanged lines: lines 377-397\n--- original\n+++ updated\n@@\n-\t\tast.Inspect(syntax, func(node ast.Node) bool {\n-\t\t\tstatement, ok := node.(*ast.SwitchStmt)\n-\t\t\tif !ok {\n-\t\t\t\treturn true\n-\t\t\t}\n-\t\t\tposition := filepath.Base(path)\n-\t\t\tif tag, ok := statement.Tag.(*ast.Ident); ok && tag.Name == \"operation\" {\n-\t\t\t\tclassified++\n-\t\t\t\treturn true\n-\t\t\t}\n-\t\t\t// The UTF-16 hex classifier switches on nothing:\n-\t\t\t// a tagless switch over digit ranges, which\n-\t\t\t// classifies characters rather than admitting\n-\t\t\t// members.\n-\t\t\tif statement.Tag == nil {\n-\t\t\t\tclassified++\n-\t\t\t\treturn true\n-\t\t\t}\n-\t\t\tunclassified = append(unclassified, position)\n-\t\t\treturn true\n-\t\t})\n+\t\tvar stack []ast.Node\n+\t\tast.Inspect(syntax, func(node ast.Node) bool {\n+\t\t\tif node == nil {\n+\t\t\t\tstack = stack[:len(stack)-1]\n+\t\t\t\treturn true\n+\t\t\t}\n+\t\t\tif statement, ok := node.(*ast.SwitchStmt); ok {\n+\t\t\t\tposition := filepath.Base(path)\n+\t\t\t\tif tag, ok := statement.Tag.(*ast.Ident); ok && tag.Name == \"operation\" {\n+\t\t\t\t\tclassified++\n+\t\t\t\t} else if statement.Tag == nil && enclosingFunc(stack) == \"readUTF16Escape\" {\n+\t\t\t\t\t// The UTF-16 hex classifier switches on\n+\t\t\t\t\t// nothing: a tagless switch over digit\n+\t\t\t\t\t// ranges, which classifies characters\n+\t\t\t\t\t// rather than admitting members. Only\n+\t\t\t\t\t// this function earns the exemption; a\n+\t\t\t\t\t// tagless switch anywhere else is a\n+\t\t\t\t\t// membership gate hiding spot.\n+\t\t\t\t\tclassified++\n+\t\t\t\t} else {\n+\t\t\t\t\tunclassified = append(unclassified, position)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tstack = append(stack, node)\n+\t\t\treturn true\n+\t\t})\n"}}}
