{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d3","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":452,"recorded_at":1780531400000899,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"call_id":"call_01a074523dbe7df3a10f4e4ef7e8b963","text":"Read text file `internal/sessadapter/census_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/printer\"\n9|\t\"go/token\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"testing\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n19|)\n20|\n21|// This file is the closed-vocabulary census. It exists because a\n22|// new closed set in production — a map consulted for membership,\n23|// a slice looped for admission, a switch classifying inputs, an\n24|// inline comparison chain admitting two names — passes every\n25|// behavioral test that never names it. The census finds the\n26|// membership surface by parsing production source and fails\n27|// closed on anything with no registered derivation, so the\n28|// surface cannot grow something unwitnessed.\n29|//\n30|// Five checks:\n31|// TestClosedVocabularyTablesAreRegistered scans every\n32|// package-level var shaped like a vocabulary — a map or slice\n33|// composite, written directly or through a named slice or map\n34|// type declared anywhere in the package — and requires each in\n35|// the registration table below with its consultation proof.\n36|// TestNoUnregisteredInlineVocabularies forbids the shape the\n37|// table scan cannot see: a boolean chain comparing one operand\n38|// against two or more closed values (`v == \"a\" || v == \"b\"`,\n39|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n40|// or conversions). Every closed union lives in a registered\n41|// table; a chain is an unregistered union and fails here.\n42|// TestClosedMemberSetsAreDerivedFromSpec parses every closed\n43|// body from the pinned document and requires exact ordered\n44|// equality with the production member tables: a dropped, added,\n45|// or reordered member reddens here.\n46|// TestAllProductionSwitchesAreClassified allows only switches\n47|// dispatching on the validated operation plus the UTF-16 hex\n48|// classifier; any other switch is a membership gate hiding spot\n49|// and fails.\n50|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n51|// against its verbatim spec union as a set.\n52|//\n53|// Stated bound: the scanner is syntactic. It sees composite\n54|// shapes, named-type aliases, and comparison chains, not sets\n55|// built at runtime (a map populated in a loop, a registry\n56|// assembled in init). This package builds no vocabulary that\n57|// way: every table below is a package-level composite literal,\n58|// which the scan asserts by construction — a runtime-built set\n59|// would have to replace a composite the census already pins.\n60|//\n61|// An empty scan, an empty derivation, or an unparseable file\n62|// fails closed throughout: a domain that silently derives\n63|// nothing is not a measurement.\n64|\n65|// registeredVocabulary is one production vocabulary table with\n66|// its consultation proof: the production function or call\n67|// pattern that consults it for membership.\n68|type registeredVocabulary struct {\n69|\tname       string\n70|\tconsulted  string\n71|\tspecMember string\n72|}\n73|\n74|// vocabularyRegistrations lists every package-level vocabulary\n75|// table. A production table with no row here fails the census.\n76|var vocabularyRegistrations = []registeredVocabulary{\n77|\t{name: \"operationOrder\", consulted: \"validOperation\", specMember: \"Section 7.8 operation table\"},\n78|\t{name: \"requestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 request envelope sentence\"},\n79|\t{name: \"requestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 request envelope sentence\"},\n80|\t{name: \"successMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 success envelope rule\"},\n81|\t{name: \"successRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 success envelope rule\"},\n82|\t{name: \"failureMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 failure envelope rule\"},\n83|\t{name: \"failureRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 failure envelope rule\"},\n84|\t{name: \"capabilityOrder\", consulted: \"decodeCapabilities\", specMember: \"Section 7.8 capability sentence\"},\n85|\t{name: \"manifestMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 manifest table\"},\n86|\t{name: \"manifestRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 manifest table\"},\n87|\t{name: \"probeMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 probe sentence\"},\n88|\t{name: \"probeRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 probe sentence\"},\n89|\t{name: \"capabilityValueMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 capability value sentence\"},\n90|\t{name: \"capabilityValueRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 capability value sentence\"},\n91|\t{name: \"capabilityEvidences\", consulted: \"validCapabilityEvidence\", specMember: \"Section 7.8 evidence union\"},\n92|\t{name: \"capabilityStatuses\", consulted: \"validCapabilityStatus\", specMember: \"Section 7.8 status union\"},\n93|\t{name: \"contextMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n94|\t{name: \"contextRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterCallContext sentence\"},\n95|\t{name: \"readAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n96|\t{name: \"readAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ReadAuthority sentence\"},\n97|\t{name: \"objectAuthorityMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n98|\t{name: \"objectAuthorityRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ObjectAuthority sentence\"},\n99|\t{name: \"objectPurposes\", consulted: \"validObjectPurpose\", specMember: \"Section 7.8 purpose union\"},\n100|\t{name: \"objectModes\", consulted: \"validObjectMode\", specMember: \"Section 7.8 ObjectAuthority mode union\"},\n101|\t{name: \"readPurposes\", consulted: \"validReadPurpose\", specMember: \"Section 7.8 ReadAuthority purpose union\"},\n102|\t{name: \"findingSeverities\", consulted: \"validFindingSeverity\", specMember: \"Section 7.8 severity union\"},\n103|\t{name: \"sourceSelectorMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n104|\t{name: \"sourceSelectorRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 SourceSelector sentence\"},\n105|\t{name: \"resourceLimitsMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n106|\t{name: \"resourceLimitsRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 ResourceLimits sentence\"},\n107|\t{name: \"findingMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n108|\t{name: \"findingRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 AdapterFinding sentence\"},\n109|\t{name: \"capturePlanItemMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n110|\t{name: \"capturePlanItemRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 CapturePlanItem sentence\"},\n111|\t{name: \"tupleMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n112|\t{name: \"tupleRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 Environment Tuple sentence\"},\n113|\t{name: \"projectionStrategies\", consulted: \"validStrategy\", specMember: \"Section 13.14 strategy sentence\"},\n114|\t{name: \"fidelityDispositions\", consulted: \"validDisposition\", specMember: \"Section 13.14 disposition sentence\"},\n115|\t{name: \"captureClasses\", consulted: \"validCaptureClass\", specMember: \"Section 13.14 CaptureItem class column\"},\n116|\t{name: \"tupleArchitectures\", consulted: \"validTupleArchitecture\", specMember: \"Section 7.8 architecture union\"},\n117|\t{name: \"tupleKeyMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 key sentence\"},\n118|\t{name: \"tupleKeyRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 key sentence\"},\n119|\t{name: \"tupleEntryMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 entry sentence\"},\n120|\t{name: \"tupleEntryRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 entry sentence\"},\n121|\t{name: \"fixtureEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n122|\t{name: \"fixtureEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FixtureEvidence sentence\"},\n123|\t{name: \"smokeEvidenceMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n124|\t{name: \"smokeEvidenceRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 ResumeSmokeEvidence sentence\"},\n125|\t{name: \"fidelityLimitMembers\", consulted: \"unknownMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n126|\t{name: \"fidelityLimitRequired\", consulted: \"missingMember\", specMember: \"Section 13.14 FidelityLimit sentence\"},\n127|\t{name: \"requestBodyMembers\", consulted: \"CheckRequestBody\", specMember: \"Section 7.8 operation table\"},\n128|\t{name: \"successBodyMembers\", consulted: \"CheckSuccessBody\", specMember: \"Section 7.8 operation table\"},\n129|\t{name: \"fidelityProfiles\", consulted: \"validFidelityProfile\", specMember: \"Section 7.8 profile union\"},\n130|\t{name: \"validateModes\", consulted: \"validValidateMode\", specMember: \"Section 7.8 validate row\"},\n131|\t{name: \"contextFreeOperations\", consulted: \"operationSkipsRequestContext\", specMember: \"Section 7.8 operation table (context-free request bodies)\"},\n132|\t{name: \"doctorResultMembers\", consulted: \"unknownMember\", specMember: \"Section 7.8 doctor row\"},\n133|\t{name: \"doctorResultRequired\", consulted: \"missingMember\", specMember: \"Section 7.8 doctor row\"},\n134|\t{name: \"directionNames\", consulted: \"validDirection\", specMember: \"Section 13.14 key direction union and Section 7.8 doctor row\"},\n135|\t{name: \"roleNames\", consulted: \"validRole\", specMember: \"Section 7.8 binding role union\"},\n136|\t{name: \"candidateKindNames\", consulted: \"validCandidateKind\", specMember: \"Section 7.8 candidate-kind union\"},\n137|\t{name: \"tupleEntryStatuses\", consulted: \"validTupleEntryStatus\", specMember: \"Section 13.14 entry status union\"},\n138|\t{name: \"evidenceResults\", consulted: \"validEvidenceResult\", specMember: \"Sections 13.14 result=pass\"},\n139|\t{name: \"registryEntryStatuses\", consulted: \"validRegistryEntryStatus\", specMember: \"Section 7.8 doctor row\"},\n140|}\n141|\n142|// TestClosedVocabularyTablesAreRegistered is the census: every\n143|// package-level vocabulary-shaped var must carry a registration\n144|// row naming its consultation. A new table without a row fails\n145|// here rather than passing silently.\n146|func TestClosedVocabularyTablesAreRegistered(t *testing.T) {\n147|\tdirectory, err := os.Getwd()\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"census: %v\", err)\n150|\t}\n151|\tregistered := map[string]registeredVocabulary{}\n152|\tfor _, entry := range vocabularyRegistrations {\n153|\t\tif _, duplicate := registered[entry.name]; duplicate {\n154|\t\t\tt.Fatalf(\"census registers %q twice\", entry.name)\n155|\t\t}\n156|\t\tregistered[entry.name] = entry\n157|\t}\n158|\tfound, scanned := scanVocabularyTables(t, directory)\n159|\tif len(scanned) == 0 {\n160|\t\tt.Fatal(\"census scanned zero production files; the scanner is broken, not the package\")\n161|\t}\n162|\tif len(found) == 0 {\n163|\t\tt.Fatal(\"census found zero vocabulary tables; the scanner is broken, not the package\")\n164|\t}\n165|\tvar unregistered []string\n166|\tfor _, name := range found {\n167|\t\tentry, ok := registered[name]\n168|\t\tif !ok {\n169|\t\t\tunregistered = append(unregistered, name)\n170|\t\t\tcontinue\n171|\t\t}\n172|\t\tif entry.consulted == \"\" || entry.specMember == \"\" {\n173|\t\t\tt.Errorf(\"census registration of %q names no consultation or spec member\", name)\n174|\t\t}\n175|\t}\n176|\tsort.Strings(unregistered)\n177|\tif len(unregistered) > 0 {\n178|\t\tt.Fatalf(\"production vocabulary table(s) with no census registration:\\n  %s\", strings.Join(unregistered, \"\\n  \"))\n179|\t}\n180|\tvar orphaned []string\n181|\tfor name := range registered {\n182|\t\tpresent := false\n183|\t\tfor _, table := range found {\n184|\t\t\tif table == name {\n185|\t\t\t\tpresent = true\n186|\t\t\t\tbreak\n187|\t\t\t}\n188|\t\t}\n189|\t\tif !present {\n190|\t\t\torphaned = append(orphaned, name)\n191|\t\t}\n192|\t}\n193|\tsort.Strings(orphaned)\n194|\tif len(orphaned) > 0 {\n195|\t\tt.Fatalf(\"census registration(s) naming no production table:\\n  %s\", strings.Join(orphaned, \"\\n  \"))\n196|\t}\n197|\tt.Logf(\"vocabulary census: %d tables registered across %d files\", len(found), len(scanned))\n198|}\n199|\n200|// scanVocabularyTables returns every package-level var shaped\n201|// like a vocabulary: a map or slice composite, written directly\n202|// or through a named slice or map type declared anywhere in the\n203|// package. A named-type table (`type names []string` plus\n204|// `var t = names{...}`) is the same closed set as a literal one,\n205|// and the census sees both.\n206|func scanVocabularyTables(t *testing.T, directory string) ([]string, []string) {\n207|\tt.Helper()\n208|\tentries, err := os.ReadDir(directory)\n209|\tif err != nil {\n210|\t\tt.Fatalf(\"census: %v\", err)\n211|\t}\n212|\ttype namedFile struct {\n213|\t\tname   string\n214|\t\tsyntax *ast.File\n215|\t}\n216|\tvar files []namedFile\n217|\tvar scanned []string\n218|\tfor _, entry := range entries {\n219|\t\tname := entry.Name()\n220|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tscanned = append(scanned, name)\n224|\t\tpath := filepath.Join(directory, name)\n225|\t\tsource, err := os.ReadFile(path)\n226|\t\tif err != nil {\n227|\t\t\tt.Fatalf(\"census: %v\", err)\n228|\t\t}\n229|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n230|\t\tif err != nil {\n231|\t\t\tt.Fatalf(\"census: %v\", err)\n232|\t\t}\n233|\t\tfiles = append(files, namedFile{name: name, syntax: syntax})\n234|\t}\n235|\tnamed := map[string]ast.Expr{}\n236|\tfor _, file := range files {\n237|\t\tcollectNamedCompositeTypes(file.syntax, named)\n238|\t}\n239|\tvar found []string\n240|\tfor _, file := range files {\n241|\t\tfound = append(found, vocabularyTablesInFile(file.syntax, named)...)\n242|\t}\n243|\treturn found, scanned\n244|}\n245|\n246|// collectNamedCompositeTypes records every package-level type\n247|// name declared with a composite underlying type: a direct map or\n248|// slice, or another named type resolved later. Struct, string,\n249|// and other underlying types are recorded too, so a struct\n250|// literal through a named type is never mistaken for a table.\n251|func collectNamedCompositeTypes(syntax *ast.File, named map[string]ast.Expr) {\n252|\tfor _, declaration := range syntax.Decls {\n253|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n254|\t\tif !ok || general.Tok != token.TYPE {\n255|\t\t\tcontinue\n256|\t\t}\n257|\t\tfor _, specification := range general.Specs {\n258|\t\t\talias, ok := specification.(*ast.TypeSpec)\n259|\t\t\tif !ok {\n260|\t\t\t\tcontinue\n261|\t\t\t}\n262|\t\t\tnamed[alias.Name.Name] = alias.Type\n263|\t\t}\n264|\t}\n265|}\n266|\n267|// vocabularyTablesInFile returns the package-level vars of one\n268|// file whose single initializer is a vocabulary composite.\n269|func vocabularyTablesInFile(syntax *ast.File, named map[string]ast.Expr) []string {\n270|\tvar found []string\n271|\tfor _, declaration := range syntax.Decls {\n272|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n273|\t\tif !ok || general.Tok != token.VAR {\n274|\t\t\tcontinue\n275|\t\t}\n276|\t\tfor _, specification := range general.Specs {\n277|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n278|\t\t\tif !ok || len(value.Values) != 1 {\n279|\t\t\t\tcontinue\n280|\t\t\t}\n281|\t\t\tif isVocabularyShape(value.Values[0], named) {\n282|\t\t\t\tfor _, ident := range value.Names {\n283|\t\t\t\t\tfound = append(found, ident.Name)\n284|\t\t\t\t}\n285|\t\t\t}\n286|\t\t}\n287|\t}\n288|\treturn found\n289|}\n290|\n291|// isVocabularyShape reports whether the initializer is a\n292|// vocabulary composite: a map or slice literal, or a composite\n293|// through a named type whose underlying type — resolved across\n294|// the package, through any alias chain — is a map or slice.\n295|// Element type is irrelevant; registrations name the table, not\n296|// its shape. A composite through any other named type (a struct\n297|// literal, a string conversion) is not a table.\n298|func isVocabularyShape(node ast.Expr, named map[string]ast.Expr) bool {\n299|\tliteral, ok := node.(*ast.CompositeLit)\n300|\tif !ok {\n301|\t\treturn false\n302|\t}\n303|\tswitch typ := literal.Type.(type) {\n304|\tcase *ast.MapType, *ast.ArrayType:\n305|\t\treturn true\n306|\tcase *ast.Ident:\n307|\t\treturn resolvesToComposite(typ.Name, named, 0)\n308|\t}\n309|\treturn false\n310|}\n311|\n312|// resolvesToComposite reports whether the named type ultimately\n313|// denotes a map or slice. Alias chains resolve up to a fixed\n314|// depth; a cycle or an unknown name is not a table.\n315|func resolvesToComposite(name string, named map[string]ast.Expr, depth int) bool {\n316|\tif depth > 8 {\n317|\t\treturn false\n318|\t}\n319|\tunderlying, ok := named[name]\n320|\tif !ok {\n321|\t\treturn false\n322|\t}\n323|\tswitch typ := underlying.(type) {\n324|\tcase *ast.MapType, *ast.ArrayType:\n325|\t\treturn true\n326|\tcase *ast.Ident:\n327|\t\treturn resolvesToComposite(typ.Name, named, depth+1)\n328|\t}\n329|\treturn false\n330|}\n331|\n332|// TestAllProductionSwitchesAreClassified allows only switches\n333|// dispatching on the validated operation plus the UTF-16 hex\n334|// classifier in readUTF16Escape. Any other switch is a\n335|// membership gate hiding spot and fails: membership lives in\n336|// tables the census sees, never in case arms it cannot.\n337|func TestAllProductionSwitchesAreClassified(t *testing.T) {\n338|\tdirectory, err := os.Getwd()\n339|\tif err != nil {\n340|\t\tt.Fatalf(\"switch census: %v\", err)\n341|\t}\n342|\tentries, err := os.ReadDir(directory)\n343|\tif err != nil {\n344|\t\tt.Fatalf(\"switch census: %v\", err)\n345|\t}\n346|\tscanned := 0\n347|\tclassified := 0\n348|\tvar unclassified []string\n349|\tfor _, entry := range entries {\n350|\t\tname := entry.Name()\n351|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n352|\t\t\tcontinue\n353|\t\t}\n354|\t\tscanned++\n355|\t\tpath := filepath.Join(directory, name)\n356|\t\tsource, err := os.ReadFile(path)\n357|\t\tif err != nil {\n358|\t\t\tt.Fatalf(\"switch census: %v\", err)\n359|\t\t}\n360|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n361|\t\tif err != nil {\n362|\t\t\tt.Fatalf(\"switch census: %v\", err)\n363|\t\t}\n364|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n365|\t\t\tstatement, ok := node.(*ast.SwitchStmt)\n366|\t\t\tif !ok {\n367|\t\t\t\treturn true\n368|\t\t\t}\n369|\t\t\tposition := filepath.Base(path)\n370|\t\t\tif tag, ok := statement.Tag.(*ast.Ident); ok && tag.Name == \"operation\" {\n371|\t\t\t\tclassified++\n372|\t\t\t\treturn true\n373|\t\t\t}\n374|\t\t\t// The UTF-16 hex classifier switches on nothing:\n375|\t\t\t// a tagless switch over digit ranges, which\n376|\t\t\t// classifies characters rather than admitting\n377|\t\t\t// members.\n378|\t\t\tif statement.Tag == nil {\n379|\t\t\t\tclassified++\n380|\t\t\t\treturn true\n381|\t\t\t}\n382|\t\t\tunclassified = append(unclassified, position)\n383|\t\t\treturn true\n384|\t\t})\n385|\t}\n386|\tif scanned == 0 {\n387|\t\tt.Fatal(\"switch census scanned zero production files\")\n388|\t}\n389|\tsort.Strings(unclassified)\n390|\tif len(unclassified) > 0 {\n391|\t\tt.Fatalf(\"unclassified production switch(es): %s\", strings.Join(unclassified, \", \"))\n392|\t}\n393|\tt.Logf(\"switch census: %d classified switches across %d files\", classified, scanned)\n394|}\n395|\n396|// TestNoUnregisteredInlineVocabularies is the chain census: no\n397|// production boolean chain may compare one operand against two\n398|// or more closed values. `v == \"a\" || v == \"b\"`,\n399|// `v != \"a\" && v != \"b\"`, and the same shapes through constants\n400|// (`role != RoleSource && role != RoleTarget`) or conversions are\n401|// unions outside every table, and a widened chain survives every\n402|// behavioral test that never names the new member. Single\n403|// comparisons — one dispatch member (`mode == \"archive\"`), one\n404|// sentinel (`== \"\"`), one echo — are not unions and pass.\n405|func TestNoUnregisteredInlineVocabularies(t *testing.T) {\n406|\tdirectory, err := os.Getwd()\n407|\tif err != nil {\n408|\t\tt.Fatalf(\"chain census: %v\", err)\n409|\t}\n410|\tentries, err := os.ReadDir(directory)\n411|\tif err != nil {\n412|\t\tt.Fatalf(\"chain census: %v\", err)\n413|\t}\n414|\tscanned := 0\n415|\tvar unregistered []string\n416|\tfor _, entry := range entries {\n417|\t\tname := entry.Name()\n418|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n419|\t\t\tcontinue\n420|\t\t}\n421|\t\tscanned++\n422|\t\tpath := filepath.Join(directory, name)\n423|\t\tsource, err := os.ReadFile(path)\n424|\t\tif err != nil {\n425|\t\t\tt.Fatalf(\"chain census: %v\", err)\n426|\t\t}\n427|\t\tfileSet := token.NewFileSet()\n428|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n429|\t\tif err != nil {\n430|\t\t\tt.Fatalf(\"chain census: %v\", err)\n431|\t\t}\n432|\t\tfor _, chain := range inlineVocabulariesInFile(fileSet, syntax) {\n433|\t\t\tunregistered = append(unregistered, name+\": \"+chain)\n434|\t\t}\n435|\t}\n436|\tif scanned == 0 {\n437|\t\tt.Fatal(\"chain census scanned zero production files\")\n438|\t}\n439|\tsort.Strings(unregistered)\n440|\tif len(unregistered) > 0 {\n441|\t\tt.Fatalf(\"unregistered inline vocabular%s:\\n  %s\",\n442|\t\t\tmap[bool]string{true: \"y\", false: \"ies\"}[len(unregistered) == 1],\n443|\t\t\tstrings.Join(unregistered, \"\\n  \"))\n444|\t}\n445|\tt.Logf(\"chain census: no inline vocabularies across %d files\", scanned)\n446|}\n447|\n448|// inlineChainComparison is one equality comparison inside a\n449|// boolean chain: the rendered operand plus the closed value it is\n450|// compared against.\n451|type inlineChainComparison struct {\n452|\toperand string\n453|\tvalue   string\n454|}\n455|\n456|// inlineVocabulariesInFile reports every operand compared against\n457|// two or more distinct closed values inside one boolean chain of\n458|// the file, as \"operand <- value, value\" strings. Groups merge\n459|// only within a single chain subtree, never across statements.\n460|func inlineVocabulariesInFile(fileSet *token.FileSet, syntax *ast.File) []string {\n461|\tseen := map[string]struct{}{}\n462|\tvar unregistered []string\n463|\tast.Inspect(syntax, func(node ast.Node) bool {\n464|\t\tchain, ok := node.(*ast.BinaryExpr)\n465|\t\tif !ok || (chain.Op != token.LOR && chain.Op != token.LAND) {\n466|\t\t\treturn true\n467|\t\t}\n468|\t\tvar comparisons []inlineChainComparison\n469|\t\tflattenChainComparisons(fileSet, chain, &comparisons)\n470|\t\tgroups := map[string]map[string]struct{}{}\n471|\t\tfor _, comparison := range comparisons {\n472|\t\t\tif comparison.operand == \"\" || comparison.value == \"\" {\n473|\t\t\t\tcontinue\n474|\t\t\t}\n475|\t\t\tset := groups[comparison.operand]\n476|\t\t\tif set == nil {\n477|\t\t\t\tset = map[string]struct{}{}\n478|\t\t\t\tgroups[comparison.operand] = set\n479|\t\t\t}\n480|\t\t\tset[comparison.value] = struct{}{}\n481|\t\t}\n482|\t\tfor operand, values := range groups {\n483|\t\t\tif len(values) < 2 {\n484|\t\t\t\tcontinue\n485|\t\t\t}\n486|\t\t\tvar names []string\n487|\t\t\tfor value := range values {\n488|\t\t\t\tnames = append(names, value)\n489|\t\t\t}\n490|\t\t\tsort.Strings(names)\n491|\t\t\tkey := operand + \" <- \" + strings.Join(names, \", \")\n492|\t\t\tif _, duplicate := seen[key]; duplicate {\n493|\t\t\t\tcontinue\n494|\t\t\t}\n495|\t\t\tseen[key] = struct{}{}\n496|\t\t\tposition := fileSet.Position(chain.Pos())\n497|\t\t\tunregistered = append(unregistered, fmt.Sprintf(\"%s compares %s\", position, key))\n498|\t\t}\n499|\t\treturn true\n500|\t})\n501|\tsort.Strings(unregistered)\n502|\treturn unregistered\n503|}\n504|\n505|// flattenChainComparisons collects every equality comparison in\n506|// one boolean-chain subtree, descending through ||, &&, and\n507|// parentheses. Anything else contributes only itself when it is\n508|// a qualifying comparison.\n509|func flattenChainComparisons(fileSet *token.FileSet, node ast.Node, out *[]inlineChainComparison) {\n510|\tswitch node := node.(type) {\n511|\tcase *ast.ParenExpr:\n512|\t\tflattenChainComparisons(fileSet, node.X, out)\n513|\tcase *ast.BinaryExpr:\n514|\t\tif node.Op == token.LOR || node.Op == token.LAND {\n515|\t\t\tflattenChainComparisons(fileSet, node.X, out)\n516|\t\t\tflattenChainComparisons(fileSet, node.Y, out)\n517|\t\t\treturn\n518|\t\t}\n519|\t\tif node.Op == token.EQL || node.Op == token.NEQ {\n520|\t\t\t*out = append(*out, chainComparisons(fileSet, node)...)\n521|\t\t}\n522|\t}\n523|}\n524|\n525|// chainComparisons renders one equality comparison as operand\n526|// comparisons. A string literal on either side makes the other\n527|// side the operand. Two bare identifiers record both\n528|// orientations, because either side may be the closed constant —\n529|// except the predeclared nil, true, and false, which are presence\n530|// checks, never union members. A bare identifier against a field,\n531|// conversion, or call result makes the composite the operand and\n532|// the identifier the value. Anything else is not a closed-value\n533|// comparison: numeric bounds, rune classifiers, nil presence,\n534|// and field-to-field equality all pass through uncounted.\n535|func chainComparisons(fileSet *token.FileSet, comparison *ast.BinaryExpr) []inlineChainComparison {\n536|\tleft, right := unwrapParens(comparison.X), unwrapParens(comparison.Y)\n537|\tif value, ok := closedValue(left); ok {\n538|\t\tif operand := renderExpr(fileSet, right); operand != \"\" {\n539|\t\t\treturn []inlineChainComparison{{operand: operand, value: value}}\n540|\t\t}\n541|\t\treturn nil\n542|\t}\n543|\tif value, ok := closedValue(right); ok {\n544|\t\tif operand := renderExpr(fileSet, left); operand != \"\" {\n545|\t\t\treturn []inlineChainComparison{{operand: operand, value: value}}\n546|\t\t}\n547|\t\treturn nil\n548|\t}\n549|\tleftIdent, leftIsIdent := left.(*ast.Ident)\n550|\trightIdent, rightIsIdent := right.(*ast.Ident)\n551|\tif leftIsIdent && rightIsIdent {\n552|\t\tif predeclared(leftIdent.Name) || predeclared(rightIdent.Name) {\n553|\t\t\treturn nil\n554|\t\t}\n555|\t\treturn []inlineChainComparison{\n556|\t\t\t{operand: leftIdent.Name, value: rightIdent.Name},\n557|\t\t\t{operand: rightIdent.Name, value: leftIdent.Name},\n558|\t\t}\n559|\t}\n560|\tif leftIsIdent && isCompositeOperand(right) {\n561|\t\tif operand := renderExpr(fileSet, right); operand != \"\" {\n562|\t\t\treturn []inlineChainComparison{{operand: operand, value: leftIdent.Name}}\n563|\t\t}\n564|\t\treturn nil\n565|\t}\n566|\tif rightIsIdent && isCompositeOperand(left) {\n567|\t\tif operand := renderExpr(fileSet, left); operand != \"\" {\n568|\t\t\treturn []inlineChainComparison{{operand: operand, value: rightIdent.Name}}\n569|\t\t}\n570|\t\treturn nil\n571|\t}\n572|\treturn nil\n573|}\n574|\n575|// unwrapParens strips parenthesized wrappers so a parenthesized\n576|// operand still groups with its bare spelling.\n577|func unwrapParens(node ast.Expr) ast.Expr {\n578|\tfor {\n579|\t\tparenthesized, ok := node.(*ast.ParenExpr)\n580|\t\tif !ok {\n581|\t\t\treturn node\n582|\t\t}\n583|\t\tnode = parenthesized.X\n584|\t}\n585|}\n586|\n587|// predeclared reports whether the identifier is a predeclared\n588|// constant: a nil, true, or false comparison is a presence or\n589|// flag check, never a closed-union member.\n590|func predeclared(name string) bool {\n591|\treturn name == \"nil\" || name == \"true\" || name == \"false\"\n592|}\n593|\n594|// isCompositeOperand reports whether the expression is a field,\n595|// conversion, or call result: the shapes a closed constant is\n596|// compared against. Literals, identifiers, and composite\n597|// literals are classified elsewhere or not at all.\n598|func isCompositeOperand(node ast.Expr) bool {\n599|\tswitch node.(type) {\n600|\tcase *ast.SelectorExpr, *ast.CallExpr, *ast.IndexExpr:\n601|\t\treturn true\n602|\t}\n603|\treturn false\n604|}\n605|\n606|// closedValue returns the closed value of a string literal\n607|// operand, unquoted so equivalent spellings group together.\n608|func closedValue(node ast.Expr) (string, bool) {\n609|\tliteral, ok := node.(*ast.BasicLit)\n610|\tif !ok || literal.Kind != token.STRING {\n611|\t\treturn \"\", false\n612|\t}\n613|\tif value, err := strconv.Unquote(literal.Value); err == nil {\n614|\t\treturn value, true\n615|\t}\n616|\treturn literal.Value, true\n617|}\n618|\n619|// renderExpr renders one operand to its source text for grouping:\n620|// two comparisons group only when their operands spell\n621|// identically.\n622|func renderExpr(fileSet *token.FileSet, node ast.Node) string {\n623|\tvar buffer bytes.Buffer\n624|\tif err := printer.Fprint(&buffer, fileSet, node); err != nil {\n625|\t\treturn \"\"\n626|\t}\n627|\treturn buffer.String()\n628|}\n629|\n630|// TestInlineVocabularyDetectorSeesBothShapes proves the two\n631|// halves of the chain census against synthetic sources: a\n632|// named-type table resolves through the alias, a struct literal\n633|// through a named type does not, an inline chain in either\n634|// boolean shape flags, and a single comparison passes. The\n635|// vectors are synthetic on purpose: they prove the scanner, not\n636|// production.\n637|func TestInlineVocabularyDetectorSeesBothShapes(t *testing.T) {\n638|\tparse := func(source string) (*token.FileSet, *ast.File) {\n639|\t\tt.Helper()\n640|\t\tfileSet := token.NewFileSet()\n641|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n642|\t\tif err != nil {\n643|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n644|\t\t}\n645|\t\treturn fileSet, syntax\n646|\t}\n647|\tt.Run(\"named type table resolves\", func(t *testing.T) {\n648|\t\t_, syntax := parse(\"package probe\\ntype names []string\\nvar t = names{\\\"a\\\", \\\"b\\\"}\\n\")\n649|\t\tnamed := map[string]ast.Expr{}\n650|\t\tcollectNamedCompositeTypes(syntax, named)\n651|\t\ttables := vocabularyTablesInFile(syntax, named)\n652|\t\tif len(tables) != 1 || tables[0] != \"t\" {\n653|\t\t\tt.Fatalf(\"named-type table = %v, want [t]\", tables)\n654|\t\t}\n655|\t})\n656|\tt.Run(\"named type alias chain resolves\", func(t *testing.T) {\n657|\t\t_, syntax := parse(\"package probe\\ntype a []string\\ntype b a\\nvar t = b{\\\"a\\\"}\\n\")\n658|\t\tnamed := map[string]ast.Expr{}\n659|\t\tcollectNamedCompositeTypes(syntax, named)\n660|\t\ttables := vocabularyTablesInFile(syntax, named)\n661|\t\tif len(tables) != 1 || tables[0] != \"t\" {\n662|\t\t\tt.Fatalf(\"aliased table = %v, want [t]\", tables)\n663|\t\t}\n664|\t})\n665|\tt.Run(\"struct literal through named type is not a table\", func(t *testing.T) {\n666|\t\t_, syntax := parse(\"package probe\\ntype point struct{ x int }\\nvar p = point{1}\\n\")\n667|\t\tnamed := map[string]ast.Expr{}\n668|\t\tcollectNamedCompositeTypes(syntax, named)\n669|\t\tif tables := vocabularyTablesInFile(syntax, named); len(tables) != 0 {\n670|\t\t\tt.Fatalf(\"struct literal = %v, want no tables\", tables)\n671|\t\t}\n672|\t})\n673|\tt.Run(\"or chain of literals flags\", func(t *testing.T) {\n674|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v == \\\"a\\\" || v == \\\"b\\\" }\\n\")\n675|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n676|\t\t\tt.Fatalf(\"or chain = %v, want one unregistered vocabulary\", chains)\n677|\t\t}\n678|\t})\n679|\tt.Run(\"and chain of negations flags\", func(t *testing.T) {\n680|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v != \\\"a\\\" && v != \\\"b\\\" }\\n\")\n681|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n682|\t\t\tt.Fatalf(\"and chain = %v, want one unregistered vocabulary\", chains)\n683|\t\t}\n684|\t})\n685|\tt.Run(\"chain through constants flags\", func(t *testing.T) {\n686|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v != A && v != B }\\n\")\n687|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n688|\t\t\tt.Fatalf(\"constant chain = %v, want one unregistered vocabulary\", chains)\n689|\t\t}\n690|\t})\n691|\tt.Run(\"single comparison passes\", func(t *testing.T) {\n692|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v == \\\"a\\\" }\\n\")\n693|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 0 {\n694|\t\t\tt.Fatalf(\"single comparison = %v, want no unregistered vocabulary\", chains)\n695|\t\t}\n696|\t})\n697|\tt.Run(\"field to field equality passes\", func(t *testing.T) {\n698|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(a, b point) bool { return a.x != b.x || a.y != b.y }\\n\")\n699|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 0 {\n700|\t\t\tt.Fatalf(\"field equality = %v, want no unregistered vocabulary\", chains)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
