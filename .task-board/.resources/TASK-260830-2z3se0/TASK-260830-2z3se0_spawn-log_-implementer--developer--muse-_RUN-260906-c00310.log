{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c58b","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":288,"recorded_at":1780531400000571,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"13070fb8-ab2c-4bec-ae74-8577a6649180"},"task_id":"13070fb8-ab2c-4bec-ae74-8577a6649180","event":{"kind":"output","task_id":"13070fb8-ab2c-4bec-ae74-8577a6649180","chunk":"Read text file `internal/sessadapter/protocol.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Wire constants of pinned specification Section 7.8. The protocol\n12|// identifier and version are exact: the adapter speaks 1.0.0 in the\n13|// same trusted executable as Provider Protocol 2.0.0, and anything\n14|// else on the wire is a session_adapter_protocol_error, never a\n15|// negotiation.\n16|const (\n17|\t// ProtocolID is the exact protocol member every request and\n18|\t// response envelope carries.\n19|\tProtocolID = \"urn:ax:protocol:session-adapter\"\n20|\t// ProtocolVersion is the exact protocol_version member this host\n21|\t// writes and the only one it accepts a response under.\n22|\tProtocolVersion = \"1.0.0\"\n23|\t// ProtocolMajor is the major this host implements. Section 7.8\n24|\t// defines no multi-major negotiation for the adapter, so a\n25|\t// different major is an invalid envelope, not a downgrade.\n26|\tProtocolMajor = 1\n27|\t// ErrorVersion is the Structured Error version every failure\n28|\t// envelope carries: Session Adapter 1.0 statically binds\n29|\t// Structured Error 1.1.0.\n30|\tErrorVersion = axerror.Version110\n31|\t// MaxFrameBytes bounds one JSONL line in either direction:\n32|\t// Section 7.8 inherits Section 7.2's rule that every line is one\n33|\t// complete UTF-8 JSON object no larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|)\n36|\n37|// Operation names one Section 7.8 registry entry. The registry is\n38|// closed: dispatch refuses any other name locally, before any adapter\n39|// surface is touched.\n40|type Operation string\n41|\n42|// Section 7.8 operation registry in the section's table order. The\n43|// inventory test derives this list from the pinned specification\n44|// text and requires exact ordered equality, so a dropped, added, or\n45|// reordered entry reddens there rather than passing silently.\n46|const (\n47|\tOpManifest       Operation = \"manifest\"\n48|\tOpProbe          Operation = \"probe\"\n49|\tOpDiscover       Operation = \"discover\"\n50|\tOpInspect        Operation = \"inspect\"\n51|\tOpSnapshotProof  Operation = \"snapshot-proof\"\n52|\tOpCapturePlan    Operation = \"capture-plan\"\n53|\tOpCapture        Operation = \"capture\"\n54|\tOpNormalize      Operation = \"normalize\"\n55|\tOpProjectionPlan Operation = \"projection-plan\"\n56|\tOpProject        Operation = \"project\"\n57|\tOpReadBack       Operation = \"read-back\"\n58|\tOpValidate       Operation = \"validate\"\n59|\tOpResumePlan     Operation = \"resume-plan\"\n60|\tOpDoctor         Operation = \"doctor\"\n61|)\n62|\n63|// operationOrder is the single construction site of the dispatch\n64|// registry.\n65|var operationOrder = []Operation{\n66|\tOpManifest,\n67|\tOpProbe,\n68|\tOpDiscover,\n69|\tOpInspect,\n70|\tOpSnapshotProof,\n71|\tOpCapturePlan,\n72|\tOpCapture,\n73|\tOpNormalize,\n74|\tOpProjectionPlan,\n75|\tOpProject,\n76|\tOpReadBack,\n77|\tOpValidate,\n78|\tOpResumePlan,\n79|\tOpDoctor,\n80|}\n81|\n82|// Operations returns the dispatch registry in section order. The\n83|// result is a copy; the registry cannot be mutated through it.\n84|func Operations() []string {\n85|\tout := make([]string, 0, len(operationOrder))\n86|\tfor _, operation := range operationOrder {\n87|\t\tout = append(out, string(operation))\n88|\t}\n89|\treturn out\n90|}\n91|\n92|// validOperation reports whether the name is a registry member.\n93|func validOperation(name string) bool {\n94|\tfor _, operation := range operationOrder {\n95|\t\tif string(operation) == name {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// The refusal constructors below are declared as variables so the\n103|// inventory gate can observe every exercised refusal site. Each is\n104|// the single construction site for its failure class; production\n105|// code must not build *axerror.Error any other way.\n106|//\n107|// failInvalid reports a caller error caught before any adapter\n108|// surface is touched: a required set naming an unknown capability, a\n109|// binding the caller built from unobserved facts. failProtocol\n110|// reports an unusable adapter frame: an invalid envelope, a body\n111|// outside its closed shape, a digest mismatch, a partial,\n112|// malformed, over-limit, or escaped result. failUnknownOperation\n113|// reports a name outside the closed registry. failCapability\n114|// reports an operation the adapter does not implement.\n115|// failUnsupportedTuple reports an environment the signed registry\n116|// does not admit. failIntegrity reports a binding observation that\n117|// cannot be reconciled to trusted candidate facts: a failed or\n118|// partial read, or a before-call fact that no longer equals the\n119|// freshly read fact and the Journal binding.\n120|//\n121|// Every constructor takes the human detail first as a string literal\n122|// at the call site and the distinguishing wire fact second, so the\n123|// inventory derives one obligation per literal detail and every\n124|// witness can assert which arm fired through the code plus the\n125|// distinguishing detail, not merely that something refused.\n126|var failInvalid = func(detail string, field string) (*axerror.Error, error) {\n127|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"invalid_config\", Message: \"session adapter host refused the call: \" + detail, Details: axerror.Details{\"field\": field}})\n128|}\n129|\n130|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n131|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"session_adapter_protocol_error\", Message: \"session adapter host rejected the adapter frame: \" + detail, Details: axerror.Details{\"member\": member}})\n132|}\n133|\n134|var failUnknownOperation = func(detail string, operation string) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"operation_unknown\", Message: \"session adapter host refused an unknown operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n136|}\n137|\n138|var failCapability = func(detail string, capability string) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unavailable operation: \" + detail, Details: axerror.Details{\"capability\": capability}})\n140|}\n141|\n142|// failUnavailable reports an operation the adapter does not\n143|// implement. The operation-to-capability mapping is not stated in\n144|// Section 7.8, so the refusal names the operation rather than\n145|// inventing a capability: the detail key is operation, never a\n146|// capability the contract never defined.\n147|var failUnavailable = func(detail string, operation string) (*axerror.Error, error) {\n148|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"capability_unavailable\", Message: \"session adapter host refused an unimplemented operation: \" + detail, Details: axerror.Details{\"operation\": operation}})\n149|}\n150|\n151|var failUnsupportedTuple = func(detail string, environment string) (*axerror.Error, error) {\n152|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"unsupported_environment_tuple\", Message: \"session adapter host refused an unadmitted environment: \" + detail, Details: axerror.Details{\"environment\": environment}})\n153|}\n154|\n155|var failIntegrity = func(detail string, subject string) (*axerror.Error, error) {\n156|\treturn axerror.New(axerror.Spec{Version: ErrorVersion, Code: \"integrity_failure\", Message: \"session adapter binding observation is not trusted state: \" + detail, Details: axerror.Details{\"subject\": subject}})\n157|}\n158|\n159|// requestMembers is the exact request envelope member set Section 7.8\n160|// requires: protocol, protocol_version, request_id, operation,\n161|// deadline, and body.\n162|var requestMembers = map[string]bool{\n163|\t\"protocol\":         true,\n164|\t\"protocol_version\": true,\n165|\t\"request_id\":       true,\n166|\t\"operation\":        true,\n167|\t\"deadline\":         true,\n168|\t\"body\":             true,\n169|}\n170|\n171|// requestRequired lists requestMembers in a fixed order so an\n172|// envelope missing several members always names the same one.\n173|var requestRequired = []string{\n174|\t\"protocol\",\n175|\t\"protocol_version\",\n176|\t\"request_id\",\n177|\t\"operation\",\n178|\t\"deadline\",\n179|\t\"body\",\n180|}\n181|\n182|// successMembers is the exact success envelope member set: the four\n183|// echoed identity fields, ok=true, and body, with no error member.\n184|var successMembers = map[string]bool{\n185|\t\"protocol\":         true,\n186|\t\"protocol_version\": true,\n187|\t\"request_id\":       true,\n188|\t\"operation\":        true,\n189|\t\"ok\":               true,\n190|\t\"body\":             true,\n191|}\n192|\n193|// successRequired lists successMembers in a fixed order.\n194|var successRequired = []string{\n195|\t\"protocol\",\n196|\t\"protocol_version\",\n197|\t\"request_id\",\n198|\t\"operation\",\n199|\t\"ok\",\n200|\t\"body\",\n201|}\n202|\n203|// failureMembers is the exact failure envelope member set: the four\n204|// echoed identity fields, ok=false, and error, with no body member.\n205|var failureMembers = map[string]bool{\n206|\t\"protocol\":         true,\n207|\t\"protocol_version\": true,\n208|\t\"request_id\":       true,\n209|\t\"operation\":        true,\n210|\t\"ok\":               true,\n211|\t\"error\":            true,\n212|}\n213|\n214|// failureRequired lists failureMembers in a fixed order.\n215|var failureRequired = []string{\n216|\t\"protocol\",\n217|\t\"protocol_version\",\n218|\t\"request_id\",\n219|\t\"operation\",\n220|\t\"ok\",\n221|\t\"error\",\n222|}\n223|\n224|// Request is one Section 7.8 request envelope as the host wrote it:\n225|// the identity fields plus the canonical body bytes. Responses are\n226|// checked against it, never trusted on their own echo.\n227|type Request struct {\n228|\tOperation Operation\n229|\tRequestID string\n230|\tBody      []byte\n231|}\n232|\n233|// DecodeRequestFrame validates one outbound request frame before it\n234|// reaches the adapter surface: one complete object within the frame\n235|// bound, the exact envelope members, the exact protocol identifier\n236|// and version, a UUIDv7 request identifier, a registry operation, a\n237|// timestamp deadline, and an object body. An unknown operation is\n238|// operation_unknown; every other envelope defect is\n239|// session_adapter_protocol_error. The returned body is the raw\n240|// canonical member for the operation-layer checks.\n241|func DecodeRequestFrame(frame []byte) (Request, error) {\n242|\tif len(frame) == 0 {\n243|\t\tfailure, err := failProtocol(\"request frame is empty\", \"\")\n244|\t\tif err != nil {\n245|\t\t\treturn Request{}, err\n246|\t\t}\n247|\t\treturn Request{}, failure\n248|\t}\n249|\tif len(frame) > MaxFrameBytes {\n250|\t\tfailure, err := failProtocol(\"request frame exceeds the 8 MiB bound\", \"\")\n251|\t\tif err != nil {\n252|\t\t\treturn Request{}, err\n253|\t\t}\n254|\t\treturn Request{}, failure\n255|\t}\n256|\tmembers, fault := decodeStrictObject(frame)\n257|\tif fault != nil {\n258|\t\tfailure, err := failProtocol(\"request envelope \"+fault.detail, fault.member)\n259|\t\tif err != nil {\n260|\t\t\treturn Request{}, err\n261|\t\t}\n262|\t\treturn Request{}, failure\n263|\t}\n264|\tif name, unknown := unknownMember(members, requestMembers); unknown {\n265|\t\tfailure, err := failProtocol(\"request envelope carries unknown member\", name)\n266|\t\tif err != nil {\n267|\t\t\treturn Request{}, err\n268|\t\t}\n269|\t\treturn Request{}, failure\n270|\t}\n271|\tif name, missing := missingMember(members, requestRequired); missing {\n272|\t\tfailure, err := failProtocol(\"request envelope misses a required member\", name)\n273|\t\tif err != nil {\n274|\t\t\treturn Request{}, err\n275|\t\t}\n276|\t\treturn Request{}, failure\n277|\t}\n278|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n279|\t\tfailure, err := failProtocol(\"request protocol is not the session adapter\", \"protocol\")\n280|\t\tif err != nil {\n281|\t\t\treturn Request{}, err\n282|\t\t}\n283|\t\treturn Request{}, failure\n284|\t}\n285|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n286|\t\tfailure, err := failProtocol(\"request protocol version is not 1.0.0\", \"protocol_version\")\n287|\t\tif err != nil {\n288|\t\t\treturn Request{}, err\n289|\t\t}\n290|\t\treturn Request{}, failure\n291|\t}\n292|\trequestID, ok := rawString(members[\"request_id\"])\n293|\tif !ok {\n294|\t\tfailure, err := failProtocol(\"request identifier is not a string\", \"request_id\")\n295|\t\tif err != nil {\n296|\t\t\treturn Request{}, err\n297|\t\t}\n298|\t\treturn Request{}, failure\n299|\t}\n300|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n301|\t\tfailure, err := failProtocol(\"request identifier is not a UUIDv7\", \"request_id\")\n302|\t\tif err != nil {\n303|\t\t\treturn Request{}, err\n304|\t\t}\n305|\t\treturn Request{}, failure\n306|\t}\n307|\toperation, ok := rawString(members[\"operation\"])\n308|\tif !ok {\n309|\t\tfailure, err := failProtocol(\"request operation is not a string\", \"operation\")\n310|\t\tif err != nil {\n311|\t\t\treturn Request{}, err\n312|\t\t}\n313|\t\treturn Request{}, failure\n314|\t}\n315|\tif !validOperation(operation) {\n316|\t\tfailure, err := failUnknownOperation(\"request names an operation outside the closed registry\", operation)\n317|\t\tif err != nil {\n318|\t\t\treturn Request{}, err\n319|\t\t}\n320|\t\treturn Request{}, failure\n321|\t}\n322|\tif _, ok := checkTimestamp(members[\"deadline\"]); !ok {\n323|\t\tfailure, err := failProtocol(\"request deadline is not a timestamp\", \"deadline\")\n324|\t\tif err != nil {\n325|\t\t\treturn Request{}, err\n326|\t\t}\n327|\t\treturn Request{}, failure\n328|\t}\n329|\tbody := bytesTrimSpace(members[\"body\"])\n330|\tif _, fault := decodeStrictObject(body); fault != nil {\n331|\t\tfailure, err := failProtocol(\"request body \"+fault.detail, \"body\")\n332|\t\tif err != nil {\n333|\t\t\treturn Request{}, err\n334|\t\t}\n335|\t\treturn Request{}, failure\n336|\t}\n337|\treturn Request{Operation: Operation(operation), RequestID: requestID, Body: body}, nil\n338|}\n339|\n340|// CheckSuccessEnvelope validates one inbound success frame against\n341|// the request that caused it: one complete object within the frame\n342|// bound, the exact success members, the four identity fields echoed\n343|// exactly, ok=true, an object body, and no error member. Body and\n344|// error are disjoint, never nullable sentinels: a frame carrying\n345|// both or neither is a protocol error. The returned body is the raw\n346|// member for the operation-layer checks.\n347|func CheckSuccessEnvelope(frame []byte, want Request) ([]byte, error) {\n348|\tif len(frame) == 0 {\n349|\t\tfailure, err := failProtocol(\"success frame is empty\", \"\")\n350|\t\tif err != nil {\n351|\t\t\treturn nil, err\n352|\t\t}\n353|\t\treturn nil, failure\n354|\t}\n355|\tif len(frame) > MaxFrameBytes {\n356|\t\tfailure, err := failProtocol(\"success frame exceeds the 8 MiB bound\", \"\")\n357|\t\tif err != nil {\n358|\t\t\treturn nil, err\n359|\t\t}\n360|\t\treturn nil, failure\n361|\t}\n362|\tmembers, fault := decodeStrictObject(frame)\n363|\tif fault != nil {\n364|\t\tfailure, err := failProtocol(\"success envelope \"+fault.detail, fault.member)\n365|\t\tif err != nil {\n366|\t\t\treturn nil, err\n367|\t\t}\n368|\t\treturn nil, failure\n369|\t}\n370|\tif name, unknown := unknownMember(members, successMembers); unknown {\n371|\t\tfailure, err := failProtocol(\"success envelope carries unknown member\", name)\n372|\t\tif err != nil {\n373|\t\t\treturn nil, err\n374|\t\t}\n375|\t\treturn nil, failure\n376|\t}\n377|\tif name, missing := missingMember(members, successRequired); missing {\n378|\t\tfailure, err := failProtocol(\"success envelope misses a required member\", name)\n379|\t\tif err != nil {\n380|\t\t\treturn nil, err\n381|\t\t}\n382|\t\treturn nil, failure\n383|\t}\n384|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n385|\t\tfailure, err := failProtocol(\"success protocol does not echo the request\", \"protocol\")\n386|\t\tif err != nil {\n387|\t\t\treturn nil, err\n388|\t\t}\n389|\t\treturn nil, failure\n390|\t}\n391|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n392|\t\tfailure, err := failProtocol(\"success protocol version does not echo the request\", \"protocol_version\")\n393|\t\tif err != nil {\n394|\t\t\treturn nil, err\n395|\t\t}\n396|\t\treturn nil, failure\n397|\t}\n398|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n399|\t\tfailure, err := failProtocol(\"success request identifier does not echo the request\", \"request_id\")\n400|\t\tif err != nil {\n401|\t\t\treturn nil, err\n402|\t\t}\n403|\t\treturn nil, failure\n404|\t}\n405|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n406|\t\tfailure, err := failProtocol(\"success operation does not echo the request\", \"operation\")\n407|\t\tif err != nil {\n408|\t\t\treturn nil, err\n409|\t\t}\n410|\t\treturn nil, failure\n411|\t}\n412|\tpositive, ok := rawBool(members[\"ok\"])\n413|\tif !ok || !positive {\n414|\t\tfailure, err := failProtocol(\"success envelope does not carry ok=true\", \"ok\")\n415|\t\tif err != nil {\n416|\t\t\treturn nil, err\n417|\t\t}\n418|\t\treturn nil, failure\n419|\t}\n420|\tbody := bytesTrimSpace(members[\"body\"])\n421|\tif _, fault := decodeStrictObject(body); fault != nil {\n422|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, \"body\")\n423|\t\tif err != nil {\n424|\t\t\treturn nil, err\n425|\t\t}\n426|\t\treturn nil, failure\n427|\t}\n428|\treturn body, nil\n429|}\n430|\n431|// CheckFailureEnvelope validates one inbound failure frame against\n432|// the request that caused it: the exact failure members, the four\n433|// identity fields echoed exactly, ok=false, a closed error object,\n434|// and no body member. The error object itself must decode as a\n435|// Structured Error under the adapter's bound version; a failure that\n436|// cannot be read is an integrity failure, never a retryable result.\n437|func CheckFailureEnvelope(frame []byte, want Request) (*axerror.Error, error) {\n438|\tif len(frame) == 0 {\n439|\t\tfailure, err := failProtocol(\"failure frame is empty\", \"\")\n440|\t\tif err != nil {\n441|\t\t\treturn nil, err\n442|\t\t}\n443|\t\treturn nil, failure\n444|\t}\n445|\tif len(frame) > MaxFrameBytes {\n446|\t\tfailure, err := failProtocol(\"failure frame exceeds the 8 MiB bound\", \"\")\n447|\t\tif err != nil {\n448|\t\t\treturn nil, err\n449|\t\t}\n450|\t\treturn nil, failure\n451|\t}\n452|\tmembers, fault := decodeStrictObject(frame)\n453|\tif fault != nil {\n454|\t\tfailure, err := failProtocol(\"failure envelope \"+fault.detail, fault.member)\n455|\t\tif err != nil {\n456|\t\t\treturn nil, err\n457|\t\t}\n458|\t\treturn nil, failure\n459|\t}\n460|\tif name, unknown := unknownMember(members, failureMembers); unknown {\n461|\t\tfailure, err := failProtocol(\"failure envelope carries unknown member\", name)\n462|\t\tif err != nil {\n463|\t\t\treturn nil, err\n464|\t\t}\n465|\t\treturn nil, failure\n466|\t}\n467|\tif name, missing := missingMember(members, failureRequired); missing {\n468|\t\tfailure, err := failProtocol(\"failure envelope misses a required member\", name)\n469|\t\tif err != nil {\n470|\t\t\treturn nil, err\n471|\t\t}\n472|\t\treturn nil, failure\n473|\t}\n474|\tif protocol, ok := rawString(members[\"protocol\"]); !ok || protocol != ProtocolID {\n475|\t\tfailure, err := failProtocol(\"failure protocol does not echo the request\", \"protocol\")\n476|\t\tif err != nil {\n477|\t\t\treturn nil, err\n478|\t\t}\n479|\t\treturn nil, failure\n480|\t}\n481|\tif version, ok := rawString(members[\"protocol_version\"]); !ok || version != ProtocolVersion {\n482|\t\tfailure, err := failProtocol(\"failure protocol version does not echo the request\", \"protocol_version\")\n483|\t\tif err != nil {\n484|\t\t\treturn nil, err\n485|\t\t}\n486|\t\treturn nil, failure\n487|\t}\n488|\tif requestID, ok := rawString(members[\"request_id\"]); !ok || requestID != want.RequestID {\n489|\t\tfailure, err := failProtocol(\"failure request identifier does not echo the request\", \"request_id\")\n490|\t\tif err != nil {\n491|\t\t\treturn nil, err\n492|\t\t}\n493|\t\treturn nil, failure\n494|\t}\n495|\tif operation, ok := rawString(members[\"operation\"]); !ok || operation != string(want.Operation) {\n496|\t\tfailure, err := failProtocol(\"failure operation does not echo the request\", \"operation\")\n497|\t\tif err != nil {\n498|\t\t\treturn nil, err\n499|\t\t}\n500|\t\treturn nil, failure\n(more lines below)"}}}
