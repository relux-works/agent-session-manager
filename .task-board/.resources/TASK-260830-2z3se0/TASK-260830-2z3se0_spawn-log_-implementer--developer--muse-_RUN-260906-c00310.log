{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c801","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":603,"recorded_at":1780531400001201,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"4a51d91f-1f4c-4fa5-8563-71bfbb811ba0"},"task_id":"4a51d91f-1f4c-4fa5-8563-71bfbb811ba0","event":{"kind":"output","task_id":"4a51d91f-1f4c-4fa5-8563-71bfbb811ba0","chunk":"Read text file `internal/sessadapter/discovery_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"testing\"\n5|\t\"time\"\n6|)\n7|\n8|func TestDiscoverBindsManifestToCandidate(t *testing.T) {\n9|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n10|\tif err != nil {\n11|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n12|\t}\n13|\tdigest := ManifestDigest(manifest).String()\n14|\tfor _, role := range []Role{RoleSource, RoleTarget} {\n15|\t\tbinding, err := Discover(role, manifest, digest, fixtureCandidate())\n16|\t\tif err != nil {\n17|\t\t\tt.Fatalf(\"Discover(%q): %v\", role, err)\n18|\t\t}\n19|\t\tif binding.Role != role || binding.ProviderID != fixtureProviderID || binding.AdapterManifestDigest != digest {\n20|\t\t\tt.Fatalf(\"binding = %+v\", binding)\n21|\t\t}\n22|\t}\n23|}\n24|\n25|func TestDiscoverRefusals(t *testing.T) {\n26|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n29|\t}\n30|\tdigest := ManifestDigest(manifest).String()\n31|\tcandidate := fixtureCandidate()\n32|\t_, err = Discover(\"sideways\", manifest, digest, candidate)\n33|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"role\", \"outside source|target\")\n34|\tforeign := candidate\n35|\tforeign.ProviderID = \"other-provider\"\n36|\t_, err = Discover(RoleSource, manifest, digest, foreign)\n37|\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"trusted candidate\")\n38|\tpathless := candidate\n39|\tpathless.ExecutablePath = \"\"\n40|\t_, err = Discover(RoleSource, manifest, digest, pathless)\n41|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"executable_path\", \"no executable path\")\n42|\townerless := candidate\n43|\townerless.OwnerIdentity = \"\"\n44|\t_, err = Discover(RoleSource, manifest, digest, ownerless)\n45|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"owner_identity\", \"no owner identity\")\n46|\tbadExe := candidate\n47|\tbadExe.ExecutableSHA256 = \"not-a-digest\"\n48|\t_, err = Discover(RoleSource, manifest, digest, badExe)\n49|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"executable_sha256\", \"not a digest\")\n50|\tbadDigest := digest\n51|\t_, err = Discover(RoleSource, manifest, \"not-a-digest\", candidate)\n52|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"session_adapter_manifest_digest\", \"not a digest\")\n53|\t_ = badDigest\n54|}\n55|\n56|// TestBindingEqualityFlipsEveryFact breaks each of the eight\n57|// identity facts alone: every flip refuses, and equal bindings\n58|// with different observation times agree. verified_at timestamps\n59|// the observation; it is not an identity fact.\n60|func TestBindingEqualityFlipsEveryFact(t *testing.T) {\n61|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n64|\t}\n65|\tsealed, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"Discover: %v\", err)\n68|\t}\n69|\tfresh := sealed\n70|\tfresh.VerifiedAt = time.Now().UTC().Format(time.RFC3339)\n71|\tsealed.VerifiedAt = \"2026-01-01T00:00:00Z\"\n72|\tif err := CheckBindingEquality(sealed, fresh); err != nil {\n73|\t\tt.Fatalf(\"CheckBindingEquality with differing timestamps: %v\", err)\n74|\t}\n75|\tflips := []func(*ExecutionBinding){\n76|\t\tfunc(binding *ExecutionBinding) { binding.Role = RoleTarget },\n77|\t\tfunc(binding *ExecutionBinding) { binding.ProviderID = \"other-provider\" },\n78|\t\tfunc(binding *ExecutionBinding) { binding.CandidateKind = CandidateExternal },\n79|\t\tfunc(binding *ExecutionBinding) { binding.ExecutablePath = \"/other/path\" },\n80|\t\tfunc(binding *ExecutionBinding) { binding.OwnerIdentity = \"other-owner\" },\n81|\t\tfunc(binding *ExecutionBinding) { binding.ExecutableSHA256 = fixtureDigest(\"other-exe\") },\n82|\t\tfunc(binding *ExecutionBinding) {\n83|\t\t\tbinding.ProviderManifestDigest = fixtureDigest(\"other-provider-manifest\")\n84|\t\t},\n85|\t\tfunc(binding *ExecutionBinding) {\n86|\t\t\tbinding.AdapterManifestDigest = fixtureDigest(\"other-adapter-manifest\")\n87|\t\t},\n88|\t}\n89|\tif len(flips) != 8 {\n90|\t\tt.Fatalf(\"flips = %d, want one per identity fact\", len(flips))\n91|\t}\n92|\tfor index, flip := range flips {\n93|\t\tmutated := sealed\n94|\t\tflip(&mutated)\n95|\t\tif err := CheckBindingEquality(sealed, mutated); err == nil {\n96|\t\t\tt.Fatalf(\"CheckBindingEquality admitted flip %d\", index)\n97|\t\t} else {\n98|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n99|\t\t}\n100|\t}\n101|}\n102|\n103|func TestCheckCallBinding(t *testing.T) {\n104|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n107|\t}\n108|\tbinding, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n109|\tif err != nil {\n110|\t\tt.Fatalf(\"Discover: %v\", err)\n111|\t}\n112|\tbody := fixtureRequestWithDigest(t, ManifestDigest(manifest).String())\n113|\tcontext, err := CheckRequestBody(OpDiscover, body)\n114|\tif err != nil {\n115|\t\tt.Fatalf(\"CheckRequestBody: %v