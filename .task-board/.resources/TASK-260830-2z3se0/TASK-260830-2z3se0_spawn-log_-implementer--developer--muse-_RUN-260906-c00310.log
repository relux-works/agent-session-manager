{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ab","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":432,"recorded_at":1780531400000859,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"0a36d304-328e-4264-8485-09d48feacc40"},"task_id":"0a36d304-328e-4264-8485-09d48feacc40","event":{"kind":"output","task_id":"0a36d304-328e-4264-8485-09d48feacc40","chunk":"Read text file `internal/sessadapter/census_test.go`.\n(699 line(s) above)\n700|\t\t\tt.Fatalf(\"field equality = %v, want no unregistered vocabulary\", chains)\n701|\t\t}\n702|\t})\n703|}\n704|\n705|// sentenceEnd scans the first sentence terminator in text after a\n706|// member-list marker: the first period outside a code span that is\n707|// not a digit-period-digit abbreviation like Section 7.5 or\n708|// Structured Error 1.1. Normative member sentences never end\n709|// mid-list any other way, so any other period ends the scan.\n710|func sentenceEnd(rest string) int {\n711|\tinCode := false\n712|\tfor offset := 0; offset < len(rest); offset++ {\n713|\t\tif strings.HasPrefix(rest[offset:], \"<code>\") {\n714|\t\t\tinCode = true\n715|\t\t\tcontinue\n716|\t\t}\n717|\t\tif strings.HasPrefix(rest[offset:], \"</code>\") {\n718|\t\t\tinCode = false\n719|\t\t\tcontinue\n720|\t\t}\n721|\t\tif rest[offset] != '.' || inCode {\n722|\t\t\tcontinue\n723|\t\t}\n724|\t\tprevious, next := byte(0), byte(0)\n725|\t\tif offset > 0 {\n726|\t\t\tprevious = rest[offset-1]\n727|\t\t}\n728|\t\tif offset+1 < len(rest) {\n729|\t\t\tnext = rest[offset+1]\n730|\t\t}\n731|\t\tif previous >= '0' && previous <= '9' && next >= '0' && next <= '9' {\n732|\t\t\tcontinue\n733|\t\t}\n734|\t\treturn offset\n735|\t}\n736|\treturn -1\n737|}\n738|\n739|// sentenceMembers collects the member names of one scanned\n740|// sentence: every code span contributes the name before its first\n741|// colon or equals sign, in document order.\n742|func sentenceMembers(t *testing.T, marker, sentence string) []string {\n743|\tt.Helper()\n744|\tvar members []string\n745|\tfor {\n746|\t\topen := strings.Index(sentence, \"<code>\")\n747|\t\tif open < 0 {\n748|\t\t\tbreak\n749|\t\t}\n750|\t\tsentence = sentence[open+len(\"<code>\"):]\n751|\t\tclose := strings.Index(sentence, \"</code>\")\n752|\t\tif close < 0 {\n753|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n754|\t\t}\n755|\t\tspan := sentence[:close]\n756|\t\tsentence = sentence[close+len(\"</code>\"):]\n757|\t\tname := span\n758|\t\tif index := strings.IndexAny(span, \":=\"); index >= 0 {\n759|\t\t\tname = span[:index]\n760|\t\t}\n761|\t\tmembers = append(members, name)\n762|\t}\n763|\tif len(members) == 0 {\n764|\t\tt.Fatalf(\"derived no members for %q; the parser is broken\", marker)\n765|\t}\n766|\treturn members\n767|}\n768|\n769|// deriveTypeMembers parses one \"<code>Type</code> contains\n770|// exactly ...\" sentence from the pinned document into its member\n771|// list in document order. A missing marker or an empty derivation\n772|// fails closed.\n773|func deriveTypeMembers(t *testing.T, text, marker string) []string {\n774|\tt.Helper()\n775|\treturn deriveTypeMembersWith(t, text, marker, \"\")\n776|}\n777|\n778|// deriveTypeMembersWith selects among repeated homonymous\n779|// sentences: the pinned document states the request envelope and\n780|// the capability value in more than one section with different\n781|// members, so the selector names a structural fragment only the\n782|// Session Adapter sentence carries. An empty selector keeps the\n783|// first occurrence. The derivation still parses the whole\n784|// selected sentence; no production value is matched.\n785|func deriveTypeMembersWith(t *testing.T, text, marker, selector string) []string {\n786|\tt.Helper()\n787|\tremaining := text\n788|\tfor {\n789|\t\tindex := strings.Index(remaining, marker)\n790|\t\tif index < 0 {\n791|\t\t\tt.Fatalf(\"spec marker %q with selector %q not found; the derivation is broken\", marker, selector)\n792|\t\t}\n793|\t\trest := remaining[index+len(marker):]\n794|\t\tend := sentenceEnd(rest)\n795|\t\tif end < 0 {\n796|\t\t\tt.Fatalf(\"spec sentence for %q never terminates\", marker)\n797|\t\t}\n798|\t\tsentence := rest[:end]\n799|\t\tif selector == \"\" || strings.Contains(sentence, selector) {\n800|\t\t\treturn sentenceMembers(t, marker, sentence)\n801|\t\t}\n802|\t\tremaining = rest\n803|\t}\n804|}\n805|\n806|// memberSetKeys returns the keys of one production member map.\n807|func memberSetKeys(set map[string]bool) []string {\n808|\tkeys := make([]string, 0, len(set))\n809|\tfor name := range set {\n810|\t\tkeys = append(keys, name)\n811|\t}\n812|\tsort.Strings(keys)\n813|\treturn keys\n814|}\n815|\n816|// TestClosedMemberSetsAreDerivedFromSpec requires every closed\n817|// body to equal its pinned definition in order: the production\n818|// Required list must match the document sequence exactly, and\n819|// the Members map must hold exactly the same names. A dropped,\n820|// added, or reordered member reddens here.\n821|func TestClosedMemberSetsAreDerivedFromSpec(t *testing.T) {\n822|\tif _, err := specdoc.Load(); err != nil {\n823|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n824|\t}\n825|\ttext := string(specdoc.Bytes())\n826|\t// selectors disambiguate the two member sentences the pinned\n827|\t// document repeats across sections with different members: the\n828|\t// request envelope (Sections 7.5-style, 7.8, and 7.9 each state\n829|\t// one) and the capability value (the Provider Probe and Session\n830|\t// Adapter Probe sentences differ). Each selector is a structural\n831|\t// fragment only the Session Adapter sentence carries.\n832|\tselectors := map[string]string{\n833|\t\t\"request envelope\": \"<code>deadline</code>, and <code>body</code>\",\n834|\t\t\"capability value\": \"<code>detail:string[0..2048]</code>\",\n835|\t}\n836|\tordered := []struct {\n837|\t\tname     string\n838|\t\tmarker   string\n839|\t\trequired []string\n840|\t\tmembers  map[string]bool\n841|\t}{\n842|\t\t{\"request envelope\", \"The request envelope contains exactly\", requestRequired, requestMembers},\n843|\t\t{\"AdapterCallContext\", \"<code>AdapterCallContext</code> contains exactly\", contextRequired, contextMembers},\n844|\t\t{\"ReadAuthority\", \"<code>ReadAuthority</code> contains exactly\", readAuthorityRequired, readAuthorityMembers},\n845|\t\t{\"ObjectAuthority\", \"<code>ObjectAuthority</code> contains exactly\", objectAuthorityRequired, objectAuthorityMembers},\n846|\t\t{\"SourceSelector\", \"<code>SourceSelector</code> contains exactly\", sourceSelectorRequired, sourceSelectorMembers},\n847|\t\t{\"AdapterFinding\", \"<code>AdapterFinding</code> contains exactly\", findingRequired, findingMembers},\n848|\t\t{\"ResourceLimits\", \"<code>ResourceLimits</code> contains exactly\", resourceLimitsRequired, resourceLimitsMembers},\n849|\t\t{\"CapturePlanItem\", \"<code>CapturePlanItem</code> contains exactly\", capturePlanItemRequired, capturePlanItemMembers},\n850|\t\t{\"Session Adapter Probe\", \"Session Adapter Probe 1.0.0 is closed and contains exactly\", probeRequired, probeMembers},\n851|\t\t{\"Environment Tuple\", \"Environment Tuple contains exactly\", tupleRequired, tupleMembers},\n852|\t\t{\"SupportedEnvironmentTupleKey\", \"<code>SupportedEnvironmentTupleKey</code> contains exactly\", tupleKeyRequired, tupleKeyMembers},\n853|\t\t{\"SupportedEnvironmentTupleEntry\", \"<code>SupportedEnvironmentTupleEntry</code> contains exactly\", tupleEntryRequired, tupleEntryMembers},\n854|\t\t{\"SupportedContractVersions\", \"<code>SupportedContractVersions</code> contains exactly\", []string{\"contract_id\", \"versions\"}, nil},\n855|\t\t{\"FixtureEvidence\", \"<code>FixtureEvidence</code> contains exactly\", fixtureEvidenceRequired, fixtureEvidenceMembers},\n856|\t\t{\"ResumeSmokeEvidence\", \"<code>ResumeSmokeEvidence</code> contains exactly\", smokeEvidenceRequired, smokeEvidenceMembers},\n857|\t\t{\"FidelityLimit\", \"<code>FidelityLimit</code> contains exactly\", fidelityLimitRequired, fidelityLimitMembers},\n858|\t\t{\"capability value\", \"Each capability value contains exactly\", capabilityValueRequired, capabilityValueMembers},\n859|\t}\n860|\tfor _, test := range ordered {\n861|\t\tt.Run(test.name, func(t *testing.T) {\n862|\t\t\tderived := deriveTypeMembersWith(t, text, test.marker, selectors[test.name])\n863|\t\t\tif strings.Join(derived, \",\") != strings.Join(test.required, \",\") {\n864|\t\t\t\tt.Errorf(\"%s required = %v, want derived %v\", test.name, test.required, derived)\n865|\t\t\t}\n866|\t\t\tif test.members != nil {\n867|\t\t\t\tderivedSet := append([]string(nil), derived...)\n868|\t\t\t\tsort.Strings(derivedSet)\n869|\t\t\t\tif strings.Join(derivedSet, \",\") != strings.Join(memberSetKeys(test.members), \",\") {\n870|\t\t\t\t\tt.Errorf(\"%s members = %v, want derived %v\", test.name, memberSetKeys(test.members), derivedSet)\n871|\t\t\t\t}\n872|\t\t\t}\n873|\t\t})\n874|\t}\n875|\t// The success and failure envelopes reuse the request's first\n876|\t// four identity fields by an explicit rule, so their\n877|\t// derivation transforms the request list rather than\n878|\t// re-parsing prose.\n879|\trequest := deriveTypeMembers(t, text, \"The request envelope contains exactly\")\n880|\tfirstFour := request[:4]\n881|\twantSuccess := append(append([]string(nil), firstFour...), \"ok\", \"body\")\n882|\tif strings.Join(wantSuccess, \",\") != strings.Join(successRequired, \",\") {\n883|\t\tt.Errorf(\"success required = %v, want %v\", successRequired, wantSuccess)\n884|\t}\n885|\twantFailure := append(append([]string(nil), firstFour...), \"ok\", \"error\")\n886|\tif strings.Join(wantFailure, \",\") != strings.Join(failureRequired, \",\") {\n887|\t\tt.Errorf(\"failure required = %v, want %v\", failureRequired, wantFailure)\n888|\t}\n889|\t// The manifest member column comes from its own table, not a\n890|\t// sentence: parse the first-column code spans in the table\n891|\t// window.\n892|\tmanifestMembers := deriveManifestTableMembers(t, text)\n893|\tif strings.Join(manifestMembers, \",\") != strings.Join(manifestRequired, \",\") {\n894|\t\tt.Errorf(\"manifest required = %v, want derived %v\", manifestRequired, manifestMembers)\n895|\t}\n896|\t// The doctor result members come from the operation table\n897|\t// like every other success body.\n898|\t_, _, successes := deriveOperationTable(t)\n899|\tdoctor, ok := successes[string(OpDoctor)]\n900|\tif !ok {\n901|\t\tt.Fatal(\"derived no doctor success body from the operation table\")\n902|\t}\n903|\tif strings.Join(doctor, \",\") != strings.Join(doctorResultRequired, \",\") {\n904|\t\tt.Errorf(\"doctor required = %v, want derived %v\", doctorResultRequired, doctor)\n905|\t}\n906|\tt.Logf(\"member-set census: %d closed bodies derived\", len(ordered)+3)\n907|}\n908|\n909|// deriveManifestTableMembers parses the Session Adapter Manifest\n910|// member column from its table window: rows starting with\n911|// \"| <code>\" contribute their first-column name in order.\n912|func deriveManifestTableMembers(t *testing.T, text string) []string {\n913|\tt.Helper()\n914|\ttable, ok := sectionTableWindow(text, \"Session Adapter Manifest 1.0.0 is closed and contains exactly:\", \"Session Adapter Probe 1.0.0 is closed and contains exactly\")\n915|\tif !ok {\n916|\t\tt.Fatal(\"manifest table window not found\")\n917|\t}\n918|\tvar members []string\n919|\tfor _, line := range strings.Split(table, \"\\n\") {\n920|\t\tif !strings.HasPrefix(line, \"| <code>\") {\n921|\t\t\tcontinue\n922|\t\t}\n923|\t\tcells := splitTableCells(line)\n924|\t\tif len(cells) < 2 {\n925|\t\t\tcontinue\n926|\t\t}\n927|\t\t// The first cell carries one member per code span: three\n928|\t\t// rows pair two members with a slash (schema /\n929|\t\t// schema_version, display_name / adapter_version,\n930|\t\t// operations / capability_names). Every span that is a\n931|\t\t// bare snake_case name is a member, in order.\n932|\t\tcell := cells[1]\n933|\t\tfor {\n934|\t\t\topen := strings.Index(cell, \"<code>\")\n935|\t\t\tif open < 0 {\n936|\t\t\t\tbreak\n937|\t\t\t}\n938|\t\t\tcell = cell[open+len(\"<code>\"):]\n939|\t\t\tclose := strings.Index(cell, \"</code>\")\n940|\t\t\tif close < 0 {\n941|\t\t\t\tt.Fatal(\"unbalanced code span in the manifest table\")\n942|\t\t\t}\n943|\t\t\tname := cell[:close]\n944|\t\t\tcell = cell[close+len(\"</code>\"):]\n945|\t\t\tsnake := len(name) > 0\n946|\t\t\tfor _, character := range name {\n947|\t\t\t\tif character != '_' && (character < 'a' || character > 'z') && (character < '0' || character > '9') {\n948|\t\t\t\t\tsnake = false\n949|\t\t\t\t\tbreak\n950|\t\t\t\t}\n951|\t\t\t}\n952|\t\t\tif snake {\n953|\t\t\t\tmembers = append(members, name)\n954|\t\t\t}\n955|\t\t}\n956|\t}\n957|\tif len(members) == 0 {\n958|\t\tt.Fatal(\"derived no manifest members; the parser is broken\")\n959|\t}\n960|\treturn members\n961|}\n962|\n963|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n964|// against its verbatim spec union as a set. Order is not\n965|// normative for these sets — sortedness governs instances, not\n966|// the listing — so both sides sort before comparing. The\n967|// operation and capability registries are order-normative and\n968|// are pinned in order instead.\n969|func TestValueVocabulariesMatchSpec(t *testing.T) {\n970|\tif _, err := specdoc.Load(); err != nil {\n971|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n972|\t}\n973|\ttext := string(specdoc.Bytes())\n974|\t// normalizeUnionPipes collapses the three pipe encodings the\n975|\t// pinned document uses inside unions: escaped pipes in the\n976|\t// operation table, raw pipes in prose, and HTML entities in\n977|\t// the manifest table.\n978|\tnormalizeUnionPipes := func(raw string) []string {\n979|\t\traw = strings.ReplaceAll(raw, \"&#124;\", \"|\")\n980|\t\traw = strings.ReplaceAll(raw, \"\\\\|\", \"|\")\n981|\t\tvar values []string\n982|\t\tfor _, value := range strings.Split(raw, \"|\") {\n983|\t\t\tif value == \"\" {\n984|\t\t\t\tcontinue\n985|\t\t\t}\n986|\t\t\tvalues = append(values, value)\n987|\t\t}\n988|\t\treturn values\n989|\t}\n990|\t// firstSpanUnion takes the union in the first code span after\n991|\t// a prose marker. A leading member-name prefix on the first\n992|\t// element is stripped: the union starts after it.\n993|\tfirstSpanUnion := func(t *testing.T, marker string) []string {\n994|\t\tt.Helper()\n995|\t\tindex := strings.Index(text, marker)\n996|\t\tif index < 0 {\n997|\t\t\tt.Fatalf(\"spec union %q not found\", marker)\n998|\t\t}\n999|\t\trest := text[index+len(marker):]\n(more lines below)"}}}
