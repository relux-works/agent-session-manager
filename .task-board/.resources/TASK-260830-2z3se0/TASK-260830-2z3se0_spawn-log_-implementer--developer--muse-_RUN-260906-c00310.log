{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c717","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":486,"recorded_at":1780531400000967,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"34ff9202-0c61-411a-8767-4f6eaebcb95a"},"task_id":"34ff9202-0c61-411a-8767-4f6eaebcb95a","event":{"kind":"output","task_id":"34ff9202-0c61-411a-8767-4f6eaebcb95a","chunk":"Read text file `internal/sessadapter/discovery.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n5|)\n6|\n7|// This file owns Session Adapter discovery. The adapter is not a\n8|// separately discovered plugin: it runs in the same trusted\n9|// ax-provider-<id> executable and under the same host-observed\n10|// executable digest as Provider Protocol 2.0.0. Discovering it\n11|// therefore means binding the adapter manifest the executable\n12|// returned to the independently observed provider candidate —\n13|// same provider identifier, same executable, same digests — and\n14|// sealing that binding so every later call and target mutation can\n15|// be checked against freshly read facts and the Journal binding.\n16|\n17|// Role names one side of a SessionAdapterExecutionBinding. The role\n18|// is call-scoped: a source binding never authorizes a target call.\n19|type Role string\n20|\n21|// The closed role vocabulary.\n22|const (\n23|\tRoleSource Role = \"source\"\n24|\tRoleTarget Role = \"target\"\n25|)\n26|\n27|// roleNames is the closed role vocabulary as a table so the census\n28|// derives it like every other closed vocabulary: Discover compares\n29|// through validRole, never through an inline comparison chain the\n30|// census cannot see. The table is built from the constants above,\n31|// so the two spellings cannot drift.\n32|var roleNames = []string{\n33|\tstring(RoleSource),\n34|\tstring(RoleTarget),\n35|}\n36|\n37|// validRole reports whether the role is one of the two closed\n38|// binding roles.\n39|func validRole(role Role) bool {\n40|\tfor _, allowed := range roleNames {\n41|\t\tif string(role) == allowed {\n42|\t\t\treturn true\n43|\t\t}\n44|\t}\n45|\treturn false\n46|}\n47|\n48|// TrustedCandidate is the independently observed provider\n49|// candidate the adapter must share: the identifier, kind,\n50|// executable path, owner identity, and digests the host observed\n51|// through provider discovery and trust, never through the adapter.\n52|type TrustedCandidate struct {\n53|\tProviderID             string\n54|\tKind                   CandidateKind\n55|\tExecutablePath         string\n56|\tOwnerIdentity          string\n57|\tExecutableSHA256       string\n58|\tProviderManifestDigest string\n59|}\n60|\n61|// ExecutionBinding is one sealed\n62|// SessionAdapterExecutionBinding: role, provider, candidate kind,\n63|// canonical executable path, owner identity, executable digest,\n64|// provider and adapter manifest digests, and the observation time.\n65|// verified_at records when the host observed these facts, not what\n66|// they are: equality compares the eight identity facts, never the\n67|// clock reading, because two reads of one unchanged candidate\n68|// legitimately carry different timestamps.\n69|type ExecutionBinding struct {\n70|\tRole                   Role\n71|\tProviderID             string\n72|\tCandidateKind          CandidateKind\n73|\tExecutablePath         string\n74|\tOwnerIdentity          string\n75|\tExecutableSHA256       string\n76|\tProviderManifestDigest string\n77|\tAdapterManifestDigest  string\n78|\tVerifiedAt             string\n79|}\n80|\n81|// Discover binds one validated adapter manifest to one trusted\n82|// candidate: the manifest's provider identifier must equal the\n83|// candidate's, and the host-computed manifest digest is sealed into\n84|// the binding alongside the candidate's executable facts. A\n85|// well-formed manifest for a different provider is an integrity\n86|// failure, not a usable adapter: agreement with the trusted\n87|// candidate is what makes the manifest this adapter's, and a\n88|// failed or partial observation never means the candidate is\n89|// absent.\n90|func Discover(role Role, manifest Manifest, manifestDigest string, candidate TrustedCandidate) (ExecutionBinding, error) {\n91|\tif !validRole(role) {\n92|\t\tfailure, err := failInvalid(\"discovery role is outside source|target\", \"role\")\n93|\t\tif err != nil {\n94|\t\t\treturn ExecutionBinding{}, err\n95|\t\t}\n96|\t\treturn ExecutionBinding{}, failure\n97|\t}\n98|\tif manifest.ProviderID != candidate.ProviderID {\n99|\t\tfailure, err := failIntegrity(\"adapter manifest provider identifier does not match the trusted candidate\", \"provider_id\")\n100|\t\tif err != nil {\n101|\t\t\treturn ExecutionBinding{}, err\n102|\t\t}\n103|\t\treturn ExecutionBinding{}, failure\n104|\t}\n105|\tif candidate.ExecutablePath == \"\" {\n106|\t\tfailure, err := failInvalid(\"discovery candidate carries no executable path\", \"executable_path\")\n107|\t\tif err != nil {\n108|\t\t\treturn ExecutionBinding{}, err\n109|\t\t}\n110|\t\treturn ExecutionBinding{}, failure\n111|\t}\n112|\tif candidate.OwnerIdentity == \"\" {\n113|\t\tfailure, err := failInvalid(\"discovery candidate carries no owner identity\", \"owner_identity\")\n114|\t\tif err != nil {\n115|\t\t\treturn ExecutionBinding{}, err\n116|\t\t}\n117|\t\treturn ExecutionBinding{}, failure\n118|\t}\n119|\tif _, ok := checkDigestString(candidate.ExecutableSHA256); !ok {\n120|\t\tfailure, err := failInvalid(\"discovery candidate executable digest is not a digest\", \"executable_sha256\")\n121|\t\tif err != nil {\n122|\t\t\treturn ExecutionBinding{}, err\n123|\t\t}\n124|\t\treturn ExecutionBinding{}, failure\n125|\t}\n126|\tif _, ok := checkDigestString(candidate.ProviderManifestDigest); !ok {\n127|\t\tfailure, err := failInvalid(\"discovery candidate provider manifest digest is not a digest\", \"provider_manifest_digest\")\n128|\t\tif err != nil {\n129|\t\t\treturn ExecutionBinding{}, err\n130|\t\t}\n131|\t\treturn ExecutionBinding{}, failure\n132|\t}\n133|\tif _, ok := checkDigestString(manifestDigest); !ok {\n134|\t\tfailure, err := failInvalid(\"discovery adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n135|\t\tif err != nil {\n136|\t\t\treturn ExecutionBinding{}, err\n137|\t\t}\n138|\t\treturn ExecutionBinding{}, failure\n139|\t}\n140|\treturn ExecutionBinding{\n141|\t\tRole:                   role,\n142|\t\tProviderID:             candidate.ProviderID,\n143|\t\tCandidateKind:          candidate.Kind,\n144|\t\tExecutablePath:         candidate.ExecutablePath,\n145|\t\tOwnerIdentity:          candidate.OwnerIdentity,\n146|\t\tExecutableSHA256:       candidate.ExecutableSHA256,\n147|\t\tProviderManifestDigest: candidate.ProviderManifestDigest,\n148|\t\tAdapterManifestDigest:  manifestDigest,\n149|\t\tVerifiedAt:             \"\",\n150|\t}, nil\n151|}\n152|\n153|// checkDigestString reports whether the value parses as a digest of\n154|// the pinned form.\n155|func checkDigestString(value string) (string, bool) {\n156|\tdigest, err := scalar.ParseDigest(value)\n157|\tif err != nil {\n158|\t\treturn \"\", false\n159|\t}\n160|\treturn digest.String(), true\n161|}\n162|\n163|// CheckBindingEquality requires the sealed binding to equal freshly\n164|// read trusted-candidate facts and the Journal binding on all\n165|// eight identity facts. Before every call and every target\n166|// mutation these facts MUST agree; a failed or partial read is an\n167|// integrity failure, and no self-claim or publisher claim\n168|// establishes trust. verified_at is compared by presence only\n169|// when both sides carry it: it timestamps the observation and two\n170|// observations of one unchanged candidate legitimately differ.\n171|func CheckBindingEquality(sealed, fresh ExecutionBinding) error {\n172|\tif sealed.Role != fresh.Role ||\n173|\t\tsealed.ProviderID != fresh.ProviderID ||\n174|\t\tsealed.CandidateKind != fresh.CandidateKind ||\n175|\t\tsealed.ExecutablePath != fresh.ExecutablePath ||\n176|\t\tsealed.OwnerIdentity != fresh.OwnerIdentity ||\n177|\t\tsealed.ExecutableSHA256 != fresh.ExecutableSHA256 ||\n178|\t\tsealed.ProviderManifestDigest != fresh.ProviderManifestDigest ||\n179|\t\tsealed.AdapterManifestDigest != fresh.AdapterManifestDigest {\n180|\t\tfailure, err := failIntegrity(\"session adapter binding no longer equals the freshly read trusted facts\", \"binding\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\treturn nil\n187|}\n188|\n189|// CheckCallBinding requires one state-bearing call's context to\n190|// match its sealed binding and its admitted tuple: the provider\n191|// identifier, both digests, and the environment must equal the\n192|// binding facts and the tuple the registry admitted, and the role\n193|// must equal the call's side. A context answering for another\n194|// provider, another executable, another manifest, or an\n195|// unadmitted tuple is refused before the adapter surface is\n196|// touched.\n197|func CheckCallBinding(binding ExecutionBinding, role Role, context CallContext, admitted Tuple) error {\n198|\tif role != binding.Role {\n199|\t\tfailure, err := failIntegrity(\"adapter call role does not match the sealed binding role\", \"role\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\tif context.ProviderID != binding.ProviderID {\n206|\t\tfailure, err := failIntegrity(\"adapter call provider identifier does not match the sealed binding\", \"provider_id\")\n207|\t\tif err != nil {\n208|\t\t\treturn err\n209|\t\t}\n210|\t\treturn failure\n211|\t}\n212|\tif context.ManifestDigest != binding.AdapterManifestDigest {\n213|\t\tfailure, err := failIntegrity(\"adapter call manifest digest does not match the sealed binding\", \"session_adapter_manifest_digest\")\n214|\t\tif err != nil {\n215|\t\t\treturn err\n216|\t\t}\n217|\t\treturn failure\n218|\t}\n219|\tif context.ExecutableSHA256 != binding.ExecutableSHA256 {\n220|\t\tfailure, err := failIntegrity(\"adapter call executable digest does not match the sealed binding\", \"executable_sha256\")\n221|\t\tif err != nil {\n222|\t\t\treturn err\n223|\t\t}\n224|\t\treturn failure\n225|\t}\n226|\tif context.Environment != admitted {\n227|\t\tfailure, err := failUnsupportedTuple(\"adapter call environment is not the admitted tuple\", context.Environment.EnvironmentID)\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\treturn nil\n234|}"}}}
