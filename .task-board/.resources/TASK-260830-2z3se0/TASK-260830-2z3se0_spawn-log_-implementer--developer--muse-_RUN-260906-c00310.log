{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83b","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":632,"recorded_at":1780531400001259,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"call_id":"call_01a07453294278f08ada3d6c654c1251","text":"Read text file `internal/sessadapter/probe_test.go`.\n(229 line(s) above)\n230|\t\t\terr := CheckProbe(test.probe, test.facts)\n231|\t\t\tif test.key == \"environment\" && (test.name == \"unrequested tuple\") {\n232|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", test.key, test.value, test.text)\n233|\t\t\t\treturn\n234|\t\t\t}\n235|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n236|\t\t})\n237|\t}\n238|}\n239|\n240|// TestZeroValueHostFactsRefuse pins the fail-closed half of the\n241|// host-fact equality gates: a caller that forgets a fact field\n242|// gets a refusal, never an admission. Each zero field with a\n243|// non-empty probe side refuses through its own arm, so a mutant\n244|// that only refuses when the expected side is non-empty\n245|// (`!= expected && expected != \"\"`) slides the arm or admits,\n246|// and reddens here.\n247|func TestZeroValueHostFactsRefuse(t *testing.T) {\n248|\tprobe, manifest := fixtureValidProbe(t)\n249|\tdigest := ManifestDigest(manifest).String()\n250|\tt.Run(\"zero expected provider\", func(t *testing.T) {\n251|\t\terr := CheckProbe(probe, ProbeHostFacts{})\n252|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"requested provider\")\n253|\t})\n254|\tt.Run(\"zero manifest environment\", func(t *testing.T) {\n255|\t\tempty := manifest\n256|\t\tempty.EnvironmentID = \"\"\n257|\t\tfacts := ProbeHostFacts{\n258|\t\t\tExpectedProviderID: fixtureProviderID,\n259|\t\t\tExpectedKind:       CandidateBuiltin,\n260|\t\t\tManifestDigest:     digest,\n261|\t\t\tManifest:           empty,\n262|\t\t}\n263|\t\terr := CheckProbe(probe, facts)\n264|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"outside the manifest environment\")\n265|\t})\n266|\tt.Run(\"zero expected candidate kind\", func(t *testing.T) {\n267|\t\terr := CheckProbeRequest(fixtureProviderID, \"\", fixtureCandidate())\n268|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n269|\t})\n270|}\n271|\n272|func TestCheckProbeRequest(t *testing.T) {\n273|\tcandidate := fixtureCandidate()\n274|\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, candidate); err != nil {\n275|\t\tt.Fatalf(\"CheckProbeRequest: %v\", err)\n276|\t}\n277|\tif err := CheckProbeRequest(\"other-provider\", CandidateBuiltin, candidate); err == nil {\n278|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign provider identifier\")\n279|\t} else {\n280|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n281|\t}\n282|\tif err := CheckProbeRequest(fixtureProviderID, CandidateExternal, candidate); err == nil {\n283|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign candidate kind\")\n284|\t} else {\n285|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n286|\t}\n287|}\n288|\n289|// TestCheckDoctorHealthyDrivesEveryRequiredCapability derives\n290|// the required set from DoctorRequiredCapabilities and breaks\n291|// every member alone: a healthy accepted result passes whole,\n292|// and weakening any single required capability refuses naming\n293|// that capability. A loop truncation (required[:1]) admits a\n294|// weakened later member and reddens here, which a one-member\n295|// probe cannot catch.\n296|func TestCheckDoctorHealthyDrivesEveryRequiredCapability(t *testing.T) {\n297|\tmanifestDigest := fixtureManifestDigestText(t)\n298|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n299|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n300|\tif err != nil {\n301|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n302|\t}\n303|\tprobe, _ := fixtureValidProbe(t)\n304|\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n305|\thealthy := mutateMember(t, good, \"healthy\", `true`)\n306|\tfor _, official := range []bool{false, true} {\n307|\t\trequired := DoctorRequiredCapabilities(DirectionTargetWrite, official)\n308|\t\tif len(required) != 4 {\n309|\t\t\tt.Fatalf(\"official=%v required = %v, want the derived four-capability set\", official, required)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
