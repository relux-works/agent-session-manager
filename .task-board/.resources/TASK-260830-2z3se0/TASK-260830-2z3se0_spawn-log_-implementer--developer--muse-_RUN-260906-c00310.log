{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdab","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":1328,"recorded_at":1780531400002651,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"ab96199a-7504-40af-ab34-d3a94da707a0"},"task_id":"ab96199a-7504-40af-ab34-d3a94da707a0","event":{"kind":"output","task_id":"ab96199a-7504-40af-ab34-d3a94da707a0","chunk":"edited\nchanged lines: lines 151-152\n--- original\n+++ updated\n@@\n-        present(\"protocol.\n-...[truncated 4471 chars]\n+        present(\"protocol.go\", \"var failQuota\")\n+        patch(\"discovery.go\",\n+              \"\\tif candidate.ExecutablePath == \\\"\\\" {\",\n+              \"\\tif candidate.ExecutablePath == \\\"planted\\\" {\\n\"\n+              \"\\t\\tfailure, err := failQuota(\\\"planted additive arm\\\", \\\"executable_path\\\")\\n\"\n+              \"\\t\\tif err != nil {\\n\"\n+              \"\\t\\t\\treturn ExecutionBinding{}, err\\n\"\n+              \"\\t\\t}\\n\"\n+              \"\\t\\treturn ExecutionBinding{}, failure\\n\"\n+              \"\\t}\\n\"\n+              \"\\tif candidate.ExecutablePath == \\\"\\\" {\")\n+        present(\"discovery.go\", \"planted additive arm\")\n+    elif name.startswith(\"M-B3b\"):\n+        patch(\"discovery.go\",\n+              \"\\tif candidate.OwnerIdentity == \\\"\\\" {\",\n+              \"\\tif candidate.OwnerIdentity == \\\"planted\\\" {\\n\"\n+              \"\\t\\treported, err := axerror.New(axerror.Spec{Version: ErrorVersion, \"\n+              \"Code: \\\"invalid_config\\\", Message: \\\"planted inline refusal\\\", \"\n+              \"Details: axerror.Details{\\\"field\\\": \\\"owner_identity\\\"}})\\n\"\n+              \"\\t\\tif err != nil {\\n\"\n+              \"\\t\\t\\treturn ExecutionBinding{}, err\\n\"\n+              \"\\t\\t}\\n\"\n+              \"\\t\\treturn ExecutionBinding{}, reported\\n\"\n+              \"\\t}\\n\"\n+              \"\\tif candidate.OwnerIdentity == \\\"\\\" {\")\n+        present(\"discovery.go\", \"planted inline refusal\")\n+    elif name.startswith(\"M-N4a\"):\n+        patch(\"discovery.go\", \"if role != binding.Role {\",\n+              \"if role != binding.Role && binding.Role != \\\"\\\" {\")\n+        present(\"discovery.go\", \"binding.Role !=\")\n+    elif name.startswith(\"M-N4b\"):\n+        patch(\"discovery.go\", \"if context.ProviderID != binding.ProviderID {\",\n+              \"if context.ProviderID != binding.ProviderID && binding.ProviderID != \\\"\\\" {\")\n+        present(\"discovery.go\", \"binding.ProviderID !=\")\n+    elif name.startswith(\"M-N4c\"):\n+        patch(\"discovery.go\", \"if context.ManifestDigest != binding.AdapterManifestDigest {\",\n+              \"if context.ManifestDigest != binding.AdapterManifestDigest && binding.AdapterManifestDigest != \\\"\\\" {\")\n+        present(\"discovery.go\", \"binding.AdapterManifestDigest !=\")\n+    elif name.startswith(\"M-N4d\"):\n+        patch(\"discovery.go\", \"if context.ExecutableSHA256 != binding.ExecutableSHA256 {\",\n+              \"if context.ExecutableSHA256 != binding.ExecutableSHA256 && binding.ExecutableSHA256 != \\\"\\\" {\")\n+        present(\"discovery.go\", \"binding.ExecutableSHA256 !=\")\n+    elif name.startswith(\"M-N4e\"):\n+        patch(\"discovery.go\", \"if context.Environment != admitted {\",\n+              \"if context.Environment != admitted && admitted != (Tuple{}) {\")\n+        present(\"discovery.go\", \"admitted != (Tuple{})\")\n+    elif name.startswith(\"M-N5a\"):\n+        patch(\"protocol.go\",\n+              \"// Operations returns the dispatch registry in section order. The\",\n+              \"// Operations returns the dispatch registry in section order. The\")\n+        # anchor above is a no-op guard; the real plant follows.\n+        path = f\"{PKG}/protocol.go\"\n+        with open(path) as handle:\n+            text = handle.read()\n+        marker = \"// Operations returns the dispatch registry\"\n+        assert text.count(marker) == 1\n+        text = text.replace(\n+            marker,\n+            \"var plantedA, plantedB = []string{\\\"planted-a\\\"}, []string{\\\"planted-b\\\"}\\n\\n\" + marker,\n+            1)\n+        with open(path, \"w\") as handle:\n+            handle.write(text)\n+        present(\"protocol.go\", \"plantedA, plantedB\")\n+    elif name.startswith(\"M-N5b\"):\n+        patch(\"discovery.go\",\n+              \"\\tif candidate.OwnerIdentity == \\\"\\\" {\",\n+              \"\\tswitch {\\n\\tcase false:\\n\\t}\\n\\tif candidate.OwnerIdentity == \\\"\\\" {\")\n+        present(\"discovery.go\", \"switch {\")\n+    else:\n+        raise AssertionError(f\"no applicator for {name}\")\n+\n+\n+def main():\n+    needed = set()\n+    for spec in MUTANTS:\n+        needed.update(spec[\"files\"])\n+    backup(sorted(needed))\n+    killed = 0\n+    survivors = []\n+    try:\n+        for spec in MUTANTS:\n+            name = spec[\"name\"]\n+            try:\n+                apply(name)\n+                vet()\n+                red = fails(spec[\"test\"])\n+            finally:\n+                restore(sorted(needed))\n+            # Sanity: the named test passes on the clean tree.\n+            clean = sh([\"go\", \"test\", \"./internal/sessadapter/\",\n+                        \"-run\", spec[\"test\"], \"-count=1\"])\n+            status = \"KILLED\" if (red and clean.returncode == 0) else \"SURVIVED\"\n+            if status == \"KILLED\":\n+                killed += 1\n+            else:\n+                survivors.append(name)\n+            print(f\"{status:8s} {name} narrows: {spec['narrows']} test: {spec['test']}\")\n+            if not red:\n+                print(\"    (mutant did not redden the named test)\")\n+            if clean.returncode != 0:\n+                print(\"    (named test also fails on the CLEAN tree — bad test)\")\n+    finally:\n+        restore(sorted(needed))\n+    print(f\"\\n{killed} killed / {len(MUTANTS)} narrowing mutants\")\n+    if survivors:\n+        print(\"SURVIVORS: \" + \"; \".join(survivors))\n+        sys.exit(1)\n+\n+\n+if __name__ == \"__main__\":\n+    main()\n"}}}
