d escape. Go's encoding/json\n88|// would otherwise replace the lone escape with U+FFFD silently, so\n89|// Section 1.6 wire bodies carrying lone surrogates would be admitted\n90|// with rewritten bytes. This is a local copy of the shared surrogate\n91|// rule because the shared implementation is unexported; the agreement\n92|// test pins it against canonicaljson.Canonicalize over a generated\n93|// escape corpus whose verdicts come from construction, not from\n94|// either implementation.\n95|func hasLoneSurrogateEscape(data []byte) bool {\n96|\tfor index := 0; index < len(data); index++ {\n97|\t\tif data[index] != '\\\\' {\n98|\t\t\tcontinue\n99|\t\t}\n100|\t\tif index+1 >= len(data) || data[index+1] != 'u' {\n101|\t\t\tcontinue\n102|\t\t}\n103|\t\tfirst, length := readUTF16Escape(data, index+2)\n104|\t\tif length < 0 {\n105|\t\t\treturn true\n106|\t\t}\n107|\t\tindex += 1 + length\n108|\t\tif first >= 0xD800 && first <= 0xDBFF {\n109|\t\t\tsecond, secondLength := readUTF16EscapeAfter(data, index+1)\n110|\t\t\tif secondLength < 0 || second < 0xDC00 || second > 0xDFFF {\n111|\t\t\t\treturn true\n112|\t\t\t}\n113|\t\t\tindex += 6\n114|\t\t\tcontinue\n115|\t\t}\n116|\t\tif first >= 0xDC00 && first <= 0xDFFF {\n117|\t\t\treturn true\n118|\t\t}\n119|\t}\n120|\treturn false\n121|}\n122|\n123|// readUTF16Escape reads four hex digits at the offset. It returns the\n124|// value and the consumed length, or a negative length when the escape\n125|// is truncated or not hexadecimal.\n126|func readUTF16Escape(data []byte, offset int) (uint16, int) {\n127|\tif offset+4 > len(data) {\n128|\t\treturn 0, -1\n129|\t}\n130|\tvar value uint16\n131|\tfor _, digit := range data[offset : offset+4] {\n132|\t\tvalue <<= 4\n133|\t\tswitch {\n134|\t\tcase digit >= '0' && digit <= '9':\n135|\t\t\tvalue |= uint16(digit - '0')\n136|\t\tcase digit >= 'a' && digit <= 'f':\n137|\t\t\tvalue |= uint16(digit-'a') + 10\n138|\t\tcase digit >= 'A' && digit <= 'F':\n139|\t\t\tvalue |= uint16(digit-'A') + 10\n140|\t\tdefault:\n141|\t\t\treturn 0, -1\n142|\t\t}\n143|\t}\n144|\treturn value, 4\n145|}\n146|\n147|// readUTF16EscapeAfter reads a second \\uXXXX escape starting exactly\n148|// at the offset. Anything else — a truncated escape, a non-escape,\n149|// or input end — is a negative length.\n150|func readUTF16EscapeAfter(data []byte, offset int) (uint16, int) {\n151|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n152|\t\treturn 0, -1\n153|\t}\n154|\treturn readUTF16Escape(data, offset+2)\n155|}\n156|\n157|// unknownMember names a member outside the closed set, if any. The\n158|// single-unknown fixtures keep the verdict deterministic: with\n159|// several unknowns the map order decides which is named, so tests\n160|// never assert a name from a multi-unknown body.\n161|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n162|\tfor name := range members {\n163|\t\tif !allowed[name] {\n164|\t\t\treturn name, true\n165|\t\t}\n166|\t}\n167|\treturn \"\", false\n168|}\n169|\n(more lines below)"}}}
