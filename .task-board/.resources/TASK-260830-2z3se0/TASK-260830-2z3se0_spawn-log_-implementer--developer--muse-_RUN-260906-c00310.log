{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73b","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":504,"recorded_at":1780531400001003,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"f3dc940b-a889-4ea7-9327-256388dd7878"},"task_id":"f3dc940b-a889-4ea7-9327-256388dd7878","event":{"kind":"output","task_id":"f3dc940b-a889-4ea7-9327-256388dd7878","chunk":"Read text file `internal/sessadapter/operations_derived_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n9|)\n10|\n11|// deriveOperationTable parses the Section 7.8 operation-body table\n12|// from the pinned document into request and success member lists\n13|// per operation, in table order. Bodies given as prose (the\n14|// manifest and probe exact objects) derive no list. An empty\n15|// derivation — no rows, or a row with no members — fails closed:\n16|// a domain that silently derives nothing is not a measurement.\n17|func deriveOperationTable(t *testing.T) (operations []string, requests map[string][]string, successes map[string][]string) {\n18|\tt.Helper()\n19|\tif _, err := specdoc.Load(); err != nil {\n20|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n21|\t}\n22|\ttext := string(specdoc.Bytes())\n23|\t// The scan is windowed to the Section 7.8 registry table: the\n24|\t// Section 7.9 probe row reuses the <code>probe</code> name with\n25|\t// a different vocabulary, so an unwindowed scan merges two\n26|\t// sections' rows into one derivation.\n27|\ttable, ok := sectionTableWindow(text, \"The exact request and success <code>body</code> registry is:\", \"Candidate objects are addressed only by their exact\")\n28|\tif !ok {\n29|\t\tt.Fatal(\"Section 7.8 registry table window not found; the scan is broken, not the registry\")\n30|\t}\n31|\trequests = map[string][]string{}\n32|\tsuccesses = map[string][]string{}\n33|\tfor _, line := range strings.Split(table, \"\\n\") {\n34|\t\tif !strings.HasPrefix(line, \"| <code>\") {\n35|\t\t\tcontinue\n36|\t\t}\n37|\t\t// Cells split on unescaped pipes only: body cells\n38|\t\t// carry \\| vocabulary alternations that never\n39|\t\t// separate columns.\n40|\t\tcells := splitTableCells(line)\n41|\t\tif len(cells) < 4 {\n42|\t\t\tcontinue\n43|\t\t}\n44|\t\tname := strings.TrimSpace(cells[1])\n45|\t\tname = strings.TrimPrefix(name, \"<code>\")\n46|\t\tname = strings.TrimSuffix(name, \"</code>\")\n47|\t\tif !validOperation(name) {\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\toperations = append(operations, name)\n51|\t\trequests[name] = parseBodyMembers(t, cells[2])\n52|\t\tif body := parseBodyMembers(t, cells[3]); body != nil {\n53|\t\t\tsuccesses[name] = body\n54|\t\t}\n55|\t}\n56|\tif len(operations) != 14 {\n57|\t\tt.Fatalf(\"derived %d operation rows, want 14; the table scan is broken, not the registry\", len(operations))\n58|\t}\n59|\tfor _, name := range operations {\n60|\t\tif len(requests[name]) == 0 && name != \"manifest\" {\n61|\t\t\tt.Fatalf(\"derived no request members for %q; the parser is broken\", name)\n62|\t\t}\n63|\t}\n64|\treturn operations, requests, successes\n65|}\n66|\n67|// parseBodyMembers extracts the member names from one table cell's\n68|// first {…} span, splitting top-level commas only: nested\n69|// closed-map parens and uint53 brackets never separate members.\n70|// A cell with no brace span (a prose body reference) yields nil.\n71|func parseBodyMembers(t *testing.T, cell string) []string {\n72|\tt.Helper()\n73|\tstart := strings.Index(cell, \"{\")\n74|\tif start < 0 {\n75|\t\treturn nil\n76|\t}\n77|\tdepth := 0\n78|\tend := -1\n79|\tfor index := start; index < len(cell); index++ {\n80|\t\tswitch cell[index] {\n81|\t\tcase '{', '[', '(':\n82|\t\t\tdepth++\n83|\t\tcase '}', ']', ')':\n84|\t\t\tdepth--\n85|\t\t\tif depth == 0 {\n86|\t\t\t\tend = index\n87|\t\t\t}\n88|\t\t}\n89|\t\tif end >= 0 {\n90|\t\t\tbreak\n91|\t\t}\n92|\t}\n93|\tif end < 0 {\n94|\t\tt.Fatalf(\"unbalanced body span in %q\", cell)\n95|\t}\n96|\tspan := strings.ReplaceAll(cell[start+1:end], \"<code>\", \"\")\n97|\tspan = strings.ReplaceAll(span, \"</code>\", \"\")\n98|\tif strings.TrimSpace(span) == \"\" {\n99|\t\treturn []string{}\n100|\t}\n101|\tvar members []string\n102|\tdepth = 0\n103|\tcurrent := \"\"\n104|\tfor index := 0; index < len(span); index++ {\n105|\t\tchar := span[index]\n106|\t\tswitch char {\n107|\t\tcase '{', '[', '(':\n108|\t\t\tdepth++\n109|\t\t\tcurrent += string(char)\n110|\t\tcase '}', ']', ')':\n111|\t\t\tdepth--\n112|\t\t\tcurrent += string(char)\n113|\t\tcase ',':\n114|\t\t\tif depth == 0 {\n115|\t\t\t\tmembers = append(members, memberName(strings.TrimSpace(current)))\n116|\t\t\t\tcurrent = \"\"\n117|\t\t\t} else {\n118|\t\t\t\tcurrent += string(char)\n119|\t\t\t}\n120|\t\tdefault:\n121|\t\t\tcurrent += string(char)\n122|\t\t}\n123|\t}\n124|\tmembers = append(members, memberName(strings.TrimSpace(current)))\n125|\treturn members\n126|}\n127|\n128|// sectionTableWindow returns the document text between the marker\n129|// line and the terminator line. Both must be present exactly once;\n130|// otherwise the window is untrusted and the derivation fails\n131|// closed.\n132|func sectionTableWindow(text, marker, terminator string) (string, bool) {\n133|\tif strings.Count(text, marker) != 1 || strings.Count(text, terminator) != 1 {\n134|\t\treturn \"\", false\n135|\t}\n136|\tstart := strings.Index(text, marker)\n137|\tend := strings.Index(text, terminator)\n138|\tif start >= end {\n139|\t\treturn \"\", false\n140|\t}\n141|\treturn text[start:end], true\n142|}\n143|\n144|// splitTableCells splits a markdown table row on pipes that are\n145|// not backslash-escaped.\n146|func splitTableCells(line string) []string {\n147|\tvar cells []string\n148|\tcurrent := \"\"\n149|\tfor index := 0; index < len(line); index++ {\n150|\t\tif line[index] == '|' && (index == 0 || line[index-1] != '\\\\') {\n151|\t\t\tcells = append(cells, current)\n152|\t\t\tcurrent = \"\"\n153|\t\t\tcontinue\n154|\t\t}\n155|\t\tcurrent += string(line[index])\n156|\t}\n157|\treturn append(cells, current)\n158|}\n159|\n160|// memberName returns the member before the first colon, or the\n161|// whole token for bare members like extensions.\n162|func memberName(cell string) string {\n163|\tif index := strings.Index(cell, \":\"); index >= 0 {\n164|\t\treturn cell[:index]\n165|\t}\n166|\treturn cell\n167|}\n168|\n169|// TestOperationBodiesAreDerivedFromSpec requires the production\n170|// member tables to equal the Section 7.8 table in order: every\n171|// table member appears in production at the same position, and\n172|// nothing else does. A dropped, added, or reordered member\n173|// reddens here.\n174|func TestOperationBodiesAreDerivedFromSpec(t *testing.T) {\n175|\toperations, requests, successes := deriveOperationTable(t)\n176|\tfor _, name := range operations {\n177|\t\toperation := Operation(name)\n178|\t\twantRequest := requests[name]\n179|\t\tgotRequest := requestBodyMembers[operation]\n180|\t\tif fmt.Sprintf(\"%v\", gotRequest) != fmt.Sprintf(\"%v\", wantRequest) {\n181|\t\t\tt.Errorf(\"request %q = %v, want table %v\", name, gotRequest, wantRequest)\n182|\t\t}\n183|\t\twantSuccess, derived := successes[name]\n184|\t\t// Manifest, probe, and doctor successes decode through\n185|\t\t// dedicated decoders; their member tables live with\n186|\t\t// those decoders, not in the shared success table.\n187|\t\tdedicated := map[Operation][]string{\n188|\t\t\tOpManifest: manifestRequired,\n189|\t\t\tOpProbe:    probeRequired,\n190|\t\t\tOpDoctor:   doctorResultRequired,\n191|\t\t}\n192|\t\tgotSuccess := successBodyMembers[operation]\n193|\t\tif !derived {\n194|\t\t\tif dedicated[operation] == nil {\n195|\t\t\t\tt.Errorf(\"success %q derives no table body and names no dedicated decoder\", name)\n196|\t\t\t}\n197|\t\t\tcontinue\n198|\t\t}\n199|\t\tif dedicated[operation] != nil {\n200|\t\t\tgotSuccess = dedicated[operation]\n201|\t\t}\n202|\t\tif fmt.Sprintf(\"%v\", gotSuccess) != fmt.Sprintf(\"%v\", wantSuccess) {\n203|\t\t\tt.Errorf(\"success %q = %v, want table %v\", name, gotSuccess, wantSuccess)\n204|\t\t}\n205|\t}\n206|\tt.Logf(\"operation body coverage: %d operations derived\", len(operations))\n207|}\n208|\n209|// TestOperationBodiesRefuseDerivedMutations drops every derived\n210|// request member in turn from a fresh positive fixture: each\n211|// derivative must refuse. The probe points come from the pinned\n212|// document, the verdicts from production, so a production table\n213|// that silently drops a member reddens here on the missing\n214|// derivative it no longer refuses.\n215|func TestOperationBodiesRefuseDerivedMutations(t *testing.T) {\n216|\tmanifestDigest := fixtureManifestDigestText(t)\n217|\toperations, requests, _ := deriveOperationTable(t)\n218|\tfor _, name := range operations {\n219|\t\toperation := Operation(name)\n220|\t\tfixture := fixtureRequestBody(t, operation, manifestDigest)\n221|\t\tfor _, member := range requests[name] {\n222|\t\t\tt.Run(name+\"/missing \"+member, func(t *testing.T) {\n223|\t\t\t\t_, err := CheckRequestBody(operation, dropMember(t, fixture, member))\n224|\t\t\t\tif err == nil {\n225|\t\t\t\t\tt.Fatalf(\"CheckRequestBody(%q) admitted a body without %q\", name, member)\n226|\t\t\t\t}\n227|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a required member\")\n228|\t\t\t})\n229|\t\t}\n230|\t\tt.Run(name+\"/unknown member\", func(t *testing.T) {\n231|\t\t\t_, err := CheckRequestBody(operation, appendMember(t, fixture, \"unexpected\", `true`))\n232|\t\t\tif err == nil {\n233|\t\t\t\tt.Fatalf(\"CheckRequestBody(%q) admitted an unknown member\", name)\n234|\t\t\t}\n235|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"unexpected\", \"unknown member\")\n236|\t\t})\n237|\t}\n238|}\n239|\n240|// TestSuccessBodiesRefuseDerivedMutations drops every derived\n241|// success member in turn (for the eleven table-decoded bodies):\n242|// each derivative must refuse.\n243|func TestSuccessBodiesRefuseDerivedMutations(t *testing.T) {\n244|\tmanifestDigest := fixtureManifestDigestText(t)\n245|\toperations, _, successes := deriveOperationTable(t)\n246|\tfor _, name := range operations {\n247|\t\tmembers, derived := successes[name]\n248|\t\tif !derived {\n249|\t\t\tcontinue\n250|\t\t}\n251|\t\toperation := Operation(name)\n252|\t\trequest := fixtureRequestBody(t, operation, manifestDigest)\n253|\t\tdecoded, err := CheckRequestBody(operation, request)\n254|\t\tif err != nil {\n255|\t\t\tt.Fatalf(\"CheckRequestBody(%q): %v\", name, err)\n256|\t\t}\n257|\t\tfacts := SuccessFacts{Context: decoded, ValidateMode: \"staged\", ResumeTargetID: \"target-1\", DoctorDirection: DirectionSourceRead}\n258|\t\tfixture := fixtureSuccessBody(t, operation, requestContextOf(t, request), manifestDigest)\n259|\t\tfor _, member := range members {\n260|\t\t\t// The context echo is covered by its own tests;\n261|\t\t\t// dropping it here would only re-prove that arm.\n262|\t\t\tif member == \"context\" {\n263|\t\t\t\tcontinue\n264|\t\t\t}\n265|\t\t\tt.Run(name+\"/missing \"+member, func(t *testing.T) {\n266|\t\t\t\terr := CheckSuccessBody(operation, dropMember(t, fixture, member), facts)\n267|\t\t\t\tif err == nil {\n268|\t\t\t\t\tt.Fatalf(\"CheckSuccessBody(%q) admitted a body without %q\", name, member)\n269|\t\t\t\t}\n270|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a required member\")\n271|\t\t\t})\n272|\t\t}\n273|\t}\n274|}\n275|\n276|// TestOperationBodyMismatch proves a body for one operation is not\n277|// a body for another: discover checked as inspect refuses on the\n278|// foreign member, and vice versa.\n279|func TestOperationBodyMismatch(t *testing.T) {\n280|\tmanifestDigest := fixtureManifestDigestText(t)\n281|\tdiscover := fixtureRequestBody(t, OpDiscover, manifestDigest)\n282|\tif _, err := CheckRequestBody(OpInspect, discover); err == nil {\n283|\t\tt.Fatal(\"inspect admitted a discover body\")\n284|\t} else {\n285|\t\t// Three foreign members (workspace_filter, limit,\n286|\t\t// cursor) name nondeterministically under map\n287|\t\t// order, so the cross-wired body asserts code and\n288|\t\t// rule only; the single-unknown case below pins\n289|\t\t// the member.\n290|\t\tif failureCode(t, err) != \"session_adapter_protocol_error\" {\n291|\t\t\tt.Fatalf(\"code = %v, want session_adapter_protocol_error\", err)\n292|\t\t}\n293|\t}\n294|\t// A body with exactly one foreign member names it\n295|\t// deterministically; multi-unknown bodies name\n296|\t// nondeterministically under map order (see above).\n297|\tif _, err := CheckRequestBody(OpDiscover, appendMember(t, discover, \"unexpected\", `true`)); err == nil {\n298|\t\tt.Fatal(\"discover admitted a body with one foreign member\")\n299|\t} else {\n300|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"unexpected\", \"unknown member\")\n301|\t}\n302|\tif _, err := CheckRequestBody(Operation(\"launch\"), discover); err == nil {\n303|\t\tt.Fatal(\"admitted a body for an unknown operation\")\n304|\t} else {\n305|\t\trequireRefusal(t, err, \"operation_unknown\", \"operation\", \"launch\", \"closed registry\")\n306|\t}\n307|\tif err := RefuseUnknownOperation(\"launch\"); err == nil {\n308|\t\tt.Fatal(\"RefuseUnknownOperation admitted launch\")\n309|\t} else {\n310|\t\trequireRefusal(t, err, \"operation_unknown\", \"operation\", \"launch\", \"closed registry\")\n311|\t}\n312|\tif err := RefuseUnavailableOperation(OpDiscover); err == nil {\n313|\t\tt.Fatal(\"RefuseUnavailableOperation admitted discover\")\n314|\t} else {\n315|\t\trequireRefusal(t, err, \"capability_unavailable\", \"operation\", \"discover\", \"does not implement\")\n316|\t}\n317|}"}}}
