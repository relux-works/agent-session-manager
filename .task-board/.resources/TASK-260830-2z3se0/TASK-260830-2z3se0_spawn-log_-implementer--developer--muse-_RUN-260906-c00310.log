{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbd3","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":1092,"recorded_at":1780531400002179,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"87cbdecb-3f1f-4f1e-bdd0-1c951258ddeb"},"task_id":"87cbdecb-3f1f-4f1e-bdd0-1c951258ddeb","event":{"kind":"output","task_id":"87cbdecb-3f1f-4f1e-bdd0-1c951258ddeb","chunk":"Read text file `internal/sessadapter/census_test.go`.\n(647 line(s) above)\n648|func closedValue(node ast.Expr) (string, bool) {\n649|\tliteral, ok := node.(*ast.BasicLit)\n650|\tif !ok || literal.Kind != token.STRING {\n651|\t\treturn \"\", false\n652|\t}\n653|\tif value, err := strconv.Unquote(literal.Value); err == nil {\n654|\t\treturn value, true\n655|\t}\n656|\treturn literal.Value, true\n657|}\n658|\n659|// renderExpr renders one operand to its source text for grouping:\n660|// two comparisons group only when their operands spell\n661|// identically.\n662|func renderExpr(fileSet *token.FileSet, node ast.Node) string {\n663|\tvar buffer bytes.Buffer\n664|\tif err := printer.Fprint(&buffer, fileSet, node); err != nil {\n665|\t\treturn \"\"\n666|\t}\n667|\treturn buffer.String()\n668|}\n669|\n670|// TestInlineVocabularyDetectorSeesBothShapes proves the two\n671|// halves of the chain census against synthetic sources: a\n672|// named-type table resolves through the alias, a struct literal\n673|// through a named type does not, an inline chain in either\n674|// boolean shape flags, and a single comparison passes. The\n675|// vectors are synthetic on purpose: they prove the scanner, not\n676|// production.\n677|func TestInlineVocabularyDetectorSeesBothShapes(t *testing.T) {\n678|\tparse := func(source string) (*token.FileSet, *ast.File) {\n679|\t\tt.Helper()\n680|\t\tfileSet := token.NewFileSet()\n681|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n682|\t\tif err != nil {\n683|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n684|\t\t}\n685|\t\treturn fileSet, syntax\n686|\t}\n687|\tt.Run(\"named type table resolves\", func(t *testing.T) {\n688|\t\t_, syntax := parse(\"package probe\\ntype names []string\\nvar t = names{\\\"a\\\", \\\"b\\\"}\\n\")\n689|\t\tnamed := map[string]ast.Expr{}\n690|\t\tcollectNamedCompositeTypes(syntax, named)\n691|\t\ttables := vocabularyTablesInFile(syntax, named)\n692|\t\tif len(tables) != 1 || tables[0] != \"t\" {\n693|\t\t\tt.Fatalf(\"named-type table = %v, want [t]\", tables)\n694|\t\t}\n695|\t})\n696|\tt.Run(\"named type alias chain resolves\", func(t *testing.T) {\n697|\t\t_, syntax := parse(\"package probe\\ntype a []string\\ntype b a\\nvar t = b{\\\"a\\\"}\\n\")\n698|\t\tnamed := map[string]ast.Expr{}\n699|\t\tcollectNamedCompositeTypes(syntax, named)\n700|\t\ttables := vocabularyTablesInFile(syntax, named)\n701|\t\tif len(tables) != 1 || tables[0] != \"t\" {\n702|\t\t\tt.Fatalf(\"aliased table = %v, want [t]\", tables)\n703|\t\t}\n704|\t})\n705|\tt.Run(\"struct literal through named type is not a table\", func(t *testing.T) {\n706|\t\t_, syntax := parse(\"package probe\\ntype point struct{ x int }\\nvar p = point{1}\\n\")\n707|\t\tnamed := map[string]ast.Expr{}\n708|\t\tcollectNamedCompositeTypes(syntax, named)\n709|\t\tif tables := vocabularyTablesInFile(syntax, named); len(tables) != 0 {\n710|\t\t\tt.Fatalf(\"struct literal = %v, want no tables\", tables)\n711|\t\t}\n712|\t})\n713|\tt.Run(\"or chain of literals flags\", func(t *testing.T) {\n714|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v == \\\"a\\\" || v == \\\"b\\\" }\\n\")\n715|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n716|\t\t\tt.Fatalf(\"or chain = %v, want one unregistered vocabulary\", chains)\n717|\t\t}\n718|\t})\n719|\tt.Run(\"and chain of negations flags\", func(t *testing.T) {\n720|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v != \\\"a\\\" && v != \\\"b\\\" }\\n\")\n721|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n722|\t\t\tt.Fatalf(\"and chain = %v, want one unregistered vocabulary\", chains)\n723|\t\t}\n724|\t})\n725|\tt.Run(\"chain through constants flags\", func(t *testing.T) {\n726|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v != A && v != B }\\n\")\n727|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n728|\t\t\tt.Fatalf(\"constant chain = %v, want one unregistered vocabulary\", chains)\n729|\t\t}\n730|\t})\n731|\tt.Run(\"single comparison passes\", func(t *testing.T) {\n732|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v == \\\"a\\\" }\\n\")\n733|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 0 {\n734|\t\t\tt.Fatalf(\"single comparison = %v, want no unregistered vocabulary\", chains)\n735|\t\t}\n736|\t})\n737|\tt.Run(\"field to field equality passes\", func(t *testing.T) {\n738|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(a, b point) bool { return a.x != b.x || a.y != b.y }\\n\")\n739|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 0 {\n740|\t\t\tt.Fatalf(\"field equality = %v, want no unregistered vocabulary\", chains)\n741|\t\t}\n742|\t})\n743|}\n744|\n745|// sentenceEnd scans the first sentence terminator in text after a\n746|// member-list marker: the first period outside a code span that is\n747|// not a digit-period-digit abbreviation like Section 7.5 or\n(more lines below)"}}}
