{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51f","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":234,"recorded_at":1780531400000463,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"fc53f012-b85c-4e09-80f1-8f36ce31035d"},"task_id":"fc53f012-b85c-4e09-80f1-8f36ce31035d","event":{"kind":"output","task_id":"fc53f012-b85c-4e09-80f1-8f36ce31035d","chunk":"Read text file `internal/sessadapter/operations.go`.\n(999 line(s) above)\n1000|\n1001|// checkDiscoverSources validates the discover sources array:\n1002|// 0..65536 present objects. Content owned by Section 13.14\n1003|// (CloneSourceSummary) validates for presence only.\n1004|func checkDiscoverSources(raw json.RawMessage) ([]json.RawMessage, error) {\n1005|\telements, ok := decodeArray(bytesTrimSpace(raw))\n1006|\tif !ok {\n1007|\t\tfailure, err := failProtocol(\"discover sources are not an array\", \"sources\")\n1008|\t\tif err != nil {\n1009|\t\t\treturn nil, err\n1010|\t\t}\n1011|\t\treturn nil, failure\n1012|\t}\n1013|\tif uint64(len(elements)) > 65536 {\n1014|\t\tfailure, err := failProtocol(\"discover sources exceed 65536 entries\", \"sources\")\n1015|\t\tif err != nil {\n1016|\t\t\treturn nil, err\n1017|\t\t}\n1018|\t\treturn nil, failure\n1019|\t}\n1020|\tfor _, element := range elements {\n1021|\t\tif _, fault := decodeStrictObject(bytesTrimSpace(element)); fault != nil {\n1022|\t\t\tfailure, err := failProtocol(\"discover source entry \"+fault.detail, \"sources\")\n1023|\t\t\tif err != nil {\n1024|\t\t\t\treturn nil, err\n1025|\t\t\t}\n1026|\t\t\treturn nil, failure\n1027|\t\t}\n1028|\t}\n1029|\treturn elements, nil\n1030|}\n1031|\n1032|// checkExcludedClasses validates the sorted unique capture-class\n1033|// array in the [0..9] count bound.\n1034|func checkExcludedClasses(raw json.RawMessage) error {\n1035|\telements, ok := decodeArray(bytesTrimSpace(raw))\n1036|\tif !ok {\n1037|\t\tfailure, err := failProtocol(\"capture excluded classes are not an array\", \"excluded_classes\")\n1038|\t\tif err != nil {\n1039|\t\t\treturn err\n1040|\t\t}\n1041|\t\treturn failure\n1042|\t}\n1043|\tif uint64(len(elements)) > 9 {\n1044|\t\tfailure, err := failProtocol(\"capture excluded classes exceed 9 entries\", \"excluded_classes\")\n1045|\t\tif err != nil {\n1046|\t\t\treturn err\n1047|\t\t}\n1048|\t\treturn failure\n1049|\t}\n1050|\tprevious := \"\"\n1051|\tfor _, element := range elements {\n1052|\t\tclass, ok := rawString(element)\n1053|\t\tif !ok || !validCaptureClass(class) {\n1054|\t\t\tfailure, err := failProtocol(\"capture excluded class is outside the nine-class vocabulary\", \"excluded_classes\")\n1055|\t\t\tif err != nil {\n1056|\t\t\t\treturn err\n1057|\t\t\t}\n1058|\t\t\treturn failure\n1059|\t\t}\n1060|\t\tif previous >= class && previous != \"\" {\n1061|\t\t\tfailure, err := failProtocol(\"capture excluded classes are not sorted unique\", \"excluded_classes\")\n1062|\t\t\tif err != nil {\n1063|\t\t\t\treturn err\n1064|\t\t\t}\n1065|\t\t\treturn failure\n1066|\t\t}\n1067|\t\tprevious = class\n1068|\t}\n1069|\treturn nil\n1070|}\n1071|\n1072|// checkValidateResult validates one validate success body: the\n1073|// mode echoes the request mode, the target nullability follows the\n1074|// mode, and valid=true requires every applicable check true with\n1075|// no error finding. A null applicable check is not applicable and\n1076|// is skipped; a false one fails the conjunction.\n1077|func checkValidateResult(members map[string]json.RawMessage, facts SuccessFacts) error {\n1078|\tmode, ok := rawString(members[\"mode\"])\n1079|\tif !ok || !validValidateMode(mode) {\n1080|\t\tfailure, err := failProtocol(\"validate result mode is outside staged|live|archive\", \"mode\")\n1081|\t\tif err != nil {\n1082|\t\t\treturn err\n1083|\t\t}\n1084|\t\treturn failure\n1085|\t}\n1086|\tif mode != facts.ValidateMode {\n1087|\t\tfailure, err := failProtocol(\"validate result mode does not echo the request mode\", \"mode\")\n1088|\t\tif err != nil {\n1089|\t\t\treturn err\n1090|\t\t}\n1091|\t\treturn failure\n1092|\t}\n1093|\tif err := checkValidateNullability(members); err != nil {\n1094|\t\treturn err\n1095|\t}\n1096|\tstructural, err := requireBool(members, \"structural_valid\")\n1097|\tif err != nil {\n1098|\t\treturn err\n1099|\t}\n1100|\tsemantic, err := requireBool(members, \"semantic_marker_valid\")\n1101|\tif err != nil {\n1102|\t\treturn err\n1103|\t}\n1104|\tfor _, name := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n1105|\t\tif err := requireNullableBool(members, name); err != nil {\n1106|\t\t\treturn err\n1107|\t\t}\n1108|\t}\n1109|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n1110|\tif err != nil {\n1111|\t\treturn err\n1112|\t}\n1113|\tif err := requireDigest(members, \"evidence_digest\"); err != nil {\n1114|\t\treturn err\n1115|\t}\n1116|\tvalid, err := requireBool(members, \"valid\")\n1117|\tif err != nil {\n1118|\t\treturn err\n1119|\t}\n1120|\tif !valid {\n1121|\t\treturn nil\n1122|\t}\n1123|\tif !structural || !semantic {\n1124|\t\tfailure, err := failProtocol(\"validate reports valid with a failed structural or semantic check\", \"valid\")\n1125|\t\tif err != nil {\n1126|\t\t\treturn err\n1127|\t\t}\n1128|\t\treturn failure\n1129|\t}\n1130|\tfor _, name := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n1131|\t\tif !isNull(members[name]) {\n1132|\t\t\tapplicable, _ := rawBool(members[name])\n1133|\t\t\tif !applicable {\n1134|\t\t\t\tfailure, err := failProtocol(\"validate reports valid with a failed applicable check\", name)\n1135|\t\t\t\tif err != nil {\n1136|\t\t\t\t\treturn err\n1137|\t\t\t\t}\n1138|\t\t\t\treturn failure\n1139|\t\t\t}\n1140|\t\t}\n1141|\t}\n1142|\tfor _, finding := range findings {\n1143|\t\tif finding.Severity == \"error\" {\n1144|\t\t\tfailure, err := failProtocol(\"validate reports valid with an error finding\", \"findings\")\n1145|\t\t\tif err != nil {\n1146|\t\t\t\treturn err\n1147|\t\t\t}\n1148|\t\t\treturn failure\n1149|\t\t}\n1150|\t}\n1151|\treturn nil\n1152|}"}}}
