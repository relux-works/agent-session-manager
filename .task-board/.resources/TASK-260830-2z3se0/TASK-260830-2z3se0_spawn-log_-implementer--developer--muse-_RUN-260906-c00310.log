{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cadb","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":968,"recorded_at":1780531400001931,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"call_id":"call_01a07455bf9276c1a939ee7fef69ab3d","text":"Read text file `internal/sessadapter/probe.go`.\n(479 line(s) above)\n480|\n481|// CheckTargetWriteGates enforces the Section 7.8 target-write\n482|// conjunction: available canonical-write or official-import,\n483|// native-read-back, native-resume-plan, and workspace-binding on\n484|// the adapter side, plus provider portable-store and native-resume\n485|// on the provider side. Exact execution bindings, accepted\n486|// non-revoked tuple entries, and current fixture plus bounded\n487|// resume-smoke evidence are the caller's adjacent gates\n488|// (CheckBinding, CheckTupleAdmission, CheckDoctorResult): this\n489|// gate decides the capability conjunction only. --force,\n490|// experimental profiles, and environment-name-only matches cannot\n491|// bypass these gates: the function takes no bypass parameter, so a\n492|// caller cannot express one. Unknown sources may be archived only\n493|// after safe byte enumeration; unknown targets never write —\n494|// which this gate enforces by refusing every capability it cannot\n495|// see as available and enabled.\n496|func CheckTargetWriteGates(adapter map[string]Capability, provider map[string]ProviderCapability) error {\n497|\tif !capabilityMapUsable(adapter, \"canonical_write\") && !capabilityMapUsable(adapter, \"official_import\") {\n498|\t\tfailure, err := failCapability(\"target write has neither usable canonical-write nor official-import\", \"canonical_write|official_import\")\n499|\t\tif err != nil {\n500|\t\t\treturn err\n501|\t\t}\n502|\t\treturn failure\n503|\t}\n504|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n505|\t\tif !capabilityMapUsable(adapter, name) {\n506|\t\t\tfailure, err := failCapability(\"target write misses a usable adapter capability\", name)\n507|\t\t\tif err != nil {\n508|\t\t\t\treturn err\n509|\t\t\t}\n510|\t\t\treturn failure\n511|\t\t}\n512|\t}\n513|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n514|\t\tvalue, present := provider[name]\n515|\t\tif !present || value.Status != \"available\" || !value.Enabled {\n516|\t\t\tfailure, err := failCapability(\"target write misses a usable provider capability\", \"provider:\"+name)\n517|\t\t\tif err != nil {\n518|\t\t\t\treturn err\n519|\t\t\t}\n520|\t\t\treturn failure\n521|\t\t}\n522|\t}\n523|\treturn nil\n524|}\n525|\n526|// capabilityMapUsable reports whether the named adapter capability\n527|// is usable. An absent name is not usable: the map must be the\n528|// decoded probe map, which always carries all fifteen.\n529|func capabilityMapUsable(adapter map[string]Capability, name string) bool {\n530|\tvalue, present := adapter[name]\n531|\tif !present {\n532|\t\treturn false\n533|\t}\n534|\treturn value.Status == \"available\" && value.Enabled\n535|}\n536|\n537|// doctorResultMembers is the exact doctor success-body member set.\n538|var doctorResultMembers = map[string]bool{\n539|\t\"context\":               true,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
