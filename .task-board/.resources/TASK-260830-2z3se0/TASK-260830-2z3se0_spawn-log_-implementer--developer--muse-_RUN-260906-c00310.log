rs, \"projected_object_manifest_id\"); err != nil {\n480|\t\t\treturn err\n481|\t\t}\n482|\t\tif err := requireNullableDigest(members, \"read_back_evidence_manifest_id\"); err != nil {\n483|\t\t\treturn err\n484|\t\t}\n485|\t\tif !isNull(members[\"expected_target_native_session_id\"]) {\n486|\t\t\tif err := requireStringBounds(members, \"expected_target_native_session_id\", 1, 512); err != nil {\n487|\t\t\t\treturn err\n488|\t\t\t}\n489|\t\t}\n490|\t\tif err := checkValidateNullability(members); err != nil {\n491|\t\t\treturn err\n492|\t\t}\n493|\tcase OpResumePlan:\n494|\t\tif _, err := DecodeReadAuthority(members[\"authority\"]); err != nil {\n495|\t\t\treturn err\n496|\t\t}\n497|\t\tif err := requireStringBounds(members, \"expected_target_native_session_id\", 1, 512); err != nil {\n498|\t\t\treturn err\n499|\t\t}\n500|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n501|\t\t\treturn err\n502|\t\t}\n503|\t\tif err := requireNullableDigest(members, \"target_checkpoint_id\"); err != nil {\n504|\t\t\treturn err\n505|\t\t}\n506|\tcase OpDoctor:\n507|\t\tif direction, ok := rawString(members[\"direction\"]); !ok || !validDirection(direction) {\n508|\t\t\tfailure, err := failProtocol(\"doctor request direction is outside source_read|target_write\", \"direction\")\n509|\t\t\tif err != nil {\n510|\t\t\t\treturn err\n511|\t\t\t}\n512|\t\t\treturn failure\n513|\t\t}\n514|\t\tif err := requireDigest(members, \"tuple_registry_digest\"); err != nil {\n515|\t\t\treturn err\n516|\t\t}\n517|\t\tif _, err := requireBool(members, \"refresh_requested\"); err != nil {\n518|\t\t\treturn err\n519|\t\t}\n520|\t}\n521|\tif !checkExtensions(members[\"extensions\"]) {\n522|\t\tfailure, err := failProtocol(\"request body extensions are not reverse-DNS keyed\", \"extensions\")\n523|\t\tif err != nil {\n524|\t\t\treturn err\n525|\t\t}\n526|\t\treturn failure\n527|\t}\n528|\treturn nil\n529|}\n530|\n531|// fidelityProfiles is the four-profile vocabulary Section 7.8\n532|// states. archive_only is a strategy, never a profile. Membership\n533|// is a table loop so the census derives it like every other\n534|// closed vocabulary.\n535|var fidelityProfiles = []string{\n536|\t\"strict_exact\",\n537|\t\"maximal_safe\",\n538|\t\"compact\",\n539|\t\"messages_only\",\n540|}\n541|\n542|// validFidelityProfile reports whether the profile is one of the\n543|// four Section 7.8 fidelity profiles. archive_only is a strategy,\n544|// never a profile.\n545|func validFidelityProfile(profile string) bool {\n546|\tfor _, allowed := range fidelityProfiles {\n547|\t\tif profile == allowed {\n548|\t\t\treturn true\n549|\t\t}\n550|\t}\n551|\treturn false\n552|}\n553|\n554|// validateModes is the three-mode validate vocabulary.\n555|var validateModes = []string{\"staged\", \"live\", \"archive\"}\n556|\n557|// validValidateMode reports whether the mode is one of the three\n558|// validate modes.\n559|func validValidateMode(mode string) bool {\n560|\tfor _, allowed := range validateModes {\n561|\t\tif mode == allowed {\n562|\t\t\treturn true\n563|\t\t}\n564|\t}\n565|\treturn false\n566|}\n567|\n568|// checkRequiredDispositions validates the closed\n569|// required_dispositions map: an object whose every value is 1..7\n570|// sorted unique dispositions from the seven-vocabulary with\n571|// archive_only forbidden. The key vocabulary\n572|// (event-or-artifact-class) has no enumerable list in v0.5.0 —\n573|// the term occurs only in this table row — so keys validate as\n574|// present strings and the key closure is a stated bound.\n575|func checkRequiredDispositions(raw json.RawMessage) error {\n576|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n577|\tif fault != nil {\n578|\t\tfailure, err := failProtocol(\"projection required dispositions \"+fault.detail, \"required_dispositions\")\n579|\t\tif err != nil {\n580|\t\t\treturn err\n581|\t\t}\n582|\t\treturn failure\n583|\t}\n584|\tif len(members) == 0 {\n585|\t\tfailure, err := failProtocol(\"projection required dispositions carry no class\", \"required_dispositions\")\n586|\t\tif err != nil {\n587|\t\t\treturn err\n588|\t\t}\n589|\t\treturn failure\n590|\t}\n591|\tfor class, value := range members {\n592|\t\telements, ok := decodeArray(bytesTrimSpace(value))\n593|\t\tif !ok || len(elements) == 0 || len(elements) > 7 {\n594|\t\t\tfailure, err := failProtocol(\"projection disposition list is not 1..7 entries\", class)\n595|\t\t\tif err != nil {\n596|\t\t\t\treturn err\n597|\t\t\t}\n598|\t\t\treturn failure\n599|\t\t}\n600|\t\tprevious := \"\"\n601|\t\tfor _, element := range elements {\n602|\t\t\tdisposition, ok := rawString(element)\n603|\t\t\tif !ok || !validDisposition(disposition) {\n604|\t\t\t\tfailure, err := failProtocol(\"projection disposition is outside the seven-disposition vocabulary\", class)\n605|\t\t\t\tif err != nil {\n606|\t\t\t\t\treturn err\n607|\t\t\t\t}\n608|\t\t\t\treturn failure\n609|\t\t\t}\n610|\t\t\tif previous >= disposition && previous != \"\" {\n611|\t\t\t\tfailure, err := failProtocol(\"projection dispositions are not sorted unique\", class)\n612|\t\t\t\tif err != nil {\n613|\t\t\t\t\treturn err\n614|\t\t\t\t}\n615|\t\t\t\treturn failure\n616|\t\t\t}\n617|\t\t\tprevious = disposition\n618|\t\t}\n619|\t}\n620|\treturn nil\n621|}\n622|\n623|// checkValidateNullability enforces the validate mode rule:\n624|// archive requires all four target members null, staged and live\n625|// require them non-null. The request and the success share the rule.\n626|func checkValidateNullability(members map[string]json.RawMessage) error {\n627|\tmode, _ := rawString(members[\"mode\"])\n628|\ttargets := []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"}\n629|\tif mode == \"archive\" {\n630|\t\tfor _, name := range targets {\n631|\t\t\tif !isNull(members[name]) {\n632|\t\t\t\tfailure, err := failProtocol(\"validate archive mode carries a target member\", name)\n633|\t\t\t\tif err != nil {\n634|\t\t\t\t\treturn err\n635|\t\t\t\t}\n636|\t\t\t\treturn failure\n637|\t\t\t}\n638|\t\t}\n639|\t\treturn nil\n640|\t}\n641|\tfor _, name := range targets {\n642|\t\tif isNull(members[name]) {\n643|\t\t\tfailure, err := failProtocol(\"validate staged/live mode misses a target member\", name)\n644|\t\t\tif err != nil {\n645|\t\t\t\treturn err\n646|\t\t\t}\n647|\t\t\treturn failure\n648|\t\t}\n649|\t}\n650|\treturn nil\n651|}\n652|\n653|// SuccessFacts are the request-side facts one success body is\n654|// checked against: the sent context for the byte-for-byte echo,\n655|// the validate request mode for the mode pairing, the resume-plan\n656|// expected native identifier for the identity occurrence, and the\n657|// doctor request direction for the direction pairing. Unused\n658|// members stay zero for other operations.\n659|type SuccessFacts struct {\n660|\tContext         CallContext\n661|\tValidateMode    string\n662|\tResumeTargetID  string\n663|\tDoctorDirection Direction\n664|}\n665|\n666|// CheckSuccessBody validates one inbound success body for its\n667|// operation: the exact member set, the byte-for-byte context\n668|// echo, and the semantic gates Section 7.8 states per operation.\n669|// Manifest, probe, and doctor successes decode through their\n(more lines below)"}}}
