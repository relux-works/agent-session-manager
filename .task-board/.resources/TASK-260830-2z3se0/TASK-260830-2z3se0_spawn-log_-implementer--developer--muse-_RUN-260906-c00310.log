{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f3","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":468,"recorded_at":1780531400000931,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"18de2790-51c3-4997-ac76-72a629e5cd27"},"task_id":"18de2790-51c3-4997-ac76-72a629e5cd27","event":{"kind":"output","task_id":"18de2790-51c3-4997-ac76-72a629e5cd27","chunk":"Read text file `internal/sessadapter/inventory_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|)\n15|\n16|// This file is the derived refusal-arm inventory. It exists\n17|// because a new refusal through an existing site — a widened\n18|// member set, a new detail literal, a dropped check that slides\n19|// to a lower arm — leaves the whole suite green unless the arm\n20|// set is derived from production source by parsing it, never by\n21|// listing it.\n22|//\n23|// Derivation (deriveRefusalArms): every call to one of the seven\n24|// refusal constructors with a string-literal first argument\n25|// yields ctor|<constructor>|<detail>; a call whose first\n26|// argument is a literal prefix plus fault.detail yields\n27|// ctor|<constructor>|conduit|<function>|<prefix>, so conduits in\n28|// different functions never merge; every &frameFault{...}\n29|// literal yields frame|<detail>. A constructor call with any\n30|// other first-argument shape lands as\n31|// ctor|<constructor>|expr|<function> rather than passing\n32|// silently. Constructor references outside direct-call position\n33|// fail the derivation outright: an aliased constructor hides\n34|// every arm it builds. All three alias spellings are caught —\n35|// `alias := failInvalid`, `var alias = failInvalid` at package\n36|// level, and `var alias = failInvalid` inside a function body —\n37|// because the gate exempts only the definition's own Name in its\n38|// ValueSpec, never a constructor identifier appearing as a\n39|// ValueSpec value. The constructors of this package are\n40|// themselves declared as `var failX = func...`, so their\n41|// definition Names must stay exempt while any other var-held\n42|// reference fails.\n43|// Package-level var initializers scan under their variable name,\n44|// so a refusal arm hiding in a package-level func literal is\n45|// derived, not missed.\n46|//\n47|// Both directions are checked:\n48|// TestDerivedRefusalArmsAreAllWitnessed (every derived arm\n49|// carries a witness) and TestWitnessedArmsAreAllDerived (every\n50|// witness names a derived arm, so a truncated derivation reddens\n51|// on the orphaned witnesses instead of passing vacuously).\n52|// TestEveryArmWitnessRefusesAtTheProductionEntry drives each\n53|// witness through the production entry and requires the refusal\n54|// to come from the arm under test: code, distinguishing detail,\n55|// and rule text. Empty, single-file, or unparseable derivations\n56|// fail closed: a domain that silently derives nothing is not a\n57|// measurement.\n58|//\n59|// Stated bounds: the five timestamp pairs share one\n60|// (constructor, detail) identity across their checkTimestamp and\n61|// Time halves by construction (one rule, two halves); deleting\n62|// one half is a behavioral mutant the entry-point tests must\n63|// catch, and every witness below proves both halves. Arms\n64|// sharing one identity merge to one obligation only there and\n65|// nowhere else: any other merge fails the derivation. The\n66|// open-class member gates (unknown-member and duplicate-member\n67|// refusals) range over an unbounded name class, so one witness\n68|// per arm proves the gate fires, not that every name is gated:\n69|// a mutant exempting a different name than the witnessed one is\n70|// outside what the arm inventory narrows, and is recorded here\n71|// rather than proven.\n72|\n73|// refusalArmCensusFloor is the derived arm count this test was\n74|// written against. It is a tripwire, not an enumeration: a\n75|// derivation returning fewer arms fails closed even when every\n76|// surviving arm is witnessed, which is what catches a silently\n77|// truncated scan. Raising it is routine when production gains a\n78|// refusal; lowering it requires saying why.\n79|const refusalArmCensusFloor = 323\n80|\n81|// refusalConstructors is the closed constructor set the\n82|// derivation observes. A production refusal built any other way\n83|// is invisible to the inventory and fails the alias gate.\n84|var refusalConstructors = []string{\n85|\t\"failInvalid\",\n86|\t\"failProtocol\",\n87|\t\"failUnknownOperation\",\n88|\t\"failCapability\",\n89|\t\"failUnavailable\",\n90|\t\"failUnsupportedTuple\",\n91|\t\"failIntegrity\",\n92|}\n93|\n94|func deriveRefusalArms(t *testing.T) map[string]struct{} {\n95|\tt.Helper()\n96|\tdirectory, err := os.Getwd()\n97|\tif err != nil {\n98|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n99|\t}\n100|\tarms, scanned, err := refusalArmsIn(directory)\n101|\tif err != nil {\n102|\t\tt.Fatalf(\"derive refusal arms: %v\", err)\n103|\t}\n104|\tif len(scanned) == 0 {\n105|\t\tt.Fatal(\"derived refusal arms from zero production files; the scanner is broken, not the package\")\n106|\t}\n107|\tif len(arms) == 0 {\n108|\t\tt.Fatal(\"derived zero refusal arms from the package sources; the scanner is broken, not the package\")\n109|\t}\n110|\tif len(arms) < refusalArmCensusFloor {\n111|\t\tt.Fatalf(\"derived %d refusal arms, below the %d census floor; the derivation is short, not the package\", len(arms), refusalArmCensusFloor)\n112|\t}\n113|\tt.Logf(\"refusal arm coverage domain: %d derived arms across %d production files\", len(arms), len(scanned))\n114|\treturn arms\n115|}\n116|\n117|func refusalArmsIn(directory string) (map[string]struct{}, []string, error) {\n118|\tentries, err := os.ReadDir(directory)\n119|\tif err != nil {\n120|\t\treturn nil, nil, err\n121|\t}\n122|\tarms := map[string]struct{}{}\n123|\tvar scanned []string\n124|\tconstructors := map[string]bool{}\n125|\tfor _, name := range refusalConstructors {\n126|\t\tconstructors[name] = true\n127|\t}\n128|\tfor _, entry := range entries {\n129|\t\tname := entry.Name()\n130|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n131|\t\t\tcontinue\n132|\t\t}\n133|\t\tscanned = append(scanned, name)\n134|\t\tpath := filepath.Join(directory, name)\n135|\t\tsource, err := os.ReadFile(path)\n136|\t\tif err != nil {\n137|\t\t\treturn nil, nil, err\n138|\t\t}\n139|\t\tfileSet := token.NewFileSet()\n140|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n141|\t\tif err != nil {\n142|\t\t\treturn nil, nil, err\n143|\t\t}\n144|\t\tif err := collectFileArms(fileSet, syntax, constructors, arms); err != nil {\n145|\t\t\treturn nil, nil, err\n146|\t\t}\n147|\t}\n148|\treturn arms, scanned, nil\n149|}\n150|\n151|// scopeRange is one named scope constructor calls attribute to:\n152|// a function declaration or a package-level variable holding a\n153|// func literal.\n154|type scopeRange struct {\n155|\tname       string\n156|\tstart, end token.Pos\n157|}\n158|\n159|// collectFileArms derives every arm in one production file from a\n160|// single parse, so scope containment compares positions within\n161|// one file set: constructor calls attribute to their innermost\n162|// enclosing scope by source range, frameFault literals derive\n163|// frame arms, and any constructor identifier outside call-fun\n164|// and definition position is an alias and fails the file.\n165|func collectFileArms(fileSet *token.FileSet, syntax *ast.File, constructors map[string]bool, arms map[string]struct{}) error {\n166|\tvar scopes []scopeRange\n167|\ttype pendingCall struct {\n168|\t\tname     string\n169|\t\tcall     *ast.CallExpr\n170|\t\tposition token.Pos\n171|\t}\n172|\tvar calls []pendingCall\n173|\tvar frames []*ast.CompositeLit\n174|\ttype identUse struct {\n175|\t\tidentifier *ast.Ident\n176|\t\tparent     ast.Node\n177|\t}\n178|\tvar uses []identUse\n179|\tvar stack []ast.Node\n180|\tast.Inspect(syntax, func(node ast.Node) bool {\n181|\t\tif node == nil {\n182|\t\t\tstack = stack[:len(stack)-1]\n183|\t\t\treturn true\n184|\t\t}\n185|\t\tvar parent ast.Node\n186|\t\tif len(stack) > 0 {\n187|\t\t\tparent = stack[len(stack)-1]\n188|\t\t}\n189|\t\tswitch node := node.(type) {\n190|\t\tcase *ast.FuncDecl:\n191|\t\t\tscopes = append(scopes, scopeRange{name: node.Name.Name, start: node.Pos(), end: node.End()})\n192|\t\tcase *ast.GenDecl:\n193|\t\t\tfor _, specification := range node.Specs {\n194|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n195|\t\t\t\tif !ok {\n196|\t\t\t\t\tcontinue\n197|\t\t\t\t}\n198|\t\t\t\tfor index, name := range value.Names {\n199|\t\t\t\t\tif index < len(value.Values) {\n200|\t\t\t\t\t\tif literal, ok := value.Values[index].(*ast.FuncLit); ok {\n201|\t\t\t\t\t\t\tscopes = append(scopes, scopeRange{name: \"var:\" + name.Name, start: literal.Pos(), end: literal.End()})\n202|\t\t\t\t\t\t}\n203|\t\t\t\t\t}\n204|\t\t\t\t}\n205|\t\t\t}\n206|\t\tcase *ast.Ident:\n207|\t\t\tif constructors[node.Name] {\n208|\t\t\t\tuses = append(uses, identUse{identifier: node, parent: parent})\n209|\t\t\t}\n210|\t\tcase *ast.CallExpr:\n211|\t\t\tif fun, ok := node.Fun.(*ast.Ident); ok && constructors[fun.Name] {\n212|\t\t\t\tcalls = append(calls, pendingCall{name: fun.Name, call: node, position: node.Pos()})\n213|\t\t\t}\n214|\t\tcase *ast.CompositeLit:\n215|\t\t\tif identifier, ok := node.Type.(*ast.Ident); ok && identifier.Name == \"frameFault\" {\n216|\t\t\t\tframes = append(frames, node)\n217|\t\t\t}\n218|\t\t}\n219|\t\tstack = append(stack, node)\n220|\t\treturn true\n221|\t})\n222|\tfor _, use := range uses {\n223|\t\tif call, ok := use.parent.(*ast.CallExpr); ok {\n224|\t\t\tif fun, ok := call.Fun.(*ast.Ident); ok && fun == use.identifier {\n225|\t\t\t\tcontinue\n226|\t\t\t}\n227|\t\t}\n228|\t\tif specification, ok := use.parent.(*ast.ValueSpec); ok {\n229|\t\t\tdefined := false\n230|\t\t\tfor _, name := range specification.Names {\n231|\t\t\t\tif name == use.identifier {\n232|\t\t\t\t\tdefined = true\n233|\t\t\t\t\tbreak\n234|\t\t\t\t}\n235|\t\t\t}\n236|\t\t\tif defined {\n237|\t\t\t\tcontinue\n238|\t\t\t}\n239|\t\t\treturn fmt.Errorf(\"constructor alias of %s buries every arm it builds at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n240|\t\t}\n241|\t\treturn fmt.Errorf(\"constructor alias or indirect use of %s at %s\", use.identifier.Name, fileSet.Position(use.identifier.Pos()))\n242|\t}\n243|\tenclosing := func(position token.Pos) string {\n244|\t\tbest := \"package\"\n245|\t\tvar bestStart token.Pos\n246|\t\tinitialized := false\n247|\t\tfor _, scope := range scopes {\n248|\t\t\tif scope.start <= position && position <= scope.end {\n249|\t\t\t\tif !initialized || scope.start >= bestStart {\n250|\t\t\t\t\tbest, bestStart, initialized = scope.name, scope.start, true\n251|\t\t\t\t}\n252|\t\t\t}\n253|\t\t}\n254|\t\treturn best\n255|\t}\n256|\tfor _, call := range calls {\n257|\t\tarm, err := callArm(call.name, call.call, enclosing(call.position))\n258|\t\tif err != nil {\n259|\t\t\treturn err\n260|\t\t}\n261|\t\tarms[arm] = struct{}{}\n262|\t}\n263|\tfor _, frame := range frames {\n264|\t\tdetail, err := frameDetail(frame)\n265|\t\tif err != nil {\n266|\t\t\treturn err\n267|\t\t}\n268|\t\tarms[\"frame|\"+detail] = struct{}{}\n269|\t}\n270|\treturn nil\n271|}\n272|\n273|// callArm derives one constructor arm: a string-literal first\n274|// argument is the detail; a literal-plus-fault.detail binary is a\n275|// conduit keyed by function and prefix; anything else is an\n276|// expr obligation keyed by function.\n277|func callArm(constructor string, call *ast.CallExpr, function string) (string, error) {\n278|\tif len(call.Args) == 0 {\n279|\t\treturn \"\", fmt.Errorf(\"constructor %s called with no arguments in %s\", constructor, function)\n280|\t}\n281|\tswitch first := call.Args[0].(type) {\n282|\tcase *ast.BasicLit:\n283|\t\tif first.Kind != token.STRING {\n284|\t\t\treturn \"\", fmt.Errorf(\"constructor %s first argument is not a string in %s\", constructor, function)\n285|\t\t}\n286|\t\tdetail, err := strconv.Unquote(first.Value)\n287|\t\tif err != nil {\n288|\t\t\treturn \"\", err\n289|\t\t}\n290|\t\treturn \"ctor|\" + constructor + \"|\" + detail, nil\n291|\tcase *ast.BinaryExpr:\n292|\t\tprefix, ok := first.X.(*ast.BasicLit)\n293|\t\tif !ok || prefix.Kind != token.STRING {\n294|\t\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n295|\t\t}\n296|\t\ttext, err := strconv.Unquote(prefix.Value)\n297|\t\tif err != nil {\n298|\t\t\treturn \"\", err\n299|\t\t}\n300|\t\treturn \"ctor|\" + constructor + \"|conduit|\" + function + \"|\" + text, nil\n301|\tdefault:\n302|\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n303|\t}\n304|}\n305|\n306|// frameDetail extracts the detail literal from one &frameFault\n307|// composite literal. A non-literal detail is an expr obligation,\n308|// never a silent pass.\n309|func frameDetail(frame *ast.CompositeLit) (string, error) {\n310|\tfor _, element := range frame.Elts {\n311|\t\tpair, ok := element.(*ast.KeyValueExpr)\n312|\t\tif !ok {\n313|\t\t\tcontinue\n314|\t\t}\n315|\t\tkey, ok := pair.Key.(*ast.Ident)\n316|\t\tif !ok || key.Name != \"detail\" {\n317|\t\t\tcontinue\n318|\t\t}\n319|\t\tliteral, ok := pair.Value.(*ast.BasicLit)\n320|\t\tif !ok || literal.Kind != token.STRING {\n321|\t\t\treturn \"expr\", nil\n322|\t\t}\n323|\t\treturn strconv.Unquote(literal.Value)\n324|\t}\n325|\treturn \"\", fmt.Errorf(\"frameFault literal carries no detail\")\n326|}\n327|\n328|// TestConstructorAliasSpellingsFailDerivation replays the four\n329|// alias probes against the derivation gate on synthetic sources:\n330|// a direct constructor call derives cleanly (the control), while\n331|// a package-level `var alias = ctor`, a function-local\n332|// `var alias = ctor`, and an `alias := ctor` all fail the file.\n333|// The package's own `var failX = func...` definition spelling\n334|// stays exempt: only the definition Name is excused, never a\n335|// constructor in value position.\n336|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n337|\tconstructors := map[string]bool{\"failInvalid\": true}\n338|\tderive := func(source string) error {\n339|\t\tt.Helper()\n340|\t\tfileSet := token.NewFileSet()\n341|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n342|\t\tif err != nil {\n343|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n344|\t\t}\n345|\t\treturn collectFileArms(fileSet, syntax, constructors, map[string]struct{}{})\n346|\t}\n347|\tt.Run(\"direct call derives\", func(t *testing.T) {\n348|\t\tif err := derive(\"package probe\\nfunc f() { failInvalid(\\\"planted\\\", \\\"field\\\") }\\n\"); err != nil {\n349|\t\t\tt.Fatalf(\"direct call failed the derivation: %v\", err)\n350|\t\t}\n351|\t})\n352|\tt.Run(\"definition name stays exempt\", func(t *testing.T) {\n353|\t\tif err := derive(\"package probe\\nvar failInvalid = func(detail, field string) (int, error) { return 0, nil }\\n\"); err != nil {\n354|\t\t\tt.Fatalf(\"constructor definition failed the derivation: %v\", err)\n355|\t\t}\n356|\t})\n357|\tfor _, probe := range []struct {\n358|\t\tname   string\n359|\t\tsource string\n360|\t}{\n361|\t\t{\"package level var alias\", \"package probe\\nvar plantedFail = failInvalid\\nfunc f() { plantedFail(\\\"planted\\\", \\\"field\\\") }\\n\"},\n362|\t\t{\"function local var alias\", \"package probe\\nfunc f() { var localFail = failInvalid\\n_ = localFail }\\n\"},\n363|\t\t{\"short declaration alias\", \"package probe\\nfunc f() { localFail := failInvalid\\n_ = localFail }\\n\"},\n364|\t} {\n365|\t\tt.Run(probe.name, func(t *testing.T) {\n366|\t\t\tif err := derive(probe.source); err == nil {\n367|\t\t\t\tt.Fatal(\"aliased constructor passed the derivation with every arm it builds hidden\")\n368|\t\t\t}\n369|\t\t})\n370|\t}\n371|}\n372|\n373|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction:\n374|// every arm derived from production must carry a witness. A\n375|// planted arm (a new literal or site through an existing\n376|// constructor) lands here as an unwitnessed arm.\n377|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n378|\tderived := deriveRefusalArms(t)\n379|\twitnessed := map[string]int{}\n380|\tfor _, witness := range declaredWitnesses(t) {\n381|\t\twitnessed[witness.arm]++\n382|\t}\n383|\tvar missing []string\n384|\tfor arm := range derived {\n385|\t\tif witnessed[arm] == 0 {\n386|\t\t\tmissing = append(missing, arm)\n387|\t\t}\n388|\t}\n389|\tsort.Strings(missing)\n390|\tif len(missing) > 0 {\n391|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n392|\t}\n393|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n394|}\n395|\n396|// TestWitnessedArmsAreAllDerived is the reverse direction: every\n397|// witness must name an arm production declares. A deleted or\n398|// narrowed production branch orphans its witness and fails here,\n399|// which is also what makes a truncated derivation fail instead\n400|// of passing vacuously.\n401|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n402|\tderived := deriveRefusalArms(t)\n403|\tvar orphans []string\n404|\tfor _, witness := range declaredWitnesses(t) {\n405|\t\tif _, ok := derived[witness.arm]; !ok {\n406|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n407|\t\t}\n408|\t}\n409|\tsort.Strings(orphans)\n410|\tif len(orphans) > 0 {\n411|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n412|\t}\n413|}\n414|\n415|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every\n416|// witness through its production entry point and requires the\n417|// attributed refusal.\n418|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n419|\tfor _, witness := range declaredWitnesses(t) {\n420|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n421|\t\t\twitness.prove(t)\n422|\t\t})\n423|\t}\n424|}\n425|\n426|// armWitness is one derived arm plus the test proving it refuses\n427|// at the production entry with the attributed identity.\n428|type armWitness struct {\n429|\tarm   string\n430|\tname  string\n431|\tprove func(t *testing.T)\n432|}\n433|\n434|// declaredWitnesses lists every witness. The group tables live\n435|// in inventory_witnesses_test.go.\n436|func declaredWitnesses(t *testing.T) []armWitness {\n437|\tt.Helper()\n438|\te := witnessFixtureEntries(t)\n439|\twitnesses := []armWitness{}\n440|\twitnesses = append(witnesses, envelopeWitnesses(e)...)\n441|\twitnesses = append(witnesses, manifestWitnesses(e)...)\n442|\twitnesses = append(witnesses, probeWitnesses(e)...)\n443|\twitnesses = append(witnesses, contextWitnesses(e)...)\n444|\twitnesses = append(witnesses, tupleWitnesses(e)...)\n445|\twitnesses = append(witnesses, operationWitnesses(e)...)\n446|\twitnesses = append(witnesses, gateWitnesses(e)...)\n447|\twitnesses = append(witnesses, frameWitnesses(e)...)\n448|\twitnesses = append(witnesses, conduitWitnesses(e)...)\n449|\treturn witnesses\n450|}"}}}
