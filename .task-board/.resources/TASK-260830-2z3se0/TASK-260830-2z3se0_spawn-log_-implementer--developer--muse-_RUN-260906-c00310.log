{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cafb","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":984,"recorded_at":1780531400001963,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"task_stream":{"kind":"task","id":"4277a52f-63ca-40e0-8cbb-346a6fffb3cf"},"task_id":"4277a52f-63ca-40e0-8cbb-346a6fffb3cf","event":{"kind":"output","task_id":"4277a52f-63ca-40e0-8cbb-346a6fffb3cf","chunk":"edited\nchanged lines: lines 267-289\n--- original\n+++ updated\n@@\n-// vocabularyTablesInFile returns the package-level vars of one\n-// file whose single initializer is a vocabulary composite.\n-func vocabularyTablesInFile(syntax *ast.File, named map[string]ast.Expr) []string {\n-\tvar found []string\n-\tfor _, declaration := range syntax.Decls {\n-\t\tgeneral, ok := declaration.(*ast.GenDecl)\n-\t\tif !ok || general.Tok != token.VAR {\n-\t\t\tcontinue\n-\t\t}\n-\t\tfor _, specification := range general.Specs {\n-\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n-\t\t\tif !ok || len(value.Values) != 1 {\n-\t\t\t\tcontinue\n-\t\t\t}\n-\t\t\tif isVocabularyShape(value.Values[0], named) {\n-\t\t\t\tfor _, ident := range value.Names {\n-\t\t\t\t\tfound = append(found, ident.Name)\n-\t\t\t\t}\n-\t\t\t}\n-\t\t}\n-\t}\n-\treturn found\n-}\n+// vocabularyTablesInFile returns the package-level vars of one\n+// file whose initializer is a vocabulary composite. One shared\n+// initializer serves every name; paired initializers serve their\n+// own name each (`var a, b = []string{...}, []string{...}`), so\n+// a multi-name declaration never hides a table from the scan.\n+func vocabularyTablesInFile(syntax *ast.File, named map[string]ast.Expr) []string {\n+\tvar found []string\n+\tfor _, declaration := range syntax.Decls {\n+\t\tgeneral, ok := declaration.(*ast.GenDecl)\n+\t\tif !ok || general.Tok != token.VAR {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, specification := range general.Specs {\n+\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n+\t\t\tif !ok || len(value.Values) == 0 {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tfor index, ident := range value.Names {\n+\t\t\t\tvar initializer ast.Expr\n+\t\t\t\tswitch {\n+\t\t\t\tcase len(value.Values) == 1:\n+\t\t\t\t\tinitializer = value.Values[0]\n+\t\t\t\tcase index < len(value.Values):\n+\t\t\t\t\tinitializer = value.Values[index]\n+\t\t\t\tdefault:\n+\t\t\t\t\tcontinue\n+\t\t\t\t}\n+\t\t\t\tif isVocabularyShape(initializer, named) {\n+\t\t\t\t\tfound = append(found, ident.Name)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn found\n+}\n"}}}
