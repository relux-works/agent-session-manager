{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fb","stream":{"kind":"session","id":"01a07450-f188-71b1-8e87-3b58e1805190"},"sequence":344,"recorded_at":1780531400000683,"record_type":"event","durability":"durable","causation_id":"acdfe288-4f4e-444a-ae51-26b969af2141","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"acdfe288-4f4e-444a-ae51-26b969af2141","run_stream":{"kind":"run","id":"acdfe288-4f4e-444a-ae51-26b969af2141"},"call_id":"call_01a0745208927f50a4fa083004de1091","text":"Read text file `internal/sessadapter/operations_semantic_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|func TestDiscoverPartialCursorComplement(t *testing.T) {\n8|\tmanifestDigest := fixtureManifestDigestText(t)\n9|\trequest := fixtureRequestBody(t, OpDiscover, manifestDigest)\n10|\tdecoded, err := CheckRequestBody(OpDiscover, request)\n11|\tif err != nil {\n12|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n13|\t}\n14|\tfacts := SuccessFacts{Context: decoded}\n15|\tbase := fixtureSuccessBody(t, OpDiscover, requestContextOf(t, request), manifestDigest)\n16|\tcombinations := []struct {\n17|\t\tname    string\n18|\t\tpartial string\n19|\t\tcursor  string\n20|\t\tok      bool\n21|\t}{\n22|\t\t{\"complete without cursor\", `false`, `null`, true},\n23|\t\t{\"partial with cursor\", `true`, `\"cursor-9\"`, true},\n24|\t\t{\"complete with cursor\", `false`, `\"cursor-9\"`, false},\n25|\t\t{\"partial without cursor\", `true`, `null`, false},\n26|\t}\n27|\tfor _, test := range combinations {\n28|\t\tt.Run(test.name, func(t *testing.T) {\n29|\t\t\tbody := mutateMember(t, mutateMember(t, base, \"partial\", test.partial), \"next_cursor\", test.cursor)\n30|\t\t\terr := CheckSuccessBody(OpDiscover, body, facts)\n31|\t\t\tif test.ok && err != nil {\n32|\t\t\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n33|\t\t\t}\n34|\t\t\tif !test.ok && err == nil {\n35|\t\t\t\tt.Fatal(\"admitted an incoherent partial/cursor pair\")\n36|\t\t\t}\n37|\t\t\tif !test.ok {\n38|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"partial\", \"disagrees with the cursor\")\n39|\t\t\t}\n40|\t\t})\n41|\t}\n42|}\n43|\n44|func TestCapturePlanDigestEquality(t *testing.T) {\n45|\tmanifestDigest := fixtureManifestDigestText(t)\n46|\trequest := fixtureRequestBody(t, OpCapturePlan, manifestDigest)\n47|\tdecoded, err := CheckRequestBody(OpCapturePlan, request)\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n50|\t}\n51|\tfacts := SuccessFacts{Context: decoded}\n52|\tbase := fixtureSuccessBody(t, OpCapturePlan, requestContextOf(t, request), manifestDigest)\n53|\tif err := CheckSuccessBody(OpCapturePlan, base, facts); err != nil {\n54|\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n55|\t}\n56|\tmismatched := mutateMember(t, base, \"capture_plan_digest\", quote(fixtureDigest(\"other-plan\")))\n57|\terr = CheckSuccessBody(OpCapturePlan, mismatched, facts)\n58|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"capture_plan_digest\", \"does not equal the plan digest\")\n59|}\n60|\n61|func TestValidateResultRules(t *testing.T) {\n62|\tmanifestDigest := fixtureManifestDigestText(t)\n63|\tbuild := func(t *testing.T, mode string, archive bool) ([]byte, SuccessFacts) {\n64|\t\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n65|\t\tif mode != \"staged\" {\n66|\t\t\trequest = mutateMember(t, request, \"mode\", quote(mode))\n67|\t\t\tif archive {\n68|\t\t\t\tfor _, member := range []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"} {\n69|\t\t\t\t\trequest = mutateMember(t, request, member, `null`)\n70|\t\t\t\t}\n71|\t\t\t}\n72|\t\t}\n73|\t\tdecoded, err := CheckRequestBody(OpValidate, request)\n74|\t\tif err != nil {\n75|\t\t\tt.Fatalf(\"CheckRequestBody(%q): %v\", mode, err)\n76|\t\t}\n77|\t\treturn request, SuccessFacts{Context: decoded, ValidateMode: mode}\n78|\t}\n79|\tt.Run(\"staged valid\", func(t *testing.T) {\n80|\t\trequest, facts := build(t, \"staged\", false)\n81|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n82|\t\tif err := CheckSuccessBody(OpValidate, success, facts); err != nil {\n83|\t\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n84|\t\t}\n85|\t})\n86|\tt.Run(\"archive request carries target\", func(t *testing.T) {\n87|\t\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n88|\t\trequest = mutateMember(t, request, \"mode\", `\"archive\"`)\n89|\t\t_, err := CheckRequestBody(OpValidate, request)\n90|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"projection_plan_id\", \"carries a target member\")\n91|\t})\n92|\tt.Run(\"staged request misses target\", func(t *testing.T) {\n93|\t\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n94|\t\trequest = mutateMember(t, request, \"projection_plan_id\", `null`)\n95|\t\t_, err := CheckRequestBody(OpValidate, request)\n96|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"projection_plan_id\", \"misses a target member\")\n97|\t})\n98|\tt.Run(\"mode mismatch\", func(t *testing.T) {\n99|\t\trequest, facts := build(t, \"staged\", false)\n100|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n101|\t\tsuccess = mutateMember(t, success, \"mode\", `\"live\"`)\n102|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n103|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"mode\", \"does not echo\")\n104|\t})\n105|\tt.Run(\"zero request mode fact\", func(t *testing.T) {\n106|\t\trequest, _ := build(t, \"staged\", false)\n107|\t\tdecoded, err := CheckRequestBody(OpValidate, request)\n108|\t\tif err != nil {\n109|\t\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n110|\t\t}\n111|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n112|\t\terr = CheckSuccessBody(OpValidate, success, SuccessFacts{Context: decoded})\n113|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"mode\", \"does not echo\")\n114|\t})\n115|\tt.Run(\"valid with failed check\", func(t *testing.T) {\n116|\t\trequest, facts := build(t, \"staged\", false)\n117|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n118|\t\tsuccess = mutateMember(t, success, \"structural_valid\", `false`)\n119|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n120|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"valid\", \"failed structural or semantic\")\n121|\t})\n122|\tt.Run(\"valid with failed applicable check\", func(t *testing.T) {\n123|\t\trequest, facts := build(t, \"staged\", false)\n124|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n125|\t\tsuccess = mutateMember(t, success, \"identity_valid\", `false`)\n126|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n127|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"identity_valid\", \"failed applicable check\")\n128|\t})\n129|\tt.Run(\"valid with error finding\", func(t *testing.T) {\n130|\t\trequest, facts := build(t, \"staged\", false)\n131|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n132|\t\tfinding := `{\"severity\":\"error\",\"code\":\"val-1\",\"message\":\"broken\",\"remediation\":null,\"extensions\":{}}`\n133|\t\tsuccess = mutateMember(t, success, \"findings\", `[`+finding+`]`)\n134|\t\terr := CheckSuccessBody(OpValidate, success, facts)\n135|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"findings\", \"error finding\")\n136|\t})\n137|\tt.Run(\"invalid result admits failures\", func(t *testing.T) {\n138|\t\trequest, facts := build(t, \"staged\", false)\n139|\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n140|\t\tsuccess = mutateMember(t, success, \"valid\", `false`)\n141|\t\tsuccess = mutateMember(t, success, \"structural_valid\", `false`)\n142|\t\tif err := CheckSuccessBody(OpValidate, success, facts); err != nil {\n143|\t\t\tt.Fatalf(\"CheckSuccessBody invalid result: %v\", err)\n144|\t\t}\n145|\t})\n146|}\n147|\n148|// validateTargetMembers is the closed four-target set the\n149|// validate mode rule ranges over, in both branches.\n150|var validateTargetMembers = []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"}\n151|\n152|// validateTargetCarry is one non-null value per target member for\n153|// the archive-branch probes: digests for the manifest members,\n154|// the native session name for the session member.\n155|func validateTargetCarry(member string) string {\n156|\tif member == \"expected_target_native_session_id\" {\n157|\t\treturn `\"target-1\"`\n158|\t}\n159|\treturn quote(fixturePlanDigest)\n160|}\n161|\n162|// TestCheckValidateNullabilityDrivesEveryTarget breaks every\n163|// member of the four-target set alone in both mode branches\n164|// through the request entry point: archive carrying any single\n165|// target refuses naming it, and staged missing any single target\n166|// refuses naming it. A loop truncation (targets[:3]) admits the\n167|// fourth member and reddens here, which a one-member probe\n168|// cannot catch. The obligation set is written here rather than\n169|// read from production so a narrowed production list reddens on\n170|// the missing member instead of shrinking the probe: the member\n171|// census and the operation table already pin the four names from\n172|// the other side.\n173|func TestCheckValidateNullabilityDrivesEveryTarget(t *testing.T) {\n174|\tmanifestDigest := fixtureManifestDigestText(t)\n175|\tt.Run(\"archive carries each target\", func(t *testing.T) {\n176|\t\tbase := fixtureRequestBody(t, OpValidate, manifestDigest)\n177|\t\tarchived := mutateMember(t, base, \"mode\", `\"archive\"`)\n178|\t\tfor _, member := range validateTargetMembers {\n179|\t\t\tarchived = mutateMember(t, archived, member, `null`)\n180|\t\t}\n181|\t\tif _, err := CheckRequestBody(OpValidate, archived); err != nil {\n182|\t\t\tt.Fatalf(\"archive request without targets: %v\", err)\n183|\t\t}\n184|\t\tfor _, member := range validateTargetMembers {\n185|\t\t\tt.Run(member, func(t *testing.T) {\n186|\t\t\t\t_, err := CheckRequestBody(OpValidate, mutateMember(t, archived, member, validateTargetCarry(member)))\n187|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"carries a target member\")\n188|\t\t\t})\n189|\t\t}\n190|\t})\n191|\tt.Run(\"staged misses each target\", func(t *testing.T) {\n192|\t\tbase := fixtureRequestBody(t, OpValidate, manifestDigest)\n193|\t\tif _, err := CheckRequestBody(OpValidate, base); err != nil {\n194|\t\t\tt.Fatalf(\"staged request: %v\", err)\n195|\t\t}\n196|\t\tfor _, member := range validateTargetMembers {\n197|\t\t\tt.Run(member, func(t *testing.T) {\n198|\t\t\t\t_, err := CheckRequestBody(OpValidate, mutateMember(t, base, member, `null`))\n199|\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a target member\")\n200|\t\t\t})\n201|\t\t}\n202|\t})\n203|}\n204|\n205|// TestCheckValidateResultDrivesEveryApplicableCheck fails every\n206|// applicable check alone under valid=true: each of the three\n207|// nullable checks false refuses naming that check. A dropped\n208|// member admits a false check and reddens here.\n209|func TestCheckValidateResultDrivesEveryApplicableCheck(t *testing.T) {\n210|\tmanifestDigest := fixtureManifestDigestText(t)\n211|\trequest := fixtureRequestBody(t, OpValidate, manifestDigest)\n212|\tdecoded, err := CheckRequestBody(OpValidate, request)\n213|\tif err != nil {\n214|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n215|\t}\n216|\tfacts := SuccessFacts{Context: decoded, ValidateMode: \"staged\"}\n217|\tfor _, member := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n218|\t\tt.Run(member, func(t *testing.T) {\n219|\t\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n220|\t\t\terr := CheckSuccessBody(OpValidate, mutateMember(t, success, member, `false`), facts)\n221|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"failed applicable check\")\n222|\t\t})\n223|\t}\n224|\tt.Run(\"non boolean check member\", func(t *testing.T) {\n225|\t\tfor _, member := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n226|\t\t\tsuccess := fixtureSuccessBody(t, OpValidate, requestContextOf(t, request), manifestDigest)\n227|\t\t\terr := CheckSuccessBody(OpValidate, mutateMember(t, success, member, `\"yes\"`), facts)\n228|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"not a boolean\")\n229|\t\t}\n230|\t})\n231|}\n232|\n233|// TestResumePlanIdentityComplement drives zero, one, and two\n234|// occurrences of the explicit identity: exactly one admits, and\n235|// both neighbours refuse.\n236|func TestResumePlanIdentityComplement(t *testing.T) {\n237|\tmanifestDigest := fixtureManifestDigestText(t)\n238|\trequest := fixtureRequestBody(t, OpResumePlan, manifestDigest)\n239|\tdecoded, err := CheckRequestBody(OpResumePlan, request)\n240|\tif err != nil {\n241|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n242|\t}\n243|\tfacts := SuccessFacts{Context: decoded, ResumeTargetID: \"target-1\"}\n244|\tbase := fixtureSuccessBody(t, OpResumePlan, requestContextOf(t, request), manifestDigest)\n245|\tif err := CheckSuccessBody(OpResumePlan, base, facts); err != nil {\n246|\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n247|\t}\n248|\tabsent := mutateMember(t, base, \"argv\", `[\"ax\",\"open\"]`)\n249|\terr = CheckSuccessBody(OpResumePlan, absent, facts)\n250|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"exactly once\")\n251|\tdoubled := mutateMember(t, base, \"argv\", `[\"ax\",\"open\",\"target-1\",\"target-1\"]`)\n252|\terr = CheckSuccessBody(OpResumePlan, doubled, facts)\n253|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"exactly once\")\n254|\tclosed := mutateMember(t, base, \"opens_existing_identity\", `false`)\n255|\terr = CheckSuccessBody(OpResumePlan, closed, facts)\n256|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"opens_existing_identity\", \"existing identity\")\n257|}\n258|\n259|func TestProjectionPlanDispositionRules(t *testing.T) {\n260|\tmanifestDigest := fixtureManifestDigestText(t)\n261|\trequest := fixtureRequestBody(t, OpProjectionPlan, manifestDigest)\n262|\tif _, err := CheckRequestBody(OpProjectionPlan, request); err != nil {\n263|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n264|\t}\n265|\tarchived := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"archive_only\"]}`)\n266|\t_, err := CheckRequestBody(OpProjectionPlan, archived)\n267|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"seven-disposition vocabulary\")\n268|\teighth := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"exact\",\"bogus\"]}`)\n269|\t_, err = CheckRequestBody(OpProjectionPlan, eighth)\n270|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"seven-disposition vocabulary\")\n271|\tunsorted := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"summarized\",\"exact\"]}`)\n272|\t_, err = CheckRequestBody(OpProjectionPlan, unsorted)\n273|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"not sorted unique\")\n274|\tempty := mutateMember(t, request, \"required_dispositions\", `{}`)\n275|\t_, err = CheckRequestBody(OpProjectionPlan, empty)\n276|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"required_dispositions\", \"no class\")\n277|\tfifth := mutateMember(t, request, \"fidelity_profile\", `\"archive_only\"`)\n278|\t_, err = CheckRequestBody(OpProjectionPlan, fifth)\n279|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"fidelity_profile\", \"four-profile vocabulary\")\n280|\tduplicated := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"exact\",\"exact\"]}`)\n281|\t_, err = CheckRequestBody(OpProjectionPlan, duplicated)\n282|\tif err == nil {\n283|\t\tt.Fatal(\"admitted a duplicated disposition\")\n284|\t}\n285|}\n286|\n287|func TestDoctorResultRules(t *testing.T) {\n288|\tmanifestDigest := fixtureManifestDigestText(t)\n289|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n290|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n291|\tif err != nil {\n292|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n293|\t}\n294|\tprobe, _ := fixtureValidProbe(t)\n295|\tgood := func() []byte {\n296|\t\treturn fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n297|\t}\n298|\tfacts := SuccessFacts{Context: decoded, DoctorDirection: DirectionSourceRead}\n299|\tif err := CheckSuccessBody(OpDoctor, good(), facts); err != nil {\n300|\t\tt.Fatalf(\"CheckSuccessBody doctor: %v\", err)\n301|\t}\n302|\tmismatched := mutateMember(t, good(), \"direction\", `\"target_write\"`)\n303|\terr = CheckSuccessBody(OpDoctor, mismatched, facts)\n304|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"direction\", \"request direction\")\n305|\tbadStatus := mutateMember(t, good(), \"registry_entry_status\", `\"pending\"`)\n306|\terr = CheckSuccessBody(OpDoctor, badStatus, facts)\n307|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"registry_entry_status\", \"accepted|revoked|absent\")\n308|\tresult, err := DecodeDoctorResult(good(), decoded, DirectionSourceRead)\n309|\tif err != nil {\n310|\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n311|\t}\n312|\tif err := CheckDoctorHealthy(result, probe, nil); err != nil {\n313|\t\tt.Fatalf(\"CheckDoctorHealthy unhealthy: %v\", err)\n314|\t}\n315|\trevoked := mutateMember(t, good(), \"registry_entry_status\", `\"revoked\"`)\n316|\trevoked = mutateMember(t, revoked, \"healthy\", `true`)\n317|\trevokedResult, err := DecodeDoctorResult(revoked, decoded, DirectionSourceRead)\n318|\tif err != nil {\n319|\t\tt.Fatalf(\"DecodeDoctorResult revoked: %v\", err)\n320|\t}\n321|\terr = CheckDoctorHealthy(revokedResult, probe, nil)\n322|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"tuple_registry\", \"accepted registry entry\")\n323|\thealthy := mutateMember(t, good(), \"healthy\", `true`)\n324|\thealthyResult, err := DecodeDoctorResult(healthy, decoded, DirectionSourceRead)\n325|\tif err != nil {\n326|\t\tt.Fatalf(\"DecodeDoctorResult healthy: %v\", err)\n327|\t}\n328|\tweakened := probe\n329|\tweakened.Capabilities = cloneCapabilities(probe.Capabilities)\n330|\tweakened.Capabilities[\"native_discovery\"] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n331|\terr = CheckDoctorHealthy(healthyResult, weakened, []string{\"native_discovery\"})\n332|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"native_discovery\", \"usable required capability\")\n333|\tif err := CheckDoctorHealthy(healthyResult, probe, []string{\"native_discovery\"}); err != nil {\n334|\t\tt.Fatalf(\"CheckDoctorHealthy healthy: %v\", err)\n335|\t}\n336|\terr = CheckDoctorHealthy(healthyResult, probe, []string{\"teleport\"})\n337|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"required\", \"closed registry\")\n338|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
