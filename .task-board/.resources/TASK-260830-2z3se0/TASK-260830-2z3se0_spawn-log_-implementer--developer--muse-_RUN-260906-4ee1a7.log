, failure\n901|\t}\n902|\tif len(elements) == 0 {\n903|\t\tfailure, err := failProtocol(\"tuple strategies are empty\", \"strategies\")\n904|\t\tif err != nil {\n905|\t\t\treturn nil, err\n906|\t\t}\n907|\t\treturn nil, failure\n908|\t}\n909|\tstrategies := make([]string, 0, len(elements))\n910|\tfor _, element := range elements {\n911|\t\tname, ok := rawString(element)\n912|\t\tif !ok || !validStrategy(name) {\n913|\t\t\tfailure, err := failProtocol(\"tuple strategy is outside the five-strategy vocabulary\", \"strategies\")\n914|\t\t\tif err != nil {\n915|\t\t\t\treturn nil, err\n916|\t\t\t}\n917|\t\t\treturn nil, failure\n918|\t\t}\n919|\t\tstrategies = append(strategies, name)\n920|\t}\n921|\tfor index := 1; index < len(strategies); index++ {\n922|\t\tif strategies[index-1] >= strategies[index] {\n923|\t\t\tfailure, err := failProtocol(\"tuple strategies are not sorted unique\", \"strategies\")\n924|\t\t\tif err != nil {\n925|\t\t\t\treturn nil, err\n926|\t\t\t}\n927|\t\t\treturn nil, failure\n928|\t\t}\n929|\t}\n930|\treturn strategies, nil\n931|}\n932|\n933|// checkContractsShape validates the contract-version array shape:\n934|// 1..64 rows, each with a string contract_id and 1..32 sorted\n935|// unique SemVer versions. Allowed-ID membership is a stated bound:\n936|// the allowed identifiers are prose names in Section 13.14 whose\n937|// mapping to contract URNs belongs to the registry publisher\n938|// check, which has no owner yet.\n939|func checkContractsShape(raw json.RawMessage) error {\n940|\telements, ok := decodeArray(bytesTrimSpace(raw))\n941|\tif !ok {\n942|\t\tfailure, err := failProtocol(\"tuple contracts are not an array\", \"contracts\")\n943|\t\tif err != nil {\n944|\t\t\treturn err\n945|\t\t}\n946|\t\treturn failure\n947|\t}\n948|\tif len(elements) == 0 || len(elements) > 64 {\n949|\t\tfailure, err := failProtocol(\"tuple contracts are not 1..64 rows\", \"contracts\")\n950|\t\tif err != nil {\n951|\t\t\treturn err\n952|\t\t}\n953|\t\treturn failure\n954|\t}\n955|\tseen := map[string]bool{}\n956|\tprevious := \"\"\n957|\tfor _, element := range elements {\n958|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n959|\t\tif fault != nil {\n960|\t\t\tfailure, err := failProtocol(\"tuple contract row \"+fault.detail, fault.member)\n961|\t\t\tif err != nil {\n962|\t\t\t\treturn err\n963|\t\t\t}\n964|\t\t\treturn failure\n965|\t\t}\n966|\t\tif len(members) != 2 {\n967|\t\t\tfailure, err := failProtocol(\"tuple contract row is not exactly contract_id and versions\", \"contracts\")\n968|\t\t\tif err != nil {\n969|\t\t\t\treturn err\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
