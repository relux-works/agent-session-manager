\n743|\t\treturn nil, failure\n744|\t}\n745|\tpassed, ok := rawBool(members[\"bounded_continuation_turn_passed\"])\n746|\tif !ok || !passed {\n747|\t\tfailure, err := failProtocol(\"tuple resume smoke continuation turn did not pass\", \"bounded_continuation_turn_passed\")\n748|\t\tif err != nil {\n749|\t\t\treturn nil, err\n750|\t\t}\n751|\t\treturn nil, failure\n752|\t}\n753|\treturn &SmokeEvidence{\n754|\t\tExecutedAt:      executed,\n755|\t\tEvidenceDigest:  evidenceDigest.String(),\n756|\t\tNativeCLIFamily: family,\n757|\t}, nil\n758|}\n759|\n760|// fidelityLimitMembers is the exact FidelityLimit member set.\n761|var fidelityLimitMembers = map[string]bool{\n762|\t\"code\":                true,\n763|\t\"affected_class\":      true,\n764|\t\"maximum_disposition\": true,\n765|\t\"detail\":              true,\n766|}\n767|\n768|// fidelityLimitRequired lists fidelityLimitMembers in order.\n769|var fidelityLimitRequired = []string{\n770|\t\"code\",\n771|\t\"affected_class\",\n772|\t\"maximum_disposition\",\n773|\t\"detail\",\n774|}\n775|\n776|// decodeFidelityLimits validates the sorted-unique fidelity-limit\n777|// array: shape per row, disposition in the seven-vocabulary, and\n778|// uniqueness over code/class pairs. archive_only is a strategy and\n779|// is refused as a disposition here the same way it is refused in\n780|// required_dispositions.\n781|func decodeFidelityLimits(raw json.RawMessage) ([]FidelityLimit, error) {\n782|\telements, ok := decodeArray(bytesTrimSpace(raw))\n783|\tif !ok {\n784|\t\tfailure, err := failProtocol(\"tuple fidelity limits are not an array\", \"known_fidelity_limits\")\n785|\t\tif err != nil {\n786|\t\t\treturn nil, err\n787|\t\t}\n788|\t\treturn nil, failure\n789|\t}\n790|\tif uint64(len(elements)) > 1024 {\n791|\t\tfailure, err := failProtocol(\"tuple fidelity limits exceed 1024 rows\", \"known_fidelity_limits\")\n792|\t\tif err != nil {\n793|\t\t\treturn nil, err\n794|\t\t}\n795|\t\treturn nil, failure\n796|\t}\n797|\tlimits := make([]FidelityLimit, 0, len(elements))\n798|\tseen := map[string]bool{}\n799|\tfor _, element := range elements {\n800|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n801|\t\tif fault != nil {\n802|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit \"+fault.detail, fault.member)\n803|\t\t\tif err != nil {\n804|\t\t\t\treturn nil, err\n805|\t\t\t}\n806|\t\t\treturn nil, failure\n807|\t\t}\n808|\t\tif name, unknown := unknownMember(members, fidelityLimitMembers); unknown {\n809|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit carries unknown member\", name)\n810|\t\t\tif err != nil {\n811|\t\t\t\treturn nil, err\n812|\t\t\t}\n813|\t\t\treturn nil, failure\n814|\t\t}\n815|\t\tif name, missing := missingMember(members, fidelityLimitRequired); missing {\n816|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit misses a required member\", name)\n817|\t\t\tif err != nil {\n818|\t\t\t\treturn nil, err\n819|\t\t\t}\n820|\t\t\treturn nil, failure\n821|\t\t}\n822|\t\tcode, ok := checkStringBounds(members[\"code\"], 1, 128)\n823|\t\tif !ok {\n824|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit code is not a string[1..128]\", \"code\")\n825|\t\t\tif err != nil {\n826|\t\t\t\treturn nil, err\n827|\t\t\t}\n828|\t\t\treturn nil, failure\n829|\t\t}\n830|\t\tclass, ok := checkStringBounds(members[\"affected_class\"], 1, 128)\n831|\t\tif !ok {\n832|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit class is not a string[1..128]\", \"affected_class\")\n833|\t\t\tif err != nil {\n834|\t\t\t\treturn nil, err\n835|\t\t\t}\n836|\t\t\treturn nil, failure\n837|\t\t}\n838|\t\tdisposition, ok := rawString(members[\"maximum_disposition\"])\n839|\t\tif !ok || !validDisposition(disposition) {\n840|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit disposition is outside the seven-disposition vocabulary\", \"maximum_disposition\")\n841|\t\t\tif err != nil {\n842|\t\t\t\treturn nil, err\n843|\t\t\t}\n844|\t\t\treturn nil, failure\n845|\t\t}\n846|\t\tif _, ok := checkStringBounds(members[\"detail\"], 1, 4096); !ok {\n847|\t\t\tfailure, err := failProtocol(\"tuple fidelity limit detail is not a string[1..4096]\", \"detail\")\n848|\t\t\tif err != nil {\n849|\t\t\t\treturn nil, err\n850|\t\t\t}\n851|\t\t\treturn nil, failure\n852|\t\t}\n853|\t\tpair := code + \"\\x00\" + class\n854|\t\tif seen[pair] {\n855|\t\t\tfailure, err := failProtocol(\"tuple fidelity limits repeat a code/class pair\", \"known_fidelity_limits\")\n856|\t\t\tif err != nil {\n857|\t\t\t\treturn nil, err\n858|\t\t\t}\n859|\t\t\treturn nil, failure\n860|\t\t}\n861|\t\tseen[pair] = true\n862|\t\tlimits = append(limits, FidelityLimit{\n863|\t\t\tCode:               code,\n864|\t\t\tAffectedClass:      class,\n865|\t\t\tMaximumDisposition: disposition,\n866|\t\t\tDetail:             mustRawString(members[\"detail\"]),\n867|\t\t})\n868|\t}\n869|\tfor index := 1; index < len(limits); index++ {\n870|\t\tprevious := limits[index-1].Code + \"\\x00\" + limits[index-1].AffectedClass\n871|\t\tcurrent := limits[index].Code + \"\\x00\" + limits[index].AffectedClass\n872|\t\tif previous >= current {\n873|\t\t\tfailure, err := failProtocol(\"tuple fidelity limits are not sorted unique by code/class\", \"known_fidelity_limits\")\n874|\t\t\tif err != nil {\n875|\t\t\t\treturn nil, err\n876|\t\t\t}\n877|\t\t\treturn nil, failure\n878|\t\t}\n879|\t}\n880|\treturn limits, nil\n881|}\n882|\n883|// mustRawString renders a member already validated as a string. It\n884|// is only called on members a bounds check accepted above.\n885|func mustRawString(raw json.RawMessage) string {\n886|\tvalue, _ := rawString(raw)\n887|\treturn value\n888|}\n889|\n890|// decodeStrategies validates the sorted unique non-empty strategy\n891|// subset: every name in the five-vocabulary, strictly ordered, no\n892|// repeats.\n893|func decodeStrategies(raw json.RawMessage) ([]string, error) {\n894|\telements, ok := decodeArray(bytesTrimSpace(raw))\n895|\tif !ok {\n896|\t\tfailure, err := failProtocol(\"tuple strategies are not an array\", \"strategies\")\n897|\t\tif err != nil {\n898|\t\t\treturn nil, err\n899|\t\t}\n900|\t\treturn nil, failure\n901|\t}\n902|\tif len(elements) == 0 {\n903|\t\tfailure, err := failProtocol(\"tuple strategies are empty\", \"strategies\")\n904|\t\tif err != nil {\n905|\t\t\treturn nil, err\n906|\t\t}\n907|\t\treturn nil, failure\n908|\t}\n909|\tstrategies := make([]string, 0, len(elements))\n910|\tfor _, element := range elements {\n911|\t\tname, ok := rawString(element)\n912|\t\tif !ok || !validStrategy(name) {\n913|\t\t\tfailure, err := failProtocol(\"tuple strategy is outside the five-strategy vocabulary\", \"strategies\")\n914|\t\t\tif err != nil {\n915|\t\t\t\treturn nil, err\n916|\t\t\t}\n917|\t\t\treturn nil, failure\n918|\t\t}\n919|\t\tstrategies = append(strategies, name)\n920|\t}\n921|\tfor index := 1; index < len(strategies); index++ {\n922|\t\tif strategies[index-1] >= strategies[index] {\n923|\t\t\tfailure, err := failProtocol(\"tuple strategies are not sorted unique\", \"strategies\")\n924|\t\t\tif err != nil {\n925|\t\t\t\treturn nil, err\n926|\t\t\t}\n927|\t\t\treturn nil, failure\n928|\t\t}\n929|\t}\n930|\treturn strategies, nil\n931|}\n932|\n933|// checkContractsShape validates the contract-version array shape:\n934|// 1..64 rows, each with a string contract_id and 1..32 sorted\n935|// unique SemVer versions. Allowed-ID membership is a stated bound:\n936|// the allowed identifiers are prose names in Section 13.14 whose\n937|// mapping to contract URNs belongs to the registry publisher\n938|// check, which has no owner yet.\n939|func checkContractsShape(raw json.RawMessage) error {\n940|\telements, ok := decodeArray(bytesTrimSpace(raw))\n941|\tif !ok {\n942|\t\tfailure, err := failProtocol(\"tuple contracts are not an array\", \"contracts\")\n943|\t\tif err != nil {\n944|\t\t\treturn err\n945|\t\t}\n946|\t\treturn failure\n947|\t}\n948|\tif len(elements) == 0 || len(elements) > 64 {\n949|\t\tfailure, err := failProtocol(\"tuple contracts are not 1..64 rows\", \"contracts\")\n950|\t\tif err != nil {\n951|\t\t\treturn err\n952|\t\t}\n953|\t\treturn failure\n954|\t}\n955|\tseen := map[string]bool{}\n956|\tprevious := \"\"\n957|\tfor _, element := range elements {\n958|\t\tmembers, fault := decodeStrictObject(bytesTrimSpace(element))\n959|\t\tif fault != nil {\n960|\t\t\tfailure, err := failProtocol(\"tuple contract row \"+fault.detail, fault.member)\n961|\t\t\tif err != nil {\n962|\t\t\t\treturn err\n963|\t\t\t}\n964|\t\t\treturn failure\n965|\t\t}\n966|\t\tif len(members) != 2 {\n967|\t\t\tfailure, err := failProtocol(\"tuple contract row is not exactly contract_id and versions\", \"contracts\")\n968|\t\t\tif err != nil {\n969|\t\t\t\treturn err\n(more lines below)"}}}
