{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c839","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":631,"recorded_at":1780531400001257,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"077dee22-21d2-49ce-b383-23eeac2de8b9"},"task_id":"077dee22-21d2-49ce-b383-23eeac2de8b9","event":{"kind":"output","task_id":"077dee22-21d2-49ce-b383-23eeac2de8b9","chunk":"Read text file `internal/sessadapter/tuple_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|func mustTime(t *testing.T, value string) time.Time {\n10|\tt.Helper()\n11|\tparsed, err := time.Parse(time.RFC3339, value)\n12|\tif err != nil {\n13|\t\tt.Fatalf(\"mustTime: %v\", err)\n14|\t}\n15|\treturn parsed\n16|}\n17|\n18|func TestDecodeTupleAcceptsFixture(t *testing.T) {\n19|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n20|\tif err != nil {\n21|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n22|\t}\n23|\tif tuple.EnvironmentID != fixtureEnvironmentID || tuple.Platform != \"linux\" || tuple.Architecture != \"amd64\" {\n24|\t\tt.Fatalf(\"DecodeTuple = %+v\", tuple)\n25|\t}\n26|}\n27|\n28|func TestDecodeTupleRefusals(t *testing.T) {\n29|\tfixture := []byte(fixtureTupleJSON())\n30|\tmembers := []string{\"environment_id\", \"environment_version\", \"platform\", \"architecture\", \"store_schema_fingerprint\", \"adapter_version\"}\n31|\tfor _, member := range members {\n32|\t\tt.Run(\"missing \"+member, func(t *testing.T) {\n33|\t\t\t_, err := DecodeTuple(dropMember(t, fixture, member))\n34|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a required member\")\n35|\t\t})\n36|\t}\n37|\tfor _, test := range []struct {\n38|\t\tname   string\n39|\t\tmember string\n40|\t\tvalue  string\n41|\t\ttext   string\n42|\t}{\n43|\t\t{\"bad environment id\", \"environment_id\", `\"Test!\"`, \"not an environment-id\"},\n44|\t\t{\"empty version\", \"environment_version\", `\"\"`, \"not a string[1..128]\"},\n45|\t\t{\"bad platform\", \"platform\", `\"darwin\"`, \"outside linux|macos|windows|wsl2\"},\n46|\t\t{\"v1 darwin is never a tuple platform\", \"platform\", `\"darwin\"`, \"outside linux|macos|windows|wsl2\"},\n47|\t\t{\"bad architecture\", \"architecture\", `\"x86\"`, \"outside amd64|arm64\"},\n48|\t\t{\"bad fingerprint\", \"store_schema_fingerprint\", `\"abc\"`, \"not a digest\"},\n49|\t\t{\"bad adapter version\", \"adapter_version\", `\"1.2\"`, \"not SemVer\"},\n50|\t\t// Executable provenance is refused as an unknown member:\n51|\t\t// the tuple never carries it.\n52|\t\t{\"executable provenance\", \"executable_sha256\", `\"sha256:` + strings.Repeat(\"0\", 64) + `\"`, \"unknown member\"},\n53|\t} {\n54|\t\tt.Run(test.name, func(t *testing.T) {\n55|\t\t\tvar body []byte\n56|\t\t\tif test.member == \"executable_sha256\" {\n57|\t\t\t\tbody = appendMember(t, fixture, test.member, test.value)\n58|\t\t\t} else {\n59|\t\t\t\tbody = mutateMember(t, fixture, test.member, test.value)\n60|\t\t\t}\n61|\t\t\t_, err := DecodeTuple(body)\n62|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.member, test.text)\n63|\t\t})\n64|\t}\n65|\tfor _, platform := range []string{\"linux\", \"macos\", \"windows\", \"wsl2\"} {\n66|\t\tif _, err := DecodeTuple(mutateMember(t, fixture, \"platform\", `\"`+platform+`\"`)); err != nil {\n67|\t\t\tt.Fatalf(\"DecodeTuple(%q): %v\", platform, err)\n68|\t\t}\n69|\t}\n70|}\n71|\n72|func TestDecodeTupleEntryAcceptsBothDirections(t *testing.T) {\n73|\tfor _, direction := range []Direction{DirectionSourceRead, DirectionTargetWrite} {\n74|\t\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(direction)))\n75|\t\tif err != nil {\n76|\t\t\tt.Fatalf(\"DecodeTupleEntry(%q): %v\", direction, err)\n77|\t\t}\n78|\t\tif entry.Key.Direction != direction || entry.Status != \"accepted\" {\n79|\t\t\tt.Fatalf(\"entry = %+v\", entry)\n80|\t\t}\n81|\t\tif direction == DirectionSourceRead && entry.Smoke != nil {\n82|\t\t\tt.Fatal(\"source entry carries smoke\")\n83|\t\t}\n84|\t\tif direction == DirectionTargetWrite && entry.Smoke == nil {\n85|\t\t\tt.Fatal(\"target entry misses smoke\")\n86|\t\t}\n87|\t}\n88|}\n89|\n90|func TestDecodeTupleEntryCoherence(t *testing.T) {\n91|\tfixture := []byte(fixtureEntryJSON(DirectionTargetWrite))\n92|\t// Accepted with revocation members: refused.\n93|\taccepted := mutateMember(t, fixture, \"revocation_reason\", `\"superseded\"`)\n94|\t_, err := DecodeTupleEntry(accepted)\n95|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"status\", \"carries revocation members\")\n96|\t// Revoked without both members: refused in both halves.\n97|\trevoked := mutateMember(t, fixture, \"status\", `\"revoked\"`)\n98|\t_, err = DecodeTupleEntry(revoked)\n99|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"status\", \"misses a revocation member\")\n100|\trevokedHalf := mutateMember(t, mutateMember(t, fixture, \"status\", `\"revoked\"`), \"revocation_reason\", `\"superseded\"`)\n101|\t_, err = DecodeTupleEntry(revokedHalf)\n102|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"status\", \"misses a revocation member\")\n103|\t// Revoked with both members: admitted as revoked (admission\n104|\t// refuses it later; decoding proves shape, not admission).\n105|\trevokedFull := mutateMember(t, mutateMember(t, fixture, \"status\", `\"revoked\"`), \"revocation_reason\", `\"superseded\"`)\n106|\trevokedFull = mutateMember(t, revokedFull, \"revoked_at\", `\"2026-06-02T00:00:00.000Z\"`)\n107|\tentry, err := DecodeTupleEntry(revokedFull)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"DecodeTupleEntry revoked: %v\", err)\n110|\t}\n111|\tif entry.Status != \"revoked\" || entry.RevocationReason == nil || entry.RevokedAt == nil {\n112|\t\tt.Fatalf(\"revoked entry = %+v\", entry)\n113|\t}\n114|\t// Inverted validity interval: refused.\n115|\tinverted := mutateMember(t, fixture, \"valid_from\", `\"2028-01-01T00:00:00.000Z\"`)\n116|\t_, err = DecodeTupleEntry(inverted)\n117|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"valid_until\", \"does not order\")\n118|\t// Empty strategies: refused. Unknown strategy: refused.\n119|\t// Unsorted strategies: refused.\n120|\tfor _, test := range []struct {\n121|\t\tname  string\n122|\t\tvalue string\n123|\t\ttext  string\n124|\t}{\n125|\t\t{\"empty strategies\", `[]`, \"are empty\"},\n126|\t\t{\"unknown strategy\", `[\"teleport\"]`, \"five-strategy vocabulary\"},\n127|\t\t{\"unsorted strategies\", `[\"target_native_writer\",\"continuation_context\"]`, \"not sorted unique\"},\n128|\t\t{\"duplicate strategies\", `[\"target_native_writer\",\"target_native_writer\"]`, \"not sorted unique\"},\n129|\t} {\n130|\t\tt.Run(test.name, func(t *testing.T) {\n131|\t\t\t_, err := DecodeTupleEntry(mutateMember(t, fixture, \"strategies\", test.value))\n132|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"strategies\", test.text)\n133|\t\t})\n134|\t}\n135|\t// Failing fixture evidence: refused. Zero fixture count:\n136|\t// refused. Failing smoke: refused. Smoke without a passed\n137|\t// turn: refused.\n138|\tfor _, test := range []struct {\n139|\t\tname   string\n140|\t\tmember string\n141|\t\tvalue  string\n142|\t\ttext   string\n143|\t}{\n144|\t\t{\"fixture result fail\", \"fixture_evidence\", `{\"suite_revision\":\"rev-9\",\"suite_digest\":\"` + fixtureSuiteDigest + `\",\"result\":\"fail\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureEvidenceDigest + `\",\"fixture_count\":12}`, \"not pass\"},\n145|\t\t{\"fixture count zero\", \"fixture_evidence\", `{\"suite_revision\":\"rev-9\",\"suite_digest\":\"` + fixtureSuiteDigest + `\",\"result\":\"pass\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureEvidenceDigest + `\",\"fixture_count\":0}`, \"above zero\"},\n146|\t\t{\"smoke result fail\", \"resume_smoke_evidence\", `{\"result\":\"fail\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureSmokeDigest + `\",\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":true}`, \"not pass\"},\n147|\t\t{\"smoke turn failed\", \"resume_smoke_evidence\", `{\"result\":\"pass\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureSmokeDigest + `\",\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":false}`, \"did not pass\"},\n148|\t\t{\"bad status\", \"status\", `\"pending\"`, \"accepted|revoked\"},\n149|\t} {\n150|\t\tt.Run(test.name, func(t *testing.T) {\n151|\t\t\t_, err := DecodeTupleEntry(mutateMember(t, fixture, test.member, test.value))\n152|\t\t\tif err == nil {\n153|\t\t\t\tt.Fatalf(\"DecodeTupleEntry admitted %s\", test.name)\n154|\t\t\t}\n155|\t\t\tif failureCode(t, err) != \"session_adapter_protocol_error\" {\n156|\t\t\t\tt.Fatalf(\"code = %v, want session_adapter_protocol_error\", err)\n157|\t\t\t}\n158|\t\t\tif !strings.Contains(err.Error(), test.text) {\n159|\t\t\t\tt.Fatalf(\"error = %v, want %q\", err, test.text)\n160|\t\t\t}\n161|\t\t})\n162|\t}\n163|}\n164|\n165|// TestTupleAdmissionValidityBoundaries pins the interval on both\n166|// edges: the instant exactly at valid_from and valid_until\n167|// admits, one second outside refuses on each side. Both edges\n168|// are enforced: a one-sided check would admit the open side.\n169|func TestTupleAdmissionValidityBoundaries(t *testing.T) {\n170|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n173|\t}\n174|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n175|\tif err != nil {\n176|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n177|\t}\n178|\tbinding := fixtureBindingFacts()\n179|\tfor _, test := range []struct {\n180|\t\tname    string\n181|\t\tinstant string\n182|\t\tok      bool\n183|\t}{\n184|\t\t{\"one second before from\", \"2025-12-31T23:59:59.000Z\", false},\n185|\t\t{\"exactly at from\", fixtureValidFrom, true},\n186|\t\t{\"inside\", fixtureCallTime, true},\n187|\t\t{\"exactly at until\", fixtureValidUntil, true},\n188|\t\t{\"one second after until\", \"2027-01-01T00:00:01.000Z\", false},\n189|\t} {\n190|\t\tt.Run(test.name, func(t *testing.T) {\n191|\t\t\terr := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, binding, mustTime(t, test.instant))\n192|\t\t\tif test.ok && err != nil {\n193|\t\t\t\tt.Fatalf(\"CheckTupleAdmission: %v\", err)\n194|\t\t\t}\n195|\t\t\tif !test.ok && err == nil {\n196|\t\t\t\tt.Fatalf(\"CheckTupleAdmission admitted %s\", test.name)\n197|\t\t\t}\n198|\t\t\tif !test.ok {\n199|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"validity interval\")\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|func TestCheckTupleAdmissionRefusals(t *testing.T) {\n206|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n207|\tif err != nil {\n208|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n209|\t}\n210|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n211|\tif err != nil {\n212|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n213|\t}\n214|\tbinding := fixtureBindingFacts()\n215|\tnow := mustTime(t, fixtureCallTime)\n216|\totherTuple := tuple\n217|\totherTuple.Version = \"9.9.9\"\n218|\tfor _, test := range []struct {\n219|\t\tname      string\n220|\t\tdirection Direction\n221|\t\ttuple     Tuple\n222|\t\tbinding   BindingFacts\n223|\t\tentry     TupleEntry\n224|\t\ttext      string\n225|\t}{\n226|\t\t{\"direction mismatch\", DirectionSourceRead, tuple, binding, entry, \"direction does not match\"},\n227|\t\t{\"tuple mismatch\", DirectionTargetWrite, otherTuple, binding, entry, \"does not equal the probed tuple\"},\n228|\t\t{\"provider mismatch\", DirectionTargetWrite, tuple, BindingFacts{ProviderID: \"other\", CandidateKind: CandidateBuiltin, ExecutableSHA256: binding.ExecutableSHA256, ProviderManifestDigest: binding.ProviderManifestDigest, AdapterManifestDigest: binding.AdapterManifestDigest}, entry, \"execution binding\"},\n229|\t\t{\"executable mismatch\", DirectionTargetWrite, tuple, BindingFacts{ProviderID: binding.ProviderID, CandidateKind: CandidateBuiltin, ExecutableSHA256: fixtureDigest(\"other-exe\"), ProviderManifestDigest: binding.ProviderManifestDigest, AdapterManifestDigest: binding.AdapterManifestDigest}, entry, \"execution binding\"},\n230|\t\t{\"kind mismatch\", DirectionTargetWrite, tuple, BindingFacts{ProviderID: binding.ProviderID, CandidateKind: CandidateExternal, ExecutableSHA256: binding.ExecutableSHA256, ProviderManifestDigest: binding.ProviderManifestDigest, AdapterManifestDigest: binding.AdapterManifestDigest}, entry, \"execution binding\"},\n231|\t\t{\"revoked entry\", DirectionTargetWrite, tuple, binding, revokedEntry(t), \"not accepted\"},\n232|\t} {\n233|\t\tt.Run(test.name, func(t *testing.T) {\n234|\t\t\terr := CheckTupleAdmission(test.entry, test.direction, test.tuple, test.binding, now)\n235|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", tuple.EnvironmentID, test.text)\n236|\t\t})\n237|\t}\n238|\t// Source direction against a target entry: refused on\n239|\t// direction before any strategy rule is reached.\n240|\tif err := CheckTupleAdmission(entry, DirectionSourceRead, tuple, binding, now); err == nil {\n241|\t\tt.Fatal(\"admitted a target entry for a source call\")\n242|\t}\n243|\t// Source entry admits a source call and refuses a target call\n244|\t// on direction.\n245|\tsource, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionSourceRead)))\n246|\tif err != nil {\n247|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n248|\t}\n249|\tif err := CheckTupleAdmission(source, DirectionSourceRead, tuple, binding, now); err != nil {\n250|\t\tt.Fatalf(\"CheckTupleAdmission source: %v\", err)\n251|\t}\n252|\tif err := CheckTupleAdmission(source, DirectionTargetWrite, tuple, binding, now); err == nil {\n253|\t\tt.Fatal(\"admitted a source entry for a target call\")\n254|\t}\n255|\t// A source entry with smoke, or without archive_only, is\n256|\t// refused even in its own direction. A target entry with\n257|\t// archive_only, or without smoke, is refused in its own.\n258|\tsourceWithSmoke := source\n259|\tsmokeTime := mustTime(t, fixtureExecutedAt)\n260|\tsourceWithSmoke.Smoke = &SmokeEvidence{ExecutedAt: smokeTime, EvidenceDigest: fixtureSmokeDigest, NativeCLIFamily: \"claude\"}\n261|\tif err := CheckTupleAdmission(sourceWithSmoke, DirectionSourceRead, tuple, binding, now); err == nil {\n262|\t\tt.Fatal(\"admitted a source entry carrying smoke\")\n263|\t} else {\n264|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"resume smoke\")\n265|\t}\n266|\tsourceWide := source\n267|\tsourceWide.Strategies = []string{\"archive_only\", \"target_native_writer\"}\n268|\tif err := CheckTupleAdmission(sourceWide, DirectionSourceRead, tuple, binding, now); err == nil {\n269|\t\tt.Fatal(\"admitted a source entry beyond archive_only\")\n270|\t}\n271|\ttargetArchive := entry\n272|\ttargetArchive.Strategies = []string{\"archive_only\"}\n273|\ttargetArchive.Smoke = nil\n274|\tif err := CheckTupleAdmission(targetArchive, DirectionTargetWrite, tuple, binding, now); err == nil {\n275|\t\tt.Fatal(\"admitted a target entry with archive_only\")\n276|\t} else {\n277|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"archive_only\")\n278|\t}\n279|\ttargetNoSmoke := entry\n280|\ttargetNoSmoke.Smoke = nil\n281|\tif err := CheckTupleAdmission(targetNoSmoke, DirectionTargetWrite, tuple, binding, now); err == nil {\n282|\t\tt.Fatal(\"admitted a target entry without smoke\")\n283|\t} else {\n284|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"resume smoke\")\n285|\t}\n286|}\n287|\n288|func revokedEntry(t *testing.T) TupleEntry {\n289|\tt.Helper()\n290|\tfixture := []byte(fixtureEntryJSON(DirectionTargetWrite))\n291|\trevoked := mutateMember(t, mutateMember(t, fixture, \"status\", `\"revoked\"`), \"revocation_reason\", `\"superseded\"`)\n292|\trevoked = mutateMember(t, revoked, \"revoked_at\", `\"2026-06-02T00:00:00.000Z\"`)\n293|\tentry, err := DecodeTupleEntry(revoked)\n294|\tif err != nil {\n295|\t\tt.Fatalf(\"DecodeTupleEntry revoked: %v\", err)\n296|\t}\n297|\treturn entry\n298|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83b","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":632,"recorded_at":1780531400001259,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"077dee22-21d2-49ce-b383-23eeac2de8b9"},"task_id":"077dee22-21d2-49ce-b383-23eeac2de8b9","event":{"kind":"completed","task_id":"077dee22-21d2-49ce-b383-23eeac2de8b9"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83d","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":633,"recorded_at":1780531400001261,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"fd107efa-10c9-4c19-83e3-37620d3abcf1"},"task_id":"fd107efa-10c9-4c19-83e3-37620d3abcf1","event":{"kind":"output","task_id":"fd107efa-10c9-4c19-83e3-37620d3abcf1","chunk":"Read text file `internal/sessadapter/inventory_test.go`.\n(480 line(s) above)\n481|// callArm derives one constructor arm: a string-literal first\n482|// argument is the detail; a literal-plus-fault.detail binary is a\n483|// conduit keyed by function and prefix; anything else is an\n484|// expr obligation keyed by function.\n485|func callArm(constructor string, call *ast.CallExpr, function string) (string, error) {\n486|\tif len(call.Args) == 0 {\n487|\t\treturn \"\", fmt.Errorf(\"constructor %s called with no arguments in %s\", constructor, function)\n488|\t}\n489|\tswitch first := call.Args[0].(type) {\n490|\tcase *ast.BasicLit:\n491|\t\tif first.Kind != token.STRING {\n492|\t\t\treturn \"\", fmt.Errorf(\"constructor %s first argument is not a string in %s\", constructor, function)\n493|\t\t}\n494|\t\tdetail, err := strconv.Unquote(first.Value)\n495|\t\tif err != nil {\n496|\t\t\treturn \"\", err\n497|\t\t}\n498|\t\treturn \"ctor|\" + constructor + \"|\" + detail, nil\n499|\tcase *ast.BinaryExpr:\n500|\t\tprefix, ok := first.X.(*ast.BasicLit)\n501|\t\tif !ok || prefix.Kind != token.STRING {\n502|\t\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n503|\t\t}\n504|\t\ttext, err := strconv.Unquote(prefix.Value)\n505|\t\tif err != nil {\n506|\t\t\treturn \"\", err\n507|\t\t}\n508|\t\treturn \"ctor|\" + constructor + \"|conduit|\" + function + \"|\" + text, nil\n509|\tdefault:\n510|\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n511|\t}\n512|}\n513|\n514|// frameDetail extracts the detail literal from one &frameFault\n515|// composite literal. A non-literal detail is an expr obligation,\n516|// never a silent pass.\n517|func frameDetail(frame *ast.CompositeLit) (string, error) {\n518|\tfor _, element := range frame.Elts {\n519|\t\tpair, ok := element.(*ast.KeyValueExpr)\n520|\t\tif !ok {\n521|\t\t\tcontinue\n522|\t\t}\n523|\t\tkey, ok := pair.Key.(*ast.Ident)\n524|\t\tif !ok || key.Name != \"detail\" {\n525|\t\t\tcontinue\n526|\t\t}\n527|\t\tliteral, ok := pair.Value.(*ast.BasicLit)\n528|\t\tif !ok || literal.Kind != token.STRING {\n529|\t\t\treturn \"expr\", nil\n530|\t\t}\n531|\t\treturn strconv.Unquote(literal.Value)\n532|\t}\n533|\treturn \"\", fmt.Errorf(\"frameFault literal carries no detail\")\n534|}\n535|\n536|// TestConstructorAliasSpellingsFailDerivation replays the four\n537|// alias probes against the derivation gate on synthetic sources:\n538|// a direct constructor call derives cleanly (the control), while\n539|// a package-level `var alias = ctor`, a function-local\n540|// `var alias = ctor`, and an `alias := ctor` all fail the file.\n541|// The package's own `var failX = func...` definition spelling\n542|// stays exempt: only the definition Name is excused, never a\n543|// constructor in value position.\n544|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n545|\tconstructors := map[string]bool{\"failInvalid\": true}\n546|\tderive := func(source string) error {\n547|\t\tt.Helper()\n548|\t\tfileSet := token.NewFileSet()\n549|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n550|\t\tif err != nil {\n551|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n552|\t\t}\n553|\t\treturn collectFileArms(fileSet, syntax, constructors, map[string]struct{}{})\n554|\t}\n555|\tt.Run(\"direct call derives\", func(t *testing.T) {\n556|\t\tif err := derive(\"package probe\\nfunc f() { failInvalid(\\\"planted\\\", \\\"field\\\") }\\n\"); err != nil {\n557|\t\t\tt.Fatalf(\"direct call failed the derivation: %v\", err)\n558|\t\t}\n559|\t})\n560|\tt.Run(\"definition name stays exempt\", func(t *testing.T) {\n561|\t\tif err := derive(\"package probe\\nvar failInvalid = func(detail, field string) (int, error) { return 0, nil }\\n\"); err != nil {\n562|\t\t\tt.Fatalf(\"constructor definition failed the derivation: %v\", err)\n563|\t\t}\n564|\t})\n565|\tfor _, probe := range []struct {\n566|\t\tname   string\n567|\t\tsource string\n568|\t}{\n569|\t\t{\"package level var alias\", \"package probe\\nvar plantedFail = failInvalid\\nfunc f() { plantedFail(\\\"planted\\\", \\\"field\\\") }\\n\"},\n570|\t\t{\"function local var alias\", \"package probe\\nfunc f() { var localFail = failInvalid\\n_ = localFail }\\n\"},\n571|\t\t{\"short declaration alias\", \"package probe\\nfunc f() { localFail := failInvalid\\n_ = localFail }\\n\"},\n572|\t} {\n573|\t\tt.Run(probe.name, func(t *testing.T) {\n574|\t\t\tif err := derive(probe.source); err == nil {\n575|\t\t\t\tt.Fatal(\"aliased constructor passed the derivation with every arm it builds hidden\")\n576|\t\t\t}\n577|\t\t})\n578|\t}\n579|}\n580|\n581|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction:\n582|// every arm derived from production must carry a witness. A\n583|// planted arm (a new literal or site through an existing\n584|// constructor) lands here as an unwitnessed arm.\n585|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n586|\tderived := deriveRefusalArms(t)\n587|\twitnessed := map[string]int{}\n588|\tfor _, witness := range declaredWitnesses(t) {\n589|\t\twitnessed[witness.arm]++\n590|\t}\n591|\tvar missing []string\n592|\tfor arm := range derived {\n593|\t\tif witnessed[arm] == 0 {\n594|\t\t\tmissing = append(missing, arm)\n595|\t\t}\n596|\t}\n597|\tsort.Strings(missing)\n598|\tif len(missing) > 0 {\n599|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n600|\t}\n601|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n602|}\n603|\n604|// TestWitnessedArmsAreAllDerived is the reverse direction: every\n605|// witness must name an arm production declares. A deleted or\n606|// narrowed production branch orphans its witness and fails here,\n607|// which is also what makes a truncated derivation fail instead\n608|// of passing vacuously.\n609|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n610|\tderived := deriveRefusalArms(t)\n611|\tvar orphans []string\n612|\tfor _, witness := range declaredWitnesses(t) {\n613|\t\tif _, ok := derived[witness.arm]; !ok {\n614|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n615|\t\t}\n616|\t}\n617|\tsort.Strings(orphans)\n618|\tif len(orphans) > 0 {\n619|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n620|\t}\n621|}\n622|\n623|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every\n624|// witness through its production entry point and requires the\n625|// attributed refusal.\n626|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n627|\tfor _, witness := range declaredWitnesses(t) {\n628|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n629|\t\t\twitness.prove(t)\n630|\t\t})\n631|\t}\n632|}\n633|\n634|// armWitness is one derived arm plus the test proving it refuses\n635|// at the production entry with the attributed identity.\n636|type armWitness struct {\n637|\tarm   string\n638|\tname  string\n639|\tprove func(t *testing.T)\n640|}\n641|\n642|// declaredWitnesses lists every witness. The group tables live\n643|// in inventory_witnesses_test.go.\n644|func declaredWitnesses(t *testing.T) []armWitness {\n645|\tt.Helper()\n646|\te := witnessFixtureEntries(t)\n647|\twitnesses := []armWitness{}\n648|\twitnesses = append(witnesses, envelopeWitnesses(e)...)\n649|\twitnesses = append(witnesses, manifestWitnesses(e)...)\n650|\twitnesses = append(witnesses, probeWitnesses(e)...)\n651|\twitnesses = append(witnesses, contextWitnesses(e)...)\n652|\twitnesses = append(witnesses, tupleWitnesses(e)...)\n653|\twitnesses = append(witnesses, operationWitnesses(e)...)\n654|\twitnesses = append(witnesses, gateWitnesses(e)...)\n655|\twitnesses = append(witnesses, frameWitnesses(e)...)\n656|\twitnesses = append(witnesses, conduitWitnesses(e)...)\n657|\treturn witnesses\n658|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c83f","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":634,"recorded_at":1780531400001263,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"fd107efa-10c9-4c19-83e3-37620d3abcf1"},"task_id":"fd107efa-10c9-4c19-83e3-37620d3abcf1","event":{"kind":"completed","task_id":"fd107efa-10c9-4c19-83e3-37620d3abcf1"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c841","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":635,"recorded_at":1780531400001265,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"call_id":"call_01a0747786f675a295ca84a4927edc42","text":"Read text file `internal/sessadapter/tuple_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|func mustTime(t *testing.T, value string) time.Time {\n10|\tt.Helper()\n11|\tparsed, err := time.Parse(time.RFC3339, value)\n12|\tif err != nil {\n13|\t\tt.Fatalf(\"mustTime: %v\", err)\n14|\t}\n15|\treturn parsed\n16|}\n17|\n18|func TestDecodeTupleAcceptsFixture(t *testing.T) {\n19|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n20|\tif err != nil {\n21|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n22|\t}\n23|\tif tuple.EnvironmentID != fixtureEnvironmentID || tuple.Platform != \"linux\" || tuple.Architecture != \"amd64\" {\n24|\t\tt.Fatalf(\"DecodeTuple = %+v\", tuple)\n25|\t}\n26|}\n27|\n28|func TestDecodeTupleRefusals(t *testing.T) {\n29|\tfixture := []byte(fixtureTupleJSON())\n30|\tmembers := []string{\"environment_id\", \"environment_version\", \"platform\", \"architecture\", \"store_schema_fingerprint\", \"adapter_version\"}\n31|\tfor _, member := range members {\n32|\t\tt.Run(\"missing \"+member, func(t *testing.T) {\n33|\t\t\t_, err := DecodeTuple(dropMember(t, fixture, member))\n34|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a required member\")\n35|\t\t})\n36|\t}\n37|\tfor _, test := range []struct {\n38|\t\tname   string\n39|\t\tmember string\n40|\t\tvalue  string\n41|\t\ttext   string\n42|\t}{\n43|\t\t{\"bad environment id\", \"environment_id\", `\"Test!\"`, \"not an environment-id\"},\n44|\t\t{\"empty version\", \"environment_version\", `\"\"`, \"not a string[1..128]\"},\n45|\t\t{\"bad platform\", \"platform\", `\"darwin\"`, \"outside linux|macos|windows|wsl2\"},\n46|\t\t{\"v1 darwin is never a tuple platform\", \"platform\", `\"darwin\"`, \"outside linux|macos|windows|wsl2\"},\n47|\t\t{\"bad architecture\", \"architecture\", `\"x86\"`, \"outside amd64|arm64\"},\n48|\t\t{\"bad fingerprint\", \"store_schema_fingerprint\", `\"abc\"`, \"not a digest\"},\n49|\t\t{\"bad adapter version\", \"adapter_version\", `\"1.2\"`, \"not SemVer\"},\n50|\t\t// Executable provenance is refused as an unknown member:\n51|\t\t// the tuple never carries it.\n52|\t\t{\"executable provenance\", \"executable_sha256\", `\"sha256:` + strings.Repeat(\"0\", 64) + `\"`, \"unknown member\"},\n53|\t} {\n54|\t\tt.Run(test.name, func(t *testing.T) {\n55|\t\t\tvar body []byte\n56|\t\t\tif test.member == \"executable_sha256\" {\n57|\t\t\t\tbody = appendMember(t, fixture, test.member, test.value)\n58|\t\t\t} else {\n59|\t\t\t\tbody = mutateMember(t, fixture, test.member, test.value)\n60|\t\t\t}\n61|\t\t\t_, err := DecodeTuple(body)\n62|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.member, test.text)\n63|\t\t})\n64|\t}\n65|\tfor _, platform := range []string{\"linux\", \"macos\", \"windows\", \"wsl2\"} {\n66|\t\tif _, err := DecodeTuple(mutateMember(t, fixture, \"platform\", `\"`+platform+`\"`)); err != nil {\n67|\t\t\tt.Fatalf(\"DecodeTuple(%q): %v\", platform, err)\n68|\t\t}\n69|\t}\n70|}\n71|\n72|func TestDecodeTupleEntryAcceptsBothDirections(t *testing.T) {\n73|\tfor _, direction := range []Direction{DirectionSourceRead, DirectionTargetWrite} {\n74|\t\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(direction)))\n75|\t\tif err != nil {\n76|\t\t\tt.Fatalf(\"DecodeTupleEntry(%q): %v\", direction, err)\n77|\t\t}\n78|\t\tif entry.Key.Direction != direction || entry.Status != \"accepted\" {\n79|\t\t\tt.Fatalf(\"entry = %+v\", entry)\n80|\t\t}\n81|\t\tif direction == DirectionSourceRead && entry.Smoke != nil {\n82|\t\t\tt.Fatal(\"source entry carries smoke\")\n83|\t\t}\n84|\t\tif direction == DirectionTargetWrite && entry.Smoke == nil {\n85|\t\t\tt.Fatal(\"target entry misses smoke\")\n86|\t\t}\n87|\t}\n88|}\n89|\n90|func TestDecodeTupleEntryCoherence(t *testing.T) {\n91|\tfixture := []byte(fixtureEntryJSON(DirectionTargetWrite))\n92|\t// Accepted with revocation members: refused.\n93|\taccepted := mutateMember(t, fixture, \"revocation_reason\", `\"superseded\"`)\n94|\t_, err := DecodeTupleEntry(accepted)\n95|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"status\", \"carries revocation members\")\n96|\t// Revoked without both members: refused in both halves.\n97|\trevoked := mutateMember(t, fixture, \"status\", `\"revoked\"`)\n98|\t_, err = DecodeTupleEntry(revoked)\n99|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"status\", \"misses a revocation member\")\n100|\trevokedHalf := mutateMember(t, mutateMember(t, fixture, \"status\", `\"revoked\"`), \"revocation_reason\", `\"superseded\"`)\n101|\t_, err = DecodeTupleEntry(revokedHalf)\n102|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"status\", \"misses a revocation member\")\n103|\t// Revoked with both members: admitted as revoked (admission\n104|\t// refuses it later; decoding proves shape, not admission).\n105|\trevokedFull := mutateMember(t, mutateMember(t, fixture, \"status\", `\"revoked\"`), \"revocation_reason\", `\"superseded\"`)\n106|\trevokedFull = mutateMember(t, revokedFull, \"revoked_at\", `\"2026-06-02T00:00:00.000Z\"`)\n107|\tentry, err := DecodeTupleEntry(revokedFull)\n108|\tif err != nil {\n109|\t\tt.Fatalf(\"DecodeTupleEntry revoked: %v\", err)\n110|\t}\n111|\tif entry.Status != \"revoked\" || entry.RevocationReason == nil || entry.RevokedAt == nil {\n112|\t\tt.Fatalf(\"revoked entry = %+v\", entry)\n113|\t}\n114|\t// Inverted validity interval: refused.\n115|\tinverted := mutateMember(t, fixture, \"valid_from\", `\"2028-01-01T00:00:00.000Z\"`)\n116|\t_, err = DecodeTupleEntry(inverted)\n117|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"valid_until\", \"does not order\")\n118|\t// Empty strategies: refused. Unknown strategy: refused.\n119|\t// Unsorted strategies: refused.\n120|\tfor _, test := range []struct {\n121|\t\tname  string\n122|\t\tvalue string\n123|\t\ttext  string\n124|\t}{\n125|\t\t{\"empty strategies\", `[]`, \"are empty\"},\n126|\t\t{\"unknown strategy\", `[\"teleport\"]`, \"five-strategy vocabulary\"},\n127|\t\t{\"unsorted strategies\", `[\"target_native_writer\",\"continuation_context\"]`, \"not sorted unique\"},\n128|\t\t{\"duplicate strategies\", `[\"target_native_writer\",\"target_native_writer\"]`, \"not sorted unique\"},\n129|\t} {\n130|\t\tt.Run(test.name, func(t *testing.T) {\n131|\t\t\t_, err := DecodeTupleEntry(mutateMember(t, fixture, \"strategies\", test.value))\n132|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"strategies\", test.text)\n133|\t\t})\n134|\t}\n135|\t// Failing fixture evidence: refused. Zero fixture count:\n136|\t// refused. Failing smoke: refused. Smoke without a passed\n137|\t// turn: refused.\n138|\tfor _, test := range []struct {\n139|\t\tname   string\n140|\t\tmember string\n141|\t\tvalue  string\n142|\t\ttext   string\n143|\t}{\n144|\t\t{\"fixture result fail\", \"fixture_evidence\", `{\"suite_revision\":\"rev-9\",\"suite_digest\":\"` + fixtureSuiteDigest + `\",\"result\":\"fail\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureEvidenceDigest + `\",\"fixture_count\":12}`, \"not pass\"},\n145|\t\t{\"fixture count zero\", \"fixture_evidence\", `{\"suite_revision\":\"rev-9\",\"suite_digest\":\"` + fixtureSuiteDigest + `\",\"result\":\"pass\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureEvidenceDigest + `\",\"fixture_count\":0}`, \"above zero\"},\n146|\t\t{\"smoke result fail\", \"resume_smoke_evidence\", `{\"result\":\"fail\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureSmokeDigest + `\",\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":true}`, \"not pass\"},\n147|\t\t{\"smoke turn failed\", \"resume_smoke_evidence\", `{\"result\":\"pass\",\"executed_at\":\"` + fixtureExecutedAt + `\",\"evidence_digest\":\"` + fixtureSmokeDigest + `\",\"native_cli_family\":\"claude\",\"bounded_continuation_turn_passed\":false}`, \"did not pass\"},\n148|\t\t{\"bad status\", \"status\", `\"pending\"`, \"accepted|revoked\"},\n149|\t} {\n150|\t\tt.Run(test.name, func(t *testing.T) {\n151|\t\t\t_, err := DecodeTupleEntry(mutateMember(t, fixture, test.member, test.value))\n152|\t\t\tif err == nil {\n153|\t\t\t\tt.Fatalf(\"DecodeTupleEntry admitted %s\", test.name)\n154|\t\t\t}\n155|\t\t\tif failureCode(t, err) != \"session_adapter_protocol_error\" {\n156|\t\t\t\tt.Fatalf(\"code = %v, want session_adapter_protocol_error\", err)\n157|\t\t\t}\n158|\t\t\tif !strings.Contains(err.Error(), test.text) {\n159|\t\t\t\tt.Fatalf(\"error = %v, want %q\", err, test.text)\n160|\t\t\t}\n161|\t\t})\n162|\t}\n163|}\n164|\n165|// TestTupleAdmissionValidityBoundaries pins the interval on both\n166|// edges: the instant exactly at valid_from and valid_until\n167|// admits, one second outside refuses on each side. Both edges\n168|// are enforced: a one-sided check would admit the open side.\n169|func TestTupleAdmissionValidityBoundaries(t *testing.T) {\n170|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n173|\t}\n174|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n175|\tif err != nil {\n176|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n177|\t}\n178|\tbinding := fixtureBindingFacts()\n179|\tfor _, test := range []struct {\n180|\t\tname    string\n181|\t\tinstant string\n182|\t\tok      bool\n183|\t}{\n184|\t\t{\"one second before from\", \"2025-12-31T23:59:59.000Z\", false},\n185|\t\t{\"exactly at from\", fixtureValidFrom, true},\n186|\t\t{\"inside\", fixtureCallTime, true},\n187|\t\t{\"exactly at until\", fixtureValidUntil, true},\n188|\t\t{\"one second after until\", \"2027-01-01T00:00:01.000Z\", false},\n189|\t} {\n190|\t\tt.Run(test.name, func(t *testing.T) {\n191|\t\t\terr := CheckTupleAdmission(entry, DirectionTargetWrite, tuple, binding, mustTime(t, test.instant))\n192|\t\t\tif test.ok && err != nil {\n193|\t\t\t\tt.Fatalf(\"CheckTupleAdmission: %v\", err)\n194|\t\t\t}\n195|\t\t\tif !test.ok && err == nil {\n196|\t\t\t\tt.Fatalf(\"CheckTupleAdmission admitted %s\", test.name)\n197|\t\t\t}\n198|\t\t\tif !test.ok {\n199|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"validity interval\")\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|func TestCheckTupleAdmissionRefusals(t *testing.T) {\n206|\tentry, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionTargetWrite)))\n207|\tif err != nil {\n208|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n209|\t}\n210|\ttuple, err := DecodeTuple([]byte(fixtureTupleJSON()))\n211|\tif err != nil {\n212|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n213|\t}\n214|\tbinding := fixtureBindingFacts()\n215|\tnow := mustTime(t, fixtureCallTime)\n216|\totherTuple := tuple\n217|\totherTuple.Version = \"9.9.9\"\n218|\tfor _, test := range []struct {\n219|\t\tname      string\n220|\t\tdirection Direction\n221|\t\ttuple     Tuple\n222|\t\tbinding   BindingFacts\n223|\t\tentry     TupleEntry\n224|\t\ttext      string\n225|\t}{\n226|\t\t{\"direction mismatch\", DirectionSourceRead, tuple, binding, entry, \"direction does not match\"},\n227|\t\t{\"tuple mismatch\", DirectionTargetWrite, otherTuple, binding, entry, \"does not equal the probed tuple\"},\n228|\t\t{\"provider mismatch\", DirectionTargetWrite, tuple, BindingFacts{ProviderID: \"other\", CandidateKind: CandidateBuiltin, ExecutableSHA256: binding.ExecutableSHA256, ProviderManifestDigest: binding.ProviderManifestDigest, AdapterManifestDigest: binding.AdapterManifestDigest}, entry, \"execution binding\"},\n229|\t\t{\"executable mismatch\", DirectionTargetWrite, tuple, BindingFacts{ProviderID: binding.ProviderID, CandidateKind: CandidateBuiltin, ExecutableSHA256: fixtureDigest(\"other-exe\"), ProviderManifestDigest: binding.ProviderManifestDigest, AdapterManifestDigest: binding.AdapterManifestDigest}, entry, \"execution binding\"},\n230|\t\t{\"kind mismatch\", DirectionTargetWrite, tuple, BindingFacts{ProviderID: binding.ProviderID, CandidateKind: CandidateExternal, ExecutableSHA256: binding.ExecutableSHA256, ProviderManifestDigest: binding.ProviderManifestDigest, AdapterManifestDigest: binding.AdapterManifestDigest}, entry, \"execution binding\"},\n231|\t\t{\"revoked entry\", DirectionTargetWrite, tuple, binding, revokedEntry(t), \"not accepted\"},\n232|\t} {\n233|\t\tt.Run(test.name, func(t *testing.T) {\n234|\t\t\terr := CheckTupleAdmission(test.entry, test.direction, test.tuple, test.binding, now)\n235|\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", tuple.EnvironmentID, test.text)\n236|\t\t})\n237|\t}\n238|\t// Source direction against a target entry: refused on\n239|\t// direction before any strategy rule is reached.\n240|\tif err := CheckTupleAdmission(entry, DirectionSourceRead, tuple, binding, now); err == nil {\n241|\t\tt.Fatal(\"admitted a target entry for a source call\")\n242|\t}\n243|\t// Source entry admits a source call and refuses a target call\n244|\t// on direction.\n245|\tsource, err := DecodeTupleEntry([]byte(fixtureEntryJSON(DirectionSourceRead)))\n246|\tif err != nil {\n247|\t\tt.Fatalf(\"DecodeTupleEntry: %v\", err)\n248|\t}\n249|\tif err := CheckTupleAdmission(source, DirectionSourceRead, tuple, binding, now); err != nil {\n250|\t\tt.Fatalf(\"CheckTupleAdmission source: %v\", err)\n251|\t}\n252|\tif err := CheckTupleAdmission(source, DirectionTargetWrite, tuple, binding, now); err == nil {\n253|\t\tt.Fatal(\"admitted a source entry for a target call\")\n254|\t}\n255|\t// A source entry with smoke, or without archive_only, is\n256|\t// refused even in its own direction. A target entry with\n257|\t// archive_only, or without smoke, is refused in its own.\n258|\tsourceWithSmoke := source\n259|\tsmokeTime := mustTime(t, fixtureExecutedAt)\n260|\tsourceWithSmoke.Smoke = &SmokeEvidence{ExecutedAt: smokeTime, EvidenceDigest: fixtureSmokeDigest, NativeCLIFamily: \"claude\"}\n261|\tif err := CheckTupleAdmission(sourceWithSmoke, DirectionSourceRead, tuple, binding, now); err == nil {\n262|\t\tt.Fatal(\"admitted a source entry carrying smoke\")\n263|\t} else {\n264|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"resume smoke\")\n265|\t}\n266|\tsourceWide := source\n267|\tsourceWide.Strategies = []string{\"archive_only\", \"target_native_writer\"}\n268|\tif err := CheckTupleAdmission(sourceWide, DirectionSourceRead, tuple, binding, now); err == nil {\n269|\t\tt.Fatal(\"admitted a source entry beyond archive_only\")\n270|\t}\n271|\ttargetArchive := entry\n272|\ttargetArchive.Strategies = []string{\"archive_only\"}\n273|\ttargetArchive.Smoke = nil\n274|\tif err := CheckTupleAdmission(targetArchive, DirectionTargetWrite, tuple, binding, now); err == nil {\n275|\t\tt.Fatal(\"admitted a target entry with archive_only\")\n276|\t} else {\n277|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"archive_only\")\n278|\t}\n279|\ttargetNoSmoke := entry\n280|\ttargetNoSmoke.Smoke = nil\n281|\tif err := CheckTupleAdmission(targetNoSmoke, DirectionTargetWrite, tuple, binding, now); err == nil {\n282|\t\tt.Fatal(\"admitted a target entry without smoke\")\n283|\t} else {\n284|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"resume smoke\")\n285|\t}\n286|}\n287|\n288|func revokedEntry(t *testing.T) TupleEntry {\n289|\tt.Helper()\n290|\tfixture := []byte(fixtureEntryJSON(DirectionTargetWrite))\n291|\trevoked := mutateMember(t, mutateMember(t, fixture, \"status\", `\"revoked\"`), \"revocation_reason\", `\"superseded\"`)\n292|\trevoked = mutateMember(t, revoked, \"revoked_at\", `\"2026-06-02T00:00:00.000Z\"`)\n293|\tentry, err := DecodeTupleEntry(revoked)\n294|\tif err != nil {\n295|\t\tt.Fatalf(\"DecodeTupleEntry revoked: %v\", err)\n296|\t}\n297|\treturn entry\n298|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c843","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":636,"recorded_at":1780531400001267,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"call_id":"call_01a07477878e79e2bdfc491a99316e5a","text":"Read text file `internal/sessadapter/inventory_test.go`.\n(480 line(s) above)\n481|// callArm derives one constructor arm: a string-literal first\n482|// argument is the detail; a literal-plus-fault.detail binary is a\n483|// conduit keyed by function and prefix; anything else is an\n484|// expr obligation keyed by function.\n485|func callArm(constructor string, call *ast.CallExpr, function string) (string, error) {\n486|\tif len(call.Args) == 0 {\n487|\t\treturn \"\", fmt.Errorf(\"constructor %s called with no arguments in %s\", constructor, function)\n488|\t}\n489|\tswitch first := call.Args[0].(type) {\n490|\tcase *ast.BasicLit:\n491|\t\tif first.Kind != token.STRING {\n492|\t\t\treturn \"\", fmt.Errorf(\"constructor %s first argument is not a string in %s\", constructor, function)\n493|\t\t}\n494|\t\tdetail, err := strconv.Unquote(first.Value)\n495|\t\tif err != nil {\n496|\t\t\treturn \"\", err\n497|\t\t}\n498|\t\treturn \"ctor|\" + constructor + \"|\" + detail, nil\n499|\tcase *ast.BinaryExpr:\n500|\t\tprefix, ok := first.X.(*ast.BasicLit)\n501|\t\tif !ok || prefix.Kind != token.STRING {\n502|\t\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n503|\t\t}\n504|\t\ttext, err := strconv.Unquote(prefix.Value)\n505|\t\tif err != nil {\n506|\t\t\treturn \"\", err\n507|\t\t}\n508|\t\treturn \"ctor|\" + constructor + \"|conduit|\" + function + \"|\" + text, nil\n509|\tdefault:\n510|\t\treturn \"ctor|\" + constructor + \"|expr|\" + function, nil\n511|\t}\n512|}\n513|\n514|// frameDetail extracts the detail literal from one &frameFault\n515|// composite literal. A non-literal detail is an expr obligation,\n516|// never a silent pass.\n517|func frameDetail(frame *ast.CompositeLit) (string, error) {\n518|\tfor _, element := range frame.Elts {\n519|\t\tpair, ok := element.(*ast.KeyValueExpr)\n520|\t\tif !ok {\n521|\t\t\tcontinue\n522|\t\t}\n523|\t\tkey, ok := pair.Key.(*ast.Ident)\n524|\t\tif !ok || key.Name != \"detail\" {\n525|\t\t\tcontinue\n526|\t\t}\n527|\t\tliteral, ok := pair.Value.(*ast.BasicLit)\n528|\t\tif !ok || literal.Kind != token.STRING {\n529|\t\t\treturn \"expr\", nil\n530|\t\t}\n531|\t\treturn strconv.Unquote(literal.Value)\n532|\t}\n533|\treturn \"\", fmt.Errorf(\"frameFault literal carries no detail\")\n534|}\n535|\n536|// TestConstructorAliasSpellingsFailDerivation replays the four\n537|// alias probes against the derivation gate on synthetic sources:\n538|// a direct constructor call derives cleanly (the control), while\n539|// a package-level `var alias = ctor`, a function-local\n540|// `var alias = ctor`, and an `alias := ctor` all fail the file.\n541|// The package's own `var failX = func...` definition spelling\n542|// stays exempt: only the definition Name is excused, never a\n543|// constructor in value position.\n544|func TestConstructorAliasSpellingsFailDerivation(t *testing.T) {\n545|\tconstructors := map[string]bool{\"failInvalid\": true}\n546|\tderive := func(source string) error {\n547|\t\tt.Helper()\n548|\t\tfileSet := token.NewFileSet()\n549|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n550|\t\tif err != nil {\n551|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n552|\t\t}\n553|\t\treturn collectFileArms(fileSet, syntax, constructors, map[string]struct{}{})\n554|\t}\n555|\tt.Run(\"direct call derives\", func(t *testing.T) {\n556|\t\tif err := derive(\"package probe\\nfunc f() { failInvalid(\\\"planted\\\", \\\"field\\\") }\\n\"); err != nil {\n557|\t\t\tt.Fatalf(\"direct call failed the derivation: %v\", err)\n558|\t\t}\n559|\t})\n560|\tt.Run(\"definition name stays exempt\", func(t *testing.T) {\n561|\t\tif err := derive(\"package probe\\nvar failInvalid = func(detail, field string) (int, error) { return 0, nil }\\n\"); err != nil {\n562|\t\t\tt.Fatalf(\"constructor definition failed the derivation: %v\", err)\n563|\t\t}\n564|\t})\n565|\tfor _, probe := range []struct {\n566|\t\tname   string\n567|\t\tsource string\n568|\t}{\n569|\t\t{\"package level var alias\", \"package probe\\nvar plantedFail = failInvalid\\nfunc f() { plantedFail(\\\"planted\\\", \\\"field\\\") }\\n\"},\n570|\t\t{\"function local var alias\", \"package probe\\nfunc f() { var localFail = failInvalid\\n_ = localFail }\\n\"},\n571|\t\t{\"short declaration alias\", \"package probe\\nfunc f() { localFail := failInvalid\\n_ = localFail }\\n\"},\n572|\t} {\n573|\t\tt.Run(probe.name, func(t *testing.T) {\n574|\t\t\tif err := derive(probe.source); err == nil {\n575|\t\t\t\tt.Fatal(\"aliased constructor passed the derivation with every arm it builds hidden\")\n576|\t\t\t}\n577|\t\t})\n578|\t}\n579|}\n580|\n581|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction:\n582|// every arm derived from production must carry a witness. A\n583|// planted arm (a new literal or site through an existing\n584|// constructor) lands here as an unwitnessed arm.\n585|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n586|\tderived := deriveRefusalArms(t)\n587|\twitnessed := map[string]int{}\n588|\tfor _, witness := range declaredWitnesses(t) {\n589|\t\twitnessed[witness.arm]++\n590|\t}\n591|\tvar missing []string\n592|\tfor arm := range derived {\n593|\t\tif witnessed[arm] == 0 {\n594|\t\t\tmissing = append(missing, arm)\n595|\t\t}\n596|\t}\n597|\tsort.Strings(missing)\n598|\tif len(missing) > 0 {\n599|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n600|\t}\n601|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n602|}\n603|\n604|// TestWitnessedArmsAreAllDerived is the reverse direction: every\n605|// witness must name an arm production declares. A deleted or\n606|// narrowed production branch orphans its witness and fails here,\n607|// which is also what makes a truncated derivation fail instead\n608|// of passing vacuously.\n609|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n610|\tderived := deriveRefusalArms(t)\n611|\tvar orphans []string\n612|\tfor _, witness := range declaredWitnesses(t) {\n613|\t\tif _, ok := derived[witness.arm]; !ok {\n614|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n615|\t\t}\n616|\t}\n617|\tsort.Strings(orphans)\n618|\tif len(orphans) > 0 {\n619|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n620|\t}\n621|}\n622|\n623|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every\n624|// witness through its production entry point and requires the\n625|// attributed refusal.\n626|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n627|\tfor _, witness := range declaredWitnesses(t) {\n628|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n629|\t\t\twitness.prove(t)\n630|\t\t})\n631|\t}\n632|}\n633|\n634|// armWitness is one derived arm plus the test proving it refuses\n635|// at the production entry with the attributed identity.\n636|type armWitness struct {\n637|\tarm   string\n638|\tname  string\n639|\tprove func(t *testing.T)\n640|}\n641|\n642|// declaredWitnesses lists every witness. The group tables live\n643|// in inventory_witnesses_test.go.\n644|func declaredWitnesses(t *testing.T) []armWitness {\n645|\tt.Helper()\n646|\te := witnessFixtureEntries(t)\n647|\twitnesses := []armWitness{}\n648|\twitnesses = append(witnesses, envelopeWitnesses(e)...)\n649|\twitnesses = append(witnesses, manifestWitnesses(e)...)\n650|\twitnesses = append(witnesses, probeWitnesses(e)...)\n651|\twitnesses = append(witnesses, contextWitnesses(e)...)\n652|\twitnesses = append(witnesses, tupleWitnesses(e)...)\n653|\twitnesses = append(witnesses, operationWitnesses(e)...)\n654|\twitnesses = append(witnesses, gateWitnesses(e)...)\n655|\twitnesses = append(witnesses, frameWitnesses(e)...)\n656|\twitnesses = append(witnesses, conduitWitnesses(e)...)\n657|\treturn witnesses\n658|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
