{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c873","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":660,"recorded_at":1780531400001315,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"9ed8b237-bf49-4c2f-a5d6-c53d58dcb8fb"},"task_id":"9ed8b237-bf49-4c2f-a5d6-c53d58dcb8fb","event":{"kind":"output","task_id":"9ed8b237-bf49-4c2f-a5d6-c53d58dcb8fb","chunk":"Read text file `internal/sessadapter/tuple.go`.\n(579 line(s) above)\n580|\tif name, unknown := unknownMember(members, fixtureEvidenceMembers); unknown {\n581|\t\tfailure, err := failProtocol(\"tuple fixture evidence carries unknown member\", name)\n582|\t\tif err != nil {\n583|\t\t\treturn FixtureEvidence{}, err\n584|\t\t}\n585|\t\treturn FixtureEvidence{}, failure\n586|\t}\n587|\tif name, missing := missingMember(members, fixtureEvidenceRequired); missing {\n588|\t\tfailure, err := failProtocol(\"tuple fixture evidence misses a required member\", name)\n589|\t\tif err != nil {\n590|\t\t\treturn FixtureEvidence{}, err\n591|\t\t}\n592|\t\treturn FixtureEvidence{}, failure\n593|\t}\n594|\trevision, ok := checkStringBounds(members[\"suite_revision\"], 1, 128)\n595|\tif !ok {\n596|\t\tfailure, err := failProtocol(\"tuple fixture suite revision is not a string[1..128]\", \"suite_revision\")\n597|\t\tif err != nil {\n598|\t\t\treturn FixtureEvidence{}, err\n599|\t\t}\n600|\t\treturn FixtureEvidence{}, failure\n601|\t}\n602|\tsuiteDigest, ok := checkDigest(members[\"suite_digest\"])\n603|\tif !ok {\n604|\t\tfailure, err := failProtocol(\"tuple fixture suite digest is not a digest\", \"suite_digest\")\n605|\t\tif err != nil {\n606|\t\t\treturn FixtureEvidence{}, err\n607|\t\t}\n608|\t\treturn FixtureEvidence{}, failure\n609|\t}\n610|\tif result, ok := rawString(members[\"result\"]); !ok || !validEvidenceResult(result) {\n611|\t\tfailure, err := failProtocol(\"tuple fixture result is not pass\", \"result\")\n612|\t\tif err != nil {\n613|\t\t\treturn FixtureEvidence{}, err\n614|\t\t}\n615|\t\treturn FixtureEvidence{}, failure\n616|\t}\n617|\texecutedAt, ok := checkTimestamp(members[\"executed_at\"])\n618|\tif !ok {\n619|\t\tfailure, err := failProtocol(\"tuple fixture execution time is not a timestamp\", \"executed_at\")\n620|\t\tif err != nil {\n621|\t\t\treturn FixtureEvidence{}, err\n622|\t\t}\n623|\t\treturn FixtureEvidence{}, failure\n624|\t}\n625|\texecuted, err := executedAt.Time()\n626|\tif err != nil {\n627|\t\tfailure, faultErr := failProtocol(\"tuple fixture execution time is not a timestamp\", \"executed_at\")\n628|\t\tif faultErr != nil {\n629|\t\t\treturn FixtureEvidence{}, faultErr\n630|\t\t}\n631|\t\treturn FixtureEvidence{}, failure\n632|\t}\n633|\tevidenceDigest, ok := checkDigest(members[\"evidence_digest\"])\n634|\tif !ok {\n635|\t\tfailure, err := failProtocol(\"tuple fixture evidence digest is not a digest\", \"evidence_digest\")\n636|\t\tif err != nil {\n637|\t\t\treturn FixtureEvidence{}, err\n638|\t\t}\n639|\t\treturn FixtureEvidence{}, failure\n640|\t}\n641|\tcount, ok := checkUint53Bounds(members[\"fixture_count\"], 1, maxUint53)\n642|\tif !ok {\n643|\t\tfailure, err := failProtocol(\"tuple fixture count is not a uint53 above zero\", \"fixture_count\")\n644|\t\tif err != nil {\n645|\t\t\treturn FixtureEvidence{}, err\n646|\t\t}\n647|\t\treturn FixtureEvidence{}, failure\n648|\t}\n649|\treturn FixtureEvidence{\n650|\t\tSuiteRevision:  revision,\n651|\t\tSuiteDigest:    suiteDigest.String(),\n652|\t\tExecutedAt:     executed,\n653|\t\tEvidenceDigest: evidenceDigest.String(),\n654|\t\tFixtureCount:   count,\n655|\t}, nil\n656|}\n657|\n658|// smokeEvidenceMembers is the exact ResumeSmokeEvidence member set.\n659|var smokeEvidenceMembers = map[string]bool{\n660|\t\"result\":                           true,\n661|\t\"executed_at\":                      true,\n662|\t\"evidence_digest\":                  true,\n663|\t\"native_cli_family\":                true,\n664|\t\"bounded_continuation_turn_passed\": true,\n665|}\n666|\n667|// smokeEvidenceRequired lists smokeEvidenceMembers in order.\n668|var smokeEvidenceRequired = []string{\n669|\t\"result\",\n670|\t\"executed_at\",\n671|\t\"evidence_digest\",\n672|\t\"native_cli_family\",\n673|\t\"bounded_continuation_turn_passed\",\n674|}\n675|\n676|// decodeSmokeEvidence validates one closed passing smoke record, or\n677|// reports absence for an explicit null. A missing record and a\n678|// malformed record are different facts: null is absence, anything\n679|// else that does not validate is a protocol error.\n680|func decodeSmokeEvidence(raw json.RawMessage) (*SmokeEvidence, error) {\n681|\tif isNull(raw) {\n682|\t\treturn nil, nil\n683|\t}\n684|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n685|\tif fault != nil {\n686|\t\tfailure, err := failProtocol(\"tuple resume smoke \"+fault.detail, fault.member)\n687|\t\tif err != nil {\n688|\t\t\treturn nil, err\n689|\t\t}\n690|\t\treturn nil, failure\n691|\t}\n692|\tif name, unknown := unknownMember(members, smokeEvidenceMembers); unknown {\n693|\t\tfailure, err := failProtocol(\"tuple resume smoke carries unknown member\", name)\n694|\t\tif err != nil {\n695|\t\t\treturn nil, err\n696|\t\t}\n697|\t\treturn nil, failure\n698|\t}\n699|\tif name, missing := missingMember(members, smokeEvidenceRequired); missing {\n700|\t\tfailure, err := failProtocol(\"tuple resume smoke misses a required member\", name)\n701|\t\tif err != nil {\n702|\t\t\treturn nil, err\n703|\t\t}\n704|\t\treturn nil, failure\n705|\t}\n706|\tif result, ok := rawString(members[\"result\"]); !ok || !validEvidenceResult(result) {\n707|\t\tfailure, err := failProtocol(\"tuple resume smoke result is not pass\", \"result\")\n708|\t\tif err != nil {\n709|\t\t\treturn nil, err\n(more lines below)"}}}
