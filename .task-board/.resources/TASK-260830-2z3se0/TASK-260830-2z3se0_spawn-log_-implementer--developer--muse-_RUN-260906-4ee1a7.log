{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c86f","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":658,"recorded_at":1780531400001311,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"855f06d2-48f6-437a-9e71-7a60fb150cb9"},"task_id":"855f06d2-48f6-437a-9e71-7a60fb150cb9","event":{"kind":"output","task_id":"855f06d2-48f6-437a-9e71-7a60fb150cb9","chunk":"Read text file `internal/sessadapter/tuple.go`.\n(79 line(s) above)\n80|\t}\n81|\tif name, missing := missingMember(members, tupleRequired); missing {\n82|\t\tfailure, err := failProtocol(\"environment tuple misses a required member\", name)\n83|\t\tif err != nil {\n84|\t\t\treturn Tuple{}, err\n85|\t\t}\n86|\t\treturn Tuple{}, failure\n87|\t}\n88|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n89|\tif !ok || !environmentIDPattern.MatchString(environmentID) {\n90|\t\tfailure, err := failProtocol(\"environment tuple environment identifier is not an environment-id\", \"environment_id\")\n91|\t\tif err != nil {\n92|\t\t\treturn Tuple{}, err\n93|\t\t}\n94|\t\treturn Tuple{}, failure\n95|\t}\n96|\tversion, ok := checkStringBounds(members[\"environment_version\"], 1, 128)\n97|\tif !ok {\n98|\t\tfailure, err := failProtocol(\"environment tuple environment version is not a string[1..128]\", \"environment_version\")\n99|\t\tif err != nil {\n100|\t\t\treturn Tuple{}, err\n101|\t\t}\n102|\t\treturn Tuple{}, failure\n103|\t}\n104|\tplatform, ok := rawString(members[\"platform\"])\n105|\tif !ok {\n106|\t\tfailure, err := failProtocol(\"environment tuple platform is not a string\", \"platform\")\n107|\t\tif err != nil {\n108|\t\t\treturn Tuple{}, err\n109|\t\t}\n110|\t\treturn Tuple{}, failure\n111|\t}\n112|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n113|\t\tfailure, faultErr := failProtocol(\"environment tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n114|\t\tif faultErr != nil {\n115|\t\t\treturn Tuple{}, faultErr\n116|\t\t}\n117|\t\treturn Tuple{}, failure\n118|\t}\n119|\tarchitecture, ok := rawString(members[\"architecture\"])\n120|\tif !ok || !validTupleArchitecture(architecture) {\n121|\t\tfailure, err := failProtocol(\"environment tuple architecture is outside amd64|arm64\", \"architecture\")\n122|\t\tif err != nil {\n123|\t\t\treturn Tuple{}, err\n124|\t\t}\n125|\t\treturn Tuple{}, failure\n126|\t}\n127|\tfingerprint, ok := checkDigest(members[\"store_schema_fingerprint\"])\n128|\tif !ok {\n129|\t\tfailure, err := failProtocol(\"environment tuple store fingerprint is not a digest\", \"store_schema_fingerprint\")\n130|\t\tif err != nil {\n131|\t\t\treturn Tuple{}, err\n132|\t\t}\n133|\t\treturn Tuple{}, failure\n134|\t}\n135|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n136|\tif !ok || !semverPattern.MatchString(adapterVersion) {\n137|\t\tfailure, err := failProtocol(\"environment tuple adapter version is not SemVer\", \"adapter_version\")\n138|\t\tif err != nil {\n139|\t\t\treturn Tuple{}, err\n140|\t\t}\n141|\t\treturn Tuple{}, failure\n142|\t}\n143|\treturn Tuple{\n144|\t\tEnvironmentID:    environmentID,\n145|\t\tVersion:          version,\n146|\t\tPlatform:         platform,\n147|\t\tArchitecture:     architecture,\n148|\t\tStoreFingerprint: fingerprint.String(),\n149|\t\tAdapterVersion:   adapterVersion,\n150|\t}, nil\n151|}\n152|\n153|// Direction names one Supported Environment Tuple Registry key\n154|// direction. The registry admits no third direction.\n155|type Direction string\n156|\n157|// The closed direction vocabulary.\n158|const (\n159|\tDirectionSourceRead  Direction = \"source_read\"\n160|\tDirectionTargetWrite Direction = \"target_write\"\n161|)\n162|\n163|// directionNames is the closed direction vocabulary as a table so\n164|// the census derives it like every other closed vocabulary: the\n165|// three direction gates compare through validDirection, never\n166|// through an inline comparison chain the census cannot see. The\n167|// table is built from the constants above, so the two spellings\n168|// cannot drift.\n169|var directionNames = []string{\n170|\tstring(DirectionSourceRead),\n171|\tstring(DirectionTargetWrite),\n172|}\n173|\n174|// validDirection reports whether the name is one of the two closed\n175|// registry directions.\n176|func validDirection(name string) bool {\n177|\tfor _, allowed := range directionNames {\n178|\t\tif name == allowed {\n179|\t\t\treturn true\n180|\t\t}\n181|\t}\n182|\treturn false\n183|}\n184|\n185|// tupleEntryStatuses is the two-status registry-entry vocabulary\n186|// Section 13.14 states: accepted plus revoked. Membership is a\n187|// table loop so the census derives it like every other closed\n188|// vocabulary.\n189|var tupleEntryStatuses = []string{\n190|\t\"accepted\",\n191|\t\"revoked\",\n192|}\n193|\n194|// validTupleEntryStatus reports whether the status is one of the\n195|// two Section 13.14 registry-entry statuses.\n196|func validTupleEntryStatus(status string) bool {\n197|\tfor _, allowed := range tupleEntryStatuses {\n198|\t\tif status == allowed {\n199|\t\t\treturn true\n(more lines below)"}}}
