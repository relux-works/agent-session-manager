|\tidentifier, err := scalar.ParseUUIDv7(value)\n296|\tif err != nil {\n297|\t\treturn scalar.UUIDv7{}, false\n298|\t}\n299|\treturn identifier, true\n300|}\n301|\n302|// checkTimestamp reports whether the member is a pinned timestamp.\n303|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Timestamp{}, false\n307|\t}\n308|\tinstant, err := scalar.ParseTimestamp(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Timestamp{}, false\n311|\t}\n312|\treturn instant, true\n313|}\n314|\n315|// isNull reports whether the member is an explicit JSON null.\n316|func isNull(raw json.RawMessage) bool {\n317|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n318|}\n319|\n320|// decodeArray reads a JSON array member into its raw elements. A\n321|// non-array — including null — is not an empty array.\n322|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n323|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n324|\ttoken, err := decoder.Token()\n325|\tif err != nil {\n326|\t\treturn nil, false\n327|\t}\n328|\tdelim, ok := token.(json.Delim)\n329|\tif !ok || delim != '[' {\n330|\t\treturn nil, false\n331|\t}\n332|\tvar elements []json.RawMessage\n333|\tfor decoder.More() {\n334|\t\tvar element json.RawMessage\n335|\t\tif err := decoder.Decode(&element); err != nil {\n336|\t\t\treturn nil, false\n337|\t\t}\n338|\t\telements = append(elements, element)\n339|\t}\n340|\tif token, err := decoder.Token(); err != nil {\n341|\t\treturn nil, false\n342|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n343|\t\treturn nil, false\n344|\t}\n345|\tif _, err := decoder.Token(); err != io.EOF {\n346|\t\treturn nil, false\n347|\t}\n348|\treturn elements, true\n349|}\n350|\n351|// checkSortedUniqueStrings reports whether the member is an array of\n352|// strings in the item bound whose JCS encodings order strictly\n353|// increasingly with no duplicates. Bytewise JCS order over strings\n354|// is plain lexicographic order, so the check compares directly; the\n355|// count bound is checked on both edges.\n356|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n357|\telements, ok := decodeArray(raw)\n358|\tif !ok {\n359|\t\treturn nil, false\n360|\t}\n361|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n362|\t\treturn nil, false\n363|\t}\n364|\tvalues := make([]string, 0, len(elements))\n365|\tfor _, element := range elements {\n366|\t\tvalue, ok := rawString(element)\n367|\t\tif !ok {\n368|\t\t\treturn nil, false\n369|\t\t}\n370|\t\tlength := stringLength(value)\n371|\t\tif length < minimumLength || length > maximumLength {\n372|\t\t\treturn nil, false\n373|\t\t}\n374|\t\tvalues = append(values, value)\n375|\t}\n376|\tfor index := 1; index < len(values); index++ {\n377|\t\tif values[index-1] >= values[index] {\n378|\t\t\treturn nil, false\n379|\t\t}\n380|\t}\n381|\treturn values, true\n382|}\n383|\n384|// checkSortedUniqueDigests reports whether the member is a sorted\n385|// unique digest array in the count bound.\n386|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n387|\telements, ok := decodeArray(raw)\n388|\tif !ok {\n389|\t\treturn nil, false\n390|\t}\n391|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n392|\t\treturn nil, false\n393|\t}\n394|\tvalues := make([]scalar.Digest, 0, len(elements))\n395|\tfor _, element := range elements {\n396|\t\tdigest, ok := checkDigest(element)\n397|\t\tif !ok {\n398|\t\t\treturn nil, false\n399|\t\t}\n400|\t\tvalues = append(values, digest)\n401|\t}\n402|\tfor index := 1; index < len(values); index++ {\n403|\t\tif values[index-1].String() >= values[index].String() {\n404|\t\t\treturn nil, false\n405|\t\t}\n406|\t}\n407|\treturn values, true\n408|}\n409|\n410|// semverPattern