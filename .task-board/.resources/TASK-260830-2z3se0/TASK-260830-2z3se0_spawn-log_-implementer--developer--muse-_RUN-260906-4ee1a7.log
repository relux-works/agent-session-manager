{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"call_id":"call_01a07476f7027363aa51c115150d2f13","text":"Read text file `internal/sessadapter/operations.go`.\n(579 line(s) above)\n580|\t\t\treturn err\n581|\t\t}\n582|\t\treturn failure\n583|\t}\n584|\tif len(members) == 0 {\n585|\t\tfailure, err := failProtocol(\"projection required dispositions carry no class\", \"required_dispositions\")\n586|\t\tif err != nil {\n587|\t\t\treturn err\n588|\t\t}\n589|\t\treturn failure\n590|\t}\n591|\tfor class, value := range members {\n592|\t\telements, ok := decodeArray(bytesTrimSpace(value))\n593|\t\tif !ok || len(elements) == 0 || len(elements) > 7 {\n594|\t\t\tfailure, err := failProtocol(\"projection disposition list is not 1..7 entries\", class)\n595|\t\t\tif err != nil {\n596|\t\t\t\treturn err\n597|\t\t\t}\n598|\t\t\treturn failure\n599|\t\t}\n600|\t\tprevious := \"\"\n601|\t\tfor _, element := range elements {\n602|\t\t\tdisposition, ok := rawString(element)\n603|\t\t\tif !ok || !validDisposition(disposition) {\n604|\t\t\t\tfailure, err := failProtocol(\"projection disposition is outside the seven-disposition vocabulary\", class)\n605|\t\t\t\tif err != nil {\n606|\t\t\t\t\treturn err\n607|\t\t\t\t}\n608|\t\t\t\treturn failure\n609|\t\t\t}\n610|\t\t\tif previous >= disposition && previous != \"\" {\n611|\t\t\t\tfailure, err := failProtocol(\"projection dispositions are not sorted unique\", class)\n612|\t\t\t\tif err != nil {\n613|\t\t\t\t\treturn err\n614|\t\t\t\t}\n615|\t\t\t\treturn failure\n616|\t\t\t}\n617|\t\t\tprevious = disposition\n618|\t\t}\n619|\t}\n620|\treturn nil\n621|}\n622|\n623|// checkValidateNullability enforces the validate mode rule on\n624|// request bodies: archive requires all four target members null,\n625|// staged and live require them non-null. Success bodies carry no\n626|// target members at all (the pinned Section 7.8 validate success\n627|// list names none), so the rule never applies there; checkValidateResult\n628|// does not call it.\n629|func checkValidateNullability(members map[string]json.RawMessage) error {\n630|\tmode, _ := rawString(members[\"mode\"])\n631|\ttargets := []string{\"projection_plan_id\", \"projected_object_manifest_id\", \"read_back_evidence_manifest_id\", \"expected_target_native_session_id\"}\n632|\tif mode == \"archive\" {\n633|\t\tfor _, name := range targets {\n634|\t\t\tif !isNull(members[name]) {\n635|\t\t\t\tfailure, err := failProtocol(\"validate archive mode carries a target member\", name)\n636|\t\t\t\tif err != nil {\n637|\t\t\t\t\treturn err\n638|\t\t\t\t}\n639|\t\t\t\treturn failure\n640|\t\t\t}\n641|\t\t}\n642|\t\treturn nil\n643|\t}\n644|\tfor _, name := range targets {\n645|\t\tif isNull(members[name]) {\n646|\t\t\tfailure, err := failProtocol(\"validate staged/live mode misses a target member\", name)\n647|\t\t\tif err != nil {\n648|\t\t\t\treturn err\n649|\t\t\t}\n650|\t\t\treturn failure\n651|\t\t}\n652|\t}\n653|\treturn nil\n654|}\n655|\n656|// SuccessFacts are the request-side facts one success body is\n657|// checked against: the sent context for the byte-for-byte echo,\n658|// the validate request mode for the mode pairing, the resume-plan\n659|// expected native identifier for the identity occurrence, and the\n660|// doctor request direction for the direction pairing. Unused\n661|// members stay zero for other operations.\n662|type SuccessFacts struct {\n663|\tContext         CallContext\n664|\tValidateMode    string\n665|\tResumeTargetID  string\n666|\tDoctorDirection Direction\n667|}\n668|\n669|// CheckSuccessBody validates one inbound success body for its\n670|// operation: the exact member set, the byte-for-byte context\n671|// echo, and the semantic gates Section 7.8 states per operation.\n672|// Manifest, probe, and doctor successes decode through their\n673|// dedicated decoders. An unknown operation is operation_unknown.\n674|func CheckSuccessBody(operation Operation, body []byte, facts SuccessFacts) error {\n675|\tif !validOperation(string(operation)) {\n676|\t\tfailure, err := failUnknownOperation(\"success body names an operation outside the closed registry\", string(operation))\n677|\t\tif err != nil {\n678|\t\t\treturn err\n679|\t\t}\n680|\t\treturn failure\n681|\t}\n682|\tswitch operation {\n683|\tcase OpManifest:\n684|\t\t_, err := DecodeManifest(body)\n685|\t\treturn err\n686|\tcase OpProbe:\n687|\t\t_, err := DecodeProbe(body)\n688|\t\treturn err\n689|\tcase OpDoctor:\n690|\t\t_, err := DecodeDoctorResult(body, facts.Context, facts.DoctorDirection)\n691|\t\treturn err\n692|\t}\n693|\tmembers, fault := decodeStrictObject(body)\n694|\tif fault != nil {\n695|\t\tfailure, err := failProtocol(\"success body \"+fault.detail, fault.member)\n696|\t\tif err != nil {\n697|\t\t\treturn err\n698|\t\t}\n699|\t\treturn failure\n700|\t}\n701|\tallowed := successMemberSet(operation)\n702|\tif name, unknown := unknownMember(members, allowed); unknown {\n703|\t\tfailure, err := failProtocol(\"success body carries unknown member\", name)\n704|\t\tif err != nil {\n705|\t\t\treturn err\n706|\t\t}\n707|\t\treturn failure\n708|\t}\n709|\tif name, missing := missingMember(members, successBodyMembers[operation]); missing {\n710|\t\tfailure, err := failProtocol(\"success body misses a required member\", name)\n711|\t\tif err != nil {\n712|\t\t\treturn err\n713|\t\t}\n714|\t\treturn failure\n715|\t}\n716|\tif _, err := CheckContextEcho(facts.Context, members[\"context\"]); err != nil {\n717|\t\treturn err\n718|\t}\n719|\tif err := checkSuccessScalars(operation, members, facts); err != nil {\n720|\t\treturn err\n721|\t}\n722|\tif !checkExtensions(members[\"extensions\"]) {\n723|\t\tfailure, err := failProtocol(\"success body extensions are not reverse-DNS keyed\", \"extensions\")\n724|\t\tif err != nil {\n725|\t\t\treturn err\n726|\t\t}\n727|\t\treturn failure\n728|\t}\n729|\treturn nil\n730|}\n731|\n732|// checkSuccessScalars validates the inline members of one success\n733|// body plus the semantic gates.\n734|func checkSuccessScalars(operation Operation, members map[string]json.RawMessage, facts SuccessFacts) error {\n735|\tswitch operation {\n736|\tcase OpDiscover:\n737|\t\tif _, err := checkDiscoverSources(members[\"sources\"]); err != nil {\n738|\t\t\treturn err\n739|\t\t}\n740|\t\tpartial, err := requireBool(members, \"partial\")\n741|\t\tif err != nil {\n742|\t\t\treturn err\n743|\t\t}\n744|\t\tcursorNull := isNull(members[\"next_cursor\"])\n745|\t\tif !cursorNull {\n746|\t\t\tif err := requireStringBounds(members, \"next_cursor\", 1, 1024); err != nil {\n747|\t\t\t\treturn err\n748|\t\t\t}\n749|\t\t}\n750|\t\t// partial=false iff next_cursor is null: a complete page\n751|\t\t// carries no cursor, and a cursor always means more.\n752|\t\tif partial == cursorNull {\n753|\t\t\tfailure, err := failProtocol(\"discover partial flag disagrees with the cursor\", \"partial\")\n754|\t\t\tif err != nil {\n755|\t\t\t\treturn err\n756|\t\t\t}\n757|\t\t\treturn failure\n758|\t\t}\n759|\tcase OpInspect:\n760|\t\tif err := requireNestedObject(members, \"source\"); err != nil {\n761|\t\t\treturn err\n762|\t\t}\n763|\t\tif err := requireNestedObject(members, \"source_identity\"); err != nil {\n764|\t\t\treturn err\n765|\t\t}\n766|\t\tif err := requireStringBounds(members, \"source_store_generation\", 1, 512); err != nil {\n767|\t\t\treturn err\n768|\t\t}\n769|\t\tif _, err := DecodeTuple(members[\"environment\"]); err != nil {\n770|\t\t\treturn err\n771|\t\t}\n772|\t\tif _, err := DecodeFindings(members[\"ambiguities\"], 1024); err != nil {\n773|\t\t\treturn err\n774|\t\t}\n775|\tcase OpSnapshotProof:\n776|\t\tif err := requireNestedObject(members, \"proof\"); err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := requireBool(members, \"provider_quiescence_requested\"); err != nil {\n780|\t\t\treturn err\n781|\t\t}\n782|\t\tif _, err := requireBool(members, \"provider_quiescence_observed\"); err != nil {\n783|\t\t\treturn err\n784|\t\t}\n785|\tcase OpCapturePlan:\n786|\t\tif err := requireNestedObject(members, \"source_identity\"); err != nil {\n787|\t\t\treturn err\n788|\t\t}\n789|\t\tif err := requireStringBounds(members, \"source_store_generation\", 1, 512); err != nil {\n790|\t\t\treturn err\n791|\t\t}\n792|\t\tcandidate, err := requireDigestValue(members, \"capture_plan_candidate_id\")\n793|\t\tif err != nil {\n794|\t\t\treturn err\n795|\t\t}\n796|\t\tif err := requireUint53Bounds(members, \"candidate_count\", 0, 65536); err != nil {\n797|\t\t\treturn err\n798|\t\t}\n799|\t\tif err := checkExcludedClasses(members[\"excluded_classes\"]); err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tdigest, err := requireDigestValue(members, \"capture_plan_digest\")\n803|\t\tif err != nil {\n804|\t\t\treturn err\n805|\t\t}\n806|\t\t// The two candidate digests are equal after core rehash:\n807|\t\t// the candidate identifier addresses the plan object the\n808|\t\t// digest seals, so a success carrying two different\n809|\t\t// digests answers for an object it cannot name.\n810|\t\tif candidate != digest {\n811|\t\t\tfailure, err := failProtocol(\"capture plan candidate identifier does not equal the plan digest\", \"capture_plan_digest\")\n812|\t\t\tif err != nil {\n813|\t\t\t\treturn err\n814|\t\t\t}\n815|\t\t\treturn failure\n816|\t\t}\n817|\tcase OpCapture:\n818|\t\tif err := requireDigest(members, \"capture_plan_digest\"); err != nil {\n819|\t\t\treturn err\n820|\t\t}\n821|\t\tif err := requireStringBounds(members, \"source_store_generation\", 1, 512); err != nil {\n822|\t\t\treturn err\n823|\t\t}\n824|\t\tif err := requireDigest(members, \"capture_result_candidate_id\"); err != nil {\n825|\t\t\treturn err\n826|\t\t}\n827|\t\tif err := requireDigest(members, \"source_raw_object_manifest_candidate_id\"); err != nil {\n828|\t\t\treturn err\n829|\t\t}\n830|\t\tif err := requireUint53Bounds(members, \"item_count\", 0, 65536); err != nil {\n831|\t\t\treturn err\n832|\t\t}\n833|\t\tif err := requireDigest(members, \"pre_capture_digest\"); err != nil {\n834|\t\t\treturn err\n835|\t\t}\n836|\t\tif err := requireDigest(members, \"post_capture_digest\"); err != nil {\n837|\t\t\treturn err\n838|\t\t}\n839|\tcase OpNormalize:\n840|\t\tif err := requireDigest(members, \"capture_manifest_id\"); err != nil {\n841|\t\t\treturn err\n842|\t\t}\n843|\t\tif err := requireDigest(members, \"canonical_session_candidate_id\"); err != nil {\n844|\t\t\treturn err\n845|\t\t}\n846|\t\tif _, ok := checkSortedUniqueDigests(members[\"canonical_event_candidate_ids\"], 0, 65536); !ok {\n847|\t\t\tfailure, faultErr := failProtocol(\"normalize canonical event identifiers are not sorted unique digest[0..65536]\", \"canonical_event_candidate_ids\")\n848|\t\t\tif faultErr != nil {\n849|\t\t\t\treturn faultErr\n850|\t\t\t}\n851|\t\t\treturn failure\n852|\t\t}\n853|\t\tif _, ok := checkSortedUniqueDigests(members[\"raw_reference_ids\"], 0, 65536); !ok {\n854|\t\t\tfailure, faultErr := failProtocol(\"normalize raw references are not sorted unique digest[0..65536]\", \"raw_reference_ids\")\n855|\t\t\tif faultErr != nil {\n856|\t\t\t\treturn faultErr\n857|\t\t\t}\n858|\t\t\treturn failure\n859|\t\t}\n860|\tcase OpProjectionPlan:\n861|\t\tif err := requireDigest(members, \"projection_plan_candidate_id\"); err != nil {\n862|\t\t\treturn err\n863|\t\t}\n864|\t\tif _, ok := checkSortedUniqueDigests(members[\"required_source_object_ids\"], 0, 65536); !ok {\n865|\t\t\tfailure, faultErr := failProtocol(\"projection required source objects are not sorted unique digest[0..65536]\", \"required_source_object_ids\")\n866|\t\t\tif faultErr != nil {\n867|\t\t\t\treturn faultErr\n868|\t\t\t}\n869|\t\t\treturn failure\n870|\t\t}\n871|\t\tif err := requireNestedObject(members, \"predicted_counts\"); err != nil {\n872|\t\t\treturn err\n873|\t\t}\n874|\t\tif _, err := DecodeFindings(members[\"findings\"], 4096); err != nil {\n875|\t\t\treturn err\n876|\t\t}\n877|\tcase OpProject:\n878|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n879|\t\t\treturn err\n880|\t\t}\n881|\t\tif err := requireDigest(members, \"projected_object_manifest_candidate_id\"); err != nil {\n882|\t\t\treturn err\n883|\t\t}\n884|\t\tif _, ok := checkSortedUniqueStrings(members[\"created_resource_keys\"], 1, 512, 0, 65536); !ok {\n885|\t\t\tfailure, err := failProtocol(\"project created resource keys are not sorted unique string[1..512][0..65536]\", \"created_resource_keys\")\n886|\t\t\tif err != nil {\n887|\t\t\t\treturn err\n888|\t\t\t}\n889|\t\t\treturn failure\n890|\t\t}\n891|\t\tif err := requireNestedObject(members, \"actual_counts\"); err != nil {\n892|\t\t\treturn err\n893|\t\t}\n894|\tcase OpReadBack:\n895|\t\tif err := requireStringBounds(members, \"observed_target_native_session_id\", 1, 512); err != nil {\n896|\t\t\treturn err\n897|\t\t}\n898|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n899|\t\t\treturn err\n900|\t\t}\n901|\t\tif _, err := DecodeTuple(members[\"observed_environment\"]); err != nil {\n902|\t\t\treturn err\n903|\t\t}\n904|\t\tif err := requireUint53Bounds(members, \"parsed_event_count\", 0, maxUint53); err != nil {\n905|\t\t\treturn err\n906|\t\t}\n907|\t\tif _, ok := checkSortedUniqueStrings(members[\"parsed_head_ids\"], 1, 512, 0, 1024); !ok {\n908|\t\t\tfailure, err := failProtocol(\"read-back head identifiers are not sorted unique string[1..512][0..1024]\", \"parsed_head_ids\")\n909|\t\t\tif err != nil {\n910|\t\t\t\treturn err\n911|\t\t\t}\n912|\t\t\treturn failure\n913|\t\t}\n914|\t\tif err := requireNestedObject(members, \"workspace_binding\"); err != nil {\n915|\t\t\treturn err\n916|\t\t}\n917|\t\tif err := requireDigest(members, \"structural_digest\"); err != nil {\n918|\t\t\treturn err\n919|\t\t}\n920|\t\tif err := requireDigest(members, \"read_back_evidence_manifest_candidate_id\"); err != nil {\n921|\t\t\treturn err\n922|\t\t}\n923|\tcase OpValidate:\n924|\t\treturn checkValidateResult(members, facts)\n925|\tcase OpResumePlan:\n926|\t\tif err := requireStringBounds(members, \"target_native_session_id\", 1, 512); err != nil {\n927|\t\t\treturn err\n928|\t\t}\n929|\t\tif err := requireDigest(members, \"projection_plan_id\"); err != nil {\n930|\t\t\treturn err\n931|\t\t}\n932|\t\targv, ok := decodeArray(bytesTrimSpace(members[\"argv\"]))\n933|\t\tif !ok || len(argv) == 0 || len(argv) > 128 {\n934|\t\t\tfailure, err := failProtocol(\"resume-plan argv is not 1..128 entries\", \"argv\")\n935|\t\t\tif err != nil {\n936|\t\t\t\treturn err\n937|\t\t\t}\n938|\t\t\treturn failure\n939|\t\t}\n940|\t\toccurrences := 0\n941|\t\tfor _, element := range argv {\n942|\t\t\tword, ok := checkStringBounds(element, 1, 4096)\n943|\t\t\tif !ok {\n944|\t\t\t\tfailure, err := failProtocol(\"resume-plan argv word is not a string[1..4096]\", \"argv\")\n945|\t\t\t\tif err != nil {\n946|\t\t\t\t\treturn err\n947|\t\t\t\t}\n948|\t\t\t\treturn failure\n949|\t\t\t}\n950|\t\t\tif word == facts.ResumeTargetID {\n951|\t\t\t\toccurrences++\n952|\t\t\t}\n953|\t\t}\n954|\t\t// The explicit identity occurs exactly once: zero leaves\n955|\t\t// the resume unbound, two or more leave it ambiguous.\n956|\t\tif occurrences != 1 {\n957|\t\t\tfailure, err := failProtocol(\"resume-plan argv does not carry the explicit identity exactly once\", \"argv\")\n958|\t\t\tif err != nil {\n959|\t\t\t\treturn err\n960|\t\t\t}\n961|\t\t\treturn failure\n962|\t\t}\n963|\t\tif err := requireStringBounds(members, \"cwd_relative\", 1, 4096); err != nil {\n964|\t\t\treturn err\n965|\t\t}\n966|\t\tif _, ok := checkSortedUniqueStrings(members[\"environment_names\"], 1, 256, 0, 128); !ok {\n967|\t\t\tfailure, err := failProtocol(\"resume-plan environment names are not sorted unique string[1..256][0..128]\", \"environment_names\")\n968|\t\t\tif err != nil {\n969|\t\t\t\treturn err\n970|\t\t\t}\n971|\t\t\treturn failure\n972|\t\t}\n973|\t\topens, err := requireBool(members, \"opens_existing_identity\")\n974|\t\tif err != nil {\n975|\t\t\treturn err\n976|\t\t}\n977|\t\tif !opens {\n978|\t\t\tfailure, err := failProtocol(\"resume-plan does not open the existing identity\", \"opens_existing_identity\")\n979|\t\t\tif err != nil {\n980|\t\t\t\treturn err\n981|\t\t\t}\n982|\t\t\treturn failure\n983|\t\t}\n984|\t}\n985|\treturn nil\n986|}\n987|\n988|// requireDigestValue requires the member to be a digest and\n989|// returns its canonical text. Its detail is distinct from\n990|// requireDigest's: the two helpers are separate refusal\n991|// obligations, so the inventory sees each.\n992|func requireDigestValue(members map[string]json.RawMessage, name string) (string, error) {\n993|\tdigest, ok := checkDigest(members[name])\n994|\tif !ok {\n995|\t\tfailure, err := failProtocol(\"operation body digest value is not a digest\", name)\n996|\t\tif err != nil {\n997|\t\t\treturn \"\", err\n998|\t\t}\n999|\t\treturn \"\", failure\n1000|\t}\n1001|\treturn digest.String(), nil\n1002|}\n1003|\n1004|// checkDiscoverSources validates the discover sources array:\n1005|// 0..65536 present objects. Content owned by Section 13.14\n1006|// (CloneSourceSummary) validates for presence only.\n1007|func checkDiscoverSources(raw json.RawMessage) ([]json.RawMessage, error) {\n1008|\telements, ok := decodeArray(bytesTrimSpace(raw))\n1009|\tif !ok {\n1010|\t\tfailure, err := failProtocol(\"discover sources are not an array\", \"sources\")\n1011|\t\tif err != nil {\n1012|\t\t\treturn nil, err\n1013|\t\t}\n1014|\t\treturn nil, failure\n1015|\t}\n1016|\tif uint64(len(elements)) > 65536 {\n1017|\t\tfailure, err := failProtocol(\"discover sources exceed 65536 entries\", \"sources\")\n1018|\t\tif err != nil {\n1019|\t\t\treturn nil, err\n1020|\t\t}\n1021|\t\treturn nil, failure\n1022|\t}\n1023|\tfor _, element := range elements {\n1024|\t\tif _, fault := decodeStrictObject(bytesTrimSpace(element)); fault != nil {\n1025|\t\t\tfailure, err := failProtocol(\"discover source entry \"+fault.detail, \"sources\")\n1026|\t\t\tif err != nil {\n1027|\t\t\t\treturn nil, err\n1028|\t\t\t}\n1029|\t\t\treturn nil, failure\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
