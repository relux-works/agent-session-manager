{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c807","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":606,"recorded_at":1780531400001207,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"0a35df6a-4ecd-4024-b43d-2e932875ad3e"},"task_id":"0a35df6a-4ecd-4024-b43d-2e932875ad3e","event":{"kind":"output","task_id":"0a35df6a-4ecd-4024-b43d-2e932875ad3e","chunk":"Read text file `internal/sessadapter/context_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|// fixtureRequestWithDigest builds a discover request body whose\n11|// context carries the digest of the body itself: the fixpoint the\n12|// host computes (digest over the body with request_digest\n13|// omitted, then written in). The context names the given adapter\n14|// manifest digest so the body binds to a real sealed binding.\n15|func fixtureRequestWithDigest(t *testing.T, manifestDigest string) []byte {\n16|\tt.Helper()\n17|\tcontextWith := func(requestDigest string) string {\n18|\t\treturn fmt.Sprintf(`{\"operation_id\":%q,\"provider_id\":%q,\"environment\":%s,\"session_adapter_manifest_digest\":%q,\"executable_sha256\":%q,\"request_digest\":%q,\"extensions\":{}}`,\n19|\t\t\tfixtureOperationID, fixtureProviderID, fixtureTupleJSON(), manifestDigest, fixtureExecutableDigest, requestDigest)\n20|\t}\n21|\tskeleton := fmt.Sprintf(`{\"context\":%s,\"authority\":%s,\"workspace_filter\":null,\"limit\":50,\"cursor\":null,\"extensions\":{}}`,\n22|\t\tcontextWith(\"sha256:\"+strings.Repeat(\"0\", 64)), fixtureReadAuthorityJSON())\n23|\tdigest, err := RequestDigestFor([]byte(skeleton))\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"RequestDigestFor: %v\", err)\n26|\t}\n27|\treturn []byte(fmt.Sprintf(`{\"context\":%s,\"authority\":%s,\"workspace_filter\":null,\"limit\":50,\"cursor\":null,\"extensions\":{}}`,\n28|\t\tcontextWith(digest.String()), fixtureReadAuthorityJSON()))\n29|}\n30|\n31|// fixtureManifestDigestText decodes the fixture manifest and returns\n32|// its host-computed digest text.\n33|func fixtureManifestDigestText(t *testing.T) string {\n34|\tt.Helper()\n35|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n38|\t}\n39|\treturn ManifestDigest(manifest).String()\n40|}\n41|\n42|func TestRequestDigestFixpoint(t *testing.T) {\n43|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n44|\tcontext, err := CheckRequestBody(OpDiscover, body)\n45|\tif err != nil {\n46|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n47|\t}\n48|\t// The digest verifies against the sent bytes: writing the\n49|\t// digest into the context did not change the digest, because\n50|\t// the digested form omits that member.\n51|\tif err := VerifyRequestDigest(context, body); err != nil {\n52|\t\tt.Fatalf(\"VerifyRequestDigest: %v\", err)\n53|\t}\n54|\t// A one-byte change anywhere else breaks the binding.\n55|\tmutated := mutateMember(t, body, \"limit\", `51`)\n56|\tif err := VerifyRequestDigest(context, mutated); err == nil {\n57|\t\tt.Fatal(\"VerifyRequestDigest admitted a changed body under a replayed context\")\n58|\t} else {\n59|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"request_digest\", \"does not match\")\n60|\t}\n61|\t// The digest is deterministic: the same canonical body\n62|\t// digests identically across calls.\n63|\tagain, err := RequestDigestFor(body)\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"RequestDigestFor: %v\", err)\n66|\t}\n67|\tif again.String() != context.RequestDigest {\n68|\t\tt.Fatal(\"request digest is not deterministic\")\n69|\t}\n70|}\n71|\n72|func TestVerifyRequestDigestOmitsOnlyItsMember(t *testing.T) {\n73|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n74|\tcontext, err := CheckRequestBody(OpDiscover, body)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n77|\t}\n78|\t// Changing the operation_id changes the digest: the omission\n79|\t// covers only request_digest, not its neighbours.\n80|\tmutated := []byte(strings.Replace(string(body), fixtureOperationID, \"0198f4c8-8e50-7f66-8f70-1234567890aa\", 1))\n81|\tif err := VerifyRequestDigest(context, mutated); err == nil {\n82|\t\tt.Fatal(\"VerifyRequestDigest admitted a body with a different operation_id\")\n83|\t}\n84|}\n85|\n86|func TestCheckContextEcho(t *testing.T) {\n87|\tbody := fixtureRequestWithDigest(t, fixtureDigest(\"test-adapter-manifest\"))\n88|\tsent, err := CheckRequestBody(OpDiscover, body)\n89|\tif err != nil {\n90|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n91|\t}\n92|\t// Byte-identical echo passes.\n93|\techoed, err := CheckContextEcho(sent, rawMember(t, body, \"context\"))\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"CheckContextEcho: %v\", err)\n96|\t}\n97|\tif echoed.OperationID != sent.OperationID {\n98|\t\tt.Fatal(\"echoed context lost the operation identifier\")\n99|\t}\n100|\t// A re-serialized context with a changed value fails at the\n101|\t// echo: decode accepts the valid shape, and only byte\n102|\t// identity proves the adapter answered this call.\n103|\taltered := mutateMember(t, rawMember(t, body, \"context\"), \"provider_id\", `\"other-provider\"`)\n104|\tif _, err := CheckContextEcho(sent, altered); err == nil {\n105|\t\tt.Fatal(\"CheckContextEcho admitted a context for another provider\")\n106|\t} else {\n107|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"context\", \"byte-for-byte\")\n108|\t}\n109|\t// A same-length forgery — one flipped hex digit in the\n110|\t// operation identifier, still a valid UUIDv7 — fails at the\n111|\t// echo too. A length-only comparison admits it, so this case\n112|\t// pins the byte-for-byte half of the gate, not just the\n113|\t// length half.\n114|\tsameLength := []byte(strings.Replace(string(rawMember(t, body, \"context\")), fixtureOperationID, \"0198f4c8-8e50-7f66-8f70-1234567890ad\", 1))\n115|\tif len(sameLength) != len(rawMember(t, body, \"context\")) {\n116|\t\tt.Fatal(\"same-length forgery changed length; the probe is broken, not the gate\")\n117|\t}\n118|\tif _, err := DecodeCallContext(sameLength); err != nil {\n119|\t\tt.Fatalf(\"same-length forgery is not a valid context: %v\", err)\n120|\t}\n121|\tif _, err := CheckContextEcho(sent, sameLength); err == nil {\n122|\t\tt.Fatal(\"CheckContextEcho admitted a same-length rebuilt context\")\n123|\t} else {\n124|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"context\", \"byte-for-byte\")\n125|\t}\n126|\t// A malformed context fails at decode, before the echo.\n127|\tmalformed := mutateMember(t, rawMember(t, body, \"context\"), \"provider_id\", `\"Other Provider\"`)\n128|\tif _, err := CheckContextEcho(sent, malformed); err == nil {\n129|\t\tt.Fatal(\"CheckContextEcho admitted a malformed context\")\n130|\t} else {\n131|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"not a provider-id\")\n132|\t}\n133|}\n134|\n135|// rawMember extracts one top-level member's raw bytes.\n136|func rawMember(t *testing.T, body []byte, member string) []byte {\n137|\tt.Helper()\n138|\tvar members map[string]json.RawMessage\n139|\tif err := json.Unmarshal(body, &members); err != nil {\n140|\t\tt.Fatalf(\"rawMember: %v\", err)\n141|\t}\n142|\traw, present := members[member]\n143|\tif !present {\n144|\t\tt.Fatalf(\"rawMember: %q not in body\", member)\n145|\t}\n146|\treturn raw\n147|}\n148|\n149|func TestDecodeCallContextRules(t *testing.T) {\n150|\tvalid := fixtureContextJSON(fixtureDigest(\"req\"))\n151|\tif _, err := DecodeCallContext([]byte(valid)); err != nil {\n152|\t\tt.Fatalf(\"DecodeCallContext: %v\", err)\n153|\t}\n154|\tfor _, test := range []struct {\n155|\t\tname   string\n156|\t\tmember string\n157|\t\tvalue  string\n158|\t\ttext   string\n159|\t}{\n160|\t\t{\"bad operation id\", \"operation_id\", `\"not-a-uuid\"`, \"not a UUIDv7\"},\n161|\t\t{\"bad provider id\", \"provider_id\", `\"Test\"`, \"not a provider-id\"},\n162|\t\t{\"bad manifest digest\", \"session_adapter_manifest_digest\", `\"nope\"`, \"not a digest\"},\n163|\t\t{\"bad executable digest\", \"executable_sha256\", `\"nope\"`, \"not a digest\"},\n164|\t\t{\"bad request digest\", \"request_digest\", `\"nope\"`, \"not a digest\"},\n165|\t\t{\"bad extensions\", \"extensions\", `{\"x\":\"y\"}`, \"not reverse-DNS keyed\"},\n166|\t} {\n167|\t\tt.Run(test.name, func(t *testing.T) {\n168|\t\t\t_, err := DecodeCallContext(mutateMember(t, []byte(valid), test.member, test.value))\n169|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.member, test.text)\n170|\t\t})\n171|\t}\n172|\tt.Run(\"missing member\", func(t *testing.T) {\n173|\t\t_, err := DecodeCallContext(dropMember(t, []byte(valid), \"environment\"))\n174|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"environment\", \"misses a required member\")\n175|\t})\n176|\tt.Run(\"unknown member\", func(t *testing.T) {\n177|\t\t_, err := DecodeCallContext(appendMember(t, []byte(valid), \"unexpected\", `1`))\n178|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"unexpected\", \"unknown member\")\n179|\t})\n180|}\n181|\n182|func TestDecodeReadAuthorityRules(t *testing.T) {\n183|\tvalid := fixtureReadAuthorityJSON()\n184|\tif _, err := DecodeReadAuthority([]byte(valid)); err != nil {\n185|\t\tt.Fatalf(\"DecodeReadAuthority: %v\", err)\n186|\t}\n187|\tfor _, purpose := range []string{\"source_native\", \"target_staged\", \"target_live\"} {\n188|\t\tif _, err := DecodeReadAuthority(mutateMember(t, []byte(valid), \"purpose\", `\"`+purpose+`\"`)); err != nil {\n189|\t\t\tt.Fatalf(\"DecodeReadAuthority(%q): %v\", purpose, err)\n190|\t\t}\n191|\t}\n192|\tfor _, test := range []struct {\n193|\t\tname   string\n194|\t\tmember string\n195|\t\tvalue  string\n196|\t\ttext   string\n197|\t}{\n198|\t\t{\"bad purpose\", \"purpose\", `\"live_store\"`, \"outside source_native|target_staged|target_live\"},\n199|\t\t{\"empty handles\", \"root_handle_names\", `[]`, \"not sorted unique\"},\n200|\t\t{\"unsorted handles\", \"root_handle_names\", `[\"b\",\"a\"]`, \"not sorted unique\"},\n201|\t\t{\"duplicate handles\", \"root_handle_names\", `[\"a\",\"a\"]`, \"not sorted unique\"},\n202|\t\t{\"empty handle\", \"root_handle_names\", `[\"\"]`, \"not sorted unique\"},\n203|\t\t{\"bad authority id\", \"authority_id\", `\"x\"`, \"not a UUIDv7\"},\n204|\t\t{\"bad expiry\", \"expires_at\", `\"never\"`, \"not a timestamp\"},\n205|\t} {\n206|\t\tt.Run(test.name, func(t *testing.T) {\n207|\t\t\t_, err := DecodeReadAuthority(mutateMember(t, []byte(valid), test.member, test.value))\n208|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.member, test.text)\n209|\t\t})\n210|\t}\n211|}\n212|\n213|func TestDecodeObjectAuthorityRules(t *testing.T) {\n214|\tfor _, purpose := range []string{\"capture_plan\", \"raw_source\", \"canonical_source\", \"projection_plan\", \"projected_target\", \"read_back_evidence\"} {\n215|\t\tif _, err := DecodeObjectAuthority([]byte(fixtureFreshSinkJSON(purpose))); err != nil {\n216|\t\t\tt.Fatalf(\"DecodeObjectAuthority(%q): %v\", purpose, err)\n217|\t\t}\n218|\t}\n219|\tvalid := fixtureFreshSinkJSON(\"capture_plan\")\n220|\tfor _, test := range []struct {\n221|\t\tname       string\n222|\t\tmember     string\n223|\t\tvalue      string\n224|\t\twantMember string\n225|\t\ttext       string\n226|\t}{\n227|\t\t{\"bad purpose\", \"purpose\", `\"live_store\"`, \"purpose\", \"six-purpose vocabulary\"},\n228|\t\t{\"bad mode\", \"mode\", `\"append\"`, \"mode\", \"outside read|fresh_sink\"},\n229|\t\t{\"zero objects on fresh sink\", \"max_objects\", `0`, \"mode\", \"both limits above zero\"},\n230|\t\t{\"zero bytes on fresh sink\", \"max_total_bytes\", `0`, \"mode\", \"both limits above zero\"},\n231|\t} {\n232|\t\tt.Run(test.name, func(t *testing.T) {\n233|\t\t\t_, err := DecodeObjectAuthority(mutateMember(t, []byte(valid), test.member, test.value))\n234|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.wantMember, test.text)\n235|\t\t})\n236|\t}\n237|\t// Read mode exposes only request-named objects: zero limits\n238|\t// are admissible there because the authority grants no sink.\n239|\tread := mutateMember(t, []byte(valid), \"mode\", `\"read\"`)\n240|\tread = mutateMember(t, read, \"max_objects\", `0`)\n241|\tif _, err := DecodeObjectAuthority(read); err != nil {\n242|\t\tt.Fatalf(\"DecodeObjectAuthority read with zero objects: %v\", err)\n243|\t}\n244|\t// The fresh sink must be empty: a reused sink under a\n245|\t// fresh_sink authority is refused, and read mode takes no\n246|\t// sink claim either way.\n247|\tauthority, err := DecodeObjectAuthority([]byte(valid))\n248|\tif err != nil {\n249|\t\tt.Fatalf(\"DecodeObjectAuthority: %v\", err)\n250|\t}\n251|\tif err := CheckFreshSink(authority, true); err != nil {\n252|\t\tt.Fatalf(\"CheckFreshSink empty: %v\", err)\n253|\t}\n254|\terr = CheckFreshSink(authority, false)\n255|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"mode\", \"not empty\")\n256|\treadAuthority, err := DecodeObjectAuthority(read)\n257|\tif err != nil {\n258|\t\tt.Fatalf(\"DecodeObjectAuthority: %v\", err)\n259|\t}\n260|\tif err := CheckFreshSink(readAuthority, false); err != nil {\n261|\t\tt.Fatalf(\"CheckFreshSink read mode: %v\", err)\n262|\t}\n263|}\n264|\n265|// TestDecodeSourceSelectorComplement drives the complete domain:\n266|// zero, one, two, and three non-null members. Exactly one admits;\n267|// every other count refuses. There is no fifth case to sample.\n268|func TestDecodeSourceSelectorComplement(t *testing.T) {\n269|\tbase := `{\"native_session_id\":null,\"logical_workspace_id\":null,\"opaque_source_ref\":null}`\n270|\tcases := []struct {\n271|\t\tname  string\n272|\t\tbody  string\n273|\t\tcount int\n274|\t}{\n275|\t\t{\"none\", base, 0},\n276|\t\t{\"native only\", `{\"native_session_id\":\"sess-1\",\"logical_workspace_id\":null,\"opaque_source_ref\":null}`, 1},\n277|\t\t{\"workspace only\", `{\"native_session_id\":null,\"logical_workspace_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"opaque_source_ref\":null}`, 1},\n278|\t\t{\"opaque only\", `{\"native_session_id\":null,\"logical_workspace_id\":null,\"opaque_source_ref\":\"ref-1\"}`, 1},\n279|\t\t{\"native plus workspace\", `{\"native_session_id\":\"sess-1\",\"logical_workspace_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"opaque_source_ref\":null}`, 2},\n280|\t\t{\"native plus opaque\", `{\"native_session_id\":\"sess-1\",\"logical_workspace_id\":null,\"opaque_source_ref\":\"ref-1\"}`, 2},\n281|\t\t{\"workspace plus opaque\", `{\"native_session_id\":null,\"logical_workspace_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"opaque_source_ref\":\"ref-1\"}`, 2},\n282|\t\t{\"all three\", `{\"native_session_id\":\"sess-1\",\"logical_workspace_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"opaque_source_ref\":\"ref-1\"}`, 3},\n283|\t}\n284|\tfor _, test := range cases {\n285|\t\tt.Run(test.name, func(t *testing.T) {\n286|\t\t\tselector, err := DecodeSourceSelector([]byte(test.body))\n287|\t\t\tif test.count == 1 {\n288|\t\t\t\tif err != nil {\n289|\t\t\t\t\tt.Fatalf(\"DecodeSourceSelector: %v\", err)\n290|\t\t\t\t}\n291|\t\t\t\tnamed := 0\n292|\t\t\t\tif selector.NativeSessionID != nil {\n293|\t\t\t\t\tnamed++\n294|\t\t\t\t}\n295|\t\t\t\tif selector.LogicalWorkspaceID != nil {\n296|\t\t\t\t\tnamed++\n297|\t\t\t\t}\n298|\t\t\t\tif selector.OpaqueSourceRef != nil {\n299|\t\t\t\t\tnamed++\n300|\t\t\t\t}\n301|\t\t\t\tif named != 1 {\n302|\t\t\t\t\tt.Fatalf(\"selector names %d sources, want 1\", named)\n303|\t\t\t\t}\n304|\t\t\t\treturn\n305|\t\t\t}\n306|\t\t\tif err == nil {\n307|\t\t\t\tt.Fatalf(\"DecodeSourceSelector admitted %d sources\", test.count)\n308|\t\t\t}\n309|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"native_session_id\", \"exactly one source\")\n310|\t\t})\n311|\t}\n312|\t// Malformed members refuse with the member named: an empty\n313|\t// native ID and a non-UUID workspace ID.\n314|\tif _, err := DecodeSourceSelector([]byte(`{\"native_session_id\":\"\",\"logical_workspace_id\":null,\"opaque_source_ref\":null}`)); err == nil {\n315|\t\tt.Fatal(\"admitted an empty native session identifier\")\n316|\t} else {\n317|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"native_session_id\", \"string[1..512]\")\n318|\t}\n319|\tif _, err := DecodeSourceSelector([]byte(`{\"native_session_id\":null,\"logical_workspace_id\":\"nope\",\"opaque_source_ref\":null}`)); err == nil {\n320|\t\tt.Fatal(\"admitted a non-UUID workspace identifier\")\n321|\t} else {\n322|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"logical_workspace_id\", \"not a UUIDv7\")\n323|\t}\n324|}\n325|\n326|// TestDecodeResourceLimitsBounds sweeps every numeric bound on\n327|// both edges: below-minimum, minimum, maximum, above-maximum.\n328|// The vectors are generated, not listed, and the per-item rule is\n329|// attacked from both directions.\n330|func TestDecodeResourceLimitsBounds(t *testing.T) {\n331|\tvalid := func() string {\n332|\t\treturn `{\"max_objects\":10,\"max_total_bytes\":1000,\"max_single_object_bytes\":100,\"max_events\":5,\"max_target_resources\":5}`\n333|\t}\n334|\tif _, err := DecodeResourceLimits([]byte(valid())); err != nil {\n335|\t\tt.Fatalf(\"DecodeResourceLimits: %v\", err)\n336|\t}\n337|\tbounds := []struct {\n338|\t\tmember  string\n339|\t\tminimum uint64\n340|\t\tmaximum uint64\n341|\t\tcurrent uint64\n342|\t}{\n343|\t\t{\"max_objects\", 1, 9007199254740991, 10},\n344|\t\t{\"max_total_bytes\", 1, 9007199254740991, 1000},\n345|\t\t{\"max_single_object_bytes\", 1, 9007199254740991, 100},\n346|\t\t{\"max_events\", 0, 65536, 5},\n347|\t\t{\"max_target_resources\", 0, 65536, 5},\n348|\t}\n349|\tsetMember := func(body, member string, value uint64) []byte {\n350|\t\treturn mutateMember(t, []byte(body), member, fmt.Sprintf(`%d`, value))\n351|\t}\n352|\tfor _, bound := range bounds {\n353|\t\tfor _, test := range []struct {\n354|\t\t\tname  string\n355|\t\t\tvalue uint64\n356|\t\t\tok    bool\n357|\t\t}{\n358|\t\t\t{\"below minimum\", bound.minimum - 1, false},\n359|\t\t\t{\"minimum\", bound.minimum, true},\n360|\t\t\t{\"maximum\", bound.maximum, true},\n361|\t\t\t{\"above maximum\", bound.maximum + 1, false},\n362|\t\t} {\n363|\t\t\t// Skip the underflow case: minimum 0 has no\n364|\t\t\t// below-minimum uint53.\n365|\t\t\tif bound.minimum == 0 && test.name == \"below minimum\" {\n366|\t\t\t\tcontinue\n367|\t\t\t}\n368|\t\t\tt.Run(bound.member+\" \"+test.name, func(t *testing.T) {\n369|\t\t\t\tbody := valid()\n370|\t\t\t\t// Keep the per-item/total coherence while\n371|\t\t\t\t// sweeping: raise the total when the\n372|\t\t\t\t// swept member would otherwise exceed it.\n373|\t\t\t\tif (bound.member == \"max_objects\" || bound.member == \"max_single_object_bytes\") && test.value > 1000 {\n374|\t\t\t\t\tbody = string(setMember(body, \"max_total_bytes\", test.value))\n375|\t\t\t\t}\n376|\t\t\t\tif bound.member == \"max_total_bytes\" && test.value < 100 {\n377|\t\t\t\t\tbody = string(setMember(body, \"max_single_object_bytes\", test.value))\n378|\t\t\t\t\tbody = string(setMember(body, \"max_objects\", minU64(test.value, 10)))\n379|\t\t\t\t}\n380|\t\t\t\t_, err := DecodeResourceLimits(setMember(body, bound.member, test.value))\n381|\t\t\t\tif test.ok && err != nil {\n382|\t\t\t\t\tt.Fatalf(\"DecodeResourceLimits: %v\", err)\n383|\t\t\t\t}\n384|\t\t\t\tif !test.ok && err == nil {\n385|\t\t\t\t\tt.Fatalf(\"DecodeResourceLimits admitted %s=%d\", bound.member, test.value)\n386|\t\t\t\t}\n387|\t\t\t})\n388|\t\t}\n389|\t}\n390|\t// Non-integral numbers are not uint53 even at the same\n391|\t// magnitude.\n392|\tfor _, literal := range []string{`10.0`, `\"10\"`, `1e2`, `-1`, `true`, `null`} {\n393|\t\t_, err := DecodeResourceLimits(mutateMember(t, []byte(valid()), \"max_objects\", literal))\n394|\t\tif err == nil {\n395|\t\t\tt.Fatalf(\"DecodeResourceLimits admitted max_objects=%s\", literal)\n396|\t\t}\n397|\t}\n398|\t// The per-item rule fails in both directions: a single-object\n399|\t// maximum above the total, and an object count above the\n400|\t// total, each refuse.\n401|\t_, err := DecodeResourceLimits([]byte(`{\"max_objects\":10,\"max_total_bytes\":100,\"max_single_object_bytes\":101,\"max_events\":0,\"max_target_resources\":0}`))\n402|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"max_single_object_bytes\", \"exceeds the total\")\n403|\t_, err = DecodeResourceLimits([]byte(`{\"max_objects\":101,\"max_total_bytes\":100,\"max_single_object_bytes\":100,\"max_events\":0,\"max_target_resources\":0}`))\n404|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"max_objects\", \"exceeds the total\")\n405|}\n406|\n407|func minU64(a, b uint64) uint64 {\n408|\tif a < b {\n409|\t\treturn a\n410|\t}\n411|\treturn b\n412|}\n413|\n414|func TestDecodeFindingRules(t *testing.T) {\n415|\tvalid := `{\"severity\":\"warning\",\"code\":\"cap-1\",\"message\":\"a warning\",\"remediation\":null,\"extensions\":{}}`\n416|\tif _, err := DecodeFinding([]byte(valid)); err != nil {\n417|\t\tt.Fatalf(\"DecodeFinding: %v\", err)\n418|\t}\n419|\tfor _, severity := range []string{\"info\", \"warning\", \"error\"} {\n420|\t\tif _, err := DecodeFinding(mutateMember(t, []byte(valid), \"severity\", `\"`+severity+`\"`)); err != nil {\n421|\t\t\tt.Fatalf(\"DecodeFinding(%q): %v\", severity, err)\n422|\t\t}\n423|\t}\n424|\tfor _, test := range []struct {\n425|\t\tname   string\n426|\t\tmember string\n427|\t\tvalue  string\n428|\t\ttext   string\n429|\t}{\n430|\t\t{\"bad severity\", \"severity\", `\"fatal\"`, \"outside info|warning|error\"},\n431|\t\t{\"empty code\", \"code\", `\"\"`, \"not a string[1..128]\"},\n432|\t\t{\"empty message\", \"message\", `\"\"`, \"not a string[1..4096]\"},\n433|\t\t{\"empty remediation\", \"remediation\", `\"\"`, \"not a string[1..4096]\"},\n434|\t} {\n435|\t\tt.Run(test.name, func(t *testing.T) {\n436|\t\t\t_, err := DecodeFinding(mutateMember(t, []byte(valid), test.member, test.value))\n437|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", test.member, test.text)\n438|\t\t})\n439|\t}\n440|\tif _, err := DecodeFinding(mutateMember(t, []byte(valid), \"remediation\", `\"restart the source\"`)); err != nil {\n441|\t\tt.Fatalf(\"DecodeFinding with remediation: %v\", err)\n442|\t}\n443|\tif _, err := DecodeFindings([]byte(`[`+valid+`,`+valid+`]`), 4096); err != nil {\n444|\t\tt.Fatalf(\"DecodeFindings: %v\", err)\n445|\t}\n446|\tif _, err := DecodeFindings([]byte(`[`+valid+`]`), 0); err == nil {\n447|\t\tt.Fatal(\"DecodeFindings admitted an entry above the count bound\")\n448|\t}\n449|}\n450|\n451|func TestDecodeCapturePlanItemRules(t *testing.T) {\n452|\tvalid := `{\"native_item_key\":\"item-1\",\"class\":\"durable_payload\",\"byte_count\":12,\"required\":true,\"extensions\":{}}`\n453|\tif _, err := DecodeCapturePlanItem([]byte(valid)); err != nil {\n454|\t\tt.Fatalf(\"DecodeCapturePlanItem: %v\", err)\n455|\t}\n456|\t// All nine classes admit; a tenth does not.\n457|\tfor _, class := range captureClasses {\n458|\t\tif _, err := DecodeCapturePlanItem(mutateMember(t, []byte(valid), \"class\", `\"`+class+`\"`)); err != nil {\n459|\t\t\tt.Fatalf(\"DecodeCapturePlanItem(%q): %v\", class, err)\n460|\t\t}\n461|\t}\n462|\t_, err := DecodeCapturePlanItem(mutateMember(t, []byte(valid), \"class\", `\"archive_only\"`))\n463|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"class\", \"nine-class vocabulary\")\n464|\tif _, err := DecodeCapturePlanItem(mutateMember(t, []byte(valid), \"byte_count\", `null`)); err != nil {\n465|\t\tt.Fatalf(\"DecodeCapturePlanItem null byte count: %v\", err)\n466|\t}\n467|}"}}}
