{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71f","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":490,"recorded_at":1780531400000975,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"7e9d7825-a22d-46b1-ad9d-c8fbffacdfff"},"task_id":"7e9d7825-a22d-46b1-ad9d-c8fbffacdfff","event":{"kind":"output","task_id":"7e9d7825-a22d-46b1-ad9d-c8fbffacdfff","chunk":"Read text file `internal/sessadapter/census_test.go`.\n(998 line(s) above)\n999|\tsort.Strings(wantSuccessSet)\n1000|\tif strings.Join(wantSuccessSet, \",\") != strings.Join(memberSetKeys(successMembers), \",\") {\n1001|\t\tt.Errorf(\"success members = %v, want derived %v\", memberSetKeys(successMembers), wantSuccessSet)\n1002|\t}\n1003|\twantFailure := append(append([]string(nil), firstFour...), \"ok\", \"error\")\n1004|\tif strings.Join(wantFailure, \",\") != strings.Join(failureRequired, \",\") {\n1005|\t\tt.Errorf(\"failure required = %v, want %v\", failureRequired, wantFailure)\n1006|\t}\n1007|\tmapComparisons++\n1008|\twantFailureSet := append([]string(nil), wantFailure...)\n1009|\tsort.Strings(wantFailureSet)\n1010|\tif strings.Join(wantFailureSet, \",\") != strings.Join(memberSetKeys(failureMembers), \",\") {\n1011|\t\tt.Errorf(\"failure members = %v, want derived %v\", memberSetKeys(failureMembers), wantFailureSet)\n1012|\t}\n1013|\t// The manifest member column comes from its own table, not a\n1014|\t// sentence: parse the first-column code spans in the table\n1015|\t// window. The local is named derivedManifest so it cannot\n1016|\t// shadow the production manifestMembers gate map the\n1017|\t// comparison below must read.\n1018|\tderivedManifest := deriveManifestTableMembers(t, text)\n1019|\tif strings.Join(derivedManifest, \",\") != strings.Join(manifestRequired, \",\") {\n1020|\t\tt.Errorf(\"manifest required = %v, want derived %v\", manifestRequired, derivedManifest)\n1021|\t}\n1022|\tmapComparisons++\n1023|\tderivedManifestSet := append([]string(nil), derivedManifest...)\n1024|\tsort.Strings(derivedManifestSet)\n1025|\tif strings.Join(derivedManifestSet, \",\") != strings.Join(memberSetKeys(manifestMembers), \",\") {\n1026|\t\tt.Errorf(\"manifest members = %v, want derived %v\", memberSetKeys(manifestMembers), derivedManifestSet)\n1027|\t}\n1028|\t// The doctor result members come from the operation table\n1029|\t// like every other success body.\n1030|\t_, _, successes := deriveOperationTable(t)\n1031|\tdoctor, ok := successes[string(OpDoctor)]\n1032|\tif !ok {\n1033|\t\tt.Fatal(\"derived no doctor success body from the operation table\")\n1034|\t}\n1035|\tif strings.Join(doctor, \",\") != strings.Join(doctorResultRequired, \",\") {\n1036|\t\tt.Errorf(\"doctor required = %v, want derived %v\", doctorResultRequired, doctor)\n1037|\t}\n1038|\tmapComparisons++\n1039|\tdoctorSet := append([]string(nil), doctor...)\n1040|\tsort.Strings(doctorSet)\n1041|\tif strings.Join(doctorSet, \",\") != strings.Join(memberSetKeys(doctorResultMembers), \",\") {\n1042|\t\tt.Errorf(\"doctor members = %v, want derived %v\", memberSetKeys(doctorResultMembers), doctorSet)\n1043|\t}\n1044|\tt.Logf(\"member-set census: %d member maps pinned across %d bodies\", mapComparisons, len(ordered)+4)\n1045|}\n1046|\n1047|// deriveManifestTableMembers parses the Session Adapter Manifest\n1048|// member column from its table window: rows starting with\n1049|// \"| <code>\" contribute their first-column name in order.\n1050|func deriveManifestTableMembers(t *testing.T, text string) []string {\n1051|\tt.Helper()\n1052|\ttable, ok := sectionTableWindow(text, \"Session Adapter Manifest 1.0.0 is closed and contains exactly:\", \"Session Adapter Probe 1.0.0 is closed and contains exactly\")\n1053|\tif !ok {\n1054|\t\tt.Fatal(\"manifest table window not found\")\n1055|\t}\n1056|\tvar members []string\n1057|\tfor _, line := range strings.Split(table, \"\\n\") {\n1058|\t\tif !strings.HasPrefix(line, \"| <code>\") {\n1059|\t\t\tcontinue\n1060|\t\t}\n1061|\t\tcells := splitTableCells(line)\n1062|\t\tif len(cells) < 2 {\n1063|\t\t\tcontinue\n1064|\t\t}\n1065|\t\t// The first cell carries one member per code span: three\n1066|\t\t// rows pair two members with a slash (schema /\n1067|\t\t// schema_version, display_name / adapter_version,\n1068|\t\t// operations / capability_names). Every span that is a\n1069|\t\t// bare snake_case name is a member, in order.\n1070|\t\tcell := cells[1]\n1071|\t\tfor {\n1072|\t\t\topen := strings.Index(cell, \"<code>\")\n1073|\t\t\tif open < 0 {\n1074|\t\t\t\tbreak\n1075|\t\t\t}\n1076|\t\t\tcell = cell[open+len(\"<code>\"):]\n1077|\t\t\tclose := strings.Index(cell, \"</code>\")\n1078|\t\t\tif close < 0 {\n1079|\t\t\t\tt.Fatal(\"unbalanced code span in the manifest table\")\n1080|\t\t\t}\n1081|\t\t\tname := cell[:close]\n1082|\t\t\tcell = cell[close+len(\"</code>\"):]\n1083|\t\t\tsnake := len(name) > 0\n1084|\t\t\tfor _, character := range name {\n1085|\t\t\t\tif character != '_' && (character < 'a' || character > 'z') && (character < '0' || character > '9') {\n1086|\t\t\t\t\tsnake = false\n1087|\t\t\t\t\tbreak\n1088|\t\t\t\t}\n1089|\t\t\t}\n1090|\t\t\tif snake {\n1091|\t\t\t\tmembers = append(members, name)\n1092|\t\t\t}\n1093|\t\t}\n1094|\t}\n1095|\tif len(members) == 0 {\n1096|\t\tt.Fatal(\"derived no manifest members; the parser is broken\")\n1097|\t}\n1098|\treturn members\n1099|}\n1100|\n1101|// TestValueVocabulariesMatchSpec pins every semantic vocabulary\n1102|// against its verbatim spec union as a set. Order is not\n1103|// normative for these sets — sortedness governs instances, not\n1104|// the listing — so both sides sort before comparing. The\n1105|// operation and capability registries are order-normative and\n1106|// are pinned in order instead.\n1107|func TestValueVocabulariesMatchSpec(t *testing.T) {\n1108|\tif _, err := specdoc.Load(); err != nil {\n1109|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n1110|\t}\n1111|\ttext := string(specdoc.Bytes())\n1112|\t// normalizeUnionPipes collapses the three pipe encodings the\n1113|\t// pinned document uses inside unions: escaped pipes in the\n1114|\t// operation table, raw pipes in prose, and HTML entities in\n1115|\t// the manifest table.\n1116|\tnormalizeUnionPipes := func(raw string) []string {\n1117|\t\traw = strings.ReplaceAll(raw, \"&#124;\", \"|\")\n1118|\t\traw = strings.ReplaceAll(raw, \"\\\\|\", \"|\")\n1119|\t\tvar values []string\n1120|\t\tfor _, value := range strings.Split(raw, \"|\") {\n1121|\t\t\tif value == \"\" {\n1122|\t\t\t\tcontinue\n1123|\t\t\t}\n1124|\t\t\tvalues = append(values, value)\n1125|\t\t}\n1126|\t\treturn values\n1127|\t}\n1128|\t// firstSpanUnion takes the union in the first code span after\n1129|\t// a prose marker. A leading member-name prefix on the first\n1130|\t// element is stripped: the union starts after it.\n1131|\tfirstSpanUnion := func(t *testing.T, marker string) []string {\n1132|\t\tt.Helper()\n1133|\t\tindex := strings.Index(text, marker)\n1134|\t\tif index < 0 {\n1135|\t\t\tt.Fatalf(\"spec union %q not found\", marker)\n1136|\t\t}\n1137|\t\trest := text[index+len(marker):]\n1138|\t\topen := strings.Index(rest, \"<code>\")\n1139|\t\tif open < 0 {\n1140|\t\t\tt.Fatalf(\"no code span after %q\", marker)\n1141|\t\t}\n1142|\t\trest = rest[open+len(\"<code>\"):]\n1143|\t\tclose := strings.Index(rest, \"</code>\")\n1144|\t\tif close < 0 {\n1145|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n1146|\t\t}\n1147|\t\tvalues := normalizeUnionPipes(rest[:close])\n1148|\t\tif len(values) == 0 {\n1149|\t\t\tt.Fatalf(\"empty union after %q\", marker)\n1150|\t\t}\n1151|\t\tif prefix := strings.IndexAny(values[0], \":=\"); prefix >= 0 {\n1152|\t\t\tvalues[0] = values[0][prefix+1:]\n1153|\t\t}\n1154|\t\treturn values\n1155|\t}\n1156|\t// unionAfter takes the union starting exactly at the end of\n1157|\t// the marker: the marker already names the sentence and the\n1158|\t// member prefix, so nothing is consumed from the union and\n1159|\t// nothing is stripped. This is the anchored form for unions\n1160|\t// whose bare member name collides with an unrelated earlier\n1161|\t// span in the document.\n1162|\tunionAfter := func(t *testing.T, marker string) []string {\n1163|\t\tt.Helper()\n1164|\t\tindex := strings.Index(text, marker)\n1165|\t\tif index < 0 {\n1166|\t\t\tt.Fatalf(\"spec union %q not found\", marker)\n1167|\t\t}\n1168|\t\trest := text[index+len(marker):]\n1169|\t\tclose := strings.Index(rest, \"</code>\")\n1170|\t\tif close < 0 {\n1171|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n1172|\t\t}\n1173|\t\tvalues := normalizeUnionPipes(rest[:close])\n1174|\t\tif len(values) == 0 {\n1175|\t\t\tt.Fatalf(\"empty union after %q\", marker)\n1176|\t\t}\n1177|\t\treturn values\n1178|\t}\n1179|\t// rowInlineUnion takes an inline member union from one\n1180|\t// operation-table row: the first line starting with the row\n1181|\t// marker, the union after the member prefix up to the next\n1182|\t// comma or closing brace. The scan is windowed to the Section\n1183|\t// 7.8 registry table because the probe name recurs in the\n1184|\t// Terminal Backend, Provider Probe, and Directory Node tables\n1185|\t// with different vocabularies.\n1186|\trowInlineUnion := func(t *testing.T, row, prefix string) []string {\n1187|\t\tt.Helper()\n1188|\t\ttable, ok := sectionTableWindow(text, \"The exact request and success <code>body</code> registry is:\", \"Candidate objects are addressed only by their exact\")\n1189|\t\tif !ok {\n1190|\t\t\tt.Fatal(\"Section 7.8 registry table window not found\")\n1191|\t\t}\n1192|\t\tvar line string\n1193|\t\tfor _, candidate := range strings.Split(table, \"\\n\") {\n1194|\t\t\tif strings.HasPrefix(candidate, row) {\n1195|\t\t\t\tline = candidate\n1196|\t\t\t\tbreak\n1197|\t\t\t}\n1198|\t\t}\n1199|\t\tif line == \"\" {\n1200|\t\t\tt.Fatalf(\"spec row %q not found\", row)\n1201|\t\t}\n1202|\t\tindex := strings.Index(line, prefix)\n1203|\t\tif index < 0 {\n1204|\t\t\tt.Fatalf(\"spec member %q not found in row %q\", prefix, row)\n1205|\t\t}\n1206|\t\trest := line[index+len(prefix):]\n1207|\t\tend := strings.IndexAny(rest, \",}\")\n1208|\t\tif end < 0 {\n1209|\t\t\tt.Fatalf(\"unterminated union in row %q\", row)\n1210|\t\t}\n1211|\t\tvalues := normalizeUnionPipes(rest[:end])\n1212|\t\tif len(values) == 0 {\n1213|\t\t\tt.Fatalf(\"empty union in row %q\", row)\n1214|\t\t}\n1215|\t\treturn values\n1216|\t}\n1217|\tsetEqual := func(t *testing.T, name string, got []string, want []string) {\n1218|\t\tt.Helper()\n1219|\t\tsortedGot := append([]string(nil), got...)\n1220|\t\tsortedWant := append([]string(nil), want...)\n1221|\t\tsort.Strings(sortedGot)\n1222|\t\tsort.Strings(sortedWant)\n1223|\t\tif strings.Join(sortedGot, \",\") != strings.Join(sortedWant, \",\") {\n1224|\t\t\tt.Errorf(\"%s = %v, want spec %v\", name, got, want)\n1225|\t\t}\n1226|\t}\n1227|\tt.Run(\"operations ordered\", func(t *testing.T) {\n1228|\t\toperations, _, _ := deriveOperationTable(t)\n1229|\t\tvar got []string\n1230|\t\tfor _, operation := range operationOrder {\n1231|\t\t\tgot = append(got, string(operation))\n1232|\t\t}\n1233|\t\tif strings.Join(got, \",\") != strings.Join(operations, \",\") {\n1234|\t\t\tt.Errorf(\"operation registry = %v, want table %v\", got, operations)\n1235|\t\t}\n1236|\t})\n1237|\tt.Run(\"capabilities ordered\", func(t *testing.T) {\n1238|\t\tderived := deriveTypeMembers(t, text, \"The exact capability names are\")\n1239|\t\tif strings.Join(capabilityOrder, \",\") != strings.Join(derived, \",\") {\n1240|\t\t\tt.Errorf(\"capability registry = %v, want spec %v\", capabilityOrder, derived)\n1241|\t\t}\n1242|\t})\n1243|\tsetEqual(t, \"capture classes\", captureClasses, firstSpanUnion(t, \"Each Capture Item has one native key and class\"))\n1244|\tsetEqual(t, \"projection strategies\", projectionStrategies, firstSpanUnion(t, \"Strategies are\"))\n1245|\tsetEqual(t, \"fidelity dispositions\", fidelityDispositions, firstSpanUnion(t, \"The dispositions are\"))\n1246|\tsetEqual(t, \"capability statuses\", capabilityStatuses, unionAfter(t, \"Each capability value contains exactly\\n<code>status:\"))\n1247|\tsetEqual(t, \"capability evidences\", capabilityEvidences, unionAfter(t, \"<code>enabled:boolean</code>,\\n<code>evidence:\"))\n1248|\tsetEqual(t, \"read purposes\", readPurposes, unionAfter(t, \"<code>ReadAuthority</code> contains exactly <code>authority_id:UUIDv7</code>,\\n  <code>purpose:\"))\n1249|\tsetEqual(t, \"object purposes\", objectPurposes, unionAfter(t, \"<code>ObjectAuthority</code> contains exactly\\n  <code>authority_id:UUIDv7</code>,\\n  <code>purpose:\"))\n1250|\tsetEqual(t, \"finding severities\", findingSeverities, unionAfter(t, \"<code>AdapterFinding</code> contains exactly\\n  <code>severity:\"))\n1251|\tsetEqual(t, \"directions\", directionNames, unionAfter(t, \"<code>SupportedEnvironmentTupleKey</code> contains exactly\\n<code>direction:\"))\n1252|\tsetEqual(t, \"doctor directions agree\", directionNames, rowInlineUnion(t, \"| <code>doctor</code> |\", \"direction:\"))\n1253|\tsetEqual(t, \"roles\", roleNames, unionAfter(t, \"<code>SessionAdapterExecutionBinding</code> containing exactly\\n<code>role:\"))\n1254|\tsetEqual(t, \"binding candidate kinds\", candidateKindNames, unionAfter(t, \"<code>provider_id:provider-id</code>,\\n<code>candidate_kind:\"))\n1255|\tsetEqual(t, \"probe candidate kinds agree\", candidateKindNames, rowInlineUnion(t, \"| <code>probe</code> |\", \"expected_candidate_kind:\"))\n1256|\tsetEqual(t, \"object modes\", objectModes, unionAfter(t, \"  <code>mode:\"))\n1257|\tsetEqual(t, \"tuple entry statuses\", tupleEntryStatuses, unionAfter(t, \"<code>valid_until:timestamp</code>,\\n<code>status:\"))\n1258|\tsetEqual(t, \"registry entry statuses\", registryEntryStatuses, rowInlineUnion(t, \"| <code>doctor</code> |\", \"registry_entry_status:\"))\n1259|\tt.Run(\"evidence results\", func(t *testing.T) {\n1260|\t\tsetEqual(t, \"evidence results\", evidenceResults, []string{\"pass\"})\n1261|\t\tfor _, marker := range []string{\"<code>FixtureEvidence</code> contains exactly\", \"<code>ResumeSmokeEvidence</code> contains exactly\"} {\n1262|\t\t\tindex := strings.Index(text, marker)\n1263|\t\t\tif index < 0 {\n1264|\t\t\t\tt.Fatalf(\"spec sentence %q not found\", marker)\n1265|\t\t\t}\n1266|\t\t\trest := text[index+len(marker):]\n1267|\t\t\tend := sentenceEnd(rest)\n1268|\t\t\tif end < 0 {\n1269|\t\t\t\tt.Fatalf(\"spec sentence for %q never terminates\", marker)\n1270|\t\t\t}\n1271|\t\t\tif !strings.Contains(rest[:end], \"<code>result=pass</code>\") {\n1272|\t\t\t\tt.Errorf(\"spec sentence %q carries no <code>result=pass</code>\", marker)\n1273|\t\t\t}\n1274|\t\t}\n1275|\t})\n1276|\tt.Run(\"context-free operations\", func(t *testing.T) {\n1277|\t\t_, requests, _ := deriveOperationTable(t)\n1278|\t\tvar want []string\n1279|\t\tfor _, operation := range operationOrder {\n1280|\t\t\tcontext := false\n1281|\t\t\tfor _, member := range requests[string(operation)] {\n1282|\t\t\t\tif member == \"context\" {\n1283|\t\t\t\t\tcontext = true\n1284|\t\t\t\t\tbreak\n1285|\t\t\t\t}\n1286|\t\t\t}\n1287|\t\t\tif !context {\n1288|\t\t\t\twant = append(want, string(operation))\n1289|\t\t\t}\n1290|\t\t}\n1291|\t\tvar got []string\n1292|\t\tfor _, operation := range contextFreeOperations {\n1293|\t\t\tgot = append(got, string(operation))\n1294|\t\t}\n1295|\t\tsetEqual(t, \"context-free operations\", got, want)\n1296|\t})\n1297|\tsetEqual(t, \"platforms\", []string{string(scalar.PlatformLinux), string(scalar.PlatformMacOS), string(scalar.PlatformWindows), string(scalar.PlatformWSL2)}, unionAfter(t, \"<code>platform=\"))\n1298|\tsetEqual(t, \"architectures\", tupleArchitectures, unionAfter(t, \"<code>architecture=\"))\n1299|\tsetEqual(t, \"fidelity profiles\", fidelityProfiles, rowInlineUnion(t, \"| <code>projection-plan</code> |\", \"fidelity_profile:\"))\n1300|\tsetEqual(t, \"validate modes\", validateModes, rowInlineUnion(t, \"| <code>validate</code> |\", \"mode:\"))\n1301|}"}}}
