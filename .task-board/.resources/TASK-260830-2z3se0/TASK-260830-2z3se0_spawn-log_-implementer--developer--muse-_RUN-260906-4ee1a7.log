{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7af","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":562,"recorded_at":1780531400001119,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"012953dc-8f18-478c-8bd9-da03f3052c62"},"task_id":"012953dc-8f18-478c-8bd9-da03f3052c62","event":{"kind":"output","task_id":"012953dc-8f18-478c-8bd9-da03f3052c62","chunk":"Read text file `internal/sessadapter/probe_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// fixtureValidProbe decodes the fixture probe and returns it with\n10|// the manifest digest the fixture manifest computes to.\n11|func fixtureValidProbe(t *testing.T) (Probe, Manifest) {\n12|\tt.Helper()\n13|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n16|\t}\n17|\tdigest := ManifestDigest(manifest).String()\n18|\tprobe, err := DecodeProbe([]byte(fixtureProbeJSON(digest)))\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"DecodeProbe: %v\", err)\n21|\t}\n22|\treturn probe, manifest\n23|}\n24|\n25|func TestDecodeProbeAcceptsFixture(t *testing.T) {\n26|\tprobe, _ := fixtureValidProbe(t)\n27|\tif len(probe.Capabilities) != 15 {\n28|\t\tt.Fatalf(\"capabilities = %d, want 15\", len(probe.Capabilities))\n29|\t}\n30|\tif probe.ProviderID != fixtureProviderID {\n31|\t\tt.Fatalf(\"ProviderID = %q, want %q\", probe.ProviderID, fixtureProviderID)\n32|\t}\n33|\tif probe.Environment.EnvironmentID != fixtureEnvironmentID {\n34|\t\tt.Fatalf(\"EnvironmentID = %q, want %q\", probe.Environment.EnvironmentID, fixtureEnvironmentID)\n35|\t}\n36|\tfor _, name := range capabilityOrder {\n37|\t\tif !CapabilityUsable(probe, name) {\n38|\t\t\tt.Fatalf(\"CapabilityUsable(%q) = false, want true\", name)\n39|\t\t}\n40|\t}\n41|}\n42|\n43|// TestCapabilityStatusMatrix drives every status/enabled\n44|// combination through the value decoder: only\n45|// available+enabled is usable, and only available permits\n46|// enabled=true. The eight combinations are enumerated, not\n47|// sampled.\n48|func TestCapabilityStatusMatrix(t *testing.T) {\n49|\tfor _, status := range []string{\"available\", \"conditional\", \"unsupported\", \"unknown\"} {\n50|\t\tfor _, enabled := range []bool{false, true} {\n51|\t\t\tname := fmt.Sprintf(\"%s/enabled=%v\", status, enabled)\n52|\t\t\tt.Run(name, func(t *testing.T) {\n53|\t\t\t\tbody := fmt.Sprintf(`{\"status\":%q,\"enabled\":%v,\"evidence\":\"probed\",\"detail\":\"\"}`, status, enabled)\n54|\t\t\t\tprobe, _ := fixtureValidProbe(t)\n55|\t\t\t\t// Rebuild the probe body with one value replaced.\n56|\t\t\t\tfixture := fixtureProbeJSON(probe.ManifestDigest)\n57|\t\t\t\tmutated := replaceCapability(t, []byte(fixture), \"tool_history\", body)\n58|\t\t\t\tredone, err := DecodeProbe(mutated)\n59|\t\t\t\tif enabled && status != \"available\" {\n60|\t\t\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"without available status\")\n61|\t\t\t\t\treturn\n62|\t\t\t\t}\n63|\t\t\t\tif err != nil {\n64|\t\t\t\t\tt.Fatalf(\"DecodeProbe: %v\", err)\n65|\t\t\t\t}\n66|\t\t\t\twantUsable := status == \"available\" && enabled\n67|\t\t\t\tif CapabilityUsable(redone, \"tool_history\") != wantUsable {\n68|\t\t\t\t\tt.Fatalf(\"CapabilityUsable = %v, want %v\", !wantUsable, wantUsable)\n69|\t\t\t\t}\n70|\t\t\t})\n71|\t\t}\n72|\t}\n73|}\n74|\n75|// replaceCapability swaps one capability value in a probe body.\n76|func replaceCapability(t *testing.T, body []byte, name, value string) []byte {\n77|\tt.Helper()\n78|\tmarker := `\"` + name + `\":` + fixtureCapabilityJSON()\n79|\tif !strings.Contains(string(body), marker) {\n80|\t\tt.Fatalf(\"replaceCapability: %q not in fixture\", name)\n81|\t}\n82|\treturn []byte(strings.Replace(string(body), marker, `\"`+name+`\":`+value, 1))\n83|}\n84|\n85|func TestDecodeProbeClosedRules(t *testing.T) {\n86|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n87|\tif err != nil {\n88|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n89|\t}\n90|\tdigest := ManifestDigest(manifest).String()\n91|\tfixture := []byte(fixtureProbeJSON(digest))\n92|\tmembers := []string{\"schema\", \"schema_version\", \"provider_id\", \"adapter_manifest_digest\", \"adapter_version\", \"environment\", \"capabilities\", \"warnings\", \"extensions\"}\n93|\tfor _, member := range members {\n94|\t\tt.Run(\"missing \"+member, func(t *testing.T) {\n95|\t\t\t_, err := DecodeProbe(dropMember(t, fixture, member))\n96|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", member, \"misses a required member\")\n97|\t\t})\n98|\t}\n99|\tt.Run(\"unknown member\", func(t *testing.T) {\n100|\t\t_, err := DecodeProbe(appendMember(t, fixture, \"unexpected\", `true`))\n101|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"unexpected\", \"unknown member\")\n102|\t})\n103|\tt.Run(\"omit capability\", func(t *testing.T) {\n104|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"\"}`)\n105|\t\t_ = mutated\n106|\t\tdropped := dropCapability(t, fixture, \"tool_history\")\n107|\t\t_, err := DecodeProbe(dropped)\n108|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"capabilities\", \"exactly fifteen\")\n109|\t})\n110|\tt.Run(\"extra capability\", func(t *testing.T) {\n111|\t\tadded := addCapability(t, fixture, \"gui_clipboard\", fixtureCapabilityJSON())\n112|\t\t_, err := DecodeProbe(added)\n113|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"capabilities\", \"exactly fifteen\")\n114|\t})\n115|\tt.Run(\"bad evidence\", func(t *testing.T) {\n116|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"vibes\",\"detail\":\"\"}`)\n117|\t\t_, err := DecodeProbe(mutated)\n118|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"seven-evidence vocabulary\")\n119|\t})\n120|\tt.Run(\"bad status\", func(t *testing.T) {\n121|\t\t// A fifth status is refused even though the matrix above\n122|\t\t// admits the four closed values: the status gate admits\n123|\t\t// exactly the Section 7.8 union, and a mutant weakening\n124|\t\t// validCapabilityStatus to admit anything fails here.\n125|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"bogus\",\"enabled\":false,\"evidence\":\"probed\",\"detail\":\"\"}`)\n126|\t\t_, err := DecodeProbe(mutated)\n127|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"outside available|conditional|unsupported|unknown\")\n128|\t})\n129|\tt.Run(\"detail too long\", func(t *testing.T) {\n130|\t\tmutated := replaceCapability(t, fixture, \"tool_history\", `{\"status\":\"available\",\"enabled\":true,\"evidence\":\"probed\",\"detail\":\"`+strings.Repeat(\"d\", 2049)+`\"}`)\n131|\t\t_, err := DecodeProbe(mutated)\n132|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"tool_history\", \"string[0..2048]\")\n133|\t})\n134|\tt.Run(\"unsorted warnings\", func(t *testing.T) {\n135|\t\t_, err := DecodeProbe(mutateMember(t, fixture, \"warnings\", `[\"b\",\"a\"]`))\n136|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"warnings\", \"sorted unique\")\n137|\t})\n138|\tt.Run(\"duplicate warnings\", func(t *testing.T) {\n139|\t\t_, err := DecodeProbe(mutateMember(t, fixture, \"warnings\", `[\"a\",\"a\"]`))\n140|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"warnings\", \"sorted unique\")\n141|\t})\n142|\tt.Run(\"warning too long\", func(t *testing.T) {\n143|\t\t_, err := DecodeProbe(mutateMember(t, fixture, \"warnings\", `[\"`+strings.Repeat(\"w\", 2049)+`\"]`))\n144|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"warnings\", \"sorted unique\")\n145|\t})\n146|}\n147|\n148|// dropCapability removes one capability from a probe body.\n149|func dropCapability(t *testing.T, body []byte, name string) []byte {\n150|\tt.Helper()\n151|\tmarker := `\"` + name + `\":` + fixtureCapabilityJSON() + `,`\n152|\tif strings.Contains(string(body), marker) {\n153|\t\treturn []byte(strings.Replace(string(body), marker, ``, 1))\n154|\t}\n155|\tmarker = `,` + `\"` + name + `\":` + fixtureCapabilityJSON()\n156|\tif strings.Contains(string(body), marker) {\n157|\t\treturn []byte(strings.Replace(string(body), marker, ``, 1))\n158|\t}\n159|\tt.Fatalf(\"dropCapability: %q not in fixture\", name)\n160|\treturn nil\n161|}\n162|\n163|// addCapability inserts one extra capability into a probe body.\n164|func addCapability(t *testing.T, body []byte, name, value string) []byte {\n165|\tt.Helper()\n166|\tmarker := `\"capabilities\":{`\n167|\tif !strings.Contains(string(body), marker) {\n168|\t\tt.Fatalf(\"addCapability: capabilities map not in fixture\")\n169|\t}\n170|\treturn []byte(strings.Replace(string(body), marker, marker+`\"`+name+`\":`+value+`,`, 1))\n171|}\n172|\n173|func TestCheckProbeEqualities(t *testing.T) {\n174|\tprobe, manifest := fixtureValidProbe(t)\n175|\tdigest := ManifestDigest(manifest).String()\n176|\tfacts := ProbeHostFacts{\n177|\t\tExpectedProviderID: fixtureProviderID,\n178|\t\tExpectedKind:       CandidateBuiltin,\n179|\t\tManifestDigest:     digest,\n180|\t\tManifest:           manifest,\n181|\t}\n182|\tif err := CheckProbe(probe, facts); err != nil {\n183|\t\tt.Fatalf(\"CheckProbe: %v\", err)\n184|\t}\n185|\t// Every equality is broken alone: provider vs request, provider\n186|\t// vs manifest, digest, version, tuple environment, and tuple\n187|\t// adapter version.\n188|\totherDigest := fixtureDigest(\"other-manifest\")\n189|\tfor _, test := range []struct {\n190|\t\tname  string\n191|\t\tprobe Probe\n192|\t\tfacts ProbeHostFacts\n193|\t\tkey   string\n194|\t\tvalue string\n195|\t\ttext  string\n196|\t}{\n197|\t\t{\n198|\t\t\tname: \"provider vs request\", probe: probe,\n199|\t\t\tfacts: ProbeHostFacts{ExpectedProviderID: \"other-provider\", ExpectedKind: CandidateBuiltin, ManifestDigest: digest, Manifest: manifest},\n200|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"requested provider\",\n201|\t\t},\n202|\t\t{\n203|\t\t\tname:  \"provider vs manifest\",\n204|\t\t\tprobe: func() Probe { mutated := probe; mutated.ProviderID = \"other-provider\"; return mutated }(),\n205|\t\t\tfacts: func() ProbeHostFacts { fixed := facts; fixed.ExpectedProviderID = \"other-provider\"; return fixed }(),\n206|\t\t\tkey:   \"member\", value: \"provider_id\", text: \"verified manifest\",\n207|\t\t},\n208|\t\t{\n209|\t\t\tname:  \"manifest digest\",\n210|\t\t\tprobe: func() Probe { mutated := probe; mutated.ManifestDigest = otherDigest; return mutated }(),\n211|\t\t\tfacts: facts, key: \"member\", value: \"adapter_manifest_digest\", text: \"host-computed digest\",\n212|\t\t},\n213|\t\t{\n214|\t\t\tname:  \"adapter version\",\n215|\t\t\tprobe: func() Probe { mutated := probe; mutated.AdapterVersion = \"9.9.9\"; return mutated }(),\n216|\t\t\tfacts: facts, key: \"member\", value: \"adapter_version\", text: \"verified manifest\",\n217|\t\t},\n218|\t\t{\n219|\t\t\tname:  \"unrequested tuple\",\n220|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.EnvironmentID = \"other.env\"; return mutated }(),\n221|\t\t\tfacts: facts, key: \"environment\", value: \"other.env\", text: \"outside the manifest environment\",\n222|\t\t},\n223|\t\t{\n224|\t\t\tname:  \"tuple version disagrees\",\n225|\t\t\tprobe: func() Probe { mutated := probe; mutated.Environment.AdapterVersion = \"0.0.1\"; return mutated }(),\n226|\t\t\tfacts: facts, key: \"member\", value: \"environment\", text: \"probe adapter version\",\n227|\t\t},\n228|\t} {\n229|\t\tt.Run(test.name, func(t *testing.T) {\n230|\t\t\terr := CheckProbe(test.probe, test.facts)\n231|\t\t\tif test.key == \"environment\" && (test.name == \"unrequested tuple\") {\n232|\t\t\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", test.key, test.value, test.text)\n233|\t\t\t\treturn\n234|\t\t\t}\n235|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n236|\t\t})\n237|\t}\n238|}\n239|\n240|// TestZeroValueHostFactsRefuse pins the fail-closed half of the\n241|// host-fact equality gates: a caller that forgets a fact field\n242|// gets a refusal, never an admission. Each zero field with a\n243|// non-empty probe side refuses through its own arm, so a mutant\n244|// that only refuses when the expected side is non-empty\n245|// (`!= expected && expected != \"\"`) slides the arm or admits,\n246|// and reddens here.\n247|func TestZeroValueHostFactsRefuse(t *testing.T) {\n248|\tprobe, manifest := fixtureValidProbe(t)\n249|\tdigest := ManifestDigest(manifest).String()\n250|\tt.Run(\"zero expected provider\", func(t *testing.T) {\n251|\t\terr := CheckProbe(probe, ProbeHostFacts{})\n252|\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"provider_id\", \"requested provider\")\n253|\t})\n254|\tt.Run(\"zero manifest environment\", func(t *testing.T) {\n255|\t\tempty := manifest\n256|\t\tempty.EnvironmentID = \"\"\n257|\t\tfacts := ProbeHostFacts{\n258|\t\t\tExpectedProviderID: fixtureProviderID,\n259|\t\t\tExpectedKind:       CandidateBuiltin,\n260|\t\t\tManifestDigest:     digest,\n261|\t\t\tManifest:           empty,\n262|\t\t}\n263|\t\terr := CheckProbe(probe, facts)\n264|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"outside the manifest environment\")\n265|\t})\n266|\tt.Run(\"zero expected candidate kind\", func(t *testing.T) {\n267|\t\terr := CheckProbeRequest(fixtureProviderID, \"\", fixtureCandidate())\n268|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n269|\t})\n270|}\n271|\n272|func TestCheckProbeRequest(t *testing.T) {\n273|\tcandidate := fixtureCandidate()\n274|\tif err := CheckProbeRequest(fixtureProviderID, CandidateBuiltin, candidate); err != nil {\n275|\t\tt.Fatalf(\"CheckProbeRequest: %v\", err)\n276|\t}\n277|\tif err := CheckProbeRequest(\"other-provider\", CandidateBuiltin, candidate); err == nil {\n278|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign provider identifier\")\n279|\t} else {\n280|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_provider_id\", \"trusted candidate\")\n281|\t}\n282|\tif err := CheckProbeRequest(fixtureProviderID, CandidateExternal, candidate); err == nil {\n283|\t\tt.Fatal(\"CheckProbeRequest admitted a foreign candidate kind\")\n284|\t} else {\n285|\t\trequireRefusal(t, err, \"invalid_config\", \"field\", \"expected_candidate_kind\", \"trusted candidate\")\n286|\t}\n287|}\n288|\n289|// TestCheckDoctorHealthyDrivesEveryRequiredCapability derives\n290|// the required set from DoctorRequiredCapabilities and breaks\n291|// every member alone: a healthy accepted result passes whole,\n292|// and weakening any single required capability refuses naming\n293|// that capability. A loop truncation (required[:1]) admits a\n294|// weakened later member and reddens here, which a one-member\n295|// probe cannot catch.\n296|func TestCheckDoctorHealthyDrivesEveryRequiredCapability(t *testing.T) {\n297|\tmanifestDigest := fixtureManifestDigestText(t)\n298|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n299|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n300|\tif err != nil {\n301|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n302|\t}\n303|\tprobe, _ := fixtureValidProbe(t)\n304|\tgood := fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n305|\thealthy := mutateMember(t, good, \"healthy\", `true`)\n306|\tfor _, official := range []bool{false, true} {\n307|\t\trequired := DoctorRequiredCapabilities(DirectionTargetWrite, official)\n308|\t\tif len(required) != 4 {\n309|\t\t\tt.Fatalf(\"official=%v required = %v, want the derived four-capability set\", official, required)\n310|\t\t}\n311|\t\tresult, err := DecodeDoctorResult(healthy, decoded, DirectionSourceRead)\n312|\t\tif err != nil {\n313|\t\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n314|\t\t}\n315|\t\tif err := CheckDoctorHealthy(result, probe, required); err != nil {\n316|\t\t\tt.Fatalf(\"official=%v CheckDoctorHealthy whole: %v\", official, err)\n317|\t\t}\n318|\t\tfor _, name := range required {\n319|\t\t\tt.Run(fmt.Sprintf(\"official=%v/%s\", official, name), func(t *testing.T) {\n320|\t\t\t\tweakened := probe\n321|\t\t\t\tweakened.Capabilities = cloneCapabilities(probe.Capabilities)\n322|\t\t\t\tweakened.Capabilities[name] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n323|\t\t\t\terr := CheckDoctorHealthy(result, weakened, required)\n324|\t\t\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", name, \"usable required capability\")\n325|\t\t\t})\n326|\t\t}\n327|\t}\n328|}\n329|\n330|func TestCheckTargetWriteGates(t *testing.T) {\n331|\tprobe, _ := fixtureValidProbe(t)\n332|\tprovider := map[string]ProviderCapability{\n333|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n334|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n335|\t}\n336|\tif err := CheckTargetWriteGates(probe.Capabilities, provider); err != nil {\n337|\t\tt.Fatalf(\"CheckTargetWriteGates: %v\", err)\n338|\t}\n339|\t// The disjunction: disabling canonical_write alone still\n340|\t// passes through official_import, and vice versa.\n341|\twithoutCanonical := cloneCapabilities(probe.Capabilities)\n342|\twithoutCanonical[\"canonical_write\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n343|\tif err := CheckTargetWriteGates(withoutCanonical, provider); err != nil {\n344|\t\tt.Fatalf(\"CheckTargetWriteGates without canonical_write: %v\", err)\n345|\t}\n346|\twithoutImport := cloneCapabilities(probe.Capabilities)\n347|\twithoutImport[\"official_import\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n348|\tif err := CheckTargetWriteGates(withoutImport, provider); err != nil {\n349|\t\tt.Fatalf(\"CheckTargetWriteGates without official_import: %v\", err)\n350|\t}\n351|\t// Both members of the pair down: refused, naming the pair.\n352|\twithoutBoth := cloneCapabilities(probe.Capabilities)\n353|\twithoutBoth[\"canonical_write\"] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n354|\twithoutBoth[\"official_import\"] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n355|\terr := CheckTargetWriteGates(withoutBoth, provider)\n356|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"canonical_write|official_import\", \"neither usable\")\n357|\t// Each remaining required adapter capability is broken alone.\n358|\tfor _, name := range []string{\"native_read_back\", \"native_resume_plan\", \"workspace_binding\"} {\n359|\t\twithout := cloneCapabilities(probe.Capabilities)\n360|\t\twithout[name] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n361|\t\terr := CheckTargetWriteGates(without, provider)\n362|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", name, \"usable adapter capability\")\n363|\t}\n364|\t// Each provider capability is broken alone, including the\n365|\t// enabled-bit half: available-but-disabled is not usable.\n366|\tfor _, name := range []string{\"portable_store\", \"native_resume\"} {\n367|\t\tunsupported := map[string]ProviderCapability{\n368|\t\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n369|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n370|\t\t}\n371|\t\tunsupported[name] = ProviderCapability{Status: \"unsupported\", Enabled: false}\n372|\t\terr := CheckTargetWriteGates(probe.Capabilities, unsupported)\n373|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:\"+name, \"usable provider capability\")\n374|\t\tdisabled := map[string]ProviderCapability{\n375|\t\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n376|\t\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n377|\t\t}\n378|\t\tdisabled[name] = ProviderCapability{Status: \"available\", Enabled: false}\n379|\t\terr = CheckTargetWriteGates(probe.Capabilities, disabled)\n380|\t\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:\"+name, \"usable provider capability\")\n381|\t}\n382|\t// A missing provider surface is refused, never defaulted.\n383|\tmissing := map[string]ProviderCapability{\n384|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n385|\t}\n386|\terr = CheckTargetWriteGates(probe.Capabilities, missing)\n387|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"provider:native_resume\", \"usable provider capability\")\n388|}\n389|\n390|func cloneCapabilities(capabilities map[string]Capability) map[string]Capability {\n391|\tcloned := make(map[string]Capability, len(capabilities))\n392|\tfor name, value := range capabilities {\n393|\t\tcloned[name] = value\n394|\t}\n395|\treturn cloned\n396|}\n397|\n398|// TestTargetWriteComplementDerivesNonRequired pins the other side\n399|// of the gate: every registry capability outside the required set\n400|// is not required, so a mutant that adds a requirement fails here\n401|// with the complement named.\n402|func TestTargetWriteComplementDerivesNonRequired(t *testing.T) {\n403|\trequired := map[string]bool{\n404|\t\t\"canonical_write\": true, \"official_import\": true,\n405|\t\t\"native_read_back\": true, \"native_resume_plan\": true, \"workspace_binding\": true,\n406|\t\t\"provider:portable_store\": true, \"provider:native_resume\": true,\n407|\t}\n408|\tvar complement []string\n409|\tfor _, name := range capabilityOrder {\n410|\t\tif !required[name] {\n411|\t\t\tcomplement = append(complement, name)\n412|\t\t}\n413|\t}\n414|\tif len(complement) == 0 {\n415|\t\tt.Fatal(\"derived an empty non-required complement; the check is blind\")\n416|\t}\n417|\tprobe, _ := fixtureValidProbe(t)\n418|\tprovider := map[string]ProviderCapability{\n419|\t\t\"portable_store\": {Status: \"available\", Enabled: true},\n420|\t\t\"native_resume\":  {Status: \"available\", Enabled: true},\n421|\t}\n422|\t// Disabling every complement capability at once still passes:\n423|\t// none of them gates a target write.\n424|\tdisabled := cloneCapabilities(probe.Capabilities)\n425|\tfor _, name := range complement {\n426|\t\tdisabled[name] = Capability{Status: \"unsupported\", Enabled: false, Evidence: \"probed\"}\n427|\t}\n428|\tif err := CheckTargetWriteGates(disabled, provider); err != nil {\n429|\t\tt.Fatalf(\"CheckTargetWriteGates with complement disabled: %v\", err)\n430|\t}\n431|\tt.Logf(\"non-required complement: %d/%d capabilities\", len(complement), len(capabilityOrder))\n432|}\n433|\n434|func TestDoctorRequiredCapabilities(t *testing.T) {\n435|\ttarget := DoctorRequiredCapabilities(DirectionTargetWrite, false)\n436|\tif len(target) != 4 || target[0] != \"canonical_write\" {\n437|\t\tt.Fatalf(\"target required = %v, want [canonical_write native_read_back native_resume_plan workspace_binding]\", target)\n438|\t}\n439|\tofficial := DoctorRequiredCapabilities(DirectionTargetWrite, true)\n440|\tif len(official) != 4 || official[0] != \"official_import\" {\n441|\t\tt.Fatalf(\"official-import required = %v, want official_import first\", official)\n442|\t}\n443|\tif got := DoctorRequiredCapabilities(DirectionSourceRead, false); len(got) != 0 {\n444|\t\tt.Fatalf(\"source required = %v, want empty: Section 7.8 names no source set\", got)\n445|\t}\n446|}"}}}
