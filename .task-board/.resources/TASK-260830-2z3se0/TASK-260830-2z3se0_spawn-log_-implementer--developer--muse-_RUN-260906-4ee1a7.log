{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c93b","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":760,"recorded_at":1780531400001515,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"ab218e86-2edd-4383-ae09-a9cb57e8fe8f"},"task_id":"ab218e86-2edd-4383-ae09-a9cb57e8fe8f","event":{"kind":"output","task_id":"ab218e86-2edd-4383-ae09-a9cb57e8fe8f","chunk":"Read text file `internal/sessadapter/discovery_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"testing\"\n5|\t\"time\"\n6|)\n7|\n8|func TestDiscoverBindsManifestToCandidate(t *testing.T) {\n9|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n10|\tif err != nil {\n11|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n12|\t}\n13|\tdigest := ManifestDigest(manifest).String()\n14|\tfor _, role := range []Role{RoleSource, RoleTarget} {\n15|\t\tbinding, err := Discover(role, manifest, digest, fixtureCandidate())\n16|\t\tif err != nil {\n17|\t\t\tt.Fatalf(\"Discover(%q): %v\", role, err)\n18|\t\t}\n19|\t\tif binding.Role != role || binding.ProviderID != fixtureProviderID || binding.AdapterManifestDigest != digest {\n20|\t\t\tt.Fatalf(\"binding = %+v\", binding)\n21|\t\t}\n22|\t}\n23|}\n24|\n25|func TestDiscoverRefusals(t *testing.T) {\n26|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n29|\t}\n30|\tdigest := ManifestDigest(manifest).String()\n31|\tcandidate := fixtureCandidate()\n32|\t_, err = Discover(\"sideways\", manifest, digest, candidate)\n33|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"role\", \"outside source|target\")\n34|\tforeign := candidate\n35|\tforeign.ProviderID = \"other-provider\"\n36|\t_, err = Discover(RoleSource, manifest, digest, foreign)\n37|\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"trusted candidate\")\n38|\tpathless := candidate\n39|\tpathless.ExecutablePath = \"\"\n40|\t_, err = Discover(RoleSource, manifest, digest, pathless)\n41|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"executable_path\", \"no executable path\")\n42|\townerless := candidate\n43|\townerless.OwnerIdentity = \"\"\n44|\t_, err = Discover(RoleSource, manifest, digest, ownerless)\n45|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"owner_identity\", \"no owner identity\")\n46|\tbadExe := candidate\n47|\tbadExe.ExecutableSHA256 = \"not-a-digest\"\n48|\t_, err = Discover(RoleSource, manifest, digest, badExe)\n49|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"executable_sha256\", \"not a digest\")\n50|\tbadDigest := digest\n51|\t_, err = Discover(RoleSource, manifest, \"not-a-digest\", candidate)\n52|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"session_adapter_manifest_digest\", \"not a digest\")\n53|\t_ = badDigest\n54|}\n55|\n56|// TestBindingEqualityFlipsEveryFact breaks each of the eight\n57|// identity facts alone: every flip refuses, and equal bindings\n58|// with different observation times agree. verified_at timestamps\n59|// the observation; it is not an identity fact.\n60|func TestBindingEqualityFlipsEveryFact(t *testing.T) {\n61|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n64|\t}\n65|\tsealed, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"Discover: %v\", err)\n68|\t}\n69|\tfresh := sealed\n70|\tfresh.VerifiedAt = time.Now().UTC().Format(time.RFC3339)\n71|\tsealed.VerifiedAt = \"2026-01-01T00:00:00Z\"\n72|\tif err := CheckBindingEquality(sealed, fresh); err != nil {\n73|\t\tt.Fatalf(\"CheckBindingEquality with differing timestamps: %v\", err)\n74|\t}\n75|\tflips := []func(*ExecutionBinding){\n76|\t\tfunc(binding *ExecutionBinding) { binding.Role = RoleTarget },\n77|\t\tfunc(binding *ExecutionBinding) { binding.ProviderID = \"other-provider\" },\n78|\t\tfunc(binding *ExecutionBinding) { binding.CandidateKind = CandidateExternal },\n79|\t\tfunc(binding *ExecutionBinding) { binding.ExecutablePath = \"/other/path\" },\n80|\t\tfunc(binding *ExecutionBinding) { binding.OwnerIdentity = \"other-owner\" },\n81|\t\tfunc(binding *ExecutionBinding) { binding.ExecutableSHA256 = fixtureDigest(\"other-exe\") },\n82|\t\tfunc(binding *ExecutionBinding) {\n83|\t\t\tbinding.ProviderManifestDigest = fixtureDigest(\"other-provider-manifest\")\n84|\t\t},\n85|\t\tfunc(binding *ExecutionBinding) {\n86|\t\t\tbinding.AdapterManifestDigest = fixtureDigest(\"other-adapter-manifest\")\n87|\t\t},\n88|\t}\n89|\tif len(flips) != 8 {\n90|\t\tt.Fatalf(\"flips = %d, want one per identity fact\", len(flips))\n91|\t}\n92|\tfor index, flip := range flips {\n93|\t\tmutated := sealed\n94|\t\tflip(&mutated)\n95|\t\tif err := CheckBindingEquality(sealed, mutated); err == nil {\n96|\t\t\tt.Fatalf(\"CheckBindingEquality admitted flip %d\", index)\n97|\t\t} else {\n98|\t\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"binding\", \"freshly read trusted facts\")\n99|\t\t}\n100|\t}\n101|}\n102|\n103|func TestCheckCallBinding(t *testing.T) {\n104|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n105|\tif err != nil {\n106|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n107|\t}\n108|\tbinding, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n109|\tif err != nil {\n110|\t\tt.Fatalf(\"Discover: %v\", err)\n111|\t}\n112|\tbody := fixtureRequestWithDigest(t, ManifestDigest(manifest).String())\n113|\tcontext, err := CheckRequestBody(OpDiscover, body)\n114|\tif err != nil {\n115|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n116|\t}\n117|\tadmitted, err := DecodeTuple([]byte(fixtureTupleJSON()))\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n120|\t}\n121|\tif err := CheckCallBinding(binding, RoleSource, context, admitted); err != nil {\n122|\t\tt.Fatalf(\"CheckCallBinding: %v\", err)\n123|\t}\n124|\tif err := CheckCallBinding(binding, RoleTarget, context, admitted); err == nil {\n125|\t\tt.Fatal(\"admitted a target call under a source binding\")\n126|\t} else {\n127|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"role\", \"binding role\")\n128|\t}\n129|\tforeignProvider := context\n130|\tforeignProvider.ProviderID = \"other-provider\"\n131|\tif err := CheckCallBinding(binding, RoleSource, foreignProvider, admitted); err == nil {\n132|\t\tt.Fatal(\"admitted a foreign provider context\")\n133|\t} else {\n134|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"sealed binding\")\n135|\t}\n136|\tforeignManifest := context\n137|\tforeignManifest.ManifestDigest = fixtureDigest(\"other-manifest\")\n138|\tif err := CheckCallBinding(binding, RoleSource, foreignManifest, admitted); err == nil {\n139|\t\tt.Fatal(\"admitted a foreign manifest context\")\n140|\t} else {\n141|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"session_adapter_manifest_digest\", \"sealed binding\")\n142|\t}\n143|\tforeignExe := context\n144|\tforeignExe.ExecutableSHA256 = fixtureDigest(\"other-exe\")\n145|\tif err := CheckCallBinding(binding, RoleSource, foreignExe, admitted); err == nil {\n146|\t\tt.Fatal(\"admitted a foreign executable context\")\n147|\t} else {\n148|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"executable_sha256\", \"sealed binding\")\n149|\t}\n150|\totherTuple := admitted\n151|\totherTuple.Version = \"9.9.9\"\n152|\tif err := CheckCallBinding(binding, RoleSource, context, otherTuple); err == nil {\n153|\t\tt.Fatal(\"admitted an unadmitted tuple\")\n154|\t} else {\n155|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"admitted tuple\")\n156|\t}\n157|}\n158|\n159|// TestCheckCallBindingZeroFactsRefuse pins the fail-closed half\n160|// of the call-binding gates: a caller that forgets a sealed fact\n161|// gets a refusal, never an admission. Each zero binding fact\n162|// with a non-empty call side refuses through its own arm, so a\n163|// mutant that only checks when the expected side is non-empty\n164|// (`!= binding && binding != \"\"`) admits and reddens here.\n165|func TestCheckCallBindingZeroFactsRefuse(t *testing.T) {\n166|\tmanifest, err := DecodeManifest([]byte(fixtureManifestJSON()))\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"DecodeManifest: %v\", err)\n169|\t}\n170|\tbinding, err := Discover(RoleSource, manifest, ManifestDigest(manifest).String(), fixtureCandidate())\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"Discover: %v\", err)\n173|\t}\n174|\tbody := fixtureRequestWithDigest(t, ManifestDigest(manifest).String())\n175|\tcontext, err := CheckRequestBody(OpDiscover, body)\n176|\tif err != nil {\n177|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n178|\t}\n179|\tadmitted, err := DecodeTuple([]byte(fixtureTupleJSON()))\n180|\tif err != nil {\n181|\t\tt.Fatalf(\"DecodeTuple: %v\", err)\n182|\t}\n183|\tt.Run(\"zero binding role\", func(t *testing.T) {\n184|\t\troleless := binding\n185|\t\troleless.Role = \"\"\n186|\t\terr := CheckCallBinding(roleless, RoleSource, context, admitted)\n187|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"role\", \"binding role\")\n188|\t})\n189|\tt.Run(\"zero binding provider\", func(t *testing.T) {\n190|\t\tproviderless := binding\n191|\t\tproviderless.ProviderID = \"\"\n192|\t\terr := CheckCallBinding(providerless, RoleSource, context, admitted)\n193|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"provider_id\", \"sealed binding\")\n194|\t})\n195|\tt.Run(\"zero binding manifest digest\", func(t *testing.T) {\n196|\t\tdigestless := binding\n197|\t\tdigestless.AdapterManifestDigest = \"\"\n198|\t\terr := CheckCallBinding(digestless, RoleSource, context, admitted)\n199|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"session_adapter_manifest_digest\", \"sealed binding\")\n200|\t})\n201|\tt.Run(\"zero binding executable digest\", func(t *testing.T) {\n202|\t\texeless := binding\n203|\t\texeless.ExecutableSHA256 = \"\"\n204|\t\terr := CheckCallBinding(exeless, RoleSource, context, admitted)\n205|\t\trequireRefusal(t, err, \"integrity_failure\", \"subject\", \"executable_sha256\", \"sealed binding\")\n206|\t})\n207|\tt.Run(\"zero admitted tuple\", func(t *testing.T) {\n208|\t\terr := CheckCallBinding(binding, RoleSource, context, Tuple{})\n209|\t\trequireRefusal(t, err, \"unsupported_environment_tuple\", \"environment\", fixtureEnvironmentID, \"admitted tuple\")\n210|\t})\n211|}"}}}
