\", \"member\", member, \"not a boolean\")\n264|\t\t}\n265|\t})\n266|}\n267|\n268|// TestResumePlanIdentityComplement drives zero, one, and two\n269|// occurrences of the explicit identity: exactly one admits, and\n270|// both neighbours refuse.\n271|func TestResumePlanIdentityComplement(t *testing.T) {\n272|\tmanifestDigest := fixtureManifestDigestText(t)\n273|\trequest := fixtureRequestBody(t, OpResumePlan, manifestDigest)\n274|\tdecoded, err := CheckRequestBody(OpResumePlan, request)\n275|\tif err != nil {\n276|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n277|\t}\n278|\tfacts := SuccessFacts{Context: decoded, ResumeTargetID: \"target-1\"}\n279|\tbase := fixtureSuccessBody(t, OpResumePlan, requestContextOf(t, request), manifestDigest)\n280|\tif err := CheckSuccessBody(OpResumePlan, base, facts); err != nil {\n281|\t\tt.Fatalf(\"CheckSuccessBody: %v\", err)\n282|\t}\n283|\tabsent := mutateMember(t, base, \"argv\", `[\"ax\",\"open\"]`)\n284|\terr = CheckSuccessBody(OpResumePlan, absent, facts)\n285|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"exactly once\")\n286|\tdoubled := mutateMember(t, base, \"argv\", `[\"ax\",\"open\",\"target-1\",\"target-1\"]`)\n287|\terr = CheckSuccessBody(OpResumePlan, doubled, facts)\n288|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"argv\", \"exactly once\")\n289|\tclosed := mutateMember(t, base, \"opens_existing_identity\", `false`)\n290|\terr = CheckSuccessBody(OpResumePlan, closed, facts)\n291|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"opens_existing_identity\", \"existing identity\")\n292|}\n293|\n294|func TestProjectionPlanDispositionRules(t *testing.T) {\n295|\tmanifestDigest := fixtureManifestDigestText(t)\n296|\trequest := fixtureRequestBody(t, OpProjectionPlan, manifestDigest)\n297|\tif _, err := CheckRequestBody(OpProjectionPlan, request); err != nil {\n298|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n299|\t}\n300|\tarchived := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"archive_only\"]}`)\n301|\t_, err := CheckRequestBody(OpProjectionPlan, archived)\n302|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"seven-disposition vocabulary\")\n303|\teighth := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"exact\",\"bogus\"]}`)\n304|\t_, err = CheckRequestBody(OpProjectionPlan, eighth)\n305|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"seven-disposition vocabulary\")\n306|\tunsorted := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"summarized\",\"exact\"]}`)\n307|\t_, err = CheckRequestBody(OpProjectionPlan, unsorted)\n308|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"user_message\", \"not sorted unique\")\n309|\tempty := mutateMember(t, request, \"required_dispositions\", `{}`)\n310|\t_, err = CheckRequestBody(OpProjectionPlan, empty)\n311|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"required_dispositions\", \"no class\")\n312|\tfifth := mutateMember(t, request, \"fidelity_profile\", `\"archive_only\"`)\n313|\t_, err = CheckRequestBody(OpProjectionPlan, fifth)\n314|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"fidelity_profile\", \"four-profile vocabulary\")\n315|\tduplicated := mutateMember(t, request, \"required_dispositions\", `{\"user_message\":[\"exact\",\"exact\"]}`)\n316|\t_, err = CheckRequestBody(OpProjectionPlan, duplicated)\n317|\tif err == nil {\n318|\t\tt.Fatal(\"admitted a duplicated disposition\")\n319|\t}\n320|}\n321|\n322|func TestDoctorResultRules(t *testing.T) {\n323|\tmanifestDigest := fixtureManifestDigestText(t)\n324|\trequest := fixtureRequestBody(t, OpDoctor, manifestDigest)\n325|\tdecoded, err := CheckRequestBody(OpDoctor, request)\n326|\tif err != nil {\n327|\t\tt.Fatalf(\"CheckRequestBody: %v\", err)\n328|\t}\n329|\tprobe, _ := fixtureValidProbe(t)\n330|\tgood := func() []byte {\n331|\t\treturn fixtureSuccessBody(t, OpDoctor, requestContextOf(t, request), manifestDigest)\n332|\t}\n333|\tfacts := SuccessFacts{Context: decoded, DoctorDirection: DirectionSourceRead}\n334|\tif err := CheckSuccessBody(OpDoctor, good(), facts); err != nil {\n335|\t\tt.Fatalf(\"CheckSuccessBody doctor: %v\", err)\n336|\t}\n337|\tmismatched := mutateMember(t, good(), \"direction\", `\"target_write\"`)\n338|\terr = CheckSuccessBody(OpDoctor, mismatched, facts)\n339|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"direction\", \"request direction\")\n340|\tbadStatus := mutateMember(t, good(), \"registry_entry_status\", `\"pending\"`)\n341|\terr = CheckSuccessBody(OpDoctor, badStatus, facts)\n342|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"registry_entry_status\", \"accepted|revoked|absent\")\n343|\tresult, err := DecodeDoctorResult(good(), decoded, DirectionSourceRead)\n344|\tif err != nil {\n345|\t\tt.Fatalf(\"DecodeDoctorResult: %v\", err)\n346|\t}\n347|\tif err := CheckDoctorHealthy(result, probe, nil); err != nil {\n348|\t\tt.Fatalf(\"CheckDoctorHealthy unhealthy: %v\", err)\n349|\t}\n350|\trevoked := mutateMember(t, good(), \"registry_entry_status\", `\"revoked\"`)\n351|\trevoked = mutateMember(t, revoked, \"healthy\", `true`)\n352|\trevokedResult, err := DecodeDoctorResult(revoked, decoded, DirectionSourceRead)\n353|\tif err != nil {\n354|\t\tt.Fatalf(\"DecodeDoctorResult revoked: %v\", err)\n355|\t}\n356|\terr = CheckDoctorHealthy(revokedResult, probe, nil)\n357|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"tuple_registry\", \"accepted registry entry\")\n358|\thealthy := mutateMember(t, good(), \"healthy\", `true`)\n359|\thealthyResult, err := DecodeDoctorResult(healthy, decoded, DirectionSourceRead)\n360|\tif err != nil {\n361|\t\tt.Fatalf(\"DecodeDoctorResult healthy: %v\", err)\n362|\t}\n363|\tweakened := probe\n364|\tweakened.Capabilities = cloneCapabilities(probe.Capabilities)\n365|\tweakened.Capabilities[\"native_discovery\"] = Capability{Status: \"conditional\", Enabled: false, Evidence: \"probed\"}\n366|\terr = CheckDoctorHealthy(healthyResult, weakened, []string{\"native_discovery\"})\n367|\trequireRefusal(t, err, \"capability_unavailable\", \"capability\", \"native_discovery\", \"usable required capability\")\n368|\tif err := CheckDoctorHealthy(healthyResult, probe, []string{\"native_discovery\"}); err != nil {\n369|\t\tt.Fatalf(\"CheckDoctorHealthy healthy: %v\", err)\n370|\t}\n371|\terr = CheckDoctorHealthy(healthyResult, probe, []string{\"teleport\"})\n372|\trequireRefusal(t, err, \"invalid_config\", \"field\", \"required\", \"closed registry\")\n373|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
