{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ff","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":474,"recorded_at":1780531400000943,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"call_id":"call_01a0747730257a12a1016632ed0fa6fb","text":"Read text file `internal/sessadapter/census_test.go`.\n(499 line(s) above)\n500|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n501|\t\tif err != nil {\n502|\t\t\tt.Fatalf(\"chain census: %v\", err)\n503|\t\t}\n504|\t\tfor _, chain := range inlineVocabulariesInFile(fileSet, syntax) {\n505|\t\t\tunregistered = append(unregistered, name+\": \"+chain)\n506|\t\t}\n507|\t}\n508|\tif scanned == 0 {\n509|\t\tt.Fatal(\"chain census scanned zero production files\")\n510|\t}\n511|\tsort.Strings(unregistered)\n512|\tif len(unregistered) > 0 {\n513|\t\tt.Fatalf(\"unregistered inline vocabular%s:\\n  %s\",\n514|\t\t\tmap[bool]string{true: \"y\", false: \"ies\"}[len(unregistered) == 1],\n515|\t\t\tstrings.Join(unregistered, \"\\n  \"))\n516|\t}\n517|\tt.Logf(\"chain census: no inline vocabularies across %d files\", scanned)\n518|}\n519|\n520|// inlineChainComparison is one equality comparison inside a\n521|// boolean chain: the rendered operand plus the closed value it is\n522|// compared against.\n523|type inlineChainComparison struct {\n524|\toperand string\n525|\tvalue   string\n526|}\n527|\n528|// inlineVocabulariesInFile reports every operand compared against\n529|// two or more distinct closed values inside one boolean chain of\n530|// the file, as \"operand <- value, value\" strings. Groups merge\n531|// only within a single chain subtree, never across statements.\n532|func inlineVocabulariesInFile(fileSet *token.FileSet, syntax *ast.File) []string {\n533|\tseen := map[string]struct{}{}\n534|\tvar unregistered []string\n535|\tast.Inspect(syntax, func(node ast.Node) bool {\n536|\t\tchain, ok := node.(*ast.BinaryExpr)\n537|\t\tif !ok || (chain.Op != token.LOR && chain.Op != token.LAND) {\n538|\t\t\treturn true\n539|\t\t}\n540|\t\tvar comparisons []inlineChainComparison\n541|\t\tflattenChainComparisons(fileSet, chain, &comparisons)\n542|\t\tgroups := map[string]map[string]struct{}{}\n543|\t\tfor _, comparison := range comparisons {\n544|\t\t\tif comparison.operand == \"\" || comparison.value == \"\" {\n545|\t\t\t\tcontinue\n546|\t\t\t}\n547|\t\t\tset := groups[comparison.operand]\n548|\t\t\tif set == nil {\n549|\t\t\t\tset = map[string]struct{}{}\n550|\t\t\t\tgroups[comparison.operand] = set\n551|\t\t\t}\n552|\t\t\tset[comparison.value] = struct{}{}\n553|\t\t}\n554|\t\tfor operand, values := range groups {\n555|\t\t\tif len(values) < 2 {\n556|\t\t\t\tcontinue\n557|\t\t\t}\n558|\t\t\tvar names []string\n559|\t\t\tfor value := range values {\n560|\t\t\t\tnames = append(names, value)\n561|\t\t\t}\n562|\t\t\tsort.Strings(names)\n563|\t\t\tkey := operand + \" <- \" + strings.Join(names, \", \")\n564|\t\t\tif _, duplicate := seen[key]; duplicate {\n565|\t\t\t\tcontinue\n566|\t\t\t}\n567|\t\t\tseen[key] = struct{}{}\n568|\t\t\tposition := fileSet.Position(chain.Pos())\n569|\t\t\tunregistered = append(unregistered, fmt.Sprintf(\"%s compares %s\", position, key))\n570|\t\t}\n571|\t\treturn true\n572|\t})\n573|\tsort.Strings(unregistered)\n574|\treturn unregistered\n575|}\n576|\n577|// flattenChainComparisons collects every equality comparison in\n578|// one boolean-chain subtree, descending through ||, &&, and\n579|// parentheses. Anything else contributes only itself when it is\n580|// a qualifying comparison.\n581|func flattenChainComparisons(fileSet *token.FileSet, node ast.Node, out *[]inlineChainComparison) {\n582|\tswitch node := node.(type) {\n583|\tcase *ast.ParenExpr:\n584|\t\tflattenChainComparisons(fileSet, node.X, out)\n585|\tcase *ast.BinaryExpr:\n586|\t\tif node.Op == token.LOR || node.Op == token.LAND {\n587|\t\t\tflattenChainComparisons(fileSet, node.X, out)\n588|\t\t\tflattenChainComparisons(fileSet, node.Y, out)\n589|\t\t\treturn\n590|\t\t}\n591|\t\tif node.Op == token.EQL || node.Op == token.NEQ {\n592|\t\t\t*out = append(*out, chainComparisons(fileSet, node)...)\n593|\t\t}\n594|\t}\n595|}\n596|\n597|// chainComparisons renders one equality comparison as operand\n598|// comparisons. A string literal on either side makes the other\n599|// side the operand. Two bare identifiers record both\n600|// orientations, because either side may be the closed constant —\n601|// except the predeclared nil, true, and false, which are presence\n602|// checks, never union members. A bare identifier against a field,\n603|// conversion, or call result makes the composite the operand and\n604|// the identifier the value. Anything else is not a closed-value\n605|// comparison: numeric bounds, rune classifiers, nil presence,\n606|// and field-to-field equality all pass through uncounted.\n607|func chainComparisons(fileSet *token.FileSet, comparison *ast.BinaryExpr) []inlineChainComparison {\n608|\tleft, right := unwrapParens(comparison.X), unwrapParens(comparison.Y)\n609|\tif value, ok := closedValue(left); ok {\n610|\t\tif operand := renderExpr(fileSet, right); operand != \"\" {\n611|\t\t\treturn []inlineChainComparison{{operand: operand, value: value}}\n612|\t\t}\n613|\t\treturn nil\n614|\t}\n615|\tif value, ok := closedValue(right); ok {\n616|\t\tif operand := renderExpr(fileSet, left); operand != \"\" {\n617|\t\t\treturn []inlineChainComparison{{operand: operand, value: value}}\n618|\t\t}\n619|\t\treturn nil\n620|\t}\n621|\tleftIdent, leftIsIdent := left.(*ast.Ident)\n622|\trightIdent, rightIsIdent := right.(*ast.Ident)\n623|\tif leftIsIdent && rightIsIdent {\n624|\t\tif predeclared(leftIdent.Name) || predeclared(rightIdent.Name) {\n625|\t\t\treturn nil\n626|\t\t}\n627|\t\treturn []inlineChainComparison{\n628|\t\t\t{operand: leftIdent.Name, value: rightIdent.Name},\n629|\t\t\t{operand: rightIdent.Name, value: leftIdent.Name},\n630|\t\t}\n631|\t}\n632|\tif leftIsIdent && isCompositeOperand(right) {\n633|\t\tif operand := renderExpr(fileSet, right); operand != \"\" {\n634|\t\t\treturn []inlineChainComparison{{operand: operand, value: leftIdent.Name}}\n635|\t\t}\n636|\t\treturn nil\n637|\t}\n638|\tif rightIsIdent && isCompositeOperand(left) {\n639|\t\tif operand := renderExpr(fileSet, left); operand != \"\" {\n640|\t\t\treturn []inlineChainComparison{{operand: operand, value: rightIdent.Name}}\n641|\t\t}\n642|\t\treturn nil\n643|\t}\n644|\treturn nil\n645|}\n646|\n647|// unwrapParens strips parenthesized wrappers so a parenthesized\n648|// operand still groups with its bare spelling.\n649|func unwrapParens(node ast.Expr) ast.Expr {\n650|\tfor {\n651|\t\tparenthesized, ok := node.(*ast.ParenExpr)\n652|\t\tif !ok {\n653|\t\t\treturn node\n654|\t\t}\n655|\t\tnode = parenthesized.X\n656|\t}\n657|}\n658|\n659|// predeclared reports whether the identifier is a predeclared\n660|// constant: a nil, true, or false comparison is a presence or\n661|// flag check, never a closed-union member.\n662|func predeclared(name string) bool {\n663|\treturn name == \"nil\" || name == \"true\" || name == \"false\"\n664|}\n665|\n666|// isCompositeOperand reports whether the expression is a field,\n667|// conversion, or call result: the shapes a closed constant is\n668|// compared against. Literals, identifiers, and composite\n669|// literals are classified elsewhere or not at all.\n670|func isCompositeOperand(node ast.Expr) bool {\n671|\tswitch node.(type) {\n672|\tcase *ast.SelectorExpr, *ast.CallExpr, *ast.IndexExpr:\n673|\t\treturn true\n674|\t}\n675|\treturn false\n676|}\n677|\n678|// closedValue returns the closed value of a string literal\n679|// operand, unquoted so equivalent spellings group together.\n680|func closedValue(node ast.Expr) (string, bool) {\n681|\tliteral, ok := node.(*ast.BasicLit)\n682|\tif !ok || literal.Kind != token.STRING {\n683|\t\treturn \"\", false\n684|\t}\n685|\tif value, err := strconv.Unquote(literal.Value); err == nil {\n686|\t\treturn value, true\n687|\t}\n688|\treturn literal.Value, true\n689|}\n690|\n691|// renderExpr renders one operand to its source text for grouping:\n692|// two comparisons group only when their operands spell\n693|// identically.\n694|func renderExpr(fileSet *token.FileSet, node ast.Node) string {\n695|\tvar buffer bytes.Buffer\n696|\tif err := printer.Fprint(&buffer, fileSet, node); err != nil {\n697|\t\treturn \"\"\n698|\t}\n699|\treturn buffer.String()\n700|}\n701|\n702|// TestInlineVocabularyDetectorSeesBothShapes proves the table\n703|// scan against synthetic sources: a named-type table resolves\n704|// through the alias, a struct literal through a named type does\n705|// not, multi-name declarations resolve every name (shared,\n706|// paired, and mixed initializers), an inline chain in either\n707|// boolean shape flags, and a single comparison passes. The\n708|// vectors are synthetic on purpose: they prove the scanner, not\n709|// production.\n710|func TestInlineVocabularyDetectorSeesBothShapes(t *testing.T) {\n711|\tparse := func(source string) (*token.FileSet, *ast.File) {\n712|\t\tt.Helper()\n713|\t\tfileSet := token.NewFileSet()\n714|\t\tsyntax, err := parser.ParseFile(fileSet, \"probe.go\", []byte(source), 0)\n715|\t\tif err != nil {\n716|\t\t\tt.Fatalf(\"parse synthetic source: %v\", err)\n717|\t\t}\n718|\t\treturn fileSet, syntax\n719|\t}\n720|\tt.Run(\"named type table resolves\", func(t *testing.T) {\n721|\t\t_, syntax := parse(\"package probe\\ntype names []string\\nvar t = names{\\\"a\\\", \\\"b\\\"}\\n\")\n722|\t\tnamed := map[string]ast.Expr{}\n723|\t\tcollectNamedCompositeTypes(syntax, named)\n724|\t\ttables := vocabularyTablesInFile(syntax, named)\n725|\t\tif len(tables) != 1 || tables[0] != \"t\" {\n726|\t\t\tt.Fatalf(\"named-type table = %v, want [t]\", tables)\n727|\t\t}\n728|\t})\n729|\tt.Run(\"named type alias chain resolves\", func(t *testing.T) {\n730|\t\t_, syntax := parse(\"package probe\\ntype a []string\\ntype b a\\nvar t = b{\\\"a\\\"}\\n\")\n731|\t\tnamed := map[string]ast.Expr{}\n732|\t\tcollectNamedCompositeTypes(syntax, named)\n733|\t\ttables := vocabularyTablesInFile(syntax, named)\n734|\t\tif len(tables) != 1 || tables[0] != \"t\" {\n735|\t\t\tt.Fatalf(\"aliased table = %v, want [t]\", tables)\n736|\t\t}\n737|\t})\n738|\tt.Run(\"struct literal through named type is not a table\", func(t *testing.T) {\n739|\t\t_, syntax := parse(\"package probe\\ntype point struct{ x int }\\nvar p = point{1}\\n\")\n740|\t\tnamed := map[string]ast.Expr{}\n741|\t\tcollectNamedCompositeTypes(syntax, named)\n742|\t\tif tables := vocabularyTablesInFile(syntax, named); len(tables) != 0 {\n743|\t\t\tt.Fatalf(\"struct literal = %v, want no tables\", tables)\n744|\t\t}\n745|\t})\n746|\tt.Run(\"multi-name shared table resolves both names\", func(t *testing.T) {\n747|\t\t_, syntax := parse(\"package probe\\nvar a, b = []string{\\\"x\\\", \\\"y\\\"}\\n\")\n748|\t\tnamed := map[string]ast.Expr{}\n749|\t\tcollectNamedCompositeTypes(syntax, named)\n750|\t\ttables := vocabularyTablesInFile(syntax, named)\n751|\t\tsort.Strings(tables)\n752|\t\tif len(tables) != 2 || tables[0] != \"a\" || tables[1] != \"b\" {\n753|\t\t\tt.Fatalf(\"shared table = %v, want [a b]\", tables)\n754|\t\t}\n755|\t})\n756|\tt.Run(\"multi-name paired tables resolve each name\", func(t *testing.T) {\n757|\t\t_, syntax := parse(\"package probe\\nvar a, b = []string{\\\"x\\\"}, []string{\\\"y\\\"}\\n\")\n758|\t\tnamed := map[string]ast.Expr{}\n759|\t\tcollectNamedCompositeTypes(syntax, named)\n760|\t\ttables := vocabularyTablesInFile(syntax, named)\n761|\t\tsort.Strings(tables)\n762|\t\tif len(tables) != 2 || tables[0] != \"a\" || tables[1] != \"b\" {\n763|\t\t\tt.Fatalf(\"paired tables = %v, want [a b]\", tables)\n764|\t\t}\n765|\t})\n766|\tt.Run(\"multi-name mixed pair resolves only the table\", func(t *testing.T) {\n767|\t\t_, syntax := parse(\"package probe\\ntype point struct{ x int }\\nvar a, b = point{1}, []string{\\\"y\\\"}\\n\")\n768|\t\tnamed := map[string]ast.Expr{}\n769|\t\tcollectNamedCompositeTypes(syntax, named)\n770|\t\ttables := vocabularyTablesInFile(syntax, named)\n771|\t\tif len(tables) != 1 || tables[0] != \"b\" {\n772|\t\t\tt.Fatalf(\"mixed pair = %v, want [b]\", tables)\n773|\t\t}\n774|\t})\n775|\tt.Run(\"or chain of literals flags\", func(t *testing.T) {\n776|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v == \\\"a\\\" || v == \\\"b\\\" }\\n\")\n777|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n778|\t\t\tt.Fatalf(\"or chain = %v, want one unregistered vocabulary\", chains)\n779|\t\t}\n780|\t})\n781|\tt.Run(\"and chain of negations flags\", func(t *testing.T) {\n782|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v != \\\"a\\\" && v != \\\"b\\\" }\\n\")\n783|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n784|\t\t\tt.Fatalf(\"and chain = %v, want one unregistered vocabulary\", chains)\n785|\t\t}\n786|\t})\n787|\tt.Run(\"chain through constants flags\", func(t *testing.T) {\n788|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v != A && v != B }\\n\")\n789|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 1 {\n790|\t\t\tt.Fatalf(\"constant chain = %v, want one unregistered vocabulary\", chains)\n791|\t\t}\n792|\t})\n793|\tt.Run(\"single comparison passes\", func(t *testing.T) {\n794|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(v string) bool { return v == \\\"a\\\" }\\n\")\n795|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 0 {\n796|\t\t\tt.Fatalf(\"single comparison = %v, want no unregistered vocabulary\", chains)\n797|\t\t}\n798|\t})\n799|\tt.Run(\"field to field equality passes\", func(t *testing.T) {\n800|\t\tfileSet, syntax := parse(\"package probe\\nfunc f(a, b point) bool { return a.x != b.x || a.y != b.y }\\n\")\n801|\t\tif chains := inlineVocabulariesInFile(fileSet, syntax); len(chains) != 0 {\n802|\t\t\tt.Fatalf(\"field equality = %v, want no unregistered vocabulary\", chains)\n803|\t\t}\n804|\t})\n805|}\n806|\n807|// sentenceEnd scans the first sentence terminator in text after a\n808|// member-list marker: the first period outside a code span that is\n809|// not a digit-period-digit abbreviation like Section 7.5 or\n810|// Structured Error 1.1. Normative member sentences never end\n811|// mid-list any other way, so any other period ends the scan.\n812|func sentenceEnd(rest string) int {\n813|\tinCode := false\n814|\tfor offset := 0; offset < len(rest); offset++ {\n815|\t\tif strings.HasPrefix(rest[offset:], \"<code>\") {\n816|\t\t\tinCode = true\n817|\t\t\tcontinue\n818|\t\t}\n819|\t\tif strings.HasPrefix(rest[offset:], \"</code>\") {\n820|\t\t\tinCode = false\n821|\t\t\tcontinue\n822|\t\t}\n823|\t\tif rest[offset] != '.' || inCode {\n824|\t\t\tcontinue\n825|\t\t}\n826|\t\tprevious, next := byte(0), byte(0)\n827|\t\tif offset > 0 {\n828|\t\t\tprevious = rest[offset-1]\n829|\t\t}\n830|\t\tif offset+1 < len(rest) {\n831|\t\t\tnext = rest[offset+1]\n832|\t\t}\n833|\t\tif previous >= '0' && previous <= '9' && next >= '0' && next <= '9' {\n834|\t\t\tcontinue\n835|\t\t}\n836|\t\treturn offset\n837|\t}\n838|\treturn -1\n839|}\n840|\n841|// sentenceMembers collects the member names of one scanned\n842|// sentence: every code span contributes the name before its first\n843|// colon or equals sign, in document order.\n844|func sentenceMembers(t *testing.T, marker, sentence string) []string {\n845|\tt.Helper()\n846|\tvar members []string\n847|\tfor {\n848|\t\topen := strings.Index(sentence, \"<code>\")\n849|\t\tif open < 0 {\n850|\t\t\tbreak\n851|\t\t}\n852|\t\tsentence = sentence[open+len(\"<code>\"):]\n853|\t\tclose := strings.Index(sentence, \"</code>\")\n854|\t\tif close < 0 {\n855|\t\t\tt.Fatalf(\"unbalanced code span after %q\", marker)\n856|\t\t}\n857|\t\tspan := sentence[:close]\n858|\t\tsentence = sentence[close+len(\"</code>\"):]\n859|\t\tname := span\n860|\t\tif index := strings.IndexAny(span, \":=\"); index >= 0 {\n861|\t\t\tname = span[:index]\n862|\t\t}\n863|\t\tmembers = append(members, name)\n864|\t}\n865|\tif len(members) == 0 {\n866|\t\tt.Fatalf(\"derived no members for %q; the parser is broken\", marker)\n867|\t}\n868|\treturn members\n869|}\n870|\n871|// deriveTypeMembers parses one \"<code>Type</code> contains\n872|// exactly ...\" sentence from the pinned document into its member\n873|// list in document order. A missing marker or an empty derivation\n874|// fails closed.\n875|func deriveTypeMembers(t *testing.T, text, marker string) []string {\n876|\tt.Helper()\n877|\treturn deriveTypeMembersWith(t, text, marker, \"\")\n878|}\n879|\n880|// deriveTypeMembersWith selects among repeated homonymous\n881|// sentences: the pinned document states the request envelope and\n882|// the capability value in more than one section with different\n883|// members, so the selector names a structural fragment only the\n884|// Session Adapter sentence carries. An empty selector keeps the\n885|// first occurrence. The derivation still parses the whole\n886|// selected sentence; no production value is matched.\n887|func deriveTypeMembersWith(t *testing.T, text, marker, selector string) []string {\n888|\tt.Helper()\n889|\tremaining := text\n890|\tfor {\n891|\t\tindex := strings.Index(remaining, marker)\n892|\t\tif index < 0 {\n893|\t\t\tt.Fatalf(\"spec marker %q with selector %q not found; the derivation is broken\", marker, selector)\n894|\t\t}\n895|\t\trest := remaining[index+len(marker):]\n896|\t\tend := sentenceEnd(rest)\n897|\t\tif end < 0 {\n898|\t\t\tt.Fatalf(\"spec sentence for %q never terminates\", marker)\n899|\t\t}\n900|\t\tsentence := rest[:end]\n901|\t\tif selector == \"\" || strings.Contains(sentence, selector) {\n902|\t\t\treturn sentenceMembers(t, marker, sentence)\n903|\t\t}\n904|\t\tremaining = rest\n905|\t}\n906|}\n907|\n908|// memberSetKeys returns the keys of one production member map.\n909|func memberSetKeys(set map[string]bool) []string {\n910|\tkeys := make([]string, 0, len(set))\n911|\tfor name := range set {\n912|\t\tkeys = append(keys, name)\n913|\t}\n914|\tsort.Strings(keys)\n915|\treturn keys\n916|}\n917|\n918|// TestClosedMemberSetsAreDerivedFromSpec requires every closed\n919|// body to equal its pinned definition in order: the production\n920|// Required list must match the document sequence exactly, and\n921|// the Members map must hold exactly the same names. A dropped,\n922|// added, or reordered member reddens here. Both halves matter:\n923|// the Required list drives the missing-member refusal, the\n924|// Members map drives the unknown-member gate, and pinning only\n925|// the list leaves a widened map admitting an extra member with\n926|// every test green. SupportedContractVersions carries no\n927|// production gate map, so its row pins the Required list only.\n928|func TestClosedMemberSetsAreDerivedFromSpec(t *testing.T) {\n929|\tif _, err := specdoc.Load(); err != nil {\n930|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n931|\t}\n932|\ttext := string(specdoc.Bytes())\n933|\t// selectors disambiguate the two member sentences the pinned\n934|\t// document repeats across sections with different members: the\n935|\t// request envelope (Sections 7.5-style, 7.8, and 7.9 each state\n936|\t// one) and the capability value (the Provider Probe and Session\n937|\t// Adapter Probe sentences differ). Each selector is a structural\n938|\t// fragment only the Session Adapter sentence carries.\n939|\tselectors := map[string]string{\n940|\t\t\"request envelope\": \"<code>deadline</code>, and <code>body</code>\",\n941|\t\t\"capability value\": \"<code>detail:string[0..2048]</code>\",\n942|\t}\n943|\tordered := []struct {\n944|\t\tname     string\n945|\t\tmarker   string\n946|\t\trequired []string\n947|\t\tmembers  map[string]bool\n948|\t}{\n949|\t\t{\"request envelope\", \"The request envelope contains exactly\", requestRequired, requestMembers},\n950|\t\t{\"AdapterCallContext\", \"<code>AdapterCallContext</code> contains exactly\", contextRequired, contextMembers},\n951|\t\t{\"ReadAuthority\", \"<code>ReadAuthority</code> contains exactly\", readAuthorityRequired, readAuthorityMembers},\n952|\t\t{\"ObjectAuthority\", \"<code>ObjectAuthority</code> contains exactly\", objectAuthorityRequired, objectAuthorityMembers},\n953|\t\t{\"SourceSelector\", \"<code>SourceSelector</code> contains exactly\", sourceSelectorRequired, sourceSelectorMembers},\n954|\t\t{\"AdapterFinding\", \"<code>AdapterFinding</code> contains exactly\", findingRequired, findingMembers},\n955|\t\t{\"ResourceLimits\", \"<code>ResourceLimits</code> contains exactly\", resourceLimitsRequired, resourceLimitsMembers},\n956|\t\t{\"CapturePlanItem\", \"<code>CapturePlanItem</code> contains exactly\", capturePlanItemRequired, capturePlanItemMembers},\n957|\t\t{\"Session Adapter Probe\", \"Session Adapter Probe 1.0.0 is closed and contains exactly\", probeRequired, probeMembers},\n958|\t\t{\"Environment Tuple\", \"Environment Tuple contains exactly\", tupleRequired, tupleMembers},\n959|\t\t{\"SupportedEnvironmentTupleKey\", \"<code>SupportedEnvironmentTupleKey</code> contains exactly\", tupleKeyRequired, tupleKeyMembers},\n960|\t\t{\"SupportedEnvironmentTupleEntry\", \"<code>SupportedEnvironmentTupleEntry</code> contains exactly\", tupleEntryRequired, tupleEntryMembers},\n961|\t\t{\"SupportedContractVersions\", \"<code>SupportedContractVersions</code> contains exactly\", []string{\"contract_id\", \"versions\"}, nil},\n962|\t\t{\"FixtureEvidence\", \"<code>FixtureEvidence</code> contains exactly\", fixtureEvidenceRequired, fixtureEvidenceMembers},\n963|\t\t{\"ResumeSmokeEvidence\", \"<code>ResumeSmokeEvidence</code> contains exactly\", smokeEvidenceRequired, smokeEvidenceMembers},\n964|\t\t{\"FidelityLimit\", \"<code>FidelityLimit</code> contains exactly\", fidelityLimitRequired, fidelityLimitMembers},\n965|\t\t{\"capability value\", \"Each capability value contains exactly\", capabilityValueRequired, capabilityValueMembers},\n966|\t}\n967|\tmapComparisons := 0\n968|\tfor _, test := range ordered {\n969|\t\tt.Run(test.name, func(t *testing.T) {\n970|\t\t\tderived := deriveTypeMembersWith(t, text, test.marker, selectors[test.name])\n971|\t\t\tif strings.Join(derived, \",\") != strings.Join(test.required, \",\") {\n972|\t\t\t\tt.Errorf(\"%s required = %v, want derived %v\", test.name, test.required, derived)\n973|\t\t\t}\n974|\t\t\tif test.members != nil {\n975|\t\t\t\tmapComparisons++\n976|\t\t\t\tderivedSet := append([]string(nil), derived...)\n977|\t\t\t\tsort.Strings(derivedSet)\n978|\t\t\t\tif strings.Join(derivedSet, \",\") != strings.Join(memberSetKeys(test.members), \",\") {\n979|\t\t\t\t\tt.Errorf(\"%s members = %v, want derived %v\", test.name, memberSetKeys(test.members), derivedSet)\n980|\t\t\t\t}\n981|\t\t\t}\n982|\t\t})\n983|\t}\n984|\t// The success and failure envelopes reuse the request's first\n985|\t// four identity fields by an explicit rule, so their\n986|\t// derivation transforms the request list rather than\n987|\t// re-parsing prose. The gate maps are pinned as sets against\n988|\t// the same derivation: a widened successMembers admits a\n989|\t// frame carrying the planted member while the control\n990|\t// refuses, with the Required comparison green.\n991|\trequest := deriveTypeMembers(t, text, \"The request envelope contains exactly\")\n992|\tfirstFour := request[:4]\n993|\twantSuccess := append(append([]string(nil), firstFour...), \"ok\", \"body\")\n994|\tif strings.Join(wantSuccess, \",\") != strings.Join(successRequired, \",\") {\n995|\t\tt.Errorf(\"success required = %v, want %v\", successRequired, wantSuccess)\n996|\t}\n997|\tmapComparisons++\n998|\twantSuccessSet := append([]string(nil), wantSuccess...)\n999|\tsort.Strings(wantSuccessSet)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
