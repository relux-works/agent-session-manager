{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f1","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":723,"recorded_at":1780531400001441,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"bcf86d9d-0ffd-4676-b89e-25816aa4578b"},"task_id":"bcf86d9d-0ffd-4676-b89e-25816aa4578b","event":{"kind":"output","task_id":"bcf86d9d-0ffd-4676-b89e-25816aa4578b","chunk":"Read text file `internal/sessadapter/operations.go`.\n(1029 line(s) above)\n1030|\t\t}\n1031|\t}\n1032|\treturn elements, nil\n1033|}\n1034|\n1035|// checkExcludedClasses validates the sorted unique capture-class\n1036|// array in the [0..9] count bound.\n1037|func checkExcludedClasses(raw json.RawMessage) error {\n1038|\telements, ok := decodeArray(bytesTrimSpace(raw))\n1039|\tif !ok {\n1040|\t\tfailure, err := failProtocol(\"capture excluded classes are not an array\", \"excluded_classes\")\n1041|\t\tif err != nil {\n1042|\t\t\treturn err\n1043|\t\t}\n1044|\t\treturn failure\n1045|\t}\n1046|\tif uint64(len(elements)) > 9 {\n1047|\t\tfailure, err := failProtocol(\"capture excluded classes exceed 9 entries\", \"excluded_classes\")\n1048|\t\tif err != nil {\n1049|\t\t\treturn err\n1050|\t\t}\n1051|\t\treturn failure\n1052|\t}\n1053|\tprevious := \"\"\n1054|\tfor _, element := range elements {\n1055|\t\tclass, ok := rawString(element)\n1056|\t\tif !ok || !validCaptureClass(class) {\n1057|\t\t\tfailure, err := failProtocol(\"capture excluded class is outside the nine-class vocabulary\", \"excluded_classes\")\n1058|\t\t\tif err != nil {\n1059|\t\t\t\treturn err\n1060|\t\t\t}\n1061|\t\t\treturn failure\n1062|\t\t}\n1063|\t\tif previous >= class && previous != \"\" {\n1064|\t\t\tfailure, err := failProtocol(\"capture excluded classes are not sorted unique\", \"excluded_classes\")\n1065|\t\t\tif err != nil {\n1066|\t\t\t\treturn err\n1067|\t\t\t}\n1068|\t\t\treturn failure\n1069|\t\t}\n1070|\t\tprevious = class\n1071|\t}\n1072|\treturn nil\n1073|}\n1074|\n1075|// checkValidateResult validates one validate success body: the\n1076|// mode echoes the request mode, and valid=true requires every\n1077|// applicable check true with no error finding. A null applicable\n1078|// check is not applicable and is skipped; a false one fails the\n1079|// conjunction. Target nullability is a request-body rule only:\n1080|// the success body carries no target members, so there is nothing\n1081|// to check here.\n1082|func checkValidateResult(members map[string]json.RawMessage, facts SuccessFacts) error {\n1083|\tmode, ok := rawString(members[\"mode\"])\n1084|\tif !ok || !validValidateMode(mode) {\n1085|\t\tfailure, err := failProtocol(\"validate result mode is outside staged|live|archive\", \"mode\")\n1086|\t\tif err != nil {\n1087|\t\t\treturn err\n1088|\t\t}\n1089|\t\treturn failure\n1090|\t}\n1091|\tif mode != facts.ValidateMode {\n1092|\t\tfailure, err := failProtocol(\"validate result mode does not echo the request mode\", \"mode\")\n1093|\t\tif err != nil {\n1094|\t\t\treturn err\n1095|\t\t}\n1096|\t\treturn failure\n1097|\t}\n1098|\tstructural, err := requireBool(members, \"structural_valid\")\n1099|\tif err != nil {\n1100|\t\treturn err\n1101|\t}\n1102|\tsemantic, err := requireBool(members, \"semantic_marker_valid\")\n1103|\tif err != nil {\n1104|\t\treturn err\n1105|\t}\n1106|\tfor _, name := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n1107|\t\tif err := requireNullableBool(members, name); err != nil {\n1108|\t\t\treturn err\n1109|\t\t}\n1110|\t}\n1111|\tfindings, err := DecodeFindings(members[\"findings\"], 4096)\n1112|\tif err != nil {\n1113|\t\treturn err\n1114|\t}\n1115|\tif err := requireDigest(members, \"evidence_digest\"); err != nil {\n1116|\t\treturn err\n1117|\t}\n1118|\tvalid, err := requireBool(members, \"valid\")\n1119|\tif err != nil {\n1120|\t\treturn err\n1121|\t}\n1122|\tif !valid {\n1123|\t\treturn nil\n1124|\t}\n1125|\tif !structural || !semantic {\n1126|\t\tfailure, err := failProtocol(\"validate reports valid with a failed structural or semantic check\", \"valid\")\n1127|\t\tif err != nil {\n1128|\t\t\treturn err\n1129|\t\t}\n1130|\t\treturn failure\n1131|\t}\n1132|\tfor _, name := range []string{\"identity_valid\", \"workspace_binding_valid\", \"resume_surface_valid\"} {\n1133|\t\tif !isNull(members[name]) {\n1134|\t\t\tapplicable, _ := rawBool(members[name])\n1135|\t\t\tif !applicable {\n1136|\t\t\t\tfailure, err := failProtocol(\"validate reports valid with a failed applicable check\", name)\n1137|\t\t\t\tif err != nil {\n1138|\t\t\t\t\treturn err\n1139|\t\t\t\t}\n1140|\t\t\t\treturn failure\n1141|\t\t\t}\n1142|\t\t}\n1143|\t}\n1144|\tfor _, finding := range findings {\n1145|\t\tif finding.Severity == \"error\" {\n1146|\t\t\tfailure, err := failProtocol(\"validate reports valid with an error finding\", \"findings\")\n1147|\t\t\tif err != nil {\n1148|\t\t\t\treturn err\n1149|\t\t\t}\n1150|\t\t\treturn failure\n1151|\t\t}\n1152|\t}\n1153|\treturn nil\n1154|}"}}}
