{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c78f","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":546,"recorded_at":1780531400001087,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"call_id":"call_01a074775bb37520bf38f4dddbad39ca","text":"Read text file `internal/sessadapter/envelope_test.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n9|)\n10|\n11|// fixtureRequestFrame builds one valid request frame for the\n12|// operation with the probe-shaped body replaced by the caller.\n13|func fixtureRequestFrame(t *testing.T, operation Operation, body string) []byte {\n14|\tt.Helper()\n15|\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":%q,\"deadline\":%q,\"body\":%s}`,\n16|\t\tProtocolID, fixtureRequestID, string(operation), fixtureDeadline, body))\n17|}\n18|\n19|// wantRequest is the Request a valid doctor frame decodes to.\n20|func wantRequest() Request {\n21|\treturn Request{Operation: OpDoctor, RequestID: fixtureRequestID}\n22|}\n23|\n24|func TestDecodeRequestFrameAcceptsValidEnvelope(t *testing.T) {\n25|\tframe := fixtureRequestFrame(t, OpDoctor, `{\"context\":{},\"direction\":\"source_read\",\"tuple_registry_digest\":\"`+fixtureRegistryDigest+`\",\"refresh_requested\":false,\"extensions\":{}}`)\n26|\tgot, err := DecodeRequestFrame(frame)\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"DecodeRequestFrame: %v\", err)\n29|\t}\n30|\tif got.Operation != OpDoctor || got.RequestID != fixtureRequestID {\n31|\t\tt.Fatalf(\"DecodeRequestFrame = %+v, want doctor/%s\", got, fixtureRequestID)\n32|\t}\n33|}\n34|\n35|func TestDecodeRequestFrameRefusals(t *testing.T) {\n36|\tvalidBody := `{\"expected_provider_id\":\"test-provider\",\"expected_candidate_kind\":\"builtin\",\"extensions\":{}}`\n37|\tfor _, test := range []struct {\n38|\t\tname  string\n39|\t\tframe func() []byte\n40|\t\tcode  axerror.Code\n41|\t\tkey   string\n42|\t\tvalue string\n43|\t\ttext  string\n44|\t}{\n45|\t\t{\n46|\t\t\tname:  \"empty frame\",\n47|\t\t\tframe: func() []byte { return nil },\n48|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"\", text: \"request frame is empty\",\n49|\t\t},\n50|\t\t{\n51|\t\t\tname:  \"non object frame\",\n52|\t\t\tframe: func() []byte { return []byte(`[1,2]`) },\n53|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"\", text: \"request envelope not a JSON object\",\n54|\t\t},\n55|\t\t{\n56|\t\t\tname: \"unknown envelope member\",\n57|\t\t\tframe: func() []byte {\n58|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"unexpected\", `true`)\n59|\t\t\t},\n60|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"unexpected\", text: \"unknown member\",\n61|\t\t},\n62|\t\t{\n63|\t\t\tname:  \"missing operation\",\n64|\t\t\tframe: func() []byte { return dropMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"operation\") },\n65|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"operation\", text: \"misses a required member\",\n66|\t\t},\n67|\t\t{\n68|\t\t\tname: \"wrong protocol\",\n69|\t\t\tframe: func() []byte {\n70|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"protocol\", `\"urn:ax:protocol:provider\"`)\n71|\t\t\t},\n72|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"protocol\", text: \"not the session adapter\",\n73|\t\t},\n74|\t\t{\n75|\t\t\tname: \"wrong version\",\n76|\t\t\tframe: func() []byte {\n77|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"protocol_version\", `\"2.0.0\"`)\n78|\t\t\t},\n79|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"protocol_version\", text: \"not 1.0.0\",\n80|\t\t},\n81|\t\t{\n82|\t\t\tname: \"non uuid request id\",\n83|\t\t\tframe: func() []byte {\n84|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"request_id\", `\"not-a-uuid\"`)\n85|\t\t\t},\n86|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"request_id\", text: \"not a UUIDv7\",\n87|\t\t},\n88|\t\t{\n89|\t\t\tname: \"unknown operation\",\n90|\t\t\tframe: func() []byte {\n91|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"operation\", `\"launch\"`)\n92|\t\t\t},\n93|\t\t\tcode: \"operation_unknown\", key: \"operation\", value: \"launch\", text: \"outside the closed registry\",\n94|\t\t},\n95|\t\t{\n96|\t\t\tname:  \"empty operation\",\n97|\t\t\tframe: func() []byte { return mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"operation\", `\"\"`) },\n98|\t\t\tcode:  \"operation_unknown\", key: \"operation\", value: \"\", text: \"outside the closed registry\",\n99|\t\t},\n100|\t\t{\n101|\t\t\tname: \"bad deadline\",\n102|\t\t\tframe: func() []byte {\n103|\t\t\t\treturn mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"deadline\", `\"yesterday\"`)\n104|\t\t\t},\n105|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"deadline\", text: \"not a timestamp\",\n106|\t\t},\n107|\t\t{\n108|\t\t\tname:  \"non object body\",\n109|\t\t\tframe: func() []byte { return mutateMember(t, fixtureRequestFrame(t, OpProbe, validBody), \"body\", `[]`) },\n110|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"body\", text: \"not a JSON object\",\n111|\t\t},\n112|\t\t{\n113|\t\t\tname: \"duplicate member\",\n114|\t\t\tframe: func() []byte {\n115|\t\t\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:session-adapter\",\"protocol_version\":\"1.0.0\",\"request_id\":\"` + fixtureRequestID + `\",\"operation\":\"probe\",\"operation\":\"probe\",\"deadline\":\"` + fixtureDeadline + `\",\"body\":{}}`)\n116|\t\t\t},\n117|\t\t\tcode: \"session_adapter_protocol_error\", key: \"member\", value: \"operation\", text: \"duplicate member\",\n118|\t\t},\n119|\t} {\n120|\t\tt.Run(test.name, func(t *testing.T) {\n121|\t\t\t_, err := DecodeRequestFrame(test.frame())\n122|\t\t\trequireRefusal(t, err, test.code, test.key, test.value, test.text)\n123|\t\t})\n124|\t}\n125|}\n126|\n127|func TestDecodeRequestFrameRefusesOversizeFrame(t *testing.T) {\n128|\tpadding := strings.Repeat(\"a\", MaxFrameBytes)\n129|\tframe := fixtureRequestFrame(t, OpProbe, `{\"expected_provider_id\":\"`+padding+`\",\"expected_candidate_kind\":\"builtin\",\"extensions\":{}}`)\n130|\tif len(frame) <= MaxFrameBytes {\n131|\t\tt.Fatalf(\"oversize fixture is %d bytes, want above %d\", len(frame), MaxFrameBytes)\n132|\t}\n133|\t_, err := DecodeRequestFrame(frame)\n134|\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"\", \"exceeds the 8 MiB bound\")\n135|}\n136|\n137|// TestFrameBoundEdges pins the 8 MiB bound at exactly\n138|// MaxFrameBytes (admitted past the length gate) and\n139|// MaxFrameBytes+1 (refused) for all three envelope entry\n140|// points. A frame of exactly the bound must fail on content,\n141|// never on length; one byte more must fail on length. Either\n142|// off-by-one — `> MaxFrameBytes+1` admitting the neighbour, or\n143|// `>= MaxFrameBytes` refusing the edge — reddens here.\n144|func TestFrameBoundEdges(t *testing.T) {\n145|\tpadTo := func(size int) []byte {\n146|\t\tbase := []byte(`{\"pad\":\"\"}`)\n147|\t\tif size < len(base) {\n148|\t\t\tt.Fatalf(\"bound %d is below the %d-byte probe skeleton\", size, len(base))\n149|\t\t}\n150|\t\tprobe := []byte(`{\"pad\":\"` + strings.Repeat(\"a\", size-len(base)) + `\"}`)\n151|\t\tif len(probe) != size {\n152|\t\t\tt.Fatalf(\"padded probe is %d bytes, want %d\", len(probe), size)\n153|\t\t}\n154|\t\treturn probe\n155|\t}\n156|\texact, over := padTo(MaxFrameBytes), padTo(MaxFrameBytes+1)\n157|\tfor _, gate := range []struct {\n158|\t\tname  string\n159|\t\tcheck func(frame []byte) error\n160|\t}{\n161|\t\t{\"request\", func(frame []byte) error { _, err := DecodeRequestFrame(frame); return err }},\n162|\t\t{\"success\", func(frame []byte) error { _, err := CheckSuccessEnvelope(frame, wantRequest()); return err }},\n163|\t\t{\"failure\", func(frame []byte) error { _, err := CheckFailureEnvelope(frame, wantRequest()); return err }},\n164|\t} {\n165|\t\tt.Run(gate.name+\"/exact bound admits past length\", func(t *testing.T) {\n166|\t\t\terr := gate.check(exact)\n167|\t\t\tif err == nil {\n168|\t\t\t\tt.Fatal(\"exact-bound probe passed every gate; the probe is broken, not the bound\")\n169|\t\t\t}\n170|\t\t\tif strings.Contains(err.Error(), \"exceeds the 8 MiB bound\") {\n171|\t\t\t\tt.Fatalf(\"exact-bound frame refused on length: %v\", err)\n172|\t\t\t}\n173|\t\t})\n174|\t\tt.Run(gate.name+\"/one over refuses on length\", func(t *testing.T) {\n175|\t\t\terr := gate.check(over)\n176|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", \"member\", \"\", \"exceeds the 8 MiB bound\")\n177|\t\t})\n178|\t}\n179|}\n180|\n181|func TestCheckSuccessEnvelopeAcceptsValidFrame(t *testing.T) {\n182|\tbody := `{\"direction\":\"source_read\"}`\n183|\tframe := []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":true,\"body\":%s}`,\n184|\t\tProtocolID, fixtureRequestID, body))\n185|\tgot, err := CheckSuccessEnvelope(frame, wantRequest())\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"CheckSuccessEnvelope: %v\", err)\n188|\t}\n189|\tif string(got) != body {\n190|\t\tt.Fatalf(\"CheckSuccessEnvelope body = %s, want %s\", got, body)\n191|\t}\n192|}\n193|\n194|func TestCheckSuccessEnvelopeRefusals(t *testing.T) {\n195|\tgood := func() []byte {\n196|\t\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":true,\"body\":{}}`,\n197|\t\t\tProtocolID, fixtureRequestID))\n198|\t}\n199|\tfor _, test := range []struct {\n200|\t\tname  string\n201|\t\tframe func() []byte\n202|\t\tkey   string\n203|\t\tvalue string\n204|\t\ttext  string\n205|\t}{\n206|\t\t{\n207|\t\t\tname:  \"error member on success\",\n208|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"error\", `{\"code\":\"x\"}`) },\n209|\t\t\tkey:   \"member\", value: \"error\", text: \"unknown member\",\n210|\t\t},\n211|\t\t{\n212|\t\t\tname:  \"missing body\",\n213|\t\t\tframe: func() []byte { return dropMember(t, good(), \"body\") },\n214|\t\t\tkey:   \"member\", value: \"body\", text: \"misses a required member\",\n215|\t\t},\n216|\t\t{\n217|\t\t\tname:  \"request id mismatch\",\n218|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"request_id\", `\"0198f4c8-8e50-7f66-8f70-1234567890aa\"`) },\n219|\t\t\tkey:   \"member\", value: \"request_id\", text: \"does not echo\",\n220|\t\t},\n221|\t\t{\n222|\t\t\tname:  \"operation mismatch\",\n223|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"operation\", `\"probe\"`) },\n224|\t\t\tkey:   \"member\", value: \"operation\", text: \"does not echo\",\n225|\t\t},\n226|\t\t{\n227|\t\t\tname:  \"protocol mismatch\",\n228|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"protocol\", `\"urn:ax:protocol:provider\"`) },\n229|\t\t\tkey:   \"member\", value: \"protocol\", text: \"does not echo\",\n230|\t\t},\n231|\t\t{\n232|\t\t\tname:  \"version mismatch\",\n233|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"protocol_version\", `\"9.9.9\"`) },\n234|\t\t\tkey:   \"member\", value: \"protocol_version\", text: \"does not echo\",\n235|\t\t},\n236|\t\t{\n237|\t\t\tname:  \"ok false\",\n238|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"ok\", `false`) },\n239|\t\t\tkey:   \"member\", value: \"ok\", text: \"does not carry ok=true\",\n240|\t\t},\n241|\t\t{\n242|\t\t\tname:  \"null body\",\n243|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"body\", `null`) },\n244|\t\t\tkey:   \"member\", value: \"body\", text: \"not a JSON object\",\n245|\t\t},\n246|\t} {\n247|\t\tt.Run(test.name, func(t *testing.T) {\n248|\t\t\t_, err := CheckSuccessEnvelope(test.frame(), wantRequest())\n249|\t\t\trequireRefusal(t, err, \"session_adapter_protocol_error\", test.key, test.value, test.text)\n250|\t\t})\n251|\t}\n252|}\n253|\n254|func TestCheckFailureEnvelopeAcceptsBoundError(t *testing.T) {\n255|\tframe := []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.1.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`,\n256|\t\tProtocolID, fixtureRequestID))\n257|\treported, err := CheckFailureEnvelope(frame, wantRequest())\n258|\tif err != nil {\n259|\t\tt.Fatalf(\"CheckFailureEnvelope: %v\", err)\n260|\t}\n261|\tif reported.Code() != \"capability_unavailable\" || reported.ExitCode() != 6 {\n262|\t\tt.Fatalf(\"reported = %s/%d, want capability_unavailable/6\", reported.Code(), reported.ExitCode())\n263|\t}\n264|}\n265|\n266|func TestCheckFailureEnvelopeRefusals(t *testing.T) {\n267|\tgood := func() []byte {\n268|\t\treturn []byte(fmt.Sprintf(`{\"protocol\":%q,\"protocol_version\":\"1.0.0\",\"request_id\":%q,\"operation\":\"doctor\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.1.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`,\n269|\t\t\tProtocolID, fixtureRequestID))\n270|\t}\n271|\tfor _, test := range []struct {\n272|\t\tname  string\n273|\t\tframe func() []byte\n274|\t\tcode  axerror.Code\n275|\t\tkey   string\n276|\t\tvalue string\n277|\t\ttext  string\n278|\t}{\n279|\t\t{\n280|\t\t\tname:  \"body member on failure\",\n281|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"body\", `{}`) },\n282|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"body\", text: \"unknown member\",\n283|\t\t},\n284|\t\t{\n285|\t\t\tname:  \"ok true\",\n286|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"ok\", `true`) },\n287|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"ok\", text: \"does not carry ok=false\",\n288|\t\t},\n289|\t\t{\n290|\t\t\tname:  \"request id mismatch\",\n291|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"request_id\", `\"0198f4c8-8e50-7f66-8f70-1234567890aa\"`) },\n292|\t\t\tcode:  \"session_adapter_protocol_error\", key: \"member\", value: \"request_id\", text: \"does not echo\",\n293|\t\t},\n294|\t\t{\n295|\t\t\tname: \"wrong error version\",\n296|\t\t\tframe: func() []byte {\n297|\t\t\t\treturn mutateMember(t, good(), \"error\", `{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"the adapter build cannot enumerate this source\",\"exit_code\":6,\"retryable\":false,\"details\":{}}`)\n298|\t\t\t},\n299|\t\t\tcode: \"integrity_failure\", key: \"subject\", value: \"error\", text: \"not a Structured Error 1.1\",\n300|\t\t},\n301|\t\t{\n302|\t\t\tname:  \"non object error\",\n303|\t\t\tframe: func() []byte { return mutateMember(t, good(), \"error\", `null`) },\n304|\t\t\tcode:  \"integrity_failure\", key: \"subject\", value: \"error\", text: \"not a Structured Error 1.1\",\n305|\t\t},\n306|\t} {\n307|\t\tt.Run(test.name, func(t *testing.T) {\n308|\t\t\t_, err := CheckFailureEnvelope(test.frame(), wantRequest())\n309|\t\t\tif test.key == \"\" {\n310|\t\t\t\tif failureCode(t, err) != test.code {\n311|\t\t\t\t\tt.Fatalf(\"code = %v, want %s\", err, test.code)\n312|\t\t\t\t}\n313|\t\t\t\tif !strings.Contains(err.Error(), test.text) {\n314|\t\t\t\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, test.text)\n315|\t\t\t\t}\n316|\t\t\t\treturn\n317|\t\t\t}\n318|\t\t\trequireRefusal(t, err, test.code, test.key, test.value, test.text)\n319|\t\t})\n320|\t}\n321|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
