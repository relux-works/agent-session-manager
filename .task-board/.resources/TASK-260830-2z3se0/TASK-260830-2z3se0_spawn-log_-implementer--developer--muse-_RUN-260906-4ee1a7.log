{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ff","stream":{"kind":"session","id":"01a07476-3862-7671-a25f-75740245e24f"},"sequence":346,"recorded_at":1780531400000687,"record_type":"event","durability":"durable","causation_id":"4727530c-d257-449f-9504-a7a1e57e582a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4727530c-d257-449f-9504-a7a1e57e582a","run_stream":{"kind":"run","id":"4727530c-d257-449f-9504-a7a1e57e582a"},"task_stream":{"kind":"task","id":"0677824d-fd19-435b-a142-1c862f5ea155"},"task_id":"0677824d-fd19-435b-a142-1c862f5ea155","event":{"kind":"output","task_id":"0677824d-fd19-435b-a142-1c862f5ea155","chunk":"Read text file `internal/sessadapter/context.go`.\n(549 line(s) above)\n550|\t}\n551|\tif !sinkEmpty {\n552|\t\tfailure, err := failProtocol(\"object authority fresh sink is not empty\", \"mode\")\n553|\t\tif err != nil {\n554|\t\t\treturn err\n555|\t\t}\n556|\t\treturn failure\n557|\t}\n558|\treturn nil\n559|}\n560|\n561|// sourceSelectorMembers is the exact SourceSelector member set:\n562|// native_session_id, logical_workspace_id, and opaque_source_ref,\n563|// each nullable, with exactly one non-null.\n564|var sourceSelectorMembers = map[string]bool{\n565|\t\"native_session_id\":    true,\n566|\t\"logical_workspace_id\": true,\n567|\t\"opaque_source_ref\":    true,\n568|}\n569|\n570|// sourceSelectorRequired lists sourceSelectorMembers in order.\n571|var sourceSelectorRequired = []string{\n572|\t\"native_session_id\",\n573|\t\"logical_workspace_id\",\n574|\t\"opaque_source_ref\",\n575|}\n576|\n577|// SourceSelector is one validated source selector.\n578|type SourceSelector struct {\n579|\tNativeSessionID    *string\n580|\tLogicalWorkspaceID *string\n581|\tOpaqueSourceRef    *string\n582|}\n583|\n584|// DecodeSourceSelector validates one closed SourceSelector with\n585|// exactly one non-null member: zero names no source, two name an\n586|// ambiguous one, and ambiguity is refused here rather than\n587|// resolved by preference order.\n588|func DecodeSourceSelector(raw json.RawMessage) (SourceSelector, error) {\n589|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n590|\tif fault != nil {\n591|\t\tfailure, err := failProtocol(\"source selector \"+fault.detail, fault.member)\n592|\t\tif err != nil {\n593|\t\t\treturn SourceSelector{}, err\n594|\t\t}\n595|\t\treturn SourceSelector{}, failure\n596|\t}\n597|\tif name, unknown := unknownMember(members, sourceSelectorMembers); unknown {\n598|\t\tfailure, err := failProtocol(\"source selector carries unknown member\", name)\n599|\t\tif err != nil {\n600|\t\t\treturn SourceSelector{}, err\n601|\t\t}\n602|\t\treturn SourceSelector{}, failure\n603|\t}\n604|\tif name, missing := missingMember(members, sourceSelectorRequired); missing {\n605|\t\tfailure, err := failProtocol(\"source selector misses a required member\", name)\n606|\t\tif err != nil {\n607|\t\t\treturn SourceSelector{}, err\n608|\t\t}\n609|\t\treturn SourceSelector{}, failure\n610|\t}\n611|\tvar selector SourceSelector\n612|\tif !isNull(members[\"native_session_id\"]) {\n613|\t\tvalue, ok := checkStringBounds(members[\"native_session_id\"], 1, 512)\n614|\t\tif !ok {\n615|\t\t\tfailure, err := failProtocol(\"source selector native session identifier is not a string[1..512]\", \"native_session_id\")\n616|\t\t\tif err != nil {\n617|\t\t\t\treturn SourceSelector{}, err\n618|\t\t\t}\n619|\t\t\treturn SourceSelector{}, failure\n620|\t\t}\n621|\t\tselector.NativeSessionID = &value\n622|\t}\n623|\tif !isNull(members[\"logical_workspace_id\"]) {\n624|\t\tvalue, ok := checkUUIDv7(members[\"logical_workspace_id\"])\n625|\t\tif !ok {\n626|\t\t\tfailure, err := failProtocol(\"source selector logical workspace identifier is not a UUIDv7\", \"logical_workspace_id\")\n627|\t\t\tif err != nil {\n628|\t\t\t\treturn SourceSelector{}, err\n629|\t\t\t}\n630|\t\t\treturn SourceSelector{}, failure\n631|\t\t}\n632|\t\ttext := value.String()\n633|\t\tselector.LogicalWorkspaceID = &text\n634|\t}\n635|\tif !isNull(members[\"opaque_source_ref\"]) {\n636|\t\tvalue, ok := checkStringBounds(members[\"opaque_source_ref\"], 1, 512)\n637|\t\tif !ok {\n638|\t\t\tfailure, err := failProtocol(\"source selector opaque reference is not a string[1..512]\", \"opaque_source_ref\")\n639|\t\t\tif err != nil {\n640|\t\t\t\treturn SourceSelector{}, err\n641|\t\t\t}\n642|\t\t\treturn SourceSelector{}, failure\n643|\t\t}\n644|\t\tselector.OpaqueSourceRef = &value\n645|\t}\n646|\tcount := 0\n647|\tif selector.NativeSessionID != nil {\n648|\t\tcount++\n649|\t}\n650|\tif selector.LogicalWorkspaceID != nil {\n651|\t\tcount++\n652|\t}\n653|\tif selector.OpaqueSourceRef != nil {\n654|\t\tcount++\n655|\t}\n656|\tif count != 1 {\n657|\t\tfailure, err := failProtocol(\"source selector does not name exactly one source\", \"native_session_id\")\n658|\t\tif err != nil {\n659|\t\t\treturn SourceSelector{}, err\n660|\t\t}\n661|\t\treturn SourceSelector{}, failure\n662|\t}\n663|\treturn selector, nil\n664|}\n665|\n666|// resourceLimitsMembers is the exact ResourceLimits member set.\n667|var resourceLimitsMembers = map[string]bool{\n668|\t\"max_objects\":             true,\n669|\t\"max_total_bytes\":         true,\n670|\t\"max_single_object_bytes\": true,\n671|\t\"max_events\":              true,\n672|\t\"max_target_resources\":    true,\n673|}\n674|\n675|// resourceLimitsRequired lists resourceLimitsMembers in order.\n676|var resourceLimitsRequired = []string{\n677|\t\"max_objects\",\n678|\t\"max_total_bytes\",\n679|\t\"max_single_object_bytes\",\n680|\t\"max_events\",\n681|\t\"max_target_resources\",\n682|}\n683|\n684|// ResourceLimits is one validated projection resource bound.\n685|type ResourceLimits struct {\n686|\tMaxObjects           uint64\n687|\tMaxTotalBytes        uint64\n688|\tMaxSingleObjectBytes uint64\n689|\tMaxEvents            uint64\n690|\tMaxTargetResources   uint64\n691|}\n692|\n693|// DecodeResourceLimits validates one closed ResourceLimits: every\n694|// per-item maximum above zero, the event and resource counts in\n695|// [0..65536], and each per-item maximum no greater than the total.\n696|// The last rule is checked in both directions — a per-item maximum\n697|// above the total would license an object the total cannot hold,\n698|// and a total of zero would license nothing at all.\n699|func DecodeResourceLimits(raw json.RawMessage) (ResourceLimits, error) {\n700|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n701|\tif fault != nil {\n702|\t\tfailure, err := failProtocol(\"resource limits \"+fault.detail, fault.member)\n703|\t\tif err != nil {\n704|\t\t\treturn ResourceLimits{}, err\n705|\t\t}\n706|\t\treturn ResourceLimits{}, failure\n707|\t}\n708|\tif name, unknown := unknownMember(members, resourceLimitsMembers); unknown {\n709|\t\tfailure, err := failProtocol(\"resource limits carry unknown member\", name)\n710|\t\tif err != nil {\n711|\t\t\treturn ResourceLimits{}, err\n712|\t\t}\n713|\t\treturn ResourceLimits{}, failure\n714|\t}\n715|\tif name, missing := missingMember(members, resourceLimitsRequired); missing {\n716|\t\tfailure, err := failProtocol(\"resource limits miss a required member\", name)\n717|\t\tif err != nil {\n718|\t\t\treturn ResourceLimits{}, err\n719|\t\t}\n720|\t\treturn ResourceLimits{}, failure\n721|\t}\n722|\tmaxObjects, ok := checkUint53Bounds(members[\"max_objects\"], 1, maxUint53)\n723|\tif !ok {\n724|\t\tfailure, err := failProtocol(\"resource object limit is not a uint53 above zero\", \"max_objects\")\n725|\t\tif err != nil {\n726|\t\t\treturn ResourceLimits{}, err\n727|\t\t}\n728|\t\treturn ResourceLimits{}, failure\n729|\t}\n730|\tmaxTotalBytes, ok := checkUint53Bounds(members[\"max_total_bytes\"], 1, maxUint53)\n731|\tif !ok {\n732|\t\tfailure, err := failProtocol(\"resource total byte limit is not a uint53 above zero\", \"max_total_bytes\")\n733|\t\tif err != nil {\n734|\t\t\treturn ResourceLimits{}, err\n735|\t\t}\n736|\t\treturn ResourceLimits{}, failure\n737|\t}\n738|\tmaxSingle, ok := checkUint53Bounds(members[\"max_single_object_bytes\"], 1, maxUint53)\n739|\tif !ok {\n740|\t\tfailure, err := failProtocol(\"resource single-object byte limit is not a uint53 above zero\", \"max_single_object_bytes\")\n741|\t\tif err != nil {\n742|\t\t\treturn ResourceLimits{}, err\n743|\t\t}\n744|\t\treturn ResourceLimits{}, failure\n745|\t}\n746|\tmaxEvents, ok := checkUint53Bounds(members[\"max_events\"], 0, 65536)\n747|\tif !ok {\n748|\t\tfailure, err := failProtocol(\"resource event limit is not a uint53 in [0..65536]\", \"max_events\")\n749|\t\tif err != nil {\n750|\t\t\treturn ResourceLimits{}, err\n751|\t\t}\n752|\t\treturn ResourceLimits{}, failure\n753|\t}\n754|\tmaxTargetResources, ok := checkUint53Bounds(members[\"max_target_resources\"], 0, 65536)\n755|\tif !ok {\n756|\t\tfailure, err := failProtocol(\"resource target limit is not a uint53 in [0..65536]\", \"max_target_resources\")\n757|\t\tif err != nil {\n758|\t\t\treturn ResourceLimits{}, err\n759|\t\t}\n760|\t\treturn ResourceLimits{}, failure\n761|\t}\n762|\tif maxObjects > maxTotalBytes {\n763|\t\tfailure, err := failProtocol(\"resource object limit exceeds the total byte limit\", \"max_objects\")\n764|\t\tif err != nil {\n765|\t\t\treturn ResourceLimits{}, err\n766|\t\t}\n767|\t\treturn ResourceLimits{}, failure\n768|\t}\n769|\tif maxSingle > maxTotalBytes {\n770|\t\tfailure, err := failProtocol(\"resource single-object byte limit exceeds the total byte limit\", \"max_single_object_bytes\")\n771|\t\tif err != nil {\n772|\t\t\treturn ResourceLimits{}, err\n773|\t\t}\n774|\t\treturn ResourceLimits{}, failure\n775|\t}\n776|\treturn ResourceLimits{\n777|\t\tMaxObjects:           maxObjects,\n778|\t\tMaxTotalBytes:        maxTotalBytes,\n779|\t\tMaxSingleObjectBytes: maxSingle,\n780|\t\tMaxEvents:            maxEvents,\n781|\t\tMaxTargetResources:   maxTargetResources,\n782|\t}, nil\n783|}\n784|\n785|// findingMembers is the exact AdapterFinding member set: severity,\n786|// code, message, remediation, and extensions.\n787|var findingMembers = map[string]bool{\n788|\t\"severity\":    true,\n789|\t\"code\":        true,\n790|\t\"message\":     true,\n791|\t\"remediation\": true,\n792|\t\"extensions\":  true,\n793|}\n794|\n795|// findingRequired lists findingMembers in order.\n796|var findingRequired = []string{\n797|\t\"severity\",\n798|\t\"code\",\n799|\t\"message\",\n800|\t\"remediation\",\n801|\t\"extensions\",\n802|}\n803|\n804|// Finding is one validated adapter finding.\n805|type Finding struct {\n806|\tSeverity    string\n807|\tCode        string\n808|\tMessage     string\n809|\tRemediation *string\n810|}\n811|\n812|// DecodeFinding validates one closed AdapterFinding: the severity\n813|// in info|warning|error, the code as string[1..128], the message as\n814|// string[1..4096], and the remediation as null or\n815|// string[1..4096].\n816|func DecodeFinding(raw json.RawMessage) (Finding, error) {\n817|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n818|\tif fault != nil {\n819|\t\tfailure, err := failProtocol(\"adapter finding \"+fault.detail, fault.member)\n820|\t\tif err != nil {\n821|\t\t\treturn Finding{}, err\n822|\t\t}\n823|\t\treturn Finding{}, failure\n824|\t}\n825|\tif name, unknown := unknownMember(members, findingMembers); unknown {\n826|\t\tfailure, err := failProtocol(\"adapter finding carries unknown member\", name)\n827|\t\tif err != nil {\n828|\t\t\treturn Finding{}, err\n829|\t\t}\n830|\t\treturn Finding{}, failure\n831|\t}\n832|\tif name, missing := missingMember(members, findingRequired); missing {\n833|\t\tfailure, err := failProtocol(\"adapter finding misses a required member\", name)\n834|\t\tif err != nil {\n835|\t\t\treturn Finding{}, err\n836|\t\t}\n837|\t\treturn Finding{}, failure\n838|\t}\n839|\tseverity, ok := rawString(members[\"severity\"])\n840|\tif !ok || !validFindingSeverity(severity) {\n841|\t\tfailure, err := failProtocol(\"adapter finding severity is outside info|warning|error\", \"severity\")\n842|\t\tif err != nil {\n843|\t\t\treturn Finding{}, err\n844|\t\t}\n845|\t\treturn Finding{}, failure\n846|\t}\n847|\tcode, ok := checkStringBounds(members[\"code\"], 1, 128)\n848|\tif !ok {\n849|\t\tfailure, err := failProtocol(\"adapter finding code is not a string[1..128]\", \"code\")\n850|\t\tif err != nil {\n851|\t\t\treturn Finding{}, err\n852|\t\t}\n853|\t\treturn Finding{}, failure\n854|\t}\n855|\tmessage, ok := checkStringBounds(members[\"message\"], 1, 4096)\n856|\tif !ok {\n857|\t\tfailure, err := failProtocol(\"adapter finding message is not a string[1..4096]\", \"message\")\n858|\t\tif err != nil {\n859|\t\t\treturn Finding{}, err\n860|\t\t}\n861|\t\treturn Finding{}, failure\n862|\t}\n863|\tvar remediation *string\n864|\tif !isNull(members[\"remediation\"]) {\n865|\t\ttext, ok := checkStringBounds(members[\"remediation\"], 1, 4096)\n866|\t\tif !ok {\n867|\t\t\tfailure, err := failProtocol(\"adapter finding remediation is not a string[1..4096]\", \"remediation\")\n868|\t\t\tif err != nil {\n869|\t\t\t\treturn Finding{}, err\n870|\t\t\t}\n871|\t\t\treturn Finding{}, failure\n872|\t\t}\n873|\t\tremediation = &text\n874|\t}\n875|\tif !checkExtensions(members[\"extensions\"]) {\n876|\t\tfailure, err := failProtocol(\"adapter finding extensions are not reverse-DNS keyed\", \"extensions\")\n877|\t\tif err != nil {\n878|\t\t\treturn Finding{}, err\n879|\t\t}\n880|\t\treturn Finding{}, failure\n881|\t}\n882|\treturn Finding{\n883|\t\tSeverity:    severity,\n884|\t\tCode:        code,\n885|\t\tMessage:     message,\n886|\t\tRemediation: remediation,\n887|\t}, nil\n888|}\n889|\n890|// DecodeFindings validates a findings array in the count bound:\n891|// every element a closed AdapterFinding.\n892|func DecodeFindings(raw json.RawMessage, maximum uint64) ([]Finding, error) {\n893|\telements, ok := decodeArray(bytesTrimSpace(raw))\n894|\tif !ok {\n895|\t\tfailure, err := failProtocol(\"adapter findings are n