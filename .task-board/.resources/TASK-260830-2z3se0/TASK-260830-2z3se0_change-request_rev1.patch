+		{"bad mode", "mode", `"append"`, "mode", "outside read|fresh_sink"},
+		{"zero objects on fresh sink", "max_objects", `0`, "mode", "both limits above zero"},
+		{"zero bytes on fresh sink", "max_total_bytes", `0`, "mode", "both limits above zero"},
