+		if err != nil {
+			return Tuple{}, err
+		}
+		return Tuple{}, failure
+	}
+	if _, err := scalar.ParsePlatform(platform); err != nil {
+		failure, faultErr := failProtocol("environment tuple platform is outside linux|macos|windows|wsl2", "platform")
+		if faultErr != nil {
+			return Tuple{}, faultErr
+		}
+		return Tuple{}, failure
+	}
