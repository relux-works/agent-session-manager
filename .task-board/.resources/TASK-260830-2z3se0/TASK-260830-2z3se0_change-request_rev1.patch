+		return Tuple{}, failure
+	}
+	version, ok := checkStringBounds(members["environment_version"], 1, 128)
+	if !ok {
+		failure, err := failProtocol("environment tuple environment version is not a string[1..128]", "environment_version")
+		if err != nil {
+			return Tuple{}, err
+		}
+		return Tuple{}, failure
