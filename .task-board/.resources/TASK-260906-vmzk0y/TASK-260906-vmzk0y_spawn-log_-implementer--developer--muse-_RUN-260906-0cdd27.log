{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c44f","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":130,"recorded_at":1780531400000255,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"ff94cf7f-3e76-4f9c-9600-913327852a62"},"task_id":"ff94cf7f-3e76-4f9c-9600-913327852a62","event":{"kind":"output","task_id":"ff94cf7f-3e76-4f9c-9600-913327852a62","chunk":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"math\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\t\"time\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Wire constants of pinned specification Section 7.2. The protocol\n18|// identifier and version are exact: a different major is never negotiated,\n19|// and anything other than 2.0.0 on the wire is refused or reported as a\n20|// major mismatch, never accepted.\n21|const (\n22|\t// ProtocolID is the exact protocol member every request and response\n23|\t// envelope carries.\n24|\tProtocolID = \"urn:ax:protocol:provider\"\n25|\t// ProtocolVersion is the exact protocol_version member this host\n26|\t// writes and the only one it accepts a response under.\n27|\tProtocolVersion = \"2.0.0\"\n28|\t// ProtocolMajor is the major this host implements. Responses under\n29|\t// any other recognizable major are reported as incompatible_protocol\n30|\t// without trusting their payload.\n31|\tProtocolMajor = 2\n32|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n33|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n34|\t// larger than 8 MiB.\n35|\tMaxFrameBytes = 8 << 20\n36|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n37|\t// resource bound, not a protocol limit: diagnostics beyond it are\n38|\t// dropped. Failure details carry the failure class and member names\n39|\t// only, never stderr content.\n40|\tStderrCapBytes = 1 << 20\n41|)\n42|\n43|// Operation names one Section 7.5 registry entry. The registry is closed:\n44|// dispatch refuses any other name locally, before any process starts.\n45|type Operation string\n46|\n47|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n48|// inventory test derives this list from the pinned specification text and\n49|// requires exact ordered equality, so a dropped, added, or reordered entry\n50|// reddens there rather than passing silently.\n51|const (\n52|\tOpManifest            Operation = \"manifest\"\n53|\tOpProbe               Operation = \"probe\"\n54|\tOpLaunch              Operation = \"launch\"\n55|\tOpIdentifySession     Operation = \"identify-session\"\n56|\tOpQuiesce             Operation = \"quiesce\"\n57|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n58|\tOpCapture             Operation = \"capture\"\n59|\tOpMaterialize         Operation = \"materialize\"\n60|\tOpMaterializeStatus   Operation = \"materialize-status\"\n61|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n62|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n63|\tOpResume              Operation = \"resume\"\n64|\tOpFork                Operation = \"fork\"\n65|\tOpStop                Operation = \"stop\"\n66|\tOpDoctor              Operation = \"doctor\"\n67|)\n68|\n69|// operationOrder is the single construction site of the dispatch registry.\n70|var operationOrder = []Operation{\n71|\tOpManifest,\n72|\tOpProbe,\n73|\tOpLaunch,\n74|\tOpIdentifySession,\n75|\tOpQuiesce,\n76|\tOpNativeStorePlan,\n77|\tOpCapture,\n78|\tOpMaterialize,\n79|\tOpMaterializeStatus,\n80|\tOpMaterializeCommit,\n81|\tOpMaterializeRollback,\n82|\tOpResume,\n83|\tOpFork,\n84|\tOpStop,\n85|\tOpDoctor,\n86|}\n87|\n88|// Operations returns the dispatch registry in manifest order. The result\n89|// is a copy; the registry cannot be mutated through it.\n90|func Operations() []string {\n91|\tout := make([]string, 0, len(operationOrder))\n92|\tfor _, operation := range operationOrder {\n93|\t\tout = append(out, string(operation))\n94|\t}\n95|\treturn out\n96|}\n97|\n98|// validOperation reports whether the name is a registry member.\n99|func validOperation(name string) bool {\n100|\tfor _, operation := range operationOrder {\n101|\t\tif string(operation) == name {\n102|\t\t\treturn true\n103|\t\t}\n104|\t}\n105|\treturn false\n106|}\n107|\n108|// The refusal constructors below are declared as variables so the\n109|// inventory gate can observe every exercised refusal site. Each is the\n110|// single construction site for its failure class; production code must\n111|// not build *axerror.Error any other way.\n112|//\n113|// failInvalid reports a caller error caught before any process starts:\n114|// an unknown operation, a stale deadline, or an unframeable request body.\n115|// failProtocol reports an unusable plugin frame through the Section 15.1\n116|// provider-stdio otherwise branch. failMismatch reports a recognizable\n117|// major mismatch through the same table's mismatch branch, without\n118|// trusting the foreign payload. failProcess reports a crash or transport\n119|// failure. failTimeout reports a plugin that exceeded its request\n120|// deadline. failIntegrity reports a status observation that cannot be\n121|// reconciled to durable state.\n122|var failInvalid = func(detail string) (*axerror.Error, error) {\n123|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n124|}\n125|\n126|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n127|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n128|}\n129|\n130|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n131|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n132|}\n133|\n134|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n136|}\n137|\n138|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n140|}\n141|\n142|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n143|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n144|}\n145|\n146|// Request is one Section 7.2 request envelope. Body crosses the transport\n147|// opaquely: it must be a JSON object, and its members are interpreted by\n148|// the operation layer, except for the status recovery read.\n149|type Request struct {\n150|\tOperation Operation\n151|\tRequestID scalar.UUIDv7\n152|\tDeadline  scalar.Timestamp\n153|\tBody      json.RawMessage\n154|}\n155|\n156|// Response is one accepted success envelope. Body is the raw\n157|// operation-specific object for the operation layer to interpret. A\n158|// failure envelope never produces a Response: DecodeResponse returns the\n159|// bound child error instead, and a failure envelope carrying a body is\n160|// refused outright.\n161|type Response struct {\n162|\tBody json.RawMessage\n163|}\n164|\n165|// wireRequest is the exact emitted member set: protocol, protocol_version,\n166|// request_id, operation, deadline, and body, in this fixed order.\n167|type wireRequest struct {\n168|\tProtocol        string           `json:\"protocol\"`\n169|\tProtocolVersion string           `json:\"protocol_version\"`\n170|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n171|\tOperation       string           `json:\"operation\"`\n172|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n173|\tBody            json.RawMessage  `json:\"body\"`\n174|}\n175|\n176|// EncodeRequest frames one request as a single JSONL line without the\n177|// terminator. The deadline must be in the future at now, which the caller\n178|// supplies so tests stay deterministic; Host passes its clock.\n179|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n180|\tframe, _, err := encodeFrame(req, now)\n181|\treturn frame, err\n182|}\n183|\n184|// encodeFrame validates and frames a request, also returning the parsed\n185|// deadline instant so Host.Call validates once at a single site.\n186|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n187|\tif !validOperation(string(req.Operation)) {\n188|\t\tfailure, err := failInvalid(\"unknown operation\")\n189|\t\tif err != nil {\n190|\t\t\treturn nil, time.Time{}, err\n191|\t\t}\n192|\t\treturn nil, time.Time{}, failure\n193|\t}\n194|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n195|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n196|\t\tif fault != nil {\n197|\t\t\treturn nil, time.Time{}, fault\n198|\t\t}\n199|\t\treturn nil, time.Time{}, failure\n200|\t}\n201|\tdeadline, err := req.Deadline.Time()\n202|\tif err != nil {\n203|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n204|\t\tif fault != nil {\n205|\t\t\treturn nil, time.Time{}, fault\n206|\t\t}\n207|\t\treturn nil, time.Time{}, failure\n208|\t}\n209|\tif !deadline.After(now) {\n210|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n211|\t\tif fault != nil {\n212|\t\t\treturn nil, time.Time{}, fault\n213|\t\t}\n214|\t\treturn nil, time.Time{}, failure\n215|\t}\n216|\tif !isJSONObject(req.Body) {\n217|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n218|\t\tif fault != nil {\n219|\t\t\treturn nil, time.Time{}, fault\n220|\t\t}\n221|\t\treturn nil, time.Time{}, failure\n222|\t}\n223|\t// The operation, request ID, deadline, and body above were each\n224|\t// validated before this marshal, so it cannot fail on a reachable\n225|\t// path: the error propagates as a plain Go error rather than\n226|\t// through a refusal site no negative test could exercise.\n227|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n228|\tif err != nil {\n229|\t\treturn nil, time.Time{}, err\n230|\t}\n231|\tif len(frame) > MaxFrameBytes {\n232|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n233|\t\tif fault != nil {\n234|\t\t\treturn nil, time.Time{}, fault\n235|\t\t}\n236|\t\treturn nil, time.Time{}, failure\n237|\t}\n238|\treturn frame, deadline, nil\n239|}\n240|\n241|// isJSONObject reports whether data is well-formed JSON whose top-level\n242|// value is an object. Bodies cross the transport opaquely, so this is the\n243|// only body check here: member vocabularies belong to the operation layer.\n244|func isJSONObject(data []byte) bool {\n245|\ttrimmed := bytes.TrimSpace(data)\n246|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n247|\t\treturn false\n248|\t}\n249|\treturn json.Valid(trimmed)\n250|}\n251|\n252|// frameFault classifies a malformed plugin frame without minting error\n253|// values: dynamic facts travel in axerror details, never in Go error text,\n254|// so production code builds no raw errors.\n255|type frameFault struct {\n256|\tdetail string\n257|\tmember string\n258|}\n259|\n260|// decodeStrictObject parses one complete JSON object with duplicate\n261|// member detection. A repeated member has no single value, so it is a\n262|// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n263|// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n264|// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n265|// raw bytes are screened before any member is trusted. The\n266|// lone-surrogate gate runs next: encoding/json would likewise replace\n267|// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n268|// reject lone surrogate code points).\n269|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n270|\tif !utf8.Valid(data) {\n271|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n272|\t}\n273|\tif hasLoneSurrogateEscape(data) {\n274|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n275|\t}\n276|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n277|\ttoken, err := decoder.Token()\n278|\tif err != nil {\n279|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n280|\t}\n281|\tdelim, ok := token.(json.Delim)\n282|\tif !ok || delim != '{' {\n283|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n284|\t}\n285|\tmembers := map[string]json.RawMessage{}\n286|\tfor decoder.More() {\n287|\t\tkeyToken, err := decoder.Token()\n288|\t\tif err != nil {\n289|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n290|\t\t}\n291|\t\tkey, ok := keyToken.(string)\n292|\t\tif !ok {\n293|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n294|\t\t}\n295|\t\tif _, duplicate := members[key]; duplicate {\n296|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n297|\t\t}\n298|\t\tvar raw json.RawMessage\n299|\t\tif err := decoder.Decode(&raw); err != nil {\n300|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n301|\t\t}\n302|\t\tmembers[key] = raw\n303|\t}\n304|\tif token, err := decoder.Token(); err != nil {\n305|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n306|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n307|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n308|\t}\n309|\tif _, err := decoder.Token(); err != io.EOF {\n310|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n311|\t}\n312|\treturn members, nil\n313|}\n314|\n315|// responseMembers is the exact Section 7.2 response member set: the four\n316|// framing members plus body on success or error on failure, never both,\n317|// never neither, and nothing else. It is package-level so the closed\n318|// vocabulary census derives it: widening the accepted set here must redden\n319|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n320|var responseMembers = map[string]bool{\n321|\t\"protocol\":         true,\n322|\t\"protocol_version\": true,\n323|\t\"request_id\":       true,\n324|\t\"ok\":               true,\n325|\t\"body\":             true,\n326|\t\"error\":            true,\n327|}\n328|\n329|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n330|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n331|\tfor _, name := range required {\n332|\t\tif _, present := members[name]; !present {\n333|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n334|\t\t}\n335|\t}\n336|\tif ok {\n337|\t\tif _, present := members[\"body\"]; !present {\n338|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n339|\t\t}\n340|\t\tif _, forbidden := members[\"error\"]; forbidden {\n341|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n342|\t\t}\n343|\t} else {\n344|\t\tif _, present := members[\"error\"]; !present {\n345|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n346|\t\t}\n347|\t\tif _, forbidden := members[\"body\"]; forbidden {\n348|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n349|\t\t}\n350|\t}\n351|\tfor name := range members {\n352|\t\tif !responseMembers[name] {\n353|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n354|\t\t}\n355|\t}\n356|\treturn nil\n357|}\n358|\n359|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n360|// Anything else is not a recognizable major, so the frame is unusable\n361|// rather than a mismatch. A major that does not fit an int saturates\n362|// instead of wrapping, but saturation never short-circuits the shape\n363|// check: only a fully numeric X.Y.Z reports a recognized major. An\n364|// all-numeric giant is observably foreign (it is not 2), so it takes\n365|// the mismatch arm, never aliases a small native major\n366|// (18446744073709551618 must not read as 2) and never slides to the\n367|// unusable-frame arm; a giant with a non-numeric or empty rest\n368|// (99999999999999999999.abc.def) is unrecognized like any other\n369|// malformed version. Saturation adds no rejection branch, so the\n370|// derived parse-arm census needs no new row for it.\n371|func parseMajor(version string) (int, bool) {\n372|\tparts := strings.Split(version, \".\")\n373|\tif len(parts) != 3 {\n374|\t\treturn 0, false\n375|\t}\n376|\tmajor := 0\n377|\tfor i := 0; i < len(parts[0]); i++ {\n378|\t\tdigit := parts[0][i]\n379|\t\tif digit < '0' || digit > '9' {\n380|\t\t\treturn 0, false\n381|\t\t}\n382|\t\tstep := int(digit - '0')\n383|\t\tif major > (math.MaxInt-step)/10 {\n384|\t\t\tmajor = math.MaxInt\n385|\t\t\tcontinue\n386|\t\t}\n387|\t\tmajor = major*10 + step\n388|\t}\n389|\tif len(parts[0]) == 0 {\n390|\t\treturn 0, false\n391|\t}\n392|\tfor _, rest := range parts[1:] {\n393|\t\tif len(rest) == 0 {\n394|\t\t\treturn 0, false\n395|\t\t}\n396|\t\tfor i := 0; i < len(rest); i++ {\n397|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n398|\t\t\t\treturn 0, false\n399|\t\t\t}\n400|\t\t}\n401|\t}\n402|\treturn major, true\n403|}\n404|\n405|// DecodeResponse validates one stdout line as the single response frame\n406|// for the request carrying wantRequestID. It returns the success body, or\n407|// the bound child failure, or a local failure that trusts nothing from\n408|// the frame. A recognizable foreign major yields incompatible_protocol;\n409|// every other unusable frame yields provider_protocol_error.\n410|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n411|\tif len(frame) > MaxFrameBytes {\n412|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n413|\t\tif err != nil {\n414|\t\t\treturn Response{}, err\n415|\t\t}\n416|\t\treturn Response{}, failure\n417|\t}\n418|\tif !utf8.Valid(frame) {\n419|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n420|\t\tif err != nil {\n421|\t\t\treturn Response{}, err\n422|\t\t}\n423|\t\treturn Response{}, failure\n424|\t}\n425|\tmembers, fault := decodeStrictObject(frame)\n426|\tif fault != nil {\n427|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n428|\t\tif err != nil {\n429|\t\t\treturn Response{}, err\n430|\t\t}\n431|\t\treturn Response{}, failure\n432|\t}\n433|\t// foreignMajor peeks at the envelope identity before any v2\n434|\t// member rule runs. A recognizable foreign major is\n435|\t// incompatible_protocol no matter what members it carries, so\n436|\t// the v2 member vocabulary below must not judge it first: a\n437|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n438|\t// is a foreign major, not an unknown or missing member. The\n439|\t// peek trusts nothing and refuses nothing: it only arms when\n440|\t// the protocol member is exactly this protocol and the version\n441|\t// member is a string with a recognizable foreign major. A frame\n442|\t// without our protocol identity, or without a readable version,\n443|\t// falls through to the member rules, which keep their verdicts.\n444|\tforeignMajor := \"\"\n445|\tif rawProtocol, present := members[\"protocol\"]; present {\n446|\t\tvar protocol string\n447|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n448|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n449|\t\t\t\tvar version string\n450|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n451|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n452|\t\t\t\t\t\tforeignMajor = version\n453|\t\t\t\t\t}\n454|\t\t\t\t}\n455|\t\t\t}\n456|\t\t}\n457|\t}\n458|\tvar ok bool\n459|\tif foreignMajor == \"\" {\n460|\t\tif raw, present := members[\"ok\"]; !present {\n461|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n462|\t\t\tif err != nil {\n463|\t\t\t\treturn Response{}, err\n464|\t\t\t}\n465|\t\t\treturn Response{}, failure\n466|\t\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n467|\t\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n468|\t\t\tif fault != nil {\n469|\t\t\t\treturn Response{}, fault\n470|\t\t\t}\n471|\t\t\treturn Response{}, failure\n472|\t\t}\n473|\t\tif fault := checkResponseMembers(members, ok); fault != nil {\n474|\t\t\tfailure, err := failProtocol(fault.detail, fault.member)\n475|\t\t\tif err != nil {\n476|\t\t\t\treturn Response{}, err\n477|\t\t\t}\n478|\t\t\treturn Response{}, failure\n479|\t\t}\n480|\t}\n481|\tvar protocol string\n482|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n483|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n484|\t\tif fault != nil {\n485|\t\t\treturn Response{}, fault\n486|\t\t}\n487|\t\treturn Response{}, failure\n488|\t}\n489|\tvar version string\n490|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n491|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n492|\t\tif fault != nil {\n493|\t\t\treturn Response{}, fault\n494|\t\t}\n495|\t\treturn Response{}, failure\n496|\t}\n497|\tif version != ProtocolVersion {\n498|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n499|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n500|\t\t\tif err != nil {\n(more lines below)"}}}
