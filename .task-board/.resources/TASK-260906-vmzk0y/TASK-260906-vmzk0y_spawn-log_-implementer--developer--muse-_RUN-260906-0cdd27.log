{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c473","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":148,"recorded_at":1780531400000291,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"f7c64f51-3607-4d6f-896f-7017cd628c1e"},"task_id":"f7c64f51-3607-4d6f-896f-7017cd628c1e","event":{"kind":"output","task_id":"f7c64f51-3607-4d6f-896f-7017cd628c1e","chunk":"Read text file `internal/provhost/protocol.go`.\n(499 line(s) above)\n500|\t\t\tif err != nil {\n501|\t\t\t\treturn Response{}, err\n502|\t\t\t}\n503|\t\t\treturn Response{}, failure\n504|\t\t}\n505|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n506|\t\tif fault != nil {\n507|\t\t\treturn Response{}, fault\n508|\t\t}\n509|\t\treturn Response{}, failure\n510|\t}\n511|\tvar requestID string\n512|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n513|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n514|\t\tif fault != nil {\n515|\t\t\treturn Response{}, fault\n516|\t\t}\n517|\t\treturn Response{}, failure\n518|\t}\n519|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n520|\t\tfailure, fault := failProtocol(\"request_id is not a UUIDv7\", \"request_id\")\n521|\t\tif fault != nil {\n522|\t\t\treturn Response{}, fault\n523|\t\t}\n524|\t\treturn Response{}, failure\n525|\t}\n526|\tif requestID != wantRequestID.String() {\n527|\t\tfailure, fault := failProtocol(\"request_id does not match the request\", \"request_id\")\n528|\t\tif fault != nil {\n529|\t\t\treturn Response{}, fault\n530|\t\t}\n531|\t\treturn Response{}, failure\n532|\t}\n533|\tif ok {\n534|\t\tif !isJSONObject(members[\"body\"]) {\n535|\t\t\tfailure, fault := failProtocol(\"body is not a JSON object\", \"body\")\n536|\t\t\tif fault != nil {\n537|\t\t\t\treturn Response{}, fault\n538|\t\t\t}\n539|\t\t\treturn Response{}, failure\n540|\t\t}\n541|\t\treturn Response{Body: append(json.RawMessage(nil), members[\"body\"]...)}, nil\n542|\t}\n543|\tif !isJSONObject(members[\"error\"]) {\n544|\t\tfailure, fault := failProtocol(\"error is not a JSON object\", \"error\")\n545|\t\tif fault != nil {\n546|\t\t\treturn Response{}, fault\n547|\t\t}\n548|\t\treturn Response{}, failure\n549|\t}\n550|\t// The failure-error version is selected by the observed envelope\n551|\t// major through the static Section 15.1/17.1 table, never from the\n552|\t// document: major 2 decodes under Structured Error 1.0.0, and major\n553|\t// 3 would decode under Structured Error 1.3.0. Only 2.0.0 reaches\n554|\t// this line — a recognizable 3.x envelope was refused above as a\n555|\t// major mismatch, because a v2-only host never trusts a different\n556|\t// major's error (Section 7.A) — so the contract below carries major\n557|\t// 2 on every reachable path today, and admits 1.3.0 by construction\n558|\t// the day the version gate admits 3.0.0. The blank parse result is\n559|\t// total here: the gate above admitted exactly \"2.0.0\".\n560|\tobservedMajor, _ := parseMajor(version)\n561|\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}, members[\"error\"])\n562|\tif err != nil {\n563|\t\tfailure, fault := failProtocol(\"error is not a bound Structured Error 1.0.0\", \"error\")\n564|\t\tif fault != nil {\n565|\t\t\treturn Response{}, fault\n566|\t\t}\n567|\t\treturn Response{}, failure\n568|\t}\n569|\treturn Response{}, child\n570|}"}}}
