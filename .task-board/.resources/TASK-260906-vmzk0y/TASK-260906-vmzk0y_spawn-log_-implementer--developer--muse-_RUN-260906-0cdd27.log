*10+step\\n        v = major*10+step\\n        # wrap to int64\\n        v = ((v + 2**63) % 2**64) - 2**63\\n        major=v\\n    if len(parts[0])==0: return (0,False)\\n    for rest in parts[1:]:\\n        if len(rest)==0: return (0,False)\\n        for ch in rest:\\n            if not '0'<=ch<='9': return (0,False)\\n    return (major,True)\\n\\nfor v in [\\\"9223372036854775807.0.0\\\",\\\"9223372036854775808.0.0\\\",\\\"9223372036854775809.0.0\\\",\\\"922337203685477580802.0.0\\\",\\\"922337203685477580801.0.0\\\",\\\"922337203685477580803.0.0\\\",\\\"92233720368547758080.0.0\\\",\\\"18446744073709551618.0.0\\\"]:\\n    print(v, \\\"shipped\\\", parse_shipped(v), \\\"M3\\\", parse_M3(v))\\nPY\",\n  \"description\": \"Probe saturation edge arithmetic\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"MaxInt 9223372036854775807\\nMaxInt/10 922337203685477580\\n9223372036854775807.0.0 shipped (9223372036854775807, True) M3 (9223372036854775807, True)\\n9223372036854775808.0.0 shipped (9223372036854775807, True) M3 (-9223372036854775808, True)\\n9223372036854775809.0.0 shipped (9223372036854775807, True) M3 (-9223372036854775807, True)\\n922337203685477580802.0.0 shipped (9223372036854775807, True) M3 (2, True)\\n922337203685477580801.0.0 shipped (9223372036854775807, True) M3 (1, True)\\n922337203685477580803.0.0 shipped (9223372036854775807, True) M3 (3, True)\\n92233720368547758080.0.0 shipped (9223372036854775807, True) M3 (0, True)\\n18446744073709551618.0.0 shipped (9223372036854775807, True) M3 (9223372036854775807, True)\\n\",\n  \"original_output_bytes\": 722,\n  \"original_output_tokens\": 181,\n  \"truncated\": false\n}"}}}
