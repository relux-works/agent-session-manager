{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a7","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":174,"recorded_at":1780531400000343,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"4c09b204-f3c8-40fc-873d-164461604368"},"task_id":"4c09b204-f3c8-40fc-873d-164461604368","event":{"kind":"output","task_id":"4c09b204-f3c8-40fc-873d-164461604368","chunk":"Read text file `internal/provhost/protocol_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// asError unwraps err to an *axerror.Error without hiding the chain.\n15|func asError(t *testing.T, err error, failure **axerror.Error) bool {\n16|\tt.Helper()\n17|\treturn errors.As(err, failure)\n18|}\n19|\n20|const (\n21|\ttestRequestID = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n22|\ttestOtherID   = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n23|\ttestDeadline  = \"2026-08-19T04:05:00.000Z\"\n24|\ttestNow       = \"2026-08-19T04:00:00.000Z\"\n25|)\n26|\n27|func mustUUIDv7(t *testing.T, value string) scalar.UUIDv7 {\n28|\tt.Helper()\n29|\tparsed, err := scalar.ParseUUIDv7(value)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"ParseUUIDv7(%q): %v\", value, err)\n32|\t}\n33|\treturn parsed\n34|}\n35|\n36|func mustTimestamp(t *testing.T, value string) scalar.Timestamp {\n37|\tt.Helper()\n38|\tparsed, err := scalar.ParseTimestamp(value)\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n41|\t}\n42|\treturn parsed\n43|}\n44|\n45|func mustInstant(t *testing.T, value string) time.Time {\n46|\tt.Helper()\n47|\tinstant, err := mustTimestamp(t, value).Time()\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"Timestamp(%q).Time(): %v\", value, err)\n50|\t}\n51|\treturn instant\n52|}\n53|\n54|// testRequest builds the Section 7.2 request-envelope fixture: a doctor\n55|// operation with a future deadline. The production entry point for\n56|// framing is EncodeRequest.\n57|func testRequest(t *testing.T) Request {\n58|\tt.Helper()\n59|\treturn Request{\n60|\t\tOperation: OpDoctor,\n61|\t\tRequestID: mustUUIDv7(t, testRequestID),\n62|\t\tDeadline:  mustTimestamp(t, testDeadline),\n63|\t\tBody:      json.RawMessage(`{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}`),\n64|\t}\n65|}\n66|\n67|// failureCode extracts the Structured Error code from err, failing when\n68|// err is not an *axerror.Error. Every failure below is a 1.0.0 object,\n69|// local or child-bound.\n70|func failureCode(t *testing.T, err error) axerror.Code {\n71|\tt.Helper()\n72|\tif err == nil {\n73|\t\tt.Fatal(\"want a failure, got nil\")\n74|\t}\n75|\tvar failure *axerror.Error\n76|\tif !asError(t, err, &failure) {\n77|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n78|\t}\n79|\treturn failure.Code()\n80|}\n81|\n82|func failureExit(t *testing.T, err error) int {\n83|\tt.Helper()\n84|\tvar failure *axerror.Error\n85|\tif !asError(t, err, &failure) {\n86|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n87|\t}\n88|\treturn failure.ExitCode()\n89|}\n90|\n91|// failureObject unwraps err to the Structured Error itself, so arm\n92|// identity beyond the stable code can be asserted.\n93|func failureObject(t *testing.T, err error) *axerror.Error {\n94|\tt.Helper()\n95|\tif err == nil {\n96|\t\tt.Fatal(\"want a failure, got nil\")\n97|\t}\n98|\tvar failure *axerror.Error\n99|\tif !asError(t, err, &failure) {\n100|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n101|\t}\n102|\treturn failure\n103|}\n104|\n105|// failureMember returns the \"member\" diagnostic of a frame refusal. Every\n106|// provider_protocol_error arm names the member it refused on, so asserting\n107|// it pins the arm: a missing-member gate deleted from checkResponseMembers\n108|// slides to a lower arm carrying the same code with a different member or\n109|// detail, and the slide reddens here instead of passing silently.\n110|func failureMember(t *testing.T, err error) string {\n111|\tt.Helper()\n112|\tfailure := failureObject(t, err)\n113|\tmember, ok := failure.Detail(\"member\")\n114|\tif !ok {\n115|\t\tt.Fatalf(\"refusal %v carries no member detail\", err)\n116|\t}\n117|\ttext, ok := member.(string)\n118|\tif !ok {\n119|\t\tt.Fatalf(\"refusal %v member detail is %T, want string\", err, member)\n120|\t}\n121|\treturn text\n122|}\n123|\n124|// requireFrameRefusal asserts the full arm identity of a plugin-frame\n125|// refusal: the stable code, the refused member, the detail naming the\n126|// rule, and the non-retryable bit doc.go promises for every local\n127|// failure this package emits.\n128|func requireFrameRefusal(t *testing.T, err error, member, detail string) {\n129|\tt.Helper()\n130|\tif failureCode(t, err) != \"provider_protocol_error\" {\n131|\t\tt.Fatalf(\"DecodeResponse code = %v, want provider_protocol_error\", err)\n132|\t}\n133|\tif got := failureMember(t, err); got != member {\n134|\t\tt.Fatalf(\"DecodeResponse member = %q, want %q (detail: %v)\", got, member, err)\n135|\t}\n136|\tif !strings.Contains(err.Error(), detail) {\n137|\t\tt.Fatalf(\"DecodeResponse error = %v, want detail containing %q\", err, detail)\n138|\t}\n139|\tif failureObject(t, err).Retryable() {\n140|\t\tt.Fatalf(\"DecodeResponse error = %v, want non-retryable\", err)\n141|\t}\n142|}\n143|\n144|// requireLocalRefusal asserts the arm identity of a refusal that carries\n145|// no member detail (invalid_config framing refusals and integrity_failure\n146|// status refusals): the stable code, the detail naming the rule in the\n147|// human text, and the non-retryable bit.\n148|func requireLocalRefusal(t *testing.T, err error, code axerror.Code, detail string) {\n149|\tt.Helper()\n150|\tif failureCode(t, err) != code {\n151|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n152|\t}\n153|\tif !strings.Contains(err.Error(), detail) {\n154|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, detail)\n155|\t}\n156|\tif failureObject(t, err).Retryable() {\n157|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n158|\t}\n159|}\n160|\n161|// TestEncodeRequestEmitsExactFrame pins the request wire bytes: the six\n162|// exact members in fixed order, with the body passed through verbatim.\n163|func TestEncodeRequestEmitsExactFrame(t *testing.T) {\n164|\tframe, err := EncodeRequest(testRequest(t), mustInstant(t, testNow))\n165|\tif err != nil {\n166|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n167|\t}\n168|\twant := `{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"operation\":\"doctor\",\"deadline\":\"2026-08-19T04:05:00.000Z\",\"body\":{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}}`\n169|\tif string(frame) != want {\n170|\t\tt.Fatalf(\"EncodeRequest frame = %s, want %s\", frame, want)\n171|\t}\n172|}\n173|\n174|// TestEncodeRequestDispatchesEveryRegistryOperation proves dispatch\n175|// reaches every registry entry: each of the 15 operations frames with\n176|// its own name. The registry list itself is pinned against the\n177|// specification text by the inventory test.\n178|func TestEncodeRequestDispatchesEveryRegistryOperation(t *testing.T) {\n179|\tnow := mustInstant(t, testNow)\n180|\tfor _, name := range Operations() {\n181|\t\treq := testRequest(t)\n182|\t\treq.Operation = Operation(name)\n183|\t\tframe, err := EncodeRequest(req, now)\n184|\t\tif err != nil {\n185|\t\t\tt.Fatalf(\"EncodeRequest(%q): %v\", name, err)\n186|\t\t}\n187|\t\tvar decoded struct {\n188|\t\t\tOperation string `json:\"operation\"`\n189|\t\t}\n190|\t\tif err := json.Unmarshal(frame, &decoded); err != nil {\n191|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame is not JSON: %v\", name, err)\n192|\t\t}\n193|\t\tif decoded.Operation != name {\n194|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame carries operation %q\", name, decoded.Operation)\n195|\t\t}\n196|\t}\n197|}\n198|\n199|// TestEncodeRequestRefusals proves framing fails closed before any\n200|// process starts: unknown operations, non-UUIDv7 request IDs, stale or\n201|// malformed deadlines, non-object bodies, and oversize frames are all\n202|// invalid_config from EncodeRequest. The production entry point is\n203|// EncodeRequest.\n204|func TestEncodeRequestRefusals(t *testing.T) {\n205|\tnow := mustInstant(t, testNow)\n206|\tfor _, kase := range []struct {\n207|\t\tname   string\n208|\t\tmutate func(*Request)\n209|\t\tdetail string\n210|\t}{\n211|\t\t{\"unknown operation\", func(req *Request) { req.Operation = \"reboot\" }, \"unknown operation\"},\n212|\t\t{\"empty operation\", func(req *Request) { req.Operation = \"\" }, \"unknown operation\"},\n213|\t\t{\"zero request id\", func(req *Request) { req.RequestID = scalar.UUIDv7{} }, \"request_id is not a UUIDv7\"},\n214|\t\t{\"zero deadline\", func(req *Request) { req.Deadline = scalar.Timestamp{} }, \"deadline is not a timestamp\"},\n215|\t\t{\"past deadline\", func(req *Request) { req.Deadline = mustTimestamp(t, testNow) }, \"deadline is not in the future\"},\n216|\t\t{\"deadline long past\", func(req *Request) { req.Deadline = mustTimestamp(t, \"2020-01-01T00:00:00.000Z\") }, \"deadline is not in the future\"},\n217|\t\t{\"array body\", func(req *Request) { req.Body = json.RawMessage(`[1,2]`) }, \"body is not a JSON object\"},\n218|\t\t{\"string body\", func(req *Request) { req.Body = json.RawMessage(`\"x\"`) }, \"body is not a JSON object\"},\n219|\t\t{\"scalar body\", func(req *Request) { req.Body = json.RawMessage(`3`) }, \"body is not a JSON object\"},\n220|\t\t{\"empty body\", func(req *Request) { req.Body = nil }, \"body is not a JSON object\"},\n221|\t\t{\"blank body\", func(req *Request) { req.Body = json.RawMessage(`  `) }, \"body is not a JSON object\"},\n222|\t\t{\"malformed body\", func(req *Request) { req.Body = json.RawMessage(`{oops`) }, \"body is not a JSON object\"},\n223|\t\t{\"oversize frame\", func(req *Request) {\n224|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n225|\t\t}, \"request frame exceeds 8 MiB\"},\n226|\t} {\n227|\t\tt.Run(kase.name, func(t *testing.T) {\n228|\t\t\treq := testRequest(t)\n229|\t\t\tkase.mutate(&req)\n230|\t\t\t_, err := EncodeRequest(req, now)\n231|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", kase.detail)\n232|\t\t})\n233|\t}\n234|}\n235|\n236|// successFrame builds a minimal valid success envelope for want.\n237|func successFrame(t *testing.T, want, body string) []byte {\n238|\tt.Helper()\n239|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":true,\"body\":` + body + `}`)\n240|}\n241|\n242|// childFailureFrame builds a failure envelope carrying a genuine bound\n243|// child error, constructed through the production axerror entry point.\n244|func childFailureFrame(t *testing.T, want string) []byte {\n245|\tt.Helper()\n246|\tchild, err := axerror.New(axerror.Spec{\n247|\t\tVersion: axerror.Version100,\n248|\t\tCode:    \"capability_unavailable\",\n249|\t\tMessage: \"portable store is not available for this provider build\",\n250|\t\tDetails: axerror.Details{},\n251|\t})\n252|\tif err != nil {\n253|\t\tt.Fatalf(\"axerror.New: %v\", err)\n254|\t}\n255|\traw, err := json.Marshal(child)\n256|\tif err != nil {\n257|\t\tt.Fatalf(\"Marshal child: %v\", err)\n258|\t}\n259|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":false,\"error\":` + string(raw) + `}`)\n260|}\n261|\n262|// TestDecodeResponseAcceptsSuccess proves the positive path returns the\n263|// body verbatim for correlation-matched frames.\n264|func TestDecodeResponseAcceptsSuccess(t *testing.T) {\n265|\tbody := `{\"provider_id\":\"pi\",\"provider_version\":\"0.73.1\",\"findings\":[]}`\n266|\tgot, err := DecodeResponse(successFrame(t, testRequestID, body), mustUUIDv7(t, testRequestID))\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"DecodeResponse: %v\", err)\n269|\t}\n270|\tif string(got.Body) != body {\n271|\t\tt.Fatalf(\"DecodeResponse body = %s, want %s\", got.Body, body)\n272|\t}\n273|}\n274|\n275|// TestDecodeResponseReturnsChildFailure proves a failure envelope\n276|// surfaces the bound child error itself, with its own code and exit.\n277|func TestDecodeResponseReturnsChildFailure(t *testing.T) {\n278|\t_, err := DecodeResponse(childFailureFrame(t, testRequestID), mustUUIDv7(t, testRequestID))\n279|\tif failureCode(t, err) != \"capability_unavailable\" {\n280|\t\tt.Fatalf(\"DecodeResponse code = %v, want the bound child code capability_unavailable\", err)\n281|\t}\n282|\tif failureExit(t, err) != 6 {\n283|\t\tt.Fatalf(\"DecodeResponse exit = %d, want 6\", failureExit(t, err))\n284|\t}\n285|}\n286|\n287|// TestDecodeResponseRecognizableMajorMismatch proves a foreign major is\n288|// reported as incompatible_protocol without trusting the payload: the\n289|// frame carries a forged error object whose code must never surface.\n290|func TestDecodeResponseRecognizableMajorMismatch(t *testing.T) {\n291|\tfor _, version := range []string{\"3.0.0\", \"1.0.0\", \"10.2.3\"} {\n292|\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"forged_code\",\"message\":\"forged\",\"exit_code\":0,\"retryable\":true,\"details\":{}}}`)\n293|\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n294|\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n295|\t\t\tt.Fatalf(\"DecodeResponse(%s) code = %v, want incompatible_protocol\", version, err)\n296|\t\t}\n297|\t\tobserved, ok := failureObject(t, err).Detail(\"observed\")\n298|\t\tif !ok || observed != version {\n299|\t\t\tt.Fatalf(\"DecodeResponse(%s) observed = %v, want the foreign version %q\", version, observed, version)\n300|\t\t}\n301|\t\tif failureExit(t, err) != 6 {\n302|\t\t\tt.Fatalf(\"DecodeResponse(%s) exit = %d, want 6\", version, failureExit(t, err))\n303|\t\t}\n304|\t\tif strings.Contains(err.Error(), \"forged_code\") {\n305|\t\t\tt.Fatalf(\"foreign payload leaked into the local failure: %v\", err)\n306|\t\t}\n307|\t}\n308|}\n309|\n310|// TestDecodeResponseForeignMajorPrecedesMemberRules proves the version\n311|// gate runs before the v2 member vocabulary: a recognizable foreign\n312|// major is incompatible_protocol even when it carries members v2\n313|// never allows, or omits members v2 requires. Judging those shapes\n314|// through the v2 member rules first would misreport them as\n315|// provider_protocol_error unknown member or missing member, which is\n316|// what the code did before the gate moved ahead. The production entry\n317|// point is DecodeResponse.\n318|func TestDecodeResponseForeignMajorPrecedesMemberRules(t *testing.T) {\n319|\twant := mustUUIDv7(t, testRequestID)\n320|\tenvelope := func(version, members string) []byte {\n321|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n322|\t}\n323|\tfor _, kase := range []struct {\n324|\t\tname    string\n325|\t\tframe   []byte\n326|\t\tversion string\n327|\t}{\n328|\t\t{\"v3 member on success\", envelope(\"3.0.0\", `\"ok\":true,\"body\":{},\"capabilities\":[]`), \"3.0.0\"},\n329|\t\t{\"v3 member on failure\", envelope(\"3.0.0\", `\"ok\":false,\"error\":{\"code\":\"x\"},\"descriptor\":{}`), \"3.0.0\"},\n330|\t\t{\"missing body on success\", envelope(\"3.0.0\", `\"ok\":true`), \"3.0.0\"},\n331|\t\t{\"missing error on failure\", envelope(\"3.0.0\", `\"ok\":false`), \"3.0.0\"},\n332|\t\t{\"missing ok\", envelope(\"3.0.0\", `\"body\":{}`), \"3.0.0\"},\n333|\t\t{\"major one with v3 member\", envelope(\"1.0.0\", `\"ok\":true,\"body\":{},\"capabilities\":[]`), \"1.0.0\"},\n334|\t} {\n335|\t\tt.Run(kase.name, func(t *testing.T) {\n336|\t\t\t_, err := DecodeResponse(kase.frame, want)\n337|\t\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n338|\t\t\t\tt.Fatalf(\"DecodeResponse(%s) code = %v, want incompatible_protocol\", kase.name, err)\n339|\t\t\t}\n340|\t\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != kase.version {\n341|\t\t\t\tt.Fatalf(\"DecodeResponse(%s) observed = %v, want the foreign version %q\", kase.name, observed, kase.version)\n342|\t\t\t}\n343|\t\t\tif failureExit(t, err) != 6 {\n344|\t\t\t\tt.Fatalf(\"DecodeResponse(%s) exit = %d, want 6\", kase.name, failureExit(t, err))\n345|\t\t\t}\n346|\t\t})\n347|\t}\n348|\t// The gate needs the envelope identity: without our protocol id,\n349|\t// or without a readable version, the member rules keep judging.\n350|\t// (Member-shape faults still precede the protocol identity\n351|\t// check, as before: a foreign protocol id carrying a v2-unknown\n352|\t// member is an unknown member, not a foreign envelope.)\n353|\t_, err := DecodeResponse([]byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"3.0.0\",\"request_id\":\"`+testRequestID+`\",\"ok\":true,\"body\":{}}`), want)\n354|\trequireFrameRefusal(t, err, \"protocol\", \"not a provider envelope\")\n355|\t_, err = DecodeResponse([]byte(`{\"protocol_version\":\"3.0.0\",\"request_id\":\"`+testRequestID+`\",\"ok\":true,\"body\":{}}`), want)\n356|\trequireFrameRefusal(t, err, \"protocol\", \"missing member\")\n357|\t_, err = DecodeResponse([]byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":3,\"request_id\":\"`+testRequestID+`\",\"ok\":true,\"body\":{}}`), want)\n358|\trequireFrameRefusal(t, err, \"protocol_version\", \"member is not a string\")\n359|}\n360|\n361|// TestDecodeResponseRefusals proves every unusable frame shape fails with\n362|// provider_protocol_error, never with a partial result. The production\n363|// entry point is DecodeResponse.\n364|func TestDecodeResponseRefusals(t *testing.T) {\n365|\twant := mustUUIDv7(t, testRequestID)\n366|\tokFrame := func(members string) []byte {\n367|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n368|\t}\n369|\tvalidBody := `{\"provider_id\":\"pi\"}`\n370|\t// Each row names the refusal arm it must reach: the member detail\n371|\t// and the rule detail. A deleted required-member gate slides the\n372|\t// missing member to a lower arm with the same code but a different\n373|\t// member or detail, and the slide reddens here. The malformed\n374|\t// versions below carry a foreign major (\"3\" or empty) so a deleted\n375|\t// parseMajor arm promotes them to incompatible_protocol instead of\n376|\t// collapsing back onto this code. The non-numeric-major rows carry a\n377|\t// numeric rest (\".0.0\") so only the major-digit branch can refuse\n378|\t// them: with a non-numeric rest the rest-digit branch would fire\n379|\t// first and the misclassification would collapse back to this code.\n380|\t// The full five-branch parseMajor enumeration lives in the derived\n381|\t// refusal-arm inventory; these rows are its entry-point witnesses.\n382|\tversionFrame := func(version string) []byte {\n383|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n384|\t}\n385|\tfor _, kase := range []struct {\n386|\t\tname   string\n387|\t\tframe  []byte\n388|\t\tmember string\n389|\t\tdetail string\n390|\t}{\n391|\t\t{\"empty\", []byte{}, \"\", \"not a JSON object\"},\n392|\t\t{\"not JSON\", []byte(`not json`), \"\", \"not a JSON object\"},\n393|\t\t{\"truncated\", []byte(`{\"protocol\":`), \"protocol\", \"not a JSON object\"},\n394|\t\t{\"array\", []byte(`[1,2]`), \"\", \"not a JSON object\"},\n395|\t\t{\"scalar\", []byte(`true`), \"\", \"not a JSON object\"},\n396|\t\t{\"trailing data\", append(successFrame(t, testRequestID, validBody), 'x'), \"\", \"trailing data after the object\"},\n397|\t\t{\"trailing valid value\", append(successFrame(t, testRequestID, validBody), ' ', '{', '}'), \"\", \"trailing data after the object\"},\n398|\t\t{\"duplicate member\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"request_id\", \"duplicate member\"},\n399|\t\t{\"missing protocol\", []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"missing member\"},\n400|\t\t{\"missing version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"missing member\"},\n401|\t\t{\"missing request id\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"ok\":true,\"body\":{}}`), \"request_id\", \"missing member\"},\n402|\t\t{\"missing ok\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`), \"ok\", \"missing member\"},\n403|\t\t{\"missing body on success\", okFrame(`\"ok\":true`), \"body\", \"missing member\"},\n404|\t\t{\"missing error on failure\", okFrame(`\"ok\":false`), \"error\", \"missing member\"},\n405|\t\t{\"body on failure\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`), \"body\", \"failure envelope carries body\"},\n406|\t\t{\"error on success\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`), \"error\", \"success envelope carries error\"},\n407|\t\t{\"unknown member\", okFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), \"diagnostics\", \"unknown member\"},\n408|\t\t{\"ok not boolean\", okFrame(`\"ok\":\"yes\",\"body\":{}`), \"ok\", \"member is not a boolean\"},\n409|\t\t{\"wrong protocol\", []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"not a provider envelope\"},\n410|\t\t{\"protocol not string\", []byte(`{\"protocol\":7,\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"not a provider envelope\"},\n411|\t\t{\"minor version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.1.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n412|\t\t{\"garbage version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"v2\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n413|\t\t{\"short version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n414|\t\t{\"empty version part\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2..0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n415|\t\t{\"non-numeric version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"a.b.c\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n416|\t\t{\"foreign two-part version\", versionFrame(\"3.0\"), \"protocol_version\", \"unsupported protocol version\"},\n417|\t\t{\"foreign four-part version\", versionFrame(\"3.0.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n418|\t\t{\"foreign empty major\", versionFrame(\".0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n419|\t\t{\"foreign empty minor\", versionFrame(\"3..0\"), \"protocol_version\", \"unsupported protocol version\"},\n420|\t\t{\"foreign non-numeric rest\", versionFrame(\"3.b.c\"), \"protocol_version\", \"unsupported protocol version\"},\n421|\t\t{\"foreign non-numeric major\", versionFrame(\"a.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n422|\t\t{\"foreign alphanumeric major\", versionFrame(\"2a.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n423|\t\t{\"foreign negative major\", versionFrame(\"-1.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n424|\t\t{\"foreign plus major\", versionFrame(\"+3.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n425|\t\t{\"version not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"member is not a string\"},\n426|\t\t{\"empty version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n427|\t\t{\"request id not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":7,\"ok\":true,\"body\":{}}`), \"request_id\", \"member is not a string\"},\n428|\t\t{\"request id not UUIDv7\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`), \"request_id\", \"request_id is not a UUIDv7\"},\n429|\t\t{\"request id mismatch\", successFrame(t, testOtherID, validBody), \"request_id\", \"request_id does not match the request\"},\n430|\t\t{\"body array on success\", okFrame(`\"ok\":true,\"body\":[]`), \"body\", \"body is not a JSON object\"},\n431|\t\t{\"body scalar on success\", okFrame(`\"ok\":true,\"body\":1`), \"body\", \"body is not a JSON object\"},\n432|\t\t{\"error scalar on failure\", okFrame(`\"ok\":false,\"error\":1`), \"error\", \"error is not a JSON object\"},\n433|\t\t{\"error unbound version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`), \"error\", \"error is not a bound Structured Error 1.0.0\"},\n434|\t} {\n435|\t\tt.Run(kase.name, func(t *testing.T) {\n436|\t\t\t_, err := DecodeResponse(kase.frame, want)\n437|\t\t\trequireFrameRefusal(t, err, kase.member, kase.detail)\n438|\t\t})\n439|\t}\n440|}\n441|\n442|// TestDecodeResponseRefusesOversizeFrame proves the 8 MiB bound from the\n443|// decoding side: a frame one byte over the limit fails without being\n444|// parsed, and a frame exactly at the limit is accepted.\n445|// specFrameLimitBytes is the absolute Section 7.2 bound, stated as a\n446|// literal rather than derived from MaxFrameBytes: the fixtures below pin\n447|// the constant to the specification text, so weakening the constant\n448|// reddens here instead of scaling the fixtures along with it.\n449|const specFrameLimitBytes = 8 << 20\n450|\n451|func TestDecodeResponseRefusesOversizeFrame(t *testing.T) {\n452|\tif MaxFrameBytes != specFrameLimitBytes {\n453|\t\tt.Fatalf(\"MaxFrameBytes = %d, want the specified %d\", MaxFrameBytes, specFrameLimitBytes)\n454|\t}\n455|\twant := mustUUIDv7(t, testRequestID)\n456|\tbuild := func(pad int) []byte {\n457|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n458|\t}\n459|\t// The pad contributes exactly pad bytes, so base+pad is the frame\n460|\t// size. One byte over the limit must fail; exactly at it must pass.\n461|\tbase := len(build(0))\n462|\tover := build(specFrameLimitBytes - base + 1)\n463|\tif len(over) != specFrameLimitBytes+1 {\n464|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n465|\t}\n466|\t_, err := DecodeResponse(over, want)\n467|\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n468|\tframe := build(specFrameLimitBytes - base)\n469|\tif len(frame) != specFrameLimitBytes {\n470|\t\tt.Fatalf(\"boundary fixture is %d bytes, want exactly %d\", len(frame), specFrameLimitBytes)\n471|\t}\n472|\tif _, err := DecodeResponse(frame, want); err != nil {\n473|\t\tt.Fatalf(\"boundary DecodeResponse: %v\", err)\n474|\t}\n475|}\n476|\n477|// TestDecodeResponseRefusesNonUTF8 proves the UTF-8 gate: invalid bytes\n478|// fail even when the surrounding shape would parse.\n479|func TestDecodeResponseRefusesNonUTF8(t *testing.T) {\n480|\tframe := append([]byte{}, successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`)...)\n481|\tframe[len(frame)-3] = 0xff\n482|\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n483|\trequireFrameRefusal(t, err, \"\", \"frame is not UTF-8\")\n484|}\n485|\n486|// TestEncodeRequestRefusesOversizeFrame proves the 8 MiB bound from the\n487|// framing side with the same exact-boundary technique as the decoding\n488|// side: a request one byte over the limit fails, and a request exactly at\n489|// the limit frames. The pad contributes exactly pad bytes, so a halved or\n490|// doubled bound reddens here instead of scaling along.\n491|func TestEncodeRequestRefusesOversizeFrame(t *testing.T) {\n492|\tif MaxFrameBytes != specFrameLimitBytes {\n493|\t\tt.Fatalf(\"MaxFrameBytes = %d, want the specified %d\", MaxFrameBytes, specFrameLimitBytes)\n494|\t}\n495|\tnow := mustInstant(t, testNow)\n496|\tbuild := func(pad int) (Request, int) {\n497|\t\treq := testRequest(t)\n498|\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", pad) + `\"}`)\n499|\t\tframe, err := EncodeRequest(req, now)\n500|\t\tif err != nil {\n(more lines below)"}}}
