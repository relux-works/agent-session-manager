{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c503","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":220,"recorded_at":1780531400000435,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"6d28b2a0-c2f8-4722-af74-8d33a01e4271"},"task_id":"6d28b2a0-c2f8-4722-af74-8d33a01e4271","event":{"kind":"output","task_id":"6d28b2a0-c2f8-4722-af74-8d33a01e4271","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(499 line(s) above)\n500|\t\t\treq := testRequest(t)\n501|\t\t\treq.Deadline = mustTimestamp(t, testNow)\n502|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n503|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"deadline is not in the future\")\n504|\t\t}},\n505|\t\t{arm: `ctor|failInvalid|body is not a JSON object`, name: \"array body\", prove: func(t *testing.T) {\n506|\t\t\treq := testRequest(t)\n507|\t\t\treq.Body = json.RawMessage(`[1,2]`)\n508|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n509|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"body is not a JSON object\")\n510|\t\t}},\n511|\t\t{arm: `ctor|failInvalid|request frame exceeds 8 MiB`, name: \"oversize request\", prove: func(t *testing.T) {\n512|\t\t\treq := testRequest(t)\n513|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n514|\t\t\t_, err := EncodeRequest(req, mustInstant(t, testNow))\n515|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request frame exceeds 8 MiB\")\n516|\t\t}},\n517|\t\t// DecodeResponse refusals, through DecodeResponse.\n518|\t\t{arm: `ctor|failProtocol|frame exceeds 8 MiB`, name: \"oversize response\", prove: func(t *testing.T) {\n519|\t\t\t_, err := DecodeResponse(armOversizeResponse(t), mustUUIDv7(t, testRequestID))\n520|\t\t\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n521|\t\t}},\n522|\t\t{arm: `ctor|failProtocol|frame is not UTF-8`, name: \"invalid UTF-8\", prove: func(t *testing.T) {\n523|\t\t\tframe := append([]byte{}, successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`)...)\n524|\t\t\tframe[len(frame)-3] = 0xff\n525|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n526|\t\t\trequireFrameRefusal(t, err, \"\", \"frame is not UTF-8\")\n527|\t\t}},\n528|\t\t{arm: `ctor|failProtocol|missing member`, name: \"missing ok\", prove: func(t *testing.T) {\n529|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`)\n530|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n531|\t\t\trequireFrameRefusal(t, err, \"ok\", \"missing member\")\n532|\t\t}},\n533|\t\t{arm: `ctor|failProtocol|member is not a boolean`, name: \"ok is a string\", prove: func(t *testing.T) {\n534|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":\"yes\",\"body\":{}`), mustUUIDv7(t, testRequestID))\n535|\t\t\trequireFrameRefusal(t, err, \"ok\", \"member is not a boolean\")\n536|\t\t}},\n537|\t\t{arm: `ctor|failProtocol|not a provider envelope`, name: \"foreign protocol id\", prove: func(t *testing.T) {\n538|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n539|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n540|\t\t\trequireFrameRefusal(t, err, \"protocol\", \"not a provider envelope\")\n541|\t\t}},\n542|\t\t{arm: `ctor|failProtocol|member is not a string`, name: \"version is a number\", prove: func(t *testing.T) {\n543|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n544|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n545|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"member is not a string\")\n546|\t\t}},\n547|\t\t{arm: `ctor|failProtocol|unsupported protocol version`, name: \"minor bump\", prove: func(t *testing.T) {\n548|\t\t\t_, err := DecodeResponse(armVersionFrame(\"2.1.0\"), mustUUIDv7(t, testRequestID))\n549|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n550|\t\t}},\n551|\t\t{arm: `ctor|failProtocol|request_id is not a UUIDv7`, name: \"garbage request id\", prove: func(t *testing.T) {\n552|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`)\n553|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n554|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"request_id is not a UUIDv7\")\n555|\t\t}},\n556|\t\t{arm: `ctor|failProtocol|request_id does not match the request`, name: \"crossed response\", prove: func(t *testing.T) {\n557|\t\t\t_, err := DecodeResponse(successFrame(t, testOtherID, `{\"provider_id\":\"pi\"}`), mustUUIDv7(t, testRequestID))\n558|\t\t\trequireFrameRefusal(t, err, \"request_id\", \"request_id does not match the request\")\n559|\t\t}},\n560|\t\t{arm: `ctor|failProtocol|body is not a JSON object`, name: \"array body on success\", prove: func(t *testing.T) {\n561|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":true,\"body\":[]`), mustUUIDv7(t, testRequestID))\n562|\t\t\trequireFrameRefusal(t, err, \"body\", \"body is not a JSON object\")\n563|\t\t}},\n564|\t\t{arm: `ctor|failProtocol|error is not a JSON object`, name: \"scalar error on failure\", prove: func(t *testing.T) {\n565|\t\t\t_, err := DecodeResponse(armMemberFrame(`\"ok\":false,\"error\":1`), mustUUIDv7(t, testRequestID))\n566|\t\t\trequireFrameRefusal(t, err, \"error\", \"error is not a JSON object\")\n567|\t\t}},\n568|\t\t{arm: `ctor|failProtocol|error is not a bound Structured Error 1.0.0`, name: \"unbound child version\", prove: func(t *testing.T) {\n569|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)\n570|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n571|\t\t\trequireFrameRefusal(t, err, \"error\", \"error is not a bound Structured Error 1.0.0\")\n572|\t\t}},\n573|\t\t{arm: `ctor|failMismatch|foreign protocol major`, name: \"foreign major is not trusted\", prove: func(t *testing.T) {\n574|\t\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"forged_code\",\"message\":\"forged\",\"exit_code\":0,\"retryable\":true,\"details\":{}}}`)\n575|\t\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n576|\t\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n577|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) code = %v, want incompatible_protocol\", err)\n578|\t\t\t}\n579|\t\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n580|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) observed = %v, want the foreign version\", observed)\n581|\t\t\t}\n582|\t\t\tif failureExit(t, err) != 6 {\n583|\t\t\t\tt.Fatalf(\"DecodeResponse(3.0.0) exit = %d, want 6\", failureExit(t, err))\n584|\t\t\t}\n585|\t\t\tif strings.Contains(err.Error(), \"forged_code\") {\n586|\t\t\t\tt.Fatalf(\"foreign payload leaked into the local failure: %v\", err)\n587|\t\t\t}\n588|\t\t}},\n589|\t\t// Host refusals, through Host.Call over the scripted runner.\n590|\t\t{arm: `ctor|failInvalid|host has no runner`, name: \"runnerless host\", prove: func(t *testing.T) {\n591|\t\t\thost := Host{Now: time.Now}\n592|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n593|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", \"host has no runner\")\n594|\t\t}},\n595|\t\t{arm: `ctor|failTimeout|no response before the request deadline`, name: \"late empty answer\", prove: func(t *testing.T) {\n596|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n597|\t\t\thost := liveHost(runner)\n598|\t\t\treq := liveRequest(t)\n599|\t\t\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n600|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n601|\t\t\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n602|\t\t\tif failureExit(t, err) != 13 {\n603|\t\t\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n604|\t\t\t}\n605|\t\t}},\n606|\t\t{arm: `ctor|failProcess|runner reported no result`, name: \"transport failure with time left\", prove: func(t *testing.T) {\n607|\t\t\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n608|\t\t\thost := liveHost(runner)\n609|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n610|\t\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n611|\t\t}},\n612|\t\t{arm: `ctor|failProtocol|stdout carries more than one frame`, name: \"second line\", prove: func(t *testing.T) {\n613|\t\t\tstdout := append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n')\n614|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: stdout, ExitCode: 0})}}\n615|\t\t\thost := liveHost(runner)\n616|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n617|\t\t\trequireFrameRefusal(t, err, \"\", \"stdout carries more than one frame\")\n618|\t\t}},\n619|\t\t{arm: `ctor|failProcess|plugin exited without a response`, name: \"crash without a frame\", prove: func(t *testing.T) {\n620|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 3})}}\n621|\t\t\thost := liveHost(runner)\n622|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n623|\t\t\trequireLocalRefusal(t, err, \"provider_process_failed\", \"plugin exited without a response\")\n624|\t\t}},\n625|\t\t{arm: `ctor|failProtocol|plugin exited without a response`, name: \"clean exit without a frame\", prove: func(t *testing.T) {\n626|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 0})}}\n627|\t\t\thost := liveHost(runner)\n628|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n629|\t\t\trequireFrameRefusal(t, err, \"\", \"plugin exited without a response\")\n630|\t\t}},\n631|\t}\n632|}\n633|\n634|func declaredIntegrityWitnesses() []armWitness {\n635|\tgood := string(preparedBody())\n636|\twithOp := func(fragment string) []byte {\n637|\t\treturn []byte(strings.Replace(good, `\"materialization_id\"`, fragment+`\"materialization_id\"`, 1))\n638|\t}\n639|\treturn []armWitness{\n640|\t\t{arm: `integrity|status body is not a JSON object`, name: \"status body is not JSON\", prove: func(t *testing.T) {\n641|\t\t\t_, err := DecodeStatusOutcome([]byte(`oops`), testStatusIDs())\n642|\t\t\trequireIntegrityRefusal(t, err, \"status body is not a JSON object\", \"\")\n643|\t\t}},\n644|\t\t{arm: `integrity|status body is not a JSON object`, name: \"status body value is truncated\", prove: func(t *testing.T) {\n645|\t\t\t_, err := DecodeStatusOutcome([]byte(`{\"materialization_id\":`), testStatusIDs())\n646|\t\t\trequireIntegrityRefusal(t, err, \"status body is not a JSON object\", \"\")\n647|\t\t}},\n648|\t\t{arm: `integrity|status body is duplicate member`, name: \"status body repeats state\", prove: func(t *testing.T) {\n649|\t\t\tbody := strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1)\n650|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n651|\t\t\trequireIntegrityRefusal(t, err, \"status body is duplicate member\", \"\")\n652|\t\t}},\n653|\t\t{arm: `integrity|status body is trailing data after the object`, name: \"status body has trailing byte\", prove: func(t *testing.T) {\n654|\t\t\t_, err := DecodeStatusOutcome([]byte(good+\"x\"), testStatusIDs())\n655|\t\t\trequireIntegrityRefusal(t, err, \"status body is trailing data after the object\", \"\")\n656|\t\t}},\n657|\t\t{arm: `integrity|status body is lone surrogate escape`, name: \"status body carries lone surrogate\", prove: func(t *testing.T) {\n658|\t\t\tbody := strings.Replace(good, `\"prepared\"`, `\"pre\\ud800pared\"`, 1)\n659|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n660|\t\t\trequireIntegrityRefusal(t, err, \"status body is lone surrogate escape\", \"\")\n661|\t\t}},\n662|\t\t{arm: `integrity|status body is not valid UTF-8`, name: \"status body carries raw bytes\", prove: func(t *testing.T) {\n663|\t\t\t_, err := DecodeStatusOutcome([]byte(\"{\\\"materialization_id\\\":\\\"\\xff\\\"}\"), testStatusIDs())\n664|\t\t\trequireIntegrityRefusal(t, err, \"status body is not valid UTF-8\", \"\")\n665|\t\t}},\n666|\t\t{arm: `integrity|status body carries unknown member`, name: \"status body carries phase\", prove: func(t *testing.T) {\n667|\t\t\tbody := strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"phase\":\"prepared\"`, 1)\n668|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n669|\t\t\trequireIntegrityRefusal(t, err, \"status body carries unknown member\", \"\")\n670|\t\t}},\n671|\t\t{arm: `integrity|status body misses a required member`, name: \"status body misses state\", prove: func(t *testing.T) {\n672|\t\t\tbody := strings.Replace(good, `,\"state\":\"prepared\"`, ``, 1)\n673|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n674|\t\t\trequireIntegrityRefusal(t, err, \"status body misses a required member\", \"\")\n675|\t\t}},\n676|\t\t{arm: `integrity|status names another materialization`, name: \"foreign materialization\", prove: func(t *testing.T) {\n677|\t\t\tbody := statusBody(\"0198f4c8-aaaa-73aa-9374-1234567890ab\", testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n678|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n679|\t\t\trequireIntegrityRefusal(t, err, \"status names another materialization\", \"\")\n680|\t\t}},\n681|\t\t{arm: `integrity|status names another transaction`, name: \"foreign transaction\", prove: func(t *testing.T) {\n682|\t\t\tbody := statusBody(testMaterializationID, \"0198f4c8-aaaa-73aa-9374-1234567890ab\", testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n683|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n684|\t\t\trequireIntegrityRefusal(t, err, \"status names another transaction\", \"\")\n685|\t\t}},\n686|\t\t{arm: `integrity|status names another transaction authority`, name: \"foreign authority\", prove: func(t *testing.T) {\n687|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, \"another_authority\", testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n688|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n689|\t\t\trequireIntegrityRefusal(t, err, \"status names another transaction authority\", \"\")\n690|\t\t}},\n691|\t\t{arm: `integrity|status operation_id is not a string`, name: \"numeric operation id\", prove: func(t *testing.T) {\n692|\t\t\t_, err := DecodeStatusOutcome(withOp(`\"operation_id\":7,`), testStatusIDs())\n693|\t\t\trequireIntegrityRefusal(t, err, \"status operation_id is not a string\", \"\")\n694|\t\t}},\n695|\t\t{arm: `integrity|status operation_id is not a UUIDv7`, name: \"bogus operation id\", prove: func(t *testing.T) {\n696|\t\t\t_, err := DecodeStatusOutcome(withOp(`\"operation_id\":\"bogus\",`), testStatusIDs())\n697|\t\t\trequireIntegrityRefusal(t, err, \"status operation_id is not a UUIDv7\", \"\")\n698|\t\t}},\n699|\t\t{arm: `integrity|status state is not a registry member`, name: \"preparing state\", prove: func(t *testing.T) {\n700|\t\t\tbody := strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1)\n701|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n702|\t\t\trequireIntegrityRefusal(t, err, \"status state is not a registry member\", \"\")\n703|\t\t}},\n704|\t\t{arm: `integrity|status plan_id is not a string`, name: \"numeric plan id\", prove: func(t *testing.T) {\n705|\t\t\tbody := strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1)\n706|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n707|\t\t\trequireIntegrityRefusal(t, err, \"status plan_id is not a string\", \"prepared\")\n708|\t\t}},\n709|\t\t{arm: `integrity|status plan_id is not a digest`, name: \"malformed digest\", prove: func(t *testing.T) {\n710|\t\t\tbody := strings.Replace(good, testPlanID, \"sha256:xyz\", 1)\n711|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n712|\t\t\trequireIntegrityRefusal(t, err, \"status plan_id is not a digest\", \"prepared\")\n713|\t\t}},\n714|\t\t{arm: `integrity|status rollback_token is not a string`, name: \"numeric token\", prove: func(t *testing.T) {\n715|\t\t\tbody := strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1)\n716|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n717|\t\t\trequireIntegrityRefusal(t, err, \"status rollback_token is not a string\", \"prepared\")\n718|\t\t}},\n719|\t\t{arm: `integrity|status rollback_token is shorter than 256 bits`, name: \"short token\", prove: func(t *testing.T) {\n720|\t\t\tbody := strings.Replace(good, testRollbackToken, \"YWJj\", 1)\n721|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n722|\t\t\trequireIntegrityRefusal(t, err, \"status rollback_token is shorter than 256 bits\", \"prepared\")\n723|\t\t}},\n724|\t\t{arm: `integrity|status native_discovery is not an object`, name: \"scalar discovery\", prove: func(t *testing.T) {\n725|\t\t\tbody := strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1)\n726|\t\t\t_, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n727|\t\t\trequireIntegrityRefusal(t, err, \"status native_discovery is not an object\", \"prepared\")\n728|\t\t}},\n729|\t\t{arm: `integrity|unknown status carries plan, token, or discovery`, name: \"unknown with plan\", prove: func(t *testing.T) {\n730|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"unknown\", \"null\", \"null\")\n731|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n732|\t\t\trequireIntegrityRefusal(t, err, \"unknown status carries plan, token, or discovery\", \"unknown\")\n733|\t\t}},\n734|\t\t{arm: `integrity|transaction state is unknown`, name: \"well-shaped unknown quarantines\", prove: func(t *testing.T) {\n735|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n736|\t\t\tstate, err := DecodeStatusOutcome(body, testStatusIDs())\n737|\t\t\tif state != \"\" {\n738|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q for unknown, want no status\", state)\n739|\t\t\t}\n740|\t\t\trequireIntegrityRefusal(t, err, \"transaction state is unknown\", \"unknown\")\n741|\t\t}},\n742|\t\t{arm: `integrity|prepared status misses plan, token, or discovery`, name: \"prepared without plan\", prove: func(t *testing.T) {\n743|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"prepared\", testRollbackToken, testDiscovery)\n744|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n745|\t\t\trequireIntegrityRefusal(t, err, \"prepared status misses plan, token, or discovery\", \"prepared\")\n746|\t\t}},\n747|\t\t{arm: `integrity|terminal status misses plan or discovery or keeps a token`, name: \"committed keeping token\", prove: func(t *testing.T) {\n748|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", testRollbackToken, testDiscovery)\n749|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n750|\t\t\trequireIntegrityRefusal(t, err, \"terminal status misses plan or discovery or keeps a token\", \"committed\")\n751|\t\t}},\n752|\t}\n753|}\n754|\n755|// declaredParseWitnesses proves each parseMajor rejection branch at the\n756|// production entry. Every value below carries a numeric rest (or no rest\n757|// at all), so only the named branch can refuse it; the prove function\n758|// additionally requires parseMajor itself to reject the version, which\n759|// attributes the DecodeResponse refusal to the classification branch\n760|// rather than to any frame gate. Exit 13 distinguishes the unusable-frame\n761|// path from the exit-6 mismatch path a deleted branch promotes to.\n762|func declaredParseWitnesses() []armWitness {\n763|\tproveUnrecognized := func(version string) func(*testing.T) {\n764|\t\treturn func(t *testing.T) {\n765|\t\t\tt.Helper()\n766|\t\t\tif major, recognized := parseMajor(version); recognized {\n767|\t\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n768|\t\t\t}\n769|\t\t\t_, err := DecodeResponse(armVersionFrame(version), mustUUIDv7(t, testRequestID))\n770|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n771|\t\t\tif failureExit(t, err) != 13 {\n772|\t\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n773|\t\t\t}\n774|\t\t}\n775|\t}\n776|\treturn []armWitness{\n777|\t\t{arm: `parse|len(parts) != 3`, name: \"two-part version\", prove: proveUnrecognized(\"3.0\")},\n778|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"non-numeric major\", prove: proveUnrecognized(\"a.0.0\")},\n779|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"alphanumeric major\", prove: proveUnrecognized(\"2a.0.0\")},\n780|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"negative major\", prove: proveUnrecognized(\"-1.0.0\")},\n781|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"plus major\", prove: proveUnrecognized(\"+3.0.0\")},\n782|\t\t{arm: `parse|len(parts[0]) == 0`, name: \"empty major\", prove: proveUnrecognized(\".0.0\")},\n783|\t\t{arm: `parse|len(rest) == 0`, name: \"empty minor\", prove: proveUnrecognized(\"3..0\")},\n784|\t\t{arm: `parse|rest[i] < '0' || rest[i] > '9'`, name: \"non-numeric rest\", prove: proveUnrecognized(\"3.b.c\")},\n785|\t}\n786|}\n787|\n788|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction: every\n789|// arm derived from production must carry a witness. A planted arm (a new\n790|// frameFault literal or integrity detail through an existing constructor\n791|// site) lands here as an unwitnessed arm.\n792|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n793|\tderived := deriveRefusalArms(t)\n794|\twitnessed := map[string]int{}\n795|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n796|\t\twitnessed[witness.arm]++\n797|\t}\n798|\tvar missing []string\n799|\tfor arm := range derived {\n800|\t\tif witnessed[arm] == 0 {\n801|\t\t\tmissing = append(missing, arm)\n802|\t\t}\n803|\t}\n804|\tsort.Strings(missing)\n805|\tif len(missing) > 0 {\n806|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n807|\t}\n808|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n809|}\n810|\n811|// TestWitnessedArmsAreAllDerived is the reverse direction: every witness\n812|// must name an arm production declares. A deleted or narrowed production\n813|// branch orphans its witness and fails here, which is also what makes a\n814|// truncated derivation fail instead of passing vacuously.\n815|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n816|\tderived := deriveRefusalArms(t)\n817|\tvar orphans []string\n818|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n819|\t\tif _, ok := derived[witness.arm]; !ok {\n820|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n821|\t\t}\n822|\t}\n823|\tsort.Strings(orphans)\n824|\tif len(orphans) > 0 {\n825|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n826|\t}\n827|}\n828|\n829|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every witness\n830|// through its production entry point and requires the attributed refusal.\n831|func TestEveryArmWitnessRefusesAtTheProductionEntry(t *testing.T) {\n832|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n833|\t\tt.Run(witness.arm+\"/\"+witness.name, func(t *testing.T) {\n834|\t\t\twitness.prove(t)\n835|\t\t})\n836|\t}\n837|}"}}}
