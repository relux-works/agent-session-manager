{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4dd","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":201,"recorded_at":1780531400000397,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"8d1ad445-8c45-490a-af73-b989ca2e5ccd"},"task_id":"8d1ad445-8c45-490a-af73-b989ca2e5ccd","event":{"kind":"output","task_id":"8d1ad445-8c45-490a-af73-b989ca2e5ccd","chunk":"Read text file `internal/provhost/protocol_test.go`.\n(499 line(s) above)\n500|\t\tif err != nil {\n501|\t\t\treturn req, -1\n502|\t\t}\n503|\t\treturn req, len(frame)\n504|\t}\n505|\t_, base := build(0)\n506|\toverPad := specFrameLimitBytes - base + 1\n507|\toverReq, overSize := build(overPad)\n508|\tif overSize != -1 {\n509|\t\tt.Fatalf(\"oversize request framed at %d bytes, want refusal over %d\", overSize, specFrameLimitBytes)\n510|\t}\n511|\tif _, err := EncodeRequest(overReq, now); err == nil {\n512|\t\tt.Fatal(\"oversize EncodeRequest succeeded, want invalid_config\")\n513|\t} else {\n514|\t\trequireLocalRefusal(t, err, \"invalid_config\", \"request frame exceeds 8 MiB\")\n515|\t}\n516|\tboundaryReq, boundarySize := build(specFrameLimitBytes - base)\n517|\tif boundarySize != specFrameLimitBytes {\n518|\t\tt.Fatalf(\"boundary request is %d bytes, want exactly %d\", boundarySize, specFrameLimitBytes)\n519|\t}\n520|\tif _, err := EncodeRequest(boundaryReq, now); err != nil {\n521|\t\tt.Fatalf(\"boundary EncodeRequest: %v\", err)\n522|\t}\n523|}\n524|\n525|// TestDecodeResponseWellFormedV3SuccessIsMismatch proves the documented\n526|// v2-only outcome for a syntactically valid 3.0.0 success envelope: it\n527|// is incompatible_protocol, not an admission. A v2/v3 major mismatch\n528|// follows the Section 15.1 close/termination rule; the caller never\n529|// trusts a different major's payload (Section 7.A). The production\n530|// entry point is DecodeResponse.\n531|func TestDecodeResponseWellFormedV3SuccessIsMismatch(t *testing.T) {\n532|\twant := mustUUIDv7(t, testRequestID)\n533|\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n534|\t_, err := DecodeResponse(frame, want)\n535|\tif failureCode(t, err) != \"incompatible_protocol\" {\n536|\t\tt.Fatalf(\"DecodeResponse(3.0.0 success) code = %v, want incompatible_protocol\", err)\n537|\t}\n538|\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n539|\t\tt.Fatalf(\"DecodeResponse(3.0.0 success) observed = %v, want 3.0.0\", observed)\n540|\t}\n541|\tif failureObject(t, err).Version() != axerror.Version100 {\n542|\t\tt.Fatalf(\"DecodeResponse(3.0.0 success) version = %v, want the local Error 1.0.0\", failureObject(t, err).Version())\n543|\t}\n544|}\n545|\n546|// TestDecodeResponseV3FailureWithValid130ErrorIsMismatch proves the v3\n547|// binding is named but never trusted: a 3.0.0 failure envelope carrying\n548|// a well-formed Structured Error 1.3.0 object (the exact binding\n549|// Section 7.A assigns v3) is still incompatible_protocol, and no member\n550|// of the foreign error — code, message, retryable bit, or details —\n551|// reaches the local failure. The embedded error is first decoded through\n552|// the production (provider, 3) → 1.3.0 binding, so the test proves\n553|// refusal of a genuinely well-formed foreign error rather than refusal\n554|// of malformed bytes that any arm would reject. The full rendering is\n555|// asserted, never a shared code: incompatible_protocol is the documented\n556|// mismatch arm, and the assertion pins that the v3 outcome is refusal,\n557|// not admission.\n558|func TestDecodeResponseV3FailureWithValid130ErrorIsMismatch(t *testing.T) {\n559|\twant := mustUUIDv7(t, testRequestID)\n560|\tforeign := []byte(`{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.3.0\",\"code\":\"terminal_backend_integrity_failure\",` +\n561|\t\t`\"message\":\"v3 backend binding failed\",\"exit_code\":9,\"retryable\":false,\"details\":{}}`)\n562|\tif _, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: 3}, foreign); err != nil {\n563|\t\tt.Fatalf(\"embedded v3 error is not well-formed 1.3.0 under the (provider, 3) binding: %v\", err)\n564|\t}\n565|\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,` +\n566|\t\t`\"error\":` + string(foreign) + `}`)\n567|\t_, err := DecodeResponse(frame, want)\n568|\tif failureCode(t, err) != \"incompatible_protocol\" {\n569|\t\tt.Fatalf(\"DecodeResponse(3.0.0 failure) code = %v, want incompatible_protocol\", err)\n570|\t}\n571|\trendered := err.Error()\n572|\tfor _, foreign := range []string{\"terminal_backend_integrity_failure\", \"v3 backend binding failed\"} {\n573|\t\tif strings.Contains(rendered, foreign) {\n574|\t\t\tt.Fatalf(\"foreign v3 payload leaked into the local failure: %v\", err)\n575|\t\t}\n576|\t}\n577|\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n578|\t\tt.Fatalf(\"DecodeResponse(3.0.0 failure) observed = %v, want 3.0.0\", observed)\n579|\t}\n580|}\n581|\n582|// TestDecodeResponseV2FailureWith130ErrorIsBoundTo100 proves the\n583|// failure-error contract is selected by the observed envelope major,\n584|// never the document: a well-formed 1.3.0 error under a 2.0.0 envelope\n585|// is refused as unbound under 1.0.0 rather than decoded as 1.3.0. A\n586|// gate that decoded whatever version the document claimed would admit\n587|// this frame; the named arm below is what keeps the 1.0.0 binding\n588|// exact.\n589|func TestDecodeResponseV2FailureWith130ErrorIsBoundTo100(t *testing.T) {\n590|\twant := mustUUIDv7(t, testRequestID)\n591|\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,` +\n592|\t\t`\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.3.0\",\"code\":\"invalid_config\",` +\n593|\t\t`\"message\":\"wrong version for this envelope\",\"exit_code\":3,\"retryable\":false,\"details\":{}}}`)\n594|\t_, err := DecodeResponse(frame, want)\n595|\trequireFrameRefusal(t, err, \"error\", \"error is not a bound Structured Error 1.0.0\")\n596|\tif strings.Contains(err.Error(), \"wrong version for this envelope\") {\n597|\t\tt.Fatalf(\"foreign-version payload leaked into the local failure: %v\", err)\n598|\t}\n599|}\n600|\n601|// TestParseMajorNeverWraps proves the major is decided on the digit\n602|// string, never on a wrapped accumulator: 18446744073709551617.0.0\n603|// wraps to major 1 and 18446744073709551618.0.0 wraps to major 2 in 64\n604|// bits, so an accumulating gate mistakes both foreign majors for native\n605|// ones. A wrapped major is a version-confusion primitive: the envelope\n606|// gate below decides admission on this number. All four literals are\n607|// recognized (all-numeric X.Y.Z) and must report a major other than 1\n608|// or 2; the wrap-to-2 row additionally must refuse at DecodeResponse as\n609|// a foreign major (incompatible_protocol, exit 6), not as an unusable\n610|// frame (exit 13) and never as 2.0.0.\n611|func TestParseMajorNeverWraps(t *testing.T) {\n612|\tfor _, version := range []string{\n613|\t\t\"18446744073709551617.0.0\",\n614|\t\t\"18446744073709551618.0.0\",\n615|\t\t\"18446744073709551616.0.0\",\n616|\t\t\"99999999999999999999999999999999999999999.0.0\",\n617|\t} {\n618|\t\tmajor, recognized := parseMajor(version)\n619|\t\tif !recognized {\n620|\t\t\tt.Fatalf(\"parseMajor(%q) = unrecognized, want a recognized foreign major\", version)\n621|\t\t}\n622|\t\tif major == 1 || major == 2 {\n623|\t\t\tt.Fatalf(\"parseMajor(%q) = %d, want a major other than 1 or 2\", version, major)\n624|\t\t}\n625|\t}\n626|\n627|\twant := mustUUIDv7(t, testRequestID)\n628|\t_, err := DecodeResponse(armVersionFrame(\"18446744073709551618.0.0\"), want)\n629|\tif failureCode(t, err) != \"incompatible_protocol\" {\n630|\t\tt.Fatalf(\"DecodeResponse(wrapped-to-2 major) code = %v, want incompatible_protocol\", err)\n631|\t}\n632|\tif failureExit(t, err) != 6 {\n633|\t\tt.Fatalf(\"DecodeResponse(wrapped-to-2 major) exit = %d, want 6\", failureExit(t, err))\n634|\t}\n635|}\n636|\n637|// TestParseMajorSaturationStillValidatesTheRest proves saturation never\n638|// short-circuits the X.Y.Z shape check: a version whose first component\n639|// overflows but whose rest is malformed is unrecognized, so\n640|// DecodeResponse refuses it as an unusable frame\n641|// (provider_protocol_error, exit 13), not as a foreign major\n642|// (incompatible_protocol, exit 6). The saturating early return this\n643|// test guards against reported exactly these inputs as recognized; the\n644|// rows below pin the two classes apart so a future short-circuit\n645|// reddens here. The production entry point is DecodeResponse.\n646|func TestParseMajorSaturationStillValidatesTheRest(t *testing.T) {\n647|\twant := mustUUIDv7(t, testRequestID)\n648|\tfor _, version := range []string{\n649|\t\t\"99999999999999999999.abc.def\",\n650|\t\t\"99999999999999999999.0.x\",\n651|\t\t\"99999999999999999999..0\",\n652|\t\t\"18446744073709551618..0\",\n653|\t\t\"18446744073709551618.0.x\",\n654|\t} {\n655|\t\tif major, recognized := parseMajor(version); recognized {\n656|\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n657|\t\t}\n658|\t\t_, err := DecodeResponse(armVersionFrame(version), want)\n659|\t\tif failureCode(t, err) != \"provider_protocol_error\" {\n660|\t\t\tt.Fatalf(\"DecodeResponse(%q) code = %v, want provider_protocol_error\", version, err)\n661|\t\t}\n662|\t\tif failureExit(t, err) != 13 {\n663|\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n664|\t\t}\n665|\t}\n666|}"}}}
