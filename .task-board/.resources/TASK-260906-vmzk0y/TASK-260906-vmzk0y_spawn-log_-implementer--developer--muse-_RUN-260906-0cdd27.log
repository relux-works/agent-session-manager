{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66b","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":400,"recorded_at":1780531400000795,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"0b6dd0a0-0bbb-42d2-af43-12b500008ff6"},"task_id":"0b6dd0a0-0bbb-42d2-af43-12b500008ff6","event":{"kind":"output","task_id":"0b6dd0a0-0bbb-42d2-af43-12b500008ff6","chunk":"Read text file `internal/provhost/identity_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n15|)\n16|\n17|// specIdentityExample is the Section 5.5 Provider Identity Record\n18|// example, copied verbatim from the pinned document: an Antigravity\n19|// backend_conversation_uuid with a non-null realm fingerprint.\n20|const specIdentityExample = `{\n21|  \"schema\": \"urn:ax:schema:provider-identity\",\n22|  \"schema_version\": \"1.0.0\",\n23|  \"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\",\n24|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n25|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n26|  \"provider_id\": \"antigravity\",\n27|  \"provider_version\": \"1.1.14\",\n28|  \"provider_version_range\": \">=1.1.14 <1.2.0\",\n29|  \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n30|  \"identity_kind\": \"backend_conversation_uuid\",\n31|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n32|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n33|  \"opaque_identity\": {},\n34|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n35|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n36|  \"extensions\": {}\n37|}`\n38|\n39|// TestSpecIdentityExampleDecodes proves the Section 5.5 example\n40|// passes the production entry point for its provider.\n41|func TestSpecIdentityExampleDecodes(t *testing.T) {\n42|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n43|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n44|\t}\n45|}\n46|\n47|// TestSpecIdentityExampleVerifiesAgainstItsClaimedDigest pins the true\n48|// fact the identity stated bound rests on: VerifyObjectIdentity over the\n49|// pinned Section 5.5 example returns the example's own record_id with nil\n50|// error, so the example IS the true omit-self digest. A bound claiming\n51|// the example is merely illustrative — and justifying skipped attestation\n52|// by it — fails here instead of shipping as a considered decision. The\n53|// assertion is exact (field and digest), never a nil-error-only check\n54|// that would also pass on a vacuous verifier.\n55|func TestSpecIdentityExampleVerifiesAgainstItsClaimedDigest(t *testing.T) {\n56|\tverified, field, err := canonicaljson.VerifyObjectIdentity([]byte(specIdentityExample))\n57|\tif err != nil {\n58|\t\tt.Fatalf(\"VerifyObjectIdentity(spec example): %v\", err)\n59|\t}\n60|\tif field != canonicaljson.SelfRecordID {\n61|\t\tt.Fatalf(\"VerifyObjectIdentity(spec example) field = %q, want record_id\", field)\n62|\t}\n63|\tconst want = \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"\n64|\tif verified.String() != want {\n65|\t\tt.Fatalf(\"VerifyObjectIdentity(spec example) = %q, want the claimed %q\", verified, want)\n66|\t}\n67|}\n68|\n69|// TestNoProductionPathAttestsProviderIdentityBinding pins the second\n70|// half of the stated bound: no non-test Go file anywhere in the module\n71|// calls VerifyObjectIdentity, so provider-identity binding attestation\n72|// happens nowhere in production — not at this gate and not at the\n73|// persistence layer the old bound named. The day the deferred ruling\n74|// lands a production call site, this test reddens and forces the bound\n75|// to be rewritten around the new truth. The scan is AST-based (comments\n76|// and test files never count) and fails closed when it sees nothing.\n77|func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\n78|\t_, self, _, ok := runtime.Caller(0)\n79|\tif !ok {\n80|\t\tt.Fatal(\"runtime.Caller cannot locate the test file\")\n81|\t}\n82|\troot := filepath.Dir(self)\n83|\tfor {\n84|\t\tif _, err := os.Stat(filepath.Join(root, \"go.mod\")); err == nil {\n85|\t\t\tbreak\n86|\t\t}\n87|\t\tparent := filepath.Dir(root)\n88|\t\tif parent == root {\n89|\t\t\tt.Fatal(\"no module root above the test file; the scan is blind\")\n90|\t\t}\n91|\t\troot = parent\n92|\t}\n93|\tvar scanned, parsed int\n94|\tvar callers []string\n95|\tfileSet := token.NewFileSet()\n96|\tfor _, tree := range []string{\"internal\", \"cmd\"} {\n97|\t\tbase := filepath.Join(root, tree)\n98|\t\tif _, err := os.Stat(base); err != nil {\n99|\t\t\tcontinue\n100|\t\t}\n101|\t\tif err := filepath.Walk(base, func(path string, info os.FileInfo, err error) error {\n102|\t\t\tif err != nil || info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n103|\t\t\t\treturn err\n104|\t\t\t}\n105|\t\t\tscanned++\n106|\t\t\tsource, err := os.ReadFile(path)\n107|\t\t\tif err != nil {\n108|\t\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n109|\t\t\t}\n110|\t\t\tif !strings.Contains(string(source), \"VerifyObjectIdentity\") {\n111|\t\t\t\treturn nil\n112|\t\t\t}\n113|\t\t\tparsed++\n114|\t\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n115|\t\t\tif err != nil {\n116|\t\t\t\tt.Fatalf(\"parse %s: %v\", path, err)\n117|\t\t\t}\n118|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n119|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n120|\t\t\t\tif !ok {\n121|\t\t\t\t\treturn true\n122|\t\t\t\t}\n123|\t\t\t\tswitch fun := call.Fun.(type) {\n124|\t\t\t\tcase *ast.SelectorExpr:\n125|\t\t\t\t\tif fun.Sel.Name == \"VerifyObjectIdentity\" {\n126|\t\t\t\t\t\tposition := fileSet.Position(call.Pos())\n127|\t\t\t\t\t\tcallers = append(callers, fmt.Sprintf(\"%s:%d\", position.Filename, position.Line))\n128|\t\t\t\t\t}\n129|\t\t\t\tcase *ast.Ident:\n130|\t\t\t\t\tif fun.Name == \"VerifyObjectIdentity\" {\n131|\t\t\t\t\t\t// The canonicaljson definition itself is a\n132|\t\t\t\t\t\t// FuncDecl, never a call; a bare-identifier call\n133|\t\t\t\t\t\t// anywhere is a production call site.\n134|\t\t\t\t\t\tposition := fileSet.Position(call.Pos())\n135|\t\t\t\t\t\tcallers = append(callers, fmt.Sprintf(\"%s:%d\", position.Filename, position.Line))\n136|\t\t\t\t\t}\n137|\t\t\t\t}\n138|\t\t\t\treturn true\n139|\t\t\t})\n140|\t\t\treturn nil\n141|\t\t}); err != nil {\n142|\t\t\tt.Fatalf(\"walk %s: %v\", base, err)\n143|\t\t}\n144|\t}\n145|\tif scanned == 0 {\n146|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n147|\t}\n148|\tif len(callers) != 0 {\n149|\t\tt.Fatalf(\"production call sites attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\n150|\t}\n151|\tt.Logf(\"attestation scan: %d production files, %d parsed, 0 production call sites\", scanned, parsed)\n152|}\n153|\n154|// identityVariant rewrites one unique substring of the example.\n155|func identityVariant(t *testing.T, old, new string) []byte {\n156|\tt.Helper()\n157|\tif strings.Count(specIdentityExample, old) != 1 {\n158|\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\n159|\t}\n160|\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\n161|}\n162|\n163|// TestCheckIdentityRefusals drives every identity rule, including\n164|// the five normative Section 5.5 negatives: unknown identity_kind,\n165|// absent opaque_identity, an object opaque value, an absolute source\n166|// path in that map, and an Antigravity backend_conversation_uuid\n167|// with a null realm fingerprint.\n168|func TestCheckIdentityRefusals(t *testing.T) {\n169|\tlong128 := strings.Repeat(\"v\", 128)\n170|\tlong129 := strings.Repeat(\"v\", 129)\n171|\tlong1024 := strings.Repeat(\"v\", 1024)\n172|\tlong1025 := strings.Repeat(\"v\", 1025)\n173|\tlong256 := strings.Repeat(\"r\", 256)\n174|\tlong257 := strings.Repeat(\"r\", 257)\n175|\tlong512 := strings.Repeat(\"s\", 512)\n176|\tlong513 := strings.Repeat(\"s\", 513)\n177|\tkey64 := \"k\" + strings.Repeat(\"e\", 63)\n178|\tkey65 := \"k\" + strings.Repeat(\"e\", 64)\n179|\trows := []struct {\n180|\t\tname   string\n181|\t\tbody   []byte\n182|\t\tmember string\n183|\t\tdetail string\n184|\t}{\n185|\t\t{\"unknown member\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"score\": 1`), \"score\", \"unknown member\"},\n186|\t\t{\"absent opaque_identity\", []byte(strings.Replace(specIdentityExample, \"  \\\"opaque_identity\\\": {},\\n\", \"\", 1)), \"opaque_identity\", \"misses a required member\"},\n187|\t\t{\"wrong schema\", identityVariant(t, `\"urn:ax:schema:provider-identity\"`, `\"urn:ax:schema:provider-manifest\"`), \"schema\", \"not the provider identity\"},\n188|\t\t{\"wrong schema version\", identityVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"1.1.0\"`), \"schema_version\", \"not 1.0.0\"},\n189|\t\t{\"bad record digest\", identityVariant(t, `\"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"`, `\"record_id\": \"sha256:zzzz\"`), \"record_id\", \"not a digest\"},\n190|\t\t{\"bad subject uuid\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"not-a-uuid\"`), \"subject_id\", \"not a UUIDv7\"},\n191|\t\t{\"bad session uuid\", identityVariant(t, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ax\"`), \"session_id\", \"not a UUIDv7\"},\n192|\t\t{\"subject differs\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`), \"subject_id\", \"does not equal session_id\"},\n193|\t\t{\"bad provider grammar\", identityVariant(t, `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"Antigravity\"`), \"provider_id\", \"not a provider id\"},\n194|\t\t{\"empty provider version\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n195|\t\t{\"provider version 129\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long129+`\"`), \"provider_version\", \"not 1..128 characters\"},\n196|\t\t{\"empty version range\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"\"`), \"provider_version_range\", \"not 1..256 characters\"},\n197|\t\t{\"version range 257\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"`+long257+`\"`), \"provider_version_range\", \"not 1..256 characters\"},\n198|\t\t{\"empty native session\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"\"`), \"native_session_id\", \"not 1..512 characters\"},\n199|\t\t{\"native session 513\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"`+long513+`\"`), \"native_session_id\", \"not 1..512 characters\"},\n200|\t\t{\"unknown identity_kind\", identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"window_handle\"`), \"identity_kind\", \"not a registry member\"},\n201|\t\t{\"bad workspace uuid\", identityVariant(t, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"`, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890aX\"`), \"logical_workspace_id\", \"not a UUIDv7\"},\n202|\t\t{\"bad realm digest\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": \"nope\"`), \"backend_realm_fingerprint\", \"not a digest or null\"},\n203|\t\t{\"antigravity null realm\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`), \"backend_realm_fingerprint\", \"required for this backend kind\"},\n204|\t\t{\"opaque object value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": {\"nested\": true}}`), \"opaque_identity\", \"not 1..1024 characters\"},\n205|\t\t{\"opaque absolute path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"/Users/iv/work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n206|\t\t{\"opaque windows path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"C:\\\\work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n207|\t\t{\"opaque bad key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"Bad Key!\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n208|\t\t{\"opaque digit-first key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"0adapter\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n209|\t\t{\"opaque 65-character key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"`+key65+`\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n210|\t\t{\"opaque empty value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"\"}`), \"opaque_identity\", \"not 1..1024 characters\"},\n211|\t\t{\"opaque long value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"`+long1025+`\"}`), \"opaque_identity\", \"not 1..1024 characters\"},\n212|\t\t{\"bad host uuid\", identityVariant(t, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890aG\"`), \"created_by_host_id\", \"not a UUIDv7\"},\n213|\t\t{\"bad timestamp\", identityVariant(t, `\"created_at\": \"2026-08-19T04:09:45.000Z\"`, `\"created_at\": \"yesterday\"`), \"created_at\", \"not a timestamp\"},\n214|\t\t{\"extensions array\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": []`), \"extensions\", \"not an object\"},\n215|\t\t{\"raw WTF-8 surrogate\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, \"\\\"native_session_id\\\": \\\"11111\\xed\\xa0\\x801111-2222-4333-8444-555555555555\\\"\"), \"\", \"not valid UTF-8\"},\n216|\t}\n217|\tfor _, row := range rows {\n218|\t\tt.Run(row.name, func(t *testing.T) {\n219|\t\t\trequireFrameRefusal(t, CheckIdentity(row.body, \"antigravity\"), row.member, row.detail)\n220|\t\t})\n221|\t}\n222|\tif err := CheckIdentity(identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long128+`\"`), \"antigravity\"); err != nil {\n223|\t\tt.Fatalf(\"128-character provider version refused: %v\", err)\n224|\t}\n225|\tif err := CheckIdentity(identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"`+long1024+`\"}`), \"antigravity\"); err != nil {\n226|\t\tt.Fatalf(\"1024-character opaque value refused: %v\", err)\n227|\t}\n228|\tif err := CheckIdentity(identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"`+long256+`\"`), \"antigravity\"); err != nil {\n229|\t\tt.Fatalf(\"256-character version range refused: %v\", err)\n230|\t}\n231|\tif err := CheckIdentity(identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"`+long512+`\"`), \"antigravity\"); err != nil {\n232|\t\tt.Fatalf(\"512-character native session refused: %v\", err)\n233|\t}\n234|\tif err := CheckIdentity(identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"`+key64+`\": \"x\"}`), \"antigravity\"); err != nil {\n235|\t\tt.Fatalf(\"64-character opaque key refused: %v\", err)\n236|\t}\n237|}\n238|\n239|// TestCheckIdentityNamesAnotherProvider proves the caller seat: a\n240|// well-formed record for another provider is a caller error, not a\n241|// frame error, and a null realm is honest for non-Antigravity kinds.\n242|func TestCheckIdentityNamesAnotherProvider(t *testing.T) {\n243|\trequireLocalRefusal(t, CheckIdentity([]byte(specIdentityExample), \"codex\"), \"invalid_config\", \"names another provider\")\n244|\t// Equal-length pair: claude and gemini are both six characters,\n245|\t// so a length-based correlation passes this fixture and fails in\n246|\t// production. The gate must compare the provider itself.\n247|\tclaude := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"session_uuid\"`)\n248|\tclaude = []byte(strings.Replace(string(claude), `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"claude\"`, 1))\n249|\tclaude = []byte(strings.Replace(string(claude), `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`, 1))\n250|\tif len(\"claude\") != len(\"gemini\") {\n251|\t\tt.Fatal(\"claude and gemini are no longer the same length; the fixture is blind\")\n252|\t}\n253|\trequireLocalRefusal(t, CheckIdentity(claude, \"gemini\"), \"invalid_config\", \"names another provider\")\n254|\totherKind := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"session_uuid\"`)\n255|\totherKind = []byte(strings.Replace(string(otherKind), `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"codex\"`, 1))\n256|\totherKind = []byte(strings.Replace(string(otherKind), `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`, 1))\n257|\tif err := CheckIdentity(otherKind, \"codex\"); err != nil {\n258|\t\tt.Fatalf(\"codex session_uuid with null realm refused: %v\", err)\n259|\t}\n260|}\n261|\n262|// specIdentifyResult wraps the identity example in the\n263|// identify-session success shape.\n264|const specIdentifyResultPrefix = `{\n265|  \"identity\": `\n266|\n267|// TestDecodeIdentifyResultFixtures proves the wrapper: the example\n268|// record with exact confidence and one evidence member validates,\n269|// and every wrapper rule refuses with its own arm.\n270|func TestDecodeIdentifyResultFixtures(t *testing.T) {\n271|\tindented := strings.ReplaceAll(specIdentityExample, \"\\n\", \"\\n  \")\n272|\tbody := []byte(specIdentifyResultPrefix + \"  \" + strings.TrimPrefix(indented, \"  \") + `,\n273|  \"confidence\": \"exact\",\n274|  \"matched_evidence\": [\"native_id\"]\n275|}`)\n276|\tif err := DecodeIdentifyResult(body, \"antigravity\"); err != nil {\n277|\t\tt.Fatalf(\"DecodeIdentifyResult(spec): %v\", err)\n278|\t}\n279|\twith := func(old, new string) []byte {\n280|\t\tt.Helper()\n281|\t\tfull := string(body)\n282|\t\tif strings.Count(full, old) != 1 {\n283|\t\t\tt.Fatalf(\"identify variant anchor %q is not unique\", old)\n284|\t\t}\n285|\t\treturn []byte(strings.Replace(full, old, new, 1))\n286|\t}\n287|\trows := []struct {\n288|\t\tname   string\n289|\t\tbody   []byte\n290|\t\tmember string\n291|\t\tdetail string\n292|\t}{\n293|\t\t{\"unknown member\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\"], \"score\": 1`), \"score\", \"unknown member\"},\n294|\t\t{\"missing member\", []byte(strings.Replace(string(body), \"  \\\"confidence\\\": \\\"exact\\\",\\n\", \"\", 1)), \"confidence\", \"misses a required member\"},\n295|\t\t{\"bad confidence\", with(`\"confidence\": \"exact\"`, `\"confidence\": \"certain\"`), \"confidence\", \"not exact strong or weak\"},\n296|\t\t{\"evidence empty\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": []`), \"matched_evidence\", \"not 1..4 members\"},\n297|\t\t{\"evidence five\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\", \"native_id\"]`), \"matched_evidence\", \"not 1..4 members\"},\n298|\t\t{\"evidence unknown\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"window_title\"]`), \"matched_evidence\", \"unknown member\"},\n299|\t\t{\"evidence unsorted\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"store_path\", \"native_id\"]`), \"matched_evidence\", \"not sorted unique\"},\n300|\t\t{\"evidence duplicated\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\", \"native_id\"]`), \"matched_evidence\", \"not sorted unique\"},\n301|\t\t{\"identity not object\", []byte(`{\"identity\": [], \"confidence\": \"exact\", \"matched_evidence\": [\"native_id\"]}`), \"identity\", \"not an object\"},\n302|\t}\n303|\tfor _, row := range rows {\n304|\t\tt.Run(row.name, func(t *testing.T) {\n305|\t\t\trequireFrameRefusal(t, DecodeIdentifyResult(row.body, \"antigravity\"), row.member, row.detail)\n306|\t\t})\n307|\t}\n308|\t// A well-formed record for another provider is a caller error,\n309|\t// not a frame error.\n310|\trequireLocalRefusal(t, DecodeIdentifyResult(body, \"codex\"), \"invalid_config\", \"names another provider\")\n311|}"}}}
