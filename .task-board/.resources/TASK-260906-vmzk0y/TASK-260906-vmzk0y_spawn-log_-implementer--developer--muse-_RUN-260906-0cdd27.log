{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b7","stream":{"kind":"session","id":"01a07916-2a5a-7c91-941e-599b9b859136"},"sequence":310,"recorded_at":1780531400000615,"record_type":"event","durability":"durable","causation_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"256d89a1-396a-4382-a1d7-c6813bb31cc7","run_stream":{"kind":"run","id":"256d89a1-396a-4382-a1d7-c6813bb31cc7"},"task_stream":{"kind":"task","id":"c2f833ee-60cb-40c5-bc28-80dcaaee0cc9"},"task_id":"c2f833ee-60cb-40c5-bc28-80dcaaee0cc9","event":{"kind":"output","task_id":"c2f833ee-60cb-40c5-bc28-80dcaaee0cc9","chunk":"Read text file `.temp/TASK-260906-vmzk0y/review-rev3/battery.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer mutation battery for TASK-260906-vmzk0y CR rev3.\n3|\n4|Each mutant is applied to a pristine copy of the target file, the named\n5|test scope is run as a standalone process, and the file is restored\n6|byte-identically afterwards (asserted).\n7|\"\"\"\n8|import hashlib, json, os, shutil, subprocess, sys\n9|\n10|ROOT = os.getcwd()\n11|PROTO = \"internal/provhost/protocol.go\"\n12|INV = \"internal/provhost/refusal_arm_inventory_test.go\"\n13|BACKUP = \".temp/TASK-260906-vmzk0y/review-rev3\"\n14|\n15|TARGETS = {PROTO: os.path.join(BACKUP, \"protocol.go.pristine\"),\n16|           INV: os.path.join(BACKUP, \"inventory_test.go.pristine\")}\n17|\n18|for path, pristine in TARGETS.items():\n19|    shutil.copyfile(path, pristine)\n20|\n21|def sha(path):\n22|    return hashlib.sha256(open(path, \"rb\").read()).hexdigest()\n23|\n24|PRISTINE_SHA = {p: sha(p) for p in TARGETS}\n25|\n26|PEEK_OLD_UNUSED = '\\t\\t\\t\\tif rawVersion, present := members[\"protocol_version\"]; present {\\n\\t\\t\\t\\t\\tvar version string\\n\\t\\t\\t\\t\\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\\n\\t\\t\\t\\t\\t\\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {'\n27|GATE_OLD = '''\tif version != ProtocolVersion {\n28|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {'''\n29|\n30|PEEK_OLD = \"\\t\\t\\t\\t\\t\" + \"if major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\"\n31|\n32|MUTANTS = [\n33|    # id, class, file, old, new, detail\n34|    (\"M1\", \"narrowing\", PROTO,\n35|     \"\\t\\t\\tmajor = math.MaxInt\\n\\t\\t\\tcontinue\\n\",\n36|     \"\\t\\t\\treturn math.MaxInt, true\\n\",\n37|     \"P3: round-2 early-return shape; giant-with-malformed-rest reads recognized\"),\n38|    (\"M2\", \"narrowing\", PROTO,\n39|     \"if major > (math.MaxInt-step)/10 {\",\n40|     \"if major > math.MaxInt {\",\n41|     \"P3: guard never fires; accumulation wraps again\"),\n42|    (\"M3\", \"narrowing\", PROTO,\n43|     \"if major > (math.MaxInt-step)/10 {\",\n44|     \"if major > math.MaxInt/10 {\",\n45|     \"P3: threshold off-by-one (drops the step term)\"),\n46|    (\"M4\", \"narrowing\", PROTO,\n47|     \"\\t\\tif len(rest) == 0 {\",\n48|     \"\\t\\tif len(rest) < 0 {\",\n49|     \"P5: empty-rest arm never fires (token preserved)\"),\n50|    (\"M5\", \"narrowing\", PROTO,\n51|     \"\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n52|     \"\\t\\t\\tif rest[i] < '/' || rest[i] > '9' {\",\n53|     \"P6: rest admits exactly one rejected member ('/')\"),\n54|    (\"M6\", \"narrowing\", PROTO,\n55|     \"\\t\\tif digit < '0' || digit > '9' {\",\n56|     \"\\t\\tif digit < '0' || digit > ':' {\",\n57|     \"P2: major admits exactly one rejected member (':')\"),\n58|    (\"M7\", \"narrowing\", PROTO,\n59|     \"\\tif len(parts) != 3 {\",\n60|     \"\\tif len(parts) < 3 {\",\n61|     \"P1: admits exactly the over-long shape (4+ parts)\"),\n62|    (\"M8\", \"narrowing\", PROTO,\n63|     \"\\tif len(parts[0]) == 0 {\",\n64|     \"\\tif len(parts[0]) < 0 {\",\n65|     \"P4: empty-major arm never fires (token preserved)\"),\n66|    (\"M9\", \"arm-deletion\", PROTO,\n67|     \"\\tfor _, rest := range parts[1:] {\\n\\t\\tif len(rest) == 0 {\\n\\t\\t\\treturn 0, false\\n\\t\\t}\\n\\t\\tfor i := 0; i < len(rest); i++ {\\n\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\\n\\t\\t\\t\\treturn 0, false\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\",\n68|     \"\",\n69|     \"P5+P6: whole minor/patch validation deleted\"),\n70|    (\"M10\", \"arm-deletion\", PROTO,\n71|     \"\\tif len(parts) != 3 {\\n\\t\\treturn 0, false\\n\\t}\\n\",\n72|     \"\",\n73|     \"P1: three-part shape check deleted\"),\n74|    (\"M11\", \"narrowing\", PROTO,\n75|     \"axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}\",\n76|     \"axerror.ContainingContract{ID: ProtocolID, Major: observedMajor + 1}\",\n77|     \"C1: failure-error contract shifted off the observed major\"),\n78|    (\"M12\", \"equivalence-probe\", PROTO,\n79|     \"\\tobservedMajor, _ := parseMajor(version)\\n\\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}, members[\\\"error\\\"])\",\n80|     \"\\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: 2}, members[\\\"error\\\"])\",\n81|     \"C1: revert to the hardcoded major-2 contract (expected equivalent today)\"),\n82|    (\"M13b\", \"narrowing\", PROTO,\n83|     PEEK_OLD,\n84|     PEEK_OLD.replace(\"recognized && major != ProtocolMajor\", \"recognized || major != ProtocolMajor\"),\n85|     \"K1: foreignMajor peek widened to unrecognized versions (re-anchored)\"),\n86|    (\"M14b\", \"narrowing\", PROTO,\n87|     PEEK_OLD,\n88|     PEEK_OLD.replace(\"recognized && major != ProtocolMajor\", \"recognized && major > ProtocolMajor\"),\n89|     \"K2: foreignMajor peek narrowed to majors above 2 (re-anchored)\"),\n90|    (\"M16\", \"narrowing\", PROTO,\n91|     GATE_OLD,\n92|     GATE_OLD.replace(\"recognized && major != ProtocolMajor\", \"recognized && major > ProtocolMajor\"),\n93|     \"V1: version-gate mismatch arm narrowed to majors above 2 (re-anchored)\"),\n94|    (\"M15\", \"census-only\", INV,\n95|     'if ok && function.Name.Name == \"parseMajor\" {',\n96|     'if ok && function.Name.Name == \"parseMajorXX\" {',\n97|     \"census derives zero parse arms (production untouched)\"),\n98|]\n99|\n100|CONTROLS = [\n101|    (\"X1\", \"control-absent\", PROTO,\n102|     \"if major >= (math.MaxInt-step)/10 {\",\n103|     \"if major > (math.MaxInt-step)/10 {\",\n104|     \"anchor uses >=, absent from source\"),\n105|    (\"X2\", \"control-compile\", PROTO,\n106|     \"\\t\\tif major > (math.MaxInt-step)/10 {\\n\\t\\t\\tmajor = math.MaxInt\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\",\n107|     \"\",\n108|     \"guard deleted outright, math import unused\"),\n109|]\n110|\n111|def run(cmd):\n112|    p = subprocess.run(cmd, shell=True, capture_output=True, text=True)\n113|    return p.returncode, p.stdout + p.stderr\n114|\n115|def apply_and_test(mid, cls, path, old, new, detail):\n116|    src = open(path).read()\n117|    n = src.count(old)\n118|    if n != 1:\n119|        return {\"id\": mid, \"class\": cls, \"disposition\": \"NOT_APPLIED\",\n120|                \"detail\": f\"{detail}; anchor sites={n}, want 1\"}\n121|    open(path, \"w\").write(src.replace(old, new))\n122|    try:\n123|        bcode, bout = run(\"go build ./internal/provhost/\")\n124|        if bcode != 0:\n125|            return {\"id\": mid, \"class\": cls, \"disposition\": \"COMPILE_FAIL\",\n126|                    \"detail\": detail, \"build\": bout.strip().splitlines()[:3]}\n127|        tcode, tout = run(\"go test ./internal/provhost/ -count=1\")\n128|        failed = sorted({l.split()[2] for l in tout.splitlines()\n129|                         if l.strip().startswith(\"--- FAIL:\")})\n130|        return {\"id\": mid, \"class\": cls,\n131|                \"disposition\": \"KILLED\" if tcode != 0 else \"SURVIVED\",\n132|                \"killed_by\": failed, \"detail\": detail}\n133|    finally:\n134|        shutil.copyfile(TARGETS[path], path)\n135|        assert sha(path) == PRISTINE_SHA[path], f\"restore failed for {path}\"\n136|\n137|only = sys.argv[1:]\n138|results = []\n139|for m in MUTANTS + CONTROLS:\n140|    if only and m[0] not in only:\n141|        continue\n142|    r = apply_and_test(*m)\n143|    results.append(r)\n144|    print(json.dumps(r), flush=True)\n145|\n146|tag = \"-\".join(only) if only else \"all\"\n147|json.dump(results, open(os.path.join(BACKUP, f\"battery-{tag}.json\"), \"w\"), indent=2)\n148|for p in TARGETS:\n149|    assert sha(p) == PRISTINE_SHA[p], f\"final restore check failed for {p}\"\n150|print(\"ALL RESTORED\")"}}}
