{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c793","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":548,"recorded_at":1780531400001091,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"c28cf15e-e903-4ead-80a2-45534efcdda2"},"task_id":"c28cf15e-e903-4ead-80a2-45534efcdda2","event":{"kind":"output","task_id":"c28cf15e-e903-4ead-80a2-45534efcdda2","chunk":"Read text file `internal/provhost/identity_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// specIdentityExample is the Section 5.5 Provider Identity Record\n9|// example, copied verbatim from the pinned document: an Antigravity\n10|// backend_conversation_uuid with a non-null realm fingerprint.\n11|const specIdentityExample = `{\n12|  \"schema\": \"urn:ax:schema:provider-identity\",\n13|  \"schema_version\": \"1.0.0\",\n14|  \"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\",\n15|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n16|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n17|  \"provider_id\": \"antigravity\",\n18|  \"provider_version\": \"1.1.14\",\n19|  \"provider_version_range\": \">=1.1.14 <1.2.0\",\n20|  \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n21|  \"identity_kind\": \"backend_conversation_uuid\",\n22|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n23|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n24|  \"opaque_identity\": {},\n25|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n26|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n27|  \"extensions\": {}\n28|}`\n29|\n30|// TestSpecIdentityExampleDecodes proves the Section 5.5 example\n31|// passes the production entry point for its provider.\n32|func TestSpecIdentityExampleDecodes(t *testing.T) {\n33|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n34|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n35|\t}\n36|}\n37|\n38|// identityVariant rewrites one unique substring of the example.\n39|func identityVariant(t *testing.T, old, new string) []byte {\n40|\tt.Helper()\n41|\tif strings.Count(specIdentityExample, old) != 1 {\n42|\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\n43|\t}\n44|\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\n45|}\n46|\n47|// TestCheckIdentityRefusals drives every identity rule, including\n48|// the five normative Section 5.5 negatives: unknown identity_kind,\n49|// absent opaque_identity, an object opaque value, an absolute source\n50|// path in that map, and an Antigravity backend_conversation_uuid\n51|// with a null realm fingerprint.\n52|func TestCheckIdentityRefusals(t *testing.T) {\n53|\tlong128 := strings.Repeat(\"v\", 128)\n54|\tlong129 := strings.Repeat(\"v\", 129)\n55|\tlong1024 := strings.Repeat(\"v\", 1024)\n56|\tlong1025 := strings.Repeat(\"v\", 1025)\n57|\tlong256 := strings.Repeat(\"r\", 256)\n58|\tlong257 := strings.Repeat(\"r\", 257)\n59|\tlong512 := strings.Repeat(\"s\", 512)\n60|\tlong513 := strings.Repeat(\"s\", 513)\n61|\tkey64 := \"k\" + strings.Repeat(\"e\", 63)\n62|\tkey65 := \"k\" + strings.Repeat(\"e\", 64)\n63|\trows := []struct {\n64|\t\tname   string\n65|\t\tbody   []byte\n66|\t\tmember string\n67|\t\tdetail string\n68|\t}{\n69|\t\t{\"unknown member\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"score\": 1`), \"score\", \"unknown member\"},\n70|\t\t{\"absent opaque_identity\", []byte(strings.Replace(specIdentityExample, \"  \\\"opaque_identity\\\": {},\\n\", \"\", 1)), \"opaque_identity\", \"misses a required member\"},\n71|\t\t{\"wrong schema\", identityVariant(t, `\"urn:ax:schema:provider-identity\"`, `\"urn:ax:schema:provider-manifest\"`), \"schema\", \"not the provider identity\"},\n72|\t\t{\"wrong schema version\", identityVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"1.1.0\"`), \"schema_version\", \"not 1.0.0\"},\n73|\t\t{\"bad record digest\", identityVariant(t, `\"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"`, `\"record_id\": \"sha256:zzzz\"`), \"record_id\", \"not a digest\"},\n74|\t\t{\"bad subject uuid\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"not-a-uuid\"`), \"subject_id\", \"not a UUIDv7\"},\n75|\t\t{\"bad session uuid\", identityVariant(t, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ax\"`), \"session_id\", \"not a UUIDv7\"},\n76|\t\t{\"subject differs\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`), \"subject_id\", \"does not equal session_id\"},\n77|\t\t{\"bad provider grammar\", identityVariant(t, `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"Antigravity\"`), \"provider_id\", \"not a provider id\"},\n78|\t\t{\"empty provider version\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n79|\t\t{\"provider version 129\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long129+`\"`), \"provider_version\", \"not 1..128 characters\"},\n80|\t\t{\"empty version range\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"\"`), \"provider_version_range\", \"not 1..256 characters\"},\n81|\t\t{\"version range 257\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"`+long257+`\"`), \"provider_version_range\", \"not 1..256 characters\"},\n82|\t\t{\"empty native session\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"\"`), \"native_session_id\", \"not 1..512 characters\"},\n83|\t\t{\"native session 513\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"`+long513+`\"`), \"native_session_id\", \"not 1..512 characters\"},\n84|\t\t{\"unknown identity_kind\", identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"window_handle\"`), \"identity_kind\", \"not a registry member\"},\n85|\t\t{\"bad workspace uuid\", identityVariant(t, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"`, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890aX\"`), \"logical_workspace_id\", \"not a UUIDv7\"},\n86|\t\t{\"bad realm digest\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": \"nope\"`), \"backend_realm_fingerprint\", \"not a digest or null\"},\n87|\t\t{\"antigravity null realm\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`), \"backend_realm_fingerprint\", \"required for this backend kind\"},\n88|\t\t{\"opaque object value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": {\"nested\": true}}`), \"opaque_identity\", \"not 1..1024 characters\"},\n89|\t\t{\"opaque absolute path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"/Users/iv/work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n90|\t\t{\"opaque windows path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"C