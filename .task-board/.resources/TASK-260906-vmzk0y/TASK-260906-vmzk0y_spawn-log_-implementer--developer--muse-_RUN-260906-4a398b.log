{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"efc8a3fb-ad93-4c13-8d07-83861e9c7130"},"task_id":"efc8a3fb-ad93-4c13-8d07-83861e9c7130","event":{"kind":"output","task_id":"efc8a3fb-ad93-4c13-8d07-83861e9c7130","chunk":"Read text file `internal/axerror/details.go`.\n(189 line(s) above)\n190|\t\treturn fmt.Errorf(\"%w: details[%q] uses unsupported JSON type %T\", ErrInvalidDetails, key, value)\n191|\t}\n192|}\n193|\n194|// refuseCausalLeak refuses human text or diagnostic values that reproduce the\n195|// rendered text of the local cause verbatim. It exists because the ordinary way\n196|// to lose a secret is fmt.Errorf(\"...: %v\", err) on a cause that wrapped a\n197|// command line, a transport payload, or a provider's stderr.\n198|//\n199|// What it decides is narrow and stated: verbatim containment of the whole\n200|// rendered cause, and of each of its wrapped links. A paraphrase, a truncation,\n201|// or a single extracted field of the cause is not detected. Causes shorter than\n202|// minRedactableCause characters are skipped, because a cause rendering as\n203|// \"EOF\" would otherwise refuse every message containing that substring.\n204|func refuseCausalLeak(message string, details Details, cause error) error {\n205|\tfor _, rendered := range causeChainText(cause) {\n206|\t\tif utf8.RuneCountInString(rendered) < minRedactableCause {\n207|\t\t\tcontinue\n208|\t\t}\n209|\t\tif strings.Contains(message, rendered) {\n210|\t\t\treturn fmt.Errorf(\"%w: message reproduces the local cause verbatim\", ErrCausalLeak)\n211|\t\t}\n212|\t\tfor _, key := range sortedKeys(details) {\n213|\t\t\tif valueContains(details[key], rendered) {\n214|\t\t\t\treturn fmt.Errorf(\"%w: details[%q] reproduces the local cause verbatim\", ErrCausalLeak, key)\n215|\t\t\t}\n216|\t\t}\n217|\t}\n218|\treturn nil\n219|}\n220|\n221|// causeChainText renders every link of the cause chain. Checking only the\n222|// outermost rendering would miss a message that copied the innermost wrapped\n223|// error, which is the link most likely to hold the untrusted text.\n224|func causeChainText(cause error) []string {\n225|\tvar rendered []string\n226|\tfor current := cause; current != nil; {\n227|\t\trendered = append(rendered, current.Error())\n228|\t\tswitch unwrapped := current.(type) {\n229|\t\tcase interface{ Unwrap() error }:\n230|\t\t\tcurrent = unwrapped.Unwrap()\n231|\t\tcase interface{ Unwrap() []error }:\n232|\t\t\tfor _, joined := range unwrapped.Unwrap() {\n233|\t\t\t\trendered = append(rendered, causeChainText(joined)...)\n234|\t\t\t}\n235|\t\t\tcurrent = nil\n236|\t\tdefault:\n237|\t\t\tcurrent = nil\n238|\t\t}\n239|\t}\n240|\treturn rendered\n241|}\n242|\n243|func valueContains(value any, needle string) bool {\n244|\tswitch typed := value.(type) {\n245|\tcase string:\n246|\t\treturn strings.Contains(typed, needle)\n247|\tcase []any:\n248|\t\tfor _, member := range typed {\n249|\t\t\tif valueContains(member, needle) {\n(more lines below)"}}}
