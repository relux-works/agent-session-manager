{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccb9","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":1207,"recorded_at":1780531400002409,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"89422d7a-3b55-4404-a290-58899caabc9c"},"task_id":"89422d7a-3b55-4404-a290-58899caabc9c","event":{"kind":"output","task_id":"89422d7a-3b55-4404-a290-58899caabc9c","chunk":"edited\nchanged lines: lines 358-373\n--- original\n+++ updated\n@@\n-// parseMajor extracts the major from a strict numeric X.Y.Z version.\n-// Anything else is not a recognizable major, so the frame is unusable\n-// rather than a mismatch.\n-func parseMajor(version string) (int, bool) {\n-\tparts := strings.Split(version, \".\")\n-\tif len(parts) != 3 {\n-\t\treturn 0, false\n-\t}\n-\tmajor := 0\n-\tfor i := 0; i < len(parts[0]); i++ {\n-\t\tdigit := parts[0][i]\n-\t\tif digit < '0' || digit > '9' {\n-\t\t\treturn 0, false\n-\t\t}\n-\t\tmajor = major*10 + int(digit-'0')\n-\t}\n+// parseMajor extracts the major from a strict numeric X.Y.Z version.\n+// Anything else is not a recognizable major, so the frame is unusable\n+// rather than a mismatch. A major that does not fit an int saturates\n+// instead of wrapping but stays recognized: an all-numeric giant is\n+// observably foreign (it is not 2), so it must take the mismatch arm,\n+// never alias a small native major (18446744073709551618 must not read\n+// as 2) and never slide to the unusable-frame arm. Saturation adds no\n+// rejection branch, so the derived parse-arm census is unchanged.\n+func parseMajor(version string) (int, bool) {\n+\tparts := strings.Split(version, \".\")\n+\tif len(parts) != 3 {\n+\t\treturn 0, false\n+\t}\n+\tmajor := 0\n+\tfor i := 0; i < len(parts[0]); i++ {\n+\t\tdigit := parts[0][i]\n+\t\tif digit < '0' || digit > '9' {\n+\t\t\treturn 0, false\n+\t\t}\n+\t\tstep := int(digit - '0')\n+\t\tif major > (math.MaxInt-step)/10 {\n+\t\t\treturn math.MaxInt, true\n+\t\t}\n+\t\tmajor = major*10 + step\n+\t}\n"}}}
