r its provider.\n32|func TestSpecIdentityExampleDecodes(t *testing.T) {\n33|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n34|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n35|\t}\n36|}\n37|\n38|// identityVariant rewrites one unique substring of the example.\n39|func identityVariant(t *testing.T, old, new string) []byte {\n40|\tt.Helper()\n41|\tif strings.Count(specIdentityExample, old) != 1 {\n42|\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\n43|\t}\n44|\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\n45|}\n46|\n47|// TestCheckIdentityRefusals drives every identity rule, including\n48|// the five normative Section 5.5 negatives: unknown identity_kind,\n49|// absent opaque_identity, an object opaque value, an absolute source\n50|// path in that map, and an Antigravity backend_conversation_uuid\n51|// with a null realm fingerprint.\n52|func TestCheckIdentityRefusals(t *testing.T) {\n53|\tlong128 := strings.Repeat(\"v\", 128)\n54|\tlong129 := strings.Repeat(\"v\", 129)\n55|\tlong1024 := strings.Repeat(\"v\", 1024)\n56|\tlong1025 := strings.Repeat(\"v\", 1025)\n57|\tlong256 := strings.Repeat(\"r\", 256)\n58|\tlong257 := strings.Repeat(\"r\", 257)\n59|\tlong512 := strings.Repeat(\"s\", 512)\n60|\tlong513 := strings.Repeat(\"s\", 513)\n61|\tkey64 := \"k\" + strings.Repeat(\"e\", 63)\n62|\tkey65 := \"k\" + strings.Repeat(\"e\", 64)\n63|\trows := []struct {\n64|\t\tname   string\n65|\t\tbody   []byte\n66|\t\tmember string\n67|\t\tdetail string\n68|\t}{\n69|\t\t{\"unknown member\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"score\": 1`), \"score\", \"unknown member\"},\n70|\t\t{\"absent opaque_identity\", []byte(strings.Replace(specIdentityExample, \"  \\\"opaque_identity\\\": {},\\n\", \"\", 1)), \"opaque_identity\", \"misses a required member\"},\n71|\t\t{\"wrong schema\", identityVariant(t, `\"urn:ax:schema:provider-identity\"`, `\"urn:ax:schema:provider-manifest\"`), \"schema\", \"not the provider identity\"},\n72|\t\t{\"wrong schema version\", identityVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"1.1.0\"`), \"schema_version\", \"not 1.0.0\"},\n73|\t\t{\"bad record digest\", identityVariant(t, `\"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"`, `\"record_id\": \"sha256:zzzz\"`), \"record_id\", \"not a digest\"},\n74|\t\t{\"bad subject uuid\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"not-a-uuid\"`), \"subject_id\", \"not a UUIDv7\"},\n75|\t\t{\"bad session uuid\", identityVariant(t, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ax\"`), \"session_id\", \"not a UUIDv7\"},\n76|\t\t{\"subject differs\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`), \"subject_id\", \"does not equal session_id\"},\n77|\t\t{\"bad provider grammar\", identityVariant(t, `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"Antigravity\"`), \"provider_id\", \"not a provider id\"},\n78|\t\t{\"empty provider version\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n79|\t\t{\"provider version 129\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long129+`\"`), \"provider_version\", \"not 1..128 characters\"},\n80|\t\t{\"empty version range\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"\"`), \"provider_version_range\", \"not 1..256 characters\"},\n81|\t\t{\"version range 257\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"`+long257+`\"`), \"provider_version_range\", \"not 1..256 characters\"},\n82|\t\t{\"empty native session\", identityVariant(