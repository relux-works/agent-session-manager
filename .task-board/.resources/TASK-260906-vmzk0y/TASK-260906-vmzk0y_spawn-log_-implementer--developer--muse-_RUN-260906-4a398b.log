ocolVersions) {\n315|\t\treturn false\n316|\t}\n317|\tfor i := range left.ProtocolVersions {\n318|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n319|\t\t\treturn false\n320|\t\t}\n321|\t}\n322|\tif len(left.Platforms) != len(right.Platforms) {\n323|\t\treturn false\n324|\t}\n325|\tfor i := range left.Platforms {\n326|\t\tif left.Platforms[i] != right.Platforms[i] {\n327|\t\t\treturn false\n328|\t\t}\n329|\t}\n330|\treturn true\n331|}\n332|\n333|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n334|// backend ID, an absolute executable path, an executable digest, and enabled.\n335|type TrustEntry struct {\n336|\tBackendID        string\n337|\tExecutablePath   string\n338|\tExecutableDigest string\n339|\tEnabled          bool\n340|}\n341|\n342|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n343|// reserved-namespace bar (third parties use a vendor-owned namespace),\n344|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n345|// A disabled entry is not an error here; registration treats it as untrusted.\n346|func (entry TrustEntry) validate(platform scalar.Platform) error {\n347|\tif err := mustParseID(entry.BackendID); err != nil {\n348|\t\treturn err\n349|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ad","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":305,"recorded_at":1780531400000605,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"call_id":"call_01a078cc9d5e79d0a0038371c6620468","text":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"grep -rn \\\"parseMajor\\\\|major.*\\\\*10\\\\|value.*\\\\*10\\\" internal/provhost/*.go internal/terminalbackend/*.go internal/canonicaljson/*.go internal/scalar/*.go 2>/dev/null | grep -v _test | head -n 30\",\n  \"description\": \"Find digit accumulation sites\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/provhost/protocol.go:358:// parseMajor extracts the major from a strict numeric X.Y.Z version.\\ninternal/provhost/protocol.go:361:func parseMajor(version string) (int, bool) {\\ninternal/provhost/protocol.go:372:\\t\\tmajor = major*10 + int(digit-'0')\\ninternal/provhost/protocol.go:436:\\t\\t\\t\\t\\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\\ninternal/provhost/protocol.go:483:\\t\\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\\ninternal/provhost/protocol.go:545:\\tobservedMajor, _ := parseMajor(version)\\ninternal/terminalbackend/descriptor.go:225:\\t\\tvalue = value*10 + int(digit-'0')\\ninternal/terminalbackend/terminalbackend.go:251:\\t\\tmajor = major*10 + int(version[i]-'0')\\n\",\n  \"original_output_bytes\": 740,\n  \"original_output_tokens\": 185,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
