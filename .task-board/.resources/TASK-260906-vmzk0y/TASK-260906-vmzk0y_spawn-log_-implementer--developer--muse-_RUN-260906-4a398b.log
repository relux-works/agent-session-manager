|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n334|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n335|\t\t\t\tcount++\n336|\t\t\t}\n337|\t\t}\n338|\t\tfor _, child := range childNodes(node) {\n339|\t\t\twalk(child)\n340|\t\t}\n341|\t\tconditions = conditions[:len(conditions)-1]\n342|\t}\n343|\twalk(body)\n344|\treturn count\n345|}\n346|\n347|func isFalsePair(ret *ast.ReturnStmt) bool {\n348|\tif len(ret.Results) != 2 {\n349|\t\treturn false\n350|\t}\n351|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n352|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n353|\t\treturn false\n354|\t}\n355|\tno, ok := ret.Results[1].(*ast.Ident)\n356|\treturn ok && no.Name == \"false\"\n357|}\n358|\n359|func childNodes(node ast.Node) []ast.Node {\n360|\tvar children []ast.Node\n361|\tast.Inspect(node, func(child ast.Node) bool {\n362|\t\tif child == nil || child == node {\n363|\t\t\treturn true\n364|\t\t}\n365|\t\tchildren = append(children, child)\n366|\t\treturn false\n367|\t})\n368|\treturn children\n369|}\n370|\n371|// armWitness proves one derived refusal arm at the production entry.\n372|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n373|// fails a witness that names nothing production declares, so a deleted or\n374|// narrowed production branch orphans its witness instead of passing\n375|// silently. The prove function must drive the production entry point and\n376|// require the refusal attributed to THIS arm, not merely any refusal.\n377|type armWitness struct {\n378|\tarm   string\n379|\tname  string\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
