{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d7","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":710,"recorded_at":1780531400001415,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"2b61d31d-7801-4553-a3d3-20cd3f91c85a"},"task_id":"2b61d31d-7801-4553-a3d3-20cd3f91c85a","event":{"kind":"output","task_id":"2b61d31d-7801-4553-a3d3-20cd3f91c85a","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(749 line(s) above)\n750|\t\t\trequireIntegrityRefusal(t, err, \"terminal status misses plan or discovery or keeps a token\", \"committed\")\n751|\t\t}},\n752|\t}\n753|}\n754|\n755|// declaredParseWitnesses proves each parseMajor rejection branch at the\n756|// production entry. Every value below carries a numeric rest (or no rest\n757|// at all), so only the named branch can refuse it; the prove function\n758|// additionally requires parseMajor itself to reject the version, which\n759|// attributes the DecodeResponse refusal to the classification branch\n760|// rather than to any frame gate. Exit 13 distinguishes the unusable-frame\n761|// path from the exit-6 mismatch path a deleted branch promotes to.\n762|func declaredParseWitnesses() []armWitness {\n763|\tproveUnrecognized := func(version string) func(*testing.T) {\n764|\t\treturn func(t *testing.T) {\n765|\t\t\tt.Helper()\n766|\t\t\tif major, recognized := parseMajor(version); recognized {\n767|\t\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n768|\t\t\t}\n769|\t\t\t_, err := DecodeResponse(armVersionFrame(version), mustUUIDv7(t, testRequestID))\n770|\t\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n771|\t\t\tif failureExit(t, err) != 13 {\n772|\t\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n773|\t\t\t}\n774|\t\t}\n775|\t}\n776|\treturn []armWitness{\n777|\t\t{arm: `parse|len(parts) != 3`, name: \"two-part version\", prove: proveUnrecognized(\"3.0\")},\n778|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"non-numeric major\", prove: proveUnrecognized(\"a.0.0\")},\n779|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"alphanumeric major\", prove: proveUnrecognized(\"2a.0.0\")},\n780|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"negative major\", prove: proveUnrecognized(\"-1.0.0\")},\n781|\t\t{arm: `parse|digit < '0' || digit > '9'`, name: \"plus major\", prove: proveUnrecognized(\"+3.0.0\")},\n782|\t\t{arm: `parse|len(parts[0]) == 0`, name: \"empty major\", prove: proveUnrecognized(\".0.0\")},\n783|\t\t{arm: `parse|len(rest) == 0`, name: \"empty minor\", prove: proveUnrecognized(\"3..0\")},\n784|\t\t{arm: `parse|rest[i] < '0' || rest[i] > '9'`, name: \"non-numeric rest\", prove: proveUnrecognized(\"3.b.c\")},\n785|\t}\n786|}\n787|\n788|// TestDerivedRefusalArmsAreAllWitnessed is the forward direction: every\n789|// arm derived from production must carry a witness. A planted arm (a new\n790|// frameFault literal or integrity detail through an existing constructor\n791|// site) lands here as an unwitnessed arm.\n792|func TestDerivedRefusalArmsAreAllWitnessed(t *testing.T) {\n793|\tderived := deriveRefusalArms(t)\n794|\twitnessed := map[string]int{}\n795|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n796|\t\twitnessed[witness.arm]++\n797|\t}\n798|\tvar missing []string\n799|\tfor arm := range derived {\n800|\t\tif witnessed[arm] == 0 {\n801|\t\t\tmissing = append(missing, arm)\n802|\t\t}\n803|\t}\n804|\tsort.Strings(missing)\n805|\tif len(missing) > 0 {\n806|\t\tt.Fatalf(\"derived refusal arm(s) with no witness at the production entry:\\n  %s\", strings.Join(missing, \"\\n  \"))\n807|\t}\n808|\tt.Logf(\"refusal arm coverage: %d/%d derived arms witnessed\", len(derived)-len(missing), len(derived))\n809|}\n810|\n811|// TestWitnessedArmsAreAllDerived is the reverse direction: every witness\n812|// must name an arm production declares. A deleted or narrowed production\n813|// branch orphans its witness and fails here, which is also what makes a\n814|// truncated derivation fail instead of passing vacuously.\n815|func TestWitnessedArmsAreAllDerived(t *testing.T) {\n816|\tderived := deriveRefusalArms(t)\n817|\tvar orphans []string\n818|\tfor _, witness := range append(append(append(declaredArmWitnesses(), declaredIntegrityWitnesses()...), declaredParseWitnesses()...), append(declaredOperationWitnesses(), append(declaredOperationWitnessesQuiesce(), declaredOperationWitnessesIdentity()...)...)...) {\n819|\t\tif _, ok := derived[witness.arm]; !ok {\n820|\t\t\torphans = append(orphans, witness.arm+\" (\"+witness.name+\")\")\n821|\t\t}\n822|\t}\n823|\tsort.Strings(orphans)\n824|\tif len(orphans) > 0 {\n825|\t\tt.Fatalf(\"witness(es) naming no derived production arm:\\n  %s\", strings.Join(orphans, \"\\n  \"))\n826|\t}\n827|}\n828|\n829|// TestEveryArmWitnessRefusesAtTheProductionEntry drives every witness\n(more lines below)"}}}
