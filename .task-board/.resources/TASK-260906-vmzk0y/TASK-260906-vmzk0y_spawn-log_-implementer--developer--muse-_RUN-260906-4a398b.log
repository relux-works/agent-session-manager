{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a1","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":299,"recorded_at":1780531400000593,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"efb60c10-02b1-41ca-83e6-0971c834eb42"},"task_id":"efb60c10-02b1-41ca-83e6-0971c834eb42","event":{"kind":"output","task_id":"efb60c10-02b1-41ca-83e6-0971c834eb42","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(229 line(s) above)\n230|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n231|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"}\n232|\t}\n233|\tfor index, version := range versions {\n234|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n235|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"}\n236|\t\t}\n237|\t\tif index > 0 && versions[index-1] >= version {\n238|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"}\n239|\t\t}\n240|\t}\n241|\treturn nil\n242|}\n243|\n244|// semverMajor returns the major number of a validated semver string.\n245|func semverMajor(version string) int {\n246|\tmajor := 0\n247|\tfor i := 0; i < len(version); i++ {\n248|\t\tif version[i] == '.' {\n249|\t\t\tbreak\n250|\t\t}\n251|\t\tmajor = major*10 + int(version[i]-'0')\n252|\t}\n253|\treturn major\n254|}\n255|\n256|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n257|// macos|linux|wsl2|windows vocabulary.\n258|func validatePlatforms(platforms []scalar.Platform) error {\n259|\tif len(platforms) == 0 || len(platforms) > 4 {\n260|\t\treturn errors.New(\"platforms bound\")\n261|\t}\n262|\tprevious := \"\"\n263|\tfor _, platform := range platforms {\n264|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n265|\t\t\treturn errors.New(\"platforms vocabulary\")\n266|\t\t}\n267|\t\tif previous >= platform.String() {\n268|\t\t\treturn errors.New(\"platforms sorted unique\")\n269|\t\t}\n270|\t\tprevious = platform.String()\n271|\t}\n272|\treturn nil\n273|}\n274|\n275|// cloneStrings deep-copies a version list so the registry never shares a\n276|// backing array with its caller. Registration carries slices; a struct copy\n277|// duplicates only the header, so every ingress and egress point must clone.\n278|func cloneStrings(values []string) []string {\n279|\tif values == nil {\n280|\t\treturn nil\n281|\t}\n282|\tcloned := make([]string, len(values))\n283|\tcopy(cloned, values)\n284|\treturn cloned\n285|}\n286|\n287|// clonePlatforms deep-copies a platform set for the same reason as\n288|// cloneStrings: without it a caller holding a resolved record keeps a live\n289|// handle on admitted registry state and can convert drift into a duplicate.\n290|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n291|\tif values == nil {\n292|\t\treturn nil\n293|\t}\n294|\tcloned := make([]scalar.Platform, len(values))\n295|\tcopy(cloned, values)\n296|\treturn cloned\n297|}\n298|\n299|// cloneRecord deep-copies every slice member of a record.\n300|func cloneRecord(record Registration) Registration {\n301|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n302|\trecord.Platforms = clonePlatforms(record.Platforms)\n303|\treturn record\n304|}\n305|\n306|// equalRecord reports whether two validated records are member-for-member\n307|// identical. Any difference is drift, never a compatible update.\n308|func equalRecord(left, right Registration) bool {\n309|\tif left.ID != right.ID || left.Kind != right.Kind ||\n310|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n311|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n312|\t\treturn false\n313|\t}\n314|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n315|\t\treturn false\n316|\t}\n317|\tfor i := range left.ProtocolVersions {\n318|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n319|\t\t\treturn false\n320|\t\t}\n321|\t}\n322|\tif len(left.Platforms) != len(right.Platforms) {\n323|\t\treturn false\n324|\t}\n325|\tfor i := range left.Platforms {\n326|\t\tif left.Platforms[i] != right.Platforms[i] {\n327|\t\t\treturn false\n328|\t\t}\n329|\t}\n330|\treturn true\n331|}\n332|\n333|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n334|// backend ID, an absolute executable path, an executable digest, and enabled.\n335|type TrustEntry struct {\n336|\tBackendID        string\n337|\tExecutablePath   string\n338|\tExecutableDigest string\n339|\tEnabled          bool\n340|}\n341|\n342|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n343|// reserved-namespace bar (third parties use a vendor-owned namespace),\n344|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n345|// A disabled entry is not an error here; registration treats it as untrusted.\n346|func (entry TrustEntry) validate(platform scalar.Platform) error {\n347|\tif err := mustParseID(entry.BackendID); err != nil {\n348|\t\treturn err\n349|\t}\n(more lines below)"}}}
