{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48f","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":162,"recorded_at":1780531400000319,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"542c6d56-777e-4c13-ad47-8b5e21028def"},"task_id":"542c6d56-777e-4c13-ad47-8b5e21028def","event":{"kind":"output","task_id":"542c6d56-777e-4c13-ad47-8b5e21028def","chunk":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped. Failure details carry the failure class and member names\n38|\t// only, never stderr content.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil, time.Time{}, failure\n199|\t}\n200|\tdeadline, err := req.Deadline.Time()\n201|\tif err != nil {\n202|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n203|\t\tif fault != nil {\n204|\t\t\treturn nil, time.Time{}, fault\n205|\t\t}\n206|\t\treturn nil, time.Time{}, failure\n207|\t}\n208|\tif !deadline.After(now) {\n209|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n210|\t\tif fault != nil {\n211|\t\t\treturn nil, time.Time{}, fault\n212|\t\t}\n213|\t\treturn nil, time.Time{}, failure\n214|\t}\n215|\tif !isJSONObject(req.Body) {\n216|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n217|\t\tif fault != nil {\n218|\t\t\treturn nil, time.Time{}, fault\n219|\t\t}\n220|\t\treturn nil, time.Time{}, failure\n221|\t}\n222|\t// The operation, request ID, deadline, and body above were each\n223|\t// validated before this marshal, so it cannot fail on a reachable\n224|\t// path: the error propagates as a plain Go error rather than\n225|\t// through a refusal site no negative test could exercise.\n226|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n227|\tif err != nil {\n228|\t\treturn nil, time.Time{}, err\n229|\t}\n230|\tif len(frame) > MaxFrameBytes {\n231|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n232|\t\tif fault != nil {\n233|\t\t\treturn nil, time.Time{}, fault\n234|\t\t}\n235|\t\treturn nil, time.Time{}, failure\n236|\t}\n237|\treturn frame, deadline, nil\n238|}\n239|\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n262|// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n263|// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n264|// raw bytes are screened before any member is trusted. The\n265|// lone-surrogate gate runs next: encoding/json would likewise replace\n266|// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n267|// reject lone surrogate code points).\n268|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n269|\tif !utf8.Valid(data) {\n270|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n271|\t}\n272|\tif hasLoneSurrogateEscape(data) {\n273|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n274|\t}\n275|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n276|\ttoken, err := decoder.Token()\n277|\tif err != nil {\n278|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n279|\t}\n280|\tdelim, ok := token.(json.Delim)\n281|\tif !ok || delim != '{' {\n282|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n283|\t}\n284|\tmembers := map[string]json.RawMessage{}\n285|\tfor decoder.More() {\n286|\t\tkeyToken, err := decoder.Token()\n287|\t\tif err != nil {\n288|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n289|\t\t}\n290|\t\tkey, ok := keyToken.(string)\n291|\t\tif !ok {\n292|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n293|\t\t}\n294|\t\tif _, duplicate := members[key]; duplicate {\n295|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n296|\t\t}\n297|\t\tvar raw json.RawMessage\n298|\t\tif err := decoder.Decode(&raw); err != nil {\n299|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n300|\t\t}\n301|\t\tmembers[key] = raw\n302|\t}\n303|\tif token, err := decoder.Token(); err != nil {\n304|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n305|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n306|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n307|\t}\n308|\tif _, err := decoder.Token(); err != io.EOF {\n309|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n310|\t}\n311|\treturn members, nil\n312|}\n313|\n314|// responseMembers is the exact Section 7.2 response member set: the four\n315|// framing members plus body on success or error on failure, never both,\n316|// never neither, and nothing else. It is package-level so the closed\n317|// vocabulary census derives it: widening the accepted set here must redden\n318|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n319|var responseMembers = map[string]bool{\n320|\t\"protocol\":         true,\n321|\t\"protocol_version\": true,\n322|\t\"request_id\":       true,\n323|\t\"ok\":               true,\n324|\t\"body\":             true,\n325|\t\"error\":            true,\n326|}\n327|\n328|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n329|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n330|\tfor _, name := range required {\n331|\t\tif _, present := members[name]; !present {\n332|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n333|\t\t}\n334|\t}\n335|\tif ok {\n336|\t\tif _, present := members[\"body\"]; !present {\n337|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n338|\t\t}\n339|\t\tif _, forbidden := members[\"error\"]; forbidden {\n340|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n341|\t\t}\n342|\t} else {\n343|\t\tif _, present := members[\"error\"]; !present {\n344|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n345|\t\t}\n346|\t\tif _, forbidden := members[\"body\"]; forbidden {\n347|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n348|\t\t}\n349|\t}\n350|\tfor name := range members {\n351|\t\tif !responseMembers[name] {\n352|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n353|\t\t}\n354|\t}\n355|\treturn nil\n356|}\n357|\n358|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n359|// Anything else is not a recognizable major, so the frame is unusable\n360|// rather than a mismatch.\n361|func parseMajor(version string) (int, bool) {\n362|\tparts := strings.Split(version, \".\")\n363|\tif len(parts) != 3 {\n364|\t\treturn 0, false\n365|\t}\n366|\tmajor := 0\n367|\tfor i := 0; i < len(parts[0]); i++ {\n368|\t\tdigit := parts[0][i]\n369|\t\tif digit < '0' || digit > '9' {\n370|\t\t\treturn 0, false\n371|\t\t}\n372|\t\tmajor = major*10 + int(digit-'0')\n373|\t}\n374|\tif len(parts[0]) == 0 {\n375|\t\treturn 0, false\n376|\t}\n377|\tfor _, rest := range parts[1:] {\n378|\t\tif len(rest) == 0 {\n379|\t\t\treturn 0, false\n380|\t\t}\n381|\t\tfor i := 0; i < len(rest); i++ {\n382|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n383|\t\t\t\treturn 0, false\n384|\t\t\t}\n385|\t\t}\n386|\t}\n387|\treturn major, true\n388|}\n389|\n390|// DecodeResponse validates one stdout line as the single response frame\n391|// for the request carrying wantRequestID. It returns the success body, or\n392|// the bound child failure, or a local failure that trusts nothing from\n393|// the frame. A recognizable foreign major yields incompatible_protocol;\n394|// every other unusable frame yields provider_protocol_error.\n395|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n396|\tif len(frame) > MaxFrameBytes {\n397|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n398|\t\tif err != nil {\n399|\t\t\treturn Response{}, err\n400|\t\t}\n401|\t\treturn Response{}, failure\n402|\t}\n403|\tif !utf8.Valid(frame) {\n404|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n405|\t\tif err != nil {\n406|\t\t\treturn Response{}, err\n407|\t\t}\n408|\t\treturn Response{}, failure\n409|\t}\n410|\tmembers, fault := decodeStrictObject(frame)\n411|\tif fault != nil {\n412|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n413|\t\tif err != nil {\n414|\t\t\treturn Response{}, err\n415|\t\t}\n416|\t\treturn Response{}, failure\n417|\t}\n418|\t// foreignMajor peeks at the envelope identity before any v2\n419|\t// member rule runs. A recognizable foreign major is\n420|\t// incompatible_protocol no matter what members it carries, so\n421|\t// the v2 member vocabulary below must not judge it first: a\n422|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n423|\t// is a foreign major, not an unknown or missing member. The\n424|\t// peek trusts nothing and refuses nothing: it only arms when\n425|\t// the protocol member is exactly this protocol and the version\n426|\t// member is a string with a recognizable foreign major. A frame\n427|\t// without our protocol identity, or without a readable version,\n428|\t// falls through to the member rules, which keep their verdicts.\n429|\tforeignMajor := \"\"\n430|\tif rawProtocol, present := members[\"protocol\"]; present {\n431|\t\tvar protocol string\n432|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n433|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n434|\t\t\t\tvar version string\n435|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n436|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n437|\t\t\t\t\t\tforeignMajor = version\n438|\t\t\t\t\t}\n439|\t\t\t\t}\n440|\t\t\t}\n441|\t\t}\n442|\t}\n443|\tvar ok bool\n444|\tif foreignMajor == \"\" {\n445|\t\tif raw, present := members[\"ok\"]; !present {\n446|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n447|\t\t\tif err != nil {\n448|\t\t\t\treturn Response{}, err\n449|\t\t\t}\n450|\t\t\treturn Response{}, failure\n451|\t\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n452|\t\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n453|\t\t\tif fault != nil {\n454|\t\t\t\treturn Response{}, fault\n455|\t\t\t}\n456|\t\t\treturn Response{}, failure\n457|\t\t}\n458|\t\tif fault := checkResponseMembers(members, ok); fault != nil {\n459|\t\t\tfailure, err := failProtocol(fault.detail, fault.member)\n460|\t\t\tif err != nil {\n461|\t\t\t\treturn Response{}, err\n462|\t\t\t}\n463|\t\t\treturn Response{}, failure\n464|\t\t}\n465|\t}\n466|\tvar protocol string\n467|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n468|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n469|\t\tif fault != nil {\n470|\t\t\treturn Response{}, fault\n471|\t\t}\n472|\t\treturn Response{}, failure\n473|\t}\n474|\tvar version string\n475|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n476|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n477|\t\tif fault != nil {\n478|\t\t\treturn Response{}, fault\n479|\t\t}\n480|\t\treturn Response{}, failure\n481|\t}\n482|\tif version != ProtocolVersion {\n483|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n484|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n485|\t\t\tif err != nil {\n486|\t\t\t\treturn Response{}, err\n487|\t\t\t}\n488|\t\t\treturn Response{}, failure\n489|\t\t}\n490|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n491|\t\tif fault != nil {\n492|\t\t\treturn Response{}, fault\n493|\t\t}\n494|\t\treturn Response{}, failure\n495|\t}\n496|\tvar requestID string\n497|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n498|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n499|\t\tif fault != nil {\n500|\t\t\treturn Response{}, fault\n(more lines below)"}}}
