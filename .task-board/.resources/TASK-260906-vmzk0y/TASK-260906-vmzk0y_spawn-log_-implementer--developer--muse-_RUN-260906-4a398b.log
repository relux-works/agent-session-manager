{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48b","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":160,"recorded_at":1780531400000315,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"9bfa011b-b375-4ab2-bbb9-25d6a1884ff6"},"task_id":"9bfa011b-b375-4ab2-bbb9-25d6a1884ff6","event":{"kind":"output","task_id":"9bfa011b-b375-4ab2-bbb9-25d6a1884ff6","chunk":"Read text file `internal/provider/lift_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n15|)\n16|\n17|// liftVector is one production-derived discovery failure and the secrets\n18|// its local rendering carries: the machine-local paths, provider IDs,\n19|// and owner identities the wire message must not reproduce.\n20|type liftVector struct {\n21|\tname string\n22|\t// make drives the real production entry (Discover or Verify) to a\n23|\t// refusal.\n24|\tmake func(t *testing.T) error\n25|\t// secrets are concrete local strings the failure's Error() carries.\n26|\tsecrets []string\n27|\t// code is the stable provider code the failure carries.\n28|\tcode string\n29|\t// message is the exact static wire message Lift builds for it.\n30|\tmessage string\n31|\t// exit is the Section 15.2 status of the lifted code.\n32|\texit int\n33|}\n34|\n35|func liftVectors() []liftVector {\n36|\treturn []liftVector{\n37|\t\t{\n38|\t\t\tname: \"duplicate invalid_config\",\n39|\t\t\tmake: func(t *testing.T) error {\n40|\t\t\t\tt.Helper()\n41|\t\t\t\tfake := newFakeSystem()\n42|\t\t\t\tfake.addFile(\"/plugins/a\", \"ax-provider-dup\", []byte(\"one\"), fakeUID)\n43|\t\t\t\tfake.addFile(\"/plugins/b\", \"ax-provider-dup\", []byte(\"two\"), fakeUID)\n44|\t\t\t\t_, err := Discover(fakeConfig(\"/plugins/a\", \"/plugins/b\"), fakeOwner(), fake)\n45|\t\t\t\tif err == nil {\n46|\t\t\t\t\tt.Fatal(\"Discover admitted a duplicate provider ID\")\n47|\t\t\t\t}\n48|\t\t\t\treturn err\n49|\t\t\t},\n50|\t\t\tsecrets: []string{\"dup\"},\n51|\t\t\tcode:    codeInvalidConfig,\n52|\t\t\tmessage: \"provider discovery refused the request: invalid configuration\",\n53|\t\t\texit:    3,\n54|\t\t},\n55|\t\t{\n56|\t\t\tname: \"unreadable directory local_precondition_failed\",\n57|\t\t\tmake: func(t *testing.T) error {\n58|\t\t\t\tt.Helper()\n59|\t\t\t\tfake := newFakeSystem()\n60|\t\t\t\tfake.entries[\"/plugins\"] = []string{}\n61|\t\t\t\tfake.readDirErr[\"/plugins\"] = errors.New(\"permission denied at /plugins\")\n62|\t\t\t\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n63|\t\t\t\tif err == nil {\n64|\t\t\t\t\tt.Fatal(\"Discover admitted an unreadable plugin directory\")\n65|\t\t\t\t}\n66|\t\t\t\treturn err\n67|\t\t\t},\n68|\t\t\tsecrets: []string{\"/plugins\", \"permission denied at /plugins\"},\n69|\t\t\tcode:    codeLocalPrecondition,\n70|\t\t\tmessage: \"provider discovery could not establish its filesystem preconditions\",\n71|\t\t\texit:    3,\n72|\t\t},\n73|\t\t{\n74|\t\t\tname: \"retargeted executable integrity_failure\",\n75|\t\t\tmake: func(t *testing.T) error {\n76|\t\t\t\tt.Helper()\n77|\t\t\t\tfake := newFakeSystem()\n78|\t\t\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n79|\t\t\t\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n80|\t\t\t\tfake.canon[\"/plugins/ax-provider-foo\"] = \"/opt/real/evil\"\n81|\t\t\t\tfake.files[\"/opt/real/evil\"] = fakeFile{content: []byte(\"bytes\"), uid: fakeUID, regular: true}\n82|\t\t\t\terr := Verify(record, fakeOwner(), fake)\n83|\t\t\t\tif err == nil {\n84|\t\t\t\t\tt.Fatal(\"Verify accepted a retargeted symlink\")\n85|\t\t\t\t}\n86|\t\t\t\treturn err\n87|\t\t\t},\n88|\t\t\tsecrets: []string{\"foo\", \"/opt/real/foo\", \"/opt/real/evil\"},\n89|\t\t\tcode:    codeIntegrityFailure,\n90|\t\t\tmessage: \"provider trust receipt no longer matches the filesystem\",\n91|\t\t\texit:    9,\n92|\t\t},\n93|\t\t{\n94|\t\t\tname: \"changed owner integrity_failure\",\n95|\t\t\tmake: func(t *testing.T) error {\n96|\t\t\t\tt.Helper()\n97|\t\t\t\tfake := newFakeSystem()\n98|\t\t\t\tfake.addLinkedFile(\"/plugins\", \"ax-provider-foo\", \"/opt/real/foo\", []byte(\"bytes\"), fakeUID, true)\n99|\t\t\t\trecord := trustOneFoo(t, discoverOneFoo(t, fake))\n100|\t\t\t\tfake.files[\"/opt/real/foo\"] = fakeFile{content: []byte(\"bytes\"), uid: foreignUID, regular: true}\n101|\t\t\t\terr := Verify(record, fakeOwner(), fake)\n102|\t\t\t\tif err == nil {\n103|\t\t\t\t\tt.Fatal(\"Verify accepted a changed owner\")\n104|\t\t\t\t}\n105|\t\t\t\treturn err\n106|\t\t\t},\n107|\t\t\tsecrets: []string{\"foo\", \"uid:2000\"},\n108|\t\t\tcode:    codeIntegrityFailure,\n109|\t\t\tmessage: \"provider trust receipt no longer matches the filesystem\",\n110|\t\t\texit:    9,\n111|\t\t},\n112|\t}\n113|}\n114|\n115|// TestLiftCarriesDiscoveryFailuresToTheWire drives the real lift: every\n116|// production-derived failure above lifts through Lift into a Structured\n117|// Error axerror accepts, carrying the stable code and exit with the\n118|// exact static message, and no machine-local path, provider ID, or\n119|// owner identity reaches the wire message. The secrets are asserted\n120|// present in the local rendering first, so the absence below is a\n121|// measured removal rather than a vacuous non-mention.\n122|func TestLiftCarriesDiscoveryFailuresToTheWire(t *testing.T) {\n123|\tt.Parallel()\n124|\n125|\tfor _, vector := range liftVectors() {\n126|\t\tt.Run(vector.name, func(t *testing.T) {\n127|\t\t\tt.Parallel()\n128|\t\t\tfailure := vector.make(t)\n129|\t\t\tvar local Error\n130|\t\t\tif !errors.As(failure, &local) {\n131|\t\t\t\tt.Fatalf(\"failure %v is not a provider Error\", failure)\n132|\t\t\t}\n133|\t\t\tfor _, secret := range vector.secrets {\n134|\t\t\t\tif !strings.Contains(local.Error(), secret) {\n135|\t\t\t\t\tt.Fatalf(\"local rendering %q does not carry %q; the wire absence below would prove nothing\", local.Error(), secret)\n136|\t\t\t\t}\n137|\t\t\t}\n138|\t\t\tlifted, err := Lift(local)\n139|\t\t\tif err != nil {\n140|\t\t\t\tt.Fatalf(\"Lift: %v\", err)\n141|\t\t\t}\n142|\t\t\tif lifted.Version() != axerror.Version100 {\n143|\t\t\t\tt.Fatalf(\"lifted version = %q, want Structured Error 1.0.0\", lifted.Version())\n144|\t\t\t}\n145|\t\t\tif string(lifted.Code()) != vector.code {\n146|\t\t\t\tt.Fatalf(\"lifted code = %q, want %q\", lifted.Code(), vector.code)\n147|\t\t\t}\n148|\t\t\tif lifted.Message() != vector.message {\n149|\t\t\t\tt.Fatalf(\"lifted message = %q, want %q\", lifted.Message(), vector.message)\n150|\t\t\t}\n151|\t\t\tif lifted.ExitCode() != vector.exit {\n152|\t\t\t\tt.Fatalf(\"lifted exit = %d, want %d\", lifted.ExitCode(), vector.exit)\n153|\t\t\t}\n154|\t\t\tif lifted.Retryable() {\n155|\t\t\t\tt.Fatalf(\"lifted failure claims retryable: %v\", lifted)\n156|\t\t\t}\n157|\t\t\tif len(lifted.DetailKeys()) != 0 {\n158|\t\t\t\tt.Fatalf(\"lifted details = %v, want no diagnostic values\", lifted.DetailKeys())\n159|\t\t\t}\n160|\t\t\twire, err := json.Marshal(lifted)\n161|\t\t\tif err != nil {\n162|\t\t\t\tt.Fatalf(\"marshal lifted failure: %v\", err)\n163|\t\t\t}\n164|\t\t\tfor _, secret := range vector.secrets {\n165|\t\t\t\tif strings.Contains(string(wire), secret) {\n166|\t\t\t\t\tt.Fatalf(\"wire message %s reproduces local secret %q\", wire, secret)\n167|\t\t\t\t}\n168|\t\t\t}\n169|\t\t\t// The cause stays local and usable: the lifted failure\n170|\t\t\t// unwraps to the provider refusal it was built from.\n171|\t\t\tvar back Error\n172|\t\t\tif !errors.As(lifted, &back) {\n173|\t\t\t\tt.Fatalf(\"lifted failure does not unwrap to a provider Error\")\n174|\t\t\t}\n175|\t\t\tif back.Code() != vector.code {\n176|\t\t\t\tt.Fatalf(\"unwrapped code = %q, want %q\", back.Code(), vector.code)\n177|\t\t\t}\n178|\t\t})\n179|\t}\n180|}\n181|\n182|// TestLiftRefusesUnregisteredCode fails closed: an Error carrying a code\n183|// outside the closed set lifts to no wire object, and the refusal is the\n184|// registry's unregistered-code refusal rather than a minted default.\n185|func TestLiftRefusesUnregisteredCode(t *testing.T) {\n186|\tt.Parallel()\n187|\n188|\tlifted, err := Lift(Error{code: \"bogus_code\", detail: \"planted control\"})\n189|\tif err == nil {\n190|\t\tt.Fatalf(\"Lift admitted an unregistered code: %v\", lifted)\n191|\t}\n192|\tif lifted != nil {\n193|\t\tt.Fatalf(\"Lift returned a wire object alongside its refusal: %v\", lifted)\n194|\t}\n195|\tif !errors.Is(err, axerror.ErrUnregisteredCode) {\n196|\t\tt.Fatalf(\"Lift refusal = %v, want the unregistered-code refusal\", err)\n197|\t}\n198|}\n199|\n200|// TestNaiveLiftShapeIsRefusedByTheWireGate proves the seam Lift exists\n201|// to close: a message built from Error() with the cause attached — the\n202|// ordinary fmt.Errorf(\"...: %v\", err) lift — is refused by the\n203|// production axerror gate with the causal-leak refusal, in both the\n204|// message and the details direction.\n205|func TestNaiveLiftShapeIsRefusedByTheWireGate(t *testing.T) {\n206|\tt.Parallel()\n207|\n208|\tfake := newFakeSystem()\n209|\tfake.entries[\"/plugins\"] = []string{}\n210|\tcause := errors.New(\"local disk permission denied for the lift control\")\n211|\tfake.readDirErr[\"/plugins\"] = cause\n212|\t_, err := Discover(fakeConfig(\"/plugins\"), fakeOwner(), fake)\n213|\tif err == nil {\n214|\t\tt.Fatal(\"Discover admitted an unreadable plugin directory\")\n215|\t}\n216|\tvar local Error\n217|\tif !errors.As(err, &local) {\n218|\t\tt.Fatalf(\"failure %v is not a provider Error\", err)\n219|\t}\n220|\tif !strings.Contains(local.Error(), cause.Error()) {\n221|\t\tt.Fatalf(\"local rendering %q does not reproduce its cause; the control is misbuilt\", local.Error())\n222|\t}\n223|\tif _, err := axerror.New(axerror.Spec{\n224|\t\tVersion: axerror.Version100,\n225|\t\tCode:    axerror.Code(local.Code()),\n226|\t\tMessage: local.Error(),\n227|\t\tDetails: axerror.Details{},\n228|\t\tCause:   cause,\n229|\t}); !errors.Is(err, axerror.ErrCausalLeak) {\n230|\t\tt.Fatalf(\"naive message lift error = %v, want the causal-leak refusal\", err)\n231|\t}\n232|\tif _, err := axerror.New(axerror.Spec{\n233|\t\tVersion: axerror.Version100,\n234|\t\tCode:    axerror.Code(local.Code()),\n235|\t\tMessage: \"provider discovery could not establish its filesystem preconditions\",\n236|\t\tDetails: axerror.Details{\"failure\": \"wrapping \" + cause.Error()},\n237|\t\tCause:   cause,\n238|\t}); !errors.Is(err, axerror.ErrCausalLeak) {\n239|\t\tt.Fatalf(\"naive details lift error = %v, want the causal-leak refusal\", err)\n240|\t}\n241|}\n242|\n243|// derivedProviderCodes derives the closed refusal-code set from the\n244|// production const block in provider.go, never from memory: a code added\n245|// to production without a lift vector reddens the totality test below\n246|// instead of shipping unwitnessed.\n247|func derivedProviderCodes(t *testing.T) map[string]bool {\n248|\tt.Helper()\n249|\tpath := filepath.Join(mustProviderDir(t), \"provider.go\")\n250|\tsource, err := os.ReadFile(path)\n251|\tif err != nil {\n252|\t\tt.Fatalf(\"read provider.go: %v\", err)\n253|\t}\n254|\tfileSet := token.NewFileSet()\n255|\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n256|\tif err != nil {\n257|\t\tt.Fatalf(\"parse provider.go: %v\", err)\n258|\t}\n259|\tcodes := map[string]bool{}\n260|\tfor _, decl := range syntax.Decls {\n261|\t\tgeneral, ok := decl.(*ast.GenDecl)\n262|\t\tif !ok || general.Tok != token.CONST {\n263|\t\t\tcontinue\n264|\t\t}\n265|\t\tfor _, spec := range general.Specs {\n266|\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n267|\t\t\tif !ok {\n268|\t\t\t\tcontinue\n269|\t\t\t}\n270|\t\t\tfor i, name := range values.Names {\n271|\t\t\t\tif i >= len(values.Values) {\n272|\t\t\t\t\tcontinue\n273|\t\t\t\t}\n274|\t\t\t\tliteral, ok := values.Values[i].(*ast.BasicLit)\n275|\t\t\t\tif !ok || literal.Kind != token.STRING {\n276|\t\t\t\t\tcontinue\n277|\t\t\t\t}\n278|\t\t\t\tvalue := strings.Trim(literal.Value, `\"`)\n279|\t\t\t\tif strings.HasPrefix(name.Name, \"code\") {\n280|\t\t\t\t\tcodes[value] = true\n281|\t\t\t\t}\n282|\t\t\t}\n283|\t\t}\n284|\t}\n285|\tif len(codes) == 0 {\n286|\t\tt.Fatal(\"derived zero provider codes; the scan is blind, not the package\")\n287|\t}\n288|\treturn codes\n289|}\n290|\n291|// TestLiftCoversTheClosedCodeSet is the totality direction: every\n292|// production-derived code has a real-failure lift vector above, and\n293|// every vector names a derived code, so neither an unwitnessed code\n294|// nor an orphan row survives.\n295|func TestLiftCoversTheClosedCodeSet(t *testing.T) {\n296|\tt.Parallel()\n297|\n298|\tderived := derivedProviderCodes(t)\n299|\tcovered := map[string]bool{}\n300|\tfor _, vector := range liftVectors() {\n301|\t\tif !derived[vector.code] {\n302|\t\t\tt.Errorf(\"lift vector %q names underived code %q\", vector.name, vector.code)\n303|\t\t}\n304|\t\tcovered[vector.code] = true\n305|\t}\n306|\tfor code := range derived {\n307|\t\tif !covered[code] {\n308|\t\t\tt.Errorf(\"production code %q has no lift vector; the lift is partial\", code)\n309|\t\t}\n310|\t}\n311|}"}}}
