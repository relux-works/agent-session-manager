{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d3","stream":{"kind":"session","id":"01a078cc-1760-74e1-88b8-95e63d54bb99"},"sequence":708,"recorded_at":1780531400001411,"record_type":"event","durability":"durable","causation_id":"95ac6e07-9332-4f27-bb68-19da4362cead","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"95ac6e07-9332-4f27-bb68-19da4362cead","run_stream":{"kind":"run","id":"95ac6e07-9332-4f27-bb68-19da4362cead"},"task_stream":{"kind":"task","id":"816b5557-eeea-4610-af01-2551e88f8abe"},"task_id":"816b5557-eeea-4610-af01-2551e88f8abe","event":{"kind":"output","task_id":"816b5557-eeea-4610-af01-2551e88f8abe","chunk":"Read text file `internal/provhost/refusal_arm_inventory_test.go`.\n(299 line(s) above)\n300|\treturn strings.Join(strings.Fields(string(source[start:end])), \" \")\n301|}\n302|\n303|// armParseBranches derives one obligation per parseMajor rejection\n304|// branch in this file: every return 0, false inside parseMajor, keyed by\n305|// its innermost enclosing condition, and returns how many it derived. A\n306|// new branch adds a key no witness names; a deleted branch orphans its\n307|// witness; narrowing || to && rewrites the key and does both. The caller\n308|// fails closed when no file derives any branch.\n309|func armParseBranches(source []byte, fileSet *token.FileSet, syntax *ast.File, arms map[string]struct{}) int {\n310|\tvar body *ast.BlockStmt\n311|\tfor _, decl := range syntax.Decls {\n312|\t\tfunction, ok := decl.(*ast.FuncDecl)\n313|\t\tif ok && function.Name.Name == \"parseMajor\" {\n314|\t\t\tbody = function.Body\n315|\t\t}\n316|\t}\n317|\tif body == nil {\n318|\t\treturn 0\n319|\t}\n320|\tcount := 0\n321|\tvar conditions []string\n322|\tvar walk func(node ast.Node)\n323|\twalk = func(node ast.Node) {\n324|\t\tbranch, ok := node.(*ast.IfStmt)\n325|\t\tif !ok {\n326|\t\t\tfor _, child := range childNodes(node) {\n327|\t\t\t\twalk(child)\n328|\t\t\t}\n329|\t\t\treturn\n330|\t\t}\n331|\t\tconditions = append(conditions, nodeSource(source, fileSet, branch.Cond))\n332|\t\tfor _, stmt := range branch.Body.List {\n333|\t\t\tif ret, ok := stmt.(*ast.ReturnStmt); ok && isFalsePair(ret) {\n334|\t\t\t\tarms[\"parse|\"+conditions[len(conditions)-1]] = struct{}{}\n335|\t\t\t\tcount++\n336|\t\t\t}\n337|\t\t}\n338|\t\tfor _, child := range childNodes(node) {\n339|\t\t\twalk(child)\n340|\t\t}\n341|\t\tconditions = conditions[:len(conditions)-1]\n342|\t}\n343|\twalk(body)\n344|\treturn count\n345|}\n346|\n347|func isFalsePair(ret *ast.ReturnStmt) bool {\n348|\tif len(ret.Results) != 2 {\n349|\t\treturn false\n350|\t}\n351|\tzero, ok := ret.Results[0].(*ast.BasicLit)\n352|\tif !ok || zero.Kind != token.INT || zero.Value != \"0\" {\n353|\t\treturn false\n354|\t}\n355|\tno, ok := ret.Results[1].(*ast.Ident)\n356|\treturn ok && no.Name == \"false\"\n357|}\n358|\n359|func childNodes(node ast.Node) []ast.Node {\n360|\tvar children []ast.Node\n361|\tast.Inspect(node, func(child ast.Node) bool {\n362|\t\tif child == nil || child == node {\n363|\t\t\treturn true\n364|\t\t}\n365|\t\tchildren = append(children, child)\n366|\t\treturn false\n367|\t})\n368|\treturn children\n369|}\n370|\n371|// armWitness proves one derived refusal arm at the production entry.\n372|// The arm key must equal the derived key exactly: TestWitnessedArmsAreAllDerived\n373|// fails a witness that names nothing production declares, so a deleted or\n374|// narrowed production branch orphans its witness instead of passing\n375|// silently. The prove function must drive the production entry point and\n376|// require the refusal attributed to THIS arm, not merely any refusal.\n377|type armWitness struct {\n378|\tarm   string\n379|\tname  string\n(more lines below)"}}}
