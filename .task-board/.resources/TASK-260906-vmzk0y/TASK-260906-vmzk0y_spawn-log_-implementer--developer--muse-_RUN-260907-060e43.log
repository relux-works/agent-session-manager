{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f9","stream":{"kind":"session","id":"01a0798b-7163-70b0-97ad-b352b272603a"},"sequence":87,"recorded_at":1780531400000169,"record_type":"event","durability":"durable","causation_id":"dc5c1739-4e29-438f-8da2-c94717917c0b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dc5c1739-4e29-438f-8da2-c94717917c0b","run_stream":{"kind":"run","id":"dc5c1739-4e29-438f-8da2-c94717917c0b"},"task_stream":{"kind":"task","id":"36588343-a958-4cbd-96fe-8e80f9d3d820"},"task_id":"36588343-a958-4cbd-96fe-8e80f9d3d820","event":{"kind":"output","task_id":"36588343-a958-4cbd-96fe-8e80f9d3d820","chunk":"{\n  \"chunk_id\": \"exec-5-1\",\n  \"command\": \"task-board worktree --help 2>&1; echo \\\"===\\\"; task-board --help 2>&1 | head -50\",\n  \"description\": \"Inspect worktree CLI options\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Inspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  invalidate-acceptance Release an element whose acceptance §6.2 already invalidated back to rework\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n===\\nManage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n\",\n  \"original_output_bytes\": 5042,\n  \"original_output_tokens\": 1261,\n  \"truncated\": false\n}"}}}
