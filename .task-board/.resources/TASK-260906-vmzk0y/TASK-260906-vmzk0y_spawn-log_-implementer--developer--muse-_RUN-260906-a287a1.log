429|\t// member rule runs. A recognizable foreign major is\n430|\t// incompatible_protocol no matter what members it carries, so\n431|\t// the v2 member vocabulary below must not judge it first: a\n432|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n433|\t// is a foreign major, not an unknown or missing member. The\n434|\t// peek trusts nothing and refuses nothing: it only arms when\n435|\t// the protocol member is exactly this protocol and the version\n436|\t// member is a string with a recognizable foreign major. A frame\n437|\t// without our protocol identity, or without a readable version,\n438|\t// falls through to the member rules, which keep their verdicts.\n439|\tforeignMajor := \"\"\n440|\tif rawProtocol, present := members[\"protocol\"]; present {\n441|\t\tvar protocol string\n442|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n443|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n444|\t\t\t\tvar version string\n445|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n446|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n447|\t\t\t\t\t\tforeignMajor = version\n448|\t\t\t\t\t}\n449|\t\t\t\t}\n450|\t\t\t}\n451|\t\t}\n452|\t}\n453|\tvar ok bool\n454|\tif foreignMajor == \"\" {\n455|\t\tif raw, present := members[\"ok\"]; !present {\n456|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n457|\t\t\tif err != nil {\n458|\t\t\t\treturn Response{}, err\n459|\t\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
