{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3bf","stream":{"kind":"session","id":"01a078f2-d5f9-7612-b470-6ad9a3cae55b"},"sequence":58,"recorded_at":1780531400000111,"record_type":"event","durability":"durable","causation_id":"ba0fc865-f921-4c71-91f7-cd27de007268","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ba0fc865-f921-4c71-91f7-cd27de007268","run_stream":{"kind":"run","id":"ba0fc865-f921-4c71-91f7-cd27de007268"},"task_stream":{"kind":"task","id":"16ef4d9b-9e16-4513-a7a8-b33380f0cd26"},"task_id":"16ef4d9b-9e16-4513-a7a8-b33380f0cd26","event":{"kind":"output","task_id":"16ef4d9b-9e16-4513-a7a8-b33380f0cd26","chunk":"Read text file `internal/provhost/protocol.go`.\n(339 line(s) above)\n340|\t\tif _, forbidden := members[\"error\"]; forbidden {\n341|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n342|\t\t}\n343|\t} else {\n344|\t\tif _, present := members[\"error\"]; !present {\n345|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n346|\t\t}\n347|\t\tif _, forbidden := members[\"body\"]; forbidden {\n348|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n349|\t\t}\n350|\t}\n351|\tfor name := range members {\n352|\t\tif !responseMembers[name] {\n353|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n354|\t\t}\n355|\t}\n356|\treturn nil\n357|}\n358|\n359|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n360|// Anything else is not a recognizable major, so the frame is unusable\n361|// rather than a mismatch. A major that does not fit an int saturates\n362|// instead of wrapping but stays recognized: an all-numeric giant is\n363|// observably foreign (it is not 2), so it must take the mismatch arm,\n364|// never alias a small native major (18446744073709551618 must not read\n365|// as 2) and never slide to the unusable-frame arm. Saturation adds no\n366|// rejection branch, so the derived parse-arm census is unchanged.\n367|func parseMajor(version string) (int, bool) {\n368|\tparts := strings.Split(version, \".\")\n369|\tif len(parts) != 3 {\n370|\t\treturn 0, false\n371|\t}\n372|\tmajor := 0\n373|\tfor i := 0; i < len(parts[0]); i++ {\n374|\t\tdigit := parts[0][i]\n375|\t\tif digit < '0' || digit > '9' {\n376|\t\t\treturn 0, false\n377|\t\t}\n378|\t\tstep := int(digit - '0')\n379|\t\tif major > (math.MaxInt-step)/10 {\n380|\t\t\treturn math.MaxInt, true\n381|\t\t}\n382|\t\tmajor = major*10 + step\n383|\t}\n384|\tif len(parts[0]) == 0 {\n385|\t\treturn 0, false\n386|\t}\n387|\tfor _, rest := range parts[1:] {\n388|\t\tif len(rest) == 0 {\n389|\t\t\treturn 0, false\n390|\t\t}\n391|\t\tfor i := 0; i < len(rest); i++ {\n392|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n393|\t\t\t\treturn 0, false\n394|\t\t\t}\n395|\t\t}\n396|\t}\n397|\treturn major, true\n398|}\n399|\n400|// DecodeResponse validates one stdout line as the single response frame\n401|// for the request carrying wantRequestID. It returns the success body, or\n402|// the bound child failure, or a local failure that trusts nothing from\n403|// the frame. A recognizable foreign major yields incompatible_protocol;\n404|// every other unusable frame yields provider_protocol_error.\n405|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n406|\tif len(frame) > MaxFrameBytes {\n407|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n408|\t\tif err != nil {\n409|\t\t\treturn Response{}, err\n410|\t\t}\n411|\t\treturn Response{}, failure\n412|\t}\n413|\tif !utf8.Valid(frame) {\n414|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n415|\t\tif err != nil {\n416|\t\t\treturn Response{}, err\n417|\t\t}\n418|\t\treturn Response{}, failure\n419|\t}\n420|\tmembers, fault := decodeStrictObject(frame)\n421|\tif fault != nil {\n422|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n423|\t\tif err != nil {\n424|\t\t\treturn Response{}, err\n425|\t\t}\n426|\t\treturn Response{}, failure\n427|\t}\n428|\t// foreignMajor peeks at the envelope identity before any v2\n429|\t// member rule runs. A recognizable foreign major is\n430|\t// incompatible_protocol no matter what members it carries, so\n431|\t// the v2 member vocabulary below must not judge it first: a\n432|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n433|\t// is a foreign major, not an unknown or missing member. The\n434|\t// peek trusts nothing and refuses nothing: it only arms when\n435|\t// the protocol member is exactly this protocol and the version\n436|\t// member is a string with a recognizable foreign major. A frame\n437|\t// without our protocol identity, or without a readable version,\n438|\t// falls through to the member rules, which keep their verdicts.\n439|\tforeignMajor := \"\"\n440|\tif rawProtocol, present := members[\"protocol\"]; present {\n441|\t\tvar protocol string\n442|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n443|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n444|\t\t\t\tvar version string\n445|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n446|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n447|\t\t\t\t\t\tforeignMajor = version\n448|\t\t\t\t\t}\n449|\t\t\t\t}\n450|\t\t\t}\n451|\t\t}\n452|\t}\n453|\tvar ok bool\n454|\tif foreignMajor == \"\" {\n455|\t\tif raw, present := members[\"ok\"]; !present {\n456|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n457|\t\t\tif err != nil {\n458|\t\t\t\treturn Response{}, err\n459|\t\t\t}\n(more lines below)"}}}
