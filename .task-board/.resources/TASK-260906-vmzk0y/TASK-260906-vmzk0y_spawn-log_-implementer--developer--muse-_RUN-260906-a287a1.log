{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d9","stream":{"kind":"session","id":"01a078f2-d5f9-7612-b470-6ad9a3cae55b"},"sequence":199,"recorded_at":1780531400000393,"record_type":"event","durability":"durable","causation_id":"ba0fc865-f921-4c71-91f7-cd27de007268","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ba0fc865-f921-4c71-91f7-cd27de007268","run_stream":{"kind":"run","id":"ba0fc865-f921-4c71-91f7-cd27de007268"},"task_stream":{"kind":"task","id":"27d92d43-ebe3-4005-b4c7-b9afbb06fd93"},"task_id":"27d92d43-ebe3-4005-b4c7-b9afbb06fd93","event":{"kind":"output","task_id":"27d92d43-ebe3-4005-b4c7-b9afbb06fd93","chunk":"Read text file `internal/provhost/protocol_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// asError unwraps err to an *axerror.Error without hiding the chain.\n15|func asError(t *testing.T, err error, failure **axerror.Error) bool {\n16|\tt.Helper()\n17|\treturn errors.As(err, failure)\n18|}\n19|\n20|const (\n21|\ttestRequestID = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n22|\ttestOtherID   = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n23|\ttestDeadline  = \"2026-08-19T04:05:00.000Z\"\n24|\ttestNow       = \"2026-08-19T04:00:00.000Z\"\n25|)\n26|\n27|func mustUUIDv7(t *testing.T, value string) scalar.UUIDv7 {\n28|\tt.Helper()\n29|\tparsed, err := scalar.ParseUUIDv7(value)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"ParseUUIDv7(%q): %v\", value, err)\n32|\t}\n33|\treturn parsed\n34|}\n35|\n36|func mustTimestamp(t *testing.T, value string) scalar.Timestamp {\n37|\tt.Helper()\n38|\tparsed, err := scalar.ParseTimestamp(value)\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n41|\t}\n42|\treturn parsed\n43|}\n44|\n45|func mustInstant(t *testing.T, value string) time.Time {\n46|\tt.Helper()\n47|\tinstant, err := mustTimestamp(t, value).Time()\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"Timestamp(%q).Time(): %v\", value, err)\n50|\t}\n51|\treturn instant\n52|}\n53|\n54|// testRequest builds the Section 7.2 request-envelope fixture: a doctor\n55|// operation with a future deadline. The production entry point for\n56|// framing is EncodeRequest.\n57|func testRequest(t *testing.T) Request {\n58|\tt.Helper()\n59|\treturn Request{\n60|\t\tOperation: OpDoctor,\n61|\t\tRequestID: mustUUIDv7(t, testRequestID),\n62|\t\tDeadline:  mustTimestamp(t, testDeadline),\n63|\t\tBody:      json.RawMessage(`{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}`),\n64|\t}\n65|}\n66|\n67|// failureCode extracts the Structured Error code from err, failing when\n68|// err is not an *axerror.Error. Every failure below is a 1.0.0 object,\n69|// local or child-bound.\n70|func failureCode(t *testing.T, err error) axerror.Code {\n71|\tt.Helper()\n72|\tif err == nil {\n73|\t\tt.Fatal(\"want a failure, got nil\")\n74|\t}\n75|\tvar failure *axerror.Error\n76|\tif !asError(t, err, &failure) {\n77|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n78|\t}\n79|\treturn failure.Code()\n80|}\n(more lines below)"}}}
