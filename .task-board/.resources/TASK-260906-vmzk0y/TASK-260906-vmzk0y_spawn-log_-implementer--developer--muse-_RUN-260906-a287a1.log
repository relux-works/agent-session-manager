{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3f3","stream":{"kind":"session","id":"01a078f2-d5f9-7612-b470-6ad9a3cae55b"},"sequence":84,"recorded_at":1780531400000163,"record_type":"event","durability":"durable","causation_id":"ba0fc865-f921-4c71-91f7-cd27de007268","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ba0fc865-f921-4c71-91f7-cd27de007268","run_stream":{"kind":"run","id":"ba0fc865-f921-4c71-91f7-cd27de007268"},"task_stream":{"kind":"task","id":"4ccf05f8-4e10-4636-acb1-3a81036bcfbe"},"task_id":"4ccf05f8-4e10-4636-acb1-3a81036bcfbe","event":{"kind":"output","task_id":"4ccf05f8-4e10-4636-acb1-3a81036bcfbe","chunk":"Read text file `internal/provhost/protocol.go`.\n(459 line(s) above)\n460|\t\t\treturn Response{}, failure\n461|\t\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n462|\t\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n463|\t\t\tif fault != nil {\n464|\t\t\t\treturn Response{}, fault\n465|\t\t\t}\n466|\t\t\treturn Response{}, failure\n467|\t\t}\n468|\t\tif fault := checkResponseMembers(members, ok); fault != nil {\n469|\t\t\tfailure, err := failProtocol(fault.detail, fault.member)\n470|\t\t\tif err != nil {\n471|\t\t\t\treturn Response{}, err\n472|\t\t\t}\n473|\t\t\treturn Response{}, failure\n474|\t\t}\n475|\t}\n476|\tvar protocol string\n477|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n478|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n479|\t\tif fault != nil {\n480|\t\t\treturn Response{}, fault\n481|\t\t}\n482|\t\treturn Response{}, failure\n483|\t}\n484|\tvar version string\n485|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n486|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n487|\t\tif fault != nil {\n488|\t\t\treturn Response{}, fault\n489|\t\t}\n490|\t\treturn Response{}, failure\n491|\t}\n492|\tif version != ProtocolVersion {\n493|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n494|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n495|\t\t\tif err != nil {\n496|\t\t\t\treturn Response{}, err\n497|\t\t\t}\n498|\t\t\treturn Response{}, failure\n499|\t\t}\n500|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n501|\t\tif fault != nil {\n502|\t\t\treturn Response{}, fault\n503|\t\t}\n504|\t\treturn Response{}, failure\n505|\t}\n506|\tvar requestID string\n507|\tif err := json.Unmarshal(members[\"request_id\"], &requestID); err != nil {\n508|\t\tfailure, fault := failProtocol(\"member is not a string\", \"request_id\")\n509|\t\tif fault != nil {\n510|\t\t\treturn Response{}, fault\n511|\t\t}\n512|\t\treturn Response{}, failure\n513|\t}\n514|\tif _, err := scalar.ParseUUIDv7(requestID); err != nil {\n515|\t\tfailure, fault := failProtocol(\"request_id is not a UUIDv7\", \"request_id\")\n516|\t\tif fault != nil {\n517|\t\t\treturn Response{}, fault\n518|\t\t}\n519|\t\treturn Response{}, failure\n520|\t}\n521|\tif requestID != wantRequestID.String() {\n522|\t\tfailure, fault := failProtocol(\"request_id does not match the request\", \"request_id\")\n523|\t\tif fault != nil {\n524|\t\t\treturn Response{}, fault\n525|\t\t}\n526|\t\treturn Response{}, failure\n527|\t}\n528|\tif ok {\n529|\t\tif !isJSONObject(members[\"body\"]) {\n530|\t\t\tfailure, fault := failProtocol(\"body is not a JSON object\", \"body\")\n531|\t\t\tif fault != nil {\n532|\t\t\t\treturn Response{}, fault\n533|\t\t\t}\n534|\t\t\treturn Response{}, failure\n535|\t\t}\n536|\t\treturn Response{Body: append(json.RawMessage(nil), members[\"body\"]...)}, nil\n537|\t}\n538|\tif !isJSONObject(members[\"error\"]) {\n539|\t\tfailure, fault := failProtocol(\"error is not a JSON object\", \"error\")\n540|\t\tif fault != nil {\n541|\t\t\treturn Response{}, fault\n542|\t\t}\n543|\t\treturn Response{}, failure\n544|\t}\n545|\t// The failure-error version is selected by the observed envelope\n546|\t// major through the static Section 15.1/17.1 table, never from the\n547|\t// document: major 2 decodes under Structured Error 1.0.0, and major\n548|\t// 3 would decode under Structured Error 1.3.0. Only 2.0.0 reaches\n549|\t// this line — a recognizable 3.x envelope was refused above as a\n550|\t// major mismatch, because a v2-only host never trusts a different\n551|\t// major's error (Section 7.A) — so the contract below carries major\n552|\t// 2 on every reachable path today, and admits 1.3.0 by construction\n553|\t// the day the version gate admits 3.0.0. The blank parse result is\n554|\t// total here: the gate above admitted exactly \"2.0.0\".\n555|\tobservedMajor, _ := parseMajor(version)\n556|\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}, members[\"error\"])\n557|\tif err != nil {\n558|\t\tfailure, fault := failProtocol(\"error is not a bound Structured Error 1.0.0\", \"error\")\n559|\t\tif fault != nil {\n(more lines below)"}}}
