999999999999999.abc.def\",\n776|\t} {\n777|\t\tif _, recognized := parseMajor(version); recognized {\n778|\t\t\tt.Fatalf(\"parseMajor(%q) = recognized, want unrecognized for the peek control\", version)\n779|\t\t}\n780|\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"body\":{}}`)\n781|\t\t_, err := DecodeResponse(frame, want)\n782|\t\trequireFrameRefusal(t, err, \"ok\", \"missing member\")\n783|\t\tif failureExit(t, err) != 13 {\n784|\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n785|\t\t}\n786|\t}\n787|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
