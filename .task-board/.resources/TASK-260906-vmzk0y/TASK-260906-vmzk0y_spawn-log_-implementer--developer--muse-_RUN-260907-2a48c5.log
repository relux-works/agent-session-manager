{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5db","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":328,"recorded_at":1780531400000651,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"c17e9b79-df7f-4eaf-a9b9-d4319978acff"},"task_id":"c17e9b79-df7f-4eaf-a9b9-d4319978acff","event":{"kind":"output","task_id":"c17e9b79-df7f-4eaf-a9b9-d4319978acff","chunk":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(718 line(s) above)\n719|// TestCheckVersionTuple narrows version admission to membership: the accepted\n720|// protocol must be exactly one list member in major 1.\n721|func TestCheckVersionTuple(t *testing.T) {\n722|\tt.Parallel()\n723|\n724|\tif err := terminalbackend.CheckVersionTuple(\"com.example.term\", \"1.2.3\", \"1.0.0\", []string{\"1.0.0\", \"1.1.0\"}); err != nil {\n725|\t\tt.Errorf(\"CheckVersionTuple(member) error = %v, want admission\", err)\n726|\t}\n727|\tcases := []struct {\n728|\t\tname  string\n729|\t\timpl  string\n730|\t\tproto string\n731|\t\tlist  []string\n732|\t}{\n733|\t\t{\"non-semver implementation\", \"v1\", \"1.0.0\", []string{\"1.0.0\"}},\n734|\t\t{\"protocol major 2\", \"1.2.3\", \"2.0.0\", []string{\"2.0.0\"}},\n735|\t\t{\"protocol not a member\", \"1.2.3\", \"1.1.0\", []string{\"1.0.0\"}},\n736|\t\t{\"protocol major 1 but unlisted\", \"1.2.3\", \"1.0.0\", []string{\"1.1.0\"}},\n737|\t\t{\"non-semver protocol\", \"1.2.3\", \"one\", []string{\"one\"}},\n738|\t\t{\"empty list\", \"1.2.3\", \"1.0.0\", nil},\n739|\t}\n740|\tfor _, testCase := range cases {\n741|\t\tt.Run(testCase.name, func(t *testing.T) {\n742|\t\t\tt.Parallel()\n743|\t\t\terr := terminalbackend.CheckVersionTuple(\"com.example.term\", testCase.impl, testCase.proto, testCase.list)\n744|\t\t\tif !terminalbackend.IsDrift(err) {\n745|\t\t\t\tt.Errorf(\"CheckVersionTuple() error = %v, want terminal_backend_implementation_drift\", err)\n746|\t\t\t}\n747|\t\t})\n748|\t}\n749|}\n750|\n751|// TestCheckProviderDescriptor drives the Section 7.A production rule: the\n752|// provider rejects a descriptor that does not match the validated binding.\n753|func TestCheckProviderDescriptor(t *testing.T) {\n754|\tt.Parallel()\n755|\n756|\tbinding := terminalbackend.InstanceBinding{\n757|\t\tBackendID:             \"com.example.term\",\n758|\t\tImplementationVersion: \"1.2.3\",\n759|\t\tProtocolVersion:       \"1.0.0\",\n760|\t\tGeneration:            \"generation-1\",\n761|\t\tTerminalBindingID:     testDigest,\n762|\t}\n763|\tif err := terminalbackend.CheckProviderDescriptor(binding, binding); err != nil {\n764|\t\tt.Errorf(\"CheckProviderDescriptor(match) error = %v, want admission\", err)\n765|\t}\n766|\n767|\tversionDrift := binding\n768|\tversionDrift.ImplementationVersion = \"1.2.4\"\n769|\tif err := terminalbackend.CheckProviderDescriptor(versionDrift, binding); !terminalbackend.IsDrift(err) {\n770|\t\tt.Errorf(\"CheckProviderDescriptor(version drift) error = %v, want terminal_backend_implementation_drift\", err)\n771|\t}\n772|\tprotoDrift := binding\n773|\tprotoDrift.ProtocolVersion = \"1.1.0\"\n774|\tif err := terminalbackend.CheckProviderDescriptor(protoDrift, binding); !terminalbackend.IsDrift(err) {\n775|\t\tt.Errorf(\"CheckProviderDescriptor(protocol drift) error = %v, want terminal_backend_implementation_drift\", err)\n776|\t}\n777|\tidMismatch := binding\n778|\tidMismatch.BackendID = \"com.example.other\"\n779|\tif err := terminalbackend.CheckProviderDescriptor(idMismatch, binding); !terminalbackend.IsNotFound(err) {\n780|\t\tt.Errorf(\"CheckProviderDescriptor(ID mismatch) error = %v, want terminal_backend_not_found\", err)\n781|\t}\n782|\t// The stale-generation arm lives in TestCheckProviderDescriptorGenerationMismatch.\n783|}\n784|\n785|// TestCheckProviderDescriptorGenerationBounds proves the Section 7.A\n786|// string[1..256] bound itself, not the generation mismatch: every refusal\n787|// case carries the SAME generation on both sides, so the mismatch comparison\n788|// cannot fire and only the bound can refuse. (Pitting a mutated generation\n789|// against a fixed one proves nothing about the bound — the inequality alone\n790|// returns terminal_backend_stale_generation.)\n791|func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\n792|\tt.Parallel()\n793|\n794|\twithGeneration := func(generation string) terminalbackend.InstanceBinding {\n795|\t\treturn terminalbackend.InstanceBinding{\n796|\t\t\tBackendID:             \"com.example.term\",\n797|\t\t\tImplementationVersion: \"1.2.3\",\n798|\t\t\tProtocolVersion:       \"1.0.0\",\n(more lines below)"}}}
