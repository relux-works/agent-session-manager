{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c519","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":231,"recorded_at":1780531400000457,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"call_id":"call_01a0793a6e3176428a0dfed5b1218452","text":"Read text file `internal/provhost/protocol_test.go`.\n(559 line(s) above)\n560|\twant := mustUUIDv7(t, testRequestID)\n561|\tforeign := []byte(`{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.3.0\",\"code\":\"terminal_backend_integrity_failure\",` +\n562|\t\t`\"message\":\"v3 backend binding failed\",\"exit_code\":9,\"retryable\":false,\"details\":{}}`)\n563|\tif _, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: 3}, foreign); err != nil {\n564|\t\tt.Fatalf(\"embedded v3 error is not well-formed 1.3.0 under the (provider, 3) binding: %v\", err)\n565|\t}\n566|\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,` +\n567|\t\t`\"error\":` + string(foreign) + `}`)\n568|\t_, err := DecodeResponse(frame, want)\n569|\tif failureCode(t, err) != \"incompatible_protocol\" {\n570|\t\tt.Fatalf(\"DecodeResponse(3.0.0 failure) code = %v, want incompatible_protocol\", err)\n571|\t}\n572|\trendered := err.Error()\n573|\tfor _, foreign := range []string{\"terminal_backend_integrity_failure\", \"v3 backend binding failed\"} {\n574|\t\tif strings.Contains(rendered, foreign) {\n575|\t\t\tt.Fatalf(\"foreign v3 payload leaked into the local failure: %v\", err)\n576|\t\t}\n577|\t}\n578|\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n579|\t\tt.Fatalf(\"DecodeResponse(3.0.0 failure) observed = %v, want 3.0.0\", observed)\n580|\t}\n581|}\n582|\n583|// TestDecodeResponseV2FailureWith130ErrorIsBoundTo100 proves the\n584|// failure-error contract is selected by the observed envelope major,\n585|// never the document: a well-formed 1.3.0 error under a 2.0.0 envelope\n586|// is refused as unbound under 1.0.0 rather than decoded as 1.3.0. A\n587|// gate that decoded whatever version the document claimed would admit\n588|// this frame; the named arm below is what keeps the 1.0.0 binding\n589|// exact.\n590|func TestDecodeResponseV2FailureWith130ErrorIsBoundTo100(t *testing.T) {\n591|\twant := mustUUIDv7(t, testRequestID)\n592|\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,` +\n593|\t\t`\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.3.0\",\"code\":\"invalid_config\",` +\n594|\t\t`\"message\":\"wrong version for this envelope\",\"exit_code\":3,\"retryable\":false,\"details\":{}}}`)\n595|\t_, err := DecodeResponse(frame, want)\n596|\trequireFrameRefusal(t, err, \"error\", \"error is not a bound Structured Error 1.0.0\")\n597|\tif strings.Contains(err.Error(), \"wrong version for this envelope\") {\n598|\t\tt.Fatalf(\"foreign-version payload leaked into the local failure: %v\", err)\n599|\t}\n600|}\n601|\n602|// TestParseMajorNeverWraps proves the major is decided on the digit\n603|// string, never on a wrapped accumulator: 18446744073709551617.0.0\n604|// wraps to major 1 and 18446744073709551618.0.0 wraps to major 2 in 64\n605|// bits, so an accumulating gate mistakes both foreign majors for native\n606|// ones. A wrapped major is a version-confusion primitive: the envelope\n607|// gate below decides admission on this number. All four literals are\n608|// recognized (all-numeric X.Y.Z) and must report a major other than 1\n609|// or 2; the wrap-to-2 row additionally must refuse at DecodeResponse as\n610|// a foreign major (incompatible_protocol, exit 6), not as an unusable\n611|// frame (exit 13) and never as 2.0.0.\n612|func TestParseMajorNeverWraps(t *testing.T) {\n613|\tfor _, version := range []string{\n614|\t\t\"18446744073709551617.0.0\",\n615|\t\t\"18446744073709551618.0.0\",\n616|\t\t\"18446744073709551616.0.0\",\n617|\t\t\"99999999999999999999999999999999999999999.0.0\",\n618|\t} {\n619|\t\tmajor, recognized := parseMajor(version)\n620|\t\tif !recognized {\n621|\t\t\tt.Fatalf(\"parseMajor(%q) = unrecognized, want a recognized foreign major\", version)\n622|\t\t}\n623|\t\tif major == 1 || major == 2 {\n624|\t\t\tt.Fatalf(\"parseMajor(%q) = %d, want a major other than 1 or 2\", version, major)\n625|\t\t}\n626|\t}\n627|\n628|\twant := mustUUIDv7(t, testRequestID)\n629|\t_, err := DecodeResponse(armVersionFrame(\"18446744073709551618.0.0\"), want)\n630|\tif failureCode(t, err) != \"incompatible_protocol\" {\n631|\t\tt.Fatalf(\"DecodeResponse(wrapped-to-2 major) code = %v, want incompatible_protocol\", err)\n632|\t}\n633|\tif failureExit(t, err) != 6 {\n634|\t\tt.Fatalf(\"DecodeResponse(wrapped-to-2 major) exit = %d, want 6\", failureExit(t, err))\n635|\t}\n636|}\n637|\n638|// TestParseMajorSaturationStillValidatesTheRest proves saturation never\n639|// short-circuits the X.Y.Z shape check: a version whose first component\n640|// overflows but whose rest is malformed is unrecognized, so\n641|// DecodeResponse refuses it as an unusable frame\n642|// (provider_protocol_error, exit 13), not as a foreign major\n643|// (incompatible_protocol, exit 6). The saturating early return this\n644|// test guards against reported exactly these inputs as recognized; the\n645|// rows below pin the two classes apart so a future short-circuit\n646|// reddens here. The production entry point is DecodeResponse.\n647|func TestParseMajorSaturationStillValidatesTheRest(t *testing.T) {\n648|\twant := mustUUIDv7(t, testRequestID)\n649|\tfor _, version := range []string{\n650|\t\t\"99999999999999999999.abc.def\",\n651|\t\t\"99999999999999999999.0.x\",\n652|\t\t\"99999999999999999999..0\",\n653|\t\t\"18446744073709551618..0\",\n654|\t\t\"18446744073709551618.0.x\",\n655|\t} {\n656|\t\tif major, recognized := parseMajor(version); recognized {\n657|\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n658|\t\t}\n659|\t\t_, err := DecodeResponse(armVersionFrame(version), want)\n660|\t\tif failureCode(t, err) != \"provider_protocol_error\" {\n661|\t\t\tt.Fatalf(\"DecodeResponse(%q) code = %v, want provider_protocol_error\", version, err)\n662|\t\t}\n663|\t\tif failureExit(t, err) != 13 {\n664|\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n665|\t\t}\n666|\t}\n667|}\n668|\n669|// TestParseMajorSaturationEdge proves the saturation guard at its exact\n670|// arithmetic edge, through the production entry point DecodeResponse.\n671|// math.MaxInt is 9223372036854775807 and MaxInt/10 is 922337203685477580.\n672|// The guard `major > (math.MaxInt-step)/10` must admit 9223372036854775807\n673|// exactly (the largest value that fits) and saturate 9223372036854775808\n674|// (MaxInt+1) to MaxInt. The weakened guard `major > math.MaxInt/10` differs\n675|// only when the accumulator sits at exactly MaxInt/10 and the next digit is\n676|// 8 or 9: it computes major*10+step in int64, which wraps. The aliasing\n677|// witness 922337203685477580802.0.0 walks the accumulator to MaxInt/10, wraps\n678|// to -2^63 on the `8`, resets to 0 on the following `0` (0 mod 2^64), and lands\n679|// on 2 — a foreign major aliasing native major 2, the exact invariant the\n680|// parseMajor doc comment asserts. Its one-step neighbours 801 (wraps to 1)\n681|// and 803 (wraps to 3) pin that the fix is at the guard, not a literal\n682|// blocklist of one string. Moving the guard literal by one term must redden\n683|// here: every row requires parseMajor == MaxInt (not merely recognized) and\n684|// DecodeResponse incompatible_protocol exit 6 with observed echoed.\n685|func TestParseMajorSaturationEdge(t *testing.T) {\n686|\twant := mustUUIDv7(t, testRequestID)\n687|\tfor _, version := range []string{\n688|\t\t\"9223372036854775807.0.0\",\n689|\t\t\"9223372036854775808.0.0\",\n690|\t\t\"922337203685477580801.0.0\",\n691|\t\t\"922337203685477580802.0.0\",\n692|\t\t\"922337203685477580803.0.0\",\n693|\t} {\n694|\t\tmajor, recognized := parseMajor(version)\n695|\t\tif !recognized {\n696|\t\t\tt.Fatalf(\"parseMajor(%q) = unrecognized, want saturated foreign major\", version)\n697|\t\t}\n698|\t\tif major != math.MaxInt {\n699|\t\t\tt.Fatalf(\"parseMajor(%q) = %d, want saturation to math.MaxInt\", version, major)\n700|\t\t}\n701|\t\tif major == ProtocolMajor {\n702|\t\t\tt.Fatalf(\"parseMajor(%q) aliased to native major %d\", version, major)\n703|\t\t}\n704|\t\t_, err := DecodeResponse(armVersionFrame(version), want)\n705|\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n706|\t\t\tt.Fatalf(\"DecodeResponse(%q) code = %v, want incompatible_protocol\", version, err)\n707|\t\t}\n708|\t\tif failureExit(t, err) != 6 {\n709|\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 6\", version, failureExit(t, err))\n710|\t\t}\n711|\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != version {\n712|\t\t\tt.Fatalf(\"DecodeResponse(%q) observed = %v, want the foreign version\", version, observed)\n713|\t\t}\n714|\t}\n715|}\n716|\n717|// TestParseMajorDigitBoundariesRefuseAtEntry proves the digit-range arms at\n718|// their exact edges, through the production entry point DecodeResponse.\n719|// The major arm computes `digit < '0' || digit > '9'` and the rest arm\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
