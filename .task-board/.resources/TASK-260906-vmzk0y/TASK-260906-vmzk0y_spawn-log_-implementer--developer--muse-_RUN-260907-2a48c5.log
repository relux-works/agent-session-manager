{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3bf","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":58,"recorded_at":1780531400000111,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"c3eb0326-f9ba-4c99-b925-88046786145b"},"task_id":"c3eb0326-f9ba-4c99-b925-88046786145b","event":{"kind":"output","task_id":"c3eb0326-f9ba-4c99-b925-88046786145b","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"math\"\n20|\t\"os\"\n21|\t\"path/filepath\"\n22|\t\"regexp\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"sync\"\n26|\t\"unicode/utf8\"\n27|\n28|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n29|)\n30|\n31|// Wire error codes are the exact Section 15.3 codes the registry may report.\n32|// They are a subset of the pinned catalog error vocabulary; no other code is\n33|// emitted by this package.\n34|const (\n35|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n36|\t// read is never absence: callers must not treat this as \"no backend\".\n37|\tCodeNotFound = \"terminal_backend_not_found\"\n38|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n39|\t// an identical record is still refused: identity registration is not\n40|\t// idempotent.\n41|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n42|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n43|\t// external executable. Trust is established before any probe.\n44|\tCodeUntrusted = \"terminal_backend_untrusted\"\n45|\t// CodeDrift reports a re-registration whose version tuple, kind,\n46|\t// platforms, or executable digest differs from the admitted record.\n47|\tCodeDrift = \"terminal_backend_implementation_drift\"\n48|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n49|\t// default for the exact prior binding on restore or resume.\n50|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n51|\t// CodeStaleGeneration reports a generation that is out of bound or does\n52|\t// not match the validated binding.\n53|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n54|)\n55|\n56|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n57|// no third-party registration may use it.\n58|const (\n59|\tBuiltinTmux   = \"ax.tmux\"\n60|\tBuiltinConpty = \"ax.conpty\"\n61|)\n62|\n63|// reservedNamespace is the only namespace this implementation may mint.\n64|const reservedNamespace = \"ax.\"\n65|\n66|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n67|const maxIDBytes = 128\n68|\n69|// maxGenerationRunes is the Section 4.B/7.A bound: string[1..256] counts\n70|// UTF-8 characters (SPEC.md:321), not bytes; terminal_backend_id is the\n71|// only member of this package still bounded in ASCII bytes.\n72|const maxGenerationRunes = 256\n73|\n74|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n75|const maxProtocolVersions = 32\n76|\n77|var (\n78|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n79|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n80|\t// grammar the canonical and config packages enforce for the same members.\n81|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n82|)\n83|\n84|// Error is a registry refusal. Code is always one of the Code* constants;\n85|// BackendID names the identity at issue when there is one. Detail is a static\n86|// clause: it never echoes paths, digests, generations, or other local data.\n87|type Error struct {\n88|\tCode      string\n89|\tBackendID string\n90|\tDetail    string\n91|}\n92|\n93|func (err *Error) Error() string {\n94|\tif err.BackendID == \"\" {\n95|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n96|\t}\n97|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n98|}\n99|\n100|// errorCode reports whether err carries the given wire code.\n101|func errorCode(err error, code string) bool {\n102|\tvar refusal *Error\n103|\tif !errors.As(err, &refusal) {\n104|\t\treturn false\n105|\t}\n106|\treturn refusal.Code == code\n107|}\n108|\n109|// IsNotFound reports CodeNotFound refusals.\n110|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n111|\n112|// IsAmbiguous reports CodeAmbiguous refusals.\n113|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n114|\n115|// IsUntrusted reports CodeUntrusted refusals.\n116|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n117|\n118|// IsDrift reports CodeDrift refusals.\n119|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n120|\n121|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n122|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n123|\n124|// IsStaleGeneration reports CodeStaleGeneration refusals.\n125|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n126|\n127|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n128|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n129|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n130|// is refused so a third party cannot mint a trusted-looking identity.\n131|func ParseID(value string) (string, error) {\n132|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n133|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"}\n134|\t}\n135|\tif !idPattern.MatchString(value) {\n136|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id grammar\"}\n137|\t}\n138|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n139|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"}\n140|\t}\n141|\treturn value, nil\n142|}\n143|\n144|// mustParseID is the internal admission used where the caller already holds a\n145|// validated record. It duplicates the ParseID rule so a Registry can never\n146|// hold an identity its own grammar refuses.\n147|func mustParseID(value string) error {\n148|\t_, err := ParseID(value)\n149|\treturn err\n150|}\n151|\n152|// Kind is the Section 4.B implementation_kind vocabulary.\n153|type Kind string\n154|\n155|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n156|// as adapter executables over the Section 4.B argv/framing wire.\n157|const (\n158|\tKindBuiltinGo         Kind = \"builtin_go\"\n159|\tKindLocalProgram      Kind = \"local_program\"\n160|\tKindTrustedExecutable Kind = \"trusted_executable\"\n161|\tKindNativeRuntime     Kind = \"native_runtime\"\n162|)\n163|\n164|// parseKind admits exactly the closed Section 4.B vocabulary.\n165|func parseKind(value string) (Kind, error) {\n166|\tswitch Kind(value) {\n167|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n168|\t\treturn Kind(value), nil\n169|\tdefault:\n170|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"}\n171|\t}\n172|}\n173|\n174|// needsDigest reports whether the kind carries an executable digest. Section\n175|// 4.B: digest for local_program or trusted_executable; null otherwise.\n176|func needsDigest(kind Kind) bool {\n177|\treturn kind == KindLocalProgram || kind == KindTrustedExecutable\n178|}\n179|\n180|// Registration is one admitted backend identity with its exact version tuple,\n181|// platform set, and trust binding. It is the registry half of the Section 4.B\n182|// Manifest identity: the Manifest/Probe objects themselves belong to the\n183|// sibling manifest task.\n184|type Registration struct {\n185|\t// ID is the canonical terminal_backend_id.\n186|\tID string\n187|\t// Kind is the closed implementation_kind.\n188|\tKind Kind\n189|\t// ImplementationVersion is the exact admitted semver.\n190|\tImplementationVersion string\n191|\t// ProtocolVersions are the sorted unique semver members in Terminal\n192|\t// Backend Protocol major 1.\n193|\tProtocolVersions []string\n194|\t// Platforms is the sorted unique non-empty platform subset.\n195|\tPlatforms []scalar.Platform\n196|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n197|\t// (null) for built-in kinds.\n198|\tExecutableDigest string\n199|}\n200|\n201|// validate enforces every closed Section 4.B/6.5 rule on one record.\n202|func (record Registration) validate() error {\n203|\tif err := mustParseID(record.ID); err != nil {\n204|\t\treturn err\n205|\t}\n206|\tif _, err := parseKind(string(record.Kind)); err != nil {\n207|\t\treturn err\n208|\t}\n209|\tif !semverPattern.MatchString(record.ImplementationVersion) {\n210|\t\treturn &Error{Code: CodeDrift, BackendID: record.ID, Detail: \"implementation_version semver\"}\n211|\t}\n212|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n213|\t\treturn err\n214|\t}\n215|\tif err := validatePlatforms(record.Platforms); err != nil {\n216|\t\treturn &Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()}\n217|\t}\n218|\tif needsDigest(record.Kind) {\n219|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n220|\t\t\treturn &Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"}\n221|\t\t}\n222|\t} else if record.ExecutableDigest != \"\" {\n223|\t\treturn &Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"}\n224|\t}\n225|\treturn nil\n226|}\n227|\n228|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n229|// Terminal Backend Protocol major 1.\n230|func validateProtocolVersions(backendID string, versions []string) error {\n231|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n232|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"}\n233|\t}\n234|\tfor index, version := range versions {\n235|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n236|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"}\n237|\t\t}\n238|\t\tif index > 0 && versions[index-1] >= version {\n239|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"}\n240|\t\t}\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|// semverMajor returns the major number of a validated semver string.\n246|// A major that does not fit an int saturates instead of wrapping, so a\n247|// huge foreign major compares foreign at every != 1 call site rather\n248|// than aliasing a small native one (18446744073709551617 must not read\n249|// as 1). Saturation preserves every comparison against the small\n250|// constants the call sites use, in the correct direction.\n251|func semverMajor(version string) int {\n252|\tmajor := 0\n253|\tfor i := 0; i < len(version); i++ {\n254|\t\tif version[i] == '.' {\n255|\t\t\tbreak\n256|\t\t}\n257|\t\tdigit := int(version[i] - '0')\n258|\t\tif major > (math.MaxInt-digit)/10 {\n259|\t\t\treturn math.MaxInt\n260|\t\t}\n261|\t\tmajor = major*10 + digit\n262|\t}\n263|\treturn major\n264|}\n265|\n266|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n267|// macos|linux|wsl2|windows vocabulary.\n268|func validatePlatforms(platforms []scalar.Platform) error {\n269|\tif len(platforms) == 0 || len(platforms) > 4 {\n270|\t\treturn errors.New(\"platforms bound\")\n271|\t}\n272|\tprevious := \"\"\n273|\tfor _, platform := range platforms {\n274|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n275|\t\t\treturn errors.New(\"platforms vocabulary\")\n276|\t\t}\n277|\t\tif previous >= platform.String() {\n278|\t\t\treturn errors.New(\"platforms sorted unique\")\n279|\t\t}\n280|\t\tprevious = platform.String()\n281|\t}\n282|\treturn nil\n283|}\n284|\n285|// cloneStrings deep-copies a version list so the registry never shares a\n286|// backing array with its caller. Registration carries slices; a struct copy\n287|// duplicates only the header, so every ingress and egress point must clone.\n288|func cloneStrings(values []string) []string {\n289|\tif values == nil {\n290|\t\treturn nil\n291|\t}\n292|\tcloned := make([]string, len(values))\n293|\tcopy(cloned, values)\n294|\treturn cloned\n295|}\n296|\n297|// clonePlatforms deep-copies a platform set for the same reason as\n298|// cloneStrings: without it a caller holding a resolved record keeps a live\n299|// handle on admitted registry state and can convert drift into a duplicate.\n300|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n301|\tif values == nil {\n302|\t\treturn nil\n303|\t}\n304|\tcloned := make([]scalar.Platform, len(values))\n305|\tcopy(cloned, values)\n306|\treturn cloned\n307|}\n308|\n309|// cloneRecord deep-copies every slice member of a record.\n310|func cloneRecord(record Registration) Registration {\n311|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n312|\trecord.Platforms = clonePlatforms(record.Platforms)\n313|\treturn record\n314|}\n315|\n316|// equalRecord reports whether two validated records are member-for-member\n317|// identical. Any difference is drift, never a compatible update.\n318|func equalRecord(left, right Registration) bool {\n319|\tif left.ID != right.ID || left.Kind != right.Kind ||\n320|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n321|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n322|\t\treturn false\n323|\t}\n324|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n325|\t\treturn false\n326|\t}\n327|\tfor i := range left.ProtocolVersions {\n328|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n329|\t\t\treturn false\n330|\t\t}\n331|\t}\n332|\tif len(left.Platforms) != len(right.Platforms) {\n333|\t\treturn false\n334|\t}\n335|\tfor i := range left.Platforms {\n336|\t\tif left.Platforms[i] != right.Platforms[i] {\n337|\t\t\treturn false\n338|\t\t}\n339|\t}\n340|\treturn true\n341|}\n342|\n343|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n344|// backend ID, an absolute executable path, an executable digest, and enabled.\n345|type TrustEntry struct {\n346|\tBackendID        string\n347|\tExecutablePath   string\n348|\tExecutableDigest string\n349|\tEnabled          bool\n350|}\n351|\n352|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n353|// reserved-namespace bar (third parties use a vendor-owned namespace),\n354|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n355|// A disabled entry is not an error here; registration treats it as untrusted.\n356|func (entry TrustEntry) validate(platform scalar.Platform) error {\n357|\tif err := mustParseID(entry.BackendID); err != nil {\n358|\t\treturn err\n359|\t}\n360|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n361|\t\treturn &Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"}\n362|\t}\n363|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n364|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"}\n365|\t}\n366|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n367|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"}\n368|\t}\n369|\treturn nil\n370|}\n371|\n372|// Registry is the process-local TerminalBackend registry. It opens with the\n373|// two canonical built-ins admitted and accepts external adapters only through\n374|// RegisterExternal with a validated trust entry. The zero value is unusable;\n375|// construct with New.\n376|type Registry struct {\n377|\tmutex   sync.RWMutex\n378|\trecords map[string]Registration\n379|}\n380|\n381|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n382|// ax.conpty (windows) at the given implementation version with the given\n383|// Terminal Backend Protocol versions. Both are builtin_go without an\n384|// executable digest. Unknown members or a non-major-1 protocol list fail\n385|// before either built-in is admitted.\n386|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n387|\tif !semverPattern.MatchString(implementationVersion) {\n388|\t\treturn nil, &Error{Code: CodeDrift, Detail: \"implementation_version semver\"}\n389|\t}\n390|\tprotocols := append([]string(nil), protocolVersions...)\n391|\tsort.Strings(protocols)\n392|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n393|\t\treturn nil, err\n394|\t}\n395|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n396|\tbuiltins := []Registration{\n397|\t\t{\n398|\t\t\tID:                    BuiltinTmux,\n399|\t\t\tKind:                  KindBuiltinGo,\n400|\t\t\tImplementationVersion: implementationVersion,\n401|\t\t\t// Each built-in gets its own copy so the two admitted records\n402|\t\t\t// never alias each other. This is defence-in-depth, not a\n403|\t\t\t// bypass fix: callers only ever see egress clones (Resolve\n404|\t\t\t// clones, RegisterExternal clones on ingress, IDs returns\n405|\t\t\t// strings), so no exported path can reach these arrays.\n406|\t\t\tProtocolVersions: cloneStrings(protocols),\n407|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n408|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n409|\t\t},\n410|\t\t{\n411|\t\t\tID:                    BuiltinConpty,\n412|\t\t\tKind:                  KindBuiltinGo,\n413|\t\t\tImplementationVersion: implementationVersion,\n414|\t\t\tProtocolVersions:      cloneStrings(protocols),\n415|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n416|\t\t},\n417|\t}\n418|\tfor _, record := range builtins {\n419|\t\tif err := record.validate(); err != nil {\n420|\t\t\treturn nil, err\n421|\t\t}\n422|\t\tregistry.records[record.ID] = record\n423|\t}\n424|\treturn registry, nil\n425|}\n426|\n427|// RegisterExternal admits one external adapter (§4.B discovery before\n428|// activation, §6.5 trust). The trust entry must be enabled and name an\n429|// absolute executable whose digest exactly equals the observed record digest;\n430|// a mismatch fails before any probe. The observed record must use an external\n431|// kind, carry the same ID, and pass full record validation. Registering an\n432|// already-known ID fails closed: an identical record is CodeAmbiguous\n433|// (registration is not idempotent) and any difference is CodeDrift.\n434|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n435|\tif registry == nil {\n436|\t\treturn &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n437|\t}\n438|\tif err := entry.validate(platform); err != nil {\n439|\t\treturn err\n440|\t}\n441|\tif !entry.Enabled {\n442|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"}\n443|\t}\n444|\tif observed.ID != entry.BackendID {\n445|\t\treturn &Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"}\n446|\t}\n447|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n448|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"}\n449|\t}\n450|\tif err := observed.validate(); err != nil {\n451|\t\treturn err\n452|\t}\n453|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n454|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"}\n455|\t}\n456|\tregistry.mutex.Lock()\n457|\tdefer registry.mutex.Unlock()\n458|\texisting, known := registry.records[observed.ID]\n459|\tif !known {\n460|\t\t// Store a copy: the caller keeps its own record, and retaining\n461|\t\t// the slices verbatim would leave the admitted record mutable\n462|\t\t// without passing any gate.\n463|\t\tregistry.records[observed.ID] = cloneRecord(observed)\n464|\t\treturn nil\n465|\t}\n466|\tif equalRecord(existing, observed) {\n467|\t\treturn &Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \"duplicate backend_id\"}\n468|\t}\n469|\treturn &Error{Code: CodeDrift, BackendID: observed.ID, Detail: \"implementation drift\"}\n470|}\n471|\n472|// Resolve returns the admitted record for a canonical ID. An unknown,\n473|// malformed, or never-admitted ID is CodeNotFound: a registry read failure is\n474|// never absence, and callers must not fall back to a default.\n475|func (registry *Registry) Resolve(backendID string) (Registration, error) {\n476|\tif registry == nil {\n477|\t\treturn Registration{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n478|\t}\n479|\tid, err := ParseID(backendID)\n480|\tif err != nil {\n481|\t\treturn Registration{}, err\n482|\t}\n483|\tregistry.mutex.RLock()\n484|\tdefer registry.mutex.RUnlock()\n485|\trecord, known := registry.records[id]\n486|\tif !known {\n487|\t\treturn Registration{}, &Error{Code: CodeNotFound, BackendID: id, Detail: \"unregistered terminal_backend_id\"}\n488|\t}\n489|\t// Hand back a copy: the struct header copy shares the backing arrays,\n490|\t// so returning the stored record would hand out live interior state.\n491|\treturn cloneRecord(record), nil\n492|}\n493|\n494|// IDs returns the sorted admitted identities. It reports membership only,\n495|// never availability.\n496|func (registry *Registry) IDs() []string {\n497|\tif registry == nil {\n498|\t\treturn nil\n499|\t}\n500|\tregistry.mutex.RLock()\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3c1","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":59,"recorded_at":1780531400000113,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"c3eb0326-f9ba-4c99-b925-88046786145b"},"task_id":"c3eb0326-f9ba-4c99-b925-88046786145b","event":{"kind":"completed","task_id":"c3eb0326-f9ba-4c99-b925-88046786145b"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3c3","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":60,"recorded_at":1780531400000115,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"call_id":"call_01a0793a011d7e12a2d9fe082d1c29fd","text":"Read text file `internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"math\"\n20|\t\"os\"\n21|\t\"path/filepath\"\n22|\t\"regexp\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"sync\"\n26|\t\"unicode/utf8\"\n27|\n28|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n29|)\n30|\n31|// Wire error codes are the exact Section 15.3 codes the registry may report.\n32|// They are a subset of the pinned catalog error vocabulary; no other code is\n33|// emitted by this package.\n34|const (\n35|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n36|\t// read is never absence: callers must not treat this as \"no backend\".\n37|\tCodeNotFound = \"terminal_backend_not_found\"\n38|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n39|\t// an identical record is still refused: identity registration is not\n40|\t// idempotent.\n41|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n42|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n43|\t// external executable. Trust is established before any probe.\n44|\tCodeUntrusted = \"terminal_backend_untrusted\"\n45|\t// CodeDrift reports a re-registration whose version tuple, kind,\n46|\t// platforms, or executable digest differs from the admitted record.\n47|\tCodeDrift = \"terminal_backend_implementation_drift\"\n48|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n49|\t// default for the exact prior binding on restore or resume.\n50|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n51|\t// CodeStaleGeneration reports a generation that is out of bound or does\n52|\t// not match the validated binding.\n53|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n54|)\n55|\n56|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n57|// no third-party registration may use it.\n58|const (\n59|\tBuiltinTmux   = \"ax.tmux\"\n60|\tBuiltinConpty = \"ax.conpty\"\n61|)\n62|\n63|// reservedNamespace is the only namespace this implementation may mint.\n64|const reservedNamespace = \"ax.\"\n65|\n66|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n67|const maxIDBytes = 128\n68|\n69|// maxGenerationRunes is the Section 4.B/7.A bound: string[1..256] counts\n70|// UTF-8 characters (SPEC.md:321), not bytes; terminal_backend_id is the\n71|// only member of this package still bounded in ASCII bytes.\n72|const maxGenerationRunes = 256\n73|\n74|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n75|const maxProtocolVersions = 32\n76|\n77|var (\n78|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n79|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n80|\t// grammar the canonical and config packages enforce for the same members.\n81|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n82|)\n83|\n84|// Error is a registry refusal. Code is always one of the Code* constants;\n85|// BackendID names the identity at issue when there is one. Detail is a static\n86|// clause: it never echoes paths, digests, generations, or other local data.\n87|type Error struct {\n88|\tCode      string\n89|\tBackendID string\n90|\tDetail    string\n91|}\n92|\n93|func (err *Error) Error() string {\n94|\tif err.BackendID == \"\" {\n95|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n96|\t}\n97|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n98|}\n99|\n100|// errorCode reports whether err carries the given wire code.\n101|func errorCode(err error, code string) bool {\n102|\tvar refusal *Error\n103|\tif !errors.As(err, &refusal) {\n104|\t\treturn false\n105|\t}\n106|\treturn refusal.Code == code\n107|}\n108|\n109|// IsNotFound reports CodeNotFound refusals.\n110|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n111|\n112|// IsAmbiguous reports CodeAmbiguous refusals.\n113|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n114|\n115|// IsUntrusted reports CodeUntrusted refusals.\n116|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n117|\n118|// IsDrift reports CodeDrift refusals.\n119|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n120|\n121|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n122|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n123|\n124|// IsStaleGeneration reports CodeStaleGeneration refusals.\n125|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n126|\n127|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n128|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n129|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n130|// is refused so a third party cannot mint a trusted-looking identity.\n131|func ParseID(value string) (string, error) {\n132|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n133|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"}\n134|\t}\n135|\tif !idPattern.MatchString(value) {\n136|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id grammar\"}\n137|\t}\n138|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n139|\t\treturn \"\", &Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"}\n140|\t}\n141|\treturn value, nil\n142|}\n143|\n144|// mustParseID is the internal admission used where the caller already holds a\n145|// validated record. It duplicates the ParseID rule so a Registry can never\n146|// hold an identity its own grammar refuses.\n147|func mustParseID(value string) error {\n148|\t_, err := ParseID(value)\n149|\treturn err\n150|}\n151|\n152|// Kind is the Section 4.B implementation_kind vocabulary.\n153|type Kind string\n154|\n155|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n156|// as adapter executables over the Section 4.B argv/framing wire.\n157|const (\n158|\tKindBuiltinGo         Kind = \"builtin_go\"\n159|\tKindLocalProgram      Kind = \"local_program\"\n160|\tKindTrustedExecutable Kind = \"trusted_executable\"\n161|\tKindNativeRuntime     Kind = \"native_runtime\"\n162|)\n163|\n164|// parseKind admits exactly the closed Section 4.B vocabulary.\n165|func parseKind(value string) (Kind, error) {\n166|\tswitch Kind(value) {\n167|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n168|\t\treturn Kind(value), nil\n169|\tdefault:\n170|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"}\n171|\t}\n172|}\n173|\n174|// needsDigest reports whether the kind carries an executable digest. Section\n175|// 4.B: digest for local_program or trusted_executable; null otherwise.\n176|func needsDigest(kind Kind) bool {\n177|\treturn kind == KindLocalProgram || kind == KindTrustedExecutable\n178|}\n179|\n180|// Registration is one admitted backend identity with its exact version tuple,\n181|// platform set, and trust binding. It is the registry half of the Section 4.B\n182|// Manifest identity: the Manifest/Probe objects themselves belong to the\n183|// sibling manifest task.\n184|type Registration struct {\n185|\t// ID is the canonical terminal_backend_id.\n186|\tID string\n187|\t// Kind is the closed implementation_kind.\n188|\tKind Kind\n189|\t// ImplementationVersion is the exact admitted semver.\n190|\tImplementationVersion string\n191|\t// ProtocolVersions are the sorted unique semver members in Terminal\n192|\t// Backend Protocol major 1.\n193|\tProtocolVersions []string\n194|\t// Platforms is the sorted unique non-empty platform subset.\n195|\tPlatforms []scalar.Platform\n196|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n197|\t// (null) for built-in kinds.\n198|\tExecutableDigest string\n199|}\n200|\n201|// validate enforces every closed Section 4.B/6.5 rule on one record.\n202|func (record Registration) validate() error {\n203|\tif err := mustParseID(record.ID); err != nil {\n204|\t\treturn err\n205|\t}\n206|\tif _, err := parseKind(string(record.Kind)); err != nil {\n207|\t\treturn err\n208|\t}\n209|\tif !semverPattern.MatchString(record.ImplementationVersion) {\n210|\t\treturn &Error{Code: CodeDrift, BackendID: record.ID, Detail: \"implementation_version semver\"}\n211|\t}\n212|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n213|\t\treturn err\n214|\t}\n215|\tif err := validatePlatforms(record.Platforms); err != nil {\n216|\t\treturn &Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()}\n217|\t}\n218|\tif needsDigest(record.Kind) {\n219|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n220|\t\t\treturn &Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"}\n221|\t\t}\n222|\t} else if record.ExecutableDigest != \"\" {\n223|\t\treturn &Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"}\n224|\t}\n225|\treturn nil\n226|}\n227|\n228|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n229|// Terminal Backend Protocol major 1.\n230|func validateProtocolVersions(backendID string, versions []string) error {\n231|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n232|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"}\n233|\t}\n234|\tfor index, version := range versions {\n235|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n236|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"}\n237|\t\t}\n238|\t\tif index > 0 && versions[index-1] >= version {\n239|\t\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"}\n240|\t\t}\n241|\t}\n242|\treturn nil\n243|}\n244|\n245|// semverMajor returns the major number of a validated semver string.\n246|// A major that does not fit an int saturates instead of wrapping, so a\n247|// huge foreign major compares foreign at every != 1 call site rather\n248|// than aliasing a small native one (18446744073709551617 must not read\n249|// as 1). Saturation preserves every comparison against the small\n250|// constants the call sites use, in the correct direction.\n251|func semverMajor(version string) int {\n252|\tmajor := 0\n253|\tfor i := 0; i < len(version); i++ {\n254|\t\tif version[i] == '.' {\n255|\t\t\tbreak\n256|\t\t}\n257|\t\tdigit := int(version[i] - '0')\n258|\t\tif major > (math.MaxInt-digit)/10 {\n259|\t\t\treturn math.MaxInt\n260|\t\t}\n261|\t\tmajor = major*10 + digit\n262|\t}\n263|\treturn major\n264|}\n265|\n266|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n267|// macos|linux|wsl2|windows vocabulary.\n268|func validatePlatforms(platforms []scalar.Platform) error {\n269|\tif len(platforms) == 0 || len(platforms) > 4 {\n270|\t\treturn errors.New(\"platforms bound\")\n271|\t}\n272|\tprevious := \"\"\n273|\tfor _, platform := range platforms {\n274|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n275|\t\t\treturn errors.New(\"platforms vocabulary\")\n276|\t\t}\n277|\t\tif previous >= platform.String() {\n278|\t\t\treturn errors.New(\"platforms sorted unique\")\n279|\t\t}\n280|\t\tprevious = platform.String()\n281|\t}\n282|\treturn nil\n283|}\n284|\n285|// cloneStrings deep-copies a version list so the registry never shares a\n286|// backing array with its caller. Registration carries slices; a struct copy\n287|// duplicates only the header, so every ingress and egress point must clone.\n288|func cloneStrings(values []string) []string {\n289|\tif values == nil {\n290|\t\treturn nil\n291|\t}\n292|\tcloned := make([]string, len(values))\n293|\tcopy(cloned, values)\n294|\treturn cloned\n295|}\n296|\n297|// clonePlatforms deep-copies a platform set for the same reason as\n298|// cloneStrings: without it a caller holding a resolved record keeps a live\n299|// handle on admitted registry state and can convert drift into a duplicate.\n300|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n301|\tif values == nil {\n302|\t\treturn nil\n303|\t}\n304|\tcloned := make([]scalar.Platform, len(values))\n305|\tcopy(cloned, values)\n306|\treturn cloned\n307|}\n308|\n309|// cloneRecord deep-copies every slice member of a record.\n310|func cloneRecord(record Registration) Registration {\n311|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n312|\trecord.Platforms = clonePlatforms(record.Platforms)\n313|\treturn record\n314|}\n315|\n316|// equalRecord reports whether two validated records are member-for-member\n317|// identical. Any difference is drift, never a compatible update.\n318|func equalRecord(left, right Registration) bool {\n319|\tif left.ID != right.ID || left.Kind != right.Kind ||\n320|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n321|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n322|\t\treturn false\n323|\t}\n324|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n325|\t\treturn false\n326|\t}\n327|\tfor i := range left.ProtocolVersions {\n328|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n329|\t\t\treturn false\n330|\t\t}\n331|\t}\n332|\tif len(left.Platforms) != len(right.Platforms) {\n333|\t\treturn false\n334|\t}\n335|\tfor i := range left.Platforms {\n336|\t\tif left.Platforms[i] != right.Platforms[i] {\n337|\t\t\treturn false\n338|\t\t}\n339|\t}\n340|\treturn true\n341|}\n342|\n343|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n344|// backend ID, an absolute executable path, an executable digest, and enabled.\n345|type TrustEntry struct {\n346|\tBackendID        string\n347|\tExecutablePath   string\n348|\tExecutableDigest string\n349|\tEnabled          bool\n350|}\n351|\n352|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n353|// reserved-namespace bar (third parties use a vendor-owned namespace),\n354|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n355|// A disabled entry is not an error here; registration treats it as untrusted.\n356|func (entry TrustEntry) validate(platform scalar.Platform) error {\n357|\tif err := mustParseID(entry.BackendID); err != nil {\n358|\t\treturn err\n359|\t}\n360|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n361|\t\treturn &Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"}\n362|\t}\n363|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n364|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"}\n365|\t}\n366|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n367|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"}\n368|\t}\n369|\treturn nil\n370|}\n371|\n372|// Registry is the process-local TerminalBackend registry. It opens with the\n373|// two canonical built-ins admitted and accepts external adapters only through\n374|// RegisterExternal with a validated trust entry. The zero value is unusable;\n375|// construct with New.\n376|type Registry struct {\n377|\tmutex   sync.RWMutex\n378|\trecords map[string]Registration\n379|}\n380|\n381|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n382|// ax.conpty (windows) at the given implementation version with the given\n383|// Terminal Backend Protocol versions. Both are builtin_go without an\n384|// executable digest. Unknown members or a non-major-1 protocol list fail\n385|// before either built-in is admitted.\n386|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n387|\tif !semverPattern.MatchString(implementationVersion) {\n388|\t\treturn nil, &Error{Code: CodeDrift, Detail: \"implementation_version semver\"}\n389|\t}\n390|\tprotocols := append([]string(nil), protocolVersions...)\n391|\tsort.Strings(protocols)\n392|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n393|\t\treturn nil, err\n394|\t}\n395|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n396|\tbuiltins := []Registration{\n397|\t\t{\n398|\t\t\tID:                    BuiltinTmux,\n399|\t\t\tKind:                  KindBuiltinGo,\n400|\t\t\tImplementationVersion: implementationVersion,\n401|\t\t\t// Each built-in gets its own copy so the two admitted records\n402|\t\t\t// never alias each other. This is defence-in-depth, not a\n403|\t\t\t// bypass fix: callers only ever see egress clones (Resolve\n404|\t\t\t// clones, RegisterExternal clones on ingress, IDs returns\n405|\t\t\t// strings), so no exported path can reach these arrays.\n406|\t\t\tProtocolVersions: cloneStrings(protocols),\n407|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n408|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n409|\t\t},\n410|\t\t{\n411|\t\t\tID:                    BuiltinConpty,\n412|\t\t\tKind:                  KindBuiltinGo,\n413|\t\t\tImplementationVersion: implementationVersion,\n414|\t\t\tProtocolVersions:      cloneStrings(protocols),\n415|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n416|\t\t},\n417|\t}\n418|\tfor _, record := range builtins {\n419|\t\tif err := record.validate(); err != nil {\n420|\t\t\treturn nil, err\n421|\t\t}\n422|\t\tregistry.records[record.ID] = record\n423|\t}\n424|\treturn registry, nil\n425|}\n426|\n427|// RegisterExternal admits one external adapter (§4.B discovery before\n428|// activation, §6.5 trust). The trust entry must be enabled and name an\n429|// absolute executable whose digest exactly equals the observed record digest;\n430|// a mismatch fails before any probe. The observed record must use an external\n431|// kind, carry the same ID, and pass full record validation. Registering an\n432|// already-known ID fails closed: an identical record is CodeAmbiguous\n433|// (registration is not idempotent) and any difference is CodeDrift.\n434|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n435|\tif registry == nil {\n436|\t\treturn &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n437|\t}\n438|\tif err := entry.validate(platform); err != nil {\n439|\t\treturn err\n440|\t}\n441|\tif !entry.Enabled {\n442|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"}\n443|\t}\n444|\tif observed.ID != entry.BackendID {\n445|\t\treturn &Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"}\n446|\t}\n447|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n448|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"}\n449|\t}\n450|\tif err := observed.validate(); err != nil {\n451|\t\treturn err\n452|\t}\n453|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n454|\t\treturn &Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"}\n455|\t}\n456|\tregistry.mutex.Lock()\n457|\tdefer registry.mutex.Unlock()\n458|\texisting, known := registry.records[observed.ID]\n459|\tif !known {\n460|\t\t// Store a copy: the caller keeps its own record, and retaining\n461|\t\t// the slices verbatim would leave the admitted record mutable\n462|\t\t// without passing any gate.\n463|\t\tregistry.records[observed.ID] = cloneRecord(observed)\n464|\t\treturn nil\n465|\t}\n466|\tif equalRecord(existing, observed) {\n467|\t\treturn &Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \"duplicate backend_id\"}\n468|\t}\n469|\treturn &Error{Code: CodeDrift, BackendID: observed.ID, Detail: \"implementation drift\"}\n470|}\n471|\n472|// Resolve returns the admitted record for a canonical ID. An unknown,\n473|// malformed, or never-admitted ID is CodeNotFound: a registry read failure is\n474|// never absence, and callers must not fall back to a default.\n475|func (registry *Registry) Resolve(backendID string) (Registration, error) {\n476|\tif registry == nil {\n477|\t\treturn Registration{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n478|\t}\n479|\tid, err := ParseID(backendID)\n480|\tif err != nil {\n481|\t\treturn Registration{}, err\n482|\t}\n483|\tregistry.mutex.RLock()\n484|\tdefer registry.mutex.RUnlock()\n485|\trecord, known := registry.records[id]\n486|\tif !known {\n487|\t\treturn Registration{}, &Error{Code: CodeNotFound, BackendID: id, Detail: \"unregistered terminal_backend_id\"}\n488|\t}\n489|\t// Hand back a copy: the struct header copy shares the backing arrays,\n490|\t// so returning the stored record would hand out live interior state.\n491|\treturn cloneRecord(record), nil\n492|}\n493|\n494|// IDs returns the sorted admitted identities. It reports membership only,\n495|// never availability.\n496|func (registry *Registry) IDs() []string {\n497|\tif registry == nil {\n498|\t\treturn nil\n499|\t}\n500|\tregistry.mutex.RLock()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
