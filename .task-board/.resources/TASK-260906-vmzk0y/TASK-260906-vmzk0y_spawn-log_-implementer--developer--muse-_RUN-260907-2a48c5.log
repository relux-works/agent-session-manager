{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c769","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":527,"recorded_at":1780531400001049,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"2442154f-de8d-464e-a800-d144fc2edb11"},"task_id":"2442154f-de8d-464e-a800-d144fc2edb11","event":{"kind":"output","task_id":"2442154f-de8d-464e-a800-d144fc2edb11","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board/.resources/TASK-260906-vmzk0y/TASK-260906-vmzk0y_review-rev4-battery.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer rev4 mutation harness: apply one mutant to a scratch copy of the\n3|candidate tree, run a bounded go test invocation as a standalone process, and\n4|restore the file byte-identically (SHA-256 asserted).\"\"\"\n5|import hashlib, json, os, re, subprocess, sys\n6|\n7|ROOT = os.environ.get(\"MUT_ROOT\", \"/tmp/vmzk0y-rev4-mut\")\n8|\n9|def sha(p):\n10|    with open(p, \"rb\") as f:\n11|        return hashlib.sha256(f.read()).hexdigest()\n12|\n13|def run(pkg, mask, timeout=900):\n14|    cmd = [\"go\", \"test\", pkg, \"-count=1\", \"-v\"]\n15|    if mask:\n16|        cmd += [\"-run\", mask]\n17|    p = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=timeout)\n18|    out = p.stdout + p.stderr\n19|    fails = sorted(set(re.findall(r\"^\\s*--- FAIL: (\\S+)\", out, re.M)))\n20|    passes = len(re.findall(r\"^\\s*--- PASS:\", out, re.M))\n21|    runs = len(re.findall(r\"^=== RUN\", out, re.M))\n22|    return {\"exit\": p.returncode, \"fails\": fails, \"pass_lines\": passes, \"run_lines\": runs,\n23|            \"build_error\": (\"build failed\" in out or \"cannot use\" in out or \"undefined:\" in out\n24|                            or \"[build failed]\" in out or \"syntax error\" in out)}\n25|\n26|def mutate(path, old, new, occurrence=1):\n27|    full = os.path.join(ROOT, path)\n28|    before = sha(full)\n29|    src = open(full).read()\n30|    n = src.count(old)\n31|    if n != occurrence:\n32|        return None, before, n\n33|    open(full, \"w\").write(src.replace(old, new, 1))\n34|    return full, before, n\n35|\n36|def restore(full, before, path):\n37|    orig = subprocess.run([\"git\", \"show\", f\"6c8e29de0765747dc93c8565a756a888c6609ca6:{path}\"],\n38|                          cwd=os.environ.get(\"REPO\", os.getcwd()), capture_output=True)\n39|    open(full, \"wb\").write(orig.stdout)\n40|    after = sha(full)\n41|    assert after == before, f\"RESTORE MISMATCH {path}: {before} != {after}\"\n42|\n43|def main():\n44|    spec = json.load(open(sys.argv[1]))\n45|    results = []\n46|    for m in spec:\n47|        path, old, new = m[\"file\"], m[\"old\"], m[\"new\"]\n48|        full, before, n = mutate(path, old, new)\n49|        row = {\"id\": m[\"id\"], \"file\": path, \"anchor_sites\": n}\n50|        if full is None:\n51|            row[\"disposition\"] = \"NOT_APPLIED\"\n52|            row[\"reason\"] = f\"anchor occurs {n} times, want 1\"\n53|            results.append(row)\n54|            print(json.dumps(row)); continue\n55|        try:\n56|            for r in m[\"runs\"]:\n57|                res = run(r[\"pkg\"], r.get(\"mask\"))\n58|                row[r[\"name\"]] = res\n59|        finally:\n60|            restore(full, before, path)\n61|        compile_fail = any(v.get(\"build_error\") for k, v in row.items() if isinstance(v, dict))\n62|        killed = any(v.get(\"exit\", 0) != 0 for k, v in row.items() if isinstance(v, dict))\n63|        row[\"disposition\"] = \"COMPILE_FAIL\" if compile_fail else (\"KILLED\" if killed else \"SURVIVED\")\n64|        results.append(row)\n65|        print(json.dumps(row))\n66|    json.dump(results, open(sys.argv[2], \"w\"), indent=1)\n67|    print(\"ALL RESTORED\")\n68|\n69|main()"}}}
