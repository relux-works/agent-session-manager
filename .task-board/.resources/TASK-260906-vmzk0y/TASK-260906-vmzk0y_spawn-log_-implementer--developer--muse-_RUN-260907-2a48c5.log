{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cb","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":192,"recorded_at":1780531400000379,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"95dac38e-b5c5-4799-a2a8-7cec613f473b"},"task_id":"95dac38e-b5c5-4799-a2a8-7cec613f473b","event":{"kind":"output","task_id":"95dac38e-b5c5-4799-a2a8-7cec613f473b","chunk":"Read text file `internal/provhost/protocol.go`.\n(339 line(s) above)\n340|\t\tif _, forbidden := members[\"error\"]; forbidden {\n341|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n342|\t\t}\n343|\t} else {\n344|\t\tif _, present := members[\"error\"]; !present {\n345|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n346|\t\t}\n347|\t\tif _, forbidden := members[\"body\"]; forbidden {\n348|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n349|\t\t}\n350|\t}\n351|\tfor name := range members {\n352|\t\tif !responseMembers[name] {\n353|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n354|\t\t}\n355|\t}\n356|\treturn nil\n357|}\n358|\n359|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n360|// Anything else is not a recognizable major, so the frame is unusable\n361|// rather than a mismatch. A major that does not fit an int saturates\n362|// instead of wrapping, but saturation never short-circuits the shape\n363|// check: only a fully numeric X.Y.Z reports a recognized major. An\n364|// all-numeric giant is observably foreign (it is not 2), so it takes\n365|// the mismatch arm, never aliases a small native major\n366|// (18446744073709551618 must not read as 2) and never slides to the\n367|// unusable-frame arm; a giant with a non-numeric or empty rest\n368|// (99999999999999999999.abc.def) is unrecognized like any other\n369|// malformed version. Saturation adds no rejection branch, so the\n370|// derived parse-arm census needs no new row for it.\n371|func parseMajor(version string) (int, bool) {\n372|\tparts := strings.Split(version, \".\")\n373|\tif len(parts) != 3 {\n374|\t\treturn 0, false\n375|\t}\n376|\tmajor := 0\n377|\tfor i := 0; i < len(parts[0]); i++ {\n378|\t\tdigit := parts[0][i]\n379|\t\tif digit < '0' || digit > '9' {\n380|\t\t\treturn 0, false\n381|\t\t}\n382|\t\tstep := int(digit - '0')\n383|\t\tif major > (math.MaxInt-step)/10 {\n384|\t\t\tmajor = math.MaxInt\n385|\t\t\tcontinue\n386|\t\t}\n387|\t\tmajor = major*10 + step\n388|\t}\n389|\tif len(parts[0]) == 0 {\n390|\t\treturn 0, false\n391|\t}\n392|\tfor _, rest := range parts[1:] {\n393|\t\tif len(rest) == 0 {\n394|\t\t\treturn 0, false\n395|\t\t}\n396|\t\tfor i := 0; i < len(rest); i++ {\n397|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n398|\t\t\t\treturn 0, false\n399|\t\t\t}\n400|\t\t}\n401|\t}\n402|\treturn major, true\n403|}\n404|\n405|// DecodeResponse validates one stdout line as the single response frame\n406|// for the request carrying wantRequestID. It returns the success body, or\n407|// the bound child failure, or a local failure that trusts nothing from\n408|// the frame. A recognizable foreign major yields incompatible_protocol;\n409|// every other unusable frame yields provider_protocol_error.\n410|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n411|\tif len(frame) > MaxFrameBytes {\n412|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n413|\t\tif err != nil {\n414|\t\t\treturn Response{}, err\n415|\t\t}\n416|\t\treturn Response{}, failure\n417|\t}\n418|\tif !utf8.Valid(frame) {\n419|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n420|\t\tif err != nil {\n421|\t\t\treturn Response{}, err\n422|\t\t}\n423|\t\treturn Response{}, failure\n424|\t}\n425|\tmembers, fault := decodeStrictObject(frame)\n426|\tif fault != nil {\n427|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n428|\t\tif err != nil {\n429|\t\t\treturn Response{}, err\n430|\t\t}\n431|\t\treturn Response{}, failure\n432|\t}\n433|\t// foreignMajor peeks at the envelope identity before any v2\n434|\t// member rule runs. A recognizable foreign major is\n435|\t// incompatible_protocol no matter what members it carries, so\n436|\t// the v2 member vocabulary below must not judge it first: a\n437|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n438|\t// is a foreign major, not an unknown or missing member. The\n439|\t// peek trusts nothing and refuses nothing: it only arms when\n440|\t// the protocol member is exactly this protocol and the version\n441|\t// member is a string with a recognizable foreign major. A frame\n442|\t// without our protocol identity, or without a readable version,\n443|\t// falls through to the member rules, which keep their verdicts.\n444|\tforeignMajor := \"\"\n445|\tif rawProtocol, present := members[\"protocol\"]; present {\n446|\t\tvar protocol string\n447|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n448|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n449|\t\t\t\tvar version string\n450|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n451|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n452|\t\t\t\t\t\tforeignMajor = version\n453|\t\t\t\t\t}\n454|\t\t\t\t}\n455|\t\t\t}\n456|\t\t}\n457|\t}\n458|\tvar ok bool\n459|\tif foreignMajor == \"\" {\n(more lines below)"}}}
