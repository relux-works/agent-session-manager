{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c539","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":247,"recorded_at":1780531400000489,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"da248fc9-e8a4-4306-8b93-69f27360b586"},"task_id":"da248fc9-e8a4-4306-8b93-69f27360b586","event":{"kind":"output","task_id":"da248fc9-e8a4-4306-8b93-69f27360b586","chunk":"Read text file `internal/provhost/protocol_test.go`.\n(716 line(s) above)\n717|// TestParseMajorDigitBoundariesRefuseAtEntry proves the digit-range arms at\n718|// their exact edges, through the production entry point DecodeResponse.\n719|// The major arm computes `digit < '0' || digit > '9'` and the rest arm\n720|// computes `rest[i] < '0' || rest[i] > '9'`; the two characters adjacent to\n721|// that range are '/' (0x2F, one below '0') and ':' (0x3A, one above '9').\n722|// A narrowing that admits exactly one of them — by editing the bound to\n723|// `rest[i] < '/'` or `digit > ':'`, or by inserting `if digit == ':' {\n724|// continue }` / `if rest[i] == '/' { continue }` above the unchanged\n725|// condition (condition text preserved, so the source-text census stays\n726|// byte-identical) — migrates these rows from provider_protocol_error exit 13\n727|// to incompatible_protocol exit 6, and must redden here rather than only in\n728|// the inventory bijection. Rows cover '/' and ':' in the major and in each\n729|// rest position (minor and patch), plus the leading single-character majors,\n730|// so the fix is verified one step away from any single finding vector. The\n731|// correlating controls ('a.0.0' major-letter, '3.b.c' rest-letter) stay\n732|// refused under every such mutant and are covered by the existing corpus.\n733|func TestParseMajorDigitBoundariesRefuseAtEntry(t *testing.T) {\n734|\twant := mustUUIDv7(t, testRequestID)\n735|\tfor _, version := range []string{\n736|\t\t\"3/.0.0\",\n737|\t\t\"/.0.0\",\n738|\t\t\"3:.0.0\",\n739|\t\t\":.0.0\",\n740|\t\t\"3./.0\",\n741|\t\t\"3.0./\",\n742|\t\t\"3.:.0\",\n743|\t\t\"3.0.:\",\n744|\t} {\n745|\t\tif major, recognized := parseMajor(version); recognized {\n746|\t\t\tt.Fatalf(\"parseMajor(%q) = (%d, true), want unrecognized\", version, major)\n747|\t\t}\n748|\t\t_, err := DecodeResponse(armVersionFrame(version), want)\n749|\t\tif failureCode(t, err) != \"provider_protocol_error\" {\n750|\t\t\tt.Fatalf(\"DecodeResponse(%q) code = %v, want provider_protocol_error\", version, err)\n751|\t\t}\n752|\t\tif failureExit(t, err) != 13 {\n753|\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n754|\t\t}\n755|\t\trequireFrameRefusal(t, err, \"protocol_version\", \"unsupported protocol version\")\n756|\t}\n757|}\n758|\n759|// TestDecodeResponseUnrecognizedVersionRunsMemberRules proves the foreignMajor\n760|// peek arms only on recognizable foreign majors: a bare frame (protocol,\n761|// protocol_version, request_id, body — no `ok`) carrying an unrecognized\n762|// version still runs the v2 member-vocabulary check and reports the missing\n763|// `ok` member, rather than skipping to the version gate. Widening the peek\n764|// predicate from `recognized && major != ProtocolMajor` to `recognized ||\n765|// major != ProtocolMajor` arms it for unrecognized versions too, sliding this\n766|// row from member `ok` / `missing member` to member `protocol_version` /\n767|// `unsupported protocol version` with code and exit unchanged. That slide is\n768|// a detail-level weakening outside the F1 delta, pinned here so a future\n769|// widening reddens behaviourally. The production entry point is\n770|// DecodeResponse.\n771|func TestDecodeResponseUnrecognizedVersionRunsMemberRules(t *testing.T) {\n772|\twant := mustUUIDv7(t, testRequestID)\n773|\tfor _, version := range []string{\n774|\t\t\"2.abc.def\",\n775|\t\t\"99999999999999999999.abc.def\",\n776|\t} {\n777|\t\tif _, recognized := parseMajor(version); recognized {\n778|\t\t\tt.Fatalf(\"parseMajor(%q) = recognized, want unrecognized for the peek control\", version)\n779|\t\t}\n780|\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"body\":{}}`)\n781|\t\t_, err := DecodeResponse(frame, want)\n782|\t\trequireFrameRefusal(t, err, \"ok\", \"missing member\")\n783|\t\tif failureExit(t, err) != 13 {\n784|\t\t\tt.Fatalf(\"DecodeResponse(%q) exit = %d, want 13\", version, failureExit(t, err))\n785|\t\t}\n786|\t}\n787|}"}}}
