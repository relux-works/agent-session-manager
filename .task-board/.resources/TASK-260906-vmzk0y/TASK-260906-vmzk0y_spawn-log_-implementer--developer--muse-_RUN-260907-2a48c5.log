 {\n398|\t\treturn nil, mismatchf(\"document trailing data\")\n399|\t}\n400|\tobject, ok := value.(map[string]any)\n401|\tif !ok {\n402|\t\treturn nil, mismatchf(\"document shape\")\n403|\t}\n404|\treturn object, nil\n405|}\n406|\n407|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n408|// bound is far above the deepest legitimate nesting (object, claims array,\n409|// claim object, member array) and fails closed below any decoder-stack risk.\n410|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n411|\tif depth > maxJSONDepth {\n412|\t\treturn nil, mismatchf(\"document nesting\")\n413|\t}\n414|\ttoken, err := decoder.Token()\n415|\tif err != nil {\n416|\t\treturn nil, mismatchf(\"document syntax\")\n417|\t}\n418|\tif delimiter, ok := token.(json.Delim); ok {\n419|\t\tswitch delimiter {\n420|\t\tcase '{':\n421|\t\t\tobject := make(map[string]any)\n422|\t\t\tfor decoder.More() {\n423|\t\t\t\tkeyToken, err := decoder.Token()\n424|\t\t\t\tif err != nil {\n425|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n426|\t\t\t\t}\n427|\t\t\t\tkey, ok := keyToken.(string)\n428|\t\t\t\tif !ok {\n429|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n(more lines below)"}}}
