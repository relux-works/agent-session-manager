{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b5","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":309,"recorded_at":1780531400000613,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"7308b839-39cf-4ed5-a39a-2ae28c3266a6"},"task_id":"7308b839-39cf-4ed5-a39a-2ae28c3266a6","event":{"kind":"output","task_id":"7308b839-39cf-4ed5-a39a-2ae28c3266a6","chunk":"Read text file `internal/terminalbackend/terminalbackend_test.go`.\n(211 line(s) above)\n212|func TestNewRefusesBadVersionTuples(t *testing.T) {\n213|\tt.Parallel()\n214|\n215|\t// distinctMajorOneVersions builds count distinct Terminal Backend Protocol\n216|\t// major-1 versions in lexical order: 1.<minor>.<patch> with minor=i/10 and\n217|\t// patch=i%10 stays lexically sorted and unique below 100 members, so the\n218|\t// count bound is the only rule that can refuse the full list.\n219|\tdistinctMajorOneVersions := func(count int) []string {\n220|\t\tversions := make([]string, count)\n221|\t\tfor i := range versions {\n222|\t\t\tversions[i] = \"1.\" + strconv.Itoa(i/10) + \".\" + strconv.Itoa(i%10)\n223|\t\t}\n224|\t\treturn versions\n225|\t}\n226|\tcases := []struct {\n227|\t\tname      string\n228|\t\timpl      string\n229|\t\tprotocols []string\n230|\t}{\n231|\t\t{\"non-semver implementation\", \"v1\", []string{testProto}},\n232|\t\t{\"empty implementation\", \"\", []string{testProto}},\n233|\t\t{\"empty protocol list\", testImplVersion, nil},\n234|\t\t{\"protocol major 2\", testImplVersion, []string{\"2.0.0\"}},\n235|\t\t{\"protocol major 0\", testImplVersion, []string{\"0.9.0\"}},\n236|\t\t{\"non-semver protocol\", testImplVersion, []string{\"one\"}},\n237|\t\t{\"duplicate protocols\", testImplVersion, []string{testProto, testProto}},\n238|\t\t// 33 distinct sorted major-1 members: sorted-unique, semver, and\n239|\t\t// major rules all pass, so only the [1..32] count bound can refuse.\n240|\t\t// (33 identical entries would be refused by sorted-unique instead,\n241|\t\t// passing for the wrong reason.)\n242|\t\t{\"over 32 protocols\", testImplVersion, distinctMajorOneVersions(33)},\n243|\t}\n244|\t// 32 distinct members must still be admitted: the bound is 32, not 31.\n245|\t// New sorts its copy, so construct the list in reverse to prove the\n246|\t// admission does not depend on caller order.\n247|\treversed := distinctMajorOneVersions(32)\n248|\tfor left, right := 0, len(reversed)-1; left < right; left, right = left+1, right-1 {\n249|\t\treversed[left], reversed[right] = reversed[right], reversed[left]\n250|\t}\n251|\tif _, err := terminalbackend.New(testImplVersion, reversed); err != nil {\n252|\t\tt.Errorf(\"New(32 distinct protocols) error = %v, want admission\", err)\n253|\t}\n254|\tfor _, testCase := range cases {\n255|\t\tt.Run(testCase.name, func(t *testing.T) {\n256|\t\t\tt.Parallel()\n257|\t\t\tif _, err := terminalbackend.New(testCase.impl, testCase.protocols); !terminalbackend.IsDrift(err) {\n258|\t\t\t\tt.Errorf(\"New(%q, %v) error = %v, want terminal_backend_implementation_drift\", testCase.impl, testCase.protocols, err)\n259|\t\t\t}\n260|\t\t})\n261|\t}\n262|}\n263|\n264|// TestRegisterExternalRoundTrip drives the production external-admission\n265|// entry point: trust plus observed record in, resolvable registration out.\n266|func TestRegisterExternalRoundTrip(t *testing.T) {\n267|\tt.Parallel()\n268|\n269|\tregistry := testRegistry(t)\n270|\tmustRegisterExternal(t, registry, \"com.example.term\")\n271|\trecord, err := registry.Resolve(\"com.example.term\")\n272|\tif err != nil {\n273|\t\tt.Fatalf(\"Resolve() error = %v\", err)\n274|\t}\n275|\tif record.Kind != terminalbackend.KindTrustedExecutable || record.ExecutableDigest != testDigest {\n276|\t\tt.Errorf(\"resolved record = %+v, want trusted_executable with pinned digest\", record)\n277|\t}\n278|\tif got := registry.IDs(); len(got) != 3 {\n279|\t\tt.Errorf(\"IDs() = %v, want 3 admitted identities\", got)\n280|\t}\n281|}\n(more lines below)"}}}
