_test\\ninternal/terminalbackend/identity_ownership_test.go:88:// mustTerminalRoot returns the terminalbackend package directory: this file\\ninternal/terminalbackend/identity_ownership_test.go:803:// cross-package import.\\ninternal/terminalbackend/internal_pin_test.go:9:package terminalbackend\\ninternal/terminalbackend/internal_pin_test.go:12:// importable test dependency. canonicaljson now imports this package in\\ninternal/terminalbackend/internal_pin_test.go:279:// escapes outside the range admit. The cross-package agreement half of this\\ninternal/terminalbackend/internal_pin_test.go:282:// importing this package in production; this half keeps the branch-level\\ninternal/terminalbackend/manifest_pin_test.go:9:package terminalbackend\\n\",\n  \"original_output_bytes\": 1599,\n  \"original_output_tokens\": 400,\n  \"truncated\": false\n}"}}}
