{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a07939-d4d2-7553-8d6d-07967bfdd55f"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9ce0545c-46a3-414d-a8ed-c43a478642c3","run_stream":{"kind":"run","id":"9ce0545c-46a3-414d-a8ed-c43a478642c3"},"task_stream":{"kind":"task","id":"18603679-517f-439b-80eb-a4349c1b6f7a"},"task_id":"18603679-517f-439b-80eb-a4349c1b6f7a","event":{"kind":"output","task_id":"18603679-517f-439b-80eb-a4349c1b6f7a","chunk":"Read text file `internal/provhost/surrogate.go`.\n(89 line(s) above)\n90|\t\t}\n91|\t\t// The string never closed: malformed JSON the syntax arms\n92|\t\t// refuse, so the gate claims no surrogate verdict here.\n93|\t\treturn false\n94|\tstringComplete:\n95|\t}\n96|\treturn false\n97|}\n98|\n99|// readHexUnit parses one \\uXXXX escape at input[start]. It reports false\n100|// when the bytes are not a well-formed escape; hex digits parse in\n101|// either case, matching the shared package's ParseUint base-16 read.\n102|func readHexUnit(input []byte, start int) (uint16, int, bool) {\n103|\tif start < 0 || start+6 > len(input) || input[start] != '\\\\' || input[start+1] != 'u' {\n104|\t\treturn 0, start, false\n105|\t}\n106|\tvar value uint16\n107|\tfor _, b := range input[start+2 : start+6] {\n108|\t\tvar digit byte\n109|\t\tif b >= '0' && b <= '9' {\n110|\t\t\tdigit = b - '0'\n111|\t\t} else if b >= 'a' && b <= 'f' {\n112|\t\t\tdigit = b - 'a' + 10\n113|\t\t} else if b >= 'A' && b <= 'F' {\n114|\t\t\tdigit = b - 'A' + 10\n115|\t\t} else {\n116|\t\t\treturn 0, start, false\n117|\t\t}\n118|\t\tvalue = value*16 + uint16(digit)\n119|\t}\n120|\treturn value, start + 6, true\n121|}"}}}
