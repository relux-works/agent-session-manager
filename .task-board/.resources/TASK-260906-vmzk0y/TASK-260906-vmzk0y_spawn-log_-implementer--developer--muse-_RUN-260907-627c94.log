{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c635","stream":{"kind":"session","id":"01a07962-00f2-7aa3-bdba-fd54caa2b073"},"sequence":373,"recorded_at":1780531400000741,"record_type":"event","durability":"durable","causation_id":"0e106057-555a-4629-8228-1b6dea88eaef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0e106057-555a-4629-8228-1b6dea88eaef","run_stream":{"kind":"run","id":"0e106057-555a-4629-8228-1b6dea88eaef"},"task_stream":{"kind":"task","id":"7a4f1568-9246-4945-809a-94eed36fab62"},"task_id":"7a4f1568-9246-4945-809a-94eed36fab62","event":{"kind":"output","task_id":"7a4f1568-9246-4945-809a-94eed36fab62","chunk":"Read text file `.temp/TASK-260906-vmzk0y/mut_round4.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Round-4 mutation battery for TASK-260906-vmzk0y.\n3|\n4|Covers the 9 version-classification obligations reachable from\n5|DecodeResponse (P1,P2,P3,P4,P5,P6,C1,K1,V1) with narrowing, arm-deletion\n6|and census-only classes split, plus the four token-preserving narrowings\n7|(P2 ':' and '/' in major, P6 '/' and ':' in rest) that leave the\n8|source-text census byte-identical.\n9|\n10|Each mutant is applied to a pristine copy of the target file, `go test\n11|./internal/provhost/ -count=1` is run as a standalone process (exit code\n12|preserved, no pipe chain), and the file is restored byte-identically\n13|afterwards (SHA-256 asserted). Results go to\n14|.temp/TASK-260906-vmzk0y/battery-round4.json.\n15|\"\"\"\n16|import hashlib\n17|import json\n18|import os\n19|import shutil\n20|import subprocess\n21|import sys\n22|\n23|ROOT = os.getcwd()\n24|PROTO = \"internal/provhost/protocol.go\"\n25|INV = \"internal/provhost/refusal_arm_inventory_test.go\"\n26|BACKUP = \".temp/TASK-260906-vmzk0y\"\n27|\n28|TARGETS = {PROTO: os.path.join(BACKUP, \"protocol.go.round4pristine\"),\n29|           INV: os.path.join(BACKUP, \"inventory_test.go.round4pristine\")}\n30|\n31|for path, pristine in TARGETS.items():\n32|    shutil.copyfile(path, pristine)\n33|\n34|\n35|def sha(path):\n36|    return hashlib.sha256(open(path, \"rb\").read()).hexdigest()\n37|\n38|\n39|PRISTINE_SHA = {p: sha(p) for p in TARGETS}\n40|\n41|PEEK_OLD = \"\\t\\t\\t\\t\\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\"\n42|GATE_OLD = (\"if version != ProtocolVersion {\\n\"\n43|            \"\\t\\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\")\n44|\n45|MUTANTS = [\n46|    (\"M1\", \"narrowing\", PROTO,\n47|     \"\\t\\t\\tmajor = math.MaxInt\\n\\t\\t\\tcontinue\\n\",\n48|     \"\\t\\t\\treturn math.MaxInt, true\\n\",\n49|     \"P3: round-2 early-return shape; giant-with-malformed-rest reads recognized\"),\n50|    (\"M2\", \"narrowing\", PROTO,\n51|     \"if major > (math.MaxInt-step)/10 {\",\n52|     \"if major > math.MaxInt {\",\n53|     \"P3: guard never fires; accumulation wraps again (delete-shaped narrowing)\"),\n54|    (\"M3\", \"narrowing\", PROTO,\n55|     \"if major > (math.MaxInt-step)/10 {\",\n56|     \"if major > math.MaxInt/10 {\",\n57|     \"P3 TRUE NARROWING: threshold off-by-one (drops the step term)\"),\n58|    (\"M4\", \"narrowing\", PROTO,\n59|     \"\\t\\tif len(rest) == 0 {\",\n60|     \"\\t\\tif len(rest) < 0 {\",\n61|     \"P5: empty-rest arm never fires (token preserved)\"),\n62|    (\"M5\", \"narrowing\", PROTO,\n63|     \"\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n64|     \"\\t\\t\\tif rest[i] < '/' || rest[i] > '9' {\",\n65|     \"P6 condition-edit: rest admits exactly one rejected member ('/')\"),\n66|    (\"M6\", \"narrowing\", PROTO,\n67|     \"\\t\\tif digit < '0' || digit > '9' {\",\n68|     \"\\t\\tif digit < '0' || digit > ':' {\",\n69|     \"P2 condition-edit: major admits exactly one rejected member (':')\"),\n70|    (\"M5b\", \"narrowing\", PROTO,\n71|     \"\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n72|     \"\\t\\t\\tif rest[i] < '0' || rest[i] > ':' {\",\n73|     \"P6 condition-edit mirror: rest admits exactly one rejected member (':')\"),\n74|    (\"M6b\", \"narrowing\", PROTO,\n75|     \"\\t\\tif digit < '0' || digit > '9' {\",\n76|     \"\\t\\tif digit < '/' || digit > '9' {\",\n77|     \"P2 condition-edit mirror: major admits exactly one rejected member ('/')\"),\n78|    (\"M7\", \"narrowing\", PROTO,\n79|     \"\\tif len(parts) != 3 {\",\n80|     \"\\tif len(parts) < 3 {\",\n81|     \"P1: admits exactly the over-long shape (4+ parts)\"),\n82|    (\"M8\", \"narrowing\", PROTO,\n83|     \"\\tif len(parts[0]) == 0 {\",\n84|     \"\\tif len(parts[0]) < 0 {\",\n85|     \"P4: empty-major arm never fires (token preserved)\"),\n86|    (\"M9\", \"arm-deletion\", PROTO,\n87|     \"\\tfor _, rest := range parts[1:] {\\n\\t\\tif len(rest) == 0 {\\n\\t\\t\\treturn 0, false\\n\\t\\t}\\n\\t\\tfor i := 0; i < len(rest); i++ {\\n\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\\n\\t\\t\\t\\treturn 0, false\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\",\n88|     \"\",\n89|     \"P5+P6: whole minor/patch validation deleted\"),\n90|    (\"M10\", \"arm-deletion\", PROTO,\n91|     \"\\tif len(parts) != 3 {\\n\\t\\treturn 0, false\\n\\t}\\n\",\n92|     \"\",\n93|     \"P1: three-part shape check deleted\"),\n94|    (\"M11\", \"narrowing\", PROTO,\n95|     \"axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}\",\n96|     \"axerror.ContainingContract{ID: ProtocolID, Major: observedMajor + 1}\",\n97|     \"C1: failure-error contract shifted off the observed major\"),\n98|    (\"M12\", \"equivalence-probe\", PROTO,\n99|     \"\\tobservedMajor, _ := parseMajor(version)\\n\\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}, members[\\\"error\\\"])\",\n100|     \"\\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: 2}, members[\\\"error\\\"])\",\n101|     \"C1: revert to the hardcoded major-2 contract (declared equivalent today)\"),\n102|    (\"M13b\", \"narrowing\", PROTO,\n103|     PEEK_OLD,\n104|     PEEK_OLD.replace(\"recognized && major != ProtocolMajor\", \"recognized || major != ProtocolMajor\"),\n105|     \"K1: foreignMajor peek widened to unrecognized versions\"),\n106|    (\"M14b\", \"narrowing\", PROTO,\n107|     PEEK_OLD,\n108|     PEEK_OLD.replace(\"recognized && major != ProtocolMajor\", \"recognized && major > ProtocolMajor\"),\n109|     \"K1: foreignMajor peek narrowed to majors above 2\"),\n110|    (\"M16\", \"narrowing\", PROTO,\n111|     GATE_OLD,\n112|     GATE_OLD.replace(\"recognized && major != ProtocolMajor\", \"recognized && major > ProtocolMajor\"),\n113|     \"V1: version-gate mismatch arm narrowed to majors above 2\"),\n114|    (\"M17\", \"narrowing/token-preserving\", PROTO,\n115|     \"\\t\\tif digit < '0' || digit > '9' {\",\n116|     \"\\t\\tif digit == ':' {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif digit < '0' || digit > '9' {\",\n117|     \"P2 TOKEN-PRESERVING: major admits exactly ':' (condition text unchanged)\"),\n118|    (\"M17b\", \"narrowing/token-preserving\", PROTO,\n119|     \"\\t\\tif digit < '0' || digit > '9' {\",\n120|     \"\\t\\tif digit == '/' {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif digit < '0' || digit > '9' {\",\n121|     \"P2 TOKEN-PRESERVING: major admits exactly '/' (condition text unchanged)\"),\n122|    (\"M18\", \"narrowing/token-preserving\", PROTO,\n123|     \"\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n124|     \"\\t\\t\\tif rest[i] == '/' {\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\\n\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n125|     \"P6 TOKEN-PRESERVING: rest admits exactly '/' (condition text unchanged)\"),\n126|    (\"M18b\", \"narrowing/token-preserving\", PROTO,\n127|     \"\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n128|     \"\\t\\t\\tif rest[i] == ':' {\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\\n\\t\\t\\tif rest[i] < '0' || rest[i] > '9' {\",\n129|     \"P6 TOKEN-PRESERVING: rest admits exactly ':' (condition text unchanged)\"),\n130|    (\"M15\", \"census-only\", INV,\n131|     'if ok && function.Name.Name == \"parseMajor\" {',\n132|     'if ok && function.Name.Name == \"parseMajorXX\" {',\n133|     \"census derives zero parse arms (production untouched)\"),\n134|]\n135|\n136|CONTROLS = [\n137|    (\"X1\", \"control-absent\", PROTO,\n138|     \"if major >= (math.MaxInt-step)/10 {\",\n139|     \"if major > (math.MaxInt-step)/10 {\",\n140|     \"anchor uses >=, absent from source\"),\n141|    (\"X2\", \"control-compile\", PROTO,\n142|     \"\\t\\tif major > (math.MaxInt-step)/10 {\\n\\t\\t\\tmajor = math.MaxInt\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\",\n143|     \"\",\n144|     \"guard deleted outright, math import unused\"),\n145|]\n146|\n147|\n148|def run(cmd):\n149|    p = subprocess.run(cmd, shell=True, capture_output=True, text=True)\n150|    return p.returncode, p.stdout + p.stderr\n151|\n152|\n153|def apply_and_test(mid, cls, path, old, new, detail):\n154|    src = open(path).read()\n155|    n = src.count(old)\n156|    if n != 1:\n157|        return {\"id\": mid, \"class\": cls, \"disposition\": \"NOT_APPLIED\",\n158|                \"detail\": \"%s; anchor sites=%d, want 1\" % (detail, n)}\n159|    open(path, \"w\").write(src.replace(old, new))\n160|    try:\n161|        bcode, bout = run(\"go build ./internal/provhost/\")\n162|        if bcode != 0:\n163|            return {\"id\": mid, \"class\": cls, \"disposition\": \"COMPILE_FAIL\",\n164|                    \"detail\": detail, \"build\": bout.strip().splitlines()[:3]}\n165|        tcode, tout = run(\"go test ./internal/provhost/ -count=1\")\n166|        failed = sorted({l.split()[2] for l in tout.splitlines()\n167|                         if l.strip().startswith(\"--- FAIL:\")})\n168|        return {\"id\": mid, \"class\": cls,\n169|                \"disposition\": \"KILLED\" if tcode != 0 else \"SURVIVED\",\n170|                \"killed_by\": failed, \"detail\": detail}\n171|    finally:\n172|        shutil.copyfile(TARGETS[path], path)\n173|        assert sha(path) == PRISTINE_SHA[path], \"restore failed for %s\" % path\n174|\n175|\n176|only = sys.argv[1:]\n177|results = []\n178|for m in MUTANTS + CONTROLS:\n179|    if only and m[0] not in only:\n180|        continue\n181|    r = apply_and_test(*m)\n182|    results.append(r)\n183|    print(json.dumps(r), flush=True)\n184|\n185|tag = \"-\".join(only) if only else \"all\"\n186|json.dump(results, open(os.path.join(BACKUP, \"battery-round4-%s.json\" % tag), \"w\"), indent=2)\n187|for p in TARGETS:\n188|    assert sha(p) == PRISTINE_SHA[p], \"final restore check failed for %s\" % p\n189|print(\"ALL RESTORED\")"}}}
