{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b9","stream":{"kind":"session","id":"01a07962-00f2-7aa3-bdba-fd54caa2b073"},"sequence":439,"recorded_at":1780531400000873,"record_type":"event","durability":"durable","causation_id":"0e106057-555a-4629-8228-1b6dea88eaef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0e106057-555a-4629-8228-1b6dea88eaef","run_stream":{"kind":"run","id":"0e106057-555a-4629-8228-1b6dea88eaef"},"task_stream":{"kind":"task","id":"24bd5c5b-20e0-438f-ac06-9dfa9e939b48"},"task_id":"24bd5c5b-20e0-438f-ac06-9dfa9e939b48","event":{"kind":"output","task_id":"24bd5c5b-20e0-438f-ac06-9dfa9e939b48","chunk":"{\n  \"chunk_id\": \"exec-18-1\",\n  \"command\": \"sed -n '330,380p' internal/terminalbackend/manifest.go; echo ====; sed -n '95,125p' internal/provhost/surrogate.go; echo ====; grep -n \\\"func Test\\\" internal/terminalbackend/manifest_test.go | head -n 40; echo ====; grep -rn \\\"func Test\\\" internal/provhost/surrogate_test.go | head -n 30\",\n  \"description\": \"Read hex decoder context and existing tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t\\t}\\n\\tstringComplete:\\n\\t}\\n\\treturn false\\n}\\n\\n// isWTF8SurrogateAt reports whether raw[index] begins a three-byte WTF-8\\n// (CESU-8) encoding of a surrogate code point: ED A0..BF 80..BF decodes to\\n// U+D800..U+DFFF, which utf8.Valid refuses. Only this ED range is\\n// surrogate-shaped: ED 80..9F heads U+D000..U+D7FF, which is valid UTF-8\\n// and must not match. A truncated tail cannot be classified here and is\\n// left for the encoding arm.\\nfunc isWTF8SurrogateAt(raw []byte, index int) bool {\\n\\treturn index+2 < len(raw) && raw[index] == 0xed &&\\n\\t\\traw[index+1] >= 0xa0 && raw[index+1] <= 0xbf &&\\n\\t\\traw[index+2] >= 0x80 && raw[index+2] <= 0xbf\\n}\\n\\n// readUTF16EscapeUnit reads one \\\\uXXXX escape at raw[start] (which must be\\n// the backslash). It reports false when the escape is absent or malformed;\\n// malformed escapes are refused by the decoder's syntax arm, so this gate\\n// only needs to stay silent on them rather than diagnose them.\\nfunc readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\\n\\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\\\\\' || raw[start+1] != 'u' {\\n\\t\\treturn 0, start, false\\n\\t}\\n\\tvar unit uint16\\n\\tfor _, digit := range raw[start+2 : start+6] {\\n\\t\\tunit <<= 4\\n\\t\\tswitch {\\n\\t\\tcase digit >= '0' && digit <= '9':\\n\\t\\t\\tunit |= uint16(digit - '0')\\n\\t\\tcase digit >= 'a' && digit <= 'f':\\n\\t\\t\\tunit |= uint16(digit-'a') + 10\\n\\t\\tcase digit >= 'A' && digit <= 'F':\\n\\t\\t\\tunit |= uint16(digit-'A') + 10\\n\\t\\tdefault:\\n\\t\\t\\treturn 0, start, false\\n\\t\\t}\\n\\t}\\n\\treturn unit, start + 6, true\\n}\\n\\n// decodeStrictObject decodes one JSON object with duplicate-key refusal,\\n// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\\n// trailing-data refusal. The surrogate scan runs on the raw bytes before\\n// any canonicalization (SPEC.md:289): Go's encoding/json would silently\\n// replace a lone \\\\ud800 with U+FFFD, hiding the violation from every later\\n// member check. Numbers\\n// decode as json.Number so member validators can refuse them explicitly:\\n// none of the three closed schemas has a numeric member.\\n====\\n\\t}\\n\\treturn false\\n}\\n\\n// readHexUnit parses one \\\\uXXXX escape at input[start]. It reports false\\n// when the bytes are not a well-formed escape; hex digits parse in\\n// either case, matching the shared package's ParseUint base-16 read.\\nfunc readHexUnit(input []byte, start int) (uint16, int, bool) {\\n\\tif start < 0 || start+6 > len(input) || input[start] != '\\\\\\\\' || input[start+1] != 'u' {\\n\\t\\treturn 0, start, false\\n\\t}\\n\\tvar value uint16\\n\\tfor _, b := range input[start+2 : start+6] {\\n\\t\\tvar digit byte\\n\\t\\tif b >= '0' && b <= '9' {\\n\\t\\t\\tdigit = b - '0'\\n\\t\\t} else if b >= 'a' && b <= 'f' {\\n\\t\\t\\tdigit = b - 'a' + 10\\n\\t\\t} else if b >= 'A' && b <= 'F' {\\n\\t\\t\\tdigit = b - 'A' + 10\\n\\t\\t} else {\\n\\t\\t\\treturn 0, start, false\\n\\t\\t}\\n\\t\\tvalue = value*16 + uint16(digit)\\n\\t}\\n\\treturn value, start + 6, true\\n}\\n====\\n394:func TestParseManifestAdmitsClosedFixture(t *testing.T) {\\n438:func TestGenerationDigestGolden(t *testing.T) {\\n457:func TestGenerationDigestBounds(t *testing.T) {\\n476:func TestMultibyteStringBounds(t *testing.T) {\\n517:func TestDocumentSurrogateEscapeRefused(t *testing.T) {\\n551:func TestDocumentWTF8SurrogateRefused(t *testing.T) {\\n575:func TestReconcileAdmitsCoherentTuple(t *testing.T) {\\n606:func TestManifestDocumentRefusals(t *testing.T) {\\n848:func TestManifestEncodingRefusals(t *testing.T) {\\n882:func TestManifestIdentityMismatch(t *testing.T) {\\n895:func TestProbeDocumentRefusals(t *testing.T) {\\n1046:func TestEvidenceDocumentRefusals(t *testing.T) {\\n1291:func TestReconcileRefusals(t *testing.T) {\\n1619:func TestCapabilitiesForOperation(t *testing.T) {\\n1653:func TestCheckOperationAdmitsDependencyFreeOperations(t *testing.T) {\\n1678:func TestEmptyTupleAdmitsEmptySet(t *testing.T) {\\n1704:func TestAdmittedSharesNoBackingArrays(t *testing.T) {\\n1727:func TestUnavailableProbeStillAdmits(t *testing.T) {\\n1742:func TestAdmitProbeBindsRegistry(t *testing.T) {\\n1768:func TestAdmitProbeRefusesUnknownIdentity(t *testing.T) {\\n1799:func TestAdmitProbeRefusesRecordDrift(t *testing.T) {\\n1821:func TestAdmitProbeExternalRealm(t *testing.T) {\\n====\\ninternal/provhost/surrogate_test.go:19:func TestProductionEntriesRefuseLoneSurrogateEscapes(t *testing.T) {\\ninternal/provhost/surrogate_test.go:75:func TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON(t *testing.T) {\\n\",\n  \"original_output_bytes\": 4267,\n  \"original_output_tokens\": 1067,\n  \"truncated\": false\n}"}}}
