{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c3b3","stream":{"kind":"session","id":"01a07962-00f2-7aa3-bdba-fd54caa2b073"},"sequence":52,"recorded_at":1780531400000099,"record_type":"event","durability":"durable","causation_id":"0e106057-555a-4629-8228-1b6dea88eaef","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0e106057-555a-4629-8228-1b6dea88eaef","run_stream":{"kind":"run","id":"0e106057-555a-4629-8228-1b6dea88eaef"},"task_stream":{"kind":"task","id":"c2430cfa-8de1-4d6c-8e28-9b6abf65ef49"},"task_id":"c2430cfa-8de1-4d6c-8e28-9b6abf65ef49","event":{"kind":"output","task_id":"c2430cfa-8de1-4d6c-8e28-9b6abf65ef49","chunk":"Read text file `internal/terminalbackend/digit_range_census_test.go`.\n1|// Digit-range census for this leaf: every `X < '0' || X > '9'` comparison\n2|// the leaf added or re-gated, with the reachable rejected class named per\n3|// site and the equivalents declared. Three sites, no more:\n4|//\n5|// Site 1 — provhost parseMajor major arm (internal/provhost/protocol.go:379)\n6|// `digit < '0' || digit > '9'`. Input domain: a JSON string member, so any\n7|// byte is reachable. Reachable rejected class: every non-digit byte.\n8|// Adjacent witnesses `/` (0x2F, one below '0') and `:` (0x3A, one above\n9|// '9') in TestParseMajorDigitBoundariesRefuseAtEntry (`3/.0.0`, `/.0.0`,\n10|// `3:.0.0`, `:.0.0`), driven through DecodeResponse asserting\n11|// provider_protocol_error / exit 13 / member protocol_version. Declared\n12|// equivalents: letters and signs in the older corpus (`a.0.0`, `2a`,\n13|// `-1`, `+3`) refuse under every adjacent-narrowing too, so they add no\n14|// narrowing power beyond the adjacent rows.\n15|//\n16|// Site 2 — provhost parseMajor rest arm (internal/provhost/protocol.go:397)\n17|// `rest[i] < '0' || rest[i] > '9'`. Same string domain, same rejected\n18|// class. Adjacent witnesses `/` and `:` in each rest position in the same\n19|// test (`3./.0`, `3.0./`, `3.:.0`, `3.0.:`). Declared equivalents: rest\n20|// letters (`3.b.c` control) as for site 1.\n21|//\n22|// Site 3 — terminalbackend descriptorGeometry\n23|// (internal/terminalbackend/descriptor.go:235)\n24|// `digit < '0' || digit > '9'`. Input domain: a json.Number literal, so\n25|// only [0-9.+eE-] is spellable; `/` (0x2F) and `:` (0x3A) are NOT\n26|// reachable here — they die in the strict decoder with the document\n27|// syntax arm before the gate runs, pinned below by\n28|// TestDescriptorGeometryAdjacentsNeverReachTheGate (the inverse of the\n29|// provhost rows, which is why the same adjacent characters need opposite\n30|// tests at the two domains). Reachable rejected class: exactly\n31|// {-, +, ., e, E}. Witnesses, each on both geometry members asserting\n32|// `descriptor geometry digits`: `-` (`-80`, `-24`), `.` (`80.0`, `24.5`),\n33|// `e` (`1e2`), `E` (`1E2`, added this round — the one reachable member of\n34|// the 32-value window between the true edge `9` (0x39) and the witnessed\n35|// `e` (0x65)). Declared equivalent: `+` gets one line, not a row (N9) —\n36|// `+` is only legal after `e`/`E`, which refuses first, so no mutant of\n37|// this gate admits `+` while refusing `e`/`E`: a lower-bound narrowing\n38|// admitting `+` admits `-` too (0x2B < 0x2D refuses nothing `-` keeps),\n39|// and `if digit == '+' { continue }` changes no disposition on any\n40|// reachable literal.\n41|//\n42|// Out of scope, deliberately: the hex three-way splits in\n43|// terminalbackend/manifest.go and provhost/surrogate.go predate this leaf\n44|// and are a different shape (a three-case decoder, not a single\n45|// digit-range gate); the semverMajor/parseMajor saturation guards are\n46|// accumulation bounds, pinned at their arithmetic edges by\n47|// TestSemverMajorSaturationEdge (here) and TestParseMajorSaturationEdge\n48|// (provhost), not by adjacent characters.\n49|package terminalbackend_test\n50|\n51|import (\n52|\t\"testing\"\n53|\n54|\tterminalbackend \"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n55|)\n56|\n57|// TestDescriptorGeometryAdjacentsNeverReachTheGate proves `/` (0x2F) and\n58|// `:` (0x3A) — the characters adjacent to the digit range — never reach\n59|// the descriptorGeometry gate: neither spells inside a JSON number, so\n60|// the strict decoder refuses first with the document syntax arm. A gate\n61|// mutant shifting either bound (`digit > ':'`, `digit < '/'`) or\n62|// skipping either character token-preservingly changes no disposition\n63|// here; the rows exist so the census claim \"unreachable\" is measured,\n64|// not asserted. Both members are driven because the geometry site is\n65|// shared and the decoder runs before either call.\n66|func TestDescriptorGeometryAdjacentsNeverReachTheGate(t *testing.T) {\n67|\tt.Parallel()\n68|\n69|\tfor _, member := range []string{\"columns\", \"rows\"} {\n70|\t\tfor _, literal := range []string{`1/2`, `1:2`} {\n71|\t\t\t_, err := terminalbackend.ParseProviderDescriptor(setDescriptorMember(t, member, literal))\n72|\t\t\tif err == nil || !terminalbackend.IsMismatch(err) {\n73|\t\t\t\tt.Fatalf(\"ParseProviderDescriptor(%s=%s) error = %v, want a document mismatch refusal\", member, literal, err)\n74|\t\t\t}\n75|\t\t\tif got := refusalDetail(t, err); got != \"document syntax\" {\n76|\t\t\t\tt.Fatalf(\"ParseProviderDescriptor(%s=%s) detail = %q, want document syntax\", member, literal, got)\n77|\t\t\t}\n78|\t\t}\n79|\t}\n80|}"}}}
