{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d7","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":198,"recorded_at":1780531400000391,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"d9c80a88-666e-4e21-bcfb-f8f6afca62f7"},"task_id":"d9c80a88-666e-4e21-bcfb-f8f6afca62f7","event":{"kind":"output","task_id":"d9c80a88-666e-4e21-bcfb-f8f6afca62f7","chunk":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|)\n10|\n11|// This file validates the Provider Identity Record (Section 5.5,\n12|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n13|// identify-session results and carries in launch, resume, quiesce,\n14|// and fork bodies, plus the identify-session success wrapper. The\n15|// record_id is required to be a digest but is not recomputed here:\n16|// content addressing belongs to the object-identity story, and this\n17|// package holds no canonical encoder. The opaque_identity absolute\n18|// prefix rule mirrors the decidable half of the Section 5.5\n19|// sentence: a value beginning with an absolute path is refused, and\n20|// an embedded path the prefix cannot see is a stated bound.\n21|//\n22|// CheckIdentity validates the record shape in this package's provider-stdio\n23|// dialect (provider_protocol_error with member attribution, which the\n24|// shared package cannot mint) and conjoins the verdict with the owner's\n25|// production identity entry canonicaljson.CalculateObjectIdentity: the two\n26|// validators must agree on the Section 5.5 shape rule for rule, and a\n27|// document the dialect admits but the owner refuses is refused at the\n28|// owner gate below. The decoder half of that agreement is pinned by the\n29|// derived TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON sweep,\n30|// which judges escape and raw-UTF-8 vectors through the shared\n31|// decodeStrictObject every entry here reads through, and any shape-rule\n32|// change must land in both validators in the same change.\n33|\n34|// identitySchema is the exact schema identifier the record carries.\n35|const identitySchema = \"urn:ax:schema:provider-identity\"\n36|\n37|// identitySchemaVersion is the only identity version accepted.\n38|const identitySchemaVersion = \"1.0.0\"\n39|\n40|// identityKinds is the closed identity-kind enum in section order.\n41|var identityKinds = []string{\n42|\t\"session_uuid\",\n43|\t\"session_path_or_id\",\n44|\t\"backend_conversation_uuid\",\n45|\t\"task_board_managed\",\n46|\t\"provider_defined\",\n47|}\n48|\n49|// identityMembers is the exact required member set of a Provider\n50|// Identity Record.\n51|var identityMembers = map[string]bool{\n52|\t\"schema\":                    true,\n53|\t\"schema_version\":            true,\n54|\t\"record_id\":                 true,\n55|\t\"subject_id\":                true,\n56|\t\"session_id\":                true,\n57|\t\"provider_id\":               true,\n58|\t\"provider_version\":          true,\n59|\t\"provider_version_range\":    true,\n60|\t\"native_session_id\":         true,\n61|\t\"identity_kind\":             true,\n62|\t\"logical_workspace_id\":      true,\n63|\t\"backend_realm_fingerprint\": true,\n64|\t\"opaque_identity\":           true,\n65|\t\"created_by_host_id\":        true,\n66|\t\"created_at\":                true,\n67|\t\"extensions\":                true,\n68|}\n69|\n70|// identityRequired lists identityMembers in a fixed order so a record\n71|// missing several members always names the same one.\n72|var identityRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"record_id\",\n76|\t\"subject_id\",\n77|\t\"session_id\",\n78|\t\"provider_id\",\n79|\t\"provider_version\",\n80|\t\"provider_version_range\",\n81|\t\"native_session_id\",\n82|\t\"identity_kind\",\n83|\t\"logical_workspace_id\",\n84|\t\"backend_realm_fingerprint\",\n85|\t\"opaque_identity\",\n86|\t\"created_by_host_id\",\n87|\t\"created_at\",\n88|\t\"extensions\",\n89|}\n90|\n91|// identityKeyPattern is the provider-identity key grammar Section 5.5\n92|// states: [a-z][a-z0-9_.-]{0,63}.\n93|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n94|\n95|// windowsDrivePattern matches a Windows drive-qualified absolute\n96|// prefix: a letter, a colon, and a separator.\n97|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n98|\n99|// CheckIdentity validates one Provider Identity Record naming the\n100|// expected provider. Shape violations are provider_protocol_errors;\n101|// a well-formed record for another provider is an invalid_config\n102|// caller error: the caller correlated the wrong identity to this\n103|// session.\n104|func CheckIdentity(body []byte, wantProviderID string) error {\n105|\tmembers, fault := decodeStrictObject(body)\n106|\tif fault != nil {\n107|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n114|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif name, missing := missingMember(members, identityRequired); missing {\n121|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n128|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n135|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n136|\t\tif err != nil {\n137|\t\t\treturn err\n138|\t\t}\n139|\t\treturn failure\n140|\t}\n141|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n142|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n143|\t\tif err != nil {\n144|\t\t\treturn err\n145|\t\t}\n146|\t\treturn failure\n147|\t}\n148|\tsubject, ok := rawString(members[\"subject_id\"])\n149|\tif !ok || !isUUIDv7(subject) {\n150|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n151|\t\tif err != nil {\n152|\t\t\treturn err\n153|\t\t}\n154|\t\treturn failure\n155|\t}\n156|\tsession, ok := rawString(members[\"session_id\"])\n157|\tif !ok || !isUUIDv7(session) {\n158|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\treturn failure\n163|\t}\n164|\tif subject != session {\n165|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n166|\t\tif err != nil {\n167|\t\t\treturn err\n168|\t\t}\n169|\t\treturn failure\n170|\t}\n171|\tprovider, ok := rawString(members[\"provider_id\"])\n172|\tif !ok || !validProviderID(provider) {\n173|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n174|\t\tif err != nil {\n175|\t\t\treturn err\n176|\t\t}\n177|\t\treturn failure\n178|\t}\n179|\tif provider != wantProviderID {\n180|\t\tfailure, err := failInvalid(\"identity names another provider\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n187|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\treturn failure\n192|\t}\n193|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n194|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n195|\t\tif err != nil {\n196|\t\t\treturn err\n197|\t\t}\n198|\t\treturn failure\n199|\t}\n200|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n201|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n202|\t\tif err != nil {\n203|\t\t\treturn err\n204|\t\t}\n205|\t\treturn failure\n206|\t}\n207|\tkind, ok := rawString(members[\"identity_kind\"])\n208|\tif !ok || !isIdentityKind(kind) {\n209|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n210|\t\tif err != nil {\n211|\t\t\treturn err\n212|\t\t}\n213|\t\treturn failure\n214|\t}\n215|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n216|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n217|\t\tif err != nil {\n218|\t\t\treturn err\n219|\t\t}\n220|\t\treturn failure\n221|\t}\n222|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n223|\t\treturn err\n224|\t}\n225|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n226|\t\treturn err\n227|\t}\n228|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n229|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n230|\t\tif err != nil {\n231|\t\t\treturn err\n232|\t\t}\n233|\t\treturn failure\n234|\t}\n235|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n236|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n237|\t\tif err != nil {\n238|\t\t\treturn err\n239|\t\t}\n240|\t\treturn failure\n241|\t}\n242|\tif !isJSONObject(members[\"extensions\"]) {\n243|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n244|\t\tif err != nil {\n245|\t\t\treturn err\n246|\t\t}\n247|\t\treturn failure\n248|\t}\n249|\t// The member arms above are this package's provider-stdio dialect of\n250|\t// the Section 5.5 rule; the owner of that rule is canonicaljson\n251|\t// (validateProviderIdentityRecord, registered for section:5.5 in the\n252|\t// traceability registry), and the dialect keeps its member attribution\n253|\t// deliberately. The verdict is therefore conjoined with the owner's\n254|\t// production identity entry: a document this dialect admits but the\n255|\t// owner refuses — open extensions content, a number the dialect never\n256|\t// reads, nesting beyond the dialect's view — is refused here rather\n257|\t// than admitted through a drifted copy. The provider-equality\n258|\t// correlation above stays host-side: it is a caller rule, not a\n259|\t// content rule, and the owner never sees it.\n260|\tif _, _, err := canonicaljson.CalculateObjectIdentity(body); err != nil {\n261|\t\tfailure, ferr := failProtocol(\"identity is not a valid provider identity\", \"\")\n262|\t\tif ferr != nil {\n263|\t\t\treturn ferr\n264|\t\t}\n265|\t\treturn failure\n266|\t}\n267|\treturn nil\n268|}\n269|\n270|// checkIdentityRealm enforces the digest-or-null shape and the one\n271|// conditional rule Section 5.5 states: an Antigravity\n272|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n273|// because the backend realm is a resume precondition there.\n274|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n275|\trealm, isNull, ok := rawNullableString(raw)\n276|\tif !ok || (!isNull && !isDigest(realm)) {\n277|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n278|\t\tif err != nil {\n279|\t\t\treturn err\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n284|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n285|\t\tif err != nil {\n286|\t\t\treturn err\n287|\t\t}\n288|\t\treturn failure\n289|\t}\n290|\treturn nil\n291|}\n292|\n293|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n294|// object of at most 32 entries, keyed by the provider-identity key\n295|// grammar, with non-secret string values of 1..1,024 characters that\n296|// MUST NOT begin with an absolute path.\n297|func checkIdentityOpaque(raw json.RawMessage) error {\n298|\topaque, fault := decodeStrictObject(raw)\n299|\tif fault != nil {\n300|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n301|\t\tif err != nil {\n302|\t\t\treturn err\n303|\t\t}\n304|\t\treturn failure\n305|\t}\n306|\tif len(opaque) > 32 {\n307|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n308|\t\tif err != nil {\n309|\t\t\treturn err\n310|\t\t}\n311|\t\treturn failure\n312|\t}\n313|\tkeys := make([]string, 0, len(opaque))\n314|\tfor key := range opaque {\n315|\t\tkeys = append(keys, key)\n316|\t}\n317|\tfor _, key := range keys {\n318|\t\tif !identityKeyPattern.MatchString(key) {\n319|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n320|\t\t\tif err != nil {\n321|\t\t\t\treturn err\n322|\t\t\t}\n323|\t\t\treturn failure\n324|\t\t}\n325|\t\tvalue, ok := rawString(opaque[key])\n326|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n327|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n328|\t\t\tif err != nil {\n329|\t\t\t\treturn err\n330|\t\t\t}\n331|\t\t\treturn failure\n332|\t\t}\n333|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n334|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n335|\t\t\tif err != nil {\n336|\t\t\t\treturn err\n337|\t\t\t}\n338|\t\t\treturn failure\n339|\t\t}\n340|\t}\n341|\treturn nil\n342|}\n343|\n344|func isIdentityKind(value string) bool {\n345|\tfor _, kind := range identityKinds {\n346|\t\tif value == kind {\n347|\t\t\treturn true\n348|\t\t}\n349|\t}\n350|\treturn false\n351|}\n352|\n353|// identifyMembers is the exact required member set of an\n354|// identify-session success body.\n355|var identifyMembers = map[string]bool{\n356|\t\"identity\":         true,\n357|\t\"confidence\":       true,\n358|\t\"matched_evidence\": true,\n359|}\n360|\n361|// identifyRequired lists identifyMembers in a fixed order.\n362|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n363|\n364|// identifyConfidences is the closed confidence vocabulary.\n365|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n366|\n367|// identifyEvidence is the closed matched-evidence vocabulary.\n368|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n369|\n370|// DecodeIdentifyResult validates one identify-session success body:\n371|// the Provider Identity Record for the expected provider, a closed\n372|// confidence, and 1..4 sorted unique matched-evidence members.\n373|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n374|\tmembers, fault := decodeStrictObject(body)\n375|\tif fault != nil {\n376|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n377|\t\tif err != nil {\n378|\t\t\treturn err\n379|\t\t}\n380|\t\treturn failure\n381|\t}\n382|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n383|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n384|\t\tif err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t\treturn failure\n388|\t}\n389|\tif name, missing := missingMember(members, identifyRequired); missing {\n390|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n391|\t\tif err != nil {\n392|\t\t\treturn err\n393|\t\t}\n394|\t\treturn failure\n395|\t}\n396|\tconfidence, ok := rawString(members[\"confidence\"])\n397|\tif !ok || !isIdentifyConfidence(confidence) {\n398|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n399|\t\tif err != nil {\n400|\t\t\treturn err\n401|\t\t}\n402|\t\treturn failure\n403|\t}\n404|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n405|\t\treturn err\n406|\t}\n407|\tif !isJSONObject(members[\"identity\"]) {\n408|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n409|\t\tif err != nil {\n410|\t\t\treturn err\n411|\t\t}\n412|\t\treturn failure\n413|\t}\n414|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n415|\t\treturn err\n416|\t}\n417|\treturn nil\n418|}\n419|\n420|func isIdentifyConfidence(value string) bool {\n421|\tfor _, confidence := range identifyConfidences {\n422|\t\tif value == confidence {\n423|\t\t\treturn true\n424|\t\t}\n425|\t}\n426|\treturn false\n427|}\n428|\n429|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n430|// evidence members: the observation must cite what matched, exactly\n431|// once each.\n432|func checkIdentifyEvidence(raw json.RawMessage) error {\n433|\tevidence, ok := rawStringArray(raw)\n434|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n435|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n436|\t\tif err != nil {\n437|\t\t\treturn err\n438|\t\t}\n439|\t\treturn failure\n440|\t}\n441|\tallowed := map[string]bool{}\n442|\tfor _, member := range identifyEvidence {\n443|\t\tallowed[member] = true\n444|\t}\n445|\tfor _, member := range evidence {\n446|\t\tif !allowed[member] {\n447|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n448|\t\t\tif err != nil {\n449|\t\t\t\treturn err\n450|\t\t\t}\n451|\t\t\treturn failure\n452|\t\t}\n453|\t}\n454|\tif !sortedUniqueStrings(evidence) {\n455|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n456|\t\tif err != nil {\n457|\t\t\treturn err\n458|\t\t}\n459|\t\treturn failure\n460|\t}\n461|\treturn nil\n462|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d9","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":199,"recorded_at":1780531400000393,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"d9c80a88-666e-4e21-bcfb-f8f6afca62f7"},"task_id":"d9c80a88-666e-4e21-bcfb-f8f6afca62f7","event":{"kind":"completed","task_id":"d9c80a88-666e-4e21-bcfb-f8f6afca62f7"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4db","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":200,"recorded_at":1780531400000395,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"0f0f9944-a17a-416e-8458-901ed4582bed"},"task_id":"0f0f9944-a17a-416e-8458-901ed4582bed","event":{"kind":"output","task_id":"0f0f9944-a17a-416e-8458-901ed4582bed","chunk":"Read text file `internal/traceability/traceability.go`.\n1|// Package traceability verifies that the pinned AX specification inventory\n2|// remains bound to concrete production declarations and executable acceptance\n3|// cases. It is a read-only repository gate; it does not advertise runtime\n4|// capabilities or mutate implementation state.\n5|package traceability\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"crypto/sha256\"\n10|\t\"encoding/hex\"\n11|\t\"encoding/json\"\n12|\t\"errors\"\n13|\t\"fmt\"\n14|\t\"go/ast\"\n15|\t\"go/parser\"\n16|\t\"go/token\"\n17|\t\"io\"\n18|\t\"io/fs\"\n19|\t\"path\"\n20|\t\"regexp\"\n21|\t\"strings\"\n22|\t\"unicode\"\n23|\t\"unicode/utf8\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n29|)\n30|\n31|const (\n32|\townershipRegistryPath = \"internal/traceability/ownership.v0.5.0.json\"\n33|\tcontractLockPath      = \"internal/specpin/v0.5.0.lock.json\"\n34|\tcatalogMetadataPath   = \"internal/catalog/catalog.v0.5.0.json\"\n35|\tgeneratedCatalogPath  = \"internal/catalog/catalog_gen.go\"\n36|\n37|\townershipFormat        = \"ax-spec-to-code-ownership\"\n38|\townershipFormatVersion = 1\n39|\n40|\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\n41|\t// formatting may change, but ownership claims cannot be self-minted without\n42|\t// an explicit review of this binding.\n43|\treviewedOwnershipCanonicalSHA256 = \"5581f5eb95bfc5762bb4af0d72b6895c5f4da9bcd63d14709124bd264de1b489\"\n44|)\n45|\n46|var ErrTraceability = errors.New(\"spec-to-code traceability check failed\")\n47|\n48|// Report contains inventory coverage only. These counts do not claim that any\n49|// runtime capability is available, enabled, or supported.\n50|type Report struct {\n51|\tContracts              int\n52|\tNormativeSections      int\n53|\tAcceptanceCases        int\n54|\tFixtures               int\n55|\tCompatibilityContracts int\n56|\tAssignedScopes         int\n57|\n58|\t// SectionBindings and the coverage counters below are a measured ratio over\n59|\t// the registered section bindings, not a prose claim. NormativeClauses is\n60|\t// the number of RFC 2119 clause lines the pinned document itself carries in\n61|\t// the bound sections; DischargedClauses is how many of those a binding\n62|\t// enumerates with a verified excerpt and an acceptance owner.\n63|\tSectionBindings     int\n64|\tFullCoverage        int\n65|\tPartialCoverage     int\n66|\tSliverCoverage      int\n67|\tUnevidencedCoverage int\n68|\tUnmeasuredCoverage  int\n69|\tUnownedSections     int\n70|\tNormativeClauses    int\n71|\tDischargedClauses   int\n72|}\n73|\n74|type ownershipKind string\n75|\n76|const (\n77|\townershipContract         ownershipKind = \"contract\"\n78|\townershipNormativeSection ownershipKind = \"normative_section\"\n79|\townershipSectionBinding   ownershipKind = \"section_binding\"\n80|\townershipFixture          ownershipKind = \"fixture\"\n81|)\n82|\n83|type ownershipRegistry struct {\n84|\tFormat          string           `json:\"format\"`\n85|\tFormatVersion   int              `json:\"format_version\"`\n86|\tSource          registrySource   `json:\"source\"`\n87|\tAcceptanceCases []acceptanceCase `json:\"acceptance_cases\"`\n88|\tOwnership       []ownershipGroup `json:\"ownership\"`\n89|\tUnownedSections []unownedSection `json:\"unowned_sections\"`\n90|}\n91|\n92|// unownedSection records a real v0.5.0 section that this repository does not\n93|// implement. It exists so an unimplemented section is disclosed by name rather\n94|// than bound to a symbol from a neighbouring package, which is what an owned\n95|// key would otherwise assert. It is a disclosure, never an exemption: a section\n96|// the generated catalog requires an owner for may not be declared here, and\n97|// assigned-scope admission refuses an unowned section and prints its gap.\n98|type unownedSection struct {\n99|\tKey      string `json:\"key\"`\n100|\tGap      string `json:\"gap\"`\n101|\tEvidence string `json:\"evidence\"`\n102|}\n103|\n104|type registrySource struct {\n105|\tRepository     string `json:\"repository\"`\n106|\tRelease        string `json:\"release\"`\n107|\tCommit         string `json:\"commit\"`\n108|\tDocumentPath   string `json:\"document_path\"`\n109|\tDocumentSHA256 string `json:\"document_sha256\"`\n110|}\n111|\n112|type acceptanceCase struct {\n113|\tID         string          `json:\"id\"`\n114|\tProduction codeReference   `json:\"production\"`\n115|\tTests      []codeReference `json:\"tests\"`\n116|}\n117|\n118|type ownershipGroup struct {\n119|\tKind            ownershipKind      `json:\"kind\"`\n120|\tKeys            []string           `json:\"keys\"`\n121|\tProduction      codeReference      `json:\"production\"`\n122|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n123|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n124|\tGap             string             `json:\"gap,omitempty\"`\n125|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n126|}\n127|\n128|// coverageLevel is how much of a bound section a binding claims to discharge.\n129|// The claim is not taken on trust: the level is recomputed from the clauses the\n130|// binding enumerates against the clause inventory the pinned specification\n131|// itself carries for that section, and a claim that differs from the measured\n132|// level is refused.\n133|type coverageLevel string\n134|\n135|const (\n136|\t// coverageFull means every normative clause the pinned section carries is\n137|\t// enumerated with a verified excerpt and an acceptance owner.\n138|\tcoverageFull coverageLevel = \"full\"\n139|\t// coveragePartial means at least half of them are.\n140|\tcoveragePartial coverageLevel = \"partial\"\n141|\t// coverageSliver means fewer than half are: the binding implements a corner\n142|\t// of the section it is registered against.\n143|\tcoverageSliver coverageLevel = \"sliver\"\n144|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n145|\t// the registry makes no clause-level claim, not that the implementation\n146|\t// covers nothing.\n147|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n148|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n149|\t// under the section's heading or its subheadings, so the gate cannot\n150|\t// measure the section's obligations at all.\n151|\t//\n152|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n153|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n154|\t// this class and every one of them has a substantive body: Section 15.2 is a\n155|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n156|\t// Provider Manifest, both of which state their obligations as tables rather\n157|\t// than in uppercase RFC 2119 keywords. Treating that silence as \"nothing to\n158|\t// discharge\" is the same free pass this gate exists to remove, reached\n159|\t// through the scanner instead of through the label, so an unmeasured binding\n160|\t// carries the same mandatory gap as every other level below full and is\n161|\t// refused for assigned-scope admission.\n162|\tcoverageUnmeasured coverageLevel = \"unmeasured\"\n163|)\n164|\n165|// dischargedClause binds one normative clause of the pinned section to the\n166|// acceptance cases that discharge it. Every field is checked against the\n167|// hash-verified document: the identifier must index the section's own clause\n168|// inventory, the line must be the line that clause occupies, and the excerpt\n169|// must be that clause's text quoted verbatim, so a clause cannot be claimed\n170|// with a true sentence about something else.\n171|type dischargedClause struct {\n172|\tID              string   `json:\"id\"`\n173|\tLine            int      `json:\"line\"`\n174|\tExcerpt         string   `json:\"excerpt\"`\n175|\tAcceptanceCases []string `json:\"acceptance_cases\"`\n176|}\n177|\n178|// normativeClause is one RFC 2119 clause line of the pinned specification,\n179|// measured from the document rather than declared by the registry.\n180|type normativeClause struct {\n181|\tID   string\n182|\tLine int\n183|\tText string\n184|}\n185|\n186|type codeReference struct {\n187|\tPath        string `json:\"path\"`\n188|\tDeclaration string `json:\"declaration\"`\n189|}\n190|\n191|type assignedSectionBinding struct {\n192|\tScope string\n193|\tKeys  []string\n194|}\n195|\n196|var assignedSectionPattern = regexp.MustCompile(`^((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*)(?:-((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*))?$`)\n197|var catalogAppendixPattern = regexp.MustCompile(`(?i)^Appendix ([A-D]):`)\n198|\n199|// VerifyRepository is the production CI entry point. It verifies exact pinned\n200|// inputs, stale generated output, compatibility coverage, and every registered\n201|// ownership reference against the supplied repository filesystem.\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.Verify(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV050)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n255|\tif err != nil {\n256|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n257|\t}\n258|\n259|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n260|\tif err != nil {\n261|\t\treturn Report{}, err\n262|\t}\n263|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n264|\tif err != nil {\n265|\t\treturn Report{}, err\n266|\t}\n267|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n268|\tif err != nil {\n269|\t\treturn Report{}, err\n270|\t}\n271|\tdocument, err := specdoc.Load()\n272|\tif err != nil {\n273|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n274|\t}\n275|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256 {\n276|\t\treturn Report{}, fail(\n277|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n278|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256)\n279|\t}\n280|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n281|}\n282|\n283|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n284|\tvalue, err := fs.ReadFile(repository, filename)\n285|\tif err != nil {\n286|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n287|\t}\n288|\treturn value, nil\n289|}\n290|\n291|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n292|\tvar decoded ownershipRegistry\n293|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n294|\tdecoder.DisallowUnknownFields()\n295|\tif err := decoder.Decode(&decoded); err != nil {\n296|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n297|\t}\n298|\tvar trailing any\n299|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n300|\t\tif err == nil {\n301|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n302|\t\t}\n303|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n304|\t}\n305|\treturn decoded, nil\n306|}\n307|\n308|func verifyOwnership(\n309|\trepository fs.FS,\n310|\tdocument *specdoc.Document,\n311|\tregistry ownershipRegistry,\n312|\tmanifest specpin.Manifest,\n313|\tcurrentCatalog catalog.Catalog,\n314|\tcompatibilityCatalog catalog.Catalog,\n315|\tassignedBindings []assignedSectionBinding,\n316|) (Report, error) {\n317|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n318|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n319|\t}\n320|\tsource := registry.Source\n321|\tif source.Repository != manifest.Source.Repository ||\n322|\t\tsource.Release != manifest.Source.Release ||\n323|\t\tsource.Commit != manifest.Source.Commit ||\n324|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n325|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n326|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n327|\t}\n328|\n329|\texpected := map[ownershipKind]map[string]struct{}{\n330|\t\townershipContract:         expectedContracts(manifest.Contracts),\n331|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n332|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n333|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n334|\t}\n335|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n336|\tif err != nil {\n337|\t\treturn Report{}, err\n338|\t}\n339|\trequired := map[ownershipKind]map[string]struct{}{\n340|\t\townershipContract:         expected[ownershipContract],\n341|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n342|\t\townershipSectionBinding:   requiredSectionBindings,\n343|\t\townershipFixture:          expected[ownershipFixture],\n344|\t}\n345|\tselectedSectionBindings := map[string]struct{}(nil)\n346|\tif assignedBindings != nil {\n347|\t\trequired = cloneOwnershipSets(expected)\n348|\t\tselectedSectionBindings = make(map[string]struct{})\n349|\t\tfor _, binding := range assignedBindings {\n350|\t\t\tfor _, key := range binding.Keys {\n351|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n352|\t\t\t}\n353|\t\t}\n354|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n355|\t}\n356|\tchecker := newSourceChecker(repository)\n357|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n358|\tif err != nil {\n359|\t\treturn Report{}, err\n360|\t}\n361|\t// Coverage is measured over every registered section binding, not only the\n362|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n363|\t// production entry points rather than only the repository-wide one. It is\n364|\t// measured before ownership resolution so that a section moved to the\n365|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n366|\t// as that dodge rather than as an ordinary missing owner.\n367|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n368|\tif err != nil {\n369|\t\treturn Report{}, err\n370|\t}\n371|\townedSections := make(map[string]struct{}, len(coverage))\n372|\tfor key := range coverage {\n373|\t\townedSections[key] = struct{}{}\n374|\t}\n375|\tunowned, err := verifyUnownedSections(\n376|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n377|\tif err != nil {\n378|\t\treturn Report{}, err\n379|\t}\n380|\n381|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n382|\tif err != nil {\n383|\t\treturn Report{}, err\n384|\t}\n385|\n386|\tfor _, binding := range assignedBindings {\n387|\t\tfor _, key := range binding.Keys {\n388|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n389|\t\t\t\treturn Report{}, fail(\n390|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n391|\t\t\t}\n392|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n393|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n394|\t\t\t}\n395|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n396|\t\t\t// deliberately not admitted: the gate cannot see the section's\n397|\t\t\t// obligations, and admitting on an unverifiable justification\n398|\t\t\t// sentence would be self-minted evidence for exactly the class this\n399|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n400|\t\t\t// failure to measure, not a measured absence of obligation.\n401|\t\t\tmeasured := coverage[key]\n402|\t\t\tif measured.Level != coverageFull {\n403|\t\t\t\treturn Report{}, fail(\n404|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n405|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n406|\t\t\t}\n407|\t\t}\n408|\t}\n409|\tfor _, contract := range compatibilityCatalog.Contracts {\n410|\t\tkey := contractKey(contract.Name, string(contract.ID))\n411|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n412|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n413|\t\t}\n414|\t}\n415|\n416|\tcanonical, err := json.Marshal(registry)\n417|\tif err != nil {\n418|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n419|\t}\n420|\tdigest := sha256.Sum256(canonical)\n421|\tgotDigest := hex.EncodeToString(digest[:])\n422|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n423|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n424|\t}\n425|\n426|\treport := Report{\n427|\t\tContracts:              len(expected[ownershipContract]),\n428|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n429|\t\tAcceptanceCases:        len(acceptanceIDs),\n430|\t\tFixtures:               len(expected[ownershipFixture]),\n431|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n432|\t\tAssignedScopes:         len(assignedBindings),\n433|\t\tSectionBindings:        len(coverage),\n434|\t\tUnownedSections:        len(unowned),\n435|\t}\n436|\tfor _, measured := range coverage {\n437|\t\treport.NormativeClauses += measured.Total\n438|\t\treport.DischargedClauses += measured.Discharged\n439|\t\tswitch measured.Level {\n440|\t\tcase coverageFull:\n441|\t\t\treport.FullCoverage++\n442|\t\tcase coveragePartial:\n443|\t\t\treport.PartialCoverage++\n444|\t\tcase coverageSliver:\n445|\t\t\treport.SliverCoverage++\n446|\t\tcase coverageUnevidenced:\n447|\t\t\treport.UnevidencedCoverage++\n448|\t\tcase coverageUnmeasured:\n449|\t\t\treport.UnmeasuredCoverage++\n450|\t\t}\n451|\t}\n452|\treturn report, nil\n453|}\n454|\n455|// verifySectionCoverage measures every registered section binding against the\n456|// pinned document and refuses a coverage claim on any other ownership kind. A\n457|// contract or fixture owner has no section to be measured against, so a\n458|// coverage field there would be a claim the gate cannot check.\n459|func verifySectionCoverage(\n460|\tdocument *specdoc.Document,\n461|\tgroups []ownershipGroup,\n462|\tacceptanceIDs map[string]struct{},\n463|) (map[string]sectionCoverage, error) {\n464|\tresult := make(map[string]sectionCoverage)\n465|\tfor index, group := range groups {\n466|\t\tif group.Kind != ownershipSectionBinding {\n467|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n468|\t\t\t\treturn nil, fail(\n469|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n470|\t\t\t\t\tindex, group.Kind)\n471|\t\t\t}\n472|\t\t\tcontinue\n473|\t\t}\n474|\t\tif len(group.Keys) != 1 {\n475|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n476|\t\t}\n477|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n478|\t\tif err != nil {\n479|\t\t\treturn nil, err\n480|\t\t}\n481|\t\tif _, duplicate := result[measured.Key]; duplicate {\n482|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n483|\t\t}\n484|\t\tresult[measured.Key] = measured\n485|\t}\n486|\treturn result, nil\n487|}\n488|\n489|func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\n490|\tif len(cases) == 0 {\n491|\t\treturn nil, fail(\"acceptance case registry is empty\")\n492|\t}\n493|\tseen := make(map[string]struct{}, len(cases))\n494|\tfor index, acceptance := range cases {\n495|\t\tif acceptance.ID == \"\" {\n496|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n497|\t\t}\n498|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n499|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n500|\t\t}\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4dd","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":201,"recorded_at":1780531400000397,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"0f0f9944-a17a-416e-8458-901ed4582bed"},"task_id":"0f0f9944-a17a-416e-8458-901ed4582bed","event":{"kind":"completed","task_id":"0f0f9944-a17a-416e-8458-901ed4582bed"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4df","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":202,"recorded_at":1780531400000399,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"call_id":"call_01a0789a91c07343af3b40a39a985a6a","text":"Read text file `internal/provhost/doc.go`.\n1|// Package provhost implements the ax host side of the provider plugin\n2|// JSON-over-stdio protocol of pinned specification Section 7.2: one-frame\n3|// JSONL transport, deadlines, size limits, stdout/stderr separation,\n4|// operation dispatch, and status recovery.\n5|//\n6|// The actor every Section 7.2 RFC 2119 keyword governs here is the ax host\n7|// (this repository). The provider plugin is a child process this package\n8|// starts but never trusts: every byte it emits is attacker-influenced, so\n9|// every frame is validated before any member is used, and a different-major\n10|// payload is never parsed far enough to trust its error code, retryable\n11|// bit, details, or authority fields (Section 15.1).\n12|//\n13|// This package owns the envelope layer and the operation-layer\n14|// conformance decoders. Operation dispatch means the host maps an\n15|// operation name to one plugin invocation and refuses unknown names\n16|// locally without spawning; the conformance decoders validate what a\n17|// plugin returned: the closed manifest (7.3), probe and capability\n18|// gate (7.4, 8.3), profile mapping (7.7), quiescence proof (7.6),\n19|// SpawnPlan success bodies for launch and resume, the Provider\n20|// Identity Record and identify-session result (5.5), and the single\n21|// (operation, operation_id) mutation key (7.5). Full Section 7.5\n22|// request-body vocabularies beyond these surfaces, and the\n23|// materialize commit/rollback result bodies, cross this package\n24|// opaquely: a body must still be a JSON object, and the\n25|// materialize-status body this package interprets for recovery must\n26|// satisfy the state/nullability/identity rules Section 7.5 states\n27|// for ProviderTransactionStatus.\n28|//\n29|// A failed read is never an absence: a crashed, timed-out, oversized,\n30|// unparsable, or correlation-mismatched invocation fails with a local\n31|// Structured Error 1.0.0, never with a partial response the caller could\n32|// mistake for a result. Status recovery is fail-closed the same way: an\n33|// unknown or integrity-invalid transaction fails with integrity_failure\n34|// and must be quarantined rather than represented as a successful status.\n35|//\n36|// The package mutates no durable state of its own and keeps no cross-call\n37|// cache: Host starts one plugin process per operation, so successive calls\n38|// are separate processes observing durable state through the authority the\n39|// caller passes, which is the property the cross-process recovery cases\n40|// rest on. Retry decisions belong to the caller; every local failure this\n41|// package emits is non-retryable, because nothing observed at an unusable\n42|// frame licenses a safe-retry claim.\n43|//\n44|// Stated bounds: stderr capture is capped at 1 MiB (an implementation\n45|// resource bound, not a protocol limit); error details carry the failure\n46|// class, member names, and the observed version string only — never\n47|// environment or stderr content. Mutation receipts live in the\n48|// provider transaction document and the plugin, not in the host: the\n49|// host holds no cross-call cache, so cross-crash durability of\n50|// (operation, operation_id) results is the document's property, and\n51|// the host side pins the sole key shape, byte-identical retry bytes,\n52|// and the mismatch surface. The Section 8 provider/platform cell\n53|// values are evidence labels, not host behavior: the host pins the\n54|// fail-closed direction (conditional, unsupported, and unknown are\n55|// never usable) for every capability-by-status tuple rather than one\n56|// cell value. Section 8.2 store-exclusion roots and the remaining\n57|// Section 7.5 request vocabularies have no host production yet.\n58|//\n59|// Provider Protocol 3.0.0, which the v0.5.0 catalog pins alongside\n60|// 2.0.0, has no implementation owner in this package: this host\n61|// speaks major 2 only, classifies any recognizable 3.x envelope as\n62|// incompatible_protocol without trusting its payload, and carries no\n63|// Structured Error 1.3.0 binding or launch/resume descriptor carriage.\n64|// A v3 plugin is therefore refused loudly rather than misread as v2;\n65|// naming the v3 envelope owner is open work, not a silent scope.\n66|package provhost","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"call_id":"call_01a0789a926c7df2bbce478854d774ad","text":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n9|)\n10|\n11|// This file validates the Provider Identity Record (Section 5.5,\n12|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n13|// identify-session results and carries in launch, resume, quiesce,\n14|// and fork bodies, plus the identify-session success wrapper. The\n15|// record_id is required to be a digest but is not recomputed here:\n16|// content addressing belongs to the object-identity story, and this\n17|// package holds no canonical encoder. The opaque_identity absolute\n18|// prefix rule mirrors the decidable half of the Section 5.5\n19|// sentence: a value beginning with an absolute path is refused, and\n20|// an embedded path the prefix cannot see is a stated bound.\n21|//\n22|// CheckIdentity validates the record shape in this package's provider-stdio\n23|// dialect (provider_protocol_error with member attribution, which the\n24|// shared package cannot mint) and conjoins the verdict with the owner's\n25|// production identity entry canonicaljson.CalculateObjectIdentity: the two\n26|// validators must agree on the Section 5.5 shape rule for rule, and a\n27|// document the dialect admits but the owner refuses is refused at the\n28|// owner gate below. The decoder half of that agreement is pinned by the\n29|// derived TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON sweep,\n30|// which judges escape and raw-UTF-8 vectors through the shared\n31|// decodeStrictObject every entry here reads through, and any shape-rule\n32|// change must land in both validators in the same change.\n33|\n34|// identitySchema is the exact schema identifier the record carries.\n35|const identitySchema = \"urn:ax:schema:provider-identity\"\n36|\n37|// identitySchemaVersion is the only identity version accepted.\n38|const identitySchemaVersion = \"1.0.0\"\n39|\n40|// identityKinds is the closed identity-kind enum in section order.\n41|var identityKinds = []string{\n42|\t\"session_uuid\",\n43|\t\"session_path_or_id\",\n44|\t\"backend_conversation_uuid\",\n45|\t\"task_board_managed\",\n46|\t\"provider_defined\",\n47|}\n48|\n49|// identityMembers is the exact required member set of a Provider\n50|// Identity Record.\n51|var identityMembers = map[string]bool{\n52|\t\"schema\":                    true,\n53|\t\"schema_version\":            true,\n54|\t\"record_id\":                 true,\n55|\t\"subject_id\":                true,\n56|\t\"session_id\":                true,\n57|\t\"provider_id\":               true,\n58|\t\"provider_version\":          true,\n59|\t\"provider_version_range\":    true,\n60|\t\"native_session_id\":         true,\n61|\t\"identity_kind\":             true,\n62|\t\"logical_workspace_id\":      true,\n63|\t\"backend_realm_fingerprint\": true,\n64|\t\"opaque_identity\":           true,\n65|\t\"created_by_host_id\":        true,\n66|\t\"created_at\":                true,\n67|\t\"extensions\":                true,\n68|}\n69|\n70|// identityRequired lists identityMembers in a fixed order so a record\n71|// missing several members always names the same one.\n72|var identityRequired = []string{\n73|\t\"schema\",\n74|\t\"schema_version\",\n75|\t\"record_id\",\n76|\t\"subject_id\",\n77|\t\"session_id\",\n78|\t\"provider_id\",\n79|\t\"provider_version\",\n80|\t\"provider_version_range\",\n81|\t\"native_session_id\",\n82|\t\"identity_kind\",\n83|\t\"logical_workspace_id\",\n84|\t\"backend_realm_fingerprint\",\n85|\t\"opaque_identity\",\n86|\t\"created_by_host_id\",\n87|\t\"created_at\",\n88|\t\"extensions\",\n89|}\n90|\n91|// identityKeyPattern is the provider-identity key grammar Section 5.5\n92|// states: [a-z][a-z0-9_.-]{0,63}.\n93|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n94|\n95|// windowsDrivePattern matches a Windows drive-qualified absolute\n96|// prefix: a letter, a colon, and a separator.\n97|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n98|\n99|// CheckIdentity validates one Provider Identity Record naming the\n100|// expected provider. Shape violations are provider_protocol_errors;\n101|// a well-formed record for another provider is an invalid_config\n102|// caller error: the caller correlated the wrong identity to this\n103|// session.\n104|func CheckIdentity(body []byte, wantProviderID string) error {\n105|\tmembers, fault := decodeStrictObject(body)\n106|\tif fault != nil {\n107|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n108|\t\tif err != nil {\n109|\t\t\treturn err\n110|\t\t}\n111|\t\treturn failure\n112|\t}\n113|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n114|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n115|\t\tif err != nil {\n116|\t\t\treturn err\n117|\t\t}\n118|\t\treturn failure\n119|\t}\n120|\tif name, missing := missingMember(members, identityRequired); missing {\n121|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n122|\t\tif err != nil {\n123|\t\t\treturn err\n124|\t\t}\n125|\t\treturn failure\n126|\t}\n127|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n128|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n129|\t\tif err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\treturn failure\n133|\t}\n134|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n135|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n136|\t\tif err != nil {\n137|\t\t\treturn err\n138|\t\t}\n139|\t\treturn failure\n140|\t}\n141|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n142|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n143|\t\tif err != nil {\n144|\t\t\treturn err\n145|\t\t}\n146|\t\treturn failure\n147|\t}\n148|\tsubject, ok := rawString(members[\"subject_id\"])\n149|\tif !ok || !isUUIDv7(subject) {\n150|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n151|\t\tif err != nil {\n152|\t\t\treturn err\n153|\t\t}\n154|\t\treturn failure\n155|\t}\n156|\tsession, ok := rawString(members[\"session_id\"])\n157|\tif !ok || !isUUIDv7(session) {\n158|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n159|\t\tif err != nil {\n160|\t\t\treturn err\n161|\t\t}\n162|\t\treturn failure\n163|\t}\n164|\tif subject != session {\n165|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n166|\t\tif err != nil {\n167|\t\t\treturn err\n168|\t\t}\n169|\t\treturn failure\n170|\t}\n171|\tprovider, ok := rawString(members[\"provider_id\"])\n172|\tif !ok || !validProviderID(provider) {\n173|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n174|\t\tif err != nil {\n175|\t\t\treturn err\n176|\t\t}\n177|\t\treturn failure\n178|\t}\n179|\tif provider != wantProviderID {\n180|\t\tfailure, err := failInvalid(\"identity names another provider\")\n181|\t\tif err != nil {\n182|\t\t\treturn err\n183|\t\t}\n184|\t\treturn failure\n185|\t}\n186|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n187|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\treturn failure\n192|\t}\n193|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n194|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n195|\t\tif err != nil {\n196|\t\t\treturn err\n197|\t\t}\n198|\t\treturn failure\n199|\t}\n200|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n201|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n202|\t\tif err != nil {\n203|\t\t\treturn err\n204|\t\t}\n205|\t\treturn failure\n206|\t}\n207|\tkind, ok := rawString(members[\"identity_kind\"])\n208|\tif !ok || !isIdentityKind(kind) {\n209|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n210|\t\tif err != nil {\n211|\t\t\treturn err\n212|\t\t}\n213|\t\treturn failure\n214|\t}\n215|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n216|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n217|\t\tif err != nil {\n218|\t\t\treturn err\n219|\t\t}\n220|\t\treturn failure\n221|\t}\n222|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n223|\t\treturn err\n224|\t}\n225|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n226|\t\treturn err\n227|\t}\n228|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n229|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n230|\t\tif err != nil {\n231|\t\t\treturn err\n232|\t\t}\n233|\t\treturn failure\n234|\t}\n235|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n236|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n237|\t\tif err != nil {\n238|\t\t\treturn err\n239|\t\t}\n240|\t\treturn failure\n241|\t}\n242|\tif !isJSONObject(members[\"extensions\"]) {\n243|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n244|\t\tif err != nil {\n245|\t\t\treturn err\n246|\t\t}\n247|\t\treturn failure\n248|\t}\n249|\t// The member arms above are this package's provider-stdio dialect of\n250|\t// the Section 5.5 rule; the owner of that rule is canonicaljson\n251|\t// (validateProviderIdentityRecord, registered for section:5.5 in the\n252|\t// traceability registry), and the dialect keeps its member attribution\n253|\t// deliberately. The verdict is therefore conjoined with the owner's\n254|\t// production identity entry: a document this dialect admits but the\n255|\t// owner refuses — open extensions content, a number the dialect never\n256|\t// reads, nesting beyond the dialect's view — is refused here rather\n257|\t// than admitted through a drifted copy. The provider-equality\n258|\t// correlation above stays host-side: it is a caller rule, not a\n259|\t// content rule, and the owner never sees it.\n260|\tif _, _, err := canonicaljson.CalculateObjectIdentity(body); err != nil {\n261|\t\tfailure, ferr := failProtocol(\"identity is not a valid provider identity\", \"\")\n262|\t\tif ferr != nil {\n263|\t\t\treturn ferr\n264|\t\t}\n265|\t\treturn failure\n266|\t}\n267|\treturn nil\n268|}\n269|\n270|// checkIdentityRealm enforces the digest-or-null shape and the one\n271|// conditional rule Section 5.5 states: an Antigravity\n272|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n273|// because the backend realm is a resume precondition there.\n274|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n275|\trealm, isNull, ok := rawNullableString(raw)\n276|\tif !ok || (!isNull && !isDigest(realm)) {\n277|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n278|\t\tif err != nil {\n279|\t\t\treturn err\n280|\t\t}\n281|\t\treturn failure\n282|\t}\n283|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n284|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n285|\t\tif err != nil {\n286|\t\t\treturn err\n287|\t\t}\n288|\t\treturn failure\n289|\t}\n290|\treturn nil\n291|}\n292|\n293|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n294|// object of at most 32 entries, keyed by the provider-identity key\n295|// grammar, with non-secret string values of 1..1,024 characters that\n296|// MUST NOT begin with an absolute path.\n297|func checkIdentityOpaque(raw json.RawMessage) error {\n298|\topaque, fault := decodeStrictObject(raw)\n299|\tif fault != nil {\n300|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n301|\t\tif err != nil {\n302|\t\t\treturn err\n303|\t\t}\n304|\t\treturn failure\n305|\t}\n306|\tif len(opaque) > 32 {\n307|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n308|\t\tif err != nil {\n309|\t\t\treturn err\n310|\t\t}\n311|\t\treturn failure\n312|\t}\n313|\tkeys := make([]string, 0, len(opaque))\n314|\tfor key := range opaque {\n315|\t\tkeys = append(keys, key)\n316|\t}\n317|\tfor _, key := range keys {\n318|\t\tif !identityKeyPattern.MatchString(key) {\n319|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n320|\t\t\tif err != nil {\n321|\t\t\t\treturn err\n322|\t\t\t}\n323|\t\t\treturn failure\n324|\t\t}\n325|\t\tvalue, ok := rawString(opaque[key])\n326|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n327|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n328|\t\t\tif err != nil {\n329|\t\t\t\treturn err\n330|\t\t\t}\n331|\t\t\treturn failure\n332|\t\t}\n333|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n334|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n335|\t\t\tif err != nil {\n336|\t\t\t\treturn err\n337|\t\t\t}\n338|\t\t\treturn failure\n339|\t\t}\n340|\t}\n341|\treturn nil\n342|}\n343|\n344|func isIdentityKind(value string) bool {\n345|\tfor _, kind := range identityKinds {\n346|\t\tif value == kind {\n347|\t\t\treturn true\n348|\t\t}\n349|\t}\n350|\treturn false\n351|}\n352|\n353|// identifyMembers is the exact required member set of an\n354|// identify-session success body.\n355|var identifyMembers = map[string]bool{\n356|\t\"identity\":         true,\n357|\t\"confidence\":       true,\n358|\t\"matched_evidence\": true,\n359|}\n360|\n361|// identifyRequired lists identifyMembers in a fixed order.\n362|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n363|\n364|// identifyConfidences is the closed confidence vocabulary.\n365|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n366|\n367|// identifyEvidence is the closed matched-evidence vocabulary.\n368|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n369|\n370|// DecodeIdentifyResult validates one identify-session success body:\n371|// the Provider Identity Record for the expected provider, a closed\n372|// confidence, and 1..4 sorted unique matched-evidence members.\n373|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n374|\tmembers, fault := decodeStrictObject(body)\n375|\tif fault != nil {\n376|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n377|\t\tif err != nil {\n378|\t\t\treturn err\n379|\t\t}\n380|\t\treturn failure\n381|\t}\n382|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n383|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n384|\t\tif err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t\treturn failure\n388|\t}\n389|\tif name, missing := missingMember(members, identifyRequired); missing {\n390|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n391|\t\tif err != nil {\n392|\t\t\treturn err\n393|\t\t}\n394|\t\treturn failure\n395|\t}\n396|\tconfidence, ok := rawString(members[\"confidence\"])\n397|\tif !ok || !isIdentifyConfidence(confidence) {\n398|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n399|\t\tif err != nil {\n400|\t\t\treturn err\n401|\t\t}\n402|\t\treturn failure\n403|\t}\n404|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n405|\t\treturn err\n406|\t}\n407|\tif !isJSONObject(members[\"identity\"]) {\n408|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n409|\t\tif err != nil {\n410|\t\t\treturn err\n411|\t\t}\n412|\t\treturn failure\n413|\t}\n414|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n415|\t\treturn err\n416|\t}\n417|\treturn nil\n418|}\n419|\n420|func isIdentifyConfidence(value string) bool {\n421|\tfor _, confidence := range identifyConfidences {\n422|\t\tif value == confidence {\n423|\t\t\treturn true\n424|\t\t}\n425|\t}\n426|\treturn false\n427|}\n428|\n429|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n430|// evidence members: the observation must cite what matched, exactly\n431|// once each.\n432|func checkIdentifyEvidence(raw json.RawMessage) error {\n433|\tevidence, ok := rawStringArray(raw)\n434|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n435|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n436|\t\tif err != nil {\n437|\t\t\treturn err\n438|\t\t}\n439|\t\treturn failure\n440|\t}\n441|\tallowed := map[string]bool{}\n442|\tfor _, member := range identifyEvidence {\n443|\t\tallowed[member] = true\n444|\t}\n445|\tfor _, member := range evidence {\n446|\t\tif !allowed[member] {\n447|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n448|\t\t\tif err != nil {\n449|\t\t\t\treturn err\n450|\t\t\t}\n451|\t\t\treturn failure\n452|\t\t}\n453|\t}\n454|\tif !sortedUniqueStrings(evidence) {\n455|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n456|\t\tif err != nil {\n457|\t\t\treturn err\n458|\t\t}\n459|\t\treturn failure\n460|\t}\n461|\treturn nil\n462|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"call_id":"call_01a0789a92d770f3aafba0bc617e68b3","text":"Read text file `internal/traceability/traceability.go`.\n1|// Package traceability verifies that the pinned AX specification inventory\n2|// remains bound to concrete production declarations and executable acceptance\n3|// cases. It is a read-only repository gate; it does not advertise runtime\n4|// capabilities or mutate implementation state.\n5|package traceability\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"crypto/sha256\"\n10|\t\"encoding/hex\"\n11|\t\"encoding/json\"\n12|\t\"errors\"\n13|\t\"fmt\"\n14|\t\"go/ast\"\n15|\t\"go/parser\"\n16|\t\"go/token\"\n17|\t\"io\"\n18|\t\"io/fs\"\n19|\t\"path\"\n20|\t\"regexp\"\n21|\t\"strings\"\n22|\t\"unicode\"\n23|\t\"unicode/utf8\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n29|)\n30|\n31|const (\n32|\townershipRegistryPath = \"internal/traceability/ownership.v0.5.0.json\"\n33|\tcontractLockPath      = \"internal/specpin/v0.5.0.lock.json\"\n34|\tcatalogMetadataPath   = \"internal/catalog/catalog.v0.5.0.json\"\n35|\tgeneratedCatalogPath  = \"internal/catalog/catalog_gen.go\"\n36|\n37|\townershipFormat        = \"ax-spec-to-code-ownership\"\n38|\townershipFormatVersion = 1\n39|\n40|\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\n41|\t// formatting may change, but ownership claims cannot be self-minted without\n42|\t// an explicit review of this binding.\n43|\treviewedOwnershipCanonicalSHA256 = \"5581f5eb95bfc5762bb4af0d72b6895c5f4da9bcd63d14709124bd264de1b489\"\n44|)\n45|\n46|var ErrTraceability = errors.New(\"spec-to-code traceability check failed\")\n47|\n48|// Report contains inventory coverage only. These counts do not claim that any\n49|// runtime capability is available, enabled, or supported.\n50|type Report struct {\n51|\tContracts              int\n52|\tNormativeSections      int\n53|\tAcceptanceCases        int\n54|\tFixtures               int\n55|\tCompatibilityContracts int\n56|\tAssignedScopes         int\n57|\n58|\t// SectionBindings and the coverage counters below are a measured ratio over\n59|\t// the registered section bindings, not a prose claim. NormativeClauses is\n60|\t// the number of RFC 2119 clause lines the pinned document itself carries in\n61|\t// the bound sections; DischargedClauses is how many of those a binding\n62|\t// enumerates with a verified excerpt and an acceptance owner.\n63|\tSectionBindings     int\n64|\tFullCoverage        int\n65|\tPartialCoverage     int\n66|\tSliverCoverage      int\n67|\tUnevidencedCoverage int\n68|\tUnmeasuredCoverage  int\n69|\tUnownedSections     int\n70|\tNormativeClauses    int\n71|\tDischargedClauses   int\n72|}\n73|\n74|type ownershipKind string\n75|\n76|const (\n77|\townershipContract         ownershipKind = \"contract\"\n78|\townershipNormativeSection ownershipKind = \"normative_section\"\n79|\townershipSectionBinding   ownershipKind = \"section_binding\"\n80|\townershipFixture          ownershipKind = \"fixture\"\n81|)\n82|\n83|type ownershipRegistry struct {\n84|\tFormat          string           `json:\"format\"`\n85|\tFormatVersion   int              `json:\"format_version\"`\n86|\tSource          registrySource   `json:\"source\"`\n87|\tAcceptanceCases []acceptanceCase `json:\"acceptance_cases\"`\n88|\tOwnership       []ownershipGroup `json:\"ownership\"`\n89|\tUnownedSections []unownedSection `json:\"unowned_sections\"`\n90|}\n91|\n92|// unownedSection records a real v0.5.0 section that this repository does not\n93|// implement. It exists so an unimplemented section is disclosed by name rather\n94|// than bound to a symbol from a neighbouring package, which is what an owned\n95|// key would otherwise assert. It is a disclosure, never an exemption: a section\n96|// the generated catalog requires an owner for may not be declared here, and\n97|// assigned-scope admission refuses an unowned section and prints its gap.\n98|type unownedSection struct {\n99|\tKey      string `json:\"key\"`\n100|\tGap      string `json:\"gap\"`\n101|\tEvidence string `json:\"evidence\"`\n102|}\n103|\n104|type registrySource struct {\n105|\tRepository     string `json:\"repository\"`\n106|\tRelease        string `json:\"release\"`\n107|\tCommit         string `json:\"commit\"`\n108|\tDocumentPath   string `json:\"document_path\"`\n109|\tDocumentSHA256 string `json:\"document_sha256\"`\n110|}\n111|\n112|type acceptanceCase struct {\n113|\tID         string          `json:\"id\"`\n114|\tProduction codeReference   `json:\"production\"`\n115|\tTests      []codeReference `json:\"tests\"`\n116|}\n117|\n118|type ownershipGroup struct {\n119|\tKind            ownershipKind      `json:\"kind\"`\n120|\tKeys            []string           `json:\"keys\"`\n121|\tProduction      codeReference      `json:\"production\"`\n122|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n123|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n124|\tGap             string             `json:\"gap,omitempty\"`\n125|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n126|}\n127|\n128|// coverageLevel is how much of a bound section a binding claims to discharge.\n129|// The claim is not taken on trust: the level is recomputed from the clauses the\n130|// binding enumerates against the clause inventory the pinned specification\n131|// itself carries for that section, and a claim that differs from the measured\n132|// level is refused.\n133|type coverageLevel string\n134|\n135|const (\n136|\t// coverageFull means every normative clause the pinned section carries is\n137|\t// enumerated with a verified excerpt and an acceptance owner.\n138|\tcoverageFull coverageLevel = \"full\"\n139|\t// coveragePartial means at least half of them are.\n140|\tcoveragePartial coverageLevel = \"partial\"\n141|\t// coverageSliver means fewer than half are: the binding implements a corner\n142|\t// of the section it is registered against.\n143|\tcoverageSliver coverageLevel = \"sliver\"\n144|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n145|\t// the registry makes no clause-level claim, not that the implementation\n146|\t// covers nothing.\n147|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n148|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n149|\t// under the section's heading or its subheadings, so the gate cannot\n150|\t// measure the section's obligations at all.\n151|\t//\n152|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n153|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n154|\t// this class and every one of them has a substantive body: Section 15.2 is a\n155|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n156|\t// Provider Manifest, both of which state their obligations as tables rather\n157|\t// than in uppercase RFC 2119 keywords. Treating that silence as \"nothing to\n158|\t// discharge\" is the same free pass this gate exists to remove, reached\n159|\t// through the scanner instead of through the label, so an unmeasured binding\n160|\t// carries the same mandatory gap as every other level below full and is\n161|\t// refused for assigned-scope admission.\n162|\tcoverageUnmeasured coverageLevel = \"unmeasured\"\n163|)\n164|\n165|// dischargedClause binds one normative clause of the pinned section to the\n166|// acceptance cases that discharge it. Every field is checked against the\n167|// hash-verified document: the identifier must index the section's own clause\n168|// inventory, the line must be the line that clause occupies, and the excerpt\n169|// must be that clause's text quoted verbatim, so a clause cannot be claimed\n170|// with a true sentence about something else.\n171|type dischargedClause struct {\n172|\tID              string   `json:\"id\"`\n173|\tLine            int      `json:\"line\"`\n174|\tExcerpt         string   `json:\"excerpt\"`\n175|\tAcceptanceCases []string `json:\"acceptance_cases\"`\n176|}\n177|\n178|// normativeClause is one RFC 2119 clause line of the pinned specification,\n179|// measured from the document rather than declared by the registry.\n180|type normativeClause struct {\n181|\tID   string\n182|\tLine int\n183|\tText string\n184|}\n185|\n186|type codeReference struct {\n187|\tPath        string `json:\"path\"`\n188|\tDeclaration string `json:\"declaration\"`\n189|}\n190|\n191|type assignedSectionBinding struct {\n192|\tScope string\n193|\tKeys  []string\n194|}\n195|\n196|var assignedSectionPattern = regexp.MustCompile(`^((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*)(?:-((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*))?$`)\n197|var catalogAppendixPattern = regexp.MustCompile(`(?i)^Appendix ([A-D]):`)\n198|\n199|// VerifyRepository is the production CI entry point. It verifies exact pinned\n200|// inputs, stale generated output, compatibility coverage, and every registered\n201|// ownership reference against the supplied repository filesystem.\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.Verify(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV050)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n255|\tif err != nil {\n256|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n257|\t}\n258|\n259|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n260|\tif err != nil {\n261|\t\treturn Report{}, err\n262|\t}\n263|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n264|\tif err != nil {\n265|\t\treturn Report{}, err\n266|\t}\n267|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n268|\tif err != nil {\n269|\t\treturn Report{}, err\n270|\t}\n271|\tdocument, err := specdoc.Load()\n272|\tif err != nil {\n273|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n274|\t}\n275|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256 {\n276|\t\treturn Report{}, fail(\n277|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n278|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256)\n279|\t}\n280|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n281|}\n282|\n283|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n284|\tvalue, err := fs.ReadFile(repository, filename)\n285|\tif err != nil {\n286|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n287|\t}\n288|\treturn value, nil\n289|}\n290|\n291|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n292|\tvar decoded ownershipRegistry\n293|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n294|\tdecoder.DisallowUnknownFields()\n295|\tif err := decoder.Decode(&decoded); err != nil {\n296|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n297|\t}\n298|\tvar trailing any\n299|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n300|\t\tif err == nil {\n301|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n302|\t\t}\n303|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n304|\t}\n305|\treturn decoded, nil\n306|}\n307|\n308|func verifyOwnership(\n309|\trepository fs.FS,\n310|\tdocument *specdoc.Document,\n311|\tregistry ownershipRegistry,\n312|\tmanifest specpin.Manifest,\n313|\tcurrentCatalog catalog.Catalog,\n314|\tcompatibilityCatalog catalog.Catalog,\n315|\tassignedBindings []assignedSectionBinding,\n316|) (Report, error) {\n317|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n318|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n319|\t}\n320|\tsource := registry.Source\n321|\tif source.Repository != manifest.Source.Repository ||\n322|\t\tsource.Release != manifest.Source.Release ||\n323|\t\tsource.Commit != manifest.Source.Commit ||\n324|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n325|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n326|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n327|\t}\n328|\n329|\texpected := map[ownershipKind]map[string]struct{}{\n330|\t\townershipContract:         expectedContracts(manifest.Contracts),\n331|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n332|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n333|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n334|\t}\n335|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n336|\tif err != nil {\n337|\t\treturn Report{}, err\n338|\t}\n339|\trequired := map[ownershipKind]map[string]struct{}{\n340|\t\townershipContract:         expected[ownershipContract],\n341|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n342|\t\townershipSectionBinding:   requiredSectionBindings,\n343|\t\townershipFixture:          expected[ownershipFixture],\n344|\t}\n345|\tselectedSectionBindings := map[string]struct{}(nil)\n346|\tif assignedBindings != nil {\n347|\t\trequired = cloneOwnershipSets(expected)\n348|\t\tselectedSectionBindings = make(map[string]struct{})\n349|\t\tfor _, binding := range assignedBindings {\n350|\t\t\tfor _, key := range binding.Keys {\n351|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n352|\t\t\t}\n353|\t\t}\n354|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n355|\t}\n356|\tchecker := newSourceChecker(repository)\n357|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n358|\tif err != nil {\n359|\t\treturn Report{}, err\n360|\t}\n361|\t// Coverage is measured over every registered section binding, not only the\n362|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n363|\t// production entry points rather than only the repository-wide one. It is\n364|\t// measured before ownership resolution so that a section moved to the\n365|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n366|\t// as that dodge rather than as an ordinary missing owner.\n367|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n368|\tif err != nil {\n369|\t\treturn Report{}, err\n370|\t}\n371|\townedSections := make(map[string]struct{}, len(coverage))\n372|\tfor key := range coverage {\n373|\t\townedSections[key] = struct{}{}\n374|\t}\n375|\tunowned, err := verifyUnownedSections(\n376|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n377|\tif err != nil {\n378|\t\treturn Report{}, err\n379|\t}\n380|\n381|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n382|\tif err != nil {\n383|\t\treturn Report{}, err\n384|\t}\n385|\n386|\tfor _, binding := range assignedBindings {\n387|\t\tfor _, key := range binding.Keys {\n388|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n389|\t\t\t\treturn Report{}, fail(\n390|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n391|\t\t\t}\n392|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n393|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n394|\t\t\t}\n395|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n396|\t\t\t// deliberately not admitted: the gate cannot see the section's\n397|\t\t\t// obligations, and admitting on an unverifiable justification\n398|\t\t\t// sentence would be self-minted evidence for exactly the class this\n399|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n400|\t\t\t// failure to measure, not a measured absence of obligation.\n401|\t\t\tmeasured := coverage[key]\n402|\t\t\tif measured.Level != coverageFull {\n403|\t\t\t\treturn Report{}, fail(\n404|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n405|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n406|\t\t\t}\n407|\t\t}\n408|\t}\n409|\tfor _, contract := range compatibilityCatalog.Contracts {\n410|\t\tkey := contractKey(contract.Name, string(contract.ID))\n411|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n412|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n413|\t\t}\n414|\t}\n415|\n416|\tcanonical, err := json.Marshal(registry)\n417|\tif err != nil {\n418|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n419|\t}\n420|\tdigest := sha256.Sum256(canonical)\n421|\tgotDigest := hex.EncodeToString(digest[:])\n422|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n423|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n424|\t}\n425|\n426|\treport := Report{\n427|\t\tContracts:              len(expected[ownershipContract]),\n428|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n429|\t\tAcceptanceCases:        len(acceptanceIDs),\n430|\t\tFixtures:               len(expected[ownershipFixture]),\n431|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n432|\t\tAssignedScopes:         len(assignedBindings),\n433|\t\tSectionBindings:        len(coverage),\n434|\t\tUnownedSections:        len(unowned),\n435|\t}\n436|\tfor _, measured := range coverage {\n437|\t\treport.NormativeClauses += measured.Total\n438|\t\treport.DischargedClauses += measured.Discharged\n439|\t\tswitch measured.Level {\n440|\t\tcase coverageFull:\n441|\t\t\treport.FullCoverage++\n442|\t\tcase coveragePartial:\n443|\t\t\treport.PartialCoverage++\n444|\t\tcase coverageSliver:\n445|\t\t\treport.SliverCoverage++\n446|\t\tcase coverageUnevidenced:\n447|\t\t\treport.UnevidencedCoverage++\n448|\t\tcase coverageUnmeasured:\n449|\t\t\treport.UnmeasuredCoverage++\n450|\t\t}\n451|\t}\n452|\treturn report, nil\n453|}\n454|\n455|// verifySectionCoverage measures every registered section binding against the\n456|// pinned document and refuses a coverage claim on any other ownership kind. A\n457|// contract or fixture owner has no section to be measured against, so a\n458|// coverage field there would be a claim the gate cannot check.\n459|func verifySectionCoverage(\n460|\tdocument *specdoc.Document,\n461|\tgroups []ownershipGroup,\n462|\tacceptanceIDs map[string]struct{},\n463|) (map[string]sectionCoverage, error) {\n464|\tresult := make(map[string]sectionCoverage)\n465|\tfor index, group := range groups {\n466|\t\tif group.Kind != ownershipSectionBinding {\n467|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n468|\t\t\t\treturn nil, fail(\n469|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n470|\t\t\t\t\tindex, group.Kind)\n471|\t\t\t}\n472|\t\t\tcontinue\n473|\t\t}\n474|\t\tif len(group.Keys) != 1 {\n475|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n476|\t\t}\n477|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n478|\t\tif err != nil {\n479|\t\t\treturn nil, err\n480|\t\t}\n481|\t\tif _, duplicate := result[measured.Key]; duplicate {\n482|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n483|\t\t}\n484|\t\tresult[measured.Key] = measured\n485|\t}\n486|\treturn result, nil\n487|}\n488|\n489|func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\n490|\tif len(cases) == 0 {\n491|\t\treturn nil, fail(\"acceptance case registry is empty\")\n492|\t}\n493|\tseen := make(map[string]struct{}, len(cases))\n494|\tfor index, acceptance := range cases {\n495|\t\tif acceptance.ID == \"\" {\n496|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n497|\t\t}\n498|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n499|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n500|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
