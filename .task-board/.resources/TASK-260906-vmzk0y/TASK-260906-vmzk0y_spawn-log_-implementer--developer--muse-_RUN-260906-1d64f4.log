{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d141","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":1787,"recorded_at":1780531400003569,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"26d05b56-cf3e-4e46-9f36-99b193b1bc39"},"task_id":"26d05b56-cf3e-4e46-9f36-99b193b1bc39","event":{"kind":"output","task_id":"26d05b56-cf3e-4e46-9f36-99b193b1bc39","chunk":"edited\nchanged lines: lines 547-568\n--- original\n+++ updated\n@@\n-\t// The version gate above admitted only 2.0.0, so the observed major\n-\t// is 2 on every reachable path; it is still derived from the\n-\t// envelope rather than restated, so a future admitted major cannot\n-\t// silently inherit the 1.0.0 binding.\n-\tobservedMajor, _ := parseMajor(version)\n-\terrorVersion, err := errorVersionForMajor(observedMajor)\n-\tif err != nil {\n-\t\tfailure, fault := failProtocol(\"error is not a bound Structured Error\", \"error\")\n-\t\tif fault != nil {\n-\t\t\treturn Response{}, fault\n-\t\t}\n-\t\treturn Response{}, failure\n-\t}\n-\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}, members[\"error\"])\n-\tif err != nil {\n-\t\t_ = errorVersion\n-\t\tfailure, fault := failProtocol(\"error is not a bound Structured Error 1.0.0\", \"error\")\n-\t\tif fault != nil {\n-\t\t\treturn Response{}, fault\n-\t\t}\n-\t\treturn Response{}, failure\n-\t}\n+\t// The failure-error version is selected by the observed envelope\n+\t// major through the static Section 15.1/17.1 table, never from the\n+\t// document: major 2 decodes under Structured Error 1.0.0, and major\n+\t// 3 would decode under Structured Error 1.3.0. Only 2.0.0 reaches\n+\t// this line — a recognizable 3.x envelope was refused above as a\n+\t// major mismatch, because a v2-only host never trusts a different\n+\t// major's error (Section 7.A) — so the contract below carries major\n+\t// 2 on every reachable path today, and admits 1.3.0 by construction\n+\t// the day the version gate admits 3.0.0. The blank parse result is\n+\t// total here: the gate above admitted exactly \"2.0.0\".\n+\tobservedMajor, _ := parseMajor(version)\n+\tchild, err := axerror.DecodeBound(axerror.ContainingContract{ID: ProtocolID, Major: observedMajor}, members[\"error\"])\n+\tif err != nil {\n+\t\tfailure, fault := failProtocol(\"error is not a bound Structured Error 1.0.0\", \"error\")\n+\t\tif fault != nil {\n+\t\t\treturn Response{}, fault\n+\t\t}\n+\t\treturn Response{}, failure\n+\t}\n"}}}
