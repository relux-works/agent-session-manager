{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d4c3","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":2236,"recorded_at":1780531400004467,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"4f414415-0080-42a2-9f5c-f999a57e3d7d"},"task_id":"4f414415-0080-42a2-9f5c-f999a57e3d7d","event":{"kind":"output","task_id":"4f414415-0080-42a2-9f5c-f999a57e3d7d","chunk":"{\n  \"chunk_id\": \"exec-92-1\",\n  \"command\": \"task-board resource --help 2>&1 | head; task-board m --help 2>&1 | grep -i \\\"resource\\\\|outcome\\\" | head; echo ===; task-board handoff --help 2>&1 | head -30\",\n  \"description\": \"Learn resource and handoff commands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n===\\nResolve the configured role end status, verify every checklist item and\\nat least one stored task-scoped outcome resource, and apply the ordinary\\ncascading status transition under one mutation lock.\\n\\nThe command fails closed with all missing evidence and does not change status.\\nAttach or update the outcome with the resource or mutation CLI before handoff.\\n\\nUsage:\\n  task-board handoff <ELEMENT-ID> [flags]\\n\\nFlags:\\n      --commit-ack string   Mover acknowledgement for an enforced done transition\\n      --format string       Output format: compact or json (default \\\"compact\\\")\\n  -h, --help                help for handoff\\n      --role string         Role whose configured end_status must be applied\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 2058,\n  \"original_output_tokens\": 515,\n  \"truncated\": false\n}"}}}
