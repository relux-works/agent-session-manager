ol) {\\n35:// missingMember names the first required member with no value, if any.\\n36:func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\\n45:// rawString reads a JSON string member.\\n46:func rawString(raw json.RawMessage) (string, bool) {\\n54:// rawBool reads a JSON boolean member.\\n55:func rawBool(raw json.RawMessage) (bool, bool) {\\n63:// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\\n64:// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\\n65:// even when it names the same mathematical value: the canonical bodies\\n66:// carry counts, never measurements.\\n67:func rawUint53(raw json.RawMessage) (uint64, bool) {\\n89:// rawNullableString reads a JSON string-or-null member: null reports\\n90:// isNull without a value, any other non-string reports !ok.\\n91:func rawNullableString(raw json.RawMessage) (value string, isNull bool, ok bool) {\\n99:// rawArray reads a JSON array member into its raw elements. Null is not\\n100:// an array: every array member in Sections 7.3-7.5 is required.\\n101:func rawArray(raw json.RawMessage) ([]json.RawMessage, bool) {\\n117:// rawStringArray reads an array whose every element is a JSON string.\\n118:func rawStringArray(raw json.RawMessage) ([]string, bool) {\\n134:// sortedUniqueStrings reports whether the values are in strictly\\n135:// increasing bytewise order: sorted with no duplicates. Bytewise order\\n136:// is the canonical-form order every closed array in Sections 7.3-7.5\\n137:// is written in.\\n138:func sortedUniqueStrings(values []string) bool {\\n142:func hasDuplicateString(values []string) bool {\\n151:// runeLength reports the Unicode-character length the Section 7 string\\n152:// bounds count in. JSON transport is UTF-8, so characters are runes,\\n153:// not bytes and not code units.\\n154:func runeLength(value string) int {\\n158:// isDigest reports whether the value parses as a content digest.\\n\",\n  \"original_output_bytes\