{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42b","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":112,"recorded_at":1780531400000219,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"call_id":"call_01a0789a6f737511ae366815ff054c09","text":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped. Failure details carry the failure class and member names\n38|\t// only, never stderr content.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil, time.Time{}, failure\n199|\t}\n200|\tdeadline, err := req.Deadline.Time()\n201|\tif err != nil {\n202|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n203|\t\tif fault != nil {\n204|\t\t\treturn nil, time.Time{}, fault\n205|\t\t}\n206|\t\treturn nil, time.Time{}, failure\n207|\t}\n208|\tif !deadline.After(now) {\n209|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n210|\t\tif fault != nil {\n211|\t\t\treturn nil, time.Time{}, fault\n212|\t\t}\n213|\t\treturn nil, time.Time{}, failure\n214|\t}\n215|\tif !isJSONObject(req.Body) {\n216|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n217|\t\tif fault != nil {\n218|\t\t\treturn nil, time.Time{}, fault\n219|\t\t}\n220|\t\treturn nil, time.Time{}, failure\n221|\t}\n222|\t// The operation, request ID, deadline, and body above were each\n223|\t// validated before this marshal, so it cannot fail on a reachable\n224|\t// path: the error propagates as a plain Go error rather than\n225|\t// through a refusal site no negative test could exercise.\n226|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n227|\tif err != nil {\n228|\t\treturn nil, time.Time{}, err\n229|\t}\n230|\tif len(frame) > MaxFrameBytes {\n231|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n232|\t\tif fault != nil {\n233|\t\t\treturn nil, time.Time{}, fault\n234|\t\t}\n235|\t\treturn nil, time.Time{}, failure\n236|\t}\n237|\treturn frame, deadline, nil\n238|}\n239|\n240|// isJSONObject reports whether data is well-formed JSON whose top-level\n241|// value is an object. Bodies cross the transport opaquely, so this is the\n242|// only body check here: member vocabularies belong to the operation layer.\n243|func isJSONObject(data []byte) bool {\n244|\ttrimmed := bytes.TrimSpace(data)\n245|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n246|\t\treturn false\n247|\t}\n248|\treturn json.Valid(trimmed)\n249|}\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n262|// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n263|// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n264|// raw bytes are screened before any member is trusted. The\n265|// lone-surrogate gate runs next: encoding/json would likewise replace\n266|// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n267|// reject lone surrogate code points).\n268|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n269|\tif !utf8.Valid(data) {\n270|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n271|\t}\n272|\tif hasLoneSurrogateEscape(data) {\n273|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n274|\t}\n275|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n276|\ttoken, err := decoder.Token()\n277|\tif err != nil {\n278|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n279|\t}\n280|\tdelim, ok := token.(json.Delim)\n281|\tif !ok || delim != '{' {\n282|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n283|\t}\n284|\tmembers := map[string]json.RawMessage{}\n285|\tfor decoder.More() {\n286|\t\tkeyToken, err := decoder.Token()\n287|\t\tif err != nil {\n288|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n289|\t\t}\n290|\t\tkey, ok := keyToken.(string)\n291|\t\tif !ok {\n292|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n293|\t\t}\n294|\t\tif _, duplicate := members[key]; duplicate {\n295|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n296|\t\t}\n297|\t\tvar raw json.RawMessage\n298|\t\tif err := decoder.Decode(&raw); err != nil {\n299|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n300|\t\t}\n301|\t\tmembers[key] = raw\n302|\t}\n303|\tif token, err := decoder.Token(); err != nil {\n304|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n305|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n306|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n307|\t}\n308|\tif _, err := decoder.Token(); err != io.EOF {\n309|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n310|\t}\n311|\treturn members, nil\n312|}\n313|\n314|// responseMembers is the exact Section 7.2 response member set: the four\n315|// framing members plus body on success or error on failure, never both,\n316|// never neither, and nothing else. It is package-level so the closed\n317|// vocabulary census derives it: widening the accepted set here must redden\n318|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n319|var responseMembers = map[string]bool{\n320|\t\"protocol\":         true,\n321|\t\"protocol_version\": true,\n322|\t\"request_id\":       true,\n323|\t\"ok\":               true,\n324|\t\"body\":             true,\n325|\t\"error\":            true,\n326|}\n327|\n328|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n329|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n330|\tfor _, name := range required {\n331|\t\tif _, present := members[name]; !present {\n332|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n333|\t\t}\n334|\t}\n335|\tif ok {\n336|\t\tif _, present := members[\"body\"]; !present {\n337|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n338|\t\t}\n339|\t\tif _, forbidden := members[\"error\"]; forbidden {\n340|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n341|\t\t}\n342|\t} else {\n343|\t\tif _, present := members[\"error\"]; !present {\n344|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n345|\t\t}\n346|\t\tif _, forbidden := members[\"body\"]; forbidden {\n347|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n348|\t\t}\n349|\t}\n350|\tfor name := range members {\n351|\t\tif !responseMembers[name] {\n352|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n353|\t\t}\n354|\t}\n355|\treturn nil\n356|}\n357|\n358|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n359|// Anything else is not a recognizable major, so the frame is unusable\n360|// rather than a mismatch.\n361|func parseMajor(version string) (int, bool) {\n362|\tparts := strings.Split(version, \".\")\n363|\tif len(parts) != 3 {\n364|\t\treturn 0, false\n365|\t}\n366|\tmajor := 0\n367|\tfor i := 0; i < len(parts[0]); i++ {\n368|\t\tdigit := parts[0][i]\n369|\t\tif digit < '0' || digit > '9' {\n370|\t\t\treturn 0, false\n371|\t\t}\n372|\t\tmajor = major*10 + int(digit-'0')\n373|\t}\n374|\tif len(parts[0]) == 0 {\n375|\t\treturn 0, false\n376|\t}\n377|\tfor _, rest := range parts[1:] {\n378|\t\tif len(rest) == 0 {\n379|\t\t\treturn 0, false\n380|\t\t}\n381|\t\tfor i := 0; i < len(rest); i++ {\n382|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n383|\t\t\t\treturn 0, false\n384|\t\t\t}\n385|\t\t}\n386|\t}\n387|\treturn major, true\n388|}\n389|\n390|// providerContract is the static Section 7.2 binding every failure\n391|// envelope is decoded under: provider protocol major 2 binds Structured\n392|// Error 1.0.0. The version is never taken from the document.\n393|var providerContract = axerror.ContainingContract{ID: \"urn:ax:protocol:provider\", Major: 2}\n394|\n395|// DecodeResponse validates one stdout line as the single response frame\n396|// for the request carrying wantRequestID. It returns the success body, or\n397|// the bound child failure, or a local failure that trusts nothing from\n398|// the frame. A recognizable foreign major yields incompatible_protocol;\n399|// every other unusable frame yields provider_protocol_error.\n400|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n401|\tif len(frame) > MaxFrameBytes {\n402|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n403|\t\tif err != nil {\n404|\t\t\treturn Response{}, err\n405|\t\t}\n406|\t\treturn Response{}, failure\n407|\t}\n408|\tif !utf8.Valid(frame) {\n409|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n410|\t\tif err != nil {\n411|\t\t\treturn Response{}, err\n412|\t\t}\n413|\t\treturn Response{}, failure\n414|\t}\n415|\tmembers, fault := decodeStrictObject(frame)\n416|\tif fault != nil {\n417|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n418|\t\tif err != nil {\n419|\t\t\treturn Response{}, err\n420|\t\t}\n421|\t\treturn Response{}, failure\n422|\t}\n423|\t// foreignMajor peeks at the envelope identity before any v2\n424|\t// member rule runs. A recognizable foreign major is\n425|\t// incompatible_protocol no matter what members it carries, so\n426|\t// the v2 member vocabulary below must not judge it first: a\n427|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n428|\t// is a foreign major, not an unknown or missing member. The\n429|\t// peek trusts nothing and refuses nothing: it only arms when\n430|\t// the protocol member is exactly this protocol and the version\n431|\t// member is a string with a recognizable foreign major. A frame\n432|\t// without our protocol identity, or without a readable version,\n433|\t// falls through to the member rules, which keep their verdicts.\n434|\tforeignMajor := \"\"\n435|\tif rawProtocol, present := members[\"protocol\"]; present {\n436|\t\tvar protocol string\n437|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n438|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n439|\t\t\t\tvar version string\n440|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n441|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n442|\t\t\t\t\t\tforeignMajor = version\n443|\t\t\t\t\t}\n444|\t\t\t\t}\n445|\t\t\t}\n446|\t\t}\n447|\t}\n448|\tvar ok bool\n449|\tif foreignMajor == \"\" {\n450|\t\tif raw, present := members[\"ok\"]; !present {\n451|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn Response{}, err\n454|\t\t\t}\n455|\t\t\treturn Response{}, failure\n456|\t\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n457|\t\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n458|\t\t\tif fault != nil {\n459|\t\t\t\treturn Response{}, fault\n460|\t\t\t}\n461|\t\t\treturn Response{}, failure\n462|\t\t}\n463|\t\tif fault := checkResponseMembers(members, ok); fault != nil {\n464|\t\t\tfailure, err := failProtocol(fault.detail, fault.member)\n465|\t\t\tif err != nil {\n466|\t\t\t\treturn Response{}, err\n467|\t\t\t}\n468|\t\t\treturn Response{}, failure\n469|\t\t}\n470|\t}\n471|\tvar protocol string\n472|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n473|\t\tfailure, fault := failProtocol(\"not a provider envelope\", \"protocol\")\n474|\t\tif fault != nil {\n475|\t\t\treturn Response{}, fault\n476|\t\t}\n477|\t\treturn Response{}, failure\n478|\t}\n479|\tvar version string\n480|\tif err := json.Unmarshal(members[\"protocol_version\"], &version); err != nil {\n481|\t\tfailure, fault := failProtocol(\"member is not a string\", \"protocol_version\")\n482|\t\tif fault != nil {\n483|\t\t\treturn Response{}, fault\n484|\t\t}\n485|\t\treturn Response{}, failure\n486|\t}\n487|\tif version != ProtocolVersion {\n488|\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n489|\t\t\tfailure, err := failMismatch(\"foreign protocol major\", version)\n490|\t\t\tif err != nil {\n491|\t\t\t\treturn Response{}, err\n492|\t\t\t}\n493|\t\t\treturn Response{}, failure\n494|\t\t}\n495|\t\tfailure, fault := failProtocol(\"unsupported protocol version\", \"protocol_version\")\n496|\t\tif fault != nil {\n497|\t\t\treturn Response{}, fault\n498|\t\t}\n499|\t\treturn Response{}, failure\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42d","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":113,"recorded_at":1780531400000221,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"call_id":"call_01a0789a6fdb7f328552e0daa437599a","text":"Read text file `internal/provider/provider.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"crypto/subtle\"\n6|\t\"fmt\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Stable Structured Error codes this package reports. Discovery-shape\n15|// refusals (duplicates, malformed names, non-regular targets, unapproved\n16|// owners, relative directories) report invalid_config; a filesystem read\n17|// that cannot establish the discovery or verification preconditions reports\n18|// local_precondition_failed; a trust receipt that no longer matches freshly\n19|// read facts reports integrity_failure. The duplicate mapping is mandated by\n20|// Section 7.1; the other two are derived mappings documented on the\n21|// constructors, because Section 7.1 names no code for those cases.\n22|const (\n23|\tcodeInvalidConfig     = \"invalid_config\"\n24|\tcodeLocalPrecondition = \"local_precondition_failed\"\n25|\tcodeIntegrityFailure  = \"integrity_failure\"\n26|)\n27|\n28|// Error is the only error this package produces. Code carries the stable\n29|// registry code above; Detail names the offending provider ID, path, or\n30|// trust dimension in human text automation must never branch on; Cause\n31|// preserves the underlying filesystem failure for errors.Is and errors.As.\n32|type Error struct {\n33|\tcode   string\n34|\tdetail string\n35|\tcause  error\n36|}\n37|\n38|// Code reports the stable registry code for this refusal.\n39|func (err Error) Code() string { return err.code }\n40|\n41|// Detail reports the human-text detail for this refusal.\n42|func (err Error) Detail() string { return err.detail }\n43|\n44|// Unwrap exposes the underlying filesystem cause, if one was recorded.\n45|func (err Error) Unwrap() error { return err.cause }\n46|\n47|func (err Error) Error() string {\n48|\tif err.cause == nil {\n49|\t\treturn \"provider \" + err.code + \": \" + err.detail\n50|\t}\n51|\treturn \"provider \" + err.code + \": \" + err.detail + \": \" + err.cause.Error()\n52|}\n53|\n54|// The four refusal constructors below are declared as variables so the\n55|// refusal-inventory gate can observe every exercised refusal site. Each is\n56|// the single construction site for its failure class; production code must\n57|// not build Error values or wrap filesystem errors any other way.\n58|//\n59|// failDuplicate reports the Section 7.1 duplicate-ID refusal with the\n60|// section-mandated invalid_config code.\n61|//\n62|// failInvalid reports a discovery-shape refusal: a malformed plugin name, a\n63|// non-regular target, an unapproved owner, a relative directory, or a Trust\n64|// call on a builtin adapter. These are operator-configuration or caller\n65|// errors, so they share the invalid_config code.\n66|//\n67|// failPrecondition reports a filesystem read failure during discovery: an\n68|// unreadable plugin directory, an unresolvable symlink, an unreadable\n69|// target, or unattainable ownership metadata. A failed read is never a\n70|// legitimate absence, so discovery aborts with local_precondition_failed\n71|// instead of yielding a partial candidate set.\n72|//\n73|// failIntegrity reports a trust receipt that no longer matches freshly read\n74|// facts, including a receipt whose facts cannot be re-read at all: a\n75|// changed path target or digest requires renewed trust, and an unreadable\n76|// file cannot prove it is unchanged.\n77|var failDuplicate = func(providerID, firstSource, secondSource string) Error {\n78|\treturn Error{\n79|\t\tcode:   codeInvalidConfig,\n80|\t\tdetail: fmt.Sprintf(\"duplicate provider %q from %s and %s\", providerID, firstSource, secondSource),\n81|\t}\n82|}\n83|\n84|var failInvalid = func(detail string) Error {\n85|\treturn Error{code: codeInvalidConfig, detail: detail}\n86|}\n87|\n88|var failPrecondition = func(detail string, cause error) Error {\n89|\treturn Error{code: codeLocalPrecondition, detail: detail, cause: cause}\n90|}\n91|\n92|var failIntegrity = func(detail string, cause error) Error {\n93|\treturn Error{code: codeIntegrityFailure, detail: detail, cause: cause}\n94|}\n95|\n96|// Kind distinguishes a built-in adapter from an external executable.\n97|type Kind string\n98|\n99|const (\n100|\t// KindBuiltin is an adapter compiled into the host. It has no\n101|\t// executable path, digest, or owner to trust.\n102|\tKindBuiltin Kind = \"builtin\"\n103|\t// KindExternal is an ax-provider-<id> executable discovered on the\n104|\t// filesystem and subject to trust recording and verification.\n105|\tKindExternal Kind = \"external\"\n106|)\n107|\n108|// ExecutablePrefix is the Section 7.1 external executable name prefix. The\n109|// suffix is a provider ID in the scalar provider-id grammar.\n110|const ExecutablePrefix = \"ax-provider-\"\n111|\n112|// builtinOrder is the Section 7.1 built-in set in the section's listed\n113|// order. The order is a discovery enumeration order only; Section 7.1\n114|// states the order does not establish precedence.\n115|var builtinOrder = []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n116|\n117|// Builtins returns the Section 7.1 built-in provider IDs in discovery\n118|// order. The result is a copy; the registry cannot be mutated through it.\n119|func Builtins() []string {\n120|\treturn append([]string(nil), builtinOrder...)\n121|}\n122|\n123|// Config carries the operator inputs Discover consumes. PluginDirs maps to\n124|// providers.plugin_dirs in listed order and AllowPathPlugins to\n125|// providers.allow_path_plugins; both arrive already parsed by\n126|// internal/config, which additionally enforces absolute directories and\n127|// require_explicit_trust. Platform is the host AX platform the paths are\n128|// evaluated on.\n129|type Config struct {\n130|\tPlatform         scalar.Platform\n131|\tPluginDirs       []string\n132|\tAllowPathPlugins bool\n133|}\n134|\n135|// OwnerPolicy decides whether a filesystem UID may own a trusted external\n136|// executable. OperatorUID is the operator's own identity;\n137|// AdministratorUIDs are the additional administrator-approved identities,\n138|// if the host configures any. An empty administrator set trusts the\n139|// operator alone; no superuser exception is implied.\n140|type OwnerPolicy struct {\n141|\tOperatorUID       uint32\n142|\tAdministratorUIDs []uint32\n143|}\n144|\n145|// Approves reports whether uid may own a trusted executable.\n146|func (policy OwnerPolicy) Approves(uid uint32) bool {\n147|\tif uid == policy.OperatorUID {\n148|\t\treturn true\n149|\t}\n150|\tfor _, admin := range policy.AdministratorUIDs {\n151|\t\tif uid == admin {\n152|\t\t\treturn true\n153|\t\t}\n154|\t}\n155|\treturn false\n156|}\n157|\n158|// OwnerIdentity renders a UID in the stable form TrustRecord stores.\n159|func (policy OwnerPolicy) OwnerIdentity(uid uint32) string {\n160|\treturn fmt.Sprintf(\"uid:%d\", uid)\n161|}\n162|\n163|// FileInfo is the ownership and shape fact System.Inspect reports for one\n164|// path. UID is the owning identity of the symlink target.\n165|type FileInfo struct {\n166|\tIsRegular bool\n167|\tUID       uint32\n168|}\n169|\n170|// System is the filesystem seam Discover and Verify read through.\n171|// Production code supplies OSSystem; tests supply a scripted fake. Every\n172|// method reports a failed or partial read as an error, never as an empty\n173|// result the caller could mistake for absence.\n174|type System interface {\n175|\t// ReadDir returns the entry names of dir, unsorted.\n176|\tReadDir(dir string) ([]string, error)\n177|\t// Canonicalize resolves dir against an absolute base and every\n178|\t// symlink in the path, returning the canonical absolute target.\n179|\tCanonicalize(path string) (string, error)\n180|\t// Inspect stats the symlink target at an already-canonical path.\n181|\tInspect(canonical string) (FileInfo, error)\n182|\t// ReadFile returns the full bytes of the symlink target at an\n183|\t// already-canonical path.\n184|\tReadFile(canonical string) ([]byte, error)\n185|\t// PathDirs returns the PATH search directories in listed order.\n186|\tPathDirs() []string\n187|}\n188|\n189|// Candidate is one discovered provider. External candidates carry the\n190|// trust-time facts Section 7.1 requires: the canonical absolute executable\n191|// path, the SHA-256 digest of its bytes, and the approving owner identity.\n192|// Builtin candidates carry none of those; the zero accessors report\n193|// absence. A Candidate carries no availability, status, or capability\n194|// claim: discovery never advertises what the probe plane has not proven.\n195|type Candidate struct {\n196|\tid     string\n197|\tkind   Kind\n198|\tsource string\n199|\tpath   string\n200|\tcanon  string\n201|\tdigest scalar.Digest\n202|\towner  string\n203|}\n204|\n205|// ID reports the provider ID this candidate declares.\n206|func (candidate Candidate) ID() string { return candidate.id }\n207|\n208|// Kind reports whether this candidate is built-in or external.\n209|func (candidate Candidate) Kind() Kind { return candidate.kind }\n210|\n211|// Source names where the candidate was found: plugin_dirs[i], builtin, or\n212|// path. It is a diagnostic label, not a precedence rank.\n213|func (candidate Candidate) Source() string { return candidate.source }\n214|\n215|// SourcePath reports the undisguised discovery path of an external\n216|// candidate: the plugin or PATH directory joined with the executable name.\n217|// Verify re-resolves this path to detect symlink retargeting.\n218|func (candidate Candidate) SourcePath() (string, bool) {\n219|\tif candidate.kind != KindExternal {\n220|\t\treturn \"\", false\n221|\t}\n222|\treturn candidate.path, true\n223|}\n224|\n225|// CanonicalPath reports the symlink-resolved absolute target recorded at\n226|// trust time for an external candidate.\n227|func (candidate Candidate) CanonicalPath() (string, bool) {\n228|\tif candidate.kind != KindExternal {\n229|\t\treturn \"\", false\n230|\t}\n231|\treturn candidate.canon, true\n232|}\n233|\n234|// Digest reports the SHA-256 digest of the target bytes recorded at trust\n235|// time for an external candidate.\n236|func (candidate Candidate) Digest() (scalar.Digest, bool) {\n237|\tif candidate.kind != KindExternal {\n238|\t\treturn scalar.Digest{}, false\n239|\t}\n240|\treturn candidate.digest, true\n241|}\n242|\n243|// Owner reports the approving owner identity recorded at trust time for an\n244|// external candidate.\n245|func (candidate Candidate) Owner() (string, bool) {\n246|\tif candidate.kind != KindExternal {\n247|\t\treturn \"\", false\n248|\t}\n249|\treturn candidate.owner, true\n250|}\n251|\n252|// TrustRecord is the trust-time receipt for one accepted external\n253|// candidate: the canonical absolute executable path and SHA-256 digest\n254|// Section 7.1 requires, plus the undisguised discovery path Verify\n255|// re-resolves, the approving owner identity, and the trust instant. The\n256|// host persists this receipt; Verify rechecks it.\n257|type TrustRecord struct {\n258|\tproviderID string\n259|\tsourcePath string\n260|\tcanon      string\n261|\tdigest     scalar.Digest\n262|\towner      string\n263|\ttrustedAt  scalar.Timestamp\n264|}\n265|\n266|// ProviderID reports the trusted provider ID.\n267|func (record TrustRecord) ProviderID() string { return record.providerID }\n268|\n269|// SourcePath reports the undisguised discovery path Verify re-resolves.\n270|func (record TrustRecord) SourcePath() string { return record.sourcePath }\n271|\n272|// CanonicalPath reports the recorded canonical absolute target.\n273|func (record TrustRecord) CanonicalPath() string { return record.canon }\n274|\n275|// Digest reports the recorded SHA-256 digest of the target bytes.\n276|func (record TrustRecord) Digest() scalar.Digest { return record.digest }\n277|\n278|// Owner reports the recorded approving owner identity.\n279|func (record TrustRecord) Owner() string { return record.owner }\n280|\n281|// TrustedAt reports the trust instant.\n282|func (record TrustRecord) TrustedAt() scalar.Timestamp { return record.trustedAt }\n283|\n284|// externalID splits an ax-provider-<id> file name. It reports false for\n285|// names outside the prefix so ordinary directory entries are skipped; a\n286|// prefixed name whose suffix fails the provider-id grammar is a malformed\n287|// candidate, reported as an error rather than silently skipped.\n288|func externalID(name string) (string, bool, error) {\n289|\tsuffix, found := strings.CutPrefix(name, ExecutablePrefix)\n290|\tif !found {\n291|\t\treturn \"\", false, nil\n292|\t}\n293|\tif _, err := scalar.ParseProviderID(suffix); err != nil {\n294|\t\treturn \"\", false, err\n295|\t}\n296|\treturn suffix, true, nil\n297|}\n298|\n299|// Discover deterministically enumerates provider candidates in the Section\n300|// 7.1 source order: configured plugin directories in listed order (entry\n301|// names sorted bytewise within each directory, because filesystem order is\n302|// not deterministic), then built-in adapters in registry order, then PATH\n303|// directories in listed order only when AllowPathPlugins is true. Both\n304|// configured plugin directories and PATH entries must be absolute paths:\n305|// a relative entry fails with invalid_config instead of resolving against\n306|// the process working directory.\n307|//\n308|// Discover never probes or executes a candidate, so the duplicate refusal\n309|// below happens before either by construction: the function has no probe\n310|// or execution dependency to invoke. If two candidates declare the same\n311|// provider ID, Discover fails with invalid_config naming both sources; the\n312|// operator must remove or rename one candidate. There is no\n313|// duplicate-selection override, including for byte-identical observations\n314|// of one file through two directories.\n315|//\n316|// Every accepted external candidate records its canonical absolute path,\n317|// SHA-256 digest, and approving owner at trust time: symlinks are resolved\n318|// before comparison, the target must be a regular file, and its owner must\n319|// satisfy policy. A matching directory entry that cannot become an\n320|// accepted candidate (malformed name, unresolvable link, non-regular\n321|// target, unapproved owner) fails discovery instead of being skipped,\n322|// because a skipped trust check would silently narrow the trust boundary.\n323|// Filesystem read failures abort discovery instead of yielding a partial\n324|// set. Discover holds no state and starts no process.\n325|func Discover(cfg Config, owner OwnerPolicy, system System) ([]Candidate, error) {\n326|\tseen := make(map[string]string)\n327|\tvar out []Candidate\n328|\tadd := func(candidate Candidate) error {\n329|\t\tif first, duplicate := seen[candidate.id]; duplicate {\n330|\t\t\treturn failDuplicate(candidate.id, first, candidate.source)\n331|\t\t}\n332|\t\tseen[candidate.id] = candidate.source\n333|\t\tout = append(out, candidate)\n334|\t\treturn nil\n335|\t}\n336|\tfor index, dir := range cfg.PluginDirs {\n337|\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n338|\t\t\treturn nil, failInvalid(fmt.Sprintf(\"providers.plugin_dirs[%d] %q is not an absolute path\", index, dir))\n339|\t\t}\n340|\t\tsource := fmt.Sprintf(\"plugin_dirs[%d]\", index)\n341|\t\tif err := collectDirectory(owner, system, dir, source, add); err != nil {\n342|\t\t\treturn nil, err\n343|\t\t}\n344|\t}\n345|\tfor _, id := range builtinOrder {\n346|\t\tif err := add(Candidate{id: id, kind: KindBuiltin, source: \"builtin\"}); err != nil {\n347|\t\t\treturn nil, err\n348|\t\t}\n349|\t}\n350|\tif cfg.AllowPathPlugins {\n351|\t\tfor index, dir := range system.PathDirs() {\n352|\t\t\tif _, err := scalar.ParseAbsolutePath(cfg.Platform, dir); err != nil {\n353|\t\t\t\treturn nil, failInvalid(fmt.Sprintf(\"PATH[%d] %q is not an absolute path\", index, dir))\n354|\t\t\t}\n355|\t\t\tif err := collectDirectory(owner, system, dir, \"path\", add); err != nil {\n356|\t\t\t\treturn nil, err\n357|\t\t\t}\n358|\t\t}\n359|\t}\n360|\treturn out, nil\n361|}\n362|\n363|// collectDirectory folds every ax-provider-<id> entry of one directory into\n364|// add in bytewise name order. PATH entries reuse this path, so both sources\n365|// enforce the same trust checks; only the diagnostic source label differs.\n366|func collectDirectory(owner OwnerPolicy, system System, dir, source string, add func(Candidate) error) error {\n367|\tnames, err := system.ReadDir(dir)\n368|\tif err != nil {\n369|\t\treturn failPrecondition(fmt.Sprintf(\"cannot list %s directory %q\", source, dir), err)\n370|\t}\n371|\tsort.Strings(names)\n372|\tfor _, name := range names {\n373|\t\tid, candidate, err := externalID(name)\n374|\t\tif err != nil {\n375|\t\t\treturn failInvalid(fmt.Sprintf(\"%s entry %q is not a provider executable name: %v\", source, filepath.Join(dir, name), err))\n376|\t\t}\n377|\t\tif !candidate {\n378|\t\t\tcontinue\n379|\t\t}\n380|\t\tfound, err := trustCandidate(owner, system, id, filepath.Join(dir, name), source)\n381|\t\tif err != nil {\n382|\t\t\treturn err\n383|\t\t}\n384|\t\tif err := add(found); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\treturn nil\n389|}\n390|\n391|// trustCandidate establishes the trust-time facts for one external\n392|// executable: symlink resolution before comparison, regular-file target,\n393|// approved owner, and digest over the target bytes.\n394|func trustCandidate(owner OwnerPolicy, system System, id, path, source string) (Candidate, error) {\n395|\tcanon, err := system.Canonicalize(path)\n396|\tif err != nil {\n397|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot resolve provider %q at %q\", id, path), err)\n398|\t}\n399|\tinfo, err := system.Inspect(canon)\n400|\tif err != nil {\n401|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot inspect provider %q target %q\", id, canon), err)\n402|\t}\n403|\tif !info.IsRegular {\n404|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is not a regular file\", id, canon))\n405|\t}\n406|\tif !owner.Approves(info.UID) {\n407|\t\treturn Candidate{}, failInvalid(fmt.Sprintf(\"provider %q target %q is owned by %s, which the trust policy does not approve\", id, canon, owner.OwnerIdentity(info.UID)))\n408|\t}\n409|\tcontent, err := system.ReadFile(canon)\n410|\tif err != nil {\n411|\t\treturn Candidate{}, failPrecondition(fmt.Sprintf(\"cannot digest provider %q target %q\", id, canon), err)\n412|\t}\n413|\tdigest := scalar.SHA256Digest(content)\n414|\treturn Candidate{\n415|\t\tid:     id,\n416|\t\tkind:   KindExternal,\n417|\t\tsource: source,\n418|\t\tpath:   path,\n419|\t\tcanon:  canon,\n420|\t\tdigest: digest,\n421|\t\towner:  owner.OwnerIdentity(info.UID),\n422|\t}, nil\n423|}\n424|\n425|// Trust records the trust receipt for one accepted external candidate.\n426|// Trusting a builtin adapter is refused: it has no executable bytes to\n427|// record. Trust is pure: identical inputs return identical receipts.\n428|func Trust(candidate Candidate, trustedAt scalar.Timestamp) (TrustRecord, error) {\n429|\tif candidate.kind != KindExternal {\n430|\t\treturn TrustRecord{}, failInvalid(fmt.Sprintf(\"provider %q is a builtin adapter with no executable to trust\", candidate.id))\n431|\t}\n432|\treturn TrustRecord{\n433|\t\tproviderID: candidate.id,\n434|\t\tsourcePath: candidate.path,\n435|\t\tcanon:      candidate.canon,\n436|\t\tdigest:     candidate.digest,\n437|\t\towner:      candidate.owner,\n438|\t\ttrustedAt:  trustedAt,\n439|\t}, nil\n440|}\n441|\n442|// Verify rechecks a trust receipt against freshly read filesystem facts. A\n443|// changed path target or digest requires renewed trust: any mismatch in\n444|// the re-resolved canonical path, the target shape, the approving owner,\n445|// or the digest fails with integrity_failure, as does any read failure,\n446|// because an unreadable file cannot prove it is unchanged. Verify holds no\n447|// state and starts no process; repeated verification over an unchanged\n448|// tree succeeds identically.\n449|func Verify(record TrustRecord, owner OwnerPolicy, system System) error {\n450|\tcanon, err := system.Canonicalize(record.sourcePath)\n451|\tif err != nil {\n452|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q trust receipt cannot be re-resolved and requires renewed trust\", record.providerID), err)\n453|\t}\n454|\tif canon != record.canon {\n455|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target changed from %q to %q and requires renewed trust\", record.providerID, record.canon, canon), nil)\n456|\t}\n457|\tinfo, err := system.Inspect(canon)\n458|\tif err != nil {\n459|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-inspected and requires renewed trust\", record.providerID, canon), err)\n460|\t}\n461|\tif !info.IsRegular {\n462|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q is no longer a regular file and requires renewed trust\", record.providerID, canon), nil)\n463|\t}\n464|\tif identity := owner.OwnerIdentity(info.UID); !owner.Approves(info.UID) || identity != record.owner {\n465|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable owner is now %s and requires renewed trust\", record.providerID, identity), nil)\n466|\t}\n467|\tcontent, err := system.ReadFile(canon)\n468|\tif err != nil {\n469|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable target %q cannot be re-read and requires renewed trust\", record.providerID, canon), err)\n470|\t}\n471|\tsum := sha256.Sum256(content)\n472|\tif subtle.ConstantTimeCompare(sum[:], digestBytes(record.digest)) != 1 {\n473|\t\treturn failIntegrity(fmt.Sprintf(\"provider %q executable digest changed and requires renewed trust\", record.providerID), nil)\n474|\t}\n475|\treturn nil\n476|}\n477|\n478|// digestBytes decodes the recorded digest for constant-time comparison. A\n479|// TrustRecord always carries a digest produced by SHA256Digest, so the\n480|// decode cannot fail; a receipt that does not decode compares unequal\n481|// rather than panicking.\n482|func digestBytes(digest scalar.Digest) []byte {\n483|\traw := digest.Hex()\n484|\tif len(raw) != sha256.Size*2 {\n485|\t\treturn nil\n486|\t}\n487|\tdecoded := make([]byte, sha256.Size)\n488|\tfor i := range decoded {\n489|\t\thi := unhex(raw[2*i])\n490|\t\tlo := unhex(raw[2*i+1])\n491|\t\tif hi > 15 || lo > 15 {\n492|\t\t\treturn nil\n493|\t\t}\n494|\t\tdecoded[i] = hi<<4 | lo\n495|\t}\n496|\treturn decoded\n497|}\n498|\n499|func unhex(c byte) byte {\n500|\tswitch {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42f","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":114,"recorded_at":1780531400000223,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"call_id":"call_01a0789a707875b18b347a6ecd76325f","text":"Read text file `internal/axerror/details.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"regexp\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|)\n14|\n15|// Details is the Section 15.1 diagnostic data map. The pinned document calls it\n16|// \"an explicitly open diagnostic data map, not an implicit schema extension\":\n17|// unknown keys are admitted as inert data, and nothing in this package derives\n18|// success, authority, or a remediation action from them.\n19|type Details map[string]any\n20|\n21|var (\n22|\t// ErrInvalidDetails reports a diagnostic map outside the Section 15.1\n23|\t// shape, bounds, or redaction rules.\n24|\tErrInvalidDetails = errors.New(\"invalid structured error details\")\n25|\n26|\t// ErrCausalLeak reports human text or a diagnostic value that reproduces\n27|\t// the rendered text of the Go cause the failure was built from. The cause\n28|\t// chain stays local; it is never copied onto the wire.\n29|\tErrCausalLeak = errors.New(\"structured error would carry its cause onto the wire\")\n30|)\n31|\n32|// detailKeyPattern is the Section 15.1 constraint on detail keys, verbatim:\n33|// \"0-64 keys matching [a-z][a-z0-9_]{0,63}\".\n34|var detailKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_]{0,63}$`)\n35|\n36|const (\n37|\tmaxDetailKeys      = 64\n38|\tmaxDetailDepth     = 4\n39|\tmaxDetailCanonical = 16 * 1024\n40|\tminRedactableCause = 8\n41|\tmaxMessageRunes    = 4096\n42|\tminMessageRunes    = 1\n43|)\n44|\n45|// excludedDetailKeys is the best-effort scanner Section 16.2 says an\n46|// implementation SHOULD offer. It refuses a detail key that names one of the\n47|// four classes Section 15.1 forbids outright — \"No detail may contain a\n48|// credential, raw transcript, environment secret, or opaque bundle content\" —\n49|// and nothing else.\n50|//\n51|// Matching is exact, never by substring, and that is deliberate. A substring\n52|// rule refusing every key containing \"token\", \"socket\" or \"credential\" would\n53|// refuse \"token_count\", \"socket_timeout_ms\" and \"credential_profile\" — ordinary\n54|// diagnostics the specification admits — while still passing a secret written\n55|// under an innocuous name. That is pure false-positive surface with no\n56|// true-positive capability, and it is the exact defect removed from the\n57|// Configuration extension-key validator: where the pinned document is silent\n58|// about a name, be permissive.\n59|//\n60|// The list is also scoped to Section 15.1's four classes rather than to the\n61|// whole Section 16.2 exclusion table. Section 16.2 governs manifests and\n62|// bundles generated by ax; a diagnostic key naming a PID, a tmux socket or a\n63|// Terminal Instance Binding is not a credential, a transcript, an environment\n64|// secret, or bundle content, and refusing it here would invent a constraint the\n65|// error contract does not state.\n66|var excludedDetailKeys = map[string]string{\n67|\t// Credential.\n68|\t\"access_token\":       \"credential\",\n69|\t\"api_key\":            \"credential\",\n70|\t\"auth_json\":          \"credential\",\n71|\t\"cookie\":             \"credential\",\n72|\t\"cookies\":            \"credential\",\n73|\t\"credential\":         \"credential\",\n74|\t\"credentials\":        \"credential\",\n75|\t\"oauth_token\":        \"credential\",\n76|\t\"passphrase\":         \"credential\",\n77|\t\"password\":           \"credential\",\n78|\t\"private_key\":        \"credential\",\n79|\t\"refresh_token\":      \"credential\",\n80|\t\"session_token\":      \"credential\",\n81|\t\"ssh_private_key\":    \"credential\",\n82|\t\"subscription_token\": \"credential\",\n83|\t// Raw transcript.\n84|\t\"raw_transcript\":      \"raw transcript\",\n85|\t\"scrollback\":          \"raw transcript\",\n86|\t\"terminal_scrollback\": \"raw transcript\",\n87|\t\"transcript\":          \"raw transcript\",\n88|\t// Environment secret.\n89|\t\"dotenv\":             \"environment secret\",\n90|\t\"env_secret\":         \"environment secret\",\n91|\t\"environment_secret\": \"environment secret\",\n92|\t\"secret\":             \"environment secret\",\n93|\t\"secrets\":            \"environment secret\",\n94|\t// Opaque bundle content.\n95|\t\"bundle_bytes\":   \"opaque bundle content\",\n96|\t\"bundle_content\": \"opaque bundle content\",\n97|\t\"opaque_bundle\":  \"opaque bundle content\",\n98|}\n99|\n100|// RedactionBound states what the gates below can and cannot decide. It is\n101|// quoted in README.md and asserted by this package's tests so that no caller\n102|// reads a refusal as a confidentiality guarantee. Section 16.2 is explicit:\n103|// \"v0.5.0 does not claim reliable content-level secret scrubbing\", and this\n104|// implementation claims no more than the pinned document does.\n105|const RedactionBound = \"Detail redaction decides two things: whether a key exactly names one of the four classes \" +\n106|\t\"Section 15.1 forbids, and whether human text or a diagnostic value reproduces the rendered local cause \" +\n107|\t\"verbatim. It inspects no free-form value for secret content, matches no key by substring, and admits a \" +\n108|\t\"secret written under an innocuously named key. Section 16.2 does not claim content-level scrubbing and \" +\n109|\t\"neither does this package.\"\n110|\n111|// ValidateDetails checks a diagnostic map against every Section 15.1 bound: the\n112|// key count, the key grammar, the value nesting depth, the canonical byte size,\n113|// and the four Section 15.1 detail classes that an exact key name makes decidable.\n114|//\n115|// The nesting bound counts containers opened by a detail value, matching the\n116|// extension-value convention already used for canonical records: a value may\n117|// open four containers and the fifth is refused.\n118|func ValidateDetails(details Details) error {\n119|\tif details == nil {\n120|\t\treturn fmt.Errorf(\"%w: details is required and must not be null\", ErrInvalidDetails)\n121|\t}\n122|\tif len(details) > maxDetailKeys {\n123|\t\treturn fmt.Errorf(\"%w: %d keys exceed the maximum of %d\", ErrInvalidDetails, len(details), maxDetailKeys)\n124|\t}\n125|\tfor _, key := range sortedKeys(details) {\n126|\t\tif !detailKeyPattern.MatchString(key) {\n127|\t\t\treturn fmt.Errorf(\"%w: key %q does not match [a-z][a-z0-9_]{0,63}\", ErrInvalidDetails, key)\n128|\t\t}\n129|\t\tif err := refuseExcludedKey(key); err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\tif err := validateDetailValue(key, details[key], 0); err != nil {\n133|\t\t\treturn err\n134|\t\t}\n135|\t}\n136|\tmeasured, err := canonicaljson.CanonicalByteLength(map[string]any(details))\n137|\tif err != nil {\n138|\t\treturn fmt.Errorf(\"%w: measure canonical details: %v\", ErrInvalidDetails, err)\n139|\t}\n140|\tif measured > maxDetailCanonical {\n141|\t\treturn fmt.Errorf(\n142|\t\t\t\"%w: canonical details are %d bytes, maximum is %d\", ErrInvalidDetails, measured, maxDetailCanonical)\n143|\t}\n144|\treturn nil\n145|}\n146|\n147|func refuseExcludedKey(key string) error {\n148|\tif class, excluded := excludedDetailKeys[key]; excluded {\n149|\t\treturn fmt.Errorf(\"%w: key %q names %s, which no detail may contain\", ErrInvalidDetails, key, class)\n150|\t}\n151|\treturn nil\n152|}\n153|\n154|func validateDetailValue(key string, value any, depth int) error {\n155|\tswitch typed := value.(type) {\n156|\tcase nil, bool, json.Number:\n157|\t\treturn nil\n158|\tcase string:\n159|\t\tif !utf8.ValidString(typed) {\n160|\t\t\treturn fmt.Errorf(\"%w: details[%q] contains invalid UTF-8\", ErrInvalidDetails, key)\n161|\t\t}\n162|\t\treturn nil\n163|\tcase []any:\n164|\t\tif depth == maxDetailDepth {\n165|\t\t\treturn fmt.Errorf(\"%w: details[%q] exceeds maximum nesting depth %d\", ErrInvalidDetails, key, maxDetailDepth)\n166|\t\t}\n167|\t\tfor _, member := range typed {\n168|\t\t\tif err := validateDetailValue(key, member, depth+1); err != nil {\n169|\t\t\t\treturn err\n170|\t\t\t}\n171|\t\t}\n172|\t\treturn nil\n173|\tcase map[string]any:\n174|\t\tif depth == maxDetailDepth {\n175|\t\t\treturn fmt.Errorf(\"%w: details[%q] exceeds maximum nesting depth %d\", ErrInvalidDetails, key, maxDetailDepth)\n176|\t\t}\n177|\t\tfor _, nested := range sortedKeys(typed) {\n178|\t\t\tif !utf8.ValidString(nested) {\n179|\t\t\t\treturn fmt.Errorf(\"%w: details[%q] has an object key that is not valid UTF-8\", ErrInvalidDetails, key)\n180|\t\t\t}\n181|\t\t\tif err := refuseExcludedKey(nested); err != nil {\n182|\t\t\t\treturn err\n183|\t\t\t}\n184|\t\t\tif err := validateDetailValue(key, typed[nested], depth+1); err != nil {\n185|\t\t\t\treturn err\n186|\t\t\t}\n187|\t\t}\n188|\t\treturn nil\n189|\tdefault:\n190|\t\treturn fmt.Errorf(\"%w: details[%q] uses unsupported JSON type %T\", ErrInvalidDetails, key, value)\n191|\t}\n192|}\n193|\n194|// refuseCausalLeak refuses human text or diagnostic values that reproduce the\n195|// rendered text of the local cause verbatim. It exists because the ordinary way\n196|// to lose a secret is fmt.Errorf(\"...: %v\", err) on a cause that wrapped a\n197|// command line, a transport payload, or a provider's stderr.\n198|//\n199|// What it decides is narrow and stated: verbatim containment of the whole\n200|// rendered cause, and of each of its wrapped links. A paraphrase, a truncation,\n201|// or a single extracted field of the cause is not detected. Causes shorter than\n202|// minRedactableCause characters are skipped, because a cause rendering as\n203|// \"EOF\" would otherwise refuse every message containing that substring.\n204|func refuseCausalLeak(message string, details Details, cause error) error {\n205|\tfor _, rendered := range causeChainText(cause) {\n206|\t\tif utf8.RuneCountInString(rendered) < minRedactableCause {\n207|\t\t\tcontinue\n208|\t\t}\n209|\t\tif strings.Contains(message, rendered) {\n210|\t\t\treturn fmt.Errorf(\"%w: message reproduces the local cause verbatim\", ErrCausalLeak)\n211|\t\t}\n212|\t\tfor _, key := range sortedKeys(details) {\n213|\t\t\tif valueContains(details[key], rendered) {\n214|\t\t\t\treturn fmt.Errorf(\"%w: details[%q] reproduces the local cause verbatim\", ErrCausalLeak, key)\n215|\t\t\t}\n216|\t\t}\n217|\t}\n218|\treturn nil\n219|}\n220|\n221|// causeChainText renders every link of the cause chain. Checking only the\n222|// outermost rendering would miss a message that copied the innermost wrapped\n223|// error, which is the link most likely to hold the untrusted text.\n224|func causeChainText(cause error) []string {\n225|\tvar rendered []string\n226|\tfor current := cause; current != nil; {\n227|\t\trendered = append(rendered, current.Error())\n228|\t\tswitch unwrapped := current.(type) {\n229|\t\tcase interface{ Unwrap() error }:\n230|\t\t\tcurrent = unwrapped.Unwrap()\n231|\t\tcase interface{ Unwrap() []error }:\n232|\t\t\tfor _, joined := range unwrapped.Unwrap() {\n233|\t\t\t\trendered = append(rendered, causeChainText(joined)...)\n234|\t\t\t}\n235|\t\t\tcurrent = nil\n236|\t\tdefault:\n237|\t\t\tcurrent = nil\n238|\t\t}\n239|\t}\n240|\treturn rendered\n241|}\n242|\n243|func valueContains(value any, needle string) bool {\n244|\tswitch typed := value.(type) {\n245|\tcase string:\n246|\t\treturn strings.Contains(typed, needle)\n247|\tcase []any:\n248|\t\tfor _, member := range typed {\n249|\t\t\tif valueContains(member, needle) {\n250|\t\t\t\treturn true\n251|\t\t\t}\n252|\t\t}\n253|\tcase map[string]any:\n254|\t\tfor _, member := range typed {\n255|\t\t\tif valueContains(member, needle) {\n256|\t\t\t\treturn true\n257|\t\t\t}\n258|\t\t}\n259|\t}\n260|\treturn false\n261|}\n262|\n263|func sortedKeys[Value any](source map[string]Value) []string {\n264|\tkeys := make([]string, 0, len(source))\n265|\tfor key := range source {\n266|\t\tkeys = append(keys, key)\n267|\t}\n268|\tsort.Strings(keys)\n269|\treturn keys\n270|}\n271|\n272|// RealmEvidence is the exact typed detail set Section 15.3 requires when\n273|// broker, tmux server generation, or functional-sentinel evidence is missing or\n274|// unsafe: \"capability_unavailable with typed details containing capability,\n275|// caller_realm, broker_state, tmux_server_generation, and remediation\".\n276|//\n277|// tmux_server_generation is carried here on that clause's explicit instruction.\n278|// The Section 16.2 exclusion of backend generations governs manifests and\n279|// bundles generated by ax, and the more specific clause licenses this one\n280|// diagnostic field.\n281|type RealmEvidence struct {\n282|\tCapability           string\n283|\tCallerRealm          string\n284|\tBrokerState          string\n285|\tTmuxServerGeneration string\n286|\tRemediation          string\n287|}\n288|\n289|// Details renders the typed set. Every field is required, because a caller that\n290|// omits one has not produced the typed details the clause names.\n291|func (evidence RealmEvidence) Details() (Details, error) {\n292|\treturn requiredTypedDetails(map[string]string{\n293|\t\t\"capability\":             evidence.Capability,\n294|\t\t\"caller_realm\":           evidence.CallerRealm,\n295|\t\t\"broker_state\":           evidence.BrokerState,\n296|\t\t\"tmux_server_generation\": evidence.TmuxServerGeneration,\n297|\t\t\"remediation\":            evidence.Remediation,\n298|\t})\n299|}\n300|\n301|// TargetAuth is the exact typed detail set Section 15.3 requires for\n302|// target_auth_missing: \"typed provider_id, provider_build, macos_version,\n303|// tmux_server_generation, and remediation\".\n304|type TargetAuth struct {\n305|\tProviderID           string\n306|\tProviderBuild        string\n307|\tMacOSVersion         string\n308|\tTmuxServerGeneration string\n309|\tRemediation          string\n310|}\n311|\n312|// Details renders the typed set. Every field is required.\n313|func (target TargetAuth) Details() (Details, error) {\n314|\treturn requiredTypedDetails(map[string]string{\n315|\t\t\"provider_id\":            target.ProviderID,\n316|\t\t\"provider_build\":         target.ProviderBuild,\n317|\t\t\"macos_version\":          target.MacOSVersion,\n318|\t\t\"tmux_server_generation\": target.TmuxServerGeneration,\n319|\t\t\"remediation\":            target.Remediation,\n320|\t})\n321|}\n322|\n323|// targetAuthMissingKeys is the presence requirement New enforces for\n324|// target_auth_missing, so the generic constructor cannot emit that code with a\n325|// weaker detail set than the typed constructor produces.\n326|var targetAuthMissingKeys = []string{\n327|\t\"macos_version\",\n328|\t\"provider_build\",\n329|\t\"provider_id\",\n330|\t\"remediation\",\n331|\t\"tmux_server_generation\",\n332|}\n333|\n334|func requiredTypedDetails(fields map[string]string) (Details, error) {\n335|\tdetails := make(Details, len(fields))\n336|\tfor _, key := range sortedKeys(fields) {\n337|\t\tif fields[key] == \"\" {\n338|\t\t\treturn nil, fmt.Errorf(\"%w: typed detail %q is required and must not be empty\", ErrInvalidDetails, key)\n339|\t\t}\n340|\t\tdetails[key] = fields[key]\n341|\t}\n342|\tif err := ValidateDetails(details); err != nil {\n343|\t\treturn nil, err\n344|\t}\n345|\treturn details, nil\n346|}\n347|\n348|func requireDetailKeys(code Code, details Details, required []string) error {\n349|\tfor _, key := range required {\n350|\t\tvalue, present := details[key]\n351|\t\tif !present {\n352|\t\t\treturn fmt.Errorf(\"%w: %q requires typed detail %q\", ErrInvalidDetails, code, key)\n353|\t\t}\n354|\t\ttext, ok := value.(string)\n355|\t\tif !ok || text == \"\" {\n356|\t\t\treturn fmt.Errorf(\"%w: %q requires a non-empty typed detail %q\", ErrInvalidDetails, code, key)\n357|\t\t}\n358|\t}\n359|\treturn nil\n360|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
