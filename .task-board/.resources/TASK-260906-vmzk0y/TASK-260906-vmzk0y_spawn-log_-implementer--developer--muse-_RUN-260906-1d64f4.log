{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd3f","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":1274,"recorded_at":1780531400002543,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"fc969802-ddc8-4fea-a2ec-fd90cf77bbc6"},"task_id":"fc969802-ddc8-4fea-a2ec-fd90cf77bbc6","event":{"kind":"output","task_id":"fc969802-ddc8-4fea-a2ec-fd90cf77bbc6","chunk":"{\n  \"chunk_id\": \"exec-58-1\",\n  \"command\": \"sed -n '480,700p' internal/terminalbackend/refusal_arm_inventory_test.go\",\n  \"description\": \"Read row struct, resolution, declared table head\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t\\t\\tcall, ok := returned.Results[0].(*ast.CallExpr)\\n\\t\\t\\tif !ok || len(call.Args) != 2 {\\n\\t\\t\\t\\tt.Fatalf(\\\"predicate %s does not call errorCode(err, Code); \\\"+\\n\\t\\t\\t\\t\\t\\\"the inventory cannot resolve it\\\", function.Name.Name)\\n\\t\\t\\t}\\n\\t\\t\\tcode, ok := call.Args[1].(*ast.Ident)\\n\\t\\t\\tif !ok {\\n\\t\\t\\t\\tt.Fatalf(\\\"predicate %s reports a non-static code; the inventory cannot resolve it\\\",\\n\\t\\t\\t\\t\\tfunction.Name.Name)\\n\\t\\t\\t}\\n\\t\\t\\tpredicates[function.Name.Name] = code.Name\\n\\t\\t}\\n\\t}\\n\\tif len(predicates) == 0 {\\n\\t\\tt.Fatal(\\\"resolved zero predicates; the scanner is broken, not the package\\\")\\n\\t}\\n\\treturn predicates\\n}\\n\\n// refusalTestRef names one asserting test by file and declaration name.\\ntype refusalTestRef struct {\\n\\tfile string\\n\\ttest string\\n}\\n\\n// declaredRefusalArm is one inventoried arm: the derived key (file,\\n// function, code symbol, static detail, occurrence), the publi