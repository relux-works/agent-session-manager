on\\\": {\\n3419-        \\\"path\\\": \\\"internal/provhost/quiesce.go\\\",\\n3420-        \\\"declaration\\\": \\\"DecodeQuiesceProof\\\"\\n3421-      },\\n3422-      \\\"acceptance_cases\\\": [\\n3423-        \\\"provhost-quiesce-proof\\\"\\n3424-      ],\\n3425-      \\\"coverage\\\": \\\"unevidenced\\\",\\n3426-      \\\"gap\\\": \\\"DecodeQuiesceProof implements the Section 7.6 quiescence proof decoder with its fail-closed safe-bit rules; the Provider Identity Record it carries is additionally checked by CheckIdentity, and no clause of Section 7.6 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 3 obligations it carries.\\\"\\n3427-    },\\n3428-    {\\n--\\n3431:        \\\"section:7.7\\\"\\n3432-      ],\\n3433-      \\\"production\\\": {\\n3434-        \\\"path\\\": \\\"internal/provhost/profile.go\\\",\\n3435-        \\\"declaration\\\": \\\"ProfileMapping\\\"\\n3436-      },\\n3437-      \\\"acceptance_cases\\\": [\\n3438-        \\\"provhost-profile-mapping\\\"\\n3439-      ],\\n3440-      \\\"coverage\\\": \\\"unevidenced\\\",\\n3441-      \\\"gap\\\": \\\"ProfileMapping implements the Section 7.7 execution-profile mapping as a closed six-provider vocabulary with unknown-profile refusal; version probing before mapping and the launch-plan equality rules belong to later leaves, and no clause of Section 7.7 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 4 obligations it carries.\\\"\\n3442-    },\\n3443-    {\\n\",\n  \"original_output_bytes\": 1884,\n  \"original_output_tokens\": 471,\n  \"truncated\": false\n}"}}}
