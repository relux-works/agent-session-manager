{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccf7","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":1238,"recorded_at":1780531400002471,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"e29e719a-9ea4-4ef7-ba7d-f02bb757b027"},"task_id":"e29e719a-9ea4-4ef7-ba7d-f02bb757b027","event":{"kind":"output","task_id":"e29e719a-9ea4-4ef7-ba7d-f02bb757b027","chunk":"edited\nchanged lines: lines 209-236\n--- original\n+++ updated\n@@\n-func descriptorGeometry(object map[string]any, name string) (uint16, error) {\n-\t// One arm for both geometry members: the uint16[1..1000] bound is one\n-\t// obligation, and the geometry test enumerates the columns shapes and\n-\t// the rows shapes against it.\n-\tliteral, ok := object[name].(json.Number)\n-\tif !ok {\n-\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry\"}\n-\t}\n-\tdigits := literal.String()\n-\tif len(digits) == 0 {\n-\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry\"}\n-\t}\n-\tvalue := 0\n-\tfor i := 0; i < len(digits); i++ {\n-\t\tdigit := digits[i]\n-\t\tif digit < '0' || digit > '9' {\n-\t\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry\"}\n-\t\t}\n-\t\tvalue = value*10 + int(digit-'0')\n-\t\tif value > 1000 {\n-\t\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry\"}\n-\t\t}\n-\t}\n-\tif value < 1 {\n-\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry\"}\n-\t}\n-\treturn uint16(value), nil\n-}\n+func descriptorGeometry(object map[string]any, name string) (uint16, error) {\n+\t// Three arms, one site each, shared by both geometry members: the JSON\n+\t// number type, the unsigned-integer literal shape, and the 1..1000\n+\t// bound are three distinct rules, and the geometry test enumerates the\n+\t// columns shapes and the rows shapes against each of them.\n+\tliteral, ok := object[name].(json.Number)\n+\tif !ok {\n+\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry type\"}\n+\t}\n+\tdigits := literal.String()\n+\tvalue := 0\n+\tfor i := 0; i < len(digits); i++ {\n+\t\tdigit := digits[i]\n+\t\tif digit < '0' || digit > '9' {\n+\t\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry digits\"}\n+\t\t}\n+\t\tvalue = value*10 + int(digit-'0')\n+\t}\n+\t// An empty literal spells no digits, so value stays 0 and lands on\n+\t// the bound arm rather than needing an arm of its own.\n+\tif value < 1 || value > 1000 {\n+\t\treturn 0, &Error{Code: CodeProtocolError, Detail: \"descriptor geometry bound\"}\n+\t}\n+\treturn uint16(value), nil\n+}\n"}}}
