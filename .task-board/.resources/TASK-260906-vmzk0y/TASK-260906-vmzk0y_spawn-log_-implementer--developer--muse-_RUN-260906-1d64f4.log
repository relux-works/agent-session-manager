.BackendID {\\n585:\\t\\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\"descriptor backend binding\\\"}\\n587:\\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\\n588:\\t\\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\"descriptor binding digest\\\"}\\n590:\\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\\n591:\\t\\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\"descriptor binding digest\\\"}\\n593:\\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\\n594:\\t\\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\\n595:\\t\\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \\\"descriptor version binding\\\"}\\n597:\\tif descriptor.Generation != binding.Generation {\\n===\\n574:func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\\n575-\\tif err := checkGeneration(descriptor.Generation); err != nil {\\n576-\\t\\treturn err\\n577-\\t}\\n578-\\tif err := checkGeneration(binding.Generation); err != nil {\\n579-\\t\\treturn err\\n580-\\t}\\n581-\\tif _, err := ParseID(descriptor.BackendID); err != nil {\\n582-\\t\\treturn err\\n583-\\t}\\n584-\\tif descriptor.BackendID != binding.BackendID {\\n585-\\t\\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\"descriptor backend binding\\\"}\\n586-\\t}\\n587-\\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\\n588-\\t\\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\"descriptor binding digest\\\"}\\n589-\\t}\\n590-\\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\\n591-\\t\\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \\\"descriptor binding digest\\\"}\\n592-\\t}\\n593-\\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\\n594-\\t\\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\\n595-\\t\\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \\\"descriptor version binding\\\"}\\n596-\\t}\\n597-\\tif descriptor.Generation != binding.Generation {\\n598-\\t\\treturn &Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \\\"descriptor generation binding\\\"}\\n599-\\t}\\n600-\\treturn nil\\n601-}\\n602-\\n603-// checkGeneration enforces string[1..256] measured in UTF-8 characters over\\n604-// valid UTF-8 (SPEC.md:321).\\n605-func checkGeneration(generation string) error {\\n606-\\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\\n607-\\t\\treturn &Error{Code: CodeStaleGeneration, Detail: \\\"backend_generation bound\\\"}\\n608-\\t}\\n609-\\treturn nil\\n610-}\\n611-\\n612-// DigestFile returns the sha256: digest of the executable at path after\\n613-// resolving symlinks. The target must be a regular file; anything else (or a\\n614-// read failure) is an error, never a digest. It distinguishes a failed read\\n615-// from an absent trust entry: callers must not fall back to PATH discovery.\\n616-func DigestFile(path string) (string, error) {\\n617-\\tresolved, err := filepath.EvalSymlinks(path)\\n618-\\tif err != nil {\\n619-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"terminal backend executable: %w\\\", err)\\n620-\\t}\\n621-\\tinfo, err := os.Stat(resolved)\\n622-\\tif err != nil {\\n623-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"terminal backend executable: %w\\\", err)\\n624-\\t}\\n625-\\tif !info.Mode().IsRegular() {\\n626-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"terminal backend executable %s: not a regular file\\\", resolved)\\n627-\\t}\\n628-\\traw, err := os.ReadFile(resolved)\\n629-\\tif err != nil {\\n630-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"terminal backend executable: %w\\\", err)\\n631-\\t}\\n632-\\tsum := sha256.Sum256(raw)\\n633-\\treturn \\\"sha256:\\\" + hex.EncodeToString(sum[:]), nil\\n634-