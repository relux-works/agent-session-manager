{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57b","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":280,"recorded_at":1780531400000555,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"fe81cd7e-8a6a-40b4-a33f-27a1f8a2c768"},"task_id":"fe81cd7e-8a6a-40b4-a33f-27a1f8a2c768","event":{"kind":"output","task_id":"fe81cd7e-8a6a-40b4-a33f-27a1f8a2c768","chunk":"Read text file `internal/axerror/binding.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n9|)\n10|\n11|// ErrUnboundContract reports a containing contract major that binds no\n12|// Structured Error version. It is returned rather than a default, because\n13|// guessing a version here is exactly the negotiation the pinned document\n14|// forbids.\n15|var ErrUnboundContract = errors.New(\"containing contract major binds no structured error version\")\n16|\n17|// ContainingContract identifies a contract that embeds Structured Error.\n18|type ContainingContract struct {\n19|\t// ID is the Section 1.5 schema identifier of the containing contract.\n20|\tID catalog.ContractID\n21|\t// Major is the containing contract's major version.\n22|\tMajor int\n23|}\n24|\n25|// staticBindings is the complete Section 15.1, 15.3, and 17.1 binding table.\n26|// Section 17.1 states the rule this table implements: \"None negotiates the\n27|// error schema separately. Compatibility is evaluated first for the containing\n28|// protocol and then against its fixed embedded-error validator.\"\n29|//\n30|// Every row is quoted from the pinned document:\n31|//   - 15.1: \"Provider protocol 2.x, task-board bridge 1.x, and Mesh RPC 2.x\n32|//     each embed exactly Structured Error 1.0.0.\"\n33|//   - 15.1: \"Session Adapter 1.0 and session.clone.* bind Structured Error\n34|//     1.1.0.\"\n35|//   - 14.2: \"Legacy commands select CLI Result 1.0.0 and Structured Error\n36|//     1.0.0; every session.clone.* command selects CLI Result 2.0.0 on success\n37|//     and Structured Error 1.1.0 on failure.\"\n38|//   - 15.3: Structured Error 1.2.0 \"is bound by Directory Node 1 and 2, Mesh\n39|//     RPC 3, CLI Result 3, and Directory Query 1\".\n40|//   - 15.3: \"Terminal Backend Protocol 1.0.0, Provider Protocol 3.0.0, Mesh RPC\n41|//     4.0.0, and CLI Result 4.0.0 statically bind Structured Error 1.3.0.\"\n42|var staticBindings = map[ContainingContract]Version{\n43|\t{ID: \"urn:ax:protocol:provider\", Major: 2}:               Version100,\n44|\t{ID: \"urn:ax:protocol:provider\", Major: 3}:               Version130,\n45|\t{ID: \"urn:ax:protocol:task-board-bridge\", Major: 1}:      Version100,\n46|\t{ID: \"urn:ax:protocol:rpc\", Major: 2}:                    Version100,\n47|\t{ID: \"urn:ax:protocol:rpc\", Major: 3}:                    Version120,\n48|\t{ID: \"urn:ax:protocol:rpc\", Major: 4}:                    Version130,\n49|\t{ID: \"urn:ax:protocol:session-adapter\", Major: 1}:        Version110,\n50|\t{ID: \"urn:ax:schema:cli-result\", Major: 1}:               Version100,\n51|\t{ID: \"urn:ax:schema:cli-result\", Major: 2}:               Version110,\n52|\t{ID: \"urn:ax:schema:cli-result\", Major: 3}:               Version120,\n53|\t{ID: \"urn:ax:schema:cli-result\", Major: 4}:               Version130,\n54|\t{ID: \"urn:ax:protocol:session-directory-node\", Major: 1}: Version120,\n55|\t{ID: \"urn:ax:protocol:session-directory-node\", Major: 2}: Version120,\n56|\t{ID: \"urn:ax:schema:session-directory-query\", Major: 1}:  Version120,\n57|\t{ID: \"urn:ax:protocol:terminal-backend\", Major: 1}:       Version130,\n58|}\n59|\n60|// BindingFor returns the exact Structured Error version that a containing\n61|// contract major statically binds. There is no negotiation path: the version is\n62|// selected by the containing contract alone, as Section 15.1 requires — \"the\n63|// containing protocol version is sufficient to select it\".\n64|//\n65|// An unregistered contract or major is refused. A caller cannot fall back to a\n66|// neighbouring major, and no default is returned.\n67|func BindingFor(contract ContainingContract) (Version, error) {\n68|\tversion, bound := staticBindings[contract]\n69|\tif !bound {\n70|\t\treturn \"\", fmt.Errorf(\"%w: %s major %d\", ErrUnboundContract, contract.ID, contract.Major)\n71|\t}\n72|\treturn version, nil\n73|}\n74|\n75|// BoundContracts returns every containing contract major that binds a\n76|// Structured Error version, in a stable order.\n77|func BoundContracts() []ContainingContract {\n78|\tresult := make([]ContainingContract, 0, len(staticBindings))\n79|\tfor contract := range staticBindings {\n80|\t\tresult = append(result, contract)\n81|\t}\n82|\tsort.Slice(result, func(left, right int) bool {\n83|\t\tif result[left].ID != result[right].ID {\n84|\t\t\treturn result[left].ID < result[right].ID\n85|\t\t}\n86|\t\treturn result[left].Major < result[right].Major\n87|\t})\n88|\treturn result\n89|}"}}}
