{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de43","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":3452,"recorded_at":1780531400006899,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"6c671186-49e5-4831-9088-e0f2522dc063"},"task_id":"6c671186-49e5-4831-9088-e0f2522dc063","event":{"kind":"output","task_id":"6c671186-49e5-4831-9088-e0f2522dc063","chunk":"{\n  \"chunk_id\": \"exec-142-1\",\n  \"command\": \"for i in 1 2 3 4 5 6 7 8 9; do task-board m \\\"check_item(TASK-260906-vmzk0y, item=$i)\\\" 2>&1 | head -1; done\",\n  \"description\": \"Check first nine DoD items\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":1,\\\"text\\\":\\\"Provider Protocol 3.0.0 envelope has exactly one named owner, recorded in provhost stated bounds and the traceability ownership registry\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":2,\\\"text\\\":\\\"A v3 envelope reaching provhost produces the documented outcome, driven in both directions: admitted where the owner accepts it and refused with the named arm where it does not\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":3,\\\"text\\\":\\\"The Error 1.3.0 binding for v3 is either implemented or an explicit stated bound names the deferring task; protocol.go no longer binds major 2 to Error 1.0.0 silently for v3\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":4,\\\"text\\\":\\\"A provider discovery failure lifts into an axerror Structured Error through a production path that axerror accepts, proven by driving the real lift\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":5,\\\"text\\\":\\\"A negative test shows a causal-leak shape is refused; no machine-local path, provider ID or owner identity reaches any wire message\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":6,\\\"text\\\":\\\"CheckProviderDescriptor is completed or relocated to the named owner, and the traceability registry records which package owns 7.A\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":7,\\\"text\\\":\\\"Every census or roster derives its denominator from production and fails closed on an unregistered site, an orphan row, an import alias and a var-binding, each control-planted\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":8,\\\"text\\\":\\\"Mutation battery reports killed over applied on a production-derived denominator with narrowing, arm-deletion and census-only separate, and NOT_APPLIED and COMPILE_FAIL as distinct rows\\\"}}\\n{\\\"ok\\\":true,\\\"result\\\":{\\\"checked\\\":true,\\\"id\\\":\\\"TASK-260906-vmzk0y\\\",\\\"item\\\":9,\\\"text\\\":\\\"Candidate tree OID in the outcome document equals the one the Change Request record carries, verified by listing the tree\\\"}}\\n\",\n  \"original_output_bytes\": 2121,\n  \"original_output_tokens\": 531,\n  \"truncated\": false\n}"}}}
