{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c635","stream":{"kind":"session","id":"01a0789a-315e-7c93-91ec-e79f4e2ce50f"},"sequence":373,"recorded_at":1780531400000741,"record_type":"event","durability":"durable","causation_id":"991286c9-5106-4a42-ba8b-579d37a173bb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"991286c9-5106-4a42-ba8b-579d37a173bb","run_stream":{"kind":"run","id":"991286c9-5106-4a42-ba8b-579d37a173bb"},"task_stream":{"kind":"task","id":"b798c437-3c70-4221-ad1d-606d50dfdcb9"},"task_id":"b798c437-3c70-4221-ad1d-606d50dfdcb9","event":{"kind":"output","task_id":"b798c437-3c70-4221-ad1d-606d50dfdcb9","chunk":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"grep -n \\\"CalculateObjectIdentity\\\\|VerifyObjectIdentity\\\\|validateProviderIdentity\\\\|record_id\\\" internal/canonicaljson/*.go | grep -v _test | head -30; echo ===; ls internal/canonicaljson/; echo ===; sed -n '1,80p' internal/provider/doc.go 2>/dev/null || ls internal/provider/\",\n  \"description\": \"Find canonicaljson identity and provider doc\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/canonicaljson/canonical.go:24:// strict decode path behind Canonicalize, CalculateObjectIdentity, and\\ninternal/canonicaljson/canonical.go:25:// VerifyObjectIdentity. Without it, one recursion frame per nesting level lets\\ninternal/canonicaljson/canonical.go:52:\\tSelfRecordID                   SelfField = \\\"record_id\\\"\\ninternal/canonicaljson/canonical.go:213://\\tCalculateObjectIdentity\\ninternal/canonicaljson/canonical.go:214://\\tVerifyObjectIdentity\\ninternal/canonicaljson/canonical.go:241:// CalculateObjectIdentity validates the AX common logical number model,\\ninternal/canonicaljson/canonical.go:251:func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\\ninternal/canonicaljson/canonical.go:305:// VerifyObjectIdentity drives the same production calculation and refuses a\\ninternal/canonicaljson/canonical.go:307:// prepareObjectIdentity with CalculateObjectIdentity, so it carries the same AX\\ninternal/canonicaljson/canonical.go:309:func VerifyObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\\ninternal/canonicaljson/closed_shapes.go:100:\\tregister(\\\"urn:ax:schema:provider-identity\\\", validateProviderIdentityRecord, \\\"1.0.0\\\")\\ninternal/canonicaljson/closed_shapes.go:206:\\t\\t\\\"schema\\\", \\\"schema_version\\\", \\\"record_id\\\", \\\"subject_id\\\", \\\"session_id\\\", \\\"name\\\", \\\"kind\\\",\\ninternal/canonicaljson/closed_shapes.go:228:\\t\\t\\\"schema\\\", \\\"schema_version\\\", \\\"record_id\\\", \\\"subject_id\\\", \\\"session_id\\\", \\\"name\\\", \\\"kind\\\",\\ninternal/canonicaljson/closed_shapes.go:247:\\tif err := requireDigest(object, \\\"record_id\\\"); err != nil {\\ninternal/canonicaljson/closed_shapes.go:645:\\t\\t\\\"kind\\\", \\\"operation_id\\\", \\\"bundle_id\\\", \\\"source_kind\\\", \\\"source_session_id\\\", \\\"source_session_record_id\\\",\\ninternal/canonicaljson/closed_shapes.go:646:\\t\\t\\\"source_checkpoint_id\\\", \\\"source_provider_identity_record_id\\\", \\\"source_native_session_id\\\", \\\"source_environment\\\",\\ninternal/canonicaljson/closed_shapes.go:674:\\tfor _, name := range []string{\\\"source_session_record_id\\\", \\\"source_checkpoint_id\\\", \\\"source_provider_identity_record_id\\\"} {\\ninternal/canonicaljson/closed_shapes.go:1001:\\t\\t\\\"entries\\\", \\\"child_manifest_ids\\\", \\\"workspace_snapshot\\\", \\\"provider_identity_record_id\\\",\\ninternal/canonicaljson/closed_shapes.go:1039:\\tif err := requireNullableDigest(object, \\\"provider_identity_record_id\\\"); err != nil {\\ninternal/canonicaljson/closed_shapes.go:1071:\\tproviderValue := object[\\\"provider_identity_record_id\\\"]\\ninternal/canonicaljson/core_records.go:42:\\t\\t\\\"schema\\\", \\\"schema_version\\\", \\\"record_id\\\", \\\"subject_id\\\", \\\"lease_id\\\", \\\"session_id\\\", \\\"epoch\\\",\\ninternal/canonicaljson/core_records.go:47:\\tif err := validateIdentityRecordEnvelope(object, leaseSchema, \\\"1.0.0\\\", \\\"record_id\\\"); err != nil {\\ninternal/canonicaljson/core_records.go:207:func validateProviderIdentityRecord(object map[string]any) error {\\ninternal/canonicaljson/core_records.go:209:\\t\\t\\\"schema\\\", \\\"schema_version\\\", \\\"record_id\\\", \\\"subject_id\\\", \\\"session_id\\\", \\\"provider_id\\\", \\\"provider_version\\\",\\ninternal/canonicaljson/core_records.go:214:\\tif err := validateIdentityRecordEnvelope(object, providerIdentitySchema, \\\"1.0.0\\\", \\\"record_id\\\"); err != nil {\\ninternal/canonicaljson/core_records.go:303:\\t\\t\\\"schema\\\", \\\"schema_version\\\", \\\"record_id\\\", \\\"subject_id\\\", \\\"workspace_group_id\\\", \\\"display_name\\\", \\\"members\\\",\\ninternal/canonicaljson/core_records.go:307:\\tif err := validateIdentityRecordEnvelope(object, workspaceGroupSchema, \\\"1.0.0\\\", \\\"record_id\\\"); err != nil {\\ninternal/canonicaljson/core_records.go:524:\\t\\t\\\"session.created\\\":           shape([]string{\\\"session_record_id\\\", \\\"bootstrap_operation_id\\\", \\\"first_checkpoint_operation_id\\\"}, checks(digests(\\\"session_record_id\\\"), uuid7s(\\\"bootstrap_operation_id\\\", \\\"first_checkpoint_operation_id\\\"))),\\ninternal/canonicaljson/core_records.go:527:\\t\\t\\\"provider.identified\\\":       shape([]string{\\\"provider_identity_record_id\\\", \\\"confidence\\\"}, checks(digests(\\\"provider_identity_record_id\\\"), enum(\\\"confidence\\\", \\\"exact\\\", \\\"strong\\\", \\\"weak\\\"))),\\ninternal/canonicaljson/core_records.go:534:\\t\\t\\\"session.bootstrap_aborted\\\": shape([]string{\\\"operation_id\\\", \\\"failure_phase\\\", \\\"provider_identity_record_id\\\", \\\"manager_session_ref\\\", \\\"process_closed\\\", \\\"store_closed\\\", \\\"resume_allowed\\\"}, validateBootstrapAbortedPayload),\\n===\\narray_order_inventory_test.go\\nboundary_constraints_test.go\\ncanonical_byte_bound_measurement_test.go\\ncanonical_number_contract_test.go\\ncanonical_refusal_proofs_test.go\\ncanonical_test.go\\ncanonical.go\\nclause_refusal_test.go\\nclosed_shape_refusal_proofs_test.go\\nclosed_shapes.go\\nclosed_vocabularies_test.go\\nconstraint_excerpt_test.go\\nconstraint_inventory_test.go\\ncore_record_guards_test.go\\ncore_record_refusal_proofs_test.go\\ncore_records_test.go\\ncore_records.go\\ncoupling_derivation_test.go\\ncoupling_proofs_test.go\\ncoupling_sweep_dump_test.go\\ndeclared_bounds_proofs_test.go\\ndeclared_bounds_test.go\\ndeclared_byte_bounds.go\\nfuzz_test.go\\ngolden_test.go\\ngrammar_inventory_test.go\\nidentity_fixtures_test.go\\nmember_shape_refusal_test.go\\nnesting_depth_test.go\\nperformance_test.go\\nrecord_conformance_test.go\\nrefusal_guards_test.go\\nsession_event_payload_inventory_test.go\\nsession_record_versions_test.go\\nstring_admission_test.go\\nterminal_backend_id_test.go\\ntestdata\\nutf8_subsumption_test.go\\nvalidation_config_test.go\\n===\\n// Package provider implements the M0 trusted provider plugin host boundary\\n// of pinned specification Section 7.1: deterministic executable discovery,\\n// trust recording, and substitution detection.\\n//\\n// The actor every Section 7.1 RFC 2119 keyword governs here is the ax host\\n// (this repository). The provider plugin is a child process this package\\n// never builds, probes, or executes: Discover takes no probe or execution\\n// callback, so the Section 7.1 duplicate refusal structurally happens before\\n// any probe or execution. Later leaves own the wire protocol (Section 7.2),\\n// manifests and capabilities (Sections 7.3-7.7, 8), and process lifecycle.\\n//\\n// This package is an internal M0 host boundary, not a public stable plugin\\n// SDK: Section 7.1 states that M0 MUST NOT advertise a public stable plugin\\n// SDK, so no exported symbol offers plugin authorship, version negotiation,\\n// or compatibility promises. The package lives under internal/ and declares\\n// no stability contract.\\n//\\n// Discovery consumes only operator configuration (providers.plugin_dirs in\\n// listed order, built-in adapters, then PATH when allow_path_plugins is\\n// true) and the host filesystem. Everything crossing that boundary is\\n// treated as attacker-influenced: a failed or partial read is reported as a\\n// failure, never as an absence that a fallback could treat as satisfied.\\n//\\n// The package mutates no durable state of its own. Trust returns a\\n// TrustRecord value the host persists; Verify rechecks that receipt against\\n// freshly read filesystem facts. There is therefore no crash or idempotency\\n// surface inside this package: repeated Discover calls over an unchanged\\n// tree return identical candidates, and Verify is a pure recheck.\\n//\\n// A discovered candidate carries no availability, status, or capability\\n// claim. Discovery answers which executable serves a provider ID; whether\\n// any capability is available is decided by the probe plane (a later leaf),\\n// never advertised here.\\n//\\n// Wire composition contract: Error Detail deliberately names provider\\n// IDs, paths, and trust dimensions in human text, and Error() appends\\n// the filesystem cause verbatim for errors.Is and errors.As. That\\n// rendering must never become a wire message as-is:\\n// axerror.refuseCausalLeak refuses any message reproducing a local\\n// cause, so the future cmd/ax lift of a discovery failure into a\\n// Structured Error must rebuild the message (dynamic facts into the\\n// Details map, cause stripped) rather than quoting Error(). No such\\n// call site exists yet; this paragraph names the rule that lift must\\n// follow.\\npackage provider\\n\",\n  \"original_output_bytes\": 7766,\n  \"original_output_tokens\": 1942,\n  \"truncated\": false\n}"}}}
