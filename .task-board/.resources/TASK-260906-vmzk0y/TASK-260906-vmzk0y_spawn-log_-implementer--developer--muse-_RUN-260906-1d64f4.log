use %q repeats acceptance case %q\\\", key, declared.ID, acceptanceID)\\n1179-\\t\\t\\t}\\n1180-\\t\\t\\tcaseSeen[acceptanceID] = struct{}{}\\n1181-\\t\\t\\tif _, registered := acceptanceIDs[acceptanceID]; !registered {\\n\",\n  \"original_output_bytes\": 2920,\n  \"original_output_tokens\": 730,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
