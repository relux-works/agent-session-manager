declaration\\\": \\\"TestAdmitProviderDescriptorAdmitsMatchingBinding\\\"\\n+        },\\n+        {\\n+          \\\"path\\\": \\\"internal/terminalbackend/descriptor_test.go\\\",\\n+          \\\"declaration\\\": \\\"TestAdmitProviderDescriptorRefusesMismatch\\\"\\n+        },\\n         {\\n           \\\"path\\\": \\\"internal/terminalbackend/terminalbackend_test.go\\\",\\n           \\\"declaration\\\": \\\"TestCheckProviderDescriptor\\\"\\n@@ -3386,14 +3394,14 @@\\n         \\\"section:7.A\\\"\\n       ],\\n       \\\"production\\\": {\\n-        \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n-        \\\"declaration\\\": \\\"ForRelease\\\"\\n+        \\\"path\\\": \\\"internal/terminalbackend/descriptor.go\\\",\\n+        \\\"declaration\\\": \\\"AdmitProviderDescriptor\\\"\\n       },\\n       \\\"acceptance_cases\\\": [\\n-        \\\"catalog-v050-exact\\\"\\n+        \\\"terminal-provider-descriptor-7a\\\"\\n       ],\\n       \\\"coverage\\\": \\\"unevidenced\\\",\\n-      \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.A; no clause of 7.A is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\\\"\\n+      \\\"gap\\\": \\\"AdmitProviderDescriptor is the complete Section 7.A provider-side gate: it parses the closed v3 TerminalDescriptor document and matches binding digest, backend ID/version, and generation against the AX-validated host-local binding, refusing mismatches before launch or observation. The v3 transport envelope stays with provhost's v2 machinery, which speaks major 2 only and refuses recognizable 3.x as incompatible_protocol per the Section 7.A mismatch rule; decoding v3 failures under Structured Error 1.3.0 awaits the dual-stack host follow-up described in TASK-260906-vmzk0y's outcome. No clause of 7.A is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\\\"\\