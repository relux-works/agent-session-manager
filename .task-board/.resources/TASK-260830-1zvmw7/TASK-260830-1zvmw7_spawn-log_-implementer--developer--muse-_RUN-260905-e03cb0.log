{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c985","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":797,"recorded_at":1780531400001589,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"ff994cfd-bffd-40a9-8861-2eaf274650d1"},"task_id":"ff994cfd-bffd-40a9-8861-2eaf274650d1","event":{"kind":"output","task_id":"ff994cfd-bffd-40a9-8861-2eaf274650d1","chunk":"Read text file `internal/traceability/traceability.go`.\n(399 line(s) above)\n400|\t\t\t// failure to measure, not a measured absence of obligation.\n401|\t\t\tmeasured := coverage[key]\n402|\t\t\tif measured.Level != coverageFull {\n403|\t\t\t\treturn Report{}, fail(\n404|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n405|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n406|\t\t\t}\n407|\t\t}\n408|\t}\n409|\tfor _, contract := range compatibilityCatalog.Contracts {\n410|\t\tkey := contractKey(contract.Name, string(contract.ID))\n411|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n412|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n413|\t\t}\n414|\t}\n415|\n416|\tcanonical, err := json.Marshal(registry)\n417|\tif err != nil {\n418|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n419|\t}\n420|\tdigest := sha256.Sum256(canonical)\n421|\tgotDigest := hex.EncodeToString(digest[:])\n422|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n423|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n424|\t}\n425|\n426|\treport := Report{\n427|\t\tContracts:              len(expected[ownershipContract]),\n428|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n429|\t\tAcceptanceCases:        len(acceptanceIDs),\n430|\t\tFixtures:               len(expected[ownershipFixture]),\n431|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n432|\t\tAssignedScopes:         len(assignedBindings),\n433|\t\tSectionBindings:        len(coverage),\n434|\t\tUnownedSections:        len(unowned),\n435|\t}\n436|\tfor _, measured := range coverage {\n437|\t\treport.NormativeClauses += measured.Total\n438|\t\treport.DischargedClauses += measured.Discharged\n439|\t\tswitch measured.Level {\n440|\t\tcase coverageFull:\n441|\t\t\treport.FullCoverage++\n442|\t\tcase coveragePartial:\n443|\t\t\treport.PartialCoverage++\n444|\t\tcase coverageSliver:\n445|\t\t\treport.SliverCoverage++\n446|\t\tcase coverageUnevidenced:\n447|\t\t\treport.UnevidencedCoverage++\n448|\t\tcase coverageUnmeasured:\n449|\t\t\treport.UnmeasuredCoverage++\n450|\t\t}\n451|\t}\n452|\treturn report, nil\n453|}\n454|\n455|// verifySectionCoverage measures every registered section binding against the\n456|// pinned document and refuses a coverage claim on any other ownership kind. A\n457|// contract or fixture owner has no section to be measured against, so a\n458|// coverage field there would be a claim the gate cannot check.\n459|func verifySectionCoverage(\n460|\tdocument *specdoc.Document,\n461|\tgroups []ownershipGroup,\n462|\tacceptanceIDs map[string]struct{},\n463|) (map[string]sectionCoverage, error) {\n464|\tresult := make(map[string]sectionCoverage)\n465|\tfor index, group := range groups {\n466|\t\tif group.Kind != ownershipSectionBinding {\n467|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n468|\t\t\t\treturn nil, fail(\n469|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n470|\t\t\t\t\tindex, group.Kind)\n471|\t\t\t}\n472|\t\t\tcontinue\n473|\t\t}\n474|\t\tif len(group.Keys) != 1 {\n475|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n476|\t\t}\n477|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n478|\t\tif err != nil {\n479|\t\t\treturn nil, err\n480|\t\t}\n481|\t\tif _, duplicate := result[measured.Key]; duplicate {\n482|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n483|\t\t}\n484|\t\tresult[measured.Key] = measured\n485|\t}\n486|\treturn result, nil\n487|}\n488|\n489|func verifyAcceptanceCases(checker *sourceChecker, cases []acceptanceCase) (map[string]struct{}, error) {\n490|\tif len(cases) == 0 {\n491|\t\treturn nil, fail(\"acceptance case registry is empty\")\n492|\t}\n493|\tseen := make(map[string]struct{}, len(cases))\n494|\tfor index, acceptance := range cases {\n495|\t\tif acceptance.ID == \"\" {\n496|\t\t\treturn nil, fail(\"acceptance case %d has an empty id\", index)\n497|\t\t}\n498|\t\tif _, duplicate := seen[acceptance.ID]; duplicate {\n499|\t\t\treturn nil, fail(\"duplicate acceptance case %q\", acceptance.ID)\n500|\t\t}\n501|\t\tseen[acceptance.ID] = struct{}{}\n502|\t\tif err := checker.verify(acceptance.Production, false); err != nil {\n503|\t\t\treturn nil, fail(\"acceptance case %q production owner: %v\", acceptance.ID, err)\n504|\t\t}\n505|\t\tif len(acceptance.Tests) == 0 {\n506|\t\t\treturn nil, fail(\"acceptance case %q has no executable test owner\", acceptance.ID)\n507|\t\t}\n508|\t\ttestSeen := make(map[codeReference]struct{}, len(acceptance.Tests))\n509|\t\tfor _, test := range acceptance.Tests {\n510|\t\t\tif _, duplicate := testSeen[test]; duplicate {\n511|\t\t\t\treturn nil, fail(\"acceptance case %q repeats test owner %s:%s\", acceptance.ID, test.Path, test.Declaration)\n512|\t\t\t}\n513|\t\t\ttestSeen[test] = struct{}{}\n514|\t\t\tif err := checker.verify(test, true); err != nil {\n515|\t\t\t\treturn nil, fail(\"acceptance case %q test owner: %v\", acceptance.ID, err)\n516|\t\t\t}\n517|\t\t}\n518|\t}\n519|\treturn seen, nil\n520|}\n521|\n522|func verifyOwnershipGroups(\n523|\tchecker *sourceChecker,\n524|\tgroups []ownershipGroup,\n525|\tacceptanceIDs map[string]struct{},\n526|\tallowed map[ownershipKind]map[string]struct{},\n527|\trequired map[ownershipKind]map[string]struct{},\n528|\tselectedSectionBindings map[string]struct{},\n529|) (map[ownershipKind]map[string]struct{}, error) {\n(more lines below)"}}}
