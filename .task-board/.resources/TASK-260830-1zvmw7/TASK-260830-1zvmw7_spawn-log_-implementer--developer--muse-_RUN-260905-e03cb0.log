{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c611","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":355,"recorded_at":1780531400000705,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"c7fdb754-1e18-4062-aae6-a6d527208d11"},"task_id":"c7fdb754-1e18-4062-aae6-a6d527208d11","event":{"kind":"output","task_id":"c7fdb754-1e18-4062-aae6-a6d527208d11","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1785 line(s) above)\n1786|\treturn nil\n1787|}\n1788|\n1789|// factsCover reports whether the fact set satisfies every listed\n1790|// requirement through the requirement-to-fact mapping. Supplementary facts\n1791|// (ui_absent, prompt_absent) never satisfy a requirement alone.\n1792|func factsCover(facts []string, requirements []string) bool {\n1793|\theld := make(map[string]bool, len(facts))\n1794|\tfor _, fact := range facts {\n1795|\t\theld[fact] = true\n1796|\t}\n1797|\tfor _, requirement := range requirements {\n1798|\t\tif !held[requirementFact[requirement]] {\n1799|\t\t\treturn false\n1800|\t\t}\n1801|\t}\n1802|\treturn true\n1803|}\n1804|\n1805|// checkEvidenceIDs enforces the exact rule-6 set equality: evidence_ids\n1806|// must be exactly the sorted unique IDs of the usable evidence objects.\n1807|// Dangling IDs, unlisted usable objects, and ordering deviations all fail.\n1808|func checkEvidenceIDs(probe Probe, used []Evidence) error {\n1809|\twant := make([]string, 0, len(used))\n1810|\tfor _, object := range used {\n1811|\t\twant = append(want, object.EvidenceID)\n1812|\t}\n1813|\tfor index := range want {\n1814|\t\tfor next := index + 1; next < len(want); next++ {\n1815|\t\t\tif want[next] < want[index] {\n1816|\t\t\t\twant[index], want[next] = want[next], want[index]\n1817|\t\t\t}\n1818|\t\t}\n1819|\t}\n1820|\tif !equalStrings(probe.EvidenceIDs, want) {\n1821|\t\treturn mismatchf(\"evidence id set binding\")\n1822|\t}\n1823|\treturn nil\n1824|}\n1825|\n1826|// admitCapabilities collects the sorted admitted true-claim names and the\n1827|// sorted evidence IDs that proved them.\n1828|func admitCapabilities(probeClaims map[string]Claim, used []Evidence) Admitted {\n1829|\tvar capabilities []string\n1830|\tfor capability, claim := range probeClaims {\n1831|\t\tif claim.Value {\n1832|\t\t\tcapabilities = append(capabilities, capability)\n1833|\t\t}\n1834|\t}\n1835|\tfor index := range capabilities {\n1836|\t\tfor next := index + 1; next < len(capabilities); next++ {\n1837|\t\t\tif capabilities[next] < capabilities[index] {\n1838|\t\t\t\tcapabilities[index], capabilities[next] = capabilities[next], capabilities[index]\n1839|\t\t\t}\n1840|\t\t}\n1841|\t}\n1842|\tevidenceIDs := make([]string, 0, len(used))\n1843|\tfor _, object := range used {\n1844|\t\tevidenceIDs = append(evidenceIDs, object.EvidenceID)\n1845|\t}\n1846|\tfor index := range evidenceIDs {\n1847|\t\tfor next := index + 1; next < len(evidenceIDs); next++ {\n1848|\t\t\tif evidenceIDs[next] < evidenceIDs[index] {\n1849|\t\t\t\tevidenceIDs[index], evidenceIDs[next] = evidenceIDs[next], evidenceIDs[index]\n1850|\t\t\t}\n1851|\t\t}\n1852|\t}\n1853|\treturn Admitted{Capabilities: capabilities, EvidenceIDs: evidenceIDs}\n1854|}\n1855|\n1856|// AdmitProbe is the registry-bound production admission: it parses the\n1857|// Manifest, resolves the backend through the admitted registry (unknown\n1858|// identities fail closed, never default), binds the Manifest identity tuple\n1859|// to the admitted record, then reconciles the Probe with its evidence set.\n1860|// Trust is established before any probe: registration-time trust admission\n1861|// owns executables, and this gate additionally refuses executable\n1862|// substitution as untrusted and any other identity drift as drift.\n1863|//\n1864|// rawGeneration is the AX-known current raw generation for the backend;\n1865|// now is the admission instant; verify authenticates evidence through the\n1866|// trusted key registry and must be non-nil.\n1867|func (registry *Registry) AdmitProbe(manifestRaw, probeRaw []byte, evidenceRaws [][]byte, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1868|\tif registry == nil {\n1869|\t\treturn Admitted{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n1870|\t}\n1871|\tmanifest, err := ParseManifest(manifestRaw)\n1872|\tif err != nil {\n1873|\t\treturn Admitted{}, err\n1874|\t}\n1875|\trecord, err := registry.Resolve(manifest.TerminalBackendID)\n1876|\tif err != nil {\n1877|\t\treturn Admitted{}, err\n1878|\t}\n1879|\tif err := checkManifestRecordBinding(manifest, record); err != nil {\n1880|\t\treturn Admitted{}, err\n1881|\t}\n1882|\tprobe, err := ParseProbe(probeRaw)\n1883|\tif err != nil {\n1884|\t\treturn Admitted{}, err\n1885|\t}\n1886|\tevidence := make([]Evidence, 0, len(evidenceRaws))\n1887|\tfor _, raw := range evidenceRaws {\n1888|\t\tobject, err := ParseEvidence(raw)\n1889|\t\tif err != nil {\n1890|\t\t\treturn Admitted{}, err\n1891|\t\t}\n1892|\t\tevidence = append(evidence, object)\n1893|\t}\n1894|\treturn Reconcile(manifest, probe, evidence, rawGeneration, now, verify)\n1895|}\n1896|\n1897|// checkManifestRecordBinding binds the Manifest identity tuple to the\n1898|// admitted registry record: implementation version, protocol set, platform\n1899|// set, and kind must match member-for-member, and the executable digest\n1900|// must match exactly. Any version/kind/platform drift is drift; an\n1901|// executable substitution is untrusted.\n1902|func checkManifestRecordBinding(manifest Manifest, record Registration) error {\n1903|\tif manifest.ImplementationVersion != record.ImplementationVersion ||\n1904|\t\tmanifest.ImplementationKind != record.Kind ||\n1905|\t\t!equalStrings(manifest.ProtocolVersions, record.ProtocolVersions) ||\n1906|\t\t!equalPlatforms(manifest.Platforms, record.Platforms) {\n1907|\t\treturn &Error{Code: CodeDrift, BackendID: manifest.TerminalBackendID, Detail: \"manifest implementation drift\"}\n1908|\t}\n1909|\tif manifest.ExecutableDigest != record.ExecutableDigest {\n1910|\t\treturn &Error{Code: CodeUntrusted, BackendID: manifest.TerminalBackendID, Detail: \"executable substitution\"}\n1911|\t}\n1912|\treturn nil\n1913|}\n1914|\n1915|// equalPlatforms reports element-wise equality of two platform lists. Both\n1916|// lists are validated sorted unique, so order is significant.\n1917|func equalPlatforms(left, right []scalar.Platform) bool {\n1918|\tif len(left) != len(right) {\n1919|\t\treturn false\n1920|\t}\n1921|\tfor index := range left {\n1922|\t\tif left[index] != right[index] {\n1923|\t\t\treturn false\n1924|\t\t}\n1925|\t}\n1926|\treturn true\n1927|}\n1928|\n1929|// parseRealmProvider validates the provider_id/provider_build pair: null or\n1930|// a provider-id grammar value plus a string[1..256] build.\n1931|func parseRealmProvider(object map[string]any) (string, string, error) {\n1932|\trawID, known := object[\"provider_id\"]\n1933|\tif !known {\n1934|\t\treturn \"\", \"\", mismatchf(\"document members\")\n1935|\t}\n1936|\tproviderID := \"\"\n1937|\tif rawID != nil {\n1938|\t\tname, ok := rawID.(string)\n1939|\t\tif !ok {\n1940|\t\t\treturn \"\", \"\", mismatchf(\"document member type\")\n1941|\t\t}\n1942|\t\tif _, err := scalar.ParseProviderID(name); err != nil {\n1943|\t\t\treturn \"\", \"\", mismatchf(\"evidence provider identity\")\n1944|\t\t}\n1945|\t\tproviderID = name\n1946|\t}\n1947|\trawBuild, known := object[\"provider_build\"]\n1948|\tif !known {\n1949|\t\treturn \"\", \"\", mismatchf(\"document members\")\n1950|\t}\n1951|\tproviderBuild := \"\"\n1952|\tif rawBuild != nil {\n1953|\t\tbuild, ok := rawBuild.(string)\n1954|\t\tif !ok {\n1955|\t\t\treturn \"\", \"\", mismatchf(\"document member type\")\n1956|\t\t}\n1957|\t\tif !utf8.ValidString(build) || len(build) < 1 || len(build) > maxOpaqueString {\n1958|\t\t\treturn \"\", \"\", mismatchf(\"document string bound\")\n1959|\t\t}\n1960|\t\tproviderBuild = build\n1961|\t}\n1962|\tif (providerID == \"\") != (providerBuild == \"\") {\n1963|\t\treturn \"\", \"\", mismatchf(\"evidence realm binding\")\n1964|\t}\n1965|\treturn providerID, providerBuild, nil\n1966|}\n1967|\n1968|// parseRealmLiteral validates a literal passed|null realm member.\n1969|func parseRealmLiteral(object map[string]any, name string) (string, error) {\n1970|\traw, known := object[name]\n1971|\tif !known {\n1972|\t\treturn \"\", mismatchf(\"document members\")\n1973|\t}\n1974|\tif raw == nil {\n1975|\t\treturn \"\", nil\n1976|\t}\n1977|\tvalue, ok := raw.(string)\n1978|\tif !ok || value != \"passed\" {\n1979|\t\treturn \"\", mismatchf(\"evidence realm result\")\n1980|\t}\n1981|\treturn value, nil\n1982|}"}}}
