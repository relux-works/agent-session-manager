{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bf","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":186,"recorded_at":1780531400000367,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"30bff060-85a9-41a4-9741-779c8c07ed8a"},"task_id":"30bff060-85a9-41a4-9741-779c8c07ed8a","event":{"kind":"output","task_id":"30bff060-85a9-41a4-9741-779c8c07ed8a","chunk":"Read text file `/tmp/rev/TASK-260830-1zvmw7_review-aliasing-probe.go.txt`.\n1|package terminalbackend\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"reflect\"\n6|\t\"testing\"\n7|\t\"time\"\n8|)\n9|\n10|// snapshotInterior renders every package-level table plus a fresh registry's\n11|// built-in records so any interior mutation shows up as a string diff.\n12|func snapshotInterior(t *testing.T) string {\n13|\tt.Helper()\n14|\tregistry, err := New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n15|\tif err != nil {\n16|\t\tt.Fatalf(\"New: %v\", err)\n17|\t}\n18|\tvar out string\n19|\tfor _, id := range registry.IDs() {\n20|\t\trecord, err := registry.Resolve(id)\n21|\t\tif err != nil {\n22|\t\t\tt.Fatalf(\"Resolve(%s): %v\", id, err)\n23|\t\t}\n24|\t\tout += fmt.Sprintf(\"REG %s %+v\\n\", id, record)\n25|\t}\n26|\tkeys := []string{}\n27|\tfor k := range capabilityRegistry {\n28|\t\tkeys = append(keys, k)\n29|\t}\n30|\tfor i := range keys {\n31|\t\tfor j := i + 1; j < len(keys); j++ {\n32|\t\t\tif keys[j] < keys[i] {\n33|\t\t\t\tkeys[i], keys[j] = keys[j], keys[i]\n34|\t\t\t}\n35|\t\t}\n36|\t}\n37|\tfor _, k := range keys {\n38|\t\tout += fmt.Sprintf(\"CAP %s %+v\\n\", k, capabilityRegistry[k])\n39|\t}\n40|\tout += fmt.Sprintf(\"OPS %v\\nREQ %v\\nFACT %v\\nRMAP %v\\n\",\n41|\t\toperationVocabulary, evidenceRequirementVocabulary, evidenceFactVocabulary, requirementFact)\n42|\tout += fmt.Sprintf(\"MEMBERS %v %v %v\\n\", manifestMembers, probeMembers, evidenceMembers)\n43|\treturn out\n44|}\n45|\n46|// mutateEverything walks an arbitrary value reflectively and writes a\n47|// poison value into every reachable slice element, map value and settable\n48|// string/bool/byte field. This is the \"probe, do not read\" half of G-A: it\n49|// does not care which field aliases what, it scribbles on all of them.\n50|func mutateEverything(v reflect.Value, depth int) {\n51|\tif depth > 8 || !v.IsValid() {\n52|\t\treturn\n53|\t}\n54|\tswitch v.Kind() {\n55|\tcase reflect.Slice, reflect.Array:\n56|\t\tfor i := 0; i < v.Len(); i++ {\n57|\t\t\tmutateEverything(v.Index(i), depth+1)\n58|\t\t}\n59|\tcase reflect.Struct:\n60|\t\tfor i := 0; i < v.NumField(); i++ {\n61|\t\t\tmutateEverything(v.Field(i), depth+1)\n62|\t\t}\n63|\tcase reflect.Ptr, reflect.Interface:\n64|\t\tif !v.IsNil() {\n65|\t\t\tmutateEverything(v.Elem(), depth+1)\n66|\t\t}\n67|\tcase reflect.Map:\n68|\t\tfor _, k := range v.MapKeys() {\n69|\t\t\told := v.MapIndex(k)\n70|\t\t\tif old.Kind() == reflect.String && old.CanInterface() {\n71|\t\t\t\tv.SetMapIndex(k, reflect.ValueOf(\"REVIEW-POISON\").Convert(old.Type()))\n72|\t\t\t}\n73|\t\t}\n74|\tcase reflect.String:\n75|\t\tif v.CanSet() {\n76|\t\t\tv.SetString(\"REVIEW-POISON\")\n77|\t\t}\n78|\tcase reflect.Bool:\n79|\t\tif v.CanSet() {\n80|\t\t\tv.SetBool(!v.Bool())\n81|\t\t}\n82|\tcase reflect.Uint8:\n83|\t\tif v.CanSet() {\n84|\t\t\tv.SetUint(0xEE)\n85|\t\t}\n86|\t}\n87|}\n88|\n89|// TestReviewGA_NoExportedPathReachesInteriorArrays enumerates every leaf-2\n90|// exported entry point that returns composite data, scribbles on everything\n91|// reachable through the returned value, and asserts the package interior\n92|// (built-in registrations plus the closed capability tables) is byte-identical\n93|// afterwards.\n94|func TestReviewGA_NoExportedPathReachesInteriorArrays(t *testing.T) {\n95|\tbefore := snapshotInterior(t)\n96|\n97|\tuniverse := reviewUniverse(t)\n98|\n99|\t// 1. CapabilitiesForOperation over the whole closed vocabulary.\n100|\tfor op := range operationVocabulary {\n101|\t\tgot, err := CapabilitiesForOperation(op)\n102|\t\tif err != nil {\n103|\t\t\tt.Fatalf(\"CapabilitiesForOperation(%s): %v\", op, err)\n104|\t\t}\n105|\t\tmutateEverything(reflect.ValueOf(&got).Elem(), 0)\n106|\t}\n107|\n108|\t// 2. ParseManifest / ParseProbe / ParseEvidence outputs.\n109|\tmanifest, err := ParseManifest(universe.manifestRaw)\n110|\tif err != nil {\n111|\t\tt.Fatalf(\"ParseManifest: %v\", err)\n112|\t}\n113|\tprobe, err := ParseProbe(universe.probeRaw)\n114|\tif err != nil {\n115|\t\tt.Fatalf(\"ParseProbe: %v\", err)\n116|\t}\n117|\tvar evidence []Evidence\n118|\tfor _, raw := range universe.evidenceRaws {\n119|\t\tobject, err := ParseEvidence(raw)\n120|\t\tif err != nil {\n121|\t\t\tt.Fatalf(\"ParseEvidence: %v\", err)\n122|\t\t}\n123|\t\tevidence = append(evidence, object)\n124|\t}\n125|\n126|\t// 3. Reconcile + Admitted accessors, then AdmitProbe through the registry.\n127|\tadmitted, err := Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, universe.verify)\n128|\tif err != nil {\n129|\t\tt.Fatalf(\"Reconcile: %v\", err)\n130|\t}\n131|\t_ = admitted.Has(\"durable_disconnect\")\n132|\t_ = admitted.HasOperation(\"create\")\n133|\t_ = CheckOperation(\"create\", admitted)\n134|\tmsg, err := UnsignedEvidenceBytes(evidence[0])\n135|\tif err != nil {\n136|\t\tt.Fatalf(\"UnsignedEvidenceBytes: %v\", err)\n137|\t}\n138|\tmutateEverything(reflect.ValueOf(&msg).Elem(), 0)\n139|\n140|\tregistry, err := New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n141|\tif err != nil {\n142|\t\tt.Fatalf(\"New: %v\", err)\n143|\t}\n144|\tadmitted2, err := registry.AdmitProbe(universe.manifestRaw, universe.probeRaw, universe.evidenceRaws,\n145|\t\tuniverse.rawGeneration, universe.now, universe.verify)\n146|\tif err != nil {\n147|\t\tt.Fatalf(\"AdmitProbe: %v\", err)\n148|\t}\n149|\n150|\t// Scribble on every returned composite.\n151|\tmutateEverything(reflect.ValueOf(&manifest).Elem(), 0)\n152|\tmutateEverything(reflect.ValueOf(&probe).Elem(), 0)\n153|\tmutateEverything(reflect.ValueOf(&evidence).Elem(), 0)\n154|\tmutateEverything(reflect.ValueOf(&admitted).Elem(), 0)\n155|\tmutateEverything(reflect.ValueOf(&admitted2).Elem(), 0)\n156|\n157|\t// Also scribble on the registry-facing record this leaf reads.\n158|\trecord, err := registry.Resolve(BuiltinTmux)\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"Resolve: %v\", err)\n161|\t}\n162|\tmutateEverything(reflect.ValueOf(&record).Elem(), 0)\n163|\n164|\tafter := snapshotInterior(t)\n165|\tif before != after {\n166|\t\tt.Errorf(\"package interior mutated through an exported path:\\nBEFORE\\n%s\\nAFTER\\n%s\", before, after)\n167|\t}\n168|\n169|\t// A fresh admission after all that scribbling must still admit identically.\n170|\tregistry3, err := New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"New: %v\", err)\n173|\t}\n174|\tfresh, err := registry3.AdmitProbe(universe.manifestRaw, universe.probeRaw, universe.evidenceRaws,\n175|\t\tuniverse.rawGeneration, universe.now, universe.verify)\n176|\tif err != nil {\n177|\t\tt.Fatalf(\"AdmitProbe after mutation: %v\", err)\n178|\t}\n179|\tif fmt.Sprint(fresh) != universe.wantAdmitted {\n180|\t\tt.Errorf(\"AdmitProbe after mutation = %v, want %v\", fresh, universe.wantAdmitted)\n181|\t}\n182|}\n183|\n184|// reviewFixtures is the review-owned raw-byte universe for the ax.tmux\n185|// built-in, so AdmitProbe (the registry-bound production entry point) is\n186|// reachable from the internal test package.\n187|type reviewFixtures struct {\n188|\tmanifestRaw   []byte\n189|\tprobeRaw      []byte\n190|\tevidenceRaws  [][]byte\n191|\trawGeneration string\n192|\tnow           time.Time\n193|\tverify        SignatureVerifier\n194|\twantAdmitted  string\n195|}\n196|\n197|func reviewUniverse(t *testing.T) *reviewFixtures {\n198|\tt.Helper()\n199|\tgeneration, err := GenerationDigest(\"generation-alpha\")\n200|\tif err != nil {\n201|\t\tt.Fatalf(\"GenerationDigest: %v\", err)\n202|\t}\n203|\tfixture := testPinDigest(0xF1)\n204|\tissuer := testPinDigest(0x1D)\n205|\n206|\tmanifest := pinManifest(fixture)\n207|\tmanifest[\"terminal_backend_id\"] = BuiltinTmux\n208|\tmanifest[\"protocol_versions\"] = []any{\"1.0.0\", \"1.1.0\"}\n209|\tmanifest[\"platforms\"] = []any{\"linux\", \"macos\", \"wsl2\"}\n210|\n211|\tvar evidenceRaws [][]byte\n212|\tvar ids []string\n213|\tfor _, capability := range []string{\"graceful_stop\", \"headless_creation\"} {\n214|\t\tobject := pinEvidence(capability, generation, fixture, issuer)\n215|\t\tobject[\"terminal_backend_id\"] = BuiltinTmux\n216|\t\tstampPinIdentity(t, object, \"evidence_id\")\n217|\t\traw := mustPinJSON(t, object)\n218|\t\tparsed, err := ParseEvidence(raw)\n219|\t\tif err != nil {\n220|\t\t\tt.Fatalf(\"ParseEvidence: %v\", err)\n221|\t\t}\n222|\t\tevidenceRaws = append(evidenceRaws, raw)\n223|\t\tids = append(ids, parsed.EvidenceID)\n224|\t}\n225|\tsortReviewStrings(ids)\n226|\n227|\tprobe := pinProbe(generation, ids)\n228|\tprobe[\"terminal_backend_id\"] = BuiltinTmux\n229|\tstampPinIdentity(t, manifest, \"manifest_id\")\n230|\tstampPinIdentity(t, probe, \"probe_id\")\n231|\n232|\treturn &reviewFixtures{\n233|\t\tmanifestRaw:   mustPinJSON(t, manifest),\n234|\t\tprobeRaw:      mustPinJSON(t, probe),\n235|\t\tevidenceRaws:  evidenceRaws,\n236|\t\trawGeneration: \"generation-alpha\",\n237|\t\tnow:           testAdmissionTime(),\n238|\t\tverify:        pinVerifier,\n239|\t\twantAdmitted:  \"{[graceful_stop headless_creation] [\" + ids[0] + \" \" + ids[1] + \"]}\",\n240|\t}\n241|}\n242|\n243|func sortReviewStrings(values []string) {\n244|\tfor i := range values {\n245|\t\tfor j := i + 1; j < len(values); j++ {\n246|\t\t\tif values[j] < values[i] {\n247|\t\t\t\tvalues[i], values[j] = values[j], values[i]\n248|\t\t\t}\n249|\t\t}\n250|\t}\n251|}"}}}
