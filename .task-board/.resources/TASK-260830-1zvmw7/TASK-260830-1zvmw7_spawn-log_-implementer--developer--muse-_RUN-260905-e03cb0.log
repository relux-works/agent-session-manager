n38|// own recipe implementation: JCS bytes of the object with the self field\n39|// omitted, SHA-256, lowercase sha256: prefix.\n40|func testIdentity(t *testing.T, object map[string]any, selfField string) string {\n41|\tt.Helper()\n42|\n43|\tomitted := make(map[string]any, len(object))\n44|\tfor name, member := range object {\n45|\t\tif name != selfField {\n46|\t\t\tomitted[name] = member\n47|\t\t}\n48|\t}\n49|\tserialized, err := json.Marshal(omitted)\n50|\tif err != nil {\n51|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n52|\t}\n53|\tcanonical, err := jcs.Transform(serialized)\n54|\tif err != nil {\n55|\t\tt.Fatalf(\"canonicalize omit-self object: %v\", err)\n56|\t}\n57|\tsum := sha256.Sum256(canonical)\n58|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n59|}\n60|\n61|// testEvidenceMessage builds the exact bytes an attestation signs per\n62|// Section 4.D: ASCII domain, one zero byte, JCS of the evidence object with\n63|// exactly evidence_id and attestation_signature omitted.\n64|func testEvidenceMessage(t *testing.T, object map[string]any) []byte {\n65|\tt.Helper()\n66|\n67|\tomitted := make(map[string]any, len(object))\n68|\tfor name, member := range object {\n69|\t\tif name != \"evidence_id\" && name != \"attestation_signature\" {\n70|\t\t\tomitted[name] = member\n71|\t\t}\n72|\t}\n73|\tserialized, err := json.Marshal(omitted)\n74|\tif err != nil {\n75|\t\tt.Fatalf(\"marshal unsigned evidence: %v\", err)\n76|\t}\n77|\tcanonical, err := jcs.Transform(serialized)\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"canonicalize unsigned evidence: %v\", err)\n80|\t}\n81|\tmessage := append([]byte(\"ax-terminal-capability-evidence-v1\"), 0x00)\n82|\treturn append(message, canonical...)\n83|}\n84|\n85|// testKey generates one RSA attestation key for the test run.\n86|func testKey(t *testing.T) *rsa.PrivateKey {\n87|\tt.Helper()\n88|\n89|\tkey, err := rsa.GenerateKey(rand.Reader, 1024)\n90|\tif err != nil {\n91|\t\tt.Fatalf(\"generate attestation key: %v\", err)\n92|\t}\n93|\treturn key\n94|}\n95|\n96|// testSignBody signs the Section 4.D message for object with key and writes\n97|// the attestation_signature member.\n98|func testSignBody(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n99|\tt.Helper()\n100|\n101|\tmessage := testEvidenceMessage(t, object)\n102|\tdigest := sha256.Sum256(message)\n103|\tsignature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"sign evidence: %v\", err)\n106|\t}\n107|\tobject[\"attestation_signature\"] = \"rsa-sha256:\" + base64.StdEncoding.EncodeToString(signature)\n108|}\n109|\n110|// finalizeEvidence signs object with key and stamps its recomputed\n111|// evidence_id, yielding a fully valid evidence document map.\n112|func finalizeEvidence(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n113|\tt.Helper()\n114|\n115|\ttestSignBody(t, key, object)\n116|\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n117|}\n118|\n119|// finalizeDocument stamps the recomputed omit-self identity on a manifest\n120|// or probe document map.\n121|func finalizeDocument(t *testing.T, object map[string]any, selfField string) {\n122|\tt.Helper()\n123|\n124|\tobject[selfField] = testIdentity(t, object, selfField)\n125|}\n126|\n127|// mustMarshal encodes a fixture map to JSON bytes.\n128|func mustMarshal(t *testing.T, object map[string]any) []byte {\n129|\tt.Helper()\n130|\n131|\traw, err := json.Marshal(object)\n132|\tif err != nil {\n133|\t\tt.Fatalf(\"marshal fixture: %v\", err)\n134|\t}\n135|\treturn raw\n136|}\n137|\n138|// testVerifier authenticates evidence through one trusted key: it verifies\n139|// the RSA signature and fails on anything else, mirroring the production\n140|// contract that a caller-supplied issuer ID alone is never authentication.\n141|func testVerifier(key *rsa.PrivateKey) terminalbackend.SignatureVerifier {\n142|\treturn func(issuerID string, message, signature []byte) error {\n143|\t\tdigest := sha256.Sum256(message)\n144|\t\treturn rsa.VerifyPKCS1v15(&key.PublicKey, crypto.SHA256, digest[:], signature)\n145|\t}\n146|}\n147|\n148|// claimMap transcribes one registry-row claim. The row members are copied\n149|// from the Section 4.D table, not from production, so row drift fails.\n150|func claimMap(capability, origin string, value bool) map[string]any {\n151|\trows := map[string]map[string]any{\n152|\t\t\"durable_disconnect\": {\n153|\t\t\t\"generation_variable\":   false,\n154|\t\t\t\"dependent_operations\":  []any{\"create\", \"status\"},\n155|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n156|\t\t},\n157|\t\t\"local_attach\": {\n158|\t\t\t\"generation_variable\":   true,\n159|\t\t\t\"dependent_operations\":  []any{\"attach\"},\n160|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n161|\t\t},\n162|\t\t\"headless_creation\": {\n163|\t\t\t\"generation_variable\":   true,\n164|\t\t\t\"dependent_operations\":  []any{\"create\"},\n165|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n166|\t\t},\n167|\t\t\"graceful_stop\": {\n168|\t\t\t\"generation_variable\":   true,\n169|\t\t\t\"dependent_operations\":  []any{\"request-stop\"},\n170|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n171|\t\t},\n172|\t\t\"credential_capable_execution_realm\": {\n173|\t\t\t\"generation_variable\":  true,\n174|\t\t\t\"dependent_operations\": []any{\"create\", \"restore\"},\n175|\t\t\t\"evidence_requirements\": []any{\n176|\t\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n177|\t\t\t},\n178|\t\t},\n179|\t}\n180|\trow := rows[capability]\n181|\treturn map[string]any{\n182|\t\t\"capability\":            capability,\n183|\t\t\"origin\":                origin,\n184|\t\t\"value\":                 value,\n185|\t\t\"generation_variable\":   row[\"generation_variable\"],\n186|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n187|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n188|\t}\n189|}\n190|\n191|// fixtureUniverse is one coherent admission world: a builtin manifest,\n192|// its probe (static echo, same-value override, differing override, false\n193|// override, probed addition), and the evidence set proving the true claims.\n194|type fixtureUniverse struct {\n195|\trawGeneration    string\n196|\tgenerationDigest string\n197|\tfixtureID        string\n198|\tissuerID         string\n199|\tnow              time.Time\n200|\tkey              *rsa.PrivateKey\n201|\tmanifest         map[string]any\n202|\tprobe            map[string]any\n203|\tevidence         map[string]any\n204|\tevidenceByCap    map[string]map[string]any\n205|}\n206|\n207|// testUniverse builds the builtin ax.tmux world. The manifest identity\n208|// tuple matches New(\"2.1.0\", [\"1.0.0\", \"1.1.0\"]) admission exactly, so the\n209|// same fixtures drive the registry-bound AdmitProbe entry point.\n210|func testUniverse(t *testing.T) *fixtureUniverse {\n211|\tt.Helper()\n212|\n213|\tuniverse := &fixtureUniverse{\n214|\t\trawGeneration: \"generation-alpha\",\n215|\t\tfixtureID:     testSeedDigest(0xF1),\n216|\t\tissuerID:      testSeedDigest(0x1D),\n217|\t\tnow:           time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC),\n218|\t\tkey:           testKey(t),\n219|\t\tevidenceByCap: make(map[string]map[string]any),\n220|\t}\n221|\tdigest, err := terminalbackend.GenerationDigest(universe.rawGeneration)\n222|\tif err != nil {\n223|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n224|\t}\n225|\tuniverse.generationDigest = digest\n226|\n227|\tuniverse.manifest = map[string]any{\n228|\t\t\"schema\":                 terminalbackend.SchemaManifest,\n229|\t\t\"schema_version\":         \"1.0.0\",\n230|\t\t\"manifest_id\":            \"\",\n231|\t\t\"terminal_backend_id\":    terminalbackend.BuiltinTmux,\n232|\t\t\"implementation_version\": \"2.1.0\",\n233|\t\t\"protocol_versions\":      []any{\"1.0.0\", \"1.1.0\"},\n234|\t\t\"platforms\":              []any{\"linux\", \"macos\", \"wsl2\"},\n235|\t\t\"implementation_kind\":    \"builtin_go\",\n236|\t\t\"executable_digest\":      nil,\n237|\t\t\"static_capability_claims\": []any{\n238|\t\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n239|\t\t\tclaimMap(\"headless_creation\", \"static\", true),\n240|\t\t\tclaimMap(\"local_attach\", \"static\", true),\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
