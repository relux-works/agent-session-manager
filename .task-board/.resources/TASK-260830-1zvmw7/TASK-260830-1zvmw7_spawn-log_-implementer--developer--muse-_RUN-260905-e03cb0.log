ility_claims\"].([]any)\n-\t\t\tobject[\"static_capability_claims\"] = []any{claims[2], claims[1], claims[0]}\n-\t\t},\n-\t\t\"bad semver\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"implementation_version\"] = \"2.1\"\n-\t\t},\n-\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"protocol_versions\"] = []any{\"1.0.0\", \"2.0.0\"}\n-\t\t},\n-\t\t\"unsorted protocols\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"protocol_versions\"] = []any{\"1.1.0\", \"1.0.0\"}\n-\t\t},\n-\t\t\"empty protocols\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"protocol_versions\"] = []any{}\n-\t\t},\n-\t\t\"unknown platform\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"platforms\"] = []any{\"amigaos\"}\n-\t\t},\n-\t\t\"unsorted platforms\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"platforms\"] = []any{\"macos\", \"linux\", \"wsl2\"}\n-\t\t},\n-\t\t\"digest on builtin\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"executable_digest\"] = testSeedDigest(0xAA)\n-\t\t},\n-\t\t\"bad digest\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"implementation_kind\"] = \"local_program\"\n-\t\t\tobject[\"executable_digest\"] = \"not-a-digest\"\n-\t\t},\n-\t\t\"reserved backend id\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"terminal_backend_id\"] = \"ax.evil\"\n-\t\t},\n-\t\t\"bad fixture id\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"conformance_fixture_id\"] = \"sha256:zzz\"\n-\t\t},\n-\t\t\"numeric member\": func(t *testing.T, object map[string]any) {\n-\t\t\tobject[\"implementation_version\"] = float64(2)\n-\t\t},\n-\t}\n-\tfor name, mutate := range cases {\n-\t\tt.Run(name, func(t *testing.T) {\n-\t\t\tt.Parallel()\n-\n-\t\t\tuniverse := testUniverse(t)\n-\t\t\tobject := cloneMap(t, universe.manifest)\n-\t\t\tmutate(t, object)\n-\t\t\tfinalizeDocument(t, object, \"manifest_id\")\n-\t\t\tif _, err := t