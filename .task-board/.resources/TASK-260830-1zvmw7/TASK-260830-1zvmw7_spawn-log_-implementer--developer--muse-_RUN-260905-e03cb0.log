{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81f","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":618,"recorded_at":1780531400001231,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"call_id":"call_01a06ee72f8c7b22a29bdf67011d9e88","text":"Read text file `internal/terminalbackend/manifest.go`.\n(829 line(s) above)\n830|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n831|\t\treturn Manifest{}, err\n832|\t}\n833|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n834|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n835|\t}\n836|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n837|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n838|\t}\n839|\tmanifestID, err := stringMember(object, \"manifest_id\")\n840|\tif err != nil {\n841|\t\treturn Manifest{}, err\n842|\t}\n843|\tif err := checkIdentity(object, \"manifest_id\", manifestID); err != nil {\n844|\t\treturn Manifest{}, err\n845|\t}\n846|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n847|\tif err != nil {\n848|\t\treturn Manifest{}, err\n849|\t}\n850|\tif _, err := ParseID(backendID); err != nil {\n851|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n852|\t}\n853|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n854|\tif err != nil {\n855|\t\treturn Manifest{}, err\n856|\t}\n857|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n858|\tif err != nil {\n859|\t\treturn Manifest{}, err\n860|\t}\n861|\tif err := validateProtocolList(protocols); err != nil {\n862|\t\treturn Manifest{}, err\n863|\t}\n864|\tplatforms, err := parsePlatformList(object)\n865|\tif err != nil {\n866|\t\treturn Manifest{}, err\n867|\t}\n868|\tkindName, err := stringMember(object, \"implementation_kind\")\n869|\tif err != nil {\n870|\t\treturn Manifest{}, err\n871|\t}\n872|\tkind, err := parseKind(kindName)\n873|\tif err != nil {\n874|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n875|\t}\n876|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n877|\tif err != nil {\n878|\t\treturn Manifest{}, err\n879|\t}\n880|\tif needsDigest(kind) == (digest == \"\") {\n881|\t\treturn Manifest{}, mismatchf(\"manifest executable digest\")\n882|\t}\n883|\tclaimsRaw, known := object[\"static_capability_claims\"]\n884|\tif !known {\n885|\t\treturn Manifest{}, mismatchf(\"document members\")\n886|\t}\n887|\tclaims, err := parseClaimList(claimsRaw, false)\n888|\tif err != nil {\n889|\t\treturn Manifest{}, err\n890|\t}\n891|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n892|\tif err != nil {\n893|\t\treturn Manifest{}, err\n894|\t}\n895|\tif err := checkExtensions(object); err != nil {\n896|\t\treturn Manifest{}, err\n897|\t}\n898|\treturn Manifest{\n899|\t\tManifestID:             manifestID,\n900|\t\tTerminalBackendID:      backendID,\n901|\t\tImplementationVersion:  implementationVersion,\n902|\t\tProtocolVersions:       protocols,\n903|\t\tPlatforms:              platforms,\n904|\t\tImplementationKind:     kind,\n905|\t\tExecutableDigest:       digest,\n906|\t\tStaticCapabilityClaims: claims,\n907|\t\tConformanceFixtureID:   fixtureID,\n908|\t}, nil\n909|}\n910|\n911|// validateProtocolList enforces sorted unique semver[1..32], each in\n912|// Terminal Backend Protocol major 1, without naming a backend.\n913|func validateProtocolList(versions []string) error {\n914|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n915|\t\treturn mismatchf(\"protocol versions bound\")\n916|\t}\n917|\tfor index, version := range versions {\n918|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n919|\t\t\treturn mismatchf(\"protocol versions major 1\")\n920|\t\t}\n921|\t\tif index > 0 && versions[index-1] >= version {\n922|\t\t\treturn mismatchf(\"protocol versions ordering\")\n923|\t\t}\n924|\t}\n925|\treturn nil\n926|}\n927|\n928|// parsePlatformList validates the sorted unique non-empty platform subset.\n929|func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\n930|\tnames, err := stringArrayMember(object, \"platforms\")\n931|\tif err != nil {\n932|\t\treturn nil, err\n933|\t}\n934|\tif len(names) == 0 || len(names) > 4 {\n935|\t\treturn nil, mismatchf(\"platforms bound\")\n936|\t}\n937|\tplatforms := make([]scalar.Platform, 0, len(names))\n938|\tfor _, name := range names {\n939|\t\tplatform, err := scalar.ParsePlatform(name)\n940|\t\tif err != nil {\n941|\t\t\treturn nil, mismatchf(\"platforms vocabulary\")\n942|\t\t}\n943|\t\tplatforms = append(platforms, platform)\n944|\t}\n945|\tfor index := range platforms {\n946|\t\tif index > 0 && platforms[index-1].String() >= platforms[index].String() {\n947|\t\t\treturn nil, mismatchf(\"platforms ordering\")\n948|\t\t}\n949|\t\tif index > 0 && platforms[index-1] == platforms[index] {\n950|\t\t\treturn nil, mismatchf(\"platforms ordering\")\n951|\t\t}\n952|\t}\n953|\treturn platforms, nil\n954|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c821","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":619,"recorded_at":1780531400001233,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"call_id":"call_01a06ee730dc750391bfba1aef727529","text":"Read text file `internal/terminalbackend/manifest.go`.\n(1254 line(s) above)\n1255|// parseAttestationSignature structurally decodes the rsa-sha256: plus Base64\n1256|// RFC 4648 attestation signature. Decoding success is not validity.\n1257|func parseAttestationSignature(object map[string]any) ([]byte, error) {\n1258|\tencoded, err := stringMember(object, \"attestation_signature\")\n1259|\tif err != nil {\n1260|\t\treturn nil, err\n1261|\t}\n1262|\traw, found := strings.CutPrefix(encoded, signatureSchemePrefix)\n1263|\tif !found || raw == \"\" {\n1264|\t\treturn nil, mismatchf(\"evidence signature scheme\")\n1265|\t}\n1266|\tsignature, err := base64.StdEncoding.DecodeString(raw)\n1267|\tif err != nil || len(signature) == 0 {\n1268|\t\treturn nil, mismatchf(\"evidence signature encoding\")\n1269|\t}\n1270|\treturn signature, nil\n1271|}\n1272|\n1273|// realmMembers carries the credential-realm conditional members.\n1274|type realmMembers struct {\n1275|\tbindingID      string\n1276|\tproviderID     string\n1277|\tproviderBuild  string\n1278|\tsentinelResult string\n1279|\tsmokeResult    string\n1280|}\n1281|\n1282|// parseRealmMembers enforces the credential-realm conditional shape: the\n1283|// binding digest, provider ID/build, sentinel, and smoke members are\n1284|// required exactly for credential_capable_execution_realm and null\n1285|// otherwise. A realm claim proved by realm-less evidence (or realm evidence\n1286|// attached to any other claim) is malformed.\n1287|func parseRealmMembers(object map[string]any, capability string) (realmMembers, error) {\n1288|\tisRealm := capability == credentialRealmCapability\n1289|\tbindingID, err := digestOrNullMember(object, \"terminal_binding_id\")\n1290|\tif err != nil {\n1291|\t\treturn realmMembers{}, err\n1292|\t}\n1293|\tproviderID, providerBuild, err := parseRealmProvider(object)\n1294|\tif err != nil {\n1295|\t\treturn realmMembers{}, err\n1296|\t}\n1297|\tsentinelResult, err := parseRealmLiteral(object, \"sentinel_result\")\n1298|\tif err != nil {\n1299|\t\treturn realmMembers{}, err\n1300|\t}\n1301|\tsmokeResult, err := parseRealmLiteral(object, \"provider_auth_smoke_result\")\n1302|\tif err != nil {\n1303|\t\treturn realmMembers{}, err\n1304|\t}\n1305|\tif isRealm {\n1306|\t\tif bindingID == \"\" || providerID == \"\" || providerBuild == \"\" ||\n1307|\t\t\tsentinelResult == \"\" || smokeResult == \"\" {\n1308|\t\t\treturn realmMembers{}, mismatchf(\"evidence realm binding\")\n1309|\t\t}\n1310|\t} else if bindingID != \"\" || providerID != \"\" || providerBuild != \"\" ||\n1311|\t\tsentinelResult != \"\" || smokeResult != \"\" {\n1312|\t\treturn realmMembers{}, mismatchf(\"evidence realm binding\")\n1313|\t}\n1314|\treturn realmMembers{\n1315|\t\tbindingID:      bindingID,\n1316|\t\tproviderID:     providerID,\n1317|\t\tproviderBuild:  providerBuild,\n1318|\t\tsentinelResult: sentinelResult,\n1319|\t\tsmokeResult:    smokeResult,\n1320|\t}, nil\n1321|}\n1322|\n1323|// GenerationDigest binds a backend's host-local raw generation to its\n1324|// advertisable digest: SHA-256 over the UTF-8 domain separator followed by\n1325|// the raw generation bytes (§4.B). The raw generation is a string[1..256]\n1326|// in bytes over valid UTF-8; anything else (including empty, which would\n1327|// make every backend share one digest) is CodeStaleGeneration, never a\n1328|// derived value.\n1329|func GenerationDigest(rawGeneration string) (string, error) {\n1330|\tif !utf8.ValidString(rawGeneration) || len(rawGeneration) < 1 || len(rawGeneration) > maxGenerationBytes {\n1331|\t\treturn \"\", &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n1332|\t}\n1333|\tmaterial := append([]byte(generationDigestDomain), rawGeneration...)\n1334|\tsum := sha256.Sum256(material)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
