{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caa5","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":941,"recorded_at":1780531400001877,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"9d351ffe-cc20-4729-a721-e6558b1967ed"},"task_id":"9d351ffe-cc20-4729-a721-e6558b1967ed","event":{"kind":"output","task_id":"9d351ffe-cc20-4729-a721-e6558b1967ed","chunk":"edited\nchanged lines: lines 1476-1491\n--- original\n+++ updated\n@@\n-// CheckOperation gates one operation against the admitted set: the operation\n-// must be in the closed vocabulary and at least one admitted true\n-// capability must confer it, or the operation is refused with\n-// CodeCapabilityUnproven. Conditional §4.C dependencies (interactivity,\n-// credential need, attach overlap, provider observation) are evaluated by\n-// the lifecycle owner at the operation call site; this gate proves only the\n-// capability-confers-operation half, which is the bound this file owns.\n-func CheckOperation(operation string, admitted Admitted) error {\n-\tif !operationVocabulary[operation] {\n-\t\treturn mismatchf(\"operation vocabulary\")\n-\t}\n-\tif !admitted.HasOperation(operation) {\n-\t\treturn &Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"}\n-\t}\n-\treturn nil\n-}\n+// CheckOperation gates one operation against the admitted set. manifest and\n+// probe carry no capability dependency (§4.D): they are admitted for any\n+// admitted set, including the empty one. Every other operation must be in\n+// the closed vocabulary and conferred by at least one admitted true\n+// capability, or it is refused with CodeCapabilityUnproven. Conditional §4.C\n+// dependencies (interactivity, credential need, attach overlap, provider\n+// observation) are evaluated by the lifecycle owner at the operation call\n+// site; this gate proves only the capability-confers-operation half, which\n+// is the bound this file owns.\n+func CheckOperation(operation string, admitted Admitted) error {\n+\tif !operationVocabulary[operation] {\n+\t\treturn mismatchf(\"operation vocabulary\")\n+\t}\n+\tif operation == \"manifest\" || operation == \"probe\" {\n+\t\treturn nil\n+\t}\n+\tif !admitted.HasOperation(operation) {\n+\t\treturn &Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"}\n+\t}\n+\treturn nil\n+}\n"}}}
