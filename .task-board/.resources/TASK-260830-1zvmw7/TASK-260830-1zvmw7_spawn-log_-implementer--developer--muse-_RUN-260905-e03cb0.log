{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c539","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":247,"recorded_at":1780531400000489,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"f261bbaf-938f-4c7c-b846-b7ff8c9b29eb"},"task_id":"f261bbaf-938f-4c7c-b846-b7ff8c9b29eb","event":{"kind":"output","task_id":"f261bbaf-938f-4c7c-b846-b7ff8c9b29eb","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n1|// Manifest, Probe, and Capability Evidence admission for the\n2|// TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n5|// (Manifest/Probe closed schemas, generation digest, reconciliation,\n6|// identity rule), §4.D (closed capability registry, claim rows, evidence\n7|// schema, fact mapping), §6.5 (trust established before any probe;\n8|// configuration admission), and §7.A (generation-bound descriptor binding).\n9|// Lifecycle operations other than admission (create, attach, status, and\n10|// friends) belong to the sibling lifecycle task; this file gates only which\n11|// capabilities an operation may rely on, never the operations themselves.\n12|//\n13|// Fail-closed conventions shared with the registry half of this package:\n14|// every refusal is an *Error with a wire code from the pinned catalog error\n15|// vocabulary and a static Detail clause that never echoes paths, digests,\n16|// generations, or other local data. A partial, malformed, stale, or failed\n17|// Manifest, Probe, or evidence read is an error, never absence or\n18|// availability, so callers must not fall back to a default or to PATH\n19|// discovery.\n20|package terminalbackend\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t\"encoding/base64\"\n26|\t\"encoding/hex\"\n27|\t\"encoding/json\"\n28|\t\"fmt\"\n29|\t\"strings\"\n30|\t\"time\"\n31|\t\"unicode/utf8\"\n32|\n33|\t\"github.com/gowebpki/jcs\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|)\n37|\n38|// Wire error codes this file may report. They extend the registry-half codes\n39|// with the exact Section 15.3 codes for manifest/probe disagreement,\n40|// unevidenced capability use, and integrity failure; every one is a member of\n41|// the pinned catalog error vocabulary.\n42|const (\n43|\t// CodeMismatch reports any failed Manifest/Probe equality, membership,\n44|\t// keyed claim relation, evidence binding, or evidence coverage rule\n45|\t// (§4.B). Malformed Manifest, Probe, or evidence documents also report\n46|\t// this code: a malformed read is an error, never absence.\n47|\tCodeMismatch = \"terminal_backend_manifest_probe_mismatch\"\n48|\t// CodeCapabilityUnproven reports an operation gate evaluated against an\n49|\t// admitted capability set that confers no true capability for the\n50|\t// requested operation (§4.C capability dependencies).\n51|\tCodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n52|\t// CodeIntegrityFailure reports a missing, malformed, unknown-key, or\n53|\t// invalid capability-evidence signature, or a signature verification\n54|\t// subsystem that is unavailable (§4.D). It fails before capability\n55|\t// admission.\n56|\tCodeIntegrityFailure = \"terminal_backend_integrity_failure\"\n57|)\n58|\n59|// IsMismatch reports CodeMismatch refusals.\n60|func IsMismatch(err error) bool { return errorCode(err, CodeMismatch) }\n61|\n62|// IsCapabilityUnproven reports CodeCapabilityUnproven refusals.\n63|func IsCapabilityUnproven(err error) bool { return errorCode(err, CodeCapabilityUnproven) }\n64|\n65|// IsIntegrityFailure reports CodeIntegrityFailure refusals.\n66|func IsIntegrityFailure(err error) bool { return errorCode(err, CodeIntegrityFailure) }\n67|\n68|// Closed schema literals (§4.B, §4.D). No other schema or version is\n69|// admitted by this file.\n70|const (\n71|\t// SchemaManifest is the Terminal Backend Manifest 1.0.0 schema URN.\n72|\tSchemaManifest = \"urn:ax:schema:terminal-backend-manifest\"\n73|\t// SchemaProbe is the Terminal Backend Probe 1.0.0 schema URN.\n74|\tSchemaProbe = \"urn:ax:schema:terminal-backend-probe\"\n75|\t// SchemaCapabilityEvidence is the Capability Evidence 1.0.0 schema URN.\n76|\tSchemaCapabilityEvidence = \"urn:ax:schema:terminal-capability-evidence\"\n77|\t// SchemaVersion100 is the only contract version this file implements.\n78|\tSchemaVersion100 = \"1.0.0\"\n79|)\n80|\n81|// Closed small vocabularies (§4.B, §4.D).\n82|const (\n83|\t// OriginStatic marks a static manifest echo claim.\n84|\tOriginStatic = \"static\"\n85|\t// OriginProbed marks a live probe observation claim.\n86|\tOriginProbed = \"probed\"\n87|\n88|\t// AvailabilityAvailable marks a ready backend.\n89|\tAvailabilityAvailable = \"available\"\n90|\t// AvailabilityConditional marks a backend that needs operator action.\n91|\tAvailabilityConditional = \"conditional\"\n92|\t// AvailabilityUnavailable marks a backend that cannot serve.\n93|\tAvailabilityUnavailable = \"unavailable\"\n94|\t// AvailabilityUnknown marks a backend whose readiness is not established.\n95|\tAvailabilityUnknown = \"unknown\"\n96|\n97|\t// IssuerRelease marks release-signed capability evidence.\n98|\tIssuerRelease = \"ax_release\"\n99|\t// IssuerLocalProbe marks host-incarnation-signed capability evidence.\n100|\tIssuerLocalProbe = \"ax_local_probe\"\n101|)\n102|\n103|// signatureSchemePrefix is the literal attestation_signature scheme (§4.D).\n104|const signatureSchemePrefix = \"rsa-sha256:\"\n105|\n106|// generationDigestDomain is the UTF-8 domain separator prepended to the\n107|// backend's host-local raw generation bytes before SHA-256 (§4.B). It\n108|// neither reveals nor reconstructs that generation.\n109|const generationDigestDomain = \"ax-terminal-backend-generation-v1\\x00\"\n110|\n111|// evidenceSignatureDomain is the ASCII domain separator prepended to the\n112|// canonical evidence bytes before signing (§4.D).\n113|const evidenceSignatureDomain = \"ax-terminal-capability-evidence-v1\"\n114|\n115|// Closed TerminalBackendCapability registry (§4.D). The map key is the\n116|// capability name; the row carries the exact registry members a Manifest or\n117|// Probe claim must repeat verbatim.\n118|type capabilityRow struct {\n119|\tgenerationVariable   bool\n120|\tdependentOperations  []string\n121|\tevidenceRequirements []string\n122|}\n123|\n124|// capabilityRegistry is the exact 16-value Section 4.D table. Dependent\n125|// operations and evidence requirements are stored sorted as the wire\n126|// requires, so row comparison is element-wise.\n127|var capabilityRegistry = map[string]capabilityRow{\n128|\t\"durable_disconnect\": {\n129|\t\tgenerationVariable:   false,\n130|\t\tdependentOperations:  []string{\"create\", \"status\"},\n131|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n132|\t},\n133|\t\"local_attach\": {\n134|\t\tgenerationVariable:   true,\n135|\t\tdependentOperations:  []string{\"attach\"},\n136|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n137|\t},\n138|\t\"remote_attach\": {\n139|\t\tgenerationVariable:   true,\n140|\t\tdependentOperations:  []string{\"attach\"},\n141|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n142|\t},\n143|\t\"web_attach\": {\n144|\t\tgenerationVariable:   true,\n145|\t\tdependentOperations:  []string{\"attach\"},\n146|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n147|\t},\n148|\t\"multi_attach\": {\n149|\t\tgenerationVariable:   true,\n150|\t\tdependentOperations:  []string{\"attach\"},\n151|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n152|\t},\n153|\t\"headless_creation\": {\n154|\t\tgenerationVariable:   true,\n155|\t\tdependentOperations:  []string{\"create\"},\n156|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n157|\t},\n158|\t\"reboot_restoration\": {\n159|\t\tgenerationVariable:   true,\n160|\t\tdependentOperations:  []string{\"restore\"},\n161|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n162|\t},\n163|\t\"input_quiescence\": {\n164|\t\tgenerationVariable:   true,\n165|\t\tdependentOperations:  []string{\"quiesce-input\"},\n166|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n167|\t},\n168|\t\"safe_boundary_observation\": {\n169|\t\tgenerationVariable:   true,\n170|\t\tdependentOperations:  []string{\"wait-safe-boundary\"},\n171|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n172|\t},\n173|\t\"provider_process_observation\": {\n174|\t\tgenerationVariable:   true,\n175|\t\tdependentOperations:  []string{\"status\", \"terminate-stale\", \"wait-safe-boundary\"},\n176|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n177|\t},\n178|\t\"graceful_stop\": {\n179|\t\tgenerationVariable:   true,\n180|\t\tdependentOperations:  []string{\"request-stop\"},\n181|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n182|\t},\n183|\t\"stale_process_termination\": {\n184|\t\tgenerationVariable:   true,\n185|\t\tdependentOperations:  []string{\"terminate-stale\"},\n186|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n187|\t},\n188|\t\"terminal_state_retention\": {\n189|\t\tgenerationVariable:   true,\n190|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n191|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n192|\t},\n193|\t\"scrollback_retention\": {\n194|\t\tgenerationVariable:   true,\n195|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n196|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n197|\t},\n198|\t\"credential_capable_execution_realm\": {\n199|\t\tgenerationVariable:  true,\n200|\t\tdependentOperations: []string{\"create\", \"restore\"},\n(more lines below)"}}}
