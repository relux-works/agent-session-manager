{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d1","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":451,"recorded_at":1780531400000897,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"a744f127-7420-478e-ac4b-138c97f0619e"},"task_id":"a744f127-7420-478e-ac4b-138c97f0619e","event":{"kind":"output","task_id":"a744f127-7420-478e-ac4b-138c97f0619e","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(805 line(s) above)\n806|// manifestMembers is the exact closed Manifest member set.\n807|var manifestMembers = []string{\n808|\t\"schema\", \"schema_version\", \"manifest_id\", \"terminal_backend_id\",\n809|\t\"implementation_version\", \"protocol_versions\", \"platforms\",\n810|\t\"implementation_kind\", \"executable_digest\", \"static_capability_claims\",\n811|\t\"conformance_fixture_id\", \"extensions\",\n812|}\n813|\n814|// ParseManifest validates one Terminal Backend Manifest 1.0.0 document and\n815|// returns the typed observation. Any deviation from the closed shape,\n816|// vocabulary, bound, ordering, registry-row, or identity rule is\n817|// CodeMismatch: a malformed read is an error, never absence.\n818|func ParseManifest(raw []byte) (Manifest, error) {\n819|\tobject, err := decodeStrictObject(raw)\n820|\tif err != nil {\n821|\t\treturn Manifest{}, err\n822|\t}\n823|\treturn parseManifestObject(object)\n824|}\n825|\n826|// parseManifestObject validates a decoded Manifest member map. It is split\n827|// from ParseManifest so admission paths that already hold a decoded object\n828|// share the exact gate.\n829|func parseManifestObject(object map[string]any) (Manifest, error) {\n830|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n831|\t\treturn Manifest{}, err\n832|\t}\n833|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n834|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n835|\t}\n(more lines below)"}}}
