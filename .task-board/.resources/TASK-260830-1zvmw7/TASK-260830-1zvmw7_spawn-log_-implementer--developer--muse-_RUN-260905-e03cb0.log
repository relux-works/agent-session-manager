ce{}, mismatchf(\"document timestamp\")\n1198|\t}\n1199|\tif !expires.After(observed) {\n1200|\t\treturn Evidence{}, mismatchf(\"evidence expiry\")\n1201|\t}\n1202|\tissuer, err := stringMember(object, \"issuer\")\n1203|\tif err != nil {\n1204|\t\treturn Evidence{}, err\n1205|\t}\n1206|\tif issuer != IssuerRelease && issuer != IssuerLocalProbe {\n1207|\t\treturn Evidence{}, mismatchf(\"evidence issuer\")\n1208|\t}\n1209|\tissuerID, err := digestMember(object, \"issuer_id\")\n1210|\tif err != nil {\n1211|\t\treturn Evidence{}, err\n1212|\t}\n1213|\tsignature, err := parseAttestationSignature(object)\n1214|\tif err != nil {\n1215|\t\treturn Evidence{}, err\n1216|\t}\n1217|\tfacts, err := stringArrayMember(object, \"facts\")\n1218|\tif err != nil {\n1219|\t\treturn Evidence{}, err\n1220|\t}\n1221|\tif err := checkClosedList(facts, evidenceFactVocabulary, maxFacts, true); err != nil {\n1222|\t\treturn Evidence{}, err\n1223|\t}\n1224|\trealm, err := parseRealmMembers(object, capability)\n1225|\tif err != nil {\n1226|\t\treturn Evidence{}, err\n1227|\t}\n1228|\tif err := checkExtensions(object); err != nil {\n1229|\t\treturn Evidence{}, err\n1230|\t}\n1231|\treturn Evidence{\n1232|\t\tEvidenceID:              evidenceID,\n1233|\t\tTerminalBackendID:       backendID,\n1234|\t\tImplementationVersion:   implementationVersion,\n1235|\t\tProtocolVersion:         protocolVersion,\n1236|\t\tBackendGenerationDigest: generationDigest,\n1237|\t\tCapability:              capability,\n1238|\t\tPlatform:                platform,\n1239|\t\tOSVersion:               osVersion,\n1240|\t\tConformanceFixtureID:    fixtureID,\n1241|\t\tObservedAt:              observedAt,\n1242|\t\tExpiresAt:               expiresAt,\n1243|\t\tIssuer:                  issuer,\n1244|\t\tIssuerID:                issuerID,\n1245|\t\tAttestationSignature:    signature,\n1246|\t\tFacts:                   facts,\n1247|\t\tTerminalBindingID:       realm.bindingID,\n1248|\t\tProviderID:              realm.providerID,\n1249|\t\tProviderBuild:           realm.providerBuild,\n1250|\t\tSentinelResult:          realm.sentinelResult,\n1251|\t\tProviderAuthSmokeResult: realm.smokeResult,\n1252|\t}, nil\n1253|}\n1254|\n1255|// parseAttestationSignature structurally decodes the rsa-sha256: plus Base64\n1256|// RFC 4648 attestation signature. Decoding success is not validity.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6db","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":456,"recorded_at":1780531400000907,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"call_id":"call_01a06ee67fe67652bf20ae11327d4d69","text":"Read text file `internal/terminalbackend/manifest.go`.\n(805 line(s) above)\n806|// manifestMembers is the exact closed Manifest member set.\n807|var manifestMembers = []string{\n808|\t\"schema\", \"schema_version\", \"manifest_id\", \"terminal_backend_id\",\n809|\t\"implementation_version\", \"protocol_versions\", \"platforms\",\n810|\t\"implementation_kind\", \"executable_digest\", \"static_capability_claims\",\n811|\t\"conformance_fixture_id\", \"extensions\",\n812|}\n813|\n814|// ParseManifest validates one Terminal Backend Manifest 1.0.0 document and\n815|// returns the typed observation. Any deviation from the closed shape,\n816|// vocabulary, bound, ordering, registry-row, or identity rule is\n817|// CodeMismatch: a malformed read is an error, never absence.\n818|func ParseManifest(raw []byte) (Manifest, error) {\n819|\tobject, err := decodeStrictObject(raw)\n820|\tif err != nil {\n821|\t\treturn Manifest{}, err\n822|\t}\n823|\treturn parseManifestObject(object)\n824|}\n825|\n826|// parseManifestObject validates a decoded Manifest member map. It is split\n827|// from ParseManifest so admission paths that already hold a decoded object\n828|// share the exact gate.\n829|func parseManifestObject(object map[string]any) (Manifest, error) {\n830|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n831|\t\treturn Manifest{}, err\n832|\t}\n833|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n834|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n835|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
