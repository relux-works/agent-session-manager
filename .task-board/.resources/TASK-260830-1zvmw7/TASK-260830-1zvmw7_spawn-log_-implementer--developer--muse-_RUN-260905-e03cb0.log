06-01T00:00:00.000Z\",\n310|\t\t\"issuer\":                     terminalbackend.IssuerLocalProbe,\n311|\t\t\"issuer_id\":                  universe.issuerID,\n312|\t\t\"attestation_signature\":      \"\",\n313|\t\t\"facts\":                      facts,\n314|\t\t\"terminal_binding_id\":        nil,\n315|\t\t\"provider_id\":                nil,\n316|\t\t\"provider_build\":             nil,\n317|\t\t\"sentinel_result\":            nil,\n318|\t\t\"provider_auth_smoke_result\": nil,\n319|\t\t\"extensions\":                 map[string]any{},\n320|\t}\n321|}\n322|\n323|// parsedUniverse parses the universe documents through the production entry\n324|// points, failing the test on any parse error.\n325|func (universe *fixtureUniverse) parsed(t *testing.T) (terminalbackend.Manifest, terminalbackend.Probe, []terminalbackend.Evidence) {\n326|\tt.Helper()\n327|\n328|\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n329|\tif err != nil {\n330|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n331|\t}\n332|\tprobe, err := terminalbackend.ParseProbe(mustMarshal(t, universe.probe))\n333|\tif err != nil {\n334|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n335|\t}\n336|\tevidence := make([]terminalbackend.Evidence, 0, len(universe.evidenceByCap))\n337|\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n338|\t\tobject, err := terminalbackend.ParseEvidence(mustMarshal(t, universe.evidenceByCap[capability]))\n339|\t\tif err != nil {\n340|\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", capability, err)\n341|\t\t}\n342|\t\tevidence = append(evidence, object)\n343|\t}\n344|\treturn manifest, probe, evidence\n345|}\n346|\n347|// cloneMap deep-copies a fixture map through JSON so mutations never leak\n348|// between cases.\n349|func cloneMap(t *testing.T, object map[string]any) map[string]any {\n350|\tt.Helper()\n351|\n352|\traw, err := json.Marshal(object)\n353|\tif err != nil {\n354|\t\tt.Fatalf(\"marshal clone: %v\", err)\n355|\t}\n356|\tvar cloned map[string]any\n357|\tif err := json.Unmarshal(raw, &cloned); err != nil {\n358|\t\tt.Fatalf(\"unmarshal clone: %v\", err)\n359|\t}\n360|\treturn cloned\n361|}\n362|\n363|// TestParseManifestAdmitsClosedFixture proves the positive gate is\n364|// reachable and pins the typed projection of every member.\n365|func TestParseManifestAdmitsClosedFixture(t *testing.T) {\n366|\tt.Parallel()\n367|\n368|\tuniverse := testUniverse(t)\n369|\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n370|\tif err != nil {\n371|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n372|\t}\n373|\tif manifest.TerminalBackendID != terminalbackend.BuiltinTmux {\n374|\t\tt.Errorf(\"TerminalBackendID = %q\", manifest.TerminalBackendID)\n375|\t}\n376|\tif manifest.ImplementationVersion != \"2.1.0\" {\n377|\t\tt.Errorf(\"ImplementationVersion = %q\", manifest.ImplementationVersion)\n378|\t}\n379|\tif len(manifest.ProtocolVersions) != 2 || manifest.ProtocolVersions[1] != \"1.1.0\" {\n380|\t\tt.Errorf(\"ProtocolVersions = %v\", manifest.ProtocolVersions)\n381|\t}\n382|\tif len(manifest.Platforms) != 3 || manifest.Platforms[0].String() != \"linux\" {\n383|\t\tt.Errorf(\"Platforms = %v\", manifest.Platforms)\n384|\t}\n385|\tif manifest.ImplementationKind != terminalbackend.KindBuiltinGo {\n386|\t\tt.Errorf(\"ImplementationKind = %q\", manifest.ImplementationKind)\n387|\t}\n388|\tif manifest.ExecutableDigest != \"\" {\n389|\t\tt.Errorf(\"ExecutableDigest = %q, want null\", manifest.ExecutableDigest)\n390|\t}\n391|\tif len(manifest.StaticCapabilityClaims) != 3 {\n392|\t\tt.Fatalf(\"StaticCapabilityClaims = %d, want 3\", len(manifest.StaticCapabilityClaims))\n393|\t}\n394|\tif manifest.StaticCapabilityClaims[0].Capability != \"durable_disconnect\" {\n395|\t\tt.Errorf(\"first claim = %q\", manifest.StaticCapabilityClaims[0].Capability)\n396|\t}\n397|\tif manifest.ConformanceFixtureID != universe.fixtureID {\n398|\t\tt.Errorf(\"ConformanceFixtureID = %q\", manifest.ConformanceFixtureID)\n399|\t}\n400|\tif manifest.ManifestID != universe.manifest[\"manifest_id\"] {\n401|\t\tt.Errorf(\"ManifestID = %q, want recomputed identity\", manifest.ManifestID)\n402|\t}\n403|}\n404|\n405|// TestGenerationDigestGolden pins the domain-separated recipe: SHA-256 over\n406|// UTF-8 \"ax-terminal-backend-generation-v1\" + NUL + raw generation bytes.\n407|// The expected value was computed with an independent SHA-256 oracle, so a\n408|// separator change fails here rather than hiding behind agreement.\n409|func TestGenerationDigestGolden(t *testing.T) {\n410|\tt.Parallel()\n411|\n412|\tdigest, err := terminalbackend.GenerationDigest(\"generation-alpha\")\n413|\tif err != nil {\n414|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n415|\t}\n416|\tconst want = \"sha256:ad089bdcf1a41853068645fec63a0ec8e40b95c3e3a103bc326a70e8c479eab7\"\n417|\tif digest != want {\n418|\t\tt.Errorf(\"GenerationDigest() = %q, want %q\", digest, want)\n419|\t}\n420|}\n421|\n422|// TestGenerationDigestBounds proves the raw generation domain fails closed:\n423|// empty (which would make every backend share one digest), over-long, and\n424|// invalid UTF-8 derive nothing.\n425|func TestGenerationDigestBounds(t *testing.T) {\n426|\tt.Parallel()\n427|\n428|\tfor _, raw := range []string{\"\", strings.Repeat(\"g\", 257), \"ok\\xffbad\", strings.Repeat(\"g\", 0)} {\n429|\t\tif _, err := terminalbackend.GenerationDigest(raw); !terminalbackend.IsStaleGeneration(err) {\n430|\t\t\tt.Errorf(\"GenerationDigest(%q) error = %v, want terminal_backend_stale_generation\", raw, err)\n431|\t\t}\n432|\t}\n433|\tif _, err := terminalbackend.GenerationDigest(strings.Repeat(\"g\", 256)); err != nil {\n434|\t\tt.Errorf(\"GenerationDigest(256 bytes) error = %v, want admission\", err)\n435|\t}\n436|}\n437|\n438|// TestReconcileAdmitsCoherentTuple is the positive admission: static echo,\n439|// same-value override, differing override, false claim, and probed addition\n440|// reconcile to exactly the true evidenced claims.\n441|func TestReconcileAdmitsCoherentTuple(t *testing.T) {\n442|\tt.Parallel()\n443|\n444|\tuniverse := testUniverse(t)\n445|\tmanifest, probe, evidence := universe.parsed(t)\n446|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key))\n447|\tif err != nil {\n448|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n449|\t}\n450|\twant := []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"}\n451|\tif fmt.Sprint(admitted.Capabilities) != fmt.Sprint(want) {\n452|\t\tt.Errorf(\"Capabilities = %v, want %v\", admitted.Capabilities, want)\n453|\t}\n454|\tif len(admitted.EvidenceIDs) != 3 {\n455|\t\tt.Errorf(\"EvidenceIDs = %v, want 3 proved IDs\", admitted.EvidenceIDs)\n456|\t}\n457|\tif !admitted.Has(\"headless_creation\") || admitted.Has(\"local_attach\") {\n458|\t\tt.Errorf(\"Has() over %v misreports overrides\", admitted.Capabilities)\n459|\t}\n460|\tif !admitted.HasOperation(\"create\") || admitted.HasOperation(\"attach\") {\n461|\t\tt.Errorf(\"HasOperation() over %v misreports dependencies\", admitted.Capabilities)\n462|\t}\n463|\tif err := terminalbackend.CheckOperation(\"create\", admitted); err != nil {\n464|\t\tt.Errorf(\"CheckOperation(create) error = %v, want admission\", err)\n465|\t}\n466|\tif err := terminalbackend.CheckOperation(\"attach\", admitted); !terminalbackend.IsCapabilityUnproven(err) {\n467|\t\tt.Errorf(\"CheckOperation(attach) error = %v, want terminal_backend_capability_unproven\", err)\n468|\t}\n469|}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
