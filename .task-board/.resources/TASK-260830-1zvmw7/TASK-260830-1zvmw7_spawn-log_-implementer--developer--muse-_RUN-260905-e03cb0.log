{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77b","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":536,"recorded_at":1780531400001067,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"11dc416c-2067-44bd-a69b-ed4a2644a127"},"task_id":"11dc416c-2067-44bd-a69b-ed4a2644a127","event":{"kind":"output","task_id":"11dc416c-2067-44bd-a69b-ed4a2644a127","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n(469 line(s) above)\n470|\n471|// TestManifestDocumentRefusals narrows the closed-schema gate: each case\n472|// widens exactly one member class and must fail with mismatch.\n473|func TestManifestDocumentRefusals(t *testing.T) {\n474|\tt.Parallel()\n475|\n476|\tcases := map[string]func(t *testing.T, object map[string]any){\n477|\t\t\"unknown member\": func(t *testing.T, object map[string]any) {\n478|\t\t\tobject[\"sponsor\"] = \"evil\"\n479|\t\t},\n480|\t\t\"missing member\": func(t *testing.T, object map[string]any) {\n481|\t\t\tdelete(object, \"platforms\")\n482|\t\t},\n483|\t\t\"non-empty extensions\": func(t *testing.T, object map[string]any) {\n484|\t\t\tobject[\"extensions\"] = map[string]any{\"v2\": true}\n485|\t\t},\n486|\t\t\"absent extensions\": func(t *testing.T, object map[string]any) {\n487|\t\t\tdelete(object, \"extensions\")\n488|\t\t},\n489|\t\t\"wrong schema\": func(t *testing.T, object map[string]any) {\n490|\t\t\tobject[\"schema\"] = \"urn:ax:schema:terminal-backend-probe\"\n491|\t\t},\n492|\t\t\"wrong version\": func(t *testing.T, object map[string]any) {\n493|\t\t\tobject[\"schema_version\"] = \"2.0.0\"\n494|\t\t},\n495|\t\t\"unknown capability\": func(t *testing.T, object map[string]any) {\n496|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n497|\t\t\tclaims[0].(map[string]any)[\"capability\"] = \"teleportation\"\n498|\t\t},\n499|\t\t\"probed origin in manifest\": func(t *testing.T, object map[string]any) {\n500|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n501|\t\t\tclaims[0].(map[string]any)[\"origin\"] = \"probed\"\n502|\t\t},\n503|\t\t\"flipped generation variable\": func(t *testing.T, object map[string]any) {\n504|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n505|\t\t\tclaims[0].(map[string]any)[\"generation_variable\"] = true\n506|\t\t},\n507|\t\t\"redefined operations\": func(t *testing.T, object map[string]any) {\n508|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n509|\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"create\"}\n510|\t\t},\n511|\t\t\"unknown operation in claim\": func(t *testing.T, object map[string]any) {\n512|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n513|\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"create\", \"launch\"}\n514|\t\t},\n515|\t\t\"empty operations\": func(t *testing.T, object map[string]any) {\n516|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n517|\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{}\n518|\t\t},\n519|\t\t\"unsorted operations\": func(t *testing.T, object map[string]any) {\n520|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n521|\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"status\", \"create\"}\n522|\t\t},\n523|\t\t\"unknown requirement\": func(t *testing.T, object map[string]any) {\n524|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n525|\t\t\tclaims[0].(map[string]any)[\"evidence_requirements\"] = []any{\"conformance_fixture\", \"vibes\"}\n526|\t\t},\n527|\t\t\"duplicate claims\": func(t *testing.T, object map[string]any) {\n528|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n529|\t\t\tobject[\"static_capability_claims\"] = append(claims, claims[0])\n530|\t\t},\n531|\t\t\"unsorted claims\": func(t *testing.T, object map[string]any) {\n532|\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n533|\t\t\tobject[\"static_capability_claims\"] = []any{claims[2], claims[1], claims[0]}\n534|\t\t},\n535|\t\t\"bad semver\": func(t *testing.T, object map[string]any) {\n536|\t\t\tobject[\"implementation_version\"] = \"2.1\"\n537|\t\t},\n538|\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n539|\t\t\tobject[\"protocol_versions\"] = []any{\"1.0.0\", \"2.0.0\"}\n540|\t\t},\n541|\t\t\"unsorted protocols\": func(t *testing.T, object map[string]any) {\n542|\t\t\tobject[\"protocol_versions\"] = []any{\"1.1.0\", \"1.0.0\"}\n543|\t\t},\n544|\t\t\"empty protocols\": func(t *testing.T, object map[string]any) {\n545|\t\t\tobject[\"protocol_versions\"] = []any{}\n546|\t\t},\n547|\t\t\"unknown platform\": func(t *testing.T, object map[string]any) {\n548|\t\t\tobject[\"platforms\"] = []any{\"amigaos\"}\n549|\t\t},\n550|\t\t\"unsorted platforms\": func(t *testing.T, object map[string]any) {\n551|\t\t\tobject[\"platforms\"] = []any{\"macos\", \"linux\", \"wsl2\"}\n552|\t\t},\n553|\t\t\"digest on builtin\": func(t *testing.T, object map[string]any) {\n554|\t\t\tobject[\"executable_digest\"] = testSeedDigest(0xAA)\n555|\t\t},\n556|\t\t\"bad digest\": func(t *testing.T, object map[string]any) {\n557|\t\t\tobject[\"implementation_kind\"] = \"local_program\"\n558|\t\t\tobject[\"executable_digest\"] = \"not-a-digest\"\n559|\t\t},\n560|\t\t\"reserved backend id\": func(t *testing.T, object map[string]any) {\n561|\t\t\tobject[\"terminal_backend_id\"] = \"ax.evil\"\n562|\t\t},\n563|\t\t\"bad fixture id\": func(t *testing.T, object map[string]any) {\n564|\t\t\tobject[\"conformance_fixture_id\"] = \"sha256:zzz\"\n565|\t\t},\n566|\t\t\"numeric member\": func(t *testing.T, object map[string]any) {\n567|\t\t\tobject[\"implementation_version\"] = float64(2)\n568|\t\t},\n569|\t}\n570|\tfor name, mutate := range cases {\n571|\t\tt.Run(name, func(t *testing.T) {\n572|\t\t\tt.Parallel()\n573|\n574|\t\t\tuniverse := testUniverse(t)\n575|\t\t\tobject := cloneMap(t, universe.manifest)\n576|\t\t\tmutate(t, object)\n577|\t\t\tfinalizeDocument(t, object, \"manifest_id\")\n578|\t\t\tif _, err := terminalbackend.ParseManifest(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n579|\t\t\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n580|\t\t\t}\n581|\t\t})\n582|\t}\n583|}\n584|\n585|// TestManifestEncodingRefusals proves malformed reads fail closed: syntax,\n586|// duplicate, encoding, depth, shape, and identity failures are mismatch,\n587|// never absence.\n588|func TestManifestEncodingRefusals(t *testing.T) {\n589|\tt.Parallel()\n590|\n591|\tuniverse := testUniverse(t)\n592|\tvalid := mustMarshal(t, universe.manifest)\n593|\tdeep := strings.Repeat(\"[\", 40) + strings.Repeat(\"]\", 40)\n594|\n595|\tcases := map[string][]byte{\n596|\t\t\"empty\":        {},\n597|\t\t\"truncated\":    valid[:len(valid)/2],\n598|\t\t\"not json\":     []byte(\"manifest\"),\n599|\t\t\"top array\":    []byte(\"[]\"),\n600|\t\t\"top string\":   []byte(`\"manifest\"`),\n601|\t\t\"trailing\":     append(append([]byte{}, valid...), []byte(\" {}\")...),\n602|\t\t\"duplicate\":    []byte(`{\"schema\":\"urn:ax:schema:terminal-backend-manifest\",\"schema\":\"urn:ax:schema:terminal-backend-manifest\"}`),\n603|\t\t\"invalid utf8\": append(append([]byte{}, valid...), 0xff),\n604|\t\t\"deep nesting\": []byte(`{\"schema\":\"x\",\"nest\":` + deep + `}`),\n605|\t\t\"null\":         []byte(\"null\"),\n606|\t}\n607|\tfor name, raw := range cases {\n608|\t\tt.Run(name, func(t *testing.T) {\n609|\t\t\tt.Parallel()\n610|\n611|\t\t\tif _, err := terminalbackend.ParseManifest(raw); !terminalbackend.IsMismatch(err) {\n612|\t\t\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n613|\t\t\t}\n614|\t\t})\n615|\t}\n616|}\n617|\n618|// TestManifestIdentityMismatch proves the reader recomputes the ID: a valid\n619|// shape with a foreign digest is refused.\n620|func TestManifestIdentityMismatch(t *testing.T) {\n621|\tt.Parallel()\n622|\n623|\tuniverse := testUniverse(t)\n624|\tobject := cloneMap(t, universe.manifest)\n625|\tobject[\"manifest_id\"] = testSeedDigest(0xDD)\n626|\tif _, err := terminalbackend.ParseManifest(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n627|\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n628|\t}\n629|}\n630|\n631|// TestProbeDocumentRefusals narrows the probe closed-schema gate the same\n632|// way, including the probe-only members.\n633|func TestProbeDocumentRefusals(t *testing.T) {\n634|\tt.Parallel()\n635|\n636|\t// Note: a static probe claim that merely differs from the manifest\n637|\t// parses by design; cross-document reconciliation owns that refusal.\n638|\tcases := map[string]func(t *testing.T, object map[string]any){\n639|\t\t\"unknown availability\": func(t *testing.T, object map[string]any) {\n640|\t\t\tobject[\"availability\"] = \"sometimes\"\n641|\t\t},\n642|\t\t\"bad os version\": func(t *testing.T, object map[string]any) {\n643|\t\t\tobject[\"os_version\"] = \"\"\n644|\t\t},\n645|\t\t\"bad platform\": func(t *testing.T, object map[string]any) {\n646|\t\t\tobject[\"platform\"] = \"plan9\"\n647|\t\t},\n648|\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n649|\t\t\tobject[\"protocol_version\"] = \"2.0.0\"\n650|\t\t},\n651|\t\t\"unsorted evidence ids\": func(t *testing.T, object map[string]any) {\n652|\t\t\tids := object[\"evidence_ids\"].([]any)\n653|\t\t\tfor left, right := 0, len(ids)-1; left < right; left, right = left+1, right-1 {\n654|\t\t\t\tids[left], ids[right] = ids[right], ids[left]\n655|\t\t\t}\n656|\t\t},\n657|\t\t\"duplicate evidence ids\": func(t *testing.T, object map[string]any) {\n658|\t\t\tids := object[\"evidence_ids\"].([]any)\n659|\t\t\tobject[\"evidence_ids\"] = append(ids, ids[0])\n660|\t\t},\n661|\t\t\"malformed evidence id\": func(t *testing.T, object map[string]any) {\n662|\t\t\tobject[\"evidence_ids\"] = []any{\"nope\"}\n663|\t\t},\n664|\t\t\"bad timestamp\": func(t *testing.T, object map[string]any) {\n665|\t\t\tobject[\"probed_at\"] = \"2026-01-15 12:00:00\"\n666|\t\t},\n667|\t\t\"timestamp without fraction\": func(t *testing.T, object map[string]any) {\n668|\t\t\tobject[\"probed_at\"] = \"2026-01-15T12:00:00Z\"\n669|\t\t},\n670|\t\t\"non-empty extensions\": func(t *testing.T, object map[string]any) {\n671|\t\t\tobject[\"extensions\"] = map[string]any{\"x\": 1}\n672|\t\t},\n673|\t}\n674|\tfor name, mutate := range cases {\n675|\t\tt.Run(name, func(t *testing.T) {\n676|\t\t\tt.Parallel()\n677|\n678|\t\t\tuniverse := testUniverse(t)\n679|\t\t\tobject := cloneMap(t, universe.probe)\n680|\t\t\tmutate(t, object)\n681|\t\t\tfinalizeDocument(t, object, \"probe_id\")\n682|\t\t\tif _, err := terminalbackend.ParseProbe(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n683|\t\t\t\tt.Errorf(\"ParseProbe() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n684|\t\t\t}\n685|\t\t})\n686|\t}\n687|}\n688|\n689|// TestEvidenceDocumentRefusals narrows the evidence closed-schema gate. The\n690|// signature is re-applied after every unsigned-field mutation so each case\n691|// reaches its own arm instead of the attestation check.\n692|func TestEvidenceDocumentRefusals(t *testing.T) {\n693|\tt.Parallel()\n694|\n695|\tcases := map[string]func(t *testing.T, universe *fixtureUniverse, object map[string]any){\n696|\t\t\"false value\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n697|\t\t\tobject[\"value\"] = false\n698|\t\t},\n699|\t\t\"string value\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n700|\t\t\tobject[\"value\"] = \"true\"\n701|\t\t},\n702|\t\t\"expires equal observed\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n703|\t\t\tobject[\"expires_at\"] = object[\"observed_at\"]\n704|\t\t},\n705|\t\t\"expires before observed\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n706|\t\t\tobject[\"expires_at\"] = \"2024-01-01T00:00:00.000Z\"\n707|\t\t},\n708|\t\t\"unknown fact\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n709|\t\t\tobject[\"facts\"] = []any{\"fixture_passed\", \"good_vibes\"}\n710|\t\t},\n711|\t\t\"unsorted facts\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n712|\t\t\tobject[\"facts\"] = []any{\"runtime_probe_passed\", \"fixture_passed\"}\n713|\t\t},\n714|\t\t\"empty facts\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n715|\t\t\tobject[\"facts\"] = []any{}\n716|\t\t},\n717|\t\t\"unknown issuer\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n718|\t\t\tobject[\"issuer\"] = \"self\"\n719|\t\t},\n720|\t\t\"bad signature scheme\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n721|\t\t\tobject[\"attestation_signature\"] = \"sha256:abcd\"\n722|\t\t},\n723|\t\t\"bad signature encoding\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n724|\t\t\tobject[\"attestation_signature\"] = \"rsa-sha256:!!!\"\n725|\t\t},\n726|\t\t\"realm members on plain claim\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n727|\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n728|\t\t\tobject[\"provider_id\"] = \"codex\"\n729|\t\t\tobject[\"provider_build\"] = \"1.0\"\n730|\t\t\tobject[\"sentinel_result\"] = \"passed\"\n731|\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n732|\t\t},\n733|\t\t\"bad provider id\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n734|\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n735|\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n736|\t\t\tobject[\"provider_id\"] = \"Codex!!\"\n737|\t\t\tobject[\"provider_build\"] = \"1.0\"\n738|\t\t\tobject[\"sentinel_result\"] = \"passed\"\n739|\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n740|\t\t},\n741|\t\t\"half provider pair\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n742|\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n743|\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n744|\t\t\tobject[\"provider_id\"] = \"codex\"\n745|\t\t\tobject[\"provider_build\"] = nil\n746|\t\t\tobject[\"sentinel_result\"] = \"passed\"\n747|\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n748|\t\t},\n749|\t\t\"failed sentinel literal\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n750|\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n751|\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n752|\t\t\tobject[\"provider_id\"] = \"codex\"\n753|\t\t\tobject[\"provider_build\"] = \"1.0\"\n754|\t\t\tobject[\"sentinel_result\"] = \"failed\"\n755|\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n756|\t\t},\n757|\t\t\"unknown capability\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n758|\t\t\tobject[\"capability\"] = \"teleportation\"\n759|\t\t},\n760|\t\t\"numeric fact\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n761|\t\t\tobject[\"facts\"] = []any{\"fixture_passed\", float64(7)}\n762|\t\t},\n763|\t}\n764|\tfor name, mutate := range cases {\n765|\t\tt.Run(name, func(t *testing.T) {\n766|\t\t\tt.Parallel()\n767|\n768|\t\t\tuniverse := testUniverse(t)\n769|\t\t\tobject := cloneMap(t, universe.evidenceByCap[\"durable_disconnect\"])\n770|\t\t\tmutate(t, universe, object)\n771|\t\t\t// Only the identity is re-stamped: parsing never verifies\n772|\t\t\t// the attestation, so the original signature stays a valid\n773|\t\t\t// bystander and every case reaches its own structural arm.\n774|\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n775|\t\t\tif _, err := terminalbackend.ParseEvidence(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n776|\t\t\t\tt.Errorf(\"ParseEvidence() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n777|\t\t\t}\n778|\t\t})\n779|\t}\n780|}\n781|\n782|// reconcileFixture parses one possibly-mutated universe into typed values.\n783|func reconcileFixture(t *testing.T, universe *fixtureUniverse) (terminalbackend.Manifest, terminalbackend.Probe, []terminalbackend.Evidence) {\n784|\tt.Helper()\n785|\n786|\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n787|\tif err != nil {\n788|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n789|\t}\n790|\tprobe, err := terminalbackend.ParseProbe(mustMarshal(t, universe.probe))\n791|\tif err != nil {\n792|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n793|\t}\n794|\t// Every entry in the evidence set parses, including extras the case\n795|\t// added: unlisted or dangling objects are reconciliation refusals,\n796|\t// not parse failures.\n797|\tnames := make([]string, 0, len(universe.evidenceByCap))\n798|\tfor name := range universe.evidenceByCap {\n799|\t\tnames = append(names, name)\n800|\t}\n801|\tsort.Strings(names)\n802|\tevidence := make([]terminalbackend.Evidence, 0, len(names))\n803|\tfor _, name := range names {\n804|\t\tparsed, err := terminalbackend.ParseEvidence(mustMarshal(t, universe.evidenceByCap[name]))\n805|\t\tif err != nil {\n806|\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", name, err)\n807|\t\t}\n808|\t\tevidence = append(evidence, parsed)\n809|\t}\n810|\treturn manifest, probe, evidence\n811|}\n812|\n813|// TestReconcileRefusals proves every admission arm fails closed with its\n814|// exact wire code. Each case moves exactly one input and re-finalizes\n815|// identities (and re-signs evidence when an unsigned field moves) so the\n816|// failure lands on the intended arm.\n817|func TestReconcileRefusals(t *testing.T) {\n818|\tt.Parallel()\n819|\n820|\tcases := map[string]struct {\n821|\t\tmutate func(t *testing.T, universe *fixtureUniverse)\n822|\t\tcheck  func(t *testing.T, err error)\n823|\t}{\n824|\t\t\"version mismatch\": {\n825|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n826|\t\t\t\tuniverse.probe[\"implementation_version\"] = \"2.2.0\"\n827|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n828|\t\t\t},\n829|\t\t\tcheck: func(t *testing.T, err error) {\n(more lines below)"}}}
