{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5eb","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":336,"recorded_at":1780531400000667,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"8e60ca9c-9dd1-45c4-a7f3-92b60f7458d0"},"task_id":"8e60ca9c-9dd1-45c4-a7f3-92b60f7458d0","event":{"kind":"output","task_id":"8e60ca9c-9dd1-45c4-a7f3-92b60f7458d0","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1537 line(s) above)\n1538|// checkProbeIdentity enforces the §4.B identity equalities. Executable\n1539|// substitution additionally maps to the more specific untrusted code.\n1540|func checkProbeIdentity(manifest Manifest, probe Probe) error {\n1541|\tif probe.TerminalBackendID != manifest.TerminalBackendID ||\n1542|\t\tprobe.ImplementationVersion != manifest.ImplementationVersion ||\n1543|\t\tprobe.ImplementationKind != manifest.ImplementationKind {\n1544|\t\treturn mismatchf(\"probe manifest binding\")\n1545|\t}\n1546|\tif probe.ExecutableDigest != manifest.ExecutableDigest {\n1547|\t\tif probe.TerminalBackendID == manifest.TerminalBackendID {\n1548|\t\t\treturn &Error{Code: CodeUntrusted, BackendID: probe.TerminalBackendID, Detail: \"executable substitution\"}\n1549|\t\t}\n1550|\t\treturn mismatchf(\"probe manifest binding\")\n1551|\t}\n1552|\treturn nil\n1553|}\n1554|\n1555|// checkProbeMembership enforces array-to-scalar selection as membership:\n1556|// the probe protocol version must be exactly one Manifest member and the\n1557|// probe platform exactly one Manifest platform member.\n1558|func checkProbeMembership(manifest Manifest, probe Probe) error {\n1559|\tmember := false\n1560|\tfor _, version := range manifest.ProtocolVersions {\n1561|\t\tif probe.ProtocolVersion == version {\n1562|\t\t\tmember = true\n1563|\t\t\tbreak\n1564|\t\t}\n1565|\t}\n1566|\tif !member {\n1567|\t\treturn mismatchf(\"probe protocol membership\")\n1568|\t}\n1569|\tfor _, platform := range manifest.Platforms {\n1570|\t\tif probe.Platform == platform {\n1571|\t\t\treturn nil\n1572|\t\t}\n1573|\t}\n1574|\treturn mismatchf(\"probe platform membership\")\n1575|}\n1576|\n1577|// checkProbeGeneration binds the probe to the AX-known raw generation. A\n1578|// digest mismatch (or an underivable raw generation, including empty, which\n1579|// would make every backend share one digest) is stale, never a retry hint.\n1580|func checkProbeGeneration(probe Probe, rawGeneration string) error {\n1581|\tdigest, err := GenerationDigest(rawGeneration)\n1582|\tif err != nil {\n1583|\t\treturn err\n1584|\t}\n1585|\tif digest != probe.BackendGenerationDigest {\n1586|\t\treturn &Error{Code: CodeStaleGeneration, BackendID: probe.TerminalBackendID, Detail: \"probe generation binding\"}\n1587|\t}\n1588|\treturn nil\n1589|}\n1590|\n1591|// indexClaims keys validated claims by capability. The validated lists are\n1592|// duplicate-free, so the index cannot collide.\n1593|func indexClaims(claims []Claim) map[string]Claim {\n1594|\tindexed := make(map[string]Claim, len(claims))\n1595|\tfor _, claim := range claims {\n1596|\t\tindexed[claim.Capability] = claim\n1597|\t}\n1598|\treturn indexed\n1599|}\n1600|\n1601|// checkClaimRelation enforces the complete §4.B keyed relation between the\n1602|// Manifest static claims M and the Probe claims P.\n1603|func checkClaimRelation(manifest map[string]Claim, probe []Claim) error {\n1604|\tfor _, proved := range probe {\n1605|\t\tcapability := proved.Capability\n1606|\t\tstatic, exists := manifest[capability]\n1607|\t\tswitch {\n1608|\t\tcase proved.Origin == OriginStatic && !exists:\n1609|\t\t\treturn mismatchf(\"probe static claim without manifest\")\n1610|\t\tcase proved.Origin == OriginStatic:\n1611|\t\t\tif !equalClaim(proved, static) {\n1612|\t\t\t\treturn mismatchf(\"probe static claim echo\")\n1613|\t\t\t}\n1614|\t\tcase exists && !static.GenerationVariable:\n1615|\t\t\treturn mismatchf(\"probe override of stable claim\")\n1616|\t\tcase exists:\n1617|\t\t\tif proved.GenerationVariable != static.GenerationVariable ||\n1618|\t\t\t\t!equalStrings(proved.DependentOperations, static.DependentOperations) ||\n1619|\t\t\t\t!equalStrings(proved.EvidenceRequirements, static.EvidenceRequirements) {\n1620|\t\t\t\treturn mismatchf(\"probe override registry binding\")\n1621|\t\t\t}\n1622|\t\tdefault:\n1623|\t\t\trow := capabilityRegistry[proved.Capability]\n1624|\t\t\tif proved.GenerationVariable != row.generationVariable ||\n1625|\t\t\t\t!equalStrings(proved.DependentOperations, row.dependentOperations) ||\n1626|\t\t\t\t!equalStrings(proved.EvidenceRequirements, row.evidenceRequirements) {\n1627|\t\t\t\treturn mismatchf(\"probe addition registry binding\")\n1628|\t\t\t}\n1629|\t\t}\n1630|\t}\n1631|\tfor capability := range manifest {\n1632|\t\tif _, present := indexProbeCapability(probe, capability); !present {\n1633|\t\t\treturn mismatchf(\"probe omission of manifest claim\")\n1634|\t\t}\n1635|\t}\n1636|\treturn nil\n1637|}\n1638|\n1639|// indexProbeCapability reports whether the probe lists the capability. The\n1640|// probe list is validated duplicate-free, so presence is unambiguous.\n1641|func indexProbeCapability(probe []Claim, capability string) (Claim, bool) {\n1642|\tfor _, claim := range probe {\n1643|\t\tif claim.Capability == capability {\n1644|\t\t\treturn claim, true\n1645|\t\t}\n1646|\t}\n1647|\treturn Claim{}, false\n1648|}\n1649|\n1650|// checkEvidenceSet validates every supplied evidence object: it must name a\n1651|// present true probe claim, bind to this exact Manifest/Probe tuple, be\n1652|// live at now, and carry a valid attestation signature. Expired,\n1653|// wrong-generation, or dangling evidence disables the claim it names; a\n1654|// forged or unverifiable signature is an integrity failure. The returned\n1655|// objects are the usable set that coverage and ID-set checks consume.\n1656|func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\n1657|\tused := make([]Evidence, 0, len(evidence))\n(more lines below)"}}}
