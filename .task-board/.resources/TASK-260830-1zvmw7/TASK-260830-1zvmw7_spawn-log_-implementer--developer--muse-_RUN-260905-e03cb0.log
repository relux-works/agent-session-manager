{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69f","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":426,"recorded_at":1780531400000847,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"2fe89724-d0fd-4588-b68e-35b726f68986"},"task_id":"2fe89724-d0fd-4588-b68e-35b726f68986","event":{"kind":"output","task_id":"2fe89724-d0fd-4588-b68e-35b726f68986","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(955 line(s) above)\n956|// probeMembers is the exact closed Probe member set.\n957|var probeMembers = []string{\n958|\t\"schema\", \"schema_version\", \"probe_id\", \"terminal_backend_id\",\n959|\t\"implementation_version\", \"protocol_version\", \"implementation_kind\",\n960|\t\"executable_digest\", \"platform\", \"os_version\", \"availability\",\n961|\t\"backend_generation_digest\", \"capability_claims\", \"evidence_ids\",\n962|\t\"probed_at\", \"extensions\",\n963|}\n964|\n965|// ParseProbe validates one Terminal Backend Probe 1.0.0 document. Shape,\n966|// vocabulary, bound, ordering, registry-row, and identity failures are all\n967|// CodeMismatch; cross-document reconciliation against the Manifest happens\n968|// in Reconcile, not here.\n969|func ParseProbe(raw []byte) (Probe, error) {\n970|\tobject, err := decodeStrictObject(raw)\n971|\tif err != nil {\n972|\t\treturn Probe{}, err\n973|\t}\n974|\tif err := checkExactMembers(object, probeMembers); err != nil {\n975|\t\treturn Probe{}, err\n976|\t}\n977|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaProbe {\n978|\t\treturn Probe{}, mismatchf(\"probe schema\")\n979|\t}\n980|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n981|\t\treturn Probe{}, mismatchf(\"probe schema version\")\n982|\t}\n983|\tprobeID, err := stringMember(object, \"probe_id\")\n984|\tif err != nil {\n985|\t\treturn Probe{}, err\n986|\t}\n987|\tif err := checkIdentity(object, \"probe_id\", probeID); err != nil {\n988|\t\treturn Probe{}, err\n989|\t}\n990|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n991|\tif err != nil {\n992|\t\treturn Probe{}, err\n993|\t}\n994|\tif _, err := ParseID(backendID); err != nil {\n995|\t\treturn Probe{}, mismatchf(\"probe backend identity\")\n996|\t}\n997|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n998|\tif err != nil {\n999|\t\treturn Probe{}, err\n1000|\t}\n1001|\tprotocolVersion, err := semverMember(object, \"protocol_version\")\n1002|\tif err != nil {\n1003|\t\treturn Probe{}, err\n1004|\t}\n1005|\tif semverMajor(protocolVersion) != 1 {\n1006|\t\treturn Probe{}, mismatchf(\"probe protocol major 1\")\n1007|\t}\n1008|\tkindName, err := stringMember(object, \"implementation_kind\")\n1009|\tif err != nil {\n1010|\t\treturn Probe{}, err\n1011|\t}\n1012|\tkind, err := parseKind(kindName)\n1013|\tif err != nil {\n1014|\t\treturn Probe{}, mismatchf(\"probe implementation kind\")\n1015|\t}\n1016|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n1017|\tif err != nil {\n1018|\t\treturn Probe{}, err\n1019|\t}\n1020|\tif needsDigest(kind) == (digest == \"\") {\n1021|\t\treturn Probe{}, mismatchf(\"probe executable digest\")\n1022|\t}\n1023|\tplatformName, err := stringMember(object, \"platform\")\n1024|\tif err != nil {\n1025|\t\treturn Probe{}, err\n1026|\t}\n1027|\tplatform, err := scalar.ParsePlatform(platformName)\n1028|\tif err != nil {\n1029|\t\treturn Probe{}, mismatchf(\"probe platform\")\n1030|\t}\n1031|\tosVersion, err := boundedStringMember(object, \"os_version\")\n1032|\tif err != nil {\n1033|\t\treturn Probe{}, err\n1034|\t}\n1035|\tavailability, err := stringMember(object, \"availability\")\n1036|\tif err != nil {\n1037|\t\treturn Probe{}, err\n1038|\t}\n1039|\tswitch availability {\n1040|\tcase AvailabilityAvailable, AvailabilityConditional, AvailabilityUnavailable, AvailabilityUnknown:\n1041|\tdefault:\n1042|\t\treturn Probe{}, mismatchf(\"probe availability\")\n1043|\t}\n1044|\tgenerationDigest, err := digestMember(object, \"backend_generation_digest\")\n1045|\tif err != nil {\n1046|\t\treturn Probe{}, err\n1047|\t}\n1048|\tclaimsRaw, known := object[\"capability_claims\"]\n1049|\tif !known {\n1050|\t\treturn Probe{}, mismatchf(\"document members\")\n1051|\t}\n1052|\tclaims, err := parseClaimList(claimsRaw, true)\n1053|\tif err != nil {\n1054|\t\treturn Probe{}, err\n1055|\t}\n1056|\tevidenceIDs, err := stringArrayMember(object, \"evidence_ids\")\n1057|\tif err != nil {\n1058|\t\treturn Probe{}, err\n1059|\t}\n1060|\tif len(evidenceIDs) > maxEvidenceIDs {\n1061|\t\treturn Probe{}, mismatchf(\"evidence list bound\")\n1062|\t}\n1063|\tfor _, id := range evidenceIDs {\n1064|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n1065|\t\t\treturn Probe{}, mismatchf(\"document digest\")\n1066|\t\t}\n1067|\t}\n1068|\tif err := checkSortedUnique(evidenceIDs); err != nil {\n1069|\t\treturn Probe{}, err\n1070|\t}\n1071|\tprobedAt, err := timestampMember(object, \"probed_at\")\n1072|\tif err != nil {\n1073|\t\treturn Probe{}, err\n1074|\t}\n1075|\tif err := checkExtensions(object); err != nil {\n1076|\t\treturn Probe{}, err\n1077|\t}\n1078|\treturn Probe{\n1079|\t\tProbeID:                 probeID,\n1080|\t\tTerminalBackendID:       backendID,\n1081|\t\tImplementationVersion:   implementationVersion,\n1082|\t\tProtocolVersion:         protocolVersion,\n1083|\t\tImplementationKind:      kind,\n1084|\t\tExecutableDigest:        digest,\n1085|\t\tPlatform:                platform,\n1086|\t\tOSVersion:               osVersion,\n1087|\t\tAvailability:            availability,\n1088|\t\tBackendGenerationDigest: generationDigest,\n1089|\t\tCapabilityClaims:        claims,\n1090|\t\tEvidenceIDs:             evidenceIDs,\n1091|\t\tProbedAt:                probedAt,\n1092|\t}, nil\n1093|}\n1094|\n1095|// evidenceMembers is the exact closed Capability Evidence member set.\n1096|var evidenceMembers = []string{\n1097|\t\"schema\", \"schema_version\", \"evidence_id\", \"terminal_backend_id\",\n1098|\t\"implementation_version\", \"protocol_version\", \"backend_generation_digest\",\n1099|\t\"capability\", \"value\", \"platform\", \"os_version\", \"conformance_fixture_id\",\n1100|\t\"observed_at\", \"expires_at\", \"issuer\", \"issuer_id\",\n1101|\t\"attestation_signature\", \"facts\", \"terminal_binding_id\", \"provider_id\",\n1102|\t\"provider_build\", \"sentinel_result\", \"provider_auth_smoke_result\",\n1103|\t\"extensions\",\n1104|}\n1105|\n1106|// ParseEvidence validates one Capability Evidence 1.0.0 document. The\n1107|// signature is structurally decoded here; cryptographic verification happens\n1108|// in Reconcile through the caller's SignatureVerifier, because a\n1109|// caller-supplied issuer ID is not authentication. Expiry (expires_at\n1110|// strictly after observed_at) is enforced here; liveness at admission time\n1111|// is enforced in Reconcile.\n1112|func ParseEvidence(raw []byte) (Evidence, error) {\n1113|\tobject, err := decodeStrictObject(raw)\n1114|\tif err != nil {\n1115|\t\treturn Evidence{}, err\n(more lines below)"}}}
