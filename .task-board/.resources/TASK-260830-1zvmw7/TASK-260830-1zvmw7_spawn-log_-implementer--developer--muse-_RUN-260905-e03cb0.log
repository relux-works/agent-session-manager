{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6d5","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":453,"recorded_at":1780531400000901,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"fce09be1-9deb-4782-afa4-107fa1f0b608"},"task_id":"fce09be1-9deb-4782-afa4-107fa1f0b608","event":{"kind":"output","task_id":"fce09be1-9deb-4782-afa4-107fa1f0b608","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1111 line(s) above)\n1112|func ParseEvidence(raw []byte) (Evidence, error) {\n1113|\tobject, err := decodeStrictObject(raw)\n1114|\tif err != nil {\n1115|\t\treturn Evidence{}, err\n1116|\t}\n1117|\tif err := checkExactMembers(object, evidenceMembers); err != nil {\n1118|\t\treturn Evidence{}, err\n1119|\t}\n1120|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaCapabilityEvidence {\n1121|\t\treturn Evidence{}, mismatchf(\"evidence schema\")\n1122|\t}\n1123|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n1124|\t\treturn Evidence{}, mismatchf(\"evidence schema version\")\n1125|\t}\n1126|\tevidenceID, err := stringMember(object, \"evidence_id\")\n1127|\tif err != nil {\n1128|\t\treturn Evidence{}, err\n1129|\t}\n1130|\tif err := checkIdentity(object, \"evidence_id\", evidenceID); err != nil {\n1131|\t\treturn Evidence{}, err\n1132|\t}\n1133|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1134|\tif err != nil {\n1135|\t\treturn Evidence{}, err\n1136|\t}\n1137|\tif _, err := ParseID(backendID); err != nil {\n1138|\t\treturn Evidence{}, mismatchf(\"evidence backend identity\")\n1139|\t}\n1140|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1141|\tif err != nil {\n1142|\t\treturn Evidence{}, err\n1143|\t}\n1144|\tprotocolVersion, err := semverMember(object, \"protocol_version\")\n1145|\tif err != nil {\n1146|\t\treturn Evidence{}, err\n1147|\t}\n1148|\tif semverMajor(protocolVersion) != 1 {\n1149|\t\treturn Evidence{}, mismatchf(\"evidence protocol major 1\")\n1150|\t}\n1151|\tgenerationDigest, err := digestMember(object, \"backend_generation_digest\")\n1152|\tif err != nil {\n1153|\t\treturn Evidence{}, err\n1154|\t}\n1155|\tcapability, err := stringMember(object, \"capability\")\n1156|\tif err != nil {\n1157|\t\treturn Evidence{}, err\n1158|\t}\n1159|\tif _, known := capabilityRegistry[capability]; !known {\n1160|\t\treturn Evidence{}, mismatchf(\"capability vocabulary\")\n1161|\t}\n1162|\t// Evidence value is the literal true: a false claim has no matching\n1163|\t// evidence, so a false-valued object is malformed.\n1164|\tif value, ok := object[\"value\"].(bool); !ok || !value {\n1165|\t\treturn Evidence{}, mismatchf(\"evidence value\")\n1166|\t}\n1167|\tplatformName, err := stringMember(object, \"platform\")\n1168|\tif err != nil {\n1169|\t\treturn Evidence{}, err\n1170|\t}\n1171|\tplatform, err := scalar.ParsePlatform(platformName)\n1172|\tif err != nil {\n1173|\t\treturn Evidence{}, mismatchf(\"evidence platform\")\n1174|\t}\n1175|\tosVersion, err := boundedStringMember(object, \"os_version\")\n1176|\tif err != nil {\n1177|\t\treturn Evidence{}, err\n1178|\t}\n1179|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n1180|\tif err != nil {\n1181|\t\treturn Evidence{}, err\n1182|\t}\n1183|\tobservedAt, err := timestampMember(object, \"observed_at\")\n1184|\tif err != nil {\n1185|\t\treturn Evidence{}, err\n1186|\t}\n1187|\texpiresAt, err := timestampMember(object, \"expires_at\")\n1188|\tif err != nil {\n1189|\t\treturn Evidence{}, err\n1190|\t}\n1191|\tobserved, err := observedAt.Time()\n1192|\tif err != nil {\n1193|\t\treturn Evidence{}, mismatchf(\"document timestamp\")\n1194|\t}\n1195|\texpires, err := expiresAt.Time()\n1196|\tif err != nil {\n1197|\t\treturn Evidence{}, mismatchf(\"document timestamp\")\n1198|\t}\n1199|\tif !expires.After(observed) {\n1200|\t\treturn Evidence{}, mismatchf(\"evidence expiry\")\n1201|\t}\n1202|\tissuer, err := stringMember(object, \"issuer\")\n1203|\tif err != nil {\n1204|\t\treturn Evidence{}, err\n1205|\t}\n1206|\tif issuer != IssuerRelease && issuer != IssuerLocalProbe {\n1207|\t\treturn Evidence{}, mismatchf(\"evidence issuer\")\n1208|\t}\n1209|\tissuerID, err := digestMember(object, \"issuer_id\")\n1210|\tif err != nil {\n1211|\t\treturn Evidence{}, err\n1212|\t}\n1213|\tsignature, err := parseAttestationSignature(object)\n1214|\tif err != nil {\n1215|\t\treturn Evidence{}, err\n1216|\t}\n1217|\tfacts, err := stringArrayMember(object, \"facts\")\n1218|\tif err != nil {\n1219|\t\treturn Evidence{}, err\n1220|\t}\n1221|\tif err := checkClosedList(facts, evidenceFactVocabulary, maxFacts, true); err != nil {\n1222|\t\treturn Evidence{}, err\n1223|\t}\n1224|\trealm, err := parseRealmMembers(object, capability)\n1225|\tif err != nil {\n1226|\t\treturn Evidence{}, err\n1227|\t}\n1228|\tif err := checkExtensions(object); err != nil {\n1229|\t\treturn Evidence{}, err\n1230|\t}\n1231|\treturn Evidence{\n1232|\t\tEvidenceID:              evidenceID,\n1233|\t\tTerminalBackendID:       backendID,\n1234|\t\tImplementationVersion:   implementationVersion,\n1235|\t\tProtocolVersion:         protocolVersion,\n1236|\t\tBackendGenerationDigest: generationDigest,\n1237|\t\tCapability:              capability,\n1238|\t\tPlatform:                platform,\n1239|\t\tOSVersion:               osVersion,\n1240|\t\tConformanceFixtureID:    fixtureID,\n1241|\t\tObservedAt:              observedAt,\n1242|\t\tExpiresAt:               expiresAt,\n1243|\t\tIssuer:                  issuer,\n1244|\t\tIssuerID:                issuerID,\n1245|\t\tAttestationSignature:    signature,\n1246|\t\tFacts:                   facts,\n1247|\t\tTerminalBindingID:       realm.bindingID,\n1248|\t\tProviderID:              realm.providerID,\n1249|\t\tProviderBuild:           realm.providerBuild,\n1250|\t\tSentinelResult:          realm.sentinelResult,\n1251|\t\tProviderAuthSmokeResult: realm.smokeResult,\n1252|\t}, nil\n1253|}\n1254|\n1255|// parseAttestationSignature structurally decodes the rsa-sha256: plus Base64\n1256|// RFC 4648 attestation signature. Decoding success is not validity.\n(more lines below)"}}}
