{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"call_id":"call_01a06ee68b027200aeb44fd734fc4f91","text":"Read text file `internal/terminalbackend/manifest.go`.\n(1414 line(s) above)\n1415|\treturn value\n1416|}\n1417|\n1418|// Admitted is the reconciled capability set for one Manifest/Probe tuple:\n1419|// every true probe claim with generation-bound, unexpired, signature-valid\n1420|// evidence covering all its requirements. Capabilities holds the sorted\n1421|// admitted true-claim names; EvidenceIDs holds the sorted IDs of the\n1422|// evidence objects that proved them.\n1423|type Admitted struct {\n1424|\tCapabilities []string\n1425|\tEvidenceIDs  []string\n1426|}\n1427|\n1428|// Has reports whether capability is an admitted true claim.\n1429|func (admitted Admitted) Has(capability string) bool {\n1430|\tfor _, member := range admitted.Capabilities {\n1431|\t\tif member == capability {\n1432|\t\t\treturn true\n1433|\t\t}\n1434|\t}\n1435|\treturn false\n1436|}\n1437|\n1438|// HasOperation reports whether any admitted true capability confers the\n1439|// operation through its registry dependent_operations.\n1440|func (admitted Admitted) HasOperation(operation string) bool {\n1441|\tfor _, capability := range admitted.Capabilities {\n1442|\t\trow, known := capabilityRegistry[capability]\n1443|\t\tif !known {\n1444|\t\t\tcontinue\n1445|\t\t}\n1446|\t\tfor _, conferred := range row.dependentOperations {\n1447|\t\t\tif conferred == operation {\n1448|\t\t\t\treturn true\n1449|\t\t\t}\n1450|\t\t}\n1451|\t}\n1452|\treturn false\n1453|}\n1454|\n1455|// CapabilitiesForOperation returns the sorted registry capabilities whose\n1456|// dependent_operations confer the operation. manifest and probe confer\n1457|// through no capability and return an empty set: they carry no capability\n1458|// dependency. An unknown operation is refused: the operation vocabulary is\n1459|// closed.\n1460|func CapabilitiesForOperation(operation string) ([]string, error) {\n1461|\tif !operationVocabulary[operation] {\n1462|\t\treturn nil, mismatchf(\"operation vocabulary\")\n1463|\t}\n1464|\tvar capabilities []string\n1465|\tfor capability, row := range capabilityRegistry {\n1466|\t\tfor _, conferred := range row.dependentOperations {\n1467|\t\t\tif conferred == operation {\n1468|\t\t\t\tcapabilities = append(capabilities, capability)\n1469|\t\t\t\tbreak\n1470|\t\t\t}\n1471|\t\t}\n1472|\t}\n1473|\treturn capabilities, nil\n1474|}\n1475|\n1476|// CheckOperation gates one operation against the admitted set: the operation\n1477|// must be in the closed vocabulary and at least one admitted true\n1478|// capability must confer it, or the operation is refused with\n1479|// CodeCapabilityUnproven. Conditional §4.C dependencies (interactivity,\n1480|// credential need, attach overlap, provider observation) are evaluated by\n1481|// the lifecycle owner at the operation call site; this gate proves only the\n1482|// capability-confers-operation half, which is the bound this file owns.\n1483|func CheckOperation(operation string, admitted Admitted) error {\n1484|\tif !operationVocabulary[operation] {\n1485|\t\treturn mismatchf(\"operation vocabulary\")\n1486|\t}\n1487|\tif !admitted.HasOperation(operation) {\n1488|\t\treturn &Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"}\n1489|\t}\n1490|\treturn nil\n1491|}\n1492|\n1493|// Reconcile admits one Probe against its Manifest with the returned\n1494|// evidence set, binding everything to the AX-known raw generation and the\n1495|// admission instant (§4.B keyed relation, §4.D evidence binding). The check\n1496|// order is deterministic: identity equality, protocol/platform membership,\n1497|// generation binding, claim relation, per-object evidence usability\n1498|// (tuple binding, liveness, signature), per-claim requirement coverage,\n1499|// then the exact evidence_ids set rule. The first failure wins; every\n1500|// failure fails closed before activation.\n1501|//\n1502|// Each supplied evidence object must independently prove its named claim:\n1503|// split-facts evidence (requirement coverage spread across several objects,\n1504|// none sufficient alone) is refused. That reading follows the singular\n1505|// rule-5 phrasing (\"Capability Evidence ... satisfies every listed evidence\n1506|// requirement\") and is stated here as the bound.\n1507|func Reconcile(manifest Manifest, probe Probe, evidence []Evidence, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1508|\tif verify == nil {\n1509|\t\treturn Admitted{}, integrityFailure(\"evidence signature verifier\")\n1510|\t}\n1511|\tif err := checkProbeIdentity(manifest, probe); err != nil {\n1512|\t\treturn Admitted{}, err\n1513|\t}\n1514|\tif err := checkProbeMembership(manifest, probe); err != nil {\n1515|\t\treturn Admitted{}, err\n1516|\t}\n1517|\tif err := checkProbeGeneration(probe, rawGeneration); err != nil {\n1518|\t\treturn Admitted{}, err\n1519|\t}\n1520|\tmanifestClaims := indexClaims(manifest.StaticCapabilityClaims)\n1521|\tif err := checkClaimRelation(manifestClaims, probe.CapabilityClaims); err != nil {\n1522|\t\treturn Admitted{}, err\n1523|\t}\n1524|\tprobeClaims := indexClaims(probe.CapabilityClaims)\n1525|\tused, err := checkEvidenceSet(manifest, probe, probeClaims, evidence, now, verify)\n1526|\tif err != nil {\n1527|\t\treturn Admitted{}, err\n1528|\t}\n1529|\tif err := checkEvidenceCoverage(probeClaims, used); err != nil {\n1530|\t\treturn Admitted{}, err\n1531|\t}\n1532|\tif err := checkEvidenceIDs(probe, used); err != nil {\n1533|\t\treturn Admitted{}, err\n1534|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
