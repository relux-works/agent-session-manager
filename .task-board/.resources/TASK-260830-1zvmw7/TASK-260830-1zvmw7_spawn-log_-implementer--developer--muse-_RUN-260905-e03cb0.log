{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69b","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":424,"recorded_at":1780531400000843,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"e46ea682-64c2-4bb9-8ab4-c9274f15b72e"},"task_id":"e46ea682-64c2-4bb9-8ab4-c9274f15b72e","event":{"kind":"output","task_id":"e46ea682-64c2-4bb9-8ab4-c9274f15b72e","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(690 line(s) above)\n691|// Manifest is one validated Terminal Backend Manifest 1.0.0: the closed\n692|// immutable backend description. It is not availability proof, and no\n693|// unsupported capability may be advertised through it.\n694|type Manifest struct {\n695|\t// ManifestID is the recomputed omit-self digest.\n696|\tManifestID string\n697|\t// TerminalBackendID is the canonical backend identity.\n698|\tTerminalBackendID string\n699|\t// ImplementationVersion is the exact admitted semver.\n700|\tImplementationVersion string\n701|\t// ProtocolVersions are the sorted unique semver members in Terminal\n702|\t// Backend Protocol major 1.\n703|\tProtocolVersions []string\n704|\t// Platforms is the sorted unique non-empty platform subset.\n705|\tPlatforms []scalar.Platform\n706|\t// ImplementationKind is the closed implementation_kind.\n707|\tImplementationKind Kind\n708|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n709|\t// (null) for built-in kinds.\n710|\tExecutableDigest string\n711|\t// StaticCapabilityClaims are the sorted-by-capability unique static\n712|\t// claims, each exactly repeating its registry row.\n713|\tStaticCapabilityClaims []Claim\n714|\t// ConformanceFixtureID names the fixture true claims are proven with.\n715|\tConformanceFixtureID string\n716|}\n717|\n718|// Probe is one validated Terminal Backend Probe 1.0.0: the closed immutable\n719|// observation of a backend on one platform, generation, and instant.\n720|type Probe struct {\n721|\t// ProbeID is the recomputed omit-self digest.\n722|\tProbeID string\n723|\t// TerminalBackendID equals the admitted Manifest member.\n724|\tTerminalBackendID string\n725|\t// ImplementationVersion equals the admitted Manifest member.\n726|\tImplementationVersion string\n727|\t// ProtocolVersion is exactly one member of the Manifest list.\n728|\tProtocolVersion string\n729|\t// ImplementationKind equals the Manifest member.\n730|\tImplementationKind Kind\n731|\t// ExecutableDigest exactly equals the Manifest member.\n732|\tExecutableDigest string\n733|\t// Platform is exactly one member of the Manifest platforms.\n734|\tPlatform scalar.Platform\n735|\t// OSVersion is the string[1..256] host release.\n736|\tOSVersion string\n737|\t// Availability is the closed readiness vocabulary.\n738|\tAvailability string\n739|\t// BackendGenerationDigest is the digest of the domain-separated raw\n740|\t// generation. It neither reveals nor reconstructs that generation.\n741|\tBackendGenerationDigest string\n742|\t// CapabilityClaims are the sorted-by-capability unique reconciled\n743|\t// claims.\n744|\tCapabilityClaims []Claim\n745|\t// EvidenceIDs are the sorted unique IDs of the evidence objects used\n746|\t// by true claims.\n747|\tEvidenceIDs []string\n748|\t// ProbedAt is the observation instant.\n749|\tProbedAt scalar.Timestamp\n750|}\n751|\n752|// Evidence is one validated Capability Evidence 1.0.0 object: the signed,\n753|// expiring, generation-bound proof of one true capability claim. Value is\n754|// always true by construction: a false claim has no matching evidence.\n755|type Evidence struct {\n756|\t// EvidenceID is the recomputed omit-self digest.\n757|\tEvidenceID string\n758|\t// TerminalBackendID equals the Manifest and Probe members.\n759|\tTerminalBackendID string\n760|\t// ImplementationVersion equals the Manifest and Probe members.\n761|\tImplementationVersion string\n762|\t// ProtocolVersion equals the Probe member.\n763|\tProtocolVersion string\n764|\t// BackendGenerationDigest equals the Probe member.\n765|\tBackendGenerationDigest string\n766|\t// Capability names the one true claim this object proves.\n767|\tCapability string\n768|\t// Platform equals the Probe member.\n769|\tPlatform scalar.Platform\n770|\t// OSVersion equals the Probe member.\n771|\tOSVersion string\n772|\t// ConformanceFixtureID equals the Manifest member.\n773|\tConformanceFixtureID string\n774|\t// ObservedAt opens the validity interval.\n775|\tObservedAt scalar.Timestamp\n776|\t// ExpiresAt closes the validity interval, strictly after ObservedAt.\n777|\tExpiresAt scalar.Timestamp\n778|\t// Issuer is ax_release or ax_local_probe.\n779|\tIssuer string\n780|\t// IssuerID is the digest of the trusted signing identity. A\n781|\t// caller-supplied issuer ID is not authentication: the signature must\n782|\t// verify through the trusted key registry.\n783|\tIssuerID string\n784|\t// AttestationSignature is the raw signature bytes (scheme stripped).\n785|\tAttestationSignature []byte\n786|\t// Facts are the sorted unique evidence facts covering the claim's\n787|\t// requirements through the requirement-to-fact mapping.\n788|\tFacts []string\n789|\t// TerminalBindingID is the opaque binding digest, required only for\n790|\t// credential_capable_execution_realm and empty otherwise.\n791|\tTerminalBindingID string\n792|\t// ProviderID is the provider-id, required only for\n793|\t// credential_capable_execution_realm and empty otherwise.\n794|\tProviderID string\n795|\t// ProviderBuild is the string[1..256] provider build, required only\n796|\t// for credential_capable_execution_realm and empty otherwise.\n797|\tProviderBuild string\n798|\t// SentinelResult is literal passed, required only for\n799|\t// credential_capable_execution_realm and empty otherwise.\n800|\tSentinelResult string\n801|\t// ProviderAuthSmokeResult is literal passed, required only for\n802|\t// credential_capable_execution_realm and empty otherwise.\n803|\tProviderAuthSmokeResult string\n804|}\n805|\n(more lines below)"}}}
