{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b1","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":307,"recorded_at":1780531400000609,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"ee3784ca-0453-41f2-aca5-272ef2ddbb42"},"task_id":"ee3784ca-0453-41f2-aca5-272ef2ddbb42","event":{"kind":"output","task_id":"ee3784ca-0453-41f2-aca5-272ef2ddbb42","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(574 line(s) above)\n575|func parseClaim(raw any, allowProbed bool) (Claim, error) {\n576|\tobject, ok := raw.(map[string]any)\n577|\tif !ok {\n578|\t\treturn Claim{}, mismatchf(\"claim shape\")\n579|\t}\n580|\tif err := checkExactMembers(object, []string{\n581|\t\t\"capability\", \"origin\", \"value\",\n582|\t\t\"generation_variable\", \"dependent_operations\", \"evidence_requirements\",\n583|\t}); err != nil {\n584|\t\treturn Claim{}, err\n585|\t}\n586|\tcapability, err := stringMember(object, \"capability\")\n587|\tif err != nil {\n588|\t\treturn Claim{}, err\n589|\t}\n590|\trow, known := capabilityRegistry[capability]\n591|\tif !known {\n592|\t\treturn Claim{}, mismatchf(\"capability vocabulary\")\n593|\t}\n594|\torigin, err := stringMember(object, \"origin\")\n595|\tif err != nil {\n596|\t\treturn Claim{}, err\n597|\t}\n598|\tif origin != OriginStatic && (origin != OriginProbed || !allowProbed) {\n599|\t\treturn Claim{}, mismatchf(\"claim origin\")\n600|\t}\n601|\tboolean, ok := object[\"value\"].(bool)\n602|\tif !ok {\n603|\t\treturn Claim{}, mismatchf(\"document member type\")\n604|\t}\n605|\tgenerationVariable, ok := object[\"generation_variable\"].(bool)\n606|\tif !ok {\n607|\t\treturn Claim{}, mismatchf(\"document member type\")\n608|\t}\n609|\toperations, err := stringArrayMember(object, \"dependent_operations\")\n610|\tif err != nil {\n611|\t\treturn Claim{}, err\n612|\t}\n613|\tif err := checkClosedList(operations, operationVocabulary, maxOperations, true); err != nil {\n614|\t\treturn Claim{}, err\n615|\t}\n616|\trequirements, err := stringArrayMember(object, \"evidence_requirements\")\n617|\tif err != nil {\n618|\t\treturn Claim{}, err\n619|\t}\n620|\tif err := checkClosedList(requirements, evidenceRequirementVocabulary, maxRequirements, true); err != nil {\n621|\t\treturn Claim{}, err\n622|\t}\n623|\t// The three registry-derived members must equal the row: a Manifest or\n624|\t// Probe cannot redefine what a capability means or what proves it.\n625|\tif generationVariable != row.generationVariable ||\n626|\t\t!equalStrings(operations, row.dependentOperations) ||\n627|\t\t!equalStrings(requirements, row.evidenceRequirements) {\n628|\t\treturn Claim{}, mismatchf(\"capability registry binding\")\n629|\t}\n630|\treturn Claim{\n631|\t\tCapability:           capability,\n632|\t\tOrigin:               origin,\n633|\t\tValue:                boolean,\n634|\t\tGenerationVariable:   generationVariable,\n635|\t\tDependentOperations:  operations,\n636|\t\tEvidenceRequirements: requirements,\n637|\t}, nil\n638|}\n639|\n640|// parseClaimList validates a sorted-by-capability unique claim array within\n641|// the [0..16] bound. Sorting is checked here so reconciliation can treat\n642|// the key order as established; duplicates are invalid before keyed\n643|// reconciliation runs.\n644|func parseClaimList(raw any, allowProbed bool) ([]Claim, error) {\n645|\tarray, ok := raw.([]any)\n646|\tif !ok {\n647|\t\treturn nil, mismatchf(\"document member type\")\n648|\t}\n649|\tif len(array) > maxClaims {\n650|\t\treturn nil, mismatchf(\"claim list bound\")\n651|\t}\n652|\tclaims := make([]Claim, 0, len(array))\n653|\tprevious := \"\"\n654|\tfor _, member := range array {\n655|\t\tclaim, err := parseClaim(member, allowProbed)\n656|\t\tif err != nil {\n657|\t\t\treturn nil, err\n658|\t\t}\n659|\t\tif previous >= claim.Capability {\n660|\t\t\treturn nil, mismatchf(\"claim ordering\")\n661|\t\t}\n662|\t\tprevious = claim.Capability\n663|\t\tclaims = append(claims, claim)\n664|\t}\n665|\treturn claims, nil\n666|}\n667|\n668|// equalClaim reports member-for-member equality of two claims.\n669|func equalClaim(left, right Claim) bool {\n670|\treturn left.Capability == right.Capability &&\n671|\t\tleft.Origin == right.Origin &&\n672|\t\tleft.Value == right.Value &&\n673|\t\tleft.GenerationVariable == right.GenerationVariable &&\n674|\t\tequalStrings(left.DependentOperations, right.DependentOperations) &&\n675|\t\tequalStrings(left.EvidenceRequirements, right.EvidenceRequirements)\n676|}\n677|\n678|// equalStrings reports element-wise equality of two string lists.\n679|func equalStrings(left, right []string) bool {\n680|\tif len(left) != len(right) {\n681|\t\treturn false\n682|\t}\n683|\tfor index := range left {\n684|\t\tif left[index] != right[index] {\n685|\t\t\treturn false\n686|\t\t}\n687|\t}\n688|\treturn true\n689|}\n690|\n691|// Manifest is one validated Terminal Backend Manifest 1.0.0: the closed\n692|// immutable backend description. It is not availability proof, and no\n693|// unsupported capability may be advertised through it.\n694|type Manifest struct {\n695|\t// ManifestID is the recomputed omit-self digest.\n696|\tManifestID string\n697|\t// TerminalBackendID is the canonical backend identity.\n698|\tTerminalBackendID string\n699|\t// ImplementationVersion is the exact admitted semver.\n700|\tImplementationVersion string\n701|\t// ProtocolVersions are the sorted unique semver members in Terminal\n702|\t// Backend Protocol major 1.\n703|\tProtocolVersions []string\n704|\t// Platforms is the sorted unique non-empty platform subset.\n(more lines below)"}}}
