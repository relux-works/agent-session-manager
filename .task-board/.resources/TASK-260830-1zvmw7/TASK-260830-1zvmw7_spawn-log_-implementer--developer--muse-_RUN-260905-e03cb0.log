{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e7","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":590,"recorded_at":1780531400001175,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"ce5dcfb2-887b-4f99-8272-c476443671da"},"task_id":"ce5dcfb2-887b-4f99-8272-c476443671da","event":{"kind":"output","task_id":"ce5dcfb2-887b-4f99-8272-c476443671da","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(264 line(s) above)\n265|func mismatchf(format string, arguments ...any) *Error {\n266|\treturn &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n267|}\n268|\n269|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n270|// invalid-UTF-8 refusal, a nesting cap, and trailing-data refusal. Numbers\n271|// decode as json.Number so member validators can refuse them explicitly:\n272|// none of the three closed schemas has a numeric member.\n273|func decodeStrictObject(raw []byte) (map[string]any, error) {\n274|\tif !utf8.Valid(raw) {\n275|\t\treturn nil, mismatchf(\"document encoding\")\n276|\t}\n277|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n278|\tdecoder.UseNumber()\n279|\tvalue, err := decodeCappedValue(decoder, 0)\n280|\tif err != nil {\n281|\t\treturn nil, err\n282|\t}\n283|\tif decoder.More() {\n284|\t\treturn nil, mismatchf(\"document trailing data\")\n285|\t}\n286|\tobject, ok := value.(map[string]any)\n287|\tif !ok {\n288|\t\treturn nil, mismatchf(\"document shape\")\n289|\t}\n290|\treturn object, nil\n291|}\n292|\n293|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n294|// bound is far above the deepest legitimate nesting (object, claims array,\n295|// claim object, member array) and fails closed below any decoder-stack risk.\n296|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n297|\tif depth > maxJSONDepth {\n298|\t\treturn nil, mismatchf(\"document nesting\")\n299|\t}\n300|\ttoken, err := decoder.Token()\n301|\tif err != nil {\n302|\t\treturn nil, mismatchf(\"document syntax\")\n303|\t}\n304|\tif delimiter, ok := token.(json.Delim); ok {\n305|\t\tswitch delimiter {\n306|\t\tcase '{':\n307|\t\t\tobject := make(map[string]any)\n308|\t\t\tfor decoder.More() {\n309|\t\t\t\tkeyToken, err := decoder.Token()\n310|\t\t\t\tif err != nil {\n311|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n312|\t\t\t\t}\n313|\t\t\t\tkey, ok := keyToken.(string)\n314|\t\t\t\tif !ok {\n315|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n316|\t\t\t\t}\n317|\t\t\t\tif _, duplicate := object[key]; duplicate {\n318|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n319|\t\t\t\t}\n320|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n321|\t\t\t\tif err != nil {\n322|\t\t\t\t\treturn nil, err\n323|\t\t\t\t}\n324|\t\t\t\tobject[key] = member\n325|\t\t\t}\n326|\t\t\tif _, err := decoder.Token(); err != nil {\n327|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n328|\t\t\t}\n329|\t\t\treturn object, nil\n330|\t\tcase '[':\n331|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n332|\t\t\t// as [] rather than null, or identity recomputation over an\n333|\t\t\t// empty claim or evidence list diverges from the signer.\n334|\t\t\tarray := []any{}\n335|\t\t\tfor decoder.More() {\n336|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n337|\t\t\t\tif err != nil {\n338|\t\t\t\t\treturn nil, err\n339|\t\t\t\t}\n340|\t\t\t\tarray = append(array, member)\n341|\t\t\t}\n342|\t\t\tif _, err := decoder.Token(); err != nil {\n343|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n344|\t\t\t}\n345|\t\t\treturn array, nil\n346|\t\tdefault:\n347|\t\t\treturn nil, mismatchf(\"document syntax\")\n348|\t\t}\n349|\t}\n350|\treturn token, nil\n351|}\n352|\n353|// checkExactMembers refuses any deviation from the closed member set: an\n354|// unknown member and a missing member are both malformed.\n355|func checkExactMembers(object map[string]any, members []string) error {\n356|\tif len(object) != len(members) {\n357|\t\treturn mismatchf(\"document members\")\n358|\t}\n359|\tfor _, member := range members {\n360|\t\tif _, known := object[member]; !known {\n361|\t\t\treturn mismatchf(\"document members\")\n362|\t\t}\n363|\t}\n364|\treturn nil\n365|}\n366|\n367|// stringMember extracts a required string member. Numbers, booleans, nulls,\n368|// arrays, and objects are refused: no member of these schemas takes them.\n369|func stringMember(object map[string]any, name string) (string, error) {\n370|\tvalue, ok := object[name].(string)\n371|\tif !ok {\n372|\t\treturn \"\", mismatchf(\"document member type\")\n373|\t}\n374|\treturn value, nil\n375|}\n376|\n377|// boundedStringMember extracts a required string[1..256] measured in bytes\n378|// over valid UTF-8, the canonical bound in every containing contract.\n379|func boundedStringMember(object map[string]any, name string) (string, error) {\n380|\tvalue, err := stringMember(object, name)\n381|\tif err != nil {\n382|\t\treturn \"\", err\n383|\t}\n384|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxOpaqueString {\n385|\t\treturn \"\", mismatchf(\"document string bound\")\n386|\t}\n387|\treturn value, nil\n388|}\n389|\n390|// digestMember extracts a required sha256: digest member.\n391|func digestMember(object map[string]any, name string) (string, error) {\n392|\tvalue, err := stringMember(object, name)\n393|\tif err != nil {\n394|\t\treturn \"\", err\n395|\t}\n396|\tif _, err := scalar.ParseDigest(value); err != nil {\n397|\t\treturn \"\", mismatchf(\"document digest\")\n398|\t}\n399|\treturn value, nil\n400|}\n401|\n402|// digestOrNullMember extracts a digest|null member: present and either a\n403|// valid digest or JSON null. Absence is malformed, not null.\n404|func digestOrNullMember(object map[string]any, name string) (string, error) {\n405|\traw, known := object[name]\n406|\tif !known {\n407|\t\treturn \"\", mismatchf(\"document members\")\n408|\t}\n409|\tif raw == nil {\n410|\t\treturn \"\", nil\n411|\t}\n412|\tvalue, ok := raw.(string)\n413|\tif !ok {\n414|\t\treturn \"\", mismatchf(\"document member type\")\n415|\t}\n416|\tif _, err := scalar.ParseDigest(value); err != nil {\n417|\t\treturn \"\", mismatchf(\"document digest\")\n418|\t}\n419|\treturn value, nil\n420|}\n421|\n422|// semverMember extracts a required semver member.\n423|func semverMember(object map[string]any, name string) (string, error) {\n424|\tvalue, err := stringMember(object, name)\n425|\tif err != nil {\n426|\t\treturn \"\", err\n427|\t}\n428|\tif !semverPattern.MatchString(value) {\n429|\t\treturn \"\", mismatchf(\"document semver\")\n430|\t}\n431|\treturn value, nil\n432|}\n433|\n434|// timestampMember extracts a required timestamp member.\n435|func timestampMember(object map[string]any, name string) (scalar.Timestamp, error) {\n436|\tvalue, err := stringMember(object, name)\n437|\tif err != nil {\n438|\t\treturn scalar.Timestamp{}, err\n439|\t}\n440|\tparsed, err := scalar.ParseTimestamp(value)\n441|\tif err != nil {\n442|\t\treturn scalar.Timestamp{}, mismatchf(\"document timestamp\")\n443|\t}\n444|\treturn parsed, nil\n445|}\n446|\n447|// checkExtensions admits exactly the empty object {}. A non-empty extensions\n448|// object requires a later contract version, and absence is malformed.\n449|func checkExtensions(object map[string]any) error {\n450|\traw, known := object[\"extensions\"]\n451|\tif !known {\n452|\t\treturn mismatchf(\"document members\")\n453|\t}\n454|\textensions, ok := raw.(map[string]any)\n455|\tif !ok || len(extensions) != 0 {\n456|\t\treturn mismatchf(\"document extensions\")\n457|\t}\n458|\treturn nil\n459|}\n460|\n461|// stringArrayMember extracts a required array of strings, refusing numbers,\n462|// booleans, nulls, and nested values element-wise.\n463|func stringArrayMember(object map[string]any, name string) ([]string, error) {\n464|\traw, known := object[name]\n465|\tif !known {\n466|\t\treturn nil, mismatchf(\"document members\")\n467|\t}\n468|\tarray, ok := raw.([]any)\n469|\tif !ok {\n470|\t\treturn nil, mismatchf(\"document member type\")\n471|\t}\n472|\tvalues := make([]string, 0, len(array))\n473|\tfor _, member := range array {\n474|\t\tvalue, ok := member.(string)\n475|\t\tif !ok {\n476|\t\t\treturn nil, mismatchf(\"document member type\")\n477|\t\t}\n478|\t\tvalues = append(values, value)\n479|\t}\n480|\treturn values, nil\n481|}\n482|\n483|// checkSortedUnique refuses an unsorted or duplicated string list. Bytewise\n484|// order matches the wire's sorted-unique rule over lowercase ASCII members.\n485|func checkSortedUnique(values []string) error {\n486|\tfor index := range values {\n487|\t\tif index > 0 && values[index-1] >= values[index] {\n488|\t\t\treturn mismatchf(\"document ordering\")\n489|\t\t}\n490|\t}\n491|\treturn nil\n492|}\n493|\n494|// checkClosedList enforces the sorted-unique closed-vocabulary list shape:\n495|// every member in vocabulary, sorted unique, within the inclusive item\n496|// bound. The bound admits zero so [0..N] lists stay usable; [1..N] lists\n497|// are enforced by requiring at least one member.\n498|func checkClosedList(values []string, vocabulary map[string]bool, max int, requireNonEmpty bool) error {\n499|\tif len(values) > max || (requireNonEmpty && len(values) == 0) {\n500|\t\treturn mismatchf(\"document list bound\")\n501|\t}\n502|\tfor _, value := range values {\n503|\t\tif !vocabulary[value] {\n504|\t\t\treturn mismatchf(\"document vocabulary\")\n505|\t\t}\n506|\t}\n507|\treturn checkSortedUnique(values)\n508|}\n509|\n510|// objectIdentity computes the lowercase sha256: digest of the RFC 8785 JCS\n511|// bytes of object with exactly selfField omitted (§4.B identity rule). It\n512|// mirrors the repository's canonical pipeline (logical value, JSON\n513|// re-encode, JCS transform, SHA-256) without routing through the schema\n514|// validators owned by another task.\n515|func objectIdentity(object map[string]any, selfField string) (string, error) {\n516|\tomitted := make(map[string]any, len(object))\n517|\tfor name, member := range object {\n518|\t\tif name != selfField {\n519|\t\t\tomitted[name] = member\n520|\t\t}\n521|\t}\n522|\tserialized, err := json.Marshal(omitted)\n523|\tif err != nil {\n524|\t\treturn \"\", mismatchf(\"document identity\")\n525|\t}\n526|\tcanonical, err := jcs.Transform(serialized)\n527|\tif err != nil {\n528|\t\treturn \"\", mismatchf(\"document identity\")\n529|\t}\n530|\tsum := sha256.Sum256(canonical)\n531|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n532|}\n533|\n534|// checkIdentity recomputes the omit-self digest and refuses a mismatch. A\n535|// reader must recompute the ID before use; trusting the claimed member is a\n536|// substitution vector.\n537|func checkIdentity(object map[string]any, selfField, claimed string) error {\n538|\tif _, err := scalar.ParseDigest(claimed); err != nil {\n539|\t\treturn mismatchf(\"document digest\")\n540|\t}\n541|\tcomputed, err := objectIdentity(object, selfField)\n542|\tif err != nil {\n543|\t\treturn err\n544|\t}\n545|\tif computed != claimed {\n546|\t\treturn mismatchf(\"document identity binding\")\n547|\t}\n548|\treturn nil\n549|}\n550|\n551|// Claim is one TerminalBackendCapabilityClaim: a closed object whose\n552|// generation_variable, dependent_operations, and evidence_requirements\n553|// members must exactly equal the capability registry row (§4.D). A false\n554|// claim makes a probed refusal explicit but confers no operation.\n(more lines below)"}}}
