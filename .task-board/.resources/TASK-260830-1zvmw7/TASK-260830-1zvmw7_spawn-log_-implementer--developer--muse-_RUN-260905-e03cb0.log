{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca15","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":869,"recorded_at":1780531400001733,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"694e7143-57a9-4056-ae5a-cfc3453789ff"},"task_id":"694e7143-57a9-4056-ae5a-cfc3453789ff","event":{"kind":"output","task_id":"694e7143-57a9-4056-ae5a-cfc3453789ff","chunk":"Read text file `internal/terminalbackend/manifest_pin_test.go`.\n1|// White-box pins for reconciliation arms no document can deliver an input\n2|// to. Parse enforces registry-row equality for every claim (a Manifest or\n3|// Probe cannot redefine a row), so a drifted override or addition fails at\n4|// the document gate before Reconcile runs; likewise, same-ID\n5|// differing-bytes evidence cannot pass parsing because the ID is a hash of\n6|// the bytes. These arms are measured here, at the guard, with typed values\n7|// mutated after parsing, rather than left as prose; the reachability bound\n8|// is stated, not inferred.\n9|package terminalbackend\n10|\n11|import (\n12|\t\"encoding/json\"\n13|\t\"sort\"\n14|\t\"testing\"\n15|\t\"time\"\n16|)\n17|\n18|// pinVerifier accepts every attestation: signature validity is owned by the\n19|// black-box suite with real cryptography, and these pins must not depend\n20|// on it.\n21|func pinVerifier(issuerID string, message, signature []byte) error { return nil }\n22|\n23|// TestReconcileRefusesDriftedOverride pins the override registry-binding\n24|// arm: a probed override of a variable claim whose row members drift from\n25|// the manifest row is refused, even though Parse would already refuse the\n26|// document carrying it.\n27|func TestReconcileRefusesDriftedOverride(t *testing.T) {\n28|\tt.Parallel()\n29|\n30|\tmanifest, probe, evidence := validReconcileTriple(t)\n31|\tfor index := range probe.CapabilityClaims {\n32|\t\tif probe.CapabilityClaims[index].Capability == \"headless_creation\" {\n33|\t\t\tprobe.CapabilityClaims[index].DependentOperations = []string{\"create\", \"status\"}\n34|\t\t}\n35|\t}\n36|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsMismatch(err) {\n37|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n38|\t}\n39|}\n40|\n41|// TestReconcileRefusesDriftedAddition pins the addition registry-binding\n42|// arm: a probed addition whose row members drift from the closed registry\n43|// row is refused, even though Parse would already refuse the document.\n44|func TestReconcileRefusesDriftedAddition(t *testing.T) {\n45|\tt.Parallel()\n46|\n47|\tmanifest, probe, evidence := validReconcileTriple(t)\n48|\tfor index := range probe.CapabilityClaims {\n49|\t\tif probe.CapabilityClaims[index].Capability == \"graceful_stop\" {\n50|\t\t\tprobe.CapabilityClaims[index].EvidenceRequirements = []string{\"conformance_fixture\"}\n51|\t\t}\n52|\t}\n53|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsMismatch(err) {\n54|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n55|\t}\n56|}\n57|\n58|// TestReconcileRefusesConflictingEvidence pins the same-ID conflict arm:\n59|// two evidence objects sharing an ID but carrying different facts\n60|// invalidate the whole probe. This input cannot arrive through Parse\n61|// (identical IDs over different bytes fail the identity recomputation),\n62|// so it is constructed at the typed level.\n63|func TestReconcileRefusesConflictingEvidence(t *testing.T) {\n64|\tt.Parallel()\n65|\n66|\tmanifest, probe, evidence := validReconcileTriple(t)\n67|\ttwin := evidence[0]\n68|\ttwin.Facts = []string{\"fixture_passed\", \"runtime_probe_passed\", \"ui_absent\"}\n69|\tevidence = append(evidence, twin)\n70|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsMismatch(err) {\n71|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n72|\t}\n73|}\n74|\n75|// TestIdenticalDuplicateEvidenceDeduped pins the stated dedup bound: an\n76|// evidence object supplied twice byte-for-byte contributes its ID once and\n77|// admits. (Attestation signatures are deterministic for one key and\n78|// message, so identical documents are genuinely identical inputs, not two\n79|// observations.) Same-ID differing-bytes input stays refused above.\n80|func TestIdenticalDuplicateEvidenceDeduped(t *testing.T) {\n81|\tt.Parallel()\n82|\n83|\tmanifest, probe, evidence := validReconcileTriple(t)\n84|\tevidence = append(evidence, evidence[0], evidence[1])\n85|\tadmitted, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n88|\t}\n89|\tif len(admitted.EvidenceIDs) != 2 {\n90|\t\tt.Errorf(\"EvidenceIDs = %v, want 2 deduplicated IDs\", admitted.EvidenceIDs)\n91|\t}\n92|}\n93|\n94|// TestReconcileRefusesExecutableSubstitution pins the digest-identity arm:\n95|// a probe whose executable digest differs from the manifest member is\n96|// untrusted, even though both documents parse (each is valid against its\n97|// own kind rule). Parse cannot see across documents, so this arm is\n98|// reachable only here and in production admission.\n99|func TestReconcileRefusesExecutableSubstitution(t *testing.T) {\n100|\tt.Parallel()\n101|\n102|\tmanifest, probe, evidence := validExternalPinTriple(t)\n103|\tprobe.ExecutableDigest = testPinDigest(0xE6)\n104|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsUntrusted(err) {\n105|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_untrusted\", err)\n106|\t}\n107|}\n108|\n109|// validExternalPinTriple is the external-kind variant of the pin triple:\n110|// local_program with a digest, one static realm claim echoed by probe,\n111|// proven by realm evidence.\n112|func validExternalPinTriple(t *testing.T) (Manifest, Probe, []Evidence) {\n113|\tt.Helper()\n114|\n115|\tgeneration, err := GenerationDigest(\"generation-alpha\")\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n118|\t}\n119|\tdigest := testPinDigest(0xE5)\n120|\tfixture := testPinDigest(0xF1)\n121|\tissuer := testPinDigest(0x1D)\n122|\n123|\tmanifest := map[string]any{\n124|\t\t\"schema\":                 SchemaManifest,\n125|\t\t\"schema_version\":         SchemaVersion100,\n126|\t\t\"manifest_id\":            \"\",\n127|\t\t\"terminal_backend_id\":    \"example.term\",\n128|\t\t\"implementation_version\": \"2.1.0\",\n129|\t\t\"protocol_versions\":      []any{\"1.0.0\"},\n130|\t\t\"platforms\":              []any{\"linux\"},\n131|\t\t\"implementation_kind\":    \"local_program\",\n132|\t\t\"executable_digest\":      digest,\n133|\t\t\"static_capability_claims\": []any{\n134|\t\t\tpinRealmClaim(OriginStatic),\n135|\t\t},\n136|\t\t\"conformance_fixture_id\": fixture,\n137|\t\t\"extensions\":             map[string]any{},\n138|\t}\n139|\tevidenceObject := map[string]any{\n140|\t\t\"schema\":                     SchemaCapabilityEvidence,\n141|\t\t\"schema_version\":             SchemaVersion100,\n142|\t\t\"evidence_id\":                \"\",\n143|\t\t\"terminal_backend_id\":        \"example.term\",\n144|\t\t\"implementation_version\":     \"2.1.0\",\n145|\t\t\"protocol_version\":           \"1.0.0\",\n146|\t\t\"backend_generation_digest\":  generation,\n147|\t\t\"capability\":                 credentialRealmCapability,\n148|\t\t\"value\":                      true,\n149|\t\t\"platform\":                   \"linux\",\n150|\t\t\"os_version\":                 \"14.5\",\n151|\t\t\"conformance_fixture_id\":     fixture,\n152|\t\t\"observed_at\":                \"2025-06-01T00:00:00.000Z\",\n153|\t\t\"expires_at\":                 \"2027-06-01T00:00:00.000Z\",\n154|\t\t\"issuer\":                     IssuerLocalProbe,\n155|\t\t\"issuer_id\":                  issuer,\n156|\t\t\"attestation_signature\":      \"rsa-sha256:AA==\",\n157|\t\t\"facts\":                      []any{\"fixture_passed\", \"provider_auth_passed\", \"runtime_probe_passed\", \"sentinel_passed\"},\n158|\t\t\"terminal_binding_id\":        digest,\n159|\t\t\"provider_id\":                \"codex\",\n160|\t\t\"provider_build\":             \"1.2.3\",\n161|\t\t\"sentinel_result\":            \"passed\",\n162|\t\t\"provider_auth_smoke_result\": \"passed\",\n163|\t\t\"extensions\":                 map[string]any{},\n164|\t}\n165|\tstampPinIdentity(t, evidenceObject, \"evidence_id\")\n166|\tparsedEvidence, err := ParseEvidence(mustPinJSON(t, evidenceObject))\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"ParseEvidence() error = %v\", err)\n169|\t}\n170|\tprobe := map[string]any{\n171|\t\t\"schema\":                    SchemaProbe,\n172|\t\t\"schema_version\":            SchemaVersion100,\n173|\t\t\"probe_id\":                  \"\",\n174|\t\t\"terminal_backend_id\":       \"example.term\",\n175|\t\t\"implementation_version\":    \"2.1.0\",\n176|\t\t\"protocol_version\":          \"1.0.0\",\n177|\t\t\"implementation_kind\":       \"local_program\",\n178|\t\t\"executable_digest\":         digest,\n179|\t\t\"platform\":                  \"linux\",\n180|\t\t\"os_version\":                \"14.5\",\n181|\t\t\"availability\":              AvailabilityAvailable,\n182|\t\t\"backend_generation_digest\": generation,\n183|\t\t\"capability_claims\": []any{\n184|\t\t\tpinRealmClaim(OriginProbed),\n185|\t\t},\n186|\t\t\"evidence_ids\": []any{parsedEvidence.EvidenceID},\n187|\t\t\"probed_at\":    \"2026-01-15T12:00:00.000Z\",\n188|\t\t\"extensions\":   map[string]any{},\n189|\t}\n190|\tstampPinIdentity(t, manifest, \"manifest_id\")\n191|\tstampPinIdentity(t, probe, \"probe_id\")\n192|\tparsedManifest, err := ParseManifest(mustPinJSON(t, manifest))\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n195|\t}\n196|\tparsedProbe, err := ParseProbe(mustPinJSON(t, probe))\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n199|\t}\n200|\treturn parsedManifest, parsedProbe, []Evidence{parsedEvidence}\n201|}\n202|\n203|// pinRealmClaim returns one credential-realm claim map.\n204|func pinRealmClaim(origin string) map[string]any {\n205|\treturn map[string]any{\n206|\t\t\"capability\":            credentialRealmCapability,\n207|\t\t\"origin\":                origin,\n208|\t\t\"value\":                 true,\n209|\t\t\"generation_variable\":   true,\n210|\t\t\"dependent_operations\":  []any{\"create\", \"restore\"},\n211|\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\"},\n212|\t}\n213|}\n214|\n215|// TestReconcileAdmitsPinTriple proves the unmutated white-box triple is\n216|// coherent: the pins above fail on their mutation, not on a broken base.\n217|func TestReconcileAdmitsPinTriple(t *testing.T) {\n218|\tt.Parallel()\n219|\n220|\tmanifest, probe, evidence := validReconcileTriple(t)\n221|\tadmitted, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier)\n222|\tif err != nil {\n223|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n224|\t}\n225|\tif len(admitted.Capabilities) != 2 || !admitted.Has(\"graceful_stop\") || !admitted.Has(\"headless_creation\") {\n226|\t\tt.Errorf(\"Admitted = %v, want graceful_stop and headless_creation\", admitted.Capabilities)\n227|\t}\n228|}\n229|\n230|// validReconcileTriple parses one coherent triple: a manifest with one\n231|// static claim, a probe with a same-value override plus one probed\n232|// addition, and the two evidences proving the true claims.\n233|func validReconcileTriple(t *testing.T) (Manifest, Probe, []Evidence) {\n234|\tt.Helper()\n235|\n236|\tgeneration, err := GenerationDigest(\"generation-alpha\")\n237|\tif err != nil {\n238|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n239|\t}\n240|\tfixture := testPinDigest(0xF1)\n241|\tissuer := testPinDigest(0x1D)\n242|\n243|\tmanifest := pinManifest(fixture)\n244|\tevidenceMaps := []map[string]any{\n245|\t\tpinEvidence(\"graceful_stop\", generation, fixture, issuer),\n246|\t\tpinEvidence(\"headless_creation\", generation, fixture, issuer),\n247|\t}\n248|\tparsedEvidence := make([]Evidence, 0, len(evidenceMaps))\n249|\tvar ids []string\n250|\tfor _, object := range evidenceMaps {\n251|\t\tstampPinIdentity(t, object, \"evidence_id\")\n252|\t\tparsed, err := ParseEvidence(mustPinJSON(t, object))\n253|\t\tif err != nil {\n254|\t\t\tt.Fatalf(\"ParseEvidence() error = %v\", err)\n255|\t\t}\n256|\t\tparsedEvidence = append(parsedEvidence, parsed)\n257|\t\tids = append(ids, parsed.EvidenceID)\n258|\t}\n259|\tsort.Strings(ids)\n260|\n261|\tprobe := pinProbe(generation, ids)\n262|\tstampPinIdentity(t, manifest, \"manifest_id\")\n263|\tstampPinIdentity(t, probe, \"probe_id\")\n264|\tparsedManifest, err := ParseManifest(mustPinJSON(t, manifest))\n265|\tif err != nil {\n266|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n267|\t}\n268|\tparsedProbe, err := ParseProbe(mustPinJSON(t, probe))\n269|\tif err != nil {\n270|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n271|\t}\n272|\treturn parsedManifest, parsedProbe, parsedEvidence\n273|}\n274|\n275|// pinManifest returns the white-box manifest document map with a blank ID.\n276|func pinManifest(fixture string) map[string]any {\n277|\treturn map[string]any{\n278|\t\t\"schema\":                 SchemaManifest,\n279|\t\t\"schema_version\":         SchemaVersion100,\n280|\t\t\"manifest_id\":            \"\",\n281|\t\t\"terminal_backend_id\":    \"example.term\",\n282|\t\t\"implementation_version\": \"2.1.0\",\n283|\t\t\"protocol_versions\":      []any{\"1.0.0\"},\n284|\t\t\"platforms\":              []any{\"linux\"},\n285|\t\t\"implementation_kind\":    \"builtin_go\",\n286|\t\t\"executable_digest\":      nil,\n287|\t\t\"static_capability_claims\": []any{\n288|\t\t\tpinClaim(\"headless_creation\", OriginStatic, true),\n289|\t\t},\n290|\t\t\"conformance_fixture_id\": fixture,\n291|\t\t\"extensions\":             map[string]any{},\n292|\t}\n293|}\n294|\n295|// pinProbe returns the white-box probe document map with a blank ID.\n296|func pinProbe(generation string, ids []string) map[string]any {\n297|\tasValues := make([]any, 0, len(ids))\n298|\tfor _, id := range ids {\n299|\t\tasValues = append(asValues, id)\n300|\t}\n301|\treturn map[string]any{\n302|\t\t\"schema\":                    SchemaProbe,\n303|\t\t\"schema_version\":            SchemaVersion100,\n304|\t\t\"probe_id\":                  \"\",\n305|\t\t\"terminal_backend_id\":       \"example.term\",\n306|\t\t\"implementation_version\":    \"2.1.0\",\n307|\t\t\"protocol_version\":          \"1.0.0\",\n308|\t\t\"implementation_kind\":       \"builtin_go\",\n309|\t\t\"executable_digest\":         nil,\n310|\t\t\"platform\":                  \"linux\",\n311|\t\t\"os_version\":                \"14.5\",\n312|\t\t\"availability\":              AvailabilityAvailable,\n313|\t\t\"backend_generation_digest\": generation,\n314|\t\t\"capability_claims\": []any{\n315|\t\t\tpinClaim(\"graceful_stop\", OriginProbed, true),\n316|\t\t\tpinClaim(\"headless_creation\", OriginProbed, true),\n317|\t\t},\n318|\t\t\"evidence_ids\": asValues,\n319|\t\t\"probed_at\":    \"2026-01-15T12:00:00.000Z\",\n320|\t\t\"extensions\":   map[string]any{},\n321|\t}\n322|}\n323|\n324|// pinEvidence returns one white-box evidence document map with a blank ID\n325|// and a placeholder signature the pin verifier accepts unconditionally.\n326|func pinEvidence(capability, generation, fixture, issuer string) map[string]any {\n327|\treturn map[string]any{\n328|\t\t\"schema\":                     SchemaCapabilityEvidence,\n329|\t\t\"schema_version\":             SchemaVersion100,\n330|\t\t\"evidence_id\":                \"\",\n331|\t\t\"terminal_backend_id\":        \"example.term\",\n332|\t\t\"implementation_version\":     \"2.1.0\",\n333|\t\t\"protocol_version\":           \"1.0.0\",\n334|\t\t\"backend_generation_digest\":  generation,\n335|\t\t\"capability\":                 capability,\n336|\t\t\"value\":                      true,\n337|\t\t\"platform\":                   \"linux\",\n338|\t\t\"os_version\":                 \"14.5\",\n339|\t\t\"conformance_fixture_id\":     fixture,\n340|\t\t\"observed_at\":                \"2025-06-01T00:00:00.000Z\",\n341|\t\t\"expires_at\":                 \"2027-06-01T00:00:00.000Z\",\n342|\t\t\"issuer\":                     IssuerLocalProbe,\n343|\t\t\"issuer_id\":                  issuer,\n344|\t\t\"attestation_signature\":      \"rsa-sha256:AA==\",\n345|\t\t\"facts\":                      []any{\"fixture_passed\", \"runtime_probe_passed\"},\n346|\t\t\"terminal_binding_id\":        nil,\n347|\t\t\"provider_id\":                nil,\n348|\t\t\"provider_build\":             nil,\n349|\t\t\"sentinel_result\":            nil,\n350|\t\t\"provider_auth_smoke_result\": nil,\n351|\t\t\"extensions\":                 map[string]any{},\n352|\t}\n353|}\n354|\n355|// pinClaim returns one white-box claim map with exact registry-row members.\n356|func pinClaim(capability, origin string, value bool) map[string]any {\n357|\trows := map[string]map[string]any{\n358|\t\t\"headless_creation\": {\n359|\t\t\t\"generation_variable\":   true,\n360|\t\t\t\"dependent_operations\":  []any{\"create\"},\n361|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n362|\t\t},\n363|\t\t\"graceful_stop\": {\n364|\t\t\t\"generation_variable\":   true,\n365|\t\t\t\"dependent_operations\":  []any{\"request-stop\"},\n366|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n367|\t\t},\n368|\t}\n369|\trow := rows[capability]\n370|\treturn map[string]any{\n371|\t\t\"capability\":            capability,\n372|\t\t\"origin\":                origin,\n373|\t\t\"value\":                 value,\n374|\t\t\"generation_variable\":   row[\"generation_variable\"],\n375|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n376|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n377|\t}\n378|}\n379|\n380|// stampPinIdentity stamps the recomputed omit-self identity on a document.\n381|func stampPinIdentity(t *testing.T, object map[string]any, selfField string) {\n382|\tt.Helper()\n383|\n384|\tidentity, err := objectIdentity(object, selfField)\n385|\tif err != nil {\n386|\t\tt.Fatalf(\"objectIdentity() error = %v\", err)\n387|\t}\n388|\tobject[selfField] = identity\n389|}\n390|\n391|// mustPinJSON encodes a fixture map to JSON bytes.\n392|func mustPinJSON(t *testing.T, object map[string]any) []byte {\n393|\tt.Helper()\n394|\n395|\traw, err := json.Marshal(object)\n396|\tif err != nil {\n397|\t\tt.Fatalf(\"marshal fixture: %v\", err)\n398|\t}\n399|\treturn raw\n400|}\n401|\n402|// testPinDigest mints a deterministic fake digest for white-box fixtures.\n403|func testPinDigest(seed byte) string {\n404|\tconst hexdigits = \"0123456789abcdef\"\n405|\tvar digits [64]byte\n406|\tfor index := range digits {\n407|\t\tdigits[index] = hexdigits[(int(seed)+index)%16]\n408|\t}\n409|\treturn \"sha256:\" + string(digits[:])\n410|}\n411|\n412|// testAdmissionTime is the fixed admission instant for white-box pins.\n413|func testAdmissionTime() time.Time {\n414|\treturn time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC)\n415|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca17","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":870,"recorded_at":1780531400001735,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"694e7143-57a9-4056-ae5a-cfc3453789ff"},"task_id":"694e7143-57a9-4056-ae5a-cfc3453789ff","event":{"kind":"completed","task_id":"694e7143-57a9-4056-ae5a-cfc3453789ff"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca19","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":871,"recorded_at":1780531400001737,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"call_id":"call_01a06ee7ecff7380aa2a185b54e264ee","text":"Read text file `internal/terminalbackend/manifest_pin_test.go`.\n1|// White-box pins for reconciliation arms no document can deliver an input\n2|// to. Parse enforces registry-row equality for every claim (a Manifest or\n3|// Probe cannot redefine a row), so a drifted override or addition fails at\n4|// the document gate before Reconcile runs; likewise, same-ID\n5|// differing-bytes evidence cannot pass parsing because the ID is a hash of\n6|// the bytes. These arms are measured here, at the guard, with typed values\n7|// mutated after parsing, rather than left as prose; the reachability bound\n8|// is stated, not inferred.\n9|package terminalbackend\n10|\n11|import (\n12|\t\"encoding/json\"\n13|\t\"sort\"\n14|\t\"testing\"\n15|\t\"time\"\n16|)\n17|\n18|// pinVerifier accepts every attestation: signature validity is owned by the\n19|// black-box suite with real cryptography, and these pins must not depend\n20|// on it.\n21|func pinVerifier(issuerID string, message, signature []byte) error { return nil }\n22|\n23|// TestReconcileRefusesDriftedOverride pins the override registry-binding\n24|// arm: a probed override of a variable claim whose row members drift from\n25|// the manifest row is refused, even though Parse would already refuse the\n26|// document carrying it.\n27|func TestReconcileRefusesDriftedOverride(t *testing.T) {\n28|\tt.Parallel()\n29|\n30|\tmanifest, probe, evidence := validReconcileTriple(t)\n31|\tfor index := range probe.CapabilityClaims {\n32|\t\tif probe.CapabilityClaims[index].Capability == \"headless_creation\" {\n33|\t\t\tprobe.CapabilityClaims[index].DependentOperations = []string{\"create\", \"status\"}\n34|\t\t}\n35|\t}\n36|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsMismatch(err) {\n37|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n38|\t}\n39|}\n40|\n41|// TestReconcileRefusesDriftedAddition pins the addition registry-binding\n42|// arm: a probed addition whose row members drift from the closed registry\n43|// row is refused, even though Parse would already refuse the document.\n44|func TestReconcileRefusesDriftedAddition(t *testing.T) {\n45|\tt.Parallel()\n46|\n47|\tmanifest, probe, evidence := validReconcileTriple(t)\n48|\tfor index := range probe.CapabilityClaims {\n49|\t\tif probe.CapabilityClaims[index].Capability == \"graceful_stop\" {\n50|\t\t\tprobe.CapabilityClaims[index].EvidenceRequirements = []string{\"conformance_fixture\"}\n51|\t\t}\n52|\t}\n53|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsMismatch(err) {\n54|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n55|\t}\n56|}\n57|\n58|// TestReconcileRefusesConflictingEvidence pins the same-ID conflict arm:\n59|// two evidence objects sharing an ID but carrying different facts\n60|// invalidate the whole probe. This input cannot arrive through Parse\n61|// (identical IDs over different bytes fail the identity recomputation),\n62|// so it is constructed at the typed level.\n63|func TestReconcileRefusesConflictingEvidence(t *testing.T) {\n64|\tt.Parallel()\n65|\n66|\tmanifest, probe, evidence := validReconcileTriple(t)\n67|\ttwin := evidence[0]\n68|\ttwin.Facts = []string{\"fixture_passed\", \"runtime_probe_passed\", \"ui_absent\"}\n69|\tevidence = append(evidence, twin)\n70|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsMismatch(err) {\n71|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n72|\t}\n73|}\n74|\n75|// TestIdenticalDuplicateEvidenceDeduped pins the stated dedup bound: an\n76|// evidence object supplied twice byte-for-byte contributes its ID once and\n77|// admits. (Attestation signatures are deterministic for one key and\n78|// message, so identical documents are genuinely identical inputs, not two\n79|// observations.) Same-ID differing-bytes input stays refused above.\n80|func TestIdenticalDuplicateEvidenceDeduped(t *testing.T) {\n81|\tt.Parallel()\n82|\n83|\tmanifest, probe, evidence := validReconcileTriple(t)\n84|\tevidence = append(evidence, evidence[0], evidence[1])\n85|\tadmitted, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n88|\t}\n89|\tif len(admitted.EvidenceIDs) != 2 {\n90|\t\tt.Errorf(\"EvidenceIDs = %v, want 2 deduplicated IDs\", admitted.EvidenceIDs)\n91|\t}\n92|}\n93|\n94|// TestReconcileRefusesExecutableSubstitution pins the digest-identity arm:\n95|// a probe whose executable digest differs from the manifest member is\n96|// untrusted, even though both documents parse (each is valid against its\n97|// own kind rule). Parse cannot see across documents, so this arm is\n98|// reachable only here and in production admission.\n99|func TestReconcileRefusesExecutableSubstitution(t *testing.T) {\n100|\tt.Parallel()\n101|\n102|\tmanifest, probe, evidence := validExternalPinTriple(t)\n103|\tprobe.ExecutableDigest = testPinDigest(0xE6)\n104|\tif _, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier); !IsUntrusted(err) {\n105|\t\tt.Errorf(\"Reconcile() error = %v, want terminal_backend_untrusted\", err)\n106|\t}\n107|}\n108|\n109|// validExternalPinTriple is the external-kind variant of the pin triple:\n110|// local_program with a digest, one static realm claim echoed by probe,\n111|// proven by realm evidence.\n112|func validExternalPinTriple(t *testing.T) (Manifest, Probe, []Evidence) {\n113|\tt.Helper()\n114|\n115|\tgeneration, err := GenerationDigest(\"generation-alpha\")\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n118|\t}\n119|\tdigest := testPinDigest(0xE5)\n120|\tfixture := testPinDigest(0xF1)\n121|\tissuer := testPinDigest(0x1D)\n122|\n123|\tmanifest := map[string]any{\n124|\t\t\"schema\":                 SchemaManifest,\n125|\t\t\"schema_version\":         SchemaVersion100,\n126|\t\t\"manifest_id\":            \"\",\n127|\t\t\"terminal_backend_id\":    \"example.term\",\n128|\t\t\"implementation_version\": \"2.1.0\",\n129|\t\t\"protocol_versions\":      []any{\"1.0.0\"},\n130|\t\t\"platforms\":              []any{\"linux\"},\n131|\t\t\"implementation_kind\":    \"local_program\",\n132|\t\t\"executable_digest\":      digest,\n133|\t\t\"static_capability_claims\": []any{\n134|\t\t\tpinRealmClaim(OriginStatic),\n135|\t\t},\n136|\t\t\"conformance_fixture_id\": fixture,\n137|\t\t\"extensions\":             map[string]any{},\n138|\t}\n139|\tevidenceObject := map[string]any{\n140|\t\t\"schema\":                     SchemaCapabilityEvidence,\n141|\t\t\"schema_version\":             SchemaVersion100,\n142|\t\t\"evidence_id\":                \"\",\n143|\t\t\"terminal_backend_id\":        \"example.term\",\n144|\t\t\"implementation_version\":     \"2.1.0\",\n145|\t\t\"protocol_version\":           \"1.0.0\",\n146|\t\t\"backend_generation_digest\":  generation,\n147|\t\t\"capability\":                 credentialRealmCapability,\n148|\t\t\"value\":                      true,\n149|\t\t\"platform\":                   \"linux\",\n150|\t\t\"os_version\":                 \"14.5\",\n151|\t\t\"conformance_fixture_id\":     fixture,\n152|\t\t\"observed_at\":                \"2025-06-01T00:00:00.000Z\",\n153|\t\t\"expires_at\":                 \"2027-06-01T00:00:00.000Z\",\n154|\t\t\"issuer\":                     IssuerLocalProbe,\n155|\t\t\"issuer_id\":                  issuer,\n156|\t\t\"attestation_signature\":      \"rsa-sha256:AA==\",\n157|\t\t\"facts\":                      []any{\"fixture_passed\", \"provider_auth_passed\", \"runtime_probe_passed\", \"sentinel_passed\"},\n158|\t\t\"terminal_binding_id\":        digest,\n159|\t\t\"provider_id\":                \"codex\",\n160|\t\t\"provider_build\":             \"1.2.3\",\n161|\t\t\"sentinel_result\":            \"passed\",\n162|\t\t\"provider_auth_smoke_result\": \"passed\",\n163|\t\t\"extensions\":                 map[string]any{},\n164|\t}\n165|\tstampPinIdentity(t, evidenceObject, \"evidence_id\")\n166|\tparsedEvidence, err := ParseEvidence(mustPinJSON(t, evidenceObject))\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"ParseEvidence() error = %v\", err)\n169|\t}\n170|\tprobe := map[string]any{\n171|\t\t\"schema\":                    SchemaProbe,\n172|\t\t\"schema_version\":            SchemaVersion100,\n173|\t\t\"probe_id\":                  \"\",\n174|\t\t\"terminal_backend_id\":       \"example.term\",\n175|\t\t\"implementation_version\":    \"2.1.0\",\n176|\t\t\"protocol_version\":          \"1.0.0\",\n177|\t\t\"implementation_kind\":       \"local_program\",\n178|\t\t\"executable_digest\":         digest,\n179|\t\t\"platform\":                  \"linux\",\n180|\t\t\"os_version\":                \"14.5\",\n181|\t\t\"availability\":              AvailabilityAvailable,\n182|\t\t\"backend_generation_digest\": generation,\n183|\t\t\"capability_claims\": []any{\n184|\t\t\tpinRealmClaim(OriginProbed),\n185|\t\t},\n186|\t\t\"evidence_ids\": []any{parsedEvidence.EvidenceID},\n187|\t\t\"probed_at\":    \"2026-01-15T12:00:00.000Z\",\n188|\t\t\"extensions\":   map[string]any{},\n189|\t}\n190|\tstampPinIdentity(t, manifest, \"manifest_id\")\n191|\tstampPinIdentity(t, probe, \"probe_id\")\n192|\tparsedManifest, err := ParseManifest(mustPinJSON(t, manifest))\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n195|\t}\n196|\tparsedProbe, err := ParseProbe(mustPinJSON(t, probe))\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n199|\t}\n200|\treturn parsedManifest, parsedProbe, []Evidence{parsedEvidence}\n201|}\n202|\n203|// pinRealmClaim returns one credential-realm claim map.\n204|func pinRealmClaim(origin string) map[string]any {\n205|\treturn map[string]any{\n206|\t\t\"capability\":            credentialRealmCapability,\n207|\t\t\"origin\":                origin,\n208|\t\t\"value\":                 true,\n209|\t\t\"generation_variable\":   true,\n210|\t\t\"dependent_operations\":  []any{\"create\", \"restore\"},\n211|\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\"},\n212|\t}\n213|}\n214|\n215|// TestReconcileAdmitsPinTriple proves the unmutated white-box triple is\n216|// coherent: the pins above fail on their mutation, not on a broken base.\n217|func TestReconcileAdmitsPinTriple(t *testing.T) {\n218|\tt.Parallel()\n219|\n220|\tmanifest, probe, evidence := validReconcileTriple(t)\n221|\tadmitted, err := Reconcile(manifest, probe, evidence, \"generation-alpha\", testAdmissionTime(), pinVerifier)\n222|\tif err != nil {\n223|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n224|\t}\n225|\tif len(admitted.Capabilities) != 2 || !admitted.Has(\"graceful_stop\") || !admitted.Has(\"headless_creation\") {\n226|\t\tt.Errorf(\"Admitted = %v, want graceful_stop and headless_creation\", admitted.Capabilities)\n227|\t}\n228|}\n229|\n230|// validReconcileTriple parses one coherent triple: a manifest with one\n231|// static claim, a probe with a same-value override plus one probed\n232|// addition, and the two evidences proving the true claims.\n233|func validReconcileTriple(t *testing.T) (Manifest, Probe, []Evidence) {\n234|\tt.Helper()\n235|\n236|\tgeneration, err := GenerationDigest(\"generation-alpha\")\n237|\tif err != nil {\n238|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n239|\t}\n240|\tfixture := testPinDigest(0xF1)\n241|\tissuer := testPinDigest(0x1D)\n242|\n243|\tmanifest := pinManifest(fixture)\n244|\tevidenceMaps := []map[string]any{\n245|\t\tpinEvidence(\"graceful_stop\", generation, fixture, issuer),\n246|\t\tpinEvidence(\"headless_creation\", generation, fixture, issuer),\n247|\t}\n248|\tparsedEvidence := make([]Evidence, 0, len(evidenceMaps))\n249|\tvar ids []string\n250|\tfor _, object := range evidenceMaps {\n251|\t\tstampPinIdentity(t, object, \"evidence_id\")\n252|\t\tparsed, err := ParseEvidence(mustPinJSON(t, object))\n253|\t\tif err != nil {\n254|\t\t\tt.Fatalf(\"ParseEvidence() error = %v\", err)\n255|\t\t}\n256|\t\tparsedEvidence = append(parsedEvidence, parsed)\n257|\t\tids = append(ids, parsed.EvidenceID)\n258|\t}\n259|\tsort.Strings(ids)\n260|\n261|\tprobe := pinProbe(generation, ids)\n262|\tstampPinIdentity(t, manifest, \"manifest_id\")\n263|\tstampPinIdentity(t, probe, \"probe_id\")\n264|\tparsedManifest, err := ParseManifest(mustPinJSON(t, manifest))\n265|\tif err != nil {\n266|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n267|\t}\n268|\tparsedProbe, err := ParseProbe(mustPinJSON(t, probe))\n269|\tif err != nil {\n270|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n271|\t}\n272|\treturn parsedManifest, parsedProbe, parsedEvidence\n273|}\n274|\n275|// pinManifest returns the white-box manifest document map with a blank ID.\n276|func pinManifest(fixture string) map[string]any {\n277|\treturn map[string]any{\n278|\t\t\"schema\":                 SchemaManifest,\n279|\t\t\"schema_version\":         SchemaVersion100,\n280|\t\t\"manifest_id\":            \"\",\n281|\t\t\"terminal_backend_id\":    \"example.term\",\n282|\t\t\"implementation_version\": \"2.1.0\",\n283|\t\t\"protocol_versions\":      []any{\"1.0.0\"},\n284|\t\t\"platforms\":              []any{\"linux\"},\n285|\t\t\"implementation_kind\":    \"builtin_go\",\n286|\t\t\"executable_digest\":      nil,\n287|\t\t\"static_capability_claims\": []any{\n288|\t\t\tpinClaim(\"headless_creation\", OriginStatic, true),\n289|\t\t},\n290|\t\t\"conformance_fixture_id\": fixture,\n291|\t\t\"extensions\":             map[string]any{},\n292|\t}\n293|}\n294|\n295|// pinProbe returns the white-box probe document map with a blank ID.\n296|func pinProbe(generation string, ids []string) map[string]any {\n297|\tasValues := make([]any, 0, len(ids))\n298|\tfor _, id := range ids {\n299|\t\tasValues = append(asValues, id)\n300|\t}\n301|\treturn map[string]any{\n302|\t\t\"schema\":                    SchemaProbe,\n303|\t\t\"schema_version\":            SchemaVersion100,\n304|\t\t\"probe_id\":                  \"\",\n305|\t\t\"terminal_backend_id\":       \"example.term\",\n306|\t\t\"implementation_version\":    \"2.1.0\",\n307|\t\t\"protocol_version\":          \"1.0.0\",\n308|\t\t\"implementation_kind\":       \"builtin_go\",\n309|\t\t\"executable_digest\":         nil,\n310|\t\t\"platform\":                  \"linux\",\n311|\t\t\"os_version\":                \"14.5\",\n312|\t\t\"availability\":              AvailabilityAvailable,\n313|\t\t\"backend_generation_digest\": generation,\n314|\t\t\"capability_claims\": []any{\n315|\t\t\tpinClaim(\"graceful_stop\", OriginProbed, true),\n316|\t\t\tpinClaim(\"headless_creation\", OriginProbed, true),\n317|\t\t},\n318|\t\t\"evidence_ids\": asValues,\n319|\t\t\"probed_at\":    \"2026-01-15T12:00:00.000Z\",\n320|\t\t\"extensions\":   map[string]any{},\n321|\t}\n322|}\n323|\n324|// pinEvidence returns one white-box evidence document map with a blank ID\n325|// and a placeholder signature the pin verifier accepts unconditionally.\n326|func pinEvidence(capability, generation, fixture, issuer string) map[string]any {\n327|\treturn map[string]any{\n328|\t\t\"schema\":                     SchemaCapabilityEvidence,\n329|\t\t\"schema_version\":             SchemaVersion100,\n330|\t\t\"evidence_id\":                \"\",\n331|\t\t\"terminal_backend_id\":        \"example.term\",\n332|\t\t\"implementation_version\":     \"2.1.0\",\n333|\t\t\"protocol_version\":           \"1.0.0\",\n334|\t\t\"backend_generation_digest\":  generation,\n335|\t\t\"capability\":                 capability,\n336|\t\t\"value\":                      true,\n337|\t\t\"platform\":                   \"linux\",\n338|\t\t\"os_version\":                 \"14.5\",\n339|\t\t\"conformance_fixture_id\":     fixture,\n340|\t\t\"observed_at\":                \"2025-06-01T00:00:00.000Z\",\n341|\t\t\"expires_at\":                 \"2027-06-01T00:00:00.000Z\",\n342|\t\t\"issuer\":                     IssuerLocalProbe,\n343|\t\t\"issuer_id\":                  issuer,\n344|\t\t\"attestation_signature\":      \"rsa-sha256:AA==\",\n345|\t\t\"facts\":                      []any{\"fixture_passed\", \"runtime_probe_passed\"},\n346|\t\t\"terminal_binding_id\":        nil,\n347|\t\t\"provider_id\":                nil,\n348|\t\t\"provider_build\":             nil,\n349|\t\t\"sentinel_result\":            nil,\n350|\t\t\"provider_auth_smoke_result\": nil,\n351|\t\t\"extensions\":                 map[string]any{},\n352|\t}\n353|}\n354|\n355|// pinClaim returns one white-box claim map with exact registry-row members.\n356|func pinClaim(capability, origin string, value bool) map[string]any {\n357|\trows := map[string]map[string]any{\n358|\t\t\"headless_creation\": {\n359|\t\t\t\"generation_variable\":   true,\n360|\t\t\t\"dependent_operations\":  []any{\"create\"},\n361|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n362|\t\t},\n363|\t\t\"graceful_stop\": {\n364|\t\t\t\"generation_variable\":   true,\n365|\t\t\t\"dependent_operations\":  []any{\"request-stop\"},\n366|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n367|\t\t},\n368|\t}\n369|\trow := rows[capability]\n370|\treturn map[string]any{\n371|\t\t\"capability\":            capability,\n372|\t\t\"origin\":                origin,\n373|\t\t\"value\":                 value,\n374|\t\t\"generation_variable\":   row[\"generation_variable\"],\n375|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n376|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n377|\t}\n378|}\n379|\n380|// stampPinIdentity stamps the recomputed omit-self identity on a document.\n381|func stampPinIdentity(t *testing.T, object map[string]any, selfField string) {\n382|\tt.Helper()\n383|\n384|\tidentity, err := objectIdentity(object, selfField)\n385|\tif err != nil {\n386|\t\tt.Fatalf(\"objectIdentity() error = %v\", err)\n387|\t}\n388|\tobject[selfField] = identity\n389|}\n390|\n391|// mustPinJSON encodes a fixture map to JSON bytes.\n392|func mustPinJSON(t *testing.T, object map[string]any) []byte {\n393|\tt.Helper()\n394|\n395|\traw, err := json.Marshal(object)\n396|\tif err != nil {\n397|\t\tt.Fatalf(\"marshal fixture: %v\", err)\n398|\t}\n399|\treturn raw\n400|}\n401|\n402|// testPinDigest mints a deterministic fake digest for white-box fixtures.\n403|func testPinDigest(seed byte) string {\n404|\tconst hexdigits = \"0123456789abcdef\"\n405|\tvar digits [64]byte\n406|\tfor index := range digits {\n407|\t\tdigits[index] = hexdigits[(int(seed)+index)%16]\n408|\t}\n409|\treturn \"sha256:\" + string(digits[:])\n410|}\n411|\n412|// testAdmissionTime is the fixed admission instant for white-box pins.\n413|func testAdmissionTime() time.Time {\n414|\treturn time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC)\n415|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
