me_probe\":        \"runtime_probe_passed\",\n224|\t\"credential_sentinel\":  \"sentinel_passed\",\n225|\t\"provider_auth_smoke\":  \"provider_auth_passed\",\n226|\t\"policy_authorization\": \"policy_checked\",\n227|}\n228|\n229|// Closed TerminalBackendOperation vocabulary (§4.D).\n230|var operationVocabulary = map[string]bool{\n231|\t\"manifest\": true, \"probe\": true, \"create\": true, \"attach\": true,\n232|\t\"status\": true, \"quiesce-input\": true, \"wait-safe-boundary\": true,\n233|\t\"request-stop\": true, \"terminate-stale\": true, \"restore\": true,\n234|}\n235|\n236|// Closed CapabilityEvidenceRequirement vocabulary (§4.D).\n237|var evidenceRequirementVocabulary = map[string]bool{\n238|\t\"conformance_fixture\": true, \"runtime_probe\": true,\n239|\t\"credential_sentinel\": true, \"provider_auth_smoke\": true,\n240|\t\"policy_authorization\": true,\n241|}\n242|\n243|// Closed CapabilityEvidenceFact vocabulary (§4.D).\n244|var evidenceFactVocabulary = map[string]bool{\n245|\t\"fixture_passed\": true, \"runtime_probe_passed\": true,\n246|\t\"sentinel_passed\": true, \"provider_auth_passed\": true,\n247|\t\"policy_checked\": true, \"ui_absent\": true, \"prompt_absent\": true,\n248|}\n249|\n250|// Document bounds shared by the three closed schemas.\n251|const (\n252|\tmaxClaims          = 16\n253|\tmaxEvidenceIDs     = 256\n254|\tmaxOperations      = 10\n255|\tmaxRequirements    = 5\n256|\tmaxFacts           = 7\n257|\tmaxOpaqueString    = 256\n258|\tmaxJSONDepth       = 32\n259|\tmaxNativeReference = 512\n260|)\n261|\n262|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n263|// must never interpolate local data: paths, digests, generations, and\n264|// document bytes stay out of errors.\n(more lines below)"}}}
