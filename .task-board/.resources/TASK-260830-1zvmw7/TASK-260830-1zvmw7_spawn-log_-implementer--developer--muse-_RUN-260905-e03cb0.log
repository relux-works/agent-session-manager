\t// A distinct usable object (supplementary fact changes\n962|\t\t\t\t// the bytes and the ID) that evidence_ids never lists.\n963|\t\t\t\textra := universe.evidenceMap(\"durable_disconnect\", []any{\"fixture_passed\", \"runtime_probe_passed\", \"ui_absent\"})\n964|\t\t\t\tfinalizeEvidence(t, universe.key, extra)\n965|\t\t\t\tuniverse.evidenceByCap[\"durable-extra\"] = extra\n966|\t\t\t},\n967|\t\t\tcheck: func(t *testing.T, err error) {\n968|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n969|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n970|\t\t\t\t}\n971|\t\t\t},\n972|\t\t},\n973|\t\t\"evidence for false claim\": {\n974|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n975|\t\t\t\tobject := universe.evidenceMap(\"local_attach\", []any{\"fixture_passed\", \"policy_checked\", \"runtime_probe_passed\"})\n976|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n977|\t\t\t\tuniverse.evidenceByCap[\"local_attach\"] = object\n978|\t\t\t},\n979|\t\t\tcheck: func(t *testing.T, err error) {\n980|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n981|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n982|\t\t\t\t}\n983|\t\t\t},\n984|\t\t},\n985|\t\t\"expired evidence\": {\n986|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n987|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n988|\t\t\t\tobject[\"observed_at\"] = \"2024-01-01T00:00:00.000Z\"\n989|\t\t\t\tobject[\"expires_at\"] = \"2025-01-01T00:00:00.000Z\"\n990|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n991|\t\t\t\tfinalizeProbeIDs(t, universe)\n992|\t\t\t},\n993|\t\t\tcheck: func(t *testing.T, err error) {\n994|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n995|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n996|\t\t\t\t}\n997|\t\t\t},\n998|\t\t},\n999|\t\t\"future observed evidence\": {\n1000|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1001|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1002|\t\t\t\tobject[\"observed_at\"] = \"2027-01-01T00:00:00.000Z\"\n1003|\t\t\t\tobject[\"expires_at\"] = \"2028-01-01T00:00:00.000Z\"\n1004|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1005|\t\t\t\tfinalizeProbeIDs(t, universe)\n1006|\t\t\t},\n1007|\t\t\tcheck: func(t *testing.T, err error) {\n1008|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n1009|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n1010|\t\t\t\t}\n1011|\t\t\t},\n1012|\t\t},\n1013|\t\t\"wrong generation evidence\": {\n1014|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1015|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1016|\t\t\t\tobject[\"backend_generation_digest\"] = testSeedDigest(0x99)\n1017|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1018|\t\t\t\tfinalizeProbeIDs(t, universe)\n1019|\t\t\t},\n1020|\t\t\tcheck: func(t *testing.T, err error) {\n1021|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n1022|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n1023|\t\t\t\t}\n1024|\t\t\t},\n1025|\t\t},\n1026|\t\t\"wrong fixture evidence\": {\n1027|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1028|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1029|\t\t\t\tobject[\"conformance_fixture_id\"] = testSeedDigest(0x98)\n1030|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1031|\t\t\t\tfinalizeProbeIDs(t, universe)\n1032|\t\t\t},\n1033|\t\t\tcheck: func(t *testing.T, err error) {\n1034|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n1035|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n1036|\t\t\t\t}\n1037|\t\t\t},\n1038|\t\t},\n1039|\t\t\"insufficient facts\": {\n1040|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1041|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1042|\t\t\t\tobject[\"facts\"] = []any{\"fixture_passed\"}\n1043|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1044|\t\t\t\tfinalizeProbeIDs(t, universe)\n1045|\t\t\t},\n1046|\t\t\tcheck: func(t *testing.T, err error) {\n1047|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n1048|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n1049|\t\t\t\t}\n1050|\t\t\t},\n1051|\t\t},\n1052|\t\t\"supplementary facts satisfy nothing\": {\n1053|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1054|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1055|\t\t\t\tobject[\"facts\"] = []any{\"prompt_absent\", \"ui_absent\"}\n1056|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1057|\t\t\t\tfinalizeProbeIDs(t, universe)\n1058|\t\t\t},\n1059|\t\t\tcheck: func(t *testing.T, err error) {\n1060|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n1061|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n1062|\t\t\t\t}\n1063|\t\t\t},\n1064|\t\t},\n1065|\t\t\"split facts across objects\": {\n1066|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1067|\t\t\t\tfirst := universe.evidenceByCap[\"graceful_stop\"]\n1068|\t\t\t\tfirst[\"facts\"] = []any{\"fixture_passed\"}\n1069|\t\t\t\tfinalizeEvidence(t, universe.key, first)\n1070|\t\t\t\tsecond := universe.evidenceMap(\"graceful_stop\", []any{\"runtime_probe_passed\"})\n1071|\t\t\t\tfinalizeEvidence(t, universe.key, second)\n1072|\t\t\t\tuniverse.evidenceByCap[\"graceful-second\"] = second\n1073|\t\t\t\tfinalizeProbeIDs(t, universe)\n1074|\t\t\t},\n1075|\t\t\tcheck: func(t *testing.T, err error) {\n1076|\t\t\t\tif !terminalbackend.IsMismatch(err) {\n1077|\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n1078|\t\t\t\t}\n1079|\t\t\t},\n1080|\t\t},\n1081|\t\t// Note: same-ID differing-bytes evidence cannot pass parsing (the\n1082|\t\t// ID is a hash of the bytes), so the conflict arm is pinned\n1083|\t\t// white-box in manifest_pin_test.go instead.\n1084|\t\t\"wrong key signature\": {\n1085|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1086|\t\t\t\tother := testKey(t)\n1087|\t\t\t\tfor _, object := range universe.evidenceByCap {\n1088|\t\t\t\t\tdelete(object, \"attestation_signature\")\n1089|\t\t\t\t\tobject[\"attestation_signature\"] = \"\"\n1090|\t\t\t\t\ttestSignBody(t, other, object)\n1091|\t\t\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n1092|\t\t\t\t}\n1093|\t\t\t\tfinalizeProbeIDs(t, universe)\n1094|\t\t\t},\n1095|\t\t\tcheck: func(t *testing.T, err error) {\n1096|\t\t\t\tif !terminalbackend.IsIntegrityFailure(err) {\n1097|\t\t\t\t\tt.Errorf(\"error = %v, want integrity failure\", err)\n1098|\t\t\t\t}\n1099|\t\t\t},\n1100|\t\t},\n1101|\t\t\"nil verifier\": {\n1102|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {},\n1103|\t\t\tcheck: func(t *testing.T, err error) {\n1104|\t\t\t\tif !terminalbackend.IsIntegrityFailure(err) {\n1105|\t\t\t\t\tt.Errorf(\"error = %v, want integrity failure\", err)\n1106|\t\t\t\t}\n1107|\t\t\t},\n1108|\t\t},\n1109|\t}\n1110|\tfor name, tc := range cases {\n1111|\t\tt.Run(name, func(t *testing.T) {\n1112|\t\t\tt.Parallel()\n1113|\n1114|\t\t\tuniverse := testUniverse(t)\n1115|\t\t\ttc.mutate(t, universe)\n1116|\t\t\tmanifest, probe, evidence := reconcileFixture(t, universe)\n1117|\t\t\tverify := testVerifier(universe.key)\n1118|\t\t\tif name == \"nil verifier\" {\n1119|\t\t\t\tverify = nil\n1120|\t\t\t}\n1121|\t\t\trawGeneration := universe.rawGeneration\n1122|\t\t\tif name == \"stale generation\" {\n1123|\t\t\t\trawGeneration = \"generation-beta\"\n1124|\t\t\t}\n1125|\t\t\t_, err := terminalbackend.Reconcile(manifest, probe, evidence, rawGeneration, universe.now, verify)\n1126|\t\t\ttc.check(t, err)\n1127|\t\t})\n1128|\t}\n1129|}\n1130|\n1131|// finalizeProbeIDs rebuilds evidence_ids from the current evidence set and\n1132|// re-stamps the probe identity.\n1133|func finalizeProbeIDs(t *testing.T, universe *fixtureUniverse) {\n1134|\tt.Helper()\n1135|\n1136|\tids := make([]string, 0, len(universe.evidenceByCap))\n1137|\tfor _, object := range universe.evidenceByCap {\n1138|\t\tid, ok := object[\"evidence_id\"].(string)\n1139|\t\tif !ok || id == \"\" {\n1140|\t\t\tt.Fatalf(\"evidence without identity in set\")\n1141|\t\t}\n1142|\t\tids = append(ids, id)\n1143|\t}\n1144|\tsort.Strings(ids)\n1145|\tasValues := make([]any, 0, len(ids))\n1146|\tfor _, id := range ids {\n1147|\t\tasValues = append(asValues, id)\n1148|\t}\n1149|\tuniverse.probe[\"evidence_ids\"] = asValues\n1150|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1151|}\n1152|\n1153|// TestCapabilitiesForOperation pins the registry-derived dependency map:\n1154|// which capabilities confer each operation. manifest and probe confer\n1155|// through no capability and return an empty set by design.\n1156|func TestCapabilitiesForOperation(t *testing.T) {\n1157|\tt.Parallel()\n1158|\n1159|\twant := map[string][]string{\n1160|\t\t\"manifest\": {}, \"probe\": {},\n1161|\t\t\"create\":             {\"credential_capable_execution_realm\", \"durable_disconnect\", \"headless_creation\", \"scrollback_retention\", \"terminal_state_retention\"},\n1162|\t\t\"attach\":             {\"local_attach\", \"multi_attach\", \"multiple_input_clients\", \"remote_attach\", \"web_attach\"},\n1163|\t\t\"status\":             {\"durable_disconnect\", \"provider_process_observation\", \"scrollback_retention\", \"terminal_state_retention\"},\n1164|\t\t\"quiesce-input\":      {\"input_quiescence\"},\n1165|\t\t\"wait-safe-boundary\": {\"provider_process_observation\", \"safe_boundary_observation\"},\n1166|\t\t\"request-stop\":       {\"graceful_stop\"},\n1167|\t\t\"terminate-stale\":    {\"provider_process_observation\", \"stale_process_termination\"},\n1168|\t\t\"restore\":            {\"credential_capable_execution_realm\", \"reboot_restoration\", \"scrollback_retention\", \"terminal_state_retention\"},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
