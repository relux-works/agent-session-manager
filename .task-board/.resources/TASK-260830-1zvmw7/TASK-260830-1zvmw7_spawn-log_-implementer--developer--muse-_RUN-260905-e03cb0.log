{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7c3","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":572,"recorded_at":1780531400001139,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"task_stream":{"kind":"task","id":"1cb0cbb1-3005-40df-96d9-d70459a057c8"},"task_id":"1cb0cbb1-3005-40df-96d9-d70459a057c8","event":{"kind":"output","task_id":"1cb0cbb1-3005-40df-96d9-d70459a057c8","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n(1167 line(s) above)\n1168|\t\t\"restore\":            {\"credential_capable_execution_realm\", \"reboot_restoration\", \"scrollback_retention\", \"terminal_state_retention\"},\n1169|\t}\n1170|\tfor operation, expected := range want {\n1171|\t\tgot, err := terminalbackend.CapabilitiesForOperation(operation)\n1172|\t\tif err != nil {\n1173|\t\t\tt.Errorf(\"CapabilitiesForOperation(%q) error = %v\", operation, err)\n1174|\t\t\tcontinue\n1175|\t\t}\n1176|\t\tsort.Strings(got)\n1177|\t\tif fmt.Sprint(got) != fmt.Sprint(expected) {\n1178|\t\t\tt.Errorf(\"CapabilitiesForOperation(%q) = %v, want %v\", operation, got, expected)\n1179|\t\t}\n1180|\t}\n1181|\tif _, err := terminalbackend.CapabilitiesForOperation(\"launch\"); !terminalbackend.IsMismatch(err) {\n1182|\t\tt.Errorf(\"CapabilitiesForOperation(launch) error = %v, want mismatch\", err)\n1183|\t}\n1184|\tif err := terminalbackend.CheckOperation(\"launch\", terminalbackend.Admitted{}); !terminalbackend.IsMismatch(err) {\n1185|\t\tt.Errorf(\"CheckOperation(launch) error = %v, want mismatch\", err)\n1186|\t}\n1187|}\n1188|\n1189|// TestEmptyTupleAdmitsEmptySet pins the vacuous boundary explicitly: a\n1190|// claim-free probe with no evidence admits an empty set without error. The\n1191|// set is empty because nothing was claimed, not because a filter removed\n1192|// anything; callers must not read this as proof of filtering.\n1193|func TestEmptyTupleAdmitsEmptySet(t *testing.T) {\n1194|\tt.Parallel()\n1195|\n1196|\tuniverse := testUniverse(t)\n1197|\tuniverse.manifest[\"static_capability_claims\"] = []any{}\n1198|\tfinalizeDocument(t, universe.manifest, \"manifest_id\")\n1199|\tuniverse.probe[\"capability_claims\"] = []any{}\n1200|\tuniverse.probe[\"evidence_ids\"] = []any{}\n1201|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1202|\tuniverse.evidenceByCap = map[string]map[string]any{}\n1203|\n1204|\tmanifest, probe, evidence := reconcileFixture(t, universe)\n1205|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key))\n1206|\tif err != nil {\n1207|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n1208|\t}\n1209|\tif len(admitted.Capabilities) != 0 || len(admitted.EvidenceIDs) != 0 {\n1210|\t\tt.Errorf(\"Admitted = %+v, want empty\", admitted)\n1211|\t}\n1212|\tif err := terminalbackend.CheckOperation(\"status\", admitted); !terminalbackend.IsCapabilityUnproven(err) {\n1213|\t\tt.Errorf(\"CheckOperation(status) error = %v, want capability unproven\", err)\n1214|\t}\n1215|}\n1216|\n1217|// TestAdmittedSharesNoBackingArrays keeps leaf 1's pin true for the new\n1218|// surface: admitted outputs are freshly allocated copies, so mutating the\n1219|// typed inputs after admission cannot rewrite the admitted set, and no\n1220|// exported path reaches registry or document interior arrays.\n1221|func TestAdmittedSharesNoBackingArrays(t *testing.T) {\n1222|\tt.Parallel()\n1223|\n1224|\tuniverse := testUniverse(t)\n1225|\tmanifest, probe, evidence := universe.parsed(t)\n1226|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key))\n1227|\tif err != nil {\n1228|\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n1229|\t}\n1230|\tbeforeCapabilities := append([]string{}, admitted.Capabilities...)\n1231|\tbeforeEvidence := append([]string{}, admitted.EvidenceIDs...)\n1232|\tprobe.EvidenceIDs[0] = beforeEvidence[0] + \"-mutated\"\n1233|\tmanifest.ProtocolVersions[0] = \"9.9.9\"\n1234|\tevidence[0].Facts[0] = \"mutated_fact\"\n1235|\tif fmt.Sprint(admitted.Capabilities) != fmt.Sprint(beforeCapabilities) ||\n1236|\t\tfmt.Sprint(admitted.EvidenceIDs) != fmt.Sprint(beforeEvidence) {\n1237|\t\tt.Errorf(\"Admitted = %+v after input mutation, want immutable output\", admitted)\n1238|\t}\n1239|}\n1240|\n1241|// TestUnavailableProbeStillAdmits pins the deliberate non-gate:\n1242|// availability is an observation, not admission. An unavailable probe with\n1243|// coherent evidence admits; activation policy owns the availability read.\n1244|func TestUnavailableProbeStillAdmits(t *testing.T) {\n1245|\tt.Parallel()\n1246|\n1247|\tuniverse := testUniverse(t)\n1248|\tuniverse.probe[\"availability\"] = \"unavailable\"\n1249|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1250|\tmanifest, probe, evidence := reconcileFixture(t, universe)\n1251|\tif _, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key)); err != nil {\n1252|\t\tt.Errorf(\"Reconcile(unavailable) error = %v, want admission\", err)\n1253|\t}\n1254|}\n1255|\n1256|// TestAdmitProbeBindsRegistry is the production entry point: the universe\n1257|// manifest resolves through a registry opened with the matching versions,\n1258|// binds member-for-member, and admits.\n1259|func TestAdmitProbeBindsRegistry(t *testing.T) {\n1260|\tt.Parallel()\n1261|\n1262|\tuniverse := testUniverse(t)\n1263|\tregistry, err := terminalbackend.New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n1264|\tif err != nil {\n1265|\t\tt.Fatalf(\"New() error = %v\", err)\n1266|\t}\n1267|\tmanifestRaw := mustMarshal(t, universe.manifest)\n1268|\tprobeRaw := mustMarshal(t, universe.probe)\n1269|\tevidenceRaws := make([][]byte, 0, len(universe.evidenceByCap))\n1270|\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n1271|\t\tevidenceRaws = append(evidenceRaws, mustMarshal(t, universe.evidenceByCap[capability]))\n1272|\t}\n1273|\tadmitted, err := registry.AdmitProbe(manifestRaw, probeRaw, evidenceRaws, universe.rawGeneration, universe.now, testVerifier(universe.key))\n1274|\tif err != nil {\n1275|\t\tt.Fatalf(\"AdmitProbe() error = %v\", err)\n1276|\t}\n1277|\tif !admitted.Has(\"graceful_stop\") || admitted.Has(\"local_attach\") {\n1278|\t\tt.Errorf(\"Admitted = %v, want proved true claims only\", admitted.Capabilities)\n1279|\t}\n1280|}\n1281|\n1282|// TestAdmitProbeRefusesUnknownIdentity proves registry reads fail closed:\n1283|// a well-formed manifest for a never-admitted backend is not-found, never\n1284|// a default.\n1285|func TestAdmitProbeRefusesUnknownIdentity(t *testing.T) {\n1286|\tt.Parallel()\n1287|\n1288|\tuniverse := testUniverse(t)\n1289|\tuniverse.manifest[\"terminal_backend_id\"] = \"example.term\"\n1290|\tfinalizeDocument(t, universe.manifest, \"manifest_id\")\n1291|\tuniverse.probe[\"terminal_backend_id\"] = \"example.term\"\n1292|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1293|\tfor _, object := range universe.evidenceByCap {\n1294|\t\tobject[\"terminal_backend_id\"] = \"example.term\"\n1295|\t\tfinalizeEvidence(t, universe.key, object)\n1296|\t}\n1297|\tfinalizeProbeIDs(t, universe)\n1298|\n1299|\tregistry, err := terminalbackend.New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n1300|\tif err != nil {\n1301|\t\tt.Fatalf(\"New() error = %v\", err)\n1302|\t}\n1303|\tevidenceRaws := make([][]byte, 0, len(universe.evidenceByCap))\n1304|\tfor _, name := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n1305|\t\tevidenceRaws = append(evidenceRaws, mustMarshal(t, universe.evidenceByCap[name]))\n1306|\t}\n1307|\t_, err = registry.AdmitProbe(\n1308|\t\tmustMarshal(t, universe.manifest), mustMarshal(t, universe.probe),\n1309|\t\tevidenceRaws, universe.rawGeneration, universe.now, testVerifier(universe.key),\n1310|\t)\n1311|\tif !terminalbackend.IsNotFound(err) {\n1312|\t\tt.Errorf(\"AdmitProbe() error = %v, want terminal_backend_not_found\", err)\n1313|\t}\n1314|}\n1315|\n1316|// TestAdmitProbeRefusesRecordDrift proves the manifest-to-record binding:\n1317|// an implementation version the registry never admitted is drift.\n1318|func TestAdmitProbeRefusesRecordDrift(t *testing.T) {\n1319|\tt.Parallel()\n1320|\n1321|\tuniverse := testUniverse(t)\n1322|\tuniverse.manifest[\"implementation_version\"] = \"9.9.9\"\n1323|\tfinalizeDocument(t, universe.manifest, \"manifest_id\")\n1324|\n1325|\tregistry, err := terminalbackend.New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n1326|\tif err != nil {\n1327|\t\tt.Fatalf(\"New() error = %v\", err)\n1328|\t}\n1329|\t_, err = registry.AdmitProbe(\n1330|\t\tmustMarshal(t, universe.manifest), mustMarshal(t, universe.probe),\n1331|\t\tnil, universe.rawGeneration, universe.now, testVerifier(universe.key),\n1332|\t)\n1333|\tif !terminalbackend.IsDrift(err) {\n1334|\t\tt.Errorf(\"AdmitProbe() error = %v, want implementation drift\", err)\n1335|\t}\n1336|}\n1337|\n1338|// TestAdmitProbeExternalRealm exercises the external path end to end: an\n1339|// external adapter registers with trust, its manifest binds the digest, and\n1340|// realm evidence proves the credential claim. A substituted digest in the\n1341|// manifest is untrusted, not drift.\n1342|func TestAdmitProbeExternalRealm(t *testing.T) {\n1343|\tt.Parallel()\n1344|\n1345|\tconst backendID = \"example.realm\"\n1346|\texecutableDigest := testSeedDigest(0xE5)\n1347|\trawGeneration := \"generation-realm\"\n1348|\tgenerationDigest, err := terminalbackend.GenerationDigest(rawGeneration)\n1349|\tif err != nil {\n1350|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n1351|\t}\n1352|\tfixtureID := testSeedDigest(0xF2)\n1353|\tissuerID := testSeedDigest(0x2D)\n1354|\tnow := time.Date(2026, time.February, 2, 0, 0, 0, 0, time.UTC)\n1355|\tkey := testKey(t)\n1356|\n1357|\tregistry, err := terminalbackend.New(\"2.1.0\", []string{\"1.0.0\", \"1.1.0\"})\n1358|\tif err != nil {\n1359|\t\tt.Fatalf(\"New() error = %v\", err)\n1360|\t}\n1361|\n1362|\tmanifest := map[string]any{\n1363|\t\t\"schema\":                 terminalbackend.SchemaManifest,\n1364|\t\t\"schema_version\":         \"1.0.0\",\n1365|\t\t\"manifest_id\":            \"\",\n1366|\t\t\"terminal_backend_id\":    backendID,\n1367|\t\t\"implementation_version\": \"3.0.0\",\n1368|\t\t\"protocol_versions\":      []any{\"1.0.0\"},\n1369|\t\t\"platforms\":              []any{\"linux\"},\n1370|\t\t\"implementation_kind\":    \"local_program\",\n1371|\t\t\"executable_digest\":      executableDigest,\n1372|\t\t\"static_capability_claims\": []any{\n1373|\t\t\tclaimMap(\"credential_capable_execution_realm\", \"static\", true),\n1374|\t\t},\n1375|\t\t\"conformance_fixture_id\": fixtureID,\n1376|\t\t\"extensions\":             map[string]any{},\n1377|\t}\n1378|\tfinalizeDocument(t, manifest, \"manifest_id\")\n1379|\n1380|\t// Register the external adapter through the production trust gate so\n1381|\t// the manifest below binds a genuinely admitted record.\n1382|\tif err := registerExternalForTest(t, registry, backendID, executableDigest); err != nil {\n1383|\t\tt.Fatalf(\"RegisterExternal() error = %v\", err)\n1384|\t}\n1385|\n1386|\tprobe := map[string]any{\n1387|\t\t\"schema\":                    terminalbackend.SchemaProbe,\n1388|\t\t\"schema_version\":            \"1.0.0\",\n1389|\t\t\"probe_id\":                  \"\",\n1390|\t\t\"terminal_backend_id\":       backendID,\n1391|\t\t\"implementation_version\":    \"3.0.0\",\n1392|\t\t\"protocol_version\":          \"1.0.0\",\n1393|\t\t\"implementation_kind\":       \"local_program\",\n1394|\t\t\"executable_digest\":         executableDigest,\n1395|\t\t\"platform\":                  \"linux\",\n1396|\t\t\"os_version\":                \"6.8\",\n1397|\t\t\"availability\":              \"available\",\n1398|\t\t\"backend_generation_digest\": generationDigest,\n1399|\t\t\"capability_claims\": []any{\n1400|\t\t\tclaimMap(\"credential_capable_execution_realm\", \"probed\", true),\n1401|\t\t},\n1402|\t\t\"evidence_ids\": []any{},\n1403|\t\t\"probed_at\":    \"2026-02-01T09:00:00.000Z\",\n1404|\t\t\"extensions\":   map[string]any{},\n1405|\t}\n1406|\n1407|\tevidence := map[string]any{\n1408|\t\t\"schema\":                     terminalbackend.SchemaCapabilityEvidence,\n1409|\t\t\"schema_version\":             \"1.0.0\",\n1410|\t\t\"evidence_id\":                \"\",\n1411|\t\t\"terminal_backend_id\":        backendID,\n1412|\t\t\"implementation_version\":     \"3.0.0\",\n1413|\t\t\"protocol_version\":           \"1.0.0\",\n1414|\t\t\"backend_generation_digest\":  generationDigest,\n1415|\t\t\"capability\":                 \"credential_capable_execution_realm\",\n1416|\t\t\"value\":                      true,\n1417|\t\t\"platform\":                   \"linux\",\n1418|\t\t\"os_version\":                 \"6.8\",\n1419|\t\t\"conformance_fixture_id\":     fixtureID,\n1420|\t\t\"observed_at\":                \"2026-01-01T00:00:00.000Z\",\n1421|\t\t\"expires_at\":                 \"2027-01-01T00:00:00.000Z\",\n1422|\t\t\"issuer\":                     terminalbackend.IssuerRelease,\n1423|\t\t\"issuer_id\":                  issuerID,\n1424|\t\t\"attestation_signature\":      \"\",\n1425|\t\t\"facts\":                      []any{\"fixture_passed\", \"provider_auth_passed\", \"runtime_probe_passed\", \"sentinel_passed\"},\n1426|\t\t\"terminal_binding_id\":        testSeedDigest(0xB1),\n1427|\t\t\"provider_id\":                \"codex\",\n1428|\t\t\"provider_build\":             \"1.2.3\",\n1429|\t\t\"sentinel_result\":            \"passed\",\n1430|\t\t\"provider_auth_smoke_result\": \"passed\",\n1431|\t\t\"extensions\":                 map[string]any{},\n1432|\t}\n1433|\tfinalizeEvidence(t, key, evidence)\n1434|\tprobe[\"evidence_ids\"] = []any{evidence[\"evidence_id\"]}\n1435|\tfinalizeDocument(t, probe, \"probe_id\")\n1436|\n1437|\tadmitted, err := registry.AdmitProbe(\n1438|\t\tmustMarshal(t, manifest), mustMarshal(t, probe),\n1439|\t\t[][]byte{mustMarshal(t, evidence)}, rawGeneration, now, testVerifier(key),\n1440|\t)\n1441|\tif err != nil {\n1442|\t\tt.Fatalf(\"AdmitProbe() error = %v\", err)\n1443|\t}\n1444|\tif !admitted.Has(\"credential_capable_execution_realm\") {\n1445|\t\tt.Errorf(\"Admitted = %v, want credential realm\", admitted.Capabilities)\n1446|\t}\n1447|\n1448|\t// Substitution: the same manifest shape with a foreign digest is\n1449|\t// untrusted even though every other member binds.\n1450|\tsubstituted := cloneMap(t, manifest)\n1451|\tsubstituted[\"executable_digest\"] = testSeedDigest(0xE6)\n1452|\tfinalizeDocument(t, substituted, \"manifest_id\")\n1453|\t_, err = registry.AdmitProbe(\n1454|\t\tmustMarshal(t, substituted), mustMarshal(t, probe),\n1455|\t\t[][]byte{mustMarshal(t, evidence)}, rawGeneration, now, testVerifier(key),\n1456|\t)\n1457|\tif !terminalbackend.IsUntrusted(err) {\n1458|\t\tt.Errorf(\"AdmitProbe(substituted) error = %v, want untrusted\", err)\n1459|\t}\n1460|}\n1461|\n1462|// registerExternalForTest admits one local_program adapter through the\n1463|// production RegisterExternal trust gate. Trust validation is grammatical\n1464|// (absolute path, well-formed digest), so no executable file is needed.\n1465|func registerExternalForTest(t *testing.T, registry *terminalbackend.Registry, backendID, digest string) error {\n1466|\tt.Helper()\n1467|\n1468|\treturn registry.RegisterExternal(\n1469|\t\tscalar.PlatformLinux,\n1470|\t\tterminalbackend.TrustEntry{\n1471|\t\t\tBackendID:        backendID,\n1472|\t\t\tExecutablePath:   \"/opt/vendor/bin/ax-backend-realm\",\n1473|\t\t\tExecutableDigest: digest,\n1474|\t\t\tEnabled:          true,\n1475|\t\t},\n1476|\t\tterminalbackend.Registration{\n1477|\t\t\tID:                    backendID,\n1478|\t\t\tKind:                  terminalbackend.KindLocalProgram,\n1479|\t\t\tImplementationVersion: \"3.0.0\",\n1480|\t\t\tProtocolVersions:      []string{\"1.0.0\"},\n1481|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformLinux},\n1482|\t\t\tExecutableDigest:      digest,\n1483|\t\t},\n1484|\t)\n1485|}"}}}
