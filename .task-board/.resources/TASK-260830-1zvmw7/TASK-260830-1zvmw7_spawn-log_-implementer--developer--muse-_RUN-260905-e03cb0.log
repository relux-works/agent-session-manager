estDocumentRefusals/adjacent_duplicate_claims')\\ntrial(*m60,'TestManifestDocumentRefusals/duplicate_claims')\\nassert hashlib.sha256(open(SRC,'rb').read()).hexdigest()==hashlib.sha256(ORIG.encode()).hexdigest()\\nprint('reverted ok')\\nEOF\",\n  \"description\": \"Confirm adjacent cases hold dup halves\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"M41 adjacent_duplicate_evidence_ids KILLED\\nM41 duplicate_evidence_ids KILLED\\nM60 adjacent_duplicate_claims KILLED\\nM60 duplicate_claims KILLED\\nreverted ok\\n\",\n  \"original_output_bytes\": 154,\n  \"original_output_tokens\": 39,\n  \"truncated\": false\n}"}}}
