onsume.\n1656|func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\n1657|\tused := make([]Evidence, 0, len(evidence))\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f1","stream":{"kind":"session","id":"01a06ee5-ad0e-7750-9534-32e3571b58b2"},"sequence":339,"recorded_at":1780531400000673,"record_type":"event","durability":"durable","causation_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2","run_stream":{"kind":"run","id":"268a8b73-3d5a-46cf-996a-bd1fafa2d2a2"},"call_id":"call_01a06ee64eb279f2b0eac51c4f95bf6a","text":"Read text file `internal/terminalbackend/manifest.go`.\n(1655 line(s) above)\n1656|func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\n1657|\tused := make([]Evidence, 0, len(evidence))\n1658|\tseen := make(map[string]Evidence, len(evidence))\n1659|\tfor _, object := range evidence {\n1660|\t\tclaim, present := probeClaims[object.Capability]\n1661|\t\tif !present || !claim.Value {\n1662|\t\t\treturn nil, mismatchf(\"evidence claim binding\")\n1663|\t\t}\n1664|\t\tif err := checkEvidenceTuple(manifest, probe, object); err != nil {\n1665|\t\t\treturn nil, err\n1666|\t\t}\n1667|\t\tif err := checkEvidenceLiveness(object, now); err != nil {\n1668|\t\t\treturn nil, err\n1669|\t\t}\n1670|\t\tif previous, duplicate := seen[object.EvidenceID]; duplicate {\n1671|\t\t\tif !equalEvidence(previous, object) {\n1672|\t\t\t\treturn nil, mismatchf(\"conflicting evidence\")\n1673|\t\t\t}\n1674|\t\t\tcontinue\n1675|\t\t}\n1676|\t\tseen[object.EvidenceID] = object\n1677|\t\tif err := checkEvidenceSignature(object, verify); err != nil {\n1678|\t\t\treturn nil, err\n1679|\t\t}\n1680|\t\tused = append(used, object)\n1681|\t}\n1682|\treturn used, nil\n1683|}\n1684|\n1685|// equalEvidence reports whether two evidence objects with the same ID carry\n1686|// identical members. Same-ID differing-bytes objects are conflicting\n1687|// evidence and invalidate the whole Probe.\n1688|func equalEvidence(left, right Evidence) bool {\n1689|\tif left.TerminalBackendID != right.TerminalBackendID ||\n1690|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n1691|\t\tleft.ProtocolVersion != right.ProtocolVersion ||\n1692|\t\tleft.BackendGenerationDigest != right.BackendGenerationDigest ||\n1693|\t\tleft.Capability != right.Capability ||\n1694|\t\tleft.Platform != right.Platform ||\n1695|\t\tleft.OSVersion != right.OSVersion ||\n1696|\t\tleft.ConformanceFixtureID != right.ConformanceFixtureID ||\n1697|\t\tleft.ObservedAt.String() != right.ObservedAt.String() ||\n1698|\t\tleft.ExpiresAt.String() != right.ExpiresAt.String() ||\n1699|\t\tleft.Issuer != right.Issuer ||\n1700|\t\tleft.IssuerID != right.IssuerID ||\n1701|\t\t!equalStrings(left.Facts, right.Facts) ||\n1702|\t\tleft.TerminalBindingID != right.TerminalBindingID ||\n1703|\t\tleft.ProviderID != right.ProviderID ||\n1704|\t\tleft.ProviderBuild != right.ProviderBuild ||\n1705|\t\tleft.SentinelResult != right.SentinelResult ||\n1706|\t\tleft.ProviderAuthSmokeResult != right.ProviderAuthSmokeResult {\n1707|\t\treturn false\n1708|\t}\n1709|\treturn bytes.Equal(left.AttestationSignature, right.AttestationSignature)\n1710|}\n1711|\n1712|// checkEvidenceTuple binds one evidence object to this exact Manifest/Probe\n1713|// tuple: backend, versions, generation digest, platform, os_version, and\n1714|// the Manifest conformance fixture must all match.\n1715|func checkEvidenceTuple(manifest Manifest, probe Probe, object Evidence) error {\n1716|\tif object.TerminalBackendID != probe.TerminalBackendID ||\n1717|\t\tobject.ImplementationVersion != probe.ImplementationVersion ||\n1718|\t\tobject.ProtocolVersion != probe.ProtocolVersion ||\n1719|\t\tobject.BackendGenerationDigest != probe.BackendGenerationDigest ||\n1720|\t\tobject.Platform != probe.Platform ||\n1721|\t\tobject.OSVersion != probe.OSVersion ||\n1722|\t\tobject.ConformanceFixtureID != manifest.ConformanceFixtureID {\n1723|\t\treturn mismatchf(\"evidence tuple binding\")\n1724|\t}\n1725|\treturn nil\n1726|}\n1727|\n1728|// checkEvidenceLiveness requires observed_at <= now < expires_at. Future\n1729|// observed instants and expired objects are both unusable: the former is\n1730|// not yet proof, the latter no longer is.\n1731|func checkEvidenceLiveness(object Evidence, now time.Time) error {\n1732|\tobserved, err := object.ObservedAt.Time()\n1733|\tif err != nil {\n1734|\t\treturn mismatchf(\"document timestamp\")\n1735|\t}\n1736|\texpires, err := object.ExpiresAt.Time()\n1737|\tif err != nil {\n1738|\t\treturn mismatchf(\"document timestamp\")\n1739|\t}\n1740|\tif observed.After(now) || !now.Before(expires) {\n1741|\t\treturn mismatchf(\"evidence liveness\")\n1742|\t}\n1743|\treturn nil\n1744|}\n1745|\n1746|// checkEvidenceSignature verifies the attestation through the caller's\n1747|// trusted key registry. Missing, unknown-key, or invalid signatures fail\n1748|// closed before capability admission; a caller-supplied issuer ID alone is\n1749|// never authentication.\n1750|func checkEvidenceSignature(object Evidence, verify SignatureVerifier) error {\n1751|\tmessage, err := UnsignedEvidenceBytes(object)\n1752|\tif err != nil {\n1753|\t\treturn err\n1754|\t}\n1755|\tif err := verify(object.IssuerID, message, object.AttestationSignature); err != nil {\n1756|\t\treturn integrityFailure(\"evidence attestation\")\n1757|\t}\n1758|\treturn nil\n1759|}\n1760|\n1761|// checkEvidenceCoverage requires every true probe claim to hold at least\n1762|// one usable evidence object whose facts cover every listed requirement\n1763|// through the requirement-to-fact mapping. False claims need no evidence\n1764|// and take none: evidence for a false claim was already refused as\n1765|// unbound in checkEvidenceSet.\n1766|func checkEvidenceCoverage(probeClaims map[string]Claim, used []Evidence) error {\n1767|\tbyCapability := make(map[string][]Evidence, len(used))\n1768|\tfor _, object := range used {\n1769|\t\tbyCapability[object.Capability] = append(byCapability[object.Capability], object)\n1770|\t}\n1771|\tfor capability, claim := range probeClaims {\n1772|\t\tif !claim.Value {\n1773|\t\t\tcontinue\n1774|\t\t}\n1775|\t\tcovered := false\n1776|\t\tfor _, object := range byCapability[capability] {\n1777|\t\t\tif factsCover(object.Facts, claim.EvidenceRequirements) {\n1778|\t\t\t\tcovered = true\n1779|\t\t\t\tbreak\n1780|\t\t\t}\n1781|\t\t}\n1782|\t\tif !covered {\n1783|\t\t\treturn mismatchf(\"evidence requirement coverage\")\n1784|\t\t}\n1785|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
