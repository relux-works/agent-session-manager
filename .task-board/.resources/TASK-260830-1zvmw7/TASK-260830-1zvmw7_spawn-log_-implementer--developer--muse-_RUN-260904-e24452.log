{value: \\\"sha256:\\\" + hex.EncodeToString(sum[:])}\\n}\\n\\nfunc (value Digest) String() string { return value.value }\\nfunc (value Digest) Hex() string    { return strings.TrimPrefix(value.value, \\\"sha256:\\\") }\\n===\\n386:          {\\\"exit_code\\\": 6, \\\"codes\\\": [\\\"terminal_backend_unavailable\\\", \\\"terminal_backend_protocol_incompatible\\\", \\\"terminal_backend_capability_unproven\\\", \\\"terminal_backend_restore_mismatch\\\"]},\\n388:          {\\\"exit_code\\\": 9, \\\"codes\\\": [\\\"terminal_backend_integrity_failure\\\", \\\"terminal_backend_implementation_drift\\\", \\\"terminal_backend_manifest_probe_mismatch\\\"]},\\n===\\n65:var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\\n71:\\tif !providerIDPattern.MatchString(value) {\\n72:\\t\\treturn ProviderID{}, invalid(\\\"provider-id\\\", \\\"must match [a-z][a-z0-9-]{0,31}\\\")\\n96:\\treturn marshalValidatedString(value.value, \\\"provider-id\\\", func(candidate string) error {\\n103:\\tcandidate, err := decodeJSONString(data, \\\"provider-id\\\")\\n===\\ninternal/config/schema.go:187:\\tRequiredCapabilities         []string\\ninternal/config/schema.go:188:\\tRequiredCapabilitiesExplicit bool\\ninternal/config/schema.go:332:\\tRequiredCapabilities       *[]string                    `toml:\\\"required_capabilities\\\"`\\ninternal/config/validation.go:234:\\tif raw.RequiredCapabilities != nil {\\ninternal/config/validation.go:235:\\t\\trequiredCapabilities = cloneStrings(*raw.RequiredCapabilities)\\ninternal/config/validation.go:245:\\t\\tRequiredCapabilities:         requiredCapabilities,\\ninternal/config/validation.go:246:\\t\\tRequiredCapabilitiesExplicit: raw.RequiredCapabilities != nil,\\ninternal/config/validation.go:669:\\tif err := validateSortedUniqueClosed(terminal.RequiredCapabilities, terminalCapabilitySet); err != nil {\\ninternal/config/validation.go:670:\\t\\treturn configError(\\\"terminal.required_capabilities\\\", err)\\ninternal/config/validation.go:672:\\tif !terminal.RequiredCapabilitiesExplicit && len(terminal.RequiredCapabilities) != 0 {\\n\",\n  \"original_output_bytes\": 2593,\n  \"original_output_tokens\": 649,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a3","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":428,"recorded_at":1780531400000851,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"call_id":"call_01a06ebbdaca7d019083d118799ae63b","text":"{\n  \"chunk_id\": \"exec-17-1\",\n  \"command\": \"sed -n 55,110p internal/terminalbackend/terminalbackend_test.go; echo ===; grep -n \\\"func Test\\\" internal/terminalbackend/terminalbackend_test.go\",\n  \"description\": \"Read wire-code pin and test inventory\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\nfunc mustRegisterExternal(t *testing.T, registry *terminalbackend.Registry, id string) {\\n\\tt.Helper()\\n\\tif err := registry.RegisterExternal(scalar.PlatformLinux, testTrustEntry(id), testExternalRecord(id)); err != nil {\\n\\t\\tt.Fatalf(\\\"RegisterExternal(%q) error = %v\\\", id, err)\\n\\t}\\n}\\n\\n// TestWireCodesAreCatalogued proves the registry advertises no error code the\\n// pinned contract vocabulary does not define.\\nfunc TestWireCodesAreCatalogued(t *testing.T) {\\n\\tt.Parallel()\\n\\n\\tknown := map[string]bool{}\\n\\tfor _, entry := range catalog.Current().Errors {\\n\\t\\tknown[string(entry.Code)] = true\\n\\t}\\n\\tfor _, code := range []string{\\n\\t\\t\\\"terminal_backend_not_found\\\",\\n\\t\\t\\\"terminal_backend_ambiguous\\\",\\n\\t\\t\\\"terminal_backend_untrusted\\\",\\n\\t\\t\\\"terminal_backend_implementation_drift\\\",\\n\\t\\t\\\"terminal_backend_restore_mismatch\\\",\\n\\t\\t\\\"terminal_backend_stale_generation\\\",\\n\\t} {\\n\\t\\tif !known[code] {\\n\\t\\t\\tt.Errorf(\\\"wire code %q is not in the pinned catalog error vocabulary\\\", code)\\n\\t\\t}\\n\\t}\\n}\\n\\n// TestParseIDAdmitsCanonicalIdentities proves the gate is reachable: the two\\n// canonical built-ins, minimal and maximal bounds, and vendor namespaces.\\nfunc TestParseIDAdmitsCanonicalIdentities(t *testing.T) {\\n\\tt.Parallel()\\n\\n\\taccepted := []string{\\n\\t\\tterminalbackend.BuiltinTmux,\\n\\t\\tterminalbackend.BuiltinConpty,\\n\\t\\t\\\"a\\\",\\n\\t\\t\\\"tmux\\\",\\n\\t\\t\\\"ax-tmux\\\",\\n\\t\\t\\\"vendor.backend-1\\\",\\n\\t\\t\\\"a0.b1-c2.d3\\\",\\n\\t\\t\\\"example.terminal-backend\\\",\\n\\t\\t\\\"a\\\" + strings.Repeat(\\\"0\\\", 127),\\n\\t}\\n\\tfor _, id := range accepted {\\n\\t\\tif _, err := terminalbackend.ParseID(id); err != nil {\\n\\t\\t\\tt.Errorf(\\\"ParseID(%q) error = %v, want admission\\\", id, err)\\n\\t\\t}\\n\\t}\\n}\\n\\n// TestParseIDRefusesWidenedGrammar narrows the gate instead of only deleting\\n// it: every case widens exactly one part of the declared character class,\\n===\\n65:func TestWireCodesAreCatalogued(t *testing.T) {\\n88:func TestParseIDAdmitsCanonicalIdentities(t *testing.T) {\\n113:func TestParseIDRefusesWidenedGrammar(t *testing.T) {\\n155:func TestParseIDRefusesReservedNamespace(t *testing.T) {\\n167:func TestNewAdmitsCanonicalBuiltins(t *testing.T) {\\n204:func TestNewRefusesBadVersionTuples(t *testing.T) {\\n258:func TestRegisterExternalRoundTrip(t *testing.T) {\\n281:func TestRegisterExternalAdmitsFullPlatformSet(t *testing.T) {\\n312:func TestRegisterExternalRefusals(t *testing.T) {\\n390:func TestDuplicateRegistrationIsRefused(t *testing.T) {\\n415:func TestDriftIsRefused(t *testing.T) {\\n480:func TestRegistryCopiesSlicesAcrossItsBoundary(t *testing.T) {\\n561:func TestRegisterExternalRefusesPlatformViolations(t *testing.T) {\\n606:func TestRegisterExternalRefusesUnknownKindAsUntrusted(t *testing.T) {\\n625:func TestRegisterExternalRefusesReservedNamespaceDistinguishingValue(t *testing.T) {\\n642:func TestResolveUnknownIsNeverAbsence(t *testing.T) {\\n662:func TestDefaultForPlatform(t *testing.T) {\\n687:func TestRequireRestoreBinding(t *testing.T) {\\n713:func TestCheckVersionTuple(t *testing.T) {\\n745:func TestCheckProviderDescriptor(t *testing.T) {\\n782:func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\\n833:func TestCheckProviderDescriptorGenerationMismatch(t *testing.T) {\\n852:func TestDigestFile(t *testing.T) {\\n903:func TestErrorPredicatesAreExclusive(t *testing.T) {\\n\",\n  \"original_output_bytes\": 3135,\n  \"original_output_tokens\": 784,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
