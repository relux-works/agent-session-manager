{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ed","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":849,"recorded_at":1780531400001693,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"task_stream":{"kind":"task","id":"b9e92db0-4208-4824-b475-dda0ae732a23"},"task_id":"b9e92db0-4208-4824-b475-dda0ae732a23","event":{"kind":"output","task_id":"b9e92db0-4208-4824-b475-dda0ae732a23","chunk":"edited\nchanged lines: lines 679-688\n--- original\n+++ updated\n@@\n-\t\t\tuniverse := testUniverse(t)\n-\t\t\tobject := cloneMap(t, universe.probe)\n-\t\t\tmutate(t, object)\n-\t\t\tfinalizeDocument(t, object, \"probe_id\")\n-\t\t\tif _, err := terminalbackend.ParseProbe(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n-\t\t\t\tt.Errorf(\"ParseProbe() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n-\t\t\t}\n-\t\t})\n-\t}\n-}\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.probe)\n+\t\t\tmutate(t, object)\n+\t\t\tfinalizeDocument(t, object, \"probe_id\")\n+\t\t\tif _, err := terminalbackend.ParseProbe(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseProbe() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// TestEvidenceDocumentRefusals narrows the evidence closed-schema gate. The\n+// signature is re-applied after every unsigned-field mutation so each case\n+// reaches its own arm instead of the attestation check.\n+func TestEvidenceDocumentRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tcases := map[string]func(t *testing.T, universe *fixtureUniverse, object map[string]any){\n+\t\t\"false value\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"value\"] = false\n+\t\t},\n+\t\t\"string value\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"value\"] = \"true\"\n+\t\t},\n+\t\t\"expires equal observed\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"expires_at\"] = object[\"observed_at\"]\n+\t\t},\n+\t\t\"expires before observed\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"expires_at\"] = \"2024-01-01T00:00:00.000Z\"\n+\t\t},\n+\t\t\"unknown fact\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"facts\"] = []any{\"fixture_passed\", \"good_vibes\"}\n+\t\t},\n+\t\t\"unsorted facts\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"facts\"] = []any{\"runtime_probe_passed\", \"fixture_passed\"}\n+\t\t},\n+\t\t\"empty facts\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"facts\"] = []any{}\n+\t\t},\n+\t\t\"unknown issuer\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"issuer\"] = \"self\"\n+\t\t},\n+\t\t\"bad signature scheme\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"attestation_signature\"] = \"sha256:abcd\"\n+\t\t},\n+\t\t\"bad signature encoding\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"attestation_signature\"] = \"rsa-sha256:!!!\"\n+\t\t},\n+\t\t\"realm members on plain claim\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"terminal_binding_id\"] = testDigest(0xB1)\n+\t\t\tobject[\"provider_id\"] = \"codex\"\n+\t\t\tobject[\"provider_build\"] = \"1.0\"\n+\t\t\tobject[\"sentinel_result\"] = \"passed\"\n+\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n+\t\t},\n+\t\t\"bad provider id\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n+\t\t\tobject[\"terminal_binding_id\"] = testDigest(0xB1)\n+\t\t\tobject[\"provider_id\"] = \"Codex!!\"\n+\t\t\tobject[\"provider_build\"] = \"1.0\"\n+\t\t\tobject[\"sentinel_result\"] = \"passed\"\n+\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n+\t\t},\n+\t\t\"half provider pair\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n+\t\t\tobject[\"terminal_binding_id\"] = testDigest(0xB1)\n+\t\t\tobject[\"provider_id\"] = \"codex\"\n+\t\t\tobject[\"provider_build\"] = nil\n+\t\t\tobject[\"sentinel_result\"] = \"passed\"\n+\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n+\t\t},\n+\t\t\"failed sentinel literal\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n+\t\t\tobject[\"terminal_binding_id\"] = testDigest(0xB1)\n+\t\t\tobject[\"provider_id\"] = \"codex\"\n+\t\t\tobject[\"provider_build\"] = \"1.0\"\n+\t\t\tobject[\"sentinel_result\"] = \"failed\"\n+\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n+\t\t},\n+\t\t\"unknown capability\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"capability\"] = \"teleportation\"\n+\t\t},\n+\t\t\"numeric fact\": func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n+\t\t\tobject[\"facts\"] = []any{\"fixture_passed\", float64(7)}\n+\t\t},\n+\t}\n+\tfor name, mutate := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.evidenceByCap[\"durable_disconnect\"])\n+\t\t\tmutate(t, universe, object)\n+\t\t\t// Realm mutations change the capability row, so re-signing\n+\t\t\t// still reaches the intended arm: the signature stays valid.\n+\t\t\tdelete(object, \"attestation_signature\")\n+\t\t\tobject[\"attestation_signature\"] = \"\"\n+\t\t\ttestSignBody(t, universe.key, object)\n+\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n+\t\t\tif _, err := terminalbackend.ParseEvidence(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseEvidence() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// reconcileFixture parses one possibly-mutated universe into typed values.\n+func reconcileFixture(t *testing.T, universe *fixtureUniverse) (terminalbackend.Manifest, terminalbackend.Probe, []terminalbackend.Evidence) {\n+\tt.Helper()\n+\n+\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n+\tif err != nil {\n+\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n+\t}\n+\tprobe, err := terminalbackend.ParseProbe(mustMarshal(t, universe.probe))\n+\tif err != nil {\n+\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n+\t}\n+\tevidence := make([]terminalbackend.Evidence, 0, len(universe.evidenceByCap))\n+\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n+\t\tobject, known := universe.evidenceByCap[capability]\n+\t\tif !known {\n+\t\t\tcontinue\n+\t\t}\n+\t\tparsed, err := terminalbackend.ParseEvidence(mustMarshal(t, object))\n+\t\tif err != nil {\n+\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", capability, err)\n+\t\t}\n+\t\tevidence = append(evidence, parsed)\n+\t}\n+\treturn manifest, probe, evidence\n+}\n+\n+// TestReconcileRefusals proves every admission arm fails closed with its\n+// exact wire code. Each case moves exactly one input and re-finalizes\n+// identities (and re-signs evidence when an unsigned field moves) so the\n+// failure lands on the intended arm.\n+func TestReconcileRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tcases := map[string]struct {\n+\t\tmutate func(t *testing.T, universe *fixtureUniverse)\n+\t\tcheck  func(t *testing.T, err error)\n+\t}{\n+\t\t\"version mismatch\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tuniverse.probe[\"implementation_version\"] = \"2.2.0\"\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"kind mismatch\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tuniverse.probe[\"implementation_kind\"] = \"native_runtime\"\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"protocol not member\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tuniverse.probe[\"protocol_version\"] = \"1.2.0\"\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"platform not member\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tuniverse.probe[\"platform\"] = \"windows\"\n+\t\t\t\tfor _, object := range universe.evidenceByCap {\n+\t\t\t\t\tobject[\"platform\"] = \"windows\"\n+\t\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t\t}\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"stale generation\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsStaleGeneration(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want stale generation\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"omitted manifest claim\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n+\t\t\t\tuniverse.probe[\"capability_claims\"] = claims[1:]\n+\t\t\t\tkept := []string{\"graceful_stop\", \"headless_creation\", \"local_attach\"}\n+\t\t\t\t_ = kept\n+\t\t\t\tfinalizeProbeIDs(t, universe)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"static echo drift\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n+\t\t\t\tclaims[0].(map[string]any)[\"value\"] = false\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"override of stable claim\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n+\t\t\t\tclaims[0].(map[string]any)[\"origin\"] = \"probed\"\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"true claim without evidence\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tdelete(universe.evidenceByCap, \"graceful_stop\")\n+\t\t\t\tfinalizeProbeIDs(t, universe)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"dangling evidence id\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tdelete(universe.evidenceByCap, \"graceful_stop\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"evidence id superset\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tids := universe.probe[\"evidence_ids\"].([]any)\n+\t\t\t\tuniverse.probe[\"evidence_ids\"] = append(ids, testDigest(0xE1))\n+\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"unreferenced evidence object\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\textra := universe.evidenceMap(\"durable_disconnect\", []any{\"fixture_passed\", \"runtime_probe_passed\"})\n+\t\t\t\tfinalizeEvidence(t, universe.key, extra)\n+\t\t\t\tuniverse.evidenceByCap[\"durable-extra\"] = extra\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"evidence for false claim\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceMap(\"local_attach\", []any{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"})\n+\t\t\t\t// Facts use requirement-mapped names; fix the transcription.\n+\t\t\t\tobject[\"facts\"] = []any{\"fixture_passed\", \"policy_checked\", \"runtime_probe_passed\"}\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t\tuniverse.evidenceByCap[\"local_attach\"] = object\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"expired evidence\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tobject[\"observed_at\"] = \"2024-01-01T00:00:00.000Z\"\n+\t\t\t\tobject[\"expires_at\"] = \"2025-01-01T00:00:00.000Z\"\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"future observed evidence\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tobject[\"observed_at\"] = \"2027-01-01T00:00:00.000Z\"\n+\t\t\t\tobject[\"expires_at\"] = \"2028-01-01T00:00:00.000Z\"\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"wrong generation evidence\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tobject[\"backend_generation_digest\"] = testDigest(0x99)\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"wrong fixture evidence\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tobject[\"conformance_fixture_id\"] = testDigest(0x98)\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"insufficient facts\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tobject[\"facts\"] = []any{\"fixture_passed\"}\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"supplementary facts satisfy nothing\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tobject[\"facts\"] = []any{\"prompt_absent\", \"ui_absent\"}\n+\t\t\t\tfinalizeEvidence(t, universe.key, object)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"split facts across objects\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tfirst := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\tfirst[\"facts\"] = []any{\"fixture_passed\"}\n+\t\t\t\tfinalizeEvidence(t, universe.key, first)\n+\t\t\t\tsecond := universe.evidenceMap(\"graceful_stop\", []any{\"runtime_probe_passed\"})\n+\t\t\t\tfinalizeEvidence(t, universe.key, second)\n+\t\t\t\tuniverse.evidenceByCap[\"graceful-second\"] = second\n+\t\t\t\tfinalizeProbeIDs(t, universe)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"conflicting duplicate evidence\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\toriginal := universe.evidenceByCap[\"graceful_stop\"]\n+\t\t\t\ttwin := cloneMap(t, original)\n+\t\t\t\ttwin[\"facts\"] = []any{\"fixture_passed\", \"runtime_probe_passed\", \"ui_absent\"}\n+\t\t\t\t// Keep the same evidence_id with different bytes: conflict.\n+\t\t\t\tfinalizeEvidenceKeepID(t, universe.key, twin)\n+\t\t\t\tuniverse.evidenceByCap[\"graceful-twin\"] = twin\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsMismatch(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want mismatch\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"wrong key signature\": {\n+\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n+\t\t\t\tother := testKey(t)\n+\t\t\t\tfor _, object := range universe.evidenceByCap {\n+\t\t\t\t\tdelete(object, \"attestation_signature\")\n+\t\t\t\t\tobject[\"attestation_signature\"] = \"\"\n+\t\t\t\t\ttestSignBody(t, other, object)\n+\t\t\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n+\t\t\t\t}\n+\t\t\t\tfinalizeProbeIDs(t, universe)\n+\t\t\t},\n+\t\t\tcheck: func(t *testing.T, err error) {\n+\t\t\t\tif !terminalbackend.IsIntegrityFailure(err) {\n+\t\t\t\t\tt.Errorf(\"error = %v, want integrity failure\", err)\n+\t\t\t\t}\n+\t\t\t},\n+\t\t},\n+\t\t\"nil verifier\": {\n+\t\t\tmutate: \n[diff truncated]\n"}}}
