{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b9","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":183,"recorded_at":1780531400000361,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"task_stream":{"kind":"task","id":"a5961b02-c408-4b6b-9a65-45fae618a732"},"task_id":"a5961b02-c408-4b6b-9a65-45fae618a732","event":{"kind":"output","task_id":"a5961b02-c408-4b6b-9a65-45fae618a732","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(499 line(s) above)\n500|func DefaultForPlatform(platform scalar.Platform) (string, error) {\n501|\tswitch platform {\n502|\tcase scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2:\n503|\t\treturn BuiltinTmux, nil\n504|\tcase scalar.PlatformWindows:\n505|\t\treturn BuiltinConpty, nil\n506|\tdefault:\n507|\t\treturn \"\", &Error{Code: CodeNotFound, Detail: \"platform vocabulary\"}\n508|\t}\n509|}\n510|\n511|// RequireRestoreBinding resolves the exact prior binding for restore or\n512|// resume (§4.B, §6.5). The candidate must equal the bound backend ID; using\n513|// the current configured default instead is CodeRestoreMismatch. The bound ID\n514|// must be registered: unknown or unsupported IDs remain visible but cannot\n515|// activate.\n516|func (registry *Registry) RequireRestoreBinding(boundBackendID, candidateBackendID string) (Registration, error) {\n517|\tif registry == nil {\n518|\t\treturn Registration{}, &Error{Code: CodeNotFound, Detail: \"registry unavailable\"}\n519|\t}\n520|\tbound, err := ParseID(boundBackendID)\n521|\tif err != nil {\n522|\t\treturn Registration{}, err\n523|\t}\n524|\tcandidate, err := ParseID(candidateBackendID)\n525|\tif err != nil {\n526|\t\treturn Registration{}, err\n527|\t}\n528|\tif candidate != bound {\n529|\t\treturn Registration{}, &Error{Code: CodeRestoreMismatch, BackendID: candidate, Detail: \"restore requires the prior binding\"}\n530|\t}\n531|\treturn registry.Resolve(bound)\n532|}\n533|\n534|// CheckVersionTuple admits one (implementation_version, protocol_version)\n535|// pair against the admitted protocol list: the implementation must be\n536|// semver, the protocol must be semver in Terminal Backend Protocol major 1\n537|// and exactly one member of the list. Array-to-scalar selection is\n538|// membership, not aggregate equality (§4.B).\n539|func CheckVersionTuple(backendID, implementationVersion, protocolVersion string, protocolVersions []string) error {\n540|\tif !semverPattern.MatchString(implementationVersion) {\n541|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"implementation_version semver\"}\n542|\t}\n543|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n544|\t\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version major 1\"}\n545|\t}\n546|\tfor _, member := range protocolVersions {\n547|\t\tif protocolVersion == member {\n548|\t\t\treturn nil\n549|\t\t}\n550|\t}\n551|\treturn &Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_version membership\"}\n552|}\n553|\n554|// InstanceBinding is the validated host-local binding subset a §7.A provider\n555|// descriptor must match: backend ID, versions, and generation.\n556|type InstanceBinding struct {\n557|\tBackendID             string\n558|\tImplementationVersion string\n559|\tProtocolVersion       string\n560|\tGeneration            string\n561|}\n562|\n563|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n564|// a descriptor whose backend ID, versions, or generation do not match the\n565|// AX-validated host-local binding before launching or observing a provider\n566|// process. Generation lengths 0 and over 256 are invalid; 256 is accepted.\n567|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n568|\tif err := checkGeneration(descriptor.Generation); err != nil {\n569|\t\treturn err\n570|\t}\n571|\tif err := checkGeneration(binding.Generation); err != nil {\n572|\t\treturn err\n573|\t}\n574|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n575|\t\treturn err\n576|\t}\n577|\tif descriptor.BackendID != binding.BackendID {\n578|\t\treturn &Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"}\n579|\t}\n580|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n581|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n582|\t\treturn &Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"}\n583|\t}\n584|\tif descriptor.Generation != binding.Generation {\n585|\t\treturn &Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"}\n586|\t}\n587|\treturn nil\n588|}\n589|\n590|// checkGeneration enforces string[1..256] measured in bytes over valid UTF-8.\n591|func checkGeneration(generation string) error {\n592|\tif !utf8.ValidString(generation) || len(generation) < 1 || len(generation) > maxGenerationBytes {\n593|\t\treturn &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n594|\t}\n595|\treturn nil\n596|}\n597|\n598|// DigestFile returns the sha256: digest of the executable at path after\n599|// resolving symlinks. The target must be a regular file; anything else (or a\n600|// read failure) is an error, never a digest. It distinguishes a failed read\n601|// from an absent trust entry: callers must not fall back to PATH discovery.\n602|func DigestFile(path string) (string, error) {\n603|\tresolved, err := filepath.EvalSymlinks(path)\n604|\tif err != nil {\n605|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n606|\t}\n607|\tinfo, err := os.Stat(resolved)\n608|\tif err != nil {\n609|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n610|\t}\n611|\tif !info.Mode().IsRegular() {\n612|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n613|\t}\n614|\traw, err := os.ReadFile(resolved)\n615|\tif err != nil {\n616|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n617|\t}\n618|\tsum := sha256.Sum256(raw)\n619|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n620|}"}}}
