kend_stale_generation\\\",\\n\\t} {\\n\\t\\tif !known[code] {\\n\\t\\t\\tt.Errorf(\\\"wire code %q is not in the pinned catalog error vocabulary\\\", code)\\n\\t\\t}\\n\\t}\\n}\\n\\n// TestParseIDAdmitsCanonicalIdentities proves the gate is reachable: the two\\n// canonical built-ins, minimal and maximal bounds, and vendor namespaces.\\nfunc TestParseIDAdmitsCanonicalIdentities(t *testing.T) {\\n\\tt.Parallel()\\n\\n\\taccepted := []string{\\n\\t\\tterminalbackend.BuiltinTmux,\\n\\t\\tterminalbackend.BuiltinConpty,\\n\\t\\t\\\"a\\\",\\n\\t\\t\\\"tmux\\\",\\n\\t\\t\\\"ax-tmux\\\",\\n\\t\\t\\\"vendor.backend-1\\\",\\n\\t\\t\\\"a0.b1-c2.d3\\\",\\n\\t\\t\\\"example.terminal-backend\\\",\\n\\t\\t\\\"a\\\" + strings.Repeat(\\\"0\\\", 127),\\n\\t}\\n\\tfor _, id := range accepted {\\n\\t\\tif _, err := terminalbackend.ParseID(id); err != nil {\\n\\t\\t\\tt.Errorf(\\\"ParseID(%q) error = %v, want admission\\\", id, err)\\n\\t\\t}\\n\\t}\\n}\\n\\n// TestParseIDRefusesWidenedGrammar narrows the gate instead of only deleting\\n// it: every case widens exactly one part of the declared character class,\\n===\\n65:func TestWireCodesAreCatalogued(t *testing.T) {\\n88:func TestParseIDAdmitsCanonicalIdentities(t *testing.T) {\\n113:func TestParseIDRefusesWidenedGrammar(t *testing.T) {\\n155:func TestParseIDRefusesReservedNamespace(t *testing.T) {\\n167:func TestNewAdmitsCanonicalBuiltins(t *testing.T) {\\n204:func TestNewRefusesBadVersionTuples(t *testing.T) {\\n258:func TestRegisterExternalRoundTrip(t *testing.T) {\\n281:func TestRegisterExternalAdmitsFullPlatformSet(t *testing.T) {\\n312:func TestRegisterExternalRefusals(t *testing.T) {\\n390:func TestDuplicateRegistrationIsRefused(t *testing.T) {\\n415:func TestDriftIsRefused(t *testing.T) {\\n480:func TestRegistryCopiesSlicesAcrossItsBoundary(t *testing.T) {\\n561:func TestRegisterExternalRefusesPlatformViolations(t *testing.T) {\\n606:func TestRegisterExternalRefusesUnknownKindAsUntrusted(t *testing.T) {\\n625:func TestRegisterExternalRefusesReservedNamespaceDistinguishingValue(t *testing.T) {\\n642:func TestResolveUnknownIsNeverAbsence(t *testing.T) {\\n662:func TestDefaultForPlatform(t *testing.T) {\\n687:func TestRequireRestoreBinding(t *testing.T) {\\n713:func TestCheckVersionTuple(t *testing.T) {\\n745:func TestCheckProviderDescriptor(t *testing.T) {\\n782:func TestCheckProviderDescriptorGenerationBounds(t *testing.T) {\\n833:func TestCheckProviderDescriptorGenerationMismatch(t *testing.T) {\\n852:func TestDigestFile(t *testing.T) {\\n903:func TestErrorPredicatesAreExclusive(t *testing.T) {\\n\",\n  \"original_output_bytes\": 3135,\n  \"original_output_tokens\": 784,\n  \"truncated\": false\n}"}}}
