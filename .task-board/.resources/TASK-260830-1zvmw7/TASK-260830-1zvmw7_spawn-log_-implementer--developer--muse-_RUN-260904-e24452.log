{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c993","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":804,"recorded_at":1780531400001603,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"task_stream":{"kind":"task","id":"8f66ead1-7e19-4328-9e7f-35253f89ed2f"},"task_id":"8f66ead1-7e19-4328-9e7f-35253f89ed2f","event":{"kind":"output","task_id":"8f66ead1-7e19-4328-9e7f-35253f89ed2f","chunk":"edited\nchanged lines: lines 348-362\n--- original\n+++ updated\n@@\n-// cloneMap deep-copies a fixture map through JSON so mutations never leak\n-// between cases.\n-func cloneMap(t *testing.T, object map[string]any) map[string]any {\n-\tt.Helper()\n-\n-\traw, err := json.Marshal(object)\n-\tif err != nil {\n-\t\tt.Fatalf(\"marshal clone: %v\", err)\n-\t}\n-\tvar cloned map[string]any\n-\tif err := json.Unmarshal(raw, &cloned); err != nil {\n-\t\tt.Fatalf(\"unmarshal clone: %v\", err)\n-\t}\n-\treturn cloned\n-}\n+// cloneMap deep-copies a fixture map through JSON so mutations never leak\n+// between cases.\n+func cloneMap(t *testing.T, object map[string]any) map[string]any {\n+\tt.Helper()\n+\n+\traw, err := json.Marshal(object)\n+\tif err != nil {\n+\t\tt.Fatalf(\"marshal clone: %v\", err)\n+\t}\n+\tvar cloned map[string]any\n+\tif err := json.Unmarshal(raw, &cloned); err != nil {\n+\t\tt.Fatalf(\"unmarshal clone: %v\", err)\n+\t}\n+\treturn cloned\n+}\n+\n+// TestParseManifestAdmitsClosedFixture proves the positive gate is\n+// reachable and pins the typed projection of every member.\n+func TestParseManifestAdmitsClosedFixture(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n+\tif err != nil {\n+\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n+\t}\n+\tif manifest.TerminalBackendID != terminalbackend.BuiltinTmux {\n+\t\tt.Errorf(\"TerminalBackendID = %q\", manifest.TerminalBackendID)\n+\t}\n+\tif manifest.ImplementationVersion != \"2.1.0\" {\n+\t\tt.Errorf(\"ImplementationVersion = %q\", manifest.ImplementationVersion)\n+\t}\n+\tif len(manifest.ProtocolVersions) != 2 || manifest.ProtocolVersions[1] != \"1.1.0\" {\n+\t\tt.Errorf(\"ProtocolVersions = %v\", manifest.ProtocolVersions)\n+\t}\n+\tif len(manifest.Platforms) != 3 || manifest.Platforms[0].String() != \"linux\" {\n+\t\tt.Errorf(\"Platforms = %v\", manifest.Platforms)\n+\t}\n+\tif manifest.ImplementationKind != terminalbackend.KindBuiltinGo {\n+\t\tt.Errorf(\"ImplementationKind = %q\", manifest.ImplementationKind)\n+\t}\n+\tif manifest.ExecutableDigest != \"\" {\n+\t\tt.Errorf(\"ExecutableDigest = %q, want null\", manifest.ExecutableDigest)\n+\t}\n+\tif len(manifest.StaticCapabilityClaims) != 3 {\n+\t\tt.Fatalf(\"StaticCapabilityClaims = %d, want 3\", len(manifest.StaticCapabilityClaims))\n+\t}\n+\tif manifest.StaticCapabilityClaims[0].Capability != \"durable_disconnect\" {\n+\t\tt.Errorf(\"first claim = %q\", manifest.StaticCapabilityClaims[0].Capability)\n+\t}\n+\tif manifest.ConformanceFixtureID != universe.fixtureID {\n+\t\tt.Errorf(\"ConformanceFixtureID = %q\", manifest.ConformanceFixtureID)\n+\t}\n+\tif manifest.ManifestID != universe.manifest[\"manifest_id\"] {\n+\t\tt.Errorf(\"ManifestID = %q, want recomputed identity\", manifest.ManifestID)\n+\t}\n+}\n+\n+// TestGenerationDigestGolden pins the domain-separated recipe: SHA-256 over\n+// UTF-8 \"ax-terminal-backend-generation-v1\" + NUL + raw generation bytes.\n+// The expected value was computed with an independent SHA-256 oracle, so a\n+// separator change fails here rather than hiding behind agreement.\n+func TestGenerationDigestGolden(t *testing.T) {\n+\tt.Parallel()\n+\n+\tdigest, err := terminalbackend.GenerationDigest(\"generation-alpha\")\n+\tif err != nil {\n+\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n+\t}\n+\tconst want = \"sha256:PLACEHOLDER_GENERATION_DIGEST\"\n+\tif digest != want {\n+\t\tt.Errorf(\"GenerationDigest() = %q, want %q\", digest, want)\n+\t}\n+}\n+\n+// TestGenerationDigestBounds proves the raw generation domain fails closed:\n+// empty (which would make every backend share one digest), over-long, and\n+// invalid UTF-8 derive nothing.\n+func TestGenerationDigestBounds(t *testing.T) {\n+\tt.Parallel()\n+\n+\tfor _, raw := range []string{\"\", strings.Repeat(\"g\", 257), \"ok\\xffbad\", strings.Repeat(\"g\", 0)} {\n+\t\tif _, err := terminalbackend.GenerationDigest(raw); !terminalbackend.IsStaleGeneration(err) {\n+\t\t\tt.Errorf(\"GenerationDigest(%q) error = %v, want terminal_backend_stale_generation\", raw, err)\n+\t\t}\n+\t}\n+\tif _, err := terminalbackend.GenerationDigest(strings.Repeat(\"g\", 256)); err != nil {\n+\t\tt.Errorf(\"GenerationDigest(256 bytes) error = %v, want admission\", err)\n+\t}\n+}\n+\n+// TestReconcileAdmitsCoherentTuple is the positive admission: static echo,\n+// same-value override, differing override, false claim, and probed addition\n+// reconcile to exactly the true evidenced claims.\n+func TestReconcileAdmitsCoherentTuple(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tmanifest, probe, evidence := universe.parsed(t)\n+\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key))\n+\tif err != nil {\n+\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n+\t}\n+\twant := []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"}\n+\tif fmt.Sprint(admitted.Capabilities) != fmt.Sprint(want) {\n+\t\tt.Errorf(\"Capabilities = %v, want %v\", admitted.Capabilities, want)\n+\t}\n+\tif len(admitted.EvidenceIDs) != 3 {\n+\t\tt.Errorf(\"EvidenceIDs = %v, want 3 proved IDs\", admitted.EvidenceIDs)\n+\t}\n+\tif !admitted.Has(\"headless_creation\") || admitted.Has(\"local_attach\") {\n+\t\tt.Errorf(\"Has() over %v misreports overrides\", admitted.Capabilities)\n+\t}\n+\tif !admitted.HasOperation(\"create\") || admitted.HasOperation(\"attach\") {\n+\t\tt.Errorf(\"HasOperation() over %v misreports dependencies\", admitted.Capabilities)\n+\t}\n+\tif err := terminalbackend.CheckOperation(\"create\", admitted); err != nil {\n+\t\tt.Errorf(\"CheckOperation(create) error = %v, want admission\", err)\n+\t}\n+\tif err := terminalbackend.CheckOperation(\"attach\", admitted); !terminalbackend.IsCapabilityUnproven(err) {\n+\t\tt.Errorf(\"CheckOperation(attach) error = %v, want terminal_backend_capability_unproven\", err)\n+\t}\n+}\n+\n+// TestManifestDocumentRefusals narrows the closed-schema gate: each case\n+// widens exactly one member class and must fail with mismatch.\n+func TestManifestDocumentRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tcases := map[string]func(t *testing.T, object map[string]any){\n+\t\t\"unknown member\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"sponsor\"] = \"evil\"\n+\t\t},\n+\t\t\"missing member\": func(t *testing.T, object map[string]any) {\n+\t\t\tdelete(object, \"platforms\")\n+\t\t},\n+\t\t\"non-empty extensions\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"extensions\"] = map[string]any{\"v2\": true}\n+\t\t},\n+\t\t\"absent extensions\": func(t *testing.T, object map[string]any) {\n+\t\t\tdelete(object, \"extensions\")\n+\t\t},\n+\t\t\"wrong schema\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"schema\"] = \"urn:ax:schema:terminal-backend-probe\"\n+\t\t},\n+\t\t\"wrong version\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"schema_version\"] = \"2.0.0\"\n+\t\t},\n+\t\t\"unknown capability\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"capability\"] = \"teleportation\"\n+\t\t},\n+\t\t\"probed origin in manifest\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"origin\"] = \"probed\"\n+\t\t},\n+\t\t\"flipped generation variable\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"generation_variable\"] = true\n+\t\t},\n+\t\t\"redefined operations\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"create\"}\n+\t\t},\n+\t\t\"unknown operation in claim\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"create\", \"launch\"}\n+\t\t},\n+\t\t\"empty operations\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{}\n+\t\t},\n+\t\t\"unsorted operations\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"status\", \"create\"}\n+\t\t},\n+\t\t\"unknown requirement\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"evidence_requirements\"] = []any{\"conformance_fixture\", \"vibes\"}\n+\t\t},\n+\t\t\"duplicate claims\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tobject[\"static_capability_claims\"] = append(claims, claims[0])\n+\t\t},\n+\t\t\"unsorted claims\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tobject[\"static_capability_claims\"] = []any{claims[2], claims[1], claims[0]}\n+\t\t},\n+\t\t\"bad semver\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"implementation_version\"] = \"2.1\"\n+\t\t},\n+\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_versions\"] = []any{\"1.0.0\", \"2.0.0\"}\n+\t\t},\n+\t\t\"unsorted protocols\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_versions\"] = []any{\"1.1.0\", \"1.0.0\"}\n+\t\t},\n+\t\t\"empty protocols\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_versions\"] = []any{}\n+\t\t},\n+\t\t\"unknown platform\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"platforms\"] = []any{\"amigaos\"}\n+\t\t},\n+\t\t\"unsorted platforms\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"platforms\"] = []any{\"macos\", \"linux\", \"wsl2\"}\n+\t\t},\n+\t\t\"digest on builtin\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"executable_digest\"] = testDigest(0xAA)\n+\t\t},\n+\t\t\"bad digest\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"implementation_kind\"] = \"local_program\"\n+\t\t\tobject[\"executable_digest\"] = \"not-a-digest\"\n+\t\t},\n+\t\t\"reserved backend id\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"terminal_backend_id\"] = \"ax.evil\"\n+\t\t},\n+\t\t\"bad fixture id\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"conformance_fixture_id\"] = \"sha256:zzz\"\n+\t\t},\n+\t\t\"numeric member\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"implementation_version\"] = float64(2)\n+\t\t},\n+\t}\n+\tfor name, mutate := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.manifest)\n+\t\t\tmutate(t, object)\n+\t\t\tfinalizeDocument(t, object, \"manifest_id\")\n+\t\t\tif _, err := terminalbackend.ParseManifest(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// TestManifestEncodingRefusals proves malformed reads fail closed: syntax,\n+// duplicate, encoding, depth, shape, and identity failures are mismatch,\n+// never absence.\n+func TestManifestEncodingRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tvalid := mustMarshal(t, universe.manifest)\n+\tdeep := strings.Repeat(\"[\", 40) + strings.Repeat(\"]\", 40)\n+\n+\tcases := map[string][]byte{\n+\t\t\"empty\":        {},\n+\t\t\"truncated\":    valid[:len(valid)/2],\n+\t\t\"not json\":     []byte(\"manifest\"),\n+\t\t\"top array\":    []byte(\"[]\"),\n+\t\t\"top string\":   []byte(`\"manifest\"`),\n+\t\t\"trailing\":     append(append([]byte{}, valid...), []byte(\" {}\")...),\n+\t\t\"duplicate\":    []byte(`{\"schema\":\"urn:ax:schema:terminal-backend-manifest\",\"schema\":\"urn:ax:schema:terminal-backend-manifest\"}`),\n+\t\t\"invalid utf8\": append(append([]byte{}, valid...), 0xff),\n+\t\t\"deep nesting\": []byte(`{\"schema\":\"x\",\"nest\":` + deep + `}`),\n+\t\t\"null\":         []byte(\"null\"),\n+\t}\n+\tfor name, raw := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tif _, err := terminalbackend.ParseManifest(raw); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// TestManifestIdentityMismatch proves the reader recomputes the ID: a valid\n+// shape with a foreign digest is refused.\n+func TestManifestIdentityMismatch(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tobject := cloneMap(t, universe.manifest)\n+\tobject[\"manifest_id\"] = testDigest(0xDD)\n+\tif _, err := terminalbackend.ParseManifest(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t}\n+}\n+\n+// TestProbeDocumentRefusals narrows the probe closed-schema gate the same\n+// way, including the probe-only members.\n+func TestProbeDocumentRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tcases := map[string]func(t *testing.T, object map[string]any){\n+\t\t\"static claim without manifest echo\": func(t *testing.T, object map[string]any) {\n+\t\t\t// Parses: cross-document reconciliation owns this refusal.\n+\t\t\tclaims := object[\"capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"value\"] = false\n+\t\t},\n+\t\t\"unknown availability\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"availability\"] = \"sometimes\"\n+\t\t},\n+\t\t\"bad os version\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"os_version\"] = \"\"\n+\t\t},\n+\t\t\"bad platform\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"platform\"] = \"plan9\"\n+\t\t},\n+\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_version\"] = \"2.0.0\"\n+\t\t},\n+\t\t\"unsorted evidence ids\": func(t *testing.T, object map[string]any) {\n+\t\t\tids := object[\"evidence_ids\"].([]any)\n+\t\t\tfor left, right := 0, len(ids)-1; left < right; left, right = left+1, right-1 {\n+\t\t\t\tids[left], ids[right] = ids[right], ids[left]\n+\t\t\t}\n+\t\t},\n+\t\t\"duplicate evidence ids\": func(t *testing.T, object map[string]any) {\n+\t\t\tids := object[\"evidence_ids\"].([]any)\n+\t\t\tobject[\"evidence_ids\"] = append(ids, ids[0])\n+\t\t},\n+\t\t\"malformed evidence id\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"evidence_ids\"] = []any{\"nope\"}\n+\t\t},\n+\t\t\"bad timestamp\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"probed_at\"] = \"2026-01-15 12:00:00\"\n+\t\t},\n+\t\t\"timestamp without fraction\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"probed_at\"] = \"2026-01-15T12:00:00Z\"\n+\t\t},\n+\t\t\"non-empty extensions\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"extensions\"] = map[string]any{\"x\": 1}\n+\t\t},\n+\t}\n+\tfor name, mutate := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tif name == \"static claim without manifest echo\" {\n+\t\t\t\tt.Skip(\"covered by reconciliation tests; parses by design\")\n+\t\t\t}\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.probe)\n+\t\t\tmutate(t, object)\n+\t\t\tfinalizeDocument(t, object, \"probe_id\")\n+\t\t\tif _, err := terminalbackend.ParseProbe(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseProbe() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c995","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":805,"recorded_at":1780531400001605,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"task_stream":{"kind":"task","id":"8f66ead1-7e19-4328-9e7f-35253f89ed2f"},"task_id":"8f66ead1-7e19-4328-9e7f-35253f89ed2f","event":{"kind":"completed","task_id":"8f66ead1-7e19-4328-9e7f-35253f89ed2f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c997","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":806,"recorded_at":1780531400001607,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"call_id":"call_01a06ec1317776d2bcb530b84ae71e19","text":"edited\nchanged lines: lines 348-362\n--- original\n+++ updated\n@@\n-// cloneMap deep-copies a fixture map through JSON so mutations never leak\n-// between cases.\n-func cloneMap(t *testing.T, object map[string]any) map[string]any {\n-\tt.Helper()\n-\n-\traw, err := json.Marshal(object)\n-\tif err != nil {\n-\t\tt.Fatalf(\"marshal clone: %v\", err)\n-\t}\n-\tvar cloned map[string]any\n-\tif err := json.Unmarshal(raw, &cloned); err != nil {\n-\t\tt.Fatalf(\"unmarshal clone: %v\", err)\n-\t}\n-\treturn cloned\n-}\n+// cloneMap deep-copies a fixture map through JSON so mutations never leak\n+// between cases.\n+func cloneMap(t *testing.T, object map[string]any) map[string]any {\n+\tt.Helper()\n+\n+\traw, err := json.Marshal(object)\n+\tif err != nil {\n+\t\tt.Fatalf(\"marshal clone: %v\", err)\n+\t}\n+\tvar cloned map[string]any\n+\tif err := json.Unmarshal(raw, &cloned); err != nil {\n+\t\tt.Fatalf(\"unmarshal clone: %v\", err)\n+\t}\n+\treturn cloned\n+}\n+\n+// TestParseManifestAdmitsClosedFixture proves the positive gate is\n+// reachable and pins the typed projection of every member.\n+func TestParseManifestAdmitsClosedFixture(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n+\tif err != nil {\n+\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n+\t}\n+\tif manifest.TerminalBackendID != terminalbackend.BuiltinTmux {\n+\t\tt.Errorf(\"TerminalBackendID = %q\", manifest.TerminalBackendID)\n+\t}\n+\tif manifest.ImplementationVersion != \"2.1.0\" {\n+\t\tt.Errorf(\"ImplementationVersion = %q\", manifest.ImplementationVersion)\n+\t}\n+\tif len(manifest.ProtocolVersions) != 2 || manifest.ProtocolVersions[1] != \"1.1.0\" {\n+\t\tt.Errorf(\"ProtocolVersions = %v\", manifest.ProtocolVersions)\n+\t}\n+\tif len(manifest.Platforms) != 3 || manifest.Platforms[0].String() != \"linux\" {\n+\t\tt.Errorf(\"Platforms = %v\", manifest.Platforms)\n+\t}\n+\tif manifest.ImplementationKind != terminalbackend.KindBuiltinGo {\n+\t\tt.Errorf(\"ImplementationKind = %q\", manifest.ImplementationKind)\n+\t}\n+\tif manifest.ExecutableDigest != \"\" {\n+\t\tt.Errorf(\"ExecutableDigest = %q, want null\", manifest.ExecutableDigest)\n+\t}\n+\tif len(manifest.StaticCapabilityClaims) != 3 {\n+\t\tt.Fatalf(\"StaticCapabilityClaims = %d, want 3\", len(manifest.StaticCapabilityClaims))\n+\t}\n+\tif manifest.StaticCapabilityClaims[0].Capability != \"durable_disconnect\" {\n+\t\tt.Errorf(\"first claim = %q\", manifest.StaticCapabilityClaims[0].Capability)\n+\t}\n+\tif manifest.ConformanceFixtureID != universe.fixtureID {\n+\t\tt.Errorf(\"ConformanceFixtureID = %q\", manifest.ConformanceFixtureID)\n+\t}\n+\tif manifest.ManifestID != universe.manifest[\"manifest_id\"] {\n+\t\tt.Errorf(\"ManifestID = %q, want recomputed identity\", manifest.ManifestID)\n+\t}\n+}\n+\n+// TestGenerationDigestGolden pins the domain-separated recipe: SHA-256 over\n+// UTF-8 \"ax-terminal-backend-generation-v1\" + NUL + raw generation bytes.\n+// The expected value was computed with an independent SHA-256 oracle, so a\n+// separator change fails here rather than hiding behind agreement.\n+func TestGenerationDigestGolden(t *testing.T) {\n+\tt.Parallel()\n+\n+\tdigest, err := terminalbackend.GenerationDigest(\"generation-alpha\")\n+\tif err != nil {\n+\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n+\t}\n+\tconst want = \"sha256:PLACEHOLDER_GENERATION_DIGEST\"\n+\tif digest != want {\n+\t\tt.Errorf(\"GenerationDigest() = %q, want %q\", digest, want)\n+\t}\n+}\n+\n+// TestGenerationDigestBounds proves the raw generation domain fails closed:\n+// empty (which would make every backend share one digest), over-long, and\n+// invalid UTF-8 derive nothing.\n+func TestGenerationDigestBounds(t *testing.T) {\n+\tt.Parallel()\n+\n+\tfor _, raw := range []string{\"\", strings.Repeat(\"g\", 257), \"ok\\xffbad\", strings.Repeat(\"g\", 0)} {\n+\t\tif _, err := terminalbackend.GenerationDigest(raw); !terminalbackend.IsStaleGeneration(err) {\n+\t\t\tt.Errorf(\"GenerationDigest(%q) error = %v, want terminal_backend_stale_generation\", raw, err)\n+\t\t}\n+\t}\n+\tif _, err := terminalbackend.GenerationDigest(strings.Repeat(\"g\", 256)); err != nil {\n+\t\tt.Errorf(\"GenerationDigest(256 bytes) error = %v, want admission\", err)\n+\t}\n+}\n+\n+// TestReconcileAdmitsCoherentTuple is the positive admission: static echo,\n+// same-value override, differing override, false claim, and probed addition\n+// reconcile to exactly the true evidenced claims.\n+func TestReconcileAdmitsCoherentTuple(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tmanifest, probe, evidence := universe.parsed(t)\n+\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, universe.rawGeneration, universe.now, testVerifier(universe.key))\n+\tif err != nil {\n+\t\tt.Fatalf(\"Reconcile() error = %v\", err)\n+\t}\n+\twant := []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"}\n+\tif fmt.Sprint(admitted.Capabilities) != fmt.Sprint(want) {\n+\t\tt.Errorf(\"Capabilities = %v, want %v\", admitted.Capabilities, want)\n+\t}\n+\tif len(admitted.EvidenceIDs) != 3 {\n+\t\tt.Errorf(\"EvidenceIDs = %v, want 3 proved IDs\", admitted.EvidenceIDs)\n+\t}\n+\tif !admitted.Has(\"headless_creation\") || admitted.Has(\"local_attach\") {\n+\t\tt.Errorf(\"Has() over %v misreports overrides\", admitted.Capabilities)\n+\t}\n+\tif !admitted.HasOperation(\"create\") || admitted.HasOperation(\"attach\") {\n+\t\tt.Errorf(\"HasOperation() over %v misreports dependencies\", admitted.Capabilities)\n+\t}\n+\tif err := terminalbackend.CheckOperation(\"create\", admitted); err != nil {\n+\t\tt.Errorf(\"CheckOperation(create) error = %v, want admission\", err)\n+\t}\n+\tif err := terminalbackend.CheckOperation(\"attach\", admitted); !terminalbackend.IsCapabilityUnproven(err) {\n+\t\tt.Errorf(\"CheckOperation(attach) error = %v, want terminal_backend_capability_unproven\", err)\n+\t}\n+}\n+\n+// TestManifestDocumentRefusals narrows the closed-schema gate: each case\n+// widens exactly one member class and must fail with mismatch.\n+func TestManifestDocumentRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tcases := map[string]func(t *testing.T, object map[string]any){\n+\t\t\"unknown member\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"sponsor\"] = \"evil\"\n+\t\t},\n+\t\t\"missing member\": func(t *testing.T, object map[string]any) {\n+\t\t\tdelete(object, \"platforms\")\n+\t\t},\n+\t\t\"non-empty extensions\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"extensions\"] = map[string]any{\"v2\": true}\n+\t\t},\n+\t\t\"absent extensions\": func(t *testing.T, object map[string]any) {\n+\t\t\tdelete(object, \"extensions\")\n+\t\t},\n+\t\t\"wrong schema\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"schema\"] = \"urn:ax:schema:terminal-backend-probe\"\n+\t\t},\n+\t\t\"wrong version\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"schema_version\"] = \"2.0.0\"\n+\t\t},\n+\t\t\"unknown capability\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"capability\"] = \"teleportation\"\n+\t\t},\n+\t\t\"probed origin in manifest\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"origin\"] = \"probed\"\n+\t\t},\n+\t\t\"flipped generation variable\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"generation_variable\"] = true\n+\t\t},\n+\t\t\"redefined operations\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"create\"}\n+\t\t},\n+\t\t\"unknown operation in claim\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"create\", \"launch\"}\n+\t\t},\n+\t\t\"empty operations\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{}\n+\t\t},\n+\t\t\"unsorted operations\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"dependent_operations\"] = []any{\"status\", \"create\"}\n+\t\t},\n+\t\t\"unknown requirement\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"evidence_requirements\"] = []any{\"conformance_fixture\", \"vibes\"}\n+\t\t},\n+\t\t\"duplicate claims\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tobject[\"static_capability_claims\"] = append(claims, claims[0])\n+\t\t},\n+\t\t\"unsorted claims\": func(t *testing.T, object map[string]any) {\n+\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n+\t\t\tobject[\"static_capability_claims\"] = []any{claims[2], claims[1], claims[0]}\n+\t\t},\n+\t\t\"bad semver\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"implementation_version\"] = \"2.1\"\n+\t\t},\n+\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_versions\"] = []any{\"1.0.0\", \"2.0.0\"}\n+\t\t},\n+\t\t\"unsorted protocols\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_versions\"] = []any{\"1.1.0\", \"1.0.0\"}\n+\t\t},\n+\t\t\"empty protocols\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_versions\"] = []any{}\n+\t\t},\n+\t\t\"unknown platform\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"platforms\"] = []any{\"amigaos\"}\n+\t\t},\n+\t\t\"unsorted platforms\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"platforms\"] = []any{\"macos\", \"linux\", \"wsl2\"}\n+\t\t},\n+\t\t\"digest on builtin\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"executable_digest\"] = testDigest(0xAA)\n+\t\t},\n+\t\t\"bad digest\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"implementation_kind\"] = \"local_program\"\n+\t\t\tobject[\"executable_digest\"] = \"not-a-digest\"\n+\t\t},\n+\t\t\"reserved backend id\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"terminal_backend_id\"] = \"ax.evil\"\n+\t\t},\n+\t\t\"bad fixture id\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"conformance_fixture_id\"] = \"sha256:zzz\"\n+\t\t},\n+\t\t\"numeric member\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"implementation_version\"] = float64(2)\n+\t\t},\n+\t}\n+\tfor name, mutate := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.manifest)\n+\t\t\tmutate(t, object)\n+\t\t\tfinalizeDocument(t, object, \"manifest_id\")\n+\t\t\tif _, err := terminalbackend.ParseManifest(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// TestManifestEncodingRefusals proves malformed reads fail closed: syntax,\n+// duplicate, encoding, depth, shape, and identity failures are mismatch,\n+// never absence.\n+func TestManifestEncodingRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tvalid := mustMarshal(t, universe.manifest)\n+\tdeep := strings.Repeat(\"[\", 40) + strings.Repeat(\"]\", 40)\n+\n+\tcases := map[string][]byte{\n+\t\t\"empty\":        {},\n+\t\t\"truncated\":    valid[:len(valid)/2],\n+\t\t\"not json\":     []byte(\"manifest\"),\n+\t\t\"top array\":    []byte(\"[]\"),\n+\t\t\"top string\":   []byte(`\"manifest\"`),\n+\t\t\"trailing\":     append(append([]byte{}, valid...), []byte(\" {}\")...),\n+\t\t\"duplicate\":    []byte(`{\"schema\":\"urn:ax:schema:terminal-backend-manifest\",\"schema\":\"urn:ax:schema:terminal-backend-manifest\"}`),\n+\t\t\"invalid utf8\": append(append([]byte{}, valid...), 0xff),\n+\t\t\"deep nesting\": []byte(`{\"schema\":\"x\",\"nest\":` + deep + `}`),\n+\t\t\"null\":         []byte(\"null\"),\n+\t}\n+\tfor name, raw := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tif _, err := terminalbackend.ParseManifest(raw); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+// TestManifestIdentityMismatch proves the reader recomputes the ID: a valid\n+// shape with a foreign digest is refused.\n+func TestManifestIdentityMismatch(t *testing.T) {\n+\tt.Parallel()\n+\n+\tuniverse := testUniverse(t)\n+\tobject := cloneMap(t, universe.manifest)\n+\tobject[\"manifest_id\"] = testDigest(0xDD)\n+\tif _, err := terminalbackend.ParseManifest(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\tt.Errorf(\"ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t}\n+}\n+\n+// TestProbeDocumentRefusals narrows the probe closed-schema gate the same\n+// way, including the probe-only members.\n+func TestProbeDocumentRefusals(t *testing.T) {\n+\tt.Parallel()\n+\n+\tcases := map[string]func(t *testing.T, object map[string]any){\n+\t\t\"static claim without manifest echo\": func(t *testing.T, object map[string]any) {\n+\t\t\t// Parses: cross-document reconciliation owns this refusal.\n+\t\t\tclaims := object[\"capability_claims\"].([]any)\n+\t\t\tclaims[0].(map[string]any)[\"value\"] = false\n+\t\t},\n+\t\t\"unknown availability\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"availability\"] = \"sometimes\"\n+\t\t},\n+\t\t\"bad os version\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"os_version\"] = \"\"\n+\t\t},\n+\t\t\"bad platform\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"platform\"] = \"plan9\"\n+\t\t},\n+\t\t\"protocol major 2\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"protocol_version\"] = \"2.0.0\"\n+\t\t},\n+\t\t\"unsorted evidence ids\": func(t *testing.T, object map[string]any) {\n+\t\t\tids := object[\"evidence_ids\"].([]any)\n+\t\t\tfor left, right := 0, len(ids)-1; left < right; left, right = left+1, right-1 {\n+\t\t\t\tids[left], ids[right] = ids[right], ids[left]\n+\t\t\t}\n+\t\t},\n+\t\t\"duplicate evidence ids\": func(t *testing.T, object map[string]any) {\n+\t\t\tids := object[\"evidence_ids\"].([]any)\n+\t\t\tobject[\"evidence_ids\"] = append(ids, ids[0])\n+\t\t},\n+\t\t\"malformed evidence id\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"evidence_ids\"] = []any{\"nope\"}\n+\t\t},\n+\t\t\"bad timestamp\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"probed_at\"] = \"2026-01-15 12:00:00\"\n+\t\t},\n+\t\t\"timestamp without fraction\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"probed_at\"] = \"2026-01-15T12:00:00Z\"\n+\t\t},\n+\t\t\"non-empty extensions\": func(t *testing.T, object map[string]any) {\n+\t\t\tobject[\"extensions\"] = map[string]any{\"x\": 1}\n+\t\t},\n+\t}\n+\tfor name, mutate := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tif name == \"static claim without manifest echo\" {\n+\t\t\t\tt.Skip(\"covered by reconciliation tests; parses by design\")\n+\t\t\t}\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.probe)\n+\t\t\tmutate(t, object)\n+\t\t\tfinalizeDocument(t, object, \"probe_id\")\n+\t\t\tif _, err := terminalbackend.ParseProbe(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseProbe() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminalbackend/manifest_test.go","added":347,"removed":15},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
