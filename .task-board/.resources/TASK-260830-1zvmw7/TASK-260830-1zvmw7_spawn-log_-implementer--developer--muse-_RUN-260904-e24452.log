{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca55","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":901,"recorded_at":1780531400001797,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"call_id":"call_01a06ec2c6b17fd08253ca666d390e23","text":"edited\nchanged lines: lines 765-783\n--- original\n+++ updated\n@@\n-\tfor name, mutate := range cases {\n-\t\tt.Run(name, func(t *testing.T) {\n-\t\t\tt.Parallel()\n-\n-\t\t\tuniverse := testUniverse(t)\n-\t\t\tobject := cloneMap(t, universe.evidenceByCap[\"durable_disconnect\"])\n-\t\t\tmutate(t, universe, object)\n-\t\t\t// Realm mutations change the capability row, so re-signing\n-\t\t\t// still reaches the intended arm: the signature stays valid.\n-\t\t\tdelete(object, \"attestation_signature\")\n-\t\t\tobject[\"attestation_signature\"] = \"\"\n-\t\t\ttestSignBody(t, universe.key, object)\n-\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n-\t\t\tif _, err := terminalbackend.ParseEvidence(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n-\t\t\t\tt.Errorf(\"ParseEvidence() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n-\t\t\t}\n-\t\t})\n-\t}\n-}\n+\tfor name, mutate := range cases {\n+\t\tt.Run(name, func(t *testing.T) {\n+\t\t\tt.Parallel()\n+\n+\t\t\tuniverse := testUniverse(t)\n+\t\t\tobject := cloneMap(t, universe.evidenceByCap[\"durable_disconnect\"])\n+\t\t\tmutate(t, universe, object)\n+\t\t\t// Only the identity is re-stamped: parsing never verifies\n+\t\t\t// the attestation, so the original signature stays a valid\n+\t\t\t// bystander and every case reaches its own structural arm.\n+\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n+\t\t\tif _, err := terminalbackend.ParseEvidence(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {\n+\t\t\t\tt.Errorf(\"ParseEvidence() error = %v, want terminal_backend_manifest_probe_mismatch\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminalbackend/manifest_test.go","added":17,"removed":19},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca57","stream":{"kind":"session","id":"01a06eb9-f212-7283-9b75-ad2ced5e882d"},"sequence":902,"recorded_at":1780531400001799,"record_type":"event","durability":"durable","causation_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b","run_stream":{"kind":"run","id":"d7aaf52d-f59b-4e18-a931-19c896b89f9b"},"call_id":"call_01a06ec2cbe175629933a02973a935ba","text":"edited\nchanged lines: lines 795-808\n--- original\n+++ updated\n@@\n-\tevidence := make([]terminalbackend.Evidence, 0, len(universe.evidenceByCap))\n-\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n-\t\tobject, known := universe.evidenceByCap[capability]\n-\t\tif !known {\n-\t\t\tcontinue\n-\t\t}\n-\t\tparsed, err := terminalbackend.ParseEvidence(mustMarshal(t, object))\n-\t\tif err != nil {\n-\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", capability, err)\n-\t\t}\n-\t\tevidence = append(evidence, parsed)\n-\t}\n-\treturn manifest, probe, evidence\n-}\n+\t// Every entry in the evidence set parses, including extras the case\n+\t// added: unlisted or dangling objects are reconciliation refusals,\n+\t// not parse failures.\n+\tnames := make([]string, 0, len(universe.evidenceByCap))\n+\tfor name := range universe.evidenceByCap {\n+\t\tnames = append(names, name)\n+\t}\n+\tsort.Strings(names)\n+\tevidence := make([]terminalbackend.Evidence, 0, len(names))\n+\tfor _, name := range names {\n+\t\tparsed, err := terminalbackend.ParseEvidence(mustMarshal(t, universe.evidenceByCap[name]))\n+\t\tif err != nil {\n+\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", name, err)\n+\t\t}\n+\t\tevidence = append(evidence, parsed)\n+\t}\n+\treturn manifest, probe, evidence\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminalbackend/manifest_test.go","added":18,"removed":14},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
