{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c637","stream":{"kind":"session","id":"01a06f11-bf97-7731-9df0-9b191ed26b77"},"sequence":374,"recorded_at":1780531400000743,"record_type":"event","durability":"durable","causation_id":"d35b2354-966f-42a4-bb95-82d384379b04","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d35b2354-966f-42a4-bb95-82d384379b04","run_stream":{"kind":"run","id":"d35b2354-966f-42a4-bb95-82d384379b04"},"call_id":"call_01a06f1282fd7582a3cb3ddd1b2ef14a","text":"Read text file `internal/terminalbackend/manifest_test.go`.\n(1040 line(s) above)\n1041|\t\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n1042|\t\t\t},\n1043|\t\t\tdetail: \"evidence realm binding\",\n1044|\t\t},\n1045|\t\t\"bad provider id\": {\n1046|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n1047|\t\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n1048|\t\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n1049|\t\t\t\tobject[\"provider_id\"] = \"Codex!!\"\n1050|\t\t\t\tobject[\"provider_build\"] = \"1.0\"\n1051|\t\t\t\tobject[\"sentinel_result\"] = \"passed\"\n1052|\t\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n1053|\t\t\t},\n1054|\t\t\tdetail: \"evidence provider identity\",\n1055|\t\t},\n1056|\t\t\"half provider pair\": {\n1057|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n1058|\t\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n1059|\t\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n1060|\t\t\t\tobject[\"provider_id\"] = \"codex\"\n1061|\t\t\t\tobject[\"provider_build\"] = nil\n1062|\t\t\t\tobject[\"sentinel_result\"] = \"passed\"\n1063|\t\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n1064|\t\t\t},\n1065|\t\t\tdetail: \"evidence realm binding\",\n1066|\t\t},\n1067|\t\t\"failed sentinel literal\": {\n1068|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n1069|\t\t\t\tobject[\"capability\"] = \"credential_capable_execution_realm\"\n1070|\t\t\t\tobject[\"terminal_binding_id\"] = testSeedDigest(0xB1)\n1071|\t\t\t\tobject[\"provider_id\"] = \"codex\"\n1072|\t\t\t\tobject[\"provider_build\"] = \"1.0\"\n1073|\t\t\t\tobject[\"sentinel_result\"] = \"failed\"\n1074|\t\t\t\tobject[\"provider_auth_smoke_result\"] = \"passed\"\n1075|\t\t\t},\n1076|\t\t\tdetail: \"evidence realm result\",\n1077|\t\t},\n1078|\t\t\"overlong os version\": {\n1079|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n1080|\t\t\t\tobject[\"os_version\"] = strings.Repeat(\"o\", 257)\n1081|\t\t\t},\n1082|\t\t\tdetail: \"document string bound\",\n1083|\t\t},\n1084|\t\t\"unknown capability\": {\n1085|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n1086|\t\t\t\tobject[\"capability\"] = \"teleportation\"\n1087|\t\t\t},\n1088|\t\t\tdetail: \"capability vocabulary\",\n1089|\t\t},\n1090|\t\t\"numeric fact\": {\n1091|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse, object map[string]any) {\n1092|\t\t\t\tobject[\"facts\"] = []any{\"fixture_passed\", float64(7)}\n1093|\t\t\t},\n1094|\t\t\tdetail: \"document member type\",\n1095|\t\t},\n1096|\t}\n1097|\tfor name, tc := range cases {\n1098|\t\tt.Run(name, func(t *testing.T) {\n1099|\t\t\tt.Parallel()\n1100|\n1101|\t\t\tuniverse := testUniverse(t)\n1102|\t\t\tobject := cloneMap(t, universe.evidenceByCap[\"durable_disconnect\"])\n1103|\t\t\ttc.mutate(t, universe, object)\n1104|\t\t\t// Only the identity is re-stamped: parsing never verifies\n1105|\t\t\t// the attestation, so the original signature stays a valid\n1106|\t\t\t// bystander and every case reaches its own structural arm.\n1107|\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n1108|\t\t\t_, err := terminalbackend.ParseEvidence(mustMarshal(t, object))\n1109|\t\t\trequireRefusal(t, err, codeMismatch, tc.detail)\n1110|\t\t})\n1111|\t}\n1112|}\n1113|\n1114|// reconcileFixture parses one possibly-mutated universe into typed values.\n1115|func reconcileFixture(t *testing.T, universe *fixtureUniverse) (terminalbackend.Manifest, terminalbackend.Probe, []terminalbackend.Evidence) {\n1116|\tt.Helper()\n1117|\n1118|\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n1119|\tif err != nil {\n1120|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n1121|\t}\n1122|\tprobe, err := terminalbackend.ParseProbe(mustMarshal(t, universe.probe))\n1123|\tif err != nil {\n1124|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n1125|\t}\n1126|\t// Every entry in the evidence set parses, including extras the case\n1127|\t// added: unlisted or dangling objects are reconciliation refusals,\n1128|\t// not parse failures.\n1129|\tnames := make([]string, 0, len(universe.evidenceByCap))\n1130|\tfor name := range universe.evidenceByCap {\n1131|\t\tnames = append(names, name)\n1132|\t}\n1133|\tsort.Strings(names)\n1134|\tevidence := make([]terminalbackend.Evidence, 0, len(names))\n1135|\tfor _, name := range names {\n1136|\t\tparsed, err := terminalbackend.ParseEvidence(mustMarshal(t, universe.evidenceByCap[name]))\n1137|\t\tif err != nil {\n1138|\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", name, err)\n1139|\t\t}\n1140|\t\tevidence = append(evidence, parsed)\n1141|\t}\n1142|\treturn manifest, probe, evidence\n1143|}\n1144|\n1145|// TestReconcileRefusals proves every admission arm fails closed at its own\n1146|// clause. Each case moves exactly one rule's input and re-finalizes\n1147|// identities (and re-signs evidence when an unsigned field moves) so the\n1148|// failure lands on the intended arm — and the assertion names that arm, so\n1149|// deleting the gate fails the test instead of sliding onto a lower arm.\n1150|// Where a downstream arm could catch the same fixture, the fixture is\n1151|// narrowed until only the named rule can reject it.\n1152|func TestReconcileRefusals(t *testing.T) {\n1153|\tt.Parallel()\n1154|\n1155|\tcases := map[string]struct {\n1156|\t\tmutate func(t *testing.T, universe *fixtureUniverse)\n1157|\t\tcode   string\n1158|\t\tdetail string\n1159|\t}{\n1160|\t\t\"version mismatch\": {\n1161|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1162|\t\t\t\tuniverse.probe[\"implementation_version\"] = \"2.2.0\"\n1163|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1164|\t\t\t},\n1165|\t\t\tcode:   codeMismatch,\n1166|\t\t\tdetail: \"probe manifest binding\",\n1167|\t\t},\n1168|\t\t\"kind mismatch\": {\n1169|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1170|\t\t\t\tuniverse.probe[\"implementation_kind\"] = \"native_runtime\"\n1171|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1172|\t\t\t},\n1173|\t\t\tcode:   codeMismatch,\n1174|\t\t\tdetail: \"probe manifest binding\",\n1175|\t\t},\n1176|\t\t// The evidence moves with the probe protocol: without that, a\n1177|\t\t// deleted membership gate slides onto the tuple binding and the\n1178|\t\t// suite stays green. Narrowed, only the membership rule rejects.\n1179|\t\t\"protocol not member\": {\n1180|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1181|\t\t\t\tuniverse.probe[\"protocol_version\"] = \"1.2.0\"\n1182|\t\t\t\tfor _, object := range universe.evidenceByCap {\n1183|\t\t\t\t\tobject[\"protocol_version\"] = \"1.2.0\"\n1184|\t\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1185|\t\t\t\t}\n1186|\t\t\t\tfinalizeProbeIDs(t, universe)\n1187|\t\t\t},\n1188|\t\t\tcode:   codeMismatch,\n1189|\t\t\tdetail: \"probe protocol membership\",\n1190|\t\t},\n1191|\t\t\"platform not member\": {\n1192|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1193|\t\t\t\tuniverse.probe[\"platform\"] = \"windows\"\n1194|\t\t\t\tfor _, object := range universe.evidenceByCap {\n1195|\t\t\t\t\tobject[\"platform\"] = \"windows\"\n1196|\t\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1197|\t\t\t\t}\n1198|\t\t\t\tfinalizeProbeIDs(t, universe)\n1199|\t\t\t},\n1200|\t\t\tcode:   codeMismatch,\n1201|\t\t\tdetail: \"probe platform membership\",\n1202|\t\t},\n1203|\t\t\"stale generation\": {\n1204|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {},\n1205|\t\t\tcode:   codeStaleGeneration,\n1206|\t\t\tdetail: \"probe generation binding\",\n1207|\t\t},\n1208|\t\t// The orphaned durable evidence is withdrawn with the claim:\n1209|\t\t// without that, a deleted omission gate slides onto the claim\n1210|\t\t// binding and the suite stays green. Narrowed, only the\n1211|\t\t// omission rule rejects.\n1212|\t\t\"omitted manifest claim\": {\n1213|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1214|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1215|\t\t\t\tuniverse.probe[\"capability_claims\"] = claims[1:]\n1216|\t\t\t\tdelete(universe.evidenceByCap, \"durable_disconnect\")\n1217|\t\t\t\tfinalizeProbeIDs(t, universe)\n1218|\t\t\t},\n1219|\t\t\tcode:   codeMismatch,\n1220|\t\t\tdetail: \"probe omission of manifest claim\",\n1221|\t\t},\n1222|\t\t// The orphaned durable evidence is withdrawn with the flipped\n1223|\t\t// value: without that, a deleted echo gate slides onto the\n1224|\t\t// claim binding. Narrowed, only the echo rule rejects.\n1225|\t\t\"static echo drift\": {\n1226|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1227|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1228|\t\t\t\tclaims[0].(map[string]any)[\"value\"] = false\n1229|\t\t\t\tdelete(universe.evidenceByCap, \"durable_disconnect\")\n1230|\t\t\t\tfinalizeProbeIDs(t, universe)\n1231|\t\t\t},\n1232|\t\t\tcode:   codeMismatch,\n1233|\t\t\tdetail: \"probe static claim echo\",\n1234|\t\t},\n1235|\t\t\"override of stable claim\": {\n1236|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1237|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1238|\t\t\t\tclaims[0].(map[string]any)[\"origin\"] = \"probed\"\n1239|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1240|\t\t\t},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c639","stream":{"kind":"session","id":"01a06f11-bf97-7731-9df0-9b191ed26b77"},"sequence":375,"recorded_at":1780531400000745,"record_type":"event","durability":"durable","causation_id":"d35b2354-966f-42a4-bb95-82d384379b04","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d35b2354-966f-42a4-bb95-82d384379b04","run_stream":{"kind":"run","id":"d35b2354-966f-42a4-bb95-82d384379b04"},"call_id":"call_01a06f12844c7193b7e9caf3ec4ee33f","text":"Read text file `internal/terminalbackend/manifest_test.go`.\n1|// Black-box contract tests for Manifest/Probe/Capability-Evidence admission.\n2|//\n3|// Every fixture is built as a JSON member map by an independent test-side\n4|// transcription of the Section 4.B/4.D recipe (own identity computation, own\n5|// signature construction over the documented byte recipe), so agreement with\n6|// production proves byte-exact conformance rather than shared-code\n7|// coincidence. Negative cases mutate exactly one arm, re-finalize the\n8|// document identity (and re-sign evidence when an unsigned field moves), and\n9|// assert the exact wire code at the exact gate.\n10|package terminalbackend_test\n11|\n12|import (\n13|\t\"crypto\"\n14|\t\"crypto/rand\"\n15|\t\"crypto/rsa\"\n16|\t\"crypto/sha256\"\n17|\t\"encoding/base64\"\n18|\t\"encoding/hex\"\n19|\t\"encoding/json\"\n20|\t\"errors\"\n21|\t\"fmt\"\n22|\t\"sort\"\n23|\t\"strings\"\n24|\t\"testing\"\n25|\t\"time\"\n26|\n27|\t\"github.com/gowebpki/jcs\"\n28|\n29|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n30|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n31|)\n32|\n33|// requireRefusal asserts err is a registry refusal carrying exactly\n34|// wantCode with the exact static wantDetail clause. Code-only assertions\n35|// cannot hold a gate: ~110 of the 121 refusal arms share one wire code, so\n36|// a deleted gate slides its fixture onto a lower arm and a code-only test\n37|// stays green. Naming the clause makes the gate deletion fail.\n38|func requireRefusal(t *testing.T, err error, wantCode, wantDetail string) {\n39|\tt.Helper()\n40|\n41|\tvar refusal *terminalbackend.Error\n42|\tif !errors.As(err, &refusal) {\n43|\t\tt.Fatalf(\"error = %v, want *Error with code %q at %q\", err, wantCode, wantDetail)\n44|\t}\n45|\tif refusal.Code != wantCode || refusal.Detail != wantDetail {\n46|\t\tt.Errorf(\"refusal = %q at %q, want %q at %q\", refusal.Code, refusal.Detail, wantCode, wantDetail)\n47|\t}\n48|}\n49|\n50|const (\n51|\tcodeMismatch           = \"terminal_backend_manifest_probe_mismatch\"\n52|\tcodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n53|\tcodeIntegrityFailure   = \"terminal_backend_integrity_failure\"\n54|\tcodeUntrusted          = \"terminal_backend_untrusted\"\n55|\tcodeDrift              = \"terminal_backend_implementation_drift\"\n56|\tcodeStaleGeneration    = \"terminal_backend_stale_generation\"\n57|\tcodeNotFound           = \"terminal_backend_not_found\"\n58|)\n59|\n60|// testDigest mints a deterministic fake sha256: digest from one seed byte.\n61|func testSeedDigest(seed byte) string {\n62|\treturn \"sha256:\" + strings.Repeat(fmt.Sprintf(\"%02x\", seed), 32)\n63|}\n64|\n65|// testIdentity computes the Section 4.B omit-self identity with the test's\n66|// own recipe implementation: JCS bytes of the object with the self field\n67|// omitted, SHA-256, lowercase sha256: prefix.\n68|func testIdentity(t *testing.T, object map[string]any, selfField string) string {\n69|\tt.Helper()\n70|\n71|\tomitted := make(map[string]any, len(object))\n72|\tfor name, member := range object {\n73|\t\tif name != selfField {\n74|\t\t\tomitted[name] = member\n75|\t\t}\n76|\t}\n77|\tserialized, err := json.Marshal(omitted)\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n80|\t}\n81|\tcanonical, err := jcs.Transform(serialized)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"canonicalize omit-self object: %v\", err)\n84|\t}\n85|\tsum := sha256.Sum256(canonical)\n86|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n87|}\n88|\n89|// testEvidenceMessage builds the exact bytes an attestation signs per\n90|// Section 4.D: ASCII domain, one zero byte, JCS of the evidence object with\n91|// exactly evidence_id and attestation_signature omitted.\n92|func testEvidenceMessage(t *testing.T, object map[string]any) []byte {\n93|\tt.Helper()\n94|\n95|\tomitted := make(map[string]any, len(object))\n96|\tfor name, member := range object {\n97|\t\tif name != \"evidence_id\" && name != \"attestation_signature\" {\n98|\t\t\tomitted[name] = member\n99|\t\t}\n100|\t}\n101|\tserialized, err := json.Marshal(omitted)\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"marshal unsigned evidence: %v\", err)\n104|\t}\n105|\tcanonical, err := jcs.Transform(serialized)\n106|\tif err != nil {\n107|\t\tt.Fatalf(\"canonicalize unsigned evidence: %v\", err)\n108|\t}\n109|\tmessage := append([]byte(\"ax-terminal-capability-evidence-v1\"), 0x00)\n110|\treturn append(message, canonical...)\n111|}\n112|\n113|// testKey generates one RSA attestation key for the test run.\n114|func testKey(t *testing.T) *rsa.PrivateKey {\n115|\tt.Helper()\n116|\n117|\tkey, err := rsa.GenerateKey(rand.Reader, 1024)\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"generate attestation key: %v\", err)\n120|\t}\n121|\treturn key\n122|}\n123|\n124|// testSignBody signs the Section 4.D message for object with key and writes\n125|// the attestation_signature member.\n126|func testSignBody(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n127|\tt.Helper()\n128|\n129|\tmessage := testEvidenceMessage(t, object)\n130|\tdigest := sha256.Sum256(message)\n131|\tsignature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])\n132|\tif err != nil {\n133|\t\tt.Fatalf(\"sign evidence: %v\", err)\n134|\t}\n135|\tobject[\"attestation_signature\"] = \"rsa-sha256:\" + base64.StdEncoding.EncodeToString(signature)\n136|}\n137|\n138|// finalizeEvidence signs object with key and stamps its recomputed\n139|// evidence_id, yielding a fully valid evidence document map.\n140|func finalizeEvidence(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n141|\tt.Helper()\n142|\n143|\ttestSignBody(t, key, object)\n144|\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n145|}\n146|\n147|// finalizeDocument stamps the recomputed omit-self identity on a manifest\n148|// or probe document map.\n149|func finalizeDocument(t *testing.T, object map[string]any, selfField string) {\n150|\tt.Helper()\n151|\n152|\tobject[selfField] = testIdentity(t, object, selfField)\n153|}\n154|\n155|// mustMarshal encodes a fixture map to JSON bytes.\n156|func mustMarshal(t *testing.T, object map[string]any) []byte {\n157|\tt.Helper()\n158|\n159|\traw, err := json.Marshal(object)\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"marshal fixture: %v\", err)\n162|\t}\n163|\treturn raw\n164|}\n165|\n166|// testVerifier authenticates evidence through one trusted key: it verifies\n167|// the RSA signature and fails on anything else, mirroring the production\n168|// contract that a caller-supplied issuer ID alone is never authentication.\n169|func testVerifier(key *rsa.PrivateKey) terminalbackend.SignatureVerifier {\n170|\treturn func(issuerID string, message, signature []byte) error {\n171|\t\tdigest := sha256.Sum256(message)\n172|\t\treturn rsa.VerifyPKCS1v15(&key.PublicKey, crypto.SHA256, digest[:], signature)\n173|\t}\n174|}\n175|\n176|// claimMap transcribes one registry-row claim. The row members are copied\n177|// from the Section 4.D table, not from production, so row drift fails.\n178|func claimMap(capability, origin string, value bool) map[string]any {\n179|\trows := map[string]map[string]any{\n180|\t\t\"durable_disconnect\": {\n181|\t\t\t\"generation_variable\":   false,\n182|\t\t\t\"dependent_operations\":  []any{\"create\", \"status\"},\n183|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n184|\t\t},\n185|\t\t\"local_attach\": {\n186|\t\t\t\"generation_variable\":   true,\n187|\t\t\t\"dependent_operations\":  []any{\"attach\"},\n188|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n189|\t\t},\n190|\t\t\"headless_creation\": {\n191|\t\t\t\"generation_variable\":   true,\n192|\t\t\t\"dependent_operations\":  []any{\"create\"},\n193|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n194|\t\t},\n195|\t\t\"graceful_stop\": {\n196|\t\t\t\"generation_variable\":   true,\n197|\t\t\t\"dependent_operations\":  []any{\"request-stop\"},\n198|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n199|\t\t},\n200|\t\t\"credential_capable_execution_realm\": {\n201|\t\t\t\"generation_variable\":  true,\n202|\t\t\t\"dependent_operations\": []any{\"create\", \"restore\"},\n203|\t\t\t\"evidence_requirements\": []any{\n204|\t\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n205|\t\t\t},\n206|\t\t},\n207|\t}\n208|\trow := rows[capability]\n209|\treturn map[string]any{\n210|\t\t\"capability\":            capability,\n211|\t\t\"origin\":                origin,\n212|\t\t\"value\":                 value,\n213|\t\t\"generation_variable\":   row[\"generation_variable\"],\n214|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n215|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n216|\t}\n217|}\n218|\n219|// fixtureUniverse is one coherent admission world: a builtin manifest,\n220|// its probe (static echo, same-value override, differing override, false\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
