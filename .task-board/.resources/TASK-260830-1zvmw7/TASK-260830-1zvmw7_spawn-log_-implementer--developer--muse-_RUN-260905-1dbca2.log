{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c5","stream":{"kind":"session","id":"01a06f11-bf97-7731-9df0-9b191ed26b77"},"sequence":445,"recorded_at":1780531400000885,"record_type":"event","durability":"durable","causation_id":"d35b2354-966f-42a4-bb95-82d384379b04","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d35b2354-966f-42a4-bb95-82d384379b04","run_stream":{"kind":"run","id":"d35b2354-966f-42a4-bb95-82d384379b04"},"task_stream":{"kind":"task","id":"0358804f-1ed7-42da-bff4-e978e83a2754"},"task_id":"0358804f-1ed7-42da-bff4-e978e83a2754","event":{"kind":"output","task_id":"0358804f-1ed7-42da-bff4-e978e83a2754","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n(599 line(s) above)\n600|\t\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n601|\t\t\t\tobject[\"static_capability_claims\"] = append(claims, claims[0])\n602|\t\t\t},\n603|\t\t\tdetail: \"claim ordering\",\n604|\t\t},\n605|\t\t// An adjacent duplicate in sorted position is refused only by\n606|\t\t// the duplicate half of the ordering gate: narrowing >= to >\n607|\t\t// admits it, so this case holds that half.\n608|\t\t\"adjacent duplicate claims\": {\n609|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n610|\t\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n611|\t\t\t\tobject[\"static_capability_claims\"] = []any{claims[0], claims[1], claims[1], claims[2]}\n612|\t\t\t},\n613|\t\t\tdetail: \"claim ordering\",\n614|\t\t},\n615|\t\t\"unsorted claims\": {\n616|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n617|\t\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n618|\t\t\t\tobject[\"static_capability_claims\"] = []any{claims[2], claims[1], claims[0]}\n619|\t\t\t},\n620|\t\t\tdetail: \"claim ordering\",\n621|\t\t},\n622|\t\t\"claim list bound\": {\n623|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n624|\t\t\t\tclaims := object[\"static_capability_claims\"].([]any)\n625|\t\t\t\tbloated := make([]any, 0, 17)\n626|\t\t\t\tfor len(bloated) < 17 {\n627|\t\t\t\t\tbloated = append(bloated, claims...)\n628|\t\t\t\t}\n629|\t\t\t\tobject[\"static_capability_claims\"] = bloated[:17]\n630|\t\t\t},\n631|\t\t\tdetail: \"claim list bound\",\n632|\t\t},\n633|\t\t\"bad semver\": {\n634|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n635|\t\t\t\tobject[\"implementation_version\"] = \"2.1\"\n636|\t\t\t},\n637|\t\t\tdetail: \"document semver\",\n638|\t\t},\n639|\t\t\"protocol major 2\": {\n640|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n641|\t\t\t\tobject[\"protocol_versions\"] = []any{\"1.0.0\", \"2.0.0\"}\n642|\t\t\t},\n643|\t\t\tdetail: \"protocol versions major 1\",\n644|\t\t},\n645|\t\t\"unsorted protocols\": {\n646|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n647|\t\t\t\tobject[\"protocol_versions\"] = []any{\"1.1.0\", \"1.0.0\"}\n648|\t\t\t},\n649|\t\t\tdetail: \"protocol versions ordering\",\n650|\t\t},\n651|\t\t\"empty protocols\": {\n652|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n653|\t\t\t\tobject[\"protocol_versions\"] = []any{}\n654|\t\t\t},\n655|\t\t\tdetail: \"protocol versions bound\",\n656|\t\t},\n657|\t\t\"unknown platform\": {\n658|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n659|\t\t\t\tobject[\"platforms\"] = []any{\"amigaos\"}\n660|\t\t\t},\n661|\t\t\tdetail: \"platforms vocabulary\",\n662|\t\t},\n663|\t\t\"unsorted platforms\": {\n664|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n665|\t\t\t\tobject[\"platforms\"] = []any{\"macos\", \"linux\", \"wsl2\"}\n666|\t\t\t},\n667|\t\t\tdetail: \"platforms ordering\",\n668|\t\t},\n669|\t\t\"empty platforms\": {\n670|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n671|\t\t\t\tobject[\"platforms\"] = []any{}\n672|\t\t\t},\n673|\t\t\tdetail: \"platforms bound\",\n674|\t\t},\n675|\t\t\"unknown implementation kind\": {\n676|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n677|\t\t\t\tobject[\"implementation_kind\"] = \"container_image\"\n678|\t\t\t},\n679|\t\t\tdetail: \"manifest implementation kind\",\n680|\t\t},\n681|\t\t\"digest on builtin\": {\n682|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n683|\t\t\t\tobject[\"executable_digest\"] = testSeedDigest(0xAA)\n684|\t\t\t},\n685|\t\t\tdetail: \"manifest executable digest\",\n686|\t\t},\n687|\t\t\"bad digest\": {\n688|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n689|\t\t\t\tobject[\"implementation_kind\"] = \"local_program\"\n690|\t\t\t\tobject[\"executable_digest\"] = \"not-a-digest\"\n691|\t\t\t},\n692|\t\t\tdetail: \"document digest\",\n693|\t\t},\n694|\t\t\"reserved backend id\": {\n695|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n696|\t\t\t\tobject[\"terminal_backend_id\"] = \"ax.evil\"\n697|\t\t\t},\n698|\t\t\tdetail: \"manifest backend identity\",\n699|\t\t},\n700|\t\t\"bad fixture id\": {\n701|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n702|\t\t\t\tobject[\"conformance_fixture_id\"] = \"sha256:zzz\"\n703|\t\t\t},\n704|\t\t\tdetail: \"document digest\",\n705|\t\t},\n706|\t\t\"numeric member\": {\n707|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n708|\t\t\t\tobject[\"implementation_version\"] = float64(2)\n709|\t\t\t},\n710|\t\t\tdetail: \"document member type\",\n711|\t\t},\n712|\t}\n713|\tfor name, tc := range cases {\n714|\t\tt.Run(name, func(t *testing.T) {\n715|\t\t\tt.Parallel()\n716|\n717|\t\t\tuniverse := testUniverse(t)\n718|\t\t\tobject := cloneMap(t, universe.manifest)\n719|\t\t\ttc.mutate(t, object)\n720|\t\t\tfinalizeDocument(t, object, \"manifest_id\")\n721|\t\t\t_, err := terminalbackend.ParseManifest(mustMarshal(t, object))\n722|\t\t\trequireRefusal(t, err, codeMismatch, tc.detail)\n723|\t\t})\n724|\t}\n725|}\n726|\n727|// TestManifestEncodingRefusals proves malformed reads fail closed: syntax,\n728|// duplicate, encoding, depth, shape, and identity failures are mismatch,\n729|// never absence.\n730|func TestManifestEncodingRefusals(t *testing.T) {\n731|\tt.Parallel()\n732|\n733|\tuniverse := testUniverse(t)\n734|\tvalid := mustMarshal(t, universe.manifest)\n735|\tdeep := strings.Repeat(\"[\", 40) + strings.Repeat(\"]\", 40)\n736|\n737|\tcases := map[string]struct {\n738|\t\traw    []byte\n739|\t\tdetail string\n740|\t}{\n741|\t\t\"empty\":        {raw: []byte{}, detail: \"document syntax\"},\n742|\t\t\"truncated\":    {raw: valid[:len(valid)/2], detail: \"document syntax\"},\n743|\t\t\"not json\":     {raw: []byte(\"manifest\"), detail: \"document syntax\"},\n744|\t\t\"top array\":    {raw: []byte(\"[]\"), detail: \"document shape\"},\n745|\t\t\"top string\":   {raw: []byte(`\"manifest\"`), detail: \"document shape\"},\n746|\t\t\"trailing\":     {raw: append(append([]byte{}, valid...), []byte(\" {}\")...), detail: \"document trailing data\"},\n747|\t\t\"duplicate\":    {raw: []byte(`{\"schema\":\"urn:ax:schema:terminal-backend-manifest\",\"schema\":\"urn:ax:schema:terminal-backend-manifest\"}`), detail: \"document duplicate member\"},\n748|\t\t\"invalid utf8\": {raw: append(append([]byte{}, valid...), 0xff), detail: \"document encoding\"},\n749|\t\t\"deep nesting\": {raw: []byte(`{\"schema\":\"x\",\"nest\":` + deep + `}`), detail: \"document nesting\"},\n750|\t\t\"null\":         {raw: []byte(\"null\"), detail: \"document shape\"},\n751|\t}\n752|\tfor name, tc := range cases {\n753|\t\tt.Run(name, func(t *testing.T) {\n754|\t\t\tt.Parallel()\n755|\n756|\t\t\t_, err := terminalbackend.ParseManifest(tc.raw)\n757|\t\t\trequireRefusal(t, err, codeMismatch, tc.detail)\n758|\t\t})\n759|\t}\n760|}\n761|\n762|// TestManifestIdentityMismatch proves the reader recomputes the ID: a valid\n763|// shape with a foreign digest is refused.\n764|func TestManifestIdentityMismatch(t *testing.T) {\n765|\tt.Parallel()\n766|\n767|\tuniverse := testUniverse(t)\n768|\tobject := cloneMap(t, universe.manifest)\n769|\tobject[\"manifest_id\"] = testSeedDigest(0xDD)\n770|\t_, err := terminalbackend.ParseManifest(mustMarshal(t, object))\n771|\trequireRefusal(t, err, codeMismatch, \"document identity binding\")\n772|}\n773|\n774|// TestProbeDocumentRefusals narrows the probe closed-schema gate: the same\n775|// schema, version, identity, kind, and digest classes the manifest parser\n776|// pins, at the probe's own clauses, plus the probe-only members.\n777|func TestProbeDocumentRefusals(t *testing.T) {\n778|\tt.Parallel()\n779|\n(more lines below)"}}}
