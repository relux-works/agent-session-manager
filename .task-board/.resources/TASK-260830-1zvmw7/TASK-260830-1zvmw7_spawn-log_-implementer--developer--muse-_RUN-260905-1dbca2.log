{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62f","stream":{"kind":"session","id":"01a06f11-bf97-7731-9df0-9b191ed26b77"},"sequence":370,"recorded_at":1780531400000735,"record_type":"event","durability":"durable","causation_id":"d35b2354-966f-42a4-bb95-82d384379b04","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d35b2354-966f-42a4-bb95-82d384379b04","run_stream":{"kind":"run","id":"d35b2354-966f-42a4-bb95-82d384379b04"},"task_stream":{"kind":"task","id":"3079969e-3ade-48e7-9c8d-50542d0e6037"},"task_id":"3079969e-3ade-48e7-9c8d-50542d0e6037","event":{"kind":"output","task_id":"3079969e-3ade-48e7-9c8d-50542d0e6037","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n1|// Black-box contract tests for Manifest/Probe/Capability-Evidence admission.\n2|//\n3|// Every fixture is built as a JSON member map by an independent test-side\n4|// transcription of the Section 4.B/4.D recipe (own identity computation, own\n5|// signature construction over the documented byte recipe), so agreement with\n6|// production proves byte-exact conformance rather than shared-code\n7|// coincidence. Negative cases mutate exactly one arm, re-finalize the\n8|// document identity (and re-sign evidence when an unsigned field moves), and\n9|// assert the exact wire code at the exact gate.\n10|package terminalbackend_test\n11|\n12|import (\n13|\t\"crypto\"\n14|\t\"crypto/rand\"\n15|\t\"crypto/rsa\"\n16|\t\"crypto/sha256\"\n17|\t\"encoding/base64\"\n18|\t\"encoding/hex\"\n19|\t\"encoding/json\"\n20|\t\"errors\"\n21|\t\"fmt\"\n22|\t\"sort\"\n23|\t\"strings\"\n24|\t\"testing\"\n25|\t\"time\"\n26|\n27|\t\"github.com/gowebpki/jcs\"\n28|\n29|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n30|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n31|)\n32|\n33|// requireRefusal asserts err is a registry refusal carrying exactly\n34|// wantCode with the exact static wantDetail clause. Code-only assertions\n35|// cannot hold a gate: ~110 of the 121 refusal arms share one wire code, so\n36|// a deleted gate slides its fixture onto a lower arm and a code-only test\n37|// stays green. Naming the clause makes the gate deletion fail.\n38|func requireRefusal(t *testing.T, err error, wantCode, wantDetail string) {\n39|\tt.Helper()\n40|\n41|\tvar refusal *terminalbackend.Error\n42|\tif !errors.As(err, &refusal) {\n43|\t\tt.Fatalf(\"error = %v, want *Error with code %q at %q\", err, wantCode, wantDetail)\n44|\t}\n45|\tif refusal.Code != wantCode || refusal.Detail != wantDetail {\n46|\t\tt.Errorf(\"refusal = %q at %q, want %q at %q\", refusal.Code, refusal.Detail, wantCode, wantDetail)\n47|\t}\n48|}\n49|\n50|const (\n51|\tcodeMismatch           = \"terminal_backend_manifest_probe_mismatch\"\n52|\tcodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n53|\tcodeIntegrityFailure   = \"terminal_backend_integrity_failure\"\n54|\tcodeUntrusted          = \"terminal_backend_untrusted\"\n55|\tcodeDrift              = \"terminal_backend_implementation_drift\"\n56|\tcodeStaleGeneration    = \"terminal_backend_stale_generation\"\n57|\tcodeNotFound           = \"terminal_backend_not_found\"\n58|)\n59|\n60|// testDigest mints a deterministic fake sha256: digest from one seed byte.\n61|func testSeedDigest(seed byte) string {\n62|\treturn \"sha256:\" + strings.Repeat(fmt.Sprintf(\"%02x\", seed), 32)\n63|}\n64|\n65|// testIdentity computes the Section 4.B omit-self identity with the test's\n66|// own recipe implementation: JCS bytes of the object with the self field\n67|// omitted, SHA-256, lowercase sha256: prefix.\n68|func testIdentity(t *testing.T, object map[string]any, selfField string) string {\n69|\tt.Helper()\n70|\n71|\tomitted := make(map[string]any, len(object))\n72|\tfor name, member := range object {\n73|\t\tif name != selfField {\n74|\t\t\tomitted[name] = member\n75|\t\t}\n76|\t}\n77|\tserialized, err := json.Marshal(omitted)\n78|\tif err != nil {\n79|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n80|\t}\n81|\tcanonical, err := jcs.Transform(serialized)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"canonicalize omit-self object: %v\", err)\n84|\t}\n85|\tsum := sha256.Sum256(canonical)\n86|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n87|}\n88|\n89|// testEvidenceMessage builds the exact bytes an attestation signs per\n90|// Section 4.D: ASCII domain, one zero byte, JCS of the evidence object with\n91|// exactly evidence_id and attestation_signature omitted.\n92|func testEvidenceMessage(t *testing.T, object map[string]any) []byte {\n93|\tt.Helper()\n94|\n95|\tomitted := make(map[string]any, len(object))\n96|\tfor name, member := range object {\n97|\t\tif name != \"evidence_id\" && name != \"attestation_signature\" {\n98|\t\t\tomitted[name] = member\n99|\t\t}\n100|\t}\n101|\tserialized, err := json.Marshal(omitted)\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"marshal unsigned evidence: %v\", err)\n104|\t}\n105|\tcanonical, err := jcs.Transform(serialized)\n106|\tif err != nil {\n107|\t\tt.Fatalf(\"canonicalize unsigned evidence: %v\", err)\n108|\t}\n109|\tmessage := append([]byte(\"ax-terminal-capability-evidence-v1\"), 0x00)\n110|\treturn append(message, canonical...)\n111|}\n112|\n113|// testKey generates one RSA attestation key for the test run.\n114|func testKey(t *testing.T) *rsa.PrivateKey {\n115|\tt.Helper()\n116|\n117|\tkey, err := rsa.GenerateKey(rand.Reader, 1024)\n118|\tif err != nil {\n119|\t\tt.Fatalf(\"generate attestation key: %v\", err)\n120|\t}\n121|\treturn key\n122|}\n123|\n124|// testSignBody signs the Section 4.D message for object with key and writes\n125|// the attestation_signature member.\n126|func testSignBody(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n127|\tt.Helper()\n128|\n129|\tmessage := testEvidenceMessage(t, object)\n130|\tdigest := sha256.Sum256(message)\n131|\tsignature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])\n132|\tif err != nil {\n133|\t\tt.Fatalf(\"sign evidence: %v\", err)\n134|\t}\n135|\tobject[\"attestation_signature\"] = \"rsa-sha256:\" + base64.StdEncoding.EncodeToString(signature)\n136|}\n137|\n138|// finalizeEvidence signs object with key and stamps its recomputed\n139|// evidence_id, yielding a fully valid evidence document map.\n140|func finalizeEvidence(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n141|\tt.Helper()\n142|\n143|\ttestSignBody(t, key, object)\n144|\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n145|}\n146|\n147|// finalizeDocument stamps the recomputed omit-self identity on a manifest\n148|// or probe document map.\n149|func finalizeDocument(t *testing.T, object map[string]any, selfField string) {\n150|\tt.Helper()\n151|\n152|\tobject[selfField] = testIdentity(t, object, selfField)\n153|}\n154|\n155|// mustMarshal encodes a fixture map to JSON bytes.\n156|func mustMarshal(t *testing.T, object map[string]any) []byte {\n157|\tt.Helper()\n158|\n159|\traw, err := json.Marshal(object)\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"marshal fixture: %v\", err)\n162|\t}\n163|\treturn raw\n164|}\n165|\n166|// testVerifier authenticates evidence through one trusted key: it verifies\n167|// the RSA signature and fails on anything else, mirroring the production\n168|// contract that a caller-supplied issuer ID alone is never authentication.\n169|func testVerifier(key *rsa.PrivateKey) terminalbackend.SignatureVerifier {\n170|\treturn func(issuerID string, message, signature []byte) error {\n171|\t\tdigest := sha256.Sum256(message)\n172|\t\treturn rsa.VerifyPKCS1v15(&key.PublicKey, crypto.SHA256, digest[:], signature)\n173|\t}\n174|}\n175|\n176|// claimMap transcribes one registry-row claim. The row members are copied\n177|// from the Section 4.D table, not from production, so row drift fails.\n178|func claimMap(capability, origin string, value bool) map[string]any {\n179|\trows := map[string]map[string]any{\n180|\t\t\"durable_disconnect\": {\n181|\t\t\t\"generation_variable\":   false,\n182|\t\t\t\"dependent_operations\":  []any{\"create\", \"status\"},\n183|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n184|\t\t},\n185|\t\t\"local_attach\": {\n186|\t\t\t\"generation_variable\":   true,\n187|\t\t\t\"dependent_operations\":  []any{\"attach\"},\n188|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n189|\t\t},\n190|\t\t\"headless_creation\": {\n191|\t\t\t\"generation_variable\":   true,\n192|\t\t\t\"dependent_operations\":  []any{\"create\"},\n193|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n194|\t\t},\n195|\t\t\"graceful_stop\": {\n196|\t\t\t\"generation_variable\":   true,\n197|\t\t\t\"dependent_operations\":  []any{\"request-stop\"},\n198|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n199|\t\t},\n200|\t\t\"credential_capable_execution_realm\": {\n201|\t\t\t\"generation_variable\":  true,\n202|\t\t\t\"dependent_operations\": []any{\"create\", \"restore\"},\n203|\t\t\t\"evidence_requirements\": []any{\n204|\t\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n205|\t\t\t},\n206|\t\t},\n207|\t}\n208|\trow := rows[capability]\n209|\treturn map[string]any{\n210|\t\t\"capability\":            capability,\n211|\t\t\"origin\":                origin,\n212|\t\t\"value\":                 value,\n213|\t\t\"generation_variable\":   row[\"generation_variable\"],\n214|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n215|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n216|\t}\n217|}\n218|\n219|// fixtureUniverse is one coherent admission world: a builtin manifest,\n220|// its probe (static echo, same-value override, differing override, false\n(more lines below)"}}}
