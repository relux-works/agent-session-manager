{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fd","stream":{"kind":"session","id":"01a06f11-bf97-7731-9df0-9b191ed26b77"},"sequence":345,"recorded_at":1780531400000685,"record_type":"event","durability":"durable","causation_id":"d35b2354-966f-42a4-bb95-82d384379b04","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d35b2354-966f-42a4-bb95-82d384379b04","run_stream":{"kind":"run","id":"d35b2354-966f-42a4-bb95-82d384379b04"},"task_stream":{"kind":"task","id":"3f5b125a-f0ee-47be-b4f4-38a7c3cc4e85"},"task_id":"3f5b125a-f0ee-47be-b4f4-38a7c3cc4e85","event":{"kind":"output","task_id":"3f5b125a-f0ee-47be-b4f4-38a7c3cc4e85","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n(1144 line(s) above)\n1145|// TestReconcileRefusals proves every admission arm fails closed at its own\n1146|// clause. Each case moves exactly one rule's input and re-finalizes\n1147|// identities (and re-signs evidence when an unsigned field moves) so the\n1148|// failure lands on the intended arm — and the assertion names that arm, so\n1149|// deleting the gate fails the test instead of sliding onto a lower arm.\n1150|// Where a downstream arm could catch the same fixture, the fixture is\n1151|// narrowed until only the named rule can reject it.\n1152|func TestReconcileRefusals(t *testing.T) {\n1153|\tt.Parallel()\n1154|\n1155|\tcases := map[string]struct {\n1156|\t\tmutate func(t *testing.T, universe *fixtureUniverse)\n1157|\t\tcode   string\n1158|\t\tdetail string\n1159|\t}{\n1160|\t\t\"version mismatch\": {\n1161|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1162|\t\t\t\tuniverse.probe[\"implementation_version\"] = \"2.2.0\"\n1163|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1164|\t\t\t},\n1165|\t\t\tcode:   codeMismatch,\n1166|\t\t\tdetail: \"probe manifest binding\",\n1167|\t\t},\n1168|\t\t\"kind mismatch\": {\n1169|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1170|\t\t\t\tuniverse.probe[\"implementation_kind\"] = \"native_runtime\"\n1171|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1172|\t\t\t},\n1173|\t\t\tcode:   codeMismatch,\n1174|\t\t\tdetail: \"probe manifest binding\",\n1175|\t\t},\n1176|\t\t// The evidence moves with the probe protocol: without that, a\n1177|\t\t// deleted membership gate slides onto the tuple binding and the\n1178|\t\t// suite stays green. Narrowed, only the membership rule rejects.\n1179|\t\t\"protocol not member\": {\n1180|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1181|\t\t\t\tuniverse.probe[\"protocol_version\"] = \"1.2.0\"\n1182|\t\t\t\tfor _, object := range universe.evidenceByCap {\n1183|\t\t\t\t\tobject[\"protocol_version\"] = \"1.2.0\"\n1184|\t\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1185|\t\t\t\t}\n1186|\t\t\t\tfinalizeProbeIDs(t, universe)\n1187|\t\t\t},\n1188|\t\t\tcode:   codeMismatch,\n1189|\t\t\tdetail: \"probe protocol membership\",\n1190|\t\t},\n1191|\t\t\"platform not member\": {\n1192|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1193|\t\t\t\tuniverse.probe[\"platform\"] = \"windows\"\n1194|\t\t\t\tfor _, object := range universe.evidenceByCap {\n1195|\t\t\t\t\tobject[\"platform\"] = \"windows\"\n1196|\t\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1197|\t\t\t\t}\n1198|\t\t\t\tfinalizeProbeIDs(t, universe)\n1199|\t\t\t},\n1200|\t\t\tcode:   codeMismatch,\n1201|\t\t\tdetail: \"probe platform membership\",\n1202|\t\t},\n1203|\t\t\"stale generation\": {\n1204|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {},\n1205|\t\t\tcode:   codeStaleGeneration,\n1206|\t\t\tdetail: \"probe generation binding\",\n1207|\t\t},\n1208|\t\t// The orphaned durable evidence is withdrawn with the claim:\n1209|\t\t// without that, a deleted omission gate slides onto the claim\n1210|\t\t// binding and the suite stays green. Narrowed, only the\n1211|\t\t// omission rule rejects.\n1212|\t\t\"omitted manifest claim\": {\n1213|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1214|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1215|\t\t\t\tuniverse.probe[\"capability_claims\"] = claims[1:]\n1216|\t\t\t\tdelete(universe.evidenceByCap, \"durable_disconnect\")\n1217|\t\t\t\tfinalizeProbeIDs(t, universe)\n1218|\t\t\t},\n1219|\t\t\tcode:   codeMismatch,\n1220|\t\t\tdetail: \"probe omission of manifest claim\",\n1221|\t\t},\n1222|\t\t// The orphaned durable evidence is withdrawn with the flipped\n1223|\t\t// value: without that, a deleted echo gate slides onto the\n1224|\t\t// claim binding. Narrowed, only the echo rule rejects.\n1225|\t\t\"static echo drift\": {\n1226|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1227|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1228|\t\t\t\tclaims[0].(map[string]any)[\"value\"] = false\n1229|\t\t\t\tdelete(universe.evidenceByCap, \"durable_disconnect\")\n1230|\t\t\t\tfinalizeProbeIDs(t, universe)\n1231|\t\t\t},\n1232|\t\t\tcode:   codeMismatch,\n1233|\t\t\tdetail: \"probe static claim echo\",\n1234|\t\t},\n1235|\t\t\"override of stable claim\": {\n1236|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1237|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1238|\t\t\t\tclaims[0].(map[string]any)[\"origin\"] = \"probed\"\n1239|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1240|\t\t\t},\n1241|\t\t\tcode:   codeMismatch,\n1242|\t\t\tdetail: \"probe override of stable claim\",\n1243|\t\t},\n1244|\t\t\"true claim without evidence\": {\n1245|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1246|\t\t\t\tdelete(universe.evidenceByCap, \"graceful_stop\")\n1247|\t\t\t\tfinalizeProbeIDs(t, universe)\n1248|\t\t\t},\n1249|\t\t\tcode:   codeMismatch,\n1250|\t\t\tdetail: \"evidence requirement coverage\",\n1251|\t\t},\n1252|\t\t// The withdrawn claim is flipped false so coverage still holds\n1253|\t\t// and only the ID-set rule can reject the stale listing: a bare\n1254|\t\t// deletion lands on coverage instead, which already has a case.\n1255|\t\t\"dangling evidence id\": {\n1256|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1257|\t\t\t\tclaims := universe.probe[\"capability_claims\"].([]any)\n1258|\t\t\t\tclaims[1].(map[string]any)[\"value\"] = false\n1259|\t\t\t\tdelete(universe.evidenceByCap, \"graceful_stop\")\n1260|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1261|\t\t\t},\n1262|\t\t\tcode:   codeMismatch,\n1263|\t\t\tdetail: \"evidence id set binding\",\n1264|\t\t},\n1265|\t\t\"evidence id superset\": {\n1266|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1267|\t\t\t\tids := universe.probe[\"evidence_ids\"].([]any)\n1268|\t\t\t\tids = append(ids, testSeedDigest(0xE1))\n1269|\t\t\t\tnames := make([]string, 0, len(ids))\n1270|\t\t\t\tfor _, id := range ids {\n1271|\t\t\t\t\tnames = append(names, id.(string))\n1272|\t\t\t\t}\n1273|\t\t\t\tsort.Strings(names)\n1274|\t\t\t\tsorted := make([]any, 0, len(names))\n1275|\t\t\t\tfor _, id := range names {\n1276|\t\t\t\t\tsorted = append(sorted, id)\n1277|\t\t\t\t}\n1278|\t\t\t\tuniverse.probe[\"evidence_ids\"] = sorted\n1279|\t\t\t\tfinalizeDocument(t, universe.probe, \"probe_id\")\n1280|\t\t\t},\n1281|\t\t\tcode:   codeMismatch,\n1282|\t\t\tdetail: \"evidence id set binding\",\n1283|\t\t},\n1284|\t\t\"unreferenced evidence object\": {\n1285|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1286|\t\t\t\t// A distinct usable object (supplementary fact changes\n1287|\t\t\t\t// the bytes and the ID) that evidence_ids never lists.\n1288|\t\t\t\textra := universe.evidenceMap(\"durable_disconnect\", []any{\"fixture_passed\", \"runtime_probe_passed\", \"ui_absent\"})\n1289|\t\t\t\tfinalizeEvidence(t, universe.key, extra)\n1290|\t\t\t\tuniverse.evidenceByCap[\"durable-extra\"] = extra\n1291|\t\t\t},\n1292|\t\t\tcode:   codeMismatch,\n1293|\t\t\tdetail: \"evidence id set binding\",\n1294|\t\t},\n1295|\t\t// The false claim's evidence ID is listed on the probe: without\n1296|\t\t// that, a deleted false-claim half slides onto the ID-set rule.\n1297|\t\t// Narrowed, only the claim binding rejects.\n1298|\t\t\"evidence for false claim\": {\n1299|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1300|\t\t\t\tobject := universe.evidenceMap(\"local_attach\", []any{\"fixture_passed\", \"policy_checked\", \"runtime_probe_passed\"})\n1301|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1302|\t\t\t\tuniverse.evidenceByCap[\"local_attach\"] = object\n1303|\t\t\t\tfinalizeProbeIDs(t, universe)\n1304|\t\t\t},\n1305|\t\t\tcode:   codeMismatch,\n1306|\t\t\tdetail: \"evidence claim binding\",\n1307|\t\t},\n1308|\t\t\"expired evidence\": {\n1309|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1310|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1311|\t\t\t\tobject[\"observed_at\"] = \"2024-01-01T00:00:00.000Z\"\n1312|\t\t\t\tobject[\"expires_at\"] = \"2025-01-01T00:00:00.000Z\"\n1313|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1314|\t\t\t\tfinalizeProbeIDs(t, universe)\n1315|\t\t\t},\n1316|\t\t\tcode:   codeMismatch,\n1317|\t\t\tdetail: \"evidence liveness\",\n1318|\t\t},\n1319|\t\t// The upper boundary instant itself: observed <= now ==\n1320|\t\t// expires_at is expired (now < expires_at is strict). A gate\n1321|\t\t// narrowed to now.After(expires) admits this row.\n1322|\t\t\"evidence expires at admission instant\": {\n1323|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1324|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1325|\t\t\t\tobject[\"expires_at\"] = \"2026-01-20T00:00:00.000Z\"\n1326|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1327|\t\t\t\tfinalizeProbeIDs(t, universe)\n1328|\t\t\t},\n1329|\t\t\tcode:   codeMismatch,\n1330|\t\t\tdetail: \"evidence liveness\",\n1331|\t\t},\n1332|\t\t\"future observed evidence\": {\n1333|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1334|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1335|\t\t\t\tobject[\"observed_at\"] = \"2027-01-01T00:00:00.000Z\"\n1336|\t\t\t\tobject[\"expires_at\"] = \"2028-01-01T00:00:00.000Z\"\n1337|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1338|\t\t\t\tfinalizeProbeIDs(t, universe)\n1339|\t\t\t},\n1340|\t\t\tcode:   codeMismatch,\n1341|\t\t\tdetail: \"evidence liveness\",\n1342|\t\t},\n1343|\t\t\"wrong generation evidence\": {\n1344|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1345|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1346|\t\t\t\tobject[\"backend_generation_digest\"] = testSeedDigest(0x99)\n1347|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1348|\t\t\t\tfinalizeProbeIDs(t, universe)\n1349|\t\t\t},\n1350|\t\t\tcode:   codeMismatch,\n1351|\t\t\tdetail: \"evidence tuple binding\",\n1352|\t\t},\n1353|\t\t\"wrong fixture evidence\": {\n1354|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1355|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1356|\t\t\t\tobject[\"conformance_fixture_id\"] = testSeedDigest(0x98)\n1357|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1358|\t\t\t\tfinalizeProbeIDs(t, universe)\n1359|\t\t\t},\n1360|\t\t\tcode:   codeMismatch,\n1361|\t\t\tdetail: \"evidence tuple binding\",\n1362|\t\t},\n1363|\t\t\"insufficient facts\": {\n1364|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1365|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1366|\t\t\t\tobject[\"facts\"] = []any{\"fixture_passed\"}\n1367|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1368|\t\t\t\tfinalizeProbeIDs(t, universe)\n1369|\t\t\t},\n1370|\t\t\tcode:   codeMismatch,\n1371|\t\t\tdetail: \"evidence requirement coverage\",\n1372|\t\t},\n1373|\t\t\"supplementary facts satisfy nothing\": {\n1374|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1375|\t\t\t\tobject := universe.evidenceByCap[\"graceful_stop\"]\n1376|\t\t\t\tobject[\"facts\"] = []any{\"prompt_absent\", \"ui_absent\"}\n1377|\t\t\t\tfinalizeEvidence(t, universe.key, object)\n1378|\t\t\t\tfinalizeProbeIDs(t, universe)\n1379|\t\t\t},\n1380|\t\t\tcode:   codeMismatch,\n1381|\t\t\tdetail: \"evidence requirement coverage\",\n1382|\t\t},\n1383|\t\t\"split facts across objects\": {\n1384|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1385|\t\t\t\tfirst := universe.evidenceByCap[\"graceful_stop\"]\n1386|\t\t\t\tfirst[\"facts\"] = []any{\"fixture_passed\"}\n1387|\t\t\t\tfinalizeEvidence(t, universe.key, first)\n1388|\t\t\t\tsecond := universe.evidenceMap(\"graceful_stop\", []any{\"runtime_probe_passed\"})\n1389|\t\t\t\tfinalizeEvidence(t, universe.key, second)\n1390|\t\t\t\tuniverse.evidenceByCap[\"graceful-second\"] = second\n1391|\t\t\t\tfinalizeProbeIDs(t, universe)\n1392|\t\t\t},\n1393|\t\t\tcode:   codeMismatch,\n1394|\t\t\tdetail: \"evidence requirement coverage\",\n1395|\t\t},\n1396|\t\t// Note: same-ID differing-bytes evidence cannot pass parsing (the\n1397|\t\t// ID is a hash of the bytes), so the conflict arm is pinned\n1398|\t\t// white-box in manifest_pin_test.go instead.\n1399|\t\t\"wrong key signature\": {\n1400|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {\n1401|\t\t\t\tother := testKey(t)\n1402|\t\t\t\tfor _, object := range universe.evidenceByCap {\n1403|\t\t\t\t\tdelete(object, \"attestation_signature\")\n1404|\t\t\t\t\tobject[\"attestation_signature\"] = \"\"\n1405|\t\t\t\t\ttestSignBody(t, other, object)\n1406|\t\t\t\t\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n1407|\t\t\t\t}\n1408|\t\t\t\tfinalizeProbeIDs(t, universe)\n1409|\t\t\t},\n1410|\t\t\tcode:   codeIntegrityFailure,\n1411|\t\t\tdetail: \"evidence attestation\",\n1412|\t\t},\n1413|\t\t\"nil verifier\": {\n1414|\t\t\tmutate: func(t *testing.T, universe *fixtureUniverse) {},\n1415|\t\t\tcode:   codeIntegrityFailure,\n1416|\t\t\tdetail: \"evidence signature verifier\",\n1417|\t\t},\n1418|\t}\n1419|\tfor name, tc := range cases {\n1420|\t\tt.Run(name, func(t *testing.T) {\n1421|\t\t\tt.Parallel()\n1422|\n1423|\t\t\tuniverse := testUniverse(t)\n1424|\t\t\ttc.mutate(t, universe)\n1425|\t\t\tmanifest, probe, evidence := reconcileFixture(t, universe)\n1426|\t\t\tverify := testVerifier(universe.key)\n1427|\t\t\tif name == \"nil verifier\" {\n1428|\t\t\t\tverify = nil\n1429|\t\t\t}\n1430|\t\t\trawGeneration := universe.rawGeneration\n1431|\t\t\tif name == \"stale generation\" {\n1432|\t\t\t\trawGeneration = \"generation-beta\"\n1433|\t\t\t}\n1434|\t\t\t_, err := terminalbackend.Reconcile(manifest, probe, evidence, rawGeneration, universe.now, verify)\n1435|\t\t\trequireRefusal(t, err, tc.code, tc.detail)\n1436|\t\t})\n1437|\t}\n1438|}\n1439|\n1440|// finalizeProbeIDs rebuilds evidence_ids from the current evidence set and\n1441|// re-stamps the probe identity.\n1442|func finalizeProbeIDs(t *testing.T, universe *fixtureUniverse) {\n1443|\tt.Helper()\n1444|\n(more lines below)"}}}
