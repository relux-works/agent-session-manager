s[right] = ids[right], ids[left]\n852|\t\t\t\t}\n853|\t\t\t},\n854|\t\t\tdetail: \"document ordering\",\n855|\t\t},\n856|\t\t\"duplicate evidence ids\": {\n857|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n858|\t\t\t\tids := object[\"evidence_ids\"].([]any)\n859|\t\t\t\tobject[\"evidence_ids\"] = append(ids, ids[0])\n860|\t\t\t},\n861|\t\t\tdetail: \"document ordering\",\n862|\t\t},\n863|\t\t// An adjacent duplicate in sorted position is refused only by\n864|\t\t// the duplicate half of the ordering gate: narrowing >= to >\n865|\t\t// admits it, so this case holds that half.\n866|\t\t\"adjacent duplicate evidence ids\": {\n867|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n868|\t\t\t\tids := object[\"evidence_ids\"].([]any)\n869|\t\t\t\tobject[\"evidence_ids\"] = []any{ids[0], ids[1], ids[1], ids[2]}\n870|\t\t\t},\n871|\t\t\tdetail: \"document ordering\",\n872|\t\t},\n873|\t\t\"evidence list bound\": {\n874|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n875|\t\t\t\tids := make([]any, 0, 257)\n876|\t\t\t\tfor seed := 0; seed < 257; seed++ {\n877|\t\t\t\t\tids = append(ids, testSeedDigest(byte(seed)))\n878|\t\t\t\t}\n879|\t\t\t\tobject[\"evidence_ids\"] = ids\n880|\t\t\t},\n881|\t\t\tdetail: \"evidence list bound\",\n882|\t\t},\n883|\t\t\"malformed evidence id\": {\n884|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n885|\t\t\t\tobject[\"evidence_ids\"] = []any{\"nope\"}\n886|\t\t\t},\n887|\t\t\tdetail: \"document digest\",\n888|\t\t},\n889|\t\t\"bad timestamp\": {\n890|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n891|\t\t\t\tobject[\"probed_at\"] = \"2026-01-15 12:00:00\"\n892|\t\t\t},\n893|\t\t\tdetail: \"document timestamp\",\n894|\t\t},\n895|\t\t\"timestamp without fraction\": {\n896|\t\t\tmutate: func(t *testing.T, object map[string]any) {\n897|\t\t\t\tobject[\"probed_at\"] = \"2026-01-15T12:00:00Z\"\n898|\t\t\t},\n899|\t\t\tdetail: \"document timestamp\",\n900|\t\t},\n901|\t\t\"non-empty extensions\":