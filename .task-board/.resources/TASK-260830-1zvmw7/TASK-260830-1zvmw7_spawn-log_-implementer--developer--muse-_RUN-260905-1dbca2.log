{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c659","stream":{"kind":"session","id":"01a06f11-bf97-7731-9df0-9b191ed26b77"},"sequence":391,"recorded_at":1780531400000777,"record_type":"event","durability":"durable","causation_id":"d35b2354-966f-42a4-bb95-82d384379b04","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"d35b2354-966f-42a4-bb95-82d384379b04","run_stream":{"kind":"run","id":"d35b2354-966f-42a4-bb95-82d384379b04"},"task_stream":{"kind":"task","id":"59a80f02-976e-40b0-b4ca-88116a57bbe1"},"task_id":"59a80f02-976e-40b0-b4ca-88116a57bbe1","event":{"kind":"output","task_id":"59a80f02-976e-40b0-b4ca-88116a57bbe1","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n(218 line(s) above)\n219|// fixtureUniverse is one coherent admission world: a builtin manifest,\n220|// its probe (static echo, same-value override, differing override, false\n221|// override, probed addition), and the evidence set proving the true claims.\n222|type fixtureUniverse struct {\n223|\trawGeneration    string\n224|\tgenerationDigest string\n225|\tfixtureID        string\n226|\tissuerID         string\n227|\tnow              time.Time\n228|\tkey              *rsa.PrivateKey\n229|\tmanifest         map[string]any\n230|\tprobe            map[string]any\n231|\tevidence         map[string]any\n232|\tevidenceByCap    map[string]map[string]any\n233|}\n234|\n235|// testUniverse builds the builtin ax.tmux world. The manifest identity\n236|// tuple matches New(\"2.1.0\", [\"1.0.0\", \"1.1.0\"]) admission exactly, so the\n237|// same fixtures drive the registry-bound AdmitProbe entry point.\n238|func testUniverse(t *testing.T) *fixtureUniverse {\n239|\tt.Helper()\n240|\n241|\tuniverse := &fixtureUniverse{\n242|\t\trawGeneration: \"generation-alpha\",\n243|\t\tfixtureID:     testSeedDigest(0xF1),\n244|\t\tissuerID:      testSeedDigest(0x1D),\n245|\t\tnow:           time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC),\n246|\t\tkey:           testKey(t),\n247|\t\tevidenceByCap: make(map[string]map[string]any),\n248|\t}\n249|\tdigest, err := terminalbackend.GenerationDigest(universe.rawGeneration)\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n252|\t}\n253|\tuniverse.generationDigest = digest\n254|\n255|\tuniverse.manifest = map[string]any{\n256|\t\t\"schema\":                 terminalbackend.SchemaManifest,\n257|\t\t\"schema_version\":         \"1.0.0\",\n258|\t\t\"manifest_id\":            \"\",\n259|\t\t\"terminal_backend_id\":    terminalbackend.BuiltinTmux,\n260|\t\t\"implementation_version\": \"2.1.0\",\n261|\t\t\"protocol_versions\":      []any{\"1.0.0\", \"1.1.0\"},\n262|\t\t\"platforms\":              []any{\"linux\", \"macos\", \"wsl2\"},\n263|\t\t\"implementation_kind\":    \"builtin_go\",\n264|\t\t\"executable_digest\":      nil,\n265|\t\t\"static_capability_claims\": []any{\n266|\t\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n267|\t\t\tclaimMap(\"headless_creation\", \"static\", true),\n268|\t\t\tclaimMap(\"local_attach\", \"static\", true),\n269|\t\t},\n270|\t\t\"conformance_fixture_id\": universe.fixtureID,\n271|\t\t\"extensions\":             map[string]any{},\n272|\t}\n273|\tfinalizeDocument(t, universe.manifest, \"manifest_id\")\n274|\n275|\tuniverse.probe = map[string]any{\n276|\t\t\"schema\":                    terminalbackend.SchemaProbe,\n277|\t\t\"schema_version\":            \"1.0.0\",\n278|\t\t\"probe_id\":                  \"\",\n279|\t\t\"terminal_backend_id\":       terminalbackend.BuiltinTmux,\n280|\t\t\"implementation_version\":    \"2.1.0\",\n281|\t\t\"protocol_version\":          \"1.1.0\",\n282|\t\t\"implementation_kind\":       \"builtin_go\",\n283|\t\t\"executable_digest\":         nil,\n284|\t\t\"platform\":                  \"linux\",\n285|\t\t\"os_version\":                \"14.5\",\n286|\t\t\"availability\":              \"available\",\n287|\t\t\"backend_generation_digest\": universe.generationDigest,\n288|\t\t\"capability_claims\": []any{\n289|\t\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n290|\t\t\tclaimMap(\"graceful_stop\", \"probed\", true),\n291|\t\t\tclaimMap(\"headless_creation\", \"probed\", true),\n292|\t\t\tclaimMap(\"local_attach\", \"probed\", false),\n293|\t\t},\n294|\t\t\"evidence_ids\": []any{},\n295|\t\t\"probed_at\":    \"2026-01-15T12:00:00.000Z\",\n296|\t\t\"extensions\":   map[string]any{},\n297|\t}\n298|\n299|\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n300|\t\tobject := universe.evidenceMap(capability, []any{\"fixture_passed\", \"runtime_probe_passed\"})\n301|\t\tfinalizeEvidence(t, universe.key, object)\n302|\t\tuniverse.evidenceByCap[capability] = object\n303|\t}\n304|\tids := make([]string, 0, len(universe.evidenceByCap))\n305|\tfor _, object := range universe.evidenceByCap {\n306|\t\tids = append(ids, object[\"evidence_id\"].(string))\n307|\t}\n308|\tsort.Strings(ids)\n309|\tasValues := make([]any, 0, len(ids))\n310|\tfor _, id := range ids {\n311|\t\tasValues = append(asValues, id)\n312|\t}\n313|\tuniverse.probe[\"evidence_ids\"] = asValues\n314|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n315|\n316|\treturn universe\n317|}\n318|\n319|// evidenceMap builds one unsigned evidence document map for capability with\n320|// the given facts. Realm members stay null: realm evidence has its own\n321|// builder in the external-kind universe test.\n322|func (universe *fixtureUniverse) evidenceMap(capability string, facts []any) map[string]any {\n323|\treturn map[string]any{\n324|\t\t\"schema\":                     terminalbackend.SchemaCapabilityEvidence,\n325|\t\t\"schema_version\":             \"1.0.0\",\n326|\t\t\"evidence_id\":                \"\",\n327|\t\t\"terminal_backend_id\":        terminalbackend.BuiltinTmux,\n328|\t\t\"implementation_version\":     \"2.1.0\",\n329|\t\t\"protocol_version\":           \"1.1.0\",\n330|\t\t\"backend_generation_digest\":  universe.generationDigest,\n331|\t\t\"capability\":                 capability,\n332|\t\t\"value\":                      true,\n333|\t\t\"platform\":                   \"linux\",\n334|\t\t\"os_version\":                 \"14.5\",\n335|\t\t\"conformance_fixture_id\":     universe.fixtureID,\n336|\t\t\"observed_at\":                \"2025-06-01T00:00:00.000Z\",\n337|\t\t\"expires_at\":                 \"2027-06-01T00:00:00.000Z\",\n338|\t\t\"issuer\":                     terminalbackend.IssuerLocalProbe,\n339|\t\t\"issuer_id\":                  universe.issuerID,\n340|\t\t\"attestation_signature\":      \"\",\n341|\t\t\"facts\":                      facts,\n342|\t\t\"terminal_binding_id\":        nil,\n343|\t\t\"provider_id\":                nil,\n344|\t\t\"provider_build\":             nil,\n345|\t\t\"sentinel_result\":            nil,\n346|\t\t\"provider_auth_smoke_result\": nil,\n347|\t\t\"extensions\":                 map[string]any{},\n348|\t}\n349|}\n350|\n351|// parsedUniverse parses the universe documents through the production entry\n352|// points, failing the test on any parse error.\n353|func (universe *fixtureUniverse) parsed(t *testing.T) (terminalbackend.Manifest, terminalbackend.Probe, []terminalbackend.Evidence) {\n354|\tt.Helper()\n355|\n356|\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n357|\tif err != nil {\n358|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n359|\t}\n360|\tprobe, err := terminalbackend.ParseProbe(mustMarshal(t, universe.probe))\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"ParseProbe() error = %v\", err)\n363|\t}\n364|\tevidence := make([]terminalbackend.Evidence, 0, len(universe.evidenceByCap))\n365|\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n366|\t\tobject, err := terminalbackend.ParseEvidence(mustMarshal(t, universe.evidenceByCap[capability]))\n367|\t\tif err != nil {\n368|\t\t\tt.Fatalf(\"ParseEvidence(%s) error = %v\", capability, err)\n369|\t\t}\n370|\t\tevidence = append(evidence, object)\n371|\t}\n372|\treturn manifest, probe, evidence\n373|}\n374|\n375|// cloneMap deep-copies a fixture map through JSON so mutations never leak\n376|// between cases.\n377|func cloneMap(t *testing.T, object map[string]any) map[string]any {\n378|\tt.Helper()\n379|\n380|\traw, err := json.Marshal(object)\n381|\tif err != nil {\n382|\t\tt.Fatalf(\"marshal clone: %v\", err)\n383|\t}\n384|\tvar cloned map[string]any\n385|\tif err := json.Unmarshal(raw, &cloned); err != nil {\n386|\t\tt.Fatalf(\"unmarshal clone: %v\", err)\n387|\t}\n388|\treturn cloned\n389|}\n390|\n391|// TestParseManifestAdmitsClosedFixture proves the positive gate is\n392|// reachable and pins the typed projection of every member.\n393|func TestParseManifestAdmitsClosedFixture(t *testing.T) {\n394|\tt.Parallel()\n395|\n396|\tuniverse := testUniverse(t)\n397|\tmanifest, err := terminalbackend.ParseManifest(mustMarshal(t, universe.manifest))\n398|\tif err != nil {\n399|\t\tt.Fatalf(\"ParseManifest() error = %v\", err)\n400|\t}\n401|\tif manifest.TerminalBackendID != terminalbackend.BuiltinTmux {\n402|\t\tt.Errorf(\"TerminalBackendID = %q\", manifest.TerminalBackendID)\n403|\t}\n404|\tif manifest.ImplementationVersion != \"2.1.0\" {\n405|\t\tt.Errorf(\"ImplementationVersion = %q\", manifest.ImplementationVersion)\n406|\t}\n407|\tif len(manifest.ProtocolVersions) != 2 || manifest.ProtocolVersions[1] != \"1.1.0\" {\n408|\t\tt.Errorf(\"ProtocolVersions = %v\", manifest.ProtocolVersions)\n409|\t}\n410|\tif len(manifest.Platforms) != 3 || manifest.Platforms[0].String() != \"linux\" {\n411|\t\tt.Errorf(\"Platforms = %v\", manifest.Platforms)\n412|\t}\n413|\tif manifest.ImplementationKind != terminalbackend.KindBuiltinGo {\n414|\t\tt.Errorf(\"ImplementationKind = %q\", manifest.ImplementationKind)\n415|\t}\n416|\tif manifest.ExecutableDigest != \"\" {\n417|\t\tt.Errorf(\"ExecutableDigest = %q, want null\", manifest.ExecutableDigest)\n418|\t}\n419|\tif len(manifest.StaticCapabilityClaims) != 3 {\n420|\t\tt.Fatalf(\"StaticCapabilityClaims = %d, want 3\", len(manifest.StaticCapabilityClaims))\n421|\t}\n422|\tif manifest.StaticCapabilityClaims[0].Capability != \"durable_disconnect\" {\n423|\t\tt.Errorf(\"first claim = %q\", manifest.StaticCapabilityClaims[0].Capability)\n424|\t}\n425|\tif manifest.ConformanceFixtureID != universe.fixtureID {\n426|\t\tt.Errorf(\"ConformanceFixtureID = %q\", manifest.ConformanceFixtureID)\n427|\t}\n428|\tif manifest.ManifestID != universe.manifest[\"manifest_id\"] {\n429|\t\tt.Errorf(\"ManifestID = %q, want recomputed identity\", manifest.ManifestID)\n430|\t}\n431|}\n432|\n433|// TestGenerationDigestGolden pins the domain-separated recipe: SHA-256 over\n434|// UTF-8 \"ax-terminal-backend-generation-v1\" + NUL + raw generation bytes.\n435|// The expected value was computed with an independent SHA-256 oracle, so a\n436|// separator change fails here rather than hiding behind agreement.\n437|func TestGenerationDigestGolden(t *testing.T) {\n438|\tt.Parallel()\n439|\n440|\tdigest, err := terminalbackend.GenerationDigest(\"generation-alpha\")\n441|\tif err != nil {\n442|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n443|\t}\n444|\tconst want = \"sha256:ad089bdcf1a41853068645fec63a0ec8e40b95c3e3a103bc326a70e8c479eab7\"\n445|\tif digest != want {\n446|\t\tt.Errorf(\"GenerationDigest() = %q, want %q\", digest, want)\n447|\t}\n448|}\n449|\n450|// TestGenerationDigestBounds proves the raw generation domain fails closed:\n451|// empty (which would make every backend share one digest), over-long, and\n452|// invalid UTF-8 derive nothing.\n453|func TestGenerationDigestBounds(t *testing.T) {\n454|\tt.Parallel()\n455|\n456|\tfor _, raw := range []string{\"\", strings.Repeat(\"g\", 257), \"ok\\xffbad\", strings.Repeat(\"g\", 0)} {\n457|\t\t_, err := terminalbackend.GenerationDigest(raw)\n458|\t\trequireRefusal(t, err, codeStaleGeneration, \"backend_generation bound\")\n(more lines below)"}}}
