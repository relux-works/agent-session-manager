+// TestManifestEncodingRefusals proves malformed reads fail closed: syntax,
+// duplicate, encoding, depth, shape, and identity failures are mismatch,
+// never absence.
+func TestManifestEncodingRefusals(t *testing.T) {
+	t.Parallel()
+
+	universe := testUniverse(t)
+	valid := mustMarshal(t, universe.manifest)
+	deep := strings.Repeat("[", 40) + strings.Repeat("]", 40)
+
+	cases := map[string][]byte{
+		"empty":        {},
+		"truncated":    valid[:len(valid)/2],
+		"not json":     []byte("manifest"),
+		"top array":    []byte("[]"),
+		"top string":   []byte(`"manifest"`),
+		"trailing":     append(append([]byte{}, valid...), []byte(" {}")...),
+		"duplicate":    []byte(`{"schema":"urn:ax:schema:terminal-backend-manifest","schema":"urn:ax:schema:terminal-backend-manifest"}`),
+		"invalid utf8": append(append([]byte{}, valid...), 0xff),
+		"deep nesting": []byte(`{"schema":"x","nest":` + deep + `}`),
+		"null":         []byte("null"),
+	}
+	for name, raw := range cases {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			if _, err := terminalbackend.ParseManifest(raw); !terminalbackend.IsMismatch(err) {
+				t.Errorf("ParseManifest() error = %v, want terminal_backend_manifest_probe_mismatch", err)
+			}
+		})
+	}
+}
