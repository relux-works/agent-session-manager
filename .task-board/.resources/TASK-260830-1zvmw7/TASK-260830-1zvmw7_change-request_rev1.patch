+// TestGenerationDigestBounds proves the raw generation domain fails closed:
+// empty (which would make every backend share one digest), over-long, and
+// invalid UTF-8 derive nothing.
+func TestGenerationDigestBounds(t *testing.T) {
+	t.Parallel()
+
+	for _, raw := range []string{"", strings.Repeat("g", 257), "ok\xffbad", strings.Repeat("g", 0)} {
+		if _, err := terminalbackend.GenerationDigest(raw); !terminalbackend.IsStaleGeneration(err) {
+			t.Errorf("GenerationDigest(%q) error = %v, want terminal_backend_stale_generation", raw, err)
+		}
+	}
+	if _, err := terminalbackend.GenerationDigest(strings.Repeat("g", 256)); err != nil {
+		t.Errorf("GenerationDigest(256 bytes) error = %v, want admission", err)
+	}
+}
