+		"timestamp without fraction": func(t *testing.T, object map[string]any) {
+			object["probed_at"] = "2026-01-15T12:00:00Z"
+		},
+		"non-empty extensions": func(t *testing.T, object map[string]any) {
+			object["extensions"] = map[string]any{"x": 1}
+		},
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+
+			universe := testUniverse(t)
+			object := cloneMap(t, universe.probe)
+			mutate(t, object)
+			finalizeDocument(t, object, "probe_id")
+			if _, err := terminalbackend.ParseProbe(mustMarshal(t, object)); !terminalbackend.IsMismatch(err) {
+				t.Errorf("ParseProbe() error = %v, want terminal_backend_manifest_probe_mismatch", err)
+			}
+		})
+	}
+}
