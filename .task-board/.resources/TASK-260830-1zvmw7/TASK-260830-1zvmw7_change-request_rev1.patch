+// TestManifestDocumentRefusals narrows the closed-schema gate: each case
+// widens exactly one member class and must fail with mismatch.
+func TestManifestDocumentRefusals(t *testing.T) {
+	t.Parallel()
+
+	cases := map[string]func(t *testing.T, object map[string]any){
+		"unknown member": func(t *testing.T, object map[string]any) {
+			object["sponsor"] = "evil"
