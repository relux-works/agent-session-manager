+			object["schema"] = "urn:ax:schema:terminal-backend-probe"
+		},
+		"wrong version": func(t *testing.T, object map[string]any) {
+			object["schema_version"] = "2.0.0"
+		},
+		"unknown capability": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["capability"] = "teleportation"
+		},
+		"probed origin in manifest": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["origin"] = "probed"
+		},
+		"flipped generation variable": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["generation_variable"] = true
+		},
+		"redefined operations": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["dependent_operations"] = []any{"create"}
+		},
+		"unknown operation in claim": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["dependent_operations"] = []any{"create", "launch"}
+		},
+		"empty operations": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["dependent_operations"] = []any{}
+		},
+		"unsorted operations": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["dependent_operations"] = []any{"status", "create"}
+		},
+		"unknown requirement": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			claims[0].(map[string]any)["evidence_requirements"] = []any{"conformance_fixture", "vibes"}
+		},
+		"duplicate claims": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			object["static_capability_claims"] = append(claims, claims[0])
+		},
+		"unsorted claims": func(t *testing.T, object map[string]any) {
+			claims := object["static_capability_claims"].([]any)
+			object["static_capability_claims"] = []any{claims[2], claims[1], claims[0]}
+		},
+		"bad semver": func(t *testing.T, object map[string]any) {
+			object["implementation_version"] = "2.1"
+		},
+		"protocol major 2": func(t *testing.T, object map[string]any) {
+			object["protocol_versions"] = []any{"1.0.0", "2.0.0"}
+		},
+		"unsorted protocols": func(t *testing.T, object map[string]any) {
+			object["protocol_versions"] = []any{"1.1.0", "1.0.0"}
+		},
+		"empty protocols": func(t *testing.T, object map[string]any) {
+			object["protocol_versions"] = []any{}
+		},
+		"unknown platform": func(t *testing.T, object map[string]any) {
+			object["platforms"] = []any{"amigaos"}
+		},
+		"unsorted platforms": func(t *testing.T, object map[string]any) {
+			object["platforms"] = []any{"macos", "linux", "wsl2"}
+		},
+		"digest on builtin": func(t *testing.T, object map[string]any) {
+			object["executable_digest"] = testSeedDigest(0xAA)
+		},
+		"bad digest": func(t *testing.T, object map[string]any) {
+			object["implementation_kind"] = "local_program"
+			object["executable_digest"] = "not-a-digest"
