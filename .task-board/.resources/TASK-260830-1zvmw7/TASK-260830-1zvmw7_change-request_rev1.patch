+	}
+	for operation, expected := range want {
+		got, err := terminalbackend.CapabilitiesForOperation(operation)
+		if err != nil {
+			t.Errorf("CapabilitiesForOperation(%q) error = %v", operation, err)
+			continue
+		}
+		sort.Strings(got)
+		if fmt.Sprint(got) != fmt.Sprint(expected) {
+			t.Errorf("CapabilitiesForOperation(%q) = %v, want %v", operation, got, expected)
+		}
+	}
+	if _, err := terminalbackend.CapabilitiesForOperation("launch"); !terminalbackend.IsMismatch(err) {
+		t.Errorf("CapabilitiesForOperation(launch) error = %v, want mismatch", err)
+	}
+	if err := terminalbackend.CheckOperation("launch", terminalbackend.Admitted{}); !terminalbackend.IsMismatch(err) {
+		t.Errorf("CheckOperation(launch) error = %v, want mismatch", err)
+	}
+}
