+		},
+		"duplicate evidence ids": func(t *testing.T, object map[string]any) {
+			ids := object["evidence_ids"].([]any)
+			object["evidence_ids"] = append(ids, ids[0])
+		},
+		"malformed evidence id": func(t *testing.T, object map[string]any) {
+			object["evidence_ids"] = []any{"nope"}
+		},
+		"bad timestamp": func(t *testing.T, object map[string]any) {
