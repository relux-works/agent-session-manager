    45	// Source binds every generated definition to the immutable normative source.
    46	type Source struct {
    47		Repository     string
    48		Release        Release
    49		Commit         string
    50		DocumentPath   string
    51		DocumentSHA256 string
    52		NormativeScope []string
    53	}
    54	
    55	// Contract is one independently versioned schema or protocol contract.
    56	type Contract struct {
    57		Name     string
    58		ID       ContractID
    59		Versions []string
    60	}
    61	
    62	// OperationEffect classifies whether an operation mutates authoritative
    63	// durable state. Isolated output is restricted to caller-created sinks and is
    64	// not an authoritative state transition.
    65	type OperationEffect string
    66	
    67	const (
    68		// EffectNoDurableMutation makes no stronger read-only claim: an operation
    69		// may still plan work or control an ephemeral process.
    70		EffectNoDurableMutation OperationEffect = "no_durable_mutation"
    71		EffectIsolatedOutput    OperationEffect = "isolated_output"
    72		EffectDurableMutation   OperationEffect = "durable_mutation"
    73	)
    74	
    75	// Operation is a typed protocol/query operation definition. Durable mutations
    76	// always carry both an exact idempotency scope and recovery evidence.
    77	type Operation struct {
    78		Family           Family
    79		Name             OperationName
    80		ContractID       ContractID
    81		ContractVersions []string
    82		Effect           OperationEffect
    83		IdempotencyKey   string
    84		RecoveryEvidence []string
    85		NormativeSection string
    86		FixtureFamilies  []string
    87	}
    88	
