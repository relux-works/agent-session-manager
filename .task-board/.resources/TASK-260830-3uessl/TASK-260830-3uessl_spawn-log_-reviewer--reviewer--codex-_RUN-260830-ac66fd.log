-var (
-	namePattern       = regexp.MustCompile(`^[a-z][a-z0-9_.-]*$`)
-	capabilityPattern = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)
-	errorPattern      = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)
-)
