+			t.Errorf("error %s traceability = (%q, %#v), want (%q, %#v)", errorCode.Code, errorCode.NormativeSection, errorCode.FixtureFamilies, errorTraceability.section, errorTraceability.fixtures)
+		}
+	}
+}
