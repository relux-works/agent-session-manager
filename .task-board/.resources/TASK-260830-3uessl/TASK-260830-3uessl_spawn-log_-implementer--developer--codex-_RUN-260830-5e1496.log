+func TestOtherDurableOperationEvidenceMatchesReviewedMetadata(t *testing.T) {
+	t.Parallel()
+
+	type evidenceGroup struct {
+		family           catalog.Family
+		names            []catalog.OperationName
+		idempotencyKey   string
