+			idempotencyKey: "(operation, operation_id)",
+			recoveryEvidence: []string{
+				"ProviderTransactionDocument",
+				"materialize-status reconciliation before retry",
+				"canonical-identical request replay",
+				"PTX-IDEMPOTENCY-ID-*",
