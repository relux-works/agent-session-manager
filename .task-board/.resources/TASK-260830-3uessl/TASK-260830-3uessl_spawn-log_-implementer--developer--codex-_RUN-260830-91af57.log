+          {"exit_code": 7, "codes": ["terminal_backend_untrusted", "terminal_backend_unauthorized"]},
+          {"exit_code": 9, "codes": ["terminal_backend_integrity_failure", "terminal_backend_implementation_drift", "terminal_backend_manifest_probe_mismatch"]},
+          {"exit_code": 10, "codes": ["terminal_backend_stale_generation"]},
+          {"exit_code": 13, "codes": ["terminal_backend_protocol_error", "terminal_backend_process_failed", "terminal_backend_timeout"]}
+        ]
+      }
+    ]
+  }
+}
