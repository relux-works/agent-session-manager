+	assertOperationEffectNames(t, got, catalog.EffectIsolatedOutput, map[string][]string{
+		"provider":        {"capture"},
+		"session_adapter": {"capture-plan", "capture", "normalize", "projection-plan", "project", "read-back"},
+	})
+
+	for _, operation := range got.Operations {
