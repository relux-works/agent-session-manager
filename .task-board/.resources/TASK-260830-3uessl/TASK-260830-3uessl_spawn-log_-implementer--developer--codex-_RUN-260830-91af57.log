+			"materialize.prepare", "materialize.commit", "materialize.finalize",
+			"materialize.rollback", "tombstone.ack", "session.stop", "handoff.prepare",
+			"handoff.quiesce", "handoff.stop", "handoff.commit", "handoff.abort",
+		},
