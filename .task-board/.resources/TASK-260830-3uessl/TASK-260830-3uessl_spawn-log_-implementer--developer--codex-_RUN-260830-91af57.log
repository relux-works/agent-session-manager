+	}
+	if got.Source.Repository != specpin.Repository ||
+		got.Source.Commit != specpin.CommitV050 ||
+		got.Source.DocumentSHA256 != specpin.DocumentSHA256 {
+		t.Fatalf("Current().Source = %#v, want exact spec pin", got.Source)
+	}
