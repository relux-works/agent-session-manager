    "mode": "snapshot",
    "bundle_id": "sha256:0af7b44e7063375a0f06e546fd820438c72607f191c14be78d35c8ffa109844f",
    "bundle_path": "/var/folders/example/tb-session-bundle.tar",
    "size": 4096,
    "safe_boundary": {
      "provider_id": "codex",
      "provider_version": "0.147.0",
