+          {"exit_code": 17, "codes": ["migration_required"]},
+          {"exit_code": 130, "codes": ["interrupted"]}
+        ]
+      },
+      {
+        "introduced_version": "1.1.0",
+        "releases": ["v0.4.3", "v0.5.0"],
+        "mappings": [
+          {"exit_code": 4, "codes": ["source_not_found", "source_ambiguous"]},
+          {"exit_code": 6, "codes": ["unsupported_environment_tuple", "operation_unknown", "target_resume_invalid"]},
+          {"exit_code": 9, "codes": ["source_corrupt", "bundle_integrity_failed", "credential_material_detected"]},
+          {"exit_code": 11, "codes": ["source_not_quiescent", "source_changed_during_clone"]},
+          {"exit_code": 12, "codes": ["target_prepare_failed", "target_validation_failed", "target_checkpoint_failed", "transaction_unknown"]},
+          {"exit_code": 13, "codes": ["session_adapter_protocol_error", "session_adapter_process_failed", "session_adapter_timeout"]},
+          {"exit_code": 16, "codes": ["projection_loss_unacceptable", "unsafe_pending_action"]}
+        ]
+      },
+      {
+        "introduced_version": "1.2.0",
+        "releases": ["v0.4.3", "v0.5.0"],
+        "mappings": [
+          {"exit_code": 2, "codes": ["directory_instance_not_found", "directory_instance_ambiguous", "query_invalid"]},
+          {"exit_code": 3, "codes": ["inventory_stale"]},
+          {"exit_code": 4, "codes": ["host_offline"]},
+          {"exit_code": 6, "codes": ["directory_mesh_unsupported", "continuation_route_unavailable", "adoption_unavailable", "terminal_attach_unavailable"]},
+          {"exit_code": 7, "codes": ["field_forbidden", "target_auth_missing"]},
+          {"exit_code": 9, "codes": ["observation_gap", "observation_conflict", "adapter_protocol_violation"]},
+          {"exit_code": 10, "codes": ["lineage_ambiguous", "annotation_conflict"]},
+          {"exit_code": 12, "codes": ["operation_uncertain"]},
+          {"exit_code": 13, "codes": ["enrichment_model_unavailable"]},
+          {"exit_code": 15, "codes": ["cloned_source_still_active"]},
+          {"exit_code": 16, "codes": ["instance_identity_weak", "preview_policy_blocked", "enrichment_policy_blocked", "enrichment_head_changed", "continuation_plan_stale", "unmanaged_remote_forbidden", "workspace_route_conflict", "cloning_fidelity_unacceptable", "operation_in_progress"]}
+        ]
+      },
+      {
+        "introduced_version": "1.3.0",
+        "releases": ["v0.5.0"],
+        "mappings": [
+          {"exit_code": 4, "codes": ["terminal_backend_not_found", "terminal_backend_ambiguous"]},
+          {"exit_code": 6, "codes": ["terminal_backend_unavailable", "terminal_backend_protocol_incompatible", "terminal_backend_capability_unproven", "terminal_backend_restore_mismatch"]},
+          {"exit_code": 7, "codes": ["terminal_backend_untrusted", "terminal_backend_unauthorized"]},
+          {"exit_code": 9, "codes": ["terminal_backend_integrity_failure", "terminal_backend_implementation_drift", "terminal_backend_manifest_probe_mismatch"]},
+          {"exit_code": 10, "codes": ["terminal_backend_stale_generation"]},
+          {"exit_code": 13, "codes": ["terminal_backend_protocol_error", "terminal_backend_process_failed", "terminal_backend_timeout"]}
+        ]
+      }
+    ]
+  }
+}
