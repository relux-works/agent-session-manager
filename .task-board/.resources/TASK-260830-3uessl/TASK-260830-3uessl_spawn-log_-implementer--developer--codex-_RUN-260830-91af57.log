+		7:   {"authentication_failed", "peer_not_allowlisted", "host_identity_mismatch", "field_forbidden", "target_auth_missing", "terminal_backend_untrusted", "terminal_backend_unauthorized"},
+		8:   {"owner_unreachable", "transport_failure"},
