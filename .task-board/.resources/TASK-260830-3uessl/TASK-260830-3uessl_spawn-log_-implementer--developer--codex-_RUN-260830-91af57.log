+{
+  "format": "ax-implementation-catalog",
+  "format_version": 1,
+  "source": {
+    "repository": "relux-works/agent-session-manager-spec",
+    "release": "v0.5.0",
+    "commit": "28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c",
+    "document_path": "SPEC.md",
+    "document_sha256": "562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a"
+  },
+  "normative_scope": ["1", "17", "20", "appendix-a", "appendix-d"],
+  "operation_families": [
+    {
+      "family": "terminal_backend",
+      "contract_id": "urn:ax:protocol:terminal-backend",
+      "contract_versions": ["1.0.0"],
