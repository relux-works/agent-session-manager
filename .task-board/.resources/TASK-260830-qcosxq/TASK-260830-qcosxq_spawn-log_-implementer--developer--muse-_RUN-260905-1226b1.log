{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c68f","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":418,"recorded_at":1780531400000831,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"task_stream":{"kind":"task","id":"c4b29b65-91ff-4745-b07f-d00747cb06f7"},"task_id":"c4b29b65-91ff-4745-b07f-d00747cb06f7","event":{"kind":"output","task_id":"c4b29b65-91ff-4745-b07f-d00747cb06f7","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner_test.go`.\n(497 line(s) above)\n498|func TestExecRunnerReportsCrashExit(t *testing.T) {\n499|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n500|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n501|\t}\n502|\tfor _, kase := range []struct {\n503|\t\tname   string\n504|\t\tscript string\n505|\t\tcode   string\n506|\t\tdetail string\n507|\t}{\n508|\t\t{\"crash exit\", \"#!/bin/sh\\ncat > /dev/null\\nexit 3\\n\", \"provider_process_failed\", \"plugin exited without a response\"},\n509|\t\t{\"clean exit\", \"#!/bin/sh\\ncat > /dev/null\\nexit 0\\n\", \"provider_protocol_error\", \"plugin exited without a response\"},\n510|\t} {\n511|\t\tt.Run(kase.name, func(t *testing.T) {\n512|\t\t\tplugin := filepath.Join(t.TempDir(), \"ax-provider-exit\")\n513|\t\t\tif err := os.WriteFile(plugin, []byte(kase.script), 0o700); err != nil {\n514|\t\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n515|\t\t\t}\n516|\t\t\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n517|\t\t\t_, err := host.Call(context.Background(), plugin, liveRequest(t))\n518|\t\t\tif kase.code == \"provider_protocol_error\" {\n519|\t\t\t\trequireFrameRefusal(t, err, \"\", kase.detail)\n520|\t\t\t} else {\n521|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.code), kase.detail)\n522|\t\t\t}\n523|\t\t})\n524|\t}\n525|}\n526|\n527|// TestExecRunnerWritesOneTerminatedFrame drives the production stdin\n528|// path: the exact request frame plus the Section 7.2 line terminator must\n529|// reach the plugin. The script saves its stdin aside and answers from it,\n530|// so the captured bytes pin what ExecRunner wrote. Omitting the newline\n531|// reddens the byte comparison here.\n532|func TestExecRunnerWritesOneTerminatedFrame(t *testing.T) {\n533|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n534|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n535|\t}\n536|\troot := t.TempDir()\n537|\tcapture := filepath.Join(root, \"stdin-capture\")\n538|\tscript := filepath.Join(root, \"ax-provider-capture\")\n539|\tplugin := `#!/bin/sh\n540|cat > \"$AX_STDIN_CAPTURE\"\n541|frame=$(cat \"$AX_STDIN_CAPTURE\")\n542|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n543|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n544|exit 0\n545|`\n546|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n547|\t\tt.Fatalf(\"WriteFile: %v\", err)\n548|\t}\n549|\tt.Setenv(\"AX_STDIN_CAPTURE\", capture)\n550|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n551|\treq := liveRequest(t)\n552|\tif _, err := host.Call(context.Background(), script, req); err != nil {\n553|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n554|\t}\n555|\tframe, err := EncodeRequest(req, time.Now())\n556|\tif err != nil {\n557|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n558|\t}\n559|\twant := append(append([]byte(nil), frame...), '\\n')\n560|\tgot, err := os.ReadFile(capture)\n561|\tif err != nil {\n562|\t\tt.Fatalf(\"ReadFile capture: %v\", err)\n563|\t}\n564|\tif string(got) != string(want) {\n565|\t\tt.Fatalf(\"plugin stdin is %d bytes ending %q, want the %d-byte frame plus one newline\", len(got), lastByte(got), len(want))\n566|\t}\n567|}\n568|\n569|// lastByte renders the final stdin byte for the terminator failure text.\n570|func lastByte(data []byte) string {\n571|\tif len(data) == 0 {\n572|\t\treturn \"empty\"\n573|\t}\n574|\treturn string(data[len(data)-1:])\n575|}"}}}
