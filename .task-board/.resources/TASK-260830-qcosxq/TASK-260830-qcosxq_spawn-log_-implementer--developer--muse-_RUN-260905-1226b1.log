{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cad3","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":964,"recorded_at":1780531400001923,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"task_stream":{"kind":"task","id":"3e7f6c65-2591-4437-8d98-e83d6c258d93"},"task_id":"3e7f6c65-2591-4437-8d98-e83d6c258d93","event":{"kind":"output","task_id":"3e7f6c65-2591-4437-8d98-e83d6c258d93","chunk":"edited\nchanged lines: lines 536-539\n--- original\n+++ updated\n@@\n-\t// The script sleeps as a child of sh, so a parent-only kill would\n-\t// leave it holding the pipes until WaitDelay (2s) expires. Returning\n-\t// near the 300ms deadline proves the whole process group died.\n-\tif elapsed >= waitDrainDelay {\n+\t// Returning before the drain delay shows the wait did not linger\n+\t// for pipe EOF after the deadline kill. What the group kill buys\n+\t// beyond Setpgid/Kill consistency is unknown on this platform:\n+\t// removing the Cancel alone still returns in ~300ms here, while\n+\t// disabling Setpgid delays past 2s — so this pins termination\n+\t// latency, not detached-descendant fate.\n+\tif elapsed >= waitDrainDelay {\n"}}}
