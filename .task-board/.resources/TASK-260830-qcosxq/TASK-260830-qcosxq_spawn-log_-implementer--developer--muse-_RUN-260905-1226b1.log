{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66f","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":402,"recorded_at":1780531400000799,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"call_id":"call_01a06f48871b7ed28388e673a0c02b95","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// futureDeadline returns a deadline duration ahead of the real clock,\n19|// so Host deadline accounting runs against live time.\n20|func futureDeadline(t *testing.T, ahead time.Duration) scalar.Timestamp {\n21|\tt.Helper()\n22|\tparsed, err := scalar.ParseTimestamp(time.Now().Add(ahead).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n25|\t}\n26|\treturn parsed\n27|}\n28|\n29|// liveRequest is testRequest with a live future deadline for Host calls,\n30|// which enforce the deadline against a real context.\n31|func liveRequest(t *testing.T) Request {\n32|\tt.Helper()\n33|\treq := testRequest(t)\n34|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n35|\treturn req\n36|}\n37|\n38|// liveHost builds a Host on the real clock.\n39|func liveHost(runner *scriptRunner) Host {\n40|\treturn Host{Runner: runner, Now: time.Now}\n41|}\n42|\n43|// scriptCall records one Runner invocation.\n44|type scriptCall struct {\n45|\texecutable string\n46|\tstdin      []byte\n47|}\n48|\n49|// scriptRunner is a scripted Runner: it replays canned results, records\n50|// every invocation, and optionally blocks until the context ends to\n51|// simulate a hung plugin. It proves Host behavior without real processes;\n52|// the ExecRunner integration test below drives the production call site.\n53|// scriptStep is one canned invocation outcome: either a result or a\n54|// transport error, consumed in listed order.\n55|type scriptStep struct {\n56|\tresult Result\n57|\terr    error\n58|}\n59|\n60|func okStep(result Result) scriptStep { return scriptStep{result: result} }\n61|\n62|func failStep(err error) scriptStep { return scriptStep{err: err} }\n63|\n64|type scriptRunner struct {\n65|\tmu    sync.Mutex\n66|\tcalls []scriptCall\n67|\tsteps []scriptStep\n68|\tblock bool\n69|\t// delay sleeps past the request deadline before replaying, so the\n70|\t// runner returns a result after the deadline instead of an error.\n71|\tdelay time.Duration\n72|}\n73|\n74|func (runner *scriptRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n75|\trunner.mu.Lock()\n76|\trunner.calls = append(runner.calls, scriptCall{executable: executable, stdin: append([]byte(nil), stdin...)})\n77|\tindex := len(runner.calls) - 1\n78|\trunner.mu.Unlock()\n79|\tif runner.block {\n80|\t\t<-ctx.Done()\n81|\t\treturn Result{}, ctx.Err()\n82|\t}\n83|\tif runner.delay > 0 {\n84|\t\ttime.Sleep(runner.delay)\n85|\t}\n86|\tif index < len(runner.steps) {\n87|\t\tstep := runner.steps[index]\n88|\t\treturn step.result, step.err\n89|\t}\n90|\treturn Result{}, errors.New(\"script: no step canned\")\n91|}\n92|\n93|func (runner *scriptRunner) spawned() int {\n94|\trunner.mu.Lock()\n95|\tdefer runner.mu.Unlock()\n96|\treturn len(runner.calls)\n97|}\n98|\n99|func successResult(t *testing.T, id, body string) Result {\n100|\tt.Helper()\n101|\treturn Result{Stdout: successFrame(t, id, body), ExitCode: 0}\n102|}\n103|\n104|// TestCallSendsOneFrameToOneProcess proves the dispatch path: the exact\n105|// request frame reaches exactly one process of the named executable.\n106|func TestCallSendsOneFrameToOneProcess(t *testing.T) {\n107|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n108|\thost := liveHost(runner)\n109|\treq := liveRequest(t)\n110|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n111|\tif err != nil {\n112|\t\tt.Fatalf(\"Call: %v\", err)\n113|\t}\n114|\tif string(got.Body) != `{\"provider_id\":\"pi\"}` {\n115|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n116|\t}\n117|\tif runner.spawned() != 1 {\n118|\t\tt.Fatalf(\"Call spawned %d processes, want exactly one per operation\", runner.spawned())\n119|\t}\n120|\tcall := runner.calls[0]\n121|\tif call.executable != \"/plugins/ax-provider-pi\" {\n122|\t\tt.Fatalf(\"Call executable = %q\", call.executable)\n123|\t}\n124|\tframe, err := EncodeRequest(req, time.Now())\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n127|\t}\n128|\tif string(call.stdin) != string(frame) {\n129|\t\tt.Fatalf(\"Call stdin = %q, want the single request frame\", call.stdin)\n130|\t}\n131|}\n132|\n133|// TestCallUnknownOperationStartsNoProcess proves dispatch refuses an\n134|// unregistered operation locally: the failure is invalid_config and the\n135|// Runner is never touched.\n136|func TestCallUnknownOperationStartsNoProcess(t *testing.T) {\n137|\trunner := &scriptRunner{}\n138|\thost := liveHost(runner)\n139|\treq := liveRequest(t)\n140|\treq.Operation = \"reboot\"\n141|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n142|\trequireLocalRefusal(t, err, \"invalid_config\", \"unknown operation\")\n143|\tif runner.spawned() != 0 {\n144|\t\tt.Fatalf(\"Call spawned %d processes for an unknown operation, want none\", runner.spawned())\n145|\t}\n146|}\n147|\n148|// TestCallNilRunnerRefuses proves a host without a Runner fails closed\n149|// before framing.\n150|func TestCallNilRunnerRefuses(t *testing.T) {\n151|\thost := Host{Now: time.Now}\n152|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n153|\trequireLocalRefusal(t, err, \"invalid_config\", \"host has no runner\")\n154|}\n155|\n156|// TestCallUsesSystemClockWhenUnset proves the nil-clock branch: a Host\n157|// without Now enforces live deadlines.\n158|func TestCallUsesSystemClockWhenUnset(t *testing.T) {\n159|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n160|\thost := Host{Runner: runner}\n161|\treq := testRequest(t)\n162|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n163|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); err != nil {\n164|\t\tt.Fatalf(\"Call with unset clock: %v\", err)\n165|\t}\n166|}\n167|\n168|// failingReader always errors, exercising the capped-read failure path.\n169|type failingReader struct{}\n170|\n171|func (failingReader) Read([]byte) (int, error) { return 0, errors.New(\"fake: read failed\") }\n172|\n173|// TestReadCappedReportsStreamErrors proves a stream failure surfaces\n174|// instead of an empty capture.\n175|func TestReadCappedReportsStreamErrors(t *testing.T) {\n176|\tif _, err := readCapped(failingReader{}, 1024); err == nil {\n177|\t\tt.Fatal(\"readCapped swallowed a stream error\")\n178|\t}\n179|}\n180|\n181|// TestReadCappedEnforcesCap proves the memory bound runner.go promises:\n182|// a stream far beyond the cap is cut to exactly cap bytes carrying the\n183|// stream prefix, while under-cap and exact-cap streams pass through\n184|// untouched. Removing the limiter returns the whole stream; removing the\n185|// truncation returns cap+1 bytes; both redden here.\n186|func TestReadCappedEnforcesCap(t *testing.T) {\n187|\tconst cap = 16\n188|\tover := strings.Repeat(\"a\", 4*cap) + strings.Repeat(\"b\", 4*cap)\n189|\tgot, err := readCapped(strings.NewReader(over), cap)\n190|\tif err != nil {\n191|\t\tt.Fatalf(\"readCapped: %v\", err)\n192|\t}\n193|\tif len(got) != cap {\n194|\t\tt.Fatalf(\"readCapped cut %d input bytes to %d, want exactly %d\", len(over), len(got), cap)\n195|\t}\n196|\tif string(got) != strings.Repeat(\"a\", cap) {\n197|\t\tt.Fatalf(\"readCapped kept %q, want the stream prefix\", got)\n198|\t}\n199|\tfor _, size := range []int{0, 1, cap - 1, cap} {\n200|\t\twant := strings.Repeat(\"c\", size)\n201|\t\tgot, err := readCapped(strings.NewReader(want), cap)\n202|\t\tif err != nil {\n203|\t\t\tt.Fatalf(\"readCapped(%d): %v\", size, err)\n204|\t\t}\n205|\t\tif string(got) != want {\n206|\t\t\tt.Fatalf(\"readCapped(%d) = %q, want passthrough\", size, got)\n207|\t\t}\n208|\t}\n209|}\n210|\n211|// errAfterReader yields filler bytes up to a budget, then fails. It proves\n212|// readCapped stops consuming at cap+1: with the limiter the error past the\n213|// cap is never reached, while a limiter removed (reading the whole stream\n214|// into memory first) surfaces it.\n215|type errAfterReader struct {\n216|\tremaining int\n217|\tfiller    byte\n218|}\n219|\n220|func (reader *errAfterReader) Read(into []byte) (int, error) {\n221|\tif reader.remaining <= 0 {\n222|\t\treturn 0, errors.New(\"fake: past the cap\")\n223|\t}\n224|\tn := len(into)\n225|\tif n > reader.remaining {\n226|\t\tn = reader.remaining\n227|\t}\n228|\tfor i := 0; i < n; i++ {\n229|\t\tinto[i] = reader.filler\n230|\t}\n231|\treader.remaining -= n\n232|\treturn n, nil\n233|}\n234|\n235|// TestReadCappedStopsConsumingAtTheCap proves the limiter half of the\n236|// memory bound: a stream that fails past four caps is still cut cleanly,\n237|// because reads stop one byte past the cap instead of draining the\n238|// stream. Removing the limiter surfaces the stream error here.\n239|func TestReadCappedStopsConsumingAtTheCap(t *testing.T) {\n240|\tconst cap = 16\n241|\tgot, err := readCapped(&errAfterReader{remaining: 4 * cap, filler: 'd'}, cap)\n242|\tif err != nil {\n243|\t\tt.Fatalf(\"readCapped reached past the cap: %v\", err)\n244|\t}\n245|\tif string(got) != strings.Repeat(\"d\", cap) {\n246|\t\tt.Fatalf(\"readCapped kept %q, want %d prefix bytes\", got, cap)\n247|\t}\n248|}\n249|\n250|// TestCallTimesOutHungPlugin proves the deadline path: a plugin that\n251|// never answers is terminated at the request deadline and reported as\n252|// provider_timeout with exit 13.\n253|func TestCallTimesOutHungPlugin(t *testing.T) {\n254|\trunner := &scriptRunner{block: true}\n255|\thost := liveHost(runner)\n256|\treq := liveRequest(t)\n257|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n258|\tstart := time.Now()\n259|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n260|\tif elapsed := time.Since(start); elapsed > 10*time.Second {\n261|\t\tt.Fatalf(\"Call took %v, want deadline enforcement near 100ms\", elapsed)\n262|\t}\n263|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n264|\tif failureExit(t, err) != 13 {\n265|\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n266|\t}\n267|}\n268|\n269|// TestCallEmptyResultAfterDeadlineIsTimeout proves the late-empty\n270|// path: a runner that answers with nothing after the deadline still\n271|// reports provider_timeout, even though the process exited on its own.\n272|func TestCallEmptyResultAfterDeadlineIsTimeout(t *testing.T) {\n273|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n274|\thost := liveHost(runner)\n275|\treq := liveRequest(t)\n276|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n277|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n278|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n279|}\n280|\n281|// TestCallRunnerErrorBeforeDeadlineIsProcessFailure proves a transport\n282|// failure with time remaining is provider_process_failed, not a timeout.\n283|func TestCallRunnerErrorBeforeDeadlineIsProcessFailure(t *testing.T) {\n284|\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n285|\thost := liveHost(runner)\n286|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n287|\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n288|}\n289|\n290|// TestCallParentCancelIsNotTimeout proves a caller abort with time\n291|// remaining is provider_process_failed: the deadline never passed, so no\n292|// timeout may be claimed.\n293|func TestCallParentCancelIsNotTimeout(t *testing.T) {\n294|\trunner := &scriptRunner{block: true}\n295|\thost := liveHost(runner)\n296|\tctx, cancel := context.WithCancel(context.Background())\n297|\tcancel()\n298|\t_, err := host.Call(ctx, \"/plugins/ax-provider-pi\", liveRequest(t))\n299|\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n300|}\n301|\n302|// TestCallMissingResponse proves an empty stdout is a missing response:\n303|// provider_process_failed on a crash exit, provider_protocol_error when\n304|// the plugin claimed success by exiting 0.\n305|func TestCallMissingResponse(t *testing.T) {\n306|\tfor _, kase := range []struct {\n307|\t\tname   string\n308|\t\tcode   int\n309|\t\twant   string\n310|\t\tmember string\n311|\t}{\n312|\t\t{\"crash exit\", 3, \"provider_process_failed\", \"\"},\n313|\t\t{\"signal-like exit\", 137, \"provider_process_failed\", \"\"},\n314|\t\t{\"clean exit\", 0, \"provider_protocol_error\", \"\"},\n315|\t} {\n316|\t\tt.Run(kase.name, func(t *testing.T) {\n317|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: kase.code})}}\n318|\t\t\thost := liveHost(runner)\n319|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n320|\t\t\tif kase.want == \"provider_protocol_error\" {\n321|\t\t\t\trequireFrameRefusal(t, err, kase.member, \"plugin exited without a response\")\n322|\t\t\t} else {\n323|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.want), \"plugin exited without a response\")\n324|\t\t\t}\n325|\t\t})\n326|\t}\n327|}\n328|\n329|// TestCallRefusesUnusableStdout proves crashes, garbage, and\n330|// correlation breaks map to the Section 7.2 host-failure classes. The\n331|// production entry point is Host.Call.\n332|func TestCallRefusesUnusableStdout(t *testing.T) {\n333|\tfor _, kase := range []struct {\n334|\t\tname   string\n335|\t\tresult Result\n336|\t\twant   string\n337|\t\tmember string\n338|\t\tdetail string\n339|\t}{\n340|\t\t{\"garbage\", Result{Stdout: []byte(\"not json\\n\"), Stderr: []byte(\"traceback\\n\"), ExitCode: 1}, \"provider_protocol_error\", \"\", \"not a JSON object\"},\n341|\t\t{\"crash no output\", Result{ExitCode: 1}, \"provider_process_failed\", \"\", \"plugin exited without a response\"},\n342|\t\t{\"wrong request id\", Result{Stdout: successFrame(t, testOtherID, `{}`), ExitCode: 0}, \"provider_protocol_error\", \"request_id\", \"request_id does not match the request\"},\n343|\t\t{\"extra line\", Result{Stdout: append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n'), ExitCode: 0}, \"provider_protocol_error\", \"\", \"stdout carries more than one frame\"},\n344|\t\t{\"foreign major\", Result{Stdout: []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), ExitCode: 0}, \"incompatible_protocol\", \"\", \"\"},\n345|\t} {\n346|\t\tt.Run(kase.name, func(t *testing.T) {\n347|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(kase.result)}}\n348|\t\t\thost := liveHost(runner)\n349|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n350|\t\t\tswitch kase.want {\n351|\t\t\tcase \"provider_protocol_error\":\n352|\t\t\t\trequireFrameRefusal(t, err, kase.member, kase.detail)\n353|\t\t\tcase \"incompatible_protocol\":\n354|\t\t\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n355|\t\t\t\t\tt.Fatalf(\"Call code = %v, want incompatible_protocol\", err)\n356|\t\t\t\t}\n357|\t\t\t\tif observed, ok := failureObject(t, err).Detail(\"observed\"); !ok || observed != \"3.0.0\" {\n358|\t\t\t\t\tt.Fatalf(\"Call observed = %v, want the foreign version\", observed)\n359|\t\t\t\t}\n360|\t\t\tdefault:\n361|\t\t\t\trequireLocalRefusal(t, err, axerror.Code(kase.want), kase.detail)\n362|\t\t\t}\n363|\t\t})\n364|\t}\n365|}\n366|\n367|// TestCallSeparatesStderr proves stdout/stderr separation two ways: a\n368|// valid frame succeeds despite noisy diagnostics, and a failing\n369|// invocation never carries stderr content in its human text.\n370|func TestCallSeparatesStderr(t *testing.T) {\n371|\tsecret := \"[REDACTED]\"\n372|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{\n373|\t\tStdout:   successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`),\n374|\t\tStderr:   []byte(\"diagnostic: using \" + secret + \"\\n\"),\n375|\t\tExitCode: 0,\n376|\t})}}\n377|\thost := liveHost(runner)\n378|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); err != nil {\n379|\t\tt.Fatalf(\"Call with stderr diagnostics: %v\", err)\n380|\t}\n381|\n382|\tbad := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: []byte(\"garbage\\n\"), Stderr: []byte(secret + \"\\n\"), ExitCode: 1})}}\n383|\thost = liveHost(bad)\n384|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n385|\trequireFrameRefusal(t, err, \"\", \"not a JSON object\")\n386|\tif strings.Contains(err.Error(), secret) {\n387|\t\tt.Fatalf(\"stderr content leaked into the failure text: %v\", err)\n388|\t}\n389|}\n390|\n391|// TestCallOversizeStdoutRefuses proves a first line one byte over 8 MiB\n392|// fails as provider_protocol_error through the full Call path.\n393|func TestCallOversizeStdoutRefuses(t *testing.T) {\n394|\tpad := strings.Repeat(\"a\", specFrameLimitBytes)\n395|\tframe := successFrame(t, testRequestID, `{\"pad\":\"`+pad+`\"}`)\n396|\tif len(frame) <= specFrameLimitBytes {\n397|\t\tt.Fatalf(\"oversize stdout is %d bytes, want over %d\", len(frame), specFrameLimitBytes)\n398|\t}\n399|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: frame, ExitCode: 0})}}\n400|\thost := liveHost(runner)\n401|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n402|\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n403|}\n404|\n405|// TestCallOneProcessPerCall proves the single-flight cross-process\n406|// property: two calls start two processes with distinct request IDs.\n407|func TestCallOneProcessPerCall(t *testing.T) {\n408|\trunner := &scriptRunner{steps: []scriptStep{\n409|\t\tokStep(successResult(t, testRequestID, `{}`)),\n410|\t\tokStep(successResult(t, testOtherID, `{}`)),\n411|\t}}\n412|\thost := liveHost(runner)\n413|\tfirst := liveRequest(t)\n414|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", first); err != nil {\n415|\t\tt.Fatalf(\"first Call: %v\", err)\n416|\t}\n417|\tsecond := liveRequest(t)\n418|\tsecond.RequestID = mustUUIDv7(t, testOtherID)\n419|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", second); err != nil {\n420|\t\tt.Fatalf(\"second Call: %v\", err)\n421|\t}\n422|\tif runner.spawned() != 2 {\n423|\t\tt.Fatalf(\"two Calls spawned %d processes, want one per operation\", runner.spawned())\n424|\t}\n425|\tif string(runner.calls[0].stdin) == string(runner.calls[1].stdin) {\n426|\t\tt.Fatal(\"successive calls sent byte-identical frames; request IDs must differ\")\n427|\t}\n428|}\n429|\n430|// TestExecRunnerEchoRoundTrip drives the production call site end to\n431|// end: a real plugin script receives the frame on stdin and answers on\n432|// stdout while logging diagnostics to stderr.\n433|func TestExecRunnerEchoRoundTrip(t *testing.T) {\n434|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n435|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n436|\t}\n437|\troot := t.TempDir()\n438|\tscript := filepath.Join(root, \"ax-provider-echo\")\n439|\tplugin := `#!/bin/sh\n440|echo \"diagnostic: starting\" >&2\n441|frame=$(cat)\n442|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n443|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n444|exit 0\n445|`\n446|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n447|\t\tt.Fatalf(\"WriteFile: %v\", err)\n448|\t}\n449|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n450|\tgot, err := host.Call(context.Background(), script, liveRequest(t))\n451|\tif err != nil {\n452|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n453|\t}\n454|\tif string(got.Body) != `{\"provider_id\":\"echo\"}` {\n455|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n456|\t}\n457|}\n458|\n459|// TestExecRunnerEnforcesDeadline drives the production kill path: a\n460|// plugin that sleeps past the deadline is terminated and reported as\n461|// provider_timeout.\n462|func TestExecRunnerEnforcesDeadline(t *testing.T) {\n463|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n464|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n465|\t}\n466|\tscript := filepath.Join(t.TempDir(), \"ax-provider-sleep\")\n467|\tif err := os.WriteFile(script, []byte(\"#!/bin/sh\\nsleep 30\\n\"), 0o700); err != nil {\n468|\t\tt.Fatalf(\"WriteFile: %v\", err)\n469|\t}\n470|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n471|\treq := liveRequest(t)\n472|\tstamp, err := scalar.ParseTimestamp(time.Now().Add(300 * time.Millisecond).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n473|\tif err != nil {\n474|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n475|\t}\n476|\treq.Deadline = stamp\n477|\tstart := time.Now()\n478|\t_, err = host.Call(context.Background(), script, req)\n479|\telapsed := time.Since(start)\n480|\tif elapsed > 20*time.Second {\n481|\t\tt.Fatalf(\"Call took %v, want termination near the deadline\", elapsed)\n482|\t}\n483|\t// The script sleeps as a child of sh, so a parent-only kill would\n484|\t// leave it holding the pipes until WaitDelay (2s) expires. Returning\n485|\t// near the 300ms deadline proves the whole process group died.\n486|\tif elapsed >= waitDrainDelay {\n487|\t\tt.Fatalf(\"Call took %v, want group termination well before the %v drain delay\", elapsed, waitDrainDelay)\n488|\t}\n489|\trequireLocalRefusal(t, err, \"provider_timeout\", \"no response before the request deadline\")\n490|}\n491|\n492|// TestExecRunnerReportsCrashExit drives the production exit-code path: a\n493|// real plugin that exits 3 without answering is provider_process_failed,\n494|// while one that exits 0 without answering is provider_protocol_error.\n495|// Discarding ExitCode in ExecRunner promotes the crash to a protocol\n496|// error, and the promotion reddens here. The production entry point is\n497|// Host.Call over ExecRunner.\n498|func TestExecRunnerReportsCrashExit(t *testing.T) {\n499|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n500|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
