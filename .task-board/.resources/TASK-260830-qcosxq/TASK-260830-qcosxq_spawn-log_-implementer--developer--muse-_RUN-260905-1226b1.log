{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5db","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":328,"recorded_at":1780531400000651,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"task_stream":{"kind":"task","id":"75df3c0a-2186-40e4-b62a-b08c2b2842fb"},"task_id":"75df3c0a-2186-40e4-b62a-b08c2b2842fb","event":{"kind":"output","task_id":"75df3c0a-2186-40e4-b62a-b08c2b2842fb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/canonicaljson/grammar_inventory_test.go`.\n(898 line(s) above)\n899|\t\t\t\tif production.MatchString(value) {\n900|\t\t\t\t\tt.Errorf(\"witness %s value %q is admitted by the production grammar; it proves nothing\", key, value)\n901|\t\t\t\t}\n902|\t\t\t\tif !widened.MatchString(value) {\n903|\t\t\t\t\tt.Errorf(\n904|\t\t\t\t\t\t\"witness %s value %q is refused even by the widened grammar %q, so widening %s cannot make \"+\n905|\t\t\t\t\t\t\t\"this case pass and the dimension stays unproven\",\n906|\t\t\t\t\t\tkey, value, widened.String(), witness.dimension)\n907|\t\t\t\t}\n908|\t\t\t}\n909|\t\t\tcontinue\n910|\t\t}\n911|\t\tdefeated := 0\n912|\t\tfor _, narrowed := range narrowedGrammarVariants(declaredGrammars[witness.pattern].reference, site) {\n913|\t\t\tcompiled := regexp.MustCompile(narrowed)\n914|\t\t\tfor _, value := range witness.values {\n915|\t\t\t\tif !production.MatchString(value) {\n916|\t\t\t\t\tt.Errorf(\"witness %s value %q is not matched by the refusal grammar; it proves nothing\", key, value)\n917|\t\t\t\t}\n918|\t\t\t\tif !compiled.MatchString(value) {\n919|\t\t\t\t\tdefeated++\n920|\t\t\t\t}\n921|\t\t\t}\n922|\t\t}\n923|\t\tif defeated < 2 {\n924|\t\t\tt.Errorf(\n925|\t\t\t\t\"witness %s does not defeat both narrowings of its character class, so narrowing the class would \"+\n926|\t\t\t\t\t\"silently admit an absolute path\", key)\n927|\t\t}\n928|\t}\n929|}\n930|\n931|// narrowedGrammarVariants returns the first-item and last-item narrowings of a\n932|// character class, which are the two ways a declared class can lose members at\n933|// its edges.\n934|func narrowedGrammarVariants(source string, site grammarSite) []string {\n935|\tif site.kind != grammarClass {\n936|\t\treturn nil\n937|\t}\n938|\tbody := source[site.start+1 : site.end-1]\n939|\titems := characterClassItems(body)\n940|\tif len(items) < 2 {\n941|\t\treturn nil\n942|\t}\n943|\treturn []string{\n944|\t\tsource[:site.start] + \"[\" + items[0] + \"]\" + source[site.end:],\n945|\t\tsource[:site.start] + \"[\" + items[len(items)-1] + \"]\" + source[site.end:],\n946|\t}\n947|}\n948|\n949|func characterClassItems(body string) []string {\n950|\tvar items []string\n951|\tfor index := 0; index < len(body); {\n952|\t\tstart := index\n953|\t\tif body[index] == '\\\\' && index+1 < len(body) {\n954|\t\t\tindex += 2\n955|\t\t} else {\n956|\t\t\tindex++\n957|\t\t}\n958|\t\tif index+1 < len(body) && body[index] == '-' {\n959|\t\t\tindex += 2\n960|\t\t}\n961|\t\titems = append(items, body[start:index])\n962|\t}\n963|\treturn items\n964|}\n965|\n966|// TestEveryDeclaredGrammarDimensionIsRefusedAtTheProductionEntry drives every\n967|// witness through CalculateObjectIdentity and VerifyObjectIdentity, or\n968|// ValidateObservationEvent for Section 18.1 objects, at a position located by\n969|// probing rather than hand-wired, and requires the refusal to come from the\n970|// grammar under test rather than from any clause that happens to fire first.\n971|func TestEveryDeclaredGrammarDimensionIsRefusedAtTheProductionEntry(t *testing.T) {\n972|\tpatterns := deriveGrammarPatterns(t)\n973|\tlocated := locateGrammarPositions(t, patterns)\n974|\n975|\tvar admitted, misattributed []string\n976|\tfor _, witness := range declaredGrammarWitnesses() {\n977|\t\tpositions := located[witness.pattern]\n978|\t\tif len(positions) == 0 {\n979|\t\t\tcontinue // reported by TestEveryCompiledGrammarIsDeclaredAndReachable\n980|\t\t}\n981|\t\tposition := positions[0]\n982|\t\tfor _, value := range witness.values {\n983|\t\t\tcandidate := cloneJSONObject(t, position.fixture.object)\n984|\t\t\tif position.key != \"\" {\n985|\t\t\t\trenameObjectKey(t, candidate, position.path, position.key, value)\n986|\t\t\t} else {\n987|\t\t\t\tsetJSONValueAtPath(t, candidate, position.path, value)\n988|\t\t\t}\n989|\t\t\treason := fixtureRefusalReason(t, position.fixture, candidate)\n990|\t\t\tlabel := fmt.Sprintf(\"%s|%s %q at %s\", witness.pattern, witness.dimension, value, position.describe())\n991|\t\t\tif reason == \"\" {\n992|\t\t\t\tadmitted = append(admitted, label)\n993|\t\t\t\tcontinue\n994|\t\t\t}\n995|\t\t\tif !strings.Contains(reason, declaredGrammars[witness.pattern].refusal) {\n996|\t\t\t\tmisattributed = append(misattributed, label+\" refused by another clause: \"+reason)\n997|\t\t\t}\n998|\t\t}\n999|\t}\n1000|\n1001|\tsort.Strings(admitted)\n1002|\tsort.Strings(misattributed)\n1003|\tif len(admitted) > 0 {\n1004|\t\tt.Errorf(\n1005|\t\t\t\"the production entry ADMITTED and attested a value outside a declared grammar:\\n  %s\",\n1006|\t\t\tstrings.Join(admitted, \"\\n  \"))\n1007|\t}\n1008|\tif len(misattributed) > 0 {\n1009|\t\tt.Errorf(\n1010|\t\t\t\"witness(es) refused by a clause other than the grammar under test, so they pin nothing about that \"+\n1011|\t\t\t\t\"grammar:\\n  %s\", strings.Join(misattributed, \"\\n  \"))\n1012|\t}\n1013|}\n1014|\n1015|// TestBoardLogicalIDLengthIsSubsumedByItsDeclaredStringBound pins the one\n1016|// subsumption the grammar inventory claims. Board Identity logical_id is read\n1017|// through requireBoundedString(1, 128) before boardLogicalIDPattern sees it, so\n1018|// the pattern's own {0,127} repetition can never decide a 129-character value:\n1019|// the string bound refuses it first. Widening the repetition to {0,128} is\n1020|// therefore unobservable, and this test proves the ordering rather than assuming\n1021|// it.\n1022|func TestBoardLogicalIDLengthIsSubsumedByItsDeclaredStringBound(t *testing.T) {\n1023|\tconst declaredMaximum = 128\n1024|\n1025|\tatMaximum := \"A\" + strings.Repeat(\"b\", declaredMaximum-1)\n1026|\tpastMaximum := atMaximum + \"c\"\n1027|\tif len(atMaximum) != declaredMaximum {\n1028|\t\tt.Fatalf(\"bound fixture is %d characters, want %d\", len(atMaximum), declaredMaximum)\n1029|\t}\n1030|\n1031|\taccepted := taskBoardSessionRecord(\"TASK-260830-8x76g1\")\n1032|\tsetJSONValueAtPath(t, accepted, []string{\"task_board\", \"board\", \"logical_id\"}, atMaximum)\n1033|\tassertIdentityEntriesAcceptShape(t, mustJSON(t, accepted), SelfRecordID)\n1034|\n1035|\trefused := taskBoardSessionRecord(\"TASK-260830-8x76g1\")\n1036|\tsetJSONValueAtPath(t, refused, []string{\"task_board\", \"board\", \"logical_id\"}, pastMaximum)\n1037|\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, refused), SelfRecordID,\n1038|\t\tsubsumedGrammarDimensions[\"boardLogicalIDPattern|quantifier#1.max=127\"].subsumingRefusal)\n1039|}\n1040|\n1041|// grammarNeighbourFamilies are the character families a declared grammar can be\n1042|// widened by. They are chosen so that every widening a reviewer would actually\n1043|// write - \"admit uppercase too\", \"allow a hyphen\", \"allow a dot\" - moves at\n1044|// least one generated neighbour from refused to admitted.\n1045|var grammarNeighbourFamilies = []struct {\n1046|\tname      string\n1047|\tcharacter rune\n1048|}{\n1049|\t{\"uppercase\", 'Q'},\n1050|\t{\"lowercase\", 'q'},\n1051|\t{\"digit\", '7'},\n1052|\t{\"underscore\", '_'},\n1053|\t{\"hyphen\", '-'},\n1054|\t{\"dot\", '.'},\n1055|\t{\"colon\", ':'},\n1056|\t{\"slash\", '/'},\n1057|\t{\"space\", ' '},\n1058|\t{\"newline\", '\\n'},\n1059|\t{\"NUL\", '\\x00'},\n1060|\t{\"non-ASCII\", 'é'},\n1061|}\n1062|\n1063|// TestEveryDeclaredGrammarRefusesEveryOneCharacterNeighbourAtTheProductionEntry\n1064|// is the part of the inventory with real killing power, and it hand-writes\n1065|// nothing at all.\n1066|//\n1067|// The dimension witnesses above prove each STRUCTURAL feature with an attributed\n1068|// case, but a single witness per character class is admitted by the maximal\n1069|// widening of that class and says nothing about a narrower one: a mutant that\n1070|// widens [a-z] to [A-Za-z] survives a witness that used a digit. That gap is\n1071|// real - it survived a control mutant on providerIdentityKeyPattern.\n1072|//\n1073|// So this test starts from the value the fixture already carries at the located\n1074|// position, which is by construction a valid member of the declared language,\n1075|// and drives every one-character neighbour of it through the production entry:\n1076|// each position substituted by each character family, each family inserted at\n1077|// each position, and each position deleted. Every neighbour the grammar itself\n1078|// refuses must be refused at the entry. Widening a class by ANY family, dropping\n1079|// an anchor, or relaxing a quantifier moves at least one neighbour into the\n1080|// admitted set and fails here.\n1081|func TestEveryDeclaredGrammarRefusesEveryOneCharacterNeighbourAtTheProductionEntry(t *testing.T) {\n1082|\tpatterns := deriveGrammarPatterns(t)\n1083|\tlocated := locateGrammarPositions(t, patterns)\n1084|\n1085|\texercised := make(map[string]int)\n1086|\tvar admitted []string\n1087|\tfor name, pattern := range patterns {\n1088|\t\tif !pattern.admitting {\n1089|\t\t\t// A refusal matcher has no valid template: its dangerous direction is\n1090|\t\t\t// narrowing, proven by the witness table above.\n1091|\t\t\tcontinue\n1092|\t\t}\n1093|\t\tpositions := located[name]\n1094|\t\tif len(positions) == 0 {\n1095|\t\t\tcontinue // reported by TestEveryCompiledGrammarIsDeclaredAndReachable\n1096|\t\t}\n1097|\t\tposition := positions[0]\n1098|\t\ttemplate := position.key\n(more lines below)"}}}
