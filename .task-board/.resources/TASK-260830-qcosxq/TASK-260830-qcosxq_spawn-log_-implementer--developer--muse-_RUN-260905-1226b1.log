{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c591","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":291,"recorded_at":1780531400000577,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"task_stream":{"kind":"task","id":"fb69c9f2-21a6-4170-94ba-e047d6b375e8"},"task_id":"fb69c9f2-21a6-4170-94ba-e047d6b375e8","event":{"kind":"output","task_id":"fb69c9f2-21a6-4170-94ba-e047d6b375e8","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"regexp\"\n12|\t\"runtime\"\n13|\t\"sort\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n21|)\n22|\n23|// exercisedRefusalSites records the production file:line that constructed\n24|// a refusal, for every instrumented refusal constructor call made during\n25|// the test run. observedCodes records every stable code those refusals\n26|// carried.\n27|var exercisedRefusalSites sync.Map\n28|var observedCodes sync.Map\n29|\n30|func recordRefusalSite(code string) {\n31|\tobservedCodes.Store(code, struct{}{})\n32|\tif _, file, line, ok := runtime.Caller(2); ok {\n33|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n34|\t}\n35|}\n36|\n37|func TestMain(main *testing.M) {\n38|\torigInvalid, origProtocol, origMismatch := failInvalid, failProtocol, failMismatch\n39|\torigProcess, origTimeout, origIntegrity := failProcess, failTimeout, failIntegrity\n40|\tfailInvalid = func(detail string) (*axerror.Error, error) {\n41|\t\tfailure, err := origInvalid(detail)\n42|\t\tif err == nil {\n43|\t\t\trecordRefusalSite(string(failure.Code()))\n44|\t\t}\n45|\t\treturn failure, err\n46|\t}\n47|\tfailProtocol = func(detail, member string) (*axerror.Error, error) {\n48|\t\tfailure, err := origProtocol(detail, member)\n49|\t\tif err == nil {\n50|\t\t\trecordRefusalSite(string(failure.Code()))\n51|\t\t}\n52|\t\treturn failure, err\n53|\t}\n54|\tfailMismatch = func(detail, observed string) (*axerror.Error, error) {\n55|\t\tfailure, err := origMismatch(detail, observed)\n56|\t\tif err == nil {\n57|\t\t\trecordRefusalSite(string(failure.Code()))\n58|\t\t}\n59|\t\treturn failure, err\n60|\t}\n61|\tfailProcess = func(detail string, cause error) (*axerror.Error, error) {\n62|\t\tfailure, err := origProcess(detail, cause)\n63|\t\tif err == nil {\n64|\t\t\trecordRefusalSite(string(failure.Code()))\n65|\t\t}\n66|\t\treturn failure, err\n67|\t}\n68|\tfailTimeout = func(millisDetail string, millis int64) (*axerror.Error, error) {\n69|\t\tfailure, err := origTimeout(millisDetail, millis)\n70|\t\tif err == nil {\n71|\t\t\trecordRefusalSite(string(failure.Code()))\n72|\t\t}\n73|\t\treturn failure, err\n74|\t}\n75|\tfailIntegrity = func(detail, statusState, materializationID, transactionID string) (*axerror.Error, error) {\n76|\t\tfailure, err := origIntegrity(detail, statusState, materializationID, transactionID)\n77|\t\tif err == nil {\n78|\t\t\trecordRefusalSite(string(failure.Code()))\n79|\t\t}\n80|\t\treturn failure, err\n81|\t}\n82|\tcode := main.Run()\n83|\tif code == 0 && fullPackageTestRun() {\n84|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n85|\t\t\tfor _, failure := range failures {\n86|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n87|\t\t\t}\n88|\t\t\tcode = 1\n89|\t\t}\n90|\t}\n91|\tos.Exit(code)\n92|}\n93|\n94|func fullPackageTestRun() bool {\n95|\tselected := flag.Lookup(\"test.run\")\n96|\treturn selected == nil || selected.Value.String() == \"\"\n97|}\n98|\n99|// auditRefusalInventory derives the refusal inventory from package\n100|// source, never from memory: every production call to a refusal\n101|// constructor must have an exercised negative path, no Structured Error\n102|// may be built outside the six constructors, no raw error may be minted,\n103|// and the observed code set must equal the closed code set exactly.\n104|func auditRefusalInventory() []string {\n105|\tdirectory, err := os.Getwd()\n106|\tif err != nil {\n107|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n108|\t}\n109|\tinventory, err := deriveRefusalInventory(directory)\n110|\tif err != nil {\n111|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n112|\t}\n113|\tvar failures []string\n114|\t// Floor: a derived domain that can silently derive nothing is not a\n115|\t// measurement. An empty derivation must fail closed, never pass\n116|\t// vacuously — the same \"the scan is blind\" floor the discovery\n117|\t// package carries on its own scans.\n118|\tif len(inventory.ScannedFiles) == 0 {\n119|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n120|\t}\n121|\tif len(inventory.Sites) == 0 {\n122|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n123|\t}\n124|\t// Reverse direction: every exercised refusal site must resolve to a\n125|\t// derived site. The exercised set comes from the test run, not from\n126|\t// a hand list, so a truncated derivation reddens here even though\n127|\t// the forward check passes vacuously.\n128|\tderived := map[string]bool{}\n129|\tfor _, site := range inventory.Sites {\n130|\t\tderived[site] = true\n131|\t}\n132|\tvar outside []string\n133|\texercisedRefusalSites.Range(func(key, _ any) bool {\n134|\t\tsite := key.(string)\n135|\t\tif !derived[site] {\n136|\t\t\toutside = append(outside, site)\n137|\t\t}\n138|\t\treturn true\n139|\t})\n140|\tsort.Strings(outside)\n141|\tif len(outside) != 0 {\n142|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n143|\t}\n144|\tif len(inventory.StrayBuilders) != 0 {\n145|\t\tsort.Strings(inventory.StrayBuilders)\n146|\t\tfailures = append(failures, \"provhost failures built outside the refusal constructors: \"+strings.Join(inventory.StrayBuilders, \", \"))\n147|\t}\n148|\tif len(inventory.RawConstructors) != 0 {\n149|\t\tsort.Strings(inventory.RawConstructors)\n150|\t\tfailures = append(failures, \"provhost raw error construction: \"+strings.Join(inventory.RawConstructors, \", \"))\n151|\t}\n152|\tvar missing []string\n153|\tfor _, site := range inventory.Sites {\n154|\t\tif _, ok := exercisedRefusalSites.Load(site); !ok {\n155|\t\t\tmissing = append(missing, site)\n156|\t\t}\n157|\t}\n158|\tsort.Strings(missing)\n159|\tif len(missing) != 0 {\n160|\t\tfailures = append(failures, \"provhost refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n161|\t}\n162|\tvar codes []string\n163|\tobservedCodes.Range(func(key, _ any) bool {\n164|\t\tcodes = append(codes, key.(string))\n165|\t\treturn true\n166|\t})\n167|\tsort.Strings(codes)\n168|\twant := []string{\"incompatible_protocol\", \"integrity_failure\", \"invalid_config\", \"provider_process_failed\", \"provider_protocol_error\", \"provider_timeout\"}\n169|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n170|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n171|\t}\n172|\treturn failures\n173|}\n174|\n175|// refusalInventory is derived from package sources.\n176|type refusalInventory struct {\n177|\t// ScannedFiles are the production source basenames the derivation\n178|\t// parsed. The audit fails closed when this is empty.\n179|\tScannedFiles []string\n180|\t// Sites are file:line positions of production refusal constructor\n181|\t// calls. Every constructor call must sit on a single source line so\n182|\t// the runtime site and the parsed site agree.\n183|\tSites []string\n184|\t// StrayBuilders are axerror.New or axerror.LocalFromUntrusted calls\n185|\t// outside a constructor body.\n186|\tStrayBuilders []string\n187|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls\n188|\t// anywhere in production code. There is no allowlist: dynamic facts\n189|\t// travel in Structured Error details, never in Go error text.\n190|\tRawConstructors []string\n191|}\n192|\n193|var refusalConstructors = map[string]bool{\n194|\t\"failInvalid\":   true,\n195|\t\"failProtocol\":  true,\n196|\t\"failMismatch\":  true,\n197|\t\"failProcess\":   true,\n198|\t\"failTimeout\":   true,\n199|\t\"failIntegrity\": true,\n200|}\n201|\n202|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n203|\tentries, err := os.ReadDir(directory)\n204|\tif err != nil {\n205|\t\treturn refusalInventory{}, err\n206|\t}\n207|\tvar inventory refusalInventory\n208|\tfileSet := token.NewFileSet()\n209|\tfor _, entry := range entries {\n210|\t\tname := entry.Name()\n211|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n212|\t\t\tcontinue\n213|\t\t}\n214|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n215|\t\tpath := filepath.Join(directory, name)\n216|\t\tsource, err := os.ReadFile(path)\n217|\t\tif err != nil {\n218|\t\t\treturn refusalInventory{}, err\n219|\t\t}\n220|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n221|\t\tif err != nil {\n222|\t\t\treturn refusalInventory{}, err\n223|\t\t}\n224|\t\t// Map each constructor's own body span so builder calls inside\n225|\t\t// it are not mistaken for strays.\n226|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n227|\t\tfor _, decl := range syntax.Decls {\n228|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n229|\t\t\tif !ok {\n230|\t\t\t\tcontinue\n231|\t\t\t}\n232|\t\t\tfor _, spec := range general.Specs {\n233|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n234|\t\t\t\tif !ok {\n235|\t\t\t\t\tcontinue\n236|\t\t\t\t}\n237|\t\t\t\tfor i, ident := range values.Names {\n238|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n239|\t\t\t\t\t\tcontinue\n240|\t\t\t\t\t}\n241|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n242|\t\t\t\t\t\tconstructorBodies[literal] = true\n243|\t\t\t\t\t}\n244|\t\t\t\t}\n245|\t\t\t}\n246|\t\t}\n247|\t\tinsideConstructor := func(pos token.Pos) bool {\n248|\t\t\tfor body := range constructorBodies {\n249|\t\t\t\tif pos >= body.Pos() && pos <= body.End() {\n250|\t\t\t\t\treturn true\n251|\t\t\t\t}\n252|\t\t\t}\n253|\t\t\treturn false\n254|\t\t}\n255|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n256|\t\t\tcall, ok := node.(*ast.CallExpr)\n257|\t\t\tif !ok {\n258|\t\t\t\treturn true\n259|\t\t\t}\n260|\t\t\tposition := fileSet.Position(call.Pos())\n261|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n262|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n263|\t\t\t\tif refusalConstructors[ident.Name] {\n264|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n265|\t\t\t\t\treturn true\n266|\t\t\t\t}\n267|\t\t\t\tif ident.Name == \"panic\" {\n268|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n269|\t\t\t\t\treturn true\n270|\t\t\t\t}\n271|\t\t\t}\n272|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n273|\t\t\tif !ok {\n274|\t\t\t\treturn true\n275|\t\t\t}\n276|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n277|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n278|\t\t\t\tswitch qualified {\n279|\t\t\t\tcase \"axerror.New\", \"axerror.LocalFromUntrusted\":\n280|\t\t\t\t\tif !insideConstructor(call.Pos()) {\n281|\t\t\t\t\t\tinventory.StrayBuilders = append(inventory.StrayBuilders, site+\" \"+qualified)\n282|\t\t\t\t\t}\n283|\t\t\t\t\treturn true\n284|\t\t\t\tcase \"errors.New\", \"fmt.Errorf\":\n285|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n286|\t\t\t\t\treturn true\n287|\t\t\t\t}\n288|\t\t\t}\n289|\t\t\tif selector.Sel.Name == \"panic\" {\n290|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n291|\t\t\t}\n292|\t\t\treturn true\n293|\t\t})\n294|\t}\n295|\treturn inventory, nil\n296|}\n297|\n298|// sectionLines joins the pinned document lines for a section, failing\n299|// when the section boundaries move. Every citation below resolves\n300|// against the real text, never against a restatement in this repository.\n301|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n302|\tt.Helper()\n303|\tfor _, line := range []int{first, last} {\n304|\t\tgot, ok := document.SectionID(line)\n305|\t\tif !ok || got != section {\n306|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n307|\t\t}\n308|\t}\n309|\tvar body strings.Builder\n310|\tfor line := first; line <= last; line++ {\n311|\t\ttext, ok := document.Line(line)\n312|\t\tif !ok {\n313|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n314|\t\t}\n315|\t\tbody.WriteString(text)\n316|\t\tbody.WriteString(\"\\n\")\n317|\t}\n318|\treturn body.String()\n319|}\n320|\n321|// requireQuote asserts the excerpt occurs verbatim in the pinned\n322|// document and begins on a line inside the cited section.\n323|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n324|\tt.Helper()\n325|\tif !document.Contains(excerpt) {\n326|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n327|\t}\n328|\tlines := document.QuoteLines(excerpt)\n329|\tif len(lines) == 0 {\n330|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n331|\t}\n332|\tgot, ok := document.SectionID(lines[0])\n333|\tif !ok || got != section {\n334|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n335|\t}\n336|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n337|}\n338|\n339|var operationCellPattern = regexp.MustCompile(`^\\| <code>([a-z-]+)</code> \\|`)\n340|\n341|// TestOperationRegistryIsDerivedFromSpec proves the dispatch registry is\n342|// exactly the Section 7.5 operation table in order: every table row must\n343|// appear in Operations() at the same position, and nothing else may.\n344|// A dropped, added, or reordered entry reddens here.\n345|func TestOperationRegistryIsDerivedFromSpec(t *testing.T) {\n346|\tdocument, err := specdoc.Load()\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n349|\t}\n350|\twindow := sectionLines(t, document, \"7.5\", 3070, 3086)\n351|\tvar derived []string\n352|\tfor _, line := range strings.Split(window, \"\\n\") {\n353|\t\tif match := operationCellPattern.FindStringSubmatch(line); match != nil {\n354|\t\t\tderived = append(derived, match[1])\n355|\t\t}\n356|\t}\n357|\tif len(derived) == 0 {\n358|\t\tt.Fatal(\"derived no operations from the Section 7.5 table; the check is blind\")\n359|\t}\n360|\tgot := Operations()\n361|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n362|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.5 table %v\", got, derived)\n363|\t}\n364|\tt.Logf(\"operation registry coverage: %d/%d table entries dispatched\", len(got), len(derived))\n365|}\n366|\n367|// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\n368|// package implements: the framing limits, the process model, the\n369|// envelope shapes, the closed-member rule, and the deadline/redaction\n370|// duties.\n371|func TestSection72FramingIsPinned(t *testing.T) {\n372|\tdocument, err := specdoc.Load()\n373|\tif err != nil {\n374|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n375|\t}\n376|\tfor _, excerpt := range []string{\n377|\t\t\"Each line MUST be one complete UTF-8\",\n378|\t\t\"JSON object no larger than 8 MiB\",\n379|\t\t\"Stdout MUST contain protocol frames only\",\n380|\t\t\"human diagnostics go to stderr\",\n381|\t\t\"starts one plugin process per operation\",\n382|\t\t\"After one response, <code>ax</code> closes stdin and the\",\n383|\t\t\"Exit 0 requires a successful response\",\n384|\t\t\"A structured error\",\n385|\t\t\"response SHOULD exit 0 because the protocol succeeded\",\n386|\t\t\"a crash, invalid frame,\",\n387|\t\t\"or missing response is a provider-host failure\",\n388|\t\t\"The deadline MUST be in the future when the host writes the frame\",\n389|\t\t\"A failure envelope contains\",\n390|\t\t\"and MUST NOT contain <code>body</code>\",\n391|\t\t\"Envelope and body\",\n392|\t\t\"unknown members are protocol errors under major version 2\",\n393|\t\t\"The host MUST terminate a plugin that exceeds its deadline and report\",\n394|\t\t\"<code>provider_timeout</code>\",\n395|\t\t\"It MUST redact environment and stderr before\",\n396|\t\t\"logging\",\n397|\t} {\n398|\t\trequireQuote(t, document, excerpt, \"7.2\")\n399|\t}\n400|}\n401|\n402|// TestSection151ProviderRowIsPinned quotes the Section 15.1 provider\n403|// row behind the local failure mapping: recognizable majors yield\n404|// incompatible_protocol, everything else unusable yields\n405|// provider_protocol_error, and a different major's payload is never\n406|// trusted.\n407|func TestSection151ProviderRowIsPinned(t *testing.T) {\n408|\tdocument, err := specdoc.Load()\n409|\tif err != nil {\n410|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n411|\t}\n412|\tfor _, excerpt := range []string{\n413|\t\t\"The host accepts no child error object, terminates/waits for exit as applicable, and emits its own local Error 1.0.0\",\n414|\t\t\"<code>incompatible_protocol</code> for a recognizable major mismatch, otherwise <code>provider_protocol_error</code>\",\n415|\t\t\"Receivers MUST NOT parse a different major\",\n416|\t\t\"payload far enough to trust its error code, retryable bit, details, or\",\n417|\t} {\n418|\t\trequireQuote(t, document, excerpt, \"15.1\")\n419|\t}\n420|}\n421|\n422|// TestStatusRecoveryRulesArePinned quotes the Section 7.5 recovery\n423|// sentences behind DecodeStatusOutcome: the evolving status read, the\n424|// unknown quarantine, and the state/nullability table.\n425|func TestStatusRecoveryRulesArePinned(t *testing.T) {\n426|\tdocument, err := specdoc.Load()\n427|\tif err != nil {\n428|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n429|\t}\n430|\tfor _, excerpt := range []string{\n431|\t\t\"is the required evolving lost-response recovery\",\n432|\t\t\"An unknown transaction MUST return state\",\n433|\t\t\"<code>unknown</code>; the host MUST NOT infer success\",\n434|\t\t\"An unreadable or\",\n435|\t\t\"integrity-invalid transaction MUST fail with <code>integrity_failure</code> and\",\n436|\t\t\"MUST be quarantined rather than represented as a successful status object\",\n437|\t\t\"<code>unknown</code> requires null\",\n438|\t\t\"requires all three non-null\",\n439|\t} {\n440|\t\trequireQuote(t, document, excerpt, \"7.5\")\n441|\t}\n442|}\n443|\n444|// TestStableCodesAreRegistered pins every refusal code this package\n445|// emits against the pinned error registry and the exact exit the host\n446|// surfaces, and agrees with the axerror wire table.\n447|func TestStableCodesAreRegistered(t *testing.T) {\n448|\tregistered := map[string]int{}\n449|\tfor _, row := range catalog.Current().Errors {\n450|\t\tregistered[string(row.Code)] = row.ExitCode\n451|\t}\n452|\tfor code, wantExit := range map[string]int{\n453|\t\t\"invalid_config\":          3,\n454|\t\t\"provider_protocol_error\": 13,\n455|\t\t\"incompatible_protocol\":   6,\n456|\t\t\"provider_process_failed\": 13,\n457|\t\t\"provider_timeout\":        13,\n458|\t\t\"integrity_failure\":       9,\n459|\t} {\n460|\t\tgotExit, ok := registered[code]\n461|\t\tif !ok {\n462|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n463|\t\t}\n464|\t\tif gotExit != wantExit {\n465|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n466|\t\t}\n467|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n468|\t\tif err != nil {\n469|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n470|\t\t}\n471|\t\tif gotWire != wantExit {\n472|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n473|\t\t}\n474|\t}\n475|\tt.Logf(\"refusal code coverage: 6/6 package codes registered with pinned exits\")\n476|}\n477|\n478|// TestRefusalConstructorsAreTotal proves the fallible-constructor error\n479|// path never fires in practice: every constructor returns a failure and\n480|// a nil error across representative dynamic causes. The sites recorded\n481|// here are test lines, not production sites, so every key this test adds\n482|// to the exercised set is removed before it returns, keeping the\n483|// reverse-direction audit exact.\n484|func TestRefusalConstructorsAreTotal(t *testing.T) {\n485|\tvar beforeSites, beforeCodes []any\n486|\texercisedRefusalSites.Range(func(key, _ any) bool { beforeSites = append(beforeSites, key); return true })\n487|\tobservedCodes.Range(func(key, _ any) bool { beforeCodes = append(beforeCodes, key); return true })\n488|\tt.Cleanup(func() {\n489|\t\tkeepSites := map[any]bool{}\n490|\t\tfor _, key := range beforeSites {\n491|\t\t\tkeepSites[key] = true\n492|\t\t}\n493|\t\texercisedRefusalSites.Range(func(key, _ any) bool {\n494|\t\t\tif !keepSites[key] {\n495|\t\t\t\texercisedRefusalSites.Delete(key)\n496|\t\t\t}\n497|\t\t\treturn true\n498|\t\t})\n499|\t\tkeepCodes := map[any]bool{}\n500|\t\tfor _, key := range beforeCodes {\n(more lines below)"}}}
