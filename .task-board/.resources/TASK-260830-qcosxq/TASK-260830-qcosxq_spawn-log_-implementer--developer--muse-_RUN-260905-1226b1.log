/workflows/ci.yml:41:        run: GOOS=windows go vet ./...\\n===\\nAGENTS.md\\nCLAUDE.md\\ngo.mod\\ngo.sum\\ninternal\\nLOGBOOK.md\\nREADME.md\\nSkillfile.json\\ntask-board.config.json\\ngo version go1.25.5 darwin/arm64\\n\",\n  \"original_output_bytes\": 3168,\n  \"original_output_tokens\": 792,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
