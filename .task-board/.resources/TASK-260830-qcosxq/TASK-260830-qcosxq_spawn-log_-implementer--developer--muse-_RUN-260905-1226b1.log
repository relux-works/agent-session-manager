{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c595","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":293,"recorded_at":1780531400000581,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"call_id":"call_01a06f4850a073d2bd050ecee13cfff2","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"regexp\"\n12|\t\"runtime\"\n13|\t\"sort\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n21|)\n22|\n23|// exercisedRefusalSites records the production file:line that constructed\n24|// a refusal, for every instrumented refusal constructor call made during\n25|// the test run. observedCodes records every stable code those refusals\n26|// carried.\n27|var exercisedRefusalSites sync.Map\n28|var observedCodes sync.Map\n29|\n30|func recordRefusalSite(code string) {\n31|\tobservedCodes.Store(code, struct{}{})\n32|\tif _, file, line, ok := runtime.Caller(2); ok {\n33|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n34|\t}\n35|}\n36|\n37|func TestMain(main *testing.M) {\n38|\torigInvalid, origProtocol, origMismatch := failInvalid, failProtocol, failMismatch\n39|\torigProcess, origTimeout, origIntegrity := failProcess, failTimeout, failIntegrity\n40|\tfailInvalid = func(detail string) (*axerror.Error, error) {\n41|\t\tfailure, err := origInvalid(detail)\n42|\t\tif err == nil {\n43|\t\t\trecordRefusalSite(string(failure.Code()))\n44|\t\t}\n45|\t\treturn failure, err\n46|\t}\n47|\tfailProtocol = func(detail, member string) (*axerror.Error, error) {\n48|\t\tfailure, err := origProtocol(detail, member)\n49|\t\tif err == nil {\n50|\t\t\trecordRefusalSite(string(failure.Code()))\n51|\t\t}\n52|\t\treturn failure, err\n53|\t}\n54|\tfailMismatch = func(detail, observed string) (*axerror.Error, error) {\n55|\t\tfailure, err := origMismatch(detail, observed)\n56|\t\tif err == nil {\n57|\t\t\trecordRefusalSite(string(failure.Code()))\n58|\t\t}\n59|\t\treturn failure, err\n60|\t}\n61|\tfailProcess = func(detail string, cause error) (*axerror.Error, error) {\n62|\t\tfailure, err := origProcess(detail, cause)\n63|\t\tif err == nil {\n64|\t\t\trecordRefusalSite(string(failure.Code()))\n65|\t\t}\n66|\t\treturn failure, err\n67|\t}\n68|\tfailTimeout = func(millisDetail string, millis int64) (*axerror.Error, error) {\n69|\t\tfailure, err := origTimeout(millisDetail, millis)\n70|\t\tif err == nil {\n71|\t\t\trecordRefusalSite(string(failure.Code()))\n72|\t\t}\n73|\t\treturn failure, err\n74|\t}\n75|\tfailIntegrity = func(detail, statusState, materializationID, transactionID string) (*axerror.Error, error) {\n76|\t\tfailure, err := origIntegrity(detail, statusState, materializationID, transactionID)\n77|\t\tif err == nil {\n78|\t\t\trecordRefusalSite(string(failure.Code()))\n79|\t\t}\n80|\t\treturn failure, err\n81|\t}\n82|\tcode := main.Run()\n83|\tif code == 0 && fullPackageTestRun() {\n84|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n85|\t\t\tfor _, failure := range failures {\n86|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n87|\t\t\t}\n88|\t\t\tcode = 1\n89|\t\t}\n90|\t}\n91|\tos.Exit(code)\n92|}\n93|\n94|func fullPackageTestRun() bool {\n95|\tselected := flag.Lookup(\"test.run\")\n96|\treturn selected == nil || selected.Value.String() == \"\"\n97|}\n98|\n99|// auditRefusalInventory derives the refusal inventory from package\n100|// source, never from memory: every production call to a refusal\n101|// constructor must have an exercised negative path, no Structured Error\n102|// may be built outside the six constructors, no raw error may be minted,\n103|// and the observed code set must equal the closed code set exactly.\n104|func auditRefusalInventory() []string {\n105|\tdirectory, err := os.Getwd()\n106|\tif err != nil {\n107|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n108|\t}\n109|\tinventory, err := deriveRefusalInventory(directory)\n110|\tif err != nil {\n111|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n112|\t}\n113|\tvar failures []string\n114|\t// Floor: a derived domain that can silently derive nothing is not a\n115|\t// measurement. An empty derivation must fail closed, never pass\n116|\t// vacuously — the same \"the scan is blind\" floor the discovery\n117|\t// package carries on its own scans.\n118|\tif len(inventory.ScannedFiles) == 0 {\n119|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n120|\t}\n121|\tif len(inventory.Sites) == 0 {\n122|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n123|\t}\n124|\t// Reverse direction: every exercised refusal site must resolve to a\n125|\t// derived site. The exercised set comes from the test run, not from\n126|\t// a hand list, so a truncated derivation reddens here even though\n127|\t// the forward check passes vacuously.\n128|\tderived := map[string]bool{}\n129|\tfor _, site := range inventory.Sites {\n130|\t\tderived[site] = true\n131|\t}\n132|\tvar outside []string\n133|\texercisedRefusalSites.Range(func(key, _ any) bool {\n134|\t\tsite := key.(string)\n135|\t\tif !derived[site] {\n136|\t\t\toutside = append(outside, site)\n137|\t\t}\n138|\t\treturn true\n139|\t})\n140|\tsort.Strings(outside)\n141|\tif len(outside) != 0 {\n142|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n143|\t}\n144|\tif len(inventory.StrayBuilders) != 0 {\n145|\t\tsort.Strings(inventory.StrayBuilders)\n146|\t\tfailures = append(failures, \"provhost failures built outside the refusal constructors: \"+strings.Join(inventory.StrayBuilders, \", \"))\n147|\t}\n148|\tif len(inventory.RawConstructors) != 0 {\n149|\t\tsort.Strings(inventory.RawConstructors)\n150|\t\tfailures = append(failures, \"provhost raw error construction: \"+strings.Join(inventory.RawConstructors, \", \"))\n151|\t}\n152|\tvar missing []string\n153|\tfor _, site := range inventory.Sites {\n154|\t\tif _, ok := exercisedRefusalSites.Load(site); !ok {\n155|\t\t\tmissing = append(missing, site)\n156|\t\t}\n157|\t}\n158|\tsort.Strings(missing)\n159|\tif len(missing) != 0 {\n160|\t\tfailures = append(failures, \"provhost refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n161|\t}\n162|\tvar codes []string\n163|\tobservedCodes.Range(func(key, _ any) bool {\n164|\t\tcodes = append(codes, key.(string))\n165|\t\treturn true\n166|\t})\n167|\tsort.Strings(codes)\n168|\twant := []string{\"incompatible_protocol\", \"integrity_failure\", \"invalid_config\", \"provider_process_failed\", \"provider_protocol_error\", \"provider_timeout\"}\n169|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n170|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n171|\t}\n172|\treturn failures\n173|}\n174|\n175|// refusalInventory is derived from package sources.\n176|type refusalInventory struct {\n177|\t// ScannedFiles are the production source basenames the derivation\n178|\t// parsed. The audit fails closed when this is empty.\n179|\tScannedFiles []string\n180|\t// Sites are file:line positions of production refusal constructor\n181|\t// calls. Every constructor call must sit on a single source line so\n182|\t// the runtime site and the parsed site agree.\n183|\tSites []string\n184|\t// StrayBuilders are axerror.New or axerror.LocalFromUntrusted calls\n185|\t// outside a constructor body.\n186|\tStrayBuilders []string\n187|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls\n188|\t// anywhere in production code. There is no allowlist: dynamic facts\n189|\t// travel in Structured Error details, never in Go error text.\n190|\tRawConstructors []string\n191|}\n192|\n193|var refusalConstructors = map[string]bool{\n194|\t\"failInvalid\":   true,\n195|\t\"failProtocol\":  true,\n196|\t\"failMismatch\":  true,\n197|\t\"failProcess\":   true,\n198|\t\"failTimeout\":   true,\n199|\t\"failIntegrity\": true,\n200|}\n201|\n202|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n203|\tentries, err := os.ReadDir(directory)\n204|\tif err != nil {\n205|\t\treturn refusalInventory{}, err\n206|\t}\n207|\tvar inventory refusalInventory\n208|\tfileSet := token.NewFileSet()\n209|\tfor _, entry := range entries {\n210|\t\tname := entry.Name()\n211|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n212|\t\t\tcontinue\n213|\t\t}\n214|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n215|\t\tpath := filepath.Join(directory, name)\n216|\t\tsource, err := os.ReadFile(path)\n217|\t\tif err != nil {\n218|\t\t\treturn refusalInventory{}, err\n219|\t\t}\n220|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n221|\t\tif err != nil {\n222|\t\t\treturn refusalInventory{}, err\n223|\t\t}\n224|\t\t// Map each constructor's own body span so builder calls inside\n225|\t\t// it are not mistaken for strays.\n226|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n227|\t\tfor _, decl := range syntax.Decls {\n228|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n229|\t\t\tif !ok {\n230|\t\t\t\tcontinue\n231|\t\t\t}\n232|\t\t\tfor _, spec := range general.Specs {\n233|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n234|\t\t\t\tif !ok {\n235|\t\t\t\t\tcontinue\n236|\t\t\t\t}\n237|\t\t\t\tfor i, ident := range values.Names {\n238|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n239|\t\t\t\t\t\tcontinue\n240|\t\t\t\t\t}\n241|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n242|\t\t\t\t\t\tconstructorBodies[literal] = true\n243|\t\t\t\t\t}\n244|\t\t\t\t}\n245|\t\t\t}\n246|\t\t}\n247|\t\tinsideConstructor := func(pos token.Pos) bool {\n248|\t\t\tfor body := range constructorBodies {\n249|\t\t\t\tif pos >= body.Pos() && pos <= body.End() {\n250|\t\t\t\t\treturn true\n251|\t\t\t\t}\n252|\t\t\t}\n253|\t\t\treturn false\n254|\t\t}\n255|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n256|\t\t\tcall, ok := node.(*ast.CallExpr)\n257|\t\t\tif !ok {\n258|\t\t\t\treturn true\n259|\t\t\t}\n260|\t\t\tposition := fileSet.Position(call.Pos())\n261|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n262|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n263|\t\t\t\tif refusalConstructors[ident.Name] {\n264|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n265|\t\t\t\t\treturn true\n266|\t\t\t\t}\n267|\t\t\t\tif ident.Name == \"panic\" {\n268|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n269|\t\t\t\t\treturn true\n270|\t\t\t\t}\n271|\t\t\t}\n272|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n273|\t\t\tif !ok {\n274|\t\t\t\treturn true\n275|\t\t\t}\n276|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n277|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n278|\t\t\t\tswitch qualified {\n279|\t\t\t\tcase \"axerror.New\", \"axerror.LocalFromUntrusted\":\n280|\t\t\t\t\tif !insideConstructor(call.Pos()) {\n281|\t\t\t\t\t\tinventory.StrayBuilders = append(inventory.StrayBuilders, site+\" \"+qualified)\n282|\t\t\t\t\t}\n283|\t\t\t\t\treturn true\n284|\t\t\t\tcase \"errors.New\", \"fmt.Errorf\":\n285|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n286|\t\t\t\t\treturn true\n287|\t\t\t\t}\n288|\t\t\t}\n289|\t\t\tif selector.Sel.Name == \"panic\" {\n290|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n291|\t\t\t}\n292|\t\t\treturn true\n293|\t\t})\n294|\t}\n295|\treturn inventory, nil\n296|}\n297|\n298|// sectionLines joins the pinned document lines for a section, failing\n299|// when the section boundaries move. Every citation below resolves\n300|// against the real text, never against a restatement in this repository.\n301|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n302|\tt.Helper()\n303|\tfor _, line := range []int{first, last} {\n304|\t\tgot, ok := document.SectionID(line)\n305|\t\tif !ok || got != section {\n306|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n307|\t\t}\n308|\t}\n309|\tvar body strings.Builder\n310|\tfor line := first; line <= last; line++ {\n311|\t\ttext, ok := document.Line(line)\n312|\t\tif !ok {\n313|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n314|\t\t}\n315|\t\tbody.WriteString(text)\n316|\t\tbody.WriteString(\"\\n\")\n317|\t}\n318|\treturn body.String()\n319|}\n320|\n321|// requireQuote asserts the excerpt occurs verbatim in the pinned\n322|// document and begins on a line inside the cited section.\n323|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n324|\tt.Helper()\n325|\tif !document.Contains(excerpt) {\n326|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n327|\t}\n328|\tlines := document.QuoteLines(excerpt)\n329|\tif len(lines) == 0 {\n330|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n331|\t}\n332|\tgot, ok := document.SectionID(lines[0])\n333|\tif !ok || got != section {\n334|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n335|\t}\n336|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n337|}\n338|\n339|var operationCellPattern = regexp.MustCompile(`^\\| <code>([a-z-]+)</code> \\|`)\n340|\n341|// TestOperationRegistryIsDerivedFromSpec proves the dispatch registry is\n342|// exactly the Section 7.5 operation table in order: every table row must\n343|// appear in Operations() at the same position, and nothing else may.\n344|// A dropped, added, or reordered entry reddens here.\n345|func TestOperationRegistryIsDerivedFromSpec(t *testing.T) {\n346|\tdocument, err := specdoc.Load()\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n349|\t}\n350|\twindow := sectionLines(t, document, \"7.5\", 3070, 3086)\n351|\tvar derived []string\n352|\tfor _, line := range strings.Split(window, \"\\n\") {\n353|\t\tif match := operationCellPattern.FindStringSubmatch(line); match != nil {\n354|\t\t\tderived = append(derived, match[1])\n355|\t\t}\n356|\t}\n357|\tif len(derived) == 0 {\n358|\t\tt.Fatal(\"derived no operations from the Section 7.5 table; the check is blind\")\n359|\t}\n360|\tgot := Operations()\n361|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n362|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.5 table %v\", got, derived)\n363|\t}\n364|\tt.Logf(\"operation registry coverage: %d/%d table entries dispatched\", len(got), len(derived))\n365|}\n366|\n367|// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\n368|// package implements: the framing limits, the process model, the\n369|// envelope shapes, the closed-member rule, and the deadline/redaction\n370|// duties.\n371|func TestSection72FramingIsPinned(t *testing.T) {\n372|\tdocument, err := specdoc.Load()\n373|\tif err != nil {\n374|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n375|\t}\n376|\tfor _, excerpt := range []string{\n377|\t\t\"Each line MUST be one complete UTF-8\",\n378|\t\t\"JSON object no larger than 8 MiB\",\n379|\t\t\"Stdout MUST contain protocol frames only\",\n380|\t\t\"human diagnostics go to stderr\",\n381|\t\t\"starts one plugin process per operation\",\n382|\t\t\"After one response, <code>ax</code> closes stdin and the\",\n383|\t\t\"Exit 0 requires a successful response\",\n384|\t\t\"A structured error\",\n385|\t\t\"response SHOULD exit 0 because the protocol succeeded\",\n386|\t\t\"a crash, invalid frame,\",\n387|\t\t\"or missing response is a provider-host failure\",\n388|\t\t\"The deadline MUST be in the future when the host writes the frame\",\n389|\t\t\"A failure envelope contains\",\n390|\t\t\"and MUST NOT contain <code>body</code>\",\n391|\t\t\"Envelope and body\",\n392|\t\t\"unknown members are protocol errors under major version 2\",\n393|\t\t\"The host MUST terminate a plugin that exceeds its deadline and report\",\n394|\t\t\"<code>provider_timeout</code>\",\n395|\t\t\"It MUST redact environment and stderr before\",\n396|\t\t\"logging\",\n397|\t} {\n398|\t\trequireQuote(t, document, excerpt, \"7.2\")\n399|\t}\n400|}\n401|\n402|// TestSection151ProviderRowIsPinned quotes the Section 15.1 provider\n403|// row behind the local failure mapping: recognizable majors yield\n404|// incompatible_protocol, everything else unusable yields\n405|// provider_protocol_error, and a different major's payload is never\n406|// trusted.\n407|func TestSection151ProviderRowIsPinned(t *testing.T) {\n408|\tdocument, err := specdoc.Load()\n409|\tif err != nil {\n410|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n411|\t}\n412|\tfor _, excerpt := range []string{\n413|\t\t\"The host accepts no child error object, terminates/waits for exit as applicable, and emits its own local Error 1.0.0\",\n414|\t\t\"<code>incompatible_protocol</code> for a recognizable major mismatch, otherwise <code>provider_protocol_error</code>\",\n415|\t\t\"Receivers MUST NOT parse a different major\",\n416|\t\t\"payload far enough to trust its error code, retryable bit, details, or\",\n417|\t} {\n418|\t\trequireQuote(t, document, excerpt, \"15.1\")\n419|\t}\n420|}\n421|\n422|// TestStatusRecoveryRulesArePinned quotes the Section 7.5 recovery\n423|// sentences behind DecodeStatusOutcome: the evolving status read, the\n424|// unknown quarantine, and the state/nullability table.\n425|func TestStatusRecoveryRulesArePinned(t *testing.T) {\n426|\tdocument, err := specdoc.Load()\n427|\tif err != nil {\n428|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n429|\t}\n430|\tfor _, excerpt := range []string{\n431|\t\t\"is the required evolving lost-response recovery\",\n432|\t\t\"An unknown transaction MUST return state\",\n433|\t\t\"<code>unknown</code>; the host MUST NOT infer success\",\n434|\t\t\"An unreadable or\",\n435|\t\t\"integrity-invalid transaction MUST fail with <code>integrity_failure</code> and\",\n436|\t\t\"MUST be quarantined rather than represented as a successful status object\",\n437|\t\t\"<code>unknown</code> requires null\",\n438|\t\t\"requires all three non-null\",\n439|\t} {\n440|\t\trequireQuote(t, document, excerpt, \"7.5\")\n441|\t}\n442|}\n443|\n444|// TestStableCodesAreRegistered pins every refusal code this package\n445|// emits against the pinned error registry and the exact exit the host\n446|// surfaces, and agrees with the axerror wire table.\n447|func TestStableCodesAreRegistered(t *testing.T) {\n448|\tregistered := map[string]int{}\n449|\tfor _, row := range catalog.Current().Errors {\n450|\t\tregistered[string(row.Code)] = row.ExitCode\n451|\t}\n452|\tfor code, wantExit := range map[string]int{\n453|\t\t\"invalid_config\":          3,\n454|\t\t\"provider_protocol_error\": 13,\n455|\t\t\"incompatible_protocol\":   6,\n456|\t\t\"provider_process_failed\": 13,\n457|\t\t\"provider_timeout\":        13,\n458|\t\t\"integrity_failure\":       9,\n459|\t} {\n460|\t\tgotExit, ok := registered[code]\n461|\t\tif !ok {\n462|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n463|\t\t}\n464|\t\tif gotExit != wantExit {\n465|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n466|\t\t}\n467|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n468|\t\tif err != nil {\n469|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n470|\t\t}\n471|\t\tif gotWire != wantExit {\n472|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n473|\t\t}\n474|\t}\n475|\tt.Logf(\"refusal code coverage: 6/6 package codes registered with pinned exits\")\n476|}\n477|\n478|// TestRefusalConstructorsAreTotal proves the fallible-constructor error\n479|// path never fires in practice: every constructor returns a failure and\n480|// a nil error across representative dynamic causes. The sites recorded\n481|// here are test lines, not production sites, so every key this test adds\n482|// to the exercised set is removed before it returns, keeping the\n483|// reverse-direction audit exact.\n484|func TestRefusalConstructorsAreTotal(t *testing.T) {\n485|\tvar beforeSites, beforeCodes []any\n486|\texercisedRefusalSites.Range(func(key, _ any) bool { beforeSites = append(beforeSites, key); return true })\n487|\tobservedCodes.Range(func(key, _ any) bool { beforeCodes = append(beforeCodes, key); return true })\n488|\tt.Cleanup(func() {\n489|\t\tkeepSites := map[any]bool{}\n490|\t\tfor _, key := range beforeSites {\n491|\t\t\tkeepSites[key] = true\n492|\t\t}\n493|\t\texercisedRefusalSites.Range(func(key, _ any) bool {\n494|\t\t\tif !keepSites[key] {\n495|\t\t\t\texercisedRefusalSites.Delete(key)\n496|\t\t\t}\n497|\t\t\treturn true\n498|\t\t})\n499|\t\tkeepCodes := map[any]bool{}\n500|\t\tfor _, key := range beforeCodes {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c597","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":294,"recorded_at":1780531400000583,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"call_id":"call_01a06f4851c87372a3a8a795769d8f5e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/canonicaljson/grammar_inventory_test.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/token\"\n7|\t\"regexp\"\n8|\t\"sort\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file pins the SEMANTICS of every declared grammar this package compiles.\n15|//\n16|// The failure it exists to prevent: a regular expression is a matcher, and a\n17|// test that refuses one value outside it proves the matcher is REACHABLE, not\n18|// that the admitted language is the declared one. A derived sweep confirmed the\n19|// gap: widening observationNamePattern from {1,7} to {1,8} segments, from {1,7}\n20|// to {0,7} so a bare single-segment name is admitted, and adding a hyphen to its\n21|// character class each left `go test ./...`, every seeded fuzz corpus,\n22|// tracecheck, the declared-bounds gate and the closed-vocabulary pin green.\n23|// boardLogicalIDPattern survived the same treatment at {0,127} -> {0,128}.\n24|//\n25|// The obligation is therefore derived from the pattern source itself: every\n26|// anchor, every character class, every counted quantifier bound and every\n27|// one-or-more quantifier in every production regexp is one dimension that must\n28|// carry a witness which the UNwidened pattern refuses. Adding a pattern, or\n29|// adding a class or a quantifier to an existing one, fails at derivation until\n30|// its witness exists.\n31|\n32|// grammarPattern is one compiled production grammar with the polarity of its\n33|// use, derived from whether the production condition negates the match.\n34|type grammarPattern struct {\n35|\tname   string\n36|\tsource string\n37|\t// admitting is true when production refuses on !MatchString, so the risky\n38|\t// mutation is a WIDENING. It is false when production refuses on a match, so\n39|\t// the risky mutation is a NARROWING. Either way the witness below must be\n40|\t// refused, so both polarities assert the same way.\n41|\tadmitting bool\n42|}\n43|\n44|// deriveGrammarPatterns returns every regexp compiled in the package production\n45|// sources, with the polarity derived from its use rather than assumed.\n46|func deriveGrammarPatterns(t *testing.T) map[string]grammarPattern {\n47|\tt.Helper()\n48|\n49|\t_, files := packageProductionAST(t)\n50|\tpatterns := make(map[string]grammarPattern)\n51|\tfor _, file := range files {\n52|\t\tfor _, declaration := range file.Decls {\n53|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n54|\t\t\tif !ok || general.Tok != token.VAR {\n55|\t\t\t\tcontinue\n56|\t\t\t}\n57|\t\t\tfor _, specification := range general.Specs {\n58|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n59|\t\t\t\tif !ok {\n60|\t\t\t\t\tcontinue\n61|\t\t\t\t}\n62|\t\t\t\tfor index, name := range value.Names {\n63|\t\t\t\t\tif index >= len(value.Values) {\n64|\t\t\t\t\t\tcontinue\n65|\t\t\t\t\t}\n66|\t\t\t\t\tsource, ok := compiledRegexpSource(value.Values[index])\n67|\t\t\t\t\tif !ok {\n68|\t\t\t\t\t\tcontinue\n69|\t\t\t\t\t}\n70|\t\t\t\t\tpatterns[name.Name] = grammarPattern{name: name.Name, source: source}\n71|\t\t\t\t}\n72|\t\t\t}\n73|\t\t}\n74|\t}\n75|\tif len(patterns) == 0 {\n76|\t\tt.Fatal(\"derived zero compiled grammars from the package sources; the scanner is broken, not the package\")\n77|\t}\n78|\tfor name, pattern := range patterns {\n79|\t\tpattern.admitting = grammarIsUsedAsAdmission(t, files, name)\n80|\t\tpatterns[name] = pattern\n81|\t}\n82|\treturn patterns\n83|}\n84|\n85|func compiledRegexpSource(expression ast.Expr) (string, bool) {\n86|\tcall, ok := expression.(*ast.CallExpr)\n87|\tif !ok || len(call.Args) != 1 {\n88|\t\treturn \"\", false\n89|\t}\n90|\tselector, ok := call.Fun.(*ast.SelectorExpr)\n91|\tif !ok || selector.Sel.Name != \"MustCompile\" {\n92|\t\treturn \"\", false\n93|\t}\n94|\tif package_, ok := selector.X.(*ast.Ident); !ok || package_.Name != \"regexp\" {\n95|\t\treturn \"\", false\n96|\t}\n97|\tliteral, ok := call.Args[0].(*ast.BasicLit)\n98|\tif !ok || literal.Kind != token.STRING {\n99|\t\treturn \"\", false\n100|\t}\n101|\tsource, err := strconv.Unquote(literal.Value)\n102|\tif err != nil {\n103|\t\treturn \"\", false\n104|\t}\n105|\treturn source, true\n106|}\n107|\n108|// grammarIsUsedAsAdmission reports whether every production use of a pattern\n109|// refuses on a negated match, which makes widening the risky direction.\n110|func grammarIsUsedAsAdmission(t *testing.T, files []*ast.File, name string) bool {\n111|\tt.Helper()\n112|\n113|\tnegated, total := 0, 0\n114|\tfor _, file := range files {\n115|\t\tast.Inspect(file, func(node ast.Node) bool {\n116|\t\t\tcall, ok := node.(*ast.CallExpr)\n117|\t\t\tif !ok {\n118|\t\t\t\treturn true\n119|\t\t\t}\n120|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n121|\t\t\tif !ok || selector.Sel.Name != \"MatchString\" {\n122|\t\t\t\treturn true\n123|\t\t\t}\n124|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n125|\t\t\tif !ok || receiver.Name != name {\n126|\t\t\t\treturn true\n127|\t\t\t}\n128|\t\t\ttotal++\n129|\t\t\treturn true\n130|\t\t})\n131|\t\tast.Inspect(file, func(node ast.Node) bool {\n132|\t\t\tunary, ok := node.(*ast.UnaryExpr)\n133|\t\t\tif !ok || unary.Op != token.NOT {\n134|\t\t\t\treturn true\n135|\t\t\t}\n136|\t\t\tcall, ok := unary.X.(*ast.CallExpr)\n137|\t\t\tif !ok {\n138|\t\t\t\treturn true\n139|\t\t\t}\n140|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n141|\t\t\tif !ok || selector.Sel.Name != \"MatchString\" {\n142|\t\t\t\treturn true\n143|\t\t\t}\n144|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok && receiver.Name == name {\n145|\t\t\t\tnegated++\n146|\t\t\t}\n147|\t\t\treturn true\n148|\t\t})\n149|\t}\n150|\tif total == 0 {\n151|\t\tt.Fatalf(\"grammar %s is compiled but never matched against; it declares a language nothing enforces\", name)\n152|\t}\n153|\treturn negated == total\n154|}\n155|\n156|// grammarSite is one widenable decision inside a pattern source, located by\n157|// byte range so the mutation that widens it can be applied mechanically.\n158|type grammarSite struct {\n159|\tdimension string\n160|\tkind      string\n161|\tstart     int\n162|\tend       int // exclusive\n163|\tminimum   int\n164|\tmaximum   int\n165|}\n166|\n167|const (\n168|\tgrammarAnchorStart   = \"anchor.start\"\n169|\tgrammarAnchorEnd     = \"anchor.end\"\n170|\tgrammarClass         = \"class\"\n171|\tgrammarQuantifierMax = \"quantifier.max\"\n172|\tgrammarQuantifierMin = \"quantifier.min\"\n173|\tgrammarOneOrMore     = \"one-or-more\"\n174|)\n175|\n176|// deriveGrammarSites returns the widenable decisions of a pattern source.\n177|//\n178|// Anchors, character classes, counted quantifier bounds and one-or-more\n179|// quantifiers are enumerated positionally, so inserting a class or a bound\n180|// shifts nothing that already exists and adds exactly one new obligation. The\n181|// derived label for a counted bound carries the IMPLEMENTATION number; the\n182|// witness carries the number the pinned specification declares, and the coverage\n183|// test requires them to agree, so widening a bound in production changes the\n184|// obligation key and fails before any case runs.\n185|func deriveGrammarSites(name, source string) []grammarSite {\n186|\tvar sites []grammarSite\n187|\tadd := func(label, kind string, start, end, minimum, maximum int) {\n188|\t\tsites = append(sites, grammarSite{dimension: label, kind: kind, start: start, end: end, minimum: minimum, maximum: maximum})\n189|\t}\n190|\tif strings.HasPrefix(source, \"^\") {\n191|\t\tadd(grammarAnchorStart, grammarAnchorStart, 0, 1, 0, 0)\n192|\t}\n193|\tif strings.HasSuffix(source, \"$\") {\n194|\t\tadd(grammarAnchorEnd, grammarAnchorEnd, len(source)-1, len(source), 0, 0)\n195|\t}\n196|\tclasses, quantifiers, plusses := 0, 0, 0\n197|\tfor index := 0; index < len(source); index++ {\n198|\t\tswitch source[index] {\n199|\t\tcase '\\\\':\n200|\t\t\tindex++\n201|\t\tcase '[':\n202|\t\t\tclasses++\n203|\t\t\tend := endOfCharacterClass(source, index)\n204|\t\t\tadd(fmt.Sprintf(\"class#%d\", classes), grammarClass, index, end+1, 0, 0)\n205|\t\t\tindex = end\n206|\t\tcase '{':\n207|\t\t\tclosing := strings.IndexByte(source[index:], '}')\n208|\t\t\tif closing < 0 {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\tminimum, maximum, ok := parseCountedQuantifier(source[index+1 : index+closing])\n212|\t\t\tif !ok {\n213|\t\t\t\tcontinue\n214|\t\t\t}\n215|\t\t\tquantifiers++\n216|\t\t\tif maximum >= 0 {\n217|\t\t\t\tadd(fmt.Sprintf(\"quantifier#%d.max=%d\", quantifiers, maximum), grammarQuantifierMax,\n218|\t\t\t\t\tindex, index+closing+1, minimum, maximum)\n219|\t\t\t}\n220|\t\t\tif minimum >= 1 {\n221|\t\t\t\tadd(fmt.Sprintf(\"quantifier#%d.min=%d\", quantifiers, minimum), grammarQuantifierMin,\n222|\t\t\t\t\tindex, index+closing+1, minimum, maximum)\n223|\t\t\t}\n224|\t\t\tindex += closing\n225|\t\tcase '+':\n226|\t\t\tplusses++\n227|\t\t\tadd(fmt.Sprintf(\"one-or-more#%d\", plusses), grammarOneOrMore, index, index+1, 0, 0)\n228|\t\t}\n229|\t}\n230|\tsort.SliceStable(sites, func(first, second int) bool { return sites[first].dimension < sites[second].dimension })\n231|\treturn sites\n232|}\n233|\n234|func endOfCharacterClass(source string, start int) int {\n235|\tindex := start + 1\n236|\tif index < len(source) && source[index] == '^' {\n237|\t\tindex++\n238|\t}\n239|\tif index < len(source) && source[index] == ']' {\n240|\t\tindex++\n241|\t}\n242|\tfor ; index < len(source); index++ {\n243|\t\tif source[index] == '\\\\' {\n244|\t\t\tindex++\n245|\t\t\tcontinue\n246|\t\t}\n247|\t\tif source[index] == ']' {\n248|\t\t\treturn index\n249|\t\t}\n250|\t}\n251|\treturn len(source) - 1\n252|}\n253|\n254|func parseCountedQuantifier(body string) (int, int, bool) {\n255|\tparts := strings.SplitN(body, \",\", 2)\n256|\tminimum, err := strconv.Atoi(strings.TrimSpace(parts[0]))\n257|\tif err != nil {\n258|\t\treturn 0, 0, false\n259|\t}\n260|\tif len(parts) == 1 {\n261|\t\treturn minimum, minimum, true\n262|\t}\n263|\trest := strings.TrimSpace(parts[1])\n264|\tif rest == \"\" {\n265|\t\treturn minimum, -1, true\n266|\t}\n267|\tmaximum, err := strconv.Atoi(rest)\n268|\tif err != nil {\n269|\t\treturn 0, 0, false\n270|\t}\n271|\treturn minimum, maximum, true\n272|}\n273|\n274|// widenGrammarSource applies the mechanical widening of one dimension: an anchor\n275|// is dropped, a character class becomes any character, a counted maximum gains\n276|// one, a counted minimum loses one, and a one-or-more becomes zero-or-more.\n277|func widenGrammarSource(source string, site grammarSite) string {\n278|\tswitch site.kind {\n279|\tcase grammarAnchorStart, grammarAnchorEnd:\n280|\t\treturn source[:site.start] + source[site.end:]\n281|\tcase grammarClass:\n282|\t\treturn source[:site.start] + \"(?s:.)\" + source[site.end:]\n283|\tcase grammarQuantifierMax:\n284|\t\treturn source[:site.start] + fmt.Sprintf(\"{%d,%d}\", site.minimum, site.maximum+1) + source[site.end:]\n285|\tcase grammarQuantifierMin:\n286|\t\treturn source[:site.start] + fmt.Sprintf(\"{%d,%d}\", site.minimum-1, site.maximum) + source[site.end:]\n287|\tcase grammarOneOrMore:\n288|\t\treturn source[:site.start] + \"*\" + source[site.end:]\n289|\t}\n290|\treturn source\n291|}\n292|\n293|// narrowGrammarSource applies the mechanical narrowing of one character class:\n294|// only its first declared item survives. A refusal-polarity grammar is dangerous\n295|// when it matches LESS, so this is the mutation its witnesses must defeat.\n296|func narrowGrammarSource(source string, site grammarSite) string {\n297|\tif site.kind != grammarClass {\n298|\t\treturn source\n299|\t}\n300|\tbody := source[site.start+1 : site.end-1]\n301|\tfirst := firstCharacterClassItem(body)\n302|\tif first == \"\" {\n303|\t\treturn source\n304|\t}\n305|\treturn source[:site.start] + \"[\" + first + \"]\" + source[site.end:]\n306|}\n307|\n308|func firstCharacterClassItem(body string) string {\n309|\tif body == \"\" {\n310|\t\treturn \"\"\n311|\t}\n312|\tindex := 0\n313|\tif body[index] == '\\\\' && index+1 < len(body) {\n314|\t\tindex += 2\n315|\t} else {\n316|\t\tindex++\n317|\t}\n318|\tif index+1 < len(body) && body[index] == '-' {\n319|\t\tindex += 2\n320|\t}\n321|\treturn body[:index]\n322|}\n323|\n324|// declaredGrammar records what the pinned specification says about one compiled\n325|// grammar, and the production refusal that grammar emits.\n326|//\n327|// refusal is a substring of the message the production call site produces, so\n328|// every witness below is attributed to THIS clause instead of passing on any\n329|// refusal that happens to fire first.\n330|type declaredGrammar struct {\n331|\t// reference is the grammar this package is required to implement, written\n332|\t// here independently of the production source. It is the oracle every\n333|\t// neighbour sweep below consults, so a widened production pattern cannot\n334|\t// move its own goalposts: TestEveryCompiledGrammarMatchesItsPinnedReference\n335|\t// requires the two to be identical, and every other test in this file reads\n336|\t// the reference.\n337|\treference string\n338|\t// composition explains a reference the pinned document declares in more than\n339|\t// one clause, so composing them is disclosed instead of read as a citation.\n340|\tcomposition string\n341|\t// spec is the pinned SPEC declaration, quoted. Empty is not allowed:\n342|\t// implementationDefined records the reason instead.\n343|\tspec string\n344|\t// implementationDefined explains a grammar the pinned document does not\n345|\t// spell out. It is the honest alternative to inventing a citation.\n346|\timplementationDefined string\n347|\trefusal               string\n348|\t// probe is a value that reaches the refusal, used to locate the fixture\n349|\t// positions this grammar governs. Empty selects the universal probe, which\n350|\t// violates every admitting grammar in the package.\n351|\tprobe string\n352|}\n353|\n354|// universalGrammarProbe violates every admitting grammar in this package: it is\n355|// not lowercase, contains a space and a control byte, and starts with neither a\n356|// letter nor a digit. It is used only to LOCATE the fixture positions a grammar\n357|// governs; the witnesses that follow are what prove the grammar's dimensions.\n358|const universalGrammarProbe = \"\\x01 INVALID PROBE \\x02\"\n359|\n360|// declaredGrammars is asserted to cover exactly the derived pattern set by\n361|// TestEveryCompiledGrammarIsDeclaredAndReachable, so a new regexp in production\n362|// fails here until its specification provenance and refusal are recorded.\n363|var declaredGrammars = map[string]declaredGrammar{\n364|\t\"sessionNamePattern\": {\n365|\t\treference: `^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`,\n366|\t\tspec:      \"Session name | A mesh-unique human alias of 1-64 characters matching [A-Za-z0-9][A-Za-z0-9._-]{0,63}.\",\n367|\t\trefusal:   \"Session Record name must match\",\n368|\t},\n369|\t\"boardLogicalIDPattern\": {\n370|\t\treference: `^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`,\n371|\t\tspec:      \"logical_id (1-128 characters matching [A-Za-z0-9][A-Za-z0-9._:-]{0,127})\",\n372|\t\trefusal:   \"Board Identity logical_id has invalid grammar\",\n373|\t},\n374|\t\"environmentNamePattern\": {\n375|\t\treference: `^[A-Za-z_][A-Za-z0-9_]{0,127}$`,\n376|\t\tspec:      \"env_names | array<string>[0..64] | Sorted, unique names matching [A-Za-z_][A-Za-z0-9_]{0,127}\",\n377|\t\trefusal:   \"environment-name grammar\",\n378|\t},\n379|\t\"environmentIDPattern\": {\n380|\t\treference: `^[a-z][a-z0-9.-]{0,63}$`,\n381|\t\tspec:      \"environment_id | [a-z][a-z0-9.-]{0,63}; one semantic native environment\",\n382|\t\trefusal:   \"environment_id must match\",\n383|\t},\n384|\t\"providerIdentityKeyPattern\": {\n385|\t\treference: `^[a-z][a-z0-9_.-]{0,63}$`,\n386|\t\tspec:      \"A provider-identity key matches [a-z][a-z0-9_.-]{0,63}.\",\n387|\t\trefusal:   \"opaque_identity key\",\n388|\t},\n389|\t\"reverseDNSPattern\": {\n390|\t\treference: `^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`,\n391|\t\tcomposition: \"the pinned clause declares the label grammar and the at-least-one-dot rule in one sentence but \" +\n392|\t\t\t\"spells only the label as a regular expression; the reference composes the two\",\n393|\t\tspec:    \"A reverse-DNS key is 3-253 lowercase ASCII characters, contains at least one dot, and has dot-separated labels matching [a-z][a-z0-9-]{0,62}.\",\n394|\t\trefusal: \"is not a 3..253 character lowercase reverse-DNS name\",\n395|\t},\n396|\t\"mediaTypePattern\": {\n397|\t\treference: \"^[a-z0-9!#$&^_.+%'*`|~-]+/[a-z0-9!#$&^_.+%'*`|~-]+$\",\n398|\t\timplementationDefined: \"the pinned clause says only that \\\"media_type is a lowercase ASCII type/subtype \" +\n399|\t\t\t\"without parameters\\\" and types it string[1..255]; it spells out no character class, so the restricted-name \" +\n400|\t\t\t\"set below is the implementation's reading rather than a citation\",\n401|\t\trefusal: \"media_type must be lowercase ASCII type/subtype without parameters\",\n402|\t},\n403|\t\"observationNamePattern\": {\n404|\t\treference: `^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$`,\n405|\t\tspec:      \"event | observation-name | [a-z][a-z0-9_]*(\\\\.[a-z][a-z0-9_]*){1,7}, 3-128 characters\",\n406|\t\trefusal:   \"Observation Event event must match\",\n407|\t},\n408|\t\"terminalBackendIDPattern\": {\n409|\t\treference: `^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`,\n410|\t\tspec:      \"terminal_backend_id is 1-128 ASCII bytes matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*.\",\n411|\t\trefusal:   \"must match the terminal-backend-id grammar\",\n412|\t},\n413|\t\"lowerSnakePattern\": {\n414|\t\treference: `^[a-z][a-z0-9_]*$`,\n415|\t\t// The pinned table types phase as string[1..128] and describes the case\n416|\t\t// in prose. It declares no character class and no anchoring, so the\n417|\t\t// implementation chooses the grammar; the prose is quoted rather than a\n418|\t\t// regex the document does not contain.\n419|\t\timplementationDefined: \"the pinned table types the member `phase | string[1..128] or null` and describes the \" +\n420|\t\t\t\"case only in prose - \\\"Stable lower-snake-case phase or null\\\" - declaring no character class and no \" +\n421|\t\t\t\"anchoring, so this reference is the implementation's reading of that prose rather than a citation\",\n422|\t\trefusal: \"phase must use lower_snake_case\",\n423|\t},\n424|\t\"semverPattern\": {\n425|\t\treference: `^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`,\n426|\t\t// The pinned document types these members `semver` and states that\n427|\t\t// \"Every independently consumed contract has an independent Semantic\n428|\t\t// Version\". It spells out no regular expression for one, so the\n429|\t\t// production below is the implementation's reading of Semantic\n430|\t\t// Versioning 2.0.0 and is recorded as such rather than cited. The\n431|\t\t// reading is deliberately the WHOLE standard: prerelease and build\n432|\t\t// metadata are part of a valid Semantic Version, so a core-triple-only\n433|\t\t// grammar would refuse `1.2.3-rc.1` on a constraint neither the\n434|\t\t// standard nor the pinned document states.\n435|\t\timplementationDefined: \"the pinned document types the member `semver` and names Semantic Version, but declares no grammar literal for it; the production implements Semantic Versioning 2.0.0 in full, including optional prerelease and build metadata\",\n436|\t\trefusal:               \"must be canonical semver\",\n437|\t},\n438|\t\"windowsAbsolutePathPattern\": {\n439|\t\treference: `^[A-Za-z]:[\\\\/]`,\n440|\t\t// A refusal matcher, not an admission matcher: it exists to catch a\n441|\t\t// Windows drive-absolute path in a member the document requires to be a\n442|\t\t// logical identity. Its risky mutation is NARROWING.\n443|\t\timplementationDefined: \"the pinned clause states only that \\\"An absolute path is machine-local routing data \" +\n444|\t\t\t\"and never a logical identity\\\"; it declares no grammar for a drive-absolute prefix, so this reference \" +\n445|\t\t\t\"is the implementation's Windows drive/UNC detection rather than a citation\",\n446|\t\trefusal: \"must be a logical identity, not an absolute path\",\n447|\t\tprobe:   \"C:/logical\",\n448|\t},\n449|}\n450|\n451|// grammarWitness proves one dimension of one grammar at the production entry.\n452|//\n453|// Every value must be refused there, and the self-check below proves each value\n454|// is admitted by the mechanical mutation of exactly its own dimension, so the\n455|// witness cannot drift into a case that would pass against a widened pattern.\n456|//\n457|// specBound is the bound the PINNED SPECIFICATION declares for a counted\n458|// quantifier, never the implementation constant the derived key carries. The\n459|// coverage test compares the two.\n460|type grammarWitness struct {\n461|\tpattern   string\n462|\tdimension string\n463|\tspecBound int\n464|\tvalues    []string\n465|}\n466|\n467|// subsumedGrammarDimensions records a dimension whose widening cannot change the\n468|// admitted set because an earlier production refusal always fires first. The\n469|// subsuming refusal is named and pinned by the named test, so \"subsumed\" cannot\n470|// be used to wave a dimension through.\n471|var subsumedGrammarDimensions = map[string]struct {\n472|\tsubsumingRefusal string\n473|\tprovingTest      string\n474|}{\n475|\t\"boardLogicalIDPattern|quantifier#1.max=127\": {\n476|\t\tsubsumingRefusal: \"member logical_id must contain 1..128 Unicode characters\",\n477|\t\tprovingTest:      \"TestBoardLogicalIDLengthIsSubsumedByItsDeclaredStringBound\",\n478|\t},\n479|}\n480|\n481|func declaredGrammarWitnesses() []grammarWitness {\n482|\treturn []grammarWitness{\n483|\t\t// Session name: [A-Za-z0-9][A-Za-z0-9._-]{0,63}, 1-64 characters.\n484|\t\t{pattern: \"sessionNamePattern\", dimension: \"anchor.start\", values: []string{\"!Aa\"}},\n485|\t\t{pattern: \"sessionNamePattern\", dimension: \"anchor.end\", values: []string{\"Aa!\"}},\n486|\t\t{pattern: \"sessionNamePattern\", dimension: \"class#1\", values: []string{\"_ab\"}},\n487|\t\t{pattern: \"sessionNamePattern\", dimension: \"class#2\", values: []string{\"Aa b\"}},\n488|\t\t{pattern: \"sessionNamePattern\", dimension: \"quantifier#1.max=63\", specBound: 63,\n489|\t\t\tvalues: []string{\"A\" + strings.Repeat(\"a\", 64)}},\n490|\n491|\t\t// Board logical_id: [A-Za-z0-9][A-Za-z0-9._:-]{0,127}, 1-128 characters.\n492|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"anchor.start\", values: []string{\"!ab\"}},\n493|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"anchor.end\", values: []string{\"ab!\"}},\n494|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"class#1\", values: []string{\"_ab\"}},\n495|\t\t{pattern: \"boardLogicalIDPattern\", dimension: \"class#2\", values: []string{\"ab c\"}},\n496|\n497|\t\t// env_names: [A-Za-z_][A-Za-z0-9_]{0,127}.\n498|\t\t{pattern: \"environmentNamePattern\", dimension: \"anchor.start\", values: []string{\"!AB\"}},\n499|\t\t{pattern: \"environmentNamePattern\", dimension: \"anchor.end\", values: []string{\"AB!\"}},\n500|\t\t{pattern: \"environmentNamePattern\", dimension: \"class#1\", values: []string{\"0AB\"}},\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
