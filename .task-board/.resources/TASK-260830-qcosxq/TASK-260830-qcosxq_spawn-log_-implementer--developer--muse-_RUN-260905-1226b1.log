{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5b7","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":310,"recorded_at":1780531400000615,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"task_stream":{"kind":"task","id":"e9c4a6a0-eaf5-4dea-9e7a-ba750c56efac"},"task_id":"e9c4a6a0-eaf5-4dea-9e7a-ba750c56efac","event":{"kind":"output","task_id":"e9c4a6a0-eaf5-4dea-9e7a-ba750c56efac","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/canonicaljson/grammar_inventory_test.go`.\n(499 line(s) above)\n500|\t\t{pattern: \"environmentNamePattern\", dimension: \"class#1\", values: []string{\"0AB\"}},\n501|\t\t{pattern: \"environmentNamePattern\", dimension: \"class#2\", values: []string{\"A-B\"}},\n502|\t\t{pattern: \"environmentNamePattern\", dimension: \"quantifier#1.max=127\", specBound: 127,\n503|\t\t\tvalues: []string{\"A\" + strings.Repeat(\"B\", 128)}},\n504|\n505|\t\t// environment_id: [a-z][a-z0-9.-]{0,63}.\n506|\t\t{pattern: \"environmentIDPattern\", dimension: \"anchor.start\", values: []string{\"!ab\"}},\n507|\t\t{pattern: \"environmentIDPattern\", dimension: \"anchor.end\", values: []string{\"ab!\"}},\n508|\t\t{pattern: \"environmentIDPattern\", dimension: \"class#1\", values: []string{\"0ab\"}},\n509|\t\t{pattern: \"environmentIDPattern\", dimension: \"class#2\", values: []string{\"a_b\"}},\n510|\t\t{pattern: \"environmentIDPattern\", dimension: \"quantifier#1.max=63\", specBound: 63,\n511|\t\t\tvalues: []string{\"a\" + strings.Repeat(\"b\", 64)}},\n512|\n513|\t\t// provider-identity key: [a-z][a-z0-9_.-]{0,63}.\n514|\t\t{pattern: \"providerIdentityKeyPattern\", dimension: \"anchor.start\", values: []string{\"!ab\"}},\n515|\t\t{pattern: \"providerIdentityKeyPattern\", dimension: \"anchor.end\", values: []string{\"ab!\"}},\n516|\t\t{pattern: \"providerIdentityKeyPattern\", dimension: \"class#1\", values: []string{\"0ab\"}},\n517|\t\t{pattern: \"providerIdentityKeyPattern\", dimension: \"class#2\", values: []string{\"a b\"}},\n518|\t\t{pattern: \"providerIdentityKeyPattern\", dimension: \"quantifier#1.max=63\", specBound: 63,\n519|\t\t\tvalues: []string{\"a\" + strings.Repeat(\"b\", 64)}},\n520|\n521|\t\t// reverse-DNS key: labels [a-z][a-z0-9-]{0,62}, at least one dot.\n522|\t\t{pattern: \"reverseDNSPattern\", dimension: \"anchor.start\", values: []string{\"!ab.cd\"}},\n523|\t\t{pattern: \"reverseDNSPattern\", dimension: \"anchor.end\", values: []string{\"ab.cd!\"}},\n524|\t\t{pattern: \"reverseDNSPattern\", dimension: \"class#1\", values: []string{\"0ab.cd\"}},\n525|\t\t{pattern: \"reverseDNSPattern\", dimension: \"class#2\", values: []string{\"a_b.cd\"}},\n526|\t\t{pattern: \"reverseDNSPattern\", dimension: \"quantifier#1.max=62\", specBound: 62,\n527|\t\t\tvalues: []string{\"a\" + strings.Repeat(\"b\", 63) + \".cd\"}},\n528|\t\t{pattern: \"reverseDNSPattern\", dimension: \"class#3\", values: []string{\"ab.0cd\"}},\n529|\t\t{pattern: \"reverseDNSPattern\", dimension: \"class#4\", values: []string{\"ab.c_d\"}},\n530|\t\t{pattern: \"reverseDNSPattern\", dimension: \"quantifier#2.max=62\", specBound: 62,\n531|\t\t\tvalues: []string{\"ab.c\" + strings.Repeat(\"d\", 63)}},\n532|\t\t{pattern: \"reverseDNSPattern\", dimension: \"one-or-more#1\", values: []string{\"abc\"}},\n533|\n534|\t\t// media_type: lowercase ASCII type/subtype without parameters.\n535|\t\t{pattern: \"mediaTypePattern\", dimension: \"anchor.start\", values: []string{\" text/plain\"}},\n536|\t\t{pattern: \"mediaTypePattern\", dimension: \"anchor.end\", values: []string{\"text/plain \"}},\n537|\t\t{pattern: \"mediaTypePattern\", dimension: \"class#1\", values: []string{\"te xt/plain\"}},\n538|\t\t{pattern: \"mediaTypePattern\", dimension: \"one-or-more#1\", values: []string{\"/plain\"}},\n539|\t\t{pattern: \"mediaTypePattern\", dimension: \"class#2\", values: []string{\"text/pla in\"}},\n540|\t\t{pattern: \"mediaTypePattern\", dimension: \"one-or-more#2\", values: []string{\"text/\"}},\n541|\n542|\t\t// observation-name: [a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}, 3-128 characters.\n543|\t\t{pattern: \"observationNamePattern\", dimension: \"anchor.start\", values: []string{\"!ab.cd\"}},\n544|\t\t{pattern: \"observationNamePattern\", dimension: \"anchor.end\", values: []string{\"ab.cd!\"}},\n545|\t\t{pattern: \"observationNamePattern\", dimension: \"class#1\", values: []string{\"0ab.cd\"}},\n546|\t\t{pattern: \"observationNamePattern\", dimension: \"class#2\", values: []string{\"a-b.cd\"}},\n547|\t\t{pattern: \"observationNamePattern\", dimension: \"class#3\", values: []string{\"ab.0cd\"}},\n548|\t\t{pattern: \"observationNamePattern\", dimension: \"class#4\", values: []string{\"ab.c-d\"}},\n549|\t\t{pattern: \"observationNamePattern\", dimension: \"quantifier#1.max=7\", specBound: 7,\n550|\t\t\tvalues: []string{\"a.b.c.d.e.f.g.h.i\"}},\n551|\t\t{pattern: \"observationNamePattern\", dimension: \"quantifier#1.min=1\", specBound: 1,\n552|\t\t\tvalues: []string{\"abc\"}},\n553|\n554|\t\t// terminal-backend-id: [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*.\n555|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"anchor.start\", values: []string{\"!ax\"}},\n556|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"anchor.end\", values: []string{\"ax!\"}},\n557|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"class#1\", values: []string{\"0ax\"}},\n558|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"class#2\", values: []string{\"a_x\"}},\n559|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"class#3\", values: []string{\"ax_tmux\"}},\n560|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"class#4\", values: []string{\"ax.tm_ux\"}},\n561|\t\t{pattern: \"terminalBackendIDPattern\", dimension: \"one-or-more#1\", values: []string{\"ax.\"}},\n562|\n563|\t\t// lower-snake-case phase: [a-z][a-z0-9_]*.\n564|\t\t{pattern: \"lowerSnakePattern\", dimension: \"anchor.start\", values: []string{\"!ab\"}},\n565|\t\t{pattern: \"lowerSnakePattern\", dimension: \"anchor.end\", values: []string{\"ab!\"}},\n566|\t\t{pattern: \"lowerSnakePattern\", dimension: \"class#1\", values: []string{\"0ab\"}},\n567|\t\t{pattern: \"lowerSnakePattern\", dimension: \"class#2\", values: []string{\"a-b\"}},\n568|\n569|\t\t// Semantic Versioning 2.0.0 in full: three core numbers, an optional\n570|\t\t// dot-separated prerelease, and optional dot-separated build metadata.\n571|\t\t// Classes 1-6 are the core numbers, 7-11 the first prerelease\n572|\t\t// identifier, 12-16 each later prerelease identifier, and 17-18 the\n573|\t\t// build-metadata identifiers.\n574|\t\t{pattern: \"semverPattern\", dimension: \"anchor.start\", values: []string{\"!1.0.0\"}},\n575|\t\t{pattern: \"semverPattern\", dimension: \"anchor.end\", values: []string{\"1.0.0!\"}},\n576|\t\t{pattern: \"semverPattern\", dimension: \"class#1\", values: []string{\"01.0.0\"}},\n577|\t\t{pattern: \"semverPattern\", dimension: \"class#2\", values: []string{\"1a.0.0\"}},\n578|\t\t{pattern: \"semverPattern\", dimension: \"class#3\", values: []string{\"1.01.0\"}},\n579|\t\t{pattern: \"semverPattern\", dimension: \"class#4\", values: []string{\"1.1a.0\"}},\n580|\t\t{pattern: \"semverPattern\", dimension: \"class#5\", values: []string{\"1.0.01\"}},\n581|\t\t{pattern: \"semverPattern\", dimension: \"class#6\", values: []string{\"1.0.1a\"}},\n582|\t\t{pattern: \"semverPattern\", dimension: \"class#7\", values: []string{\"1.0.0-01\"}},\n583|\t\t{pattern: \"semverPattern\", dimension: \"class#8\", values: []string{\"1.0.0-1!\"}},\n584|\t\t{pattern: \"semverPattern\", dimension: \"class#9\", values: []string{\"1.0.0-!a\"}},\n585|\t\t{pattern: \"semverPattern\", dimension: \"class#10\", values: []string{\"1.0.0-1_\"}},\n586|\t\t{pattern: \"semverPattern\", dimension: \"class#11\", values: []string{\"1.0.0-a_b\"}},\n587|\t\t{pattern: \"semverPattern\", dimension: \"class#12\", values: []string{\"1.0.0-a.01\"}},\n588|\t\t{pattern: \"semverPattern\", dimension: \"class#13\", values: []string{\"1.0.0-a.1!\"}},\n589|\t\t{pattern: \"semverPattern\", dimension: \"class#14\", values: []string{\"1.0.0-a.!b\"}},\n590|\t\t{pattern: \"semverPattern\", dimension: \"class#15\", values: []string{\"1.0.0-a.1_\"}},\n591|\t\t{pattern: \"semverPattern\", dimension: \"class#16\", values: []string{\"1.0.0-a.b_c\"}},\n592|\t\t{pattern: \"semverPattern\", dimension: \"class#17\", values: []string{\"1.0.0+a_b\"}},\n593|\t\t{pattern: \"semverPattern\", dimension: \"class#18\", values: []string{\"1.0.0+a.b_c\"}},\n594|\t\t{pattern: \"semverPattern\", dimension: \"one-or-more#1\", values: []string{\"1.0.0+\"}},\n595|\t\t{pattern: \"semverPattern\", dimension: \"one-or-more#2\", values: []string{\"1.0.0+a.\"}},\n596|\n597|\t\t// Windows drive-absolute prefix: a REFUSAL matcher, so its witnesses\n598|\t\t// defeat a narrowing of each character class.\n599|\t\t{pattern: \"windowsAbsolutePathPattern\", dimension: \"class#1\", values: []string{\"c:/logical\", \"C:/logical\"}},\n600|\t\t{pattern: \"windowsAbsolutePathPattern\", dimension: \"class#2\", values: []string{\"C:/logical\", `C:\\logical`}},\n601|\t}\n602|}\n603|\n604|// grammarPosition is a place in a valid fixture where a declared grammar is\n605|// reached at the production entry. Positions are LOCATED by probing rather than\n606|// hand-wired: a probe value that violates every admitting grammar is written at\n607|// every candidate value and every open-map key of every fixture, and the\n608|// position is attributed to whichever grammar's own refusal message comes back.\n609|type grammarPosition struct {\n610|\tfixture identityFixture\n611|\tpath    []string\n612|\t// key names the open-map member renamed at this position; empty means the\n613|\t// value at path is replaced instead.\n614|\tkey string\n615|}\n616|\n617|func (position grammarPosition) describe() string {\n618|\tif position.key != \"\" {\n619|\t\treturn fmt.Sprintf(\"%s at %s key %q\", position.fixture.name, formatJSONPath(position.path), position.key)\n620|\t}\n621|\treturn fmt.Sprintf(\"%s at %s\", position.fixture.name, formatJSONPath(position.path))\n622|}\n623|\n624|// everyCandidateObjectPath returns the path of every JSON object inside a\n625|// candidate, including the open maps everyCandidateValuePath deliberately does\n626|// not descend into, because those are exactly the maps whose KEYS carry a\n627|// declared grammar.\n628|func everyCandidateObjectPath(object map[string]any) [][]string {\n629|\tvar paths [][]string\n630|\tvar visit func(any, []string)\n631|\tvisit = func(value any, prefix []string) {\n632|\t\tswitch typed := value.(type) {\n633|\t\tcase map[string]any:\n634|\t\t\tpaths = append(paths, append([]string{}, prefix...))\n635|\t\t\tkeys := make([]string, 0, len(typed))\n636|\t\t\tfor key := range typed {\n637|\t\t\t\tkeys = append(keys, key)\n638|\t\t\t}\n639|\t\t\tsort.Strings(keys)\n640|\t\t\tfor _, key := range keys {\n641|\t\t\t\tvisit(typed[key], append(append([]string{}, prefix...), key))\n642|\t\t\t}\n643|\t\tcase []any:\n644|\t\t\tfor index, member := range typed {\n645|\t\t\t\tvisit(member, append(append([]string{}, prefix...), fmt.Sprintf(\"[%d]\", index)))\n646|\t\t\t}\n647|\t\t}\n648|\t}\n649|\tvisit(object, nil)\n650|\treturn paths\n651|}\n652|\n653|func jsonObjectAtPath(t *testing.T, root map[string]any, path []string) map[string]any {\n654|\tt.Helper()\n655|\tif len(path) == 0 {\n656|\t\treturn root\n657|\t}\n658|\tvalue := jsonValueAtPath(t, root, path)\n659|\tobject, _ := value.(map[string]any)\n660|\treturn object\n661|}\n662|\n663|// renameObjectKey rewrites one member name of the object at path, which is how a\n664|// grammar declared over MAP KEYS is attacked at the production entry.\n665|func renameObjectKey(t *testing.T, root map[string]any, path []string, from, to string) {\n666|\tt.Helper()\n667|\tobject := jsonObjectAtPath(t, root, path)\n668|\tif object == nil {\n669|\t\tt.Fatalf(\"no object at %s\", formatJSONPath(path))\n670|\t}\n671|\tvalue := object[from]\n672|\tdelete(object, from)\n673|\tobject[to] = value\n674|}\n675|\n676|// locateGrammarPositions maps each declared grammar to the fixture positions\n677|// that reach it, by attribution of the production refusal message.\n678|func locateGrammarPositions(t *testing.T, patterns map[string]grammarPattern) map[string][]grammarPosition {\n679|\tt.Helper()\n680|\n681|\tbyProbe := make(map[string][]string)\n682|\tfor name := range patterns {\n683|\t\tprobe := declaredGrammars[name].probe\n684|\t\tif probe == \"\" {\n685|\t\t\tprobe = universalGrammarProbe\n686|\t\t}\n687|\t\tbyProbe[probe] = append(byProbe[probe], name)\n688|\t}\n689|\n690|\tlocated := make(map[string][]grammarPosition)\n691|\tattribute := func(fixture identityFixture, path []string, key string, candidate map[string]any, names []string) {\n692|\t\treason := fixtureRefusalReason(t, fixture, candidate)\n693|\t\tif reason == \"\" {\n694|\t\t\treturn\n695|\t\t}\n696|\t\tfor _, name := range names {\n697|\t\t\tif strings.Contains(reason, declaredGrammars[name].refusal) {\n698|\t\t\t\tlocated[name] = append(located[name], grammarPosition{fixture: fixture, path: path, key: key})\n699|\t\t\t}\n700|\t\t}\n701|\t}\n702|\n703|\tfor _, fixture := range everyValidIdentityFixture() {\n704|\t\tfor probe, names := range byProbe {\n705|\t\t\tfor _, path := range everyCandidateValuePath(fixture.object) {\n706|\t\t\t\tif _, ok := jsonValueAtPath(t, fixture.object, path).(string); !ok {\n707|\t\t\t\t\tcontinue\n708|\t\t\t\t}\n709|\t\t\t\tcandidate := cloneJSONObject(t, fixture.object)\n710|\t\t\t\tsetJSONValueAtPath(t, candidate, path, probe)\n711|\t\t\t\tattribute(fixture, path, \"\", candidate, names)\n712|\t\t\t}\n713|\t\t\tfor _, path := range everyCandidateObjectPath(fixture.object) {\n714|\t\t\t\tobject := jsonObjectAtPath(t, fixture.object, path)\n715|\t\t\t\tif len(object) == 0 {\n716|\t\t\t\t\tcontinue\n717|\t\t\t\t}\n718|\t\t\t\tkeys := make([]string, 0, len(object))\n719|\t\t\t\tfor key := range object {\n720|\t\t\t\t\tkeys = append(keys, key)\n721|\t\t\t\t}\n722|\t\t\t\tsort.Strings(keys)\n723|\t\t\t\tcandidate := cloneJSONObject(t, fixture.object)\n724|\t\t\t\trenameObjectKey(t, candidate, path, keys[0], probe)\n725|\t\t\t\tattribute(fixture, path, keys[0], candidate, names)\n726|\t\t\t}\n727|\t\t}\n728|\t}\n729|\treturn located\n730|}\n731|\n732|// TestEveryCompiledGrammarIsDeclaredAndReachable is the inventory's floor. Every\n733|// regexp compiled in the package production sources must record where the pinned\n734|// specification declares it (or say plainly that the document does not), must\n735|// name the refusal it emits, and must be reachable from a valid fixture at the\n736|// production entry. A grammar nothing reaches declares a language nothing\n737|// enforces.\n738|func TestEveryCompiledGrammarIsDeclaredAndReachable(t *testing.T) {\n739|\tpatterns := deriveGrammarPatterns(t)\n740|\tfor name := range patterns {\n741|\t\tdeclared, ok := declaredGrammars[name]\n742|\t\tif !ok {\n743|\t\t\tt.Errorf(\n744|\t\t\t\t\"%s is compiled in production but has no entry in declaredGrammars, so no dimension of it is proven. \"+\n745|\t\t\t\t\t\"Record its pinned SPEC declaration, or say explicitly that the document declares none.\", name)\n746|\t\t\tcontinue\n747|\t\t}\n748|\t\tif (declared.spec == \"\") == (declared.implementationDefined == \"\") {\n749|\t\t\tt.Errorf(\"%s must record exactly one of a pinned SPEC declaration or an implementation-defined reason\", name)\n750|\t\t}\n751|\t\tif strings.TrimSpace(declared.refusal) == \"\" {\n752|\t\t\tt.Errorf(\"%s does not name the production refusal it emits, so its witnesses cannot be attributed to it\", name)\n753|\t\t}\n754|\t}\n755|\tfor name := range declaredGrammars {\n756|\t\tif _, ok := patterns[name]; !ok {\n757|\t\t\tt.Errorf(\"declaredGrammars names %s, which the package no longer compiles\", name)\n758|\t\t}\n759|\t}\n760|\n761|\tlocated := locateGrammarPositions(t, patterns)\n762|\tvar unreachable []string\n763|\tfor name := range patterns {\n764|\t\tif len(located[name]) == 0 {\n765|\t\t\tunreachable = append(unreachable, name)\n766|\t\t}\n767|\t}\n768|\tsort.Strings(unreachable)\n769|\tif len(unreachable) > 0 {\n770|\t\tt.Errorf(\n771|\t\t\t\"declared grammar(s) that no valid fixture reaches at the production entry, so every witness below them \"+\n772|\t\t\t\t\"would be vacuous:\\n  %s\", strings.Join(unreachable, \"\\n  \"))\n773|\t}\n774|}\n775|\n776|// TestEveryDeclaredGrammarDimensionHasAProvenWitness is the coverage assertion.\n777|//\n778|// The obligation is derived from the pattern source, so adding a character class\n779|// or a counted bound to any production grammar fails here until its witness\n780|// exists, and CHANGING a counted bound changes the derived key so the old\n781|// witness no longer discharges it. specBound is compared against the derived\n782|// implementation number, which is how a bound widened in production is caught by\n783|// the pinned specification literal rather than by itself.\n784|func TestEveryDeclaredGrammarDimensionHasAProvenWitness(t *testing.T) {\n785|\tt.Parallel()\n786|\n787|\tobligations := deriveGrammarObligations(t)\n788|\twitnessed := make(map[string]int)\n789|\tnames := packageTestFunctionNames(t)\n790|\n791|\tfor _, witness := range declaredGrammarWitnesses() {\n792|\t\tkey := witness.pattern + \"|\" + witness.dimension\n793|\t\twitnessed[key]++\n794|\t\tsite, ok := obligations[key]\n795|\t\tif !ok {\n796|\t\t\tt.Errorf(\"witness %s claims a dimension no production grammar declares\", key)\n797|\t\t\tcontinue\n798|\t\t}\n799|\t\tif len(witness.values) == 0 {\n800|\t\t\tt.Errorf(\"witness %s carries no value\", key)\n801|\t\t}\n802|\t\tswitch site.kind {\n803|\t\tcase grammarQuantifierMax:\n804|\t\t\tif witness.specBound != site.maximum {\n805|\t\t\t\tt.Errorf(\n806|\t\t\t\t\t\"witness %s asserts the pinned maximum %d but production declares %d; a bound must be asserted \"+\n807|\t\t\t\t\t\t\"against the specification literal, never against the constant it derives from\",\n808|\t\t\t\t\tkey, witness.specBound, site.maximum)\n809|\t\t\t}\n810|\t\tcase grammarQuantifierMin:\n811|\t\t\tif witness.specBound != site.minimum {\n812|\t\t\t\tt.Errorf(\"witness %s asserts the pinned minimum %d but production declares %d\", key, witness.specBound, site.minimum)\n813|\t\t\t}\n814|\t\t}\n815|\t}\n816|\n817|\tvar missing []string\n818|\tfor key := range obligations {\n819|\t\tif witnessed[key] > 0 {\n820|\t\t\tif _, subsumed := subsumedGrammarDimensions[key]; subsumed {\n821|\t\t\t\tt.Errorf(\"dimension %s is disclosed as subsumed but also carries a witness; remove one\", key)\n822|\t\t\t}\n823|\t\t\tcontinue\n824|\t\t}\n825|\t\tif subsumption, subsumed := subsumedGrammarDimensions[key]; subsumed {\n826|\t\t\tif _, exists := names[subsumption.provingTest]; !exists {\n827|\t\t\t\tt.Errorf(\"subsumed dimension %s names %s, which does not exist in this package\", key, subsumption.provingTest)\n828|\t\t\t}\n829|\t\t\tcontinue\n830|\t\t}\n831|\t\tmissing = append(missing, key)\n832|\t}\n833|\tsort.Strings(missing)\n834|\tif len(missing) > 0 {\n835|\t\tt.Errorf(\n836|\t\t\t\"declared grammar dimension(s) with no widening witness. A grammar with an unproven dimension is \"+\n837|\t\t\t\t\"pinned only against deletion; widening it leaves the whole suite green:\\n  %s\",\n838|\t\t\tstrings.Join(missing, \"\\n  \"))\n839|\t}\n840|}\n841|\n842|// deriveGrammarObligations returns every dimension that carries a risky\n843|// mutation, keyed as pattern|dimension.\n844|//\n845|// For an admission matcher every dimension is risky, because each one can be\n846|// widened to admit more. For a refusal matcher only the character classes are:\n847|// dropping its anchor or relaxing a quantifier makes it match MORE inputs, which\n848|// refuses more and cannot admit anything new.\n849|func deriveGrammarObligations(t *testing.T) map[string]grammarSite {\n850|\tt.Helper()\n851|\n852|\tobligations := make(map[string]grammarSite)\n853|\tfor name, pattern := range deriveGrammarPatterns(t) {\n854|\t\t// Dimensions are derived from the PINNED REFERENCE, not from the\n855|\t\t// production source, so a widened production pattern cannot delete its\n856|\t\t// own obligation. TestEveryCompiledGrammarMatchesItsPinnedReference is\n857|\t\t// what keeps the two identical.\n858|\t\tfor _, site := range deriveGrammarSites(name, declaredGrammars[name].reference) {\n859|\t\t\tif !pattern.admitting && site.kind != grammarClass {\n860|\t\t\t\tcontinue\n861|\t\t\t}\n862|\t\t\tobligations[name+\"|\"+site.dimension] = site\n863|\t\t}\n864|\t}\n865|\tif len(obligations) == 0 {\n866|\t\tt.Fatal(\"derived zero grammar dimensions; the scanner is broken, not the package\")\n867|\t}\n868|\treturn obligations\n869|}\n870|\n871|// TestEveryGrammarWitnessIsAdmittedByItsOwnWideningOnly is the derivation's\n872|// self-check, and it is what makes the witness table more than decoration.\n873|//\n874|// For an admission matcher it proves, mechanically, that the production pattern\n875|// REFUSES the witness while the pattern with exactly that one dimension widened\n876|// ADMITS it. A witness that would also pass against the widened grammar - the\n877|// \"grammar inventory that cannot fail when a pattern is widened\" this Story was\n878|// rejected for - fails here.\n879|//\n880|// For a refusal matcher it proves the mirror image: production MATCHES the\n881|// witness, and narrowing that character class to its first or last declared item\n882|// stops matching it, so the value would be admitted.\n883|func TestEveryGrammarWitnessIsAdmittedByItsOwnWideningOnly(t *testing.T) {\n884|\tt.Parallel()\n885|\n886|\tpatterns := deriveGrammarPatterns(t)\n887|\tobligations := deriveGrammarObligations(t)\n888|\tfor _, witness := range declaredGrammarWitnesses() {\n889|\t\tkey := witness.pattern + \"|\" + witness.dimension\n890|\t\tsite, ok := obligations[key]\n891|\t\tif !ok {\n892|\t\t\tcontinue\n893|\t\t}\n894|\t\tpattern := patterns[witness.pattern]\n895|\t\tproduction := referenceGrammar(t, witness.pattern)\n896|\t\tif pattern.admitting {\n897|\t\t\twidened := regexp.MustCompile(widenGrammarSource(declaredGrammars[witness.pattern].reference, site))\n898|\t\t\tfor _, value := range witness.values {\n899|\t\t\t\tif production.MatchString(value) {\n(more lines below)"}}}
