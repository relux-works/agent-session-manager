{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c647","stream":{"kind":"session","id":"01a06f47-b5dc-78b1-af70-be0816a3d708"},"sequence":382,"recorded_at":1780531400000759,"record_type":"event","durability":"durable","causation_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57","run_stream":{"kind":"run","id":"ea5d7938-e462-4f09-a6ee-0a79f072fa57"},"task_stream":{"kind":"task","id":"b0c4069b-b5c9-4e11-9ddf-f5d9af2aa022"},"task_id":"b0c4069b-b5c9-4e11-9ddf-f5d9af2aa022","event":{"kind":"output","task_id":"b0c4069b-b5c9-4e11-9ddf-f5d9af2aa022","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/status_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"encoding/base64\"\n7|\t\"encoding/json\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|)\n12|\n13|const (\n14|\ttestMaterializationID = \"0198f4c8-c290-73aa-9374-1234567890ab\"\n15|\ttestTransactionID     = \"0198f4c8-f5c0-76dd-9677-1234567890ab\"\n16|\ttestAuthorityID       = \"provider_transaction\"\n17|\ttestPlanID            = \"sha256:64644a5ad573d36c0c13f44f56ef25ab93cff33001ff2a3371b082603910f2dd\"\n18|\ttestRollbackToken     = \"YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5QUI\"\n19|\ttestDiscovery         = `{\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"discovered\":true,\"discovery_root\":\"/srv/provider/sessions\",\"backend_resolved\":false}`\n20|)\n21|\n22|func testStatusIDs() StatusIDs {\n23|\treturn StatusIDs{\n24|\t\tMaterializationID:      testMaterializationID,\n25|\t\tTransactionID:          testTransactionID,\n26|\t\tTransactionAuthorityID: testAuthorityID,\n27|\t}\n28|}\n29|\n30|// statusBody builds a ProviderTransactionStatus body. Null members are\n31|// passed as the literal null.\n32|func statusBody(materializationID, transactionID, authorityID, planID, state, token, discovery string) []byte {\n33|\tquote := func(value, fallback string) string {\n34|\t\tif value == \"null\" {\n35|\t\t\treturn \"null\"\n36|\t\t}\n37|\t\tif value == \"\" {\n38|\t\t\treturn fallback\n39|\t\t}\n40|\t\treturn `\"` + value + `\"`\n41|\t}\n42|\treturn []byte(`{\"materialization_id\":` + quote(materializationID, `\"x\"`) +\n43|\t\t`,\"transaction_id\":` + quote(transactionID, `\"x\"`) +\n44|\t\t`,\"transaction_authority_id\":` + quote(authorityID, `\"x\"`) +\n45|\t\t`,\"plan_id\":` + quote(planID, `\"x\"`) +\n46|\t\t`,\"state\":\"` + state + `\"` +\n47|\t\t`,\"rollback_token\":` + quote(token, `\"x\"`) +\n48|\t\t`,\"native_discovery\":` + discovery + `}`)\n49|}\n50|\n51|func preparedBody() []byte {\n52|\treturn statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n53|}\n54|\n55|// TestDecodeStatusOutcomeAcceptsTerminalStates proves the positive\n56|// recovery path: prepared, committed, and rolled_back observations with\n57|// the state their nullability rules require are returned as-is.\n58|func TestDecodeStatusOutcomeAcceptsTerminalStates(t *testing.T) {\n59|\tfor _, kase := range []struct {\n60|\t\tname  string\n61|\t\tbody  []byte\n62|\t\tstate StatusState\n63|\t}{\n64|\t\t{\"prepared\", preparedBody(), StatusPrepared},\n65|\t\t{\"committed\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), StatusCommitted},\n66|\t\t{\"rolled back\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"rolled_back\", \"null\", testDiscovery), StatusRolledBack},\n67|\t} {\n68|\t\tt.Run(kase.name, func(t *testing.T) {\n69|\t\t\tgot, err := DecodeStatusOutcome(kase.body, testStatusIDs())\n70|\t\t\tif err != nil {\n71|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome: %v\", err)\n72|\t\t\t}\n73|\t\t\tif got != kase.state {\n74|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want %q\", got, kase.state)\n75|\t\t\t}\n76|\t\t})\n77|\t}\n78|}\n79|\n80|// TestDecodeStatusOutcomeUnknownFailsClosed proves the quarantine rule:\n81|// state unknown fails with integrity_failure and names the state in the\n82|// details, and never returns a usable status.\n83|func TestDecodeStatusOutcomeUnknownFailsClosed(t *testing.T) {\n84|\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n85|\tgot, err := DecodeStatusOutcome(body, testStatusIDs())\n86|\tif got != \"\" {\n87|\t\tt.Fatalf(\"DecodeStatusOutcome = %q for unknown, want no status\", got)\n88|\t}\n89|\trequireLocalRefusal(t, err, \"integrity_failure\", \"transaction state is unknown\")\n90|\tif state, ok := failureObject(t, err).Detail(\"status_state\"); !ok || state != \"unknown\" {\n91|\t\tt.Fatalf(\"DecodeStatusOutcome status_state = %v, want unknown\", state)\n92|\t}\n93|\tif failureExit(t, err) != 9 {\n94|\t\tt.Fatalf(\"DecodeStatusOutcome exit = %d, want 9\", failureExit(t, err))\n95|\t}\n96|}\n97|\n98|// TestDecodeStatusOutcomeNullabilityMatrix proves every state enforces\n99|// its null/non-null rule: unknown carries nothing, prepared carries\n100|// plan, token, and discovery, and terminal states carry plan and\n101|// discovery with no token. Each violation is integrity_failure. The\n102|// production entry point is DecodeStatusOutcome.\n103|func TestDecodeStatusOutcomeNullabilityMatrix(t *testing.T) {\n104|\tfor _, kase := range []struct {\n105|\t\tname     string\n106|\t\tstate    string\n107|\t\tplan     string\n108|\t\ttoken    string\n109|\t\tdiscover string\n110|\t\tdetail   string\n111|\t}{\n112|\t\t{\"unknown with plan\", \"unknown\", testPlanID, \"null\", \"null\", \"unknown status carries plan, token, or discovery\"},\n113|\t\t{\"unknown with token\", \"unknown\", \"null\", testRollbackToken, \"null\", \"unknown status carries plan, token, or discovery\"},\n114|\t\t{\"unknown with discovery\", \"unknown\", \"null\", \"null\", testDiscovery, \"unknown status carries plan, token, or discovery\"},\n115|\t\t{\"unknown with all\", \"unknown\", testPlanID, testRollbackToken, testDiscovery, \"unknown status carries plan, token, or discovery\"},\n116|\t\t{\"prepared without plan\", \"prepared\", \"null\", testRollbackToken, testDiscovery, \"prepared status misses plan, token, or discovery\"},\n117|\t\t{\"prepared without token\", \"prepared\", testPlanID, \"null\", testDiscovery, \"prepared status misses plan, token, or discovery\"},\n118|\t\t{\"prepared without discovery\", \"prepared\", testPlanID, testRollbackToken, \"null\", \"prepared status misses plan, token, or discovery\"},\n119|\t\t{\"prepared empty\", \"prepared\", \"null\", \"null\", \"null\", \"prepared status misses plan, token, or discovery\"},\n120|\t\t{\"committed without plan\", \"committed\", \"null\", \"null\", testDiscovery, \"terminal status misses plan or discovery or keeps a token\"},\n121|\t\t{\"committed without discovery\", \"committed\", testPlanID, \"null\", \"null\", \"terminal status misses plan or discovery or keeps a token\"},\n122|\t\t{\"committed keeping token\", \"committed\", testPlanID, testRollbackToken, testDiscovery, \"terminal status misses plan or discovery or keeps a token\"},\n123|\t\t{\"rolled back without plan\", \"rolled_back\", \"null\", \"null\", testDiscovery, \"terminal status misses plan or discovery or keeps a token\"},\n124|\t\t{\"rolled back without discovery\", \"rolled_back\", testPlanID, \"null\", \"null\", \"terminal status misses plan or discovery or keeps a token\"},\n125|\t\t{\"rolled back keeping token\", \"rolled_back\", testPlanID, testRollbackToken, testDiscovery, \"terminal status misses plan or discovery or keeps a token\"},\n126|\t} {\n127|\t\tt.Run(kase.name, func(t *testing.T) {\n128|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, kase.plan, kase.state, kase.token, kase.discover)\n129|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n130|\t\t\trequireLocalRefusal(t, err, \"integrity_failure\", kase.detail)\n131|\t\t})\n132|\t}\n133|}\n134|\n135|// TestDecodeStatusOutcomeRefusesForeignTransactions proves identity\n136|// binding: a status naming another materialization, transaction, or\n137|// authority is not this transaction's durable state.\n138|func TestDecodeStatusOutcomeRefusesForeignTransactions(t *testing.T) {\n139|\tother := \"0198f4c8-aaaa-73aa-9374-1234567890ab\"\n140|\tfor _, kase := range []struct {\n141|\t\tname   string\n142|\t\tbody   []byte\n143|\t\tdetail string\n144|\t}{\n145|\t\t{\"other materialization\", statusBody(other, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery), \"status names another materialization\"},\n146|\t\t{\"other transaction\", statusBody(testMaterializationID, other, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery), \"status names another transaction\"},\n147|\t\t{\"other authority\", statusBody(testMaterializationID, testTransactionID, \"another_authority\", testPlanID, \"prepared\", testRollbackToken, testDiscovery), \"status names another transaction authority\"},\n148|\t\t{\"non-string materialization\", statusBody(\"\", testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery), \"status names another materialization\"},\n149|\t} {\n150|\t\tt.Run(kase.name, func(t *testing.T) {\n151|\t\t\tbody := kase.body\n152|\t\t\tif strings.Contains(kase.name, \"non-string\") {\n153|\t\t\t\tbody = []byte(`{\"materialization_id\":7,\"transaction_id\":\"` + testTransactionID + `\",\"transaction_authority_id\":\"` + testAuthorityID + `\",\"plan_id\":\"` + testPlanID + `\",\"state\":\"prepared\",\"rollback_token\":\"` + testRollbackToken + `\",\"native_discovery\":` + testDiscovery + `}`)\n154|\t\t\t}\n155|\t\t\t_, err := DecodeStatusOutcome(body, testStatusIDs())\n156|\t\t\trequireLocalRefusal(t, err, \"integrity_failure\", kase.detail)\n157|\t\t})\n158|\t}\n159|}\n160|\n161|// TestDecodeStatusOutcomeRefusesMalformedBodies proves uninterpretable\n162|// observations fail closed with integrity_failure rather than as absent\n163|// or partial states.\n164|func TestDecodeStatusOutcomeRefusesMalformedBodies(t *testing.T) {\n165|\tgood := string(preparedBody())\n166|\tfor _, kase := range []struct {\n167|\t\tname   string\n168|\t\tbody   string\n169|\t\tdetail string\n170|\t}{\n171|\t\t{\"empty\", ``, \"status body is not a JSON object\"},\n172|\t\t{\"not JSON\", `oops`, \"status body is not a JSON object\"},\n173|\t\t{\"array\", `[]`, \"status body is not a JSON object\"},\n174|\t\t{\"scalar\", `1`, \"status body is not a JSON object\"},\n175|\t\t{\"trailing data\", good + \"x\", \"status body is trailing data after the object\"},\n176|\t\t{\"duplicate member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1), \"status body is duplicate member\"},\n177|\t\t{\"unknown member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"phase\":\"prepared\"`, 1), \"status body carries unknown member\"},\n178|\t\t{\"missing plan\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\",`, ``, 1), \"status body misses a required member\"},\n179|\t\t{\"missing state\", strings.Replace(good, `,\"state\":\"prepared\"`, ``, 1), \"status body misses a required member\"},\n180|\t\t{\"bad state\", strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1), \"status state is not a registry member\"},\n181|\t\t{\"non-string state\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":7`, 1), \"status state is not a registry member\"},\n182|\t\t{\"malformed digest\", strings.Replace(good, testPlanID, \"sha256:xyz\", 1), \"status plan_id is not a digest\"},\n183|\t\t{\"non-string digest\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1), \"status plan_id is not a string\"},\n184|\t\t{\"short token\", strings.Replace(good, testRollbackToken, \"YWJj\", 1), \"status rollback_token is shorter than 256 bits\"},\n185|\t\t{\"non-base64 token\", strings.Replace(good, testRollbackToken, \"!!!not-base64!!!\", 1), \"status rollback_token is shorter than 256 bits\"},\n186|\t\t{\"non-string token\", strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1), \"status rollback_token is not a string\"},\n187|\t\t{\"scalar discovery\", strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1), \"status native_discovery is not an object\"},\n188|\t\t{\"malformed operation id\", strings.Replace(good, `\"materialization_id\"`, `\"operation_id\":\"bogus\",\"materialization_id\"`, 1), \"status operation_id is not a UUIDv7\"},\n189|\t} {\n190|\t\tt.Run(kase.name, func(t *testing.T) {\n191|\t\t\t_, err := DecodeStatusOutcome([]byte(kase.body), testStatusIDs())\n192|\t\t\trequireLocalRefusal(t, err, \"integrity_failure\", kase.detail)\n193|\t\t})\n194|\t}\n195|}\n196|\n197|// tokenWithDecodedBytes builds a base64url rollback token decoding to\n198|// exactly n bytes, so the 256-bit floor is pinned from both sides rather\n199|// than only somewhere between the 3-byte short fixture and the 38-byte\n200|// valid one.\n201|func tokenWithDecodedBytes(t *testing.T, n int) string {\n202|\tt.Helper()\n203|\ttoken := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{0x9e}, n))\n204|\traw, err := base64.RawURLEncoding.DecodeString(token)\n205|\tif err != nil {\n206|\t\tt.Fatalf(\"DecodeString: %v\", err)\n207|\t}\n208|\tif len(raw) != n {\n209|\t\tt.Fatalf(\"token decodes to %d bytes, want exactly %d\", len(raw), n)\n210|\t}\n211|\treturn token\n212|}\n213|\n214|// TestDecodeStatusOutcomeEnforcesTokenEntropyFloor proves the 256-bit\n215|// rollback-token floor exactly: a token decoding to 31 bytes fails, and\n216|// one decoding to 32 bytes is accepted. Any weakened floor at or below\n217|// 248 bits admits the 31-byte token; any raised floor rejects the valid\n218|// 32-byte observation. The production entry point is DecodeStatusOutcome.\n219|func TestDecodeStatusOutcomeEnforcesTokenEntropyFloor(t *testing.T) {\n220|\tshort := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", tokenWithDecodedBytes(t, 31), testDiscovery)\n221|\t_, err := DecodeStatusOutcome(short, testStatusIDs())\n222|\trequireLocalRefusal(t, err, \"integrity_failure\", \"status rollback_token is shorter than 256 bits\")\n223|\n224|\tfloor := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", tokenWithDecodedBytes(t, 32), testDiscovery)\n225|\tif got, err := DecodeStatusOutcome(floor, testStatusIDs()); err != nil || got != StatusPrepared {\n226|\t\tt.Fatalf(\"32-byte-token recovery = %q, %v; want prepared\", got, err)\n227|\t}\n228|}\n229|\n230|// TestDecodeStatusOutcomeIgnoresWellFormedOperationID proves a present\n231|// mutation key does not alias the read: status identity is the\n232|// materialization/transaction pair, so a well-formed operation_id is\n233|// accepted and ignored.\n234|func TestDecodeStatusOutcomeIgnoresWellFormedOperationID(t *testing.T) {\n235|\tbody := strings.Replace(string(preparedBody()), `\"materialization_id\"`, `\"operation_id\":\"0198f4c8-e4b0-75cc-9576-1234567890ab\",\"materialization_id\"`, 1)\n236|\tgot, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n237|\tif err != nil {\n238|\t\tt.Fatalf(\"DecodeStatusOutcome with operation_id: %v\", err)\n239|\t}\n240|\tif got != StatusPrepared {\n241|\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want prepared\", got)\n242|\t}\n243|}\n244|\n245|// TestStatusReadsEvolve proves no byte-identical replay rule applies to\n246|// status observations: the same transaction may report prepared under\n247|// one envelope and committed under the next, and both readings succeed.\n248|func TestStatusReadsEvolve(t *testing.T) {\n249|\tids := testStatusIDs()\n250|\tfirst, err := DecodeStatusOutcome(preparedBody(), ids)\n251|\tif err != nil {\n252|\t\tt.Fatalf(\"first read: %v\", err)\n253|\t}\n254|\tsecond, err := DecodeStatusOutcome(statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), ids)\n255|\tif err != nil {\n256|\t\tt.Fatalf(\"second read: %v\", err)\n257|\t}\n258|\tif first != StatusPrepared || second != StatusCommitted {\n259|\t\tt.Fatalf(\"evolving reads = %q then %q, want prepared then committed\", first, second)\n260|\t}\n261|}\n262|\n263|// TestStatusRecoveryAcrossProcesses proves the cross-process recovery\n264|// shape over the real entry points: two status Calls start two separate\n265|// processes with frames identical except request_id, and each durable\n266|// observation reconciles independently.\n267|func TestStatusRecoveryAcrossProcesses(t *testing.T) {\n268|\tcommitted := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery)\n269|\trunner := &scriptRunner{steps: []scriptStep{\n270|\t\tokStep(Result{Stdout: successFrame(t, testRequestID, string(preparedBody())), ExitCode: 0}),\n271|\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(committed)), ExitCode: 0}),\n272|\t}}\n273|\thost := liveHost(runner)\n274|\tfirstReq := liveRequest(t)\n275|\tfirstReq.Operation = OpMaterializeStatus\n276|\tfirstReq.RequestID = mustUUIDv7(t, testRequestID)\n277|\tfirst, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", firstReq)\n278|\tif err != nil {\n279|\t\tt.Fatalf(\"first status Call: %v\", err)\n280|\t}\n281|\tsecondReq := liveRequest(t)\n282|\tsecondReq.Operation = OpMaterializeStatus\n283|\tsecondReq.RequestID = mustUUIDv7(t, testOtherID)\n284|\tsecond, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", secondReq)\n285|\tif err != nil {\n286|\t\tt.Fatalf(\"second status Call: %v\", err)\n287|\t}\n288|\tif runner.spawned() != 2 {\n289|\t\tt.Fatalf(\"two status reads spawned %d processes, want one per read\", runner.spawned())\n290|\t}\n291|\tif firstState, err := DecodeStatusOutcome(first.Body, testStatusIDs()); err != nil || firstState != StatusPrepared {\n292|\t\tt.Fatalf(\"first recovery = %q, %v; want prepared\", firstState, err)\n293|\t}\n294|\tif secondState, err := DecodeStatusOutcome(second.Body, testStatusIDs()); err != nil || secondState != StatusCommitted {\n295|\t\tt.Fatalf(\"second recovery = %q, %v; want committed\", secondState, err)\n296|\t}\n297|}\n298|\n299|// TestLostMutationRecoversThroughStatus proves the lost-prepare shape: a\n300|// mutation Call whose response is lost is followed by a status read, and\n301|// the runner observes exactly one mutation frame — the host never\n302|// re-issues the mutation on its own, so no second destination mutation\n303|// can occur.\n304|func TestLostMutationRecoversThroughStatus(t *testing.T) {\n305|\trunner := &scriptRunner{\n306|\t\tsteps: []scriptStep{\n307|\t\t\tfailStep(context.DeadlineExceeded),\n308|\t\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(preparedBody())), ExitCode: 0}),\n309|\t\t},\n310|\t}\n311|\t// The runner error above fires with a live deadline, so it is a\n312|\t// transport failure, not a timeout.\n313|\thost := Host{Runner: runner, Now: time.Now}\n314|\tmutation := liveRequest(t)\n315|\tmutation.Operation = OpMaterialize\n316|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", mutation)\n317|\trequireLocalRefusal(t, err, \"provider_process_failed\", \"runner reported no result\")\n318|\tstatus := liveRequest(t)\n319|\tstatus.Operation = OpMaterializeStatus\n320|\tstatus.RequestID = mustUUIDv7(t, testOtherID)\n321|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", status)\n322|\tif err != nil {\n323|\t\tt.Fatalf(\"status Call: %v\", err)\n324|\t}\n325|\tstate, err := DecodeStatusOutcome(got.Body, testStatusIDs())\n326|\tif err != nil || state != StatusPrepared {\n327|\t\tt.Fatalf(\"recovery = %q, %v; want prepared\", state, err)\n328|\t}\n329|\tif runner.spawned() != 2 {\n330|\t\tt.Fatalf(\"recovery spawned %d processes, want mutation plus one status read\", runner.spawned())\n331|\t}\n332|\tmutations := 0\n333|\tfor _, call := range runner.calls {\n334|\t\tvar decoded struct {\n335|\t\t\tOperation string `json:\"operation\"`\n336|\t\t}\n337|\t\tif err := json.Unmarshal(call.stdin, &decoded); err != nil {\n338|\t\t\tt.Fatalf(\"recorded stdin is not JSON: %v\", err)\n339|\t\t}\n340|\t\tif decoded.Operation == string(OpMaterialize) {\n341|\t\t\tmutations++\n342|\t\t}\n343|\t}\n344|\tif mutations != 1 {\n345|\t\tt.Fatalf(\"runner observed %d mutation frames, want exactly one and no blind retry\", mutations)\n346|\t}\n347|}\n348|\n349|// TestUnknownTransactionQuarantinesThroughCall proves the unknown\n350|// transaction path end to end: a status body of unknown surfaces\n351|// integrity_failure from the composed read, never a status.\n352|func TestUnknownTransactionQuarantinesThroughCall(t *testing.T) {\n353|\tunknown := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n354|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: successFrame(t, testRequestID, string(unknown)), ExitCode: 0})}}\n355|\thost := liveHost(runner)\n356|\treq := liveRequest(t)\n357|\treq.Operation = OpMaterializeStatus\n358|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n359|\tif err != nil {\n360|\t\tt.Fatalf(\"status Call: %v\", err)\n361|\t}\n362|\tstate, err := DecodeStatusOutcome(got.Body, testStatusIDs())\n363|\tif state != \"\" {\n364|\t\tt.Fatalf(\"unknown recovery = %q, want no status\", state)\n365|\t}\n366|\trequireLocalRefusal(t, err, \"integrity_failure\", \"transaction state is unknown\")\n367|}"}}}
