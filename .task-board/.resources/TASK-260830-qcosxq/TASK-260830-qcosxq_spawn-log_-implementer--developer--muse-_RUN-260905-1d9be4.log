{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5cd","stream":{"kind":"session","id":"01a06f12-fa6f-76e2-8836-346b2c16c0e2"},"sequence":321,"recorded_at":1780531400000637,"record_type":"event","durability":"durable","causation_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","run_stream":{"kind":"run","id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec"},"call_id":"call_01a06f13ae267b92a85868f779880367","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/protocol_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// asError unwraps err to an *axerror.Error without hiding the chain.\n15|func asError(t *testing.T, err error, failure **axerror.Error) bool {\n16|\tt.Helper()\n17|\treturn errors.As(err, failure)\n18|}\n19|\n20|const (\n21|\ttestRequestID = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n22|\ttestOtherID   = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n23|\ttestDeadline  = \"2026-08-19T04:05:00.000Z\"\n24|\ttestNow       = \"2026-08-19T04:00:00.000Z\"\n25|)\n26|\n27|func mustUUIDv7(t *testing.T, value string) scalar.UUIDv7 {\n28|\tt.Helper()\n29|\tparsed, err := scalar.ParseUUIDv7(value)\n30|\tif err != nil {\n31|\t\tt.Fatalf(\"ParseUUIDv7(%q): %v\", value, err)\n32|\t}\n33|\treturn parsed\n34|}\n35|\n36|func mustTimestamp(t *testing.T, value string) scalar.Timestamp {\n37|\tt.Helper()\n38|\tparsed, err := scalar.ParseTimestamp(value)\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n41|\t}\n42|\treturn parsed\n43|}\n44|\n45|func mustInstant(t *testing.T, value string) time.Time {\n46|\tt.Helper()\n47|\tinstant, err := mustTimestamp(t, value).Time()\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"Timestamp(%q).Time(): %v\", value, err)\n50|\t}\n51|\treturn instant\n52|}\n53|\n54|// testRequest builds the Section 7.2 request-envelope fixture: a doctor\n55|// operation with a future deadline. The production entry point for\n56|// framing is EncodeRequest.\n57|func testRequest(t *testing.T) Request {\n58|\tt.Helper()\n59|\treturn Request{\n60|\t\tOperation: OpDoctor,\n61|\t\tRequestID: mustUUIDv7(t, testRequestID),\n62|\t\tDeadline:  mustTimestamp(t, testDeadline),\n63|\t\tBody:      json.RawMessage(`{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}`),\n64|\t}\n65|}\n66|\n67|// failureCode extracts the Structured Error code from err, failing when\n68|// err is not an *axerror.Error. Every failure below is a 1.0.0 object,\n69|// local or child-bound.\n70|func failureCode(t *testing.T, err error) axerror.Code {\n71|\tt.Helper()\n72|\tif err == nil {\n73|\t\tt.Fatal(\"want a failure, got nil\")\n74|\t}\n75|\tvar failure *axerror.Error\n76|\tif !asError(t, err, &failure) {\n77|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n78|\t}\n79|\treturn failure.Code()\n80|}\n81|\n82|func failureExit(t *testing.T, err error) int {\n83|\tt.Helper()\n84|\tvar failure *axerror.Error\n85|\tif !asError(t, err, &failure) {\n86|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n87|\t}\n88|\treturn failure.ExitCode()\n89|}\n90|\n91|// TestEncodeRequestEmitsExactFrame pins the request wire bytes: the six\n92|// exact members in fixed order, with the body passed through verbatim.\n93|func TestEncodeRequestEmitsExactFrame(t *testing.T) {\n94|\tframe, err := EncodeRequest(testRequest(t), mustInstant(t, testNow))\n95|\tif err != nil {\n96|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n97|\t}\n98|\twant := `{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"operation\":\"doctor\",\"deadline\":\"2026-08-19T04:05:00.000Z\",\"body\":{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}}`\n99|\tif string(frame) != want {\n100|\t\tt.Fatalf(\"EncodeRequest frame = %s, want %s\", frame, want)\n101|\t}\n102|}\n103|\n104|// TestEncodeRequestDispatchesEveryRegistryOperation proves dispatch\n105|// reaches every registry entry: each of the 15 operations frames with\n106|// its own name. The registry list itself is pinned against the\n107|// specification text by the inventory test.\n108|func TestEncodeRequestDispatchesEveryRegistryOperation(t *testing.T) {\n109|\tnow := mustInstant(t, testNow)\n110|\tfor _, name := range Operations() {\n111|\t\treq := testRequest(t)\n112|\t\treq.Operation = Operation(name)\n113|\t\tframe, err := EncodeRequest(req, now)\n114|\t\tif err != nil {\n115|\t\t\tt.Fatalf(\"EncodeRequest(%q): %v\", name, err)\n116|\t\t}\n117|\t\tvar decoded struct {\n118|\t\t\tOperation string `json:\"operation\"`\n119|\t\t}\n120|\t\tif err := json.Unmarshal(frame, &decoded); err != nil {\n121|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame is not JSON: %v\", name, err)\n122|\t\t}\n123|\t\tif decoded.Operation != name {\n124|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame carries operation %q\", name, decoded.Operation)\n125|\t\t}\n126|\t}\n127|}\n128|\n129|// TestEncodeRequestRefusals proves framing fails closed before any\n130|// process starts: unknown operations, non-UUIDv7 request IDs, stale or\n131|// malformed deadlines, non-object bodies, and oversize frames are all\n132|// invalid_config from EncodeRequest. The production entry point is\n133|// EncodeRequest.\n134|func TestEncodeRequestRefusals(t *testing.T) {\n135|\tnow := mustInstant(t, testNow)\n136|\tfor _, kase := range []struct {\n137|\t\tname   string\n138|\t\tmutate func(*Request)\n139|\t}{\n140|\t\t{\"unknown operation\", func(req *Request) { req.Operation = \"reboot\" }},\n141|\t\t{\"empty operation\", func(req *Request) { req.Operation = \"\" }},\n142|\t\t{\"zero request id\", func(req *Request) { req.RequestID = scalar.UUIDv7{} }},\n143|\t\t{\"zero deadline\", func(req *Request) { req.Deadline = scalar.Timestamp{} }},\n144|\t\t{\"past deadline\", func(req *Request) { req.Deadline = mustTimestamp(t, testNow) }},\n145|\t\t{\"deadline long past\", func(req *Request) { req.Deadline = mustTimestamp(t, \"2020-01-01T00:00:00.000Z\") }},\n146|\t\t{\"array body\", func(req *Request) { req.Body = json.RawMessage(`[1,2]`) }},\n147|\t\t{\"string body\", func(req *Request) { req.Body = json.RawMessage(`\"x\"`) }},\n148|\t\t{\"scalar body\", func(req *Request) { req.Body = json.RawMessage(`3`) }},\n149|\t\t{\"empty body\", func(req *Request) { req.Body = nil }},\n150|\t\t{\"blank body\", func(req *Request) { req.Body = json.RawMessage(`  `) }},\n151|\t\t{\"malformed body\", func(req *Request) { req.Body = json.RawMessage(`{oops`) }},\n152|\t\t{\"oversize frame\", func(req *Request) {\n153|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n154|\t\t}},\n155|\t} {\n156|\t\tt.Run(kase.name, func(t *testing.T) {\n157|\t\t\treq := testRequest(t)\n158|\t\t\tkase.mutate(&req)\n159|\t\t\tif _, err := EncodeRequest(req, now); failureCode(t, err) != \"invalid_config\" {\n160|\t\t\t\tt.Fatalf(\"EncodeRequest code = %v, want invalid_config\", err)\n161|\t\t\t}\n162|\t\t})\n163|\t}\n164|}\n165|\n166|// successFrame builds a minimal valid success envelope for want.\n167|func successFrame(t *testing.T, want, body string) []byte {\n168|\tt.Helper()\n169|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":true,\"body\":` + body + `}`)\n170|}\n171|\n172|// childFailureFrame builds a failure envelope carrying a genuine bound\n173|// child error, constructed through the production axerror entry point.\n174|func childFailureFrame(t *testing.T, want string) []byte {\n175|\tt.Helper()\n176|\tchild, err := axerror.New(axerror.Spec{\n177|\t\tVersion: axerror.Version100,\n178|\t\tCode:    \"capability_unavailable\",\n179|\t\tMessage: \"portable store is not available for this provider build\",\n180|\t\tDetails: axerror.Details{},\n181|\t})\n182|\tif err != nil {\n183|\t\tt.Fatalf(\"axerror.New: %v\", err)\n184|\t}\n185|\traw, err := json.Marshal(child)\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"Marshal child: %v\", err)\n188|\t}\n189|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":false,\"error\":` + string(raw) + `}`)\n190|}\n191|\n192|// TestDecodeResponseAcceptsSuccess proves the positive path returns the\n193|// body verbatim for correlation-matched frames.\n194|func TestDecodeResponseAcceptsSuccess(t *testing.T) {\n195|\tbody := `{\"provider_id\":\"pi\",\"provider_version\":\"0.73.1\",\"findings\":[]}`\n196|\tgot, err := DecodeResponse(successFrame(t, testRequestID, body), mustUUIDv7(t, testRequestID))\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"DecodeResponse: %v\", err)\n199|\t}\n200|\tif string(got.Body) != body {\n201|\t\tt.Fatalf(\"DecodeResponse body = %s, want %s\", got.Body, body)\n202|\t}\n203|}\n204|\n205|// TestDecodeResponseReturnsChildFailure proves a failure envelope\n206|// surfaces the bound child error itself, with its own code and exit.\n207|func TestDecodeResponseReturnsChildFailure(t *testing.T) {\n208|\t_, err := DecodeResponse(childFailureFrame(t, testRequestID), mustUUIDv7(t, testRequestID))\n209|\tif failureCode(t, err) != \"capability_unavailable\" {\n210|\t\tt.Fatalf(\"DecodeResponse code = %v, want the bound child code capability_unavailable\", err)\n211|\t}\n212|\tif failureExit(t, err) != 6 {\n213|\t\tt.Fatalf(\"DecodeResponse exit = %d, want 6\", failureExit(t, err))\n214|\t}\n215|}\n216|\n217|// TestDecodeResponseRecognizableMajorMismatch proves a foreign major is\n218|// reported as incompatible_protocol without trusting the payload: the\n219|// frame carries a forged error object whose code must never surface.\n220|func TestDecodeResponseRecognizableMajorMismatch(t *testing.T) {\n221|\tfor _, version := range []string{\"3.0.0\", \"1.0.0\", \"10.2.3\"} {\n222|\t\tframe := []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"forged_code\",\"message\":\"forged\",\"exit_code\":0,\"retryable\":true,\"details\":{}}}`)\n223|\t\t_, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID))\n224|\t\tif failureCode(t, err) != \"incompatible_protocol\" {\n225|\t\t\tt.Fatalf(\"DecodeResponse(%s) code = %v, want incompatible_protocol\", version, err)\n226|\t\t}\n227|\t\tif failureExit(t, err) != 6 {\n228|\t\t\tt.Fatalf(\"DecodeResponse(%s) exit = %d, want 6\", version, failureExit(t, err))\n229|\t\t}\n230|\t\tif strings.Contains(err.Error(), \"forged_code\") {\n231|\t\t\tt.Fatalf(\"foreign payload leaked into the local failure: %v\", err)\n232|\t\t}\n233|\t}\n234|}\n235|\n236|// TestDecodeResponseRefusals proves every unusable frame shape fails with\n237|// provider_protocol_error, never with a partial result. The production\n238|// entry point is DecodeResponse.\n239|func TestDecodeResponseRefusals(t *testing.T) {\n240|\twant := mustUUIDv7(t, testRequestID)\n241|\tokFrame := func(members string) []byte {\n242|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n243|\t}\n244|\tvalidBody := `{\"provider_id\":\"pi\"}`\n245|\tfor _, kase := range []struct {\n246|\t\tname  string\n247|\t\tframe []byte\n248|\t}{\n249|\t\t{\"empty\", []byte{}},\n250|\t\t{\"not JSON\", []byte(`not json`)},\n251|\t\t{\"truncated\", []byte(`{\"protocol\":`)},\n252|\t\t{\"array\", []byte(`[1,2]`)},\n253|\t\t{\"scalar\", []byte(`true`)},\n254|\t\t{\"trailing data\", append(successFrame(t, testRequestID, validBody), 'x')},\n255|\t\t{\"trailing valid value\", append(successFrame(t, testRequestID, validBody), ' ', '{', '}')},\n256|\t\t{\"duplicate member\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n257|\t\t{\"missing protocol\", []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n258|\t\t{\"missing version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n259|\t\t{\"missing request id\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"ok\":true,\"body\":{}}`)},\n260|\t\t{\"missing ok\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`)},\n261|\t\t{\"missing body on success\", okFrame(`\"ok\":true`)},\n262|\t\t{\"missing error on failure\", okFrame(`\"ok\":false`)},\n263|\t\t{\"body on failure\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`)},\n264|\t\t{\"error on success\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)},\n265|\t\t{\"unknown member\", okFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`)},\n266|\t\t{\"ok not boolean\", okFrame(`\"ok\":\"yes\",\"body\":{}`)},\n267|\t\t{\"wrong protocol\", []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n268|\t\t{\"protocol not string\", []byte(`{\"protocol\":7,\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n269|\t\t{\"minor version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.1.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n270|\t\t{\"garbage version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"v2\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n271|\t\t{\"short version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n272|\t\t{\"empty version part\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2..0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n273|\t\t{\"non-numeric version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"a.b.c\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n274|\t\t{\"version not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n275|\t\t{\"empty version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)},\n276|\t\t{\"request id not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":7,\"ok\":true,\"body\":{}}`)},\n277|\t\t{\"request id not UUIDv7\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`)},\n278|\t\t{\"request id mismatch\", successFrame(t, testOtherID, validBody)},\n279|\t\t{\"body array on success\", okFrame(`\"ok\":true,\"body\":[]`)},\n280|\t\t{\"body scalar on success\", okFrame(`\"ok\":true,\"body\":1`)},\n281|\t\t{\"error scalar on failure\", okFrame(`\"ok\":false,\"error\":1`)},\n282|\t\t{\"error unbound version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`)},\n283|\t} {\n284|\t\tt.Run(kase.name, func(t *testing.T) {\n285|\t\t\tif _, err := DecodeResponse(kase.frame, want); failureCode(t, err) != \"provider_protocol_error\" {\n286|\t\t\t\tt.Fatalf(\"DecodeResponse code = %v, want provider_protocol_error\", err)\n287|\t\t\t}\n288|\t\t})\n289|\t}\n290|}\n291|\n292|// TestDecodeResponseRefusesOversizeFrame proves the 8 MiB bound from the\n293|// decoding side: a frame one byte over the limit fails without being\n294|// parsed, and a frame exactly at the limit is accepted.\n295|// specFrameLimitBytes is the absolute Section 7.2 bound, stated as a\n296|// literal rather than derived from MaxFrameBytes: the fixtures below pin\n297|// the constant to the specification text, so weakening the constant\n298|// reddens here instead of scaling the fixtures along with it.\n299|const specFrameLimitBytes = 8 << 20\n300|\n301|func TestDecodeResponseRefusesOversizeFrame(t *testing.T) {\n302|\tif MaxFrameBytes != specFrameLimitBytes {\n303|\t\tt.Fatalf(\"MaxFrameBytes = %d, want the specified %d\", MaxFrameBytes, specFrameLimitBytes)\n304|\t}\n305|\twant := mustUUIDv7(t, testRequestID)\n306|\tbuild := func(pad int) []byte {\n307|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n308|\t}\n309|\t// The pad contributes exactly pad bytes, so base+pad is the frame\n310|\t// size. One byte over the limit must fail; exactly at it must pass.\n311|\tbase := len(build(0))\n312|\tover := build(specFrameLimitBytes - base + 1)\n313|\tif len(over) != specFrameLimitBytes+1 {\n314|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n315|\t}\n316|\tif _, err := DecodeResponse(over, want); failureCode(t, err) != \"provider_protocol_error\" {\n317|\t\tt.Fatalf(\"oversize DecodeResponse code = %v, want provider_protocol_error\", err)\n318|\t}\n319|\tframe := build(specFrameLimitBytes - base)\n320|\tif len(frame) != specFrameLimitBytes {\n321|\t\tt.Fatalf(\"boundary fixture is %d bytes, want exactly %d\", len(frame), specFrameLimitBytes)\n322|\t}\n323|\tif _, err := DecodeResponse(frame, want); err != nil {\n324|\t\tt.Fatalf(\"boundary DecodeResponse: %v\", err)\n325|\t}\n326|}\n327|\n328|// TestDecodeResponseRefusesNonUTF8 proves the UTF-8 gate: invalid bytes\n329|// fail even when the surrounding shape would parse.\n330|func TestDecodeResponseRefusesNonUTF8(t *testing.T) {\n331|\tframe := append([]byte{}, successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`)...)\n332|\tframe[len(frame)-3] = 0xff\n333|\tif _, err := DecodeResponse(frame, mustUUIDv7(t, testRequestID)); failureCode(t, err) != \"provider_protocol_error\" {\n334|\t\tt.Fatalf(\"non-UTF8 DecodeResponse code = %v, want provider_protocol_error\", err)\n335|\t}\n336|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
