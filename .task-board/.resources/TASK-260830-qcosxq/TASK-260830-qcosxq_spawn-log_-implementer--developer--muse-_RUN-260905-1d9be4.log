apture holds at most\n184|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n185|// trailing byte, is always visible in the captured length. No separate\n186|// truncation flag participates; a narrowed or dropped disjunct here\n187|// would be equivalent, not coverage.\n188|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n189|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n190|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n191|\t}\n192|\treturn captured, len(captured) > MaxFrameBytes, false\n193|}\n194|\n195|// Call dispatches one operation: it frames the request, starts one plugin\n196|// process, enforces the request deadline, and interprets the single\n197|// response frame. Encode failures return before the Runner is touched, so\n198|// an unknown operation never starts a process. A success envelope returns\n199|// its body; a failure envelope returns the bound child error; anything\n200|// else returns a local failure that trusts nothing from the plugin.\n201|//\n202|// Deadline accounting is exact: the wait ends under a context cut at the\n203|// request deadline, and provider_timeout is reported only when that\n204|// instant actually passed. A parent cancellation first, or any other\n205|// runner failure with time remaining, is provider_process_failed. An\n206|// empty stdout with time remaining is a missing response:\n207|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n208|// An empty stdout after the deadline passed is provider_timeout, and a\n209|// valid frame governs regardless of lateness or exit status.\n210|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n211|\tif host.Runner == nil {\n212|\t\tfailure, err := failInvalid(\"host has no runner\")\n213|\t\tif err != nil {\n214|\t\t\treturn Response{}, err\n215|\t\t}\n216|\t\treturn Response{}, failure\n217|\t}\n218|\tframe, deadline, err := encodeFrame(req, host.now())\n219|\tif err != nil {\n220|\t\treturn Response{}, err\n221|\t}\n222|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n223|\tdefer cancel()\n224|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n225|\tif err != nil {\n226|\t\tnow := host.now()\n227|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n228|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n229|\t\t\tif fault != nil {\n230|\t\t\t\treturn Response{}, fault\n231|\t\t\t}\n232|\t\t\treturn Response{}, failure\n233|\t\t}\n234|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n235|\t\tif fault != nil {\n236|\t\t\treturn Response{}, fault\n237|\t\t}\n238|\t\treturn Response{}, failure\n239|\t}\n240|\tline, oversize, extra := splitFrame(result.Stdout)\n241|\tif oversize {\n242|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n243|\t\tif fault != nil {\n244|\t\t\treturn Response{}, fault\n245|\t\t}\n246|\t\treturn Response{}, failure\n247|\t}\n248|\tif extra {\n249|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n250|\t\tif fault != nil {\n251|\t\t\treturn Response{}, fault\n252|\t\t}\n253|\t\treturn Response{}, failure\n254|\t}\n255|\tif len(line) == 0 {\n256|\t\t// No valid response arrived. When the request deadline passed,\n257|\t\t// this is the timeout even if the process also exited badly:\n258|\t\t// the host waited the full allowance and got nothing usable.\n259|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n260|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n261|\t\t\tif fault != nil {\n262|\t\t\t\treturn Response{}, fault\n263|\t\t\t}\n264|\t\t\treturn Response{}, failure\n265|\t\t}\n266|\t\tif result.ExitCode != 0 {\n267|\t\t\tfailure, fault := failProcess(\"plugin exited without a response\", nil)\n268|\t\t\tif fault != nil {\n269|\t\t\t\treturn Response{}, fault\n270|\t\t\t}\n271|\t\t\treturn Response{}, failure\n272|\t\t}\n273|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n274|\t\tif fault != nil {\n275|\t\t\treturn Response{}, fault\n276|\t\t}\n277|\t\treturn Response{}, failure\n278|\t}\n279|\treturn DecodeResponse(line, req.RequestID)\n280|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
