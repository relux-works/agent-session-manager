{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c601","stream":{"kind":"session","id":"01a06f12-fa6f-76e2-8836-346b2c16c0e2"},"sequence":347,"recorded_at":1780531400000689,"record_type":"event","durability":"durable","causation_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","run_stream":{"kind":"run","id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec"},"call_id":"call_01a06f13b8c67270893821e8d4c798c2","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// futureDeadline returns a deadline duration ahead of the real clock,\n19|// so Host deadline accounting runs against live time.\n20|func futureDeadline(t *testing.T, ahead time.Duration) scalar.Timestamp {\n21|\tt.Helper()\n22|\tparsed, err := scalar.ParseTimestamp(time.Now().Add(ahead).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n25|\t}\n26|\treturn parsed\n27|}\n28|\n29|// liveRequest is testRequest with a live future deadline for Host calls,\n30|// which enforce the deadline against a real context.\n31|func liveRequest(t *testing.T) Request {\n32|\tt.Helper()\n33|\treq := testRequest(t)\n34|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n35|\treturn req\n36|}\n37|\n38|// liveHost builds a Host on the real clock.\n39|func liveHost(runner *scriptRunner) Host {\n40|\treturn Host{Runner: runner, Now: time.Now}\n41|}\n42|\n43|// scriptCall records one Runner invocation.\n44|type scriptCall struct {\n45|\texecutable string\n46|\tstdin      []byte\n47|}\n48|\n49|// scriptRunner is a scripted Runner: it replays canned results, records\n50|// every invocation, and optionally blocks until the context ends to\n51|// simulate a hung plugin. It proves Host behavior without real processes;\n52|// the ExecRunner integration test below drives the production call site.\n53|// scriptStep is one canned invocation outcome: either a result or a\n54|// transport error, consumed in listed order.\n55|type scriptStep struct {\n56|\tresult Result\n57|\terr    error\n58|}\n59|\n60|func okStep(result Result) scriptStep { return scriptStep{result: result} }\n61|\n62|func failStep(err error) scriptStep { return scriptStep{err: err} }\n63|\n64|type scriptRunner struct {\n65|\tmu    sync.Mutex\n66|\tcalls []scriptCall\n67|\tsteps []scriptStep\n68|\tblock bool\n69|\t// delay sleeps past the request deadline before replaying, so the\n70|\t// runner returns a result after the deadline instead of an error.\n71|\tdelay time.Duration\n72|}\n73|\n74|func (runner *scriptRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n75|\trunner.mu.Lock()\n76|\trunner.calls = append(runner.calls, scriptCall{executable: executable, stdin: append([]byte(nil), stdin...)})\n77|\tindex := len(runner.calls) - 1\n78|\trunner.mu.Unlock()\n79|\tif runner.block {\n80|\t\t<-ctx.Done()\n81|\t\treturn Result{}, ctx.Err()\n82|\t}\n83|\tif runner.delay > 0 {\n84|\t\ttime.Sleep(runner.delay)\n85|\t}\n86|\tif index < len(runner.steps) {\n87|\t\tstep := runner.steps[index]\n88|\t\treturn step.result, step.err\n89|\t}\n90|\treturn Result{}, errors.New(\"script: no step canned\")\n91|}\n92|\n93|func (runner *scriptRunner) spawned() int {\n94|\trunner.mu.Lock()\n95|\tdefer runner.mu.Unlock()\n96|\treturn len(runner.calls)\n97|}\n98|\n99|func successResult(t *testing.T, id, body string) Result {\n100|\tt.Helper()\n101|\treturn Result{Stdout: successFrame(t, id, body), ExitCode: 0}\n102|}\n103|\n104|// TestCallSendsOneFrameToOneProcess proves the dispatch path: the exact\n105|// request frame reaches exactly one process of the named executable.\n106|func TestCallSendsOneFrameToOneProcess(t *testing.T) {\n107|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n108|\thost := liveHost(runner)\n109|\treq := liveRequest(t)\n110|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n111|\tif err != nil {\n112|\t\tt.Fatalf(\"Call: %v\", err)\n113|\t}\n114|\tif string(got.Body) != `{\"provider_id\":\"pi\"}` {\n115|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n116|\t}\n117|\tif runner.spawned() != 1 {\n118|\t\tt.Fatalf(\"Call spawned %d processes, want exactly one per operation\", runner.spawned())\n119|\t}\n120|\tcall := runner.calls[0]\n121|\tif call.executable != \"/plugins/ax-provider-pi\" {\n122|\t\tt.Fatalf(\"Call executable = %q\", call.executable)\n123|\t}\n124|\tframe, err := EncodeRequest(req, time.Now())\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n127|\t}\n128|\tif string(call.stdin) != string(frame) {\n129|\t\tt.Fatalf(\"Call stdin = %q, want the single request frame\", call.stdin)\n130|\t}\n131|}\n132|\n133|// TestCallUnknownOperationStartsNoProcess proves dispatch refuses an\n134|// unregistered operation locally: the failure is invalid_config and the\n135|// Runner is never touched.\n136|func TestCallUnknownOperationStartsNoProcess(t *testing.T) {\n137|\trunner := &scriptRunner{}\n138|\thost := liveHost(runner)\n139|\treq := liveRequest(t)\n140|\treq.Operation = \"reboot\"\n141|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); failureCode(t, err) != \"invalid_config\" {\n142|\t\tt.Fatalf(\"Call code = %v, want invalid_config\", err)\n143|\t}\n144|\tif runner.spawned() != 0 {\n145|\t\tt.Fatalf(\"Call spawned %d processes for an unknown operation, want none\", runner.spawned())\n146|\t}\n147|}\n148|\n149|// TestCallNilRunnerRefuses proves a host without a Runner fails closed\n150|// before framing.\n151|func TestCallNilRunnerRefuses(t *testing.T) {\n152|\thost := Host{Now: time.Now}\n153|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); failureCode(t, err) != \"invalid_config\" {\n154|\t\tt.Fatalf(\"Call code = %v, want invalid_config\", err)\n155|\t}\n156|}\n157|\n158|// TestCallUsesSystemClockWhenUnset proves the nil-clock branch: a Host\n159|// without Now enforces live deadlines.\n160|func TestCallUsesSystemClockWhenUnset(t *testing.T) {\n161|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n162|\thost := Host{Runner: runner}\n163|\treq := testRequest(t)\n164|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n165|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); err != nil {\n166|\t\tt.Fatalf(\"Call with unset clock: %v\", err)\n167|\t}\n168|}\n169|\n170|// failingReader always errors, exercising the capped-read failure path.\n171|type failingReader struct{}\n172|\n173|func (failingReader) Read([]byte) (int, error) { return 0, errors.New(\"fake: read failed\") }\n174|\n175|// TestReadCappedReportsStreamErrors proves a stream failure surfaces\n176|// instead of an empty capture.\n177|func TestReadCappedReportsStreamErrors(t *testing.T) {\n178|\tif _, err := readCapped(failingReader{}, 1024); err == nil {\n179|\t\tt.Fatal(\"readCapped swallowed a stream error\")\n180|\t}\n181|}\n182|\n183|// TestCallTimesOutHungPlugin proves the deadline path: a plugin that\n184|// never answers is terminated at the request deadline and reported as\n185|// provider_timeout with exit 13.\n186|func TestCallTimesOutHungPlugin(t *testing.T) {\n187|\trunner := &scriptRunner{block: true}\n188|\thost := liveHost(runner)\n189|\treq := liveRequest(t)\n190|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n191|\tstart := time.Now()\n192|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n193|\tif elapsed := time.Since(start); elapsed > 10*time.Second {\n194|\t\tt.Fatalf(\"Call took %v, want deadline enforcement near 100ms\", elapsed)\n195|\t}\n196|\tif failureCode(t, err) != \"provider_timeout\" {\n197|\t\tt.Fatalf(\"Call code = %v, want provider_timeout\", err)\n198|\t}\n199|\tif failureExit(t, err) != 13 {\n200|\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n201|\t}\n202|}\n203|\n204|// TestCallEmptyResultAfterDeadlineIsTimeout proves the late-empty\n205|// path: a runner that answers with nothing after the deadline still\n206|// reports provider_timeout, even though the process exited on its own.\n207|func TestCallEmptyResultAfterDeadlineIsTimeout(t *testing.T) {\n208|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n209|\thost := liveHost(runner)\n210|\treq := liveRequest(t)\n211|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n212|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); failureCode(t, err) != \"provider_timeout\" {\n213|\t\tt.Fatalf(\"Call code = %v, want provider_timeout\", err)\n214|\t}\n215|}\n216|\n217|// TestCallRunnerErrorBeforeDeadlineIsProcessFailure proves a transport\n218|// failure with time remaining is provider_process_failed, not a timeout.\n219|func TestCallRunnerErrorBeforeDeadlineIsProcessFailure(t *testing.T) {\n220|\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n221|\thost := liveHost(runner)\n222|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); failureCode(t, err) != \"provider_process_failed\" {\n223|\t\tt.Fatalf(\"Call code = %v, want provider_process_failed\", err)\n224|\t}\n225|}\n226|\n227|// TestCallParentCancelIsNotTimeout proves a caller abort with time\n228|// remaining is provider_process_failed: the deadline never passed, so no\n229|// timeout may be claimed.\n230|func TestCallParentCancelIsNotTimeout(t *testing.T) {\n231|\trunner := &scriptRunner{block: true}\n232|\thost := liveHost(runner)\n233|\tctx, cancel := context.WithCancel(context.Background())\n234|\tcancel()\n235|\t_, err := host.Call(ctx, \"/plugins/ax-provider-pi\", liveRequest(t))\n236|\tif failureCode(t, err) != \"provider_process_failed\" {\n237|\t\tt.Fatalf(\"Call code = %v, want provider_process_failed\", err)\n238|\t}\n239|}\n240|\n241|// TestCallMissingResponse proves an empty stdout is a missing response:\n242|// provider_process_failed on a crash exit, provider_protocol_error when\n243|// the plugin claimed success by exiting 0.\n244|func TestCallMissingResponse(t *testing.T) {\n245|\tfor _, kase := range []struct {\n246|\t\tname string\n247|\t\tcode int\n248|\t\twant string\n249|\t}{\n250|\t\t{\"crash exit\", 3, \"provider_process_failed\"},\n251|\t\t{\"signal-like exit\", 137, \"provider_process_failed\"},\n252|\t\t{\"clean exit\", 0, \"provider_protocol_error\"},\n253|\t} {\n254|\t\tt.Run(kase.name, func(t *testing.T) {\n255|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: kase.code})}}\n256|\t\t\thost := liveHost(runner)\n257|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n258|\t\t\tif failureCode(t, err) != axerror.Code(kase.want) {\n259|\t\t\t\tt.Fatalf(\"Call code = %v, want %s\", err, kase.want)\n260|\t\t\t}\n261|\t\t})\n262|\t}\n263|}\n264|\n265|// TestCallRefusesUnusableStdout proves crashes, garbage, and\n266|// correlation breaks map to the Section 7.2 host-failure classes. The\n267|// production entry point is Host.Call.\n268|func TestCallRefusesUnusableStdout(t *testing.T) {\n269|\tfor _, kase := range []struct {\n270|\t\tname   string\n271|\t\tresult Result\n272|\t\twant   string\n273|\t}{\n274|\t\t{\"garbage\", Result{Stdout: []byte(\"not json\\n\"), Stderr: []byte(\"traceback\\n\"), ExitCode: 1}, \"provider_protocol_error\"},\n275|\t\t{\"crash no output\", Result{ExitCode: 1}, \"provider_process_failed\"},\n276|\t\t{\"wrong request id\", Result{Stdout: successFrame(t, testOtherID, `{}`), ExitCode: 0}, \"provider_protocol_error\"},\n277|\t\t{\"extra line\", Result{Stdout: append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n'), ExitCode: 0}, \"provider_protocol_error\"},\n278|\t\t{\"foreign major\", Result{Stdout: []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), ExitCode: 0}, \"incompatible_protocol\"},\n279|\t} {\n280|\t\tt.Run(kase.name, func(t *testing.T) {\n281|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(kase.result)}}\n282|\t\t\thost := liveHost(runner)\n283|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n284|\t\t\tif failureCode(t, err) != axerror.Code(kase.want) {\n285|\t\t\t\tt.Fatalf(\"Call code = %v, want %s\", err, kase.want)\n286|\t\t\t}\n287|\t\t})\n288|\t}\n289|}\n290|\n291|// TestCallSeparatesStderr proves stdout/stderr separation two ways: a\n292|// valid frame succeeds despite noisy diagnostics, and a failing\n293|// invocation never carries stderr content in its human text.\n294|func TestCallSeparatesStderr(t *testing.T) {\n295|\tsecret := \"[REDACTED]\"\n296|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{\n297|\t\tStdout:   successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`),\n298|\t\tStderr:   []byte(\"diagnostic: using \" + secret + \"\\n\"),\n299|\t\tExitCode: 0,\n300|\t})}}\n301|\thost := liveHost(runner)\n302|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); err != nil {\n303|\t\tt.Fatalf(\"Call with stderr diagnostics: %v\", err)\n304|\t}\n305|\n306|\tbad := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: []byte(\"garbage\\n\"), Stderr: []byte(secret + \"\\n\"), ExitCode: 1})}}\n307|\thost = liveHost(bad)\n308|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n309|\tif failureCode(t, err) != \"provider_protocol_error\" {\n310|\t\tt.Fatalf(\"Call code = %v, want provider_protocol_error\", err)\n311|\t}\n312|\tif strings.Contains(err.Error(), secret) {\n313|\t\tt.Fatalf(\"stderr content leaked into the failure text: %v\", err)\n314|\t}\n315|}\n316|\n317|// TestCallOversizeStdoutRefuses proves a first line one byte over 8 MiB\n318|// fails as provider_protocol_error through the full Call path.\n319|func TestCallOversizeStdoutRefuses(t *testing.T) {\n320|\tpad := strings.Repeat(\"a\", specFrameLimitBytes)\n321|\tframe := successFrame(t, testRequestID, `{\"pad\":\"`+pad+`\"}`)\n322|\tif len(frame) <= specFrameLimitBytes {\n323|\t\tt.Fatalf(\"oversize stdout is %d bytes, want over %d\", len(frame), specFrameLimitBytes)\n324|\t}\n325|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: frame, ExitCode: 0})}}\n326|\thost := liveHost(runner)\n327|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n328|\tif failureCode(t, err) != \"provider_protocol_error\" {\n329|\t\tt.Fatalf(\"Call code = %v, want provider_protocol_error\", err)\n330|\t}\n331|}\n332|\n333|// TestCallOneProcessPerCall proves the single-flight cross-process\n334|// property: two calls start two processes with distinct request IDs.\n335|func TestCallOneProcessPerCall(t *testing.T) {\n336|\trunner := &scriptRunner{steps: []scriptStep{\n337|\t\tokStep(successResult(t, testRequestID, `{}`)),\n338|\t\tokStep(successResult(t, testOtherID, `{}`)),\n339|\t}}\n340|\thost := liveHost(runner)\n341|\tfirst := liveRequest(t)\n342|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", first); err != nil {\n343|\t\tt.Fatalf(\"first Call: %v\", err)\n344|\t}\n345|\tsecond := liveRequest(t)\n346|\tsecond.RequestID = mustUUIDv7(t, testOtherID)\n347|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", second); err != nil {\n348|\t\tt.Fatalf(\"second Call: %v\", err)\n349|\t}\n350|\tif runner.spawned() != 2 {\n351|\t\tt.Fatalf(\"two Calls spawned %d processes, want one per operation\", runner.spawned())\n352|\t}\n353|\tif string(runner.calls[0].stdin) == string(runner.calls[1].stdin) {\n354|\t\tt.Fatal(\"successive calls sent byte-identical frames; request IDs must differ\")\n355|\t}\n356|}\n357|\n358|// TestExecRunnerEchoRoundTrip drives the production call site end to\n359|// end: a real plugin script receives the frame on stdin and answers on\n360|// stdout while logging diagnostics to stderr.\n361|func TestExecRunnerEchoRoundTrip(t *testing.T) {\n362|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n363|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n364|\t}\n365|\troot := t.TempDir()\n366|\tscript := filepath.Join(root, \"ax-provider-echo\")\n367|\tplugin := `#!/bin/sh\n368|echo \"diagnostic: starting\" >&2\n369|frame=$(cat)\n370|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n371|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n372|exit 0\n373|`\n374|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n375|\t\tt.Fatalf(\"WriteFile: %v\", err)\n376|\t}\n377|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n378|\tgot, err := host.Call(context.Background(), script, liveRequest(t))\n379|\tif err != nil {\n380|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n381|\t}\n382|\tif string(got.Body) != `{\"provider_id\":\"echo\"}` {\n383|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n384|\t}\n385|}\n386|\n387|// TestExecRunnerEnforcesDeadline drives the production kill path: a\n388|// plugin that sleeps past the deadline is terminated and reported as\n389|// provider_timeout.\n390|func TestExecRunnerEnforcesDeadline(t *testing.T) {\n391|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n392|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n393|\t}\n394|\tscript := filepath.Join(t.TempDir(), \"ax-provider-sleep\")\n395|\tif err := os.WriteFile(script, []byte(\"#!/bin/sh\\nsleep 30\\n\"), 0o700); err != nil {\n396|\t\tt.Fatalf(\"WriteFile: %v\", err)\n397|\t}\n398|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n399|\treq := liveRequest(t)\n400|\tstamp, err := scalar.ParseTimestamp(time.Now().Add(300 * time.Millisecond).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n401|\tif err != nil {\n402|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n403|\t}\n404|\treq.Deadline = stamp\n405|\tstart := time.Now()\n406|\t_, err = host.Call(context.Background(), script, req)\n407|\telapsed := time.Since(start)\n408|\tif elapsed > 20*time.Second {\n409|\t\tt.Fatalf(\"Call took %v, want termination near the deadline\", elapsed)\n410|\t}\n411|\t// The script sleeps as a child of sh, so a parent-only kill would\n412|\t// leave it holding the pipes until WaitDelay (2s) expires. Returning\n413|\t// near the 300ms deadline proves the whole process group died.\n414|\tif elapsed >= waitDrainDelay {\n415|\t\tt.Fatalf(\"Call took %v, want group termination well before the %v drain delay\", elapsed, waitDrainDelay)\n416|\t}\n417|\tif failureCode(t, err) != \"provider_timeout\" {\n418|\t\tt.Fatalf(\"Call code = %v, want provider_timeout\", err)\n419|\t}\n420|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c603","stream":{"kind":"session","id":"01a06f12-fa6f-76e2-8836-346b2c16c0e2"},"sequence":348,"recorded_at":1780531400000691,"record_type":"event","durability":"durable","causation_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","run_stream":{"kind":"run","id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec"},"call_id":"call_01a06f13b9ef7f63b8079957e7155a9e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/status_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|const (\n12|\ttestMaterializationID = \"0198f4c8-c290-73aa-9374-1234567890ab\"\n13|\ttestTransactionID     = \"0198f4c8-f5c0-76dd-9677-1234567890ab\"\n14|\ttestAuthorityID       = \"provider_transaction\"\n15|\ttestPlanID            = \"sha256:64644a5ad573d36c0c13f44f56ef25ab93cff33001ff2a3371b082603910f2dd\"\n16|\ttestRollbackToken     = \"YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5QUI\"\n17|\ttestDiscovery         = `{\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"discovered\":true,\"discovery_root\":\"/srv/provider/sessions\",\"backend_resolved\":false}`\n18|)\n19|\n20|func testStatusIDs() StatusIDs {\n21|\treturn StatusIDs{\n22|\t\tMaterializationID:      testMaterializationID,\n23|\t\tTransactionID:          testTransactionID,\n24|\t\tTransactionAuthorityID: testAuthorityID,\n25|\t}\n26|}\n27|\n28|// statusBody builds a ProviderTransactionStatus body. Null members are\n29|// passed as the literal null.\n30|func statusBody(materializationID, transactionID, authorityID, planID, state, token, discovery string) []byte {\n31|\tquote := func(value, fallback string) string {\n32|\t\tif value == \"null\" {\n33|\t\t\treturn \"null\"\n34|\t\t}\n35|\t\tif value == \"\" {\n36|\t\t\treturn fallback\n37|\t\t}\n38|\t\treturn `\"` + value + `\"`\n39|\t}\n40|\treturn []byte(`{\"materialization_id\":` + quote(materializationID, `\"x\"`) +\n41|\t\t`,\"transaction_id\":` + quote(transactionID, `\"x\"`) +\n42|\t\t`,\"transaction_authority_id\":` + quote(authorityID, `\"x\"`) +\n43|\t\t`,\"plan_id\":` + quote(planID, `\"x\"`) +\n44|\t\t`,\"state\":\"` + state + `\"` +\n45|\t\t`,\"rollback_token\":` + quote(token, `\"x\"`) +\n46|\t\t`,\"native_discovery\":` + discovery + `}`)\n47|}\n48|\n49|func preparedBody() []byte {\n50|\treturn statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n51|}\n52|\n53|// TestDecodeStatusOutcomeAcceptsTerminalStates proves the positive\n54|// recovery path: prepared, committed, and rolled_back observations with\n55|// the state their nullability rules require are returned as-is.\n56|func TestDecodeStatusOutcomeAcceptsTerminalStates(t *testing.T) {\n57|\tfor _, kase := range []struct {\n58|\t\tname  string\n59|\t\tbody  []byte\n60|\t\tstate StatusState\n61|\t}{\n62|\t\t{\"prepared\", preparedBody(), StatusPrepared},\n63|\t\t{\"committed\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), StatusCommitted},\n64|\t\t{\"rolled back\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"rolled_back\", \"null\", testDiscovery), StatusRolledBack},\n65|\t} {\n66|\t\tt.Run(kase.name, func(t *testing.T) {\n67|\t\t\tgot, err := DecodeStatusOutcome(kase.body, testStatusIDs())\n68|\t\t\tif err != nil {\n69|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome: %v\", err)\n70|\t\t\t}\n71|\t\t\tif got != kase.state {\n72|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want %q\", got, kase.state)\n73|\t\t\t}\n74|\t\t})\n75|\t}\n76|}\n77|\n78|// TestDecodeStatusOutcomeUnknownFailsClosed proves the quarantine rule:\n79|// state unknown fails with integrity_failure and names the state in the\n80|// details, and never returns a usable status.\n81|func TestDecodeStatusOutcomeUnknownFailsClosed(t *testing.T) {\n82|\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n83|\tgot, err := DecodeStatusOutcome(body, testStatusIDs())\n84|\tif got != \"\" {\n85|\t\tt.Fatalf(\"DecodeStatusOutcome = %q for unknown, want no status\", got)\n86|\t}\n87|\tif failureCode(t, err) != \"integrity_failure\" {\n88|\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n89|\t}\n90|\tif failureExit(t, err) != 9 {\n91|\t\tt.Fatalf(\"DecodeStatusOutcome exit = %d, want 9\", failureExit(t, err))\n92|\t}\n93|}\n94|\n95|// TestDecodeStatusOutcomeNullabilityMatrix proves every state enforces\n96|// its null/non-null rule: unknown carries nothing, prepared carries\n97|// plan, token, and discovery, and terminal states carry plan and\n98|// discovery with no token. Each violation is integrity_failure. The\n99|// production entry point is DecodeStatusOutcome.\n100|func TestDecodeStatusOutcomeNullabilityMatrix(t *testing.T) {\n101|\tfor _, kase := range []struct {\n102|\t\tname     string\n103|\t\tstate    string\n104|\t\tplan     string\n105|\t\ttoken    string\n106|\t\tdiscover string\n107|\t}{\n108|\t\t{\"unknown with plan\", \"unknown\", testPlanID, \"null\", \"null\"},\n109|\t\t{\"unknown with token\", \"unknown\", \"null\", testRollbackToken, \"null\"},\n110|\t\t{\"unknown with discovery\", \"unknown\", \"null\", \"null\", testDiscovery},\n111|\t\t{\"unknown with all\", \"unknown\", testPlanID, testRollbackToken, testDiscovery},\n112|\t\t{\"prepared without plan\", \"prepared\", \"null\", testRollbackToken, testDiscovery},\n113|\t\t{\"prepared without token\", \"prepared\", testPlanID, \"null\", testDiscovery},\n114|\t\t{\"prepared without discovery\", \"prepared\", testPlanID, testRollbackToken, \"null\"},\n115|\t\t{\"prepared empty\", \"prepared\", \"null\", \"null\", \"null\"},\n116|\t\t{\"committed without plan\", \"committed\", \"null\", \"null\", testDiscovery},\n117|\t\t{\"committed without discovery\", \"committed\", testPlanID, \"null\", \"null\"},\n118|\t\t{\"committed keeping token\", \"committed\", testPlanID, testRollbackToken, testDiscovery},\n119|\t\t{\"rolled back without plan\", \"rolled_back\", \"null\", \"null\", testDiscovery},\n120|\t\t{\"rolled back without discovery\", \"rolled_back\", testPlanID, \"null\", \"null\"},\n121|\t\t{\"rolled back keeping token\", \"rolled_back\", testPlanID, testRollbackToken, testDiscovery},\n122|\t} {\n123|\t\tt.Run(kase.name, func(t *testing.T) {\n124|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, kase.plan, kase.state, kase.token, kase.discover)\n125|\t\t\tif _, err := DecodeStatusOutcome(body, testStatusIDs()); failureCode(t, err) != \"integrity_failure\" {\n126|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n127|\t\t\t}\n128|\t\t})\n129|\t}\n130|}\n131|\n132|// TestDecodeStatusOutcomeRefusesForeignTransactions proves identity\n133|// binding: a status naming another materialization, transaction, or\n134|// authority is not this transaction's durable state.\n135|func TestDecodeStatusOutcomeRefusesForeignTransactions(t *testing.T) {\n136|\tother := \"0198f4c8-aaaa-73aa-9374-1234567890ab\"\n137|\tfor _, kase := range []struct {\n138|\t\tname string\n139|\t\tbody []byte\n140|\t}{\n141|\t\t{\"other materialization\", statusBody(other, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n142|\t\t{\"other transaction\", statusBody(testMaterializationID, other, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n143|\t\t{\"other authority\", statusBody(testMaterializationID, testTransactionID, \"another_authority\", testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n144|\t\t{\"non-string materialization\", statusBody(\"\", testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n145|\t} {\n146|\t\tt.Run(kase.name, func(t *testing.T) {\n147|\t\t\tbody := kase.body\n148|\t\t\tif strings.Contains(kase.name, \"non-string\") {\n149|\t\t\t\tbody = []byte(`{\"materialization_id\":7,\"transaction_id\":\"` + testTransactionID + `\",\"transaction_authority_id\":\"` + testAuthorityID + `\",\"plan_id\":\"` + testPlanID + `\",\"state\":\"prepared\",\"rollback_token\":\"` + testRollbackToken + `\",\"native_discovery\":` + testDiscovery + `}`)\n150|\t\t\t}\n151|\t\t\tif _, err := DecodeStatusOutcome(body, testStatusIDs()); failureCode(t, err) != \"integrity_failure\" {\n152|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n153|\t\t\t}\n154|\t\t})\n155|\t}\n156|}\n157|\n158|// TestDecodeStatusOutcomeRefusesMalformedBodies proves uninterpretable\n159|// observations fail closed with integrity_failure rather than as absent\n160|// or partial states.\n161|func TestDecodeStatusOutcomeRefusesMalformedBodies(t *testing.T) {\n162|\tgood := string(preparedBody())\n163|\tfor _, kase := range []struct {\n164|\t\tname string\n165|\t\tbody string\n166|\t}{\n167|\t\t{\"empty\", ``},\n168|\t\t{\"not JSON\", `oops`},\n169|\t\t{\"array\", `[]`},\n170|\t\t{\"scalar\", `1`},\n171|\t\t{\"trailing data\", good + \"x\"},\n172|\t\t{\"duplicate member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1)},\n173|\t\t{\"unknown member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"phase\":\"prepared\"`, 1)},\n174|\t\t{\"missing plan\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\",`, ``, 1)},\n175|\t\t{\"missing state\", strings.Replace(good, `,\"state\":\"prepared\"`, ``, 1)},\n176|\t\t{\"bad state\", strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1)},\n177|\t\t{\"non-string state\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":7`, 1)},\n178|\t\t{\"malformed digest\", strings.Replace(good, testPlanID, \"sha256:xyz\", 1)},\n179|\t\t{\"non-string digest\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1)},\n180|\t\t{\"short token\", strings.Replace(good, testRollbackToken, \"YWJj\", 1)},\n181|\t\t{\"non-base64 token\", strings.Replace(good, testRollbackToken, \"!!!not-base64!!!\", 1)},\n182|\t\t{\"non-string token\", strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1)},\n183|\t\t{\"scalar discovery\", strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1)},\n184|\t\t{\"malformed operation id\", strings.Replace(good, `\"materialization_id\"`, `\"operation_id\":\"bogus\",\"materialization_id\"`, 1)},\n185|\t} {\n186|\t\tt.Run(kase.name, func(t *testing.T) {\n187|\t\t\tif _, err := DecodeStatusOutcome([]byte(kase.body), testStatusIDs()); failureCode(t, err) != \"integrity_failure\" {\n188|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n189|\t\t\t}\n190|\t\t})\n191|\t}\n192|}\n193|\n194|// TestDecodeStatusOutcomeIgnoresWellFormedOperationID proves a present\n195|// mutation key does not alias the read: status identity is the\n196|// materialization/transaction pair, so a well-formed operation_id is\n197|// accepted and ignored.\n198|func TestDecodeStatusOutcomeIgnoresWellFormedOperationID(t *testing.T) {\n199|\tbody := strings.Replace(string(preparedBody()), `\"materialization_id\"`, `\"operation_id\":\"0198f4c8-e4b0-75cc-9576-1234567890ab\",\"materialization_id\"`, 1)\n200|\tgot, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n201|\tif err != nil {\n202|\t\tt.Fatalf(\"DecodeStatusOutcome with operation_id: %v\", err)\n203|\t}\n204|\tif got != StatusPrepared {\n205|\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want prepared\", got)\n206|\t}\n207|}\n208|\n209|// TestStatusReadsEvolve proves no byte-identical replay rule applies to\n210|// status observations: the same transaction may report prepared under\n211|// one envelope and committed under the next, and both readings succeed.\n212|func TestStatusReadsEvolve(t *testing.T) {\n213|\tids := testStatusIDs()\n214|\tfirst, err := DecodeStatusOutcome(preparedBody(), ids)\n215|\tif err != nil {\n216|\t\tt.Fatalf(\"first read: %v\", err)\n217|\t}\n218|\tsecond, err := DecodeStatusOutcome(statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), ids)\n219|\tif err != nil {\n220|\t\tt.Fatalf(\"second read: %v\", err)\n221|\t}\n222|\tif first != StatusPrepared || second != StatusCommitted {\n223|\t\tt.Fatalf(\"evolving reads = %q then %q, want prepared then committed\", first, second)\n224|\t}\n225|}\n226|\n227|// TestStatusRecoveryAcrossProcesses proves the cross-process recovery\n228|// shape over the real entry points: two status Calls start two separate\n229|// processes with frames identical except request_id, and each durable\n230|// observation reconciles independently.\n231|func TestStatusRecoveryAcrossProcesses(t *testing.T) {\n232|\tcommitted := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery)\n233|\trunner := &scriptRunner{steps: []scriptStep{\n234|\t\tokStep(Result{Stdout: successFrame(t, testRequestID, string(preparedBody())), ExitCode: 0}),\n235|\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(committed)), ExitCode: 0}),\n236|\t}}\n237|\thost := liveHost(runner)\n238|\tfirstReq := liveRequest(t)\n239|\tfirstReq.Operation = OpMaterializeStatus\n240|\tfirstReq.RequestID = mustUUIDv7(t, testRequestID)\n241|\tfirst, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", firstReq)\n242|\tif err != nil {\n243|\t\tt.Fatalf(\"first status Call: %v\", err)\n244|\t}\n245|\tsecondReq := liveRequest(t)\n246|\tsecondReq.Operation = OpMaterializeStatus\n247|\tsecondReq.RequestID = mustUUIDv7(t, testOtherID)\n248|\tsecond, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", secondReq)\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"second status Call: %v\", err)\n251|\t}\n252|\tif runner.spawned() != 2 {\n253|\t\tt.Fatalf(\"two status reads spawned %d processes, want one per read\", runner.spawned())\n254|\t}\n255|\tif firstState, err := DecodeStatusOutcome(first.Body, testStatusIDs()); err != nil || firstState != StatusPrepared {\n256|\t\tt.Fatalf(\"first recovery = %q, %v; want prepared\", firstState, err)\n257|\t}\n258|\tif secondState, err := DecodeStatusOutcome(second.Body, testStatusIDs()); err != nil || secondState != StatusCommitted {\n259|\t\tt.Fatalf(\"second recovery = %q, %v; want committed\", secondState, err)\n260|\t}\n261|}\n262|\n263|// TestLostMutationRecoversThroughStatus proves the lost-prepare shape: a\n264|// mutation Call whose response is lost is followed by a status read, and\n265|// the runner observes exactly one mutation frame — the host never\n266|// re-issues the mutation on its own, so no second destination mutation\n267|// can occur.\n268|func TestLostMutationRecoversThroughStatus(t *testing.T) {\n269|\trunner := &scriptRunner{\n270|\t\tsteps: []scriptStep{\n271|\t\t\tfailStep(context.DeadlineExceeded),\n272|\t\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(preparedBody())), ExitCode: 0}),\n273|\t\t},\n274|\t}\n275|\t// The runner error above fires with a live deadline, so it is a\n276|\t// transport failure, not a timeout.\n277|\thost := Host{Runner: runner, Now: time.Now}\n278|\tmutation := liveRequest(t)\n279|\tmutation.Operation = OpMaterialize\n280|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", mutation); failureCode(t, err) != \"provider_process_failed\" {\n281|\t\tt.Fatalf(\"lost mutation code = %v, want provider_process_failed\", err)\n282|\t}\n283|\tstatus := liveRequest(t)\n284|\tstatus.Operation = OpMaterializeStatus\n285|\tstatus.RequestID = mustUUIDv7(t, testOtherID)\n286|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", status)\n287|\tif err != nil {\n288|\t\tt.Fatalf(\"status Call: %v\", err)\n289|\t}\n290|\tstate, err := DecodeStatusOutcome(got.Body, testStatusIDs())\n291|\tif err != nil || state != StatusPrepared {\n292|\t\tt.Fatalf(\"recovery = %q, %v; want prepared\", state, err)\n293|\t}\n294|\tif runner.spawned() != 2 {\n295|\t\tt.Fatalf(\"recovery spawned %d processes, want mutation plus one status read\", runner.spawned())\n296|\t}\n297|\tmutations := 0\n298|\tfor _, call := range runner.calls {\n299|\t\tvar decoded struct {\n300|\t\t\tOperation string `json:\"operation\"`\n301|\t\t}\n302|\t\tif err := json.Unmarshal(call.stdin, &decoded); err != nil {\n303|\t\t\tt.Fatalf(\"recorded stdin is not JSON: %v\", err)\n304|\t\t}\n305|\t\tif decoded.Operation == string(OpMaterialize) {\n306|\t\t\tmutations++\n307|\t\t}\n308|\t}\n309|\tif mutations != 1 {\n310|\t\tt.Fatalf(\"runner observed %d mutation frames, want exactly one and no blind retry\", mutations)\n311|\t}\n312|}\n313|\n314|// TestUnknownTransactionQuarantinesThroughCall proves the unknown\n315|// transaction path end to end: a status body of unknown surfaces\n316|// integrity_failure from the composed read, never a status.\n317|func TestUnknownTransactionQuarantinesThroughCall(t *testing.T) {\n318|\tunknown := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n319|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: successFrame(t, testRequestID, string(unknown)), ExitCode: 0})}}\n320|\thost := liveHost(runner)\n321|\treq := liveRequest(t)\n322|\treq.Operation = OpMaterializeStatus\n323|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n324|\tif err != nil {\n325|\t\tt.Fatalf(\"status Call: %v\", err)\n326|\t}\n327|\tif state, err := DecodeStatusOutcome(got.Body, testStatusIDs()); failureCode(t, err) != \"integrity_failure\" || state != \"\" {\n328|\t\tt.Fatalf(\"unknown recovery = %q, %v; want no status with integrity_failure\", state, err)\n329|\t}\n330|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
