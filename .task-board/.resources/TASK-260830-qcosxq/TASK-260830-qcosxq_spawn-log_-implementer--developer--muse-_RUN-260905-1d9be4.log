{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5f9","stream":{"kind":"session","id":"01a06f12-fa6f-76e2-8836-346b2c16c0e2"},"sequence":343,"recorded_at":1780531400000681,"record_type":"event","durability":"durable","causation_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","run_stream":{"kind":"run","id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec"},"task_stream":{"kind":"task","id":"4eba4741-0f42-4941-bd85-0863c4cba49e"},"task_id":"4eba4741-0f42-4941-bd85-0863c4cba49e","event":{"kind":"output","task_id":"4eba4741-0f42-4941-bd85-0863c4cba49e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/status_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|const (\n12|\ttestMaterializationID = \"0198f4c8-c290-73aa-9374-1234567890ab\"\n13|\ttestTransactionID     = \"0198f4c8-f5c0-76dd-9677-1234567890ab\"\n14|\ttestAuthorityID       = \"provider_transaction\"\n15|\ttestPlanID            = \"sha256:64644a5ad573d36c0c13f44f56ef25ab93cff33001ff2a3371b082603910f2dd\"\n16|\ttestRollbackToken     = \"YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU2Nzg5QUI\"\n17|\ttestDiscovery         = `{\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"discovered\":true,\"discovery_root\":\"/srv/provider/sessions\",\"backend_resolved\":false}`\n18|)\n19|\n20|func testStatusIDs() StatusIDs {\n21|\treturn StatusIDs{\n22|\t\tMaterializationID:      testMaterializationID,\n23|\t\tTransactionID:          testTransactionID,\n24|\t\tTransactionAuthorityID: testAuthorityID,\n25|\t}\n26|}\n27|\n28|// statusBody builds a ProviderTransactionStatus body. Null members are\n29|// passed as the literal null.\n30|func statusBody(materializationID, transactionID, authorityID, planID, state, token, discovery string) []byte {\n31|\tquote := func(value, fallback string) string {\n32|\t\tif value == \"null\" {\n33|\t\t\treturn \"null\"\n34|\t\t}\n35|\t\tif value == \"\" {\n36|\t\t\treturn fallback\n37|\t\t}\n38|\t\treturn `\"` + value + `\"`\n39|\t}\n40|\treturn []byte(`{\"materialization_id\":` + quote(materializationID, `\"x\"`) +\n41|\t\t`,\"transaction_id\":` + quote(transactionID, `\"x\"`) +\n42|\t\t`,\"transaction_authority_id\":` + quote(authorityID, `\"x\"`) +\n43|\t\t`,\"plan_id\":` + quote(planID, `\"x\"`) +\n44|\t\t`,\"state\":\"` + state + `\"` +\n45|\t\t`,\"rollback_token\":` + quote(token, `\"x\"`) +\n46|\t\t`,\"native_discovery\":` + discovery + `}`)\n47|}\n48|\n49|func preparedBody() []byte {\n50|\treturn statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)\n51|}\n52|\n53|// TestDecodeStatusOutcomeAcceptsTerminalStates proves the positive\n54|// recovery path: prepared, committed, and rolled_back observations with\n55|// the state their nullability rules require are returned as-is.\n56|func TestDecodeStatusOutcomeAcceptsTerminalStates(t *testing.T) {\n57|\tfor _, kase := range []struct {\n58|\t\tname  string\n59|\t\tbody  []byte\n60|\t\tstate StatusState\n61|\t}{\n62|\t\t{\"prepared\", preparedBody(), StatusPrepared},\n63|\t\t{\"committed\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), StatusCommitted},\n64|\t\t{\"rolled back\", statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"rolled_back\", \"null\", testDiscovery), StatusRolledBack},\n65|\t} {\n66|\t\tt.Run(kase.name, func(t *testing.T) {\n67|\t\t\tgot, err := DecodeStatusOutcome(kase.body, testStatusIDs())\n68|\t\t\tif err != nil {\n69|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome: %v\", err)\n70|\t\t\t}\n71|\t\t\tif got != kase.state {\n72|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want %q\", got, kase.state)\n73|\t\t\t}\n74|\t\t})\n75|\t}\n76|}\n77|\n78|// TestDecodeStatusOutcomeUnknownFailsClosed proves the quarantine rule:\n79|// state unknown fails with integrity_failure and names the state in the\n80|// details, and never returns a usable status.\n81|func TestDecodeStatusOutcomeUnknownFailsClosed(t *testing.T) {\n82|\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n83|\tgot, err := DecodeStatusOutcome(body, testStatusIDs())\n84|\tif got != \"\" {\n85|\t\tt.Fatalf(\"DecodeStatusOutcome = %q for unknown, want no status\", got)\n86|\t}\n87|\tif failureCode(t, err) != \"integrity_failure\" {\n88|\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n89|\t}\n90|\tif failureExit(t, err) != 9 {\n91|\t\tt.Fatalf(\"DecodeStatusOutcome exit = %d, want 9\", failureExit(t, err))\n92|\t}\n93|}\n94|\n95|// TestDecodeStatusOutcomeNullabilityMatrix proves every state enforces\n96|// its null/non-null rule: unknown carries nothing, prepared carries\n97|// plan, token, and discovery, and terminal states carry plan and\n98|// discovery with no token. Each violation is integrity_failure. The\n99|// production entry point is DecodeStatusOutcome.\n100|func TestDecodeStatusOutcomeNullabilityMatrix(t *testing.T) {\n101|\tfor _, kase := range []struct {\n102|\t\tname     string\n103|\t\tstate    string\n104|\t\tplan     string\n105|\t\ttoken    string\n106|\t\tdiscover string\n107|\t}{\n108|\t\t{\"unknown with plan\", \"unknown\", testPlanID, \"null\", \"null\"},\n109|\t\t{\"unknown with token\", \"unknown\", \"null\", testRollbackToken, \"null\"},\n110|\t\t{\"unknown with discovery\", \"unknown\", \"null\", \"null\", testDiscovery},\n111|\t\t{\"unknown with all\", \"unknown\", testPlanID, testRollbackToken, testDiscovery},\n112|\t\t{\"prepared without plan\", \"prepared\", \"null\", testRollbackToken, testDiscovery},\n113|\t\t{\"prepared without token\", \"prepared\", testPlanID, \"null\", testDiscovery},\n114|\t\t{\"prepared without discovery\", \"prepared\", testPlanID, testRollbackToken, \"null\"},\n115|\t\t{\"prepared empty\", \"prepared\", \"null\", \"null\", \"null\"},\n116|\t\t{\"committed without plan\", \"committed\", \"null\", \"null\", testDiscovery},\n117|\t\t{\"committed without discovery\", \"committed\", testPlanID, \"null\", \"null\"},\n118|\t\t{\"committed keeping token\", \"committed\", testPlanID, testRollbackToken, testDiscovery},\n119|\t\t{\"rolled back without plan\", \"rolled_back\", \"null\", \"null\", testDiscovery},\n120|\t\t{\"rolled back without discovery\", \"rolled_back\", testPlanID, \"null\", \"null\"},\n121|\t\t{\"rolled back keeping token\", \"rolled_back\", testPlanID, testRollbackToken, testDiscovery},\n122|\t} {\n123|\t\tt.Run(kase.name, func(t *testing.T) {\n124|\t\t\tbody := statusBody(testMaterializationID, testTransactionID, testAuthorityID, kase.plan, kase.state, kase.token, kase.discover)\n125|\t\t\tif _, err := DecodeStatusOutcome(body, testStatusIDs()); failureCode(t, err) != \"integrity_failure\" {\n126|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n127|\t\t\t}\n128|\t\t})\n129|\t}\n130|}\n131|\n132|// TestDecodeStatusOutcomeRefusesForeignTransactions proves identity\n133|// binding: a status naming another materialization, transaction, or\n134|// authority is not this transaction's durable state.\n135|func TestDecodeStatusOutcomeRefusesForeignTransactions(t *testing.T) {\n136|\tother := \"0198f4c8-aaaa-73aa-9374-1234567890ab\"\n137|\tfor _, kase := range []struct {\n138|\t\tname string\n139|\t\tbody []byte\n140|\t}{\n141|\t\t{\"other materialization\", statusBody(other, testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n142|\t\t{\"other transaction\", statusBody(testMaterializationID, other, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n143|\t\t{\"other authority\", statusBody(testMaterializationID, testTransactionID, \"another_authority\", testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n144|\t\t{\"non-string materialization\", statusBody(\"\", testTransactionID, testAuthorityID, testPlanID, \"prepared\", testRollbackToken, testDiscovery)},\n145|\t} {\n146|\t\tt.Run(kase.name, func(t *testing.T) {\n147|\t\t\tbody := kase.body\n148|\t\t\tif strings.Contains(kase.name, \"non-string\") {\n149|\t\t\t\tbody = []byte(`{\"materialization_id\":7,\"transaction_id\":\"` + testTransactionID + `\",\"transaction_authority_id\":\"` + testAuthorityID + `\",\"plan_id\":\"` + testPlanID + `\",\"state\":\"prepared\",\"rollback_token\":\"` + testRollbackToken + `\",\"native_discovery\":` + testDiscovery + `}`)\n150|\t\t\t}\n151|\t\t\tif _, err := DecodeStatusOutcome(body, testStatusIDs()); failureCode(t, err) != \"integrity_failure\" {\n152|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n153|\t\t\t}\n154|\t\t})\n155|\t}\n156|}\n157|\n158|// TestDecodeStatusOutcomeRefusesMalformedBodies proves uninterpretable\n159|// observations fail closed with integrity_failure rather than as absent\n160|// or partial states.\n161|func TestDecodeStatusOutcomeRefusesMalformedBodies(t *testing.T) {\n162|\tgood := string(preparedBody())\n163|\tfor _, kase := range []struct {\n164|\t\tname string\n165|\t\tbody string\n166|\t}{\n167|\t\t{\"empty\", ``},\n168|\t\t{\"not JSON\", `oops`},\n169|\t\t{\"array\", `[]`},\n170|\t\t{\"scalar\", `1`},\n171|\t\t{\"trailing data\", good + \"x\"},\n172|\t\t{\"duplicate member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"state\":\"committed\"`, 1)},\n173|\t\t{\"unknown member\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":\"prepared\",\"phase\":\"prepared\"`, 1)},\n174|\t\t{\"missing plan\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\",`, ``, 1)},\n175|\t\t{\"missing state\", strings.Replace(good, `,\"state\":\"prepared\"`, ``, 1)},\n176|\t\t{\"bad state\", strings.Replace(good, `\"prepared\"`, `\"preparing\"`, 1)},\n177|\t\t{\"non-string state\", strings.Replace(good, `\"state\":\"prepared\"`, `\"state\":7`, 1)},\n178|\t\t{\"malformed digest\", strings.Replace(good, testPlanID, \"sha256:xyz\", 1)},\n179|\t\t{\"non-string digest\", strings.Replace(good, `\"plan_id\":\"`+testPlanID+`\"`, `\"plan_id\":7`, 1)},\n180|\t\t{\"short token\", strings.Replace(good, testRollbackToken, \"YWJj\", 1)},\n181|\t\t{\"non-base64 token\", strings.Replace(good, testRollbackToken, \"!!!not-base64!!!\", 1)},\n182|\t\t{\"non-string token\", strings.Replace(good, `\"rollback_token\":\"`+testRollbackToken+`\"`, `\"rollback_token\":7`, 1)},\n183|\t\t{\"scalar discovery\", strings.Replace(good, `\"native_discovery\":`+testDiscovery, `\"native_discovery\":7`, 1)},\n184|\t\t{\"malformed operation id\", strings.Replace(good, `\"materialization_id\"`, `\"operation_id\":\"bogus\",\"materialization_id\"`, 1)},\n185|\t} {\n186|\t\tt.Run(kase.name, func(t *testing.T) {\n187|\t\t\tif _, err := DecodeStatusOutcome([]byte(kase.body), testStatusIDs()); failureCode(t, err) != \"integrity_failure\" {\n188|\t\t\t\tt.Fatalf(\"DecodeStatusOutcome code = %v, want integrity_failure\", err)\n189|\t\t\t}\n190|\t\t})\n191|\t}\n192|}\n193|\n194|// TestDecodeStatusOutcomeIgnoresWellFormedOperationID proves a present\n195|// mutation key does not alias the read: status identity is the\n196|// materialization/transaction pair, so a well-formed operation_id is\n197|// accepted and ignored.\n198|func TestDecodeStatusOutcomeIgnoresWellFormedOperationID(t *testing.T) {\n199|\tbody := strings.Replace(string(preparedBody()), `\"materialization_id\"`, `\"operation_id\":\"0198f4c8-e4b0-75cc-9576-1234567890ab\",\"materialization_id\"`, 1)\n200|\tgot, err := DecodeStatusOutcome([]byte(body), testStatusIDs())\n201|\tif err != nil {\n202|\t\tt.Fatalf(\"DecodeStatusOutcome with operation_id: %v\", err)\n203|\t}\n204|\tif got != StatusPrepared {\n205|\t\tt.Fatalf(\"DecodeStatusOutcome = %q, want prepared\", got)\n206|\t}\n207|}\n208|\n209|// TestStatusReadsEvolve proves no byte-identical replay rule applies to\n210|// status observations: the same transaction may report prepared under\n211|// one envelope and committed under the next, and both readings succeed.\n212|func TestStatusReadsEvolve(t *testing.T) {\n213|\tids := testStatusIDs()\n214|\tfirst, err := DecodeStatusOutcome(preparedBody(), ids)\n215|\tif err != nil {\n216|\t\tt.Fatalf(\"first read: %v\", err)\n217|\t}\n218|\tsecond, err := DecodeStatusOutcome(statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery), ids)\n219|\tif err != nil {\n220|\t\tt.Fatalf(\"second read: %v\", err)\n221|\t}\n222|\tif first != StatusPrepared || second != StatusCommitted {\n223|\t\tt.Fatalf(\"evolving reads = %q then %q, want prepared then committed\", first, second)\n224|\t}\n225|}\n226|\n227|// TestStatusRecoveryAcrossProcesses proves the cross-process recovery\n228|// shape over the real entry points: two status Calls start two separate\n229|// processes with frames identical except request_id, and each durable\n230|// observation reconciles independently.\n231|func TestStatusRecoveryAcrossProcesses(t *testing.T) {\n232|\tcommitted := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \"committed\", \"null\", testDiscovery)\n233|\trunner := &scriptRunner{steps: []scriptStep{\n234|\t\tokStep(Result{Stdout: successFrame(t, testRequestID, string(preparedBody())), ExitCode: 0}),\n235|\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(committed)), ExitCode: 0}),\n236|\t}}\n237|\thost := liveHost(runner)\n238|\tfirstReq := liveRequest(t)\n239|\tfirstReq.Operation = OpMaterializeStatus\n240|\tfirstReq.RequestID = mustUUIDv7(t, testRequestID)\n241|\tfirst, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", firstReq)\n242|\tif err != nil {\n243|\t\tt.Fatalf(\"first status Call: %v\", err)\n244|\t}\n245|\tsecondReq := liveRequest(t)\n246|\tsecondReq.Operation = OpMaterializeStatus\n247|\tsecondReq.RequestID = mustUUIDv7(t, testOtherID)\n248|\tsecond, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", secondReq)\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"second status Call: %v\", err)\n251|\t}\n252|\tif runner.spawned() != 2 {\n253|\t\tt.Fatalf(\"two status reads spawned %d processes, want one per read\", runner.spawned())\n254|\t}\n255|\tif firstState, err := DecodeStatusOutcome(first.Body, testStatusIDs()); err != nil || firstState != StatusPrepared {\n256|\t\tt.Fatalf(\"first recovery = %q, %v; want prepared\", firstState, err)\n257|\t}\n258|\tif secondState, err := DecodeStatusOutcome(second.Body, testStatusIDs()); err != nil || secondState != StatusCommitted {\n259|\t\tt.Fatalf(\"second recovery = %q, %v; want committed\", secondState, err)\n260|\t}\n261|}\n262|\n263|// TestLostMutationRecoversThroughStatus proves the lost-prepare shape: a\n264|// mutation Call whose response is lost is followed by a status read, and\n265|// the runner observes exactly one mutation frame — the host never\n266|// re-issues the mutation on its own, so no second destination mutation\n267|// can occur.\n268|func TestLostMutationRecoversThroughStatus(t *testing.T) {\n269|\trunner := &scriptRunner{\n270|\t\tsteps: []scriptStep{\n271|\t\t\tfailStep(context.DeadlineExceeded),\n272|\t\t\tokStep(Result{Stdout: successFrame(t, testOtherID, string(preparedBody())), ExitCode: 0}),\n273|\t\t},\n274|\t}\n275|\t// The runner error above fires with a live deadline, so it is a\n276|\t// transport failure, not a timeout.\n277|\thost := Host{Runner: runner, Now: time.Now}\n278|\tmutation := liveRequest(t)\n279|\tmutation.Operation = OpMaterialize\n280|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", mutation); failureCode(t, err) != \"provider_process_failed\" {\n281|\t\tt.Fatalf(\"lost mutation code = %v, want provider_process_failed\", err)\n282|\t}\n283|\tstatus := liveRequest(t)\n284|\tstatus.Operation = OpMaterializeStatus\n285|\tstatus.RequestID = mustUUIDv7(t, testOtherID)\n286|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", status)\n287|\tif err != nil {\n288|\t\tt.Fatalf(\"status Call: %v\", err)\n289|\t}\n290|\tstate, err := DecodeStatusOutcome(got.Body, testStatusIDs())\n291|\tif err != nil || state != StatusPrepared {\n292|\t\tt.Fatalf(\"recovery = %q, %v; want prepared\", state, err)\n293|\t}\n294|\tif runner.spawned() != 2 {\n295|\t\tt.Fatalf(\"recovery spawned %d processes, want mutation plus one status read\", runner.spawned())\n296|\t}\n297|\tmutations := 0\n298|\tfor _, call := range runner.calls {\n299|\t\tvar decoded struct {\n300|\t\t\tOperation string `json:\"operation\"`\n301|\t\t}\n302|\t\tif err := json.Unmarshal(call.stdin, &decoded); err != nil {\n303|\t\t\tt.Fatalf(\"recorded stdin is not JSON: %v\", err)\n304|\t\t}\n305|\t\tif decoded.Operation == string(OpMaterialize) {\n306|\t\t\tmutations++\n307|\t\t}\n308|\t}\n309|\tif mutations != 1 {\n310|\t\tt.Fatalf(\"runner observed %d mutation frames, want exactly one and no blind retry\", mutations)\n311|\t}\n312|}\n313|\n314|// TestUnknownTransactionQuarantinesThroughCall proves the unknown\n315|// transaction path end to end: a status body of unknown surfaces\n316|// integrity_failure from the composed read, never a status.\n317|func TestUnknownTransactionQuarantinesThroughCall(t *testing.T) {\n318|\tunknown := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \"null\", \"unknown\", \"null\", \"null\")\n319|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: successFrame(t, testRequestID, string(unknown)), ExitCode: 0})}}\n320|\thost := liveHost(runner)\n321|\treq := liveRequest(t)\n322|\treq.Operation = OpMaterializeStatus\n323|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n324|\tif err != nil {\n325|\t\tt.Fatalf(\"status Call: %v\", err)\n326|\t}\n327|\tif state, err := DecodeStatusOutcome(got.Body, testStatusIDs()); failureCode(t, err) != \"integrity_failure\" || state != \"\" {\n328|\t\tt.Fatalf(\"unknown recovery = %q, %v; want no status with integrity_failure\", state, err)\n329|\t}\n330|}"}}}
