{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fd","stream":{"kind":"session","id":"01a06f12-fa6f-76e2-8836-346b2c16c0e2"},"sequence":345,"recorded_at":1780531400000685,"record_type":"event","durability":"durable","causation_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","run_stream":{"kind":"run","id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec"},"task_stream":{"kind":"task","id":"f8e6380a-9ed7-40f4-9fb8-804343ec3f83"},"task_id":"f8e6380a-9ed7-40f4-9fb8-804343ec3f83","event":{"kind":"output","task_id":"f8e6380a-9ed7-40f4-9fb8-804343ec3f83","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/runner_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|)\n17|\n18|// futureDeadline returns a deadline duration ahead of the real clock,\n19|// so Host deadline accounting runs against live time.\n20|func futureDeadline(t *testing.T, ahead time.Duration) scalar.Timestamp {\n21|\tt.Helper()\n22|\tparsed, err := scalar.ParseTimestamp(time.Now().Add(ahead).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n25|\t}\n26|\treturn parsed\n27|}\n28|\n29|// liveRequest is testRequest with a live future deadline for Host calls,\n30|// which enforce the deadline against a real context.\n31|func liveRequest(t *testing.T) Request {\n32|\tt.Helper()\n33|\treq := testRequest(t)\n34|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n35|\treturn req\n36|}\n37|\n38|// liveHost builds a Host on the real clock.\n39|func liveHost(runner *scriptRunner) Host {\n40|\treturn Host{Runner: runner, Now: time.Now}\n41|}\n42|\n43|// scriptCall records one Runner invocation.\n44|type scriptCall struct {\n45|\texecutable string\n46|\tstdin      []byte\n47|}\n48|\n49|// scriptRunner is a scripted Runner: it replays canned results, records\n50|// every invocation, and optionally blocks until the context ends to\n51|// simulate a hung plugin. It proves Host behavior without real processes;\n52|// the ExecRunner integration test below drives the production call site.\n53|// scriptStep is one canned invocation outcome: either a result or a\n54|// transport error, consumed in listed order.\n55|type scriptStep struct {\n56|\tresult Result\n57|\terr    error\n58|}\n59|\n60|func okStep(result Result) scriptStep { return scriptStep{result: result} }\n61|\n62|func failStep(err error) scriptStep { return scriptStep{err: err} }\n63|\n64|type scriptRunner struct {\n65|\tmu    sync.Mutex\n66|\tcalls []scriptCall\n67|\tsteps []scriptStep\n68|\tblock bool\n69|\t// delay sleeps past the request deadline before replaying, so the\n70|\t// runner returns a result after the deadline instead of an error.\n71|\tdelay time.Duration\n72|}\n73|\n74|func (runner *scriptRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n75|\trunner.mu.Lock()\n76|\trunner.calls = append(runner.calls, scriptCall{executable: executable, stdin: append([]byte(nil), stdin...)})\n77|\tindex := len(runner.calls) - 1\n78|\trunner.mu.Unlock()\n79|\tif runner.block {\n80|\t\t<-ctx.Done()\n81|\t\treturn Result{}, ctx.Err()\n82|\t}\n83|\tif runner.delay > 0 {\n84|\t\ttime.Sleep(runner.delay)\n85|\t}\n86|\tif index < len(runner.steps) {\n87|\t\tstep := runner.steps[index]\n88|\t\treturn step.result, step.err\n89|\t}\n90|\treturn Result{}, errors.New(\"script: no step canned\")\n91|}\n92|\n93|func (runner *scriptRunner) spawned() int {\n94|\trunner.mu.Lock()\n95|\tdefer runner.mu.Unlock()\n96|\treturn len(runner.calls)\n97|}\n98|\n99|func successResult(t *testing.T, id, body string) Result {\n100|\tt.Helper()\n101|\treturn Result{Stdout: successFrame(t, id, body), ExitCode: 0}\n102|}\n103|\n104|// TestCallSendsOneFrameToOneProcess proves the dispatch path: the exact\n105|// request frame reaches exactly one process of the named executable.\n106|func TestCallSendsOneFrameToOneProcess(t *testing.T) {\n107|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n108|\thost := liveHost(runner)\n109|\treq := liveRequest(t)\n110|\tgot, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n111|\tif err != nil {\n112|\t\tt.Fatalf(\"Call: %v\", err)\n113|\t}\n114|\tif string(got.Body) != `{\"provider_id\":\"pi\"}` {\n115|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n116|\t}\n117|\tif runner.spawned() != 1 {\n118|\t\tt.Fatalf(\"Call spawned %d processes, want exactly one per operation\", runner.spawned())\n119|\t}\n120|\tcall := runner.calls[0]\n121|\tif call.executable != \"/plugins/ax-provider-pi\" {\n122|\t\tt.Fatalf(\"Call executable = %q\", call.executable)\n123|\t}\n124|\tframe, err := EncodeRequest(req, time.Now())\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n127|\t}\n128|\tif string(call.stdin) != string(frame) {\n129|\t\tt.Fatalf(\"Call stdin = %q, want the single request frame\", call.stdin)\n130|\t}\n131|}\n132|\n133|// TestCallUnknownOperationStartsNoProcess proves dispatch refuses an\n134|// unregistered operation locally: the failure is invalid_config and the\n135|// Runner is never touched.\n136|func TestCallUnknownOperationStartsNoProcess(t *testing.T) {\n137|\trunner := &scriptRunner{}\n138|\thost := liveHost(runner)\n139|\treq := liveRequest(t)\n140|\treq.Operation = \"reboot\"\n141|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); failureCode(t, err) != \"invalid_config\" {\n142|\t\tt.Fatalf(\"Call code = %v, want invalid_config\", err)\n143|\t}\n144|\tif runner.spawned() != 0 {\n145|\t\tt.Fatalf(\"Call spawned %d processes for an unknown operation, want none\", runner.spawned())\n146|\t}\n147|}\n148|\n149|// TestCallNilRunnerRefuses proves a host without a Runner fails closed\n150|// before framing.\n151|func TestCallNilRunnerRefuses(t *testing.T) {\n152|\thost := Host{Now: time.Now}\n153|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); failureCode(t, err) != \"invalid_config\" {\n154|\t\tt.Fatalf(\"Call code = %v, want invalid_config\", err)\n155|\t}\n156|}\n157|\n158|// TestCallUsesSystemClockWhenUnset proves the nil-clock branch: a Host\n159|// without Now enforces live deadlines.\n160|func TestCallUsesSystemClockWhenUnset(t *testing.T) {\n161|\trunner := &scriptRunner{steps: []scriptStep{okStep(successResult(t, testRequestID, `{\"provider_id\":\"pi\"}`))}}\n162|\thost := Host{Runner: runner}\n163|\treq := testRequest(t)\n164|\treq.Deadline = futureDeadline(t, 5*time.Minute)\n165|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); err != nil {\n166|\t\tt.Fatalf(\"Call with unset clock: %v\", err)\n167|\t}\n168|}\n169|\n170|// failingReader always errors, exercising the capped-read failure path.\n171|type failingReader struct{}\n172|\n173|func (failingReader) Read([]byte) (int, error) { return 0, errors.New(\"fake: read failed\") }\n174|\n175|// TestReadCappedReportsStreamErrors proves a stream failure surfaces\n176|// instead of an empty capture.\n177|func TestReadCappedReportsStreamErrors(t *testing.T) {\n178|\tif _, err := readCapped(failingReader{}, 1024); err == nil {\n179|\t\tt.Fatal(\"readCapped swallowed a stream error\")\n180|\t}\n181|}\n182|\n183|// TestCallTimesOutHungPlugin proves the deadline path: a plugin that\n184|// never answers is terminated at the request deadline and reported as\n185|// provider_timeout with exit 13.\n186|func TestCallTimesOutHungPlugin(t *testing.T) {\n187|\trunner := &scriptRunner{block: true}\n188|\thost := liveHost(runner)\n189|\treq := liveRequest(t)\n190|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n191|\tstart := time.Now()\n192|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req)\n193|\tif elapsed := time.Since(start); elapsed > 10*time.Second {\n194|\t\tt.Fatalf(\"Call took %v, want deadline enforcement near 100ms\", elapsed)\n195|\t}\n196|\tif failureCode(t, err) != \"provider_timeout\" {\n197|\t\tt.Fatalf(\"Call code = %v, want provider_timeout\", err)\n198|\t}\n199|\tif failureExit(t, err) != 13 {\n200|\t\tt.Fatalf(\"Call exit = %d, want 13\", failureExit(t, err))\n201|\t}\n202|}\n203|\n204|// TestCallEmptyResultAfterDeadlineIsTimeout proves the late-empty\n205|// path: a runner that answers with nothing after the deadline still\n206|// reports provider_timeout, even though the process exited on its own.\n207|func TestCallEmptyResultAfterDeadlineIsTimeout(t *testing.T) {\n208|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: 1})}, delay: 400 * time.Millisecond}\n209|\thost := liveHost(runner)\n210|\treq := liveRequest(t)\n211|\treq.Deadline = futureDeadline(t, 150*time.Millisecond)\n212|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", req); failureCode(t, err) != \"provider_timeout\" {\n213|\t\tt.Fatalf(\"Call code = %v, want provider_timeout\", err)\n214|\t}\n215|}\n216|\n217|// TestCallRunnerErrorBeforeDeadlineIsProcessFailure proves a transport\n218|// failure with time remaining is provider_process_failed, not a timeout.\n219|func TestCallRunnerErrorBeforeDeadlineIsProcessFailure(t *testing.T) {\n220|\trunner := &scriptRunner{steps: []scriptStep{failStep(errors.New(\"fake: fork failed\"))}}\n221|\thost := liveHost(runner)\n222|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); failureCode(t, err) != \"provider_process_failed\" {\n223|\t\tt.Fatalf(\"Call code = %v, want provider_process_failed\", err)\n224|\t}\n225|}\n226|\n227|// TestCallParentCancelIsNotTimeout proves a caller abort with time\n228|// remaining is provider_process_failed: the deadline never passed, so no\n229|// timeout may be claimed.\n230|func TestCallParentCancelIsNotTimeout(t *testing.T) {\n231|\trunner := &scriptRunner{block: true}\n232|\thost := liveHost(runner)\n233|\tctx, cancel := context.WithCancel(context.Background())\n234|\tcancel()\n235|\t_, err := host.Call(ctx, \"/plugins/ax-provider-pi\", liveRequest(t))\n236|\tif failureCode(t, err) != \"provider_process_failed\" {\n237|\t\tt.Fatalf(\"Call code = %v, want provider_process_failed\", err)\n238|\t}\n239|}\n240|\n241|// TestCallMissingResponse proves an empty stdout is a missing response:\n242|// provider_process_failed on a crash exit, provider_protocol_error when\n243|// the plugin claimed success by exiting 0.\n244|func TestCallMissingResponse(t *testing.T) {\n245|\tfor _, kase := range []struct {\n246|\t\tname string\n247|\t\tcode int\n248|\t\twant string\n249|\t}{\n250|\t\t{\"crash exit\", 3, \"provider_process_failed\"},\n251|\t\t{\"signal-like exit\", 137, \"provider_process_failed\"},\n252|\t\t{\"clean exit\", 0, \"provider_protocol_error\"},\n253|\t} {\n254|\t\tt.Run(kase.name, func(t *testing.T) {\n255|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{ExitCode: kase.code})}}\n256|\t\t\thost := liveHost(runner)\n257|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n258|\t\t\tif failureCode(t, err) != axerror.Code(kase.want) {\n259|\t\t\t\tt.Fatalf(\"Call code = %v, want %s\", err, kase.want)\n260|\t\t\t}\n261|\t\t})\n262|\t}\n263|}\n264|\n265|// TestCallRefusesUnusableStdout proves crashes, garbage, and\n266|// correlation breaks map to the Section 7.2 host-failure classes. The\n267|// production entry point is Host.Call.\n268|func TestCallRefusesUnusableStdout(t *testing.T) {\n269|\tfor _, kase := range []struct {\n270|\t\tname   string\n271|\t\tresult Result\n272|\t\twant   string\n273|\t}{\n274|\t\t{\"garbage\", Result{Stdout: []byte(\"not json\\n\"), Stderr: []byte(\"traceback\\n\"), ExitCode: 1}, \"provider_protocol_error\"},\n275|\t\t{\"crash no output\", Result{ExitCode: 1}, \"provider_process_failed\"},\n276|\t\t{\"wrong request id\", Result{Stdout: successFrame(t, testOtherID, `{}`), ExitCode: 0}, \"provider_protocol_error\"},\n277|\t\t{\"extra line\", Result{Stdout: append(successFrame(t, testRequestID, `{}`), '\\n', 'x', '\\n'), ExitCode: 0}, \"provider_protocol_error\"},\n278|\t\t{\"foreign major\", Result{Stdout: []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"3.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), ExitCode: 0}, \"incompatible_protocol\"},\n279|\t} {\n280|\t\tt.Run(kase.name, func(t *testing.T) {\n281|\t\t\trunner := &scriptRunner{steps: []scriptStep{okStep(kase.result)}}\n282|\t\t\thost := liveHost(runner)\n283|\t\t\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n284|\t\t\tif failureCode(t, err) != axerror.Code(kase.want) {\n285|\t\t\t\tt.Fatalf(\"Call code = %v, want %s\", err, kase.want)\n286|\t\t\t}\n287|\t\t})\n288|\t}\n289|}\n290|\n291|// TestCallSeparatesStderr proves stdout/stderr separation two ways: a\n292|// valid frame succeeds despite noisy diagnostics, and a failing\n293|// invocation never carries stderr content in its human text.\n294|func TestCallSeparatesStderr(t *testing.T) {\n295|\tsecret := \"[REDACTED]\"\n296|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{\n297|\t\tStdout:   successFrame(t, testRequestID, `{\"provider_id\":\"pi\"}`),\n298|\t\tStderr:   []byte(\"diagnostic: using \" + secret + \"\\n\"),\n299|\t\tExitCode: 0,\n300|\t})}}\n301|\thost := liveHost(runner)\n302|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t)); err != nil {\n303|\t\tt.Fatalf(\"Call with stderr diagnostics: %v\", err)\n304|\t}\n305|\n306|\tbad := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: []byte(\"garbage\\n\"), Stderr: []byte(secret + \"\\n\"), ExitCode: 1})}}\n307|\thost = liveHost(bad)\n308|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n309|\tif failureCode(t, err) != \"provider_protocol_error\" {\n310|\t\tt.Fatalf(\"Call code = %v, want provider_protocol_error\", err)\n311|\t}\n312|\tif strings.Contains(err.Error(), secret) {\n313|\t\tt.Fatalf(\"stderr content leaked into the failure text: %v\", err)\n314|\t}\n315|}\n316|\n317|// TestCallOversizeStdoutRefuses proves a first line one byte over 8 MiB\n318|// fails as provider_protocol_error through the full Call path.\n319|func TestCallOversizeStdoutRefuses(t *testing.T) {\n320|\tpad := strings.Repeat(\"a\", specFrameLimitBytes)\n321|\tframe := successFrame(t, testRequestID, `{\"pad\":\"`+pad+`\"}`)\n322|\tif len(frame) <= specFrameLimitBytes {\n323|\t\tt.Fatalf(\"oversize stdout is %d bytes, want over %d\", len(frame), specFrameLimitBytes)\n324|\t}\n325|\trunner := &scriptRunner{steps: []scriptStep{okStep(Result{Stdout: frame, ExitCode: 0})}}\n326|\thost := liveHost(runner)\n327|\t_, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", liveRequest(t))\n328|\tif failureCode(t, err) != \"provider_protocol_error\" {\n329|\t\tt.Fatalf(\"Call code = %v, want provider_protocol_error\", err)\n330|\t}\n331|}\n332|\n333|// TestCallOneProcessPerCall proves the single-flight cross-process\n334|// property: two calls start two processes with distinct request IDs.\n335|func TestCallOneProcessPerCall(t *testing.T) {\n336|\trunner := &scriptRunner{steps: []scriptStep{\n337|\t\tokStep(successResult(t, testRequestID, `{}`)),\n338|\t\tokStep(successResult(t, testOtherID, `{}`)),\n339|\t}}\n340|\thost := liveHost(runner)\n341|\tfirst := liveRequest(t)\n342|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", first); err != nil {\n343|\t\tt.Fatalf(\"first Call: %v\", err)\n344|\t}\n345|\tsecond := liveRequest(t)\n346|\tsecond.RequestID = mustUUIDv7(t, testOtherID)\n347|\tif _, err := host.Call(context.Background(), \"/plugins/ax-provider-pi\", second); err != nil {\n348|\t\tt.Fatalf(\"second Call: %v\", err)\n349|\t}\n350|\tif runner.spawned() != 2 {\n351|\t\tt.Fatalf(\"two Calls spawned %d processes, want one per operation\", runner.spawned())\n352|\t}\n353|\tif string(runner.calls[0].stdin) == string(runner.calls[1].stdin) {\n354|\t\tt.Fatal(\"successive calls sent byte-identical frames; request IDs must differ\")\n355|\t}\n356|}\n357|\n358|// TestExecRunnerEchoRoundTrip drives the production call site end to\n359|// end: a real plugin script receives the frame on stdin and answers on\n360|// stdout while logging diagnostics to stderr.\n361|func TestExecRunnerEchoRoundTrip(t *testing.T) {\n362|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n363|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n364|\t}\n365|\troot := t.TempDir()\n366|\tscript := filepath.Join(root, \"ax-provider-echo\")\n367|\tplugin := `#!/bin/sh\n368|echo \"diagnostic: starting\" >&2\n369|frame=$(cat)\n370|id=$(printf '%s' \"$frame\" | sed 's/.*\"request_id\":\"\\([^\"]*\\)\".*/\\1/')\n371|printf '{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"%s\",\"ok\":true,\"body\":{\"provider_id\":\"echo\"}}' \"$id\"\n372|exit 0\n373|`\n374|\tif err := os.WriteFile(script, []byte(plugin), 0o700); err != nil {\n375|\t\tt.Fatalf(\"WriteFile: %v\", err)\n376|\t}\n377|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n378|\tgot, err := host.Call(context.Background(), script, liveRequest(t))\n379|\tif err != nil {\n380|\t\tt.Fatalf(\"Call through ExecRunner: %v\", err)\n381|\t}\n382|\tif string(got.Body) != `{\"provider_id\":\"echo\"}` {\n383|\t\tt.Fatalf(\"Call body = %s\", got.Body)\n384|\t}\n385|}\n386|\n387|// TestExecRunnerEnforcesDeadline drives the production kill path: a\n388|// plugin that sleeps past the deadline is terminated and reported as\n389|// provider_timeout.\n390|func TestExecRunnerEnforcesDeadline(t *testing.T) {\n391|\tif _, err := exec.LookPath(\"sh\"); err != nil {\n392|\t\tt.Skip(\"no sh on PATH; cannot run the production runner\")\n393|\t}\n394|\tscript := filepath.Join(t.TempDir(), \"ax-provider-sleep\")\n395|\tif err := os.WriteFile(script, []byte(\"#!/bin/sh\\nsleep 30\\n\"), 0o700); err != nil {\n396|\t\tt.Fatalf(\"WriteFile: %v\", err)\n397|\t}\n398|\thost := Host{Runner: ExecRunner{}, Now: time.Now}\n399|\treq := liveRequest(t)\n400|\tstamp, err := scalar.ParseTimestamp(time.Now().Add(300 * time.Millisecond).UTC().Format(\"2006-01-02T15:04:05.000Z\"))\n401|\tif err != nil {\n402|\t\tt.Fatalf(\"ParseTimestamp: %v\", err)\n403|\t}\n404|\treq.Deadline = stamp\n405|\tstart := time.Now()\n406|\t_, err = host.Call(context.Background(), script, req)\n407|\telapsed := time.Since(start)\n408|\tif elapsed > 20*time.Second {\n409|\t\tt.Fatalf(\"Call took %v, want termination near the deadline\", elapsed)\n410|\t}\n411|\t// The script sleeps as a child of sh, so a parent-only kill would\n412|\t// leave it holding the pipes until WaitDelay (2s) expires. Returning\n413|\t// near the 300ms deadline proves the whole process group died.\n414|\tif elapsed >= waitDrainDelay {\n415|\t\tt.Fatalf(\"Call took %v, want group termination well before the %v drain delay\", elapsed, waitDrainDelay)\n416|\t}\n417|\tif failureCode(t, err) != \"provider_timeout\" {\n418|\t\tt.Fatalf(\"Call code = %v, want provider_timeout\", err)\n419|\t}\n420|}"}}}
