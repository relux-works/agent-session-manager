{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57f","stream":{"kind":"session","id":"01a06f12-fa6f-76e2-8836-346b2c16c0e2"},"sequence":282,"recorded_at":1780531400000559,"record_type":"event","durability":"durable","causation_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec","run_stream":{"kind":"run","id":"442e1aa4-e9ef-4d3f-b619-88e6c26afaec"},"task_stream":{"kind":"task","id":"d35596e3-217b-4863-b02f-8a1bcf697631"},"task_id":"d35596e3-217b-4863-b02f-8a1bcf697631","event":{"kind":"output","task_id":"d35596e3-217b-4863-b02f-8a1bcf697631","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-3jqsx1/worktree/internal/provhost/status.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/base64\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// StatusState is the reconciled durable state of a materialization\n11|// transaction. Unknown is fail-closed: the host must quarantine the\n12|// transaction root rather than infer prepare or commit.\n13|type StatusState string\n14|\n15|// ProviderTransactionStatus states Section 7.5 defines.\n16|const (\n17|\tStatusUnknown    StatusState = \"unknown\"\n18|\tStatusPrepared   StatusState = \"prepared\"\n19|\tStatusCommitted  StatusState = \"committed\"\n20|\tStatusRolledBack StatusState = \"rolled_back\"\n21|)\n22|\n23|// validStatusState reports whether the state is a registry member.\n24|func validStatusState(state string) bool {\n25|\tswitch StatusState(state) {\n26|\tcase StatusUnknown, StatusPrepared, StatusCommitted, StatusRolledBack:\n27|\t\treturn true\n28|\t}\n29|\treturn false\n30|}\n31|\n32|// StatusIDs identifies the transaction a status read must describe: the\n33|// caller-supplied materialization and transaction IDs and the exact\n34|// transaction authority the request located it through. A status naming\n35|// any other transaction is not this transaction's durable state.\n36|type StatusIDs struct {\n37|\tMaterializationID      string\n38|\tTransactionID          string\n39|\tTransactionAuthorityID string\n40|}\n41|\n42|// statusBodyMembers is the exact member set DecodeStatusOutcome accepts:\n43|// the ProviderTransactionStatus row of Section 7.5, where operation_id is\n44|// the mutation key the status request omits. A well-formed operation_id is\n45|// ignored — it is not this read's identity — but a malformed one makes\n46|// the observation integrity-invalid, as does any unknown member.\n47|var statusBodyMembers = map[string]bool{\n48|\t\"operation_id\":             true,\n49|\t\"materialization_id\":       true,\n50|\t\"transaction_id\":           true,\n51|\t\"transaction_authority_id\": true,\n52|\t\"plan_id\":                  true,\n53|\t\"state\":                    true,\n54|\t\"rollback_token\":           true,\n55|\t\"native_discovery\":         true,\n56|}\n57|\n58|// DecodeStatusOutcome reconciles one materialize-status success body to\n59|// the current durable state. It enforces the Section 7.5 recovery rules:\n60|// unknown requires null plan, token, and discovery; prepared requires all\n61|// three non-null; committed and rolled_back require a non-null plan and\n62|// discovery with a null token. Identity members must equal the requested\n63|// transaction.\n64|//\n65|// Every uninterpretable observation fails with integrity_failure,\n66|// including a state of unknown: the caller must quarantine the\n67|// transaction root and must not infer success. Status reads are evolving\n68|// observations, so no byte-identical replay rule applies: the same\n69|// transaction may report prepared under one envelope request_id and\n70|// committed under the next, and both readings are returned as-is.\n71|//\n72|// Only the charset and length of a rollback token are checked here (at\n73|// least 256 bits of base64url); its entropy is not observable. The shapes\n74|// of native_discovery and plan contents belong to the operation layer.\n75|func DecodeStatusOutcome(body []byte, want StatusIDs) (StatusState, error) {\n76|\tintegrity := func(detail string, state string) (StatusState, error) {\n77|\t\tfailure, err := failIntegrity(detail, state, want.MaterializationID, want.TransactionID)\n78|\t\tif err != nil {\n79|\t\t\treturn \"\", err\n80|\t\t}\n81|\t\treturn \"\", failure\n82|\t}\n83|\tmembers, fault := decodeStrictObject(body)\n84|\tif fault != nil {\n85|\t\treturn integrity(\"status body is \"+fault.detail, \"\")\n86|\t}\n87|\tfor name := range members {\n88|\t\tif !statusBodyMembers[name] {\n89|\t\t\treturn integrity(\"status body carries unknown member\", \"\")\n90|\t\t}\n91|\t}\n92|\tfor _, name := range []string{\"materialization_id\", \"transaction_id\", \"transaction_authority_id\", \"plan_id\", \"state\", \"rollback_token\", \"native_discovery\"} {\n93|\t\tif _, present := members[name]; !present {\n94|\t\t\treturn integrity(\"status body misses a required member\", \"\")\n95|\t\t}\n96|\t}\n97|\tstringMember := func(name string) (string, bool) {\n98|\t\tvar value string\n99|\t\tif err := json.Unmarshal(members[name], &value); err != nil {\n100|\t\t\treturn \"\", false\n101|\t\t}\n102|\t\treturn value, true\n103|\t}\n104|\tmaterializationID, ok := stringMember(\"materialization_id\")\n105|\tif !ok || materializationID != want.MaterializationID {\n106|\t\treturn integrity(\"status names another materialization\", \"\")\n107|\t}\n108|\ttransactionID, ok := stringMember(\"transaction_id\")\n109|\tif !ok || transactionID != want.TransactionID {\n110|\t\treturn integrity(\"status names another transaction\", \"\")\n111|\t}\n112|\tauthorityID, ok := stringMember(\"transaction_authority_id\")\n113|\tif !ok || authorityID != want.TransactionAuthorityID {\n114|\t\treturn integrity(\"status names another transaction authority\", \"\")\n115|\t}\n116|\tif raw, present := members[\"operation_id\"]; present {\n117|\t\tvar operationID string\n118|\t\tif err := json.Unmarshal(raw, &operationID); err != nil {\n119|\t\t\treturn integrity(\"status operation_id is not a string\", \"\")\n120|\t\t}\n121|\t\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n122|\t\t\treturn integrity(\"status operation_id is not a UUIDv7\", \"\")\n123|\t\t}\n124|\t}\n125|\tstate, ok := stringMember(\"state\")\n126|\tif !ok || !validStatusState(state) {\n127|\t\treturn integrity(\"status state is not a registry member\", \"\")\n128|\t}\n129|\tplanNull := isNull(members[\"plan_id\"])\n130|\ttokenNull := isNull(members[\"rollback_token\"])\n131|\tdiscoveryNull := isNull(members[\"native_discovery\"])\n132|\tif !planNull {\n133|\t\tvar digest string\n134|\t\tif err := json.Unmarshal(members[\"plan_id\"], &digest); err != nil {\n135|\t\t\treturn integrity(\"status plan_id is not a string\", state)\n136|\t\t}\n137|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n138|\t\t\treturn integrity(\"status plan_id is not a digest\", state)\n139|\t\t}\n140|\t}\n141|\tif !tokenNull {\n142|\t\tvar token string\n143|\t\tif err := json.Unmarshal(members[\"rollback_token\"], &token); err != nil {\n144|\t\t\treturn integrity(\"status rollback_token is not a string\", state)\n145|\t\t}\n146|\t\traw, err := base64.RawURLEncoding.DecodeString(token)\n147|\t\tif err != nil || len(raw) < 32 {\n148|\t\t\treturn integrity(\"status rollback_token is shorter than 256 bits\", state)\n149|\t\t}\n150|\t}\n151|\tif !discoveryNull && !isJSONObject(members[\"native_discovery\"]) {\n152|\t\treturn integrity(\"status native_discovery is not an object\", state)\n153|\t}\n154|\tswitch StatusState(state) {\n155|\tcase StatusUnknown:\n156|\t\t// Unknown is not a usable state: whether or not the\n157|\t\t// nullability shape holds, the host must fail closed and\n158|\t\t// quarantine the transaction root rather than infer prepare\n159|\t\t// or commit. The shape violation names its own rule; a\n160|\t\t// well-shaped unknown still refuses as unknown.\n161|\t\tif !planNull || !tokenNull || !discoveryNull {\n162|\t\t\treturn integrity(\"unknown status carries plan, token, or discovery\", state)\n163|\t\t}\n164|\t\treturn integrity(\"transaction state is unknown\", state)\n165|\tcase StatusPrepared:\n166|\t\tif planNull || tokenNull || discoveryNull {\n167|\t\t\treturn integrity(\"prepared status misses plan, token, or discovery\", state)\n168|\t\t}\n169|\tcase StatusCommitted, StatusRolledBack:\n170|\t\tif planNull || discoveryNull || !tokenNull {\n171|\t\t\treturn integrity(\"terminal status misses plan or discovery or keeps a token\", state)\n172|\t\t}\n173|\t}\n174|\treturn StatusState(state), nil\n175|}\n176|\n177|// isNull reports whether the raw member is a JSON null literal.\n178|func isNull(raw json.RawMessage) bool {\n179|\treturn string(raw) == \"null\"\n180|}"}}}
