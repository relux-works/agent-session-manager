{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdcb","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":1344,"recorded_at":1780531400002683,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"1cbe5b46-8863-454b-b5a5-3d71fe791d7f"},"task_id":"1cbe5b46-8863-454b-b5a5-3d71fe791d7f","event":{"kind":"output","task_id":"1cbe5b46-8863-454b-b5a5-3d71fe791d7f","chunk":"{\n  \"chunk_id\": \"exec-46-1\",\n  \"command\": \"sed -n '118,205p' internal/axerror/details.go\",\n  \"description\": \"Check detail value constraints\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"func ValidateDetails(details Details) error {\\n\\tif details == nil {\\n\\t\\treturn fmt.Errorf(\\\"%w: details is required and must not be null\\\", ErrInvalidDetails)\\n\\t}\\n\\tif len(details) > maxDetailKeys {\\n\\t\\treturn fmt.Errorf(\\\"%w: %d keys exceed the maximum of %d\\\", ErrInvalidDetails, len(details), maxDetailKeys)\\n\\t}\\n\\tfor _, key := range sortedKeys(details) {\\n\\t\\tif !detailKeyPattern.MatchString(key) {\\n\\t\\t\\treturn fmt.Errorf(\\\"%w: key %q does not match [a-z][a-z0-9_]{0,63}\\\", ErrInvalidDetails, key)\\n\\t\\t}\\n\\t\\tif err := refuseExcludedKey(key); err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\tif err := validateDetailValue(key, details[key], 0); err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t}\\n\\tmeasured, err := canonicaljson.CanonicalByteLength(map[string]any(details))\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"%w: measure canonical details: %v\\\", ErrInvalidDetails, err)\\n\\t}\\n\\tif measured > maxDetailCanonical {\\n\\t\\treturn fmt.Errorf(\\n\\t\\t\\t\\\"%w: canonical details are %d bytes, maximum is %d\\\", ErrInvalidDetails, measured, maxDetailCanonical)\\n\\t}\\n\\treturn nil\\n}\\n\\nfunc refuseExcludedKey(key string) error {\\n\\tif class, excluded := excludedDetailKeys[key]; excluded {\\n\\t\\treturn fmt.Errorf(\\\"%w: key %q names %s, which no detail may contain\\\", ErrInvalidDetails, key, class)\\n\\t}\\n\\treturn nil\\n}\\n\\nfunc validateDetailValue(key string, value any, depth int) error {\\n\\tswitch typed := value.(type) {\\n\\tcase nil, bool, json.Number:\\n\\t\\treturn nil\\n\\tcase string:\\n\\t\\tif !utf8.ValidString(typed) {\\n\\t\\t\\treturn fmt.Errorf(\\\"%w: details[%q] contains invalid UTF-8\\\", ErrInvalidDetails, key)\\n\\t\\t}\\n\\t\\treturn nil\\n\\tcase []any:\\n\\t\\tif depth == maxDetailDepth {\\n\\t\\t\\treturn fmt.Errorf(\\\"%w: details[%q] exceeds maximum nesting depth %d\\\", ErrInvalidDetails, key, maxDetailDepth)\\n\\t\\t}\\n\\t\\tfor _, member := range typed {\\n\\t\\t\\tif err := validateDetailValue(key, member, depth+1); err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn nil\\n\\tcase map[string]any:\\n\\t\\tif depth == maxDetailDepth {\\n\\t\\t\\treturn fmt.Errorf(\\\"%w: details[%q] exceeds maximum nesting depth %d\\\", ErrInvalidDetails, key, maxDetailDepth)\\n\\t\\t}\\n\\t\\tfor _, nested := range sortedKeys(typed) {\\n\\t\\t\\tif !utf8.ValidString(nested) {\\n\\t\\t\\t\\treturn fmt.Errorf(\\\"%w: details[%q] has an object key that is not valid UTF-8\\\", ErrInvalidDetails, key)\\n\\t\\t\\t}\\n\\t\\t\\tif err := refuseExcludedKey(nested); err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\tif err := validateDetailValue(key, typed[nested], depth+1); err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn nil\\n\\tdefault:\\n\\t\\treturn fmt.Errorf(\\\"%w: details[%q] uses unsupported JSON type %T\\\", ErrInvalidDetails, key, value)\\n\\t}\\n}\\n\\n// refuseCausalLeak refuses human text or diagnostic values that reproduce the\\n// rendered text of the local cause verbatim. It exists because the ordinary way\\n// to lose a secret is fmt.Errorf(\\\"...: %v\\\", err) on a cause that wrapped a\\n// command line, a transport payload, or a provider's stderr.\\n//\\n// What it decides is narrow and stated: verbatim containment of the whole\\n// rendered cause, and of each of its wrapped links. A paraphrase, a truncation,\\n// or a single extracted field of the cause is not detected. Causes shorter than\\n// minRedactableCause characters are skipped, because a cause rendering as\\n// \\\"EOF\\\" would otherwise refuse every message containing that substring.\\nfunc refuseCausalLeak(message string, details Details, cause error) error {\\n\\tfor _, rendered := range causeChainText(cause) {\\n\",\n  \"original_output_bytes\": 3291,\n  \"original_output_tokens\": 823,\n  \"truncated\": false\n}"}}}
