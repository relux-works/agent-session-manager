\\{Runner: runner, Now: func\\\\(\\\\) time\\\\.Time \\\\{ return mustInstant\\\\(t, testNow\\\\) \\\\}\\\\}', 'host := liveHost(runner)', s)\\ns = re.sub(r'host = Host\\\\{Runner: bad, Now: func\\\\(\\\\) time\\\\.Time \\\\{ return mustInstant\\\\(t, testNow\\\\) \\\\}\\\\}', 'host = liveHost(bad)', s)\\ns = s.replace('frame, err := EncodeRequest(req, mustInstant(t, testNow))', 'frame, err := EncodeRequest(req, time.Now())')\\ns = s.replace('if string(call.stdin) != string(frame)+\\\"\\\\\\\\n\\\" {', 'if string(call.stdin) != string(frame) {')\\n# swap testRequest(t) -> liveRequest(t) for Call inputs in this file only for req := / liveRequest usages\\ns = s.replace('req := testRequest(t)\\\\n', 'req := liveRequest(t)\\\\n')\\ns = s.replace('first := testRequest(t)', 'first := liveRequest(t)')\\ns = s.replace('second := testRequest(t)', 'second := liveRequest(t)')\\ns = s.replace('if _, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", testRequest(t)); failureCode(t, err) != \\\"invalid_config\\\" {',\\n              'if _, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", liveRequest(t)); failureCode(t, err) != \\\"invalid_config\\\" {')\\nopen(p, 'w').write(s)\\nprint(\\\"ok\\\")\\nEOF\\ngrep -n \\\"testRequest(t)\\\\|mustInstant(t, testNow)\\\" internal/provhost/runner_test.go | head -20\",\n  \"description\": \"Switch runner tests to live clock\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ok\\n138:\\thost := Host{Now: func() time.Time { return mustInstant(t, testNow) }}\\n170:\\tif _, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", testRequest(t)); failureCode(t, err) != \\\"provider_process_failed\\\" {\\n183:\\t_, err := host.Call(ctx, \\\"/plugins/ax-provider-pi\\\", testRequest(t))\\n205:\\t\\t\\t_, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", testRequest(t))\\n231:\\t\\t\\t_, err := host.Call(context.Background(), \\\"/plugins/a