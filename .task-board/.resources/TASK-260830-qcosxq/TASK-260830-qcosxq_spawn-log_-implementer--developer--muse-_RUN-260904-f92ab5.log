{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb67","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":1038,"recorded_at":1780531400002071,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"7750e08a-244d-40e4-9fbf-2e168cee726a"},"task_id":"7750e08a-244d-40e4-9fbf-2e168cee726a","event":{"kind":"output","task_id":"7750e08a-244d-40e4-9fbf-2e168cee726a","chunk":"Read text file `internal/provider/os_test.go`.\n(249 line(s) above)\n250|\t\tt.Fatalf(\"code = %q, want local_precondition_failed\", code)\n251|\t}\n252|\tif detail := errorDetail(t, err); !strings.Contains(detail, \"cannot list\") {\n253|\t\tt.Fatalf(\"detail does not name the list refusal: %q\", detail)\n254|\t}\n255|}\n256|\n257|// TestOSSystemInspectReportsStatFailure proves Inspect propagates a stat\n258|// failure instead of fabricating a regular-file fact for a missing target.\n259|func TestOSSystemInspectReportsStatFailure(t *testing.T) {\n260|\tabsent := filepath.Join(t.TempDir(), \"definitely-absent\")\n261|\tif info, err := (OSSystem{}).Inspect(absent); err == nil {\n262|\t\tt.Fatalf(\"Inspect(%q) = %+v, nil; want a failure, never a fabricated fact\", absent, info)\n263|\t}\n264|}\n265|\n266|// TestOSSystemInspectReportsAttestationFailure forces the owner-attestation\n267|// failure path through the production Inspect: attestation reports the\n268|// error instead of a uid-0 fact.\n269|func TestOSSystemInspectReportsAttestationFailure(t *testing.T) {\n270|\tboom := errors.New(\"fake: ownership metadata unavailable\")\n271|\toriginal := ownerAttester\n272|\townerAttester = func(os.FileInfo) (uint32, error) { return 0, boom }\n273|\tdefer func() { ownerAttester = original }()\n274|\n275|\ttarget := writeExecutable(t, t.TempDir(), \"tool\", []byte(\"x\"))\n276|\tif info, err := (OSSystem{}).Inspect(target); err == nil {\n277|\t\tt.Fatalf(\"Inspect attested %+v, nil on attestation failure; want the failure, never uid 0\", info)\n278|\t} else if !errors.Is(err, boom) {\n279|\t\tt.Fatalf(\"Inspect error = %v, want the attestation cause %v\", err, boom)\n280|\t}\n281|}\n282|\n283|// unattestedFileInfo is an os.FileInfo with no ownership metadata: Sys\n284|// returns nil, which the unix seam must refuse rather than attest as uid 0.\n285|type unattestedFileInfo struct{}\n286|\n287|func (unattestedFileInfo) Name() string       { return \"unattested\" }\n288|func (unattestedFileInfo) Size() int64        { return 1 }\n289|func (unattestedFileInfo) Mode() os.FileMode  { return 0o700 }\n290|func (unattestedFileInfo) ModTime() time.Time { return time.Time{} }\n291|func (unattestedFileInfo) IsDir() bool        { return false }\n292|func (unattestedFileInfo) Sys() any           { return nil }\n293|\n294|// TestFileOwnerUIDRefusesWithoutMetadata proves the attestation seam fails\n295|// closed when ownership metadata is unavailable, against its own doc\n296|// comment: the host refuses trust rather than treating an unknown owner\n297|// as approved. The forward control attests a real stat result first, so\n298|// the refusal is attributed to the missing metadata, not to a broken seam.\n299|func TestFileOwnerUIDRefusesWithoutMetadata(t *testing.T) {\n300|\ttarget := writeExecutable(t, t.TempDir(), \"tool\", []byte(\"x\"))\n301|\tinfo, err := os.Stat(target)\n302|\tif err != nil {\n303|\t\tt.Fatalf(\"Stat: %v\", err)\n304|\t}\n305|\tuid, err := fileOwnerUID(info)\n306|\tif err != nil {\n307|\t\tt.Fatalf(\"fileOwnerUID of a real stat result: %v\", err)\n308|\t}\n309|\tif uid != uint32(os.Geteuid()) {\n310|\t\tt.Fatalf(\"fileOwnerUID = %d, want effective uid %d\", uid, os.Geteuid())\n311|\t}\n312|\tif uid, err := fileOwnerUID(unattestedFileInfo{}); err == nil {\n313|\t\tt.Fatalf(\"fileOwnerUID attested uid %d without metadata; want refusal, never uid 0\", uid)\n314|\t}\n315|}\n316|\n317|// TestCurrentOperatorPolicySeedsNoAdministrator proves the policy\n318|// construction site carries no administrator wildcard: the operator alone\n319|// is trusted, against the doc comment's \"no additional\n320|// administrator-approved identities\".\n321|func TestCurrentOperatorPolicySeedsNoAdministrator(t *testing.T) {\n322|\tpolicy := CurrentOperatorPolicy()\n323|\tif policy.OperatorUID != uint32(os.Geteuid()) {\n324|\t\tt.Fatalf(\"OperatorUID = %d, want effective uid %d\", policy.OperatorUID, os.Geteuid())\n325|\t}\n326|\tif len(policy.AdministratorUIDs) != 0 {\n327|\t\tt.Fatalf(\"AdministratorUIDs = %v, want no additional administrator-approved identities\", policy.AdministratorUIDs)\n328|\t}\n329|}\n330|\n331|// TestOSSystemPathDirsSkipsEmptyEntries proves the PATH seam drops empty\n332|// entries instead of admitting an empty directory that Canonicalize would\n333|// resolve against the process working directory.\n334|func TestOSSystemPathDirsSkipsEmptyEntries(t *testing.T) {\n335|\tt.Setenv(\"PATH\", string(os.PathListSeparator)+\"/a\"+string(os.PathListSeparator)+string(os.PathListSeparator)+\"/b\"+string(os.PathListSeparator))\n336|\tgot := (OSSystem{}).PathDirs()\n337|\tfor _, dir := range got {\n338|\t\tif dir == \"\" {\n339|\t\t\tt.Fatalf(\"PathDirs kept an empty entry in %v\", got)\n340|\t\t}\n341|\t}\n342|\tif len(got) != 2 || got[0] != \"/a\" || got[1] != \"/b\" {\n343|\t\tt.Fatalf(\"PathDirs = %v, want [/a /b] in listed order\", got)\n344|\t}\n345|\tt.Setenv(\"PATH\", \"\")\n346|\tif got := (OSSystem{}).PathDirs(); got != nil {\n347|\t\tt.Fatalf(\"PathDirs of an empty PATH = %v, want nil\", got)\n348|\t}\n349|}\n350|\n351|// TestOSSystemPATHDiscovery drives the PATH source through the production\n352|// seam with an isolated PATH: discovery finds the tool when allowed,\n353|// ignores PATH when disallowed, and refuses duplicates across PATH\n354|// directories.\n355|func TestOSSystemPATHDiscovery(t *testing.T) {\n356|\troot, err := filepath.EvalSymlinks(t.TempDir())\n357|\tif err != nil {\n358|\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n359|\t}\n360|\tfirst := filepath.Join(root, \"bin1\")\n361|\tsecond := filepath.Join(root, \"bin2\")\n362|\tfor _, dir := range []string{first, second} {\n363|\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n364|\t\t\tt.Fatalf(\"MkdirAll: %v\", err)\n365|\t\t}\n366|\t}\n367|\twriteExecutable(t, first, \"ax-provider-pathtool\", []byte(\"p1\"))\n368|\tt.Setenv(\"PATH\", first+string(os.PathListSeparator)+second)\n369|\n370|\tsystem := OSSystem{}\n371|\towner := CurrentOperatorPolicy()\n372|\n373|\tallowed := Config{Platform: scalar.PlatformLinux, AllowPathPlugins: true}\n374|\tgot, err := Discover(allowed, owner, system)\n375|\tif err != nil {\n376|\t\tt.Fatalf(\"Discover: %v\", err)\n377|\t}\n378|\tfound := false\n379|\tfor _, candidate := range got {\n380|\t\tif candidate.ID() == \"pathtool\" && candidate.Source() == \"path\" {\n381|\t\t\tfound = true\n382|\t\t\tcanon, _ := candidate.CanonicalPath()\n383|\t\t\tif !strings.HasPrefix(canon, first) {\n384|\t\t\t\tt.Fatalf(\"CanonicalPath = %q, want it under %q\", canon, first)\n385|\t\t\t}\n386|\t\t}\n387|\t}\n388|\tif !found {\n389|\t\tt.Fatal(\"PATH candidate missing when allow_path_plugins is true\")\n390|\t}\n391|\n392|\tdenied, err := Discover(Config{Platform: scalar.PlatformLinux}, owner, system)\n393|\tif err != nil {\n394|\t\tt.Fatalf(\"Discover: %v\", err)\n395|\t}\n396|\tfor _, candidate := range denied {\n397|\t\tif candidate.ID() == \"pathtool\" {\n398|\t\t\tt.Fatal(\"PATH candidate admitted while allow_path_plugins is false\")\n399|\t\t}\n400|\t}\n401|\n402|\twriteExecutable(t, second, \"ax-provider-pathtool\", []byte(\"p2\"))\n403|\tif _, err := Discover(allowed, owner, system); err == nil {\n404|\t\tt.Fatal(\"Discover admitted one ID from two PATH directories\")\n405|\t} else if code := errorCode(t, err); code != codeInvalidConfig {\n406|\t\tt.Fatalf(\"code = %q, want invalid_config\", code)\n407|\t}\n408|}"}}}
