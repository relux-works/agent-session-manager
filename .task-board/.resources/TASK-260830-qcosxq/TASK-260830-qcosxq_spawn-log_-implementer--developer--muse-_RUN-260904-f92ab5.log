{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd81","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":3355,"recorded_at":1780531400006705,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"call_id":"call_01a06ef0bebb7472aa87a1b7fa1e5dc3","text":"Read text file `internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"time\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// Wire constants of pinned specification Section 7.2. The protocol\n17|// identifier and version are exact: a different major is never negotiated,\n18|// and anything other than 2.0.0 on the wire is refused or reported as a\n19|// major mismatch, never accepted.\n20|const (\n21|\t// ProtocolID is the exact protocol member every request and response\n22|\t// envelope carries.\n23|\tProtocolID = \"urn:ax:protocol:provider\"\n24|\t// ProtocolVersion is the exact protocol_version member this host\n25|\t// writes and the only one it accepts a response under.\n26|\tProtocolVersion = \"2.0.0\"\n27|\t// ProtocolMajor is the major this host implements. Responses under\n28|\t// any other recognizable major are reported as incompatible_protocol\n29|\t// without trusting their payload.\n30|\tProtocolMajor = 2\n31|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n32|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n33|\t// larger than 8 MiB.\n34|\tMaxFrameBytes = 8 << 20\n35|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n36|\t// resource bound, not a protocol limit: diagnostics beyond it are\n37|\t// dropped before the host sees them, and the truncation is reported\n38|\t// in the failure details.\n39|\tStderrCapBytes = 1 << 20\n40|)\n41|\n42|// Operation names one Section 7.5 registry entry. The registry is closed:\n43|// dispatch refuses any other name locally, before any process starts.\n44|type Operation string\n45|\n46|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n47|// inventory test derives this list from the pinned specification text and\n48|// requires exact ordered equality, so a dropped, added, or reordered entry\n49|// reddens there rather than passing silently.\n50|const (\n51|\tOpManifest            Operation = \"manifest\"\n52|\tOpProbe               Operation = \"probe\"\n53|\tOpLaunch              Operation = \"launch\"\n54|\tOpIdentifySession     Operation = \"identify-session\"\n55|\tOpQuiesce             Operation = \"quiesce\"\n56|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n57|\tOpCapture             Operation = \"capture\"\n58|\tOpMaterialize         Operation = \"materialize\"\n59|\tOpMaterializeStatus   Operation = \"materialize-status\"\n60|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n61|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n62|\tOpResume              Operation = \"resume\"\n63|\tOpFork                Operation = \"fork\"\n64|\tOpStop                Operation = \"stop\"\n65|\tOpDoctor              Operation = \"doctor\"\n66|)\n67|\n68|// operationOrder is the single construction site of the dispatch registry.\n69|var operationOrder = []Operation{\n70|\tOpManifest,\n71|\tOpProbe,\n72|\tOpLaunch,\n73|\tOpIdentifySession,\n74|\tOpQuiesce,\n75|\tOpNativeStorePlan,\n76|\tOpCapture,\n77|\tOpMaterialize,\n78|\tOpMaterializeStatus,\n79|\tOpMaterializeCommit,\n80|\tOpMaterializeRollback,\n81|\tOpResume,\n82|\tOpFork,\n83|\tOpStop,\n84|\tOpDoctor,\n85|}\n86|\n87|// Operations returns the dispatch registry in manifest order. The result\n88|// is a copy; the registry cannot be mutated through it.\n89|func Operations() []string {\n90|\tout := make([]string, 0, len(operationOrder))\n91|\tfor _, operation := range operationOrder {\n92|\t\tout = append(out, string(operation))\n93|\t}\n94|\treturn out\n95|}\n96|\n97|// validOperation reports whether the name is a registry member.\n98|func validOperation(name string) bool {\n99|\tfor _, operation := range operationOrder {\n100|\t\tif string(operation) == name {\n101|\t\t\treturn true\n102|\t\t}\n103|\t}\n104|\treturn false\n105|}\n106|\n107|// The refusal constructors below are declared as variables so the\n108|// inventory gate can observe every exercised refusal site. Each is the\n109|// single construction site for its failure class; production code must\n110|// not build *axerror.Error any other way.\n111|//\n112|// failInvalid reports a caller error caught before any process starts:\n113|// an unknown operation, a stale deadline, or an unframeable request body.\n114|// failProtocol reports an unusable plugin frame through the Section 15.1\n115|// provider-stdio otherwise branch. failMismatch reports a recognizable\n116|// major mismatch through the same table's mismatch branch, without\n117|// trusting the foreign payload. failProcess reports a crash or transport\n118|// failure. failTimeout reports a plugin that exceeded its request\n119|// deadline. failIntegrity reports a status observation that cannot be\n120|// reconciled to durable state.\n121|var failInvalid = func(detail string) (*axerror.Error, error) {\n122|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n123|}\n124|\n125|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n126|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n127|}\n128|\n129|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n130|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n131|}\n132|\n133|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n134|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n135|}\n136|\n137|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n138|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n139|}\n140|\n141|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n142|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n143|}\n144|\n145|// Request is one Section 7.2 request envelope. Body crosses the transport\n146|// opaquely: it must be a JSON object, and its members are interpreted by\n147|// the operation layer, except for the status recovery read.\n148|type Request struct {\n149|\tOperation Operation\n150|\tRequestID scalar.UUIDv7\n151|\tDeadline  scalar.Timestamp\n152|\tBody      json.RawMessage\n153|}\n154|\n155|// Response is one accepted success envelope. Body is the raw\n156|// operation-specific object for the operation layer to interpret. A\n157|// failure envelope never produces a Response: DecodeResponse returns the\n158|// bound child error instead, and a failure envelope carrying a body is\n159|// refused outright.\n160|type Response struct {\n161|\tBody json.RawMessage\n162|}\n163|\n164|// wireRequest is the exact emitted member set: protocol, protocol_version,\n165|// request_id, operation, deadline, and body, in this fixed order.\n166|type wireRequest struct {\n167|\tProtocol        string           `json:\"protocol\"`\n168|\tProtocolVersion string           `json:\"protocol_version\"`\n169|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n170|\tOperation       string           `json:\"operation\"`\n171|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n172|\tBody            json.RawMessage  `json:\"body\"`\n173|}\n174|\n175|// EncodeRequest frames one request as a single JSONL line without the\n176|// terminator. The deadline must be in the future at now, which the caller\n177|// supplies so tests stay deterministic; Host passes its clock.\n178|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n179|\tframe, _, err := encodeFrame(req, now)\n180|\treturn frame, err\n181|}\n182|\n183|// encodeFrame validates and frames a request, also returning the parsed\n184|// deadline instant so Host.Call validates once at a single site.\n185|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n186|\tif !validOperation(string(req.Operation)) {\n187|\t\tfailure, err := failInvalid(\"unknown operation\")\n188|\t\tif err != nil {\n189|\t\t\treturn nil, time.Time{}, err\n190|\t\t}\n191|\t\treturn nil, time.Time{}, failure\n192|\t}\n193|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n194|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n195|\t\tif fault != nil {\n196|\t\t\treturn nil, time.Time{}, fault\n197|\t\t}\n198|\t\treturn nil,