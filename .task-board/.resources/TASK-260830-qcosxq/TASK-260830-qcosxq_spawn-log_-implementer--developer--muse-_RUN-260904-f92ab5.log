{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c97d","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":793,"recorded_at":1780531400001581,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"2bf681e4-5309-4ed4-952e-e6601368fba6"},"task_id":"2bf681e4-5309-4ed4-952e-e6601368fba6","event":{"kind":"output","task_id":"2bf681e4-5309-4ed4-952e-e6601368fba6","chunk":"Read text file `internal/provider/refusal_inventory_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"sync\"\n15|\t\"testing\"\n16|)\n17|\n18|// exercisedRefusalSites records the production file:line that constructed a\n19|// refusal, for every instrumented refusal constructor call made during the\n20|// test run. observedCodes records every stable code those refusals carried.\n21|var exercisedRefusalSites sync.Map\n22|var observedCodes sync.Map\n23|\n24|func recordRefusalSite(code string) {\n25|\tobservedCodes.Store(code, struct{}{})\n26|\tif _, file, line, ok := runtime.Caller(2); ok {\n27|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n28|\t}\n29|}\n30|\n31|func TestMain(main *testing.M) {\n32|\torigDuplicate, origInvalid, origPrecondition, origIntegrity := failDuplicate, failInvalid, failPrecondition, failIntegrity\n33|\tfailDuplicate = func(providerID, firstSource, secondSource string) Error {\n34|\t\terr := origDuplicate(providerID, firstSource, secondSource)\n35|\t\trecordRefusalSite(err.Code())\n36|\t\treturn err\n37|\t}\n38|\tfailInvalid = func(detail string) Error {\n39|\t\terr := origInvalid(detail)\n40|\t\trecordRefusalSite(err.Code())\n41|\t\treturn err\n42|\t}\n43|\tfailPrecondition = func(detail string, cause error) Error {\n44|\t\terr := origPrecondition(detail, cause)\n45|\t\trecordRefusalSite(err.Code())\n46|\t\treturn err\n47|\t}\n48|\tfailIntegrity = func(detail string, cause error) Error {\n49|\t\terr := origIntegrity(detail, cause)\n50|\t\trecordRefusalSite(err.Code())\n51|\t\treturn err\n52|\t}\n53|\tcode := main.Run()\n54|\tif code == 0 && fullPackageTestRun() {\n55|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n56|\t\t\tfor _, failure := range failures {\n57|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n58|\t\t\t}\n59|\t\t\tcode = 1\n60|\t\t}\n61|\t}\n62|\tos.Exit(code)\n63|}\n64|\n65|func fullPackageTestRun() bool {\n66|\tselected := flag.Lookup(\"test.run\")\n67|\treturn selected == nil || selected.Value.String() == \"\"\n68|}\n69|\n70|// auditRefusalInventory derives the refusal inventory from package source,\n71|// never from memory: every production call to a refusal constructor must\n72|// have an exercised negative path, no Error value may be built outside the\n73|// four constructors, and the observed code set must equal the closed code\n74|// set exactly.\n75|func auditRefusalInventory() []string {\n76|\tdirectory, err := os.Getwd()\n77|\tif err != nil {\n78|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n79|\t}\n80|\tinventory, err := deriveRefusalInventory(directory)\n81|\tif err != nil {\n82|\t\treturn []string{fmt.Sprintf(\"derive provider refusal inventory: %v\", err)}\n83|\t}\n84|\tvar failures []string\n85|\t// Floor: a derived domain that can silently derive nothing is not a\n86|\t// measurement. An empty or short derivation must fail closed, never\n87|\t// pass vacuously — the same \"the scan is blind\" floor the package's\n88|\t// other derived scans carry.\n89|\tif len(inventory.ScannedFiles) == 0 {\n90|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n91|\t}\n92|\tif len(inventory.Sites) == 0 {\n93|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n94|\t}\n95|\t// Reverse direction: every exercised refusal site must resolve to a\n96|\t// derived site. The exercised set is derived from the test run, not\n97|\t// hand-listed, so a truncated derivation (1 of N sites, provider.go\n98|\t// skipped, or an empty-but-successful read of the wrong directory)\n99|\t// reddens here even though the forward check passes vacuously.\n100|\tderived := map[string]bool{}\n101|\tfor _, site := range inventory.Sites {\n102|\t\tderived[site] = true\n103|\t}\n104|\tvar outside []string\n105|\texercisedRefusalSites.Range(func(key, _ any) bool {\n106|\t\tsite := key.(string)\n107|\t\tif !derived[site] {\n108|\t\t\toutside = append(outside, site)\n109|\t\t}\n110|\t\treturn true\n111|\t})\n112|\tsort.Strings(outside)\n113|\tif len(outside) != 0 {\n114|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n115|\t}\n116|\tif len(inventory.StrayLiterals) != 0 {\n117|\t\tsort.Strings(inventory.StrayLiterals)\n118|\t\tfailures = append(failures, \"provider refusals built outside an instrumented constructor: \"+strings.Join(inventory.StrayLiterals, \", \"))\n119|\t}\n120|\tif len(inventory.RawConstructors) != 0 {\n121|\t\tsort.Strings(inventory.RawConstructors)\n122|\t\tfailures = append(failures, \"provider raw error construction outside documented cause sites: \"+strings.Join(inventory.RawConstructors, \", \"))\n123|\t}\n124|\tvar missing []string\n125|\tfor _, site := range inventory.Sites {\n126|\t\tif _, ok := exercisedRefusalSites.Load(site); !ok {\n127|\t\t\tmissing = append(missing, site)\n128|\t\t}\n129|\t}\n130|\tsort.Strings(missing)\n131|\tif len(missing) != 0 {\n132|\t\tfailures = append(failures, \"provider refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n133|\t}\n134|\tvar codes []string\n135|\tobservedCodes.Range(func(key, _ any) bool {\n136|\t\tcodes = append(codes, key.(string))\n137|\t\treturn true\n138|\t})\n139|\tsort.Strings(codes)\n140|\twant := []string{codeIntegrityFailure, codeInvalidConfig, codeLocalPrecondition}\n141|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n142|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n143|\t}\n144|\treturn failures\n145|}\n146|\n147|// refusalInventory is derived from package sources.\n148|type refusalInventory struct {\n149|\t// ScannedFiles are the production source basenames the derivation\n150|\t// parsed. The audit fails closed when this is empty: a successful\n151|\t// read of the wrong directory must not pass as a clean inventory.\n152|\tScannedFiles []string\n153|\t// Sites are file:line positions of production refusal constructor calls.\n154|\tSites []string\n155|\t// StrayLiterals are Error composite literals outside the constructors.\n156|\tStrayLiterals []string\n157|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls outside\n158|\t// the documented owner-attestation cause sites.\n159|\tRawConstructors []string\n160|}\n161|\n162|var refusalConstructors = map[string]bool{\n163|\t\"failDuplicate\":    true,\n164|\t\"failInvalid\":      true,\n165|\t\"failPrecondition\": true,\n166|\t\"failIntegrity\":    true,\n167|}\n168|\n169|// causeSiteFiles are the only production files allowed to mint raw cause\n170|// errors: the platform owner-attestation seams whose failures production\n171|// code always wraps in a refusal constructor.\n172|var causeSiteFiles = map[string]bool{\n173|\t\"os_unix.go\":    true,\n174|\t\"os_windows.go\": true,\n175|}\n176|\n177|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n178|\tentries, err := os.ReadDir(directory)\n179|\tif err != nil {\n180|\t\treturn refusalInventory{}, err\n181|\t}\n182|\tvar inventory refusalInventory\n183|\tfileSet := token.NewFileSet()\n184|\tfor _, entry := range entries {\n185|\t\tname := entry.Name()\n186|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n187|\t\t\tcontinue\n188|\t\t}\n189|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n190|\t\tpath := filepath.Join(directory, name)\n191|\t\tsource, err := os.ReadFile(path)\n192|\t\tif err != nil {\n193|\t\t\treturn refusalInventory{}, err\n194|\t\t}\n195|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n196|\t\tif err != nil {\n197|\t\t\treturn refusalInventory{}, err\n198|\t\t}\n199|\t\t// Map each constructor's own body span so literals inside it are\n200|\t\t// not mistaken for strays.\n201|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n202|\t\tfor _, decl := range syntax.Decls {\n203|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n204|\t\t\tif !ok {\n205|\t\t\t\tcontinue\n206|\t\t\t}\n207|\t\t\tfor _, spec := range general.Specs {\n208|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n209|\t\t\t\tif !ok {\n210|\t\t\t\t\tcontinue\n211|\t\t\t\t}\n212|\t\t\t\tfor i, ident := range values.Names {\n213|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n214|\t\t\t\t\t\tcontinue\n215|\t\t\t\t\t}\n216|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n217|\t\t\t\t\t\tconstructorBodies[literal] = true\n218|\t\t\t\t\t}\n219|\t\t\t\t}\n220|\t\t\t}\n221|\t\t}\n222|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n223|\t\t\tcall, ok := node.(*ast.CallExpr)\n224|\t\t\tif !ok {\n225|\t\t\t\treturn true\n226|\t\t\t}\n227|\t\t\tposition := fileSet.Position(call.Pos())\n228|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n229|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n230|\t\t\t\tif refusalConstructors[ident.Name] {\n231|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n232|\t\t\t\t\treturn true\n233|\t\t\t\t}\n234|\t\t\t\tif ident.Name == \"panic\" {\n235|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n236|\t\t\t\t\treturn true\n237|\t\t\t\t}\n238|\t\t\t}\n239|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n240|\t\t\tif !ok {\n241|\t\t\t\treturn true\n242|\t\t\t}\n243|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n244|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n245|\t\t\t\tif qualified == \"errors.New\" || qualified == \"fmt.Errorf\" {\n246|\t\t\t\t\tif !causeSiteFiles[name] {\n247|\t\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n248|\t\t\t\t\t}\n249|\t\t\t\t\treturn true\n250|\t\t\t\t}\n251|\t\t\t}\n252|\t\t\tif selector.Sel.Name == \"panic\" {\n253|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n254|\t\t\t}\n255|\t\t\treturn true\n256|\t\t})\n257|\t\t// Stray Error literals: composite literals of type Error outside\n258|\t\t// a constructor body. Bodies are matched by source span.\n259|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n260|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n261|\t\t\tif !ok {\n262|\t\t\t\treturn true\n263|\t\t\t}\n264|\t\t\tident, ok := literal.Type.(*ast.Ident)\n265|\t\t\tif !ok || ident.Name != \"Error\" {\n266|\t\t\t\treturn true\n267|\t\t\t}\n268|\t\t\tfor body := range constructorBodies {\n269|\t\t\t\tif literal.Pos() >= body.Pos() && literal.End() <= body.End() {\n270|\t\t\t\t\treturn true\n271|\t\t\t\t}\n272|\t\t\t}\n273|\t\t\tposition := fileSet.Position(literal.Pos())\n274|\t\t\tinventory.StrayLiterals = append(inventory.StrayLiterals, fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line))\n275|\t\t\treturn true\n276|\t\t})\n277|\t}\n278|\treturn inventory, nil\n279|}"}}}
