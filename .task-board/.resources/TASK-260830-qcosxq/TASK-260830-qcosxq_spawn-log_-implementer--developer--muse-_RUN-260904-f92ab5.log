{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb43","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":1020,"recorded_at":1780531400002035,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"ff68b0cd-774a-405d-8c68-88ecfe5444e9"},"task_id":"ff68b0cd-774a-405d-8c68-88ecfe5444e9","event":{"kind":"output","task_id":"ff68b0cd-774a-405d-8c68-88ecfe5444e9","chunk":"Read text file `internal/provider/os_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// writeExecutable creates dir/name with content and owner-only-executable\n17|// permissions. The executable bit is convenio, not a trust fact: Discover\n18|// records regular-file shape, owner, and digest, never the mode.\n19|func writeExecutable(t *testing.T, dir, name string, content []byte) string {\n20|\tt.Helper()\n21|\tpath := filepath.Join(dir, name)\n22|\tif err := os.WriteFile(path, content, 0o700); err != nil {\n23|\t\tt.Fatalf(\"WriteFile(%s): %v\", path, err)\n24|\t}\n25|\treturn path\n26|}\n27|\n28|// TestOSSystemEndToEnd drives the production entry points Discover, Trust,\n29|// and Verify through the production OSSystem on a real temporary tree:\n30|// symlink resolution, digest recording, trust acceptance, retarget\n31|// detection, byte-change detection, and non-regular replacement detection.\n32|func TestOSSystemEndToEnd(t *testing.T) {\n33|\troot, err := filepath.EvalSymlinks(t.TempDir())\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"EvalSymlinks: %v\", err)\n36|\t}\n37|\tplugindir := filepath.Join(root, \"plugins\")\n38|\trealdir := filepath.Join(root, \"real\")\n39|\tif err := os.MkdirAll(plugindir, 0o755); err != nil {\n40|\t\tt.Fatalf(\"MkdirAll: %v\", err)\n41|\t}\n42|\tif err := os.MkdirAll(realdir, 0o755); err != nil {\n43|\t\tt.Fatalf(\"MkdirAll: %v\", err)\n44|\t}\n45|\tcontent := []byte(\"#!/bin/sh\\nexit 0\\n\")\n46|\ttarget := writeExecutable(t, realdir, \"tool\", content)\n47|\tsource := filepath.Join(plugindir, \"ax-provider-mytool\")\n48|\tif err := os.Symlink(target, source); err != nil {\n49|\t\tt.Fatalf(\"Symlink: %v\", err)\n50|\t}\n51|\n52|\tsystem := OSSystem{}\n53|\towner := CurrentOperatorPolicy()\n54|\tcfg := Config{Platform: scalar.PlatformLinux, PluginDirs: []string{plugindir}}\n55|\n56|\tgot, err := Discover(cfg, owner, system)\n57|\tif err != nil {\n58|\t\tt.Fatalf(\"Discover: %v\", err)\n59|\t}\n60|\tvar candidate *Candidate\n(more lines below)"}}}
