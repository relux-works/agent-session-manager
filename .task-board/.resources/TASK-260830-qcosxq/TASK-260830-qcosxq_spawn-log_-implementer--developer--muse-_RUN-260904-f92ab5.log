rr := io.ReadAll(io.LimitReader(stream, int64(cap)+1))\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tif len(data) > cap {\\n\\t\\treturn data[:cap], nil\\n\\t}\\n\\treturn data, nil\\n}''')\\nopen(p, 'w').write(s)\\nprint(\\\"ok\\\")\\nEOF\\ngofmt -w internal/provhost/runner.go && go build ./internal/provhost/ 2>&1 | head\",\n  \"description\": \"Remove dead truncation flags\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ok\\n\",\n  \"original_output_bytes\": 3,\n  \"original_output_tokens\": 1,\n  \"truncated\": false\n}"}}}
