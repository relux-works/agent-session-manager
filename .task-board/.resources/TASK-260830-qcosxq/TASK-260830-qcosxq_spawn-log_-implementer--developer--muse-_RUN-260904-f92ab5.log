{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d077","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":1686,"recorded_at":1780531400003367,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"c3029dce-bfcb-4959-b74a-99ae90ce0b60"},"task_id":"c3029dce-bfcb-4959-b74a-99ae90ce0b60","event":{"kind":"output","task_id":"c3029dce-bfcb-4959-b74a-99ae90ce0b60","chunk":"Read text file `internal/provider/enumeration_test.go`.\n1|package provider\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n15|)\n16|\n17|// sectionLines joins the pinned document lines for section 7.1, failing\n18|// when the section boundaries move. Every citation below resolves against\n19|// the real text, never against a restatement in this repository.\n20|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n21|\tt.Helper()\n22|\tfor _, line := range []int{first, last} {\n23|\t\tgot, ok := document.SectionID(line)\n24|\t\tif !ok || got != section {\n25|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n26|\t\t}\n27|\t}\n28|\tvar body strings.Builder\n29|\tfor line := first; line <= last; line++ {\n30|\t\ttext, ok := document.Line(line)\n31|\t\tif !ok {\n32|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n33|\t\t}\n34|\t\tbody.WriteString(text)\n35|\t\tbody.WriteString(\"\\n\")\n36|\t}\n37|\treturn body.String()\n38|}\n39|\n40|// requireQuote asserts the excerpt occurs verbatim in the pinned document\n41|// and begins on a line inside the cited section.\n42|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n43|\tt.Helper()\n44|\tif !document.Contains(excerpt) {\n45|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n46|\t}\n47|\tlines := document.QuoteLines(excerpt)\n48|\tif len(lines) == 0 {\n49|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n50|\t}\n51|\tgot, ok := document.SectionID(lines[0])\n52|\tif !ok || got != section {\n53|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n54|\t}\n55|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n56|}\n57|\n58|// TestSection71BuiltinRegistryIsDocumentOrder proves the builtin registry\n59|// enumerates exactly the six Section 7.1 built-ins in the section's listed\n60|// order. The order is derived from the pinned text: each name's first\n61|// tagged occurrence inside Section 7.1 must appear in registry order.\n62|func TestSection71BuiltinRegistryIsDocumentOrder(t *testing.T) {\n63|\tdocument, err := specdoc.Load()\n64|\tif err != nil {\n65|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n66|\t}\n67|\twindow := sectionLines(t, document, \"7.1\", 2622, 2653)\n68|\tnames := []string{\"codex\", \"claude\", \"gemini\", \"muse\", \"antigravity\", \"pi\"}\n69|\tprevious := -1\n70|\tfor _, name := range names {\n71|\t\toffset := strings.Index(window, \"<code>\"+name+\"</code>\")\n72|\t\tif offset == -1 {\n73|\t\t\tt.Fatalf(\"Section 7.1 does not list builtin %q\", name)\n74|\t\t}\n75|\t\tif offset <= previous {\n76|\t\t\tt.Fatalf(\"Section 7.1 lists %q out of registry order\", name)\n77|\t\t}\n78|\t\tprevious = offset\n79|\t}\n80|\tgot := Builtins()\n81|\tif len(got) != len(names) {\n82|\t\tt.Fatalf(\"Builtins() = %v, want the six Section 7.1 names\", got)\n83|\t}\n84|\tfor i, name := range names {\n85|\t\tif got[i] != name {\n86|\t\t\tt.Fatalf(\"Builtins() = %v, want Section 7.1 order %v\", got, names)\n87|\t\t}\n88|\t}\n89|\trequireQuote(t, document, \"Built-in support covers\", \"7.1\")\n90|}\n91|\n92|// TestSection71DiscoveryOrderIsPinned quotes the Section 7.1 discovery\n93|// order behind Discover's source ranking and the PATH gate.\n94|func TestSection71DiscoveryOrderIsPinned(t *testing.T) {\n95|\tdocument, err := specdoc.Load()\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n98|\t}\n99|\tfor _, excerpt := range []string{\n100|\t\t\"configured <code>providers.plugin_dirs</code> in listed order\",\n101|\t\t\"built-in adapters\",\n102|\t\t\"<code>PATH</code>, only when <code>allow_path_plugins</code> is true\",\n103|\t\t\"The order does not establish precedence\",\n104|\t} {\n105|\t\trequireQuote(t, document, excerpt, \"7.1\")\n106|\t}\n107|}\n108|\n109|// TestSection71DuplicateRefusalIsPinned quotes the duplicate rule and its\n110|// mandated code behind the duplicate refusal.\n(more lines below)"}}}
