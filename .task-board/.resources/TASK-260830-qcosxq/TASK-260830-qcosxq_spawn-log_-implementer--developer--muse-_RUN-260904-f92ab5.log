{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c423","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":108,"recorded_at":1780531400000211,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"5e5c30e3-9629-4384-8bf0-a6116ae4c3de"},"task_id":"5e5c30e3-9629-4384-8bf0-a6116ae4c3de","event":{"kind":"output","task_id":"5e5c30e3-9629-4384-8bf0-a6116ae4c3de","chunk":"Read text file `internal/provider/os.go`.\n1|package provider\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|)\n8|\n9|// OSSystem is the production System: it reads the host filesystem through\n10|// the os package. It holds no state and starts no process.\n11|type OSSystem struct{}\n12|\n13|// ReadDir returns the entry names of dir in filesystem order. Discover\n14|// sorts them, so the order here carries no determinism obligation.\n15|func (OSSystem) ReadDir(dir string) ([]string, error) {\n16|\tentries, err := os.ReadDir(dir)\n17|\tif err != nil {\n18|\t\treturn nil, err\n19|\t}\n20|\tnames := make([]string, 0, len(entries))\n21|\tfor _, entry := range entries {\n22|\t\tnames = append(names, entry.Name())\n23|\t}\n24|\treturn names, nil\n25|}\n26|\n27|// Canonicalize returns the absolute, symlink-resolved target of path.\n28|func (OSSystem) Canonicalize(path string) (string, error) {\n29|\tabsolute, err := filepath.Abs(path)\n30|\tif err != nil {\n31|\t\treturn \"\", err\n32|\t}\n33|\treturn filepath.EvalSymlinks(absolute)\n34|}\n35|\n36|// ownerAttester attests the owning UID of a stat result. It is a variable\n37|// only so seam-failure tests can force the attestation-failure path\n38|// through the production Inspect below: no real stat result reaches that\n39|// path on unix, and without the seam the error branch is untestable.\n40|// Production code never reassigns it.\n41|var ownerAttester = fileOwnerUID\n42|\n43|// Inspect stats the symlink target at an already-canonical path.\n44|func (OSSystem) Inspect(canonical string) (FileInfo, error) {\n45|\tinfo, err := os.Stat(canonical)\n46|\tif err != nil {\n47|\t\treturn FileInfo{}, err\n48|\t}\n49|\tuid, err := ownerAttester(info)\n50|\tif err != nil {\n51|\t\treturn FileInfo{}, err\n52|\t}\n53|\treturn FileInfo{IsRegular: info.Mode().IsRegular(), UID: uid}, nil\n54|}\n55|\n56|// ReadFile returns the full bytes of the symlink target at an\n57|// already-canonical path.\n58|func (OSSystem) ReadFile(canonical string) ([]byte, error) {\n59|\treturn os.ReadFile(canonical)\n60|}\n61|\n62|// PathDirs returns the host PATH directories in listed order, skipping\n63|// empty entries.\n64|func (OSSystem) PathDirs() []string {\n65|\traw := os.Getenv(\"PATH\")\n66|\tif raw == \"\" {\n67|\t\treturn nil\n68|\t}\n69|\tvar dirs []string\n70|\tfor _, dir := range strings.Split(raw, string(os.PathListSeparator)) {\n71|\t\tif dir != \"\" {\n72|\t\t\tdirs = append(dirs, dir)\n73|\t\t}\n74|\t}\n75|\treturn dirs\n76|}\n77|\n78|// CurrentOperatorPolicy returns the OwnerPolicy for the invoking operator\n79|// with no additional administrator-approved identities. A host that\n80|// recognizes administrator-approved owners supplies them explicitly in\n81|// OwnerPolicy instead.\n82|func CurrentOperatorPolicy() OwnerPolicy {\n83|\treturn OwnerPolicy{OperatorUID: uint32(os.Geteuid())}\n84|}"}}}
