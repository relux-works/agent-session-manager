1|\tdefer runner.mu.Unlock()\n82|\treturn len(runner.calls)\n83|}\n84|\n85|func successResult(t *testing.T, id, body string) Result {\n86|\tt.Helper()\n87|\treturn Result{Stdout: successFrame(t, id, body), ExitCode: 0}\n88|}\n(more lines below)"}}}
