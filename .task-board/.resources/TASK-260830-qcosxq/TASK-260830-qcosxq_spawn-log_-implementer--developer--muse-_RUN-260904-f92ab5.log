{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c5","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":829,"recorded_at":1780531400001653,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"60c328e1-84dc-4f9e-a28b-999cafef8e0b"},"task_id":"60c328e1-84dc-4f9e-a28b-999cafef8e0b","event":{"kind":"output","task_id":"60c328e1-84dc-4f9e-a28b-999cafef8e0b","chunk":"Read text file `internal/provider/enumeration_test.go`.\n(179 line(s) above)\n180|\tif len(members) == 0 {\n181|\t\tt.Fatal(\"derived no candidate members; the scan is blind\")\n182|\t}\n183|\tt.Logf(\"scanned %d Candidate/TrustRecord members, none carries capability state\", len(members))\n184|}\n185|\n186|// TestDiscoveryReachesNoProcess proves the ordering guarantee behind the\n187|// duplicate refusal: no package source imports a process-execution\n188|// facility, so Discover cannot probe or execute a candidate. The import\n189|// list is derived from package source.\n190|func TestDiscoveryReachesNoProcess(t *testing.T) {\n191|\tfileset := token.NewFileSet()\n192|\tdirectory, err := os.Getwd()\n193|\tif err != nil {\n194|\t\tt.Fatalf(\"Getwd: %v\", err)\n195|\t}\n196|\tentries, err := os.ReadDir(directory)\n197|\tif err != nil {\n198|\t\tt.Fatalf(\"ReadDir: %v\", err)\n199|\t}\n200|\tfound := false\n201|\tfor _, entry := range entries {\n202|\t\tname := entry.Name()\n203|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n204|\t\t\tcontinue\n205|\t\t}\n206|\t\tfound = true\n207|\t\tsource, err := os.ReadFile(filepath.Join(directory, name))\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"ReadFile(%s): %v\", name, err)\n210|\t\t}\n211|\t\tsyntax, err := parser.ParseFile(fileset, name, source, parser.ImportsOnly)\n212|\t\tif err != nil {\n213|\t\t\tt.Fatalf(\"ParseFile(%s): %v\", name, err)\n214|\t\t}\n215|\t\tfor _, clause := range syntax.Imports {\n216|\t\t\tpath := strings.Trim(clause.Path.Value, `\"`)\n217|\t\t\tif path == \"os/exec\" || strings.HasPrefix(path, \"os/exec/\") {\n218|\t\t\t\tt.Fatalf(\"%s imports process execution (%s)\", name, path)\n219|\t\t\t}\n220|\t\t}\n221|\t}\n222|\tif !found {\n223|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n224|\t}\n225|}\n226|\n227|// TestStableCodesAreRegistered pins every refusal code this package emits\n228|// against the pinned error registry and the exact exit status the host\n229|// surfaces: invalid_config and local_precondition_failed exit 3,\n230|// integrity_failure exits 9.\n231|func TestStableCodesAreRegistered(t *testing.T) {\n232|\tregistered := map[string]int{}\n233|\tfor _, row := range catalog.Current().Errors {\n234|\t\tregistered[string(row.Code)] = row.ExitCode\n235|\t}\n236|\tfor code, wantExit := range map[string]int{\n237|\t\tcodeInvalidConfig:     3,\n238|\t\tcodeLocalPrecondition: 3,\n239|\t\tcodeIntegrityFailure:  9,\n240|\t} {\n241|\t\tgotExit, ok := registered[code]\n242|\t\tif !ok {\n243|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n244|\t\t}\n245|\t\tif gotExit != wantExit {\n246|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n247|\t\t}\n248|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n249|\t\tif err != nil {\n250|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n251|\t\t}\n252|\t\tif gotWire != wantExit {\n253|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n254|\t\t}\n255|\t}\n256|\tt.Logf(\"refusal code coverage: 3/3 package codes registered with pinned exits\")\n257|}\n258|\n259|// exportedSymbols derives every exported top-level symbol name from\n260|// package source.\n261|func exportedSymbols(t *testing.T) []string {\n262|\tt.Helper()\n263|\tvar out []string\n264|\tfor _, syntax := range parseProductionSources(t) {\n265|\t\tfor _, decl := range syntax.Decls {\n266|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n267|\t\t\tif !ok {\n268|\t\t\t\tcontinue\n269|\t\t\t}\n270|\t\t\tfor _, spec := range general.Specs {\n271|\t\t\t\tswitch concrete := spec.(type) {\n272|\t\t\t\tcase *ast.TypeSpec:\n273|\t\t\t\t\tif ast.IsExported(concrete.Name.Name) {\n274|\t\t\t\t\t\tout = append(out, concrete.Name.Name)\n275|\t\t\t\t\t}\n276|\t\t\t\tcase *ast.ValueSpec:\n277|\t\t\t\t\tfor _, ident := range concrete.Names {\n278|\t\t\t\t\t\tif ast.IsExported(ident.Name) {\n279|\t\t\t\t\t\t\tout = append(out, ident.Name)\n280|\t\t\t\t\t\t}\n281|\t\t\t\t\t}\n282|\t\t\t\t}\n283|\t\t\t}\n284|\t\t}\n285|\t\tfor _, decl := range syntax.Decls {\n286|\t\t\tfunction, ok := decl.(*ast.FuncDecl)\n287|\t\t\tif !ok || function.Name == nil || !ast.IsExported(function.Name.Name) {\n288|\t\t\t\tcontinue\n289|\t\t\t}\n290|\t\t\tif function.Recv == nil {\n291|\t\t\t\tout = append(out, function.Name.Name)\n292|\t\t\t} else {\n293|\t\t\t\tout = append(out, function.Name.Name+\" (method)\")\n294|\t\t\t}\n295|\t\t}\n296|\t}\n297|\treturn out\n298|}\n299|\n300|// structMembers derives field names and types for the named structs from\n301|// package source.\n302|func structMembers(t *testing.T, wanted ...string) map[string]string {\n303|\tt.Helper()\n304|\twant := map[string]bool{}\n305|\tfor _, name := range wanted {\n306|\t\twant[name] = true\n307|\t}\n308|\tmembers := map[string]string{}\n309|\tfor _, syntax := range parseProductionSources(t) {\n(more lines below)"}}}
