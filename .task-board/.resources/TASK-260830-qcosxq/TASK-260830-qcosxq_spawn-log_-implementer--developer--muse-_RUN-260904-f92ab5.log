{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca31","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":883,"recorded_at":1780531400001761,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"a22bd126-a89c-411d-a049-53c4cc549b84"},"task_id":"a22bd126-a89c-411d-a049-53c4cc549b84","event":{"kind":"output","task_id":"a22bd126-a89c-411d-a049-53c4cc549b84","chunk":"Read text file `internal/axerror/local.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|)\n8|\n9|// ErrUnknownSurface reports a surface for which the pinned document states no\n10|// exact local failure mapping. It is returned instead of a plausible default,\n11|// because inventing a mapping here would put a code on the wire that no clause\n12|// assigns.\n13|var ErrUnknownSurface = errors.New(\"no pinned local failure mapping for surface\")\n14|\n15|// Surface names a boundary at which ax reads output from a child process or a\n16|// peer. Only the surfaces whose local mapping the pinned document states\n17|// exactly are represented. Directory Node is deliberately absent: Section 15.3\n18|// says the caller emits \"incompatible_protocol or\n19|// adapter_protocol_violation/transport_failure as applicable\" without fixing\n20|// which, so this package reports the mapping as unknown rather than choosing\n21|// one and presenting the choice as the contract.\n22|type Surface string\n23|\n24|const (\n25|\t// SurfaceProviderStdio is the Provider JSON-over-stdio row of the Section\n26|\t// 15.1 bootstrap table.\n27|\tSurfaceProviderStdio Surface = \"provider_stdio\"\n28|\t// SurfaceTaskBoardBridge is the task-board bridge facade row.\n29|\tSurfaceTaskBoardBridge Surface = \"task_board_bridge\"\n30|\t// SurfaceMeshRPC is the Mesh RPC row.\n31|\tSurfaceMeshRPC Surface = \"mesh_rpc\"\n32|\t// SurfaceTerminalBackend is the Section 15.3 TerminalBackend paragraph.\n33|\tSurfaceTerminalBackend Surface = \"terminal_backend\"\n34|)\n35|\n36|// UntrustedOutcome classifies what ax observed at the boundary. It is a\n37|// classification of the local read, not a value taken from the payload: the\n38|// payload is never parsed far enough to yield one.\n39|type UntrustedOutcome string\n40|\n41|const (\n42|\t// OutcomeRecognizableMajorMismatch is the \"recognizable major mismatch\"\n43|\t// branch of every row.\n44|\tOutcomeRecognizableMajorMismatch UntrustedOutcome = \"recognizable_major_mismatch\"\n45|\t// OutcomeUnusableFrame is the otherwise branch: invalid JSON, an oversize\n46|\t// line, missing framing identity, or output that cannot be framed.\n47|\tOutcomeUnusableFrame UntrustedOutcome = \"unusable_frame\"\n48|)\n49|\n50|type localMapping struct {\n51|\tversion       Version\n52|\tmajorMismatch Code\n53|\totherwise     Code\n54|}\n55|\n56|// localMappings is the Section 15.1 bootstrap table plus the Section 15.3\n57|// TerminalBackend paragraph, each row quoted in the comment above its entry.\n58|// The version is fixed per surface and is not a caller argument, so a local\n59|// failure cannot be emitted under a version the surface does not bind.\n60|var localMappings = map[Surface]localMapping{\n61|\t// \"the host accepts no child error object ... and emits its own local Error\n62|\t// 1.0.0: incompatible_protocol for a recognizable major mismatch, otherwise\n63|\t// provider_protocol_error\".\n64|\tSurfaceProviderStdio: {version: Version100, majorMismatch: \"incompatible_protocol\", otherwise: \"provider_protocol_error\"},\n65|\t// \"ax emits its own local Error 1.0.0: incompatible_protocol for a\n66|\t// recognizable major mismatch, otherwise task_board_bridge_unavailable\".\n67|\tSurfaceTaskBoardBridge: {version: Version100, majorMismatch: \"incompatible_protocol\", otherwise: \"task_board_bridge_unavailable\"},\n68|\t// \"The initiator emits its own local Error 1.0.0: incompatible_protocol for\n69|\t// a recognizable major mismatch, otherwise transport_failure\".\n70|\tSurfaceMeshRPC: {version: Version100, majorMismatch: \"incompatible_protocol\", otherwise: \"transport_failure\"},\n71|\t// \"the AX caller emits a local Error 1.3 terminal_backend_protocol_incompatible\n72|\t// for a recognizable major mismatch and terminal_backend_protocol_error otherwise\".\n73|\tSurfaceTerminalBackend: {version: Version130, majorMismatch: \"terminal_backend_protocol_incompatible\", otherwise: \"terminal_backend_protocol_error\"},\n74|}\n75|\n76|// LocalFromUntrusted builds the ax-local failure for an unsupported major or an\n77|// unusable first frame at a child or peer boundary.\n78|//\n79|// It takes no part of the foreign payload. Its inputs are the surface, ax's own\n80|// classification of what it observed, human text ax wrote, the identifiers ax\n81|// itself knows, and a local Go cause. There is no parameter through which a\n82|// foreign code, retryable bit, detail map, or authority field could be adopted,\n83|// which is how Section 15.1's \"Receivers MUST NOT parse a different major's\n84|// payload far enough to trust its error code, retryable bit, details, or\n85|// authority fields\" is enforced rather than merely intended.\n86|//\n87|// The result is never retryable. Every code this table can emit either belongs\n88|// to a class the caller must inspect before repeating, or describes a boundary\n89|// that the identical request cannot get past; nothing observed at an unusable\n90|// frame licenses a safe-retry claim, so the constructor does not offer one.\n91|func LocalFromUntrusted(\n92|\tsurface Surface,\n93|\toutcome UntrustedOutcome,\n94|\tmessage string,\n95|\tids IDs,\n96|\tdetails Details,\n97|\tcause error,\n98|) (*Error, error) {\n99|\tmapping, known := localMappings[surface]\n100|\tif !known {\n101|\t\treturn nil, fmt.Errorf(\"%w: %q\", ErrUnknownSurface, surface)\n102|\t}\n103|\tvar code Code\n104|\tswitch outcome {\n105|\tcase OutcomeRecognizableMajorMismatch:\n106|\t\tcode = mapping.majorMismatch\n107|\tcase OutcomeUnusableFrame:\n108|\t\tcode = mapping.otherwise\n109|\tdefault:\n110|\t\treturn nil, fmt.Errorf(\"%w: outcome %q is not a pinned classification\", ErrInvalidStructuredError, outcome)\n111|\t}\n112|\tif details == nil {\n113|\t\tdetails = Details{}\n114|\t}\n115|\treturn New(Spec{\n116|\t\tVersion: mapping.version,\n117|\t\tCode:    code,\n118|\t\tMessage: message,\n119|\t\tIDs:     ids,\n120|\t\tDetails: details,\n121|\t\tCause:   cause,\n122|\t})\n123|}\n124|\n125|// LocalSurfaces returns the surfaces with a pinned local failure mapping, in a\n126|// stable order. It is the measured denominator of this package's bootstrap\n127|// coverage: four of the five boundaries the pinned document names, with\n128|// Directory Node excluded for the reason stated on Surface.\n129|func LocalSurfaces() []Surface {\n130|\tresult := make([]Surface, 0, len(localMappings))\n131|\tfor surface := range localMappings {\n132|\t\tresult = append(result, surface)\n133|\t}\n134|\tsort.Slice(result, func(left, right int) bool { return result[left] < result[right] })\n135|\treturn result\n136|}"}}}
