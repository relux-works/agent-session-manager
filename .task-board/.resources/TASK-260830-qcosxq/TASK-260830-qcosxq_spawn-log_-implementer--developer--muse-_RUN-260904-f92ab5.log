{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d09b","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":1704,"recorded_at":1780531400003403,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"46f2e15a-36d7-443f-9ccf-9b11c6cfc75b"},"task_id":"46f2e15a-36d7-443f-9ccf-9b11c6cfc75b","event":{"kind":"output","task_id":"46f2e15a-36d7-443f-9ccf-9b11c6cfc75b","chunk":"{\n  \"chunk_id\": \"exec-54-1\",\n  \"command\": \"sed -n '204,262p' internal/axerror/details.go; echo ===; sed -n '76,94p' internal/scalar/uuid.go\",\n  \"description\": \"Check nil cause handling and UUID marshal\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"func refuseCausalLeak(message string, details Details, cause error) error {\\n\\tfor _, rendered := range causeChainText(cause) {\\n\\t\\tif utf8.RuneCountInString(rendered) < minRedactableCause {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n\\t\\tif strings.Contains(message, rendered) {\\n\\t\\t\\treturn fmt.Errorf(\\\"%w: message reproduces the local cause verbatim\\\", ErrCausalLeak)\\n\\t\\t}\\n\\t\\tfor _, key := range sortedKeys(details) {\\n\\t\\t\\tif valueContains(details[key], rendered) {\\n\\t\\t\\t\\treturn fmt.Errorf(\\\"%w: details[%q] reproduces the local cause verbatim\\\", ErrCausalLeak, key)\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\treturn nil\\n}\\n\\n// causeChainText renders every link of the cause chain. Checking only the\\n// outermost rendering would miss a message that copied the innermost wrapped\\n// error, which is the link most likely to hold the untrusted text.\\nfunc causeChainText(cause error) []string {\\n\\tvar rendered []string\\n\\tfor current := cause; current != nil; {\\n\\t\\trendered = append(rendered, current.Error())\\n\\t\\tswitch unwrapped := current.(type) {\\n\\t\\tcase interface{ Unwrap() error }:\\n\\t\\t\\tcurrent = unwrapped.Unwrap()\\n\\t\\tcase interface{ Unwrap() []error }:\\n\\t\\t\\tfor _, joined := range unwrapped.Unwrap() {\\n\\t\\t\\t\\trendered = append(rendered, causeChainText(joined)...)\\n\\t\\t\\t}\\n\\t\\t\\tcurrent = nil\\n\\t\\tdefault:\\n\\t\\t\\tcurrent = nil\\n\\t\\t}\\n\\t}\\n\\treturn rendered\\n}\\n\\nfunc valueContains(value any, needle string) bool {\\n\\tswitch typed := value.(type) {\\n\\tcase string:\\n\\t\\treturn strings.Contains(typed, needle)\\n\\tcase []any:\\n\\t\\tfor _, member := range typed {\\n\\t\\t\\tif valueContains(member, needle) {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t}\\n\\tcase map[string]any:\\n\\t\\tfor _, member := range typed {\\n\\t\\t\\tif valueContains(member, needle) {\\n\\t\\t\\t\\treturn true\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n===\\nfunc (value UUIDv7) MarshalJSON() ([]byte, error) {\\n\\treturn marshalValidatedString(value.value, \\\"UUIDv7\\\", func(candidate string) error {\\n\\t\\treturn validateUUID(candidate, '7')\\n\\t})\\n}\\n\\nfunc (value *UUIDv7) UnmarshalJSON(data []byte) error {\\n\\tcandidate, err := decodeJSONString(data, \\\"UUIDv7\\\")\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tparsed, err := ParseUUIDv7(candidate)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\t*value = parsed\\n\\treturn nil\\n}\\n\\n\",\n  \"original_output_bytes\": 2072,\n  \"original_output_tokens\": 518,\n  \"truncated\": false\n}"}}}
