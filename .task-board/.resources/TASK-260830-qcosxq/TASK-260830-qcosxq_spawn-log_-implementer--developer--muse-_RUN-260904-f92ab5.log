{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd11","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":3299,"recorded_at":1780531400006593,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"207d2190-bbd5-4630-8300-4a1e5e67e869"},"task_id":"207d2190-bbd5-4630-8300-4a1e5e67e869","event":{"kind":"output","task_id":"207d2190-bbd5-4630-8300-4a1e5e67e869","chunk":"Read text file `internal/provhost/runner.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"io\"\n7|\t\"os/exec\"\n8|\t\"time\"\n9|)\n10|\n11|// waitDrainDelay bounds how long Wait lingers for pipe EOF after the\n12|// deadline kill before giving up on detached grandchildren.\n13|const waitDrainDelay = 2 * time.Second\n14|\n15|// stdoutCap bounds captured plugin stdout: one maximal frame, its line\n16|// terminator, and one probe byte to distinguish a clean end from trailing\n17|// content. Anything beyond is protocol-relevant only as \"more exists\",\n18|// which the truncation flag records.\n19|const stdoutCap = MaxFrameBytes + 2\n20|\n21|// Result is what a plugin process produced: captured stdout and stderr\n22|// and the process exit code. Stdout and stderr are kept separate end to\n23|// end: diagnostics never enter frame parsing, and frame bytes never\n24|// enter diagnostics. Captures are capped (stdout at one frame plus a\n25|// probe byte, stderr at StderrCapBytes); beyond the cap the stream is cut\n26|// and the failure is decided from what was captured, which the length\n27|// checks keep exact.\n28|type Result struct {\n29|\tStdout   []byte\n30|\tStderr   []byte\n31|\tExitCode int\n32|}\n33|\n34|// Runner starts one plugin process for one operation frame. Production\n35|// code supplies ExecRunner; tests supply a scripted fake. A Runner moves\n36|// bytes and reports process fate; it never parses frames and never\n37|// decides failures.\n38|type Runner interface {\n39|\tRun(ctx context.Context, executable string, stdin []byte) (Result, error)\n40|}\n41|\n42|// ExecRunner is the production Runner: it starts the trusted executable\n43|// discovered by internal/provider, writes exactly one frame to its stdin,\n44|// closes stdin, and waits under the caller's context. Environment and\n45|// stderr content never enter a returned value's human text: Result carries\n46|// raw stderr bytes for byte counts only, and failures built from a Result\n47|// carry counts, never content.\n48|type ExecRunner struct{}\n49|\n50|// Run starts executable with stdin on its stdin and captures both streams\n51|// with caps. A nil error with a nonzero exit code is an ordinary result:\n52|// a syntactically valid frame governs regardless of the exit status,\n53|// because SHOULD exit 0 is not MUST. A non-nil error means the process\n54|// never produced a result to judge: start failure, signal death, or\n55|// context end.\n56|func (ExecRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n57|\tcommand := newCommandContext(ctx, executable)\n58|\tcommand.WaitDelay = waitDrainDelay\n59|\tstdinPipe, err := command.StdinPipe()\n60|\tif err != nil {\n61|\t\treturn Result{}, err\n62|\t}\n63|\tstdoutPipe, err := command.StdoutPipe()\n64|\tif err != nil {\n65|\t\treturn Result{}, err\n66|\t}\n67|\tstderrPipe, err := command.StderrPipe()\n68|\tif err != nil {\n69|\t\treturn Result{}, err\n70|\t}\n71|\tif err := command.Start(); err != nil {\n72|\t\treturn Result{}, err\n73|\t}\n74|\t// Drain both streams while stdin is written: a plugin that answers\n75|\t// without reading stdin would otherwise deadlock against a full\n76|\t// pipe once either direction exceeds its buffer.\n77|\ttype streamResult struct {\n78|\t\tdata []byte\n79|\t\terr  error\n80|\t}\n81|\tstdoutDone := make(chan streamResult, 1)\n82|\tstderrDone := make(chan streamResult, 1)\n83|\tgo func() {\n84|\t\tdata, err := readCapped(stdoutPipe, stdoutCap)\n85|\t\tstdoutDone <- streamResult{data: data, err: err}\n86|\t}()\n87|\tgo func() {\n88|\t\tdata, err := readCapped(stderrPipe, StderrCapBytes)\n89|\t\tstderrDone <- streamResult{data: data, err: err}\n90|\t}()\n91|\twrote, writeErr := stdinPipe.Write(stdin)\n92|\tif writeErr == nil && wrote < len(stdin) {\n93|\t\twriteErr = io.ErrShortWrite\n94|\t}\n95|\tif writeErr == nil {\n96|\t\t_, writeErr = stdinPipe.Write([]byte{'\\n'})\n97|\t}\n98|\tcloseErr := stdinPipe.Close()\n99|\twaitErr := command.Wait()\n100|\tif ctx.Err() != nil {\n101|\t\t// The wait ended by deadline or cancellation: the kill was\n102|\t\t// already signaled, but a detached grandchild may hold the\n103|\t\t// pipes open past WaitDelay. Close them rather than waiting\n104|\t\t// for streams that can no longer decide anything: with the\n105|\t\t// deadline gone there is no valid response to read.\n106|\t\tstdoutPipe.Close()\n107|\t\tstderrPipe.Close()\n108|\t\t<-stdoutDone\n109|\t\t<-stderrDone\n110|\t\treturn Result{}, ctx.Err()\n111|\t}\n112|\tstdoutResult := <-stdoutDone\n113|\tstderrResult := <-stderrDone\n114|\tif stdoutResult.err != nil {\n115|\t\treturn Result{}, stdoutResult.err\n116|\t}\n117|\tif stderrResult.err != nil {\n118|\t\treturn Result{}, stderrResult.err\n119|\t}\n120|\tstdout := stdoutResult.data\n121|\tstderr := stderrResult.data\n122|\t// A stdin write failure after the process ran is still a result when\n123|\t// the process produced one: the frame may have arrived whole while\n124|\t// the close raced the plugin's exit. Report write and close failures\n125|\t// only when no result can be judged; otherwise the frame governs.\n126|\tresult := Result{Stdout: stdout, Stderr: stderr, ExitCode: command.ProcessState.ExitCode()}\n127|\tif waitErr == nil {\n128|\t\tif writeErr != nil {\n129|\t\t\treturn Result{}, writeErr\n130|\t\t}\n131|\t\treturn result, closeErr\n132|\t}\n133|\tif exit, ok := waitErr.(*exec.ExitError); ok {\n134|\t\tresult.ExitCode = exit.ExitCode()\n135|\t\tif writeErr != nil {\n136|\t\t\treturn Result{}, writeErr\n137|\t\t}\n138|\t\treturn result, closeErr\n139|\t}\n140|\treturn Result{}, waitErr\n141|}\n142|\n143|// readCapped drains stream up to cap bytes and cuts the rest. Memory\n144|// stays bounded no matter what the plugin emits, and the splitFrame\n145|// length checks stay exact on the capped capture.\n146|func readCapped(stream io.Reader, cap int) ([]byte, error) {\n147|\tdata, err := io.ReadAll(io.LimitReader(stream, int64(cap)+1))\n148|\tif err != nil {\n149|\t\treturn nil, err\n150|\t}\n151|\tif len(data) > cap {\n152|\t\treturn data[:cap], nil\n153|\t}\n154|\treturn data, nil\n155|}\n156|\n157|// Host invokes provider plugins: one process per operation, one frame in,\n158|// one frame out, under the request deadline. Host keeps no cross-call\n159|// state, so successive calls are separate processes observing durable\n160|// state through the authority the caller passes.\n161|type Host struct {\n162|\t// Runner starts the plugin process. It must be set; a nil Runner is\n163|\t// a caller error, refused before any frame is built.\n164|\tRunner Runner\n165|\t// Now is the clock deadlines are checked against. Nil means the\n166|\t// system clock; tests supply a fixed instant.\n167|\tNow func() time.Time\n168|}\n169|\n170|func (host Host) now() time.Time {\n171|\tif host.Now == nil {\n172|\t\treturn time.Now()\n173|\t}\n174|\treturn host.Now()\n175|}\n176|\n177|// splitFrame separates the single response line from anything following\n178|// it. oversize reports a first line beyond MaxFrameBytes; extra reports\n179|// any bytes after the first line terminator. An empty line is neither:\n180|// it is a missing response, judged with the exit code by the caller.\n181|//\n182|// The checks are length-only and exact: stdout capture holds at most\n183|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n184|// trailing byte, is always visible in the captured length. No separate\n185|// truncation flag participates; a narrowed or dropped disjunct here\n186|// would be equivalent, not coverage.\n187|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n188|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n189|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n190|\t}\n191|\treturn captured, len(captured) > MaxFrameBytes, false\n192|}\n193|\n194|// Call dispatches one operation: it frames the request, starts one plugin\n195|// process, enforces the request deadline, and interprets the single\n196|// response frame. Encode failures return before the Runner is touched, so\n197|// an unknown operation never starts a process. A success envelope returns\n198|// its body; a failure envelope returns the bound child error; anything\n199|// else returns a local failure that trusts nothing from the plugin.\n200|//\n201|// Deadline accounting is exact: the wait ends under a context cut at the\n202|// request deadline, and provider_timeout is reported only when that\n203|// instant actually passed. A parent cancellation first, or any other\n204|// runner failure with time remaining, is provider_process_failed. An\n205|// empty stdout with time remaining is a missing response:\n206|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n207|// An empty stdout after the deadline passed is provider_timeout, and a\n208|// valid frame governs regardless of lateness or exit status.\n209|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n210|\tif host.Runner == nil {\n211|\t\tfailure, err := failInvalid(\"host has no runner\")\n212|\t\tif err != nil {\n213|\t\t\treturn Response{}, err\n214|\t\t}\n215|\t\treturn Response{}, failure\n216|\t}\n217|\tframe, deadline, err := encodeFrame(req, host.now())\n218|\tif err != nil {\n219|\t\treturn Response{}, err\n220|\t}\n221|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n222|\tdefer cancel()\n223|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n224|\tif err != nil {\n225|\t\tnow := host.now()\n226|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n227|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n228|\t\t\tif fault != nil {\n229|\t\t\t\treturn Response{}, fault\n230|\t\t\t}\n231|\t\t\treturn Response{}, failure\n232|\t\t}\n233|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n234|\t\tif fault != nil {\n235|\t\t\treturn Response{}, fault\n236|\t\t}\n237|\t\treturn Response{}, failure\n238|\t}\n239|\tline, oversize, extra := splitFrame(result.Stdout)\n240|\tif oversize {\n241|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n242|\t\tif fault != nil {\n243|\t\t\treturn Response{}, fault\n244|\t\t}\n245|\t\treturn Response{}, failure\n246|\t}\n247|\tif extra {\n248|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n249|\t\tif fault != nil {\n250|\t\t\treturn Response{}, fault\n251|\t\t}\n252|\t\treturn Response{}, failure\n253|\t}\n254|\tif len(line) == 0 {\n255|\t\t// No valid response arrived. When the request deadline passed,\n256|\t\t// this is the timeout even if the process also exited badly:\n257|\t\t// the host waited the full allowance and got nothing usable.\n258|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n259|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n260|\t\t\tif fault != nil {\n261|\t\t\t\treturn Response{}, fault\n262|\t\t\t}\n263|\t\t\treturn Response{}, failure\n264|\t\t}\n265|\t\tif result.ExitCode != 0 {\n266|\t\t\tfailure, fault := failProcess(\"plugin exited without a response\", nil)\n267|\t\t\tif fault != nil {\n268|\t\t\t\treturn Response{}, fault\n269|\t\t\t}\n270|\t\t\treturn Response{}, failure\n271|\t\t}\n272|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n273|\t\tif fault != nil {\n274|\t\t\treturn Response{}, fault\n275|\t\t}\n276|\t\treturn Response{}, failure\n277|\t}\n278|\treturn DecodeResponse(line, req.RequestID)\n279|}"}}}
