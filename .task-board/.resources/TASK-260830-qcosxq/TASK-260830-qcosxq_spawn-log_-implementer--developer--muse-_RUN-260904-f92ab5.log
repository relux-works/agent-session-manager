{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dad1","stream":{"kind":"session","id":"01a06ed9-7c63-74b3-b8db-139ac4482e30"},"sequence":3011,"recorded_at":1780531400006017,"record_type":"event","durability":"durable","causation_id":"680c30af-893a-4c96-ab8b-878d612e53c6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"680c30af-893a-4c96-ab8b-878d612e53c6","run_stream":{"kind":"run","id":"680c30af-893a-4c96-ab8b-878d612e53c6"},"task_stream":{"kind":"task","id":"17be4e69-6ca1-48a7-a15d-1f90a7efb03f"},"task_id":"17be4e69-6ca1-48a7-a15d-1f90a7efb03f","event":{"kind":"output","task_id":"17be4e69-6ca1-48a7-a15d-1f90a7efb03f","chunk":"{\n  \"chunk_id\": \"exec-87-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport ast\\ntree = ast.parse(open('/tmp/mutant_sweep.py').read())\\nfound = None\\nfor node in ast.walk(tree):\\n    if isinstance(node, ast.Assign) and getattr(node.targets[0], 'id', '') == 'MUTANTS':\\n        found = node.value\\n        break\\npairs = []\\nfor elt in found.elts:\\n    name, path, old, new = (ast.literal_eval(e) for e in elt.elts[:4])\\n    pairs.append((name, path, old, new))\\nprint(f\\\"extracted {len(pairs)} pairs\\\")\\nfrom collections import defaultdict\\nby_file = defaultdict(list)\\nfor name, path, old, new in pairs:\\n    by_file[path].append((name, old, new))\\nfor path, lst in by_file.items():\\n    s = open(path).read()\\n    for name, old, new in reversed(lst):\\n        c = s.count(new)\\n        if c >= 1:\\n            s = s.replace(new, old)\\n            print(f\\\"reversed {name} ({c}x)\\\")\\n        else:\\n            print(f\\\"ABSENT {name}\\\")\\n    open(path, 'w').write(s)\\nEOF\",\n  \"description\": \"Reverse mutants via AST extraction\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"extracted 25 pairs\\nreversed M24-trailing-data-tolerated (1x)\\nreversed M12-mismatch-reported-as-unusable (1x)\\nreversed M11-minor-version-accepted (1x)\\nreversed M10-request-id-uncorrelated (1x)\\nreversed M09-unknown-member-accepted (1x)\\nreversed M08-duplicate-member-accepted (1x)\\nreversed M07-utf8-unchecked (1x)\\nABSENT M06-frame-limit-doubled\\nreversed M05-body-array-accepted (1x)\\nreversed M04-request-id-unchecked (1x)\\nreversed M03-deadline-always-future (1x)\\nreversed M02-dispatch-accept-all (1x)\\nreversed M01-registry-drop-doctor (1x)\\nreversed M25-parent-cancel-reported-as-timeout (1x)\\nreversed M15-extra-line-tolerated (1x)\\nreversed M14-missing-response-swapped (1x)\\nreversed M13-runner-errors-always-timeout (1x)\\nreversed M23-malformed-operation-id-accepted (1x)\\nreversed M22-terminal-token-rule-dropped (1x)\\nreversed M20-plan-digest-grammar-dropped (1x)\\nreversed M19-token-length-dropped (2x)\\nreversed M18-authority-identity-dropped (1x)\\nreversed M17-prepared-nullability-dropped (1x)\\nreversed M16-unknown-returned-as-state (1x)\\nreversed M21-group-kill-removed (1x)\\n\",\n  \"original_output_bytes\": 1072,\n  \"original_output_tokens\": 268,\n  \"truncated\": false\n}"}}}
