re\n271|\t\t}\n272|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n273|\t\tif fault != nil {\n274|\t\t\treturn Response{}, fault\n275|\t\t}\n276|\t\treturn Response{}, failure\n277|\t}\n278|\treturn DecodeResponse(line, req.RequestID)\n279|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
