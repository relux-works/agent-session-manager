sible in the captured length. No separate\n185|// truncation flag participates; a narrowed or dropped disjunct here\n186|// would be equivalent, not coverage.\n187|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n188|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n189|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n190|\t}\n191|\treturn captured, len(captured) > MaxFrameBytes, false\n192|}\n193|\n194|// Call dispatches one operation: it frames the request, starts one plugin\n195|// process, enforces the request deadline, and interprets the single\n196|// response frame. Encode failures return before the Runner is touched, so\n197|// an unknown operation never starts a process. A success envelope returns\n198|// its body; a failure envelope returns the bound child error; anything\n199|// else returns a local failure that trusts nothing from the plugin.\n200|//\n201|// Deadline accounting is exact: the wait ends under a context cut at the\n202|// request deadline, and provider_timeout is reported only when that\n203|// instant actually passed. A parent cancellation first, or any other\n204|// runner failure with time remaining, is provider_process_failed. An\n205|// empty stdout with time remaining is a missing response:\n206|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n207|// An empty stdout after the deadline passed is provider_timeout, and a\n208|// valid frame governs regardless of lateness or exit status.\n209|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n210|\tif host.Runner == nil {\n211|\t\tfailure, err := failInvalid(\"host has no runner\")\n212|\t\tif err != nil {\n213|\t\t\treturn Response{}, err\n214|\t\t}\n215|\t\treturn Response{}, failure\n216|\t}\n217|\tframe, deadline, err := encodeFrame(req, host.now())\n218|\tif err != nil {\n219|\t\treturn Response{}, err\n220|\t}\n221|\tdeadlineCtx, c