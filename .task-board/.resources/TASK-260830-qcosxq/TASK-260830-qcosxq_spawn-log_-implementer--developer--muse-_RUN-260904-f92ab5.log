err(t *testing.T) {\\n\\tsecret := \\\"[REDACTED]\\\"\\n\\trunner := &scriptRunner{steps: []scriptStep{{\\n\\t\\tStdout:   successFrame(t, testRequestID, `{\\\"provider_id\\\":\\\"pi\\\"}`),\\n\\t\\tStderr:   []byte(\\\"diagnostic: using \\\" + secret + \\\"\\\\n\\\"),\\n\\t\\tExitCode: 0,\\n\\t}}}\\n\\thost := liveHost(runner)\\n\\tif _, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", liveRequest(t)); err != nil {\\n\\t\\tt.Fatalf(\\\"Call with stderr diagnostics: %v\\\", err)\\n\\t}\\n\\n\\tbad := &scriptRunner{steps: []scriptStep{{Stdout: []byte(\\\"garbage\\\\n\\\"), Stderr: []byte(secret + \\\"\\\\n\\\"), ExitCode: 1}}}\\n\\thost = liveHost(bad)\\n\\t_, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", liveRequest(t))\\n\\tif failureCode(t, err) != \\\"provider_protocol_error\\\" {\\n\\t\\tt.Fatalf(\\\"Call code = %v, want provider_protocol_error\\\", err)\\n\\t\\tt.Fatalf(\\\"oversize stdout is %d bytes, want over %d\\\", len(frame), MaxFrameBytes)\\n\\t}\\n\\trunner := &scriptRunner{steps: []scriptStep{{Stdout: frame, ExitCode: 0}}}\\n\\thost := liveHost(runner)\\n\\t_, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", liveRequest(t))\\n// property: two calls start two processes with distinct request IDs.\\nfunc TestCallOneProcessPerCall(t *testing.T) {\\n\\trunner := &scriptRunner{steps: []scriptStep{\\n\\t\\tsuccessResult(t, testRequestID, `{}`),\\n\\t\\tsuccessResult(t, testOtherID, `{}`),\\n\\t}}\\n\\thost := liveHost(runner)\\n\\tfirst := liveRequest(t)\\n\\tif _, err := host.Call(context.Background(), \\\"/plugins/ax-provider-pi\\\", first); err != nil {\\n====\\nfunc TestStatusRecoveryAcrossProcesses(t *testing.T) {\\n\\tcommitted := statusBody(testMaterializationID, testTransactionID, testAuthorityID, testPlanID, \\\"committed\\\", \\\"null\\\", testDiscovery)\\n\\trunner := &scriptRunner{steps: []scriptStep{\\n\\t\\t{Stdout: successFrame(t, testRequestID, string(preparedBody())), ExitCode: 0},\\n\\t\\t{Stdout: successFrame(t, testOtherID, string(committed)), ExitCode: 0},\\n\\t}}\\n\\trunner := &scriptRunner{\\n\\t\\terrs:    []error{context.DeadlineExceeded},\\n\\t\\tsteps: []scriptStep{{Stdout: successFrame(t, testOtherID, string(preparedBody())), ExitCode: 0}},\\n\\t}\\n\\t// The runner error above fires with a live deadline, so it is a\\nfunc TestUnknownTransactionQuarantinesThroughCall(t *testing.T) {\\n\\tunknown := statusBody(testMaterializationID, testTransactionID, testAuthorityID, \\\"null\\\", \\\"unknown\\\", \\\"null\\\", \\\"null\\\")\\n\\trunner := &scriptRunner{steps: []scriptStep{{Stdout: successFrame(t, testRequestID, string(unknown)), ExitCode: 0}}}\\n\\thost := liveHost(runner)\\n\\treq := liveRequest(t)\\n\",\n  \"original_output_bytes\": 3246,\n  \"original_output_tokens\": 812,\n  \"truncated\": false\n}"}}}
