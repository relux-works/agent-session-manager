  "schema": "urn:ax:schema:transfer-manifest",
  "schema_version": "1.0.0",
  "manifest_id": "sha256:88d93f20f978b92e75d35e67ebd5a41b90ff1afe106363b05c0f7b08614eb4cf",
  "kind": "workspace_tree",
  "subject_id": "0198f4c8-6c30-7d44-8d5e-1234567890ab",
