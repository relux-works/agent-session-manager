func TestExecGet_FullPreset(t *testing.T) {
	bd := setupQueryTestBoard(t)
	boardDir = bd

	out := captureOutput(t, func() {
		err := runQuery(queryCmd, []string{"get(" + testTask1ID + ") { full }"})
		if err != nil {
			t.Fatalf("runQuery: %v", err)
		}
	})

	var result map[string]interface{}
	if err := json.Unmarshal([]byte(out), &result); err != nil {
		t.Fatalf("invalid JSON: %v\noutput: %s", err, out)
	}

	// Full should have all fields
	allFields := []string{"id", "type", "name", "title", "status", "estimate", "observability", "parent", "assignee",
		"description", "scope", "ac", "blockedBy", "blocks", "derivedBlockedBy", "derivedBlocks", "checklist", "notes",
		"created", "updated", "isBlocked", "isAdvisoryBlocked", "children"}
	for _, f := range allFields {
		if _, ok := result[f]; !ok {
			t.Errorf("full preset missing field %q", f)
		}
	}
}

