+			atLimit: func() map[string]any {
+				object := validBlobDescriptorObject()
+				object["media_type"] = "application/octet-stream"
+				return object
+			},
+			overLimit: func() map[string]any {
+				object := validBlobDescriptorObject()
+				object["media_type"] = "Application/Octet-Stream"
