+				return genericExtensionIdentityObject(map[string]any{"a.b": true})
+			},
+			overLimit: func() map[string]any {
+				return genericExtensionIdentityObject(map[string]any{"nodot": true})
+			},
+		},
+		{
+			name:      "migration provenance canonical semver",
