+func TestDeclaredBoundaryConstraintsReachBothIdentityEntries(t *testing.T) {
+	tests := []struct {
+		name      string
+		selfField SelfField
+		atLimit   func() map[string]any
+		overLimit func() map[string]any
+	}{
