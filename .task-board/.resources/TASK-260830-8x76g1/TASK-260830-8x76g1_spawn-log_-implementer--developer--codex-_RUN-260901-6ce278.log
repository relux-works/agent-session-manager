+	}
+	return map[string]any{
+		"format":             "git_index",
+		"version":            json.Number("2"),
+		"blob_id":            digestWithDigit('5'),
+		"blob_descriptor_id": digestWithDigit('6'),
+		"entries":            entries,
+		"entry_count":        json.Number(strconv.Itoa(count)),
+	}
