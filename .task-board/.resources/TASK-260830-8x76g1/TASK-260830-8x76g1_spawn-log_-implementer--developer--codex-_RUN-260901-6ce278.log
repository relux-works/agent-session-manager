+func transferManifestWithMode(mode int) map[string]any {
+	object := validTransferManifestObject("workspace_tree")
+	object["entries"] = []any{map[string]any{
+		"path": "directory",
+		"type": "directory",
+		"mode": json.Number(strconv.Itoa(mode)),
+	}}
+	return object
+}
