+	launchPlan["env_names"] = []any{}
+	launchPlan["env_literals"] = literals
+	return object
+}
+
+func environmentLiterals(count int) map[string]any {
+	literals := make(map[string]any, count)
+	for index := range count {
+		literals[fmt.Sprintf("VALUE_%03d", index)] = "x"
+	}
+	return literals
+}
