+		members[index] = map[string]any{
+			"workspace_id":               fmt.Sprintf("0198f4c8-7d40-7e55-8e6f-%012x", index),
+			"kind":                       "managed_tree",
+			"group_relative_path":        fmt.Sprintf("tree-%03d", index),
