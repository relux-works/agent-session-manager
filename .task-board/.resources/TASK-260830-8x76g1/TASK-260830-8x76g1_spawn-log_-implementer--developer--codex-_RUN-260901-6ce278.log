+
+func encodedArgvBoundary(lastLength int) []any {
+	argv := make([]any, 16)
+	for index := range 15 {
+		argv[index] = strings.Repeat("x", 4_093)
+	}
+	argv[15] = strings.Repeat("x", lastLength)
+	return argv
+}
