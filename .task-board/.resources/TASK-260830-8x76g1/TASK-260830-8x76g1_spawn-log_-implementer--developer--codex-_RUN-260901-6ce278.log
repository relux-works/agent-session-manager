+			selfField: SelfManifestID,
+			atLimit:   func() map[string]any { return transferManifestWithSymlinkTarget("sub/child/escape") },
+			overLimit: func() map[string]any { return transferManifestWithSymlinkTarget(`sub\..\..\escape`) },
+		},
+		{
