+}
+
+func primaryOwnerSessionRecord(goalID string) map[string]any {
+	object := taskBoardSessionRecord("TASK-260830-8x76g1")
+	reference := object["task_board"].(map[string]any)
+	reference["launch_mode"] = "primary_owner"
