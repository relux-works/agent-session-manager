 func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {
+	object, selfField, _, err := prepareObjectIdentity(input)
+	if err != nil {
+		return scalar.Digest{}, "", err
+	}
+	return calculatePreparedObjectIdentity(object, selfField)
+}
