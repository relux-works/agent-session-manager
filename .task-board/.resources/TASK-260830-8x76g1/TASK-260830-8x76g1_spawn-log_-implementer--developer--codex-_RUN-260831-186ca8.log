+	if err != nil || verified != digest || verifiedField != SelfManifestID {
+		t.Fatalf("VerifyObjectIdentity(closed git workspace snapshot) = %q/%q, %v; want %q/%q", verified, verifiedField, err, digest, SelfManifestID)
+	}
+}
