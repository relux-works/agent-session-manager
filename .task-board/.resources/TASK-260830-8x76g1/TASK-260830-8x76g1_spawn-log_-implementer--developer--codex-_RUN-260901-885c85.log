+			},
+			want: "member target_path must be a UTF-8 string",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			assertIdentityEntriesRefuseWithReason(t, mustJSON(t, test.makeObject(t)), test.selfField, test.want)
+		})
