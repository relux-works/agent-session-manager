+func workspaceTreeWithEveryEntryVariant() map[string]any {
+	object := validTransferManifestObject("workspace_tree")
+	object["entries"] = []any{
+		map[string]any{"path": "dir", "type": "directory", "mode": json.Number("493")},
+		map[string]any{
