+			object := validBlobDescriptorObject()
+			object["media_type"] = ""
+			return object
+		}},
+		{"non-number uint reaches numeric parser", SelfDescriptorID, func() map[string]any {
+			object := validBlobDescriptorObject()
+			object["size"] = "11"
+			return object
