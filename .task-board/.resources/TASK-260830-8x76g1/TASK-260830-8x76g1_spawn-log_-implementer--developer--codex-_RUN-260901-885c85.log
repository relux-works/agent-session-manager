+		"source_checkpoint_id":      digestWithDigit('3'),
+		"source_workspace_group_id": "0198f4c8-af70-7188-8172-1234567890ab",
+		"operation_id":              "0198f4c8-b080-7299-8273-1234567890ab",
+		"provider_fork_mode":        "native",
+		"extensions":                map[string]any{},
+	}
