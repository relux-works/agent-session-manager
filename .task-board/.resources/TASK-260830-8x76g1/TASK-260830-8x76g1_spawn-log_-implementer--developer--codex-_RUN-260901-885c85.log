+	caseCollisionEntry := cloneJSONObject(t, entries[1].(map[string]any))
+	caseCollisionEntry["path"] = "vendor/LIB"
+	index["entries"] = []any{entries[0], caseCollisionEntry, entries[1]}
+	index["entry_count"] = json.Number("3")
