+	caseCollisionSubmodule["repository_identity"] = "relux/LIB"
+	caseCollisionSubmodule["sanitized_url"] = "https://example.com/LIB.git"
+	member["submodules"] = []any{submodules[0], caseCollisionSubmodule}
+	return object
+}
