func validateGitSubmodule(object map[string]any) error {
	if err := requireExactMembers("GitSubmodule", object,
		"path", "repository_identity", "sanitized_url", "gitlink_oid", "initialized", "head", "upstream_ref",
		"object_pack", "index", "working_tree_manifest_id", "submodules", "features", "repo_relative_cwd", "agent_project_config_paths"); err != nil {
		return err
	}
	optionalObjects := []struct {
		member string
		name   string
		check  func(map[string]any) error
	}{
		{"head", "GitHead", validateGitHead},
		{"object_pack", "GitObjectPack", validateGitObjectPack},
		{"index", "GitIndex", validateGitIndex},
		{"features", "GitFeatures", validateGitFeatures},
	}
	for _, nested := range optionalObjects {
		if object[nested.member] != nil {
			if err := validateObjectMember(object, nested.member, nested.name, nested.check); err != nil {
				return err
			}
		}
	}
	if object["submodules"] != nil {
		return validateObjectArray(object, "submodules", 256, "GitSubmodule", validateGitSubmodule)
	}
	return nil
}

