+		"fork_provenance": nil,
+		"extensions":      map[string]any{},
+	}
+}
+
+func clone(value map[string]any) map[string]any {
+	encoded, _ := json.Marshal(value)
+	var copied map[string]any
+	_ = json.Unmarshal(encoded, &copied)
+	return copied
+}
+
+func probe(name string, object map[string]any) {
