func parseTimestampInstant(value string) (time.Time, error) {
	normalized := value
	if value[10] == 't' {
		normalized = value[:10] + "T" + value[11:]
	}
	if strings.HasSuffix(normalized, "z") {
		normalized = normalized[:len(normalized)-1] + "Z"
	}

