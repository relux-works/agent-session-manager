	return json.Marshal(value.String())
}

func (value *DecimalUint64) UnmarshalJSON(data []byte) error {
	candidate, err := decodeJSONString(data, "decimal_uint64")
	if err != nil {
		return err
	}
	parsed, err := ParseDecimalUint64(candidate)
	if err != nil {
		return err
	}
	*value = parsed
	return nil
}

