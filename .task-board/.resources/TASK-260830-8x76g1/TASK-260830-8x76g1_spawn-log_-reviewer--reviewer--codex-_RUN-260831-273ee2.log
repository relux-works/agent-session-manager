exec
/bin/zsh -lc "sed -n '561,860p' internal/canonicaljson/closed_shapes.go; sed -n '861,1160p' internal/canonicaljson/closed_shapes.go; sed -n '1161,1420p' internal/canonicaljson/closed_shapes.go" in /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2wdm5e/worktree
