// validateImmutableObjectShape is the scoped closed-shape gate used by both
// object-identity production entries. Section 10.1 record envelopes admit
// schema-specific fields, so their complete shapes remain with their schema
// owners. Sections 10.2 and 10.4 define complete closed objects here.
func validateImmutableObjectShape(object map[string]any) error {
	schema, err := requiredStringMember(object, "schema")
	if err != nil {
		return err
	}
