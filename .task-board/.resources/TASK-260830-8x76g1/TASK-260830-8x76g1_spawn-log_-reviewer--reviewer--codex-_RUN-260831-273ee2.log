+		_, _, verifyErr := canonicaljson.VerifyObjectIdentity(claimed)
+		verifyAccepted = verifyErr == nil
+		fmt.Printf("%s calculate=accepted verify=%v\n", label, map[bool]string{true: "accepted", false: "refused"}[verifyAccepted])
+	} else {
+		fmt.Printf("%s calculate=refused error=%v\n", label, calculateErr)
+	}
+	return calculateAccepted, verifyAccepted
+}
