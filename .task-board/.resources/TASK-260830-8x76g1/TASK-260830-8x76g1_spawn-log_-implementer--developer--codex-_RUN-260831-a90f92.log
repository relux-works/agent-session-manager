index 0000000000000000000000000000000000000000..13cf35b0b5f6ff06d4a20af1bb17e62717ca7735
--- /dev/null
+++ b/.temp/TASK-260830-8x76g1/review-base/internal/canonicaljson/review_name_test.go
@@ -0,0 +1,9 @@
+package canonicaljson
+
+import "testing"
+
+func TestReviewSessionNameGrammarGate(t *testing.T) {
+	invalid := validSessionRecordV1Object()
+	invalid["name"] = "-payments"
