+`,
+	"ManifestEntry.directory": `
+path	path
+type	exact directory
+mode	uint32[0..4095]
+`,
+	"ManifestEntry.file": `
+path	path
+type	exact file
+mode	uint32[0..4095]
+size	uint53
+blob_id	digest
+blob_descriptor_id	digest
+`,
+	"ManifestEntry.symlink": `
