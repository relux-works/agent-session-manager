+manager_session_ref	string or null; MUST be null in immutable creation record
+board_goal	Board Goal or null; non-null for primary_owner
+native_goal_binding	enum bound, prompt, or none; bound exactly for primary_owner
+extensions	object; reverse-DNS extension keys only
+`,
+	"Session Record Board Identity": `
+kind	enum local or remote
+logical_id	string[1..128]; [A-Za-z0-9][A-Za-z0-9._:-]{0,127}
+remote_url	absolute HTTPS URL or null; tagged by kind and no userinfo, query, or fragment
+extensions	object; reverse-DNS extension keys only
+`,
