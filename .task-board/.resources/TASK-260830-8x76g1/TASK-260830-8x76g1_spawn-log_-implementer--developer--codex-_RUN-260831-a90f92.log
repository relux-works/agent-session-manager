+	} {
+		t.Run(name, func(t *testing.T) {
+			invalid := validSessionRecordV1Object()
+			invalid["name"] = value
+			assertIdentityEntriesRefuseShape(t, mustJSON(t, invalid), SelfRecordID)
+		})
