+entries	ManifestEntry[0..65536]; strictly bytewise sorted with no destination-case collision
+child_manifest_ids	sorted unique digest[0..1024]
+workspace_snapshot	WorkspaceSnapshot or null; non-null only for workspace_group
+provider_identity_record_id	digest or null; non-null only for provider
+task_board_bundle_id	digest or null; non-null only for task_board
+excluded_classes	sorted unique string[0..128]
+created_by_host_id	UUIDv7
+created_at	timestamp
+extensions	object; reverse-DNS extension keys only
+`,
+	"ManifestEntry.directory": `
+path	path
+type	exact directory
+mode	uint32[0..4095]
+`,
+	"ManifestEntry.file": `
+path	path
+type	exact file
+mode	uint32[0..4095]
+size	uint53
+blob_id	digest
+blob_descriptor_id	digest
+`,
+	"ManifestEntry.symlink": `
+path	path
+type	exact symlink
+mode	uint32[0..4095]
+target	string[1..4096]; lexically remains within materialization root
+`,
+	"ManifestEntry.hardlink": `
+path	path
+type	exact hardlink
+mode	uint32[0..4095]
+target_path	path; names an earlier file entry with the same mode
+`,
+	"WorkspaceSnapshot": `
+workspace_group_id	UUIDv7; equals manifest subject
+members	WorkspaceSnapshotMember[1..256]; strict workspace-ID order and no destination-case-colliding group paths
+`,
+	"WorkspaceSnapshotMember.managed_tree": `
+workspace_id	UUIDv7
+kind	exact managed_tree
+group_relative_path	path
+tree_identity	string[1..256]
+tree_manifest_id	digest
+repo_relative_cwd	dot or path
+agent_project_config_paths	sorted unique path[0..256]
+materialization_policy	enum shared_tree or separate_copy
+`,
+	"WorkspaceSnapshotMember.git": `
+workspace_id	UUIDv7
+kind	exact git
+group_relative_path	path
+repository_identity	string[1..256]
+remotes	GitRemote[1..16]; sorted by name with no duplicate
+head	GitHead
+upstream_ref	git-ref or null
+object_pack	GitObjectPack
+index	GitIndex
+working_tree_manifest_id	digest
+submodules	GitSubmodule[0..256]
+features	GitFeatures
+repo_relative_cwd	dot or path
+agent_project_config_paths	sorted unique path[0..256]
+materialization_policy	enum shared_checkout or separate_worktree
+`,
+	"GitRemote": `
+name	string[1..128]; remotes sorted by name with no duplicate
+fetch_url	sanitized-git-URL
+push_url	sanitized-git-URL or null
+`,
+	"GitHead": `
+mode	enum branch, detached, or unborn
+oid	git-oid or null; tagged by mode and matching object format
+ref	git-ref or null; tagged by mode and unborn uses refs/heads/
+`,
+	"GitObjectPack": `
+format	exact git_pack_v2
+object_format	enum sha1 or sha256
+blob_id	digest
+blob_descriptor_id	digest
+object_count	uint53
+inventory_blob_id	digest
+inventory_blob_descriptor_id	digest
+`,
+	"GitIndex": `
+format	exact git_index
+version	enum 2, 3, or 4
+blob_id	digest
+blob_descriptor_id	digest
+entries	GitIndexEntry[0..65536]; sorted by path then stage
+entry_count	uint53; equals entries length
+`,
+	"GitIndexEntry": `
+path	path
+stage	uint8[0..3]
+mode	uint32
+oid	git-oid; matches object format
+intent_to_add	boolean
+skip_worktree	boolean
+assume_unchanged	boolean
+fsmonitor_valid	boolean
+`,
+	"GitSubmodule": `
+path	path; no sibling destination-case collision
+repository_identity	string[1..256]; recursion acyclic by identity
+sanitized_url	sanitized-git-URL
+gitlink_oid	git-oid; equals containing stage-0 mode-160000 entry
+initialized	boolean; tags all following state members
+head	GitHead or null
+upstream_ref	git-ref or null
+object_pack	GitObjectPack or null
+index	GitIndex or null
+working_tree_manifest_id	digest or null
+submodules	GitSubmodule[0..256] or null; depth at most 16 and total at most 256
+features	GitFeatures or null
+repo_relative_cwd	dot or path or null
+agent_project_config_paths	sorted unique path[0..256] or null
+`,
+	"GitFeatures": `
+object_format	enum sha1 or sha256
+filemode	boolean
+symlinks	boolean
+case_sensitive	boolean
+precompose_unicode	boolean
+sparse_checkout	boolean; tags sparse pattern digest pair
+sparse_patterns_blob_id	digest or null
+sparse_patterns_blob_descriptor_id	digest or null
+required_filter_names	sorted unique string[0..64]
+lfs_required	boolean
+`,
+	"MigrationProvenance": `
+schema_id	string
+schema_version	canonical semver
+object_id	digest
+`,
+}
+
+type call struct {
+	shape, member, function string
+}
+
+func main() {
+	parsed, err := parser.ParseFile(token.NewFileSet(), "internal/canonicaljson/closed_shapes.go", nil, 0)
+	must(err)
+	var rows []call
+	for _, declaration := range parsed.Decls {
+		function, ok := declaration.(*ast.FuncDecl)
+		if !ok || function.Body == nil {
+			continue
+		}
+		shapeNames, tracked := shapes[function.Name.Name]
+		if !tracked {
+			continue
+		}
+		var calls [][]string
+		ast.Inspect(function.Body, func(node ast.Node) bool {
+			expression, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			identifier, ok := expression.Fun.(*ast.Ident)
+			if !ok || identifier.Name != "requireExactMembers" {
+				return true
+			}
+			var members []string
+			for _, argument := range expression.Args[2:] {
+				literal, ok := argument.(*ast.BasicLit)
+				if !ok {
+					panic("non-literal member in " + function.Name.Name)
+				}
+				member, err := strconv.Unquote(literal.Value)
+				must(err)
+				members = append(members, member)
+			}
+			calls = append(calls, members)
+			return true
+		})
+		if len(calls) != len(shapeNames) {
+			panic("call count drift in " + function.Name.Name)
+		}
+		for index, members := range calls {
+			for _, member := range members {
+				rows = append(rows, call{shapeNames[index], member, function.Name.Name})
+			}
+		}
+	}
+	sort.Slice(rows, func(i, j int) bool {
+		if rows[i].shape != rows[j].shape {
+			return rows[i].shape < rows[j].shape
+		}
+		return rows[i].member < rows[j].member
+	})
+
+	fmt.Println(`# TASK-260830-8x76g1 — closed-shape per-member constraint enumeration
+
+Normative source: ` + "`relux-works/agent-session-manager-spec`" + ` v0.5.0 at commit
+` + "`28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c`" + `, SPEC.md SHA-256
+` + "`562546d240f0fa3e71b47e6359a002f9892c0efd97e19eb55917527552ac484a`" + `.
+
+Every row below is reachable through ` + "`CalculateObjectIdentity`" + ` and
+` + "`VerifyObjectIdentity`" + ` via ` + "`prepareObjectIdentity -> validateImmutableObjectShape`" + `.
+` + "`TestConstraintEnumerationMatchesRequireExactMembers`" + ` derives the member set from
+the production ` + "`requireExactMembers`" + ` argument lists and requires an exact one-to-one
+artifact row, so a new, removed, or renamed member fails the suite. “Type-only” means the
+pinned SPEC gives that member no additional constraint beyond the stated JSON/common type.
+
+| Shape | Member | Enforced constraint | Production call site | Quoted pinned SPEC text |
+| --- | --- | --- | --- | --- |`)
+
+	metadata := parseDeclarations()
+	seen := map[string]bool{}
+	for _, row := range rows {
+		key := row.shape + "." + row.member
+		quote, ok := metadata[key]
+		if !ok {
+			panic("missing declaration for " + key)
+		}
+		disposition := "Enforced exactly as declared before identity calculation or verification."
+		if key == "MigrationProvenance.schema_id" {
+			disposition = "Type-only: requires a valid UTF-8 JSON string and deliberately adds no non-empty or length rule."
+		}
+		fmt.Printf("| `%s` | `%s` | %s | `%s` | “%s” |\n", row.shape, row.member, disposition, row.function, quote)
+		seen[key] = true
+	}
+	for key := range metadata {
+		if !seen[key] {
+			panic("unused declaration for " + key)
+		}
+	}
+}
+
+func parseDeclarations() map[string]string {
+	result := map[string]string{}
+	for shape, block := range declarations {
+		for _, line := range strings.Split(strings.TrimSpace(block), "\n") {
+			parts := strings.SplitN(line, "\t", 2)
+			if len(parts) != 2 {
+				panic("malformed declaration " + shape + ": " + line)
+			}
+			result[shape+"."+parts[0]] = parts[1]
+		}
+	}
+	return result
+}
+
+func must(err error) {
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
