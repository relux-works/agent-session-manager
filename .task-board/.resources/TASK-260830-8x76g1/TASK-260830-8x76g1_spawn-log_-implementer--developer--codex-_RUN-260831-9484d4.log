+	if err != nil || verified != digest || verifiedField != selfField {
+		t.Fatalf("VerifyObjectIdentity(%s valid shape) = %q/%q, %v; want %q/%q", selfField, verified, verifiedField, err, digest, selfField)
+	}
+}
