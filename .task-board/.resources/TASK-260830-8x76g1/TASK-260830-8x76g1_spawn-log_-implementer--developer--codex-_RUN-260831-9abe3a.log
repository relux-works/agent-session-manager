	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			object := validBlobDescriptorObject()
			test.mutate(object)
			assertIdentityEntriesRefuseShape(t, mustJSON(t, object), SelfDescriptorID)
		})
	}
}

