func identityFuzzRepresentations(nested, canonicalNested []byte, claim string) ([]byte, []byte) {
	first := []byte(fmt.Sprintf(
		`{"record_id":"%s","value":%s,"schema":"urn:ax:schema:session-record","schema_version":"1.0.0"}`,
		claim,
		nested,
	))
	second := []byte(fmt.Sprintf(
		" {\r\n  \"schema_version\" : \"1.0.0\",\r\n  \"schema\" : \"urn:ax:schema:session-record\",\r\n  \"value\" : %s,\r\n  \"record_id\" : \"%s\"\r\n}\r\n",
		canonicalNested,
		claim,
	))
	return first, second
}

