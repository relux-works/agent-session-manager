+	if err != nil {
+		return err
+	}
+	if err := requireExactMembers("Session Record Task-board Reference", object,
+		"bridge_protocol_version", "board", "task_element_id", "launch_mode", "manager_session_ref",
+		"board_goal", "native_goal_binding", "extensions"); err != nil {
+		return err
