+			key := schemaIdentityKey{schema: string(definition.ContractID), version: version}
+			expected[key] = struct{}{}
+			validator, ok := validators[key]
+			if !ok || validator == nil {
+				return fmt.Errorf("missing immutable-object shape validator for %s@%s", key.schema, key.version)
+			}
