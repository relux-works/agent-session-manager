+		"revision":   json.Number("1"),
+		"extensions": map[string]any{},
+	}
+	assertIdentityEntriesAcceptShape(t, mustJSON(t, primaryOwner), SelfRecordID)
+
+	forked := validSessionRecordV1Object()
