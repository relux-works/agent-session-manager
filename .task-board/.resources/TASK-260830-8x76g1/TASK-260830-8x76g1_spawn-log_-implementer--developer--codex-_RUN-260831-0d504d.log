+		{"unsorted environment names", validSessionRecordV1Object(), func(object map[string]any) { object["launch_plan"].(map[string]any)["env_names"] = []any{"Z_KEY", "A_KEY"} }},
+		{"duplicate literal environment", validSessionRecordV1Object(), func(object map[string]any) { object["launch_plan"].(map[string]any)["env_literals"] = map[string]any{"OPENAI_API_KEY": "literal"} }},
