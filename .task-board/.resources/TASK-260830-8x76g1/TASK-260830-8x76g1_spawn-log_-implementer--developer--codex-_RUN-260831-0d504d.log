+		{schema: "urn:ax:schema:checkpoint", version: "1.0.0"},
+		{schema: "urn:ax:schema:tombstone", version: "1.0.0"},
+		{schema: "urn:ax:schema:tombstone-ack", version: "1.0.0"},
+	}
+	for _, key := range keys {
