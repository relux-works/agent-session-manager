+				string(contract.selfField): zeroDigest,
+				"subject_id":         "0198f4c8-3e70-7a11-8a2b-1234567890ab",
+				"created_by_host_id": "0198f4c8-4a10-7b22-8b3c-1234567890ab",
+				"created_at":         "2026-08-19T04:00:00.000Z",
+				"extensions":         map[string]any{},
+			}
