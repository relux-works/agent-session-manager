-func TestCalculateObjectIdentityAcceptsEveryRegisteredVersionForMultiVersionSchemas(t *testing.T) {
+func TestImmutableObjectShapeValidatorCompletenessRejectsDeletedRegisteredSchema(t *testing.T) {
