+	if err != nil {
+		return err
+	}
+	if revision == 0 {
+		return invalidIdentity("Session Record Board Goal revision must be greater than zero")
+	}
+	extensions, err := requireObject(object, "extensions")
+	if err != nil {
+		return err
+	}
+	return validateExtensionsObject(extensions)
+}
