+	expected := make(map[schemaIdentityKey]struct{})
+	for _, definition := range definitions {
+		for _, version := range definition.ContractVersions {
+			key := schemaIdentityKey{schema: string(definition.ContractID), version: version}
+			expected[key] = struct{}{}
