+	validator, ok := immutableObjectShapeValidators[schemaIdentityKey{schema: schema, version: version}]
+	if !ok || validator == nil {
+		return invalidIdentity("no immutable-object shape validator for %s@%s", schema, version)
+	}
+	return validator(object)
+}
