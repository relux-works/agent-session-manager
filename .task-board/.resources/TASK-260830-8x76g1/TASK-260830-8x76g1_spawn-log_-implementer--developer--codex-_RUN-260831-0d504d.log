+	if _, err := requireUUIDv7(object, "created_by_host_id"); err != nil {
+		return err
+	}
+	providerID, err := requireString(object, "provider_id")
+	if err != nil {
+		return err
+	}
+	if _, err := scalar.ParseProviderID(providerID); err != nil {
