   457	func readUTF16Escape(input []byte, start int) (uint16, int, error) {
   458		if start < 0 || start+6 > len(input) || input[start] != '\\' || input[start+1] != 'u' {
   459			return 0, start, invalidJSON("expected UTF-16 escape")
   460		}
   461		value, err := strconv.ParseUint(string(input[start+2:start+6]), 16, 16)
   462		if err != nil {
   463			return 0, start, invalidJSON("malformed UTF-16 escape")
   464		}
   465		return uint16(value), start + 6, nil
   466	}
