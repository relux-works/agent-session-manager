   330	func decodeValue(decoder *json.Decoder) (any, error) {
   331		token, err := decoder.Token()
   332		if err != nil {
   333			return nil, invalidJSON("decode JSON token: %v", err)
   334		}
   335		delimiter, ok := token.(json.Delim)
   336		if !ok {
   337			return token, nil
   338		}
   339	
   340		switch delimiter {
   341		case '{':
   342			object := make(map[string]any)
   343			for decoder.More() {
   344				nameToken, err := decoder.Token()
   345				if err != nil {
   346					return nil, invalidJSON("decode object name: %v", err)
   347				}
   348				name, ok := nameToken.(string)
   349				if !ok {
   350					return nil, invalidJSON("object name is not a string")
   351				}
   352				if _, duplicate := object[name]; duplicate {
   353					return nil, invalidJSON("duplicate object member %q", name)
   354				}
   355				value, err := decodeValue(decoder)
   356				if err != nil {
   357					return nil, err
   358				}
   359				object[name] = value
   360			}
   361			end, err := decoder.Token()
   362			if err != nil || end != json.Delim('}') {
   363				return nil, invalidJSON("decode object terminator: %v", err)
   364			}
   365			return object, nil
   366		case '[':
   367			array := make([]any, 0)
   368			for decoder.More() {
   369				value, err := decodeValue(decoder)
   370				if err != nil {
   371					return nil, err
   372				}
   373				array = append(array, value)
   374			}
   375			end, err := decoder.Token()
   376			if err != nil || end != json.Delim(']') {
   377				return nil, invalidJSON("decode array terminator: %v", err)
   378			}
   379			return array, nil
   380		default:
   381			return nil, invalidJSON("unexpected delimiter %q", delimiter)
   382		}
   383	}
