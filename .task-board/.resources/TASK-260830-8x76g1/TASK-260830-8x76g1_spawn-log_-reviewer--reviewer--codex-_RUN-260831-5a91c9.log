   412	func validateSurrogateEscapes(input []byte) error {
   413		for index := 0; index < len(input); index++ {
   414			if input[index] != '"' {
   415				continue
   416			}
   417			for index++; index < len(input); index++ {
   418				switch input[index] {
   419				case '"':
   420					goto stringComplete
   421				case '\\':
   422					index++
   423					if index >= len(input) {
   424						return invalidJSON("unterminated string escape")
   425					}
   426					if input[index] != 'u' {
   427						continue
   428					}
   429					codeUnit, end, err := readUTF16Escape(input, index-1)
   430					if err != nil {
   431						return err
   432					}
   433					index = end - 1
   434					switch {
   435					case codeUnit >= 0xd800 && codeUnit <= 0xdbff:
   436						second, secondEnd, err := readUTF16Escape(input, end)
   437						if err != nil || second < 0xdc00 || second > 0xdfff {
   438							return invalidJSON("high surrogate escape must be followed by a low surrogate escape")
   439						}
   440						index = secondEnd - 1
   441					case codeUnit >= 0xdc00 && codeUnit <= 0xdfff:
   442						return invalidJSON("lone low surrogate escape is forbidden")
   443					}
   444				case 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
   445					0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
   446					0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
   447					0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f:
   448					return invalidJSON("unescaped control character in string")
   449				}
   450			}
   451			return invalidJSON("unterminated JSON string")
   452		stringComplete:
   453		}
   454		return nil
   455	}
