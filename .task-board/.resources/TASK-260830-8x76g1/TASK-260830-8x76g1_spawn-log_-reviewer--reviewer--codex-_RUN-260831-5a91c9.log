   250	func validateManifestEntries(values []any) error {
   251		previous := ""
   252		for index, value := range values {
   253			entry, err := requireObjectValue(value, fmt.Sprintf("ManifestEntry[%d]", index))
   254			if err != nil {
   255				return err
   256			}
   257			entryType, err := requireEnum(entry, "type", "directory", "file", "symlink", "hardlink")
   258			if err != nil {
   259				return err
   260			}
   261			pathValue, err := requireString(entry, "path")
   262			if err != nil {
   263				return err
   264			}
   265			if _, err := scalar.ParseRelativePath(pathValue); err != nil {
   266				return invalidIdentity("ManifestEntry[%d] path: %v", index, err)
   267			}
   268			if index > 0 && pathValue <= previous {
   269				return invalidIdentity("Transfer Manifest entries must be strictly bytewise path-sorted")
   270			}
   271			previous = pathValue
   272			if _, err := requireUint(entry, "mode", 4095); err != nil {
   273				return err
   274			}
   275	
   276			switch entryType {
   277			case "directory":
   278				err = requireExactMembers(fmt.Sprintf("directory ManifestEntry[%d]", index), entry, "path", "type", "mode")
   279			case "file":
   280				err = requireExactMembers(fmt.Sprintf("file ManifestEntry[%d]", index), entry,
   281					"path", "type", "mode", "size", "blob_id", "blob_descriptor_id")
   282				if err == nil {
   283					_, err = requireUint(entry, "size", scalar.MaxUint53)
   284				}
   285				if err == nil {
   286					err = requireDigest(entry, "blob_id")
   287				}
   288				if err == nil {
   289					err = requireDigest(entry, "blob_descriptor_id")
   290				}
   291			case "symlink":
   292				err = requireExactMembers(fmt.Sprintf("symlink ManifestEntry[%d]", index), entry, "path", "type", "mode", "target")
   293				if err == nil {
   294					target, targetErr := requireString(entry, "target")
   295					if targetErr != nil {
   296						err = targetErr
   297					} else if len(target) > 4096 {
   298						err = invalidIdentity("symlink ManifestEntry[%d] target exceeds 4096 bytes", index)
   299					}
   300				}
   301			case "hardlink":
   302				err = requireExactMembers(fmt.Sprintf("hardlink ManifestEntry[%d]", index), entry, "path", "type", "mode", "target_path")
   303				if err == nil {
   304					target, targetErr := requireString(entry, "target_path")
   305					if targetErr != nil {
   306						err = targetErr
   307					} else if _, targetErr = scalar.ParseRelativePath(target); targetErr != nil {
   308						err = invalidIdentity("hardlink ManifestEntry[%d] target_path: %v", index, targetErr)
   309					}
   310				}
   311			}
   312			if err != nil {
   313				return err
   314			}
   315		}
   316		return nil
   317	}
