+func validInitializedSubmoduleShape(level, maximumDepth int) map[string]any {
+	pathValue := "vendor/lib"
+	if level > 1 {
+		pathValue = fmt.Sprintf("nested-%02d", level)
+	}
+	entries := []any{}
+	submodules := []any{}
+	if level < maximumDepth {
