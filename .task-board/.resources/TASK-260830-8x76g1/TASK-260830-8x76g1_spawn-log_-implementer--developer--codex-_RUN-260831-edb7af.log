+	tooDeep := validGitWorkspaceGroupObject()
+	gitWorkspaceMember(tooDeep)["submodules"] = []any{validInitializedSubmoduleShape(1, 17)}
+	assertIdentityEntriesRefuseShape(t, mustJSON(t, tooDeep), SelfManifestID)
