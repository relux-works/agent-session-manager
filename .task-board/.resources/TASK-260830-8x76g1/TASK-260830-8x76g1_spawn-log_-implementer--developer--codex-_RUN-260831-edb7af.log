+
+	overMaximum := validGitWorkspaceGroupObject()
+	configureSubmoduleForest(gitWorkspaceMember(overMaximum), true)
+	assertIdentityEntriesRefuseShape(t, mustJSON(t, overMaximum), SelfManifestID)
+}
