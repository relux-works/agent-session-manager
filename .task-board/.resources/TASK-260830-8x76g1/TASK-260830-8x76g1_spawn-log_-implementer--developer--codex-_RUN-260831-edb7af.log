+	}
+	return boolean, nil
+}
+
+func nullableString(object map[string]any, name string) (string, bool, error) {
+	value, ok := object[name]
+	if !ok {
+		return "", false, invalidIdentity("identity input requires member %s", name)
+	}
+	if value == nil {
+		return "", false, nil
+	}
+	text, ok := value.(string)
