+func configureSubmoduleForest(member map[string]any, addNested bool) {
+	entries := make([]any, 0, 256)
+	submodules := make([]any, 0, 256)
+	for index := range 256 {
+		pathValue := fmt.Sprintf("modules/%03d", index)
