func validateWindowsAbsolutePath(value string) error {
	if strings.Contains(value, "/") {
		return invalid("absolute-path", "must use native Windows separators")
	}
	if hasDrivePrefix(value) {
		if len(value) < 3 || value[2] != '\\' {
