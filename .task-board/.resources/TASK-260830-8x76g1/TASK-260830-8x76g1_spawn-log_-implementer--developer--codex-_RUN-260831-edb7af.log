+				map[string]any{"name": "a", "fetch_url": "https://example.com/a.git", "push_url": nil},
+			}
+		}},
+		{"index path-stage order", validGitWorkspaceGroupObject, func(object map[string]any) {
+			index := gitWorkspaceMember(object)["index"].(map[string]any)
