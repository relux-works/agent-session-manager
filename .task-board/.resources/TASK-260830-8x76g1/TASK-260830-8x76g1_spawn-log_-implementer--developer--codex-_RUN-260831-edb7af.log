+}
+
+func requireSanitizedGitURL(object map[string]any, name string) error {
+	value, err := requireString(object, name)
+	if err != nil {
+		return err
+	}
+	if _, err := scalar.ParseSanitizedGitURL(value); err != nil {
+		return invalidIdentity("member %s: %v", name, err)
+	}
+	return nil
+}
