+			}
+			snapshot["members"] = append(snapshot["members"].([]any), second)
+			return object
+		}, func(map[string]any) {}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			object := test.object()
+			test.mutate(object)
+			assertIdentityEntriesRefuseShape(t, mustJSON(t, object), SelfManifestID)
