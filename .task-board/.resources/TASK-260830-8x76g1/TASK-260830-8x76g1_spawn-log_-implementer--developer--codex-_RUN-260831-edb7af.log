+		return "", err
+	}
+	if _, err := scalar.ParseGitOID(value); err != nil {
+		return "", invalidIdentity("member %s: %v", name, err)
+	}
+	return value, nil
+}
+
+func requireGitOIDForFormat(object map[string]any, name, objectFormat string) (string, error) {
