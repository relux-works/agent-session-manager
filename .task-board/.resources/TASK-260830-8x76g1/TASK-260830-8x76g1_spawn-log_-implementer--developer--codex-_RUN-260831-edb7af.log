+func TestIdentityEntriesRefuseObjectsAboveEncodedSizeLimit(t *testing.T) {
+	t.Parallel()
+	input := []byte(`{"schema":"urn:ax:schema:session-record","schema_version":"1.0.0","record_id":"` + zeroDigest + `","value":"` + strings.Repeat("x", 5_242_881) + `"}`)
