+		{"malformed head oid", func(object map[string]any) {
+			gitWorkspaceMember(object)["head"].(map[string]any)["oid"] = "not-an-oid"
+		}},
+		{"malformed upstream ref", func(object map[string]any) {
+			gitWorkspaceMember(object)["upstream_ref"] = "HEAD"
