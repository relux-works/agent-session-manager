+			input: `{"schema":"urn:ax:schema:blob","schema_version":"1.0.0","descriptor_id":"` + digest + `","blob_id":"sha256:1111111111111111111111111111111111111111111111111111111111111111","size":1,"media_type":"application/octet-stream","chunks":[{"index":0,"offset":0,"size":1,"chunk_id":"sha256:1111111111111111111111111111111111111111111111111111111111111111","unexpected":true}]}`,
+		},
+		{
+			name: "invalid nested BlobChunk bounds",
+			input: `{"schema":"urn:ax:schema:blob","schema_version":"1.0.0","descriptor_id":"` + digest + `","blob_id":"sha256:1111111111111111111111111111111111111111111111111111111111111111","size":1,"media_type":"application/octet-stream","chunks":[{"index":9,"offset":99,"size":0,"chunk_id":"sha256:1111111111111111111111111111111111111111111111111111111111111111"}]}`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if got, field, err := CalculateObjectIdentity([]byte(test.input)); err == nil {
+				t.Errorf("CalculateObjectIdentity admitted closed-shape violation: digest=%s field=%s", got, field)
+				claimed := strings.Replace(test.input, digest, got.String(), 1)
+				if verified, verifiedField, verifyErr := VerifyObjectIdentity([]byte(claimed)); verifyErr == nil {
+					t.Errorf("VerifyObjectIdentity attested closed-shape violation: digest=%s field=%s", verified, verifiedField)
+				}
+			}
+		})
+	}
