+var _ json.Marshaler = GitRef{}
+var _ json.Unmarshaler = (*GitRef)(nil)
+var _ json.Marshaler = SanitizedGitURL{}
+var _ json.Unmarshaler = (*SanitizedGitURL)(nil)
