src=pathlib.Path('/Users/iv/.codex/sessions/2026/08/31/rollout-2026-08-31T22-35-44-01a0591b-1f95-7943-a69e-e6707d41e923.jsonl')
outdir=pathlib.Path('.temp/TASK-260830-8x76g1/replay-rev4')
outdir.mkdir(parents=True,exist_ok=True)
rows=[json.loads(line) for line in src.open()]
outputs={}
for row in rows:
    item=row.get('payload',{})
    if row.get('type')=='response_item' and item.get('type')=='custom_tool_call_output':
        out=item.get('output',[])
        outputs[item.get('call_id')]=' '.join(x.get('text','') for x in out if isinstance(x,dict))
events=[]; patch_index=0
for row in rows:
    if row.get('type')"'!='"'response_item': continue
    item=row.get('payload',{})
    if item.get('type')"'!='"'custom_tool_call': continue
    src_text=item.get('input','')
    call_id=item.get('call_id')
    if 'tools.apply_patch' in src_text:
        if 'Script completed' not in outputs.get(call_id,''):
            continue
        m=re.search(r'const patch = (\"(?:\\\\.|["'^"'"\\\\])*\");',src_text,re.S)
        if not m: continue
        patch=json.loads(m.group(1))
        targets=[ln for ln in patch.splitlines() if ln.startswith(('*** Add File:','*** Update File:','*** Delete File:'))]
        if targets and all('/worktree/.temp/' in target for target in targets):
            continue
        patch_index+=1
        path=outdir/f'{patch_index:02d}-{call_id}.patch'
        path.write_text(patch)
        events.append({'ordinal':row['ordinal'],'kind':'patch','path':str(path),'call_id':call_id,'targets':targets})
    elif 'exec_command' in src_text:
        m=re.search(r'cmd:(\"(?:\\\\.|["'^"'"\\\\])*\")',src_text,re.S)
        if not m: continue
        cmd=json.loads(m.group(1))
        if cmd.startswith('gofmt -w'):
            events.append({'ordinal':row['ordinal'],'kind':'gofmt','cmd':cmd.split(' && ',1)[0],'call_id':call_id})
