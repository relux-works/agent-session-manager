func numberedStrings(prefix string, count, width int) []any {
	values := make([]any, count)
	for index := range count {
		values[index] = fmt.Sprintf("%s-%0*d", prefix, width, index)
	}
	return values
}

func repeatedValues(value string, count int) []any {
	values := make([]any, count)
	for index := range count {
		values[index] = value
	}
	return values
}

