+func isExecutableTestName(name string) bool {
+	for _, prefix := range []string{"Test", "Fuzz"} {
+		if !strings.HasPrefix(name, prefix) {
+			continue
+		}
+		suffix := name[len(prefix):]
+		if suffix == "" {
+			return true
+		}
+		first, _ := utf8.DecodeRuneInString(suffix)
+		return !unicode.IsLower(first)
+	}
+	return false
+}
+
