+		{"windows-path", []byte(`C:\unsafe\CON.txt`)},
+		{"windows-path", []byte(`C:\unsafe\*.json`)},
+		{"digest", []byte("sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")},
+		{"decimal-uint64", []byte("18446744073709551615")},
