ing, error) {\n39|\tif !utf8.Valid(data) {\n40|\t\treturn \"\", invalid(kind, \"JSON text must be valid UTF-8\")\n41|\t}\n42|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n43|\tvar value *string\n44|\tif err := decoder.Decode(&value); err != nil {\n45|\t\treturn \"\", invalid(kind, \"must be a JSON string\")\n46|\t}\n47|\tif value == nil {\n48|\t\treturn \"\", invalid(kind, \"must not be null\")\n49|\t}\n50|\tvar trailing any\n51|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n52|\t\treturn \"\", invalid(kind, \"must contain one JSON value\")\n53|\t}\n54|\tif hasLoneJSONSurrogate(strings.TrimSpace(string(data))) {\n55|\t\treturn \"\", invalid(kind, \"must not contain a lone Unicode surrogate\")\n56|\t}\n57|\treturn *value, nil\n58|}\n59|\n60|func hasLoneJSONSurrogate(value string) bool {\n61|\tif len(value) < 2 || value[0] != '\"' || value[len(value)-1] != '\"' {\n62|\t\treturn false\n63|\t}\n64|\tfor index := 1; index < len(value)-1; index++ {\n65|\t\tif value[index] != '\\\\' || index+1 >= len(value)-1 {\n66|\t\t\tcontinue\n67|\t\t}\n68|\t\tif value[index+1] != 'u' {\n69|\t\t\tindex++\n70|\t\t\tcontinue\n71|\t\t}\n72|\t\tcode, ok := parseHex16(value[index+2:])\n73|\t\tif !ok {\n74|\t\t\treturn false // json.Decoder already rejects malformed escapes.\n75|\t\t}\n76|\t\tindex += 5\n77|\t\tswitch {\n78|\t\tcase code >= 0xdc00 && code <= 0xdfff:\n79|\t\t\treturn true\n80|\t\tcase code >= 0xd800 && code <= 0xdbff:\n81|\t\t\tif index+6 >= len(value) || value[index+1:index+3] != `\\u` {\n82|\t\t\t\treturn true\n83|\t\t\t}\n84|\t\t\tlow, ok := parseHex16(value[index+3:])\n85|\t\t\tif !ok || low < 0xdc00 || low > 0xdfff {\n86|\t\t\t\treturn true\n87|\t\t\t}\n88|\t\t\tindex += 6\n89|\t\t}\n90|\t}\n91|\treturn false\n92|}\n93|\n94|func parseHex16(value string) (uint16, bool) {\n95|\tif len(value) < 4 {\n96|\t\treturn 0, false\n97|\t}\n98|\tvar result uint16\n99|\tfor index := 0; index < 4; index++ {\n100|\t\tresult <<= 4\n101|\t\tswitch digit := value[index]; {\n102|\t\tcase digit >= '0' && digit <= '9':\n103|\t\t\tresult += uint16(digit - '0')\n104|\t\tcase digit >= 'a' && digit <= 'f':\n105|\t\t\tresult += uint16(digit-'a') + 10\n106|\t\tcase digit >= 'A' && digit <= 'F':\n107|\t\t\tresult += uint16(digit-'A') + 10\n108|\t\tdefault:\n109|\t\t\treturn 0, false\n110|\t\t}\n111|\t}\n112|\treturn result, true\n113|}\n114|\n115|func marshalValidatedString(value, kind string, validate func(string) error) ([]byte, error) {\n116|\tif err := validate(value); err != nil {\n117|\t\treturn nil, err\n118|\t}\n119|\treturn json.Marshal(value)\n120|}\n121|\n122|func marshalValidatedText(value string, validate func(string) error) ([]byte, error) {\n123|\tif err := validate(value); err != nil {\n124|\t\treturn nil, err\n125|\t}\n126|\treturn []byte(value), nil\n127|}"}}}
