closed direction vocabulary.\\nconst (\\n\\tDirectionSourceRead  Direction = \\\"source_read\\\"\\n\\tDirectionTargetWrite Direction = \\\"target_write\\\"\\n\",\n  \"original_output_bytes\": 2707,\n  \"original_output_tokens\": 677,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
