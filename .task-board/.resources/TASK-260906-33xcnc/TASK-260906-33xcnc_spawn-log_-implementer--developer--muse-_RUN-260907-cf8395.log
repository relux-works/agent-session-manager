{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e449","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":4223,"recorded_at":1780531400008441,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"9e441e18-53ad-40db-994c-1e43150832da"},"task_id":"9e441e18-53ad-40db-994c-1e43150832da","event":{"kind":"output","task_id":"9e441e18-53ad-40db-994c-1e43150832da","chunk":"{\n  \"chunk_id\": \"exec-130-1\",\n  \"command\": \"sed -n 294,330p internal/environ/observation.go; echo \\\"===\\\"; grep -n \\\"unknown capability key\\\" -B2 -A8 internal/environ/observation_test.go | head -n 30\",\n  \"description\": \"Read capability tail and swap row\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\tcapabilities := make(map[string]CapabilityResult, len(capabilityOrder))\\n\\tfor _, name := range capabilityOrder {\\n\\t\\tmember, present := members[name]\\n\\t\\tif !present {\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t\\tcapability, ok := checkCapabilityResult(member)\\n\\t\\tif !ok {\\n\\t\\t\\treturn nil, false\\n\\t\\t}\\n\\t\\tcapabilities[name] = capability\\n\\t}\\n\\treturn capabilities, true\\n}\\n\\n// checkCapabilityResult validates one CapabilityResult object.\\n// Available carries a null reason and every other status carries\\n// one: the two directions are separate obligations, so an\\n// available-with-reason vector and a conditional-without-reason\\n// vector are separate rows in the battery.\\nfunc checkCapabilityResult(raw json.RawMessage) (CapabilityResult, bool) {\\n\\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\\n\\tif fault != nil {\\n\\t\\treturn CapabilityResult{}, false\\n\\t}\\n\\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\\n\\t\\t_ = name\\n\\t\\treturn CapabilityResult{}, false\\n\\t}\\n\\tif name, missing := missingMember(members, capabilityRequired); missing {\\n\\t\\t_ = name\\n\\t\\treturn CapabilityResult{}, false\\n\\t}\\n\\tstatus, ok := rawString(members[\\\"status\\\"])\\n\\tif !ok || !validCapabilityStatus(status) {\\n\\t\\treturn CapabilityResult{}, false\\n\\t}\\n===\\n79-\\t\\t{\\\"capabilities\\\", \\\"ninth capability refused\\\", set(\\\"capabilities\\\", nineCapabilitiesJSON(t)), \\\"exact eight-name\\\"},\\n80-\\t\\t{\\\"capabilities\\\", \\\"ninth capability refused\\\", appendMember(t, valid, \\\"capabilities-extra\\\", `{}`), \\\"unknown member\\\"},\\n81:\\t\\t{\\\"capabilities\\\", \\\"unknown capability key\\\", set(\\\"capabilities\\\", unknownCapabilityJSON(t)), \\\"exact eight-name\\\"},\\n82-\\t\\t{\\\"capabilities\\\", \\\"bad status refused\\\", capWith(\\\"ready\\\", `null`, `[]`), \\\"exact eight-name\\\"},\\n83-\\t\\t{\\\"capabilities\\\", \\\"available with reason refused\\\", capWith(\\\"available\\\", jsonQuote(\\\"why\\\"), `[]`), \\\"exact eight-name\\\"},\\n84-\\t\\t{\\\"capabilities\\\", \\\"conditional without reason refused\\\", capWith(\\\"conditional\\\", `null`, `[]`), \\\"exact eight-name\\\"},\\n85-\\t\\t{\\\"capabilities\\\", \\\"conditional with reason admits\\\", capWith(\\\"conditional\\\", jsonQuote(\\\"why\\\"), `[]`), \\\"\\\"},\\n86-\\t\\t{\\\"capabilities\\\", \\\"unsorted evidence refused\\\", capWith(\\\"available\\\", `null`, unsortedEvidence), \\\"exact eight-name\\\"},\\n87-\\t\\t{\\\"capabilities\\\", \\\"duplicated evidence refused\\\", capWith(\\\"available\\\", `null`, duplicatedEvidence), \\\"exact eight-name\\\"},\\n88-\\t\\t{\\\"capabilities\\\", \\\"bad evidence digest refused\\\", capWith(\\\"available\\\", `null`, `[\\\"sha256:zzzz\\\"]`), \\\"exact eight-name\\\"},\\n89-\\t\\t{\\\"authentication_status\\\", \\\"bad auth status\\\", set(\\\"authentication_status\\\", `\\\"signed-in\\\"`), \\\"authentication status\\\"},\\n\",\n  \"original_output_bytes\": 2497,\n  \"original_output_tokens\": 625,\n  \"truncated\": false\n}"}}}
