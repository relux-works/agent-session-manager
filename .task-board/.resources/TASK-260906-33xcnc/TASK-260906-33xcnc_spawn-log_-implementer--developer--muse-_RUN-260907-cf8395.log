{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e209","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":3935,"recorded_at":1780531400007865,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"59be087d-b9ea-464c-af96-ecc802be3594"},"task_id":"59be087d-b9ea-464c-af96-ecc802be3594","event":{"kind":"output","task_id":"59be087d-b9ea-464c-af96-ecc802be3594","chunk":"{\n  \"chunk_id\": \"exec-115-1\",\n  \"command\": \"sed -n 120,360p .github/workflows/ci.yml\",\n  \"description\": \"Read rest of CI workflow\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  race:\\n    name: Race detector\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Test with race detector\\n        run: |\\n          set +e\\n          go test -race ./... -count=1 > race.log 2>&1\\n          code=$?\\n          set -e\\n          cat race.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' race.log)\\\" -gt 0\\n\\n  coverage:\\n    name: Coverage numbers (reported, no floor)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Coverage is a number, not a gate: this job reports per-package\\n      # percentages and refuses only an unreadable or empty result.\\n      - name: Test with coverage\\n        run: |\\n          set +e\\n          go test ./... -cover -count=1 > cover.log 2>&1\\n          code=$?\\n          set -e\\n          cat cover.log\\n          test $code -eq 0\\n          test \\\"$(grep -c 'coverage: ' cover.log)\\\" -gt 0\\n          {\\n            echo \\\"## Coverage\\\"\\n            echo \\\"\\\"\\n            echo \\\"| Package | Coverage |\\\"\\n            echo \\\"| --- | --- |\\\"\\n            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\\\2` | \\\\3 |/' || true\\n            echo \\\"\\\"\\n            echo \\\"Packages without test files (stated bounds, not failures):\\\"\\n            echo \\\"\\\"\\n            grep 'no test files' cover.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 15\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-latest, macos-latest]\\n        package: [internal/secprim, internal/secconftest]\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\\n      # secconftest capabilities line witnesses the probe counters after the\\n      # whole suite. Skips are loud here by construction.\\n      - name: Run fixture package\\n        run: |\\n          set +e\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n          code=$?\\n          set -e\\n          grep '^--- SKIP' fixture.log || echo \\\"no skipped tests\\\"\\n          grep 'secconftest capabilities on' fixture.log || true\\n          {\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n          test $code -eq 0\\n          test \\\"$(grep -c '^--- PASS' fixture.log)\\\" -gt 0\\n\\n  fuzz-smoke:\\n    name: Fuzz smoke (derived targets)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Targets are derived per package from the compiled test binaries,\\n      # never retyped: only names starting with Fuzz are fuzz targets. An\\n      # empty derivation fails the grep and the explicit size check alike,\\n      # and the total count is pinned: a new fuzz target without a CI\\n      # update reddens here instead of going unsmoked.\\n      - name: Derive fuzz targets\\n        run: |\\n          rm -f fuzz-targets.clean\\n          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\\n            go test \\\"./${pkg}\\\" -list '^Fuzz' > \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" 2>&1\\n            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n          done\\n          test -s fuzz-targets.clean\\n          test \\\"$(wc -l < fuzz-targets.clean | tr -d ' ')\\\" -eq 13\\n          cat fuzz-targets.clean\\n\\n      # The secconftest leg of that list must equal the cigate.FuzzTargets\\n      # derivation, which maps each target to the production entry it\\n      # drives. Either side drifting — a target without an entry, or an\\n      # entry without a target — fails the diff before any smoke runs.\\n      - name: Check secconftest list matches the target derivation\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-targets.log\\n          test $code -eq 0\\n          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-targets.log\\n          done\\n\\n      # A -fuzz selector that matches nothing exits 0 with \\\"no fuzz tests\\n      # to fuzz\\\", so exit status alone cannot prove execution. The\\n      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\\n      - name: Smoke each target\\n        run: |\\n          while read -r pkg target; do\\n            go test \\\"./${pkg}\\\" -run='^$' -fuzz=\\\"^${target}$\\\" -fuzztime=100x -parallel=1 -count=1 > \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\" 2>&1\\n            grep -q '^fuzz: elapsed' \\\"fuzz-$(basename \\\"${pkg}\\\")-${target}.log\\\"\\n          done < fuzz-targets.clean\\n\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. Live probe outcomes are never read here;\\n      # ProbeState.Available is consumed by no call site. README prose is\\n      # never capability evidence either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Compile-and-vet only: go vet type-checks test files as well, and no\\n      # step here executes a Windows binary. A green here must never be read\\n      # as behaviour executed on Windows.\\n      - name: Compile for Windows\\n        run: GOOS=windows go build ./...\\n\\n      - name: Vet Windows build (includes test files)\\n        run: GOOS=windows go vet ./...\\n\\n  gates-verdict:\\n    name: All gates green, none skipped\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 5\\n    needs:\\n      - contract-preservation\\n      - lint\\n      - test\\n      - race\\n      - coverage\\n      - fixture-matrix\\n      - fuzz-smoke\\n      - capability-claims\\n      - windows-compile-only\\n    if: always()\\n    steps:\\n      - name: Refuse any non-success dependency\\n        run: |\\n          echo '${{ toJSON(needs) }}' > needs.json\\n          jq . needs.json\\n          jq -e 'to_entries | map(select(.value.result != \\\"success\\\")) | length == 0' needs.json\\n\",\n  \"original_output_bytes\": 8698,\n  \"original_output_tokens\": 2175,\n  \"truncated\": false\n}"}}}
