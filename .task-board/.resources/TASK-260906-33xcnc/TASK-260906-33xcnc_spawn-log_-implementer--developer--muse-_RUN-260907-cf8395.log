{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69f","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":426,"recorded_at":1780531400000847,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"8d53f037-79d4-4f8f-a4a2-1c9b0ac5f9ba"},"task_id":"8d53f037-79d4-4f8f-a4a2-1c9b0ac5f9ba","event":{"kind":"output","task_id":"8d53f037-79d4-4f8f-a4a2-1c9b0ac5f9ba","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/observation_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file batteries the Section 10.8.1 Environment\n14|// Observation gate. No facade validates observation content\n15|// today — dirnode crosses observations as presence and object\n16|// shape only, explicitly deferring content to this leaf — so\n17|// these rows prove new behavior, not agreement. The roster is\n18|// still derived and fail-closed: the required-member list comes\n19|// from environ production, every required member owns at least\n20|// one refusal row, and a row naming a member production no\n21|// longer requires fails as orphaned.\n22|//\n23|// Conjoined rules count twice throughout: sorted-unique evidence\n24|// owns an unsorted-but-unique row AND a sorted-but-duplicated\n25|// row, and reason coherence owns an available-with-reason row\n26|// AND a conditional-without-reason row, so a check enforcing\n27|// only one half cannot pass both.\n28|\n29|// observationRow is one battery vector: the required member it\n30|// violates (\"\" for vocabulary and structural rules), the body,\n31|// and the rule phrase the refusal must carry. An empty phrase\n32|// means the entry accepts and the decoded value is asserted.\n33|type observationRow struct {\n34|\tmember string\n35|\tname   string\n36|\tbody   []byte\n37|\ttext   string\n38|}\n39|\n40|// capabilityValueJSON builds one CapabilityResult with the given\n41|// status, reason literal (already JSON), and evidence literal.\n42|func capabilityValueJSON(status, reason, evidence string) string {\n43|\treturn `{\"status\":` + jsonQuote(status) + `,\"reason_code\":` + reason + `,\"evidence_ids\":` + evidence + `,\"observed_at\":` + jsonQuote(fixtureObservedAt) + `,\"extensions\":{}}`\n44|}\n45|\n46|// observationCorpus mutates each observation member alone\n47|// against an otherwise-valid body.\n48|func observationCorpus(t *testing.T) []observationRow {\n49|\tt.Helper()\n50|\tvalid := validObservationJSON()\n51|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n52|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n53|\tevidencePair := sortedDigests(fixtureEvidenceID, fixtureExecutable)\n54|\tunsortedEvidence := `[\"` + evidencePair[1] + `\",\"` + evidencePair[0] + `\"]`\n55|\tduplicatedEvidence := `[\"` + evidencePair[0] + `\",\"` + evidencePair[0] + `\"]`\n56|\tcapWith := func(status, reason, evidence string) []byte {\n57|\t\tcapabilities := strings.Replace(validCapabilitiesJSON(), availableCapabilityJSON(), capabilityValueJSON(status, reason, evidence), 1)\n58|\t\treturn mutateMember(t, valid, \"capabilities\", capabilities)\n59|\t}\n60|\tsevenCaps := sevenCapabilitiesJSON(t)\n61|\treturn []observationRow{\n62|\t\t{\"\", \"valid\", valid, \"\"},\n63|\t\t{\"schema\", \"missing schema\", drop(\"schema\"), \"misses a required member\"},\n64|\t\t{\"schema\", \"wrong schema\", set(\"schema\", `\"urn:ax:schema:session-adapter-manifest\"`), \"not the environment observation\"},\n65|\t\t{\"schema_version\", \"wrong version\", set(\"schema_version\", `\"2.0.0\"`), \"not 1.0.0\"},\n66|\t\t{\"observation_id\", \"bad observation digest\", set(\"observation_id\", `\"sha256:zzzz\"`), \"not a digest\"},\n67|\t\t{\"host_id\", \"bad host uuid\", set(\"host_id\", `\"not-a-uuid\"`), \"not a UUIDv7\"},\n68|\t\t{\"installation_id\", \"bad installation digest\", set(\"installation_id\", `\"42\"`), \"not a digest\"},\n69|\t\t{\"environment_id\", \"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n70|\t\t{\"environment_id\", \"missing environment id\", drop(\"environment_id\"), \"misses a required member\"},\n71|\t\t{\"environment_version\", \"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n72|\t\t{\"environment_version\", \"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n73|\t\t{\"provider_id\", \"uppercase provider\", set(\"provider_id\", `\"Test-Provider\"`), \"provider-id\"},\n74|\t\t{\"platform\", \"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n75|\t\t{\"platform\", \"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n76|\t\t{\"architecture\", \"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n77|\t\t{\"backend_realm_fingerprint\", \"bad realm digest\", set(\"backend_realm_fingerprint\", `\"null\"`), \"not a digest\"},\n78|\t\t{\"capabilities\", \"seven capabilities refused\", set(\"capabilities\", sevenCaps), \"exact eight-name\"},\n79|\t\t{\"capabilities\", \"ninth capability refused\", set(\"capabilities\", nineCapabilitiesJSON(t)), \"exact eight-name\"},\n80|\t\t{\"capabilities\", \"ninth capability refused\", appendMember(t, valid, \"capabilities-extra\", `{}`), \"unknown member\"},\n81|\t\t{\"capabilities\", \"unknown capability key\", set(\"capabilities\", unknownCapabilityJSON(t)), \"exact eight-name\"},\n82|\t\t{\"capabilities\", \"bad status refused\", capWith(\"ready\", `null`, `[]`), \"exact eight-name\"},\n83|\t\t{\"capabilities\", \"available with reason refused\", capWith(\"available\", jsonQuote(\"why\"), `[]`), \"exact eight-name\"},\n84|\t\t{\"capabilities\", \"conditional without reason refused\", capWith(\"conditional\", `null`, `[]`), \"exact eight-name\"},\n85|\t\t{\"capabilities\", \"conditional with reason admits\", capWith(\"conditional\", jsonQuote(\"why\"), `[]`), \"\"},\n86|\t\t{\"capabilities\", \"unsorted evidence refused\", capWith(\"available\", `null`, unsortedEvidence), \"exact eight-name\"},\n87|\t\t{\"capabilities\", \"duplicated evidence refused\", capWith(\"available\", `null`, duplicatedEvidence), \"exact eight-name\"},\n88|\t\t{\"capabilities\", \"bad evidence digest refused\", capWith(\"available\", `null`, `[\"sha256:zzzz\"]`), \"exact eight-name\"},\n89|\t\t{\"authentication_status\", \"bad auth status\", set(\"authentication_status\", `\"signed-in\"`), \"authentication status\"},\n90|\t\t{\"runtime_status\", \"bad runtime status\", set(\"runtime_status\", `\"sleeping\"`), \"runtime status\"},\n91|\t\t{\"observed_at\", \"bad timestamp\", set(\"observed_at\", `\"yesterday\"`), \"not a timestamp\"},\n92|\t\t{\"observed_at\", \"missing timestamp\", drop(\"observed_at\"), \"misses a required member\"},\n93|\t\t{\"extensions\", \"bad extensions key\", set(\"extensions\", `{\"nodots\":1}`), \"reverse-DNS\"},\n94|\t\t{\"\", \"unknown top member\", appendMember(t, valid, \"score\", `1`), \"unknown member\"},\n95|\t}\n96|}\n97|\n98|// sortedDigests returns two distinct fixture digests in JCS\n99|// (lexicographic) order.\n100|func sortedDigests(first, second string) []string {\n101|\tpair := []string{first, second}\n102|\tsort.Strings(pair)\n103|\tif pair[0] == pair[1] {\n104|\t\tpanic(\"sortedDigests: fixtures collide\")\n105|\t}\n106|\treturn pair\n107|}\n108|\n109|// sevenCapabilitiesJSON returns the capability map without its\n110|// first registry name.\n111|func sevenCapabilitiesJSON(t *testing.T) string {\n112|\tt.Helper()\n113|\tfull := validCapabilitiesJSON()\n114|\twithout := strings.Replace(full, `\"directory_discovery\":`+availableCapabilityJSON()+`,`, \"\", 1)\n115|\tif without == full {\n116|\t\tt.Fatal(\"sevenCapabilitiesJSON: anchor not found\")\n117|\t}\n118|\treturn without\n119|}\n120|\n121|// nineCapabilitiesJSON returns the capability map with a ninth\n122|// valid-valued key: the length arm, distinct from the unknown-key\n123|// arm the swap below exercises.\n124|func nineCapabilitiesJSON(t *testing.T) string {\n125|\tt.Helper()\n126|\tfull := validCapabilitiesJSON()\n127|\tnine := strings.Replace(full, `\"native_resume\":`, `\"extra_surface\":`+availableCapabilityJSON()+`,\"native_resume\":`, 1)\n128|\tif nine == full {\n129|\t\tt.Fatal(\"nineCapabilitiesJSON: anchor not found\")\n130|\t}\n131|\treturn nine\n132|}\n133|\n134|// unknownCapabilityJSON returns the eight-name map with one key\n135|// swapped for an unregistered name.\n136|func unknownCapabilityJSON(t *testing.T) string {\n137|\tt.Helper()\n138|\tfull := validCapabilitiesJSON()\n139|\tswapped := strings.Replace(full, `\"directory_discovery\"`, `\"directory_exploration\"`, 1)\n140|\tif swapped == full {\n141|\t\tt.Fatal(\"unknownCapabilityJSON: anchor not found\")\n142|\t}\n143|\treturn swapped\n144|}\n145|\n146|// TestObservationRosterIsClosed requires every derived required\n147|// member to own at least one row, and every row to name a\n148|// derived member (or \"\" for vocabulary and structural rules).\n149|func TestObservationRosterIsClosed(t *testing.T) {\n150|\trequired := deriveRequiredList(t, \"environ\", \"observation.go\", \"observationRequired\")\n151|\tderived := map[string]bool{}\n152|\tfor _, member := range required {\n153|\t\tderived[member] = true\n154|\t}\n155|\tcovered := map[string]bool{}\n156|\tfor _, row := range observationCorpus(t) {\n157|\t\tif row.member == \"\" {\n158|\t\t\tcontinue\n159|\t\t}\n160|\t\tif !derived[row.member] {\n161|\t\t\tt.Fatalf(\"row %q names underived member %q\", row.name, row.member)\n162|\t\t}\n163|\t\tcovered[row.member] = true\n164|\t}\n165|\tfor _, member := range required {\n166|\t\tif !covered[member] {\n167|\t\t\tt.Errorf(\"derived required member %q owns no battery row\", member)\n168|\t\t}\n169|\t}\n170|}\n171|\n172|// TestDecodeEnvironmentObservation drives the corpus through the\n173|// production entry: accepts decode to the fixture values, and\n174|// every refusal carries its full rule rendering.\n175|func TestDecodeEnvironmentObservation(t *testing.T) {\n176|\tfor _, row := range observationCorpus(t) {\n177|\t\tt.Run(row.name, func(t *testing.T) {\n178|\t\t\tobservation, err := environ.DecodeEnvironmentObservation(row.body)\n179|\t\t\tif row.text == \"\" {\n180|\t\t\t\tif err != nil {\n181|\t\t\t\t\tt.Fatalf(\"refused %s: %v\", row.body, err)\n182|\t\t\t\t}\n183|\t\t\t\tassertObservationFixture(t, observation)\n184|\t\t\t\treturn\n185|\t\t\t}\n186|\t\t\tif err == nil {\n187|\t\t\t\tt.Fatalf(\"admitted %s, want rule %q\", row.body, row.text)\n188|\t\t\t}\n189|\t\t\tif !strings.Contains(err.Error(), row.text) {\n190|\t\t\t\tt.Fatalf(\"error = %v, want rule %q\", err, row.text)\n191|\t\t\t}\n192|\t\t})\n193|\t}\n194|}\n195|\n196|// assertObservationFixture requires the decoded accept to carry\n197|// the shared fixture identities: the verdict is accept AND the\n198|// values are the fixture's, so a decoder that accepts while\n199|// misreading a member cannot pass.\n200|func assertObservationFixture(t *testing.T, observation environ.Observation) {\n201|\tt.Helper()\n202|\tif observation.ObservationID != fixtureObserveID {\n203|\t\tt.Fatalf(\"observation id = %q, want %q\", observation.ObservationID, fixtureObserveID)\n204|\t}\n205|\tif observation.HostID != fixtureHostID {\n206|\t\tt.Fatalf(\"host id = %q, want %q\", observation.HostID, fixtureHostID)\n207|\t}\n208|\tif observation.InstallationID != fixtureInstallID {\n209|\t\tt.Fatalf(\"installation id = %q, want %q\", observation.InstallationID, fixtureInstallID)\n210|\t}\n211|\tif observation.EnvironmentID != fixtureEnvironmentID {\n212|\t\tt.Fatalf(\"environment id = %q, want %q\", observation.EnvironmentID, fixtureEnvironmentID)\n213|\t}\n214|\tif observation.ProviderID != fixtureProviderID {\n215|\t\tt.Fatalf(\"provider id = %q, want %q\", observation.ProviderID, fixtureProviderID)\n216|\t}\n217|\tif len(observation.Capabilities) != 8 {\n218|\t\tt.Fatalf(\"capabilities = %d entries, want the exact eight\", len(observation.Capabilities))\n219|\t}\n220|}\n221|\n222|// TestDirectoryCapabilityTableIsShared requires the environ and\n223|// dirnode directory-capability tables to be literally equal. The\n224|// adapter fifteen-name and provider seven-name tables share the\n225|// symbol name but are different rules in different stories, so\n226|// they are out of scope here by rule identity, not by silence:\n227|// this comparison names its files.\n228|func TestDirectoryCapabilityTableIsShared(t *testing.T) {\n229|\tmine := deriveRequiredList(t, \"environ\", \"observation.go\", \"capabilityOrder\")\n230|\ttheirs := deriveRequiredList(t, \"dirnode\", \"manifest.go\", \"capabilityOrder\")\n231|\tif !reflect.DeepEqual(mine, theirs) {\n232|\t\tt.Fatalf(\"directory capability tables differ:\\nenviron: %q\\ndirnode:  %q\", mine, theirs)\n233|\t}\n234|\tif len(mine) != 8 {\n235|\t\tt.Fatalf(\"directory capability table has %d names, want the exact eight\", len(mine))\n236|\t}\n237|}\n238|\n239|// TestArchitectureTableIsShared requires the three architecture\n240|// tables in scope to be literally equal.\n241|func TestArchitectureTableIsShared(t *testing.T) {\n242|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleArchitectures\")\n243|\tadapter := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleArchitectures\")\n244|\tnode := deriveRequiredList(t, \"dirnode\", \"probe.go\", \"architectures\")\n245|\tif !reflect.DeepEqual(mine, adapter) || !reflect.DeepEqual(mine, node) {\n246|\t\tt.Fatalf(\"architecture tables differ:\\nenviron: %q\\nsessadapter: %q\\ndirnode: %q\", mine, adapter, node)\n247|\t}\n248|}\n249|\n250|// TestNegotiatedPlatformsParse requires every platform token in\n251|// the derived dirnode v2 vocabulary to parse as a scalar\n252|// platform, and requires the legacy v1 darwin token to refuse:\n253|// the vocabularies are per-major by design, and a token that\n254|// crossed majors silently would break the Section 7.9 binding.\n255|func TestNegotiatedPlatformsParse(t *testing.T) {\n256|\tv2 := deriveRequiredList(t, \"dirnode\", \"probe.go\", \"platformV2\")\n257|\tif len(v2) != 4 {\n258|\t\tt.Fatalf(\"platformV2 has %d tokens, want four\", len(v2))\n259|\t}\n260|\tfor _, token := range v2 {\n261|\t\tif _, err := scalar.ParsePlatform(token); err != nil {\n262|\t\t\tt.Fatalf(\"v2 token %q does not parse as a platform: %v\", token, err)\n263|\t\t}\n264|\t}\n265|\tif _, err := scalar.ParsePlatform(\"darwin\"); err == nil {\n266|\t\tt.Fatal(\"legacy darwin parses as a platform; the majors are no longer separated\")\n267|\t}\n268|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a1","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":427,"recorded_at":1780531400000849,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"8d53f037-79d4-4f8f-a4a2-1c9b0ac5f9ba"},"task_id":"8d53f037-79d4-4f8f-a4a2-1c9b0ac5f9ba","event":{"kind":"completed","task_id":"8d53f037-79d4-4f8f-a4a2-1c9b0ac5f9ba"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a3","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":428,"recorded_at":1780531400000851,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad288147f2194c19a523e088853","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/corpus_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Shared fixtures for the environ boundary battery. This file is in\n18|// the external test package: the facades the battery drives import\n19|// environ, so an in-package battery importing them would be an\n20|// import cycle. Every builder\n21|// emits hand-written JSON with independently chosen literals: no\n22|// builder derives its probe points from production constants, so\n23|// a mutated production constant cannot take its fixture with\n24|// it. The verdict always comes from production; the vectors never\n25|// do. In particular the schema URNs, version strings, member\n26|// names, and vocabulary tokens below are retyped from the pinned\n27|// specification, not referenced from any package under test.\n28|//\n29|// One corpus drives every facade: the same digest, UUIDv7, and\n30|// timestamp identities flow into the sessadapter, dirnode,\n31|// provhost, and canonicaljson entries each battery file drives,\n32|// so a fixture that is valid for one facade and invalid for\n33|// another fails loudly instead of passing per-facade copies that\n34|// never meet.\n35|\n36|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n37|// the digests are syntactically pinned sha256 hex.\n38|const (\n39|\tfixtureHostID        = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n40|\tfixtureOperationID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n41|\tfixtureSubjectID     = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n42|\tfixtureWorkspaceID   = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n43|\tfixtureCreatorHostID = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n44|\tfixtureObservedAt    = \"2026-08-19T04:05:00.000Z\"\n45|\tfixtureValidFrom     = \"2026-01-01T00:00:00.000Z\"\n46|\tfixtureValidUntil    = \"2027-01-01T00:00:00.000Z\"\n47|\tfixtureEnvironmentID = \"test.env\"\n48|\tfixtureAdapterVer    = \"1.2.3\"\n49|\tfixtureProviderID    = \"test-provider\"\n50|)\n51|\n52|// fixtureDigest returns the pinned digest of one seed.\n53|func fixtureDigest(seed string) string {\n54|\tsum := sha256.Sum256([]byte(seed))\n55|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n56|}\n57|\n58|// Standard fixture digests, each naming its seed.\n59|var (\n60|\tfixtureStorePrint  = fixtureDigest(\"test-store-fingerprint\")\n61|\tfixtureInstallID   = fixtureDigest(\"test-installation\")\n62|\tfixtureObserveID   = fixtureDigest(\"test-observation\")\n63|\tfixtureRealmPrint  = fixtureDigest(\"test-realm\")\n64|\tfixtureRecordID    = fixtureDigest(\"test-identity-record\")\n65|\tfixtureEvidenceID  = fixtureDigest(\"test-evidence\")\n66|\tfixtureExecutable  = fixtureDigest(\"test-executable\")\n67|\tfixtureAdapterMain = fixtureDigest(\"test-adapter-manifest\")\n68|)\n69|\n70|// TestSharedFixtureIdentitiesAreValid guards the instrument: a\n71|// malformed shared identity would refuse at every facade for the\n72|// wrong reason, turning the whole battery into a test of the\n73|// fixture rather than the facades.\n74|func TestSharedFixtureIdentitiesAreValid(t *testing.T) {\n75|\tfor _, identity := range []string{fixtureHostID, fixtureOperationID, fixtureSubjectID, fixtureWorkspaceID, fixtureCreatorHostID} {\n76|\t\tif _, err := scalar.ParseUUIDv7(identity); err != nil {\n77|\t\t\tt.Fatalf(\"fixture UUID %q does not parse: %v\", identity, err)\n78|\t\t}\n79|\t}\n80|\tfor _, moment := range []string{fixtureObservedAt, fixtureValidFrom, fixtureValidUntil} {\n81|\t\tif _, err := scalar.ParseTimestamp(moment); err != nil {\n82|\t\t\tt.Fatalf(\"fixture timestamp %q does not parse: %v\", moment, err)\n83|\t\t}\n84|\t}\n85|\tfor _, digest := range []string{fixtureStorePrint, fixtureInstallID, fixtureObserveID, fixtureRealmPrint, fixtureRecordID, fixtureEvidenceID, fixtureExecutable, fixtureAdapterMain} {\n86|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n87|\t\t\tt.Fatalf(\"fixture digest %q does not parse: %v\", digest, err)\n88|\t\t}\n89|\t}\n90|}\n91|\n92|// validTupleJSON is one valid Environment Tuple over the shared\n93|// identities.\n94|func validTupleJSON() string {\n95|\treturn fmt.Sprintf(`{\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":%q}`,\n96|\t\tfixtureEnvironmentID, fixtureStorePrint, fixtureAdapterVer)\n97|}\n98|\n99|// validScanRequestJSON is one valid dirnode scan request carrying\n100|// the given cursor literal (already JSON-encoded by the caller).\n101|func validScanRequestJSON(cursorLiteral string) []byte {\n102|\treturn []byte(fmt.Sprintf(`{\"operation_id\":%q,\"installation_ids\":[%q],\"prior_batch_id\":null,\"cursor\":%s,\"max_instances\":10,\"extensions\":{}}`,\n103|\t\tfixtureOperationID, fixtureInstallID, cursorLiteral))\n104|}\n105|\n106|// validIdentityJSON is one valid Provider Identity Record over\n107|// the shared identities: an Antigravity\n108|// backend_conversation_uuid with a non-null realm fingerprint.\n109|func validIdentityJSON() []byte {\n110|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:provider-identity\",\"schema_version\":\"1.0.0\",\"record_id\":%q,\"subject_id\":%q,\"session_id\":%q,\"provider_id\":\"antigravity\",\"provider_version\":\"1.1.14\",\"provider_version_range\":\">=1.1.14 <1.2.0\",\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"identity_kind\":\"backend_conversation_uuid\",\"logical_workspace_id\":%q,\"backend_realm_fingerprint\":%q,\"opaque_identity\":{},\"created_by_host_id\":%q,\"created_at\":%q,\"extensions\":{}}`,\n111|\t\tfixtureRecordID, fixtureSubjectID, fixtureSubjectID, fixtureWorkspaceID, fixtureRealmPrint, fixtureCreatorHostID, fixtureObservedAt))\n112|}\n113|\n114|// availableCapabilityJSON is one available CapabilityResult with\n115|// null reason.\n116|func availableCapabilityJSON() string {\n117|\treturn fmt.Sprintf(`{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":%q,\"extensions\":{}}`, fixtureObservedAt)\n118|}\n119|\n120|// validCapabilitiesJSON is the exact eight-name capability map\n121|// with every capability available.\n122|func validCapabilitiesJSON() string {\n123|\tnames := []string{\n124|\t\t\"directory_discovery\",\n125|\t\t\"directory_incremental_scan\",\n126|\t\t\"directory_head_digest\",\n127|\t\t\"directory_tail_preview\",\n128|\t\t\"native_title_read\",\n129|\t\t\"native_runtime_observation\",\n130|\t\t\"existing_session_adoption\",\n131|\t\t\"native_resume\",\n132|\t}\n133|\tparts := make([]string, 0, len(names))\n134|\tfor _, name := range names {\n135|\t\tquoted, err := json.Marshal(name)\n136|\t\tif err != nil {\n137|\t\t\tpanic(err)\n138|\t\t}\n139|\t\tparts = append(parts, string(quoted)+\":\"+availableCapabilityJSON())\n140|\t}\n141|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n142|}\n143|\n144|// validObservationJSON is one valid Environment Observation over\n145|// the shared identities.\n146|func validObservationJSON() []byte {\n147|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:environment-observation\",\"schema_version\":\"1.0.0\",\"observation_id\":%q,\"host_id\":%q,\"installation_id\":%q,\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"provider_id\":%q,\"platform\":\"linux\",\"architecture\":\"amd64\",\"backend_realm_fingerprint\":%q,\"capabilities\":%s,\"authentication_status\":\"available\",\"runtime_status\":\"available\",\"observed_at\":%q,\"extensions\":{}}`,\n148|\t\tfixtureObserveID, fixtureHostID, fixtureInstallID, fixtureEnvironmentID, fixtureProviderID, fixtureRealmPrint, validCapabilitiesJSON(), fixtureObservedAt))\n149|}\n150|\n151|// mutateMember returns the object with one top-level member\n152|// replaced by the given raw JSON. The replacement is applied to a\n153|// fresh positive fixture, one mutation at a time: every other\n154|// member holds a valid value, so two distinct rules cannot both\n155|// satisfy one witness.\n156|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n157|\tt.Helper()\n158|\tmembers := decodeTestMembers(t, body)\n159|\tmembers[member] = replacement\n160|\treturn encodeTestMembers(t, members)\n161|}\n162|\n163|// dropMember returns the object without one top-level member.\n164|func dropMember(t *testing.T, body []byte, member string) []byte {\n165|\tt.Helper()\n166|\tmembers := decodeTestMembers(t, body)\n167|\tdelete(members, member)\n168|\treturn encodeTestMembers(t, members)\n169|}\n170|\n171|func decodeTestMembers(t *testing.T, body []byte) map[string]string {\n172|\tt.Helper()\n173|\tvar raw map[string]json.RawMessage\n174|\tif err := json.Unmarshal(body, &raw); err != nil {\n175|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n176|\t}\n177|\tmembers := make(map[string]string, len(raw))\n178|\tfor name, value := range raw {\n179|\t\tmembers[name] = string(value)\n180|\t}\n181|\treturn members\n182|}\n183|\n184|func encodeTestMembers(t *testing.T, members map[string]string) []byte {\n185|\tt.Helper()\n186|\tnames := make([]string, 0, len(members))\n187|\tfor name := range members {\n188|\t\tnames = append(names, name)\n189|\t}\n190|\tsort.Strings(names)\n191|\tparts := make([]string, 0, len(members))\n192|\tfor _, name := range names {\n193|\t\tquoted, err := json.Marshal(name)\n194|\t\tif err != nil {\n195|\t\t\tt.Fatalf(\"encodeTestMembers: %v\", err)\n196|\t\t}\n197|\t\tparts = append(parts, string(quoted)+\":\"+members[name])\n198|\t}\n199|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n200|}\n201|\n202|// TestEntriesAreDeterministic proves the validation entries are\n203|// pure functions of their input bytes: repeated decoding is\n204|// byte-identical, so there is no hidden cache, no clock read, and\n205|// no durable state whose crash recovery would need evidence. The\n206|// scan journal in dirnode is the story's only durable state and\n207|// belongs to the frozen leaf; this library adds none.\n208|func TestEntriesAreDeterministic(t *testing.T) {\n209|\tbodies := [][]byte{[]byte(validTupleJSON()), validObservationJSON(), validIdentityJSON()}\n210|\tfor index, body := range bodies {\n211|\t\tfirst, err := environ.DecodeStrictObject(body)\n212|\t\tif err != nil {\n213|\t\t\tt.Fatalf(\"body %d: first decode: %v\", index, err)\n214|\t\t}\n215|\t\tsecond, err := environ.DecodeStrictObject(body)\n216|\t\tif err != nil {\n217|\t\t\tt.Fatalf(\"body %d: second decode: %v\", index, err)\n218|\t\t}\n219|\t\tif !reflect.DeepEqual(first, second) {\n220|\t\t\tt.Fatalf(\"body %d: repeated decode differs\", index)\n221|\t\t}\n222|\t}\n223|\tfirst, err := environ.DecodeTuple([]byte(validTupleJSON()))\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"tuple first decode: %v\", err)\n226|\t}\n227|\tsecond, err := environ.DecodeTuple([]byte(validTupleJSON()))\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"tuple second decode: %v\", err)\n230|\t}\n231|\tif first != second {\n232|\t\tt.Fatalf(\"tuple repeated decode differs: %+v vs %+v\", first, second)\n233|\t}\n234|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a5","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":429,"recorded_at":1780531400000853,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad288f1721289e0456afa2737db","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/observation_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file batteries the Section 10.8.1 Environment\n14|// Observation gate. No facade validates observation content\n15|// today — dirnode crosses observations as presence and object\n16|// shape only, explicitly deferring content to this leaf — so\n17|// these rows prove new behavior, not agreement. The roster is\n18|// still derived and fail-closed: the required-member list comes\n19|// from environ production, every required member owns at least\n20|// one refusal row, and a row naming a member production no\n21|// longer requires fails as orphaned.\n22|//\n23|// Conjoined rules count twice throughout: sorted-unique evidence\n24|// owns an unsorted-but-unique row AND a sorted-but-duplicated\n25|// row, and reason coherence owns an available-with-reason row\n26|// AND a conditional-without-reason row, so a check enforcing\n27|// only one half cannot pass both.\n28|\n29|// observationRow is one battery vector: the required member it\n30|// violates (\"\" for vocabulary and structural rules), the body,\n31|// and the rule phrase the refusal must carry. An empty phrase\n32|// means the entry accepts and the decoded value is asserted.\n33|type observationRow struct {\n34|\tmember string\n35|\tname   string\n36|\tbody   []byte\n37|\ttext   string\n38|}\n39|\n40|// capabilityValueJSON builds one CapabilityResult with the given\n41|// status, reason literal (already JSON), and evidence literal.\n42|func capabilityValueJSON(status, reason, evidence string) string {\n43|\treturn `{\"status\":` + jsonQuote(status) + `,\"reason_code\":` + reason + `,\"evidence_ids\":` + evidence + `,\"observed_at\":` + jsonQuote(fixtureObservedAt) + `,\"extensions\":{}}`\n44|}\n45|\n46|// observationCorpus mutates each observation member alone\n47|// against an otherwise-valid body.\n48|func observationCorpus(t *testing.T) []observationRow {\n49|\tt.Helper()\n50|\tvalid := validObservationJSON()\n51|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n52|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n53|\tevidencePair := sortedDigests(fixtureEvidenceID, fixtureExecutable)\n54|\tunsortedEvidence := `[\"` + evidencePair[1] + `\",\"` + evidencePair[0] + `\"]`\n55|\tduplicatedEvidence := `[\"` + evidencePair[0] + `\",\"` + evidencePair[0] + `\"]`\n56|\tcapWith := func(status, reason, evidence string) []byte {\n57|\t\tcapabilities := strings.Replace(validCapabilitiesJSON(), availableCapabilityJSON(), capabilityValueJSON(status, reason, evidence), 1)\n58|\t\treturn mutateMember(t, valid, \"capabilities\", capabilities)\n59|\t}\n60|\tsevenCaps := sevenCapabilitiesJSON(t)\n61|\treturn []observationRow{\n62|\t\t{\"\", \"valid\", valid, \"\"},\n63|\t\t{\"schema\", \"missing schema\", drop(\"schema\"), \"misses a required member\"},\n64|\t\t{\"schema\", \"wrong schema\", set(\"schema\", `\"urn:ax:schema:session-adapter-manifest\"`), \"not the environment observation\"},\n65|\t\t{\"schema_version\", \"wrong version\", set(\"schema_version\", `\"2.0.0\"`), \"not 1.0.0\"},\n66|\t\t{\"observation_id\", \"bad observation digest\", set(\"observation_id\", `\"sha256:zzzz\"`), \"not a digest\"},\n67|\t\t{\"host_id\", \"bad host uuid\", set(\"host_id\", `\"not-a-uuid\"`), \"not a UUIDv7\"},\n68|\t\t{\"installation_id\", \"bad installation digest\", set(\"installation_id\", `\"42\"`), \"not a digest\"},\n69|\t\t{\"environment_id\", \"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n70|\t\t{\"environment_id\", \"missing environment id\", drop(\"environment_id\"), \"misses a required member\"},\n71|\t\t{\"environment_version\", \"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n72|\t\t{\"environment_version\", \"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n73|\t\t{\"provider_id\", \"uppercase provider\", set(\"provider_id\", `\"Test-Provider\"`), \"provider-id\"},\n74|\t\t{\"platform\", \"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n75|\t\t{\"platform\", \"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n76|\t\t{\"architecture\", \"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n77|\t\t{\"backend_realm_fingerprint\", \"bad realm digest\", set(\"backend_realm_fingerprint\", `\"null\"`), \"not a digest\"},\n78|\t\t{\"capabilities\", \"seven capabilities refused\", set(\"capabilities\", sevenCaps), \"exact eight-name\"},\n79|\t\t{\"capabilities\", \"ninth capability refused\", set(\"capabilities\", nineCapabilitiesJSON(t)), \"exact eight-name\"},\n80|\t\t{\"capabilities\", \"ninth capability refused\", appendMember(t, valid, \"capabilities-extra\", `{}`), \"unknown member\"},\n81|\t\t{\"capabilities\", \"unknown capability key\", set(\"capabilities\", unknownCapabilityJSON(t)), \"exact eight-name\"},\n82|\t\t{\"capabilities\", \"bad status refused\", capWith(\"ready\", `null`, `[]`), \"exact eight-name\"},\n83|\t\t{\"capabilities\", \"available with reason refused\", capWith(\"available\", jsonQuote(\"why\"), `[]`), \"exact eight-name\"},\n84|\t\t{\"capabilities\", \"conditional without reason refused\", capWith(\"conditional\", `null`, `[]`), \"exact eight-name\"},\n85|\t\t{\"capabilities\", \"conditional with reason admits\", capWith(\"conditional\", jsonQuote(\"why\"), `[]`), \"\"},\n86|\t\t{\"capabilities\", \"unsorted evidence refused\", capWith(\"available\", `null`, unsortedEvidence), \"exact eight-name\"},\n87|\t\t{\"capabilities\", \"duplicated evidence refused\", capWith(\"available\", `null`, duplicatedEvidence), \"exact eight-name\"},\n88|\t\t{\"capabilities\", \"bad evidence digest refused\", capWith(\"available\", `null`, `[\"sha256:zzzz\"]`), \"exact eight-name\"},\n89|\t\t{\"authentication_status\", \"bad auth status\", set(\"authentication_status\", `\"signed-in\"`), \"authentication status\"},\n90|\t\t{\"runtime_status\", \"bad runtime status\", set(\"runtime_status\", `\"sleeping\"`), \"runtime status\"},\n91|\t\t{\"observed_at\", \"bad timestamp\", set(\"observed_at\", `\"yesterday\"`), \"not a timestamp\"},\n92|\t\t{\"observed_at\", \"missing timestamp\", drop(\"observed_at\"), \"misses a required member\"},\n93|\t\t{\"extensions\", \"bad extensions key\", set(\"extensions\", `{\"nodots\":1}`), \"reverse-DNS\"},\n94|\t\t{\"\", \"unknown top member\", appendMember(t, valid, \"score\", `1`), \"unknown member\"},\n95|\t}\n96|}\n97|\n98|// sortedDigests returns two distinct fixture digests in JCS\n99|// (lexicographic) order.\n100|func sortedDigests(first, second string) []string {\n101|\tpair := []string{first, second}\n102|\tsort.Strings(pair)\n103|\tif pair[0] == pair[1] {\n104|\t\tpanic(\"sortedDigests: fixtures collide\")\n105|\t}\n106|\treturn pair\n107|}\n108|\n109|// sevenCapabilitiesJSON returns the capability map without its\n110|// first registry name.\n111|func sevenCapabilitiesJSON(t *testing.T) string {\n112|\tt.Helper()\n113|\tfull := validCapabilitiesJSON()\n114|\twithout := strings.Replace(full, `\"directory_discovery\":`+availableCapabilityJSON()+`,`, \"\", 1)\n115|\tif without == full {\n116|\t\tt.Fatal(\"sevenCapabilitiesJSON: anchor not found\")\n117|\t}\n118|\treturn without\n119|}\n120|\n121|// nineCapabilitiesJSON returns the capability map with a ninth\n122|// valid-valued key: the length arm, distinct from the unknown-key\n123|// arm the swap below exercises.\n124|func nineCapabilitiesJSON(t *testing.T) string {\n125|\tt.Helper()\n126|\tfull := validCapabilitiesJSON()\n127|\tnine := strings.Replace(full, `\"native_resume\":`, `\"extra_surface\":`+availableCapabilityJSON()+`,\"native_resume\":`, 1)\n128|\tif nine == full {\n129|\t\tt.Fatal(\"nineCapabilitiesJSON: anchor not found\")\n130|\t}\n131|\treturn nine\n132|}\n133|\n134|// unknownCapabilityJSON returns the eight-name map with one key\n135|// swapped for an unregistered name.\n136|func unknownCapabilityJSON(t *testing.T) string {\n137|\tt.Helper()\n138|\tfull := validCapabilitiesJSON()\n139|\tswapped := strings.Replace(full, `\"directory_discovery\"`, `\"directory_exploration\"`, 1)\n140|\tif swapped == full {\n141|\t\tt.Fatal(\"unknownCapabilityJSON: anchor not found\")\n142|\t}\n143|\treturn swapped\n144|}\n145|\n146|// TestObservationRosterIsClosed requires every derived required\n147|// member to own at least one row, and every row to name a\n148|// derived member (or \"\" for vocabulary and structural rules).\n149|func TestObservationRosterIsClosed(t *testing.T) {\n150|\trequired := deriveRequiredList(t, \"environ\", \"observation.go\", \"observationRequired\")\n151|\tderived := map[string]bool{}\n152|\tfor _, member := range required {\n153|\t\tderived[member] = true\n154|\t}\n155|\tcovered := map[string]bool{}\n156|\tfor _, row := range observationCorpus(t) {\n157|\t\tif row.member == \"\" {\n158|\t\t\tcontinue\n159|\t\t}\n160|\t\tif !derived[row.member] {\n161|\t\t\tt.Fatalf(\"row %q names underived member %q\", row.name, row.member)\n162|\t\t}\n163|\t\tcovered[row.member] = true\n164|\t}\n165|\tfor _, member := range required {\n166|\t\tif !covered[member] {\n167|\t\t\tt.Errorf(\"derived required member %q owns no battery row\", member)\n168|\t\t}\n169|\t}\n170|}\n171|\n172|// TestDecodeEnvironmentObservation drives the corpus through the\n173|// production entry: accepts decode to the fixture values, and\n174|// every refusal carries its full rule rendering.\n175|func TestDecodeEnvironmentObservation(t *testing.T) {\n176|\tfor _, row := range observationCorpus(t) {\n177|\t\tt.Run(row.name, func(t *testing.T) {\n178|\t\t\tobservation, err := environ.DecodeEnvironmentObservation(row.body)\n179|\t\t\tif row.text == \"\" {\n180|\t\t\t\tif err != nil {\n181|\t\t\t\t\tt.Fatalf(\"refused %s: %v\", row.body, err)\n182|\t\t\t\t}\n183|\t\t\t\tassertObservationFixture(t, observation)\n184|\t\t\t\treturn\n185|\t\t\t}\n186|\t\t\tif err == nil {\n187|\t\t\t\tt.Fatalf(\"admitted %s, want rule %q\", row.body, row.text)\n188|\t\t\t}\n189|\t\t\tif !strings.Contains(err.Error(), row.text) {\n190|\t\t\t\tt.Fatalf(\"error = %v, want rule %q\", err, row.text)\n191|\t\t\t}\n192|\t\t})\n193|\t}\n194|}\n195|\n196|// assertObservationFixture requires the decoded accept to carry\n197|// the shared fixture identities: the verdict is accept AND the\n198|// values are the fixture's, so a decoder that accepts while\n199|// misreading a member cannot pass.\n200|func assertObservationFixture(t *testing.T, observation environ.Observation) {\n201|\tt.Helper()\n202|\tif observation.ObservationID != fixtureObserveID {\n203|\t\tt.Fatalf(\"observation id = %q, want %q\", observation.ObservationID, fixtureObserveID)\n204|\t}\n205|\tif observation.HostID != fixtureHostID {\n206|\t\tt.Fatalf(\"host id = %q, want %q\", observation.HostID, fixtureHostID)\n207|\t}\n208|\tif observation.InstallationID != fixtureInstallID {\n209|\t\tt.Fatalf(\"installation id = %q, want %q\", observation.InstallationID, fixtureInstallID)\n210|\t}\n211|\tif observation.EnvironmentID != fixtureEnvironmentID {\n212|\t\tt.Fatalf(\"environment id = %q, want %q\", observation.EnvironmentID, fixtureEnvironmentID)\n213|\t}\n214|\tif observation.ProviderID != fixtureProviderID {\n215|\t\tt.Fatalf(\"provider id = %q, want %q\", observation.ProviderID, fixtureProviderID)\n216|\t}\n217|\tif len(observation.Capabilities) != 8 {\n218|\t\tt.Fatalf(\"capabilities = %d entries, want the exact eight\", len(observation.Capabilities))\n219|\t}\n220|}\n221|\n222|// TestDirectoryCapabilityTableIsShared requires the environ and\n223|// dirnode directory-capability tables to be literally equal. The\n224|// adapter fifteen-name and provider seven-name tables share the\n225|// symbol name but are different rules in different stories, so\n226|// they are out of scope here by rule identity, not by silence:\n227|// this comparison names its files.\n228|func TestDirectoryCapabilityTableIsShared(t *testing.T) {\n229|\tmine := deriveRequiredList(t, \"environ\", \"observation.go\", \"capabilityOrder\")\n230|\ttheirs := deriveRequiredList(t, \"dirnode\", \"manifest.go\", \"capabilityOrder\")\n231|\tif !reflect.DeepEqual(mine, theirs) {\n232|\t\tt.Fatalf(\"directory capability tables differ:\\nenviron: %q\\ndirnode:  %q\", mine, theirs)\n233|\t}\n234|\tif len(mine) != 8 {\n235|\t\tt.Fatalf(\"directory capability table has %d names, want the exact eight\", len(mine))\n236|\t}\n237|}\n238|\n239|// TestArchitectureTableIsShared requires the three architecture\n240|// tables in scope to be literally equal.\n241|func TestArchitectureTableIsShared(t *testing.T) {\n242|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleArchitectures\")\n243|\tadapter := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleArchitectures\")\n244|\tnode := deriveRequiredList(t, \"dirnode\", \"probe.go\", \"architectures\")\n245|\tif !reflect.DeepEqual(mine, adapter) || !reflect.DeepEqual(mine, node) {\n246|\t\tt.Fatalf(\"architecture tables differ:\\nenviron: %q\\nsessadapter: %q\\ndirnode: %q\", mine, adapter, node)\n247|\t}\n248|}\n249|\n250|// TestNegotiatedPlatformsParse requires every platform token in\n251|// the derived dirnode v2 vocabulary to parse as a scalar\n252|// platform, and requires the legacy v1 darwin token to refuse:\n253|// the vocabularies are per-major by design, and a token that\n254|// crossed majors silently would break the Section 7.9 binding.\n255|func TestNegotiatedPlatformsParse(t *testing.T) {\n256|\tv2 := deriveRequiredList(t, \"dirnode\", \"probe.go\", \"platformV2\")\n257|\tif len(v2) != 4 {\n258|\t\tt.Fatalf(\"platformV2 has %d tokens, want four\", len(v2))\n259|\t}\n260|\tfor _, token := range v2 {\n261|\t\tif _, err := scalar.ParsePlatform(token); err != nil {\n262|\t\t\tt.Fatalf(\"v2 token %q does not parse as a platform: %v\", token, err)\n263|\t\t}\n264|\t}\n265|\tif _, err := scalar.ParsePlatform(\"darwin\"); err == nil {\n266|\t\tt.Fatal(\"legacy darwin parses as a platform; the majors are no longer separated\")\n267|\t}\n268|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
