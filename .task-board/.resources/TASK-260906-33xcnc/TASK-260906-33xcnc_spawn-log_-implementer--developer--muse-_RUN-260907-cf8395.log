{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59d","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":297,"recorded_at":1780531400000589,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"036d456a-9e4b-46ba-9959-4ec8e12d51f6"},"task_id":"036d456a-9e4b-46ba-9959-4ec8e12d51f6","event":{"kind":"output","task_id":"036d456a-9e4b-46ba-9959-4ec8e12d51f6","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/dirnode/decode.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for every Section 7.9 and\n16|// 10.8.5 closed body. Every helper reports a verdict and never\n17|// refuses: all refusals call one of the refusal constructors\n18|// directly at the deciding site with literal details, so the\n19|// refusal-arm inventory keeps seeing every arm. A helper that\n20|// fronted a constructor would collapse distinct rules into one\n21|// obligation and is not used here.\n22|\n23|// maxUint53 is the largest exactly representable JSON integer:\n24|// Section 7.9 counts and limits are uint53 throughout.\n25|const maxUint53 = uint64(1<<53 - 1)\n26|\n27|// frameFault is one strict-decode failure: what was wrong and which\n28|// member it was found in, if any. It never carries foreign bytes.\n29|type frameFault struct {\n30|\tdetail string\n31|\tmember string\n32|}\n33|\n34|// decodeStrictObject parses one complete JSON object with duplicate\n35|// member rejection. It is the only JSON entry point in this package:\n36|// every body crosses it before any member is read. The frame verdict\n37|// itself is the shared environ verdict: this function delegates to\n38|// environ.DecodeStrictObject and translates the fault into the\n39|// package refusal dialect without reimplementing any rule, so the\n40|// two can never drift. The delegated string-walk surrogate gate\n41|// refuses a real lone escape behind an even backslash run and\n42|// admits quoted backslash-u text; the raw byte scan this replaces\n43|// misread the quoted text as a high surrogate and admitted the\n44|// real lone escape behind it. A non-UTF-8 frame, a lone surrogate\n45|// escape, a non-object top level, a duplicated member, or trailing\n46|// data is a fault, never a partial object the caller could mistake\n47|// for a result.\n48|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n49|\tmembers, fault := environ.DecodeStrictObject(data)\n50|\tif fault != nil {\n51|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n52|\t}\n53|\treturn members, nil\n54|}\n55|\n56|// unknownMember names a member outside the closed set, if any. The\n57|// single-unknown fixtures keep the verdict deterministic: with\n58|// several unknowns the map order decides which is named, so tests\n59|// never assert a name from a multi-unknown body.\n60|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n61|\tfor name := range members {\n62|\t\tif !allowed[name] {\n63|\t\t\treturn name, true\n64|\t\t}\n65|\t}\n66|\treturn \"\", false\n67|}\n68|\n69|// missingMember names the first required member with no value, if\n70|// any. The required list is fixed order, so the verdict is\n71|// deterministic for every missing combination.\n72|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n73|\tfor _, name := range required {\n74|\t\tif _, present := members[name]; !present {\n75|\t\t\treturn name, true\n76|\t\t}\n77|\t}\n78|\treturn \"\", false\n79|}\n80|\n81|// rawString reads a JSON string member.\n82|func rawString(raw json.RawMessage) (string, bool) {\n83|\tvar value string\n84|\tif err := json.Unmarshal(raw, &value); err != nil {\n85|\t\treturn \"\", false\n86|\t}\n87|\treturn value, true\n88|}\n89|\n90|// rawBool reads a JSON boolean member.\n91|func rawBool(raw json.RawMessage) (bool, bool) {\n92|\tvar value bool\n93|\tif err := json.Unmarshal(raw, &value); err != nil {\n94|\t\treturn false, false\n95|\t}\n96|\treturn value, true\n97|}\n98|\n99|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n100|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n101|// even when it names the same mathematical value.\n102|func rawUint53(raw json.RawMessage) (uint64, bool) {\n103|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n104|\tdecoder.UseNumber()\n105|\tvar value any\n106|\tif err := decoder.Decode(&value); err != nil {\n107|\t\treturn 0, false\n108|\t}\n109|\tnumber, ok := value.(json.Number)\n110|\tif !ok {\n111|\t\treturn 0, false\n112|\t}\n113|\tliteral := number.String()\n114|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n115|\t\treturn 0, false\n116|\t}\n117|\treturn parseUint53Literal(literal)\n118|}\n119|\n120|// parseUint53Literal reads a digit-only literal without trusting a\n121|// float conversion: the magnitude bound is checked on the digit\n122|// string, so 2^53 is refused even on platforms that could hold it.\n123|func parseUint53Literal(literal string) (uint64, bool) {\n124|\tvar value uint64\n125|\tfor index := 0; index < len(literal); index++ {\n126|\t\tdigit := literal[index]\n127|\t\tif digit < '0' || digit > '9' {\n128|\t\t\treturn 0, false\n129|\t\t}\n130|\t\tvalue = value*10 + uint64(digit-'0')\n131|\t\tif value > maxUint53 {\n132|\t\t\treturn 0, false\n133|\t\t}\n134|\t}\n135|\treturn value, true\n136|}\n137|\n138|// stringLength is the Section 1.6 string measure in characters, not\n139|// bytes.\n140|func stringLength(value string) int {\n141|\treturn utf8.RuneCountInString(value)\n142|}\n143|\n144|// checkStringBounds reports whether the member is a JSON string whose\n145|// character count falls in the inclusive bound.\n146|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n147|\tvalue, ok := rawString(raw)\n148|\tif !ok {\n149|\t\treturn \"\", false\n150|\t}\n151|\tlength := stringLength(value)\n152|\tif length < minimum || length > maximum {\n153|\t\treturn \"\", false\n154|\t}\n155|\treturn value, true\n156|}\n157|\n158|// checkUint53Bounds reports whether the member is a uint53 in the\n159|// inclusive bound. Both edges are checked: a one-sided check would\n160|// admit the open side.\n161|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n162|\tvalue, ok := rawUint53(raw)\n163|\tif !ok {\n164|\t\treturn 0, false\n165|\t}\n166|\tif value < minimum || value > maximum {\n167|\t\treturn 0, false\n168|\t}\n169|\treturn value, true\n170|}\n171|\n172|// checkDigest reports whether the member is a digest of the pinned\n173|// sha256 form.\n174|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n175|\tvalue, ok := rawString(raw)\n176|\tif !ok {\n177|\t\treturn scalar.Digest{}, false\n178|\t}\n179|\tdigest, err := scalar.ParseDigest(value)\n180|\tif err != nil {\n181|\t\treturn scalar.Digest{}, false\n182|\t}\n183|\treturn digest, true\n184|}\n185|\n186|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n187|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n188|\tvalue, ok := rawString(raw)\n189|\tif !ok {\n190|\t\treturn scalar.UUIDv7{}, false\n191|\t}\n192|\tidentifier, err := scalar.ParseUUIDv7(value)\n193|\tif err != nil {\n194|\t\treturn scalar.UUIDv7{}, false\n195|\t}\n196|\treturn identifier, true\n197|}\n198|\n199|// checkTimestamp reports whether the member is a pinned timestamp.\n200|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n201|\tvalue, ok := rawString(raw)\n202|\tif !ok {\n203|\t\treturn scalar.Timestamp{}, false\n204|\t}\n205|\tinstant, err := scalar.ParseTimestamp(value)\n206|\tif err != nil {\n207|\t\treturn scalar.Timestamp{}, false\n208|\t}\n209|\treturn instant, true\n210|}\n211|\n212|// checkDigestString reports whether the value parses as a digest of\n213|// the pinned form.\n214|func checkDigestString(value string) (string, bool) {\n215|\tdigest, err := scalar.ParseDigest(value)\n216|\tif err != nil {\n217|\t\treturn \"\", false\n218|\t}\n219|\treturn digest.String(), true\n220|}\n221|\n222|// isNull reports whether the member is an explicit JSON null.\n223|func isNull(raw json.RawMessage) bool {\n224|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n225|}\n226|\n227|// decodeArray reads a JSON array member into its raw elements. A\n228|// non-array — including null — is not an empty array.\n229|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n230|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n231|\ttoken, err := decoder.Token()\n232|\tif err != nil {\n233|\t\treturn nil, false\n234|\t}\n235|\tdelim, ok := token.(json.Delim)\n236|\tif !ok || delim != '[' {\n237|\t\treturn nil, false\n238|\t}\n239|\tvar elements []json.RawMessage\n240|\tfor decoder.More() {\n241|\t\tvar element json.RawMessage\n242|\t\tif err := decoder.Decode(&element); err != nil {\n243|\t\t\treturn nil, false\n244|\t\t}\n245|\t\telements = append(elements, element)\n246|\t}\n247|\tif token, err := decoder.Token(); err != nil {\n248|\t\treturn nil, false\n249|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n250|\t\treturn nil, false\n251|\t}\n252|\tif _, err := decoder.Token(); err != io.EOF {\n253|\t\treturn nil, false\n254|\t}\n255|\treturn elements, true\n256|}\n257|\n258|// checkSortedUniqueStrings reports whether the member is an array of\n259|// strings in the item bound whose encodings order strictly\n260|// increasingly with no duplicates, in the count bound.\n261|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n262|\telements, ok := decodeArray(raw)\n263|\tif !ok {\n264|\t\treturn nil, false\n265|\t}\n266|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n267|\t\treturn nil, false\n268|\t}\n269|\tvalues := make([]string, 0, len(elements))\n270|\tfor _, element := range elements {\n271|\t\tvalue, ok := rawString(element)\n272|\t\tif !ok {\n273|\t\t\treturn nil, false\n274|\t\t}\n275|\t\tlength := stringLength(value)\n276|\t\tif length < minimumLength || length > maximumLength {\n277|\t\t\treturn nil, false\n278|\t\t}\n279|\t\tvalues = append(values, value)\n280|\t}\n281|\tfor index := 1; index < len(values); index++ {\n282|\t\tif values[index-1] >= values[index] {\n283|\t\t\treturn nil, false\n284|\t\t}\n285|\t}\n286|\treturn values, true\n287|}\n288|\n289|// checkSortedUniqueDigests reports whether the member is a sorted\n290|// unique digest array in the count bound.\n291|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n292|\telements, ok := decodeArray(raw)\n293|\tif !ok {\n294|\t\treturn nil, false\n295|\t}\n296|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n297|\t\treturn nil, false\n298|\t}\n299|\tvalues := make([]scalar.Digest, 0, len(elements))\n300|\tfor _, element := range elements {\n301|\t\tdigest, ok := checkDigest(element)\n302|\t\tif !ok {\n303|\t\t\treturn nil, false\n304|\t\t}\n305|\t\tvalues = append(values, digest)\n306|\t}\n307|\tfor index := 1; index < len(values); index++ {\n308|\t\tif values[index-1].String() >= values[index].String() {\n309|\t\t\treturn nil, false\n310|\t\t}\n311|\t}\n312|\treturn values, true\n313|}\n314|\n315|// checkSortedUniqueUUIDv7 reports whether the member is a sorted\n316|// unique UUIDv7 array in the count bound.\n317|func checkSortedUniqueUUIDv7(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.UUIDv7, bool) {\n318|\telements, ok := decodeArray(raw)\n319|\tif !ok {\n320|\t\treturn nil, false\n321|\t}\n322|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n323|\t\treturn nil, false\n324|\t}\n325|\tvalues := make([]scalar.UUIDv7, 0, len(elements))\n326|\tfor _, element := range elements {\n327|\t\tidentifier, ok := checkUUIDv7(element)\n328|\t\tif !ok {\n329|\t\t\treturn nil, false\n330|\t\t}\n331|\t\tvalues = append(values, identifier)\n332|\t}\n333|\tfor index := 1; index < len(values); index++ {\n334|\t\tif values[index-1].String() >= values[index].String() {\n335|\t\t\treturn nil, false\n336|\t\t}\n337|\t}\n338|\treturn values, true\n339|}\n340|\n341|// checkOptionalDigest reads a digest|null member: null is the only\n342|// accepted absence, and any other non-digest is not an absence.\n343|func checkOptionalDigest(raw json.RawMessage) (scalar.Digest, bool, bool) {\n344|\tif isNull(raw) {\n345|\t\treturn scalar.Digest{}, true, true\n346|\t}\n347|\tdigest, ok := checkDigest(raw)\n348|\tif !ok {\n349|\t\treturn scalar.Digest{}, false, false\n350|\t}\n351|\treturn digest, true, false\n352|}\n353|\n354|// checkOptionalString reads a bounded string|null member with the\n355|// same absence rule.\n356|func checkOptionalString(raw json.RawMessage, minimum, maximum int) (string, bool, bool) {\n357|\tif isNull(raw) {\n358|\t\treturn \"\", true, true\n359|\t}\n360|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n361|\tif !ok {\n362|\t\treturn \"\", false, false\n363|\t}\n364|\treturn value, true, false\n365|}\n366|\n367|// semverPattern is the SemVer grammar versions satisfy: three\n368|// dot-separated non-negative integers with no leading zeros, an\n369|// optional pre-release, and optional build metadata.\n370|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n371|\n372|// environmentIDPattern is the environment-id grammar:\n373|// [a-z][a-z0-9.-]{0,63}.\n374|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n375|\n376|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n377|// dot-separated lowercase labels.\n378|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n379|\n380|// checkSemver reports whether the value is a SemVer string.\n381|func checkSemver(value string) bool {\n382|\treturn semverPattern.MatchString(value)\n383|}\n384|\n385|// checkExtensions reports whether the member is an object whose keys\n386|// are all reverse-DNS names. Values cross opaquely: extensions\n387|// cannot add operations, capabilities, or trust facts, and no member\n388|// of this package reads an extension value for any admission\n389|// decision.\n390|func checkExtensions(raw json.RawMessage) bool {\n391|\tmembers, fault := decodeStrictObject(raw)\n392|\tif fault != nil {\n393|\t\treturn false\n394|\t}\n395|\tfor name := range members {\n396|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n397|\t\t\treturn false\n398|\t\t}\n399|\t}\n400|\treturn true\n401|}\n402|\n403|// checkURI reports whether the value is a URI reference of 1..512\n404|// characters: no whitespace or control characters, with a scheme\n405|// prefix. Contract identifiers in this contract family are URNs, so\n406|// the check requires the colon form rather than accepting any\n407|// relative string.\n408|func checkURI(value string) bool {\n409|\tlength := stringLength(value)\n410|\tif length < 1 || length > 512 {\n411|\t\treturn false\n412|\t}\n413|\tfor _, point := range value {\n414|\t\tif point < 0x21 || point > 0x7E {\n415|\t\t\treturn false\n416|\t\t}\n417|\t}\n418|\tcolon := strings.Index(value, \":\")\n419|\treturn colon > 0\n420|}"}}}
