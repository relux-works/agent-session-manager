{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c905","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":733,"recorded_at":1780531400001461,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"0fc176f1-bb2c-44fd-a7a9-f259398a7e4e"},"task_id":"0fc176f1-bb2c-44fd-a7a9-f259398a7e4e","event":{"kind":"output","task_id":"0fc176f1-bb2c-44fd-a7a9-f259398a7e4e","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/shape_census_test.go`.\n(799 line(s) above)\n800|\t\t},\n801|\t\t{\n802|\t\t\tname: \"ledgered decoder name still fires by name\",\n803|\t\t\tsource: `package provider\n804|func decodeStrictObject(data []byte) bool { return len(data) == 0 }`,\n805|\t\t\twantName: []string{\"strict-decoder|provider|control.go|decodeStrictObject\"},\n806|\t\t},\n807|\t\t{\n808|\t\t\tname: \"negatives stay clean\",\n809|\t\t\tsource: `package provider\n810|func decodeArrayShaped(raw json.RawMessage) []int {\n811|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n812|\t_ = decoder\n813|\treturn nil\n814|}\n815|func asciiNameOk(name string) bool { return len(name) >= 1 && len(name) <= 128 }\n816|func countElements(values []string) int { return len(values) }\n817|var reuse = environ.StringLength`,\n818|\t\t\tallowEmpty: true,\n819|\t\t},\n820|\t}\n821|}\n822|\n823|// mirrorNameSites replicates the name layer's FuncDecl rule on\n824|// one synthetic file: declarations whose identifiers are already\n825|// in sharedFunctionSymbols. The production name derivation in\n826|// census_test.go applies this same rule to the real tree.\n827|func mirrorNameSites(source []byte) []string {\n828|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"control.go\", source, 0)\n829|\tif err != nil {\n830|\t\treturn []string{\"parse-failure|provider|control.go|unparseable\"}\n831|\t}\n832|\tvar keys []string\n833|\tfor _, decl := range syntax.Decls {\n834|\t\tnode, ok := decl.(*ast.FuncDecl)\n835|\t\tif !ok || node.Name == nil {\n836|\t\t\tcontinue\n837|\t\t}\n838|\t\tif class, ok := sharedFunctionSymbols[node.Name.Name]; ok {\n839|\t\t\tkeys = append(keys, shapeSite{class: class, pkg: \"provider\", file: \"control.go\", symbol: node.Name.Name}.key())\n840|\t\t}\n841|\t}\n842|\tsort.Strings(keys)\n843|\treturn keys\n844|}\n845|\n846|// TestShapeCensusCatchesControls drives every control plant\n847|// through the production extractor and requires the exact\n848|// derived sets, with every derived site unregistered: the proof\n849|// that each claimed shape fails the census rather than passing\n850|// silently.\n851|func TestShapeCensusCatchesControls(t *testing.T) {\n852|\tfor _, control := range shapeControls() {\n853|\t\tt.Run(control.name, func(t *testing.T) {\n854|\t\t\tseenShape := map[string]bool{}\n855|\t\t\tvar gotShape []string\n856|\t\t\tfor _, site := range shapeSitesInPackage(\"provider\", map[string][]byte{\"control.go\": []byte(control.source)}) {\n857|\t\t\t\tif !seenShape[site.key()] {\n858|\t\t\t\t\tseenShape[site.key()] = true\n859|\t\t\t\t\tgotShape = append(gotShape, site.key())\n860|\t\t\t\t}\n861|\t\t\t}\n862|\t\t\tsort.Strings(gotShape)\n863|\t\t\tif strings.Join(gotShape, \"\\x00\") != strings.Join(control.wantShape, \"\\x00\") {\n864|\t\t\t\tt.Fatalf(\"shape sites = %q, want %q\", gotShape, control.wantShape)\n865|\t\t\t}\n866|\t\t\tgotName := mirrorNameSites([]byte(control.source))\n867|\t\t\tif strings.Join(gotName, \"\\x00\") != strings.Join(control.wantName, \"\\x00\") {\n868|\t\t\t\tt.Fatalf(\"name sites = %q, want %q\", gotName, control.wantName)\n869|\t\t\t}\n870|\t\t\tfor _, key := range append(append([]string{}, gotShape...), gotName...) {\n871|\t\t\t\tif _, ok := shapeLedger[key]; ok {\n872|\t\t\t\t\tt.Fatalf(\"control site %q is registered; the control proves nothing\", key)\n873|\t\t\t\t}\n874|\t\t\t\tif _, ok := sharedLedger[key]; ok {\n875|\t\t\t\t\tt.Fatalf(\"control site %q is registered; the control proves nothing\", key)\n876|\t\t\t\t}\n877|\t\t\t}\n878|\t\t\tif !control.allowEmpty && len(gotShape)+len(gotName) == 0 {\n879|\t\t\t\tt.Fatal(\"control derives no site; the control proves nothing\")\n880|\t\t\t}\n881|\t\t})\n882|\t}\n883|}\n884|\n885|// TestGrammarCensusCatchesFreshName plants a fresh-name copy of\n886|// the environment-id grammar and requires the classifier to\n887|// report it as a copy of that class with an unregistered key:\n888|// the proof that a renamed grammar copy fails the census.\n889|func TestGrammarCensusCatchesFreshName(t *testing.T) {\n890|\tliterals, _, _ := deriveGrammarLiterals(t)\n891|\tknown := grammarKnownLiterals(literals)\n892|\tenvironmentID, ok := knownLiteralFor(t, literals, \"env-id-grammar\")\n893|\tif !ok {\n894|\t\tt.Fatal(\"env-id-grammar derives no literal; the control has nothing to copy\")\n895|\t}\n896|\tsource := []byte(\"package provider\\nvar envIDCopy = regexp.MustCompile(`\" + environmentID + \"`)\\n\")\n897|\tcandidates, err := grammarCandidatesInFile(\"control.go\", source)\n898|\tif err != nil {\n899|\t\tt.Fatalf(\"control does not parse: %v\", err)\n900|\t}\n901|\tif len(candidates) != 1 {\n902|\t\tt.Fatalf(\"control derives %d candidates, want 1\", len(candidates))\n903|\t}\n904|\tclass, copy := classifyGrammarCandidate(candidates[0], known)\n905|\tif !copy || class != \"env-id-grammar\" {\n906|\t\tt.Fatalf(\"fresh-name copy classified as (%q, %v), want (env-id-grammar, true)\", class, copy)\n907|\t}\n908|\tkey := shapeSite{class: class, pkg: \"provider\", file: \"control.go\", symbol: candidates[0].symbol}.key()\n909|\tif grammarSiteLedger[key] {\n910|\t\tt.Fatalf(\"control site %q is registered; the control proves nothing\", key)\n911|\t}\n912|\tnegative, err := grammarCandidatesInFile(\"control.go\", []byte(\"package provider\\nvar sitePattern = regexp.MustCompile(`^[a-z]+$`)\\n\"))\n913|\tif err != nil {\n914|\t\tt.Fatalf(\"negative does not parse: %v\", err)\n915|\t}\n916|\tif _, copy := classifyGrammarCandidate(negative[0], known); copy {\n917|\t\tt.Fatal(\"unknown-literal grammar classified as a copy; the rule overreaches\")\n918|\t}\n919|}\n920|\n921|// knownLiteralFor returns one derived literal of the class.\n922|func knownLiteralFor(t *testing.T, literals map[string]map[string]bool, class string) (string, bool) {\n923|\tt.Helper()\n924|\tfor text := range literals[class] {\n925|\t\treturn text, true\n926|\t}\n927|\treturn \"\", false\n928|}\n929|\n930|// TestDelegatingWrappersCallEnviron pins the B2 fix\n931|// structurally: the sessadapter and dirnode frame decoders must\n932|// delegate to environ, and the removed raw-scan copies must not\n933|// come back. The wrapper body must reference the environ\n934|// package and must not construct a decoder, a surrogate bound,\n935|// or a rune count of its own; neither file may define the old\n936|// gate or helper names or carry surrogate range literals.\n937|func TestDelegatingWrappersCallEnviron(t *testing.T) {\n938|\troot, err := internalRoot(t)\n939|\tif err != nil {\n940|\t\tt.Fatalf(\"delegation: %v\", err)\n941|\t}\n942|\tfor _, pkg := range []string{\"sessadapter\", \"dirnode\"} {\n943|\t\tt.Run(pkg, func(t *testing.T) {\n944|\t\t\tpath := filepath.Join(root, pkg, \"decode.go\")\n945|\t\t\tsource, err := os.ReadFile(path)\n946|\t\t\tif err != nil {\n947|\t\t\t\tt.Fatalf(\"delegation: %v\", err)\n948|\t\t\t}\n949|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n950|\t\t\tif err != nil {\n951|\t\t\t\tt.Fatalf(\"delegation: %v\", err)\n952|\t\t\t}\n953|\t\t\tfoundWrapper := false\n954|\t\t\tfor _, decl := range syntax.Decls {\n955|\t\t\t\tnode, ok := decl.(*ast.FuncDecl)\n956|\t\t\t\tif !ok {\n957|\t\t\t\t\tcontinue\n958|\t\t\t\t}\n959|\t\t\t\tswitch node.Name.Name {\n960|\t\t\t\tcase \"hasLoneSurrogateEscape\", \"readUTF16Escape\", \"readUTF16EscapeAfter\":\n961|\t\t\t\t\tt.Fatalf(\"delegation: removed raw-scan copy %q is back in %s/decode.go\", node.Name.Name, pkg)\n962|\t\t\t\tcase \"decodeStrictObject\":\n963|\t\t\t\t\tfoundWrapper = true\n964|\t\t\t\t\tpinsDelegation(t, pkg, node)\n965|\t\t\t\t}\n966|\t\t\t}\n967|\t\t\tif !foundWrapper {\n968|\t\t\t\tt.Fatalf(\"delegation: decodeStrictObject missing in %s/decode.go\", pkg)\n969|\t\t\t}\n970|\t\t\tassertNoSurrogateLiterals(t, pkg, syntax)\n971|\t\t})\n972|\t}\n973|}\n974|\n975|// pinsDelegation requires the wrapper to reference environ and\n976|// to hold no decoder, gate, or measure of its own.\n977|func pinsDelegation(t *testing.T, pkg string, wrapper *ast.FuncDecl) {\n978|\tt.Helper()\n979|\treferencesEnviron := false\n980|\tast.Inspect(wrapper.Body, func(node ast.Node) bool {\n981|\t\tselector, ok := node.(*ast.SelectorExpr)\n982|\t\tif !ok {\n983|\t\t\treturn true\n984|\t\t}\n985|\t\tidentifier, ok := selector.X.(*ast.Ident)\n986|\t\tif !ok {\n987|\t\t\treturn true\n988|\t\t}\n989|\t\tif identifier.Name != \"environ\" {\n990|\t\t\treturn true\n991|\t\t}\n992|\t\treferencesEnviron = true\n993|\t\treturn false\n994|\t})\n995|\tif !referencesEnviron {\n996|\t\tt.Fatalf(\"delegation: %s decodeStrictObject no longer references environ\", pkg)\n997|\t}\n998|\tif bodyBuildsJSONDecoder(wrapper.Body) {\n999|\t\tt.Fatalf(\"delegation: %s decodeStrictObject builds its own decoder\", pkg)\n1000|\t}\n1001|\tif bodyCountsRunes(wrapper.Body) {\n1002|\t\tt.Fatalf(\"delegation: %s decodeStrictObject counts runes itself\", pkg)\n1003|\t}\n1004|\tsurrogateState := &packageShapes{funcDups: map[string]bool{}, funcShapes: map[string][]string{}, constBound: map[string]bool{}}\n1005|\tif bodyCarriesSurrogateSignal(wrapper.Body, surrogateState) {\n1006|\t\tt.Fatalf(\"delegation: %s decodeStrictObject carries its own surrogate gate\", pkg)\n1007|\t}\n1008|}\n1009|\n1010|// assertNoSurrogateLiterals requires the whole file to carry no\n1011|// surrogate range literal: the gate lives in environ now.\n1012|func assertNoSurrogateLiterals(t *testing.T, pkg string, syntax *ast.File) {\n1013|\tt.Helper()\n1014|\tast.Inspect(syntax, func(node ast.Node) bool {\n1015|\t\tliteral, ok := node.(*ast.BasicLit)\n1016|\t\tif !ok || literal.Kind != token.INT {\n1017|\t\t\treturn true\n1018|\t\t}\n1019|\t\tif magnitude, err := strconv.ParseUint(literal.Value, 0, 32); err == nil && surrogateBounds[magnitude] {\n1020|\t\t\tt.Fatalf(\"delegation: %s/decode.go carries surrogate literal %s; the gate lives in environ\", pkg, literal.Value)\n1021|\t\t\treturn false\n1022|\t\t}\n1023|\t\treturn true\n1024|\t})\n1025|}"}}}
