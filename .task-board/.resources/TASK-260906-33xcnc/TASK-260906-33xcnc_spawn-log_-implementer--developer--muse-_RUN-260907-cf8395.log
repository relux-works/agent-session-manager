{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63b","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":376,"recorded_at":1780531400000747,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"e2cb09e9-a900-4948-bd8d-8842bf422362"},"task_id":"e2cb09e9-a900-4948-bd8d-8842bf422362","event":{"kind":"output","task_id":"e2cb09e9-a900-4948-bd8d-8842bf422362","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/decode_unit_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// This file drives the environ entries no facade reaches\n10|// directly: the uint53 bound checker (with its digit-literal\n11|// ladder), the sorted-unique string checker in both of its\n12|// halves, and the frame-fault rendering. Coverage here is\n13|// behavioral (refusal or value at the edges), never line-fill:\n14|// every row would fail against a weakened gate.\n15|\n16|// TestCheckUint53BoundsEdges drives CheckUint53Bounds through\n17|// the production entry: accepts decode to the bound values, and\n18|// every refusal shape (non-number, fraction, exponent, sign,\n19|// out-of-range magnitude, bound edges) refuses.\n20|func TestCheckUint53BoundsEdges(t *testing.T) {\n21|\taccept := func(literal string, minimum, maximum uint64, want uint64) {\n22|\t\tt.Helper()\n23|\t\tgot, ok := CheckUint53Bounds(json.RawMessage(literal), minimum, maximum)\n24|\t\tif !ok {\n25|\t\t\tt.Fatalf(\"CheckUint53Bounds(%s, %d, %d) refused, want %d\", literal, minimum, maximum, want)\n26|\t\t}\n27|\t\tif got != want {\n28|\t\t\tt.Fatalf(\"CheckUint53Bounds(%s, %d, %d) = %d, want %d\", literal, minimum, maximum, got, want)\n29|\t\t}\n30|\t}\n31|\trefuse := func(literal string, minimum, maximum uint64) {\n32|\t\tt.Helper()\n33|\t\tif got, ok := CheckUint53Bounds(json.RawMessage(literal), minimum, maximum); ok {\n34|\t\t\tt.Fatalf(\"CheckUint53Bounds(%s, %d, %d) admitted %d, want refusal\", literal, minimum, maximum, got)\n35|\t\t}\n36|\t}\n37|\taccept(\"0\", 0, 100, 0)\n38|\taccept(\"100\", 0, 100, 100)\n39|\taccept(\"9007199254740991\", 0, 9007199254740991, 9007199254740991)\n40|\taccept(\"5\", 5, 10, 5)\n41|\taccept(\"10\", 5, 10, 10)\n42|\trefuse(\"4\", 5, 10)\n43|\trefuse(\"101\", 0, 100)\n44|\trefuse(\"9007199254740992\", 0, 18446744073709551615)\n45|\trefuse(\"9007199254740992\", 0, 9007199254740991)\n46|\trefuse(\"1.0\", 0, 100)\n47|\trefuse(\"1e3\", 0, 10000)\n48|\trefuse(\"-1\", 0, 100)\n49|\trefuse(\"+1\", 0, 100)\n50|\trefuse(`\"42\"`, 0, 100)\n51|\trefuse(\"null\", 0, 100)\n52|\trefuse(\"true\", 0, 100)\n53|\trefuse(\"\", 0, 100)\n54|\trefuse(\"12a\", 0, 100)\n55|\trefuse(\"18446744073709551616\", 0, 18446744073709551615)\n56|}\n57|\n58|// TestCheckSortedUniqueStringsHalves drives\n59|// CheckSortedUniqueStrings through the production entry with\n60|// the conjoined halves separated: an unsorted-but-unique vector\n61|// refuses (ordering), a sorted-but-duplicated vector refuses\n62|// (uniqueness), and a sorted unique vector admits with its\n63|// values. A check enforcing only one half cannot pass both\n64|// refusal rows.\n65|func TestCheckSortedUniqueStringsHalves(t *testing.T) {\n66|\taccept := func(t *testing.T, literal string) []string {\n67|\t\tt.Helper()\n68|\t\tvalues, ok := CheckSortedUniqueStrings(json.RawMessage(literal), 1, 128, 0, 64)\n69|\t\tif !ok {\n70|\t\t\tt.Fatalf(\"CheckSortedUniqueStrings(%s) refused, want accept\", literal)\n71|\t\t}\n72|\t\treturn values\n73|\t}\n74|\trefuse := func(t *testing.T, literal string) {\n75|\t\tt.Helper()\n76|\t\tif values, ok := CheckSortedUniqueStrings(json.RawMessage(literal), 1, 128, 0, 64); ok {\n77|\t\t\tt.Fatalf(\"CheckSortedUniqueStrings(%s) admitted %q, want refusal\", literal, values)\n78|\t\t}\n79|\t}\n80|\tt.Run(\"sorted unique admits with values\", func(t *testing.T) {\n81|\t\tvalues := accept(t, `[\"a\",\"b\",\"c\"]`)\n82|\t\tif len(values) != 3 || values[0] != \"a\" || values[1] != \"b\" || values[2] != \"c\" {\n83|\t\t\tt.Fatalf(\"values = %q, want [a b c]\", values)\n84|\t\t}\n85|\t})\n86|\tt.Run(\"unsorted unique refuses\", func(t *testing.T) {\n87|\t\trefuse(t, `[\"b\",\"a\"]`)\n88|\t})\n89|\tt.Run(\"sorted duplicated refuses\", func(t *testing.T) {\n90|\t\trefuse(t, `[\"a\",\"a\"]`)\n91|\t})\n92|\tt.Run(\"non-array refuses\", func(t *testing.T) {\n93|\t\trefuse(t, `null`)\n94|\t})\n95|\tt.Run(\"overlong element refuses\", func(t *testing.T) {\n96|\t\trefuse(t, `[\"`+strings.Repeat(\"v\", 129)+`\"]`)\n97|\t})\n98|\tt.Run(\"over count refuses\", func(t *testing.T) {\n99|\t\tif _, ok := CheckSortedUniqueStrings(json.RawMessage(`[\"a\"]`), 1, 128, 2, 64); ok {\n100|\t\t\tt.Fatal(\"admitted a vector below the count floor\")\n101|\t\t}\n102|\t\tif _, ok := CheckSortedUniqueStrings(json.RawMessage(`[\"a\",\"b\"]`), 1, 128, 0, 1); ok {\n103|\t\t\tt.Fatal(\"admitted a vector above the count ceiling\")\n104|\t\t}\n105|\t})\n106|}\n107|\n108|// TestFaultErrorRendersMember drives Fault.Error through the\n109|// production type: memberless faults name only the detail, and\n110|// member faults name both. The rendering is what the facade\n111|// wrappers translate, so both branches are pinned here.\n112|func TestFaultErrorRendersMember(t *testing.T) {\n113|\tbare := (&Fault{Detail: FaultLoneSurrogate}).Error()\n114|\tif !strings.Contains(bare, FaultLoneSurrogate) {\n115|\t\tt.Fatalf(\"memberless fault = %q, want the detail\", bare)\n116|\t}\n117|\tif strings.Contains(bare, \"in member\") {\n118|\t\tt.Fatalf(\"memberless fault = %q, must not name a member\", bare)\n119|\t}\n120|\twithMember := (&Fault{Detail: FaultDuplicate, Member: \"v\"}).Error()\n121|\tif !strings.Contains(withMember, FaultDuplicate) || !strings.Contains(withMember, \"v\") {\n122|\t\tt.Fatalf(\"member fault = %q, want the detail and the member\", withMember)\n123|\t}\n124|}"}}}
