{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c1","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":187,"recorded_at":1780531400000369,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"0d59592e-3e53-43f5-b558-2c3a697cd564"},"task_id":"0d59592e-3e53-43f5-b558-2c3a697cd564","event":{"kind":"output","task_id":"0d59592e-3e53-43f5-b558-2c3a697cd564","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/invcore/must.go`.\n1|// Must wrappers and the runtime site recorder for Package invcore.\n2|//\n3|// The Must wrappers fail the suite on any returned failure: production\n4|// inventories call these, while negative tests and control plants call\n5|// the pure funcs in invcore.go directly and assert on the returned\n6|// failures. A gate that can only fatal cannot be planted against.\n7|\n8|package invcore\n9|\n10|import (\n11|\t\"fmt\"\n12|\t\"go/ast\"\n13|\t\"go/token\"\n14|\t\"path/filepath\"\n15|\t\"runtime\"\n16|\t\"sort\"\n17|\t\"strings\"\n18|\t\"sync\"\n19|\t\"testing\"\n20|)\n21|\n22|// MustScanProduction scans dir and fails the suite on any fail-closed\n23|// condition: zero files, unreadable files, unparseable files.\n24|func MustScanProduction(t *testing.T, dir string) ([]ProductionFile, *token.FileSet) {\n25|\tt.Helper()\n26|\tfiles, fileSet, failures := ScanProduction(dir)\n27|\tfor _, failure := range failures {\n28|\t\tt.Error(failure)\n29|\t}\n30|\tif len(failures) > 0 {\n31|\t\tt.FailNow()\n32|\t}\n33|\treturn files, fileSet\n34|}\n35|\n36|// MustCheckBothDirections fails the suite when the derived set and the\n37|// declared row set differ in either direction: unregistered derived sites\n38|// or orphaned rows. A zero derived set fails even when rows are empty.\n39|func MustCheckBothDirections(t *testing.T, what string, derived, rows map[string]struct{}) {\n40|\tt.Helper()\n41|\tunregistered, orphaned, failures := DiffSets(derived, rows)\n42|\tfor _, failure := range failures {\n43|\t\tt.Errorf(\"%s: %s\", what, failure)\n44|\t}\n45|\tfor _, key := range unregistered {\n46|\t\tt.Errorf(\"%s: unregistered site with no declaring row, so nothing witnesses it: %s\", what, key)\n47|\t}\n48|\tfor _, key := range orphaned {\n49|\t\tt.Errorf(\"%s: orphan row with no derived site; a row without a site is a witness without a guard: %s\", what, key)\n50|\t}\n51|}\n52|\n53|// MustAuditConstructorReferences fails the suite on any constructor\n54|// reference outside direct-call position, including import-aliased and\n55|// var-bound shapes, and on any shape the audit cannot classify.\n56|func MustAuditConstructorReferences(t *testing.T, syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) {\n57|\tt.Helper()\n58|\tfor _, failure := range AuditConstructorReferences(syntax, fileSet, display, spec) {\n59|\t\tt.Error(failure)\n60|\t}\n61|}\n62|\n63|// SiteRecorder is the runtime direction of the alias-bypass union\n64|// (provider/provhost shape): instrumented constructor vars record the\n65|// production file:line behind every exercised refusal plus the stable\n66|// codes those refusals carried. The audit requires the exercised site set\n67|// to equal the derived site set in both directions, and the observed code\n68|// set to equal the closed code set exactly, so a constructor call the\n69|// tests never exercise fails forward, and a truncated derivation fails in\n70|// reverse even though the forward check passes vacuously.\n71|type SiteRecorder struct {\n72|\tmu    sync.Mutex\n73|\tsites map[string]struct{}\n74|\tcodes map[string]struct{}\n75|}\n76|\n77|// NewSiteRecorder returns an empty recorder.\n78|func NewSiteRecorder() *SiteRecorder {\n79|\treturn &SiteRecorder{sites: map[string]struct{}{}, codes: map[string]struct{}{}}\n80|}\n81|\n82|// Record notes one exercised refusal carrying code, attributing it to\n83|// the production file:line at runtime.Caller(skip+1): skip counts every\n84|// frame between Record and the site, including Record's own caller. A\n85|// record helper called from the swapped constructor var passes skip=2\n86|// (helper frame plus wrapper frame), matching the historical sync.Map\n87|// recorders' runtime.Caller(2) exactly.\n88|func (recorder *SiteRecorder) Record(code string, skip int) {\n89|\trecorder.mu.Lock()\n90|\tdefer recorder.mu.Unlock()\n91|\trecorder.codes[code] = struct{}{}\n92|\tif _, file, line, ok := runtime.Caller(skip + 1); ok {\n93|\t\trecorder.sites[filepath.Base(file)+\":\"+fmt.Sprint(line)] = struct{}{}\n94|\t}\n95|}\n96|\n97|// Snapshot returns deep copies of the exercised site and code sets for\n98|// tests that record bystander sites and must remove them before\n99|// returning, keeping the reverse-direction audit exact.\n100|func (recorder *SiteRecorder) Snapshot() (sites map[string]struct{}, codes map[string]struct{}) {\n101|\trecorder.mu.Lock()\n102|\tdefer recorder.mu.Unlock()\n103|\tsites = make(map[string]struct{}, len(recorder.sites))\n104|\tfor site := range recorder.sites {\n105|\t\tsites[site] = struct{}{}\n106|\t}\n107|\tcodes = make(map[string]struct{}, len(recorder.codes))\n108|\tfor code := range recorder.codes {\n109|\t\tcodes[code] = struct{}{}\n110|\t}\n111|\treturn sites, codes\n112|}\n113|\n114|// Restore resets the recorder to a prior snapshot, dropping every site\n115|// and code recorded since.\n116|func (recorder *SiteRecorder) Restore(sites map[string]struct{}, codes map[string]struct{}) {\n117|\trecorder.mu.Lock()\n118|\tdefer recorder.mu.Unlock()\n119|\trecorder.sites = make(map[string]struct{}, len(sites))\n120|\tfor site := range sites {\n121|\t\trecorder.sites[site] = struct{}{}\n122|\t}\n123|\trecorder.codes = make(map[string]struct{}, len(codes))\n124|\tfor code := range codes {\n125|\t\trecorder.codes[code] = struct{}{}\n126|\t}\n127|}\n128|\n129|// Sites returns the exercised production file:line set.\n130|func (recorder *SiteRecorder) Sites() map[string]struct{} {\n131|\trecorder.mu.Lock()\n132|\tdefer recorder.mu.Unlock()\n133|\tduplicated := make(map[string]struct{}, len(recorder.sites))\n134|\tfor site := range recorder.sites {\n135|\t\tduplicated[site] = struct{}{}\n136|\t}\n137|\treturn duplicated\n138|}\n139|\n140|// Codes returns the observed stable code set.\n141|func (recorder *SiteRecorder) Codes() []string {\n142|\trecorder.mu.Lock()\n143|\tdefer recorder.mu.Unlock()\n144|\tvar codes []string\n145|\tfor code := range recorder.codes {\n146|\t\tcodes = append(codes, code)\n147|\t}\n148|\tsort.Strings(codes)\n149|\treturn codes\n150|}\n151|\n152|// AuditSites compares the exercised set against the derived site set in\n153|// both directions and the observed codes against the closed set, returning\n154|// one failure per violated direction. Empty scanned or derived input fails\n155|// closed: a blind scan is not a measurement.\n156|func (recorder *SiteRecorder) AuditSites(what string, scanned int, derived map[string]struct{}, wantCodes []string) []string {\n157|\tvar failures []string\n158|\tif scanned == 0 {\n159|\t\tfailures = append(failures, what+\": scanned no production sources; the check is blind\")\n160|\t}\n161|\tif len(derived) == 0 {\n162|\t\tfailures = append(failures, what+\": derived no refusal sites; the scan is blind\")\n163|\t}\n164|\texercised := recorder.Sites()\n165|\tvar outside []string\n166|\tfor site := range exercised {\n167|\t\tif _, ok := derived[site]; !ok {\n168|\t\t\toutside = append(outside, site)\n169|\t\t}\n170|\t}\n171|\tsort.Strings(outside)\n172|\tif len(outside) != 0 {\n173|\t\tfailures = append(failures, what+\": exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n174|\t}\n175|\tvar missing []string\n176|\tfor site := range derived {\n177|\t\tif _, ok := exercised[site]; !ok {\n178|\t\t\tmissing = append(missing, site)\n179|\t\t}\n180|\t}\n181|\tsort.Strings(missing)\n182|\tif len(missing) != 0 {\n183|\t\tfailures = append(failures, what+\": derived refusal sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n184|\t}\n185|\tcodes := recorder.Codes()\n186|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", wantCodes) {\n187|\t\tfailures = append(failures, fmt.Sprintf(\"%s: observed refusal codes = %v, want closed set %v\", what, codes, wantCodes))\n188|\t}\n189|\treturn failures\n190|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c3","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":188,"recorded_at":1780531400000371,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"0d59592e-3e53-43f5-b558-2c3a697cd564"},"task_id":"0d59592e-3e53-43f5-b558-2c3a697cd564","event":{"kind":"completed","task_id":"0d59592e-3e53-43f5-b558-2c3a697cd564"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c5","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":189,"recorded_at":1780531400000373,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"5a26c110-8253-4c15-8038-819031a82cfb"},"task_id":"5a26c110-8253-4c15-8038-819031a82cfb","event":{"kind":"output","task_id":"5a26c110-8253-4c15-8038-819031a82cfb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/invcore/invcore.go`.\n1|// Package invcore is the shared test-support core for production-derived\n2|// inventories: production-file selection, fail-closed parsing, and the\n3|// both-direction check harness.\n4|//\n5|// Every package inventory in this repository derives its denominator from\n6|// production source instead of listing it, in three historical\n7|// architectures for the same idea: terminalbackend resolves declared rows\n8|// textually and refuses constructor aliasing outright; provhost executes\n9|// every witness through the production entry point and keys on identifier\n10|// names behind a separate call-site audit; provider instruments constructor\n11|// vars at runtime in TestMain and audits the exercised file:line set\n12|// against AST-derived sites. The weaker bound was the real bound, so this\n13|// core carries the UNION of those directions, not the intersection:\n14|//\n15|//   - ScanProduction owns production-file selection: directory-derived,\n16|//     every *.go except *_test.go, sorted, so a new production file is\n17|//     scanned without anyone remembering it. Zero files is a failure,\n18|//     never a vacuous pass.\n19|//   - MustParse owns fail-closed parsing: an unparseable file fails, never\n20|//     skips. A file the derivation cannot read proves nothing.\n21|//   - DiffSets owns the both-direction harness: derived-without-row\n22|//     (unregistered site) AND row-without-site (orphan row) fail together.\n23|//     The forward direction alone passes vacuously on a truncated\n24|//     derivation.\n25|//   - AuditConstructorReferences owns the alias-bypass union: constructor\n26|//     references outside direct-call position fail outright\n27|//     (terminalbackend direction), import aliases and dot imports resolve\n28|//     against the imported path instead of the local spelling (the shape\n29|//     that walked through every identifier-keyed gate in this repository),\n30|//     and var bindings are references, not calls (provider direction made\n31|//     static). Anything the audit cannot classify — a dot import of a\n32|//     watched path, an unresolved shadowing — fails closed as\n33|//     unclassifiable, never pruned.\n34|//   - SiteRecorder owns the runtime direction (provider/provhost shape):\n35|//     instrumented constructor vars record the production file:line behind\n36|//     every exercised refusal, and the audit requires the exercised set to\n37|//     equal the derived site set in both directions.\n38|//\n39|// All checks come in two spellings: a pure func returning failures for\n40|// negative tests and control plants, and a Must wrapper that fails the\n41|// suite. A gate that can only fatal cannot be planted against, and a plant\n42|// that cannot run proves nothing.\n43|package invcore\n44|\n45|import (\n46|\t\"go/ast\"\n47|\t\"go/parser\"\n48|\t\"go/token\"\n49|\t\"os\"\n50|\t\"path/filepath\"\n51|\t\"sort\"\n52|\t\"strconv\"\n53|\t\"strings\"\n54|)\n55|\n56|// ProductionFile is one parsed production source: basename, full path,\n57|// raw bytes, and syntax parsed with a directory-shared FileSet.\n58|type ProductionFile struct {\n59|\tName   string\n60|\tPath   string\n61|\tSource []byte\n62|\tSyntax *ast.File\n63|\tFile   *token.File\n64|}\n65|\n66|// ScanProduction reads every production file of the directory at dir:\n67|// every *.go except *_test.go, in sorted order. It returns the parsed\n68|// files with their shared FileSet, plus a failure string for every\n69|// fail-closed condition: an unreadable directory, an unreadable file, an\n70|// unparseable file, or zero production files. An empty failure slice with\n71|// an empty file list is impossible by construction.\n72|func ScanProduction(dir string) ([]ProductionFile, *token.FileSet, []string) {\n73|\tentries, err := os.ReadDir(dir)\n74|\tif err != nil {\n75|\t\treturn nil, nil, []string{\"scan production files: read \" + dir + \": \" + err.Error()}\n76|\t}\n77|\tvar names []string\n78|\tfor _, entry := range entries {\n79|\t\tname := entry.Name()\n80|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n81|\t\t\tcontinue\n82|\t\t}\n83|\t\tnames = append(names, name)\n84|\t}\n85|\tsort.Strings(names)\n86|\tif len(names) == 0 {\n87|\t\treturn nil, nil, []string{\"scanned zero production files in \" + dir + \"; the scanner is broken, not the package\"}\n88|\t}\n89|\tfileSet := token.NewFileSet()\n90|\tvar files []ProductionFile\n91|\tvar failures []string\n92|\tfor _, name := range names {\n93|\t\tpath := filepath.Join(dir, name)\n94|\t\tsource, err := os.ReadFile(path)\n95|\t\tif err != nil {\n96|\t\t\tfailures = append(failures, \"scan production files: read \"+path+\": \"+err.Error())\n97|\t\t\tcontinue\n98|\t\t}\n99|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n100|\t\tif err != nil {\n101|\t\t\tfailures = append(failures, \"scan production files: parse \"+path+\": \"+err.Error()+\"; an unparseable derivation proves nothing\")\n102|\t\t\tcontinue\n103|\t\t}\n104|\t\tfiles = append(files, ProductionFile{\n105|\t\t\tName:   name,\n106|\t\t\tPath:   path,\n107|\t\t\tSource: source,\n108|\t\t\tSyntax: syntax,\n109|\t\t\tFile:   fileSet.File(syntax.Pos()),\n110|\t\t})\n111|\t}\n112|\tif len(files) == 0 && len(failures) == 0 {\n113|\t\tfailures = append(failures, \"derived zero parsed production files in \"+dir+\"; the scanner is broken, not the package\")\n114|\t}\n115|\treturn files, fileSet, failures\n116|}\n117|\n118|// ParseSource parses one synthetic source (control plants, classifier\n119|// unit probes) with fail-closed semantics: the failure string is empty on\n120|// success and names the cause otherwise.\n121|func ParseSource(filename string, source []byte) (*ast.File, *token.FileSet, string) {\n122|\treturn ParseBytes(filename, source, parser.ParseComments)\n123|}\n124|\n125|// ParseBytes parses one source with the given parser mode and fail-closed\n126|// semantics: the failure string is empty on success and names the cause\n127|// otherwise. Inventories with a non-standard traversal (recursive walk,\n128|// content prefilter, imports-only scan) keep their traversal and route\n129|// parsing here, so an unparseable file fails identically everywhere.\n130|func ParseBytes(filename string, source []byte, mode parser.Mode) (*ast.File, *token.FileSet, string) {\n131|\tfileSet := token.NewFileSet()\n132|\tsyntax, err := parser.ParseFile(fileSet, filename, source, mode)\n133|\tif err != nil {\n134|\t\treturn nil, nil, \"parse \" + filename + \": \" + err.Error() + \"; an unparseable derivation proves nothing\"\n135|\t}\n136|\treturn syntax, fileSet, \"\"\n137|}\n138|\n139|// DiffSets is the both-direction harness over string keys: every derived\n140|// key without a row is unregistered, every row without a derived key is\n141|// orphaned. Both lists are sorted. Empty derived input is itself a\n142|// failure: a domain that silently derives nothing is not a measurement,\n143|// and the forward check would otherwise pass vacuously.\n144|func DiffSets(derived, rows map[string]struct{}) (unregistered, orphaned, failures []string) {\n145|\tif len(derived) == 0 {\n146|\t\tfailures = append(failures, \"derived zero sites; the scanner is broken, not the package\")\n147|\t}\n148|\tfor key := range derived {\n149|\t\tif _, ok := rows[key]; !ok {\n150|\t\t\tunregistered = append(unregistered, key)\n151|\t\t}\n152|\t}\n153|\tfor key := range rows {\n154|\t\tif _, ok := derived[key]; !ok {\n155|\t\t\torphaned = append(orphaned, key)\n156|\t\t}\n157|\t}\n158|\tsort.Strings(unregistered)\n159|\tsort.Strings(orphaned)\n160|\treturn unregistered, orphaned, failures\n161|}\n162|\n163|// ConstructorSpec declares the refusal constructors one audit watches:\n164|// package-local bare identifiers (mismatchf) and qualified constructors\n165|// matched by IMPORT PATH and member name (errors.New), so an import alias\n166|// cannot change what the audit sees.\n167|type ConstructorSpec struct {\n168|\t// Local names package-local constructor identifiers.\n169|\tLocal map[string]bool\n170|\t// Qualified maps an import path to its watched member names:\n171|\t// {\"errors\": {\"New\": true}, \"fmt\": {\"Errorf\": true}}. A member name\n172|\t// with a trailing \"*\" matches by prefix (\"Errorf*\" covers Errorf\n173|\t// and its Errorf-prefixed kin).\n174|\tQualified map[string]map[string]bool\n175|}\n176|\n177|// qualifiedWatches reports whether member is watched under path,\n178|// honoring trailing-\"*\" prefix entries.\n179|func qualifiedWatches(spec ConstructorSpec, path, member string) bool {\n180|\tmembers, ok := spec.Qualified[path]\n181|\tif !ok {\n182|\t\treturn false\n183|\t}\n184|\tif members[member] {\n185|\t\treturn true\n186|\t}\n187|\tfor watched := range members {\n188|\t\tif strings.HasSuffix(watched, \"*\") && strings.HasPrefix(member, strings.TrimSuffix(watched, \"*\")) {\n189|\t\t\treturn true\n190|\t\t}\n191|\t}\n192|\treturn false\n193|}\n194|\n195|// AuditConstructorReferences fails every constructor reference outside\n196|// direct-call position: aliases, var bindings, arguments, struct fields,\n197|// and shadows. Import aliases resolve through the file's import specs, so\n198|// `import errs \"errors\"; errs.New(\"…\")` attributes to errors.New and\n199|// `alias := errs.New` fails like any other binding. A dot import of a\n200|// watched path or any other shape the audit cannot classify fails closed\n201|// as unclassifiable instead of passing silently. Direct calls and the\n202|// constructors' own declarations are the only allowed positions.\n203|func AuditConstructorReferences(syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) []string {\n204|\timports := resolveImports(syntax, spec)\n205|\tfor path := range spec.Qualified {\n206|\t\tif dot, ok := imports.dot[path]; ok && dot {\n207|\t\t\treturn []string{display + \": dot-imports watched path \" + strconv.Quote(path) + \"; the audit cannot attribute bare \" + constructorMembers(spec.Qualified[path]) + \", qualify the import or widen the audit\"}\n208|\t\t}\n209|\t}\n210|\tallowed := map[token.Pos]bool{}\n211|\tast.Inspect(syntax, func(node ast.Node) bool {\n212|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n213|\t\tif ok && spec.Local[declaration.Name.Name] {\n214|\t\t\t// The declaration name itself is allowed, but the body\n215|\t\t\t// still scans: a direct call nested inside the funnel\n216|\t\t\t// body is attributable and must stay allowed.\n217|\t\t\tallowed[declaration.Name.Pos()] = true\n218|\t\t\treturn true\n219|\t\t}\n220|\t\tcall, ok := node.(*ast.CallExpr)\n221|\t\tif !ok {\n222|\t\t\treturn true\n223|\t\t}\n224|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n225|\t\t\tallowed[ident.Pos()] = true\n226|\t\t\treturn true\n227|\t\t}\n228|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n229|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n230|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n231|\t\t\t\t\tallowed[selector.Sel.Pos()] = true\n232|\t\t\t\t}\n233|\t\t\t}\n234|\t\t}\n235|\t\treturn true\n236|\t})\n237|\tvar failures []string\n238|\tast.Inspect(syntax, func(node ast.Node) bool {\n239|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n240|\t\tif ok && spec.Local[declaration.Name.Name] {\n241|\t\t\t// Descend: the declaration name is allowlisted by\n242|\t\t\t// position, but references nested in the funnel body\n243|\t\t\t// still audit.\n244|\t\t\treturn true\n245|\t\t}\n246|\t\tident, ok := node.(*ast.Ident)\n247|\t\tif !ok || allowed[ident.Pos()] {\n248|\t\t\treturn true\n249|\t\t}\n250|\t\tif spec.Local[ident.Name] {\n251|\t\t\tif _, declared := imports.names[ident.Name]; declared {\n252|\t\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" shadowed by an import or declaration the audit cannot classify; rename it or widen the audit\")\n253|\t\t\t\treturn true\n254|\t\t\t}\n255|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" referenced outside direct-call position; an aliased refusal cannot be inventoried, call it directly\")\n256|\t\t\treturn true\n257|\t\t}\n258|\t\treturn true\n259|\t})\n260|\tast.Inspect(syntax, func(node ast.Node) bool {\n261|\t\tselector, ok := node.(*ast.SelectorExpr)\n262|\t\tif !ok || allowed[selector.Sel.Pos()] {\n263|\t\t\treturn true\n264|\t\t}\n265|\t\treceiver, ok := selector.X.(*ast.Ident)\n266|\t\tif !ok {\n267|\t\t\treturn true\n268|\t\t}\n269|\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n270|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, selector.Sel.Pos())+\": constructor \"+strconv.Quote(receiver.Name+\".\"+selector.Sel.Name)+\" referenced outside direct-call position; an aliased construction cannot be inventoried, call it directly\")\n271|\t\t}\n272|\t\treturn true\n273|\t})\n274|\tsort.Strings(failures)\n275|\treturn failures\n276|}\n277|\n278|// FunPosition reports the audited position of a call's function: the\n279|// identifier for bare calls, the selector member for qualified calls.\n280|// WatchedCallPositions keys on exactly these positions.\n281|func FunPosition(call *ast.CallExpr) (token.Pos, bool) {\n282|\tswitch fun := call.Fun.(type) {\n283|\tcase *ast.Ident:\n284|\t\treturn fun.Pos(), true\n285|\tcase *ast.SelectorExpr:\n286|\t\treturn fun.Sel.Pos(), true\n287|\tdefault:\n288|\t\treturn token.NoPos, false\n289|\t}\n290|}\n291|\n292|// WatchedCallPositions returns the audited positions of every direct\n293|// call to a watched constructor in syntax: the attribution set. Callers\n294|// use it to attribute each watched construction to its enclosing\n295|// function (an allowlist scan), while AuditConstructorReferences owns\n296|// the alias direction over the same spec.\n297|func WatchedCallPositions(syntax *ast.File, spec ConstructorSpec) map[token.Pos]bool {\n298|\timports := resolveImports(syntax, spec)\n299|\tpositions := map[token.Pos]bool{}\n300|\tast.Inspect(syntax, func(node ast.Node) bool {\n301|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n302|\t\tif ok && spec.Local[declaration.Name.Name] {\n303|\t\t\treturn true\n304|\t\t}\n305|\t\tcall, ok := node.(*ast.CallExpr)\n306|\t\tif !ok {\n307|\t\t\treturn true\n308|\t\t}\n309|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n310|\t\t\tpositions[ident.Pos()] = true\n311|\t\t\treturn true\n312|\t\t}\n313|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n314|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n315|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n316|\t\t\t\t\tpositions[selector.Sel.Pos()] = true\n317|\t\t\t\t}\n318|\t\t\t}\n319|\t\t}\n320|\t\treturn true\n321|\t})\n322|\treturn positions\n323|}\n324|\n325|// importResolution maps the file's local import names to paths.\n326|type importResolution struct {\n327|\tnames map[string]string\n328|\tdot   map[string]bool\n329|}\n330|\n331|func (resolution importResolution) pathOf(local string) string {\n332|\treturn resolution.names[local]\n333|}\n334|\n335|// resolveImports reads the file's import specs into local-name to path\n336|// bindings. Explicit aliases, blank imports, and default base names all\n337|// resolve; only dot imports are unresolvable, and the caller fails them\n338|// closed.\n339|func resolveImports(syntax *ast.File, spec ConstructorSpec) importResolution {\n340|\tresolution := importResolution{names: map[string]string{}, dot: map[string]bool{}}\n341|\tfor _, declaration := range syntax.Decls {\n342|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n343|\t\tif !ok || general.Tok != token.IMPORT {\n344|\t\t\tcontinue\n345|\t\t}\n346|\t\tfor _, item := range general.Specs {\n347|\t\t\tloaded, ok := item.(*ast.ImportSpec)\n348|\t\t\tif !ok {\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tpath, err := strconv.Unquote(loaded.Path.Value)\n352|\t\t\tif err != nil {\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif loaded.Name != nil && loaded.Name.Name == \".\" {\n356|\t\t\t\tresolution.dot[path] = true\n357|\t\t\t\tcontinue\n358|\t\t\t}\n359|\t\t\tlocal := importBaseName(path)\n360|\t\t\tif loaded.Name != nil {\n361|\t\t\t\tlocal = loaded.Name.Name\n362|\t\t\t}\n363|\t\t\tif local == \"_\" {\n364|\t\t\t\tcontinue\n365|\t\t\t}\n366|\t\t\tresolution.names[local] = path\n367|\t\t}\n368|\t}\n369|\treturn resolution\n370|}\n371|\n372|// importBaseName renders the default local name of an import path.\n373|func importBaseName(path string) string {\n374|\tif index := strings.LastIndex(path, \"/\"); index >= 0 {\n375|\t\treturn path[index+1:]\n376|\t}\n377|\treturn path\n378|}\n379|\n380|// constructorMembers joins watched member names for diagnostics.\n381|func constructorMembers(members map[string]bool) string {\n382|\tvar names []string\n383|\tfor name := range members {\n384|\t\tnames = append(names, name)\n385|\t}\n386|\tsort.Strings(names)\n387|\treturn strings.Join(names, \", \")\n388|}\n389|\n390|// positionOf renders line:column for diagnostics; never empty.\n391|func positionOf(fileSet *token.FileSet, position token.Pos) string {\n392|\tlocated := fileSet.Position(position)\n393|\tif !located.IsValid() {\n394|\t\treturn \"?:?\"\n395|\t}\n396|\treturn strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column)\n397|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c7","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":190,"recorded_at":1780531400000375,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"5a26c110-8253-4c15-8038-819031a82cfb"},"task_id":"5a26c110-8253-4c15-8038-819031a82cfb","event":{"kind":"completed","task_id":"5a26c110-8253-4c15-8038-819031a82cfb"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4c9","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":191,"recorded_at":1780531400000377,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"54a00377-9c15-43a8-ad7e-68c5850e1d58"},"task_id":"54a00377-9c15-43a8-ad7e-68c5850e1d58","event":{"kind":"output","task_id":"54a00377-9c15-43a8-ad7e-68c5850e1d58","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the name layer of the shared-implementation\n15|// census. The story's premise is that the Provider, Session\n16|// Adapter, and Directory Node facades sit on one environment\n17|// library; each facade carried its own copy of the shared rules,\n18|// and independent copies of the same rule drift in ways no\n19|// per-facade reviewer can see. This census is the boundary that\n20|// fails when the facades diverge: it derives every shared-rule\n21|// implementation known by identifier from production source and\n22|// requires the derived set to equal the ledger below exactly.\n23|// The shape layer in shape_census_test.go derives implementations\n24|// by implementation texture and catches copies under fresh\n25|// spellings, new byte measures, and var-bound aliases that this\n26|// name layer cannot see; the two layers are complementary by\n27|// construction.\n28|//\n29|// Removing or renaming a ledgered implementation orphans its row\n30|// and fails too. An empty scan fails closed. The ledger records\n31|// the single canonical owner per rule (this package, or scalar\n32|// where the grammar already has one) plus the copies this leaf\n33|// does not unify; each copy names the battery file that pins it\n34|// to the canonical semantics. The sessadapter and dirnode frame\n35|// decoders are delegating wrappers onto environ.DecodeStrictObject\n36|// (their raw-scan divergence, once ledgered here, was closed by\n37|// delegation and is proven in both directions by the\n38|// frame-agreement battery); the remaining provhost, canonicaljson,\n39|// and scalar copies are unification residue tracked in the\n40|// cross-story follow-up, not harmless divergence.\n41|//\n42|// Scope. The scan covers the story packages (environ, provider,\n43|// provhost, sessadapter, dirnode) plus the grammar owners\n44|// (scalar, canonicaljson). Copies in config, cliresult,\n45|// terminalbackend, axerror, and the other stories' packages are\n46|// outside this story's ownership: each package derives its own\n47|// inventories in its own test files, and gating another story's\n48|// package from here would couple stories that must land\n49|// independently. That exclusion is a stated bound, not a blind\n50|// spot: the scan fails closed inside its scope, and a copy that\n51|// moves into scope (a new definition in a scanned package)\n52|// fails as unregistered.\n53|\n54|// sharedSite is one derived shared-rule implementation.\n55|type sharedSite struct {\n56|\tclass  string\n57|\tpkg    string\n58|\tfile   string\n59|\tsymbol string\n60|}\n61|\n62|// sharedSiteKey renders the ledger key for one site.\n63|func (site sharedSite) sharedSiteKey() string {\n64|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n65|}\n66|\n67|// censusPackages is the exact scan scope. A production file in\n68|// any other package is outside this story's jurisdiction.\n69|var censusPackages = map[string]bool{\n70|\t\"environ\":       true,\n71|\t\"provider\":      true,\n72|\t\"provhost\":      true,\n73|\t\"sessadapter\":   true,\n74|\t\"dirnode\":       true,\n75|\t\"scalar\":        true,\n76|\t\"canonicaljson\": true,\n77|}\n78|\n79|// sharedLedger maps every known shared-rule implementation to\n80|// the rationale that keeps it honest. Canonical owners are the\n81|// single implementation new code must use; every other row names\n82|// the battery file that pins the copy to the canonical\n83|// semantics.\n84|var sharedLedger = map[string]string{\n85|\t// Frame decoders: one JSON entry point per package.\n86|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":     \"canonical owner: string-walk surrogate semantics, rune measure\",\n87|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\":  \"pinned by frame_agreement_test.go\",\n88|\t\"strict-decoder|sessadapter|decode.go|decodeStrictObject\": \"delegating wrapper onto environ.DecodeStrictObject, pinned by TestDelegatingWrappersCallEnviron + frame_agreement_test.go\",\n89|\t\"strict-decoder|dirnode|decode.go|decodeStrictObject\":     \"delegating wrapper onto environ.DecodeStrictObject, pinned by TestDelegatingWrappersCallEnviron + frame_agreement_test.go\",\n90|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\":  \"canonicalizer entry: distinct JCS pipeline role, surrogate verdicts pinned by frame_agreement_test.go\",\n91|\t// Lone-surrogate gates.\n92|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n93|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n94|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n95|\t// String measures.\n96|\t\"string-measure|environ|decode.go|StringLength\":     \"canonical owner: runes per Section 1.6\",\n97|\t\"string-measure|provhost|opdecode.go|runeLength\":    \"runes, pinned by measure_agreement_test.go\",\n98|\t\"string-measure|sessadapter|decode.go|stringLength\": \"byte-frozen leaf 1: runes, pinned by measure_agreement_test.go\",\n99|\t\"string-measure|dirnode|decode.go|stringLength\":     \"byte-frozen leaf 2: runes, pinned by measure_agreement_test.go\",\n100|\t// Identity validators: two refusal dialects over one rule.\n101|\t\"identity-validator|provhost|identity.go|CheckIdentity\":                           \"provider-stdio refusal dialect, pinned by identity_agreement_test.go\",\n102|\t\"identity-validator|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"identity refusal dialect, pinned by identity_agreement_test.go\",\n103|}\n104|\n105|// sharedFunctionSymbols maps a function name to its census\n106|// class.\n107|var sharedFunctionSymbols = map[string]string{\n108|\t\"decodeStrictObject\":             \"strict-decoder\",\n109|\t\"DecodeStrictObject\":             \"strict-decoder\",\n110|\t\"decodeStrict\":                   \"strict-decoder\",\n111|\t\"hasLoneSurrogateEscape\":         \"surrogate-gate\",\n112|\t\"HasLoneSurrogateEscape\":         \"surrogate-gate\",\n113|\t\"validateSurrogateEscapes\":       \"surrogate-gate\",\n114|\t\"stringLength\":                   \"string-measure\",\n115|\t\"runeLength\":                     \"string-measure\",\n116|\t\"StringLength\":                   \"string-measure\",\n117|\t\"CheckIdentity\":                  \"identity-validator\",\n118|\t\"validateProviderIdentityRecord\": \"identity-validator\",\n119|}\n120|\n121|// grammarSymbols maps a package-level variable name to its\n122|// grammar class. Only same-rule grammars share a class: the\n123|// three capabilityOrder tables (directory eight, adapter\n124|// fifteen, provider seven) and the per-major platform tables are\n125|// deliberately absent here and are pinned by literal-list\n126|// derivation in grammar_test.go instead, where the rule identity\n127|// travels with the comparison.\n128|var grammarSymbols = map[string]string{\n129|\t\"environmentIDPattern\": \"env-id-grammar\",\n130|\t\"semverPattern\":        \"semver-grammar\",\n131|\t\"reverseDNSPattern\":    \"extensions-grammar\",\n132|\t\"providerIDPattern\":    \"provider-id-grammar\",\n133|}\n134|\n135|// deriveSharedSites scans every production Go file in the census\n136|// packages for shared-rule implementations. Test files are never\n137|// scanned: a helper in a test is not a production copy. An\n138|// unreadable file or a parse failure fails closed: a scanner that\n139|// cannot read a file must not report the file as clean.\n140|func deriveSharedSites(t *testing.T) map[string]bool {\n141|\tt.Helper()\n142|\tsites := map[string]bool{}\n143|\tfor _, site := range scanSharedSymbols(t, sharedFunctionSymbols, true) {\n144|\t\tsites[site] = true\n145|\t}\n146|\tif len(sites) == 0 {\n147|\t\tt.Fatal(\"census derived zero shared-rule sites from a tree known to duplicate them; the scanner is blind, not the tree clean\")\n148|\t}\n149|\treturn sites\n150|}\n151|\n152|// scanSharedSymbols scans the census packages for function or\n153|// package-level variable definitions whose names appear in the\n154|// symbol map, and returns ledger keys for each hit.\n155|func scanSharedSymbols(t *testing.T, symbols map[string]string, functions bool) []string {\n156|\tt.Helper()\n157|\troot, err := internalRoot(t)\n158|\tif err != nil {\n159|\t\tt.Fatalf(\"census: %v\", err)\n160|\t}\n161|\tvar keys []string\n162|\tcount := 0\n163|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n164|\t\tif err != nil {\n165|\t\t\treturn err\n166|\t\t}\n167|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n168|\t\t\treturn nil\n169|\t\t}\n170|\t\trel, err := filepath.Rel(root, path)\n171|\t\tif err != nil {\n172|\t\t\treturn err\n173|\t\t}\n174|\t\tparts := strings.Split(rel, string(filepath.Separator))\n175|\t\tpkg := parts[0]\n176|\t\tif !censusPackages[pkg] {\n177|\t\t\treturn nil\n178|\t\t}\n179|\t\tcount++\n180|\t\tsource, err := os.ReadFile(path)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"census: read %s: %v\", path, err)\n183|\t\t}\n184|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"census: parse %s: %v\", path, err)\n187|\t\t}\n188|\t\tfile := parts[len(parts)-1]\n189|\t\tfor _, decl := range syntax.Decls {\n190|\t\t\tswitch node := decl.(type) {\n191|\t\t\tcase *ast.FuncDecl:\n192|\t\t\t\tif !functions || node.Name == nil {\n193|\t\t\t\t\tcontinue\n194|\t\t\t\t}\n195|\t\t\t\tif class, ok := symbols[node.Name.Name]; ok {\n196|\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, node.Name.Name}.sharedSiteKey())\n197|\t\t\t\t}\n198|\t\t\tcase *ast.GenDecl:\n199|\t\t\t\tif functions {\n200|\t\t\t\t\tcontinue\n201|\t\t\t\t}\n202|\t\t\t\tfor _, spec := range node.Specs {\n203|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n204|\t\t\t\t\tif !ok {\n205|\t\t\t\t\t\tcontinue\n206|\t\t\t\t\t}\n207|\t\t\t\t\tfor _, name := range value.Names {\n208|\t\t\t\t\t\tif class, ok := symbols[name.Name]; ok {\n209|\t\t\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, name.Name}.sharedSiteKey())\n210|\t\t\t\t\t\t}\n211|\t\t\t\t\t}\n212|\t\t\t\t}\n213|\t\t\t}\n214|\t\t}\n215|\t\treturn nil\n216|\t})\n217|\tif err != nil {\n218|\t\tt.Fatalf(\"census: walk: %v\", err)\n219|\t}\n220|\tif count == 0 {\n221|\t\tt.Fatal(\"census scanned zero files; the scanner is broken, not the tree\")\n222|\t}\n223|\treturn keys\n224|}\n225|\n226|// internalRoot returns the internal/ source root above this\n227|// package directory.\n228|func internalRoot(t *testing.T) (string, error) {\n229|\tt.Helper()\n230|\tdirectory, err := os.Getwd()\n231|\tif err != nil {\n232|\t\treturn \"\", err\n233|\t}\n234|\treturn filepath.Dir(directory), nil\n235|}\n236|\n237|// TestSharedImplementationsAreCensused requires the derived\n238|// implementation set to equal the ledger exactly: an unregistered\n239|// copy fails as a unification violation, and a row naming an\n240|// implementation production no longer derives fails as orphaned.\n241|func TestSharedImplementationsAreCensused(t *testing.T) {\n242|\tderived := deriveSharedSites(t)\n243|\tfor key := range derived {\n244|\t\tif _, ok := sharedLedger[key]; !ok {\n245|\t\t\tt.Errorf(\"unregistered shared-rule copy %q: add one canonical implementation in internal/environ instead, or ledger the divergence with its agreement battery\", key)\n246|\t\t}\n247|\t}\n248|\tfor key, rationale := range sharedLedger {\n249|\t\tif !derived[key] {\n250|\t\t\tt.Errorf(\"orphaned ledger row %q (%s): production no longer derives it\", key, rationale)\n251|\t\t}\n252|\t}\n253|}\n254|\n255|// grammarSiteLedger names every grammar definition site in the\n256|// census scope. A new grammar definition fails here even when it\n257|// carries an identical literal: a second copy is a second copy,\n258|// and the next edit drifts exactly one of them.\n259|var grammarSiteLedger = map[string]bool{\n260|\t\"env-id-grammar|environ|tuple.go|environmentIDPattern\":                true,\n261|\t\"env-id-grammar|sessadapter|decode.go|environmentIDPattern\":           true,\n262|\t\"env-id-grammar|dirnode|decode.go|environmentIDPattern\":               true,\n263|\t\"env-id-grammar|canonicaljson|closed_shapes.go|environmentIDPattern\":  true,\n264|\t\"semver-grammar|environ|tuple.go|semverPattern\":                       true,\n265|\t\"semver-grammar|sessadapter|decode.go|semverPattern\":                  true,\n266|\t\"semver-grammar|dirnode|decode.go|semverPattern\":                      true,\n267|\t\"semver-grammar|canonicaljson|closed_shapes.go|semverPattern\":         true,\n268|\t\"semver-grammar|provhost|manifest.go|semverPattern\":                   true,\n269|\t\"extensions-grammar|environ|decode.go|reverseDNSPattern\":              true,\n270|\t\"extensions-grammar|sessadapter|decode.go|reverseDNSPattern\":          true,\n271|\t\"extensions-grammar|dirnode|decode.go|reverseDNSPattern\":              true,\n272|\t\"extensions-grammar|canonicaljson|closed_shapes.go|reverseDNSPattern\": true,\n273|\t\"provider-id-grammar|scalar|names.go|providerIDPattern\":               true,\n274|\t\"provider-id-grammar|provhost|manifest.go|providerIDPattern\":          true,\n275|\t\"provider-id-grammar|sessadapter|decode.go|providerIDPattern\":         true,\n276|\t\"provider-id-grammar|dirnode|query.go|providerIDPattern\":              true,\n277|}\n278|\n279|// grammarCandidate is one package-level single MustCompile\n280|// definition: the defined symbol and its pattern literal.\n281|type grammarCandidate struct {\n282|\tsymbol  string\n283|\tliteral string\n284|}\n285|\n286|// grammarCandidatesInFile extracts every package-level single\n287|// MustCompile definition from one source file. It is pure over\n288|// its inputs, so the synthetic controls drive this exact\n289|// function on planted sources.\n290|func grammarCandidatesInFile(path string, source []byte) ([]grammarCandidate, error) {\n291|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n292|\tif err != nil {\n293|\t\treturn nil, err\n294|\t}\n295|\tvar candidates []grammarCandidate\n296|\tfor _, decl := range syntax.Decls {\n297|\t\tnode, ok := decl.(*ast.GenDecl)\n298|\t\tif !ok {\n299|\t\t\tcontinue\n300|\t\t}\n301|\t\tfor _, spec := range node.Specs {\n302|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n303|\t\t\tif !ok || len(value.Names) != 1 || len(value.Values) != 1 {\n304|\t\t\t\tcontinue\n305|\t\t\t}\n306|\t\t\tcall, ok := value.Values[0].(*ast.CallExpr)\n307|\t\t\tif !ok || len(call.Args) != 1 {\n308|\t\t\t\tcontinue\n309|\t\t\t}\n310|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n311|\t\t\tif !ok || selector.Sel.Name != \"MustCompile\" {\n312|\t\t\t\tcontinue\n313|\t\t\t}\n314|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n315|\t\t\tif !ok {\n316|\t\t\t\tcontinue\n317|\t\t\t}\n318|\t\t\ttext, err := strconv.Unquote(literal.Value)\n319|\t\t\tif err != nil {\n320|\t\t\t\tcontinue\n321|\t\t\t}\n322|\t\t\tcandidates = append(candidates, grammarCandidate{symbol: value.Names[0].Name, literal: text})\n323|\t\t}\n324|\t}\n325|\treturn candidates, nil\n326|}\n327|\n328|// deriveGrammarLiterals derives the regex literal behind every\n329|// grammar definition in the census scope, keyed by ledger key.\n330|// Two definitions carrying different literals are different\n331|// languages even when the symbol name matches; the grammar\n332|// battery requires one literal per class. Definitions under a\n333|// fresh name carrying a known class literal derive as fresh\n334|// copies of that class: a second copy is a second copy even\n335|// when the symbol is new.\n336|func deriveGrammarLiterals(t *testing.T) (map[string]map[string]bool, map[string]bool, map[string]bool) {\n337|\tt.Helper()\n338|\troot, err := internalRoot(t)\n339|\tif err != nil {\n340|\t\tt.Fatalf(\"grammar: %v\", err)\n341|\t}\n342|\tliterals := map[string]map[string]bool{}\n343|\tsites := map[string]bool{}\n344|\ttype collectedCandidate struct {\n345|\t\tpkg       string\n346|\t\tfile      string\n347|\t\tcandidate grammarCandidate\n348|\t}\n349|\tvar collected []collectedCandidate\n350|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n351|\t\tif err != nil {\n352|\t\t\treturn err\n353|\t\t}\n354|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n355|\t\t\treturn nil\n356|\t\t}\n357|\t\trel, err := filepath.Rel(root, path)\n358|\t\tif err != nil {\n359|\t\t\treturn err\n360|\t\t}\n361|\t\tparts := strings.Split(rel, string(filepath.Separator))\n362|\t\tpkg := parts[0]\n363|\t\tif !censusPackages[pkg] {\n364|\t\t\treturn nil\n365|\t\t}\n366|\t\tsource, err := os.ReadFile(path)\n367|\t\tif err != nil {\n368|\t\t\tt.Fatalf(\"grammar: read %s: %v\", path, err)\n369|\t\t}\n370|\t\tcandidates, err := grammarCandidatesInFile(path, source)\n371|\t\tif err != nil {\n372|\t\t\tt.Fatalf(\"grammar: parse %s: %v\", path, err)\n373|\t\t}\n374|\t\tfor _, candidate := range candidates {\n375|\t\t\tcollected = append(collected, collectedCandidate{pkg: pkg, file: parts[len(parts)-1], candidate: candidate})\n376|\t\t}\n377|\t\treturn nil\n378|\t})\n379|\tif err != nil {\n380|\t\tt.Fatalf(\"grammar: walk: %v\", err)\n381|\t}\n382|\tfor _, entry := range collected {\n383|\t\tclass, known := grammarSymbols[entry.candidate.symbol]\n384|\t\tif !known {\n385|\t\t\tcontinue\n386|\t\t}\n387|\t\tif literals[class] == nil {\n388|\t\t\tliterals[class] = map[string]bool{}\n389|\t\t}\n390|\t\tliterals[class][entry.candidate.literal] = true\n391|\t\tsites[sharedSite{class, entry.pkg, entry.file, entry.candidate.symbol}.sharedSiteKey()] = true\n392|\t}\n393|\tknownLiterals := grammarKnownLiterals(literals)\n394|\tfresh := map[string]bool{}\n395|\tfor _, entry := range collected {\n396|\t\tif class, copy := classifyGrammarCandidate(entry.candidate, knownLiterals); copy {\n397|\t\t\tfresh[sharedSite{class, entry.pkg, entry.file, entry.candidate.symbol}.sharedSiteKey()] = true\n398|\t\t}\n399|\t}\n400|\treturn literals, sites, fresh\n401|}\n402|\n403|// grammarKnownLiterals inverts the derived class literals into a\n404|// literal-to-class map. It is pure over the derivation, so the\n405|// synthetic controls classify against the same map production\n406|// uses.\n407|func grammarKnownLiterals(literals map[string]map[string]bool) map[string]string {\n408|\tknown := map[string]string{}\n409|\tfor class, texts := range literals {\n410|\t\tfor text := range texts {\n411|\t\t\tknown[text] = class\n412|\t\t}\n413|\t}\n414|\treturn known\n415|}\n416|\n417|// classifyGrammarCandidate reports whether a MustCompile\n418|// definition is a fresh-name copy of a known class: a symbol\n419|// outside grammarSymbols carrying a known class literal. Named\n420|// definitions and unknown literals are not copies.\n421|func classifyGrammarCandidate(candidate grammarCandidate, known map[string]string) (string, bool) {\n422|\tif _, named := grammarSymbols[candidate.symbol]; named {\n423|\t\treturn \"\", false\n424|\t}\n425|\tclass, match := known[candidate.literal]\n426|\tif !match {\n427|\t\treturn \"\", false\n428|\t}\n429|\treturn class, true\n430|}\n431|\n432|// TestSharedGrammarsAreOneLanguage requires every grammar in the\n433|// census scope to carry the identical regex literal: same symbol\n434|// with different literals would be two languages under one name,\n435|// and a mutant rewriting one copy's literal reddens here.\n436|func TestSharedGrammarsAreOneLanguage(t *testing.T) {\n437|\tliterals, sites, fresh := deriveGrammarLiterals(t)\n438|\tfor key := range sites {\n439|\t\tif !grammarSiteLedger[key] {\n440|\t\t\tt.Errorf(\"unregistered grammar copy %q: one language means one definition site per package at most\", key)\n441|\t\t}\n442|\t}\n443|\tfor key := range fresh {\n444|\t\tt.Errorf(\"unregistered grammar copy under a fresh name %q: a second copy is a second copy even when the symbol is new\", key)\n445|\t}\n446|\tfor key := range grammarSiteLedger {\n447|\t\tif !sites[key] {\n448|\t\t\tt.Errorf(\"orphaned grammar row %q: production no longer derives it\", key)\n449|\t\t}\n450|\t}\n451|\tfor class, texts := range literals {\n452|\t\tif len(texts) != 1 {\n453|\t\t\tvar variants []string\n454|\t\t\tfor text := range texts {\n455|\t\t\t\tvariants = append(variants, strconv.Quote(text))\n456|\t\t\t}\n457|\t\t\tt.Errorf(\"grammar class %q has %d distinct literals: %s\", class, len(texts), strings.Join(variants, \" vs \"))\n458|\t\t}\n459|\t}\n460|\tif len(literals) != len(grammarSymbols) {\n461|\t\tt.Fatalf(\"grammar: derived %d classes, want %d; the extractor is blind, not the tree clean\", len(literals), len(grammarSymbols))\n462|\t}\n463|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cb","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":192,"recorded_at":1780531400000379,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"54a00377-9c15-43a8-ad7e-68c5850e1d58"},"task_id":"54a00377-9c15-43a8-ad7e-68c5850e1d58","event":{"kind":"completed","task_id":"54a00377-9c15-43a8-ad7e-68c5850e1d58"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad21b9b754080365ba0201ac068","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/invcore/invcore.go`.\n1|// Package invcore is the shared test-support core for production-derived\n2|// inventories: production-file selection, fail-closed parsing, and the\n3|// both-direction check harness.\n4|//\n5|// Every package inventory in this repository derives its denominator from\n6|// production source instead of listing it, in three historical\n7|// architectures for the same idea: terminalbackend resolves declared rows\n8|// textually and refuses constructor aliasing outright; provhost executes\n9|// every witness through the production entry point and keys on identifier\n10|// names behind a separate call-site audit; provider instruments constructor\n11|// vars at runtime in TestMain and audits the exercised file:line set\n12|// against AST-derived sites. The weaker bound was the real bound, so this\n13|// core carries the UNION of those directions, not the intersection:\n14|//\n15|//   - ScanProduction owns production-file selection: directory-derived,\n16|//     every *.go except *_test.go, sorted, so a new production file is\n17|//     scanned without anyone remembering it. Zero files is a failure,\n18|//     never a vacuous pass.\n19|//   - MustParse owns fail-closed parsing: an unparseable file fails, never\n20|//     skips. A file the derivation cannot read proves nothing.\n21|//   - DiffSets owns the both-direction harness: derived-without-row\n22|//     (unregistered site) AND row-without-site (orphan row) fail together.\n23|//     The forward direction alone passes vacuously on a truncated\n24|//     derivation.\n25|//   - AuditConstructorReferences owns the alias-bypass union: constructor\n26|//     references outside direct-call position fail outright\n27|//     (terminalbackend direction), import aliases and dot imports resolve\n28|//     against the imported path instead of the local spelling (the shape\n29|//     that walked through every identifier-keyed gate in this repository),\n30|//     and var bindings are references, not calls (provider direction made\n31|//     static). Anything the audit cannot classify — a dot import of a\n32|//     watched path, an unresolved shadowing — fails closed as\n33|//     unclassifiable, never pruned.\n34|//   - SiteRecorder owns the runtime direction (provider/provhost shape):\n35|//     instrumented constructor vars record the production file:line behind\n36|//     every exercised refusal, and the audit requires the exercised set to\n37|//     equal the derived site set in both directions.\n38|//\n39|// All checks come in two spellings: a pure func returning failures for\n40|// negative tests and control plants, and a Must wrapper that fails the\n41|// suite. A gate that can only fatal cannot be planted against, and a plant\n42|// that cannot run proves nothing.\n43|package invcore\n44|\n45|import (\n46|\t\"go/ast\"\n47|\t\"go/parser\"\n48|\t\"go/token\"\n49|\t\"os\"\n50|\t\"path/filepath\"\n51|\t\"sort\"\n52|\t\"strconv\"\n53|\t\"strings\"\n54|)\n55|\n56|// ProductionFile is one parsed production source: basename, full path,\n57|// raw bytes, and syntax parsed with a directory-shared FileSet.\n58|type ProductionFile struct {\n59|\tName   string\n60|\tPath   string\n61|\tSource []byte\n62|\tSyntax *ast.File\n63|\tFile   *token.File\n64|}\n65|\n66|// ScanProduction reads every production file of the directory at dir:\n67|// every *.go except *_test.go, in sorted order. It returns the parsed\n68|// files with their shared FileSet, plus a failure string for every\n69|// fail-closed condition: an unreadable directory, an unreadable file, an\n70|// unparseable file, or zero production files. An empty failure slice with\n71|// an empty file list is impossible by construction.\n72|func ScanProduction(dir string) ([]ProductionFile, *token.FileSet, []string) {\n73|\tentries, err := os.ReadDir(dir)\n74|\tif err != nil {\n75|\t\treturn nil, nil, []string{\"scan production files: read \" + dir + \": \" + err.Error()}\n76|\t}\n77|\tvar names []string\n78|\tfor _, entry := range entries {\n79|\t\tname := entry.Name()\n80|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n81|\t\t\tcontinue\n82|\t\t}\n83|\t\tnames = append(names, name)\n84|\t}\n85|\tsort.Strings(names)\n86|\tif len(names) == 0 {\n87|\t\treturn nil, nil, []string{\"scanned zero production files in \" + dir + \"; the scanner is broken, not the package\"}\n88|\t}\n89|\tfileSet := token.NewFileSet()\n90|\tvar files []ProductionFile\n91|\tvar failures []string\n92|\tfor _, name := range names {\n93|\t\tpath := filepath.Join(dir, name)\n94|\t\tsource, err := os.ReadFile(path)\n95|\t\tif err != nil {\n96|\t\t\tfailures = append(failures, \"scan production files: read \"+path+\": \"+err.Error())\n97|\t\t\tcontinue\n98|\t\t}\n99|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n100|\t\tif err != nil {\n101|\t\t\tfailures = append(failures, \"scan production files: parse \"+path+\": \"+err.Error()+\"; an unparseable derivation proves nothing\")\n102|\t\t\tcontinue\n103|\t\t}\n104|\t\tfiles = append(files, ProductionFile{\n105|\t\t\tName:   name,\n106|\t\t\tPath:   path,\n107|\t\t\tSource: source,\n108|\t\t\tSyntax: syntax,\n109|\t\t\tFile:   fileSet.File(syntax.Pos()),\n110|\t\t})\n111|\t}\n112|\tif len(files) == 0 && len(failures) == 0 {\n113|\t\tfailures = append(failures, \"derived zero parsed production files in \"+dir+\"; the scanner is broken, not the package\")\n114|\t}\n115|\treturn files, fileSet, failures\n116|}\n117|\n118|// ParseSource parses one synthetic source (control plants, classifier\n119|// unit probes) with fail-closed semantics: the failure string is empty on\n120|// success and names the cause otherwise.\n121|func ParseSource(filename string, source []byte) (*ast.File, *token.FileSet, string) {\n122|\treturn ParseBytes(filename, source, parser.ParseComments)\n123|}\n124|\n125|// ParseBytes parses one source with the given parser mode and fail-closed\n126|// semantics: the failure string is empty on success and names the cause\n127|// otherwise. Inventories with a non-standard traversal (recursive walk,\n128|// content prefilter, imports-only scan) keep their traversal and route\n129|// parsing here, so an unparseable file fails identically everywhere.\n130|func ParseBytes(filename string, source []byte, mode parser.Mode) (*ast.File, *token.FileSet, string) {\n131|\tfileSet := token.NewFileSet()\n132|\tsyntax, err := parser.ParseFile(fileSet, filename, source, mode)\n133|\tif err != nil {\n134|\t\treturn nil, nil, \"parse \" + filename + \": \" + err.Error() + \"; an unparseable derivation proves nothing\"\n135|\t}\n136|\treturn syntax, fileSet, \"\"\n137|}\n138|\n139|// DiffSets is the both-direction harness over string keys: every derived\n140|// key without a row is unregistered, every row without a derived key is\n141|// orphaned. Both lists are sorted. Empty derived input is itself a\n142|// failure: a domain that silently derives nothing is not a measurement,\n143|// and the forward check would otherwise pass vacuously.\n144|func DiffSets(derived, rows map[string]struct{}) (unregistered, orphaned, failures []string) {\n145|\tif len(derived) == 0 {\n146|\t\tfailures = append(failures, \"derived zero sites; the scanner is broken, not the package\")\n147|\t}\n148|\tfor key := range derived {\n149|\t\tif _, ok := rows[key]; !ok {\n150|\t\t\tunregistered = append(unregistered, key)\n151|\t\t}\n152|\t}\n153|\tfor key := range rows {\n154|\t\tif _, ok := derived[key]; !ok {\n155|\t\t\torphaned = append(orphaned, key)\n156|\t\t}\n157|\t}\n158|\tsort.Strings(unregistered)\n159|\tsort.Strings(orphaned)\n160|\treturn unregistered, orphaned, failures\n161|}\n162|\n163|// ConstructorSpec declares the refusal constructors one audit watches:\n164|// package-local bare identifiers (mismatchf) and qualified constructors\n165|// matched by IMPORT PATH and member name (errors.New), so an import alias\n166|// cannot change what the audit sees.\n167|type ConstructorSpec struct {\n168|\t// Local names package-local constructor identifiers.\n169|\tLocal map[string]bool\n170|\t// Qualified maps an import path to its watched member names:\n171|\t// {\"errors\": {\"New\": true}, \"fmt\": {\"Errorf\": true}}. A member name\n172|\t// with a trailing \"*\" matches by prefix (\"Errorf*\" covers Errorf\n173|\t// and its Errorf-prefixed kin).\n174|\tQualified map[string]map[string]bool\n175|}\n176|\n177|// qualifiedWatches reports whether member is watched under path,\n178|// honoring trailing-\"*\" prefix entries.\n179|func qualifiedWatches(spec ConstructorSpec, path, member string) bool {\n180|\tmembers, ok := spec.Qualified[path]\n181|\tif !ok {\n182|\t\treturn false\n183|\t}\n184|\tif members[member] {\n185|\t\treturn true\n186|\t}\n187|\tfor watched := range members {\n188|\t\tif strings.HasSuffix(watched, \"*\") && strings.HasPrefix(member, strings.TrimSuffix(watched, \"*\")) {\n189|\t\t\treturn true\n190|\t\t}\n191|\t}\n192|\treturn false\n193|}\n194|\n195|// AuditConstructorReferences fails every constructor reference outside\n196|// direct-call position: aliases, var bindings, arguments, struct fields,\n197|// and shadows. Import aliases resolve through the file's import specs, so\n198|// `import errs \"errors\"; errs.New(\"…\")` attributes to errors.New and\n199|// `alias := errs.New` fails like any other binding. A dot import of a\n200|// watched path or any other shape the audit cannot classify fails closed\n201|// as unclassifiable instead of passing silently. Direct calls and the\n202|// constructors' own declarations are the only allowed positions.\n203|func AuditConstructorReferences(syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) []string {\n204|\timports := resolveImports(syntax, spec)\n205|\tfor path := range spec.Qualified {\n206|\t\tif dot, ok := imports.dot[path]; ok && dot {\n207|\t\t\treturn []string{display + \": dot-imports watched path \" + strconv.Quote(path) + \"; the audit cannot attribute bare \" + constructorMembers(spec.Qualified[path]) + \", qualify the import or widen the audit\"}\n208|\t\t}\n209|\t}\n210|\tallowed := map[token.Pos]bool{}\n211|\tast.Inspect(syntax, func(node ast.Node) bool {\n212|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n213|\t\tif ok && spec.Local[declaration.Name.Name] {\n214|\t\t\t// The declaration name itself is allowed, but the body\n215|\t\t\t// still scans: a direct call nested inside the funnel\n216|\t\t\t// body is attributable and must stay allowed.\n217|\t\t\tallowed[declaration.Name.Pos()] = true\n218|\t\t\treturn true\n219|\t\t}\n220|\t\tcall, ok := node.(*ast.CallExpr)\n221|\t\tif !ok {\n222|\t\t\treturn true\n223|\t\t}\n224|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n225|\t\t\tallowed[ident.Pos()] = true\n226|\t\t\treturn true\n227|\t\t}\n228|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n229|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n230|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n231|\t\t\t\t\tallowed[selector.Sel.Pos()] = true\n232|\t\t\t\t}\n233|\t\t\t}\n234|\t\t}\n235|\t\treturn true\n236|\t})\n237|\tvar failures []string\n238|\tast.Inspect(syntax, func(node ast.Node) bool {\n239|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n240|\t\tif ok && spec.Local[declaration.Name.Name] {\n241|\t\t\t// Descend: the declaration name is allowlisted by\n242|\t\t\t// position, but references nested in the funnel body\n243|\t\t\t// still audit.\n244|\t\t\treturn true\n245|\t\t}\n246|\t\tident, ok := node.(*ast.Ident)\n247|\t\tif !ok || allowed[ident.Pos()] {\n248|\t\t\treturn true\n249|\t\t}\n250|\t\tif spec.Local[ident.Name] {\n251|\t\t\tif _, declared := imports.names[ident.Name]; declared {\n252|\t\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" shadowed by an import or declaration the audit cannot classify; rename it or widen the audit\")\n253|\t\t\t\treturn true\n254|\t\t\t}\n255|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, ident.Pos())+\": constructor \"+strconv.Quote(ident.Name)+\" referenced outside direct-call position; an aliased refusal cannot be inventoried, call it directly\")\n256|\t\t\treturn true\n257|\t\t}\n258|\t\treturn true\n259|\t})\n260|\tast.Inspect(syntax, func(node ast.Node) bool {\n261|\t\tselector, ok := node.(*ast.SelectorExpr)\n262|\t\tif !ok || allowed[selector.Sel.Pos()] {\n263|\t\t\treturn true\n264|\t\t}\n265|\t\treceiver, ok := selector.X.(*ast.Ident)\n266|\t\tif !ok {\n267|\t\t\treturn true\n268|\t\t}\n269|\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n270|\t\t\tfailures = append(failures, display+\":\"+positionOf(fileSet, selector.Sel.Pos())+\": constructor \"+strconv.Quote(receiver.Name+\".\"+selector.Sel.Name)+\" referenced outside direct-call position; an aliased construction cannot be inventoried, call it directly\")\n271|\t\t}\n272|\t\treturn true\n273|\t})\n274|\tsort.Strings(failures)\n275|\treturn failures\n276|}\n277|\n278|// FunPosition reports the audited position of a call's function: the\n279|// identifier for bare calls, the selector member for qualified calls.\n280|// WatchedCallPositions keys on exactly these positions.\n281|func FunPosition(call *ast.CallExpr) (token.Pos, bool) {\n282|\tswitch fun := call.Fun.(type) {\n283|\tcase *ast.Ident:\n284|\t\treturn fun.Pos(), true\n285|\tcase *ast.SelectorExpr:\n286|\t\treturn fun.Sel.Pos(), true\n287|\tdefault:\n288|\t\treturn token.NoPos, false\n289|\t}\n290|}\n291|\n292|// WatchedCallPositions returns the audited positions of every direct\n293|// call to a watched constructor in syntax: the attribution set. Callers\n294|// use it to attribute each watched construction to its enclosing\n295|// function (an allowlist scan), while AuditConstructorReferences owns\n296|// the alias direction over the same spec.\n297|func WatchedCallPositions(syntax *ast.File, spec ConstructorSpec) map[token.Pos]bool {\n298|\timports := resolveImports(syntax, spec)\n299|\tpositions := map[token.Pos]bool{}\n300|\tast.Inspect(syntax, func(node ast.Node) bool {\n301|\t\tdeclaration, ok := node.(*ast.FuncDecl)\n302|\t\tif ok && spec.Local[declaration.Name.Name] {\n303|\t\t\treturn true\n304|\t\t}\n305|\t\tcall, ok := node.(*ast.CallExpr)\n306|\t\tif !ok {\n307|\t\t\treturn true\n308|\t\t}\n309|\t\tif ident, ok := call.Fun.(*ast.Ident); ok && spec.Local[ident.Name] {\n310|\t\t\tpositions[ident.Pos()] = true\n311|\t\t\treturn true\n312|\t\t}\n313|\t\tif selector, ok := call.Fun.(*ast.SelectorExpr); ok {\n314|\t\t\tif receiver, ok := selector.X.(*ast.Ident); ok {\n315|\t\t\t\tif qualifiedWatches(spec, imports.pathOf(receiver.Name), selector.Sel.Name) {\n316|\t\t\t\t\tpositions[selector.Sel.Pos()] = true\n317|\t\t\t\t}\n318|\t\t\t}\n319|\t\t}\n320|\t\treturn true\n321|\t})\n322|\treturn positions\n323|}\n324|\n325|// importResolution maps the file's local import names to paths.\n326|type importResolution struct {\n327|\tnames map[string]string\n328|\tdot   map[string]bool\n329|}\n330|\n331|func (resolution importResolution) pathOf(local string) string {\n332|\treturn resolution.names[local]\n333|}\n334|\n335|// resolveImports reads the file's import specs into local-name to path\n336|// bindings. Explicit aliases, blank imports, and default base names all\n337|// resolve; only dot imports are unresolvable, and the caller fails them\n338|// closed.\n339|func resolveImports(syntax *ast.File, spec ConstructorSpec) importResolution {\n340|\tresolution := importResolution{names: map[string]string{}, dot: map[string]bool{}}\n341|\tfor _, declaration := range syntax.Decls {\n342|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n343|\t\tif !ok || general.Tok != token.IMPORT {\n344|\t\t\tcontinue\n345|\t\t}\n346|\t\tfor _, item := range general.Specs {\n347|\t\t\tloaded, ok := item.(*ast.ImportSpec)\n348|\t\t\tif !ok {\n349|\t\t\t\tcontinue\n350|\t\t\t}\n351|\t\t\tpath, err := strconv.Unquote(loaded.Path.Value)\n352|\t\t\tif err != nil {\n353|\t\t\t\tcontinue\n354|\t\t\t}\n355|\t\t\tif loaded.Name != nil && loaded.Name.Name == \".\" {\n356|\t\t\t\tresolution.dot[path] = true\n357|\t\t\t\tcontinue\n358|\t\t\t}\n359|\t\t\tlocal := importBaseName(path)\n360|\t\t\tif loaded.Name != nil {\n361|\t\t\t\tlocal = loaded.Name.Name\n362|\t\t\t}\n363|\t\t\tif local == \"_\" {\n364|\t\t\t\tcontinue\n365|\t\t\t}\n366|\t\t\tresolution.names[local] = path\n367|\t\t}\n368|\t}\n369|\treturn resolution\n370|}\n371|\n372|// importBaseName renders the default local name of an import path.\n373|func importBaseName(path string) string {\n374|\tif index := strings.LastIndex(path, \"/\"); index >= 0 {\n375|\t\treturn path[index+1:]\n376|\t}\n377|\treturn path\n378|}\n379|\n380|// constructorMembers joins watched member names for diagnostics.\n381|func constructorMembers(members map[string]bool) string {\n382|\tvar names []string\n383|\tfor name := range members {\n384|\t\tnames = append(names, name)\n385|\t}\n386|\tsort.Strings(names)\n387|\treturn strings.Join(names, \", \")\n388|}\n389|\n390|// positionOf renders line:column for diagnostics; never empty.\n391|func positionOf(fileSet *token.FileSet, position token.Pos) string {\n392|\tlocated := fileSet.Position(position)\n393|\tif !located.IsValid() {\n394|\t\treturn \"?:?\"\n395|\t}\n396|\treturn strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column)\n397|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cf","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":194,"recorded_at":1780531400000383,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad21c3a75f1bb00c109e964f9fe","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/invcore/must.go`.\n1|// Must wrappers and the runtime site recorder for Package invcore.\n2|//\n3|// The Must wrappers fail the suite on any returned failure: production\n4|// inventories call these, while negative tests and control plants call\n5|// the pure funcs in invcore.go directly and assert on the returned\n6|// failures. A gate that can only fatal cannot be planted against.\n7|\n8|package invcore\n9|\n10|import (\n11|\t\"fmt\"\n12|\t\"go/ast\"\n13|\t\"go/token\"\n14|\t\"path/filepath\"\n15|\t\"runtime\"\n16|\t\"sort\"\n17|\t\"strings\"\n18|\t\"sync\"\n19|\t\"testing\"\n20|)\n21|\n22|// MustScanProduction scans dir and fails the suite on any fail-closed\n23|// condition: zero files, unreadable files, unparseable files.\n24|func MustScanProduction(t *testing.T, dir string) ([]ProductionFile, *token.FileSet) {\n25|\tt.Helper()\n26|\tfiles, fileSet, failures := ScanProduction(dir)\n27|\tfor _, failure := range failures {\n28|\t\tt.Error(failure)\n29|\t}\n30|\tif len(failures) > 0 {\n31|\t\tt.FailNow()\n32|\t}\n33|\treturn files, fileSet\n34|}\n35|\n36|// MustCheckBothDirections fails the suite when the derived set and the\n37|// declared row set differ in either direction: unregistered derived sites\n38|// or orphaned rows. A zero derived set fails even when rows are empty.\n39|func MustCheckBothDirections(t *testing.T, what string, derived, rows map[string]struct{}) {\n40|\tt.Helper()\n41|\tunregistered, orphaned, failures := DiffSets(derived, rows)\n42|\tfor _, failure := range failures {\n43|\t\tt.Errorf(\"%s: %s\", what, failure)\n44|\t}\n45|\tfor _, key := range unregistered {\n46|\t\tt.Errorf(\"%s: unregistered site with no declaring row, so nothing witnesses it: %s\", what, key)\n47|\t}\n48|\tfor _, key := range orphaned {\n49|\t\tt.Errorf(\"%s: orphan row with no derived site; a row without a site is a witness without a guard: %s\", what, key)\n50|\t}\n51|}\n52|\n53|// MustAuditConstructorReferences fails the suite on any constructor\n54|// reference outside direct-call position, including import-aliased and\n55|// var-bound shapes, and on any shape the audit cannot classify.\n56|func MustAuditConstructorReferences(t *testing.T, syntax *ast.File, fileSet *token.FileSet, display string, spec ConstructorSpec) {\n57|\tt.Helper()\n58|\tfor _, failure := range AuditConstructorReferences(syntax, fileSet, display, spec) {\n59|\t\tt.Error(failure)\n60|\t}\n61|}\n62|\n63|// SiteRecorder is the runtime direction of the alias-bypass union\n64|// (provider/provhost shape): instrumented constructor vars record the\n65|// production file:line behind every exercised refusal plus the stable\n66|// codes those refusals carried. The audit requires the exercised site set\n67|// to equal the derived site set in both directions, and the observed code\n68|// set to equal the closed code set exactly, so a constructor call the\n69|// tests never exercise fails forward, and a truncated derivation fails in\n70|// reverse even though the forward check passes vacuously.\n71|type SiteRecorder struct {\n72|\tmu    sync.Mutex\n73|\tsites map[string]struct{}\n74|\tcodes map[string]struct{}\n75|}\n76|\n77|// NewSiteRecorder returns an empty recorder.\n78|func NewSiteRecorder() *SiteRecorder {\n79|\treturn &SiteRecorder{sites: map[string]struct{}{}, codes: map[string]struct{}{}}\n80|}\n81|\n82|// Record notes one exercised refusal carrying code, attributing it to\n83|// the production file:line at runtime.Caller(skip+1): skip counts every\n84|// frame between Record and the site, including Record's own caller. A\n85|// record helper called from the swapped constructor var passes skip=2\n86|// (helper frame plus wrapper frame), matching the historical sync.Map\n87|// recorders' runtime.Caller(2) exactly.\n88|func (recorder *SiteRecorder) Record(code string, skip int) {\n89|\trecorder.mu.Lock()\n90|\tdefer recorder.mu.Unlock()\n91|\trecorder.codes[code] = struct{}{}\n92|\tif _, file, line, ok := runtime.Caller(skip + 1); ok {\n93|\t\trecorder.sites[filepath.Base(file)+\":\"+fmt.Sprint(line)] = struct{}{}\n94|\t}\n95|}\n96|\n97|// Snapshot returns deep copies of the exercised site and code sets for\n98|// tests that record bystander sites and must remove them before\n99|// returning, keeping the reverse-direction audit exact.\n100|func (recorder *SiteRecorder) Snapshot() (sites map[string]struct{}, codes map[string]struct{}) {\n101|\trecorder.mu.Lock()\n102|\tdefer recorder.mu.Unlock()\n103|\tsites = make(map[string]struct{}, len(recorder.sites))\n104|\tfor site := range recorder.sites {\n105|\t\tsites[site] = struct{}{}\n106|\t}\n107|\tcodes = make(map[string]struct{}, len(recorder.codes))\n108|\tfor code := range recorder.codes {\n109|\t\tcodes[code] = struct{}{}\n110|\t}\n111|\treturn sites, codes\n112|}\n113|\n114|// Restore resets the recorder to a prior snapshot, dropping every site\n115|// and code recorded since.\n116|func (recorder *SiteRecorder) Restore(sites map[string]struct{}, codes map[string]struct{}) {\n117|\trecorder.mu.Lock()\n118|\tdefer recorder.mu.Unlock()\n119|\trecorder.sites = make(map[string]struct{}, len(sites))\n120|\tfor site := range sites {\n121|\t\trecorder.sites[site] = struct{}{}\n122|\t}\n123|\trecorder.codes = make(map[string]struct{}, len(codes))\n124|\tfor code := range codes {\n125|\t\trecorder.codes[code] = struct{}{}\n126|\t}\n127|}\n128|\n129|// Sites returns the exercised production file:line set.\n130|func (recorder *SiteRecorder) Sites() map[string]struct{} {\n131|\trecorder.mu.Lock()\n132|\tdefer recorder.mu.Unlock()\n133|\tduplicated := make(map[string]struct{}, len(recorder.sites))\n134|\tfor site := range recorder.sites {\n135|\t\tduplicated[site] = struct{}{}\n136|\t}\n137|\treturn duplicated\n138|}\n139|\n140|// Codes returns the observed stable code set.\n141|func (recorder *SiteRecorder) Codes() []string {\n142|\trecorder.mu.Lock()\n143|\tdefer recorder.mu.Unlock()\n144|\tvar codes []string\n145|\tfor code := range recorder.codes {\n146|\t\tcodes = append(codes, code)\n147|\t}\n148|\tsort.Strings(codes)\n149|\treturn codes\n150|}\n151|\n152|// AuditSites compares the exercised set against the derived site set in\n153|// both directions and the observed codes against the closed set, returning\n154|// one failure per violated direction. Empty scanned or derived input fails\n155|// closed: a blind scan is not a measurement.\n156|func (recorder *SiteRecorder) AuditSites(what string, scanned int, derived map[string]struct{}, wantCodes []string) []string {\n157|\tvar failures []string\n158|\tif scanned == 0 {\n159|\t\tfailures = append(failures, what+\": scanned no production sources; the check is blind\")\n160|\t}\n161|\tif len(derived) == 0 {\n162|\t\tfailures = append(failures, what+\": derived no refusal sites; the scan is blind\")\n163|\t}\n164|\texercised := recorder.Sites()\n165|\tvar outside []string\n166|\tfor site := range exercised {\n167|\t\tif _, ok := derived[site]; !ok {\n168|\t\t\toutside = append(outside, site)\n169|\t\t}\n170|\t}\n171|\tsort.Strings(outside)\n172|\tif len(outside) != 0 {\n173|\t\tfailures = append(failures, what+\": exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n174|\t}\n175|\tvar missing []string\n176|\tfor site := range derived {\n177|\t\tif _, ok := exercised[site]; !ok {\n178|\t\t\tmissing = append(missing, site)\n179|\t\t}\n180|\t}\n181|\tsort.Strings(missing)\n182|\tif len(missing) != 0 {\n183|\t\tfailures = append(failures, what+\": derived refusal sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n184|\t}\n185|\tcodes := recorder.Codes()\n186|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", wantCodes) {\n187|\t\tfailures = append(failures, fmt.Sprintf(\"%s: observed refusal codes = %v, want closed set %v\", what, codes, wantCodes))\n188|\t}\n189|\treturn failures\n190|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d1","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":195,"recorded_at":1780531400000385,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad21cba7b82b5b343c9df36f139","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|)\n13|\n14|// This file is the name layer of the shared-implementation\n15|// census. The story's premise is that the Provider, Session\n16|// Adapter, and Directory Node facades sit on one environment\n17|// library; each facade carried its own copy of the shared rules,\n18|// and independent copies of the same rule drift in ways no\n19|// per-facade reviewer can see. This census is the boundary that\n20|// fails when the facades diverge: it derives every shared-rule\n21|// implementation known by identifier from production source and\n22|// requires the derived set to equal the ledger below exactly.\n23|// The shape layer in shape_census_test.go derives implementations\n24|// by implementation texture and catches copies under fresh\n25|// spellings, new byte measures, and var-bound aliases that this\n26|// name layer cannot see; the two layers are complementary by\n27|// construction.\n28|//\n29|// Removing or renaming a ledgered implementation orphans its row\n30|// and fails too. An empty scan fails closed. The ledger records\n31|// the single canonical owner per rule (this package, or scalar\n32|// where the grammar already has one) plus the copies this leaf\n33|// does not unify; each copy names the battery file that pins it\n34|// to the canonical semantics. The sessadapter and dirnode frame\n35|// decoders are delegating wrappers onto environ.DecodeStrictObject\n36|// (their raw-scan divergence, once ledgered here, was closed by\n37|// delegation and is proven in both directions by the\n38|// frame-agreement battery); the remaining provhost, canonicaljson,\n39|// and scalar copies are unification residue tracked in the\n40|// cross-story follow-up, not harmless divergence.\n41|//\n42|// Scope. The scan covers the story packages (environ, provider,\n43|// provhost, sessadapter, dirnode) plus the grammar owners\n44|// (scalar, canonicaljson). Copies in config, cliresult,\n45|// terminalbackend, axerror, and the other stories' packages are\n46|// outside this story's ownership: each package derives its own\n47|// inventories in its own test files, and gating another story's\n48|// package from here would couple stories that must land\n49|// independently. That exclusion is a stated bound, not a blind\n50|// spot: the scan fails closed inside its scope, and a copy that\n51|// moves into scope (a new definition in a scanned package)\n52|// fails as unregistered.\n53|\n54|// sharedSite is one derived shared-rule implementation.\n55|type sharedSite struct {\n56|\tclass  string\n57|\tpkg    string\n58|\tfile   string\n59|\tsymbol string\n60|}\n61|\n62|// sharedSiteKey renders the ledger key for one site.\n63|func (site sharedSite) sharedSiteKey() string {\n64|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n65|}\n66|\n67|// censusPackages is the exact scan scope. A production file in\n68|// any other package is outside this story's jurisdiction.\n69|var censusPackages = map[string]bool{\n70|\t\"environ\":       true,\n71|\t\"provider\":      true,\n72|\t\"provhost\":      true,\n73|\t\"sessadapter\":   true,\n74|\t\"dirnode\":       true,\n75|\t\"scalar\":        true,\n76|\t\"canonicaljson\": true,\n77|}\n78|\n79|// sharedLedger maps every known shared-rule implementation to\n80|// the rationale that keeps it honest. Canonical owners are the\n81|// single implementation new code must use; every other row names\n82|// the battery file that pins the copy to the canonical\n83|// semantics.\n84|var sharedLedger = map[string]string{\n85|\t// Frame decoders: one JSON entry point per package.\n86|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":     \"canonical owner: string-walk surrogate semantics, rune measure\",\n87|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\":  \"pinned by frame_agreement_test.go\",\n88|\t\"strict-decoder|sessadapter|decode.go|decodeStrictObject\": \"delegating wrapper onto environ.DecodeStrictObject, pinned by TestDelegatingWrappersCallEnviron + frame_agreement_test.go\",\n89|\t\"strict-decoder|dirnode|decode.go|decodeStrictObject\":     \"delegating wrapper onto environ.DecodeStrictObject, pinned by TestDelegatingWrappersCallEnviron + frame_agreement_test.go\",\n90|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\":  \"canonicalizer entry: distinct JCS pipeline role, surrogate verdicts pinned by frame_agreement_test.go\",\n91|\t// Lone-surrogate gates.\n92|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n93|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n94|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n95|\t// String measures.\n96|\t\"string-measure|environ|decode.go|StringLength\":     \"canonical owner: runes per Section 1.6\",\n97|\t\"string-measure|provhost|opdecode.go|runeLength\":    \"runes, pinned by measure_agreement_test.go\",\n98|\t\"string-measure|sessadapter|decode.go|stringLength\": \"byte-frozen leaf 1: runes, pinned by measure_agreement_test.go\",\n99|\t\"string-measure|dirnode|decode.go|stringLength\":     \"byte-frozen leaf 2: runes, pinned by measure_agreement_test.go\",\n100|\t// Identity validators: two refusal dialects over one rule.\n101|\t\"identity-validator|provhost|identity.go|CheckIdentity\":                           \"provider-stdio refusal dialect, pinned by identity_agreement_test.go\",\n102|\t\"identity-validator|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"identity refusal dialect, pinned by identity_agreement_test.go\",\n103|}\n104|\n105|// sharedFunctionSymbols maps a function name to its census\n106|// class.\n107|var sharedFunctionSymbols = map[string]string{\n108|\t\"decodeStrictObject\":             \"strict-decoder\",\n109|\t\"DecodeStrictObject\":             \"strict-decoder\",\n110|\t\"decodeStrict\":                   \"strict-decoder\",\n111|\t\"hasLoneSurrogateEscape\":         \"surrogate-gate\",\n112|\t\"HasLoneSurrogateEscape\":         \"surrogate-gate\",\n113|\t\"validateSurrogateEscapes\":       \"surrogate-gate\",\n114|\t\"stringLength\":                   \"string-measure\",\n115|\t\"runeLength\":                     \"string-measure\",\n116|\t\"StringLength\":                   \"string-measure\",\n117|\t\"CheckIdentity\":                  \"identity-validator\",\n118|\t\"validateProviderIdentityRecord\": \"identity-validator\",\n119|}\n120|\n121|// grammarSymbols maps a package-level variable name to its\n122|// grammar class. Only same-rule grammars share a class: the\n123|// three capabilityOrder tables (directory eight, adapter\n124|// fifteen, provider seven) and the per-major platform tables are\n125|// deliberately absent here and are pinned by literal-list\n126|// derivation in grammar_test.go instead, where the rule identity\n127|// travels with the comparison.\n128|var grammarSymbols = map[string]string{\n129|\t\"environmentIDPattern\": \"env-id-grammar\",\n130|\t\"semverPattern\":        \"semver-grammar\",\n131|\t\"reverseDNSPattern\":    \"extensions-grammar\",\n132|\t\"providerIDPattern\":    \"provider-id-grammar\",\n133|}\n134|\n135|// deriveSharedSites scans every production Go file in the census\n136|// packages for shared-rule implementations. Test files are never\n137|// scanned: a helper in a test is not a production copy. An\n138|// unreadable file or a parse failure fails closed: a scanner that\n139|// cannot read a file must not report the file as clean.\n140|func deriveSharedSites(t *testing.T) map[string]bool {\n141|\tt.Helper()\n142|\tsites := map[string]bool{}\n143|\tfor _, site := range scanSharedSymbols(t, sharedFunctionSymbols, true) {\n144|\t\tsites[site] = true\n145|\t}\n146|\tif len(sites) == 0 {\n147|\t\tt.Fatal(\"census derived zero shared-rule sites from a tree known to duplicate them; the scanner is blind, not the tree clean\")\n148|\t}\n149|\treturn sites\n150|}\n151|\n152|// scanSharedSymbols scans the census packages for function or\n153|// package-level variable definitions whose names appear in the\n154|// symbol map, and returns ledger keys for each hit.\n155|func scanSharedSymbols(t *testing.T, symbols map[string]string, functions bool) []string {\n156|\tt.Helper()\n157|\troot, err := internalRoot(t)\n158|\tif err != nil {\n159|\t\tt.Fatalf(\"census: %v\", err)\n160|\t}\n161|\tvar keys []string\n162|\tcount := 0\n163|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n164|\t\tif err != nil {\n165|\t\t\treturn err\n166|\t\t}\n167|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n168|\t\t\treturn nil\n169|\t\t}\n170|\t\trel, err := filepath.Rel(root, path)\n171|\t\tif err != nil {\n172|\t\t\treturn err\n173|\t\t}\n174|\t\tparts := strings.Split(rel, string(filepath.Separator))\n175|\t\tpkg := parts[0]\n176|\t\tif !censusPackages[pkg] {\n177|\t\t\treturn nil\n178|\t\t}\n179|\t\tcount++\n180|\t\tsource, err := os.ReadFile(path)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"census: read %s: %v\", path, err)\n183|\t\t}\n184|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"census: parse %s: %v\", path, err)\n187|\t\t}\n188|\t\tfile := parts[len(parts)-1]\n189|\t\tfor _, decl := range syntax.Decls {\n190|\t\t\tswitch node := decl.(type) {\n191|\t\t\tcase *ast.FuncDecl:\n192|\t\t\t\tif !functions || node.Name == nil {\n193|\t\t\t\t\tcontinue\n194|\t\t\t\t}\n195|\t\t\t\tif class, ok := symbols[node.Name.Name]; ok {\n196|\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, node.Name.Name}.sharedSiteKey())\n197|\t\t\t\t}\n198|\t\t\tcase *ast.GenDecl:\n199|\t\t\t\tif functions {\n200|\t\t\t\t\tcontinue\n201|\t\t\t\t}\n202|\t\t\t\tfor _, spec := range node.Specs {\n203|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n204|\t\t\t\t\tif !ok {\n205|\t\t\t\t\t\tcontinue\n206|\t\t\t\t\t}\n207|\t\t\t\t\tfor _, name := range value.Names {\n208|\t\t\t\t\t\tif class, ok := symbols[name.Name]; ok {\n209|\t\t\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, name.Name}.sharedSiteKey())\n210|\t\t\t\t\t\t}\n211|\t\t\t\t\t}\n212|\t\t\t\t}\n213|\t\t\t}\n214|\t\t}\n215|\t\treturn nil\n216|\t})\n217|\tif err != nil {\n218|\t\tt.Fatalf(\"census: walk: %v\", err)\n219|\t}\n220|\tif count == 0 {\n221|\t\tt.Fatal(\"census scanned zero files; the scanner is broken, not the tree\")\n222|\t}\n223|\treturn keys\n224|}\n225|\n226|// internalRoot returns the internal/ source root above this\n227|// package directory.\n228|func internalRoot(t *testing.T) (string, error) {\n229|\tt.Helper()\n230|\tdirectory, err := os.Getwd()\n231|\tif err != nil {\n232|\t\treturn \"\", err\n233|\t}\n234|\treturn filepath.Dir(directory), nil\n235|}\n236|\n237|// TestSharedImplementationsAreCensused requires the derived\n238|// implementation set to equal the ledger exactly: an unregistered\n239|// copy fails as a unification violation, and a row naming an\n240|// implementation production no longer derives fails as orphaned.\n241|func TestSharedImplementationsAreCensused(t *testing.T) {\n242|\tderived := deriveSharedSites(t)\n243|\tfor key := range derived {\n244|\t\tif _, ok := sharedLedger[key]; !ok {\n245|\t\t\tt.Errorf(\"unregistered shared-rule copy %q: add one canonical implementation in internal/environ instead, or ledger the divergence with its agreement battery\", key)\n246|\t\t}\n247|\t}\n248|\tfor key, rationale := range sharedLedger {\n249|\t\tif !derived[key] {\n250|\t\t\tt.Errorf(\"orphaned ledger row %q (%s): production no longer derives it\", key, rationale)\n251|\t\t}\n252|\t}\n253|}\n254|\n255|// grammarSiteLedger names every grammar definition site in the\n256|// census scope. A new grammar definition fails here even when it\n257|// carries an identical literal: a second copy is a second copy,\n258|// and the next edit drifts exactly one of them.\n259|var grammarSiteLedger = map[string]bool{\n260|\t\"env-id-grammar|environ|tuple.go|environmentIDPattern\":                true,\n261|\t\"env-id-grammar|sessadapter|decode.go|environmentIDPattern\":           true,\n262|\t\"env-id-grammar|dirnode|decode.go|environmentIDPattern\":               true,\n263|\t\"env-id-grammar|canonicaljson|closed_shapes.go|environmentIDPattern\":  true,\n264|\t\"semver-grammar|environ|tuple.go|semverPattern\":                       true,\n265|\t\"semver-grammar|sessadapter|decode.go|semverPattern\":                  true,\n266|\t\"semver-grammar|dirnode|decode.go|semverPattern\":                      true,\n267|\t\"semver-grammar|canonicaljson|closed_shapes.go|semverPattern\":         true,\n268|\t\"semver-grammar|provhost|manifest.go|semverPattern\":                   true,\n269|\t\"extensions-grammar|environ|decode.go|reverseDNSPattern\":              true,\n270|\t\"extensions-grammar|sessadapter|decode.go|reverseDNSPattern\":          true,\n271|\t\"extensions-grammar|dirnode|decode.go|reverseDNSPattern\":              true,\n272|\t\"extensions-grammar|canonicaljson|closed_shapes.go|reverseDNSPattern\": true,\n273|\t\"provider-id-grammar|scalar|names.go|providerIDPattern\":               true,\n274|\t\"provider-id-grammar|provhost|manifest.go|providerIDPattern\":          true,\n275|\t\"provider-id-grammar|sessadapter|decode.go|providerIDPattern\":         true,\n276|\t\"provider-id-grammar|dirnode|query.go|providerIDPattern\":              true,\n277|}\n278|\n279|// grammarCandidate is one package-level single MustCompile\n280|// definition: the defined symbol and its pattern literal.\n281|type grammarCandidate struct {\n282|\tsymbol  string\n283|\tliteral string\n284|}\n285|\n286|// grammarCandidatesInFile extracts every package-level single\n287|// MustCompile definition from one source file. It is pure over\n288|// its inputs, so the synthetic controls drive this exact\n289|// function on planted sources.\n290|func grammarCandidatesInFile(path string, source []byte) ([]grammarCandidate, error) {\n291|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n292|\tif err != nil {\n293|\t\treturn nil, err\n294|\t}\n295|\tvar candidates []grammarCandidate\n296|\tfor _, decl := range syntax.Decls {\n297|\t\tnode, ok := decl.(*ast.GenDecl)\n298|\t\tif !ok {\n299|\t\t\tcontinue\n300|\t\t}\n301|\t\tfor _, spec := range node.Specs {\n302|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n303|\t\t\tif !ok || len(value.Names) != 1 || len(value.Values) != 1 {\n304|\t\t\t\tcontinue\n305|\t\t\t}\n306|\t\t\tcall, ok := value.Values[0].(*ast.CallExpr)\n307|\t\t\tif !ok || len(call.Args) != 1 {\n308|\t\t\t\tcontinue\n309|\t\t\t}\n310|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n311|\t\t\tif !ok || selector.Sel.Name != \"MustCompile\" {\n312|\t\t\t\tcontinue\n313|\t\t\t}\n314|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n315|\t\t\tif !ok {\n316|\t\t\t\tcontinue\n317|\t\t\t}\n318|\t\t\ttext, err := strconv.Unquote(literal.Value)\n319|\t\t\tif err != nil {\n320|\t\t\t\tcontinue\n321|\t\t\t}\n322|\t\t\tcandidates = append(candidates, grammarCandidate{symbol: value.Names[0].Name, literal: text})\n323|\t\t}\n324|\t}\n325|\treturn candidates, nil\n326|}\n327|\n328|// deriveGrammarLiterals derives the regex literal behind every\n329|// grammar definition in the census scope, keyed by ledger key.\n330|// Two definitions carrying different literals are different\n331|// languages even when the symbol name matches; the grammar\n332|// battery requires one literal per class. Definitions under a\n333|// fresh name carrying a known class literal derive as fresh\n334|// copies of that class: a second copy is a second copy even\n335|// when the symbol is new.\n336|func deriveGrammarLiterals(t *testing.T) (map[string]map[string]bool, map[string]bool, map[string]bool) {\n337|\tt.Helper()\n338|\troot, err := internalRoot(t)\n339|\tif err != nil {\n340|\t\tt.Fatalf(\"grammar: %v\", err)\n341|\t}\n342|\tliterals := map[string]map[string]bool{}\n343|\tsites := map[string]bool{}\n344|\ttype collectedCandidate struct {\n345|\t\tpkg       string\n346|\t\tfile      string\n347|\t\tcandidate grammarCandidate\n348|\t}\n349|\tvar collected []collectedCandidate\n350|\terr = filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n351|\t\tif err != nil {\n352|\t\t\treturn err\n353|\t\t}\n354|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n355|\t\t\treturn nil\n356|\t\t}\n357|\t\trel, err := filepath.Rel(root, path)\n358|\t\tif err != nil {\n359|\t\t\treturn err\n360|\t\t}\n361|\t\tparts := strings.Split(rel, string(filepath.Separator))\n362|\t\tpkg := parts[0]\n363|\t\tif !censusPackages[pkg] {\n364|\t\t\treturn nil\n365|\t\t}\n366|\t\tsource, err := os.ReadFile(path)\n367|\t\tif err != nil {\n368|\t\t\tt.Fatalf(\"grammar: read %s: %v\", path, err)\n369|\t\t}\n370|\t\tcandidates, err := grammarCandidatesInFile(path, source)\n371|\t\tif err != nil {\n372|\t\t\tt.Fatalf(\"grammar: parse %s: %v\", path, err)\n373|\t\t}\n374|\t\tfor _, candidate := range candidates {\n375|\t\t\tcollected = append(collected, collectedCandidate{pkg: pkg, file: parts[len(parts)-1], candidate: candidate})\n376|\t\t}\n377|\t\treturn nil\n378|\t})\n379|\tif err != nil {\n380|\t\tt.Fatalf(\"grammar: walk: %v\", err)\n381|\t}\n382|\tfor _, entry := range collected {\n383|\t\tclass, known := grammarSymbols[entry.candidate.symbol]\n384|\t\tif !known {\n385|\t\t\tcontinue\n386|\t\t}\n387|\t\tif literals[class] == nil {\n388|\t\t\tliterals[class] = map[string]bool{}\n389|\t\t}\n390|\t\tliterals[class][entry.candidate.literal] = true\n391|\t\tsites[sharedSite{class, entry.pkg, entry.file, entry.candidate.symbol}.sharedSiteKey()] = true\n392|\t}\n393|\tknownLiterals := grammarKnownLiterals(literals)\n394|\tfresh := map[string]bool{}\n395|\tfor _, entry := range collected {\n396|\t\tif class, copy := classifyGrammarCandidate(entry.candidate, knownLiterals); copy {\n397|\t\t\tfresh[sharedSite{class, entry.pkg, entry.file, entry.candidate.symbol}.sharedSiteKey()] = true\n398|\t\t}\n399|\t}\n400|\treturn literals, sites, fresh\n401|}\n402|\n403|// grammarKnownLiterals inverts the derived class literals into a\n404|// literal-to-class map. It is pure over the derivation, so the\n405|// synthetic controls classify against the same map production\n406|// uses.\n407|func grammarKnownLiterals(literals map[string]map[string]bool) map[string]string {\n408|\tknown := map[string]string{}\n409|\tfor class, texts := range literals {\n410|\t\tfor text := range texts {\n411|\t\t\tknown[text] = class\n412|\t\t}\n413|\t}\n414|\treturn known\n415|}\n416|\n417|// classifyGrammarCandidate reports whether a MustCompile\n418|// definition is a fresh-name copy of a known class: a symbol\n419|// outside grammarSymbols carrying a known class literal. Named\n420|// definitions and unknown literals are not copies.\n421|func classifyGrammarCandidate(candidate grammarCandidate, known map[string]string) (string, bool) {\n422|\tif _, named := grammarSymbols[candidate.symbol]; named {\n423|\t\treturn \"\", false\n424|\t}\n425|\tclass, match := known[candidate.literal]\n426|\tif !match {\n427|\t\treturn \"\", false\n428|\t}\n429|\treturn class, true\n430|}\n431|\n432|// TestSharedGrammarsAreOneLanguage requires every grammar in the\n433|// census scope to carry the identical regex literal: same symbol\n434|// with different literals would be two languages under one name,\n435|// and a mutant rewriting one copy's literal reddens here.\n436|func TestSharedGrammarsAreOneLanguage(t *testing.T) {\n437|\tliterals, sites, fresh := deriveGrammarLiterals(t)\n438|\tfor key := range sites {\n439|\t\tif !grammarSiteLedger[key] {\n440|\t\t\tt.Errorf(\"unregistered grammar copy %q: one language means one definition site per package at most\", key)\n441|\t\t}\n442|\t}\n443|\tfor key := range fresh {\n444|\t\tt.Errorf(\"unregistered grammar copy under a fresh name %q: a second copy is a second copy even when the symbol is new\", key)\n445|\t}\n446|\tfor key := range grammarSiteLedger {\n447|\t\tif !sites[key] {\n448|\t\t\tt.Errorf(\"orphaned grammar row %q: production no longer derives it\", key)\n449|\t\t}\n450|\t}\n451|\tfor class, texts := range literals {\n452|\t\tif len(texts) != 1 {\n453|\t\t\tvar variants []string\n454|\t\t\tfor text := range texts {\n455|\t\t\t\tvariants = append(variants, strconv.Quote(text))\n456|\t\t\t}\n457|\t\t\tt.Errorf(\"grammar class %q has %d distinct literals: %s\", class, len(texts), strings.Join(variants, \" vs \"))\n458|\t\t}\n459|\t}\n460|\tif len(literals) != len(grammarSymbols) {\n461|\t\tt.Fatalf(\"grammar: derived %d classes, want %d; the extractor is blind, not the tree clean\", len(literals), len(grammarSymbols))\n462|\t}\n463|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
