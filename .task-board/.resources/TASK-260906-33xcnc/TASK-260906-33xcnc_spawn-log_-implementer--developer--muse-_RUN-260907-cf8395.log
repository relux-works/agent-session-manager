{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df39","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":3575,"recorded_at":1780531400007145,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"8beccd44-3e8d-4b6a-b752-aa4dfb40bb35"},"task_id":"8beccd44-3e8d-4b6a-b752-aa4dfb40bb35","event":{"kind":"output","task_id":"8beccd44-3e8d-4b6a-b752-aa4dfb40bb35","chunk":"edited\nchanged lines: lines 335-363\n--- original\n+++ updated\n@@\n-def apply_mutant(mut):\n-    backups = {}\n-    for path in mut[\"files\"]:\n-        full = ROOT + \"/\" + path\n-        with open(full) as handle:\n-            backups[path] = handle.read()\n-    for path, old, new in mut[\"steps\"]:\n-        full = ROOT + \"/\" + path\n-        if path not in mut[\"files\"]:\n-            with open(full) as handle:\n-                backups.setdefault(path, handle.read())\n-        with open(full) as handle:\n-            src = handle.read()\n-        if src.count(old) != 1:\n-            return backups, \"NOT_APPLIED\"\n-    for path, text in mut[\"appends\"]:\n-        full = ROOT + \"/\" + path\n-        if path not in mut[\"files\"]:\n-            with open(full) as handle:\n-                backups.setdefault(path, handle.read())\n-        with open(full, \"a\") as handle:\n-            handle.write(text)\n-    for path, old, new in mut[\"steps\"]:\n-        full = ROOT + \"/\" + path\n-        with open(full) as handle:\n-            src = handle.read()\n-        with open(full, \"w\") as handle:\n-            handle.write(src.replace(old, new))\n-    return backups, None\n+def apply_mutant(mut):\n+    # Steps are (old, new) pairs applied to the mutant's first file;\n+    # appends are (path, text) pairs. Every touched file is backed\n+    # up before any write, and a non-unique pattern aborts with\n+    # NOT_APPLIED before anything is written.\n+    backups = {}\n+    for path in mut[\"files\"]:\n+        full = ROOT + \"/\" + path\n+        with open(full) as handle:\n+            backups[path] = handle.read()\n+    for path, _ in mut[\"appends\"]:\n+        if path not in backups:\n+            with open(ROOT + \"/\" + path) as handle:\n+                backups[path] = handle.read()\n+    target = ROOT + \"/\" + mut[\"files\"][0]\n+    with open(target) as handle:\n+        src = handle.read()\n+    for old, _ in mut[\"steps\"]:\n+        if src.count(old) != 1:\n+            return backups, \"NOT_APPLIED\"\n+    for path, text in mut[\"appends\"]:\n+        with open(ROOT + \"/\" + path, \"a\") as handle:\n+            handle.write(text)\n+    with open(target) as handle:\n+        src = handle.read()\n+    for old, new in mut[\"steps\"]:\n+        src = src.replace(old, new)\n+    with open(target, \"w\") as handle:\n+        handle.write(src)\n+    return backups, None\n"}}}
