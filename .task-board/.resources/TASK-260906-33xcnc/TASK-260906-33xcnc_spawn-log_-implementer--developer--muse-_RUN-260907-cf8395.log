{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6a1","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":2475,"recorded_at":1780531400004945,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"73f1e632-0771-4467-ab5e-4a7ccab67731"},"task_id":"73f1e632-0771-4467-ab5e-4a7ccab67731","event":{"kind":"output","task_id":"73f1e632-0771-4467-ab5e-4a7ccab67731","chunk":"edited\nchanged lines: lines 166-200\n--- original\n+++ updated\n@@\n-func scanBoundSiteIDs(t *testing.T, directory string) []string {\n-\tt.Helper()\n-\tentries, err := os.ReadDir(directory)\n-\tif err != nil {\n-\t\tt.Fatalf(\"bound census: %v\", err)\n-\t}\n-\tvar ids []string\n-\tscanned := 0\n-\tfor _, entry := range entries {\n-\t\tname := entry.Name()\n-\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n-\t\t\tcontinue\n-\t\t}\n-\t\tscanned++\n-\t\tpath := filepath.Join(directory, name)\n-\t\tsource, err := os.ReadFile(path)\n-\t\tif err != nil {\n-\t\t\tt.Fatalf(\"bound census: %v\", err)\n-\t\t}\n-\t\tfileSet := token.NewFileSet()\n-\t\tsyntax, err := parser.ParseFile(fileSet, path, source, 0)\n-\t\tif err != nil {\n-\t\t\tt.Fatalf(\"bound census: %v\", err)\n-\t\t}\n-\t\tsites, violations := boundSitesInSyntax(syntax, name)\n-\t\tfor _, violation := range violations {\n-\t\t\tt.Errorf(\"bound census: %s: %s\", name, violation)\n-\t\t}\n-\t\tids = append(ids, sites...)\n-\t}\n-\tif scanned == 0 {\n-\t\tt.Fatal(\"bound census scanned zero production files; the scanner is broken, not the package\")\n-\t}\n-\treturn ids\n-}\n+func scanBoundSiteIDs(t *testing.T, directory string) []string {\n+\tt.Helper()\n+\t//