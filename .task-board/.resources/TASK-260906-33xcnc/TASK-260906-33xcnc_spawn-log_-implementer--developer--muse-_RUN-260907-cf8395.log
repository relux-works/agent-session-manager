{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c599","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":295,"recorded_at":1780531400000585,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"c2e72b34-fba8-4d00-95f5-a959bdd1ff13"},"task_id":"c2e72b34-fba8-4d00-95f5-a959bdd1ff13","event":{"kind":"output","task_id":"c2e72b34-fba8-4d00-95f5-a959bdd1ff13","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/canonicaljson/canonical.go`.\n1|// Package canonicaljson implements the RFC 8785 JSON Canonicalization Scheme\n2|// and the AX omit-self-field identity boundary for immutable logical objects.\n3|package canonicaljson\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"io\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/gowebpki/jcs\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|)\n19|\n20|const maxSafeInteger int64 = 9007199254740991\n21|\n22|// maxNestingDepth bounds how many JSON containers (objects or arrays) may be\n23|// open at once in any document that reaches decodeValue, which is the shared\n24|// strict decode path behind Canonicalize, CalculateObjectIdentity, and\n25|// VerifyObjectIdentity. Without it, one recursion frame per nesting level lets\n26|// an untrusted peer object exhaust the goroutine stack, and Go reports that as\n27|// a fatal runtime error that recover cannot intercept.\n28|//\n29|// Rationale for 256: the deepest normative closed shape is the Transfer\n30|// Manifest submodule tree at its 16-level maximum, which nests roughly 40\n31|// containers including the identity envelope, and open extensions are bounded\n32|// at 4 levels, so 256 leaves more than sixfold headroom over any accepted AX\n33|// object. It is also far below encoding/json's 10,000-level Unmarshal cap and\n34|// the unbounded recursion inside the JCS re-parse, so this typed refusal is\n35|// always the first gate a deep document meets, and the decode stack stays at\n36|// a few hundred small frames regardless of input size.\n37|const maxNestingDepth = 256\n38|\n39|var (\n40|\t// ErrInvalidJSON reports input outside the RFC 8785 I-JSON surface.\n41|\tErrInvalidJSON = errors.New(\"invalid canonical JSON input\")\n42|\t// ErrInvalidIdentity reports input outside the AX omit-self identity contract.\n43|\tErrInvalidIdentity = errors.New(\"invalid canonical object identity\")\n44|)\n45|\n46|// SelfField is one of the pinned AX immutable-object self-identity namespaces.\n47|// Chunk IDs are intentionally absent: Section 10.3 defines chunk_id as a\n48|// digest of raw bytes, not of a JSON object.\n49|type SelfField string\n50|\n51|const (\n52|\tSelfRecordID                   SelfField = \"record_id\"\n53|\tSelfEventID                    SelfField = \"event_id\"\n54|\tSelfCheckpointID               SelfField = \"checkpoint_id\"\n55|\tSelfDescriptorID               SelfField = \"descriptor_id\"\n56|\tSelfManifestID                 SelfField = \"manifest_id\"\n57|\tSelfPlanID                     SelfField = \"plan_id\"\n58|\tSelfTombstoneID                SelfField = \"tombstone_id\"\n59|\tSelfAckID                      SelfField = \"ack_id\"\n60|\tSelfBundleID                   SelfField = \"bundle_id\"\n61|\tSelfMarkerID                   SelfField = \"marker_id\"\n62|\tSelfObservationID              SelfField = \"observation_id\"\n63|\tSelfBatchID                    SelfField = \"batch_id\"\n64|\tSelfLineageLinkID              SelfField = \"lineage_link_id\"\n65|\tSelfAnnotationID               SelfField = \"annotation_id\"\n66|\tSelfProfileID                  SelfField = \"profile_id\"\n67|\tSelfJobRequestID               SelfField = \"job_request_id\"\n68|\tSelfJobReceiptID               SelfField = \"job_receipt_id\"\n69|\tSelfDirectoryReceiptID         SelfField = \"directory_receipt_id\"\n70|\tSelfProbeID                    SelfField = \"probe_id\"\n71|\tSelfBindingID                  SelfField = \"binding_id\"\n72|\tSelfEvidenceID                 SelfField = \"evidence_id\"\n73|\tSelfRawObjectManifestID        SelfField = \"raw_object_manifest_id\"\n74|\tSelfCaptureManifestID          SelfField = \"capture_manifest_id\"\n75|\tSelfCanonicalSessionID         SelfField = \"canonical_session_id\"\n76|\tSelfFidelityReportID           SelfField = \"fidelity_report_id\"\n77|\tSelfProjectionPlanID           SelfField = \"projection_plan_id\"\n78|\tSelfProjectedObjectManifestID  SelfField = \"projected_object_manifest_id\"\n79|\tSelfReadBackEvidenceManifestID SelfField = \"read_back_evidence_manifest_id\"\n80|\tSelfValidationReportID         SelfField = \"validation_report_id\"\n81|\tSelfMigrationCheckpointID      SelfField = \"migration_checkpoint_id\"\n82|\tSelfLineageReceiptID           SelfField = \"lineage_receipt_id\"\n83|\tSelfRegistryDigest             SelfField = \"registry_digest\"\n84|)\n85|\n86|type schemaIdentityKey struct {\n87|\tschema  string\n88|\tversion string\n89|}\n90|\n91|type schemaIdentityContract struct {\n92|\tselfField          SelfField\n93|\tdiscriminatorName  string\n94|\tdiscriminatorValue string\n95|}\n96|\n97|// schemaIdentityContracts is derived from the generated catalog whose source\n98|// is bound to the pinned v0.5.0 document. A schema may legitimately carry a\n99|// differently named ID as a reference, so field-name counting is not an\n100|// identity contract.\n101|var schemaIdentityContracts = mustBuildSchemaIdentityContracts(catalog.Current().SelfIdentities)\n102|\n103|func mustBuildSchemaIdentityContracts(definitions []catalog.SelfIdentityContract) map[schemaIdentityKey]schemaIdentityContract {\n104|\tcontracts, err := buildSchemaIdentityContracts(definitions)\n105|\tif err != nil {\n106|\t\tpanic(fmt.Sprintf(\"generated self-identity catalog is invalid: %v\", err))\n107|\t}\n108|\treturn contracts\n109|}\n110|\n111|func buildSchemaIdentityContracts(definitions []catalog.SelfIdentityContract) (map[schemaIdentityKey]schemaIdentityContract, error) {\n112|\tcontracts := make(map[schemaIdentityKey]schemaIdentityContract)\n113|\tfor _, definition := range definitions {\n114|\t\tcontract := schemaIdentityContract{\n115|\t\t\tselfField:          SelfField(definition.SelfField),\n116|\t\t\tdiscriminatorName:  definition.DiscriminatorName,\n117|\t\t\tdiscriminatorValue: definition.DiscriminatorValue,\n118|\t\t}\n119|\t\tfor _, version := range definition.ContractVersions {\n120|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n121|\t\t\tif _, duplicate := contracts[key]; duplicate {\n122|\t\t\t\treturn nil, fmt.Errorf(\"duplicate self-identity contract for %s@%s\", key.schema, key.version)\n123|\t\t\t}\n124|\t\t\tcontracts[key] = contract\n125|\t\t}\n126|\t}\n127|\tif err := validateSchemaIdentityContracts(contracts, definitions); err != nil {\n128|\t\treturn nil, err\n129|\t}\n130|\treturn contracts, nil\n131|}\n132|\n133|func validateSchemaIdentityContracts(contracts map[schemaIdentityKey]schemaIdentityContract, definitions []catalog.SelfIdentityContract) error {\n134|\texpected := 0\n135|\tfor _, definition := range definitions {\n136|\t\tfor _, version := range definition.ContractVersions {\n137|\t\t\texpected++\n138|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n139|\t\t\tcontract, ok := contracts[key]\n140|\t\t\tif !ok {\n141|\t\t\t\treturn fmt.Errorf(\"missing self-identity contract for %s@%s\", key.schema, key.version)\n142|\t\t\t}\n143|\t\t\tif contract.selfField != SelfField(definition.SelfField) ||\n144|\t\t\t\tcontract.discriminatorName != definition.DiscriminatorName ||\n145|\t\t\t\tcontract.discriminatorValue != definition.DiscriminatorValue {\n146|\t\t\t\treturn fmt.Errorf(\"self-identity contract for %s@%s differs from generated catalog\", key.schema, key.version)\n147|\t\t\t}\n148|\t\t}\n149|\t}\n150|\tif len(contracts) != expected {\n151|\t\treturn fmt.Errorf(\"self-identity contract table has %d rows, generated catalog has %d\", len(contracts), expected)\n152|\t}\n153|\treturn nil\n154|}\n155|\n156|// Canonicalize is the production RFC 8785 entry point. It decodes input through\n157|// the shared strict decoder, so it rejects malformed UTF-8, lone or unpaired\n158|// surrogate escapes, unescaped control characters inside strings, duplicate\n159|// object names, trailing data after the top-level value, and any document that\n160|// holds more than 256 containers open at once. What survives is returned as the\n161|// RFC 8785 canonical UTF-8 byte sequence.\n162|//\n163|// That last bound is a nesting depth, not a count of the containers a document\n164|// opens. Only simultaneously open containers cost decoder stack frames, which\n165|// is the exhaustion this refusal exists to prevent, so a shallow document is\n166|// accepted however many containers it opens in total. Each row below is built\n167|// and driven through this function by\n168|// TestCanonicalizeDocumentedContainerLimitIsADepthNotACount:\n169|//\n170|//\t400 sibling arrays open 401 containers, 2 at once: accepted\n171|//\t256 nested arrays open 256 containers, 256 at once: accepted\n172|//\t257 nested arrays open 257 containers, 257 at once: refused\n173|//\n174|// WHAT THIS FUNCTION DOES NOT REFUSE.\n175|//\n176|// It does not enforce the AX common logical number model, and it must not.\n177|// RFC 8785 Section 3.2.2.3 serializes every number through the ECMAScript\n178|// Number.prototype.toString algorithm applied to the IEEE 754 binary64 value,\n179|// and Appendix B publishes the resulting rounded outputs as normative test\n180|// data. A literal that binary64 cannot hold exactly is therefore rounded to the\n181|// nearest double and canonicalized from there rather than refused:\n182|//\n183|//\t9007199254740993 -> 9007199254740992\n184|//\t18446744073709551615 -> 18446744073709552000\n185|//\t1.0 -> 1\n186|//\n187|// That is the intended behaviour of a JCS transform, not a gap in it. Refusing\n188|// those literals here would contradict Appendix B, whose own published samples\n189|// include 9007199254740992 and 295147905179352830000 as canonical outputs of\n190|// exactly this rounding, and which this package pins in\n191|// TestCanonicalizeMatchesEveryFiniteRFC8785AppendixBNumberSample.\n192|//\n193|// DIVISION OF GUARANTEES.\n194|//\n195|// The pinned specification does not put the safe-integer refusal on the\n196|// canonicalization step. It puts it on the AX decoder, on the JSON number token\n197|// itself, and Section 1.6 says so both as a MUST clause and as two normative\n198|// boundary fixtures. Each fragment below is quoted verbatim from the pinned\n199|// internal/specdoc/SPEC.md at the line named, and a fragment attributed to a\n200|// fixture is quoted from the table row that declares that fixture:\n201|//\n202|//\tSPEC.md:292 \"A decoder MUST reject a numeric literal at or beyond <code>2^53</code> even if its host language can represent it\"\n203|//\tSPEC.md:295 \"Implementations MUST NOT round a value and continue.\"\n204|//\tSPEC.md:301 NUM-UNSAFE-NUMBER \"Reject before identity calculation with <code>incompatible_schema</code>\"\n205|//\tSPEC.md:302 NUM-UNSAFE-ROUND \"Reject from the JSON number token before conversion to a host double; an implementation that first rounds it to 9007199254740992 is nonconforming\"\n206|//\n207|// NUM-UNSAFE-ROUND describes this implementation exactly: validateAXNumbers\n208|// refuses the literal on the json.Number token, before any conversion to a host\n209|// double, and it runs inside prepareObjectIdentity before any canonical bytes\n210|// exist. It is reached from these exported entry points, each of which refuses\n211|// all three literals above with a typed error:\n212|//\n213|//\tCalculateObjectIdentity\n214|//\tVerifyObjectIdentity\n215|//\tValidateObservationEvent\n216|//\tValidateObservationStream\n217|//\n218|// Canonicalize itself carries no such guarantee. It is a byte transform over\n219|// whatever RFC 8785 accepts, and this package exports no standalone AX number\n220|// validator, so a caller that needs the AX number model must reach it through\n221|// one of the entry points named above rather than by canonicalizing first.\n222|func Canonicalize(input []byte) ([]byte, error) {\n223|\tvalue, err := decodeStrict(input)\n224|\tif err != nil {\n225|\t\treturn nil, err\n226|\t}\n227|\t// Re-encode the parsed logical value before the JCS transform. This removes\n228|\t// leading/trailing whitespace around primitive top-level values without\n229|\t// changing json.Number tokens or string data.\n230|\tnormalized, err := json.Marshal(value)\n231|\tif err != nil {\n232|\t\treturn nil, invalidJSON(\"serialize logical JSON value: %v\", err)\n233|\t}\n234|\tcanonical, err := jcs.Transform(normalized)\n235|\tif err != nil {\n236|\t\treturn nil, invalidJSON(\"canonicalize RFC 8785 value: %v\", err)\n237|\t}\n238|\treturn canonical, nil\n239|}\n240|\n241|// CalculateObjectIdentity validates the AX common logical number model,\n242|// resolves the one self field from the object's trusted schema/version\n243|// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\n244|// identity. Callers cannot select an arbitrary field to omit, which prevents\n245|// self inclusion and digest cycles.\n246|//\n247|// This is where the AX safe-integer refusal lives, not in Canonicalize: a\n248|// literal at or beyond 2^53, or any floating-point literal, is refused here\n249|// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\n250|// OF GUARANTEES note on Canonicalize.\n251|func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n252|\tobject, selfField, _, err := prepareObjectIdentity(input)\n253|\tif err != nil {\n254|\t\treturn scalar.Digest{}, \"\", err\n255|\t}\n256|\treturn calculatePreparedObjectIdentity(object, selfField)\n257|}\n258|\n259|func prepareObjectIdentity(input []byte) (map[string]any, SelfField, scalar.Digest, error) {\n260|\tif len(input) > 5_242_880 {\n261|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"encoded identity object is %d bytes, maximum is 5242880\", len(input))\n262|\t}\n263|\tvalue, err := decodeStrict(input)\n264|\tif err != nil {\n265|\t\treturn nil, \"\", scalar.Digest{}, err\n266|\t}\n267|\tif err := validateAXNumbers(value); err != nil {\n268|\t\treturn nil, \"\", scalar.Digest{}, err\n269|\t}\n270|\tobject, ok := value.(map[string]any)\n271|\tif !ok {\n272|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"identity input must be a JSON object\")\n273|\t}\n274|\n275|\tselfField, claimed, err := resolveSelfField(object)\n276|\tif err != nil {\n277|\t\treturn nil, \"\", scalar.Digest{}, err\n278|\t}\n279|\t// This is the composed production gate: closed contract validation happens\n280|\t// after trusted schema selection and before either calculation or attestation.\n281|\tif err := validateImmutableObjectShape(object); err != nil {\n282|\t\treturn nil, \"\", scalar.Digest{}, err\n283|\t}\n284|\treturn object, selfField, claimed, nil\n285|}\n286|\n287|func calculatePreparedObjectIdentity(object map[string]any, selfField SelfField) (scalar.Digest, SelfField, error) {\n288|\tomitted := make(map[string]any, len(object)-1)\n289|\tfor name, member := range object {\n290|\t\tif name != string(selfField) {\n291|\t\t\tomitted[name] = member\n292|\t\t}\n293|\t}\n294|\tserialized, err := json.Marshal(omitted)\n295|\tif err != nil {\n296|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"serialize omit-self object: %v\", err)\n297|\t}\n298|\tcanonical, err := jcs.Transform(serialized)\n299|\tif err != nil {\n300|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"canonicalize omit-self object: %v\", err)\n301|\t}\n302|\treturn scalar.SHA256Digest(canonical), selfField, nil\n303|}\n304|\n305|// VerifyObjectIdentity drives the same production calculation and refuses a\n306|// malformed, self-included, or otherwise mismatched claimed identity. It shares\n307|// prepareObjectIdentity with CalculateObjectIdentity, so it carries the same AX\n308|// safe-integer guarantee that Canonicalize does not.\n309|func VerifyObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n310|\tobject, selfField, claimed, err := prepareObjectIdentity(input)\n311|\tif err != nil {\n312|\t\treturn scalar.Digest{}, \"\", err\n313|\t}\n314|\tcalculated, calculatedField, err := calculatePreparedObjectIdentity(object, selfField)\n315|\tif err != nil {\n316|\t\treturn scalar.Digest{}, \"\", err\n317|\t}\n318|\tif calculatedField != selfField || claimed != calculated {\n319|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\n320|\t\t\t\"%s claim %q does not match omit-self digest %q\",\n321|\t\t\tselfField,\n322|\t\t\tclaimed,\n323|\t\t\tcalculated,\n324|\t\t)\n325|\t}\n326|\treturn calculated, selfField, nil\n327|}\n328|\n329|func resolveSelfField(object map[string]any) (SelfField, scalar.Digest, error) {\n330|\tschema, err := requiredStringMember(object, \"schema\")\n331|\tif err != nil {\n332|\t\treturn \"\", scalar.Digest{}, err\n333|\t}\n334|\tversion, err := requiredStringMember(object, \"schema_version\")\n335|\tif err != nil {\n336|\t\treturn \"\", scalar.Digest{}, err\n337|\t}\n338|\tcontract, ok := schemaIdentityContracts[schemaIdentityKey{schema: schema, version: version}]\n339|\tif !ok {\n340|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n341|\t\t\t\"schema %q version %q has no supported immutable self-identity contract\",\n342|\t\t\tschema,\n343|\t\t\tversion,\n344|\t\t)\n345|\t}\n346|\tif contract.discriminatorName != \"\" {\n347|\t\tdiscriminator, err := requiredStringMember(object, contract.discriminatorName)\n348|\t\tif err != nil {\n349|\t\t\treturn \"\", scalar.Digest{}, err\n350|\t\t}\n351|\t\tif discriminator != contract.discriminatorValue {\n352|\t\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n353|\t\t\t\t\"schema %q version %q variant %s=%q is not an immutable self-identity contract\",\n354|\t\t\t\tschema,\n355|\t\t\t\tversion,\n356|\t\t\t\tcontract.discriminatorName,\n357|\t\t\t\tdiscriminator,\n358|\t\t\t)\n359|\t\t}\n360|\t}\n361|\n362|\tvalue, ok := object[string(contract.selfField)]\n363|\tif !ok {\n364|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n365|\t\t\t\"schema %q version %q requires self field %s\",\n366|\t\t\tschema,\n367|\t\t\tversion,\n368|\t\t\tcontract.selfField,\n369|\t\t)\n370|\t}\n371|\ttext, ok := value.(string)\n372|\tif !ok {\n373|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\"self field %s must contain a digest string\", contract.selfField)\n374|\t}\n375|\tclaim, err := scalar.ParseDigest(text)\n376|\tif err != nil {\n377|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\"self field %s: %v\", contract.selfField, err)\n378|\t}\n379|\treturn contract.selfField, claim, nil\n380|}\n381|\n382|func requiredStringMember(object map[string]any, name string) (string, error) {\n383|\tvalue, ok := object[name]\n384|\tif !ok {\n385|\t\treturn \"\", invalidIdentity(\"identity input requires string member %s\", name)\n386|\t}\n387|\ttext, ok := value.(string)\n388|\tif !ok || text == \"\" {\n389|\t\treturn \"\", invalidIdentity(\"identity input member %s must be a non-empty string\", name)\n390|\t}\n391|\treturn text, nil\n392|}\n393|\n394|func decodeStrict(input []byte) (any, error) {\n395|\tif len(input) == 0 {\n396|\t\treturn nil, invalidJSON(\"input is empty\")\n397|\t}\n398|\tif !utf8.Valid(input) {\n399|\t\treturn nil, invalidJSON(\"input is not valid UTF-8\")\n400|\t}\n401|\tif err := validateSurrogateEscapes(input); err != nil {\n402|\t\treturn nil, err\n403|\t}\n404|\n405|\tdecoder := json.NewDecoder(bytes.NewReader(input))\n406|\tdecoder.UseNumber()\n407|\tvalue, err := decodeValue(decoder, 0)\n408|\tif err != nil {\n409|\t\treturn nil, err\n410|\t}\n411|\tif token, err := decoder.Token(); !errors.Is(err, io.EOF) {\n412|\t\tif err != nil {\n413|\t\t\treturn nil, invalidJSON(\"read trailing JSON data: %v\", err)\n414|\t\t}\n415|\t\treturn nil, invalidJSON(\"unexpected trailing JSON token %v\", token)\n416|\t}\n417|\treturn value, nil\n418|}\n419|\n420|// decodeValue decodes one logical JSON value. depth counts the containers\n421|// already open around this value, so the top-level value is decoded at depth 0\n422|// and a container at depth maxNestingDepth-1 is the last one allowed to open.\n423|func decodeValue(decoder *json.Decoder, depth int) (any, error) {\n424|\ttoken, err := decoder.Token()\n425|\tif err != nil {\n426|\t\treturn nil, invalidJSON(\"decode JSON token: %v\", err)\n427|\t}\n428|\tdelimiter, ok := token.(json.Delim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n470|\t\t}\n471|\t\tend, err := decoder.Token()\n472|\t\tif err != nil || end != json.Delim(']') {\n473|\t\t\treturn nil, invalidJSON(\"decode array terminator: %v\", err)\n474|\t\t}\n475|\t\treturn array, nil\n476|\tdefault:\n477|\t\treturn nil, invalidJSON(\"unexpected delimiter %q\", delimiter)\n478|\t}\n479|}\n480|\n481|// validateAXNumbers is the AX decoder half of the split documented under\n482|// DIVISION OF GUARANTEES on Canonicalize. It walks the decoded value and\n483|// refuses every literal the common logical data model forbids, on the\n484|// json.Number token rather than on a host double, so an unsafe integer is\n485|// rejected instead of rounded. Canonicalize deliberately does not call it;\n486|// every exported entry point that promises the AX number model does.\n487|func validateAXNumbers(value any) error {\n488|\tswitch typed := value.(type) {\n489|\tcase json.Number:\n490|\t\tliteral := typed.String()\n491|\t\tif strings.ContainsAny(literal, \".eE\") {\n492|\t\t\treturn invalidIdentity(\"floating-point number %q is forbidden by the AX common model\", literal)\n493|\t\t}\n494|\t\tinteger, err := strconv.ParseInt(literal, 10, 64)\n495|\t\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n496|\t\t\treturn invalidIdentity(\"integer %q is outside the AX safe-integer interval\", literal)\n497|\t\t}\n498|\tcase []any:\n499|\t\tfor _, element := range typed {\n500|\t\t\tif err := validateAXNumbers(element); err != nil {\n(more lines below)"}}}
