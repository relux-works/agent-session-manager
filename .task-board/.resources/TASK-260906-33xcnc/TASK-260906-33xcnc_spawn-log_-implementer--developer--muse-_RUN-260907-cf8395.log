{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42b","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":112,"recorded_at":1780531400000219,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"a29f58a3-42e4-4a46-96b6-1cb531941f85"},"task_id":"a29f58a3-42e4-4a46-96b6-1cb531941f85","event":{"kind":"output","task_id":"a29f58a3-42e4-4a46-96b6-1cb531941f85","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/tuple.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// environmentIDPattern is the Section 7.8 environment-id grammar:\n11|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n12|// identifier; it is never inferred by spelling.\n13|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n14|\n15|// CheckEnvironmentID reports whether the value is an\n16|// environment-id.\n17|func CheckEnvironmentID(value string) bool {\n18|\treturn environmentIDPattern.MatchString(value)\n19|}\n20|\n21|// semverPattern is the SemVer grammar adapter and environment\n22|// versions satisfy: three dot-separated numeric parts with\n23|// optional pre-release and build metadata.\n24|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n25|\n26|// CheckSemver reports whether the value is a SemVer string.\n27|func CheckSemver(value string) bool {\n28|\treturn semverPattern.MatchString(value)\n29|}\n30|\n31|// tupleArchitectures is the closed tuple architecture vocabulary\n32|// Section 7.8 states. Membership is a table loop so the census\n33|// derives it like every other closed vocabulary: an inline chain\n34|// here would be invisible to the census, and a widened chain\n35|// would silently admit a third architecture.\n36|var tupleArchitectures = []string{\n37|\t\"amd64\",\n38|\t\"arm64\",\n39|}\n40|\n41|// validTupleArchitecture reports whether the name is one of the\n42|// two tuple architectures.\n43|func validTupleArchitecture(architecture string) bool {\n44|\tfor _, allowed := range tupleArchitectures {\n45|\t\tif architecture == allowed {\n46|\t\t\treturn true\n47|\t\t}\n48|\t}\n49|\treturn false\n50|}\n51|\n52|// tupleMembers is the exact Environment Tuple member set Sections\n53|// 7.8 and 13.14 require: environment_id, environment_version,\n54|// platform, architecture, store_schema_fingerprint, and\n55|// adapter_version. The tuple never contains executable provenance,\n56|// and — unlike every neighbouring closed type — it carries no\n57|// extensions member, so even a reverse-DNS extensions object is\n58|// refused here.\n59|var tupleMembers = map[string]bool{\n60|\t\"environment_id\":           true,\n61|\t\"environment_version\":      true,\n62|\t\"platform\":                 true,\n63|\t\"architecture\":             true,\n64|\t\"store_schema_fingerprint\": true,\n65|\t\"adapter_version\":          true,\n66|}\n67|\n68|// tupleRequired lists tupleMembers in a fixed order.\n69|var tupleRequired = []string{\n70|\t\"environment_id\",\n71|\t\"environment_version\",\n72|\t\"platform\",\n73|\t\"architecture\",\n74|\t\"store_schema_fingerprint\",\n75|\t\"adapter_version\",\n76|}\n77|\n78|// Tuple is one validated Environment Tuple.\n79|type Tuple struct {\n80|\tEnvironmentID    string\n81|\tVersion          string\n82|\tPlatform         string\n83|\tArchitecture     string\n84|\tStoreFingerprint string\n85|\tAdapterVersion   string\n86|}\n87|\n88|// DecodeTuple validates one closed Environment Tuple: exact\n89|// members, the environment-id grammar, environment_version as\n90|// string[1..128] (the bound Section 10.8.1 states for the\n91|// observation that reuses this admission model), the closed\n92|// platform and architecture vocabularies, a digest store\n93|// fingerprint, and a SemVer adapter version. Any executable\n94|// provenance member is an unknown member, never a second\n95|// identity.\n96|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n97|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n98|\tif fault != nil {\n99|\t\treturn Tuple{}, refuse(\"tuple \"+fault.Detail, fault.Member)\n100|\t}\n101|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n102|\t\treturn Tuple{}, refuse(\"tuple carries unknown member\", name)\n103|\t}\n104|\tif name, missing := missingMember(members, tupleRequired); missing {\n105|\t\treturn Tuple{}, refuse(\"tuple misses a required member\", name)\n106|\t}\n107|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n108|\tif !ok || !CheckEnvironmentID(environmentID) {\n109|\t\treturn Tuple{}, refuse(\"tuple environment identifier is not an environment-id\", \"environment_id\")\n110|\t}\n111|\tversion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n112|\tif !ok {\n113|\t\treturn Tuple{}, refuse(\"tuple environment version is not a string[1..128]\", \"environment_version\")\n114|\t}\n115|\tplatform, ok := rawString(members[\"platform\"])\n116|\tif !ok {\n117|\t\treturn Tuple{}, refuse(\"tuple platform is not a string\", \"platform\")\n118|\t}\n119|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n120|\t\treturn Tuple{}, refuse(\"tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n121|\t}\n122|\tarchitecture, ok := rawString(members[\"architecture\"])\n123|\tif !ok || !validTupleArchitecture(architecture) {\n124|\t\treturn Tuple{}, refuse(\"tuple architecture is outside amd64|arm64\", \"architecture\")\n125|\t}\n126|\tfingerprint, ok := CheckDigest(members[\"store_schema_fingerprint\"])\n127|\tif !ok {\n128|\t\treturn Tuple{}, refuse(\"tuple store fingerprint is not a digest\", \"store_schema_fingerprint\")\n129|\t}\n130|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n131|\tif !ok || !CheckSemver(adapterVersion) {\n132|\t\treturn Tuple{}, refuse(\"tuple adapter version is not SemVer\", \"adapter_version\")\n133|\t}\n134|\treturn Tuple{\n135|\t\tEnvironmentID:    environmentID,\n136|\t\tVersion:          version,\n137|\t\tPlatform:         platform,\n138|\t\tArchitecture:     architecture,\n139|\t\tStoreFingerprint: fingerprint.String(),\n140|\t\tAdapterVersion:   adapterVersion,\n141|\t}, nil\n142|}"}}}
