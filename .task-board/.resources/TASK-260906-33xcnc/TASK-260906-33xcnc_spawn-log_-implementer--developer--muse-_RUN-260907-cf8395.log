{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c647","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":382,"recorded_at":1780531400000759,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad26f0d75b19d45ec53a3fe7ea3","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/tuple_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n15|)\n16|\n17|// This file is the Environment Tuple agreement battery. The\n18|// tuple is the one type every state-bearing adapter call\n19|// carries, and its admission model is shared with the Section\n20|// 10.8.1 observation rather than restated there. The battery\n21|// proves sessadapter.DecodeTuple and environ.DecodeTuple agree\n22|// verdict-for-verdict over a corpus that mutates each member\n23|// alone, and proves the two member tables are literally one\n24|// table: the required lists are derived from both productions\n25|// and required equal in order as well as content, because\n26|// missing-member determinism (which member is named when several\n27|// are absent) is itself shared behavior.\n28|\n29|// deriveRequiredList derives the string list behind a\n30|// package-level []string variable in one production file. The\n31|// comparison travels with the derivation: a reordered,\n32|// extended, or shortened table fails here, not silently.\n33|func deriveRequiredList(t *testing.T, pkg, file, symbol string) []string {\n34|\tt.Helper()\n35|\tpath := filepath.Join(mustInternalRoot(t), pkg, file)\n36|\tsource, err := os.ReadFile(path)\n37|\tif err != nil {\n38|\t\tt.Fatalf(\"members: %v\", err)\n39|\t}\n40|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n41|\tif err != nil {\n42|\t\tt.Fatalf(\"members: %v\", err)\n43|\t}\n44|\tfor _, decl := range syntax.Decls {\n45|\t\tnode, ok := decl.(*ast.GenDecl)\n46|\t\tif !ok {\n47|\t\t\tcontinue\n48|\t\t}\n49|\t\tfor _, spec := range node.Specs {\n50|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n51|\t\t\tif !ok || len(value.Names) != 1 || value.Names[0].Name != symbol {\n52|\t\t\t\tcontinue\n53|\t\t\t}\n54|\t\t\tif len(value.Values) != 1 {\n55|\t\t\t\tt.Fatalf(\"members: %s %s is not a single literal; the extractor cannot see through indirection\", path, symbol)\n56|\t\t\t}\n57|\t\t\tcomposite, ok := value.Values[0].(*ast.CompositeLit)\n58|\t\t\tif !ok {\n59|\t\t\t\tt.Fatalf(\"members: %s %s is not a composite literal; the extractor cannot see through indirection\", path, symbol)\n60|\t\t\t}\n61|\t\t\tvar members []string\n62|\t\t\tfor _, element := range composite.Elts {\n63|\t\t\t\tliteral, ok := element.(*ast.BasicLit)\n64|\t\t\t\tif !ok {\n65|\t\t\t\t\tt.Fatalf(\"members: %s %s holds a non-literal; the extractor cannot see through indirection\", path, symbol)\n66|\t\t\t\t}\n67|\t\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n68|\t\t\t}\n69|\t\t\treturn members\n70|\t\t}\n71|\t}\n72|\tt.Fatalf(\"members: %s %s not found; the extractor is blind, not the table absent\", path, symbol)\n73|\treturn nil\n74|}\n75|\n76|func mustInternalRoot(t *testing.T) string {\n77|\tt.Helper()\n78|\troot, err := internalRoot(t)\n79|\tif err != nil {\n80|\t\tt.Fatalf(\"members: %v\", err)\n81|\t}\n82|\treturn root\n83|}\n84|\n85|// internalRoot returns the internal/ source root above this\n86|// package directory. It lives here (rather than reusing the\n87|// in-package census helper) because this battery is an external\n88|// test package: the facades it drives import environ, so an\n89|// in-package battery importing them would be an import cycle.\n90|func internalRoot(t *testing.T) (string, error) {\n91|\tt.Helper()\n92|\tdirectory, err := os.Getwd()\n93|\tif err != nil {\n94|\t\treturn \"\", err\n95|\t}\n96|\treturn filepath.Dir(directory), nil\n97|}\n98|\n99|// TestTupleMemberTablesAreOneTable requires the environ and\n100|// sessadapter required-member tables to be literally equal:\n101|// same members, same order. A seventh member admitted on one\n102|// side, or a renamed member, reddens here before any vector\n103|// runs.\n104|func TestTupleMemberTablesAreOneTable(t *testing.T) {\n105|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleRequired\")\n106|\ttheirs := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleRequired\")\n107|\tif !reflect.DeepEqual(mine, theirs) {\n108|\t\tt.Fatalf(\"tuple required tables differ:\\nenviron:     %q\\nsessadapter: %q\", mine, theirs)\n109|\t}\n110|\tif len(mine) != 6 {\n111|\t\tt.Fatalf(\"tuple required table has %d members, want the exact six\", len(mine))\n112|\t}\n113|}\n114|\n115|// tupleRow is one agreement vector: the body and the rule phrase\n116|// both refusals must carry. An empty phrase means both entries\n117|// accept.\n118|type tupleRow struct {\n119|\tname string\n120|\tbody []byte\n121|\ttext string\n122|}\n123|\n124|// tupleCorpus mutates each tuple member alone against an\n125|// otherwise-valid body, plus the executable-provenance,\n126|// extensions, and vocabulary edges.\n127|func tupleCorpus(t *testing.T) []tupleRow {\n128|\tt.Helper()\n129|\tvalid := validTupleJSON()\n130|\tdrop := func(member string) []byte { return dropMember(t, []byte(valid), member) }\n131|\tset := func(member, literal string) []byte { return mutateMember(t, []byte(valid), member, literal) }\n132|\treturn []tupleRow{\n133|\t\t{\"valid\", []byte(valid), \"\"},\n134|\t\t{\"missing environment_id\", drop(\"environment_id\"), \"misses a required member\"},\n135|\t\t{\"missing environment_version\", drop(\"environment_version\"), \"misses a required member\"},\n136|\t\t{\"missing platform\", drop(\"platform\"), \"misses a required member\"},\n137|\t\t{\"missing architecture\", drop(\"architecture\"), \"misses a required member\"},\n138|\t\t{\"missing store_schema_fingerprint\", drop(\"store_schema_fingerprint\"), \"misses a required member\"},\n139|\t\t{\"missing adapter_version\", drop(\"adapter_version\"), \"misses a required member\"},\n140|\t\t{\"unknown member\", set(\"adapter_version\", `\"1.2.3\"`), \"\"}, // placeholder, replaced below\n141|\t\t{\"extensions refused\", appendMember(t, []byte(valid), \"extensions\", `{}`), \"unknown member\"},\n142|\t\t{\"executable provenance refused\", appendMember(t, []byte(valid), \"executable_sha256\", jsonQuote(fixtureExecutable)), \"unknown member\"},\n143|\t\t{\"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n144|\t\t{\"empty environment id\", set(\"environment_id\", `\"\"`), \"environment-id\"},\n145|\t\t{\"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n146|\t\t{\"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n147|\t\t{\"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n148|\t\t{\"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n149|\t\t{\"uppercase refused\", set(\"platform\", `\"LINUX\"`), \"platform\"},\n150|\t\t{\"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n151|\t\t{\"arm64 admits\", set(\"architecture\", `\"arm64\"`), \"\"},\n152|\t\t{\"bad fingerprint\", set(\"store_schema_fingerprint\", `\"sha256:zzzz\"`), \"digest\"},\n153|\t\t{\"short version\", set(\"adapter_version\", `\"1.2\"`), \"SemVer\"},\n154|\t\t{\"prerelease admits\", set(\"adapter_version\", `\"1.2.3-rc.1\"`), \"\"},\n155|\t}\n156|}\n157|\n158|// TestTupleAgreementAcrossFacades drives the corpus through both\n159|// tuple entries and requires identical verdicts with the full\n160|// rule rendering on each side.\n161|func TestTupleAgreementAcrossFacades(t *testing.T) {\n162|\trows := tupleCorpus(t)\n163|\t// The unknown-member row needs a genuinely unknown member,\n164|\t// not a replaced known one.\n165|\tfor index, row := range rows {\n166|\t\tif row.name == \"unknown member\" {\n167|\t\t\trows[index].body = appendMember(t, []byte(validTupleJSON()), \"score\", `1`)\n168|\t\t\trows[index].text = \"unknown member\"\n169|\t\t}\n170|\t}\n171|\tfor _, row := range rows {\n172|\t\tt.Run(row.name, func(t *testing.T) {\n173|\t\t\tmine, mineErr := environ.DecodeTuple(row.body)\n174|\t\t\ttheirs, theirsErr := sessadapter.DecodeTuple(row.body)\n175|\t\t\tif row.text == \"\" {\n176|\t\t\t\tif mineErr != nil {\n177|\t\t\t\t\tt.Fatalf(\"environ refused %s: %v\", row.body, mineErr)\n178|\t\t\t\t}\n179|\t\t\t\tif theirsErr != nil {\n180|\t\t\t\t\tt.Fatalf(\"sessadapter refused %s: %v\", row.body, theirsErr)\n181|\t\t\t\t}\n182|\t\t\t\tif mine.EnvironmentID != theirs.EnvironmentID || mine.Version != theirs.Version ||\n183|\t\t\t\t\tmine.Platform != theirs.Platform || mine.Architecture != theirs.Architecture ||\n184|\t\t\t\t\tmine.StoreFingerprint != theirs.StoreFingerprint || mine.AdapterVersion != theirs.AdapterVersion {\n185|\t\t\t\t\tt.Fatalf(\"decoded tuples differ: %+v vs %+v\", mine, theirs)\n186|\t\t\t\t}\n187|\t\t\t\treturn\n188|\t\t\t}\n189|\t\t\tif mineErr == nil {\n190|\t\t\t\tt.Fatalf(\"environ admitted %s, want rule %q\", row.body, row.text)\n191|\t\t\t}\n192|\t\t\tif theirsErr == nil {\n193|\t\t\t\tt.Fatalf(\"sessadapter admitted %s, want rule %q\", row.body, row.text)\n194|\t\t\t}\n195|\t\t\tif !strings.Contains(mineErr.Error(), row.text) {\n196|\t\t\t\tt.Fatalf(\"environ error = %v, want rule %q\", mineErr, row.text)\n197|\t\t\t}\n198|\t\t\tif !strings.Contains(theirsErr.Error(), row.text) {\n199|\t\t\t\tt.Fatalf(\"sessadapter error = %v, want rule %q\", theirsErr, row.text)\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|// appendMember returns the object with one added top-level\n206|// member. Every other member holds a valid value, so the added\n207|// member alone decides the verdict.\n208|func appendMember(t *testing.T, body []byte, member, literal string) []byte {\n209|\tt.Helper()\n210|\tmembers := decodeTestMembers(t, body)\n211|\tif _, present := members[member]; present {\n212|\t\tt.Fatalf(\"appendMember: %q already present\", member)\n213|\t}\n214|\tmembers[member] = literal\n215|\treturn encodeTestMembers(t, members)\n216|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c649","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":383,"recorded_at":1780531400000761,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad26fc67041a95437bb469bab42","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/identity_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file is the Provider Identity agreement battery. Two\n16|// validators implement the Section 5.5 shape rule-for-rule:\n17|// provhost.CheckIdentity mints provider-stdio refusals while\n18|// canonicaljson validates the same record through the closed\n19|// identity shape on the way to its object identity. A shape-rule\n20|// change must land in both validators in the same change, and\n21|// this battery is what fails when it lands in only one: every\n22|// row drives one shared vector through both production entries\n23|// and requires identical verdicts with the full rendering on\n24|// each side.\n25|//\n26|// One split is by design, not drift: provider equality (the\n27|// record naming the expected provider) is a caller-correlation\n28|// rule the host enforces, not a content rule the identity\n29|// calculation owns. The another-provider row ledgers that split\n30|// exactly — provhost refuses invalid_config while the\n31|// canonicalizer accepts — so a content-rule divergence cannot\n32|// hide behind it and a change to the split reddens here.\n33|\n34|// identityRow is one agreement vector: the body, the provhost\n35|// rule phrase, and the canonicalizer rule phrase. Empty phrases\n36|// mean both entries accept.\n37|type identityRow struct {\n38|\tname      string\n39|\tbody      []byte\n40|\tprovText  string\n41|\tcanonText string\n42|}\n43|\n44|// identityCorpus mutates each identity member alone against an\n45|// otherwise-valid record over the shared fixture identities.\n46|func identityCorpus(t *testing.T) []identityRow {\n47|\tt.Helper()\n48|\tvalid := validIdentityJSON()\n49|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n50|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n51|\totherSubject := jsonQuote(fixtureCreatorHostID)\n52|\treturn []identityRow{\n53|\t\t{\"valid\", valid, \"\", \"\"},\n54|\t\t{\"unknown member\", appendMember(t, valid, \"score\", `1`), \"identity carries unknown member\", \"unknown member\"},\n55|\t\t{\"missing opaque\", drop(\"opaque_identity\"), \"identity misses a required member\", \"required member\"},\n56|\t\t// Schema dispatch precedes shape validation in the\n57|\t\t// canonicalizer: a wrong schema or version refuses at\n58|\t\t// the dispatch registry, never reaching the identity\n59|\t\t// rules provhost enforces as member arms. Same\n60|\t\t// verdict, different arm by construction; a schema\n61|\t\t// change must update the dispatch registry and both\n62|\t\t// validators together.\n63|\t\t{\"wrong schema\", set(\"schema\", `\"urn:ax:schema:provider-manifest\"`), \"identity schema is not the provider identity\", \"has no supported immutable self-identity contract\"},\n64|\t\t{\"wrong version\", set(\"schema_version\", `\"1.1.0\"`), \"identity schema_version is not 1.0.0\", \"has no supported immutable self-identity contract\"},\n65|\t\t{\"bad record digest\", set(\"record_id\", `\"sha256:zzzz\"`), \"identity record_id is not a digest\", \"record_id\"},\n66|\t\t{\"bad subject uuid\", set(\"subject_id\", `\"not-a-uuid\"`), \"identity subject_id is not a UUIDv7\", \"subject_id\"},\n67|\t\t{\"subject differs\", set(\"subject_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n68|\t\t{\"session differs\", set(\"session_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n69|\t\t{\"bad provider grammar\", set(\"provider_id\", `\"Antigravity\"`), \"identity provider_id is not a provider id\", \"provider_id\"},\n70|\t\t{\"empty version\", set(\"provider_version\", `\"\"`), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n71|\t\t{\"long version\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n72|\t\t{\"empty range\", set(\"provider_version_range\", `\"\"`), \"identity provider_version_range is not 1..256 characters\", \"provider_version_range\"},\n73|\t\t{\"empty native id\", set(\"native_session_id\", `\"\"`), \"identity native_session_id is not 1..512 characters\", \"native_session_id\"},\n74|\t\t{\"unknown kind\", set(\"identity_kind\", `\"telepathy\"`), \"identity kind is not a registry member\", \"identity_kind\"},\n75|\t\t{\"bad workspace uuid\", set(\"logical_workspace_id\", `\"not-a-uuid\"`), \"identity workspace is not a UUIDv7\", \"logical_workspace_id\"},\n76|\t\t{\"bad realm\", set(\"backend_realm_fingerprint\", `\"sha256:zzzz\"`), \"identity realm is not a digest or null\", \"backend_realm_fingerprint\"},\n77|\t\t{\"null realm refused\", set(\"backend_realm_fingerprint\", `null`), \"identity realm is required for this backend kind\", \"must be non-null for Antigravity\"},\n78|\t\t{\"opaque array refused\", set(\"opaque_identity\", `[]`), \"not a JSON object\", \"opaque_identity\"},\n79|\t\t{\"opaque 33 keys refused\", set(\"opaque_identity\", opaqueKeysJSON(33)), \"exceeds 32 entries\", \"exceeds maximum length 32\"},\n80|\t\t{\"opaque bad key\", set(\"opaque_identity\", `{\"K\":\"v\"}`), \"identity opaque key is not a provider key\", \"must match\"},\n81|\t\t{\"opaque empty value\", set(\"opaque_identity\", `{\"k\":\"\"}`), \"identity opaque value is not 1..1024 characters\", \"1..1024\"},\n82|\t\t{\"opaque absolute path\", set(\"opaque_identity\", `{\"k\":\"/etc/passwd\"}`), \"begins with an absolute path\", \"must not begin with an absolute path\"},\n83|\t\t{\"bad creator uuid\", set(\"created_by_host_id\", `\"not-a-uuid\"`), \"identity host is not a UUIDv7\", \"created_by_host_id\"},\n84|\t\t{\"bad timestamp\", set(\"created_at\", `\"yesterday\"`), \"identity timestamp is not a timestamp\", \"created_at\"},\n85|\t\t{\"extensions array refused\", set(\"extensions\", `[]`), \"identity extensions is not an object\", \"extensions\"},\n86|\t\t{\"lone escape refused\", set(\"opaque_identity\", `{\"k\":\"A`+rawLoneHigh+`B\"}`), \"lone surrogate escape\", \"surrogate\"},\n87|\t\t{\"escaped text admits\", set(\"opaque_identity\", `{\"k\":\"A`+rawEscapedHigh+`B\"}`), \"\", \"\"},\n88|\t\t// The rows below pin the deliberate copy against its owner\n89|\t\t// (canonicaljson) on the classes where the dialect is blind:\n90|\t\t// extensions content, numbers, and nesting the dialect never\n91|\t\t// reads. The provhost phrase on each is the conjoined owner\n92|\t\t// gate, not a member arm: deleting the owner call admits the\n93|\t\t// body and fails the row on the provhost side.\n94|\t\t{\"extensions open key refused\", set(\"extensions\", `{\"x\": \"y\"}`), \"identity is not a valid provider identity\", \"extensions key\"},\n95|\t\t{\"extensions unsafe integer refused\", set(\"extensions\", `{\"works.relux.ax.x\": 9007199254740993}`), \"identity is not a valid provider identity\", \"outside the AX safe-integer interval\"},\n96|\t\t{\"extensions float refused\", set(\"extensions\", `{\"works.relux.ax.x\": 1.5}`), \"identity is not a valid provider identity\", \"forbidden by the AX common model\"},\n97|\t\t{\"extensions 65 keys refused\", set(\"extensions\", extensionKeysJSON(65)), \"identity is not a valid provider identity\", \"maximum is 64\"},\n98|\t\t{\"extensions deep nesting refused\", set(\"extensions\", `{\"works.relux.ax.a\": {\"b\": {\"c\": {\"d\": {\"e\": {\"f\": 1}}}}}}`), \"identity is not a valid provider identity\", \"maximum nesting depth 4\"},\n99|\t\t// Bound edges in both directions: the admit rows prove the gate\n100|\t\t// is not refusing everything, the refuse rows prove the bound.\n101|\t\t{\"opaque 64-char key admits\", set(\"opaque_identity\", `{\"k`+strings.Repeat(\"e\", 63)+`\": \"v\"}`), \"\", \"\"},\n102|\t\t{\"version 128 admits\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 128))), \"\", \"\"},\n103|\t\t{\"version 128 wide admits\", set(\"provider_version\", jsonQuote(strings.Repeat(\"é\", 128))), \"\", \"\"},\n104|\t\t{\"version 129 wide refused\", set(\"provider_version\", jsonQuote(strings.Repeat(\"é\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n105|\t\t// A number where the dialect already reads the type is refused\n106|\t\t// by the dialect arm first: the owner gate never fires, and the\n107|\t\t// member attribution survives the conjunction.\n108|\t\t{\"opaque unsafe integer refused\", set(\"opaque_identity\", `{\"k\": 9007199254740993}`), \"identity opaque value is not 1..1024 characters\", \"outside the AX safe-integer interval\"},\n109|\t\t// Decoder vectors both entries must refuse with their own arm.\n110|\t\t{\"duplicate member refused\", duplicateMemberJSON(t, valid), \"duplicate member\", \"duplicate object member\"},\n111|\t\t{\"trailing data refused\", append(append([]byte{}, valid...), ' ', '{', '}'), \"trailing data\", \"trailing JSON\"},\n112|\t}\n113|}\n114|\n115|// extensionKeysJSON builds an extensions object with count reverse-DNS\n116|// keys, so the count bound (not the key grammar) is what refuses it.\n117|func extensionKeysJSON(count int) string {\n118|\tparts := make([]string, 0, count)\n119|\tfor index := 0; index < count; index++ {\n120|\t\tparts = append(parts, `\"works.relux.ax.k`+twoDigits(index)+`\":\"v\"`)\n121|\t}\n122|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n123|}\n124|\n125|// duplicateMemberJSON returns the fixture with one member doubled: a\n126|// repeated member has no single value, so both decoders refuse it before\n127|// any shape rule runs.\n128|func duplicateMemberJSON(t *testing.T, valid []byte) []byte {\n129|\tt.Helper()\n130|\tbody := string(valid)\n131|\tif body == \"\" || body[len(body)-1] != '}' {\n132|\t\tt.Fatalf(\"duplicate member fixture is not an object\")\n133|\t}\n134|\treturn []byte(body[:len(body)-1] + `, \"score\": 1, \"score\": 2}`)\n135|}\n136|\n137|// Raw escape fragments. rawLoneHigh is a real lone high escape\n138|// in JSON source; rawEscapedHigh is an escaped backslash\n139|// followed by text, which carries no escape at all. Both are\n140|// package variables (not literals) so the Go compiler never\n141|// sees an invalid \\u escape in source.\n142|var (\n143|\trawLoneHigh    = \"\\\\ud800\"\n144|\trawEscapedHigh = \"\\\\\\\\ud800\"\n145|)\n146|\n147|// opaqueKeysJSON builds an opaque_identity object with count\n148|// grammar-valid keys.\n149|func opaqueKeysJSON(count int) string {\n150|\tparts := make([]string, 0, count)\n151|\tfor index := 0; index < count; index++ {\n152|\t\tparts = append(parts, `\"k`+twoDigits(index)+`\":\"v\"`)\n153|\t}\n154|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n155|}\n156|\n157|func twoDigits(value int) string {\n158|\tdigits := \"0123456789\"\n159|\treturn string([]byte{digits[value/10%10], digits[value%10]})\n160|}\n161|\n162|// TestIdentityAgreementAcrossValidators drives the corpus\n163|// through both identity entries and requires identical verdicts\n164|// with the full rule rendering on each side.\n165|func TestIdentityAgreementAcrossValidators(t *testing.T) {\n166|\tfor _, row := range identityCorpus(t) {\n167|\t\tt.Run(row.name, func(t *testing.T) {\n168|\t\t\tprovErr := provhost.CheckIdentity(row.body, \"antigravity\")\n169|\t\t\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(row.body)\n170|\t\t\tif row.provText == \"\" && row.canonText == \"\" {\n171|\t\t\t\tif provErr != nil {\n172|\t\t\t\t\tt.Fatalf(\"provhost refused %s: %v\", row.body, provErr)\n173|\t\t\t\t}\n174|\t\t\t\tif canonErr != nil {\n175|\t\t\t\t\tt.Fatalf(\"canonicaljson refused %s: %v\", row.body, canonErr)\n176|\t\t\t\t}\n177|\t\t\t\treturn\n178|\t\t\t}\n179|\t\t\tif provErr == nil {\n180|\t\t\t\tt.Fatalf(\"provhost admitted %s, want rule %q\", row.body, row.provText)\n181|\t\t\t}\n182|\t\t\tif canonErr == nil {\n183|\t\t\t\tt.Fatalf(\"canonicaljson admitted %s, want rule %q\", row.body, row.canonText)\n184|\t\t\t}\n185|\t\t\tif !strings.Contains(provErr.Error(), row.provText) {\n186|\t\t\t\tt.Fatalf(\"provhost error = %v, want rule %q\", provErr, row.provText)\n187|\t\t\t}\n188|\t\t\tif !strings.Contains(canonErr.Error(), row.canonText) {\n189|\t\t\t\tt.Fatalf(\"canonicaljson error = %v, want rule %q\", canonErr, row.canonText)\n190|\t\t\t}\n191|\t\t})\n192|\t}\n193|}\n194|\n195|// TestIdentityProviderEqualityIsCallerRule ledgers the one\n196|// by-design split: a well-formed record for another provider is\n197|// a caller-correlation failure (invalid_config) at the host,\n198|// while the identity calculation accepts the content. Neither\n199|// side may change its half silently.\n200|func TestIdentityProviderEqualityIsCallerRule(t *testing.T) {\n201|\tbody := mutateMember(t, validIdentityJSON(), \"provider_id\", `\"codex\"`)\n202|\tprovErr := provhost.CheckIdentity(body, \"antigravity\")\n203|\tif provErr == nil {\n204|\t\tt.Fatalf(\"provhost admitted a record for another provider\")\n205|\t}\n206|\tif !strings.Contains(provErr.Error(), \"identity names another provider\") {\n207|\t\tt.Fatalf(\"provhost error = %v, want the caller-correlation arm\", provErr)\n208|\t}\n209|\tif _, _, canonErr := canonicaljson.CalculateObjectIdentity(body); canonErr != nil {\n210|\t\tt.Fatalf(\"canonicaljson refused well-formed content for another provider: %v\", canonErr)\n211|\t}\n212|}\n213|\n214|// TestIdentityMemberTablesAreOneTable requires the provhost\n215|// required-member table and the canonicalizer's exact-member\n216|// list for the identity record to carry the same members in the\n217|// same order: multi-missing determinism is shared behavior.\n218|func TestIdentityMemberTablesAreOneTable(t *testing.T) {\n219|\tmine := deriveRequiredList(t, \"provhost\", \"identity.go\", \"identityRequired\")\n220|\ttheirs := deriveIdentityExactMembers(t)\n221|\tif len(mine) != len(theirs) {\n222|\t\tt.Fatalf(\"identity member tables differ in size:\\nprovhost: %q\\ncanonicaljson: %q\", mine, theirs)\n223|\t}\n224|\tfor index := range mine {\n225|\t\tif mine[index] != theirs[index] {\n226|\t\t\tt.Fatalf(\"identity member tables differ at %d:\\nprovhost: %q\\ncanonicaljson: %q\", index, mine, theirs)\n227|\t\t}\n228|\t}\n229|}\n230|\n231|// deriveIdentityExactMembers derives the member list from the\n232|// requireExactMembers call for the Provider Identity Record in\n233|// canonicaljson production.\n234|func deriveIdentityExactMembers(t *testing.T) []string {\n235|\tt.Helper()\n236|\tpath := mustInternalRoot(t) + \"/canonicaljson/core_records.go\"\n237|\tsource, err := os.ReadFile(path)\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"identity members: %v\", err)\n240|\t}\n241|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n242|\tif err != nil {\n243|\t\tt.Fatalf(\"identity members: %v\", err)\n244|\t}\n245|\tfound := false\n246|\tvar members []string\n247|\tast.Inspect(syntax, func(node ast.Node) bool {\n248|\t\tcall, ok := node.(*ast.CallExpr)\n249|\t\tif !ok || found {\n250|\t\t\treturn true\n251|\t\t}\n252|\t\ttarget, ok := call.Fun.(*ast.Ident)\n253|\t\tif !ok || target.Name != \"requireExactMembers\" || len(call.Args) < 3 {\n254|\t\t\treturn true\n255|\t\t}\n256|\t\tfirst, ok := call.Args[0].(*ast.BasicLit)\n257|\t\tif !ok || strings.Trim(first.Value, `\"`) != \"Provider Identity Record\" {\n258|\t\t\treturn true\n259|\t\t}\n260|\t\tfor _, arg := range call.Args[2:] {\n261|\t\t\tliteral, ok := arg.(*ast.BasicLit)\n262|\t\t\tif !ok {\n263|\t\t\t\tt.Fatalf(\"identity members: exact-member list is not literals; the extractor cannot see through indirection\")\n264|\t\t\t}\n265|\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n266|\t\t}\n267|\t\tfound = true\n268|\t\treturn false\n269|\t})\n270|\tif !found {\n271|\t\tt.Fatal(\"identity members: requireExactMembers call for the Provider Identity Record not found; the extractor is blind\")\n272|\t}\n273|\treturn members\n274|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c64b","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":384,"recorded_at":1780531400000763,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad270557aa1806bfdf06c6ad9d1","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/decode_unit_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// This file drives the environ entries no facade reaches\n10|// directly: the uint53 bound checker (with its digit-literal\n11|// ladder), the sorted-unique string checker in both of its\n12|// halves, and the frame-fault rendering. Coverage here is\n13|// behavioral (refusal or value at the edges), never line-fill:\n14|// every row would fail against a weakened gate.\n15|\n16|// TestCheckUint53BoundsEdges drives CheckUint53Bounds through\n17|// the production entry: accepts decode to the bound values, and\n18|// every refusal shape (non-number, fraction, exponent, sign,\n19|// out-of-range magnitude, bound edges) refuses.\n20|func TestCheckUint53BoundsEdges(t *testing.T) {\n21|\taccept := func(literal string, minimum, maximum uint64, want uint64) {\n22|\t\tt.Helper()\n23|\t\tgot, ok := CheckUint53Bounds(json.RawMessage(literal), minimum, maximum)\n24|\t\tif !ok {\n25|\t\t\tt.Fatalf(\"CheckUint53Bounds(%s, %d, %d) refused, want %d\", literal, minimum, maximum, want)\n26|\t\t}\n27|\t\tif got != want {\n28|\t\t\tt.Fatalf(\"CheckUint53Bounds(%s, %d, %d) = %d, want %d\", literal, minimum, maximum, got, want)\n29|\t\t}\n30|\t}\n31|\trefuse := func(literal string, minimum, maximum uint64) {\n32|\t\tt.Helper()\n33|\t\tif got, ok := CheckUint53Bounds(json.RawMessage(literal), minimum, maximum); ok {\n34|\t\t\tt.Fatalf(\"CheckUint53Bounds(%s, %d, %d) admitted %d, want refusal\", literal, minimum, maximum, got)\n35|\t\t}\n36|\t}\n37|\taccept(\"0\", 0, 100, 0)\n38|\taccept(\"100\", 0, 100, 100)\n39|\taccept(\"9007199254740991\", 0, 9007199254740991, 9007199254740991)\n40|\taccept(\"5\", 5, 10, 5)\n41|\taccept(\"10\", 5, 10, 10)\n42|\trefuse(\"4\", 5, 10)\n43|\trefuse(\"101\", 0, 100)\n44|\trefuse(\"9007199254740992\", 0, 18446744073709551615)\n45|\trefuse(\"9007199254740992\", 0, 9007199254740991)\n46|\trefuse(\"1.0\", 0, 100)\n47|\trefuse(\"1e3\", 0, 10000)\n48|\trefuse(\"-1\", 0, 100)\n49|\trefuse(\"+1\", 0, 100)\n50|\trefuse(`\"42\"`, 0, 100)\n51|\trefuse(\"null\", 0, 100)\n52|\trefuse(\"true\", 0, 100)\n53|\trefuse(\"\", 0, 100)\n54|\trefuse(\"12a\", 0, 100)\n55|\trefuse(\"18446744073709551616\", 0, 18446744073709551615)\n56|}\n57|\n58|// TestCheckSortedUniqueStringsHalves drives\n59|// CheckSortedUniqueStrings through the production entry with\n60|// the conjoined halves separated: an unsorted-but-unique vector\n61|// refuses (ordering), a sorted-but-duplicated vector refuses\n62|// (uniqueness), and a sorted unique vector admits with its\n63|// values. A check enforcing only one half cannot pass both\n64|// refusal rows.\n65|func TestCheckSortedUniqueStringsHalves(t *testing.T) {\n66|\taccept := func(t *testing.T, literal string) []string {\n67|\t\tt.Helper()\n68|\t\tvalues, ok := CheckSortedUniqueStrings(json.RawMessage(literal), 1, 128, 0, 64)\n69|\t\tif !ok {\n70|\t\t\tt.Fatalf(\"CheckSortedUniqueStrings(%s) refused, want accept\", literal)\n71|\t\t}\n72|\t\treturn values\n73|\t}\n74|\trefuse := func(t *testing.T, literal string) {\n75|\t\tt.Helper()\n76|\t\tif values, ok := CheckSortedUniqueStrings(json.RawMessage(literal), 1, 128, 0, 64); ok {\n77|\t\t\tt.Fatalf(\"CheckSortedUniqueStrings(%s) admitted %q, want refusal\", literal, values)\n78|\t\t}\n79|\t}\n80|\tt.Run(\"sorted unique admits with values\", func(t *testing.T) {\n81|\t\tvalues := accept(t, `[\"a\",\"b\",\"c\"]`)\n82|\t\tif len(values) != 3 || values[0] != \"a\" || values[1] != \"b\" || values[2] != \"c\" {\n83|\t\t\tt.Fatalf(\"values = %q, want [a b c]\", values)\n84|\t\t}\n85|\t})\n86|\tt.Run(\"unsorted unique refuses\", func(t *testing.T) {\n87|\t\trefuse(t, `[\"b\",\"a\"]`)\n88|\t})\n89|\tt.Run(\"sorted duplicated refuses\", func(t *testing.T) {\n90|\t\trefuse(t, `[\"a\",\"a\"]`)\n91|\t})\n92|\tt.Run(\"non-array refuses\", func(t *testing.T) {\n93|\t\trefuse(t, `null`)\n94|\t})\n95|\tt.Run(\"overlong element refuses\", func(t *testing.T) {\n96|\t\trefuse(t, `[\"`+strings.Repeat(\"v\", 129)+`\"]`)\n97|\t})\n98|\tt.Run(\"over count refuses\", func(t *testing.T) {\n99|\t\tif _, ok := CheckSortedUniqueStrings(json.RawMessage(`[\"a\"]`), 1, 128, 2, 64); ok {\n100|\t\t\tt.Fatal(\"admitted a vector below the count floor\")\n101|\t\t}\n102|\t\tif _, ok := CheckSortedUniqueStrings(json.RawMessage(`[\"a\",\"b\"]`), 1, 128, 0, 1); ok {\n103|\t\t\tt.Fatal(\"admitted a vector above the count ceiling\")\n104|\t\t}\n105|\t})\n106|}\n107|\n108|// TestFaultErrorRendersMember drives Fault.Error through the\n109|// production type: memberless faults name only the detail, and\n110|// member faults name both. The rendering is what the facade\n111|// wrappers translate, so both branches are pinned here.\n112|func TestFaultErrorRendersMember(t *testing.T) {\n113|\tbare := (&Fault{Detail: FaultLoneSurrogate}).Error()\n114|\tif !strings.Contains(bare, FaultLoneSurrogate) {\n115|\t\tt.Fatalf(\"memberless fault = %q, want the detail\", bare)\n116|\t}\n117|\tif strings.Contains(bare, \"in member\") {\n118|\t\tt.Fatalf(\"memberless fault = %q, must not name a member\", bare)\n119|\t}\n120|\twithMember := (&Fault{Detail: FaultDuplicate, Member: \"v\"}).Error()\n121|\tif !strings.Contains(withMember, FaultDuplicate) || !strings.Contains(withMember, \"v\") {\n122|\t\tt.Fatalf(\"member fault = %q, want the detail and the member\", withMember)\n123|\t}\n124|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
