{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"7001b78e-04d3-4d3e-b97b-0b407c2dfa87"},"task_id":"7001b78e-04d3-4d3e-b97b-0b407c2dfa87","event":{"kind":"output","task_id":"7001b78e-04d3-4d3e-b97b-0b407c2dfa87","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/observation.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// observationSchema is the exact schema identifier the\n10|// Environment Observation carries.\n11|const observationSchema = \"urn:ax:schema:environment-observation\"\n12|\n13|// observationSchemaVersion is the only observation version this\n14|// library accepts.\n15|const observationSchemaVersion = \"1.0.0\"\n16|\n17|// observationMembers is the exact Section 10.8.1 member set.\n18|var observationMembers = map[string]bool{\n19|\t\"schema\":                    true,\n20|\t\"schema_version\":            true,\n21|\t\"observation_id\":            true,\n22|\t\"host_id\":                   true,\n23|\t\"installation_id\":           true,\n24|\t\"environment_id\":            true,\n25|\t\"environment_version\":       true,\n26|\t\"provider_id\":               true,\n27|\t\"platform\":                  true,\n28|\t\"architecture\":              true,\n29|\t\"backend_realm_fingerprint\": true,\n30|\t\"capabilities\":              true,\n31|\t\"authentication_status\":     true,\n32|\t\"runtime_status\":            true,\n33|\t\"observed_at\":               true,\n34|\t\"extensions\":                true,\n35|}\n36|\n37|// observationRequired lists observationMembers in a fixed order so\n38|// a record missing several members always names the same one.\n39|var observationRequired = []string{\n40|\t\"schema\",\n41|\t\"schema_version\",\n42|\t\"observation_id\",\n43|\t\"host_id\",\n44|\t\"installation_id\",\n45|\t\"environment_id\",\n46|\t\"environment_version\",\n47|\t\"provider_id\",\n48|\t\"platform\",\n49|\t\"architecture\",\n50|\t\"backend_realm_fingerprint\",\n51|\t\"capabilities\",\n52|\t\"authentication_status\",\n53|\t\"runtime_status\",\n54|\t\"observed_at\",\n55|\t\"extensions\",\n56|}\n57|\n58|// capabilityOrder is the exact eight-name directory-capability\n59|// registry Section 7.9 states. The observation capabilities map\n60|// carries exactly these keys: a ninth key advertises a surface\n61|// the contract never defined, and a missing key hides one it did.\n62|// Section 10.8.1 reuses this registry rather than creating a\n63|// second capability authority.\n64|var capabilityOrder = []string{\n65|\t\"directory_discovery\",\n66|\t\"directory_incremental_scan\",\n67|\t\"directory_head_digest\",\n68|\t\"directory_tail_preview\",\n69|\t\"native_title_read\",\n70|\t\"native_runtime_observation\",\n71|\t\"existing_session_adoption\",\n72|\t\"native_resume\",\n73|}\n74|\n75|// capabilityStatuses is the closed CapabilityResult status\n76|// vocabulary. Unknown is never rewritten as unsupported, and\n77|// conditional is never advertised as available.\n78|var capabilityStatuses = []string{\n79|\t\"available\",\n80|\t\"conditional\",\n81|\t\"unavailable\",\n82|\t\"unknown\",\n83|}\n84|\n85|// validCapabilityStatus reports whether the status is a registry\n86|// member.\n87|func validCapabilityStatus(status string) bool {\n88|\tfor _, allowed := range capabilityStatuses {\n89|\t\tif status == allowed {\n90|\t\t\treturn true\n91|\t\t}\n92|\t}\n93|\treturn false\n94|}\n95|\n96|// capabilityMembers is the exact CapabilityResult member set.\n97|var capabilityMembers = map[string]bool{\n98|\t\"status\":       true,\n99|\t\"reason_code\":  true,\n100|\t\"evidence_ids\": true,\n101|\t\"observed_at\":  true,\n102|\t\"extensions\":   true,\n103|}\n104|\n105|// capabilityRequired lists capabilityMembers in a fixed order.\n106|var capabilityRequired = []string{\n107|\t\"status\",\n108|\t\"reason_code\",\n109|\t\"evidence_ids\",\n110|\t\"observed_at\",\n111|\t\"extensions\",\n112|}\n113|\n114|// authenticationStatuses is the closed authentication_status\n115|// vocabulary: status only, never credentials.\n116|var authenticationStatuses = []string{\n117|\t\"available\",\n118|\t\"missing\",\n119|\t\"expired\",\n120|\t\"unknown\",\n121|}\n122|\n123|// validAuthenticationStatus reports whether the status is a\n124|// registry member.\n125|func validAuthenticationStatus(status string) bool {\n126|\tfor _, allowed := range authenticationStatuses {\n127|\t\tif status == allowed {\n128|\t\t\treturn true\n129|\t\t}\n130|\t}\n131|\treturn false\n132|}\n133|\n134|// runtimeStatuses is the closed runtime_status vocabulary.\n135|var runtimeStatuses = []string{\n136|\t\"available\",\n137|\t\"degraded\",\n138|\t\"unavailable\",\n139|}\n140|\n141|// validRuntimeStatus reports whether the status is a registry\n142|// member.\n143|func validRuntimeStatus(status string) bool {\n144|\tfor _, allowed := range runtimeStatuses {\n145|\t\tif status == allowed {\n146|\t\t\treturn true\n147|\t\t}\n148|\t}\n149|\treturn false\n150|}\n151|\n152|// CapabilityResult is one validated directory capability result.\n153|type CapabilityResult struct {\n154|\tStatus     string\n155|\tReasonCode string\n156|\tHasReason  bool\n157|\tEvidence   []string\n158|\tObservedAt string\n159|}\n160|\n161|// Observation is one validated Environment Observation.\n162|type Observation struct {\n163|\tObservationID    string\n164|\tHostID           string\n165|\tInstallationID   string\n166|\tEnvironmentID    string\n167|\tEnvironmentVer   string\n168|\tProviderID       string\n169|\tPlatform         string\n170|\tArchitecture     string\n171|\tRealmFingerprint string\n172|\tCapabilities     map[string]CapabilityResult\n173|\tAuthentication   string\n174|\tRuntime          string\n175|\tObservedAt       string\n176|}\n177|\n178|// DecodeEnvironmentObservation validates one closed Environment\n179|// Observation: the exact schema envelope, digest and UUIDv7\n180|// identities, the environment-id grammar with\n181|// environment_version as string[1..128], the provider-id grammar\n182|// (an explicit manifest mapping, never string inference), the\n183|// platform and architecture vocabularies through the reused\n184|// Section 13.14 tuple admission model, the non-secret realm\n185|// digest, the exact eight-name capability map, the two status\n186|// vocabularies, the diagnostic timestamp, and reverse-DNS\n187|// extensions.\n188|func DecodeEnvironmentObservation(body []byte) (Observation, error) {\n189|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(body))\n190|\tif fault != nil {\n191|\t\treturn Observation{}, refuse(\"observation \"+fault.Detail, fault.Member)\n192|\t}\n193|\tif name, unknown := unknownMember(members, observationMembers); unknown {\n194|\t\treturn Observation{}, refuse(\"observation carries unknown member\", name)\n195|\t}\n196|\tif name, missing := missingMember(members, observationRequired); missing {\n197|\t\treturn Observation{}, refuse(\"observation misses a required member\", name)\n198|\t}\n199|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != observationSchema {\n200|\t\treturn Observation{}, refuse(\"observation schema is not the environment observation\", \"schema\")\n201|\t}\n202|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != observationSchemaVersion {\n203|\t\treturn Observation{}, refuse(\"observation schema version is not 1.0.0\", \"schema_version\")\n204|\t}\n205|\tobservationID, ok := CheckDigest(members[\"observation_id\"])\n206|\tif !ok {\n207|\t\treturn Observation{}, refuse(\"observation identifier is not a digest\", \"observation_id\")\n208|\t}\n209|\thostID, ok := CheckUUIDv7(members[\"host_id\"])\n210|\tif !ok {\n211|\t\treturn Observation{}, refuse(\"observation host identifier is not a UUIDv7\", \"host_id\")\n212|\t}\n213|\tinstallationID, ok := CheckDigest(members[\"installation_id\"])\n214|\tif !ok {\n215|\t\treturn Observation{}, refuse(\"observation installation identifier is not a digest\", \"installation_id\")\n216|\t}\n217|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n218|\tif !ok || !CheckEnvironmentID(environmentID) {\n219|\t\treturn Observation{}, refuse(\"observation environment identifier is not an environment-id\", \"environment_id\")\n220|\t}\n221|\tenvironmentVersion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n222|\tif !ok {\n223|\t\treturn Observation{}, refuse(\"observation environment version is not a string[1..128]\", \"environment_version\")\n224|\t}\n225|\tprovider, ok := rawString(members[\"provider_id\"])\n226|\tif !ok {\n227|\t\treturn Observation{}, refuse(\"observation provider identifier is not a string\", \"provider_id\")\n228|\t}\n229|\tproviderID, err := scalar.ParseProviderID(provider)\n230|\tif err != nil {\n231|\t\treturn Observation{}, refuse(\"observation provider identifier is not a provider-id\", \"provider_id\")\n232|\t}\n233|\tplatform, ok := rawString(members[\"platform\"])\n234|\tif !ok {\n235|\t\treturn Observation{}, refuse(\"observation platform is not a string\", \"platform\")\n236|\t}\n237|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n238|\t\treturn Observation{}, refuse(\"observation platform is outside linux|macos|windows|wsl2\", \"platform\")\n239|\t}\n240|\tarchitecture, ok := rawString(members[\"architecture\"])\n241|\tif !ok || !validTupleArchitecture(architecture) {\n242|\t\treturn Observation{}, refuse(\"observation architecture is outside amd64|arm64\", \"architecture\")\n243|\t}\n244|\trealm, ok := CheckDigest(members[\"backend_realm_fingerprint\"])\n245|\tif !ok {\n246|\t\treturn Observation{}, refuse(\"observation realm fingerprint is not a digest\", \"backend_realm_fingerprint\")\n247|\t}\n248|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n249|\tif !ok {\n250|\t\treturn Observation{}, refuse(\"observation capabilities are not the exact eight-name result map\", \"capabilities\")\n251|\t}\n252|\tauthentication, ok := rawString(members[\"authentication_status\"])\n253|\tif !ok || !validAuthenticationStatus(authentication) {\n254|\t\treturn Observation{}, refuse(\"observation authentication status is outside available|missing|expired|unknown\", \"authentication_status\")\n255|\t}\n256|\truntime, ok := rawString(members[\"runtime_status\"])\n257|\tif !ok || !validRuntimeStatus(runtime) {\n258|\t\treturn Observation{}, refuse(\"observation runtime status is outside available|degraded|unavailable\", \"runtime_status\")\n259|\t}\n260|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n261|\tif !ok {\n262|\t\treturn Observation{}, refuse(\"observation timestamp is not a timestamp\", \"observed_at\")\n263|\t}\n264|\tif !CheckExtensions(members[\"extensions\"]) {\n265|\t\treturn Observation{}, refuse(\"observation extensions are not reverse-DNS keyed\", \"extensions\")\n266|\t}\n267|\treturn Observation{\n268|\t\tObservationID:    observationID.String(),\n269|\t\tHostID:           hostID.String(),\n270|\t\tInstallationID:   installationID.String(),\n271|\t\tEnvironmentID:    environmentID,\n272|\t\tEnvironmentVer:   environmentVersion,\n273|\t\tProviderID:       providerID.String(),\n274|\t\tPlatform:         platform,\n275|\t\tArchitecture:     architecture,\n276|\t\tRealmFingerprint: realm.String(),\n277|\t\tCapabilities:     capabilities,\n278|\t\tAuthentication:   authentication,\n279|\t\tRuntime:          runtime,\n280|\t\tObservedAt:       observed.String(),\n281|\t}, nil\n282|}\n283|\n284|// checkCapabilities validates the exact eight-name capability\n285|// map: exactly the registry keys, each a closed CapabilityResult.\n286|func checkCapabilities(raw json.RawMessage) (map[string]CapabilityResult, bool) {\n287|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n288|\tif fault != nil {\n289|\t\treturn nil, false\n290|\t}\n291|\tif len(members) != len(capabilityOrder) {\n292|\t\treturn nil, false\n293|\t}\n294|\tcapabilities := make(map[string]CapabilityResult, len(capabilityOrder))\n295|\tfor _, name := range capabilityOrder {\n296|\t\tmember, present := members[name]\n297|\t\tif !present {\n298|\t\t\treturn nil, false\n299|\t\t}\n300|\t\tcapability, ok := checkCapabilityResult(member)\n301|\t\tif !ok {\n302|\t\t\treturn nil, false\n303|\t\t}\n304|\t\tcapabilities[name] = capability\n305|\t}\n306|\treturn capabilities, true\n307|}\n308|\n309|// checkCapabilityResult validates one CapabilityResult object.\n310|// Available carries a null reason and every other status carries\n311|// one: the two directions are separate obligations, so an\n312|// available-with-reason vector and a conditional-without-reason\n313|// vector are separate rows in the battery.\n314|func checkCapabilityResult(raw json.RawMessage) (CapabilityResult, bool) {\n315|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n316|\tif fault != nil {\n317|\t\treturn CapabilityResult{}, false\n318|\t}\n319|\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\n320|\t\t_ = name\n321|\t\treturn CapabilityResult{}, false\n322|\t}\n323|\tif name, missing := missingMember(members, capabilityRequired); missing {\n324|\t\t_ = name\n325|\t\treturn CapabilityResult{}, false\n326|\t}\n327|\tstatus, ok := rawString(members[\"status\"])\n328|\tif !ok || !validCapabilityStatus(status) {\n329|\t\treturn CapabilityResult{}, false\n330|\t}\n331|\treasonMember, present := members[\"reason_code\"]\n332|\tif !present {\n333|\t\treturn CapabilityResult{}, false\n334|\t}\n335|\thasReason := false\n336|\tvar reasonCode string\n337|\tif isNull(reasonMember) {\n338|\t\thasReason = false\n339|\t} else {\n340|\t\tvalue, ok := CheckStringBounds(reasonMember, 1, 128)\n341|\t\tif !ok {\n342|\t\t\treturn CapabilityResult{}, false\n343|\t\t}\n344|\t\thasReason = true\n345|\t\treasonCode = value\n346|\t}\n347|\tif status == \"available\" && hasReason {\n348|\t\treturn CapabilityResult{}, false\n349|\t}\n350|\tif status != \"available\" && !hasReason {\n351|\t\treturn CapabilityResult{}, false\n352|\t}\n353|\tevidence, ok := CheckSortedUniqueDigests(members[\"evidence_ids\"], 0, 64)\n354|\tif !ok {\n355|\t\treturn CapabilityResult{}, false\n356|\t}\n357|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n358|\tif !ok {\n359|\t\treturn CapabilityResult{}, false\n360|\t}\n361|\tif !CheckExtensions(members[\"extensions\"]) {\n362|\t\treturn CapabilityResult{}, false\n363|\t}\n364|\ttexts := make([]string, 0, len(evidence))\n365|\tfor _, digest := range evidence {\n366|\t\ttexts = append(texts, digest.String())\n367|\t}\n368|\treturn CapabilityResult{\n369|\t\tStatus:     status,\n370|\t\tReasonCode: reasonCode,\n371|\t\tHasReason:  hasReason,\n372|\t\tEvidence:   texts,\n373|\t\tObservedAt: observed.String(),\n374|\t}, true\n375|}"}}}
