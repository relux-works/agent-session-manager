{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cea3","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":1452,"recorded_at":1780531400002899,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"803ed225-eeb8-4856-a2d1-9860eed61338"},"task_id":"803ed225-eeb8-4856-a2d1-9860eed61338","event":{"kind":"output","task_id":"803ed225-eeb8-4856-a2d1-9860eed61338","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/shape_census_test.go`.\n(929 line(s) above)\n930|\t}\n931|\treturn \"\", false\n932|}\n933|\n934|// TestDelegatingWrappersCallEnviron pins the B2 fix\n935|// structurally: the sessadapter and dirnode frame decoders must\n936|// delegate to environ, and the removed raw-scan copies must not\n937|// come back. The wrapper body must reference the environ\n938|// package and must not construct a decoder, a surrogate bound,\n939|// or a rune count of its own; neither file may define the old\n940|// gate or helper names or carry surrogate range literals.\n941|func TestDelegatingWrappersCallEnviron(t *testing.T) {\n942|\troot, err := internalRoot(t)\n943|\tif err != nil {\n944|\t\tt.Fatalf(\"delegation: %v\", err)\n945|\t}\n946|\tfor _, pkg := range []string{\"sessadapter\", \"dirnode\"} {\n947|\t\tt.Run(pkg, func(t *testing.T) {\n948|\t\t\tpath := filepath.Join(root, pkg, \"decode.go\")\n949|\t\t\tsource, err := os.ReadFile(path)\n950|\t\t\tif err != nil {\n951|\t\t\t\tt.Fatalf(\"delegation: %v\", err)\n952|\t\t\t}\n953|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n954|\t\t\tif err != nil {\n955|\t\t\t\tt.Fatalf(\"delegation: %v\", err)\n956|\t\t\t}\n957|\t\t\tfoundWrapper := false\n958|\t\t\tfor _, decl := range syntax.Decls {\n959|\t\t\t\tnode, ok := decl.(*ast.FuncDecl)\n960|\t\t\t\tif !ok {\n961|\t\t\t\t\tcontinue\n962|\t\t\t\t}\n963|\t\t\t\tswitch node.Name.Name {\n964|\t\t\t\tcase \"hasLoneSurrogateEscape\", \"readUTF16Escape\", \"readUTF16EscapeAfter\":\n965|\t\t\t\t\tt.Fatalf(\"delegation: removed raw-scan copy %q is back in %s/decode.go\", node.Name.Name, pkg)\n966|\t\t\t\tcase \"decodeStrictObject\":\n967|\t\t\t\t\tfoundWrapper = true\n968|\t\t\t\t\tpinsDelegation(t, pkg, node)\n969|\t\t\t\t}\n970|\t\t\t}\n971|\t\t\tif !foundWrapper {\n972|\t\t\t\tt.Fatalf(\"delegation: decodeStrictObject missing in %s/decode.go\", pkg)\n973|\t\t\t}\n974|\t\t\tassertNoSurrogateLiterals(t, pkg, syntax)\n975|\t\t})\n976|\t}\n977|}\n978|\n979|// pinsDelegation requires the wrapper to reference environ and\n980|// to hold no decoder, gate, or measure of its own.\n981|func pinsDelegation(t *testing.T, pkg string, wrapper *ast.FuncDecl) {\n982|\tt.Helper()\n983|\treferencesEnviron := false\n984|\tast.Inspect(wrapper.Body, func(node ast.Node) bool {\n985|\t\tselector, ok := node.(*ast.SelectorExpr)\n986|\t\tif !ok {\n987|\t\t\treturn true\n988|\t\t}\n989|\t\tidentifier, ok := selector.X.(*ast.Ident)\n990|\t\tif !ok {\n991|\t\t\treturn true\n992|\t\t}\n993|\t\tif identifier.Name != \"environ\" {\n994|\t\t\treturn true\n(more lines below)"}}}
