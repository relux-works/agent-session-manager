{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43b","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":120,"recorded_at":1780531400000235,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad1f2ce7131a0dc7d3a1b7fb7b5","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/decode.go`.\n1|package environ\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"io\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// maxUint53 is the largest exactly representable JSON integer:\n17|// counts and limits are uint53 throughout the pinned\n18|// specification.\n19|const maxUint53 = uint64(1<<53 - 1)\n20|\n21|// Fault is one strict-decode failure: what was wrong and which\n22|// member it was found in, if any. It never carries foreign bytes.\n23|// The five details are the complete fault space: every body this\n24|// package refuses at the frame layer carries exactly one of them,\n25|// and the frame-agreement battery derives its denominator from\n26|// this list, so a sixth fault shape fails the census instead of\n27|// passing silently.\n28|type Fault struct {\n29|\tDetail string\n30|\tMember string\n31|}\n32|\n33|func (fault *Fault) Error() string {\n34|\tif fault.Member == \"\" {\n35|\t\treturn \"environment frame \" + fault.Detail\n36|\t}\n37|\treturn \"environment frame \" + fault.Detail + \" in member \" + fault.Member\n38|}\n39|\n40|// Frame fault details. Each is a constant so the agreement battery\n41|// derives the fault space from production source instead of\n42|// retyping it: a reworded fault fails its row rather than passing\n43|// against a stale copy.\n44|const (\n45|\tFaultNotUTF8       = \"not valid UTF-8\"\n46|\tFaultLoneSurrogate = \"lone surrogate escape\"\n47|\tFaultNotObject     = \"not a JSON object\"\n48|\tFaultDuplicate     = \"duplicate member\"\n49|\tFaultTrailing      = \"trailing data after the object\"\n50|)\n51|\n52|// DecodeStrictObject parses one complete JSON object with\n53|// duplicate member rejection. It is the only JSON entry point in\n54|// this package: every body crosses it before any member is read.\n55|// A non-UTF-8 frame, a lone surrogate escape, a non-object top\n56|// level, a duplicated member, or trailing data is a fault, never\n57|// a partial object the caller could mistake for a result.\n58|func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\n59|\tif !utf8.Valid(data) {\n60|\t\treturn nil, &Fault{Detail: FaultNotUTF8}\n61|\t}\n62|\tif HasLoneSurrogateEscape(data) {\n63|\t\treturn nil, &Fault{Detail: FaultLoneSurrogate}\n64|\t}\n65|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n66|\ttoken, err := decoder.Token()\n67|\tif err != nil {\n68|\t\treturn nil, &Fault{Detail: FaultNotObject}\n69|\t}\n70|\tdelim, ok := token.(json.Delim)\n71|\tif !ok || delim != '{' {\n72|\t\treturn nil, &Fault{Detail: FaultNotObject}\n73|\t}\n74|\tmembers := map[string]json.RawMessage{}\n75|\tfor decoder.More() {\n76|\t\tkeyToken, err := decoder.Token()\n77|\t\tif err != nil {\n78|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n79|\t\t}\n80|\t\tkey, ok := keyToken.(string)\n81|\t\tif !ok {\n82|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n83|\t\t}\n84|\t\tif _, duplicate := members[key]; duplicate {\n85|\t\t\treturn nil, &Fault{Detail: FaultDuplicate, Member: key}\n86|\t\t}\n87|\t\tvar raw json.RawMessage\n88|\t\tif err := decoder.Decode(&raw); err != nil {\n89|\t\t\treturn nil, &Fault{Detail: FaultNotObject, Member: key}\n90|\t\t}\n91|\t\tmembers[key] = raw\n92|\t}\n93|\tif token, err := decoder.Token(); err != nil {\n94|\t\treturn nil, &Fault{Detail: FaultNotObject}\n95|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n96|\t\treturn nil, &Fault{Detail: FaultNotObject}\n97|\t}\n98|\tif _, err := decoder.Token(); err != io.EOF {\n99|\t\treturn nil, &Fault{Detail: FaultTrailing}\n100|\t}\n101|\treturn members, nil\n102|}\n103|\n104|// HasLoneSurrogateEscape reports whether the raw frame carries a\n105|// UTF-16 escape the JSON string grammar cannot pair. Go's\n106|// encoding/json would otherwise replace the lone escape with\n107|// U+FFFD silently, so wire bodies carrying lone surrogates would\n108|// be admitted with rewritten bytes.\n109|//\n110|// The walk is string-aware: only escapes inside JSON strings\n111|// count, and a backslash escape consumes both bytes, so the text\n112|// \"\\\\ud800\" (backslash-plus-text, JSON source `\"\\\\ud800\"`) is\n113|// not an escape and is admitted at the frame gate. A scanner\n114|// that matches every `\\u` byte pair regardless of string context\n115|// refuses that text, and worse, misreads it as a high surrogate\n116|// paired with a following real escape — admitting a real lone\n117|// escape the string walk refuses. The sessadapter and dirnode\n118|// facades once carried that raw scan and diverged in both\n119|// directions; they now delegate their frame verdict to\n120|// DecodeStrictObject, and the frame-agreement battery proves\n121|// both directions with run-parity rows plus even-run-plus-real-\n122|// escape compositions, so any change to this walk fails there in\n123|// either direction.\n124|func HasLoneSurrogateEscape(data []byte) bool {\n125|\tfor index := 0; index < len(data); index++ {\n126|\t\tif data[index] != '\"' {\n127|\t\t\tcontinue\n128|\t\t}\n129|\t\tfor index++; index < len(data); index++ {\n130|\t\t\tswitch data[index] {\n131|\t\t\tcase '\"':\n132|\t\t\t\tgoto stringComplete\n133|\t\t\tcase '\\\\':\n134|\t\t\t\tindex++\n135|\t\t\t\tif index >= len(data) || data[index] != 'u' {\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tunit, end, ok := readUTF16Escape(data, index-1)\n139|\t\t\t\tif !ok {\n140|\t\t\t\t\t// Not a well-formed \\uXXXX escape: the\n141|\t\t\t\t\t// JSON-syntax arms own it, not this gate.\n142|\t\t\t\t\tcontinue\n143|\t\t\t\t}\n144|\t\t\t\tindex = end - 1\n145|\t\t\t\tswitch {\n146|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n147|\t\t\t\t\tsecond, _, ok := readUTF16Escape(data, end)\n148|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n149|\t\t\t\t\t\treturn true\n150|\t\t\t\t\t}\n151|\t\t\t\t\tindex = end + 6 - 1\n152|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n153|\t\t\t\t\treturn true\n154|\t\t\t\t}\n155|\t\t\t}\n156|\t\t}\n157|\t\t// An unterminated string owns no surrogate verdict: the\n158|\t\t// frame is not JSON at all, so the syntax arms refuse it\n159|\t\t// as not-a-JSON-object rather than misattributing it\n160|\t\t// here.\n161|\t\treturn false\n162|\tstringComplete:\n163|\t}\n164|\treturn false\n165|}\n166|\n167|// readUTF16Escape reads one \\uXXXX escape starting at the offset.\n168|// It reports the unit value and the offset just past the escape,\n169|// or false when the escape is truncated or not hexadecimal.\n170|func readUTF16Escape(data []byte, offset int) (uint16, int, bool) {\n171|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n172|\t\treturn 0, offset, false\n173|\t}\n174|\tvalue, err := strconv.ParseUint(string(data[offset+2:offset+6]), 16, 16)\n175|\tif err != nil {\n176|\t\treturn 0, offset, false\n177|\t}\n178|\treturn uint16(value), offset + 6, true\n179|}\n180|\n181|// unknownMember names a member outside the closed set, if any.\n182|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n183|\tfor name := range members {\n184|\t\tif !allowed[name] {\n185|\t\t\treturn name, true\n186|\t\t}\n187|\t}\n188|\treturn \"\", false\n189|}\n190|\n191|// missingMember names the first required member with no value, if\n192|// any. The required list is fixed order, so the verdict is\n193|// deterministic for every missing combination.\n194|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n195|\tfor _, name := range required {\n196|\t\tif _, present := members[name]; !present {\n197|\t\t\treturn name, true\n198|\t\t}\n199|\t}\n200|\treturn \"\", false\n201|}\n202|\n203|// rawString reads a JSON string member.\n204|func rawString(raw json.RawMessage) (string, bool) {\n205|\tvar value string\n206|\tif err := json.Unmarshal(raw, &value); err != nil {\n207|\t\treturn \"\", false\n208|\t}\n209|\treturn value, true\n210|}\n211|\n212|// rawUint53 reads an unsigned integral JSON number in [0,\n213|// 2^53-1]. A fraction, exponent, sign, or out-of-range magnitude\n214|// is not a uint53, even when it names the same mathematical\n215|// value: the bodies carry counts, never measurements.\n216|func rawUint53(raw json.RawMessage) (uint64, bool) {\n217|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n218|\tdecoder.UseNumber()\n219|\tvar value any\n220|\tif err := decoder.Decode(&value); err != nil {\n221|\t\treturn 0, false\n222|\t}\n223|\t// Decode reads one value and stops: without the trailing\n224|\t// check a hostile slice like `12a` would read as 12. Member\n225|\t// slices arriving through DecodeStrictObject can never carry\n226|\t// trailing data, but this entry takes raw slices and must\n227|\t// not trust them.\n228|\tif _, err := decoder.Token(); err != io.EOF {\n229|\t\treturn 0, false\n230|\t}\n231|\tnumber, ok := value.(json.Number)\n232|\tif !ok {\n233|\t\treturn 0, false\n234|\t}\n235|\tliteral := number.String()\n236|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n237|\t\treturn 0, false\n238|\t}\n239|\treturn parseUint53Literal(literal)\n240|}\n241|\n242|// parseUint53Literal reads a digit-only literal without trusting\n243|// a float conversion: the magnitude bound is checked on the digit\n244|// string, so 2^53 is refused even on platforms that could hold\n245|// it.\n246|func parseUint53Literal(literal string) (uint64, bool) {\n247|\tvar value uint64\n248|\tfor index := 0; index < len(literal); index++ {\n249|\t\tdigit := literal[index]\n250|\t\tif digit < '0' || digit > '9' {\n251|\t\t\treturn 0, false\n252|\t\t}\n253|\t\tvalue = value*10 + uint64(digit-'0')\n254|\t\tif value > maxUint53 {\n255|\t\t\treturn 0, false\n256|\t\t}\n257|\t}\n258|\treturn value, true\n259|}\n260|\n261|// StringLength is the Section 1.6 string measure in characters,\n262|// not bytes: a bound of string[1..128] admits 128 characters of\n263|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n264|// env literals, Section 5.1) do not go through here; the measure\n265|// battery ledgers that split.\n266|func StringLength(value string) int {\n267|\treturn utf8.RuneCountInString(value)\n268|}\n269|\n270|// CheckStringBounds reports whether the member is a JSON string\n271|// whose character count falls in the inclusive bound.\n272|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n273|\tvalue, ok := rawString(raw)\n274|\tif !ok {\n275|\t\treturn \"\", false\n276|\t}\n277|\tlength := StringLength(value)\n278|\tif length < minimum || length > maximum {\n279|\t\treturn \"\", false\n280|\t}\n281|\treturn value, true\n282|}\n283|\n284|// CheckUint53Bounds reports whether the member is a uint53 in the\n285|// inclusive bound. Both edges are checked: a one-sided check\n286|// would admit the open side.\n287|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n288|\tvalue, ok := rawUint53(raw)\n289|\tif !ok {\n290|\t\treturn 0, false\n291|\t}\n292|\tif value < minimum || value > maximum {\n293|\t\treturn 0, false\n294|\t}\n295|\treturn value, true\n296|}\n297|\n298|// CheckDigest reports whether the member is a digest of the\n299|// pinned sha256 form.\n300|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n301|\tvalue, ok := rawString(raw)\n302|\tif !ok {\n303|\t\treturn scalar.Digest{}, false\n304|\t}\n305|\tdigest, err := scalar.ParseDigest(value)\n306|\tif err != nil {\n307|\t\treturn scalar.Digest{}, false\n308|\t}\n309|\treturn digest, true\n310|}\n311|\n312|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n313|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n314|\tvalue, ok := rawString(raw)\n315|\tif !ok {\n316|\t\treturn scalar.UUIDv7{}, false\n317|\t}\n318|\tidentifier, err := scalar.ParseUUIDv7(value)\n319|\tif err != nil {\n320|\t\treturn scalar.UUIDv7{}, false\n321|\t}\n322|\treturn identifier, true\n323|}\n324|\n325|// CheckTimestamp reports whether the member is a pinned\n326|// timestamp.\n327|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n328|\tvalue, ok := rawString(raw)\n329|\tif !ok {\n330|\t\treturn scalar.Timestamp{}, false\n331|\t}\n332|\tinstant, err := scalar.ParseTimestamp(value)\n333|\tif err != nil {\n334|\t\treturn scalar.Timestamp{}, false\n335|\t}\n336|\treturn instant, true\n337|}\n338|\n339|// isNull reports whether the member is an explicit JSON null.\n340|func isNull(raw json.RawMessage) bool {\n341|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n342|}\n343|\n344|func bytesTrimSpace(raw json.RawMessage) []byte {\n345|\treturn bytes.TrimSpace(raw)\n346|}\n347|\n348|// reverseDNSPattern is the extensions-key grammar: at least two\n349|// dot-separated labels, each starting with a lowercase letter.\n350|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n351|\n352|// CheckExtensions reports whether the member is an object whose\n353|// every key is reverse-DNS. Extensions never add operations,\n354|// capabilities, or trust facts; the key grammar is the part of\n355|// that rule decidable from one body.\n356|func CheckExtensions(raw json.RawMessage) bool {\n357|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n358|\tif fault != nil {\n359|\t\treturn false\n360|\t}\n361|\tfor name := range members {\n362|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n363|\t\t\treturn false\n364|\t\t}\n365|\t}\n366|\treturn true\n367|}\n368|\n369|// decodeArray reads a JSON array member into its raw elements. A\n370|// non-array — including null — is not an empty array.\n371|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n372|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n373|\ttoken, err := decoder.Token()\n374|\tif err != nil {\n375|\t\treturn nil, false\n376|\t}\n377|\tdelim, ok := token.(json.Delim)\n378|\tif !ok || delim != '[' {\n379|\t\treturn nil, false\n380|\t}\n381|\tvar elements []json.RawMessage\n382|\tfor decoder.More() {\n383|\t\tvar element json.RawMessage\n384|\t\tif err := decoder.Decode(&element); err != nil {\n385|\t\t\treturn nil, false\n386|\t\t}\n387|\t\telements = append(elements, element)\n388|\t}\n389|\tif token, err := decoder.Token(); err != nil {\n390|\t\treturn nil, false\n391|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n392|\t\treturn nil, false\n393|\t}\n394|\tif _, err := decoder.Token(); err != io.EOF {\n395|\t\treturn nil, false\n396|\t}\n397|\treturn elements, true\n398|}\n399|\n400|// CheckSortedUniqueStrings reports whether the member is an array\n401|// of strings in the item bound whose JCS encodings order strictly\n402|// increasingly with no duplicates. Bytewise JCS order over\n403|// strings is plain lexicographic order, so the check compares\n404|// directly; the count bound is checked on both edges.\n405|//\n406|// Ordering and uniqueness are two obligations, not one: an\n407|// unsorted-but-unique vector and a sorted-but-duplicated vector\n408|// are separate rows in this package's sorted-strings battery\n409|// (TestCheckSortedUniqueStringsHalves drives this function\n410|// directly), so a check that enforced only one half could not\n411|// pass both. The observation battery covers the digest twin,\n412|// not this function.\n413|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n414|\telements, ok := decodeArray(raw)\n415|\tif !ok {\n416|\t\treturn nil, false\n417|\t}\n418|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n419|\t\treturn nil, false\n420|\t}\n421|\tvalues := make([]string, 0, len(elements))\n422|\tfor _, element := range elements {\n423|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n424|\t\tif !ok {\n425|\t\t\treturn nil, false\n426|\t\t}\n427|\t\tvalues = append(values, value)\n428|\t}\n429|\tfor index := 1; index < len(values); index++ {\n430|\t\tif values[index-1] >= values[index] {\n431|\t\t\treturn nil, false\n432|\t\t}\n433|\t}\n434|\treturn values, true\n435|}\n436|\n437|// CheckSortedUniqueDigests reports whether the member is an array\n438|// of digests in the count bound, ordered strictly increasingly\n439|// with no duplicates.\n440|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n441|\telements, ok := decodeArray(raw)\n442|\tif !ok {\n443|\t\treturn nil, false\n444|\t}\n445|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n446|\t\treturn nil, false\n447|\t}\n448|\tvalues := make([]scalar.Digest, 0, len(elements))\n449|\tfor _, element := range elements {\n450|\t\tdigest, ok := CheckDigest(element)\n451|\t\tif !ok {\n452|\t\t\treturn nil, false\n453|\t\t}\n454|\t\tvalues = append(values, digest)\n455|\t}\n456|\tfor index := 1; index < len(values); index++ {\n457|\t\tif values[index-1].String() >= values[index].String() {\n458|\t\t\treturn nil, false\n459|\t\t}\n460|\t}\n461|\treturn values, true\n462|}\n463|\n464|// refuse builds the package error for one refused member: the\n465|// rule in human text automation must never branch on, naming the\n466|// member. Tests assert the full text, so a reworded rule fails\n467|// its row instead of passing against a stale copy.\n468|func refuse(rule, member string) error {\n469|\tif member == \"\" {\n470|\t\treturn fmt.Errorf(\"environment %s\", rule)\n471|\t}\n472|\treturn fmt.Errorf(\"environment %s: %s\", rule, member)\n473|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43d","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":121,"recorded_at":1780531400000237,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad1f3db7c138dc7882f910ea3ef","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/tuple.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// environmentIDPattern is the Section 7.8 environment-id grammar:\n11|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n12|// identifier; it is never inferred by spelling.\n13|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n14|\n15|// CheckEnvironmentID reports whether the value is an\n16|// environment-id.\n17|func CheckEnvironmentID(value string) bool {\n18|\treturn environmentIDPattern.MatchString(value)\n19|}\n20|\n21|// semverPattern is the SemVer grammar adapter and environment\n22|// versions satisfy: three dot-separated numeric parts with\n23|// optional pre-release and build metadata.\n24|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n25|\n26|// CheckSemver reports whether the value is a SemVer string.\n27|func CheckSemver(value string) bool {\n28|\treturn semverPattern.MatchString(value)\n29|}\n30|\n31|// tupleArchitectures is the closed tuple architecture vocabulary\n32|// Section 7.8 states. Membership is a table loop so the census\n33|// derives it like every other closed vocabulary: an inline chain\n34|// here would be invisible to the census, and a widened chain\n35|// would silently admit a third architecture.\n36|var tupleArchitectures = []string{\n37|\t\"amd64\",\n38|\t\"arm64\",\n39|}\n40|\n41|// validTupleArchitecture reports whether the name is one of the\n42|// two tuple architectures.\n43|func validTupleArchitecture(architecture string) bool {\n44|\tfor _, allowed := range tupleArchitectures {\n45|\t\tif architecture == allowed {\n46|\t\t\treturn true\n47|\t\t}\n48|\t}\n49|\treturn false\n50|}\n51|\n52|// tupleMembers is the exact Environment Tuple member set Sections\n53|// 7.8 and 13.14 require: environment_id, environment_version,\n54|// platform, architecture, store_schema_fingerprint, and\n55|// adapter_version. The tuple never contains executable provenance,\n56|// and — unlike every neighbouring closed type — it carries no\n57|// extensions member, so even a reverse-DNS extensions object is\n58|// refused here.\n59|var tupleMembers = map[string]bool{\n60|\t\"environment_id\":           true,\n61|\t\"environment_version\":      true,\n62|\t\"platform\":                 true,\n63|\t\"architecture\":             true,\n64|\t\"store_schema_fingerprint\": true,\n65|\t\"adapter_version\":          true,\n66|}\n67|\n68|// tupleRequired lists tupleMembers in a fixed order.\n69|var tupleRequired = []string{\n70|\t\"environment_id\",\n71|\t\"environment_version\",\n72|\t\"platform\",\n73|\t\"architecture\",\n74|\t\"store_schema_fingerprint\",\n75|\t\"adapter_version\",\n76|}\n77|\n78|// Tuple is one validated Environment Tuple.\n79|type Tuple struct {\n80|\tEnvironmentID    string\n81|\tVersion          string\n82|\tPlatform         string\n83|\tArchitecture     string\n84|\tStoreFingerprint string\n85|\tAdapterVersion   string\n86|}\n87|\n88|// DecodeTuple validates one closed Environment Tuple: exact\n89|// members, the environment-id grammar, environment_version as\n90|// string[1..128] (the bound Section 10.8.1 states for the\n91|// observation that reuses this admission model), the closed\n92|// platform and architecture vocabularies, a digest store\n93|// fingerprint, and a SemVer adapter version. Any executable\n94|// provenance member is an unknown member, never a second\n95|// identity.\n96|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n97|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n98|\tif fault != nil {\n99|\t\treturn Tuple{}, refuse(\"tuple \"+fault.Detail, fault.Member)\n100|\t}\n101|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n102|\t\treturn Tuple{}, refuse(\"tuple carries unknown member\", name)\n103|\t}\n104|\tif name, missing := missingMember(members, tupleRequired); missing {\n105|\t\treturn Tuple{}, refuse(\"tuple misses a required member\", name)\n106|\t}\n107|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n108|\tif !ok || !CheckEnvironmentID(environmentID) {\n109|\t\treturn Tuple{}, refuse(\"tuple environment identifier is not an environment-id\", \"environment_id\")\n110|\t}\n111|\tversion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n112|\tif !ok {\n113|\t\treturn Tuple{}, refuse(\"tuple environment version is not a string[1..128]\", \"environment_version\")\n114|\t}\n115|\tplatform, ok := rawString(members[\"platform\"])\n116|\tif !ok {\n117|\t\treturn Tuple{}, refuse(\"tuple platform is not a string\", \"platform\")\n118|\t}\n119|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n120|\t\treturn Tuple{}, refuse(\"tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n121|\t}\n122|\tarchitecture, ok := rawString(members[\"architecture\"])\n123|\tif !ok || !validTupleArchitecture(architecture) {\n124|\t\treturn Tuple{}, refuse(\"tuple architecture is outside amd64|arm64\", \"architecture\")\n125|\t}\n126|\tfingerprint, ok := CheckDigest(members[\"store_schema_fingerprint\"])\n127|\tif !ok {\n128|\t\treturn Tuple{}, refuse(\"tuple store fingerprint is not a digest\", \"store_schema_fingerprint\")\n129|\t}\n130|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n131|\tif !ok || !CheckSemver(adapterVersion) {\n132|\t\treturn Tuple{}, refuse(\"tuple adapter version is not SemVer\", \"adapter_version\")\n133|\t}\n134|\treturn Tuple{\n135|\t\tEnvironmentID:    environmentID,\n136|\t\tVersion:          version,\n137|\t\tPlatform:         platform,\n138|\t\tArchitecture:     architecture,\n139|\t\tStoreFingerprint: fingerprint.String(),\n140|\t\tAdapterVersion:   adapterVersion,\n141|\t}, nil\n142|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43f","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":122,"recorded_at":1780531400000239,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad1f4eb74f389d7ca9ce5b804d4","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/doc.go`.\n1|// Package environ is the single environment library behind the\n2|// Provider, Session Adapter, and Directory Node facades.\n3|//\n4|// Pinned specification v0.5.0 requires the Directory Node facade to\n5|// expose source-local environment discovery \"through the same\n6|// parsers, identity logic, redaction rules, tuple gates, and\n7|// fixtures as the Provider and Session Adapter facades\" (Section\n8|// 3.1), backed by \"the same environment implementation as Provider\n9|// 2 and Session Adapter 1\" (Sections 7.9, 10.8, 13.14). Before this\n10|// package each facade carried its own copy of those rules, and\n11|// independent copies of the same rule drift in ways no per-facade\n12|// reviewer can see. This package is the one implementation every\n13|// facade must converge on:\n14|//\n15|//   - frame parsing: DecodeStrictObject is the only JSON entry\n16|//     point, with duplicate-member rejection and the Section 1.6\n17|//     lone-surrogate gate in canonical string-walk semantics;\n18|//   - string measure: CheckStringBounds counts Unicode characters\n19|//     (runes), never bytes and never UTF-16 code units;\n20|//   - shared grammars: the environment-id, provider-id (via\n21|//     scalar), SemVer, platform, and architecture rules;\n22|//   - tuple gates: DecodeTuple admits the exact six-member\n23|//     Environment Tuple of Sections 7.8 and 13.14, which never\n24|//     carries executable provenance or extensions;\n25|//   - observation gates: DecodeEnvironmentObservation admits the\n26|//     Section 10.8.1 Environment Observation, reusing the tuple\n27|//     admission model rather than creating a second one.\n28|//\n29|// Every refusal is a plain error whose text names the rule and the\n30|// member: facades keep their own refusal dialects (Structured\n31|// Error codes per protocol), so this package names rules instead\n32|// of minting codes, and the boundary battery pins each facade's\n33|// rendering separately.\n34|//\n35|// Stated bounds. Provider Identity refusal dialects stay in\n36|// provhost and canonicaljson: the two validators must agree\n37|// rule-for-rule and the agreement battery in this package pins\n38|// that, but a third validator here would be another copy, not\n39|// convergence. Byte-counted exec rules (Provider SpawnPlan argv\n40|// and env literals, Section 5.1) stay in provhost: they bound\n41|// bytes by specification while every character-bound member in\n42|// this story counts runes, and the measure battery ledgers that\n43|// split. The tuple-registry signature, sequence monotonicity, and\n44|// publication rules of Section 13.14 fail closed at the registry\n45|// owner, which does not exist yet. This package mutates no durable\n46|// state and keeps no cache: every entry point is a pure function\n47|// of its input bytes.\n48|package environ","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c441","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":123,"recorded_at":1780531400000241,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad1f5ef7ff2b16826cb10d2b17f","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/observation.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// observationSchema is the exact schema identifier the\n10|// Environment Observation carries.\n11|const observationSchema = \"urn:ax:schema:environment-observation\"\n12|\n13|// observationSchemaVersion is the only observation version this\n14|// library accepts.\n15|const observationSchemaVersion = \"1.0.0\"\n16|\n17|// observationMembers is the exact Section 10.8.1 member set.\n18|var observationMembers = map[string]bool{\n19|\t\"schema\":                    true,\n20|\t\"schema_version\":            true,\n21|\t\"observation_id\":            true,\n22|\t\"host_id\":                   true,\n23|\t\"installation_id\":           true,\n24|\t\"environment_id\":            true,\n25|\t\"environment_version\":       true,\n26|\t\"provider_id\":               true,\n27|\t\"platform\":                  true,\n28|\t\"architecture\":              true,\n29|\t\"backend_realm_fingerprint\": true,\n30|\t\"capabilities\":              true,\n31|\t\"authentication_status\":     true,\n32|\t\"runtime_status\":            true,\n33|\t\"observed_at\":               true,\n34|\t\"extensions\":                true,\n35|}\n36|\n37|// observationRequired lists observationMembers in a fixed order so\n38|// a record missing several members always names the same one.\n39|var observationRequired = []string{\n40|\t\"schema\",\n41|\t\"schema_version\",\n42|\t\"observation_id\",\n43|\t\"host_id\",\n44|\t\"installation_id\",\n45|\t\"environment_id\",\n46|\t\"environment_version\",\n47|\t\"provider_id\",\n48|\t\"platform\",\n49|\t\"architecture\",\n50|\t\"backend_realm_fingerprint\",\n51|\t\"capabilities\",\n52|\t\"authentication_status\",\n53|\t\"runtime_status\",\n54|\t\"observed_at\",\n55|\t\"extensions\",\n56|}\n57|\n58|// capabilityOrder is the exact eight-name directory-capability\n59|// registry Section 7.9 states. The observation capabilities map\n60|// carries exactly these keys: a ninth key advertises a surface\n61|// the contract never defined, and a missing key hides one it did.\n62|// Section 10.8.1 reuses this registry rather than creating a\n63|// second capability authority.\n64|var capabilityOrder = []string{\n65|\t\"directory_discovery\",\n66|\t\"directory_incremental_scan\",\n67|\t\"directory_head_digest\",\n68|\t\"directory_tail_preview\",\n69|\t\"native_title_read\",\n70|\t\"native_runtime_observation\",\n71|\t\"existing_session_adoption\",\n72|\t\"native_resume\",\n73|}\n74|\n75|// capabilityStatuses is the closed CapabilityResult status\n76|// vocabulary. Unknown is never rewritten as unsupported, and\n77|// conditional is never advertised as available.\n78|var capabilityStatuses = []string{\n79|\t\"available\",\n80|\t\"conditional\",\n81|\t\"unavailable\",\n82|\t\"unknown\",\n83|}\n84|\n85|// validCapabilityStatus reports whether the status is a registry\n86|// member.\n87|func validCapabilityStatus(status string) bool {\n88|\tfor _, allowed := range capabilityStatuses {\n89|\t\tif status == allowed {\n90|\t\t\treturn true\n91|\t\t}\n92|\t}\n93|\treturn false\n94|}\n95|\n96|// capabilityMembers is the exact CapabilityResult member set.\n97|var capabilityMembers = map[string]bool{\n98|\t\"status\":       true,\n99|\t\"reason_code\":  true,\n100|\t\"evidence_ids\": true,\n101|\t\"observed_at\":  true,\n102|\t\"extensions\":   true,\n103|}\n104|\n105|// capabilityRequired lists capabilityMembers in a fixed order.\n106|var capabilityRequired = []string{\n107|\t\"status\",\n108|\t\"reason_code\",\n109|\t\"evidence_ids\",\n110|\t\"observed_at\",\n111|\t\"extensions\",\n112|}\n113|\n114|// authenticationStatuses is the closed authentication_status\n115|// vocabulary: status only, never credentials.\n116|var authenticationStatuses = []string{\n117|\t\"available\",\n118|\t\"missing\",\n119|\t\"expired\",\n120|\t\"unknown\",\n121|}\n122|\n123|// validAuthenticationStatus reports whether the status is a\n124|// registry member.\n125|func validAuthenticationStatus(status string) bool {\n126|\tfor _, allowed := range authenticationStatuses {\n127|\t\tif status == allowed {\n128|\t\t\treturn true\n129|\t\t}\n130|\t}\n131|\treturn false\n132|}\n133|\n134|// runtimeStatuses is the closed runtime_status vocabulary.\n135|var runtimeStatuses = []string{\n136|\t\"available\",\n137|\t\"degraded\",\n138|\t\"unavailable\",\n139|}\n140|\n141|// validRuntimeStatus reports whether the status is a registry\n142|// member.\n143|func validRuntimeStatus(status string) bool {\n144|\tfor _, allowed := range runtimeStatuses {\n145|\t\tif status == allowed {\n146|\t\t\treturn true\n147|\t\t}\n148|\t}\n149|\treturn false\n150|}\n151|\n152|// CapabilityResult is one validated directory capability result.\n153|type CapabilityResult struct {\n154|\tStatus     string\n155|\tReasonCode string\n156|\tHasReason  bool\n157|\tEvidence   []string\n158|\tObservedAt string\n159|}\n160|\n161|// Observation is one validated Environment Observation.\n162|type Observation struct {\n163|\tObservationID    string\n164|\tHostID           string\n165|\tInstallationID   string\n166|\tEnvironmentID    string\n167|\tEnvironmentVer   string\n168|\tProviderID       string\n169|\tPlatform         string\n170|\tArchitecture     string\n171|\tRealmFingerprint string\n172|\tCapabilities     map[string]CapabilityResult\n173|\tAuthentication   string\n174|\tRuntime          string\n175|\tObservedAt       string\n176|}\n177|\n178|// DecodeEnvironmentObservation validates one closed Environment\n179|// Observation: the exact schema envelope, digest and UUIDv7\n180|// identities, the environment-id grammar with\n181|// environment_version as string[1..128], the provider-id grammar\n182|// (an explicit manifest mapping, never string inference), the\n183|// platform and architecture vocabularies through the reused\n184|// Section 13.14 tuple admission model, the non-secret realm\n185|// digest, the exact eight-name capability map, the two status\n186|// vocabularies, the diagnostic timestamp, and reverse-DNS\n187|// extensions.\n188|func DecodeEnvironmentObservation(body []byte) (Observation, error) {\n189|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(body))\n190|\tif fault != nil {\n191|\t\treturn Observation{}, refuse(\"observation \"+fault.Detail, fault.Member)\n192|\t}\n193|\tif name, unknown := unknownMember(members, observationMembers); unknown {\n194|\t\treturn Observation{}, refuse(\"observation carries unknown member\", name)\n195|\t}\n196|\tif name, missing := missingMember(members, observationRequired); missing {\n197|\t\treturn Observation{}, refuse(\"observation misses a required member\", name)\n198|\t}\n199|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != observationSchema {\n200|\t\treturn Observation{}, refuse(\"observation schema is not the environment observation\", \"schema\")\n201|\t}\n202|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != observationSchemaVersion {\n203|\t\treturn Observation{}, refuse(\"observation schema version is not 1.0.0\", \"schema_version\")\n204|\t}\n205|\tobservationID, ok := CheckDigest(members[\"observation_id\"])\n206|\tif !ok {\n207|\t\treturn Observation{}, refuse(\"observation identifier is not a digest\", \"observation_id\")\n208|\t}\n209|\thostID, ok := CheckUUIDv7(members[\"host_id\"])\n210|\tif !ok {\n211|\t\treturn Observation{}, refuse(\"observation host identifier is not a UUIDv7\", \"host_id\")\n212|\t}\n213|\tinstallationID, ok := CheckDigest(members[\"installation_id\"])\n214|\tif !ok {\n215|\t\treturn Observation{}, refuse(\"observation installation identifier is not a digest\", \"installation_id\")\n216|\t}\n217|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n218|\tif !ok || !CheckEnvironmentID(environmentID) {\n219|\t\treturn Observation{}, refuse(\"observation environment identifier is not an environment-id\", \"environment_id\")\n220|\t}\n221|\tenvironmentVersion, ok := CheckStringBounds(members[\"environment_version\"], 1, 128)\n222|\tif !ok {\n223|\t\treturn Observation{}, refuse(\"observation environment version is not a string[1..128]\", \"environment_version\")\n224|\t}\n225|\tprovider, ok := rawString(members[\"provider_id\"])\n226|\tif !ok {\n227|\t\treturn Observation{}, refuse(\"observation provider identifier is not a string\", \"provider_id\")\n228|\t}\n229|\tproviderID, err := scalar.ParseProviderID(provider)\n230|\tif err != nil {\n231|\t\treturn Observation{}, refuse(\"observation provider identifier is not a provider-id\", \"provider_id\")\n232|\t}\n233|\tplatform, ok := rawString(members[\"platform\"])\n234|\tif !ok {\n235|\t\treturn Observation{}, refuse(\"observation platform is not a string\", \"platform\")\n236|\t}\n237|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n238|\t\treturn Observation{}, refuse(\"observation platform is outside linux|macos|windows|wsl2\", \"platform\")\n239|\t}\n240|\tarchitecture, ok := rawString(members[\"architecture\"])\n241|\tif !ok || !validTupleArchitecture(architecture) {\n242|\t\treturn Observation{}, refuse(\"observation architecture is outside amd64|arm64\", \"architecture\")\n243|\t}\n244|\trealm, ok := CheckDigest(members[\"backend_realm_fingerprint\"])\n245|\tif !ok {\n246|\t\treturn Observation{}, refuse(\"observation realm fingerprint is not a digest\", \"backend_realm_fingerprint\")\n247|\t}\n248|\tcapabilities, ok := checkCapabilities(members[\"capabilities\"])\n249|\tif !ok {\n250|\t\treturn Observation{}, refuse(\"observation capabilities are not the exact eight-name result map\", \"capabilities\")\n251|\t}\n252|\tauthentication, ok := rawString(members[\"authentication_status\"])\n253|\tif !ok || !validAuthenticationStatus(authentication) {\n254|\t\treturn Observation{}, refuse(\"observation authentication status is outside available|missing|expired|unknown\", \"authentication_status\")\n255|\t}\n256|\truntime, ok := rawString(members[\"runtime_status\"])\n257|\tif !ok || !validRuntimeStatus(runtime) {\n258|\t\treturn Observation{}, refuse(\"observation runtime status is outside available|degraded|unavailable\", \"runtime_status\")\n259|\t}\n260|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n261|\tif !ok {\n262|\t\treturn Observation{}, refuse(\"observation timestamp is not a timestamp\", \"observed_at\")\n263|\t}\n264|\tif !CheckExtensions(members[\"extensions\"]) {\n265|\t\treturn Observation{}, refuse(\"observation extensions are not reverse-DNS keyed\", \"extensions\")\n266|\t}\n267|\treturn Observation{\n268|\t\tObservationID:    observationID.String(),\n269|\t\tHostID:           hostID.String(),\n270|\t\tInstallationID:   installationID.String(),\n271|\t\tEnvironmentID:    environmentID,\n272|\t\tEnvironmentVer:   environmentVersion,\n273|\t\tProviderID:       providerID.String(),\n274|\t\tPlatform:         platform,\n275|\t\tArchitecture:     architecture,\n276|\t\tRealmFingerprint: realm.String(),\n277|\t\tCapabilities:     capabilities,\n278|\t\tAuthentication:   authentication,\n279|\t\tRuntime:          runtime,\n280|\t\tObservedAt:       observed.String(),\n281|\t}, nil\n282|}\n283|\n284|// checkCapabilities validates the exact eight-name capability\n285|// map: exactly the registry keys, each a closed CapabilityResult.\n286|func checkCapabilities(raw json.RawMessage) (map[string]CapabilityResult, bool) {\n287|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n288|\tif fault != nil {\n289|\t\treturn nil, false\n290|\t}\n291|\tif len(members) != len(capabilityOrder) {\n292|\t\treturn nil, false\n293|\t}\n294|\tcapabilities := make(map[string]CapabilityResult, len(capabilityOrder))\n295|\tfor _, name := range capabilityOrder {\n296|\t\tmember, present := members[name]\n297|\t\tif !present {\n298|\t\t\treturn nil, false\n299|\t\t}\n300|\t\tcapability, ok := checkCapabilityResult(member)\n301|\t\tif !ok {\n302|\t\t\treturn nil, false\n303|\t\t}\n304|\t\tcapabilities[name] = capability\n305|\t}\n306|\treturn capabilities, true\n307|}\n308|\n309|// checkCapabilityResult validates one CapabilityResult object.\n310|// Available carries a null reason and every other status carries\n311|// one: the two directions are separate obligations, so an\n312|// available-with-reason vector and a conditional-without-reason\n313|// vector are separate rows in the battery.\n314|func checkCapabilityResult(raw json.RawMessage) (CapabilityResult, bool) {\n315|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n316|\tif fault != nil {\n317|\t\treturn CapabilityResult{}, false\n318|\t}\n319|\tif name, unknown := unknownMember(members, capabilityMembers); unknown {\n320|\t\t_ = name\n321|\t\treturn CapabilityResult{}, false\n322|\t}\n323|\tif name, missing := missingMember(members, capabilityRequired); missing {\n324|\t\t_ = name\n325|\t\treturn CapabilityResult{}, false\n326|\t}\n327|\tstatus, ok := rawString(members[\"status\"])\n328|\tif !ok || !validCapabilityStatus(status) {\n329|\t\treturn CapabilityResult{}, false\n330|\t}\n331|\treasonMember, present := members[\"reason_code\"]\n332|\tif !present {\n333|\t\treturn CapabilityResult{}, false\n334|\t}\n335|\thasReason := false\n336|\tvar reasonCode string\n337|\tif isNull(reasonMember) {\n338|\t\thasReason = false\n339|\t} else {\n340|\t\tvalue, ok := CheckStringBounds(reasonMember, 1, 128)\n341|\t\tif !ok {\n342|\t\t\treturn CapabilityResult{}, false\n343|\t\t}\n344|\t\thasReason = true\n345|\t\treasonCode = value\n346|\t}\n347|\tif status == \"available\" && hasReason {\n348|\t\treturn CapabilityResult{}, false\n349|\t}\n350|\tif status != \"available\" && !hasReason {\n351|\t\treturn CapabilityResult{}, false\n352|\t}\n353|\tevidence, ok := CheckSortedUniqueDigests(members[\"evidence_ids\"], 0, 64)\n354|\tif !ok {\n355|\t\treturn CapabilityResult{}, false\n356|\t}\n357|\tobserved, ok := CheckTimestamp(members[\"observed_at\"])\n358|\tif !ok {\n359|\t\treturn CapabilityResult{}, false\n360|\t}\n361|\tif !CheckExtensions(members[\"extensions\"]) {\n362|\t\treturn CapabilityResult{}, false\n363|\t}\n364|\ttexts := make([]string, 0, len(evidence))\n365|\tfor _, digest := range evidence {\n366|\t\ttexts = append(texts, digest.String())\n367|\t}\n368|\treturn CapabilityResult{\n369|\t\tStatus:     status,\n370|\t\tReasonCode: reasonCode,\n371|\t\tHasReason:  hasReason,\n372|\t\tEvidence:   texts,\n373|\t\tObservedAt: observed.String(),\n374|\t}, true\n375|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
