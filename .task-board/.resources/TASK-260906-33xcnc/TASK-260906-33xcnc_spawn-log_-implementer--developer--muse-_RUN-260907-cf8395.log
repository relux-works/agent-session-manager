{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c63f","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":378,"recorded_at":1780531400000751,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"cb3801b0-43cf-4a14-8a40-6a81232de527"},"task_id":"cb3801b0-43cf-4a14-8a40-6a81232de527","event":{"kind":"output","task_id":"cb3801b0-43cf-4a14-8a40-6a81232de527","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/identity_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file is the Provider Identity agreement battery. Two\n16|// validators implement the Section 5.5 shape rule-for-rule:\n17|// provhost.CheckIdentity mints provider-stdio refusals while\n18|// canonicaljson validates the same record through the closed\n19|// identity shape on the way to its object identity. A shape-rule\n20|// change must land in both validators in the same change, and\n21|// this battery is what fails when it lands in only one: every\n22|// row drives one shared vector through both production entries\n23|// and requires identical verdicts with the full rendering on\n24|// each side.\n25|//\n26|// One split is by design, not drift: provider equality (the\n27|// record naming the expected provider) is a caller-correlation\n28|// rule the host enforces, not a content rule the identity\n29|// calculation owns. The another-provider row ledgers that split\n30|// exactly — provhost refuses invalid_config while the\n31|// canonicalizer accepts — so a content-rule divergence cannot\n32|// hide behind it and a change to the split reddens here.\n33|\n34|// identityRow is one agreement vector: the body, the provhost\n35|// rule phrase, and the canonicalizer rule phrase. Empty phrases\n36|// mean both entries accept.\n37|type identityRow struct {\n38|\tname      string\n39|\tbody      []byte\n40|\tprovText  string\n41|\tcanonText string\n42|}\n43|\n44|// identityCorpus mutates each identity member alone against an\n45|// otherwise-valid record over the shared fixture identities.\n46|func identityCorpus(t *testing.T) []identityRow {\n47|\tt.Helper()\n48|\tvalid := validIdentityJSON()\n49|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n50|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n51|\totherSubject := jsonQuote(fixtureCreatorHostID)\n52|\treturn []identityRow{\n53|\t\t{\"valid\", valid, \"\", \"\"},\n54|\t\t{\"unknown member\", appendMember(t, valid, \"score\", `1`), \"identity carries unknown member\", \"unknown member\"},\n55|\t\t{\"missing opaque\", drop(\"opaque_identity\"), \"identity misses a required member\", \"required member\"},\n56|\t\t// Schema dispatch precedes shape validation in the\n57|\t\t// canonicalizer: a wrong schema or version refuses at\n58|\t\t// the dispatch registry, never reaching the identity\n59|\t\t// rules provhost enforces as member arms. Same\n60|\t\t// verdict, different arm by construction; a schema\n61|\t\t// change must update the dispatch registry and both\n62|\t\t// validators together.\n63|\t\t{\"wrong schema\", set(\"schema\", `\"urn:ax:schema:provider-manifest\"`), \"identity schema is not the provider identity\", \"has no supported immutable self-identity contract\"},\n64|\t\t{\"wrong version\", set(\"schema_version\", `\"1.1.0\"`), \"identity schema_version is not 1.0.0\", \"has no supported immutable self-identity contract\"},\n65|\t\t{\"bad record digest\", set(\"record_id\", `\"sha256:zzzz\"`), \"identity record_id is not a digest\", \"record_id\"},\n66|\t\t{\"bad subject uuid\", set(\"subject_id\", `\"not-a-uuid\"`), \"identity subject_id is not a UUIDv7\", \"subject_id\"},\n67|\t\t{\"subject differs\", set(\"subject_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n68|\t\t{\"session differs\", set(\"session_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n69|\t\t{\"bad provider grammar\", set(\"provider_id\", `\"Antigravity\"`), \"identity provider_id is not a provider id\", \"provider_id\"},\n70|\t\t{\"empty version\", set(\"provider_version\", `\"\"`), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n71|\t\t{\"long version\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n72|\t\t{\"empty range\", set(\"provider_version_range\", `\"\"`), \"identity provider_version_range is not 1..256 characters\", \"provider_version_range\"},\n73|\t\t{\"empty native id\", set(\"native_session_id\", `\"\"`), \"identity native_session_id is not 1..512 characters\", \"native_session_id\"},\n74|\t\t{\"unknown kind\", set(\"identity_kind\", `\"telepathy\"`), \"identity kind is not a registry member\", \"identity_kind\"},\n75|\t\t{\"bad workspace uuid\", set(\"logical_workspace_id\", `\"not-a-uuid\"`), \"identity workspace is not a UUIDv7\", \"logical_workspace_id\"},\n76|\t\t{\"bad realm\", set(\"backend_realm_fingerprint\", `\"sha256:zzzz\"`), \"identity realm is not a digest or null\", \"backend_realm_fingerprint\"},\n77|\t\t{\"null realm refused\", set(\"backend_realm_fingerprint\", `null`), \"identity realm is required for this backend kind\", \"must be non-null for Antigravity\"},\n78|\t\t{\"opaque array refused\", set(\"opaque_identity\", `[]`), \"not a JSON object\", \"opaque_identity\"},\n79|\t\t{\"opaque 33 keys refused\", set(\"opaque_identity\", opaqueKeysJSON(33)), \"exceeds 32 entries\", \"exceeds maximum length 32\"},\n80|\t\t{\"opaque bad key\", set(\"opaque_identity\", `{\"K\":\"v\"}`), \"identity opaque key is not a provider key\", \"must match\"},\n81|\t\t{\"opaque empty value\", set(\"opaque_identity\", `{\"k\":\"\"}`), \"identity opaque value is not 1..1024 characters\", \"1..1024\"},\n82|\t\t{\"opaque absolute path\", set(\"opaque_identity\", `{\"k\":\"/etc/passwd\"}`), \"begins with an absolute path\", \"must not begin with an absolute path\"},\n83|\t\t{\"bad creator uuid\", set(\"created_by_host_id\", `\"not-a-uuid\"`), \"identity host is not a UUIDv7\", \"created_by_host_id\"},\n84|\t\t{\"bad timestamp\", set(\"created_at\", `\"yesterday\"`), \"identity timestamp is not a timestamp\", \"created_at\"},\n85|\t\t{\"extensions array refused\", set(\"extensions\", `[]`), \"identity extensions is not an object\", \"extensions\"},\n86|\t\t{\"lone escape refused\", set(\"opaque_identity\", `{\"k\":\"A`+rawLoneHigh+`B\"}`), \"lone surrogate escape\", \"surrogate\"},\n87|\t\t{\"escaped text admits\", set(\"opaque_identity\", `{\"k\":\"A`+rawEscapedHigh+`B\"}`), \"\", \"\"},\n88|\t\t// The rows below pin the deliberate copy against its owner\n89|\t\t// (canonicaljson) on the classes where the dialect is blind:\n90|\t\t// extensions content, numbers, and nesting the dialect never\n91|\t\t// reads. The provhost phrase on each is the conjoined owner\n92|\t\t// gate, not a member arm: deleting the owner call admits the\n93|\t\t// body and fails the row on the provhost side.\n94|\t\t{\"extensions open key refused\", set(\"extensions\", `{\"x\": \"y\"}`), \"identity is not a valid provider identity\", \"extensions key\"},\n95|\t\t{\"extensions unsafe integer refused\", set(\"extensions\", `{\"works.relux.ax.x\": 9007199254740993}`), \"identity is not a valid provider identity\", \"outside the AX safe-integer interval\"},\n96|\t\t{\"extensions float refused\", set(\"extensions\", `{\"works.relux.ax.x\": 1.5}`), \"identity is not a valid provider identity\", \"forbidden by the AX common model\"},\n97|\t\t{\"extensions 65 keys refused\", set(\"extensions\", extensionKeysJSON(65)), \"identity is not a valid provider identity\", \"maximum is 64\"},\n98|\t\t{\"extensions deep nesting refused\", set(\"extensions\", `{\"works.relux.ax.a\": {\"b\": {\"c\": {\"d\": {\"e\": {\"f\": 1}}}}}}`), \"identity is not a valid provider identity\", \"maximum nesting depth 4\"},\n99|\t\t// Bound edges in both directions: the admit rows prove the gate\n100|\t\t// is not refusing everything, the refuse rows prove the bound.\n101|\t\t{\"opaque 64-char key admits\", set(\"opaque_identity\", `{\"k`+strings.Repeat(\"e\", 63)+`\": \"v\"}`), \"\", \"\"},\n102|\t\t{\"version 128 admits\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 128))), \"\", \"\"},\n103|\t\t{\"version 128 wide admits\", set(\"provider_version\", jsonQuote(strings.Repeat(\"é\", 128))), \"\", \"\"},\n104|\t\t{\"version 129 wide refused\", set(\"provider_version\", jsonQuote(strings.Repeat(\"é\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n105|\t\t// A number where the dialect already reads the type is refused\n106|\t\t// by the dialect arm first: the owner gate never fires, and the\n107|\t\t// member attribution survives the conjunction.\n108|\t\t{\"opaque unsafe integer refused\", set(\"opaque_identity\", `{\"k\": 9007199254740993}`), \"identity opaque value is not 1..1024 characters\", \"outside the AX safe-integer interval\"},\n109|\t\t// Decoder vectors both entries must refuse with their own arm.\n110|\t\t{\"duplicate member refused\", duplicateMemberJSON(t, valid), \"duplicate member\", \"duplicate object member\"},\n111|\t\t{\"trailing data refused\", append(append([]byte{}, valid...), ' ', '{', '}'), \"trailing data\", \"trailing JSON\"},\n112|\t}\n113|}\n114|\n115|// extensionKeysJSON builds an extensions object with count reverse-DNS\n116|// keys, so the count bound (not the key grammar) is what refuses it.\n117|func extensionKeysJSON(count int) string {\n118|\tparts := make([]string, 0, count)\n119|\tfor index := 0; index < count; index++ {\n120|\t\tparts = append(parts, `\"works.relux.ax.k`+twoDigits(index)+`\":\"v\"`)\n121|\t}\n122|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n123|}\n124|\n125|// duplicateMemberJSON returns the fixture with one member doubled: a\n126|// repeated member has no single value, so both decoders refuse it before\n127|// any shape rule runs.\n128|func duplicateMemberJSON(t *testing.T, valid []byte) []byte {\n129|\tt.Helper()\n130|\tbody := string(valid)\n131|\tif body == \"\" || body[len(body)-1] != '}' {\n132|\t\tt.Fatalf(\"duplicate member fixture is not an object\")\n133|\t}\n134|\treturn []byte(body[:len(body)-1] + `, \"score\": 1, \"score\": 2}`)\n135|}\n136|\n137|// Raw escape fragments. rawLoneHigh is a real lone high escape\n138|// in JSON source; rawEscapedHigh is an escaped backslash\n139|// followed by text, which carries no escape at all. Both are\n140|// package variables (not literals) so the Go compiler never\n141|// sees an invalid \\u escape in source.\n142|var (\n143|\trawLoneHigh    = \"\\\\ud800\"\n144|\trawEscapedHigh = \"\\\\\\\\ud800\"\n145|)\n146|\n147|// opaqueKeysJSON builds an opaque_identity object with count\n148|// grammar-valid keys.\n149|func opaqueKeysJSON(count int) string {\n150|\tparts := make([]string, 0, count)\n151|\tfor index := 0; index < count; index++ {\n152|\t\tparts = append(parts, `\"k`+twoDigits(index)+`\":\"v\"`)\n153|\t}\n154|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n155|}\n156|\n157|func twoDigits(value int) string {\n158|\tdigits := \"0123456789\"\n159|\treturn string([]byte{digits[value/10%10], digits[value%10]})\n160|}\n161|\n162|// TestIdentityAgreementAcrossValidators drives the corpus\n163|// through both identity entries and requires identical verdicts\n164|// with the full rule rendering on each side.\n165|func TestIdentityAgreementAcrossValidators(t *testing.T) {\n166|\tfor _, row := range identityCorpus(t) {\n167|\t\tt.Run(row.name, func(t *testing.T) {\n168|\t\t\tprovErr := provhost.CheckIdentity(row.body, \"antigravity\")\n169|\t\t\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(row.body)\n170|\t\t\tif row.provText == \"\" && row.canonText == \"\" {\n171|\t\t\t\tif provErr != nil {\n172|\t\t\t\t\tt.Fatalf(\"provhost refused %s: %v\", row.body, provErr)\n173|\t\t\t\t}\n174|\t\t\t\tif canonErr != nil {\n175|\t\t\t\t\tt.Fatalf(\"canonicaljson refused %s: %v\", row.body, canonErr)\n176|\t\t\t\t}\n177|\t\t\t\treturn\n178|\t\t\t}\n179|\t\t\tif provErr == nil {\n180|\t\t\t\tt.Fatalf(\"provhost admitted %s, want rule %q\", row.body, row.provText)\n181|\t\t\t}\n182|\t\t\tif canonErr == nil {\n183|\t\t\t\tt.Fatalf(\"canonicaljson admitted %s, want rule %q\", row.body, row.canonText)\n184|\t\t\t}\n185|\t\t\tif !strings.Contains(provErr.Error(), row.provText) {\n186|\t\t\t\tt.Fatalf(\"provhost error = %v, want rule %q\", provErr, row.provText)\n187|\t\t\t}\n188|\t\t\tif !strings.Contains(canonErr.Error(), row.canonText) {\n189|\t\t\t\tt.Fatalf(\"canonicaljson error = %v, want rule %q\", canonErr, row.canonText)\n190|\t\t\t}\n191|\t\t})\n192|\t}\n193|}\n194|\n195|// TestIdentityProviderEqualityIsCallerRule ledgers the one\n196|// by-design split: a well-formed record for another provider is\n197|// a caller-correlation failure (invalid_config) at the host,\n198|// while the identity calculation accepts the content. Neither\n199|// side may change its half silently.\n200|func TestIdentityProviderEqualityIsCallerRule(t *testing.T) {\n201|\tbody := mutateMember(t, validIdentityJSON(), \"provider_id\", `\"codex\"`)\n202|\tprovErr := provhost.CheckIdentity(body, \"antigravity\")\n203|\tif provErr == nil {\n204|\t\tt.Fatalf(\"provhost admitted a record for another provider\")\n205|\t}\n206|\tif !strings.Contains(provErr.Error(), \"identity names another provider\") {\n207|\t\tt.Fatalf(\"provhost error = %v, want the caller-correlation arm\", provErr)\n208|\t}\n209|\tif _, _, canonErr := canonicaljson.CalculateObjectIdentity(body); canonErr != nil {\n210|\t\tt.Fatalf(\"canonicaljson refused well-formed content for another provider: %v\", canonErr)\n211|\t}\n212|}\n213|\n214|// TestIdentityMemberTablesAreOneTable requires the provhost\n215|// required-member table and the canonicalizer's exact-member\n216|// list for the identity record to carry the same members in the\n217|// same order: multi-missing determinism is shared behavior.\n218|func TestIdentityMemberTablesAreOneTable(t *testing.T) {\n219|\tmine := deriveRequiredList(t, \"provhost\", \"identity.go\", \"identityRequired\")\n220|\ttheirs := deriveIdentityExactMembers(t)\n221|\tif len(mine) != len(theirs) {\n222|\t\tt.Fatalf(\"identity member tables differ in size:\\nprovhost: %q\\ncanonicaljson: %q\", mine, theirs)\n223|\t}\n224|\tfor index := range mine {\n225|\t\tif mine[index] != theirs[index] {\n226|\t\t\tt.Fatalf(\"identity member tables differ at %d:\\nprovhost: %q\\ncanonicaljson: %q\", index, mine, theirs)\n227|\t\t}\n228|\t}\n229|}\n230|\n231|// deriveIdentityExactMembers derives the member list from the\n232|// requireExactMembers call for the Provider Identity Record in\n233|// canonicaljson production.\n234|func deriveIdentityExactMembers(t *testing.T) []string {\n235|\tt.Helper()\n236|\tpath := mustInternalRoot(t) + \"/canonicaljson/core_records.go\"\n237|\tsource, err := os.ReadFile(path)\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"identity members: %v\", err)\n240|\t}\n241|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n242|\tif err != nil {\n243|\t\tt.Fatalf(\"identity members: %v\", err)\n244|\t}\n245|\tfound := false\n246|\tvar members []string\n247|\tast.Inspect(syntax, func(node ast.Node) bool {\n248|\t\tcall, ok := node.(*ast.CallExpr)\n249|\t\tif !ok || found {\n250|\t\t\treturn true\n251|\t\t}\n252|\t\ttarget, ok := call.Fun.(*ast.Ident)\n253|\t\tif !ok || target.Name != \"requireExactMembers\" || len(call.Args) < 3 {\n254|\t\t\treturn true\n255|\t\t}\n256|\t\tfirst, ok := call.Args[0].(*ast.BasicLit)\n257|\t\tif !ok || strings.Trim(first.Value, `\"`) != \"Provider Identity Record\" {\n258|\t\t\treturn true\n259|\t\t}\n260|\t\tfor _, arg := range call.Args[2:] {\n261|\t\t\tliteral, ok := arg.(*ast.BasicLit)\n262|\t\t\tif !ok {\n263|\t\t\t\tt.Fatalf(\"identity members: exact-member list is not literals; the extractor cannot see through indirection\")\n264|\t\t\t}\n265|\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n266|\t\t}\n267|\t\tfound = true\n268|\t\treturn false\n269|\t})\n270|\tif !found {\n271|\t\tt.Fatal(\"identity members: requireExactMembers call for the Provider Identity Record not found; the extractor is blind\")\n272|\t}\n273|\treturn members\n274|}"}}}
