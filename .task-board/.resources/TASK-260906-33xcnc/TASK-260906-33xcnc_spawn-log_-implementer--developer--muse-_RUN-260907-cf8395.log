{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55d","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":265,"recorded_at":1780531400000525,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad23cd3770290c5269460e01581","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/provhost/protocol.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"math\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\t\"time\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Wire constants of pinned specification Section 7.2. The protocol\n18|// identifier and version are exact: a different major is never negotiated,\n19|// and anything other than 2.0.0 on the wire is refused or reported as a\n20|// major mismatch, never accepted.\n21|const (\n22|\t// ProtocolID is the exact protocol member every request and response\n23|\t// envelope carries.\n24|\tProtocolID = \"urn:ax:protocol:provider\"\n25|\t// ProtocolVersion is the exact protocol_version member this host\n26|\t// writes and the only one it accepts a response under.\n27|\tProtocolVersion = \"2.0.0\"\n28|\t// ProtocolMajor is the major this host implements. Responses under\n29|\t// any other recognizable major are reported as incompatible_protocol\n30|\t// without trusting their payload.\n31|\tProtocolMajor = 2\n32|\t// MaxFrameBytes bounds one JSONL line in either direction: Section\n33|\t// 7.2 requires every line to be one complete UTF-8 JSON object no\n34|\t// larger than 8 MiB.\n35|\tMaxFrameBytes = 8 << 20\n36|\t// StderrCapBytes caps captured plugin stderr. It is an implementation\n37|\t// resource bound, not a protocol limit: diagnostics beyond it are\n38|\t// dropped. Failure details carry the failure class and member names\n39|\t// only, never stderr content.\n40|\tStderrCapBytes = 1 << 20\n41|)\n42|\n43|// Operation names one Section 7.5 registry entry. The registry is closed:\n44|// dispatch refuses any other name locally, before any process starts.\n45|type Operation string\n46|\n47|// Section 7.5 operation registry in the Section 7.3 manifest order. The\n48|// inventory test derives this list from the pinned specification text and\n49|// requires exact ordered equality, so a dropped, added, or reordered entry\n50|// reddens there rather than passing silently.\n51|const (\n52|\tOpManifest            Operation = \"manifest\"\n53|\tOpProbe               Operation = \"probe\"\n54|\tOpLaunch              Operation = \"launch\"\n55|\tOpIdentifySession     Operation = \"identify-session\"\n56|\tOpQuiesce             Operation = \"quiesce\"\n57|\tOpNativeStorePlan     Operation = \"native-store-plan\"\n58|\tOpCapture             Operation = \"capture\"\n59|\tOpMaterialize         Operation = \"materialize\"\n60|\tOpMaterializeStatus   Operation = \"materialize-status\"\n61|\tOpMaterializeCommit   Operation = \"materialize-commit\"\n62|\tOpMaterializeRollback Operation = \"materialize-rollback\"\n63|\tOpResume              Operation = \"resume\"\n64|\tOpFork                Operation = \"fork\"\n65|\tOpStop                Operation = \"stop\"\n66|\tOpDoctor              Operation = \"doctor\"\n67|)\n68|\n69|// operationOrder is the single construction site of the dispatch registry.\n70|var operationOrder = []Operation{\n71|\tOpManifest,\n72|\tOpProbe,\n73|\tOpLaunch,\n74|\tOpIdentifySession,\n75|\tOpQuiesce,\n76|\tOpNativeStorePlan,\n77|\tOpCapture,\n78|\tOpMaterialize,\n79|\tOpMaterializeStatus,\n80|\tOpMaterializeCommit,\n81|\tOpMaterializeRollback,\n82|\tOpResume,\n83|\tOpFork,\n84|\tOpStop,\n85|\tOpDoctor,\n86|}\n87|\n88|// Operations returns the dispatch registry in manifest order. The result\n89|// is a copy; the registry cannot be mutated through it.\n90|func Operations() []string {\n91|\tout := make([]string, 0, len(operationOrder))\n92|\tfor _, operation := range operationOrder {\n93|\t\tout = append(out, string(operation))\n94|\t}\n95|\treturn out\n96|}\n97|\n98|// validOperation reports whether the name is a registry member.\n99|func validOperation(name string) bool {\n100|\tfor _, operation := range operationOrder {\n101|\t\tif string(operation) == name {\n102|\t\t\treturn true\n103|\t\t}\n104|\t}\n105|\treturn false\n106|}\n107|\n108|// The refusal constructors below are declared as variables so the\n109|// inventory gate can observe every exercised refusal site. Each is the\n110|// single construction site for its failure class; production code must\n111|// not build *axerror.Error any other way.\n112|//\n113|// failInvalid reports a caller error caught before any process starts:\n114|// an unknown operation, a stale deadline, or an unframeable request body.\n115|// failProtocol reports an unusable plugin frame through the Section 15.1\n116|// provider-stdio otherwise branch. failMismatch reports a recognizable\n117|// major mismatch through the same table's mismatch branch, without\n118|// trusting the foreign payload. failProcess reports a crash or transport\n119|// failure. failTimeout reports a plugin that exceeded its request\n120|// deadline. failIntegrity reports a status observation that cannot be\n121|// reconciled to durable state.\n122|var failInvalid = func(detail string) (*axerror.Error, error) {\n123|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"invalid_config\", Message: \"provider host refused the request: \" + detail, Details: axerror.Details{}})\n124|}\n125|\n126|var failProtocol = func(detail string, member string) (*axerror.Error, error) {\n127|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeUnusableFrame, \"provider host rejected the plugin frame: \"+detail, axerror.NoIDs(), axerror.Details{\"member\": member}, nil)\n128|}\n129|\n130|var failMismatch = func(detail string, observed string) (*axerror.Error, error) {\n131|\treturn axerror.LocalFromUntrusted(axerror.SurfaceProviderStdio, axerror.OutcomeRecognizableMajorMismatch, \"provider host rejected a foreign protocol major: \"+detail, axerror.NoIDs(), axerror.Details{\"observed\": observed}, nil)\n132|}\n133|\n134|var failProcess = func(detail string, cause error) (*axerror.Error, error) {\n135|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_process_failed\", Message: \"provider plugin process failed: \" + detail, Details: axerror.Details{}, Cause: cause})\n136|}\n137|\n138|var failTimeout = func(detail string, millis int64) (*axerror.Error, error) {\n139|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"provider_timeout\", Message: \"provider plugin exceeded its deadline: \" + detail, Details: axerror.Details{\"deadline_ms\": json.Number(strconv.FormatInt(millis, 10))}})\n140|}\n141|\n142|var failIntegrity = func(detail string, statusState string, materializationID string, transactionID string) (*axerror.Error, error) {\n143|\treturn axerror.New(axerror.Spec{Version: axerror.Version100, Code: \"integrity_failure\", Message: \"provider status observation is not durable state: \" + detail, Details: axerror.Details{\"status_state\": statusState, \"materialization_id\": materializationID, \"transaction_id\": transactionID}})\n144|}\n145|\n146|// Request is one Section 7.2 request envelope. Body crosses the transport\n147|// opaquely: it must be a JSON object, and its members are interpreted by\n148|// the operation layer, except for the status recovery read.\n149|type Request struct {\n150|\tOperation Operation\n151|\tRequestID scalar.UUIDv7\n152|\tDeadline  scalar.Timestamp\n153|\tBody      json.RawMessage\n154|}\n155|\n156|// Response is one accepted success envelope. Body is the raw\n157|// operation-specific object for the operation layer to interpret. A\n158|// failure envelope never produces a Response: DecodeResponse returns the\n159|// bound child error instead, and a failure envelope carrying a body is\n160|// refused outright.\n161|type Response struct {\n162|\tBody json.RawMessage\n163|}\n164|\n165|// wireRequest is the exact emitted member set: protocol, protocol_version,\n166|// request_id, operation, deadline, and body, in this fixed order.\n167|type wireRequest struct {\n168|\tProtocol        string           `json:\"protocol\"`\n169|\tProtocolVersion string           `json:\"protocol_version\"`\n170|\tRequestID       scalar.UUIDv7    `json:\"request_id\"`\n171|\tOperation       string           `json:\"operation\"`\n172|\tDeadline        scalar.Timestamp `json:\"deadline\"`\n173|\tBody            json.RawMessage  `json:\"body\"`\n174|}\n175|\n176|// EncodeRequest frames one request as a single JSONL line without the\n177|// terminator. The deadline must be in the future at now, which the caller\n178|// supplies so tests stay deterministic; Host passes its clock.\n179|func EncodeRequest(req Request, now time.Time) ([]byte, error) {\n180|\tframe, _, err := encodeFrame(req, now)\n181|\treturn frame, err\n182|}\n183|\n184|// encodeFrame validates and frames a request, also returning the parsed\n185|// deadline instant so Host.Call validates once at a single site.\n186|func encodeFrame(req Request, now time.Time) ([]byte, time.Time, error) {\n187|\tif !validOperation(string(req.Operation)) {\n188|\t\tfailure, err := failInvalid(\"unknown operation\")\n189|\t\tif err != nil {\n190|\t\t\treturn nil, time.Time{}, err\n191|\t\t}\n192|\t\treturn nil, time.Time{}, failure\n193|\t}\n194|\tif _, err := scalar.ParseUUIDv7(req.RequestID.String()); err != nil {\n195|\t\tfailure, fault := failInvalid(\"request_id is not a UUIDv7\")\n196|\t\tif fault != nil {\n197|\t\t\treturn nil, time.Time{}, fault\n198|\t\t}\n199|\t\treturn nil, time.Time{}, failure\n200|\t}\n201|\tdeadline, err := req.Deadline.Time()\n202|\tif err != nil {\n203|\t\tfailure, fault := failInvalid(\"deadline is not a timestamp\")\n204|\t\tif fault != nil {\n205|\t\t\treturn nil, time.Time{}, fault\n206|\t\t}\n207|\t\treturn nil, time.Time{}, failure\n208|\t}\n209|\tif !deadline.After(now) {\n210|\t\tfailure, fault := failInvalid(\"deadline is not in the future\")\n211|\t\tif fault != nil {\n212|\t\t\treturn nil, time.Time{}, fault\n213|\t\t}\n214|\t\treturn nil, time.Time{}, failure\n215|\t}\n216|\tif !isJSONObject(req.Body) {\n217|\t\tfailure, fault := failInvalid(\"body is not a JSON object\")\n218|\t\tif fault != nil {\n219|\t\t\treturn nil, time.Time{}, fault\n220|\t\t}\n221|\t\treturn nil, time.Time{}, failure\n222|\t}\n223|\t// The operation, request ID, deadline, and body above were each\n224|\t// validated before this marshal, so it cannot fail on a reachable\n225|\t// path: the error propagates as a plain Go error rather than\n226|\t// through a refusal site no negative test could exercise.\n227|\tframe, err := json.Marshal(wireRequest{Protocol: ProtocolID, ProtocolVersion: ProtocolVersion, RequestID: req.RequestID, Operation: string(req.Operation), Deadline: req.Deadline, Body: req.Body})\n228|\tif err != nil {\n229|\t\treturn nil, time.Time{}, err\n230|\t}\n231|\tif len(frame) > MaxFrameBytes {\n232|\t\tfailure, fault := failInvalid(\"request frame exceeds 8 MiB\")\n233|\t\tif fault != nil {\n234|\t\t\treturn nil, time.Time{}, fault\n235|\t\t}\n236|\t\treturn nil, time.Time{}, failure\n237|\t}\n238|\treturn frame, deadline, nil\n239|}\n240|\n241|// isJSONObject reports whether data is well-formed JSON whose top-level\n242|// value is an object. Bodies cross the transport opaquely, so this is the\n243|// only body check here: member vocabularies belong to the operation layer.\n244|func isJSONObject(data []byte) bool {\n245|\ttrimmed := bytes.TrimSpace(data)\n246|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n247|\t\treturn false\n248|\t}\n249|\treturn json.Valid(trimmed)\n250|}\n251|\n252|// frameFault classifies a malformed plugin frame without minting error\n253|// values: dynamic facts travel in axerror details, never in Go error text,\n254|// so production code builds no raw errors.\n255|type frameFault struct {\n256|\tdetail string\n257|\tmember string\n258|}\n259|\n260|// decodeStrictObject parses one complete JSON object with duplicate\n261|// member detection. A repeated member has no single value, so it is a\n262|// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n263|// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n264|// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n265|// raw bytes are screened before any member is trusted. The\n266|// lone-surrogate gate runs next: encoding/json would likewise replace\n267|// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n268|// reject lone surrogate code points).\n269|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n270|\tif !utf8.Valid(data) {\n271|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n272|\t}\n273|\tif hasLoneSurrogateEscape(data) {\n274|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n275|\t}\n276|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n277|\ttoken, err := decoder.Token()\n278|\tif err != nil {\n279|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n280|\t}\n281|\tdelim, ok := token.(json.Delim)\n282|\tif !ok || delim != '{' {\n283|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n284|\t}\n285|\tmembers := map[string]json.RawMessage{}\n286|\tfor decoder.More() {\n287|\t\tkeyToken, err := decoder.Token()\n288|\t\tif err != nil {\n289|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n290|\t\t}\n291|\t\tkey, ok := keyToken.(string)\n292|\t\tif !ok {\n293|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n294|\t\t}\n295|\t\tif _, duplicate := members[key]; duplicate {\n296|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n297|\t\t}\n298|\t\tvar raw json.RawMessage\n299|\t\tif err := decoder.Decode(&raw); err != nil {\n300|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n301|\t\t}\n302|\t\tmembers[key] = raw\n303|\t}\n304|\tif token, err := decoder.Token(); err != nil {\n305|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n306|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n307|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n308|\t}\n309|\tif _, err := decoder.Token(); err != io.EOF {\n310|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n311|\t}\n312|\treturn members, nil\n313|}\n314|\n315|// responseMembers is the exact Section 7.2 response member set: the four\n316|// framing members plus body on success or error on failure, never both,\n317|// never neither, and nothing else. It is package-level so the closed\n318|// vocabulary census derives it: widening the accepted set here must redden\n319|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n320|var responseMembers = map[string]bool{\n321|\t\"protocol\":         true,\n322|\t\"protocol_version\": true,\n323|\t\"request_id\":       true,\n324|\t\"ok\":               true,\n325|\t\"body\":             true,\n326|\t\"error\":            true,\n327|}\n328|\n329|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n330|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n331|\tfor _, name := range required {\n332|\t\tif _, present := members[name]; !present {\n333|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n334|\t\t}\n335|\t}\n336|\tif ok {\n337|\t\tif _, present := members[\"body\"]; !present {\n338|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n339|\t\t}\n340|\t\tif _, forbidden := members[\"error\"]; forbidden {\n341|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n342|\t\t}\n343|\t} else {\n344|\t\tif _, present := members[\"error\"]; !present {\n345|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n346|\t\t}\n347|\t\tif _, forbidden := members[\"body\"]; forbidden {\n348|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n349|\t\t}\n350|\t}\n351|\tfor name := range members {\n352|\t\tif !responseMembers[name] {\n353|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n354|\t\t}\n355|\t}\n356|\treturn nil\n357|}\n358|\n359|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n360|// Anything else is not a recognizable major, so the frame is unusable\n361|// rather than a mismatch. A major that does not fit an int saturates\n362|// instead of wrapping, but saturation never short-circuits the shape\n363|// check: only a fully numeric X.Y.Z reports a recognized major. An\n364|// all-numeric giant is observably foreign (it is not 2), so it takes\n365|// the mismatch arm, never aliases a small native major\n366|// (18446744073709551618 must not read as 2) and never slides to the\n367|// unusable-frame arm; a giant with a non-numeric or empty rest\n368|// (99999999999999999999.abc.def) is unrecognized like any other\n369|// malformed version. Saturation adds no rejection branch, so the\n370|// derived parse-arm census needs no new row for it.\n371|//\n372|// Leading zeros are accepted, not rejected: \"03.0.0\" reports major 3\n373|// and \"02.0.0\" reports major 2. The looseness is classification-only\n374|// and deliberately stays. parseMajor never admits a version — the\n375|// version gate admits exactly \"2.0.0\" by string equality — it only\n376|// chooses which refusal a foreign frame takes: a recognizable major\n377|// other than 2 is a major mismatch (incompatible_protocol), anything\n378|// else is an unusable frame (provider_protocol_error). \"03.0.0\" is\n379|// observably foreign either way, so strictness would only move it\n380|// from the mismatch arm to the unusable arm, and \"02.0.0\" already\n381|// lands unusable and is never admitted. Strict SemVer (no leading\n382|// zeros) is enforced where a version is admitted — manifest\n383|// plugin_version and the shared semver grammar — never at this\n384|// foreign-frame classifier. A leading-zero rejection here would also\n385|// spell an equality against '0', which the digit-guard census rejects\n386|// as unclassifiable, so the stricter spelling costs census churn for\n387|// zero admission gain. TestParseMajorLeadingZeroIsClassifiedAsForeign\n388|// pins both rows through DecodeResponse.\n389|func parseMajor(version string) (int, bool) {\n390|\tparts := strings.Split(version, \".\")\n391|\tif len(parts) != 3 {\n392|\t\treturn 0, false\n393|\t}\n394|\tmajor := 0\n395|\tfor i := 0; i < len(parts[0]); i++ {\n396|\t\tdigit := parts[0][i]\n397|\t\tif digit < '0' || digit > '9' {\n398|\t\t\treturn 0, false\n399|\t\t}\n400|\t\tstep := int(digit - '0')\n401|\t\tif major > (math.MaxInt-step)/10 {\n402|\t\t\tmajor = math.MaxInt\n403|\t\t\tcontinue\n404|\t\t}\n405|\t\tmajor = major*10 + step\n406|\t}\n407|\tif len(parts[0]) == 0 {\n408|\t\treturn 0, false\n409|\t}\n410|\tfor _, rest := range parts[1:] {\n411|\t\tif len(rest) == 0 {\n412|\t\t\treturn 0, false\n413|\t\t}\n414|\t\tfor i := 0; i < len(rest); i++ {\n415|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n416|\t\t\t\treturn 0, false\n417|\t\t\t}\n418|\t\t}\n419|\t}\n420|\treturn major, true\n421|}\n422|\n423|// DecodeResponse validates one stdout line as the single response frame\n424|// for the request carrying wantRequestID. It returns the success body, or\n425|// the bound child failure, or a local failure that trusts nothing from\n426|// the frame. A recognizable foreign major yields incompatible_protocol;\n427|// every other unusable frame yields provider_protocol_error.\n428|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n429|\tif len(frame) > MaxFrameBytes {\n430|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n431|\t\tif err != nil {\n432|\t\t\treturn Response{}, err\n433|\t\t}\n434|\t\treturn Response{}, failure\n435|\t}\n436|\tif !utf8.Valid(frame) {\n437|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n438|\t\tif err != nil {\n439|\t\t\treturn Response{}, err\n440|\t\t}\n441|\t\treturn Response{}, failure\n442|\t}\n443|\tmembers, fault := decodeStrictObject(frame)\n444|\tif fault != nil {\n445|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n446|\t\tif err != nil {\n447|\t\t\treturn Response{}, err\n448|\t\t}\n449|\t\treturn Response{}, failure\n450|\t}\n451|\t// foreignMajor peeks at the envelope identity before any v2\n452|\t// member rule runs. A recognizable foreign major is\n453|\t// incompatible_protocol no matter what members it carries, so\n454|\t// the v2 member vocabulary below must not judge it first: a\n455|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n456|\t// is a foreign major, not an unknown or missing member. The\n457|\t// peek trusts nothing and refuses nothing: it only arms when\n458|\t// the protocol member is exactly this protocol and the version\n459|\t// member is a string with a recognizable foreign major. A frame\n460|\t// without our protocol identity, or without a readable version,\n461|\t// falls through to the member rules, which keep their verdicts.\n462|\tforeignMajor := \"\"\n463|\tif rawProtocol, present := members[\"protocol\"]; present {\n464|\t\tvar protocol string\n465|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n466|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n467|\t\t\t\tvar version string\n468|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n469|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n470|\t\t\t\t\t\tforeignMajor = version\n471|\t\t\t\t\t}\n472|\t\t\t\t}\n473|\t\t\t}\n474|\t\t}\n475|\t}\n476|\tvar ok bool\n477|\tif foreignMajor == \"\" {\n478|\t\tif raw, present := members[\"ok\"]; !present {\n479|\t\t\tfailure, err := failProtocol(\"missing member\", \"ok\")\n480|\t\t\tif err != nil {\n481|\t\t\t\treturn Response{}, err\n482|\t\t\t}\n483|\t\t\treturn Response{}, failure\n484|\t\t} else if err := json.Unmarshal(raw, &ok); err != nil {\n485|\t\t\tfailure, fault := failProtocol(\"member is not a boolean\", \"ok\")\n486|\t\t\tif fault != nil {\n487|\t\t\t\treturn Response{}, fault\n488|\t\t\t}\n489|\t\t\treturn Response{}, failure\n490|\t\t}\n491|\t\tif fault := checkResponseMembers(members, ok); fault != nil {\n492|\t\t\tfailure, err := failProtocol(fault.detail, fault.member)\n493|\t\t\tif err != nil {\n494|\t\t\t\treturn Response{}, err\n495|\t\t\t}\n496|\t\t\treturn Response{}, failure\n497|\t\t}\n498|\t}\n499|\tvar protocol string\n500|\tif err := json.Unmarshal(members[\"protocol\"], &protocol); err != nil || protocol != ProtocolID {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c55f","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":266,"recorded_at":1780531400000527,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad23da67723a112878700fa5d2e","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/provhost/surrogate.go`.\n1|package provhost\n2|\n3|// This file is the local lone-surrogate gate for the Section 1.6 wire\n4|// bodies this package decodes. Pinned specification Section 1.6 requires\n5|// decoders to reject lone surrogate code points before canonicalization,\n6|// and the repository already enforces that rule in\n7|// internal/canonicaljson (validateSurrogateEscapes, called from\n8|// decodeStrict). This package decodes with its own strict object reader\n9|// (decodeStrictObject in protocol.go) because it must keep member-level\n10|// fault attribution (duplicate member names, the offending member) that\n11|// the shared decoder does not report, and encoding/json silently replaces\n12|// a lone \\ud800-style escape with U+FFFD instead of failing. So the gate\n13|// lives here, scans the raw frame bytes before decoding, and refuses the\n14|// same class the shared package refuses.\n15|//\n16|// The gate is deliberately a copy, not an import: internal/canonicaljson\n17|// is byte-identical shared baseline text that two unlanded stories must\n18|// not edit at once, so neither story may add an export there. The\n19|// surrogate-vector sweep in surrogate_test.go drives both this gate\n20|// (through decodeStrictObject) and canonicaljson.Canonicalize over a\n21|// derived enumeration of the code-point space, so the copies cannot\n22|// drift silently: a divergence reddens there rather than passing\n23|// unnoticed. The sweep judges verdicts against the independent\n24|// implementation, never against a shared hand-written expectation.\n25|//\n26|// The gate decides the surrogate-escape question only. Malformed\n27|// escapes and unterminated strings are not its verdict: they fall\n28|// through to the JSON-syntax arms that already own them. Non-UTF-8\n29|// bytes never reach it: decodeStrictObject refuses them first,\n30|// because a raw WTF-8 surrogate encoding would otherwise slip past\n31|// this escape scanner and be silently replaced with U+FFFD by\n32|// encoding/json. A lone high surrogate is a high unit not immediately\n33|// followed by a \\uDC00–\\uDFFF escape; a lone low surrogate is a low\n34|// unit in any other position. Both are refused before any member is\n35|// read.\n36|\n37|// The gate's own range constants: the high and low surrogate halves\n38|// of the Section 1.6 verdict space. The\n39|// surrogate-vector sweep in surrogate_test.go derives its pair-second\n40|// dimension from these constants arithmetically (bounds plus and minus\n41|// small offsets), so the boundary neighborhood is enumerated from the\n42|// gate rather than from a hand-written literal: shifting a bound here\n43|// moves the swept neighborhood with it instead of silently uncovering\n44|// it. Verdicts still come from the independent implementation, never\n45|// from these constants, so a wrong bound reddens against the oracle.\n46|const (\n47|\thighSurrogateMin = 0xd800\n48|\thighSurrogateMax = 0xdbff\n49|\tlowSurrogateMin  = 0xdc00\n50|\tlowSurrogateMax  = 0xdfff\n51|)\n52|\n53|// hasLoneSurrogateEscape reports whether raw JSON bytes carry a lone\n54|// surrogate escape inside any string. The string walk mirrors the shared\n55|// package's walker (backslash handling included: a \\\\ escape consumes\n56|// both bytes, so the text \"\\\\ud800\" is backslash-plus-text, not an\n57|// escape), but only the surrogate verdict is returned.\n58|func hasLoneSurrogateEscape(input []byte) bool {\n59|\tfor index := 0; index < len(input); index++ {\n60|\t\tif input[index] != '\"' {\n61|\t\t\tcontinue\n62|\t\t}\n63|\t\tfor index++; index < len(input); index++ {\n64|\t\t\tif input[index] == '\"' {\n65|\t\t\t\tgoto stringComplete\n66|\t\t\t}\n67|\t\t\tif input[index] != '\\\\' {\n68|\t\t\t\tcontinue\n69|\t\t\t}\n70|\t\t\tindex++\n71|\t\t\tif index >= len(input) || input[index] != 'u' {\n72|\t\t\t\tcontinue\n73|\t\t\t}\n74|\t\t\tunit, end, ok := readHexUnit(input, index-1)\n75|\t\t\tif !ok {\n76|\t\t\t\t// Not a well-formed \\uXXXX escape: the\n77|\t\t\t\t// JSON-syntax arms own it, not this gate.\n78|\t\t\t\tcontinue\n79|\t\t\t}\n80|\t\t\tindex = end - 1\n81|\t\t\tif unit >= highSurrogateMin && unit <= highSurrogateMax {\n82|\t\t\t\tlow, lowEnd, ok := readHexUnit(input, end)\n83|\t\t\t\tif !ok || low < lowSurrogateMin || low > lowSurrogateMax {\n84|\t\t\t\t\treturn true\n85|\t\t\t\t}\n86|\t\t\t\tindex = lowEnd - 1\n87|\t\t\t} else if unit >= lowSurrogateMin && unit <= lowSurrogateMax {\n88|\t\t\t\treturn true\n89|\t\t\t}\n90|\t\t}\n91|\t\t// The string never closed: malformed JSON the syntax arms\n92|\t\t// refuse, so the gate claims no surrogate verdict here.\n93|\t\treturn false\n94|\tstringComplete:\n95|\t}\n96|\treturn false\n97|}\n98|\n99|// readHexUnit parses one \\uXXXX escape at input[start]. It reports false\n100|// when the bytes are not a well-formed escape; hex digits parse in\n101|// either case, matching the shared package's ParseUint base-16 read.\n102|func readHexUnit(input []byte, start int) (uint16, int, bool) {\n103|\tif start < 0 || start+6 > len(input) || input[start] != '\\\\' || input[start+1] != 'u' {\n104|\t\treturn 0, start, false\n105|\t}\n106|\tvar value uint16\n107|\tfor _, b := range input[start+2 : start+6] {\n108|\t\tvar digit byte\n109|\t\tif b >= '0' && b <= '9' {\n110|\t\t\tdigit = b - '0'\n111|\t\t} else if b >= 'a' && b <= 'f' {\n112|\t\t\tdigit = b - 'a' + 10\n113|\t\t} else if b >= 'A' && b <= 'F' {\n114|\t\t\tdigit = b - 'A' + 10\n115|\t\t} else {\n116|\t\t\treturn 0, start, false\n117|\t\t}\n118|\t\tvalue = value*16 + uint16(digit)\n119|\t}\n120|\treturn value, start + 6, true\n121|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c561","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":267,"recorded_at":1780531400000529,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"call_id":"call_01a07ad23e7b7132a0f7fea6df841626","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/provhost/opdecode.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for the Section 7.3-7.7 operation\n15|// bodies. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the six refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing every\n18|// arm. A helper that fronted a constructor would collapse distinct rules\n19|// into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer: Section\n22|// 7.5 counts and Section 5.1 limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// unknownMember names a member outside the closed set, if any.\n26|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n27|\tfor name := range members {\n28|\t\tif !allowed[name] {\n29|\t\t\treturn name, true\n30|\t\t}\n31|\t}\n32|\treturn \"\", false\n33|}\n34|\n35|// missingMember names the first required member with no value, if any.\n36|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n37|\tfor _, name := range required {\n38|\t\tif _, present := members[name]; !present {\n39|\t\t\treturn name, true\n40|\t\t}\n41|\t}\n42|\treturn \"\", false\n43|}\n44|\n45|// rawString reads a JSON string member.\n46|func rawString(raw json.RawMessage) (string, bool) {\n47|\tvar value string\n48|\tif err := json.Unmarshal(raw, &value); err != nil {\n49|\t\treturn \"\", false\n50|\t}\n51|\treturn value, true\n52|}\n53|\n54|// rawBool reads a JSON boolean member.\n55|func rawBool(raw json.RawMessage) (bool, bool) {\n56|\tvar value bool\n57|\tif err := json.Unmarshal(raw, &value); err != nil {\n58|\t\treturn false, false\n59|\t}\n60|\treturn value, true\n61|}\n62|\n63|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n64|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n65|// even when it names the same mathematical value: the canonical bodies\n66|// carry counts, never measurements.\n67|func rawUint53(raw json.RawMessage) (uint64, bool) {\n68|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n69|\tdecoder.UseNumber()\n70|\tvar value any\n71|\tif err := decoder.Decode(&value); err != nil {\n72|\t\treturn 0, false\n73|\t}\n74|\tnumber, ok := value.(json.Number)\n75|\tif !ok {\n76|\t\treturn 0, false\n77|\t}\n78|\tliteral := number.String()\n79|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n80|\t\treturn 0, false\n81|\t}\n82|\tparsed, err := strconv.ParseUint(literal, 10, 64)\n83|\tif err != nil || parsed > maxUint53 {\n84|\t\treturn 0, false\n85|\t}\n86|\treturn parsed, true\n87|}\n88|\n89|// rawNullableString reads a JSON string-or-null member: null reports\n90|// isNull without a value, any other non-string reports !ok.\n91|func rawNullableString(raw json.RawMessage) (value string, isNull bool, ok bool) {\n92|\tif string(raw) == \"null\" {\n93|\t\treturn \"\", true, true\n94|\t}\n95|\tvalue, ok = rawString(raw)\n96|\treturn value, false, ok\n97|}\n98|\n99|// rawArray reads a JSON array member into its raw elements. Null is not\n100|// an array: every array member in Sections 7.3-7.5 is required.\n101|func rawArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n102|\tif string(bytes.TrimSpace(raw)) == \"null\" {\n103|\t\treturn nil, false\n104|\t}\n105|\tvar elements []json.RawMessage\n106|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&elements); err != nil {\n109|\t\treturn nil, false\n110|\t}\n111|\tif elements == nil {\n112|\t\treturn []json.RawMessage{}, true\n113|\t}\n114|\treturn elements, true\n115|}\n116|\n117|// rawStringArray reads an array whose every element is a JSON string.\n118|func rawStringArray(raw json.RawMessage) ([]string, bool) {\n119|\telements, ok := rawArray(raw)\n120|\tif !ok {\n121|\t\treturn nil, false\n122|\t}\n123|\tout := make([]string, 0, len(elements))\n124|\tfor _, element := range elements {\n125|\t\tvalue, ok := rawString(element)\n126|\t\tif !ok {\n127|\t\t\treturn nil, false\n128|\t\t}\n129|\t\tout = append(out, value)\n130|\t}\n131|\treturn out, true\n132|}\n133|\n134|// sortedUniqueStrings reports whether the values are in strictly\n135|// increasing bytewise order: sorted with no duplicates. Bytewise order\n136|// is the canonical-form order every closed array in Sections 7.3-7.5\n137|// is written in.\n138|func sortedUniqueStrings(values []string) bool {\n139|\treturn sort.StringsAreSorted(values) && !hasDuplicateString(values)\n140|}\n141|\n142|func hasDuplicateString(values []string) bool {\n143|\tfor i := 1; i < len(values); i++ {\n144|\t\tif values[i] == values[i-1] {\n145|\t\t\treturn true\n146|\t\t}\n147|\t}\n148|\treturn false\n149|}\n150|\n151|// runeLength reports the Unicode-character length the Section 7 string\n152|// bounds count in. JSON transport is UTF-8, so characters are runes,\n153|// not bytes and not code units.\n154|func runeLength(value string) int {\n155|\treturn utf8.RuneCountInString(value)\n156|}\n157|