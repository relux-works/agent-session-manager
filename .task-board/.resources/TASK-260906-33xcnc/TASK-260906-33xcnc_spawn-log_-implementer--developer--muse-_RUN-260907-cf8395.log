{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c50d","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":225,"recorded_at":1780531400000445,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"dc3c2a17-9a8e-49f7-8fb3-fa0f426505c9"},"task_id":"dc3c2a17-9a8e-49f7-8fb3-fa0f426505c9","event":{"kind":"output","task_id":"dc3c2a17-9a8e-49f7-8fb3-fa0f426505c9","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/frame_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n18|)\n19|\n20|// This file is the cross-facade frame-agreement battery. Every\n21|// Section 7.8, 7.9, and provider-protocol body crosses a strict\n22|// object decoder before any member is trusted, and each facade\n23|// carries its own copy of that decoder (ledgered in\n24|// census_test.go). The battery drives one shared corpus through\n25|// all five judges — environ.DecodeStrictObject,\n26|// sessadapter.DecodeTuple, dirnode.CheckScanRequest,\n27|// provhost.DecodeManifest, and canonicaljson.Canonicalize — and\n28|// requires the ledgered verdict at each.\n29|//\n30|// A row whose reached arm cannot be determined fails, never\n31|// passes: frame-fault rows assert the full rendering (the fault\n32|// detail phrase in the refusal text), and accept rows assert the\n33|// body travels past the frame gate (an accept, or a refusal at a\n34|// named later arm with the frame phrase asserted absent). A code\n35|//-only assertion would conflate the frame gate with the member\n36|// gates behind it, which carry the same refusal code.\n37|//\n38|// The roster fails closed in both directions: every fault detail\n39|// derived from environ production must own at least one row, and\n40|// a row naming a detail production no longer derives fails as\n41|// orphaned. Expected verdicts are ledgered per judge, so a\n42|// verdict flip in EITHER direction — a fix or a regression —\n43|// reddens its row instead of passing silently.\n44|\n45|// frameRow is one corpus vector with the ledgered verdict at\n46|// every judge. A refuse expectation names the refusal text the\n47|// verdict must contain; an accept expectation names a later-arm\n48|// text the verdict must contain (\"\" with accept=true means the\n49|// entry itself accepts). canonicalRefuse nil means the\n50|// canonicalizer is not judged on this row: it validates JSON\n51|// values, not closed objects, so object-shape faults\n52|// (non-object, duplicate, trailing) are outside the decoder\n53|// rules it shares with the facades.\n54|type frameRow struct {\n55|\tfault string\n56|\tname  string\n57|\tbody  []byte\n58|\n59|\t// Per-judge bodies override body where an entry needs a\n60|\t// shaped vector (accept controls): nil means the shared\n61|\t// minimal body, which every frame gate refuses before any\n62|\t// member is read.\n63|\tsessBody []byte\n64|\tdirBody  []byte\n65|\tprovBody []byte\n66|\n67|\tenvironRefuse string\n68|\tenvironMember string\n69|\n70|\tsessAccept bool\n71|\tsessText   string\n72|\tsessAbsent string\n73|\n74|\tdirAccept bool\n75|\tdirText   string\n76|\tdirAbsent string\n77|\n78|\tprovAccept bool\n79|\tprovText   string\n80|\tprovAbsent string\n81|\n82|\tcanonicalRefuse *bool\n83|}\n84|\n85|func boolPointer(value bool) *bool {\n86|\treturn &value\n87|}\n88|\n89|// frameCorpus is the shared fault corpus. Surrogate subclasses\n90|// enumerate the full shape of the gate: bare highs and lows,\n91|// mispairs, truncated and malformed escapes, paired controls,\n92|// backslash-run parity (runs of 1..3 backslashes before the\n93|// escape, in value, member-name, and nested positions), and the\n94|// composed shapes an even run plus a FOLLOWING real escape. Run\n95|// parity plus composition proves both directions of the old\n96|// raw-scan divergence instead of one: a `\\u` sequence behind an\n97|// odd run is a real escape every judge refuses when lone, while\n98|// the same sequence behind an even run is quoted text the frame\n99|// gate admits (the member arms behind it still refuse the\n100|// minimal bodies, with the frame phrase asserted absent). The\n101|// composed rows close the sampling hole the first battery left:\n102|// an even run followed by a real lone escape is refused by the\n103|// string walk, while the raw scan misread the quoted text as a\n104|// high surrogate, paired it with the following real escape, and\n105|// admitted a body encoding/json silently rewrote to U+FFFD.\n106|func frameCorpus() []frameRow {\n107|\tpairVersion := `\"environment_version\":\"A\\uD83D\\uDE00B\"`\n108|\tpairTuple := []byte(strings.Replace(validTupleJSON(), `\"environment_version\":\"2.1.0\"`, pairVersion, 1))\n109|\tpairCursor := validScanRequestJSON(`\"A\\uD83D\\uDE00B\"`)\n110|\trows := []frameRow{\n111|\t\t{\n112|\t\t\tfault: environ.FaultNotUTF8, name: \"non-utf8 bytes\",\n113|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"a\\xff\\\"}\"),\n114|\t\t\tenvironRefuse: environ.FaultNotUTF8,\n115|\t\t\tsessText:      environ.FaultNotUTF8, dirText: environ.FaultNotUTF8, provText: environ.FaultNotUTF8,\n116|\t\t\tcanonicalRefuse: boolPointer(true),\n117|\t\t},\n118|\t\t{\n119|\t\t\tfault: environ.FaultLoneSurrogate, name: \"bare high escape\",\n120|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\ud800B\\\"}\"),\n121|\t\t\tenvironRefuse: environ.FaultLoneSurrogate,\n122|\t\t\tsessText:      environ.FaultLoneSurrogate, dirText: environ.FaultLoneSurrogate, provText: environ.FaultLoneSurrogate,\n123|\t\t\tcanonicalRefuse: boolPointer(true),\n124|\t\t},\n125|\t\t{\n126|\t\t\tfault: environ.FaultLoneSurrogate, name: \"bare low escape\",\n127|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\udc00B\\\"}\"),\n128|\t\t\tenvironRefuse: environ.FaultLoneSurrogate,\n129|\t\t\tsessText:      environ.FaultLoneSurrogate, dirText: environ.FaultLoneSurrogate, provText: environ.FaultLoneSurrogate,\n130|\t\t\tcanonicalRefuse: boolPointer(true),\n131|\t\t},\n132|\t\t{\n133|\t\t\tfault: environ.FaultLoneSurrogate, name: \"high followed by non-low\",\n134|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83D\\\\u0041B\\\"}\"),\n135|\t\t\tenvironRefuse: environ.FaultLoneSurrogate,\n136|\t\t\tsessText:      environ.FaultLoneSurrogate, dirText: environ.FaultLoneSurrogate, provText: environ.FaultLoneSurrogate,\n137|\t\t\tcanonicalRefuse: boolPointer(true),\n138|\t\t},\n139|\t\t{\n140|\t\t\t// Truncated and malformed escapes are not well-formed\n141|\t\t\t// \\uXXXX escapes, so the surrogate gate passes them\n142|\t\t\t// to the syntax arms on every judge.\n143|\t\t\tfault: environ.FaultNotObject, name: \"truncated escape falls to syntax\",\n144|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uD83\\\"}\"),\n145|\t\t\tenvironRefuse: environ.FaultNotObject, environMember: \"v\",\n146|\t\t\tsessText: \"environment tuple not a JSON object\", sessAbsent: environ.FaultLoneSurrogate,\n147|\t\t\tdirText: \"scan request not a JSON object\", dirAbsent: environ.FaultLoneSurrogate,\n148|\t\t\tprovText:        environ.FaultNotObject,\n149|\t\t\tcanonicalRefuse: boolPointer(true),\n150|\t\t},\n151|\t\t{\n152|\t\t\tfault: environ.FaultNotObject, name: \"malformed escape falls to syntax\",\n153|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\uDEFG B\\\"}\"),\n154|\t\t\tenvironRefuse: environ.FaultNotObject, environMember: \"v\",\n155|\t\t\tsessText: \"environment tuple not a JSON object\", sessAbsent: environ.FaultLoneSurrogate,\n156|\t\t\tdirText: \"scan request not a JSON object\", dirAbsent: environ.FaultLoneSurrogate,\n157|\t\t\tprovText:        environ.FaultNotObject,\n158|\t\t\tcanonicalRefuse: boolPointer(true),\n159|\t\t},\n160|\t\t{\n161|\t\t\t// An even backslash run quotes the following text:\n162|\t\t\t// the frame gate admits and the member arms refuse,\n163|\t\t\t// with the frame phrase asserted absent. Before the\n164|\t\t\t// facade delegation the raw scan refused these at\n165|\t\t\t// the surrogate arm; the flip is the recorded fix.\n166|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash high run2\",\n167|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800B\\\"}\"),\n168|\t\t\tsessText: \"environment tuple carries unknown member\", sessAbsent: environ.FaultLoneSurrogate,\n169|\t\t\tdirText: \"scan request carries unknown member\", dirAbsent: environ.FaultLoneSurrogate,\n170|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n171|\t\t\tcanonicalRefuse: boolPointer(false),\n172|\t\t},\n173|\t\t{\n174|\t\t\t// Run 3 is an escaped backslash followed by a REAL\n175|\t\t\t// lone escape (value `A\\` plus U+D800), so every\n176|\t\t\t// judge refuses: odd runs escape, even runs quote.\n177|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash high run3\",\n178|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\\\\\ud800B\\\"}\"),\n179|\t\t\tenvironRefuse: environ.FaultLoneSurrogate,\n180|\t\t\tsessText:      environ.FaultLoneSurrogate, dirText: environ.FaultLoneSurrogate, provText: environ.FaultLoneSurrogate,\n181|\t\t\tcanonicalRefuse: boolPointer(true),\n182|\t\t},\n183|\t\t{\n184|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash low run2\",\n185|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\udc00B\\\"}\"),\n186|\t\t\tsessText: \"environment tuple carries unknown member\", sessAbsent: environ.FaultLoneSurrogate,\n187|\t\t\tdirText: \"scan request carries unknown member\", dirAbsent: environ.FaultLoneSurrogate,\n188|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n189|\t\t\tcanonicalRefuse: boolPointer(false),\n190|\t\t},\n191|\t\t{\n192|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash pair run2\",\n193|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\uD83D\\\\\\\\uDE00B\\\"}\"),\n194|\t\t\tsessText: \"environment tuple carries unknown member\", sessAbsent: environ.FaultLoneSurrogate,\n195|\t\t\tdirText: \"scan request carries unknown member\", dirAbsent: environ.FaultLoneSurrogate,\n196|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n197|\t\t\tcanonicalRefuse: boolPointer(false),\n198|\t\t},\n199|\t\t{\n200|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash in member name\",\n201|\t\t\tbody:     []byte(\"{\\\"A\\\\\\\\ud800B\\\":1}\"),\n202|\t\t\tsessText: \"environment tuple carries unknown member\", sessAbsent: environ.FaultLoneSurrogate,\n203|\t\t\tdirText: \"scan request carries unknown member\", dirAbsent: environ.FaultLoneSurrogate,\n204|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n205|\t\t\tcanonicalRefuse: boolPointer(false),\n206|\t\t},\n207|\t\t{\n208|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash nested\",\n209|\t\t\tbody:     []byte(\"{\\\"v\\\":{\\\"w\\\":\\\"A\\\\\\\\ud800B\\\"}}\"),\n210|\t\t\tsessText: \"environment tuple carries unknown member\", sessAbsent: environ.FaultLoneSurrogate,\n211|\t\t\tdirText: \"scan request carries unknown member\", dirAbsent: environ.FaultLoneSurrogate,\n212|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n213|\t\t\tcanonicalRefuse: boolPointer(false),\n214|\t\t},\n215|\t\t{\n216|\t\t\t// An even run followed by a REAL lone low escape:\n217|\t\t\t// the string walk consumes the `\\\\` pair, reads\n218|\t\t\t// quoted text, then refuses the real lone escape.\n219|\t\t\t// The raw scan misread the quoted text as a high\n220|\t\t\t// surrogate, paired it with the real low escape,\n221|\t\t\t// and admitted the body. This row is the composed\n222|\t\t\t// shape the first battery never sampled.\n223|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash plus real lone low\",\n224|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800\\\\udc00B\\\"}\"),\n225|\t\t\tenvironRefuse: environ.FaultLoneSurrogate,\n226|\t\t\tsessText:      environ.FaultLoneSurrogate, dirText: environ.FaultLoneSurrogate, provText: environ.FaultLoneSurrogate,\n227|\t\t\tcanonicalRefuse: boolPointer(true),\n228|\t\t},\n229|\t\t{\n230|\t\t\t// The same composition with a real lone high\n231|\t\t\t// escape behind the even run: every judge refuses.\n232|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash plus real lone high\",\n233|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"A\\\\\\\\udc00\\\\ud800B\\\"}\"),\n234|\t\t\tenvironRefuse: environ.FaultLoneSurrogate,\n235|\t\t\tsessText:      environ.FaultLoneSurrogate, dirText: environ.FaultLoneSurrogate, provText: environ.FaultLoneSurrogate,\n236|\t\t\tcanonicalRefuse: boolPointer(true),\n237|\t\t},\n238|\t\t{\n239|\t\t\t// An even run followed by a REAL pair: the frame\n240|\t\t\t// gate admits on every judge and the member arms\n241|\t\t\t// refuse, with the frame phrase asserted absent.\n242|\t\t\t// Before the facade delegation the raw scan\n243|\t\t\t// refused this at the surrogate arm (it misread\n244|\t\t\t// the quoted text as a high surrogate followed by\n245|\t\t\t// a non-low), so this row proves the composed\n246|\t\t\t// shape on the over-strict side too.\n247|\t\t\tfault: environ.FaultLoneSurrogate, name: \"escaped backslash plus real pair\",\n248|\t\t\tbody:     []byte(\"{\\\"v\\\":\\\"A\\\\\\\\ud800\\\\uD83D\\\\uDE00B\\\"}\"),\n249|\t\t\tsessText: \"environment tuple carries unknown member\", sessAbsent: environ.FaultLoneSurrogate,\n250|\t\t\tdirText: \"scan request carries unknown member\", dirAbsent: environ.FaultLoneSurrogate,\n251|\t\t\tprovText: \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n252|\t\t\tcanonicalRefuse: boolPointer(false),\n253|\t\t},\n254|\t\t{\n255|\t\t\tfault: environ.FaultDuplicate, name: \"duplicate member\",\n256|\t\t\tbody:          []byte(\"{\\\"v\\\":1,\\\"v\\\":2}\"),\n257|\t\t\tenvironRefuse: environ.FaultDuplicate, environMember: \"v\",\n258|\t\t\tsessText: environ.FaultDuplicate, dirText: environ.FaultDuplicate, provText: environ.FaultDuplicate,\n259|\t\t},\n260|\t\t{\n261|\t\t\tfault: environ.FaultTrailing, name: \"trailing data\",\n262|\t\t\tbody:          []byte(\"{\\\"v\\\":1} {}\"),\n263|\t\t\tenvironRefuse: environ.FaultTrailing,\n264|\t\t\tsessText:      environ.FaultTrailing, dirText: environ.FaultTrailing, provText: environ.FaultTrailing,\n265|\t\t},\n266|\t\t{\n267|\t\t\tfault: environ.FaultNotObject, name: \"non-object top level\",\n268|\t\t\tbody:          []byte(\"[1,2]\"),\n269|\t\t\tenvironRefuse: environ.FaultNotObject,\n270|\t\t\tsessText:      environ.FaultNotObject, dirText: environ.FaultNotObject, provText: environ.FaultNotObject,\n271|\t\t},\n272|\t\t{\n273|\t\t\tfault: environ.FaultNotObject, name: \"unterminated string is syntax\",\n274|\t\t\tbody:          []byte(\"{\\\"v\\\":\\\"abc\"),\n275|\t\t\tenvironRefuse: environ.FaultNotObject, environMember: \"v\",\n276|\t\t\tsessText: environ.FaultNotObject, dirText: environ.FaultNotObject, provText: environ.FaultNotObject,\n277|\t\t\tcanonicalRefuse: boolPointer(true),\n278|\t\t},\n279|\t\t{\n280|\t\t\tfault: environ.FaultLoneSurrogate, name: \"paired surrogates admit\",\n281|\t\t\tbody:       []byte(`{\"v\":\"A\\uD83D\\uDE00B\"}`),\n282|\t\t\tsessBody:   pairTuple,\n283|\t\t\tdirBody:    pairCursor,\n284|\t\t\tprovBody:   []byte(`{\"note\":\"A\\uD83D\\uDE00B\"}`),\n285|\t\t\tsessAccept: true,\n286|\t\t\tdirAccept:  true,\n287|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: environ.FaultLoneSurrogate,\n288|\t\t\tcanonicalRefuse: boolPointer(false),\n289|\t\t},\n290|\t\t{\n291|\t\t\tfault: environ.FaultNotUTF8, name: \"multibyte text admits\",\n292|\t\t\tbody:       []byte(\"{\\\"v\\\":\\\"plain ü ☃\\\"}\"),\n293|\t\t\tsessBody:   pairTuple,\n294|\t\t\tdirBody:    pairCursor,\n295|\t\t\tprovBody:   []byte(\"{\\\"note\\\":\\\"plain ü ☃\\\"}\"),\n296|\t\t\tsessAccept: true,\n297|\t\t\tdirAccept:  true,\n298|\t\t\tprovText:   \"manifest carries unknown member\", provAbsent: environ.FaultNotUTF8,\n299|\t\t\tcanonicalRefuse: boolPointer(false),\n300|\t\t},\n301|\t}\n302|\treturn rows\n303|}\n304|\n305|// deriveFaultDetails derives the frame-fault space from environ\n306|// production: every Fault* constant value in decode.go. A sixth\n307|// fault shape fails the roster below instead of passing\n308|// unrostered.\n309|func deriveFaultDetails(t *testing.T) map[string]bool {\n310|\tt.Helper()\n311|\tpath := filepath.Join(mustGetwd(t), \"decode.go\")\n312|\tsource, err := os.ReadFile(path)\n313|\tif err != nil {\n314|\t\tt.Fatalf(\"faults: %v\", err)\n315|\t}\n316|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n317|\tif err != nil {\n318|\t\tt.Fatalf(\"faults: %v\", err)\n319|\t}\n320|\tdetails := map[string]bool{}\n321|\tfor _, decl := range syntax.Decls {\n322|\t\tnode, ok := decl.(*ast.GenDecl)\n323|\t\tif !ok {\n324|\t\t\tcontinue\n325|\t\t}\n326|\t\tfor _, spec := range node.Specs {\n327|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n328|\t\t\tif !ok {\n329|\t\t\t\tcontinue\n330|\t\t\t}\n331|\t\t\tfor index, name := range value.Names {\n332|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n333|\t\t\t\t\tcontinue\n334|\t\t\t\t}\n335|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n336|\t\t\t\tif !ok {\n337|\t\t\t\t\tt.Fatalf(\"faults: %s is not a literal; the extractor cannot see through indirection\", name.Name)\n338|\t\t\t\t}\n339|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n340|\t\t\t\tif err != nil {\n341|\t\t\t\t\tt.Fatalf(\"faults: %v\", err)\n342|\t\t\t\t}\n343|\t\t\t\tdetails[text] = true\n344|\t\t\t}\n345|\t\t}\n346|\t}\n347|\tif len(details) == 0 {\n348|\t\tt.Fatal(\"faults derived zero details; the scanner is blind, not the space empty\")\n349|\t}\n350|\treturn details\n351|}\n352|\n353|func mustGetwd(t *testing.T) string {\n354|\tt.Helper()\n355|\tdirectory, err := os.Getwd()\n356|\tif err != nil {\n357|\t\tt.Fatalf(\"frame: %v\", err)\n358|\t}\n359|\treturn directory\n360|}\n361|\n362|// TestFrameFaultRosterIsClosed requires every derived fault\n363|// detail to own at least one row, and every row to name a\n364|// derived detail.\n365|func TestFrameFaultRosterIsClosed(t *testing.T) {\n366|\tdetails := deriveFaultDetails(t)\n367|\tcovered := map[string]bool{}\n368|\tfor _, row := range frameCorpus() {\n369|\t\tif row.fault == \"\" {\n370|\t\t\tt.Fatalf(\"row %q names no fault detail\", row.name)\n371|\t\t}\n372|\t\tif !details[row.fault] {\n373|\t\t\tt.Fatalf(\"row %q names underived detail %q\", row.name, row.fault)\n374|\t\t}\n375|\t\tcovered[row.fault] = true\n376|\t}\n377|\tfor detail := range details {\n378|\t\tif !covered[detail] {\n379|\t\t\tt.Errorf(\"derived fault detail %q owns no corpus row\", detail)\n380|\t\t}\n381|\t}\n382|}\n383|\n384|// TestFrameAgreementAcrossFacades drives the shared corpus\n385|// through all five judges and requires the ledgered verdict at\n386|// each. environ rows assert the exact fault and member; facade\n387|// rows assert the full frame rendering (the detail phrase in the\n388|// refusal text) or, for accept rows, travel past the frame gate\n389|// with the frame phrase asserted absent; canonical rows assert\n390|// the verdict only, where the canonicalizer shares the rule.\n391|func TestFrameAgreementAcrossFacades(t *testing.T) {\n392|\tfor _, row := range frameCorpus() {\n393|\t\tt.Run(row.name, func(t *testing.T) {\n394|\t\t\t_, fault := environ.DecodeStrictObject(row.body)\n395|\t\t\tif row.environRefuse == \"\" {\n396|\t\t\t\tif fault != nil {\n397|\t\t\t\t\tt.Fatalf(\"environ refused %q: %v\", row.body, fault)\n398|\t\t\t\t}\n399|\t\t\t} else {\n400|\t\t\t\tif fault == nil {\n401|\t\t\t\t\tt.Fatalf(\"environ admitted %q, want fault %q\", row.body, row.environRefuse)\n402|\t\t\t\t}\n403|\t\t\t\tif fault.Detail != row.environRefuse || fault.Member != row.environMember {\n404|\t\t\t\t\tt.Fatalf(\"environ fault = (%q, %q), want (%q, %q)\", fault.Detail, fault.Member, row.environRefuse, row.environMember)\n405|\t\t\t\t}\n406|\t\t\t}\n407|\t\t\tsessBody := orBody(row.body, row.sessBody)\n408|\t\t\tdirBody := orBody(row.body, row.dirBody)\n409|\t\t\tprovBody := orBody(row.body, row.provBody)\n410|\t\t\tassertFacadeVerdict(t, \"sessadapter\", sessBody, row.sessAccept, row.sessText, row.sessAbsent, func(body []byte) error {\n411|\t\t\t\t_, err := sessadapter.DecodeTuple(body)\n412|\t\t\t\treturn err\n413|\t\t\t})\n414|\t\t\tassertFacadeVerdict(t, \"dirnode\", dirBody, row.dirAccept, row.dirText, row.dirAbsent, func(body []byte) error {\n415|\t\t\t\t_, err := dirnode.CheckScanRequest(body)\n416|\t\t\t\treturn err\n417|\t\t\t})\n418|\t\t\tassertFacadeVerdict(t, \"provhost\", provBody, row.provAccept, row.provText, row.provAbsent, func(body []byte) error {\n419|\t\t\t\treturn provhost.DecodeManifest(body)\n420|\t\t\t})\n421|\t\t\tif row.canonicalRefuse != nil {\n422|\t\t\t\t_, err := canonicaljson.Canonicalize(row.body)\n423|\t\t\t\tif (*row.canonicalRefuse && err == nil) || (!*row.canonicalRefuse && err != nil) {\n424|\t\t\t\t\tt.Fatalf(\"canonicaljson verdict = refuse=%v, want refuse=%v (err=%v)\", err != nil, *row.canonicalRefuse, err)\n425|\t\t\t\t}\n426|\t\t\t}\n427|\t\t})\n428|\t}\n429|}\n430|\n431|// orBody selects the per-judge override body when present.\n432|func orBody(shared, override []byte) []byte {\n433|\tif override != nil {\n434|\t\treturn override\n435|\t}\n436|\treturn shared\n437|}\n438|\n439|// assertFacadeVerdict requires the ledgered verdict at one\n440|// facade entry: an accept, or a refusal whose text contains the\n441|// frame phrase (and never contains the absent phrase, which\n442|// pins travel past a gate the body must cross).\n443|func assertFacadeVerdict(t *testing.T, facade string, body []byte, accept bool, text, absent string, drive func([]byte) error) {\n444|\tt.Helper()\n445|\terr := drive(body)\n446|\tif accept {\n447|\t\tif err != nil {\n448|\t\t\tt.Fatalf(\"%s refused %q, want accept: %v\", facade, body, err)\n449|\t\t}\n450|\t\treturn\n451|\t}\n452|\tif err == nil {\n453|\t\tt.Fatalf(\"%s admitted %q, want refusal containing %q\", facade, body, text)\n454|\t}\n455|\tif text != \"\" && !strings.Contains(err.Error(), text) {\n456|\t\tt.Fatalf(\"%s error = %v, want text containing %q\", facade, err, text)\n457|\t}\n458|\tif absent != \"\" && strings.Contains(err.Error(), absent) {\n459|\t\tt.Fatalf(\"%s error = %v, must not contain %q\", facade, err, absent)\n460|\t}\n461|}"}}}
