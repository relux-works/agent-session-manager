{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c507","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":222,"recorded_at":1780531400000439,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.started","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"d962eb10-52b0-4db3-b510-983659ef8b5d"},"task_id":"d962eb10-52b0-4db3-b510-983659ef8b5d","event":{"kind":"started","task_id":"d962eb10-52b0-4db3-b510-983659ef8b5d","span_id":"b3a57a2edfa191f1"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c509","stream":{"kind":"session","id":"01a07ad1-a1d4-7930-bd79-ab0e292ff17b"},"sequence":223,"recorded_at":1780531400000441,"record_type":"event","durability":"durable","causation_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a","run_stream":{"kind":"run","id":"4a3137a2-c6ac-464f-873d-2d1baea0e15a"},"task_stream":{"kind":"task","id":"e25db0f6-b3ac-43a3-9ee4-daa5b784b16a"},"task_id":"e25db0f6-b3ac-43a3-9ee4-daa5b784b16a","event":{"kind":"output","task_id":"e25db0f6-b3ac-43a3-9ee4-daa5b784b16a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/environ/shape_census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|)\n14|\n15|// This file is the shape layer of the shared-implementation\n16|// census. The name layer in census_test.go derives function and\n17|// method declarations by identifier and requires the derived set\n18|// to equal the ledger: it catches renames, removals, and copies\n19|// that reuse a ledgered name, but it cannot see a copy under a\n20|// fresh spelling, a new byte-counting measure, or a var-bound\n21|// alias. This layer derives implementation SHAPE from production\n22|// source and requires every shape hit to be a registered row:\n23|// a fresh spelling with the same implementation texture fails\n24|// here as an unregistered site.\n25|//\n26|// Shape space (each proven by a synthetic control in\n27|// TestShapeCensusCatchesControls, which drives the same pure\n28|// extractor the production test runs on the real tree):\n29|//\n30|//   - strict-decoder: a function that builds an encoding/json\n31|//     decoder (NewDecoder or Unmarshal) and carries a duplicate\n32|//     signal (a \"duplicate\"+\"member\" literal or a *uplicate\n33|//     identifier) in its own body or in a same-package callee.\n34|//     The callee arm covers decoders split across two local\n35|//     functions; a decoder split across packages is reuse, not\n36|//     a copy, and is not derived.\n37|//   - surrogate-gate: a function whose body holds a surrogate\n38|//     range literal (0xD800, 0xDBFF, 0xDC00, 0xDFFF in any base)\n39|//     or an identifier naming one (a *urrogate* token), or that\n40|//     references a package-level constant whose value is a\n41|//     surrogate range literal. Callers of a ledgered gate (the\n42|//     environ decoder, scalar's string decoder) trip the token\n43|//     arm and are registered as callers, not gates.\n44|//   - string-measure: a function that counts runes directly\n45|//     (a RuneCountInString/RuneCount selector).\n46|//   - byte-measure: a function with a string parameter it\n47|//     applies len() to and exactly one int result (the\n48|//     func(string)->int texture), or a function that applies\n49|//     len() to a variable assigned from a rawString() call (the\n50|//     verdict-style texture). Verdict-style measures that reuse\n51|//     a registered measure helper (stringLength and friends)\n52|//     are reuse, not copies, and are not derived.\n53|//   - var-alias: a package-level var that rebinds a ledgered\n54|//     shared-rule name, that binds a closure carrying any shape\n55|//     above, or that aliases a shape-positive local function.\n56|//     Binding an imported canonical helper under a fresh name\n57|//     (`var f = environ.StringLength`) is reuse and is clean.\n58|//\n59|// Stated residue. A decoder that never touches encoding/json (a\n60|// hand-rolled scanner with its own duplicate rule), a gate whose\n61|// bounds are derived arithmetically under fresh names with no\n62|// surrogate token anywhere, a byte measure over a non-string\n63|// parameter type, and a new grammar literal outside the four\n64|// known classes are not derived here. Each is named so the next\n65|// copy in one of those textures fails loudly by extending the\n66|// extractor, not silently.\n67|\n68|// shapeSite is one shape-derived shared-rule implementation.\n69|type shapeSite struct {\n70|\tclass  string\n71|\tpkg    string\n72|\tfile   string\n73|\tsymbol string\n74|}\n75|\n76|func (site shapeSite) key() string {\n77|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n78|}\n79|\n80|// surrogateBounds is the UTF-16 surrogate range: any integer\n81|// literal with one of these values is a gate bound.\n82|var surrogateBounds = map[uint64]bool{\n83|\t0xD800: true,\n84|\t0xDBFF: true,\n85|\t0xDC00: true,\n86|\t0xDFFF: true,\n87|}\n88|\n89|// shapeLedger registers every shape hit in the census scope with\n90|// the rationale that keeps it honest. Canonical owners are the\n91|// single implementation new code must use; every other row names\n92|// the behavioral battery that pins it to the canonical\n93|// semantics. An unregistered hit fails the census; an orphaned\n94|// row fails it too.\n95|var shapeLedger = map[string]string{\n96|\t// Strict decoders: one JSON entry point per owner plus the\n97|\t// two envelope decoders that reach one.\n98|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":    \"canonical owner: string-walk surrogate semantics, rune measure\",\n99|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\": \"string-aware walk, pinned by frame_agreement_test.go\",\n100|\t\"strict-decoder|provhost|protocol.go|DecodeResponse\":     \"response-envelope decoder over decodeStrictObject, pinned by provhost protocol tests\",\n101|\t\"strict-decoder|provhost|status.go|DecodeStatusOutcome\":  \"status-envelope decoder over decodeStrictObject, pinned by provhost status tests\",\n102|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\": \"canonicalizer entry over decodeValue, pinned by frame_agreement_test.go\",\n103|\t// Surrogate gates and their registered callers.\n104|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n105|\t\"surrogate-gate|environ|decode.go|DecodeStrictObject\":                \"caller: owns the gate call, pinned by frame_agreement_test.go\",\n106|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n107|\t\"surrogate-gate|provhost|protocol.go|decodeStrictObject\":             \"caller: owns the gate call, pinned by frame_agreement_test.go\",\n108|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n109|\t\"surrogate-gate|canonicaljson|canonical.go|decodeStrict\":             \"caller: owns the gate call, pinned by frame_agreement_test.go\",\n110|\t\"surrogate-gate|scalar|scalar.go|hasLoneJSONSurrogate\":               \"third spelling (raw scan, scalar-owned): unification tracked in the cross-story follow-up, behaviorally unpinned here\",\n111|\t\"surrogate-gate|scalar|scalar.go|decodeJSONString\":                   \"caller: owns the scalar gate call, pinned by the scalar suite\",\n112|\t// Rune measures: one per package plus the canonicalizer's\n113|\t// internal bounded-string helpers, which the name census\n114|\t// never saw under their fresh spellings.\n115|\t\"string-measure|environ|decode.go|StringLength\":                               \"canonical owner: runes per Section 1.6\",\n116|\t\"string-measure|provhost|opdecode.go|runeLength\":                              \"runes, pinned by measure_agreement_test.go\",\n117|\t\"string-measure|sessadapter|decode.go|stringLength\":                           \"runes, pinned by measure_agreement_test.go\",\n118|\t\"string-measure|dirnode|decode.go|stringLength\":                               \"runes, pinned by measure_agreement_test.go\",\n119|\t\"string-measure|canonicaljson|closed_shapes.go|requireBoundedString\":          \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n120|\t\"string-measure|canonicaljson|closed_shapes.go|validateBlobDescriptor\":        \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n121|\t\"string-measure|canonicaljson|closed_shapes.go|validateManifestEntries\":       \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n122|\t\"string-measure|canonicaljson|core_records.go|nullableBoundedString\":          \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n123|\t\"string-measure|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"canonicalizer-internal rune bound, pinned by identity_agreement_test.go opaque rows\",\n124|\t\"string-measure|scalar|path.go|ParseAbsolutePath\":                             \"grammar-owner path bound, pinned by the scalar suite\",\n125|\t// Byte measures: the two Section 5.1 exec gates.\n126|\t\"byte-measure|provhost|spawn.go|checkSpawnArgv\":        \"bytes by specification, pinned by TestByteBoundsStayBytes\",\n127|\t\"byte-measure|provhost|spawn.go|checkSpawnEnvLiterals\": \"bytes by specification, pinned by TestByteBoundsStayBytes\",\n128|}\n129|\n130|// packageShapes is the per-package extractor state: which local\n131|// functions carry a duplicate signal or a shape, and which\n132|// package-level constants hold surrogate bounds.\n133|type packageShapes struct {\n134|\tfuncDups   map[string]bool\n135|\tfuncShapes map[string][]string\n136|\tconstBound map[string]bool\n137|}\n138|\n139|// TestSharedShapesAreLedgered requires every shape-derived site\n140|// to be a registered row, and every row to be derived: an\n141|// unregistered copy fails as a unification violation, and a row\n142|// naming an implementation production no longer derives fails\n143|// as orphaned.\n144|func TestSharedShapesAreLedgered(t *testing.T) {\n145|\tderived := deriveShapeSites(t)\n146|\tfor key := range derived {\n147|\t\tif _, ok := shapeLedger[key]; !ok {\n148|\t\t\tt.Errorf(\"unregistered shared-rule copy %q: add one canonical implementation in internal/environ instead, or register the shape with its agreement battery\", key)\n149|\t\t}\n150|\t}\n151|\tfor key, rationale := range shapeLedger {\n152|\t\tif !derived[key] {\n153|\t\t\tt.Errorf(\"orphaned shape row %q (%s): production no longer derives it\", key, rationale)\n154|\t\t}\n155|\t}\n156|}\n157|\n158|// deriveShapeSites walks the census scope and derives every\n159|// shape site from production source.\n160|func deriveShapeSites(t *testing.T) map[string]bool {\n161|\tt.Helper()\n162|\troot, err := internalRoot(t)\n163|\tif err != nil {\n164|\t\tt.Fatalf(\"shapes: %v\", err)\n165|\t}\n166|\tsources := readScopeSources(t, root)\n167|\tsites := map[string]bool{}\n168|\tfor pkg, files := range sources {\n169|\t\tfor _, site := range shapeSitesInPackage(pkg, files) {\n170|\t\t\tsites[site.key()] = true\n171|\t\t}\n172|\t}\n173|\tif len(sites) == 0 {\n174|\t\tt.Fatal(\"shapes derived zero sites; the scanner is blind, not the tree clean\")\n175|\t}\n176|\treturn sites\n177|}\n178|\n179|// readScopeSources reads every production Go file in the census\n180|// packages into memory, keyed by package then file name.\n181|func readScopeSources(t *testing.T, root string) map[string]map[string][]byte {\n182|\tt.Helper()\n183|\tsources := map[string]map[string][]byte{}\n184|\tcount := 0\n185|\terr := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n186|\t\tif err != nil {\n187|\t\t\treturn err\n188|\t\t}\n189|\t\tif info.IsDir() || !strings.HasSuffix(path, \".go\") || strings.HasSuffix(path, \"_test.go\") {\n190|\t\t\treturn nil\n191|\t\t}\n192|\t\trel, err := filepath.Rel(root, path)\n193|\t\tif err != nil {\n194|\t\t\treturn err\n195|\t\t}\n196|\t\tparts := strings.Split(rel, string(filepath.Separator))\n197|\t\tpkg := parts[0]\n198|\t\tif !censusPackages[pkg] {\n199|\t\t\treturn nil\n200|\t\t}\n201|\t\tsource, err := os.ReadFile(path)\n202|\t\tif err != nil {\n203|\t\t\tt.Fatalf(\"shapes: read %s: %v\", path, err)\n204|\t\t}\n205|\t\tif sources[pkg] == nil {\n206|\t\t\tsources[pkg] = map[string][]byte{}\n207|\t\t}\n208|\t\tsources[pkg][parts[len(parts)-1]] = source\n209|\t\tcount++\n210|\t\treturn nil\n211|\t})\n212|\tif err != nil {\n213|\t\tt.Fatalf(\"shapes: walk: %v\", err)\n214|\t}\n215|\tif count == 0 {\n216|\t\tt.Fatal(\"shapes scanned zero files; the scanner is broken, not the tree\")\n217|\t}\n218|\treturn sources\n219|}\n220|\n221|// shapeSitesInPackage derives the shape sites of one package. It\n222|// is pure over its inputs, so the synthetic controls drive this\n223|// exact function on planted sources: a control that fails here\n224|// fails the production census by construction.\n225|func shapeSitesInPackage(pkg string, files map[string][]byte) []shapeSite {\n226|\tparsed := map[string]*ast.File{}\n227|\tfor file, source := range files {\n228|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), file, source, 0)\n229|\t\tif err != nil {\n230|\t\t\treturn []shapeSite{{class: \"parse-failure\", pkg: pkg, file: file, symbol: \"unparseable\"}}\n231|\t\t}\n232|\t\tparsed[file] = syntax\n233|\t}\n234|\tstate := &packageShapes{funcDups: map[string]bool{}, funcShapes: map[string][]string{}, constBound: map[string]bool{}}\n235|\tfor _, syntax := range parsed {\n236|\t\tfor _, decl := range syntax.Decls {\n237|\t\t\tswitch node := decl.(type) {\n238|\t\t\tcase *ast.FuncDecl:\n239|\t\t\t\tif node.Body == nil {\n240|\t\t\t\t\tcontinue\n241|\t\t\t\t}\n242|\t\t\t\tif bodyHasDupSignal(node.Body) {\n243|\t\t\t\t\tstate.funcDups[node.Name.Name] = true\n244|\t\t\t\t}\n245|\t\t\tcase *ast.GenDecl:\n246|\t\t\t\tfor _, spec := range node.Specs {\n247|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n248|\t\t\t\t\tif !ok {\n249|\t\t\t\t\t\tcontinue\n250|\t\t\t\t\t}\n251|\t\t\t\t\tfor index, name := range value.Names {\n252|\t\t\t\t\t\tif index >= len(value.Values) {\n253|\t\t\t\t\t\t\tcontinue\n254|\t\t\t\t\t\t}\n255|\t\t\t\t\t\tif literal, ok := value.Values[index].(*ast.BasicLit); ok && literal.Kind == token.INT {\n256|\t\t\t\t\t\t\tif magnitude, err := strconv.ParseUint(literal.Value, 0, 32); err == nil && surrogateBounds[magnitude] {\n257|\t\t\t\t\t\t\t\tstate.constBound[name.Name] = true\n258|\t\t\t\t\t\t\t}\n259|\t\t\t\t\t\t}\n260|\t\t\t\t\t}\n261|\t\t\t\t}\n262|\t\t\t}\n263|\t\t}\n264|\t}\n265|\tfor _, syntax := range parsed {\n266|\t\tfor _, decl := range syntax.Decls {\n267|\t\t\tnode, ok := decl.(*ast.FuncDecl)\n268|\t\t\tif !ok || node.Body == nil {\n269|\t\t\t\tcontinue\n270|\t\t\t}\n271|\t\t\t// Same-named methods union their shapes so the\n272|\t\t\t// alias resolution below is file-order\n273|\t\t\t// independent.\n274|\t\t\tunion := map[string]bool{}\n275|\t\t\tfor _, class := range state.funcShapes[node.Name.Name] {\n276|\t\t\t\tunion[class] = true\n277|\t\t\t}\n278|\t\t\tfor _, class := range funcShapeClasses(node.Body, node.Type, state) {\n279|\t\t\t\tunion[class] = true\n280|\t\t\t}\n281|\t\t\tvar merged []string\n282|\t\t\tfor class := range union {\n283|\t\t\t\tmerged = append(merged, class)\n284|\t\t\t}\n285|\t\t\tsort.Strings(merged)\n286|\t\t\tstate.funcShapes[node.Name.Name] = merged\n287|\t\t}\n288|\t}\n289|\tvar sites []shapeSite\n290|\tadd := func(class, file, symbol string) {\n291|\t\tsites = append(sites, shapeSite{class: class, pkg: pkg, file: file, symbol: symbol})\n292|\t}\n293|\tfor file, syntax := range parsed {\n294|\t\tfor _, decl := range syntax.Decls {\n295|\t\t\tswitch node := decl.(type) {\n296|\t\t\tcase *ast.FuncDecl:\n297|\t\t\t\tif node.Body == nil {\n298|\t\t\t\t\tcontinue\n299|\t\t\t\t}\n300|\t\t\t\t// Emission uses the file-local shapes; the\n301|\t\t\t\t// union map above serves alias resolution\n302|\t\t\t\t// only, so same-named methods never bleed\n303|\t\t\t\t// sites across files.\n304|\t\t\t\tfor _, class := range funcShapeClasses(node.Body, node.Type, state) {\n305|\t\t\t\t\tadd(class, file, node.Name.Name)\n306|\t\t\t\t}\n307|\t\t\t\tast.Inspect(node.Body, func(inner ast.Node) bool {\n308|\t\t\t\t\tliteral, ok := inner.(*ast.FuncLit)\n309|\t\t\t\t\tif !ok {\n310|\t\t\t\t\t\treturn true\n311|\t\t\t\t\t}\n312|\t\t\t\t\tfor _, class := range funcShapeClasses(literal.Body, literal.Type, state) {\n313|\t\t\t\t\t\tadd(class, file, node.Name.Name+\"$closure\")\n314|\t\t\t\t\t}\n315|\t\t\t\t\treturn true\n316|\t\t\t\t})\n317|\t\t\tcase *ast.GenDecl:\n318|\t\t\t\tfor _, spec := range node.Specs {\n319|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n320|\t\t\t\t\tif !ok {\n321|\t\t\t\t\t\tcontinue\n322|\t\t\t\t\t}\n323|\t\t\t\t\tfor _, name := range value.Names {\n324|\t\t\t\t\t\tif class, ok := sharedFunctionSymbols[name.Name]; ok {\n325|\t\t\t\t\t\t\tadd(class, file, name.Name)\n326|\t\t\t\t\t\t}\n327|\t\t\t\t\t\tfor _, rhs := range value.Values {\n328|\t\t\t\t\t\t\tswitch bound := rhs.(type) {\n329|\t\t\t\t\t\t\tcase *ast.FuncLit:\n330|\t\t\t\t\t\t\t\tfor _, class := range funcShapeClasses(bound.Body, bound.Type, state) {\n331|\t\t\t\t\t\t\t\t\tadd(class, file, name.Name)\n332|\t\t\t\t\t\t\t\t}\n333|\t\t\t\t\t\t\tcase *ast.Ident:\n334|\t\t\t\t\t\t\t\t// `var f = localHelper` rebinds a\n335|\t\t\t\t\t\t\t\t// local implementation: it inherits\n336|\t\t\t\t\t\t\t\t// the helper's shapes. Binding an\n337|\t\t\t\t\t\t\t\t// imported helper (`var f =\n338|\t\t\t\t\t\t\t\t// otherpkg.Helper`) is a selector,\n339|\t\t\t\t\t\t\t\t// not an identifier, and is reuse.\n340|\t\t\t\t\t\t\t\tfor _, class := range state.funcShapes[bound.Name] {\n341|\t\t\t\t\t\t\t\t\tadd(class, file, name.Name)\n342|\t\t\t\t\t\t\t\t}\n343|\t\t\t\t\t\t\t}\n344|\t\t\t\t\t\t}\n345|\t\t\t\t\t}\n346|\t\t\t\t}\n347|\t\t\t}\n348|\t\t}\n349|\t}\n350|\treturn sites\n351|}\n352|\n353|// funcShapeClasses reports the shape classes of one function or\n354|// closure body.\n355|func funcShapeClasses(body *ast.BlockStmt, sig *ast.FuncType, state *packageShapes) []string {\n356|\tif body == nil {\n357|\t\treturn nil\n358|\t}\n359|\tseen := map[string]bool{}\n360|\tif bodyBuildsJSONDecoder(body) && bodyCarriesDupSignal(body, state) {\n361|\t\tseen[\"strict-decoder\"] = true\n362|\t}\n363|\tif bodyCarriesSurrogateSignal(body, state) {\n364|\t\tseen[\"surrogate-gate\"] = true\n365|\t}\n366|\tif bodyCountsRunes(body) {\n367|\t\tseen[\"string-measure\"] = true\n368|\t}\n369|\tif bodyIsByteMeasure(body, sig) {\n370|\t\tseen[\"byte-measure\"] = true\n371|\t}\n372|\tif _, ok := bodyIsVerdictByteMeasure(body); ok {\n373|\t\tseen[\"byte-measure\"] = true\n374|\t}\n375|\tvar classes []string\n376|\tfor class := range seen {\n377|\t\tclasses = append(classes, class)\n378|\t}\n379|\tsort.Strings(classes)\n380|\treturn classes\n381|}\n382|\n383|// bodyBuildsJSONDecoder reports whether the body constructs an\n384|// encoding/json decoder or unmarshaler.\n385|func bodyBuildsJSONDecoder(body *ast.BlockStmt) bool {\n386|\tfound := false\n387|\tast.Inspect(body, func(node ast.Node) bool {\n388|\t\tcall, ok := node.(*ast.CallExpr)\n389|\t\tif !ok {\n390|\t\t\treturn true\n391|\t\t}\n392|\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n393|\t\tif !ok {\n394|\t\t\treturn true\n395|\t\t}\n396|\t\tidentifier, ok := selector.X.(*ast.Ident)\n397|\t\tif !ok || identifier.Name != \"json\" {\n398|\t\t\treturn true\n399|\t\t}\n400|\t\tif selector.Sel.Name == \"NewDecoder\" || selector.Sel.Name == \"Unmarshal\" {\n401|\t\t\tfound = true\n402|\t\t\treturn false\n403|\t\t}\n404|\t\treturn true\n405|\t})\n406|\treturn found\n407|}\n408|\n409|// bodyHasDupSignal reports whether the body carries a duplicate\n410|// signal: a literal naming both halves, or an identifier with\n411|// the duplicate root (a FaultDuplicate-style constant, a\n412|// duplicate map probe, a dup-check helper name).\n413|func bodyHasDupSignal(body *ast.BlockStmt) bool {\n414|\tfound := false\n415|\tast.Inspect(body, func(node ast.Node) bool {\n416|\t\tswitch n := node.(type) {\n417|\t\tcase *ast.BasicLit:\n418|\t\t\tif n.Kind == token.STRING {\n419|\t\t\t\tif text, err := strconv.Unquote(n.Value); err == nil {\n420|\t\t\t\t\tif strings.Contains(text, \"duplicate\") && strings.Contains(text, \"member\") {\n421|\t\t\t\t\t\tfound = true\n422|\t\t\t\t\t\treturn false\n423|\t\t\t\t\t}\n424|\t\t\t\t}\n425|\t\t\t}\n426|\t\tcase *ast.Ident:\n427|\t\t\tif strings.Contains(n.Name, \"uplicate\") {\n428|\t\t\t\tfound = true\n429|\t\t\t\treturn false\n430|\t\t\t}\n431|\t\t}\n432|\t\treturn true\n433|\t})\n434|\treturn found\n435|}\n436|\n437|// bodyCarriesDupSignal extends the own-body signal across\n438|// same-package callees: a decoder split into an entry plus a\n439|// local duplicate helper still derives on the entry.\n440|func bodyCarriesDupSignal(body *ast.BlockStmt, state *packageShapes) bool {\n441|\tif bodyHasDupSignal(body) {\n442|\t\treturn true\n443|\t}\n444|\tcallee := false\n445|\tast.Inspect(body, func(node ast.Node) bool {\n446|\t\tcall, ok := node.(*ast.CallExpr)\n447|\t\tif !ok {\n448|\t\t\treturn true\n449|\t\t}\n450|\t\tswitch fun := call.Fun.(type) {\n451|\t\tcase *ast.Ident:\n452|\t\t\tif state.funcDups[fun.Name] {\n453|\t\t\t\tcallee = true\n454|\t\t\t\treturn false\n455|\t\t\t}\n456|\t\tcase *ast.SelectorExpr:\n457|\t\t\tif state.funcDups[fun.Sel.Name] {\n458|\t\t\t\tcallee = true\n459|\t\t\t\treturn false\n460|\t\t\t}\n461|\t\t}\n462|\t\treturn true\n463|\t})\n464|\treturn callee\n465|}\n466|\n467|// bodyCarriesSurrogateSignal reports whether the body holds a\n468|// surrogate range literal, names one, or references a\n469|// package-level bound constant.\n470|func bodyCarriesSurrogateSignal(body *ast.BlockStmt, state *packageShapes) bool {\n471|\tfound := false\n472|\tast.Inspect(body, func(node ast.Node) bool {\n473|\t\tswitch n := node.(type) {\n474|\t\tcase *ast.BasicLit:\n475|\t\t\tif n.Kind == token.INT {\n476|\t\t\t\tif magnitude, err := strconv.ParseUint(n.Value, 0, 32); err == nil && surrogateBounds[magnitude] {\n477|\t\t\t\t\tfound = true\n478|\t\t\t\t\treturn false\n479|\t\t\t\t}\n480|\t\t\t}\n481|\t\tcase *ast.Ident:\n482|\t\t\tif strings.Contains(strings.ToLower(n.Name), \"urrogate\") {\n483|\t\t\t\tfound = true\n484|\t\t\t\treturn false\n485|\t\t\t}\n486|\t\t\tif state.constBound[n.Name] {\n487|\t\t\t\tfound = true\n488|\t\t\t\treturn false\n489|\t\t\t}\n490|\t\t}\n491|\t\treturn true\n492|\t})\n493|\treturn found\n494|}\n495|\n496|// bodyCountsRunes reports whether the body counts runes\n497|// directly through the utf8 selector.\n498|func bodyCountsRunes(body *ast.BlockStmt) bool {\n499|\tfound := false\n500|\tast.Inspect(body, func(node ast.Node) bool {\n(more lines below)"}}}
