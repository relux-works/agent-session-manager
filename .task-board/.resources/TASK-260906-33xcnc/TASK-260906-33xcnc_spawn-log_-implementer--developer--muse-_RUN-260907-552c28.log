{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d19b","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":1832,"recorded_at":1780531400003659,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"dd75b6a4-18a7-4cc5-a105-d6af13577b8a"},"task_id":"dd75b6a4-18a7-4cc5-a105-d6af13577b8a","event":{"kind":"output","task_id":"dd75b6a4-18a7-4cc5-a105-d6af13577b8a","chunk":"{\n  \"chunk_id\": \"exec-60-1\",\n  \"command\": \"python3 - <<'EOF' > /tmp/mutbattery_leaf6/mutant-table.md\\nimport json, sys\\nsys.path.insert(0, \\\"/tmp/mutbattery_leaf6\\\")\\nimport importlib.util\\nspec = importlib.util.spec_from_file_location(\\\"battery\\\", \\\"/tmp/mutbattery_leaf6/run.py\\\")\\nbattery = importlib.util.module_from_spec(spec)\\nspec.loader.exec_module(battery)\\nresults = {r[\\\"id\\\"]: r for r in json.load(open(\\\"/tmp/mutbattery_leaf6/results.json\\\"))[\\\"results\\\"]}\\nmeta = {m[\\\"id\\\"]: m for m in battery.MUTANTS}\\nprint(\\\"## Mutant battery (round 2)\\\")\\nprint()\\nprint(\\\"Denominator (production-derived at runtime): 31 refuse sites + 59 boolean-false exits + 11 frame-fault exits = 101.\\\")\\nprint(\\\"Counting the 4 bool-`return <expr>` arms (CheckEnvironmentID, CheckSemver, isNull, rawUint53 forward) the exit inventory is 105; see the outcome for the kind-by-kind account.\\\")\\nprint()\\nprint(\\\"Killed over applied: **70/71**. Classes: narrowing (gate stays, admits exactly one\\\")\\nprint(\\\"rejected member), arm-deletion, census-only (behavioral green, census red), audit-only\\\")\\nprint(\\\"(behavioral green, audit red). NOT_APPLIED and COMPILE_FAIL are distinct rows; the\\\")\\nprint(\\\"harness-validation mutants prove both rows exist.\\\")\\nprint()\\nprint(\\\"| Mutant | Narrows the gate to | Named failing test | Status | Killed by |\\\")\\nprint(\\\"| --- | --- | --- | --- | --- |\\\")\\nfor m in battery.MUTANTS:\\n    if m[\\\"class\\\"] == \\\"harness\\\":\\n        continue\\n    r = results[m[\\\"id\\\"]]\\n    kill = (\\\"`\\\" + m[\\\"kill\\\"] + \\\"`\\\") if m[\\\"kill\\\"] else \\\"-\\\"\\n    suites = \\\",\\\".join(r[\\\"suites\\\"]) if r[\\\"suites\\\"] else \\\"-\\\"\\n    print(\\\"| `%s` (%s) | %s | %s | %s | %s |\\\" % (m[\\\"id\\\"], m[\\\"class\\\"], m[\\\"narrows\\\"], kill, r[\\\"status\\\"], suites))\\nprint()\\nprint(\\\"| Harness mutant | Purpose | Status |\\\")\\nprint(\\\"| --- | --- | --- |\\\")\\nfor m in battery.MUTANTS:\\n    if m[\\\"class\\\"] != \\\"harness\\\":\\n        continue\\n    r = results[m[\\\"id\\\"]]\\n    print(\\\"| `%s` | %s | %s |\\\" % (m[\\\"id\\\"], m[\\\"narrows\\\"], r[\\\"status\\\"]))\\nprint()\\nprint(\\\"### Survivor bounds\\\")\\nprint()\\nprint(\\\"`R_digestnonstr` (expected survivor, arm-deletion): removing CheckDigest's type arm changes no entry\\\")\\nprint(\\\"verdict because scalar.ParseDigest refuses the empty string downstream for every non-string\\\")\\nprint(\\\"input. The property is now pinned by `TestDigestBridgeRefusesEmptyDownstream` (round 2 closes\\\")\\nprint(\\\"the N2 rationale gap): if `ParseDigest(\\\\\\\"\\\\\\\")` ever admitted, that test reddens first. The bridge\\\")\\nprint(\\\"itself is narrowed by `M7`/`M7n` and killed. No unpredicted survivor, no KILLED_OTHER, no billed\\\")\\nprint(\\\"NOT_APPLIED and no COMPILE_FAIL.\\\")\\nprint()\\nprint(\\\"### Honest survivor in-session\\\")\\nprint()\\nprint(\\\"The first `P_dupnarrow_provider_id` run SURVIVED with a green suite and exposed a real test gap:\\\")\\nprint(\\\"the new envelope sweeper did not include the foreign `provider_id` key, so no subtest existed to\\\")\\nprint(\\\"fail. The key was added to `TestDecodeResponseRefusesDuplicateOfEveryMember`, the mutant was\\\")\\nprint(\\\"re-run, and it is KILLED above. A survivor with no named failing test is reported as a survivor;\\\")\\nprint(\\\"this one is reported as found-fixed-and-killed, not as first-time green.\\\")\\nEOF\\nhead -n 12 /tmp/mutbattery_leaf6/mutant-table.md; grep -c \\\"^|\\\" /tmp/mutbattery_leaf6/mutant-table.md\",\n  \"description\": \"Generate mutant table artifact\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"## Mutant battery (round 2)\\n\\nDenominator (production-derived at runtime): 31 refuse sites + 59 boolean-false exits + 11 frame-fault exits = 101.\\nCounting the 4 bool-`return <expr>` arms (CheckEnvironmentID, CheckSemver, isNull, rawUint53 forward) the exit inventory is 105; see the outcome for the kind-by-kind account.\\n\\nKilled over applied: **70/71**. Classes: narrowing (gate stays, admits exactly one\\nrejected member), arm-deletion, census-only (behavioral green, census red), audit-only\\n(behavioral green, audit red). NOT_APPLIED and COMPILE_FAIL are distinct rows; the\\nharness-validation mutants prove both rows exist.\\n\\n| Mutant | Narrows the gate to | Named failing test | Status | Killed by |\\n| --- | --- | --- | --- | --- |\\n77\\n\",\n  \"original_output_bytes\": 735,\n  \"original_output_tokens\": 184,\n  \"truncated\": false\n}"}}}
