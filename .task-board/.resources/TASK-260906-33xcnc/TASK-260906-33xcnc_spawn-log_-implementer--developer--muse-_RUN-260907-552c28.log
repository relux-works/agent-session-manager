{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9cb","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":832,"recorded_at":1780531400001659,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"591a5c03-a786-4c4a-903f-e59b8e12949f"},"task_id":"591a5c03-a786-4c4a-903f-e59b8e12949f","event":{"kind":"output","task_id":"591a5c03-a786-4c4a-903f-e59b8e12949f","chunk":"Read text file `internal/provhost/protocol_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"math\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// asError unwraps err to an *axerror.Error without hiding the chain.\n16|func asError(t *testing.T, err error, failure **axerror.Error) bool {\n17|\tt.Helper()\n18|\treturn errors.As(err, failure)\n19|}\n20|\n21|const (\n22|\ttestRequestID = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n23|\ttestOtherID   = \"0198f4c8-e4b0-75cc-9576-1234567890ab\"\n24|\ttestDeadline  = \"2026-08-19T04:05:00.000Z\"\n25|\ttestNow       = \"2026-08-19T04:00:00.000Z\"\n26|)\n27|\n28|func mustUUIDv7(t *testing.T, value string) scalar.UUIDv7 {\n29|\tt.Helper()\n30|\tparsed, err := scalar.ParseUUIDv7(value)\n31|\tif err != nil {\n32|\t\tt.Fatalf(\"ParseUUIDv7(%q): %v\", value, err)\n33|\t}\n34|\treturn parsed\n35|}\n36|\n37|func mustTimestamp(t *testing.T, value string) scalar.Timestamp {\n38|\tt.Helper()\n39|\tparsed, err := scalar.ParseTimestamp(value)\n40|\tif err != nil {\n41|\t\tt.Fatalf(\"ParseTimestamp(%q): %v\", value, err)\n42|\t}\n43|\treturn parsed\n44|}\n45|\n46|func mustInstant(t *testing.T, value string) time.Time {\n47|\tt.Helper()\n48|\tinstant, err := mustTimestamp(t, value).Time()\n49|\tif err != nil {\n50|\t\tt.Fatalf(\"Timestamp(%q).Time(): %v\", value, err)\n51|\t}\n52|\treturn instant\n53|}\n54|\n55|// testRequest builds the Section 7.2 request-envelope fixture: a doctor\n56|// operation with a future deadline. The production entry point for\n57|// framing is EncodeRequest.\n58|func testRequest(t *testing.T) Request {\n59|\tt.Helper()\n60|\treturn Request{\n61|\t\tOperation: OpDoctor,\n62|\t\tRequestID: mustUUIDv7(t, testRequestID),\n63|\t\tDeadline:  mustTimestamp(t, testDeadline),\n64|\t\tBody:      json.RawMessage(`{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}`),\n65|\t}\n66|}\n67|\n68|// failureCode extracts the Structured Error code from err, failing when\n69|// err is not an *axerror.Error. Every failure below is a 1.0.0 object,\n70|// local or child-bound.\n71|func failureCode(t *testing.T, err error) axerror.Code {\n72|\tt.Helper()\n73|\tif err == nil {\n74|\t\tt.Fatal(\"want a failure, got nil\")\n75|\t}\n76|\tvar failure *axerror.Error\n77|\tif !asError(t, err, &failure) {\n78|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n79|\t}\n80|\treturn failure.Code()\n81|}\n82|\n83|func failureExit(t *testing.T, err error) int {\n84|\tt.Helper()\n85|\tvar failure *axerror.Error\n86|\tif !asError(t, err, &failure) {\n87|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n88|\t}\n89|\treturn failure.ExitCode()\n90|}\n91|\n92|// failureObject unwraps err to the Structured Error itself, so arm\n93|// identity beyond the stable code can be asserted.\n94|func failureObject(t *testing.T, err error) *axerror.Error {\n95|\tt.Helper()\n96|\tif err == nil {\n97|\t\tt.Fatal(\"want a failure, got nil\")\n98|\t}\n99|\tvar failure *axerror.Error\n100|\tif !asError(t, err, &failure) {\n101|\t\tt.Fatalf(\"error %v is not a Structured Error\", err)\n102|\t}\n103|\treturn failure\n104|}\n105|\n106|// failureMember returns the \"member\" diagnostic of a frame refusal. Every\n107|// provider_protocol_error arm names the member it refused on, so asserting\n108|// it pins the arm: a missing-member gate deleted from checkResponseMembers\n109|// slides to a lower arm carrying the same code with a different member or\n110|// detail, and the slide reddens here instead of passing silently.\n111|func failureMember(t *testing.T, err error) string {\n112|\tt.Helper()\n113|\tfailure := failureObject(t, err)\n114|\tmember, ok := failure.Detail(\"member\")\n115|\tif !ok {\n116|\t\tt.Fatalf(\"refusal %v carries no member detail\", err)\n117|\t}\n118|\ttext, ok := member.(string)\n119|\tif !ok {\n120|\t\tt.Fatalf(\"refusal %v member detail is %T, want string\", err, member)\n121|\t}\n122|\treturn text\n123|}\n124|\n125|// requireFrameRefusal asserts the full arm identity of a plugin-frame\n126|// refusal: the stable code, the refused member, the detail naming the\n127|// rule, and the non-retryable bit doc.go promises for every local\n128|// failure this package emits.\n129|func requireFrameRefusal(t *testing.T, err error, member, detail string) {\n130|\tt.Helper()\n131|\tif failureCode(t, err) != \"provider_protocol_error\" {\n132|\t\tt.Fatalf(\"DecodeResponse code = %v, want provider_protocol_error\", err)\n133|\t}\n134|\tif got := failureMember(t, err); got != member {\n135|\t\tt.Fatalf(\"DecodeResponse member = %q, want %q (detail: %v)\", got, member, err)\n136|\t}\n137|\tif !strings.Contains(err.Error(), detail) {\n138|\t\tt.Fatalf(\"DecodeResponse error = %v, want detail containing %q\", err, detail)\n139|\t}\n140|\tif failureObject(t, err).Retryable() {\n(more lines below)"}}}
