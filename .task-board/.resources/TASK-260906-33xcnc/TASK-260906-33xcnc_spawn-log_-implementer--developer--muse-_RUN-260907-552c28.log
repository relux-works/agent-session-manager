{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"c65d4558-83c6-41e9-85a4-62f849b61550"},"task_id":"c65d4558-83c6-41e9-85a4-62f849b61550","event":{"kind":"output","task_id":"c65d4558-83c6-41e9-85a4-62f849b61550","chunk":"Read text file `internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for every Section 7.8 closed\n15|// body. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing\n18|// every arm. A helper that fronted a constructor would collapse\n19|// distinct rules into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer:\n22|// Section 7.8 counts and limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// frameFault is one strict-decode failure: what was wrong and which\n26|// member it was found in, if any. It never carries foreign bytes.\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|// decodeStrictObject parses one complete JSON object with duplicate\n33|// member rejection. It is the only JSON entry point in this package:\n34|// every body crosses it before any member is read. The frame verdict\n35|// itself is the shared environ verdict: this function delegates to\n36|// environ.DecodeStrictObject and translates the fault into the\n37|// package refusal dialect without reimplementing any rule, so the\n38|// two can never drift. The delegated string-walk surrogate gate\n39|// refuses a real lone escape behind an even backslash run and\n40|// admits quoted backslash-u text; the raw byte scan this replaces\n41|// misread the quoted text as a high surrogate and admitted the\n42|// real lone escape behind it. A non-UTF-8 frame, a lone surrogate\n43|// escape, a non-object top level, a duplicated member, or trailing\n44|// data is a fault, never a partial object the caller could mistake\n45|// for a result.\n46|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n47|\tmembers, fault := environ.DecodeStrictObject(data)\n48|\tif fault != nil {\n49|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n50|\t}\n51|\treturn members, nil\n52|}\n53|\n54|// unknownMember names a member outside the closed set, if any. The\n55|// single-unknown fixtures keep the verdict deterministic: with\n56|// several unknowns the map order decides which is named, so tests\n57|// never assert a name from a multi-unknown body.\n58|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n59|\tfor name := range members {\n60|\t\tif !allowed[name] {\n61|\t\t\treturn name, true\n62|\t\t}\n63|\t}\n64|\treturn \"\", false\n65|}\n66|\n67|// missingMember names the first required member with no value, if\n68|// any. The required list is fixed order, so the verdict is\n69|// deterministic for every missing combination.\n70|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n71|\tfor _, name := range required {\n72|\t\tif _, present := members[name]; !present {\n73|\t\t\treturn name, true\n74|\t\t}\n75|\t}\n76|\treturn \"\", false\n77|}\n78|\n79|// rawString reads a JSON string member.\n80|func rawString(raw json.RawMessage) (string, bool) {\n81|\tvar value string\n82|\tif err := json.Unmarshal(raw, &value); err != nil {\n83|\t\treturn \"\", false\n84|\t}\n85|\treturn value, true\n86|}\n87|\n88|// rawBool reads a JSON boolean member.\n89|func rawBool(raw json.RawMessage) (bool, bool) {\n90|\tvar value bool\n91|\tif err := json.Unmarshal(raw, &value); err != nil {\n92|\t\treturn false, false\n93|\t}\n94|\treturn value, true\n95|}\n96|\n97|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n98|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n99|// even when it names the same mathematical value: the canonical\n100|// bodies carry counts, never measurements.\n101|func rawUint53(raw json.RawMessage) (uint64, bool) {\n102|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n103|\tdecoder.UseNumber()\n104|\tvar value any\n105|\tif err := decoder.Decode(&value); err != nil {\n106|\t\treturn 0, false\n107|\t}\n108|\t// Decode reads one value and stops: without the trailing\n109|\t// check a hostile slice like `12a` would read as 12. Member\n110|\t// slices arriving through decodeStrictObject can never carry\n111|\t// trailing data, but this entry takes raw slices and must\n112|\t// not trust them.\n113|\tif _, err := decoder.Token(); err != io.EOF {\n114|\t\treturn 0, false\n115|\t}\n116|\tnumber, ok := value.(json.Number)\n117|\tif !ok {\n118|\t\treturn 0, false\n119|\t}\n120|\tliteral := number.String()\n121|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n122|\t\treturn 0, false\n123|\t}\n124|\treturn parseUint53Literal(literal)\n125|}\n126|\n127|// parseUint53Literal reads a digit-only literal without trusting a\n128|// float conversion: the magnitude bound is checked on the digit\n129|// string, so 2^53 is refused even on platforms that could hold it.\n130|func parseUint53Literal(literal string) (uint64, bool) {\n131|\tif literal == \"\" {\n132|\t\treturn 0, false\n133|\t}\n134|\tvar value uint64\n135|\tfor index := 0; index < len(literal); index++ {\n136|\t\tdigit := literal[index]\n137|\t\tif digit < '0' || digit > '9' {\n138|\t\t\treturn 0, false\n139|\t\t}\n140|\t\tvalue = value*10 + uint64(digit-'0')\n141|\t\tif value > maxUint53 {\n142|\t\t\treturn 0, false\n143|\t\t}\n144|\t}\n145|\treturn value, true\n146|}\n147|\n148|// stringLength is the Section 1.6 string measure in characters, not\n149|// bytes: a bound of string[1..128] admits 128 characters of any\n150|// width. It delegates to the single environ measure so the two can\n151|// never drift; the delegation battery pins both directions.\n152|func stringLength(value string) int {\n153|\treturn environ.StringLength(value)\n154|}\n155|\n156|// checkStringBounds reports whether the member is a JSON string whose\n157|// character count falls in the inclusive bound. It delegates to the\n158|// environ gate.\n159|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n160|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n161|}\n162|\n163|// checkUint53Bounds reports whether the member is a uint53 in the\n164|// inclusive bound. Both edges are checked: a one-sided check would\n165|// admit the open side. It delegates to the environ gate.\n166|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n167|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n168|}\n169|\n170|// checkDigest reports whether the member is a digest of the pinned\n171|// sha256 form. It delegates to the environ gate.\n172|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n173|\treturn environ.CheckDigest(raw)\n174|}\n175|\n176|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n177|// delegates to the environ gate.\n178|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n179|\treturn environ.CheckUUIDv7(raw)\n180|}\n181|\n182|// checkTimestamp reports whether the member is a pinned timestamp.\n183|// It delegates to the environ gate.\n184|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n185|\treturn environ.CheckTimestamp(raw)\n186|}\n187|\n188|// isNull reports whether the member is an explicit JSON null.\n189|func isNull(raw json.RawMessage) bool {\n190|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n191|}\n192|\n193|// decodeArray reads a JSON array member into its raw elements. A\n194|// non-array — including null — is not an empty array.\n195|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n196|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n197|\ttoken, err := decoder.Token()\n198|\tif err != nil {\n199|\t\treturn nil, false\n200|\t}\n201|\tdelim, ok := token.(json.Delim)\n202|\tif !ok || delim != '[' {\n203|\t\treturn nil, false\n204|\t}\n205|\tvar elements []json.RawMessage\n206|\tfor decoder.More() {\n207|\t\tvar element json.RawMessage\n208|\t\tif err := decoder.Decode(&element); err != nil {\n209|\t\t\treturn nil, false\n210|\t\t}\n211|\t\telements = append(elements, element)\n212|\t}\n213|\tif token, err := decoder.Token(); err != nil {\n214|\t\treturn nil, false\n215|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n216|\t\treturn nil, false\n217|\t}\n218|\tif _, err := decoder.Token(); err != io.EOF {\n219|\t\treturn nil, false\n220|\t}\n221|\treturn elements, true\n222|}\n223|\n224|// checkSortedUniqueStrings reports whether the member is an array of\n225|// strings in the item bound whose JCS encodings order strictly\n226|// increasingly with no duplicates. Bytewise JCS order over strings\n227|// is plain lexicographic order, so the check compares directly; the\n228|// count bound is checked on both edges. It delegates to the environ\n229|// gate.\n230|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n231|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n232|}\n233|\n234|// checkSortedUniqueDigests reports whether the member is a sorted\n235|// unique digest array in the count bound. It delegates to the\n236|// environ gate.\n237|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n238|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n239|}\n240|\n241|// providerIDPattern is the Section 7.1 provider-id grammar the\n242|// manifest, context, and binding layers read:\n243|// [a-z][a-z0-9-]{0,31}. It is the one grammar copy this package\n244|// retains: scalar owns the provider-id rule and the one-language\n245|// battery pins every copy to its literal in both directions.\n246|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n247|\n248|// checkExtensions reports whether the member is an object whose keys\n249|// are all reverse-DNS names. Values cross opaquely: extensions\n250|// cannot add operations, capabilities, or trust facts, and no member\n251|// of this package reads an extension value for any admission\n252|// decision. It delegates to the environ gate.\n253|func checkExtensions(raw json.RawMessage) bool {\n254|\treturn environ.CheckExtensions(raw)\n255|}"}}}
