{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c981","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":795,"recorded_at":1780531400001585,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"18585467-bddb-496b-af57-d85000b2b693"},"task_id":"18585467-bddb-496b-af57-d85000b2b693","event":{"kind":"output","task_id":"18585467-bddb-496b-af57-d85000b2b693","chunk":"Read text file `internal/environ/corpus_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Shared fixtures for the environ boundary battery. This file is in\n18|// the external test package: the facades the battery drives import\n19|// environ, so an in-package battery importing them would be an\n20|// import cycle. Every builder\n21|// emits hand-written JSON with independently chosen literals: no\n22|// builder derives its probe points from production constants, so\n23|// a mutated production constant cannot take its fixture with\n24|// it. The verdict always comes from production; the vectors never\n25|// do. In particular the schema URNs, version strings, member\n26|// names, and vocabulary tokens below are retyped from the pinned\n27|// specification, not referenced from any package under test.\n28|//\n29|// One corpus drives every facade: the same digest, UUIDv7, and\n30|// timestamp identities flow into the sessadapter, dirnode,\n31|// provhost, and canonicaljson entries each battery file drives,\n32|// so a fixture that is valid for one facade and invalid for\n33|// another fails loudly instead of passing per-facade copies that\n34|// never meet.\n35|\n36|// Fixed fixture identities. The UUIDs carry a 7 version nibble;\n37|// the digests are syntactically pinned sha256 hex.\n38|const (\n39|\tfixtureHostID        = \"0198f4c8-8e50-7f66-8f70-1234567890ab\"\n40|\tfixtureOperationID   = \"0198f4c8-8e50-7f66-8f70-1234567890ac\"\n41|\tfixtureSubjectID     = \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"\n42|\tfixtureWorkspaceID   = \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"\n43|\tfixtureCreatorHostID = \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"\n44|\tfixtureObservedAt    = \"2026-08-19T04:05:00.000Z\"\n45|\tfixtureValidFrom     = \"2026-01-01T00:00:00.000Z\"\n46|\tfixtureValidUntil    = \"2027-01-01T00:00:00.000Z\"\n47|\tfixtureEnvironmentID = \"test.env\"\n48|\tfixtureAdapterVer    = \"1.2.3\"\n49|\tfixtureProviderID    = \"test-provider\"\n50|)\n51|\n52|// fixtureDigest returns the pinned digest of one seed.\n53|func fixtureDigest(seed string) string {\n54|\tsum := sha256.Sum256([]byte(seed))\n55|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n56|}\n57|\n58|// Standard fixture digests, each naming its seed.\n59|var (\n60|\tfixtureStorePrint  = fixtureDigest(\"test-store-fingerprint\")\n61|\tfixtureInstallID   = fixtureDigest(\"test-installation\")\n62|\tfixtureObserveID   = fixtureDigest(\"test-observation\")\n63|\tfixtureRealmPrint  = fixtureDigest(\"test-realm\")\n64|\tfixtureRecordID    = fixtureDigest(\"test-identity-record\")\n65|\tfixtureEvidenceID  = fixtureDigest(\"test-evidence\")\n66|\tfixtureExecutable  = fixtureDigest(\"test-executable\")\n67|\tfixtureAdapterMain = fixtureDigest(\"test-adapter-manifest\")\n68|)\n69|\n70|// TestSharedFixtureIdentitiesAreValid guards the instrument: a\n71|// malformed shared identity would refuse at every facade for the\n72|// wrong reason, turning the whole battery into a test of the\n73|// fixture rather than the facades.\n74|func TestSharedFixtureIdentitiesAreValid(t *testing.T) {\n75|\tfor _, identity := range []string{fixtureHostID, fixtureOperationID, fixtureSubjectID, fixtureWorkspaceID, fixtureCreatorHostID} {\n76|\t\tif _, err := scalar.ParseUUIDv7(identity); err != nil {\n77|\t\t\tt.Fatalf(\"fixture UUID %q does not parse: %v\", identity, err)\n78|\t\t}\n79|\t}\n80|\tfor _, moment := range []string{fixtureObservedAt, fixtureValidFrom, fixtureValidUntil} {\n81|\t\tif _, err := scalar.ParseTimestamp(moment); err != nil {\n82|\t\t\tt.Fatalf(\"fixture timestamp %q does not parse: %v\", moment, err)\n83|\t\t}\n84|\t}\n85|\tfor _, digest := range []string{fixtureStorePrint, fixtureInstallID, fixtureObserveID, fixtureRealmPrint, fixtureRecordID, fixtureEvidenceID, fixtureExecutable, fixtureAdapterMain} {\n86|\t\tif _, err := scalar.ParseDigest(digest); err != nil {\n87|\t\t\tt.Fatalf(\"fixture digest %q does not parse: %v\", digest, err)\n88|\t\t}\n89|\t}\n90|}\n91|\n92|// validTupleJSON is one valid Environment Tuple over the shared\n93|// identities.\n94|func validTupleJSON() string {\n95|\treturn fmt.Sprintf(`{\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":%q,\"adapter_version\":%q}`,\n96|\t\tfixtureEnvironmentID, fixtureStorePrint, fixtureAdapterVer)\n97|}\n98|\n99|// validScanRequestJSON is one valid dirnode scan request carrying\n100|// the given cursor literal (already JSON-encoded by the caller).\n101|func validScanRequestJSON(cursorLiteral string) []byte {\n102|\treturn []byte(fmt.Sprintf(`{\"operation_id\":%q,\"installation_ids\":[%q],\"prior_batch_id\":null,\"cursor\":%s,\"max_instances\":10,\"extensions\":{}}`,\n103|\t\tfixtureOperationID, fixtureInstallID, cursorLiteral))\n104|}\n105|\n106|// validIdentityJSON is one valid Provider Identity Record over\n107|// the shared identities: an Antigravity\n108|// backend_conversation_uuid with a non-null realm fingerprint.\n109|func validIdentityJSON() []byte {\n110|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:provider-identity\",\"schema_version\":\"1.0.0\",\"record_id\":%q,\"subject_id\":%q,\"session_id\":%q,\"provider_id\":\"antigravity\",\"provider_version\":\"1.1.14\",\"provider_version_range\":\">=1.1.14 <1.2.0\",\"native_session_id\":\"11111111-2222-4333-8444-555555555555\",\"identity_kind\":\"backend_conversation_uuid\",\"logical_workspace_id\":%q,\"backend_realm_fingerprint\":%q,\"opaque_identity\":{},\"created_by_host_id\":%q,\"created_at\":%q,\"extensions\":{}}`,\n111|\t\tfixtureRecordID, fixtureSubjectID, fixtureSubjectID, fixtureWorkspaceID, fixtureRealmPrint, fixtureCreatorHostID, fixtureObservedAt))\n112|}\n113|\n114|// availableCapabilityJSON is one available CapabilityResult with\n115|// null reason.\n116|func availableCapabilityJSON() string {\n117|\treturn fmt.Sprintf(`{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":%q,\"extensions\":{}}`, fixtureObservedAt)\n118|}\n119|\n120|// validCapabilitiesJSON is the exact eight-name capability map\n121|// with every capability available.\n122|func validCapabilitiesJSON() string {\n123|\tnames := []string{\n124|\t\t\"directory_discovery\",\n125|\t\t\"directory_incremental_scan\",\n126|\t\t\"directory_head_digest\",\n127|\t\t\"directory_tail_preview\",\n128|\t\t\"native_title_read\",\n129|\t\t\"native_runtime_observation\",\n130|\t\t\"existing_session_adoption\",\n131|\t\t\"native_resume\",\n132|\t}\n133|\tparts := make([]string, 0, len(names))\n134|\tfor _, name := range names {\n135|\t\tquoted, err := json.Marshal(name)\n136|\t\tif err != nil {\n137|\t\t\tpanic(err)\n138|\t\t}\n139|\t\tparts = append(parts, string(quoted)+\":\"+availableCapabilityJSON())\n140|\t}\n141|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n142|}\n143|\n144|// validObservationJSON is one valid Environment Observation over\n145|// the shared identities.\n146|func validObservationJSON() []byte {\n147|\treturn []byte(fmt.Sprintf(`{\"schema\":\"urn:ax:schema:environment-observation\",\"schema_version\":\"1.0.0\",\"observation_id\":%q,\"host_id\":%q,\"installation_id\":%q,\"environment_id\":%q,\"environment_version\":\"2.1.0\",\"provider_id\":%q,\"platform\":\"linux\",\"architecture\":\"amd64\",\"backend_realm_fingerprint\":%q,\"capabilities\":%s,\"authentication_status\":\"available\",\"runtime_status\":\"available\",\"observed_at\":%q,\"extensions\":{}}`,\n148|\t\tfixtureObserveID, fixtureHostID, fixtureInstallID, fixtureEnvironmentID, fixtureProviderID, fixtureRealmPrint, validCapabilitiesJSON(), fixtureObservedAt))\n149|}\n150|\n151|// mutateMember returns the object with one top-level member\n152|// replaced by the given raw JSON. The replacement is applied to a\n153|// fresh positive fixture, one mutation at a time: every other\n154|// member holds a valid value, so two distinct rules cannot both\n155|// satisfy one witness.\n156|func mutateMember(t *testing.T, body []byte, member, replacement string) []byte {\n157|\tt.Helper()\n158|\tmembers := decodeTestMembers(t, body)\n159|\tmembers[member] = replacement\n160|\treturn encodeTestMembers(t, members)\n161|}\n162|\n163|// dropMember returns the object without one top-level member.\n164|func dropMember(t *testing.T, body []byte, member string) []byte {\n165|\tt.Helper()\n166|\tmembers := decodeTestMembers(t, body)\n167|\tdelete(members, member)\n168|\treturn encodeTestMembers(t, members)\n169|}\n170|\n171|func decodeTestMembers(t *testing.T, body []byte) map[string]string {\n172|\tt.Helper()\n173|\tvar raw map[string]json.RawMessage\n174|\tif err := json.Unmarshal(body, &raw); err != nil {\n175|\t\tt.Fatalf(\"mutateMember: fixture is not JSON: %v\", err)\n176|\t}\n177|\tmembers := make(map[string]string, len(raw))\n178|\tfor name, value := range raw {\n179|\t\tmembers[name] = string(value)\n180|\t}\n181|\treturn members\n182|}\n183|\n184|func encodeTestMembers(t *testing.T, members map[string]string) []byte {\n185|\tt.Helper()\n186|\tnames := make([]string, 0, len(members))\n187|\tfor name := range members {\n188|\t\tnames = append(names, name)\n189|\t}\n190|\tsort.Strings(names)\n191|\tparts := make([]string, 0, len(members))\n192|\tfor _, name := range names {\n193|\t\tquoted, err := json.Marshal(name)\n194|\t\tif err != nil {\n195|\t\t\tt.Fatalf(\"encodeTestMembers: %v\", err)\n196|\t\t}\n197|\t\tparts = append(parts, string(quoted)+\":\"+members[name])\n198|\t}\n199|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n200|}\n201|\n202|// TestEntriesAreDeterministic proves the validation entries are\n203|// pure functions of their input bytes: repeated decoding is\n204|// byte-identical, so there is no hidden cache, no clock read, and\n205|// no durable state whose crash recovery would need evidence. The\n206|// scan journal in dirnode is the story's only durable state and\n207|// belongs to the frozen leaf; this library adds none.\n208|func TestEntriesAreDeterministic(t *testing.T) {\n209|\tbodies := [][]byte{[]byte(validTupleJSON()), validObservationJSON(), validIdentityJSON()}\n210|\tfor index, body := range bodies {\n211|\t\tfirst, err := environ.DecodeStrictObject(body)\n212|\t\tif err != nil {\n213|\t\t\tt.Fatalf(\"body %d: first decode: %v\", index, err)\n214|\t\t}\n215|\t\tsecond, err := environ.DecodeStrictObject(body)\n216|\t\tif err != nil {\n217|\t\t\tt.Fatalf(\"body %d: second decode: %v\", index, err)\n218|\t\t}\n219|\t\tif !reflect.DeepEqual(first, second) {\n220|\t\t\tt.Fatalf(\"body %d: repeated decode differs\", index)\n221|\t\t}\n222|\t}\n223|\tfirst, err := environ.DecodeTuple([]byte(validTupleJSON()))\n224|\tif err != nil {\n225|\t\tt.Fatalf(\"tuple first decode: %v\", err)\n226|\t}\n227|\tsecond, err := environ.DecodeTuple([]byte(validTupleJSON()))\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"tuple second decode: %v\", err)\n230|\t}\n231|\tif first != second {\n232|\t\tt.Fatalf(\"tuple repeated decode differs: %+v vs %+v\", first, second)\n233|\t}\n234|}"}}}
