{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c679","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":407,"recorded_at":1780531400000809,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"9af9d5bd-1bfc-41af-b9a3-391369b3e6e3"},"task_id":"9af9d5bd-1bfc-41af-b9a3-391369b3e6e3","event":{"kind":"output","task_id":"9af9d5bd-1bfc-41af-b9a3-391369b3e6e3","chunk":"Read text file `internal/environ/census_audit_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n10|)\n11|\n12|// This file is the alias-bypass audit over the shared-rule census\n13|// scope. The name layer (census_test.go) derives definitions by\n14|// identifier and the shape layer (shape_census_test.go) derives\n15|// implementations by texture; neither sees a use-site alias — an\n16|// import alias rebound to a shared helper, or a package-level var\n17|// rebound to one — because no new definition appears. This audit\n18|// closes that direction with invcore.AuditConstructorReferences:\n19|// every reference to a ledgered shared-rule name outside\n20|// direct-call position fails, every shape the audit cannot\n21|// classify (dot imports, shadowed names) fails closed, and the\n22|// synthetic plants below prove each shape reports while direct\n23|// calls and the constructors' own declarations stay clean.\n24|\n25|// sharedRuleConstructorSpec watches the ledgered shared-rule\n26|// names: package-local bare identifiers by spelling, and the\n27|// canonical environ members by import path and member name, so an\n28|// import alias cannot change what the audit sees. The local set\n29|// is the name layer's symbol map minus\n30|// validateProviderIdentityRecord: canonicaljson registers that\n31|// validator by function value in its schema dispatch table\n32|// (closed_shapes.go), which is same-function dispatch rather\n33|// than a copy or an alias — every invocation still executes the\n34|// censused definition. A true rebinding of it (`var f =\n35|// validateProviderIdentityRecord`) still fails, via the shape\n36|// layer's var-alias rule, which inherits the helper's\n37|// string-measure shape onto the new name and reports it as an\n38|// unregistered site (proven by the C1 controls in\n39|// TestShapeCensusCatchesControls). The qualified set is the\n40|// environ surface the facades delegate to.\n41|func sharedRuleConstructorSpec() invcore.ConstructorSpec {\n42|\tlocal := make(map[string]bool, len(sharedFunctionSymbols))\n43|\tfor name := range sharedFunctionSymbols {\n44|\t\tif name == \"validateProviderIdentityRecord\" {\n45|\t\t\tcontinue\n46|\t\t}\n47|\t\tlocal[name] = true\n48|\t}\n49|\treturn invcore.ConstructorSpec{\n50|\t\tLocal: local,\n51|\t\tQualified: map[string]map[string]bool{\n52|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\": {\n53|\t\t\t\t\"DecodeStrictObject\":           true,\n54|\t\t\t\t\"HasLoneSurrogateEscape\":       true,\n55|\t\t\t\t\"StringLength\":                 true,\n56|\t\t\t\t\"CheckStringBounds\":            true,\n57|\t\t\t\t\"CheckUint53Bounds\":            true,\n58|\t\t\t\t\"CheckDigest\":                  true,\n59|\t\t\t\t\"CheckUUIDv7\":                  true,\n60|\t\t\t\t\"CheckTimestamp\":               true,\n61|\t\t\t\t\"CheckSortedUniqueStrings\":     true,\n62|\t\t\t\t\"CheckSortedUniqueDigests\":     true,\n63|\t\t\t\t\"CheckExtensions\":              true,\n64|\t\t\t\t\"CheckEnvironmentID\":           true,\n65|\t\t\t\t\"CheckSemver\":                  true,\n66|\t\t\t\t\"DecodeTuple\":                  true,\n67|\t\t\t\t\"DecodeEnvironmentObservation\": true,\n68|\t\t\t},\n69|\t\t},\n70|\t}\n71|}\n72|\n73|// censusScopePackages lists the audit scope in a fixed order: the\n74|// name layer's package set, which this audit shares by\n75|// construction.\n76|func censusScopePackages() []string {\n77|\tpackages := make([]string, 0, len(censusPackages))\n78|\tfor pkg := range censusPackages {\n79|\t\tpackages = append(packages, pkg)\n80|\t}\n81|\tsort.Strings(packages)\n82|\treturn packages\n83|}\n84|\n85|// TestCensusScopeHasNoAliasedSharedRules requires every\n86|// shared-rule reference in census-scope production to sit in\n87|// direct-call position: an aliased, rebound, or otherwise\n88|// indirected construction fails here even though the name and\n89|// shape censuses stay green over it. The delegation this leaf\n90|// added (sessadapter and dirnode calling environ.Check* and\n91|// friends directly) is the allowed position and stays clean.\n92|func TestCensusScopeHasNoAliasedSharedRules(t *testing.T) {\n93|\troot, err := internalRoot(t)\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"alias audit: %v\", err)\n96|\t}\n97|\tspec := sharedRuleConstructorSpec()\n98|\tfor _, pkg := range censusScopePackages() {\n99|\t\tfiles, fileSet := invcore.MustScanProduction(t, filepath.Join(root, pkg))\n100|\t\tfor _, production := range files {\n101|\t\t\tdisplay := pkg + \"/\" + production.Name\n102|\t\t\tinvcore.MustAuditConstructorReferences(t, production.Syntax, fileSet, display, spec)\n103|\t\t}\n104|\t}\n105|}\n106|\n107|// aliasPlant is one synthetic control for the audit: the source,\n108|// whether the audit must report, and the fragment the failure\n109|// must carry (\"\" for clean plants).\n110|type aliasPlant struct {\n111|\tname        string\n112|\tsource      string\n113|\twantFailure string\n114|}\n115|\n116|// aliasPlants enumerates the bypass shapes. The import-alias and\n117|// var-binding plants are the shapes that walked through every\n118|// identifier-keyed gate in this repository's history; the dot\n119|// import and shadow plants are the shapes the audit cannot\n120|// classify and must fail closed rather than prune.\n121|func aliasPlants() []aliasPlant {\n122|\treturn []aliasPlant{\n123|\t\t{\n124|\t\t\tname: \"var binding of a local shared helper reports\",\n125|\t\t\tsource: `package provider\n126|func stringLength(value string) int { return len(value) }\n127|var measure = stringLength\n128|func use(value string) int { return measure(value) }\n129|`,\n130|\t\t\twantFailure: \"outside direct-call position\",\n131|\t\t},\n132|\t\t{\n133|\t\t\tname: \"import alias rebound to the canonical helper reports\",\n134|\t\t\tsource: `package provider\n135|import env \"github.com/relux-works/agent-session-manager/internal/environ\"\n136|var length = env.StringLength\n137|func use(value string) int { return length(value) }\n138|`,\n139|\t\t\twantFailure: \"outside direct-call position\",\n140|\t\t},\n141|\t\t{\n142|\t\t\tname: \"aliased direct call stays clean\",\n143|\t\t\tsource: `package provider\n144|import env \"github.com/relux-works/agent-session-manager/internal/environ\"\n145|func use(value string) int { return env.StringLength(value) }\n146|`,\n147|\t\t},\n148|\t\t{\n149|\t\t\tname: \"canonical direct call stays clean\",\n150|\t\t\tsource: `package provider\n151|import \"github.com/relux-works/agent-session-manager/internal/environ\"\n152|func use(value string) int { return environ.StringLength(value) }\n153|func decode(data []byte) bool {\n154|\tmembers, _ := environ.DecodeStrictObject(data)\n155|\treturn members != nil\n156|}\n157|`,\n158|\t\t},\n159|\t\t{\n160|\t\t\tname: \"local direct call stays clean\",\n161|\t\t\tsource: `package provider\n162|func stringLength(value string) int { return len(value) }\n163|func use(value string) int { return stringLength(value) }\n164|`,\n165|\t\t},\n166|\t\t{\n167|\t\t\tname: \"dot import of the watched path fails closed\",\n168|\t\t\tsource: `package provider\n169|import . \"github.com/relux-works/agent-session-manager/internal/environ\"\n170|func use(value string) int { return StringLength(value) }\n171|`,\n172|\t\t\twantFailure: \"dot-imports watched path\",\n173|\t\t},\n174|\t\t{\n175|\t\t\tname: \"shadowed constructor name fails closed\",\n176|\t\t\tsource: `package provider\n177|func use(stringLength string) string { return stringLength }\n178|`,\n179|\t\t\twantFailure: \"stringLength\",\n180|\t\t},\n181|\t}\n182|}\n183|\n184|// TestCensusAuditCatchesAliasShapes drives every plant through\n185|// the production audit spec and requires the ledgered outcome:\n186|// reporting shapes fail with their fragment, clean shapes stay\n187|// clean. A plant that stops reporting proves nothing and fails\n188|// here by construction.\n189|func TestCensusAuditCatchesAliasShapes(t *testing.T) {\n190|\tspec := sharedRuleConstructorSpec()\n191|\tfor _, plant := range aliasPlants() {\n192|\t\tt.Run(plant.name, func(t *testing.T) {\n193|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n194|\t\t\tif failure != \"\" {\n195|\t\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n196|\t\t\t}\n197|\t\t\tfailures := invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", spec)\n198|\t\t\tif plant.wantFailure == \"\" {\n199|\t\t\t\tif len(failures) != 0 {\n200|\t\t\t\t\tt.Fatalf(\"clean plant reported: %s\", strings.Join(failures, \"; \"))\n201|\t\t\t\t}\n202|\t\t\t\treturn\n203|\t\t\t}\n204|\t\t\tmatched := false\n205|\t\t\tfor _, failure := range failures {\n206|\t\t\t\tif strings.Contains(failure, plant.wantFailure) {\n207|\t\t\t\t\tmatched = true\n208|\t\t\t\t}\n209|\t\t\t}\n210|\t\t\tif !matched {\n211|\t\t\t\tt.Fatalf(\"plant reported %q, want a failure containing %q\", failures, plant.wantFailure)\n212|\t\t\t}\n213|\t\t})\n214|\t}\n215|}\n216|\n217|// TestCensusAuditParsingFailsClosed proves the plant harness\n218|// itself is fail-closed: an unparseable control is a harness\n219|// failure, never a clean plant.\n220|func TestCensusAuditParsingFailsClosed(t *testing.T) {\n221|\t_, _, failure := invcore.ParseSource(\"plant.go\", []byte(\"package provider\\nfunc broken( {\\n\"))\n222|\tif failure == \"\" {\n223|\t\tt.Fatal(\"unparseable control parsed clean; the harness would pass a blind plant\")\n224|\t}\n225|}\n226|\n227|// TestRegistryExcludedNameStillFailsOnRebind proves the\n228|// validateProviderIdentityRecord exclusion above loses nothing:\n229|// a true rebinding of the excluded name derives an unregistered\n230|// shape site through the production shape extractor, so the\n231|// shape census fails it even though this audit stays silent.\n232|func TestRegistryExcludedNameStillFailsOnRebind(t *testing.T) {\n233|\tsource := `package provider\n234|import \"unicode/utf8\"\n235|func validateProviderIdentityRecord(value string) int { return utf8.RuneCountInString(value) }\n236|var rebound = validateProviderIdentityRecord\n237|`\n238|\tsites := shapeSitesInPackage(\"provider\", map[string][]byte{\"control.go\": []byte(source)})\n239|\tmatched := false\n240|\tfor _, site := range sites {\n241|\t\tif site.symbol == \"rebound\" {\n242|\t\t\tmatched = true\n243|\t\t\tif _, ok := shapeLedger[site.key()]; ok {\n244|\t\t\t\tt.Fatalf(\"rebound site %q is registered; the control proves nothing\", site.key())\n245|\t\t\t}\n246|\t\t\tif _, ok := sharedLedger[site.key()]; ok {\n247|\t\t\t\tt.Fatalf(\"rebound site %q is registered; the control proves nothing\", site.key())\n248|\t\t\t}\n249|\t\t}\n250|\t}\n251|\tif !matched {\n252|\t\tt.Fatalf(\"rebinding derived no site for the new name (all sites: %v); the shape layer would pass a true alias\", sites)\n253|\t}\n254|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67b","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":408,"recorded_at":1780531400000811,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"9af9d5bd-1bfc-41af-b9a3-391369b3e6e3"},"task_id":"9af9d5bd-1bfc-41af-b9a3-391369b3e6e3","event":{"kind":"completed","task_id":"9af9d5bd-1bfc-41af-b9a3-391369b3e6e3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67d","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":409,"recorded_at":1780531400000813,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b1ff68d74f0bd27ae9ebce00a78","text":"Read text file `internal/environ/refusal_site_audit_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"flag\"\n8|\t\"fmt\"\n9|\t\"go/ast\"\n10|\t\"go/parser\"\n11|\t\"go/token\"\n12|\t\"os\"\n13|\t\"path/filepath\"\n14|\t\"sort\"\n15|\t\"strconv\"\n16|\t\"strings\"\n17|\t\"testing\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n20|)\n21|\n22|// This file is the refusal-site audit for the environ library.\n23|// Every refusal in this package funnels through the refuse\n24|// constructor var, and every battery witness must resolve to the\n25|// production SITE that refused it — not to a (code, detail) text\n26|// pair a sibling arm could share. Before runtime site recording,\n27|// 62 of 184 arms elsewhere in this repository shared a pair with\n28|// a sibling, so a witness could pass through the wrong arm; this\n29|// audit applies that lesson here in three parts:\n30|//\n31|//  1. Static derivation: every direct refuse() call site is\n32|//     derived from production AST as file:line, with its rule\n33|//     expanded over the frame-fault space for the two\n34|//     passthrough arms. Every call must sit on a single source\n35|//     line so the runtime site and the parsed site agree, and\n36|//     every expanded rule must be unique, which promotes the\n37|//     batteries' full-text assertions to site witnesses.\n38|//  2. Runtime recording: TestMain swaps the refuse var with a\n39|//     recording wrapper, so an aliased call still executes the\n40|//     swapped var and records its real production use site. The\n41|//     driver table below exercises every derived site through\n42|//     the production entries and asserts the recorded rule per\n43|//     vector; the audit requires the exercised site set to\n44|//     equal the derived set in both directions, and the\n45|//     observed rule set to equal the derived rule set exactly.\n46|//  3. Alias audit: every refuse reference outside direct-call\n47|//     position fails, through invcore.AuditConstructorReferences\n48|//     with the funnel's own declaration allowlisted by derived\n49|//     position (a var funnel, unlike a func declaration, needs\n50|//     its position allowlisted explicitly; the plants prove a\n51|//     second binding still fails).\n52|\n53|// refusalRecorder is the shared core's runtime direction: the\n54|// production file:line behind every exercised refusal plus the\n55|// rule strings those refusals carried.\n56|var refusalRecorder = invcore.NewSiteRecorder()\n57|\n58|// TestMain swaps the refuse constructor var with a recording\n59|// wrapper for the whole in-package run, then audits the\n60|// exercised sites against the derived inventory on a full run.\n61|func TestMain(main *testing.M) {\n62|\toriginal := refuse\n63|\trefuse = func(rule, member string) error {\n64|\t\terr := original(rule, member)\n65|\t\trefusalRecorder.Record(rule, 1)\n66|\t\treturn err\n67|\t}\n68|\tcode := main.Run()\n69|\tif code == 0 && fullPackageTestRun() {\n70|\t\tif failures := auditRefusalSites(); len(failures) != 0 {\n71|\t\t\tfor _, failure := range failures {\n72|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n73|\t\t\t}\n74|\t\t\tcode = 1\n75|\t\t}\n76|\t}\n77|\tos.Exit(code)\n78|}\n79|\n80|func fullPackageTestRun() bool {\n81|\tselected := flag.Lookup(\"test.run\")\n82|\treturn selected == nil || selected.Value.String() == \"\"\n83|}\n84|\n85|// refuseSite is one derived refusal site: where it is, what rule\n86|// it emits, and which member it names (\"*\" when dynamic).\n87|type refuseSite struct {\n88|\tfile   string\n89|\tline   int\n90|\trule   string\n91|\tmember string\n92|}\n93|\n94|func (site refuseSite) key() string {\n95|\treturn site.file + \":\" + strconv.Itoa(site.line)\n96|}\n97|\n98|// deriveFaultDetails derives the frame-fault space from decode.go\n99|// production: every Fault* constant value. A sixth fault shape\n100|// fails the audit instead of passing unrostered.\n101|func deriveFaultDetails() (map[string]bool, []string) {\n102|\tdirectory, err := os.Getwd()\n103|\tif err != nil {\n104|\t\treturn nil, []string{\"refusal audit: \" + err.Error()}\n105|\t}\n106|\tpath := filepath.Join(directory, \"decode.go\")\n107|\tsource, err := os.ReadFile(path)\n108|\tif err != nil {\n109|\t\treturn nil, []string{\"refusal audit: read decode.go: \" + err.Error()}\n110|\t}\n111|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n112|\tif err != nil {\n113|\t\treturn nil, []string{\"refusal audit: parse decode.go: \" + err.Error() + \"; an unparseable derivation proves nothing\"}\n114|\t}\n115|\tdetails := map[string]bool{}\n116|\tfor _, decl := range syntax.Decls {\n117|\t\tnode, ok := decl.(*ast.GenDecl)\n118|\t\tif !ok {\n119|\t\t\tcontinue\n120|\t\t}\n121|\t\tfor _, spec := range node.Specs {\n122|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n123|\t\t\tif !ok {\n124|\t\t\t\tcontinue\n125|\t\t\t}\n126|\t\t\tfor index, name := range value.Names {\n127|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n128|\t\t\t\t\tcontinue\n129|\t\t\t\t}\n130|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n131|\t\t\t\tif !ok {\n132|\t\t\t\t\treturn nil, []string{\"refusal audit: Fault constant is not a literal; the extractor cannot see through indirection\"}\n133|\t\t\t\t}\n134|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n135|\t\t\t\tif err != nil {\n136|\t\t\t\t\treturn nil, []string{\"refusal audit: \" + err.Error()}\n137|\t\t\t\t}\n138|\t\t\t\tdetails[text] = true\n139|\t\t\t}\n140|\t\t}\n141|\t}\n142|\tif len(details) == 0 {\n143|\t\treturn nil, []string{\"refusal audit derived zero fault details; the scanner is blind, not the space empty\"}\n144|\t}\n145|\treturn details, nil\n146|}\n147|\n148|// deriveRefuseSites derives every direct refuse() call in the\n149|// environ package as file:line with its expanded rule. The two\n150|// frame-fault passthrough arms expand over the derived fault\n151|// space; every other arm carries literal rule and member. A\n152|// non-literal rule outside the passthrough shape, or a call\n153|// spanning several lines, fails closed.\n154|func deriveRefuseSites(files []invcore.ProductionFile, fileSet *token.FileSet, faults map[string]bool) ([]refuseSite, []string) {\n155|\tvar sites []refuseSite\n156|\tvar failures []string\n157|\tfor _, production := range files {\n158|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n159|\t\t\tcall, ok := node.(*ast.CallExpr)\n160|\t\t\tif !ok {\n161|\t\t\t\treturn true\n162|\t\t\t}\n163|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n164|\t\t\tif !ok || identifier.Name != \"refuse\" || len(call.Args) != 2 {\n165|\t\t\t\treturn true\n166|\t\t\t}\n167|\t\t\tposition := fileSet.Position(identifier.Pos())\n168|\t\t\tif !position.IsValid() {\n169|\t\t\t\tfailures = append(failures, production.Name+\": refuse call at an invalid position\")\n170|\t\t\t\treturn true\n171|\t\t\t}\n172|\t\t\tend := fileSet.Position(call.End())\n173|\t\t\tif end.Line != position.Line {\n174|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse call spans several lines; the runtime site and the parsed site would disagree\")\n175|\t\t\t\treturn true\n176|\t\t\t}\n177|\t\t\tsite := refuseSite{file: production.Name, line: position.Line}\n178|\t\t\tswitch first := call.Args[0].(type) {\n179|\t\t\tcase *ast.BasicLit:\n180|\t\t\t\trule, err := strconv.Unquote(first.Value)\n181|\t\t\t\tif err != nil {\n182|\t\t\t\t\tfailures = append(failures, site.key()+\": refuse rule is not a string literal\")\n183|\t\t\t\t\treturn true\n184|\t\t\t\t}\n185|\t\t\t\tsite.rule = rule\n186|\t\t\t\tif member, ok := call.Args[1].(*ast.BasicLit); ok {\n187|\t\t\t\t\ttext, err := strconv.Unquote(member.Value)\n188|\t\t\t\t\tif err != nil {\n189|\t\t\t\t\t\tfailures = append(failures, site.key()+\": refuse member is not a string literal\")\n190|\t\t\t\t\t\treturn true\n191|\t\t\t\t\t}\n192|\t\t\t\t\tsite.member = text\n193|\t\t\t\t} else {\n194|\t\t\t\t\tsite.member = \"*\"\n195|\t\t\t\t}\n196|\t\t\t\tsites = append(sites, site)\n197|\t\t\tcase *ast.BinaryExpr:\n198|\t\t\t\tprefix, ok := passthroughPrefix(first)\n199|\t\t\t\tif !ok {\n200|\t\t\t\t\tfailures = append(failures, site.key()+\": refuse rule is neither a literal nor a frame-fault passthrough; the extractor cannot see through it\")\n201|\t\t\t\t\treturn true\n202|\t\t\t\t}\n203|\t\t\t\tfor detail := range faults {\n204|\t\t\t\t\texpanded := site\n205|\t\t\t\t\texpanded.rule = prefix + detail\n206|\t\t\t\t\texpanded.member = \"*\"\n207|\t\t\t\t\tsites = append(sites, expanded)\n208|\t\t\t\t}\n209|\t\t\tdefault:\n210|\t\t\t\tfailures = append(failures, site.key()+\": refuse rule is neither a literal nor a frame-fault passthrough; the extractor cannot see through it\")\n211|\t\t\t\treturn true\n212|\t\t\t}\n213|\t\t\treturn true\n214|\t\t})\n215|\t}\n216|\treturn sites, failures\n217|}\n218|\n219|// passthroughPrefix matches `\"tuple \"+fault.Detail` and\n220|// `\"observation \"+fault.Detail` and reports the literal prefix.\n221|func passthroughPrefix(expression *ast.BinaryExpr) (string, bool) {\n222|\tif expression.Op != token.ADD {\n223|\t\treturn \"\", false\n224|\t}\n225|\tliteral, ok := expression.X.(*ast.BasicLit)\n226|\tif !ok || literal.Kind != token.STRING {\n227|\t\treturn \"\", false\n228|\t}\n229|\tprefix, err := strconv.Unquote(literal.Value)\n230|\tif err != nil {\n231|\t\treturn \"\", false\n232|\t}\n233|\tselector, ok := expression.Y.(*ast.SelectorExpr)\n234|\tif !ok || selector.Sel.Name != \"Detail\" {\n235|\t\treturn \"\", false\n236|\t}\n237|\tif identifier, ok := selector.X.(*ast.Ident); !ok || identifier.Name != \"fault\" {\n238|\t\treturn \"\", false\n239|\t}\n240|\treturn prefix, true\n241|}\n242|\n243|// funnelDeclarationPositions derives the positions of the refuse\n244|// funnel's own declaration: a package-level `var refuse = ...`\n245|// binding a function literal. invcore's audit allowlists func\n246|// declarations by position but has no var-funnel rule, so this\n247|// audit allowlists the derived position explicitly; any other\n248|// binding of the name still fails.\n249|func funnelDeclarationPositions(syntax *ast.File) map[token.Pos]bool {\n250|\tpositions := map[token.Pos]bool{}\n251|\tfor _, decl := range syntax.Decls {\n252|\t\tgeneral, ok := decl.(*ast.GenDecl)\n253|\t\tif !ok || general.Tok != token.VAR {\n254|\t\t\tcontinue\n255|\t\t}\n256|\t\tfor _, spec := range general.Specs {\n257|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n258|\t\t\tif !ok {\n259|\t\t\t\tcontinue\n260|\t\t\t}\n261|\t\t\tfor index, name := range value.Names {\n262|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n263|\t\t\t\t\tcontinue\n264|\t\t\t\t}\n265|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n266|\t\t\t\t\tpositions[name.Pos()] = true\n267|\t\t\t\t}\n268|\t\t\t}\n269|\t\t}\n270|\t}\n271|\treturn positions\n272|}\n273|\n274|// auditRefuseReferences runs the alias audit over one file,\n275|// allowlisting the funnel's own declaration position. Every\n276|// other refuse reference outside direct-call position — an\n277|// aliased, rebound, shadowed, or otherwise indirected use —\n278|// fails.\n279|func auditRefuseReferences(syntax *ast.File, fileSet *token.FileSet, display string) []string {\n280|\tspec := invcore.ConstructorSpec{Local: map[string]bool{\"refuse\": true}}\n281|\tallowed := funnelDeclarationPositions(syntax)\n282|\tvar failures []string\n283|\tfor _, failure := range invcore.AuditConstructorReferences(syntax, fileSet, display, spec) {\n284|\t\tif failureAtFunnelDeclaration(failure, display, fileSet, allowed) {\n285|\t\t\tcontinue\n286|\t\t}\n287|\t\tfailures = append(failures, failure)\n288|\t}\n289|\treturn failures\n290|}\n291|\n292|// failureAtFunnelDeclaration reports whether an audit failure\n293|// names the funnel's own declaration position.\n294|func failureAtFunnelDeclaration(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n295|\tfor position := range allowed {\n296|\t\tlocated := fileSet.Position(position)\n297|\t\tif !located.IsValid() {\n298|\t\t\tcontinue\n299|\t\t}\n300|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n301|\t\tif strings.HasPrefix(failure, prefix) {\n302|\t\t\treturn true\n303|\t\t}\n304|\t}\n305|\treturn false\n306|}\n307|\n308|// auditRefusalSites derives the refusal inventory from package\n309|// source and compares it against the exercised run: derived\n310|// sites without an exercised path and exercised sites outside\n311|// the derivation fail together through the invcore harness, the\n312|// observed rule set must equal the derived rule set exactly,\n313|// every expanded rule must be unique (so a full-text witness\n314|// resolves to exactly one site), and every refuse reference\n315|// outside direct-call position fails.\n316|func auditRefusalSites() []string {\n317|\tdirectory, err := os.Getwd()\n318|\tif err != nil {\n319|\t\treturn []string{\"refusal audit: \" + err.Error()}\n320|\t}\n321|\tfiles, fileSet, failures := invcore.ScanProduction(directory)\n322|\tfor _, failure := range failures {\n323|\t\treturn []string{\"refusal audit: \" + failure}\n324|\t}\n325|\tfaults, faultFailures := deriveFaultDetails()\n326|\tif len(faultFailures) != 0 {\n327|\t\treturn faultFailures\n328|\t}\n329|\tsites, siteFailures := deriveRefuseSites(files, fileSet, faults)\n330|\tfailures = append(failures, siteFailures...)\n331|\tseen := map[string]string{}\n332|\tfor _, site := range sites {\n333|\t\tif first, duplicate := seen[site.rule]; duplicate {\n334|\t\t\tfailures = append(failures, \"refusal audit: rule \"+strconv.Quote(site.rule)+\" is shared by \"+first+\" and \"+site.key()+\"; a witness asserting it resolves to two sites, not one\")\n335|\t\t\tcontinue\n336|\t\t}\n337|\t\tseen[site.rule] = site.key()\n338|\t}\n339|\tderived := map[string]struct{}{}\n340|\trules := map[string]struct{}{}\n341|\tfor _, site := range sites {\n342|\t\tderived[site.key()] = struct{}{}\n343|\t\trules[site.rule] = struct{}{}\n344|\t}\n345|\tvar wantRules []string\n346|\tfor rule := range rules {\n347|\t\twantRules = append(wantRules, rule)\n348|\t}\n349|\tsort.Strings(wantRules)\n350|\tfailures = append(failures, refusalRecorder.AuditSites(\"environ refusals\", len(files), derived, wantRules)...)\n351|\tfor _, production := range files {\n352|\t\tdisplay := production.Name\n353|\t\tfailures = append(failures, auditRefuseReferences(production.Syntax, fileSet, display)...)\n354|\t}\n355|\treturn failures\n356|}\n357|\n358|// auditDigest returns the pinned digest of one seed, mirroring\n359|// the shared battery fixtures without importing them.\n360|func auditDigest(seed string) string {\n361|\tsum := sha256.Sum256([]byte(seed))\n362|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n363|}\n364|\n365|// auditTupleJSON is one valid Environment Tuple over locally\n366|// computed identities.\n367|func auditTupleJSON() []byte {\n368|\treturn []byte(`{\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":` +\n369|\t\tstrconv.Quote(auditDigest(\"test-store-fingerprint\")) + `,\"adapter_version\":\"1.2.3\"}`)\n370|}\n371|\n372|// auditCapabilitiesJSON is the exact eight-name capability map\n373|// with every capability available.\n374|func auditCapabilitiesJSON() string {\n375|\tnames := []string{\n376|\t\t\"directory_discovery\",\n377|\t\t\"directory_incremental_scan\",\n378|\t\t\"directory_head_digest\",\n379|\t\t\"directory_tail_preview\",\n380|\t\t\"native_title_read\",\n381|\t\t\"native_runtime_observation\",\n382|\t\t\"existing_session_adoption\",\n383|\t\t\"native_resume\",\n384|\t}\n385|\tparts := make([]string, 0, len(names))\n386|\tfor _, name := range names {\n387|\t\tparts = append(parts, strconv.Quote(name)+`:`+auditAvailableCapabilityJSON())\n388|\t}\n389|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n390|}\n391|\n392|// auditAvailableCapabilityJSON is one available CapabilityResult\n393|// with null reason.\n394|func auditAvailableCapabilityJSON() string {\n395|\treturn `{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`\n396|}\n397|\n398|// auditObservationJSON is one valid Environment Observation over\n399|// locally computed identities.\n400|func auditObservationJSON() []byte {\n401|\treturn []byte(`{\"schema\":\"urn:ax:schema:environment-observation\",\"schema_version\":\"1.0.0\",\"observation_id\":` +\n402|\t\tstrconv.Quote(auditDigest(\"test-observation\")) + `,\"host_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"installation_id\":` +\n403|\t\tstrconv.Quote(auditDigest(\"test-installation\")) + `,\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"provider_id\":\"test-provider\",` +\n404|\t\t`\"platform\":\"linux\",\"architecture\":\"amd64\",\"backend_realm_fingerprint\":` + strconv.Quote(auditDigest(\"test-realm\")) +\n405|\t\t`,\"capabilities\":` + auditCapabilitiesJSON() + `,\"authentication_status\":\"available\",\"runtime_status\":\"available\",` +\n406|\t\t`\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`)\n407|}\n408|\n409|// decodeAuditMembers parses one JSON object into raw member\n410|// texts.\n411|func decodeAuditMembers(body []byte) (map[string]string, error) {\n412|\tvar raw map[string]json.RawMessage\n413|\tif err := json.Unmarshal(body, &raw); err != nil {\n414|\t\treturn nil, err\n415|\t}\n416|\tmembers := make(map[string]string, len(raw))\n417|\tfor name, value := range raw {\n418|\t\tmembers[name] = string(value)\n419|\t}\n420|\treturn members, nil\n421|}\n422|\n423|// encodeAuditMembers renders the member map as one JSON object\n424|// with sorted member names, so the drivers are deterministic.\n425|func encodeAuditMembers(members map[string]string) []byte {\n426|\tnames := make([]string, 0, len(members))\n427|\tfor name := range members {\n428|\t\tnames = append(names, name)\n429|\t}\n430|\tsort.Strings(names)\n431|\tparts := make([]string, 0, len(members))\n432|\tfor _, name := range names {\n433|\t\tparts = append(parts, strconv.Quote(name)+\":\"+members[name])\n434|\t}\n435|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n436|}\n437|\n438|// mutateAuditMember returns the object with one top-level member\n439|// replaced by the given raw JSON.\n440|func mutateAuditMember(t *testing.T, body []byte, member, replacement string) []byte {\n441|\tt.Helper()\n442|\tparsed, err := decodeAuditMembers(body)\n443|\tif err != nil {\n444|\t\tt.Fatalf(\"driver: fixture is not JSON: %v\", err)\n445|\t}\n446|\tparsed[member] = replacement\n447|\treturn encodeAuditMembers(parsed)\n448|}\n449|\n450|// dropAuditMember returns the object without one top-level\n451|// member.\n452|func dropAuditMember(t *testing.T, body []byte, member string) []byte {\n453|\tt.Helper()\n454|\tparsed, err := decodeAuditMembers(body)\n455|\tif err != nil {\n456|\t\tt.Fatalf(\"driver: fixture is not JSON: %v\", err)\n457|\t}\n458|\tdelete(parsed, member)\n459|\treturn encodeAuditMembers(parsed)\n460|}\n461|\n462|// appendAuditMember returns the object with one added top-level\n463|// member.\n464|func appendAuditMember(t *testing.T, body []byte, member, literal string) []byte {\n465|\tt.Helper()\n466|\tparsed, err := decodeAuditMembers(body)\n467|\tif err != nil {\n468|\t\tt.Fatalf(\"driver: fixture is not JSON: %v\", err)\n469|\t}\n470|\tif _, present := parsed[member]; present {\n471|\t\tt.Fatalf(\"driver: %q already present\", member)\n472|\t}\n473|\tparsed[member] = literal\n474|\treturn encodeAuditMembers(parsed)\n475|}\n476|\n477|// refusalDriver is one exercised refusal: the body, the entry\n478|// that must refuse it, and the exact rule the recorder must\n479|// observe behind it.\n480|type refusalDriver struct {\n481|\tname  string\n482|\tbody  []byte\n483|\tdrive func([]byte) error\n484|\trule  string\n485|\t// member is the exact member the refusal must name, or \"\"\n486|\t// when the refusal must name none. Missing-member members\n487|\t// follow the required-list order and single-unknown members\n488|\t// are deterministic, so every expectation here is exact.\n489|\tmember string\n490|}\n491|\n492|// refusalDrivers exercises every derived refuse site through the\n493|// production entries. The frame-fault passthrough arms expand to\n494|// one vector per fault detail; every literal arm owns one\n495|// vector. Each vector asserts the recorded rule, so a witness\n496|// that passed through the wrong arm fails here rather than\n497|// passing on shared text.\n498|func refusalDrivers(t *testing.T) []refusalDriver {\n499|\tt.Helper()\n500|\ttuple := auditTupleJSON()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c67f","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":410,"recorded_at":1780531400000815,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b1ff7437ee3a8f5d675cb178b48","text":"Read text file `internal/environ/census_audit_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n10|)\n11|\n12|// This file is the alias-bypass audit over the shared-rule census\n13|// scope. The name layer (census_test.go) derives definitions by\n14|// identifier and the shape layer (shape_census_test.go) derives\n15|// implementations by texture; neither sees a use-site alias — an\n16|// import alias rebound to a shared helper, or a package-level var\n17|// rebound to one — because no new definition appears. This audit\n18|// closes that direction with invcore.AuditConstructorReferences:\n19|// every reference to a ledgered shared-rule name outside\n20|// direct-call position fails, every shape the audit cannot\n21|// classify (dot imports, shadowed names) fails closed, and the\n22|// synthetic plants below prove each shape reports while direct\n23|// calls and the constructors' own declarations stay clean.\n24|\n25|// sharedRuleConstructorSpec watches the ledgered shared-rule\n26|// names: package-local bare identifiers by spelling, and the\n27|// canonical environ members by import path and member name, so an\n28|// import alias cannot change what the audit sees. The local set\n29|// is the name layer's symbol map minus\n30|// validateProviderIdentityRecord: canonicaljson registers that\n31|// validator by function value in its schema dispatch table\n32|// (closed_shapes.go), which is same-function dispatch rather\n33|// than a copy or an alias — every invocation still executes the\n34|// censused definition. A true rebinding of it (`var f =\n35|// validateProviderIdentityRecord`) still fails, via the shape\n36|// layer's var-alias rule, which inherits the helper's\n37|// string-measure shape onto the new name and reports it as an\n38|// unregistered site (proven by the C1 controls in\n39|// TestShapeCensusCatchesControls). The qualified set is the\n40|// environ surface the facades delegate to.\n41|func sharedRuleConstructorSpec() invcore.ConstructorSpec {\n42|\tlocal := make(map[string]bool, len(sharedFunctionSymbols))\n43|\tfor name := range sharedFunctionSymbols {\n44|\t\tif name == \"validateProviderIdentityRecord\" {\n45|\t\t\tcontinue\n46|\t\t}\n47|\t\tlocal[name] = true\n48|\t}\n49|\treturn invcore.ConstructorSpec{\n50|\t\tLocal: local,\n51|\t\tQualified: map[string]map[string]bool{\n52|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\": {\n53|\t\t\t\t\"DecodeStrictObject\":           true,\n54|\t\t\t\t\"HasLoneSurrogateEscape\":       true,\n55|\t\t\t\t\"StringLength\":                 true,\n56|\t\t\t\t\"CheckStringBounds\":            true,\n57|\t\t\t\t\"CheckUint53Bounds\":            true,\n58|\t\t\t\t\"CheckDigest\":                  true,\n59|\t\t\t\t\"CheckUUIDv7\":                  true,\n60|\t\t\t\t\"CheckTimestamp\":               true,\n61|\t\t\t\t\"CheckSortedUniqueStrings\":     true,\n62|\t\t\t\t\"CheckSortedUniqueDigests\":     true,\n63|\t\t\t\t\"CheckExtensions\":              true,\n64|\t\t\t\t\"CheckEnvironmentID\":           true,\n65|\t\t\t\t\"CheckSemver\":                  true,\n66|\t\t\t\t\"DecodeTuple\":                  true,\n67|\t\t\t\t\"DecodeEnvironmentObservation\": true,\n68|\t\t\t},\n69|\t\t},\n70|\t}\n71|}\n72|\n73|// censusScopePackages lists the audit scope in a fixed order: the\n74|// name layer's package set, which this audit shares by\n75|// construction.\n76|func censusScopePackages() []string {\n77|\tpackages := make([]string, 0, len(censusPackages))\n78|\tfor pkg := range censusPackages {\n79|\t\tpackages = append(packages, pkg)\n80|\t}\n81|\tsort.Strings(packages)\n82|\treturn packages\n83|}\n84|\n85|// TestCensusScopeHasNoAliasedSharedRules requires every\n86|// shared-rule reference in census-scope production to sit in\n87|// direct-call position: an aliased, rebound, or otherwise\n88|// indirected construction fails here even though the name and\n89|// shape censuses stay green over it. The delegation this leaf\n90|// added (sessadapter and dirnode calling environ.Check* and\n91|// friends directly) is the allowed position and stays clean.\n92|func TestCensusScopeHasNoAliasedSharedRules(t *testing.T) {\n93|\troot, err := internalRoot(t)\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"alias audit: %v\", err)\n96|\t}\n97|\tspec := sharedRuleConstructorSpec()\n98|\tfor _, pkg := range censusScopePackages() {\n99|\t\tfiles, fileSet := invcore.MustScanProduction(t, filepath.Join(root, pkg))\n100|\t\tfor _, production := range files {\n101|\t\t\tdisplay := pkg + \"/\" + production.Name\n102|\t\t\tinvcore.MustAuditConstructorReferences(t, production.Syntax, fileSet, display, spec)\n103|\t\t}\n104|\t}\n105|}\n106|\n107|// aliasPlant is one synthetic control for the audit: the source,\n108|// whether the audit must report, and the fragment the failure\n109|// must carry (\"\" for clean plants).\n110|type aliasPlant struct {\n111|\tname        string\n112|\tsource      string\n113|\twantFailure string\n114|}\n115|\n116|// aliasPlants enumerates the bypass shapes. The import-alias and\n117|// var-binding plants are the shapes that walked through every\n118|// identifier-keyed gate in this repository's history; the dot\n119|// import and shadow plants are the shapes the audit cannot\n120|// classify and must fail closed rather than prune.\n121|func aliasPlants() []aliasPlant {\n122|\treturn []aliasPlant{\n123|\t\t{\n124|\t\t\tname: \"var binding of a local shared helper reports\",\n125|\t\t\tsource: `package provider\n126|func stringLength(value string) int { return len(value) }\n127|var measure = stringLength\n128|func use(value string) int { return measure(value) }\n129|`,\n130|\t\t\twantFailure: \"outside direct-call position\",\n131|\t\t},\n132|\t\t{\n133|\t\t\tname: \"import alias rebound to the canonical helper reports\",\n134|\t\t\tsource: `package provider\n135|import env \"github.com/relux-works/agent-session-manager/internal/environ\"\n136|var length = env.StringLength\n137|func use(value string) int { return length(value) }\n138|`,\n139|\t\t\twantFailure: \"outside direct-call position\",\n140|\t\t},\n141|\t\t{\n142|\t\t\tname: \"aliased direct call stays clean\",\n143|\t\t\tsource: `package provider\n144|import env \"github.com/relux-works/agent-session-manager/internal/environ\"\n145|func use(value string) int { return env.StringLength(value) }\n146|`,\n147|\t\t},\n148|\t\t{\n149|\t\t\tname: \"canonical direct call stays clean\",\n150|\t\t\tsource: `package provider\n151|import \"github.com/relux-works/agent-session-manager/internal/environ\"\n152|func use(value string) int { return environ.StringLength(value) }\n153|func decode(data []byte) bool {\n154|\tmembers, _ := environ.DecodeStrictObject(data)\n155|\treturn members != nil\n156|}\n157|`,\n158|\t\t},\n159|\t\t{\n160|\t\t\tname: \"local direct call stays clean\",\n161|\t\t\tsource: `package provider\n162|func stringLength(value string) int { return len(value) }\n163|func use(value string) int { return stringLength(value) }\n164|`,\n165|\t\t},\n166|\t\t{\n167|\t\t\tname: \"dot import of the watched path fails closed\",\n168|\t\t\tsource: `package provider\n169|import . \"github.com/relux-works/agent-session-manager/internal/environ\"\n170|func use(value string) int { return StringLength(value) }\n171|`,\n172|\t\t\twantFailure: \"dot-imports watched path\",\n173|\t\t},\n174|\t\t{\n175|\t\t\tname: \"shadowed constructor name fails closed\",\n176|\t\t\tsource: `package provider\n177|func use(stringLength string) string { return stringLength }\n178|`,\n179|\t\t\twantFailure: \"stringLength\",\n180|\t\t},\n181|\t}\n182|}\n183|\n184|// TestCensusAuditCatchesAliasShapes drives every plant through\n185|// the production audit spec and requires the ledgered outcome:\n186|// reporting shapes fail with their fragment, clean shapes stay\n187|// clean. A plant that stops reporting proves nothing and fails\n188|// here by construction.\n189|func TestCensusAuditCatchesAliasShapes(t *testing.T) {\n190|\tspec := sharedRuleConstructorSpec()\n191|\tfor _, plant := range aliasPlants() {\n192|\t\tt.Run(plant.name, func(t *testing.T) {\n193|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n194|\t\t\tif failure != \"\" {\n195|\t\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n196|\t\t\t}\n197|\t\t\tfailures := invcore.AuditConstructorReferences(syntax, fileSet, \"plant.go\", spec)\n198|\t\t\tif plant.wantFailure == \"\" {\n199|\t\t\t\tif len(failures) != 0 {\n200|\t\t\t\t\tt.Fatalf(\"clean plant reported: %s\", strings.Join(failures, \"; \"))\n201|\t\t\t\t}\n202|\t\t\t\treturn\n203|\t\t\t}\n204|\t\t\tmatched := false\n205|\t\t\tfor _, failure := range failures {\n206|\t\t\t\tif strings.Contains(failure, plant.wantFailure) {\n207|\t\t\t\t\tmatched = true\n208|\t\t\t\t}\n209|\t\t\t}\n210|\t\t\tif !matched {\n211|\t\t\t\tt.Fatalf(\"plant reported %q, want a failure containing %q\", failures, plant.wantFailure)\n212|\t\t\t}\n213|\t\t})\n214|\t}\n215|}\n216|\n217|// TestCensusAuditParsingFailsClosed proves the plant harness\n218|// itself is fail-closed: an unparseable control is a harness\n219|// failure, never a clean plant.\n220|func TestCensusAuditParsingFailsClosed(t *testing.T) {\n221|\t_, _, failure := invcore.ParseSource(\"plant.go\", []byte(\"package provider\\nfunc broken( {\\n\"))\n222|\tif failure == \"\" {\n223|\t\tt.Fatal(\"unparseable control parsed clean; the harness would pass a blind plant\")\n224|\t}\n225|}\n226|\n227|// TestRegistryExcludedNameStillFailsOnRebind proves the\n228|// validateProviderIdentityRecord exclusion above loses nothing:\n229|// a true rebinding of the excluded name derives an unregistered\n230|// shape site through the production shape extractor, so the\n231|// shape census fails it even though this audit stays silent.\n232|func TestRegistryExcludedNameStillFailsOnRebind(t *testing.T) {\n233|\tsource := `package provider\n234|import \"unicode/utf8\"\n235|func validateProviderIdentityRecord(value string) int { return utf8.RuneCountInString(value) }\n236|var rebound = validateProviderIdentityRecord\n237|`\n238|\tsites := shapeSitesInPackage(\"provider\", map[string][]byte{\"control.go\": []byte(source)})\n239|\tmatched := false\n240|\tfor _, site := range sites {\n241|\t\tif site.symbol == \"rebound\" {\n242|\t\t\tmatched = true\n243|\t\t\tif _, ok := shapeLedger[site.key()]; ok {\n244|\t\t\t\tt.Fatalf(\"rebound site %q is registered; the control proves nothing\", site.key())\n245|\t\t\t}\n246|\t\t\tif _, ok := sharedLedger[site.key()]; ok {\n247|\t\t\t\tt.Fatalf(\"rebound site %q is registered; the control proves nothing\", site.key())\n248|\t\t\t}\n249|\t\t}\n250|\t}\n251|\tif !matched {\n252|\t\tt.Fatalf(\"rebinding derived no site for the new name (all sites: %v); the shape layer would pass a true alias\", sites)\n253|\t}\n254|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c681","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":411,"recorded_at":1780531400000817,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b1ff7fa79a0845f65bc02f39240","text":"Read text file `internal/environ/scalar_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file is the scalar lone-surrogate agreement battery: the\n12|// third spelling of the gate. scalar.decodeJSONString validates a\n13|// single JSON string scalar (the data IS one JSON string), while\n14|// environ.DecodeStrictObject validates a full object frame, so\n15|// the two cannot share an implementation — delegating either way\n16|// would be the wrong unit — and this battery is what keeps the\n17|// retained copy honest in both directions.\n18|//\n19|// Both sides are driven through production entries on one shared\n20|// corpus: the environ side wraps the literal as {\"v\":LITERAL} and\n21|// asserts the frame fault, while the scalar side drives\n22|// scalar.DecodeClosedEnumJSON and asserts the scalar refusal\n23|// text. A verdict flip in EITHER direction reddens its row.\n24|//\n25|// The gate verdict is isolated from the content rules behind it:\n26|// scalar rows that admit at the gate but refuse at the closed\n27|// vocabulary arm assert the membership text with the gate phrase\n28|// asserted ABSENT, proving travel past the gate (the same\n29|// absent-phrase technique the frame battery uses). A gate that\n30|// refused everything would fail those rows; a gate that admitted\n31|// a lone escape would fail the refuse rows. Malformed and\n32|// truncated escapes fall through to the syntax arms on both\n33|// sides and assert those arms explicitly, so a gate that claimed\n34|// them could not pass.\n35|\n36|// scalarRow is one agreement vector: the JSON string literal, the\n37|// environ frame verdict (\"\" admits), and the scalar verdict.\n38|type scalarRow struct {\n39|\tname string\n40|\t// inner is the raw JSON string content between the quotes:\n41|\t// backslashes here are JSON source backslashes.\n42|\tinner string\n43|\t// environRefuse names the frame fault, or \"\" when the frame\n44|\t// gate admits.\n45|\tenvironRefuse string\n46|\t// scalarRefuse names the scalar refusal text the verdict\n47|\t// must contain, or \"\" when the scalar entry admits. A\n48|\t// membership refusal proves the gate admitted: the\n49|\t// vocabulary arm runs behind it.\n50|\tscalarRefuse string\n51|\t// scalarAbsent names a phrase the scalar error must not\n52|\t// contain, pinning travel past the named gate.\n53|\tscalarAbsent string\n54|}\n55|\n56|const (\n57|\tscalarGateText   = \"lone Unicode surrogate\"\n58|\tscalarSyntaxText = \"must be a JSON string\"\n59|\tscalarMemberText = \"is not a member of the negotiated vocabulary\"\n60|)\n61|\n62|// scalarCorpus enumerates the gate shape: bare highs and lows,\n63|// mispairs in both orders, the admitting pair, backslash-run\n64|// parity (even runs quote, odd runs escape), the composed\n65|// even-run-plus-real-escape shapes that hid the original admit\n66|// hole, the malformed fall-throughs, and multibyte text.\n67|func scalarCorpus() []scalarRow {\n68|\treturn []scalarRow{\n69|\t\t{name: \"plain admits\", inner: `abc`, environRefuse: \"\", scalarRefuse: \"\"},\n70|\t\t{name: \"bare high refused\", inner: `A\\ud800B`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n71|\t\t{name: \"bare low refused\", inner: `A\\udc00B`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n72|\t\t{name: \"high followed by non-low refused\", inner: `A\\uD83D\\u0041B`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n73|\t\t{name: \"low followed by high refused\", inner: `A\\udc00\\uD83DB`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n74|\t\t{name: \"paired surrogates admit\", inner: `A\\uD83D\\uDE00B`, environRefuse: \"\", scalarRefuse: scalarMemberText, scalarAbsent: scalarGateText},\n75|\t\t{name: \"escaped backslash high run2 admits\", inner: `A\\\\ud800B`, environRefuse: \"\", scalarRefuse: scalarMemberText, scalarAbsent: scalarGateText},\n76|\t\t{name: \"escaped backslash low run2 admits\", inner: `A\\\\udc00B`, environRefuse: \"\", scalarRefuse: scalarMemberText, scalarAbsent: scalarGateText},\n77|\t\t{name: \"escaped backslash high run3 refused\", inner: `A\\\\\\ud800B`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n78|\t\t{name: \"escaped backslash plus real lone low refused\", inner: `A\\\\ud800\\udc00B`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n79|\t\t{name: \"escaped backslash plus real lone high refused\", inner: `A\\\\udc00\\ud800B`, environRefuse: environ.FaultLoneSurrogate, scalarRefuse: scalarGateText},\n80|\t\t{name: \"escaped backslash plus real pair admits\", inner: `A\\\\ud800\\uD83D\\uDE00B`, environRefuse: \"\", scalarRefuse: scalarMemberText, scalarAbsent: scalarGateText},\n81|\t\t{name: \"malformed escape falls to syntax\", inner: `A\\uDEFG B`, environRefuse: environ.FaultNotObject, scalarRefuse: scalarSyntaxText},\n82|\t\t{name: \"truncated escape falls to syntax\", inner: `A\\uD83`, environRefuse: environ.FaultNotObject, scalarRefuse: scalarSyntaxText},\n83|\t\t{name: \"multibyte text admits\", inner: `plain ü ☃`, environRefuse: \"\", scalarRefuse: scalarMemberText, scalarAbsent: scalarGateText},\n84|\t}\n85|}\n86|\n87|// TestScalarSurrogateAgreementAcrossUnits drives the shared\n88|// corpus through both gate units and requires the ledgered\n89|// verdict at each.\n90|func TestScalarSurrogateAgreementAcrossUnits(t *testing.T) {\n91|\tfor _, row := range scalarCorpus() {\n92|\t\tt.Run(row.name, func(t *testing.T) {\n93|\t\t\tliteral := `\"` + row.inner + `\"`\n94|\t\t\tframe := []byte(`{\"v\":` + literal + `}`)\n95|\t\t\t_, fault := environ.DecodeStrictObject(frame)\n96|\t\t\tif row.environRefuse == \"\" {\n97|\t\t\t\tif fault != nil {\n98|\t\t\t\t\tt.Fatalf(\"environ refused %q: %v\", frame, fault)\n99|\t\t\t\t}\n100|\t\t\t} else {\n101|\t\t\t\tif fault == nil {\n102|\t\t\t\t\tt.Fatalf(\"environ admitted %q, want fault %q\", frame, row.environRefuse)\n103|\t\t\t\t}\n104|\t\t\t\tif fault.Detail != row.environRefuse {\n105|\t\t\t\t\tt.Fatalf(\"environ fault = %q, want %q\", fault.Detail, row.environRefuse)\n106|\t\t\t\t}\n107|\t\t\t}\n108|\t\t\t_, err := scalar.DecodeClosedEnumJSON([]byte(literal), \"abc\")\n109|\t\t\tif row.scalarRefuse == \"\" {\n110|\t\t\t\tif err != nil {\n111|\t\t\t\t\tt.Fatalf(\"scalar refused %q, want admit: %v\", literal, err)\n112|\t\t\t\t}\n113|\t\t\t\treturn\n114|\t\t\t}\n115|\t\t\tif err == nil {\n116|\t\t\t\tt.Fatalf(\"scalar admitted %q, want refusal containing %q\", literal, row.scalarRefuse)\n117|\t\t\t}\n118|\t\t\tif !strings.Contains(err.Error(), row.scalarRefuse) {\n119|\t\t\t\tt.Fatalf(\"scalar error = %v, want text containing %q\", err, row.scalarRefuse)\n120|\t\t\t}\n121|\t\t\tif row.scalarAbsent != \"\" && strings.Contains(err.Error(), row.scalarAbsent) {\n122|\t\t\t\tt.Fatalf(\"scalar error = %v, must not contain %q\", err, row.scalarAbsent)\n123|\t\t\t}\n124|\t\t})\n125|\t}\n126|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
