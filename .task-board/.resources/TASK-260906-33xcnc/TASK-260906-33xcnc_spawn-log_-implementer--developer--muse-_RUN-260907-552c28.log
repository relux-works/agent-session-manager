{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ef","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":850,"recorded_at":1780531400001695,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"e3b4fdda-f38b-4609-b7a1-cde20b4c9cf8"},"task_id":"e3b4fdda-f38b-4609-b7a1-cde20b4c9cf8","event":{"kind":"output","task_id":"e3b4fdda-f38b-4609-b7a1-cde20b4c9cf8","chunk":"Read text file `internal/provhost/protocol_test.go`.\n(139 line(s) above)\n140|\tif failureObject(t, err).Retryable() {\n141|\t\tt.Fatalf(\"DecodeResponse error = %v, want non-retryable\", err)\n142|\t}\n143|}\n144|\n145|// requireLocalRefusal asserts the arm identity of a refusal that carries\n146|// no member detail (invalid_config framing refusals and integrity_failure\n147|// status refusals): the stable code, the detail naming the rule in the\n148|// human text, and the non-retryable bit.\n149|func requireLocalRefusal(t *testing.T, err error, code axerror.Code, detail string) {\n150|\tt.Helper()\n151|\tif failureCode(t, err) != code {\n152|\t\tt.Fatalf(\"code = %v, want %s\", err, code)\n153|\t}\n154|\tif !strings.Contains(err.Error(), detail) {\n155|\t\tt.Fatalf(\"error = %v, want detail containing %q\", err, detail)\n156|\t}\n157|\tif failureObject(t, err).Retryable() {\n158|\t\tt.Fatalf(\"error = %v, want non-retryable\", err)\n159|\t}\n160|}\n161|\n162|// TestEncodeRequestEmitsExactFrame pins the request wire bytes: the six\n163|// exact members in fixed order, with the body passed through verbatim.\n164|func TestEncodeRequestEmitsExactFrame(t *testing.T) {\n165|\tframe, err := EncodeRequest(testRequest(t), mustInstant(t, testNow))\n166|\tif err != nil {\n167|\t\tt.Fatalf(\"EncodeRequest: %v\", err)\n168|\t}\n169|\twant := `{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"operation\":\"doctor\",\"deadline\":\"2026-08-19T04:05:00.000Z\",\"body\":{\"platform\":\"macos\",\"architecture\":\"arm64\",\"provider_executable\":null,\"identity\":null}}`\n170|\tif string(frame) != want {\n171|\t\tt.Fatalf(\"EncodeRequest frame = %s, want %s\", frame, want)\n172|\t}\n173|}\n174|\n175|// TestEncodeRequestDispatchesEveryRegistryOperation proves dispatch\n176|// reaches every registry entry: each of the 15 operations frames with\n177|// its own name. The registry list itself is pinned against the\n178|// specification text by the inventory test.\n179|func TestEncodeRequestDispatchesEveryRegistryOperation(t *testing.T) {\n180|\tnow := mustInstant(t, testNow)\n181|\tfor _, name := range Operations() {\n182|\t\treq := testRequest(t)\n183|\t\treq.Operation = Operation(name)\n184|\t\tframe, err := EncodeRequest(req, now)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"EncodeRequest(%q): %v\", name, err)\n187|\t\t}\n188|\t\tvar decoded struct {\n189|\t\t\tOperation string `json:\"operation\"`\n190|\t\t}\n191|\t\tif err := json.Unmarshal(frame, &decoded); err != nil {\n192|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame is not JSON: %v\", name, err)\n193|\t\t}\n194|\t\tif decoded.Operation != name {\n195|\t\t\tt.Fatalf(\"EncodeRequest(%q) frame carries operation %q\", name, decoded.Operation)\n196|\t\t}\n197|\t}\n198|}\n199|\n200|// TestEncodeRequestRefusals proves framing fails closed before any\n201|// process starts: unknown operations, non-UUIDv7 request IDs, stale or\n202|// malformed deadlines, non-object bodies, and oversize frames are all\n203|// invalid_config from EncodeRequest. The production entry point is\n204|// EncodeRequest.\n205|func TestEncodeRequestRefusals(t *testing.T) {\n206|\tnow := mustInstant(t, testNow)\n207|\tfor _, kase := range []struct {\n208|\t\tname   string\n209|\t\tmutate func(*Request)\n210|\t\tdetail string\n211|\t}{\n212|\t\t{\"unknown operation\", func(req *Request) { req.Operation = \"reboot\" }, \"unknown operation\"},\n213|\t\t{\"empty operation\", func(req *Request) { req.Operation = \"\" }, \"unknown operation\"},\n214|\t\t{\"zero request id\", func(req *Request) { req.RequestID = scalar.UUIDv7{} }, \"request_id is not a UUIDv7\"},\n215|\t\t{\"zero deadline\", func(req *Request) { req.Deadline = scalar.Timestamp{} }, \"deadline is not a timestamp\"},\n216|\t\t{\"past deadline\", func(req *Request) { req.Deadline = mustTimestamp(t, testNow) }, \"deadline is not in the future\"},\n217|\t\t{\"deadline long past\", func(req *Request) { req.Deadline = mustTimestamp(t, \"2020-01-01T00:00:00.000Z\") }, \"deadline is not in the future\"},\n218|\t\t{\"array body\", func(req *Request) { req.Body = json.RawMessage(`[1,2]`) }, \"body is not a JSON object\"},\n219|\t\t{\"string body\", func(req *Request) { req.Body = json.RawMessage(`\"x\"`) }, \"body is not a JSON object\"},\n220|\t\t{\"scalar body\", func(req *Request) { req.Body = json.RawMessage(`3`) }, \"body is not a JSON object\"},\n221|\t\t{\"empty body\", func(req *Request) { req.Body = nil }, \"body is not a JSON object\"},\n222|\t\t{\"blank body\", func(req *Request) { req.Body = json.RawMessage(`  `) }, \"body is not a JSON object\"},\n223|\t\t{\"malformed body\", func(req *Request) { req.Body = json.RawMessage(`{oops`) }, \"body is not a JSON object\"},\n224|\t\t{\"oversize frame\", func(req *Request) {\n225|\t\t\treq.Body = json.RawMessage(`{\"pad\":\"` + strings.Repeat(\"a\", specFrameLimitBytes) + `\"}`)\n226|\t\t}, \"request frame exceeds 8 MiB\"},\n227|\t} {\n228|\t\tt.Run(kase.name, func(t *testing.T) {\n229|\t\t\treq := testRequest(t)\n230|\t\t\tkase.mutate(&req)\n231|\t\t\t_, err := EncodeRequest(req, now)\n232|\t\t\trequireLocalRefusal(t, err, \"invalid_config\", kase.detail)\n233|\t\t})\n234|\t}\n235|}\n236|\n237|// successFrame builds a minimal valid success envelope for want.\n238|func successFrame(t *testing.T, want, body string) []byte {\n239|\tt.Helper()\n240|\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + want + `\",\"ok\":true,\"body\":` + body + `}`)\n241|}\n242|\n243|// childFailureFrame builds a failure envelope carrying a genuine bound\n244|// child error, constructed through the production axerror entry point.\n245|func childFailureFrame(t *testing.T, want string) []byte {\n246|\tt.Helper()\n247|\tchild, err := axerror.New(axerror.Spec{\n248|\t\tVersion: axerror.Version100,\n249|\t\tCode:    \"capability_unavailable\",\n250|\t\tMessage: \"portable store is not available for this provider build\",\n251|\t\tDetails: axerror.Details{},\n252|\t})\n253|\tif err != nil {\n254|\t\tt.Fatalf(\"axerror.New: %v\", err)\n255|\t}\n256|\traw, err := json.Marshal(child)\n257|\tif err != nil {\n258|\t\tt.Fatalf(\"Marshal child: %v\", err)\n259|\t}\n(more lines below)"}}}
