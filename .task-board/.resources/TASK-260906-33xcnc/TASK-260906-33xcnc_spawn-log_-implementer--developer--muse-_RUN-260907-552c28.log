{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c579","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":279,"recorded_at":1780531400000553,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"968aa0ba-ae8c-43e2-9249-260c5f2ae723"},"task_id":"968aa0ba-ae8c-43e2-9249-260c5f2ae723","event":{"kind":"output","task_id":"968aa0ba-ae8c-43e2-9249-260c5f2ae723","chunk":"Read text file `internal/environ/tuple_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"reflect\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n15|)\n16|\n17|// This file is the Environment Tuple agreement battery. The\n18|// tuple is the one type every state-bearing adapter call\n19|// carries, and its admission model is shared with the Section\n20|// 10.8.1 observation rather than restated there. The battery\n21|// proves sessadapter.DecodeTuple and environ.DecodeTuple agree\n22|// verdict-for-verdict over a corpus that mutates each member\n23|// alone, and proves the two member tables are literally one\n24|// table: the required lists are derived from both productions\n25|// and required equal in order as well as content, because\n26|// missing-member determinism (which member is named when several\n27|// are absent) is itself shared behavior.\n28|\n29|// deriveRequiredList derives the string list behind a\n30|// package-level []string variable in one production file. The\n31|// comparison travels with the derivation: a reordered,\n32|// extended, or shortened table fails here, not silently.\n33|func deriveRequiredList(t *testing.T, pkg, file, symbol string) []string {\n34|\tt.Helper()\n35|\tpath := filepath.Join(mustInternalRoot(t), pkg, file)\n36|\tsource, err := os.ReadFile(path)\n37|\tif err != nil {\n38|\t\tt.Fatalf(\"members: %v\", err)\n39|\t}\n40|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n41|\tif err != nil {\n42|\t\tt.Fatalf(\"members: %v\", err)\n43|\t}\n44|\tfor _, decl := range syntax.Decls {\n45|\t\tnode, ok := decl.(*ast.GenDecl)\n46|\t\tif !ok {\n47|\t\t\tcontinue\n48|\t\t}\n49|\t\tfor _, spec := range node.Specs {\n50|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n51|\t\t\tif !ok || len(value.Names) != 1 || value.Names[0].Name != symbol {\n52|\t\t\t\tcontinue\n53|\t\t\t}\n54|\t\t\tif len(value.Values) != 1 {\n55|\t\t\t\tt.Fatalf(\"members: %s %s is not a single literal; the extractor cannot see through indirection\", path, symbol)\n56|\t\t\t}\n57|\t\t\tcomposite, ok := value.Values[0].(*ast.CompositeLit)\n58|\t\t\tif !ok {\n59|\t\t\t\tt.Fatalf(\"members: %s %s is not a composite literal; the extractor cannot see through indirection\", path, symbol)\n60|\t\t\t}\n61|\t\t\tvar members []string\n62|\t\t\tfor _, element := range composite.Elts {\n63|\t\t\t\tliteral, ok := element.(*ast.BasicLit)\n64|\t\t\t\tif !ok {\n65|\t\t\t\t\tt.Fatalf(\"members: %s %s holds a non-literal; the extractor cannot see through indirection\", path, symbol)\n66|\t\t\t\t}\n67|\t\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n68|\t\t\t}\n69|\t\t\treturn members\n70|\t\t}\n71|\t}\n72|\tt.Fatalf(\"members: %s %s not found; the extractor is blind, not the table absent\", path, symbol)\n73|\treturn nil\n74|}\n75|\n76|func mustInternalRoot(t *testing.T) string {\n77|\tt.Helper()\n78|\troot, err := internalRoot(t)\n79|\tif err != nil {\n80|\t\tt.Fatalf(\"members: %v\", err)\n81|\t}\n82|\treturn root\n83|}\n84|\n85|// internalRoot returns the internal/ source root above this\n86|// package directory. It lives here (rather than reusing the\n87|// in-package census helper) because this battery is an external\n88|// test package: the facades it drives import environ, so an\n89|// in-package battery importing them would be an import cycle.\n90|func internalRoot(t *testing.T) (string, error) {\n91|\tt.Helper()\n92|\tdirectory, err := os.Getwd()\n93|\tif err != nil {\n94|\t\treturn \"\", err\n95|\t}\n96|\treturn filepath.Dir(directory), nil\n97|}\n98|\n99|// TestTupleMemberTablesAreOneTable requires the environ and\n100|// sessadapter required-member tables to be literally equal:\n101|// same members, same order. A seventh member admitted on one\n102|// side, or a renamed member, reddens here before any vector\n103|// runs.\n104|func TestTupleMemberTablesAreOneTable(t *testing.T) {\n105|\tmine := deriveRequiredList(t, \"environ\", \"tuple.go\", \"tupleRequired\")\n106|\ttheirs := deriveRequiredList(t, \"sessadapter\", \"tuple.go\", \"tupleRequired\")\n107|\tif !reflect.DeepEqual(mine, theirs) {\n108|\t\tt.Fatalf(\"tuple required tables differ:\\nenviron:     %q\\nsessadapter: %q\", mine, theirs)\n109|\t}\n110|\tif len(mine) != 6 {\n111|\t\tt.Fatalf(\"tuple required table has %d members, want the exact six\", len(mine))\n112|\t}\n113|}\n114|\n115|// tupleRow is one agreement vector: the body and the rule phrase\n116|// both refusals must carry. An empty phrase means both entries\n117|// accept.\n118|type tupleRow struct {\n119|\tname string\n120|\tbody []byte\n121|\ttext string\n122|}\n123|\n124|// tupleCorpus mutates each tuple member alone against an\n125|// otherwise-valid body, plus the executable-provenance,\n126|// extensions, and vocabulary edges.\n127|func tupleCorpus(t *testing.T) []tupleRow {\n128|\tt.Helper()\n129|\tvalid := validTupleJSON()\n130|\tdrop := func(member string) []byte { return dropMember(t, []byte(valid), member) }\n131|\tset := func(member, literal string) []byte { return mutateMember(t, []byte(valid), member, literal) }\n132|\treturn []tupleRow{\n133|\t\t{\"valid\", []byte(valid), \"\"},\n134|\t\t{\"missing environment_id\", drop(\"environment_id\"), \"misses a required member\"},\n135|\t\t{\"missing environment_version\", drop(\"environment_version\"), \"misses a required member\"},\n136|\t\t{\"missing platform\", drop(\"platform\"), \"misses a required member\"},\n137|\t\t{\"missing architecture\", drop(\"architecture\"), \"misses a required member\"},\n138|\t\t{\"missing store_schema_fingerprint\", drop(\"store_schema_fingerprint\"), \"misses a required member\"},\n139|\t\t{\"missing adapter_version\", drop(\"adapter_version\"), \"misses a required member\"},\n140|\t\t{\"unknown member\", set(\"adapter_version\", `\"1.2.3\"`), \"\"}, // placeholder, replaced below\n141|\t\t{\"extensions refused\", appendMember(t, []byte(valid), \"extensions\", `{}`), \"unknown member\"},\n142|\t\t{\"executable provenance refused\", appendMember(t, []byte(valid), \"executable_sha256\", jsonQuote(fixtureExecutable)), \"unknown member\"},\n143|\t\t{\"bad environment id\", set(\"environment_id\", `\"Test.Env\"`), \"environment-id\"},\n144|\t\t{\"empty environment id\", set(\"environment_id\", `\"\"`), \"environment-id\"},\n145|\t\t{\"empty version\", set(\"environment_version\", `\"\"`), \"string[1..128]\"},\n146|\t\t{\"long version\", set(\"environment_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"string[1..128]\"},\n147|\t\t{\"darwin refused\", set(\"platform\", `\"darwin\"`), \"platform\"},\n148|\t\t{\"wsl2 admits\", set(\"platform\", `\"wsl2\"`), \"\"},\n149|\t\t{\"uppercase refused\", set(\"platform\", `\"LINUX\"`), \"platform\"},\n150|\t\t{\"x86 refused\", set(\"architecture\", `\"x86\"`), \"architecture\"},\n151|\t\t{\"arm64 admits\", set(\"architecture\", `\"arm64\"`), \"\"},\n152|\t\t{\"bad fingerprint\", set(\"store_schema_fingerprint\", `\"sha256:zzzz\"`), \"digest\"},\n153|\t\t{\"short version\", set(\"adapter_version\", `\"1.2\"`), \"SemVer\"},\n154|\t\t{\"prerelease admits\", set(\"adapter_version\", `\"1.2.3-rc.1\"`), \"\"},\n155|\t}\n156|}\n157|\n158|// TestTupleAgreementAcrossFacades drives the corpus through both\n159|// tuple entries and requires identical verdicts with the full\n160|// rule rendering on each side.\n161|func TestTupleAgreementAcrossFacades(t *testing.T) {\n162|\trows := tupleCorpus(t)\n163|\t// The unknown-member row needs a genuinely unknown member,\n164|\t// not a replaced known one.\n165|\tfor index, row := range rows {\n166|\t\tif row.name == \"unknown member\" {\n167|\t\t\trows[index].body = appendMember(t, []byte(validTupleJSON()), \"score\", `1`)\n168|\t\t\trows[index].text = \"unknown member\"\n169|\t\t}\n170|\t}\n171|\tfor _, row := range rows {\n172|\t\tt.Run(row.name, func(t *testing.T) {\n173|\t\t\tmine, mineErr := environ.DecodeTuple(row.body)\n174|\t\t\ttheirs, theirsErr := sessadapter.DecodeTuple(row.body)\n175|\t\t\tif row.text == \"\" {\n176|\t\t\t\tif mineErr != nil {\n177|\t\t\t\t\tt.Fatalf(\"environ refused %s: %v\", row.body, mineErr)\n178|\t\t\t\t}\n179|\t\t\t\tif theirsErr != nil {\n180|\t\t\t\t\tt.Fatalf(\"sessadapter refused %s: %v\", row.body, theirsErr)\n181|\t\t\t\t}\n182|\t\t\t\tif mine.EnvironmentID != theirs.EnvironmentID || mine.Version != theirs.Version ||\n183|\t\t\t\t\tmine.Platform != theirs.Platform || mine.Architecture != theirs.Architecture ||\n184|\t\t\t\t\tmine.StoreFingerprint != theirs.StoreFingerprint || mine.AdapterVersion != theirs.AdapterVersion {\n185|\t\t\t\t\tt.Fatalf(\"decoded tuples differ: %+v vs %+v\", mine, theirs)\n186|\t\t\t\t}\n187|\t\t\t\treturn\n188|\t\t\t}\n189|\t\t\tif mineErr == nil {\n190|\t\t\t\tt.Fatalf(\"environ admitted %s, want rule %q\", row.body, row.text)\n191|\t\t\t}\n192|\t\t\tif theirsErr == nil {\n193|\t\t\t\tt.Fatalf(\"sessadapter admitted %s, want rule %q\", row.body, row.text)\n194|\t\t\t}\n195|\t\t\tif !strings.Contains(mineErr.Error(), row.text) {\n196|\t\t\t\tt.Fatalf(\"environ error = %v, want rule %q\", mineErr, row.text)\n197|\t\t\t}\n198|\t\t\tif !strings.Contains(theirsErr.Error(), row.text) {\n199|\t\t\t\tt.Fatalf(\"sessadapter error = %v, want rule %q\", theirsErr, row.text)\n200|\t\t\t}\n201|\t\t})\n202|\t}\n203|}\n204|\n205|// appendMember returns the object with one added top-level\n206|// member. Every other member holds a valid value, so the added\n207|// member alone decides the verdict.\n208|func appendMember(t *testing.T, body []byte, member, literal string) []byte {\n209|\tt.Helper()\n210|\tmembers := decodeTestMembers(t, body)\n211|\tif _, present := members[member]; present {\n212|\t\tt.Fatalf(\"appendMember: %q already present\", member)\n213|\t}\n214|\tmembers[member] = literal\n215|\treturn encodeTestMembers(t, members)\n216|}"}}}
