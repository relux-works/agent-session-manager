{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c57d","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":281,"recorded_at":1780531400000557,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"6e5193a9-f98c-4870-b279-5ea84c4a65aa"},"task_id":"6e5193a9-f98c-4870-b279-5ea84c4a65aa","event":{"kind":"output","task_id":"6e5193a9-f98c-4870-b279-5ea84c4a65aa","chunk":"Read text file `internal/environ/shape_census_test.go`.\n(1093 line(s) above)\n1094|// assertNoRevivedGrammarCopies requires the converged grammar\n1095|// variables to stay deleted from the package decode.go file.\n1096|func assertNoRevivedGrammarCopies(t *testing.T, pkg string, syntax *ast.File) {\n1097|\tt.Helper()\n1098|\tfor _, decl := range syntax.Decls {\n1099|\t\tnode, ok := decl.(*ast.GenDecl)\n1100|\t\tif !ok {\n1101|\t\t\tcontinue\n1102|\t\t}\n1103|\t\tfor _, spec := range node.Specs {\n1104|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n1105|\t\t\tif !ok {\n1106|\t\t\t\tcontinue\n1107|\t\t\t}\n1108|\t\t\tfor _, name := range value.Names {\n1109|\t\t\t\tfor _, removed := range removedGrammarCopies {\n1110|\t\t\t\t\tif name.Name == removed {\n1111|\t\t\t\t\t\tt.Fatalf(\"check-delegation: removed grammar copy %q is back in %s/decode.go\", removed, pkg)\n1112|\t\t\t\t\t}\n1113|\t\t\t\t}\n1114|\t\t\t}\n1115|\t\t}\n1116|\t}\n1117|}\n1118|\n1119|// pinsDelegation requires the wrapper to reference environ and\n1120|// to hold no decoder, gate, or measure of its own.\n1121|func pinsDelegation(t *testing.T, pkg string, wrapper *ast.FuncDecl) {\n1122|\tt.Helper()\n1123|\treferencesEnviron := false\n1124|\tast.Inspect(wrapper.Body, func(node ast.Node) bool {\n1125|\t\tselector, ok := node.(*ast.SelectorExpr)\n1126|\t\tif !ok {\n1127|\t\t\treturn true\n1128|\t\t}\n1129|\t\tidentifier, ok := selector.X.(*ast.Ident)\n1130|\t\tif !ok {\n1131|\t\t\treturn true\n1132|\t\t}\n1133|\t\tif identifier.Name != \"environ\" {\n1134|\t\t\treturn true\n1135|\t\t}\n1136|\t\treferencesEnviron = true\n1137|\t\treturn false\n1138|\t})\n1139|\tif !referencesEnviron {\n1140|\t\tt.Fatalf(\"delegation: %s decodeStrictObject no longer references environ\", pkg)\n1141|\t}\n1142|\tif bodyBuildsJSONDecoder(wrapper.Body) {\n1143|\t\tt.Fatalf(\"delegation: %s decodeStrictObject builds its own decoder\", pkg)\n1144|\t}\n1145|\tif bodyCountsRunes(wrapper.Body) {\n1146|\t\tt.Fatalf(\"delegation: %s decodeStrictObject counts runes itself\", pkg)\n1147|\t}\n1148|\tsurrogateState := &packageShapes{funcDups: map[string]bool{}, funcShapes: map[string][]string{}, constBound: map[string]bool{}}\n1149|\tif bodyCarriesSurrogateSignal(wrapper.Body, surrogateState) {\n1150|\t\tt.Fatalf(\"delegation: %s decodeStrictObject carries its own surrogate gate\", pkg)\n1151|\t}\n1152|}\n1153|\n1154|// assertNoSurrogateLiterals requires the whole file to carry no\n1155|// surrogate range literal: the gate lives in environ now.\n1156|func assertNoSurrogateLiterals(t *testing.T, pkg string, syntax *ast.File) {\n1157|\tt.Helper()\n1158|\tast.Inspect(syntax, func(node ast.Node) bool {\n1159|\t\tliteral, ok := node.(*ast.BasicLit)\n1160|\t\tif !ok || literal.Kind != token.INT {\n1161|\t\t\treturn true\n1162|\t\t}\n1163|\t\tif magnitude, err := strconv.ParseUint(literal.Value, 0, 32); err == nil && surrogateBounds[magnitude] {\n1164|\t\t\tt.Fatalf(\"delegation: %s/decode.go carries surrogate literal %s; the gate lives in environ\", pkg, literal.Value)\n1165|\t\t\treturn false\n1166|\t\t}\n1167|\t\treturn true\n1168|\t})\n1169|}"}}}
