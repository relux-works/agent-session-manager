{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4df","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":202,"recorded_at":1780531400000399,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"984181c9-353f-44de-b3c0-d842e1cf3f8d"},"task_id":"984181c9-353f-44de-b3c0-d842e1cf3f8d","event":{"kind":"output","task_id":"984181c9-353f-44de-b3c0-d842e1cf3f8d","chunk":"Read text file `internal/environ/decode.go`.\n1|package environ\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"io\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// maxUint53 is the largest exactly representable JSON integer:\n17|// counts and limits are uint53 throughout the pinned\n18|// specification.\n19|const maxUint53 = uint64(1<<53 - 1)\n20|\n21|// Fault is one strict-decode failure: what was wrong and which\n22|// member it was found in, if any. It never carries foreign bytes.\n23|// The five details are the complete fault space: every body this\n24|// package refuses at the frame layer carries exactly one of them,\n25|// and the frame-agreement battery derives its denominator from\n26|// this list, so a sixth fault shape fails the census instead of\n27|// passing silently.\n28|type Fault struct {\n29|\tDetail string\n30|\tMember string\n31|}\n32|\n33|func (fault *Fault) Error() string {\n34|\tif fault.Member == \"\" {\n35|\t\treturn \"environment frame \" + fault.Detail\n36|\t}\n37|\treturn \"environment frame \" + fault.Detail + \" in member \" + fault.Member\n38|}\n39|\n40|// Frame fault details. Each is a constant so the agreement battery\n41|// derives the fault space from production source instead of\n42|// retyping it: a reworded fault fails its row rather than passing\n43|// against a stale copy.\n44|const (\n45|\tFaultNotUTF8       = \"not valid UTF-8\"\n46|\tFaultLoneSurrogate = \"lone surrogate escape\"\n47|\tFaultNotObject     = \"not a JSON object\"\n48|\tFaultDuplicate     = \"duplicate member\"\n49|\tFaultTrailing      = \"trailing data after the object\"\n50|)\n51|\n52|// DecodeStrictObject parses one complete JSON object with\n53|// duplicate member rejection. It is the only JSON entry point in\n54|// this package: every body crosses it before any member is read.\n55|// A non-UTF-8 frame, a lone surrogate escape, a non-object top\n56|// level, a duplicated member, or trailing data is a fault, never\n57|// a partial object the caller could mistake for a result.\n58|func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\n59|\tif !utf8.Valid(data) {\n60|\t\treturn nil, &Fault{Detail: FaultNotUTF8}\n61|\t}\n62|\tif HasLoneSurrogateEscape(data) {\n63|\t\treturn nil, &Fault{Detail: FaultLoneSurrogate}\n64|\t}\n65|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n66|\ttoken, err := decoder.Token()\n67|\tif err != nil {\n68|\t\treturn nil, &Fault{Detail: FaultNotObject}\n69|\t}\n70|\tdelim, ok := token.(json.Delim)\n71|\tif !ok || delim != '{' {\n72|\t\treturn nil, &Fault{Detail: FaultNotObject}\n73|\t}\n74|\tmembers := map[string]json.RawMessage{}\n75|\tfor decoder.More() {\n76|\t\tkeyToken, err := decoder.Token()\n77|\t\tif err != nil {\n78|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n79|\t\t}\n80|\t\tkey, ok := keyToken.(string)\n81|\t\tif !ok {\n82|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n83|\t\t}\n84|\t\tif _, duplicate := members[key]; duplicate {\n85|\t\t\treturn nil, &Fault{Detail: FaultDuplicate, Member: key}\n86|\t\t}\n87|\t\tvar raw json.RawMessage\n88|\t\tif err := decoder.Decode(&raw); err != nil {\n89|\t\t\treturn nil, &Fault{Detail: FaultNotObject, Member: key}\n90|\t\t}\n91|\t\tmembers[key] = raw\n92|\t}\n93|\tif token, err := decoder.Token(); err != nil {\n94|\t\treturn nil, &Fault{Detail: FaultNotObject}\n95|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n96|\t\treturn nil, &Fault{Detail: FaultNotObject}\n97|\t}\n98|\tif _, err := decoder.Token(); err != io.EOF {\n99|\t\treturn nil, &Fault{Detail: FaultTrailing}\n100|\t}\n101|\treturn members, nil\n102|}\n103|\n104|// HasLoneSurrogateEscape reports whether the raw frame carries a\n105|// UTF-16 escape the JSON string grammar cannot pair. Go's\n106|// encoding/json would otherwise replace the lone escape with\n107|// U+FFFD silently, so wire bodies carrying lone surrogates would\n108|// be admitted with rewritten bytes.\n109|//\n110|// The walk is string-aware: only escapes inside JSON strings\n111|// count, and a backslash escape consumes both bytes, so the text\n112|// \"\\\\ud800\" (backslash-plus-text, JSON source `\"\\\\ud800\"`) is\n113|// not an escape and is admitted at the frame gate. A scanner\n114|// that matches every `\\u` byte pair regardless of string context\n115|// refuses that text, and worse, misreads it as a high surrogate\n116|// paired with a following real escape — admitting a real lone\n117|// escape the string walk refuses. The sessadapter and dirnode\n118|// facades once carried that raw scan and diverged in both\n119|// directions; they now delegate their frame verdict to\n120|// DecodeStrictObject, and the frame-agreement battery proves\n121|// both directions with run-parity rows plus even-run-plus-real-\n122|// escape compositions, so any change to this walk fails there in\n123|// either direction.\n124|func HasLoneSurrogateEscape(data []byte) bool {\n125|\tfor index := 0; index < len(data); index++ {\n126|\t\tif data[index] != '\"' {\n127|\t\t\tcontinue\n128|\t\t}\n129|\t\tfor index++; index < len(data); index++ {\n130|\t\t\tswitch data[index] {\n131|\t\t\tcase '\"':\n132|\t\t\t\tgoto stringComplete\n133|\t\t\tcase '\\\\':\n134|\t\t\t\tindex++\n135|\t\t\t\tif index >= len(data) || data[index] != 'u' {\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tunit, end, ok := readUTF16Escape(data, index-1)\n139|\t\t\t\tif !ok {\n140|\t\t\t\t\t// Not a well-formed \\uXXXX escape: the\n141|\t\t\t\t\t// JSON-syntax arms own it, not this gate.\n142|\t\t\t\t\tcontinue\n143|\t\t\t\t}\n144|\t\t\t\tindex = end - 1\n145|\t\t\t\tswitch {\n146|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n147|\t\t\t\t\tsecond, _, ok := readUTF16Escape(data, end)\n148|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n149|\t\t\t\t\t\treturn true\n150|\t\t\t\t\t}\n151|\t\t\t\t\tindex = end + 6 - 1\n152|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n153|\t\t\t\t\treturn true\n154|\t\t\t\t}\n155|\t\t\t}\n156|\t\t}\n157|\t\t// An unterminated string owns no surrogate verdict: the\n158|\t\t// frame is not JSON at all, so the syntax arms refuse it\n159|\t\t// as not-a-JSON-object rather than misattributing it\n160|\t\t// here.\n161|\t\treturn false\n162|\tstringComplete:\n163|\t}\n164|\treturn false\n165|}\n166|\n167|// readUTF16Escape reads one \\uXXXX escape starting at the offset.\n168|// It reports the unit value and the offset just past the escape,\n169|// or false when the escape is truncated or not hexadecimal.\n170|func readUTF16Escape(data []byte, offset int) (uint16, int, bool) {\n171|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n172|\t\treturn 0, offset, false\n173|\t}\n174|\tvalue, err := strconv.ParseUint(string(data[offset+2:offset+6]), 16, 16)\n175|\tif err != nil {\n176|\t\treturn 0, offset, false\n177|\t}\n178|\treturn uint16(value), offset + 6, true\n179|}\n180|\n181|// unknownMember names a member outside the closed set, if any.\n182|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n183|\tfor name := range members {\n184|\t\tif !allowed[name] {\n185|\t\t\treturn name, true\n186|\t\t}\n187|\t}\n188|\treturn \"\", false\n189|}\n190|\n191|// missingMember names the first required member with no value, if\n192|// any. The required list is fixed order, so the verdict is\n193|// deterministic for every missing combination.\n194|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n195|\tfor _, name := range required {\n196|\t\tif _, present := members[name]; !present {\n197|\t\t\treturn name, true\n198|\t\t}\n199|\t}\n200|\treturn \"\", false\n201|}\n202|\n203|// rawString reads a JSON string member.\n204|func rawString(raw json.RawMessage) (string, bool) {\n205|\tvar value string\n206|\tif err := json.Unmarshal(raw, &value); err != nil {\n207|\t\treturn \"\", false\n208|\t}\n209|\treturn value, true\n210|}\n211|\n212|// rawUint53 reads an unsigned integral JSON number in [0,\n213|// 2^53-1]. A fraction, exponent, sign, or out-of-range magnitude\n214|// is not a uint53, even when it names the same mathematical\n215|// value: the bodies carry counts, never measurements.\n216|func rawUint53(raw json.RawMessage) (uint64, bool) {\n217|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n218|\tdecoder.UseNumber()\n219|\tvar value any\n220|\tif err := decoder.Decode(&value); err != nil {\n221|\t\treturn 0, false\n222|\t}\n223|\t// Decode reads one value and stops: without the trailing\n224|\t// check a hostile slice like `12a` would read as 12. Member\n225|\t// slices arriving through DecodeStrictObject can never carry\n226|\t// trailing data, but this entry takes raw slices and must\n227|\t// not trust them.\n228|\tif _, err := decoder.Token(); err != io.EOF {\n229|\t\treturn 0, false\n230|\t}\n231|\tnumber, ok := value.(json.Number)\n232|\tif !ok {\n233|\t\treturn 0, false\n234|\t}\n235|\tliteral := number.String()\n236|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n237|\t\treturn 0, false\n238|\t}\n239|\treturn parseUint53Literal(literal)\n240|}\n241|\n242|// parseUint53Literal reads a digit-only literal without trusting\n243|// a float conversion: the magnitude bound is checked on the digit\n244|// string, so 2^53 is refused even on platforms that could hold\n245|// it.\n246|func parseUint53Literal(literal string) (uint64, bool) {\n247|\tif literal == \"\" {\n248|\t\treturn 0, false\n249|\t}\n250|\tvar value uint64\n251|\tfor index := 0; index < len(literal); index++ {\n252|\t\tdigit := literal[index]\n253|\t\tif digit < '0' || digit > '9' {\n254|\t\t\treturn 0, false\n255|\t\t}\n256|\t\tvalue = value*10 + uint64(digit-'0')\n257|\t\tif value > maxUint53 {\n258|\t\t\treturn 0, false\n259|\t\t}\n260|\t}\n261|\treturn value, true\n262|}\n263|\n264|// StringLength is the Section 1.6 string measure in characters,\n265|// not bytes: a bound of string[1..128] admits 128 characters of\n266|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n267|// env literals, Section 5.1) do not go through here; the measure\n268|// battery ledgers that split.\n269|func StringLength(value string) int {\n270|\treturn utf8.RuneCountInString(value)\n271|}\n272|\n273|// CheckStringBounds reports whether the member is a JSON string\n274|// whose character count falls in the inclusive bound.\n275|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n276|\tvalue, ok := rawString(raw)\n277|\tif !ok {\n278|\t\treturn \"\", false\n279|\t}\n280|\tlength := StringLength(value)\n281|\tif length < minimum || length > maximum {\n282|\t\treturn \"\", false\n283|\t}\n284|\treturn value, true\n285|}\n286|\n287|// CheckUint53Bounds reports whether the member is a uint53 in the\n288|// inclusive bound. Both edges are checked: a one-sided check\n289|// would admit the open side.\n290|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n291|\tvalue, ok := rawUint53(raw)\n292|\tif !ok {\n293|\t\treturn 0, false\n294|\t}\n295|\tif value < minimum || value > maximum {\n296|\t\treturn 0, false\n297|\t}\n298|\treturn value, true\n299|}\n300|\n301|// CheckDigest reports whether the member is a digest of the\n302|// pinned sha256 form.\n303|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Digest{}, false\n307|\t}\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Digest{}, false\n311|\t}\n312|\treturn digest, true\n313|}\n314|\n315|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n316|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n317|\tvalue, ok := rawString(raw)\n318|\tif !ok {\n319|\t\treturn scalar.UUIDv7{}, false\n320|\t}\n321|\tidentifier, err := scalar.ParseUUIDv7(value)\n322|\tif err != nil {\n323|\t\treturn scalar.UUIDv7{}, false\n324|\t}\n325|\treturn identifier, true\n326|}\n327|\n328|// CheckTimestamp reports whether the member is a pinned\n329|// timestamp.\n330|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n331|\tvalue, ok := rawString(raw)\n332|\tif !ok {\n333|\t\treturn scalar.Timestamp{}, false\n334|\t}\n335|\tinstant, err := scalar.ParseTimestamp(value)\n336|\tif err != nil {\n337|\t\treturn scalar.Timestamp{}, false\n338|\t}\n339|\treturn instant, true\n340|}\n341|\n342|// isNull reports whether the member is an explicit JSON null.\n343|func isNull(raw json.RawMessage) bool {\n344|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n345|}\n346|\n347|func bytesTrimSpace(raw json.RawMessage) []byte {\n348|\treturn bytes.TrimSpace(raw)\n349|}\n350|\n351|// reverseDNSPattern is the extensions-key grammar: at least two\n352|// dot-separated labels, each starting with a lowercase letter.\n353|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n354|\n355|// CheckExtensions reports whether the member is an object whose\n356|// every key is reverse-DNS. Extensions never add operations,\n357|// capabilities, or trust facts; the key grammar is the part of\n358|// that rule decidable from one body.\n359|func CheckExtensions(raw json.RawMessage) bool {\n360|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n361|\tif fault != nil {\n362|\t\treturn false\n363|\t}\n364|\tfor name := range members {\n365|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n366|\t\t\treturn false\n367|\t\t}\n368|\t}\n369|\treturn true\n370|}\n371|\n372|// decodeArray reads a JSON array member into its raw elements. A\n373|// non-array — including null — is not an empty array.\n374|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n375|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n376|\ttoken, err := decoder.Token()\n377|\tif err != nil {\n378|\t\treturn nil, false\n379|\t}\n380|\tdelim, ok := token.(json.Delim)\n381|\tif !ok || delim != '[' {\n382|\t\treturn nil, false\n383|\t}\n384|\tvar elements []json.RawMessage\n385|\tfor decoder.More() {\n386|\t\tvar element json.RawMessage\n387|\t\tif err := decoder.Decode(&element); err != nil {\n388|\t\t\treturn nil, false\n389|\t\t}\n390|\t\telements = append(elements, element)\n391|\t}\n392|\tif token, err := decoder.Token(); err != nil {\n393|\t\treturn nil, false\n394|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n395|\t\treturn nil, false\n396|\t}\n397|\tif _, err := decoder.Token(); err != io.EOF {\n398|\t\treturn nil, false\n399|\t}\n400|\treturn elements, true\n401|}\n402|\n403|// CheckSortedUniqueStrings reports whether the member is an array\n404|// of strings in the item bound whose JCS encodings order strictly\n405|// increasingly with no duplicates. Bytewise JCS order over\n406|// strings is plain lexicographic order, so the check compares\n407|// directly; the count bound is checked on both edges.\n408|//\n409|// Ordering and uniqueness are two obligations, not one: an\n410|// unsorted-but-unique vector and a sorted-but-duplicated vector\n411|// are separate rows in this package's sorted-strings battery\n412|// (TestCheckSortedUniqueStringsHalves drives this function\n413|// directly), so a check that enforced only one half could not\n414|// pass both. The observation battery covers the digest twin,\n415|// not this function.\n416|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n417|\telements, ok := decodeArray(raw)\n418|\tif !ok {\n419|\t\treturn nil, false\n420|\t}\n421|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n422|\t\treturn nil, false\n423|\t}\n424|\tvalues := make([]string, 0, len(elements))\n425|\tfor _, element := range elements {\n426|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n427|\t\tif !ok {\n428|\t\t\treturn nil, false\n429|\t\t}\n430|\t\tvalues = append(values, value)\n431|\t}\n432|\tfor index := 1; index < len(values); index++ {\n433|\t\tif values[index-1] >= values[index] {\n434|\t\t\treturn nil, false\n435|\t\t}\n436|\t}\n437|\treturn values, true\n438|}\n439|\n440|// CheckSortedUniqueDigests reports whether the member is an array\n441|// of digests in the count bound, ordered strictly increasingly\n442|// with no duplicates.\n443|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n444|\telements, ok := decodeArray(raw)\n445|\tif !ok {\n446|\t\treturn nil, false\n447|\t}\n448|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n449|\t\treturn nil, false\n450|\t}\n451|\tvalues := make([]scalar.Digest, 0, len(elements))\n452|\tfor _, element := range elements {\n453|\t\tdigest, ok := CheckDigest(element)\n454|\t\tif !ok {\n455|\t\t\treturn nil, false\n456|\t\t}\n457|\t\tvalues = append(values, digest)\n458|\t}\n459|\tfor index := 1; index < len(values); index++ {\n460|\t\tif values[index-1].String() >= values[index].String() {\n461|\t\t\treturn nil, false\n462|\t\t}\n463|\t}\n464|\treturn values, true\n465|}\n466|\n467|// refuse builds the package error for one refused member: the\n468|// rule in human text automation must never branch on, naming the\n469|// member. Tests assert the full text, so a reworded rule fails\n470|// its row instead of passing against a stale copy.\n471|//\n472|// refuse is a variable, not a function, so the refusal-site audit\n473|// (refusal_site_audit_test.go) can swap it in TestMain and record\n474|// the production file:line behind every exercised refusal. Every\n475|// call site invokes it directly; an aliased call records its real\n476|// use site and fails the reverse direction of the audit.\n477|var refuse = func(rule, member string) error {\n478|\tif member == \"\" {\n479|\t\treturn fmt.Errorf(\"environment %s\", rule)\n480|\t}\n481|\treturn fmt.Errorf(\"environment %s: %s\", rule, member)\n482|}"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"984181c9-353f-44de-b3c0-d842e1cf3f8d"},"task_id":"984181c9-353f-44de-b3c0-d842e1cf3f8d","event":{"kind":"completed","task_id":"984181c9-353f-44de-b3c0-d842e1cf3f8d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"5d19084d-010e-4197-933a-8e33923c1eb8"},"task_id":"5d19084d-010e-4197-933a-8e33923c1eb8","event":{"kind":"output","task_id":"5d19084d-010e-4197-933a-8e33923c1eb8","chunk":"Read text file `internal/environ/shape_census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n15|)\n16|\n17|// This file is the shape layer of the shared-implementation\n18|// census. The name layer in census_test.go derives function and\n19|// method declarations by identifier and requires the derived set\n20|// to equal the ledger: it catches renames, removals, and copies\n21|// that reuse a ledgered name, but it cannot see a copy under a\n22|// fresh spelling, a new byte-counting measure, or a var-bound\n23|// alias. This layer derives implementation SHAPE from production\n24|// source and requires every shape hit to be a registered row:\n25|// a fresh spelling with the same implementation texture fails\n26|// here as an unregistered site.\n27|//\n28|// Shape space (each proven by a synthetic control in\n29|// TestShapeCensusCatchesControls, which drives the same pure\n30|// extractor the production test runs on the real tree):\n31|//\n32|//   - strict-decoder: a function that builds an encoding/json\n33|//     decoder (NewDecoder or Unmarshal) and carries a duplicate\n34|//     signal (a \"duplicate\"+\"member\" literal or a *uplicate\n35|//     identifier) in its own body or in a same-package callee.\n36|//     The callee arm covers decoders split across two local\n37|//     functions; a decoder split across packages is reuse, not\n38|//     a copy, and is not derived.\n39|//   - surrogate-gate: a function whose body holds a surrogate\n40|//     range literal (0xD800, 0xDBFF, 0xDC00, 0xDFFF in any base)\n41|//     or an identifier naming one (a *urrogate* token), or that\n42|//     references a package-level constant whose value is a\n43|//     surrogate range literal. Callers of a ledgered gate (the\n44|//     environ decoder, scalar's string decoder) trip the token\n45|//     arm and are registered as callers, not gates.\n46|//   - string-measure: a function that counts runes directly\n47|//     (a RuneCountInString/RuneCount selector).\n48|//   - byte-measure: a function with a string parameter it\n49|//     applies len() to and exactly one int result (the\n50|//     func(string)->int texture), or a function that applies\n51|//     len() to a variable assigned from a rawString() call (the\n52|//     verdict-style texture). Verdict-style measures that reuse\n53|//     a registered measure helper (stringLength and friends)\n54|//     are reuse, not copies, and are not derived.\n55|//   - var-alias: a package-level var that rebinds a ledgered\n56|//     shared-rule name, that binds a closure carrying any shape\n57|//     above, or that aliases a shape-positive local function.\n58|//     Binding an imported canonical helper under a fresh name\n59|//     (`var f = environ.StringLength`) is reuse and is clean.\n60|//\n61|// Stated residue. A decoder that never touches encoding/json (a\n62|// hand-rolled scanner with its own duplicate rule), a gate whose\n63|// bounds are derived arithmetically under fresh names with no\n64|// surrogate token anywhere, a byte measure over a non-string\n65|// parameter type, and a new grammar literal outside the four\n66|// known classes are not derived here. Each is named so the next\n67|// copy in one of those textures fails loudly by extending the\n68|// extractor, not silently.\n69|\n70|// shapeSite is one shape-derived shared-rule implementation.\n71|type shapeSite struct {\n72|\tclass  string\n73|\tpkg    string\n74|\tfile   string\n75|\tsymbol string\n76|}\n77|\n78|func (site shapeSite) key() string {\n79|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n80|}\n81|\n82|// surrogateBounds is the UTF-16 surrogate range: any integer\n83|// literal with one of these values is a gate bound.\n84|var surrogateBounds = map[uint64]bool{\n85|\t0xD800: true,\n86|\t0xDBFF: true,\n87|\t0xDC00: true,\n88|\t0xDFFF: true,\n89|}\n90|\n91|// shapeLedger registers every shape hit in the census scope with\n92|// the rationale that keeps it honest. Canonical owners are the\n93|// single implementation new code must use; every other row names\n94|// the behavioral battery that pins it to the canonical\n95|// semantics. An unregistered hit fails the census; an orphaned\n96|// row fails it too.\n97|var shapeLedger = map[string]string{\n98|\t// Strict decoders: one JSON entry point per owner plus the\n99|\t// two envelope decoders that reach one.\n100|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":    \"canonical owner: string-walk surrogate semantics, rune measure\",\n101|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\": \"string-aware walk, pinned by frame_agreement_test.go\",\n102|\t\"strict-decoder|provhost|protocol.go|DecodeResponse\":     \"response-envelope decoder over decodeStrictObject, pinned by provhost protocol tests\",\n103|\t\"strict-decoder|provhost|status.go|DecodeStatusOutcome\":  \"status-envelope decoder over decodeStrictObject, pinned by provhost status tests\",\n104|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\": \"canonicalizer entry over decodeValue, pinned by frame_agreement_test.go\",\n105|\t// Surrogate gates and their registered callers.\n106|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n107|\t\"surrogate-gate|environ|decode.go|DecodeStrictObject\":                \"caller: owns the gate call, pinned by frame_agreement_test.go\",\n108|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n109|\t\"surrogate-gate|provhost|protocol.go|decodeStrictObject\":             \"caller: owns the gate call, pinned by frame_agreement_test.go\",\n110|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n111|\t\"surrogate-gate|canonicaljson|canonical.go|decodeStrict\":             \"caller: owns the gate call, pinned by frame_agreement_test.go\",\n112|\t\"surrogate-gate|scalar|scalar.go|hasLoneJSONSurrogate\":               \"third spelling (single-string unit, scalar-owned): retained, pinned both directions by scalar_agreement_test.go\",\n113|\t\"surrogate-gate|scalar|scalar.go|decodeJSONString\":                   \"caller: owns the scalar gate call, pinned by scalar_agreement_test.go through DecodeClosedEnumJSON\",\n114|\t// Rune measures: one per package plus the canonicalizer's\n115|\t// internal bounded-string helpers, which the name census\n116|\t// never saw under their fresh spellings. The sessadapter and\n117|\t// dirnode measures converged onto environ.StringLength: their\n118|\t// delegating wrappers carry no rune count of their own, so\n119|\t// they derive no shape row here (the name layer still ledgers\n120|\t// the wrapper names, and TestCheckHelpersDelegateToEnviron\n121|\t// pins the delegation structurally). A revived local count\n122|\t// fails here as unregistered.\n123|\t\"string-measure|environ|decode.go|StringLength\":                               \"canonical owner: runes per Section 1.6\",\n124|\t\"string-measure|provhost|opdecode.go|runeLength\":                              \"runes, pinned by measure_agreement_test.go\",\n125|\t\"string-measure|canonicaljson|closed_shapes.go|requireBoundedString\":          \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n126|\t\"string-measure|canonicaljson|closed_shapes.go|validateBlobDescriptor\":        \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n127|\t\"string-measure|canonicaljson|closed_shapes.go|validateManifestEntries\":       \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n128|\t\"string-measure|canonicaljson|core_records.go|nullableBoundedString\":          \"canonicalizer-internal rune bound, pinned by the canonicaljson suite\",\n129|\t\"string-measure|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"canonicalizer-internal rune bound, pinned by identity_agreement_test.go opaque rows\",\n130|\t\"string-measure|scalar|path.go|ParseAbsolutePath\":                             \"grammar-owner path bound, pinned by the scalar suite\",\n131|\t// Byte measures: the two Section 5.1 exec gates.\n132|\t\"byte-measure|provhost|spawn.go|checkSpawnArgv\":        \"bytes by specification, pinned by TestByteBoundsStayBytes\",\n133|\t\"byte-measure|provhost|spawn.go|checkSpawnEnvLiterals\": \"bytes by specification, pinned by TestByteBoundsStayBytes\",\n134|}\n135|\n136|// packageShapes is the per-package extractor state: which local\n137|// functions carry a duplicate signal or a shape, and which\n138|// package-level constants hold surrogate bounds.\n139|type packageShapes struct {\n140|\tfuncDups   map[string]bool\n141|\tfuncShapes map[string][]string\n142|\tconstBound map[string]bool\n143|}\n144|\n145|// TestSharedShapesAreLedgered requires every shape-derived site\n146|// to be a registered row, and every row to be derived: an\n147|// unregistered copy fails as a unification violation, and a row\n148|// naming an implementation production no longer derives fails\n149|// as orphaned. Both directions run through the invcore harness.\n150|func TestSharedShapesAreLedgered(t *testing.T) {\n151|\tderived := deriveShapeSites(t)\n152|\trows := make(map[string]struct{}, len(shapeLedger))\n153|\tfor key := range shapeLedger {\n154|\t\trows[key] = struct{}{}\n155|\t}\n156|\tderivedSet := make(map[string]struct{}, len(derived))\n157|\tfor key := range derived {\n158|\t\tderivedSet[key] = struct{}{}\n159|\t}\n160|\tinvcore.MustCheckBothDirections(t, \"shared-rule shape\", derivedSet, rows)\n161|}\n162|\n163|// deriveShapeSites walks the census scope and derives every\n164|// shape site from production source.\n165|func deriveShapeSites(t *testing.T) map[string]bool {\n166|\tt.Helper()\n167|\troot, err := internalRoot(t)\n168|\tif err != nil {\n169|\t\tt.Fatalf(\"shapes: %v\", err)\n170|\t}\n171|\tsources := readScopeSources(t, root)\n172|\tsites := map[string]bool{}\n173|\tfor pkg, files := range sources {\n174|\t\tfor _, site := range shapeSitesInPackage(pkg, files) {\n175|\t\t\tsites[site.key()] = true\n176|\t\t}\n177|\t}\n178|\tif len(sites) == 0 {\n179|\t\tt.Fatal(\"shapes derived zero sites; the scanner is blind, not the tree clean\")\n180|\t}\n181|\treturn sites\n182|}\n183|\n184|// readScopeSources reads every production Go file in the census\n185|// packages into memory, keyed by package then file name.\n186|// Production file selection and fail-closed parsing come from\n187|// invcore: an unreadable or unparseable production file fails the\n188|// suite instead of scanning as clean.\n189|func readScopeSources(t *testing.T, root string) map[string]map[string][]byte {\n190|\tt.Helper()\n191|\tsources := map[string]map[string][]byte{}\n192|\tpackages := make([]string, 0, len(censusPackages))\n193|\tfor pkg := range censusPackages {\n194|\t\tpackages = append(packages, pkg)\n195|\t}\n196|\tsort.Strings(packages)\n197|\tfor _, pkg := range packages {\n198|\t\tfiles, _ := invcore.MustScanProduction(t, filepath.Join(root, pkg))\n199|\t\tif sources[pkg] == nil {\n200|\t\t\tsources[pkg] = map[string][]byte{}\n201|\t\t}\n202|\t\tfor _, production := range files {\n203|\t\t\tsources[pkg][production.Name] = production.Source\n204|\t\t}\n205|\t}\n206|\treturn sources\n207|}\n208|\n209|// shapeSitesInPackage derives the shape sites of one package. It\n210|// is pure over its inputs, so the synthetic controls drive this\n211|// exact function on planted sources: a control that fails here\n212|// fails the production census by construction.\n213|func shapeSitesInPackage(pkg string, files map[string][]byte) []shapeSite {\n214|\tparsed := map[string]*ast.File{}\n215|\tfor file, source := range files {\n216|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), file, source, 0)\n217|\t\tif err != nil {\n218|\t\t\treturn []shapeSite{{class: \"parse-failure\", pkg: pkg, file: file, symbol: \"unparseable\"}}\n219|\t\t}\n220|\t\tparsed[file] = syntax\n221|\t}\n222|\tstate := &packageShapes{funcDups: map[string]bool{}, funcShapes: map[string][]string{}, constBound: map[string]bool{}}\n223|\tfor _, syntax := range parsed {\n224|\t\tfor _, decl := range syntax.Decls {\n225|\t\t\tswitch node := decl.(type) {\n226|\t\t\tcase *ast.FuncDecl:\n227|\t\t\t\tif node.Body == nil {\n228|\t\t\t\t\tcontinue\n229|\t\t\t\t}\n230|\t\t\t\tif bodyHasDupSignal(node.Body) {\n231|\t\t\t\t\tstate.funcDups[node.Name.Name] = true\n232|\t\t\t\t}\n233|\t\t\tcase *ast.GenDecl:\n234|\t\t\t\tfor _, spec := range node.Specs {\n235|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n236|\t\t\t\t\tif !ok {\n237|\t\t\t\t\t\tcontinue\n238|\t\t\t\t\t}\n239|\t\t\t\t\tfor index, name := range value.Names {\n240|\t\t\t\t\t\tif index >= len(value.Values) {\n241|\t\t\t\t\t\t\tcontinue\n242|\t\t\t\t\t\t}\n243|\t\t\t\t\t\tif literal, ok := value.Values[index].(*ast.BasicLit); ok && literal.Kind == token.INT {\n244|\t\t\t\t\t\t\tif magnitude, err := strconv.ParseUint(literal.Value, 0, 32); err == nil && surrogateBounds[magnitude] {\n245|\t\t\t\t\t\t\t\tstate.constBound[name.Name] = true\n246|\t\t\t\t\t\t\t}\n247|\t\t\t\t\t\t}\n248|\t\t\t\t\t}\n249|\t\t\t\t}\n250|\t\t\t}\n251|\t\t}\n252|\t}\n253|\tfor _, syntax := range parsed {\n254|\t\tfor _, decl := range syntax.Decls {\n255|\t\t\tnode, ok := decl.(*ast.FuncDecl)\n256|\t\t\tif !ok || node.Body == nil {\n257|\t\t\t\tcontinue\n258|\t\t\t}\n259|\t\t\t// Same-named methods union their shapes so the\n260|\t\t\t// alias resolution below is file-order\n261|\t\t\t// independent.\n262|\t\t\tunion := map[string]bool{}\n263|\t\t\tfor _, class := range state.funcShapes[node.Name.Name] {\n264|\t\t\t\tunion[class] = true\n265|\t\t\t}\n266|\t\t\tfor _, class := range funcShapeClasses(node.Body, node.Type, state) {\n267|\t\t\t\tunion[class] = true\n268|\t\t\t}\n269|\t\t\tvar merged []string\n270|\t\t\tfor class := range union {\n271|\t\t\t\tmerged = append(merged, class)\n272|\t\t\t}\n273|\t\t\tsort.Strings(merged)\n274|\t\t\tstate.funcShapes[node.Name.Name] = merged\n275|\t\t}\n276|\t}\n277|\tvar sites []shapeSite\n278|\tadd := func(class, file, symbol string) {\n279|\t\tsites = append(sites, shapeSite{class: class, pkg: pkg, file: file, symbol: symbol})\n280|\t}\n281|\tfor file, syntax := range parsed {\n282|\t\tfor _, decl := range syntax.Decls {\n283|\t\t\tswitch node := decl.(type) {\n284|\t\t\tcase *ast.FuncDecl:\n285|\t\t\t\tif node.Body == nil {\n286|\t\t\t\t\tcontinue\n287|\t\t\t\t}\n288|\t\t\t\t// Emission uses the file-local shapes; the\n289|\t\t\t\t// union map above serves alias resolution\n290|\t\t\t\t// only, so same-named methods never bleed\n291|\t\t\t\t// sites across files.\n292|\t\t\t\tfor _, class := range funcShapeClasses(node.Body, node.Type, state) {\n293|\t\t\t\t\tadd(class, file, node.Name.Name)\n294|\t\t\t\t}\n295|\t\t\t\tast.Inspect(node.Body, func(inner ast.Node) bool {\n296|\t\t\t\t\tliteral, ok := inner.(*ast.FuncLit)\n297|\t\t\t\t\tif !ok {\n298|\t\t\t\t\t\treturn true\n299|\t\t\t\t\t}\n300|\t\t\t\t\tfor _, class := range funcShapeClasses(literal.Body, literal.Type, state) {\n301|\t\t\t\t\t\tadd(class, file, node.Name.Name+\"$closure\")\n302|\t\t\t\t\t}\n303|\t\t\t\t\treturn true\n304|\t\t\t\t})\n305|\t\t\tcase *ast.GenDecl:\n306|\t\t\t\tfor _, spec := range node.Specs {\n307|\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n308|\t\t\t\t\tif !ok {\n309|\t\t\t\t\t\tcontinue\n310|\t\t\t\t\t}\n311|\t\t\t\t\tfor _, name := range value.Names {\n312|\t\t\t\t\t\tif class, ok := sharedFunctionSymbols[name.Name]; ok {\n313|\t\t\t\t\t\t\tadd(class, file, name.Name)\n314|\t\t\t\t\t\t}\n315|\t\t\t\t\t\tfor _, rhs := range value.Values {\n316|\t\t\t\t\t\t\tswitch bound := rhs.(type) {\n317|\t\t\t\t\t\t\tcase *ast.FuncLit:\n318|\t\t\t\t\t\t\t\tfor _, class := range funcShapeClasses(bound.Body, bound.Type, state) {\n319|\t\t\t\t\t\t\t\t\tadd(class, file, name.Name)\n320|\t\t\t\t\t\t\t\t}\n321|\t\t\t\t\t\t\tcase *ast.Ident:\n322|\t\t\t\t\t\t\t\t// `var f = localHelper` rebinds a\n323|\t\t\t\t\t\t\t\t// local implementation: it inherits\n324|\t\t\t\t\t\t\t\t// the helper's shapes. Binding an\n325|\t\t\t\t\t\t\t\t// imported helper (`var f =\n326|\t\t\t\t\t\t\t\t// otherpkg.Helper`) is a selector,\n327|\t\t\t\t\t\t\t\t// not an identifier, and is reuse.\n328|\t\t\t\t\t\t\t\tfor _, class := range state.funcShapes[bound.Name] {\n329|\t\t\t\t\t\t\t\t\tadd(class, file, name.Name)\n330|\t\t\t\t\t\t\t\t}\n331|\t\t\t\t\t\t\t}\n332|\t\t\t\t\t\t}\n333|\t\t\t\t\t}\n334|\t\t\t\t}\n335|\t\t\t}\n336|\t\t}\n337|\t}\n338|\treturn sites\n339|}\n340|\n341|// funcShapeClasses reports the shape classes of one function or\n342|// closure body.\n343|func funcShapeClasses(body *ast.BlockStmt, sig *ast.FuncType, state *packageShapes) []string {\n344|\tif body == nil {\n345|\t\treturn nil\n346|\t}\n347|\tseen := map[string]bool{}\n348|\tif bodyBuildsJSONDecoder(body) && bodyCarriesDupSignal(body, state) {\n349|\t\tseen[\"strict-decoder\"] = true\n350|\t}\n351|\tif bodyCarriesSurrogateSignal(body, state) {\n352|\t\tseen[\"surrogate-gate\"] = true\n353|\t}\n354|\tif bodyCountsRunes(body) {\n355|\t\tseen[\"string-measure\"] = true\n356|\t}\n357|\tif bodyIsByteMeasure(body, sig) {\n358|\t\tseen[\"byte-measure\"] = true\n359|\t}\n360|\tif _, ok := bodyIsVerdictByteMeasure(body); ok {\n361|\t\tseen[\"byte-measure\"] = true\n362|\t}\n363|\tvar classes []string\n364|\tfor class := range seen {\n365|\t\tclasses = append(classes, class)\n366|\t}\n367|\tsort.Strings(classes)\n368|\treturn classes\n369|}\n370|\n371|// bodyBuildsJSONDecoder reports whether the body constructs an\n372|// encoding/json decoder or unmarshaler.\n373|func bodyBuildsJSONDecoder(body *ast.BlockStmt) bool {\n374|\tfound := false\n375|\tast.Inspect(body, func(node ast.Node) bool {\n376|\t\tcall, ok := node.(*ast.CallExpr)\n377|\t\tif !ok {\n378|\t\t\treturn true\n379|\t\t}\n380|\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n381|\t\tif !ok {\n382|\t\t\treturn true\n383|\t\t}\n384|\t\tidentifier, ok := selector.X.(*ast.Ident)\n385|\t\tif !ok || identifier.Name != \"json\" {\n386|\t\t\treturn true\n387|\t\t}\n388|\t\tif selector.Sel.Name == \"NewDecoder\" || selector.Sel.Name == \"Unmarshal\" {\n389|\t\t\tfound = true\n390|\t\t\treturn false\n391|\t\t}\n392|\t\treturn true\n393|\t})\n394|\treturn found\n395|}\n396|\n397|// bodyHasDupSignal reports whether the body carries a duplicate\n398|// signal: a literal naming both halves, or an identifier with\n399|// the duplicate root (a FaultDuplicate-style constant, a\n400|// duplicate map probe, a dup-check helper name).\n401|func bodyHasDupSignal(body *ast.BlockStmt) bool {\n402|\tfound := false\n403|\tast.Inspect(body, func(node ast.Node) bool {\n404|\t\tswitch n := node.(type) {\n405|\t\tcase *ast.BasicLit:\n406|\t\t\tif n.Kind == token.STRING {\n407|\t\t\t\tif text, err := strconv.Unquote(n.Value); err == nil {\n408|\t\t\t\t\tif strings.Contains(text, \"duplicate\") && strings.Contains(text, \"member\") {\n409|\t\t\t\t\t\tfound = true\n410|\t\t\t\t\t\treturn false\n411|\t\t\t\t\t}\n412|\t\t\t\t}\n413|\t\t\t}\n414|\t\tcase *ast.Ident:\n415|\t\t\tif strings.Contains(n.Name, \"uplicate\") {\n416|\t\t\t\tfound = true\n417|\t\t\t\treturn false\n418|\t\t\t}\n419|\t\t}\n420|\t\treturn true\n421|\t})\n422|\treturn found\n423|}\n424|\n425|// bodyCarriesDupSignal extends the own-body signal across\n426|// same-package callees: a decoder split into an entry plus a\n427|// local duplicate helper still derives on the entry.\n428|func bodyCarriesDupSignal(body *ast.BlockStmt, state *packageShapes) bool {\n429|\tif bodyHasDupSignal(body) {\n430|\t\treturn true\n431|\t}\n432|\tcallee := false\n433|\tast.Inspect(body, func(node ast.Node) bool {\n434|\t\tcall, ok := node.(*ast.CallExpr)\n435|\t\tif !ok {\n436|\t\t\treturn true\n437|\t\t}\n438|\t\tswitch fun := call.Fun.(type) {\n439|\t\tcase *ast.Ident:\n440|\t\t\tif state.funcDups[fun.Name] {\n441|\t\t\t\tcallee = true\n442|\t\t\t\treturn false\n443|\t\t\t}\n444|\t\tcase *ast.SelectorExpr:\n445|\t\t\tif state.funcDups[fun.Sel.Name] {\n446|\t\t\t\tcallee = true\n447|\t\t\t\treturn false\n448|\t\t\t}\n449|\t\t}\n450|\t\treturn true\n451|\t})\n452|\treturn callee\n453|}\n454|\n455|// bodyCarriesSurrogateSignal reports whether the body holds a\n456|// surrogate range literal, names one, or references a\n457|// package-level bound constant.\n458|func bodyCarriesSurrogateSignal(body *ast.BlockStmt, state *packageShapes) bool {\n459|\tfound := false\n460|\tast.Inspect(body, func(node ast.Node) bool {\n461|\t\tswitch n := node.(type) {\n462|\t\tcase *ast.BasicLit:\n463|\t\t\tif n.Kind == token.INT {\n464|\t\t\t\tif magnitude, err := strconv.ParseUint(n.Value, 0, 32); err == nil && surrogateBounds[magnitude] {\n465|\t\t\t\t\tfound = true\n466|\t\t\t\t\treturn false\n467|\t\t\t\t}\n468|\t\t\t}\n469|\t\tcase *ast.Ident:\n470|\t\t\tif strings.Contains(strings.ToLower(n.Name), \"urrogate\") {\n471|\t\t\t\tfound = true\n472|\t\t\t\treturn false\n473|\t\t\t}\n474|\t\t\tif state.constBound[n.Name] {\n475|\t\t\t\tfound = true\n476|\t\t\t\treturn false\n477|\t\t\t}\n478|\t\t}\n479|\t\treturn true\n480|\t})\n481|\treturn found\n482|}\n483|\n484|// bodyCountsRunes reports whether the body counts runes\n485|// directly through the utf8 selector.\n486|func bodyCountsRunes(body *ast.BlockStmt) bool {\n487|\tfound := false\n488|\tast.Inspect(body, func(node ast.Node) bool {\n489|\t\tcall, ok := node.(*ast.CallExpr)\n490|\t\tif !ok {\n491|\t\t\treturn true\n492|\t\t}\n493|\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n494|\t\tif !ok {\n495|\t\t\treturn true\n496|\t\t}\n497|\t\tif selector.Sel.Name == \"RuneCountInString\" || selector.Sel.Name == \"RuneCount\" {\n498|\t\t\tfound = true\n499|\t\t\treturn false\n500|\t\t}\n(more lines below)"}}}
