{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b7","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":694,"recorded_at":1780531400001383,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"6a382b36-ec5d-44d8-807d-a54dadafd03c"},"task_id":"6a382b36-ec5d-44d8-807d-a54dadafd03c","event":{"kind":"output","task_id":"6a382b36-ec5d-44d8-807d-a54dadafd03c","chunk":"Read text file `internal/scalar/scalar_test.go`.\n(129 line(s) above)\n130|\t\t\"1990-12-30T23:59:60.000Z\", // no leap second was published for this date\n131|\t\t\"2026-12-31T23:59:60.000Z\", // no leap second is published for this date\n132|\t} {\n133|\t\tif _, err := ParseTimestamp(fabricated); !errors.Is(err, ErrInvalidScalar) {\n134|\t\t\tt.Errorf(\"ParseTimestamp(%q) error = %v, want ErrInvalidScalar\", fabricated, err)\n135|\t\t}\n136|\t\tif err := json.Unmarshal([]byte(`\"`+fabricated+`\"`), &fromJSON); !errors.Is(err, ErrInvalidScalar) {\n137|\t\t\tt.Errorf(\"Unmarshal leap-second timestamp %q error = %v, want ErrInvalidScalar\", fabricated, err)\n138|\t\t}\n139|\t\tif err := fromText.UnmarshalText([]byte(fabricated)); !errors.Is(err, ErrInvalidScalar) {\n140|\t\t\tt.Errorf(\"UnmarshalText leap-second timestamp %q error = %v, want ErrInvalidScalar\", fabricated, err)\n141|\t\t}\n142|\t}\n143|}\n144|\n145|func TestDigestAcceptsExactSHA256AndHashesRawBytes(t *testing.T) {\n146|\tt.Parallel()\n147|\n148|\twant := \"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"\n149|\tdigest := SHA256Digest(nil)\n150|\tif digest.String() != want || digest.Hex() != strings.TrimPrefix(want, \"sha256:\") {\n151|\t\tt.Fatalf(\"SHA256Digest(nil) = %q (%q), want %q\", digest, digest.Hex(), want)\n152|\t}\n153|\tparsed, err := ParseDigest(want)\n154|\tif err != nil || parsed != digest {\n155|\t\tt.Fatalf(\"ParseDigest(%q) = %q, %v\", want, parsed, err)\n156|\t}\n157|\n158|\tfor _, value := range []string{\n159|\t\tstrings.TrimPrefix(want, \"sha256:\"),\n160|\t\t\"sha512:\" + strings.TrimPrefix(want, \"sha256:\"),\n161|\t\t\"sha256:\" + strings.ToUpper(strings.TrimPrefix(want, \"sha256:\")),\n162|\t\twant[:len(want)-1],\n163|\t\twant + \"0\",\n164|\t} {\n165|\t\tif _, err := ParseDigest(value); !errors.Is(err, ErrInvalidScalar) {\n166|\t\t\tt.Errorf(\"ParseDigest(%q) error = %v, want ErrInvalidScalar\", value, err)\n167|\t\t}\n168|\t}\n169|}\n170|\n171|func TestPlatformAndProviderIDAreClosedAndBounded(t *testing.T) {\n172|\tt.Parallel()\n173|\n174|\tfor _, value := range []string{\"macos\", \"linux\", \"wsl2\", \"windows\"} {\n175|\t\tplatform, err := ParsePlatform(value)\n176|\t\tif err != nil || platform.String() != value {\n177|\t\t\tt.Errorf(\"ParsePlatform(%q) = %q, %v\", value, platform, err)\n178|\t\t}\n179|\t}\n180|\tfor _, value := range []string{\"darwin\", \"MacOS\", \"freebsd\", \"\"} {\n181|\t\tif _, err := ParsePlatform(value); !errors.Is(err, ErrInvalidScalar) {\n182|\t\t\tt.Errorf(\"ParsePlatform(%q) error = %v, want ErrInvalidScalar\", value, err)\n183|\t\t}\n184|\t}\n185|\n186|\tfor _, value := range []string{\"codex\", \"a\", \"a-b\", \"a\" + strings.Repeat(\"1\", 31)} {\n187|\t\tprovider, err := ParseProviderID(value)\n188|\t\tif err != nil || provider.String() != value {\n189|\t\t\tt.Errorf(\"ParseProviderID(%q) = %q, %v\", value, provider, err)\n(more lines below)"}}}
