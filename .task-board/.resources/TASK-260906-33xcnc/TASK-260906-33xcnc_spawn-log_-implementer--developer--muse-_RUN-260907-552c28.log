{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c539","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":247,"recorded_at":1780531400000489,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b1f7d737da3a56233153af3b288","text":"Read text file `internal/environ/shape_census_test.go`.\n(499 line(s) above)\n500|\t\t}\n501|\t\treturn true\n502|\t})\n503|\treturn found\n504|}\n505|\n506|// stringParamNames returns the names of the string-typed\n507|// parameters.\n508|func stringParamNames(sig *ast.FuncType) map[string]bool {\n509|\tnames := map[string]bool{}\n510|\tif sig == nil || sig.Params == nil {\n511|\t\treturn names\n512|\t}\n513|\tfor _, field := range sig.Params.List {\n514|\t\tidentifier, ok := field.Type.(*ast.Ident)\n515|\t\tif !ok || identifier.Name != \"string\" {\n516|\t\t\tcontinue\n517|\t\t}\n518|\t\tfor _, name := range field.Names {\n519|\t\t\tnames[name.Name] = true\n520|\t\t}\n521|\t}\n522|\treturn names\n523|}\n524|\n525|// returnsSingleInt reports whether the signature returns exactly\n526|// one int.\n527|func returnsSingleInt(sig *ast.FuncType) bool {\n528|\tif sig == nil || sig.Results == nil || len(sig.Results.List) != 1 {\n529|\t\treturn false\n530|\t}\n531|\tidentifier, ok := sig.Results.List[0].Type.(*ast.Ident)\n532|\treturn ok && identifier.Name == \"int\"\n533|}\n534|\n535|// bodyIsByteMeasure reports the func(string)->int texture: a\n536|// string parameter measured by len().\n537|func bodyIsByteMeasure(body *ast.BlockStmt, sig *ast.FuncType) bool {\n538|\tif !returnsSingleInt(sig) {\n539|\t\treturn false\n540|\t}\n541|\tparams := stringParamNames(sig)\n542|\tif len(params) == 0 {\n543|\t\treturn false\n544|\t}\n545|\tfound := false\n546|\tast.Inspect(body, func(node ast.Node) bool {\n547|\t\tcall, ok := node.(*ast.CallExpr)\n548|\t\tif !ok {\n549|\t\t\treturn true\n550|\t\t}\n551|\t\tidentifier, ok := call.Fun.(*ast.Ident)\n552|\t\tif !ok || identifier.Name != \"len\" || len(call.Args) != 1 {\n553|\t\t\treturn true\n554|\t\t}\n555|\t\tif argument, ok := call.Args[0].(*ast.Ident); ok && params[argument.Name] {\n556|\t\t\tfound = true\n557|\t\t\treturn false\n558|\t\t}\n559|\t\treturn true\n560|\t})\n561|\treturn found\n562|}\n563|\n564|// bodyIsVerdictByteMeasure reports the verdict-style texture: a\n565|// len() applied to a variable assigned from a rawString() call.\n566|func bodyIsVerdictByteMeasure(body *ast.BlockStmt) (string, bool) {\n567|\tmeasured := map[string]bool{}\n568|\tast.Inspect(body, func(node ast.Node) bool {\n569|\t\tassignment, ok := node.(*ast.AssignStmt)\n570|\t\tif !ok {\n571|\t\t\treturn true\n572|\t\t}\n573|\t\tfor _, rhs := range assignment.Rhs {\n574|\t\t\tif !expressionCallsRawString(rhs) {\n575|\t\t\t\tcontinue\n576|\t\t\t}\n577|\t\t\tfor _, lhs := range assignment.Lhs {\n578|\t\t\t\tif identifier, ok := lhs.(*ast.Ident); ok && identifier.Name != \"_\" && identifier.Name != \"ok\" {\n579|\t\t\t\t\tmeasured[identifier.Name] = true\n580|\t\t\t\t}\n581|\t\t\t}\n582|\t\t}\n583|\t\treturn true\n584|\t})\n585|\tif len(measured) == 0 {\n586|\t\treturn \"\", false\n587|\t}\n588|\tname := \"\"\n589|\thit := false\n590|\tast.Inspect(body, func(node ast.Node) bool {\n591|\t\tcall, ok := node.(*ast.CallExpr)\n592|\t\tif !ok {\n593|\t\t\treturn true\n594|\t\t}\n595|\t\tidentifier, ok := call.Fun.(*ast.Ident)\n596|\t\tif !ok || identifier.Name != \"len\" || len(call.Args) != 1 {\n597|\t\t\treturn true\n598|\t\t}\n599|\t\tif argument, ok := call.Args[0].(*ast.Ident); ok && measured[argument.Name] {\n600|\t\t\tname, hit = argument.Name, true\n601|\t\t\treturn false\n602|\t\t}\n603|\t\treturn true\n604|\t})\n605|\treturn name, hit\n606|}\n607|\n608|// expressionCallsRawString reports whether the expression holds\n609|// a rawString() call.\n610|func expressionCallsRawString(expression ast.Expr) bool {\n611|\tfound := false\n612|\tast.Inspect(expression, func(node ast.Node) bool {\n613|\t\tcall, ok := node.(*ast.CallExpr)\n614|\t\tif !ok {\n615|\t\t\treturn true\n616|\t\t}\n617|\t\tif identifier, ok := call.Fun.(*ast.Ident); ok && identifier.Name == \"rawString\" {\n618|\t\t\tfound = true\n619|\t\t\treturn false\n620|\t\t}\n621|\t\treturn true\n622|\t})\n623|\treturn found\n624|}\n625|\n626|// shapeControl is one synthetic control plant: a source file\n627|// whose derived shape and name sites must equal the want sets\n628|// exactly, and whose every derived site must be unregistered —\n629|// the census verdict on a genuine new copy. The extractor under\n630|// test is shapeSitesInPackage, the same pure function the\n631|// production census runs on the real tree, so a control that\n632|// fails here fails the production census by construction.\n633|type shapeControl struct {\n634|\tname      string\n635|\tsource    string\n636|\twantShape []string\n637|\twantName  []string\n638|\t// allowEmpty marks the negatives control: clean derivation\n639|\t// is the verdict, so the non-empty guard does not apply.\n640|\tallowEmpty bool\n641|}\n642|\n643|// shapeControls plants every shape the census claims to catch:\n644|// the reviewer's seven in-scope shapes (A, B1-B3, C1-C3) plus\n645|// the split-decoder, const-bound gate, rune measure,\n646|// verdict-style byte measure, local-alias, and fresh-name\n647|// method variants, with negatives that must stay clean.\n648|func shapeControls() []shapeControl {\n649|\tdecoderBody := `decoder := json.NewDecoder(bytes.NewReader(data))\n650|\tseen := map[string]int{}\n651|\tfor decoder.More() {\n652|\t\tname := \"k\"\n653|\t\tif _, duplicate := seen[name]; duplicate {\n654|\t\t\tpanic(\"duplicate member\")\n655|\t\t}\n656|\t\tseen[name] = 1\n657|\t}\n658|\treturn seen`\n659|\treturn []shapeControl{\n660|\t\t{\n661|\t\t\tname: \"fresh decoder spelling\",\n662|\t\t\tsource: `package provider\n663|func parseStrictObject(data []byte) map[string]int {\n664|\t` + decoderBody + `\n665|}`,\n666|\t\t\twantShape: []string{\"strict-decoder|provider|control.go|parseStrictObject\"},\n667|\t\t},\n668|\t\t{\n669|\t\t\tname: \"split decoder entry plus helper\",\n670|\t\t\tsource: `package provider\n671|func decodeEntry(data []byte) map[string]int {\n672|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n673|\t_ = decoder\n674|\treturn checkNoDup(map[string]int{})\n675|}\n676|func checkNoDup(members map[string]int) map[string]int {\n677|\tfor name := range members {\n678|\t\t_ = name\n679|\t\t_ = \"duplicate member check\"\n680|\t}\n681|\treturn members\n682|}`,\n683|\t\t\twantShape: []string{\"strict-decoder|provider|control.go|decodeEntry\"},\n684|\t\t},\n685|\t\t{\n686|\t\t\tname: \"fresh surrogate gate spelling\",\n687|\t\t\tsource: `package provider\n688|func scanForLoneSurrogate(data []byte) bool {\n689|\tfor _, unit := range data {\n690|\t\tif unit == 0xD800 || unit == 0xDC00 {\n691|\t\t\treturn true\n692|\t\t}\n693|\t}\n694|\treturn false\n695|}`,\n696|\t\t\twantShape: []string{\"surrogate-gate|provider|control.go|scanForLoneSurrogate\"},\n697|\t\t},\n698|\t\t{\n699|\t\t\tname: \"const-bound gate under fresh names\",\n700|\t\t\tsource: `package provider\n701|const hiStart = 0xD800\n702|const hiEnd = 0xDBFF\n703|func scanFrame(data []byte) bool {\n704|\tfor _, unit := range data {\n705|\t\tif unit >= hiStart && unit <= hiEnd {\n706|\t\t\treturn true\n707|\t\t}\n708|\t}\n709|\treturn false\n710|}`,\n711|\t\t\twantShape: []string{\"surrogate-gate|provider|control.go|scanFrame\"},\n712|\t\t},\n713|\t\t{\n714|\t\t\tname: \"fresh rune measure\",\n715|\t\t\tsource: `package provider\n716|func measureRunes(value string) int { return utf8.RuneCountInString(value) }`,\n717|\t\t\twantShape: []string{\"string-measure|provider|control.go|measureRunes\"},\n718|\t\t},\n719|\t\t{\n720|\t\t\tname: \"fresh byte measure\",\n721|\t\t\tsource: `package provider\n722|func measureString(value string) int { return len(value) }`,\n723|\t\t\twantShape: []string{\"byte-measure|provider|control.go|measureString\"},\n724|\t\t},\n725|\t\t{\n726|\t\t\tname: \"verdict-style byte measure\",\n727|\t\t\tsource: `package provider\n728|func checkByteBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n729|\tvalue, ok := rawString(raw)\n730|\tif !ok || len(value) < minimum || len(value) > maximum {\n731|\t\treturn \"\", false\n732|\t}\n733|\treturn value, true\n734|}`,\n735|\t\t\twantShape: []string{\"byte-measure|provider|control.go|checkByteBounds\"},\n736|\t\t},\n737|\t\t{\n738|\t\t\tname: \"var alias of ledgered name\",\n739|\t\t\tsource: `package provider\n740|var stringLength = byteLength`,\n741|\t\t\twantShape: []string{\"string-measure|provider|control.go|stringLength\"},\n742|\t\t},\n743|\t\t{\n744|\t\t\t// The name layer stays blind to the var binding\n745|\t\t\t// (it derives FuncDecl only) while the shape\n746|\t\t\t// layer fires on the closure: the exact B1 gap,\n747|\t\t\t// closed by derivation rather than assertion.\n748|\t\t\tname: \"var alias closure with decoder shape\",\n749|\t\t\tsource: `package provider\n750|var decodeStrict = func(data []byte) bool {\n751|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n752|\t_ = decoder\n753|\t_ = \"duplicate member\"\n754|\treturn false\n755|}`,\n756|\t\t\twantShape: []string{\"strict-decoder|provider|control.go|decodeStrict\"},\n757|\t\t},\n758|\t\t{\n759|\t\t\tname: \"var alias of shape-positive local\",\n760|\t\t\tsource: `package provider\n761|func byteLength(value string) int { return len(value) }\n762|var byteLen = byteLength`,\n763|\t\t\twantShape: []string{\n764|\t\t\t\t\"byte-measure|provider|control.go|byteLen\",\n765|\t\t\t\t\"byte-measure|provider|control.go|byteLength\",\n766|\t\t\t},\n767|\t\t},\n768|\t\t{\n769|\t\t\tname: \"fresh gate method spelling\",\n770|\t\t\tsource: `package provider\n771|type frameScanner struct{}\n772|func (frameScanner) scanEscapes(data []byte) bool {\n773|\tfor _, unit := range data {\n774|\t\tif unit >= 0xDC00 && unit <= 0xDFFF {\n775|\t\t\treturn true\n776|\t\t}\n777|\t}\n778|\treturn false\n779|}`,\n780|\t\t\twantShape: []string{\"surrogate-gate|provider|control.go|scanEscapes\"},\n781|\t\t},\n782|\t\t{\n783|\t\t\tname: \"ledgered name method still fires by name\",\n784|\t\t\tsource: `package provider\n785|type surrogateScanner struct{}\n786|func (surrogateScanner) hasLoneSurrogateEscape(data []byte) bool { return len(data) == 0 }`,\n787|\t\t\twantName: []string{\"surrogate-gate|provider|control.go|hasLoneSurrogateEscape\"},\n788|\t\t},\n789|\t\t{\n790|\t\t\tname: \"ledgered decoder name still fires by name\",\n791|\t\t\tsource: `package provider\n792|func decodeStrictObject(data []byte) bool { return len(data) == 0 }`,\n793|\t\t\twantName: []string{\"strict-decoder|provider|control.go|decodeStrictObject\"},\n794|\t\t},\n795|\t\t{\n796|\t\t\tname: \"negatives stay clean\",\n797|\t\t\tsource: `package provider\n798|func decodeArrayShaped(raw json.RawMessage) []int {\n799|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n800|\t_ = decoder\n801|\treturn nil\n802|}\n803|func asciiNameOk(name string) bool { return len(name) >= 1 && len(name) <= 128 }\n804|func countElements(values []string) int { return len(values) }\n805|var reuse = environ.StringLength`,\n806|\t\t\tallowEmpty: true,\n807|\t\t},\n808|\t}\n809|}\n810|\n811|// mirrorNameSites replicates the name layer's FuncDecl rule on\n812|// one synthetic file: declarations whose identifiers are already\n813|// in sharedFunctionSymbols. The production name derivation in\n814|// census_test.go applies this same rule to the real tree.\n815|func mirrorNameSites(source []byte) []string {\n816|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"control.go\", source, 0)\n817|\tif err != nil {\n818|\t\treturn []string{\"parse-failure|provider|control.go|unparseable\"}\n819|\t}\n820|\tvar keys []string\n821|\tfor _, decl := range syntax.Decls {\n822|\t\tnode, ok := decl.(*ast.FuncDecl)\n823|\t\tif !ok || node.Name == nil {\n824|\t\t\tcontinue\n825|\t\t}\n826|\t\tif class, ok := sharedFunctionSymbols[node.Name.Name]; ok {\n827|\t\t\tkeys = append(keys, shapeSite{class: class, pkg: \"provider\", file: \"control.go\", symbol: node.Name.Name}.key())\n828|\t\t}\n829|\t}\n830|\tsort.Strings(keys)\n831|\treturn keys\n832|}\n833|\n834|// TestShapeCensusCatchesControls drives every control plant\n835|// through the production extractor and requires the exact\n836|// derived sets, with every derived site unregistered: the proof\n837|// that each claimed shape fails the census rather than passing\n838|// silently.\n839|func TestShapeCensusCatchesControls(t *testing.T) {\n840|\tfor _, control := range shapeControls() {\n841|\t\tt.Run(control.name, func(t *testing.T) {\n842|\t\t\tseenShape := map[string]bool{}\n843|\t\t\tvar gotShape []string\n844|\t\t\tfor _, site := range shapeSitesInPackage(\"provider\", map[string][]byte{\"control.go\": []byte(control.source)}) {\n845|\t\t\t\tif !seenShape[site.key()] {\n846|\t\t\t\t\tseenShape[site.key()] = true\n847|\t\t\t\t\tgotShape = append(gotShape, site.key())\n848|\t\t\t\t}\n849|\t\t\t}\n850|\t\t\tsort.Strings(gotShape)\n851|\t\t\tif strings.Join(gotShape, \"\\x00\") != strings.Join(control.wantShape, \"\\x00\") {\n852|\t\t\t\tt.Fatalf(\"shape sites = %q, want %q\", gotShape, control.wantShape)\n853|\t\t\t}\n854|\t\t\tgotName := mirrorNameSites([]byte(control.source))\n855|\t\t\tif strings.Join(gotName, \"\\x00\") != strings.Join(control.wantName, \"\\x00\") {\n856|\t\t\t\tt.Fatalf(\"name sites = %q, want %q\", gotName, control.wantName)\n857|\t\t\t}\n858|\t\t\tfor _, key := range append(append([]string{}, gotShape...), gotName...) {\n859|\t\t\t\tif _, ok := shapeLedger[key]; ok {\n860|\t\t\t\t\tt.Fatalf(\"control site %q is registered; the control proves nothing\", key)\n861|\t\t\t\t}\n862|\t\t\t\tif _, ok := sharedLedger[key]; ok {\n863|\t\t\t\t\tt.Fatalf(\"control site %q is registered; the control proves nothing\", key)\n864|\t\t\t\t}\n865|\t\t\t}\n866|\t\t\tif !control.allowEmpty && len(gotShape)+len(gotName) == 0 {\n867|\t\t\t\tt.Fatal(\"control derives no site; the control proves nothing\")\n868|\t\t\t}\n869|\t\t})\n870|\t}\n871|}\n872|\n873|// TestGrammarCensusCatchesFreshName plants a fresh-name copy of\n874|// the environment-id grammar and requires the classifier to\n875|// report it as a copy of that class with an unregistered key:\n876|// the proof that a renamed grammar copy fails the census.\n877|func TestGrammarCensusCatchesFreshName(t *testing.T) {\n878|\tliterals, _, _ := deriveGrammarLiterals(t)\n879|\tknown := grammarKnownLiterals(literals)\n880|\tenvironmentID, ok := knownLiteralFor(t, literals, \"env-id-grammar\")\n881|\tif !ok {\n882|\t\tt.Fatal(\"env-id-grammar derives no literal; the control has nothing to copy\")\n883|\t}\n884|\tsource := []byte(\"package provider\\nvar envIDCopy = regexp.MustCompile(`\" + environmentID + \"`)\\n\")\n885|\tcandidates, err := grammarCandidatesInFile(\"control.go\", source)\n886|\tif err != nil {\n887|\t\tt.Fatalf(\"control does not parse: %v\", err)\n888|\t}\n889|\tif len(candidates) != 1 {\n890|\t\tt.Fatalf(\"control derives %d candidates, want 1\", len(candidates))\n891|\t}\n892|\tclass, copy := classifyGrammarCandidate(candidates[0], known)\n893|\tif !copy || class != \"env-id-grammar\" {\n894|\t\tt.Fatalf(\"fresh-name copy classified as (%q, %v), want (env-id-grammar, true)\", class, copy)\n895|\t}\n896|\tkey := shapeSite{class: class, pkg: \"provider\", file: \"control.go\", symbol: candidates[0].symbol}.key()\n897|\tif grammarSiteLedger[key] {\n898|\t\tt.Fatalf(\"control site %q is registered; the control proves nothing\", key)\n899|\t}\n900|\tnegative, err := grammarCandidatesInFile(\"control.go\", []byte(\"package provider\\nvar sitePattern = regexp.MustCompile(`^[a-z]+$`)\\n\"))\n901|\tif err != nil {\n902|\t\tt.Fatalf(\"negative does not parse: %v\", err)\n903|\t}\n904|\tif _, copy := classifyGrammarCandidate(negative[0], known); copy {\n905|\t\tt.Fatal(\"unknown-literal grammar classified as a copy; the rule overreaches\")\n906|\t}\n907|}\n908|\n909|// knownLiteralFor returns one derived literal of the class.\n910|func knownLiteralFor(t *testing.T, literals map[string]map[string]bool, class string) (string, bool) {\n911|\tt.Helper()\n912|\tfor text := range literals[class] {\n913|\t\treturn text, true\n914|\t}\n915|\treturn \"\", false\n916|}\n917|\n918|// TestDelegatingWrappersCallEnviron pins the B2 fix\n919|// structurally: the sessadapter and dirnode frame decoders must\n920|// delegate to environ, and the removed raw-scan copies must not\n921|// come back. The wrapper body must reference the environ\n922|// package and must not construct a decoder, a surrogate bound,\n923|// or a rune count of its own; neither file may define the old\n924|// gate or helper names or carry surrogate range literals.\n925|func TestDelegatingWrappersCallEnviron(t *testing.T) {\n926|\troot, err := internalRoot(t)\n927|\tif err != nil {\n928|\t\tt.Fatalf(\"delegation: %v\", err)\n929|\t}\n930|\tfor _, pkg := range []string{\"sessadapter\", \"dirnode\"} {\n931|\t\tt.Run(pkg, func(t *testing.T) {\n932|\t\t\tpath := filepath.Join(root, pkg, \"decode.go\")\n933|\t\t\tsource, err := os.ReadFile(path)\n934|\t\t\tif err != nil {\n935|\t\t\t\tt.Fatalf(\"delegation: %v\", err)\n936|\t\t\t}\n937|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n938|\t\t\tif err != nil {\n939|\t\t\t\tt.Fatalf(\"delegation: %v\", err)\n940|\t\t\t}\n941|\t\t\tfoundWrapper := false\n942|\t\t\tfor _, decl := range syntax.Decls {\n943|\t\t\t\tnode, ok := decl.(*ast.FuncDecl)\n944|\t\t\t\tif !ok {\n945|\t\t\t\t\tcontinue\n946|\t\t\t\t}\n947|\t\t\t\tswitch node.Name.Name {\n948|\t\t\t\tcase \"hasLoneSurrogateEscape\", \"readUTF16Escape\", \"readUTF16EscapeAfter\":\n949|\t\t\t\t\tt.Fatalf(\"delegation: removed raw-scan copy %q is back in %s/decode.go\", node.Name.Name, pkg)\n950|\t\t\t\tcase \"decodeStrictObject\":\n951|\t\t\t\t\tfoundWrapper = true\n952|\t\t\t\t\tpinsDelegation(t, pkg, node)\n953|\t\t\t\t}\n954|\t\t\t}\n955|\t\t\tif !foundWrapper {\n956|\t\t\t\tt.Fatalf(\"delegation: decodeStrictObject missing in %s/decode.go\", pkg)\n957|\t\t\t}\n958|\t\t\tassertNoSurrogateLiterals(t, pkg, syntax)\n959|\t\t})\n960|\t}\n961|}\n962|\n963|// delegatedCheckHelpers names every sessadapter and dirnode\n964|// decode.go helper that must delegate to environ rather than\n965|// reimplement the rule. The frame decoder above is pinned\n966|// separately; these are the per-helper copies this leaf\n967|// converged. A helper that regrows a local rule fails here\n968|// structurally, before any behavioral battery runs.\n969|var delegatedCheckHelpers = []string{\n970|\t\"stringLength\",\n971|\t\"checkStringBounds\",\n972|\t\"checkUint53Bounds\",\n973|\t\"checkDigest\",\n974|\t\"checkUUIDv7\",\n975|\t\"checkTimestamp\",\n976|\t\"checkSortedUniqueStrings\",\n977|\t\"checkSortedUniqueDigests\",\n978|\t\"checkExtensions\",\n979|}\n980|\n981|// removedGrammarCopies names the grammar variables the converged\n982|// helpers deleted. A revived copy fails here as well as in the\n983|// grammar census, so the failure names the file, not just the\n984|// class.\n985|var removedGrammarCopies = []string{\n986|\t\"semverPattern\",\n987|\t\"environmentIDPattern\",\n988|\t\"reverseDNSPattern\",\n989|}\n990|\n991|// TestCheckHelpersDelegateToEnviron pins the per-helper\n992|// convergence structurally: every delegated helper must reference\n993|// the environ package and must hold no decoder, surrogate gate,\n994|// rune count, or compiled grammar of its own, and the removed\n995|// grammar copies must not come back. dirnode's checkSemver and\n996|// checkEnvironmentID delegate the same way through local names\n997|// the shared list does not ledger.\n998|func TestCheckHelpersDelegateToEnviron(t *testing.T) {\n999|\troot, err := internalRoot(t)\n1000|\tif err != nil {\n1001|\t\tt.Fatalf(\"check-delegation: %v\", err)\n1002|\t}\n1003|\tfor _, pkg := range []string{\"sessadapter\", \"dirnode\"} {\n1004|\t\tt.Run(pkg, func(t *testing.T) {\n1005|\t\t\tpath := filepath.Join(root, pkg, \"decode.go\")\n1006|\t\t\tsource, err := os.ReadFile(path)\n1007|\t\t\tif err != nil {\n1008|\t\t\t\tt.Fatalf(\"check-delegation: %v\", err)\n1009|\t\t\t}\n1010|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n1011|\t\t\tif err != nil {\n1012|\t\t\t\tt.Fatalf(\"check-delegation: %v\", err)\n1013|\t\t\t}\n1014|\t\t\tfound := map[string]bool{}\n1015|\t\t\tfor _, decl := range syntax.Decls {\n1016|\t\t\t\tnode, ok := decl.(*ast.FuncDecl)\n1017|\t\t\t\tif !ok {\n1018|\t\t\t\t\tcontinue\n1019|\t\t\t\t}\n1020|\t\t\t\tfor _, name := range delegatedCheckHelpers {\n1021|\t\t\t\t\tif node.Name.Name == name {\n1022|\t\t\t\t\t\tfound[name] = true\n1023|\t\t\t\t\t\tpinsCheckDelegation(t, pkg, node)\n1024|\t\t\t\t\t}\n1025|\t\t\t\t}\n1026|\t\t\t\tif pkg == \"dirnode\" && (node.Name.Name == \"checkSemver\" || node.Name.Name == \"checkEnvironmentID\") {\n1027|\t\t\t\t\tfound[node.Name.Name] = true\n1028|\t\t\t\t\tpinsCheckDelegation(t, pkg, node)\n1029|\t\t\t\t}\n1030|\t\t\t}\n1031|\t\t\tfor _, name := range delegatedCheckHelpers {\n1032|\t\t\t\tif !found[name] {\n1033|\t\t\t\t\tt.Fatalf(\"check-delegation: %s helper %q missing in %s/decode.go\", pkg, name, pkg)\n1034|\t\t\t\t}\n1035|\t\t\t}\n1036|\t\t\tif pkg == \"dirnode\" && (!found[\"checkSemver\"] || !found[\"checkEnvironmentID\"]) {\n1037|\t\t\t\tt.Fatalf(\"check-delegation: dirnode grammar helpers missing in dirnode/decode.go\")\n1038|\t\t\t}\n1039|\t\t\tassertNoRevivedGrammarCopies(t, pkg, syntax)\n1040|\t\t})\n1041|\t}\n1042|}\n1043|\n1044|// pinsCheckDelegation requires the helper to reference environ and\n1045|// to hold no rule of its own: no decoder, no surrogate signal, no\n1046|// rune count, and no compiled grammar.\n1047|func pinsCheckDelegation(t *testing.T, pkg string, wrapper *ast.FuncDecl) {\n1048|\tt.Helper()\n1049|\treferencesEnviron := false\n1050|\tast.Inspect(wrapper.Body, func(node ast.Node) bool {\n1051|\t\tselector, ok := node.(*ast.SelectorExpr)\n1052|\t\tif !ok {\n1053|\t\t\treturn true\n1054|\t\t}\n1055|\t\tidentifier, ok := selector.X.(*ast.Ident)\n1056|\t\tif !ok {\n1057|\t\t\treturn true\n1058|\t\t}\n1059|\t\tif identifier.Name != \"environ\" {\n1060|\t\t\treturn true\n1061|\t\t}\n1062|\t\treferencesEnviron = true\n1063|\t\treturn false\n1064|\t})\n1065|\tif !referencesEnviron {\n1066|\t\tt.Fatalf(\"check-delegation: %s %s no longer references environ\", pkg, wrapper.Name.Name)\n1067|\t}\n1068|\tif bodyBuildsJSONDecoder(wrapper.Body) {\n1069|\t\tt.Fatalf(\"check-delegation: %s %s builds its own decoder\", pkg, wrapper.Name.Name)\n1070|\t}\n1071|\tsurrogateState := &packageShapes{funcDups: map[string]bool{}, funcShapes: map[string][]string{}, constBound: map[string]bool{}}\n1072|\tif bodyCarriesSurrogateSignal(wrapper.Body, surrogateState) {\n1073|\t\tt.Fatalf(\"check-delegation: %s %s carries its own surrogate gate\", pkg, wrapper.Name.Name)\n1074|\t}\n1075|\tif bodyCountsRunes(wrapper.Body) {\n1076|\t\tt.Fatalf(\"check-delegation: %s %s counts runes itself\", pkg, wrapper.Name.Name)\n1077|\t}\n1078|\tast.Inspect(wrapper.Body, func(node ast.Node) bool {\n1079|\t\tcall, ok := node.(*ast.CallExpr)\n1080|\t\tif !ok {\n1081|\t\t\treturn true\n1082|\t\t}\n1083|\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n1084|\t\tif !ok {\n1085|\t\t\treturn true\n1086|\t\t}\n1087|\t\tif selector.Sel.Name == \"MustCompile\" {\n1088|\t\t\tt.Fatalf(\"check-delegation: %s %s compiles its own grammar\", pkg, wrapper.Name.Name)\n1089|\t\t}\n1090|\t\treturn true\n1091|\t})\n1092|}\n1093|\n1094|// assertNoRevivedGrammarCopies requires the converged grammar\n1095|// variables to stay deleted from the package decode.go file.\n1096|func assertNoRevivedGrammarCopies(t *testing.T, pkg string, syntax *ast.File) {\n1097|\tt.Helper()\n1098|\tfor _, decl := range syntax.Decls {\n1099|\t\tnode, ok := decl.(*ast.GenDecl)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53b","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":248,"recorded_at":1780531400000491,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b1f7e9a75d19f0091792235deca","text":"Read text file `internal/dirnode/decode.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// This file holds parse-only helpers for every Section 7.9 and\n14|// 10.8.5 closed body. Every helper reports a verdict and never\n15|// refuses: all refusals call one of the refusal constructors\n16|// directly at the deciding site with literal details, so the\n17|// refusal-arm inventory keeps seeing every arm. A helper that\n18|// fronted a constructor would collapse distinct rules into one\n19|// obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer:\n22|// Section 7.9 counts and limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// frameFault is one strict-decode failure: what was wrong and which\n26|// member it was found in, if any. It never carries foreign bytes.\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|// decodeStrictObject parses one complete JSON object with duplicate\n33|// member rejection. It is the only JSON entry point in this package:\n34|// every body crosses it before any member is read. The frame verdict\n35|// itself is the shared environ verdict: this function delegates to\n36|// environ.DecodeStrictObject and translates the fault into the\n37|// package refusal dialect without reimplementing any rule, so the\n38|// two can never drift. The delegated string-walk surrogate gate\n39|// refuses a real lone escape behind an even backslash run and\n40|// admits quoted backslash-u text; the raw byte scan this replaces\n41|// misread the quoted text as a high surrogate and admitted the\n42|// real lone escape behind it. A non-UTF-8 frame, a lone surrogate\n43|// escape, a non-object top level, a duplicated member, or trailing\n44|// data is a fault, never a partial object the caller could mistake\n45|// for a result.\n46|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n47|\tmembers, fault := environ.DecodeStrictObject(data)\n48|\tif fault != nil {\n49|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n50|\t}\n51|\treturn members, nil\n52|}\n53|\n54|// unknownMember names a member outside the closed set, if any. The\n55|// single-unknown fixtures keep the verdict deterministic: with\n56|// several unknowns the map order decides which is named, so tests\n57|// never assert a name from a multi-unknown body.\n58|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n59|\tfor name := range members {\n60|\t\tif !allowed[name] {\n61|\t\t\treturn name, true\n62|\t\t}\n63|\t}\n64|\treturn \"\", false\n65|}\n66|\n67|// missingMember names the first required member with no value, if\n68|// any. The required list is fixed order, so the verdict is\n69|// deterministic for every missing combination.\n70|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n71|\tfor _, name := range required {\n72|\t\tif _, present := members[name]; !present {\n73|\t\t\treturn name, true\n74|\t\t}\n75|\t}\n76|\treturn \"\", false\n77|}\n78|\n79|// rawString reads a JSON string member.\n80|func rawString(raw json.RawMessage) (string, bool) {\n81|\tvar value string\n82|\tif err := json.Unmarshal(raw, &value); err != nil {\n83|\t\treturn \"\", false\n84|\t}\n85|\treturn value, true\n86|}\n87|\n88|// rawBool reads a JSON boolean member.\n89|func rawBool(raw json.RawMessage) (bool, bool) {\n90|\tvar value bool\n91|\tif err := json.Unmarshal(raw, &value); err != nil {\n92|\t\treturn false, false\n93|\t}\n94|\treturn value, true\n95|}\n96|\n97|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n98|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n99|// even when it names the same mathematical value.\n100|func rawUint53(raw json.RawMessage) (uint64, bool) {\n101|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n102|\tdecoder.UseNumber()\n103|\tvar value any\n104|\tif err := decoder.Decode(&value); err != nil {\n105|\t\treturn 0, false\n106|\t}\n107|\t// Decode reads one value and stops: without the trailing\n108|\t// check a hostile slice like `12a` would read as 12. Member\n109|\t// slices arriving through decodeStrictObject can never carry\n110|\t// trailing data, but this entry takes raw slices and must\n111|\t// not trust them.\n112|\tif _, err := decoder.Token(); err != io.EOF {\n113|\t\treturn 0, false\n114|\t}\n115|\tnumber, ok := value.(json.Number)\n116|\tif !ok {\n117|\t\treturn 0, false\n118|\t}\n119|\tliteral := number.String()\n120|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n121|\t\treturn 0, false\n122|\t}\n123|\treturn parseUint53Literal(literal)\n124|}\n125|\n126|// parseUint53Literal reads a digit-only literal without trusting a\n127|// float conversion: the magnitude bound is checked on the digit\n128|// string, so 2^53 is refused even on platforms that could hold it.\n129|func parseUint53Literal(literal string) (uint64, bool) {\n130|\tif literal == \"\" {\n131|\t\treturn 0, false\n132|\t}\n133|\tvar value uint64\n134|\tfor index := 0; index < len(literal); index++ {\n135|\t\tdigit := literal[index]\n136|\t\tif digit < '0' || digit > '9' {\n137|\t\t\treturn 0, false\n138|\t\t}\n139|\t\tvalue = value*10 + uint64(digit-'0')\n140|\t\tif value > maxUint53 {\n141|\t\t\treturn 0, false\n142|\t\t}\n143|\t}\n144|\treturn value, true\n145|}\n146|\n147|// stringLength is the Section 1.6 string measure in characters, not\n148|// bytes. It delegates to the single environ measure so the two can\n149|// never drift; the delegation battery pins both directions.\n150|func stringLength(value string) int {\n151|\treturn environ.StringLength(value)\n152|}\n153|\n154|// checkStringBounds reports whether the member is a JSON string whose\n155|// character count falls in the inclusive bound. It delegates to the\n156|// environ gate.\n157|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n158|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n159|}\n160|\n161|// checkUint53Bounds reports whether the member is a uint53 in the\n162|// inclusive bound. Both edges are checked: a one-sided check would\n163|// admit the open side. It delegates to the environ gate.\n164|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n165|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n166|}\n167|\n168|// checkDigest reports whether the member is a digest of the pinned\n169|// sha256 form. It delegates to the environ gate.\n170|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n171|\treturn environ.CheckDigest(raw)\n172|}\n173|\n174|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n175|// delegates to the environ gate.\n176|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n177|\treturn environ.CheckUUIDv7(raw)\n178|}\n179|\n180|// checkTimestamp reports whether the member is a pinned timestamp.\n181|// It delegates to the environ gate.\n182|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n183|\treturn environ.CheckTimestamp(raw)\n184|}\n185|\n186|// checkDigestString reports whether the value parses as a digest of\n187|// the pinned form.\n188|func checkDigestString(value string) (string, bool) {\n189|\tdigest, err := scalar.ParseDigest(value)\n190|\tif err != nil {\n191|\t\treturn \"\", false\n192|\t}\n193|\treturn digest.String(), true\n194|}\n195|\n196|// isNull reports whether the member is an explicit JSON null.\n197|func isNull(raw json.RawMessage) bool {\n198|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n199|}\n200|\n201|// decodeArray reads a JSON array member into its raw elements. A\n202|// non-array — including null — is not an empty array.\n203|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n204|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n205|\ttoken, err := decoder.Token()\n206|\tif err != nil {\n207|\t\treturn nil, false\n208|\t}\n209|\tdelim, ok := token.(json.Delim)\n210|\tif !ok || delim != '[' {\n211|\t\treturn nil, false\n212|\t}\n213|\tvar elements []json.RawMessage\n214|\tfor decoder.More() {\n215|\t\tvar element json.RawMessage\n216|\t\tif err := decoder.Decode(&element); err != nil {\n217|\t\t\treturn nil, false\n218|\t\t}\n219|\t\telements = append(elements, element)\n220|\t}\n221|\tif token, err := decoder.Token(); err != nil {\n222|\t\treturn nil, false\n223|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n224|\t\treturn nil, false\n225|\t}\n226|\tif _, err := decoder.Token(); err != io.EOF {\n227|\t\treturn nil, false\n228|\t}\n229|\treturn elements, true\n230|}\n231|\n232|// checkSortedUniqueStrings reports whether the member is an array of\n233|// strings in the item bound whose encodings order strictly\n234|// increasingly with no duplicates, in the count bound. It delegates\n235|// to the environ gate.\n236|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n237|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n238|}\n239|\n240|// checkSortedUniqueDigests reports whether the member is a sorted\n241|// unique digest array in the count bound. It delegates to the\n242|// environ gate.\n243|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n244|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n245|}\n246|\n247|// checkSortedUniqueUUIDv7 reports whether the member is a sorted\n248|// unique UUIDv7 array in the count bound.\n249|func checkSortedUniqueUUIDv7(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.UUIDv7, bool) {\n250|\telements, ok := decodeArray(raw)\n251|\tif !ok {\n252|\t\treturn nil, false\n253|\t}\n254|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n255|\t\treturn nil, false\n256|\t}\n257|\tvalues := make([]scalar.UUIDv7, 0, len(elements))\n258|\tfor _, element := range elements {\n259|\t\tidentifier, ok := checkUUIDv7(element)\n260|\t\tif !ok {\n261|\t\t\treturn nil, false\n262|\t\t}\n263|\t\tvalues = append(values, identifier)\n264|\t}\n265|\tfor index := 1; index < len(values); index++ {\n266|\t\tif values[index-1].String() >= values[index].String() {\n267|\t\t\treturn nil, false\n268|\t\t}\n269|\t}\n270|\treturn values, true\n271|}\n272|\n273|// checkOptionalDigest reads a digest|null member: null is the only\n274|// accepted absence, and any other non-digest is not an absence.\n275|func checkOptionalDigest(raw json.RawMessage) (scalar.Digest, bool, bool) {\n276|\tif isNull(raw) {\n277|\t\treturn scalar.Digest{}, true, true\n278|\t}\n279|\tdigest, ok := checkDigest(raw)\n280|\tif !ok {\n281|\t\treturn scalar.Digest{}, false, false\n282|\t}\n283|\treturn digest, true, false\n284|}\n285|\n286|// checkOptionalString reads a bounded string|null member with the\n287|// same absence rule.\n288|func checkOptionalString(raw json.RawMessage, minimum, maximum int) (string, bool, bool) {\n289|\tif isNull(raw) {\n290|\t\treturn \"\", true, true\n291|\t}\n292|\tvalue, ok := checkStringBounds(raw, minimum, maximum)\n293|\tif !ok {\n294|\t\treturn \"\", false, false\n295|\t}\n296|\treturn value, true, false\n297|}\n298|\n299|// checkSemver reports whether the value is a SemVer string. It\n300|// delegates to the environ grammar so the two can never drift; the\n301|// one-language battery pins the retained copies in both directions.\n302|func checkSemver(value string) bool {\n303|\treturn environ.CheckSemver(value)\n304|}\n305|\n306|// checkEnvironmentID reports whether the value is an environment-id.\n307|// It delegates to the environ grammar.\n308|func checkEnvironmentID(value string) bool {\n309|\treturn environ.CheckEnvironmentID(value)\n310|}\n311|\n312|// checkExtensions reports whether the member is an object whose keys\n313|// are all reverse-DNS names. Values cross opaquely: extensions\n314|// cannot add operations, capabilities, or trust facts, and no member\n315|// of this package reads an extension value for any admission\n316|// decision. It delegates to the environ gate.\n317|func checkExtensions(raw json.RawMessage) bool {\n318|\treturn environ.CheckExtensions(raw)\n319|}\n320|\n321|// checkURI reports whether the value is a URI reference of 1..512\n322|// characters: no whitespace or control characters, with a scheme\n323|// prefix. Contract identifiers in this contract family are URNs, so\n324|// the check requires the colon form rather than accepting any\n325|// relative string.\n326|func checkURI(value string) bool {\n327|\tlength := stringLength(value)\n328|\tif length < 1 || length > 512 {\n329|\t\treturn false\n330|\t}\n331|\tfor _, point := range value {\n332|\t\tif point < 0x21 || point > 0x7E {\n333|\t\t\treturn false\n334|\t\t}\n335|\t}\n336|\tcolon := strings.Index(value, \":\")\n337|\treturn colon > 0\n338|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c53d","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":249,"recorded_at":1780531400000493,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b1f7f3e7c619ba06a2849675eea","text":"Read text file `internal/environ/census_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n15|)\n16|\n17|// This file is the name layer of the shared-implementation\n18|// census. The story's premise is that the Provider, Session\n19|// Adapter, and Directory Node facades sit on one environment\n20|// library; each facade carried its own copy of the shared rules,\n21|// and independent copies of the same rule drift in ways no\n22|// per-facade reviewer can see. This census is the boundary that\n23|// fails when the facades diverge: it derives every shared-rule\n24|// implementation known by identifier from production source and\n25|// requires the derived set to equal the ledger below exactly.\n26|// The shape layer in shape_census_test.go derives implementations\n27|// by implementation texture and catches copies under fresh\n28|// spellings, new byte measures, and var-bound aliases that this\n29|// name layer cannot see; the two layers are complementary by\n30|// construction.\n31|//\n32|// Removing or renaming a ledgered implementation orphans its row\n33|// and fails too. An empty scan fails closed. The ledger records\n34|// the single canonical owner per rule (this package, or scalar\n35|// where the grammar already has one) plus the retained copies;\n36|// each copy names the battery file that pins it to the canonical\n37|// semantics in both directions. The sessadapter and dirnode frame\n38|// decoders are delegating wrappers onto environ.DecodeStrictObject\n39|// (their raw-scan divergence, once ledgered here, was closed by\n40|// delegation and is proven in both directions by the\n41|// frame-agreement battery), and their per-helper Check*,\n42|// stringLength, and grammar copies converged the same way. The\n43|// provhost decoder and surrogate gate stay independent because\n44|// their owning assembly is frozen by the accepted story leaves\n45|// (protocol.go); the canonicaljson gates stay independent\n46|// because the canonicalizer validates any JSON value with its\n47|// own depth, number, and control rules rather than closed\n48|// objects; the scalar gate stays independent because it\n49|// validates a single JSON string scalar rather than a frame.\n50|// Each retained copy carries a bidirectional battery row that\n51|// fails when the two diverge in either direction, and the\n52|// outcome names the freeze or role split behind every one.\n53|//\n54|// Scope. The scan covers the story packages (environ, provider,\n55|// provhost, sessadapter, dirnode) plus the grammar owners\n56|// (scalar, canonicaljson). Copies in config, cliresult,\n57|// terminalbackend, axerror, and the other stories' packages are\n58|// outside this story's ownership: each package derives its own\n59|// inventories in its own test files, and gating another story's\n60|// package from here would couple stories that must land\n61|// independently. That exclusion is a stated bound, not a blind\n62|// spot: the scan fails closed inside its scope, and a copy that\n63|// moves into scope (a new definition in a scanned package)\n64|// fails as unregistered.\n65|\n66|// sharedSite is one derived shared-rule implementation.\n67|type sharedSite struct {\n68|\tclass  string\n69|\tpkg    string\n70|\tfile   string\n71|\tsymbol string\n72|}\n73|\n74|// sharedSiteKey renders the ledger key for one site.\n75|func (site sharedSite) sharedSiteKey() string {\n76|\treturn site.class + \"|\" + site.pkg + \"|\" + site.file + \"|\" + site.symbol\n77|}\n78|\n79|// censusPackages is the exact scan scope. A production file in\n80|// any other package is outside this story's jurisdiction.\n81|var censusPackages = map[string]bool{\n82|\t\"environ\":       true,\n83|\t\"provider\":      true,\n84|\t\"provhost\":      true,\n85|\t\"sessadapter\":   true,\n86|\t\"dirnode\":       true,\n87|\t\"scalar\":        true,\n88|\t\"canonicaljson\": true,\n89|}\n90|\n91|// sharedLedger maps every known shared-rule implementation to\n92|// the rationale that keeps it honest. Canonical owners are the\n93|// single implementation new code must use; every other row names\n94|// the battery file that pins the copy to the canonical\n95|// semantics.\n96|var sharedLedger = map[string]string{\n97|\t// Frame decoders: one JSON entry point per package.\n98|\t\"strict-decoder|environ|decode.go|DecodeStrictObject\":     \"canonical owner: string-walk surrogate semantics, rune measure\",\n99|\t\"strict-decoder|provhost|protocol.go|decodeStrictObject\":  \"pinned by frame_agreement_test.go\",\n100|\t\"strict-decoder|sessadapter|decode.go|decodeStrictObject\": \"delegating wrapper onto environ.DecodeStrictObject, pinned by TestDelegatingWrappersCallEnviron + frame_agreement_test.go\",\n101|\t\"strict-decoder|dirnode|decode.go|decodeStrictObject\":     \"delegating wrapper onto environ.DecodeStrictObject, pinned by TestDelegatingWrappersCallEnviron + frame_agreement_test.go\",\n102|\t\"strict-decoder|canonicaljson|canonical.go|decodeStrict\":  \"canonicalizer entry: distinct JCS pipeline role, surrogate verdicts pinned by frame_agreement_test.go\",\n103|\t// Lone-surrogate gates.\n104|\t\"surrogate-gate|environ|decode.go|HasLoneSurrogateEscape\":            \"canonical owner: string-aware walk\",\n105|\t\"surrogate-gate|provhost|surrogate.go|hasLoneSurrogateEscape\":        \"string-aware walk, pinned by frame_agreement_test.go\",\n106|\t\"surrogate-gate|canonicaljson|canonical.go|validateSurrogateEscapes\": \"canonicalizer gate: string-aware walk, pinned by frame_agreement_test.go\",\n107|\t// String measures.\n108|\t\"string-measure|environ|decode.go|StringLength\":     \"canonical owner: runes per Section 1.6\",\n109|\t\"string-measure|provhost|opdecode.go|runeLength\":    \"runes, pinned by measure_agreement_test.go\",\n110|\t\"string-measure|sessadapter|decode.go|stringLength\": \"delegating wrapper onto environ.StringLength, pinned by TestCheckHelpersDelegateToEnviron + measure_agreement_test.go\",\n111|\t\"string-measure|dirnode|decode.go|stringLength\":     \"delegating wrapper onto environ.StringLength, pinned by TestCheckHelpersDelegateToEnviron + measure_agreement_test.go\",\n112|\t// Identity validators: two refusal dialects over one rule.\n113|\t\"identity-validator|provhost|identity.go|CheckIdentity\":                           \"provider-stdio refusal dialect, pinned by identity_agreement_test.go\",\n114|\t\"identity-validator|canonicaljson|core_records.go|validateProviderIdentityRecord\": \"identity refusal dialect, pinned by identity_agreement_test.go\",\n115|}\n116|\n117|// sharedFunctionSymbols maps a function name to its census\n118|// class.\n119|var sharedFunctionSymbols = map[string]string{\n120|\t\"decodeStrictObject\":             \"strict-decoder\",\n121|\t\"DecodeStrictObject\":             \"strict-decoder\",\n122|\t\"decodeStrict\":                   \"strict-decoder\",\n123|\t\"hasLoneSurrogateEscape\":         \"surrogate-gate\",\n124|\t\"HasLoneSurrogateEscape\":         \"surrogate-gate\",\n125|\t\"validateSurrogateEscapes\":       \"surrogate-gate\",\n126|\t\"stringLength\":                   \"string-measure\",\n127|\t\"runeLength\":                     \"string-measure\",\n128|\t\"StringLength\":                   \"string-measure\",\n129|\t\"CheckIdentity\":                  \"identity-validator\",\n130|\t\"validateProviderIdentityRecord\": \"identity-validator\",\n131|}\n132|\n133|// grammarSymbols maps a package-level variable name to its\n134|// grammar class. Only same-rule grammars share a class: the\n135|// three capabilityOrder tables (directory eight, adapter\n136|// fifteen, provider seven) and the per-major platform tables are\n137|// deliberately absent here and are pinned by literal-list\n138|// derivation in grammar_test.go instead, where the rule identity\n139|// travels with the comparison.\n140|var grammarSymbols = map[string]string{\n141|\t\"environmentIDPattern\": \"env-id-grammar\",\n142|\t\"semverPattern\":        \"semver-grammar\",\n143|\t\"reverseDNSPattern\":    \"extensions-grammar\",\n144|\t\"providerIDPattern\":    \"provider-id-grammar\",\n145|}\n146|\n147|// deriveSharedSites scans every production Go file in the census\n148|// packages for shared-rule implementations. Test files are never\n149|// scanned: a helper in a test is not a production copy. An\n150|// unreadable file or a parse failure fails closed: a scanner that\n151|// cannot read a file must not report the file as clean.\n152|func deriveSharedSites(t *testing.T) map[string]bool {\n153|\tt.Helper()\n154|\tsites := map[string]bool{}\n155|\tfor _, site := range scanSharedSymbols(t, sharedFunctionSymbols, true) {\n156|\t\tsites[site] = true\n157|\t}\n158|\tif len(sites) == 0 {\n159|\t\tt.Fatal(\"census derived zero shared-rule sites from a tree known to duplicate them; the scanner is blind, not the tree clean\")\n160|\t}\n161|\treturn sites\n162|}\n163|\n164|// scanSharedSymbols scans the census packages for function or\n165|// package-level variable definitions whose names appear in the\n166|// symbol map, and returns ledger keys for each hit. Production\n167|// file selection and fail-closed parsing come from invcore: an\n168|// unreadable or unparseable production file fails the suite\n169|// instead of scanning as clean, and a package with zero\n170|// production files fails instead of passing vacuously.\n171|func scanSharedSymbols(t *testing.T, symbols map[string]string, functions bool) []string {\n172|\tt.Helper()\n173|\troot, err := internalRoot(t)\n174|\tif err != nil {\n175|\t\tt.Fatalf(\"census: %v\", err)\n176|\t}\n177|\tpackages := make([]string, 0, len(censusPackages))\n178|\tfor pkg := range censusPackages {\n179|\t\tpackages = append(packages, pkg)\n180|\t}\n181|\tsort.Strings(packages)\n182|\tvar keys []string\n183|\tfor _, pkg := range packages {\n184|\t\tfiles, _ := invcore.MustScanProduction(t, filepath.Join(root, pkg))\n185|\t\tfor _, production := range files {\n186|\t\t\tsyntax, file := production.Syntax, production.Name\n187|\t\t\tfor _, decl := range syntax.Decls {\n188|\t\t\t\tswitch node := decl.(type) {\n189|\t\t\t\tcase *ast.FuncDecl:\n190|\t\t\t\t\tif !functions || node.Name == nil {\n191|\t\t\t\t\t\tcontinue\n192|\t\t\t\t\t}\n193|\t\t\t\t\tif class, ok := symbols[node.Name.Name]; ok {\n194|\t\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, node.Name.Name}.sharedSiteKey())\n195|\t\t\t\t\t}\n196|\t\t\t\tcase *ast.GenDecl:\n197|\t\t\t\t\tif functions {\n198|\t\t\t\t\t\tcontinue\n199|\t\t\t\t\t}\n200|\t\t\t\t\tfor _, spec := range node.Specs {\n201|\t\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n202|\t\t\t\t\t\tif !ok {\n203|\t\t\t\t\t\t\tcontinue\n204|\t\t\t\t\t\t}\n205|\t\t\t\t\t\tfor _, name := range value.Names {\n206|\t\t\t\t\t\t\tif class, ok := symbols[name.Name]; ok {\n207|\t\t\t\t\t\t\t\tkeys = append(keys, sharedSite{class, pkg, file, name.Name}.sharedSiteKey())\n208|\t\t\t\t\t\t\t}\n209|\t\t\t\t\t\t}\n210|\t\t\t\t\t}\n211|\t\t\t\t}\n212|\t\t\t}\n213|\t\t}\n214|\t}\n215|\treturn keys\n216|}\n217|\n218|// internalRoot returns the internal/ source root above this\n219|// package directory.\n220|func internalRoot(t *testing.T) (string, error) {\n221|\tt.Helper()\n222|\tdirectory, err := os.Getwd()\n223|\tif err != nil {\n224|\t\treturn \"\", err\n225|\t}\n226|\treturn filepath.Dir(directory), nil\n227|}\n228|\n229|// TestSharedImplementationsAreCensused requires the derived\n230|// implementation set to equal the ledger exactly: an unregistered\n231|// copy fails as a unification violation, and a row naming an\n232|// implementation production no longer derives fails as orphaned.\n233|// Both directions run through the invcore harness, so a truncated\n234|// derivation fails instead of passing vacuously.\n235|func TestSharedImplementationsAreCensused(t *testing.T) {\n236|\tderived := deriveSharedSites(t)\n237|\trows := make(map[string]struct{}, len(sharedLedger))\n238|\tfor key := range sharedLedger {\n239|\t\trows[key] = struct{}{}\n240|\t}\n241|\tderivedSet := make(map[string]struct{}, len(derived))\n242|\tfor key := range derived {\n243|\t\tderivedSet[key] = struct{}{}\n244|\t}\n245|\tinvcore.MustCheckBothDirections(t, \"shared-rule copy\", derivedSet, rows)\n246|}\n247|\n248|// grammarSiteLedger names every grammar definition site in the\n249|// census scope. A new grammar definition fails here even when it\n250|// carries an identical literal: a second copy is a second copy,\n251|// and the next edit drifts exactly one of them.\n252|// grammarSiteLedger names every grammar definition site in the\n253|// census scope. The sessadapter and dirnode env-id, semver, and\n254|// extensions copies converged onto the environ grammars (their\n255|// check sites call environ.CheckEnvironmentID, environ.CheckSemver,\n256|// and environ.CheckExtensions directly), so their rows are GONE,\n257|// not retained: a revived copy fails here as unregistered. The\n258|// retained copies each name their owner: provider-id is scalar's\n259|// rule everywhere, while the provhost and canonicaljson copies of\n260|// the environ-owned grammars are pinned by the one-language\n261|// battery in both directions.\n262|var grammarSiteLedger = map[string]bool{\n263|\t\"env-id-grammar|environ|tuple.go|environmentIDPattern\":                true,\n264|\t\"env-id-grammar|canonicaljson|closed_shapes.go|environmentIDPattern\":  true,\n265|\t\"semver-grammar|environ|tuple.go|semverPattern\":                       true,\n266|\t\"semver-grammar|canonicaljson|closed_shapes.go|semverPattern\":         true,\n267|\t\"semver-grammar|provhost|manifest.go|semverPattern\":                   true,\n268|\t\"extensions-grammar|environ|decode.go|reverseDNSPattern\":              true,\n269|\t\"extensions-grammar|canonicaljson|closed_shapes.go|reverseDNSPattern\": true,\n270|\t\"provider-id-grammar|scalar|names.go|providerIDPattern\":               true,\n271|\t\"provider-id-grammar|provhost|manifest.go|providerIDPattern\":          true,\n272|\t\"provider-id-grammar|sessadapter|decode.go|providerIDPattern\":         true,\n273|\t\"provider-id-grammar|dirnode|query.go|providerIDPattern\":              true,\n274|}\n275|\n276|// grammarCandidate is one package-level single MustCompile\n277|// definition: the defined symbol and its pattern literal.\n278|type grammarCandidate struct {\n279|\tsymbol  string\n280|\tliteral string\n281|}\n282|\n283|// grammarCandidatesInFile extracts every package-level single\n284|// MustCompile definition from one source file. It is pure over\n285|// its inputs, so the synthetic controls drive this exact\n286|// function on planted sources. Parsing is fail-closed through\n287|// invcore: an unparseable file fails instead of scanning as\n288|// clean.\n289|func grammarCandidatesInFile(path string, source []byte) ([]grammarCandidate, error) {\n290|\tsyntax, _, failure := invcore.ParseBytes(path, source, parser.ParseComments)\n291|\tif failure != \"\" {\n292|\t\treturn nil, errors.New(failure)\n293|\t}\n294|\treturn grammarCandidatesInSyntax(syntax), nil\n295|}\n296|\n297|// grammarCandidatesInSyntax extracts every package-level single\n298|// MustCompile definition from one parsed file. Production\n299|// derivation drives this over invcore-scanned files; the\n300|// synthetic controls reach it through grammarCandidatesInFile,\n301|// so both prove the same extractor.\n302|func grammarCandidatesInSyntax(syntax *ast.File) []grammarCandidate {\n303|\tvar candidates []grammarCandidate\n304|\tfor _, decl := range syntax.Decls {\n305|\t\tnode, ok := decl.(*ast.GenDecl)\n306|\t\tif !ok {\n307|\t\t\tcontinue\n308|\t\t}\n309|\t\tfor _, spec := range node.Specs {\n310|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n311|\t\t\tif !ok || len(value.Names) != 1 || len(value.Values) != 1 {\n312|\t\t\t\tcontinue\n313|\t\t\t}\n314|\t\t\tcall, ok := value.Values[0].(*ast.CallExpr)\n315|\t\t\tif !ok || len(call.Args) != 1 {\n316|\t\t\t\tcontinue\n317|\t\t\t}\n318|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n319|\t\t\tif !ok || selector.Sel.Name != \"MustCompile\" {\n320|\t\t\t\tcontinue\n321|\t\t\t}\n322|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n323|\t\t\tif !ok {\n324|\t\t\t\tcontinue\n325|\t\t\t}\n326|\t\t\ttext, err := strconv.Unquote(literal.Value)\n327|\t\t\tif err != nil {\n328|\t\t\t\tcontinue\n329|\t\t\t}\n330|\t\t\tcandidates = append(candidates, grammarCandidate{symbol: value.Names[0].Name, literal: text})\n331|\t\t}\n332|\t}\n333|\treturn candidates\n334|}\n335|\n336|// deriveGrammarLiterals derives the regex literal behind every\n337|// grammar definition in the census scope, keyed by ledger key.\n338|// Two definitions carrying different literals are different\n339|// languages even when the symbol name matches; the grammar\n340|// battery requires one literal per class. Definitions under a\n341|// fresh name carrying a known class literal derive as fresh\n342|// copies of that class: a second copy is a second copy even\n343|// when the symbol is new.\n344|func deriveGrammarLiterals(t *testing.T) (map[string]map[string]bool, map[string]bool, map[string]bool) {\n345|\tt.Helper()\n346|\troot, err := internalRoot(t)\n347|\tif err != nil {\n348|\t\tt.Fatalf(\"grammar: %v\", err)\n349|\t}\n350|\tliterals := map[string]map[string]bool{}\n351|\tsites := map[string]bool{}\n352|\ttype collectedCandidate struct {\n353|\t\tpkg       string\n354|\t\tfile      string\n355|\t\tcandidate grammarCandidate\n356|\t}\n357|\tvar collected []collectedCandidate\n358|\tpackages := make([]string, 0, len(censusPackages))\n359|\tfor pkg := range censusPackages {\n360|\t\tpackages = append(packages, pkg)\n361|\t}\n362|\tsort.Strings(packages)\n363|\tfor _, pkg := range packages {\n364|\t\tfiles, _ := invcore.MustScanProduction(t, filepath.Join(root, pkg))\n365|\t\tfor _, production := range files {\n366|\t\t\tfor _, candidate := range grammarCandidatesInSyntax(production.Syntax) {\n367|\t\t\t\tcollected = append(collected, collectedCandidate{pkg: pkg, file: production.Name, candidate: candidate})\n368|\t\t\t}\n369|\t\t}\n370|\t}\n371|\tfor _, entry := range collected {\n372|\t\tclass, known := grammarSymbols[entry.candidate.symbol]\n373|\t\tif !known {\n374|\t\t\tcontinue\n375|\t\t}\n376|\t\tif literals[class] == nil {\n377|\t\t\tliterals[class] = map[string]bool{}\n378|\t\t}\n379|\t\tliterals[class][entry.candidate.literal] = true\n380|\t\tsites[sharedSite{class, entry.pkg, entry.file, entry.candidate.symbol}.sharedSiteKey()] = true\n381|\t}\n382|\tknownLiterals := grammarKnownLiterals(literals)\n383|\tfresh := map[string]bool{}\n384|\tfor _, entry := range collected {\n385|\t\tif class, copy := classifyGrammarCandidate(entry.candidate, knownLiterals); copy {\n386|\t\t\tfresh[sharedSite{class, entry.pkg, entry.file, entry.candidate.symbol}.sharedSiteKey()] = true\n387|\t\t}\n388|\t}\n389|\treturn literals, sites, fresh\n390|}\n391|\n392|// grammarKnownLiterals inverts the derived class literals into a\n393|// literal-to-class map. It is pure over the derivation, so the\n394|// synthetic controls classify against the same map production\n395|// uses.\n396|func grammarKnownLiterals(literals map[string]map[string]bool) map[string]string {\n397|\tknown := map[string]string{}\n398|\tfor class, texts := range literals {\n399|\t\tfor text := range texts {\n400|\t\t\tknown[text] = class\n401|\t\t}\n402|\t}\n403|\treturn known\n404|}\n405|\n406|// classifyGrammarCandidate reports whether a MustCompile\n407|// definition is a fresh-name copy of a known class: a symbol\n408|// outside grammarSymbols carrying a known class literal. Named\n409|// definitions and unknown literals are not copies.\n410|func classifyGrammarCandidate(candidate grammarCandidate, known map[string]string) (string, bool) {\n411|\tif _, named := grammarSymbols[candidate.symbol]; named {\n412|\t\treturn \"\", false\n413|\t}\n414|\tclass, match := known[candidate.literal]\n415|\tif !match {\n416|\t\treturn \"\", false\n417|\t}\n418|\treturn class, true\n419|}\n420|\n421|// TestSharedGrammarsAreOneLanguage requires every grammar in the\n422|// census scope to carry the identical regex literal: same symbol\n423|// with different literals would be two languages under one name,\n424|// and a mutant rewriting one copy's literal reddens here.\n425|func TestSharedGrammarsAreOneLanguage(t *testing.T) {\n426|\tliterals, sites, fresh := deriveGrammarLiterals(t)\n427|\tderived := make(map[string]struct{}, len(sites))\n428|\tfor key := range sites {\n429|\t\tderived[key] = struct{}{}\n430|\t}\n431|\trows := make(map[string]struct{}, len(grammarSiteLedger))\n432|\tfor key := range grammarSiteLedger {\n433|\t\trows[key] = struct{}{}\n434|\t}\n435|\tinvcore.MustCheckBothDirections(t, \"grammar copy\", derived, rows)\n436|\tfor key := range fresh {\n437|\t\tt.Errorf(\"unregistered grammar copy under a fresh name %q: a second copy is a second copy even when the symbol is new\", key)\n438|\t}\n439|\tfor class, texts := range literals {\n440|\t\tif len(texts) != 1 {\n441|\t\t\tvar variants []string\n442|\t\t\tfor text := range texts {\n443|\t\t\t\tvariants = append(variants, strconv.Quote(text))\n444|\t\t\t}\n445|\t\t\tt.Errorf(\"grammar class %q has %d distinct literals: %s\", class, len(texts), strings.Join(variants, \" vs \"))\n446|\t\t}\n447|\t}\n448|\tif len(literals) != len(grammarSymbols) {\n449|\t\tt.Fatalf(\"grammar: derived %d classes, want %d; the extractor is blind, not the tree clean\", len(literals), len(grammarSymbols))\n450|\t}\n451|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
