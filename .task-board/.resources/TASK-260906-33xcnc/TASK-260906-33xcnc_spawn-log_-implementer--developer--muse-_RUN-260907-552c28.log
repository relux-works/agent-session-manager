{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd63","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":1292,"recorded_at":1780531400002579,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"4d3561ac-12e8-452c-b279-de6fb4c16b14"},"task_id":"4d3561ac-12e8-452c-b279-de6fb4c16b14","event":{"kind":"output","task_id":"4d3561ac-12e8-452c-b279-de6fb4c16b14","chunk":"Read text file `internal/environ/decode_unit_test.go`.\n(107 line(s) above)\n108|// TestParseUint53LiteralRefusesNonDigits drives the digit\n109|// ladder directly: it is unreachable with hostile input through\n110|// CheckUint53Bounds (the trailing-data arm refuses first), so\n111|// these rows call it with hostile literals itself. A ladder\n112|// that admitted one digit class would pass the bound battery\n113|// and fail exactly here.\n114|func TestParseUint53LiteralRefusesNonDigits(t *testing.T) {\n115|\tfor _, literal := range []string{\"1a2\", \"a\", \"12 \", \" 12\", \"+12\", \"0x10\", \"\"} {\n116|\t\tif value, ok := parseUint53Literal(literal); ok {\n117|\t\t\tt.Fatalf(\"parseUint53Literal(%q) admitted %d, want refusal\", literal, value)\n118|\t\t}\n119|\t}\n120|\tif value, ok := parseUint53Literal(\"1024\"); !ok || value != 1024 {\n121|\t\tt.Fatalf(\"parseUint53Literal(1024) = (%d, %v), want (1024, true)\", value, ok)\n122|\t}\n123|}\n124|\n125|// TestDecodeArrayRefusesTrailingData drives the array reader\n126|// directly: member slices arriving through DecodeStrictObject\n127|// can never carry trailing data, so no facade entry reaches\n128|// this arm with hostile input. A reader that admitted trailing\n129|// data would pass every entry battery and fail exactly here.\n130|func TestDecodeArrayRefusesTrailingData(t *testing.T) {\n131|\tif _, ok := decodeArray(json.RawMessage(`[\"a\"] trailing`)); ok {\n132|\t\tt.Fatal(\"decodeArray admitted trailing data after the array\")\n133|\t}\n134|\tif _, ok := decodeArray(json.RawMessage(`[\"a\"] [\"b\"]`)); ok {\n135|\t\tt.Fatal(\"decodeArray admitted a second value after the array\")\n136|\t}\n137|\telements, ok := decodeArray(json.RawMessage(`[\"a\", \"b\"]`))\n138|\tif !ok || len(elements) != 2 {\n139|\t\tt.Fatalf(\"decodeArray refused a clean array: (%v, %v)\", elements, ok)\n140|\t}\n141|}\n142|\n143|// TestFaultErrorRendersMember drives Fault.Error through the\n144|// production type: memberless faults name only the detail, and\n145|// member faults name both. The rendering is what the facade\n146|// wrappers translate, so both branches are pinned here.\n147|func TestFaultErrorRendersMember(t *testing.T) {\n148|\tbare := (&Fault{Detail: FaultLoneSurrogate}).Error()\n149|\tif !strings.Contains(bare, FaultLoneSurrogate) {\n150|\t\tt.Fatalf(\"memberless fault = %q, want the detail\", bare)\n151|\t}\n152|\tif strings.Contains(bare, \"in member\") {\n153|\t\tt.Fatalf(\"memberless fault = %q, must not name a member\", bare)\n154|\t}\n155|\twithMember := (&Fault{Detail: FaultDuplicate, Member: \"v\"}).Error()\n156|\tif !strings.Contains(withMember, FaultDuplicate) || !strings.Contains(withMember, \"v\") {\n157|\t\tt.Fatalf(\"member fault = %q, want the detail and the member\", withMember)\n158|\t}\n159|}"}}}
