{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c97d","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":793,"recorded_at":1780531400001581,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"0677eed8-1575-4c58-bcac-dc391789a948"},"task_id":"0677eed8-1575-4c58-bcac-dc391789a948","event":{"kind":"output","task_id":"0677eed8-1575-4c58-bcac-dc391789a948","chunk":"Read text file `internal/environ/observation.go`.\n1|package environ\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|)\n8|\n9|// observationSchema is the exact schema identifier the\n10|// Environment Observation carries.\n11|const observationSchema = \"urn:ax:schema:environment-observation\"\n12|\n13|// observationSchemaVersion is the only observation version this\n14|// library accepts.\n15|const observationSchemaVersion = \"1.0.0\"\n16|\n17|// observationMembers is the exact Section 10.8.1 member set.\n18|var observationMembers = map[string]bool{\n19|\t\"schema\":                    true,\n20|\t\"schema_version\":            true,\n21|\t\"observation_id\":            true,\n22|\t\"host_id\":                   true,\n23|\t\"installation_id\":           true,\n24|\t\"environment_id\":            true,\n25|\t\"environment_version\":       true,\n26|\t\"provider_id\":               true,\n27|\t\"platform\":                  true,\n28|\t\"architecture\":              true,\n29|\t\"backend_realm_fingerprint\": true,\n30|\t\"capabilities\":              true,\n31|\t\"authentication_status\":     true,\n32|\t\"runtime_status\":            true,\n33|\t\"observed_at\":               true,\n34|\t\"extensions\":                true,\n35|}\n36|\n37|// observationRequired lists observationMembers in a fixed order so\n38|// a record missing several members always names the same one.\n39|var observationRequired = []string{\n40|\t\"schema\",\n41|\t\"schema_version\",\n42|\t\"observation_id\",\n43|\t\"host_id\",\n44|\t\"installation_id\",\n45|\t\"environment_id\",\n46|\t\"environment_version\",\n47|\t\"provider_id\",\n48|\t\"platform\",\n49|\t\"architecture\",\n50|\t\"backend_realm_fingerprint\",\n51|\t\"capabilities\",\n52|\t\"authentication_status\",\n53|\t\"runtime_status\",\n54|\t\"observed_at\",\n55|\t\"extensions\",\n56|}\n57|\n58|// capabilityOrder is the exact eight-name directory-capability\n59|// registry Section 7.9 states. The observation capabilities map\n60|// carries exactly these keys: a ninth key advertises a surface\n61|// the contract never defined, and a missing key hides one it did.\n62|// Section 10.8.1 reuses this registry rather than creating a\n63|// second capability authority.\n64|var capabilityOrder = []string{\n65|\t\"directory_discovery\",\n66|\t\"directory_incremental_scan\",\n67|\t\"directory_head_digest\",\n68|\t\"directory_tail_preview\",\n69|\t\"native_title_read\",\n70|\t\"native_runtime_observation\",\n71|\t\"existing_session_adoption\",\n72|\t\"native_resume\",\n73|}\n74|\n75|// capabilityStatuses is the closed CapabilityResult status\n76|// vocabulary. Unknown is never rewritten as unsupported, and\n77|// conditional is never advertised as available.\n78|var capabilityStatuses = []string{\n79|\t\"available\",\n80|\t\"conditional\",\n81|\t\"unavailable\",\n82|\t\"unknown\",\n83|}\n84|\n85|// validCapabilityStatus reports whether the status is a registry\n86|// member.\n87|func validCapabilityStatus(status string) bool {\n88|\tfor _, allowed := range capabilityStatuses {\n89|\t\tif status == allowed {\n90|\t\t\treturn true\n91|\t\t}\n92|\t}\n93|\treturn false\n94|}\n95|\n96|// capabilityMembers is the exact CapabilityResult member set.\n97|var capabilityMembers = map[string]bool{\n98|\t\"status\":       true,\n99|\t\"reason_code\":  true,\n100|\t\"evidence_ids\": true,\n101|\t\"observed_at\":  true,\n102|\t\"extensions\":   true,\n103|}\n104|\n105|// capabilityRequired lists capabilityMembers in a fixed order.\n106|var capabilityRequired = []string{\n107|\t\"status\",\n108|\t\"reason_code\",\n109|\t\"evidence_ids\",\n110|\t\"observed_at\",\n111|\t\"extensions\",\n112|}\n113|\n114|// authenticationStatuses is the closed authentication_status\n115|// vocabulary: status only, never credentials.\n116|var authenticationStatuses = []string{\n117|\t\"available\",\n118|\t\"missing\",\n119|\t\"expired\",\n120|\t\"unknown\",\n(more lines below)"}}}
