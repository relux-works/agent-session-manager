{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c671","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":403,"recorded_at":1780531400000801,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"28041999-9253-4bc9-9392-5b2a89f9f885"},"task_id":"28041999-9253-4bc9-9392-5b2a89f9f885","event":{"kind":"output","task_id":"28041999-9253-4bc9-9392-5b2a89f9f885","chunk":"Read text file `internal/environ/refusal_site_audit_test.go`.\n1|package environ\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"flag\"\n8|\t\"fmt\"\n9|\t\"go/ast\"\n10|\t\"go/parser\"\n11|\t\"go/token\"\n12|\t\"os\"\n13|\t\"path/filepath\"\n14|\t\"sort\"\n15|\t\"strconv\"\n16|\t\"strings\"\n17|\t\"testing\"\n18|\n19|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n20|)\n21|\n22|// This file is the refusal-site audit for the environ library.\n23|// Every refusal in this package funnels through the refuse\n24|// constructor var, and every battery witness must resolve to the\n25|// production SITE that refused it — not to a (code, detail) text\n26|// pair a sibling arm could share. Before runtime site recording,\n27|// 62 of 184 arms elsewhere in this repository shared a pair with\n28|// a sibling, so a witness could pass through the wrong arm; this\n29|// audit applies that lesson here in three parts:\n30|//\n31|//  1. Static derivation: every direct refuse() call site is\n32|//     derived from production AST as file:line, with its rule\n33|//     expanded over the frame-fault space for the two\n34|//     passthrough arms. Every call must sit on a single source\n35|//     line so the runtime site and the parsed site agree, and\n36|//     every expanded rule must be unique, which promotes the\n37|//     batteries' full-text assertions to site witnesses.\n38|//  2. Runtime recording: TestMain swaps the refuse var with a\n39|//     recording wrapper, so an aliased call still executes the\n40|//     swapped var and records its real production use site. The\n41|//     driver table below exercises every derived site through\n42|//     the production entries and asserts the recorded rule per\n43|//     vector; the audit requires the exercised site set to\n44|//     equal the derived set in both directions, and the\n45|//     observed rule set to equal the derived rule set exactly.\n46|//  3. Alias audit: every refuse reference outside direct-call\n47|//     position fails, through invcore.AuditConstructorReferences\n48|//     with the funnel's own declaration allowlisted by derived\n49|//     position (a var funnel, unlike a func declaration, needs\n50|//     its position allowlisted explicitly; the plants prove a\n51|//     second binding still fails).\n52|\n53|// refusalRecorder is the shared core's runtime direction: the\n54|// production file:line behind every exercised refusal plus the\n55|// rule strings those refusals carried.\n56|var refusalRecorder = invcore.NewSiteRecorder()\n57|\n58|// TestMain swaps the refuse constructor var with a recording\n59|// wrapper for the whole in-package run, then audits the\n60|// exercised sites against the derived inventory on a full run.\n61|func TestMain(main *testing.M) {\n62|\toriginal := refuse\n63|\trefuse = func(rule, member string) error {\n64|\t\terr := original(rule, member)\n65|\t\trefusalRecorder.Record(rule, 1)\n66|\t\treturn err\n67|\t}\n68|\tcode := main.Run()\n69|\tif code == 0 && fullPackageTestRun() {\n70|\t\tif failures := auditRefusalSites(); len(failures) != 0 {\n71|\t\t\tfor _, failure := range failures {\n72|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n73|\t\t\t}\n74|\t\t\tcode = 1\n75|\t\t}\n76|\t}\n77|\tos.Exit(code)\n78|}\n79|\n80|func fullPackageTestRun() bool {\n81|\tselected := flag.Lookup(\"test.run\")\n82|\treturn selected == nil || selected.Value.String() == \"\"\n83|}\n84|\n85|// refuseSite is one derived refusal site: where it is, what rule\n86|// it emits, and which member it names (\"*\" when dynamic).\n87|type refuseSite struct {\n88|\tfile   string\n89|\tline   int\n90|\trule   string\n91|\tmember string\n92|}\n93|\n94|func (site refuseSite) key() string {\n95|\treturn site.file + \":\" + strconv.Itoa(site.line)\n96|}\n97|\n98|// deriveFaultDetails derives the frame-fault space from decode.go\n99|// production: every Fault* constant value. A sixth fault shape\n100|// fails the audit instead of passing unrostered.\n101|func deriveFaultDetails() (map[string]bool, []string) {\n102|\tdirectory, err := os.Getwd()\n103|\tif err != nil {\n104|\t\treturn nil, []string{\"refusal audit: \" + err.Error()}\n105|\t}\n106|\tpath := filepath.Join(directory, \"decode.go\")\n107|\tsource, err := os.ReadFile(path)\n108|\tif err != nil {\n109|\t\treturn nil, []string{\"refusal audit: read decode.go: \" + err.Error()}\n110|\t}\n111|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n112|\tif err != nil {\n113|\t\treturn nil, []string{\"refusal audit: parse decode.go: \" + err.Error() + \"; an unparseable derivation proves nothing\"}\n114|\t}\n115|\tdetails := map[string]bool{}\n116|\tfor _, decl := range syntax.Decls {\n117|\t\tnode, ok := decl.(*ast.GenDecl)\n118|\t\tif !ok {\n119|\t\t\tcontinue\n120|\t\t}\n121|\t\tfor _, spec := range node.Specs {\n122|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n123|\t\t\tif !ok {\n124|\t\t\t\tcontinue\n125|\t\t\t}\n126|\t\t\tfor index, name := range value.Names {\n127|\t\t\t\tif !strings.HasPrefix(name.Name, \"Fault\") || index >= len(value.Values) {\n128|\t\t\t\t\tcontinue\n129|\t\t\t\t}\n130|\t\t\t\tliteral, ok := value.Values[index].(*ast.BasicLit)\n131|\t\t\t\tif !ok {\n132|\t\t\t\t\treturn nil, []string{\"refusal audit: Fault constant is not a literal; the extractor cannot see through indirection\"}\n133|\t\t\t\t}\n134|\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n135|\t\t\t\tif err != nil {\n136|\t\t\t\t\treturn nil, []string{\"refusal audit: \" + err.Error()}\n137|\t\t\t\t}\n138|\t\t\t\tdetails[text] = true\n139|\t\t\t}\n140|\t\t}\n141|\t}\n142|\tif len(details) == 0 {\n143|\t\treturn nil, []string{\"refusal audit derived zero fault details; the scanner is blind, not the space empty\"}\n144|\t}\n145|\treturn details, nil\n146|}\n147|\n148|// deriveRefuseSites derives every direct refuse() call in the\n149|// environ package as file:line with its expanded rule. The two\n150|// frame-fault passthrough arms expand over the derived fault\n151|// space; every other arm carries literal rule and member. A\n152|// non-literal rule outside the passthrough shape, or a call\n153|// spanning several lines, fails closed.\n154|func deriveRefuseSites(files []invcore.ProductionFile, fileSet *token.FileSet, faults map[string]bool) ([]refuseSite, []string) {\n155|\tvar sites []refuseSite\n156|\tvar failures []string\n157|\tfor _, production := range files {\n158|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n159|\t\t\tcall, ok := node.(*ast.CallExpr)\n160|\t\t\tif !ok {\n161|\t\t\t\treturn true\n162|\t\t\t}\n163|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n164|\t\t\tif !ok || identifier.Name != \"refuse\" || len(call.Args) != 2 {\n165|\t\t\t\treturn true\n166|\t\t\t}\n167|\t\t\tposition := fileSet.Position(identifier.Pos())\n168|\t\t\tif !position.IsValid() {\n169|\t\t\t\tfailures = append(failures, production.Name+\": refuse call at an invalid position\")\n170|\t\t\t\treturn true\n171|\t\t\t}\n172|\t\t\tend := fileSet.Position(call.End())\n173|\t\t\tif end.Line != position.Line {\n174|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse call spans several lines; the runtime site and the parsed site would disagree\")\n175|\t\t\t\treturn true\n176|\t\t\t}\n177|\t\t\tsite := refuseSite{file: production.Name, line: position.Line}\n178|\t\t\tswitch first := call.Args[0].(type) {\n179|\t\t\tcase *ast.BasicLit:\n180|\t\t\t\trule, err := strconv.Unquote(first.Value)\n181|\t\t\t\tif err != nil {\n182|\t\t\t\t\tfailures = append(failures, site.key()+\": refuse rule is not a string literal\")\n183|\t\t\t\t\treturn true\n184|\t\t\t\t}\n185|\t\t\t\tsite.rule = rule\n186|\t\t\t\tif member, ok := call.Args[1].(*ast.BasicLit); ok {\n187|\t\t\t\t\ttext, err := strconv.Unquote(member.Value)\n188|\t\t\t\t\tif err != nil {\n189|\t\t\t\t\t\tfailures = append(failures, site.key()+\": refuse member is not a string literal\")\n190|\t\t\t\t\t\treturn true\n191|\t\t\t\t\t}\n192|\t\t\t\t\tsite.member = text\n193|\t\t\t\t} else {\n194|\t\t\t\t\tsite.member = \"*\"\n195|\t\t\t\t}\n196|\t\t\t\tsites = append(sites, site)\n197|\t\t\tcase *ast.BinaryExpr:\n198|\t\t\t\tprefix, ok := passthroughPrefix(first)\n199|\t\t\t\tif !ok {\n200|\t\t\t\t\tfailures = append(failures, site.key()+\": refuse rule is neither a literal nor a frame-fault passthrough; the extractor cannot see through it\")\n201|\t\t\t\t\treturn true\n202|\t\t\t\t}\n203|\t\t\t\tfor detail := range faults {\n204|\t\t\t\t\texpanded := site\n205|\t\t\t\t\texpanded.rule = prefix + detail\n206|\t\t\t\t\texpanded.member = \"*\"\n207|\t\t\t\t\tsites = append(sites, expanded)\n208|\t\t\t\t}\n209|\t\t\tdefault:\n210|\t\t\t\tfailures = append(failures, site.key()+\": refuse rule is neither a literal nor a frame-fault passthrough; the extractor cannot see through it\")\n211|\t\t\t\treturn true\n212|\t\t\t}\n213|\t\t\treturn true\n214|\t\t})\n215|\t}\n216|\treturn sites, failures\n217|}\n218|\n219|// passthroughPrefix matches `\"tuple \"+fault.Detail` and\n220|// `\"observation \"+fault.Detail` and reports the literal prefix.\n221|func passthroughPrefix(expression *ast.BinaryExpr) (string, bool) {\n222|\tif expression.Op != token.ADD {\n223|\t\treturn \"\", false\n224|\t}\n225|\tliteral, ok := expression.X.(*ast.BasicLit)\n226|\tif !ok || literal.Kind != token.STRING {\n227|\t\treturn \"\", false\n228|\t}\n229|\tprefix, err := strconv.Unquote(literal.Value)\n230|\tif err != nil {\n231|\t\treturn \"\", false\n232|\t}\n233|\tselector, ok := expression.Y.(*ast.SelectorExpr)\n234|\tif !ok || selector.Sel.Name != \"Detail\" {\n235|\t\treturn \"\", false\n236|\t}\n237|\tif identifier, ok := selector.X.(*ast.Ident); !ok || identifier.Name != \"fault\" {\n238|\t\treturn \"\", false\n239|\t}\n240|\treturn prefix, true\n241|}\n242|\n243|// funnelDeclarationPositions derives the positions of the refuse\n244|// funnel's own declaration: a package-level `var refuse = ...`\n245|// binding a function literal. invcore's audit allowlists func\n246|// declarations by position but has no var-funnel rule, so this\n247|// audit allowlists the derived position explicitly; any other\n248|// binding of the name still fails.\n249|func funnelDeclarationPositions(syntax *ast.File) map[token.Pos]bool {\n250|\tpositions := map[token.Pos]bool{}\n251|\tfor _, decl := range syntax.Decls {\n252|\t\tgeneral, ok := decl.(*ast.GenDecl)\n253|\t\tif !ok || general.Tok != token.VAR {\n254|\t\t\tcontinue\n255|\t\t}\n256|\t\tfor _, spec := range general.Specs {\n257|\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n258|\t\t\tif !ok {\n259|\t\t\t\tcontinue\n260|\t\t\t}\n261|\t\t\tfor index, name := range value.Names {\n262|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n263|\t\t\t\t\tcontinue\n264|\t\t\t\t}\n265|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n266|\t\t\t\t\tpositions[name.Pos()] = true\n267|\t\t\t\t}\n268|\t\t\t}\n269|\t\t}\n270|\t}\n271|\treturn positions\n272|}\n273|\n274|// auditRefuseReferences runs the alias audit over one file,\n275|// allowlisting the funnel's own declaration position. Every\n276|// other refuse reference outside direct-call position — an\n277|// aliased, rebound, shadowed, or otherwise indirected use —\n278|// fails.\n279|func auditRefuseReferences(syntax *ast.File, fileSet *token.FileSet, display string) []string {\n280|\tspec := invcore.ConstructorSpec{Local: map[string]bool{\"refuse\": true}}\n281|\tallowed := funnelDeclarationPositions(syntax)\n282|\tvar failures []string\n283|\tfor _, failure := range invcore.AuditConstructorReferences(syntax, fileSet, display, spec) {\n284|\t\tif failureAtFunnelDeclaration(failure, display, fileSet, allowed) {\n285|\t\t\tcontinue\n286|\t\t}\n287|\t\tfailures = append(failures, failure)\n288|\t}\n289|\treturn failures\n290|}\n291|\n292|// failureAtFunnelDeclaration reports whether an audit failure\n293|// names the funnel's own declaration position.\n294|func failureAtFunnelDeclaration(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n295|\tfor position := range allowed {\n296|\t\tlocated := fileSet.Position(position)\n297|\t\tif !located.IsValid() {\n298|\t\t\tcontinue\n299|\t\t}\n300|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n301|\t\tif strings.HasPrefix(failure, prefix) {\n302|\t\t\treturn true\n303|\t\t}\n304|\t}\n305|\treturn false\n306|}\n307|\n308|// auditRefusalSites derives the refusal inventory from package\n309|// source and compares it against the exercised run: derived\n310|// sites without an exercised path and exercised sites outside\n311|// the derivation fail together through the invcore harness, the\n312|// observed rule set must equal the derived rule set exactly,\n313|// every expanded rule must be unique (so a full-text witness\n314|// resolves to exactly one site), and every refuse reference\n315|// outside direct-call position fails.\n316|func auditRefusalSites() []string {\n317|\tdirectory, err := os.Getwd()\n318|\tif err != nil {\n319|\t\treturn []string{\"refusal audit: \" + err.Error()}\n320|\t}\n321|\tfiles, fileSet, failures := invcore.ScanProduction(directory)\n322|\tfor _, failure := range failures {\n323|\t\treturn []string{\"refusal audit: \" + failure}\n324|\t}\n325|\tfaults, faultFailures := deriveFaultDetails()\n326|\tif len(faultFailures) != 0 {\n327|\t\treturn faultFailures\n328|\t}\n329|\tsites, siteFailures := deriveRefuseSites(files, fileSet, faults)\n330|\tfailures = append(failures, siteFailures...)\n331|\tseen := map[string]string{}\n332|\tfor _, site := range sites {\n333|\t\tif first, duplicate := seen[site.rule]; duplicate {\n334|\t\t\tfailures = append(failures, \"refusal audit: rule \"+strconv.Quote(site.rule)+\" is shared by \"+first+\" and \"+site.key()+\"; a witness asserting it resolves to two sites, not one\")\n335|\t\t\tcontinue\n336|\t\t}\n337|\t\tseen[site.rule] = site.key()\n338|\t}\n339|\tderived := map[string]struct{}{}\n340|\trules := map[string]struct{}{}\n341|\tfor _, site := range sites {\n342|\t\tderived[site.key()] = struct{}{}\n343|\t\trules[site.rule] = struct{}{}\n344|\t}\n345|\tvar wantRules []string\n346|\tfor rule := range rules {\n347|\t\twantRules = append(wantRules, rule)\n348|\t}\n349|\tsort.Strings(wantRules)\n350|\tfailures = append(failures, refusalRecorder.AuditSites(\"environ refusals\", len(files), derived, wantRules)...)\n351|\tfor _, production := range files {\n352|\t\tdisplay := production.Name\n353|\t\tfailures = append(failures, auditRefuseReferences(production.Syntax, fileSet, display)...)\n354|\t}\n355|\treturn failures\n356|}\n357|\n358|// auditDigest returns the pinned digest of one seed, mirroring\n359|// the shared battery fixtures without importing them.\n360|func auditDigest(seed string) string {\n361|\tsum := sha256.Sum256([]byte(seed))\n362|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n363|}\n364|\n365|// auditTupleJSON is one valid Environment Tuple over locally\n366|// computed identities.\n367|func auditTupleJSON() []byte {\n368|\treturn []byte(`{\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":` +\n369|\t\tstrconv.Quote(auditDigest(\"test-store-fingerprint\")) + `,\"adapter_version\":\"1.2.3\"}`)\n370|}\n371|\n372|// auditCapabilitiesJSON is the exact eight-name capability map\n373|// with every capability available.\n374|func auditCapabilitiesJSON() string {\n375|\tnames := []string{\n376|\t\t\"directory_discovery\",\n377|\t\t\"directory_incremental_scan\",\n378|\t\t\"directory_head_digest\",\n379|\t\t\"directory_tail_preview\",\n380|\t\t\"native_title_read\",\n381|\t\t\"native_runtime_observation\",\n382|\t\t\"existing_session_adoption\",\n383|\t\t\"native_resume\",\n384|\t}\n385|\tparts := make([]string, 0, len(names))\n386|\tfor _, name := range names {\n387|\t\tparts = append(parts, strconv.Quote(name)+`:`+auditAvailableCapabilityJSON())\n388|\t}\n389|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n390|}\n391|\n392|// auditAvailableCapabilityJSON is one available CapabilityResult\n393|// with null reason.\n394|func auditAvailableCapabilityJSON() string {\n395|\treturn `{\"status\":\"available\",\"reason_code\":null,\"evidence_ids\":[],\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`\n396|}\n397|\n398|// auditObservationJSON is one valid Environment Observation over\n399|// locally computed identities.\n400|func auditObservationJSON() []byte {\n401|\treturn []byte(`{\"schema\":\"urn:ax:schema:environment-observation\",\"schema_version\":\"1.0.0\",\"observation_id\":` +\n402|\t\tstrconv.Quote(auditDigest(\"test-observation\")) + `,\"host_id\":\"0198f4c8-8e50-7f66-8f70-1234567890ab\",\"installation_id\":` +\n403|\t\tstrconv.Quote(auditDigest(\"test-installation\")) + `,\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"provider_id\":\"test-provider\",` +\n404|\t\t`\"platform\":\"linux\",\"architecture\":\"amd64\",\"backend_realm_fingerprint\":` + strconv.Quote(auditDigest(\"test-realm\")) +\n405|\t\t`,\"capabilities\":` + auditCapabilitiesJSON() + `,\"authentication_status\":\"available\",\"runtime_status\":\"available\",` +\n406|\t\t`\"observed_at\":\"2026-08-19T04:05:00.000Z\",\"extensions\":{}}`)\n407|}\n408|\n409|// decodeAuditMembers parses one JSON object into raw member\n410|// texts.\n411|func decodeAuditMembers(body []byte) (map[string]string, error) {\n412|\tvar raw map[string]json.RawMessage\n413|\tif err := json.Unmarshal(body, &raw); err != nil {\n414|\t\treturn nil, err\n415|\t}\n416|\tmembers := make(map[string]string, len(raw))\n417|\tfor name, value := range raw {\n418|\t\tmembers[name] = string(value)\n419|\t}\n420|\treturn members, nil\n421|}\n422|\n423|// encodeAuditMembers renders the member map as one JSON object\n424|// with sorted member names, so the drivers are deterministic.\n425|func encodeAuditMembers(members map[string]string) []byte {\n426|\tnames := make([]string, 0, len(members))\n427|\tfor name := range members {\n428|\t\tnames = append(names, name)\n429|\t}\n430|\tsort.Strings(names)\n431|\tparts := make([]string, 0, len(members))\n432|\tfor _, name := range names {\n433|\t\tparts = append(parts, strconv.Quote(name)+\":\"+members[name])\n434|\t}\n435|\treturn []byte(\"{\" + strings.Join(parts, \",\") + \"}\")\n436|}\n437|\n438|// mutateAuditMember returns the object with one top-level member\n439|// replaced by the given raw JSON.\n440|func mutateAuditMember(t *testing.T, body []byte, member, replacement string) []byte {\n441|\tt.Helper()\n442|\tparsed, err := decodeAuditMembers(body)\n443|\tif err != nil {\n444|\t\tt.Fatalf(\"driver: fixture is not JSON: %v\", err)\n445|\t}\n446|\tparsed[member] = replacement\n447|\treturn encodeAuditMembers(parsed)\n448|}\n449|\n450|// dropAuditMember returns the object without one top-level\n451|// member.\n452|func dropAuditMember(t *testing.T, body []byte, member string) []byte {\n453|\tt.Helper()\n454|\tparsed, err := decodeAuditMembers(body)\n455|\tif err != nil {\n456|\t\tt.Fatalf(\"driver: fixture is not JSON: %v\", err)\n457|\t}\n458|\tdelete(parsed, member)\n459|\treturn encodeAuditMembers(parsed)\n460|}\n461|\n462|// appendAuditMember returns the object with one added top-level\n463|// member.\n464|func appendAuditMember(t *testing.T, body []byte, member, literal string) []byte {\n465|\tt.Helper()\n466|\tparsed, err := decodeAuditMembers(body)\n467|\tif err != nil {\n468|\t\tt.Fatalf(\"driver: fixture is not JSON: %v\", err)\n469|\t}\n470|\tif _, present := parsed[member]; present {\n471|\t\tt.Fatalf(\"driver: %q already present\", member)\n472|\t}\n473|\tparsed[member] = literal\n474|\treturn encodeAuditMembers(parsed)\n475|}\n476|\n477|// refusalDriver is one exercised refusal: the body, the entry\n478|// that must refuse it, and the exact rule the recorder must\n479|// observe behind it.\n480|type refusalDriver struct {\n481|\tname  string\n482|\tbody  []byte\n483|\tdrive func([]byte) error\n484|\trule  string\n485|\t// member is the exact member the refusal must name, or \"\"\n486|\t// when the refusal must name none. Missing-member members\n487|\t// follow the required-list order and single-unknown members\n488|\t// are deterministic, so every expectation here is exact.\n489|\tmember string\n490|}\n491|\n492|// refusalDrivers exercises every derived refuse site through the\n493|// production entries. The frame-fault passthrough arms expand to\n494|// one vector per fault detail; every literal arm owns one\n495|// vector. Each vector asserts the recorded rule, so a witness\n496|// that passed through the wrong arm fails here rather than\n497|// passing on shared text.\n498|func refusalDrivers(t *testing.T) []refusalDriver {\n499|\tt.Helper()\n500|\ttuple := auditTupleJSON()\n(more lines below)"}}}
