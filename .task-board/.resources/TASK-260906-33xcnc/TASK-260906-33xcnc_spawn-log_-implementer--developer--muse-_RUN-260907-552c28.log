{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c889","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":671,"recorded_at":1780531400001337,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"call_id":"call_01a07b212cfb7753bab1c93b8fedcee6","text":"Read text file `internal/provhost/protocol_test.go`.\n(359 line(s) above)\n360|}\n361|\n362|// TestDecodeResponseRefusals proves every unusable frame shape fails with\n363|// provider_protocol_error, never with a partial result. The production\n364|// entry point is DecodeResponse.\n365|func TestDecodeResponseRefusals(t *testing.T) {\n366|\twant := mustUUIDv7(t, testRequestID)\n367|\tokFrame := func(members string) []byte {\n368|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",` + members + `}`)\n369|\t}\n370|\tvalidBody := `{\"provider_id\":\"pi\"}`\n371|\t// Each row names the refusal arm it must reach: the member detail\n372|\t// and the rule detail. A deleted required-member gate slides the\n373|\t// missing member to a lower arm with the same code but a different\n374|\t// member or detail, and the slide reddens here. The malformed\n375|\t// versions below carry a foreign major (\"3\" or empty) so a deleted\n376|\t// parseMajor arm promotes them to incompatible_protocol instead of\n377|\t// collapsing back onto this code. The non-numeric-major rows carry a\n378|\t// numeric rest (\".0.0\") so only the major-digit branch can refuse\n379|\t// them: with a non-numeric rest the rest-digit branch would fire\n380|\t// first and the misclassification would collapse back to this code.\n381|\t// The full five-branch parseMajor enumeration lives in the derived\n382|\t// refusal-arm inventory; these rows are its entry-point witnesses.\n383|\tversionFrame := func(version string) []byte {\n384|\t\treturn []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"` + version + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`)\n385|\t}\n386|\tfor _, kase := range []struct {\n387|\t\tname   string\n388|\t\tframe  []byte\n389|\t\tmember string\n390|\t\tdetail string\n391|\t}{\n392|\t\t{\"empty\", []byte{}, \"\", \"not a JSON object\"},\n393|\t\t{\"not JSON\", []byte(`not json`), \"\", \"not a JSON object\"},\n394|\t\t{\"truncated\", []byte(`{\"protocol\":`), \"protocol\", \"not a JSON object\"},\n395|\t\t{\"array\", []byte(`[1,2]`), \"\", \"not a JSON object\"},\n396|\t\t{\"scalar\", []byte(`true`), \"\", \"not a JSON object\"},\n397|\t\t{\"trailing data\", append(successFrame(t, testRequestID, validBody), 'x'), \"\", \"trailing data after the object\"},\n398|\t\t{\"trailing valid value\", append(successFrame(t, testRequestID, validBody), ' ', '{', '}'), \"\", \"trailing data after the object\"},\n399|\t\t{\"duplicate member\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"request_id\", \"duplicate member\"},\n400|\t\t{\"missing protocol\", []byte(`{\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"missing member\"},\n401|\t\t{\"missing version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"missing member\"},\n402|\t\t{\"missing request id\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"ok\":true,\"body\":{}}`), \"request_id\", \"missing member\"},\n403|\t\t{\"missing ok\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\"}`), \"ok\", \"missing member\"},\n404|\t\t{\"missing body on success\", okFrame(`\"ok\":true`), \"body\", \"missing member\"},\n405|\t\t{\"missing error on failure\", okFrame(`\"ok\":false`), \"error\", \"missing member\"},\n406|\t\t{\"body on failure\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}},\"body\":{}}`), \"body\", \"failure envelope carries body\"},\n407|\t\t{\"error on success\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{},\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"1.0.0\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`), \"error\", \"success envelope carries error\"},\n408|\t\t{\"unknown member\", okFrame(`\"ok\":true,\"body\":{},\"diagnostics\":[]`), \"diagnostics\", \"unknown member\"},\n409|\t\t{\"ok not boolean\", okFrame(`\"ok\":\"yes\",\"body\":{}`), \"ok\", \"member is not a boolean\"},\n410|\t\t{\"wrong protocol\", []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"not a provider envelope\"},\n411|\t\t{\"protocol not string\", []byte(`{\"protocol\":7,\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol\", \"not a provider envelope\"},\n412|\t\t{\"minor version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.1.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n413|\t\t{\"garbage version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"v2\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n414|\t\t{\"short version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n415|\t\t{\"empty version part\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2..0\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n416|\t\t{\"non-numeric version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"a.b.c\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n417|\t\t{\"foreign two-part version\", versionFrame(\"3.0\"), \"protocol_version\", \"unsupported protocol version\"},\n418|\t\t{\"foreign four-part version\", versionFrame(\"3.0.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n419|\t\t{\"foreign empty major\", versionFrame(\".0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n420|\t\t{\"foreign empty minor\", versionFrame(\"3..0\"), \"protocol_version\", \"unsupported protocol version\"},\n421|\t\t{\"foreign non-numeric rest\", versionFrame(\"3.b.c\"), \"protocol_version\", \"unsupported protocol version\"},\n422|\t\t{\"foreign non-numeric major\", versionFrame(\"a.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n423|\t\t{\"foreign alphanumeric major\", versionFrame(\"2a.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n424|\t\t{\"foreign negative major\", versionFrame(\"-1.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n425|\t\t{\"foreign plus major\", versionFrame(\"+3.0.0\"), \"protocol_version\", \"unsupported protocol version\"},\n426|\t\t{\"version not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":2,\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"member is not a string\"},\n427|\t\t{\"empty version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"\",\"request_id\":\"` + testRequestID + `\",\"ok\":true,\"body\":{}}`), \"protocol_version\", \"unsupported protocol version\"},\n428|\t\t{\"request id not string\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":7,\"ok\":true,\"body\":{}}`), \"request_id\", \"member is not a string\"},\n429|\t\t{\"request id not UUIDv7\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"ok\":true,\"body\":{}}`), \"request_id\", \"request_id is not a UUIDv7\"},\n430|\t\t{\"request id mismatch\", successFrame(t, testOtherID, validBody), \"request_id\", \"request_id does not match the request\"},\n431|\t\t{\"body array on success\", okFrame(`\"ok\":true,\"body\":[]`), \"body\", \"body is not a JSON object\"},\n432|\t\t{\"body scalar on success\", okFrame(`\"ok\":true,\"body\":1`), \"body\", \"body is not a JSON object\"},\n433|\t\t{\"error scalar on failure\", okFrame(`\"ok\":false,\"error\":1`), \"error\", \"error is not a JSON object\"},\n434|\t\t{\"error unbound version\", []byte(`{\"protocol\":\"urn:ax:protocol:provider\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + testRequestID + `\",\"ok\":false,\"error\":{\"schema\":\"urn:ax:schema:error\",\"schema_version\":\"9.9.9\",\"code\":\"capability_unavailable\",\"message\":\"m\",\"exit_code\":6,\"retryable\":false,\"details\":{}}}`), \"error\", \"error is not a bound Structured Error 1.0.0\"},\n435|\t} {\n436|\t\tt.Run(kase.name, func(t *testing.T) {\n437|\t\t\t_, err := DecodeResponse(kase.frame, want)\n438|\t\t\trequireFrameRefusal(t, err, kase.member, kase.detail)\n439|\t\t})\n440|\t}\n441|}\n442|\n443|// TestDecodeResponseRefusesOversizeFrame proves the 8 MiB bound from the\n444|// decoding side: a frame one byte over the limit fails without being\n445|// parsed, and a frame exactly at the limit is accepted.\n446|// specFrameLimitBytes is the absolute Section 7.2 bound, stated as a\n447|// literal rather than derived from MaxFrameBytes: the fixtures below pin\n448|// the constant to the specification text, so weakening the constant\n449|// reddens here instead of scaling the fixtures along with it.\n450|const specFrameLimitBytes = 8 << 20\n451|\n452|func TestDecodeResponseRefusesOversizeFrame(t *testing.T) {\n453|\tif MaxFrameBytes != specFrameLimitBytes {\n454|\t\tt.Fatalf(\"MaxFrameBytes = %d, want the specified %d\", MaxFrameBytes, specFrameLimitBytes)\n455|\t}\n456|\twant := mustUUIDv7(t, testRequestID)\n457|\tbuild := func(pad int) []byte {\n458|\t\treturn successFrame(t, testRequestID, `{\"pad\":\"`+strings.Repeat(\"a\", pad)+`\"}`)\n459|\t}\n460|\t// The pad contributes exactly pad bytes, so base+pad is the frame\n461|\t// size. One byte over the limit must fail; exactly at it must pass.\n462|\tbase := len(build(0))\n463|\tover := build(specFrameLimitBytes - base + 1)\n464|\tif len(over) != specFrameLimitBytes+1 {\n465|\t\tt.Fatalf(\"oversize fixture is %d bytes, want exactly %d\", len(over), specFrameLimitBytes+1)\n466|\t}\n467|\t_, err := DecodeResponse(over, want)\n468|\trequireFrameRefusal(t, err, \"\", \"frame exceeds 8 MiB\")\n469|\tframe := build(specFrameLimitBytes - base)\n470|\tif len(frame) != specFrameLimitBytes {\n471|\t\tt.Fatalf(\"boundary fixture is %d bytes, want exactly %d\", len(frame), specFrameLimitBytes)\n472|\t}\n473|\tif _, err := DecodeResponse(frame, want); err != nil {\n474|\t\tt.Fatalf(\"boundary DecodeResponse: %v\", err)\n475|\t}\n476|}\n477|\n478|// TestDecodeResponseRefusesNonUTF8 proves the UTF-8 gate: invalid bytes\n479|// fail even when the surrounding shape would parse.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
