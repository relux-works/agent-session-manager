{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c795","stream":{"kind":"session","id":"01a07b1e-f583-7cc2-a513-9b90d8c833d2"},"sequence":549,"recorded_at":1780531400001093,"record_type":"event","durability":"durable","causation_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8cd64a8a-faf9-439f-ae7d-60151e219433","run_stream":{"kind":"run","id":"8cd64a8a-faf9-439f-ae7d-60151e219433"},"task_stream":{"kind":"task","id":"f7361226-43c0-4848-bdcc-33d391a1bf19"},"task_id":"f7361226-43c0-4848-bdcc-33d391a1bf19","event":{"kind":"output","task_id":"f7361226-43c0-4848-bdcc-33d391a1bf19","chunk":"Read text file `internal/sessadapter/tuple.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates the Environment Tuple and the Supported\n12|// Environment Tuple Registry entry admission Section 7.8 rests on:\n13|// the probe and every state-bearing call carry an exact six-member\n14|// tuple, and target writes and healthy doctor results require an\n15|// accepted non-revoked signed entry whose key equals the\n16|// host-observed execution facts.\n17|//\n18|// The registry publication rules — detached signature, monotonic\n19|// sequence, validity of the registry envelope itself — fail closed\n20|// at the registry owner, which does not exist yet; this package\n21|// admits single entries against caller-held registry facts and\n22|// states that bound in doc.go.\n23|\n24|// tupleMembers is the exact Environment Tuple member set Section 7.8\n25|// requires: environment_id, environment_version, platform,\n26|// architecture, store_schema_fingerprint, and adapter_version. The\n27|// tuple never contains executable provenance, and — unlike every\n28|// neighbouring closed type — it carries no extensions member, so\n29|// even a reverse-DNS extensions object is refused here.\n30|var tupleMembers = map[string]bool{\n31|\t\"environment_id\":           true,\n32|\t\"environment_version\":      true,\n33|\t\"platform\":                 true,\n34|\t\"architecture\":             true,\n35|\t\"store_schema_fingerprint\": true,\n36|\t\"adapter_version\":          true,\n37|}\n38|\n39|// tupleRequired lists tupleMembers in a fixed order.\n40|var tupleRequired = []string{\n41|\t\"environment_id\",\n42|\t\"environment_version\",\n43|\t\"platform\",\n44|\t\"architecture\",\n45|\t\"store_schema_fingerprint\",\n46|\t\"adapter_version\",\n47|}\n48|\n49|// Tuple is one validated Environment Tuple.\n50|type Tuple struct {\n51|\tEnvironmentID    string\n52|\tVersion          string\n53|\tPlatform         string\n54|\tArchitecture     string\n55|\tStoreFingerprint string\n56|\tAdapterVersion   string\n57|}\n58|\n59|// DecodeTuple validates one closed Environment Tuple: exact\n60|// members, the environment-id grammar, environment_version as\n61|// string[1..128] (the bound Section 10.8.1 states for the\n62|// observation that reuses this admission model), the closed\n63|// platform and architecture vocabularies, a digest store\n64|// fingerprint, and a SemVer adapter version. Any executable\n65|// provenance member is an unknown member, never a second identity.\n66|func DecodeTuple(raw json.RawMessage) (Tuple, error) {\n67|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n68|\tif fault != nil {\n69|\t\tfailure, err := failProtocol(\"environment tuple \"+fault.detail, fault.member)\n70|\t\tif err != nil {\n71|\t\t\treturn Tuple{}, err\n72|\t\t}\n73|\t\treturn Tuple{}, failure\n74|\t}\n75|\tif name, unknown := unknownMember(members, tupleMembers); unknown {\n76|\t\tfailure, err := failProtocol(\"environment tuple carries unknown member\", name)\n77|\t\tif err != nil {\n78|\t\t\treturn Tuple{}, err\n79|\t\t}\n80|\t\treturn Tuple{}, failure\n81|\t}\n82|\tif name, missing := missingMember(members, tupleRequired); missing {\n83|\t\tfailure, err := failProtocol(\"environment tuple misses a required member\", name)\n84|\t\tif err != nil {\n85|\t\t\treturn Tuple{}, err\n86|\t\t}\n87|\t\treturn Tuple{}, failure\n88|\t}\n89|\tenvironmentID, ok := rawString(members[\"environment_id\"])\n90|\tif !ok || !environ.CheckEnvironmentID(environmentID) {\n91|\t\tfailure, err := failProtocol(\"environment tuple environment identifier is not an environment-id\", \"environment_id\")\n92|\t\tif err != nil {\n93|\t\t\treturn Tuple{}, err\n94|\t\t}\n95|\t\treturn Tuple{}, failure\n96|\t}\n97|\tversion, ok := checkStringBounds(members[\"environment_version\"], 1, 128)\n98|\tif !ok {\n99|\t\tfailure, err := failProtocol(\"environment tuple environment version is not a string[1..128]\", \"environment_version\")\n100|\t\tif err != nil {\n101|\t\t\treturn Tuple{}, err\n102|\t\t}\n103|\t\treturn Tuple{}, failure\n104|\t}\n105|\tplatform, ok := rawString(members[\"platform\"])\n106|\tif !ok {\n107|\t\tfailure, err := failProtocol(\"environment tuple platform is not a string\", \"platform\")\n108|\t\tif err != nil {\n109|\t\t\treturn Tuple{}, err\n110|\t\t}\n111|\t\treturn Tuple{}, failure\n112|\t}\n113|\tif _, err := scalar.ParsePlatform(platform); err != nil {\n114|\t\tfailure, faultErr := failProtocol(\"environment tuple platform is outside linux|macos|windows|wsl2\", \"platform\")\n115|\t\tif faultErr != nil {\n116|\t\t\treturn Tuple{}, faultErr\n117|\t\t}\n118|\t\treturn Tuple{}, failure\n119|\t}\n120|\tarchitecture, ok := rawString(members[\"architecture\"])\n121|\tif !ok || !validTupleArchitecture(architecture) {\n122|\t\tfailure, err := failProtocol(\"environment tuple architecture is outside amd64|arm64\", \"architecture\")\n123|\t\tif err != nil {\n124|\t\t\treturn Tuple{}, err\n125|\t\t}\n126|\t\treturn Tuple{}, failure\n127|\t}\n128|\tfingerprint, ok := checkDigest(members[\"store_schema_fingerprint\"])\n129|\tif !ok {\n130|\t\tfailure, err := failProtocol(\"environment tuple store fingerprint is not a digest\", \"store_schema_fingerprint\")\n131|\t\tif err != nil {\n132|\t\t\treturn Tuple{}, err\n133|\t\t}\n134|\t\treturn Tuple{}, failure\n135|\t}\n136|\tadapterVersion, ok := rawString(members[\"adapter_version\"])\n137|\tif !ok || !environ.CheckSemver(adapterVersion) {\n138|\t\tfailure, err := failProtocol(\"environment tuple adapter version is not SemVer\", \"adapter_version\")\n139|\t\tif err != nil {\n140|\t\t\treturn Tuple{}, err\n141|\t\t}\n142|\t\treturn Tuple{}, failure\n143|\t}\n144|\treturn Tuple{\n145|\t\tEnvironmentID:    environmentID,\n146|\t\tVersion:          version,\n147|\t\tPlatform:         platform,\n148|\t\tArchitecture:     architecture,\n149|\t\tStoreFingerprint: fingerprint.String(),\n150|\t\tAdapterVersion:   adapterVersion,\n151|\t}, nil\n152|}\n153|\n154|// Direction names one Supported Environment Tuple Registry key\n155|// direction. The registry admits no third direction.\n156|type Direction string\n157|\n158|// The closed direction vocabulary.\n159|const (\n160|\tDirectionSourceRead  Direction = \"source_read\"\n161|\tDirectionTargetWrite Direction = \"target_write\"\n162|)\n163|\n164|// directionNames is the closed direction vocabulary as a table so\n165|// the census derives it like every other closed vocabulary: the\n166|// three direction gates compare through validDirection, never\n167|// through an inline comparison chain the census cannot see. The\n168|// table is built from the constants above, so the two spellings\n169|// cannot drift.\n170|var directionNames = []string{\n171|\tstring(DirectionSourceRead),\n172|\tstring(DirectionTargetWrite),\n173|}\n174|\n175|// validDirection reports whether the name is one of the two closed\n176|// registry directions.\n177|func validDirection(name string) bool {\n178|\tfor _, allowed := range directionNames {\n179|\t\tif name == allowed {\n180|\t\t\treturn true\n181|\t\t}\n182|\t}\n183|\treturn false\n184|}\n185|\n186|// tupleEntryStatuses is the two-status registry-entry vocabulary\n187|// Section 13.14 states: accepted plus revoked. Membership is a\n188|// table loop so the census derives it like every other closed\n189|// vocabulary.\n190|var tupleEntryStatuses = []string{\n191|\t\"accepted\",\n192|\t\"revoked\",\n193|}\n194|\n195|// validTupleEntryStatus reports whether the status is one of the\n196|// two Section 13.14 registry-entry statuses.\n197|func validTupleEntryStatus(status string) bool {\n198|\tfor _, allowed := range tupleEntryStatuses {\n199|\t\tif status == allowed {\n200|\t\t\treturn true\n201|\t\t}\n202|\t}\n203|\treturn false\n204|}\n205|\n206|// evidenceResults is the one-result evidence vocabulary Sections\n207|// 13.14 states for FixtureEvidence and ResumeSmokeEvidence: only\n208|// pass constructs. It is a table despite its single member so the\n209|// census derives it and the spec pin below covers it like every\n210|// other closed vocabulary.\n211|var evidenceResults = []string{\n212|\t\"pass\",\n213|}\n214|\n215|// validEvidenceResult reports whether the result is the single\n216|// Section 13.14 evidence result.\n217|func validEvidenceResult(result string) bool {\n218|\tfor _, allowed := range evidenceResults {\n219|\t\tif result == allowed {\n220|\t\t\treturn true\n221|\t\t}\n222|\t}\n223|\treturn false\n224|}\n225|\n226|// CandidateKind names one registry key candidate kind.\n227|type CandidateKind string\n228|\n229|// The closed candidate-kind vocabulary.\n230|const (\n231|\tCandidateBuiltin  CandidateKind = \"builtin\"\n232|\tCandidateExternal CandidateKind = \"external\"\n233|)\n234|\n235|// candidateKindNames is the closed candidate-kind vocabulary as a\n236|// table so the census derives it like every other closed\n237|// vocabulary: the registry-key gate compares through\n238|// validCandidateKind, never through an inline comparison chain the\n239|// census cannot see. The table is built from the constants above,\n240|// so the two spellings cannot drift.\n241|var candidateKindNames = []string{\n242|\tstring(CandidateBuiltin),\n243|\tstring(CandidateExternal),\n244|}\n245|\n246|// validCandidateKind reports whether the kind is one of the two\n247|// closed registry-key candidate kinds.\n248|func validCandidateKind(kind CandidateKind) bool {\n249|\tfor _, allowed := range candidateKindNames {\n250|\t\tif string(kind) == allowed {\n251|\t\t\treturn true\n252|\t\t}\n253|\t}\n254|\treturn false\n255|}\n256|\n257|// projectionStrategies is the closed five-strategy vocabulary\n258|// Section 13.14 admits: archive_only plus the four target\n259|// projection strategies. Entries carry a sorted unique non-empty\n260|// subset.\n261|var projectionStrategies = []string{\n262|\t\"archive_only\",\n263|\t\"same_environment_native_rewrite\",\n264|\t\"target_native_writer\",\n265|\t\"target_official_import\",\n266|\t\"continuation_context\",\n267|}\n268|\n269|// validStrategy reports whether the name is a registry strategy.\n270|func validStrategy(name string) bool {\n271|\tfor _, strategy := range projectionStrategies {\n272|\t\tif strategy == name {\n273|\t\t\treturn true\n274|\t\t}\n275|\t}\n276|\treturn false\n277|}\n278|\n279|// fidelityDispositions is the closed seven-disposition vocabulary:\n280|// exact, semantic, summarized, opaque_preserved, synthesized,\n281|// omitted, unrecoverable. archive_only is a strategy, never a\n282|// disposition.\n283|var fidelityDispositions = []string{\n284|\t\"exact\",\n285|\t\"semantic\",\n286|\t\"summarized\",\n287|\t\"opaque_preserved\",\n288|\t\"synthesized\",\n289|\t\"omitted\",\n290|\t\"unrecoverable\",\n291|}\n292|\n293|// validDisposition reports whether the name is a fidelity\n294|// disposition.\n295|func validDisposition(name string) bool {\n296|\tfor _, disposition := range fidelityDispositions {\n297|\t\tif disposition == name {\n298|\t\t\treturn true\n299|\t\t}\n300|\t}\n301|\treturn false\n302|}\n303|\n304|// captureClasses is the closed nine-class vocabulary Section 13.14.1\n305|// states for CaptureItem: the classes a capture plan may name. The\n306|// count bound on excluded_classes ([0..9]) is not the vocabulary;\n307|// this list is.\n308|var captureClasses = []string{\n309|\t\"durable_payload\",\n310|\t\"durable_index_required\",\n311|\t\"durable_sidecar\",\n312|\t\"derived_cache_optional\",\n313|\t\"credential\",\n314|\t\"machine_auth\",\n315|\t\"runtime_state\",\n316|\t\"transient_lock\",\n317|\t\"unknown\",\n318|}\n319|\n320|// validCaptureClass reports whether the name is a capture class.\n321|func validCaptureClass(name string) bool {\n322|\tfor _, class := range captureClasses {\n323|\t\tif class == name {\n324|\t\t\treturn true\n325|\t\t}\n326|\t}\n327|\treturn false\n328|}\n329|\n330|// tupleArchitectures is the two-architecture tuple vocabulary\n331|// Section 7.8 states. Membership is a table loop so the census\n332|// derives it like every other closed vocabulary.\n333|var tupleArchitectures = []string{\n334|\t\"amd64\",\n335|\t\"arm64\",\n336|}\n337|\n338|// validTupleArchitecture reports whether the name is one of the two\n339|// tuple architectures Section 7.8 states.\n340|func validTupleArchitecture(architecture string) bool {\n341|\tfor _, allowed := range tupleArchitectures {\n342|\t\tif architecture == allowed {\n343|\t\t\treturn true\n344|\t\t}\n345|\t}\n346|\treturn false\n347|}\n348|\n349|// tupleKeyMembers is the exact SupportedEnvironmentTupleKey member\n350|// set: direction, environment, provider_id, candidate_kind,\n351|// executable_sha256, provider_manifest_digest, and\n352|// session_adapter_manifest_digest. Status is not part of the unique\n353|// key, so accepted and revoked rows cannot coexist — which is why\n354|// status lives on the entry, not here.\n355|var tupleKeyMembers = map[string]bool{\n356|\t\"direction\":                       true,\n357|\t\"environment\":                     true,\n358|\t\"provider_id\":                     true,\n359|\t\"candidate_kind\":                  true,\n360|\t\"executable_sha256\":               true,\n361|\t\"provider_manifest_digest\":        true,\n362|\t\"session_adapter_manifest_digest\": true,\n363|}\n364|\n365|// tupleKeyRequired lists tupleKeyMembers in a fixed order.\n366|var tupleKeyRequired = []string{\n367|\t\"direction\",\n368|\t\"environment\",\n369|\t\"provider_id\",\n370|\t\"candidate_kind\",\n371|\t\"executable_sha256\",\n372|\t\"provider_manifest_digest\",\n373|\t\"session_adapter_manifest_digest\",\n374|}\n375|\n376|// TupleKey is one validated registry key.\n377|type TupleKey struct {\n378|\tDirection              Direction\n379|\tEnvironment            Tuple\n380|\tProviderID             string\n381|\tCandidateKind          CandidateKind\n382|\tExecutableSHA256       string\n383|\tProviderManifestDigest string\n384|\tAdapterManifestDigest  string\n385|}\n386|\n387|// decodeTupleKey validates one closed registry key.\n388|func decodeTupleKey(raw json.RawMessage) (TupleKey, error) {\n389|\tmembers, fault := decodeStrictObject(bytesTrimSpace(raw))\n390|\tif fault != nil {\n391|\t\tfailure, err := failProtocol(\"tuple registry key \"+fault.detail, fault.member)\n392|\t\tif err != nil {\n393|\t\t\treturn TupleKey{}, err\n394|\t\t}\n395|\t\treturn TupleKey{}, failure\n396|\t}\n397|\tif name, unknown := unknownMember(members, tupleKeyMembers); unknown {\n398|\t\tfailure, err := failProtocol(\"tuple registry key carries unknown member\", name)\n399|\t\tif err != nil {\n400|\t\t\treturn TupleKey{}, err\n401|\t\t}\n402|\t\treturn TupleKey{}, failure\n403|\t}\n404|\tif name, missing := missingMember(members, tupleKeyRequired); missing {\n405|\t\tfailure, err := failProtocol(\"tuple registry key misses a required member\", name)\n406|\t\tif err != nil {\n407|\t\t\treturn TupleKey{}, err\n408|\t\t}\n409|\t\treturn TupleKey{}, failure\n410|\t}\n411|\tdirection, ok := rawString(members[\"direction\"])\n412|\tif !ok || !validDirection(direction) {\n413|\t\tfailure, err := failProtocol(\"tuple registry key direction is outside source_read|target_write\", \"direction\")\n414|\t\tif err != nil {\n415|\t\t\treturn TupleKey{}, err\n416|\t\t}\n417|\t\treturn TupleKey{}, failure\n418|\t}\n419|\tenvironment, err := DecodeTuple(members[\"environment\"])\n420|\tif err != nil {\n421|\t\treturn TupleKey{}, err\n422|\t}\n423|\tproviderID, ok := rawString(members[\"provider_id\"])\n424|\tif !ok || !providerIDPattern.MatchString(providerID) {\n425|\t\tfailure, faultErr := failProtocol(\"tuple registry key provider identifier is not a provider-id\", \"provider_id\")\n426|\t\tif faultErr != nil {\n427|\t\t\treturn TupleKey{}, faultErr\n428|\t\t}\n429|\t\treturn TupleKey{}, failure\n430|\t}\n431|\tcandidateKind, ok := rawString(members[\"candidate_kind\"])\n432|\tif !ok || !validCandidateKind(CandidateKind(candidateKind)) {\n433|\t\tfailure, faultErr := failProtocol(\"tuple registry key candidate kind is outside builtin|external\", \"candidate_kind\")\n434|\t\tif faultErr != nil {\n435|\t\t\treturn TupleKey{}, faultErr\n436|\t\t}\n437|\t\treturn TupleKey{}, failure\n438|\t}\n439|\texecutable, ok := checkDigest(members[\"executable_sha256\"])\n440|\tif !ok {\n441|\t\tfailure, faultErr := failProtocol(\"tuple registry key executable digest is not a digest\", \"executable_sha256\")\n442|\t\tif faultErr != nil {\n443|\t\t\treturn TupleKey{}, faultErr\n444|\t\t}\n445|\t\treturn TupleKey{}, failure\n446|\t}\n447|\tproviderManifest, ok := checkDigest(members[\"provider_manifest_digest\"])\n448|\tif !ok {\n449|\t\tfailure, faultErr := failProtocol(\"tuple registry key provider manifest digest is not a digest\", \"provider_manifest_digest\")\n450|\t\tif faultErr != nil {\n451|\t\t\treturn TupleKey{}, faultErr\n452|\t\t}\n453|\t\treturn TupleKey{}, failure\n454|\t}\n455|\tadapterManifest, ok := checkDigest(members[\"session_adapter_manifest_digest\"])\n456|\tif !ok {\n457|\t\tfailure, faultErr := failProtocol(\"tuple registry key adapter manifest digest is not a digest\", \"session_adapter_manifest_digest\")\n458|\t\tif faultErr != nil {\n459|\t\t\treturn TupleKey{}, faultErr\n460|\t\t}\n461|\t\treturn TupleKey{}, failure\n462|\t}\n463|\treturn TupleKey{\n464|\t\tDirection:              Direction(direction),\n465|\t\tEnvironment:            environment,\n466|\t\tProviderID:             providerID,\n467|\t\tCandidateKind:          CandidateKind(candidateKind),\n468|\t\tExecutableSHA256:       executable.String(),\n469|\t\tProviderManifestDigest: providerManifest.String(),\n470|\t\tAdapterManifestDigest:  adapterManifest.String(),\n471|\t}, nil\n472|}\n473|\n474|// tupleEntryMembers is the exact SupportedEnvironmentTupleEntry\n475|// member set.\n476|var tupleEntryMembers = map[string]bool{\n477|\t\"key\":                   true,\n478|\t\"entry_sequence\":        true,\n479|\t\"contracts\":             true,\n480|\t\"strategies\":            true,\n481|\t\"fixture_evidence\":      true,\n482|\t\"resume_smoke_evidence\": true,\n483|\t\"known_fidelity_limits\": true,\n484|\t\"valid_from\":            true,\n485|\t\"valid_until\":           true,\n486|\t\"status\":                true,\n487|\t\"revocation_reason\":     true,\n488|\t\"revoked_at\":            true,\n489|\t\"extensions\":            true,\n490|}\n491|\n492|// tupleEntryRequired lists tupleEntryMembers in a fixed order.\n493|var tupleEntryRequired = []string{\n494|\t\"key\",\n495|\t\"entry_sequence\",\n496|\t\"contracts\",\n497|\t\"strategies\",\n498|\t\"fixture_evidence\",\n499|\t\"resume_smoke_evidence\",\n500|\t\"known_fidelity_limits\",\n(more lines below)"}}}
