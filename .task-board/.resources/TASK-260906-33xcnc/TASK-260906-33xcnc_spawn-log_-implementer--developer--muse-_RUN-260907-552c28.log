\"}\"), drive: observationEntry, rule: \"observation lone surrogate escape\"},\n532|\t\t{name: \"observation non-object\", body: []byte(\"[1,2]\"), drive: observationEntry, rule: \"observation not a JSON object\"},\n533|\t\t{name: \"observation duplicate\", body: []byte(`{\"schema\":\"a\",\"schema\":\"b\"}`), drive: observationEntry, rule: \"observation duplicate member\", member: \"schema\"},\n534|\t\t{name: \"observation trailing\", body: []byte(`{\"schema\":\"a\"} {}`), drive: observationEntry, rule: \"observation trailing data after the object\"},\n535|\t\t{name: \"observation unknown\", body: appendAuditMember(t, observation, \"score\", `1`), drive: observationEntry, rule: \"observation carries unknown member\", member: \"score\"},\n536|\t\t{name: \"observation missing\", body: dropAuditMember(t, observation, \"platform\"), drive: observationEntry, rule: \"observation misses a required member\", member: \"platform\"},\n537|\t\t{name: \"observation schema\", body: mutateObservation(\"schema\", `\"urn:ax:schema:session-adapter-manifest\"`), drive: observationEntry, rule: \"observation schema is not the environment observation\", member: \"schema\"},\n538|\t\t{name: \"observation schema version\", body: mutateObservation(\"schema_version\", `\"2.0.0\"`), drive: observationEntry, rule: \"observation schema version is not 1.0.0\", member: \"schema_version\"},\n539|\t\t{name: \"observation id\", body: mutateObservation(\"observation_id\", badDigest), drive: observationEntry, rule: \"observation identifier is not a digest\", member: \"observation_id\"},\n540|\t\t{name: \"observation host\", body: mutateObservation(\"host_id\", `\"not-a-uuid\"`), drive: observationEntry, rule: \"observation host identifier is not a UUIDv7\", member: \"host_id\"},\n541|\t\t{name: \"observation installation\", body: mutateObservation(\"installation_id\", `\"42\"`), drive: observationEntry, rule: \"observation installation identifier is not a digest\", member: \"installation_id\"},\n542|\t\t{name: \"observation environment id\", body: mutateObservation(\"environment_id\", `\"Test.Env\"`), drive: observationEntry, rule: \"observation environment identifier is not an environment-id\", member: \"environment_id\"},\n543|\t\t{name: \"observation environment version\", body: mutateObservation(\"environment_version\", `\"\"`), drive: observationEntry, rule: \"observation environment version is not a string[1..128]\", member: \"environment_version\"},\n544|\t\t{name: \"observation provider string\", body: mutateObservation(\"provider_id\", `42`), drive: observationEntry, rule: \"observation provider identifier is not a string\", member: \"provider_id\"},\n545|\t\t{name: \"observation provider grammar\", body: mutateObservation(\"provider_id\", `\"Test-Provider\"`), drive: observationEntry, rule: \"observation provider identifier is not a provider-id\", member: \"provider_id\"},\n546|\t\t{name: \"observation platform string\", body: mutateObservation(\"platform\", `42`), drive: observationEntry, rule: \"observation platform is not a string\", member: \"platform\"},\n547|\t\t{name: \"observation platform vocab\", body: mutateObservation(\"platform\", `\"darwin\"`), drive: observationEntry, rule: \"observation platform is outside linux|macos|windows|wsl2\", member: \"platform\"},\n548|\t\t{name: \"observation architecture\", body: mutateObservation(\"architecture\", `\"x86\"`), drive: observationEntry, rule: \"observation architecture is outside amd64|arm64\", member: \"architecture\"},\n549|\t\t{name: \"observation realm\", body: mutateObservation(\"backend_realm_fingerprint\", `\"null\"`), drive: observationEntry, rule: \"observation realm fingerprint is not a digest\", member: \"backend_realm_fingerprint\"},\n550|\t\t{name: \"observation capabilities\", body: mutateObservation(\"capabilities\", `{}`), drive: observationEntry, rule: \"observation capabilities are not the exact eight-name result map\", member: \"capabilities\"},\n551|\t\t{name: \"observation authentication\", body: mutateObservation(\"authentication_status\", `\"signed-in\"`), drive: observationEntry, rule: \"observation authentication status is outside available|missing|expired|unknown\", member: \"authentication_status\"},\n552|\t\t{name: \"observation runtime\", body: mutateObservation(\"runtime_status\", `\"sleeping\"`), drive: observationEntry, rule: \"observation runtime status is outside available|degraded|unavailable\", member: \"runtime_status\"},\n553|\t\t{name: \"observation timestamp\", body: mutateObservation(\"observed_at\", `\"yesterday\"`), drive: observationEntry, rule: \"observation timestamp is not a timestamp\", member: \"observed_at\"},\n554|\t\t{name: \"observation extensions\", body: mutateObservation(\"extensions\", `{\"nodots\":1}`), drive: observationEntry, rule: \"observation extensions are not reverse-DNS keyed\", member: \"extensions\"},\n555|\t}\n556|}\n557|\n558|// TestEveryRefusalSiteIsExercised drives the driver table\n559|// through the production entries and requires each vector to\n560|// refuse with exactly its ledgered rule recorded behind it. The\n561|// TestMain audit compares the exercised site set against the\n562|// derived inventory; this test proves each witness reaches its\n563|// own arm.\n564|func TestEveryRefusalSiteIsExercised(t *testing.T) {\n565|\tfor _, driver := range refusalDrivers(t) {\n566|\t\tt.Run(driver.name, func(t *testing.T) {\n567|\t\t\tbefore := refusalRecorder.Codes()\n568|\t\t\terr := driver.drive(driver.body)\n569|\t\t\tif err == nil {\n570|\t\t\t\tt.Fatalf(\"admitted %s, want rule %q\", driver.body, driver.rule)\n571|\t\t\t}\n572|\t\t\twant := \"environment \" + driver.rule\n573|\t\t\tif driver.member != \"\" {\n574|\t\t\t\twant += \": \" + driver.member\n575|\t\t\t}\n576|\t\t\tif err.Error() != want {\n577|\t\t\t\tt.Fatalf(\"error = %q, want exactly %q\", err.Error(), want)\n578|\t\t\t}\n579|\t\t\tafter := refusalRecorder.Codes()\n580|\t\t\tvar fresh []string\n581|\t\t\tfor _, code := range after {\n582|\t\t\t\tseen := false\n583|\t\t\t\tfor _, old := range before {\n584|\t\t\t\t\tif old == code {\n585|\t\t\t\t\t\tseen = true\n586|\t\t\t\t\t}\n587|\t\t\t\t}\n588|\t\t\t\tif !seen {\n589|\t\t\t\t\tfresh = append(fresh, code)\n590|\t\t\t\t}\n591|\t\t\t}\n592|\t\t\tif len(fresh) != 1 || fresh[0] != driver.rule {\n593|\t\t\t\tt.Fatalf(\"recorded rules = %q, want exactly [%q]\", fresh, driver.rule)\n594|\t\t\t}\n595|\t\t})\n596|\t}\n597|}\n598|\n599|// TestRefuseAliasShapesAreRejected plants the bypass shapes\n600|// against the refuse audit: a rebound var, a shadowed name, and\n601|// a second funnel-shaped declaration alongside an alias. Direct\n602|// calls and the funnel's own declaration stay clean.\n603|func TestRefuseAliasShapesAreRejected(t *testing.T) {\n604|\taudit := func(source string) []string {\n605|\t\tt.Helper()\n606|\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(source))\n607|\t\tif failure != \"\" {\n608|\t\t\tt.Fatalf(\"control does not parse: %s\", failure)\n609|\t\t}\n610|\t\treturn auditRefuseReferences(syntax, fileSet, \"plant.go\")\n611|\t}\n612|\trebound := audit(\"package environ\\nfunc use(member string) error { return reboundRefuse(\\\"rule\\\", member) }\\nvar reboundRefuse = refuse\\nfunc direct(member string) error { return refuse(\\\"rule\\\", member) }\\n\")\n613|\tif len(rebound) == 0 {\n614|\t\tt.Fatal(\"rebound var admitted: the alias bypasses site attribution\")\n615|\t}\n616|\tshadow := audit(\"package environ\\nfunc use(refuse string) string { return refuse }\\n\")\n617|\tif len(shadow) == 0 {\n618|\t\tt.Fatal(\"shadowed constructor name admitted: the audit cannot classify it\")\n619|\t}\n620|\tclean := audit(\"package environ\\nfunc use(member string) error { return refuse(\\\"rule\\\", member) }\\n\")\n621|\tif len(clean) != 0 {\n622|\t\tt.Fatalf(\"direct call reported: %s\", strings.Join(clean, \"; \"))\n623|\t}\n624|\tfunnel := audit(\"package environ\\nimport \\\"fmt\\\"\\nvar refuse = func(rule, member string) error { return fmt.Errorf(rule) }\\nfunc use(member string) error { return refuse(\\\"rule\\\", member) }\\n\")\n625|\tif len(funnel) != 0 {\n626|\t\tt.Fatalf(\"funnel declaration reported: %s\", strings.Join(funnel, \"; \"))\n627|\t}\n628|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
