\"unsorted\", \"2.0.0\", []string{\"2.1.0\", \"2.0.0\"}},\n375|\t\t\t{\"not-semver\", \"2.0.0\", []string{\"v2.0.0\"}},\n376|\t\t\t{\"non-numeric-major\", \"2.0.0\", []string{\"99999999999999999999999.0.0\"}},\n377|\t\t\t{\"empty-string\", \"2.0.0\", []string{\"\"}},\n378|\t\t\t{\"leading-zero\", \"2.0.0\", []string{\"02.0.0\"}},\n379|\t\t\t{\"trailing-space\", \"2.0.0\", []string{\"2.0.0 \"}},\n380|\t\t}\n381|\t\tfor _, tc := range cases {\n382|\t\t\tt.Run(tc.name, func(t *testing.T) {\n383|\t\t\t\tm := profileContracts(t, tc.frame)\n384|\t\t\t\tm[\"rpc\"] = tc.rpc\n385|\t\t\t\thello := directHello(t, m)\n386|\t\t\t\tpeer, err := meshneg.PeerOffer(tc.frame, hello)\n387|\t\t\t\tif peer != 0 {\n388|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) = %d, want refusal\", tc.frame, tc.name, peer)\n389|\t\t\t\t}\n390|\t\t\t\trefusal := asRefusal(t, err)\n391|\t\t\t\tif refusal.Reason != meshneg.ReasonMixedMajor || !errors.Is(err, meshneg.ErrMixedMajor) {\n392|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) reason = %q\", tc.frame, tc.name, refusal.Reason)\n393|\t\t\t\t}\n394|\t\t\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n395|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) class = %s/%d\", tc.frame, tc.name, refusal.Code, refusal.ExitCode)\n396|\t\t\t\t}\n397|\t\t\t})\n398|\t\t}\n399|\t})\n400|\n401|\tt.Run(\"admitted-ranges\", func(t *testing.T) {\n402|\t\t// A v2 minor range stays major 2: minor selection within the\n403|\t\t// common major is a stated bound, not a refusal.\n404|\t\tm := v2(t)\n405|\t\tm[\"rpc\"] = []string{\"2.0.0\", \"2.1.0\"}\n406|\t\tif peer, err := meshneg.PeerOffer(\"2.0.0\", directHello(t, m)); peer != 2 || err != nil {\n407|\t\t\tt.Fatalf(\"PeerOffer(v2 range) = %d, %v, want 2, nil\", peer, err)\n408|\t\t}\n409|\t\tm = v2(t)\n410|\t\tm[\"rpc\"] = []string{\"2.0.0\", \"2.0.0-alpha\"}\n411|\t\tif peer, err := meshneg.PeerOffer(\"2.0.0\", directHello(t, m)); peer != 2 || err != nil {\n412|\t\t\tt.Fatalf(\"PeerOffer(v2 prerelease) = %d, %v, want 2, nil\", peer, err)\n413|\t\t}\n414|\t\tfor _, frame := range []string{\"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n415|\t\t\tpeer, err := meshneg.PeerOffer(frame, directHello(t, profileContracts(t, frame)))\n416|\t\t\tif peer != int(frame[0]-'0') || err != nil {\n417|\t\t\t\tt.Fatalf(\"PeerOffer(%s) = %d, %v\", frame, peer, err)\n418|\t\t\t}\n419|\t\t}\n420|\t})\n421|}\n422|\n423|func TestDecisionShapes(t *testing.T) {\n424|\ttype shape struct {\n425|\t\tkeys       int\n426|\t\tnamespaces []string\n427|\t\terrVersion axerror.Version\n428|\t}\n429|\tsorted := func(names ...string) []string {\n430|\t\tout := slices.Clone(names)\n431|\t\tslices.Sort(out)\n432|\t\treturn out\n433|\t}\n434|\tcore := []string{\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"}\n435|\tshapes := map[string]shape{\n436|\t\t\"2.0.0\": {14, sorted(core...), axerror.Version100},\n437|\t\t\"3.0.0\": {24, sorted(append(slices.Clone(core), \"directory_record\")...), axerror.Version120},\n438|\t\t\"4.0.0\": {25, sorted(append(slices.Clone(core), \"directory_record\", \"terminal_backend_evidence\")...), axerror.Version130},\n439|\t\t\"5.0.0\": {25, sorted(append(slices.Clone(core), \"directory_record\", \"terminal_backend_evidence\")...), axerror.Version130},\n440|\t}\n441|\t// Local generations that admit each frame: config-4 only for 5.0.0,\n442|\t// the newest legacy generation otherwise.\n443|\tconfigFor := map[string]string{\"2.0.0\": \"3.0.0\", \"3.0.0\": \"3.0.0\", \"4.0.0\": \"3.0.0\", \"5.0.0\": \"4.0.0\"}\n444|\tfor _, frame := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n445|\t\tt.Run(frame, func(t *testing.T) {\n446|\t\t\tconfig := configFor[frame]\n447|\t\t\thello := decodedHello(t, frame, profileContracts(t, frame))\n448|\t\t\tdecision, err := meshneg.Negotiate(config, frame, hello)\n449|\t\t\tif err != nil {\n450|\t\t\t\tt.Fatal(err)\n451|\t\t\t}\n452|\t\t\twant := shapes[frame]\n453|\t\t\tif len(decision.Contracts) != want.keys {\n454|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) contracts keys = %d, want %d\", config, frame, len(decision.Contracts), want.keys)\n455|\t\t\t}\n456|\t\t\tprofile, err := rpcwire.ContractProfile(frame)\n457|\t\t\tif err != nil {\n458|\t\t\t\tt.Fatal(err)\n459|\t\t\t}\n460|\t\t\tif !maps.EqualFunc(decision.Contracts, profile, slices.Equal) {\n461|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) contracts differ from the rpcwire profile\", config, frame)\n462|\t\t\t}\n463|\t\t\tif !slices.Equal(decision.Namespaces, want.namespaces) {\n464|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) namespaces = %v, want %v\", config, frame, decision.Namespaces, want.namespaces)\n465|\t\t\t}\n466|\t\t\tif decision.ErrorVersion != want.errVersion {\n467|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) error version = %s, want %s\", config, frame, decision.ErrorVersion, want.errVersion)\n468|\t\t\t}\n469|\t\t\tif decision.ProtocolVersion != frame {\n470|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) protocol version = %s\", config, frame, decision.ProtocolVersion)\n471|\t\t\t}\n472|\t\t\t// RPC 5 carries the exact RPC-4 shapes with only the version\n473|\t\t\t// changed (Section 11.10.1).\n474|\t\t\tif frame == \"5.0.0\" {\n475|\t\t\t\tfour, err := meshneg.Negotiate(\"3.0.0\", \"4.0.0\", decodedHello(t, \"4.0.0\", profileContracts(t, \"4.0.0\")))\n476|\t\t\t\tif err != nil {\n477|\t\t\t\t\tt.Fatal(err)\n478|\t\t\t\t}\n479|\t\t\t\tif !slices.Equal(decision.Namespaces, four.Namespaces) || decision.ErrorVersion != four.ErrorVersion {\n480|\t\t\t\t\tt.Fatal(\"RPC 5 decision diverges from the RPC-4 shapes\")\n481|\t\t\t\t}\n482|\t\t\t\tif len(decision.Contracts) != len(four.Contracts) {\n483|\t\t\t\t\tt.Fatal(\"RPC 5 contracts key count diverges from RPC 4\")\n484|\t\t\t\t}\n485|\t\t\t\tfor key, versions := range four.Contracts {\n486|\t\t\t\t\tgot := decision.Contracts[key]\n487|\t\t\t\t\tif key == \"rpc\" {\n488|\t\t\t\t\t\tif !slices.Equal(got, []string{\"5.0.0\"}) {\n489|\t\t\t\t\t\t\tt.Fatalf(\"RPC 5 rpc contracts = %v\", got)\n490|\t\t\t\t\t\t}\n491|\t\t\t\t\t\tcontinue\n492|\t\t\t\t\t}\n493|\t\t\t\t\tif !slices.Equal(got, versions) {\n494|\t\t\t\t\t\tt.Fatalf(\"RPC 5 contracts[%q] diverges from RPC 4\", key)\n495|\t\t\t\t\t}\n496|\t\t\t\t}\n497|\t\t\t}\n498|\t\t})\n499|\t}\n500|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
