{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c423","stream":{"kind":"session","id":"01a0b081-544e-74f2-a0d1-9b009342eb06"},"sequence":108,"recorded_at":1780531400000211,"record_type":"event","durability":"durable","causation_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","run_stream":{"kind":"run","id":"dae84e08-92bc-496b-b7d3-463fd560ae23"},"task_stream":{"kind":"task","id":"01a0b081-a90d-73c3-bcf7-cace2472e3a3"},"task_id":"01a0b081-a90d-73c3-bcf7-cace2472e3a3","event":{"kind":"output","task_id":"01a0b081-a90d-73c3-bcf7-cace2472e3a3","chunk":"Read text file `internal/meshneg/negotiate.go`.\n1|// Package meshneg selects the single Mesh RPC major spoken on one peer\n2|// connection from the local installation's configuration generation and the\n3|// peer's decoded hello. It frames nothing, opens no connection, performs no\n4|// I/O, keeps no state, and admits no peer: identity equality, allowlist\n5|// membership, and trust generation remain the hostchannel admission boundary\n6|// (TASK-260830-z1yxg9), which negotiation never substitutes.\n7|//\n8|// The package owns the Section 11.2-11.3/11.8/11.9/11.10.1 and Section 17\n9|// selection rules only: highest common major among the locally offered and\n10|// peer offered majors, core-only preservation with explicit unsupported\n11|// directory/backend activation exposure, and no-common-major refusal with the\n12|// pinned Section 15 class. Wire shapes (hello maps, namespaces, operation\n13|// registry), Structured Error bindings, and configuration parsing stay with\n14|// their landed owners (rpcwire, axerror, config); this package derives from\n15|// them and never restates them.\n16|package meshneg\n17|\n18|import (\n19|\t\"errors\"\n20|\t\"fmt\"\n21|\t\"regexp\"\n22|\t\"slices\"\n23|\t\"strconv\"\n24|\t\"strings\"\n25|\n26|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n28|)\n29|\n30|// Pinned RPC framing versions this negotiator can select. A frame carrying\n31|// any other version is not a lower minor of a supported major; Sections\n32|// 11.2-11.10 pin exactly these four, and Section 17.2 rule 1 requires a\n33|// reader to reject an unsupported major rather than coerce it.\n34|var pinnedFrameVersions = map[string]int{\n35|\t\"2.0.0\": 2,\n36|\t\"3.0.0\": 3,\n37|\t\"4.0.0\": 4,\n38|\t\"5.0.0\": 5,\n39|}\n40|\n41|// directoryFeatureMajor is the first RPC major that negotiates directory\n42|// replication (Section 11.8). backendEvidenceFeatureMajor is the first RPC\n43|// major that negotiates TerminalBackend evidence replication (Section 11.9);\n44|// RPC 5 retains the exact RPC-4 shapes (Section 11.10.1).\n45|const (\n46|\tdirectoryFeatureMajor       = 3\n47|\tbackendEvidenceFeatureMajor = 4\n48|)\n49|\n50|// Exposure codes for above-core activation on a negotiated peer. Both are\n51|// registered Section 15.3 codes; neither is minted here.\n52|const (\n53|\t// DirectoryUnsupportedCode is the literal Section 11.8 exposure token:\n54|\t// a node negotiating core-only with a peer reports that peer as\n55|\t// directory_mesh_unsupported, never as zero inventory.\n56|\tDirectoryUnsupportedCode = axerror.Code(\"directory_mesh_unsupported\")\n57|\t// BackendEvidenceUnsupportedCode is the RPC-4 equivalent: Section 11.9\n58|\t// requires reporting TerminalBackend evidence unsupported rather than\n59|\t// empty, and Section 17.4 requires reporting activation unavailable\n60|\t// rather than omitting the session. terminal_backend_unavailable is\n61|\t// the registered exit-6 code that states exactly that.\n62|\tBackendEvidenceUnsupportedCode = axerror.Code(\"terminal_backend_unavailable\")\n63|)\n64|\n65|// RefusalReason names why negotiation selected no major. Automation branches\n66|// on Reason (and Code); Detail is human text only.\n67|type RefusalReason string\n68|\n69|const (\n70|\t// ReasonUnknownConfig reports a local configuration generation outside\n71|\t// 1.0.0-4.0.0. Section 6.6 refuses unknown configuration instead of\n72|\t// selecting legacy.\n73|\tReasonUnknownConfig RefusalReason = \"unknown_config\"\n74|\t// ReasonUnsupportedFrame reports a peer frame version outside the\n75|\t// pinned 2.0.0-5.0.0 vocabulary.\n76|\tReasonUnsupportedFrame RefusalReason = \"unsupported_frame\"\n77|\t// ReasonContractShape reports a peer hello whose contracts map is not\n78|\t// exactly the framing major's pinned profile (missing, extra, or\n79|\t// extension keys, or a wrong rpc array shape).\n80|\tReasonContractShape RefusalReason = \"contract_shape\"\n81|\t// ReasonMixedMajor reports a peer rpc offer that mixes majors or\n82|\t// disagrees with its framing major. Section 17.1 forbids selecting a\n83|\t// major by coercion.\n84|\tReasonMixedMajor RefusalReason = \"mixed_major\"\n85|\t// ReasonNoCommonMajor reports disjoint local and peer major sets.\n86|\tReasonNoCommonMajor RefusalReason = \"no_common_major\"\n87|)\n88|\n89|var (\n90|\t// ErrUnknownConfig is the cause of an unknown-configuration refusal.\n91|\tErrUnknownConfig = errors.New(\"unknown configuration generation\")\n92|\t// ErrUnsupportedFrame is the cause of an unsupported-frame refusal.\n93|\tErrUnsupportedFrame = errors.New(\"unsupported RPC frame version\")\n94|\t// ErrContractShape is the cause of a contract-shape refusal.\n95|\tErrContractShape = errors.New(\"hello contracts differ from the pinned profile\")\n96|\t// ErrMixedMajor is the cause of a mixed-major refusal.\n97|\tErrMixedMajor = errors.New(\"peer rpc offer mixes majors\")\n98|\t// ErrNoCommonMajor is the cause of a no-common-major refusal.\n99|\tErrNoCommonMajor = errors.New(\"no common RPC major\")\n100|)\n101|\n102|// Refusal is the pure-data no-selection outcome. It frames no wire bytes:\n103|// Sections 11.2 and 15.1 close without a peer error frame on an unsupported\n104|// major, and Section 11.10.1 closes without a frame on other RPC majors, so\n105|// the only peer-visible effect is the close itself. The initiator maps Code\n106|// and ExitCode to its own local Structured Error; this value is that mapping\n107|// input, never a forged peer response.\n108|type Refusal struct {\n109|\t// Code and ExitCode are the pinned Section 15 class, resolved from the\n110|\t// axerror registry rather than retyped.\n111|\tCode     axerror.Code\n112|\tExitCode int\n113|\t// Reason names the refusal shape; Detail is human text.\n114|\tReason RefusalReason\n115|\tDetail string\n116|\t// Local carries the majors the local installation offered (empty when\n117|\t// the local generation itself is unknown). Peer carries the peer's\n118|\t// single offered major (zero when the peer offer was unusable).\n119|\tLocal []int\n120|\tPeer  int\n121|\t// Cause is the Go sentinel for errors.Is; it never reaches the wire.\n122|\tCause error\n123|}\n124|\n125|// Error renders the refusal without exposing anything beyond the refusal\n126|// facts. Message text is for humans; automation branches on Code/Reason.\n127|func (refusal *Refusal) Error() string {\n128|\tif refusal == nil {\n129|\t\treturn \"meshneg refusal\"\n130|\t}\n131|\treturn fmt.Sprintf(\"mesh RPC negotiation refused (%s): %s\", refusal.Reason, refusal.Code)\n132|}\n133|\n134|// Unwrap exposes the cause sentinel for errors.Is.\n135|func (refusal *Refusal) Unwrap() error {\n136|\tif refusal == nil {\n137|\t\treturn nil\n138|\t}\n139|\treturn refusal.Cause\n140|}\n141|\n142|// classExit resolves the pinned exit status for a refusal or exposure code\n143|// under the Structured Error version that introduced it. An unregistered\n144|// code or version fails closed: the caller gets an internal error, never a\n145|// guessed exit.\n146|func classExit(version axerror.Version, code axerror.Code) (int, error) {\n147|\treturn axerror.ExitCodeFor(version, code)\n148|}\n149|\n150|// refuse builds a peer-side refusal (incompatible_protocol, exit 6). It is\n151|// used only when incompatibility is actually known from a decoded hello and\n152|// a known local generation, per Section 11.10.1; unframed input never\n153|// reaches this package.\n154|func refuse(reason RefusalReason, cause error, detail string, local []int, peer int) (*Refusal, error) {\n155|\texit, err := classExit(axerror.Version100, axerror.Code(\"incompatible_protocol\"))\n156|\tif err != nil {\n157|\t\treturn nil, err\n158|\t}\n159|\treturn &Refusal{\n160|\t\tCode:     axerror.Code(\"incompatible_protocol\"),\n161|\t\tExitCode: exit,\n162|\t\tReason:   reason,\n163|\t\tDetail:   detail,\n164|\t\tLocal:    append([]int(nil), local...),\n165|\t\tPeer:     peer,\n166|\t\tCause:    cause,\n167|\t}, nil\n168|}\n169|\n170|// LocalMajors maps the local installation's configuration generation\n171|// (config.Configuration.SchemaVersion) to the exact RPC majors that\n172|// installation offers, in ascending order:\n173|//\n174|//   - 1.0.0 offers 2: the base configuration predates the directory and\n175|//     TerminalBackend extensions, so only the Section 11.2-11.3 core.\n176|//   - 2.0.0 offers 2 and 3: the Section 6.4 directory extension pairs with\n177|//     RPC 3 directory replication, and Section 11.8 requires v2 dual-stack.\n178|//   - 3.0.0 offers 2, 3, and 4: the Section 6.5 TerminalBackend extension\n179|//     pairs with RPC 4 evidence replication, and Section 11.9 requires v3\n180|//     dual-stack with preserved v2 interop.\n181|//   - 4.0.0 offers exactly 5: Section 6.6 requires Host Channel 1 and RPC 5\n182|//     for every peer and states that legacy dual-stack obligations never\n183|//     require a Config-4 endpoint to accept legacy.\n184|//\n185|// Any other generation is refused with the invalid_config class (exit 3):\n186|// Section 6.6 makes unknown configuration a refusal, never legacy\n187|// selection. The result is a fresh slice on every call.\n188|func LocalMajors(configVersion string) ([]int, error) {\n189|\tswitch configVersion {\n190|\tcase \"1.0.0\":\n191|\t\treturn []int{2}, nil\n192|\tcase \"2.0.0\":\n193|\t\treturn []int{2, 3}, nil\n194|\tcase \"3.0.0\":\n195|\t\treturn []int{2, 3, 4}, nil\n196|\tcase \"4.0.0\":\n197|\t\treturn []int{5}, nil\n198|\tdefault:\n199|\t\texit, err := classExit(axerror.Version100, axerror.Code(\"invalid_config\"))\n200|\t\tif err != nil {\n201|\t\t\treturn nil, err\n202|\t\t}\n203|\t\treturn nil, &Refusal{\n204|\t\t\tCode:     axerror.Code(\"invalid_config\"),\n205|\t\t\tExitCode: exit,\n206|\t\t\tReason:   ReasonUnknownConfig,\n207|\t\t\tDetail:   fmt.Sprintf(\"configuration generation %q offers no RPC major\", configVersion),\n208|\t\t\tCause:    ErrUnknownConfig,\n209|\t\t}\n210|\t}\n211|}\n212|\n213|// semverMajor parses a strict semantic version and returns its major\n214|// component. The grammar is the same full semver rpcwire enforces on hello\n215|// contract arrays (major.minor.patch with optional prerelease and build\n216|// metadata, no leading zeros, no \"v\" prefix); agreement with rpcwire decode\n217|// is measured by test, not asserted by comment.\n218|var semverMajor = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n219|\n220|func majorOf(version string) (int, error) {\n221|\tmatch := semverMajor.FindStringSubmatch(version)\n222|\tif match == nil {\n223|\t\treturn 0, fmt.Errorf(\"%w: version %q is not strict semver\", ErrMixedMajor, version)\n224|\t}\n225|\tmajor, err := strconv.Atoi(match[1])\n226|\tif err != nil {\n227|\t\treturn 0, fmt.Errorf(\"%w: version %q has no numeric major\", ErrMixedMajor, version)\n228|\t}\n229|\treturn major, nil\n230|}\n231|\n232|// PeerOffer validates the peer's side of the negotiation: the decoded frame\n233|// version plus the decoded hello's contracts map. It returns the peer's\n234|// single offered major. Identity, platform, version, nonce, echo, and limit\n235|// members of the hello are never consulted: negotiation selects a major, it\n236|// does not authenticate, and consulting them here would substitute for the\n237|// admission boundary.\n238|//\n239|// The offer is refused when the frame version is outside the pinned\n240|// vocabulary, when the contracts keys differ from the framing major's exact\n241|// pinned profile (a v2 14-key bound inside a v3+ frame, an extension key, or\n242|// any missing key), when the rpc array is empty or not strictly\n243|// sorted-unique, when any rpc version is not strict semver, or when any rpc\n244|// major differs from the framing major. A v2 frame may carry a 1-16 version\n245|// minor range (Section 11.2); selecting within that range stays a stated\n246|// bound, since this package negotiates majors only.\n247|func PeerOffer(frameVersion string, hello rpcwire.Hello) (int, error) {\n248|\tframing, pinned := pinnedFrameVersions[frameVersion]\n249|\tif !pinned {\n250|\t\trefusal, err := refuse(ReasonUnsupportedFrame, ErrUnsupportedFrame,\n251|\t\t\tfmt.Sprintf(\"frame version %q is outside the pinned 2.0.0-5.0.0 vocabulary\", frameVersion), nil, 0)\n252|\t\tif err != nil {\n253|\t\t\treturn 0, err\n254|\t\t}\n255|\t\treturn 0, refusal\n256|\t}\n257|\tprofile, err := rpcwire.ContractProfile(frameVersion)\n258|\tif err != nil {\n259|\t\treturn 0, err\n260|\t}\n261|\tif len(hello.Contracts) != len(profile) {\n262|\t\treturn 0, shapeRefusal(framing)\n263|\t}\n264|\tfor key := range profile {\n265|\t\tif _, ok := hello.Contracts[key]; !ok {\n266|\t\t\treturn 0, shapeRefusal(framing)\n267|\t\t}\n268|\t}\n269|\toffered := hello.Contracts[\"rpc\"]\n270|\tif len(offered) < 1 || len(offered) > 16 {\n271|\t\treturn 0, shapeRefusal(framing)\n272|\t}\n273|\tfor index, version := range offered {\n274|\t\tmajor, err := majorOf(version)\n275|\t\tif err != nil {\n276|\t\t\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q is not strict semver\", version))\n277|\t\t}\n278|\t\tif major != framing {\n279|\t\t\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q mixes major %d into a major-%d frame\", version, major, framing))\n280|\t\t}\n281|\t\tif index > 0 && offered[index-1] >= version {\n282|\t\t\treturn 0, mixedRefusal(\"rpc versions are not strictly sorted unique\")\n283|\t\t}\n284|\t}\n285|\tif frameVersion != \"2.0.0\" && !slices.Equal(offered, profile[\"rpc\"]) {\n286|\t\treturn 0, shapeRefusal(framing)\n287|\t}\n288|\treturn framing, nil\n289|}\n290|\n291|func shapeRefusal(framing int) error {\n292|\trefusal, err := refuse(ReasonContractShape, ErrContractShape,\n293|\t\tfmt.Sprintf(\"hello contracts do not match the pinned major-%d profile\", framing), nil, 0)\n294|\tif err != nil {\n295|\t\treturn err\n296|\t}\n297|\treturn refusal\n298|}\n299|\n300|func mixedRefusal(detail string) error {\n301|\trefusal, err := refuse(ReasonMixedMajor, ErrMixedMajor, detail, nil, 0)\n302|\tif err != nil {\n303|\t\treturn err\n304|\t}\n305|\treturn refusal\n306|}\n307|\n308|// Select returns the highest major in the intersection of the local and peer\n309|// offer sets. Either set naming a major outside the pinned 2/3/4/5\n310|// vocabulary, an empty set on either side, or a disjoint pair is refused as\n311|// no-common-major: an unmentionable major can never be common, and Section\n312|// 17.1 forbids selecting one by coercion.\n313|func Select(local, peer []int) (int, error) {\n314|\tfor _, major := range local {\n315|\t\tif major < 2 || major > 5 {\n316|\t\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n317|\t\t\t\tfmt.Sprintf(\"local offer names major %d outside the pinned 2/3/4/5 vocabulary\", major), append([]int(nil), local...), 0)\n318|\t\t\tif err != nil {\n319|\t\t\t\treturn 0, err\n320|\t\t\t}\n321|\t\t\treturn 0, refusal\n322|\t\t}\n323|\t}\n324|\tfor _, major := range peer {\n325|\t\tif major < 2 || major > 5 {\n326|\t\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n327|\t\t\t\tfmt.Sprintf(\"peer offer names major %d outside the pinned 2/3/4/5 vocabulary\", major), append([]int(nil), local...), 0)\n328|\t\t\tif err != nil {\n329|\t\t\t\treturn 0, err\n330|\t\t\t}\n331|\t\t\treturn 0, refusal\n332|\t\t}\n333|\t}\n334|\tbest := 0\n335|\tfor _, candidate := range local {\n336|\t\tif slices.Contains(peer, candidate) && candidate > best {\n337|\t\t\tbest = candidate\n338|\t\t}\n339|\t}\n340|\tif best == 0 {\n341|\t\tpeerMajor := 0\n342|\t\tif len(peer) == 1 {\n343|\t\t\tpeerMajor = peer[0]\n344|\t\t}\n345|\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n346|\t\t\t\"local and peer offers share no major (\"+joinMajors(local)+\" against \"+joinMajors(peer)+\")\",\n347|\t\t\tappend([]int(nil), local...), peerMajor)\n348|\t\tif err != nil {\n349|\t\t\treturn 0, err\n350|\t\t}\n351|\t\treturn 0, refusal\n352|\t}\n353|\treturn best, nil\n354|}\n355|\n356|func joinMajors(majors []int) string {\n357|\tparts := make([]string, 0, len(majors))\n358|\tfor _, major := range majors {\n359|\t\tparts = append(parts, strconv.Itoa(major))\n360|\t}\n361|\treturn \"[\" + strings.Join(parts, \" \") + \"]\"\n362|}\n363|\n364|// FeatureActivation reports how one above-core feature is exposed for the\n365|// negotiated peer. It carries no inventory counts, no object IDs, and no\n366|// capability advertisement: Negotiated states the outcome of this selection,\n367|// and Code names the registered exposure code only when the feature was not\n368|// negotiated, so a core-only peer can never be mistaken for an empty one.\n369|type FeatureActivation struct {\n370|\t// Feature is \"directory\" or \"terminal_backend_evidence\".\n371|\tFeature string\n372|\t// Negotiated is true exactly when the selected major carries the\n373|\t// feature (directory at 3+, backend evidence at 4+).\n374|\tNegotiated bool\n375|\t// Code is empty when negotiated; otherwise the registered exposure\n376|\t// code with ExitCode 6.\n377|\tCode     axerror.Code\n378|\tExitCode int\n379|}\n380|\n381|// PeerView is the local node's exposure of the negotiated peer: which\n382|// above-core activations the selection carries and which it reports\n383|// unsupported. Core sync itself is the negotiated major, not a member here.\n384|type PeerView struct {\n385|\tDirectory       FeatureActivation\n386|\tBackendEvidence FeatureActivation\n387|}\n388|\n389|// Decision is the pure-data selection outcome: exactly one common major\n390|// plus the shapes bound to it. Contracts and Namespaces are rebuilt from\n391|// the pinned profile for the selected major, never copied from peer bytes,\n392|// so a malformed peer array cannot propagate past selection.\n393|type Decision struct {\n394|\tMajor           int\n395|\tProtocolVersion string\n396|\tContracts       map[string][]string\n397|\tNamespaces      []string\n398|\tErrorVersion    axerror.Version\n399|\tPeer            PeerView\n400|}\n401|\n402|func exposure(feature string, negotiated bool, code axerror.Code, introduced axerror.Version) (FeatureActivation, error) {\n403|\tactivation := FeatureActivation{Feature: feature, Negotiated: negotiated}\n404|\tif negotiated {\n405|\t\treturn activation, nil\n406|\t}\n407|\texit, err := classExit(introduced, code)\n408|\tif err != nil {\n409|\t\treturn FeatureActivation{}, err\n410|\t}\n411|\tactivation.Code = code\n412|\tactivation.ExitCode = exit\n413|\treturn activation, nil\n414|}\n415|\n416|func decisionFor(major int) (Decision, error) {\n417|\tversion := fmt.Sprintf(\"%d.0.0\", major)\n418|\tcontracts, err := rpcwire.ContractProfile(version)\n419|\tif err != nil {\n420|\t\treturn Decision{}, err\n421|\t}\n422|\tnamespaces, err := rpcwire.Namespaces(version)\n423|\tif err != nil {\n424|\t\treturn Decision{}, err\n425|\t}\n426|\tbound, err := axerror.BindingFor(axerror.ContainingContract{ID: \"urn:ax:protocol:rpc\", Major: major})\n427|\tif err != nil {\n428|\t\treturn Decision{}, err\n429|\t}\n430|\tdirectory, err := exposure(\"directory\", major >= directoryFeatureMajor, DirectoryUnsupportedCode, axerror.Version120)\n431|\tif err != nil {\n432|\t\treturn Decision{}, err\n433|\t}\n434|\tbackend, err := exposure(\"terminal_backend_evidence\", major >= backendEvidenceFeatureMajor, BackendEvidenceUnsupportedCode, axerror.Version130)\n435|\tif err != nil {\n436|\t\treturn Decision{}, err\n437|\t}\n438|\treturn Decision{\n439|\t\tMajor:           major,\n440|\t\tProtocolVersion: version,\n441|\t\tContracts:       contracts,\n442|\t\tNamespaces:      namespaces,\n443|\t\tErrorVersion:    bound,\n444|\t\tPeer:            PeerView{Directory: directory, BackendEvidence: backend},\n445|\t}, nil\n446|}\n447|\n448|// Negotiate selects exactly one common Mesh RPC major for the local\n449|// configuration generation and the peer's decoded hello frame. configVersion\n450|// is the local config.Configuration.SchemaVersion; frameVersion is the\n451|// decoded envelope's protocol_version; hello is the decoded hello body.\n452|//\n453|// On success it returns the Decision for the highest common major. On\n454|// refusal it returns a *Refusal carrying the pinned Section 15 class:\n455|// incompatible_protocol with exit 6 when the decoded inputs prove the\n456|// majors are disjoint or the peer offer is malformed, or invalid_config\n457|// with exit 3 when the local generation is unknown. Any other error is an\n458|// internal registry inconsistency, never a peer verdict.\n459|//\n460|// Negotiate consults only the configuration generation, the frame version,\n461|// and the hello contracts map. It reads no environment, no argv, no raw\n462|// frame bytes, no extension member, and no prior-handshake state, so none\n463|// of those can select a fallback (Section 6.6). It performs no admission:\n464|// the hello identity, allowlist, and trust generation must still pass the\n465|// hostchannel boundary before any dispatch.\n466|func Negotiate(configVersion, frameVersion string, hello rpcwire.Hello) (Decision, error) {\n467|\tlocal, err := LocalMajors(configVersion)\n468|\tif err != nil {\n469|\t\treturn Decision{}, err\n470|\t}\n471|\tpeer, err := PeerOffer(frameVersion, hello)\n472|\tif err != nil {\n473|\t\tif refusal, ok := err.(*Refusal); ok {\n474|\t\t\trefusal.Local = append([]int(nil), local...)\n475|\t\t\treturn Decision{}, refusal\n476|\t\t}\n477|\t\treturn Decision{}, err\n478|\t}\n479|\tmajor, err := Select(local, []int{peer})\n480|\tif err != nil {\n481|\t\treturn Decision{}, err\n482|\t}\n483|\treturn decisionFor(major)\n484|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c425","stream":{"kind":"session","id":"01a0b081-544e-74f2-a0d1-9b009342eb06"},"sequence":109,"recorded_at":1780531400000213,"record_type":"event","durability":"durable","causation_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","run_stream":{"kind":"run","id":"dae84e08-92bc-496b-b7d3-463fd560ae23"},"task_stream":{"kind":"task","id":"01a0b081-a90d-73c3-bcf7-cace2472e3a3"},"task_id":"01a0b081-a90d-73c3-bcf7-cace2472e3a3","event":{"kind":"completed","task_id":"01a0b081-a90d-73c3-bcf7-cace2472e3a3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c427","stream":{"kind":"session","id":"01a0b081-544e-74f2-a0d1-9b009342eb06"},"sequence":110,"recorded_at":1780531400000215,"record_type":"event","durability":"durable","causation_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","run_stream":{"kind":"run","id":"dae84e08-92bc-496b-b7d3-463fd560ae23"},"call_id":"call_01a0b081a32c75f98944aadd05dd8ded","text":"{\n  \"chunk_id\": \"exec-4-1\",\n  \"command\": \"task-board --help 2>&1 | head -n 60\\necho \\\"====\\\"; task-board m --help 2>&1 | head -n 40\",\n  \"description\": \"Explore task-board CLI\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  init                   Install task-board project integrations\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n====\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  integrate_external(ID, evidence=...)     Close accepted empty-delta external work by evidence (local board only)\\n  withdraw_cr(ID, revision=N, reason=...) Retire an unintegrated revision (local board only)\\n  defer_cr(ID, revision=N, reason=...)    Mark an accepted revision deferred by human decision (local board only)\\n  undefer_cr(ID, revision=N)              Clear the deferral marker (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\nAuth (always local):\\n  login(user=..., token=...)           Store token in credentials file\\n  logout()                             Remove active user's token\\n  switch_user(user=...)                Switch active user for remote\\n\\nSafety:\\n\",\n  \"original_output_bytes\": 5565,\n  \"original_output_tokens\": 1392,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c429","stream":{"kind":"session","id":"01a0b081-544e-74f2-a0d1-9b009342eb06"},"sequence":111,"recorded_at":1780531400000217,"record_type":"event","durability":"durable","causation_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","run_stream":{"kind":"run","id":"dae84e08-92bc-496b-b7d3-463fd560ae23"},"call_id":"call_01a0b081a68077df8046eae66c63e387","text":"Read text file `internal/meshneg/negotiate.go`.\n1|// Package meshneg selects the single Mesh RPC major spoken on one peer\n2|// connection from the local installation's configuration generation and the\n3|// peer's decoded hello. It frames nothing, opens no connection, performs no\n4|// I/O, keeps no state, and admits no peer: identity equality, allowlist\n5|// membership, and trust generation remain the hostchannel admission boundary\n6|// (TASK-260830-z1yxg9), which negotiation never substitutes.\n7|//\n8|// The package owns the Section 11.2-11.3/11.8/11.9/11.10.1 and Section 17\n9|// selection rules only: highest common major among the locally offered and\n10|// peer offered majors, core-only preservation with explicit unsupported\n11|// directory/backend activation exposure, and no-common-major refusal with the\n12|// pinned Section 15 class. Wire shapes (hello maps, namespaces, operation\n13|// registry), Structured Error bindings, and configuration parsing stay with\n14|// their landed owners (rpcwire, axerror, config); this package derives from\n15|// them and never restates them.\n16|package meshneg\n17|\n18|import (\n19|\t\"errors\"\n20|\t\"fmt\"\n21|\t\"regexp\"\n22|\t\"slices\"\n23|\t\"strconv\"\n24|\t\"strings\"\n25|\n26|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n28|)\n29|\n30|// Pinned RPC framing versions this negotiator can select. A frame carrying\n31|// any other version is not a lower minor of a supported major; Sections\n32|// 11.2-11.10 pin exactly these four, and Section 17.2 rule 1 requires a\n33|// reader to reject an unsupported major rather than coerce it.\n34|var pinnedFrameVersions = map[string]int{\n35|\t\"2.0.0\": 2,\n36|\t\"3.0.0\": 3,\n37|\t\"4.0.0\": 4,\n38|\t\"5.0.0\": 5,\n39|}\n40|\n41|// directoryFeatureMajor is the first RPC major that negotiates directory\n42|// replication (Section 11.8). backendEvidenceFeatureMajor is the first RPC\n43|// major that negotiates TerminalBackend evidence replication (Section 11.9);\n44|// RPC 5 retains the exact RPC-4 shapes (Section 11.10.1).\n45|const (\n46|\tdirectoryFeatureMajor       = 3\n47|\tbackendEvidenceFeatureMajor = 4\n48|)\n49|\n50|// Exposure codes for above-core activation on a negotiated peer. Both are\n51|// registered Section 15.3 codes; neither is minted here.\n52|const (\n53|\t// DirectoryUnsupportedCode is the literal Section 11.8 exposure token:\n54|\t// a node negotiating core-only with a peer reports that peer as\n55|\t// directory_mesh_unsupported, never as zero inventory.\n56|\tDirectoryUnsupportedCode = axerror.Code(\"directory_mesh_unsupported\")\n57|\t// BackendEvidenceUnsupportedCode is the RPC-4 equivalent: Section 11.9\n58|\t// requires reporting TerminalBackend evidence unsupported rather than\n59|\t// empty, and Section 17.4 requires reporting activation unavailable\n60|\t// rather than omitting the session. terminal_backend_unavailable is\n61|\t// the registered exit-6 code that states exactly that.\n62|\tBackendEvidenceUnsupportedCode = axerror.Code(\"terminal_backend_unavailable\")\n63|)\n64|\n65|// RefusalReason names why negotiation selected no major. Automation branches\n66|// on Reason (and Code); Detail is human text only.\n67|type RefusalReason string\n68|\n69|const (\n70|\t// ReasonUnknownConfig reports a local configuration generation outside\n71|\t// 1.0.0-4.0.0. Section 6.6 refuses unknown configuration instead of\n72|\t// selecting legacy.\n73|\tReasonUnknownConfig RefusalReason = \"unknown_config\"\n74|\t// ReasonUnsupportedFrame reports a peer frame version outside the\n75|\t// pinned 2.0.0-5.0.0 vocabulary.\n76|\tReasonUnsupportedFrame RefusalReason = \"unsupported_frame\"\n77|\t// ReasonContractShape reports a peer hello whose contracts map is not\n78|\t// exactly the framing major's pinned profile (missing, extra, or\n79|\t// extension keys, or a wrong rpc array shape).\n80|\tReasonContractShape RefusalReason = \"contract_shape\"\n81|\t// ReasonMixedMajor reports a peer rpc offer that mixes majors or\n82|\t// disagrees with its framing major. Section 17.1 forbids selecting a\n83|\t// major by coercion.\n84|\tReasonMixedMajor RefusalReason = \"mixed_major\"\n85|\t// ReasonNoCommonMajor reports disjoint local and peer major sets.\n86|\tReasonNoCommonMajor RefusalReason = \"no_common_major\"\n87|)\n88|\n89|var (\n90|\t// ErrUnknownConfig is the cause of an unknown-configuration refusal.\n91|\tErrUnknownConfig = errors.New(\"unknown configuration generation\")\n92|\t// ErrUnsupportedFrame is the cause of an unsupported-frame refusal.\n93|\tErrUnsupportedFrame = errors.New(\"unsupported RPC frame version\")\n94|\t// ErrContractShape is the cause of a contract-shape refusal.\n95|\tErrContractShape = errors.New(\"hello contracts differ from the pinned profile\")\n96|\t// ErrMixedMajor is the cause of a mixed-major refusal.\n97|\tErrMixedMajor = errors.New(\"peer rpc offer mixes majors\")\n98|\t// ErrNoCommonMajor is the cause of a no-common-major refusal.\n99|\tErrNoCommonMajor = errors.New(\"no common RPC major\")\n100|)\n101|\n102|// Refusal is the pure-data no-selection outcome. It frames no wire bytes:\n103|// Sections 11.2 and 15.1 close without a peer error frame on an unsupported\n104|// major, and Section 11.10.1 closes without a frame on other RPC majors, so\n105|// the only peer-visible effect is the close itself. The initiator maps Code\n106|// and ExitCode to its own local Structured Error; this value is that mapping\n107|// input, never a forged peer response.\n108|type Refusal struct {\n109|\t// Code and ExitCode are the pinned Section 15 class, resolved from the\n110|\t// axerror registry rather than retyped.\n111|\tCode     axerror.Code\n112|\tExitCode int\n113|\t// Reason names the refusal shape; Detail is human text.\n114|\tReason RefusalReason\n115|\tDetail string\n116|\t// Local carries the majors the local installation offered (empty when\n117|\t// the local generation itself is unknown). Peer carries the peer's\n118|\t// single offered major (zero when the peer offer was unusable).\n119|\tLocal []int\n120|\tPeer  int\n121|\t// Cause is the Go sentinel for errors.Is; it never reaches the wire.\n122|\tCause error\n123|}\n124|\n125|// Error renders the refusal without exposing anything beyond the refusal\n126|// facts. Message text is for humans; automation branches on Code/Reason.\n127|func (refusal *Refusal) Error() string {\n128|\tif refusal == nil {\n129|\t\treturn \"meshneg refusal\"\n130|\t}\n131|\treturn fmt.Sprintf(\"mesh RPC negotiation refused (%s): %s\", refusal.Reason, refusal.Code)\n132|}\n133|\n134|// Unwrap exposes the cause sentinel for errors.Is.\n135|func (refusal *Refusal) Unwrap() error {\n136|\tif refusal == nil {\n137|\t\treturn nil\n138|\t}\n139|\treturn refusal.Cause\n140|}\n141|\n142|// classExit resolves the pinned exit status for a refusal or exposure code\n143|// under the Structured Error version that introduced it. An unregistered\n144|// code or version fails closed: the caller gets an internal error, never a\n145|// guessed exit.\n146|func classExit(version axerror.Version, code axerror.Code) (int, error) {\n147|\treturn axerror.ExitCodeFor(version, code)\n148|}\n149|\n150|// refuse builds a peer-side refusal (incompatible_protocol, exit 6). It is\n151|// used only when incompatibility is actually known from a decoded hello and\n152|// a known local generation, per Section 11.10.1; unframed input never\n153|// reaches this package.\n154|func refuse(reason RefusalReason, cause error, detail string, local []int, peer int) (*Refusal, error) {\n155|\texit, err := classExit(axerror.Version100, axerror.Code(\"incompatible_protocol\"))\n156|\tif err != nil {\n157|\t\treturn nil, err\n158|\t}\n159|\treturn &Refusal{\n160|\t\tCode:     axerror.Code(\"incompatible_protocol\"),\n161|\t\tExitCode: exit,\n162|\t\tReason:   reason,\n163|\t\tDetail:   detail,\n164|\t\tLocal:    append([]int(nil), local...),\n165|\t\tPeer:     peer,\n166|\t\tCause:    cause,\n167|\t}, nil\n168|}\n169|\n170|// LocalMajors maps the local installation's configuration generation\n171|// (config.Configuration.SchemaVersion) to the exact RPC majors that\n172|// installation offers, in ascending order:\n173|//\n174|//   - 1.0.0 offers 2: the base configuration predates the directory and\n175|//     TerminalBackend extensions, so only the Section 11.2-11.3 core.\n176|//   - 2.0.0 offers 2 and 3: the Section 6.4 directory extension pairs with\n177|//     RPC 3 directory replication, and Section 11.8 requires v2 dual-stack.\n178|//   - 3.0.0 offers 2, 3, and 4: the Section 6.5 TerminalBackend extension\n179|//     pairs with RPC 4 evidence replication, and Section 11.9 requires v3\n180|//     dual-stack with preserved v2 interop.\n181|//   - 4.0.0 offers exactly 5: Section 6.6 requires Host Channel 1 and RPC 5\n182|//     for every peer and states that legacy dual-stack obligations never\n183|//     require a Config-4 endpoint to accept legacy.\n184|//\n185|// Any other generation is refused with the invalid_config class (exit 3):\n186|// Section 6.6 makes unknown configuration a refusal, never legacy\n187|// selection. The result is a fresh slice on every call.\n188|func LocalMajors(configVersion string) ([]int, error) {\n189|\tswitch configVersion {\n190|\tcase \"1.0.0\":\n191|\t\treturn []int{2}, nil\n192|\tcase \"2.0.0\":\n193|\t\treturn []int{2, 3}, nil\n194|\tcase \"3.0.0\":\n195|\t\treturn []int{2, 3, 4}, nil\n196|\tcase \"4.0.0\":\n197|\t\treturn []int{5}, nil\n198|\tdefault:\n199|\t\texit, err := classExit(axerror.Version100, axerror.Code(\"invalid_config\"))\n200|\t\tif err != nil {\n201|\t\t\treturn nil, err\n202|\t\t}\n203|\t\treturn nil, &Refusal{\n204|\t\t\tCode:     axerror.Code(\"invalid_config\"),\n205|\t\t\tExitCode: exit,\n206|\t\t\tReason:   ReasonUnknownConfig,\n207|\t\t\tDetail:   fmt.Sprintf(\"configuration generation %q offers no RPC major\", configVersion),\n208|\t\t\tCause:    ErrUnknownConfig,\n209|\t\t}\n210|\t}\n211|}\n212|\n213|// semverMajor parses a strict semantic version and returns its major\n214|// component. The grammar is the same full semver rpcwire enforces on hello\n215|// contract arrays (major.minor.patch with optional prerelease and build\n216|// metadata, no leading zeros, no \"v\" prefix); agreement with rpcwire decode\n217|// is measured by test, not asserted by comment.\n218|var semverMajor = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n219|\n220|func majorOf(version string) (int, error) {\n221|\tmatch := semverMajor.FindStringSubmatch(version)\n222|\tif match == nil {\n223|\t\treturn 0, fmt.Errorf(\"%w: version %q is not strict semver\", ErrMixedMajor, version)\n224|\t}\n225|\tmajor, err := strconv.Atoi(match[1])\n226|\tif err != nil {\n227|\t\treturn 0, fmt.Errorf(\"%w: version %q has no numeric major\", ErrMixedMajor, version)\n228|\t}\n229|\treturn major, nil\n230|}\n231|\n232|// PeerOffer validates the peer's side of the negotiation: the decoded frame\n233|// version plus the decoded hello's contracts map. It returns the peer's\n234|// single offered major. Identity, platform, version, nonce, echo, and limit\n235|// members of the hello are never consulted: negotiation selects a major, it\n236|// does not authenticate, and consulting them here would substitute for the\n237|// admission boundary.\n238|//\n239|// The offer is refused when the frame version is outside the pinned\n240|// vocabulary, when the contracts keys differ from the framing major's exact\n241|// pinned profile (a v2 14-key bound inside a v3+ frame, an extension key, or\n242|// any missing key), when the rpc array is empty or not strictly\n243|// sorted-unique, when any rpc version is not strict semver, or when any rpc\n244|// major differs from the framing major. A v2 frame may carry a 1-16 version\n245|// minor range (Section 11.2); selecting within that range stays a stated\n246|// bound, since this package negotiates majors only.\n247|func PeerOffer(frameVersion string, hello rpcwire.Hello) (int, error) {\n248|\tframing, pinned := pinnedFrameVersions[frameVersion]\n249|\tif !pinned {\n250|\t\trefusal, err := refuse(ReasonUnsupportedFrame, ErrUnsupportedFrame,\n251|\t\t\tfmt.Sprintf(\"frame version %q is outside the pinned 2.0.0-5.0.0 vocabulary\", frameVersion), nil, 0)\n252|\t\tif err != nil {\n253|\t\t\treturn 0, err\n254|\t\t}\n255|\t\treturn 0, refusal\n256|\t}\n257|\tprofile, err := rpcwire.ContractProfile(frameVersion)\n258|\tif err != nil {\n259|\t\treturn 0, err\n260|\t}\n261|\tif len(hello.Contracts) != len(profile) {\n262|\t\treturn 0, shapeRefusal(framing)\n263|\t}\n264|\tfor key := range profile {\n265|\t\tif _, ok := hello.Contracts[key]; !ok {\n266|\t\t\treturn 0, shapeRefusal(framing)\n267|\t\t}\n268|\t}\n269|\toffered := hello.Contracts[\"rpc\"]\n270|\tif len(offered) < 1 || len(offered) > 16 {\n271|\t\treturn 0, shapeRefusal(framing)\n272|\t}\n273|\tfor index, version := range offered {\n274|\t\tmajor, err := majorOf(version)\n275|\t\tif err != nil {\n276|\t\t\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q is not strict semver\", version))\n277|\t\t}\n278|\t\tif major != framing {\n279|\t\t\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q mixes major %d into a major-%d frame\", version, major, framing))\n280|\t\t}\n281|\t\tif index > 0 && offered[index-1] >= version {\n282|\t\t\treturn 0, mixedRefusal(\"rpc versions are not strictly sorted unique\")\n283|\t\t}\n284|\t}\n285|\tif frameVersion != \"2.0.0\" && !slices.Equal(offered, profile[\"rpc\"]) {\n286|\t\treturn 0, shapeRefusal(framing)\n287|\t}\n288|\treturn framing, nil\n289|}\n290|\n291|func shapeRefusal(framing int) error {\n292|\trefusal, err := refuse(ReasonContractShape, ErrContractShape,\n293|\t\tfmt.Sprintf(\"hello contracts do not match the pinned major-%d profile\", framing), nil, 0)\n294|\tif err != nil {\n295|\t\treturn err\n296|\t}\n297|\treturn refusal\n298|}\n299|\n300|func mixedRefusal(detail string) error {\n301|\trefusal, err := refuse(ReasonMixedMajor, ErrMixedMajor, detail, nil, 0)\n302|\tif err != nil {\n303|\t\treturn err\n304|\t}\n305|\treturn refusal\n306|}\n307|\n308|// Select returns the highest major in the intersection of the local and peer\n309|// offer sets. Either set naming a major outside the pinned 2/3/4/5\n310|// vocabulary, an empty set on either side, or a disjoint pair is refused as\n311|// no-common-major: an unmentionable major can never be common, and Section\n312|// 17.1 forbids selecting one by coercion.\n313|func Select(local, peer []int) (int, error) {\n314|\tfor _, major := range local {\n315|\t\tif major < 2 || major > 5 {\n316|\t\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n317|\t\t\t\tfmt.Sprintf(\"local offer names major %d outside the pinned 2/3/4/5 vocabulary\", major), append([]int(nil), local...), 0)\n318|\t\t\tif err != nil {\n319|\t\t\t\treturn 0, err\n320|\t\t\t}\n321|\t\t\treturn 0, refusal\n322|\t\t}\n323|\t}\n324|\tfor _, major := range peer {\n325|\t\tif major < 2 || major > 5 {\n326|\t\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n327|\t\t\t\tfmt.Sprintf(\"peer offer names major %d outside the pinned 2/3/4/5 vocabulary\", major), append([]int(nil), local...), 0)\n328|\t\t\tif err != nil {\n329|\t\t\t\treturn 0, err\n330|\t\t\t}\n331|\t\t\treturn 0, refusal\n332|\t\t}\n333|\t}\n334|\tbest := 0\n335|\tfor _, candidate := range local {\n336|\t\tif slices.Contains(peer, candidate) && candidate > best {\n337|\t\t\tbest = candidate\n338|\t\t}\n339|\t}\n340|\tif best == 0 {\n341|\t\tpeerMajor := 0\n342|\t\tif len(peer) == 1 {\n343|\t\t\tpeerMajor = peer[0]\n344|\t\t}\n345|\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n346|\t\t\t\"local and peer offers share no major (\"+joinMajors(local)+\" against \"+joinMajors(peer)+\")\",\n347|\t\t\tappend([]int(nil), local...), peerMajor)\n348|\t\tif err != nil {\n349|\t\t\treturn 0, err\n350|\t\t}\n351|\t\treturn 0, refusal\n352|\t}\n353|\treturn best, nil\n354|}\n355|\n356|func joinMajors(majors []int) string {\n357|\tparts := make([]string, 0, len(majors))\n358|\tfor _, major := range majors {\n359|\t\tparts = append(parts, strconv.Itoa(major))\n360|\t}\n361|\treturn \"[\" + strings.Join(parts, \" \") + \"]\"\n362|}\n363|\n364|// FeatureActivation reports how one above-core feature is exposed for the\n365|// negotiated peer. It carries no inventory counts, no object IDs, and no\n366|// capability advertisement: Negotiated states the outcome of this selection,\n367|// and Code names the registered exposure code only when the feature was not\n368|// negotiated, so a core-only peer can never be mistaken for an empty one.\n369|type FeatureActivation struct {\n370|\t// Feature is \"directory\" or \"terminal_backend_evidence\".\n371|\tFeature string\n372|\t// Negotiated is true exactly when the selected major carries the\n373|\t// feature (directory at 3+, backend evidence at 4+).\n374|\tNegotiated bool\n375|\t// Code is empty when negotiated; otherwise the registered exposure\n376|\t// code with ExitCode 6.\n377|\tCode     axerror.Code\n378|\tExitCode int\n379|}\n380|\n381|// PeerView is the local node's exposure of the negotiated peer: which\n382|// above-core activations the selection carries and which it reports\n383|// unsupported. Core sync itself is the negotiated major, not a member here.\n384|type PeerView struct {\n385|\tDirectory       FeatureActivation\n386|\tBackendEvidence FeatureActivation\n387|}\n388|\n389|// Decision is the pure-data selection outcome: exactly one common major\n390|// plus the shapes bound to it. Contracts and Namespaces are rebuilt from\n391|// the pinned profile for the selected major, never copied from peer bytes,\n392|// so a malformed peer array cannot propagate past selection.\n393|type Decision struct {\n394|\tMajor           int\n395|\tProtocolVersion string\n396|\tContracts       map[string][]string\n397|\tNamespaces      []string\n398|\tErrorVersion    axerror.Version\n399|\tPeer            PeerView\n400|}\n401|\n402|func exposure(feature string, negotiated bool, code axerror.Code, introduced axerror.Version) (FeatureActivation, error) {\n403|\tactivation := FeatureActivation{Feature: feature, Negotiated: negotiated}\n404|\tif negotiated {\n405|\t\treturn activation, nil\n406|\t}\n407|\texit, err := classExit(introduced, code)\n408|\tif err != nil {\n409|\t\treturn FeatureActivation{}, err\n410|\t}\n411|\tactivation.Code = code\n412|\tactivation.ExitCode = exit\n413|\treturn activation, nil\n414|}\n415|\n416|func decisionFor(major int) (Decision, error) {\n417|\tversion := fmt.Sprintf(\"%d.0.0\", major)\n418|\tcontracts, err := rpcwire.ContractProfile(version)\n419|\tif err != nil {\n420|\t\treturn Decision{}, err\n421|\t}\n422|\tnamespaces, err := rpcwire.Namespaces(version)\n423|\tif err != nil {\n424|\t\treturn Decision{}, err\n425|\t}\n426|\tbound, err := axerror.BindingFor(axerror.ContainingContract{ID: \"urn:ax:protocol:rpc\", Major: major})\n427|\tif err != nil {\n428|\t\treturn Decision{}, err\n429|\t}\n430|\tdirectory, err := exposure(\"directory\", major >= directoryFeatureMajor, DirectoryUnsupportedCode, axerror.Version120)\n431|\tif err != nil {\n432|\t\treturn Decision{}, err\n433|\t}\n434|\tbackend, err := exposure(\"terminal_backend_evidence\", major >= backendEvidenceFeatureMajor, BackendEvidenceUnsupportedCode, axerror.Version130)\n435|\tif err != nil {\n436|\t\treturn Decision{}, err\n437|\t}\n438|\treturn Decision{\n439|\t\tMajor:           major,\n440|\t\tProtocolVersion: version,\n441|\t\tContracts:       contracts,\n442|\t\tNamespaces:      namespaces,\n443|\t\tErrorVersion:    bound,\n444|\t\tPeer:            PeerView{Directory: directory, BackendEvidence: backend},\n445|\t}, nil\n446|}\n447|\n448|// Negotiate selects exactly one common Mesh RPC major for the local\n449|// configuration generation and the peer's decoded hello frame. configVersion\n450|// is the local config.Configuration.SchemaVersion; frameVersion is the\n451|// decoded envelope's protocol_version; hello is the decoded hello body.\n452|//\n453|// On success it returns the Decision for the highest common major. On\n454|// refusal it returns a *Refusal carrying the pinned Section 15 class:\n455|// incompatible_protocol with exit 6 when the decoded inputs prove the\n456|// majors are disjoint or the peer offer is malformed, or invalid_config\n457|// with exit 3 when the local generation is unknown. Any other error is an\n458|// internal registry inconsistency, never a peer verdict.\n459|//\n460|// Negotiate consults only the configuration generation, the frame version,\n461|// and the hello contracts map. It reads no environment, no argv, no raw\n462|// frame bytes, no extension member, and no prior-handshake state, so none\n463|// of those can select a fallback (Section 6.6). It performs no admission:\n464|// the hello identity, allowlist, and trust generation must still pass the\n465|// hostchannel boundary before any dispatch.\n466|func Negotiate(configVersion, frameVersion string, hello rpcwire.Hello) (Decision, error) {\n467|\tlocal, err := LocalMajors(configVersion)\n468|\tif err != nil {\n469|\t\treturn Decision{}, err\n470|\t}\n471|\tpeer, err := PeerOffer(frameVersion, hello)\n472|\tif err != nil {\n473|\t\tif refusal, ok := err.(*Refusal); ok {\n474|\t\t\trefusal.Local = append([]int(nil), local...)\n475|\t\t\treturn Decision{}, refusal\n476|\t\t}\n477|\t\treturn Decision{}, err\n478|\t}\n479|\tmajor, err := Select(local, []int{peer})\n480|\tif err != nil {\n481|\t\treturn Decision{}, err\n482|\t}\n483|\treturn decisionFor(major)\n484|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
