{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbd7","stream":{"kind":"session","id":"01a0b081-544e-74f2-a0d1-9b009342eb06"},"sequence":1094,"recorded_at":1780531400002183,"record_type":"event","durability":"durable","causation_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","run_stream":{"kind":"run","id":"dae84e08-92bc-496b-b7d3-463fd560ae23"},"task_stream":{"kind":"task","id":"01a0b092-27e7-7873-9ebc-5c08bb8a93b0"},"task_id":"01a0b092-27e7-7873-9ebc-5c08bb8a93b0","event":{"kind":"output","task_id":"01a0b092-27e7-7873-9ebc-5c08bb8a93b0","chunk":"Read text file `internal/meshneg/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Mesh major-negotiation gate overlays. Every kill requires a named behavioral failure.\n3|\n4|Run with PYTHONDONTWRITEBYTECODE=1 so the harness leaves no __pycache__ behind.\n5|Each probe applies one narrowing plant to a pristine overlay of\n6|internal/meshneg/negotiate.go and executes the full package behavioral suite\n7|against it. A narrowing plant keeps the gate present and weakens it to admit\n8|exactly one member of the class the gate must reject.\n9|\"\"\"\n10|import argparse\n11|import json\n12|from pathlib import Path\n13|import subprocess\n14|import sys\n15|ROOT = Path(__file__).resolve().parents[2]\n16|TESTS = \"Test\"\n17|N = \"internal/meshneg/negotiate.go\"\n18|PROBES = []\n19|BOUNDS = {\n20|    \"detail-text\": \"Human Detail text only; no test branches on it (harmless applied control, must survive).\",\n21|}\n22|def probe(name,path,old,new,bound,test):\n23|    PROBES.append((name,path,old,new,bound,test))\n24|probe('neutral',N,'return []int{2}, nil','return []int{int(2)}, nil','Equivalent major value',None)\n25|probe('config1-admits-3',N,'return []int{2}, nil','return []int{2, 3}, nil','Admits major 3 for Config-1 only','TestNegotiateMatrix/1.0.0-x-3.0.0')\n26|probe('config2-admits-4',N,'return []int{2, 3}, nil','return []int{2, 3, 4}, nil','Admits major 4 for Config-2 only','TestNegotiateMatrix/2.0.0-x-4.0.0')\n27|probe('config3-admits-5',N,'return []int{2, 3, 4}, nil','return []int{2, 3, 4, 5}, nil','Admits major 5 for Config-3 only','TestNegotiateMatrix/3.0.0-x-5.0.0')\n28|probe('config4-admits-4',N,'return []int{5}, nil','return []int{4, 5}, nil','Admits major 4 for Config-4 only','TestConfig4NeverDowngrades')\n29|probe('unknown-config-admits-9',N,'case \"4.0.0\":','case \"4.0.0\", \"9.9.9\":','Admits generation 9.9.9 as Config-4 only','TestLocalMajors/unknown-9.9.9')\n30|probe('frame-admits-2.1',N,'\"2.0.0\": 2,','\"2.0.0\": 2,\\n\\t\"2.1.0\": 2,','Admits frame 2.1.0 as major 2 only','TestPeerOfferRefusals/frame-versions')\n31|probe('shape-admits-extra-key',N,'if len(hello.Contracts) != len(profile) {','if len(hello.Contracts) != len(profile) && len(hello.Contracts) != len(profile)+1 {','Admits exactly one extra contracts key','TestPeerOfferRefusals/shape/extra-error-key')\n32|probe('shape-admits-missing-lease',N,'if _, ok := hello.Contracts[key]; !ok {','if _, ok := hello.Contracts[key]; !ok && key != \"lease\" {','Admits a missing lease key only','TestPeerOfferRefusals/shape/substituted-key')\n33|probe('rpc-admits-17',N,'len(offered) > 16','len(offered) > 17','Admits exactly 17 rpc versions','TestPeerOfferRefusals/shape/seventeen-rpc')\n34|probe('rpc-admits-nil-empty',N,'len(offered) < 1','(len(offered) < 1 && offered != nil)','Admits a nil rpc array while still refusing an empty non-nil one','TestPeerOfferRefusals/shape/empty-rpc')\n35|probe('mixed-admits-v3-in-v2',N,'if major != framing {','if major != framing && !(major == 3 && framing == 2) {','Admits major 3 inside a major-2 frame only','TestPeerOfferRefusals/mixed/two-majors-in-v2')\n36|probe('mixed-admits-unsorted-pair',N,'offered[index-1] >= version','(offered[index-1] >= version && !(offered[index-1] == \"2.1.0\" && version == \"2.0.0\"))','Admits the 2.1.0/2.0.0 descending pair only','TestPeerOfferRefusals/mixed/unsorted')\n37|probe('mixed-admits-v-prefix-value',N,'major, err := majorOf(version)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q is not strict semver\", version))\\n\\t\\t}','major, err := majorOf(version)\\n\\t\\tif err != nil && version != \"v2.0.0\" {\\n\\t\\t\\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q is not strict semver\", version))\\n\\t\\t}\\n\\t\\tif version == \"v2.0.0\" {\\n\\t\\t\\tmajor, err = framing, nil\\n\\t\\t}','Admits the value v2.0.0 as the framing major only','TestPeerOfferRefusals/mixed/not-semver')\n38|probe('v3-exact-admits-3.0.1',N,'if frameVersion != \"2.0.0\" && !slices.Equal(offered, profile[\"rpc\"]) {','if frameVersion != \"2.0.0\" && !slices.Equal(offered, profile[\"rpc\"]) && !(frameVersion == \"3.0.0\" && slices.Equal(offered, []string{\"3.0.1\"})) {','Admits rpc [3.0.1] in a v3 frame only','TestPeerOfferRefusals/shape/v3-inexact-rpc')\n39|probe('select-admits-local-6',N,'for _, major := range local {\\n\\t\\tif major < 2 || major > 5 {','for _, major := range local {\\n\\t\\tif (major < 2 || major > 5) && major != 6 {','Admits local major 6 only','TestSelectHighestCommon/refuse-local-names-6')\n40|probe('select-admits-peer-1',N,'for _, major := range peer {\\n\\t\\tif major < 2 || major > 5 {','for _, major := range peer {\\n\\t\\tif (major < 2 || major > 5) && major != 1 {','Admits peer major 1 only','TestSelectHighestCommon/refuse-peer-mixes-1-with-common')\n41|probe('select-picks-lowest',N,'candidate > best','(candidate < best || best == 0)','Selects the lowest common major instead of the highest','TestSelectHighestCommon/admit-highest-wins')\n42|probe('select-admits-disjoint-2v3',N,'if best == 0 {','if best == 0 && !(len(local) == 1 && local[0] == 2 && len(peer) == 1 && peer[0] == 3) {','Admits the disjoint pair 2-against-3 as success','TestSelectHighestCommon/refuse-disjoint')\n43|probe('exposure-directory-at-2',N,'major >= directoryFeatureMajor','major >= directoryFeatureMajor-1','Reports directory negotiated at major 2','TestPeerExposure/2.0.0')\n44|probe('exposure-backend-at-3',N,'major >= backendEvidenceFeatureMajor','major >= backendEvidenceFeatureMajor-1','Reports backend evidence negotiated at major 3','TestPeerExposure/3.0.0')\n45|probe('error-binding-provider-contract',N,'\"urn:ax:protocol:rpc\"','\"urn:ax:protocol:provider\"','Resolves the error binding under the provider contract','TestDecisionShapes/3.0.0')\n46|probe('refusal-code-transport-failure',N,'Code:     axerror.Code(\"incompatible_protocol\"),','Code:     axerror.Code(\"transport_failure\"),','Peer refusals carry transport_failure instead of incompatible_protocol','TestNegotiateMatrix/3.0.0-x-5.0.0')\n47|probe('directory-version-1.0.0',N,'DirectoryUnsupportedCode, axerror.Version120','DirectoryUnsupportedCode, axerror.Version100','Resolves directory exposure under Error 1.0.0','TestPeerExposure/2.0.0')\n48|probe('backend-version-1.2.0',N,'BackendEvidenceUnsupportedCode, axerror.Version130','BackendEvidenceUnsupportedCode, axerror.Version120','Resolves backend exposure under Error 1.2.0','TestPeerExposure/2.0.0')\n49|probe('major-extract-plus-one',N,'major, err := strconv.Atoi(match[1])','major, err := strconv.Atoi(match[1])\\n\\tmajor++','Version grammar unchanged; extracted major shifted by one','TestNegotiateMatrix')\n50|probe('semver-admits-v-prefix',N,'^(0|[1-9][0-9]*)\\\\.','^v?(0|[1-9][0-9]*)\\\\.','Admits v-prefixed versions as their major','TestPeerOfferRefusals/mixed/not-semver')\n51|probe('reason-shape-reports-mixed',N,'refuse(ReasonContractShape, ErrContractShape,','refuse(ReasonMixedMajor, ErrContractShape,','Shape refusals misreport as mixed_major','TestPeerOfferRefusals/shape/extra-error-key')\n52|probe('detail-text',N,'\"local and peer offers share no major (\"+joinMajors(local)+\" against \"+joinMajors(peer)+\")\"','\"no overlap (\"+joinMajors(local)+\" vs \"+joinMajors(peer)+\")\"','Human Detail text only',None)\n53|\n54|def main():\n55|    parser = argparse.ArgumentParser(description=__doc__)\n56|    parser.add_argument(\"--output\", required=True)\n57|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n58|    opts = parser.parse_args()\n59|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n60|        parser.error(\"--only contains an unknown probe\")\n61|    out = Path(opts.output).resolve()\n62|    out.mkdir(parents=True, exist_ok=True)\n63|    results = []\n64|    unexpected = False\n65|    for name, path, old, new, narrows, expected_test in PROBES:\n66|        if opts.only and name not in opts.only.split(\",\"):\n67|            continue\n68|        source = ROOT / path\n69|        original = source.read_bytes()\n70|        text = original.decode()\n71|        if text.count(old) != 1:\n72|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n73|        folder = out / name\n74|        folder.mkdir(exist_ok=True)\n75|        replacement = folder / source.name\n76|        replacement.write_text(text.replace(old, new, 1))\n77|        overlay = folder / \"overlay.json\"\n78|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n79|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/meshneg\", \"-count=1\", \"-json\", \"-timeout=60s\", \"-run\", TESTS]\n80|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180)\n81|        (folder / \"test.log\").write_bytes(proc.stdout)\n82|        events = []\n83|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n84|            try:\n85|                events.append(json.loads(line))\n86|            except json.JSONDecodeError:\n87|                pass\n88|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n89|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n90|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n91|        if name == \"neutral\":\n92|            valid = proc.returncode == 0 and bool(passed)\n93|            state = \"neutral passed\" if valid else \"invalid control\"\n94|        elif name in BOUNDS:\n95|            valid = proc.returncode == 0 and bool(passed)\n96|            state = \"survived\" if valid else \"unexpected result\"\n97|        else:\n98|            valid = killed\n99|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n100|        if not valid:\n101|            unexpected = True\n102|        if source.read_bytes() != original:\n103|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n104|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n105|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n106|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n107|               \"command\": command}\n108|        results.append(row)\n109|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n110|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n111|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n112|            \"| --- | --- | --- | --- | --- |\"]\n113|    for r in results:\n114|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n115|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n116|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n117|    return int(unexpected)\n118|\n119|\n120|if __name__ == \"__main__\":\n121|    sys.exit(main())","final_result":true}}}
