{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb35","stream":{"kind":"session","id":"01a0b081-544e-74f2-a0d1-9b009342eb06"},"sequence":1013,"recorded_at":1780531400002021,"record_type":"event","durability":"durable","causation_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"dae84e08-92bc-496b-b7d3-463fd560ae23","run_stream":{"kind":"run","id":"dae84e08-92bc-496b-b7d3-463fd560ae23"},"task_stream":{"kind":"task","id":"01a0b091-f350-77e2-a6c8-96168e35ce25"},"task_id":"01a0b091-f350-77e2-a6c8-96168e35ce25","event":{"kind":"output","task_id":"01a0b091-f350-77e2-a6c8-96168e35ce25","chunk":"Read text file `internal/meshneg/negotiate_test.go`.\n(249 line(s) above)\n250|\t\t\trefusal := asRefusal(t, err)\n251|\t\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n252|\t\t\t\tt.Fatalf(\"Select(%v, %v) class = %s/%d, want incompatible_protocol/6\",\n253|\t\t\t\t\ttc.local, tc.peer, refusal.Code, refusal.ExitCode)\n254|\t\t\t}\n255|\t\t\tif refusal.Reason != meshneg.ReasonNoCommonMajor {\n256|\t\t\t\tt.Fatalf(\"Select(%v, %v) reason = %q\", tc.local, tc.peer, refusal.Reason)\n257|\t\t\t}\n258|\t\t\tif !errors.Is(err, meshneg.ErrNoCommonMajor) {\n259|\t\t\t\tt.Fatalf(\"Select(%v, %v) error does not wrap ErrNoCommonMajor\", tc.local, tc.peer)\n260|\t\t\t}\n261|\t\t})\n262|\t}\n263|}\n264|\n265|func TestPeerOfferRefusals(t *testing.T) {\n266|\tv2 := func(t *testing.T) map[string][]string { return profileContracts(t, \"2.0.0\") }\n267|\tv3 := func(t *testing.T) map[string][]string { return profileContracts(t, \"3.0.0\") }\n268|\n269|\tt.Run(\"frame-versions\", func(t *testing.T) {\n270|\t\tfor _, frame := range []string{\"\", \"1.0.0\", \"2.1.0\", \"3.0.1\", \"6.0.0\", \"v2.0.0\", \"02.0.0\", \"2.0\", \"2.0.0 \"} {\n271|\t\t\thello := directHello(t, v2(t))\n272|\t\t\tpeer, err := meshneg.PeerOffer(frame, hello)\n273|\t\t\tif peer != 0 {\n274|\t\t\t\tt.Fatalf(\"PeerOffer(%q) = %d, want refusal\", frame, peer)\n275|\t\t\t}\n276|\t\t\trefusal := asRefusal(t, err)\n277|\t\t\tif refusal.Reason != meshneg.ReasonUnsupportedFrame || !errors.Is(err, meshneg.ErrUnsupportedFrame) {\n278|\t\t\t\tt.Fatalf(\"PeerOffer(%q) reason = %q\", frame, refusal.Reason)\n279|\t\t\t}\n280|\t\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n281|\t\t\t\tt.Fatalf(\"PeerOffer(%q) class = %s/%d\", frame, refusal.Code, refusal.ExitCode)\n282|\t\t\t}\n283|\t\t}\n284|\t})\n285|\n286|\tt.Run(\"shape\", func(t *testing.T) {\n287|\t\tcases := []struct {\n288|\t\t\tname      string\n289|\t\t\tframe     string\n290|\t\t\tcontracts func(t *testing.T) map[string][]string\n291|\t\t}{\n292|\t\t\t{\"v2-bound-in-v3-frame\", \"3.0.0\", v2},\n293|\t\t\t{\"v2-bound-in-v4-frame\", \"4.0.0\", v2},\n294|\t\t\t{\"v2-bound-in-v5-frame\", \"5.0.0\", v2},\n295|\t\t\t{\"v3-bound-in-v2-frame\", \"2.0.0\", v3},\n296|\t\t\t{\"extra-error-key\", \"2.0.0\", func(t *testing.T) map[string][]string {\n297|\t\t\t\tm := v2(t)\n298|\t\t\t\tm[\"error\"] = []string{\"1.0.0\"}\n299|\t\t\t\treturn m\n300|\t\t\t}},\n301|\t\t\t{\"extra-extension-key\", \"3.0.0\", func(t *testing.T) map[string][]string {\n302|\t\t\t\tm := v3(t)\n303|\t\t\t\tm[\"extensions\"] = []string{\"1.0.0\"}\n304|\t\t\t\treturn m\n305|\t\t\t}},\n306|\t\t\t{\"missing-key\", \"2.0.0\", func(t *testing.T) map[string][]string {\n307|\t\t\t\tm := v2(t)\n308|\t\t\t\tdelete(m, \"lease\")\n309|\t\t\t\treturn m\n310|\t\t\t}},\n311|\t\t\t{\"substituted-key\", \"2.0.0\", func(t *testing.T) map[string][]string {\n312|\t\t\t\tm := v2(t)\n313|\t\t\t\tdelete(m, \"lease\")\n314|\t\t\t\tm[\"bogus\"] = []string{\"1.0.0\"}\n315|\t\t\t\treturn m\n316|\t\t\t}},\n317|\t\t\t{\"empty-rpc\", \"2.0.0\", func(t *testing.T) map[string][]string {\n318|\t\t\t\tm := v2(t)\n319|\t\t\t\tm[\"rpc\"] = nil\n320|\t\t\t\treturn m\n321|\t\t\t}},\n322|\t\t\t{\"seventeen-rpc\", \"2.0.0\", func(t *testing.T) map[string][]string {\n323|\t\t\t\tm := v2(t)\n324|\t\t\t\trpc := make([]string, 0, 17)\n325|\t\t\t\tfor i := range 17 {\n326|\t\t\t\t\trpc = append(rpc, \"2.0.\"+string(rune('0'+i/10))+string(rune('0'+i%10)))\n327|\t\t\t\t}\n328|\t\t\t\tm[\"rpc\"] = rpc\n329|\t\t\t\treturn m\n330|\t\t\t}},\n331|\t\t\t{\"v3-inexact-rpc\", \"3.0.0\", func(t *testing.T) map[string][]string {\n332|\t\t\t\tm := v3(t)\n333|\t\t\t\tm[\"rpc\"] = []string{\"3.0.1\"}\n334|\t\t\t\treturn m\n335|\t\t\t}},\n336|\t\t\t{\"v4-inexact-rpc\", \"4.0.0\", func(t *testing.T) map[string][]string {\n337|\t\t\t\tm := profileContracts(t, \"4.0.0\")\n338|\t\t\t\tm[\"rpc\"] = []string{\"4.0.0\", \"4.1.0\"}\n339|\t\t\t\treturn m\n340|\t\t\t}},\n341|\t\t\t{\"v5-inexact-rpc\", \"5.0.0\", func(t *testing.T) map[string][]string {\n342|\t\t\t\tm := profileContracts(t, \"5.0.0\")\n343|\t\t\t\tm[\"rpc\"] = []string{\"5.0.0\", \"5.0.1\"}\n344|\t\t\t\treturn m\n345|\t\t\t}},\n346|\t\t}\n347|\t\tfor _, tc := range cases {\n348|\t\t\tt.Run(tc.name, func(t *testing.T) {\n349|\t\t\t\thello := directHello(t, tc.contracts(t))\n350|\t\t\t\tpeer, err := meshneg.PeerOffer(tc.frame, hello)\n351|\t\t\t\tif peer != 0 {\n352|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) = %d, want refusal\", tc.frame, tc.name, peer)\n353|\t\t\t\t}\n354|\t\t\t\trefusal := asRefusal(t, err)\n355|\t\t\t\tif refusal.Reason != meshneg.ReasonContractShape || !errors.Is(err, meshneg.ErrContractShape) {\n356|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) reason = %q\", tc.frame, tc.name, refusal.Reason)\n357|\t\t\t\t}\n358|\t\t\t})\n359|\t\t}\n360|\t})\n361|\n362|\tt.Run(\"mixed\", func(t *testing.T) {\n363|\t\tcases := []struct {\n364|\t\t\tname  string\n365|\t\t\tframe string\n366|\t\t\trpc   []string\n367|\t\t}{\n368|\t\t\t{\"two-majors-in-v2\", \"2.0.0\", []string{\"2.0.0\", \"3.0.0\"}},\n369|\t\t\t{\"v3-only-in-v2-frame\", \"2.0.0\", []string{\"3.0.0\"}},\n370|\t\t\t{\"v1-in-v2-frame\", \"2.0.0\", []string{\"1.0.0\"}},\n371|\t\t\t{\"v2-in-v3-frame\", \"3.0.0\", []string{\"2.0.0\"}},\n372|\t\t\t{\"v5-in-v4-frame\", \"4.0.0\", []string{\"5.0.0\"}},\n373|\t\t\t{\"duplicate\", \"2.0.0\", []string{\"2.0.0\", \"2.0.0\"}},\n374|\t\t\t{\"unsorted\", \"2.0.0\", []string{\"2.1.0\", \"2.0.0\"}},\n375|\t\t\t{\"not-semver\", \"2.0.0\", []string{\"v2.0.0\"}},\n376|\t\t\t{\"non-numeric-major\", \"2.0.0\", []string{\"99999999999999999999999.0.0\"}},\n377|\t\t\t{\"empty-string\", \"2.0.0\", []string{\"\"}},\n378|\t\t\t{\"leading-zero\", \"2.0.0\", []string{\"02.0.0\"}},\n379|\t\t\t{\"trailing-space\", \"2.0.0\", []string{\"2.0.0 \"}},\n380|\t\t}\n381|\t\tfor _, tc := range cases {\n382|\t\t\tt.Run(tc.name, func(t *testing.T) {\n383|\t\t\t\tm := profileContracts(t, tc.frame)\n384|\t\t\t\tm[\"rpc\"] = tc.rpc\n385|\t\t\t\thello := directHello(t, m)\n386|\t\t\t\tpeer, err := meshneg.PeerOffer(tc.frame, hello)\n387|\t\t\t\tif peer != 0 {\n388|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) = %d, want refusal\", tc.frame, tc.name, peer)\n389|\t\t\t\t}\n390|\t\t\t\trefusal := asRefusal(t, err)\n391|\t\t\t\tif refusal.Reason != meshneg.ReasonMixedMajor || !errors.Is(err, meshneg.ErrMixedMajor) {\n392|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) reason = %q\", tc.frame, tc.name, refusal.Reason)\n393|\t\t\t\t}\n394|\t\t\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n395|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) class = %s/%d\", tc.frame, tc.name, refusal.Code, refusal.ExitCode)\n396|\t\t\t\t}\n397|\t\t\t})\n398|\t\t}\n399|\t})\n400|\n401|\tt.Run(\"admitted-ranges\", func(t *testing.T) {\n402|\t\t// A v2 minor range stays major 2: minor selection within the\n403|\t\t// common major is a stated bound, not a refusal.\n404|\t\tm := v2(t)\n405|\t\tm[\"rpc\"] = []string{\"2.0.0\", \"2.1.0\"}\n406|\t\tif peer, err := meshneg.PeerOffer(\"2.0.0\", directHello(t, m)); peer != 2 || err != nil {\n407|\t\t\tt.Fatalf(\"PeerOffer(v2 range) = %d, %v, want 2, nil\", peer, err)\n408|\t\t}\n409|\t\tm = v2(t)\n410|\t\tm[\"rpc\"] = []string{\"2.0.0\", \"2.0.0-alpha\"}