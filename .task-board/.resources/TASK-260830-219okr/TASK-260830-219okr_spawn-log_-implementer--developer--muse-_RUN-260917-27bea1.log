|\t\t\tif err != nil {\n450|\t\t\t\tt.Fatal(err)\n451|\t\t\t}\n452|\t\t\twant := shapes[frame]\n453|\t\t\tif len(decision.Contracts) != want.keys {\n454|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) contracts keys = %d, want %d\", config, frame, len(decision.Contracts), want.keys)\n455|\t\t\t}\n456|\t\t\tprofile, err := rpcwire.ContractProfile(frame)\n457|\t\t\tif err != nil {\n458|\t\t\t\tt.Fatal(err)\n459|\t\t\t}\n460|\t\t\tif !maps.EqualFunc(decision.Contracts, profile, slices.Equal) {\n461|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) contracts differ from the rpcwire profile\", config, frame)\n462|\t\t\t}\n463|\t\t\tif !slices.Equal(decision.Namespaces, want.namespaces) {\n464|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) namespaces = %v, want %v\", config, frame, decision.Namespaces, want.namespaces)\n465|\t\t\t}\n466|\t\t\tif decision.ErrorVersion != want.errVersion {\n467|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) error version = %s, want %s\", config, frame, decision.ErrorVersion, want.errVersion)\n468|\t\t\t}\n469|\t\t\tif decision.ProtocolVersion != frame {\n470|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) protocol version = %s\", config, frame, decision.ProtocolVersion)\n471|\t\t\t}\n472|\t\t\t// RPC 5 carries the exact RPC-4 shapes with only the version\n473|\t\t\t// changed (Section 11.10.1).\n474|\t\t\tif frame == \"5.0.0\" {\n475|\t\t\t\tfour, err := meshneg.Negotiate(\"3.0.0\", \"4.0.0\", decodedHello(t, \"4.0.0\", profileContracts(t, \"4.0.0\")))\n476|\t\t\t\tif err != nil {\n477|\t\t\t\t\tt.Fatal(err)\n478|\t\t\t\t}\n479|\t\t\t\tif !slices.Equal(decision.Namespaces, four.Namespaces) || decision.ErrorVersion != four.ErrorVersion {\n480|\t\t\t\t\tt.Fatal(\"RPC 5 decision diverges from the RPC-4 shapes\")\n481|\t\t\t\t}\n482|\t\t\t\tif len(decision.Contracts) != len(four.Contracts) {\n483|\t\t\t\t\tt.Fatal(\"RPC 5 contracts key count diverges from RPC 4\")\n484|\t\t\t\t}\n485|\t\t\t\tfor key, versions := range four.Contracts {\n486|\t\t\t\t\tgot := decision.Contracts[key]\n487|\t\t\t\t\tif key == \"rpc\" {\n488|\t\t\t\t\t\tif !slices.Equal(got, []string{\"5.0.0\"}) {\n489|\t\t\t\t\t\t\tt.Fatalf(\"RPC 5 rpc contracts = %v\", got)\n490|\t\t\t\t\t\t}\n491|\t\t\t\t\t\tcontinue\n492|\t\t\t\t\t}\n493|\t\t\t\t\tif !slices.Equal(got, versions) {\n494|\t\t\t\t\t\tt.Fatalf(\"RPC 5 contracts[%q] diverges from RPC 4\", key)\n495|\t\t\t\t\t}\n496|\t\t\t\t}\n497|\t\t\t}\n498|\t\t})\n499|\t}\n500|}","final_result":true}}}
