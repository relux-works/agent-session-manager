\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Opaque cursor returned by the previous page\\\"},{\\\"name\\\":\\\"limit\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":50,\\\"description\\\":\\\"Maximum events to return (1-100)\\\"},{\\\"name\\\":\\\"order\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"ascending\\\",\\\"description\\\":\\\"Sequence order: ascending or descending\\\"},{\\\"name\\\":\\\"kinds\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Comma-separated activity operation kinds\\\"},{\\\"name\\\":\\\"view\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"raw\\\",\\\"description\\\":\\\"History view: raw or effective\\\"}],\\\"examples\\\":[\\\"activity(TASK-XX, limit=50, order=ascending, view=raw)\\\",\\\"activity(TASK-XX, cursor=opaque-cursor, limit=25, kinds=progress, view=effective)\\\"]},\\\"agents\\\":{\\\"description\\\":\\\"List agents and their assigned elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"stale\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Stale threshold in minutes for done items\\\"}],\\\"examples\\\":[\\\"agents()\\\",\\\"agents(stale=60)\\\"]},\\\"context\\\":{\\\"description\\\":\\\"Get one Context Registry record by CTX id\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"}],\\\"examples\\\":[\\\"context(CTX-260728-a1b2c3) { selection }\\\",\\\"context(CTX-260728-a1b2c3) { identity binding lineage freshness security payload lifecycle }\\\"]},\\\"context_boundary\\\":{\\\"description\\\":\\\"Project one context's declared coverage boundary\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"},{\\\"name\\\":\\\"detail\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\"