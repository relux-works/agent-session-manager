lidation         = errors.New(\"configuration document validation failed\")\n35|\tErrUnsupportedConfigVersion = errors.New(\"unsupported configuration version\")\n36|\tErrConfigEncode             = errors.New(\"configuration document encode failed\")\n37|)\n38|\n39|// BackendSettingsValidator closes a backend_config.settings object for one\n40|// exact backend implementation/config version. A nil validator means that no\n41|// backend-specific settings schemas are registered and therefore every\n42|// backend_config entry is refused.\n43|type BackendSettingsValidator interface {\n44|\tValidateBackendSettings(backendID, configVersion string, settings map[string]any) error\n45|}\n46|\n47|// DecodeContext carries facts that are external to the TOML document but are\n48|// required by its exact validation rules.\n49|type DecodeContext struct {\n50|\tRuntimePlatform scalar.Platform\n51|\tBackendSettings BackendSettingsValidator\n52|}\n53|\n54|// LoadedConfiguration is an exact source-version read translated into the\n55|// current in-memory model. SourceVersion remains diagnostic provenance; Value\n56|// always has SchemaVersion CurrentVersion.\n57|type LoadedConfiguration struct {\n58|\tSourceVersion string\n59|\tValue         Configuration\n60|}\n61|\n62|// DocumentError preserves machine-actionable error identity while rendering\n63|// only a static schema clause. Parser/validator details remain unwrap-able and\n64|// cannot echo TOML values, paths, endpoints, or other machine-local data.\n65|type DocumentError struct {\n66|\tClause string\n67|\tErr    error\n68|}\n69|\n70|func (err *DocumentError) Error() string { return \"configuration document rejected at \" + err.Clause }\n71|func (err *DocumentError) Unwrap() error { return err.Err }\n72|\n73|// Configuration is the current Configuration 3.0.0 logical model.\n74|type Configuration struct {\n75|\tSchema                      string\n76|\tSchemaVersion               string\n77|\tHostID                      string\n78|\tHostName                    string\n79|\tPlatform                    scalar.Platform\n80|\tMesh                        Mesh\n(more lines below)","final_result":true}}}
