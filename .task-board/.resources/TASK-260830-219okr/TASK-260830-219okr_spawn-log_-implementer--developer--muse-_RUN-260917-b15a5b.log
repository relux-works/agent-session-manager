{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b01e-6502-7d72-84ad-f3cbb591031e"},"task_id":"01a0b01e-6502-7d72-84ad-f3cbb591031e","event":{"kind":"output","task_id":"01a0b01e-6502-7d72-84ad-f3cbb591031e","chunk":"Read text file `internal/config/endpoint.go`.\n1|package config\n2|\n3|import (\n4|\t\"net\"\n5|\t\"strings\"\n6|\t\"unicode\"\n7|)\n8|\n9|// Admission for the mesh peer endpoint AX hands to ssh(1) as its destination.\n10|//\n11|// SPEC.md Section 6.2 states that the endpoint and every SSH argument \"are\n12|// passed as atomic argv values, never through a shell\", and Section 6.3\n13|// authorizes a peer only when \"the SSH endpoint resolves to the authenticated\n14|// host expected by SSH host-key policy\". ssh(1) reads that destination\n15|// positionally through getopt, so an atomic argv value is not by itself a\n16|// destination: an endpoint beginning with \"-\" is parsed as an option instead,\n17|// and \"-oStrictHostKeyChecking=no\" written into this field is the same host-\n18|// authentication bypass Section 6.3 requires ssh_args to refuse, reached\n19|// through a field the ssh_args gate never inspects. An endpoint carrying\n20|// whitespace is the same injection one word-split away, and it cannot name a\n21|// host either way.\n22|//\n23|// The field is therefore admitted against the closed [user@]host[:port]\n24|// grammar below rather than filtered for known-bad shapes: a spelling this\n25|// package has never considered is refused instead of admitted. The grammar is\n26|// deliberately narrower than every destination ssh(1) would accept; widening\n27|// it is a reviewed change, not an accident.\n28|const (\n29|\tendpointAdmitted          = \"\"\n30|\tendpointRefusalOptionLike = \"option-like value\"\n31|\tendpointRefusalWhitespace = \"embedded whitespace\"\n32|\tendpointRefusalUser       = \"user\"\n33|\tendpointRefusalHost       = \"host\"\n34|\tendpointRefusalPort       = \"port\"\n35|)\n36|\n37|// admitMeshEndpoint returns endpointAdmitted when the endpoint matches the\n38|// declared [user@]host[:port] grammar, or the refusal reason for the first\n39|// clause it violates. The overall length is not checked here; the peer's\n40|// 1..1024 printable-character bound owns it.\n41|func admitMeshEndpoint(endpoint string) string {\n42|\t// Checked ahead of the grammar so the refusal names the option-injection\n43|\t// shape rather than reporting a malformed user or host.\n44|\tif strings.HasPrefix(endpoint, \"-\") {\n45|\t\treturn endpointRefusalOptionLike\n46|\t}\n47|\tif strings.IndexFunc(endpoint, unicode.IsSpace) >= 0 {\n48|\t\treturn endpointRefusalWhitespace\n49|\t}\n50|\tremainder := endpoint\n51|\t// The last \"@\" separates user from host: OpenSSH splits there too, so a\n52|\t// host part can never smuggle an \"@\" past this split.\n53|\tif separator := strings.LastIndexByte(remainder, '@'); separator >= 0 {\n54|\t\tif !admitEndpointUser(remainder[:separator]) {\n55|\t\t\treturn endpointRefusalUser\n56|\t\t}\n57|\t\tremainder = remainder[separator+1:]\n58|\t}\n59|\thost := remainder\n60|\tswitch {\n61|\tcase strings.HasPrefix(remainder, \"[\"):\n62|\t\tclosing := strings.IndexByte(remainder, ']')\n63|\t\tif closing < 0 {\n64|\t\t\treturn endpointRefusalHost\n65|\t\t}\n66|\t\thost, remainder = remainder[:closing+1], remainder[closing+1:]\n67|\t\tif remainder != \"\" {\n68|\t\t\tif remainder[0] != ':' || !admitEndpointPort(remainder[1:]) {\n69|\t\t\t\treturn endpointRefusalPort\n70|\t\t\t}\n71|\t\t}\n72|\tdefault:\n73|\t\tif separator := strings.LastIndexByte(remainder, ':'); separator >= 0 {\n74|\t\t\thost = remainder[:separator]\n75|\t\t\tif !admitEndpointPort(remainder[separator+1:]) {\n76|\t\t\t\treturn endpointRefusalPort\n77|\t\t\t}\n78|\t\t}\n79|\t}\n80|\tif !admitEndpointHost(host) {\n81|\t\treturn endpointRefusalHost\n82|\t}\n83|\treturn endpointAdmitted\n84|}\n85|\n86|// admitEndpointUser permits a 1..64 byte login name spelled from the portable\n87|// POSIX name characters plus \".\" and \"-\". A leading \"-\" is already refused for\n88|// the whole endpoint, which is where a login name could otherwise reintroduce\n89|// an option.\n90|func admitEndpointUser(user string) bool {\n91|\tif len(user) < 1 || len(user) > 64 {\n92|\t\treturn false\n93|\t}\n94|\tfor index := 0; index < len(user); index++ {\n95|\t\tif !isEndpointUserByte(user[index]) {\n96|\t\t\treturn false\n97|\t\t}\n98|\t}\n99|\treturn true\n100|}\n101|\n102|func isEndpointUserByte(character byte) bool {\n103|\tswitch {\n104|\tcase character >= 'a' && character <= 'z', character >= 'A' && character <= 'Z':\n105|\t\treturn true\n106|\tcase character >= '0' && character <= '9':\n107|\t\treturn true\n108|\tcase character == '.' || character == '_' || character == '-':\n109|\t\treturn true\n110|\t}\n111|\treturn false\n112|}\n113|\n114|// admitEndpointHost permits a bracketed IP literal or a dot-separated name\n115|// whose labels are the LDH characters of a DNS label. An IPv4 literal is\n116|// already an LDH name. A bare IPv6 literal is refused: its colons are\n117|// indistinguishable from a port separator, so it must be bracketed.\n118|//\n119|// The per-label bound is the DNS 63-byte label; the whole-name bound is left\n120|// to the endpoint's 1..1024 printable-character bound so that bound stays\n121|// reachable and provable through this grammar.\n122|func admitEndpointHost(host string) bool {\n123|\tif strings.HasPrefix(host, \"[\") {\n124|\t\tif !strings.HasSuffix(host, \"]\") || len(host) < 3 {\n125|\t\t\treturn false\n126|\t\t}\n127|\t\taddress := net.ParseIP(host[1 : len(host)-1])\n128|\t\treturn address != nil && address.To4() == nil\n129|\t}\n130|\tif host == \"\" {\n131|\t\treturn false\n132|\t}\n133|\tfor _, label := range strings.Split(host, \".\") {\n134|\t\tif !admitEndpointHostLabel(label) {\n135|\t\t\treturn false\n136|\t\t}\n137|\t}\n138|\treturn true\n139|}\n140|\n141|func admitEndpointHostLabel(label string) bool {\n142|\tif len(label) < 1 || len(label) > 63 {\n143|\t\treturn false\n144|\t}\n145|\tif label[0] == '-' || label[len(label)-1] == '-' {\n146|\t\treturn false\n147|\t}\n148|\tfor index := 0; index < len(label); index++ {\n149|\t\tcharacter := label[index]\n150|\t\tswitch {\n151|\t\tcase character >= 'a' && character <= 'z', character >= 'A' && character <= 'Z':\n152|\t\tcase character >= '0' && character <= '9':\n153|\t\tcase character == '-':\n154|\t\tdefault:\n155|\t\t\treturn false\n156|\t\t}\n157|\t}\n158|\treturn true\n159|}\n160|\n161|// admitEndpointPort permits a plain decimal TCP port in 1..65535. The digits\n162|// are checked directly rather than through strconv, which also accepts a sign\n163|// prefix that is not a port.\n164|func admitEndpointPort(port string) bool {\n165|\tif len(port) < 1 || len(port) > 5 {\n166|\t\treturn false\n167|\t}\n168|\tnumber := 0\n169|\tfor index := 0; index < len(port); index++ {\n170|\t\tif port[index] < '0' || port[index] > '9' {\n171|\t\t\treturn false\n172|\t\t}\n173|\t\tnumber = number*10 + int(port[index]-'0')\n174|\t}\n175|\treturn number >= 1 && number <= 65_535\n176|}","final_result":true}}}
