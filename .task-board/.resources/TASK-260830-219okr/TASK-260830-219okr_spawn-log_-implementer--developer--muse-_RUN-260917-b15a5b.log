{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65b","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":392,"recorded_at":1780531400000779,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b01e-5913-7d40-926a-fadca3c69938"},"task_id":"01a0b01e-5913-7d40-926a-fadca3c69938","event":{"kind":"output","task_id":"01a0b01e-5913-7d40-926a-fadca3c69938","chunk":"Read text file `internal/rpcwire/hello.go`.\n1|package rpcwire\n2|\n3|import (\n4|\t\"crypto/rand\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"regexp\"\n8|\t\"slices\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|var semver = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n14|\n15|// Hello is a structural claim, including the untrusted HostID and limits.\n16|// Received nonce randomness and freshness cannot be established by a codec.\n17|type Hello struct {\n18|\tHostID         string              `json:\"host_id\"`\n19|\tPlatform       string              `json:\"platform\"`\n20|\tAXVersion      string              `json:\"ax_version\"`\n21|\tNonce          string              `json:\"nonce\"`\n22|\tNonceEcho      string              `json:\"nonce_echo,omitempty\"`\n23|\tContracts      map[string][]string `json:\"contracts\"`\n24|\tMaxLineBytes   scalar.Uint53       `json:\"max_line_bytes\"`\n25|\tMaxObjectBytes scalar.Uint53       `json:\"max_object_bytes\"`\n26|}\n27|\n28|// NewNonce produces 256 random bits without accepting caller-supplied entropy.\n29|func NewNonce() string {\n30|\tvar nonce [32]byte\n31|\t_, _ = rand.Read(nonce[:]) // crypto/rand.Read is infallible in Go 1.25.\n32|\treturn base64.RawURLEncoding.EncodeToString(nonce[:])\n33|}\n34|\n35|// ContractProfile describes the pinned wire shape, not installed capabilities.\n36|// Returning a fresh map prevents one caller from changing another's validator.\n37|func ContractProfile(version string) (map[string][]string, error) {\n38|\tn, err := major(version)\n39|\tif err != nil {\n40|\t\treturn nil, err\n41|\t}\n42|\tm := map[string][]string{}\n43|\tfor _, key := range []string{\"rpc\", \"session_record\", \"session_event\", \"lease\", \"checkpoint\", \"workspace_group\", \"provider_identity\", \"blob\", \"transfer_manifest\", \"chunk\", \"materialization_plan\", \"tombstone\", \"tombstone_ack\", \"task_board_bundle\"} {\n44|\t\tm[key] = []string{\"1.0.0\"}\n45|\t}\n46|\tm[\"rpc\"] = []string{version}\n47|\tif n >= 3 {\n48|\t\tm[\"session_record\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n49|\t\tm[\"session_event\"] = []string{\"1.0.0\", \"2.0.0\", \"3.0.0\"}\n50|\t\tm[\"materialization_plan\"] = []string{\"1.0.0\", \"2.0.0\"}\n51|\t\tfor _, key := range []string{\"environment_observation\", \"native_session_observation\", \"session_inventory_batch\", \"conversation_lineage_link\", \"session_annotation\", \"session_enrichment_profile\", \"session_enrichment_job_request\", \"session_enrichment_job_receipt\", \"session_continuation_plan\", \"session_directory_operation_receipt\"} {\n52|\t\t\tm[key] = []string{\"1.0.0\"}\n53|\t\t}\n54|\t}\n55|\tif n >= 4 {\n56|\t\tm[\"session_event\"] = append(m[\"session_event\"], \"4.0.0\")\n57|\t\tm[\"terminal_backend_evidence\"] = []string{\"1.0.0\"}\n58|\t}\n59|\treturn m, nil\n60|}\n61|\n62|func validNonce(s string) bool {\n63|\tb, err := base64.RawURLEncoding.Strict().DecodeString(s)\n64|\treturn err == nil && len(b) >= 16 && base64.RawURLEncoding.EncodeToString(b) == s\n65|}\n66|func decodeHello(version string, data []byte, response bool) (Hello, error) {\n67|\tm, err := object(data)\n68|\tif err != nil {\n69|\t\treturn Hello{}, ErrHello\n70|\t}\n71|\tkeys := []string{\"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\"}\n72|\tif response {\n73|\t\tkeys = append(keys, \"nonce_echo\")\n74|\t}\n75|\tif !exact(m, keys...) {\n76|\t\treturn Hello{}, ErrHello\n77|\t}\n78|\tvar h Hello\n79|\tif json.Unmarshal(data, &h) != nil {\n80|\t\treturn Hello{}, ErrHello\n81|\t}\n82|\tif _, err = scalar.ParseUUIDv7(h.HostID); err != nil {\n83|\t\treturn Hello{}, ErrHello\n84|\t}\n85|\tif _, err = scalar.ParsePlatform(h.Platform); err != nil {\n86|\t\treturn Hello{}, ErrHello\n87|\t}\n88|\tif !semver.MatchString(h.AXVersion) || !validNonce(h.Nonce) || (response && !validNonce(h.NonceEcho)) {\n89|\t\treturn Hello{}, ErrHello\n90|\t}\n91|\tif h.MaxLineBytes.Uint64() < MaxLineBytes || h.MaxObjectBytes.Uint64() < MinObjectBytes {\n92|\t\treturn Hello{}, ErrHello\n93|\t}\n94|\tprofile, _ := ContractProfile(version)\n95|\tif len(h.Contracts) != len(profile) {\n96|\t\treturn Hello{}, ErrHello\n97|\t}\n98|\tfor key, expected := range profile {\n99|\t\tversions := h.Contracts[key]\n100|\t\tif len(versions) < 1 || len(versions) > 16 {\n101|\t\t\treturn Hello{}, ErrHello\n102|\t\t}\n103|\t\tfor i, v := range versions {\n104|\t\t\tif !semver.MatchString(v) || (i > 0 && versions[i-1] >= v) {\n105|\t\t\t\treturn Hello{}, ErrHello\n106|\t\t\t}\n107|\t\t}\n108|\t\t// v2 permits 1..16 supported versions for every required key; later\n109|\t\t// pinned maps specify exact arrays. Selecting a common minor is separate.\n110|\t\tif version != \"2.0.0\" && !slices.Equal(versions, expected) {\n111|\t\t\treturn Hello{}, ErrHello\n112|\t\t}\n113|\t}\n114|\treturn h, nil\n115|}\n116|\n117|func (r Request) Hello() (Hello, error) {\n118|\tif r.operation != \"hello\" {\n119|\t\treturn Hello{}, ErrHello\n120|\t}\n121|\treturn decodeHello(r.version, r.body, false)\n122|}\n123|func (r Response) Hello() (Hello, error) {\n124|\tif !r.OK() || r.request.operation != \"hello\" {\n125|\t\treturn Hello{}, ErrHello\n126|\t}\n127|\treturn decodeHello(r.request.version, r.body, true)\n128|}\n129|\n130|// Limits is only the smaller pair of structural offers. It is not a negotiated\n131|// or authenticated connection. The transport's fixed 8 MiB cap still applies.\n132|type Limits struct{ LineBytes, ObjectBytes uint64 }\n133|\n134|func OfferedLimits(request Request, response Response) (Limits, error) {\n135|\ta, err := request.Hello()\n136|\tif err != nil {\n137|\t\treturn Limits{}, err\n138|\t}\n139|\tb, err := response.Hello()\n140|\tif err != nil {\n141|\t\treturn Limits{}, err\n142|\t}\n143|\tif response.request.id != request.id || response.request.version != request.version || a.Nonce != b.NonceEcho {\n144|\t\treturn Limits{}, ErrCorrelation\n145|\t}\n146|\treturn Limits{min(a.MaxLineBytes.Uint64(), b.MaxLineBytes.Uint64()), min(a.MaxObjectBytes.Uint64(), b.MaxObjectBytes.Uint64())}, nil\n147|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b01e-5913-7d40-926a-fadca3c69938"},"task_id":"01a0b01e-5913-7d40-926a-fadca3c69938","event":{"kind":"completed","task_id":"01a0b01e-5913-7d40-926a-fadca3c69938"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65f","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":394,"recorded_at":1780531400000783,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b01e-58eb-7611-898b-730d3eb9f647"},"task_id":"01a0b01e-58eb-7611-898b-730d3eb9f647","event":{"kind":"output","task_id":"01a0b01e-58eb-7611-898b-730d3eb9f647","chunk":"Read text file `internal/rpcwire/envelope.go`.\n1|// Package rpcwire encodes and inspects untrusted Mesh RPC frames. Structural\n2|// validity and correlation are never authentication, handshake completion or\n3|// permission to dispatch. No connection, responder or operation executor lives\n4|// here. The eventual bilateral admission consumer must supply those boundaries.\n5|package rpcwire\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"encoding/json\"\n10|\t\"errors\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sshtransport\"\n16|)\n17|\n18|const Protocol = \"urn:ax:protocol:rpc\"\n19|const MaxLineBytes = sshtransport.MaxLineBytes\n20|const MinObjectBytes = 5 * 1024 * 1024\n21|\n22|var (\n23|\tErrFrame       = errors.New(\"invalid RPC frame\")\n24|\tErrVersion     = errors.New(\"unsupported RPC wire version\")\n25|\tErrCorrelation = errors.New(\"RPC response does not match request\")\n26|\tErrHello       = errors.New(\"incompatible RPC hello structure\")\n27|\tErrInventory   = errors.New(\"invalid RPC inventory structure\")\n28|)\n29|\n30|// Request retains an isolated envelope. Body bytes for operations other than\n31|// hello and inventory.roots are opaque: their operation owners must validate\n32|// them. A zero Request cannot be encoded or used as a response expectation.\n33|type Request struct {\n34|\tversion, id, operation string\n35|\tbody                   json.RawMessage\n36|}\n37|\n38|func (r Request) Version() string       { return r.version }\n39|func (r Request) ID() string            { return r.id }\n40|func (r Request) Operation() string     { return r.operation }\n41|func (r Request) Body() json.RawMessage { return bytes.Clone(r.body) }\n42|\n43|// Response is correlated but still untrusted. A success body has the same\n44|// operation-validation bounds as Request. A failure uses the containing major's\n45|// static Structured Error binding, never a version supplied by its body.\n46|type Response struct {\n47|\trequest Request\n48|\tbody    json.RawMessage\n49|\tfailure *axerror.Error\n50|}\n51|\n52|func (r Response) OK() bool                { return r.failure == nil && r.body != nil }\n53|func (r Response) Body() json.RawMessage   { return bytes.Clone(r.body) }\n54|func (r Response) Failure() *axerror.Error { return r.failure }\n55|\n56|func major(version string) (int, error) {\n57|\tswitch version {\n58|\tcase \"2.0.0\":\n59|\t\treturn 2, nil\n60|\tcase \"3.0.0\":\n61|\t\treturn 3, nil\n62|\tcase \"4.0.0\":\n63|\t\treturn 4, nil\n64|\tcase \"5.0.0\":\n65|\t\treturn 5, nil\n66|\tdefault:\n67|\t\treturn 0, ErrVersion\n68|\t}\n69|}\n70|\n71|// object refuses duplicate members, non-integral numbers and other\n72|// non-I-JSON input using the existing common data-model owner. Keep original\n73|// bytes; canonicalization must not launder invalid numeric lexical forms.\n74|func object(data []byte) (map[string]json.RawMessage, error) {\n75|\tif _, err := canonicaljson.Canonicalize(data); err != nil {\n76|\t\treturn nil, ErrFrame\n77|\t}\n78|\tvar m map[string]json.RawMessage\n79|\tif json.Unmarshal(data, &m) != nil || m == nil {\n80|\t\treturn nil, ErrFrame\n81|\t}\n82|\treturn m, nil\n83|}\n84|func exact(m map[string]json.RawMessage, keys ...string) bool {\n85|\tif len(m) != len(keys) {\n86|\t\treturn false\n87|\t}\n88|\tfor _, k := range keys {\n89|\t\tif _, ok := m[k]; !ok {\n90|\t\t\treturn false\n91|\t\t}\n92|\t}\n93|\treturn true\n94|}\n95|func stringValue(raw json.RawMessage) string {\n96|\tvar value string\n97|\tif json.Unmarshal(raw, &value) != nil {\n98|\t\treturn \"\"\n99|\t}\n100|\treturn value\n101|}\n102|func envelope(data []byte) (map[string]json.RawMessage, string, string, error) {\n103|\tif len(data) == 0 || len(data) > MaxLineBytes || bytes.ContainsAny(data, \"\\n\") {\n104|\t\treturn nil, \"\", \"\", ErrFrame\n105|\t}\n106|\tm, err := object(data)\n107|\tif err != nil {\n108|\t\treturn nil, \"\", \"\", err\n109|\t}\n110|\tif stringValue(m[\"protocol\"]) != Protocol {\n111|\t\treturn nil, \"\", \"\", ErrFrame\n112|\t}\n113|\tversion := stringValue(m[\"protocol_version\"])\n114|\tif !semver.MatchString(version) {\n115|\t\treturn nil, \"\", \"\", ErrFrame\n116|\t}\n117|\tif _, err = major(version); err != nil {\n118|\t\treturn nil, \"\", \"\", err\n119|\t}\n120|\tid := stringValue(m[\"request_id\"])\n121|\tif _, err = scalar.ParseUUIDv7(id); err != nil {\n122|\t\treturn nil, \"\", \"\", ErrFrame\n123|\t}\n124|\treturn m, version, id, nil\n125|}\n126|\n127|// DecodeRequest inspects one LF-free line, as returned by SSH Session.Receive.\n128|// It never marks a hello successful or opens an operation-dispatch path.\n129|func DecodeRequest(line []byte) (Request, error) {\n130|\tm, version, id, err := envelope(line)\n131|\tif err != nil {\n132|\t\treturn Request{}, err\n133|\t}\n134|\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"operation\", \"body\") {\n135|\t\treturn Request{}, ErrFrame\n136|\t}\n137|\top := stringValue(m[\"operation\"])\n138|\tif op == \"\" {\n139|\t\treturn Request{}, ErrFrame\n140|\t}\n141|\tif _, err = object(m[\"body\"]); err != nil {\n142|\t\treturn Request{}, err\n143|\t}\n144|\tif op == \"hello\" {\n145|\t\t_, err = decodeHello(version, m[\"body\"], false)\n146|\t}\n147|\tif op == \"inventory.roots\" {\n148|\t\t_, err = decodeNamespaces(version, m[\"body\"])\n149|\t}\n150|\tif err != nil {\n151|\t\treturn Request{}, err\n152|\t}\n153|\treturn Request{version, id, op, bytes.Clone(m[\"body\"])}, nil\n154|}\n155|\n156|// EncodeRequest validates the same structural surface as DecodeRequest and\n157|// returns one line without LF for SSH Session.Send. It does not send it.\n158|func EncodeRequest(version, id, operation string, body json.RawMessage) ([]byte, error) {\n159|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": version, \"request_id\": id, \"operation\": operation, \"body\": body})\n160|\tif err != nil {\n161|\t\treturn nil, ErrFrame\n162|\t}\n163|\tif _, err = DecodeRequest(line); err != nil {\n164|\t\treturn nil, err\n165|\t}\n166|\treturn line, nil\n167|}\n168|\n169|// DecodeResponse compares identity/version before examining the success or\n170|// error payload. It does not consume a pending request or provide replay\n171|// protection; connection sequencing remains the admission consumer's job.\n172|func DecodeResponse(line []byte, request Request) (Response, error) {\n173|\tif request.id == \"\" {\n174|\t\treturn Response{}, ErrCorrelation\n175|\t}\n176|\tm, version, id, err := envelope(line)\n177|\tif err != nil {\n178|\t\treturn Response{}, err\n179|\t}\n180|\tif version != request.version {\n181|\t\treturn Response{}, ErrVersion\n182|\t}\n183|\tif id != request.id {\n184|\t\treturn Response{}, ErrCorrelation\n185|\t}\n186|\tswitch string(m[\"ok\"]) {\n187|\tcase \"true\":\n188|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"body\") {\n189|\t\t\treturn Response{}, ErrFrame\n190|\t\t}\n191|\t\tif _, err = object(m[\"body\"]); err != nil {\n192|\t\t\treturn Response{}, err\n193|\t\t}\n194|\t\tif request.operation == \"hello\" {\n195|\t\t\tvar h Hello\n196|\t\t\th, err = decodeHello(version, m[\"body\"], true)\n197|\t\t\tif err == nil {\n198|\t\t\t\tsent, _ := request.Hello()\n199|\t\t\t\tif h.NonceEcho != sent.Nonce {\n200|\t\t\t\t\terr = ErrCorrelation\n201|\t\t\t\t}\n202|\t\t\t}\n203|\t\t}\n204|\t\tif request.operation == \"inventory.roots\" {\n205|\t\t\terr = validateRoots(version, m[\"body\"], request.body)\n206|\t\t}\n207|\t\tif err != nil {\n208|\t\t\treturn Response{}, err\n209|\t\t}\n210|\t\treturn Response{request: request, body: bytes.Clone(m[\"body\"])}, nil\n211|\tcase \"false\":\n212|\t\tif !exact(m, \"protocol\", \"protocol_version\", \"request_id\", \"ok\", \"error\") {\n213|\t\t\treturn Response{}, ErrFrame\n214|\t\t}\n215|\t\tn, _ := major(version)\n216|\t\tfailure, err := axerror.DecodeBound(axerror.ContainingContract{ID: Protocol, Major: n}, m[\"error\"])\n217|\t\tif err != nil {\n218|\t\t\treturn Response{}, err\n219|\t\t}\n220|\t\treturn Response{request: request, failure: failure}, nil\n221|\tdefault:\n222|\t\treturn Response{}, ErrFrame\n223|\t}\n224|}\n225|\n226|func EncodeSuccess(request Request, body json.RawMessage) ([]byte, error) {\n227|\treturn encodeResponse(request, true, \"body\", body)\n228|}\n229|func EncodeFailure(request Request, failure *axerror.Error) ([]byte, error) {\n230|\treturn encodeResponse(request, false, \"error\", failure)\n231|}\n232|func encodeResponse(request Request, ok bool, key string, payload any) ([]byte, error) {\n233|\tline, err := json.Marshal(map[string]any{\"protocol\": Protocol, \"protocol_version\": request.version, \"request_id\": request.id, \"ok\": ok, key: payload})\n234|\tif err != nil {\n235|\t\treturn nil, ErrFrame\n236|\t}\n237|\tif _, err = DecodeResponse(line, request); err != nil {\n238|\t\treturn nil, err\n239|\t}\n240|\treturn line, nil\n241|}\n242|\n243|// EncodeRejection frames a failure for a parseable supported-version request,\n244|// even when its operation or body is invalid (Section 15.1 bootstrap framing).\n245|// Missing/invalid protocol, version or request ID and unparseable lines return\n246|// no frame. This only encodes bytes: the eventual responder must choose the\n247|// correct failure and close after its one pre-handshake rejection. It never\n248|// returns a Request that could be mistaken for a validated hello.\n249|func EncodeRejection(line []byte, failure *axerror.Error) ([]byte, error) {\n250|\tm, version, id, err := envelope(line)\n251|\tif err != nil {\n252|\t\treturn nil, err\n253|\t}\n254|\t// A response or arbitrary object is not a request to which we may reply.\n255|\tif _, ok := m[\"operation\"]; !ok {\n256|\t\treturn nil, ErrFrame\n257|\t}\n258|\treturn EncodeFailure(Request{version: version, id: id}, failure)\n259|}","final_result":true}}}
