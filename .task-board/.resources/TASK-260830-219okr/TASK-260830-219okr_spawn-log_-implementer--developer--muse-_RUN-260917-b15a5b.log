{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c783","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":540,"recorded_at":1780531400001075,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"call_id":"call_01a0b01eb19f7736af9e2e5878ddd301","text":"Read text file `internal/axerror/local.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|)\n8|\n9|// ErrUnknownSurface reports a surface for which the pinned document states no\n10|// exact local failure mapping. It is returned instead of a plausible default,\n11|// because inventing a mapping here would put a code on the wire that no clause\n12|// assigns.\n13|var ErrUnknownSurface = errors.New(\"no pinned local failure mapping for surface\")\n14|\n15|// Surface names a boundary at which ax reads output from a child process or a\n16|// peer. Only the surfaces whose local mapping the pinned document states\n17|// exactly are represented. Directory Node is deliberately absent: Section 15.3\n18|// says the caller emits \"incompatible_protocol or\n19|// adapter_protocol_violation/transport_failure as applicable\" without fixing\n20|// which, so this package reports the mapping as unknown rather than choosing\n21|// one and presenting the choice as the contract.\n22|type Surface string\n23|\n24|const (\n25|\t// SurfaceProviderStdio is the Provider JSON-over-stdio row of the Section\n26|\t// 15.1 bootstrap table.\n27|\tSurfaceProviderStdio Surface = \"provider_stdio\"\n28|\t// SurfaceTaskBoardBridge is the task-board bridge facade row.\n29|\tSurfaceTaskBoardBridge Surface = \"task_board_bridge\"\n30|\t// SurfaceMeshRPC is the Mesh RPC row.\n31|\tSurfaceMeshRPC Surface = \"mesh_rpc\"\n32|\t// SurfaceTerminalBackend is the Section 15.3 TerminalBackend paragraph.\n33|\tSurfaceTerminalBackend Surface = \"terminal_backend\"\n34|)\n35|\n36|// UntrustedOutcome classifies what ax observed at the boundary. It is a\n37|// classification of the local read, not a value taken from the payload: the\n38|// payload is never parsed far enough to yield one.\n39|type UntrustedOutcome string\n40|\n41|const (\n42|\t// OutcomeRecognizableMajorMismatch is the \"recognizable major mismatch\"\n43|\t// branch of every row.\n44|\tOutcomeRecognizableMajorMismatch UntrustedOutcome = \"recognizable_major_mismatch\"\n45|\t// OutcomeUnusableFrame is the otherwise branch: invalid JSON, an oversize\n46|\t// line, missing framing identity, or output that cannot be framed.\n47|\tOutcomeUnusableFrame UntrustedOutcome = \"unusable_frame\"\n48|)\n49|\n50|type localMapping struct {\n51|\tversion       Version\n52|\tmajorMismatch Code\n53|\totherwise     Code\n54|}\n55|\n56|// localMappings is the Section 15.1 bootstrap table plus the Section 15.3\n57|// TerminalBackend paragraph, each row quoted in the comment above its entry.\n58|// The version is fixed per surface and is not a caller argument, so a local\n59|// failure cannot be emitted under a version the surface does not bind.\n60|var localMappings = map[Surface]localMapping{\n61|\t// \"the host accepts no child error object ... and emits its own local Error\n62|\t// 1.0.0: incompatible_protocol for a recognizable major mismatch, otherwise\n63|\t// provider_protocol_error\".\n64|\tSurfaceProviderStdio: {version: Version100, majorMismatch: \"incompatible_protocol\", otherwise: \"provider_protocol_error\"},\n65|\t// \"ax emits its own local Error 1.0.0: incompatible_protocol for a\n66|\t// recognizable major mismatch, otherwise task_board_bridge_unavailable\".\n67|\tSurfaceTaskBoardBridge: {version: Version100, majorMismatch: \"incompatible_protocol\", otherwise: \"task_board_bridge_unavailable\"},\n68|\t// \"The initiator emits its own local Error 1.0.0: incompatible_protocol for\n69|\t// a recognizable major mismatch, otherwise transport_failure\".\n70|\tSurfaceMeshRPC: {version: Version100, majorMismatch: \"incompatible_protocol\", otherwise: \"transport_failure\"},\n71|\t// \"the AX caller emits a local Error 1.3 terminal_backend_protocol_incompatible\n72|\t// for a recognizable major mismatch and terminal_backend_protocol_error otherwise\".\n73|\tSurfaceTerminalBackend: {version: Version130, majorMismatch: \"terminal_backend_protocol_incompatible\", otherwise: \"terminal_backend_protocol_error\"},\n74|}\n75|\n76|// LocalFromUntrusted builds the ax-local failure for an unsupported major or an\n77|// unusable first frame at a child or peer boundary.\n78|//\n79|// It takes no part of the foreign payload. Its inputs are the surface, ax's own\n80|// classification of what it observed, human text ax wrote, the identifiers ax\n81|// itself knows, and a local Go cause. There is no parameter through which a\n82|// foreign code, retryable bit, detail map, or authority field could be adopted,\n83|// which is how Section 15.1's \"Receivers MUST NOT parse a different major's\n84|// payload far enough to trust its error code, retryable bit, details, or\n85|// authority fields\" is enforced rather than merely intended.\n86|//\n87|// The result is never retryable. Every code this table can emit either belongs\n88|// to a class the caller must inspect before repeating, or describes a boundary\n89|// that the identical request cannot get past; nothing observed at an unusable\n90|// frame licenses a safe-retry claim, so the constructor does not offer one.\n91|func LocalFromUntrusted(\n92|\tsurface Surface,\n93|\toutcome UntrustedOutcome,\n94|\tmessage string,\n95|\tids IDs,\n96|\tdetails Details,\n97|\tcause error,\n98|) (*Error, error) {\n99|\tmapping, known := localMappings[surface]\n100|\tif !known {\n101|\t\treturn nil, fmt.Errorf(\"%w: %q\", ErrUnknownSurface, surface)\n102|\t}\n103|\tvar code Code\n104|\tswitch outcome {\n105|\tcase OutcomeRecognizableMajorMismatch:\n106|\t\tcode = mapping.majorMismatch\n107|\tcase OutcomeUnusableFrame:\n108|\t\tcode = mapping.otherwise\n109|\tdefault:\n110|\t\treturn nil, fmt.Errorf(\"%w: outcome %q is not a pinned classification\", ErrInvalidStructuredError, outcome)\n111|\t}\n112|\tif details == nil {\n113|\t\tdetails = Details{}\n114|\t}\n115|\treturn New(Spec{\n116|\t\tVersion: mapping.version,\n117|\t\tCode:    code,\n118|\t\tMessage: message,\n119|\t\tIDs:     ids,\n120|\t\tDetails: details,\n121|\t\tCause:   cause,\n122|\t})\n123|}\n124|\n125|// LocalSurfaces returns the surfaces with a pinned local failure mapping, in a\n126|// stable order. It is the measured denominator of this package's bootstrap\n127|// coverage: four of the five boundaries the pinned document names, with\n128|// Directory Node excluded for the reason stated on Surface.\n129|func LocalSurfaces() []Surface {\n130|\tresult := make([]Surface, 0, len(localMappings))\n131|\tfor surface := range localMappings {\n132|\t\tresult = append(result, surface)\n133|\t}\n134|\tsort.Slice(result, func(left, right int) bool { return result[left] < result[right] })\n135|\treturn result\n136|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c785","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":541,"recorded_at":1780531400001077,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"call_id":"call_01a0b01eb3a97689a95c7934b3076647","text":"{\n  \"chunk_id\": \"exec-14-1\",\n  \"command\": \"sed -n 1,120p internal/axerror/decode.go; echo ===BIND===; grep -n \\\"ContainingContract\\\\|binding\\\\|Binding\\\" internal/axerror/*.go | grep -v test | head -30\",\n  \"description\": \"Read axerror decode and bindings\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package axerror\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"encoding/json\\\"\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"regexp\\\"\\n\\t\\\"strconv\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/canonicaljson\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\nvar (\\n\\t// ErrUnsupportedMajor reports a Structured Error document whose major is not\\n\\t// 1. Section 17.2 rule 1 requires a reader to reject an unsupported major\\n\\t// rather than parse it, and Section 15.1 forbids trusting a different\\n\\t// major's code, retryable bit, details, or authority fields.\\n\\tErrUnsupportedMajor = errors.New(\\\"unsupported structured error major\\\")\\n\\n\\t// ErrVersionMismatch reports a supported version that is not the one the\\n\\t// containing contract statically binds.\\n\\tErrVersionMismatch = errors.New(\\\"structured error version differs from the bound version\\\")\\n)\\n\\n// semverPattern accepts only a full, unpadded semantic version triple.\\nvar semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)\\\\.(0|[1-9][0-9]*)$`)\\n\\n// wireDocument is the closed decode target. Every member is a pointer so that\\n// an omitted required member is distinguishable from a present zero value, and\\n// DisallowUnknownFields makes any tenth member a refusal: an authority field\\n// smuggled alongside the nine declared ones is rejected, not ignored.\\ntype wireDocument struct {\\n\\tSchema        *string          `json:\\\"schema\\\"`\\n\\tSchemaVersion *string          `json:\\\"schema_version\\\"`\\n\\tCode          *string          `json:\\\"code\\\"`\\n\\tMessage       *string          `json:\\\"message\\\"`\\n\\tExitCode      *json.RawMessage `json:\\\"exit_code\\\"`\\n\\tRetryable     *bool            `json:\\\"retryable\\\"`\\n\\tOperationID   *json.RawMessage `json:\\\"operation_id\\\"`\\n\\tSessionID     *json.RawMessage `json:\\\"session_id\\\"`\\n\\tDetails       *Details         `json:\\\"details\\\"`\\n}\\n\\n// Decode reads one Structured Error document that is expected to carry exactly\\n// version.\\n//\\n// The common logical data model is settled first, before the envelope identity,\\n// because a document whose members repeat has no unambiguous identity to settle:\\n// see requireCommonDataModel. Nothing about the document is reported to the\\n// caller from that pass except that the bytes are outside the model.\\n//\\n// The envelope identity is settled before any other member is consulted, the\\n// closed top-level member set included. A document whose schema is not\\n// urn:ax:schema:error, whose major is not 1, or whose supported minor is not\\n// the expected one is refused without this function having read its member set,\\n// code, retryable bit, details, or identifiers, so no part of a wrong-version\\n// payload can be trusted on the way to that refusal.\\n//\\n// The member set is checked after the identity rather than before it, because\\n// the pinned document scopes that obligation to the object it governs: Section\\n// 1.6 requires a reader to \\\"reject an unknown top-level field in a major\\n// version 1 object\\\", Section 17.1 scopes the same rule to \\\"within any\\n// negotiated major version\\\", and Section 17.2 lists \\\"rejects an unsupported\\n// major\\\" as the reader's first rule. Section 15.1 is explicit that \\\"receivers\\n// MUST NOT parse a different major's payload far enough to trust its error\\n// code, retryable bit, details, or authority fields\\\", and reporting which\\n// members a different major's payload carries is exactly that kind of reading.\\n// Both orders refuse; only one of them tells the caller the version fact it\\n// needs.\\n//\\n// A code the registry does not carry is admitted, because Section 15.3 states\\n// that \\\"New error codes MAY be added in a compatible minor contract version\\\".\\n// Such an object keeps its envelope's exit class, is reported by\\n// CodeRegistered as unrecognized, and is never a success: its exit status must\\n// still be a registered Section 15.2 failure status, and the retryability\\n// refusals that apply to that exit class still apply.\\nfunc Decode(version Version, data []byte) (*Error, error) {\\n\\tif !isRegisteredVersion(version) {\\n\\t\\treturn nil, fmt.Errorf(\\\"%w: %q\\\", ErrUnsupportedVersion, version)\\n\\t}\\n\\tif err := requireCommonDataModel(data); err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tidentity, err := parseEnvelopeIdentity(data)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tif err := verifyEnvelopeIdentity(identity, version); err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tdocument, err := decodeClosedDocument(data)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\treturn decodeBody(version, document)\\n}\\n\\n// DecodeBound reads a Structured Error embedded in a containing contract. The\\n// version is resolved from the static binding table, never from the document,\\n// so a peer cannot select its own error version by writing one into the\\n// payload.\\nfunc DecodeBound(contract ContainingContract, data []byte) (*Error, error) {\\n\\tversion, err := BindingFor(contract)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\treturn Decode(version, data)\\n}\\n\\n// requireCommonDataModel refuses bytes that are outside the Section 1.6 common\\n// logical data model before any member of the document is read.\\n//\\n// It exists because a duplicate member has no single value. Section 1.6 states\\n// the rule twice and in both directions, quoted verbatim from the pinned\\n// internal/specdoc/SPEC.md at the lines named:\\n//\\n//\\tSPEC.md:218 \\\"map keys MUST be UTF-8 strings and MUST be unique\\\"\\n//\\tSPEC.md:221 \\\"floating-point numbers, NaN, Infinity, non-string map keys, and duplicate keys are forbidden\\\"\\n===BIND===\\ninternal/axerror/binding.go:17:// ContainingContract identifies a contract that embeds Structured Error.\\ninternal/axerror/binding.go:18:type ContainingContract struct {\\ninternal/axerror/binding.go:25:// staticBindings is the complete Section 15.1, 15.3, and 17.1 binding table.\\ninternal/axerror/binding.go:44:var staticBindings = map[ContainingContract]Version{\\ninternal/axerror/binding.go:63:// BindingFor returns the exact Structured Error version that a containing\\ninternal/axerror/binding.go:70:func BindingFor(contract ContainingContract) (Version, error) {\\ninternal/axerror/binding.go:71:\\tversion, bound := staticBindings[contract]\\ninternal/axerror/binding.go:80:func BoundContracts() []ContainingContract {\\ninternal/axerror/binding.go:81:\\tresult := make([]ContainingContract, 0, len(staticBindings))\\ninternal/axerror/binding.go:82:\\tfor contract := range staticBindings {\\ninternal/axerror/decode.go:101:// version is resolved from the static binding table, never from the document,\\ninternal/axerror/decode.go:104:func DecodeBound(contract ContainingContract, data []byte) (*Error, error) {\\ninternal/axerror/decode.go:105:\\tversion, err := BindingFor(contract)\\ninternal/axerror/details.go:63:// Terminal Instance Binding is not a credential, a transcript, an environment\\n\",\n  \"original_output_bytes\": 6621,\n  \"original_output_tokens\": 1656,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
