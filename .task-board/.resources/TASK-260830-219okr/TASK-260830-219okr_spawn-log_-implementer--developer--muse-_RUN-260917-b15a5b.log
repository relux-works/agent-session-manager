{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73d","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":505,"recorded_at":1780531400001005,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"call_id":"call_01a0b01e9346700d8fefecb92774a240","text":"{\n  \"chunk_id\": \"exec-12-1\",\n  \"command\": \"sed -n '120,260p' .github/workflows/ci.yml\",\n  \"description\": \"Read rest of CI workflow\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      # nothing is a failure, not a pass.\\n      - name: Test\\n        run: |\\n          set +e\\n          go test ./... -v -count=1 > test.log 2>&1\\n          code=$?\\n          set -e\\n          cat test.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' test.log)\\\" -gt 0\\n          test \\\"$(grep -c '^FAIL' test.log || true)\\\" -eq 0\\n          {\\n            echo \\\"## Suite skips\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' test.log || true)\\\"\\n            grep '^--- SKIP' test.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  race:\\n    name: Race detector\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      - name: Test with race detector\\n        run: |\\n          set +e\\n          go test -race ./... -count=1 > race.log 2>&1\\n          code=$?\\n          set -e\\n          cat race.log\\n          test $code -eq 0\\n          test \\\"$(grep -c '^ok' race.log)\\\" -gt 0\\n\\n  coverage:\\n    name: Coverage numbers (reported, no floor)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Coverage is a number, not a gate: this job reports per-package\\n      # percentages and refuses only an unreadable or empty result.\\n      - name: Test with coverage\\n        run: |\\n          set +e\\n          go test ./... -cover -count=1 > cover.log 2>&1\\n          code=$?\\n          set -e\\n          cat cover.log\\n          test $code -eq 0\\n          test \\\"$(grep -c 'coverage: ' cover.log)\\\" -gt 0\\n          {\\n            echo \\\"## Coverage\\\"\\n            echo \\\"\\\"\\n            echo \\\"| Package | Coverage |\\\"\\n            echo \\\"| --- | --- |\\\"\\n            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\\\2` | \\\\3 |/' || true\\n            echo \\\"\\\"\\n            echo \\\"Packages without test files (stated bounds, not failures):\\\"\\n            echo \\\"\\\"\\n            grep 'no test files' cover.log || echo \\\"none\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n    timeout-minutes: 15\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        os: [ubuntu-latest, macos-latest]\\n        package: [internal/secprim, internal/secconftest]\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\\n      # secconftest capabilities line witnesses the probe counters after the\\n      # whole suite. Skips are loud here by construction.\\n      - name: Run fixture package\\n        run: |\\n          set +e\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n          code=$?\\n          set -e\\n          grep '^--- SKIP' fixture.log || echo \\\"no skipped tests\\\"\\n          grep 'secconftest capabilities on' fixture.log || true\\n          {\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n            echo \\\"\\\"\\n            echo \\\"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\\\"\\n          } >> \\\"$GITHUB_STEP_SUMMARY\\\"\\n          test $code -eq 0\\n          test \\\"$(grep -c '^--- PASS' fixture.log)\\\" -gt 0\\n\\n  fuzz-smoke:\\n    name: Fuzz smoke (derived targets)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 15\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # Targets are derived per package from the compiled test binaries,\\n      # never retyped: only names starting with Fuzz are fuzz targets. An\\n      # empty leg fails the total-count pin below: the grep sits in a\\n      # pipeline whose exit status the shell discards, so it refuses\\n      # nothing, and the non-empty-file check refuses only the\\n      # every-package-empty case — a single silently empty package dies\\n      # only at the pinned total. A new fuzz target without a CI update\\n      # reddens here instead of going unsmoked.\\n      - name: Derive fuzz targets\\n        run: |\\n          rm -f fuzz-targets.clean\\n          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\\n            go test \\\"./${pkg}\\\" -list '^Fuzz' > \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" 2>&1\\n            grep '^Fuzz' \\\"fuzz-targets-$(basename \\\"${pkg}\\\").log\\\" | sed \\\"s|^|${pkg} |\\\" >> fuzz-targets.clean\\n\",\n  \"original_output_bytes\": 4803,\n  \"original_output_tokens\": 1201,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
