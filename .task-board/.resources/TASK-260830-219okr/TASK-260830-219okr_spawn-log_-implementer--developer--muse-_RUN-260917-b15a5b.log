slices.Equal(versions, expected) && !(version == \"4.0.0\" && key == \"lease\")','Admits nonexact v4 lease array','TestHelloRefusals/exact-map-4.0.0')\n43|probe('v5-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"5.0.0\" && key == \"lease\")','Admits nonexact v5 lease array','TestHelloRefusals/exact-map-5.0.0')\n44|probe('offered-pair',H,'response.request.id != request.id','(response.request.id != request.id && request.id != \"0198f4c8-a070-7188-9172-2234567890ab\")','Admits one cross-request limit pair','TestLimitsAndUntrustedIsolation')\n45|probe('namespace-empty',I,'len(names) < 1','len(names) < 1 && names == nil','Admits nonnil empty namespace array','TestInventoryNamespacesAndCardinality/2.0.0')\n46|probe('namespace-member',I,'!slices.Contains(allowed, name)','(!slices.Contains(allowed, name) && name != \"credential\")','Admits credential namespace only','TestInventoryNamespacesAndCardinality/2.0.0')\n47|probe('namespace-duplicate',I,'names[i-1] >= name','names[i-1] > name','Admits duplicate namespaces','TestInventoryNamespacesAndCardinality/2.0.0')\n48|probe('namespace-sort',I,'names[i-1] >= name','(names[i-1] >= name && !(names[i-1] == \"event\" && name == \"blob\"))','Admits event/blob descending pair','TestInventoryNamespacesAndCardinality/2.0.0')\n49|probe('roots-missing',I,'len(roots) != len(names)','len(roots) != len(names) && len(roots) != len(names)-1','Admits one missing requested root','TestInventoryNamespacesAndCardinality/2.0.0/missing')\n50|probe('root-association',I,'root.Namespace != names[i]','root.Namespace != names[i] && !(i==0 && root.Namespace==\"event\")','Admits event root in blob slot','TestInventoryNamespacesAndCardinality/2.0.0')\n51|\n52|probe('common-data-model',E,'canonicaljson.Canonicalize(data); err != nil','canonicaljson.Canonicalize(data); err != nil && !bytes.HasPrefix(data, []byte(`{\"protocol\":\"urn:other\",`))','Admits the duplicate protocol fixture while retaining the canonicalization call','TestFrameRefusals/duplicate')\n53|\n54|def main():\n55|    parser = argparse.ArgumentParser(description=__doc__)\n56|    parser.add_argument(\"--output\", required=True)\n57|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n58|    opts = parser.parse_args()\n59|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n60|        parser.error(\"--only contains an unknown probe\")\n61|    out = Path(opts.output).resolve()\n62|    out.mkdir(parents=True, exist_ok=True)\n63|    results = []\n64|    unexpected = False\n65|    for name, path, old, new, narrows, expected_test in PROBES:\n66|        if opts.only and name not in opts.only.split(\",\"):\n67|            continue\n68|        source = ROOT / path\n69|        original = source.read_bytes()\n70|        text = original.decode()\n71|        if text.count(old) != 1:\n72|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n73|        folder = out / name\n74|        folder.mkdir(exist_ok=True)\n75|        replacement = folder / source.name\n76|        replacement.write_text(text.replace(old, new, 1))\n77|        overlay = folder / \"overlay.json\"\n78|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n79|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/rpcwire\", \"-count=1\", \"-json\", \"-timeout=20s\", \"-run\", TESTS]\n80|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)\n81|        (folder / \"test.log\").write_bytes(proc.stdout)\n82|        events = []\n83|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n84|            try:\n85|                events.append(json.loads(line))\n86|            except json.JSONDecodeError:\n87|                pass\n88|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n89|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n90|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n91|        if name == \"neutral\":\n92|            valid = proc.returncode == 0 and bool(passed)\n93|            state = \"neutral passed\" if valid else \"invalid control\"\n94|        elif name in BOUNDS:\n95|            valid = proc.returncode == 0 and bool(passed)\n96|            state = \"survived\" if valid else \"unexpected result\"\n97|        else:\n98|            valid = killed\n99|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n100|        if not valid:\n101|            unexpected = True\n102|        if source.read_bytes() != original:\n103|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n104|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n105|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n106|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n107|               \"command\": command}\n108|        results.append(row)\n109|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n110|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n111|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n112|            \"| --- | --- | --- | ---: | --- |\"]\n113|    for r in results:\n114|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n115|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n116|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n117|    return int(unexpected)\n118|\n119|\n120|if __name__ == \"__main__\":\n121|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
