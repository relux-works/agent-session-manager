{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c80b","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":608,"recorded_at":1780531400001211,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b01e-f643-70e2-9769-6b47a8400fcc"},"task_id":"01a0b01e-f643-70e2-9769-6b47a8400fcc","event":{"kind":"output","task_id":"01a0b01e-f643-70e2-9769-6b47a8400fcc","chunk":"Read text file `internal/hosttrust/authorize.go`.\n1|package hosttrust\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|)\n11|\n12|// AuthRequest carries one dispatch or mutation-boundary authorization check.\n13|// SnapshotGeneration binds the stream to the coherent snapshot it was opened\n14|// under; LocalCredentialID and the remote DER bytes select the exact enrolled\n15|// entries; Allowlisted is the local mesh allowlist; HelloHostID is the\n16|// authenticated hello identity; ExpectedRemoteHostID is the selected\n17|// configured destination on the client.\n18|type AuthRequest struct {\n19|\tSnapshotGeneration   uint64\n20|\tLocalHostID          string\n21|\tLocalCredentialID    string\n22|\tRemoteLeafDER        []byte\n23|\tRemoteRootDER        []byte\n24|\tExpectedRemoteHostID string\n25|\tAllowlisted          []string\n26|\tHelloHostID          string\n27|\tNow                  time.Time\n28|}\n29|\n30|// Formatting an authorization request must never expose DER bytes, UUIDs,\n31|// digests or allowlists.\n32|func (AuthRequest) String() string   { return \"host channel authorization request\" }\n33|func (AuthRequest) GoString() string { return \"host channel authorization request\" }\n34|func (AuthRequest) Format(state fmt.State, verb rune) {\n35|\t_, _ = state.Write([]byte(\"host channel authorization request\"))\n36|}\n37|\n38|// Formatting a snapshot must never expose the entries it binds.\n39|func (Snapshot) String() string   { return \"host trust snapshot\" }\n40|func (Snapshot) GoString() string { return \"host trust snapshot\" }\n41|func (Snapshot) Format(state fmt.State, verb rune) {\n42|\t_, _ = state.Write([]byte(\"host trust snapshot\"))\n43|}\n44|\n45|// AuthorizeDispatch checks current generation, local credential validity,\n46|// allowlist membership and authenticated hello against one committed read\n47|// held under the shared authorization lock. The check observes a coherent\n48|// snapshot, but the dispatch itself runs after the lock releases, so the\n49|// caller must bind the admitted generation to the stream and enforce the\n50|// one-second invalidation on commit: re-check currency before sending, and\n51|// close stale-generation streams on watchdog, never on notifications alone.\n52|// Mutation side effects additionally require WithMutationAuthorization, which\n53|// holds the exclusive lock across the recheck and the boundary. Work prepared\n54|// under an old generation cannot gain new authority by refreshing a cached\n55|// number: a stale snapshot refuses.\n56|func (store *Store) AuthorizeDispatch(snapshot Snapshot, request AuthRequest) error {\n57|\t// Pending joint intent converges before the currency check, so a\n58|\t// dispatch bound before a crash compares against the recovered\n59|\t// generation and refuses stale instead of admitting superseded trust.\n60|\t// Convergence failures name their own operation and pass through: a\n61|\t// refused recovery is a durability event, not an authorization verdict.\n62|\tunlock, err := lockForConvergedRead(store.fs, store.root, store.lock, store.paths)\n63|\tif err != nil {\n64|\t\treturn err\n65|\t}\n66|\tdefer unlock()\n67|\tcurrent, err := readCommitted(store)\n68|\tif err != nil {\n69|\t\treturn err\n70|\t}\n71|\t// The stream binding must match the snapshot it was opened under: work\n72|\t// prepared under an old generation cannot gain new authority by\n73|\t// refreshing a cached number.\n74|\tif request.SnapshotGeneration != snapshot.Generation {\n75|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n76|\t}\n77|\tif snapshot.Generation != current.Generation {\n78|\t\treturn trustError(TrustError{Operation: \"authorize generation\", Err: ErrStaleGeneration})\n79|\t}\n80|\treturn checkAuthorization(snapshot.Trust, request)\n81|}\n82|\n83|// readCommitted reads the committed trust without acquiring the lock: the\n84|// caller must already hold the authorization lock and have converged\n85|// pending joint intent, so the read nests safely inside a holder instead\n86|// of blocking on it.\n87|func readCommitted(store *Store) (TrustStore, error) {\n88|\tpath := store.TrustPath()\n89|\tinfo, err := store.fs.Lstat(path)\n90|\tif err != nil {\n91|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n92|\t}\n93|\tif err := verifyOwnerFile(path, info, 0o600); err != nil {\n94|\t\treturn TrustStore{}, err\n95|\t}\n96|\tdocument, err := store.fs.ReadFile(path)\n97|\tif err != nil {\n98|\t\treturn TrustStore{}, trustError(TrustError{Operation: \"authorize generation\", Err: errors.Join(ErrAuthorizationRefused, err)})\n99|\t}\n100|\tcommitted, err := DecodeTrust(document)\n101|\tif err != nil {\n102|\t\treturn TrustStore{}, err\n103|\t}\n104|\treturn committed, nil\n105|}\n106|\n107|func checkAuthorization(trust TrustStore, request AuthRequest) error {\n108|\tconst operation = \"authorize dispatch\"\n109|\tlocal, found := findEntry(trust, request.LocalCredentialID)\n110|\tif !found {\n(more lines below)","final_result":true}}}
