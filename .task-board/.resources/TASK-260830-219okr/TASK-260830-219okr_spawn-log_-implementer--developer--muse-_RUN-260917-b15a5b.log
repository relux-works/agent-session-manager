{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a7","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":686,"recorded_at":1780531400001367,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b021-54f3-7243-96ba-5dbd63bb5109"},"task_id":"01a0b021-54f3-7243-96ba-5dbd63bb5109","event":{"kind":"output","task_id":"01a0b021-54f3-7243-96ba-5dbd63bb5109","chunk":"Read text file `internal/rpcwire/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"RPC structural gate overlays. Every kill requires a named behavioral failure.\"\"\"\n3|import argparse\n4|import json\n5|from pathlib import Path\n6|import subprocess\n7|import sys\n8|ROOT = Path(__file__).resolve().parents[2]\n9|TESTS = \"Test\"\n10|E = \"internal/rpcwire/envelope.go\"\n11|H = \"internal/rpcwire/hello.go\"\n12|I = \"internal/rpcwire/inventory.go\"\n13|PROBES = []\n14|BOUNDS = {}\n15|def probe(name,path,old,new,bound,test):\n16|    PROBES.append((name,path,old,new,bound,test))\n17|probe('neutral',E,'return 2, nil','return int(2), nil','Equivalent major value',None)\n18|probe('known-bad',E,'return r.id','return \"wrong\"','Wrong request accessor','TestPinnedHelloProfiles/2.0.0')\n19|probe('line-plus-one',E,'len(data) > MaxLineBytes','len(data) > MaxLineBytes+1','Admits exactly 8388609 bytes','TestFrameRefusals/oversize')\n20|probe('lf',E,'bytes.ContainsAny(data, \"\\\\n\")','(bytes.ContainsAny(data, \"\\\\n\") && data[len(data)-1] != \\'\\\\n\\')','Admits final LF in a line payload','TestFrameRefusals/newline')\n21|probe('protocol',E,'stringValue(m[\"protocol\"]) != Protocol','stringValue(m[\"protocol\"]) != Protocol && stringValue(m[\"protocol\"]) != \"urn:other\"','Adm