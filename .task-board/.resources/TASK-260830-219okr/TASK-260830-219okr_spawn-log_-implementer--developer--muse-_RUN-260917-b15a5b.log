{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bf","stream":{"kind":"session","id":"01a0b01d-7842-7623-9b92-35d8899ee7fd"},"sequence":570,"recorded_at":1780531400001135,"record_type":"event","durability":"durable","causation_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b","run_stream":{"kind":"run","id":"0ef4e50a-8dbf-492d-ac24-c7f49d0e006b"},"task_stream":{"kind":"task","id":"01a0b01e-d21d-7b13-a09c-4cfa2ba43bb7"},"task_id":"01a0b01e-d21d-7b13-a09c-4cfa2ba43bb7","event":{"kind":"output","task_id":"01a0b01e-d21d-7b13-a09c-4cfa2ba43bb7","chunk":"Read text file `internal/axerror/binding.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"sort\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n9|)\n10|\n11|// ErrUnboundContract reports a containing contract major that binds no\n12|// Structured Error version. It is returned rather than a default, because\n13|// guessing a version here is exactly the negotiation the pinned document\n14|// forbids.\n15|var ErrUnboundContract = errors.New(\"containing contract major binds no structured error version\")\n16|\n17|// ContainingContract identifies a contract that embeds Structured Error.\n18|type ContainingContract struct {\n19|\t// ID is the Section 1.5 schema identifier of the containing contract.\n20|\tID catalog.ContractID\n21|\t// Major is the containing contract's major version.\n22|\tMajor int\n23|}\n24|\n25|// staticBindings is the complete Section 15.1, 15.3, and 17.1 binding table.\n26|// Section 17.1 states the rule this table implements: \"None negotiates the\n27|// error schema separately. Compatibility is evaluated first for the containing\n28|// protocol and then against its fixed embedded-error validator.\"\n29|//\n30|// Every row is quoted from the pinned document:\n31|//   - 15.1: \"Provider protocol 2.x, task-board bridge 1.x, and Mesh RPC 2.x\n32|//     each embed exactly Structured Error 1.0.0.\"\n33|//   - 15.1: \"Session Adapter 1.0 and session.clone.* bind Structured Error\n34|//     1.1.0.\"\n35|//   - 14.2: \"Legacy commands select CLI Result 1.0.0 and Structured Error\n36|//     1.0.0; every session.clone.* command selects CLI Result 2.0.0 on success\n37|//     and Structured Error 1.1.0 on failure.\"\n38|//   - 15.3: Structured Error 1.2.0 \"is bound by Directory Node 1 and 2, Mesh\n39|//     RPC 3, CLI Result 3, and Directory Query 1\".\n40|//   - 15.3: \"Terminal Backend Protocol 1.0.0, Provider Protocol 3.0.0, Mesh RPC\n41|//     4.0.0, and CLI Result 4.0.0 statically bind Structured Error 1.3.0.\"\n42|//   - 11.10.1: RPC 5 has the exact RPC-4 shapes and \"Structured Error\n43|//     remains statically bound to 1.3.0.\"\n44|var staticBindings = map[ContainingContract]Version{\n45|\t{ID: \"urn:ax:protocol:provider\", Major: 2}:               Version100,\n46|\t{ID: \"urn:ax:protocol:provider\", Major: 3}:               Version130,\n47|\t{ID: \"urn:ax:protocol:task-board-bridge\", Major: 1}:      Version100,\n48|\t{ID: \"urn:ax:protocol:rpc\", Major: 2}:                    Version100,\n49|\t{ID: \"urn:ax:protocol:rpc\", Major: 3}:                    Version120,\n50|\t{ID: \"urn:ax:protocol:rpc\", Major: 4}:                    Version130,\n51|\t{ID: \"urn:ax:protocol:rpc\", Major: 5}:                    Version130,\n52|\t{ID: \"urn:ax:protocol:session-adapter\", Major: 1}:        Version110,\n53|\t{ID: \"urn:ax:schema:cli-result\", Major: 1}:               Version100,\n54|\t{ID: \"urn:ax:schema:cli-result\", Major: 2}:               Version110,\n55|\t{ID: \"urn:ax:schema:cli-result\", Major: 3}:               Version120,\n56|\t{ID: \"urn:ax:schema:cli-result\", Major: 4}:               Version130,\n57|\t{ID: \"urn:ax:protocol:session-directory-node\", Major: 1}: Version120,\n58|\t{ID: \"urn:ax:protocol:session-directory-node\", Major: 2}: Version120,\n59|\t{ID: \"urn:ax:schema:session-directory-query\", Major: 1}:  Version120,\n60|\t{ID: \"urn:ax:protocol:terminal-backend\", Major: 1}:       Version130,\n61|}\n62|\n63|// BindingFor returns the exact Structured Error version that a containing\n64|// contract major statically binds. There is no negotiation path: the version is\n65|// selected by the containing contract alone, as Section 15.1 requires — \"the\n66|// containing protocol version is sufficient to select it\".\n67|//\n68|// An unregistered contract or major is refused. A caller cannot fall back to a\n69|// neighbouring major, and no default is returned.\n70|func BindingFor(contract ContainingContract) (Version, error) {\n71|\tversion, bound := staticBindings[contract]\n72|\tif !bound {\n73|\t\treturn \"\", fmt.Errorf(\"%w: %s major %d\", ErrUnboundContract, contract.ID, contract.Major)\n74|\t}\n75|\treturn version, nil\n76|}\n77|\n78|// BoundContracts returns every containing contract major that binds a\n79|// Structured Error version, in a stable order.\n80|func BoundContracts() []ContainingContract {\n81|\tresult := make([]ContainingContract, 0, len(staticBindings))\n82|\tfor contract := range staticBindings {\n83|\t\tresult = append(result, contract)\n84|\t}\n85|\tsort.Slice(result, func(left, right int) bool {\n86|\t\tif result[left].ID != result[right].ID {\n87|\t\t\treturn result[left].ID < result[right].ID\n88|\t\t}\n89|\t\treturn result[left].Major < result[right].Major\n90|\t})\n91|\treturn result\n92|}","final_result":true}}}
