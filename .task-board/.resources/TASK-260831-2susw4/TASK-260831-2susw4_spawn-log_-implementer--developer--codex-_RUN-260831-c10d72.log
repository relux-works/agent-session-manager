   177	
   178	func removeOwnershipKey(t *testing.T, filename, target string) {
   179		t.Helper()
   180		value, err := os.ReadFile(filename)
   181		if err != nil {
   182			t.Fatalf("read ownership registry: %v", err)
   183		}
   184		var document map[string]any
   185		if err := json.Unmarshal(value, &document); err != nil {
   186			t.Fatalf("decode ownership registry: %v", err)
   187		}
   188		removed := 0
   189		for _, rawGroup := range document["ownership"].([]any) {
   190			group := rawGroup.(map[string]any)
   191			keys := group["keys"].([]any)
   192			filtered := keys[:0]
   193			for _, key := range keys {
   194				if key == target {
   195					removed++
   196					continue
   197				}
   198				filtered = append(filtered, key)
   199			}
   200			group["keys"] = filtered
   201		}
   202		if removed != 1 {
   203			t.Fatalf("removed ownership key %q %d times, want exactly once", target, removed)
   204		}
   205		value, err = json.MarshalIndent(document, "", "  ")
   206		if err != nil {
   207			t.Fatalf("encode narrowed ownership registry: %v", err)
   208		}
   209		if err := os.WriteFile(filename, value, 0o644); err != nil {
   210			t.Fatalf("write narrowed ownership registry: %v", err)
   211		}
   212	}
