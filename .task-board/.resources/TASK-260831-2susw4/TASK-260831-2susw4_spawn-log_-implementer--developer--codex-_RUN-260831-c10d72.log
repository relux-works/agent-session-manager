   214	func runTracecheck(t *testing.T, root string, arguments ...string) (string, error) {
   215		t.Helper()
   216		commandArguments := append([]string{"run", "./internal/traceability/cmd/tracecheck", "-root", "."}, arguments...)
   217		command := exec.Command("go", commandArguments...)
   218		command.Dir = root
   219		command.Env = append(os.Environ(), "GOWORK=off", "GOTOOLCHAIN=local")
   220		output, err := command.CombinedOutput()
   221		return string(output), err
   222	}
