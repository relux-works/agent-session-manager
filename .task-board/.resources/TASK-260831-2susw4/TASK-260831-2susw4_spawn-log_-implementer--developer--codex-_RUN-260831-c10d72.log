   435	func snapshotDigest(repository fstest.MapFS) [32]byte {
   436		names := make([]string, 0, len(repository))
   437		for name := range repository {
   438			names = append(names, name)
   439		}
   440		sort.Strings(names)
   441		var content bytes.Buffer
   442		for _, name := range names {
   443			content.WriteString(name)
   444			content.WriteByte(0)
   445			content.Write(repository[name].Data)
   446			content.WriteByte(0)
   447		}
   448		return sha256.Sum256(content.Bytes())
   449	}

