+| 11 | `git ls-files -z '*.json' | xargs -0 -n1 python3 -c 'import json,sys;json.load(open(sys.argv[1]))'` under `zsh -o pipefail` | 0 |
+| 12 | `task-board validate` | 0 |
+| 13 | `git diff --check` | 0 |
