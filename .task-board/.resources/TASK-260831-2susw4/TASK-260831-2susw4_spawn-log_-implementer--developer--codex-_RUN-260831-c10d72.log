+func isolatedTracecheckFixture(t *testing.T) string {
+	t.Helper()
+	repositoryRoot := filepath.Join("..", "..", "..", "..")
+	fixtureRoot := t.TempDir()
+	copyFile(t, filepath.Join(repositoryRoot, "go.mod"), filepath.Join(fixtureRoot, "go.mod"))
