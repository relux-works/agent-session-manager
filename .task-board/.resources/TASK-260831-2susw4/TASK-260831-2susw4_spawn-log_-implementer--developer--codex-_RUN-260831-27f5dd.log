+var assignedSectionPattern = regexp.MustCompile(`^([1-9]|1[0-9]|20)(?:\.(?:[0-9]+|[A-Za-z]))*(?:-([1-9]|1[0-9]|20)(?:\.(?:[0-9]+|[A-Za-z]))*)?$`)
