-	report, err := traceability.VerifyRepository(os.DirFS(*root))
+	var report traceability.Report
+	var err error
+	if len(sections) == 0 {
+		report, err = traceability.VerifyRepository(os.DirFS(*root))
+	} else {
+		report, err = traceability.VerifyAssignedSections(os.DirFS(*root), sections)
+	}
 	if err != nil {
 		return err
 	}
 	_, err = fmt.Fprintf(
 		stdout,
