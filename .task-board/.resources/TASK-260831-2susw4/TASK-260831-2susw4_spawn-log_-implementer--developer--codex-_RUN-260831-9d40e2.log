+func TestVerifyAssignedSectionsBindsGranularScopeToOwnersAndExecutableCases(t *testing.T) {
+	t.Parallel()
+
+	report, err := VerifyAssignedSections(repositorySnapshot(t), []string{"10.1", "10.2", "10.3", "10.4"})
+	if err != nil {
+		t.Fatalf("VerifyAssignedSections() error = %v", err)
+	}
+	if report.AssignedScopes != 4 {
+		t.Fatalf("VerifyAssignedSections() assigned scopes = %d, want 4", report.AssignedScopes)
+	}
+
+	for _, scope := range []string{"10.1-10.4", "§4.C-4.E", "Appendix D"} {
+		report, err := VerifyAssignedSections(repositorySnapshot(t), []string{scope})
+		if err != nil {
