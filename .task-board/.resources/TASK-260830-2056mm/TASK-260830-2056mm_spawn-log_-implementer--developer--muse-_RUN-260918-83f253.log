d.go-263-\\t\\t\\tErrUnimplementedVersion, command, entry.version)\\ninternal/cliresult/command.go-264-\\t}\\ninternal/cliresult/command.go-265-\\treturn entry.version, nil\\ninternal/cliresult/command.go-266-}\\ninternal/cliresult/command.go-267-\\ninternal/cliresult/command.go-268-// RegisteredVersionForCommand returns the version a tag selects without\\ninternal/cliresult/command.go-269-// requiring this repository to build it. It exists so that a caller can report\\ninternal/cliresult/command.go-270-// the pinned selection for an unimplemented surface truthfully instead of\\ninternal/cliresult/command.go-271-// guessing or reporting nothing.\\ninternal/cliresult/command.go-272-func RegisteredVersionForCommand(command Command) (Version, error) {\\ninternal/cliresult/command.go-273-\\tentry, known := commandRegistry[command]\\ninternal/cliresult/command.go-274-\\tif !known {\\ninternal/cliresult/command.go-275-\\t\\treturn \\\"\\\", fmt.Errorf(\\\"%w: %q\\\", ErrUnknownCommand, command)\\ninternal/cliresult/command.go-276-\\t}\\ninternal/cliresult/command.go-277-\\treturn entry.version, nil\\ninternal/cliresult/command.go-278-}\\ninternal/cliresult/command.go-279-\\ninternal/cliresult/command.go-280-// Commands returns every registered command tag in sorted order.\\ninternal/cliresult/command.go-281-func Commands() []Command {\\ninternal/cliresult/command.go-282-\\tresult := make([]Command, 0, len(commandRegistry))\\ninternal/cliresult/command.go-283-\\tfor command := range commandRegistry {\\ninternal/cliresult/command.go-284-\\t\\tresult = append(result, command)\\ninternal/cliresult/command.go-285-\\t}\\ninternal/cliresult/command.go-286-\\tsort.Slice(result, func(left, right int) bool { return result[left] < result[right] })\\ninternal/cliresult/command.go-287-\\treturn result\\ninternal/cliresult/command.go-288-}\\ninternal/cliresult/command.go-289-\\ninternal/cliresult/command.go-290-// ImplementedCommands returns the tags whose closed body this repository builds,\\ninternal/cliresult/command.go-291-// in sorted order. It is the measured numerator of this package's command\\ninternal/cliresult/command.go-292-// coverage against Commands.\\n===SPEC===\\n// Spec is the complete input to New. It has no schema, schema_version, or ok\\n// field: the schema identifier is fixed, the version is resolved from the\\n// command through VersionForCommand, and ok is the literal true, so a call site\\n// cannot select a version the specification does not assign to its command or\\n// mint a failure-shaped success object.\\ntype Spec struct {\\n\\t// Command is the Section 14.2 command tag that selects the body.\\n\\tCommand Command\\n\\t// IDs carries the operation and session identifiers that are known.\\n\\tIDs IDs\\n\\t// Body is the tagged body. It is marshalled, validated against the strict\\n\\t// common data model, and decoded into the object this result owns, so the\\n\\t// graph the validator checked is the graph the result encodes.\\n\\tBody any\\n\\t// Extensions is the Section 1.6 extensions map. A nil value is the empty\\n\\t// map; the member itself is required and is always emitted.\\n\\tExtensions any\\n\\t// SessionKind is required for the takeover command and refused for every\\n\\t// other command, because Section 14.2 fixes the adoption rule per session\\n\\t// kind and no other body's validation consults it.\\n\\tSessionKind SessionKind\\n}\\n\\n// Result is one validated CLI Result. Every field is unexported and the only\\n// encoder is MarshalJSON, so the closed Section 14.2 object is the only shape\\n// this type can produce.\\n//\\n// The body and extension graphs are owned outright rather than shared. New\\n// rebuilds both from their canonical bytes and the accessors deep-copy on the\\n// way out, so no caller retains a container it could write to after validation\\n// has already run and passed.\\ntype Result struct {\\n\\tversion    Version\\n\\tcommand    Command\\n\\tids        IDs\\n\\tbody       map[string]any\\n\\textensions map[string]any\\n}\\n\\n// New builds a CLI Result from spec. It refuses, in this order: an unknown or\\n// unimplemented command tag; a body or extensions map outside the strict common\\n// data model; a session-kind argument that the command does not take or does\\n// not have; an operation or session identifier that Section 14.2's nullability\\n// rules forbid or require; a body outside its command's closed shape; and an\\n// extensions map outside the Section 1.6 bounds.\\n//\\n// The version is never taken from the caller. It is resolved through\\n// VersionForCommand, so the returned object's schema_version is the exact\\n// version Section 14.2 assigns to the command.\\n\",\n  \"original_output_bytes\": 5300,\n  \"original_output_tokens\": 1325,\n  \"truncated\": false\n}","final_result":true}}}
