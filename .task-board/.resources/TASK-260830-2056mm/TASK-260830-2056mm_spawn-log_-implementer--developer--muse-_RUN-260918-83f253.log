{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76f","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":530,"recorded_at":1780531400001055,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b35f-1347-7d20-a3bf-1f7d9c229537"},"task_id":"01a0b35f-1347-7d20-a3bf-1f7d9c229537","event":{"kind":"output","task_id":"01a0b35f-1347-7d20-a3bf-1f7d9c229537","chunk":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of the staged installs: after\n54|// the receipt bytes are staged to the temporary file (before the\n55|// atomic install), and after the install commits (before the\n56|// directory sync makes the commit durable). The hooks fire on\n57|// whichever install path runs: Bind's first-anchor install and\n58|// Supersede's pair-receipt install. A nil hook is a no-op; a hook\n59|// error aborts the call with that error and installs nothing\n60|// further on that path.\n61|type Hooks struct {\n62|\tAfterStage   func(path string) error\n63|\tAfterInstall func(path string) error\n64|}\n65|\n66|// Store is the durable bootstrap binding store rooted at one data\n67|// directory. The session's first binding anchors at\n68|// <root>/axpane/bootstrap/<session_id>/binding.json, and every\n69|// recorded (session_id, bootstrap_operation_id) pair keeps its own\n70|// receipt at\n71|// <root>/axpane/bootstrap/<session_id>/receipts/<operation_id>.json.\n72|// Superseded pairs keep their receipts: an identical retry of any\n73|// recorded pair replays its own receipt.\n74|type Store struct {\n75|\troot  string\n76|\thooks *Hooks\n77|\tnow   func() time.Time\n78|}\n79|\n80|// Open creates the store, ensuring the root exists. It creates no\n81|// session directories: those appear with the first Bind.\n82|func Open(root string) (*Store, error) {\n83|\tif root == \"\" {\n84|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n85|\t}\n86|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n87|\tif err := os.MkdirAll(base, 0o755); err != nil {\n88|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n89|\t}\n90|\treturn &Store{root: root, now: time.Now}, nil\n91|}\n92|\n93|// WithHooks returns the store with crash hooks armed. It mutates the\n94|// receiver and returns it for call chaining.\n95|func (store *Store) WithHooks(hooks *Hooks) *Store {\n96|\tstore.hooks = hooks\n97|\treturn store\n98|}\n99|\n100|func (store *Store) sessionDir(sessionID string) string {\n101|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n102|}\n103|\n104|func (store *Store) bindingPath(sessionID string) string {\n105|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n106|}\n107|\n108|func (store *Store) receiptsDir(sessionID string) string {\n109|\treturn filepath.Join(store.sessionDir(sessionID), \"receipts\")\n110|}\n111|\n112|func (store *Store) receiptPath(sessionID, operationID string) string {\n113|\treturn filepath.Join(store.receiptsDir(sessionID), operationID+\".json\")\n114|}\n115|\n116|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n117|// recorded wrapper/child before any launch side effect. The first\n118|// call for a session anchors the candidate receipt and records its\n119|// pair receipt from the same bytes; an identical retry returns the\n120|// stored pair receipt with reattached true; a changed operation\n121|// refuses idempotency_mismatch while the bootstrap window is open.\n122|// After the window closes a new operation records its own pair\n123|// receipt through Supersede, never through this no-replace entry.\n124|// The candidate's session and operation must equal the call\n125|// arguments; its instance ID and binding digest are validated, and\n126|// the store stamps created_at at install. The stored receipt is\n127|// authoritative on retry: a retry carrying different child facts\n128|// still reattaches to the one recorded child, never to a second\n129|// child. Stale staging files from a pre-commit crash are swept\n130|// before the install.\n131|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n132|\tempty := Binding{}\n133|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n134|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n135|\t}\n136|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n137|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n138|\t}\n139|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n140|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n141|\t}\n142|\tif err := checkBindingCandidate(candidate); err != nil {\n143|\t\treturn empty, false, err\n144|\t}\n145|\tpair, pairFound, err := store.Lookup(sessionID, operationID)\n146|\tif err != nil {\n147|\t\treturn empty, false, err\n148|\t}\n149|\tif pairFound {\n150|\t\treturn pair, true, nil\n151|\t}\n152|\texisting, found, err := store.Status(sessionID)\n153|\tif err != nil {\n154|\t\treturn empty, false, err\n155|\t}\n156|\tif found {\n157|\t\tif existing.OperationID != operationID {\n158|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n159|\t\t}\n160|\t\t// The anchor names this operation but the pair\n161|\t\t// receipt is absent: a crash landed between the two\n162|\t\t// installs. Converge the pair receipt from the\n163|\t\t// anchor bytes and reattach to the one child.\n164|\t\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\n165|\t\tif err != nil {\n166|\t\t\treturn empty, false, err\n167|\t\t}\n168|\t\treturn converged, true, nil\n169|\t}\n170|\treceipt, err := encodeBinding(candidate, store.timestamp())\n171|\tif err != nil {\n172|\t\treturn empty, false, err\n173|\t}\n174|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n175|\t\tvar concurrent errConcurrentWinner\n176|\t\tif errors.As(err, &concurrent) {\n177|\t\t\treturn concurrent.bound, true, nil\n178|\t\t}\n179|\t\treturn empty, false, err\n180|\t}\n181|\tstored, found, err := store.Lookup(sessionID, operationID)\n182|\tif err != nil {\n183|\t\treturn empty, false, err\n184|\t}\n185|\tif !found {\n186|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n187|\t}\n188|\treturn stored, false, nil\n189|}\n190|\n191|// Status proves absence or identifies the session's first recorded\n192|// wrapper/child: found is true with the anchor receipt, or false\n193|// when no binding exists. A read or validation failure is an\n194|// error, never absence: unknown is not absent. Pair-scoped replay\n195|// reads through Lookup: superseded pairs keep their receipts while\n196|// the anchor keeps pointing at the first.\n197|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n198|\tempty := Binding{}\n199|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n200|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n201|\t}\n202|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n203|\tif err != nil {\n204|\t\tif errors.Is(err, os.ErrNotExist) {\n205|\t\t\treturn empty, false, nil\n206|\t\t}\n207|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n208|\t}\n209|\tbinding, err := decodeBinding(raw)\n210|\tif err != nil {\n211|\t\treturn empty, false, err\n212|\t}\n213|\tif binding.SessionID != sessionID {\n214|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n215|\t}\n216|\treturn binding, true, nil\n217|}\n218|\n219|// Lookup proves absence or replays the one recorded wrapper/child\n220|// for a (session_id, bootstrap_operation_id) pair: found is true\n221|// with that pair's own receipt, or false when the pair is\n222|// unrecorded. A read or validation failure is an error, never\n223|// absence: unknown is not absent. An identical retry of any\n224|// recorded pair replays its receipt here, including pairs later\n225|// pairs superseded.\n226|func (store *Store) Lookup(sessionID, operationID string) (Binding, bool, error) {\n227|\tempty := Binding{}\n228|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n229|\t\treturn empty, false, fmt.Errorf(\"binding lookup session %q is not a UUIDv7: %w\", sessionID, err)\n230|\t}\n231|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n232|\t\treturn empty, false, fmt.Errorf(\"binding lookup operation %q is not a UUIDv7: %w\", operationID, err)\n233|\t}\n234|\traw, err := os.ReadFile(store.receiptPath(sessionID, operationID))\n235|\tif err != nil {\n236|\t\tif errors.Is(err, os.ErrNotExist) {\n237|\t\t\treturn empty, false, nil\n238|\t\t}\n239|\t\treturn empty, false, fmt.Errorf(\"read bootstrap pair receipt: %w\", err)\n240|\t}\n241|\tbinding, err := decodeBinding(raw)\n242|\tif err != nil {\n243|\t\treturn empty, false, err\n244|\t}\n245|\tif binding.SessionID != sessionID {\n246|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another session\")\n247|\t}\n248|\tif binding.OperationID != operationID {\n249|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another operation\")\n250|\t}\n251|\treturn binding, true, nil\n252|}\n253|\n254|// SessionBound reports whether the session has any recorded\n255|// binding: the first-binding anchor or any pair receipt. A torn\n256|// anchor fails the read (unknown, never unbound); pair receipts\n257|// count by presence, since each pair validates on its own Lookup.\n258|func (store *Store) SessionBound(sessionID string) (bool, error) {\n259|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n260|\t\treturn false, fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", sessionID, err)\n261|\t}\n262|\t_, found, err := store.Status(sessionID)\n263|\tif err != nil {\n264|\t\treturn false, err\n265|\t}\n266|\tif found {\n267|\t\treturn true, nil\n268|\t}\n269|\tmatches, err := filepath.Glob(filepath.Join(store.receiptsDir(sessionID), \"*.json\"))\n270|\tif err != nil {\n271|\t\treturn false, err\n272|\t}\n273|\treturn len(matches) > 0, nil\n274|}\n275|\n276|func (store *Store) timestamp() string {\n277|\tnow := time.Now().UTC()\n278|\tif store.now != nil {\n279|\t\tnow = store.now().UTC()\n280|\t}\n281|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n282|}\n283|\n284|// install stages the receipt to a same-directory temporary file,\n285|// fsyncs it, atomically links it to the binding path (which must\n286|// not exist: the link is the no-replace commit), removes the\n287|// staging name, and fsyncs the directory. Readers see absence or\n288|// the complete receipt, never a torn prefix: a crash before the\n289|// link leaves only ignored staging garbage, and a crash after it\n290|// leaves the complete binding the identical retry reattaches to.\n291|// Any pre-existing binding refuses without replacement.\n292|// errConcurrentWinner carries the winning receipt when a concurrent\n293|// wrapper commits first: the loser reattaches instead of failing.\n294|type errConcurrentWinner struct {\n295|\tbound Binding\n296|}\n297|\n298|func (err errConcurrentWinner) Error() string {\n299|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n300|}\n301|\n302|// Supersede durably records a post-window bootstrap pair: the\n303|// caller proved (through the fold's newest checkpoint) that a new\n304|// bootstrap operation is legitimate, and the store installs that\n305|// pair's own receipt no-replace. Superseded pairs keep their\n306|// receipts — nothing is renamed over — so an identical retry of\n307|// any recorded pair replays its own receipt, and two post-window\n308|// Supersede calls with different operations each record their own\n309|// child. A recorded pair replays idempotently: Supersede never\n310|// replaces a pair receipt, and reports the replay so the caller\n311|// reattaches to the recorded child instead of reporting a launch\n312|// of a child it did not create. The session's first-binding\n313|// anchor is claimed when absent so the anchor always names the\n314|// first recorded pair. Supersede refuses malformed candidates\n315|// exactly like Bind.\n316|func (store *Store) Supersede(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n317|\tempty := Binding{}\n318|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n319|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n320|\t}\n321|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n322|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n323|\t}\n324|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n325|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n326|\t}\n327|\tif err := checkBindingCandidate(candidate); err != nil {\n328|\t\treturn empty, false, err\n329|\t}\n330|\tstored, found, err := store.Lookup(sessionID, operationID)\n331|\tif err != nil {\n332|\t\treturn empty, false, err\n333|\t}\n334|\treplayed := found\n335|\tif !found {\n336|\t\treceipt, err := encodeBinding(candidate, store.timestamp())\n337|\t\tif err != nil {\n338|\t\t\treturn empty, false, err\n339|\t\t}\n340|\t\tstored, replayed, err = store.installPair(sessionID, operationID, receipt)\n341|\t\tif err != nil {\n342|\t\t\treturn empty, false, err\n343|\t\t}\n344|\t}\n345|\t// The anchor claim runs on every return path, including the\n346|\t// idempotent replay: a crash between the pair install and\n347|\t// the anchor claim converges on retry.\n348|\tif err := store.ensureFirstFromPair(sessionID, operationID); err != nil {\n349|\t\treturn empty, false, err\n350|\t}\n351|\treturn stored, replayed, nil\n352|}\n353|\n354|// installPair stages the pair receipt and atomically links it to\n355|// the pair path, which must not exist: the link is the no-replace\n356|// commit. Readers see absence or the complete receipt, never a\n357|// torn prefix: a crash before the link leaves only ignored staging\n358|// garbage, and a crash after it leaves the complete receipt the\n359|// identical retry replays. A concurrent same-pair commit wins and\n360|// the loser replays the winner's receipt, reported so the caller\n361|// reattaches. Staging garbage from a pre-commit crash is swept\n362|// first.\n363|func (store *Store) installPair(sessionID, operationID string, receipt []byte) (Binding, bool, error) {\n364|\tempty := Binding{}\n365|\tdir := store.receiptsDir(sessionID)\n366|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n367|\t\treturn empty, false, fmt.Errorf(\"create bootstrap receipts directory: %w\", err)\n368|\t}\n369|\tsweepReceiptsStaging(dir)\n370|\ttarget := store.receiptPath(sessionID, operationID)\n371|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n372|\tif err != nil {\n373|\t\treturn empty, false, fmt.Errorf(\"stage bootstrap pair receipt: %w\", err)\n374|\t}\n375|\tstagedPath := staged.Name()\n376|\tdefer func() { _ = os.Remove(stagedPath) }()\n377|\tif err := staged.Chmod(0o600); err != nil {\n378|\t\t_ = staged.Close()\n379|\t\treturn empty, false, fmt.Errorf(\"protect bootstrap pair receipt: %w\", err)\n380|\t}\n381|\tif _, err := staged.Write(receipt); err != nil {\n382|\t\t_ = staged.Close()\n383|\t\treturn empty, false, fmt.Errorf(\"write bootstrap pair receipt: %w\", err)\n384|\t}\n385|\tif err := staged.Sync(); err != nil {\n386|\t\t_ = staged.Close()\n387|\t\treturn empty, false, fmt.Errorf(\"sync bootstrap pair receipt: %w\", err)\n388|\t}\n389|\tif err := staged.Close(); err != nil {\n390|\t\treturn empty, false, fmt.Errorf(\"close bootstrap pair receipt: %w\", err)\n391|\t}\n392|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n393|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n394|\t\t\treturn empty, false, err\n395|\t\t}\n396|\t}\n397|\tif err := os.Link(stagedPath, target); err != nil {\n398|\t\tif errors.Is(err, os.ErrExist) {\n399|\t\t\t// A concurrent wrapper recorded this pair\n400|\t\t\t// between our Lookup and our link: replay the\n401|\t\t\t// winner's receipt.\n402|\t\t\twinner, found, readErr := store.Lookup(sessionID, operationID)\n403|\t\t\tif readErr != nil {\n404|\t\t\t\treturn empty, false, readErr\n405|\t\t\t}\n406|\t\t\tif !found {\n407|\t\t\t\treturn empty, false, errors.New(\"bootstrap pair receipt vanished after concurrent commit\")\n408|\t\t\t}\n409|\t\t\treturn winner, true, nil\n410|\t\t}\n411|\t\treturn empty, false, fmt.Errorf(\"install bootstrap pair receipt: %w\", err)\n412|\t}\n413|\t_ = os.Remove(stagedPath)\n414|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n415|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n416|\t\t\treturn empty, false, err\n417|\t\t}\n418|\t}\n419|\tif err := syncDirectory(dir); err != nil {\n420|\t\treturn empty, false, err\n421|\t}\n422|\tif err := syncDirectory(store.sessionDir(sessionID)); err != nil {\n423|\t\treturn empty, false, err\n424|\t}\n425|\tstored, found, err := store.Lookup(sessionID, operationID)\n426|\tif err != nil {\n427|\t\treturn empty, false, err\n428|\t}\n429|\tif !found {\n430|\t\treturn empty, false, errors.New(\"bootstrap pair receipt vanished after install\")\n431|\t}\n432|\treturn stored, false, nil\n433|}\n434|\n435|// convergePairFromFirst records the pair receipt from the anchor\n436|// bytes after a crash landed between the anchor install and the\n437|// pair install. The anchor names this operation (checked by the\n438|// caller): the pair receipt carries the identical bytes, so the\n439|// anchor and the pair agree byte for byte.\n440|func (store *Store) convergePairFromFirst(sessionID, operationID string) (Binding, error) {\n441|\tempty := Binding{}\n442|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n443|\tif err != nil {\n444|\t\treturn empty, fmt.Errorf(\"read bootstrap binding for pair convergence: %w\", err)\n445|\t}\n446|\tbinding, err := decodeBinding(raw)\n447|\tif err != nil {\n448|\t\treturn empty, err\n449|\t}\n450|\tif binding.SessionID != sessionID || binding.OperationID != operationID {\n451|\t\treturn empty, fmt.Errorf(\"bind anchor names another bootstrap pair\")\n452|\t}\n453|\tconverged, _, err := store.installPair(sessionID, operationID, raw)\n454|\tif err != nil {\n455|\t\treturn empty, err\n456|\t}\n457|\treturn converged, nil\n458|}\n459|\n460|// ensureFirstFromPair claims the session's first-binding anchor\n461|// from an already-recorded pair receipt when the anchor is absent.\n462|// The link carries the no-replace guard: a concurrent claim wins\n463|// and this call converges to it. It is a no-op when the anchor\n464|// exists.\n465|func (store *Store) ensureFirstFromPair(sessionID, operationID string) error {\n466|\tif _, err := os.Lstat(store.bindingPath(sessionID)); err == nil {\n467|\t\treturn nil\n468|\t} else if !errors.Is(err, os.ErrNotExist) {\n469|\t\treturn fmt.Errorf(\"stat bootstrap binding: %w\", err)\n470|\t}\n471|\tif err := os.Link(store.receiptPath(sessionID, operationID), store.bindingPath(sessionID)); err != nil {\n472|\t\tif errors.Is(err, os.ErrExist) {\n473|\t\t\treturn nil\n474|\t\t}\n475|\t\treturn fmt.Errorf(\"claim first bootstrap binding: %w\", err)\n476|\t}\n477|\treturn syncDirectory(store.sessionDir(sessionID))\n478|}\n479|\n480|// sweepStaging removes stale binding-*.tmp files left by a\n481|// pre-commit crash. Only files older than a minute are removed: a\n482|// concurrent live wrapper stages under the same pattern, and an\n483|// age gate keeps the sweep from deleting its in-flight receipt. It\n484|// is best-effort: a sweep failure never fails the binding, and\n485|// only the staging pattern is removed.\n486|func sweepStaging(dir string) {\n487|\tsweepStagingPattern(dir, \"binding-*.tmp\")\n488|}\n489|\n490|// sweepReceiptsStaging removes stale receipt-*.tmp files left by a\n491|// pre-commit pair-receipt crash, under the same age gate.\n492|func sweepReceiptsStaging(dir string) {\n493|\tsweepStagingPattern(dir, \"receipt-*.tmp\")\n494|}\n495|\n496|func sweepStagingPattern(dir, pattern string) {\n497|\tmatches, err := filepath.Glob(filepath.Join(dir, pattern))\n498|\tif err != nil {\n499|\t\treturn\n500|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c771","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":531,"recorded_at":1780531400001057,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b35f-1347-7d20-a3bf-1f7d9c229537"},"task_id":"01a0b35f-1347-7d20-a3bf-1f7d9c229537","event":{"kind":"completed","task_id":"01a0b35f-1347-7d20-a3bf-1f7d9c229537"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c773","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":532,"recorded_at":1780531400001059,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"call_id":"call_01a0b35f0fe1758b8f00090c62e38ef5","text":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of the staged installs: after\n54|// the receipt bytes are staged to the temporary file (before the\n55|// atomic install), and after the install commits (before the\n56|// directory sync makes the commit durable). The hooks fire on\n57|// whichever install path runs: Bind's first-anchor install and\n58|// Supersede's pair-receipt install. A nil hook is a no-op; a hook\n59|// error aborts the call with that error and installs nothing\n60|// further on that path.\n61|type Hooks struct {\n62|\tAfterStage   func(path string) error\n63|\tAfterInstall func(path string) error\n64|}\n65|\n66|// Store is the durable bootstrap binding store rooted at one data\n67|// directory. The session's first binding anchors at\n68|// <root>/axpane/bootstrap/<session_id>/binding.json, and every\n69|// recorded (session_id, bootstrap_operation_id) pair keeps its own\n70|// receipt at\n71|// <root>/axpane/bootstrap/<session_id>/receipts/<operation_id>.json.\n72|// Superseded pairs keep their receipts: an identical retry of any\n73|// recorded pair replays its own receipt.\n74|type Store struct {\n75|\troot  string\n76|\thooks *Hooks\n77|\tnow   func() time.Time\n78|}\n79|\n80|// Open creates the store, ensuring the root exists. It creates no\n81|// session directories: those appear with the first Bind.\n82|func Open(root string) (*Store, error) {\n83|\tif root == \"\" {\n84|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n85|\t}\n86|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n87|\tif err := os.MkdirAll(base, 0o755); err != nil {\n88|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n89|\t}\n90|\treturn &Store{root: root, now: time.Now}, nil\n91|}\n92|\n93|// WithHooks returns the store with crash hooks armed. It mutates the\n94|// receiver and returns it for call chaining.\n95|func (store *Store) WithHooks(hooks *Hooks) *Store {\n96|\tstore.hooks = hooks\n97|\treturn store\n98|}\n99|\n100|func (store *Store) sessionDir(sessionID string) string {\n101|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n102|}\n103|\n104|func (store *Store) bindingPath(sessionID string) string {\n105|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n106|}\n107|\n108|func (store *Store) receiptsDir(sessionID string) string {\n109|\treturn filepath.Join(store.sessionDir(sessionID), \"receipts\")\n110|}\n111|\n112|func (store *Store) receiptPath(sessionID, operationID string) string {\n113|\treturn filepath.Join(store.receiptsDir(sessionID), operationID+\".json\")\n114|}\n115|\n116|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n117|// recorded wrapper/child before any launch side effect. The first\n118|// call for a session anchors the candidate receipt and records its\n119|// pair receipt from the same bytes; an identical retry returns the\n120|// stored pair receipt with reattached true; a changed operation\n121|// refuses idempotency_mismatch while the bootstrap window is open.\n122|// After the window closes a new operation records its own pair\n123|// receipt through Supersede, never through this no-replace entry.\n124|// The candidate's session and operation must equal the call\n125|// arguments; its instance ID and binding digest are validated, and\n126|// the store stamps created_at at install. The stored receipt is\n127|// authoritative on retry: a retry carrying different child facts\n128|// still reattaches to the one recorded child, never to a second\n129|// child. Stale staging files from a pre-commit crash are swept\n130|// before the install.\n131|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n132|\tempty := Binding{}\n133|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n134|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n135|\t}\n136|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n137|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n138|\t}\n139|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n140|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n141|\t}\n142|\tif err := checkBindingCandidate(candidate); err != nil {\n143|\t\treturn empty, false, err\n144|\t}\n145|\tpair, pairFound, err := store.Lookup(sessionID, operationID)\n146|\tif err != nil {\n147|\t\treturn empty, false, err\n148|\t}\n149|\tif pairFound {\n150|\t\treturn pair, true, nil\n151|\t}\n152|\texisting, found, err := store.Status(sessionID)\n153|\tif err != nil {\n154|\t\treturn empty, false, err\n155|\t}\n156|\tif found {\n157|\t\tif existing.OperationID != operationID {\n158|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n159|\t\t}\n160|\t\t// The anchor names this operation but the pair\n161|\t\t// receipt is absent: a crash landed between the two\n162|\t\t// installs. Converge the pair receipt from the\n163|\t\t// anchor bytes and reattach to the one child.\n164|\t\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\n165|\t\tif err != nil {\n166|\t\t\treturn empty, false, err\n167|\t\t}\n168|\t\treturn converged, true, nil\n169|\t}\n170|\treceipt, err := encodeBinding(candidate, store.timestamp())\n171|\tif err != nil {\n172|\t\treturn empty, false, err\n173|\t}\n174|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n175|\t\tvar concurrent errConcurrentWinner\n176|\t\tif errors.As(err, &concurrent) {\n177|\t\t\treturn concurrent.bound, true, nil\n178|\t\t}\n179|\t\treturn empty, false, err\n180|\t}\n181|\tstored, found, err := store.Lookup(sessionID, operationID)\n182|\tif err != nil {\n183|\t\treturn empty, false, err\n184|\t}\n185|\tif !found {\n186|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n187|\t}\n188|\treturn stored, false, nil\n189|}\n190|\n191|// Status proves absence or identifies the session's first recorded\n192|// wrapper/child: found is true with the anchor receipt, or false\n193|// when no binding exists. A read or validation failure is an\n194|// error, never absence: unknown is not absent. Pair-scoped replay\n195|// reads through Lookup: superseded pairs keep their receipts while\n196|// the anchor keeps pointing at the first.\n197|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n198|\tempty := Binding{}\n199|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n200|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n201|\t}\n202|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n203|\tif err != nil {\n204|\t\tif errors.Is(err, os.ErrNotExist) {\n205|\t\t\treturn empty, false, nil\n206|\t\t}\n207|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n208|\t}\n209|\tbinding, err := decodeBinding(raw)\n210|\tif err != nil {\n211|\t\treturn empty, false, err\n212|\t}\n213|\tif binding.SessionID != sessionID {\n214|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n215|\t}\n216|\treturn binding, true, nil\n217|}\n218|\n219|// Lookup proves absence or replays the one recorded wrapper/child\n220|// for a (session_id, bootstrap_operation_id) pair: found is true\n221|// with that pair's own receipt, or false when the pair is\n222|// unrecorded. A read or validation failure is an error, never\n223|// absence: unknown is not absent. An identical retry of any\n224|// recorded pair replays its receipt here, including pairs later\n225|// pairs superseded.\n226|func (store *Store) Lookup(sessionID, operationID string) (Binding, bool, error) {\n227|\tempty := Binding{}\n228|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n229|\t\treturn empty, false, fmt.Errorf(\"binding lookup session %q is not a UUIDv7: %w\", sessionID, err)\n230|\t}\n231|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n232|\t\treturn empty, false, fmt.Errorf(\"binding lookup operation %q is not a UUIDv7: %w\", operationID, err)\n233|\t}\n234|\traw, err := os.ReadFile(store.receiptPath(sessionID, operationID))\n235|\tif err != nil {\n236|\t\tif errors.Is(err, os.ErrNotExist) {\n237|\t\t\treturn empty, false, nil\n238|\t\t}\n239|\t\treturn empty, false, fmt.Errorf(\"read bootstrap pair receipt: %w\", err)\n240|\t}\n241|\tbinding, err := decodeBinding(raw)\n242|\tif err != nil {\n243|\t\treturn empty, false, err\n244|\t}\n245|\tif binding.SessionID != sessionID {\n246|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another session\")\n247|\t}\n248|\tif binding.OperationID != operationID {\n249|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another operation\")\n250|\t}\n251|\treturn binding, true, nil\n252|}\n253|\n254|// SessionBound reports whether the session has any recorded\n255|// binding: the first-binding anchor or any pair receipt. A torn\n256|// anchor fails the read (unknown, never unbound); pair receipts\n257|// count by presence, since each pair validates on its own Lookup.\n258|func (store *Store) SessionBound(sessionID string) (bool, error) {\n259|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n260|\t\treturn false, fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", sessionID, err)\n261|\t}\n262|\t_, found, err := store.Status(sessionID)\n263|\tif err != nil {\n264|\t\treturn false, err\n265|\t}\n266|\tif found {\n267|\t\treturn true, nil\n268|\t}\n269|\tmatches, err := filepath.Glob(filepath.Join(store.receiptsDir(sessionID), \"*.json\"))\n270|\tif err != nil {\n271|\t\treturn false, err\n272|\t}\n273|\treturn len(matches) > 0, nil\n274|}\n275|\n276|func (store *Store) timestamp() string {\n277|\tnow := time.Now().UTC()\n278|\tif store.now != nil {\n279|\t\tnow = store.now().UTC()\n280|\t}\n281|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n282|}\n283|\n284|// install stages the receipt to a same-directory temporary file,\n285|// fsyncs it, atomically links it to the binding path (which must\n286|// not exist: the link is the no-replace commit), removes the\n287|// staging name, and fsyncs the directory. Readers see absence or\n288|// the complete receipt, never a torn prefix: a crash before the\n289|// link leaves only ignored staging garbage, and a crash after it\n290|// leaves the complete binding the identical retry reattaches to.\n291|// Any pre-existing binding refuses without replacement.\n292|// errConcurrentWinner carries the winning receipt when a concurrent\n293|// wrapper commits first: the loser reattaches instead of failing.\n294|type errConcurrentWinner struct {\n295|\tbound Binding\n296|}\n297|\n298|func (err errConcurrentWinner) Error() string {\n299|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n300|}\n301|\n302|// Supersede durably records a post-window bootstrap pair: the\n303|// caller proved (through the fold's newest checkpoint) that a new\n304|// bootstrap operation is legitimate, and the store installs that\n305|// pair's own receipt no-replace. Superseded pairs keep their\n306|// receipts — nothing is renamed over — so an identical retry of\n307|// any recorded pair replays its own receipt, and two post-window\n308|// Supersede calls with different operations each record their own\n309|// child. A recorded pair replays idempotently: Supersede never\n310|// replaces a pair receipt, and reports the replay so the caller\n311|// reattaches to the recorded child instead of reporting a launch\n312|// of a child it did not create. The session's first-binding\n313|// anchor is claimed when absent so the anchor always names the\n314|// first recorded pair. Supersede refuses malformed candidates\n315|// exactly like Bind.\n316|func (store *Store) Supersede(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n317|\tempty := Binding{}\n318|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n319|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n320|\t}\n321|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n322|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n323|\t}\n324|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n325|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n326|\t}\n327|\tif err := checkBindingCandidate(candidate); err != nil {\n328|\t\treturn empty, false, err\n329|\t}\n330|\tstored, found, err := store.Lookup(sessionID, operationID)\n331|\tif err != nil {\n332|\t\treturn empty, false, err\n333|\t}\n334|\treplayed := found\n335|\tif !found {\n336|\t\treceipt, err := encodeBinding(candidate, store.timestamp())\n337|\t\tif err != nil {\n338|\t\t\treturn empty, false, err\n339|\t\t}\n340|\t\tstored, replayed, err = store.installPair(sessionID, operationID, receipt)\n341|\t\tif err != nil {\n342|\t\t\treturn empty, false, err\n343|\t\t}\n344|\t}\n345|\t// The anchor claim runs on every return path, including the\n346|\t// idempotent replay: a crash between the pair install and\n347|\t// the anchor claim converges on retry.\n348|\tif err := store.ensureFirstFromPair(sessionID, operationID); err != nil {\n349|\t\treturn empty, false, err\n350|\t}\n351|\treturn stored, replayed, nil\n352|}\n353|\n354|// installPair stages the pair receipt and atomically links it to\n355|// the pair path, which must not exist: the link is the no-replace\n356|// commit. Readers see absence or the complete receipt, never a\n357|// torn prefix: a crash before the link leaves only ignored staging\n358|// garbage, and a crash after it leaves the complete receipt the\n359|// identical retry replays. A concurrent same-pair commit wins and\n360|// the loser replays the winner's receipt, reported so the caller\n361|// reattaches. Staging garbage from a pre-commit crash is swept\n362|// first.\n363|func (store *Store) installPair(sessionID, operationID string, receipt []byte) (Binding, bool, error) {\n364|\tempty := Binding{}\n365|\tdir := store.receiptsDir(sessionID)\n366|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n367|\t\treturn empty, false, fmt.Errorf(\"create bootstrap receipts directory: %w\", err)\n368|\t}\n369|\tsweepReceiptsStaging(dir)\n370|\ttarget := store.receiptPath(sessionID, operationID)\n371|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n372|\tif err != nil {\n373|\t\treturn empty, false, fmt.Errorf(\"stage bootstrap pair receipt: %w\", err)\n374|\t}\n375|\tstagedPath := staged.Name()\n376|\tdefer func() { _ = os.Remove(stagedPath) }()\n377|\tif err := staged.Chmod(0o600); err != nil {\n378|\t\t_ = staged.Close()\n379|\t\treturn empty, false, fmt.Errorf(\"protect bootstrap pair receipt: %w\", err)\n380|\t}\n381|\tif _, err := staged.Write(receipt); err != nil {\n382|\t\t_ = staged.Close()\n383|\t\treturn empty, false, fmt.Errorf(\"write bootstrap pair receipt: %w\", err)\n384|\t}\n385|\tif err := staged.Sync(); err != nil {\n386|\t\t_ = staged.Close()\n387|\t\treturn empty, false, fmt.Errorf(\"sync bootstrap pair receipt: %w\", err)\n388|\t}\n389|\tif err := staged.Close(); err != nil {\n390|\t\treturn empty, false, fmt.Errorf(\"close bootstrap pair receipt: %w\", err)\n391|\t}\n392|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n393|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n394|\t\t\treturn empty, false, err\n395|\t\t}\n396|\t}\n397|\tif err := os.Link(stagedPath, target); err != nil {\n398|\t\tif errors.Is(err, os.ErrExist) {\n399|\t\t\t// A concurrent wrapper recorded this pair\n400|\t\t\t// between our Lookup and our link: replay the\n401|\t\t\t// winner's receipt.\n402|\t\t\twinner, found, readErr := store.Lookup(sessionID, operationID)\n403|\t\t\tif readErr != nil {\n404|\t\t\t\treturn empty, false, readErr\n405|\t\t\t}\n406|\t\t\tif !found {\n407|\t\t\t\treturn empty, false, errors.New(\"bootstrap pair receipt vanished after concurrent commit\")\n408|\t\t\t}\n409|\t\t\treturn winner, true, nil\n410|\t\t}\n411|\t\treturn empty, false, fmt.Errorf(\"install bootstrap pair receipt: %w\", err)\n412|\t}\n413|\t_ = os.Remove(stagedPath)\n414|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n415|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n416|\t\t\treturn empty, false, err\n417|\t\t}\n418|\t}\n419|\tif err := syncDirectory(dir); err != nil {\n420|\t\treturn empty, false, err\n421|\t}\n422|\tif err := syncDirectory(store.sessionDir(sessionID)); err != nil {\n423|\t\treturn empty, false, err\n424|\t}\n425|\tstored, found, err := store.Lookup(sessionID, operationID)\n426|\tif err != nil {\n427|\t\treturn empty, false, err\n428|\t}\n429|\tif !found {\n430|\t\treturn empty, false, errors.New(\"bootstrap pair receipt vanished after install\")\n431|\t}\n432|\treturn stored, false, nil\n433|}\n434|\n435|// convergePairFromFirst records the pair receipt from the anchor\n436|// bytes after a crash landed between the anchor install and the\n437|// pair install. The anchor names this operation (checked by the\n438|// caller): the pair receipt carries the identical bytes, so the\n439|// anchor and the pair agree byte for byte.\n440|func (store *Store) convergePairFromFirst(sessionID, operationID string) (Binding, error) {\n441|\tempty := Binding{}\n442|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n443|\tif err != nil {\n444|\t\treturn empty, fmt.Errorf(\"read bootstrap binding for pair convergence: %w\", err)\n445|\t}\n446|\tbinding, err := decodeBinding(raw)\n447|\tif err != nil {\n448|\t\treturn empty, err\n449|\t}\n450|\tif binding.SessionID != sessionID || binding.OperationID != operationID {\n451|\t\treturn empty, fmt.Errorf(\"bind anchor names another bootstrap pair\")\n452|\t}\n453|\tconverged, _, err := store.installPair(sessionID, operationID, raw)\n454|\tif err != nil {\n455|\t\treturn empty, err\n456|\t}\n457|\treturn converged, nil\n458|}\n459|\n460|// ensureFirstFromPair claims the session's first-binding anchor\n461|// from an already-recorded pair receipt when the anchor is absent.\n462|// The link carries the no-replace guard: a concurrent claim wins\n463|// and this call converges to it. It is a no-op when the anchor\n464|// exists.\n465|func (store *Store) ensureFirstFromPair(sessionID, operationID string) error {\n466|\tif _, err := os.Lstat(store.bindingPath(sessionID)); err == nil {\n467|\t\treturn nil\n468|\t} else if !errors.Is(err, os.ErrNotExist) {\n469|\t\treturn fmt.Errorf(\"stat bootstrap binding: %w\", err)\n470|\t}\n471|\tif err := os.Link(store.receiptPath(sessionID, operationID), store.bindingPath(sessionID)); err != nil {\n472|\t\tif errors.Is(err, os.ErrExist) {\n473|\t\t\treturn nil\n474|\t\t}\n475|\t\treturn fmt.Errorf(\"claim first bootstrap binding: %w\", err)\n476|\t}\n477|\treturn syncDirectory(store.sessionDir(sessionID))\n478|}\n479|\n480|// sweepStaging removes stale binding-*.tmp files left by a\n481|// pre-commit crash. Only files older than a minute are removed: a\n482|// concurrent live wrapper stages under the same pattern, and an\n483|// age gate keeps the sweep from deleting its in-flight receipt. It\n484|// is best-effort: a sweep failure never fails the binding, and\n485|// only the staging pattern is removed.\n486|func sweepStaging(dir string) {\n487|\tsweepStagingPattern(dir, \"binding-*.tmp\")\n488|}\n489|\n490|// sweepReceiptsStaging removes stale receipt-*.tmp files left by a\n491|// pre-commit pair-receipt crash, under the same age gate.\n492|func sweepReceiptsStaging(dir string) {\n493|\tsweepStagingPattern(dir, \"receipt-*.tmp\")\n494|}\n495|\n496|func sweepStagingPattern(dir, pattern string) {\n497|\tmatches, err := filepath.Glob(filepath.Join(dir, pattern))\n498|\tif err != nil {\n499|\t\treturn\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
