 ),\n+    Mutant(\n+        name=\"N-resume-checkresult-stale\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tif err := CheckResult(context, source, result); err != nil {\\n\",\n+        replace=\"\\t\\tif err := CheckResult(context, source, result); err != nil && ErrorCode(err) != CodeStaleGeneration {\\n\",\n+        count=1,\n+        run=\"TestRV4W_ReplayedImageGenerationBindingAtEngine\",\n+        expect=\"KILLED\",\n+        note=\"Story-close P3-2 (reviewer RV4-M6 mirror): the ENGINE replay site returns a stored image whose backend_generation differs from the request as a successful replay; every other CheckResult refusal still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-checkresult-disposition\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\t\\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\\n\",\n+        replace=\"\\t\\t\\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionReplaySame), failure\\n\",\n+        count=1,\n+        run=\"TestRV4W_ReplayedImageGenerationBindingAtEngine\",\n+        expect=\"KILLED\",\n+        note=\"Story-close P3-2 (reviewer RV4-M6b mirror): a refused replayed image reports replay_same instead of the class-mapped status_first. Same killer as the stale row, killed by the disposition assertion.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-corrupt-image\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tvar result Result\\n\\t\\tif err := json.Unmarshal(stored, &result); err != nil {\\n\",\n+        replace=\"\\t\\tvar result Result\\n\\t\\tif err := json.Unmarshal(stored, &result); err != nil && (len(stored) == 0 || stored[0] != '{') {\\n\",\n+        count=1,\n+        run=\"TestRV4_CorruptCompletionImageIsIntegrityFailure\",\n+        expect=\"KILLED\",\n+        note=\"Story-close P3-2: admits exactly brace-led corrupt completion bytes past the integrity arm; other corrupt shapes still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-loop-deadline-instant\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\t\\tif !engine.Now().Before(deadline) {\\n\\t\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\tif committed {\\n',\n+        replace='\\t\\tif engine.Now().After(deadline) {\\n\\t\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\tif committed {\\n',\n+        count=1,\n+        run=\"TestRV4W_LoopDeadlineInstantCancelsWaiting\",\n+        expect=\"KILLED\",\n+        note=\"Story-close P3-3 (reviewer RV4-M7 mirror): the in-loop deadline check admits exactly the deadline instant between effects; the entry check is unchanged.\",\n+    ),\n+    Mutant(\n+        name=\"N-auth-kind-case\",\n+        path=f\"{PACKAGE}/auth.go\",\n+        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n+        replace='\\tdefault:\\n\\t\\tif value == \"Control\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n+        count=1,\n+        run=\"(TestRV4W_AuthorizationKindCaseSiblingRefused|TestParseAuthorizationKindClosed)\",\n+        expect=\"KILLED\",\n+        note=\"Story-close P3-4 (reviewer RV4-M5 mirror): the case-variant spelling Control parses as control at the direct and the document entry; every other sibling still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n","final_result":true}}}
