\treturn err\n586|\t}\n587|\treturn nil\n588|}\n589|\n590|func checkBindingCandidate(candidate Binding) error {\n591|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n592|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n593|\t}\n594|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n595|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n596|\t}\n597|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n598|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n599|\t}\n600|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n601|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n602|\t}\n603|\t// The candidate carries no timestamp: the store stamps\n604|\t// created_at at install, so a caller clock never enters the\n605|\t// receipt. Stored receipts validate their stamp at decode.\n606|\treturn nil\n607|}\n608|\n609|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n610|\tstored := candidate\n611|\tstored.CreatedAt = createdAt\n612|\tdocument := map[string]string{\n613|\t\t\"schema\":                 bindingSchema,\n614|\t\t\"schema_version\":         bindingSchemaVersion,\n615|\t\t\"session_id\":             stored.SessionID,\n616|\t\t\"bootstrap_operation_id\": stored.OperationID,\n617|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n618|\t\t\"binding_digest\":         stored.BindingDigest,\n619|\t\t\"created_at\":             stored.CreatedAt,\n620|\t}\n621|\traw, err := json.Marshal(document)\n622|\tif err != nil {\n623|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n624|\t}\n625|\treturn raw, nil\n626|}\n627|\n628|func decodeBinding(raw []byte) (Binding, error) {\n629|\tempty := Binding{}\n630|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n631|\tdecoder.DisallowUnknownFields()\n632|\tvar document struct {\n633|\t\tSchema             string `json:\"schema\"`\n634|\t\tSchemaVersion      string `json:\"schema_version\"`\n635|\t\tSessionID          string `json:\"session_id\"`\n636|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n637|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n638|\t\tBindingDigest      string `json:\"binding_digest\"`\n639|\t\tCreatedAt          string `json:\"created_at\"`\n640|\t}\n641|\tif err := decoder.Decode(&document); err != nil {\n642|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n643|\t}\n644|\tif decoder.More() {\n645|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n646|\t}\n647|\tvar members map[string]json.RawMessage\n648|\tif err := json.Unmarshal(raw, &members); err != nil {\n649|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n650|\t}\n651|\tfor _, name := range bindingMembers {\n652|\t\tif _, ok := members[name]; !ok {\n653|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n654|\t\t}\n655|\t}\n656|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n657|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n658|\t}\n659|\tbinding := Binding{\n660|\t\tSessionID:          document.SessionID,\n661|\t\tOperationID:        document.OperationID,\n662|\t\tTerminalInstanceID: document.TerminalInstanceID,\n663|\t\tBindingDigest:      document.BindingDigest,\n664|\t\tCreatedAt:          document.CreatedAt,\n665|\t}\n666|\tif err := checkBindingCandidate(binding); err != nil {\n667|\t\treturn empty, err\n668|\t}\n669|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n670|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n671|\t}\n672|\treturn binding, nil\n673|}\n674|\n675|// BindingDigest computes the opaque binding digest over the canonical\n676|// receipt bytes: the value a §7.A descriptor carries as\n677|// terminal_binding_id. It reveals no generation, PID, or native\n678|// reference.\n679|func BindingDigest(binding Binding) string {\n680|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n681|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n682|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7af","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":562,"recorded_at":1780531400001119,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"call_id":"call_01a0b35f1cc675cd8ec957085546d9ff","text":"Read text file `internal/terminstance/doc.go`.\n1|// Package terminstance executes the Terminal Instance lifecycle contract of\n2|// SPEC §4.C over the landed internal/terminalbackend semantic core.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec §4.C (lifecycle\n5|// state machine, transition/authorization/idempotency table), §4.B (the\n6|// backend_generation canonical bound), §4.D (capability conditionals\n7|// evaluated at the operation call site), §5.2 (status/unknown discipline),\n8|// §7.A (descriptor generation binding, cited landed), §13.1 (durable\n9|// terminal entry before provider launch) and §13.7 (cold force\n10|// takeover: the prior owner is stale when it learns the winner). Worked against\n11|// internal/specdoc/SPEC.v0.7.0.md: §§4.B, 4.C, 4.D, 5.2 and 7.A are\n12|// byte-identical to v0.6.0, while §13.1 carries the v0.7.0 launch-plan\n13|// insertion that precedes step 2 (a pure addition; the durable\n14|// terminal-entry rule text is unchanged).\n15|//\n16|// Composition, not re-implementation: the eight-state enum, the ten-operation\n17|// enum, the ten-effect enum, the transition matrix, the allowed-error sets,\n18|// the idempotency key shapes and the capability registry stay owned by\n19|// internal/terminalbackend (ParseInstanceState, ParseOperation,\n20|// ParseSideEffect, CheckTransition, CheckErrorAllowed, IdempotencyKey,\n21|// CheckOperation, GenerationDigest, CheckProviderDescriptor). Closed-shape\n22|// JSON admission stays owned by internal/environ (DecodeStrictObject,\n23|// CheckStringBounds, CheckUint53Bounds, CheckDigest, CheckUUIDv7,\n24|// CheckTimestamp, CheckSemver). Scalar grammars stay owned by\n25|// internal/scalar. Fencing truth stays owned by internal/fencing\n26|// (Authorize, StaleRelativeToWinner): this package never compares\n27|// lease tuples itself to decide staleness; ObserveFencing reads only\n28|// the landed park vocabulary and the landed staleness verdict. What\n29|// this package owns is the execution layer the landed core deliberately\n30|// leaves out: the AXAuthorization closed object, the RetryDisposition and\n31|// ProviderProofKind closed enums, the mutating-request/response identity\n32|// contract, the per-side-effect recheck loop, the error-to-observation\n33|// mapping, and the durable idempotency receipt store.\n34|//\n35|// Stated bounds (no unsupported claims): no ax command, no tmux/ConPTY\n36|// process control and no provider process exist here; Backend is a modeled\n37|// caller interface. The Terminal Instance Binding 1.0.0 closed object has\n38|// no parser on trunk (canonicaljson explicitly rejects\n39|// urn:ax:schema:terminal-instance-binding) and the CLI Result 4 bodies\n40|// carry no raw generation member, so the generation bound is enforced on\n41|// the surfaces this leaf owns (operation bodies and results) and cited\n42|// landed for the Provider Protocol 3 descriptor; full Binding-object\n43|// parsing belongs with the provisioning surface. Attach, restore,\n44|// terminate-stale, manifest and probe operations are refused by the engine\n45|// scope gate; restore/terminate-stale recovery belongs to the story's\n46|// final leaf. Events (terminal.created/session.resumed emission) belong to\n47|// the final leaf. On reattach the recorded Binding terminal instance ID is\n48|// authoritative; a request-built descriptor names the request's own fresh\n49|// instance, never the recorded child.\n50|package terminstance","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
