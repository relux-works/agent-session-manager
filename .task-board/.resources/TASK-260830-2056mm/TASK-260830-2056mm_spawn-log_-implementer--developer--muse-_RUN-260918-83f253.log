{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dddd","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":3401,"recorded_at":1780531400006797,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b376-e8d7-7152-bf71-37525ecb0912"},"task_id":"01a0b376-e8d7-7152-bf71-37525ecb0912","event":{"kind":"output","task_id":"01a0b376-e8d7-7152-bf71-37525ecb0912","chunk":"Read text file `internal/axpane/run.go`.\n(179 line(s) above)\n180|\t}\n181|\n182|\tif request.MaterializationRequired {\n183|\t\tif stores.Mat == nil {\n184|\t\t\treturn empty, fmt.Errorf(\"axpane run requires a materialization with no journal store\")\n185|\t\t}\n186|\t\tjournal, admitted, err := LoadMaterialization(stores.Mat, request.MaterializationID)\n187|\t\tif err != nil {\n188|\t\t\treturn empty, err\n189|\t\t}\n190|\t\tinput.Journal = journal\n191|\t\tinput.JournalOK = admitted\n192|\t}\n193|\tif request.CheckpointRequired {\n194|\t\tif stores.Ckpt == nil {\n195|\t\t\treturn empty, fmt.Errorf(\"axpane run requires a checkpoint with no checkpoint store\")\n196|\t\t}\n197|\t\tdoc, err := LoadCheckpoint(stores.Ckpt, request.CheckpointID)\n198|\t\tif err != nil {\n199|\t\t\treturn empty, err\n200|\t\t}\n201|\t\tinput.CheckpointDoc = doc\n202|\t}\n203|\tif known {\n204|\t\trecord, events, err := LoadProfile(stores.Repo, request.SessionID)\n205|\t\tif err != nil {\n206|\t\t\treturn empty, err\n207|\t\t}\n208|\t\tinput.ProfileRecord = record\n209|\t\tinput.ProfileEvents = events\n210|\t\t// Resume derives the effective profile from the\n211|\t\t// checkpoint actually resumed — the required checkpoint\n212|\t\t// when one is required, else the fold's newest — never\n213|\t\t// the session head and never the winning lease's handoff\n214|\t\t// base, so a head-only or losing-lease change cannot\n215|\t\t// become the launch profile (§13.10, §2.4). With no\n216|\t\t// required checkpoint and no published newest (the\n217|\t\t// epoch-1 bootstrap-retry path) the session head stays\n218|\t\t// the source.\n219|\t\tclosureDoc := input.CheckpointDoc\n220|\t\tif !request.CheckpointRequired || len(input.CheckpointDoc) == 0 {\n221|\t\t\tclosureDoc = nil\n222|\t\t\tif input.HasNewestCheckpoint && stores.Ckpt != nil {\n223|\t\t\t\tloaded, err := LoadCheckpoint(stores.Ckpt, input.NewestCheckpointID)\n224|\t\t\t\tif err != nil {\n225|\t\t\t\t\treturn empty, err\n226|\t\t\t\t}\n227|\t\t\t\tif len(loaded) == 0 {\n228|\t\t\t\t\treturn empty, fmt.Errorf(\"axpane run requires the newest checkpoint closure with the newest absent from the store\")\n229|\t\t\t\t}\n230|\t\t\t\tclosureDoc = loaded\n231|\t\t\t}\n232|\t\t}\n233|\t\tif len(closureDoc) > 0 {\n234|\t\t\theads, err := checkpointHeads(closureDoc)\n235|\t\t\tif err != nil {\n236|\t\t\t\treturn empty, err\n237|\t\t\t}\n238|\t\t\tinput.ProfileHeads = heads\n239|\t\t}\n240|\t}\n241|\n242|\tinstance := request.InstanceID\n243|\tif instance == \"\" {\n244|\t\tminted, err := MintInstanceIDRandom()\n245|\t\tif err != nil {\n246|\t\t\treturn empty, err\n247|\t\t}\n248|\t\tinstance = minted\n249|\t}\n250|\tdescriptorDoc, err := BuildDescriptor(DescriptorParams{\n251|\t\tBinding: BindingRef{\n252|\t\t\tBindingDigest:         request.HostBinding.TerminalBindingID,\n253|\t\t\tBackendID:             request.HostBinding.BackendID,\n254|\t\t\tImplementationVersion: request.HostBinding.ImplementationVersion,\n255|\t\t\tProtocolVersion:       request.HostBinding.ProtocolVersion,\n256|\t\t\tGeneration:            request.HostBinding.Generation,\n257|\t\t},\n258|\t\tInstanceID:  instance,\n259|\t\tInteractive: request.Interactive,\n260|\t\tColumns:     request.Columns,\n261|\t\tRows:        request.Rows,\n262|\t})\n263|\tif err != nil {\n264|\t\treturn empty, err\n265|\t}\n266|\tinput.Descriptor = descriptorDoc\n267|\n268|\tdecision := Decide(input)\n269|\toutcome := Outcome{Decision: decision}\n270|\tswitch decision.Action {\n271|\tcase ActionLaunch:\n272|\t\tcandidate := Binding{\n273|\t\t\tSessionID:          request.SessionID,\n274|\t\t\tOperationID:        request.BootstrapOperationID,\n275|\t\t\tTerminalInstanceID: instance,\n276|\t\t}\n277|\t\tcandidate.BindingDigest = BindingDigest(candidate)\n278|\t\t// A launch reaches here only for an unrecorded pair (a\n279|\t\t// recorded pair reattaches instead). On a bound session\n(more lines below)","final_result":true}}}
