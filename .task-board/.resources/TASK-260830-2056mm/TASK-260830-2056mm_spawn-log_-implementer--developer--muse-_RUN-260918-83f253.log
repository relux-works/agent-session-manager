{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c91b","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":744,"recorded_at":1780531400001483,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b35f-b2b0-7132-a5e2-c151e2967510"},"task_id":"01a0b35f-b2b0-7132-a5e2-c151e2967510","event":{"kind":"output","task_id":"01a0b35f-b2b0-7132-a5e2-c151e2967510","chunk":"Read text file `internal/sessrepo/sessrepo.go`.\n(259 line(s) above)\n260|\t\treturn true, nil\n261|\t}\n262|\tif !bytes.Equal(existing, recordJSON) {\n263|\t\treturn false, nil\n264|\t}\n265|\tif _, err := os.Stat(filepath.Join(directory, \"chain.json\")); err == nil {\n266|\t\treturn false, nil\n267|\t}\n268|\tif err := os.MkdirAll(filepath.Join(directory, \"events\"), 0o700); err != nil {\n269|\t\treturn false, fmt.Errorf(\"recreate session events directory: %w\", err)\n270|\t}\n271|\tif err := repository.writeChain(directory, storedChain{RecordID: record.recordID}); err != nil {\n272|\t\treturn false, err\n273|\t}\n274|\treturn true, nil\n275|}\n276|\n277|// AppendEvent validates eventJSON through the canonical owner and links it\n278|// onto the session chain after the continuity checks. A byte-identical\n279|// retry of an already chained event returns its existing reference without\n280|// duplicating the chain, so a retry after a crashed commit is safe.\n281|func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\n282|\tevent, err := decodeSessionEvent(eventJSON)\n283|\tif err != nil {\n284|\t\treturn EventRef{}, err\n285|\t}\n286|\tif event.sessionID != sessionID {\n287|\t\treturn EventRef{}, refuse(ErrInvalidEvent, \"event session %s does not match target session %s\", event.sessionID, sessionID)\n288|\t}\n289|\trepository.mutex.Lock()\n290|\tdefer repository.mutex.Unlock()\n291|\tview, err := repository.loadSessionLocked(sessionID)\n292|\tif err != nil {\n293|\t\treturn EventRef{}, err\n294|\t}\n295|\tfor position, existing := range view.chain.Events {\n296|\t\tif existing.EventID == event.eventID {\n297|\t\t\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: existing.LeaseSequence, Position: position}, nil\n298|\t\t}\n299|\t}\n300|\tif repository.BeforeWrite != nil {\n301|\t\tif err := repository.BeforeWrite(); err != nil {\n302|\t\t\treturn EventRef{}, err\n303|\t\t}\n304|\t}\n305|\tvar tail *EventSummary\n306|\tif len(view.chain.Events) > 0 {\n307|\t\tprevious := view.chain.Events[len(view.chain.Events)-1]\n308|\t\ttail = &previous\n309|\t}\n310|\tif err := checkAppend(view.chain.RecordID, tail, event); err != nil {\n311|\t\t// Losing-lease branches are preserved as immutable blobs but never\n312|\t\t// applied: the bytes stay addressable while the chain is untouched.\n313|\t\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\n314|\t\t\tif preserveErr := installEventBlob(filepath.Join(view.directory, \"events\", blobFileName(event.eventID)), eventJSON); preserveErr != nil {\n315|\t\t\t\treturn EventRef{}, fmt.Errorf(\"preserve unapplied branch: %v: %w\", preserveErr, err)\n316|\t\t\t}\n317|\t\t}\n318|\t\treturn EventRef{}, err\n319|\t}\n320|\tblobPath := filepath.Join(view.directory, \"events\", blobFileName(event.eventID))\n321|\tif err := installEventBlob(blobPath, eventJSON); err != nil {\n322|\t\tif errors.Is(err, errDigestDisagreement) {\n323|\t\t\treturn EventRef{}, refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for event\")\n324|\t\t}\n325|\t\treturn EventRef{}, err\n326|\t}\n327|\tnext := append(append([]EventSummary(nil), view.chain.Events...), eventSummary(event))\n328|\tif err := repository.writeChain(view.directory, storedChain{RecordID: view.chain.RecordID, Events: next}); err != nil {\n329|\t\treturn EventRef{}, err\n330|\t}\n331|\tif repository.AfterCommit != nil {\n332|\t\tif err := repository.AfterCommit(); err != nil {\n333|\t\t\treturn EventRef{}, err\n334|\t\t}\n335|\t}\n336|\treturn EventRef{SessionID: sessionID, EventID: event.eventID, LeaseSequence: event.leaseSeq, Position: len(next) - 1}, nil\n337|}\n338|\n339|// eventSummary projects the validated routing members into the chain index.\n340|func eventSummary(event eventView) EventSummary {\n341|\treturn EventSummary{EventID: event.eventID, EventType: event.eventType, LeaseEpoch: event.leaseEpoch, LeaseID: event.leaseID, LeaseSequence: event.leaseSeq, Predecessors: append([]string(nil), event.predecessors...)}\n342|}","final_result":true}}}
